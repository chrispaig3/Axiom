; Pack a file into an authenticated, encrypted Axiom module.
; Usage: axobfuscate INPUT OUTPUT.ax CONTEXT
(import IO)
(import Sys)
(import Str)
(import Vec)
(import Err)
(import Crypto.Bytes)
(import Crypto.Errors)
(import Crypto.Random)
(import Crypto.Obfuscate)

(:: moduleText (-> String String String String String))
(fn (moduleText a b context envelope)
  (let ((parts vecNew))
    {
      (vecPush parts "; Generated by axobfuscate. Repack from the original asset before each build.\n(import Err)\n(import Crypto.Bytes)\n(import Crypto.Obfuscate)\n\n; Authenticate and decode the embedded asset.\n(pub :: openAsset (Result String Error))\n;@axiom:effect(io)\n(pub fn (openAsset)\n  (match (hexDecode \"")
      (vecPush parts (hexEncode a))
      (vecPush parts "\")\n    ((Err e) (Err e))\n    ((Ok a)\n      (match (hexDecode \"")
      (vecPush parts (hexEncode b))
      (vecPush parts "\")\n        ((Err e) (Err e))\n        ((Ok b)\n          (match (obfuscationKeyFromShares a b)\n            ((Err e) (Err e))\n            ((Ok key)\n              (let ((r (match (hexDecode \"")
      (vecPush parts (hexEncode context))
      (vecPush parts "\")\n                ((Err e) (Err e))\n                ((Ok context)\n                  (match (hexDecode \"")
      (vecPush parts (hexEncode envelope))
      (vecPush parts "\")\n                    ((Err e) (Err e))\n                    ((Ok envelope) (obfuscationOpen key context envelope)))))))\n                {\n                  (obfuscationKeyWipe key)\n                  r\n                }))))))))\n")
      (let ((mut out ""))
        {
          (for part in parts
            (set out (concat out part)))
          out
        })
    }))

(:: packWithShares (-> String String String String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (packWithShares input output context a b)
  (match (obfuscationKeyFromShares a b)
    ((Err e) (Err e))
    ((Ok key)
      (let ((sealed (obfuscationSeal key context input)))
        {
          (obfuscationKeyWipe key)
          (match sealed
            ((Err e) (Err e))
            ((Ok envelope) (writeFile output (moduleText a b context envelope))))
        })
    )))

(:: packAsset (-> String String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (packAsset input output context)
  (match (fileSize input)
    ((Err e) (Err e))
    ((Ok n)
      (if (> n obfuscationMaxBytes)
        (cryptoErr cryptoLimitExceeded "the input asset exceeds 64 MiB" "axobfuscate")
        (match (openPath input oRdonly)
          ((Err e) (Err e))
          ((Ok file)
            (match (fileReadAll file)
              ((Err e) (Err e))
              ((Ok bytes)
                (if (!= (strLen bytes) n)
                  (cryptoErr cryptoInvalidLength "the input file changed while being read" "axobfuscate")
                  (match (secureRandomBytes 32)
                    ((Err e) (Err e))
                    ((Ok a)
                      (match (secureRandomBytes 32)
                        ((Err e) (Err e))
                        ((Ok b) (packWithShares
                          bytes
                          output
                          context
                          a
                          b)))
                    )))
              ))
          )))
    )))

(:: main (Result Int Error))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (main)
  (if (!= sysArgc 4)
    {
      (eprintln "usage: axobfuscate INPUT OUTPUT.ax CONTEXT")
      (Ok 2)
    }
    (match (packAsset (sysArg 1) (sysArg 2) (sysArg 3))
      ((Err e) (Err e))
      ((Ok _) (Ok 0)))))
