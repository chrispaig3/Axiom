# macOS Finder metadata. One of these was committed at the root and
# nothing here would have stopped the next.
.DS_Store
**/.DS_Store

# Editor and tooling backups.
**/*.bak

# tree-sitter build artifacts and the locally installed CLI
tree-sitter-axiom/node_modules/
tree-sitter-axiom/*.dylib
tree-sitter-axiom/*.so
tree-sitter-axiom/*.dll
tree-sitter-axiom/package-lock.json

# The compiler a gate provisions for itself from `bootstrap/`, via
# `scripts/bootstrap-from-seed.sh --install`. Built, not committed -
# `bootstrap/` is the committed artifact.
.axiom-bin/

# Worktrees created by tooling.
.claude/worktrees/

# Python bytecode from the gate helpers under tests/.
__pycache__/
*.pyc

# Cargo's build artifacts. `rust/` is the only cargo project in this
# repository - it is the FFI's Rust side - so the pattern is scoped to
# it rather than written as a bare `target/` at the root: the compiler
# itself is written in Axiom and builds with `llc` and `cc`, and nothing
# outside rust/ produces a target/ directory. The generated `.ax`
# binding modules under rust/examples/*/axiom/ are NOT ignored: they are
# committed so `axiom check` and `axiom fmt` work on a checkout with no
# cargo, which is the same property scripts/bootstrap-from-seed.sh has.
rust/target/
rust/examples/*/target/
