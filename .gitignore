# macOS Finder metadata.
.DS_Store
**/.DS_Store

# Editor and tooling backups.
**/*.bak

# tree-sitter build artifacts and the locally installed CLI. The
# lockfile is committed: `npm ci` can't run without it, and it is what
# pins the CLI and its dependencies.
tree-sitter-axiom/node_modules/
tree-sitter-axiom/*.dylib
tree-sitter-axiom/*.so
tree-sitter-axiom/*.dll

# The compiler a gate provisions for itself from `bootstrap/`, via
# `scripts/bootstrap-from-seed.sh --install`. `bootstrap/` is the
# committed artifact.
.axiom-bin/
# The compiler `scripts/run-gates.sh` builds once for every gate in a
# battery to copy (`scripts/build-shared-axc.sh` writes the pair, `ci.yml`
# exports it as `AXIOM_AXC`). Ignored so `git add -A` can't commit it.
.axiom-shared/

# Worktrees created by tooling.
.claude/worktrees/

# Python bytecode from the gate helpers under tests/.
__pycache__/
*.pyc

# Cargo's build artifacts. `rust/` is the only cargo project here (the
# FFI's Rust side), so the pattern is scoped to it. The generated `.ax`
# binding modules under rust/examples/*/axiom/ are committed, so
# `axiom check` and `axiom fmt` work on a checkout with no cargo.
rust/target/
rust/examples/*/target/

# The website under `web/`. `package-lock.json` is committed: the Pages
# workflow runs `npm ci`, which needs it, and a build that resolves its
# own dependency versions isn't reproducible.
web/node_modules/
web/dist/
web/.smoke-entry.tsx
web/.smoke-bundle.mjs
web/.tok-entry.ts
web/.tok-bundle.mjs
web/.samples-entry.ts
web/.samples-bundle.mjs
web/.prerender-entry.tsx
web/.prerender-bundle.mjs

# `axiom run` builds into the working directory and names the scratch
# executable `axiom_temp_output.<pid>`. It removes the executable only
# after the child returns, so an interrupted run (a server stopped with
# SIGTERM, say) leaves it behind. `scripts/check-examples.sh`'s hygiene
# sweep catches one committed under `examples/`, under any name.
axiom_temp_output.*

# Scratch names a program can write by relative path into the working
# directory. No file in the tree writes them; the lines keep a stray one
# from a manual `axiom run` at the root out of `git add -A`.
fail.tmp
out.tmp
resp.tmp
secret.txt
pub/

# Node packages a local skill installs; never part of the tree.
.claude/node_modules/
.claude/package.json
.claude/package-lock.json
