; expect 42
; Slice seed: a trait method name captured every call with that
; spelling, so a `let` binding and a function parameter both answered
; the implementation. Every consumer of the frontend has to agree that
; this program is accepted AND that it computes 42.
(trait (Sz a) where (
  sz :: (-> a Int)
))

(impl (Sz Int) where (
  (sz
    (lambda (n) 111)
  )
))

(:: viaParam (-> (-> Int Int) Int))

(fn (viaParam sz) (sz 5))

(:: main Int)

(fn (main)
  (if (==
    (+
      (let ((sz 
        (lambda (q) 7)
      ))
        (sz 5)
      )      (+
        (viaParam
          (lambda (q) 7)
        )        (sz 5)
      )
    )    125
  )
    42
    1
  )
)
