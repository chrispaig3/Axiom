; The runner supplies the production snapshot walker with hash 15, forcing
; collision chains to wrap and move when the typed table grows.
(import CheckedSnapshotProbe)
(import core)
(import parser)
(import Vec)
(import Mem)
(import Str)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: rc (-> Int Int))
;@axiom:effect(unsafe)
(fn (rc address)
  (__load64 address -2))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let seen probeNew)
    (say 1 (! (probeVisit nilNode seen)))
    (say 2 (== (probeCount seen) 0))
    (say 3 (== (probeCapacity seen) 16))
    (say 4 (== (probeOccupied seen) 0))
    (let first (mkEInt 42))
    (let firstCount (rc (as first Int)))
    (say 5 (probeVisit first seen))
    (say 6 (== (probeCapacity seen) 16))
    (say 7 (== (probeStorageCapacity seen) 16))
    (say 8 (== (probeSlotsCount seen) 1))
    (say 9 (== (rc (as first Int)) firstCount))
    (say 10 (! (probeVisit first seen)))
    (say 11 (== (probeCount seen) 1))
    (say 12 (== (rc (as first Int)) firstCount))
    (let second (mkEInt 42))
    (say 13 (probeVisit second seen))
    (say 14 (&& (probeHas first seen) (probeHas second seen)))
    (let third (mkEInt 73))
    (say 15 (probeVisit third seen))
    (say 16 (== (probeOccupied seen) 3))
    (say 17
      (&& (addrEq (probeAt seen 15) (addrOf first))
        (&& (addrEq (probeAt seen 0) (addrOf second)) (addrEq (probeAt seen 1) (addrOf third)))))
    (say 18 (&& (! (probeVisit nilNode seen)) (== (probeCount seen) 3)))
    (let large probeNew)
    (let nodes vecNew)
    (let mut bounded true)
    (for i in 0..100
      {
        (let node (mkEInt i))
        (vecPush nodes node)
        (if (! (probeVisit node large))
          (set bounded false))
        (if (> (* (probeCount large) 4) (* (probeCapacity large) 3))
          (set bounded false))
      })
    (say 19 bounded)
    (say 20 (&& (== (probeCount large) 100) (== (probeCapacity large) 256)))
    (say 21 (== (probeStorageCapacity large) 256))
    (say 22 (== (probeOccupied large) 100))
    (say 23 (== (probeNilCount large) (- (probeCapacity large) 100)))
    (let mut present true)
    (for node in nodes
      (if (! (probeHas node large))
        (set present false)))
    (say 24 present)
    (let mut duplicates true)
    (for node in nodes
      (if (probeVisit node large)
        (set duplicates false)))
    (say 25 (&& duplicates (&& (== (probeCount large) 100) (== (probeCapacity large) 256))))
    ; Address slots take no node shares. Repeated scalar-returning walks
    ; must also retire their record, table header and storage completely.
    (let owned (mkEInt 91))
    (say 26 (== (probeOwnerDropDelta owned) 0))
    ; An explicit typed getter alias keeps the displaced table alive
    ; across rehash. The set itself owns exactly one replacement share.
    (let aliased probeNew)
    (let aliasNodes vecNew)
    (for i in 0..12
      {
        (let node (mkEInt (+ i 1000)))
        (vecPush aliasNodes node)
        (probeVisit node aliased)
      })
    (say 27 (== (probeCapacity aliased) 16))
    (say 28 (== (probeSlotsCount aliased) 1))
    (let oldSlots (probeSlots aliased))
    (say 29 (== (rc (as oldSlots Int)) 2))
    (let aliasFirst (vecGet aliasNodes 0))
    (let aliasFirstCount (rc (as aliasFirst Int)))
    ; Duplicating at the load bound must not trigger a grow.
    (say 30 (&& (! (probeVisit aliasFirst aliased)) (== (probeCapacity aliased) 16)))
    (let aliasExtra (mkEInt 2000))
    (probeVisit aliasExtra aliased)
    (say 31 (&& (== (probeCapacity aliased) 32) (== (probeSlotsCount aliased) 1)))
    (say 32 (== (rc (as oldSlots Int)) 1))
    (say 33 (&& (== (vecLen oldSlots) 16) (addrEq (vecGet oldSlots 15) (addrOf aliasFirst))))
    (say 34 (== (rc (as aliasFirst Int)) aliasFirstCount))
    (let mut aliasesPresent true)
    (for node in aliasNodes
      (if (! (probeHas node aliased))
        (set aliasesPresent false)))
    (say 35 (&& aliasesPresent (== (probeOccupied aliased) 13)))
    (let shared (mkEInt 17))
    (let children (vecPush (vecPush vecNew shared) shared))
    (let parent (mkEBegin children))
    (let roots (vecPush vecNew parent))
    (let snapshot (probeSnapshot roots))
    (say 36 (== (probeNodeCount snapshot) 2))
    (say 37 (probeUnchanged snapshot))
    (writeNodeWord shared 1 18)
    (say 38 (! (probeUnchanged snapshot)))
    (let cycleChildren vecNew)
    (let cycle (mkEBegin cycleChildren))
    (vecPush cycleChildren cycle)
    (let cycleSnapshot (probeSnapshot (vecPush vecNew cycle)))
    (say 39 (== (probeNodeCount cycleSnapshot) 1))
    (say 40 (probeUnchanged cycleSnapshot))
    (vecPush cycleChildren (mkEInt 91))
    (say 41 (! (probeUnchanged cycleSnapshot)))
    ; Empty input emits no wrappers. Nonempty snapshots use no more than
    ; one nonempty wrapper for each of nodes, child lists and name lists.
    (say 42 (== (vecLen (probeSnapshot vecNew)) 0))
    (say 43 (== (vecLen (probeSnapshot (vecPush vecNew nilNode))) 0))
    (let scalar (mkEInt 8))
    (let scalarRoots (vecPush vecNew scalar))
    (let scalarSnapshot (probeSnapshot scalarRoots))
    (say 44
      (&& (== (vecLen scalarSnapshot) 1)
        (&& (== (probeNodeCount scalarSnapshot) 1) (probeUnchanged scalarSnapshot))))
    (let params (vecPush vecNew (strDup "argument")))
    (let bodyChildren (vecPush vecNew (mkEInt 19)))
    (let body (mkEBegin bodyChildren))
    (let function (mkDFnAt "batch" params body 0))
    (let functionRoots (vecPush vecNew function))
    (let allBatches (probeSnapshot functionRoots))
    (say 45 (&& (== (vecLen allBatches) 3) (== (probeNodeCount allBatches) 3)))
    (say 46 (probeNonemptyBatches allBatches))
    (say 47 (probeUnchanged allBatches))
    (vecSet params 0 (strDup "argument"))
    (say 48 (! (probeUnchanged allBatches)))
    (let emptyChildren vecNew)
    (let emptyBegin (mkEBegin emptyChildren))
    (let emptyChildSnapshot (probeSnapshot (vecPush vecNew emptyBegin)))
    (vecPush emptyChildren (mkEInt 1))
    (say 49 (&& (== (vecLen emptyChildSnapshot) 2) (! (probeUnchanged emptyChildSnapshot))))
    (let emptyParams vecNew)
    (let emptyFunction (mkDFnAt "empty" emptyParams (mkEInt 1) 0))
    (let emptyNameSnapshot (probeSnapshot (vecPush vecNew emptyFunction)))
    (vecPush emptyParams "new")
    (say 50 (&& (== (vecLen emptyNameSnapshot) 2) (! (probeUnchanged emptyNameSnapshot))))
    ; Construct malformed private pairs to pin every length guard before
    ; indexing, both at the batch boundary and inside captured views.
    (let oneNode (vecPush vecNew scalar))
    (let otherNode (vecPush vecNew (mkEInt 9)))
    (let equalNode (vecPush vecNew (mkEInt 8)))
    (let copiedNode (vecPush vecNew (nodeClone scalar)))
    (say 51 (probeNodeBatchSame vecNew vecNew))
    (say 52 (! (probeNodeBatchSame oneNode vecNew)))
    (say 53 (! (probeNodeBatchSame vecNew oneNode)))
    (say 54 (! (probeNodeBatchSame oneNode otherNode)))
    (let oneView (vecPush vecNew oneNode))
    (let emptyView (vecPush vecNew vecNew))
    (let otherView (vecPush vecNew equalNode))
    (let copiedView (vecPush vecNew oneNode))
    (say 55 (probeNodesBatchSame vecNew vecNew))
    (say 56 (! (probeNodesBatchSame oneView vecNew)))
    (say 57 (! (probeNodesBatchSame oneView emptyView)))
    (say 58 (! (probeNodesBatchSame oneView otherView)))
    (let oneName (vecPush vecNew (strDup "same")))
    (let otherName (vecPush vecNew (strDup "same")))
    (let nameView (vecPush vecNew oneName))
    (let otherNameView (vecPush vecNew otherName))
    (let copiedNameView (vecPush vecNew oneName))
    (let emptyNameView (vecPush vecNew vecNew))
    (say 59 (probeNamesBatchSame vecNew vecNew))
    (say 60 (! (probeNamesBatchSame nameView vecNew)))
    (say 61 (! (probeNamesBatchSame nameView emptyNameView)))
    (say 62 (! (probeNamesBatchSame nameView otherNameView)))
    (say 63 probeAllWordGuards)
    ; Each wrapper takes one share of each typed outer vector and gives
    ; those shares back on ordinary lexical cleanup. No manual releases.
    (let actualCount (probeReferenceCount oneNode))
    (let acceptedCount (probeReferenceCount copiedNode))
    (say 64 (probeOwnedNodeBatch oneNode copiedNode))
    (say 65
      (&& (== (probeReferenceCount oneNode) actualCount)
        (== (probeReferenceCount copiedNode) acceptedCount)))
    (let actualViews (probeReferenceCount oneView))
    (let acceptedViews (probeReferenceCount copiedView))
    (say 66 (probeOwnedNodesBatch oneView copiedView))
    (say 67
      (&& (== (probeReferenceCount oneView) actualViews)
        (== (probeReferenceCount copiedView) acceptedViews)))
    (let actualNames (probeReferenceCount nameView))
    (let acceptedNames (probeReferenceCount copiedNameView))
    (say 68 (probeOwnedNamesBatch nameView copiedNameView))
    (say 69
      (&& (== (probeReferenceCount nameView) actualNames)
        (== (probeReferenceCount copiedNameView) acceptedNames)))
    ; Retain each production batch field through a typed getter alias.
    ; Clearing the wrapper vector must leave exactly that alias share.
    (let clearable (probeSnapshot functionRoots))
    (let originalNodes (probeOriginalNodes clearable))
    (let copiedNodes (probeCopiedNodes clearable))
    (let originalChildren (probeOriginalChildren clearable))
    (let copiedChildren (probeCopiedChildren clearable))
    (let originalNames (probeOriginalNames clearable))
    (let copiedNames (probeCopiedNames clearable))
    (say 70
      (&& (== (probeReferenceCount originalNodes) 2)
        (&& (== (probeReferenceCount copiedNodes) 2)
          (&& (== (probeReferenceCount originalChildren) 2)
            (&& (== (probeReferenceCount copiedChildren) 2)
              (&& (== (probeReferenceCount originalNames) 2)
                (== (probeReferenceCount copiedNames) 2)))))))
    (vecClear clearable)
    (say 71
      (&& (== (probeReferenceCount originalNodes) 1)
        (&& (== (probeReferenceCount copiedNodes) 1)
          (&& (== (probeReferenceCount originalChildren) 1)
            (&& (== (probeReferenceCount copiedChildren) 1)
              (&& (== (probeReferenceCount originalNames) 1)
                (== (probeReferenceCount copiedNames) 1)))))))
    (say 72 (! (probeNodesBatchSame vecNew oneView)))
    (say 73 (! (probeNamesBatchSame vecNew nameView)))
    (say 74 (! (probeNodesBatchSame emptyView oneView)))
    (say 75 (! (probeNamesBatchSame emptyNameView nameView)))
    0
  })
