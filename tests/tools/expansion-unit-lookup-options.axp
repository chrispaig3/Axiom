(import core)
(import expand)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: unit (-> (Option String) String CUnit2))
(fn (unit name file)
  (CUnit2 :file file :src "source" :name name :imports vecNew :library false))

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs found expected)
  (match found
    ((None) false)
    ((Some index) (== index expected))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let units (:: vecNew Units))
    (say 1 (isNone (expUnitOfMod units None)))
    (say 2 (isNone (expUnitOfModFrom units None 0)))
    (vecPush units (unit None "entry.ax"))
    (vecPush units (unit (Some "A") "a.ax"))
    (vecPush units (unit (Some "B") "b.ax"))
    (say 3 (indexIs (expUnitOfMod units None) 0))
    (say 4 (indexIs (expUnitOfMod units (Some "B")) 2))
    (say 5 (isNone (expUnitOfMod units (Some "Missing"))))
    (say 6 (indexIs (expUnitOfModFrom units (Some "B") 1) 2))
    (say 7 (isNone (expUnitOfModFrom units (Some "B") 3)))
    (say 8 (strEq (expAsmFileFor units None) "entry.ax"))
    (say 9 (strEq (expAsmFileFor units (Some "B")) "b.ax"))
    (say 10 (strEq (expAsmFileFor units (Some "Missing")) ""))
    (say 11 (== (expUnitForDiag units (Some "Missing")) 0))
    (say 12 (== (expUnitForDiag units (Some "B")) 2))
    (say 13 (indexIs (expUnitOfMod units (Some "")) 0))
    (say 14 (strEq (expAsmFileFor (:: vecNew Units) None) ""))
    (say 15 (== (expUnitForDiag (:: vecNew Units) None) 0))
    (say 16 (indexIs (expUnitOfMod units (Some "A")) 1))
    0
  })
