(import core)
(import parser)
(import lexer)
(import typecheck)
(import codegen)
(import expand)
(import symbols)
(import lsp)
(import Cereal)
(import Vec)
(import Str)
(import Mem)
(import IO)

; The fixture requires a successful parse before inspecting its typed value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: unit (-> (Option String) Bool CUnit2))
(fn (unit name library)
  (CUnit2 :file "unit.ax" :src "sample" :name name :imports vecNew :library library))

(:: nameIs (-> (Option String) String Bool))
(fn (nameIs found wanted)
  (match found
    ((None) false)
    ((Some name) (strEq name wanted))))

(:: keepName (-> (Option String) (Option String)))
(fn (keepName name)
  (unitName (unit name false)))

(:: retireName (-> String Int))
(fn (retireName name)
  (if (isSome (unitName (unit (Some name) false)))
    0
    1))

(:: pooledName (-> String (Option String)))
(fn (pooledName name)
  {
    (let rows (vecPush vecNew (unit (Some name) false)))
    (unitName (vecGet rows 0))
  })

(:: wireUnit (-> Units String Int))
(fn (wireUnit units name)
  (lspUnitOf units (as name Int)))

(:: hoverText (-> String Nodes ASTNode (Option String) String))
(fn (hoverText source declarations declaration name)
  (jsonGetStr
    (jsonGet
      (lspHoverAt source declarations declaration (lspRange source (nodeSpan declaration)) name)
      "contents")
    "value"))

(:: symbol (-> String Int (Option String) Int))
(fn (symbol source span name)
  {
    (let out jsonArr)
    (lspViewSymOffer out vecNew "" "file:///unit.ax" source (lspLineIndex source) "twice" 12 span
      name)
    (jsonArrGet out 0)
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let entry (unit None true))
    (let empty (unit (Some "") false))
    (let imported (unit (Some "Module") false))
    (say 1 (unitIsEntry entry))
    (say 2 (isNone (unitName entry)))
    (say 3 (! (unitNameIs entry "")))
    (say 4 (! (unitIsEntry empty)))
    (say 5 (nameIs (unitName empty) ""))
    (say 6 (unitNameIs empty ""))
    (say 7 (! (unitIsEntry imported)))
    (say 8 (unitNameIs imported "Module"))
    (say 9 (! (unitNameIs imported "Missing")))
    (say 10 (&& (strEq (unitFile imported) "unit.ax") (strEq (unitSrc imported) "sample")))
    (say 11 (isNone (keepName None)))
    (let owned (strDup "Owned"))
    (let before (count owned))
    (let kept (keepName (Some owned)))
    (say 12 (nameIs kept "Owned"))
    (say 13 (== (count owned) (+ before 1)))
    (let retired (strDup "Retired"))
    (let retiredBefore (count retired))
    (retireName retired)
    (say 14 (== (count retired) retiredBefore))
    (say 15 (isNone (keepName (unitName entry))))
    (say 16 (nameIs (pooledName (strDup "Pooled")) "Pooled"))
    (let internal (unit (Some "Internal.Low") true))
    (let units (vecPush (vecPush (vecPush (vecPush vecNew entry) empty) imported) internal))
    (say 17 (== (unitIndexFor units None) 0))
    (say 18 (== (unitIndexFor units (Some "")) 1))
    (say 19 (== (unitIndexFor units (Some "Module")) 2))
    (say 20 (== (unitIndexFor units (Some "Missing")) 0))
    (say 21
      (match (unitIndexOf units "Module" 0)
        ((Some index) (== index 2))
        ((None) false)))
    (say 22
      (match (unitIndexOf units "" 0)
        ((Some index) (== index 1))
        ((None) false)))
    (say 23 (isNone (unitIndexOf units "Missing" 0)))
    (say 24 (isNone (expUnitMod units 0)))
    (say 25 (nameIs (expUnitMod units 1) ""))
    (say 26 (nameIs (expUnitMod units 2) "Module"))
    (say 27
      (match (expUnitOfMod units (Some "Module"))
        ((None) false)
        ((Some index) (== index 2))))
    (say 28 (unitIsInternal internal))
    (say 29 (! (unitIsInternal entry)))
    (say 30 (! (unitIsInternal (unit (Some "Internal.Low") false))))
    (let internals (internalUnitNames units 0 vecNew))
    (say 31 (&& (== (vecLen internals) 1) (strEq (vecGet internals 0) "Internal.Low")))
    (let marks vecNew)
    (libraryMarksInto units marks 0)
    (say 32
      (&& (== (vecLen marks) 2)
        (&& (strEq (vecGet marks 0) "library ") (strEq (vecGet marks 1) "library Internal.Low"))))
    (say 33 (unitNamedInternal units "Internal.Low" 0))
    (say 34 (! (unitNamedInternal units "Module" 0)))
    (say 35
      (match (saUnitOf units (Some "Module"))
        ((None) false)
        ((Some index) (== index 2))))
    (say 36 (== (lspUnitNamed units "Module") 2))
    (say 37 (== (lspUnitNamed units "") 1))
    (say 38 (== (lspUnitNamed units "Missing") -1))
    (say 39 (== (wireUnit units "Module") 2))
    (let source "(fn (twice n) n)\n")
    (let declarations (expectParsed (parseModuleWith (lex source) (scanAxtags source))))
    (let declaration (vecGet declarations 0))
    (let localHover (hoverText source declarations declaration None))
    (say 40
      (isSome
        (strFind (hoverText source declarations declaration (Some "Module")) "from `Module`" 0)))
    (say 41 (isNone (strFind localHover "from `" 0)))
    (say 42 (strEq localHover (hoverText source declarations declaration (Some ""))))
    (let localSignature (lspViewSigFn source declarations declaration None))
    (say 43
      (strEq (jsonGetStr (lspViewSigFn source declarations declaration (Some "Module")) "label")
        "(twice n) from Module"))
    (say 44 (strEq (jsonGetStr localSignature "label") "(twice n)"))
    (say 45
      (strEq (jsonWrite localSignature)
        (jsonWrite (lspViewSigFn source declarations declaration (Some "")))))
    (say 46
      (strEq (jsonGetStr (symbol source (nodeSpan declaration) (Some "Module")) "containerName")
        "Module"))
    (say 47 (isNone (jsonFind (symbol source (nodeSpan declaration) None) "containerName")))
    (say 48 (isNone (jsonFind (symbol source (nodeSpan declaration) (Some "")) "containerName")))
    0
  })
