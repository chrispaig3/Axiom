; Declaration-name ownership, empty success and deliberate refusal.
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)
(import Intern)
(import core)
(import lexer)
(import parser)
(import diag)
(import namespace)
(import expand)
(import mir)
(import mireval)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: environment (-> Diags Units Nodes MEnv))
(fn (environment diagnostics units declarations)
  (MEnv
    :macros vecNew
    :out diagnostics
    :fresh 0
    :depth 0
    :decls declarations
    :macmod 0
    :walk 0
    :nodes 0
    :blown 0
    :site 0
    :frames vecNew
    :declmod 0
    :units units
    :forstack vecNew
    :bares vecNew
    :fulls vecNew
    :mods vecNew
    :qsite 0
    :gens vecNew
    :callbs 0
    :seqbinds vecNew
    :tplbinds vecNew
    :declnodes 0
    :midx mangleIdxNew
    :scNext 0
    :scChain vecNew
    :scTpl vecNew
    :scSeq 0
    :retired28 0
    :defer 0
    :deferHits 0
    :structNames internNewTyped
    :structBuckets vecNew
    :carrier 0
    :optNames vecNew))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: expression (-> String ASTNode))
(fn (expression body)
  {
    (let parsed (parseModule (lex (concat (concat "(fn (probe) " body) ")"))))
    (match parsed
      ((ParseFailed parseError1) (mkEInt -900))
      ((ParseSuccess parsedValue1 parsedPos1) (nodeCChild (vecGet parsedValue1 0))))
  })

(:: named (-> (Option String) String Bool))
(fn (named answer want)
  (if (let (Some name) answer)
    (strEq name want)
    false))

(:: evaluatesExpansion (-> String Int Bool))
;@axiom:effect(io)
(fn (evaluatesExpansion source want)
  {
    (let parsed (parseModule (lex source)))
    (match parsed
      ((ParseFailed parseError2) false)
      ((ParseSuccess parsedValue2 parsedPos2)
        {
          (let declarations parsedValue2)
          (let diagnostics (:: vecNew Diags))
          (expandProgram declarations declarations diagnostics vecNew vecNew vecNew vecNew vecNew)
          (if (== (countErrorDiags diagnostics) 0)
            {
              (let functions (:: vecNew (Vec MFunc)))
              (let refused (:: vecNew Names))
              (mLowerDecls declarations functions refused 0)
              (&& (== (vecLen refused) 0) (== (mvalCall1 functions "main" 0) want))
            }
            false)
        }
      ))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let diagnostics (:: vecNew Diags))
    (let env (environment diagnostics vecNew vecNew))
    (let parameters (vecPush (vecPush vecNew "left") "right"))
    (let values (vecPush (vecPush vecNew (mkEVar "Owned")) (mkEVar "Result")))
    (say 1 (named (expSubstName "plain" vecNew vecNew env 0) "plain"))
    (say 2 (named (expSubstName "" vecNew vecNew env 0) ""))
    (say 3 (named (expSubstName "left" parameters values env 0) "Owned"))
    (say 4 (named (expSubstName "syntax/join left right" parameters values env 0) "OwnedResult"))
    (say 5
      (named (expSubstName "syntax/join syntax/join get left right" parameters values env 0)
        "getOwnedResult"))
    (say 6
      (if (let None (expSubstName "left" parameters
                      (vecPush (vecPush vecNew (mkEInt 1)) (mkEInt 2)) env 0))
        true
        false))
    (say 7 (&& (== (vecLen diagnostics) 1) (strEq (diagCode (vecGet diagnostics 0)) "AX3027")))
    (expTrunc diagnostics 0)
    (say 8
      (if (let None (expSubstName "syntax/join left right" parameters
                      (vecPush (vecPush vecNew (mkEInt 1)) (mkEInt 2)) env 0))
        true
        false))
    (say 9 (== (vecLen diagnostics) 1))
    (expTrunc diagnostics 0)
    (vecPush env.forstack (ForBind :name "left" :elem "Inner" :key "test" :idx 0 :seq 0))
    (say 10
      (named
        (expSubstName "left" parameters (vecPush (vecPush vecNew (mkEInt 1)) (mkEInt 2)) env 0)
        "Inner"))
    (say 11 (== (vecLen diagnostics) 0))
    (expTrunc env.forstack 0)
    (say 12
      (if (let (Some names) (expSubstNames vecNew parameters values env 0))
        (== (vecLen names) 0)
        false))
    (say 13
      (if (let (Some names) (expSubstNames parameters parameters values env 0))
        (&& (== (vecLen names) 2) (strEq (vecGet names 1) "Result"))
        false))
    (say 14
      (if (let None (expSubstNames parameters parameters
                      (vecPush (vecPush vecNew (mkEInt 1)) (mkEInt 2)) env 0))
        true
        false))
    (say 15 (== (vecLen diagnostics) 1))
    (expTrunc diagnostics 0)
    (say 16
      (named
        (expSubstTyName
          (mkTCon "syntax/join" (vecPush (vecPush vecNew (mkTVar "left")) (mkTVar "right")))
          parameters values env 0)
        "OwnedResult"))
    (say 17
      (if (let None (expSubstTyName (mkTTup vecNew) parameters values env 0))
        true
        false))
    (say 18 (&& (== (vecLen diagnostics) 1) (strEq (diagCode (vecGet diagnostics 0)) "AX3028")))
    (expTrunc diagnostics 0)
    (say 19
      (==
        (nodeTag
          (expSubstTy (mkTVar "left") parameters
            (vecPush (vecPush vecNew (mkEInt 1)) (mkEVar "Result")) env 0))
        TAG_T_ERR))
    (say 20 (== (vecLen diagnostics) 1))
    (expTrunc diagnostics 0)
    (say 21
      (evaluatesExpansion
        "(macro make ((make N) (:: (syntax/join generated N) (-> Int Int)) (fn ((syntax/join generated N) n) (+ n 4)))) (make Result) (:: main Int) (fn (main) (generatedResult 5))"
        9))
    (say 22
      (evaluatesExpansion
        "(macro make ((make P) (:: generated (-> Int Int)) (fn (generated P) (+ P 3)))) (make input) (:: main Int) (fn (main) (generated 5))"
        8))
    (let template (vecGet (expectParsed (parseModule (lex "(fn (left right) 1)"))) 0))
    (say 23
      (if (let None (expBuildOneDecl template parameters
                      (vecPush (vecPush vecNew (mkEInt 1)) (mkEVar "Result")) env 0))
        true
        false))
    (say 24 (== (vecLen diagnostics) 1))
    (expTrunc diagnostics 0)
    (say 25
      (if (let None (expBuildOneDecl template parameters
                      (vecPush (vecPush vecNew (mkEVar "Owned")) (mkEInt 2)) env 0))
        true
        false))
    (say 26 (== (vecLen diagnostics) 1))
    0
  })
