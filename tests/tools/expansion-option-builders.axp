; Optional builder results distinguish empty expansion and refusal.
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)
(import Intern)
(import core)
(import lexer)
(import parser)
(import diag)
(import namespace)
(import expand)
(import mir)
(import mireval)

(:: environment (-> Diags Units Nodes MEnv))
(fn (environment diagnostics units declarations)
  (MEnv
    :macros vecNew
    :out diagnostics
    :fresh 0
    :depth 0
    :decls declarations
    :macmod 0
    :walk 0
    :nodes 0
    :blown 0
    :site 0
    :frames vecNew
    :declmod 0
    :units units
    :forstack vecNew
    :bares vecNew
    :fulls vecNew
    :mods vecNew
    :qsite 0
    :gens vecNew
    :callbs 0
    :seqbinds vecNew
    :tplbinds vecNew
    :declnodes 0
    :midx mangleIdxNew
    :scNext 0
    :scChain vecNew
    :scTpl vecNew
    :scSeq 0
    :retired28 0
    :defer 0
    :deferHits 0
    :structNames internNewTyped
    :structBuckets vecNew
    :carrier 0
    :optNames vecNew))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: declarations (-> String Nodes))
(fn (declarations source)
  {
    (let parsed (parseModule (lex source)))
    (match parsed
      ((ParseFailed parseError1) vecNew)
      ((ParseSuccess parsedValue1 parsedPos1) parsedValue1))
  })

(:: declaration (-> String ASTNode))
(fn (declaration source)
  (vecGet (declarations source) 0))

(:: countRows (-> (Option Nodes) Int Bool))
(fn (countRows answer size)
  (if (let (Some nodes) answer)
    (== (vecLen nodes) size)
    false))

(:: noRows (-> (Option Nodes) Bool))
(fn (noRows answer)
  (if (let None answer)
    true
    false))

(:: noNode (-> (Option ASTNode) Bool))
(fn (noNode answer)
  (if (let None answer)
    true
    false))

(:: evaluatesExpansion (-> String Int Bool))
;@axiom:effect(io)
(fn (evaluatesExpansion source want)
  {
    (let parsed (parseModule (lex source)))
    (match parsed
      ((ParseFailed parseError2) false)
      ((ParseSuccess parsedValue2 parsedPos2)
        {
          (let declarations parsedValue2)
          (let diagnostics (:: vecNew Diags))
          (expandProgram declarations declarations diagnostics vecNew vecNew vecNew vecNew vecNew)
          (if (== (countErrorDiags diagnostics) 0)
            {
              (let functions (:: vecNew (Vec MFunc)))
              (let refused (:: vecNew Names))
              (mLowerDecls declarations functions refused 0)
              (&& (== (vecLen refused) 0) (== (mvalCall1 functions "main" 0) want))
            }
            false)
        }
      ))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let diagnostics (:: vecNew Diags))
    (let env (environment diagnostics vecNew vecNew))
    (let parameters (vecPush (vecPush vecNew "N") "P"))
    (let values (vecPush (vecPush vecNew (mkEVar "Owned")) (mkEVar "input")))
    (let template (declaration "(fn (N P) 1)"))
    (say 1 (countRows (expBuildDecls vecNew parameters values env 0 vecNew 0) 0))
    (say 2
      (if (let (Some node) (expBuildOneDecl template parameters values env 0))
        (&& (strEq (nodeAName node) "Owned") (strEq (vecGet (nodeBNames node) 0) "input"))
        false))
    (say 3
      (noNode
        (expBuildOneDecl template parameters (vecPush (vecPush vecNew (mkEInt 3)) (mkEVar "input"))
          env 0)))
    (say 4 (== (vecLen diagnostics) 1))
    (expTrunc diagnostics 0)
    (say 5 (countRows (expBuildDecls (vecPush vecNew template) parameters values env 0 vecNew 0) 1))
    (say 6
      (noRows
        (expBuildDecls (vecPush vecNew template) parameters
          (vecPush (vecPush vecNew (mkEVar "Owned")) (mkEInt 3)) env 0 vecNew 0)))
    (expTrunc diagnostics 0)
    (say 7 (countRows (expBuildCtors vecNew parameters values env 0) 0))
    (say 8 (countRows (expBuildStructFields vecNew parameters values env 0) 0))
    (let data (declaration "(data T (N Int) (Ready))"))
    (say 9 (countRows (expBuildCtors (nodeBChildren data) parameters values env 0) 2))
    (say 10
      (if (let (Some nodes) (expBuildCtors (nodeBChildren data) parameters values env 0))
        (strEq (nodeAName (vecGet nodes 0)) "Owned")
        false))
    (say 11
      (noRows
        (expBuildCtors (nodeBChildren data) parameters
          (vecPush (vecPush vecNew (mkEInt 3)) (mkEVar "input")) env 0)))
    (expTrunc diagnostics 0)
    (let structure (declaration "(struct S (mut P : Int))"))
    (say 12
      (if (let (Some fields) (expBuildStructFields (nodeBChildren structure) parameters values env
                               0))
        (&& (strEq (nodeAName (vecGet fields 0)) "input") (== (nodeCWord (vecGet fields 0)) 1))
        false))
    (say 13
      (noRows
        (expBuildStructFields (nodeBChildren structure) parameters
          (vecPush (vecPush vecNew (mkEVar "Owned")) (mkEInt 3)) env 0)))
    (expTrunc diagnostics 0)
    (say 14 (noRows (expSpliceOneDecl template parameters values env 0)))
    (say 15 (&& (== (vecLen diagnostics) 1) (strEq (diagCode (vecGet diagnostics 0)) "AX3034")))
    (expTrunc diagnostics 0)
    (set env.seqbinds (vecPush vecNew (SeqBind :name "N" :forms vecNew)))
    (say 16 (countRows (expSpliceOneDecl template parameters values env 0) 0))
    (say 17
      (countRows (expSpliceOneCtor (vecGet (nodeBChildren data) 0) parameters values env 0) 0))
    (set env.seqbinds (vecPush vecNew
                        (SeqBind
                          :name "N"
                          :forms (vecPush (vecPush vecNew (mkEVar "First")) (mkEVar "Second")))))
    (let names (:: vecNew Names))
    (let args (:: vecNew Nodes))
    (say 18 (countRows (expSpliceOneDecl (declaration "(fn (N) 1)") names args env 0) 2))
    (say 19 (&& (== (vecLen names) 0) (== (vecLen args) 0)))
    (say 20
      (if (let (Some nodes) (expSpliceOneCtor (vecGet (nodeBChildren data) 0) names args env 0))
        (&& (== (vecLen nodes) 2) (strEq (nodeAName (vecGet nodes 1)) "Second"))
        false))
    (say 21 (&& (== (vecLen names) 0) (== (vecLen args) 0)))
    (set env.seqbinds (vecPush vecNew (SeqBind :name "N" :forms (vecPush vecNew (mkEInt 3)))))
    (say 22 (noRows (expSpliceOneDecl (declaration "(fn (N) 1)") names args env 0)))
    (say 23 (&& (== (vecLen names) 0) (== (vecLen args) 0)))
    (expTrunc diagnostics 0)
    (set env.seqbinds vecNew)
    (say 24 (expBuildEffectOps vecNew vecNew parameters values env 0 vecNew vecNew 0))
    (say 25
      (!
        (expBuildEffectOps (vecPush vecNew "N") vecNew parameters
          (vecPush (vecPush vecNew (mkEInt 3)) (mkEVar "input")) env 0 vecNew vecNew 0)))
    (expTrunc diagnostics 0)
    (say 26 (noNode (expBuildOneDecl (mkEInt 3) parameters values env 0)))
    (say 27 (&& (== (vecLen diagnostics) 1) (strEq (diagCode (vecGet diagnostics 0)) "AX3021")))
    (expTrunc diagnostics 0)
    (set env.declnodes expMaxDecls)
    (say 28 (noRows (expBuildDecls (vecPush vecNew template) parameters values env 0 vecNew 0)))
    (say 29 (&& (== (expBlown env) 1) (== (vecLen diagnostics) 1)))
    (expTrunc diagnostics 0)
    (set env.blown 0)
    (set env.declnodes 0)
    (say 30
      (evaluatesExpansion
        "(struct Empty) (macro nothing ((nothing S) (syntax/for (f (syntax/fields S)) (:: unused Int) (fn (unused) 9)))) (nothing Empty) (:: main Int) (fn (main) 7)"
        7))
    (say 31
      (evaluatesExpansion
        "(struct Pair (a : Int) (b : Int)) (macro generate ((generate S) (syntax/for (f (syntax/fields S)) (:: (syntax/join get f) (-> Int Int)) (fn ((syntax/join get f) ignored) 4)))) (generate Pair) (:: main Int) (fn (main) (+ (getA 0) (getB 0)))"
        8))
    (say 32
      (noRows
        (expBuildDecls (vecPush vecNew (declaration "(...)")) parameters values env 0 vecNew 0)))
    (say 33 (&& (== (vecLen diagnostics) 1) (strEq (diagCode (vecGet diagnostics 0)) "AX3034")))
    (say 34
      (evaluatesExpansion
        "(macro readFields ((readFields S) (syntax/for (f (syntax/fields S)) (:: (syntax/join get f) (-> Int Int)) (fn ((syntax/join get f) ignored) 4)))) (macro defStruct ((defStruct S) (struct S (a : Int)))) (readFields Later) (defStruct Later) (:: main Int) (fn (main) (getA 0))"
        4))
    0
  })
