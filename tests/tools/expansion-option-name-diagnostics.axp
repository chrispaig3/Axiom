; Name diagnostic byte-compatibility probe for both API versions.
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)
(import Intern)
(import core)
(import lexer)
(import parser)
(import diag)
(import namespace)
(import expand)
(import mir)
(import mireval)

(:: environment (-> Diags Units Nodes MEnv))
(fn (environment diagnostics units declarations)
  (MEnv
    :macros vecNew
    :out diagnostics
    :fresh 0
    :depth 0
    :decls declarations
    :macmod 0
    :walk 0
    :nodes 0
    :blown 0
    :site 0
    :frames vecNew
    :declmod 0
    :units units
    :forstack vecNew
    :bares vecNew
    :fulls vecNew
    :mods vecNew
    :qsite 0
    :gens vecNew
    :callbs 0
    :seqbinds vecNew
    :tplbinds vecNew
    :declnodes 0
    :midx mangleIdxNew
    :scNext 0
    :scChain vecNew
    :scTpl vecNew
    :scSeq 0
    :retired28 0
    :defer 0
    :deferHits 0
    :structNames internNewTyped
    :structBuckets vecNew
    :carrier 0
    :optNames vecNew))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let diagnostics (:: vecNew Diags))
    (let units
      (vecPush vecNew
        (CUnit2 :file "name.ax" :src "name" :name (Some "") :imports vecNew :library false)))
    (let env (environment diagnostics units vecNew))
    (let parameters (vecPush (vecPush vecNew "left") "right"))
    (let bad (vecPush (vecPush vecNew (mkEInt 1)) (mkEInt 2)))
    (expSubstName "left" parameters bad env 0)
    (expSubstName "syntax/join left right" parameters bad env 0)
    (expSubstNames parameters parameters bad env 0)
    (expSubstTyName (mkTTup vecNew) parameters bad env 0)
    (expSubstTy (mkTVar "left") parameters bad env 0)
    (writeStr stdout (renderDiagsUnits diagnostics units))
    0
  })
