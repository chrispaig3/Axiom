(import IO)
(import Fmt)
(import Str)
(import Vec)
(import repl)
(import replhist)
(import Tui.Edit)

(:: browseSay (-> Int Bool ()))
;@axiom:effect(io)
(fn (browseSay index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: browseTextIs (-> (Option String) String Bool))
(fn (browseTextIs result expected)
  (match result
    ((None) false)
    ((Some text) (strEq text expected))))

(:: browseHist (-> Int String Hist))
(fn (browseHist pos draft)
  (Hist
    :entries (vecPush (vecPush vecNew "old\nrow") "new")
    :path None
    :cap 1000
    :pos pos
    :draft draft))

(:: browseReturned (Option String))
(fn (browseReturned)
  (replHistText (browseHist 0 (strDup ""))))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (browseSay 1 (browseTextIs (replHistText (browseHist 0 "")) "old row"))
    (browseSay 2
      (browseTextIs
        (replHistText
          (Hist :entries (vecPush vecNew "") :path None :cap 1000 :pos 0 :draft "draft"))
        ""))
    (browseSay 3 (isNone (replHistText (browseHist (- 0 1) "draft"))))
    (browseSay 4 (browseTextIs (replHistText (browseHist 2 "draft\nline")) "draft line"))
    (let h (browseHist 2 ""))
    (let ed (ledNew vecNew ""))
    (let out vecNew)
    (ledSetStr ed "")
    (browseSay 5 (&& (== (replHistUp h ed "" out) 1) (strEq (ledSnapshot ed) "new")))
    (browseSay 6 (&& (== (replHistDown h ed "" out) 1) (strEq (ledSnapshot ed) "")))
    (set h.pos 0)
    (let before (vecLen out))
    (browseSay 7 (&& (== (replHistUp h ed "" out) 0) (== (vecLen out) before)))
    (set h.pos 2)
    (browseSay 8 (&& (== (replHistDown h ed "" out) 0) (== (vecLen out) before)))
    (set h.pos (- 0 2))
    (ledSetStr ed "keep")
    (browseSay 9
      (&& (== (replHistDown h ed "" out) 0)
        (&& (strEq (ledSnapshot ed) "keep") (&& (== (vecLen out) before) (== h.pos (- 0 1))))))
    (browseSay 10 (&& (== (replHistUp h ed "" out) 0) (strEq (ledSnapshot ed) "keep")))
    (browseSay 11 (browseTextIs (replHistText (browseHist 999 "draft")) "draft"))
    (browseSay 12 (browseTextIs browseReturned "old row"))
    (set h.pos 0)
    (browseSay 13 (&& (== (replHistDown h ed "" out) 1) (strEq (ledSnapshot ed) "new")))
    (browseSay 14 (browseTextIs (replHistText (browseHist 2 "")) ""))
    (let blank (Hist :entries (vecPush vecNew "") :path None :cap 1000 :pos 1 :draft ""))
    (ledSetStr ed "keep")
    (browseSay 15 (&& (== (replHistUp blank ed "" out) 1) (strEq (ledSnapshot ed) "")))
    (browseSay 16 (== (replHistDown blank ed "" out) 1))
  })
