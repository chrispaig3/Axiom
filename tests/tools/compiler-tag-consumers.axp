; Typed tag consumers preserve text, offsets, ordering and owning payloads.
(import codegen)
(import lsp)
(import parser)
(import lexer)
(import jsonrpc)
(import core)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say i good)
  (println
    (concat (fmtInt i)
      (if good
        " true"
        " false"))))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: tags (-> String Axtags))
(fn (tags text)
  (vecPush vecNew (AxtagEnt :off 13 :content text)))

(:: decl (-> String Axtags ASTNode))
(fn (decl name values)
  {
    (let d (nodeBuildDFn name vecNew (mkEInt 7) 0))
    (writeNodeAxtags d values)
    d
  })

(:: retireTags (-> String Int))
(fn (retireTags text)
  {
    (let values (tags text))
    (let d (decl "owner" values))
    17
  })

(:: returnedTags Axtags)
(fn (returnedTags)
  (tags (strDup "isr(irq)")))

(:: returnedDecl ASTNode)
(fn (returnedDecl)
  (decl (strDup "owner") (tags (strDup "effect(io)"))))

(:: contractCompletion (-> String Int Int Bool))
(fn (contractCompletion source off expected)
  (match (parseModuleWith (lex source) (scanAxtags source))
    ((ParseFailed _) false)
    ((ParseSuccess decls _)
      {
        (let out jsonArr)
        (lspComplContractAt out vecNew source decls (contractSigIndex decls) off "x")
        (== (jsonArrLen out) expected)
      }
    )))

(:: checks ())
;@axiom:effect(io)
(fn (checks)
  {
    (let empty (:: vecNew Axtags))
    (say 1 (strEq (isrTagValueIn empty 0) ""))
    (say 2 (strEq (isrTagValueIn (tags "isr") 0) ""))
    (say 3 (strEq (isrTagValueIn (tags "ISR(irq)") 0) ""))
    (say 4 (strEq (isrTagValueIn (tags "isr(irq") 0) ""))
    (say 5 (strEq (isrTagValueIn (tags "isr()") 0) ""))
    (say 6 (strEq (isrTagValueIn (tags "isr( irq )") 0) "irq"))
    (let vectors (vecPush (tags "isr(irq)") (AxtagEnt :off 99 :content "isr(fault)")))
    (say 7 (strEq (isrTagValueIn vectors 0) "irq"))
    (say 8 (strEq (isrTagValueIn vectors 1) "fault"))
    (say 9 (strEq (lspRenderAxtags empty 0) ""))
    (say 10 (strEq (lspRenderAxtags (tags "") 0) ";@axiom:\n"))
    (say 11 (strEq (lspRenderAxtags (tags "odd(malformed") 2) ";@axiom:odd(malformed\n  "))
    (say 12 (strEq (lspFieldEffectsSaid None) ""))
    (let absent (nodeBuildDFn "absent" vecNew (mkEInt 0) 0))
    (say 13 (strEq (lspFieldEffectsSaid (Some absent)) ""))
    (let effects (vecPush (tags "effect(io)") (AxtagEnt :off 25 :content "effect(unsafe)")))
    (let e (decl "effectful" effects))
    (say 14 (strEq (lspFieldEffectsSaid (Some e)) ", declared `effect(io)` and `effect(unsafe)`"))
    (say 15
      (match (nodeAxtagsOpt absent)
        ((None) true)
        ((Some _) false)))
    (let presentEmpty (decl "empty" empty))
    (say 16
      (match (nodeAxtagsOpt presentEmpty)
        ((None) false)
        ((Some values) (== (vecLen values) 0))))
    (say 17 (== (vecLen (nodeAxtagsOf absent)) 0))
    (say 18 (! (lspDeclHasTagKey absent "unhandled")))
    (say 19 (lspDeclHasTagKey (decl "prefix" (tags "unhandledness")) "unhandled"))
    (say 20 (! (lspDeclHasTagKey (decl "case" (tags "Unhandled(abort)")) "unhandled")))
    (say 21 (lspDeclHasTagKey e ""))
    (say 22 (strEq (lspRenderAxtags effects 0) ";@axiom:effect(io)\n;@axiom:effect(unsafe)\n"))
    (let irq (decl "irqFn" (tags "isr(irq)")))
    (let fault (decl "faultFn" (tags "isr(fault)")))
    (let duplicate (decl "irqFn" (tags "isr(fault)")))
    (let declarations (vecPush (vecPush (vecPush vecNew irq) fault) duplicate))
    (let bindings (isrBindings declarations vecNew 0))
    (say 23 (== (vecLen bindings) 4))
    (say 24 (&& (strEq (vecGet bindings 0) "irqFn") (strEq (vecGet bindings 1) "irq")))
    (say 25 (&& (strEq (vecGet bindings 2) "faultFn") (strEq (vecGet bindings 3) "fault")))
    (say 26 (== (vecLen (isrBindings (vecPush vecNew (decl "bare" (tags "isr"))) vecNew 0)) 0))
    (let lint (lspLintContext ""))
    (let local (decl "local" (tags "nolint(lint-unused-let)")))
    (lspLintSuppBuild lint (vecPush vecNew local))
    (say 27 (lspLintSuppressed lint "local" "lint-unused-let"))
    (say 28 (! (lspLintSuppressed lint "other" "lint-unused-let")))
    (say 29 (! (lspLintSuppressed lint "local" "lint-bool-if")))
    (let imported (nodeBuildDImport "IO" vecNew 0 0))
    (writeNodeAxtags imported (tags "nolint(lint-bool-if)"))
    (lspLintSuppBuild lint (vecPush vecNew imported))
    (say 30 (lspLintSuppressed lint "any" "lint-bool-if"))
    (let unknown (lspLintContext ""))
    (lspLintSuppDecl unknown "owner" (tags "nolint(typo)") 0)
    (say 31 (== (vecLen unknown.records) 1))
    (let record (vecGet unknown.records 0))
    (say 32 (&& (== (spanStart record.span) 28) (== (spanEnd record.span) 32)))
    (say 33 (strEq record.code "lint-unknown-nolint"))
    (say 34 (strEq record.owner "owner"))
    (let noLint (lspLintContext ""))
    (lspLintSuppBuild noLint (vecPush (vecPush vecNew absent) presentEmpty))
    (say 35 (&& (== (vecLen noLint.owners) 0) (== (vecLen noLint.records) 0)))
    (let text (strDup "retired"))
    (let before (count text))
    (say 36 (== (retireTags text) 17))
    (say 37 (== (count text) before))
    (let owned (returnedTags))
    (say 38 (vecOwnsRefs owned))
    (say 39 (strEq (isrTagValueIn owned 0) "irq"))
    (say 40 (strEq (lspFieldEffectsSaid (Some (returnedDecl))) ", declared `effect(io)`"))
    (let scanned (scanAxtags ";@axiom:isr(irq)\n(fn (irqFn) 0)\n"))
    (say 41 (== (vecLen scanned) 1))
    (let scannedTag (vecGet scanned 0))
    (say 42 (&& (== scannedTag.off 0) (strEq scannedTag.content "isr(irq)")))
    (say 43 (strEq (lspRenderAxtags scanned 0) ";@axiom:isr(irq)\n"))
    (say 44 (strEq (lspFieldEffectsSaid (Some presentEmpty)) ""))
    (say 45 (! (lspDeclHasTagKey presentEmpty "")))
    (say 46
      (strEq (isrTagValueIn (vecPush (tags "isr()") (AxtagEnt :off 2 :content "isr(irq)")) 0) ""))
    (say 47
      (==
        (vecLen
          (isrBindings
            (vecPush vecNew
              (decl "empty" (vecPush (tags "isr()") (AxtagEnt :off 2 :content "isr(irq)"))))
            vecNew 0))
        0))
    (say 48 (strEq (lspRenderAxtags (tags "isr( irq )") 0) ";@axiom:isr( irq )\n"))
    (say 49
      (strEq record.msg
        "no lint or warning named `typo`; `nolint` takes lint-dead-branch, lint-bool-if, lint-unused-let, lint-axql, hints, warnings, all, or a warning code such as AX3037"))
    (say 50 (strEq (lspRenderDecl irq 0) ";@axiom:isr(irq)\n(fn (irqFn)\n  7)"))
    (let contractSource ";@axiom:pre(x > 0)\n(:: f (-> Int Int))\n(fn (f x) x)\n")
    (say 51 (contractCompletion contractSource 10 1))
    (say 52 (contractCompletion contractSource 40 0))
    (say 53 (contractCompletion "(:: f (-> Int Int))\n(fn (f x) x)\n" 1 0))
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  (checks))
