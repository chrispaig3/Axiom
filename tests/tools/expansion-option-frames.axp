; Frame joins distinguish source modules and retain optional identities.
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import core)
(import parser)
(import diag)
(import expand)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: unit (-> String CUnit2))
(fn (unit name)
  (CUnit2 :file name :src "sample" :name (Some name) :imports vecNew :library false))

(:: diagnostic (-> Int Int Diag))
(fn (diagnostic span sourceUnit)
  (diagSetUnit (mkDiagBase SEV_ERROR "AX3001" "test-frame" span "test" (Some "test")) sourceUnit))

(:: frame (-> (Option String) Int String (Option String) ExpFrame))
(fn (frame site span name definition)
  (ExpFrame :site site :span span :name name :defSpan span :defMod definition))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let units (vecPush (vecPush (vecPush vecNew (unit "")) (unit "A")) (unit "B")))
    (let invocation (mkSpan 1 2))
    (let table (:: vecNew Frames))
    (vecPush table (frame (Some "A") invocation "fromA" (Some "B")))
    (vecPush table (frame (Some "B") invocation "fromB" (Some "A")))
    (vecPush table (frame None invocation "entryAbsent" None))
    (vecPush table (frame (Some "") invocation "entryEmpty" (Some "")))
    (let fromA (diagnostic invocation 1))
    (diagAddFixHelp fromA "keep help" invocation "replacement")
    (expAttachFrames (vecPush vecNew fromA) table units)
    (say 1 (== (diagTraceCount fromA) 1))
    (say 2 (strEq (diagTraceName fromA 0) "fromA"))
    (say 3 (== (diagTraceUnit fromA 0) 2))
    (say 4 (== (diagHelpFixSpan fromA 0) 0))
    (say 5 (strEq (diagHelpMsg fromA 0) "keep help"))
    (let fromB (diagnostic invocation 2))
    (expAttachFrames (vecPush vecNew fromB) table units)
    (say 6 (== (diagTraceCount fromB) 1))
    (say 7 (strEq (diagTraceName fromB 0) "fromB"))
    (say 8 (== (diagTraceUnit fromB 0) 1))
    (let entry (diagnostic invocation 0))
    (expAttachFrames (vecPush vecNew entry) table units)
    (say 9 (== (diagTraceCount entry) 2))
    (say 10 (strEq (diagTraceName entry 0) "entryAbsent"))
    (say 11 (strEq (diagTraceName entry 1) "entryEmpty"))
    (say 12 (&& (== (diagTraceUnit entry 0) 0) (== (diagTraceUnit entry 1) 0)))
    (let elsewhere (diagnostic (mkSpan 1 2) 1))
    (diagAddFixHelp elsewhere "keep fix" invocation "replacement")
    (expAttachFrames (vecPush vecNew elsewhere) table units)
    (say 13 (== (diagTraceCount elsewhere) 0))
    (say 14 (== (diagHelpFixSpan elsewhere 0) invocation))
    (let missingSpan (diagnostic 0 1))
    (expAttachFrames (vecPush vecNew missingSpan) table units)
    (say 15 (== (diagTraceCount missingSpan) 0))
    (let node (mkEInt 0))
    (say 16
      (if (let (Some _) (nodeModuleOpt node))
        false
        true))
    (writeNodeText node 8 "")
    (say 17
      (if (let (Some name) (nodeModuleOpt node))
        (== (strLen name) 0)
        false))
    (say 18 (== (expModEq None (Some "")) 1))
    (say 19 (== (expModEq (Some "A") None) 0))
    (say 20
      (match (expUnitOfMod units (Some "B"))
        ((None) false)
        ((Some index) (== index 2))))
    (let many (:: vecNew Frames))
    (for i in 0..129
      (vecPush many (frame None invocation "nested" None)))
    (let capped (diagnostic invocation 0))
    (expAttachFrames (vecPush vecNew capped) many units)
    (say 21 (== (diagTraceCount capped) 128))
    (say 22 (== (diagNoteCount capped) 1))
    (say 23
      (strEq (diagNote capped 0)
        "expansion reached this through 129 frames; the first 128 are shown"))
    0
  })
