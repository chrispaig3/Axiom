; Symbol indexes preserve first matches and zero across map mutation.
(import core)
(import parser)
(import symbols)
(import Vec)
(import Str)
(import Fmt)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: indexIs (-> (Option Int) (Option Int) Bool))
(fn (indexIs actual expected)
  (match actual
    ((None) (isNone expected))
    ((Some index)
      (match expected
        ((None) false)
        ((Some want) (== index want)))
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (isNone (saIdx vecNew "missing")))
    (let names (vecPush (vecPush (vecPush vecNew "first") "other") "first"))
    (let values (vecPush (vecPush (vecPush vecNew 10) 20) 30))
    (say 2 (indexIs (saIdx names "first") (Some 0)))
    (say 3 (indexIs (saIdx names "other") (Some 1)))
    (say 4 (isNone (saIdx names "missing")))
    (let ownNames
      (vecPush (vecPush (vecPush vecNew (:: vecNew Names)) (vecPush vecNew "named"))
        (vecPush vecNew "late")))
    (say 5
      (match (saGetNames names ownNames "first")
        ((None) false)
        ((Some found) (== (vecLen found) 0))))
    (say 6
      (match (saGetNames names ownNames "other")
        ((None) false)
        ((Some found) (strEq (vecGet found 0) "named"))))
    (say 7 (isNone (saGetNames names ownNames "missing")))
    (let poison mkTErr)
    (let nodes (vecPush (vecPush (vecPush vecNew nilNode) poison) (mkEInt 42)))
    (say 8 (isNone (saGetNode names nodes "first")))
    (say 9
      (match (saGetNode names nodes "other")
        ((None) false)
        ((Some found) (nodeSame found poison))))
    (say 10 (isNone (saGetNode names nodes "missing")))
    (say 11 (== (vecLen names) 3))
    (symbolIndexPut names values "first" 99)
    (say 12 (== (vecLen names) 3))
    (say 13 (&& (== (vecGet values 0) 99) (== (vecGet values 2) 30)))
    (symbolIndexPut names values "new" 40)
    (say 14 (&& (== (vecLen names) 4) (== (vecLen values) 4)))
    (say 15 (indexIs (saIdx names "new") (Some 3)))
    (saPutIfAbsent names values "first" 0)
    (say 16 (== (vecGet values 0) 99))
    (saPutIfAbsent names values "absent" 50)
    (say 17 (&& (== (vecLen names) 5) (== (vecGet values 4) 50)))
    (symbolIndexPutSoft names values "other" 0)
    (say 18 (== (vecGet values 1) 20))
    (symbolIndexPutSoft names values "soft" 60)
    (say 19 (&& (== (vecLen names) 6) (== (vecGet values 5) 60)))
    (let pairedNames (vecPush vecNew "zero"))
    (let spans (vecPush vecNew 10))
    (let units (vecPush vecNew 20))
    (saPut2 pairedNames spans units "zero" 11 21)
    (say 20 (&& (== (vecLen pairedNames) 1) (&& (== (vecGet spans 0) 11) (== (vecGet units 0) 21))))
    (saPut2 pairedNames spans units "next" 12 22)
    (say 21 (&& (== (vecLen pairedNames) 2) (&& (== (vecLen spans) 2) (== (vecLen units) 2))))
    (symbolIndexPutSoft2 pairedNames spans units "zero" 0 0)
    (say 22 (&& (== (vecGet spans 0) 11) (== (vecGet units 0) 21)))
    (symbolIndexPutSoft2 pairedNames spans units "last" 13 23)
    (say 23 (&& (== (vecLen pairedNames) 3) (&& (== (vecGet spans 2) 13) (== (vecGet units 2) 23))))
    (let maps smNew)
    (say 24 (isNone (smNidFor maps "missing")))
    (vecPush maps.nidN "first")
    (vecPush maps.nidV "F")
    (say 25
      (match (smNidFor maps "first")
        ((None) false)
        ((Some nid) (strEq nid "0e8b5e32c2add66d"))))
    (say 26 (isNone (smLocReal maps 0 0 0 "missing" vecNew)))
    0
  })
