; Optional module identities keep the entry row distinct from a missing row.
(import core)
(import parser)
(import namespace)
(import symbols)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs result expected)
  (match result
    ((None) false)
    ((Some index) (== index expected))))

(:: unit (-> String (Option String) CUnit2))
(fn (unit file name)
  (CUnit2 :file file :src "sample\n" :name name :imports vecNew :library false))

(:: declaration (-> String (Option String) Int ASTNode))
(fn (declaration name module span)
  {
    (let node (nodeBuildDFn name vecNew (mkEInt 42) span))
    (match module
      ((None) (writeNodeWord node 8 0))
      ((Some name) (writeNodeText node 8 name)))
    node
  })

(:: countOf (-> a Int))
;@axiom:effect(unsafe)
(fn (countOf value)
  (__load64 (as value Int) -2))

(:: lookupOnly (-> Units String Int))
(fn (lookupOnly units name)
  (match (saUnitOf units (Some name))
    ((None) 42)
    ((Some index) index)))

(:: mapValue (-> MangleIdx Names Names String String Bool))
(fn (mapValue idx bares fulls key expected)
  (match (mangleIdxIndexOf idx bares key)
    ((None) false)
    ((Some index) (strEq (vecGet fulls index) expected))))

(:: location (-> SymMaps String Units String))
(fn (location maps name units)
  {
    (let value (smLocReal maps 0 1 2 name units))
    (smLocWire value)
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let rows
      (vecPush (vecPush (vecPush vecNew (unit "entry.ax" None)) (unit "empty.ax" (Some "")))
        (unit "module.ax" (Some "Module"))))
    (say 1 (indexIs (saUnitOf rows None) 0))
    (say 2 (isNone (saUnitOf vecNew None)))
    (say 3 (isNone (saUnitOf vecNew (Some "Module"))))
    (say 4 (indexIs (saUnitOf rows (Some "")) 1))
    (say 5 (indexIs (saUnitOf rows (Some "Module")) 2))
    (say 6 (isNone (saUnitOf rows (Some "Missing"))))
    (say 7 (isNone (saUnitOf rows (Some "module"))))
    (let duplicate (vecPush rows (unit "later.ax" (Some "Module"))))
    (say 8 (indexIs (saUnitOf duplicate (Some "Module")) 2))
    (let namedZero (vecPush vecNew (unit "entry.ax" (Some "EntryName"))))
    (say 9 (indexIs (saUnitOf namedZero None) 0))
    (say 10 (isNone (saUnitOf namedZero (Some "EntryName"))))
    (let owned (strDup "Module"))
    (let beforeName (countOf owned))
    (let beforeRows (countOf rows))
    (lookupOnly rows owned)
    (say 11 (== (countOf owned) beforeName))
    (say 12 (== (countOf rows) beforeRows))
    (let plain (declaration "plain" None 0))
    (let idx mangleIdxNew)
    (let bares (:: vecNew Names))
    (let fulls (:: vecNew Names))
    (mangleDecl plain None idx bares fulls 1)
    (say 13 (strEq (nodeAName plain) "plain"))
    (say 14 (== (vecLen bares) 0))
    (let empty (declaration "empty" (Some "") 0))
    (mangleDecl empty (nodeModuleOpt empty) idx bares fulls 1)
    (say 15 (strEq (nodeAName empty) "$empty"))
    (say 16 (mapValue idx bares fulls "empty" "$empty"))
    (let public (declaration "work" (Some "Module") 0))
    (mangleDecl public (nodeModuleOpt public) idx bares fulls 1)
    (say 17 (strEq (nodeAName public) "Module$work"))
    (say 18 (mapValue idx bares fulls "work" "Module$work"))
    (let private (declaration "private" (Some "Module") 0))
    (mangleDecl private (nodeModuleOpt private) idx bares fulls 0)
    (say 19 (! (mangleIdxHas idx bares "private")))
    (say 20 (mapValue idx bares fulls "Module$private" "Module$private"))
    (let signature (nodeBuildDSig "sig" vecNew 0 0))
    (mangleDecl signature (Some "Module") idx bares fulls 1)
    (say 21 (strEq (nodeAName signature) "Module$sig"))
    (let item (nodeBuildFieldExtern "api" (mkTArr mkIntTy mkIntTy) "raw_api" 0))
    (writeNodeWord item 5 1)
    (let externBlock (nodeBuildDExtern "library" vecNew (vecPush vecNew item) 0))
    (mangleDecl externBlock (Some "Module") idx bares fulls 1)
    (say 22 (strEq (nodeAName item) "api"))
    (say 23 (mapValue idx bares fulls "Module$api" "raw_api"))
    (say 24 (mapValue idx bares fulls "api" "raw_api"))
    (let moduleBefore (countOf owned))
    (mangleDecl (declaration "owned" None 0) (Some owned) mangleIdxNew vecNew vecNew 1)
    (say 25 (== (countOf owned) moduleBefore))
    (let span (mkSpan 0 1))
    (let declarations
      (vecPush
        (vecPush
          (vecPush (vecPush vecNew (declaration "entry" None span))
            (declaration "empty" (Some "") span))
          (declaration "module" (Some "Module") span))
        (declaration "missing" (Some "Missing") span)))
    (let maps (smBuild declarations rows))
    (say 26 (== (vecGet maps.fnU 0) 0))
    (say 27 (== (vecGet maps.fnU 1) 1))
    (say 28 (== (vecGet maps.fnU 2) 2))
    (say 29 (== (vecGet maps.fnU 3) 0))
    (say 30 (strEq (location maps "entry" rows) "entry.ax:1:1-2"))
    (say 31 (strEq (location maps "empty" rows) "empty.ax:1:1-2"))
    (say 32 (strEq (location maps "module" rows) "module.ax:1:1-2"))
    (say 33 (strEq (location maps "missing" rows) "entry.ax:1:1-2"))
    (let noUnits (smBuild declarations vecNew))
    (say 34 (strEq (location noUnits "module" vecNew) "-"))
    (say 35 (strEq (location maps "module" (vecPush vecNew (unit "entry.ax" None))) "-"))
    (println "-- symbols --")
    (writeStr stdout (symLine "F" "entry" (location maps "entry" rows) "Int" "" vecNew))
    (writeStr stdout (symLine "F" "empty" (location maps "empty" rows) "Int" "" vecNew))
    (writeStr stdout (symLine "F" "module" (location maps "module" rows) "Int" "" vecNew))
    (writeStr stdout (symLine "F" "missing" (location maps "missing" rows) "Int" "" vecNew))
    (writeStr stdout (symLine "F" "module" (location noUnits "module" vecNew) "Int" "" vecNew))
    (println "-- names --")
    (println (nodeAName plain))
    (println (nodeAName empty))
    (println (nodeAName public))
    (println (nodeAName private))
    (println (nodeAName signature))
    (println (nodeAName item))
    0
  })
