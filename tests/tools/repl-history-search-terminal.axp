(import IO)
(import Str)
(import Vec)
(import repl)
(import replhist)
(import replcomp)
(import Tui.Edit)
(import Tui.Term)
(import Sys)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let empty (&& (> sysArgc 1) (strEq (sysArg 1) "empty")))
    (let h
      (Hist
        :entries
          (if empty
            vecNew
            (vecPush (vecPush (vecPush vecNew "hit old") "unrelated") "hit new"))
        :path None
        :cap 1000
        :pos
          (if empty
            0
            3)
        :draft ""))
    (match (replTermLoop (mkKeyIn stdin 1) (ledNew vecNew "") "" "" h (replComplEnvNew "" ""))
      ((None) (println "\nRESULT None"))
      ((Some line) (println (concat "\nRESULT Some:" line))))
  })
