; Builder diagnostic byte-compatibility probe for both API versions.
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)
(import Intern)
(import core)
(import lexer)
(import parser)
(import diag)
(import namespace)
(import expand)
(import mir)
(import mireval)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: environment (-> Diags Units Nodes MEnv))
(fn (environment diagnostics units declarations)
  (MEnv
    :macros vecNew
    :out diagnostics
    :fresh 0
    :depth 0
    :decls declarations
    :macmod 0
    :walk 0
    :nodes 0
    :blown 0
    :site 0
    :frames vecNew
    :declmod 0
    :units units
    :forstack vecNew
    :bares vecNew
    :fulls vecNew
    :mods vecNew
    :qsite 0
    :gens vecNew
    :callbs 0
    :seqbinds vecNew
    :tplbinds vecNew
    :declnodes 0
    :midx mangleIdxNew
    :scNext 0
    :scChain vecNew
    :scTpl vecNew
    :scSeq 0
    :retired28 0
    :defer 0
    :deferHits 0
    :structNames internNewTyped
    :structBuckets vecNew
    :carrier 0
    :optNames vecNew))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let diagnostics (:: vecNew Diags))
    (let units
      (vecPush vecNew
        (CUnit2 :file "builder.ax" :src "builder" :name (Some "") :imports vecNew :library false)))
    (let env (environment diagnostics units vecNew))
    (let parameters (vecPush vecNew "N"))
    (let bad (vecPush vecNew (mkEInt 3)))
    (let parsed (parseModule (lex "(fn (N) 1)")))
    (let template (vecGet (expectParsed parsed) 0))
    (expBuildOneDecl template parameters bad env 0)
    (expBuildOneDecl (mkEInt 3) vecNew vecNew env 0)
    (expSpliceOneDecl template vecNew vecNew env 0)
    (expSpliceOneCtor (nodeBuildCtor "N" 0 vecNew 0) vecNew vecNew env 0)
    (set env.declnodes expMaxDecls)
    (expBuildDecls (vecPush vecNew template) parameters (vecPush vecNew (mkEVar "Owned")) env 0
      vecNew 0)
    (writeStr stdout (renderDiagsUnits diagnostics units))
    0
  })
