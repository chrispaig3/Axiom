; Automatic close: scopes, returned owners, aliases, closures, regions,
; combinators and an early close. Each line is `true` when the number of
; descriptors this process holds - counted in /dev/fd - is what the case
; says it should be after its owners are gone. A standard stream never
; closes: `fileClose stdout` retires that value and leaves fd 1 open.
(import IO)
(import Sys)
(import Err)
(import Str)
(import Vec)

(:: openCount Int)
;@axiom:effect(io)
(fn (openCount)
  (vecLen (listDir "/dev/fd")))

(:: requireFile (-> String Int File))
;@axiom:effect(io)
(fn (requireFile path flags)
  (match (openPath path flags)
    ((Ok f) f)
    ((Err e) { (die (errorText e) 1) (requireFile path flags) })))

; Whether the descriptor count after `k` runs is the count before it.
(:: closes (-> (-> Int Int) Bool))
;@axiom:effect(io)
(fn (closes k)
  (let ((before openCount))
    {
      (k 0)
      (== openCount before)
    }))

(:: scope (-> Int Int))
;@axiom:effect(io)
(fn (scope x)
  (let ((f (requireFile "/dev/null" oRdonly)) (alias f))
    0))

(:: matched (-> Int Int))
;@axiom:effect(io)
(fn (matched x)
  (match (openPath "/dev/null" oRdonly)
    ((Ok f) 0)
    ((Err e) (die (errorText e) 1))))

(:: inRegion (-> Int Int))
;@axiom:effect(io)
(fn (inRegion x)
  (region r (let ((f (requireFile "/dev/null" oRdonly))) 0)))

(:: earlyClose (-> Int Int))
;@axiom:effect(io)
(fn (earlyClose x)
  (let ((f (requireFile "/dev/null" oRdonly)))
    (let ((_ (fileClose f)) (_ (fileClose f))) 0)))

(:: capturedFile (-> Int (-> Int Int)))
;@axiom:effect(io)
(fn (capturedFile x)
  (let ((f (requireFile "/dev/null" oRdonly)))
    (lambda (_) (match (readAll f) ((Ok s) (strLen s)) ((Err e) -1)))))

(:: captured (-> Int Int))
;@axiom:effect(io)
(fn (captured x)
  (let ((readIt (capturedFile 0))) (readIt 0)))

(:: combined (-> Int Int))
;@axiom:effect(io)
(fn (combined x)
  (match (andThen (Ok "/dev/null") (lambda (path) (openPath path oRdonly)))
    ((Ok f) 0)
    ((Err e) (die (errorText e) 1))))

(:: mapped (-> Int Int))
;@axiom:effect(io)
(fn (mapped x)
  (let ((opened (openPath "/dev/null" oRdonly)))
    (match (mapOk opened (lambda (f) f))
      ((Ok f) 0)
      ((Err e) (die (errorText e) 1)))))

; A returned owner keeps its descriptor until the caller drops it.
(:: held Bool)
;@axiom:effect(io)
(fn (held)
  (let ((before openCount))
    (let ((f (requireFile "/dev/null" oRdonly)))
      (let ((n openCount))
        (&& (== n (+ before 1)) (! (isTerminal f)))))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (closes mapped))
    (println (closes captured))
    (println (closes combined))
    (println (closes scope))
    (println (closes matched))
    (println (closes inRegion))
    (println (closes earlyClose))
    (println held)
    ; Closing a standard stream retires that value only: the next line
    ; still reaches fd 1.
    (let ((out stdout))
      (println (isOk (fileClose out))))
    (println (closes scope))
    0
  })
