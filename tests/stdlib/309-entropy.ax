; Typed entropy crosses the kernel's chunk boundary and owns its output.
; Never print random bytes: check lengths, filled chunks and distinct draws.
(import IO)
(import Crypto.Random)
(import Err)
(import Str)

(:: say (-> Bool String ()))
;@axiom:effect(io)
(fn (say good label)
  (if good
    (println (concat "ok   " label))
    (println (concat "FAIL " label))))

(:: nonZero (-> String Int Int Bool))
(fn (nonZero bytes start end)
  {
    (let mut found false)
    (for i in start..end
      (if (!= (strByte bytes i) 0)
        (set found true)))
    found
  })

(:: draw (-> Int String))
;@axiom:effect(io)
;@axiom:effect(entropy)
;@axiom:restrict(no-unsafe)
(fn (draw n)
  (match (secureRandomBytes n)
    ((Ok bytes) bytes)
    ((Err _) "")))

(:: main ())
;@axiom:effect(io)
;@axiom:effect(entropy)
;@axiom:restrict(no-unsafe)
(fn (main)
  {
    (let emptyOk
      (match (secureRandomBytes 0)
        ((Ok bytes) (== (strLen bytes) 0))
        ((Err _) false)))
    (say emptyOk "a zero-length request succeeds")
    (say emptyOk "a zero-length request wrote nothing")
    (let short (draw 32))
    (say (== (strLen short) 32) "a short request succeeds")
    (say (nonZero short 0 (strLen short)) "a short request filled its buffer")
    (let large (draw 1000))
    (say (== (strLen large) 1000) "a request spanning four chunks succeeds")
    (say (nonZero large 0 256) "the first chunk is filled")
    (say (nonZero large 256 1000) "the region past the first chunk is filled too")
    (say (nonZero large 768 1000) "the last chunk is filled")
    (let first (draw 64))
    (let second (draw 64))
    (say (! (strEq first second)) "two draws differ")
    (say
      (match (secureRandomBytes -1)
        ((Ok _) false)
        ((Err _) true))
      "a negative length is refused")
  })
