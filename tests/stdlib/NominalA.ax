(import Str)

(pub data Thing
  (NumberThing Int))

(pub type PublicThing Thing)

(pub data Packet
  (PacketValue { value : Int, label : String }))

(pub struct Config
  (item : Thing)
  (pad : Int))

(pub macro (makeAConfig value) (Config :item (NumberThing value) :pad 99))

(pub data Box a
  (BoxValue { item : a, marker : Int }))

(pub subtype Level is Int range 0..100)

(pub :: aMake (-> Int PublicThing))
(pub fn (aMake value)
  (NumberThing value))

(pub :: aRead (-> Thing Int))
(pub fn (aRead thing)
  (match thing
    ((NumberThing value) value)))

(pub :: aPacket (-> Int String Packet))
(pub fn (aPacket n text)
  (PacketValue n text))

(pub :: aPacketRead (-> Packet Int))
(pub fn (aPacketRead packet)
  packet.value)

(pub :: aConfig (-> Int Config))
(pub fn (aConfig value)
  (Config :item (NumberThing value) :pad 99))

(pub :: aConfigRead (-> Config Int))
(pub fn (aConfigRead config)
  (aRead config.item))

(pub :: aBox (-> a (Box a)))
(pub fn (aBox value)
  (BoxValue value 99))

(pub :: aUnbox (-> (Box a) a))
(pub fn (aUnbox box)
  box.item)

(pub :: aPatternBox (-> (Box a) a))
(pub fn (aPatternBox box)
  (match box
    ((BoxValue :item value) value)))

(pub :: aLevel (-> Int Level))
(pub fn (aLevel n)
  (as n Level))

(pub :: aAcceptLevel (-> Level Int))
(pub fn (aAcceptLevel n)
  n)

(pub effect Observe
  (observe :: (-> Thing Int)))

(pub :: aObserve (-> Thing Int))
(pub fn (aObserve value)
  (handle
    (observe value)
    (Observe)
    (lambda (thing) (aRead thing))))

(pub data Token
  (DataToken Int))
