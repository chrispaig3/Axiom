; `Mem.addrOf` answers where a value lives as a sealed `Addr`, so
; identity is asked without erasing the value into an `Int`.
;
;   same      a value and a binding of it share an address
;   twin      an equal value built separately does not
;   vec       an element read back out of a `Vec` is the value pushed
;   string    the same for a `String`
;   word      an immediate is its own word, so equal ones agree
;   hash      equal addresses hash equally
;   spread    256 live boxes reach at least 128 of 256 buckets by their
;             hash's low byte; their aligned addresses alone reach 16
;   share     10,000 `addrOf` calls, on fresh temporaries and on a
;             `let` binding, hold no bytes: the address takes no share,
;             where `(cast Int v)` keeps 48 bytes a call
(import IO)
(import Fmt)
(import Mem)
(import Vec)

(data Box
  (Bx String Int))

(:: yes (-> Bool String))
(fn (yes b)
  (if b
    "yes"
    "no"))

(:: buckets (-> (Vec Box) Int))
(fn (buckets boxes)
  (let (
    (seen vecNew)
    (mut i 0)
    (mut hit 0)
  )
    {
      (while (< i 256)
        {
          (vecPush seen 0)
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (vecLen boxes))
        (let ((k (& (addrHash (addrOf (vecGet boxes i))) 255)))
          {
            (if (== (vecGet seen k) 0)
              {
                (vecSet seen k 1)
                (set hit (+ hit 1))
              }
              0)
            (set i (+ i 1))
          }))
      hit
    }))

(:: held Int)
(fn (held)
  (let ((s (memStats)))
    s.heldBytes))

;@axiom:effect(io)
(fn (main)
  (let (
    (a (Bx "one" 1))
    (b (Bx "one" 1))
    (c a)
    (v (vecPush vecNewRef a))
    (s "text")
    (boxes vecNewRef)
    (mut i 0)
  )
    {
      (println (concat "same " (yes (addrEq (addrOf a) (addrOf c)))))
      (println (concat "twin " (yes (addrEq (addrOf a) (addrOf b)))))
      (println (concat "vec " (yes (addrEq (addrOf (vecGet v 0)) (addrOf a)))))
      (println (concat "string " (yes (addrEq (addrOf s) (addrOf s)))))
      (println (concat "word " (yes (addrEq (addrOf 7) (addrOf 7)))))
      (println (concat "hash " (yes (== (addrHash (addrOf a)) (addrHash (addrOf c))))))
      (while (< i 256)
        {
          (vecPush boxes (Bx "k" i))
          (set i (+ i 1))
        })
      (println (concat "spread " (yes (>= (buckets boxes) 128))))
      (set i 0)
      (let ((h0 (held)))
        {
          (while (< i 10000)
            {
              (addrOf (Bx "t" i))
              (let ((b (Bx "u" i)))
                (addrOf b))
              (set i (+ i 1))
            })
          (println (concat "share " (yes (< (- (held) h0) 4096))))
        })
      0
    }))
