; `in` follows a `for` loop's binder in every shape, and `by` its
; range. Both are words only there: `in` below is also an ordinary
; variable, read as the end of a range, and the loop over it runs
; three times.
(import IO)
(import Vec)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (v (vecNew))
    (in 3)
  )
    {
      (vecPush v 10)
      (vecPush v 20)
      (for x in v
        (println (fmtInt x)))
      (for (x k) in v
        (println (strConcat (fmtInt k) (strConcat ": " (fmtInt x)))))
      (for i in 0..in
        (println (fmtInt i)))
      (for i in 9..0 by -4
        (println (fmtInt i)))
      (for x in v
        (println (fmtInt x)))
      0
    }))
