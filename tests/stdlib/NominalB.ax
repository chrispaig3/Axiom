(import Str)

(pub data Thing
  (TextThing String))

(pub type PublicThing Thing)

(pub data Packet
  (PacketValue { label : String, value : Int }))

(pub struct Config
  (pad : Int)
  (item : Thing))

(pub data Box a
  (BoxValue { marker : Int, item : a }))

(pub subtype Level is Int range 0..10)

(pub :: bMake (-> String PublicThing))
(pub fn (bMake value)
  (TextThing value))

(pub :: bRead (-> Thing Int))
(pub fn (bRead thing)
  (match thing
    ((TextThing value) (strLen value))))

(pub :: bPacket (-> Int String Packet))
(pub fn (bPacket n text)
  (PacketValue text n))

(pub :: bPacketRead (-> Packet Int))
(pub fn (bPacketRead packet)
  packet.value)

(pub :: bConfig (-> String Config))
(pub fn (bConfig value)
  (Config :pad 99 :item (TextThing value)))

(pub :: bConfigRead (-> Config Int))
(pub fn (bConfigRead config)
  (bRead config.item))

(pub :: bBox (-> a (Box a)))
(pub fn (bBox value)
  (BoxValue 99 value))

(pub :: bUnbox (-> (Box a) a))
(pub fn (bUnbox box)
  box.item)

(pub :: bPatternBox (-> (Box a) a))
(pub fn (bPatternBox box)
  (match box
    ((BoxValue :item value) value)))

(pub :: bLevel (-> Int Level))
(pub fn (bLevel n)
  (as n Level))

(pub :: bAcceptLevel (-> Level Int))
(pub fn (bAcceptLevel n)
  n)

(pub struct Token word shared
  (slot : Int))

(pub :: bToken (-> Int Token))
(pub fn (bToken n)
  (Token :slot n))

(pub :: bTokenInt (-> Token Int))
(pub fn (bTokenInt token)
  token.slot)
