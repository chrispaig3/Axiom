; `region`, stage S2 of docs/memory-model-v2-design.md §4: a CHECKED
; SCOPE with no types yet.
;
; `(region r body)` reads the allocator's waterline when `body` starts
; and rolls it back when `body` ends, so everything `body` allocated
; is reclaimed in one pointer move, and the form answers `body`'s
; value. That is MM-RGN-1 over the runtime MM-ALLOC-15/16 already
; specify - `__axiom_arena_mark`/`__axiom_arena_reset` with the mark
; cell on the STACK instead of the heap (`self_host/codegen.ax`,
; `emitRegion`), which is what makes a region per loop iteration
; leak nothing.
;
; What each term establishes:
;
;   1. The value passes through: `(region r (+ 1 2))` is 3.
;   2. THE WATERLINE COMES BACK. A mark is taken just before a region
;      that allocates 128 KiB, another just after; the second is at
;      most one mark cell above the first. Without the reset the gap
;      is the 128 KiB.
;   3. The same across 2,000 iterations of a region allocating 64 KiB
;      each: the waterline after the loop is where it was before it.
;      This is MM-ALLOC-22's shape - the per-request reset - written
;      as a keyword.
;   4. Nesting: `(region a (region b (+ 1 (region c 2))))` is 3, and
;      each inner reset lands inside the outer's extent (MM-RGN-2), so
;      MM-ALLOC-16a's status-75 trap has nothing to say.
;   5. A SCALAR store to an outer binding is allowed: a region body
;      that bumps an outer counter, which is what a region inside a
;      loop needs. (A reference store is AX3059 -
;      tests/diagnostics/631-region-escape.ax.)
;   6. A `Bool` and a `Char` leave a region by value, and so does 0.
;   7. A region whose body builds a String, reads it, and answers an
;      Int: the String dies with the region, the Int does not.
;   8. A REGION INSIDE A LIVE `handle`'s EXTENT. MM-ALLOC-16b traps
;      (status 76) on a reset past a mark taken BEFORE a `handle`
;      whose extent is still live, because the reset would reclaim the
;      evidence record. A region's mark is taken INSIDE the extent, so
;      the record sits below the waterline and the operation still
;      dispatches after the reset. This is the legal shape
;      tests/stdlib/167-arena-live-handle.ax's first block pins, met
;      through the keyword.
;   9. A region in a function called recursively, 10,000 deep: the
;      cell is one hoisted `alloca` per region form per frame.
;  10. `region` is an ordinary identifier off the head of a form - the
;      Keywords rule of docs/reference.md - so it is a parameter name
;      here.
(import IO)

(import Mem)

(import Str)

(effect Console
  (log :: (-> String Int)))

; Term 2's and 3's measure: 1 when `after`'s waterline is at most one
; mark cell (48 bytes: 24 rounded to 32, plus the 16-byte header)
; above `before`'s. A region that reclaimed nothing would answer 0 by
; tens of KiB.
(:: reclaimed (-> Int Int Int))

(fn (reclaimed before after)
  (if (<= (- (memGetWord after 0) (memGetWord before 0)) 48)
    1
    0
  )
)

(:: burn (-> Int Int))

(fn (burn n)
  (if (<= n 0)
    0
    {
      (region r (memSet (memAlloc 65536) 7 65536))
      (burn (- n 1))
    }
  )
)

; Term 9: a region per frame, `n` frames deep, answering the depth.
(:: deep (-> Int Int))

(fn (deep n)
  (if (<= n 0)
    0
    (region r (+ 1 (deep (- n 1))))
  )
)

; Term 10: `region` in parameter position.
(:: twice (-> Int Int))

(fn (twice region) (+ region region))

(:: main Int)

;@axiom:effect(io)
(fn (main)
  {
    ; --- 1. the value passes through ---
    (println (region r (+ 1 2)))
    ; --- 2. the waterline comes back ---
    (let ((m1 __axiom_arena_mark))
      (let ((v (region r
        {
          (memSet (memAlloc 65536) 1 65536)
          (memSet (memAlloc 65536) 2 65536)
          7
        })))
        (let ((m2 __axiom_arena_mark))
          {
            (println v)
            (println (reclaimed m1 m2))
          }
        )
      )
    )
    ; --- 3. two thousand regions, one waterline ---
    (let ((m3 __axiom_arena_mark))
      {
        (burn 2000)
        (println (reclaimed m3 __axiom_arena_mark))
      }
    )
    ; --- 4. nesting ---
    (println (region a (region b (+ 1 (region c 2)))))
    ; --- 5. a scalar store to an outer binding ---
    (let ((mut n 0))
      {
        (region r
          {
            (memAlloc 64)
            (set n (+ n 5))
          })
        (region r (set n (* n 2)))
        (println n)
      }
    )
    ; --- 6. Bool, Char and 0 leave by value ---
    (println (if (region r true) 1 0))
    (println (region r 'x'))
    (println (region r 0))
    ; --- 7. a String dies with its region; its length does not ---
    (println (region r (let ((s (strConcat "abc" "de"))) (strLen s))))
    ; --- 8. a region inside a live handle's extent ---
    (handle {
      (region r
        {
          (memAlloc 4096)
          (log "inside the region")
        })
      (log "after the region")
      0
    } (Console IO Alloc Mut) (lambda (s) { (println s) 0 }))
    ; --- 9. ten thousand frames, one region each ---
    (println (deep 10000))
    ; --- 10. `region` off the head is a name ---
    (println (twice 21))
    0
  }
)
