; A call on a freed channel or mutex, and a second free of either, traps
; with status 85 (docs/memory-model.md MM-PAR-8, MM-EXEC-16) on every
; target and at every `--opt` (the `.optstable`). The handle is a slot in
; the runtime's handle table, and the table is asked before the mapping
; is touched, so a freed handle never reads the unmapped page.
;
; Live handles answer first: those are the controls. Then every
; operation on a freed channel and a freed mutex, a second free of each,
; a word the table never issued and a mutex's word used as a channel
; run inside a recovery point, and each must answer 85 there. The last,
; a send on the freed channel, is not recovered: the program prints the
; trap's sentence and exits 85, and nothing after it runs.
(import IO)
(import Str)
(import Err)
(import Chan)
(import Sync)

(:: bit (-> Bool Int))
(fn (bit b)
  (if b
    1
    0))

(:: okBit (-> (Result Int Error) Int))
(fn (okBit r)
  (match r
    ((Ok v) 1)
    ((Err e) 0)))

; Operation `k` on channel `c`; each answers 1 when it returns at all.
(:: chanOp (-> Int Chan Int))
;@axiom:effect(io)
(fn (chanOp k c)
  (if (== k 0)
    {
      (chanSend c 1)
      1
    }
    (if (== k 1)
      {
        (chanTrySend c 1)
        1
      }
      (if (== k 2)
        {
          (chanRecv c)
          1
        }
        (if (== k 3)
          {
            (chanTryRecv c)
            1
          }
          (if (== k 4)
            (let ((_ (chanSendTimeout c 1 1000)))
              1)
            (if (== k 5)
              (let ((_ (chanRecvTimeout c 1000)))
                1)
              (if (== k 6)
                {
                  (chanClose c)
                  1
                }
                (if (== k 7)
                  (bit (chanClosed c))
                  (if (== k 8)
                    (chanLen c)
                    (if (== k 9)
                      (chanCap c)
                      (okBit (chanFree c)))))))))))))

(:: chanName (-> Int String))
(fn (chanName k)
  (if (== k 0)
    "send"
    (if (== k 1)
      "trySend"
      (if (== k 2)
        "recv"
        (if (== k 3)
          "tryRecv"
          (if (== k 4)
            "sendTimeout"
            (if (== k 5)
              "recvTimeout"
              (if (== k 6)
                "close"
                (if (== k 7)
                  "closed"
                  (if (== k 8)
                    "len"
                    (if (== k 9)
                      "cap"
                      "free")))))))))))

; Operation `k` on mutex `m`.
(:: mutexOp (-> Int Mutex Int))
;@axiom:effect(io)
(fn (mutexOp k m)
  (if (== k 0)
    (okBit (mutexLock m))
    (if (== k 1)
      (match (mutexTryLock m)
        ((Some g) 1)
        ((None) 0))
      (if (== k 2)
        (okBit (mutexLockTimeout m 1000))
        (if (== k 3)
          (okBit (mutexUnlock m 1))
          (if (== k 4)
            (bit (mutexOwnerDead m))
            (okBit (mutexFree m))))))))

(:: mutexName (-> Int String))
(fn (mutexName k)
  (if (== k 0)
    "lock"
    (if (== k 1)
      "tryLock"
      (if (== k 2)
        "lockTimeout"
        (if (== k 3)
          "unlock"
          (if (== k 4)
            "ownerDead"
            "free"))))))

(:: chanTrapped (-> Int Chan Int))
;@axiom:effect(io)
(fn (chanTrapped k c)
  (__axiom_recover
    __axiom_arena_mark
    (lambda (x) (chanOp k c))))

(:: mutexTrapped (-> Int Mutex Int))
;@axiom:effect(io)
(fn (mutexTrapped k m)
  (__axiom_recover
    __axiom_arena_mark
    (lambda (x) (mutexOp k m))))

; A word the table never issued, and a live mutex's word, each spelled as
; a channel. Only a `cast` can write either, because `Chan` is sealed; a
; cast to a sealed type is a forging cast, the unsafe layer's (MM-VAL-22).
(:: forged Chan)
;@axiom:effect(unsafe)
(fn (forged)
  (cast Chan 1234567))

(:: asChan (-> Mutex Chan))
;@axiom:effect(unsafe)
(fn (asChan m)
  (cast Chan m))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (chanNew 4)
    ((Ok c)
      (match (mutexNew)
        ((Ok m)
          (match (mutexNew)
            ((Ok live)
              {
                ; The controls: every operation on a live handle returns.
                (println (bit (chanSend c 5)))  ; 1
                (println (chanLen c))  ; 1
                (println (chanCap c))  ; 4
                (match (mutexLock m)
                  ((Ok g) (println (okBit (mutexUnlock m g))))
                  ; 1
                  ((Err e) (println "lock failed")))
                (println (okBit (chanFree c)))  ; 1
                (println (okBit (mutexFree m)))  ; 1
                (for k 0 11
                  (let (
                    (st (chanTrapped k c))
                    (nm (chanName k))
                  )
                    (println "freed channel {nm}: status {st}")))
                (for k 0 6
                  (let (
                    (st (mutexTrapped k m))
                    (nm (mutexName k))
                  )
                    (println "freed mutex {nm}: status {st}")))
                (let ((st (chanTrapped 0 forged)))
                  (println "forged channel send: status {st}"))
                (let ((st (chanTrapped 8 (asChan live))))
                  (println "a mutex as a channel: status {st}"))
                (println (okBit (mutexLock live)))  ; 1
                (chanSend c 6)
                ; Not reached: the unrecovered send above exits 85.
                (printlnLit (strCStr "UNREACHABLE: the trap returned"))
              }
            )
            ((Err e) 3))
        )
        ((Err e) 2))
    )
    ((Err e) 1)))
