; A dropped TCP client signals EOF; a dropped listener closes its fd.
(import IO)
(import Net)
(import Sys)
(import Err)
(import Str)

(:: roundTrip (-> SocketAddr Int))
;@axiom:effect(io)
(fn (roundTrip addr)
  (match (tcpListen addr)
    ((Ok listener)
      (match (tcpListenerAddr listener)
        ((Ok local)
          { (match (tcpConnect local)
              ((Ok client)
                (match (tcpAccept listener)
                  ((Ok peer)
                    { (let ((_ (tcpWrite client "hello"))) 0)
                      (let ((_ (tcpClose client))) 0)
                      (match (tcpReadAll peer)
                        ((Ok s) (println (strEq s "hello")))
                        ((Err e) (die (errorText e) 1)))
                      0 })
                  ((Err e) (die (errorText e) 1))))
              ((Err e) (die (errorText e) 1)))
            (tcpListenerFd listener) })
        ((Err e) (die (errorText e) 1))))
    ((Err e) (die (errorText e) 1))))

(:: automaticClient (-> SocketAddr Int))
;@axiom:effect(io)
(fn (automaticClient addr)
  (match (tcpConnect addr)
    ((Ok client) (tcpStreamFd client))
    ((Err e) (die (errorText e) 1))))

(:: eofAfterDrop (-> SocketAddr Int))
;@axiom:effect(io)
(fn (eofAfterDrop addr)
  (match (tcpListen addr)
    ((Ok listener)
      (match (tcpListenerAddr listener)
        ((Ok local)
          { (automaticClient local)
            (match (tcpAccept listener)
              ((Ok peer)
                (match (tcpReadSome peer 1)
                  ((Ok s) { (println (== (strLen s) 0)) 0 })
                  ((Err e) (die (errorText e) 1))))
              ((Err e) (die (errorText e) 1)))
            0 })
        ((Err e) (die (errorText e) 1))))
    ((Err e) (die (errorText e) 1))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (socketAddrParse "127.0.0.1:0")
    ((Ok addr)
      { (let ((fd (roundTrip addr)))
          (match (sysCloseFd fd)
            ((Ok _) (die "listener leaked" 1))
            ((Err e) (println (== (errCode e) 9)))))
        (eofAfterDrop addr)
        0 })
    ((Err e) (die (errorText e) 1))))
