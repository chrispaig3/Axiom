; The RENDERING a hole produces, pinned per shape.
;
; Every `{hole}` and every `(println x)` lowers to a reserved head the
; checker resolves from the argument's static type
; (docs/reference.md, "Printing and Formatting"); `(format x)` is the
; only way to write that lowering, and this file is what fixes the
; bytes it produces, because they are a compatibility surface:
;
;   scalars      `Int`, `Float`, `Bool`, `String` - `Fmt`'s functions
;   Char         the character literal, escaped as the lexer spells it
;   data         a constructor application in the language's own
;                spelling, a nullary constructor bare
;   struct       `{x = 1, y = 2}` in declaration order
;   String       QUOTED with escapes inside a structure, BARE at top
;                level, which is what `(println s)` always meant
;   recursion    a recursive type prints in full; a value that reaches
;                ITSELF (a struct field is assignable) prints `...`
;                at the back-edge instead of never returning
;
; Self-grading, `340-json`'s shape: `verify-stdlib-out.py` reads the
; `eq` calls below and forbids a `FAIL` line, so a re-blessed golden
; cannot make a wrong rendering pass.
(import IO)

(:: eq (-> String String String Int))

;@axiom:effect(io)
(fn (eq name got want)
  (if (strEq got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }
  )
)

(struct Point
  (x : Int)
  (y : Int))

(struct Named
  (name : String)
  (ok : Bool)
  (c : Char)
  (f : Float))

(data Colour
  (Red)
  (Green)
  (Blue))

(data Shape
  (Circle Int)
  (Rect Int Int)
  (Dot))

(data Variant
  (Circ { r : Int })
  (Corner))

(data List a
  (Nil)
  (Cons a (List a)))

(data Box a
  (MkBox a))

(struct Cell
  (v : Int)
  (mut next : (Option Cell)))

(data Wrap
  (Wrap Point Colour (Option String)))

; A bare `None` is `(Option _t)` - no element type, so no renderer
; (a type variable is not a type); the signature is what names it.
(:: noneInt (Option Int))

(fn (noneInt) None)

; There is no user-written rendering to prefer. A written `impl` used
; to win at the call and that preference was pinned here with an
; `(impl (Show Custom))` of this file's own; traits went in 0.6.0 and
; took both the preference and the shape that expressed it. 0.7.4 took
; the last of it: the head a hole lowers to is not a name a program can
; declare, so `showResolve` renders every type from its static type and
; this file pins that alone.
(:: main Int)

;@axiom:effect(io)
(fn (main)
  ; scalars: the instances, unchanged
  (let (
    (p (Point 1 -2))
    (n (Named "bo\"b\n" true 'x' 1.5))
    (xs (Cons 1 (Cons 2 Nil)))
    (c (Cell 7 None))
    (w (Wrap (Point 3 4) Green (Some "hi")))
    (bare "bo\"b")
  )
    {
      (eq "int" (format 42) "42")
      (eq "string bare at top level" (format bare) "bo\"b")
      (eq "bool" (format true) "true")
      (eq "float" (format 2.5) "2.500000")
      ; Char: the literal, escaped
      (eq "char" (format 'x') "'x'")
      (eq "char newline" (format '\n') "'\\n'")
      (eq "char quote" (format ''') "'\\''")
      (eq "char non-ascii" (format 'é') "'é'")
      (eq "char four bytes" (format '😀') "'😀'")
      ; data
      (eq "nullary" (format Red) "Red")
      (eq "one field" (format (Circle 3)) "(Circle 3)")
      (eq "two fields" (format (Rect 3 4)) "(Rect 3 4)")
      (eq "nullary among fieldful" (format Dot) "Dot")
      (eq "struct variant is positional" (format (Circ 7)) "(Circ 7)")
      (eq "option some" (format (Some 3)) "(Some 3)")
      (eq "option none" (format noneInt) "None")
      (eq "option nested" (format (Some (Some 5))) "(Some (Some 5))")
      (eq "one renderer per instantiation" (format (MkBox true)) "(MkBox true)")
      (eq "and another" (format (MkBox 3)) "(MkBox 3)")
      ; struct
      (eq "struct" (format p) "{x = 1, y = -2}")
      (eq "struct in a hole" (format "p = {p}") "p = {x = 1, y = -2}")
      (eq "string quoted inside a structure" (format n) "{name = \"bo\\\"b\\n\", ok = true, c = 'x', f = 1.500000}")
      ; nested
      (eq "struct inside data" (format (Some p)) "(Some {x = 1, y = -2})")
      (eq "string inside data" (format (Some "top")) "(Some \"top\")")
      (eq "char inside data" (format (Some 'q')) "(Some 'q')")
      (eq "three fields, mixed" (format w) "(Wrap {x = 3, y = 4} Green (Some \"hi\"))")
      ; recursion
      (eq "recursive type in full" (format xs) "(Cons 1 (Cons 2 Nil))")
      (eq "strings in a list" (format (Cons "a\tb" (Cons "c" Nil))) "(Cons \"a\\tb\" (Cons \"c\" Nil))")
      (set c.next (Some c))
      (eq "a value that reaches itself" (format c) "{v = 7, next = (Some ...)}")
      0
    }
  )
)
