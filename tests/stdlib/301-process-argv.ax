; Typed process arguments preserve empty strings and literal bytes. Launch
; validation refuses empty vectors and embedded NUL before any child runs.
(import IO)
(import Sys)
(import Str)
(import Vec)
(import Err)

(:: arguments (-> String (Vec String)))
(fn (arguments mode)
  { (let args (vecNew))
    (vecPush args "typed child")
    (vecPush args mode)
    (vecPush args "")
    (vecPush args "space value")
    (vecPush args "$(literal);*")
    (vecPush args "café")
    args })

(:: code (-> (Result Int Error) Int))
(fn (code result)
  (match result ((Ok value) value) ((Err error) (- 0 (errCode error)))))

(:: joined (-> (Result Int Error) Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (joined result)
  (match result
    ((Ok pid) (match (sysWaitPid pid)
      ((Ok status) (sysExitCode status))
      ((Err error) (- 0 (errCode error)))))
    ((Err error) (- 0 (errCode error)))))

(:: textIs (-> String String Bool))
;@axiom:effect(io)
(fn (textIs path wanted)
  (match (readFile path) ((Ok text) (strEq text wanted)) ((Err _) false)))

(:: say (-> String Bool ()))
;@axiom:effect(io)
(fn (say label good)
  (println "{label}: {good}"))

(:: child Int)
;@axiom:effect(io)
(fn (child)
  { (if (strEq (sysArg 1) "child")
      { (writeStr stdout "child stdout\n") (writeStr stderr "child stderr\n") })
    (if (&& (== sysArgc 6)
          (&& (strEq (sysArg 0) "typed child")
            (&& (strEq (sysArg 2) "")
              (&& (strEq (sysArg 3) "space value")
                (&& (strEq (sysArg 4) "$(literal);*") (strEq (sysArg 5) "café"))))))
      7 99) })

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:restrict(no-unsafe)
(fn (main)
  (if (> sysArgc 1)
    child
    { (let self (sysArg 0))
      (let args (arguments "quiet"))
      (let noisy (arguments "child"))
      (let nul (strFromByte 0))
      (let badArgs (arguments "quiet"))
      (vecPush badArgs (concat "before" (concat nul "after")))
      (say "run literal argv" (== (code (sysRun self args)) 7))
      (say "spawn literal argv" (== (joined (sysSpawn self args)) 7))
      (say "redirect status" (== (joined (sysSpawnOutErrTo self noisy "typed-process.out" "typed-process.err")) 7))
      (say "redirect stdout" (textIs "typed-process.out" "child stdout\n"))
      (say "redirect stderr" (textIs "typed-process.err" "child stderr\n"))
      (say "stderr-only status" (== (code (sysRunPathErrTo self noisy "typed-process-only.err")) 7))
      (say "stderr-only bytes" (textIs "typed-process-only.err" "child stderr\n"))
      (say "argv unchanged" (&& (== (vecLen args) 6) (strEq (vecGet args 2) "")))
      (say "empty argv refused" (== (code (sysRun self (vecNew))) -22))
      (say "spawn empty argv refused" (== (code (sysSpawn self (vecNew))) -22))
      (say "NUL argument refused" (== (code (sysRun self badArgs)) -22))
      (say "spawn NUL argument refused" (== (code (sysSpawn self badArgs)) -22))
      (say "NUL path refused" (== (code (sysSpawn (concat self nul) args)) -22))
      (say "NUL stderr refused" (== (code (sysRunPathErrTo self args (concat "bad" nul))) -22))
      (say "NUL stdout refused" (== (code (sysSpawnOutErrTo self args (concat "bad" nul) "bad.err")) -22))
      (say "invalid redirects unopened" (&& (! (fileExists "bad")) (! (fileExists "bad.err"))))
      (let _ (removeFile "typed-process.out"))
      (let _ (removeFile "typed-process.err"))
      (let _ (removeFile "typed-process-only.err"))
      0 }))
