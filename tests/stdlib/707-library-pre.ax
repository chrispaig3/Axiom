; A condition a caller can check from the arguments alone is stated as a
; `;@axiom:pre(...)` contract and checked on every call. `pollerNew`
; takes a capacity of at least one event, and `secretBlockNew` takes a
; handle kind from 16 to 63. A violated contract traps 80.
;
; The first violation runs inside a recovery point, which answers 80 to
; the arming call, so the program reaches the second. A kind in range
; is accepted. The last call is outside any recovery point and ends the
; program with status 80.
(import IO)
(import Crypto.Secret)

(:: badCap Int)
;@axiom:effect(io)
(fn (badCap)
  (__axiom_recover
    __axiom_arena_mark
    (lambda (x)
      (match (pollerNew 0)
        ((Ok p) 0)
        ((Err e) 1)))))

(:: blockOk (-> Int Int))
;@axiom:effect(io)
(fn (blockOk kind)
  (match (secretBlockNew kind 16)
    ((Ok h) (secretBlockFree kind h))
    ((Err e) 1)))

;@axiom:effect(io)
(fn (main)
  {
    (println (badCap))
    (println (blockOk 16))
    (println "the next kind is outside 16 to 63")
    ; NOT REACHED: the contract traps first.
    (blockOk 7)
  })
