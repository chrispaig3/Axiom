; A channel whose lock holder died is poisoned, and every call on it
; answers a defined status rather than waiting for ever (AN-10,
; docs/memory-model.md MM-PAR-10).
;
; A forked binding takes the channel's lock word exactly as `chanLock`
; does and hangs. While it lives, a timed receive answers `sysTimedOut`
; (1001): the deadline covers the wait for the lock. Once it is killed and
; reaped, the next call finds the holder gone within one 100 ms slice and
; poisons the channel: sends answer False, receives None, the timed forms
; `chanOwnerDead` (1004), close changes nothing, `chanClosed` answers
; True, `chanLen` 0 and `chanPoisoned` True, and `chanFree` frees it.
;
; Taking the lock the way `chanLock` does borrows `stdlib/Chan.ax`'s
; layout - word 0 is the lock, marked with the holder's pid times 4, and
; the handle table's kind 2 is a channel - which a test may do through the
; unsafe layer.
(import IO)
(import Sys)
(import Mem)
(import Err)
(import Chan)

(:: say (-> String Int Int))
;@axiom:effect(io)
(fn (say what v)
  {
    (println "{what} {v}")
    0
  })

(:: bit (-> Bool Int))
(fn (bit b)
  (if b
    1
    0))

(:: isNone (-> (Option Int) Bool))
(fn (isNone o)
  (match o
    ((Some v) false)
    ((None) true)))

(:: recvCode (-> (Result (Option Int) Error) Int))
(fn (recvCode r)
  (match r
    ((Ok o)
      (match o
        ((Some v) v)
        ((None) (- 0 1)))
    )
    ((Err e) (errCode e))))

(:: sendCode (-> (Result Bool Error) Int))
(fn (sendCode r)
  (match r
    ((Ok b) (bit b))
    ((Err e) (errCode e))))

; The ring a live channel names, as `Chan.ax`'s `chanAt` asks for it.
(:: ringOf (-> Chan Int))
;@axiom:effect(unsafe)
(fn (ringOf c)
  (__handle_get
    2
    (cast Int c)))

(:: flagged (-> Int Int))
;@axiom:effect(unsafe)
(fn (flagged flag)
  (__atomic_load flag))

; Take the lock word as `chanLock`'s compare-and-swap does, say so, and
; hang holding it.
(:: holdLock (-> Chan Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(fn (holdLock c flag)
  (if (== (__atomic_cas (ringOf c) 0 (* sysGetPid 4)) 0)
    {
      (__atomic_store flag 1)
      (while (== 0 0)
        (sysWaitWordTimeout flag 1 1000000000))
      0
    }
    9))

(:: handlePid (-> Spawn Int))
(fn (handlePid h)
  (__spawn_pid h))

;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (match (chanNew 2)
    ((Ok c)
      (match (sysMapShared 4096)
        ((Ok flag)
          (let (
            (cell (memAlloc 8))
            (h (__proc_spawn
              (lambda (x) (holdLock c flag))
              0))
          )
            {
              (while (== (flagged flag) 0)
                (sysWaitWordTimeout flag 0 1000000))
              (say "alive-timed" (recvCode (chanRecvTimeout c 50000000)))
              (say "alive-poisoned" (bit (chanPoisoned c)))
              (match (sysKill (handlePid h) 9)
                ((Ok z) 0)
                ((Err e) 0))
              (__proc_join_nr h cell)
              (say "holder-status" (memGetWord cell 0))
              (say "send" (bit (chanSend c 5)))
              (say "poisoned" (bit (chanPoisoned c)))
              (say "try-send" (bit (chanTrySend c 5)))
              (say "recv-none" (bit (isNone (chanRecv c))))
              (say "try-recv-none" (bit (isNone (chanTryRecv c))))
              (say "send-timed" (sendCode (chanSendTimeout c 5 50000000)))
              (say "recv-timed" (recvCode (chanRecvTimeout c 50000000)))
              (say "close" (chanClose c))
              (say "closed" (bit (chanClosed c)))
              (say "len" (chanLen c))
              (say "cap" (chanCap c))
              (say
                "free"
                (match (chanFree c)
                  ((Ok z) 1)
                  ((Err e) 0)))
              0
            })
        )
        ((Err e) 2))
    )
    ((Err e) 1)))
