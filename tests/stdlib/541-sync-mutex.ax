; stdlib/Sync.ax: a mutex between `parallel` bindings (R-C2, MM-PAR-11).
;
; One binding first: a free mutex's lock, a held mutex refusing a second
; try and timing out a timed lock (the mutex is not reentrant, so the
; holder waits for itself until the time runs out), and the lock free
; again once the guard's scope ends - nothing unlocks by hand
; (MM-PAR-15, and `tests/stdlib/800-mutex-guard.ax` for every way a
; guard ends). Then two forked bindings add to one plain word in a
; shared mapping 3,000 times each under the lock - the total is exact.
; Then a holder that dies: a forked binding takes the lock and is
; SIGKILLed and reaped holding it, and the next lock calls answer
; `syncOwnerDead`. `scripts/check-task.sh` runs the same shapes under
; `--threads`, at four bindings, against an unlocked control and an
; ablated lock. The handle is a `Mutex` (MM-PAR-8), captured by the
; bindings because it is declared `shared`.
(import IO)
(import Sys)
(import Mem)
(import Err)
(import Sync)

(:: bit (-> Bool Int))
(fn (bit b)
  (if b
    1
    0))

(:: codeOf (-> (Result a Error) Int))
(fn (codeOf r)
  (match r
    ((Ok g) 0)
    ((Err e) (errCode e))))

(:: tryCode (-> (Option MutexGuard) Int))
(fn (tryCode o)
  (match o
    ((Some g) 0)
    ((None) 1)))

(:: bump (-> Mutex Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (bump m cell n)
  {
    (for i in 0..n
      (match (mutexLock m)
        ((Ok g)
          (memSetWord cell 0 (+ (memGetWord cell 0) 1))
        )
        ((Err e) 0)))
    0
  })

(:: hold (-> Mutex Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (hold m flag x)
  (match (mutexLock m)
    ((Ok g)
      {
        (memSetWord flag 0 1)
        (sysWakeWord flag)
        (while (== 0 0)
          (sysWaitWordTimeout (+ flag 8) 0 1000000000))
        0
      }
    )
    ((Err e) 9)))

; The pid of a forked binding, through its live `Spawn` handle.
(:: handlePid (-> Spawn Int))
(fn (handlePid h)
  (__spawn_pid h))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (match (mutexNew)
    ((Ok m)
      {
        (println syncOwnerDead)  ; 1004
        (match (mutexLock m)
          ((Ok g)
            {
              (println 1)  ; 1
              (println (tryCode (mutexTryLock m)))  ; 1
              (println (codeOf (mutexLockTimeout m 30000000)))  ; 1001
            }
          )
          ((Err e) (println "no lock")))
        (println (tryCode (mutexTryLock m)))  ; 0
        (match (mutexLockTimeout m 30000000)
          ((Ok g2) (println 1))  ; 1
          ((Err e) (println "no timed lock")))
        (match (mutexTryLock m)
          ((Some g3) (println (tryCode (mutexTryLock m))))  ; 1
          ((None) (println "busy")))
        ; Two forked bindings, one plain word.
        (match (sysMapShared 4096)
          ((Ok cell)
            {
              (parallel p (
                (a (bump m cell 3000))
                (b (bump m cell 3000))
              )
                (+ a b))
              (println (memGetWord cell 0))  ; 6000
            }
          )
          ((Err e) (println "no mapping")))
        (println (bit (mutexOwnerDead m)))  ; 0
        (println (codeOf (mutexFree m)))  ; 0
        ; A holder that dies holding it.
        (match (mutexNew)
          ((Ok d)
            (match (sysMapShared 4096)
              ((Ok flag)
                (let (
                  (cell (memAlloc 8))
                  (h (__proc_spawn
                    (lambda (x) (hold d flag x))
                    0))
                )
                  {
                    (while (== (memGetWord flag 0) 0)
                      (sysWaitWordTimeout flag 0 1000000))
                    (println (tryCode (mutexTryLock d)))  ; 1
                    (match (sysKill (handlePid h) 9)
                      ((Ok z) 0)
                      ((Err e) 0))
                    (__proc_join_nr h cell)
                    (println (memGetWord cell 0))  ; 137
                    (println (codeOf (mutexLockTimeout d 2000000000)))  ; 1004
                    (println (bit (mutexOwnerDead d)))  ; 1
                    (println (codeOf (mutexLock d)))  ; 1004
                    (println (tryCode (mutexTryLock d)))  ; 1
                    (println (codeOf (mutexFree d)))  ; 0
                  })
              )
              ((Err e) (println "no mapping")))
          )
          ((Err e) (println "no mutex")))
        0
      }
    )
    ((Err e) 1)))
