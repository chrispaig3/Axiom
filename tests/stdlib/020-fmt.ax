; Integer formatting, which used to require a variadic C `printf`.
(import IO)

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  {
    (println 0)
    (println 7)
    (println 10)
    (println 99)
    (println 100)
    (println 123456789)
    (println (- 0 1))
    (println (- 0 4096))
    (println 9223372036854775807)
    ; The largest magnitude and the two values either side of the
    ; negation boundary. `(- 0 max)` is `min + 1`, not `min`: `min` has no
    ; literal spelling, so it is reached by overflowing `max + 1`.
    ;
    ; Both lines used to print `-9223372036854775808`. `fmtInt` guarded
    ; the no-positive-counterpart case with `(== n (- 0 max))`, which
    ; names `min + 1`, so `min + 1` got `min`'s digits and `min` itself
    ; fell through to negating-a-negative and never terminated.
    (println (- 0 9223372036854775807))
    (println (+ 9223372036854775807 1))
    (println (fmtIntWidth (+ 9223372036854775807 1)))
    (println (fmtHex 0))
    (println (fmtHex 255))
    (println (fmtHex 48879))
    (println (fmtPadLeft (fmtInt 42) 6))
    (println (fmtPadLeft (fmtInt 1234567) 3))
    0
  })
