; Command-line arguments reach the program: the entry wrapper captures
; argc/argv before main runs, `Sys.sysArgc`/`sysArg` read them back.
; The test runner invokes binaries with no arguments, so argc is
; exactly 1 and argv[0] is the binary's own path - non-empty on every
; supported platform. Out-of-range indices answer "" rather than a
; wild address; the argument-passing half is pinned by an integration
; test that actually passes some.
(import IO)
(import Sys)
(import Str)

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  {
    (println (sysArgc))                            ; 1
    (println (if (> (strLen (sysArg 0)) 0) 1 0))   ; 1: program name
    (println (strLen (sysArg 5)))                  ; 0: out of range
    (println (strLen (sysArg (- 0 1))))            ; 0: negative
    0
  })
