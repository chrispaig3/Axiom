; exit 255 (see .exit)
; MM-LIFE-2h, the ARRAY form and the container maps built on it. Eight
; probes, one bit each; the arithmetic is 128+64+32+16+8+4+2+1 = 255.
;
; The array form is bit 15 of the shape word: "every payload word
; 0..count-1 is a reference", with the count in bits 16..62 (written by
; `Mem.memMarkArray`). A container's element buffer carries it exactly
; when the container owns its elements, and a container owns them when
; its first element's type is counted (MM-LIFE-2m). This fixture pins
; the encoding; `406-array-form-large-block.ax` pins the large-block
; cliff.
;
;   128  a vector whose first element is a `String` has an array-form
;        data block: 32768 (bit 15) + 16 (8 words, cap 8) + 524288
;        (8 << 16) = 557072. One whose first element is an `Int` reads
;        16: the same block, the same size, no claim about its contents
;    64  an interner's string vector holds 64 words, so once a string
;        is interned its shape reads 32768 + 128 + 4194304 (64 << 16)
;        = 4227200, past the record bitmap's 47-word capacity
;    32  the three container headers carry record maps naming their own
;        buffers: `Vec` 262152 (4 words, bit 2), `Map` 1835024 (8
;        words, bits 2/3/4), `Intern` 327688 (4 words, bits 0 and 2)
;    16  transitive reclaim, four levels: dropping the vector releases
;        its data block, whose array form releases the `Str` header,
;        whose own map releases the 201-byte block behind it, and a
;        200-byte request gets that block back
;     8  the ablation: the same string in a vector made plain by an
;        `Int` first element is not given back
;     4  growth hands the old data block to the free list, and a
;        request of that size gets it back
;     2  a table whose first value is a `String` has an array-form value
;        array, and one whose first value is an `Int` does not
;     1  `vecPop` zeroes what it vacates, so a popped element is not
;        released again by the array walk
(import Mem)
(import Vec)
(import Map)
(import Intern)
(import Str)

(:: b2i (-> Bool Int))
(fn (b2i x)
  (if x
    1
    0))

; A block's shape word, count word, and payload word `i`, read through
; whatever handle names it.
(:: shapeOf (-> a Int))
;@axiom:effect(unsafe)
(fn (shapeOf x)
  (__load64 (- (cast Int x) 8) 0))

(:: countOf (-> a Int))
;@axiom:effect(unsafe)
(fn (countOf x)
  (__load64 (- (cast Int x) 16) 0))

(:: wordAt (-> a Int Int))
;@axiom:effect(unsafe)
(fn (wordAt x i)
  (__load64 (cast Int x) i))

; One share of `x`, taken or handed back by hand.
(:: takeShare (-> a Int))
;@axiom:effect(unsafe)
(fn (takeShare x)
  (__retain (cast Int x)))

(:: dropShare (-> a Int))
;@axiom:effect(unsafe)
(fn (dropShare x)
  (__release (cast Int x)))

; The shape word of a vector's data block.
(:: dataShape (-> (Vec a) Int))
(fn (dataShape v)
  (shapeOf (wordAt v 2)))

; Put a 200-byte string in a vector, drop every share of both, and
; answer whether the string's BYTE block came back. `plain` gives the
; vector an `Int` first element, and is the only difference between
; probe 16 and probe 8.
;
; 200 bytes because `strAlloc 200` asks for 201, which pads to 208, a
; size class nothing else here touches: the free list IS the
; measurement.
(:: bytesComeBack (-> Bool Bool))
(fn (bytesComeBack plain)
  (let ((s (strAlloc 200)))
    (let ((bytes (wordAt s 2)))
      {
        (if plain
          (plainHolds s)
          (ownerHolds s))
        (dropShare s)
        (== (memAlloc 200) bytes)
      })))

; A vector that owns `s`, dropped at the end of its scope.
(:: ownerHolds (-> String Int))
(fn (ownerHolds s)
  (let ((v vecNew))
    {
      (vecPush v s)
      (vecLen v)
    }))

; The same vector made plain by an `Int` first element.
(:: plainHolds (-> String Int))
(fn (plainHolds s)
  (let ((v vecNew))
    {
      (vecPush v 7)
      (vecPushStr v s)
      (vecLen v)
    }))

(:: main Int)
(fn (main)
  (let (
    (vr vecNew)
    (vp vecNew)
    (it internNew)
    (mr mapNew)
    (mp mapNew)
    (mut acc 0)
  )
    {
      (vecPush vr "first")
      (vecPush vp 1)
      (set acc (+ acc (* 128 (b2i (&& (== (dataShape vr) 557072) (== (dataShape vp) 16))))))
      (internIntern it "id")
      (set acc (+ acc (* 64 (b2i (== (shapeOf (wordAt (wordAt it 0) 2)) 4227200)))))
      (set acc (+
        acc
        (*
          32
          (b2i
            (&&
              (== (shapeOf vr) 262152)
              (&&
                (== (shapeOf mp) 1835024)
                (== (shapeOf it) 327688)))))))
      (set acc (+ acc (* 16 (b2i (bytesComeBack false)))))
      (set acc (+ acc (* 8 (b2i (== (b2i (bytesComeBack true)) 0)))))
      ; Cap 8 means a 64-byte data block. Nine pushes double it, the
      ; 64-byte block is filed, and a 64-byte request pops it.
      (let ((g vecNew))
        (let ((old (wordAt g 2)))
          {
            (vecPushN g 9)
            (set acc (+ acc (* 4 (b2i (== (memAlloc 64) old)))))
          }))
      (mapInsert mr 1 "one")
      (mapInsert mp 1 1)
      (set acc (+
        acc
        (*
          2
          (b2i
            (&&
              (== (shapeOf (wordAt mr 3)) 557072)
              (== (shapeOf (wordAt mp 3)) 16))))))
      ; The popped element keeps the caller's share: two retains put its
      ; count at 3, the pop zeroes the word, and the free walks past a
      ; zero rather than spending a share. Without `vecPop`'s zero the
      ; count reads 2 here.
      (let ((k (strDup "pop")))
        (let ((pv vecNew))
          {
            (vecPush pv k)
            (takeShare k)
            (vecPop pv)
            (vecFree pv)
            (set acc (+ acc (b2i (== (countOf k) 3))))
          }))
      acc
    }))

(:: vecPushN (-> (Vec Int) Int (Vec Int)))
(fn (vecPushN v n)
  (if (<= n 0)
    v
    {
      (vecPush v 0)
      (vecPushN v (- n 1))
    }))
