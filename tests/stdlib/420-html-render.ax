; The HTML DSL renders what its source says, escaped by default.
;
; Every check here is `eq` over the bytes `hFinish` answers against a
; string literal WRITTEN BY HAND - the second implementation the gate
; rule asks for (CONTRIBUTING.md: each gate carries an assertion derived
; from something other than the compiler's own output). A re-blessed
; golden cannot satisfy a check whose `want` is spelled in the source,
; and the checks print `ok   <name>` / `FAIL <name>`, so the source
; names every line a passing run must print.
;
; WHAT IS PINNED, one check each:
;
;   - the five dangerous bytes `& < > " '` in TEXT context escape three
;     of them and leave the quotes, and in ATTRIBUTE context escape all
;     five - separately, because an escaper that always did all five
;     would pass a single combined check
;   - `raw` escapes NOTHING, so the escaping checks above cannot pass by
;     a builder that escaped everything (the inverse failure of an
;     escaping test)
;   - nesting three deep, the generic `el`/`elVoidA` forms for a tag
;     outside the table, the `attr`/`flag` escape hatches, void elements
;   - `for` over three items and over an empty vector, with the
;     CALLER's binder name; `forInt` over Ints; and hygiene - a caller
;     with its own `i` and `n` in scope around a `for` still reads its
;     own, because the template's are renamed (MAC-HYG-3)
;   - a component as a plain function taking the builder
;   - `Pre`'s `when` inside a child block, both arms
;   - a whole document built once into one builder, compared against
;     its hand-written bytes, its byte count against `hLen`, and then
;     WRITTEN ONCE
;
; THE NEGATIVE PROBES, run by hand when this was written and recorded
; here so they can be run again: against a copy of `stdlib/Html.ax`
; with (a) `hText` routed to `hPut` the text checks FAIL; (b) `hRaw`
; routed to `hText` the raw check FAILS; (c) `hEscAttr` routed to
; `hEscText` the attribute check FAILS on `&quot;`. Each probe moves
; exactly the checks it should and no other.
(import IO)

(import Str)

(import Vec)

(import Fmt)

(import Pre)

(import Html)

(:: eq (-> String String String Int))

;@axiom:effect(io)
(fn (eq name got want)
  (if (strEq got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }
  )
)

(:: eqInt (-> String Int Int Int))

;@axiom:effect(io)
(fn (eqInt name got want)
  (if (== got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }
  )
)

; A fresh builder, the block, the document. `b` is a PARAMETER in
; binder position, so it keeps the caller's name (MAC-HYG-10) and the
; block can reach the builder this template introduces - a template
; binder of its own would be renamed out of the block's sight
; (MAC-HYG-1), which is why the DSL takes the builder explicitly.
(macro (rendered b body) (let ((b hNew))
  {
    body
    (hFinish b)
  }
))

; A component: an ordinary function taking the builder first.
(:: navBar (-> HtmlBuf Int))

(fn (navBar b)
  (navA
    b    (class b "top")    {
      (anchorA b (href b "/") (text b "home"))
      (anchorA b (href b "/items?x=1&y=2") (text b "items"))
    }
  )
)

(:: page (-> String (Vec String) String))

(fn (page heading items)
  (let ((b hNew))
    {
      (raw b "<!DOCTYPE html>\n")
      (htmlA
        b        (lang b "en")        {
          (head
            b            {
              (meta b (charset b "utf-8"))
              (title b (text b heading))
              (link
                b                {
                  (rel b "stylesheet")
                  (href b "/static/site.css")
                }
              )
            }
          )
          (body
            b            {
              (navBar b)
              (divA
                b                (class b "card")                {
                  (h1 b (text b heading))
                  (ul b (for it items (li b (text b it))))
                  (formA
                    b                    {
                      (action b "/echo")
                      (method b "get")
                    }                    {
                      (input
                        b                        {
                          (name b "q")
                          (attr b "type" "text")
                          (placeholder b "say <hi>")
                        }
                      )
                      (buttonA b (attr b "type" "submit") (text b "Go"))
                    }
                  )
                }
              )
            }
          )
        }
      )
      (hFinish b)
    }
  )
)

(:: main Int)

;@axiom:effect(io)
(fn (main)
  (let (
    (five "a & b < c > d \"q\" 'r'")
    (items vecNew)
    (none vecNew)
    (nums vecNew)
  )
    {
      (vecPush items "one")
      (vecPush items "t<w>o")
      (vecPush items "three")
      (vecPush nums 1)
      (vecPush nums 2)
      ; --- escaping, both contexts, separately -------------------
      (eq "text escapes & < > and leaves the quotes" (rendered b (p b (text b five))) "<p>a &amp; b &lt; c &gt; d \"q\" 'r'</p>")
      (eq
        "an attribute value escapes all five"        (rendered
          b          (input
            b            {
              (name b "q")
              (value b five)
            }
          )
        )        "<input name=\"q\" value=\"a &amp; b &lt; c &gt; d &quot;q&quot; &#39;r&#39;\">"
      )
      (eq "raw writes its bytes unescaped" (rendered b (div b (raw b "<em>trusted</em>"))) "<div><em>trusted</em></div>")
      (eq "text with nothing to escape is unchanged" (rendered b (span b (text b "plain"))) "<span>plain</span>")
      ; --- elements ----------------------------------------------
      (eq "three deep" (rendered b (div b (ul b (li b (text b "x"))))) "<div><ul><li>x</li></ul></div>")
      (eq
        "siblings in one block, in order"        (rendered
          b          (div
            b            {
              (h1 b (text b "a"))
              (h2 b (text b "b"))
              (h3 b (text b "c"))
            }
          )
        )        "<div><h1>a</h1><h2>b</h2><h3>c</h3></div>"
      )
      (eq
        "attr and flag are the escape hatches"        (rendered
          b          (buttonA
            b            {
              (attr b "type" "submit")
              (flag b "disabled")
            }            (text b "Go")
          )
        )        "<button type=\"submit\" disabled>Go</button>"
      )
      (eq
        "el and elVoidA reach a tag outside the table"        (rendered
          b          (el
            b            "main"            {
              (text b "m")
              (elVoidA b "wbr" (id b "w"))
            }
          )
        )        "<main>m<wbr id=\"w\"></main>"
      )
      (eq
        "void elements close nothing"        (rendered
          b          {
            (br b)
            (img
              b              {
                (src b "/a.png")
                (alt b "a < b")
              }
            )
            (hr b)
          }
        )        "<br><img src=\"/a.png\" alt=\"a &lt; b\"><hr>"
      )
      ; --- iteration, with the caller's binder name --------------
      (eq "for binds the caller's name over three items" (rendered b (ul b (for it items (li b (text b it))))) "<ul><li>one</li><li>t&lt;w&gt;o</li><li>three</li></ul>")
      (eq "for over an empty vector writes nothing" (rendered b (ul b (for it none (li b (text b it))))) "<ul></ul>")
      (eq "forInt over Ints" (rendered b (ol b (forInt k nums (li b (text b (fmtInt k)))))) "<ol><li>1</li><li>2</li></ol>")
      ; hygiene: `i` and `n` are the template's names for its counter
      ; and bound; a caller holding its own must still read its own
      (let (
        (i 100)
        (n 7)
      )
        (eq "a caller's i and n survive the loop template" (rendered b (ul b (for it items (li b (text b (fmtInt (+ i n))))))) "<ul><li>107</li><li>107</li><li>107</li></ul>")
      )
      ; --- a component, and Pre's conditionals ------------------
      (eq "a component is a function taking the builder" (rendered b (navBar b)) "<nav class=\"top\"><a href=\"/\">home</a><a href=\"/items?x=1&amp;y=2\">items</a></nav>")
      (eq "when, taken" (rendered b (div b (when (> (vecLen items) 1) (p b (text b "shown"))))) "<div><p>shown</p></div>")
      (eq "when, not taken" (rendered b (div b (when (> (vecLen items) 5) (p b (text b "hidden"))))) "<div></div>")
      ; --- the whole document, once ------------------------------
      (let ((doc (page "Items & <things>" items)))
        {
          (eq "a document built once is its hand-written bytes" doc (strConcat "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Items &amp; &lt;things&gt;</title><link rel=\"stylesheet\" href=\"/static/site.css\"></head><body><nav class=\"top\"><a href=\"/\">home</a><a href=\"/items?x=1&amp;y=2\">items</a></nav><div class=\"card\"><h1>Items &amp; &lt;things&gt;</h1><ul><li>one</li><li>t&lt;w&gt;o</li><li>three</li></ul>" "<form action=\"/echo\" method=\"get\"><input name=\"q\" type=\"text\" placeholder=\"say &lt;hi&gt;\"><button type=\"submit\">Go</button></form></div></body></html>"))
          (let ((b hNew))
            {
              (div
                b                {
                  (text b five)
                  (raw b "<hr>")
                }
              )
              (eqInt "hLen counts the bytes hFinish answers" (hLen b) (strLen (hFinish b)))
            }
          )
          ; written once, as a server would write it
          (writeStr stdout doc)
          (writeStr stdout "\n")
        }
      )
      0
    }
  )
)
