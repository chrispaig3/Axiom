; Float's parser against Python's float(), which is correctly rounded.
; The input (691-float-parse.in) is "<text> <bits>" per line, written by
; tests/stdlib/tools/float_vectors.py: random digit strings with the
; point anywhere and exponents past both ends of the range, the exact
; halfway point between two neighbouring floats and a hair either side
; of it, and inputs of more than 800 significant digits.
(import IO)
(import Str)
(import Err)
(import Fmt)
(import Vec)
(import Float)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (readAll stdin)
    ((Err e) (die (errorText e) 1))
    ((Ok text)
      (let (
        (lines (strSplit text 10))
        (mut checked 0)
        (mut wrong 0)
      )
        {
          (for i in 0..(vecLen lines)
            (let ((line (vecGet lines i)))
              (if (== (strLen line) 0)
                0
                (let ((fields (strSplit line 32)))
                  (match (strParseInt (vecGet fields 1))
                    ((None) (die (concat "bad line: " line) 1))
                    ((Some want)
                      {
                        (set checked (+ checked 1))
                        (match (floatParse (vecGet fields 0))
                          ((Ok x)
                            (if (== (floatToBits x) want)
                              0
                              {
                                (set wrong (+ wrong 1))
                                (println (concat "FAIL " (concat (vecGet fields 0) (concat ": got " (fmtInt (floatToBits x))))))
                                0
                              })
                          )
                          ((Err e)
                            {
                              (set wrong (+ wrong 1))
                              (println (concat "FAIL " (concat (vecGet fields 0) (concat ": " (errorText e)))))
                              0
                            }
                          ))
                      }
                    ))))))
          (println (concat "inputs: " (fmtInt checked)))
          (println (concat "wrong: " (fmtInt wrong)))
          (if (== wrong 0)
            0
            1)
        })
    )))
