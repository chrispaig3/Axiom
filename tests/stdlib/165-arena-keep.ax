; `__axiom_arena_reset_keeping`: reclaim to a mark and carry ONE
; contiguous block across the reclaim.
;
; This is §4.1's "copy at the boundary" as a single step, and it has to
; be a single step. Written the way a caller would write it without the
; primitive - reset, then allocate a destination and copy down - the
; destination is handed out by `axiom_alloc`, which scrubs re-used
; memory on the way out, and the scrub runs over the source. That is
; not a corner case: it happens whenever the kept block is bigger than
; the garbage around it, which is a server holding a document and
; answering a short request. Measured on the shape below, written
; naively: 39,841 of 40,000 bytes wrong on the first round.
(import IO)
(import Mem)

(pub :: paint (-> Int Int Int))
(pub fn (paint p n)
  (let ((mut i 0))
    {
      (while (< i n) { (memPutByte p i (% (+ i 7) 251)) (set i (+ i 1)) })
      p
    }))

; How many of `n` bytes at `p` are NOT what `paint` wrote.
(pub :: wrong (-> Int Int Int))
(pub fn (wrong p n)
  (let ((mut i 0) (mut bad 0))
    {
      (while (< i n)
        {
          (if (== (memGetByte p i) (% (+ i 7) 251)) 0 (set bad (+ bad 1)))
          (set i (+ i 1))
        })
      bad
    }))

(pub :: burn (-> Int Int))
(pub fn (burn n)
  (if (<= n 0) 0 { (memAlloc 65536) (burn (- n 1)) }))

; N rounds of: allocate a little garbage, reclaim, keep the block.
(pub :: churn (-> Int Int Int Int Int))
(pub fn (churn m live bytes n)
  (let ((mut k live) (mut i 0))
    {
      (while (< i n)
        {
          (memAlloc 64)
          (set k (__axiom_arena_reset_keeping m k bytes))
          (set i (+ i 1))
        })
      k
    }))

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  {
    ; --- the destination overlaps the source, 500 times over ---
    ;
    ; 40 KB live against 64 bytes of garbage per round, so the restored
    ; waterline is always far below the block being kept.
    (println
      (let ((m (__axiom_arena_mark))
            (live (paint (memAlloc 40000) 40000)))
        (wrong (churn m live 40000 500) 40000)))          ; 0

    ; --- across a chunk boundary ---
    ;
    ; The garbage crosses into chunks mapped after the mark, which the
    ; reclaim returns to the free list; the kept block is copied back
    ; into the marked chunk.
    (println
      (let ((m2 (__axiom_arena_mark))
            (live2 (paint (memAlloc 4096) 4096))
            (junk (burn 40))
            (kept (__axiom_arena_reset_keeping m2 live2 4096)))
        (wrong kept 4096)))                               ; 0

    ; --- when the kept block cannot fit in the marked chunk ---
    ;
    ; 2 MiB will not fit in what remains of a 1 MiB chunk, so the
    ; destination comes from a fresh mapping rather than from the free
    ; list - which at that moment holds the source's own chunk.
    (println
      (let ((m3 (__axiom_arena_mark))
            (big (paint (memAlloc 2097152) 2097152))
            (kept3 (__axiom_arena_reset_keeping m3 big 2097152)))
        (wrong kept3 2097152)))                           ; 0

    ; --- and the zeroing promise still holds around it ---
    ;
    ; Whatever the reclaim leaves behind, the next `memAlloc` still
    ; answers zeroed memory.
    (println
      (let ((m4 (__axiom_arena_mark))
            (live4 (paint (memAlloc 1024) 1024))
            (dirt (memSet (memAlloc 4096) 255 4096))
            (kept4 (__axiom_arena_reset_keeping m4 live4 1024))
            (fresh (memAlloc 4096)))
        (+ (+ (memGetByte fresh 0) (memGetByte fresh 2048))
           (wrong kept4 1024))))                          ; 0
    0
  })
