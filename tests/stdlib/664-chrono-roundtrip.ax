; Every value Chrono prints, it parses back to the same value. The days
; have their own exhaustive case (660-chrono-days.ax); this one takes
; every second of a day, each with one of ten fractions chosen to vary
; how many trailing zeros are dropped, then 400,001 durations spread
; over the whole range and every duration within 100,000 ns of zero,
; then 7,327 datetimes, one every 997 days from -9999-01-01, each at a
; different time of day.
(import IO)
(import Str)
(import Err)
(import Fmt)
(import Chrono)

(:: check (-> String String String Int))
;@axiom:effect(io)
(fn (check name got want)
  (if (strEq got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }))

(:: fraction (-> Int Int))
(fn (fraction i)
  (match (% i 10)
    (0 0)
    (1 500000000)
    (2 1)
    (3 123456789)
    (4 100000000)
    (5 10)
    (6 999999999)
    (7 120000000)
    (8 7000)
    (_ 1000000)))

; 1 unless second `i` of the day, with its fraction, prints and parses
; back to itself and reads back its own fields.
(:: timeFails (-> Int Int))
(fn (timeFails i)
  (let (
    (h (/ i 3600))
    (m (% (/ i 60) 60))
    (s (% i 60))
    (f (fraction i))
  )
    (match (timeNew h m s f)
      ((Err _) 1)
      ((Ok t)
        (if (&& (&& (== (timeHour t) h) (== (timeMinute t) m)) (&& (== (timeSecond t) s) (== (timeNanosecond t) f)))
          (match (timeParse (timeToString t))
            ((Ok back)
              (if (timeEq back t)
                0
                1)
            )
            ((Err _) 1))
          1)
      ))))

; 1 unless `n` nanoseconds prints and parses back to itself.
(:: durationFails (-> Int Int))
(fn (durationFails n)
  (match (durationFromNanos n)
    ((Err _) 1)
    ((Ok d)
      (match (durationParse (durationToString d))
        ((Ok back)
          (if (== (durationNanos back) n)
            0
            1)
        )
        ((Err _) 1))
    )))

; 1 unless day `k * 997` after -9999-01-01, at a time that moves with
; `k`, prints and parses back to itself.
(:: datetimeFails (-> Int Int))
(fn (datetimeFails k)
  (match (dateAddDays dateMin (* k 997))
    ((Err _) 1)
    ((Ok d)
      (let ((t (timeAddWrapping timeMidnight (unwrapOr (durationFromNanos (* k 7919000013)) durationZero))))
        (let ((dt (datetimeNew d t)))
          (match (datetimeParse (datetimeToString dt))
            ((Ok back)
              (if (datetimeEq back dt)
                0
                1)
            )
            ((Err _) 1))))
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (mut timeBad 0)
    (mut spreadBad 0)
    (mut nearBad 0)
    (mut datetimeBad 0)
  )
    {
      (for block in 0..10
        (set timeBad (+
          timeBad
          (region r
            (let ((mut bad 0))
              {
                (for i in (* block 8640)..(* (+ block 1) 8640)
                  (set bad (+ bad (timeFails i))))
                bad
              })))))
      ; Multiples of a large odd step wrap all over the Int range; the
      ; one multiple that lands on the most negative Int is skipped,
      ; because that is not a duration.
      (for block in 0..40
        (set spreadBad (+
          spreadBad
          (region r
            (let ((mut bad 0))
              {
                (for k in (* block 10000)..(* (+ block 1) 10000)
                  (let ((n (* (- k 200000) 46116860184273879)))
                    (if (== n intMin)
                      0
                      (set bad (+ bad (durationFails n))))))
                bad
              })))))
      (set spreadBad (+ spreadBad (durationFails 9223372036854775807)))
      (for block in 0..20
        (set nearBad (+
          nearBad
          (region r
            (let ((mut bad 0))
              {
                (for n in (- (* block 10000) 100000)..(- (* (+ block 1) 10000) 100000)
                  (set bad (+ bad (durationFails n))))
                bad
              })))))
      (set nearBad (+ nearBad (durationFails 100000)))
      (for k in 0..7327
        (set datetimeBad (+ datetimeBad (datetimeFails k))))
      (check "seconds of the day that do not round-trip" (fmtInt timeBad) "0")
      (check "durations across the range that do not round-trip" (fmtInt spreadBad) "0")
      (check "durations near zero that do not round-trip" (fmtInt nearBad) "0")
      (check "datetimes that do not round-trip" (fmtInt datetimeBad) "0")
      (check "the last datetime sampled" (datetimeToString (datetimeNew (unwrapOr (dateAddDays dateMin (* 7326 997)) dateMin) timeMidnight)) "9998-09-26T00:00:00")
      0
    }))
