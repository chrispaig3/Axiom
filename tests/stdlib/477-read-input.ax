; `readLine` and `readAll`: over standard input, over a file the
; program opened itself, and over one that cannot be read.
;
; Standard input is `477-read-input.in`. The runners hand a case its
; `.in` as fd 0 when the file exists and `/dev/null` when it does not
; (`478-read-input-empty.ax` is the other half of that rule). The file
; holds four lines: the second is empty and the last has NO newline.
;
; What each term establishes, in the order it prints:
;
;   1. Four `readLine`s answer the four lines without their newlines -
;      `alpha`; the empty line as `Some ""` and not `None`; `gamma
;      delta` with its interior space; and `omega`, although no
;      newline ended it. Then `None` at end of input, and `None` again:
;      an exhausted descriptor stays exhausted.
;   2. `readAll` on that exhausted descriptor answers `Ok ""`. The
;      stream ended, which is not a failure.
;   3. A file this program opened. One `readLine` takes the first
;      line; the next takes a 300-byte line, which crosses the reader's
;      128-byte buffer twice and comes back byte-identical; then
;      `readAll` takes EVERYTHING after it, which is the proof that the
;      line reader did not over-read - a block reader would have
;      swallowed `second` into a buffer the `readAll` never sees. That
;      file's tail has no newline either, and the `readLine` after the
;      `readAll` is `None`.
;   4. A directory, which opens and cannot be read: both readers
;      answer `Err` with errno 21 (EISDIR), naming the operation. A
;      failed `read` is not "nothing was read", which is the `None`
;      this term refuses.
;
; Every `shape` is a number - the line's length, -1 for `None`, the
; negated errno for `Err` - so the golden's numbers are claims the
; verifier derives from this file rather than from the golden.
(import IO)
(import Err)
(import Str)
(import Sys)

; The line's length, -1 for `None`, and -errno for `Err`.
(:: shape (-> (Result (Option String) Error) Int))
(fn (shape r)
  (match r
    ((Ok (Some s)) (strLen s))
    ((Ok (None)) (- 0 1))
    ((Err e) (- 0 (errCode e)))))

; The line in brackets, so an empty one and a trailing space show.
(:: text (-> (Result (Option String) Error) String))
(fn (text r)
  (match r
    ((Ok (Some s)) (concat (concat "[" s) "]"))
    ((Ok (None)) "none")
    ((Err e) (concat "err: " (errMessage e)))))

; The line itself, or "" - for a comparison rather than a print.
(:: lineOf (-> (Result (Option String) Error) String))
(fn (lineOf r)
  (match r
    ((Ok (Some s)) s)
    ((Ok (None)) "")
    ((Err _) "")))

(:: step (-> (Result (Option String) Error) Int))
;@axiom:effect(io)
(fn (step r)
  {
    (println (shape r))
    (println (text r))
    0
  })

(:: shapeAll (-> (Result String Error) Int))
(fn (shapeAll r)
  (match r
    ((Ok s) (strLen s))
    ((Err e) (- 0 (errCode e)))))

(:: textAll (-> (Result String Error) String))
(fn (textAll r)
  (match r
    ((Ok s) (concat (concat "[" s) "]"))
    ((Err e) (concat "err: " (errMessage e)))))

(:: stepAll (-> (Result String Error) Int))
;@axiom:effect(io)
(fn (stepAll r)
  {
    (println (shapeAll r))
    (println (textAll r))
    0
  })

; A hundred bytes, so three of them cross 128 and 256.
(:: hundred String)
(fn (hundred)
  "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789")

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (long (concat hundred (concat hundred hundred)))
    (path "477-input.txt")
  )
    {
      ; --- 1. standard input, line by line, to the end and past it ---
      (step (readLine stdin))  ; 5
      (step (readLine stdin))  ; 0
      (step (readLine stdin))  ; 11
      (step (readLine stdin))  ; 5
      (step (readLine stdin))  ; -1
      (step (readLine stdin))  ; -1
      ; --- 2. readAll on the exhausted descriptor ---
      (stepAll (readAll stdin))  ; 0
      ; --- 3. a file this program opened ---
      (let ((_ (writeFile path (concat "first line\n" (concat long "\nsecond\nlast without newline"))))) 0)
      (match (openPath path oRdonly)
        ((Ok fd)
          {
            (step (readLine fd))  ; 10
            (let ((r (readLine fd)))
              {
                (println (shape r))  ; 300
                (println (strEq (lineOf r) long))
              })
            (stepAll (readAll fd))  ; 27
            (step (readLine fd))  ; -1
            (let ((_ (fileClose fd))) 0)
            0
          }
        )
        ((Err _) (println "open failed")))
      (let ((_ (removeFile path))) 0)
      ; --- 4. a file that opens and cannot be read ---
      (match (openPath "." oRdonly)
        ((Ok d)
          {
            (step (readLine d))  ; -21
            (stepAll (readAll d))  ; -21
            0
          })
        ((Err _) (println "open failed")))
      0
    }))
