; exit 255 (see .exit)
; MM-LIFE-2c, the closure half: an application THROUGH A CLOSURE now
; gives back the intermediate record a curried chain builds, which a
; direct call's `releaseOwnedArgs` has done for its arguments since
; MM-LIFE-2g.
;
; The instrument is the arena mark cell, as `370-error-propagation.ax`
; uses it: word 0 is the bump, word 2 the chunk. 10,000 iterations of
; which 1,428 apply, inside one chunk, so a per-application cost shows
; up as a bump delta and a flat line is a flat line.
;
;   32  a two-argument CLOSURE applied through a curried chain moves
;       the bump by less than one BLOCK over 1,428 applications. It
;       used to move it 45,664 bytes - 32 a call, the inner closure
;       the first step returns, which nothing released.
;   16  a two-argument effect OPERATION, whose handler is the same
;       curried chain reached through the evidence slot, the same.
;    8  three deep, because the rule is per step and not per call: two
;       intermediates a chain, both given back.
;    4  and they still ANSWER correctly - a released record that was
;       still live would answer garbage here, or not return at all,
;       which is the half a byte count cannot see.
;    2  a ONE-argument application allocates no intermediate and is
;       unchanged: it must not have become a release of a record the
;       caller still owns.
;   64  a parked argument SURVIVES the application. It used to survive
;       by accident - an uncounted park that nothing released - and it
;       now survives because the park is COUNTED, the lambda taking an
;       evidence word for its own argument.
;  128  and a closure over a struct FIELD reads back what it recorded
;       after the field is overwritten: event 5, a release from a frame
;       that never heard of the closure. A live use-after-free until
;       2026-08-30.
;    1  every step above ran.
;
; The bytes are held by scripts/check-closure-reclaim.sh, which
; rebuilds the compiler with the release ablated and requires 32, 16
; and 8 to go red and 4, 2 and 1 to stay green - the term-by-term
; comparison being what says the ablation restored the defect rather
; than broke something else.
(import Str)

(import Vec)

(effect Two
  (bad2 :: (-> String Int Int)))

(effect Three
  (bad3 :: (-> String Int Int Int)))

(:: b2i (-> Bool Int))

(fn (b2i x)
  (if x
    1
    0
  )
)

; Under one BLOCK of drift over the whole run, and the same chunk
; throughout - `370-error-propagation.ax`'s own threshold. The point is
; per-application cost: 1,428 applications leaking one 32-byte record
; each move the bump 45,664 bytes, which is eleven blocks past this.
(:: flat (-> Int Int Bool))

(fn (flat m1 m2)
  (&&
    (== (__load64 m2 2) (__load64 m1 2))
    (< (- (__load64 m2 0) (__load64 m1 0)) 4096)
  )
)

(:: loopC2 (-> (-> String Int Int) Int Int))

(fn (loopC2 h n)
  (let ((mut i 1) (mut acc 0))
    {
      (while (<= i n)
        {
          (set acc (+ acc (if (== (% i 7) 0) (h "malformed" 0) i)))
          (set i (+ i 1))
        })
      acc
    }
  )
)

(:: loopC3 (-> (-> String Int Int Int) Int Int))

(fn (loopC3 h n)
  (let ((mut i 1) (mut acc 0))
    {
      (while (<= i n)
        {
          (set acc (+ acc (if (== (% i 7) 0) (h "malformed" 0 1) i)))
          (set i (+ i 1))
        })
      acc
    }
  )
)

(:: loopC1 (-> (-> String Int) Int Int))

(fn (loopC1 h n)
  (let ((mut i 1) (mut acc 0))
    {
      (while (<= i n)
        {
          (set acc (+ acc (if (== (% i 7) 0) (h "malformed") i)))
          (set i (+ i 1))
        })
      acc
    }
  )
)

(:: loop2 (-> Int Int))

(fn (loop2 n)
  (let ((mut i 1) (mut acc 0))
    {
      (while (<= i n)
        {
          (set acc (+ acc (if (== (% i 7) 0) (bad2 "malformed" 0) i)))
          (set i (+ i 1))
        })
      acc
    }
  )
)

; A PARKED ARGUMENT SURVIVES THE APPLICATION, AND THE REASON CHANGED
; ON 2026-08-30. The term is the same; what makes it true is not.
;
; It used to be true BY ACCIDENT. A store inside a lifted lambda took
; no share - `MM-LIFE-2g`'s `__retainref` is stamped from an evidence
; word, and a lambda had none for its own parameter - so the box held
; the String uncounted, and nothing released it either. Two defects
; cancelling. That is why this term was written: the design for
; releasing a closure's owned argument fires when the application's
; RESULT CLASS is a word, `park` answers `0`, and releasing under an
; uncounted park frees a block the Vec still points at. Measured then,
; with the release simulated by `__release`: 3, the length of the
; string allocated into the freed block, where it must read 16.
;
; It is now true BECAUSE THE PARK IS COUNTED. A lifted lambda takes an
; evidence word for its own argument, passed by the APPLICATION, and
; the same program shows both readings:
;
;   in a named `fn`   call @Vec$vecPush(i64 %box, i64 %s, i64 1)
;   in `_lam_0`       call @Vec$vecPush(i64 %.t2, i64 %m, i64 %.t5)
;
; where `%.t5` is bit 0 of `%__evwa.h`. The same `__release` probe now
; reads 16 against the 3 it read before, so THIS TERM NO LONGER REFUSES
; THE RELEASE, and the argument half is unblocked for every application
; that classifies its argument.
;
; IT DOES NOT UNBLOCK THE RELEASE IN GENERAL, which is the part a
; reader must not skip. An application that cannot classify its
; argument still passes 0, the park is still uncounted, and releasing
; would still free live memory. Two of those remain: the effect
; operation path, whose handler is a runtime load with no application
; node to read; and the outer parameter of a curried lambda, which is
; a capture rather than an argument by the time the store happens.
; `docs/memory-model.md` MM-LIFE-2g names them.
(:: parked (-> Int Int))

(fn (parked box)
  {
    ((lambda (m)
      {
        (vecPush box m)
        0
      }
    ) (strConcat "abcdefgh" "ijklmnop"))
    ; Allocated AFTER the application, so a freed block would be
    ; handed back here and the read below would see these bytes.
    (strLen (strConcat "xy" "z"))
  }
)

; TERM 128 IS THE OTHER FRAME'S RELEASE, and it is worth reading beside
; term 64. Term 64 releases the argument from the application's own
; frame; this one never touches the closure at all - a struct field is
; simply overwritten by code that has no idea a closure is holding its
; old value. That is event 5, and an uncounted park has no answer to
; it. Until 2026-08-30 this was a live use-after-free rather than a
; leak.
;
; `mkLogger` is a factory: it answers a lambda that records what it is
; given. `main` hands it a struct FIELD's value, then overwrites the
; field. The overwrite is event 5, a release from a frame that never
; consulted the closure, and it drops the only counted share while the
; Vec still points at the block. Measured before the fix, at every
; optimisation level: `strByte` reads 122 - `z`, the first byte of a
; string allocated after the free - where 97 is the `a` that was
; recorded. No `cast`, no `__load64`, no header arithmetic, and
; `axiom check` printed OK.
;
; Two changes close it, and this shape is reached by the first alone.
; `checkLamAgainst` binds the lambda's parameter to the DECLARED
; `String` instead of a minted placeholder, so `evClassOf` answers 1
; rather than -1 and `__retainref` is emitted. The evidence word then
; closes the five shapes that have no declaration to bind - a lambda in
; a `let`, out of an `if`, applied with no declaration anywhere, passed
; to a declared arrow parameter, or forced by a use in its own body.
; The same program with a named `fn` in place of the lambda was always
; correct, which is the whole diagnosis in one substitution.
(struct Session
  (name : String))

(:: mkLogger (-> Int (-> String Int)))

(fn (mkLogger log) (lambda (s) (vecPush log s)))

(:: main Int)

(fn (main)
  (let ((mut acc 0) (mut steps 0))
    {
      ; 32 - a two-argument closure chain
      (let ((h2 (lambda (m) (lambda (d) d))))
        (let ((a1 __axiom_arena_mark))
          (let ((r (loopC2 h2 10000)))
            (let ((a2 __axiom_arena_mark))
              {
                (set acc (+ acc (* 32 (b2i (flat a1 a2)))))
                (set steps (+ steps 1))
              }))))
      ; 16 - the same chain reached through an effect operation
      (let ((b1 __axiom_arena_mark))
        (let ((r (handle (loop2 10000) (Two Alloc) (lambda (m) (lambda (d) d)))))
          (let ((b2 __axiom_arena_mark))
            {
              (set acc (+ acc (* 16 (b2i (flat b1 b2)))))
              (set steps (+ steps 1))
            })))
      ; 8 - three deep, two intermediates a call
      (let ((h3 (lambda (m) (lambda (d) (lambda (e) e)))))
        (let ((c1 __axiom_arena_mark))
          (let ((r (loopC3 h3 10000)))
            (let ((c2 __axiom_arena_mark))
              {
                (set acc (+ acc (* 8 (b2i (flat c1 c2)))))
                (set steps (+ steps 1))
              }))))
      ; 4 - and the chains still answer what the handler says
      (let ((ha (lambda (m) (lambda (d) 5))))
        (let ((hb (lambda (m) (lambda (d) (lambda (e) 6)))))
          {
            ; 21 is the sum of the six iterations that do not apply; the
            ; seventh adds what the handler answered.
            (set acc (+ acc (* 4 (b2i (&& (== (loopC2 ha 7) 26) (== (loopC3 hb 7) 27))))))
            (set steps (+ steps 1))
          }))
      ; 2 - a one-argument application builds no intermediate
      (let ((h1 (lambda (m) 0)))
        (let ((d1 __axiom_arena_mark))
          (let ((r (loopC1 h1 10000)))
            (let ((d2 __axiom_arena_mark))
              {
                (set acc (+ acc (* 2 (b2i (&& (flat d1 d2) (== (loopC1 (lambda (m) 9) 7) 30))))))
                (set steps (+ steps 1))
              }))))
      ; 64 - a parked argument survives the application. The closure
      ; answers a word and stores its argument, so the design's
      ; "release when the result is a word" rule would free a block the
      ; Vec still points at. 16 is the length it must read back.
      (let ((box vecNewRef))
        {
          (parked box)
          (set acc (+ acc (* 64 (b2i (== (strLen (vecGetStr box 0)) 16)))))
          (set steps (+ steps 1))
        })
      ; 128 - a closure over a struct field, the field then overwritten
      (let ((log vecNew))
        (let ((rec (mkLogger log)))
          (let ((s (Session (strDup "alice"))))
            {
              (rec s.name)
              (set s.name (strDup "bob"))
              ; Allocated after the release, so a freed block would be
              ; handed back here and the read below would see it.
              (strDup "zzzzz")
              (set acc (+ acc (* 128 (b2i (== (strByte (vecGetStr log 0) 0) 97)))))
              (set steps (+ steps 1))
            })))
      (if (== steps 7)
        (+ acc 1)
        acc
      )
    }
  )
)
