; Round-trip a file: open, write, close, reopen, read to end, close.
(import IO)
(import Err)

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  (let ((path "axiom-stdlib-test.tmp"))
    (match (openPath path oWronlyCreateTrunc)
      ((Err e) (die "open for write failed" 1))
      ((Ok f)
        {
          (let ((_ (fileWrite f "line one\nline two\n"))) 0)
          (let ((_ (fileClose f))) 0)
          (let ((contents (readFile path)))
            {
              (println (strLen contents))
              ; no newline of its own, and no rendering: this is
              ; the primitive, and `print` no longer exists
              (writeStr stdout contents)
              (println
                (match (strFindByte contents 10 0)
                  ((None) (- 0 1))
                  ((Some i) i)))
              (println (strSlice contents 0 8))
              (println (strLen (readFile "no-such-file-here")))
              0
            })
        }
      ))))
