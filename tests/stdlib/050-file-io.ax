; Round-trip a file through the syscall layer: open, write, close,
; reopen, read to EOF, close.
(import IO)

(import Err)

(pub :: main Int)

;@axiom:effect(io)
(pub fn (main)
  (let ((path (__addr "axiom-stdlib-test.tmp")))
    (match (sysOpenPath path oWronlyCreateTrunc)
      ((Err e) (die "open for write failed" 1))
      ((Ok fd)
        {
          (writeStr fd "line one\nline two\n")
          (sysCloseFd fd)
          (let ((contents (readFileLit path)))
            {
              (println (strLen contents))
              ; no newline of its own, and no rendering: this is
              ; the primitive, and `print` no longer exists
              (writeStr stdout contents)
              (println (strFindByte contents 10 0))
              (println (strSlice contents 0 8))
              (println (strLen (readFileLit (__addr "no-such-file-here"))))
              0
            }
          )
        }
      )
    )
  )
)
