; A handler chain's only reference is the evidence slot - a mutable
; global the conservative collector's stack-and-registers root scan
; cannot see. This program answers the same under either allocator;
; what it detects is a collector that fails to treat evidence slots as
; roots, which frees the installed handler closure during the churn and
; corrupts the dispatch after it. The `--gc` run lives in the CLI
; integration tests (the golden harness compiles with the default
; allocator).
;
; The handle list names `Mut` since 2026-08-25, and the reason is not
; about this program: `AX3011` requires the list to be EXHAUSTIVE, and
; `churn`'s `vecPush` reaches `__store64`, which was registered as a
; primitive that computes until `MM-EXEC-9a`'s row for it was closed.
; This was the only fixture in the tree the correction moved.
(import IO)

(import Vec)

(effect Console
  (log :: (-> String Int)))

(:: churn (-> Int Int))

(fn (churn n)
  (if (== n 0)
    0
    (let ((v vecNew))
      {
        (vecPush v 1)
        (vecPush v 2)
        (churn (- n 1))
      }
    )
  )
)

(:: main Int)

;@axiom:effect(io)
(fn (main)
  {
    (handle {
      (churn 200000)
      (log "still alive")
      0
    } (Console IO Alloc Mut) (lambda (s)
      {
        ; `cast String`: a handler parameter's type is a variable, so it
        ; selects no `Show` implementation (AX3025).
        (println
          (cast String s)
        )
        0
      }
    ))
    0
  }
)
