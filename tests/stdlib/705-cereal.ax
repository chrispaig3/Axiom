; expect 0
; Typed Cereal formats, codecs, ownership and resource boundaries.
(import Cereal)
(import Err)
(import IO)
(import Str)
(import Vec)
(import Mem)

(:: check (-> String Bool Int))
;@axiom:effect(io)
(fn (check label valid)
  (if valid { (println "ok   {label}") 0 } { (println "FAIL {label}") 1 }))

(:: canonical (-> CerealFormat String String Bool))
(fn (canonical format source expected)
  (match (cerealDecode format source)
    ((Err e) false)
    ((Ok value) (match (cerealEncode CerealJson value)
      ((Err e) false) ((Ok encoded) (strEq encoded expected))))))

(:: refused (-> CerealFormat String Bool))
(fn (refused format source) (isErr (cerealDecode format source)))

(struct Settings (port : Int) (name : String) (enabled : Bool))
(:: settingsEncode (-> Settings (Result CerealValue Error)))
(fn (settingsEncode value)
  (let ((fields vecNew))
    { (vecPush fields (CerealMember "port" (CInt value.port)))
      (vecPush fields (CerealMember "name" (CText value.name)))
      (vecPush fields (CerealMember "enabled" (CBool value.enabled)))
      (Ok (CObject fields)) }))
(:: settingsDecode (-> CerealValue (Result Settings Error)))
(fn (settingsDecode value)
  (try port (cerealField cerealIntCodec value "port")
    (try name (cerealField cerealTextCodec value "name")
      (try enabled (cerealField cerealBoolCodec value "enabled")
        (Ok (Settings port name enabled))))))
(:: settingsCodec (Codec Settings))
(fn (settingsCodec) (Codec settingsEncode settingsDecode))

(:: recordRoundtrip (-> CerealFormat Bool))
(fn (recordRoundtrip format)
  (match (cerealSerialize format settingsCodec (Settings 8080 "Axiom" true))
    ((Err e) false)
    ((Ok encoded) (match (cerealDeserialize format settingsCodec encoded)
      ((Err e) false)
      ((Ok value) (&& (== value.port 8080) (&& (strEq value.name "Axiom") value.enabled)))))))

(:: safeDecode (-> String (Result CerealValue Error)))
;@axiom:restrict(no-unsafe)
(fn (safeDecode source) (cerealDecode CerealJson source))

; Mutation is confined to the allocated input buffer; parsed keys,
; string values and exact-number spellings must remain independent.
(:: ownedResult Bool)
;@axiom:effect(unsafe)
(fn (ownedResult)
  (let ((source (strDup "{\"key\":\"value\",\"number\":1.20e3}")))
    (match (cerealDecode CerealJson source)
      ((Err e) false)
      ((Ok value)
        { (for i in 0..(strLen source) (memPutByte (strData source) i 120))
          (match (cerealEncode CerealJson value)
            ((Err e) false)
            ((Ok text) (strEq text "{\"key\":\"value\",\"number\":1.20e3}"))) }))))

(:: vectorRoundtrip Bool)
(fn (vectorRoundtrip)
  (let ((items vecNew) (codec (cerealVecCodec cerealIntCodec)))
    { (vecPush items 2) (vecPush items 3)
      (match (cerealSerialize CerealJson codec items)
        ((Err e) false)
        ((Ok text) (match (cerealDeserialize CerealJson codec text)
          ((Err e) false)
          ((Ok values) (&& (== (vecLen values) 2) (&& (== (vecGet values 0) 2) (== (vecGet values 1) 3))))))) }))

(:: optionRoundtrip Bool)
(fn (optionRoundtrip)
  (let ((codec (cerealOptionCodec cerealTextCodec)))
    (&& (match (cerealDeserialize CerealJson codec "null")
          ((Err e) false) ((Ok value) (match value ((None) true) (_ false))))
      (match (cerealDeserialize CerealYaml codec "hello")
        ((Err e) false) ((Ok value) (match value ((Some text) (strEq text "hello")) (_ false)))))))

(:: fieldContext Bool)
(fn (fieldContext)
  (match (cerealDeserialize CerealJson settingsCodec "{\"port\":\"bad\"}")
    ((Ok value) false) ((Err e) (strEq e.context "port"))))

(:: cycleRefused Bool)
(fn (cycleRefused)
  (let ((items vecNew) (value (CArray items)))
    { (vecPush items value) (isErr (cerealEncode CerealJson value)) }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((mut bad 0))
    {
      (set bad (+ bad (check "json record" (recordRoundtrip CerealJson))))
      (set bad (+ bad (check "toml record" (recordRoundtrip CerealToml))))
      (set bad (+ bad (check "yaml record" (recordRoundtrip CerealYaml))))
      (set bad (+ bad (check "vector codec" vectorRoundtrip)))
      (set bad (+ bad (check "option codec" optionRoundtrip)))
      (set bad (+ bad (check "field context" fieldContext)))
      (set bad (+ bad (check "owned result" ownedResult)))
      (set bad (+ bad (check "safe facade" (isOk (safeDecode "null")))))
      (set bad (+ bad (check "cycle bounded" cycleRefused)))
      (set bad (+ bad (check "exact decimal" (canonical CerealJson "1.20e+3" "1.20e+3"))))
      (set bad (+ bad (check "large integer" (canonical CerealJson "9223372036854775808" "9223372036854775808"))))
      (set bad (+ bad (check "int minimum" (canonical CerealJson "-9223372036854775808" "-9223372036854775808"))))
      (set bad (+ bad (check "json duplicate preservation" (canonical CerealJson "{\"a\":1,\"a\":2}" "{\"a\":1,\"a\":2}"))))
      (set bad (+ bad (check "json escapes" (canonical CerealJson "\"\\u0041\\ud83d\\ude00\"" "\"A😀\""))))
      (set bad (+ bad (check "json leading zero" (refused CerealJson "01"))))
      (set bad (+ bad (check "json empty fraction" (refused CerealJson "1."))))
      (set bad (+ bad (check "json empty exponent" (refused CerealJson "1e+"))))
      (set bad (+ bad (check "json comma" (refused CerealJson "[1,]"))))
      (set bad (+ bad (check "json trailing" (refused CerealJson "null true"))))
      (set bad (+ bad (check "json control" (refused CerealJson "\"a\nb\""))))
      (set bad (+ bad (check "utf8 refusal" (refused CerealJson (strFromByte 255)))))
      (set bad (+ bad (check "invalid numeric value" (isErr (cerealEncode CerealJson (CNumber "0x12"))))))
      (set bad (+ bad (check "integer conversion" (isErr (cerealInt (CNumber "1e3"))))))
      (set bad (+ bad (check "toml dotted tables" (canonical CerealToml "name = 'axiom' # hi\n[server]\nport = 8080\n" "{\"name\":\"axiom\",\"server\":{\"port\":8080}}"))))
      (set bad (+ bad (check "toml arrays" (canonical CerealToml "values = [1, +2, 3,]\n" "{\"values\":[1,2,3]}"))))
      (set bad (+ bad (check "toml underscores" (canonical CerealToml "n = 1_000\nx = +1.2_5e+2\n" "{\"n\":1000,\"x\":1.25e+2}"))))
      (set bad (+ bad (check "toml duplicate" (refused CerealToml "a = 1\na = 2"))))
      (set bad (+ bad (check "toml table duplicate" (refused CerealToml "[a]\nx = 1\n[a]\ny = 2"))))
      (set bad (+ bad (check "toml dotted redefinition" (refused CerealToml "a.b = 1\n[a]\nc = 2"))))
      (set bad (+ bad (check "toml inline closed" (refused CerealToml "a = {b = 1}\na.c = 2"))))
      (set bad (+ bad (check "toml nested inline closed" (refused CerealToml "a = {b = {c = 1}, b.d = 2}"))))
      (set bad (+ bad (check "toml bad underscore" (refused CerealToml "a = 1__2"))))
      (set bad (+ bad (check "toml integer overflow" (refused CerealToml "a = 9223372036854775808"))))
      (set bad (+ bad (check "toml null" (refused CerealToml "a = null"))))
      (set bad (+ bad (check "toml datetime" (refused CerealToml "a = 1979-05-27"))))
      (set bad (+ bad (check "toml array tables" (refused CerealToml "[[a]]\nx = 1"))))
      (set bad (+ bad (check "toml literal control" (refused CerealToml (concat "a = '" (concat (strFromByte 1) "'"))))))
      (set bad (+ bad (check "toml inline trailing comma" (refused CerealToml "a = {x = 1,}"))))
      (set bad (+ bad (check "toml root type" (isErr (cerealEncode CerealToml (CInt 1))))))
      (set bad (+ bad (check "toml null encode" (isErr (cerealEncode CerealToml (CObject (vecPush vecNew (CerealMember "a" CNull))))))))
      (set bad (+ bad (check "input byte boundary" (isOk (cerealDecodeWith CerealJson (CerealLimits 1 4 1) "null")))))
      (set bad (+ bad (check "input byte refusal" (isErr (cerealDecodeWith CerealJson (CerealLimits 1 3 1) "null")))))
      (set bad (+ bad (check "output byte boundary" (isOk (cerealEncodeWith CerealJson (CerealLimits 1 4 1) CNull)))))
      (set bad (+ bad (check "output byte refusal" (isErr (cerealEncodeWith CerealJson (CerealLimits 1 3 1) CNull)))))
      (set bad (+ bad (check "node boundary" (isOk (cerealDecodeWith CerealJson (CerealLimits 1 100 2) "[1]")))))
      (set bad (+ bad (check "node refusal" (isErr (cerealDecodeWith CerealJson (CerealLimits 1 100 1) "[1]")))))
      (set bad (+ bad (check "depth boundary" (isOk (cerealDecodeWith CerealJson (CerealLimits 1 100 3) "[1]")))))
      (set bad (+ bad (check "depth refusal" (isErr (cerealDecodeWith CerealJson (CerealLimits 1 100 3) "[[1]]")))))
      (set bad (+ bad (check "toml path depth" (isErr (cerealDecodeWith CerealToml (CerealLimits 1 100 10) "a.b = 1")))))
      (set bad (+ bad (check "invalid limits" (isErr (cerealDecodeWith CerealJson (CerealLimits 0 100 10) "null")))))
      (set bad (+ bad (check "typed limit" (isErr (cerealSerializeWith CerealJson (CerealLimits 1 3 10) cerealTextCodec "abc")))))
      (println "failures: {bad}")
      bad
    }))
