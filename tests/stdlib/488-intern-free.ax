; Interner scope exit releases its retained string shares.
(import IO)
(import Intern)
(import Str)

(:: refs (-> String Int))
;@axiom:effect(unsafe)
(fn (refs value)
  (__load64 (as value Int) -2))

(:: eqInt (-> String Int Int Int))
;@axiom:effect(io)
(fn (eqInt name got want)
  (if (== got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let mut bad 0)
    (let mut n 0)
    (let alpha (strDup "alpha"))
    (let before (refs alpha))
    {
      {
        (let it (internNew))
        {
          (set bad (+ bad (eqInt "first id" (internIntern it alpha) 0)))
          (set bad (+ bad (eqInt "second id" (internIntern it "beta") 1)))
          (set bad (+ bad (eqInt "count before scope exit" (internCount it) 2)))
          (set n (+ n 3))
        }
      }
      (set bad (+ bad (eqInt "first scope releases string" (refs alpha) before)))
      (set n (+ n 1))
      {
        (let it2 (internNew))
        {
          (set bad (+ bad (eqInt "fresh first id" (internIntern it2 alpha) 0)))
          (set bad (+ bad (eqInt "fresh count" (internCount it2) 1)))
          (set n (+ n 2))
        }
      }
      (set bad (+ bad (eqInt "second scope releases string" (refs alpha) before)))
      (set n (+ n 1))
      (println "checks {n}")
      (println "failures {bad}")
      bad
    }
  })
