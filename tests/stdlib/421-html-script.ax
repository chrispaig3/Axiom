; `</script>` and `</style>` inside inline JS and CSS come out
; neutralised, and the fixture cannot pass by escaping everything.
;
; `(script b js)` and `(style b css)` write their string verbatim
; except that every `</` becomes `<\/` - the one rewrite that keeps a
; closing tag from ending the element early, and one that changes the
; meaning of nothing inside a JS string, a regex, a comment or a CSS
; string. It is a RUN-TIME rewrite: a macro cannot read a literal's
; bytes at expansion (docs/macro-system.md MAC-LANG-13), so
; `stdlib/Html.ax` cannot refuse `"</script>"` at `check`, and this
; fixture is where the guarantee lives instead.
;
; Four checks decide it and two are controls: a `<script>` inside
; `text` is ESCAPED (the XSS shape), and a `<script>` inside `raw` is
; VERBATIM - so a builder that escaped everything would fail the raw
; check, and one that escaped nothing would fail the text check. A
; string with no `</` in it is answered unchanged, with `<`, `>` and
; `&` all present, because JS and CSS are full of them.
(import IO)

(import Str)

(import Html)

(:: eq (-> String String String Int))

;@axiom:effect(io)
(fn (eq name got want)
  (if (strEq got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }
  )
)

(macro (rendered b body) (let ((b hNew))
  {
    body
    (hFinish b)
  }
))

(:: main Int)

;@axiom:effect(io)
(fn (main)
  {
    (eq "</script> inside script is neutralised" (rendered b (script b "document.title = '</script> is fine here';")) "<script>document.title = '<\\/script> is fine here';</script>")
    (eq "</style> inside style is neutralised" (rendered b (style b ".x{content:'</style>'}")) "<style>.x{content:'<\\/style>'}</style>")
    (eq "every </ is rewritten, the last one too" (rendered b (script b "a</b</")) "<script>a<\\/b<\\/</script>")
    (eq "JS operators are verbatim and only its </ moves" (rendered b (script b "if (a < b && c > d) { x = '</' + 'div>'; }")) "<script>if (a < b && c > d) { x = '<\\/' + 'div>'; }</script>")
    (eq "CSS with no </ is verbatim" (rendered b (style b "a > b { margin: 0 }")) "<style>a > b { margin: 0 }</style>")
    (eq "<script> inside text is escaped" (rendered b (p b (text b "<script>alert(1)</script>"))) "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>")
    (eq "<script> inside raw is verbatim" (rendered b (raw b "<script>x</script>")) "<script>x</script>")
    (eq "an external script is attributes and an empty element" (rendered b (scriptA b (src b "/static/app.js"))) "<script src=\"/static/app.js\"></script>")
    0
  }
)
