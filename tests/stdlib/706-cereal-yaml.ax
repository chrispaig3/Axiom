; expect 0
; YAML decoding through Cereal: documents, scalars, nesting and refusals.
(import Cereal)
(import Err)
(import Str)
(import IO)
; YAML focused codec checks.
(:: yamlCheck (-> String Bool Int))
;@axiom:effect(io)
(fn (yamlCheck label valid)
  (if valid 0 { (println "YAML failed: {label}") 1 }))

(:: yamlJson (-> String String String Int))
;@axiom:effect(io)
(fn (yamlJson label source expected)
  (match (cerealDecode CerealYaml source)
    ((Err error) (let ((message error.message)) { (println "YAML failed: {label}: {message}") 1 }))
    ((Ok value)
      (match (cerealEncode CerealJson value)
        ((Err error) (let ((message error.message)) { (println "YAML failed: {label}: {message}") 1 }))
        ((Ok encoded) (yamlCheck label (strEq encoded expected)))))))

(:: yamlRefused (-> String String Int))
;@axiom:effect(io)
(fn (yamlRefused label source)
  (yamlCheck label (isErr (cerealDecode CerealYaml source))))

(:: yamlRoundTrip (-> String Int))
;@axiom:effect(io)
(fn (yamlRoundTrip source)
  (match (cerealDecode CerealYaml source)
    ((Err error) (yamlCheck "roundtrip decode" false))
    ((Ok value)
      (match (cerealEncode CerealYaml value)
        ((Err error) (yamlCheck "roundtrip encode" false))
        ((Ok encoded)
          (match (cerealDecode CerealYaml encoded)
            ((Err error) (yamlCheck "roundtrip redecode" false))
            ((Ok again)
              (match (cerealEncode CerealJson value)
                ((Err error) (yamlCheck "roundtrip first canonical" false))
                ((Ok first)
                  (match (cerealEncode CerealJson again)
                    ((Err error) (yamlCheck "roundtrip second canonical" false))
                    ((Ok second) (yamlCheck "roundtrip values" (strEq first second)))))))))))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((mut failures 0))
    {
      (set failures (+ failures (yamlJson "empty" "" "null")))
      (set failures (+ failures (yamlJson "comments" "# hi\n # bye\n" "null")))
      (set failures (+ failures (yamlJson "null" "Null" "null")))
      (set failures (+ failures (yamlJson "tilde" "~" "null")))
      (set failures (+ failures (yamlJson "core true" "TRUE" "true")))
      (set failures (+ failures (yamlJson "core false" "False" "false")))
      (set failures (+ failures (yamlJson "yes is string" "yes" "\"yes\"")))
      (set failures (+ failures (yamlJson "on is string" "on" "\"on\"")))
      (set failures (+ failures (yamlJson "integer" "-42" "-42")))
      (set failures (+ failures (yamlJson "fraction" "1.20e+3" "1.20e+3")))
      (set failures (+ failures (yamlJson "wide integer" "9223372036854775808" "9223372036854775808")))
      (set failures (+ failures (yamlJson "negative zero" "-0" "0")))
      (set failures (+ failures (yamlJson "plain Unicode" "雪" "\"雪\"")))
      (set failures (+ failures (yamlJson "plain URL" "https://example.test/a" "\"https://example.test/a\"")))
      (set failures (+ failures (yamlJson "version string" "1.2.3" "\"1.2.3\"")))
      (set failures (+ failures (yamlJson "plain apostrophe comment" "can't # gone" "\"can't\"")))
      (set failures (+ failures (yamlJson "single quote" "'it''s fine'" "\"it's fine\"")))
      (set failures (+ failures (yamlJson "quoted hash" "'# keep' # gone" "\"# keep\"")))
      (set failures (+ failures (yamlJson "JSON quote" "\"line\\nnext\"" "\"line\\nnext\"")))
      (set failures (+ failures (yamlJson "empty quoted" "''" "\"\"")))
      (set failures (+ failures (yamlJson "block mapping" "name: Axiom\nenabled: true\ncount: 3\n" "{\"name\":\"Axiom\",\"enabled\":true,\"count\":3}")))
      (set failures (+ failures (yamlJson "nested sequence" "service:\n  ports:\n    - 80\n    - 443\n" "{\"service\":{\"ports\":[80,443]}}")))
      (set failures (+ failures (yamlJson "compact records" "- name: alpha\n  enabled: true\n- name: beta\n  enabled: false\n" "[{\"name\":\"alpha\",\"enabled\":true},{\"name\":\"beta\",\"enabled\":false}]")))
      (set failures (+ failures (yamlJson "compact sequences" "- - 1\n  - 2\n- - 3\n  - 4\n" "[[1,2],[3,4]]")))
      (set failures (+ failures (yamlJson "null entries" "empty:\nitems:\n  -\n  - null\n" "{\"empty\":null,\"items\":[null,null]}")))
      (set failures (+ failures (yamlJson "quoted keys" "\"true\": 2\n'': x\n" "{\"true\":2,\"\":\"x\"}")))
      (set failures (+ failures (yamlJson "flow values" "array: [1, \"two\", false]\nobject: {\"x\": 1}\n" "{\"array\":[1,\"two\",false],\"object\":{\"x\":1}}")))
      (set failures (+ failures (yamlJson "flow comment" "[1,2] # gone" "[1,2]")))
      (set failures (+ failures (yamlJson "multiline root flow" "[\n  1,\n  {\"a\": true}\n]\n" "[1,{\"a\":true}]")))
      (set failures (+ failures (yamlJson "markers" "---\na: 1\n...\n" "{\"a\":1}")))
      (set failures (+ failures (yamlJson "CRLF" "a: 1\r\nb: two\r\n" "{\"a\":1,\"b\":\"two\"}")))
      (set failures (+ failures (yamlJson "literal merge name" "\"<<\": \"text\"" "{\"<<\":\"text\"}")))
      (set failures (+ failures (yamlJson "BOM" "﻿name: axiom\n" "{\"name\":\"axiom\"}")))
      (set failures (+ failures (yamlRefused "duplicate block" "a: 1\na: 2")))
      (set failures (+ failures (yamlRefused "duplicate flow" "{\"a\":1,\"a\":2}")))
      (set failures (+ failures (yamlRefused "duplicate nested flow" "a: [{\"x\":1,\"x\":2}]")))
      (set failures (+ failures (yamlRefused "tab indentation" "a:\n\tb: 1")))
      (set failures (+ failures (yamlRefused "bad dedent" "a:\n  b: 1\n c: 2")))
      (set failures (+ failures (yamlRefused "root indentation" "  a: 1")))
      (set failures (+ failures (yamlRefused "indent after scalar" "a: 1\n  b: 2")))
      (set failures (+ failures (yamlRefused "mixed collection" "- item\nkey: value")))
      (set failures (+ failures (yamlRefused "extra scalar" "hello\nworld")))
      (set failures (+ failures (yamlRefused "anchor" "a: &saved 1")))
      (set failures (+ failures (yamlRefused "alias" "a: *saved")))
      (set failures (+ failures (yamlRefused "tag" "a: !!str 1")))
      (set failures (+ failures (yamlRefused "merge key" "<<: {\"a\":1}")))
      (set failures (+ failures (yamlRefused "block scalar" "a: |\n  text")))
      (set failures (+ failures (yamlRefused "folded scalar" "a: >-\n  text")))
      (set failures (+ failures (yamlRefused "directives" "%YAML 1.2\n---\na: 1")))
      (set failures (+ failures (yamlRefused "multiple docs" "---\na: 1\n---\nb: 2")))
      (set failures (+ failures (yamlRefused "after doc end" "a: 1\n...\nb: 2")))
      (set failures (+ failures (yamlRefused "inline marker" "--- a: 1")))
      (set failures (+ failures (yamlRefused "integer key" "1: a")))
      (set failures (+ failures (yamlRefused "boolean key" "true: a")))
      (set failures (+ failures (yamlRefused "complex key" "? [a, b]\n: value")))
      (set failures (+ failures (yamlRefused "unterminated single" "a: 'broken")))
      (set failures (+ failures (yamlRefused "unterminated double" "a: \"broken")))
      (set failures (+ failures (yamlRefused "unsupported escape" "a: \"\\N\"")))
      (set failures (+ failures (yamlRefused "nested multiline flow" "a: [\n  1\n]")))
      (set failures (+ failures (yamlRefused "compact spaces" "-   name: a")))
      (set failures (+ failures (yamlRefused "hex number" "a: 0x2a")))
      (set failures (+ failures (yamlRefused "octal number" "a: 0o7")))
      (set failures (+ failures (yamlRefused "infinity" "a: .inf")))
      (set failures (+ failures (yamlRefused "leading zero" "a: 01")))
      (set failures (+ failures (yamlRefused "plus number" "a: +1")))
      (set failures (+ failures (yamlRefused "trailing dot" "a: 1.")))
      (set failures (+ failures (yamlRefused "leading dot" "a: .5")))
      (set failures (+ failures (yamlRefused "nonprintable" (concat "a: " (strFromByte 1)))))
      (set failures (+ failures (yamlRefused "raw DEL" "a: ")))
      (set failures (+ failures (yamlRoundTrip "a: 1\nb:\n  - true\n  - 'it''s fine'\nc: 1.20e+3\n")))
      (set failures (+ failures (yamlRoundTrip "null")))
      (set failures (+ failures (yamlRoundTrip "[\"~\",\"yes\",null,9223372036854775808]")))
      (set failures (+ failures (yamlCheck "depth boundary" (isOk (cerealDecodeWith CerealYaml (CerealLimits 1 100 10) "a: 1")))))
      (set failures (+ failures (yamlCheck "depth refusal" (isErr (cerealDecodeWith CerealYaml (CerealLimits 1 100 10) "a:\n  b: 1")))))
      (set failures (+ failures (yamlCheck "node boundary" (isOk (cerealDecodeWith CerealYaml (CerealLimits 2 100 2) "a: 1")))))
      (set failures (+ failures (yamlCheck "node refusal" (isErr (cerealDecodeWith CerealYaml (CerealLimits 2 100 1) "a: 1")))))
      (set failures (+ failures (yamlCheck "combined flow nodes" (isErr (cerealDecodeWith CerealYaml (CerealLimits 3 100 3) "a: [1,2]")))))
      (set failures (+ failures (yamlCheck "combined flow depth" (isErr (cerealDecodeWith CerealYaml (CerealLimits 1 100 10) "a: [1]")))))
      (set failures (+ failures (yamlCheck "input byte boundary" (isOk (cerealDecodeWith CerealYaml (CerealLimits 2 4 2) "a: 1")))))
      (set failures (+ failures (yamlCheck "input byte refusal" (isErr (cerealDecodeWith CerealYaml (CerealLimits 2 3 2) "a: 1")))))
      (set failures (+ failures (yamlCheck "invalid limits" (isErr (cerealDecodeWith CerealYaml (CerealLimits 0 100 10) "a: 1")))))
      (set failures (+ failures (yamlCheck "output byte refusal" (isErr (cerealEncodeWith CerealYaml (CerealLimits 2 4 10) (CText "longer"))))))
      (set failures (+ failures (yamlRefused "malformed UTF8" (strFromByte 255))))
      (println "YAML failures: {failures}")
      failures
    }))
