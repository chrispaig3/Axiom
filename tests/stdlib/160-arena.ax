; The explicit arena primitives: `__axiom_arena_mark` and
; `__axiom_arena_reset`.
;
; These are the only arena controls Axiom has, and they carry a contract
; the compiler cannot check: after a reset, nothing allocated since the
; matching mark may be read again. Nothing traces, copies, or keeps
; anything. A caller who cannot prove that precondition should not use
; them - see docs/self-hosting.md §2.2 S1 for why the compiler does not
; insert them on its own.
;
; Both were broken. `(__axiom_arena_mark)` is a bare variable reference
; rather than an application, so it never reached the primitive lowering
; at all and emitted an undefined value that `opt` rejected - it had
; never worked. And a mark is the whole allocator position, not just the
; waterline: restoring the bump pointer while leaving the chunk end
; describing a newer chunk let the allocator hand back an address in
; neither, and a mark taken before the first chunk existed produced a
; null pointer.
(import IO)
(import Mem)

; Fill enough memory to force the allocator past a 1 MiB chunk, so the
; reset below has to restore a position from a *different* chunk than the
; one in use when it runs.
(pub :: burn (-> Int Int))
(pub fn (burn n)
  (if (<= n 0)
      0
      {
        (memAlloc 65536)
        (burn (- n 1))
      }))

; Write a word and read it back, so a returned address is shown to be
; usable memory and not merely a plausible-looking number.
(pub :: usable (-> Int Int))
(pub fn (usable p)
  {
    (memSetWord p 0 987654321)
    (memGetWord p 0)
  })

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  (let ((m (__axiom_arena_mark))
        (a (memAlloc 64))
        (b (memAlloc 64))
        (afterAlloc (memAlloc 0)))
    {
      (printlnInt (if (> afterAlloc a) 1 0))   ; 1: allocation advances the waterline
      (printlnInt (- b a))                     ; 64: blocks are contiguous

      ; --- reset reclaims, and the next allocation reuses the space ---
      (__axiom_arena_reset m)
      (printlnInt (if (== (memAlloc 64) a) 1 0))  ; 1

      ; --- nesting: an inner mark/reset leaves the outer one intact ---
      (printlnInt
        (let ((outer (__axiom_arena_mark))
              (p (memAlloc 64))
              (inner (__axiom_arena_mark))
              (q (memAlloc 64))
              (r0 (__axiom_arena_reset inner))
              (q2 (memAlloc 64))
              (r1 (__axiom_arena_reset outer))
              (p2 (memAlloc 64)))
          (if (&& (== q2 q) (== p2 p)) 1 0)))    ; 1

      ; --- a reset across a chunk boundary must still yield usable memory ---
      (printlnInt
        (let ((far (__axiom_arena_mark))
              (junk (burn 40))                   ; > 1 MiB, so the chunk changes
              (r2 (__axiom_arena_reset far))
              (fresh (memAlloc 64)))
          (usable fresh)))                       ; 987654321
      0
    }))
