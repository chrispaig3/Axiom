; Readiness, end to end, through whichever mechanism the target has.
;
; This is the case that says a server can wait on many descriptors at
; once instead of blocking on one. It runs against kqueue on Darwin and
; epoll on Linux without knowing which, because that is the property
; `Sys.ax`'s poll layer claims.
;
; TWO LISTENERS, NOT ONE, AND THAT IS THE POINT OF THE CASE. A single
; event only proves the OFFSET the descriptor sits at. The STRIDE
; between records is a separate number and is the one that diverges most
; dangerously: `struct epoll_event` is declared packed on x86_64 and not
; on aarch64, so it is 12 bytes there and 16 here, and `struct kevent`
; is 32. An implementation that used the wrong stride reads every event
; after the first out of the middle of the one before it - and answers a
; plausible descriptor rather than failing, so nothing but a second
; event catches it.
;
; NO EXTERNAL CLIENT: the process connects to its own listeners, the way
; `307-socket-roundtrip.ax` does, so there is no second process to flake
; on and no port coordination beyond the pid.
;
; THE GOLDEN IS PLATFORM-INDEPENDENT, which forbids printing any of the
; three numbers underneath - `pollEventSize`, `pollEventFdOffset` and
; `pollReadFilter` all differ by target. What is asserted is that a
; descriptor put in comes back out, which is true on every target and
; false for every wrong layout.
(import IO)

(import Sys)

(import Err)

(import Mem)

(:: say (-> Int String Int))

;@axiom:effect(io)
(fn (say okFlag label)
  (if (== okFlag 1)
    (printlnLit (strCStr (strConcat "ok   " label)))
    (printlnLit (strCStr (strConcat "FAIL " label)))
  )
)

; A bound, listening, non-blocking socket on `port`, or a negative.
(:: listenOn (-> Int Int Int Int))

;@axiom:effect(io)
(fn (listenOn addr optb port)
  (let ((fd netSocketTcp))
    (if (< fd 0)
      fd
      {
        (netSetOptInt
          fd          solSocket          soReuseAddr          1          optb
        )
        (netAddr4
          addr          port          127          0          0          1
        )
        (if (isErr (netBind fd addr))
          (- 0 1)
          (if (isErr (netListen fd 16))
            (- 0 1)
            {
              (netSetNonBlocking fd)
              fd
            }
          )
        )
      }
    )
  )
)

; Whether `fd` is among the `n` events in `buf`.
(:: hasFd (-> Int Int Int Int))

(fn (hasFd buf n fd)
  (let ((mut i 0))
    (let ((mut found 0))
      {
        (while (< i n)
          {
            (if (== (netPollFdAt buf i) fd)
              (set found 1)
              0
            )
            (set i (+ i 1))
          })
        found
      }
    )
  )
)

(:: main Int)

;@axiom:effect(io)
(fn (main)
  (let ((base (+ 20000 (% sysGetPid 9000))))
    (let ((addr (memAlloc 16)))
      (let (
        (rec (memAlloc 64))
        (ts (memAlloc 16))
        (optb (memAlloc 4))
      )
        (let ((buf (memAlloc (netPollBufBytes 8))))
          (let ((la (listenOn addr optb base)))
            (let ((lb (listenOn addr optb (+ base 1))))
              (let ((pfd netPollCreate))
                {
                  (say
                    (if (> la 2)
                      (if (> lb 2)
                        1
                        0
                      )
                      0
                    )                    "two listeners are bound"
                  )
                  (say
                    (if (> pfd 2)
                      1
                      0
                    )                    "the readiness descriptor is created"
                  )
                  (say
                    (if (isOk (netPollAddRead pfd la rec))
                      (if (isOk (netPollAddRead pfd lb rec))
                        1
                        0
                      )
                      0
                    )                    "both listeners are registered for read"
                  )
                  ; Nothing has connected, so a zero timeout must answer
                  ; zero events rather than blocking or erroring.
                  (say
                    (if (== (netPollWait
                      pfd                      buf                      8                      0                      ts
                    ) 0)
                      1
                      0
                    )                    "polling with nothing pending answers no events"
                  )
                  ; Connect to the FIRST listener only, so the event that
                  ; comes back has to name that one and not merely "a
                  ; descriptor we registered".
                  (let ((ca netSocketTcp))
                    {
                      (netAddr4
                        addr                        base                        127                        0                        0                        1
                      )
                      (netConnect ca addr)
                      (let ((n (netPollWait
                        pfd                        buf                        8                        2000                        ts
                      )))
                        {
                          (say
                            (if (== n 1)
                              1
                              0
                            )                            "one connection wakes exactly one event"
                          )
                          (say
                            (if (== (netPollFdAt buf 0) la)
                              1
                              0
                            )                            "the event names the listener that was connected to"
                          )
                        }
                      )
                      ; TAKE THE CONNECTION BEFORE GOING ON. A listening
                      ; socket stays readable until its pending
                      ; connection is accepted, and this case was
                      ; FLAKY for exactly that reason before it was
                      ; written this way: it connected to the second
                      ; listener and waited again while the FIRST was
                      ; still ready, so the wait returned at once with
                      ; the stale event and the second connection had
                      ; not necessarily landed. It passed under light
                      ; load and failed under the full battery, which is
                      ; the worst way for a gate to be wrong.
                      (let ((acc (netAccept la)))
                        (sysCloseFd acc)
                      )
                      ; NOW BOTH AT ONCE, and this is the shape the
                      ; stride needs.
                      ;
                      ; THIS USED TO CLAIM DETERMINISM AND THE CLAIM WAS
                      ; FALSE. It read: "a loopback connect returns once
                      ; the listener has the connection - so two
                      ; descriptors are ready and the wait answers two
                      ; events deterministically rather than racing."
                      ; Measured 2026-08-24: both assertions below
                      ; failed together during a battery run, and passed
                      ; 8 times out of 8 alone. A connect returning says
                      ; the connection is QUEUED on the listener; it
                      ; does not say the poll set has already been
                      ; updated, and nothing makes one wake carry both.
                      ; The comment two paragraphs up already records
                      ; the FIRST race here being found the same way -
                      ; "it passed under light load and failed under the
                      ; full battery, which is the worst way for a gate
                      ; to be wrong" - and this is the second one,
                      ; asserted away in prose rather than removed.
                      ;
                      ; The retry is sound rather than a weakening, and
                      ; the reason is level-triggering: neither backend
                      ; asks for EV_CLEAR or EPOLLET, and NEITHER
                      ; CONNECTION IS ACCEPTED here, so both listeners
                      ; STAY readable and a repeated wait converges on
                      ; two. What the gate asserts is unchanged - two
                      ; events in ONE buffer, which is the only thing
                      ; that exercises the stride - and it no longer
                      ; depends on the kernel coalescing them.
                      ;
                      ; One event only exercises the OFFSET a descriptor
                      ; sits at. The STRIDE between records is a
                      ; separate number, and reading event 1 out of the
                      ; middle of event 0 answers a plausible descriptor
                      ; rather than failing - so only a second event
                      ; catches it.
                      (let ((cb netSocketTcp))
                        (let ((cc netSocketTcp))
                          {
                            (netAddr4
                              addr                              base                              127                              0                              0                              1
                            )
                            (netConnect cb addr)
                            (netAddr4
                              addr                              (+ base 1)                              127                              0                              0                              1
                            )
                            (netConnect cc addr)
                            (let (
                              (mut n2 (netPollWait
                                pfd                                buf                                8                                2000                                ts
                              ))
                              (mut tries 0)
                            )
                              {
                                (while (&& (< n2 2) (< tries 50))
                                  {
                                    (set n2 (netPollWait
                                      pfd                                      buf                                      8                                      2000                                      ts
                                    ))
                                    (set tries (+ tries 1))
                                  })
                                (say
                                  (if (== n2 2)
                                    1
                                    0
                                  )                                  "two ready listeners wake two events"
                                )
                                (say
                                  (if (== (hasFd buf n2 la) 1)
                                    (if (== (hasFd buf n2 lb) 1)
                                      1
                                      0
                                    )
                                    0
                                  )                                  "both events decode at the right stride"
                                )
                              }
                            )
                            (sysCloseFd cc)
                            (sysCloseFd cb)
                          }
                        )
                      )
                      (sysCloseFd ca)
                    }
                  )
                  (say
                    (if (isOk (netPollDelRead pfd la rec))
                      1
                      0
                    )                    "a listener can be unregistered"
                  )
                  (sysCloseFd la)
                  (sysCloseFd lb)
                  (say
                    (if (isOk (sysCloseFd pfd))
                      1
                      0
                    )                    "the readiness descriptor closes"
                  )
                  0
                }
              )
            )
          )
        )
      )
    )
  )
)
