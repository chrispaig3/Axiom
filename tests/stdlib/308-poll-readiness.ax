; Readiness, end to end, through whichever mechanism the target has.
;
; This is the case that says a server can wait on many sockets at once
; instead of blocking on one. It runs against kqueue on Darwin and epoll
; on Linux without knowing which, because that is the property `IO`'s
; `Poller` claims.
;
; TWO LISTENERS, NOT ONE, AND THAT IS THE POINT OF THE CASE. A single
; event only proves the OFFSET the token sits at. The STRIDE between
; records is a separate number and is the one that diverges most
; dangerously: `struct epoll_event` is declared packed on x86_64 and not
; on aarch64, so it is 12 bytes there and 16 here, and `struct kevent`
; is 32. An implementation that used the wrong stride reads every event
; after the first out of the middle of the one before it - and answers a
; plausible token rather than failing, so nothing but a second event
; catches it.
;
; NO EXTERNAL CLIENT: the process connects to its own listeners, the way
; `307-socket-roundtrip.ax` does, so there is no second process to flake
; on and no port coordination beyond the pid.
;
; THE GOLDEN IS PLATFORM-INDEPENDENT: what is asserted is that the token
; a listener was added under comes back out, which is true on every
; target and false for every wrong layout.
(import IO)
(import Sys)
(import Err)
(import Net)
(import Vec)

(:: say (-> Bool String Int))
;@axiom:effect(io)
(fn (say good label)
  (if good
    (println (concat "ok   " label))
    (println (concat "FAIL " label))))

(:: loopback (-> Int SocketAddr))
;@axiom:effect(io)
(fn (loopback port)
  (match (socketAddrV4 127 0 0 1 port)
    ((Ok a) a)
    ((Err e) (todo "a loopback address"))))

; A listening, non-blocking socket on `port`.
(:: listenOn (-> Int (Result TcpListener Error)))
;@axiom:effect(io)
(fn (listenOn port)
  (try lsn (tcpListen (loopback port))
    (try _ (tcpListenerSetNonBlocking lsn true)
      (Ok lsn))))

; Whether `token` is among the `n` events of the last wait.
(:: hasToken (-> Poller Int Int Bool))
(fn (hasToken p n token)
  (let (
    (mut i 0)
    (mut found false)
  )
    {
      (while (< i n)
        {
          (if (== (pollerToken p i) token)
            {
              (set found true)
              0
            }
            0)
          (set i (+ i 1))
        })
      found
    }))

(:: waitCount (-> Poller Int Int))
;@axiom:effect(io)
(fn (waitCount p timeoutMs)
  (match (pollerWait p timeoutMs)
    ((Ok k) k)
    ((Err e) (- 0 e.code))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((base (+ 20000 (% sysPid 9000))))
    (match (listenOn base)
      ((Err e) (say false "two listeners are bound"))
      ((Ok la)
        (match (listenOn (+ base 1))
          ((Err e) (say false "two listeners are bound"))
          ((Ok lb)
            (match (pollerNew 8)
              ((Err e) (say false "the poller is created"))
              ((Ok p)
                {
                  (say true "two listeners are bound")
                  (say true "the poller is created")
                  (say
                    (&& (isOk (pollerAddListener p la 1)) (isOk (pollerAddListener p lb 2)))
                    "both listeners are registered for read")
                  ; Nothing has connected, so a zero timeout must answer
                  ; zero events rather than blocking or erroring.
                  (say (== (waitCount p 0) 0) "polling with nothing pending answers no events")
                  ; Connect to the FIRST listener only, so the event that
                  ; comes back has to carry that one's token and not merely
                  ; "a token we registered".
                  (match (tcpConnect (loopback base))
                    ((Err e) (say false "a client connects"))
                    ((Ok ca)
                      {
                        (let ((n (waitCount p 2000)))
                          {
                            (say (== n 1) "one connection wakes exactly one event")
                            (say (&& (== n 1) (== (pollerToken p 0) 1)) "the event carries the token of the listener that was connected to")
                          })
                        ; TAKE THE CONNECTION BEFORE GOING ON. A listening
                        ; socket stays readable until its pending connection
                        ; is accepted, so a second wait would answer the stale
                        ; event at once.
                        (match (tcpAccept la)
                          ((Ok acc) (let ((_ (tcpClose acc))) 0))
                          ((Err e) 0))
                        ; NOW BOTH AT ONCE, and this is the shape the stride
                        ; needs. A connect returning says the connection is
                        ; queued, not that the poll set is updated, so the
                        ; wait repeats until both listeners are ready. That
                        ; converges because both backends are
                        ; level-triggered and neither connection is accepted.
                        (match (tcpConnect (loopback base))
                          ((Err e) (say false "a client connects"))
                          ((Ok cb)
                            (match (tcpConnect (loopback (+ base 1)))
                              ((Err e) (say false "a client connects"))
                              ((Ok cc)
                                (let (
                                  (mut n2 (waitCount p 2000))
                                  (mut tries 0)
                                )
                                  {
                                    (while (&& (< n2 2) (< tries 50))
                                      {
                                        (set n2 (waitCount p 2000))
                                        (set tries (+ tries 1))
                                      })
                                    (say (== n2 2) "two ready listeners wake two events")
                                    (say
                                      (&& (== n2 2) (&& (hasToken p n2 1) (hasToken p n2 2)))
                                      "both events decode at the right stride")
                                    (let ((_ (tcpClose cc)) (_ (tcpClose cb))) 0)
                                  })))))
                        (let ((_ (tcpClose ca))) 0)
                      }))
                  (say (isOk (pollerRemoveListener p la)) "a listener can be unregistered")
                  (let ((_ (tcpListenerClose la)) (_ (tcpListenerClose lb))) 0)
                  (say (isOk (pollerClose p)) "the poller closes")
                  0
                }))))))))
