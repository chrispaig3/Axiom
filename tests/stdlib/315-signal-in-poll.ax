; A signal and a socket, on ONE event loop.
;
; This is the case that says a server can shut down cleanly: it hears
; SIGTERM the same way it hears a connection, in the same wait, and can
; tell the two apart. Without it a service either polls with a timeout
; and hopes, or installs a handler - and a handler is not available,
; because an Axiom function is `i64(i64...)` and cannot have the shape
; `void(int, siginfo_t*, void*)` that a signal handler needs.
;
; THE TWO PLATFORMS DELIVER A SIGNAL DIFFERENTLY AND THIS CASE RUNS
; AGAINST BOTH WITHOUT KNOWING WHICH. Darwin registers `EVFILT_SIGNAL`
; on the same kqueue as the sockets, and the event carries the signal
; number in `ident`. Linux makes the signal a readable descriptor of its
; own, which the poller owns and watches, and answers a 128-byte record
; when it is read. `pollerSignal` is the one function that knows the
; difference, so it is the one under test.
;
; BOTH DIRECTIONS ARE ASSERTED, and the negative one is the half that is
; easy to leave out: a SOCKET event must be reported as NOT a signal.
; An implementation that answered "signal" for everything would satisfy
; the positive case alone, and a server built on it would shut down on
; its first connection.
;
; THE CONNECTION IS ACCEPTED BEFORE THE SIGNAL IS RAISED. A listening
; socket stays readable until its pending connection is taken, so
; leaving it would make the next wait answer two events and the case
; would be asserting something other than what it says.
;
; The golden is platform-independent. SIGTERM is named rather than
; written as 15 because only it and SIGINT agree across every target.
; `setbuf` is 16 bytes because that is the widest `sigset_t` a kernel
; copies out of it (FreeBSD's), per `sysSignalBlock`.
(import IO)
(import Sys)
(import Err)
(import Mem)
(import Net)

(:: say (-> Bool String Int))
;@axiom:effect(io)
(fn (say good label)
  (if good
    (println (concat "ok   " label))
    (println (concat "FAIL " label))))

(:: waitCount (-> Poller Int Int))
;@axiom:effect(io)
(fn (waitCount p timeoutMs)
  (match (pollerWait p timeoutMs)
    ((Ok k) k)
    ((Err e) (- 0 e.code))))

(:: isSignal (-> Poller Int Bool))
;@axiom:effect(io)
(fn (isSignal p i)
  (match (pollerSignal p i)
    ((Some _) true)
    ((None) false)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (port (+ 20000 (% sysPid 9000)))
    (setbuf (memAlloc 16))
  )
    {
      (say (isOk (sysSignalBlock (sysSigBit sigTerm) setbuf)) "SIGTERM is blocked")
      (match (pollerNew 8)
        ((Err e) (say false "the poller is created"))
        ((Ok p)
          (match (socketAddrV4 127 0 0 1 port)
            ((Err e) (say false "the address builds"))
            ((Ok addr)
              (match (tcpListen addr)
                ((Err e) (say false "the listener is watched"))
                ((Ok lsn)
                  {
                    (let ((_ (tcpListenerSetNonBlocking lsn true))) 0)
                    (say (isOk (pollerAddListener p lsn 1)) "the listener is watched")
                    (say (isOk (pollerAddSignals p (sysSigBit sigTerm) 2)) "SIGTERM is watched by the same poller")
                    (say (== (waitCount p 0) 0) "nothing pending wakes nothing")
                    (match (tcpConnect addr)
                      ((Err e) (say false "a client connects"))
                      ((Ok cli)
                        {
                          (let ((n (waitCount p 2000)))
                            {
                              (say (== n 1) "a connection wakes one event")
                              (say (&& (== n 1) (== (pollerToken p 0) 1)) "the event carries the listener's token")
                              (say (&& (== n 1) (! (isSignal p 0))) "a socket event is NOT reported as a signal")
                            })
                          (match (tcpAccept lsn)
                            ((Ok con) (let ((_ (tcpClose con))) 0))
                            ((Err e) 0))
                          (let ((_ (tcpClose cli))) 0)
                        }))
                    (say (isOk (sysKill sysPid sigTerm)) "SIGTERM is raised")
                    (let ((n2 (waitCount p 2000)))
                      {
                        (say (== n2 1) "the signal wakes one event")
                        (say
                          (&& (== n2 1)
                            (match (pollerSignal p 0)
                              ((Some s) (== s sigTerm))
                              ((None) false)))
                          "the event decodes as SIGTERM")
                      })
                    (let ((_ (tcpListenerClose lsn))) 0)
                    0
                  }))))))
      0
    }))
