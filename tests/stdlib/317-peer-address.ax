; `accept` hands back who connected, and this case is the one that
; proves it - in both families, in one process, with the peer's address
; chosen by the test rather than by the kernel.
;
; THE CLIENT BINDS ITS SOURCE PORT BEFORE IT CONNECTS. That is the
; whole trick: a connection made without one gets an ephemeral port
; nobody knows, so a server reporting the peer could return anything
; from the right family and look correct. Binding it makes the expected
; answer a number this file already holds, which is what turns "a call
; returned an address" into "it returned THE address". `Net` connects
; without binding, so the client side is `IO`'s socket calls on a
; `File`, and the server side is `Net`.
;
; NO EXTERNAL CLIENT, for the reason `307-socket-roundtrip.ax` gives:
; a loopback connect lands in the accept queue whether or not it has
; completed, so one process can be both ends.
;
; THE ADDRESS ALWAYS FITS. `tcpPeerAddr` asks the kernel into a buffer
; of `netAddrMaxBytes`, the larger family's size, so no address arrives
; cut short.
;
; THE PORTS COME FROM THE PID so parallel cases do not fight over one
; number, and the golden prints no number at all: the addresses are
; asserted against what this file asked for.
(import IO)
(import Sys)
(import Err)
(import Net)
(import Vec)

(:: say (-> Bool String Int))
;@axiom:effect(io)
(fn (say good label)
  (if good
    (println (concat "ok   " label))
    (println (concat "FAIL " label))))

; A client socket bound to `from` and connected to `to`.
(:: clientFrom (-> SocketAddr SocketAddr (Result File Error)))
;@axiom:effect(io)
(fn (clientFrom from to)
  (try s (socketOpen from.bytes)
    (try _ (socketSetInt s solSocket soReuseAddr 1)
      (try _ (socketBind s from.bytes)
        (try _ (socketConnect s to.bytes)
          (Ok s))))))

; One family, end to end: listen on `server`, connect from `client`, and
; check what the accepted stream says its peer is.
(:: family (-> String SocketAddr SocketAddr String Int))
;@axiom:effect(io)
(fn (family label server client ip)
  (match (tcpListen server)
    ((Err e) (say false (concat label " listener binds")))
    ((Ok lsn)
      {
        (say true (concat label " listener binds"))
        (match (clientFrom client server)
          ((Err e) (say false (concat label " client binds a source port this case chose")))
          ((Ok cli)
            {
              (say true (concat label " client binds a source port this case chose"))
              (match (tcpAccept lsn)
                ((Err e) (say false "tcpAccept answers the connected stream"))
                ((Ok con)
                  {
                    (say true "tcpAccept answers the connected stream")
                    (match (tcpPeerAddr con)
                      ((Err e) (say false "the peer's address is readable"))
                      ((Ok peer)
                        {
                          (say (if (socketAddrIsV6 client) (socketAddrIsV6 peer) (! (socketAddrIsV6 peer))) "the peer's family is the client's")
                          (say (strEq (socketAddrIp peer) ip) (concat "the peer's address is " ip))
                          (say (== (socketAddrPort peer) (socketAddrPort client)) "the peer's port is the source port the client bound")
                          (say (strEq (socketAddrText peer) (socketAddrText client)) "and it reads back as the address the client bound")
                        }))
                    (let ((_ (tcpClose con))) 0)
                  }))
              (let ((_ (fileClose cli))) 0)
            }))
        (let ((_ (tcpListenerClose lsn))) 0)
      })))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((base (+ 20000 (* 4 (% sysPid 2000)))))
    {
      (match (socketAddrV4 127 0 0 1 base)
        ((Err e) (say false "a v4 address builds"))
        ((Ok server)
          (match (socketAddrV4 127 0 0 1 (+ base 1))
            ((Err e) (say false "a v4 address builds"))
            ((Ok client) (family "a v4" server client "127.0.0.1")))))
      (let ((loop6 vecNew))
        {
          (for g in 0..7
            (vecPush loop6 0))
          (vecPush loop6 1)
          (match (socketAddrV6 loop6 (+ base 2))
            ((Err e) (say false "a v6 address builds"))
            ((Ok server)
              (match (socketAddrV6 loop6 (+ base 3))
                ((Err e) (say false "a v6 address builds"))
                ((Ok client) (family "a v6" server client "::1")))))
        })
      0
    }))
