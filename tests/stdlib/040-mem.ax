; Raw memory: allocation, copying, filling, comparison.
(import IO)

(pub :: main Int)

;@axiom:effect(io)
(pub fn (main)
  (let (
    (a (memAlloc 8))
    (b (memAlloc 8))
  )
    {
      (println (memGetByte a 0))
      (memPutByte a 0 65)
      (memPutByte a 1 66)
      (memPutByte a 2 67)
      (println (memGetByte a 2))
      (memCopy b a 3)
      (println (memCmp a b 3))
      (memPutByte b 2 68)
      (println (memCmp a b 3))
      (println (memCmp b a 3))
      (memSet a 0 8)
      (println (memGetByte a 1))
      (memSetWord a 0 123456789)
      (println
        (cast Int (memGetWord a 0))
      )
      (println
        (cast Int (memGetWord a 1))
      )
      0
    }
  )
)
