; exit 255 (see .exit)
; `stdlib/Err.ax` — the failure type, the error record, the checked
; operators, and the propagation form, exercised across a module
; boundary because that is where every one of them will be used from.
;
; The form is the part worth stating plainly: `try!` could not be
; written at all before 2026-08-16. A macro parameter standing in a
; binder position was gensymed like a template's own binder, so
; `(try! v e body)` bound `v.N` and spliced a body that still said `v`
; - AX3001, on the macro whose whole job is to bind it. The expander
; takes the caller's name there now (`expBinderParam`), and term 16
; below is the first program in this repository that depends on it.
;
; Term 2 pins the shape every error-inspecting combinator in `Err` had
; to take, and - since 2026-08-25 - that it no longer has to. A `match`
; binder over a polymorphic scrutinee did not carry its instantiated
; type, so reading `y.code` inside an arm of a `(Result a Error)`
; match was AX3004 `expected struct or data type, found _t206`, and
; handing the binder to a function whose parameter is DECLARED `Error`
; was the way back to the concrete type. `withContext` is still built
; that way - `errContextOf` is public and removing it would break
; anyone who imports it - and term 2 is what would notice if it
; stopped being.
;
; But the limitation itself is GONE, and nothing recorded that.
; `ctorPatEnv` landed 2026-08-21 (`a388fc1`) and instantiates a
; constructor pattern's field types against the scrutinee's, which is
; exactly the resolution `docs/error-model.md` B5 said did not happen;
; B5 was written 2026-08-16 and was true then. Five days later it was
; not, and the sweep of 2026-08-22 that re-checked every claim in
; every document did not catch it, because that sweep resolves the
; fixtures a document NAMES and B5 named none. Term 2 now carries the
; fixture it needed: `reContext` reads `y.code` and `y.message`
; DIRECTLY off the binder and rebuilds the record from them, and the
; term compares its rendered text against the `errContextOf` spelling
; beside it - so it cannot pass by the read merely compiling and
; answering the wrong field.
;
; It went into term 2 rather than a term of its own because an exit
; status is eight bits and this file already spends all eight. A ninth
; term would have read 255 and looked like a pass.
;
; docs/error-model.md called this file the one that "exercises the whole
; surface". It did not: `isOk`, `isErr`, `errMessage`, `errContext`,
; `mapOk`, `remChecked` and `shrChecked` were exported, four of them
; documented, and named by no fixture in the tree - so seven public
; combinators were pinned by nothing. Term 128 is them.
;
;  128  isOk/isErr agree, mapOk maps through, errMessage and
;       errContext read back what mkError and errContextOf wrote, and
;       remChecked and shrChecked raise the codes divChecked does
;   64  divChecked answers Ok, and Err with the right code on zero
;   32  the INT_MIN / -1 guard fires, and shlChecked refuses 64
;   16  try! propagates an error unchanged through a two-step chain
;    8  mapErr converts an error type and andThen sequences
;    4  okOr and toOption convert in both directions
;    2  withContext attaches, errorText renders what it attached, and
;       the same context attached by a DIRECT field read off the match
;       binder renders identically - the shape B5 recorded as refused
;    1  every step above ran
;
; Ablation, run 2026-08-16: revert `expBinderParam`'s pattern-binder
; arm and this file does not compile at all - AX3001 on `a` and `b` at
; the two `try!` sites, which is the diagnostic the fix exists to
; remove.
(import Err)

(import Str)

(:: b2i (-> Bool Int))

(fn (b2i x)
  (if x
    1
    0
  )
)

; a two-step fallible chain written with the form
(:: chain (-> Int (Result Int Error)))

(fn (chain n) (try! a (divChecked 100 n) (try! b (divChecked a 2) (Ok (+ b 1)))))

; Term 256's subject: the polymorphic scrutinee is a PARAMETER, so
; nothing at this site fixes `a` - and the arm still reads three
; fields off `y` and rebuilds the record from them. Every combinator
; in `Err` is written the other way round, through `errContextOf`, so
; without this function the tree contains no program that asks.
(:: reContext (-> (Result a Error) String (Result a Error)))

(fn (reContext r ctx)
  (match r
    ((Ok x) (Ok x))
    ((Err y) (Err (Error y.code y.message ctx)))
  )
)

(:: codeOf (-> (Result Int Error) Int))

(fn (codeOf r)
  (match r
    ((Ok x) 0)
    ((Err e) (errCode e))
  )
)

(:: valueOr (-> (Result Int Error) Int Int))

(fn (valueOr r d)
  (match r
    ((Ok x) x)
    ((Err e) d)
  )
)

; mapErr's target type: a different error type entirely, which is what
; ERR-TYPE-3 leaves in place of a `From` instance
(:: toCode (-> Error Int))

(fn (toCode e) (+ 100 e.code))

(:: double (-> Int (Result Int Error)))

(fn (double n) (Ok (* n 2)))

(:: inc (-> Int Int))

(fn (inc n) (+ n 1))

(:: textOf (-> (Result Int Error) String))

(fn (textOf r)
  (match r
    ((Ok x) "")
    ((Err e) (errorText e))
  )
)

(:: main Int)

(fn (main)
  (let (
    (mut acc 0)
    (mut steps 0)
  )
    {
      (set acc (+ acc (* 128 (b2i (&& (&& (&& (isOk (divChecked 10 2)) (isErr (divChecked 1 0))) (== (valueOr (mapOk (divChecked 10 2) inc) 0) 6)) (&& (&& (strEq (errMessage (mkError 9 "absent")) "absent") (strEq (errContext (errContextOf (mkError 9 "absent") "loading")) "loading")) (&& (&& (== (valueOr (remChecked 10 3) 0) 1) (== (codeOf (remChecked 10 0)) errDivideByZero)) (== (codeOf (shrChecked 1 100)) errShiftTooWide))))))))
      (set steps (+ steps 1))
      (set acc (+ acc (* 64 (b2i (&& (== (valueOr (divChecked 10 2) 0) 5) (== (codeOf (divChecked 10 0)) errDivideByZero))))))
      (set steps (+ steps 1))
      (set acc (+ acc (* 32 (b2i (&& (== (codeOf (divChecked intMin (- 0 1))) errOverflow) (== (codeOf (shlChecked 1 100)) errShiftTooWide))))))
      (set steps (+ steps 1))
      (set acc (+ acc (* 16 (b2i (&& (== (valueOr (chain 10) 0) 6) (== (codeOf (chain 0)) errDivideByZero))))))
      (set steps (+ steps 1))
      (set acc (+
        acc        (*
          8          (b2i
            (&&
              (==
                (match (mapErr (divChecked 1 0) toCode)
                  ((Ok x) 0)
                  ((Err c) c)
                )                101
              )              (== (valueOr (andThen (divChecked 12 3) double) 0) 8)
            )
          )
        )
      ))
      (set steps (+ steps 1))
      (set acc (+
        acc        (*
          4          (b2i
            (&&
              (== (valueOr (okOr (Some 7) (mkError 9 "absent")) 0) 7)              (match (toOption (divChecked 1 0))
                ((Some x) false)
                ((None) true)
              )
            )
          )
        )
      ))
      (set steps (+ steps 1))
      (set acc (+
        acc        (*
          2          (b2i
            (&&
              (strEq (textOf (withContext (divChecked 1 0) "reading the manifest")) "divided by zero while reading the manifest")              (&&
                (== (codeOf (reContext (divChecked 1 0) "reading the manifest")) errDivideByZero)                (strEq (textOf (reContext (divChecked 1 0) "reading the manifest")) (textOf (withContext (divChecked 1 0) "reading the manifest")))
              )
            )
          )
        )
      ))
      (set steps (+ steps 1))
      (if (== steps 7)
        (+ acc 1)
        acc
      )
    }
  )
)
