; `Char` is a machine word, and a `Char`-typed function must say so.
;
; A character literal lowered to an `i8` constant while `Char` maps to
; `i64` everywhere else - in function signatures, in `strByte`'s
; `zext i8 to i64` on the way out of memory, and in `__store8`'s truncate
; on the way back in. Only the literal disagreed, so a function declared
; to return `Char` emitted `ret i8 90` from a function declared `i64`.
;
; The failure mode is the one worth pinning: `axiom check` reported OK,
; and the error then arrived from `opt` as
; `value doesn't match function result type 'i64'` - a native-toolchain
; message about generated code, for a program the compiler had just
; called well-typed. Nothing in the stdlib returned a `Char`, so nothing
; noticed.
(import IO)
(import Str)
(import Mem)

; The case that broke: a `Char` literal returned through a `Char`-typed
; signature.
(pub :: letterZ (-> Int Char))
(pub fn (letterZ _x) 'Z')

; And one that round-trips through memory, so the literal's width has to
; agree with what `strByte` reads back.
(pub :: firstByte (-> String Int))
(pub fn (firstByte s)
  (strByte s 0))

; Build a one-character `Str` from a `Char`, which is what the REPL does
; to print a character result.
(pub :: charToStr (-> Char String))
(pub fn (charToStr c)
  (let ((s (strAlloc 1)))
    {
      (memPutByte (strData s) 0 (cast Int c))
      s
    }))

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  {
    (println (charToStr (letterZ 0)))     ; Z
    (printlnInt (cast Int (letterZ 0)))   ; 90
    (printlnInt (firstByte "abc"))        ; 97
    (println (charToStr 'q'))             ; q
    0
  })
