; Map: rehashing, linear probing, tombstones, and total lookup.
;
; The cases are picked to break a wrong implementation rather than to
; show off a right one:
;
;   - 40 keys go into a table that starts with 8 slots, so four rehashes
;     run and every one of them has to preserve every entry;
;   - three keys that provably share a table index are inserted into a
;     fixed-size table, so the probe run is exercised without a rehash
;     hiding it;
;   - the *middle* of that probe run is then removed, which orphans the
;     third key in any implementation that marks a removed slot empty
;     instead of tombstoned;
;   - a key is overwritten, and `mapLen`/`mapUsed` must not move;
;   - insert/remove is repeated 200 times on one key, which loops forever
;     in an implementation that sizes on live entries instead of on
;     live-plus-tombstones;
;   - a never-inserted key, and keys at the extremes of the signed range.
;
; HOW THE COLLIDING KEYS WERE FOUND. 23, 38 and 46 all satisfy
; `(mapSlotOf k 16) == 0`. They were found by brute force: a
; reimplementation of `mapHash` in a scratch script enumerated k in
; 1..100000, bucketed each by `mapHash(k) % 16`, and took the first
; bucket that three distinct keys landed in; the Axiom `mapHash` was then
; checked to agree with the script on those keys and on 0, -1, 12345 and
; both ends of the signed range. The test prints `mapSlotOf` for all
; three so the collision is asserted by the golden file rather than
; merely claimed here - and note the three *hashes* are 1002742128,
; 2129929472 and 440446832, wildly different, so this is a collision in
; the table index only. That is the case linear probing has to handle,
; and a hash-level collision would not have tested it.
(import IO)
(import Map)

; `Bool` as a printable digit. There is no `printBool`, and adding one
; belongs in `IO`, not in a test.
(:: mtBit (-> Bool Int))
(fn (mtBit b)
  (if b 1 0))

; Insert `k -> k*10` for k in [lo, hi). Recursion, because there is no
; loop and no function value to fold with.
(:: mtInsertRange (-> Int Int Int Int))
(fn (mtInsertRange m lo hi)
  (if (>= lo hi)
      m
      {
        (mapInsert m lo (* lo 10))
        (mtInsertRange m (+ lo 1) hi)
      }))

; Check that every k in [lo, hi) still maps to k*10, returning the count
; of keys that do. A single number that must equal `hi - lo` is a
; stronger assertion than a handful of spot checks, and it localises
; nothing - which is why the spot checks are also kept.
(:: mtCountIntact (-> Int Int Int Int))
(fn (mtCountIntact m lo hi)
  (if (>= lo hi)
      0
      (+ (if (== (mapGet m lo (- 0 1)) (* lo 10)) 1 0)
         (mtCountIntact m (+ lo 1) hi))))

; Insert then immediately remove `key`, `n` times.
;
; This is the workload that distinguishes sizing on `len` from sizing on
; `used`. Each cycle leaves a tombstone; if tombstones were invisible to
; the load factor they would accumulate until no slot was empty, and the
; next `mapFindSlot` would have no stopping condition. The bounded probe
; counter in `mapFindFrom` turns that into a wrong answer rather than a
; hang, so the assertion after this runs is that lookups are still
; *right*, not merely that the program terminated.
(:: mtChurn (-> Int Int Int Int))
(fn (mtChurn m key n)
  (if (<= n 0)
      m
      {
        (mapInsert m key 7)
        (mapRemove m key)
        (mtChurn m key (- n 1))
      }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((m (mapNew))
        (c (mapWithCapacity 8))
        (x (mapNew)))
    {
      ; --- a fresh Map is empty and total ---
      (printlnInt (mapLen m))                       ; 0
      (printlnInt (mapCap m))                       ; 8
      (printlnInt (mapUsed m))                      ; 0
      (printlnInt (mtBit (mapHas m 5)))             ; 0
      (printlnInt (mapGet m 5 (- 0 7)))             ; -7: default returned
      (printlnInt (mapSumKeys m))                   ; 0
      (printlnInt (mapSumVals m))                   ; 0

      ; --- 40 keys through four rehashes: 8 -> 16 -> 32 -> 64 -> 128 ---
      (mtInsertRange m 1 41)
      (printlnInt (mapLen m))                       ; 40
      (printlnInt (mapCap m))                       ; 128
      (printlnInt (mapUsed m))                      ; 40: no tombstones yet
      (printlnInt (mtCountIntact m 1 41))           ; 40: nothing lost
      (printlnInt (mapSumKeys m))                   ; 820 = 1+..+40
      (printlnInt (mapSumVals m))                   ; 8200
      (printlnInt (mapGet m 1 (- 0 1)))             ; 10: first ever inserted
      (printlnInt (mapGet m 40 (- 0 1)))            ; 400: last inserted
      (printlnInt (mapGet m 20 (- 0 1)))            ; 200

      ; --- a key that was never inserted ---
      (printlnInt (mtBit (mapHas m 999)))           ; 0
      (printlnInt (mapGet m 999 (- 0 7)))           ; -7
      (printlnInt (mtBit (mapHas m 0)))             ; 0: 0 is not special
      (printlnInt (mtBit (mapHas m 41)))            ; 0: just past the range

      ; --- overwrite must not change the entry count ---
      (mapInsert m 7 12345)
      (printlnInt (mapLen m))                       ; 40: unchanged
      (printlnInt (mapUsed m))                      ; 40: unchanged
      (printlnInt (mapCap m))                       ; 128: no growth
      (printlnInt (mapGet m 7 (- 0 1)))             ; 12345
      (printlnInt (mapSumVals m))                   ; 8200 - 70 + 12345
      (mapInsert m 7 70)
      (printlnInt (mapLen m))                       ; 40
      (printlnInt (mapSumVals m))                   ; 8200: restored

      ; --- three keys that collide on the table index ---
      (printlnInt (mapCap c))                       ; 16
      (printlnInt (mapSlotOf 23 16))                ; 0
      (printlnInt (mapSlotOf 38 16))                ; 0
      (printlnInt (mapSlotOf 46 16))                ; 0
      (mapInsert c 23 230)
      (mapInsert c 38 380)
      (mapInsert c 46 460)
      (printlnInt (mapLen c))                       ; 3: three entries...
      (printlnInt (mapCap c))                       ; 16: ...no rehash
      (printlnInt (mapGet c 23 (- 0 1)))            ; 230: home slot
      (printlnInt (mapGet c 38 (- 0 1)))            ; 380: one probe on
      (printlnInt (mapGet c 46 (- 0 1)))            ; 460: two probes on
      (printlnInt (mapSumVals c))                   ; 1070

      ; --- removing the middle of the probe run must not orphan the end
      (mapRemove c 38)
      (printlnInt (mapLen c))                       ; 2
      (printlnInt (mapUsed c))                      ; 3: tombstone still held
      (printlnInt (mtBit (mapHas c 38)))            ; 0
      (printlnInt (mapGet c 23 (- 0 1)))            ; 230: before the hole
      (printlnInt (mapGet c 46 (- 0 1)))            ; 460: past the hole
      (printlnInt (mapSumVals c))                   ; 690

      ; --- the tombstone is reused, not leaked ---
      (mapInsert c 38 381)
      (printlnInt (mapLen c))                       ; 3
      (printlnInt (mapUsed c))                      ; 3: reused, not grown
      (printlnInt (mapGet c 38 (- 0 1)))            ; 381
      (printlnInt (mapGet c 46 (- 0 1)))            ; 460: still reachable

      ; --- removing an absent key changes nothing ---
      (mapRemove c 999)
      (printlnInt (mapLen c))                       ; 3
      (printlnInt (mapUsed c))                      ; 3

      ; --- 200 insert/remove cycles on one key ---
      (mtInsertRange x 1 6)
      (mtChurn x 500 200)
      (printlnInt (mapLen x))                       ; 5: churn key is gone
      (printlnInt (mtBit (mapHas x 500)))           ; 0
      (printlnInt (mtCountIntact x 1 6))            ; 5: survivors intact
      (printlnInt (mapSumKeys x))                   ; 15
      (printlnInt (mapSumVals x))                   ; 150

      ; --- the extremes of the signed range are ordinary keys ---
      ; The keys themselves are not printed: `Fmt.fmtInt` misformats
      ; -9223372036854775807 (it prints -9223372036854775808), so a
      ; golden file containing them would be recording that bug.
      (mapInsert x 9223372036854775807 111)
      (mapInsert x (- 0 9223372036854775807) 222)
      (mapInsert x (- 0 1) 333)
      (printlnInt (mapLen x))                       ; 8
      (printlnInt (mapGet x 9223372036854775807 (- 0 1)))   ; 111
      (printlnInt (mapGet x (- 0 9223372036854775807) (- 0 1))) ; 222
      (printlnInt (mapGet x (- 0 1) (- 0 1)))       ; 333
      (printlnInt (mtBit (mapHas x (- 0 2))))       ; 0

      ; --- a Map of Str values, on the uniform-representation claim ---
      (mapInsert x 1000 (strFromLit (__addr "interned")))
      (println (mapGet x 1000 0))                   ; interned
      0
    }))
