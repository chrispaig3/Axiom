; Intern: content-keyed identity, dense ids, and survival across rehashes.
;
; The property that matters, and the one an interner exists for, is that
; two `Str` handles built *separately* from the same bytes get the same
; id. So the same content is interned here four ways - as a literal, as
; `strConcat` of two halves, as a `strSlice` out of an unrelated longer
; string, and as a `strDup` - and all four must return the id the literal
; got, with `internCount` never moving. The test also prints the two
; handles' inequality, so the golden file records that they really were
; different `Int`s and not the same one twice.
;
; The remaining cases are there to break a wrong implementation:
;
;   - "ae", "ah" and "ba" all satisfy `(internSlotOf s 16) == 0`, so in a
;     16-slot table they form a three-long probe run; each is then
;     re-interned to prove the run is walked and not just written;
;   - 100 generated strings force two rehashes, after which every one of
;     the 100 is re-interned and looked up, so a rehash that dropped or
;     duplicated an entry cannot pass;
;   - the empty string is interned, since a zero-length key is the case a
;     hash loop is most likely to get wrong;
;   - ids below 0 and past the end are looked up.
;
; HOW THE COLLIDING STRINGS WERE FOUND. A reimplementation of
; `internHashStr` in a scratch script enumerated every two- and
; three-letter lowercase string, bucketed each by
; `internHashStr(s) % 16`, and took the first bucket with three entries;
; the Axiom `internHashStr` was then checked to agree with the script on
; those three and on "alpha", "beta" and "". The three hashes are
; 872500672, 2022279744 and 1477607168 - entirely different - so this is
; a collision in the table index only, which is what linear probing has
; to survive.
(import IO)

(import Intern)

; `Bool` as a printable digit.
(pub :: itBit (-> Bool Int))

(pub fn (itBit b)
  (if b
    1
    0
  )
)

; The nth generated name: "id0", "id1", ...
;
; Built with `fmtInt` rather than written out because 100 literals would
; not fit in a readable test, and because a generated name is a fresh
; `Str` handle every time it is called - which is exactly the condition
; the re-interning check below needs.
(pub :: itName (-> Int String))

(pub fn (itName n) (strConcat "id" (fmtInt n)))

; Intern "id{lo}" .. "id{hi-1}".
(pub :: itInternRange (-> Int Int Int Int))

(pub fn (itInternRange it lo hi)
  (if (>= lo hi)
    it
    {
      (internIntern it (itName lo))
      (itInternRange it (+ lo 1) hi)
    }
  )
)

; Count the n in [lo, hi) for which re-interning "id{n}" - from a freshly
; built handle - returns the id it was first given, `n`, *and* looking that
; id up gives back equal content. The caller compares the result against
; `hi - lo`, so one lost, duplicated, or misfiled entry out of a hundred
; fails the test.
;
; Two conditions per element, written as nested `Int`-returning `if`s:
; `&&` miscompiles when its operands are comparisons, and a `Bool` may not
; be the value of an `if`. See the note above `Map`'s probe loops.
(pub :: itCountRoundTrip (-> Int Int Int Int))

(pub fn (itCountRoundTrip it lo hi)
  (if (>= lo hi)
    0
    (+
      (if (== (internIntern it (itName lo)) lo)
        (if (strEq (internLookup it lo) (itName lo))
          1
          0
        )
        0
      )      (itCountRoundTrip it (+ lo 1) hi)
    )
  )
)

; The id `internFind` answers, or -1 when it answers `None`.
;
; The fixture keeps PRINTING the old sentinel so that every golden line
; this file already had is byte-identical across the `Option` port. That
; is the point of routing it through here rather than reflowing the
; golden: what moved is the TYPE, and a golden that moved with it would
; make a contract change indistinguishable from a behaviour change.
(pub :: itFound (-> (Option Int) Int))

(pub fn (itFound o)
  (match o
    ((Some id) id)
    ((None) (- 0 1))
  )
)

; Which CONSTRUCTOR came back, as a word.
;
; `itFound` above deliberately cannot tell a miss from a hit that
; answered -1 - it re-encodes both as a number - so on its own it
; asserts exactly as much as the sentinel did. This says the thing the
; port is for, and the two lines it adds are APPENDED to the golden
; rather than folded into it.
(pub :: itShape (-> (Option Int) String))

(pub fn (itShape o)
  (match o
    ((Some _) "some")
    ((None) "none")
  )
)

(pub :: main Int)

;@axiom:effect(io)
(pub fn (main)
  ; --- a fresh interner ---
  (let (
    (it internNew)
    (col (internWithCapacity 8))
    (big internNew)
    (alpha "alpha")
    (built (strConcat "al" "pha"))
    (haystack "not-alpha-either")
  )
    {
      (println (internCount it))  ; 0
      (println (internCap it))  ; 64
      (println (itFound (internFind it alpha)))  ; -1: nothing yet
      (println (strLen (internLookup it 0)))  ; 0: empty, not a crash
      ; --- distinct strings get distinct, dense ids ---
      (println (internIntern it alpha))  ; 0
      (println (internIntern it "beta"))  ; 1
      (println (internIntern it "gamma"))  ; 2
      (println (internCount it))  ; 3
      ; --- THE POINT: equal content, four unrelated handles, one id ---
      ; The handles differ...
      ;
      ; This asks about IDENTITY, and it has to say so. `==` on two
      ; `String`s compares CONTENT (`tests/stdlib/035-string-equality.ax`),
      ; and these two are content-equal by construction - that is the
      ; premise of the whole section. Casting both to `Int` asks the
      ; question this line has always meant: are they the same handle.
      ; Written as `(== alpha built)` it now answers 1, and would be
      ; asserting the opposite of what the comment says.
      (println
        (itBit
          (==
            (cast Int alpha)            (cast Int built)
          )
        )
      )
      ; 0: different Ints
      ; ...but the ids do not.
      (println (internIntern it built))  ; 0
      (println (internIntern it (strSlice haystack 4 5)))  ; 0
      (println (internIntern it (strDup built)))  ; 0
      (println (internIntern it alpha))  ; 0
      (println (internCount it))  ; 3: nothing added
      (println (internCap it))  ; 64: no rehash
      ; --- and a *different* slice of the same haystack does not ---
      (println (internIntern it (strSlice haystack 0 3)))  ; 3: "not"
      (println (internCount it))  ; 4
      ; --- id -> string round trip ---
      (println (internLookup it 0))  ; alpha
      (println (internLookup it 1))  ; beta
      (println (internLookup it 2))  ; gamma
      (println (internLookup it 3))  ; not
      (println (itBit (strEq (internLookup it 0) built)))  ; 1
      ; --- out-of-range ids ---
      (println (strLen (internLookup it 4)))  ; 0: one past the end
      (println (strLen (internLookup it (- 0 1))))  ; 0
      (println (strLen (internLookup it 100000)))  ; 0
      ; --- the empty string is an ordinary key ---
      (println (internIntern it ""))  ; 4
      (println (internCount it))  ; 5
      (println (internIntern it (strSlice haystack 0 0)))  ; 4: again
      (println (internCount it))  ; 5
      (println (strLen (internLookup it 4)))  ; 0: and it is empty
      ; --- a string that was never interned ---
      (println (itFound (internFind it "delta")))  ; -1
      (println (itFound (internFind it "alph")))  ; -1: prefix
      (println (itFound (internFind it "alphaa")))  ; -1: extension
      (println (internCount it))  ; 5: find never adds
      ; --- three strings sharing one table index ---
      (println (internCap col))  ; 16
      (println (internSlotOf "ae" 16))  ; 0
      (println (internSlotOf "ah" 16))  ; 0
      (println (internSlotOf "ba" 16))  ; 0
      (println (internIntern col "ae"))  ; 0
      (println (internIntern col "ah"))  ; 1
      (println (internIntern col "ba"))  ; 2
      (println (internCount col))  ; 3
      (println (internCap col))  ; 16: no rehash yet
      ; Re-intern each, from fresh handles, so the whole probe run is
      ; walked rather than only its first slot.
      (println (internIntern col "ae"))  ; 0
      (println (internIntern col "ah"))  ; 1
      (println (internIntern col "ba"))  ; 2
      (println (internCount col))  ; 3: still three
      (println (internLookup col 2))  ; ba
      ; --- 100 strings, two rehashes: 64 -> 128 -> 256 ---
      (itInternRange big 0 100)
      (println (internCount big))  ; 100
      (println (internCap big))  ; 256
      (println (itCountRoundTrip big 0 100))  ; 100: none lost
      (println (internCount big))  ; 100: none re-added
      (println (internLookup big 0))  ; id0
      (println (internLookup big 99))  ; id99
      (println (itFound (internFind big "id7")))  ; 7
      (println (itFound (internFind big "id100")))  ; -1
      (println (strLen (internLookup big 100)))  ; 0
      ; --- THE PORT: a miss is `None`, not a number that happens to be
      ; negative. A dense id space starts at 0, so the sentinel and a
      ; real id were only ever told apart by a comparison the caller had
      ; to remember to write - nine callers in this tree wrote it.
      (println (itShape (internFind big "id7")))  ; some
      (println (itShape (internFind big "id100")))  ; none
      0
    }
  )
)
