; A wiped secret's handle is dead: the next use stops the program with
; status 85 before any byte is read, rather than answering zeros or
; whatever the page's next owner wrote (docs/crypto.md, "Keys and
; secrets"; MM-PAR-8).
(import IO)
(import Err)
(import Crypto.Secret)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (secretFromString "0123456789abcdef")
    ((Ok k)
      {
        (println (secretLen k))
        (secretWipe k)
        (println "wiped")
        (println (secretLen k))
        0
      })
    ((Err e) (die (errorText e) 1))))
