; Both small closures and the largest supported capture map reclaim strings.
; Warm allocation shapes before comparing allocator backlog.
(import Mem)
(import Str)
(import IO)

(:: make2 (-> Int Int Int))
(fn (make2 seed)
  {
    (let s0 (strDup "abcdefghijklmnopqrstuvwxyz0123456789ABCD"))
    (let s1 (strDup "abcdefghijklmnopqrstuvwxyz0123456789ABCD"))
    (lambda (i) (+ (strByte s0 0) (strByte s1 0)))
  })

(:: use2 (-> Int Int))
(fn (use2 k)
  {
    (let f (make2 k))
    (f 0)
  })

(:: loop2 (-> Int Int))
(fn (loop2 n)
  (if (<= n 0)
    0
    {
      (use2 n)
      (loop2 (- n 1))
    }))

