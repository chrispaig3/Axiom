            (+ (+ (strByte s40 0) (+ (strByte s41 0) (strByte s42 0)))
              (+ (strByte s43 0) (+ (strByte s44 0) (strByte s45 0)))))))
    )
  })

(:: use46 (-> Int Int))
(fn (use46 k)
  {
    (let f (make46 k))
    (f 0)
  })

(:: loop46 (-> Int Int))
(fn (loop46 n)
  (if (<= n 0)
    0
    {
      (use46 n)
      (loop46 (- n 1))
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (loop2 100)
    (loop46 100)
    (let before memStats)
    (loop2 100)
    (let small memStats)
    (loop46 100)
    (let large memStats)
    (let smallReclaimed (< (- small.backlogBytes before.backlogBytes) 1024))
    (let boundaryReclaimed (< (- large.backlogBytes small.backlogBytes) 1024))
    (println "small capture reclaimed: {smallReclaimed}")
    (println "boundary capture reclaimed: {boundaryReclaimed}")
    0
  })
