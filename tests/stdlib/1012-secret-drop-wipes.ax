; A dropped secret is wiped and its mapping freed, with no explicit
; wipe: a hundred thousand secrets live one at a time in this loop, and
; every one answers its length. A store that only freed on `secretWipe`
; exhausts its handle table part way and rounds start answering `Err`.
; A wiped secret dropped afterwards does not wipe twice.
(import IO)
(import Err)
(import Crypto.Secret)

(:: round (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (round i)
  (match (secretRandom 32)
    ((Ok sec) (Ok (secretLen sec)))
    ((Err e) (Err e))))

(:: loop (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (loop i acc)
  (if (> i 0)
    (match (round i)
      ((Ok n) (loop (- i 1) (+ acc n)))
      ((Err e) (Err e)))
    (Ok acc)))

(:: main ())
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (main)
  {
    (match (loop 100000 0)
      ((Ok total) (println "total={total}"))
      ((Err e) (die (errorText e) 1)))
    (match (secretFromString "0123456789abcdef")
      ((Ok k)
        {
          (secretWipe k)
          (println "wiped-then-dropped")
        }
      )
      ((Err e) (die (errorText e) 1)))
  })
