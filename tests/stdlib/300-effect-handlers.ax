; Dynamic effect handlers: evidence-passing, tail-resumptive.
;
; `(effect Console (log :: ...))` introduces `log` as a callable whose
; invocation dispatches through the innermost installed handler, and
; `(handle body (Console) h)` installs `h` for the body's dynamic
; extent. Four properties are pinned, each of which had a way to be
; wrong in an earlier draft:
;
;  - dispatch is dynamic, not lexical: `helper` never mentions a
;    handler and still reaches the one installed around its caller;
;  - the handler's return value IS the operation's result (`7` from
;    `ask`), and a two-argument operation's handler is a curried chain
;    applied one argument per step;
;  - nesting shadows and restores: the inner handler wins while its
;    handle is live, and the outer one answers again after it exits;
;  - a handler performing its own effect dispatches OUTWARD to the
;    next handler, because it runs under the evidence in scope at its
;    installation - the naive lowering re-entered itself forever.
(import IO)
(import Str)
(import Fmt)

(effect Console
  (log :: (-> String Int)))

(effect Ask
  (ask :: (-> Int Int Int)))

(:: helper (-> Int Int))
(fn (helper n)
  (log "from helper"))

(:: main Int)
(fn (main)
  {
    (printlnInt (handle (ask 3 4) (Ask) (lambda (a) (lambda (b) (+ a b)))))
    (handle
      {
        (log "outer-first")
        (handle (log "inner") (Console) (lambda (s) { (println "inner handler") 0 }))
        (log "outer-second")
        (helper 1)
        0
      }
      (Console IO Alloc)
      (lambda (s) { (println s) 0 }))
    (handle
      (handle (log "deep") (Console) (lambda (s) { (log "relayed") 0 }))
      (Console IO Alloc)
      (lambda (s) { (println (strConcat "outer saw " s)) 0 }))
    ; a local shadowing an operation name binds the local - sema
    ; resolves it that way, and the generator once disagreed,
    ; dispatching the name through the (absent) handler and trapping
    (let ((log (lambda (s) { (println "local log") 0 })))
      (log "ignored"))
    0
  })
