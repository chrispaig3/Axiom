; A declaration whose only unsafe work is handing a word to the kernel
; says `effect(unsafe)` (docs/memory-model.md MM-EXEC-9d). `put`'s body
; is one `write(2)`: the kernel reads `n` bytes at `buf`. `put` is a
; trusted encapsulation, so `main`, which passes the bytes of a
; `String` it holds, needs no tag of its own.
;
; The committed seed before this rule refused `put`'s tags with AX3010
; ("`effect(unsafe)` claim unsupported: missing Unsafe"), because the
; syscall was not an unsafe operation it could see.
(import Sys)
(import Str)

(:: put (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (put buf n)
  (__syscall3 sysWrite 1 buf n))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((s "a word the kernel reads\n"))
    {
      (put (strData s) (strLen s))
      0
    }))
