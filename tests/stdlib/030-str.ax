; The string layer: length-prefixed, NUL-terminated, slice-by-sharing.
(import IO)

(pub :: main Int)

;@axiom:effect(io)
(pub fn (main)
  (let (
    (hello "hello")
    (world "world")
  )
    {
      (println (strLen hello))
      (println (strLen ""))
      (println (strConcat hello world))
      (println (strConcat (strConcat hello ", ") world))
      (println (strByte hello 0))
      (println (strByte hello 4))
      (println (strByte hello 5))
      (println (strByte hello (- 0 1)))
      (println (strSlice hello 1 3))
      (println (strSlice hello 0 100))
      (println (strSlice hello 100 3))
      (println (strCmp hello hello))
      (println (strCmp hello world))
      (println (strCmp world hello))
      (println (strCmp hello (strConcat hello world)))
      ; `strFindByte` answers `(Option Int)` since 0.7.5. The three
      ; prints below keep the numbers this fixture always asserted, by
      ; folding `None` back to -1 at the call - and the two after them
      ; are the assertion the `Int` channel could not carry: absence is
      ; a TAG now, not a sign, so it survives a lookup that legitimately
      ; answers a negative index and it cannot be confused with one.
      (println (match (strFindByte hello 108 0) ((None) (- 0 1)) ((Some i) i)))
      (println (match (strFindByte hello 108 3) ((None) (- 0 1)) ((Some i) i)))
      (println (match (strFindByte hello 122 0) ((None) (- 0 1)) ((Some i) i)))
      (println (match (strFindByte hello 122 0) ((None) 1) ((Some _) 0)))
      (println (match (strFindByte hello 104 0) ((None) 1) ((Some _) 0)))
      (println (strDup hello))
      0
    }
  )
)
