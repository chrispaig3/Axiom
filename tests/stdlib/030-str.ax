; The string layer: length-prefixed, NUL-terminated, slice-by-sharing.
(import IO)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((hello (strFromLit (__addr "hello")))
        (world (strFromLit (__addr "world"))))
    {
      (printlnInt (strLen hello))
      (printlnInt (strLen (strFromLit (__addr ""))))
      (println (strConcat hello world))
      (println (strConcat (strConcat hello (strFromLit (__addr ", "))) world))
      (printlnInt (strByte hello 0))
      (printlnInt (strByte hello 4))
      (printlnInt (strByte hello 5))
      (printlnInt (strByte hello (- 0 1)))
      (println (strSlice hello 1 3))
      (println (strSlice hello 0 100))
      (println (strSlice hello 100 3))
      (printlnInt (strCmp hello hello))
      (printlnInt (strCmp hello world))
      (printlnInt (strCmp world hello))
      (printlnInt (strCmp hello (strConcat hello world)))
      (printlnInt (strFindByte hello 108 0))
      (printlnInt (strFindByte hello 108 3))
      (printlnInt (strFindByte hello 122 0))
      (println (strDup hello))
      0
    }))
