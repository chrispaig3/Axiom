; A `mut` slot whose value the function returns: the caller gets one
; share, the slot's own share goes back at the scope end, and nothing
; is released twice (MM-LIFE-2c events 2 and 3). The same answers at
; every `--opt` level (`710-mut-slot-return.optstable`).
;
;   owner   the overwritten owner goes at the `set`, the returned one
;           lives until the caller's binding ends
;   bytes   the arena grows 0 bytes per call over 10,000 calls for
;           a slot rebuilt in a loop and returned, a slot returned
;           through a branch, and a slot inside a self tail call loop
;   text    what came back is intact, read after other allocations
;           have had the chance to reuse anything released too early
(import IO)
(import Str)
(import Vec)

(struct Owner sealed (handle : Handle))

(:: makeOwner (-> (Vec Int) Int Owner))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (makeOwner hits n)
  (Owner (__resource_new (lambda (v) { (vecPush hits v) 0 }) n)))

(:: useOwner (-> Owner Int))
;@axiom:effect(unsafe)
(fn (useOwner o)
  (__resource_get o.handle))

(:: pick (-> (Vec Int) Owner))
;@axiom:effect(io)
(fn (pick hits)
  (let ((mut o (makeOwner hits 5)))
    {
      (set o (makeOwner hits 6))
      o
    }))

(:: owner (-> (Vec Int) Int))
;@axiom:effect(io)
(fn (owner hits)
  (let ((o (pick hits)))
    (+ (* 100 (useOwner o)) (+ (* 10 (vecLen hits)) (if (> (vecLen hits) 0) (vecGet hits 0) 9)))))

(:: build (-> Int String))
(fn (build n)
  (let ((mut s "") (mut i 0))
    {
      (while (< i n)
        {
          (set s (concat (fmtInt i) "-"))
          (set i (+ i 1))
        })
      s
    }))

(:: branch (-> Int String))
(fn (branch n)
  (let ((mut s (concat "b" (fmtInt n))))
    (if (> n 5)
      { (set s (concat s "!")) s }
      s)))

(:: spin (-> Int String String))
(fn (spin n acc)
  (let ((mut t (concat acc "a")))
    (if (<= n 0)
      t
      (spin (- n 1) (strSlice t 1 (strLen t))))))

(:: run (-> Int Int Int))
(fn (run which n)
  (let ((mut i 0) (mut total 0))
    {
      (while (< i n)
        {
          (set total (+ total
            (strLen
              (if (== which 0)
                (build 3)
                (if (== which 1)
                  (branch (% i 10))
                  (spin 3 "xyz"))))))
          (set i (+ i 1))
        })
      total
    }))

(:: measure (-> Int Int))
;@axiom:effect(unsafe)
(fn (measure which)
  {
    (run which 1000)
    (let ((m0 __axiom_arena_mark))
      {
        (run which 10000)
        (let ((m1 __axiom_arena_mark))
          (if (!= (__load64 m1 2) (__load64 m0 2))
            999999
            (/ (- (__load64 m1 0) (__load64 m0 0)) 10000)))
      })
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((hits vecNew))
    {
      (println (owner hits))
      (println (vecLen hits))
      (let ((a (build 12)) (b (branch 9)) (c (spin 4 "hello")))
        {
          (let ((mut j 0))
            (while (< j 100)
              {
                (concat (fmtInt j) "-filler")
                (set j (+ j 1))
              }))
          (println a)
          (println b)
          (println c)
        })
      (let ((mut w 0))
        (while (< w 3)
          {
            (println (measure w))
            (set w (+ w 1))
          }))
      0
    }))
