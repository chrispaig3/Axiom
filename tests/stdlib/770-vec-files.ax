; A `Vec` of `File`s owns them: the vector's death closes every
; descriptor it holds, at the end of its scope or when a `mut` slot
; holding it is overwritten (MM-LIFE-2m). Each line must read `true`.
;
;   1  a vector of two Files, dropped at the end of its scope, closes both
;   2  3,000 vectors of two Files each, built and dropped in a loop,
;      stay within a handful of descriptors
;   3  3,000 reassignments of a `mut` slot holding a vector of Files
;      stay within a handful of descriptors
;   4  the last vector a slot holds is closed when the slot's scope ends
;
; A compiler that never releases a `Vec` answers `false` on every line,
; and lines 2 and 3 run out of descriptors (errno 24) under a limit of
; 256. The count of open descriptors is read from /dev/fd.
(import IO)
(import Err)
(import Str)
(import Vec)

(:: requireFile (-> String File))
;@axiom:effect(io)
(fn (requireFile path)
  (match (openPath path oRdonly)
    ((Ok f) f)
    ((Err e) { (die (errorText e) 1) (requireFile path) })))

; How many descriptors this process holds, counted in /dev/fd.
(:: openCount Int)
;@axiom:effect(io)
(fn (openCount)
  (vecLen (listDir "/dev/fd")))

(:: pairOf (Vec File))
;@axiom:effect(io)
(fn (pairOf)
  (let ((v vecNew))
    {
      (vecPush v (requireFile "/dev/null"))
      (vecPush v (requireFile "/dev/null"))
      v
    }))

(:: droppedClosed Bool)
;@axiom:effect(io)
(fn (droppedClosed)
  (let ((before openCount))
    {
      (let ((v pairOf))
        (vecLen v))
      (== openCount before)
    }))

(:: loopDropped Bool)
;@axiom:effect(io)
(fn (loopDropped)
  (let ((before openCount) (mut i 0))
    {
      (while (< i 3000)
        {
          (let ((v pairOf))
            (vecLen v))
          (set i (+ i 1))
        })
      (== openCount before)
    }))

(:: loopReassigned Bool)
;@axiom:effect(io)
(fn (loopReassigned)
  (let ((before openCount) (mut v pairOf) (mut i 0))
    {
      (while (< i 3000)
        {
          (set v pairOf)
          (set i (+ i 1))
        })
      (&& (== openCount (+ before 2)) (== (vecLen v) 2))
    }))

(:: lastSet (-> Int Int))
;@axiom:effect(io)
(fn (lastSet x)
  (let ((mut v pairOf) (mut n 0))
    {
      (set v pairOf)
      (set n (vecLen v))
      n
    }))

(:: lastClosed Bool)
;@axiom:effect(io)
(fn (lastClosed)
  (let ((before openCount))
    {
      (lastSet 0)
      (== openCount before)
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (if droppedClosed "true" "false"))
    (println (if loopDropped "true" "false"))
    (println (if loopReassigned "true" "false"))
    (println (if lastClosed "true" "false"))
    0
  })
