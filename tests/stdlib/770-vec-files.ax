; A `Vec` of `File`s owns them: the vector's death closes every
; descriptor it holds, at the end of its scope or when a `mut` slot
; holding it is overwritten (MM-LIFE-2m). Each line must read `true`.
;
;   1  a vector of two Files, dropped at the end of its scope, closes both
;   2  3,000 vectors of two Files each, built and dropped in a loop,
;      stay within a handful of descriptors
;   3  3,000 reassignments of a `mut` slot holding a vector of Files
;      stay within a handful of descriptors
;   4  the last vector a slot holds is closed when the slot's scope ends
;
; A compiler that never releases a `Vec` answers `false` on lines 1 and
; 4, and lines 2 and 3 run out of descriptors (errno 24) under the
; default limit of 256 or read `false` above it.
(import IO)
(import Sys)
(import Err)
(import Str)
(import Vec)

(:: requireFile (-> String File))
;@axiom:effect(io)
(fn (requireFile path)
  (match (openPath path oRdonly)
    ((Ok f) f)
    ((Err e) { (die (errorText e) 1) (requireFile path) })))

(:: closedFd (-> Int Bool))
;@axiom:effect(io)
(fn (closedFd fd)
  (let ((buf (strAlloc 1)))
    (match (sysReadFd fd (strData buf) 1)
      ((Ok _) false)
      ((Err e) (== (errCode e) 9)))))

(:: maxInt (-> Int Int Int))
(fn (maxInt a b)
  (if (> a b)
    a
    b))

(:: pairOf (Vec File))
;@axiom:effect(io)
(fn (pairOf)
  (let ((v vecNew))
    {
      (vecPush v (requireFile "/dev/null"))
      (vecPush v (requireFile "/dev/null"))
      v
    }))

; The two descriptors of a pair that has already been dropped.
(:: droppedFds (Vec Int))
;@axiom:effect(io)
(fn (droppedFds)
  (let ((v pairOf))
    (let ((out vecNew))
      {
        (vecPush out (fileFd (vecGet v 0)))
        (vecPush out (fileFd (vecGet v 1)))
        out
      })))

(:: droppedClosed Bool)
;@axiom:effect(io)
(fn (droppedClosed)
  (let ((fds droppedFds))
    (&& (closedFd (vecGet fds 0)) (closedFd (vecGet fds 1)))))

(:: loopDropped Bool)
;@axiom:effect(io)
(fn (loopDropped)
  (let ((mut i 0) (mut hi 0))
    {
      (while (< i 3000)
        {
          (let ((v pairOf))
            {
              (set hi (maxInt hi (fileFd (vecGet v 1))))
              0
            })
          (set i (+ i 1))
        })
      (< hi 16)
    }))

(:: loopReassigned Bool)
;@axiom:effect(io)
(fn (loopReassigned)
  (let ((mut v pairOf) (mut i 0) (mut hi 0))
    {
      (while (< i 3000)
        {
          (set v pairOf)
          (set hi (maxInt hi (fileFd (vecGet v 1))))
          (set i (+ i 1))
        })
      (< hi 16)
    }))

(:: lastFd Int)
;@axiom:effect(io)
(fn (lastFd)
  (let ((mut v pairOf) (mut n 0))
    {
      (set v pairOf)
      (set n (fileFd (vecGet v 0)))
      n
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (if droppedClosed "true" "false"))
    (println (if loopDropped "true" "false"))
    (println (if loopReassigned "true" "false"))
    (println (if (closedFd lastFd) "true" "false"))
    0
  })
