; A `Vec` whose capacity is past what an allocation can ask for is out
; of memory, status 70, like the allocation itself (MM-ALLOC-7a). The
; byte size used to be `(* n 8)` unchecked: 2^61 elements asked for 0
; bytes, the vector claimed 2^61 slots, and its pushes wrote into the
; next blocks the allocator handed out. Inside a recovery point both
; requests below answer 70, and a vector built before them still holds
; every element. With `__axiom_recover` referenced, the recovery
; branch is emitted (402-recover-oom.ax's reason).
(import IO)
(import Vec)
(import Str)

(:: wrapping (-> Int Int))
(fn (wrapping x)
  (vecLen (vecWithCapacity 2305843009213693952)))

(:: justPast (-> Int Int))
(fn (justPast x)
  (vecLen (vecWithCapacity 576460752303423489)))

(:: sumOf (-> (Vec Int) Int))
(fn (sumOf v)
  (let ((mut acc 0))
    {
      (for i 0 (vecLen v)
        (set acc (+ acc (vecGet v i))))
      acc
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((before (vecWithCapacity 16)))
    {
      (for i 0 1000
        (vecPush before (+ i 1)))
      (let (
        (a (__axiom_recover __axiom_arena_mark (lambda (x) (wrapping x))))
        (b (__axiom_recover __axiom_arena_mark (lambda (x) (justPast x))))
        (after (vecWithCapacity 16))
      )
        {
          (for i 0 16
            (vecPush after 7))
          (println "2^61 elements: {a}")
          (println "2^59 + 1 elements: {b}")
          (let (
            (count (vecLen before))
            (first (vecGet before 0))
            (total (sumOf before))
          )
            (println "the vector built before: {count} elements, first {first}, sum {total}"))
          0
        })
    }))
