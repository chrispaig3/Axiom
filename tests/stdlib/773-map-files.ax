; A `Map` whose values are `File`s owns them: the table's death closes
; every descriptor in it, and so do an overwrite under the same key and
; a removal (MM-LIFE-2m). Each line must read `true`.
;
;   1  a table of two Files, dropped at the end of its scope, closes both
;   2  3,000 tables of two Files each, built and dropped in a loop, stay
;      within a handful of descriptors
;   3  a File overwritten under the same key is closed at the insert
;   4  a File removed from a live table is closed at the remove
;
; A compiler whose tables only own their values when built with an
; owning constructor answers `false` on line 1, and line 2 runs out of
; descriptors (errno 24) under a limit of 256. The count of open
; descriptors is read from /dev/fd.
(import IO)
(import Err)
(import Str)
(import Vec)
(import Map)

(:: requireFile (-> String File))
;@axiom:effect(io)
(fn (requireFile path)
  (match (openPath path oRdonly)
    ((Ok f) f)
    ((Err e) { (die (errorText e) 1) (requireFile path) })))

; How many descriptors this process holds, counted in /dev/fd.
(:: openCount Int)
;@axiom:effect(io)
(fn (openCount)
  (vecLen (listDir "/dev/fd")))

; Insert a fresh File under `key`.
(:: put (-> Map Int Int))
;@axiom:effect(io)
(fn (put m key)
  (let ((f (requireFile "/dev/null")))
    {
      (mapInsert m key f)
      0
    }))

(:: droppedClosed Bool)
;@axiom:effect(io)
(fn (droppedClosed)
  (let ((before openCount))
    {
      (let ((m mapNew))
        {
          (put m 1)
          (put m 2)
          (mapLen m)
        })
      (== openCount before)
    }))

(:: loopDropped Bool)
;@axiom:effect(io)
(fn (loopDropped)
  (let ((before openCount) (mut i 0))
    {
      (while (< i 3000)
        {
          (let ((m mapNew))
            {
              (put m 1)
              (put m 2)
              0
            })
          (set i (+ i 1))
        })
      (== openCount before)
    }))

(:: overwritten Bool)
;@axiom:effect(io)
(fn (overwritten)
  (let ((m mapNew) (before openCount))
    {
      (put m 7)
      (put m 7)
      (&& (== openCount (+ before 1)) (== (mapLen m) 1))
    }))

(:: removed Bool)
;@axiom:effect(io)
(fn (removed)
  (let ((m mapNew) (before openCount))
    {
      (put m 7)
      (put m 8)
      (mapRemove m 7)
      (&& (== openCount (+ before 1)) (== (mapLen m) 1))
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (if droppedClosed "true" "false"))
    (println (if loopDropped "true" "false"))
    (println (if overwritten "true" "false"))
    (println (if removed "true" "false"))
    0
  })
