; A `Map` whose values are `File`s owns them: the table's death closes
; every descriptor in it, and so do an overwrite under the same key and
; a removal (MM-LIFE-2m). Each line must read `true`.
;
;   1  a table of two Files, dropped at the end of its scope, closes both
;   2  3,000 tables of two Files each, built and dropped in a loop, stay
;      within a handful of descriptors
;   3  a File overwritten under the same key is closed at the insert
;   4  a File removed from a live table is closed at the remove
;
; A compiler whose tables only own their values when built with an
; owning constructor answers `false` on line 1, and line 2 runs out of
; descriptors (errno 24) under the default limit of 256.
(import IO)
(import Sys)
(import Err)
(import Str)
(import Vec)
(import Map)

(:: requireFile (-> String File))
;@axiom:effect(io)
(fn (requireFile path)
  (match (openPath path oRdonly)
    ((Ok f) f)
    ((Err e) { (die (errorText e) 1) (requireFile path) })))

(:: closedFd (-> Int Bool))
;@axiom:effect(io)
(fn (closedFd fd)
  (let ((buf (strAlloc 1)))
    (match (sysReadFd fd (strData buf) 1)
      ((Ok _) false)
      ((Err e) (== (errCode e) 9)))))

(:: maxInt (-> Int Int Int))
(fn (maxInt a b)
  (if (> a b)
    a
    b))

; Insert a fresh File under `key` and answer its descriptor.
(:: put (-> Map Int Int))
;@axiom:effect(io)
(fn (put m key)
  (let ((f (requireFile "/dev/null")))
    {
      (mapInsert m key f)
      (fileFd f)
    }))

; The two descriptors of a table that has already been dropped.
(:: droppedFds (Vec Int))
;@axiom:effect(io)
(fn (droppedFds)
  (let ((m mapNew))
    (let ((out vecNew))
      {
        (vecPush out (put m 1))
        (vecPush out (put m 2))
        out
      })))

(:: droppedClosed Bool)
;@axiom:effect(io)
(fn (droppedClosed)
  (let ((fds droppedFds))
    (&& (closedFd (vecGet fds 0)) (closedFd (vecGet fds 1)))))

(:: loopDropped Bool)
;@axiom:effect(io)
(fn (loopDropped)
  (let ((mut i 0) (mut hi 0))
    {
      (while (< i 3000)
        {
          (let ((m mapNew))
            {
              (put m 1)
              (set hi (maxInt hi (put m 2)))
              0
            })
          (set i (+ i 1))
        })
      (< hi 16)
    }))

(:: overwritten Bool)
;@axiom:effect(io)
(fn (overwritten)
  (let ((m mapNew))
    (let ((first (put m 7)))
      {
        (put m 7)
        (&& (closedFd first) (== (mapLen m) 1))
      })))

(:: removed Bool)
;@axiom:effect(io)
(fn (removed)
  (let ((m mapNew))
    (let ((fd (put m 7)))
      {
        (put m 8)
        (mapRemove m 7)
        (&& (closedFd fd) (== (mapLen m) 1))
      })))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (if droppedClosed "true" "false"))
    (println (if loopDropped "true" "false"))
    (println (if overwritten "true" "false"))
    (println (if removed "true" "false"))
    0
  })
