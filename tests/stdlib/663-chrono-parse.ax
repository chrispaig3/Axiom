; Chrono's parsers read strict ISO 8601 extended format and refuse
; everything else. Every refusal is one line: `Err 1204` for text that
; is not the format (`chronoParseFailed`), 1201 or 1202 for fields the
; format allows but the calendar or clock does not (`chronoInvalidDate`,
; `chronoInvalidTime`), and 1203 for a year or duration outside the
; range (`chronoOutOfRange`). The last block pins each message once.
(import IO)
(import Str)
(import Err)
(import Fmt)
(import Chrono)

(:: check (-> String String String Int))
;@axiom:effect(io)
(fn (check name got want)
  (if (strEq got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }))

(:: errText (-> Error String))
(fn (errText e)
  (strConcat "Err " (fmtInt (errCode e))))

(:: pd (-> String String))
(fn (pd s)
  (match (dateParse s)
    ((Ok d) (dateToString d))
    ((Err e) (errText e))))

(:: pt (-> String String))
(fn (pt s)
  (match (timeParse s)
    ((Ok t) (timeToString t))
    ((Err e) (errText e))))

(:: pdt (-> String String))
(fn (pdt s)
  (match (datetimeParse s)
    ((Ok dt) (datetimeToString dt))
    ((Err e) (errText e))))

(:: pdu (-> String String))
(fn (pdu s)
  (match (durationParse s)
    ((Ok d) (durationToString d))
    ((Err e) (errText e))))

; The whole error, message and context, of a refusal.
(:: why (-> (Result a Error) String))
(fn (why r)
  (match r
    ((Ok _) "accepted")
    ((Err e) (errorText e))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    ; Dates.
    (check "date 2024-01-05" (pd "2024-01-05") "2024-01-05")
    (check "date 0000-01-01" (pd "0000-01-01") "0000-01-01")
    (check "date 9999-12-31" (pd "9999-12-31") "9999-12-31")
    (check "date -009999-01-01" (pd "-009999-01-01") "-009999-01-01")
    (check "date -000001-12-31" (pd "-000001-12-31") "-000001-12-31")
    (check "date +002024-01-05" (pd "+002024-01-05") "2024-01-05")
    (check "date +000000-01-01" (pd "+000000-01-01") "0000-01-01")
    (check "date empty" (pd "") "Err 1204")
    (check "date 2024-1-05" (pd "2024-1-05") "Err 1204")
    (check "date 2024-01-5" (pd "2024-01-5") "Err 1204")
    (check "date 24-01-05" (pd "24-01-05") "Err 1204")
    (check "date 02024-01-05" (pd "02024-01-05") "Err 1204")
    (check "date 2024/01/05" (pd "2024/01/05") "Err 1204")
    (check "date with a space after" (pd "2024-01-05 ") "Err 1204")
    (check "date with a space before" (pd " 2024-01-05") "Err 1204")
    (check "date 2024-01-05x" (pd "2024-01-05x") "Err 1204")
    (check "date 20240105, basic format" (pd "20240105") "Err 1204")
    (check "date 2024-W01-1, a week date" (pd "2024-W01-1") "Err 1204")
    (check "date 2024-005, an ordinal date" (pd "2024-005") "Err 1204")
    (check "date +2024-01-05, a sign and four digits" (pd "+2024-01-05") "Err 1204")
    (check "date +10000-01-01, a sign and five digits" (pd "+10000-01-01") "Err 1204")
    (check "date -000000-01-01" (pd "-000000-01-01") "Err 1204")
    (check "date in full-width digits" (pd "２０２４-01-05") "Err 1204")
    (check "date 2024-01-05T10:00" (pd "2024-01-05T10:00") "Err 1204")
    (check "date +010000-01-01" (pd "+010000-01-01") "Err 1203")
    (check "date -010000-12-31" (pd "-010000-12-31") "Err 1203")
    (check "date 2024-13-01" (pd "2024-13-01") "Err 1201")
    (check "date 2024-00-10" (pd "2024-00-10") "Err 1201")
    (check "date 2024-02-30" (pd "2024-02-30") "Err 1201")
    (check "date 2023-02-29" (pd "2023-02-29") "Err 1201")
    (check "date 2024-04-31" (pd "2024-04-31") "Err 1201")
    (check "date 2024-01-00" (pd "2024-01-00") "Err 1201")
    ; Times.
    (check "time 00:00" (pt "00:00") "00:00:00")
    (check "time 23:59" (pt "23:59") "23:59:00")
    (check "time 23:59:59" (pt "23:59:59") "23:59:59")
    (check "time 23:59:60, a leap second" (pt "23:59:60") "23:59:59")
    (check "time 00:00:60.999999999" (pt "00:00:60.999999999") "00:00:59.999999999")
    (check "time 12:00:00.5" (pt "12:00:00.5") "12:00:00.5")
    (check "time 12:00:00,5" (pt "12:00:00,5") "12:00:00.5")
    (check "time 12:00:00.000000001" (pt "12:00:00.000000001") "12:00:00.000000001")
    (check "time 12:00:00.100" (pt "12:00:00.100") "12:00:00.1")
    (check "time 12:00:00.000" (pt "12:00:00.000") "12:00:00")
    (check "time empty" (pt "") "Err 1204")
    (check "time 1:00" (pt "1:00") "Err 1204")
    (check "time 01:0" (pt "01:0") "Err 1204")
    (check "time 0100, basic format" (pt "0100") "Err 1204")
    (check "time 01:00:0" (pt "01:00:0") "Err 1204")
    (check "time 01:00:00. with no digits" (pt "01:00:00.") "Err 1204")
    (check "time with ten fraction digits" (pt "01:00:00.1234567890") "Err 1204")
    (check "time 01:00:00:00" (pt "01:00:00:00") "Err 1204")
    (check "time 01:00.5, a fraction on minutes" (pt "01:00.5") "Err 1204")
    (check "time with a space after" (pt "01:00 ") "Err 1204")
    (check "time T01:00" (pt "T01:00") "Err 1204")
    (check "time 01:00:00Z" (pt "01:00:00Z") "Err 1204")
    (check "time 01h00" (pt "01h00") "Err 1204")
    (check "time -01:00" (pt "-01:00") "Err 1204")
    (check "time 24:00" (pt "24:00") "Err 1202")
    (check "time 24:00:00" (pt "24:00:00") "Err 1202")
    (check "time 23:60" (pt "23:60") "Err 1202")
    (check "time 23:59:61" (pt "23:59:61") "Err 1202")
    (check "time 99:00" (pt "99:00") "Err 1202")
    ; Datetimes.
    (check "datetime 2024-01-05T10:00" (pdt "2024-01-05T10:00") "2024-01-05T10:00:00")
    (check "datetime 2024-01-05t10:00" (pdt "2024-01-05t10:00") "2024-01-05T10:00:00")
    (check "datetime 2024-01-05 10:00:00.25" (pdt "2024-01-05 10:00:00.25") "2024-01-05T10:00:00.25")
    (check "datetime -000044-03-15T12:00" (pdt "-000044-03-15T12:00") "-000044-03-15T12:00:00")
    (check "datetime with a leap second at the very end" (pdt "9999-12-31T23:59:60.999999999") "9999-12-31T23:59:59.999999999")
    (check "datetime 2024-01-05, no time" (pdt "2024-01-05") "Err 1204")
    (check "datetime 2024-01-05T" (pdt "2024-01-05T") "Err 1204")
    (check "datetime 2024-01-05X10:00" (pdt "2024-01-05X10:00") "Err 1204")
    (check "datetime with two spaces" (pdt "2024-01-05  10:00") "Err 1204")
    (check "datetime 2024-01-05T10" (pdt "2024-01-05T10") "Err 1204")
    (check "datetime with a space after" (pdt "2024-01-05T10:00:00 ") "Err 1204")
    (check "datetime 2024-1-05T10:00" (pdt "2024-1-05T10:00") "Err 1204")
    (check "datetime ending Z" (pdt "2024-01-05T10:00Z") "Err 1204")
    (check "datetime ending z" (pdt "2024-01-05T10:00:00.5z") "Err 1204")
    (check "datetime ending +01:00" (pdt "2024-01-05T10:00+01:00") "Err 1204")
    (check "datetime ending -01:00" (pdt "2024-01-05T10:00-01:00") "Err 1204")
    (check "datetime 2024-02-30T10:00" (pdt "2024-02-30T10:00") "Err 1201")
    (check "datetime 2024-01-05T24:00" (pdt "2024-01-05T24:00") "Err 1202")
    (check "datetime +010000-01-01T00:00" (pdt "+010000-01-01T00:00") "Err 1203")
    ; Durations.
    (check "duration PT0S" (pdu "PT0S") "PT0S")
    (check "duration -PT0S" (pdu "-PT0S") "PT0S")
    (check "duration PT0H0M0S" (pdu "PT0H0M0S") "PT0S")
    (check "duration PT1H30M" (pdu "PT1H30M") "PT1H30M")
    (check "duration PT90M" (pdu "PT90M") "PT1H30M")
    (check "duration PT3600S" (pdu "PT3600S") "PT1H")
    (check "duration PT01H" (pdu "PT01H") "PT1H")
    (check "duration PT0.5S" (pdu "PT0.5S") "PT0.5S")
    (check "duration PT0,5S" (pdu "PT0,5S") "PT0.5S")
    (check "duration PT0.100S" (pdu "PT0.100S") "PT0.1S")
    (check "duration -PT36H" (pdu "-PT36H") "-PT36H")
    (check "duration PT1H0.000000001S" (pdu "PT1H0.000000001S") "PT1H0.000000001S")
    (check "duration PT1H1S" (pdu "PT1H1S") "PT1H1S")
    (check "duration, the longest" (pdu "PT2562047H47M16.854775807S") "PT2562047H47M16.854775807S")
    (check "duration, the longest negative" (pdu "-PT2562047H47M16.854775807S") "-PT2562047H47M16.854775807S")
    (check "duration empty" (pdu "") "Err 1204")
    (check "duration P" (pdu "P") "Err 1204")
    (check "duration PT" (pdu "PT") "Err 1204")
    (check "duration P1D" (pdu "P1D") "Err 1204")
    (check "duration P1Y" (pdu "P1Y") "Err 1204")
    (check "duration P1M" (pdu "P1M") "Err 1204")
    (check "duration P1W" (pdu "P1W") "Err 1204")
    (check "duration P1DT1H" (pdu "P1DT1H") "Err 1204")
    (check "duration PT1D" (pdu "PT1D") "Err 1204")
    (check "duration pt1h" (pdu "pt1h") "Err 1204")
    (check "duration PT1h" (pdu "PT1h") "Err 1204")
    (check "duration +PT1H" (pdu "+PT1H") "Err 1204")
    (check "duration --PT1H" (pdu "--PT1H") "Err 1204")
    (check "duration PT-1H" (pdu "PT-1H") "Err 1204")
    (check "duration PT1.5H" (pdu "PT1.5H") "Err 1204")
    (check "duration PT1.5M" (pdu "PT1.5M") "Err 1204")
    (check "duration PT1S1M" (pdu "PT1S1M") "Err 1204")
    (check "duration PT1M1H" (pdu "PT1M1H") "Err 1204")
    (check "duration PT1H1H" (pdu "PT1H1H") "Err 1204")
    (check "duration PT1.S" (pdu "PT1.S") "Err 1204")
    (check "duration PT.5S" (pdu "PT.5S") "Err 1204")
    (check "duration with ten fraction digits" (pdu "PT0.1234567891S") "Err 1204")
    (check "duration PT1H30, no unit" (pdu "PT1H30") "Err 1204")
    (check "duration with a space after" (pdu "PT1H ") "Err 1204")
    (check "duration with a space before" (pdu " PT1H") "Err 1204")
    (check "duration PT9223372037S" (pdu "PT9223372037S") "Err 1203")
    (check "duration PT2562048H" (pdu "PT2562048H") "Err 1203")
    (check "duration PT99999999999999999999S" (pdu "PT99999999999999999999S") "Err 1203")
    (check "duration, 1 ns past the longest negative" (pdu "-PT2562047H47M16.854775808S") "Err 1203")
    ; The messages, once each.
    (check "message for 2024-1-05" (why (dateParse "2024-1-05")) "expected a date as YYYY-MM-DD, or with a sign and six year digits while dateParse")
    (check "message for -000000-01-01" (why (dateParse "-000000-01-01")) "-000000 is not a year: year zero is 0000 while dateParse")
    (check "message for +010000-01-01" (why (dateParse "+010000-01-01")) "the year is outside -9999 to 9999 while dateParse")
    (check "message for 2024-13-01" (why (dateParse "2024-13-01")) "the month is outside 1 to 12 while dateParse")
    (check "message for 2023-02-29" (why (dateParse "2023-02-29")) "the day is not in the month while dateParse")
    (check "message for 1:00" (why (timeParse "1:00")) "expected a time as HH:MM, HH:MM:SS or HH:MM:SS.fffffffff while timeParse")
    (check "message for 24:00" (why (timeParse "24:00")) "the hour is outside 0 to 23 while timeParse")
    (check "message for 23:60" (why (timeParse "23:60")) "the minute is outside 0 to 59 while timeParse")
    (check "message for 23:59:61" (why (timeParse "23:59:61")) "the second is outside 0 to 60 while timeParse")
    (check "message for 2024-01-05X10:00" (why (datetimeParse "2024-01-05X10:00")) "expected a date, T and a time while datetimeParse")
    (check "message for an offset" (why (datetimeParse "2024-01-05T10:00Z")) "a naive datetime has no offset: datetimeParseUtc reads one with Z or +HH:MM while datetimeParse")
    (check "message for PT" (why (durationParse "PT")) "expected a duration such as PT1H30M or PT0.5S while durationParse")
    (check "message for P" (why (durationParse "P")) "expected a duration such as PT1H30M or PT0.5S while durationParse")
    (check "message for P1D" (why (durationParse "P1D")) "a duration has hours, minutes and seconds only: a day is not a fixed length while durationParse")
    (check "message for PT1.5H" (why (durationParse "PT1.5H")) "only the seconds may have a fraction while durationParse")
    (check "message for PT2562048H" (why (durationParse "PT2562048H")) "the duration is longer than 2^63 - 1 nanoseconds while durationParse")
    0
  })
