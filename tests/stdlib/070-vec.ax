; Vec: growth by doubling, total indexing, stack discipline.
;
; The cases here are chosen to fail loudly rather than to illustrate:
; the vector is pushed well past its initial capacity so reallocation
; actually runs, indexed out of range on both sides, and popped to empty
; and beyond. `pushRange` is a named recursive filler because Axiom has
; no loop and no function values, so bulk work is always a top-level
; function threading its own index.
(import IO)

(import Vec)

; Push `x`, `x+1`, ... until the vector holds `upto` elements.
(pub :: pushRange (-> Int Int Int))

(pub fn (pushRange v upto)
  (if (>= (vecLen v) upto)
    v
    {
      (vecPush v (vecLen v))
      (pushRange v upto)
    }
  )
)

; Pop `n` times, printing each result, so "pop to empty" is checked
; element by element rather than by a single summary number.
(pub :: popTimes (-> Int Int Int))

;@axiom:effect(io)
(pub fn (popTimes v n)
  (if (<= n 0)
    v
    {
      (println (vecPop v))
      (popTimes v (- n 1))
    }
  )
)

(pub :: main Int)

;@axiom:effect(io)
(pub fn (main)
  ; --- a fresh Vec ---
  (let (
    (v vecNew)
    (small (vecWithCapacity 1))
    (zeroCap (vecWithCapacity 0))
  )
    {
      (println (vecLen v))  ; 0
      (println (vecCap v))  ; 8, vecDefaultCap
      (println (vecSum v))  ; 0
      (println (vecPop v))  ; 0: pop of empty
      (println (vecLen v))  ; 0: still empty, not -1
      ; --- fill to exactly the initial capacity: no growth yet ---
      (pushRange v 8)
      (println (vecLen v))  ; 8
      (println (vecCap v))  ; 8: full, but untouched
      (println (vecSum v))  ; 28 = 0+1+..+7
      ; --- one more push must double ---
      (vecPush v 100)
      (println (vecLen v))  ; 9
      (println (vecCap v))  ; 16
      (println
        (cast Int (vecGet v 0))
      )
      ; 0: survived the realloc
      (println
        (cast Int (vecGet v 7))
      )
      ; 7: last pre-growth element
      (println
        (cast Int (vecGet v 8))
      )
      ; 100
      (println (vecSum v))  ; 128
      ; --- growth across several doublings at once ---
      (pushRange v 70)
      (println (vecLen v))  ; 70
      (println (vecCap v))  ; 128: 16 -> 32 -> 64 -> 128
      (println
        (cast Int (vecGet v 8))
      )
      ; 100: still there
      (println
        (cast Int (vecGet v 9))
      )
      ; 9: pushRange resumed at len
      (println
        (cast Int (vecGet v 69))
      )
      ; 69
      ; --- out of range on both sides, through the CHECKED read ---
      ;
      ; These four used to call `vecGet` and expect 0. `vecGet` REFUSES
      ; an out-of-range index now (status 77,
      ; `docs/generics-design.md` section 4), so a fixture that reads
      ; past the end cannot also print anything afterwards - the terms
      ; move to `vecTry`, which is what a caller who does not know the
      ; index is good was always supposed to use.
      (println
        (match (vecTry v (- 0 1)) ((Some x) x) ((None) (- 0 1)))
      )
      ; -1: None
      (println
        (match (vecTry v (- 0 1000)) ((Some x) x) ((None) (- 0 1)))
      )
      ; -1: None
      (println
        (match (vecTry v 70) ((Some x) x) ((None) (- 0 1)))
      )
      ; -1: None, one past the end
      (println
        (match (vecTry v 100000) ((Some x) x) ((None) (- 0 1)))
      )
      ; -1: None, inside cap but past len
      ; --- set then get, including rejected out-of-range sets ---
      (vecSet v 0 999)
      (println
        (cast Int (vecGet v 0))
      )
      ; 999
      (vecSet v 70 777)  ; ignored: index == len
      (println
        (match (vecTry v 70) ((Some x) x) ((None) (- 0 1)))
      )
      ; -1: the set was ignored, so there is still nothing there
      (println (vecLen v))  ; 70: set did not append
      (vecSet v (- 0 1) 555)  ; ignored
      (println (vecLen v))  ; 70
      ; --- order matters: vecHash catches a permutation, vecSum does not
      (println (vecLast v))  ; 69
      (println (vecHash v))  ; position-sensitive digest
      ; --- clear keeps capacity, drops contents ---
      (vecClear v)
      (println (vecLen v))  ; 0
      (println (vecCap v))  ; 128: capacity retained
      (println (vecSum v))  ; 0: stale words not visible
      (println
        (match (vecTry v 0) ((Some x) x) ((None) (- 0 1)))
      )
      ; -1: None. The word 999 is still in the block, and that is the
      ; point - `vecClear` drops the LENGTH, so the element is gone as
      ; far as any reader is concerned, and the checked read says so
      ; rather than handing back a stale word.
      ; --- pop to empty and past it ---
      (pushRange v 3)
      (println (vecLen v))  ; 3
      (popTimes v 5)  ; 2 1 0 0 0
      (println (vecLen v))  ; 0: never negative
      (println (vecCap v))  ; 128
      ; --- a capacity-1 vector: doubling from the smallest legal size ---
      (pushRange small 5)
      (println (vecCap small))  ; 8: 1 -> 2 -> 4 -> 8
      (println (vecSum small))  ; 10 = 0+1+2+3+4
      ; --- capacity 0 is clamped to 1, so doubling terminates ---
      (println (vecCap zeroCap))  ; 1
      (vecPush zeroCap 41)
      (vecPush zeroCap 1)
      (println (vecCap zeroCap))  ; 2
      (println (vecSum zeroCap))  ; 42
      ; --- a Vec of Str handles: the uniform-representation claim ---
      ; `cast String`: `vecGet` answers the ELEMENT type, which is a
      ; type variable, and a `Show` implementation is keyed on a type
      ; NAME (AX3025). The cast is the claim this test is making
      ; anyway - that the handle round-tripped through the Vec is
      ; still a `Str`.
      (println
        (cast String (vecGet (vecPush (vecPush vecNew "alpha") "omega") 1))
      )
      ; omega
      0
    }
  )
)
