; exit 127 (see .exit)
; MM-LIFE-2c event 3, the subset that needs no escape analysis to be
; sound: a `let` binding whose initialiser is a DIRECT CONSTRUCTION is
; released when its scope ends, unless the binding can outlive the
; frame.
;
; The initialiser condition is what makes the frame the owner: a
; direct construction is born at count 1 and that birth is the
; binding's, so handing it back is arithmetic and not a judgement
; about who else holds it. The second condition is a POSITIONAL walk,
; and its permissions are the interesting half - each is a place the
; ownership events already guarantee a share:
;
;   passing it to a function is a BORROW (event 1). Every store the
;   callee can make takes a share: a field store by event 5, a
;   constructor field by event 6, a container or any other word store
;   through `memSetWord`, which retains by MM-LIFE-2g. A callee that
;   RETURNS it is the exception, since 2026-08-21: event 2 never
;   shipped for a borrowed value, so `(fn (ident p) p)` hands the
;   block straight back and a release after it dangles. `passed` is
;   still released because `total` is signed `(-> Pair Int)` - a
;   result that cannot be the block - and that is the permission now:
;   a call in value position whose declared result may be a reference
;   escapes (tests/selfhost/997-let-box-value-escapes.ax). Reading a
;   SCALAR field answers a word; reading a reference field in value
;   position is the block (same fixture);
;   sequencing, conditions and loops move no value out.
;
; What escapes, and why each is a place the guarantee stops:
;
;   the binding IS the let's value - nothing took a share on the way
;     out;
;   a LAMBDA mentions it - a capture takes no share, deliberately
;     (MM-VAL-15);
;   a `set` RHS - a slot store takes no share;
;   `cast`, `__addr`, `strData`, `strOwner` - the four ways to get a
;     WORD out of a reference, and a word is invisible to counting by
;     construction (MM-LIFE-2g's own stated limit).
;
; Any tag the walk does not know answers ESCAPE, so the surface widens
; by deliberate edit and never by omission - the leak direction.
;
;   64  a record CAPTURED BY A LAMBDA is not released: 400,224 bytes
;       over 5,000 iterations, and a release here would free a block
;       the closure still names
;   32  a record whose WORD escapes through `cast` is not released:
;       291,328 bytes over 5,000. This is the one the permissive half
;       of the walk makes possible and therefore the one it has to
;       refuse
;   16  a record RETURNED from `keep` and read by `readA` IS released
;       since 2026-08-22: event 2 hands the caller exactly one share,
;       `readA` is signed `(-> Pair Int)` and answers a scalar field -
;       no word of its parameter - so the temporary is released after
;       the call, and 5,000 of them move the bump under 4,096 bytes.
;       Until then this term asserted the OPPOSITE, 160,224 bytes over
;       5,000, because event 2 was unshipped and a returned record had
;       no release path
;    8  a record built, PASSED TO A FUNCTION, and dropped IS released:
;       20,000 calls move the bump 256 bytes where they moved 640,224.
;       This is what the positional walk buys over "field reads only"
;    4  the same for a record built, read, and dropped
;    2  the value is still right - the release is emitted after the
;       body, not before it
;    1  every step above ran
;
; What this event does NOT reach, measured rather than assumed: the
; compiler's own IR carries 116 release sites under it against 112
; before - four. 13 of 2,337 `let` bindings in `self_host/` and
; `stdlib/` bind a direct construction at all, because the corpus
; builds its records through `mk*` functions returning `Int`-declared
; handles. That is the same reason MM-LIFE-2e's acceptance
; measurements cannot move. (Event 2 was declined on that count for a
; year and shipped on 2026-08-21 once the emitter could tell an
; adopted share from a second one - 372-arc-owned-results.ax is its
; fixture, and the 8 bit here still stands: `total` answers a word.)
;
; Two ablations, because this fixture pins two commits' worth of rule.
; The compiler that predates the event answers 115 - both flatness
; claims fail and the three escape controls pass, which is what a
; compiler that releases nothing looks like. The compiler with the
; event but with the earlier "field reads only" walk answers 119: it
; releases the record it read and not the one it passed, which is
; exactly the widening this commit is.
(import Mem)

(import Vec)

(struct Pair
  (a : Int)
  (b : Int))

(:: b2i (-> Bool Int))

(fn (b2i x)
  (if x
    1
    0
  )
)

(:: total (-> Pair Int))

(fn (total p) (+ p.a p.b))

; built, read, dropped
(:: score (-> Int Int))

(fn (score n)
  (let ((p (Pair n n)))
    (+ p.a p.b)
  )
)

; built, PASSED, dropped - the shape the positional walk adds
(:: passed (-> Int Int))

(fn (passed n)
  (let ((p (Pair n n)))
    (total p)
  )
)

; the record IS the value: it escapes
(:: keep (-> Int Pair))

(fn (keep n)
  (let ((p (Pair n n)))
    p
  )
)

(:: readA (-> Pair Int))

(fn (readA p) p.a)

; the record's WORD escapes through a cast, into a container that
; retains the integer and not the block
(:: viaCast (-> Int Int Int))

(fn (viaCast v n)
  (let ((p (Pair n n)))
    {
      (vecPush
        v        (cast Int p)
      )
      1
    }
  )
)

; the record is captured by a lambda
(:: viaLambda (-> Int Int))

(fn (viaLambda n)
  (let ((p (Pair n n)))
    ((lambda (k) p.a)
      0
    )
  )
)

(:: sumDropped (-> Int Int Int))

(fn (sumDropped n acc)
  (if (<= n 0)
    acc
    (sumDropped (- n 1) (+ acc (score n)))
  )
)

(:: sumPassed (-> Int Int Int))

(fn (sumPassed n acc)
  (if (<= n 0)
    acc
    (sumPassed (- n 1) (+ acc (passed n)))
  )
)

(:: sumEscaped (-> Int Int Int))

(fn (sumEscaped n acc)
  (if (<= n 0)
    acc
    (sumEscaped (- n 1) (+ acc (readA (keep n))))
  )
)

(:: sumCast (-> Int Int Int Int))

(fn (sumCast v n acc)
  (if (<= n 0)
    acc
    (sumCast v (- n 1) (+ acc (viaCast v n)))
  )
)

(:: sumLambda (-> Int Int Int))

(fn (sumLambda n acc)
  (if (<= n 0)
    acc
    (sumLambda (- n 1) (+ acc (viaLambda n)))
  )
)

(:: grew (-> Int Int Bool))

(fn (grew before after) (> (- after before) 100000))

(:: main Int)

(fn (main)
  (let (
    (mut acc 0)
    (mut steps 0)
  )
    {
      (let ((b1 (memAlloc 200)))
        {
          (sumDropped 20000 0)
          (let ((b2 (memAlloc 200)))
            (set acc (+ acc (* 4 (b2i (< (- b2 b1) 4096)))))
          )
          (set steps (+ steps 1))
        }
      )
      (let ((c1 (memAlloc 200)))
        {
          (sumPassed 20000 0)
          (let ((c2 (memAlloc 200)))
            (set acc (+ acc (* 8 (b2i (< (- c2 c1) 4096)))))
          )
          (set steps (+ steps 1))
        }
      )
      (let ((d1 (memAlloc 200)))
        {
          (sumEscaped 5000 0)
          (let ((d2 (memAlloc 200)))
            (set acc (+ acc (* 16 (b2i (< (- d2 d1) 4096)))))
          )
          (set steps (+ steps 1))
        }
      )
      (let (
        (v vecNew)
        (e1 (memAlloc 200))
      )
        {
          (sumCast v 5000 0)
          (let ((e2 (memAlloc 200)))
            (set acc (+ acc (* 32 (b2i (grew e1 e2)))))
          )
          (set steps (+ steps 1))
        }
      )
      (let ((f1 (memAlloc 200)))
        {
          (sumLambda 5000 0)
          (let ((f2 (memAlloc 200)))
            (set acc (+ acc (* 64 (b2i (grew f1 f2)))))
          )
          (set steps (+ steps 1))
        }
      )
      (set acc (+ acc (* 2 (b2i (== (score 7) 14)))))
      (set steps (+ steps 1))
      (if (== steps 6)
        (+ acc 1)
        acc
      )
    }
  )
)
