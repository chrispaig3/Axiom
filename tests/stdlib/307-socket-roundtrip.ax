; A socket, end to end, in one process and with no client beside it.
;
; This is the case that says "a service can open a port". It walks the
; whole surface `Net` offers - address build, listen, non-blocking
; accept, connect, accept, shutdown, close - and every step asserts, so
; a number that is wrong on one platform shows up here rather than in a
; server six months later.
;
; NO EXTERNAL CLIENT. The process connects to its own listener: a
; loopback connect lands the connection in the kernel's accept queue
; whether or not it has completed, so the accept that follows answers a
; real stream. `tests/stdlib/305-path-search.ax` runs itself as a CHILD
; to get what it needs; this one needs less than that, and a case with
; no second process cannot flake on one.
;
; THE PORT COMES FROM THE PID because the gates run cases in parallel
; and a fixed port would make two of them fight over one number.
;
; THE GOLDEN IS PLATFORM-INDEPENDENT. `sockaddrHasLenByte` decides
; whether the address opens with a length byte, and `eAgain` is 35 on
; Darwin against 11 on Linux. So the case asserts the PROPERTY - that a
; non-blocking accept with nothing pending answers "would block" - and
; prints only `ok` or `FAIL`.
(import IO)
(import Sys)
(import Err)
(import Net)

(:: say (-> Bool String Int))
;@axiom:effect(io)
(fn (say good label)
  (if good
    (println (concat "ok   " label))
    (println (concat "FAIL " label))))

; Whether an answer is the "nothing yet" refusal of a non-blocking call.
(:: wouldBlock (-> (Result a Error) Bool))
(fn (wouldBlock r)
  (match r
    ((Ok _) false)
    ((Err e) (netWouldBlock (- 0 e.code)))))

; Accept, allowing for the connection not having landed on the queue
; yet: a loopback `connect` returns once the kernel has taken it, which
; is not quite the instant a non-blocking `accept` can see it. The retry
; is bounded, because a case that hangs on a broken accept is worse
; than one that fails.
(:: acceptSoon (-> TcpListener Int (Result TcpStream Error)))
;@axiom:effect(io)
(fn (acceptSoon lsn tries)
  (let ((r (tcpAccept lsn)))
    (if (&& (wouldBlock r) (> tries 0))
      (acceptSoon lsn (- tries 1))
      r)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((port (+ 20000 (% sysPid 10000))))
    (match (socketAddrV4 127 0 0 1 port)
      ((Err e) (say false "the address builds"))
      ((Ok addr)
        {
          ; The address builder is the one place the two sockaddr layouts
          ; differ, so check the bytes it wrote: the family must land
          ; where this platform keeps it, and the port must be big-endian.
          (let ((b addr.bytes))
            {
              (say
                (if (== sockaddrHasLenByte 1)
                  (&& (== (strByte b 0) 16) (== (strByte b 1) afInet))
                  (&& (== (strByte b 0) afInet) (== (strByte b 1) 0)))
                "the address family lands where this platform keeps it")
              (say
                (&& (== (strByte b 2) (& (>> port 8) 255)) (== (strByte b 3) (& port 255)))
                "the port is written big-endian")
            })
          (match (tcpListen addr)
            ((Err e) (say false "listen on 127.0.0.1 is accepted"))
            ((Ok lsn)
              {
                (say true "listen on 127.0.0.1 is accepted")
                (say (isOk (tcpListenerSetNonBlocking lsn true)) "the listener goes non-blocking")
                ; Nothing has connected yet, so this must be the "not yet"
                ; answer and not a failure - the distinction the whole
                ; event loop is built on.
                (say (wouldBlock (tcpAccept lsn)) "accept with nothing pending would block")
                (match (tcpConnect addr)
                  ((Err e) (say false "connect to our own listener is accepted"))
                  ((Ok cli)
                    {
                      (say true "connect to our own listener is accepted")
                      (match (acceptSoon lsn 1000)
                        ((Err e) (say false "accept answers the connected stream"))
                        ((Ok con)
                          {
                            (say true "accept answers the connected stream")
                            (say (isOk (tcpShutdown con shutBoth)) "shutdown closes both directions")
                            (let ((_ (tcpClose con))) 0)
                          }))
                      (let ((_ (tcpClose cli))) 0)
                    }))
                (say (isOk (tcpListenerClose lsn)) "the listener closes")
              }))
          0
        }))))
