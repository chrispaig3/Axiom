; Rust reads an Axiom `Str` with no copy.
;
; The value Axiom holds is the address of a three-word `{len, ptr,
; owner}` run (stdlib/Str.ax: strLen reads word 0, strData word 1,
; strOwner word 2). `AxStr` in `rust/axiom-abi` reads exactly those
; words, so the `&str` the shim sees points at Axiom's own bytes.
;
; The borrow is valid for the CALL and no longer: ARC may release the
; block the moment the call returns.
(import IO)

(import Fmt)

(pub extern "axiom_demo"
  (countVowels :: (-> String Int) (symbol "axffi_count_vowels")))

;@axiom:effect(io)
(pub fn (main)
  {
    (println (fmtInt (countVowels "hello world")))
    ; The empty string is the edge that a length-then-pointer reader gets
    ; wrong: `data` may be null and `len` 0.
    (println (fmtInt (countVowels "")))
    0
  }
)
; expect 0
