; Differential: the same arithmetic in Axiom and in Rust must agree.
;
; A smoke test that prints 42 proves the call happened. This proves the
; ANSWER is right, which is the part a wrong wire representation breaks
; silently - a sign-extension mistake or a swapped argument order both
; still "work".
;
; Exit 0 on agreement, 1 on any disagreement.
(import IO)

(import Fmt)

(pub extern "axiom_demo"
  (add :: (-> Int Int Int) (symbol "axffi_add")))

(pub :: agrees (-> Int Int Bool))

(pub fn (agrees a b) (== (add a b) (+ a b)))

;@axiom:effect(io)
(pub fn (main)
  (if (&& (agrees 20 22) (&& (agrees 0 0) (&& (agrees (- 0 7) 7) (&& (agrees 1000000 2000000) (agrees (- 0 1) (- 0 1))))))
    {
      (println "int: agree")
      0
    }
    {
      (println "int: DISAGREE")
      1
    }
  )
)
; expect 0
