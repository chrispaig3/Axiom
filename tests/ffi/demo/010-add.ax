; The smallest crossing there is: one scalar in each direction.
;
; The emitted call is `call i64 @axffi_add(i64 20, i64 22)` - the same
; instruction sequence an internal Axiom call compiles to. There is no
; trampoline and nothing to marshal, which is the whole consequence of
; Axiom having no VM.
(import IO)
(import Fmt)

(pub extern "axiom_demo"
  (add :: (-> Int Int Int) (symbol "axffi_add")))

;@axiom:effect(io)
(pub fn (main) { (println (fmtInt (add 20 22))) 0 })
; expect 0
