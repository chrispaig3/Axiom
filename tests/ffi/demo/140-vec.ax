; Vectors across the boundary, both ways.
;
; OUT: `rangeVec` is a Rust `Vec<i64>` return. The shim writes
; `(ptr, len)` of words into the out-cell; the wrapper pushes each
; word into an Axiom `Vec` (`ffiWordsToVec`) and hands the Rust buffer
; back (`ffiFreeWords` -> `axffi_free_words`). `splitWords` is a
; `Vec<String>`: the cell holds `(pairs, n)`, `2n` words of
; `(bytesPtr, byteLen)`; every string is COPIED into an Axiom String
; (`ffiStrsToVec`) and the whole list freed at once
; (`ffiFreeStrList` -> `axffi_free_str_list`). A Vec is an `Int`
; handle in the stdlib, so both wrappers answer `Int`.
;
; IN: `sumWords` takes a `&[i64]`. Axiom passes the `Vec` handle and
; Rust reads the header in place - len at word 0, data at word 2 - for
; the call; nothing is copied and nothing is retained.
;
; The empty cases matter: a zero-length `Vec<i64>` crosses as a
; dangling pointer and length 0, which the free must treat as nothing.
(import IO)

(import Fmt)

(import Str)

(import Vec)

(import Demo)

; `vecGet` answers the raw word - a `Vec` carries no element type - so
; reading the String the wrapper pushed is `vecGetStr`, which says so.
(pub :: wordAt (-> Int Int String))

(pub fn (wordAt v i) (vecGetStr v i))

(pub :: sumVec (-> Int Int Int Int))

(pub fn (sumVec v i acc)
  (if (>= i (vecLen v))
    acc
    (sumVec v (+ i 1) (+ acc (vecGet v i)))
  )
)

;@axiom:effect(io)
(pub fn (main)
  (let (
    (r (rangeVec 5))
    (none (rangeVec 0))
    (ws (splitWords "hello  brave new world"))
    (mine vecNew)
  )
    {
      (vecPush mine 40)
      (vecPush mine 2)
      (let (
        (rLen (vecLen r))
        (rSum (sumVec r 0 0))
        (rLast (vecGet r 4))
        (noneLen (vecLen none))
        (wLen (vecLen ws))
        (w2 (wordAt ws 2))
        (total (sumWords mine))
        (back (sumWords r))
        (empty (sumWords none))
      )
        (if (&& (== rLen 5) (&& (== rSum 10) (&& (== rLast 4) (&& (== noneLen 0) (&& (== wLen 4) (&& (strEq w2 "new") (&& (== total 42) (&& (== back 10) (== empty 0)))))))))
          {
            (println "vec: agree")
            0
          }
          {
            (println (fmtInt rLen))
            (println (fmtInt rSum))
            (println (fmtInt rLast))
            (println (fmtInt noneLen))
            (println (fmtInt wLen))
            (println w2)
            (println (fmtInt total))
            (println (fmtInt back))
            (println (fmtInt empty))
            1
          }
        )
      )
    }
  )
)
; expect 0
