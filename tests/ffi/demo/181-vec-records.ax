; Records in Vecs, both ways.
;
; OUT: a Rust `Vec<Point>` result is `n * ARITY` words behind a
; `(ptr, n)` cell - element-major, field order - and the generated
; module's own `__pointFromWords` loop rebuilds each `(Point w0 (cast
; Float w1))` with `ffiWordAt` before freeing the words as `n * 2`.
;
; IN: a `&[Point]` parameter is a `Vec` of `Point`s on this side; the
; wrapper flattens it (`__pointToWords`) into a fresh words `Vec` of
; two words per element and passes that handle, which the shim chunks
; back through `from_words`. `Result<Vec<Point>, String>` carries the
; same words behind the status word.
(import IO)

(import Fmt)

(import Str)

(import Vec)

(import Err)

(import Demo)

(pub :: px (-> Int Int Int))

(pub fn (px v i)
  (match (cast Point (vecGet v i))
    ((Point x _) x)
  )
)

(pub :: py (-> Int Int Float))

(pub fn (py v i)
  (match (cast Point (vecGet v i))
    ((Point _ y) y)
  )
)

(pub :: tryLen (-> (Result Int String) Int))

(pub fn (tryLen r)
  (match r
    ((Ok v) (vecLen v))
    ((Err _) -1)
  )
)

(pub :: tryMsg (-> (Result Int String) String))

(pub fn (tryMsg r)
  (match r
    ((Ok _) "")
    ((Err m) m)
  )
)

;@axiom:effect(io)
(pub fn (main)
  (let ((ps vecNew))
    {
      (vecPush ps (Point 1 0.5))
      (vecPush ps (Point -2 1.25))
      (vecPush ps (Point 7 0.0))
      (let (
        (scaled (pointsScale ps 4))
        (none (pointsScale vecNew 4))
        (rev (pointsTry ps))
        (bad (pointsTry vecNew))
      )
        (let (
          (n (vecLen scaled))
          (x0 (px scaled 0))
          (y0 (py scaled 0))
          (x1 (px scaled 1))
          (y1 (py scaled 1))
          (x2 (px scaled 2))
          (noneLen (vecLen none))
          (revLen (tryLen rev))
          (revX0 (match rev
            ((Ok v) (px v 0))
            ((Err _) 0)
          ))
          (revY2 (match rev
            ((Ok v) (py v 2))
            ((Err _) 9.0)
          ))
          (badLen (tryLen bad))
          (msg (tryMsg bad))
        )
          (if (&& (== n 3) (&& (== x0 4) (&& (== y0 2.0) (&& (== x1 -8) (&& (== y1 5.0) (&& (== x2 28) (&& (== noneLen 0) (&& (== revLen 3) (&& (== revX0 7) (&& (== revY2 0.5) (&& (== badLen -1) (strEq msg "no points"))))))))))))
            {
              (println "vec records: agree")
              0
            }
            {
              (println (fmtInt n))
              (println (fmtInt x0))
              (println (fmtFloat y0))
              (println (fmtInt x1))
              (println (fmtFloat y1))
              (println (fmtInt x2))
              (println (fmtInt noneLen))
              (println (fmtInt revLen))
              (println (fmtInt revX0))
              (println (fmtFloat revY2))
              (println (fmtInt badLen))
              (println msg)
              1
            }
          )
        )
      )
    }
  )
)
; expect 0
