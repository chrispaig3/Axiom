; Bound to the deliberately-leaky crate. This program is CORRECT - it
; compiles, links and runs - and `scripts/check-ffi.sh` still fails it,
; because the crate imports symbols its `axiom-allow.txt` does not
; permit. The gate requires that failure.
(import IO)
(import Fmt)

(pub extern "axiom_leaky"
  (homeLen :: Int (symbol "axffi_home_len")))

;@axiom:effect(io)
(pub fn (main) { (println (fmtInt (if (>= homeLen 0) 1 0))) 0 })
; expect 0
