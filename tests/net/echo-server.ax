; The echo server `scripts/check-net.sh` drives, and the first program
; in this tree whose memory is the thing being measured rather than its
; answer.
;
; It is a pre-forked pool: one listening socket created before the fork
; and inherited by every worker, each worker waiting on a readiness
; descriptor that carries both the listener and SIGTERM. That much is
; `tests/stdlib/311-preforked-server.ax` at scale.
;
; WHAT IS NEW HERE IS THE ARENA, AND IT IS A FLAG SO THE GATE CAN RUN
; BOTH WAYS. Every connection does real allocating work - it builds a
; kilobyte response by repeated `strConcat`, which is the quadratic
; shape `render.ax`'s `ctlEsc` was, so one connection allocates about
; 16 KiB and none of it is reachable once the socket closes. Under a
; bump allocator that never frees, ten thousand of those is a hundred
; and sixty megabytes of watermark. With `__axiom_arena_mark` before
; the work and `__axiom_arena_reset` after it, the watermark rewinds
; every connection and the worker holds flat.
;
; That is the plan's whole bet about backend services stated as a
; program: a request handler is an arena scope, and the memory model
; does not need reference counting to be finished before a stateless
; service can run. `measure-memory-baseline.sh`'s own header names
; "every compiler pass, request handler and macro expansion" as the
; same shape; this is the request handler.
;
; ARGV: <port> <workers> <arena 0|1> <varied 0|1>
;
; ENV: AXIOM_NET_LISTEN6=1 listens on `::1` instead of 127.0.0.1
;      AXIOM_NET_PEER=1    prints `peer <address>:<port>` per connection
;
; THOSE TWO ARE ENVIRONMENT AND NOT ARGUMENTS, and the split is the
; same one the gate makes. The four positional arguments are what a
; worker pool IS - which port, how many workers, whether the handler is
; a scope, how the load varies - and they are the axes the memory
; measurement moves along. The two above are which of the address arms
; is being run, and putting them in the same list would put a
; measurement's switches beside the thing being measured.
;
; The parent prints one line - `pids p1 p2 ...` - and then waits. The
; driver reads that line to know whom to measure and whom to stop.
(import IO)

(import Sys)

(import Err)

(import Mem)

(import Str)

; A decimal Int from a String. There is no parser in the standard
; library and this needs three numbers off the command line, so it
; carries its own: digits only, no sign, no overflow check, because the
; only caller is the gate beside it.
(:: parseInt (-> String Int))

(fn (parseInt s)
  (let ((mut i 0))
    (let ((mut v 0))
      {
        (while (< i (strLen s))
          {
            (let ((c (strByte s i)))
              (if (if (>= c 48)
                (<= c 57)
                false
              )
                (set v (+ (* v 10) (- c 48)))
                0
              )
            )
            (set i (+ i 1))
          })
        v
      }
    )
  )
)

; Whether an environment variable is set to exactly "1". `sysEnv`
; answers "" for a variable that is not set, so an unset name and a
; name set to anything else both read as off - the gate sets these to
; "1" or does not set them at all.
(:: envOn (-> String Bool))

;@axiom:effect(io)
(fn (envOn name) (strEq (sysEnv name) "1"))

; The per-connection work, and the reason this file exists. The response
; is built by repeated concatenation, so the intermediates are garbage
; the instant the next one is made - about 16 KiB of it per call, none
; reachable after the write.
(:: respond (-> Int Int Int Int))

;@axiom:effect(io)
(fn (respond con byte reps)
  (let ((mut s ""))
    (let ((mut i 0))
      {
        (while (< i reps)
          {
            (set s (strConcat s "0123456789abcdef0123456789abcdef"))
            (set i (+ i 1))
          })
        ; The response the client checks is the byte it sent. The
        ; kilobyte above is not written anywhere: it is the ALLOCATION
        ; this case exists to measure, and writing it would measure the
        ; socket instead. `strLen` is what keeps it from being dead.
        (if (> (strLen s) 0)
          (sysWriteFd con byte 1)
          0
        )
      }
    )
  )
)

; `reportPeer` costs an address buffer and a `socklen_t` cell per
; WORKER, allocated here beside the poll buffers and therefore above
; every arena mark - so the peer arm does not add anything the reset
; has to rewind, and the memory arms measure the same handler whether
; it is on or off.
(:: serve (-> Int Int Int Bool Int))

;@axiom:effect(io)
(fn (serve lsn arenaOn varied reportPeer)
  (let (
    (rec (memAlloc 64))
    (ts (memAlloc 16))
    (peer (memAlloc netAddrMaxBytes))
    (lenb (memAlloc 8))
  )
    (let ((setbuf (memAlloc 16)))
      (let ((scratch (memAlloc 256)))
        (let ((buf (memAlloc (netPollBufBytes 64))))
          (let ((byte (memAlloc 8)))
            (let ((pfd netPollCreate))
              (let ((mut served 0))
                (let ((mut running 1))
                  {
                    (if (< (netPollAddRead pfd lsn rec) 0)
                      (sysExitWith 255)
                      0
                    )
                    (let ((sh (netSignalOpen pfd (sysSigBit sigTerm) rec setbuf)))
                      (while (== running 1)
                        (let ((n (netPollWait
                          pfd                          buf                          64                          10000                          ts
                        )))
                          (if (< n 1)
                            (set running 0)
                            (let ((mut e 0))
                              (while (< e n)
                                {
                                  (if (>= (netPollSignalAt buf e sh scratch) 0)
                                    (set running 0)
                                    (let ((con 
                                      (if reportPeer
                                        (netAcceptFrom lsn peer netAddrMaxBytes lenb)
                                        (netAccept lsn)
                                      )
                                    ))
                                      (if (< con 0)
                                        0
                                        ; EVERYTHING THE CONNECTION
                                        ; ALLOCATES IS ABOVE THIS MARK.
                                        ; The poll buffers and the
                                        ; listener were allocated
                                        ; before it and survive the
                                        ; reset; nothing built while
                                        ; answering does.
                                        {
                                          (let ((m __axiom_arena_mark))
                                            {
                                              (netSetBlocking con)
                                              ; INSIDE THE MARK, so the
                                              ; rendering is garbage
                                              ; the reset takes with
                                              ; everything else the
                                              ; connection allocated.
                                              ; The address itself was
                                              ; written into `peer` by
                                              ; the accept above, which
                                              ; is memory the worker
                                              ; owns.
                                              (if reportPeer
                                                (printlnLit (strCStr (strConcat "peer " (netAddrTextPort peer))))
                                                0
                                              )
                                              (if (== (sysReadFd con byte 1) 1)
                                                (respond
                                                  con                                                  byte                                                  (if (== varied 1)
                                                    (+ 8 (* 32 (% served 16)))
                                                    32
                                                  )
                                                )
                                                0
                                              )
                                              (sysCloseFd con)
                                              (if (== arenaOn 1)
                                                (__axiom_arena_reset m)
                                                0
                                              )
                                            }
                                          )
                                          (set served (+ served 1))
                                        }
                                      )
                                    )
                                  )
                                  (set e (+ e 1))
                                })
                            )
                          )
                        ))
                    )
                    (sysCloseFd pfd)
                    served
                  }
                )
              )
            )
          )
        )
      )
    )
  )
)

(:: main Int)

;@axiom:effect(io)
(fn (main)
  (let ((port (parseInt (sysArg 1))))
    (let ((nworkers (parseInt (sysArg 2))))
      (let ((arenaOn (parseInt (sysArg 3))))
        (let ((varied (parseInt (sysArg 4))))
          (let ((addr (memAlloc netAddrMaxBytes)))
            (let (
              (setbuf (memAlloc 16))
              (optb (memAlloc 4))
            )
              (let ((pids vecNew))
                (let ((v6 (envOn "AXIOM_NET_LISTEN6")))
                  (let ((lsn 
                    (if v6
                      netSocketTcp6
                      netSocketTcp
                    )
                  ))
                    {
                      (netSetOptInt
                        lsn                        solSocket                        soReuseAddr                        1                        optb
                      )
                      ; The address decides the length `netBind` passes,
                      ; so the only thing that changes between the two
                      ; families here is which builder writes the buffer.
                      (if v6
                        (netAddr6
                          addr                          port                          0                          0                          0                          0                          0                          0                          0                          1
                        )
                        (netAddr4
                          addr                          port                          127                          0                          0                          1
                        )
                      )
                      ; A FAILED BIND USED TO EXIT SILENTLY, and the
                      ; only thing the gate could then say was that no
                      ; `pids` line ever appeared - true of a wrong
                      ; address family, a wrong address length, a port
                      ; already taken and a listener that was never
                      ; created. All four now name themselves here: a
                      ; negative `socket` means the family was refused
                      ; at `socket`, and `rc` with the address and the
                      ; length it asked for distinguishes the rest.
                      (let ((rc (netBind lsn addr)))
                        (if (!= rc 0)
                          {
                            (printlnLit (strCStr (strConcat (strConcat "bind failed: rc " (fmtInt rc)) (strConcat (strConcat " socket " (fmtInt lsn)) (strConcat (strConcat " addr " (netAddrText addr)) (strConcat " len " (fmtInt (netAddrSize addr))))))))
                            (sysExitWith 2)
                          }
                          0
                        )
                      )
                      (netListen lsn 512)
                      (netSetNonBlocking lsn)
                      (sysSignalBlock (sysSigBit sigTerm) setbuf)
                      (let ((mut w 0))
                        (while (< w nworkers)
                          {
                            (let ((pid sysForkProcess))
                              (if (== pid 0)
                                (sysExitWith (serve lsn arenaOn varied (envOn "AXIOM_NET_PEER")))
                                (vecPush pids pid)
                              )
                            )
                            (set w (+ w 1))
                          })
                      )
                      ; One line the driver parses, then this process does
                      ; nothing but reap - it holds no connection and its own
                      ; RSS is not the measurement.
                      (let ((mut s "pids"))
                        (let ((mut k 0))
                          {
                            (while (< k (vecLen pids))
                              {
                                (set s (strConcat s (strConcat " " (fmtInt (vecGet pids k)))))
                                (set k (+ k 1))
                              })
                            (printlnLit (strCStr s))
                          }
                        )
                      )
                      (sysCloseFd lsn)
                      (let ((mut r 0))
                        (while (< r (vecLen pids))
                          {
                            (unwrapOr (sysWaitPid (vecGet pids r)) 0)
                            (set r (+ r 1))
                          })
                      )
                      0
                    }
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
