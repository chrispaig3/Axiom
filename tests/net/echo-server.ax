; The echo server `scripts/check-net.sh` drives, and the first program
; in this tree whose memory is the thing being measured rather than its
; answer.
;
; It is a pre-forked pool: one listening socket created before the fork
; and inherited by every worker, each worker waiting on a `Poller` that
; watches both the listener and SIGTERM. That much is
; `tests/stdlib/311-preforked-server.ax` at scale.
;
; WHAT IS NEW HERE IS THE ARENA, AND IT IS A FLAG SO THE GATE CAN RUN
; BOTH WAYS. Every connection does real allocating work - it builds a
; kilobyte response the quadratic way repeated `concat` does, so one
; connection allocates about 16 KiB and none of it is reachable once
; the socket closes. The blocks are raw, the class of garbage only the
; arena reclaims (see `respond`), so without the reset ten thousand
; connections are a hundred and sixty megabytes of watermark. With a
; mark before the work and `__axiom_arena_reset` after it, the
; watermark rewinds every connection and the worker holds flat.
;
; That is the plan's whole bet about backend services stated as a
; program: a request handler is an arena scope, and the memory model
; does not need reference counting to be finished before a stateless
; service can run. `measure-memory-baseline.sh`'s own header names
; "every compiler pass, request handler and macro expansion" as the
; same shape; this is the request handler.
;
; ARGV: <port> <workers> <arena 0|1> <varied 0|1>
;
; ENV: AXIOM_NET_LISTEN6=1 listens on `::1` instead of 127.0.0.1
;      AXIOM_NET_PEER=1    prints `peer <address>:<port>` per connection
;
; THOSE TWO ARE ENVIRONMENT AND NOT ARGUMENTS, and the split is the
; same one the gate makes. The four positional arguments are what a
; worker pool IS - which port, how many workers, whether the handler is
; a scope, how the load varies - and they are the axes the memory
; measurement moves along. The two above are which of the address arms
; is being run, and putting them in the same list would put a
; measurement's switches beside the thing being measured.
;
; The parent prints one line - `pids p1 p2 ...` - and then waits. The
; driver reads that line to know whom to measure and whom to stop.
(import IO)
(import Sys)
(import Err)
(import Mem)
(import Str)
(import Vec)
(import Net)

; The `i`th command-line argument as a decimal Int, or 0 when it is
; not one.
(:: argInt (-> Int Int))
;@axiom:effect(io)
(fn (argInt i)
  (match (strParseInt (sysArg i))
    ((Some v) v)
    ((None) 0)))

; Whether an environment variable is set to exactly "1". `sysEnv`
; answers "" for a variable that is not set, so an unset name and a
; name set to anything else both read as off - the gate sets these to
; "1" or does not set them at all.
(:: envOn (-> String Bool))
;@axiom:effect(io)
(fn (envOn name)
  (strEq (sysEnv name) "1"))

; The per-connection work, and the reason this file exists. Each step
; allocates a block one piece longer than the last and copies the last
; into it, which is what `(set s (concat s piece))` does - about 16 KiB
; per call, none of it reachable after the write.
;
; THE BLOCKS ARE RAW, BECAUSE COUNTING RECLAIMS `concat`. A `mut` slot
; owns what it holds (MM-LIFE-2c event 3), so each `set` of a string
; gives the previous one back, and the same loop over strings holds flat
; with the arena off: the gate's unscoped arm would have nothing to
; show. `memAlloc` hands a block out at count zero, which no release
; frees, so these blocks are the class of garbage the arena exists for
; (MM-ALLOC-22): what counting can't see, like the language server's
; per-message AST.
;
; The response the client checks is the byte it sent. The kilobyte is
; not written anywhere: it is the ALLOCATION this case exists to
; measure, and writing it would measure the socket instead. Every byte
; of it is stored, so its pages are resident and RSS sees them.
(:: respond (-> TcpStream String Int Int))
;@axiom:effect(io)
(fn (respond con byte reps)
  (let (
    (piece "0123456789abcdef0123456789abcdef")
    (mut s 0)
    (mut n 0)
    (mut i 0)
  )
    {
      (while (< i reps)
        (let ((next (memAlloc (+ n 32))))
          {
            (memCopy next s n)
            (memCopy (+ next n) (strData piece) 32)
            (set s next)
            (set n (+ n 32))
            (set i (+ i 1))
          }))
      (if (> n 0)
        (match (tcpWrite con byte)
          ((Ok k) k)
          ((Err e) 0))
        0)
    }))

; One connection, start to finish: 1 when one was taken, 0 when a
; sibling took it first. EVERYTHING IT ALLOCATES - the stream, the peer
; line, the byte, the response's blocks - is above the caller's arena
; mark, and every binding that holds any of it ends when this function
; returns, before the caller resets.
(:: handleOne (-> TcpListener ReadBuffer Int Bool Int))
;@axiom:effect(io)
(fn (handleOne lsn byte reps reportPeer)
  (match (tcpAccept lsn)
    ((Err e) 0)
    ((Ok con)
      {
        (if reportPeer
          (match (tcpPeerAddr con)
            ((Ok peer) (println (concat "peer " (socketAddrText peer))))
            ((Err e) 0))
          0)
        (if (==
          (match (tcpRead con byte 0 1)
            ((Ok k) k)
            ((Err e) (- 0 e.code)))
          1)
          (respond con (readBufferText byte 0 1) reps)
          0)
        (let ((_ (tcpClose con))) 0)
        1
      })))

; A worker: serve until SIGTERM. The poller, the one-byte buffer and the
; mark cell are allocated here, above every arena mark, so no reset
; reclaims them.
;
; THE MARK CELL IS PER WORKER TOO. `__axiom_arena_mark` allocates its
; cell below the position it records, so no reset reclaims it
; (MM-ALLOC-12): a mark per connection leaves a cell per connection,
; hundreds of KB over ten thousand of them, in both arms alike.
; `__axiom_arena_mark_into` refreshes one cell allocated here instead.
(:: serve (-> TcpListener Int Int Bool Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (serve lsn arenaOn varied reportPeer)
  (let (
    (markCell (memAlloc 32))
    (byte (readBufferNew 1))
  )
    (match (pollerNew 64)
      ((Err e) (sysExitWith 255))
      ((Ok p)
        (let (
          (mut served 0)
          (mut running 1)
        )
          {
            (if (isErr (pollerAddListener p lsn 1))
              (sysExitWith 255)
              0)
            ; A worker that cannot watch SIGTERM still serves; it leaves
            ; on the wait's ten-second timeout instead.
            (let ((_ (pollerAddSignals p (sysSigBit sigTerm) 2))) 0)
            (while (== running 1)
              (let ((n
                (match (pollerWait p 10000)
                  ((Ok k) k)
                  ((Err e) (- 0 e.code)))))
                (if (< n 1)
                  (set running 0)
                  (let ((mut e 0))
                    (while (< e n)
                      {
                        (match (pollerSignal p e)
                          ((Some sig) (set running 0))
                          ((None)
                            (let ((m (__axiom_arena_mark_into markCell)))
                              {
                                (set served (+ served (handleOne
                                  lsn
                                  byte
                                  (if (== varied 1)
                                    (+ 8 (* 32 (% served 16)))
                                    32)
                                  reportPeer)))
                                (if (== arenaOn 1)
                                  (__axiom_arena_reset m)
                                  0)
                              })))
                        (set e (+ e 1))
                      })))))
            served
          })))))

; The address to listen on: 127.0.0.1, or ::1 under AXIOM_NET_LISTEN6.
(:: listenAddr (-> Bool Int (Result SocketAddr Error)))
(fn (listenAddr v6 port)
  (if v6
    (let ((g vecNew))
      {
        (for i in 0..7
          (vecPush g 0))
        (vecPush g 1)
        (socketAddrV6 g port)
      })
    (socketAddrV4 127 0 0 1 port)))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (let (
    (port (argInt 1))
    (nworkers (argInt 2))
    (arenaOn (argInt 3))
    (varied (argInt 4))
    (setbuf (memAlloc 16))
    (pids vecNew)
    (v6 (envOn "AXIOM_NET_LISTEN6"))
  )
    (match (listenAddr v6 port)
      ((Err e)
        {
          (println (concat "address failed: " (errorText e)))
          (sysExitWith 2)
        })
      ((Ok addr)
        ; A FAILED LISTEN NAMES ITSELF: the operation and the errno, with
        ; the address and the length it asked for, so a wrong family, a
        ; wrong length and a port already taken read differently.
        (match (tcpListen addr)
          ((Err le)
            {
              (println (concat (concat (concat (errorText le) " failed: errno ") (fmtInt le.code)) (concat (concat " addr " (socketAddrText addr)) (concat " len " (fmtInt (netAddrSize (strData addr.bytes)))))))
              (sysExitWith 2)
            })
          ((Ok lsn)
            {
              (let ((_ (tcpListenerSetNonBlocking lsn true))) 0)
              (let ((_ (sysSignalBlock (sysSigBit sigTerm) setbuf))) 0)
              (let ((mut w 0))
                (while (< w nworkers)
                  {
                    (let ((pid sysForkProcess))
                      (if (== pid 0)
                        (sysExitWith (serve lsn arenaOn varied (envOn "AXIOM_NET_PEER")))
                        {
                          (vecPush pids pid)
                          0
                        }))
                    (set w (+ w 1))
                  }))
              ; One line the driver parses, then this process does nothing
              ; but reap - it holds no connection and its own RSS is not
              ; the measurement.
              (let (
                (mut s "pids")
                (mut k 0)
              )
                {
                  (while (< k (vecLen pids))
                    {
                      (set s (concat s (concat " " (fmtInt (vecGet pids k)))))
                      (set k (+ k 1))
                    })
                  (println s)
                })
              (let ((_ (tcpListenerClose lsn))) 0)
              (let ((mut r 0))
                (while (< r (vecLen pids))
                  {
                    (unwrapOr (sysWaitPid (vecGet pids r)) 0)
                    (set r (+ r 1))
                  }))
              0
            }))))))
