; A transaction handle is finished by axqCommit or axqRollback, and
; using it again stops the program with status 85.
(import IO)
(import Err)
(import Axqlite)
(import AxqlKit)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((db (kitOpen "reuse.db")))
    (match (axqBegin db)
      ((Ok tx)
        {
          (kitRun "commit" (axqCommit tx))
          (println "committing it again")
          (kitRun "again" (axqCommit tx))
          (println "not reached")
          0
        }
      )
      ((Err e) 1))))
