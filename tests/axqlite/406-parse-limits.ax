; The parser's budgets: parentheses nest at most 200 deep, and a long
; run of operators or NOTs costs no stack while it parses.
(import IO)
(import Str)
(import Err)
(import Mem)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)

(:: repeat (-> String Int String))
;@axiom:effect(unsafe)
(fn (repeat s n)
  ; These fixed inputs fit in Int. Allocate their bytes once so input
  ; construction stays linear and the test measures the parser's budgets.
  (let ((len (strLen s)) (out (strAlloc (* (strLen s) n))))
    {
      (for i in 0..n
        (memCopy (+ (strData out) (* i len)) (strData s) len))
      out
    }))

(:: outcome (-> String String))
(fn (outcome text)
  (match (axqlParse text)
    ((Ok p) (concat "ok params=" (format p.paramCount)))
    ((Err e) (concat "error: " (errMessage e)))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (outcome (concat "SELECT " (concat (repeat "(" 200) (concat "1" (repeat ")" 200))))))
    (println (outcome (concat "SELECT " (concat (repeat "(" 201) (concat "1" (repeat ")" 201))))))
    (println (outcome (concat "SELECT " (concat (repeat "NOT " 100000) "1"))))
    (println (outcome (concat "SELECT " (concat (repeat "- " 100000) "1"))))
    (println (outcome (concat "SELECT 1" (repeat " + 1" 5000))))
    (println (outcome (concat "SELECT ?" (repeat ", ?" 32765))))
    (println (outcome (concat "SELECT ?" (repeat ", ?" 32766))))
    0
  })
