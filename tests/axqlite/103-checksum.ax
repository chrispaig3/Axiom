; The page and journal checksum is XXH64. Known answers, computed with
; the reference implementation (the `xxhash` package 4.0.1, which wraps
; the official C library): the empty input, one and three bytes, two
; 4096-byte pages under two seeds, a zero page's 4088 checked bytes
; under a page-number seed, 100 bytes under seed 12345, and a 4100-byte
; journal record under a 64-bit salt. The lengths cover every tail
; case: 0, 1, 3, 4088 (a multiple of 8), 100 (4 left over) and 4100.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Axqlite.Pager)
(import StoreTest)

(:: bytesOf (-> Int (-> Int Int) String))
;@axiom:effect(unsafe)
(fn (bytesOf n f)
  (let ((s (strAlloc n)))
    {
      (for i 0 n
        (__store8 (strData s) i (f i)))
      s
    }))

(:: kat (-> Tally String Int Int String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (kat t s seed want label)
  (let ((got (pagerChecksum (strData s) (strLen s) seed)))
    {
      (println
        (strConcat
          label
          (if (== got want)
            ": ok"
            ": WRONG")))
      (check t (== got want) label)
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t tallyNew))
    {
      (kat
        t
        ""
        0
        -1205034819632174695
        "empty")
      (kat
        t
        "a"
        0
        -3292477735350538661
        "a")
      (kat
        t
        "abc"
        0
        4952883123889572249
        "abc")
      (kat
        t
        (bytesOf
          4096
          (lambda (i) (& i 255)))
        0
        1111936925623318180
        "0..255 x16, seed 0")
      (kat
        t
        (bytesOf
          4096
          (lambda (i) (& i 255)))
        7
        -4251037386575793821
        "0..255 x16, seed 7")
      (kat
        t
        (bytesOf
          4088
          (lambda (i) 0))
        3
        -2866268706228892966
        "4088 zero bytes, seed 3")
      (kat
        t
        (bytesOf
          100
          (lambda (i) 120))
        12345
        -2452212549829815415
        "100 x's, seed 12345")
      (kat
        t
        (bytesOf
          4100
          (lambda (i) (& (+ (* i 37) 11) 255)))
        1311768467294899695
        2863889608626406036
        "a 4100-byte record, 64-bit seed")
      (tallyReport t "103-checksum")
    }))
