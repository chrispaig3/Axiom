; Records: every edge value round-trips exactly, alone and nested in
; an array and a document, and every malformed record answers
; axqCorrupt instead of garbage: each truncation, a trailing byte,
; each unknown tag, each overlong length, and 20000 damaged records.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Float)
(import Fmt)
(import Axqlite.Value)
(import Axqlite.Record)
(import StoreTest)
(import StoreValues)

(:: roundTrip (-> Tally Value String Int))
;@axiom:effect(io)
(fn (roundTrip t v label)
  (match (recEncode v)
    ((Err e) (check t false (concat "encode " label)))
    ((Ok rec)
      (match (recDecode rec)
        ((Err e) (check t false (concat "decode " label)))
        ((Ok back) (check t (sameValue v back) (concat "round trip " label)))))))

(:: isCorrupt (-> String Bool))
(fn (isCorrupt rec)
  (== (codeOf (recDecode rec)) axqCorrupt))

; A copy of `s` with byte `i` set to `b`.
(:: withByte (-> String Int Int String))
;@axiom:effect(unsafe)
(fn (withByte s i b)
  {
    (let c (strDup s))
    {
      (__store8 (strData c) i b)
      c
    }
  })

;; A damaged record: a random array of edge values with one to three
;; bytes changed, cut short or lengthened, or, every fourth case, a
;; short run of random bytes.
(:: fuzzCase (-> Rng Int (Vec Value) String))
;@axiom:effect(unsafe)
(fn (fuzzCase r i vals)
  (if (== (% i 4) 0)
    (rngBytes r (+ 1 (rngBelow r 30)) 256)
    {
      (let row vecNew)
      {
        (for k in 0..(rngBelow r 5)
          {
            (let v (vecGet vals (rngBelow r (vecLen vals))))
            (match v
              ((VFloat x)
                (if (! (floatIsNan x))
                  (vecPush row v)))
              (_ (vecPush row v)))
          })
        (match (recEncode (VArray row))
          ((Err e) "")
          ((Ok rec)
            {
              (let c (strDup rec))
              {
                (for k in 0..(+ 1 (rngBelow r 3))
                  (__store8 (strData c) (rngBelow r (strLen c)) (rngBelow r 256)))
                {
                  (let how (rngBelow r 3))
                  (if (== how 0)
                    (strSlice c 0 (rngBelow r (strLen c)))
                    (if (== how 1)
                      (concat c (rngBytes r (+ 1 (rngBelow r 4)) 256))
                      c))
                }
              }
            }
          ))
      }
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let t tallyNew)
    (let vals edgeValues)
    {
      ; each edge value alone, in an array, and in a document
      (for v in vals
        {
          (roundTrip t v (showValue v))
          (roundTrip t (VArray (vecPush vecNew v)) (concat "array of " (showValue v)))
        })
      (roundTrip t (VArray vals) "every edge value in one array")
      {
        (let fs vecNew)
        {
          (for (v i) in vals
            (vecPush fs (Field :name (concat "f" (fmtInt i)) :value v)))
          (roundTrip t (VObject fs) "every edge value in one document")
        }
      }
      {
        (let wide vecNew)
        {
          (for i in 0..3000
            (vecPush wide (VInt (* i 7919))))
          (roundTrip t (VArray wide) "3000 elements")
        }
      }
      ; -0.0 keeps its sign bit through a record
      (match (recEncode (VFloat (floatFromBits intMin)))
        ((Ok rec)
          (match (recDecode rec)
            ((Ok (VFloat x)) (check t (== (floatToBits x) intMin) "-0.0 keeps its sign"))
            (_ (check t false "-0.0 decode")))
        )
        ((Err e) (check t false "-0.0 encode")))
      ; a NaN is refused, nesting past 64 is refused, and a bad uuid
      (check t (== (codeOf (recEncode (VFloat floatNan))) axqType) "NaN refused")
      (check t (== (codeOf (recEncode (VUuid "short"))) axqType) "short uuid refused")
      {
        (let mut deep (VInt 1))
        {
          (for i in 0..70
            (set deep (VArray (vecPush vecNew deep))))
          (check t (== (codeOf (recEncode deep)) axqTooBig) "nested past 64 refused")
        }
      }
      ; every truncation of a record holding every edge value is
      ; corrupt, and so is the record with one byte more
      (match (recEncode (VArray vals))
        ((Ok rec)
          {
            (let n (strLen rec))
            (let mut corrupt 0)
            {
              (for k in 0..n
                (if (isCorrupt (strSlice rec 0 k))
                  (set corrupt (+ corrupt 1))))
              (check t (== corrupt n) "every truncation is corrupt")
              (check t (isCorrupt (concat rec "x")) "a trailing byte is corrupt")
              (println "a record of {n} bytes: {corrupt} truncations, all corrupt")
            }
          }
        )
        ((Err e) (check t false "encode every edge value")))
      ; every tag outside 0..12, at the value's first byte
      (match (recEncode (VText "abc"))
        ((Ok rec)
          {
            (let mut bad 0)
            {
              (for code in 13..256
                (if (isCorrupt (withByte rec 0 code))
                  (set bad (+ bad 1))))
              (check t (== bad 243) "every unknown tag is corrupt")
            }
            ; the length claiming more bytes than the record has
            (check t (isCorrupt (withByte rec 1 1)) "length beyond the record")
            (check t (isCorrupt (withByte rec 4 200)) "length beyond the record, last byte")
          }
        )
        ((Err e) (check t false "encode text")))
      ; damaged records: every answer is either corrupt, or a value
      ; that encodes back to exactly those bytes
      {
        (let r (rngNew 101))
        (let mut ok 0)
        (let mut corrupt 0)
        (let mut other 0)
        {
          (for i in 0..20000
            {
              (let s (fuzzCase r i vals))
              (match (recDecode s)
                ((Err e)
                  (if (== (errCode e) axqCorrupt)
                    (set corrupt (+ corrupt 1))
                    (set other (+ other 1)))
                )
                ((Ok v)
                  (match (recEncode v)
                    ((Ok again)
                      (if (strEq again s)
                        (set ok (+ ok 1))
                        (set other (+ other 1)))
                    )
                    ; a float holding a NaN's bits decodes, and can't
                    ; be re-encoded
                    ((Err e)
                      (if (== (errCode e) axqType)
                        (set ok (+ ok 1))
                        (set other (+ other 1)))
                    ))
                ))
            })
          (check t (== other 0) "damaged records: corrupt or canonical")
          (check t (> ok 100) "damaged records: some decode")
          (println "damaged records: {ok} decoded and re-encoded exactly, {corrupt} corrupt")
        }
      }
      (tallyReport t "101-record")
    }
  })
