; axqExecBatch runs a script in one transaction: all of it or none of
; it, inside a transaction the caller opened or in one of its own.
(import IO)
(import Err)
(import Vec)
(import Axqlite)
(import Axqlite.Value)
(import AxqlKit)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((db (kitOpen "batch.db")))
    {
      (kitRun "migration" (axqExecBatch db "\n        -- the first migration\n        CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL);\n        CREATE UNIQUE INDEX users_name ON users (name);\n        INSERT INTO users (name) VALUES ('ada'), ('bob');\n        UPDATE users SET name = 'bea' WHERE name = 'bob';\n      "))
      (kitDump db "SELECT id, name FROM users")
      (kitRun "fails at the third" (axqExecBatch db "\n        INSERT INTO users (name) VALUES ('cy');\n        CREATE TABLE extra (x INTEGER);\n        INSERT INTO users (name) VALUES ('ada');\n        INSERT INTO users (name) VALUES ('dee')"))
      (kitDump db "SELECT id, name FROM users")
      (kitRun "extra is gone" (axqExec db "SELECT x FROM extra"))
      (kitRun "a syntax error runs nothing" (axqExecBatch db "INSERT INTO users (name) VALUES ('eve'); SELEC 1"))
      (kitDump db "SELECT id, name FROM users")
      (kitRun "transaction control" (axqExecBatch db "BEGIN; INSERT INTO users (name) VALUES ('x'); COMMIT"))
      (kitRun "empty" (axqExecBatch db "  ;  -- nothing\n ;"))
      (kitRun "with a select" (axqExecBatch db "SELECT 1; INSERT INTO users (name) VALUES ('fay')"))
      (kitRun "begin" (axqExec db "BEGIN"))
      (kitRun "insert before" (axqExec db "INSERT INTO users (name) VALUES ('gil')"))
      (kitRun "batch inside, fails" (axqExecBatch db "INSERT INTO users (name) VALUES ('hal'); DELETE FROM users WHERE name = 'ada'; INSERT INTO users (name) VALUES ('gil')"))
      (println (axqInTransaction db))
      (kitDump db "SELECT id, name FROM users")
      (kitRun "batch inside, succeeds" (axqExecBatch db "INSERT INTO users (name) VALUES ('ivy'); DELETE FROM users WHERE name = 'fay'"))
      (kitRun "rollback" (axqExec db "ROLLBACK"))
      (kitDump db "SELECT id, name FROM users")
      (kitRun "close" (axqClose db))
      0
    }))
