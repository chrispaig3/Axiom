; Prepared statements: parameters by position and by name, their
; count, the wrong number of them, and which entry point runs what.
(import IO)
(import Err)
(import Vec)
(import Axqlite)
(import Axqlite.Value)
(import AxqlKit)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((db (kitOpen "p.db")))
    {
      (kitRun "create" (axqExec db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, score REAL)"))
      (match (axqPrepare db "INSERT INTO t (name, score) VALUES (?, ?)")
        ((Ok ins)
          {
            (println (axqParamCount ins))
            (println (axqStatementText ins))
            (kitRun "insert ada" (axqRun ins (vec2 (VText "ada") (VReal 1.5))))
            (kitRun "insert bob" (axqRun ins (vec2 (VText "bob") (VInt 2))))
            (kitRun "insert null" (axqRun ins (vec2 VNull VNull)))
            (kitRun "too few" (axqRun ins (vec1 (VText "x"))))
            (kitRun "too many" (axqRun ins (vec3 (VText "x") (VReal 1.0) VNull)))
            (kitRun "wrong type" (axqRun ins (vec2 (VInt 1) (VReal 1.0))))
            (kitRows "query an insert" (axqQuery ins (vec2 (VText "x") (VReal 1.0))))
            (println (axqLastInsertRowid db))
            (kitRun "finalize" (axqFinalize ins))
          }
        )
        ((Err e) (println (kitErrText e))))
      (match (axqPrepare db "SELECT id, name FROM t WHERE score > ?2 OR name = ?1 ORDER BY id")
        ((Ok q)
          {
            (println (axqParamCount q))
            (kitRows "positional" (axqQuery q (vec2 (VText "bob") (VReal 1.0))))
            (kitRun "run a query" (axqRun q (vec2 (VText "bob") (VReal 1.0))))
            (kitDone "index of a name" (axqParamIndex q ":x"))
            (kitRun "finalize" (axqFinalize q))
          }
        )
        ((Err e) (println (kitErrText e))))
      (match (axqPrepare db "SELECT name FROM t WHERE name = :who OR id = :id OR name = :who")
        ((Ok q)
          {
            (println (axqParamCount q))
            (kitRun ":who" (axqParamIndex q ":who"))
            (kitRun ":id" (axqParamIndex q ":id"))
            (kitRun ":nope" (axqParamIndex q ":nope"))
            (kitRun "who without colon" (axqParamIndex q "who"))
            (kitRows "named" (axqQuery q (vec2 (VText "ada") (VInt 3))))
            (kitRun "finalize" (axqFinalize q))
          }
        )
        ((Err e) (println (kitErrText e))))
      (kitDone "prepare a syntax error" (axqPrepare db "SELECT FROM t"))
      (kitDone "prepare a missing table" (axqPrepare db "SELECT a FROM nosuch"))
      (kitDone "prepare a missing column" (axqPrepare db "SELECT nosuch FROM t"))
      (kitDone "prepare two statements" (axqPrepare db "SELECT 1; SELECT 2"))
      (kitDone "prepare DDL for a missing table" (axqPrepare db "DROP TABLE nosuch"))
      (match (axqPrepare db "UPDATE t SET score = score * ? WHERE id = ?")
        ((Ok up)
          {
            (kitRun "update" (axqRun up (vec2 (VInt 10) (VInt 1))))
            (println (axqChanges db))
            (kitRun "update none" (axqRun up (vec2 (VInt 10) (VInt 99))))
            (println (axqChanges db))
            (kitRun "finalize" (axqFinalize up))
          }
        )
        ((Err e) (println (kitErrText e))))
      (kitDump db "SELECT * FROM t")
      (kitRun "exec with parameters" (axqExec db "SELECT ?"))
      (kitRun "close" (axqClose db))
      0
    }))
