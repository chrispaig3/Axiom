; A UNIQUE violation leaves the table exactly as it was: every row and
; every index entry, for an INSERT of several rows and an UPDATE of
; several rows, inside a transaction and outside one.
(import IO)
(import Err)
(import Vec)
(import Axqlite)
(import Axqlite.Value)
(import AxqlKit)

(:: state (-> Connection Int))
;@axiom:effect(io)
(fn (state db)
  {
    (kitDump db "SELECT id, email, n FROM u ORDER BY id")
    (kitDump db "SELECT id FROM u WHERE email >= 'a' ORDER BY email")
    0
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((db (kitOpen "uniq.db")))
    {
      (kitRun "create" (axqExec db "CREATE TABLE u (id INTEGER PRIMARY KEY, email TEXT, n INTEGER)"))
      (kitRun "index" (axqExec db "CREATE UNIQUE INDEX ue ON u (email)"))
      (kitRun "seed" (axqExec db "INSERT INTO u VALUES (1, 'a@x', 1), (2, 'b@x', 2), (3, 'c@x', 3)"))
      (state db)
      (kitRun "insert, third row clashes" (axqExec db "INSERT INTO u VALUES (4, 'd@x', 4), (5, 'e@x', 5), (6, 'b@x', 6)"))
      (state db)
      (kitRun "update, second row clashes" (axqExec db "UPDATE u SET email = 'z@x', n = n + 10 WHERE id >= 2"))
      (state db)
      (kitRun "begin" (axqExec db "BEGIN"))
      (kitRun "insert in a transaction" (axqExec db "INSERT INTO u VALUES (7, 'f@x', 7)"))
      (kitRun "insert clashing" (axqExec db "INSERT INTO u VALUES (8, 'g@x', 8), (9, 'f@x', 9)"))
      (kitRun "update clashing" (axqExec db "UPDATE u SET email = 'same' WHERE n > 0"))
      (kitRun "commit" (axqExec db "COMMIT"))
      (state db)
      (match (axqPrepare db "INSERT INTO u (email, n) VALUES (?, ?)")
        ((Ok ins)
          {
            (kitRun "prepared clash" (axqRun ins (vec2 (VText "a@x") (VInt 0))))
            (kitRun "prepared ok" (axqRun ins (vec2 (VText "h@x") (VInt 0))))
            (println (axqLastInsertRowid db))
            (kitRun "finalize" (axqFinalize ins))
          }
        )
        ((Err e) (println (kitErrText e))))
      (state db)
      (kitRun "close" (axqClose db))
      0
    }))
