; Reading a row: typed accessors by position and by name, NULL, a
; column that isn't there, and a type that isn't the one asked for.
(import IO)
(import Err)
(import Vec)
(import Float)
(import Axqlite)
(import Axqlite.Value)
(import AxqlKit)

(:: showInt (-> String (Result Int Error) Int))
;@axiom:effect(io)
(fn (showInt label r)
  (match r
    ((Ok n) (println "{label} = {n}"))
    ((Err e)
      (let ((t (kitErrText e)))
        (println "{label}: {t}"))
    )))

(:: showText (-> String (Result String Error) Int))
;@axiom:effect(io)
(fn (showText label r)
  (match r
    ((Ok s)
      (let ((q (axqlQuoteText s)))
        (println "{label} = {q}"))
    )
    ((Err e)
      (let ((t (kitErrText e)))
        (println "{label}: {t}"))
    )))

(:: showBlob (-> String (Result String Error) Int))
;@axiom:effect(io)
(fn (showBlob label r)
  (match r
    ((Ok b)
      (let ((q (axqValueText (VBlob b))))
        (println "{label} = {q}"))
    )
    ((Err e)
      (let ((t (kitErrText e)))
        (println "{label}: {t}"))
    )))

(:: showReal (-> String (Result Float Error) Int))
;@axiom:effect(io)
(fn (showReal label r)
  (match r
    ((Ok x)
      (let ((s (floatToString x)))
        (println "{label} = {s}"))
    )
    ((Err e)
      (let ((t (kitErrText e)))
        (println "{label}: {t}"))
    )))

(:: showBool (-> String (Result Bool Error) Int))
;@axiom:effect(io)
(fn (showBool label r)
  (match r
    ((Ok b) (println "{label} = {b}"))
    ((Err e)
      (let ((t (kitErrText e)))
        (println "{label}: {t}"))
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((db (kitOpen "rows.db")))
    {
      (kitRun "create" (axqExec db "CREATE TABLE t (i INTEGER, r REAL, s TEXT, b BLOB)"))
      (kitRun "insert" (axqExec db "INSERT INTO t VALUES (42, 2.5, 'hi', x'0102'), (NULL, NULL, NULL, NULL)"))
      (match (axqQueryOn db (Query "SELECT i, r, s, b, i + 1 AS next FROM t ORDER BY rowid" vec0))
        ((Ok rs)
          (let (
            (full (vecGet rs.rows 0))
            (empty (vecGet rs.rows 1))
          )
            {
              (println (rowLen full))
              (showText "name 0" (rowName full 0))
              (showText "name 4" (rowName full 4))
              (showText "name 5" (rowName full 5))
              (showInt "int 0" (rowInt full 0))
              (showReal "real 1" (rowReal full 1))
              (showReal "real 0 (an INTEGER)" (rowReal full 0))
              (showText "text 2" (rowText full 2))
              (showBlob "blob 3" (rowBlob full 3))
              (showInt "int 4" (rowInt full 4))
              (showInt "int 2 (TEXT)" (rowInt full 2))
              (showText "text 0 (INTEGER)" (rowText full 0))
              (showBlob "blob 2 (TEXT)" (rowBlob full 2))
              (showReal "real 2 (TEXT)" (rowReal full 2))
              (showInt "int 9" (rowInt full 9))
              (showInt "int -1" (rowInt full -1))
              (showBool "null 0" (rowIsNull full 0))
              (showBool "null 0 of the NULL row" (rowIsNull empty 0))
              (showInt "int of NULL" (rowInt empty 0))
              (showText "text of NULL" (rowText empty 2))
              (showInt "named i" (rowIntNamed full "i"))
              (showInt "named I" (rowIntNamed full "I"))
              (showInt "named next" (rowIntNamed full "next"))
              (showText "named s" (rowTextNamed full "s"))
              (showReal "named r" (rowRealNamed full "r"))
              (showBlob "named b" (rowBlobNamed full "b"))
              (showBool "named null" (rowIsNullNamed empty "s"))
              (showInt "named nope" (rowIntNamed full "nope"))
              (showInt "index of s" (rowIndex full "S"))
              (match (rowValueNamed full "b")
                ((Ok v) (println (axqValueText v)))
                ((Err e) (println (kitErrText e))))
              (match (rowValue empty 3)
                ((Ok v) (println (axqValueText v)))
                ((Err e) (println (kitErrText e))))
            })
        )
        ((Err e) (println (kitErrText e))))
      (kitRun "close" (axqClose db))
      0
    }))
