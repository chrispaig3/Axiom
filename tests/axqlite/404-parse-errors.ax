; Refusals: each is axqSyntax, with the line and column where the
; parser stopped, counted in bytes from 1.
(import IO)
(import AxqlPrint)

(:: show (-> String Int))
;@axiom:effect(io)
(fn (show text)
  (println (axqlPrintParse text)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (show "")
    (show "   ")
    (show "-- nothing but a comment")
    (show ";")
    (show "SELEC 1")
    (show "SELECT")
    (show "SELECT 1,")
    (show "SELECT 1 2")
    (show "SELECT 1; SELECT 2")
    (show "SELECT 1;;")
    (show "SELECT * WHERE 1")
    (show "SELECT FROM t")
    (show "SELECT a FROM")
    (show "SELECT a FROM t WHERE")
    (show "SELECT a FROM t ORDER a")
    (show "SELECT a FROM t ORDER BY")
    (show "SELECT a FROM t LIMIT")
    (show "SELECT a FROM t OFFSET 1")
    (show "SELECT a FROM t LIMIT 1 OFFSET")
    (show "SELECT a AS FROM t")
    (show "SELECT (a")
    (show "SELECT a)")
    (show "SELECT a IS 1")
    (show "SELECT a IS NOT 1")
    (show "SELECT a NOT NULL")
    (show "SELECT 9223372036854775808")
    (show "SELECT -(9223372036854775808)")
    (show "SELECT 1 -9223372036854775808")
    (show "SELECT 'unterminated")
    (show "SELECT \"unterminated")
    (show "SELECT \"\"")
    (show "SELECT x'1'")
    (show "SELECT x'zz'")
    (show "SELECT x'00")
    (show "SELECT 1e")
    (show "SELECT 1e+")
    (show "SELECT 12abc")
    (show "SELECT 1.5.5")
    (show "SELECT @a")
    (show "SELECT a || b")
    (show "SELECT a ! b")
    (show "SELECT a\n  FROM t\n  WHERE b = = 1")
    (show "CREATE")
    (show "CREATE TABLE")
    (show "CREATE TABLE t")
    (show "CREATE TABLE t ()")
    (show "CREATE TABLE t (a)")
    (show "CREATE TABLE t (a INT)")
    (show "CREATE TABLE t (a INTEGER,)")
    (show "CREATE TABLE t (a INTEGER NOT)")
    (show "CREATE TABLE t (a INTEGER PRIMARY)")
    (show "CREATE TABLE t (a INTEGER UNIQUE)")
    (show "CREATE TABLE t (a INTEGER) STRICT")
    (show "CREATE TABLE IF t (a INTEGER)")
    (show "CREATE INDEX i t (a)")
    (show "CREATE INDEX i ON t")
    (show "CREATE INDEX i ON t ()")
    (show "CREATE UNIQUE TABLE t (a INTEGER)")
    (show "DROP t")
    (show "DROP TABLE")
    (show "DROP TABLE IF NOT EXISTS t")
    (show "INSERT t VALUES (1)")
    (show "INSERT INTO t")
    (show "INSERT INTO t VALUES")
    (show "INSERT INTO t VALUES ()")
    (show "INSERT INTO t VALUES (1), (2, 3)")
    (show "INSERT INTO t (a,) VALUES (1)")
    (show "INSERT INTO t SELECT 1")
    (show "UPDATE t")
    (show "UPDATE t SET")
    (show "UPDATE t SET a")
    (show "UPDATE t SET a = 1,")
    (show "UPDATE t SET a = 1 WHERE")
    (show "DELETE t")
    (show "DELETE FROM")
    (show "BEGIN WORK")
    (show "COMMIT 1")
    (show "SELECT `a`")
    0
  })
