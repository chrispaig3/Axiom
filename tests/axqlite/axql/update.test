# UPDATE and DELETE: SET lists, the rowid moving, rows collected before
# any is changed, and constraint failures leaving the table as it was.
# Expected results follow docs/axql.md.

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER, s TEXT)

statement ok
INSERT INTO t VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'c'), (4, 40, 'd')

statement ok
UPDATE t SET n = n + 1 WHERE id > 2

query
SELECT id, n FROM t
----
1,10
2,20
3,31
4,41

statement ok
UPDATE t SET s = 'z', n = n * 2 WHERE s = 'a'

query
SELECT * FROM t WHERE id = 1
----
1,20,'z'

statement ok
UPDATE t SET n = n - 1, s = s WHERE n > 20

query
SELECT n FROM t
----
20
20
30
40

statement ok
UPDATE t SET n = 0

query
SELECT * FROM t
----
1,0,'z'
2,0,'b'
3,0,'c'
4,0,'d'

statement ok
UPDATE t SET id = id + 10 WHERE id = 4

query
SELECT id, s FROM t
----
1,'z'
2,'b'
3,'c'
14,'d'

statement error axqConstraint a row with rowid 2 already exists in t
UPDATE t SET id = 2 WHERE id = 1

statement ok
UPDATE t SET id = id + 100

query
SELECT id FROM t
----
101
102
103
114

statement ok
UPDATE t SET rowid = rowid - 100

query
SELECT id, rowid FROM t
----
1,1
2,2
3,3
14,14

statement error axqConstraint a row with rowid 2 already exists in t
UPDATE t SET id = id + 1

query
SELECT id FROM t
----
1
2
3
14

statement error axqConstraint t's INTEGER PRIMARY KEY may not be NULL
UPDATE t SET id = NULL WHERE id = 1

statement error axqSchema t has no column named zz
UPDATE t SET zz = 1

statement error axqSchema column N is set twice
UPDATE t SET n = 1, N = 2

statement error axqSchema no such column: nope
UPDATE t SET n = 1 WHERE nope = 2

statement error axqSchema no such table: nosuch
UPDATE nosuch SET n = 1

statement ok
UPDATE t SET n = 5 WHERE n = NULL

query
SELECT n FROM t
----
0
0
0
0

statement ok
DELETE FROM t WHERE s = 'b'

query
SELECT id FROM t
----
1
3
14

statement ok
DELETE FROM t WHERE id = 99

statement ok
DELETE FROM t WHERE id > 2

query
SELECT id, s FROM t
----
1,'z'

statement ok
DELETE FROM t

query
SELECT * FROM t
----

statement ok
INSERT INTO t (s) VALUES ('new')

query
SELECT * FROM t
----
1,NULL,'new'

statement ok
CREATE TABLE r (x TEXT NOT NULL)

statement ok
INSERT INTO r VALUES ('a'), ('b'), ('c')

statement ok
UPDATE r SET rowid = 7 WHERE x = 'b'

query
SELECT rowid, x FROM r
----
1,'a'
3,'c'
7,'b'

statement error axqConstraint the rowid of r may not be NULL
UPDATE r SET rowid = NULL

statement error axqConstraint r.x may not be NULL
UPDATE r SET x = NULL WHERE rowid = 7

statement ok
CREATE TABLE o (v INTEGER)

statement ok
INSERT INTO o VALUES (1), (9223372036854775807)

statement error axqArithmetic integer overflow: 9223372036854775807 + 1
UPDATE o SET v = v + 1

query
SELECT v FROM o
----
1
9223372036854775807

query
SELECT rowid, x FROM r
----
1,'a'
3,'c'
7,'b'

statement ok
UPDATE r SET x = x WHERE rowid < 0

statement error axqSyntax expected SET
UPDATE r x = 1

statement error axqSyntax expected "="
UPDATE r SET x 1

statement error axqSyntax expected FROM
DELETE r
