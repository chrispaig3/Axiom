query
SELECT 'x' LIMIT 1 OFFSET 1
----

statement error axqSchema no such column: nosuch
SELECT nosuch FROM emp

statement error axqSchema no such column: name
SELECT name

statement error axqSchema ORDER BY 3 names no result column; there are 1
SELECT name FROM emp ORDER BY 3

statement error axqSchema ORDER BY 6 names no result column; there are 5
SELECT * FROM emp ORDER BY 6

statement error axqSchema ORDER BY 0 names no result column
SELECT name FROM emp ORDER BY 0

statement error axqType LIMIT needs an INTEGER
SELECT id FROM emp LIMIT 'x'

statement error axqType LIMIT is negative: -1
SELECT id FROM emp LIMIT -1

statement error axqType LIMIT needs an INTEGER
SELECT id FROM emp LIMIT 1.5

statement error axqType LIMIT needs an INTEGER
SELECT id FROM emp LIMIT NULL

statement error axqType OFFSET is negative: -2
SELECT id FROM emp LIMIT 1 OFFSET -2

statement error axqSchema no such column: id
SELECT id FROM emp LIMIT id

statement error axqSyntax expected the end of the statement, found "OFFSET"
SELECT id FROM emp OFFSET 1

statement error axqSyntax expected an expression, found the end of the statement
SELECT * FROM emp WHERE

statement error axqSyntax `*` needs a table
SELECT *

statement error axqSyntax expected an expression, found "*"
SELECT id, * FROM emp

query
SELECT id FROM emp WHERE name = 'bob' AND id = 2 AND salary = 80
----
2

query
SELECT id FROM emp ORDER BY rowid DESC LIMIT 2
----
5
4

query
SELECT id FROM emp ORDER BY -id
----
5
4
3
2
1
