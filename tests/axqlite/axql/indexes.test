# Indices give the same answers a table scan gives: equality and ranges
# on an index's leading column, ORDER BY read in index order, and every
# write keeping its indices in step. Expected results follow
# docs/axql.md.

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, k INTEGER, name TEXT, score REAL)

statement ok
INSERT INTO t VALUES (1, 30, 'c', 1.5), (2, 10, 'a', NULL), (3, 20, 'b', 2.5), (4, 10, 'd', -1.0), (5, NULL, 'e', 0.0), (6, 40, NULL, 3.0)

statement ok
CREATE INDEX tk ON t (k)

statement ok
CREATE INDEX tn ON t (name)

statement ok
CREATE INDEX tks ON t (k, score)

query
SELECT id FROM t WHERE k = 10
