; Precedence and associativity: OR, AND, NOT, the equality operators
; and IS, the orderings, + -, * / %, then unary minus. Operators of one
; level group from the left.
(import IO)
(import AxqlPrint)

(:: show (-> String Int))
;@axiom:effect(io)
(fn (show text)
  (println (axqlPrintParse text)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (show "SELECT 1 + 2 * 3")
    (show "SELECT 1 * 2 + 3")
    (show "SELECT 1 - 2 - 3")
    (show "SELECT 1 / 2 * 3 % 4")
    (show "SELECT (1 + 2) * 3")
    (show "SELECT -1 - -2")
    (show "SELECT - - 3")
    (show "SELECT -a * b")
    (show "SELECT a < b = c > d")
    (show "SELECT a = b == c != d <> e")
    (show "SELECT a < b <= c > d >= e")
    (show "SELECT a + 1 < b * 2")
    (show "SELECT NOT a = b")
    (show "SELECT NOT NOT a")
    (show "SELECT NOT a AND b")
    (show "SELECT a AND b OR c AND d")
    (show "SELECT a OR b AND c")
    (show "SELECT a OR b OR c")
    (show "SELECT a AND (b OR c)")
    (show "SELECT a IS NULL")
    (show "SELECT a IS NOT NULL = 1")
    (show "SELECT a + 1 IS NULL")
    (show "SELECT NOT a IS NULL")
    (show "SELECT a < b IS NULL")
    (show "SELECT a = b IS NOT NULL")
    (show "SELECT -9223372036854775808, - 9223372036854775808, -(9223372036854775807)")
    (show "SELECT - -9223372036854775808")
    0
  })
