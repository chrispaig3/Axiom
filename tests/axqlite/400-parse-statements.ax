; Every statement form AXQL has, parsed and written back as a tree.
(import IO)
(import AxqlPrint)

(:: show (-> String Int))
;@axiom:effect(io)
(fn (show text)
  (println (axqlPrintParse text)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (show "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL, r REAL, b BLOB)")
    (show "create table if not exists T (A integer not null primary key, B text primary key not null)")
    (show "CREATE TABLE \"my table\" (\"from\" INTEGER, text TEXT, key BLOB, desc REAL, asc INTEGER, transaction TEXT)")
    (show "DROP TABLE t")
    (show "DROP TABLE IF EXISTS t;")
    (show "CREATE INDEX i ON t (a)")
    (show "CREATE UNIQUE INDEX IF NOT EXISTS i ON t (a, b, c)")
    (show "DROP INDEX i")
    (show "DROP INDEX IF EXISTS i")
    (show "INSERT INTO t VALUES (1, 'a', 2.5, x'00')")
    (show "INSERT INTO t (a, b) VALUES (1, 2), (3, 4), (?, ?)")
    (show "UPDATE t SET a = a + 1, b = NULL WHERE id = 3")
    (show "UPDATE t SET a = 1")
    (show "DELETE FROM t WHERE a < 0 OR b IS NULL")
    (show "DELETE FROM t")
    (show "SELECT * FROM t")
    (show "SELECT a, b AS bee, a + b FROM t WHERE a = 1 ORDER BY b DESC, a ASC, 1 LIMIT 10 OFFSET 5")
    (show "SELECT 1")
    (show "SELECT 1, 'two', 3.0, NULL, TRUE, FALSE, x'ff' WHERE 1 ORDER BY 1 LIMIT 1")
    (show "SELECT a FROM t LIMIT ?")
    (show "BEGIN")
    (show "BEGIN TRANSACTION")
    (show "COMMIT")
    (show "COMMIT TRANSACTION")
    (show "ROLLBACK")
    (show "ROLLBACK TRANSACTION;")
    (show "  -- a comment first\n  SELECT a -- and one after\n  FROM t ;  -- and at the end")
    0
  })
