; expect 42
(:: main Int)

(fn (main)
  (let (
    (t1 (if (> 5 5)
      1
      0
    ))
    (t2 (if (< 5 5)
      1
      0
    ))
    (t3 (if (>= 5 5)
      0
      1
    ))
    (t4 (if (<= 5 5)
      0
      1
    ))
    (t5 (if (== 5 5)
      0
      1
    ))
    (t6 (if (!= 5 5)
      1
      0
    ))
  )
    (+ 42 (+ t1 (+ t2 (+ t3 (+ t4 (+ t5 t6))))))
  )
)
