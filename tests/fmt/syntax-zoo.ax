; Every declaration and expression form the parser accepts, in one file.
;
; `check-fmt.sh` formats every `.ax` file in the repository and re-runs
; the suites against the result, which makes it exactly as wide as the
; corpus - and the corpus uses `data`, `struct`, `fn` and `macro` and
; nothing else. So the formatter was broken for most of the language and
; the gate was green: `(type N = Int)` lost its `=`, a `trait` lost its
; `where`, its supertrait parentheses and its method `::`, and an `impl`
; lost its `where` too. Each produced a file that no longer parsed, and
; each was found by hand rather than by CI.
;
; This file exists so the gate stops depending on what the standard
; library happens to need. It is never run - only parsed, formatted, and
; parsed again - so it is written for coverage of *syntax*, not to
; compute anything.

(import Mem)
(import Sys.Platform)

; --- type alias -----------------------------------------------------
(pub type Count = Int)

; --- data: positional, named fields, nullary ------------------------
(pub data Shape
  (Circle { r : Int })
  (Rect { w : Int, h : Int })
  (Empty))

(data Tree (a)
  (Leaf)
  (Node (Tree a) a (Tree a)))

; --- data: a deriving clause - REFUSED, 2026-08-14 -------------------
; This zoo carried the repository's ONLY `deriving` clause, written
; deliberately to pin the formatter's spelling of a clause the
; compiler parsed and DISCARDED - no instance was ever derived from
; it. MAC-CAP-9 settled on refusing the clause (`derive` is explicit
; declaration macros), and macro-system.md counted this file pair as
; the change's whole migration cost before the commit landed. The
; refusal is AX2004 from the parser and a poison from the formatter -
; the two grammars refuse together - pinned by
; tests/fmt/parity/070-deriving-refused.axp and
; tests/diagnostics/545-deriving-refused.axbad.

; --- struct ---------------------------------------------------------
; `mut` sits INSIDE the field's parentheses, before the name. The
; formatter printed `(y : Int) mut`, which does not parse either, and
; for the same reason nothing noticed: no struct in the repository has
; a mutable field.
(pub struct Rec
  (n : Int)
  (mut counter : Int)
  (on : Bool)
  (ratio : Float)
  (label : String))

; --- trait: supertraits, methods, defaults --------------------------
(trait (Show a) where
  (show :: (-> a Int)
   width :: (-> a Int)))

(trait (Ord a) (Show) where
  (cmp :: (-> a Int)))

; --- impl -----------------------------------------------------------
; Every method the trait declares, because since 2026-08-10 an `impl`
; is a real declaration rather than an inert node: its bodies are
; type-checked and a missing method is AX3025. This file carried only
; `show` while nothing looked.
(impl (Show Int) where
  ((show (lambda (x) x))
   (width (lambda (x) 1))))

; --- macro ----------------------------------------------------------
(macro (twice x) (+ x x))

; --- signatures: uncurried arrows, higher order ---------------------
(pub :: apply (-> (-> Int Int) Int Int))
(pub fn (apply f x) (f x))

; --- every literal kind ---------------------------------------------
(:: literals (-> Int Int))
(fn (literals _x)
  (let ((i 42)
        (f 1.5)
        (c 'q')
        (s "tab\there \"quoted\" back\\slash")
        (b true))
    i))

; --- control flow ---------------------------------------------------
(:: control (-> Int Int))
;@axiom:pure
(fn (control n)
  (let ((mut i 0)
        (mut acc 0))
    {
      (while (< i n)
        {
          (set acc (+ acc i))
          (set i (+ i 1))
        })
      (if (> acc 10) acc 0)
    }))

; --- cond ----------------------------------------------------------
(:: classify (-> Int Int))
(fn (classify n)
  (cond
    ((< n 0) 1)
    ((== n 0) 2)
    (else { (+ n 0) 3 })))

; --- pattern matching: nested, named fields, punning ----------------
(:: area (-> Shape Int))
(fn (area s)
  (match s
    ((Circle { r = r }) (* r r))
    ((Rect { w, h }) (* w h))
    ((Empty) 0)))

(:: depth (-> (Tree Int) Int))
(fn (depth t)
  (match t
    ((Leaf) 0)
    ((Node l _v r) (+ 1 (depth l)))))

; --- field access, casts, sizeof ------------------------------------
(:: misc (-> Rec Int))
(fn (misc r)
  (+ (+ r.n (cast Int r.ratio))
     (+ (sizeof Int) (alignof Int))))

; --- the keyword-headed expression forms ----------------------------
; `(struct ...)` in EXPRESSION position is construction, distinct from
; the `(struct ...)` declaration above and from the application
; spelling `(Rec ...)`. It is here because it printed as a bare
; `Rec 1 true 1.5 "s"` - no keyword, no parens - until a conformance
; case first asked the formatter to render one: output that either
; failed to parse or re-parsed as an application and dropped its
; arguments on the second pass. `alloc` rides along, the
; two other forms whose only corpus use is this file.
(:: keyword_forms (-> Int Int))
(fn (keyword_forms n)
  (let ((r (struct Rec 1 0 true 1.5 "s"))
        (p (alloc Int 8))
        (q (alloc Bool)))
    (+ r.n n)))

; --- qualified names ------------------------------------------------
(:: qualified (-> Int Int))
(fn (qualified x) (Mem::memAlloc x))

; --- trailing comment on a declaration ------------------------------
(:: last (-> Int Int))
(fn (last x) x)  ; stays on this line

; --- effect declarations and handle expressions ---------------------
(effect Console
  (log :: (-> String Int)))

(effect Wire
  (send :: (-> Int Int Int))
  (recv :: (-> Int Int)))

(:: handled (-> Int Int))
(fn (handled n)
  (handle (log "hi") (Console) (lambda (s) 0)))

(:: scoped (-> Int Int))
(fn (scoped n)
  (handle n (IO Mut) 0))

; --- a parenthesised type application, in every position that takes one
;
; `(Box Int)` is two tokens with no delimiter of its own, so a position
; that prints it bare hands its parent an extra argument. The forms
; below are the sixteen places the grammar allows one, and the
; formatter printed fourteen of them bare - `(:: b (Box Int))` came out
; as `(:: b Box Int)`, which does not even parse. The two that survived
; did so by accident: `forall` and a type signature *expression* both
; re-read the juxtaposition as the same application.
;
; None of it was visible, because every type in this repository is
; either a bare name or an arrow, and an arrow's components were the
; one position that already parenthesised. That is this file's whole
; job: the corpus does not ask, so the zoo has to.
(pub data Box (a)
  (B a))

(:: aBox (Box Int))
(fn (aBox) (B 1))

(pub type BoxedCount = (Box Int))

(struct Holder
  (item : (Box Int)))

(data Wrapped
  (W { inner : (Box Int) }))

(trait (Container a) where (
  held :: (Box a)
))

(trait (Boxy a) ((Container (Box a))) where (
  reboxed :: (Box (Box a))
))

(impl (Container (Box Int)) where (
  (held 0)
))

; An effect operation's printed type is its parameters arrowed onto its
; return type, so it reaches the bare position only when it has no
; parameters - and `AX3017` refuses one of those ("an operation needs at
; least one to be callable"). The bare spelling is therefore
; unreachable from a program the checker accepts, and this declaration
; covers the position that is reachable.
(effect Boxes
  (store :: (-> (Box Int) Int)))

; The type-form interiors: each of these brings its own delimiters, so
; the application inside it is the bare position under test. They ride
; on an arrow's argument so that no definition is owed for them.
;
; `(forall a T)` and the space-separated tuple `(A B)` are absent
; deliberately. The formatter prints a `TForall`, but `parse_type` has
; no `forall` branch, so `(forall a a)` is read as a three-element
; *tuple* of type variables - `axiom check` renders the mismatch as
; `expected (forall, a, a)`. And a tuple type is reachable, but the
; editor grammar's `tuple_type` demands commas, which the parser
; refuses ("expected type, found `,`"), so a real one cannot go in a
; file `check-tree-sitter.sh` must accept.
(:: interiors (-> (* (Box Int)) [(Box Int)] (Box Int) Int))
(fn (interiors p l n) 0)

(:: typed_exprs (-> Int Int))
(fn (typed_exprs n)
  (let ((s (:: (B 1) (Box Int)))
        (c (cast (Box Int) 0))
        (p (alloc (Box Int) 2)))
    (+ (sizeof (Box Int)) (alignof (Box Int)))))

; --- the normalisations: what `fmt` REWRITES rather than reprints ----
;
; Everything above asks whether a construct survives formatting. These
; ask the other question: which spellings the formatter deliberately
; replaces. Each line below comes out as something else, and
; `tests/fmt/syntax-zoo.expected.ax` is what it comes out as - so the
; normal form is a reviewed artefact rather than whatever the printer
; happens to do this week.
;
; The list is exhaustive as of the day it was written, one entry per
; measured rewrite:
;
;   (define x 1)             -> (fn (x) 1)
;   (fn f = 7)               -> (fn (f) 7)
;   1_000_000                -> 1000000
;   007                      -> 7
;   ((g 1) 2)                -> (g 1 2)
;   (e)                      -> e
;   { e }                    -> e
;   two body expressions     -> a { } block
;   (-> Int (-> Int Int))    -> (-> Int Int Int)
;   (Int)                    -> Int
;   ()  as a type            -> Unit
;   Integer                  -> Int
;   Q.Inner::only            -> Q::Inner::only
;
; plus, not visible as a single line: imports hoisted above every other
; declaration, exactly one blank line between declarations and none kept
; from the source, and string and char literals re-escaped from their
; decoded values.
;
; A float is printed as the shortest decimal that round-trips its `f64`.
; Every float literal in this repository is an exact short binary
; fraction, so stripping trailing zeros after the point (keeping one) is
; the same function today - a property of this corpus, not of the
; printer. A float needing seventeen significant digits would break that
; equivalence, which is why one is not written here.

(:: helperD (-> Int Int))
(define (helperD x) x)

(:: zeroParam Int)
(fn zeroParam = 7)

(:: bigNums Int)
(fn (bigNums) (+ 1_000_000 007))

(:: addTwo (-> Int Int Int))
(fn (addTwo a b) (+ a b))

(:: spine Int)
(fn (spine) ((addTwo 1) 2))

(:: redundantParens (-> Int Int))
(fn (redundantParens n) (n))

(:: oneBlock (-> Int Int))
(fn (oneBlock n) { n })

(:: manyBody (-> Int Int))
(fn (manyBody n) 1 n)

(:: curried (-> Int (-> Int Int)))
(fn (curried a b) a)

; `(Int)` -> `Int` is measured and real, but it cannot live here: the
; editor grammar has no parenthesised-type rule, deliberately - adding
; one made it ambiguous against a type-parameter list and against a
; zero-argument application at once - so a file both gates must accept
; cannot contain one.

(:: unitArg (-> () Int))
(fn (unitArg n) 1)

(:: integerName (-> Integer Int))
(fn (integerName n) 1)

; Negative literals, in the four positions that read differently: a
; binding, an argument, after a leading operand, and the space-separated
; spelling that stays unary minus and prints back as a literal.
(:: negatives Int)
(fn (negatives)
  (let ((a -5)
        (b (+ 3 -1))
        (c (- 0 -4))
        (d (- 5)))
    (+ a (+ b (+ c d)))))
