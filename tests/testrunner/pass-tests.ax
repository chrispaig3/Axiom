; A suite that passes, and the one `axiom test` must report as five
; passing tests in declaration order.
;
; It is deliberately not trivial: each test exercises a different
; standard-library module, so a runner that compiled but linked
; nothing useful would fail here rather than pass an empty program.
(import Test)

(import Vec)

(import Map)

(import Str)

(import Path)

(:: testVecGrowsAndKeepsItsElements Int)

;@axiom:effect(io)
(fn (testVecGrowsAndKeepsItsElements)
  (let ((v vecNew))
    {
      (vecPush v 41)
      (vecPush v 1)
      (assertEq "length after two pushes" 2 (vecLen v))
      (assertEq
        "the first element survived"        41        (cast Int (vecGet v 0))
      )
      (assertEq "sum" 42 (vecSum v))
      0
    }
  )
)

(:: testMapRoundTrips Int)

;@axiom:effect(io)
(fn (testMapRoundTrips)
  (let ((m mapNew))
    {
      (mapInsert m 7 70)
      (assertTrue "the key is present" (mapHas m 7))
      ; `mapGet` takes the value to answer with when the key is absent -
      ; the third argument - so a miss is a value the caller chose rather
      ; than a sentinel it has to know.
      (assertEq
        "the value comes back"        70        (cast Int (mapGet m 7 0))
      )
      (assertFalse "an absent key is absent" (mapHas m 8))
      0
    }
  )
)

(:: testStrSlicesShareBytes Int)

;@axiom:effect(io)
(fn (testStrSlicesShareBytes)
  {
    (assertStrEq "a slice of a literal" "ell" (strSlice "hello" 1 3))
    (assertEq "the length of the whole" 5 (strLen "hello"))
    0
  }
)

(:: testPathSplitsIntoItsParts Int)

;@axiom:effect(io)
(fn (testPathSplitsIntoItsParts)
  {
    (assertStrEq "directory" "src/" (pathDir "src/main.ax"))
    (assertStrEq "base" "main.ax" (pathBase "src/main.ax"))
    (assertStrEq "extension, with its dot" ".ax" (pathExt "src/main.ax"))
    (assertStrEq "stem" "main" (pathStem "src/main.ax"))
    0
  }
)

(:: testAssertNeSeparatesTwoValues Int)

;@axiom:effect(io)
(fn (testAssertNeSeparatesTwoValues) (assertNe "a changed value" 0 (+ 1 1)))
