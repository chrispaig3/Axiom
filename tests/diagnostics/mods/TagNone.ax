; The same function NAME, in a different module, with NO axtag at all -
; and a body that performs IO, so any tag wrongly applied to it would
; be contradicted and would show.
(import IO)

(pub :: work (-> Int Int))

;@axiom:effect(io)
(pub fn (work n)
  {
    (println "tagnone does IO")
    n
  }
)
