; A module that invokes declaration macros of its own (MAC-EXP-16's
; module-side invocation, 2026-08-15). Two of them, because what the
; entry file may name is the question 515 asks: a template's own `pub`
; decides whether its products leave the module, exactly as it decides
; for a declaration written here by hand.
(pub macro dmk ((dmk nm)
   (pub :: nm Int)
   (pub fn (nm) 3)))

(macro dhidden ((dhidden nm)
   (:: nm Int)
   (fn (nm) 4)))

(dmk insideModule)

(dmk alsoExported)

(dhidden hiddenInside)

; A macro the ENTRY FILE defines, invoked here. The entry file's
; declarations are visible from every module (the flat namespace), so
; this resolves - and the products are THIS module's, because the
; visibility a generated declaration is born with is decided by the
; module the invocation was written in and not by the macro's. Reading
; that axis off the macro instead stamped these `pub` and let them out
; of the module.
(entryMk fromEntryMacro)

(pub :: touch Int)

; The module's own call to its own generated private declaration -
; which must keep working, since privacy is about what leaves the
; module and this call does not.
(pub fn (touch) (+ 1 hiddenInside))
