; A module containing a declaration-macro invocation, for 515: the
; v1 surface is entry-file invocation, and a module-side one is
; refused rather than half-supported (generated declarations here
; would need the module's mangling and visibility applied after
; import resolution has already run).
(pub macro dmk ((dmk nm)
   (fn (nm) 3)))

(dmk insideModule)

(pub :: touch Int)

(pub fn (touch) 1)
