(macro boom ((boom T)
   (syntax/for (C (syntax/constructors T))
     (syntax/for (K (syntax/constructors T))
       (:: (syntax/join (syntax/join f C) K) (-> T Int))
       (fn ((syntax/join (syntax/join f C) K) v) 0)))))

(boom Wide)

(:: main Int)

(fn (main) 0)
