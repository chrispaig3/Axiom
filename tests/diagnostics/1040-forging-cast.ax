; A cast that makes a reference out of a word is an unsafe operation
; (R-B6, docs/memory-model.md MM-EXEC-9d), and a declaration performing
; one says `;@axiom:effect(unsafe)` or draws AX3073 at the cast.
;
; `toHid` is the probe the rule was built from: `(cast Hid 7)` checked
; OK in a function with no tag, and reading a field of it died with
; SIGSEGV (exit 139). The next five forge the other reference kinds: a
; `data` type with a field, a `String`, a `Vec`, a function (`Step`
; names the type, since a cast cannot spell an arrow) and a type
; variable. `toVecOf` forges a `(Vec Int)` out of a `(Vec String)`,
; which is a reference, but not the same one.
;
; The controls draw nothing. `observe` reads a number and a `Foreign`
; as words. Erasing a reference is fixture 1510. `same` casts a value to
; the type it already has, and `fresh` ascribes an empty vector its
; element type. `diverge` casts a value that never returns. `trusted`
; forges and says so, and `caller` calls it with no tag of its own.
(import IO)
(import Vec)

(struct Hid
  (name : String)
  (n : Int))

(data Shape
  (Circle Int)
  (Empty))

(data Colour
  (Red)
  (Green))

(type Step (-> Int Int))

(:: toHid (-> Int Int))
(fn (toHid k)
  {
    (let h (as k Hid))
    h.n
  })

(:: toShape (-> Int Shape))
(fn (toShape k)
  (as k Shape))

(:: toString (-> Int String))
(fn (toString k)
  (as k String))

(:: toVec (-> Int (Vec Int)))
(fn (toVec k)
  (as k (Vec Int)))

(:: toFn (-> Int Int))
(fn (toFn k)
  {
    (let f (as k Step))
    k
  })

(:: toAny (-> Int a a))
(fn (toAny k w)
  (as k a))

(:: toVecOf (-> (Vec String) (Vec Int)))
(fn (toVecOf v)
  (as v (Vec Int)))

; `pinnedLater` forges a `(Vec String)` out of a vector its body goes on
; to fill with `Int`s: at the cast `v` is still `(Vec _i)`, and the push
; below it pins `_i`. Judged at the cast, it checked OK and read the
; word `k` as a `String`. `pinnedSame` casts to the type the push pins,
; and draws nothing.
(:: pinnedLater (-> Int String))
(fn (pinnedLater k)
  {
    (let v vecNew)
    {
      (let s (as v (Vec String)))
      {
        (vecPush v k)
        (vecGet s 0)
      }
    }
  })

(:: pinnedSame (-> Int Int))
(fn (pinnedSame k)
  {
    (let v vecNew)
    {
      (let s (as v (Vec Int)))
      {
        (vecPush v k)
        (vecGet s 0)
      }
    }
  })

(:: observe (-> Float Foreign Int))
(fn (observe f p)
  (+ (as f Int) (+ (as p Int) (as (as 8 Foreign) Int))))

(:: same (-> String Colour))
(fn (same s)
  {
    (let t (as s String))
    (if (== (strLen t) 0)
      (as 0 Colour)
      (as 1 Colour))
  })

(:: fresh Int)
(fn (fresh)
  (vecLen (:: vecNew (Vec String))))

(:: diverge (-> Int a))
;@axiom:effect(io)
(fn (diverge k)
  (as (exit k) a))

(:: trusted (-> Int String))
;@axiom:effect(unsafe)
(fn (trusted k)
  (if (== k 0)
    ""
    (as 0 String)))

(:: caller Int)
(fn (caller)
  (strLen (trusted 0)))

(:: main Int)
(fn (main)
  (caller))
