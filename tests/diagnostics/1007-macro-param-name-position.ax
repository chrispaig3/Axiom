; AX3074: a macro parameter standing where a template keeps a name.
; Three errors, one per unsubstituted position - the field of `.`
; and `set`, and `handle`'s effect list. The argument each parameter
; was given is evaluated and discarded; the NAME is what the expansion
; keeps, which is why every parameter here shares its spelling with
; something real - field `x` and `y`, effect `Ask` - so each expansion
; is well-typed and nothing but AX3074 reports. Renaming the parameter
; says the literal is meant, and `syntax/for` says a field is chosen
; per invocation.
; Silent on purpose: `getx` names a literal field with no parameter
; behind it, and `getall`'s `f` is bound by the enclosing
; `syntax/for` - the iteration substitutes it, so there is nothing
; verbatim to report.
(struct Point (x : Int) (mut y : Int))
(struct One (a : Int))

(macro (getx s) s.x)
(macro (getf s x) s.x)
(macro (setf s y v) (set s.y v))
(macro (getall S s f) (One (syntax/for (f (syntax/fields S)) s.f)))

(effect Ask
  (ask :: (-> Int Int)))
(macro (runask x Ask) (handle x (Ask) (lambda (p) p)))

(:: main Int)
(fn (main)
  (let ((mut p (Point 1 2))
        (o (One 7)))
    {
      (getx p)
      (getf p 0)
      (setf p 0 3)
      (getall One o 0)
      (runask 41 0)
      0
    }))
