; `restrict(no-recursion)`: no cycle in the call graph reachable from
; this declaration - a global property by definition, so the walk is a
; depth-first search over the same graph the witness path uses, and
; the cycle is the evidence, rendered whole.
;
;   `countdown`  calls itself                          -> AX3049:
;                countdown -> countdown
;   `ping`       ping -> pong -> pang -> ping, and the claim is on
;                `ping`; the cycle is rendered from the declaration
;                back to itself                          -> AX3049
;   `viaCap`     calls a function stored in a CAPABILITY RECORD whose
;                stored function calls back into `viaCap`. This shape
;                used to cross a trait method and read `viaTrait ->
;                Emit#Loud#emit -> viaTrait`; traits went on
;                2026-08-31 and the replacement - a parameterised
;                struct holding the function - is what it exercises
;                now. It is the same question asked of the new
;                mechanism: does the cycle walk follow a call through
;                a record field?             -> AX3049, or a stated gap
;   `entry`      does not recurse, but reaches `countdown`, which
;                does: the cycle is below the claim, and the path
;                to it is rendered before it            -> AX3049
;   `deep`       a chain of four calls with no cycle    -> silent: the
;                control that keeps depth from reading as recursion
;   `looped`     a `while` loop, no call to itself      -> silent: a
;                loop is not recursion, and its stack is bounded
;
; The pairing with scripts/check-stack-depth.sh: that gate measures,
; dynamically, how much stack the compiler needs; a `no-recursion`
; region is one whose stack need is statically bounded, which is the
; same property from the other side.
; The capability record that replaced the trait shape: a parameterised
; struct holding a function, which is how an interface is spelled since
; 2026-08-31.
(struct EmitOf (a)
  (emit : (-> a Int)))


;@axiom:restrict(no-recursion)
(:: viaCap (-> Int Int))

(fn (viaCap n)
  (let ((c (EmitOf (lambda (v) (viaCap v)))))
    ((c.emit) n)
  )
)

;@axiom:restrict(no-recursion)
(:: countdown (-> Int Int))

(fn (countdown n)
  (if (<= n 0)
    0
    (countdown (- n 1))
  )
)

;@axiom:restrict(no-recursion)
(:: ping (-> Int Int))

(fn (ping n)
  (if (<= n 0)
    0
    (pong (- n 1))
  )
)

(:: pong (-> Int Int))

(fn (pong n) (pang n))

(:: pang (-> Int Int))

(fn (pang n) (ping n))

;@axiom:restrict(no-recursion)
(:: entry (-> Int Int))

(fn (entry n) (countdown n))

(:: d4 (-> Int Int))

(fn (d4 n) (+ n 1))

(:: d3 (-> Int Int))

(fn (d3 n) (d4 n))

(:: d2 (-> Int Int))

(fn (d2 n) (d3 n))

(:: d1 (-> Int Int))

(fn (d1 n) (d2 n))

;@axiom:restrict(no-recursion)
(:: deep (-> Int Int))

(fn (deep n) (d1 n))

;@axiom:restrict(no-recursion)
(:: looped (-> Int Int))

(fn (looped n)
  (let ((mut i 0))
    {
      (while (< i n)
        (set i (+ i 1)))
      i
    }
  )
)

(:: main Int)

(fn (main)
  (+ (viaCap 2) (+ (countdown 3) (+ (ping 4) (+ (entry 5) (+ (deep 6) (looped 7))))))
)
