; A record returned where the signature says `Int` is a type mismatch
; (MM-VAL-24). `Int` is not a heap handle: a `Pt` answered through it
; would leave the caller holding a word the release walk never follows.
;
;   `mkPt`    a struct through a declared `Int`, refused as AX3004
;   `mkBox`   a `data` value the same way, refused as AX3004
;
; The controls draw nothing, and each is the fix for one of the two:
;   `mkPt2`   the signature names the type the body answers
;   `same`    identity asked through `Mem.addrOf`, which keeps the
;             address as an `Addr` instead of erasing the value
(import Mem)

(struct Pt
  (x : Int)
  (y : Int))

(data Box
  (Wrap Int))

(:: mkPt (-> Int Int Int))
(fn (mkPt a b)
  (Pt a b))

(:: mkBox (-> Int Int))
(fn (mkBox n)
  (Wrap n))

(:: mkPt2 (-> Int Int Pt))
(fn (mkPt2 a b)
  (Pt a b))

(:: same (-> Pt Pt Bool))
(fn (same p q)
  (addrEq (addrOf p) (addrOf q)))

(:: main Int)
(fn (main)
  (let ((p (mkPt2 30 5)))
    (if (same p p)
      (+ p.x p.y)
      0)))
