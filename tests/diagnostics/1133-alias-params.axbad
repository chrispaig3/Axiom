; A `type` alias takes no type parameters. Both spellings are refused
; where they are declared, and their uses add no report of their own.
(import Vec)

(type Pair (a) = (Vec a))
(type Two a = (Vec a))
(type Names = (Vec String))

(:: first (-> (Pair Int) Int))
(fn (first p) (vecGet p 0))

(:: count (-> (Two Int) Names Int))
(fn (count t n) (+ (vecLen t) (vecLen n)))

(:: main Int)
(fn (main) (first (vecPush vecNew 1)))
