; The witness path: every transitive violation names the chain of
; resolved calls from the claiming declaration to where the effect
; enters, in the spellings `symbols --calls` prints, so each hop
; cross-checks `#calls=`. Four shapes the renderer has to get right,
; and the control that stays silent:
;
;   `viaCap`      the path crosses a CAPABILITY RECORD's field: the
;                 stored function reaches the syscall. This shape used
;                 to cross a trait method and the hop rendered as the
;                 lowered impl, `Emit#Loud#emit`; traits went on
;                 2026-08-31 and a parameterised struct holding the
;                 function replaced them. The hop is SHORTER now - the
;                 walk follows the stored lambda's body rather than a
;                 synthetic impl name - which is the renderer's answer
;                 to the new mechanism and is why the shape stayed
;                                                    -> AX3049 with path
;   `viaModule`   the path crosses a module boundary: the hop is the
;                 imported spelling, `RestrictLeaf$leafWrite`
;                                                    -> AX3049 with path
;   `viaBuiltin`  the path ends at a builtin whose row is SEEDED,
;                 `__argc` - not a syscall, not an extern, but where
;                 IO enters all the same             -> AX3049 with path
;   `viaCallback` `(apply shout n)`: the walk records an edge to the
;                 named callback, so the path goes through `shout`
;                 and not through `apply`            -> AX3049 with path
;   `quiet`       reaches none of it                 -> silent
;
; Every IO-performing function here declares it, so the only
; diagnostics are the restriction's.
(import RestrictLeaf)

; The capability record that replaced the trait shape.
(struct EmitOf (a)
  (emit : (-> a Int)))

;@axiom:restrict(no-io)
(:: viaCap (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (viaCap n)
  (let ((c 
    (EmitOf
      (lambda (v)
        {
          (__syscall3 1 1 0 0)
          1
        }
      ))))
    (c.emit n)))

;@axiom:restrict(no-io)
(:: viaModule (-> Int Int))
;@axiom:effect(io)
(fn (viaModule n)
  (leafWrite n))

;@axiom:restrict(no-io)
(:: viaBuiltin (-> Int Int))
;@axiom:effect(io)
(fn (viaBuiltin n)
  (+ n __argc))

(:: shout (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (shout n)
  {
    (__syscall3 1 1 0 0)
    n
  })

(:: apply (-> (-> Int Int) Int Int))
(fn (apply f x)
  (f x))

;@axiom:restrict(no-io)
(:: viaCallback (-> Int Int))
;@axiom:effect(io)
(fn (viaCallback n)
  (apply shout n))

;@axiom:restrict(no-io,no-alloc)
(:: quiet (-> Int Int))
(fn (quiet n)
  (apply
    (lambda (x) (+ x 1))
    n))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (+ (viaCap 1) (+ (viaModule 2) (+ (viaBuiltin 3) (+ (viaCallback 6) (quiet 7))))))
