(effect Ask (ask :: (-> Int Int)))
(:: mid (-> Int Int))
(fn (mid n) (ask n))
(:: syscaller (-> Int Int))
(fn (syscaller n) (__syscall3 1 n 0 0))
(:: transitive (-> Int Int))
(fn (transitive n) (handle (mid n) (IO) (lambda (v) 0)))
(:: builtin_io (-> Int Int))
(fn (builtin_io n) (handle (syscaller n) (Alloc) (lambda (v) 0)))
(:: nested (-> Int Int))
(fn (nested n) (handle (handle (ask n) (Ask) (lambda (v) 0)) (IO) (lambda (v) 0)))
(:: main Int)
(fn (main) 0)
