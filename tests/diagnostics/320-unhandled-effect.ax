(effect Ask
  (ask :: (-> Int Int)))

(:: mid (-> Int Int))

(fn (mid n) (ask n))

(:: syscaller (-> Int Int))

;@axiom:effect(io)
(fn (syscaller n) (__syscall3 1 n 0 0))

(:: transitive (-> Int Int))

(fn (transitive n)
  (handle (mid n) (IO) (lambda (v) 0))
)

(:: builtin_io (-> Int Int))

;@axiom:effect(io)
(fn (builtin_io n)
  (handle (syscaller n) (Alloc) (lambda (v) 0))
)

(:: nested (-> Int Int))

(fn (nested n)
  (handle (handle (ask n) (Ask) (lambda (v) 0)) (IO) (lambda (v) 0))
)

(:: shadowed (-> Int Int))

(fn (shadowed n)
  (let ((ask 
    (lambda (x) x)
  ))
    (handle (ask n) (IO) (lambda (v) 0))
  )
)

(:: main Int)

(fn (main) 0)
