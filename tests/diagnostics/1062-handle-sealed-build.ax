; A handle is built only by its own module (docs/memory-model.md
; MM-VAL-10a, MM-PAR-8). `Chan` and `Mutex` are `pub`, so this file can
; name them, but building one from a word - in either spelling - is
; AX3085. The channel `chanNew` answers is the control.
(import Chan)
(import Sync)
(import Err)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(block)
(fn (main)
  (match (chanNew 1)
    ((Ok good)
      {
        (chanSend good 1)
        (chanSend (Chan 5) 1)
        (chanSend
          (struct Chan 5)
          1)
        (mutexOwnerDead (Mutex 7))
        0
      }
    )
    ((Err e) 1)))
