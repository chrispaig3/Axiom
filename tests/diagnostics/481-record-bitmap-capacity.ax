; MM-LIFE-2d's capacity cliff. The shape word maps payload words
; 0..46 - bit 63 is the i64 sign bit, reserved so shape constants
; stay non-negative - so a struct may declare 47 fields and a
; constructor 46 beside its tag word. One past each limit refuses
; with AX3029 at the DECLARATION: a map that silently dropped its
; widest field would free everything it named and leak the one it
; could not. The pre-2d compiler accepts this whole file, exit 0.
(struct Wide
  (f0 : Int)
  (f1 : Int)
  (f2 : Int)
  (f3 : Int)
  (f4 : Int)
  (f5 : Int)
  (f6 : Int)
  (f7 : Int)
  (f8 : Int)
  (f9 : Int)
  (f10 : Int)
  (f11 : Int)
  (f12 : Int)
  (f13 : Int)
  (f14 : Int)
  (f15 : Int)
  (f16 : Int)
  (f17 : Int)
  (f18 : Int)
  (f19 : Int)
  (f20 : Int)
  (f21 : Int)
  (f22 : Int)
  (f23 : Int)
  (f24 : Int)
  (f25 : Int)
  (f26 : Int)
  (f27 : Int)
  (f28 : Int)
  (f29 : Int)
  (f30 : Int)
  (f31 : Int)
  (f32 : Int)
  (f33 : Int)
  (f34 : Int)
  (f35 : Int)
  (f36 : Int)
  (f37 : Int)
  (f38 : Int)
  (f39 : Int)
  (f40 : Int)
  (f41 : Int)
  (f42 : Int)
  (f43 : Int)
  (f44 : Int)
  (f45 : Int)
  (f46 : Int)
  (f47 : Int))

(data WideD
  (WD Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int Int))

(:: main Int)

(fn (main) 0)
