; Hash and secret address operations are internal. Typed wrappers may
; use raw kernels; callers cannot name those kernels, a hash state
; address entry point, or the secret store.
(import Crypto.Sha2)
(import Crypto.Sha3)
(import Crypto.Blake2b)
(import Crypto.Hmac)
(import Crypto.Hkdf)
(import Crypto.Secret)

(:: shaAddress (-> Int Int))
(fn (shaAddress address)
  (sha256Addr address 3 address))

(:: shaUpdateAddress (-> Sha256 Int Int))
(fn (shaUpdateAddress h address)
  (sha256UpdateAddr h address 3))

(:: keccakAddress (-> Int Int))
(fn (keccakAddress address)
  (keccakF1600 address))

(:: blakeAddress (-> Int Int))
(fn (blakeAddress address)
  (blake2bAddr address 0 address 0 address 64))

(:: hmacAddress (-> Int Int))
(fn (hmacAddress address)
  (hmacSha256Raw address 32 address 3 address))

(:: hkdfAddress (-> Int Int))
(fn (hkdfAddress address)
  (hkdfSha256Raw address 32 address 0 address 0 address 32))

(:: secretAddress (-> SecretBytes Int))
(fn (secretAddress s)
  (secretBlockAddr 16 (secretLen s)))
