; What `word` and `shared` require of a struct (docs/memory-model.md
; MM-VAL-10a), each refusal AX3084: a word struct is one `Int` field,
; not `mut`, with no type parameters; `shared` needs `word`; a marker is
; written once; and no other name may stand where the markers go. The
; last two structs are the controls: a shared word, and a heap struct
; with no markers.
(struct TwoFields word
  (a : Int)
  (b : Int))

(struct Mutable word
  (mut x : Int))

(struct NotAWord word
  (x : String))

(struct Params word (a)
  (x : Int))

(struct SharedHeap shared
  (x : Int))

(struct Twice word word
  (x : Int))

(struct Unknown packed
  (x : Int))

(struct Good word shared
  (x : Int))

(struct Plain
  (x : Int))

(:: main Int)
(fn (main)
  0)
