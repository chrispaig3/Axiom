; Unmap and wait still accept caller addresses through trusted wrappers.
; Entropy uses the typed Crypto.Random interface: it returns owned bytes.
; noUnsafe accepts the typed call; pureFill refutes its IO and Entropy claims.
; IO's typed descriptor calls keep their own range checks.
(import Sys)
(import Crypto.Random)
(import IO)
(import Str)
(import Err)

;@axiom:effect(io)
(:: randomBytes (-> Int (Result String Error)))
;@axiom:effect(entropy)
(fn (randomBytes n)
  (secureRandomBytes n))

;@axiom:effect(io)
(:: unmapsAt (-> Int (Result Int Error)))
(fn (unmapsAt addr)
  (sysUnmapShared addr 4096))

;@axiom:effect(io)
(:: waitsAt (-> Int Int))
;@axiom:effect(block)
(fn (waitsAt addr)
  (sysWaitWord addr 0))

(:: pureFill (-> Int (Result String Error)))
;@axiom:effect(pure)
(fn (pureFill n)
  (secureRandomBytes n))

;@axiom:restrict(no-unsafe)
(:: noUnsafe (-> Int (Result String Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (noUnsafe n)
  (secureRandomBytes n))

;@axiom:restrict(no-unsafe)
(:: typed (-> String Int))
;@axiom:effect(io)
(fn (typed path)
  {
    (let buf (readBufferNew 64))
    {
      (writeStr stdout (unwrapOr (readFile path) ""))
      (match (fileRead stdin buf 0 64)
        ((Ok n) (writeStr stdout (readBufferText buf 0 n)))
        ((Err e) ()))
      (match (termSize stdin)
        ((Ok sz) sz.cols)
        ((Err e) 0))
    }
  })

(:: main ())
(fn (main)
  ())
