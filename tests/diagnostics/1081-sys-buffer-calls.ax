; Every `Sys` call that hands the kernel an address its caller chose is
; a trusted encapsulation (docs/memory-model.md MM-EXEC-9d), so its
; caller needs no tag and a call to it is ordinary safe code. The kernel
; reads or writes wherever the address points, so a bad address still
; crashes the program; nothing here checks it. None of them takes a
; descriptor: the descriptor calls are `IO`'s, over a `File`.
;
; One untagged declaration per call, each accepted: entropy, and the
; shared-memory unmap and wait. `noUnsafe` claims `restrict(no-unsafe)`
; over `sysRandomBytes` and is accepted too. `pureFill` claims `pure`
; over `sysRandomBytes` and draws AX3010 for the IO it performs.
;
; `typed` does the same work through the typed calls in `IO`, which
; take a `File` and a `String` or answer a fresh one.
(import Sys)
(import IO)
(import Str)
(import Err)

;@axiom:effect(io)
(:: fillsAt (-> Int (Result Int Error)))
;@axiom:effect(entropy)
(fn (fillsAt buf)
  (sysRandomBytes buf 64))

;@axiom:effect(io)
(:: unmapsAt (-> Int (Result Int Error)))
(fn (unmapsAt addr)
  (sysUnmapShared addr 4096))

;@axiom:effect(io)
(:: waitsAt (-> Int Int))
;@axiom:effect(block)
(fn (waitsAt addr)
  (sysWaitWord addr 0))

(:: pureFill (-> Int (Result Int Error)))
;@axiom:effect(pure)
(fn (pureFill buf)
  (sysRandomBytes buf 64))

;@axiom:restrict(no-unsafe)
(:: noUnsafe (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (noUnsafe buf)
  (sysRandomBytes buf 64))

;@axiom:restrict(no-unsafe)
(:: typed (-> String Int))
;@axiom:effect(io)
(fn (typed path)
  (let ((buf (strAlloc 64)))
    {
      (writeStr stdout (readFile path))
      (match (readInto stdin buf 0 64)
        ((Ok n) (writeSlice stdout buf 0 n))
        ((Err e) 0))
      (match (termSize stdin)
        ((Ok sz) sz.cols)
        ((Err e) 0))
    }))

(:: main Int)
(fn (main)
  0)
