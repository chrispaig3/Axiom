; A cast that makes a spawn handle out of another word forges one
; (docs/memory-model.md MM-PAR-8, MM-EXEC-9d), as a cast into a word
; struct does, so a declaration performing one says
; `;@axiom:effect(unsafe)` or draws AX3073 at the cast.
;
; `forged` spells a spawn handle out of an `Int`, `viaAlias` out of an
; `Int` through an alias, `fromChan` out of a channel, and `inLambda`
; inside a lambda, which is its declaration's body too. Before the
; rule each checked OK, and its join trapped with status 85 at run time
; (tests/stdlib/572-spawn-joined-twice.ax).
;
; The controls draw nothing. `same` casts a handle to the type it
; already has. `asWord` erases and says so; fixture 1510 is the refusal.
; `trusted` forges and says so, and `caller` calls it with no tag of its
; own. `main` spawns and joins through the ordinary path.
(import IO)
(import Chan)

(type Job Spawn)

(:: forged (-> Int Spawn))
(fn (forged w)
  (as w Spawn))

(:: viaAlias (-> Int Job))
(fn (viaAlias w)
  (as w Job))

(:: fromChan (-> Chan Spawn))
(fn (fromChan c)
  (as c Spawn))

(:: inLambda (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (inLambda w)
  ((lambda (x)
    (__proc_join (as x Spawn))
  )
    w))

(:: same (-> Spawn Spawn))
(fn (same h)
  (as h Spawn))

(:: asWord (-> Spawn Int))
;@axiom:effect(unsafe)
(fn (asWord h)
  (as h Int))

(:: trusted (-> Int Spawn))
;@axiom:effect(unsafe)
(fn (trusted w)
  (as w Spawn))

(:: caller (-> Int Spawn))
(fn (caller w)
  (trusted w))

(:: main ())
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  {
    (let h (__proc_spawn (lambda (x) (+ x 1)) 41))
    {
      (println (> (asWord (same h)) 0))
      (println (__proc_join h))
    }
  })
