(:: f3 (-> (Vec String) String Int))

(fn (f3 v x) (f2 v x))

(:: f2 (-> (Vec String) String Int))

(fn (f2 v x) (f1 v x))

(:: f1 (-> (Vec String) String Int))

(fn (f1 v x) (f0 v x))

(:: f0 (-> (Vec String) String Int))

(fn (f0 v x)
  {
    (vecPush v (strConcat x "!"))
    0
  }
)

(:: main Int)

(fn (main) 0)
