; A mutex's guard is a `MutexGuard` (docs/memory-model.md MM-PAR-11,
; MM-PAR-15), which only a lock call answers and whose end lets the lock
; go. A guard used as an `Int` is AX3004. Nothing unlocks by hand:
; `mutexUnlock` is gone, so a call to it is AX3001. The lock whose guard
; simply ends is the control.
(import Sync)
(import Err)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(block)
(fn (main)
  (match (mutexNew)
    ((Ok m)
      (match (mutexLock m)
        ((Ok g)
          {
            (+ g 1)
            (mutexUnlock m g)
            0
          }
        )
        ((Err e) 3))
    )
    ((Err e) 1)))
