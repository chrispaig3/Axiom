; AX3043: a reference smuggled through a field declared `Int`.
; The cast is also AX3073. Both stores still draw AX3043: the word
; in an `Int` field is invisible to the release walk, so it leaks.
; One declaration reports the erasure once, at the first cast. The
; direct shape (a `String` where an `Int` stands) is `AX3004`, owned
; by that error rather than doubled here; a cast of an `Int` draws
; nothing, since there is no reference to hide.
(struct Box
  (v : Int))

(data E
  (Err Int))

(:: main ())
(fn (main)
  {
    (let s "x")
    {
      {
        (let b (Box :v (as s Int)))
        ()
      }
      {
        (let e (Err (as s Int)))
        ()
      }
      {
        (let n (Box :v (as 5 Int)))
        ()
      }
    }
  })
