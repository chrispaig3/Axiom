; A `MutexGuard` is sealed to `Sync` (docs/memory-model.md MM-PAR-15):
; building one is AX3085 and reading its owner is AX3086. It is a
; resource owner, not `shared`, so a concurrent binding that captures
; one is AX3064: a guard belongs to the binding whose lock call answered
; it. A binding that takes and ends its own guard is the control.
(import Sync)
(import Err)

(:: lockIn (-> Mutex Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (lockIn m)
  (match (mutexLock m)
    ((Ok g) 0)
    ((Err e) 2)))

(:: keep (-> MutexGuard Int))
(fn (keep g)
  0)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (match (mutexNew)
    ((Ok m)
      (match (mutexLock m)
        ((Ok g)
          {
            (keep (MutexGuard 5))
            (let ((h g.owner))
              0)
            (parallel p (
              (a (lockIn m))
              (b (keep g))
            )
              (+ a b))
          }
        )
        ((Err e) 3))
    )
    ((Err e) 1)))
