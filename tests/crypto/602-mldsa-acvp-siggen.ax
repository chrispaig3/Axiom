; signCase for parameter set `n`.
(:: signCase (-> Int String String String String String String))
;@axiom:effect(io)
(fn (signCase n skb iface rnd ctx msg)
  (if (== n 44) (signCase44 skb iface rnd ctx msg) (== n 65) (signCase65 skb iface rnd ctx msg) (signCase87 skb iface rnd ctx msg)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "mldsa-acvp-siggen")) (mut sk ""))
    {
      (for line in (katLines "mldsa-acvp-siggen.txt")
        (let ((f (katFields line)))
          (if (strEq (katText f 0) "key")
            {
              (set sk (katBytes f 2))
              0
            }
            (let ((got (signCase (katInt f 1) sk (katText f 2) (katBytes f 3) (katBytes f 4) (katBytes f 5))))
              (tallyCheck t (strEq got (katText f 6)) (strConcat "ML-DSA-" (strConcat (katText f 1) (strConcat " " (strConcat (katText f 2) (strConcat ": got " got))))))))))
      (tallyReport t)
    }))
