; ML-DSA against OpenSSL: for seeded keys, contexts and messages in all
; three parameter sets, the public key and the expanded private key
; OpenSSL derives from the seed, and its deterministic and explicit-rnd
; signatures, must match ours (as SHA-256 digests), and ours must
; verify; OpenSSL's hedged signatures, made with its own randomness,
; must verify here.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.Sha2)
(import Crypto.MlDsa)
(import Kat)

(:: orDie (-> (Result a Error) String a))
;@axiom:effect(io)
(fn (orDie r what)
  (match r
    ((Ok v) v)
    ((Err e) (cast a (die (strConcat "TEST: " (strConcat what (strConcat ": " (errorText e)))) 3)))))

(:: shaHex (-> String String))
(fn (shaHex s)
  (hexEncode (sha256 s)))

; M' for pure ML-DSA: 0, the context's length, the context, the message.
(:: pureMPrime (-> String String String))
;@axiom:effect(unsafe)
(fn (pureMPrime ctx msg)
  (let ((pre (bytesNew 2)))
    {
      (__store8 (strData pre) 1 (strLen ctx))
      (strConcat pre (strConcat ctx msg))
    }))

; The code of an Err, or 0 for Ok.
(:: codeOf (-> (Result a Error) Int))
(fn (codeOf r)
  (match r
    ((Ok _) 0)
    ((Err e) (errCode e))))

(:: ossl44 (-> String String String String String))
;@axiom:effect(io)
(fn (ossl44 seed ctx msg rnd)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa44KeyFromSeed s) "KeyFromSeed")))
      (let (
        (pk (mlDsa44PublicKey k))
        (sk (orDie (mlDsa44KeyExport k) "KeyExport"))
        (sig
          (orDie
            (if (== (strLen rnd) 0)
              (mlDsa44SignDeterministic k msg ctx)
              (mlDsa44SignInternal k (pureMPrime ctx msg) rnd))
            "sign"))
      )
        (let ((answer
          (strConcat (shaHex (mlDsa44PublicKeyBytes pk))
            (strConcat " "
              (strConcat (shaHex (secretExposeCopy sk))
                (strConcat " "
                  (strConcat (shaHex (mlDsa44SignatureBytes sig))
                    (if (mlDsa44Verify pk msg ctx sig) "" " (does not verify)"))))))))
          {
            (mlDsa44KeyWipe k)
            (secretWipe s)
            (secretWipe sk)
            answer
          })))))

