;@axiom:effect(io)
(fn (ossl65 seed ctx msg rnd)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa65KeyFromSeed s) "KeyFromSeed")))
      (let (
