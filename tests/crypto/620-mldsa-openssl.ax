; ossl for parameter set `n`.
(:: ossl (-> Int String String String String String))
;@axiom:effect(io)
(fn (ossl n seed ctx msg rnd)
  (if (== n 44) (ossl44 seed ctx msg rnd) (== n 65) (ossl65 seed ctx msg rnd) (ossl87 seed ctx msg rnd)))

(:: osslVerify44 (-> String String String String Bool))
;@axiom:effect(io)
(fn (osslVerify44 seed ctx msg sigb)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa44KeyFromSeed s) "KeyFromSeed")))
      (let ((ok
        (match (mlDsa44SignatureFromBytes sigb)
          ((Err _) false)
          ((Ok sig) (mlDsa44Verify (mlDsa44PublicKey k) msg ctx sig)))))
        {
          (mlDsa44KeyWipe k)
          (secretWipe s)
          ok
        }))))

(:: osslVerify65 (-> String String String String Bool))
;@axiom:effect(io)
(fn (osslVerify65 seed ctx msg sigb)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa65KeyFromSeed s) "KeyFromSeed")))
      (let ((ok
        (match (mlDsa65SignatureFromBytes sigb)
          ((Err _) false)
          ((Ok sig) (mlDsa65Verify (mlDsa65PublicKey k) msg ctx sig)))))
        {
          (mlDsa65KeyWipe k)
          (secretWipe s)
          ok
        }))))

(:: osslVerify87 (-> String String String String Bool))
;@axiom:effect(io)
(fn (osslVerify87 seed ctx msg sigb)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa87KeyFromSeed s) "KeyFromSeed")))
      (let ((ok
        (match (mlDsa87SignatureFromBytes sigb)
          ((Err _) false)
          ((Ok sig) (mlDsa87Verify (mlDsa87PublicKey k) msg ctx sig)))))
        {
          (mlDsa87KeyWipe k)
          (secretWipe s)
          ok
        }))))

; osslVerify for parameter set `n`.
(:: osslVerify (-> Int String String String String Bool))
;@axiom:effect(io)
(fn (osslVerify n seed ctx msg sigb)
  (if (== n 44) (osslVerify44 seed ctx msg sigb) (== n 65) (osslVerify65 seed ctx msg sigb) (osslVerify87 seed ctx msg sigb)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "mldsa-openssl")))
    {
      (for line in (katLines "mldsa-openssl.txt")
        (let ((f (katFields line)))
          (let ((label (strConcat "ML-DSA-" (strConcat (katText f 1) (strConcat " seed " (katText f 2))))))
            (if (strEq (katText f 0) "sign")
              (let (
                (want (strConcat (katText f 6) (strConcat " " (strConcat (katText f 7) (strConcat " " (katText f 8))))))
                (got (ossl (katInt f 1) (katBytes f 2) (katBytes f 3) (katBytes f 4) (katBytes f 5)))
              )
                (tallyCheck t (strEq got want) (strConcat label (strConcat ": got " got))))
              (tallyCheck t (osslVerify (katInt f 1) (katBytes f 2) (katBytes f 3) (katBytes f 4) (katBytes f 5)) (strConcat label ": OpenSSL's hedged signature"))))))
      (tallyReport t)
    }))
