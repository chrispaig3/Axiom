; ML-DSA signing against Wycheproof (sign_seed and sign_noseed, all
; three parameter sets): keys from seeds and from encodings, including
; seeds of the wrong length and encodings with s1 or s2 out of range,
; which must be refused; deterministic, hedged and external-mu
; signatures, including ones that take many iterations of the
; rejection loop or sit on its boundaries, which must match
; Wycheproof's and verify; and contexts over 255 bytes, which must be
; refused.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.Sha2)
(import Crypto.MlDsa)
(import Kat)

(:: orDie (-> (Result a Error) String a))
;@axiom:effect(io)
(fn (orDie r what)
  (match r
    ((Ok v) v)
    ((Err e) (cast a (die (strConcat "TEST: " (strConcat what (strConcat ": " (errorText e)))) 3)))))

(:: shaHex (-> String String))
(fn (shaHex s)
  (hexEncode (sha256 s)))

; M' for pure ML-DSA: 0, the context's length, the context, the message.
(:: pureMPrime (-> String String String))
;@axiom:effect(unsafe)
(fn (pureMPrime ctx msg)
  (let ((pre (bytesNew 2)))
    {
      (__store8 (strData pre) 1 (strLen ctx))
      (strConcat pre (strConcat ctx msg))
    }))

; The code of an Err, or 0 for Ok.
(:: codeOf (-> (Result a Error) Int))
(fn (codeOf r)
  (match r
    ((Ok _) 0)
    ((Err e) (errCode e))))

(:: wpKeyOk44 (-> String String Bool))
;@axiom:effect(io)
(fn (wpKeyOk44 kind keyb)
  (let ((s (orDie (secretFromString keyb) "secretFromString")))
    (let ((ok
      (match (if (strEq kind "seed") (mlDsa44KeyFromSeed s) (mlDsa44KeyFromSecret s))
        ((Err _) false)
        ((Ok k)
          {
            (mlDsa44KeyWipe k)
            true
          }))))
      {
        (secretWipe s)
        ok
      })))

(:: wpKeyOk65 (-> String String Bool))
;@axiom:effect(io)
(fn (wpKeyOk65 kind keyb)
  (let ((s (orDie (secretFromString keyb) "secretFromString")))
    (let ((ok
      (match (if (strEq kind "seed") (mlDsa65KeyFromSeed s) (mlDsa65KeyFromSecret s))
        ((Err _) false)
        ((Ok k)
          {
            (mlDsa65KeyWipe k)
            true
          }))))
      {
        (secretWipe s)
        ok
      })))

(:: wpKeyOk87 (-> String String Bool))
;@axiom:effect(io)
(fn (wpKeyOk87 kind keyb)
  (let ((s (orDie (secretFromString keyb) "secretFromString")))
    (let ((ok
      (match (if (strEq kind "seed") (mlDsa87KeyFromSeed s) (mlDsa87KeyFromSecret s))
        ((Err _) false)
        ((Ok k)
          {
            (mlDsa87KeyWipe k)
            true
          }))))
      {
        (secretWipe s)
        ok
      })))

; wpKeyOk for parameter set `n`.
(:: wpKeyOk (-> Int String String Bool))
;@axiom:effect(io)
(fn (wpKeyOk n kind keyb)
  (if (== n 44) (wpKeyOk44 kind keyb) (== n 65) (wpKeyOk65 kind keyb) (wpKeyOk87 kind keyb)))

(:: wpSign44 (-> String String String String String String String))
;@axiom:effect(io)
(fn (wpSign44 kind keyb iface rnd ctx msg)
  (let ((s (orDie (secretFromString keyb) "secretFromString")))
    (match (if (strEq kind "seed") (mlDsa44KeyFromSeed s) (mlDsa44KeyFromSecret s))
      ((Err e)
        {
          (secretWipe s)
          (strConcat "key refused: " (errorText e))
        })
      ((Ok k)
        (let ((pk (mlDsa44PublicKey k)) (r0 (if (== (strLen rnd) 0) (bytesNew 32) rnd)))
          (let ((r
            (if (strEq iface "mu")
              (mlDsa44SignExternalMu k msg r0)
              (> (strLen ctx) 255)
              (mlDsa44SignDeterministic k msg ctx)
              (== (strLen rnd) 0)
              (mlDsa44SignDeterministic k msg ctx)
              (mlDsa44SignInternal k (pureMPrime ctx msg) rnd))))
            (let ((answer
              (match r
                ((Err e) (strConcat "sign refused: " (errorText e)))
                ((Ok sig)
                  (let ((ok
                    (if (strEq iface "mu")
                      (mlDsa44VerifyExternalMu pk msg sig)
                      (mlDsa44Verify pk msg ctx sig))))
                    (if ok
                      (shaHex (mlDsa44SignatureBytes sig))
                      (strConcat (shaHex (mlDsa44SignatureBytes sig)) " (does not verify)")))))))
              {
                (mlDsa44KeyWipe k)
                (secretWipe s)
                answer
              })))))))

