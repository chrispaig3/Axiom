;@axiom:effect(io)
(fn (wpSign65 kind keyb iface rnd ctx msg)
  (let ((s (orDie (secretFromString keyb) "secretFromString")))
    (match (if (strEq kind "seed") (mlDsa65KeyFromSeed s) (mlDsa65KeyFromSecret s))
      ((Err e)
        {
          (secretWipe s)
          (strConcat "key refused: " (errorText e))
        })
      ((Ok k)
        (let ((pk (mlDsa65PublicKey k)) (r0 (if (== (strLen rnd) 0) (bytesNew 32) rnd)))
          (let ((r
            (if (strEq iface "mu")
              (mlDsa65SignExternalMu k msg r0)
              (> (strLen ctx) 255)
              (mlDsa65SignDeterministic k msg ctx)
              (== (strLen rnd) 0)
              (mlDsa65SignDeterministic k msg ctx)
              (mlDsa65SignInternal k (pureMPrime ctx msg) rnd))))
            (let ((answer
              (match r
                ((Err e) (strConcat "sign refused: " (errorText e)))
                ((Ok sig)
                  (let ((ok
                    (if (strEq iface "mu")
                      (mlDsa65VerifyExternalMu pk msg sig)
                      (mlDsa65Verify pk msg ctx sig))))
                    (if ok
                      (shaHex (mlDsa65SignatureBytes sig))
                      (strConcat (shaHex (mlDsa65SignatureBytes sig)) " (does not verify)")))))))
              {
                (mlDsa65KeyWipe k)
                (secretWipe s)
                answer
              })))))))

(:: wpSign87 (-> String String String String String String String))
;@axiom:effect(io)
(fn (wpSign87 kind keyb iface rnd ctx msg)
  (let ((s (orDie (secretFromString keyb) "secretFromString")))
    (match (if (strEq kind "seed") (mlDsa87KeyFromSeed s) (mlDsa87KeyFromSecret s))
      ((Err e)
        {
          (secretWipe s)
          (strConcat "key refused: " (errorText e))
        })
      ((Ok k)
        (let ((pk (mlDsa87PublicKey k)) (r0 (if (== (strLen rnd) 0) (bytesNew 32) rnd)))
          (let ((r
            (if (strEq iface "mu")
              (mlDsa87SignExternalMu k msg r0)
              (> (strLen ctx) 255)
              (mlDsa87SignDeterministic k msg ctx)
              (== (strLen rnd) 0)
              (mlDsa87SignDeterministic k msg ctx)
              (mlDsa87SignInternal k (pureMPrime ctx msg) rnd))))
            (let ((answer
              (match r
                ((Err e) (strConcat "sign refused: " (errorText e)))
                ((Ok sig)
                  (let ((ok
                    (if (strEq iface "mu")
                      (mlDsa87VerifyExternalMu pk msg sig)
