; wpSign for parameter set `n`.
(:: wpSign (-> Int String String String String String String String))
;@axiom:effect(io)
(fn (wpSign n kind keyb iface rnd ctx msg)
  (if (== n 44) (wpSign44 kind keyb iface rnd ctx msg) (== n 65) (wpSign65 kind keyb iface rnd ctx msg) (wpSign87 kind keyb iface rnd ctx msg)))

(:: agrees (-> Bool Bool Bool))
(fn (agrees a b)
  (if a b (! b)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "wycheproof-mldsa-sign")) (mut kind "") (mut keyb ""))
    {
      (for line in (katLines "wycheproof-mldsa-sign.txt")
        (let ((f (katFields line)) (op (katText (katFields line) 0)))
          (if (|| (strEq op "seed") (strEq op "key"))
            {
              (set kind op)
              (set keyb (katBytes f 2))
              (tallyCheck t (agrees (wpKeyOk (katInt f 1) kind keyb) (strEq (katText f 3) "01"))
                (strConcat "ML-DSA-" (strConcat (katText f 1) (strConcat " " (strConcat op (strConcat " accepted: expected " (katText f 3)))))))
            }
            (let ((got (wpSign (katInt f 1) kind keyb (katText f 3) (katBytes f 4) (katBytes f 5) (katBytes f 6))))
              (let ((label (strConcat "ML-DSA-" (strConcat (katText f 1) (strConcat " tcId " (strConcat (katText f 2) (strConcat ": got " got)))))))
                (if (strEq (katText f 7) "valid")
                  (tallyCheck t (strEq got (katText f 8)) label)
                  (tallyCheck t (|| (strStartsWith got "sign refused") (strStartsWith got "key refused")) label)))))))
      (tallyReport t)
    }))
