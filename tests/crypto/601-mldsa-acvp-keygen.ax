;@axiom:effect(io)
(fn (keygen65 seed)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa65KeyFromSeed s) "KeyFromSeed")))
      (let (
        (pk (mlDsa65PublicKeyBytes (mlDsa65PublicKey k)))
        (sk (orDie (mlDsa65KeyExport k) "KeyExport"))
        (xi (orDie (mlDsa65KeyExportSeed k) "KeyExportSeed"))
      )
        (let ((back (orDie (mlDsa65KeyFromSecret sk) "KeyFromSecret")))
