(:: keygen87 (-> String String))
;@axiom:effect(io)
(fn (keygen87 seed)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa87KeyFromSeed s) "KeyFromSeed")))
      (let (
        (pk (mlDsa87PublicKeyBytes (mlDsa87PublicKey k)))
        (sk (orDie (mlDsa87KeyExport k) "KeyExport"))
        (xi (orDie (mlDsa87KeyExportSeed k) "KeyExportSeed"))
      )
        (let ((back (orDie (mlDsa87KeyFromSecret sk) "KeyFromSecret")))
          (let (
            (answer (strConcat (shaHex pk) (strConcat " " (shaHex (secretExposeCopy sk)))))
            (trip (&& (strEq (secretExposeCopy xi) seed) (strEq (mlDsa87PublicKeyBytes (mlDsa87PublicKey back)) pk)))
            (noSeed (== (codeOf (mlDsa87KeyExportSeed back)) cryptoUnsupported))
          )
            {
              (mlDsa87KeyWipe k)
              (mlDsa87KeyWipe back)
              (secretWipe s)
              (secretWipe sk)
              (secretWipe xi)
              (if (&& trip noSeed) answer (strConcat answer " (round trip failed)"))
            }))))))

; keygen for parameter set `n`.
(:: keygen (-> Int String String))
;@axiom:effect(io)
(fn (keygen n seed)
  (if (== n 44) (keygen44 seed) (== n 65) (keygen65 seed) (keygen87 seed)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "mldsa-acvp-keygen")))
    {
      (for line in (katLines "mldsa-acvp-keygen.txt")
        (let ((f (katFields line)))
          (let ((want (strConcat (katText f 2) (strConcat " " (katText f 3)))))
            (let ((got (keygen (katInt f 0) (katBytes f 1))))
              (tallyCheck t (strEq got want) (strConcat "ML-DSA-" (strConcat (katText f 0) (strConcat " seed " (strConcat (katText f 1) (strConcat ": got " got))))))))))
      (tallyReport t)
    }))
