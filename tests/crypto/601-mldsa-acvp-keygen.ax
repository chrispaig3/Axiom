; ML-DSA key generation against NIST's ACVP vectors (ML-DSA-keyGen-
; FIPS204): every case of all three parameter sets. For each seed the
; public key and the exported private key must match (as SHA-256
; digests), the exported seed must be the seed, and importing the
; exported private key must give the same public key and no seed.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.Sha2)
(import Crypto.MlDsa)
(import Kat)

(:: orDie (-> (Result a Error) String a))
;@axiom:effect(io)
(fn (orDie r what)
  (match r
    ((Ok v) v)
    ((Err e) (cast a (die (strConcat "TEST: " (strConcat what (strConcat ": " (errorText e)))) 3)))))

(:: shaHex (-> String String))
(fn (shaHex s)
  (hexEncode (sha256 s)))

; M' for pure ML-DSA: 0, the context's length, the context, the message.
(:: pureMPrime (-> String String String))
;@axiom:effect(unsafe)
(fn (pureMPrime ctx msg)
  (let ((pre (bytesNew 2)))
    {
      (__store8 (strData pre) 1 (strLen ctx))
      (strConcat pre (strConcat ctx msg))
    }))

; The code of an Err, or 0 for Ok.
(:: codeOf (-> (Result a Error) Int))
(fn (codeOf r)
  (match r
    ((Ok _) 0)
    ((Err e) (errCode e))))

(:: keygen44 (-> String String))
;@axiom:effect(io)
(fn (keygen44 seed)
  (let ((s (orDie (secretFromString seed) "secretFromString")))
    (let ((k (orDie (mlDsa44KeyFromSeed s) "KeyFromSeed")))
      (let (
        (pk (mlDsa44PublicKeyBytes (mlDsa44PublicKey k)))
        (sk (orDie (mlDsa44KeyExport k) "KeyExport"))
        (xi (orDie (mlDsa44KeyExportSeed k) "KeyExportSeed"))
      )
        (let ((back (orDie (mlDsa44KeyFromSecret sk) "KeyFromSecret")))
          (let (
            (answer (strConcat (shaHex pk) (strConcat " " (shaHex (secretExposeCopy sk)))))
            (trip (&& (strEq (secretExposeCopy xi) seed) (strEq (mlDsa44PublicKeyBytes (mlDsa44PublicKey back)) pk)))
            (noSeed (== (codeOf (mlDsa44KeyExportSeed back)) cryptoUnsupported))
          )
            {
              (mlDsa44KeyWipe k)
              (mlDsa44KeyWipe back)
              (secretWipe s)
              (secretWipe sk)
              (secretWipe xi)
              (if (&& trip noSeed) answer (strConcat answer " (round trip failed)"))
            }))))))

