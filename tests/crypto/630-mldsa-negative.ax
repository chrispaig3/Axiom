; ML-DSA's refusals, for all three parameter sets, around a
; deterministic signature that must match OpenSSL's (the first case of
; each set in mldsa-openssl.txt, as a SHA-256 digest). A flipped bit in
; each region of the signature (c~, z, the hint positions and counts),
; another message, context or key, and a signature or public key of
; the wrong length must not verify. Malformed hint encodings (a count
; past omega, a count that goes down, a repeated position, nonzero
; padding) must be refused by the decoder and fail verification.
; Contexts of 255 bytes work and of 256 are refused. Hedged signatures
; differ and verify; the internal and external-mu interfaces agree with
; the external one; bad lengths of rnd, mu, seeds and keys are refused,
; and so are private keys whose tr, t0 or s1 is wrong.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.Sha2)
(import Crypto.Sha3)
(import Crypto.MlDsa)
(import Kat)

; `s` with bit `bit` of byte `i` flipped, as a fresh string.
(:: flip (-> String Int Int String))
;@axiom:effect(unsafe)
(fn (flip s i bit)
  (let ((c (bytesFromAddr (strData s) (strLen s))))
    {
      (__store8 (strData c) i (^ (strByte s i) (<< 1 bit)))
      c
    }))

; `s` with byte `i` set to `v`, as a fresh string.
(:: setByte (-> String Int Int String))
;@axiom:effect(unsafe)
(fn (setByte s i v)
  (let ((c (bytesFromAddr (strData s) (strLen s))))
    {
      (__store8 (strData c) i v)
      c
    }))

; `s` with its omega + k hint bytes from `at` zeroed.
(:: zeroHints (-> String Int Int Int String))
;@axiom:effect(unsafe)
(fn (zeroHints s at omega k)
  (let ((c (bytesFromAddr (strData s) (strLen s))))
    {
      (for i 0 (+ omega k)
        (__store8 (strData c) (+ at i) 0))
      c
    }))

; `s` with every one of its k hint counts set to `v`.
(:: setAllCounts (-> String Int Int Int Int String))
;@axiom:effect(unsafe)
(fn (setAllCounts s at omega k v)
  (let ((c (bytesFromAddr (strData s) (strLen s))))
    {
      (for i 0 k
        (__store8 (strData c) (+ at (+ omega i)) v))
      c
    }))

(:: mldsaCtb (-> Int Int))
(fn (mldsaCtb n)
  (if (== n 44) 32 (== n 65) 48 64))

(:: mldsaOmega (-> Int Int))
(fn (mldsaOmega n)
  (if (== n 44) 80 (== n 65) 55 75))

(:: mldsaK (-> Int Int))
(fn (mldsaK n)
  (if (== n 44) 4 (== n 65) 6 8))

(:: orDie (-> (Result a Error) String a))
;@axiom:effect(io)
(fn (orDie r what)
  (match r
    ((Ok v) v)
    ((Err e) (cast a (die (strConcat "TEST: " (strConcat what (strConcat ": " (errorText e)))) 3)))))

(:: shaHex (-> String String))
(fn (shaHex s)
  (hexEncode (sha256 s)))

; M' for pure ML-DSA: 0, the context's length, the context, the message.
(:: pureMPrime (-> String String String))
;@axiom:effect(unsafe)
(fn (pureMPrime ctx msg)
  (let ((pre (bytesNew 2)))
    {
      (__store8 (strData pre) 1 (strLen ctx))
      (strConcat pre (strConcat ctx msg))
    }))

; The code of an Err, or 0 for Ok.
(:: codeOf (-> (Result a Error) Int))
(fn (codeOf r)
  (match r
    ((Ok _) 0)
    ((Err e) (errCode e))))

(:: keyFrom44 (-> String (Result Int Error)))
;@axiom:effect(io)
(fn (keyFrom44 b)
  (let ((s (orDie (secretFromString b) "secretFromString")))
    (let ((r (mlDsa44KeyFromSecret s)))
      {
        (secretWipe s)
        (match r
          ((Ok k)
            {
              (mlDsa44KeyWipe k)
              (Ok 0)
            })
          ((Err e) (Err e)))
      })))

(:: keyFrom65 (-> String (Result Int Error)))
;@axiom:effect(io)
(fn (keyFrom65 b)
  (let ((s (orDie (secretFromString b) "secretFromString")))
    (let ((r (mlDsa65KeyFromSecret s)))
      {
        (secretWipe s)
        (match r
          ((Ok k)
            {
              (mlDsa65KeyWipe k)
              (Ok 0)
            })
          ((Err e) (Err e)))
      })))

(:: keyFrom87 (-> String (Result Int Error)))
;@axiom:effect(io)
(fn (keyFrom87 b)
  (let ((s (orDie (secretFromString b) "secretFromString")))
    (let ((r (mlDsa87KeyFromSecret s)))
      {
        (secretWipe s)
        (match r
          ((Ok k)
            {
              (mlDsa87KeyWipe k)
              (Ok 0)
            })
          ((Err e) (Err e)))
      })))

; keyFrom for parameter set `n`.
(:: keyFrom (-> Int String (Result Int Error)))
;@axiom:effect(io)
(fn (keyFrom n b)
  (if (== n 44) (keyFrom44 b) (== n 65) (keyFrom65 b) (keyFrom87 b)))

(:: neg44 (-> Tally String String String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (neg44 t seed ctx msg)
  (let (
    (s (orDie (secretFromString seed) "secretFromString"))
    (other (orDie (secretFromString (flip seed 0 0)) "secretFromString"))
  )
    (let ((k (orDie (mlDsa44KeyFromSeed s) "KeyFromSeed")) (k2 (orDie (mlDsa44KeyFromSeed other) "KeyFromSeed")))
      (let (
        (pk (mlDsa44PublicKey k))
        (sig (orDie (mlDsa44SignDeterministic k msg ctx) "SignDeterministic"))
      )
        (let ((sb (mlDsa44SignatureBytes sig)) (pkb (mlDsa44PublicKeyBytes pk)) (label "ML-DSA-44"))
          (let (
            (ctb (mldsaCtb 44))
            (hintAt (- (strLen sb) (+ (mldsaOmega 44) (mldsaK 44))))
            (bad (lambda (b) (! (mlDsa44Verify pk msg ctx (MlDsa44Signature b)))))
            (refused (lambda (b) (== (codeOf (mlDsa44SignatureFromBytes b)) cryptoInvalidEncoding)))
          )
            {
              (tallyCheck t (mlDsa44Verify pk msg ctx sig) (strConcat label ": the signature verifies"))
              (tallyCheck t (! (mlDsa44Verify pk msg (strConcat ctx "x") sig)) (strConcat label ": another context"))
              (tallyCheck t (! (mlDsa44Verify pk (strConcat msg "x") ctx sig)) (strConcat label ": another message"))
              (tallyCheck t (! (mlDsa44Verify (mlDsa44PublicKey k2) msg ctx sig)) (strConcat label ": another key"))
              ; every region: c~, z, the hint positions, the hint counts
              (tallyCheck t (bad (flip sb 0 0)) (strConcat label ": c~ first bit"))
              (tallyCheck t (bad (flip sb (- ctb 1) 7)) (strConcat label ": c~ last bit"))
              (tallyCheck t (bad (flip sb ctb 0)) (strConcat label ": z first bit"))
              (tallyCheck t (bad (flip sb (/ (+ ctb hintAt) 2) 3)) (strConcat label ": z middle bit"))
              (tallyCheck t (bad (flip sb (- hintAt 1) 5)) (strConcat label ": z last byte"))
              (tallyCheck t (bad (flip sb hintAt 0)) (strConcat label ": a hint position"))
              (tallyCheck t (bad (flip sb (- (strLen sb) 1) 0)) (strConcat label ": the last hint count"))
              ; malformed hint encodings, refused by the decoder and by verification
              (let ((over (setByte sb (+ hintAt (mldsaOmega 44)) (+ (mldsaOmega 44) 1))))
                {
                  (tallyCheck t (refused over) (strConcat label ": a count past omega is refused"))
                  (tallyCheck t (bad over) (strConcat label ": and does not verify"))
                })
              (let ((down (setByte (setByte sb (+ hintAt (mldsaOmega 44)) 2) (+ hintAt (+ (mldsaOmega 44) 1)) 1)))
                {
                  (tallyCheck t (refused down) (strConcat label ": a count that goes down is refused"))
                  (tallyCheck t (bad down) (strConcat label ": and does not verify"))
                })
              (let ((order (setByte (setByte (setAllCounts (zeroHints sb hintAt (mldsaOmega 44) (mldsaK 44)) hintAt (mldsaOmega 44) (mldsaK 44) 2) hintAt 9) (+ hintAt 1) 9)))
                {
                  (tallyCheck t (refused order) (strConcat label ": a repeated position is refused"))
                  (tallyCheck t (bad order) (strConcat label ": and does not verify"))
                })
              (let ((pad (setByte (zeroHints sb hintAt (mldsaOmega 44) (mldsaK 44)) (+ hintAt (- (mldsaOmega 44) 1)) 1)))
                {
                  (tallyCheck t (refused pad) (strConcat label ": nonzero padding is refused"))
                  (tallyCheck t (bad pad) (strConcat label ": and does not verify"))
                })
              ; lengths
              (tallyCheck t (== (codeOf (mlDsa44SignatureFromBytes (strSlice sb 0 (- (strLen sb) 1)))) cryptoInvalidLength) (strConcat label ": a short signature is refused"))
              (tallyCheck t (bad (strSlice sb 0 (- (strLen sb) 1))) (strConcat label ": and does not verify"))
              (tallyCheck t (bad (strConcat sb "x")) (strConcat label ": a long signature does not verify"))
              (tallyCheck t (== (codeOf (mlDsa44PublicKeyFromBytes (strConcat pkb "x"))) cryptoInvalidLength) (strConcat label ": a long public key is refused"))
              (tallyCheck t (! (mlDsa44Verify (MlDsa44PublicKey (strSlice pkb 0 (- (strLen pkb) 1))) msg ctx sig)) (strConcat label ": a short public key does not verify"))
              ; contexts
              (let ((c255 (bytesNew 255)) (c256 (bytesNew 256)))
                {
                  (tallyCheck t (mlDsa44Verify pk msg c255 (orDie (mlDsa44SignDeterministic k msg c255) "sign")) (strConcat label ": a 255-byte context"))
                  (tallyCheck t (== (codeOf (mlDsa44SignDeterministic k msg c256)) cryptoInvalidLength) (strConcat label ": a 256-byte context is refused"))
                  (tallyCheck t (== (codeOf (mlDsa44Sign k msg c256)) cryptoInvalidLength) (strConcat label ": by hedged signing too"))
                  (tallyCheck t (! (mlDsa44Verify pk msg c256 sig)) (strConcat label ": and verification says false"))
                })
              ; hedged signatures differ and verify
              (let ((h1 (orDie (mlDsa44Sign k msg ctx) "Sign")) (h2 (orDie (mlDsa44Sign k msg ctx) "Sign")))
                {
                  (tallyCheck t (&& (mlDsa44Verify pk msg ctx h1) (mlDsa44Verify pk msg ctx h2)) (strConcat label ": hedged signatures verify"))
                  (tallyCheck t (! (strEq (mlDsa44SignatureBytes h1) (mlDsa44SignatureBytes h2))) (strConcat label ": and differ"))
                })
              ; the internal interfaces agree with the external one
              (let ((mprime (pureMPrime ctx msg)))
                (let ((mu (shake256 (strConcat (shake256 pkb 64) mprime) 64)))
                  {
                    (tallyCheck t (strEq sb (mlDsa44SignatureBytes (orDie (mlDsa44SignInternal k mprime (bytesNew 32)) "SignInternal"))) (strConcat label ": Sign_internal on M' agrees"))
                    (tallyCheck t (strEq sb (mlDsa44SignatureBytes (orDie (mlDsa44SignExternalMu k mu (bytesNew 32)) "SignExternalMu"))) (strConcat label ": Sign_internal from mu agrees"))
                    (tallyCheck t (&& (mlDsa44VerifyInternal pk mprime sig) (mlDsa44VerifyExternalMu pk mu sig)) (strConcat label ": both internal verifications accept"))
                    (tallyCheck t (== (codeOf (mlDsa44SignInternal k mprime (bytesNew 31))) cryptoInvalidLength) (strConcat label ": a 31-byte rnd is refused"))
                    (tallyCheck t (== (codeOf (mlDsa44SignExternalMu k (strSlice mu 0 63) (bytesNew 32))) cryptoInvalidLength) (strConcat label ": a 63-byte mu is refused"))
                    (tallyCheck t (! (mlDsa44VerifyExternalMu pk (strSlice mu 0 63) sig)) (strConcat label ": and does not verify"))
                  }))
              ; keys
              (let ((short (orDie (secretFromString (bytesNew 31)) "secretFromString")) (sk (orDie (mlDsa44KeyExport k) "KeyExport")))
                (let ((skb (secretExposeCopy sk)))
                  {
                    (tallyCheck t (== (codeOf (mlDsa44KeyFromSeed short)) cryptoInvalidLength) (strConcat label ": a 31-byte seed is refused"))
                    (tallyCheck t (== (codeOf (mlDsa44KeyFromSecret short)) cryptoInvalidLength) (strConcat label ": a short private key is refused"))
                    (tallyCheck t (== (codeOf (keyFrom44 (flip skb 64 0))) cryptoInvalidKey) (strConcat label ": a private key with the wrong tr is refused"))
                    (tallyCheck t (== (codeOf (keyFrom44 (flip skb (- (strLen skb) 1) 0))) cryptoInvalidKey) (strConcat label ": a private key with the wrong t0 is refused"))
                    (tallyCheck t (== (codeOf (keyFrom44 (setByte skb 128 255))) cryptoInvalidKey) (strConcat label ": s1 out of range is refused"))
                    (secretWipe short)
                    (secretWipe sk)
                  }))
              (mlDsa44KeyWipe k)
              (mlDsa44KeyWipe k2)
              (secretWipe s)
              (secretWipe other)
              (shaHex sb)
            }))))))

(:: neg65 (-> Tally String String String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (neg65 t seed ctx msg)
  (let (
    (s (orDie (secretFromString seed) "secretFromString"))
    (other (orDie (secretFromString (flip seed 0 0)) "secretFromString"))
  )
    (let ((k (orDie (mlDsa65KeyFromSeed s) "KeyFromSeed")) (k2 (orDie (mlDsa65KeyFromSeed other) "KeyFromSeed")))
      (let (
        (pk (mlDsa65PublicKey k))
        (sig (orDie (mlDsa65SignDeterministic k msg ctx) "SignDeterministic"))
      )
        (let ((sb (mlDsa65SignatureBytes sig)) (pkb (mlDsa65PublicKeyBytes pk)) (label "ML-DSA-65"))
          (let (
            (ctb (mldsaCtb 65))
            (hintAt (- (strLen sb) (+ (mldsaOmega 65) (mldsaK 65))))
            (bad (lambda (b) (! (mlDsa65Verify pk msg ctx (MlDsa65Signature b)))))
            (refused (lambda (b) (== (codeOf (mlDsa65SignatureFromBytes b)) cryptoInvalidEncoding)))
          )
            {
              (tallyCheck t (mlDsa65Verify pk msg ctx sig) (strConcat label ": the signature verifies"))
              (tallyCheck t (! (mlDsa65Verify pk msg (strConcat ctx "x") sig)) (strConcat label ": another context"))
              (tallyCheck t (! (mlDsa65Verify pk (strConcat msg "x") ctx sig)) (strConcat label ": another message"))
              (tallyCheck t (! (mlDsa65Verify (mlDsa65PublicKey k2) msg ctx sig)) (strConcat label ": another key"))
              ; every region: c~, z, the hint positions, the hint counts
              (tallyCheck t (bad (flip sb 0 0)) (strConcat label ": c~ first bit"))
              (tallyCheck t (bad (flip sb (- ctb 1) 7)) (strConcat label ": c~ last bit"))
              (tallyCheck t (bad (flip sb ctb 0)) (strConcat label ": z first bit"))
              (tallyCheck t (bad (flip sb (/ (+ ctb hintAt) 2) 3)) (strConcat label ": z middle bit"))
              (tallyCheck t (bad (flip sb (- hintAt 1) 5)) (strConcat label ": z last byte"))
              (tallyCheck t (bad (flip sb hintAt 0)) (strConcat label ": a hint position"))
              (tallyCheck t (bad (flip sb (- (strLen sb) 1) 0)) (strConcat label ": the last hint count"))
              ; malformed hint encodings, refused by the decoder and by verification
              (let ((over (setByte sb (+ hintAt (mldsaOmega 65)) (+ (mldsaOmega 65) 1))))
                {
                  (tallyCheck t (refused over) (strConcat label ": a count past omega is refused"))
                  (tallyCheck t (bad over) (strConcat label ": and does not verify"))
                })
              (let ((down (setByte (setByte sb (+ hintAt (mldsaOmega 65)) 2) (+ hintAt (+ (mldsaOmega 65) 1)) 1)))
                {
                  (tallyCheck t (refused down) (strConcat label ": a count that goes down is refused"))
                  (tallyCheck t (bad down) (strConcat label ": and does not verify"))
                })
              (let ((order (setByte (setByte (setAllCounts (zeroHints sb hintAt (mldsaOmega 65) (mldsaK 65)) hintAt (mldsaOmega 65) (mldsaK 65) 2) hintAt 9) (+ hintAt 1) 9)))
                {
                  (tallyCheck t (refused order) (strConcat label ": a repeated position is refused"))
                  (tallyCheck t (bad order) (strConcat label ": and does not verify"))
                })
              (let ((pad (setByte (zeroHints sb hintAt (mldsaOmega 65) (mldsaK 65)) (+ hintAt (- (mldsaOmega 65) 1)) 1)))
                {
                  (tallyCheck t (refused pad) (strConcat label ": nonzero padding is refused"))
                  (tallyCheck t (bad pad) (strConcat label ": and does not verify"))
                })
              ; lengths
              (tallyCheck t (== (codeOf (mlDsa65SignatureFromBytes (strSlice sb 0 (- (strLen sb) 1)))) cryptoInvalidLength) (strConcat label ": a short signature is refused"))
              (tallyCheck t (bad (strSlice sb 0 (- (strLen sb) 1))) (strConcat label ": and does not verify"))
              (tallyCheck t (bad (strConcat sb "x")) (strConcat label ": a long signature does not verify"))
              (tallyCheck t (== (codeOf (mlDsa65PublicKeyFromBytes (strConcat pkb "x"))) cryptoInvalidLength) (strConcat label ": a long public key is refused"))
              (tallyCheck t (! (mlDsa65Verify (MlDsa65PublicKey (strSlice pkb 0 (- (strLen pkb) 1))) msg ctx sig)) (strConcat label ": a short public key does not verify"))
              ; contexts
              (let ((c255 (bytesNew 255)) (c256 (bytesNew 256)))
                {
                  (tallyCheck t (mlDsa65Verify pk msg c255 (orDie (mlDsa65SignDeterministic k msg c255) "sign")) (strConcat label ": a 255-byte context"))
                  (tallyCheck t (== (codeOf (mlDsa65SignDeterministic k msg c256)) cryptoInvalidLength) (strConcat label ": a 256-byte context is refused"))
                  (tallyCheck t (== (codeOf (mlDsa65Sign k msg c256)) cryptoInvalidLength) (strConcat label ": by hedged signing too"))
                  (tallyCheck t (! (mlDsa65Verify pk msg c256 sig)) (strConcat label ": and verification says false"))
                })
              ; hedged signatures differ and verify
              (let ((h1 (orDie (mlDsa65Sign k msg ctx) "Sign")) (h2 (orDie (mlDsa65Sign k msg ctx) "Sign")))
                {
                  (tallyCheck t (&& (mlDsa65Verify pk msg ctx h1) (mlDsa65Verify pk msg ctx h2)) (strConcat label ": hedged signatures verify"))
                  (tallyCheck t (! (strEq (mlDsa65SignatureBytes h1) (mlDsa65SignatureBytes h2))) (strConcat label ": and differ"))
                })
              ; the internal interfaces agree with the external one
              (let ((mprime (pureMPrime ctx msg)))
                (let ((mu (shake256 (strConcat (shake256 pkb 64) mprime) 64)))
                  {
                    (tallyCheck t (strEq sb (mlDsa65SignatureBytes (orDie (mlDsa65SignInternal k mprime (bytesNew 32)) "SignInternal"))) (strConcat label ": Sign_internal on M' agrees"))
                    (tallyCheck t (strEq sb (mlDsa65SignatureBytes (orDie (mlDsa65SignExternalMu k mu (bytesNew 32)) "SignExternalMu"))) (strConcat label ": Sign_internal from mu agrees"))
                    (tallyCheck t (&& (mlDsa65VerifyInternal pk mprime sig) (mlDsa65VerifyExternalMu pk mu sig)) (strConcat label ": both internal verifications accept"))
                    (tallyCheck t (== (codeOf (mlDsa65SignInternal k mprime (bytesNew 31))) cryptoInvalidLength) (strConcat label ": a 31-byte rnd is refused"))
                    (tallyCheck t (== (codeOf (mlDsa65SignExternalMu k (strSlice mu 0 63) (bytesNew 32))) cryptoInvalidLength) (strConcat label ": a 63-byte mu is refused"))
                    (tallyCheck t (! (mlDsa65VerifyExternalMu pk (strSlice mu 0 63) sig)) (strConcat label ": and does not verify"))
                  }))
              ; keys
              (let ((short (orDie (secretFromString (bytesNew 31)) "secretFromString")) (sk (orDie (mlDsa65KeyExport k) "KeyExport")))
                (let ((skb (secretExposeCopy sk)))
                  {
                    (tallyCheck t (== (codeOf (mlDsa65KeyFromSeed short)) cryptoInvalidLength) (strConcat label ": a 31-byte seed is refused"))
                    (tallyCheck t (== (codeOf (mlDsa65KeyFromSecret short)) cryptoInvalidLength) (strConcat label ": a short private key is refused"))
                    (tallyCheck t (== (codeOf (keyFrom65 (flip skb 64 0))) cryptoInvalidKey) (strConcat label ": a private key with the wrong tr is refused"))
                    (tallyCheck t (== (codeOf (keyFrom65 (flip skb (- (strLen skb) 1) 0))) cryptoInvalidKey) (strConcat label ": a private key with the wrong t0 is refused"))
                    (tallyCheck t (== (codeOf (keyFrom65 (setByte skb 128 255))) cryptoInvalidKey) (strConcat label ": s1 out of range is refused"))
                    (secretWipe short)
                    (secretWipe sk)
                  }))
              (mlDsa65KeyWipe k)
              (mlDsa65KeyWipe k2)
              (secretWipe s)
              (secretWipe other)
              (shaHex sb)
            }))))))

(:: neg87 (-> Tally String String String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (neg87 t seed ctx msg)
  (let (
    (s (orDie (secretFromString seed) "secretFromString"))
    (other (orDie (secretFromString (flip seed 0 0)) "secretFromString"))
  )
    (let ((k (orDie (mlDsa87KeyFromSeed s) "KeyFromSeed")) (k2 (orDie (mlDsa87KeyFromSeed other) "KeyFromSeed")))
      (let (
        (pk (mlDsa87PublicKey k))
        (sig (orDie (mlDsa87SignDeterministic k msg ctx) "SignDeterministic"))
      )
        (let ((sb (mlDsa87SignatureBytes sig)) (pkb (mlDsa87PublicKeyBytes pk)) (label "ML-DSA-87"))
          (let (
            (ctb (mldsaCtb 87))
            (hintAt (- (strLen sb) (+ (mldsaOmega 87) (mldsaK 87))))
            (bad (lambda (b) (! (mlDsa87Verify pk msg ctx (MlDsa87Signature b)))))
            (refused (lambda (b) (== (codeOf (mlDsa87SignatureFromBytes b)) cryptoInvalidEncoding)))
          )
            {
              (tallyCheck t (mlDsa87Verify pk msg ctx sig) (strConcat label ": the signature verifies"))
              (tallyCheck t (! (mlDsa87Verify pk msg (strConcat ctx "x") sig)) (strConcat label ": another context"))
              (tallyCheck t (! (mlDsa87Verify pk (strConcat msg "x") ctx sig)) (strConcat label ": another message"))
              (tallyCheck t (! (mlDsa87Verify (mlDsa87PublicKey k2) msg ctx sig)) (strConcat label ": another key"))
              ; every region: c~, z, the hint positions, the hint counts
              (tallyCheck t (bad (flip sb 0 0)) (strConcat label ": c~ first bit"))
              (tallyCheck t (bad (flip sb (- ctb 1) 7)) (strConcat label ": c~ last bit"))
              (tallyCheck t (bad (flip sb ctb 0)) (strConcat label ": z first bit"))
              (tallyCheck t (bad (flip sb (/ (+ ctb hintAt) 2) 3)) (strConcat label ": z middle bit"))
              (tallyCheck t (bad (flip sb (- hintAt 1) 5)) (strConcat label ": z last byte"))
              (tallyCheck t (bad (flip sb hintAt 0)) (strConcat label ": a hint position"))
              (tallyCheck t (bad (flip sb (- (strLen sb) 1) 0)) (strConcat label ": the last hint count"))
              ; malformed hint encodings, refused by the decoder and by verification
              (let ((over (setByte sb (+ hintAt (mldsaOmega 87)) (+ (mldsaOmega 87) 1))))
                {
                  (tallyCheck t (refused over) (strConcat label ": a count past omega is refused"))
                  (tallyCheck t (bad over) (strConcat label ": and does not verify"))
                })
              (let ((down (setByte (setByte sb (+ hintAt (mldsaOmega 87)) 2) (+ hintAt (+ (mldsaOmega 87) 1)) 1)))
                {
                  (tallyCheck t (refused down) (strConcat label ": a count that goes down is refused"))
                  (tallyCheck t (bad down) (strConcat label ": and does not verify"))
                })
              (let ((order (setByte (setByte (setAllCounts (zeroHints sb hintAt (mldsaOmega 87) (mldsaK 87)) hintAt (mldsaOmega 87) (mldsaK 87) 2) hintAt 9) (+ hintAt 1) 9)))
                {
                  (tallyCheck t (refused order) (strConcat label ": a repeated position is refused"))
                  (tallyCheck t (bad order) (strConcat label ": and does not verify"))
                })
              (let ((pad (setByte (zeroHints sb hintAt (mldsaOmega 87) (mldsaK 87)) (+ hintAt (- (mldsaOmega 87) 1)) 1)))
                {
                  (tallyCheck t (refused pad) (strConcat label ": nonzero padding is refused"))
                  (tallyCheck t (bad pad) (strConcat label ": and does not verify"))
                })
              ; lengths
              (tallyCheck t (== (codeOf (mlDsa87SignatureFromBytes (strSlice sb 0 (- (strLen sb) 1)))) cryptoInvalidLength) (strConcat label ": a short signature is refused"))
              (tallyCheck t (bad (strSlice sb 0 (- (strLen sb) 1))) (strConcat label ": and does not verify"))
              (tallyCheck t (bad (strConcat sb "x")) (strConcat label ": a long signature does not verify"))
              (tallyCheck t (== (codeOf (mlDsa87PublicKeyFromBytes (strConcat pkb "x"))) cryptoInvalidLength) (strConcat label ": a long public key is refused"))
              (tallyCheck t (! (mlDsa87Verify (MlDsa87PublicKey (strSlice pkb 0 (- (strLen pkb) 1))) msg ctx sig)) (strConcat label ": a short public key does not verify"))
              ; contexts
              (let ((c255 (bytesNew 255)) (c256 (bytesNew 256)))
                {
                  (tallyCheck t (mlDsa87Verify pk msg c255 (orDie (mlDsa87SignDeterministic k msg c255) "sign")) (strConcat label ": a 255-byte context"))
                  (tallyCheck t (== (codeOf (mlDsa87SignDeterministic k msg c256)) cryptoInvalidLength) (strConcat label ": a 256-byte context is refused"))
                  (tallyCheck t (== (codeOf (mlDsa87Sign k msg c256)) cryptoInvalidLength) (strConcat label ": by hedged signing too"))
                  (tallyCheck t (! (mlDsa87Verify pk msg c256 sig)) (strConcat label ": and verification says false"))
                })
              ; hedged signatures differ and verify
              (let ((h1 (orDie (mlDsa87Sign k msg ctx) "Sign")) (h2 (orDie (mlDsa87Sign k msg ctx) "Sign")))
                {
                  (tallyCheck t (&& (mlDsa87Verify pk msg ctx h1) (mlDsa87Verify pk msg ctx h2)) (strConcat label ": hedged signatures verify"))
                  (tallyCheck t (! (strEq (mlDsa87SignatureBytes h1) (mlDsa87SignatureBytes h2))) (strConcat label ": and differ"))
                })
              ; the internal interfaces agree with the external one
              (let ((mprime (pureMPrime ctx msg)))
                (let ((mu (shake256 (strConcat (shake256 pkb 64) mprime) 64)))
                  {
                    (tallyCheck t (strEq sb (mlDsa87SignatureBytes (orDie (mlDsa87SignInternal k mprime (bytesNew 32)) "SignInternal"))) (strConcat label ": Sign_internal on M' agrees"))
                    (tallyCheck t (strEq sb (mlDsa87SignatureBytes (orDie (mlDsa87SignExternalMu k mu (bytesNew 32)) "SignExternalMu"))) (strConcat label ": Sign_internal from mu agrees"))
                    (tallyCheck t (&& (mlDsa87VerifyInternal pk mprime sig) (mlDsa87VerifyExternalMu pk mu sig)) (strConcat label ": both internal verifications accept"))
                    (tallyCheck t (== (codeOf (mlDsa87SignInternal k mprime (bytesNew 31))) cryptoInvalidLength) (strConcat label ": a 31-byte rnd is refused"))
                    (tallyCheck t (== (codeOf (mlDsa87SignExternalMu k (strSlice mu 0 63) (bytesNew 32))) cryptoInvalidLength) (strConcat label ": a 63-byte mu is refused"))
                    (tallyCheck t (! (mlDsa87VerifyExternalMu pk (strSlice mu 0 63) sig)) (strConcat label ": and does not verify"))
                  }))
              ; keys
              (let ((short (orDie (secretFromString (bytesNew 31)) "secretFromString")) (sk (orDie (mlDsa87KeyExport k) "KeyExport")))
                (let ((skb (secretExposeCopy sk)))
                  {
                    (tallyCheck t (== (codeOf (mlDsa87KeyFromSeed short)) cryptoInvalidLength) (strConcat label ": a 31-byte seed is refused"))
                    (tallyCheck t (== (codeOf (mlDsa87KeyFromSecret short)) cryptoInvalidLength) (strConcat label ": a short private key is refused"))
                    (tallyCheck t (== (codeOf (keyFrom87 (flip skb 64 0))) cryptoInvalidKey) (strConcat label ": a private key with the wrong tr is refused"))
                    (tallyCheck t (== (codeOf (keyFrom87 (flip skb (- (strLen skb) 1) 0))) cryptoInvalidKey) (strConcat label ": a private key with the wrong t0 is refused"))
                    (tallyCheck t (== (codeOf (keyFrom87 (setByte skb 128 255))) cryptoInvalidKey) (strConcat label ": s1 out of range is refused"))
                    (secretWipe short)
                    (secretWipe sk)
                  }))
              (mlDsa87KeyWipe k)
              (mlDsa87KeyWipe k2)
              (secretWipe s)
              (secretWipe other)
              (shaHex sb)
            }))))))

; neg for parameter set `n`.
(:: neg (-> Int Tally String String String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (neg n t seed ctx msg)
  (if (== n 44) (neg44 t seed ctx msg) (== n 65) (neg65 t seed ctx msg) (neg87 t seed ctx msg)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "mldsa-negative")) (kat (tallyNew "mldsa-negative-base")) (mut seen 0))
    {
      (for line in (katLines "mldsa-openssl.txt")
        (let ((f (katFields line)))
          (let ((n (katInt f 1)))
            (if (&& (strEq (katText f 0) "sign") (&& (strEq (katText f 5) "-") (== (& seen (bitFor n)) 0)))
              (let ((got (neg n t (katBytes f 2) (katBytes f 3) (katBytes f 4))))
                {
                  (set seen (| seen (bitFor n)))
                  (tallyCheck kat (strEq got (katText f 8)) (strConcat "ML-DSA-" (strConcat (katText f 1) ": the deterministic signature matches OpenSSL's")))
                })
              0))))
      (tallyCheck kat (== seen 7) "a base case for every parameter set")
      (+ (tallyReport kat) (tallyReport t))
    }))

(:: bitFor (-> Int Int))
(fn (bitFor n)
  (if (== n 44) 1 (== n 65) 2 4))
