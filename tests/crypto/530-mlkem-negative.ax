; ML-KEM (FIPS 203) refusing and rejecting: a corrupted ciphertext
; decapsulates to the implicit-rejection secret J(z || c), which the
; vector file computes independently with Python's hashlib (and checks
; against OpenSSL), while the genuine ciphertext still answers the real
; secret; encapsulation keys of the wrong length or not reduced modulo
; q, ciphertexts, seeds and messages of the wrong length, and expanded
; keys with a corrupted hash or ek are refused with their own errors;
; and a key used after it is wiped, or handed to another parameter
; set's operation through a cast, stops the program with status 85
; (checked in a child process).
(import IO)
(import Str)
(import Vec)
(import Err)
(import Mem)
(import Sys)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.MlKem)
(import Kat)

;; ---- adapter: the three parameter sets behind one interface ----
; Every answer is bytes; a refusal keeps its error. `set` is "512",
; "768" or "1024".
(struct Keys
  (ek : String)
  (dk : String)
  (seed : String))

; A secret holding `b`; the vector file is wrong if this fails.
(:: secretOf (-> String SecretBytes))
;@axiom:effect(io)
(fn (secretOf b)
  (match (secretFromString b)
    ((Ok s) s)
    ((Err _)
      {
        (die "the secret store refused a test key" 3)
        (secretOf b)
      })))

; The bytes of an exported secret, which is then wiped; "" on a
; refusal.
(:: exposed (-> (Result SecretBytes Error) String))
;@axiom:effect(io)
(fn (exposed r)
  (match r
    ((Err _) "")
    ((Ok s)
      (let ((b (secretExposeCopy s)))
        {
          (secretWipe s)
          b
        }))))

; A secret's bytes, and the secret wiped.
(:: taken (-> SecretBytes String))
;@axiom:effect(io)
(fn (taken s)
  (let ((b (secretExposeCopy s)))
    {
      (secretWipe s)
      b
    }))

(:: keysOf512 (-> (Result MlKem512DecapsKey Error) (Result Keys Error)))
;@axiom:effect(io)
(fn (keysOf512 r)
  (match r
    ((Err e) (Err e))
    ((Ok dk)
      (let (
        (out (Keys (mlKem512EncapsKeyBytes (mlKem512EncapsKey dk))
          (exposed (mlKem512KeyExportExpanded dk))
          (exposed (mlKem512KeyExportSeed dk))))
      )
        {
          (mlKem512KeyWipe dk)
          (Ok out)
        }))))

(:: encaps512 (-> String String (Result String Error)))
;@axiom:effect(io)
(fn (encaps512 ek m)
  (let ((ms (secretOf m)))
    (let ((r (mlKem512EncapsDerand (MlKem512EncapsKey ek) ms)))
      {
        (secretWipe ms)
        (match r
          ((Err e) (Err e))
          ((Ok x)
            (let ((c x.ciphertext))
              (Ok (strConcat (mlKem512CiphertextBytes c) (taken x.secret))))))
      })))

(:: decaps512 (-> (Result MlKem512DecapsKey Error) String (Result String Error)))
;@axiom:effect(io)
(fn (decaps512 r c)
  (match r
    ((Err e) (Err e))
    ((Ok dk)
      (let ((k (mlKem512Decaps dk (MlKem512Ciphertext c))))
        {
          (mlKem512KeyWipe dk)
          (match k
            ((Err e) (Err e))
            ((Ok s) (Ok (taken s))))
        }))))

(:: ekCheck512 (-> String (Result String Error)))
(fn (ekCheck512 ek)
  (mapOk (mlKem512EncapsKeyFromBytes ek) mlKem512EncapsKeyBytes))

(:: keysOf768 (-> (Result MlKem768DecapsKey Error) (Result Keys Error)))
;@axiom:effect(io)
(fn (keysOf768 r)
  (match r
    ((Err e) (Err e))
    ((Ok dk)
      (let (
        (out (Keys (mlKem768EncapsKeyBytes (mlKem768EncapsKey dk))
          (exposed (mlKem768KeyExportExpanded dk))
          (exposed (mlKem768KeyExportSeed dk))))
      )
        {
          (mlKem768KeyWipe dk)
          (Ok out)
        }))))

(:: encaps768 (-> String String (Result String Error)))
;@axiom:effect(io)
(fn (encaps768 ek m)
  (let ((ms (secretOf m)))
    (let ((r (mlKem768EncapsDerand (MlKem768EncapsKey ek) ms)))
      {
        (secretWipe ms)
        (match r
          ((Err e) (Err e))
          ((Ok x)
            (let ((c x.ciphertext))
              (Ok (strConcat (mlKem768CiphertextBytes c) (taken x.secret))))))
      })))

(:: decaps768 (-> (Result MlKem768DecapsKey Error) String (Result String Error)))
;@axiom:effect(io)
(fn (decaps768 r c)
  (match r
    ((Err e) (Err e))
    ((Ok dk)
      (let ((k (mlKem768Decaps dk (MlKem768Ciphertext c))))
        {
          (mlKem768KeyWipe dk)
          (match k
            ((Err e) (Err e))
            ((Ok s) (Ok (taken s))))
        }))))

(:: ekCheck768 (-> String (Result String Error)))
(fn (ekCheck768 ek)
  (mapOk (mlKem768EncapsKeyFromBytes ek) mlKem768EncapsKeyBytes))

(:: keysOf1024 (-> (Result MlKem1024DecapsKey Error) (Result Keys Error)))
;@axiom:effect(io)
(fn (keysOf1024 r)
  (match r
    ((Err e) (Err e))
    ((Ok dk)
      (let (
        (out (Keys (mlKem1024EncapsKeyBytes (mlKem1024EncapsKey dk))
          (exposed (mlKem1024KeyExportExpanded dk))
          (exposed (mlKem1024KeyExportSeed dk))))
      )
        {
          (mlKem1024KeyWipe dk)
          (Ok out)
        }))))

(:: encaps1024 (-> String String (Result String Error)))
;@axiom:effect(io)
(fn (encaps1024 ek m)
  (let ((ms (secretOf m)))
    (let ((r (mlKem1024EncapsDerand (MlKem1024EncapsKey ek) ms)))
      {
        (secretWipe ms)
        (match r
          ((Err e) (Err e))
          ((Ok x)
            (let ((c x.ciphertext))
              (Ok (strConcat (mlKem1024CiphertextBytes c) (taken x.secret))))))
      })))

(:: decaps1024 (-> (Result MlKem1024DecapsKey Error) String (Result String Error)))
;@axiom:effect(io)
(fn (decaps1024 r c)
  (match r
    ((Err e) (Err e))
    ((Ok dk)
      (let ((k (mlKem1024Decaps dk (MlKem1024Ciphertext c))))
        {
          (mlKem1024KeyWipe dk)
          (match k
            ((Err e) (Err e))
            ((Ok s) (Ok (taken s))))
        }))))

(:: ekCheck1024 (-> String (Result String Error)))
(fn (ekCheck1024 ek)
  (mapOk (mlKem1024EncapsKeyFromBytes ek) mlKem1024EncapsKeyBytes))

; KeyGen_internal(d, z).
(:: keyGen (-> String String String (Result Keys Error)))
;@axiom:effect(io)
(fn (keyGen set d z)
  (let ((ds (secretOf d)) (zs (secretOf z)))
    (let ((r
      (if (strEq set "512")
        (keysOf512 (mlKem512KeyGenerateDerand ds zs))
        (if (strEq set "768")
          (keysOf768 (mlKem768KeyGenerateDerand ds zs))
          (keysOf1024 (mlKem1024KeyGenerateDerand ds zs))))))
      {
        (secretWipe ds)
        (secretWipe zs)
        r
      })))

; A key from its 64-byte seed.
(:: keyFromSeed (-> String String (Result Keys Error)))
;@axiom:effect(io)
(fn (keyFromSeed set seed)
  (let ((s (secretOf seed)))
    (let ((r
      (if (strEq set "512")
        (keysOf512 (mlKem512KeyFromSeed s))
        (if (strEq set "768")
          (keysOf768 (mlKem768KeyFromSeed s))
          (keysOf1024 (mlKem1024KeyFromSeed s))))))
      {
        (secretWipe s)
        r
      })))

; A key from the expanded form, after the checks of section 7.3.
(:: keyFromExpanded (-> String String (Result Keys Error)))
;@axiom:effect(io)
(fn (keyFromExpanded set dk)
  (let ((s (secretOf dk)))
    (let ((r
      (if (strEq set "512")
        (keysOf512 (mlKem512KeyFromExpanded s))
        (if (strEq set "768")
          (keysOf768 (mlKem768KeyFromExpanded s))
          (keysOf1024 (mlKem1024KeyFromExpanded s))))))
      {
        (secretWipe s)
        r
      })))

; Encaps_internal(ek, m): c || K.
(:: encaps (-> String String String (Result String Error)))
;@axiom:effect(io)
(fn (encaps set ek m)
  (if (strEq set "512")
    (encaps512 ek m)
    (if (strEq set "768")
      (encaps768 ek m)
      (encaps1024 ek m))))

; Decaps with a key made from `seed` (64 bytes) or, when `expanded`,
; imported from the expanded `key`.
(:: decaps (-> String Bool String String (Result String Error)))
;@axiom:effect(io)
(fn (decaps set expanded key c)
  (let ((s (secretOf key)))
    (let ((r
      (if (strEq set "512")
        (decaps512 (if expanded (mlKem512KeyFromExpanded s) (mlKem512KeyFromSeed s)) c)
        (if (strEq set "768")
          (decaps768 (if expanded (mlKem768KeyFromExpanded s) (mlKem768KeyFromSeed s)) c)
          (decaps1024 (if expanded (mlKem1024KeyFromExpanded s) (mlKem1024KeyFromSeed s)) c)))))
      {
        (secretWipe s)
        r
      })))

; The encapsulation-key checks of section 7.2.
(:: ekCheck (-> String String (Result String Error)))
(fn (ekCheck set ek)
  (if (strEq set "512")
    (ekCheck512 ek)
    (if (strEq set "768")
      (ekCheck768 ek)
      (ekCheck1024 ek))))

(:: answers (-> (Result String Error) String Bool))
(fn (answers r want)
  (match r
    ((Ok got) (strEq got want))
    ((Err _) false)))

(:: refusedWith (-> (Result a Error) Int Bool))
(fn (refusedWith r code)
  (match r
    ((Ok _) false)
    ((Err e) (== (errCode e) code))))
;; ---- end of adapter ----

; `s` with byte `i` replaced by `v`.
(:: withByte (-> String Int Int String))
;@axiom:effect(unsafe)
(fn (withByte s i v)
  (let ((c (bytesFromAddr (strData s) (strLen s))))
    {
      (__store8 (strData c) i v)
      c
    }))

; A fixed ML-KEM-768 key for the refusal checks.
(:: key768 (Result MlKem768DecapsKey Error))
;@axiom:effect(io)
(fn (key768)
  (let ((s (secretOf (bytesNew 64))))
    (let ((r (mlKem768KeyFromSeed s)))
      {
        (secretWipe s)
        r
      })))

(:: refusals (-> Tally Int))
;@axiom:effect(io)
(fn (refusals t)
  (match (key768)
    ((Err _) (tallyCheck t false "key from a zero seed"))
    ((Ok dk)
      (let ((ek (mlKem768EncapsKeyBytes (mlKem768EncapsKey dk))))
        {
          ; section 7.2: length, then the modulus check
          (tallyCheck t (refusedWith (mlKem768EncapsKeyFromBytes (strSlice ek 0 1183)) cryptoInvalidLength) "ek one byte short")
          (tallyCheck t (refusedWith (mlKem768EncapsKeyFromBytes (strConcat ek "\0")) cryptoInvalidLength) "ek one byte long")
          (tallyCheck t (refusedWith (mlKem512EncapsKeyFromBytes ek) cryptoInvalidLength) "a 768 key offered as 512")
          ; the first 12-bit value is bytes 0 and the low half of byte 1
          (let ((q (withByte (withByte ek 0 1) 1 (| (& (strByte ek 1) 240) 13))))
            (tallyCheck t (refusedWith (mlKem768EncapsKeyFromBytes q) cryptoInvalidKey) "a coefficient equal to q"))
          (let ((top (withByte (withByte ek 0 255) 1 (| (& (strByte ek 1) 240) 15))))
            (tallyCheck t (refusedWith (mlKem768EncapsKeyFromBytes top) cryptoInvalidKey) "a coefficient of 4095"))
          (let ((q1 (withByte (withByte ek 0 0) 1 (| (& (strByte ek 1) 240) 13))))
            (tallyCheck t (isOk (mlKem768EncapsKeyFromBytes q1)) "a coefficient of q - 1 = 3328 is accepted"))
          ; the last 12-bit value of t-hat: the high nibble of byte 1150 and byte 1151
          (let ((last (withByte (withByte ek 1151 255) 1150 (| (strByte ek 1150) 240))))
            (tallyCheck t (refusedWith (mlKem768EncapsKeyFromBytes last) cryptoInvalidKey) "the last coefficient out of range"))
          ; a forged struct is checked again at encapsulation
          (tallyCheck t (refusedWith (mlKem768Encaps (MlKem768EncapsKey (withByte (withByte ek 0 255) 1 255))) cryptoInvalidKey) "encapsulation re-checks the modulus")
          (tallyCheck t (refusedWith (mlKem768Encaps (MlKem768EncapsKey "short")) cryptoInvalidLength) "encapsulation re-checks the length")
          ; ciphertexts, seeds, m
          (tallyCheck t (refusedWith (mlKem768CiphertextFromBytes (bytesNew 1087)) cryptoInvalidLength) "a short ciphertext")
          (tallyCheck t (refusedWith (mlKem768CiphertextFromBytes (bytesNew 768)) cryptoInvalidLength) "a 512 ciphertext offered as 768")
          (tallyCheck t (refusedWith (mlKem768Decaps dk (MlKem768Ciphertext (bytesNew 1089))) cryptoInvalidLength) "decapsulation re-checks the length")
          (tallyCheck t (isOk (mlKem768Decaps dk (MlKem768Ciphertext (bytesNew 1088)))) "any 1088 bytes decapsulate")
          (let ((s63 (secretOf (bytesNew 63))) (s31 (secretOf (bytesNew 31))) (s32 (secretOf (bytesNew 32))))
            {
              (tallyCheck t (refusedWith (mlKem768KeyFromSeed s63) cryptoInvalidLength) "a 63-byte seed")
              (tallyCheck t (refusedWith (mlKem768KeyGenerateDerand s31 s32) cryptoInvalidLength) "a 31-byte d")
              (tallyCheck t (refusedWith (mlKem768KeyGenerateDerand s32 s31) cryptoInvalidLength) "a 31-byte z")
              (tallyCheck t (refusedWith (mlKem768EncapsDerand (mlKem768EncapsKey dk) s31) cryptoInvalidLength) "a 31-byte m")
              (secretWipe s63)
              (secretWipe s31)
              (secretWipe s32)
            })
          ; section 7.3 on import
          (let ((x (exposed (mlKem768KeyExportExpanded dk))))
            {
              (tallyCheck t (isOk (keyFromExpanded "768" x)) "the exported expanded key imports")
              (tallyCheck t (refusedWith (keyFromExpanded "768" (strSlice x 0 2399)) cryptoInvalidLength) "an expanded key one byte short")
              (tallyCheck t (refusedWith (keyFromExpanded "768" (withByte x 2336 (^ (strByte x 2336) 1))) cryptoInvalidKey) "a corrupted H(ek)")
              (tallyCheck t (refusedWith (keyFromExpanded "768" (withByte x 1200 (^ (strByte x 1200) 1))) cryptoInvalidKey) "a corrupted embedded ek")
              (let ((s (secretOf x)))
                {
                  (match (mlKem768KeyFromExpanded s)
                    ((Err _) (tallyCheck t false "import"))
                    ((Ok k2)
                      {
                        (tallyCheck t (refusedWith (mlKem768KeyExportSeed k2) cryptoUnsupported) "an imported expanded key has no seed")
                        (mlKem768KeyWipe k2)
                      }))
                  (secretWipe s)
                })
            })
          (mlKem768KeyWipe dk)
        }))))

; Random key pairs and encapsulations agree with themselves and differ
; from each other.
(:: roundTrips (-> Tally Int))
;@axiom:effect(io)
(fn (roundTrips t)
  (match (mlKem512KeyGenerate)
    ((Err _) (tallyCheck t false "mlKem512KeyGenerate"))
    ((Ok a)
      (match (mlKem1024KeyGenerate)
        ((Err _) (tallyCheck t false "mlKem1024KeyGenerate"))
        ((Ok b)
          (match (mlKem768KeyGenerate)
            ((Err _) (tallyCheck t false "mlKem768KeyGenerate"))
            ((Ok c)
              (match (mlKem768KeyGenerate)
                ((Err _) (tallyCheck t false "a second key"))
                ((Ok d)
                  {
                    (match (mlKem512Encaps (mlKem512EncapsKey a))
                      ((Err _) (tallyCheck t false "mlKem512Encaps"))
                      ((Ok x)
                        (tallyCheck t (secretEqR (mlKem512Decaps a x.ciphertext) x.secret) "512 decapsulates its encapsulation")))
                    (match (mlKem1024Encaps (mlKem1024EncapsKey b))
                      ((Err _) (tallyCheck t false "mlKem1024Encaps"))
                      ((Ok x)
                        (tallyCheck t (secretEqR (mlKem1024Decaps b x.ciphertext) x.secret) "1024 decapsulates its encapsulation")))
                    (match (mlKem768Encaps (mlKem768EncapsKey c))
                      ((Err _) (tallyCheck t false "mlKem768Encaps"))
                      ((Ok x)
                        (match (mlKem768Encaps (mlKem768EncapsKey c))
                          ((Err _) (tallyCheck t false "a second encapsulation"))
                          ((Ok y)
                            {
                              (tallyCheck t (secretEqR (mlKem768Decaps c x.ciphertext) x.secret) "768 decapsulates its encapsulation")
                              (tallyCheck t (! (secretEq x.secret y.secret)) "two encapsulations give different secrets")
                              (tallyCheck t (! (strEq (mlKem768CiphertextBytes x.ciphertext) (mlKem768CiphertextBytes y.ciphertext))) "and different ciphertexts")
                              (tallyCheck t (! (secretEqR (mlKem768Decaps d x.ciphertext) x.secret)) "another key rejects it")
                              (tallyCheck t (! (strEq (mlKem768EncapsKeyBytes (mlKem768EncapsKey c)) (mlKem768EncapsKeyBytes (mlKem768EncapsKey d)))) "two generated keys differ")
                            }))))
                    (let ((shown (format "{c}")))
                      (tallyCheck t (strEq shown "<MlKem768DecapsKey>") "a key prints as its type name"))
                    (mlKem512KeyWipe a)
                    (mlKem1024KeyWipe b)
                    (mlKem768KeyWipe c)
                    (mlKem768KeyWipe d)
                  })))))))))

(:: secretEqR (-> (Result SecretBytes Error) SecretBytes Bool))
(fn (secretEqR r s)
  (match r
    ((Ok x) (secretEq x s))
    ((Err _) false)))

; ------------------------------------------------------------------
; Misuse the runtime stops: run this program again with a third
; argument naming the misuse, and expect status 85.
; ------------------------------------------------------------------
(:: misuse (-> String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (misuse what)
  (if (strEq what "forge-kind")
    (match (mlKem512KeyGenerate)
      ((Err _) 1)
      ((Ok k)
        (let ((forged (cast MlKem768DecapsKey k)))
          {
            (let ((_ (mlKem768Decaps forged (MlKem768Ciphertext (bytesNew 1088)))))
              (println "a 512 key was accepted as a 768 key"))
            0
          })))
    (match (mlKem768KeyGenerate)
      ((Err _) 1)
      ((Ok k)
        {
          (mlKem768KeyWipe k)
          (let ((_ (mlKem768Decaps k (MlKem768Ciphertext (bytesNew 1088)))))
            (println "a wiped key was used"))
          0
        }))))

; The exit status of this program run with `what` as its third
; argument.
(:: childStatus (-> String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (childStatus what)
  (let ((argv (memAlloc 32)) (self (strDup (sysArg 0))) (dir (strDup (katDir))) (arg (strDup what)))
    {
      (__store64 argv 0 (strCStr self))
      (__store64 argv 1 (strCStr dir))
      (__store64 argv 2 (strCStr arg))
      (__store64 argv 3 0)
      (match (sysRunPath self argv 0)
        ((Ok code) code)
        ((Err _) -1))
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (> sysArgc 2)
    (misuse (sysArg 2))
    (let (
      (rej (tallyNew "mlkem-implicit-rejection"))
      (ref (tallyNew "mlkem-refusals"))
      (trip (tallyNew "mlkem-round-trips"))
      (trap (tallyNew "mlkem-misuse-traps"))
    )
      {
        (for line in (katLines "mlkem-reject.txt")
          (let ((f (katFields line)))
            (let (
              (set (katText f 0))
              (seed (katBytes f 1))
              (kind (katText f 2))
              (c (katBytes f 3))
              (k (katBytes f 4))
            )
              (tallyCheck rej (answers (decaps set false seed c) k) (strConcat set (strConcat " " kind))))))
        (refusals ref)
        (roundTrips trip)
        (tallyCheck trap (== (childStatus "forge-kind") 85) "a 512 key cast to a 768 key stops the program with 85")
        (tallyCheck trap (== (childStatus "use-after-wipe") 85) "a wiped key stops the program with 85")
        (+ (+ (tallyReport rej) (tallyReport ref)) (+ (tallyReport trip) (tallyReport trap)))
      })))
