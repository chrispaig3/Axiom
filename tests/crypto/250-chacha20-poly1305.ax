; ChaCha20-Poly1305 (RFC 8439 2.8) through Crypto.ChaCha20Poly1305's
; typed API: the RFC's section 2.8.2 example and its Appendix A.5
; decryption; every Wycheproof test, with nonces other than 12 bytes
; refused rather than run; RustCrypto's chacha20poly1305 on random
; inputs; forgeries of every part of a message; and the key API.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.Aead)
(import Crypto.ChaCha20Poly1305)
(import Kat)

; ------------------------------------------------------------------
; Seal and open with a key and nonce given as bytes. A key that is not
; 32 bytes, or a nonce that is not 12, answers the refusal the API
; gives for it.
; ------------------------------------------------------------------
(:: cp (-> Bool String String String String (Result String Error)))
;@axiom:effect(io)
(fn (cp sealing key nonce aad text)
  (match (aeadNonceFromBytes nonce)
    ((Err e) (Err e))
    ((Ok n)
      (match (secretFromString key)
        ((Err e) (Err e))
        ((Ok s)
          (let ((r 
            (match (chacha20Poly1305KeyFromSecret s)
              ((Err e) (Err e))
              ((Ok k)
                (let ((r 
                  (if sealing
                    (chacha20Poly1305Seal k n aad text)
                    (chacha20Poly1305Open k n aad text))))
                  {
                    (chacha20Poly1305KeyWipe k)
                    r
                  })
              ))))
            {
              (secretWipe s)
              r
            })
        ))
    )))

(:: seal (-> String String String String (Result String Error)))
;@axiom:effect(io)
(fn (seal key nonce aad pt)
  (cp
    true
    key
    nonce
    aad
    pt))

(:: open (-> String String String String (Result String Error)))
;@axiom:effect(io)
(fn (open key nonce aad sealed)
  (cp
    false
    key
    nonce
    aad
    sealed))

; ------------------------------------------------------------------
; Judging answers.
; ------------------------------------------------------------------
(:: answers (-> (Result String Error) String Bool))
(fn (answers r want)
  (match r
    ((Ok got) (strEq got want))
    ((Err _) false)))

(:: refused (-> (Result String Error) Int Bool))
(fn (refused r code)
  (match r
    ((Ok _) false)
    ((Err e) (== (errCode e) code))))

; The one authentication failure: code, message and nothing else.
(:: authFails (-> (Result String Error) Bool))
(fn (authFails r)
  (match r
    ((Ok _) false)
    ((Err e) (&& (== (errCode e) cryptoAuthFailed) (strEq (errMessage e) "authentication failed")))))

; `s` with byte `i` XORed with 1.
(:: flip (-> String Int String))
;@axiom:effect(unsafe)
(fn (flip s i)
  (let ((c (bytesFromAddr (strData s) (strLen s))))
    {
      (__store8 (strData c) i (^ (strByte s i) 1))
      c
    }))

; ------------------------------------------------------------------
; Forgeries: every way to change a sealed message must fail to open,
; with the same error.
; ------------------------------------------------------------------
(:: forgeries (-> Tally String String String String String Int))
;@axiom:effect(io)
(fn (forgeries t key nonce aad pt sealed)
  (let (
    (n (strLen sealed))
    (id (hexEncode nonce))
  )
    {
      (tallyCheck t (answers (open key nonce aad sealed) pt) (strConcat "the genuine message opens " id))
      (tallyCheck t (authFails (open key nonce aad (flip sealed 0))) (strConcat "first byte flipped " id))
      (tallyCheck t (authFails (open key nonce aad (flip sealed (- n 1)))) (strConcat "last tag byte flipped " id))
      (tallyCheck t (authFails (open key nonce aad (flip sealed (- n 16)))) (strConcat "first tag byte flipped " id))
      (if (> n 16)
        (tallyCheck t (authFails (open key nonce aad (flip sealed (- n 17)))) (strConcat "last ciphertext byte flipped " id))
        0)
      (tallyCheck t (authFails (open key nonce aad (strSlice sealed 0 (- n 1)))) (strConcat "truncated " id))
      (tallyCheck t (authFails (open key nonce aad (strConcat sealed "\0"))) (strConcat "extended " id))
      (tallyCheck t (authFails (open key nonce aad (strSlice sealed 0 15))) (strConcat "15 bytes " id))
      (tallyCheck t (authFails (open key nonce aad "")) (strConcat "empty " id))
      (tallyCheck t (authFails (open key nonce (strConcat aad "x") sealed)) (strConcat "aad extended " id))
      (if (> (strLen aad) 0)
        {
          (tallyCheck t (authFails (open key nonce (flip aad 0) sealed)) (strConcat "aad flipped " id))
          (tallyCheck t (authFails (open key nonce "" sealed)) (strConcat "aad dropped " id))
        }
        0)
      (tallyCheck t (authFails (open key (flip nonce 0) aad sealed)) (strConcat "nonce flipped " id))
      (tallyCheck t (authFails (open key (flip nonce 11) aad sealed)) (strConcat "nonce last byte flipped " id))
      (tallyCheck t (authFails (open (flip key 0) nonce aad sealed)) (strConcat "wrong key " id))
    }))

; ------------------------------------------------------------------
; The key API.
; ------------------------------------------------------------------
(:: keyLengthRefused (-> Int Bool))
;@axiom:effect(io)
(fn (keyLengthRefused n)
  (match (secretFromString (bytesNew n))
    ((Err _) false)
    ((Ok s)
      (let ((a 
        (match (chacha20Poly1305KeyFromSecret s)
          ((Ok k)
            {
              (chacha20Poly1305KeyWipe k)
              false
            }
          )
          ((Err e) (== (errCode e) cryptoInvalidLength)))))
        {
          (secretWipe s)
          a
        })
    )))

(:: apiChecks (-> Tally Int))
;@axiom:effect(io)
(fn (apiChecks t)
  (let ((nonce (unwrapOr (aeadNonceFromBytes "0123456789ab") (AeadNonce ""))))
    {
      (for n in (vecOf6
        0
        16
        24
        31
        33
        64)
        (tallyCheck t (keyLengthRefused n) "a key of the wrong length is refused"))
      (match (chacha20Poly1305KeyGenerate)
        ((Err _) (tallyCheck t false "chacha20Poly1305KeyGenerate"))
        ((Ok k)
          (let ((sealed (chacha20Poly1305Seal k nonce "hdr" "attack at dawn")))
            {
              (tallyCheck t (== (strLen (unwrapOr sealed "")) 30) "a seal is the plaintext plus 16 bytes")
              (tallyCheck t (answers (chacha20Poly1305Open k nonce "hdr" (unwrapOr sealed "")) "attack at dawn") "a generated key opens its own seal")
              (tallyCheck t (refused (chacha20Poly1305Seal k (AeadNonce "short") "" "x") cryptoInvalidLength) "a forged short nonce is refused by seal")
              (tallyCheck t (authFails (chacha20Poly1305Open k (AeadNonce "short") "hdr" (unwrapOr sealed ""))) "a forged short nonce fails open")
              (tallyCheck t (answers (chacha20Poly1305Open k nonce "" (unwrapOr (chacha20Poly1305Seal k nonce "" "") "")) "") "an empty message round-trips")
              (let ((shown (format "{k}")))
                (tallyCheck t (strEq shown "<ChaCha20Poly1305Key>") "a key prints as its type name"))
              (match (chacha20Poly1305KeyExport k)
                ((Err _) (tallyCheck t false "chacha20Poly1305KeyExport"))
                ((Ok s)
                  (match (chacha20Poly1305KeyFromSecret s)
                    ((Err _) (tallyCheck t false "re-import"))
                    ((Ok k2)
                      {
                        (tallyCheck t (answers (chacha20Poly1305Open k2 nonce "hdr" (unwrapOr sealed "")) "attack at dawn") "an exported key opens what the original sealed")
                        (chacha20Poly1305KeyWipe k2)
                        (secretWipe s)
                      }
                    ))
                ))
              (match (chacha20Poly1305KeyGenerate)
                ((Err _) (tallyCheck t false "a second key"))
                ((Ok k3)
                  {
                    (tallyCheck t (authFails (chacha20Poly1305Open k3 nonce "hdr" (unwrapOr sealed ""))) "a second generated key does not open it")
                    (chacha20Poly1305KeyWipe k3)
                  }
                ))
              (chacha20Poly1305KeyWipe k)
            })
        ))
    }))

(:: vecOf6 (-> Int Int Int Int Int Int (Vec Int)))
(fn (vecOf6 a b c d e f)
  (let ((v vecNew))
    {
      (vecPush v a)
      (vecPush v b)
      (vecPush v c)
      (vecPush v d)
      (vecPush v e)
      (vecPush v f)
      v
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (rfc (tallyNew "chacha20-poly1305-rfc8439"))
    (wp (tallyNew "wycheproof-chacha20-poly1305"))
    (wpr (tallyNew "wycheproof-chacha20-poly1305-refused"))
    (diff (tallyNew "chacha20-poly1305-rustcrypto"))
    (neg (tallyNew "chacha20-poly1305-forgeries"))
    (api (tallyNew "chacha20-poly1305-keys"))
    (mut forged 0)
  )
    {
      (for line in (katLines "chacha20-poly1305-rfc8439.txt")
        (let ((f (katFields line)))
          (let (
            (id (katText f 0))
            (key (katBytes f 1))
            (nonce (katBytes f 2))
            (aad (katBytes f 3))
            (pt (katBytes f 4))
            (sealed (strConcat (katBytes f 5) (katBytes f 6)))
          )
            {
              (tallyCheck rfc (answers (seal key nonce aad pt) sealed) id)
              (tallyCheck rfc (answers (open key nonce aad sealed) pt) (strConcat "open " id))
              (forgeries
                rfc
                key
                nonce
                aad
                pt
                sealed)
            })))
      (for line in (katLines "wycheproof-chacha20-poly1305.txt")
        (let ((f (katFields line)))
          (let (
            (id (strConcat "tcId " (katText f 0)))
            (valid (strEq (katText f 1) "valid"))
            (key (katBytes f 2))
            (iv (katBytes f 3))
            (aad (katBytes f 4))
            (msg (katBytes f 5))
            (sealed (strConcat (katBytes f 6) (katBytes f 7)))
          )
            (if (!= (strLen iv) 12)
              {
                (tallyCheck wpr (refused (seal key iv aad msg) cryptoInvalidLength) (strConcat "seal refuses " id))
                (tallyCheck wpr (refused (open key iv aad sealed) cryptoInvalidLength) (strConcat "open refuses " id))
              }
              (if valid
                {
                  (tallyCheck wp (answers (seal key iv aad msg) sealed) id)
                  (tallyCheck wp (answers (open key iv aad sealed) msg) (strConcat "open " id))
                }
                (tallyCheck wp (authFails (open key iv aad sealed)) id))))))
      (for line in (katLines "chacha20-poly1305-diff.txt")
        (let ((f (katFields line)))
          (let (
            (key (katBytes f 0))
            (nonce (katBytes f 1))
            (aad (katBytes f 2))
            (pt (katBytes f 3))
            (sealed (strConcat (katBytes f 4) (katBytes f 5)))
          )
            {
              (tallyCheck diff (answers (seal key nonce aad pt) sealed) (hexEncode nonce))
              (tallyCheck diff (answers (open key nonce aad sealed) pt) (strConcat "open " (hexEncode nonce)))
              (if (< forged 40)
                {
                  (forgeries
                    neg
                    key
                    nonce
                    aad
                    pt
                    sealed)
                  (set forged (+ forged 1))
                  0
                }
                0)
            })))
      (apiChecks api)
      (+ (+ (tallyReport rfc) (+ (tallyReport wp) (tallyReport wpr))) (+ (tallyReport diff) (+ (tallyReport neg) (tallyReport api))))
    }))
