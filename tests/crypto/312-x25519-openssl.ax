; X25519 against OpenSSL: seeded private keys, the public keys OpenSSL
; derives for them, and the secrets `openssl pkeyutl -derive` agrees
; with genuine peer keys and with raw seeded u-coordinates (bit 255
; set in about half of them).
(import IO)
(import Str)
(import Vec)
(import Err)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.X25519)
(import Fmt)
(import Kat)

(:: orDie (-> (Result a Error) String a))
;@axiom:effect(io)
(fn (orDie r what)
  (match r
    ((Ok v) v)
    ((Err e) (cast a (die (strConcat "312: " (strConcat what (strConcat ": " (errorText e)))) 3)))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "x25519-openssl")) (mut n 0))
    {
      (for line in (katLines "x25519-openssl.txt")
        (let ((f (katFields line)))
          (let (
            (label (strConcat "case " (fmtInt n)))
            (s (orDie (secretFromString (katBytes f 0)) "secretFromString"))
            (peer (orDie (x25519PublicKeyFromBytes (katBytes f 2)) "x25519PublicKeyFromBytes"))
          )
            (let ((k (orDie (x25519KeyFromSecret s) "x25519KeyFromSecret")))
              {
                (tallyBytes t (katBytes f 1) (x25519PublicKeyBytes (x25519PublicKey k)) (strConcat label ": public key"))
                (match (x25519 k peer)
                  ((Ok shared)
                    {
                      (tallyBytes t (katBytes f 3) (secretExposeCopy shared) (strConcat label ": shared secret"))
                      (secretWipe shared)
                    })
                  ((Err e) (tallyCheck t false (strConcat label (strConcat ": " (errorText e))))))
                (x25519KeyWipe k)
                (secretWipe s)
                (set n (+ n 1))
              }))))
      (tallyReport t)
    }))
