; Crypto.Secret: redacted rendering, lengths, constant-time equality,
; copies in and out, and a wipe that leaves other secrets alone.
(import IO)
(import Str)
(import Err)
(import Fmt)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Kat)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (main)
  (let ((t (tallyNew "secret")))
    {
      (match (secretFromString "correct horse battery staple")
        ((Ok k)
          (let ((shown (format "{k}")))
            {
              (tallyCheck t (strEq shown "<SecretBytes>") "a secret renders as its type")
              (tallyCheck t (== (secretLen k) 28) "length")
              (tallyCheck t (strEq (secretExposeCopy k) "correct horse battery staple") "copy out")
              (match (secretFromString "correct horse battery staple")
                ((Ok k2)
                  {
                    (tallyCheck t (secretEq k k2) "equal secrets compare equal")
                    (secretWipe k2)
                    0
                  }
                )
                ((Err _) (tallyCheck t false "second secret")))
              (match (secretFromString "correct horse battery stapla")
                ((Ok k3)
                  {
                    (tallyCheck t (! (secretEq k k3)) "last byte differs")
                    (secretWipe k3)
                    0
                  }
                )
                ((Err _) (tallyCheck t false "third secret")))
              (tallyCheck t (strEq (secretExposeCopy k) "correct horse battery staple") "wiping another leaves this one")
              (secretWipe k)
              0
            })
        )
        ((Err _) (tallyCheck t false "a secret from a string")))
      (match (secretRandom 64)
        ((Ok r)
          {
            (tallyCheck t (== (secretLen r) 64) "random secret length")
            (tallyCheck t (! (strEq (secretExposeCopy r) (bytesNew 64))) "random secret is not all zero")
            (secretWipe r)
            0
          }
        )
        ((Err _) (tallyCheck t false "a random secret")))
      (match (secretFromString "")
        ((Ok e)
          {
            (tallyCheck t (== (secretLen e) 0) "an empty secret")
            (secretWipe e)
            0
          }
        )
        ((Err _) (tallyCheck t false "an empty secret")))
      (tallyReport t)
    }))
