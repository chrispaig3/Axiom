; Crypto.Ct's building blocks against answers worked out by hand: the
; masks at the edges of the word (zero, one, the most negative value,
; all ones), the unsigned comparison where signed order disagrees,
; selection, swaps, both byte orders, rotations, and erasure.
(import IO)
(import Str)
(import Mem)
(import Crypto.Ct)
(import Kat)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (main)
  (let (
    (t (tallyNew "ct"))
    (minInt (- 0 9223372036854775807))
  )
    {
      (tallyCheck t (== (ctMaskNz 0) 0) "ctMaskNz 0")
      (tallyCheck t (== (ctMaskNz 1) -1) "ctMaskNz 1")
      (tallyCheck t (== (ctMaskNz (- minInt 1)) -1) "ctMaskNz of the most negative word")
      (tallyCheck t (== (ctMaskNz -1) -1) "ctMaskNz -1")
      (tallyCheck t (== (ctMaskZero 0) -1) "ctMaskZero 0")
      (tallyCheck t (== (ctMaskZero 7) 0) "ctMaskZero 7")
      (tallyCheck t (== (ctMaskEq 42 42) -1) "ctMaskEq equal")
      (tallyCheck t (== (ctMaskEq 42 43) 0) "ctMaskEq unequal")
      (tallyCheck t (== (ctMaskLtU 1 2) -1) "1 < 2 unsigned")
      (tallyCheck t (== (ctMaskLtU 2 1) 0) "2 < 1 unsigned")
      (tallyCheck t (== (ctMaskLtU 5 5) 0) "5 < 5 unsigned")
      (tallyCheck t (== (ctMaskLtU 1 -1) -1) "1 < 2^64-1 unsigned")
      (tallyCheck t (== (ctMaskLtU -1 1) 0) "2^64-1 < 1 unsigned")
      (tallyCheck t (== (ctMaskLtU (- minInt 1) 9223372036854775807) 0) "2^63 < 2^63-1 unsigned")
      (tallyCheck t (== (ctMaskLtU 9223372036854775807 (- minInt 1)) -1) "2^63-1 < 2^63 unsigned")
      (tallyCheck t (== (ctMaskNeg -5) -1) "ctMaskNeg -5")
      (tallyCheck t (== (ctMaskNeg 5) 0) "ctMaskNeg 5")
      (tallyCheck t (== (ctMaskFromBit 1) -1) "ctMaskFromBit 1")
      (tallyCheck t (== (ctMaskFromBit 0) 0) "ctMaskFromBit 0")
      (tallyCheck t (== (ctMaskFromBit 3) -1) "ctMaskFromBit reads bit 0 only")
      (tallyCheck t (== (ctSelect -1 10 20) 10) "ctSelect all ones")
      (tallyCheck t (== (ctSelect 0 10 20) 20) "ctSelect zero")
      (tallyCheck t (== (ctBarrier 1234567) 1234567) "ctBarrier is the identity")
      (tallyCheck t (== (shrU -1 60) 15) "logical shift of all ones")
      (tallyCheck t (== (shrU (- minInt 1) 63) 1) "logical shift of the sign bit brings in zeros")
      (tallyCheck t (== (rotl64 1 63) (- minInt 1)) "rotl64 to the sign bit")
      (tallyCheck t (== (rotr64 1 1) (- minInt 1)) "rotr64 wraps")
      (tallyCheck t (== (rotl32 2147483648 1) 1) "rotl32 wraps at 32 bits")
      (tallyCheck t (== (rotr32 1 1) 2147483648) "rotr32 wraps at 32 bits")
      (tallyCheck t (== (add32 4294967295 2) 1) "add32 wraps")
      (let (
        (a (memAlloc 32))
        (b (memAlloc 32))
      )
        {
          (st64be a 0 81985529216486895)
          (tallyCheck t (== (ld64be a 0) 81985529216486895) "64-bit big-endian round trip")
          (tallyCheck t (== (__load8 a 0) 1) "big-endian writes the high byte first")
          (tallyCheck t (== (ld32le a 0) 1732584193) "the same bytes read little-endian")
          (st64le b 0 81985529216486895)
          (tallyCheck t (== (ld64le b 0) 81985529216486895) "64-bit little-endian round trip")
          (tallyCheck t (== (__load8 b 0) 239) "little-endian writes the low byte first")
          (st32be b 8 3735928559)
          (tallyCheck t (== (ld32be b 8) 3735928559) "32-bit big-endian round trip")
          (st32le b 12 3735928559)
          (tallyCheck t (== (ld32le b 12) 3735928559) "32-bit little-endian round trip")
          (tallyCheck t (! (ctEqAddr a b 8)) "ctEqAddr sees a difference")
          (ctCopy b a 8)
          (tallyCheck t (ctEqAddr a b 8) "ctCopy then ctEqAddr")
          (__store64 a 1 11)
          (__store64 b 1 22)
          (ctSwapWords 0 a b 2)
          (tallyCheck t (&& (== (__load64 a 1) 11) (== (__load64 b 1) 22)) "ctSwapWords with a zero mask leaves both")
          (ctSwapWords -1 a b 2)
          (tallyCheck t (&& (== (__load64 a 1) 22) (== (__load64 b 1) 11)) "ctSwapWords with an all-ones mask swaps")
          (ctWipe a 32)
          (let ((mut z 0))
            {
              (for i 0 32
                (set z (| z (__load8 a i))))
              (tallyCheck t (== z 0) "ctWipe zeroes every byte")
            })
        })
      (tallyReport t)
    }))
