; Ed25519's strictness and edge cases. From ed25519-strict.txt: public
; keys that RFC 8032 section 5.1.3 refuses (y at or above p, no x, x = 0
; with the sign bit) beside ones it accepts, the eight points of small
; order among them; signatures with S at or above L or a refused R; and
; the cofactorless verdict for keys of small and mixed order. Then the
; API's refusals and round trips.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Secret)
(import Crypto.Ed25519)
(import Kat)

(:: orDie (-> (Result a Error) String a))
;@axiom:effect(io)
(fn (orDie r what)
  (match r
    ((Ok v) v)
    ((Err e) (cast a (die (strConcat "323: " (strConcat what (strConcat ": " (errorText e)))) 3)))))

(:: failsWith (-> (Result a Error) Int Bool))
(fn (failsWith r code)
  (match r
    ((Ok _) false)
    ((Err e) (== (errCode e) code))))

; 01 for Ok, 00 for `cryptoInvalidEncoding`, and a message for
; anything else.
(:: verdict (-> (Result a Error) String))
(fn (verdict r)
  (match r
    ((Ok _) (strFromBool true))
    ((Err e)
      (if (== (errCode e) cryptoInvalidEncoding)
        (strFromBool false)
        (strConcat "unexpected error: " (errorText e))))))

; One byte: 01 for true, 00 for false.
(:: strFromBool (-> Bool String))
(fn (strFromBool b)
  (if b
    (orDieHex "01")
    (orDieHex "00")))

(:: orDieHex (-> String String))
(fn (orDieHex h)
  (match (hexDecode h)
    ((Ok s) s)
    ((Err _) "")))

(:: agrees (-> Bool Bool Bool))
(fn (agrees a b)
  (if a b (! b)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((t (tallyNew "ed25519-strict")) (api (tallyNew "ed25519-api")))
    {
      (for line in (katLines "ed25519-strict.txt")
        (let ((f (katFields line)))
          (let ((op (katText f 0)) (want (katBytes f 4)))
            (let ((label (strConcat op (strConcat " " (katText f 1)))))
              (if (strEq op "pk")
                (tallyBytes t want (verdict (ed25519PublicKeyFromBytes (katBytes f 1))) label)
                (strEq op "sig")
                (tallyBytes t want (verdict (ed25519SignatureFromBytes (katBytes f 1))) label)
                (strEq op "verify")
                (let (
                  (pk (katBytes f 1))
                  (msg (katBytes f 2))
                  (sig (katBytes f 3))
                )
                  (let ((direct (ed25519Verify (Ed25519PublicKey pk) msg (Ed25519Signature sig))))
                    {
                      (tallyBytes t want (strFromBool direct) label)
                      ; the strict path gives the same verdict
                      (tallyCheck t
                        (agrees direct
                          (match (ed25519PublicKeyFromBytes pk)
                            ((Err _) false)
                            ((Ok k)
                              (match (ed25519SignatureFromBytes sig)
                                ((Err _) false)
                                ((Ok s) (ed25519Verify k msg s))))))
                        (strConcat label " (through the decoders)"))
                    }))
                (tallyCheck t false (strConcat "unknown operation " op)))))))
      ; lengths
      (tallyCheck api (failsWith (ed25519PublicKeyFromBytes (bytesNew 31)) cryptoInvalidLength) "a 31-byte public key")
      (tallyCheck api (failsWith (ed25519PublicKeyFromBytes (bytesNew 33)) cryptoInvalidLength) "a 33-byte public key")
      (tallyCheck api (failsWith (ed25519SignatureFromBytes (bytesNew 63)) cryptoInvalidLength) "a 63-byte signature")
      (tallyCheck api (failsWith (ed25519SignatureFromBytes (bytesNew 65)) cryptoInvalidLength) "a 65-byte signature")
      (let ((short (orDie (secretFromString (bytesNew 31)) "secretFromString")))
        {
          (tallyCheck api (failsWith (ed25519KeyFromSecret short) cryptoInvalidLength) "a 31-byte seed")
          (secretWipe short)
        })
      ; generate, sign, verify, export and restore
      (let ((k (orDie ed25519KeyGenerate "ed25519KeyGenerate")) (other (orDie ed25519KeyGenerate "ed25519KeyGenerate")))
        (let ((pk (ed25519PublicKey k)) (sig (ed25519Sign k "hello")) (empty (ed25519Sign k "")))
          {
            (tallyCheck api (ed25519Verify pk "hello" sig) "a generated key's signature verifies")
            (tallyCheck api (ed25519Verify pk "" empty) "the signature of the empty message verifies")
            (tallyCheck api (! (ed25519Verify pk "hellp" sig)) "not for another message")
            (tallyCheck api (! (ed25519Verify (ed25519PublicKey other) "hello" sig)) "not under another key")
            (tallyCheck api (strEq (ed25519SignatureBytes sig) (ed25519SignatureBytes (ed25519Sign k "hello"))) "signing is deterministic")
            (tallyCheck api (! (ed25519Verify (Ed25519PublicKey (bytesNew 31)) "hello" sig)) "a forged 31-byte public key")
            (tallyCheck api (! (ed25519Verify pk "hello" (Ed25519Signature (strSlice (ed25519SignatureBytes sig) 0 63)))) "a forged 63-byte signature")
            (tallyCheck api (! (ed25519Verify pk "hello" (Ed25519Signature (strConcat (ed25519SignatureBytes sig) "\0")))) "a forged 65-byte signature")
            (let ((seed (orDie (ed25519KeyExport k) "ed25519KeyExport")))
              (let ((back (orDie (ed25519KeyFromSecret seed) "ed25519KeyFromSecret")))
                {
                  (tallyCheck api (== (secretLen seed) 32) "the exported seed is 32 bytes")
                  (tallyBytes api (ed25519PublicKeyBytes pk) (ed25519PublicKeyBytes (ed25519PublicKey back)) "the restored key has the same public key")
                  (tallyBytes api (ed25519SignatureBytes sig) (ed25519SignatureBytes (ed25519Sign back "hello")) "and signs the same")
                  (ed25519KeyWipe back)
                  (secretWipe seed)
                }))
            (tallyCheck api (isOk (ed25519PublicKeyFromBytes (ed25519PublicKeyBytes pk))) "a generated public key decodes strictly")
            (tallyCheck api (isOk (ed25519SignatureFromBytes (ed25519SignatureBytes sig))) "a generated signature decodes strictly")
            (ed25519KeyWipe k)
            (ed25519KeyWipe other)
          }))
      (+ (tallyReport t) (tallyReport api))
    }))
