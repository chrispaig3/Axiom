; Enough history to cross the compaction threshold, then a close.
;
; `HIST_BULK` entries of about 250 bytes each are recorded, every one
; carrying its own index so the gate can ask which SURVIVED rather than
; only how many. `histClose` then compacts, and the gate checks four
; things by value: the file holds exactly `histMaxEntries` entries, the
; NEWEST index is present, the OLDEST is not, and the file is under
; `histMaxBytes`. A trim that kept the wrong end passes a count and
; fails the second and third of those.
;
; Driven by scripts/check-repl-history.sh.
(import Str)

(import Sys)

(import diag)

(import replhist)

(:: pad String)

(fn (pad)
  "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
)

(:: bulkRecord (-> Int Int Int Int))

;@axiom:effect(io)
(fn (bulkRecord h i limit)
  (if (>= i limit)
    0
    {
      (histRecord h (strConcat (strConcat "(bulk " (decStr i)) (strConcat " " (strConcat pad ")"))))
      (bulkRecord h (+ i 1) limit)
    }
  )
)

(:: main Int)

;@axiom:effect(io)
(fn (main)
  (let (
    (h (histOpen 1))
    (limit (strToIntPub (sysEnv "HIST_BULK")))
  )
    {
      (bulkRecord h 0 limit)
      ; 42 only when compaction actually ran AND the ring is at its
      ; cap. 43 says it compacted and the ring is the wrong size, 44
      ; that it did not compact at all - three outcomes, not two, so
      ; "the threshold was never crossed" cannot look like success.
      (if (== (histClose h) 1)
        (if (== (histLen h) histMaxEntries)
          42
          43
        )
        44
      )
    }
  )
)

; A small unsigned parser, because `sysEnv` answers a String and this
; fixture needs a number from it. Answers 0 on anything that is not all
; digits, which the gate turns into a visible failure rather than a
; silent zero-length run: it requires the exit status to report the
; compaction it asked for.
(:: strToIntPub (-> String Int))

(fn (strToIntPub s) (digitsFrom s 0 0))

(:: digitsFrom (-> String Int Int Int))

(fn (digitsFrom s i acc)
  (if (>= i (strLen s))
    acc
    (let ((b (strByte s i)))
      (if (|| (< b 48) (> b 57))
        0
        (digitsFrom s (+ i 1) (+ (* acc 10) (- b 48)))
      )
    )
  )
)
