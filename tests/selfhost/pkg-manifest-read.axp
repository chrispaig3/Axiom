(import pkg)
(import IO)
(import Sys)
(import Vec)
(import Str)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let dir (sysArg 1))
    (let mode (sysArg 2))
    (if (strEq mode "dirs")
      {
        (let n (vecLen (pkgDependDirs dir)))
        (println "dirs {n}")
      })
    (if (strEq mode "search")
      {
        (let n (vecLen (pkgSearchDirs dir)))
        (println "search {n}")
      })
    (if (strEq mode "name")
      (match (pkgName dir)
        ((None) (println "name None"))
        ((Some value) (println "name {value}"))))
    (if (strEq mode "opt")
      (match (pkgOpt dir)
        ((None) (println "opt None"))
        ((Some value) (println "opt {value}"))))
    (if (strEq mode "entry")
      (match (pkgEntryFile dir)
        ((None) (println "entry None"))
        ((Some value) (println "entry {value}"))))
    (if (strEq mode "verify")
      {
        (let _verified (pkgVerify dir))
        (println "verified")
      })
  })
