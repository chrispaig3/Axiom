; expect 93
; A macro invoked inside an `impl` method body, and inside a trait
; DEFAULT body. Both expressions lower into ordinary declarations only
; AFTER the expansion pass runs, and until 2026-08-14 the pass walked
; `fn` bodies only - so the invocations below survived expansion
; entirely: `check` said OK (the checker's macro-head arm answers a
; silent wildcard) and the build died in `opt` with `use of undefined
; value '@dbl'`, the compiler blaming the toolchain for its own bug.
; docs/macro-system.md MAC-EXP-3a; the unfixed compiler exits 4 on
; this file.
;
;   (dub 21)   impl method whose body is a macro invocation -> 42
;   (tri 21)   trait default using a parameterised macro AND a bare
;              zero-parameter one (MAC-LANG-3's other spelling) -> 51
(macro (dbl x) (+ x x))
(macro (nine) 9)

(trait (Doubler a) where
  (dub :: (-> a Int)
   tri :: (-> a Int) = (lambda (x) (+ (dbl x) nine))))

(impl (Doubler Int) where
  ((dub (lambda (x) (dbl x)))))

(:: main Int)
(fn (main) (+ (dub 21) (tri 21)))
