; expect 25
; A parameter or a `let` binder spelled like an operator shadows the
; operator inside its scope, as the reference says. `apply` names its
; parameter `+`, so `(+ 1 2)` calls the lambda it was handed:
; 1 * (2 + 10) = 12. The `let` binds `*` to an adder, so `(* 6 7)` is
; 13. A top-level function can't take an operator's name, because every
; call of `*` reaches the built-in (tests/diagnostics/1029).
(:: apply (-> (-> Int Int Int) Int))
(fn (apply +)
  (+ 1 2))

(:: letShadow Int)
(fn (letShadow)
  (let ((* 
    (lambda (a b) (+ a b))))
    (* 6 7)))

(:: main Int)
(fn (main)
  (+
    (apply
      (lambda (a b) (* a (+ b 10))))
    (letShadow)))
