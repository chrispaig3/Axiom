; expect 79
; Assembly description queries preserve zero positions and empty fields.
(import codegen)
(import parser)
(import core)
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  {
    (println
      (concat (fmtInt index)
        (if good
          " true"
          " false")))
    (if (! good)
      (sysExitWith 1))
  })

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs found expected)
  (match found
    ((None) false)
    ((Some index) (== index expected))))

(:: fieldsOf (-> (Option Ints) Ints))
(fn (fieldsOf found)
  (match found
    ((None) __indexTrap)
    ((Some fields) fields)))

(:: descriptionArgs (-> String Nodes))
(fn (descriptionArgs text)
  (vecPush vecNew (nodeBuildEStr (concat "\"" (concat text "\"")) 0 0 0)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (isNone (asmSemi "" 0)))
    (say 2 (isNone (asmSemi "word" 0)))
    (say 3 (indexIs (asmSemi ";x;" 0) 0))
    (say 4 (indexIs (asmSemi ";x;" 1) 2))
    (say 5 (isNone (asmSemi ";x;" 3)))
    (say 6 (isNone (asmSemi ";x;" (- 0 1))))
    (let arm "aarch64;s;;0;-1;;;;0;3;nop")
    (let other "x86_64;s;;0;-1;;;;0;5;pause")
    (let both (concat arm other))
    (let fields (fieldsOf (asmArmFields arm 0)))
    (say 7 (== (vecLen fields) 21))
    (say 8 (strEq (asmField arm fields 0) "aarch64"))
    (say 9 (strEq (asmField arm fields 1) "s"))
    (say 10 (strEq (asmField arm fields 2) ""))
    (say 11 (== (asmFieldInt arm fields 3) 0))
    (say 12 (== (asmFieldInt arm fields 4) (- 0 1)))
    (say 13 (== (vecGet fields 17) 0))
    (say 14 (strEq (strSlice arm (vecGet fields 18) (vecGet fields 19)) "nop"))
    (say 15 (== (vecGet fields 20) 26))
    (let empty (fieldsOf (asmArmFields "aarch64;s;;0;-1;;;;0;0;" 0)))
    (say 16 (&& (== (vecGet empty 19) 0) (== (vecGet empty 20) 23)))
    (let embedded "x86_64;pm;=r;1;0;;0;12-15;5;f;ile4;n;op")
    (let embeddedFields (fieldsOf (asmArmFields embedded 0)))
    (say 17
      (strEq (strSlice embedded (vecGet embeddedFields 16) (vecGet embeddedFields 17)) "f;ile"))
    (say 18
      (strEq (strSlice embedded (vecGet embeddedFields 18) (vecGet embeddedFields 19)) "n;op"))
    (say 19 (== (vecGet embeddedFields 20) 39))
    (say 20 (isNone (asmArmFields "aarch64" 0)))
    (say 21 (isNone (asmArmFields "aarch64;s;;0;-1;;;;" 0)))
    (say 22 (isNone (asmArmFields "aarch64;s;;0;-1;;;;0;" 0)))
    (say 23 (isNone (asmArmFields arm (- 0 1))))
    (say 24 (isNone (asmArmFields arm 26)))
    (say 25 (indexIs (asmArmAt both "aarch64" 0) 0))
    (say 26 (indexIs (asmArmAt both "x86_64" 0) 26))
    (say 27 (indexIs (asmArmAt both "x86_64" 26) 26))
    (say 28 (isNone (asmArmAt both "aarch64" 26)))
    (say 29 (isNone (asmArmAt both "other" 0)))
    (say 30 (isNone (asmArmAt both "x86_64" 53)))
    (say 31 (isNone (asmArmAt "aarch64" "aarch64" 0)))
    (say 32 (isNone (asmArmAt both "aarch64" (- 0 1))))
    (let selected newCG)
    (set selected.target 0)
    (emitPrimAsm (descriptionArgs both) selected)
    (say 33 (isSome (strFind (renderCG selected) "call void asm sideeffect \"\\6E\\6F\\70\"" 0)))
    (say 34 (isNone (strFind (renderCG selected) "\\70\\61\\75\\73\\65" 0)))
    (let later newCG)
    (set later.target 3)
    (emitPrimAsm (descriptionArgs both) later)
    (say 35
      (isSome (strFind (renderCG later) "call void asm sideeffect \"\\70\\61\\75\\73\\65\"" 0)))
    (let refused newCG)
    (set refused.target 0)
    (emitPrimAsm (descriptionArgs other) refused)
    (say 36 (strEq refused.result "0"))
    (say 37
      (strEq (renderCG refused)
        "  ; axiom-device-refused an `asm` form has no `aarch64` arm, and darwin-aarch64 is an aarch64 target\n"))
    (let truncated newCG)
    (set truncated.target 0)
    (emitPrimAsm (descriptionArgs "aarch64") truncated)
    (say 38 (strEq (renderCG truncated) (renderCG refused)))
    (let nonstring newCG)
    (set nonstring.target 0)
    (emitPrimAsm (vecPush vecNew (nodeBuildEIntPlain 1 0 0)) nonstring)
    (say 39 (strEq (renderCG nonstring) (renderCG refused)))
    79
  })
