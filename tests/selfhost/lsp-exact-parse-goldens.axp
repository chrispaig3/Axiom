(import core)
(import lsp)
(import jsonrpc)
(import Vec)
(import IO)

(:: report (-> String Int ()))
;@axiom:effect(io)
(fn (report source offset)
  {
    (println "SOURCE {source}")
    (let params (jsonObjPut jsonObj "position" (lspPos source offset)))
    (println (jsonWrite (lspPrepareRename source params)))
    (println
      (jsonWrite
        (lspRename (lspWorkspaceNew vecNew vecNew vecNew) source "file:///tmp/exact.ax"
          (jsonObjPut params "newName" (jsonStr "value")) vecNew vecNew)))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (report "" 0)
    (report "(fn (identity x) x)" 14)
    (report "(fn (identity x) x" 14)
    (report "(fn (identity x) x) @" 14)
    (report "(fn (identity x) { (let value 1) x })" 14)
    (report "(fn (identity x) x) (fn (second) 2)" 5)
    0
  })
