; expect 42
; The filesystem surface a batteries-included language needs and did
; not have: `Sys` had open/read/write/close/seek/unlink and no way to
; make a directory at all.
;
; This is a ROUND TRIP, not a status check. `makeDir` answering `Ok`
; proves only that a syscall was accepted; the directory has to then
; be there, and be gone after `removeDir`, or the number meant nothing.
; A gate that asserted `(isOk (makeDir p))` alone would pass
; against a syscall number for something else entirely.
;
; It cleans up after itself, which is why `removeDir` had to land with
; `makeDir` rather than after it - a fixture that creates a directory
; in the working tree and cannot remove it is litter every later gate
; runs over.
;
; `stat` is deliberately absent. Its answer is a struct whose layout
; differs on all four targets, so a portable `stat` is four record
; layouts rather than one syscall number - and the two questions
; anyone actually asks it, "is it there" and "how big", are `open` and
; `lseek`, which this module already had.
(import IO)
(import Err)
(import Str)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  ; not there to begin with, and a size query on it fails
  (let (
    (d "axiom_test_dir_992")
    (f "axiom_test_file_992")
    (mut n 0)
  )
    {
      (if (fileExists d)
        0
        (set n (+ n 1)))
      (if (isErr (fileSize d))
        (set n (+ n 1))
        0)
      ; created
      (if (isOk (makeDir d))
        (set n (+ n 1))
        0)
      (if (fileExists d)
        (set n (+ n 1))
        0)
      ; creating it again is EEXIST, not silence
      (if (isErr (makeDir d))
        (set n (+ n 1))
        0)
      ; removed, and gone
      (if (isOk (removeDir d))
        (set n (+ n 1))
        0)
      (if (fileExists d)
        0
        (set n (+ n 1)))
      ; a file with known contents has a known size. Written and
      ; removed here rather than pointed at a path in the tree,
      ; because a fixture that depends on where it was run from is a
      ; statement about the harness, not about `lseek`.
      (unwrapOr (writeFile f "hello") 0)
      (if (== (unwrapOr (fileSize f) 0) 5)
        (set n (+ n 1))
        0)
      (if (isOk (removeFile f))
        (set n (+ n 1))
        0)
      (if (fileExists f)
        0
        (set n (+ n 1)))
      (if (== n 10)
        42
        1)
    }))
