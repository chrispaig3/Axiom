; expect 42
; A lambda captures its enclosing scope by value: `n` is a parameter
; of the enclosing function, carried in the closure record and read
; back inside the lifted body. The call goes indirect with the record
; as hidden first argument.
(:: mk (-> Int Int))

(fn (mk n)
  (let ((f 
    (lambda (x) (+ x n))
  ))
    (f 10)
  )
)

(:: main Int)

(fn (main) (mk 32))
