(import core)
(import diag)
(import render)
(import lsp)
(import jsonrpc)
(import Str)
(import Vec)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n result)
  (println "{n} {result}"))

(:: count (-> a Int))
;@axiom:effect(unsafe)
(fn (count value)
  (__load64 (as value Int) -2))

(:: textIs (-> (Option String) String Bool))
(fn (textIs option expected)
  (match option
    ((None) false)
    ((Some value) (strEq value expected))))

(:: diagnostic (-> (Option String) Diag))
(fn (diagnostic label)
  (mkDiagBase SEV_ERROR "AX3001" "probe" (mkSpan 0 5) "message" label))

(:: retireLabel (-> String Int))
(fn (retireLabel text)
  {
    (let d (diagnostic (Some text)))
    17
  })

(:: retireFix (-> String Int))
(fn (retireFix text)
  {
    (let d (diagnostic None))
    (diagAddFixHelp d "replace" (mkSpan 0 5) text)
    19
  })

(:: disarm (-> String Int))
(fn (disarm text)
  {
    (let d (diagnostic None))
    (diagAddFixHelp d "replace" (mkSpan 0 5) text)
    (diagDisarmFixes d)
    (diagHelpCount d)
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let missing (diagnostic None))
    (say 1 (isNone (diagLabel missing)))
    (let empty (diagnostic (Some "")))
    (say 2 (textIs (diagLabel empty) ""))
    (say 3 (strEq (lspDiagText empty) "message"))
    (say 4 (strEq (lspDiagText missing) "message"))
    (let label (strDup "owned label"))
    (let before (count label))
    (say 5 (== (retireLabel label) 17))
    (say 6 (== (count label) before))
    (diagSetLabel missing label)
    (say 7 (textIs (diagLabel missing) "owned label"))
    (say 8 (== (count label) (+ before 1)))
    (diagSetLabel missing "replacement")
    (say 9 (== (count label) before))
    (set missing.label None)
    (say 10 (isNone (diagLabel missing)))
    (diagAddHelp missing "plain")
    (say 11 (== (diagHelpCount missing) 1))
    (say 12 (isNone (diagHelpFix missing 0)))
    (say 13 (isNone (diagHelpFixText missing 0)))
    (say 14 (== (diagHelpFixSpan missing 0) 0))
    (diagAddFixHelp missing "delete" (mkSpan 0 5) "")
    (say 15 (textIs (diagHelpFixText missing 1) ""))
    (say 16
      (if (let (Some fix) (diagHelpFix missing 1))
        (&& (== (spanStart fix.span) 0) (== (spanEnd fix.span) 5))
        false))
    (diagAddFixHelp missing "no location" 0 "unused")
    (say 17 (isNone (diagHelpFix missing 2)))
    (say 18 (isNone (diagHelpFixText missing 2)))
    (let source "alpha beta\n")
    (let ix (lspLineIndex source))
    (let actions jsonArr)
    (lspQuickfixesOf actions missing source "file:///probe.ax" ix (mkSpan 0 5))
    (say 19 (== (jsonArrLen actions) 1))
    (say 20
      (if (== (jsonArrLen actions) 1)
        {
          (let edits
            (jsonGet (jsonGet (jsonGet (jsonArrGet actions 0) "edit") "changes")
              "file:///probe.ax"))
          (strEq (jsonStrVal (jsonGet (jsonArrGet edits 0) "newText")) "")
        }
        false))
    (say 21 (strEq (diagHelpMsg missing 2) "no location"))
    (let replacement (strDup "owned replacement"))
    (let beforeFix (count replacement))
    (say 22 (== (retireFix replacement) 19))
    (say 23 (== (count replacement) beforeFix))
    (say 24 (== (disarm replacement) 1))
    (say 25 (== (count replacement) beforeFix))
    (let held (diagnostic None))
    (diagAddFixHelp held "one" (mkSpan 0 1) replacement)
    (diagAddFixHelp held "two" (mkSpan 2 3) replacement)
    (say 26 (== (count replacement) (+ beforeFix 2)))
    (diagDisarmFixes held)
    (say 27 (== (count replacement) beforeFix))
    (say 28 (&& (isNone (diagHelpFix held 0)) (isNone (diagHelpFix held 1))))
    (say 29 (&& (strEq (diagHelpMsg held 0) "one") (strEq (diagHelpMsg held 1) "two")))
    (let publicEntry (DHelp :msg "unlocated" :fix (Some (DFix :span 0 :text "public"))))
    (diagAddHelpEntry held publicEntry)
    (say 30 (isNone (diagHelpFix held 2)))
    (let noneActions jsonArr)
    (lspQuickfixesOf noneActions held source "file:///probe.ax" ix (mkSpan 0 5))
    (say 31 (== (jsonArrLen noneActions) 0))
    (let old
      (mkDiagFix2 SEV_ERROR "AX3001" "probe" (mkSpan 0 5) "legacy" None "delete"
        (diagFix (mkSpan 0 5) "") (Some "second")))
    (say 32 (textIs (diagHelpFixText old 0) ""))
    (say 33 (&& (== (diagHelpCount old) 2) (isNone (diagHelpFix old 1))))
    (say 34 (isNone (diagLabel old)))
  })
