(import core)
(import markdown)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say number good)
  (println "{number} {good}"))

(:: intIs (-> (Option Int) (Option Int) Bool))
(fn (intIs actual expected)
  (match expected
    ((None) (isNone actual))
    ((Some want)
      (match actual
        ((None) false)
        ((Some got) (== got want)))
    )))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (intIs (mdBracketEnd "[x]" 0) (Some 3)))
    (say 2 (intIs (mdBracketEnd "[a[b]c]" 0) (Some 7)))
    (say 3 (intIs (mdBracketEnd "[x" 0) None))
    (say 4 (intIs (mdBracketEnd "[`[`]" 0) (Some 5)))
    (say 5 (intIs (mdParenEnd ")" 0) (Some 0)))
    (say 6 (intIs (mdParenEnd "x)" 0) (Some 1)))
    (say 7 (intIs (mdParenEnd "x(y)z)" 0) (Some 5)))
    (say 8 (intIs (mdParenEnd "x" 0) None))
    (say 9 (intIs (mdParenEnd "x y)" 0) (Some 3)))
    (say 10 (intIs (mdParenEnd "x\ny)" 0) (Some 3)))
    (say 11 (intIs (mdCodeClose "`" 0 1) (Some 0)))
    (say 12 (intIs (mdCodeClose "`a`" 1 1) (Some 2)))
    (say 13 (intIs (mdCodeClose "``x``" 2 2) (Some 3)))
    (say 14 (intIs (mdCodeClose "``x`" 2 2) None))
    (say 15 (intIs (mdEmClose "a*" 0 1) (Some 1)))
    (say 16 (intIs (mdEmClose "**abc**" 2 2) (Some 5)))
    (say 17 (intIs (mdEmClose "abc" 0 1) None))
    (say 18 (intIs (mdEmClose " a*" 0 1) None))
    (say 19 (intIs (mdEmClose "a**" 0 1) None))
    (say 20 (intIs (mdParenEnd "x y" 0) None))
    (say 21 (intIs (mdParenEnd "x(y" 0) None))
    0
  })
