(import pkg)
(import IO)
(import Sys)
(import Str)
(import Err (Error errCode))

(:: showOrigin (-> (Result (Option String) Error) ()))
;@axiom:effect(io)
(fn (showOrigin origin)
  (match origin
    ((Err e)
      {
        (let code (errCode e))
        (println "Err {code}")
      }
    )
    ((Ok value)
      (match value
        ((None) (println "Ok None"))
        ((Some url)
          {
            (let n (strLen url))
            (println "Ok Some {n}:{url}")
          }
        ))
    )))

(:: showWhy (-> String ()))
;@axiom:effect(io)
(fn (showWhy dir)
  (match (pkgOrigin dir)
    ((Err e) (println (pkgOriginReadFailure dir e)))
    ((Ok origin) (println (pkgOriginWhy origin "expected")))))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let good (pkgOrigin (sysArg 1)))
    (showOrigin good)
    (showOrigin (pkgOrigin (sysArg 2)))
    (showOrigin (pkgOrigin (sysArg 3)))
    (showOrigin (pkgOrigin (sysArg 4)))
    (showOrigin (pkgOrigin (sysArg 5)))
    (showOrigin (pkgOrigin (sysArg 6)))
    (showWhy (sysArg 1))
    (showWhy (sysArg 2))
    (showWhy (sysArg 5))
  })
