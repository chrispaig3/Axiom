; Typed result, argument and label setters retain replacements before retiring
; the old slot share. Borrowed getters keep independent aliases alive.
(import codegen)
(import parser)
(import raw)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: rc (-> Int Int))
;@axiom:effect(unsafe)
(fn (rc address)
  (__load64 address -2))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: lineAt (-> CG Int String))
;@axiom:effect(unsafe)
(fn (lineAt cg index)
  (as (__load64 (__load64 (__load64 (as cg Int) 0) 2) index) String))

(:: overwrite (-> String Int Int))
;@axiom:effect(unsafe)
(fn (overwrite text byte)
  (__store8 (strData text) 0 byte))

(:: resultChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (resultChecks)
  {
    (let cg newCG)
    (say 1 (strEq (memGetWordStr (as cg Int) 2) ""))
    (say 2 (strEq (memGetWordStr (as cg Int) 11) "entry"))
    (let first (strDup "%old"))
    (let second (strDup "%new"))
    (let label (strDup "block"))
    (let firstCount (rc (as first Int)))
    (probeSetResult cg first)
    (say 3 (== (memGetWord (as cg Int) 2) (as first Int)))
    (say 4 (== (rc (as first Int)) (+ firstCount 1)))
    (let labelCount (rc (as label Int)))
    (probeSetBlock cg label)
    (say 5 (== (memGetWord (as cg Int) 11) (as label Int)))
    (say 6 (== (rc (as label Int)) (+ labelCount 1)))
    (let beforeGetter (rc (as first Int)))
    (say 7 (== (probeGetterCount cg 2) (+ beforeGetter 1)))
    (say 8 (== (rc (as first Int)) beforeGetter))
    (let old (memGetWordStr (as cg Int) 2))
    (let beforeReplacement (rc (as first Int)))
    (probeSetResult cg second)
    (say 9 (== (rc (as first Int)) (- beforeReplacement 1)))
    (say 10 (strEq old "%old"))
    (say 11 (== (memGetWord (as cg Int) 11) (as label Int)))
    (let beforeLabelGetter (rc (as label Int)))
    (say 12 (== (probeGetterCount cg 11) (+ beforeLabelGetter 1)))
    (say 13 (== (rc (as label Int)) beforeLabelGetter))
    (let oldLabel (memGetWordStr (as cg Int) 11))
    (let beforeLabelReplacement (rc (as label Int)))
    (probeSetBlock cg "next")
    (say 14 (== (rc (as label Int)) (- beforeLabelReplacement 1)))
    (say 15 (strEq oldLabel "block"))
    (say 16 (strEq (memGetWordStr (as cg Int) 2) "%new"))
    (say 17 (probeSameResultGetter cg "%new"))
  })

(:: emissionChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (emissionChecks)
  {
    (let cg newCG)
    (emitInt (mkEInt 42) cg)
    (say 18 (strEq (memGetWordStr (as cg Int) 2) "42"))
    (say 19 (== (memGetWord (as cg Int) 14) 0))
    (let result (memGetWordStr (as cg Int) 2))
    (let source (strDup "snap"))
    (emitLabel cg source)
    (overwrite source 88)
    (say 20 (strEq (memGetWordStr (as cg Int) 11) "snap"))
    (say 21 (strEq (lineAt cg 0) "snap:"))
    (for i in 0..128
      (emitLine cg (concat "line-" (fmtInt i))))
    (say 22 (strEq result "42"))
    (say 23 (strEq (memGetWordStr (as cg Int) 11) "snap"))
  })

(:: preallocatedChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (preallocatedChecks)
  {
    (let cg newCG)
    (let a (strDup "a"))
    (let b (strDup "b"))
    (probeSetResult cg a)
    (probeSetBlock cg b)
    (let aCount (rc (as a Int)))
    (let bCount (rc (as b Int)))
    (let before (live))
    (for i in 0..1000
      {
        (probeSetResult cg b)
        (probeSetBlock cg a)
        (probeSetResult cg a)
        (probeSetBlock cg b)
      })
    (let growth (- (live) before))
    (say 24 (== (rc (as a Int)) aCount))
    (say 25 (== (rc (as b Int)) bCount))
    (say 26 (<= growth 4096))
    (say 27
      (&& (strEq (memGetWordStr (as cg Int) 2) "a") (strEq (memGetWordStr (as cg Int) 11) "b")))
  })

(:: freshOverwrite (-> CG Int Int))
(fn (freshOverwrite cg i)
  {
    (let value (concat "%fresh-" (fmtInt i)))
    (probeSetResult cg value)
    0
  })

; This reports ordinary caller ownership separately. A parked birth share
; must remain visible rather than being released by test-only raw code.
(:: ordinaryDiagnostic Int)
;@axiom:effect(io)
(fn (ordinaryDiagnostic)
  {
    (let cg newCG)
    (for i in 0..16
      (freshOverwrite cg i))
    (let before (live))
    (for i in 0..1000
      (freshOverwrite cg i))
    (let growth (- (live) before))
    (writeStr stderr (concat "ordinary-soak-growth " (concat (fmtInt growth) "\n")))
    growth
  })

(:: castChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (castChecks)
  {
    (let cg newCG)
    (let value (strDup "cast-boundary"))
    (let before (rc (as value Int)))
    (probeSetRawResult cg (as value Int))
    (say 28 (== (rc (as value Int)) (+ before 1)))
    (say 29 (strEq (memGetWordStr (as cg Int) 2) "cast-boundary"))
  })

(:: argsChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (argsChecks)
  {
    (let cg newCG)
    (probeSetResult cg "%result")
    (probeSetBlock cg "block")
    (say 33 (strEq (memGetWordStr (as cg Int) 9) ""))
    (let first (strDup "arg-old"))
    (let second (strDup "arg-new"))
    (let before (rc (as first Int)))
    (probeSetArgsTyped cg first)
    (say 34 (== (rc (as first Int)) (+ before 1)))
    (say 35 (strEq (memGetWordStr (as cg Int) 9) "arg-old"))
    (let beforeGetter (rc (as first Int)))
    (say 36 (== (probeGetterCount cg 9) (+ beforeGetter 1)))
    (say 37 (== (rc (as first Int)) beforeGetter))
    (let old (memGetWordStr (as cg Int) 9))
    (let beforeReplacement (rc (as first Int)))
    (probeSetArgsTyped cg second)
    (say 38 (== (rc (as first Int)) (- beforeReplacement 1)))
    (say 39 (strEq old "arg-old"))
    (say 40
      (&& (strEq (memGetWordStr (as cg Int) 2) "%result")
        (strEq (memGetWordStr (as cg Int) 11) "block")))
    (say 41 (probeSameArgsGetter cg "arg-new"))
    (let beforeSame (rc (as second Int)))
    (probeSetArgsTyped cg second)
    (say 42 (== (rc (as second Int)) beforeSame))
    (let cast (strDup "arg-cast"))
    (let beforeCast (rc (as cast Int)))
    (probeSetRawArgsTyped cg (as cast Int))
    (say 43 (== (rc (as cast Int)) (+ beforeCast 1)))
    (say 44 (strEq (memGetWordStr (as cg Int) 9) "arg-cast"))
  })

(:: argsPreallocatedChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (argsPreallocatedChecks)
  {
    (let cg newCG)
    (let a (strDup "arg-a"))
    (let b (strDup "arg-b"))
    (probeSetArgsTyped cg a)
    (let aCount (rc (as a Int)))
    (let bCount (rc (as b Int)))
    (let before (live))
    (for i in 0..1000
      {
        (probeSetArgsTyped cg b)
        (probeSetArgsTyped cg a)
      })
    (let growth (- (live) before))
    (say 45 (== (rc (as a Int)) aCount))
    (say 46 (== (rc (as b Int)) bCount))
    (say 47 (<= growth 4096))
    (say 48 (strEq (memGetWordStr (as cg Int) 9) "arg-a"))
  })

(:: argsEmissionChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (argsEmissionChecks)
  {
    (let listCG newCG)
    (emitArgsList vecNew listCG 0)
    (say 49
      (&& (strEq (memGetWordStr (as listCG Int) 2) "")
        (strEq (memGetWordStr (as listCG Int) 9) "")))
    (emitArgsList (vecPush vecNew (mkEInt 7)) listCG 0)
    (say 50
      (&& (strEq (memGetWordStr (as listCG Int) 2) "7")
        (strEq (memGetWordStr (as listCG Int) 9) "7")))
    (let many (vecPush (vecPush (vecPush vecNew (mkEInt 1)) (mkEInt 2)) (mkEInt 3)))
    (emitArgsList many listCG 0)
    (say 51
      (&& (strEq (memGetWordStr (as listCG Int) 2) "1, 2, 3")
        (strEq (memGetWordStr (as listCG Int) 9) "1, i64 2, i64 3")))
    (let oldList (memGetWordStr (as listCG Int) 9))
    (let nested (mkEApp (mkEApp (mkEVar "+") (mkEInt 1)) (mkEInt 2)))
    (let nestedArgs (vecPush (vecPush vecNew nested) (mkEInt 9)))
    (emitArgsList nestedArgs listCG 0)
    (say 52 (strEq oldList "1, i64 2, i64 3"))
    (say 53
      (&& (strEq (memGetWordStr (as listCG Int) 2) "%.t0, 9")
        (strEq (memGetWordStr (as listCG Int) 9) "%.t0, i64 9")))
    (say 54 (strEq (lineAt listCG 0) "  %.t0 = add i64 1, 2"))
    (say 55 (== (memGetWord (as listCG Int) 1) 1))
    (let regsCG newCG)
    (let emptyRegs vecNew)
    (emitArgsRegs vecNew regsCG emptyRegs 0 "test" 0)
    (say 56
      (&& (== (vecLen emptyRegs) 0)
        (&& (strEq (memGetWordStr (as regsCG Int) 2) "")
          (strEq (memGetWordStr (as regsCG Int) 9) ""))))
    (let singleRegs vecNew)
    (emitArgsRegs (vecPush vecNew (mkEInt 7)) regsCG singleRegs 0 "test" 0)
    (say 57
      (&& (== (vecLen singleRegs) 1)
        (&& (strEq (memGetWordStr (as regsCG Int) 9) "7") (strEq (vecGet singleRegs 0) "7"))))
    (let manyRegs vecNew)
    (emitArgsRegs many regsCG manyRegs 0 "test" 0)
    (say 58
      (&& (== (vecLen manyRegs) 3)
        (&& (strEq (memGetWordStr (as regsCG Int) 2) "1, 2, 3")
          (&& (strEq (memGetWordStr (as regsCG Int) 9) "1, i64 2, i64 3")
            (&& (strEq (vecGet manyRegs 0) "1")
              (&& (strEq (vecGet manyRegs 1) "2") (strEq (vecGet manyRegs 2) "3")))))))
    (let oldRegs (memGetWordStr (as regsCG Int) 9))
    (let nestedRegs vecNew)
    (emitArgsRegs nestedArgs regsCG nestedRegs 0 "test" 0)
    (say 59
      (&& (== (vecLen nestedRegs) 2)
        (&& (strEq (memGetWordStr (as regsCG Int) 2) "%.t0, 9")
          (&& (strEq (memGetWordStr (as regsCG Int) 9) "%.t0, i64 9")
            (&& (strEq (vecGet nestedRegs 0) "%.t0") (strEq (vecGet nestedRegs 1) "9"))))))
    (say 60 (strEq (lineAt regsCG 0) "  %.t0 = add i64 1, 2"))
    (say 61 (strEq oldRegs "1, i64 2, i64 3"))
  })

(:: freshArgsOverwrite (-> CG Int Int))
(fn (freshArgsOverwrite cg i)
  {
    (let value (concat "%args-" (fmtInt i)))
    (probeSetArgsTyped cg value)
    0
  })

(:: argsOrdinaryDiagnostic Int)
;@axiom:effect(io)
(fn (argsOrdinaryDiagnostic)
  {
    (let cg newCG)
    (for i in 0..16
      (freshArgsOverwrite cg i))
    (let before (live))
    (for i in 0..1000
      (freshArgsOverwrite cg i))
    (let growth (- (live) before))
    (writeStr stderr (concat "args-ordinary-soak-growth " (concat (fmtInt growth) "\n")))
    growth
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    resultChecks
    emissionChecks
    preallocatedChecks
    (let ordinaryGrowth (ordinaryDiagnostic))
    castChecks
    ; These final checks never dereference a descriptor after an ablated
    ; release-first setter has filed it. Only allocator counts are read.
    (say 30 (probeSoleResultSame))
    (say 31 (probeSoleBlockSame))
    (say 32 (<= ordinaryGrowth 4096))
    argsChecks
    argsPreallocatedChecks
    argsEmissionChecks
    (let argsGrowth (argsOrdinaryDiagnostic))
    (say 62 (<= argsGrowth 4096))
    (say 63 probeSoleArgsSame)
    0
  })
