; expect 12
; Field access: `p.x` resolves the field in the struct the checker
; resolved `p` to (995-struct-field-by-type.ax is the case with two
; structs sharing a name) and loads at its word offset - a struct
; carries no tag, so field i is word i.
(struct Pt
  (x : Int)
  (y : Int))

(:: main Int)

(fn (main)
  (let ((p (Pt 3 9)))
    (+ p.x p.y)
  )
)
