; The emitter snapshots mutable input, keeps its stable Vec header, and
; retires the displaced CG slot separately from a getter's temporary share.
(import codegen)
(import raw)
(import Str)
(import Vec)
(import IO)
(import Fmt)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

; Counted payloads put their reference count two words before the data.
; Every address inspected here is a live, explicitly held allocation.
(:: countOf (-> Int Int))
;@axiom:effect(unsafe)
(fn (countOf address)
  (__load64 address -2))

(:: overwrite (-> String Int Int))
;@axiom:effect(unsafe)
(fn (overwrite text byte)
  (__store8 (strData text) 0 byte))

(:: scopedLine (-> CG CG))
(fn (scopedLine cg)
  {
    (let text (concat "scope-" (fmtInt 73)))
    (emitLine cg text)
  })

(:: getterCount (-> CG Int))
;@axiom:effect(unsafe)
(fn (getterCount cg)
  {
    (let lines (memGetWordVec (as cg Int) 0))
    (__load64 (as lines Int) -2)
  })

(:: lineAt (-> CG Int String))
;@axiom:effect(unsafe)
(fn (lineAt cg index)
  (as (__load64 (__load64 (__load64 (as cg Int) 0) 2) index) String))

(:: snapshotChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (snapshotChecks)
  {
    (let cg newCG)
    (let header (memGetWord (as cg Int) 0))
    (let initialCount (countOf header))
    (let source (strDup "alpha"))
    (emitLine cg source)
    (overwrite source 88)
    (say 1 (strEq (lineAt cg 0) "alpha"))
    (say 2 (== (countOf header) initialCount))
    (for i in 0..128
      (emitLine cg (concat "grow-" (fmtInt i))))
    (scopedLine cg)
    (say 3 (== (memGetWord (as cg Int) 0) header))
    (say 4 (== (countOf header) initialCount))
    (say 5 (strEq (lineAt cg 0) "alpha"))
    (say 6 (strEq (lineAt cg 129) "scope-73"))
    (let beforeGetter (countOf header))
    (say 7 (== (getterCount cg) (+ beforeGetter 1)))
    (say 8 (== (countOf header) beforeGetter))
    (say 9 (== (strLen (renderCG cg)) (joinSize (memGetWordVec (as cg Int) 0))))
  })

(:: allocaChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (allocaChecks)
  {
    (let cg newCG)
    (emitLine cg "define i64 @sample() #0 {")
    (openAllocaMark cg)
    (emitAlloca cg "%.a")
    (emitAlloca cg "%.b")
    (emitLine cg "  ret i64 0")
    (say 10 (== (memGetWord (memGetWord (as cg Int) 0) 3) 1))
    (closeAllocaMark cg)
    (say 11 (== (memGetWord (memGetWord (as cg Int) 0) 3) 1))
    (emitLine cg "}")
    (say 12
      (strEq (renderCG cg)
        "define i64 @sample() #0 {\n  %.a = alloca i64\n  %.b = alloca i64\n  ret i64 0\n}\n"))
  })

(:: pruningChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (pruningChecks)
  {
    (let cg newCG)
    (emitLine cg "define i64 @main() #0 {")
    (emitLine cg "  ret i64 17")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @dead() #0 {")
    (emitLine cg "  ret i64 99")
    (emitLine cg "}")
    (let old (memGetWord (as cg Int) 0))
    ; Keep one explicit share so observing the old header after replacement
    ; is valid even when the CG slot and temporary getter both retire.
    (__retain old)
    (let removed (lineAt cg 4))
    (let oldBefore (countOf old))
    (pruneDeadDefs cg)
    (say 13 (!= (memGetWord (as cg Int) 0) old))
    (say 14 (== (countOf old) (- oldBefore 1)))
    ; Pruning may hold additional String views; measure only the share
    ; released when the explicitly held old vector is finally destroyed.
    (let removedBefore (countOf (as removed Int)))
    (__release old)
    (say 15 (== (countOf (as removed Int)) (- removedBefore 1)))
    (say 16 (strEq removed "  ret i64 99"))
    (say 17 (strEq (renderCG cg) "define i64 @main() #0 {\n  ret i64 17\n}\n"))
  })

(:: hoistedGetterCount (-> CG Int))
;@axiom:effect(unsafe)
(fn (hoistedGetterCount cg)
  {
    (let value (probeHoisted cg))
    (__load64 (as value Int) -2)
  })

(:: hoistedChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (hoistedChecks)
  {
    (let cg newCG)
    (say 18 (== (countOf (memGetWord (as cg Int) 44)) 1))
    (say 19 (== (vecLen (probeHoisted cg)) 0))
    (let lines (memGetWord (as cg Int) 0))
    (let first (vecPush vecNew (strDup "73")))
    (let second (vecPush vecNew (strDup "91")))
    (let before (countOf (as first Int)))
    (probeSetHoisted cg first)
    (say 20 (== (countOf (as first Int)) (+ before 1)))
    (say 21 (== (memGetWord (as cg Int) 44) (as first Int)))
    (let beforeGetter (countOf (as first Int)))
    (say 22 (== (hoistedGetterCount cg) (+ beforeGetter 1)))
    (say 23 (== (countOf (as first Int)) beforeGetter))
    (let old (probeHoisted cg))
    (let beforeReplacement (countOf (as first Int)))
    (probeSetHoisted cg second)
    (say 24 (== (countOf (as first Int)) (- beforeReplacement 1)))
    (say 25 (strEq (vecGet old 0) "73"))
    (say 26 (&& (isNone cg.allocaMark) (== (memGetWord (as cg Int) 0) lines)))
    (say 27 (probeSameHoistedGetter cg "91"))
    (let beforeSame (countOf (as second Int)))
    (probeSetHoisted cg second)
    (say 28 (== (countOf (as second Int)) beforeSame))
    (let beforeEmpty (countOf (as second Int)))
    (probeSetHoisted cg vecNew)
    (say 29 (== (countOf (as second Int)) (- beforeEmpty 1)))
  })

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: hoistedOverwriteChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (hoistedOverwriteChecks)
  {
    (let cg newCG)
    (let first (vecPush vecNew (strDup "7")))
    (let second (vecPush vecNew (strDup "11")))
    (probeSetHoisted cg first)
    (let a (countOf (as first Int)))
    (let b (countOf (as second Int)))
    (let before (live))
    (for i in 0..1000
      {
        (probeSetHoisted cg second)
        (probeSetHoisted cg first)
      })
    (let growth (- (live) before))
    (say 30 (== (countOf (as first Int)) a))
    (say 31 (== (countOf (as second Int)) b))
    (say 32 (== growth 0))
    (say 33 (strEq (vecGet (probeHoisted cg) 0) "7"))
  })

(:: hoistedAllocaChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (hoistedAllocaChecks)
  {
    (let cg newCG)
    (set cg.pairState.threads 1)
    (cgSetRegistry cg 0)
    (let initial (memGetWord (as cg Int) 44))
    (closeAllocaMark cg)
    (say 34 (== (memGetWord (as cg Int) 44) initial))
    (emitLine cg "define i64 @held() #0 {")
    (openAllocaMark cg)
    (say 35
      (&&
        (match cg.allocaMark
          ((None) false)
          ((Some mark) (== mark 1)))
        (!= (memGetWord (as cg Int) 44) initial)))
    (let active (probeHoisted cg))
    (emitAlloca cg "%.a")
    (emitAlloca cg "%.b")
    (emitRecoverCell cg "%.recover" "8")
    (emitRegionCell cg "%.region")
    (say 36 (&& (== (vecLen active) 4) (== (countOf (as active Int)) 2)))
    (emitLine cg "  ret i64 0")
    (closeAllocaMark cg)
    (say 37
      (&& (== (countOf (as active Int)) 1)
        (&& (isNone cg.allocaMark) (== (countOf (memGetWord (as cg Int) 44)) 1))))
    (say 38
      (strEq (joinAllocas active)
        "  %.a = alloca i64\n  %.b = alloca i64\n  %.recover = alloca i64, i64 8, align 16\n  %.region = alloca i64, i64 3, align 16 ; axiom region mark"))
    (emitLine cg "}")
    (say 39
      (strEq (renderCG cg)
        "define i64 @held() #0 {\n  %.a = alloca i64\n  %.b = alloca i64\n  %.recover = alloca i64, i64 8, align 16\n  %.region = alloca i64, i64 3, align 16 ; axiom region mark\n  ret i64 0\n}\n"))
  })

; There is one active mark. A caller suspends it with a typed getter
; alias while a nested emission uses the context, then restores it.
(:: nestedHoistedChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (nestedHoistedChecks)
  {
    (let cg newCG)
    (emitLine cg "define i64 @nested() #0 {")
    (openAllocaMark cg)
    (emitAlloca cg "%.outer.a")
    (let mark cg.allocaMark)
    (let outer (probeHoisted cg))
    (openAllocaMark cg)
    (let mut balanced (== (countOf (as outer Int)) 1))
    (emitAlloca cg "%.inner")
    (closeAllocaMark cg)
    (set cg.allocaMark mark)
    (probeSetHoisted cg outer)
    (if (!= (countOf (as outer Int)) 2)
      (set balanced false))
    (emitAlloca cg "%.outer.b")
    (closeAllocaMark cg)
    (if (!= (countOf (as outer Int)) 1)
      (set balanced false))
    (say 40 balanced)
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (say 41
      (strEq (renderCG cg)
        "define i64 @nested() #0 {\n  %.outer.a = alloca i64\n  %.outer.b = alloca i64\n  %.inner = alloca i64\n  ret i64 0\n}\n"))
  })

(:: freshHoistedOverwrite (-> CG Int Int))
(fn (freshHoistedOverwrite cg i)
  {
    (let value (vecPush vecNew (concat "hoisted-" (fmtInt (+ i 1000)))))
    (probeSetHoisted cg value)
    0
  })

(:: hoistedOrdinaryGrowth Int)
;@axiom:effect(io)
(fn (hoistedOrdinaryGrowth)
  {
    (let cg newCG)
    (for i in 0..16
      (freshHoistedOverwrite cg i))
    (let before (live))
    (for i in 0..1000
      (freshHoistedOverwrite cg i))
    (let growth (- (live) before))
    (writeStr stderr (concat "hoisted-soak-growth " (concat (fmtInt growth) "\n")))
    growth
  })

(:: payloadChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (payloadChecks)
  {
    (let cg newCG)
    (set cg.pairState.threads 1)
    (cgSetRegistry cg 0)
    (openAllocaMark cg)
    (emitAlloca cg "%.payload")
    (emitRecoverCell cg "%.recover" "8")
    (emitRegionCell cg "%.region")
    (say 44 (vecOwnsRefs (probeHoisted cg)))
    ; Each producer has retired its ordinary String birth share. The
    ; queued element and this typed getter alias own one share each.
    (let alloca (vecGet (probeHoisted cg) 0))
    (let recover (vecGet (probeHoisted cg) 1))
    (let region (vecGet (probeHoisted cg) 2))
    (say 45
      (&& (== (countOf (as alloca Int)) 2)
        (&& (== (countOf (as recover Int)) 2) (== (countOf (as region Int)) 2))))
    (let before (countOf (as alloca Int)))
    (say 46 (== (probeHoistedPayloadCount cg 0) (+ before 1)))
    (say 47 (== (countOf (as alloca Int)) before))
    (let expected
      "  %.payload = alloca i64\n  %.recover = alloca i64, i64 8, align 16\n  %.region = alloca i64, i64 3, align 16 ; axiom region mark")
    (say 48
      (&& (== (joinAllocasSize (probeHoisted cg) 0 0) (strLen expected))
        (&& (== (countOf (as alloca Int)) 2)
          (&& (== (countOf (as recover Int)) 2) (== (countOf (as region Int)) 2)))))
    (say 49
      (&& (strEq (joinAllocas (probeHoisted cg)) expected)
        (&& (== (countOf (as alloca Int)) 2)
          (&& (== (countOf (as recover Int)) 2) (== (countOf (as region Int)) 2)))))
    (say 50 (== (countOf (memGetWord (as cg Int) 44)) 1))
    (closeAllocaMark cg)
    (say 51
      (&& (== (countOf (as alloca Int)) 1)
        (&& (== (countOf (as recover Int)) 1) (== (countOf (as region Int)) 1))))
    (say 52
      (&& (strEq alloca "  %.payload = alloca i64")
        (&& (strEq recover "  %.recover = alloca i64, i64 8, align 16")
          (strEq region "  %.region = alloca i64, i64 3, align 16 ; axiom region mark"))))
    (say 53 (== hoistedPayloadGrowth 0))
    (let direct newCG)
    (set direct.pairState.threads 1)
    (cgSetRegistry direct 0)
    (emitAlloca direct "%.direct")
    (emitRecoverCell direct "%.recover" "8")
    (emitRegionCell direct "%.region")
    (say 54
      (&& (== (vecLen (probeHoisted direct)) 0)
        (strEq (renderCG direct)
          "  %.direct = alloca i64\n  %.recover = alloca i64, i64 8, align 16\n  %.region = alloca i64, i64 3, align 16 ; axiom region mark\n")))
    (say 55 (== directPayloadGrowth 0))
    (let registered newCG)
    (cgSetRegistry registered 1)
    (emitRegionCell registered "%.registered")
    (say 56
      (&& (== (vecLen (probeHoisted registered)) 0)
        (strEq (renderCG registered)
          "  %.registered = alloca i64, i64 4, align 16 ; axiom region mark\n")))
    (say 57
      (&& (strEq (joinAllocas (probeHoisted cg)) "")
        (== (joinAllocasSize (probeHoisted cg) 0 0) 0)))
  })

; Reuse one context and clear its rendered lines, so retained output is
; not confused with an ordinary producer or getter share that escaped.
(:: payloadIteration (-> CG Int Bool Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (payloadIteration cg i hoist)
  {
    (if hoist
      (openAllocaMark cg))
    (emitAlloca cg (concat "%.a." (fmtInt (+ i 1000))))
    (emitRecoverCell cg "%.recover" "8")
    (emitRegionCell cg "%.region")
    (if hoist
      (closeAllocaMark cg))
    (vecClear (memGetWordVec (as cg Int) 0))
    0
  })

(:: payloadGrowth (-> Bool Int))
;@axiom:effect(io)
(fn (payloadGrowth hoist)
  {
    (let cg newCG)
    (for i in 0..16
      (payloadIteration cg i hoist))
    (let before (live))
    (for i in 0..1000
      (payloadIteration cg i hoist))
    (- (live) before)
  })

(:: hoistedPayloadGrowth Int)
;@axiom:effect(io)
(fn (hoistedPayloadGrowth)
  {
    (let growth (payloadGrowth true))
    (writeStr stderr (concat "hoisted-payload-soak-growth " (concat (fmtInt growth) "\n")))
    growth
  })

(:: directPayloadGrowth Int)
;@axiom:effect(io)
(fn (directPayloadGrowth)
  {
    (let growth (payloadGrowth false))
    (writeStr stderr (concat "direct-payload-soak-growth " (concat (fmtInt growth) "\n")))
    growth
  })

; Each typed CG field acquires exactly one replacement header share.
(:: replacementShareChecks ())
;@axiom:effect(io)
(fn (replacementShareChecks)
  {
    (let cg newCG)
    (for slot in 0..4
      {
        (let value (vecPush vecNew (strDup "replacement")))
        (let before (probeCount value))
        (probeSetCGVector cg value slot)
        (say (+ 58 slot) (== (probeCount value) (+ before 1)))
      })
    (say 62 (probeCGTailShare cg))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    snapshotChecks
    allocaChecks
    pruningChecks
    hoistedChecks
    hoistedOverwriteChecks
    hoistedAllocaChecks
    nestedHoistedChecks
    (say 42 (== hoistedOrdinaryGrowth 0))
    ; Only allocator counts are read after an ablated release-first
    ; setter may have filed the raw ordering descriptor.
    (say 43 probeSoleHoistedSame)
    payloadChecks
    replacementShareChecks
    0
  })
