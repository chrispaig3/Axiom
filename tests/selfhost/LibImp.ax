; The macros of `391-macro-imported-name.ax`. Every template here
; names something this module can SEE but does not DECLARE, except
; `both`, which it declares and imports at once.
(import HelpImp)

(import MidImp)

(pub :: both (-> Int Int))

(pub fn (both n) (+ n 2))

; An imported name. `HelpImp$tenTimes` is the meaning here; a `let` or
; a declaration of `tenTimes` at the invocation is not.
(pub macro (useImported v) (tenTimes v))

; Declared here AND imported. The macro's own module wins.
(pub macro (useBoth v) (both v))

; `DeepImp` is imported by `MidImp`, not by this module.
(pub macro (useDeep v) (deepFn v))
