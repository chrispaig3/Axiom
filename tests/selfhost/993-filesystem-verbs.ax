; expect 77
; The verbs `IO` was missing after `992-filesystem` filled in mkdir
; and rmdir: append, rename, and the two questions that separate a
; directory and an empty file from a file that is not there.
;
; Same discipline as 992 - these are ROUND TRIPS, not status checks. A
; syscall number for something else entirely can return 0; what it
; cannot do is leave the filesystem in the state the call claims. So
; every verb here is followed by the observation that proves it
; happened, and the fixture removes what it made.
;
; The three targets this host cannot execute are covered the way every
; other syscall here is: `check-cross-targets.sh` assembles all four
; from one host, and the numbers sit in the per-target module beside
; the ones already proven.
(import IO)
(import Err)
(import Str)

; The errno behind a failed rename, or 0 when it succeeded.
(:: renameCode (-> String String Int))
;@axiom:effect(io)
(fn (renameCode a b)
  (match (renamePath a b)
    ((Ok v) 0)
    ((Err e) (errCode e))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  ; --- append -----------------------------------------------------
  ; It CREATES when the file is absent, which is what makes an
  ; append-only log usable with no setup step, and it does not
  ; truncate on the second call - the property `writeFile`
  ; cannot be talked into having.
  (let (
    (f "ax993_a")
    (g "ax993_b")
    (d "ax993_d")
    (gone "ax993_missing")
    (mut n 0)
  )
    {
      (if (== (unwrapOr (appendFile f "one\n") 0) 4)
        (set n (+ n 1))
        0)
      (if (== (unwrapOr (fileSize f) 0) 4)
        (set n (+ n 1))
        0)
      (if (== (unwrapOr (appendFile f "two\n") 0) 4)
        (set n (+ n 1))
        0)
      (if (== (unwrapOr (fileSize f) 0) 8)
        (set n (+ n 1))
        0)
      (if (strEq (readFile f) "one\ntwo\n")
        (set n (+ n 1))
        0)
      ; and the contrast that makes the pair worth having
      (if (== (unwrapOr (writeFile f "1") 0) 1)
        (set n (+ n 1))
        0)
      (if (== (unwrapOr (fileSize f) 0) 1)
        (set n (+ n 1))
        0)
      ; --- rename -----------------------------------------------------
      ; The destination gains the bytes AND the source stops existing.
      ; Checking only the first would pass for a copy.
      (if (isOk (renamePath f g))
        (set n (+ n 1))
        0)
      (if (fileExists f)
        0
        (set n (+ n 1)))
      (if (strEq (readFile g) "1")
        (set n (+ n 1))
        0)
      ; A missing source is refused rather than silently creating an
      ; empty destination. ENOENT is `Error.code` now, not a negated
      ; return: the failure and the answer stopped being the same Int.
      (if (== (renameCode gone f) 2)
        (set n (+ n 1))
        0)
      (if (fileExists f)
        0
        (set n (+ n 1)))
      ; --- the three facts a read collapses ---------------------------
      ; `readFile` answers "" for a missing file, an EMPTY file and
      ; a DIRECTORY alike. These six lines are the whole reason
      ; `readErrno` exists, and they are checked against a directory
      ; and an empty file that this fixture makes, so the answers do
      ; not depend on where it was run from.
      (unwrapOr (makeDir d) 0)
      (unwrapOr (writeFile f "") 0)
      (if (== (readErrno g) 0)
        (set n (+ n 1))
        0)
      (if (== (readErrno d) 21)
        (set n (+ n 1))
        0)
      (if (== (readErrno gone) 2)
        (set n (+ n 1))
        0)
      ; an EMPTY file is readable - it reads back "" like the other two
      ; and is not an error, which is the case that used to be reported
      ; as a missing file
      (if (== (readErrno f) 0)
        (set n (+ n 1))
        0)
      (if (== (strLen (readFile f)) 0)
        (set n (+ n 1))
        0)
      ; `unwrapOr ... 0` here would count a FAILURE as a success: the
      ; expected size is 0 and the fallback is 0, so the two become
      ; indistinguishable. The arms keep them apart.
      (if (match (fileSize f)
        ((Ok v) (== v 0))
        ((Err e) false))
        (set n (+ n 1))
        0)
      ; --- is it a directory ------------------------------------------
      ; `fileExists` answers true for BOTH a file and a directory,
      ; so on its own it cannot tell them apart. Checked here in all
      ; three states, because a predicate that answered `true` always
      ; would satisfy the first line alone.
      (if (isDir d)
        (set n (+ n 1))
        0)
      (if (isDir f)
        0
        (set n (+ n 1)))
      (if (isDir gone)
        0
        (set n (+ n 1)))
      (if (fileExists d)
        (set n (+ n 1))
        0)
      (if (fileExists f)
        (set n (+ n 1))
        0)
      ; --- the working directory --------------------------------------
      ; Its value is the machine's, so this checks the SHAPE: an
      ; absolute, non-empty path. On Darwin it comes back through
      ; `fcntl(F_GETPATH)` because that platform has no `getcwd`
      ; syscall at all - a difference nothing above `Sys` can see.
      ; It answers `(Result String Error)` since ERR-ADOPT-1 slice 4,
      ; so the FIRST thing checked is that it succeeded at all - which
      ; the `""` sentinel could not distinguish from a working
      ; directory named by the empty string.
      (if (isOk cwd)
        (set n (+ n 1))
        0)
      (if (> (strLen (unwrapOr cwd "")) 0)
        (set n (+ n 1))
        0)
      (if (== (strByte (unwrapOr cwd "") 0) 47)
        (set n (+ n 1))
        0)
      ; and it names a real directory - this one
      (if (isDir (unwrapOr cwd ""))
        (set n (+ n 1))
        0)
      ; --- teardown ----------------------------------------------------
      (if (isOk (removeFile f))
        (set n (+ n 1))
        0)
      (if (isOk (removeFile g))
        (set n (+ n 1))
        0)
      (if (isOk (removeDir d))
        (set n (+ n 1))
        0)
      (if (fileExists d)
        0
        (set n (+ n 1)))
      (if (== n 31)
        77
        1)
    }))
