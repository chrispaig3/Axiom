(import core)
(import lexer)
(import parser)
(import lsp)
(import jsonrpc)
(import Vec)
(import Str)
(import IO)

(:: parsed (-> String Nodes))
(fn (parsed source)
  (match (parseModule (lex source))
    ((ParseFailed _) __indexTrap)
    ((ParseSuccess nodes _) nodes)))

(:: at (-> String String Int))
(fn (at source needle)
  (match (strFind source needle 0)
    ((None) __indexTrap)
    ((Some n) n)))

(:: unit (-> (Option String) String String CUnit2))
(fn (unit name path source)
  (CUnit2 :file path :src source :name name :imports vecNew :library false))

(:: idx (-> (Option Int) (Option Int) Bool))
(fn (idx got want)
  (match want
    ((None) (isNone got))
    ((Some wanted)
      (match got
        ((None) false)
        ((Some found) (== found wanted)))
    )))

(:: uriIs (-> (Option String) String Bool))
(fn (uriIs got want)
  (match got
    ((None) false)
    ((Some found) (strEq found want))))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n ok)
  (println "{n} {ok}"))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let mainUri "file:///tmp/axiom-module-options/Main.ax")
    (let peerUri "file:///tmp/axiom-module-options/Peer.ax")
    (let path "/tmp/axiom-module-options/Main.ax")
    (let source "(import Peer)\n(fn (use) (make 1))")
    (let peer "(pub data Choice (Stop))\n(pub :: make (-> Int Choice))\n(pub fn (make x) Stop)")
    (let uris (vecPush (vecPush vecNew mainUri) peerUri))
    (let texts (vecPush (vecPush vecNew source) peer))
    (let workspace
      (lspWorkspaceNew uris texts (vecPush (vecPush (vecPush (vecPush vecNew 1) 1) 1) 1)))
    (let units
      (vecPush
        (vecPush
          (vecPush (vecPush vecNew (unit (Some "Peer") path source))
            (unit (Some "Peer") "/tmp/axiom-module-options/Peer.ax" peer))
          (unit (Some "") "empty.ax" ""))
        (unit (Some "Peer") "duplicate.ax" peer)))
    (let declared (parsed source))
    (let namedDecl (vecGet (parsed "(fn (value) 1)") 0))
    (writeNodeText namedDecl 8 "Peer")
    (let emptyDecl (vecGet (parsed "(fn (empty) 1)") 0))
    (writeNodeText emptyDecl 8 "")
    (let unstamped (vecGet (parsed "(fn (unstamped) 1)") 0))
    (let function (vecGet (parsed peer) 2))
    (writeNodeText function 1 "Peer$make")
    (writeNodeText function 8 "Peer")
    (let signature (vecGet (parsed peer) 1))
    (writeNodeText signature 1 "Peer$make")
    (writeNodeText signature 8 "Peer")
    (let dataDecl (vecGet (parsed peer) 0))
    (writeNodeText dataDecl 1 "Peer$Choice")
    (writeNodeText dataDecl 8 "Peer")
    (let all (vecPush (vecPush (vecPush vecNew function) signature) dataDecl))
    (let resolved (LspResolved :decls all :units units :bares vecNew :fulls vecNew :mods vecNew))
    (say 1 (idx (lspUnitOf units None) None))
    (say 2 (idx (lspUnitOf units (Some "Peer")) (Some 1)))
    (say 3 (idx (lspUnitOf units (Some "")) (Some 2)))
    (say 4 (idx (lspUnitOf units (Some "missing")) None))
    (say 5 (idx (lspUnitOf vecNew (Some "Peer")) None))
    (say 6 (idx (lspUnitNamed units "Peer") (Some 1)))
    (say 7 (idx (lspUnitNamed units "") (Some 2)))
    (say 8 (idx (lspUnitNamed units "missing") None))
    (say 9 (idx (lspUnitNamed vecNew "") None))
    (say 10 (idx (lspUnitOf (vecPush vecNew (unit (Some "Peer") "main.ax" "")) (Some "Peer")) None))
    (say 11 (idx (lspUnitNamed (vecPush vecNew (unit (Some "Peer") "main.ax" "")) "Peer") None))
    (say 12 (idx (lspUnitOf units (nodeModuleOpt namedDecl)) (Some 1)))
    (say 13 (idx (lspUnitOf units (nodeModuleOpt emptyDecl)) (Some 2)))
    (say 14 (idx (lspUnitOf units (nodeModuleOpt unstamped)) None))
    (say 15 (idx (lspUnitOf units (Some (concat "Pe" "er"))) (Some 1)))
    (say 16 (uriIs (lspNavHomeUri workspace path source declared "make" uris) peerUri))
    (say 17 (isNone (lspNavHomeUri workspace path source declared "missing" uris)))
    (say 18 (isNone (lspNavHomeUri workspace path source declared "make" (vecPush vecNew mainUri))))
    (say 19 (isNone (lspNavHomeUri workspace path source declared "use" uris)))
    (say 20 (! (jsonIsNull (lspUnitLocation units namedDecl))))
    (say 21 (jsonIsNull (lspUnitLocation units unstamped)))
    (say 22 (jsonIsNull (lspUnitLocation vecNew namedDecl)))
    (say 23 (jsonIsNull (lspUnitLocation units nilNode)))
    (say 24 (!= (lspChImportedItem resolved "make") 0))
    (say 25 (== (lspChImportedItem resolved "missing") 0))
    (say 26 (!= (lspThImportedItem resolved "Choice") 0))
    (say 27 (== (lspThImportedItem resolved "missing") 0))
    (say 28 (! (jsonIsNull (lspCtorDefinitionImported all units "Stop"))))
    (say 29 (jsonIsNull (lspCtorDefinitionImported all vecNew "Stop")))
    (say 30 (! (jsonIsNull (lspHoverCtorImported all units "Stop" jsonObj))))
    (say 31 (jsonIsNull (lspHoverCtorImported all vecNew "Stop" jsonObj)))
    (say 32 (! (jsonIsNull (lspTypeCtorImported all units "Stop"))))
    (say 33 (jsonIsNull (lspTypeCtorImported all vecNew "Stop")))
    0
  })
