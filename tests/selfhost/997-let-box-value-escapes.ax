; expect 42
; A reference taken OUT of a let-bound block - by destructuring
; `match`, by a field read, or by a field read through a `let` alias -
; and answered as the function's value must outlive the block.
;
; Until 2026-08-21 the let released its direct construction at scope
; end whenever the walker saw the name only as the object of a field
; read or a match, on the ground that "a read answers a field, never
; the block". But a reference field's share belongs to the block, and
; the block's death releases it: the function returned a string the
; allocator had already reclaimed. Measured by the QA sweep on
; `viaMatch` - six NUL bytes where `id-one` should have been - and
; reproduced here in the two other spellings before the fix. The
; walker (`escapes`) now treats a field read in value position and a
; match binder reaching the arm's value as the binding escaping, and
; the block is kept (leaked, the documented safe direction).
;
; `held` is the half that makes this case discriminate. A dangling
; reference still READS the old bytes until something else is
; allocated over them, and `==` allocates nothing - so a compare
; straight after the call passed on the broken compiler, 1 for 1 with
; the fixed one, while `println` of the same value printed NULs. The
; three `strConcat`s stand in for whatever the next allocation would
; have been. Each helper answers a string `strConcat` built, so
; nothing here is an interned literal that would survive by accident.
;
; Four more spellings, found by trying to refute the first three:
; the binder stashed by `set` from a match in STATEMENT position
; (`viaSet`), a closure over it stored the same way (`viaLambda`), the
; binder handed to a function that answers its argument - event 2's
; retain-on-return is not shipped, so the callee hands back what it
; was given (`viaIdent`) - and the binder wrapped into a polymorphic
; constructor, whose tyvar field takes no share without an evidence
; stamp (`viaWrap`). Each is the walker's argument- or
; statement-position permission taken at its word, and each now
; escapes too. The eighth, `viaShadow`, is the permission's own
; escape hatch: a function signed to answer a machine scalar cannot
; hand the block back, so `(total b)` may release `b` - unless `total`
; is a PARAMETER that merely shares the global's name, which the
; second refutation pass found being trusted on the global's word.
;
; Eight correct strings answer 42; fewer answer how many survived,
; which is never 42.
(import Str)

(data Box a
  (Mk a))

(pub struct S
  (f : String))

(:: viaMatch (-> String String))

(fn (viaMatch t)
  (let ((b (Mk (strConcat "id-" t))))
    (match b
      ((Mk s) s)
    )
  )
)

(:: viaField (-> String String))

(fn (viaField t)
  (let ((b (S (strConcat "id-" t))))
    b.f
  )
)

(:: viaAlias (-> String String))

(fn (viaAlias t)
  (let ((b (S (strConcat "id-" t))))
    (let ((x b.f))
      x
    )
  )
)

(:: viaSet (-> String String))

(fn (viaSet t)
  (let ((mut r "none"))
    (let ((b (Mk (strConcat "id-" t))))
      {
        (match b
          ((Mk s)
            (set r s)
          )
        )
        r
      }
    )
  )
)

(:: viaLambda (-> String String))

(fn (viaLambda t)
  (let ((mut g 
    (lambda (i) "none")
  ))
    (let ((b (Mk (strConcat "id-" t))))
      {
        (match b
          ((Mk s)
            (set g (lambda (i) s))
          )
        )
        (g 0)
      }
    )
  )
)

(:: ident (-> String String))

(fn (ident s) s)

(:: viaIdent (-> String String))

(fn (viaIdent t)
  (let ((b (Mk (strConcat "id-" t))))
    (match b
      ((Mk s) (ident s))
    )
  )
)

(:: unbox (-> (Box String) String))

(fn (unbox b)
  (match b
    ((Mk s) s)
  )
)

(:: viaWrap (-> String String))

(fn (viaWrap t)
  (unbox
    (let ((b (Mk (strConcat "id-" t))))
      (match b
        ((Mk s) (Mk s))
      )
    )
  )
)

(:: total (-> (Box String) Int))

(fn (total b) 1)

(:: viaShadow (-> (-> (Box String) (Box String)) String String))

(fn (viaShadow total t)
  (unbox
    (let ((b (Mk (strConcat "id-" t))))
      (total b)
    )
  )
)

(:: held (-> String String Int))

(fn (held got want)
  (let (
    (a (strConcat "......" "......"))
    (b (strConcat "......" "......"))
    (c (strConcat "......" "......"))
  )
    (if (== got want)
      1
      0
    )
  )
)

(:: main Int)

(fn (main)
  (let ((n 
    (+
      (+ (+ (held (viaMatch "one") "id-one") (held (viaField "two") "id-two")) (+ (held (viaAlias "three") "id-three") (held (viaSet "four") "id-four")))      (+
        (+ (held (viaLambda "five") "id-five") (held (viaIdent "six") "id-six"))        (+
          (held (viaWrap "seven") "id-seven")          (held
            (viaShadow
              (lambda (x) x)              "eight"
            )            "id-eight"
          )
        )
      )
    )
  ))
    (if (== n 8)
      42
      n
    )
  )
)
