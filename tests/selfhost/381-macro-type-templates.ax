; expect 32
; MAC-CAP-7 made real: a macro that generates TYPE declarations.
; `MAC-CAP-8`'s v1 template surface was `fn`, `::`, `impl`, a further
; invocation and a syntax/for over them; `data` and `struct` were
; AX3021 at the macro's own line. They are templates now, which is
; what "type-level macro" means in this language - generating type
; and instance declarations keyed on declared types, never computing
; with types (MAC-CAP-7's own sentence).
;
; Three things this pins beyond "it parses":
;
;   - a constructor's name is a NAME POSITION, so `(syntax/join Off
;     N)` names one. That needed the parser: a constructor list is
;     read where a type-PARAMETER list could stand, and the test for
;     which is "does the first inner identifier start uppercase" -
;     `syntax/join` does not, so `((syntax/join Off N))` was read as
;     a parameter list and collected `syntax/join`, `Off` and `N` as
;     three type variables. The reserved prefix declines it now.
;   - two invocations of one macro generate two DISTINCT types, which
;     is the whole point of naming by join rather than by fixed name.
;   - a generated type is queryable in the SAME phase-D round that
;     generated it: `(deriveEq Mode)` reads `syntax/constructors` off
;     a `data` that `(defFlag Mode)` appended moments earlier,
;     because a generated declaration joins the merged list the
;     queries read.
;
;   20  eqMode OffMode OffMode - derived equality over a generated
;       type, both constructors generated by join
;    0  eqMode OffMode OnMode - and it discriminates
;    5  eqLevel OnLevel OnLevel - the second invocation's type is its
;       own, not a redefinition of the first
;    7  spanBounds (Bounds 3 10) - a generated STRUCT, its field
;       types substituted from the macro's argument, read back
;       through ordinary field access by a generated function
;
; The unfixed compiler does not reach AX3021 at all: it stops at the
; PARSER, `AX2001 expected identifier, found (` on the first joined
; constructor name, exit 1. The template-kind refusal was the second
; gate, not the first.
(import Pre)

(macro defFlag ((defFlag N)
   (data N ((syntax/join Off N)) ((syntax/join On N)))))

(macro defRange ((defRange N E)
   (struct N (lo : E) (hi : E))
   (:: (syntax/join span N) (-> N E))
   (fn ((syntax/join span N) p) (- p.hi p.lo))))

(defFlag Mode)

(defFlag Level)

(deriveEq Mode)

(deriveEq Level)

(defRange Bounds Int)

(:: b2i (-> Bool Int))

(fn (b2i x)
  (if x
    1
    0
  )
)

(:: main Int)

(fn (main)
  (+
    (* 20 (b2i (eqMode OffMode OffMode)))    (+
      (* 10 (b2i (eqMode OffMode OnMode)))      (+
        (* 5 (b2i (eqLevel OnLevel OnLevel)))        (spanBounds
          (struct Bounds 3 10)
        )
      )
    )
  )
)
