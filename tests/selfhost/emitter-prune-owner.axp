; The runner supplies typed probes in its private codegen module copy.
(import codegen)
(import Intern)
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Mem)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: inputCG CG)
(fn (inputCG)
  {
    (let cg newCG)
    (emitLine cg "; nonsymbol")
    (emitLine cg "define i64 @main() {")
    (emitLine cg "entry:")
    (emitLine cg "  %v = call i64 @used()")
    (emitLine cg "  ret i64 %v")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @used() {")
    (emitLine cg "  ret i64 7")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @dead() {")
    (emitLine cg "  ret i64 99")
    (emitLine cg "}")
    (emitLine cg "@private_dead = private constant i64 1")
    (emitLine cg "@root = global ptr @\"quoted name\"")
    (emitLine cg "define internal i64 @\"quoted name\"() {")
    (emitLine cg "  ret i64 3")
    (emitLine cg "}")
    (emitLine cg "@multi = private constant [2 x i64] [")
    (emitLine cg "  i64 1,")
    (emitLine cg "  i64 2")
    (emitLine cg "]")
    (emitLine cg "@multi_ref = global ptr @multi")
    (emitLine cg "; trailing comment")
    cg
  })

(:: indexRoundtrip (-> Strings Int))
(fn (indexRoundtrip lines)
  {
    (let owner internNewTyped)
    (let si owner)
    (let ids vecNew)
    (let starts vecNew)
    (let ends vecNew)
    (let marked vecNew)
    (let definitions vecNew)
    (pruneIndexDefs lines si ids starts ends marked definitions)
    (+ (internCount si) (vecLen starts))
  })

(:: keptSymbol (-> Strings String))
(fn (keptSymbol lines)
  {
    (let owner internNewTyped)
    (let si owner)
    (pruneIndexDefs lines si vecNew vecNew vecNew vecNew vecNew)
    (internLookup si 4)
  })

(:: graphChecks ())
;@axiom:effect(io)
(fn (graphChecks)
  {
    (let cg inputCG)
    (let lines (probeLines cg))
    (let owner internNewTyped)
    (let si owner)
    (let ids vecNew)
    (let starts vecNew)
    (let ends vecNew)
    (let marked vecNew)
    (let definitions vecNew)
    (pruneIndexDefs lines si ids starts ends marked definitions)
    (emitNumbers "ids" ids)
    (emitNumbers "starts" starts)
    (emitNumbers "ends" ends)
    (emitNumbers "initial-live" marked)
    (emitNumbers "definitions" definitions)
    (for j in 0..(internCount si)
      (writeStr stderr (concat "name:" (concat (internLookup si j) "\n"))))
    (say 1 (== (internCount si) 6))
    (say 2 (&& (== (vecLen starts) 6) (== (vecLen definitions) 23)))
    (say 3 (&& (== (vecGet starts 0) 1) (== (vecGet ends 0) 5)))
    (say 4 (&& (== (vecGet starts 3) 12) (== (vecGet ends 3) 12)))
    (say 5 (&& (== (vecGet starts 5) 17) (== (vecGet ends 5) 20)))
    (say 6 (&& (== (vecGet definitions 13) 0) (== (vecGet definitions 18) 6)))
    (say 7 (strEq (internLookup si 4) "\"quoted name\""))
    (let ctx (pruneCtxNew si ids marked vecNew))
    (pruneMark ctx "main")
    (for i in 0..(vecLen lines)
      (if (== (vecGet definitions i) 0)
        (pruneScanLine ctx (probeLineAt lines i))))
    (pruneWalk ctx lines starts ends)
    (emitNumbers "live" marked)
    (say 8 (&& (== (vecGet marked 0) 1) (== (vecGet marked 1) 1)))
    (say 9 (&& (== (vecGet marked 2) 0) (== (vecGet marked 3) 0)))
    (say 10 (&& (== (vecGet marked 4) 1) (== (vecGet marked 5) 1)))
    (let out (pruneRebuild lines definitions marked))
    (emitRows out)
    (say 11 (== (vecLen out) 19))
    (say 12 (strEq (vecGet out 0) "; nonsymbol"))
    (let kept (keptSymbol lines))
    (say 13 (strEq kept "\"quoted name\""))
    (say 14 (== (probeStringCount kept) 1))
  })

(:: productionChecks ())
;@axiom:effect(io)
(fn (productionChecks)
  {
    (let cg inputCG)
    (let alias (probeLineAt (probeLines cg) 9))
    (let view (strSlice alias 0 (strLen alias)))
    (pruneDeadDefs cg)
    (say 15 (== (vecLen (probeLines cg)) 19))
    (let rendered (renderCG cg))
    (say 16 (== (strHasSub rendered "@used") 1))
    (say 17 (== (strHasSub rendered "@dead") 0))
    (say 18 (== (strHasSub rendered "@private_dead") 0))
    (say 19 (== (strHasSub rendered "@\"quoted name\"") 1))
    (say 20 (== (strHasSub rendered "@multi = private") 1))
    (say 21 (strEq alias "define internal i64 @dead() {"))
    (say 22 (strEq view "define internal i64 @dead() {"))
  })

(:: soakChecks ())
;@axiom:effect(io)
(fn (soakChecks)
  {
    ; Raw CG constructors stay outside every measured loop.
    (let cg inputCG)
    (let lines (probeLines cg))
    (indexRoundtrip lines)
    (let before live)
    (let mut total 0)
    (for i in 0..1000
      (set total (+ total (indexRoundtrip lines))))
    (let growth (- live before))
    (say 23 (== total 12000))
    (say 24 (strEq (probeLineAt lines 14) "define internal i64 @\"quoted name\"() {"))
    ; Remaining packed buffers are outside these scoped ownership changes.
    ; Report whole-pruner retention without treating it as a zero-growth claim.
    (let complete inputCG)
    (pruneDeadDefs complete)
    (let fullBefore live)
    (for i in 0..1000
      (pruneDeadDefs complete))
    (let fullGrowth (- live fullBefore))
    (say 25 (== (vecLen (probeLines complete)) 19))
    (writeStr stderr
      (concat "prune-soak-growth "
        (concat (fmtInt growth) (concat " " (concat (fmtInt fullGrowth) "\n")))))
  })

(:: largeChecks ())
;@axiom:effect(io)
(fn (largeChecks)
  {
    (let cg newCG)
    (emitLine cg "define i64 @main() {")
    (emitLine cg "  %v = call i64 @f299()")
    (emitLine cg "  ret i64 %v")
    (emitLine cg "}")
    (for i in 0..300
      {
        (emitLine cg (concat "define internal i64 @f" (concat (fmtInt i) "() {")))
        (if (== i 0)
          (emitLine cg "  ret i64 7")
          {
            (emitLine cg (concat "  %v = call i64 @f" (concat (fmtInt (- i 1)) "()")))
            (emitLine cg "  ret i64 %v")
          })
        (emitLine cg "}")
      })
    (emitLine cg "@unreachable = private constant i64 99")
    (pruneDeadDefs cg)
    (say 26 (== (vecLen (probeLines cg)) 1203))
    (let rendered (renderCG cg))
    (say 27 (&& (== (strHasSub rendered "@f0()") 1) (== (strHasSub rendered "@f299()") 1)))
    (say 28 (== (strHasSub rendered "@unreachable") 0))
  })

(:: staticChecks ())
;@axiom:effect(io)
(fn (staticChecks)
  {
    (let cg inputCG)
    (let before (renderCG cg))
    (let result (pruneDeadDefs cg))
    (say 1 (addrEq (addrOf result) (addrOf cg)))
    (say 2 (== (vecLen (probeLines cg)) 23))
    (say 3 (strEq (renderCG cg) before))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (if cgStaticlib
      (staticChecks)
      {
        (graphChecks)
        (productionChecks)
        (soakChecks)
        (largeChecks)
        (cursorHeaderChecks)
      })
    0
  })

(:: emitNumbers (-> String Ints ()))
;@axiom:effect(io)
(fn (emitNumbers label values)
  {
    (writeStr stderr (concat label ":"))
    (for i in 0..(vecLen values)
      (writeStr stderr (concat " " (fmtInt (vecGet values i)))))
    (writeStr stderr "\n")
  })

(:: emitRows (-> (Vec String) ()))
;@axiom:effect(io)
(fn (emitRows rows)
  (for i in 0..(vecLen rows)
    (writeStr stderr (concat "row:" (concat (vecGet rows i) "\n")))))

(:: lineCounts (-> Strings Ints))
(fn (lineCounts lines)
  {
    (let values vecNew)
    (for i in 0..(vecLen lines)
      (vecPush values (probeLineHeaderCount lines i)))
    values
  })

(:: sameLineCounts (-> Strings Ints Bool))
(fn (sameLineCounts lines before)
  {
    (let mut same true)
    (for i in 0..(vecLen lines)
      (if (!= (probeLineHeaderCount lines i) (vecGet before i))
        (set same false)))
    same
  })

(:: cursorHeaderChecks ())
;@axiom:effect(io)
(fn (cursorHeaderChecks)
  {
    (let cg inputCG)
    (let lines (probeLines cg))
    (let before (lineCounts lines))
    (let owner internNewTyped)
    (let si owner)
    (pruneIndexDefs lines si vecNew vecNew vecNew vecNew vecNew)
    (say 29 (== (probeLineHeaderCount lines 0) (vecGet before 0)))
    (say 30 (== (probeLineHeaderCount lines 1) (vecGet before 1)))
    (say 31 (== (probeLineHeaderCount lines 14) (vecGet before 14)))
    (say 32 (== (probeLineHeaderCount lines 18) (vecGet before 18)))
    (say 33 (sameLineCounts lines before))
    (for i in 0..1000
      (indexRoundtrip lines))
    (say 34 (sameLineCounts lines before))
  })
