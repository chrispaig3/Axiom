; expect 42
; Traits, dispatched on the type of an argument. Until 2026-08-10 the
; README called them **Complete** and `impl` was consumed as an inert
; node by name: its body was never checked, and the README's own
; example - this file's first two declarations, verbatim - failed with
; `AX3001 undefined variable eq` on its first use, because a trait
; method was bound to nothing anywhere.
;
; An `impl` now lowers to ordinary declarations named `Trait#Type#method`,
; and a call whose dispatch argument has that type is rewritten to name
; one. So dispatch is resolved at compile time and costs a direct call.
;
;   (eq 3 3)        the `Eq Int` implementation
;   (eq true true)  the `Eq Bool` one, from the same call site spelling -
;                   this is the term that fails if dispatch picks the
;                   first implementation rather than the argument's type
;   (ne 1 2)        a second method on the same trait
;   (shows 7)       a trait whose method returns something other than
;                   its own type parameter, so the dispatch position is
;                   found rather than assumed
(trait (Eq a) where (
  eq :: (-> a a Bool)
  ne :: (-> a a Bool)
))

(trait (Show a) where (
  shows :: (-> a Int)
))

(impl (Eq Int) where (
  (eq
    (lambda (x y) (== x y))
  )
  (ne
    (lambda (x y)
      (if (== x y)
        false
        true
      )
    )
  )
))

(impl (Eq Bool) where (
  (eq
    (lambda (x y)
      (if x
        y
        (if y
          false
          true
        )
      )
    )
  )
  (ne
    (lambda (x y)
      (if x
        (if y
          false
          true
        )
        y
      )
    )
  )
))

(impl (Show Int) where (
  (shows
    (lambda (n) (* n 6))
  )
))

(:: main Int)

(fn (main)
  (if (&&
    (&&
      (eq 3 3)      (if (eq 3 4)
        false
        true
      )
    )    (&& (&& (eq true true) (ne true false)) (&& (ne 1 2) (== (shows 7) 42)))
  )
    42
    1
  )
)
