(import core)
(import lsp)
(import Host)
(import codegen)
(import lexer)
(import parser)
(import diag)
(import Cereal)
(import Str)
(import Vec)
(import IO)
(import Err)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say number good)
  (println "{number} {good}"))

(:: textIs (-> (Option String) (Option String) Bool))
(fn (textIs actual expected)
  (match expected
    ((None) (isNone actual))
    ((Some want)
      (match actual
        ((None) false)
        ((Some got) (strEq got want)))
    )))

(:: parsed (-> String Nodes))
(fn (parsed source)
  (match (parseModule (lex source))
    ((ParseFailed _) __indexTrap)
    ((ParseSuccess nodes _) nodes)))

(:: diagIs (-> (Option Diag) String Bool))
(fn (diagIs diagnostic code)
  (match diagnostic
    ((None) false)
    ((Some found) (strEq (diagCode found) code))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let base "__WORKSPACE__")
    (let missing (concat base "/Missing.ax"))
    (let empty (concat base "/Empty.ax"))
    (let blocked (concat base "/Blocked.ax"))
    (let present (concat base "/Present.ax"))
    (let contents "(pub :: value Int)\n(pub fn (value) 7)\n")
    (let tcode (checkedTargetCode hostTarget))
    (let workspace (lspWorkspaceNew vecNew vecNew vecNew))
    (say 1 (textIs (lspWorkspaceFile workspace missing) None))
    (say 2 (textIs (lspWorkspaceFile workspace empty) (Some "")))
    (say 3 (textIs (lspWorkspaceFile workspace blocked) None))
    (say 4 (textIs (lspWorkspaceFile workspace present) (Some contents)))
    (let initial (lspCacheInputs workspace))
    (let files (jsonGet initial "files"))
    (say 5 (lspCacheInputsCurrent initial))
    (say 6 (jsonIsNull (jsonGet (jsonArrGet files 0) "text")))
    (say 7 (strEq (jsonWrite (jsonGet (jsonArrGet files 1) "text")) "\"\""))
    (say 8 (jsonIsNull (jsonGet (jsonArrGet files 2) "text")))
    (say 9 (textIs (lspWorkspaceModulePath workspace "Empty" tcode base) (Some empty)))
    (say 10 (textIs (lspWorkspaceModulePath workspace "Missing" tcode base) None))
    (say 11 (textIs (lspWorkspaceModulePath workspace "Blocked" tcode base) None))
    (say 12 (textIs (lspWorkspaceModulePath workspace "Present" tcode base) (Some present)))
    (say 13 (textIs (lspWorkspaceFile workspace missing) None))
    (say 14 (textIs (lspWorkspaceFile workspace empty) (Some "")))
    (let uris (vecPush vecNew (lspPathToUri missing)))
    (let texts (vecPush vecNew ""))
    (let meta (vecPush (vecPush vecNew 1) 1))
    (let overlay (lspWorkspaceNew uris texts meta))
    (say 15 (textIs (lspWorkspaceModulePath overlay "Missing" tcode base) (Some missing)))
    (say 16 (isOk (writeFile missing "")))
    (say 17 (! (lspCacheInputsCurrent initial)))
    (let fresh (lspWorkspaceNew vecNew vecNew vecNew))
    (say 18 (textIs (lspWorkspaceFile fresh missing) (Some "")))
    (say 19 (textIs (lspWorkspaceModulePath fresh "Missing" tcode base) (Some missing)))
    (let freshInputs (lspCacheInputs fresh))
    (say 20 (lspCacheInputsCurrent freshInputs))
    (say 21 (isOk (removeFile missing)))
    (say 22 (! (lspCacheInputsCurrent freshInputs)))
    (let emptyOnly (lspWorkspaceNew vecNew vecNew vecNew))
    (say 23 (textIs (lspWorkspaceFile emptyOnly empty) (Some "")))
    (let emptyInputs (lspCacheInputs emptyOnly))
    (say 24 (lspCacheInputsCurrent emptyInputs))
    (say 25 (isOk (writeFile empty "now")))
    (say 26 (! (lspCacheInputsCurrent emptyInputs)))
    (let blockedOnly (lspWorkspaceNew vecNew vecNew vecNew))
    (say 27 (textIs (lspWorkspaceFile blockedOnly blocked) None))
    (let blockedInputs (lspCacheInputs blockedOnly))
    (say 28 (lspCacheInputsCurrent blockedInputs))
    (say 29 (isOk (removeDir blocked)))
    (say 30 (isOk (writeFile blocked "")))
    (say 31 (! (lspCacheInputsCurrent blockedInputs)))
    (let source "(import Missing)")
    (let declarations (parsed source))
    (let entry (concat base "/Main.ax"))
    (let overlayUnits
      (vecPush vecNew (CUnit2 :file entry :src source :name None :imports vecNew :library false)))
    (say 32 (isNone (lspWorkspacePreflight overlay declarations tcode base overlayUnits 0)))
    (let noOverlay (lspWorkspaceNew vecNew vecNew vecNew))
    (let diskUnits
      (vecPush vecNew (CUnit2 :file entry :src source :name None :imports vecNew :library false)))
    (say 33 (diagIs (lspWorkspacePreflight noOverlay declarations tcode base diskUnits 0) "AX5001"))
    (let emptySource "(import MoreEmpty)")
    (let emptyUnits
      (vecPush vecNew
        (CUnit2 :file entry :src emptySource :name None :imports vecNew :library false)))
    (say 34 (isNone (lspWorkspacePreflight noOverlay (parsed emptySource) tcode base emptyUnits 0)))
    (let unreadableSource "(import Never)")
    (let unreadableUnits
      (vecPush vecNew
        (CUnit2 :file entry :src unreadableSource :name None :imports vecNew :library false)))
    (say 35
      (diagIs
        (lspWorkspacePreflight noOverlay (parsed unreadableSource) tcode base unreadableUnits 0)
        "AX5001"))
    0
  })
