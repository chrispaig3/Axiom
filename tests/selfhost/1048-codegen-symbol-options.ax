; expect 73
; Symbol lookup distinguishes absence from index zero and resolves shadowing.
(import codegen)
(import parser)
(import core)
(import Str)
(import Vec)
(import IO)
(import Fmt)
(import Sys)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  {
    (println
      (concat (fmtInt index)
        (if good
          " true"
          " false")))
    (if (! good)
      (sysExitWith 1))
  })

(:: indexIs (-> (Option Int) Int Bool))
(fn (indexIs found expected)
  (match found
    ((None) false)
    ((Some index) (== index expected))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let names (vecPush (vecPush (vecPush vecNew "first") "later") "first"))
    (say 1 (isNone (symIndexIn vecNew "first" (- 0 1))))
    (say 2 (indexIs (symIndexIn names "first" 0) 0))
    (say 3 (indexIs (symIndexIn names "later" 2) 1))
    (say 4 (indexIs (symIndexIn names "first" 2) 2))
    (say 5 (isNone (symIndexIn names "missing" 2)))
    (say 6 (isNone (symIndexIn names "first" (- 0 1))))
    (let cg newCG)
    (say 7 (isNone (symIndex cg "first")))
    (say 8 (! (hasSym cg "first")))
    (bindSym cg "first" "%root" 0 3)
    (say 9 (indexIs (symIndex cg "first") 0))
    (say 10 (hasSym cg "first"))
    (bindSym cg "later" "%later" 0 3)
    (bindSym cg "first" "%shadow" 0 3)
    (say 11 (indexIs (symIndex cg "first") 2))
    (say 12 (indexIs (symIndex cg "later") 1))
    (emitVar (nodeBuildEVarPlain "first" 0 0) cg)
    (say 13 (strEq cg.result "%shadow"))
    (symRestore cg 1)
    (say 14 (indexIs (symIndex cg "first") 0))
    (say 15 (isNone (symIndex cg "later")))
    (emitVar (nodeBuildEVarPlain "first" 0 0) cg)
    (say 16 (strEq cg.result "%root"))
    (bindSym cg "true" "%local" 0 3)
    (emitVar (setNodeDefScope (nodeBuildEVarPlain "true" 0 0)) cg)
    (say 17 (strEq cg.result "1"))
    (let evidence newCG)
    (emitEvwaRead evidence 0)
    (say 18 (strEq evidence.result "0"))
    (emitEvwRead evidence)
    (say 19 (strEq evidence.result "0"))
    (bindSym evidence "__evwa." "%argument" 0 0)
    (emitEvwaRead evidence 0)
    (say 20 (strEq evidence.result "%argument"))
    (bindSym evidence "__evw." "%function" 0 0)
    (emitEvwRead evidence)
    (say 21 (strEq evidence.result "%function"))
    (bindSym evidence "__evw." "%slot" 0 1)
    (emitEvwRead evidence)
    (say 22 (isSome (strFind (renderCG evidence) "load i64, ptr %slot" 0)))
    (let tail newCG)
    (bindSym tail "first" "%slot" 0 1)
    (let slots (vecPush (vecPush (vecPush vecNew "%slot") "%slot") "%slot"))
    (let args
      (vecPush
        (vecPush (vecPush vecNew (nodeBuildEVarPlain "first" 0 0))
          (nodeBuildEVarPlain "missing" 0 0))
        (nodeBuildEIntPlain 1 0 0)))
    (let flags (tailArgsUnchanged tail slots args vecNew 0))
    (say 23 (== (vecGet flags 0) 1))
    (say 24 (== (vecGet flags 1) 0))
    (say 25 (== (vecGet flags 2) 0))
    (bindSym tail "first" "%shadow" 0 1)
    (let shadowFlags (tailArgsUnchanged tail slots args vecNew 0))
    (say 26 (== (vecGet shadowFlags 0) 0))
    (let stores newCG)
    (bindSym stores "target" "%target" 0 1)
    (emitSet (nodeBuildESet "target" (nodeBuildEIntPlain 7 0 0) 0 0) stores)
    (say 27 (isSome (strFind (renderCG stores) "store i64 7, ptr %target" 0)))
    (let retains newCG)
    (emitRetainIfLamArg retains "%value" 0)
    (say 28 (== (strLen (renderCG retains)) 0))
    (bindSym retains "__evwa." "%argument" 0 0)
    (emitRetainIfLamArg retains "%value" 0)
    (say 29 (isSome (strFind (renderCG retains) "lshr i64 %argument, 0" 0)))
    (symRestore cg 0)
    (say 30 (isNone (symIndex cg "first")))
    (say 31 (! (hasSym cg "true")))
    73
  })
