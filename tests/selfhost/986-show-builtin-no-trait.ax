; expect 59
; `(format x)` on every shape, with `IO` NOT imported.
;
; This is the minimal program that renders: `Fmt` and `Str` are the
; only modules loaded, because they are exactly what the rewrite
; targets - `fmtInt`/`fmtFloat`, `strConcat`/`strByte`/`strFromByte`
; (and `Vec`, which `Str` imports, for the ancestor stack) - and
; `Fmt` is where the `format` macro lives since 0.7.4, so no third
; import is needed to reach it.
;
; It was written when `Show` was still a trait, to show the builtin
; answering with no trait in the program at all; it holds the same
; shape now for the opposite reason. Each rendering is measured by its
; length, and the sum is the exit status:
;
;   "123"                 3    fmtInt
;   "abcd"                4    the call ELIDED - the String itself
;   "true"                4    the spliced `if`
;   "1.500000"            8    fmtFloat
;   "'x'"                 3    the character literal
;   "Green"               5    a nullary constructor, bare
;   "{a = 1, b = \"x\"}"  16   a struct, its String field quoted
;   "(Some Green)"        12   a constructor application
;   "None"                4
;                         59
(import Fmt)

(import Str)

(data Colour
  (Red)
  (Green))

(struct Pair
  (a : Int)
  (b : String))

; a bare `None` is `(Option _t)`, which has no renderer; the
; signature is what names the element type
(:: noneInt (Option Int))

(fn (noneInt) None)

(:: main Int)

(fn (main) (+ (strLen (format 123)) (+ (strLen (format "abcd")) (+ (strLen (format true)) (+ (strLen (format 1.5)) (+ (strLen (format 'x')) (+ (strLen (format Green)) (+ (strLen (format (Pair 1 "x"))) (+ (strLen (format (Some Green))) (strLen (format noneInt)))))))))))
