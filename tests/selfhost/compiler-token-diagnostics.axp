(import core)
(import lexer)
(import parser)
(import lsp)
(import replhl)
(import diag)
(import Vec)
(import Str)
(import IO)

; These fixtures assert that their input parses before testing semantic results.
; Failed parses terminate at the typed non-returning trap, never a forged value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

; Constructor names keep the fixture independent of global variant tag numbers.
(:: kindLabel (-> TokenKind String))
(fn (kindLabel kind)
  (match kind
    ((TK_LPAREN) "TK_LPAREN")
    ((TK_RPAREN) "TK_RPAREN")
    ((TK_IDENT) "TK_IDENT")
    ((TK_INT) "TK_INT")
    ((TK_STRING) "TK_STRING")
    ((TK_COLON) "TK_COLON")
    ((TK_DOUBLE_COLON) "TK_DOUBLE_COLON")
    ((TK_RARROW) "TK_RARROW")
    ((TK_DOT) "TK_DOT")
    ((TK_QUOTE) "TK_QUOTE")
    ((TK_LBRACE) "TK_LBRACE")
    ((TK_RBRACE) "TK_RBRACE")
    ((TK_EOF) "TK_EOF")
    ((TK_ERROR) "TK_ERROR")
    ((TK_FLOAT) "TK_FLOAT")
    ((TK_CHARLIT) "TK_CHARLIT")
    ((TK_LBRACKET) "TK_LBRACKET")
    ((TK_RBRACKET) "TK_RBRACKET")
    ((TK_COMMA) "TK_COMMA")
    ((TK_ERROR_ESC) "TK_ERROR_ESC")
    ((TK_QUESTION) "TK_QUESTION")))

(:: report (-> String String ()))
;@axiom:effect(io)
(fn (report file source)
  {
    (println "SOURCE {file}")
    (let tokens (lex source))
    (for token in tokens
      {
        (let kind (kindLabel (tokenKind token)))
        (let start (spanStart (tokenSpan token)))
        (let end (spanEnd (tokenSpan token)))
        (println "TOKEN {kind} {start} {end}")
      })
    (let ds vecNew)
    (if (let (Some diagnostic) (lexErrDiag tokens source))
      (vecPush ds diagnostic)
      {
        (let parsed (parseModuleWith tokens (scanAxtags source)))
        (match parsed
          ((ParseFailed parseError1)
            (vecPush ds (parseErrDiag tokens (ParseFailed parseError1) source))
          )
          ((ParseSuccess parsedValue1 parsedPos1) ()))
      })
    (let units
      (vecPush vecNew (CUnit2 :file file :src source :name None :imports vecNew :library false)))
    (writeStr stdout (renderDiagsUnits ds units))
    (for span in (hlScanSpans (hlScan source))
      {
        (let kind (hlSpanCls span))
        (let start (hlSpanStart span))
        (let end (hlSpanEnd span))
        (println "HL {kind} {start} {end}")
      })
    (let recovered (lspParse source))
    (let count (vecLen (expectParsed recovered)))
    (let loss (pResPos recovered))
    (println "RECOVERY {count} {loss}")
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (report "token-empty.ax" "")
    (report "token-valid.ax" "(fn (f) -5)")
    (report "token-unexpected.ax" "@ \"\\q\"")
    (report "token-escape.ax" "\"\\q\" @")
    (report "token-string.ax" "\"open")
    (report "token-char.ax" "'a")
    (report "token-number.ax" "12bad")
    (report "token-eof.ax" "(fn (f) 1")
    (report "token-unmatched.ax" ")")
    (report "token-binder.ax" "(fn (f) { (let mut x 1) (set x 2) x })")
    (report "token-member.ax" "(fn (f) (Box :value 1))")
    (report "token-recovery.ax" "(fn (first) 1)\n(fn (broken)\n(fn (last) 3)")
    (report "token-utf8.ax" "'é' 1.5 x.y?")
    0
  })
