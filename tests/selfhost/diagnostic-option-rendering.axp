(import core)
(import diag)
(import render)
(import lsp)
(import jsonrpc)
(import Str)
(import Vec)
(import IO)

(:: sample (-> Int Diag))
(fn (sample mode)
  {
    (let d
      (mkDiag SEV_ERROR "AX3001" "probe"
        (if (== mode 10)
          0
          (mkSpan 0 5))
        "message" None None))
    (if (== mode 1)
      (diagSetLabel d ""))
    (if (== mode 2)
      (diagSetLabel d "label\n\"\\\t"))
    (if (== mode 3)
      (diagAddHelp d "plain"))
    (if (== mode 4)
      (diagAddFixHelp d "delete" (mkSpan 0 5) ""))
    (if (== mode 5)
      (diagAddFixHelp d "replace" (mkSpan 0 5) "gamma\n"))
    (if (== mode 6)
      (diagAddFixHelp d "unlocated" 0 "unused"))
    (if (== mode 7)
      {
        (diagAddFixHelp d "first" (mkSpan 0 1) "x")
        (diagAddFixHelp d "second" (mkSpan 2 3) "")
        (diagDisarmFixes d)
      })
    (if (== mode 10)
      (diagSetLabel d "spanless"))
    (if (== mode 11)
      {
        (diagAddSecondary d (mkSpan 6 10) "other")
        (diagAddNote d "note")
        (diagAddHelp d "first")
        (diagAddFixHelp d "second" (mkSpan 0 0) "insert")
        (diagAddTrace d "macro!" 0 0)
      })
    (if (== mode 8)
      (mkDiagFix2 SEV_ERROR "AX3001" "probe" (mkSpan 0 5) "legacy"
        (diagRelated (mkSpan 6 10) "related") "delete" (diagFix (mkSpan 0 5) "") (Some "second"))
      (if (== mode 9)
        (mkDiagNote SEV_WARNING "AX3037" "probe" (mkSpan 0 5) "legacy" None (Some "") "note")
        d))
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let source "alpha beta\n")
    (let ix (srcLineIndex source))
    (let typedIx (lspLineIndex source))
    (for mode in 0..12
      {
        (let d (sample mode))
        (println (renderDiag d source "probe.ax" vecNew))
        (println (renderDiagJson d source "probe.ax" vecNew ix vecNew))
        (println (renderDiagHuman d source "probe.ax" vecNew ix vecNew))
        (println (lspDiagText d))
        (let actions jsonArr)
        (lspQuickfixesOf actions d source "file:///probe.ax" typedIx (mkSpan 0 10))
        (println (jsonWrite actions))
      })
  })
