(import core)
(import lexer)
(import parser)
(import typecheck)
(import lsp)
(import diag)
(import Vec)
(import Str)
(import jsonrpc)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println "{index} {good}"))

; option probes begin
(:: sameType (-> (Option ASTNode) ASTNode Bool))
(fn (sameType found wanted)
  (match found
    ((None) false)
    ((Some ty) (nodeSame ty wanted))))

(:: sameName (-> (Option String) String Bool))
(fn (sameName found wanted)
  (match found
    ((None) false)
    ((Some name) (strEq name wanted))))

(:: signature (-> String ASTNode ASTNode))
(fn (signature name ty)
  (setNodeTyChild (nodeBuildDSig name vecNew 0 (mkSpan 0 (strLen name))) ty))

(:: parameterStamp (-> ASTNode Int Int))
(fn (parameterStamp signature count)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (set tc.rgnStamping 1)
    (set tc.rgnFactsDone 1)
    (let entries (regFn vecNew "callee" signature))
    (let ent (vecGet entries 0))
    (let facts (rgnFactsOf ent count))
    (set facts.resultCUR 1)
    (set facts.resultFrom (<< 1 (- count 1)))
    (let host (nodeBuildDFn "host" vecNew (mkEInt 0) 0))
    (let rc (rgnCtxNew tc host ent 0))
    (let args (:: vecNew Nodes))
    (for i in 0..count
      (vecPush args (mkEInt i)))
    (let call (mkEApp (mkEVar "callee") (mkEInt 0)))
    (rgnKnownCall rc ent "callee" args 0 call)
    (nodeResWord call)
  })

(:: parsedCases ())
;@axiom:effect(io)
(fn (parsedCases)
  {
    (let source "(:: f (-> Int Int))\n(fn (f x y) x)\n")
    (let parsed (parseModuleWith (lex source) (scanAxtags source)))
    (match parsed
      ((ParseFailed parseError1) (println "PARSE_FAILURE parameter-header"))
      ((ParseSuccess parsedValue1 parsedPos1)
        {
          (let nodes parsedValue1)
          (let d (vecGet nodes 1))
          (let sig (vecGet nodes 0))
          (let off (+ (spanStart (nodeSpan d)) 2))
          (say 31 (sameType (lspParamTypeAt source nodes off "x") (nodeAChild (nodeTyChild sig))))
          (say 32 (isNone (lspParamTypeAt source nodes off "y")))
          (say 33 (isNone (lspParamTypeAt source nodes off "missing")))
          (say 34 (isNone (lspParamTypeAt source nodes (strLen source) "x")))
          (say 35
            (match (lspLocalTypeOf source nodes off "f")
              ((None) false)
              ((Some ty) (tyIsBareInt ty))))
          (let hints jsonArr)
          (lspViewHintsHeader hints source (lspLineIndex source) d (Some sig) 0 (strLen source))
          (say 36 (== (jsonArrLen hints) 2))
          (say 37 (strEq (jsonGetStr (jsonArrGet hints 0) "label") ": Int"))
          (let poisoned (signature "f" (mkTArr mkTErr mkIntTy)))
          (let poisonHints jsonArr)
          (lspViewHintsHeader poisonHints source (lspLineIndex source) d (Some poisoned) 0
            (strLen source))
          (say 38 (== (jsonArrLen poisonHints) 1))
          (say 39
            (sameType (lspParamTypeAt source (vecPush (vecPush vecNew poisoned) d) off "x")
              (nodeAChild (nodeTyChild poisoned))))
        }
      ))
    (let fields "(struct Box (value : Int))\n(:: f (-> Box Int))\n(fn (f box) box.value)\n")
    (let fieldParsed (parseModuleWith (lex fields) (scanAxtags fields)))
    (match fieldParsed
      ((ParseFailed parseError2) (println "PARSE_FAILURE field-header"))
      ((ParseSuccess parsedValue2 parsedPos2)
        {
          (let nodes parsedValue2)
          (if (let (Some at) (strFind fields "box.value" 0))
            {
              (let fieldSpan (mkSpan (+ at 4) (+ at 9)))
              (say 40
                (&& (sameName (lspFieldBaseStruct fields nodes "box" at) "Box")
                  (! (jsonIsNull (lspHoverFieldUse fields nodes "box" at fieldSpan 0)))))
              (say 41
                (&& (isNone (lspFieldBaseStruct fields nodes "missing" (strLen fields)))
                  (jsonIsNull
                    (lspHoverFieldUse fields nodes "missing" (strLen fields) fieldSpan 0))))
            }
            (println "PARSE_FAILURE field-offset"))
        }
      ))
    (let nullary "(:: answer Int)\n(fn (answer) 42)\n")
    (let nullaryParsed (parseModuleWith (lex nullary) (scanAxtags nullary)))
    (match nullaryParsed
      ((ParseFailed parseError3) (println "PARSE_FAILURE nullary-header"))
      ((ParseSuccess parsedValue3 parsedPos3)
        (say 42 (isNone (lspParamTypeAt nullary parsedValue3 25 "answer")))
      ))
  })

(:: runOptions ())
;@axiom:effect(io)
(fn (runOptions)
  {
    (let integer mkIntTy)
    (let text mkStringTy)
    (let poison mkTErr)
    (let wild mkSilentWild)
    (let arrows (mkTArr integer (mkTArr text integer)))
    (say 1 (isNone (nthParamTy nilNode 0)))
    (say 2 (isNone (nthParamTy integer 0)))
    (say 3 (isNone (nthParamTy arrows (- 0 1))))
    (say 4 (sameType (nthParamTy arrows 0) integer))
    (say 5 (sameType (nthParamTy arrows 1) text))
    (say 6 (isNone (nthParamTy arrows 2)))
    (say 7 (isNone (nthParamTy (mkTTup vecNew) 0)))
    (say 8 (sameType (nthParamTy (mkTArr poison integer) 0) poison))
    (say 9 (sameType (nthParamTy (mkTArr wild integer) 0) wild))
    (say 10 (sameType (nthParamTy (mkTArr arrows integer) 0) arrows))
    (let params (vecPush (vecPush vecNew "first") "second"))
    (let tc (tcNew vecNew vecNew vecNew))
    (let types (:: vecNew Nodes))
    (bindFnParams tc params types (Some (mkTArr integer integer)) 0)
    (say 11 (nodeSame (vecGet types 0) integer))
    (say 12 (strEq (nodeAName (vecGet types 1)) "_t1"))
    (say 13 (== (tcCounter tc) 2))
    (let defaultTc (tcNew vecNew vecNew vecNew))
    (let defaults (:: vecNew Nodes))
    (bindFnParams defaultTc params defaults None 0)
    (say 14 (&& (tyIsBareInt (vecGet defaults 0)) (tyIsBareInt (vecGet defaults 1))))
    (let scalarTc (tcNew vecNew vecNew vecNew))
    (let scalars (:: vecNew Nodes))
    (bindFnParams scalarTc params scalars (Some text) 0)
    (say 15 (&& (tyIsBareInt (vecGet scalars 0)) (tyIsBareInt (vecGet scalars 1))))
    (say 16 (== (parameterStamp integer 1) 0))
    (say 17 (== (parameterStamp (mkTArr integer integer) 1) 2))
    (say 18 (== (parameterStamp (mkTArr text integer) 1) 0))
    (say 19 (== (parameterStamp (mkTArr poison integer) 1) 0))
    (say 20 (== (parameterStamp (mkTArr integer integer) 2) 0))
    (let decls (vecPush vecNew (signature "f" arrows)))
    (say 21 (sameType (lspShapeParamTy decls "f" 1) text))
    (say 22 (isNone (lspShapeParamTy decls "f" 2)))
    (say 23 (isNone (lspShapeParamTy decls "missing" 0)))
    (say 24 (strEq (lspNavParamCode decls "f" "p" 1) "p : String"))
    (say 25 (strEq (lspNavParamCode decls "f" "p" 2) "p"))
    (let boxTy (mkTCon "Box" vecNew))
    (let boxDecls (vecPush vecNew (signature "boxed" (mkTArr boxTy integer))))
    (say 26 (sameName (lspFieldParamStruct boxDecls "boxed" "value" 0) "Box"))
    (say 27 (isNone (lspFieldParamStruct boxDecls "boxed" "value" 1)))
    (say 28 (isNone (lspFieldParamStruct boxDecls "missing" "value" 0)))
    (say 29 (sameName (lspFieldValueStruct (Some (mkEApp (mkEVar "Box") (mkEInt 1)))) "Box"))
    (say 30 (isNone (lspFieldValueStruct (Some (mkEInt 1)))))
    (parsedCases)
    (let unit (mkTTup vecNew))
    (say 43 (sameType (nthParamTy (mkTArr unit integer) 0) unit))
    (let poisonTc (tcNew vecNew vecNew vecNew))
    (let poisonTypes (:: vecNew Nodes))
    (bindFnParams poisonTc (vecPush vecNew "poison") poisonTypes (Some (mkTArr poison integer)) 0)
    (say 44 (nodeSame (vecGet poisonTypes 0) poison))
    (let emptyTc (tcNew vecNew vecNew vecNew))
    (let emptyTypes (:: vecNew Nodes))
    (bindFnParams emptyTc vecNew emptyTypes (Some arrows) 0)
    (say 45 (&& (== (vecLen emptyTypes) 0) (== (tcCounter emptyTc) 0)))
    (say 46 (== (parameterStamp nilNode 1) 0))
    (say 47 (isNone (nthParamTy (mkTArr nilNode integer) 0)))
  })

; option probes end
; diagnostics begin
(:: checkSource (-> String String ()))
;@axiom:effect(io)
(fn (checkSource name source)
  {
    (let parsed (parseModuleWith (lex source) (scanAxtags source)))
    (match parsed
      ((ParseFailed parseError4) (println (concat "PARSE_FAILURE " name)))
      ((ParseSuccess parsedValue4 parsedPos4)
        {
          (let nodes parsedValue4)
          (let units
            (vecPush vecNew
              (CUnit2 :file name :src source :name None :imports vecNew :library false)))
          (let checked (checkModuleTcTyped nodes nodes units))
          (writeStr stdout (renderDiagsUnits (tcOutVec checked) units))
        }
      ))
  })

(:: runDiagnostics ())
;@axiom:effect(io)
(fn (runDiagnostics)
  {
    (checkSource "scoped-valid.ax"
      "(:: f (-> (-> Int Int) Int))\n;@axiom:scoped(cb)\n(pub fn (f cb) (cb 1))\n")
    (checkSource "scoped-absent.ax" "(:: f Int)\n;@axiom:scoped(cb)\n(pub fn (f cb) 0)\n")
    (checkSource "scoped-exhausted.ax"
      "(:: f (-> Int Int))\n;@axiom:scoped(cb)\n(pub fn (f x cb) 0)\n")
    (checkSource "scoped-scalar.ax" "(:: f (-> Int Int))\n;@axiom:scoped(cb)\n(pub fn (f cb) cb)\n")
    (checkSource "compute-valid.ax"
      "(:: f (-> (-> Int Int) Int))\n;@axiom:compute(cb)\n(pub fn (f cb) (cb 1))\n")
    (checkSource "compute-absent.ax" "(:: f Int)\n;@axiom:compute(cb)\n(pub fn (f cb) 0)\n")
    (checkSource "compute-exhausted.ax"
      "(:: f (-> Int Int))\n;@axiom:compute(cb)\n(pub fn (f x cb) 0)\n")
    (checkSource "arity-refusal.ax"
      "(:: f (-> Int Int))\n(pub fn (f x) x)\n(:: main Int)\n(pub fn (main) (f 1 2))\n")
  })

; diagnostics end
(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (runOptions)
    (writeStr stdout "DIAGNOSTICS\n")
    (runDiagnostics)
    0
  })
