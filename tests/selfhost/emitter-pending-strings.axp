; Pending compiler register text owns a typed share through nested scopes.
(import codegen)
(import parser)
(import lexer)
(import core)
(import raw)
(import Str)
(import Vec)
(import IO)
(import Fmt)

; The fixture requires a successful parse before inspecting its typed value.
(:: expectParsed (-> (PResult a) a))
(fn (expectParsed result)
  (match result
    ((ParseSuccess value position) value)
    ((ParseFailed error) __indexTrap)))

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say index good)
  (println
    (concat (fmtInt index)
      (if good
        " true"
        " false"))))

(:: rc (-> String Int))
;@axiom:effect(unsafe)
(fn (rc value)
  (__load64 (as value Int) -2))

(:: emptySlot (-> Strings Int Bool))
;@axiom:effect(unsafe)
(fn (emptySlot values index)
  (== (__load64 (__load64 (as values Int) 2) index) 0))

(:: live Int)
(fn (live)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: ownershipChecks ())
;@axiom:effect(io)
(fn (ownershipChecks)
  {
    (let cg newCG)
    (let value (strDup "%owned"))
    (let before (rc value))
    (say 1 (== (vecLen (probePending cg)) 0))
    (probePendingPush cg value)
    (say 2 (== (rc value) (+ before 1)))
    (say 3 (vecOwnsRefs (probePending cg)))
    (say 4 (strEq (vecGet (probePending cg) 0) "%owned"))
    (let saved (probePendingAt cg 0))
    (let heldCount (rc value))
    (probePendingTruncate cg 0)
    (say 5 (== (rc value) (- heldCount 1)))
    (say 6 (strEq saved "%owned"))
    (say 7 (strEq value "%owned"))
    (say 8 (emptySlot (probePending cg) 0))
    (say 9 (== (vecLen (probePending cg)) 0))
  })

(:: scopeChecks ())
;@axiom:effect(io)
(fn (scopeChecks)
  {
    (let cg newCG)
    (let a (strDup "%prefix"))
    (let b (strDup "%inner"))
    (let ac (rc a))
    (let bc (rc b))
    (probePendingPush cg a)
    (probePendingPush cg b)
    (probePendingPush cg b)
    (say 10 (== (rc a) (+ ac 1)))
    (say 11 (== (rc b) (+ bc 2)))
    (probePendingTruncate cg 1)
    (say 12 (== (rc b) bc))
    (say 13 (== (rc a) (+ ac 1)))
    (say 14 (&& (emptySlot (probePending cg) 1) (emptySlot (probePending cg) 2)))
    (say 15 (strEq (vecGet (probePending cg) 0) "%prefix"))
    (probePendingTruncate cg 1)
    (say 16 (== (rc a) (+ ac 1)))
    (probePendingPush cg a)
    (probePendingPush cg a)
    (say 17 (== (rc a) (+ ac 3)))
    (probePendingTruncate cg 0)
    (say 18 (== (rc a) ac))
    (say 19 (&& (strEq a "%prefix") (strEq b "%inner")))
  })

(:: growthChecks ())
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (growthChecks)
  {
    (let cg newCG)
    (let header (memGetWord (as cg Int) 42))
    (let value (strDup "%grow"))
    (let before (rc value))
    (for i in 0..128
      (probePendingPush cg value))
    (say 20 (== (memGetWord (as cg Int) 42) header))
    (say 21 (== (vecLen (probePending cg)) 128))
    (say 22 (== (rc value) (+ before 128)))
    (probePendingTruncate cg 0)
    (say 23 (== (rc value) before))
    (say 24 (&& (emptySlot (probePending cg) 0) (emptySlot (probePending cg) 127)))
  })

(:: retainedReset (-> CG String Bool))
;@axiom:effect(unsafe)
(fn (retainedReset cg value)
  {
    (probePendingPush cg value)
    (let old (probePending cg))
    (let header (memGetWord (as cg Int) 42))
    (let before (rc value))
    (probePendingReset cg)
    (&& (!= (memGetWord (as cg Int) 42) header)
      (&& (== (vecLen (probePending cg)) 0)
        (&& (== (rc value) before) (&& (== (vecLen old) 1) (strEq (vecGet old 0) "%reset")))))
  })

(:: resetChecks ())
;@axiom:effect(io)
(fn (resetChecks)
  {
    (let cg newCG)
    (let value (strDup "%reset"))
    (let before (rc value))
    (say 25 (retainedReset cg value))
    (say 26 (== (rc value) before))
    (probePendingPush cg value)
    (say 27 (== (rc value) (+ before 1)))
    (probePendingReset cg)
    (say 28 (== (rc value) before))
    (say 29 (strEq value "%reset"))
    (probePendingPush cg value)
    (emitFnDef (mkDFnAt "fresh" vecNew (mkEInt 7) 0) cg)
    (say 30 (== (rc value) before))
    (say 31 (== (vecLen (probePending cg)) 0))
  })

(:: pendingRound (-> CG Int Bool))
(fn (pendingRound cg index)
  {
    (let value (concat "%after-" (fmtInt index)))
    (probePendingPush cg value)
    (probePendingTruncate cg 0)
    (strEq value (concat "%after-" (fmtInt index)))
  })

(:: soakChecks ())
;@axiom:effect(io)
(fn (soakChecks)
  {
    (let cg newCG)
    (for i in 0..16
      (pendingRound cg i))
    (let before (live))
    (let mut good true)
    (for i in 0..1000
      (if (! (pendingRound cg i))
        (set good false)))
    (let growth (- (live) before))
    (say 32 good)
    (say 33 (<= growth 4096))
    (writeStr stderr (concat "pending-soak-growth " (concat (fmtInt growth) "\n")))
  })

(:: emissionChecks ())
;@axiom:effect(io)
(fn (emissionChecks)
  {
    (let cg newCG)
    (let a (strDup "%left"))
    (let b (strDup "%right"))
    (probePendingPush cg a)
    (probePendingPush cg b)
    (let before (rc a))
    (releasePending cg (probePending cg) 0)
    (say 34 (== (rc a) before))
    (say 35 (== (vecLen (probePending cg)) 2))
    (let ir (renderCG cg))
    (say 36 (== (strHasSub ir "call void @axiom_release(i64 %left)") 1))
    (say 37 (== (strHasSub ir "call void @axiom_release(i64 %right)") 1))
    (probePendingTruncate cg 0)
    (say 38 (&& (strEq a "%left") (strEq b "%right")))
  })

(:: parseFn (-> String ASTNode))
(fn (parseFn text)
  (vecGet (expectParsed (parseModule (lex text))) 0))

(:: actualChecks ())
;@axiom:effect(io)
(fn (actualChecks)
  {
    (let cg newCG)
    (let binding (mkELetAt "owned" (mkEApp (mkEVar "Some") (mkEInt 7)) (mkEInt 3) 0))
    (emitLetAt binding cg 0)
    (say 39 (&& (vecOwnsRefs (probePending cg)) (== (vecLen (probePending cg)) 0)))
    (say 40 (== (strHasSub (renderCG cg) "call void @axiom_release(i64 ") 1))
    (let normal newCG)
    (let matchFn (parseFn "(fn (probe) (match (Some 7) ((Some x) 9) ((None) 0)))"))
    (emitMatch (nodeCChild matchFn) normal)
    (say 41 (&& (vecOwnsRefs (probePending normal)) (== (vecLen (probePending normal)) 0)))
    (let tail newCG)
    (emitMatchTail (nodeCChild matchFn) tail)
    (say 42 (&& (vecOwnsRefs (probePending tail)) (== (vecLen (probePending tail)) 0)))
    (let nested newCG)
    (emitDecl
      (parseFn
        "(fn (nested) { (let a (Some 2)) (match (Some 3) ((Some x) { (let b (Some x)) 8 }) ((None) 0)) })")
      nested)
    (say 43 (&& (vecOwnsRefs (probePending nested)) (== (vecLen (probePending nested)) 0)))
    (let lifted newCG)
    (emitDecl (parseFn "(fn (outer) { (lambda (x) { (let a (Some x)) 4 }) 1 })") lifted)
    (drainPending lifted)
    (say 44 (&& (vecOwnsRefs (probePending lifted)) (== (vecLen (probePending lifted)) 0)))
    (say 45 (== (strHasSub (renderCG lifted) "define i64 @_lam_0(") 1))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    ownershipChecks
    scopeChecks
    growthChecks
    resetChecks
    soakChecks
    emissionChecks
    actualChecks
    0
  })
