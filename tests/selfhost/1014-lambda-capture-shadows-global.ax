; expect 42
; Returning a capture takes a share even when a global has the same name.
; Read the live allocation's RC header before and during the result's
; lifetime. Missing the return retain leaves the count unchanged.
(import Mem)
(import Str)

(:: s Int)
(fn (s)
  0)

(:: reader (-> String Int String))
(fn (reader s)
  (lambda (n) s))

(:: main Int)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let text (concat "keep" "alive"))
    (let read (reader text))
    (let header (- (as text Int) 16))
    (let before (memGetWord header 0))
    {
      (let answer (read 0))
      (let after (memGetWord header 0))
      (if (&& (== after (+ before 1)) (== answer "keepalive"))
        42
        1)
    }
  })

; This program reaches raw memory through its own trusted helpers over
; the primitives, as any program outside the standard library does.
(:: memGetWord (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (memGetWord addr index)
  (__load64 addr index))
