(import core)
(import parser)
(import lsp)
(import jsonrpc)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: exactCount (-> String Int Bool))
(fn (exactCount source expected)
  (match (lspNavParseExact source)
    ((None) false)
    ((Some declarations) (== (vecLen declarations) expected))))

(:: prepare (-> String Int Int))
(fn (prepare source offset)
  (lspPrepareRename source (jsonObjPut jsonObj "position" (lspPos source offset))))

(:: rename (-> String Int String Int))
;@axiom:effect(io)
(fn (rename source offset name)
  (lspRename (lspWorkspaceNew vecNew vecNew vecNew) source "file:///tmp/exact.ax"
    (jsonObjPut (jsonObjPut jsonObj "position" (lspPos source offset)) "newName" (jsonStr name))
    vecNew vecNew))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (exactCount "" 0))
    (say 2 (exactCount " ; a comment\n" 0))
    (say 3 (exactCount "(fn (identity x) x)" 1))
    (say 4 (exactCount "(fn (first) 1) (fn (last) 2)" 2))
    (say 5 (isNone (lspNavParseExact "@")))
    (say 6 (isNone (lspNavParseExact ")")))
    (say 7 (isNone (lspNavParseExact "(fn (first) 1) @ (fn (last) 2)")))
    (say 8 (exactCount "(fn (identity x) x" 1))
    (say 9 (jsonIsNull (prepare "" 0)))
    (say 10 (! (jsonIsNull (prepare "(fn (identity x) x)" 14))))
    (say 11 (! (jsonIsNull (prepare "(fn (identity x) x" 14))))
    (say 12 (jsonIsNull (prepare "(fn (identity x) x) @" 14)))
    (say 13 (! (jsonIsNull (rename "(fn (identity x) x)" 14 "value"))))
    (say 14 (! (jsonIsNull (rename "(fn (identity x) x" 14 "value"))))
    (say 15 (jsonIsNull (rename "(fn (identity x) x) @" 14 "value")))
    (say 16 (jsonIsNull (rename "(fn (identity x) x)" 14 "x")))
    (say 17 (jsonIsNull (rename "(fn (identity x) x)" 14 "fn")))
    (say 18 (jsonIsNull (rename "(fn (identity x) x)" 14 "_")))
    (say 19 (jsonIsNull (rename "" 0 "value")))
    (say 20
      (match (lspNavParseExact (strDup "(fn (escaped) 1)"))
        ((None) false)
        ((Some declarations) (strEq (nodeAText (vecGet declarations 0)) "escaped"))))
    0
  })
