(import parser)
(import lexer)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: codeIs (-> (Option Int) Int Bool))
(fn (codeIs value expected)
  (match value
    ((None) false)
    ((Some code) (== code expected))))

(:: codeMissing (-> (Option Int) Bool))
(fn (codeMissing value)
  (match value
    ((None) true)
    ((Some code) false)))

(:: rawChar1 (-> Byte String))
(fn (rawChar1 a)
  (concat "'" (concat (strFromByte a) "'")))

(:: rawChar2 (-> Byte Byte String))
(fn (rawChar2 a b)
  (concat "'" (concat (strFromByte a) (concat (strFromByte b) "'"))))

(:: rawChar3 (-> Byte Byte Byte String))
(fn (rawChar3 a b c)
  (concat "'" (concat (strFromByte a) (concat (strFromByte b) (concat (strFromByte c) "'")))))

(:: rejectsLex (-> String Bool))
(fn (rejectsLex text)
  (peekIs (lex text) 0 TK_ERROR))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (say 1 (codeIs (charLexemeCode "'A'") 65))
    (say 2 (codeIs (charLexemeCode "'é'") 233))
    (say 3 (codeIs (charLexemeCode "'世'") 19990))
    (say 4 (codeIs (charLexemeCode "'😀'") 128512))
    (say 5 (codeIs (charLexemeCode "'\\0'") 0))
    (let continuation (rawChar1 128))
    (say 6 (codeMissing (charLexemeCode continuation)))
    (say 7 (rejectsLex continuation))
    (let badLead (rawChar1 248))
    (say 8 (codeMissing (charLexemeCode badLead)))
    (say 9 (rejectsLex badLead))
    (let badPair (rawChar2 195 32))
    (say 10 (codeMissing (charLexemeCode badPair)))
    (say 11 (rejectsLex badPair))
    (let overlong (rawChar2 192 175))
    (say 12 (codeMissing (charLexemeCode overlong)))
    (say 13 (rejectsLex overlong))
    (let surrogate (rawChar3 237 160 128))
    (say 14 (codeMissing (charLexemeCode surrogate)))
    (say 15 (rejectsLex surrogate))
    (say 16 (codeMissing (charLexemeCode "'\\q'")))
    (say 17 (peekIs (lex "'\\q'") 0 TK_ERROR_ESC))
    (say 18 (codeMissing (charLexemeCode "'aX")))
    (say 19 (codeMissing (charLexemeCode "'ab'")))
    (say 20 (codeMissing (charLexemeCode "'\\nX'")))
  })
