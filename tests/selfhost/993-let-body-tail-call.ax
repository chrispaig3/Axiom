; expect 42
; A self tail call in the body of a `let` is a jump (MM-EXEC-6b,
; since 2026-08-22): the `let` binds an owned temporary that event 3
; releases after the call - which is why LLVM's own sibling-call pass
; could no longer rescue this shape, and 400,000 deep it overflowed
; the stack. The binding's own share is paid at the jump; the slot
; keeps the block, and the value answered holds exactly one share.
; And a `mut` binding inside the loop allocates once per activation,
; not once per iteration: every `alloca` sits in the entry block, so
; this runs at `--opt 0` too, where a body-block `alloca` overflowed.
(import IO)
(import Str)
(:: walk (-> String Int String))
(fn (walk s n)
  (if (== n 0)
      s
      (let ((s2 (strConcat "v" (fmtInt n))))
        (let ((mut k 0))
          { (set k (strLen s2)) (walk s2 (- n 1)) }))))
(:: cnt (-> String Int))
(fn (cnt s) (__load64 (- (cast Int s) 16) 0))
(fn (main)
  (let ((r (walk "seed" 400000)))
    (if (&& (strEq r "v1") (== (cnt r) 1)) 42 1)))
