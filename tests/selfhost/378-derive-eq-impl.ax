; expect 30
; macro-system.md section 10.2's fieldful form, verbatim - the
; IMPL-GENERATING deriveEq, and the reason it generates an impl
; rather than a free function is load-bearing: its own field
; comparisons dispatch through Eq, so a derived type's instance must
; BE an Eq instance for a containing type's derive to find
; (MAC-INT-4). Measured here as COMPOSITION:
;
;   (deriveEq Inner) leaves Eq#Inner#eq behind, and
;   (deriveEq Outer)'s comparison of its Inner-typed field
;   dispatches to it - by the field's static type, at compile time -
;   while its Int field dispatches to the hand-written (Eq Int)
;   instance, and the nullary NoO falls out of the empty fold.
;
; 27 eq(MkO (MkI 3) 4, same)      - both fields equal through dispatch
;  9 eq(MkO (MkI 3) 4, (MkI 5) 4) - the INNER field differs: 0
;  3 eq(NoO, NoO)                 - empty fold answers true
;  1 eq(MkO .., NoO)              - cross-constructor: 0
;
; The unfixed compiler refuses the impl template with AX3021 at the
; macro's own line, exit 1.
(trait (Eq a) where (
  eq :: (-> a a Bool)
))

(impl (Eq Int) where (
  (eq
    (lambda (x y) (== x y))
  )
))

(pub macro deriveEq ((deriveEq T)
   (impl (Eq T) where
     ((eq (lambda (a b)
       (match a
         (syntax/for (C (syntax/constructors T))
           ((C (syntax/binders C x))
            (match b
              ((C (syntax/binders C y))
               (syntax/fold && true
                            ((xi (syntax/binders C x))
                             (yi (syntax/binders C y)))
                 (eq xi yi)))
              (_ false)))))))))))

(data Inner
  (MkI Int))

(data Outer
  (MkO Inner Int)
  (NoO))

(deriveEq Inner)

(deriveEq Outer)

(:: b2i (-> Bool Int))

(fn (b2i x)
  (if x
    1
    0
  )
)

(:: main Int)

(fn (main) (+ (* 27 (b2i (eq (MkO (MkI 3) 4) (MkO (MkI 3) 4)))) (+ (* 9 (b2i (eq (MkO (MkI 3) 4) (MkO (MkI 5) 4)))) (+ (* 3 (b2i (eq NoO NoO))) (b2i (eq (MkO (MkI 3) 4) NoO))))))
