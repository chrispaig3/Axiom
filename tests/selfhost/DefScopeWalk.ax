; A module whose macros a caller shadows, for
; `1000-macro-defscope-walk.ax`. See that file for what it pins.
;
; Modules sit beside the cases and are told apart by name:
; digit-prefixed is a case and must declare `; expect N`.
(pub emacro pick3 ((pick3 t b rest ...)
   (if t b (pick3 rest ...)))
  ((pick3 els)
   els))

; A helper and the macro whose template calls it: the template's
; `addOne` is a FREE identifier, so it means this module's macro
; wherever `viaHelper` is invoked from.
(pub emacro addOne ((addOne x) (+ x 1)))

(pub emacro viaHelper ((viaHelper x) (addOne x)))
