; expect 42
; `(struct Name field...)` builds a struct and is distinct from
; `(Name ...)`. It is a keyword-headed form: read as an application of
; a bare name it drew a false AX3001, and two, since its type name
; landed where an argument goes.
(struct P
  (x : Int)
  (y : Int))

(:: main Int)
(fn (main)
  (let (
    (p (struct P 40 2))
  )
    (+ p.x p.y)))
