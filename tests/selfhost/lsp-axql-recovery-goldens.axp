(import core)
(import lexer)
(import parser)
(import lsp)
(import jsonrpc)
(import Vec)
(import Str)
(import IO)

(:: say (-> Int Bool ()))
;@axiom:effect(io)
(fn (say n good)
  (println "{n} {good}"))

(:: idx (-> (Option Int) (Option Int) Bool))
(fn (idx actual expected)
  (match expected
    ((None) (isNone actual))
    ((Some want)
      (match actual
        ((None) false)
        ((Some got) (== got want)))
    )))

(:: at (-> String String Int))
(fn (at source needle)
  (match (strFind source needle 0)
    ((None) __indexTrap)
    ((Some i) i)))

(:: request (-> String String ()))
;@axiom:effect(io)
(fn (request title source)
  {
    (println "CASE {title}")
    (println (jsonWrite (lspDocumentSymbols source)))
    (println (jsonWrite (lspSemanticTokens source)))
    (match (lspParse source)
      ((ParseFailed _) (println "failed"))
      ((ParseSuccess nodes position)
        {
          (let lossy (lspParseLossy (ParseSuccess nodes position)))
          (println "lossy {lossy}")
          (let output jsonArr)
          (lspLintDoc output source (lspLineIndex source) nodes)
          (println (jsonWrite output))
        }
      ))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (request "empty" "")
    (request "query-valid" "(fn (run) (axqSql \"SELECT 1\"))")
    (request "query-refused" "(fn (run) (axqSql \"SELECT * FROM\"))")
    (request "query-second-arg" "(fn (run) (axqExec db \"not sql\"))")
    (request "query-wrong-arg" "(fn (run) (axqExec \"not sql\"))")
    (request "query-script" "(fn (run) (axqExecBatch db \"SELECT 1; SELECT 2\"))")
    (request "query-escaped" "(fn (run) (axqSql \"SELECT\\nFROM\"))")
    (request "query-qualified" "(fn (run) (Axql::axqSql \"SELECT * FROM\"))")
    (request "open-string" "(fn (run) \"unfinished\n(fn (next) 2)")
    (request "open-form" "(fn (run x) (+ x 1)")
    (request "bad-nested" "(fn (run) (+ 1 (* 2 )))\n(fn (next) 2)")
    (request "stray-close" "(fn (run) 1))\n(fn (next) 2)")
    (request "open-vector" "(fn (run) [1 2)\n(fn (next) 2)")
    (request "unbound-quote" "\"unfinished")
    0
  })
