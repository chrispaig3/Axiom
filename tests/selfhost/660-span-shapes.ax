; expect 42
; All three shapes `fmt_span` chooses between, including the two this
; slice's own diagnostics never produce. A renderer whose contract is
; byte-identity should not carry a branch no test has ever taken - the
; multi-line shape is one `if` away from the shape that is exercised,
; and getting it wrong would stay invisible until the first diagnostic
; that spans lines.
;
; The source is "ab\ncd\nef": offsets 0,1 on line 1, 3,4 on line 2,
; 6,7 on line 3.
;   (2 2) zero-width  -> "1:3"      (start == end, both as line:col)
;   (0 2) within line -> "1:1-3"
;   (1 7) across      -> "1:2-3:2"
(import Str)
(import Vec)
(import Mem)
(import core)
(import diag)
(:: main Int)
(fn (main)
  (let ((src "ab\ncd\nef"))
    (if (&& (strEq (fmtSpan src (mkSpan 2 2)) "1:3")
            (&& (strEq (fmtSpan src (mkSpan 0 2)) "1:1-3")
                (strEq (fmtSpan src (mkSpan 1 7)) "1:2-3:2")))
        42
        7)))
