; The handle table under use and misuse, for `scripts/check-handles.sh`
; (docs/memory-model.md MM-PAR-8). One mode per run, chosen by the first
; argument; each prints lines the gate reads.
;
;   freed-get    a handle naming a mapped page, freed, and then asked
;                for: exits 85 without answering the page. A compiler
;                whose table check is ablated answers the page instead.
;   double-free  a handle freed twice: the second free exits 85.
;   churn N      four bindings each make, check and free N handles of
;                their own through the raw primitives, all at once.
;                Prints `churn C checked, M wrong`: every handle must
;                answer its own address. Under `--threads` the four
;                share one table and its free list.
;   race N       N times, two bindings meet at a barrier and free one
;                handle at once, each inside a recovery point. Prints
;                `race F of N frees returned`. Under `--threads` the
;                bindings share the table, so exactly one free per round
;                returns and the other traps 85; forked bindings each
;                free their own copy, so both return.
;   sibling      a binding frees a handle, and the parent asks for it
;                after the join. Prints `sibling-free status S`: 1, the
;                get returned, when the binding was a forked child whose
;                table was its own copy; 85 under `--threads`, where the
;                table is the parent's too.
;   double-join  a binding joined twice: the second join exits 85
;                without reading the unmapped page.
;   thread-pid   the pid of a thread binding's handle: exits 85, because
;                a thread's handle is another kind than a process's and
;                has no pid to answer.
;   cross-join   a forked binding's handle joined by the thread join:
;                exits 85 instead of reading the pid as a `pthread_t`.
(import IO)
(import Sys)
(import Str)
(import Err)

(:: argInt (-> Int Int))
;@axiom:effect(io)
(fn (argInt i)
  (match (strParseInt (sysArg i))
    ((Some v) v)
    ((None) 0)))

(:: newH (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (newH kind addr)
  (__handle_new kind addr))

(:: getH (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (getH kind h)
  (__handle_get kind h))

(:: freeH (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (freeH kind h)
  (__handle_free kind h))

; ---- misuse ---------------------------------------------------------------
; A handle of kind 13 naming a fresh mapped page.
(:: pageHandle Int)
;@axiom:effect(io)
(fn (pageHandle)
  (match (sysMapShared 4096)
    ((Ok page) (newH 13 page))
    ((Err e) 0)))

(:: freedGet Int)
;@axiom:effect(io)
(fn (freedGet)
  (let ((h pageHandle))
    {
      (freeH 13 h)
      (println "freed")
      (getH 13 h)
      (println "UNREACHABLE: a get of a freed handle returned")
      1
    }))

(:: doubleFree Int)
;@axiom:effect(io)
(fn (doubleFree)
  (let ((h pageHandle))
    {
      (freeH 13 h)
      (println "freed")
      (freeH 13 h)
      (println "UNREACHABLE: a second free returned")
      1
    }))

; ---- churn ----------------------------------------------------------------
; `n` handles of kind 11, each naming an address of its own, made,
; checked and freed; answers how many answered a wrong address.
(:: churnOne (-> Int Int Int))
(fn (churnOne who n)
  (let ((mut wrong 0))
    {
      (for i in 0..n
        (let ((addr (+ (* who 1000000000) (* i 16))))
          (let ((h (newH 11 addr)))
            {
              (if (== (getH 11 h) addr)
                0
                (set wrong (+ wrong 1)))
              (if (== (freeH 11 h) addr)
                0
                (set wrong (+ wrong 1)))
            })))
      wrong
    }))

(:: churn (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (churn n)
  (parallel p (
    (a (churnOne 1 n))
    (b (churnOne 2 n))
    (c (churnOne 3 n))
    (d (churnOne 4 n))
  )
    (let (
      (checked (* 4 n))
      (wrong (+ a (+ b (+ c d))))
    )
      {
        (println "churn {checked} checked, {wrong} wrong")
        0
      })))

; ---- race -----------------------------------------------------------------
; Wait at the word `bar` until both bindings of a round are there.
(:: meet (-> Int Int))
;@axiom:effect(unsafe)
(fn (meet bar)
  {
    (__atomic_add bar 1)
    (while (< (__atomic_load bar) 2)
      0)
    0
  })

; Meet the sibling, then free `h` inside a recovery point: 1 when the
; free returned, 0 when it trapped.
(:: tryFree (-> Int Int Int))
(fn (tryFree bar h)
  (if (==
    (__axiom_recover
      __axiom_arena_mark
      (lambda (x)
        {
          (meet bar)
          (freeH 12 h)
          1
        }
      ))
    1)
    1
    0))

(:: resetBar (-> Int Int))
;@axiom:effect(unsafe)
(fn (resetBar bar)
  {
    (__atomic_store bar 0)
    0
  })

(:: race (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (race n)
  (match (sysMapShared 4096)
    ((Ok bar)
      (let ((mut freed 0))
        {
          (for i in 0..n
            (let ((h (newH 12 4096)))
              {
                (resetBar bar)
                (parallel p (
                  (a (tryFree bar h))
                  (b (tryFree bar h))
                )
                  (set freed (+ freed (+ a b))))
              }))
          (println "race {freed} of {n} frees returned")
          0
        })
    )
    ((Err e) 2)))

; ---- sibling --------------------------------------------------------------
(:: freeIt (-> Int Int))
(fn (freeIt h)
  {
    (freeH 14 h)
    1
  })

(:: getAfter (-> Int Int))
(fn (getAfter h)
  (__axiom_recover
    __axiom_arena_mark
    (lambda (x)
      {
        (getH 14 h)
        1
      }
    )))

(:: sibling Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (sibling)
  (let ((h (newH 14 4096)))
    (parallel p ((a (freeIt h)))
      (let ((st (getAfter h)))
        {
          (println "sibling-free status {st}")
          0
        }))))

; ---- the kinds of spawn handle --------------------------------------------
(:: doubleJoin Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (doubleJoin)
  (let ((h 
    (__par_spawn
      (lambda (x) (+ x 1))
      41)))
    {
      (println (__par_join h))
      (println (__par_join h))
      (println "UNREACHABLE: a second join returned")
      1
    }))

(:: threadPid Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
(fn (threadPid)
  (let ((h 
    (__thread_spawn
      (lambda (x) (+ x 1))
      1)))
    {
      (println "spawned")
      (println (__spawn_pid h))
      (println "UNREACHABLE: a thread's handle answered a pid")
      1
    }))

(:: crossJoin Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (crossJoin)
  (let ((h 
    (__proc_spawn
      (lambda (x) (+ x 1))
      1)))
    {
      (println "spawned")
      (println (__thread_join h))
      (println "UNREACHABLE: a process's handle joined as a thread")
      1
    }))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (let ((mode (sysArg 1)))
    (if (strEq mode "freed-get")
      freedGet
      (if (strEq mode "double-free")
        doubleFree
          (if (strEq mode "churn")
            (churn (argInt 2))
            (if (strEq mode "race")
              (race (argInt 2))
              (if (strEq mode "sibling")
                sibling
                (if (strEq mode "double-join")
                  doubleJoin
                  (if (strEq mode "thread-pid")
                    threadPid
                    (if (strEq mode "cross-join")
                      crossJoin
                      {
                        (println "usage: handle-load freed-get | double-free | churn N | race N | sibling | double-join | thread-pid | cross-join")
                        2
                      }))))))))))
