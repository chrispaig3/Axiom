; The mutex and the timed waits under load, for `scripts/check-task.sh`
; (R-C2, MM-PAR-11 and MM-PAR-12). One mode per run, chosen by the
; first argument; each prints lines the gate reads.
;
;   excl L N   four bindings, released together by a barrier, each add
;              1 to one PLAIN word in a shared mapping N times - under
;              the mutex when L is 1, with no lock at all when L is 0.
;              Prints `count C` and `ok` when C is 4N, `lost K` when K
;              updates vanished. The unlocked run is the control that
;              proves the count can see a race: it must LOSE updates.
;              Each iteration also reads an unrelated word atomically,
;              so the compiler cannot fold N plain increments into one.
;   timed MS   the timed waits against the clock: a receive on an empty
;              channel, a send on a full one, and a lock held by a
;              sibling for 3 MS, each asked to wait MS; then a receive
;              and a lock that are satisfied at about MS/2 of a 10 MS
;              wait. Prints `<what> <code> <elapsed us>`: the gate
;              requires the timed-out ones in [MS, MS + slack] and never
;              before MS, and the satisfied ones well before 10 MS.
;   dead       a forked binding takes the lock and is SIGKILLed and
;              reaped holding it. Prints what a timed and an untimed
;              lock answer afterwards, and when.
;   zombie     a forked binding takes the lock and exits holding it (a
;              raw exit inside the guard's scope), and is NOT reaped:
;              a zombie, which `kill(pid, 0)` still answers for. First a `parallel` binding makes a 300 ms
;              timed lock (`sibling-timed`): under `--threads` it is a
;              thread of the holder's parent and its `waitid` sees the
;              exit, so it answers 1004; under processes it is the
;              holder's sibling, which no look can see through, so it
;              answers 1001 - the stated limit. Then, on a second mutex
;              and holder, the parent's own timed lock of 2 s
;              (`zombie-timed`, 1004 within a slice or so) and an untimed
;              one (`zombie-untimed`), then the holder's status and
;              whether the mutex reads poisoned.
;
; A lock is held by its guard and let go when the guard's scope ends
; (MM-PAR-15), so nothing here unlocks by hand.
(import IO)
(import Sys)
(import Str)
(import Mem)
(import Err)
(import Chan)
(import Sync)

(:: argInt (-> Int Int))
;@axiom:effect(io)
(fn (argInt i)
  (match (strParseInt (sysArg i))
    ((Some v) v)
    ((None) 0)))

; Sleep `ms` milliseconds on a word nobody changes.
(:: nap (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (nap idle ms)
  {
    (sysWaitWordTimeout idle 0 (* ms 1000000))
    0
  })

(:: codeOf (-> (Result a Error) Int))
(fn (codeOf r)
  (match r
    ((Ok g) 0)
    ((Err e) (errCode e))))

; ---- excl ----------------------------------------------------------------
(:: arrive (-> Int Int))
;@axiom:effect(unsafe)
(fn (arrive bar)
  {
    (__atomic_add bar 1)
    (while (< (__atomic_load bar) 4)
      0)
    0
  })

(:: fence (-> Int Int))
;@axiom:effect(unsafe)
(fn (fence w)
  (__atomic_load w))

(:: bump (-> Mutex Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (bump m cell n locked)
  {
    (arrive (+ cell 8))
    (for i in 0..n
      (if (== locked 1)
        (match (mutexLock m)
          ((Ok g)
            (memSetWord cell 0 (+ (memGetWord cell 0) 1))
          )
          ((Err e) 0))
        {
          (fence (+ cell 16))
          (memSetWord cell 0 (+ (memGetWord cell 0) 1))
        }))
    0
  })

(:: excl (-> Mutex Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (excl m cell n locked)
  (parallel p (
    (a (bump m cell n locked))
    (b (bump m cell n locked))
    (c (bump m cell n locked))
    (d (bump m cell n locked))
  )
    (+ a (+ b (+ c d)))))

; ---- timed ---------------------------------------------------------------
(:: elapsedSince (-> Int Int Int))
;@axiom:effect(io)
(fn (elapsedSince buf t0)
  (- (sysTimeoutMicros buf) t0))

(:: say (-> String Int Int))
;@axiom:effect(io)
(fn (say what v)
  {
    (println "{what} {v}")
    0
  })

(:: report (-> String Int Int Int))
;@axiom:effect(io)
(fn (report what code us)
  {
    (println "{what} {code} {us}")
    0
  })

(:: recvCode (-> (Result (Option Int) Error) Int))
(fn (recvCode r)
  (match r
    ((Ok (Some v)) 0)
    ((Ok (None)) (- 0 1))
    ((Err e) (errCode e))))

(:: sendCode (-> (Result Bool Error) Int))
(fn (sendCode r)
  (match r
    ((Ok b) 0)
    ((Err e) (errCode e))))

; Hold the lock for `ms`, raising `flag` once it is held.
(:: holdFor (-> Mutex Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (holdFor m flag idle ms)
  (match (mutexLock m)
    ((Ok g)
      {
        (memSetWord flag 0 1)
        (sysWakeWord flag)
        (nap idle ms)
        0
      }
    )
    ((Err e) 1)))

; Wait for `flag`, then time a lock that may wait `ms`.
(:: lockAfter (-> Mutex Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (lockAfter m flag ms what)
  (let ((buf (memAlloc 16)))
    {
      (while (== (memGetWord flag 0) 0)
        (sysWaitWordTimeout flag 0 1000000))
      (let ((t0 (sysTimeoutMicros buf)))
        (let ((r (mutexLockTimeout m (* ms 1000000))))
          (let ((us (elapsedSince buf t0)))
            {
              (report
                (if (== what 0)
                  "lock-timeout"
                  "lock-got")
                (codeOf r)
                us)
            })))
    }))

(:: sendLater (-> Chan Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (sendLater ch idle ms)
  {
    (nap idle ms)
    (if (chanSend ch 42)
      0
      1)
  })

(:: recvWithin (-> Chan Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (recvWithin ch ms)
  (let ((buf (memAlloc 16)))
    (let ((t0 (sysTimeoutMicros buf)))
      (let ((r (chanRecvTimeout ch (* ms 1000000))))
        (report "recv-got" (recvCode r) (elapsedSince buf t0))))))

(:: timed (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (timed idle ms)
  (let ((buf (memAlloc 16)))
    (match (chanNew 1)
      ((Ok ch)
        (match (mutexNew)
          ((Ok m)
            (match (sysMapShared 4096)
              ((Ok flag)
                {
                  (let ((t0 (sysTimeoutMicros buf)))
                    (let ((r (chanRecvTimeout ch (* ms 1000000))))
                      (report "recv-timeout" (recvCode r) (elapsedSince buf t0))))
                  (chanSend ch 1)
                  (let ((t0 (sysTimeoutMicros buf)))
                    (let ((r (chanSendTimeout ch 2 (* ms 1000000))))
                      (report "send-timeout" (sendCode r) (elapsedSince buf t0))))
                  (chanRecv ch)
                  (parallel p (
                    (a (holdFor m flag idle (* 3 ms)))
                    (b (lockAfter m flag ms 0))
                  )
                    (+ a b))
                  (memSetWord flag 0 0)
                  (parallel q (
                    (a (holdFor m flag idle (/ ms 2)))
                    (b (lockAfter m flag (* 10 ms) 1))
                  )
                    (+ a b))
                  (parallel r (
                    (a (sendLater ch idle (/ ms 2)))
                    (b (recvWithin ch (* 10 ms)))
                  )
                    (+ a b))
                  0
                }
              )
              ((Err e) 3))
          )
          ((Err e) 2))
      )
      ((Err e) 1))))

; ---- dead ----------------------------------------------------------------
(:: holdForever (-> Mutex Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (holdForever m flag idle)
  (match (mutexLock m)
    ((Ok g)
      {
        (memSetWord flag 0 1)
        (sysWakeWord flag)
        (while (== 0 0)
          (nap idle 1000))
        0
      }
    )
    ((Err e) 9)))

; The pid of a forked binding, through its live `Spawn` handle.
(:: handlePid (-> Spawn Int))
(fn (handlePid h)
  (__spawn_pid h))

(:: dead (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (dead idle)
  (match (mutexNew)
    ((Ok m)
      (match (sysMapShared 4096)
        ((Ok flag)
          (let (
            (buf (memAlloc 16))
            (cell (memAlloc 8))
            (h (__proc_spawn
              (lambda (x) (holdForever m flag idle))
              0))
          )
            {
              (while (== (memGetWord flag 0) 0)
                (sysWaitWordTimeout flag 0 1000000))
              (let ((t0 (sysTimeoutMicros buf)))
                (let ((r (mutexLockTimeout m 250000000)))
                  (report "alive-timed" (codeOf r) (elapsedSince buf t0))))
              (match (sysKill (handlePid h) 9)
                ((Ok z) 0)
                ((Err e) 0))
              (__proc_join_nr h cell)
              (say "holder-status" (memGetWord cell 0))
              (let ((t0 (sysTimeoutMicros buf)))
                (let ((r (mutexLockTimeout m 2000000000)))
                  (report "dead-timed" (codeOf r) (elapsedSince buf t0))))
              (let ((t0 (sysTimeoutMicros buf)))
                (let ((r (mutexLock m)))
                  (report "dead-untimed" (codeOf r) (elapsedSince buf t0))))
              (say
                "poisoned"
                (if (mutexOwnerDead m)
                  1
                  0))
              0
            })
        )
        ((Err e) 2))
    )
    ((Err e) 1)))

; ---- zombie --------------------------------------------------------------
; Take the lock, raise `flag`, and end: the binding exits holding it, a
; raw exit inside the guard's scope, which the guard never sees end.
(:: lockAndExit (-> Mutex Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (lockAndExit m flag)
  (match (mutexLock m)
    ((Ok g)
      {
        (memSetWord flag 0 1)
        (sysWakeWord flag)
        (sysExitWith 0)
      }
    )
    ((Err e) 9)))

; A forked binding that takes `m` and exits holding it.
(:: spawnExit (-> Mutex Int Spawn))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (spawnExit m flag)
  (__proc_spawn
    (lambda (x) (lockAndExit m flag))
    0))

(:: awaitFlag (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (awaitFlag flag)
  {
    (while (== (memGetWord flag 0) 0)
      (sysWaitWordTimeout flag 0 1000000))
    0
  })

; A timed lock of `ms` milliseconds, reported as `what`.
(:: timedLock (-> Mutex Int String Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (timedLock m ms what)
  (let ((buf (memAlloc 16)))
    (let ((t0 (sysTimeoutMicros buf)))
      (let ((r (mutexLockTimeout m (* ms 1000000))))
        (report what (codeOf r) (elapsedSince buf t0))))))

(:: zombie (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (zombie idle)
  (match (mutexNew)
    ((Ok s)
      (match (mutexNew)
        ((Ok m)
          (match (sysMapShared 4096)
            ((Ok flag)
              (let (
                (buf (memAlloc 16))
                (cell (memAlloc 8))
              )
                {
                  ; A binding beside the parent asks about the zombie.
                  (let ((h (spawnExit s flag)))
                    {
                      (awaitFlag flag)
                      (parallel p ((a (timedLock s 300 "sibling-timed")))
                        a)
                      (__proc_join_nr h cell)
                    })
                  (memSetWord flag 0 0)
                  ; The parent asks about its own zombie child.
                  (let ((h (spawnExit m flag)))
                    {
                      (awaitFlag flag)
                      (timedLock m 2000 "zombie-timed")
                      (let ((t0 (sysTimeoutMicros buf)))
                        (let ((r (mutexLock m)))
                          (report "zombie-untimed" (codeOf r) (elapsedSince buf t0))))
                      (__proc_join_nr h cell)
                      (say "holder-status" (memGetWord cell 0))
                      (say
                        "poisoned"
                        (if (mutexOwnerDead m)
                          1
                          0))
                    })
                  0
                })
            )
            ((Err e) 3))
        )
        ((Err e) 2))
    )
    ((Err e) 1)))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (let ((mode (sysArg 1)))
    (match (sysMapShared 4096)
      ((Ok idle)
        (if (strEq mode "excl")
          (match (mutexNew)
            ((Ok m)
              (match (sysMapShared 4096)
                ((Ok cell)
                  (let ((n (argInt 3)))
                    {
                      (excl m cell n (argInt 2))
                      (let ((c (memGetWord cell 0)))
                        (if (== c (* 4 n))
                          (println "count {c} ok")
                          (let ((lost (- (* 4 n) c)))
                            (println "count {c} lost {lost}"))))
                      0
                    })
                )
                ((Err e) 2))
            )
            ((Err e) 1))
          (if (strEq mode "timed")
            (timed idle (argInt 2))
            (if (strEq mode "dead")
              (dead idle)
              (if (strEq mode "zombie")
                (zombie idle)
                {
                  (println "usage: sync-load excl L N | timed MS | dead | zombie")
                  2
                }))))
      )
      ((Err e) 1))))
