; A single-bit fault in a live handle word, at the one boundary the
; runtime checks: the handle table (docs/memory-model.md MM-PAR-8).
; `scripts/check-handles.sh` section 7 runs it once per bit.
;
; Two live handles, `a` then `b`, each naming a mapped page of its own.
; `handle-bitflip K` flips bit K of `a`'s word and asks the table for
; the result. The table must refuse the word (status 85, before the
; page is touched) unless the flip happens to spell the other live
; handle, which no check can tell from the real one: then the table
; answers `b`'s page, and this prints `b`. `handle-bitflip -1` flips
; nothing, prints both handle words for the gate to predict that case,
; and then `a`.
;
; A flip in memory the runtime doesn't check, such as a `Vec`'s length
; or a count word, isn't detected, and this doesn't claim otherwise.
(import IO)
(import Str)
(import Fmt)
(import Sys)
(import Err)

(:: newH (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (newH kind addr)
  (__handle_new kind addr))

(:: getH (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (getH kind h)
  (__handle_get kind h))

; A fresh page, or the program's end.
(:: page Int)
;@axiom:effect(io)
(fn (page)
  (match (sysMapShared 4096)
    ((Ok p) p)
    ((Err e) (die "sysMapShared failed" 1))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (k (match (strParseInt (sysArg 1))
      ((Some n) n)
      ((None) (- 0 1))))
    (pa page)
    (pb page)
  )
    (let (
      (a (newH 15 pa))
      (b (newH 15 pb))
    )
      {
        (if (< k 0)
          (println (concat "words " (concat (fmtInt a) (concat " " (fmtInt b)))))
          0)
        (let ((got (getH 15 (if (< k 0) a (^ a (<< 1 k))))))
          (println (if (== got pa)
            "a"
            (if (== got pb)
              "b"
              "neither"))))
        0
      })))
