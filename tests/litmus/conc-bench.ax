; What the concurrency primitives cost, for `scripts/bench-concurrency.sh`
; (docs/assurance/scorecard.md). One mode per run, chosen by the first
; argument. Each mode times itself with `sysTimeoutMicros` around the
; work alone - process start-up and the build are outside it - checks
; its own answer, and prints `<mode> <answer> <microseconds>`; a wrong
; answer prints `WRONG` and exits 1, so no figure comes from work that
; was skipped.
;
;   spawn N      N `parallel` forms of two trivial bindings, one after
;                another: the spawn-and-join round trip, in whichever
;                lowering the program was built with.
;   tasks N W B  `taskMap` over N tasks at width W, each answering B
;                bytes: the fork, the answer's copy through the slab and
;                the join.
;   mutex N K    K bindings each lock, add 1 to a plain shared word and
;                unlock, N times; K 1 is the uncontended cost.
;   chan N       one binding sends 1..N through a 64-word channel, one
;                receives and sums them.
;   chan1 N      one binding sends each of 1..N and receives it back, on
;                a 64-word channel no other binding touches: the
;                uncontended cost of a send and a receive.
;   latency N    N pools of one task each, one after another; prints the
;                50th, 90th and 99th percentile and the worst round trip.
;
; The scaling modes. The work is a pure hash of every `i` in `0 .. W`,
; summed (wrapping), so any split of the range answers the same sum,
; and the whole-process harness in `scripts/bench-concurrency.sh`
; checks that sum on every run.
;
;   nop          nothing: the process start-up the harness subtracts.
;   work W       the sum in one loop.
;   bind K W     one `parallel` form of K bindings (1, 2, 4 or 8), each
;                summing a contiguous K-th of the range.
;   pool K W     `parMapWords` over K tasks at width K, the same split.
;   grain K W R  R `parallel` forms in a row, each of K bindings summing
;                W terms: how small a piece of work a binding may be
;                before the spawn costs more than it buys.
;   grainseq K W R   the same K * W * R terms in one loop.
;   fshare K S N K bindings (2, 4 or 8) each adding 1 to its own word N
;                times with `__atomic_add`, the words S bytes apart in
;                one shared page: S 8 puts them in one cache line.
;   pingpong N   two bindings hand one word back and forth on two
;                channels N times; prints the percentiles of the round
;                trip, each timed on its own.
(import IO)
(import Sys)
(import Str)
(import Mem)
(import Vec)
(import Err)
(import Chan)
(import Sync)
(import Task)
(import Par)

(:: argInt (-> Int Int))
;@axiom:effect(io)
(fn (argInt i)
  (match (strParseInt (sysArg i))
    ((Some v) v)
    ((None) 0)))

(:: report (-> String Int Int Int Int))
;@axiom:effect(io)
(fn (report mode answer want us)
  (if (== answer want)
    {
      (println "{mode} {answer} {us}")
      0
    }
    {
      (println "{mode} WRONG {answer} wanted {want}")
      1
    }))

; ---- spawn -------------------------------------------------------------
(:: pair (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (pair i)
  (parallel p (
    (a (+ i 1))
    (b (+ i 2))
  )
    (+ a b)))

(:: spawnRun (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (spawnRun buf n)
  (let (
    (t0 (sysTimeoutMicros buf))
    (mut sum 0)
  )
    {
      (for i 0 n
        (set sum (+ sum (pair i))))
      (report "spawn" sum (+ (* n 3) (* n (- n 1))) (- (sysTimeoutMicros buf) t0))
    }))

; ---- tasks -------------------------------------------------------------
(:: answerOf (-> Int Int String))
(fn (answerOf bytes i)
  (strAlloc bytes))

(:: lenOf (-> (Result String Error) Int))
(fn (lenOf r)
  (match r
    ((Ok s) (strLen s))
    ((Err e) 0)))

(:: tasksRun (-> Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (tasksRun buf n w bytes)
  (let ((t0 (sysTimeoutMicros buf)))
    (let (
      (rs (taskMap
        (lambda (i) (answerOf bytes i))
        n
        w
        (+ bytes 16)))
      (mut total 0)
    )
      {
        (for i 0 n
          (set total (+ total (lenOf (vecGet rs i)))))
        (report "tasks" total (* n bytes) (- (sysTimeoutMicros buf) t0))
      })))

; ---- mutex -------------------------------------------------------------
(:: bump (-> Mutex Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(fn (bump m cell n)
  {
    (for i 0 n
      (match (mutexLock m)
        ((Ok g)
          {
            (memSetWord cell 0 (+ (memGetWord cell 0) 1))
            (let ((_ (mutexUnlock m g))) 0)
          }
        )
        ((Err e) 0)))
    0
  })

(:: bumpK (-> Mutex Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (bumpK m cell n k)
  (if (== k 1)
    (bump m cell n)
    (parallel p (
      (a (bump m cell n))
      (b (bump m cell n))
      (c (bump m cell n))
      (d (bump m cell n))
    )
      (+ a (+ b (+ c d))))))

(:: mutexRun (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (mutexRun buf n k)
  (match (mutexNew)
    ((Ok m)
      (match (sysMapShared 4096)
        ((Ok cell)
          (let ((t0 (sysTimeoutMicros buf)))
            {
              (bumpK m cell n k)
              (let ((us (- (sysTimeoutMicros buf) t0)))
                (report
                  "mutex"
                  (memGetWord cell 0)
                  (*
                    n
                    (if (== k 1)
                      1
                      4))
                  us))
            })
        )
        ((Err e) 2))
    )
    ((Err e) 1)))

; ---- chan --------------------------------------------------------------
(:: produce (-> Chan Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (produce ch n)
  {
    (for i 1 (+ n 1)
      (chanSend ch i))
    (chanClose ch)
    0
  })

(:: drain (-> Chan Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(fn (drain ch cell)
  (let (
    (mut sum 0)
    (mut going 1)
  )
    {
      (while (== going 1)
        (match (chanRecv ch)
          ((Some v)
            (set sum (+ sum v))
          )
          ((None)
            (set going 0)
          )))
      (memSetWord cell 0 sum)
      0
    }))

(:: chanRun (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (chanRun buf n)
  (match (chanNew 64)
    ((Ok ch)
      (match (sysMapShared 4096)
        ((Ok cell)
          (let ((t0 (sysTimeoutMicros buf)))
            {
              (parallel p (
                (a (produce ch n))
                (b (drain ch cell))
              )
                (+ a b))
              (let ((us (- (sysTimeoutMicros buf) t0)))
                (report "chan" (memGetWord cell 0) (/ (* n (+ n 1)) 2) us))
            })
        )
        ((Err e) 2))
    )
    ((Err e) 1)))

; ---- chan1 -------------------------------------------------------------
; One binding sends a word and receives it back, N times, on a 64-word
; channel nobody else touches: two uncontended calls, each one lock and
; one unlock, per word.
(:: chanOneRun (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
;@axiom:precondition(`buf` names 16 live writable bytes)
(fn (chanOneRun buf n)
  (match (chanNew 64)
    ((Ok ch)
      (let (
        (t0 (sysTimeoutMicros buf))
        (mut sum 0)
      )
        {
          (for i 1 (+ n 1)
            {
              (chanSend ch i)
              (match (chanRecv ch)
                ((Some v)
                  (set sum (+ sum v))
                )
                ((None) 0))
            })
          (let ((us (- (sysTimeoutMicros buf) t0)))
            {
              (let ((_ (chanFree ch))) 0)
              (report "chan1" sum (/ (* n (+ n 1)) 2) us)
            })
        })
    )
    ((Err e) 1)))

; ---- latency -----------------------------------------------------------
(:: one (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (one buf)
  (let ((t0 (sysTimeoutMicros buf)))
    {
      (taskMap
        (lambda (i) "ok")
        1
        1
        16)
      (- (sysTimeoutMicros buf) t0)
    }))

(:: pct (-> (Vec Int) Int Int))
(fn (pct v p)
  (vecGet v (/ (* (- (vecLen v) 1) p) 100)))

(:: latencyRun (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (latencyRun buf n)
  (let ((v (vecWithCapacity n)))
    {
      (for i 0 n
        (vecPush v (one buf)))
      (let (
        (sorted (vecSort v))
        (p50 (pct sorted 50))
        (p90 (pct sorted 90))
        (p99 (pct sorted 99))
        (worst (pct sorted 100))
      )
        (println "latency {n} p50 {p50} p90 {p90} p99 {p99} max {worst}"))
      0
    }))

; ---- scaling ---------------------------------------------------------
; splitmix64's finaliser; `*` and `+` wrap.
(:: mixHash (-> Int Int))
(fn (mixHash i)
  (let ((z (+ (* i 7046029254386353131) 1442695040888963407)))
    (let ((a (* (^ z (>> z 30)) 5573014789349097917)))
      (let ((b (* (^ a (>> a 27)) 1181783497276652981)))
        (^ b (>> b 31))))))

(:: workRange (-> Int Int Int))
(fn (workRange lo hi)
  (let ((mut acc 0))
    {
      (for i lo hi
        (set acc (+ acc (mixHash i))))
      acc
    }))

; Part `k` of `parts` of `base .. base + w`.
(:: part (-> Int Int Int Int Int))
(fn (part base w parts k)
  (workRange (+ base (/ (* w k) parts)) (+ base (/ (* w (+ k 1)) parts))))

(:: bindWork (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (bindWork parts base w)
  (if (== parts 1)
    (parallel p (
      (a (part base w 1 0))
    )
      a)
    (if (== parts 2)
      (parallel p (
        (a (part base w 2 0))
        (b (part base w 2 1))
      )
        (+ a b))
      (if (== parts 4)
        (parallel p (
          (a (part base w 4 0))
          (b (part base w 4 1))
          (c (part base w 4 2))
          (d (part base w 4 3))
        )
          (+ (+ a b) (+ c d)))
        (parallel p (
          (a (part base w 8 0))
          (b (part base w 8 1))
          (c (part base w 8 2))
          (d (part base w 8 3))
          (e (part base w 8 4))
          (f (part base w 8 5))
          (g (part base w 8 6))
          (h (part base w 8 7))
        )
          (+ (+ (+ a b) (+ c d)) (+ (+ e f) (+ g h))))))))

(:: poolWork (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (poolWork parts w)
  (vecSum (parMapWords
    (lambda (k) (part 0 w parts k))
    parts
    parts)))

; R forms of K bindings, binding k of round r summing the W terms from
; (r * K + k) * W: the same terms `grainSeq` sums in one loop, so the
; two answer the same sum and no round repeats another's work.
(:: grainPar (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (grainPar parts w rounds)
  (let ((mut acc 0))
    {
      (for r 0 rounds
        (set acc (+ acc (bindWork parts (* r (* parts w)) (* parts w)))))
      acc
    }))

(:: grainSeq (-> Int Int Int Int))
(fn (grainSeq parts w rounds)
  (workRange 0 (* rounds (* parts w))))

; `mode answer microseconds`, the time since `t0`.
(:: timed (-> String Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
(fn (timed mode buf t0 answer)
  (let ((us (- (sysTimeoutMicros buf) t0)))
    {
      (println "{mode} {answer} {us}")
      0
    }))

; ---- false sharing -----------------------------------------------------
; Add 1 to the word at `addr`, `n` times, each an atomic read-modify-
; write, so every add needs the cache line to itself.
(:: hammer (-> Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`addr` names a live, 8-byte aligned word)
(fn (hammer addr n)
  {
    (for i 0 n
      (__atomic_add addr 1))
    0
  })

(:: hammerK (-> Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`base` names a page with 8 live words `stride` bytes apart)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (hammerK parts base stride n)
  (if (== parts 2)
    (parallel p (
      (a (hammer base n))
      (b (hammer (+ base stride) n))
    )
      (+ a b))
    (if (== parts 4)
      (parallel p (
        (a (hammer base n))
        (b (hammer (+ base stride) n))
        (c (hammer (+ base (* 2 stride)) n))
        (d (hammer (+ base (* 3 stride)) n))
      )
        (+ (+ a b) (+ c d)))
      (parallel p (
        (a (hammer base n))
        (b (hammer (+ base stride) n))
        (c (hammer (+ base (* 2 stride)) n))
        (d (hammer (+ base (* 3 stride)) n))
        (e (hammer (+ base (* 4 stride)) n))
        (f (hammer (+ base (* 5 stride)) n))
        (g (hammer (+ base (* 6 stride)) n))
        (h (hammer (+ base (* 7 stride)) n))
      )
        (+ (+ (+ a b) (+ c d)) (+ (+ e f) (+ g h)))))))

(:: fshareRun (-> Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (fshareRun buf parts stride n)
  (match (sysMapShared 4096)
    ((Ok page)
      (let ((t0 (sysTimeoutMicros buf)))
        {
          (hammerK parts page stride n)
          (let (
            (us (- (sysTimeoutMicros buf) t0))
            (mut total 0)
          )
            {
              (for k 0 parts
                (set total (+ total (memGetWord (+ page (* k stride)) 0))))
              (report "fshare" total (* parts n) us)
            })
        })
    )
    ((Err e) 2)))

; ---- channel hand-off latency -------------------------------------------
; Binding a sends i, waits for it back, and records each round trip in
; microseconds in word i of the shared `log`; binding b sends back what
; it receives.
(:: pinger (-> Chan Chan Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
;@axiom:precondition(`log` names `n` live words)
(fn (pinger c1 c2 log n)
  (let ((buf (memAlloc 16)))
    {
      (for i 0 n
        (let ((t0 (sysTimeoutMicros buf)))
          {
            (chanSend c1 i)
            (match (chanRecv c2)
              ((Some v) 0)
              ((None) 0))
            (memSetWord log i (- (sysTimeoutMicros buf) t0))
          }))
      0
    }))

(:: ponger (-> Chan Chan Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (ponger c1 c2 n)
  (let ((mut sum 0))
    {
      (for i 0 n
        (match (chanRecv c1)
          ((Some v)
            {
              (set sum (+ sum v))
              (chanSend c2 v)
              0
            }
          )
          ((None) 0)))
      sum
    }))

(:: pingpongRun (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (pingpongRun n)
  (match (chanNew 1)
    ((Ok c1)
      (match (chanNew 1)
        ((Ok c2)
          (match (sysMapShared (* 8 (+ n 1)))
            ((Ok log)
              (let ((sum (parallel p (
                (a (pinger c1 c2 log n))
                (b (ponger c1 c2 n))
              )
                b)))
                (let ((v (vecWithCapacity n)))
                  {
                    (for i 0 n
                      (vecPush v (memGetWord log i)))
                    (let (
                      (sorted (vecSort v))
                      (p50 (pct sorted 50))
                      (p90 (pct sorted 90))
                      (p99 (pct sorted 99))
                      (worst (pct sorted 100))
                    )
                      (if (== sum (/ (* n (- n 1)) 2))
                        (println "pingpong {n} p50 {p50} p90 {p90} p99 {p99} max {worst}")
                        (println "pingpong WRONG {sum}")))
                    0
                  }))
            )
            ((Err e) 3))
        )
        ((Err e) 2))
    )
    ((Err e) 1)))

; The scaling, false-sharing and hand-off modes, and the usage line for
; a mode nothing knows.
(:: moreModes (-> Int String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`buf` names 16 live writable bytes)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (moreModes buf mode)
  (if (strEq mode "nop")
    0
    (if (strEq mode "work")
      (let ((t0 (sysTimeoutMicros buf)))
        (timed "work" buf t0 (workRange 0 (argInt 2))))
      (if (strEq mode "bind")
        (let ((t0 (sysTimeoutMicros buf)))
          (timed "bind" buf t0 (bindWork (argInt 2) 0 (argInt 3))))
        (if (strEq mode "pool")
          (let ((t0 (sysTimeoutMicros buf)))
            (timed "pool" buf t0 (poolWork (argInt 2) (argInt 3))))
          (if (strEq mode "grain")
            (let ((t0 (sysTimeoutMicros buf)))
              (timed "grain" buf t0 (grainPar (argInt 2) (argInt 3) (argInt 4))))
            (if (strEq mode "grainseq")
              (let ((t0 (sysTimeoutMicros buf)))
                (timed "grainseq" buf t0 (grainSeq (argInt 2) (argInt 3) (argInt 4))))
              (if (strEq mode "fshare")
                (fshareRun buf (argInt 2) (argInt 3) (argInt 4))
                (if (strEq mode "pingpong")
                  (pingpongRun (argInt 2))
                  {
                    (println "usage: conc-bench spawn N | tasks N W B | mutex N K | chan N | chan1 N | latency N | nop | work W | bind K W | pool K W | grain K W R | grainseq K W R | fshare K S N | pingpong N")
                    2
                  })))))))))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  (let (
    (mode (sysArg 1))
    (buf (memAlloc 16))
  )
    (if (strEq mode "spawn")
      (spawnRun buf (argInt 2))
      (if (strEq mode "tasks")
        (tasksRun buf (argInt 2) (argInt 3) (argInt 4))
        (if (strEq mode "mutex")
          (mutexRun buf (argInt 2) (argInt 3))
          (if (strEq mode "chan")
            (chanRun buf (argInt 2))
            (if (strEq mode "chan1")
              (chanOneRun buf (argInt 2))
              (if (strEq mode "latency")
                (latencyRun buf (argInt 2))
                (moreModes buf mode)))))))))
