(import Mem)

(:: step (-> Int Int Int))
;@axiom:restrict(no-alloc, no-recursion, strict)
;@axiom:effect(unsafe)
(fn (step buf i)
  {
    (memSetWord buf (% i 8) (* i i))
    (memGetWord buf (% i 8))
  })

(:: main Int)
(fn (main)
  (let (
    (buf (memAlloc 64))
    (mut i 0)
    (mut acc 0)
  )
    {
      (while (< i 1000)
        {
          (set acc (+ acc (step buf i)))
          (set i (+ i 1))
        })
      (% acc 256)
    }))
