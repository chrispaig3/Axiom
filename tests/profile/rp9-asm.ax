; RP-9: a function holding an `asm` form. The report can't see what the
; instructions do, so the restricted profile refuses one unless
; `--allow-asm spin` names it, and lists it as an obligation either way.
(:: spin Int)
;@axiom:effect(unsafe)
(fn (spin)
  (asm
    (aarch64 "yield")
    (x86_64 "pause")))

(:: main Int)
(fn (main)
  (spin))
