(import Sys.Platform)

; An interrupt handler that waits for a byte on its standard input. It
; allocates nothing and never recurses, so every other rule passes it;
; the read may suspend it until another party writes.
;@axiom:isr
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (tick)
  (__syscall3 sysRead 0 0 0))

(:: main Int)
(fn (main)
  0)
