{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "axiom",
      "camelcase": "Axiom",
      "scope": "source.axiom",
      "path": ".",
      "file-types": [
        "ax"
      ],
      "injection-regex": "^axiom$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.8.1",
    "license": "MIT",
    "description": "Axiom grammar for tree-sitter"
  }
}
