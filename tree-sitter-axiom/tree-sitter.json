{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "axiom",
      "camelcase": "Axiom",
      "scope": "source.axiom",
      "path": ".",
      "file-types": ["ax"],
      "injection-regex": "^axiom$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Axiom grammar for tree-sitter"
  }
}
