; Path - taking a filesystem path apart and putting one together.
;
; No syscalls: every function here is a decision about bytes, and the
; decision is always the same one - where is the last `/`, and is there
; a `.` after it. The module exists because `Sys` grew a directory
; lister, and a list of NAMES is not usable without a way to attach
; them back to the directory they came from.
;
; It also finishes a loose end this repository has been carrying since
; the filesystem surface first grew (the self-hosting record):
; `dirOfPath` and `withTrailingSlash` were private helpers in
; `self_host/codegen.ax` "because there was nowhere else to put them".
; There is now.
;
; ------------------------------------------------------------------
; EVERY ANSWER IS OWNED AND NUL-TERMINATED.
;
; That is a departure from `Str`, where slicing SHARES and a slice is
; deliberately not terminated - a tokenizer that copied every lexeme
; would allocate once per token, and `strSlice` exists so it does not
; have to.
;
; A path is not a token. Every path in a program is on its way to a
; syscall, and a syscall wants a `char*` ending in NUL, so a shared
; slice here would mean `(sysIsDir (strCStr (pathDir p)))` reading past
; the end of the answer into the rest of `p` - which for
; `"src/main.ax"` is `pathDir` answering `src/` and `strCStr` handing
; the kernel `src/main.ax`. Silent, and wrong in the direction that
; still finds a file.
;
; So these copy. A path is short and the copy is once per path, not
; once per byte of input.
; ------------------------------------------------------------------
(import Str)

; The last `/` in `p`, or `None`. Everything below is a decision about
; this one index. `compat/SENTINELS`'s direction rule is "absence
; wants `Option`", and this is the primitive every caller in this file
; goes through - `pathExtIndex` is the one exception, and it goes
; straight to the raw `-1` helper below because it needs the sentinel
; back in arithmetic (`(+ slash 1)` is 0, correctly, when there is no
; slash at all), not a value to branch on.
;
; Scanned backwards rather than with `strFindByte`'s forward walk,
; because the LAST separator is what splits a path and finding it
; forwards means finding all the others first.
(pub :: pathLastSlash (-> String (Option Int)))

(pub fn (pathLastSlash p)
  (let ((i (pathLastSlashFrom p (- (strLen p) 1))))
    (if (< i 0)
      None
      (Some i)
    )
  )
)

(:: pathLastSlashFrom (-> String Int Int))

(fn (pathLastSlashFrom p i)
  (if (< i 0)
    (- 0 1)
    (if (== (strByte p i) 47)
      i
      (pathLastSlashFrom p (- i 1))
    )
  )
)

; Everything up to and INCLUDING the last `/`, or "" when `p` names
; something in the working directory.
;
; The trailing slash is kept because the answer's job is to be
; prefixed onto a name, and `""` is then exactly right for the
; working-directory case - `(strConcat (pathDir "x.ax") "x.ax")` is
; `"x.ax"`, with no special case anywhere. This is the rule
; `codegen.ax`'s `dirOfPath` established and it does not change here.
(pub :: pathDir (-> String String))

(pub fn (pathDir p)
  (match (pathLastSlash p)
    ((None) "")
    ((Some i) (strDup (strSlice p 0 (+ i 1))))
  )
)

; Everything after the last `/` - the file name on its own, or `p`
; entire when there is no separator.
;
; A path ending in `/` has an EMPTY base, which is the honest answer:
; `"src/"` names a directory and no file within it.
(pub :: pathBase (-> String String))

(pub fn (pathBase p)
  (match (pathLastSlash p)
    ((None) (strDup p))
    ((Some i) (strDup (strSlice p (+ i 1) (- (strLen p) (+ i 1)))))
  )
)

; A directory name that ends in `/`, so concatenation forms a path.
;
; `""` stays `""` - see `pathDir` for why that is the useful answer
; rather than `"/"`. The argument may be a slice of the environment's
; bytes, which shares storage and is not NUL-terminated; the answer
; always is.
(pub :: pathWithSlash (-> String String))

(pub fn (pathWithSlash d)
  (if (== (strLen d) 0)
    ""
    (if (== (strByte d (- (strLen d) 1)) 47)
      (strDup d)
      (strConcat d "/")
    )
  )
)

; `dir` and `name` as one path, with exactly one `/` between them.
;
; Two cases answer `name` alone, and both are the rule a shell
; follows: an empty `dir` is the working directory, and an ABSOLUTE
; `name` ignores whatever it was offered as a prefix. The second is
; what keeps `(pathJoin d n)` safe to write over a whole directory
; listing without inspecting each name first.
(pub :: pathJoin (-> String String String))

(pub fn (pathJoin dir name)
  (if (== (strLen dir) 0)
    (strDup name)
    (if (== (strByte name 0) 47)
      (strDup name)
      (strConcat (pathWithSlash dir) name)
    )
  )
)

; The index of the extension's `.` within `p`, or `None`.
;
; A dot only starts an extension if it is INSIDE the base name and not
; the first byte of it. So `".axiomrc"` has no extension - the dot is
; what makes it a hidden file, not what separates a type - and
; `"src/v1.0/README"` has none either, because its only dot is in a
; directory component. Both are cases a naive "find the last dot" gets
; wrong, and both occur in this repository.
;
; Goes to `pathLastSlashFrom` directly rather than through
; `pathLastSlash`: the -1-or-index it answers is used right below as
; an ARGUMENT, not a value this function returns, and `(+ slash 1)`
; being 0 exactly when there is no slash is what makes one `<=` cover
; both "no directory" and "a directory with no dot inside it".
(pub :: pathExtIndex (-> String (Option Int)))

(pub fn (pathExtIndex p)
  (let ((slash (pathLastSlashFrom p (- (strLen p) 1))))
    (let ((dot (pathLastDotFrom p (- (strLen p) 1) slash)))
      (if (<= dot (+ slash 1))
        None
        (Some dot)
      )
    )
  )
)

(:: pathLastDotFrom (-> String Int Int Int))

(fn (pathLastDotFrom p i stop)
  (if (<= i stop)
    (- 0 1)
    (if (== (strByte p i) 46)
      i
      (pathLastDotFrom p (- i 1) stop)
    )
  )
)

; The extension INCLUDING its dot (`".ax"`), or "" when there is none.
;
; The dot is kept for the same reason `pathDir` keeps its slash: the
; answer is meant to be compared (`(strEq (pathExt f) ".ax")`) or
; concatenated, and both are simpler when the separator travels with
; the part it separates.
(pub :: pathExt (-> String String))

(pub fn (pathExt p)
  (match (pathExtIndex p)
    ((None) "")
    ((Some i) (strDup (strSlice p i (- (strLen p) i))))
  )
)

; The base name with its extension removed: `"src/main.ax"` is
; `"main"`. What a driver names an output after.
(pub :: pathStem (-> String String))

(pub fn (pathStem p)
  (match (pathExtIndex p)
    ((None) (pathBase p))
    ((Some i) (pathBase (strSlice p 0 i)))
  )
)

; `p` with its extension replaced by `ext`, which carries its own dot.
; `(pathReplaceExt "build/main.ax" ".ll")` is `"build/main.ll"`, and a
; path with no extension simply gains one.
;
; The directory is preserved, which is what separates this from
; `(strConcat (pathStem p) ext)` - the spelling every driver reaches
; for first, and the one that quietly writes its output to the
; working directory instead of beside its input.
(pub :: pathReplaceExt (-> String String String))

(pub fn (pathReplaceExt p ext)
  (match (pathExtIndex p)
    ((None) (strConcat p ext))
    ((Some i) (strConcat (strSlice p 0 i) ext))
  )
)

; True when `p` starts at the root. A relative path is resolved
; against the working directory, which is why `Sys.sysGetCwd` exists.
(pub :: pathIsAbsolute (-> String Bool))

(pub fn (pathIsAbsolute p) (== (strByte p 0) 47))

; `p`, lexically simplified to the shortest path naming the same
; location: doubled `/`s collapse, a `.` segment is dropped, and a
; real segment is cancelled by the `..` that immediately follows it.
; Nothing here touches the filesystem - a symlink component is
; resolved exactly as if it were an ordinary name, which is what
; makes this a STRING operation and not a `Sys` one. Same rules as
; Go's `path.Clean` or Python's `posixpath.normpath`.
;
; A leading `..` in a RELATIVE path has nothing to cancel against and
; is kept, once per unmatched `..` - `(pathClean "a/../../b")` is
; `"../b"`, not `"b"`. The same `..` at an ABSOLUTE root has nowhere
; to go and is simply dropped - `(pathClean "/../a")` is `"/a"`. An
; empty path names the working directory, so it answers `"."`, the
; same as `"."` itself; `(pathClean "/")` and `(pathClean "//")` both
; answer `"/"`.
;
; The two traps `pathExtIndex` already had to name reappear here: a
; leading `.` that starts a NAME rather than a segment (`".axiomrc"`)
; is not a `.` segment, and `..` as a PREFIX of a longer name
; (`"..b"`) is not a `..` segment. Both survive untouched, because
; the check below is on the whole segment, never one byte of it.
(pub :: pathClean (-> String String))

(pub fn (pathClean p)
  (if (== (strLen p) 0)
    "."
    (let ((abs (pathIsAbsolute p)))
      (let ((body (pathCleanFrom p (strLen p) 0 "" abs)))
        (if abs
          (strConcat "/" body)
          (if (== (strLen body) 0) "." body)
        )
      )
    )
  )
)

; Walks `p` backward one segment at a time from `end`, exactly as
; `pathLastSlashFrom` does, folding each into `acc` - built up in
; REVERSE, right to left, so a segment is PREPENDED rather than
; appended - under `skip` pending `..`s still owed a real segment to
; cancel:
;
;   kind 0 : the segment IS `..` - one more cancellation now owed.
;   kind 1 : "" or "." - contributes nothing either way.
;   kind 2 : a real segment, but a `..` further right already claimed
;            it - contributes nothing, and pays off one `skip`.
;   kind 3 : a real segment nothing has claimed - joins `acc`.
;
; `slash < 0` is `pathLastSlashFrom`'s sentinel for "no more `/` in
; `p`", meaning this was the leftmost segment; what remains of `skip`
; then goes to `pathLeadingDotDot` rather than another `..` to cancel.
(:: pathCleanFrom (-> String Int Int String Bool String))

(fn (pathCleanFrom p end skip acc abs)
  (let ((slash (pathLastSlashFrom p (- end 1))))
    (let ((seg (strSlice p (+ slash 1) (- end (+ slash 1)))))
      (let ((kind
        (if (strEq seg "..")
          0
          (if (|| (== (strLen seg) 0) (strEq seg "."))
            1
            (if (> skip 0) 2 3)
          )
        )
      ))
        (let ((skip2 (if (== kind 0) (+ skip 1) (if (== kind 2) (- skip 1) skip))))
          (let ((acc2 (if (== kind 3) (pathPrependSeg seg acc) acc)))
            (if (< slash 0)
              (pathLeadingDotDot skip2 acc2 abs)
              (pathCleanFrom p slash skip2 acc2 abs)
            )
          )
        )
      )
    )
  )
)

; `seg` and `acc` as one path, with exactly one `/` between them when
; `acc` already holds something - `pathJoin`'s rule, folded onto the
; right-to-left walk above instead of `pathJoin`'s left-to-right one.
; `seg` is a shared slice of `p`; `strDup` is what makes the answer
; an owned copy once `acc` stops being empty, keeping this module's
; every-answer-is-owned rule even for a one-segment path like `"a/"`.
(:: pathPrependSeg (-> String String String))

(fn (pathPrependSeg seg acc)
  (if (== (strLen acc) 0)
    (strDup seg)
    (strConcat (strConcat seg "/") acc)
  )
)

; `skip` unmatched `..`s, each turned into a leading `../` - unless
; `abs` says there is a root above which none of them can climb, in
; which case every one left over is simply dropped.
(:: pathLeadingDotDot (-> Int String Bool String))

(fn (pathLeadingDotDot skip acc abs)
  (if (|| abs (<= skip 0))
    acc
    (pathLeadingDotDot (- skip 1) (pathPrependSeg ".." acc) abs)
  )
)
