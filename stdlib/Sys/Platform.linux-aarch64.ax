; `Err` for the `(Result Int Error)` the two descriptor calls below
; answer since 2026-09-03. `Err` imports `Str`, which imports `Mem` and
; `Vec`, and none of those import this module, so the edge is acyclic.
(import Err)

; Sys.Platform - Linux/AArch64 syscall numbers and flags.
;
; Selected by the `.linux-aarch64.ax` filename suffix when compiling for
; `--target=linux-aarch64`. Numbers come from the generic
; `include/uapi/asm-generic/unistd.h` table that AArch64 uses, and are
; deliberately *not* shared with x86-64, which has its own table.
(pub :: sysRead Int)

(pub fn (sysRead) 63)

(pub :: sysWrite Int)

(pub fn (sysWrite) 64)

; AArch64's generic syscall table has no plain `open` at all - only
; `openat` (56). `Sys.ax` adapts by prepending a directory fd when
; `openNeedsDirFd` says to, so nothing above this file has to know.
(pub :: sysOpen Int)

(pub fn (sysOpen) 56)

(pub :: sysClose Int)

(pub fn (sysClose) 57)

