(pub :: platformSleepNanos (-> Int (Result Int Error)))
(pub fn (platformSleepNanos nanos)
  (Internal.Platform::impl_platformSleepNanos nanos))

;; Whether entropy uses a separate platform source: 0 here.
;; The entropy layer selects the kernel or hardware path otherwise.
(pub :: platformHasEntropy Int)
;@axiom:effect(pure)
(pub fn (platformHasEntropy)
  Internal.Platform::impl_platformHasEntropy)

