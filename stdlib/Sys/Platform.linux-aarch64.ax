; Measured on Darwin 2026-08-24: `socket(10, SOCK_STREAM, 0)` there
; answers -47 EAFNOSUPPORT, which is the shape a cross-copied 30 takes
; here. `scripts/check-net.sh`'s IPv6 arm is the probe, and `ci.yml`
; runs it on this target as well as Darwin: it opens a listener on
; `::1` and round-trips a connection, so a wrong number here cannot be
; green.
(pub :: afInet6 Int)

(pub fn (afInet6) 10)

(pub :: sockStream Int)

(pub fn (sockStream) 1)

; Linux's socket options are small sequential integers where Darwin's
; are BSD bitmasks. Every one of these four differs from its Darwin
; twin, and `solSocket` most dangerously: 1 here against 65535 there.
(pub :: solSocket Int)

(pub fn (solSocket) 1)

(pub :: soReuseAddr Int)

(pub fn (soReuseAddr) 2)

(pub :: soReusePort Int)

(pub fn (soReusePort) 15)

(pub :: soError Int)

(pub fn (soError) 4)

(pub :: fGetFl Int)

(pub fn (fGetFl) 3)

(pub :: fSetFl Int)

(pub fn (fSetFl) 4)

; O_NONBLOCK is 0o4000 here against Darwin's 4.
(pub :: oNonblock Int)

(pub fn (oNonblock) 2048)

; EAGAIN, 11 here against Darwin's 35. See the Darwin file for why this
; is a name rather than a literal at the comparison.
(pub :: eAgain Int)

(pub fn (eAgain) 11)

; Linux's `sockaddr_in` has NO length byte: `sin_family` is a two-byte
; host-order field at offset 0, where Darwin has a one-byte length then
; a one-byte family. `Sys.ax` branches on this; the Darwin file carries
; the full layout of both.
;
; `sockaddr_in6` asks the same question and takes the same answer here:
; `sin6_family` is two host-order bytes at offset 0, then the port
; big-endian at 2, flowinfo at 4, the sixteen address bytes at 8 and
; scope_id at 24 - 28 bytes, the same size Darwin's is. So this one
; capability covers both families and the 28 is not a platform number.
(pub :: sockaddrHasLenByte Int)

(pub fn (sockaddrHasLenByte) 0)

; --------------------------------------------------------------------
; Readiness
;
; Linux's mechanism is epoll, which needs two calls where kqueue needs
; one: `epoll_ctl` registers interest and `epoll_pwait` collects. See
; the Darwin file for the shape of the other side.
;
; THE WAIT CALL IS `epoll_pwait`, NOT `epoll_wait`, AND THAT IS NOT A
; PREFERENCE: aarch64's generic syscall table has no `epoll_wait` at
; all, so it is the only spelling that exists on both arches. Its first
; four arguments are exactly `epoll_wait`'s, and the two extra are a
; signal mask and that mask's size. `Sys.ax` passes a NULL mask and a
; size of 8.
; --------------------------------------------------------------------
(pub :: pollUsesKqueue Int)

(pub fn (pollUsesKqueue) 0)

; epoll_create1(flags) - 20.
(pub :: sysPollCreateNum Int)

(pub fn (sysPollCreateNum) 20)

; epoll_pwait(epfd, events, maxevents, timeout_ms, sigmask, sigsetsize) - 22.
(pub :: sysPollWaitNum Int)

(pub fn (sysPollWaitNum) 22)

; epoll_ctl(epfd, op, fd, event) - 21.
(pub :: sysPollCtlNum Int)

(pub fn (sysPollCtlNum) 21)

; `struct epoll_event` is not packed on aarch64, so 16 bytes with four bytes of padding after the events word.
;
;   layout here:  0:4 events (u32) | 8:8 data (u64)
;
; THE TWO ARCHES DISAGREE AND NEITHER ERRORS IF YOU USE THE OTHER'S
; NUMBERS. A 16-byte stride on x86_64 reads every event after the first
; from the middle of the one before it, and registers a descriptor the
; kernel took from whatever sat at offset 8; a 12-byte stride on aarch64
; writes the descriptor into the padding hole. Both dispatch on garbage
; with no syscall error and no crash.
(pub :: pollEventSize Int)

(pub fn (pollEventSize) 16)

(pub :: pollEventFdOffset Int)

(pub fn (pollEventFdOffset) 8)

; EPOLLIN. A positive bitmask, where kqueue's EVFILT_READ is -1.
(pub :: pollReadFilter Int)

(pub fn (pollReadFilter) 1)

; EPOLL_CTL_ADD and EPOLL_CTL_DEL, which coincide with kqueue's EV_ADD
; and EV_DELETE at 1 and 2.
(pub :: pollAddOp Int)

(pub fn (pollAddOp) 1)

(pub :: pollDelOp Int)

(pub fn (pollDelOp) 2)

; epoll_pwait's sixth argument. IT MUST BE EXACTLY 8 - the kernel's
; `sigset_t` is one 64-bit word and it rejects any other size with
; EINVAL. glibc's `sigset_t` is 128 bytes and is the wrong number to
; hand a raw syscall; Axiom links no libc, so that type never appears
; here. Passing it explicitly rather than leaving the register undefined
; costs one write and does not depend on the kernel skipping the check
; when the mask is NULL.
(pub :: pollSigsetSize Int)

(pub fn (pollSigsetSize) 8)

; --------------------------------------------------------------------
; Entropy
;
; getrandom(buf, len, flags) - 278. Answers the NUMBER OF BYTES it wrote,
; which MAY BE FEWER THAN ASKED when a signal interrupts it, so the loop
; over this call advances by the answer rather than by the request. That
; is the difference from Darwin's `getentropy`, which fills completely
; or fails, and it is what `randomIsGetentropy` selects between.
;
; `randomMaxChunk` is not a kernel limit here - `getrandom` has none
; worth naming - but the same 256 is used so both platforms walk the
; buffer the same way and the chunk size is not a second thing that
; differs by target.
; --------------------------------------------------------------------
(pub :: sysRandomNum Int)

(pub fn (sysRandomNum) 278)

(pub :: randomIsGetentropy Int)

(pub fn (randomIsGetentropy) 0)

(pub :: randomMaxChunk Int)

(pub fn (randomMaxChunk) 256)

; --------------------------------------------------------------------
; Signals
;
; A SIGNAL BECOMES A READABLE DESCRIPTOR HERE, where Darwin delivers it
; through the readiness descriptor itself. `signalfd4` makes an fd that
; is readable whenever one of the masked signals is pending; that fd is
; then added to the epoll set like any socket, and reading it yields a
; 128-byte `signalfd_siginfo` whose first four bytes are the signal
; number. `signalUsesSignalFd` selects between the two shapes.
;
; The signals must be BLOCKED first on both platforms, or the default
; disposition kills the process before anything can observe them.
; --------------------------------------------------------------------
(pub :: signalUsesSignalFd Int)

(pub fn (signalUsesSignalFd) 1)

; rt_sigprocmask(how, set, oset, sigsetsize) - 135. The fourth
; argument is the mask's size and MUST BE EXACTLY 8; see
; `pollSigsetSize` above for why glibc's 128 is the wrong number.
(pub :: sysSigProcMaskNum Int)

(pub fn (sysSigProcMaskNum) 135)

; SIG_BLOCK, 0 here and 1 on Darwin.
(pub :: sigBlockHow Int)

(pub fn (sigBlockHow) 0)

; The kernel's `sigset_t` is one 64-bit word. Signal N occupies bit
; N-1, so SIGTERM (15) is bit 14 - an off-by-one that is easy to write
; the other way and produces a mask for the neighbouring signal.
(pub :: sigsetBytes Int)

(pub fn (sigsetBytes) 8)

; signalfd4(fd, mask, sizemask, flags) - 74. An `fd` of -1 creates
; one; passing an existing descriptor updates its mask instead.
(pub :: sysSignalFdNum Int)

(pub fn (sysSignalFdNum) 74)

; `struct signalfd_siginfo` is 128 bytes and `read` answers whole
; records, so a buffer that is not a multiple of this is EINVAL and a
; loop that assumes one record per read drops signals that arrived
; together. `ssi_signo` is a FOUR-byte field at offset 0 - reading
; eight there would fold `ssi_errno` into the answer.
(pub :: sigInfoSize Int)

(pub fn (sigInfoSize) 128)

; Unused on Linux (see `signalUsesSignalFd`), but defined so that
; `Sys.ax` type-checks against every platform module.
(pub :: pollSignalFilter Int)

(pub fn (pollSignalFilter) 0)

; kill(pid, sig) - 129.
(pub :: sysKillNum Int)

(pub fn (sysKillNum) 129)

; SIGTERM and SIGINT agree with Darwin's; SIGUSR1 does not (10 here, 30
; there), which is why these two are named and that one is not.
(pub :: sigTerm Int)

(pub fn (sigTerm) 15)

(pub :: sigInt Int)

(pub fn (sigInt) 2)

; Linux answers 0 in the child and the child's pid in the parent, which
; is the POSIX convention, so `sysForkProcess` passes the result
; through. Darwin does not; its file carries the measurement.
(pub :: forkChildIsZero Int)

(pub fn (forkChildIsZero) 1)

; SOCK_NONBLOCK, which `accept4` takes directly, so the accepted socket
; arrives non-blocking with no second syscall. Linux does NOT inherit
; the listener's `O_NONBLOCK` the way Darwin does; see the Darwin file
; for the measurement of that divergence and why `netAccept` defines the
; answer rather than reporting it.
(pub :: acceptNonblockFlag Int)

(pub fn (acceptNonblockFlag) 2048)

; ------------------------------------------------------------------
; Which KIND of platform module this is.
;
; 1: a table of numbers, and `Sys.ax` makes every kernel call itself
; through `__syscallN`. The three `platform*` functions below are then
; never reached - `Sys.ax` tests this capability first - and answer
; -ENOSYS (38 here), so a caller that reached one anyway would see
; a failure and not a count. `Sys/Platform.windows.ax` is the other
; kind: it answers 0 and does the work itself over `extern "kernel32"`
; bindings, because Windows has no syscall ABI to put in a table. The
; names are declared in every module so that the four declare one
; public surface (`check-stdlib-api.sh`, `check-compat.sh`).
; ------------------------------------------------------------------
(pub :: usesSyscallAbi Int)

(pub fn (usesSyscallAbi) 1)

(pub :: platformWriteFd (-> Int Int Int (Result Int Error)))

(pub fn (platformWriteFd fd buf count) (Err (mkError 38 "platformWriteFd")))

(pub :: platformReadFd (-> Int Int Int (Result Int Error)))

(pub fn (platformReadFd fd buf count) (Err (mkError 38 "platformReadFd")))

(pub :: platformExitWith (-> Int Int))

;@axiom:pure
(pub fn (platformExitWith code) (- 0 38))

; --------------------------------------------------------------------
; Terminals
;
; NOT MEASURED ON THE MACHINE THAT WROTE THEM, and this section says so
; where the Darwin module says the opposite. There is no Linux host in
; this working tree. What backs each number is written beside it, and
; it is one of two things:
;
;   * a line QUOTED from the kernel's own uapi headers at v6.6 -
;     `include/uapi/asm-generic/{ioctls,termbits,termbits-common,
;     termios}.h` - fetched on 2026-08-31 and read, not recalled; or
;   * a layout DERIVED by compiling the struct declaration from those
;     headers, verbatim, on this host. That is sound for these
;     particular structs and only for them: every field is a `unsigned
;     int` or a `unsigned char`, whose sizes and alignments are the
;     same on any LP64 little-endian ABI, so the C compiler here lays
;     them out exactly as one there would.
;
; THE DERIVATION WAS THEN CHECKED, because a derivation nobody can
; falsify is a guess with arithmetic in front of it. Two checks ran:
;
;   1. The same `_IOC` arithmetic applied to THIS host's real
;      `struct termios` reproduced this host's real TIOCGETA,
;      TIOCSETA, TIOCSETAF and TIOCGWINSZ macros exactly. The machinery
;      is therefore right even though the inputs come from elsewhere.
;   2. Linux's TCGETS2 - `_IOR('T', 0x2a, struct termios2)`, and
;      unlike TCGETS it IS size-encoded - is 0x802c542a in the fetched
;      header. 0x2c is 44, and the `struct termios2` declaration
;      compiled here measures 44 bytes. `struct termios` is that
;      struct without its two trailing `speed_t`, so 44 - 8 = 36,
;      which is what the declaration measures. The kernel's own
;      constant confirms the layout this file assumes.
;
; WHY THE KERNEL STRUCT AND NOT GLIBC'S. They are different structs
; with the same name. glibc's `struct termios` is 60 bytes with
; NCCS 32 and two trailing `speed_t`; `tcgetattr` fills a 36-byte
; `__kernel_termios` from TCGETS and copies across. `Sys.ax` makes
; the raw syscall, so the kernel's 36 is the only size that is true
; here, and taking libc's would have put `c_cc` 15 bytes past where
; the kernel writes it.
;
; NOTHING HERE IS SHARED WITH DARWIN OR FREEBSD. The BSD requests are
; `_IOR`/`_IOW` encodings carrying `sizeof(struct termios)`; the
; four below are bare magic numbers with no size field, which the
; fetched header explains in as many words - "Most of them do not use
; the recommended _IOC(), but there is probably some source code out
; there hardcoding the number".
; --------------------------------------------------------------------
; See the Darwin module for what this capability selects.
(pub :: ttyUsesTermios Int)

(pub fn (ttyUsesTermios) 1)

; ioctl(fd, request, arg) - 29.
; aarch64 has no table of its own; it takes the numbers in
; `include/uapi/asm-generic/unistd.h`, quoted from v6.6:
;   #define __NR_ioctl 29
; It is 16 on x86_64 and 54 on the BSDs.
(pub :: sysIoctlNum Int)

(pub fn (sysIoctlNum) 29)

; TCGETS - read the terminal attributes into a `struct termios`.
; Quoted from `include/uapi/asm-generic/ioctls.h`:
;   #define TCGETS  0x5401
; 0x5401 = 21505. arm64 and x86 both take this file: neither
; `arch/arm64/include/uapi/asm/ioctls.h` nor the x86 one exists at
; v6.6 (both fetches answered HTTP 404), so `asm-generic` is what
; `<asm/ioctls.h>` resolves to on either.
(pub :: tcGetAttrReq Int)

(pub fn (tcGetAttrReq) 21505)

; TCSETSF - write the attributes back, draining output and discarding
; pending input. Quoted from the same header:
;   #define TCSETSF 0x5404
; 0x5404 = 21508. The flushing variant is the choice here for the
; reasons the Darwin module gives; TCSETS (0x5401 + 1) is the
; non-draining form and is not exposed.
(pub :: tcSetAttrReq Int)

(pub fn (tcSetAttrReq) 21508)

; TIOCGWINSZ - read `struct winsize`. Quoted:
;   #define TIOCGWINSZ  0x5413
; 0x5413 = 21523, and it is NOT the BSDs' 0x40087468 even though the
; struct is the same four `unsigned short` on all three.
(pub :: tcWinSizeReq Int)

(pub fn (tcWinSizeReq) 21523)

; The bytes the kernel exchanges. `struct termios` from
; `asm-generic/termbits.h`, verbatim:
;
;   typedef unsigned int tcflag_t;   (termbits.h)
;   typedef unsigned char cc_t;      (termbits-common.h)
;   #define NCCS 19
;   struct termios {
;     tcflag_t c_iflag; tcflag_t c_oflag;
;     tcflag_t c_cflag; tcflag_t c_lflag;
;     cc_t c_line; cc_t c_cc[NCCS];
;   };
;
; Compiled here: `sizeof = 36  c_iflag@0 c_oflag@4 c_cflag@8
; c_lflag@12 c_line@16 c_cc@17`. 16 + 1 + 19 = 36 with no tail
; padding, the struct's alignment being 4.
(pub :: termiosBytes Int)

(pub fn (termiosBytes) 36)

; `tcflag_t` is `unsigned int` here where Darwin's is `unsigned
; long`, which is the whole of why 36 is not 72. The four flag words
; sit at 0, 4, 8 and 12 - measured above - so the stride serves as all
; four offsets, as it does on every target.
(pub :: termiosFlagBytes Int)

(pub fn (termiosFlagBytes) 4)

; Where `c_cc` begins: 17, measured above. NOT 16. Linux carries a
; one-byte `c_line` - the line discipline - that neither BSD has, so
; the array starts on an ODD offset, and a module that copied the
; BSDs' 16 would read `c_line` as `c_cc[0]` and every control
; character one slot early.
(pub :: termiosCcOff Int)

(pub fn (termiosCcOff) 17)

; Quoted from `asm-generic/termbits.h`:
;   #define VTIME 5
;   #define VMIN  6
; The BSDs put them at 16 and 17 - and in the other order.
(pub :: termiosVminIdx Int)

(pub fn (termiosVminIdx) 6)

(pub :: termiosVtimeIdx Int)

(pub fn (termiosVtimeIdx) 5)

; c_lflag bits, quoted from `asm-generic/termbits.h`:
;   #define ISIG   0x00001    ->     1
;   #define ICANON 0x00002    ->     2
;   #define ECHO   0x00008    ->     8
;   #define IEXTEN 0x08000    -> 32768
; Only ECHO agrees with Darwin, where the other three are 0x100, 0x80
; and 0x400.
(pub :: tiosEcho Int)

(pub fn (tiosEcho) 8)

(pub :: tiosIcanon Int)

(pub fn (tiosIcanon) 2)

(pub :: tiosIsig Int)

(pub fn (tiosIsig) 1)

(pub :: tiosIexten Int)

(pub fn (tiosIexten) 32768)

; c_iflag bits. BRKINT, ISTRIP and ICRNL come from
; `asm-generic/termbits-common.h`, IXON from `termbits.h`:
;   #define BRKINT 0x002   ->    2
;   #define ISTRIP 0x020   ->   32
;   #define ICRNL  0x100   ->  256
;   #define IXON   0x400   -> 1024
; The first three match Darwin's; IXON does not - it is 0x200 there.
(pub :: tiosBrkint Int)

(pub fn (tiosBrkint) 2)

(pub :: tiosIcrnl Int)

(pub fn (tiosIcrnl) 256)

(pub :: tiosIstrip Int)

(pub fn (tiosIstrip) 32)

(pub :: tiosIxon Int)

(pub fn (tiosIxon) 1024)

; Quoted from `asm-generic/termbits-common.h`:
;   #define OPOST 0x01
; c_cflag is not covered here either; see the Darwin module for why.
(pub :: tiosOpost Int)

(pub fn (tiosOpost) 1)
