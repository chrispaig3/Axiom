;;! Sys.Platform - target constants and safe platform operations.
; Raw addresses and descriptor operations belong to Internal.Platform.
(import Err)
(import Internal.Platform)

;; Sys.Platform - Linux/AArch64 syscall numbers and flags.
;
; Selected by the `.linux-aarch64.ax` filename suffix when compiling for
; `--target=linux-aarch64`. Numbers come from the generic
; `include/uapi/asm-generic/unistd.h` table that AArch64 uses, and are
; deliberately *not* shared with x86-64, which has its own table.
(pub :: sysReadNum Int)
(pub fn (sysReadNum)
  Internal.Platform::impl_sysReadNum)

;; write(fd, buf, count) - BSD 4
(pub :: sysWriteNum Int)
(pub fn (sysWriteNum)
  Internal.Platform::impl_sysWriteNum)

;; AArch64's generic syscall table has no plain `open` at all - only
;; `openat` (56). `Sys.ax` adapts by prepending a directory fd when
;; `openNeedsDirFd` says to, so nothing above this file has to know.
(pub :: sysOpenNum Int)
(pub fn (sysOpenNum)
  Internal.Platform::impl_sysOpenNum)

;; close(fd) - BSD 6
(pub :: sysCloseNum Int)
(pub fn (sysCloseNum)
  Internal.Platform::impl_sysCloseNum)

;; exit_group (94), not exit (93) - see the x86-64 module for why.
(pub :: sysExitNum Int)
(pub fn (sysExitNum)
  Internal.Platform::impl_sysExitNum)

;; lseek(fd, offset, whence) - BSD 199
(pub :: sysLseekNum Int)
(pub fn (sysLseekNum)
  Internal.Platform::impl_sysLseekNum)

;; Darwin has a real `open`, so no `openat` indirection is needed.
;; `Sys.ax` branches on this rather than on an OS name, so adding a
;; platform never means editing portable code.
(pub :: openNeedsDirFd Int)
(pub fn (openNeedsDirFd)
  Internal.Platform::impl_openNeedsDirFd)

;; AT_FDCWD is -100: resolve a relative path against the current
;; working directory.
(pub :: atFdCwd Int)
(pub fn (atFdCwd)
  Internal.Platform::impl_atFdCwd)

;; The `O_RDONLY` flag for `open` on this platform: read only.
(pub :: oRdonly Int)
(pub fn (oRdonly)
  Internal.Platform::impl_oRdonly)

;; O_WRONLY | O_CREAT | O_TRUNC = 0x1 | 0x40 | 0x200
(pub :: oWronlyCreateTrunc Int)
(pub fn (oWronlyCreateTrunc)
  Internal.Platform::impl_oWronlyCreateTrunc)

;; O_WRONLY | O_CREAT | O_APPEND = 0x1 | 0x40 | 0x400
(pub :: oWronlyCreateAppend Int)
(pub fn (oWronlyCreateAppend)
  Internal.Platform::impl_oWronlyCreateAppend)

;; The `whence` value for `lseek` that measures from the end of the
;; file.
(pub :: seekEnd Int)
(pub fn (seekEnd)
  Internal.Platform::impl_seekEnd)

;; The `whence` value for `lseek` that measures from the start of the
;; file.
(pub :: seekSet Int)
(pub fn (seekSet)
  Internal.Platform::impl_seekSet)

; ------------------------------------------------------------------
;; Starting a child process.
;
; Like x86-64, AArch64 Linux forks and returns 0 in the child through a
; single register, so `__syscallN` expresses it; Darwin's `fork` cannot
; be (it returns a second value in x1), which is what this capability
; selects between.
(pub :: spawnUsesPosixSpawn Int)
(pub fn (spawnUsesPosixSpawn)
  Internal.Platform::impl_spawnUsesPosixSpawn)

;; The generic syscall table has no `fork` at all - it has `clone` (220),
;; and `fork()` is `clone(SIGCHLD, 0, 0, 0, 0)`. SIGCHLD is 17, and it
;; goes in the flags argument, which is why `sysForkArg` exists: without
;; it a bare `clone(0, ...)` creates a child whose parent is never
;; notified and which `wait4` therefore never reaps.
(pub :: sysForkNum Int)
;@axiom:syscall(spawn)
(pub fn (sysForkNum)
  220)

;; The argument the platform's fork syscall takes: 0 where `fork` takes
;; none, the `clone` flags where it is `clone`.
(pub :: sysForkArg Int)
(pub fn (sysForkArg)
  Internal.Platform::impl_sysForkArg)

;; The `execve` syscall number, or 0 where the platform runs a child
;; through its own path.
(pub :: sysExecveNum Int)
(pub fn (sysExecveNum)
  Internal.Platform::impl_sysExecveNum)

;; 260 is `wait4` in `include/uapi/asm-generic/unistd.h`, among the
;; legacy entries at the end of that table. The generic table lacks
;; `unlink`, as the note above says, but it does have `wait4`.
(pub :: sysWait4Num Int)
;@axiom:syscall(block)
(pub fn (sysWait4Num)
  260)

;; Unused on Linux, defined so `Sys.ax` type-checks against every
;; platform module.
(pub :: sysPosixSpawnNum Int)
;@axiom:syscall(spawn)
(pub fn (sysPosixSpawnNum)
  0)

;; The generic table has no `unlink`, only `unlinkat` (35) - the same
;; shape as `openat`, so `Sys.ax` branches on `openNeedsDirFd` for both.
(pub :: sysUnlinkNum Int)
(pub fn (sysUnlinkNum)
  Internal.Platform::impl_sysUnlinkNum)

;; mkdirat(dirfd, path, mode) - 34. AArch64 Linux has no plain `mkdir`,
;; the same way it has no `open` and no `unlink`, so this is the `at`
;; number and `openNeedsDirFd` (1 here) selects the three-argument form.
(pub :: sysMkdirNum Int)
(pub fn (sysMkdirNum)
  Internal.Platform::impl_sysMkdirNum)

;; AArch64 Linux has no `rmdir` either. It is `unlinkat` - the SAME
;; number `sysUnlinkNum` names - with `AT_REMOVEDIR` in the flags, so
;; the number is 35 and `sysRmdir` passes 512 where `sysUnlink` passes
;; 0. That the two share a number is the point: on this target
;; removing a file and removing a directory are one call distinguished
;; by a flag.
(pub :: sysRmdirNum Int)
(pub fn (sysRmdirNum)
  Internal.Platform::impl_sysRmdirNum)

;; The generic table has no `rename`, only `renameat` (38) - the third
;; entry in the `openat`/`unlinkat`/`mkdirat` family, and the third to
;; branch on `openNeedsDirFd`. It takes FOUR arguments, a directory fd
;; before each of the two paths, where the plain call takes two.
(pub :: sysRenameNum Int)
(pub fn (sysRenameNum)
  Internal.Platform::impl_sysRenameNum)

;; getdents64(fd, buf, count) - 61.
(pub :: sysGetdentsNum Int)
(pub fn (sysGetdentsNum)
  Internal.Platform::impl_sysGetdentsNum)

;; 1 where reading a directory needs a position argument
;; (`getdirentries`), 0 where `getdents` keeps its own.
(pub :: dirReadNeedsPosition Int)
(pub fn (dirReadNeedsPosition)
  Internal.Platform::impl_dirReadNeedsPosition)

;; `struct linux_dirent64`'s layout is architecture-independent, so
;; this is x86-64's 19 unchanged - the one thing about directory
;; reading the two Linux targets DO share, where the syscall number is
;; not. See the x86-64 module for the field list.
(pub :: direntNameOffset Int)
(pub fn (direntNameOffset)
  Internal.Platform::impl_direntNameOffset)

;; The working directory.
(pub :: cwdUsesFcntlPath Int)
(pub fn (cwdUsesFcntlPath)
  Internal.Platform::impl_cwdUsesFcntlPath)

;; getcwd(buf, size) - 17. The generic table keeps this one, unlike
;; `open`, `unlink`, `mkdir` and `rename`, all of which it has only in
;; their `at` forms.
(pub :: sysCwdNum Int)
(pub fn (sysCwdNum)
  Internal.Platform::impl_sysCwdNum)

;; Unused on Linux, defined so `Sys.ax` type-checks against every
;; platform module.
;; The `fcntl` command that answers a descriptor's path, or 0 where the
;; platform has none.
(pub :: fGetPath Int)
(pub fn (fGetPath)
  Internal.Platform::impl_fGetPath)

;; The two errno values portable code above compares against.
(pub :: eExist Int)
(pub fn (eExist)
  Internal.Platform::impl_eExist)

;; The `EISDIR` errno: the path names a directory.
(pub :: eIsDir Int)
(pub fn (eIsDir)
  Internal.Platform::impl_eIsDir)

;; getpid() - 172
(pub :: sysGetPidNum Int)
(pub fn (sysGetPidNum)
  Internal.Platform::impl_sysGetPidNum)

;; clock_gettime(clockid, ts) - 113. CLOCK_MONOTONIC=1; timespec is
;; {tv_sec i64, tv_nsec i64}. Verified by the REPL gate on the CI
;; runner - the first Linux execution of this number.
(pub :: sysClockNum Int)
(pub fn (sysClockNum)
  Internal.Platform::impl_sysClockNum)

;; 1 where wall-clock time comes from `gettimeofday`, 0 where it comes
;; from `clock_gettime`.
(pub :: clockIsGettimeofday Int)
(pub fn (clockIsGettimeofday)
  Internal.Platform::impl_clockIsGettimeofday)

;; 1 where environment names match without regard to ASCII case, as
;; Windows matches them, 0 where they match byte for byte.
(pub :: envNamesFoldCase Int)
(pub fn (envNamesFoldCase)
  Internal.Platform::impl_envNamesFoldCase)

;; Linux reaches CLOCK_MONOTONIC through the same `clock_gettime` above,
;; so `sysNowMonotonic` is answerable here and `sysNowMicros` was already
;; monotonic on this platform. Darwin's copy of this file explains why
;; the capability is not simply assumed.
(pub :: clockHasMonotonic Int)
(pub fn (clockHasMonotonic)
  Internal.Platform::impl_clockHasMonotonic)

;; CLOCK_MONOTONIC's id, which `Sys.ax` passes to `clock_gettime` above.
;; 1 here, and it was a literal 1 in `Sys.ax` until FreeBSD arrived,
;; where 1 is CLOCK_VIRTUAL - process CPU time, which never runs
;; backwards either, so nothing would have caught the substitution.
(pub :: clockMonotonicId Int)
(pub fn (clockMonotonicId)
  Internal.Platform::impl_clockMonotonicId)

;; Whether `Sys.ax` reads the arm64 counter for its monotonic clock,
;; which it does only where `clock_gettime` has none. 0 here.
(pub :: clockHasCounter Int)
(pub fn (clockHasCounter)
  Internal.Platform::impl_clockHasCounter)

; --------------------------------------------------------------------
; Sockets
;
; aarch64 numbers these from the generic `asm-generic/unistd.h` table,
; which is why they share nothing with the x86_64 file beside them - the
; same reason `read` is 63 here and 0 there. THE NEAR-MISSES ARE THE
; HAZARD: `fcntl` is 25 here and 72 on x86_64, and 72 here is `pselect6`;
; `socket` is 198 here and 41 there. A number copied from the wrong file
; does not answer -ENOSYS, it calls something else and answers something
; plausible.
;
; Verified against the vendored `libc` crate's aarch64 tables and
; cross-checked against `linux-raw-sys`'s kernel-generated constants,
; two independently derived sources. Not executed - these gates run on
; Linux in CI, and `scripts/check-cross-targets.sh` is what proves this
; file compiles at all from a Darwin host.
; --------------------------------------------------------------------
;; socket(domain, type, protocol) - 198.
(pub :: sysSocketNum Int)
(pub fn (sysSocketNum)
  Internal.Platform::impl_sysSocketNum)

;; bind(fd, addr, addrlen) - 200. addrlen is 16 for `sockaddr_in`.
(pub :: sysBindNum Int)
(pub fn (sysBindNum)
  Internal.Platform::impl_sysBindNum)

;; listen(fd, backlog) - 201.
(pub :: sysListenNum Int)
(pub fn (sysListenNum)
  Internal.Platform::impl_sysListenNum)

;; accept4(fd, addr, addrlen, flags) - 242, and Linux's answer to the
;; call Darwin spells `accept`. `Sys.ax` passes flags 0, which makes it
;; exactly `accept`; the fourth argument Darwin ignores is the one this
;; target reads.
(pub :: sysAcceptNum Int)
(pub fn (sysAcceptNum)
  Internal.Platform::impl_sysAcceptNum)

;; connect(fd, addr, addrlen) - 203.
(pub :: sysConnectNum Int)
(pub fn (sysConnectNum)
  Internal.Platform::impl_sysConnectNum)

;; setsockopt(fd, level, name, val, len) - 208.
(pub :: sysSetSockOptNum Int)
(pub fn (sysSetSockOptNum)
  Internal.Platform::impl_sysSetSockOptNum)

;; getsockopt(fd, level, name, val, lenptr) - 209.
(pub :: sysGetSockOptNum Int)
(pub fn (sysGetSockOptNum)
  Internal.Platform::impl_sysGetSockOptNum)

;; shutdown(fd, how) - 210.
(pub :: sysShutdownNum Int)
(pub fn (sysShutdownNum)
  Internal.Platform::impl_sysShutdownNum)

;; fcntl(fd, cmd, arg) - 25. Distinct from `sysCwdNum`, which is `getcwd`
;; on this platform and `fcntl(F_GETPATH)` on Darwin.
(pub :: sysFcntlNum Int)
(pub fn (sysFcntlNum)
  Internal.Platform::impl_sysFcntlNum)

;; The address family and socket type. `AF_INET` is 2 on both systems -
;; and that agreement is a trap, because `AF_INET6` is 30 here against
;; Linux's 10, so nothing else in this group may be assumed to match.
(pub :: afInet Int)
(pub fn (afInet)
  Internal.Platform::impl_afInet)

;; AF_INET6 - 10 here against Darwin's 30, and the one constant in this
;; group that does NOT agree. `afInet` is 2 on both systems; the Darwin
;; file calls that agreement a trap and this is what it was warning
;; about.
;
; Measured on Darwin: `socket(10, SOCK_STREAM, 0)` there
; answers -47 EAFNOSUPPORT, which is the shape a cross-copied 30 takes
; here. `scripts/check-net.sh`'s IPv6 arm is the probe, and `ci.yml`
; runs it on this target as well as Darwin: it opens a listener on
; `::1` and round-trips a connection, so a wrong number here cannot be
; green.
(pub :: afInet6 Int)
(pub fn (afInet6)
  Internal.Platform::impl_afInet6)

;; The `SOCK_STREAM` socket type: a TCP byte stream.
(pub :: sockStream Int)
(pub fn (sockStream)
  Internal.Platform::impl_sockStream)

;; Linux's socket options are small sequential integers where Darwin's
;; are BSD bitmasks. Every one of these four differs from its Darwin
;; twin, and `solSocket` most dangerously: 1 here against 65535 there.
(pub :: solSocket Int)
(pub fn (solSocket)
  Internal.Platform::impl_solSocket)

;; The `SO_REUSEADDR` socket option.
(pub :: soReuseAddr Int)
(pub fn (soReuseAddr)
  Internal.Platform::impl_soReuseAddr)

;; The `SO_REUSEPORT` socket option.
(pub :: soReusePort Int)
(pub fn (soReusePort)
  Internal.Platform::impl_soReusePort)

;; The `SO_ERROR` socket option, read after a non-blocking connect
;; finishes.
(pub :: soError Int)
(pub fn (soError)
  Internal.Platform::impl_soError)

;; fcntl's file-status commands, and the flag a non-blocking socket sets.
;; `O_NONBLOCK` is 4 here and 2048 on Linux.
(pub :: fGetFl Int)
(pub fn (fGetFl)
  Internal.Platform::impl_fGetFl)

;; The `fcntl` command that sets a descriptor's status flags.
(pub :: fSetFl Int)
(pub fn (fSetFl)
  Internal.Platform::impl_fSetFl)

;; fcntl's F_DUPFD_CLOEXEC: a duplicate of a descriptor, closed on exec.
;; `IO.termRaw` keeps one, so its guard can restore the terminal however
;; the caller's file is closed.
(pub :: fDupFdCloexec Int)
(pub fn (fDupFdCloexec)
  Internal.Platform::impl_fDupFdCloexec)

;; O_NONBLOCK is 0o4000 here against Darwin's 4.
;; The `O_NONBLOCK` status flag.
(pub :: oNonblock Int)
(pub fn (oNonblock)
  Internal.Platform::impl_oNonblock)

;; EAGAIN, 11 here against Darwin's 35. See the Darwin file for why this
;; is a name rather than a literal at the comparison.
(pub :: eAgain Int)
(pub fn (eAgain)
  Internal.Platform::impl_eAgain)

;; ENOSYS - the kernel has no such call: 38 on Linux, 78 on Darwin and FreeBSD.
(pub :: eNoSys Int)
(pub fn (eNoSys)
  Internal.Platform::impl_eNoSys)

;; EOPNOTSUPP - the operation does not apply to this socket or file: 95 on
;; Linux, 102 on Darwin, 45 on FreeBSD.
(pub :: eOpNotSupp Int)
(pub fn (eOpNotSupp)
  Internal.Platform::impl_eOpNotSupp)

;; ENOTCONN - the socket is not connected: 107 on Linux, 57 on the BSDs.
(pub :: eNotConn Int)
(pub fn (eNotConn)
  Internal.Platform::impl_eNotConn)

;; ECONNREFUSED - nothing listens on the port: 111 on Linux, 61 on the BSDs.
(pub :: eConnRefused Int)
(pub fn (eConnRefused)
  Internal.Platform::impl_eConnRefused)

;; ECONNRESET - the peer reset the connection: 104 on Linux, 54 on the BSDs.
(pub :: eConnReset Int)
(pub fn (eConnReset)
  Internal.Platform::impl_eConnReset)

;; ECONNABORTED - the connection was aborted before it was accepted: 103 on
;; Linux, 53 on the BSDs.
(pub :: eConnAborted Int)
(pub fn (eConnAborted)
  Internal.Platform::impl_eConnAborted)

;; EHOSTUNREACH - no route to the host: 113 on Linux, 65 on the BSDs.
(pub :: eHostUnreach Int)
(pub fn (eHostUnreach)
  Internal.Platform::impl_eHostUnreach)

;; ENETUNREACH - no route to the network: 101 on Linux, 51 on the BSDs.
(pub :: eNetUnreach Int)
(pub fn (eNetUnreach)
  Internal.Platform::impl_eNetUnreach)

;; ENETDOWN - the network is down: 100 on Linux, 50 on the BSDs.
(pub :: eNetDown Int)
(pub fn (eNetDown)
  Internal.Platform::impl_eNetDown)

;; EADDRINUSE - another socket holds the address: 98 on Linux, 48 on the BSDs.
(pub :: eAddrInUse Int)
(pub fn (eAddrInUse)
  Internal.Platform::impl_eAddrInUse)

;; EADDRNOTAVAIL - the address is not one of this host's: 99 on Linux, 49
;; on the BSDs.
(pub :: eAddrNotAvail Int)
(pub fn (eAddrNotAvail)
  Internal.Platform::impl_eAddrNotAvail)

;; EINPROGRESS - a non-blocking connect has started and not finished: 115
;; on Linux, 36 on the BSDs.
(pub :: eInProgress Int)
(pub fn (eInProgress)
  Internal.Platform::impl_eInProgress)

;; Linux's `sockaddr_in` has NO length byte: `sin_family` is a two-byte
;; host-order field at offset 0, where Darwin has a one-byte length then
;; a one-byte family. `Sys.ax` branches on this; the Darwin file carries
;; the full layout of both.
;
; `sockaddr_in6` asks the same question and takes the same answer here:
; `sin6_family` is two host-order bytes at offset 0, then the port
; big-endian at 2, flowinfo at 4, the sixteen address bytes at 8 and
; scope_id at 24 - 28 bytes, the same size Darwin's is. So this one
; capability covers both families and the 28 is not a platform number.
(pub :: sockaddrHasLenByte Int)
(pub fn (sockaddrHasLenByte)
  Internal.Platform::impl_sockaddrHasLenByte)

; --------------------------------------------------------------------
; Readiness
;
; Linux's mechanism is epoll, which needs two calls where kqueue needs
; one: `epoll_ctl` registers interest and `epoll_pwait` collects. See
; the Darwin file for the shape of the other side.
;
; THE WAIT CALL IS `epoll_pwait`, NOT `epoll_wait`, AND THAT IS NOT A
; PREFERENCE: aarch64's generic syscall table has no `epoll_wait` at
; all, so it is the only spelling that exists on both arches. Its first
; four arguments are exactly `epoll_wait`'s, and the two extra are a
; signal mask and that mask's size. `Sys.ax` passes a NULL mask and a
; size of 8.
; --------------------------------------------------------------------
;; 1 where readiness comes from `kqueue`, 0 where it comes from
;; `epoll`.
(pub :: pollUsesKqueue Int)
(pub fn (pollUsesKqueue)
  Internal.Platform::impl_pollUsesKqueue)

;; epoll_create1(flags) - 20.
(pub :: sysPollCreateNum Int)
(pub fn (sysPollCreateNum)
  Internal.Platform::impl_sysPollCreateNum)

;; epoll_pwait(epfd, events, maxevents, timeout_ms, sigmask, sigsetsize) - 22.
(pub :: sysPollWaitNum Int)
(pub fn (sysPollWaitNum)
  Internal.Platform::impl_sysPollWaitNum)

;; epoll_ctl(epfd, op, fd, event) - 21.
;; The syscall number that adds and removes descriptors in the poll set
;; (`kevent` or `epoll_ctl`).
(pub :: sysPollCtlNum Int)
(pub fn (sysPollCtlNum)
  Internal.Platform::impl_sysPollCtlNum)

;; `struct epoll_event` is not packed on aarch64, so 16 bytes with four bytes of padding after the events word.
;
;   layout here:  0:4 events (u32) | 8:8 data (u64)
;
; THE TWO ARCHES DISAGREE AND NEITHER ERRORS IF YOU USE THE OTHER'S
; NUMBERS. A 16-byte stride on x86_64 reads every event after the first
; from the middle of the one before it, and registers a descriptor the
; kernel took from whatever sat at offset 8; a 12-byte stride on aarch64
; writes the descriptor into the padding hole. Both dispatch on garbage
; with no syscall error and no crash.
(pub :: pollEventSize Int)
(pub fn (pollEventSize)
  Internal.Platform::impl_pollEventSize)

;; The byte offset of the descriptor inside one readiness event record.
(pub :: pollEventFdOffset Int)
(pub fn (pollEventFdOffset)
  Internal.Platform::impl_pollEventFdOffset)

;; EPOLLIN. A positive bitmask, where kqueue's EVFILT_READ is -1.
(pub :: pollReadFilter Int)
(pub fn (pollReadFilter)
  Internal.Platform::impl_pollReadFilter)

;; The writability filter: EVFILT_WRITE (-2) for kqueue, EPOLLOUT (4) for
;; epoll. It goes where `pollReadFilter` goes.
(pub :: pollWriteFilter Int)
(pub fn (pollWriteFilter)
  Internal.Platform::impl_pollWriteFilter)

;; EPOLL_CTL_ADD and EPOLL_CTL_DEL, which coincide with kqueue's EV_ADD
;; and EV_DELETE at 1 and 2.
(pub :: pollAddOp Int)
(pub fn (pollAddOp)
  Internal.Platform::impl_pollAddOp)

;; The operation code that removes a descriptor from the poll set.
(pub :: pollDelOp Int)
(pub fn (pollDelOp)
  Internal.Platform::impl_pollDelOp)

;; epoll_pwait's sixth argument. IT MUST BE EXACTLY 8 - the kernel's
;; `sigset_t` is one 64-bit word and it rejects any other size with
;; EINVAL. glibc's `sigset_t` is 128 bytes and is the wrong number to
;; hand a raw syscall; Axiom links no libc, so that type never appears
;; here. Passing it explicitly rather than leaving the register undefined
;; costs one write and does not depend on the kernel skipping the check
;; when the mask is NULL.
(pub :: pollSigsetSize Int)
(pub fn (pollSigsetSize)
  Internal.Platform::impl_pollSigsetSize)

; --------------------------------------------------------------------
; Entropy
;
; getrandom(buf, len, flags) - 278. Answers the NUMBER OF BYTES it wrote,
; which MAY BE FEWER THAN ASKED when a signal interrupts it, so the loop
; over this call advances by the answer rather than by the request. That
; is the difference from Darwin's `getentropy`, which fills completely
; or fails, and it is what `randomIsGetentropy` selects between.
;
; `randomMaxChunk` is not a kernel limit here - `getrandom` has none
; worth naming - but the same 256 is used so both platforms walk the
; buffer the same way and the chunk size is not a second thing that
; differs by target.
; --------------------------------------------------------------------
;; The syscall number that fills a buffer with random bytes.
(pub :: sysRandomNum Int)
;@axiom:syscall(entropy)
(pub fn (sysRandomNum)
  278)

;; 1 where random bytes come from `getentropy`, 0 where they come from
;; `getrandom`.
(pub :: randomIsGetentropy Int)
(pub fn (randomIsGetentropy)
  Internal.Platform::impl_randomIsGetentropy)

;; The most bytes one random-bytes syscall may fill at a time.
(pub :: randomMaxChunk Int)
(pub fn (randomMaxChunk)
  Internal.Platform::impl_randomMaxChunk)

; --------------------------------------------------------------------
; Signals
;
; A SIGNAL BECOMES A READABLE DESCRIPTOR HERE, where Darwin delivers it
; through the readiness descriptor itself. `signalfd4` makes an fd that
; is readable whenever one of the masked signals is pending; that fd is
; then added to the epoll set like any socket, and reading it yields a
; 128-byte `signalfd_siginfo` whose first four bytes are the signal
; number. `signalUsesSignalFd` selects between the two shapes.
;
; The signals must be BLOCKED first on both platforms, or the default
; disposition kills the process before anything can observe them.
; --------------------------------------------------------------------
;; 1 where signals are read from a `signalfd`, 0 where a `kqueue`
;; filter delivers them.
(pub :: signalUsesSignalFd Int)
(pub fn (signalUsesSignalFd)
  Internal.Platform::impl_signalUsesSignalFd)

;; rt_sigprocmask(how, set, oset, sigsetsize) - 135. The fourth
;; argument is the mask's size and MUST BE EXACTLY 8; see
;; `pollSigsetSize` above for why glibc's 128 is the wrong number.
(pub :: sysSigProcMaskNum Int)
(pub fn (sysSigProcMaskNum)
  Internal.Platform::impl_sysSigProcMaskNum)

;; SIG_BLOCK, 0 here and 1 on Darwin.
(pub :: sigBlockHow Int)
(pub fn (sigBlockHow)
  Internal.Platform::impl_sigBlockHow)

;; The kernel's `sigset_t` is one 64-bit word. Signal N occupies bit
;; N-1, so SIGTERM (15) is bit 14 - an off-by-one that is easy to write
;; the other way and produces a mask for the neighbouring signal.
(pub :: sigsetBytes Int)
(pub fn (sigsetBytes)
  Internal.Platform::impl_sigsetBytes)

;; signalfd4(fd, mask, sizemask, flags) - 74. An `fd` of -1 creates
;; one; passing an existing descriptor updates its mask instead.
(pub :: sysSignalFdNum Int)
(pub fn (sysSignalFdNum)
  Internal.Platform::impl_sysSignalFdNum)

;; `struct signalfd_siginfo` is 128 bytes and `read` answers whole
;; records, so a buffer that is not a multiple of this is EINVAL and a
;; loop that assumes one record per read drops signals that arrived
;; together. `ssi_signo` is a FOUR-byte field at offset 0 - reading
;; eight there would fold `ssi_errno` into the answer.
;; The size of one `signalfd_siginfo` record, or 0 where none is read.
(pub :: sigInfoSize Int)
(pub fn (sigInfoSize)
  Internal.Platform::impl_sigInfoSize)

