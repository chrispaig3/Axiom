; Sys.Platform - Darwin (macOS) syscall numbers and flags.
;
; Selected automatically by the `.darwin.ax` filename suffix when
; compiling for `--target=darwin-aarch64` or `--target=darwin-x86_64`
; (see the compiler's module resolution). The plain names in this file
; are the *only* per-platform knowledge in the standard library:
; everything above `Sys.ax` is portable Axiom code.
;
; Darwin uses BSD-style syscall numbering, where the number carries a
; class bit in its high byte - `0x2000000` for the "Unix" class - so
; every number below is `0x2000000 + <bsd number>`. Passing a bare BSD
; number dispatches into the wrong table and fails in ways that look
; like memory corruption, so the encoded constants are written out
; rather than computed from a base.
;
; Numbers are stable kernel ABI (see `/usr/include/sys/syscall.h`) and
; identical on arm64 and x86_64, which is why one Darwin file serves
; both architectures.

; read(fd, buf, count) - BSD 3
(pub :: sysRead Int)
(pub fn (sysRead) 33554435)

; write(fd, buf, count) - BSD 4
(pub :: sysWrite Int)
(pub fn (sysWrite) 33554436)

; open(path, flags, mode) - BSD 5
(pub :: sysOpen Int)
(pub fn (sysOpen) 33554437)

; close(fd) - BSD 6
(pub :: sysClose Int)
(pub fn (sysClose) 33554438)

; exit(status) - BSD 1
(pub :: sysExit Int)
(pub fn (sysExit) 33554433)

; lseek(fd, offset, whence) - BSD 199
(pub :: sysLseek Int)
(pub fn (sysLseek) 33554631)

; Darwin has a real `open`, so no `openat` indirection is needed.
; `Sys.ax` branches on this rather than on an OS name, so adding a
; platform never means editing portable code.
(pub :: openNeedsDirFd Int)
(pub fn (openNeedsDirFd) 0)

; Unused on Darwin (see `openNeedsDirFd`), but defined so that
; `Sys.ax` type-checks against every platform module.
(pub :: atFdCwd Int)
(pub fn (atFdCwd) 0)

(pub :: oRdonly Int)
(pub fn (oRdonly) 0)

; O_WRONLY | O_CREAT | O_TRUNC = 0x0001 | 0x0200 | 0x0400
(pub :: oWronlyCreateTrunc Int)
(pub fn (oWronlyCreateTrunc) 1537)

(pub :: seekEnd Int)
(pub fn (seekEnd) 2)

(pub :: seekSet Int)
(pub fn (seekSet) 0)

; ------------------------------------------------------------------
; Starting a child process.
;
; Darwin cannot use the fork/exec pair the way Linux does, and the
; reason is a property of the syscall primitive rather than a
; preference: Darwin's `fork` returns TWO values - the pid in x0 and an
; "am I the child" flag in x1 - and `__syscallN` yields one register, so
; a forked child would read its parent's pid and both processes would
; take the parent branch. `posix_spawn` returns the pid through a
; pointer instead, which one register can carry.
;
; `spawnUsesPosixSpawn` is the capability `Sys.ax` branches on, in
; keeping with `openNeedsDirFd`: portable code above never names an OS.
(pub :: spawnUsesPosixSpawn Int)
(pub fn (spawnUsesPosixSpawn) 1)

; posix_spawn - BSD 244.
;
; The SYSCALL is not the libc function of the same name. libc's takes
; six arguments (pid, path, file_actions, attrp, argv, envp); the kernel
; entry point takes FIVE, with the file actions and the attributes fused
; into one `_posix_spawn_args_desc`:
;
;   __posix_spawn(pid_t *pid, const char *path,
;                 struct _posix_spawn_args_desc *adesc,
;                 char *const argv[], char *const envp[])
;
; Passing the libc shape puts `argv` in the kernel's `envp` slot and the
; child receives a NULL argv - which is close to invisible, because a
; child that ignores its arguments still runs and still reports the
; right exit status. Probed: `/bin/sh -c "exit 7"` answers 0 under the
; six-argument spelling (sh with no arguments reads EOF from stdin and
; exits successfully) and 1792 - 7 << 8 - under this one.
(pub :: sysPosixSpawn Int)
(pub fn (sysPosixSpawn) 33554676)

; wait4(pid, status, options, rusage) - BSD 7.
(pub :: sysWait4 Int)
(pub fn (sysWait4) 33554439)

; Unused on Darwin (see `spawnUsesPosixSpawn`), but defined so that
; `Sys.ax` type-checks against every platform module - the same reason
; `atFdCwd` is defined here.
(pub :: sysFork Int)
(pub fn (sysFork) 0)

(pub :: sysForkArg Int)
(pub fn (sysForkArg) 0)

(pub :: sysExecve Int)
(pub fn (sysExecve) 0)

; unlink(path) - BSD 10.
(pub :: sysUnlinkNum Int)
(pub fn (sysUnlinkNum) 33554442)

; getpid() - BSD 20
(pub :: sysGetPidNum Int)
(pub fn (sysGetPidNum) 33554452)

; gettimeofday(tv, tz) - BSD 116. Writes {tv_sec i64, tv_usec i32+pad}
; to its 16-byte buffer; the register-return interpretation was probed
; WRONG on arm64 (x0 is 0 on success, never seconds). Verified against
; the shell clock, 400,000 reads, zero backwards steps, ~200ns/call.
(pub :: sysClockNum Int)
(pub fn (sysClockNum) 33554548)

(pub :: clockIsGettimeofday Int)
(pub fn (clockIsGettimeofday) 1)
