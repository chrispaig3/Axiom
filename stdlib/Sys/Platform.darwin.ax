; SIGTERM and SIGINT AGREE on all four targets, which is worth naming
; rather than assuming because most of their neighbours do not - SIGUSR1
; is 30 here and 10 on Linux.
(pub :: sigTerm Int)

(pub fn (sigTerm) 15)

(pub :: sigInt Int)

(pub fn (sigInt) 2)

; Whether `fork` answers 0 in the child, which is the POSIX convention
; and what Linux does. Darwin answers the child's pid to both, so
; `sysForkProcess` normalises; see `sysFork` above for the measurement.
(pub :: forkChildIsZero Int)

(pub fn (forkChildIsZero) 0)

; The flag `netAccept` passes to make the accepted socket non-blocking.
; Darwin's `accept` HAS no such flag - it has no `accept4` at all - so
; this is 0 and `Sys.ax` reaches for `fcntl` afterwards instead.
;
; IT MUST, because Darwin and Linux disagree about what an accepted
; socket inherits and the disagreement is silent. Measured on this host
; 2026-08-24: a listener with `O_NONBLOCK` set answered `F_GETFL` 6, and
; the socket accepted from it ALSO answered 6 - the flag was inherited.
; Linux's accepted socket does not inherit it. A server that accepted
; and then read would get -EAGAIN here and block there, from the same
; source, with nothing to say which had happened.
(pub :: acceptNonblockFlag Int)

(pub fn (acceptNonblockFlag) 0)
