; Sys.Platform - Darwin (macOS) syscall numbers and flags.
;
; Selected automatically by the `.darwin.ax` filename suffix when
; compiling for `--target=darwin-aarch64` or `--target=darwin-x86_64`
; (see the compiler's module resolution). The plain names in this file
; are the *only* per-platform knowledge in the standard library:
; everything above `Sys.ax` is portable Axiom code.
;
; Darwin uses BSD-style syscall numbering, where the number carries a
; class bit in its high byte - `0x2000000` for the "Unix" class - so
; every number below is `0x2000000 + <bsd number>`. Passing a bare BSD
; number dispatches into the wrong table and fails in ways that look
; like memory corruption, so the encoded constants are written out
; rather than computed from a base.
;
; Numbers are stable kernel ABI (see `/usr/include/sys/syscall.h`) and
; identical on arm64 and x86_64, which is why one Darwin file serves
; both architectures.
; read(fd, buf, count) - BSD 3
(pub :: sysRead Int)

(pub fn (sysRead) 33554435)

; write(fd, buf, count) - BSD 4
(pub :: sysWrite Int)

(pub fn (sysWrite) 33554436)

; open(path, flags, mode) - BSD 5
(pub :: sysOpen Int)

(pub fn (sysOpen) 33554437)

; close(fd) - BSD 6
(pub :: sysClose Int)

(pub fn (sysClose) 33554438)

; exit(status) - BSD 1
(pub :: sysExit Int)

(pub fn (sysExit) 33554433)

; lseek(fd, offset, whence) - BSD 199
(pub :: sysLseek Int)

(pub fn (sysLseek) 33554631)

; Darwin has a real `open`, so no `openat` indirection is needed.
; `Sys.ax` branches on this rather than on an OS name, so adding a
; platform never means editing portable code.
(pub :: openNeedsDirFd Int)

(pub fn (openNeedsDirFd) 0)

; Unused on Darwin (see `openNeedsDirFd`), but defined so that
; `Sys.ax` type-checks against every platform module.
(pub :: atFdCwd Int)

(pub fn (atFdCwd) 0)

(pub :: oRdonly Int)

(pub fn (oRdonly) 0)

; O_WRONLY | O_CREAT | O_TRUNC = 0x0001 | 0x0200 | 0x0400
(pub :: oWronlyCreateTrunc Int)

(pub fn (oWronlyCreateTrunc) 1537)

; O_WRONLY | O_CREAT | O_APPEND = 0x0001 | 0x0200 | 0x0008
;
; The mode `sysWriteFile` could not express. O_APPEND makes every write
; seek to the current end ATOMICALLY, which is not the same as opening
; for writing and seeking once: two processes appending to one log with
; a seek would overwrite each other's last line, and with this flag
; they interleave whole writes instead.
(pub :: oWronlyCreateAppend Int)

(pub fn (oWronlyCreateAppend) 521)

(pub :: seekEnd Int)

(pub fn (seekEnd) 2)

(pub :: seekSet Int)

(pub fn (seekSet) 0)

; ------------------------------------------------------------------
; Starting a child process.
;
; Darwin cannot use the fork/exec pair the way Linux does, and the
; reason is a property of the syscall primitive rather than a
; preference: Darwin's `fork` returns TWO values - the pid in x0 and an
; "am I the child" flag in x1 - and `__syscallN` yields one register, so
; a forked child would read its parent's pid and both processes would
; take the parent branch. `posix_spawn` returns the pid through a
; pointer instead, which one register can carry.
;
; `spawnUsesPosixSpawn` is the capability `Sys.ax` branches on, in
; keeping with `openNeedsDirFd`: portable code above never names an OS.
(pub :: spawnUsesPosixSpawn Int)

(pub fn (spawnUsesPosixSpawn) 1)

; posix_spawn - BSD 244.
;
; The SYSCALL is not the libc function of the same name. libc's takes
; six arguments (pid, path, file_actions, attrp, argv, envp); the kernel
; entry point takes FIVE, with the file actions and the attributes fused
; into one `_posix_spawn_args_desc`:
;
;   __posix_spawn(pid_t *pid, const char *path,
;                 struct _posix_spawn_args_desc *adesc,
;                 char *const argv[], char *const envp[])
;
; Passing the libc shape puts `argv` in the kernel's `envp` slot and the
; child receives a NULL argv - which is close to invisible, because a
; child that ignores its arguments still runs and still reports the
; right exit status. Probed: `/bin/sh -c "exit 7"` answers 0 under the
; six-argument spelling (sh with no arguments reads EOF from stdin and
; exits successfully) and 1792 - 7 << 8 - under this one.
(pub :: sysPosixSpawn Int)

(pub fn (sysPosixSpawn) 33554676)

; wait4(pid, status, options, rusage) - BSD 7.
(pub :: sysWait4 Int)

(pub fn (sysWait4) 33554439)

; fork() - BSD 2. `sysSpawn` does not reach it, because
; `spawnUsesPosixSpawn` selects `posix_spawn` here - but `sysForkProcess`
; does, and this used to be a placeholder 0 for that reason.
;
; DARWIN'S `fork` ANSWERS TWO REGISTERS AND `__syscallN` READS ONE. The
; child pid comes back in x0 for BOTH processes, and it is x1 - which no
; primitive here can see - that says which one you are. That is why this
; number sat unused and why `posix_spawn` was reached for instead.
;
; It is usable anyway, and measured on this host 2026-08-24: the child's
; x0 equals ITS OWN pid, while the parent's does not equal the parent's.
; So `getpid` after the fork distinguishes them with no second register
; and no compiler change - parent saw `fork->81242 mypid=81241`, child
; saw `fork->81242 mypid=81242`. `forkChildIsZero` records that this
; normalisation is needed here and not on Linux.
(pub :: sysFork Int)

(pub fn (sysFork) 33554434)

(pub :: sysForkArg Int)

(pub fn (sysForkArg) 0)

(pub :: sysExecve Int)

(pub fn (sysExecve) 0)

; unlink(path) - BSD 10.
(pub :: sysUnlinkNum Int)

(pub fn (sysUnlinkNum) 33554442)

; mkdir(path, mode) - BSD 136. Darwin has the plain call, so
; `openNeedsDirFd` is 0 here and `sysMkdir` uses the two-argument form.
(pub :: sysMkdirNum Int)

(pub fn (sysMkdirNum) 33554568)

; rmdir(path) - BSD 137.
(pub :: sysRmdirNum Int)

(pub fn (sysRmdirNum) 33554569)

; rename(from, to) - BSD 128. Darwin has the plain two-argument call,
; so `openNeedsDirFd` is 0 here and `sysRename` uses it directly.
(pub :: sysRenameNum Int)

(pub fn (sysRenameNum) 33554560)

; ------------------------------------------------------------------
; Reading a directory.
;
; `getdirentries64(fd, buf, bufsize, off_t *position)` - BSD 344, and
; NOT `getdirentries` (BSD 196), which carries the 32-bit-inode
; `struct dirent` that APFS cannot express.
;
; The fourth argument is an in/out cookie the kernel keeps the scan
; position in, and it has no Linux counterpart - `getdents64` is three
; arguments and keeps the position on the descriptor. That difference
; is what `dirReadNeedsPosition` selects, the same way
; `openNeedsDirFd` selects `open` from `openat`.
(pub :: sysGetdentsNum Int)

(pub fn (sysGetdentsNum) 33554776)

(pub :: dirReadNeedsPosition Int)

(pub fn (dirReadNeedsPosition) 1)

; Where the name starts inside one record. Darwin's 64-bit `dirent` is
;
;   u64 d_ino; u64 d_seekoff; u16 d_reclen; u16 d_namlen; u8 d_type;
;   char d_name[];
;
; so d_reclen sits at 16 - which Linux's `linux_dirent64` also does,
; and portable code relies on - and the name begins at 21 rather than
; Linux's 19, because of the d_namlen field Linux has no room for.
; Probed on this host 2026-08-15: `.` and `..` come back with
; d_reclen 32, d_namlen 1 and 2, d_type 4.
(pub :: direntNameOffset Int)

(pub fn (direntNameOffset) 21)

; ------------------------------------------------------------------
; The working directory.
;
; Darwin's syscall table HAS NO `getcwd`. Number 326 was `__getcwd`
; historically and is a hole in the current table - probed on this
; host 2026-08-15, a program calling it dies with SIGSYS - so the
; portable spelling cannot be "one number per platform".
;
; `fcntl(fd, F_GETPATH, buf)` is the way in, and the reason it is
; acceptable where `stat` is not (see `Sys.ax`) is that its answer is
; BYTES, not a record: a NUL-terminated path written into a
; caller-supplied buffer, with no offsets, widths or padding to get
; wrong. It needs a descriptor, so `sysGetCwd` opens `.` first.
;
; `sysCwdNum` is `fcntl` here and `getcwd` on Linux; the two have
; different shapes and `cwdUsesFcntlPath` picks between them.
(pub :: cwdUsesFcntlPath Int)

(pub fn (cwdUsesFcntlPath) 1)

; fcntl(fd, cmd, arg) - BSD 92.
(pub :: sysCwdNum Int)

(pub fn (sysCwdNum) 33554524)

(pub :: fGetPath Int)

(pub fn (fGetPath) 50)

; ------------------------------------------------------------------
; The two errno values portable code above compares against.
;
; They live here because errno numbering is per-OS ABI and DOES
; diverge - EAGAIN is 35 on Darwin and 11 on Linux - so a portable
; `(== e 21)` is a coincidence waiting to be wrong on the next target
; rather than a fact. These two happen to agree across all four
; targets today, and naming them here is what keeps that a
; measurement instead of an assumption.
(pub :: eExist Int)

(pub fn (eExist) 17)

(pub :: eIsDir Int)

(pub fn (eIsDir) 21)

; getpid() - BSD 20
(pub :: sysGetPidNum Int)

(pub fn (sysGetPidNum) 33554452)

; gettimeofday(tv, tz) - BSD 116. Writes {tv_sec i64, tv_usec i32+pad}
; to its 16-byte buffer; the register-return interpretation was probed
; WRONG on arm64 (x0 is 0 on success, never seconds). Verified against
; the shell clock, 400,000 reads, zero backwards steps, ~200ns/call.
(pub :: sysClockNum Int)

(pub fn (sysClockNum) 33554548)

(pub :: clockIsGettimeofday Int)

(pub fn (clockIsGettimeofday) 1)

; Whether this platform can answer a MONOTONIC clock - one that never
; steps backwards - through a syscall. Darwin cannot, and that is the
; whole reason this capability exists rather than being assumed.
;
; `gettimeofday` above is REALTIME. It is the right clock for "what
; time is it" and the wrong one for every timeout, rate limiter and
; retry backoff, because `ntpd` may step it backwards at any moment and
; a duration computed across that step is negative. The comment above
; records 400,000 reads with zero backwards steps; that measured the
; absence of a step during the test, not the absence of the hazard.
;
; Darwin's BSD table has no `clock_gettime`: libSystem's is built over
; the commpage, not a syscall, so reaching it costs the freestanding
; property `check-freestanding.sh` exists to hold (0 undefined symbols).
;
; The fix that keeps that property is available and is NOT a syscall.
; On arm64 the monotonic counter and its frequency are readable from
; user space as system registers - `mrs x0, CNTVCT_EL0` and `mrs x0,
; CNTFRQ_EL0` - which is what `mach_absolute_time` reads underneath.
; That needs a codegen primitive to emit the `mrs`, and a primitive
; cannot be spelled here until the committed seed knows it, so it lands
; as a compiler change plus `scripts/reseed.sh` rather than as a line in
; this file. darwin-x86_64 is harder and separate: `rdtsc` needs the
; commpage's scaling factors and is not invariant on all hardware.
;
; Until then `sysNowMonotonic` answers -ENOSYS here rather than
; substituting the realtime clock, so a caller that needs a duration
; finds out instead of being handed one that can run backwards.
(pub :: clockHasMonotonic Int)

(pub fn (clockHasMonotonic) 0)

; The id `clock_gettime` is asked for the monotonic clock, where there
; is one. Unused here - `clockIsGettimeofday` sends both readers to
; `gettimeofday`, and `clockHasMonotonic` above says why - and 0 so
; that nobody reads a Linux number out of this file. The constant
; exists because the id is NOT portable: 1 is CLOCK_MONOTONIC on Linux
; and CLOCK_VIRTUAL, process CPU time, on FreeBSD, and `Sys.ax` carried
; the 1 as a literal until 2026-08-29.
(pub :: clockMonotonicId Int)

(pub fn (clockMonotonicId) 0)

; --------------------------------------------------------------------
; Sockets
;
; Every number below is BSD `n` encoded as `0x2000000 | n`, the same way
; the rest of this file spells one. All of them were EXECUTED on this
; host on 2026-08-24, not read off a header and hoped for: a listener
; was built end to end - socket, bind, listen, accept - and answered a
; real connection from `nc`, and a non-blocking `accept` with nothing
; pending answered -35.
;
; DARWIN'S TWO ARCHITECTURES DO NOT DIVERGE HERE, which is why one file
; still serves both. `sys/syscall.h` carries no architecture conditional
; at all, and the same offsetof/sizeof probe compiled `-arch arm64` and
; `-arch x86_64` gives byte-identical layouts for every struct named
; below; the syscall suite was then run natively and again under Rosetta
; with the same answers. That is the measured version of the claim this
; file's header already makes.
; --------------------------------------------------------------------
; socket(domain, type, protocol) - BSD 97.
(pub :: sysSocketNum Int)

(pub fn (sysSocketNum) 33554529)

; bind(fd, addr, addrlen) - BSD 104. THE ADDRLEN IS EXACT: 0, 4, 8, 12,
; 20, 24 and 28 were each probed and every one answered -22 EINVAL; only
; 16 - the size of `sockaddr_in` - returned 0.
(pub :: sysBindNum Int)

(pub fn (sysBindNum) 33554536)

; listen(fd, backlog) - BSD 106.
(pub :: sysListenNum Int)

(pub fn (sysListenNum) 33554538)

; accept(fd, addr, addrlen) - BSD 30.
;
; `accept4` DOES NOT EXIST ON DARWIN - a sweep of the whole SDK include
; tree finds no `accept4`, no `SOCK_NONBLOCK` and no `SOCK_CLOEXEC` - so
; a non-blocking accepted socket is two calls here and one on Linux.
; `Sys.ax` passes a fourth argument of 0 regardless, which Linux reads
; as `accept4`'s flags and Darwin ignores, the way `sysGetPid` already
; passes zeros a syscall does not read.
(pub :: sysAcceptNum Int)

(pub fn (sysAcceptNum) 33554462)

; connect(fd, addr, addrlen) - BSD 98. On a non-blocking socket this
; answers -36 EINPROGRESS rather than failing; probed.
(pub :: sysConnectNum Int)

(pub fn (sysConnectNum) 33554530)

; setsockopt(fd, level, name, val, len) - BSD 105.
(pub :: sysSetSockOptNum Int)

(pub fn (sysSetSockOptNum) 33554537)

; getsockopt(fd, level, name, val, lenptr) - BSD 118.
(pub :: sysGetSockOptNum Int)

(pub fn (sysGetSockOptNum) 33554550)

; shutdown(fd, how) - BSD 134.
(pub :: sysShutdownNum Int)

(pub fn (sysShutdownNum) 33554566)

; fcntl(fd, cmd, arg) - BSD 92, and the number `sysCwdNum` above also
; holds. They are NOT merged: `sysCwdNum` names "the call that answers
; the working directory", which is `fcntl(F_GETPATH)` here and `getcwd`
; on Linux, and a socket has no business reading that name.
(pub :: sysFcntlNum Int)

(pub fn (sysFcntlNum) 33554524)

; The address family and socket type. `AF_INET` is 2 on both systems -
; and that agreement is a trap, because `AF_INET6` is 30 here against
; Linux's 10, so nothing else in this group may be assumed to match.
(pub :: afInet Int)

(pub fn (afInet) 2)

; AF_INET6, AND THIS IS THE DIVERGENCE THE PARAGRAPH ABOVE WARNED
; ABOUT: 30 here against Linux's 10.
;
; Measured on this host 2026-08-24. `socket(30, SOCK_STREAM, 0)`
; answers a descriptor; `socket(10, SOCK_STREAM, 0)` - Linux's number -
; answers -47 EAFNOSUPPORT, and so does `bind` given a `sockaddr_in6`
; with `afInet` in its family byte. So a cross-copied number fails
; loudly at the first call rather than half-working, which is the one
; mercy in this group. What is NOT loud is `afInet` itself: it is 2 on
; both systems, and a reader who generalises from that agreement writes
; the bug this constant exists to prevent.
;
; `scripts/check-net.sh`'s IPv6 arm is the probe. It runs on all three
; targets in `ci.yml`, opens a listener on `::1` and round-trips a
; connection through it, so a wrong number here cannot be green.
(pub :: afInet6 Int)

(pub fn (afInet6) 30)

(pub :: sockStream Int)

(pub fn (sockStream) 1)

; THE SOCKET-OPTION NUMBERS ARE WHERE DARWIN AND LINUX PART COMPANY, and
; they part completely. `SOL_SOCKET` is 0xffff here and 1 on Linux;
; Darwin's `SO_*` are BSD bitmask-style constants where Linux's are
; small sequential integers. Not one of the four below shares a value
; with its Linux twin, so reusing a Linux number here does not fail - it
; sets some other option.
(pub :: solSocket Int)

(pub fn (solSocket) 65535)

(pub :: soReuseAddr Int)

(pub fn (soReuseAddr) 4)

(pub :: soReusePort Int)

(pub fn (soReusePort) 512)

(pub :: soError Int)

(pub fn (soError) 4103)

; fcntl's file-status commands, and the flag a non-blocking socket sets.
; `O_NONBLOCK` is 4 here and 2048 on Linux.
(pub :: fGetFl Int)

(pub fn (fGetFl) 3)

(pub :: fSetFl Int)

(pub fn (fSetFl) 4)

(pub :: oNonblock Int)

(pub fn (oNonblock) 4)

; EAGAIN, which a non-blocking `accept` or `read` answers negated when
; there is nothing to take yet. 35 here, 11 on Linux - so a caller that
; compares against a literal is correct on one target and silently wrong
; on the other, which is the reason this is a name.
(pub :: eAgain Int)

(pub fn (eAgain) 35)

; WHETHER `sockaddr_in` OPENS WITH A LENGTH BYTE. It does here and does
; not on Linux, and the two layouts cannot share a builder:
;
;   Darwin   0:1 sin_len=16 | 1:1 sin_family=2 | 2:2 sin_port (BE)
;   Linux    0:2 sin_family=2 (host order)     | 2:2 sin_port (BE)
;
; so `sin_family` is ONE byte at offset 1 here and TWO bytes at offset 0
; there. Writing a 16-bit family at offset 0 on Darwin destroys sin_len
; and sin_family together; writing one at offset 1 clobbers the high
; byte of the port. Both remaining fields agree, and `sin_port` and
; `sin_addr` are BIG-endian on every target - the opposite of everything
; else this file records, since all four targets are little-endian
; machines.
;
; The kernel does not enforce sin_len on input - bind succeeded with 0,
; 8 and 28 in it - but it WRITES 16 there on output, so `Sys.ax` writes
; 16 and does not rely on the tolerance. Measured 2026-08-24: the
; address `accept` filled in for a loopback peer opened `16 2 ...`, so
; the length byte comes back as well as going in.
;
; `sockaddr_in6` IS THE SAME QUESTION AGAIN, and the same answer:
;
;   Darwin   0:1 sin6_len=28 | 1:1 sin6_family=30 | 2:2 sin6_port (BE)
;   Linux    0:2 sin6_family=10 (host order)      | 2:2 sin6_port (BE)
;
; and after those four bytes both agree - 4:4 flowinfo, 8:16 address in
; network order, 24:4 scope_id, 28 bytes in all on either system. So
; this one capability covers both families and `Sys.ax` branches on it
; once per builder rather than once per family.
;
; THE 28 IS NOT INTERCHANGEABLE WITH THE 16. Measured on this host
; 2026-08-24: `bind` of a correct `::1` address answered 0 at length 28
; and -22 EINVAL at length 16, which is why `netBind` and `netConnect`
; now read the length off the family in the buffer instead of passing
; the literal that only ever suited one family.
(pub :: sockaddrHasLenByte Int)

(pub fn (sockaddrHasLenByte) 1)

; --------------------------------------------------------------------
; Readiness
;
; Darwin's mechanism is kqueue, and it differs from Linux's epoll in
; shape rather than only in numbers: one call both registers interest
; and collects events, where epoll needs two. `Sys.ax` branches on
; `pollUsesKqueue` and the names below are chosen so that everything
; which CAN agree does - `pollAddOp` and `pollDelOp` happen to be 1 and
; 2 on both systems - leaving exactly one genuine divergence, the filter
; selector, and one layout.
;
; `kqueue` and `kevent` were executed on this host on 2026-08-24: a
; listening socket was registered for read, `kevent` blocked, and it
; returned 1 with the listening descriptor in `ident` when a connection
; arrived.
; --------------------------------------------------------------------
(pub :: pollUsesKqueue Int)

(pub fn (pollUsesKqueue) 1)

; kqueue() - BSD 362. Takes no arguments.
(pub :: sysPollCreateNum Int)

(pub fn (sysPollCreateNum) 33554794)

; kevent(kq, changelist, nchanges, eventlist, nevents, timeout) - BSD
; 363, and it is BOTH of epoll's calls: `sysPollCtlNum` names the same
; number because registering is this call with an eventlist of nothing.
(pub :: sysPollWaitNum Int)

(pub fn (sysPollWaitNum) 33554795)

(pub :: sysPollCtlNum Int)

(pub fn (sysPollCtlNum) 33554795)

; `struct kevent` is 32 bytes on both 64-bit Darwin arches:
;
;   0:8 ident (uintptr) | 8:2 filter (int16) | 10:2 flags (uint16)
;   12:4 fflags (uint32) | 16:8 data (intptr) | 24:8 udata (ptr)
;
; The descriptor an event names is `ident`, at offset 0. The
; declaration sits inside `#pragma pack(4)`, which on 64-bit moves no
; field and changes no size - it only drops the struct's alignment to 4 -
; so these offsets are safe to hardcode. An array of them still wants an
; 8-aligned address, which `memAlloc` gives.
(pub :: pollEventSize Int)

(pub fn (pollEventSize) 32)

(pub :: pollEventFdOffset Int)

(pub fn (pollEventFdOffset) 0)

; EVFILT_READ. THE ONE VALUE THAT GENUINELY DIVERGES: kqueue's filters
; are NEGATIVE small integers naming a kind of event, where epoll's are
; a positive bitmask. -1 here, EPOLLIN = 1 there. It is written into a
; SIGNED 16-BIT field, so `Sys.ax` masks it to two bytes rather than
; storing a word.
(pub :: pollReadFilter Int)

(pub fn (pollReadFilter) (- 0 1))

; EV_ADD and EV_DELETE, which coincide with EPOLL_CTL_ADD and
; EPOLL_CTL_DEL at 1 and 2. The agreement is luck rather than design, so
; both are named on both platforms instead of being assumed.
(pub :: pollAddOp Int)

(pub fn (pollAddOp) 1)

(pub :: pollDelOp Int)

(pub fn (pollDelOp) 2)

; The size of the mask argument epoll_pwait takes and kevent does not.
; Zero here because nothing reads it; see the Linux files for why it
; must be exactly 8 there.
(pub :: pollSigsetSize Int)

(pub fn (pollSigsetSize) 0)

; --------------------------------------------------------------------
; Entropy
;
; getentropy(buf, len) - BSD 500. Answers 0 or -errno, and fills the
; buffer completely or not at all - there is no short answer to handle.
;
; LEN IS CAPPED AT 256 AND THE KERNEL ENFORCES IT: probed on this host
; 2026-08-24, a request for 257 bytes answered -22 EINVAL while 32
; answered 0 with the buffer visibly filled. So `sysRandomBytes` chunks,
; and the chunking is a requirement rather than caution.
;
; Linux's call is `getrandom`, which has a third argument, no small cap,
; and MAY ANSWER SHORT - a different loop, selected by
; `randomIsGetentropy`.
; --------------------------------------------------------------------
(pub :: sysRandomNum Int)

(pub fn (sysRandomNum) 33554932)

(pub :: randomIsGetentropy Int)

(pub fn (randomIsGetentropy) 1)

(pub :: randomMaxChunk Int)

(pub fn (randomMaxChunk) 256)

; --------------------------------------------------------------------
; Signals
;
; A SIGNAL IS DELIVERED THROUGH THE SAME KQUEUE AS A SOCKET HERE, which
; is the single largest shape difference between the two platforms in
; this file. Darwin registers `EVFILT_SIGNAL` on the readiness
; descriptor and the event carries the SIGNAL NUMBER in `ident`; Linux
; has no such filter and instead makes a signal readable as a descriptor
; of its own, which is then added to the epoll set and read for a
; 128-byte record. `signalUsesSignalFd` selects.
;
; Measured on this host 2026-08-24, end to end: `sigprocmask` blocked
; SIGUSR1, `kevent` registered `EVFILT_SIGNAL` for it, `kill` to self
; answered 0, and the wait returned one event with `ident` 30 - the
; signal number - and the low byte of -6 in `filter`.
;
; NEITHER PLATFORM USES A HANDLER, and that is deliberate rather than a
; limitation. An Axiom function is `i64(i64...)` and cannot have the
; shape `void(int, siginfo_t*, void*)` a handler needs; routing the
; signal into the event loop instead removes the handler ABI, async-
; signal-safety, and re-entrancy against a bump allocator all at once.
; --------------------------------------------------------------------
(pub :: signalUsesSignalFd Int)

(pub fn (signalUsesSignalFd) 0)

; sigprocmask(how, set, oset) - BSD 48.
(pub :: sysSigProcMaskNum Int)

(pub fn (sysSigProcMaskNum) 33554480)

; SIG_BLOCK, which is 1 HERE AND 0 ON LINUX. The values are not shared
; and the wrong one is `SIG_UNBLOCK` on Darwin - it would unblock the
; signal it was asked to block, and the process would take the default
; disposition and die.
(pub :: sigBlockHow Int)

(pub fn (sigBlockHow) 1)

; Darwin's `sigset_t` is a single `__uint32_t` - FOUR bytes, against
; Linux's kernel `sigset_t` of eight. Nothing reads a size argument
; here, but the buffer's width is what the kernel copies.
(pub :: sigsetBytes Int)

(pub fn (sigsetBytes) 4)

; EVFILT_SIGNAL, the filter that marks an event as a signal rather than
; a readable socket. Unused on Linux, where the distinction is which
; descriptor woke instead.
(pub :: pollSignalFilter Int)

(pub fn (pollSignalFilter) (- 0 6))

; Unused on Darwin (see `signalUsesSignalFd`), but defined so that
; `Sys.ax` type-checks against every platform module.
