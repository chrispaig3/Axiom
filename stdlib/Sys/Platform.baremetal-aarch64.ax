;; Whether `fork` answers 0 in the child, which is the POSIX convention
;; and what Linux does. Darwin answers the child's pid to both, so
;; `sysForkProcess` normalises; see `sysForkNum` above for the measurement.
(pub :: forkChildIsZero Int)
(pub fn (forkChildIsZero)
  1)

; ------------------------------------------------------------------
; The capability, and the UART behind it.
; ------------------------------------------------------------------
;; 1 where the platform is reached through raw syscalls, 0 where it
;; goes through the C library or a host shim.
(pub :: usesSyscallAbi Int)
(pub fn (usesSyscallAbi)
  0)

; PL011 UART0's data register on QEMU's `virt` machine: one store here
; is one byte on the host's stdio. Not `pub`: the raw addresses stay
; inside this file, so the public surface of every platform module is
; one set of names (`check-stdlib-api.sh`), and this address is this
; target's alone. 150994944 is 0x09000000.
(:: uartBase Int)
(fn (uartBase)
  150994944)

; Store `count` bytes from `buf` to the UART, one `__store8v` per byte.
; Iterative: a loop that recursed would stand `count` frames deep, and
; the stack on-device is 8 KiB of `.bss`. The `v` is the whole point:
; a volatile store is never merged with its neighbours nor deleted as
; never-read, so the bytes survive every opt level without relying on
; an aliasing load to fence them. The trap path does not rely on this
; argument either: its helper is IR the emitter writes directly
; (`emitBaremetalRuntime`), with volatile stores.
(:: uartWriteLoop (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (uartWriteLoop buf count)
  {
    (let u (uartBase))
    (let mut i 0)
    {
      (while (< i count)
        {
          (__store8v u 0 (__load8 buf i))
          (set i (+ i 1))
        })
      0
    }
  })

;; write(fd, buf, count): `Ok` bytes written. Descriptors 1 and 2 are
;; the UART and a store there cannot fail, so the answer is always the
;; whole count; any other descriptor names nothing and is EBADF (9).
;; The platform's own way to write to a descriptor where raw `write` is
;; not available; `Err` 78 where the raw syscall is used instead.
(pub :: platformWriteFd (-> Int Int Int (Result Int Error)))
(pub fn (platformWriteFd fd buf count)
  (if (|| (== fd 1) (== fd 2))
    {
      (uartWriteLoop buf count)
      (Ok count)
    }
    (Err (mkError 9 "platformWriteFd"))))

;; read(fd, buf, count): ENOSYS (78), always. There is no input device
;; on the reference machine - no keyboard, no pipe, no semihosting
;; console - so there are no bytes to answer and no end of file to
;; report. The spelling is the one `sysNowMonotonic` uses for "this
;; platform cannot answer".
;; The platform's own way to read from a descriptor where raw `read` is
;; not available; `Err` 78 where the raw syscall is used instead.
(pub :: platformReadFd (-> Int Int Int (Result Int Error)))
(pub fn (platformReadFd fd buf count)
  (Err (mkError 78 "platformReadFd")))

;; exit(code): park the core. There is no supervisor to return a status
;; to mid-program - semihosting SYS_EXIT is an `hlt` sequence no Axiom
;; form emits - so this polls the UART forever and never answers. The
;; call in the loop is what keeps it a loop: LLVM may delete an empty
;; spin, and it may not delete a call. Returning from `main` is the
;; exit path; the reset vector reports that status.
;; The platform's own way to end the process where raw `exit` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformExitWith (-> Int Int))
(pub fn (platformExitWith code)
  (uartPark code))

;; The platform's own way to open a path where raw `open` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformOpen (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformOpen path flags mode)
  (- 0 78))

;; The platform's own way to close a descriptor where raw `close` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformClose (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformClose fd)
  (- 0 78))

;; The platform's own way to move a descriptor's offset where raw
;; `lseek` is not available; -78 where the raw syscall is used instead.
(pub :: platformSeek (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformSeek fd offset whence)
  (- 0 78))

;; The platform's own way to read at an offset where raw `pread` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformPread (-> Int Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformPread fd buf count offset)
  (- 0 78))

;; The platform's own way to write at an offset where raw `pwrite` is
;; not available; -78 where the raw syscall is used instead.
(pub :: platformPwrite (-> Int Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformPwrite fd buf count offset)
  (- 0 78))

;; The platform's own way to flush a descriptor where raw `fsync` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformFsync (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformFsync fd)
  (- 0 78))

;; The platform's own way to cut a file where raw `ftruncate` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformFtruncate (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformFtruncate fd len)
  (- 0 78))

;; The platform's own way to lock a file where raw `flock` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformFlock (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformFlock fd op)
  (- 0 78))

;; The path of the null device: `/dev/null` here.
(pub :: platformNullPath String)
;@axiom:effect(pure)
(pub fn (platformNullPath)
