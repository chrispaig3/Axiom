(pub fn (sysMunmapNum)
  Internal.Platform::impl_sysMunmapNum)

;; no mapping: there is no kernel
(pub :: mapSharedAnon Int)
(pub fn (mapSharedAnon)
  Internal.Platform::impl_mapSharedAnon)

;; 0: no blocking wait - there is no kernel and no second binding
(pub :: waitWordKind Int)
(pub fn (waitWordKind)
