(pub :: sysListenNum Int)
(pub fn (sysListenNum)
  Internal.Platform::impl_sysListenNum)

;; accept(fd, addr, addrlen) - BSD 30.
(pub :: sysAcceptNum Int)
(pub fn (sysAcceptNum)
  Internal.Platform::impl_sysAcceptNum)

;; connect(fd, addr, addrlen) - BSD 98. On a non-blocking socket this
;; answers -36 EINPROGRESS rather than failing; probed.
(pub :: sysConnectNum Int)
(pub fn (sysConnectNum)
  Internal.Platform::impl_sysConnectNum)

