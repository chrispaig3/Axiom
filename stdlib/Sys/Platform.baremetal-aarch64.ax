(pub :: sysSocketNum Int)
(pub fn (sysSocketNum)
  Internal.Platform::impl_sysSocketNum)

;; bind(fd, addr, addrlen) - BSD 104. THE ADDRLEN IS EXACT: 0, 4, 8, 12,
