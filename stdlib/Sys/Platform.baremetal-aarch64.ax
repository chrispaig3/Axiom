;; The address family and socket type. `AF_INET` is 2 on both systems -
;; and that agreement is a trap, because `AF_INET6` is 30 here against
;; Linux's 10, so nothing else in this group may be assumed to match.
(pub :: afInet Int)
(pub fn (afInet)
  2)

;; AF_INET6, AND THIS IS THE DIVERGENCE THE PARAGRAPH ABOVE WARNED
