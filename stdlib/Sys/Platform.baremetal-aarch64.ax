;; not on Linux, and the two layouts cannot share a builder:
(pub :: sockaddrHasLenByte Int)
(pub fn (sockaddrHasLenByte)
  Internal.Platform::impl_sockaddrHasLenByte)

;; 1 where readiness comes from `kqueue`, 0 where it comes from
;; `epoll`.
(pub :: pollUsesKqueue Int)
(pub fn (pollUsesKqueue)
  Internal.Platform::impl_pollUsesKqueue)

;; kqueue() - BSD 362. Takes no arguments.
(pub :: sysPollCreateNum Int)
(pub fn (sysPollCreateNum)
  Internal.Platform::impl_sysPollCreateNum)

;; kevent(kq, changelist, nchanges, eventlist, nevents, timeout) - BSD
;; 363, and it is BOTH of epoll's calls: `sysPollCtlNum` names the same
;; number because registering is this call with an eventlist of nothing.
(pub :: sysPollWaitNum Int)
(pub fn (sysPollWaitNum)
  Internal.Platform::impl_sysPollWaitNum)

;; The syscall number that adds and removes descriptors in the poll set
;; (`kevent` or `epoll_ctl`).
(pub :: sysPollCtlNum Int)
(pub fn (sysPollCtlNum)
  Internal.Platform::impl_sysPollCtlNum)

;; `struct kevent` is 32 bytes on both 64-bit Darwin arches:
(pub :: pollEventSize Int)
(pub fn (pollEventSize)
  Internal.Platform::impl_pollEventSize)

;; The byte offset of the descriptor inside one readiness event record.
(pub :: pollEventFdOffset Int)
(pub fn (pollEventFdOffset)
  Internal.Platform::impl_pollEventFdOffset)

;; EVFILT_READ. THE ONE VALUE THAT GENUINELY DIVERGES: kqueue's filters
;; are NEGATIVE small integers naming a kind of event, where epoll's are
;; a positive bitmask. -1 here, EPOLLIN = 1 there. It is written into a
;; SIGNED 16-BIT field, so `Sys.ax` masks it to two bytes rather than
;; storing a word.
(pub :: pollReadFilter Int)
(pub fn (pollReadFilter)
  Internal.Platform::impl_pollReadFilter)

;; The writability filter: EVFILT_WRITE (-2) for kqueue, EPOLLOUT (4) for
;; epoll. It goes where `pollReadFilter` goes.
(pub :: pollWriteFilter Int)
(pub fn (pollWriteFilter)
  Internal.Platform::impl_pollWriteFilter)

;; EV_ADD and EV_DELETE, which coincide with EPOLL_CTL_ADD and
;; EPOLL_CTL_DEL at 1 and 2. The agreement is luck rather than design, so
;; both are named on both platforms instead of being assumed.
(pub :: pollAddOp Int)
(pub fn (pollAddOp)
  Internal.Platform::impl_pollAddOp)

;; The operation code that removes a descriptor from the poll set.
(pub :: pollDelOp Int)
(pub fn (pollDelOp)
  Internal.Platform::impl_pollDelOp)

;; The size of the mask argument epoll_pwait takes and kevent does not.
;; Zero here because nothing reads it; see the Linux files for why it
;; must be exactly 8 there.
(pub :: pollSigsetSize Int)
(pub fn (pollSigsetSize)
  Internal.Platform::impl_pollSigsetSize)

;; The syscall number that fills a buffer with random bytes.
(pub :: sysRandomNum Int)
;@axiom:syscall(entropy)
(pub fn (sysRandomNum)
  0)

;; 1 where random bytes come from `getentropy`, 0 where they come from
;; `getrandom`.
(pub :: randomIsGetentropy Int)
(pub fn (randomIsGetentropy)
  Internal.Platform::impl_randomIsGetentropy)

;; The most bytes one random-bytes syscall may fill at a time.
(pub :: randomMaxChunk Int)
(pub fn (randomMaxChunk)
  Internal.Platform::impl_randomMaxChunk)

;; 1 where signals are read from a `signalfd`, 0 where a `kqueue`
;; filter delivers them.
(pub :: signalUsesSignalFd Int)
(pub fn (signalUsesSignalFd)
  Internal.Platform::impl_signalUsesSignalFd)

;; sigprocmask(how, set, oset) - BSD 48.
(pub :: sysSigProcMaskNum Int)
(pub fn (sysSigProcMaskNum)
  Internal.Platform::impl_sysSigProcMaskNum)

;; SIG_BLOCK, which is 1 HERE AND 0 ON LINUX. The values are not shared
;; and the wrong one is `SIG_UNBLOCK` on Darwin - it would unblock the
;; signal it was asked to block, and the process would take the default
;; disposition and die.
(pub :: sigBlockHow Int)
(pub fn (sigBlockHow)
  Internal.Platform::impl_sigBlockHow)

;; Darwin's `sigset_t` is a single `__uint32_t` - FOUR bytes, against
;; Linux's kernel `sigset_t` of eight. Nothing reads a size argument
;; here, but the buffer's width is what the kernel copies.
(pub :: sigsetBytes Int)
(pub fn (sigsetBytes)
  Internal.Platform::impl_sigsetBytes)

;; Unused on Darwin (see `signalUsesSignalFd`), but defined so that
;; `Sys.ax` type-checks against every platform module.
(pub :: sysSignalFdNum Int)
(pub fn (sysSignalFdNum)
  Internal.Platform::impl_sysSignalFdNum)

;; The size of one `signalfd_siginfo` record, or 0 where none is read.
(pub :: sigInfoSize Int)
(pub fn (sigInfoSize)
  Internal.Platform::impl_sigInfoSize)

;; EVFILT_SIGNAL, the filter that marks an event as a signal rather than
;; a readable socket. Unused on Linux, where the distinction is which
;; descriptor woke instead.
(pub :: pollSignalFilter Int)
(pub fn (pollSignalFilter)
  Internal.Platform::impl_pollSignalFilter)

;; kill(pid, sig) - BSD 37.
(pub :: sysKillNum Int)
(pub fn (sysKillNum)
  Internal.Platform::impl_sysKillNum)

;; SIGTERM and SIGINT AGREE on all four targets, which is worth naming
;; rather than assuming because most of their neighbours do not - SIGUSR1
;; is 30 here and 10 on Linux.
(pub :: sigTerm Int)
(pub fn (sigTerm)
  Internal.Platform::impl_sigTerm)

;; The `SIGCHLD` signal number, or zero when child signals are unavailable.
(pub :: sigChild Int)
(pub fn (sigChild)
  Internal.Platform::impl_sigChild)

;; The `SIGINT` signal number.
(pub :: sigInt Int)
(pub fn (sigInt)
  Internal.Platform::impl_sigInt)

;; The Windows Ctrl-Break signal number, or 0 where it is unavailable.
(pub :: sigBreak Int)
(pub fn (sigBreak)
  Internal.Platform::impl_sigBreak)

;; Whether `fork` answers 0 in the child, which is the POSIX convention
;; and what Linux does. Darwin answers the child's pid to both, so
;; `sysForkProcess` normalises; see `sysForkNum` above for the measurement.
(pub :: forkChildIsZero Int)
(pub fn (forkChildIsZero)
  Internal.Platform::impl_forkChildIsZero)

; ------------------------------------------------------------------
; The capability, and the UART behind it.
; ------------------------------------------------------------------
;; 1 where the platform is reached through raw syscalls, 0 where it
;; goes through the C library or a host shim.
(pub :: usesSyscallAbi Int)
(pub fn (usesSyscallAbi)
  Internal.Platform::impl_usesSyscallAbi)

;; exit(code): park the core. There is no supervisor to return a status
;; to mid-program - semihosting SYS_EXIT is an `hlt` sequence no Axiom
;; form emits - so this polls the UART forever and never answers. The
;; call in the loop is what keeps it a loop: LLVM may delete an empty
;; spin, and it may not delete a call. Returning from `main` is the
;; exit path; the reset vector reports that status.
;; The platform's own way to end the process where raw `exit` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformExitWith (-> Int Int))
(pub fn (platformExitWith code)
  (Internal.Platform::impl_platformExitWith code))

;; The path of the null device: `/dev/null` here.
(pub :: platformNullPath String)
;@axiom:effect(pure)
(pub fn (platformNullPath)
  Internal.Platform::impl_platformNullPath)

;; The platform's own way to wait for a child where raw `wait4` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformWait (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformWait pid)
  (Internal.Platform::impl_platformWait pid))

;; The platform's own way to signal a child where raw `kill` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformKill (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformKill pid sig)
  (Internal.Platform::impl_platformKill pid sig))

;; The platform's own way to poll a child where raw `waitid` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformChildExited (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformChildExited pid)
  (Internal.Platform::impl_platformChildExited pid))

;; The platform's own way to read the process id where raw `getpid` is
;; not available; -78 where the raw syscall is used instead.
(pub :: platformPid Int)
;@axiom:effect(pure)
(pub fn (platformPid)
  Internal.Platform::impl_platformPid)

;; The byte that separates the entries of `PATH`: `:` here, `;` on
;; Windows.
(pub :: pathListSep Int)
(pub fn (pathListSep)
  Internal.Platform::impl_pathListSep)

;; 1 where a backslash separates path components and `C:` starts an
;; absolute path, so `Sys.sysRunPath` reads either as a path rather
;; than a name to search for. 0 here, where only `/` does.
(pub :: pathBackslashSeparates Int)
(pub fn (pathBackslashSeparates)
  Internal.Platform::impl_pathBackslashSeparates)

;; 1 where a program named without an extension is found as
;; `NAME.exe`, as on Windows; 0 here, where a program is found under
;; its own name.
(pub :: exeSuffixTried Int)
(pub fn (exeSuffixTried)
  Internal.Platform::impl_exeSuffixTried)

; ------------------------------------------------------------------
; The clock id `Sys.ax` hands to clock_gettime. A target with no
; syscall ABI has no clock_gettime and no syscall table; `Sys.ax` asks `usesSyscallAbi`
; before it reaches the `__syscall3` that would take this id, so the
; value is never read on this target. It is declared because every
; platform module declares one public surface (`check-stdlib-api.sh`),
; and 0 is the answer that would be wrong loudest if it ever were read.
; ------------------------------------------------------------------
;; The id `clock_gettime` takes for the monotonic clock: 0, unused on
;; this target, which has no `clock_gettime`.
(pub :: clockMonotonicId Int)
(pub fn (clockMonotonicId)
  Internal.Platform::impl_clockMonotonicId)

;; Whether `Sys.ax` reads the arm64 counter for its monotonic clock,
;; which it does only where `clock_gettime` has none. 0 here.
(pub :: clockHasCounter Int)
(pub fn (clockHasCounter)
  Internal.Platform::impl_clockHasCounter)

; --------------------------------------------------------------------
; Terminals - UNIMPLEMENTED HERE, AND THAT IS THE ANSWER, NOT A GAP
; SOMEBODY FORGOT.
;
; There is no terminal on the reference machine: no keyboard, no pty,
; no window, only the UART's one-way bytes. So this module answers
; `ttyUsesTermios` 0 and `Sys.ax` takes the branch that reports "not
; supported on this target" - `IO.isTerminal` answers false, and
; `termRaw` answers ENOSYS. The same shape as `clockHasMonotonic` here,
; where the honest ENOSYS was preferred to a clock that does not run.
;
; The eighteen names below are 0 for the reason `clockMonotonicId` is:
; every platform module declares one public surface
; (`check-stdlib-api.sh`), and `ttyUsesTermios` 0 keeps every one of
; them unread.
; --------------------------------------------------------------------
;; Whether this platform's terminal control is the POSIX `termios`
;; trio - read the attributes, edit them, write them back - reached
;; through `ioctl`. Windows answers 0: its mechanism is
;; `GetConsoleMode`/`SetConsoleMode` against a HANDLE, which shares no
;; part of this shape.
(pub :: ttyUsesTermios Int)
(pub fn (ttyUsesTermios)
  Internal.Platform::impl_ttyUsesTermios)

;; ioctl(fd, request, arg) - BSD 54, encoded the way every number in
;; this file is: `0x2000000 | 54` = 33554486.
;; Probe: `SYS_ioctl = 54 (0x36)`, `SYS_ioctl encoded = 33554486`.
(pub :: sysIoctlNum Int)
(pub fn (sysIoctlNum)
  Internal.Platform::impl_sysIoctlNum)

;; TIOCGETA - read the terminal attributes into a `struct termios`.
(pub :: tcGetAttrReq Int)
(pub fn (tcGetAttrReq)
  Internal.Platform::impl_tcGetAttrReq)

;; TIOCSETAF - write the attributes back, after draining pending output
;; and DISCARDING pending input.
(pub :: tcSetAttrReq Int)
(pub fn (tcSetAttrReq)
  Internal.Platform::impl_tcSetAttrReq)

;; TIOCGWINSZ - read `struct winsize`.
(pub :: tcWinSizeReq Int)
(pub fn (tcWinSizeReq)
  Internal.Platform::impl_tcWinSizeReq)

;; 0 rather than a plausible size. `Sys.ax` allocates this many bytes
;; for a saved terminal state, and a caller that reached here would get
;; a zero-length buffer and the "unsupported" answer, not a short one it
;; could half-fill.
(pub :: termiosBytes Int)
(pub fn (termiosBytes)
  Internal.Platform::impl_termiosBytes)

;; The width of one flag word, which is also the STRIDE of the four of
;; them: `c_iflag` at 0, `c_oflag` at 8, `c_cflag` at 16, `c_lflag` at
;; 24. Probe: `c_iflag@0 c_oflag@8 c_cflag@16 c_lflag@24`, each of
;; `size 8`. The four offsets are `n * termiosFlagBytes` on every
;; platform this library targets, so `Sys.ax` carries one multiplication
;; rather than four constants per module.
(pub :: termiosFlagBytes Int)
(pub fn (termiosFlagBytes)
  Internal.Platform::impl_termiosFlagBytes)

;; Where the control-character array `c_cc` begins.
;; Probe: `offsetof c_cc = 32 (size 20, NCCS 20)`.
(pub :: termiosCcOff Int)
(pub fn (termiosCcOff)
  Internal.Platform::impl_termiosCcOff)

;; The two `c_cc` slots that mean something once ICANON is off: how many
;; bytes a `read` must collect before it returns, and how long it waits
;; in tenths of a second. Probe: `VMIN = 16`, `VTIME = 17`.
(pub :: termiosVminIdx Int)
(pub fn (termiosVminIdx)
  Internal.Platform::impl_termiosVminIdx)

;; The index of `VTIME` in the termios control-character array.
(pub :: termiosVtimeIdx Int)
(pub fn (termiosVtimeIdx)
  Internal.Platform::impl_termiosVtimeIdx)

;; c_lflag bits. Probe: `ECHO = 0x8 (8)`, `ICANON = 0x100 (256)`,
;; `ISIG = 0x80 (128)`, `IEXTEN = 0x400 (1024)`.
(pub :: tiosEcho Int)
(pub fn (tiosEcho)
  Internal.Platform::impl_tiosEcho)

;; The `ICANON` local-mode flag: line editing by the terminal.
(pub :: tiosIcanon Int)
(pub fn (tiosIcanon)
  Internal.Platform::impl_tiosIcanon)

;; The `ISIG` local-mode flag: the terminal turns Ctrl-C into a signal.
(pub :: tiosIsig Int)
(pub fn (tiosIsig)
  Internal.Platform::impl_tiosIsig)

;; The `IEXTEN` local-mode flag: extended input processing.
(pub :: tiosIexten Int)
(pub fn (tiosIexten)
  Internal.Platform::impl_tiosIexten)

;; c_iflag bits. Probe: `BRKINT = 0x2`, `ICRNL = 0x100`,
;; `ISTRIP = 0x20`, `IXON = 0x200`.
(pub :: tiosBrkint Int)
(pub fn (tiosBrkint)
  Internal.Platform::impl_tiosBrkint)

;; The `ICRNL` input flag: carriage return becomes newline.
(pub :: tiosIcrnl Int)
(pub fn (tiosIcrnl)
  Internal.Platform::impl_tiosIcrnl)

;; The `ISTRIP` input flag: strip the eighth bit.
(pub :: tiosIstrip Int)
(pub fn (tiosIstrip)
  Internal.Platform::impl_tiosIstrip)

;; The `IXON` input flag: Ctrl-S and Ctrl-Q flow control.
(pub :: tiosIxon Int)
(pub fn (tiosIxon)
  Internal.Platform::impl_tiosIxon)

;; The one c_oflag bit raw mode touches. Probe: `OPOST = 0x1`, and it
;; is 0x1 on Linux and FreeBSD too.
(pub :: tiosOpost Int)
(pub fn (tiosOpost)
  Internal.Platform::impl_tiosOpost)

