;; The IPv4 address family, `AF_INET`: 2 on every target. That agreement
;; is a trap, because `AF_INET6` below is not shared.
(pub :: afInet Int)
(pub fn (afInet)
  2)

;; The IPv6 address family, `AF_INET6`, in Linux's spelling: 10. Darwin's
;; is 30.
(pub :: afInet6 Int)
(pub fn (afInet6)
  23)

;; The `SOCK_STREAM` socket type: a TCP byte stream.
(pub :: sockStream Int)
(pub fn (sockStream)
  1)

;; The socket-option level `SOL_SOCKET`, in Linux's spelling: 1. Darwin's
;; is 0xffff, and its `SO_*` are BSD bitmask-style constants where
;; Linux's are small sequential integers, so a number copied between the
;; two doesn't fail, it sets some other option.
(pub :: solSocket Int)
(pub fn (solSocket)
  65535)

;; The `SO_REUSEADDR` socket option.
(pub :: soReuseAddr Int)
(pub fn (soReuseAddr)
  4)

;; The `SO_REUSEPORT` socket option.
(pub :: soReusePort Int)
(pub fn (soReusePort)
  15)

;; The `SO_ERROR` socket option, read after a non-blocking connect
;; finishes.
(pub :: soError Int)
(pub fn (soError)
  4103)

;; fcntl's command that reads a descriptor's status flags, in Linux's
;; spelling: 3. Unused: sockets go through Winsock.
(pub :: fGetFl Int)
(pub fn (fGetFl)
  3)

;; The `fcntl` command that sets a descriptor's status flags.
(pub :: fSetFl Int)
(pub fn (fSetFl)
  4)

;; fcntl's F_DUPFD_CLOEXEC: a duplicate of a descriptor, closed on exec.
;; `IO.termRaw` keeps one, so its guard can restore the terminal however
;; the caller's file is closed. 0 where nothing has terminal control.
(pub :: fDupFdCloexec Int)
(pub fn (fDupFdCloexec)
  0)

;; The `O_NONBLOCK` status flag.
(pub :: oNonblock Int)
(pub fn (oNonblock)
  2048)

;; EAGAIN, which a non-blocking `accept` or `read` answers negated when
;; there is nothing to take yet: 11, Linux's value. Darwin's is 35, so a
;; caller that compares against a literal is silently wrong on one of
;; them, which is the reason this is a name.
(pub :: eAgain Int)
(pub fn (eAgain)
  11)

;; ENOSYS - the kernel has no such call: 38 on Linux, 78 on Darwin and FreeBSD.
(pub :: eNoSys Int)
(pub fn (eNoSys)
  38)

;; EOPNOTSUPP - the operation does not apply to this socket or file: 95 on
;; Linux, 102 on Darwin, 45 on FreeBSD.
(pub :: eOpNotSupp Int)
(pub fn (eOpNotSupp)
  95)

;; ENOTCONN - the socket is not connected: 107 on Linux, 57 on the BSDs.
(pub :: eNotConn Int)
(pub fn (eNotConn)
  107)

;; ECONNREFUSED - nothing listens on the port: 111 on Linux, 61 on the BSDs.
(pub :: eConnRefused Int)
(pub fn (eConnRefused)
  111)

;; ECONNRESET - the peer reset the connection: 104 on Linux, 54 on the BSDs.
(pub :: eConnReset Int)
(pub fn (eConnReset)
  104)

;; ECONNABORTED - the connection was aborted before it was accepted: 103 on
;; Linux, 53 on the BSDs.
(pub :: eConnAborted Int)
(pub fn (eConnAborted)
  103)

;; EHOSTUNREACH - no route to the host: 113 on Linux, 65 on the BSDs.
(pub :: eHostUnreach Int)
(pub fn (eHostUnreach)
  113)

;; ENETUNREACH - no route to the network: 101 on Linux, 51 on the BSDs.
(pub :: eNetUnreach Int)
(pub fn (eNetUnreach)
  101)

;; ENETDOWN - the network is down: 100 on Linux, 50 on the BSDs.
(pub :: eNetDown Int)
(pub fn (eNetDown)
  100)

;; EADDRINUSE - another socket holds the address: 98 on Linux, 48 on the BSDs.
(pub :: eAddrInUse Int)
(pub fn (eAddrInUse)
  98)

;; EADDRNOTAVAIL - the address is not one of this host's: 99 on Linux, 49
;; on the BSDs.
(pub :: eAddrNotAvail Int)
(pub fn (eAddrNotAvail)
  99)

;; EINPROGRESS - a non-blocking connect has started and not finished: 115
;; on Linux, 36 on the BSDs.
(pub :: eInProgress Int)
(pub fn (eInProgress)
  115)

;; Whether `sockaddr_in` opens with a length byte: 0, as on Linux. The
;; BSD layout has one, and the two can't share a builder.
(pub :: sockaddrHasLenByte Int)
(pub fn (sockaddrHasLenByte)
  0)

;; 1 where readiness comes from `kqueue`, 0 where it comes from
;; `epoll`.
(pub :: pollUsesKqueue Int)
(pub fn (pollUsesKqueue)
  0)

;; The call that makes a poll set: 0 and unused. Sockets go through Winsock.
(pub :: sysPollCreateNum Int)
(pub fn (sysPollCreateNum)
  0)

;; The call that waits on the poll set: 0 and unused. A poller here keeps
;; its own table and waits through `platformPoll`.
(pub :: sysPollWaitNum Int)
(pub fn (sysPollWaitNum)
  0)

;; The syscall number that adds and removes descriptors in the poll set
;; (`kevent` or `epoll_ctl`).
(pub :: sysPollCtlNum Int)
(pub fn (sysPollCtlNum)
  0)

;; The size of one readiness event record: 12, Linux's packed
;; `epoll_event`. Unused: sockets go through Winsock.
(pub :: pollEventSize Int)
(pub fn (pollEventSize)
  24)

;; The byte offset of the descriptor inside one readiness event record.
(pub :: pollEventFdOffset Int)
(pub fn (pollEventFdOffset)
  8)

;; The readability filter in epoll's spelling: EPOLLIN, 1. kqueue's
;; EVFILT_READ is -1, a negative event kind rather than a bitmask bit.
(pub :: pollReadFilter Int)
(pub fn (pollReadFilter)
  1)

;; The writability filter: EVFILT_WRITE (-2) for kqueue, EPOLLOUT (4) for
;; epoll. It goes where `pollReadFilter` goes.
(pub :: pollWriteFilter Int)
(pub fn (pollWriteFilter)
  4)

;; EV_ADD and EV_DELETE, which coincide with EPOLL_CTL_ADD and
;; EPOLL_CTL_DEL at 1 and 2. The agreement is luck rather than design, so
;; both are named on both platforms instead of being assumed.
(pub :: pollAddOp Int)
(pub fn (pollAddOp)
  1)

;; The operation code that removes a descriptor from the poll set.
(pub :: pollDelOp Int)
(pub fn (pollDelOp)
  2)

;; The size of the mask argument `epoll_pwait` takes: 8, as on Linux,
;; where it must be exactly 8. Nothing reads it here.
(pub :: pollSigsetSize Int)
(pub fn (pollSigsetSize)
  8)

;; The syscall number that fills a buffer with random bytes.
(pub :: sysRandomNum Int)
;@axiom:syscall(entropy)
(pub fn (sysRandomNum)
  0)

;; 1 where random bytes come from `getentropy`, 0 where they come from
;; `getrandom`.
(pub :: randomIsGetentropy Int)
(pub fn (randomIsGetentropy)
  0)

;; The most bytes one random-bytes syscall may fill at a time.
(pub :: randomMaxChunk Int)
(pub fn (randomMaxChunk)
  256)

;; 1 where signals are read from a `signalfd`, 0 where a `kqueue`
;; filter delivers them.
(pub :: signalUsesSignalFd Int)
(pub fn (signalUsesSignalFd)
  1)

;; sigprocmask(how, set, oset): 0 and unused. `platformSignalBlock`
;; captures the supported console controls through the emitted runtime.
(pub :: sysSigProcMaskNum Int)
(pub fn (sysSigProcMaskNum)
  0)

;; SIG_BLOCK in Linux's spelling: 0. Darwin's is 1, and Darwin's 0 is
;; `SIG_UNBLOCK`, so a value copied across would unblock the signal it
;; was asked to block.
(pub :: sigBlockHow Int)
(pub fn (sigBlockHow)
  0)

;; The width of a signal set: 8 bytes, Linux's kernel `sigset_t`.
;; Nothing reads it here.
(pub :: sigsetBytes Int)
(pub fn (sigsetBytes)
  8)

;; signalfd: 0 and unused. Controls use a poller table row and the
;; runtime queue instead of a signal descriptor.
(pub :: sysSignalFdNum Int)
(pub fn (sysSignalFdNum)
  0)

;; The size of one `signalfd_siginfo` record, or 0 where none is read.
(pub :: sigInfoSize Int)
(pub fn (sigInfoSize)
  128)

;; EVFILT_SIGNAL, the filter that marks an event as a signal rather than
;; a readable socket. Unused on Linux, where the distinction is which
;; descriptor woke instead.
(pub :: pollSignalFilter Int)
(pub fn (pollSignalFilter)
  0)

;; kill(pid, sig): 0 and unused. Processes go through kernel32.
(pub :: sysKillNum Int)
(pub fn (sysKillNum)
  0)

;; SIGTERM, 15. It and SIGINT agree on every target, which is worth
;; naming because most of their neighbours don't: SIGUSR1 is 10 on Linux
;; and 30 on Darwin.
(pub :: sigTerm Int)
(pub fn (sigTerm)
  15)

;; The `SIGCHLD` signal number, or zero when child signals are unavailable.
(pub :: sigChild Int)
(pub fn (sigChild)
  0)

;; The `SIGINT` signal number.
(pub :: sigInt Int)
(pub fn (sigInt)
  2)

;; The Windows Ctrl-Break signal number, or 0 where it is unavailable.
(pub :: sigBreak Int)
(pub fn (sigBreak)
  21)

;; Whether `fork` answers 0 in the child, the POSIX convention: 1, though
;; this target has no `fork`.
(pub :: forkChildIsZero Int)
(pub fn (forkChildIsZero)
  1)

; ------------------------------------------------------------------
; The capability, and the bindings behind it.
; ------------------------------------------------------------------
;; 1 where the platform is reached through raw syscalls, 0 where it
;; goes through the C library or a host shim.
(pub :: usesSyscallAbi Int)
(pub fn (usesSyscallAbi)
  0)

; Not `pub`: the raw bindings stay inside this file, so the public
; surface of every platform module is one set of names. `#0` on the
; emitted declares and the `dllimport` on the runtime's own copies of
; four of these are the emitter's business (`emitWinRuntime`).
(extern "kernel32"
  (winGetStdHandle :: (-> Int Int) (symbol "GetStdHandle"))
  (winWriteFile :: (-> Int Int Int Int Int Int) (symbol "WriteFile"))
  (winReadFile :: (-> Int Int Int Int Int Int) (symbol "ReadFile"))
  (winExitProcess :: (-> Int Int) (symbol "ExitProcess"))
  (winGetLastError :: Int (symbol "GetLastError"))
  (winCreateFileW :: (-> Int Int Int Int Int Int Int Int) (symbol "CreateFileW"))
  (winCloseHandle :: (-> Int Int) (symbol "CloseHandle"))
  (winSetFilePointerEx :: (-> Int Int Int Int Int) (symbol "SetFilePointerEx"))
  (winFlushFileBuffers :: (-> Int Int) (symbol "FlushFileBuffers"))
  (winSetEndOfFile :: (-> Int Int) (symbol "SetEndOfFile"))
  (winLockFileEx :: (-> Int Int Int Int Int Int Int) (symbol "LockFileEx"))
  (winUnlockFileEx :: (-> Int Int Int Int Int Int) (symbol "UnlockFileEx"))
  (winDeleteFileW :: (-> Int Int) (symbol "DeleteFileW"))
  (winMoveFileExW :: (-> Int Int Int Int) (symbol "MoveFileExW"))
  (winCreateDirectoryW :: (-> Int Int Int) (symbol "CreateDirectoryW"))
  (winRemoveDirectoryW :: (-> Int Int) (symbol "RemoveDirectoryW"))
  (winGetFileInformationByHandleEx :: (-> Int Int Int Int Int)
    (symbol "GetFileInformationByHandleEx"))
  (winGetCurrentDirectoryW :: (-> Int Int Int) (symbol "GetCurrentDirectoryW"))
  (winCreateProcessW :: (-> Int Int Int Int Int Int Int Int Int Int Int) (symbol "CreateProcessW"))
  (winWaitForSingleObject :: (-> Int Int Int) (symbol "WaitForSingleObject"))
  (winGetExitCodeProcess :: (-> Int Int Int) (symbol "GetExitCodeProcess"))
  (winTerminateProcess :: (-> Int Int Int) (symbol "TerminateProcess"))
  (winGetCurrentProcessId :: Int (symbol "GetCurrentProcessId"))
  (winSetHandleInformation :: (-> Int Int Int Int) (symbol "SetHandleInformation"))
  (winSetStdHandle :: (-> Int Int Int) (symbol "SetStdHandle"))
  (winQueryPerformanceCounter :: (-> Int Int) (symbol "QueryPerformanceCounter"))
  (winQueryPerformanceFrequency :: (-> Int Int) (symbol "QueryPerformanceFrequency"))
  (winGetSystemTimePreciseAsFileTime :: (-> Int Int) (symbol "GetSystemTimePreciseAsFileTime"))
  (winSleep :: (-> Int Int) (symbol "Sleep"))
  (winVirtualAlloc :: (-> Int Int Int Int Int) (symbol "VirtualAlloc"))
  (winVirtualFree :: (-> Int Int Int Int) (symbol "VirtualFree"))
  (winVirtualLock :: (-> Int Int Int) (symbol "VirtualLock"))
  (winVirtualUnlock :: (-> Int Int Int) (symbol "VirtualUnlock"))
  (winGetFileType :: (-> Int Int) (symbol "GetFileType"))
  (winGetConsoleMode :: (-> Int Int Int) (symbol "GetConsoleMode"))
  (winSetConsoleMode :: (-> Int Int Int) (symbol "SetConsoleMode"))
  (winGetConsoleScreenBufferInfo :: (-> Int Int Int) (symbol "GetConsoleScreenBufferInfo")))

; `WaitOnAddress` and its wake live in an API set, the DLL
; `synchronization.lib` binds.
(extern "api-ms-win-core-synch-l1-2-0"
  (winWaitOnAddress :: (-> Int Int Int Int Int) (symbol "WaitOnAddress"))
  (winWakeByAddressAll :: (-> Int Int) (symbol "WakeByAddressAll")))

; HANDLE GetStdHandle(DWORD) - a HANDLE: not masked.
; BOOL WriteFile(HANDLE, LPCVOID, DWORD, LPDWORD, LPOVERLAPPED) - BOOL: masked.
; BOOL ReadFile(HANDLE, LPVOID, DWORD, LPDWORD, LPOVERLAPPED) - BOOL: masked.
; void ExitProcess(UINT) - never returns.
; DWORD GetLastError(void) - DWORD: masked.
; HANDLE CreateFileW(LPCWSTR, DWORD, DWORD, LPSECURITY_ATTRIBUTES, DWORD,
;   DWORD, HANDLE) - a HANDLE: not masked, and -1 on failure.
; BOOL CloseHandle(HANDLE) - BOOL: masked.
; BOOL SetFilePointerEx(HANDLE, LARGE_INTEGER, PLARGE_INTEGER, DWORD) -
;   BOOL: masked. The distance is one 64-bit register on both arches.
; BOOL DeleteFileW(LPCWSTR) - BOOL: masked.
; BOOL MoveFileExW(LPCWSTR, LPCWSTR, DWORD) - BOOL: masked.
; BOOL CreateDirectoryW(LPCWSTR, LPSECURITY_ATTRIBUTES) - BOOL: masked.
; BOOL RemoveDirectoryW(LPCWSTR) - BOOL: masked.
; BOOL GetFileInformationByHandleEx(HANDLE, FILE_INFO_BY_HANDLE_CLASS,
;   LPVOID, DWORD) - BOOL: masked.
; DWORD GetCurrentDirectoryW(DWORD, LPWSTR) - DWORD: masked.
; BOOL CreateProcessW(LPCWSTR, LPWSTR, LPSECURITY_ATTRIBUTES,
;   LPSECURITY_ATTRIBUTES, BOOL, DWORD, LPVOID, LPCWSTR, LPSTARTUPINFOW,
;   LPPROCESS_INFORMATION) - BOOL: masked.
; DWORD WaitForSingleObject(HANDLE, DWORD) - DWORD: masked.
; BOOL GetExitCodeProcess(HANDLE, LPDWORD) - BOOL: masked.
; BOOL TerminateProcess(HANDLE, UINT) - BOOL: masked.
; DWORD GetCurrentProcessId(void) - DWORD: masked.
; BOOL SetHandleInformation(HANDLE, DWORD, DWORD) - BOOL: masked.
; BOOL SetStdHandle(DWORD, HANDLE) - BOOL: masked.
; A descriptor to a HANDLE: see the header.
(:: winHandleOf (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (winHandleOf fd)
  (if (== fd 0)
    (winGetStdHandle (- 0 10))
    (if (== fd 1)
      (winGetStdHandle (- 0 11))
      (if (== fd 2)
        (winGetStdHandle (- 0 12))
        fd))))

; A Win32 error code as the errno `Sys.ax`'s callers already test for,
; NEGATED, so every `sysFailed`/`sysErrno` comparison above this file
; is unchanged. Anything unmapped is EIO (5): a failure, named as a
; failure, never mistaken for a count.
(:: winErrnoOf (-> Int Int))
(fn (winErrnoOf code)
  ; ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND: ENOENT.
  (if (|| (== code 2) (== code 3))
      (- 0 2)
    ; ERROR_ACCESS_DENIED: EACCES.
    (== code 5)
      (- 0 13)
    ; ERROR_INVALID_HANDLE: EBADF.
    (== code 6)
      (- 0 9)
    ; ERROR_NOT_ENOUGH_MEMORY: ENOMEM.
    (== code 8)
      (- 0 12)
    ; ERROR_SHARING_VIOLATION, ERROR_LOCK_VIOLATION: EBUSY.
    (|| (== code 32) (== code 33))
      (- 0 16)
    ; ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS: EEXIST.
    (|| (== code 80) (== code 183))
      (- 0 eExist)
    ; ERROR_INVALID_PARAMETER, ERROR_INVALID_NAME: EINVAL.
    (|| (== code 87) (== code 123))
      (- 0 22)
    ; ERROR_DISK_FULL: ENOSPC.
    (== code 112)
      (- 0 28)
    ; ERROR_BROKEN_PIPE, ERROR_NO_DATA: EPIPE.
    (|| (== code 109) (== code 232))
      (- 0 32)
    ; ERROR_DIR_NOT_EMPTY: ENOTEMPTY.
    (== code 145)
      (- 0 39)
    ; ERROR_FILENAME_EXCED_RANGE: ENAMETOOLONG.
    (== code 206)
      (- 0 36)
    ; ERROR_DIRECTORY: ENOTDIR.
    (== code 267)
      (- 0 20)
    ; ERROR_BAD_EXE_FORMAT: ENOEXEC.
    (== code 193)
      (- 0 8)
    (- 0 5)))

; The DWORD out-cell `WriteFile`/`ReadFile` write their count through.
; A fresh 8-byte word per call, zeroed by `__alloc`, so the upper half
; of the word is 0 when the kernel has written only the lower four
; bytes - the same hazard `sysWaitPid` zeroes its status cell against.
; `lpNumberOfBytesWritten` may be NULL only when `lpOverlapped` is
; not, so the cell is not optional.
(:: winCell Int)
;@axiom:effect(unsafe)
(fn (winCell)
  (__alloc 8))

;; write(fd, buf, count): `Ok` bytes written, or `Err` carrying the
;; errno `winErrnoOf` maps the last error to.
;; The platform's own way to write to a descriptor where raw `write` is
;; not available; `Err` 78 where the raw syscall is used instead.
;; A socket writes through `send`.
(pub :: platformWriteFd (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformWriteFd fd buf count)
  (if (winIsSocket (winHandleOf fd))
    (wsaSend (winHandleOf fd) buf count)
    {
      (let cell winCell)
      {
        (let ok (& (winWriteFile (winHandleOf fd) buf count cell 0) 4294967295))
        (if (== ok 0)
          (Err (mkError (- 0 (winErrnoOf (& winGetLastError 4294967295))) "platformWriteFd"))
          (Ok (& (__load64 cell 0) 4294967295)))
      }
    }))

;; read(fd, buf, count): `Ok` bytes read, `Ok 0` at end of file, or
;; `Err` carrying the errno. A broken pipe (ERROR_BROKEN_PIPE, 109) on a
;; read is end of file, which is what a POSIX read of a closed pipe
;; answers too. A directory handle refuses the read with
;; ERROR_INVALID_FUNCTION (1), which answers EISDIR, as `read` of a
;; directory does on Linux and Darwin.
;; The platform's own way to read from a descriptor where raw `read` is
;; not available; `Err` 78 where the raw syscall is used instead.
;; A socket reads through `recv`, so a receive timeout on it holds and
;; answers EAGAIN.
(pub :: platformReadFd (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformReadFd fd buf count)
  (if (winIsSocket (winHandleOf fd))
    (wsaRecv (winHandleOf fd) buf count)
    {
      (let r (winReaderRead (winHandleOf fd) buf count))
      (if (>= r 0)
        (Ok r)
        (if (== r -109)
            (Ok 0)
          (== r -1)
            (Err (mkError eIsDir "platformReadFd"))
          (Err (mkError (- 0 (winErrnoOf (- 0 r))) "platformReadFd"))))
    }))

;; exit(code): `ExitProcess` ends every thread, as `exit_group` does.
;; The platform's own way to end the process where raw `exit` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformExitWith (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformExitWith code)
  (winExitProcess code))

; ------------------------------------------------------------------
; Files and directories.
;
; `Sys.ax` and `IO.ax` hand paths over as NUL-terminated UTF-8, and the
; `W` calls take NUL-terminated UTF-16. `winWidePath` converts in this
; file, with no kernel32 call, so the conversion is the same on every
; Windows build and refuses malformed UTF-8 with EINVAL rather than
; substituting U+FFFD into a name the caller never wrote. Names coming
; back (`platformReadDir`, `platformGetCwd`) convert the other way, and
; there an unpaired surrogate, which NTFS permits, becomes U+FFFD.
;
; Every file opens with all three share modes, so a file another
; handle holds open can still be read, written, renamed and deleted, as
; on POSIX. `FILE_FLAG_BACKUP_SEMANTICS` lets the same call open a
; directory, which is how `ioReadDir` lists one and how `isDir` tells
; one apart: the open succeeds and the read answers EISDIR. Handles
; are not inherited unless a spawn asks, so `O_CLOEXEC` needs nothing.
;
; Paths keep the classic MAX_PATH limit of 260 UTF-16 units: a longer
; one fails with ENAMETOOLONG or ENOENT.
; ------------------------------------------------------------------
(:: winGet16 (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (winGet16 src j)
  (+ (__load8 src (* j 2)) (* (__load8 src (+ (* j 2) 1)) 256)))

; The little-endian u32 at byte `off` of `p`. `__load64` indexes words,
; and the records below put fields at byte offsets that aren't.
(:: winGet32 (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (winGet32 p off)
  (+ (+ (__load8 p off) (* (__load8 p (+ off 1)) 256))
    (+ (* (__load8 p (+ off 2)) 65536) (* (__load8 p (+ off 3)) 16777216))))

; Encode the code point `cp` as UTF-8 at `dst + k`, answering the next
; free byte.
(:: winPutUtf8 (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (winPutUtf8 dst k cp)
  (if (< cp 128)
      {
        (__store8 dst k cp)
        (+ k 1)
      }
    (< cp 2048)
      {
        (__store8 dst k (+ 192 (/ cp 64)))
        (__store8 dst (+ k 1) (+ 128 (& cp 63)))
        (+ k 2)
      }
    (< cp 65536)
      {
        (__store8 dst k (+ 224 (/ cp 4096)))
        (__store8 dst (+ k 1) (+ 128 (& (/ cp 64) 63)))
        (__store8 dst (+ k 2) (+ 128 (& cp 63)))
        (+ k 3)
      }
    {
      (__store8 dst k (+ 240 (/ cp 262144)))
      (__store8 dst (+ k 1) (+ 128 (& (/ cp 4096) 63)))
      (__store8 dst (+ k 2) (+ 128 (& (/ cp 64) 63)))
      (__store8 dst (+ k 3) (+ 128 (& cp 63)))
      (+ k 4)
    }))

; Encode the `n` UTF-16 units at `src` from unit `j` as UTF-8 at `dst`
; from byte `k`, answering the byte count written. A surrogate pair
; becomes one code point; an unpaired surrogate becomes U+FFFD. The
; caller sizes `dst` at three bytes per unit, which every unit fits.
(:: winUtf8From (-> Int Int Int Int Int Int))
(fn (winUtf8From src j n dst k)
  (if (>= j n)
    k
    {
      (let u (winGet16 src j))
      (if (&& (&& (>= u 55296) (<= u 56319)) (< (+ j 1) n))
          {
            (let v (winGet16 src (+ j 1)))
            (if (&& (>= v 56320) (<= v 57343))
              (winUtf8From src (+ j 2) n dst
                (winPutUtf8 dst k (+ 65536 (+ (* (- u 55296) 1024) (- v 56320)))))
              (winUtf8From src (+ j 1) n dst (winPutUtf8 dst k 65533)))
          }
        (&& (>= u 55296) (<= u 57343))
          (winUtf8From src (+ j 1) n dst (winPutUtf8 dst k 65533))
        (winUtf8From src (+ j 1) n dst (winPutUtf8 dst k u)))
    }))

; The last error as a negated errno, the answer every shim below fails with.
(:: winLastErr Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (winLastErr)
  (winErrnoOf (& winGetLastError 4294967295)))

; A BOOL answer as 0, or the last error.
(:: winBoolResult (-> Int Int))
;@axiom:effect(io)
(fn (winBoolResult ok)
  (if (== (& ok 4294967295) 0)
    winLastErr
    0))

; CreateFileW's access, from the open flags in Linux's spelling:
; O_RDONLY 0, O_WRONLY 1 and O_RDWR 2 in the low two bits, and O_APPEND
; (0x400) asking for FILE_APPEND_DATA, which puts every write at the
; end, in place of GENERIC_WRITE.
(:: winAccessOf (-> Int Int))
(fn (winAccessOf flags)
  {
    (let mode (& flags 3))
    (let read
      (if (|| (== mode 0) (== mode 2))
        2147483648
        0))
    (let write
      (if (== mode 0)
          0
        (!= (& flags 1024) 0)
          ; FILE_APPEND_DATA | SYNCHRONIZE
          1048580
        ; GENERIC_WRITE
        1073741824))
    (| read write)
  })

; CreateFileW's disposition, from O_CREAT (0x40), O_EXCL (0x80) and
; O_TRUNC (0x200): CREATE_NEW 1, CREATE_ALWAYS 2, OPEN_EXISTING 3,
; OPEN_ALWAYS 4, TRUNCATE_EXISTING 5.
(:: winDispositionOf (-> Int Int))
(fn (winDispositionOf flags)
  {
    (let creat (!= (& flags 64) 0))
    (let excl (!= (& flags 128) 0))
    (let trunc (!= (& flags 512) 0))
    (if (&& creat excl)
        1
      (&& creat trunc)
        2
      creat
        4
      trunc
        5
      3)
  })

; 1 when the handle `h` names a directory, from FILE_BASIC_INFO's
; attributes (FileBasicInfo is class 0, and the attributes sit at byte
; 32 of its 40), 0 when it doesn't, or -1 when the query fails.
(:: winIsDirHandle (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (winIsDirHandle h)
  {
    (let info (__alloc 40))
    (if (== (& (winGetFileInformationByHandleEx h 0 info 40) 4294967295) 0)
      (- 0 1)
      (if (!= (& (winGet32 info 32) 16) 0)
        1
        0))
  })

;; open(path, flags, mode): a descriptor, or `-errno`. The flags are
;; the ones this module declares; the mode is ignored, because Windows
;; files take their permissions from the directory they are made in.
;; The platform's own way to open a path where raw `open` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformOpen (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformOpen path flags mode)
  {
    (let wide (winWidePath path))
    (if (== wide 0)
      (- 0 22)
      {
        ; FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, and
        ; FILE_ATTRIBUTE_NORMAL | FILE_FLAG_BACKUP_SEMANTICS.
        (let h (winCreateFileW wide (winAccessOf flags) 7 0 (winDispositionOf flags) 33554560 0))
        (if (== h (- 0 1))
            winLastErr
          (== (& flags oDirectory) 0)
            h
          {
            (let isdir (winIsDirHandle h))
            (if (== isdir 1)
              h
              {
                (winCloseHandle h)
                (if (< isdir 0)
                  (- 0 5)
                  (- 0 20))
              })
          })
      })
  })

;; close(fd): 0, or `-errno`.
;; The platform's own way to close a descriptor where raw `close` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformClose (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformClose fd)
  {
