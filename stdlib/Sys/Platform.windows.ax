; ------------------------------------------------------------------
; The console, over kernel32. A console is a character device that
; answers `GetConsoleMode`; its mode word is what raw mode edits and
; what a `TermGuard`'s release writes back; its size is the window
; rectangle of `GetConsoleScreenBufferInfo`.
; ------------------------------------------------------------------
;; Whether `fd` is a console: a character device (`GetFileType` 2)
;; that answers `GetConsoleMode`. A pipe or a file is neither.
(pub :: platformIsConsole (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformIsConsole fd)
  {
    (let h (winHandleOf fd))
    (if (!= (& (winGetFileType h) 4294967295) 2)
      0
      {
        (let cell winCell)
        (if (== (& (winGetConsoleMode h cell) 4294967295) 0)
          0
          1)
      })
  })

;; The console's mode word (`GetConsoleMode`), or `-errno`.
(pub :: platformConsoleMode (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformConsoleMode fd)
  {
    (let cell winCell)
    (if (== (& (winGetConsoleMode (winHandleOf fd) cell) 4294967295) 0)
      (winErrnoOf (& winGetLastError 4294967295))
      (& (__load64 cell 0) 4294967295))
  })

;; `SetConsoleMode(fd, mode)`: 0, or `-errno`.
(pub :: platformConsoleSetMode (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformConsoleSetMode fd mode)
  {
    (let r (winReaderMode (winHandleOf fd) mode))
    (if (< r 0)
      (winErrnoOf (- 0 r))
      0)
  })

;; The console's window in character cells, `rows * 65536 + cols` from
;; the window rectangle `GetConsoleScreenBufferInfo` reports (four
;; SHORTs at bytes 10 to 17: left, top, right, bottom), or `-errno`.
(pub :: platformConsoleSize (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformConsoleSize fd)
  {
    (let info (__alloc 24))
    (if (== (& (winGetConsoleScreenBufferInfo (winHandleOf fd) info) 4294967295) 0)
      (winErrnoOf (& winGetLastError 4294967295))
      {
        (let left (+ (__load8 info 10) (<< (__load8 info 11) 8)))
        (let top (+ (__load8 info 12) (<< (__load8 info 13) 8)))
        (let right (+ (__load8 info 14) (<< (__load8 info 15) 8)))
        (let bottom (+ (__load8 info 16) (<< (__load8 info 17) 8)))
        (+ (* (+ (- bottom top) 1) 65536) (+ (- right left) 1))
      })
  })
