    (if (!= kind 1)
      (if (== kind 0)
        winLastErr
        -29)
      {
        (let cell winCell)
        (let ovl (winOverlappedAt offset))
        (if (== (& (winReadFile (winHandleOf fd) buf count cell ovl) 4294967295) 0)
          {
            (let code (& winGetLastError 4294967295))
            (if (== code 38)
              0
              (winErrnoOf code))
          }
          (& (__load64 cell 0) 4294967295))
      })
  })

;; pwrite(fd, buf, count, offset): bytes written, or `-errno`.
;; Consoles and pipes answer ESPIPE (29), as they do for `pread`.
;; The platform's own way to write at an offset where raw `pwrite` is
;; not available; -ENOSYS where the raw syscall is used instead.
(pub :: platformPwrite (-> Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformPwrite fd buf count offset)
  {
    (let kind (& (winGetFileType (winHandleOf fd)) 4294967295))
    (if (!= kind 1)
      (if (== kind 0)
        winLastErr
        -29)
      {
        (let cell winCell)
        (let ovl (winOverlappedAt offset))
        (if (== (& (winWriteFile (winHandleOf fd) buf count cell ovl) 4294967295) 0)
          winLastErr
          (& (__load64 cell 0) 4294967295))
      })
  })

;; fsync(fd): 0, or `-errno`. `FlushFileBuffers` writes the file's data
;; and metadata through to the disk.
;; The platform's own way to flush a descriptor where raw `fsync` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformFsync (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformFsync fd)
  (winBoolResult (winFlushFileBuffers (winHandleOf fd))))

;; ftruncate(fd, len): 0, or `-errno`. The end of the file moves to
;; `len` through the file pointer, which is put back where it was, as
;; `ftruncate` leaves it.
;; The platform's own way to cut a file where raw `ftruncate` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformFtruncate (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
