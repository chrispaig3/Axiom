;; directory still holds entries.
;; The platform's own way to remove a directory where raw `rmdir` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformRmdir (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformRmdir path)
  {
