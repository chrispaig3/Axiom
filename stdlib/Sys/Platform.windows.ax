; ------------------------------------------------------------------
; The capability, and the bindings behind it.
; ------------------------------------------------------------------
;; 1 where the platform is reached through raw syscalls, 0 where it
;; goes through the C library or a host shim.
(pub :: usesSyscallAbi Int)
(pub fn (usesSyscallAbi)
  Internal.Platform::impl_usesSyscallAbi)

;; exit(code): `ExitProcess` ends every thread, as `exit_group` does.
;; The platform's own way to end the process where raw `exit` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformExitWith (-> Int Int))
;@axiom:effect(io)
(pub fn (platformExitWith code)
  (Internal.Platform::impl_platformExitWith code))

;; The path of the null device: `NUL` here.
(pub :: platformNullPath String)
;@axiom:effect(pure)
(pub fn (platformNullPath)
  Internal.Platform::impl_platformNullPath)

;; Wait for the child `pid` and close its handle: its POSIX wait
;; status, or `-errno`.
;; The platform's own way to wait for a child where raw `wait4` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformWait (-> Int Int))
;@axiom:effect(io)
(pub fn (platformWait pid)
  (Internal.Platform::impl_platformWait pid))

;; Send `sig` to the child `pid`: 0, or `-errno`, ESRCH when it has
;; already ended. Windows has no signals, so any `sig` but 0 ends the
;; child with exit code 128 + `sig`, what a shell reports for a child
;; the signal killed. `sig` 0 only asks whether it is still running.
;; The platform's own way to signal a child where raw `kill` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformKill (-> Int Int Int))
;@axiom:effect(io)
(pub fn (platformKill pid sig)
  (Internal.Platform::impl_platformKill pid sig))

;; Whether the child `pid` has ended, without closing its handle: 1 if
;; it has, 0 if it is running, or `-errno`.
;; The platform's own way to poll a child where raw `waitid` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformChildExited (-> Int Int))
;@axiom:effect(io)
(pub fn (platformChildExited pid)
  (Internal.Platform::impl_platformChildExited pid))

;; This process's id.
;; The platform's own way to read the process id where raw `getpid` is
;; not available; -ENOSYS where the raw syscall is used instead.
(pub :: platformPid Int)
;@axiom:effect(io)
(pub fn (platformPid)
  Internal.Platform::impl_platformPid)

;; The byte that separates the entries of `PATH`: `;` here, `:` on the
;; POSIX targets.
(pub :: pathListSep Int)
(pub fn (pathListSep)
  Internal.Platform::impl_pathListSep)

;; 1 where a backslash separates path components and `C:` starts an
;; absolute path, as here, so `Sys.sysRunPath` reads either as a path
;; rather than a name to search for. 0 where only `/` does.
(pub :: pathBackslashSeparates Int)
(pub fn (pathBackslashSeparates)
  Internal.Platform::impl_pathBackslashSeparates)

;; 1 where a program named without an extension is found as
;; `NAME.exe`, as `CreateProcessW` finds it; 0 where a program is found
;; under its own name.
(pub :: exeSuffixTried Int)
(pub fn (exeSuffixTried)
  Internal.Platform::impl_exeSuffixTried)

; ------------------------------------------------------------------
; The clock id `Sys.ax` hands to clock_gettime. Windows has no
; clock_gettime and no syscall table; `Sys.ax` asks `usesSyscallAbi`
; before it reaches the `__syscall3` that would take this id, so the
; value is never read on this target. It is declared because every
; platform module declares one public surface (`check-stdlib-api.sh`),
; and 0 is the answer that would be wrong loudest if it ever were read.
; ------------------------------------------------------------------
;; The id `clock_gettime` takes for the monotonic clock: 0, unused on
;; this target, which has no `clock_gettime`.
(pub :: clockMonotonicId Int)
(pub fn (clockMonotonicId)
  Internal.Platform::impl_clockMonotonicId)

;; Whether `Sys.ax` reads the arm64 counter for its monotonic clock,
;; which it does only where `clock_gettime` has none. 0 here.
(pub :: clockHasCounter Int)
(pub fn (clockHasCounter)
  Internal.Platform::impl_clockHasCounter)

; --------------------------------------------------------------------
; Terminals - UNIMPLEMENTED HERE, AND THAT IS THE ANSWER, NOT A GAP
; SOMEBODY FORGOT.
;
; Windows has no `termios` and no `ioctl`. Its terminal control is a
; different mechanism end to end, not different numbers for the same
; one:
;
;   * the object is a console HANDLE, not a file descriptor, and there
;     is no request-number encoding to get wrong because there are no
;     requests - `GetConsoleMode(h, &mode)` and `SetConsoleMode(h,
;     mode)` take a single DWORD of flags;
;   * that DWORD's bits (ENABLE_ECHO_INPUT, ENABLE_LINE_INPUT,
;     ENABLE_PROCESSED_INPUT, ENABLE_VIRTUAL_TERMINAL_INPUT) are not
;     `termios` bits under other names - line and echo are one input
;     handle's mode, where POSIX splits them across c_lflag and
;     c_iflag, and there is no VMIN/VTIME at all;
;   * "is this a terminal" is `GetFileType(h) == FILE_TYPE_CHAR` or a
;     `GetConsoleMode` that succeeds, not an `ioctl` that answers
;     ENOTTY;
;   * the size is `GetConsoleScreenBufferInfo`, whose `srWindow`
;     rectangle gives rows and columns as a difference of coordinates
;     rather than as a `struct winsize`.
;
; So this module answers `ttyUsesTermios` 0 and `Sys.ax` takes the
; branch that reports "not supported on this target" - the same shape
; as `clockHasMonotonic` on Darwin, where the honest -ENOSYS was
; preferred to substituting a clock that could run backwards.
;
; WHY NOT BIND THE FOUR FUNCTIONS NOW, since this module already binds
; kernel32 and the constants are documented rather than derived. Two
; reasons, and the second is the real one. Sockets and the console's
; control events are still a later phase here, so a console layer would
; be one more floor in a module whose header calls itself unfinished. And nothing in
; this tree can RUN it: `check-cross-targets.sh` assembles Windows
; objects on this host but executes none, so a binding written today
; would be exactly the plausible-looking unverified code this section's
; POSIX counterparts spend their comments avoiding. The mechanism is
; written down above so that whoever has a Windows box does not have to
; rediscover it.
;
; The eighteen names below are 0 for the reason `clockMonotonicId` is:
; every platform module declares one public surface
; (`check-stdlib-api.sh`), and `ttyUsesTermios` 0 keeps every one of
; them unread.
; --------------------------------------------------------------------
;; Whether this platform's terminal control is the POSIX `termios`
;; trio - read the attributes, edit them, write them back - reached
;; through `ioctl`. Windows answers 0: its mechanism is
;; `GetConsoleMode`/`SetConsoleMode` against a HANDLE, which shares no
;; part of this shape.
(pub :: ttyUsesTermios Int)
(pub fn (ttyUsesTermios)
  Internal.Platform::impl_ttyUsesTermios)

;; ioctl(fd, request, arg): 0 and unused. The console goes through
;; `GetConsoleMode` instead (see `ttyUsesTermios`).
(pub :: sysIoctlNum Int)
(pub fn (sysIoctlNum)
  Internal.Platform::impl_sysIoctlNum)

;; TIOCGETA - read the terminal attributes into a `struct termios`.
(pub :: tcGetAttrReq Int)
(pub fn (tcGetAttrReq)
  Internal.Platform::impl_tcGetAttrReq)

;; TIOCSETAF - write the attributes back, after draining pending output
;; and DISCARDING pending input.
(pub :: tcSetAttrReq Int)
(pub fn (tcSetAttrReq)
  Internal.Platform::impl_tcSetAttrReq)

;; TIOCGWINSZ - read `struct winsize`.
(pub :: tcWinSizeReq Int)
(pub fn (tcWinSizeReq)
  Internal.Platform::impl_tcWinSizeReq)

;; 0 rather than a plausible size. `Sys.ax` allocates this many bytes
;; for a saved terminal state, and a caller that reached here would get
;; a zero-length buffer and the "unsupported" answer, not a short one it
;; could half-fill.
(pub :: termiosBytes Int)
(pub fn (termiosBytes)
  Internal.Platform::impl_termiosBytes)

;; The width of one flag word, which is also the STRIDE of the four of
;; them: `c_iflag` at 0, `c_oflag` at 8, `c_cflag` at 16, `c_lflag` at
;; 24, on the POSIX targets. The four offsets are `n * termiosFlagBytes` on every
;; platform this library targets, so `Sys.ax` carries one multiplication
;; rather than four constants per module.
(pub :: termiosFlagBytes Int)
(pub fn (termiosFlagBytes)
  Internal.Platform::impl_termiosFlagBytes)

;; Where the control-character array `c_cc` begins: 0 here, unused.
(pub :: termiosCcOff Int)
(pub fn (termiosCcOff)
  Internal.Platform::impl_termiosCcOff)

;; The two `c_cc` slots that mean something once ICANON is off: how many
;; bytes a `read` must collect before it returns, and how long it waits
;; in tenths of a second. 0 here, unused.
(pub :: termiosVminIdx Int)
(pub fn (termiosVminIdx)
  Internal.Platform::impl_termiosVminIdx)

;; The index of `VTIME` in the termios control-character array.
(pub :: termiosVtimeIdx Int)
(pub fn (termiosVtimeIdx)
  Internal.Platform::impl_termiosVtimeIdx)

;; The `ECHO` local-mode flag: 0 here, unused, like every termios bit
;; below.
(pub :: tiosEcho Int)
(pub fn (tiosEcho)
  Internal.Platform::impl_tiosEcho)

;; The `ICANON` local-mode flag: line editing by the terminal.
(pub :: tiosIcanon Int)
(pub fn (tiosIcanon)
  Internal.Platform::impl_tiosIcanon)

;; The `ISIG` local-mode flag: the terminal turns Ctrl-C into a signal.
(pub :: tiosIsig Int)
(pub fn (tiosIsig)
  Internal.Platform::impl_tiosIsig)

;; The `IEXTEN` local-mode flag: extended input processing.
(pub :: tiosIexten Int)
(pub fn (tiosIexten)
  Internal.Platform::impl_tiosIexten)

;; The `BRKINT` input flag: a break raises an interrupt.
(pub :: tiosBrkint Int)
(pub fn (tiosBrkint)
  Internal.Platform::impl_tiosBrkint)

;; The `ICRNL` input flag: carriage return becomes newline.
(pub :: tiosIcrnl Int)
(pub fn (tiosIcrnl)
  Internal.Platform::impl_tiosIcrnl)

;; The `ISTRIP` input flag: strip the eighth bit.
(pub :: tiosIstrip Int)
(pub fn (tiosIstrip)
  Internal.Platform::impl_tiosIstrip)

;; The `IXON` input flag: Ctrl-S and Ctrl-Q flow control.
(pub :: tiosIxon Int)
(pub fn (tiosIxon)
  Internal.Platform::impl_tiosIxon)

