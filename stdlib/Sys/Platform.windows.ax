          {
            (let code (& winGetLastError 4294967295))
            (if (== code 33)
              (- 0 eAgain)
              (winErrnoOf code))
          }
          0)
      })
  })

;; The path of the null device: `NUL` here.
(pub :: platformNullPath String)
;@axiom:effect(pure)
(pub fn (platformNullPath)
  "NUL")

;; unlink(path): 0, or `-errno`.
;; The platform's own way to remove a file where raw `unlink` is not
