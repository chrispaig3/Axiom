  (winGetSockOpt :: (-> Int Int Int Int Int Int) (symbol "getsockopt"))
  (winIoctlSocket :: (-> Int Int Int Int) (symbol "ioctlsocket"))
  (winGetSockName :: (-> Int Int Int Int) (symbol "getsockname"))
  (winGetPeerName :: (-> Int Int Int Int) (symbol "getpeername"))
  (winCloseSocket :: (-> Int Int) (symbol "closesocket"))
