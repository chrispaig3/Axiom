    ; A socket goes through `closesocket`, which frees Winsock's own
    ; state for it; anything else through `CloseHandle`.
    (if (winIsSocket h)
      (if (wsaFailed (winCloseSocket h))
        wsaLastErr
        0)
      {
        (let r (winReaderClose h))
        (if (< r 0)
          (winErrnoOf (- 0 r))
          0)
      })
  })

;; lseek(fd, offset, whence): the new absolute offset, or `-errno`. FILE_BEGIN, FILE_CURRENT and FILE_END are 0, 1
;; and 2, as SEEK_SET, SEEK_CUR and SEEK_END are.
;; The platform's own way to move a descriptor's offset where raw
;; `lseek` is not available; -ENOSYS where the raw syscall is used
;; instead.
(pub :: platformSeek (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformSeek fd offset whence)
  {
    (let cell winCell)
    (if (== (& (winSetFilePointerEx (winHandleOf fd) offset cell whence) 4294967295) 0)
      winLastErr
      (__load64 cell 0))
  })

; An OVERLAPPED record carrying `offset` and no event: 32 bytes,
; Internal and InternalHigh clear, Offset and OffsetHigh as one
; little-endian word at byte 16, hEvent 0. `ReadFile`, `WriteFile` and
; the lock calls take the position from it on a synchronous handle.
(:: winOverlappedAt (-> Int Int))
;@axiom:effect(unsafe)
(fn (winOverlappedAt offset)
  {
    (let ovl (__alloc 32))
    {
      (__store64 ovl 0 0)
      (__store64 ovl 1 0)
      (__store64 ovl 2 offset)
      (__store64 ovl 3 0)
      ovl
    }
  })

