    (if (== wide 0)
      (- 0 22)
      (winBoolResult (winRemoveDirectoryW wide)))
  })

; Rewrite the FILE_FULL_DIR_INFO records at `src` as the records
; `IO.ioReadDirDecode` reads at `dst`, from byte `k`, answering the
; bytes written. A source record holds NextEntryOffset (u32) at 0,
; FileNameLength in bytes (u32) at 60, and the UTF-16 name at 68; the
; last one's NextEntryOffset is 0. Each output record carries its
; length (u16) at 16 and its NUL-terminated UTF-8 name at 19, rounded
; up to 8 bytes as `getdents64` rounds them.
(:: winDirRecords (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (winDirRecords src dst k)
  {
    (let next (winGet32 src 0))
    (let units (/ (winGet32 src 60) 2))
    (let rec (+ dst k))
    (let end (winUtf8From (+ src 68) 0 units (+ rec 19) 0))
    (let reclen (* (/ (+ (+ 19 end) 8) 8) 8))
    (__store8 rec (+ 19 end) 0)
    (__store8 rec 16 (& reclen 255))
    (__store8 rec 17 (/ reclen 256))
    (if (== next 0)
      (+ k reclen)
      (winDirRecords (+ src next) dst (+ k reclen)))
  })

;; Read the next entries of the directory open as `fd` into the `count`
;; bytes at `buf`: the bytes written, 0 once the listing is
;; done, or `-errno`. The records have the layout Linux's
;; `getdents64` gives, which is the one `IO.ax` reads.
;; The platform's own way to read a directory where raw `getdents` is
;; not available; -ENOSYS where the raw syscall is used instead.
(pub :: platformReadDir (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformReadDir fd buf count)
  {
    ; A source record is at least 68 bytes plus two per unit; its
    ; rewrite is at most 27 plus three per unit. Asking for half of
    ; `count` keeps every rewrite inside `buf`.
    (let want (/ count 2))
    (let src (__alloc want))
    ; FileFullDirectoryInfo, class 14.
    (if (== (& (winGetFileInformationByHandleEx (winHandleOf fd) 14 src want) 4294967295) 0)
      {
        (let code (& winGetLastError 4294967295))
        ; ERROR_NO_MORE_FILES
        (if (== code 18)
          0
          (winErrnoOf code))
      }
      (winDirRecords src buf 0))
  })

;; The working directory as NUL-terminated UTF-8 in the `count` bytes
;; at `buf`: its length, or `-errno`; ERANGE when
;; it doesn't fit.
;; The platform's own way to read the working directory where raw
;; `getcwd` is not available; -ENOSYS where the raw syscall is used
;; instead.
(pub :: platformGetCwd (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformGetCwd buf count)
  {
    (let units 32768)
    (let wide (__alloc (* units 2)))
    (let n (& (winGetCurrentDirectoryW units wide) 4294967295))
    (if (== n 0)
        winLastErr
      (|| (> n units) (> (* n 3) (- count 1)))
        (- 0 34)
      {
        (let len (winUtf8From wide 0 n buf 0))
        (__store8 buf len 0)
        len
      })
  })

; ------------------------------------------------------------------
; Child processes.
;
; A "pid" on this target is the child's process HANDLE: what
; `platformSpawn` answers, and what `platformWait`, `platformKill` and
; `platformChildExited` take. `platformWait` closes it, as a POSIX wait
; reaps, so the value names its child until the wait and nothing after.
; `platformPid` answers this process's real id, which callers only use
; to keep two processes' scratch names apart.
;
; `argv` and `envp` arrive in POSIX form, NULL-terminated vectors of
; NUL-terminated UTF-8. `argv` becomes one command line quoted by the
; Microsoft rules, the inverse of the parser the entry shim runs
; (`emitWinEntry`), and `envp` becomes a UTF-16 environment block. An
; `envp` of 0 passes this process's environment, because a Windows
; program started with none usually fails for want of `SystemRoot`.
;
; The application name is always passed. `CreateProcessW` given only a
; command line searches the working directory first, which is the hole
; `Sys.sysRunPath` closes, so the search is that function's alone.
;
; The child gets this process's three standard handles, as a POSIX
; child inherits descriptors 0 to 2, and `platformSetStd` swaps one for
; the length of a spawn, as `Sys.sysRunPathErrTo` swaps descriptor 2.
; A strict HANDLE_LIST contains only those valid standard handles, so
; concurrent worker transports cannot cross into an unrelated child.
;
; Not yet: `.bat` and `.cmd` files, which run under `cmd.exe` with its
; own quoting rules.
; ------------------------------------------------------------------
;; Start `path` with `argv` and `envp`: the child's process handle, or
;; `-errno`. ENOENT when there is no such file, ENOEXEC when it is not a
;; Windows program.
;; The platform's own way to start a child where raw `posix_spawn` or
;; `fork` and `execve` are not available; -ENOSYS where the raw
;; syscalls are used instead.
(pub :: platformSpawn (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformSpawn path argv envp)
  {
    (let startup windowsStartupNew)
    (let state (windowsStartupPrepare startup path argv envp 0 0 0))
    (let result
      (if (< state 0)
        state
        {
          (let pi (__load64 state 10))
          ; HANDLE_LIST restricts inheritance to the valid standard streams.
          ; With no standards, bInheritHandles is FALSE and no list is needed.
          (if (==
                (&
                  (winCreateProcessW (__load64 state 0) (__load64 state 4) 0 0 (__load64 state 34)
                    (__load64 state 33) (__load64 state 35) 0 (__load64 state 8) pi)
                  4294967295)
                0)
            winLastErr
            {
              (let pid (__load64 pi 0))
              (winCloseHandle (__load64 pi 1))
              pid
            })
        }))
    (windowsStartupClose startup)
    result
  })

; The signal a POSIX shell would report for a child that ended with
; the NTSTATUS `code`, or 0 when `code` is not one of the crash
; statuses below: SIGSEGV (11) for an access violation or a stack
; overflow, SIGFPE (8) for the arithmetic faults, SIGILL (4) for an
; illegal or privileged instruction, SIGTRAP (5) for a breakpoint
; (`int3`, which LLVM places after a call that must not return), SIGINT
; (2) for Ctrl-C, and SIGABRT (6) for `__fastfail`.
(:: winSignalOf (-> Int Int))
(fn (winSignalOf code)
  (if (|| (== code 3221225477) (== code 3221225725))
      11
    (|| (&& (>= code 3221225612) (<= code 3221225621)) (== code 3221225620))
      8
    (|| (== code 3221225501) (== code 3221225622))
      4
    (|| (== code 2147483651) (== code 2147483652))
      5
    (== code 3221225786)
      2
    (== code 3221226505)
      6
    0))

; An exit code as the POSIX wait status `Sys.sysExitCode` and
; `Sys.sysTermSignal` read. A crash status (`winSignalOf`) reads as
; the signal it stands for; anything else is an exit code, of which a
; wait status keeps the low byte, so a program that exits -1 reads as
; 255, as it does on POSIX.
(:: winWaitStatus (-> Int Int))
(fn (winWaitStatus code)
  {
    (let sig (winSignalOf code))
    (if (> sig 0)
      sig
      (* (& code 255) 256))
  })

;; Wait for the child `pid` and close its handle: its POSIX wait
;; status, or `-errno`.
;; The platform's own way to wait for a child where raw `wait4` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformWait (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformWait pid)
  ; INFINITE; WAIT_OBJECT_0 is 0.
  (if (!= (& (winWaitForSingleObject pid 4294967295) 4294967295) 0)
    winLastErr
    {
      (let cell (__alloc 8))
      (__retain cell)
      (let result
        (if (== (& (winGetExitCodeProcess pid cell) 4294967295) 0)
          {
            (let error winLastErr)
            (winCloseHandle pid)
            error
          }
          {
            (let code (& (__load64 cell 0) 4294967295))
            (winCloseHandle pid)
            (winWaitStatus code)
          }))
      (__release cell)
      result
    }))

;; Send `sig` to the child `pid`: 0, or `-errno`, ESRCH when it has
;; already ended. Windows has no signals, so any `sig` but 0 ends the
;; child with exit code 128 + `sig`, what a shell reports for a child
;; the signal killed. `sig` 0 only asks whether it is still running.
;; The platform's own way to signal a child where raw `kill` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformKill (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformKill pid sig)
  (if (== sig 0)
    {
      ; WAIT_TIMEOUT (258) means it is still running.
      (let r (& (winWaitForSingleObject pid 0) 4294967295))
      (if (== r 258)
          0
        (== r 0)
          (- 0 3)
        winLastErr)
    }
    (if (== (& (winTerminateProcess pid (+ 128 sig)) 4294967295) 0)
      {
        ; A child that is already ending refuses with
        ; ERROR_ACCESS_DENIED.
        (let e winLastErr)
        (if (== e (- 0 13))
          (- 0 3)
          e)
      }
      0)))

;; Whether the child `pid` has ended, without closing its handle: 1 if
;; it has, 0 if it is running, or `-errno`.
;; The platform's own way to poll a child where raw `waitid` is not
;; available; -ENOSYS where the raw syscall is used instead.
(pub :: platformChildExited (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformChildExited pid)
  {
    (let r (& (winWaitForSingleObject pid 0) 4294967295))
    (if (== r 0)
        1
      (== r 258)
        0
      winLastErr)
  })

;; This process's id.
;; The platform's own way to read the process id where raw `getpid` is
;; not available; -ENOSYS where the raw syscall is used instead.
(pub :: platformPid Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformPid)
  (& winGetCurrentProcessId 4294967295))

;; Make the handle `h` this process's standard handle `n` (0, 1 or 2),
;; answering the one it replaces, or `-errno`. A spawn in between hands
;; the child `h`; passing the answer back restores the original.
;; The platform's own way to swap a standard descriptor where raw
;; `dup2` is not available; -ENOSYS where the raw syscall is used
;; instead.
(pub :: platformSetStd (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformSetStd n h)
  {
    (let old (winGetStdHandle (- (- 0 10) n)))
    (if (== (& (winSetStdHandle (- (- 0 10) n) h) 4294967295) 0)
      winLastErr
      old)
  })

;; The byte that separates the entries of `PATH`: `;` here, `:` on the
;; POSIX targets.
(pub :: pathListSep Int)
(pub fn (pathListSep)
  59)

;; 1 where a backslash separates path components and `C:` starts an
;; absolute path, as here, so `Sys.sysRunPath` reads either as a path
;; rather than a name to search for. 0 where only `/` does.
(pub :: pathBackslashSeparates Int)
(pub fn (pathBackslashSeparates)
  1)

;; 1 where a program named without an extension is found as
;; `NAME.exe`, as `CreateProcessW` finds it; 0 where a program is found
;; under its own name.
(pub :: exeSuffixTried Int)
(pub fn (exeSuffixTried)
  1)

; ------------------------------------------------------------------
; The clock id `Sys.ax` hands to clock_gettime. Windows has no
; clock_gettime and no syscall table; `Sys.ax` asks `usesSyscallAbi`
; before it reaches the `__syscall3` that would take this id, so the
; value is never read on this target. It is declared because every
; platform module declares one public surface (`check-stdlib-api.sh`),
; and 0 is the answer that would be wrong loudest if it ever were read.
; ------------------------------------------------------------------
;; The id `clock_gettime` takes for the monotonic clock: 0, unused on
;; this target, which has no `clock_gettime`.
(pub :: clockMonotonicId Int)
(pub fn (clockMonotonicId)
  0)

;; Whether `Sys.ax` reads the arm64 counter for its monotonic clock,
;; which it does only where `clock_gettime` has none. 0 here.
(pub :: clockHasCounter Int)
(pub fn (clockHasCounter)
  0)

; --------------------------------------------------------------------
; Terminals - UNIMPLEMENTED HERE, AND THAT IS THE ANSWER, NOT A GAP
; SOMEBODY FORGOT.
;
; Windows has no `termios` and no `ioctl`. Its terminal control is a
; different mechanism end to end, not different numbers for the same
; one:
;
;   * the object is a console HANDLE, not a file descriptor, and there
;     is no request-number encoding to get wrong because there are no
;     requests - `GetConsoleMode(h, &mode)` and `SetConsoleMode(h,
;     mode)` take a single DWORD of flags;
;   * that DWORD's bits (ENABLE_ECHO_INPUT, ENABLE_LINE_INPUT,
;     ENABLE_PROCESSED_INPUT, ENABLE_VIRTUAL_TERMINAL_INPUT) are not
;     `termios` bits under other names - line and echo are one input
;     handle's mode, where POSIX splits them across c_lflag and
;     c_iflag, and there is no VMIN/VTIME at all;
;   * "is this a terminal" is `GetFileType(h) == FILE_TYPE_CHAR` or a
;     `GetConsoleMode` that succeeds, not an `ioctl` that answers
;     ENOTTY;
;   * the size is `GetConsoleScreenBufferInfo`, whose `srWindow`
;     rectangle gives rows and columns as a difference of coordinates
;     rather than as a `struct winsize`.
;
; So this module answers `ttyUsesTermios` 0 and `Sys.ax` takes the
; branch that reports "not supported on this target" - the same shape
; as `clockHasMonotonic` on Darwin, where the honest -ENOSYS was
; preferred to substituting a clock that could run backwards.
;
; WHY NOT BIND THE FOUR FUNCTIONS NOW, since this module already binds
; kernel32 and the constants are documented rather than derived. Two
; reasons, and the second is the real one. Sockets and the console's
; control events are still a later phase here, so a console layer would
; be one more floor in a module whose header calls itself unfinished. And nothing in
; this tree can RUN it: `check-cross-targets.sh` assembles Windows
; objects on this host but executes none, so a binding written today
; would be exactly the plausible-looking unverified code this section's
; POSIX counterparts spend their comments avoiding. The mechanism is
; written down above so that whoever has a Windows box does not have to
; rediscover it.
;
; The eighteen names below are 0 for the reason `clockMonotonicId` is:
; every platform module declares one public surface
; (`check-stdlib-api.sh`), and `ttyUsesTermios` 0 keeps every one of
; them unread.
; --------------------------------------------------------------------
;; Whether this platform's terminal control is the POSIX `termios`
;; trio - read the attributes, edit them, write them back - reached
;; through `ioctl`. Windows answers 0: its mechanism is
;; `GetConsoleMode`/`SetConsoleMode` against a HANDLE, which shares no
;; part of this shape.
(pub :: ttyUsesTermios Int)
(pub fn (ttyUsesTermios)
  0)

;; ioctl(fd, request, arg): 0 and unused. The console goes through
;; `GetConsoleMode` instead (see `ttyUsesTermios`).
(pub :: sysIoctlNum Int)
(pub fn (sysIoctlNum)
  0)

;; TIOCGETA - read the terminal attributes into a `struct termios`.
(pub :: tcGetAttrReq Int)
(pub fn (tcGetAttrReq)
  0)

;; TIOCSETAF - write the attributes back, after draining pending output
;; and DISCARDING pending input.
(pub :: tcSetAttrReq Int)
(pub fn (tcSetAttrReq)
  0)

;; TIOCGWINSZ - read `struct winsize`.
(pub :: tcWinSizeReq Int)
(pub fn (tcWinSizeReq)
  0)

;; 0 rather than a plausible size. `Sys.ax` allocates this many bytes
;; for a saved terminal state, and a caller that reached here would get
;; a zero-length buffer and the "unsupported" answer, not a short one it
;; could half-fill.
(pub :: termiosBytes Int)
(pub fn (termiosBytes)
  0)

;; The width of one flag word, which is also the STRIDE of the four of
;; them: `c_iflag` at 0, `c_oflag` at 8, `c_cflag` at 16, `c_lflag` at
