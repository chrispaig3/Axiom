; ------------------------------------------------------------------
; Waiting on a word, memory, and the signal mask.
;
; `WaitOnAddress` is the futex: it sleeps while the word at an address
; still holds the value the caller saw, and `WakeByAddressAll` wakes
; every such sleeper. It is exported by the API set
; api-ms-win-core-synch-l1-2-0.dll, which `synchronization.lib` names,
; so that is the `extern` block's library. Only threads of one process
; can meet on a word here, which is all the thread lowering needs; the
; process lowering has no `fork` on this target.
;
; Memory is `VirtualAlloc` and `VirtualFree`; a "shared" mapping is a
; private one, since every binding that could share it is a thread of
; this process. `VirtualLock` pins pages against paging, as `mlock`
; does, which is what the secret store asks for.
;
; There is no signal mask: Windows delivers Ctrl-C to a handler routine,
; not as a signal, so blocking answers `Ok 0` and the console handler is
; its own binding.
; ------------------------------------------------------------------
;; Block until the word at `addr` differs from `expected`, for at most
;; `nanos` nanoseconds (negative: no limit): 0 woken or spurious, 1 timed
;; out, 2 the word already differed. The caller compares the word again
;; either way, as `WaitOnAddress` may return early.
(pub :: platformWaitWord (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformWaitWord addr expected nanos)
  (if (!= (__load64 addr 0) expected)
    2
    {
      (let cell winCell)
      (__store64 cell 0 expected)
      (let ms
        (if (< nanos 0)
          4294967295
          (if (> nanos 4294967294000000)
            4294967294
            (/ (+ nanos 999999) 1000000))))
      (if (!= (& (winWaitOnAddress addr cell 8 ms) 4294967295) 0)
        0
        (if (== (& winGetLastError 4294967295) 1460)
          1
          0))
    }))

