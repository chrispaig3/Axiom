; ------------------------------------------------------------------
; The clock, sleep and entropy, over kernel32 and bcryptprimitives.
;
; The performance counter is the monotonic clock: it never goes
; backwards, its frequency is fixed at boot, and both calls always
; succeed on every supported Windows. Ticks become nanoseconds by
; splitting the division, so a counter that has run for years still
; converts without overflowing a word. The wall clock is
; `GetSystemTimePreciseAsFileTime`, 100-nanosecond ticks since 1601,
; moved to the Unix epoch by the 11,644,473,600 seconds between them.
; `Sleep` takes milliseconds, so a nanosecond request rounds up and
; the caller's deadline loop reads the clock again. Entropy is
; `ProcessPrng`, the user-mode generator the kernel seeds, which the
; Go and Rust runtimes also draw from; it is documented to always
; succeed.
; ------------------------------------------------------------------
;; Whether `Sys.ax` reads this platform's clocks through
;; `platformMonotonicNanos` and `platformRealtimeNanos`: 1 here.
(pub :: platformHasClock Int)
;@axiom:effect(pure)
(pub fn (platformHasClock)
  Internal.Platform::impl_platformHasClock)

;; The performance counter in nanoseconds: `Ok` nanoseconds since boot,
;; never decreasing, or `Err` carrying the errno `winErrnoOf` maps the
;; last error to.
;; The platform's own monotonic clock in nanoseconds, where raw
;; `clock_gettime` is not available; `Err` 78 where the syscall serves.
(pub :: platformMonotonicNanos (Result Int Error))
;@axiom:effect(io)
(pub fn (platformMonotonicNanos)
  Internal.Platform::impl_platformMonotonicNanos)

;; The wall clock in nanoseconds since 1970-01-01 UTC, from
;; `GetSystemTimePreciseAsFileTime`.
;; The platform's own wall clock in nanoseconds since the Unix epoch,
;; where raw `clock_gettime` is not available; `Err` 78 where the
;; syscall serves.
(pub :: platformRealtimeNanos (Result Int Error))
;@axiom:effect(io)
(pub fn (platformRealtimeNanos)
  Internal.Platform::impl_platformRealtimeNanos)

;; Sleep for at least `nanos` nanoseconds, rounded up to the
;; millisecond `Sleep` takes. Answers `Ok 0`.
;; The platform's own sleep for at least `nanos` nanoseconds, where the
;; raw wait is not available; `Err` 78 where the syscall serves.
(pub :: platformSleepNanos (-> Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (platformSleepNanos nanos)
  (Internal.Platform::impl_platformSleepNanos nanos))

;; Whether entropy uses a separate platform source: 1 here.
(pub :: platformHasEntropy Int)
;@axiom:effect(pure)
(pub fn (platformHasEntropy)
  Internal.Platform::impl_platformHasEntropy)

;; Capture Ctrl-C (`sigInt`) and Ctrl-Break (`sigBreak`) for the poller.
;; The mask is process-wide and remains blocked after a poller closes.
;; Unsupported bits answer `Err` 78 before changing the mask. A zero
;; mask does nothing. Console close, logoff and shutdown keep their
;; system termination behaviour.
(pub :: platformSignalBlock (-> Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (platformSignalBlock mask)
  (Internal.Platform::impl_platformSignalBlock mask))
