;;! Sys.Platform - the numbers this target's kernel uses: syscall
;;! numbers, open and socket flags, errno values, poll and signal
;;! constants and struct layouts. One file per target; every file
;;! declares the same names, and the build picks the one for the
;;! target being compiled for (this one is `windows`).
; Sys.Platform - Windows, as kernel32 bindings rather than syscall numbers.
;
; Selected by the `.windows.ax` filename suffix when compiling for
; `--target=windows-x86_64` or `--target=windows-aarch64` (the
; arch-specific `.windows-x86_64.ax` and `.windows-aarch64.ax` are
; tried first and do not exist: the bindings below are the same on
; every Windows architecture, which is the reason `Platform.darwin.ax`
; serves both Darwin targets).
;
; THIS IS THE OTHER KIND OF PLATFORM MODULE. The three POSIX modules are
; tables of integers - syscall numbers and flags - and `Sys.ax` makes
; every kernel call itself through `__syscallN`. Windows has no syscall
; ABI a program may use: the numbers are private to each build of the
; kernel and Microsoft documents none of them. So this module answers
; `usesSyscallAbi` 0 and DOES THE WORK ITSELF, over an `extern
; "kernel32"` block, in functions `Sys.ax` calls where it would
; otherwise have called `__syscallN`. `Sys.ax`'s header records that
; this is the one exception to "the platform module is a table", and
; why.
;
; WHAT IS BOUND TODAY: the console (`WriteFile`, `ReadFile`,
; `GetStdHandle`, `ExitProcess`, `GetLastError`), files and directories
; (the `platformOpen` group), child processes (the `platformSpawn`
; group), the clocks and sleep (`platformMonotonicNanos`,
; `platformRealtimeNanos`, `platformSleepNanos`), entropy
; (`platformRandomBytes`), waiting on a word (`platformWaitWord`,
; `platformWakeWord`), memory (`platformMapPrivate` and its group), the
; signal mask, which captures Ctrl-C and Ctrl-Break
; (`platformSignalBlock`), and
; TCP sockets with their readiness (the `platformSocket` group and
; `platformPoll`, over ws2_32), and the console's modes and size
; (`platformConsoleMode` and its group). Captured controls reach the
; poller through the runtime's process-owned atomic queue. Unsupported
; signal masks answer Err 78; close, logoff and shutdown retain their
; system termination behaviour.
;
; THE NAMES BELOW EXIST because `Sys.ax` names every one of them
; and is checked against whichever platform module resolves. Every
; syscall NUMBER is 0 and is never handed to a kernel - `usesSyscallAbi`
; keeps the arms that would pass it unreached. Flags and errno values
; keep their Linux spellings on purpose: `eExist`, `eIsDir`, `eAgain`
; are what `IO.ax` and `Sys.ax` compare a failure against, so the
; error-mapping shim (`winErrnoOf`) answers in those terms and the
; comparisons above it stay portable.
;
; THE WORD-WIDTH RULE, which every shim here obeys and which
; `docs/ffi.md` states for externs in general: every binding is `i64`
; in and `i64` out. A Win32 function returning BOOL or DWORD writes
; only eax (w0 on arm64) and leaves the upper half of rax (x0)
; UNDEFINED, so a 32-bit result is masked (`(& r 4294967295)`) before
; it is tested; a
; function returning a HANDLE or a pointer answers a full 64-bit
; value and is NOT masked - masking one would turn INVALID_HANDLE_VALUE
; (-1) into 4294967295, which compares unequal to -1 and reads as
; success. Which is which is written beside each binding.
;
; DESCRIPTORS. `Sys.ax` speaks in file descriptors; Windows in
; HANDLEs. Descriptors 0, 1 and 2 map to `GetStdHandle(-10 / -11 /
; -12)`; any other value is taken to BE a HANDLE. That is sound
; because a Windows HANDLE is a multiple of 4, so 1 and 2 can never be
; one, and 0 is the null handle, which no successful open answers.
;
; NOTE ON EFFECTS. The shims here perform I/O and say so; the POSIX
; modules carry the same three names as pure stubs behind
; `usesSyscallAbi` 1, which is what keeps the four modules declaring
; one set of public names (`check-stdlib-api.sh` requires it).
; `Err` for the `(Result Int Error)` the two descriptor calls answer;
; acyclic, as the four syscall-ABI files record.
(import Err)
(import Internal.WindowsProcessEncoding)
(import Internal.WindowsStartup)

;; read(fd, buf, count): 0 and unused, like every syscall number in this
;; file. `platformReadFd` reads instead.
(pub :: sysReadNum Int)
(pub fn (sysReadNum)
  0)

;; write(fd, buf, count): 0 and unused. `platformWriteFd` writes instead.
(pub :: sysWriteNum Int)
(pub fn (sysWriteNum)
  0)

;; open(path, flags, mode): 0 and unused. Files go through kernel32.
(pub :: sysOpenNum Int)
(pub fn (sysOpenNum)
  0)

;; close(fd): 0 and unused. Files go through kernel32.
(pub :: sysCloseNum Int)
(pub fn (sysCloseNum)
  0)

;; exit(status): 0 and unused. `platformExitWith` ends the process instead.
(pub :: sysExitNum Int)
(pub fn (sysExitNum)
  0)

;; lseek(fd, offset, whence): 0 and unused. Files go through kernel32.
(pub :: sysLseekNum Int)
(pub fn (sysLseekNum)
  0)

;; 0, so `Sys.ax` takes the plain `open` form rather than `openat`.
;; `Sys.ax` branches on this rather than on an OS name, so adding a
;; platform never means editing portable code.
(pub :: openNeedsDirFd Int)
(pub fn (openNeedsDirFd)
  0)

;; Unused here (see `openNeedsDirFd`), but defined so that
;; `Sys.ax` type-checks against every platform module.
(pub :: atFdCwd Int)
(pub fn (atFdCwd)
  0)

;; The `O_RDONLY` flag for `open` on this platform: read only.
(pub :: oRdonly Int)
(pub fn (oRdonly)
  0)

;; O_WRONLY | O_CREAT | O_TRUNC in Linux's spelling: 0x0001 | 0x0040 |
;; 0x0200.
(pub :: oWronlyCreateTrunc Int)
(pub fn (oWronlyCreateTrunc)
  577)

;; O_WRONLY | O_CREAT | O_APPEND in Linux's spelling: 0x0001 | 0x0040 |
;; 0x0400.
(pub :: oWronlyCreateAppend Int)
(pub fn (oWronlyCreateAppend)
  1089)

;; The `whence` value for `lseek` that measures from the end of the
;; file.
(pub :: seekEnd Int)
(pub fn (seekEnd)
  2)

;; The `whence` value for `lseek` that measures from the start of the
;; file.
(pub :: seekSet Int)
(pub fn (seekSet)
  0)

