; ------------------------------------------------------------------
; Starting a child process.
;
; Linux forks: the syscall returns 0 in the child and the pid in the
; parent, through one register, so `__syscallN` expresses it directly.
; Darwin's cannot (its `fork` returns a second value in x1), which is
; why `Sys.ax` branches on this capability rather than on an OS name.
(pub :: spawnUsesPosixSpawn Int)

(pub fn (spawnUsesPosixSpawn) 0)

; x86-64 still has a real `fork`, which takes no arguments; `sysForkArg`
; exists for the AArch64 module, where fork is spelled `clone(SIGCHLD)`.
; fork ignores whatever is in the argument registers, so passing it is
; harmless here and keeps one call site in portable code.
(pub :: sysFork Int)

(pub fn (sysFork) 57)

(pub :: sysForkArg Int)

(pub fn (sysForkArg) 0)

(pub :: sysExecve Int)

(pub fn (sysExecve) 59)

