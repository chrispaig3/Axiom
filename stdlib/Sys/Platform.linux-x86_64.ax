; Sys.Platform - Linux/x86-64 syscall numbers and flags.
;
; Selected by the `.linux-x86_64.ax` filename suffix when compiling for
; `--target=linux-x86_64`. Linux numbers the syscall table per
; architecture, so this file and `Platform.linux-aarch64.ax` share an OS
; but not a single number - which is exactly why module selection is
; `os-arch` before `os` (see the compiler's module resolution).
;
; Numbers from the kernel's `arch/x86/entry/syscalls/syscall_64.tbl`.

(pub :: sysRead Int)
(pub fn (sysRead) 0)

(pub :: sysWrite Int)
(pub fn (sysWrite) 1)

(pub :: sysOpen Int)
(pub fn (sysOpen) 2)

(pub :: sysClose Int)
(pub fn (sysClose) 3)

; exit_group, not exit: `exit` terminates the calling thread only, which
; leaves a multi-threaded process alive with no way to notice. 231 is
; correct for a single-threaded program too.
(pub :: sysExit Int)
(pub fn (sysExit) 231)

(pub :: sysLseek Int)
(pub fn (sysLseek) 8)

; x86-64 still has plain `open`.
(pub :: openNeedsDirFd Int)
(pub fn (openNeedsDirFd) 0)

(pub :: atFdCwd Int)
(pub fn (atFdCwd) 0)

(pub :: oRdonly Int)
(pub fn (oRdonly) 0)

; O_WRONLY | O_CREAT | O_TRUNC = 0x1 | 0x40 | 0x200
(pub :: oWronlyCreateTrunc Int)
(pub fn (oWronlyCreateTrunc) 577)

(pub :: seekEnd Int)
(pub fn (seekEnd) 2)

(pub :: seekSet Int)
(pub fn (seekSet) 0)

; ------------------------------------------------------------------
; Starting a child process.
;
; Linux forks: the syscall returns 0 in the child and the pid in the
; parent, through one register, so `__syscallN` expresses it directly.
; Darwin's cannot (its `fork` returns a second value in x1), which is
; why `Sys.ax` branches on this capability rather than on an OS name.
(pub :: spawnUsesPosixSpawn Int)
(pub fn (spawnUsesPosixSpawn) 0)

; x86-64 still has a real `fork`, which takes no arguments; `sysForkArg`
; exists for the AArch64 module, where fork is spelled `clone(SIGCHLD)`.
; fork ignores whatever is in the argument registers, so passing it is
; harmless here and keeps one call site in portable code.
(pub :: sysFork Int)
(pub fn (sysFork) 57)

(pub :: sysForkArg Int)
(pub fn (sysForkArg) 0)

(pub :: sysExecve Int)
(pub fn (sysExecve) 59)

(pub :: sysWait4 Int)
(pub fn (sysWait4) 61)

; Unused on Linux, defined so `Sys.ax` type-checks against every
; platform module.
(pub :: sysPosixSpawn Int)
(pub fn (sysPosixSpawn) 0)

; x86-64 still has a real `unlink`.
(pub :: sysUnlinkNum Int)
(pub fn (sysUnlinkNum) 87)

; mkdir(path, mode) - 83. x86-64 Linux has the plain call, so
; `openNeedsDirFd` is 0 here and `sysMkdir` uses the two-argument form.
(pub :: sysMkdirNum Int)
(pub fn (sysMkdirNum) 83)

; rmdir(path) - 84.
(pub :: sysRmdirNum Int)
(pub fn (sysRmdirNum) 84)

; getpid() - 39
(pub :: sysGetPidNum Int)
(pub fn (sysGetPidNum) 39)

; clock_gettime(clockid, ts) - 228. CLOCK_MONOTONIC=1; timespec is
; {tv_sec i64, tv_nsec i64}. Verified by the REPL gate on the CI
; runner - the first Linux execution of this number.
(pub :: sysClockNum Int)
(pub fn (sysClockNum) 228)

(pub :: clockIsGettimeofday Int)
(pub fn (clockIsGettimeofday) 0)
