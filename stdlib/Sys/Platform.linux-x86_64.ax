(pub :: sysListenNum Int)

(pub fn (sysListenNum) 50)

; accept4(fd, addr, addrlen, flags) - 288. `Sys.ax` passes flags 0,
; which makes it exactly `accept`.
(pub :: sysAcceptNum Int)

(pub fn (sysAcceptNum) 288)

; connect(fd, addr, addrlen) - 42.
(pub :: sysConnectNum Int)

(pub fn (sysConnectNum) 42)

; setsockopt(fd, level, name, val, len) - 54.
(pub :: sysSetSockOptNum Int)

(pub fn (sysSetSockOptNum) 54)

; getsockopt(fd, level, name, val, lenptr) - 55.
(pub :: sysGetSockOptNum Int)

(pub fn (sysGetSockOptNum) 55)

; shutdown(fd, how) - 48.
(pub :: sysShutdownNum Int)

(pub fn (sysShutdownNum) 48)

