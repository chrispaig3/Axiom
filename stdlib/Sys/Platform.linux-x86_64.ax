; ------------------------------------------------------------------
; Starting a child process.
;
; Linux forks: the syscall returns 0 in the child and the pid in the
; parent, through one register, so `__syscallN` expresses it directly.
; Darwin's cannot (its `fork` returns a second value in x1), which is
; why `Sys.ax` branches on this capability rather than on an OS name.
(pub :: spawnUsesPosixSpawn Int)

(pub fn (spawnUsesPosixSpawn) 0)

; x86-64 still has a real `fork`, which takes no arguments; `sysForkArg`
; exists for the AArch64 module, where fork is spelled `clone(SIGCHLD)`.
; fork ignores whatever is in the argument registers, so passing it is
; harmless here and keeps one call site in portable code.
(pub :: sysFork Int)

(pub fn (sysFork) 57)

(pub :: sysForkArg Int)

(pub fn (sysForkArg) 0)

(pub :: sysExecve Int)

(pub fn (sysExecve) 59)

(pub :: sysWait4 Int)

(pub fn (sysWait4) 61)

; Unused on Linux, defined so `Sys.ax` type-checks against every
; platform module.
(pub :: sysPosixSpawn Int)

(pub fn (sysPosixSpawn) 0)

; x86-64 still has a real `unlink`.
(pub :: sysUnlinkNum Int)

(pub fn (sysUnlinkNum) 87)

; mkdir(path, mode) - 83. x86-64 Linux has the plain call, so
; `openNeedsDirFd` is 0 here and `sysMkdir` uses the two-argument form.
(pub :: sysMkdirNum Int)

(pub fn (sysMkdirNum) 83)

; rmdir(path) - 84.
(pub :: sysRmdirNum Int)

(pub fn (sysRmdirNum) 84)

; rename(from, to) - 82. x86-64 still has the plain two-argument call,
; the same way it still has `open` and `unlink`.
(pub :: sysRenameNum Int)

(pub fn (sysRenameNum) 82)

; getdents64(fd, buf, count) - 217. Three arguments: the scan position
; lives on the descriptor, where Darwin needs a fourth argument
; pointing at a cookie - see `dirReadNeedsPosition` there.
(pub :: sysGetdentsNum Int)

(pub fn (sysGetdentsNum) 217)

(pub :: dirReadNeedsPosition Int)

(pub fn (dirReadNeedsPosition) 0)

; `struct linux_dirent64` is
;
;   u64 d_ino; s64 d_off; u16 d_reclen; u8 d_type; char d_name[];
;
; so d_reclen is at 16 - agreeing with Darwin, which portable code
; relies on - and the name begins at 19. This layout is the generic
; one: AArch64 Linux has the same offsets under a different syscall
; number.
(pub :: direntNameOffset Int)

(pub fn (direntNameOffset) 19)

; Linux has a real `getcwd(buf, size)`, so no descriptor and no
; `fcntl` detour - see the Darwin module for the target that has
; neither.
(pub :: cwdUsesFcntlPath Int)

(pub fn (cwdUsesFcntlPath) 0)

; getcwd(buf, size) - 79. Answers the length INCLUDING the NUL on
; success, where Darwin's `fcntl` answers 0; `sysGetCwd` reads the
; length back off the bytes rather than off the result, which is the
; one reading both conventions support.
(pub :: sysCwdNum Int)

(pub fn (sysCwdNum) 79)

; Unused on Linux (see `cwdUsesFcntlPath`), defined so `Sys.ax`
; type-checks against every platform module.
(pub :: fGetPath Int)

(pub fn (fGetPath) 0)

