(pub :: openNeedsDirFd Int)

(pub fn (openNeedsDirFd) 0)

(pub :: atFdCwd Int)

(pub fn (atFdCwd) 0)

(pub :: oRdonly Int)

(pub fn (oRdonly) 0)

