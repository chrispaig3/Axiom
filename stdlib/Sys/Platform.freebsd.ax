;; one is not.
(pub :: sigTerm Int)
(pub fn (sigTerm)
  Internal.Platform::impl_sigTerm)

;; The `SIGCHLD` signal number, or zero when child signals are unavailable.
(pub :: sigChild Int)
(pub fn (sigChild)
  Internal.Platform::impl_sigChild)

;; The `SIGINT` signal number.
(pub :: sigInt Int)
(pub fn (sigInt)
  Internal.Platform::impl_sigInt)

;; The Windows Ctrl-Break signal number, or 0 where it is unavailable.
(pub :: sigBreak Int)
(pub fn (sigBreak)
  Internal.Platform::impl_sigBreak)

;; `fork` answers 0 in the child and the child's pid in the parent, the
;; POSIX convention, so `sysForkProcess` passes the result through.
;; This is asserted from the kernel source rather than measured:
;; `cpu_fork` sets the child's return register to 0 and clears the
;; carry bit on both amd64 (`tf_rax = 0`) and arm64 (`tf_x[0] = 0`) -
;; the BSD two-register convention Darwin exposes puts the "am I the
;; child" flag in the SECOND register, and FreeBSD's first register
;; still answers 0 to the child. If this is wrong, the failure is the
;; one `Sys.ax`'s `sysSpawn` guards against: the child returns into the
;; caller as a second copy of the driver. The FreeBSD leg's first
;; `sysRun` is the measurement.
(pub :: forkChildIsZero Int)
(pub fn (forkChildIsZero)
  Internal.Platform::impl_forkChildIsZero)

; ------------------------------------------------------------------
; Which KIND of platform module this is.
;
; 1: a table of numbers, and `Sys.ax` makes every kernel call itself
; through `__syscallN`. The three `platform*` functions below are then
; never reached - `Sys.ax` tests this capability first - and answer
; -ENOSYS (78 on FreeBSD, the same number as Darwin's: both kernels
; descend from 4.4BSD's errno table), so a caller that reached one
; anyway would see a failure and not a count. `Sys/Platform.windows.ax`
; is the other kind: it answers 0 and does the work itself over
; `extern "kernel32"` bindings, because Windows has no syscall ABI to
; put in a table. The names are declared in every module so that all
; of them declare one public surface (`check-stdlib-api.sh`,
; `check-compat.sh`).
; ------------------------------------------------------------------
;; 1 where the platform is reached through raw syscalls, 0 where it
;; goes through the C library or a host shim.
(pub :: usesSyscallAbi Int)
(pub fn (usesSyscallAbi)
  Internal.Platform::impl_usesSyscallAbi)

;; The platform's own way to end the process where raw `exit` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformExitWith (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformExitWith code)
  (Internal.Platform::impl_platformExitWith code))

;; The path of the null device: `/dev/null` here.
(pub :: platformNullPath String)
;@axiom:effect(pure)
(pub fn (platformNullPath)
  Internal.Platform::impl_platformNullPath)

;; The platform's own way to wait for a child where raw `wait4` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformWait (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformWait pid)
  (Internal.Platform::impl_platformWait pid))

;; The platform's own way to signal a child where raw `kill` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformKill (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformKill pid sig)
  (Internal.Platform::impl_platformKill pid sig))

;; The platform's own way to poll a child where raw `waitid` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformChildExited (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformChildExited pid)
  (Internal.Platform::impl_platformChildExited pid))

;; The platform's own way to read the process id where raw `getpid` is
;; not available; -78 where the raw syscall is used instead.
(pub :: platformPid Int)
;@axiom:effect(pure)
(pub fn (platformPid)
  Internal.Platform::impl_platformPid)

;; The byte that separates the entries of `PATH`: `:` here, `;` on
;; Windows.
(pub :: pathListSep Int)
(pub fn (pathListSep)
  Internal.Platform::impl_pathListSep)

;; 1 where a backslash separates path components and `C:` starts an
