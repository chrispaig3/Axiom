;;! Intern - owned string interning with dense identifiers.
; Interners retain their strings and reclaim storage when their last owner leaves scope.
(import Internal.Intern)

;; An owning interner. Its storage is private to the library.
(pub type InternState InternalInternState)

;; Create an empty interner.
(pub :: internNew InternState)
(pub fn (internNew)
  rawInternNewTyped)

;; Create an empty interner.
(pub :: internNewTyped InternState)
(pub fn (internNewTyped)
  internNew)

;; Reserve room for at least want distinct strings.
(pub :: internWithCapacity (-> Int InternState))
(pub fn (internWithCapacity want)
  (rawInternWithCapacityTyped want))

;; The initial hash slot for s in a table with cap slots.
(pub :: internSlotOf (-> String Int Int))
(pub fn (internSlotOf s cap)
  (rawInternSlotOf s cap))

;; The number of table slots.
(pub :: internCap (-> InternState Int))
(pub fn (internCap owner)
  (rawInternCap (rawInternWordOf owner)))

;; The number of distinct interned strings.
(pub :: internCount (-> InternState Int))
(pub fn (internCount owner)
  (rawInternCount (rawInternWordOf owner)))

;; Look up an identifier, or return an empty string when it is out of range.
(pub :: internLookup (-> InternState Int String))
(pub fn (internLookup owner id)
  (rawInternLookup (rawInternWordOf owner) id))

;; Find the identifier for a string, or None when it is absent.
(pub :: internFind (-> InternState String (Option Int)))
(pub fn (internFind owner value)
  (rawInternFind (rawInternWordOf owner) value))

;; Return the string's identifier, adding it when it is new.
(pub :: internIntern (-> InternState String Int))
(pub fn (internIntern owner value)
  (rawInternIntern (rawInternWordOf owner) value))
