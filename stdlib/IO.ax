; IO - console and file I/O, in Axiom.
;
; The whole module is Axiom code over `Sys`, which is Axiom code over the
; `__syscallN` primitive. Nothing here binds to C, which is what makes
; `println` a standard-library function rather than a `printf` wrapper.
;
; Functions that touch the outside world carry `;@axiom:effect(io)`, and
; the compiler validates those claims against the syscalls actually
; reachable from each body - transitively, by fixpoint - so an
; `io`-tagged function that stopped doing I/O warns (`AX3010`). An
; untagged function that starts doing I/O is NOT flagged: tags are
; opt-in claims, checked when made, and `axiom symbols` reports the
; inferred `#effects=` either way.

(import Sys)
(import Str)
(import Vec)
(import Path)
(import Fmt)
; The printing macros expand to `show`, so `IO` is where a program
; picks up the `Show` instances by importing one module rather than
; two. `Show` does not import `IO` - rendering has no effects and
; must not acquire one - so the edge is one-way.
(import Show)

; ------------------------------------------------------------------
; Writing
; ------------------------------------------------------------------

; Write all of `s` to `fd`, returning the number of bytes written or a
; negative errno.
;
; Loops until the whole string is out: a single `write` is permitted to
; transfer fewer bytes than asked (a pipe with a full buffer, a signal),
; and treating a short write as success is the classic way to silently
; truncate output.
;
; The loop itself is `Sys.sysWriteAllFd` now, and was a private
; `writeAll` here. It moved down because `sysWriteFile` needed it and
; could not reach up: everything writing a FILE was single-shot while
; everything writing a DESCRIPTOR was not, which is the same bug
; sitting on the other side of one import.
(pub :: writeStr (-> Int String Int))
;@axiom:effect(io)
(pub fn (writeStr fd s)
  (sysWriteAllFd fd (strData s) (strLen s) 0))

; ------------------------------------------------------------------
; Printing is FIVE MACROS AND NO FUNCTIONS.
;
; `writeStr` above is the whole runtime side: bytes, to a descriptor.
; Everything between a value and those bytes is decided at expansion
; time, so this module exports no `printInt`, no `printFloat`, and no
; per-type anything - a type is rendered by the `Show` instance the
; checker selects, and a WIDTH or a RADIX is chosen by a format
; specifier rather than by picking a different function to call.
;
; That is the whole of the unification. Before it, printing an `Int`
; padded to eight columns meant `(print (fmtPadLeft (fmtInt n) 8))` -
; three names, composed by hand, at every call site. It is now
; `(print "{n:>8}")`, and the three calls are still there, written by
; the expander instead of by the programmer.
; ------------------------------------------------------------------

; Print NUL-terminated bytes at an address: `(printLit (__addr "hi"))`.
;
; Not the way to print a literal any more - `(println "hi")` is, and it
; costs nothing extra, because a literal already *is* a `Str` with a
; compile-time length and no header has to be built. What is left here
; is the case the name no longer describes well: NUL-terminated bytes
; that arrived from somewhere without a length, such as a syscall
; buffer.
(:: printLit (-> Int Int))
;@axiom:effect(io)
(fn (printLit cstr)
  (sysWriteAllFd stdout cstr (cstrLen cstr 0) 0))

(pub :: printlnLit (-> Int Int))
;@axiom:effect(io)
(pub fn (printlnLit cstr)
  {
    (printLit cstr)
    (printLit (__addr "\n"))
  })

; ------------------------------------------------------------------
; The two.
;
; One parameter each, and that is the design rather than a limitation
; waiting to be lifted. A hole names a binding at the CALL:
;
;   (println "hello, {name}")
;   (println "{done:>4}/{total} done")
;   (eprintln "{file}:{line}: {msg}")
;
; so the argument count never depends on the number of holes, and no
; repetition pattern (MAC-LANG-15..18, unbuilt) is needed to write
; either of them. `syntax/format` does the parse; see
; docs/macro-system.md MAC-CAP-10 for the grammar, the lowering and
; the refusals.
;
; Given anything that is NOT a literal, `syntax/format` answers
; `(show e)` - so these are equally the general "print a value"
; spelling. `(println n)` on an `Int` prints the integer, and
; `(println s)` on a `String` is the identity instance, which is why
; the seventy-eight `(println expr)` call sites that predate the macros
; did not have to change.
;
; `syntax/formatln` is `syntax/format` with the newline folded into the
; last literal run AT EXPANSION TIME, so `(println "hi")` is one
; `write` of `"hi\n"` - one syscall and no allocation, where the
; function this replaced did two writes.
;
; THERE IS NO `print`, AND THAT IS THE POINT. A newline-less printer
; exists in C-descended libraries because building a line out of pieces
; was expensive, so you emitted the pieces instead. Here the line is
; built at COMPILE time: `(println "ok {name} in {ms:>4}ms")` is one
; call, one syscall, and one place to read the line's shape. The four
; calls it replaces - `(print "ok ") (print name) (print " in ")
; (println ms)` - were four syscalls and a shape no reader could see
; without executing it in their head. `340-json`'s self-grading harness
; went from six print statements per verdict to one.
;
; A program that genuinely wants bytes on the descriptor with no
; newline and no rendering has `writeStr` above it, unchanged and
; public - that is the primitive, and it is one call too.
; ------------------------------------------------------------------

(pub macro (println e)  (writeStr stdout (syntax/formatln e)))
(pub macro (eprintln e) (writeStr stderr (syntax/formatln e)))

; ------------------------------------------------------------------
; Reading
; ------------------------------------------------------------------

; Read up to `count` bytes from `fd` into a fresh `Str`.
;
; The result's length is what was actually read, so end-of-file is an
; empty `Str` rather than a sentinel the caller has to remember to check.
; A read error returns an empty `Str` too; `readFile` distinguishes the
; cases where it matters.
(:: readUpTo (-> Int Int String))
;@axiom:effect(io)
(fn (readUpTo fd count)
  (let ((s (strAlloc count)))
    (let ((n (sysReadFd fd (strData s) count)))
      (if (< n 0)
          (strAlloc 0)
          (strSlice s 0 n)))))

; Read `fd` to end of file, growing a buffer as needed.
;
; Doubling on each refill keeps the total copying linear in the file
; size. `chunk` is the initial capacity; files smaller than it cost
; exactly one allocation and one `read`.
(:: readAll (-> Int Int String))
;@axiom:effect(io)
(fn (readAll fd chunk)
  (readAllInto fd (strAlloc chunk) 0 chunk))

(:: readAllInto (-> Int String Int Int String))
;@axiom:effect(io)
(fn (readAllInto fd buf len cap)
  (if (>= len cap)
      (let ((bigger (strAlloc (* cap 2))))
        {
          (memCopy (strData bigger) (strData buf) len)
          (readAllInto fd bigger len (* cap 2))
        })
      (let ((n (sysReadFd fd (+ (strData buf) len) (- cap len))))
        (if (< n 1)
            (strSlice buf 0 len)
            (readAllInto fd buf (+ len n) cap)))))

; The whole contents of the file at NUL-terminated path `cstr`, or an
; empty `Str` if it cannot be opened.
;
; Callers that must distinguish "empty file" from "no such file" should
; use `sysOpenPath` directly; this is the convenience form, and it is
; the one a compiler driver wants for reading a source file.
(pub :: readFileLit (-> Int String))
;@axiom:effect(io)
(pub fn (readFileLit cstr)
  (let ((fd (sysOpenPath cstr oRdonly)))
    (if (sysFailed fd)
        (strAlloc 0)
        (let ((contents (readAll fd 65536)))
          {
            (sysCloseFd fd)
            contents
          }))))

(pub :: readFile (-> String String))
;@axiom:effect(io)
(pub fn (readFile path)
  (readFileLit (ioPath path)))

; ------------------------------------------------------------------
; Files and directories, by name.
;
; `Sys` takes a raw NUL-terminated `char*` for every path, because it
; hands one straight to a syscall. This is the layer that takes a
; `Str`, and the split is the rule the library already stated for
; `sysReadFile` versus `readFile` above - applied to the whole surface
; rather than to the one function that happened to need it first.
;
; The convenience is not only the type. Each of these answers the
; question a caller actually has:
;
;   - `fileExists` cannot tell a file from a directory; `isDir` can.
;   - `writeFile` truncates and `appendFile` does not, which used to
;     be read-concatenate-rewrite at every call site that wanted it.
;   - `listDir` sorts, so a program that walks a directory produces
;     the same output on two machines.
;   - `makeDirAll` creates the parents, which is what a build writing
;     `build/obj/x.o` means by "make the directory".
;
; PATHS ARE COPIED BEFORE THEY CROSS. `strSlice` shares storage and a
; slice is NOT NUL-terminated, so handing one to `open` reads past its
; end into whatever the parent string holds - for a slice of
; `"src/main.ax"` that is a path that still exists, which is the worst
; possible failure mode. Every function here copies first. One small
; allocation, once, next to a syscall.
; ------------------------------------------------------------------

; `path` as a `char*` a syscall can take, always by copy - see above.
(:: ioPath (-> String Int))
(fn (ioPath path)
  (strCStr (strDup path)))

; Write `s` to `path`, creating it or TRUNCATING what is there.
; Answers the bytes written, or a negative errno.
(pub :: writeFile (-> String String Int))
;@axiom:effect(io)
(pub fn (writeFile path s)
  (sysWriteFile (ioPath path) s))

; Add `s` to the end of `path`, creating it if absent. Answers the
; bytes written, or a negative errno.
(pub :: appendFile (-> String String Int))
;@axiom:effect(io)
(pub fn (appendFile path s)
  (sysAppendFile (ioPath path) s))

; Remove the file `path`. Answers 0, or a negative errno.
;
; It does NOT remove a directory - the kernel refuses with EPERM on
; Darwin and EISDIR on Linux (probed 2026-08-15: `-1` here). That is
; `removeDir`'s job, and the two are separate calls on every platform
; except AArch64 Linux, where they are one call and a flag.
(pub :: removeFile (-> String Int))
;@axiom:effect(io)
(pub fn (removeFile path)
  (sysUnlink (ioPath path)))

; Move `old` to `new`, answering 0 or a negative errno.
;
; Atomic within one filesystem: a reader of `new` sees the whole old
; contents or the whole new ones, never a prefix. Across filesystems
; the kernel refuses with EXDEV (18) and `copyFile` + `removeFile` is
; the fallback - which is not atomic, and that is the difference the
; two spellings are for.
(pub :: renamePath (-> String String Int))
;@axiom:effect(io)
(pub fn (renamePath old new)
  (sysRename (ioPath old) (ioPath new)))

; Copy `src` onto `dst`, answering the bytes written or a negative
; errno. `dst` is created or truncated.
;
; The whole file goes through memory, so this is for the sizes a
; source tree holds rather than for arbitrary ones - a streaming copy
; would want a fixed buffer and a loop, and no caller has needed one.
; The read is checked FIRST, because `readFile` answers "" for a
; missing file and copying that would report success having created an
; empty `dst` - destroying whatever was at `dst` on behalf of a source
; that does not exist.
(pub :: copyFile (-> String String Int))
;@axiom:effect(io)
(pub fn (copyFile src dst)
  (let ((e (readErrno src)))
    (if (!= e 0)
        (- 0 e)
        (writeFile dst (readFile src)))))

; True when `path` names something that can be opened for reading -
; a directory included. `isDir` separates them.
(pub :: fileExists (-> String Bool))
;@axiom:effect(io)
(pub fn (fileExists path)
  (sysFileExists (ioPath path)))

; True when `path` names a directory.
(pub :: isDir (-> String Bool))
;@axiom:effect(io)
(pub fn (isDir path)
  (sysIsDir (ioPath path)))

; The size of `path` in bytes, or a negative errno.
;
; A DIRECTORY answers a positive number here, and it is the size of
; the directory file rather than anything a caller means - ask `isDir`
; first if that matters. See `Sys.sysFileSize`.
(pub :: fileSize (-> String Int))
;@axiom:effect(io)
(pub fn (fileSize path)
  (sysFileSize (ioPath path)))

; 0 when `path` can be read as a file, otherwise the errno saying why
; not: 2 missing, 13 not permitted, 21 a directory.
;
; The three-way answer `readFile` cannot give, because it reports all
; three - and an empty file - as "". A caller that must distinguish
; "the file is empty" from "there is no file" asks this first.
(pub :: readErrno (-> String Int))
;@axiom:effect(io)
(pub fn (readErrno path)
  (sysReadErrno (ioPath path)))

; Create the directory `path`, mode 0755. Answers 0, or a negative
; errno - `-17` (EEXIST) when it is already there.
(pub :: makeDir (-> String Int))
;@axiom:effect(io)
(pub fn (makeDir path)
  (sysMkdir (ioPath path) sysDirMode))

; Create `path` and every missing directory above it. Answers 0, or
; the negative errno of the first component that could not be made.
;
; An existing directory is SUCCESS at every level, which is the whole
; difference from `makeDir` and the reason a build can call this
; unconditionally instead of testing first - testing first is a race,
; and treating EEXIST as success is not.
(pub :: makeDirAll (-> String Int))
;@axiom:effect(io)
(pub fn (makeDirAll path)
  ; From 1, not 0: a leading `/` is the root, which exists and cannot
  ; be created, and asking to create "" fails with ENOENT.
  (makeDirAllFrom path 1))

(:: makeDirAllFrom (-> String Int Int))
;@axiom:effect(io)
(fn (makeDirAllFrom path i)
  (if (>= i (strLen path))
      (makeDirOk path)
      (if (== (strByte path i) 47)
          (let ((rc (makeDirOk (strSlice path 0 i))))
            (if (< rc 0) rc (makeDirAllFrom path (+ i 1))))
          (makeDirAllFrom path (+ i 1)))))

; `makeDir`, with "it was already there" counted as success.
(:: makeDirOk (-> String Int))
;@axiom:effect(io)
(fn (makeDirOk p)
  (let ((rc (makeDir p)))
    (if (== (sysErrno rc) eExist) 0 rc)))

; Remove the EMPTY directory `path`. Answers 0, or a negative errno -
; `-66`/`-39` (ENOTEMPTY) when it still holds entries. Nothing here
; removes a tree: that is a loop over `listDir`, and it is the
; caller's to write, because a library that deletes recursively on
; one call is a library that deletes the wrong subtree once.
(pub :: removeDir (-> String Int))
;@axiom:effect(io)
(pub fn (removeDir path)
  (sysRmdir (ioPath path)))

; The entries of the directory `path`, as a Vec of `Str` - sorted by
; byte, with `.` and `..` removed.
;
; An empty Vec means an empty directory OR a path that is not a
; readable directory; `isDir` separates them. That ambiguity is
; introduced HERE and not by the syscall: `Sys.sysReadDir` keeps `.`
; and `..`, so its empty answer can only be failure, and dropping them
; is what costs the distinction. It is dropped anyway, because a
; caller that walks a directory and forgets to skip `..` walks the
; whole filesystem, and that mistake is worse than the one this makes.
;
; SORTED, and that is not a nicety. `readdir` order is the
; filesystem's - unstable across machines, and across runs on the same
; machine after entries are added and removed - so a program that
; lists a directory and prints, hashes or compiles what it finds is
; not reproducible unless something sorts. Doing it here means nothing
; has to remember to.
;
; The sort is an insertion sort, quadratic in the entry count, and
; that is the right shape for a directory: it is one pass for an
; already-ordered listing (which is what most filesystems hand back),
; it needs no scratch allocation, and `Vec` has no comparison sort to
; borrow. A directory large enough to notice wants `Sys.sysReadDir`
; and its own ordering.
(pub :: listDir (-> String Int))
;@axiom:effect(io)
(pub fn (listDir path)
  (let ((raw (sysReadDir (ioPath path)))
        (out vecNew))
    { (listDirKeep raw 0 out) out }))

(:: listDirKeep (-> Int Int Int Int))
(fn (listDirKeep raw i out)
  (if (>= i (vecLen raw))
      0
      (let ((name (cast String (vecGet raw i))))
        {
          (if (|| (strEq name ".") (strEq name ".."))
              0
              (listDirInsert out name))
          (listDirKeep raw (+ i 1) out)
        })))

; Push, then bubble the new entry down to where it belongs. The Vec
; below it is already sorted, so this settles in one comparison when
; the listing arrives in order.
(:: listDirInsert (-> Int String Int))
(fn (listDirInsert v s)
  {
    (vecPush v (cast Int s))
    (listDirSift v (- (vecLen v) 1))
  })

(:: listDirSift (-> Int Int Int))
(fn (listDirSift v i)
  (if (<= i 0)
      0
      (let ((a (cast String (vecGet v (- i 1))))
            (b (cast String (vecGet v i))))
        (if (<= (strCmp a b) 0)
            0
            {
              (vecSet v (- i 1) (cast Int b))
              (vecSet v i (cast Int a))
              (listDirSift v (- i 1))
            }))))

; The process's working directory as an absolute path, or "" if it
; cannot be determined. See `Sys.sysGetCwd` for why this is two
; different syscalls underneath.
(pub :: cwd String)
;@axiom:effect(io)
(pub fn (cwd)
  sysGetCwd)

; ------------------------------------------------------------------
; Process exit
; ------------------------------------------------------------------

(pub :: exit (-> Int Int))
;@axiom:effect(io)
(pub fn (exit code)
  (sysExitWith code))

; Print `s` to standard error and exit with `code`. Never returns.
(pub :: die (-> String Int Int))
;@axiom:effect(io)
(pub fn (die s code)
  {
    ; `s` is already a String and its type is DECLARED, so the macro's
    ; `show` resolves to the identity instance; this is an ordinary
    ; `(eprintln s)` and not a special case.
    (eprintln s)
    (exit code)
  })
