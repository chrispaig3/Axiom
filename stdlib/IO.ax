; IO - console and file I/O, in Axiom.
;
; This module uses Sys for kernel calls or platform APIs, depending on
; the target. Printing needs no C runtime or printf binding.
;
; Functions that touch the outside world carry `;@axiom:effect(io)`, and
; the compiler validates those claims against the syscalls actually
; reachable from each body - transitively, by fixpoint - so an
; `io`-tagged function that stopped doing I/O warns (`AX3010`). An
; untagged function that starts doing I/O is NOT flagged: tags are
; opt-in claims, checked when made, and `axiom symbols` reports the
; inferred `#effects=` either way.
(import Sys)
(import Err)
(import Mem)
(import Str)
(import Vec)
(import Fmt)

; The printing macros expand to `show`, so `IO` is where a program
; picks up the `Show` instances by importing one module rather than
; two. `Show` does not import `IO` - rendering has no effects and
; must not acquire one - so the edge is one-way.
; ------------------------------------------------------------------
; Writing
; ------------------------------------------------------------------
; Write all of `s` to `fd`, returning the number of bytes written or a
; negative errno.
;
; Loops until the whole string is out: a single `write` is permitted to
; transfer fewer bytes than asked (a pipe with a full buffer, a signal),
; and treating a short write as success is the classic way to silently
; truncate output.
;
; The loop itself is `Sys.sysWriteAllFd` now, and was a private
; `writeAll` here. It moved down because `sysWriteFile` needed it and
; could not reach up: everything writing a FILE was single-shot while
; everything writing a DESCRIPTOR was not, which is the same bug
; sitting on the other side of one import.
(pub :: writeStr (-> Int String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (writeStr fd s)
  (sysWriteAllFd fd (strData s) (strLen s) 0))

; Write the `len` bytes of `s` that start at byte `start`, all of them,
; returning the number written or a negative errno - `writeStr` over a
; part of a string, with no copy.
;
; The range is checked before anything is written: a `start` or `len`
; that is negative, or one that runs past the end of `s`, stops the
; program with status 77, the index trap `vecGet` raises. The kernel
; is only ever handed bytes `s` holds.
(pub :: writeSlice (-> Int String Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (writeSlice fd s start len)
  (if (ioOutside s start len)
    __indexTrap
    (sysWriteAllFd fd (+ (strData s) start) len 0)))

; True when `[start, start + len)` is not inside `s`. Written so that no
; sum can overflow: `start` is known to be in range before `len` is
; compared with what is left after it.
(:: ioOutside (-> String Int Int Bool))
(fn (ioOutside s start len)
  (if (< start 0)
    true
    (if (< len 0)
      true
      (if (> start (strLen s))
        true
        (> len (- (strLen s) start))))))

; ------------------------------------------------------------------
; Printing is MACROS AND NO FUNCTIONS.
;
; `writeStr` above is the whole runtime side: bytes, to a descriptor.
; Everything between a value and those bytes is decided at expansion
; time, so this module exports no `printInt`, no `printFloat`, and no
; per-type anything - a type is rendered by the rendering the checker
; selects from its static type, and a WIDTH or a RADIX is chosen by a
; format specifier rather than by picking a different function to call.
;
; That is the whole of the unification. Before it, printing an `Int`
; padded to eight columns meant `(print (fmtPadLeft (fmtInt n) 8))` -
; three names, composed by hand, at every call site. It is now
; `(print "{n:>8}")`, and the three calls are still there, written by
; the expander instead of by the programmer.
; ------------------------------------------------------------------
; Print NUL-terminated bytes at an address: `(printLit (__addr "hi"))`.
;
; Not the way to print a literal any more - `(println "hi")` is, and it
; costs nothing extra, because a literal already *is* a `Str` with a
; compile-time length and no header has to be built. What is left here
; is the case the name no longer describes well: NUL-terminated bytes
; that arrived from somewhere without a length, such as a syscall
; buffer.
(:: printLit (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`cstr` names live NUL-terminated bytes)
(fn (printLit cstr)
  (sysWriteAllFd stdout cstr (cstrLen cstr 0) 0))

(pub :: printlnLit (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`cstr` names live NUL-terminated bytes)
(pub fn (printlnLit cstr)
  {
    (printLit cstr)
    (printLit (__addr "\n"))
  })

; ------------------------------------------------------------------
; The two.
;
; One parameter each, and that is the design rather than a limitation
; waiting to be lifted. A hole names a binding at the CALL:
;
;   (println "hello, {name}")
;   (println "{done:>4}/{total} done")
;   (eprintln "{file}:{line}: {msg}")
;
; so the argument count never depends on the number of holes, and no
; repetition pattern (MAC-LANG-15..18, unbuilt) is needed to write
; either of them. `syntax/format` does the parse; see
; docs/macro-system.md MAC-CAP-10 for the grammar, the lowering and
; the refusals.
;
; Given anything that is NOT a literal, `syntax/format` answers one
; rendering call on it - so these are equally the general "print a
; value" spelling. `(println n)` on an `Int` prints the integer, and
; `(println s)` on a `String` renders as itself (the call is elided
; outright), which is why the seventy-eight `(println expr)` call sites
; that predate the macros did not have to change.
;
; `syntax/formatln` is `syntax/format` with the newline folded into the
; last literal run AT EXPANSION TIME, so `(println "hi")` is one
; `write` of `"hi\n"` - one syscall and no allocation, where the
; function this replaced did two writes.
;
; THERE IS NO `print`, AND THAT IS THE POINT. A newline-less printer
; exists in C-descended libraries because building a line out of pieces
; was expensive, so you emitted the pieces instead. Here the line is
; built at COMPILE time: `(println "ok {name} in {ms:>4}ms")` is one
; call, one syscall, and one place to read the line's shape. The four
; calls it replaces - `(print "ok ") (print name) (print " in ")
; (println ms)` - were four syscalls and a shape no reader could see
; without executing it in their head. `340-json`'s self-grading harness
; went from six print statements per verdict to one.
;
; A program that genuinely wants bytes on the descriptor with no
; newline and no rendering has `writeStr` above it, unchanged and
; public - that is the primitive, and it is one call too.
; ------------------------------------------------------------------
(pub macro (println e) (writeStr stdout (syntax/formatln e)))

(pub macro (eprintln e) (writeStr stderr (syntax/formatln e)))

; ------------------------------------------------------------------
; Reading
; ------------------------------------------------------------------
; The whole contents of the file at NUL-terminated path `cstr`, or an
; empty `Str` if it cannot be opened.
;
; Callers that must distinguish "empty file" from "no such file" should
; use `sysOpenPath` directly; this is the convenience form, and it is
; the one a compiler driver wants for reading a source file.
;
; Like every other verb in this module it is its `Sys` twin named for
; the caller: the open/read-to-EOF/close sequence, the doubling refill
; and MM-VAL-7's retain are stated once, in `sysReadFile`.
(pub :: readFileLit (-> Int String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`cstr` names live NUL-terminated bytes)
(pub fn (readFileLit cstr)
  (sysReadFile cstr))

(pub :: readFile (-> String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (readFile path)
  (readFileLit (ioPath path)))

; ------------------------------------------------------------------
; Files and directories, by name.
;
; `Sys` takes a raw NUL-terminated `char*` for every path, because it
; hands one straight to a syscall. This is the layer that takes a
; `Str`, and the split is the rule the library already stated for
; `sysReadFile` versus `readFile` above - applied to the whole surface
; rather than to the one function that happened to need it first.
;
; The convenience is not only the type. Each of these answers the
; question a caller actually has:
;
;   - `fileExists` cannot tell a file from a directory; `isDir` can.
;   - `writeFile` truncates and `appendFile` does not, which used to
;     be read-concatenate-rewrite at every call site that wanted it.
;   - `listDir` sorts, so a program that walks a directory produces
;     the same output on two machines.
;   - `makeDirAll` creates the parents, which is what a build writing
;     `build/obj/x.o` means by "make the directory".
;
; PATHS ARE COPIED BEFORE THEY CROSS. `strSlice` shares storage and a
; slice is NOT NUL-terminated, so handing one to `open` reads past its
; end into whatever the parent string holds - for a slice of
; `"src/main.ax"` that is a path that still exists, which is the worst
; possible failure mode. Every function here copies first. One small
; allocation, once, next to a syscall.
; ------------------------------------------------------------------
; `path` as a `char*` a syscall can take, always by copy - see above.
(:: ioPath (-> String Int))
(fn (ioPath path)
  (strCStr (strDup path)))

; A `Sys` answer re-wrapped with the path this layer knows.
;
; `Sys.sysResult` already turned the raw `-errno` into an `Error`; what
; it could not do is name the path, because a path at that layer is an
; `Int` - a NUL-terminated buffer address, and rendering one would mean
; reading foreign memory to describe a call that just failed. This
; layer has the `String`, so it carries the code through and rebuilds
; the message.
;
; `op` and `path` go into the message because an errno alone does not
; say what was being attempted, and every one of these calls has a
; path - which is the whole reason a bare `-2` is a bad answer: it is
; ENOENT for a file the caller can name and cannot see named.
(pub :: ioResult (-> (Result Int Error) String String (Result Int Error)))
(pub fn (ioResult r op path)
  (match r
    ((Ok v) (Ok v))
    ; `Sys` already turned the errno into an `Error`; what it could not
    ; do is name the path, because at that layer a path is an `Int` -
    ; a NUL-terminated buffer address. The code is carried through
    ; unchanged and only the message is rebuilt.
    ((Err e) (Err (mkError (errCode e) (concat (concat (concat op ": ") (concat path ": errno ")) (fmtInt (errCode e))))))))

; Write `s` to `path`, creating it or TRUNCATING what is there.
; Answers `(Ok bytes)`, or `(Err e)` whose code is the errno.
(pub :: writeFile (-> String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (writeFile path s)
  (ioResult (sysWriteFile (ioPath path) s) "writeFile" path))

; Add `s` to the end of `path`, creating it if absent. Answers the
; `(Ok bytes)`, or `(Err e)` whose code is the errno.
(pub :: appendFile (-> String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (appendFile path s)
  (ioResult (sysAppendFile (ioPath path) s) "appendFile" path))

; Remove the file `path`. Answers `(Ok 0)`, or `(Err …)` carrying the errno.
;
; It does NOT remove a directory - the kernel refuses with EPERM on
; Darwin and EISDIR on Linux (probed 2026-08-15: `-1` here). That is
; `removeDir`'s job, and the two are separate calls on every platform
; except AArch64 Linux, where they are one call and a flag.
(pub :: removeFile (-> String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (removeFile path)
  (ioResult (sysUnlink (ioPath path)) "removeFile" path))

; Move `old` to `new`, answering `(Ok 0)` or `(Err …)` with the errno.
;
; Atomic within one filesystem: a reader of `new` sees the whole old
; contents or the whole new ones, never a prefix. Across filesystems
; the kernel refuses with EXDEV (18) and `copyFile` + `removeFile` is
; the fallback - which is not atomic, and that is the difference the
; two spellings are for.
(pub :: renamePath (-> String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (renamePath old new)
  (ioResult (sysRename (ioPath old) (ioPath new)) "renamePath" old))

; Open `path` with `flags` (`oRdonly`, `oWronlyCreateTrunc`, ...):
; `(Ok file)`, or `(Err e)` whose code is the errno. New files get mode
; 0644. The file closes when its last owner leaves scope.
(pub :: openPath (-> String Int (Result File Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (openPath path flags)
  (match (ioResult (sysOpenPath (ioPath path) flags) "openPath" path)
    ((Ok fd) (Ok (fileFromFd fd)))
    ((Err e) (Err e))))

; Open `rel` for reading inside the directory `root`, following no
; symbolic link below it: `(Ok file)`, or `(Err e)`. `rel` must be
; relative, with no `..` segment; see `Sys.sysOpenBeneath` for the
; rules and why it walks one segment at a time.
(pub :: openBeneath (-> String String (Result File Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (openBeneath root rel)
  (match (ioResult (sysOpenBeneath (ioPath root) rel) "openBeneath" rel)
    ((Ok fd) (Ok (fileFromFd fd)))
    ((Err e) (Err e))))

; Create the symbolic link `link` whose content is `target`. Answers
; `(Ok 0)`, or `(Err e)` - EEXIST when `link` is already there.
(pub :: makeSymlink (-> String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (makeSymlink target link)
  (ioResult (sysSymlink (ioPath target) (ioPath link)) "makeSymlink" link))

; Copy `src` onto `dst`, answering `(Ok bytes)` or `(Err e)`. `dst` is
; created or truncated.
;
; The whole file goes through memory, so this is for the sizes a
; source tree holds rather than for arbitrary ones - a streaming copy
; would want a fixed buffer and a loop, and no caller has needed one.
; The read is checked FIRST, because `readFile` answers "" for a
; missing file and copying that would report success having created an
; empty `dst` - destroying whatever was at `dst` on behalf of a source
; that does not exist.
(pub :: copyFile (-> String String (Result Int Error)))
;@axiom:effect(io)
(pub fn (copyFile src dst)
  (let ((e (readErrno src)))
    (if (!= e 0)
      (Err (mkError e (concat (concat "copyFile: " src) ": unreadable")))
      (writeFile dst (readFile src)))))

; True when `path` names something that can be opened for reading -
; a directory included. `isDir` separates them.
(pub :: fileExists (-> String Bool))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (fileExists path)
  (sysFileExists (ioPath path)))

; True when `path` names a directory.
(pub :: isDir (-> String Bool))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (isDir path)
  (sysIsDir (ioPath path)))

; The size of `path` in bytes, or `(Err …)` carrying the errno.
;
; A DIRECTORY answers a positive number here, and it is the size of
; the directory file rather than anything a caller means - ask `isDir`
; first if that matters. See `Sys.sysFileSize`.
(pub :: fileSize (-> String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (fileSize path)
  (ioResult (sysFileSize (ioPath path)) "fileSize" path))

; 0 when `path` can be read as a file, otherwise the errno saying why
; not: 2 missing, 13 not permitted, 21 a directory.
;
; The three-way answer `readFile` cannot give, because it reports all
; three - and an empty file - as "". A caller that must distinguish
; "the file is empty" from "there is no file" asks this first.
(pub :: readErrno (-> String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (readErrno path)
  (sysReadErrno (ioPath path)))

; Create the directory `path`, mode 0755. Answers `(Ok 0)`, or
; `(Err …)` carrying the errno - `EEXIST` when it is already there.
(pub :: makeDir (-> String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (makeDir path)
  (ioResult (sysMkdir (ioPath path) sysDirMode) "makeDir" path))

; Create the directory `path` with the permission bits `mode`, such as
; 448 (0700) for a directory only its owner may enter. Answers `(Ok 0)`,
; or `(Err e)`.
(pub :: makeDirMode (-> String Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (makeDirMode path mode)
  (ioResult (sysMkdir (ioPath path) mode) "makeDirMode" path))

; Create `path` and every missing directory above it. Answers `(Ok 0)`,
; or `(Err …)` carrying the errno of the first component that could not be made.
;
; An existing directory is SUCCESS at every level, which is the whole
; difference from `makeDir` and the reason a build can call this
; unconditionally instead of testing first - testing first is a race,
; and treating EEXIST as success is not.
(pub :: makeDirAll (-> String (Result Int Error)))
;@axiom:effect(io)
(pub fn (makeDirAll path)
  (ioResult (makeDirAllFrom path 1) "makeDirAll" path))

; From 1, not 0: a leading `/` is the root, which exists and cannot
; be created, and asking to create "" fails with ENOENT.
(:: makeDirAllFrom (-> String Int (Result Int Error)))
;@axiom:effect(io)
(fn (makeDirAllFrom path i)
  (if (>= i (strLen path))
    (makeDirOk path)
    (if (== (strByte path i) 47)
      (let ((rc (makeDirOk (strSlice path 0 i))))
        (if (isErr rc)
          rc
          (makeDirAllFrom path (+ i 1))))
      (makeDirAllFrom path (+ i 1)))))

; `makeDir`, with "it was already there" counted as success.
(:: makeDirOk (-> String (Result Int Error)))
;@axiom:effect(io)
(fn (makeDirOk p)
  (let ((r (makeDir p)))
    (match r
      ((Ok v) (Ok v))
      ; An existing directory is SUCCESS, which is the whole difference
      ; from `makeDir`. The errno is `Error.code` now rather than a
      ; negated return, so the test is a field read instead of
      ; `sysErrno` over a sentinel.
      ((Err e)
        (if (== (errCode e) eExist)
          (Ok 0)
          (Err e))
      ))))

; Remove the EMPTY directory `path`. Answers `(Ok 0)`, or `(Err …)` -
; `ENOTEMPTY` when it still holds entries. Nothing here
; removes a tree: that is a loop over `listDir`, and it is the
; caller's to write, because a library that deletes recursively on
; one call is a library that deletes the wrong subtree once.
(pub :: removeDir (-> String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (removeDir path)
  (ioResult (sysRmdir (ioPath path)) "removeDir" path))

; The entries of the directory `path`, as a Vec of `Str` - sorted by
; byte, with `.` and `..` removed.
;
; An empty Vec means an empty directory OR a path that is not a
; readable directory; `isDir` separates them. That ambiguity is
; introduced HERE and not by the syscall: `Sys.sysReadDir` keeps `.`
; and `..`, so its empty answer can only be failure, and dropping them
; is what costs the distinction. It is dropped anyway, because a
; caller that walks a directory and forgets to skip `..` walks the
; whole filesystem, and that mistake is worse than the one this makes.
;
; SORTED, and that is not a nicety. `readdir` order is the
; filesystem's - unstable across machines, and across runs on the same
; machine after entries are added and removed - so a program that
; lists a directory and prints, hashes or compiles what it finds is
; not reproducible unless something sorts. Doing it here means nothing
; has to remember to.
;
; The sort is an insertion sort, quadratic in the entry count, and
; that is the right shape for a directory: it is one pass for an
; already-ordered listing (which is what most filesystems hand back),
; it needs no scratch allocation, and `Vec` has no comparison sort to
; borrow. A directory large enough to notice wants `Sys.sysReadDir`
; and its own ordering.
(pub :: listDir (-> String (Vec String)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (listDir path)
  (let (
    (raw (sysReadDir (ioPath path)))
    (out vecNew)
  )
    {
      (listDirKeep raw 0 out)
      out
    }))

; `Vec::vecLen` is QUALIFIED in the two functions below, where every
; other call in this module is bare. An entry file that declares its
; own `vecLen` captures a bare `vecLen` in an imported module - at
; check time and at run time: `(listDir "/")` answered no entries under
; an entry-file `(fn (vecLen z) 0)`, and 22 without it. The
; fixtures that pin a `for` loop's hygiene declare exactly that
; function (`tests/stdlib/466-for-loop.ax`,
; `tests/diagnostics/626-for-not-a-container.ax`), and with these
; vectors typed `(Vec String)` the capture stopped type-checking. The
; qualified spelling names the one this module means.
(:: listDirKeep (-> (Vec String) Int (Vec String) Int))
(fn (listDirKeep raw i out)
  (if (>= i (Vec::vecLen raw))
    0
    (let ((name (vecGet raw i)))
      {
        (if (|| (strEq name ".") (strEq name ".."))
          0
          (listDirInsert out name))
        (listDirKeep raw (+ i 1) out)
      })))

; Push, then bubble the new entry down to where it belongs. The Vec
; below it is already sorted, so this settles in one comparison when
; the listing arrives in order.
(:: listDirInsert (-> (Vec String) String Int))
(fn (listDirInsert v s)
  {
    (vecPush v s)
    (listDirSift v (- (Vec::vecLen v) 1))
  })

(:: listDirSift (-> (Vec String) Int Int))
(fn (listDirSift v i)
  (if (<= i 0)
    0
    (let (
      (a (vecGet v (- i 1)))
      (b (vecGet v i))
    )
      (if (<= (strCmp a b) 0)
        0
        {
          (vecSet v (- i 1) b)
          (vecSet v i a)
          (listDirSift v (- i 1))
        }))))

; The process's working directory as an absolute path: `(Ok path)`, or
; `(Err e)` whose code is the errno. See `Sys.sysGetCwd` for why this
; is two different syscalls underneath, and why it stopped answering
; `""` for every distinct reason it can fail.
;
; This forwards rather than going through `ioResult`, and that is not
; an oversight: `ioResult` exists to put the PATH into the message, and
; this call takes no path. `Sys` has already named the operation.
(pub :: cwd (Result String Error))
;@axiom:effect(io)
(pub fn (cwd)
  sysGetCwd)

; ------------------------------------------------------------------
; Process exit
; ------------------------------------------------------------------
(pub :: exit (-> Int Int))
;@axiom:effect(io)
(pub fn (exit code)
  (sysExitWith code))

; Print `s` to standard error and exit with `code`. Never returns.
(pub :: die (-> String Int Int))
;@axiom:effect(io)
(pub fn (die s code)
  ; `s` is already a String and its type is DECLARED, so the macro's
  ; `show` resolves to the identity instance; this is an ordinary
  ; `(eprintln s)` and not a special case.
  {
    (eprintln s)
    (exit code)
  })

; ------------------------------------------------------------------
; A hole with a name.
;
; `(todo "Rect")` types as ANY result and never returns: it prints
; `todo: Rect` to standard error and exits 70, `die`'s shape, so a
; match arm, a branch or a body can be left unwritten without lying
; about its type, and the program says where it stopped. `(-> String
; a)` is the result-only signature AX3040 refuses elsewhere; it is
; admitted here for the reason tests/selfhost/976-diverging-tyvar.ax
; records: the tail is a `cast` of a call that never returns, and a
; value nobody is resumed to read is not fabricated (typecheck.ax
; `divTailOk`).
;
; This is what AX3005's quickfix writes into every arm it inserts -
; `((Rect _ _) (todo "Rect"))` - and it performs IO, so the function
; holding that arm must carry `;@axiom:effect(io)`. That is AX3042,
; whose quickfix writes exactly that line: in an editor the two chain,
; fill the match, then declare the effect.
;
; WRITTEN WITH `writeStr` AND `exit`, NOT `die`, and the reason is a
; measurement. `die`'s effect row is an UPPER BOUND in the checker's
; table (`symbols` prints `#effects-overapprox` on it - the `show` its
; `eprintln` expands to is a trait dispatch, which the walk cannot
; pin), and AX3042 does not accuse a caller on an upper bound. A
; `todo` routed through `die` inherited the marker, and an untagged
; function holding a `(todo ...)` arm checked CLEAN - the chain above
; never started. The two primitives below carry exact rows, so this
; one does too.
; ------------------------------------------------------------------
; Exit 70 with `todo: <what>` on standard error; types as any result and never returns.
(pub :: todo (-> String a))
;@axiom:effect(io)
(pub fn (todo what)
  (cast a {
    (writeStr stderr (concat (concat "todo: " what) "\n"))
    (exit 70)
  }))

; ------------------------------------------------------------------
; Reading input.
;
; `IO` could write to a descriptor and read a file by name, and until
; 2026-09-04 could not read from a descriptor at all - `(readLine
; stdin)` was not a call this library had, and a program that wanted a
; line typed at it re-derived the REPL's private byte loop. The two
; readers below are the `Sys` twins named for the caller, on the rule
; `writeStr`/`sysWriteAllFd` and `readFile`/`sysReadFile` already
; follow: the loop, the buffering decision and its measurement live
; once in `Sys.sysReadLineFd`/`Sys.sysReadAllFd`, and this layer adds
; the descriptor to the failure's message, as `ioResult` adds the
; path.
;
; They take the descriptor the way `writeStr` does - `(readLine
; stdin)`, `(readLine fd)` for one `sysOpenPath` answered - and they
; answer `Result` with end of input inside the `Ok`, for the reason
; `Sys` states at length: a read that FAILS is not an input that
; ENDED, and a stream cannot be asked `readErrno` afterwards.
; ------------------------------------------------------------------
; One line of `fd` without its newline: `(Ok (Some line))`; `(Ok None)`
; at end of input when nothing was read; `(Err e)` whose code is the
; errno, its message `readLine: fd 0: errno 9`.
;
; A final line with no newline is still a line, and an empty line is
; `(Some "")`. One `read(2)` per byte, so the descriptor is left at
; exactly the next unread byte - a child handed it, or a `readAll`
; after it, starts where this stopped. See `Sys.sysReadLineFd` for the
; cost of that on bulk input and what to use instead.
(pub :: readLine (-> Int (Result (Option String) Error)))
;@axiom:effect(io)
(pub fn (readLine fd)
  (match (sysReadLineFd fd)
    ((Ok line) (Ok line))
    ((Err e) (Err (ioFdError (errCode e) "readLine" fd)))))

; Everything left on `fd` to end of input: `(Ok s)`, `(Ok "")` when
; nothing arrived, or `(Err e)` whose code is the errno.
;
; On an exhausted descriptor this is `(Ok "")`, which is not a
; failure: the stream ended, as it was going to.
(pub :: readAll (-> Int (Result String Error)))
;@axiom:effect(io)
(pub fn (readAll fd)
  (match (sysReadAllFd fd)
    ((Ok s) (Ok s))
    ((Err e) (Err (ioFdError (errCode e) "readAll" fd)))))

; `ioResult`'s message with the descriptor where the path would be:
; `readLine: fd 0: errno 9`. The code is carried through unchanged.
(:: ioFdError (-> Int String Int Error))
(fn (ioFdError code op fd)
  (mkError code (concat (concat (concat op ": fd ") (fmtInt fd)) (concat ": errno " (fmtInt code)))))

; One `read(2)` of at most `count` bytes from `fd` into the bytes of
; `buf` that start at byte `at`: `(Ok n)` with `n` the bytes read, `(Ok
; 0)` at end of input, or `(Err e)` whose code is the errno.
;
; This is the reader for a program that keeps its own buffer: a
; `String` from `strAlloc`, filled a piece at a time. The range is
; checked before the call, and one outside `buf` stops the program
; with status 77, so the kernel only ever writes bytes `buf` holds.
; Use ReadBuffer for safe mutable storage, or readAll and readLine for
; a fresh string. A String may also be an immutable shared view.
(pub :: readInto (-> Int String Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (readInto fd buf at count)
  (if (ioOutside buf at count)
    __indexTrap
    (sysReadFd fd (+ (strData buf) at) count)))

; Mutable input storage. The constructor and backing string stay private,
; so safe code cannot alias an immutable String as a writable buffer.
(pub struct ReadBuffer sealed
  (bytes : String))

; Allocate a zeroed input buffer of n bytes. A negative size traps 77.
(pub :: readBufferNew (-> Int ReadBuffer))
(pub fn (readBufferNew n)
  (if (< n 0) __indexTrap (ReadBuffer (strAlloc n))))

; The buffer's capacity, in bytes.
(pub :: readBufferLen (-> ReadBuffer Int))
(pub fn (readBufferLen buf) (strLen buf.bytes))

; Read one byte, with the same bounds check as strByte.
(pub :: readBufferByte (-> ReadBuffer Int Int))
(pub fn (readBufferByte buf at) (strByte buf.bytes at))

; Copy a checked range into an immutable String. Later reads into the
; buffer do not change the returned bytes.
(pub :: readBufferText (-> ReadBuffer Int Int String))
(pub fn (readBufferText buf at count)
  (if (ioOutside buf.bytes at count)
    __indexTrap
    (strDup (strSlice buf.bytes at count))))

; Read at most count bytes into a checked buffer range, returning the
; count or the OS error. Zero is EOF. ReadBuffer cannot be captured by
; a parallel binding; its bytes are used by one binding at a time.
(pub :: readBuffer (-> Int ReadBuffer Int Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (readBuffer fd buf at count)
  (readInto fd buf.bytes at count))

; ------------------------------------------------------------------
; Entropy
; ------------------------------------------------------------------
; `n` bytes of kernel entropy as a fresh string: `(Ok bytes)`, or
; `(Err e)` whose code is the errno. The bytes are for keys, nonces
; and seeds; `strByte` reads them one at a time. A negative `n` stops
; the program with status 77.
(pub :: randomBytes (-> Int (Result String Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(entropy)
(pub fn (randomBytes n)
  (if (< n 0)
    __indexTrap
    (let ((s (strAlloc n)))
      (match (sysRandomBytes (strData s) n)
        ((Ok _) (Ok s))
        ((Err e) (Err e))))))

; ------------------------------------------------------------------
; Terminals
;
; A terminal's saved state lives in a `TermState`, which only this
; module builds or opens: the bytes the kernel wrote are never handed
; back as an address, so nothing can aim a restore at the wrong
; memory. `Tui.Term` is the line editor built on the same calls.
; ------------------------------------------------------------------
; A descriptor and the terminal attributes saved from it.
(struct TermState
  (fd : Int)
  (save : Int))

; A terminal's size in character cells. A terminal that was never
; sized reports 0 for both; treat 0 as unknown and fall back to 80x24.
(pub struct TermSize
  (rows : Int)
  (cols : Int))

; The attributes of the terminal on `fd`, saved: `(Ok state)` to hand
; to `termRestore` later, or `(Err e)` - ENOTTY when `fd` is not a
; terminal.
(pub :: termSave (-> Int (Result TermState Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (termSave fd)
  (let ((st (TermState fd (memAlloc (ioTermStateCap)))))
    (ioTermAnswer (sysTermSave fd st.save) st "termSave")))

; Put the terminal on `fd` into raw mode, saving what it was first:
; `(Ok state)` to restore it with, or `(Err e)`. With `keepSignals`
; true, ^C still raises SIGINT; see `Sys.sysTermRaw` for every flag
; raw mode changes.
(pub :: termRaw (-> Int Bool (Result TermState Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (termRaw fd keepSignals)
  (let ((st (TermState fd (memAlloc (ioTermStateCap)))))
    (ioTermAnswer
      (sysTermRaw
        fd
        st.save
        (if keepSignals
          1
          0))
      st
      "termRaw")))

; Put back the attributes `st` saved, on the descriptor they came from:
; `(Ok 0)`, or `(Err e)`.
(pub :: termRestore (-> TermState (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (termRestore st)
  (sysResult "termRestore" (sysTermRestore st.fd st.save)))

; The size of the terminal on `fd`: `(Ok size)`, or `(Err e)` - ENOTTY
; when `fd` is not a terminal.
(pub :: termSize (-> Int (Result TermSize Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (termSize fd)
  (let ((ws (memAlloc sysTermSizeBytes)))
    (let ((rc (sysTermSize fd ws)))
      (if (< rc 0)
        (Err (mkError (- 0 rc) "termSize"))
        (Ok (TermSize (sysTermRows ws) (sysTermCols ws)))))))

; The saved state's size, never 0: a target with no terminal control
; answers `sysTermStateBytes` 0, and its calls never touch the block.
(:: ioTermStateCap Int)
(fn (ioTermStateCap)
  (if (< sysTermStateBytes 8)
    8
    sysTermStateBytes))

(:: ioTermAnswer (-> Int TermState String (Result TermState Error)))
(fn (ioTermAnswer rc st op)
  (if (< rc 0)
    (Err (mkError (- 0 rc) op))
    (Ok st)))

; An owned file. Aliases share its lifetime; the last owner closes it.
; Explicit `fileClose` closes it early for every alias.
(pub struct File sealed
  (owner : Handle))

(:: fileDrop (-> Int Int))
;@axiom:effect(io)
(fn (fileDrop fd)
  (match (sysCloseFd fd)
    ((Ok n) n)
    ((Err e) (- 0 (errCode e)))))

; Transfer ownership of one descriptor into a File.
(pub :: fileFromFd (-> Int File))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`fd` is an open non-negative descriptor, transferred exactly once; callers must not close it or make another owner)
(pub fn (fileFromFd fd)
  (File (__resource_new fileDrop fd)))

; Borrow the descriptor for readiness calls. Keep its owner live and
; do not close the descriptor; use `fileClose` to close its owner.
(pub :: fileFd (-> File Int))
;@axiom:effect(unsafe)
(pub fn (fileFd f)
  (__resource_get f.owner))

; Close early, once. Aliases observe the close; dropping them is safe.
; The descriptor is retired before close and close is never retried.
(pub :: fileClose (-> File (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (fileClose f)
  (sysResult "fileClose" (__resource_close f.owner)))

; Read a line, preserving EOF as None and failures as Err.
(pub :: fileReadLine (-> File (Result (Option String) Error)))
;@axiom:effect(io)
(pub fn (fileReadLine f)
  (readLine (fileFd f)))

; Read the remaining bytes from a file.
(pub :: fileReadAll (-> File (Result String Error)))
;@axiom:effect(io)
(pub fn (fileReadAll f)
  (readAll (fileFd f)))

; Read into a checked slice of a string buffer.
(pub :: fileReadInto (-> File String Int Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (fileReadInto f buf at count)
  (readInto (fileFd f) buf at count))

; Read into a private mutable buffer, preserving errors and EOF.
(pub :: fileReadBuffer (-> File ReadBuffer Int Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (fileReadBuffer f buf at count)
  (readBuffer (fileFd f) buf at count))

; Write every byte, preserving errors in the result.
(pub :: fileWrite (-> File String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (fileWrite f s)
  (sysResult "fileWrite" (sysWriteAllFd (fileFd f) (strData s) (strLen s) 0)))
