;;! IO - files, standard streams, terminals, readiness and sockets.
;
; Every descriptor a program can reach is held by an owner this module
; declares: a `File` (a file, a socket or a standard stream), a `Poller`
; or a `TermGuard`. Each is sealed, so no other module can build one or
; read the number inside it, and each releases its descriptor when its
; last share goes. The descriptor calls themselves are private here,
; over `__syscallN` and the numbers `Sys.Platform` carries, so no public
; function takes or answers a descriptor number. A closed owner traps 85
; on its next use, before a number the kernel has reused can reach
; another resource.
;
; Functions that touch the outside world carry `;@axiom:effect(io)`, and
; the compiler validates those claims against the syscalls actually
; reachable from each body - transitively, by fixpoint - so an
; `io`-tagged function that stopped doing I/O is refused (`AX3010`).
(import Sys)
(import Err)
(import Internal.Raw)
(import Internal.SocketAddress)
(import Internal.WindowsLiveness)
(import Str)
(import Vec)
(import Fmt)

; The printing macros expand to `show`, so `IO` is where a program
; picks up the `Show` instances by importing one module rather than
; two. `Show` does not import `IO` - rendering has no effects and
; must not acquire one - so the edge is one-way.
; ------------------------------------------------------------------
; Owned files
; ------------------------------------------------------------------
; Constructed once, before publication. Only the Windows runtime's
; atomic helpers read or retire this word; Axiom never mutates it.
(struct FileMarker
  (alive : Int))

(struct MarkerSlot
  (mut marker : (Option FileMarker)))

;; An open file, socket or standard stream. Aliases share it; the last
;; share closes the descriptor, and `fileClose` closes it early for
;; every alias.
(pub struct File sealed
  (owner : Handle)
  (marker : (Option FileMarker)))

; The release of an owned descriptor: close it.
(:: fileDrop (-> Int Int))
;@axiom:effect(io)
(fn (fileDrop fd)
  (ioClose fd))

; The release of a standard stream: nothing. Descriptors 0, 1 and 2
; belong to the process, and no `File` closes them.
(:: fileKeep (-> Int Int))
(fn (fileKeep fd)
  0)

; Windows pollers keep the marker, never the owner. The resource owns
; this callback and its captured marker until cleanup has retired the
; marker before closing the descriptor. Standard streams retire their
; File value while leaving the process's underlying handle open.
(:: ioFile (-> Int Bool File))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioFile fd keep)
  (if (== usesSyscallAbi 1)
    (File
      :owner
        (__resource_new
          (if keep
            fileKeep
            fileDrop)
          fd)
      :marker None)
    {
      (let marker (FileMarker :alive 1))
      (File
        :owner
          (__resource_new
            (lambda (h)
              {
                (let _ (windowsMarkerRetire (as marker Int)))
                (if keep
                  0
                  (ioClose h))
              }
            )
            fd)
        :marker (Some marker))
    }))

; Take over `fd`, an open descriptor nothing else owns. Private: every
; descriptor this module opens comes through here, and nothing outside
; can hand it a number.
(:: ioAdopt (-> Int File))
;@axiom:effect(io)
;@axiom:pre((>= fd 0))
(fn (ioAdopt fd)
  (ioFile fd false))

; The descriptor `f` owns, for one call. Traps 85 once `f` is closed.
(:: ioFd (-> File Int))
;@axiom:effect(unsafe)
(fn (ioFd f)
  (__resource_get f.owner))

;; The process's standard input as a `File`. Like `stdout` and
;; `stderr`, it never closes its descriptor: `fileClose stdin` retires
;; that one value and leaves the process's stream open.
(pub :: stdin File)
;@axiom:effect(io)
(pub fn (stdin)
  (ioFile 0 true))

;; The process's standard output as a `File`, for `fileWrite` and
;; friends. One shared owner: it is never closed by scope.
(pub :: stdout File)
;@axiom:effect(io)
(pub fn (stdout)
  (ioFile 1 true))

;; The process's standard error as a `File`. One shared owner: it is
;; never closed by scope.
(pub :: stderr File)
;@axiom:effect(io)
(pub fn (stderr)
  (ioFile 2 true))

;; The path of the null device, for `openPath`: `/dev/null`, or `NUL`
;; on Windows. A read from it is at the end of the file at once, a write
;; to it keeps nothing, and it is never a terminal.
(pub :: nullDevice String)
;@axiom:effect(pure)
(pub fn (nullDevice)
  platformNullPath)

;; Close early, once: `(Ok 0)`, or `(Err e)` carrying the errno of the
;; close - on a written file, where a deferred write error surfaces.
;; Aliases observe the close, and any later use of one traps 85. The
;; descriptor is retired before the close and the close is never
;; retried. Closing a standard stream retires that value only.
(pub :: fileClose (-> File (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (fileClose f)
  (sysResult "fileClose" (__resource_close f.owner)))

; ------------------------------------------------------------------
; The descriptor calls. Private: each takes a number this module holds
; through an owner, or one it opened and closes within the call.
; ------------------------------------------------------------------
; write(2): bytes written, possibly fewer than asked, or `-errno`.
(:: ioWriteFd (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioWriteFd fd buf count)
  (if (== usesSyscallAbi 1)
    (__syscall3 sysWriteNum fd buf count)
    (match (platformWriteFd fd buf count)
      ((Ok n) n)
      ((Err e) (- 0 (errCode e))))))

; Write all `count` bytes at `buf` to `fd`: bytes written, or `-errno`.
;
; A single `write` may transfer fewer bytes than asked - a pipe whose
; buffer filled, a signal arriving mid-call - so this loops until every
; byte is out, and retries EINTR (4 on each syscall target), which moved
; no bytes. A write that answers 0 is not progress, so that case answers
; `-errShortWrite`, a code no errno can be. The success path builds no
; block (`scripts/check-unboxed-sums.sh`).
(:: ioWriteAll (-> Int Int Int Int))
;@axiom:effect(io)
(fn (ioWriteAll fd buf count)
  (ioWriteAllFrom fd buf count 0))

(:: ioWriteAllFrom (-> Int Int Int Int Int))
;@axiom:effect(io)
(fn (ioWriteAllFrom fd buf count done)
  (if (>= done count)
    done
    {
      (let n (ioWriteFd fd (+ buf done) (- count done)))
      (if (== n (- 0 4))
          (ioWriteAllFrom fd buf count done)
        (< n 0)
          n
        (== n 0)
          (- 0 errShortWrite)
        (ioWriteAllFrom fd buf count (+ done n)))
    }))

; read(2): bytes read, 0 at end of input, or `-errno`.
(:: ioReadFd (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioReadFd fd buf count)
  (if (== usesSyscallAbi 1)
    (__syscall3 sysReadNum fd buf count)
    (match (platformReadFd fd buf count)
      ((Ok n) n)
      ((Err e) (- 0 (errCode e))))))

; close(2): 0, or `-errno`.
(:: ioClose (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioClose fd)
  (if (== usesSyscallAbi 1)
    (__syscall1 sysCloseNum fd)
    (platformClose fd)))

; fcntl(fd, cmd, arg): the answer, or `-errno`.
(:: ioFcntl (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioFcntl fd cmd arg)
  (__syscall3 sysFcntlNum fd cmd arg))

; ------------------------------------------------------------------
; Kinds of failure
; ------------------------------------------------------------------
;; What went wrong, in words that mean the same on every target. An
;; `Error`'s code is the kernel's errno, and those numbers differ: EAGAIN
;; is 11 on Linux and 35 on Darwin. Match on `(errorKind e)` instead of a
;; number. The names are `std::io::ErrorKind`'s.
(pub data ErrorKind
  (NotFound)
  (PermissionDenied)
  (ConnectionRefused)
  (ConnectionReset)
  (HostUnreachable)
  (NetworkUnreachable)
  (ConnectionAborted)
  (NotConnected)
  (AddrInUse)
  (AddrNotAvailable)
  (NetworkDown)
  (BrokenPipe)
  (AlreadyExists)
  (WouldBlock)
  (InvalidInput)
  (InvalidData)
  (TimedOut)
  (Interrupted)
  (Unsupported)
  (UnexpectedEof)
  (OutOfMemory)
  (Other))

;; The kind of failure `e` reports. Errno numbers that are the same on
;; every target are written here; the rest come from `Sys.Platform`. The
;; library's own `errUnexpectedEof` and `errInvalidData` have kinds too,
;; and any other code, including a program's own, is `Other`.
(pub :: errorKind (-> Error ErrorKind))
(pub fn (errorKind e)
  {
    (let c (errCode e))
    (if (== c 2)
        NotFound
      (|| (== c 1) (== c 13))
        PermissionDenied
      (== c eConnRefused)
        ConnectionRefused
      (== c eConnReset)
        ConnectionReset
      (== c eHostUnreach)
        HostUnreachable
      (== c eNetUnreach)
        NetworkUnreachable
      (== c eConnAborted)
        ConnectionAborted
      (== c eNotConn)
        NotConnected
      (== c eAddrInUse)
        AddrInUse
      (== c eAddrNotAvail)
        AddrNotAvailable
      (== c eNetDown)
        NetworkDown
      (== c 32)
        BrokenPipe
      (== c eExist)
        AlreadyExists
      (== c eAgain)
        WouldBlock
      (== c 22)
        InvalidInput
      (== c errInvalidData)
        InvalidData
      (== c eTimedOut)
        TimedOut
      (== c 4)
        Interrupted
      (|| (== c eNoSys) (== c eOpNotSupp))
        Unsupported
      (== c errUnexpectedEof)
        UnexpectedEof
      (== c 12)
        OutOfMemory
      Other)
  })

; ------------------------------------------------------------------
; Writing
; ------------------------------------------------------------------
;; Write all of `s` to `f`, returning the number of bytes written or a
;; negative errno. This is the printing path's answer: `println` is
;; `(writeStr stdout ...)`, and a statement that prints does not have to
;; bind a `Result`. `fileWrite` answers the same write as a `Result`.
(pub :: writeStr (-> File String Int))
;@axiom:effect(io)
(pub fn (writeStr f s)
  (ioWriteAll (ioFd f) (strData s) (strLen s)))

;; Write the `len` bytes of `s` that start at byte `start`, all of them,
;; returning the number written or a negative errno - `writeStr` over a
;; part of a string, with no copy.
;
; The range is checked before anything is written: a `start` or `len`
; that is negative, or one that runs past the end of `s`, stops the
; program with status 77, the index trap `vecGet` raises. The kernel
; is only ever handed bytes `s` holds.
(pub :: writeSlice (-> File String Int Int Int))
;@axiom:effect(io)
(pub fn (writeSlice f s start len)
  (if (ioOutside s start len)
    __indexTrap
    (ioWriteAll (ioFd f) (+ (strData s) start) len)))

;; Write all of `s` to standard output, or to standard error: the bytes
;; written, or a negative errno. `println` and `eprintln` are these with
;; the line built at expansion time. They make no `File`, so printing
;; allocates nothing on the way out; `(writeStr stdout s)` is the same
;; write through a `File`.
(pub :: writeOut (-> String Int))
;@axiom:effect(io)
(pub fn (writeOut s)
  (ioWriteAll 1 (strData s) (strLen s)))

;; Write `s` to standard error, with no newline added. Answers the
;; number of bytes written.
(pub :: writeErr (-> String Int))
;@axiom:effect(io)
(pub fn (writeErr s)
  (ioWriteAll 2 (strData s) (strLen s)))

;; Write every byte of `s` to `f`: `(Ok n)`, or `(Err e)` whose code is
;; the errno of the write that failed.
(pub :: fileWrite (-> File String (Result Int Error)))
;@axiom:effect(io)
(pub fn (fileWrite f s)
  (sysResult "fileWrite" (writeStr f s)))

; True when `[start, start + len)` is not inside `s`. Written so that no
; sum can overflow: `start` is known to be in range before `len` is
; compared with what is left after it.
(:: ioOutside (-> String Int Int Bool))
(fn (ioOutside s start len)
  (if (< start 0)
    true
    (if (< len 0)
      true
      (if (> start (strLen s))
        true
        (> len (- (strLen s) start))))))

; ------------------------------------------------------------------
; Printing is macros and no functions.
;
; `writeStr` above is the whole runtime side: bytes, to a file.
; Everything between a value and those bytes is decided at expansion
; time, so this module exports no `printInt`, no `printFloat`, and no
; per-type anything - a type is rendered by the rendering the checker
; selects from its static type, and a width or a radix is chosen by a
; format specifier rather than by picking a different function to call.
;
; One parameter each. A hole names a binding at the call:
;
;   (println "hello, {name}")
;   (println "{done:>4}/{total} done")
;   (eprintln "{file}:{line}: {msg}")
;
; so the argument count never depends on the number of holes.
; `syntax/format` does the parse; see docs/macro-system.md MAC-CAP-10
; for the grammar, the lowering and the refusals. Given anything that
; is not a literal, `syntax/format` answers one rendering call on it, so
; `(println n)` prints an `Int` and `(println s)` a `String`.
;
; `syntax/formatln` folds the newline into the last literal run at
; expansion time, so `(println "hi")` is one `write` of `"hi\n"`, with
; no allocation. A program that wants bytes with no newline and no
; rendering calls `writeOut`, or `writeStr` on a `File`.
; ------------------------------------------------------------------
;; Print to standard output with a newline. A string literal's
;; `{name}` holes interpolate the bindings they name, as in
;; `(println "hello, {name}")`; any other argument is rendered, so
;; `(println n)` prints an `Int`.
(pub macro (println e) (writeOut (syntax/formatln e)))

;; Print to standard error with a newline, with the same holes as
;; `println`.
(pub macro (eprintln e) (writeErr (syntax/formatln e)))

; ------------------------------------------------------------------
; The descriptor calls behind the path functions.
;
; Private. Each takes a NUL-terminated path address that `ioPath` made
; from a `String`, and answers the raw kernel result: a descriptor or a
; count, or `-errno`. AArch64 Linux has only the `*at` forms, so the
; path calls branch on the `openNeedsDirFd` capability.
; ------------------------------------------------------------------
; open(path, flags, mode). A mode of 0 with `O_CREAT` would create a
; file nobody can read back, which is why `ioOpen` passes 0644.
(:: ioOpenMode (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioOpenMode path flags mode)
  (if (== usesSyscallAbi 0)
      (platformOpen path flags mode)
    (== openNeedsDirFd 1)
      (__syscall4 sysOpenNum atFdCwd path flags mode)
    (__syscall3 sysOpenNum path flags mode)))

(:: ioOpen (-> Int Int Int))
;@axiom:effect(io)
(fn (ioOpen path flags)
  (ioOpenMode path flags 420))

; lseek(fd, offset, whence): the resulting absolute offset, or `-errno`.
(:: ioSeek (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioSeek fd offset whence)
  (if (== usesSyscallAbi 1)
    (__syscall3 sysLseekNum fd offset whence)
    (platformSeek fd offset whence)))

; Close a descriptor this module opened for one call, ignoring the
; answer: the bytes are already in hand, and there is nothing to do
; with a failed close of a read-only descriptor.
(:: ioCloseQuiet (-> Int Int))
;@axiom:effect(io)
(fn (ioCloseQuiet fd)
  {
    (let _ (ioClose fd))
    0
  })

; `path` as a `char*` a syscall can take, always by copy. A `strSlice`
; shares storage and is not NUL-terminated, so handing one to `open`
; would read past its end into whatever the parent string holds.
(:: ioPath (-> String Int))
(fn (ioPath path)
  (strCStr (strDup path)))

; ------------------------------------------------------------------
; Reading
; ------------------------------------------------------------------
;; The whole contents of the file at `path`: `(Ok text)`, or `(Err e)`
;; whose code is the errno, its message `readFile: PATH: errno N`. A
;; missing file is ENOENT, 2, and a directory is EISDIR, 21. An empty
;; file is `(Ok "")`.
;
; The read starts at 64 KiB and doubles, so a file of any size arrives
; whole. A directory opens on Darwin and Linux alike and fails at the
; first `read`, which is where its EISDIR comes from.
(pub :: readFile (-> String (Result String Error)))
;@axiom:effect(io)
(pub fn (readFile path)
  {
    (let fd (ioOpen (ioPath path) oRdonly))
    (if (< fd 0)
      (Err (ioPathError "readFile" path (- 0 fd)))
      {
        (let r (ioReadAllFd fd))
        {
          (ioCloseQuiet fd)
          (match r
            ((Ok text) (Ok text))
            ((Err e) (Err (ioPathError "readFile" path (errCode e)))))
        }
      })
  })

; Read `fd` to end of input into `buf`, doubling the buffer whenever it
; fills. `used` bytes hold data; `cap` is the buffer's capacity. A short
; read is retried rather than treated as end of input - only 0 ends the
; loop with `Ok` - so a pipe delivers its whole stream too. A `read`
; that fails ends the loop with `Err`, and what had arrived before it is
; dropped rather than answered as a shorter stream.
(:: ioReadAll (-> Int String Int Int (Result String Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioReadAll fd buf used cap)
  {
    (let n (ioReadFd fd (+ (strData buf) used) (- cap used)))
    (if (< n 0)
      (Err (mkError (- 0 n) "readAll"))
      (if (== n 0)
        (if (== used 0)
          (Ok "")
          ; A second header naming `buf`'s owner takes a second share
          ; (memory-model.md MM-VAL-7).
          {
            (let own (strOwner buf))
            {
              (__retain own)
              (Ok (rawStrWrapOwned (strData buf) used own))
            }
          })
        {
          (let used2 (+ used n))
          (if (< used2 cap)
            (ioReadAll fd buf used2 cap)
            {
              (let big (strAlloc (* cap 2)))
              {
                (rawCopy (strData big) (strData buf) used2)
                (ioReadAll fd big used2 (* cap 2))
              }
            })
        }))
  })

(:: ioReadAllFd (-> Int (Result String Error)))
;@axiom:effect(io)
(fn (ioReadAllFd fd)
  (ioReadAll fd (strAlloc 65536) 0 65536))

; One line of `fd`, one `read(2)` per byte, so the descriptor is left at
; exactly the next unread byte. The buffer starts at 128 bytes and
; doubles; the newline is overwritten with NUL. A `while` and not a self
; call: the loop runs once per byte.
(:: ioReadLineFd (-> Int (Result (Option String) Error)))
;@axiom:effect(io)
(fn (ioReadLineFd fd)
  ; the last `read`'s answer: 1 a byte, 0 end of input, -errno
  {
    (let mut buf (strAlloc 128))
    (let mut cap 128)
    (let mut used 0)
    (let mut n 1)
    (let mut done 0)
    {
      (while (== done 0)
        {
          (set n (ioReadFd fd (+ (strData buf) used) 1))
          (if (<= n 0)
            (set done 1)
            (if (== (rawGetByte (strData buf) used) 10)
              {
                (rawPutByte (strData buf) used 0)
                (set done 1)
              }
              {
                (set used (+ used 1))
                ; `strAlloc cap` holds cap+1 bytes, and index `cap` is
                ; the terminator's, so the next byte needs `used < cap`.
                (if (>= used cap)
                  {
                    (let big (strAlloc (* cap 2)))
                    {
                      (rawCopy (strData big) (strData buf) used)
                      (set buf big)
                      (set cap (* cap 2))
                    }
                  })
              }))
        })
      (if (< n 0)
        (Err (mkError (- 0 n) "readLine"))
        (if (&& (== n 0) (== used 0))
          (Ok None)
          (Ok (Some (strSlice buf 0 used)))))
    }
  })

; ------------------------------------------------------------------
; Files and directories, by name.
;
; Each of these answers the question a caller actually has:
;
;   - `fileExists` cannot tell a file from a directory; `isDir` can.
;   - `writeFile` truncates and `appendFile` does not.
;   - `listDir` sorts, so a program that walks a directory produces
;     the same output on two machines.
;   - `makeDirAll` creates the parents, which is what a build writing
;     `build/obj/x.o` means by "make the directory".
; ------------------------------------------------------------------
; The error for `errno` from `op` on `path`: `op: path: errno N`, its
; code the errno.
(:: ioPathError (-> String String Int Error))
(fn (ioPathError op path errno)
  (mkError errno (concat (concat (concat op ": ") (concat path ": errno ")) (fmtInt errno))))

; A raw answer re-wrapped with the path: `op: path: errno N`. The code
; is the errno, unchanged.
(:: ioResult (-> String String Int (Result Int Error)))
(fn (ioResult op path n)
  (if (< n 0)
    (Err (ioPathError op path (- 0 n)))
    (Ok n)))

; Write all of `s` to the file at `cpath`, opened with `flags`: the bytes
; written, or `-errno`.
(:: ioWriteWhole (-> Int Int String Int))
;@axiom:effect(io)
(fn (ioWriteWhole cpath flags s)
  {
    (let fd (ioOpen cpath flags))
    (if (< fd 0)
      fd
      {
        (let n (ioWriteAll fd (strData s) (strLen s)))
        {
          (ioCloseQuiet fd)
          n
        }
      })
  })

;; Write `s` to `path`, creating it or truncating what is there.
;; Answers `(Ok bytes)`, or `(Err e)` whose code is the errno.
(pub :: writeFile (-> String String (Result Int Error)))
;@axiom:effect(io)
(pub fn (writeFile path s)
  (ioResult "writeFile" path (ioWriteWhole (ioPath path) oWronlyCreateTrunc s)))

;; Add `s` to the end of `path`, creating it if absent. Answers
;; `(Ok bytes)`, or `(Err e)` whose code is the errno. `O_APPEND` makes
;; the seek and the write one operation, so two processes appending to
;; one log interleave whole writes.
(pub :: appendFile (-> String String (Result Int Error)))
;@axiom:effect(io)
(pub fn (appendFile path s)
  (ioResult "appendFile" path (ioWriteWhole (ioPath path) oWronlyCreateAppend s)))

;; Remove the file `path`. Answers `(Ok 0)`, or `(Err …)` carrying the
;; errno. It does not remove a directory; that is `removeDir`.
(pub :: removeFile (-> String (Result Int Error)))
;@axiom:effect(io)
(pub fn (removeFile path)
  (ioResult "removeFile" path (ioUnlink (ioPath path))))

; unlink(path), `unlinkat` where only that exists.
(:: ioUnlink (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioUnlink p)
  (if (== usesSyscallAbi 0)
      (platformUnlink p)
    (== openNeedsDirFd 1)
      (__syscall3 sysUnlinkNum atFdCwd p 0)
    (__syscall1 sysUnlinkNum p)))

;; Move `old` to `new`, answering `(Ok 0)` or `(Err …)` with the errno.
;
; Atomic within one filesystem: a reader of `new` sees the whole old
; contents or the whole new ones, never a prefix. Across filesystems
; the kernel refuses with EXDEV (18) and `copyFile` + `removeFile` is
; the fallback, which is not atomic.
(pub :: renamePath (-> String String (Result Int Error)))
;@axiom:effect(io)
(pub fn (renamePath old new)
  (ioResult "renamePath" old (ioRename (ioPath old) (ioPath new))))

; rename(old, new), `renameat` where only that exists.
(:: ioRename (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioRename o n)
  (if (== usesSyscallAbi 0)
      (platformRename o n)
    (== openNeedsDirFd 1)
      (__syscall4 sysRenameNum atFdCwd o atFdCwd n)
    (__syscall2 sysRenameNum o n)))

;; Open `path` with `flags` (`oRdonly`, `oWronlyCreateTrunc`, ...):
;; `(Ok file)`, or `(Err e)` whose code is the errno. New files get mode
;; 0644. The file closes when its last owner leaves scope.
(pub :: openPath (-> String Int (Result File Error)))
;@axiom:effect(io)
(pub fn (openPath path flags)
  (match (ioResult "openPath" path (ioOpen (ioPath path) flags))
    ((Ok fd) (Ok (ioAdopt fd)))
    ((Err e) (Err e))))

;; Copy `src` onto `dst`, answering `(Ok bytes)` or `(Err e)`. `dst` is
;; created or truncated, and left alone when `src` can't be read.
;
; The whole file goes through memory.
(pub :: copyFile (-> String String (Result Int Error)))
;@axiom:effect(io)
(pub fn (copyFile src dst)
  (writeFile dst (readFile src)?))

;; True when `path` names something that can be opened for reading -
;; a directory included. `isDir` separates them.
(pub :: fileExists (-> String Bool))
;@axiom:effect(io)
(pub fn (fileExists path)
  {
    (let fd (ioOpen (ioPath path) oRdonly))
    (if (< fd 0)
      false
      {
        (ioCloseQuiet fd)
        true
      })
  })

;; True when `path` names a directory: one that opens and whose read
;; answers EISDIR. An empty file answers false.
(pub :: isDir (-> String Bool))
;@axiom:effect(io)
(pub fn (isDir path)
  (== (ioReadErrno path) eIsDir))

;; The size of `path` in bytes, or `(Err …)` carrying the errno. It
;; seeks to the end, which is what the size is.
;
; A directory answers a positive number here, the size of the directory
; file rather than anything a caller means; ask `isDir` first if that
; matters.
(pub :: fileSize (-> String (Result Int Error)))
;@axiom:effect(io)
(pub fn (fileSize path)
  (ioResult "fileSize" path
    {
      (let fd (ioOpen (ioPath path) oRdonly))
      (if (< fd 0)
        fd
        {
          (let n (ioSeek fd 0 seekEnd))
          {
            (ioCloseQuiet fd)
            n
          }
        })
    }))

; 0 when `path` can be read as a file, otherwise the errno saying why
; not: 2 missing, 13 not permitted, 21 a directory. Opening separates
; "not there" from "not allowed"; a one-byte read separates a
; directory, because Darwin and Linux both open one and defer EISDIR to
; `read`.
(:: ioReadErrno (-> String Int))
;@axiom:effect(io)
(fn (ioReadErrno path)
  {
    (let fd (ioOpen (ioPath path) oRdonly))
    (if (< fd 0)
      (- 0 fd)
      {
        (let probe (strAlloc 1))
        {
          (let n (ioReadFd fd (strData probe) 1))
          {
            (ioCloseQuiet fd)
            (if (< n 0)
              (- 0 n)
              0)
          }
        }
      })
  })

; 0755, the mode `makeDir` gives a directory.
(:: ioDirMode Int)
(fn (ioDirMode)
  493)

; mkdir(path, mode), `mkdirat` where only that exists.
(:: ioMkdir (-> String Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioMkdir path mode)
  {
    (let p (ioPath path))
    (if (== usesSyscallAbi 0)
        (platformMkdir p mode)
      (== openNeedsDirFd 1)
        (__syscall3 sysMkdirNum atFdCwd p mode)
      (__syscall2 sysMkdirNum p mode))
  })

;; Create the directory `path`, mode 0755. Answers `(Ok 0)`, or
;; `(Err …)` carrying the errno - `EEXIST` when it is already there.
(pub :: makeDir (-> String (Result Int Error)))
;@axiom:effect(io)
(pub fn (makeDir path)
  (ioResult "makeDir" path (ioMkdir path ioDirMode)))

;; Create the directory `path` with the permission bits `mode`, such as
;; 448 (0700) for a directory only its owner may enter. Answers `(Ok 0)`,
;; or `(Err e)`.
(pub :: makeDirMode (-> String Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (makeDirMode path mode)
  (ioResult "makeDirMode" path (ioMkdir path mode)))

;; Create `path` and every missing directory above it. Answers `(Ok 0)`,
;; or `(Err …)` carrying the errno of the first component that could not be made.
;
; An existing directory is success at every level, which is the whole
; difference from `makeDir` and the reason a build can call this
; unconditionally instead of testing first.
(pub :: makeDirAll (-> String (Result Int Error)))
;@axiom:effect(io)
(pub fn (makeDirAll path)
  (match (makeDirAllFrom path 1)
    ((Ok v) (Ok v))
    ((Err e)
      (Err
        (mkError (errCode e)
          (concat (concat "makeDirAll: " path) (concat ": errno " (fmtInt (errCode e))))))
    )))

; From 1, not 0: a leading `/` is the root, which exists and cannot
; be created, and asking to create "" fails with ENOENT.
(:: makeDirAllFrom (-> String Int (Result Int Error)))
;@axiom:effect(io)
(fn (makeDirAllFrom path i)
  (if (>= i (strLen path))
    (makeDirOk path)
    (if (== (strByte path i) 47)
      {
        (let rc (makeDirOk (strSlice path 0 i)))
        (if (isErr rc)
          rc
          (makeDirAllFrom path (+ i 1)))
      }
      (makeDirAllFrom path (+ i 1)))))

; `makeDir`, with "it was already there" counted as success.
(:: makeDirOk (-> String (Result Int Error)))
;@axiom:effect(io)
(fn (makeDirOk p)
  {
    (let r (makeDir p))
    (match r
      ((Ok v) (Ok v))
      ((Err e)
        (if (== (errCode e) eExist)
          (Ok 0)
          (Err e))
      ))
  })

;; Remove the empty directory `path`. Answers `(Ok 0)`, or `(Err …)` -
;; `ENOTEMPTY` when it still holds entries. Nothing here removes a tree:
;; that is a loop over `listDir`, and it is the caller's to write.
;
; `AT_REMOVEDIR` is 512 on Linux, and it is what makes `unlinkat` - the
; only call AArch64 has for either job - remove a directory.
(pub :: removeDir (-> String (Result Int Error)))
;@axiom:effect(io)
(pub fn (removeDir path)
  (ioResult "removeDir" path (ioRmdir (ioPath path))))

(:: ioRmdir (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioRmdir p)
  (if (== usesSyscallAbi 0)
      (platformRmdir p)
    (== openNeedsDirFd 1)
      (__syscall3 sysRmdirNum atFdCwd p 512)
    (__syscall1 sysRmdirNum p)))

; ------------------------------------------------------------------
; Reading a directory.
;
; `getdents64` (Linux) and `getdirentries64` (Darwin) are the only calls
; that enumerate one. Their records differ in exactly one number, where
; the name starts (`direntNameOffset`); `d_reclen` is at offset 16 on
; every target. The name's length comes from the NUL every kernel
; writes, and `d_type` is not read, because filesystems may answer
; DT_UNKNOWN.
; ------------------------------------------------------------------
; Bytes per `getdents` call: a directory of a few hundred entries comes
; back in one syscall, and the loop handles any number.
(:: ioDirBufBytes Int)
(fn (ioDirBufBytes)
  32768)

; Every name in the directory `path`, `.` and `..` included, in the
; filesystem's order, or the errno of the open or the read that failed.
; The open asks for a directory, so a file fails there with ENOTDIR on
; every target; Darwin's `getdirentries` would answer EINVAL instead.
; The names are copied: the syscall's buffer is reused by the next pass.
(:: ioReadDir (-> String (Result (Vec String) Error)))
;@axiom:effect(io)
(fn (ioReadDir path)
  {
    (let fd (ioOpen (ioPath path) (| oRdonly oDirectory)))
    (if (< fd 0)
      (Err (ioPathError "listDir" path (- 0 fd)))
      ; Darwin's fourth argument is an in/out scan cookie the kernel
      ; starts from; zero is the beginning. Linux keeps the position
      ; on the descriptor and never reads it.
      {
        (let out vecNew)
        (let buf (rawAlloc ioDirBufBytes))
        (let pos (rawAlloc 8))
        {
          (rawSetWord pos 0 0)
          {
            (let n (ioReadDirLoop fd buf pos out))
            {
              (ioCloseQuiet fd)
              (if (< n 0)
                (Err (ioPathError "listDir" path (- 0 n)))
                (Ok out))
            }
          }
        }
      })
  })

; One `getdents` per pass until the directory is exhausted (0) or the
; kernel refuses (negative), answering that last result.
(:: ioReadDirLoop (-> Int Int Int (Vec String) Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioReadDirLoop fd buf pos out)
  {
    (let n
      (if (== usesSyscallAbi 0)
          (platformReadDir fd buf ioDirBufBytes)
        (== dirReadNeedsPosition 1)
          (__syscall4 sysGetdentsNum fd buf ioDirBufBytes pos)
        (__syscall3 sysGetdentsNum fd buf ioDirBufBytes)))
    (if (<= n 0)
      n
      {
        (ioReadDirDecode buf 0 n out)
        (ioReadDirLoop fd buf pos out)
      })
  })

; Walk the `n` bytes of packed records at `buf`, pushing one owned copy
; of each name.
;
; Total on any bytes: the header must fit, the record must fit, and the
; record must be long enough to hold the name field, which is also what
; makes it advance. A record that breaks one of the three stops the walk
; rather than reading a name out of bytes the kernel did not write.
(:: ioReadDirDecode (-> Int Int Int (Vec String) Int))
(fn (ioReadDirDecode buf off n out)
  ; 18 is the last byte of `d_reclen` on both layouts.
  (if (> (+ off 18) n)
    0
    ; d_reclen: a little-endian u16 at offset 16.
    {
      (let p (+ buf off))
      {
        (let reclen (+ (rawGetByte p 16) (* (rawGetByte p 17) 256)))
        (if (|| (<= reclen direntNameOffset) (> (+ off reclen) n))
          0
          {
            (vecPush out (strDup (rawStrFromLit (+ p direntNameOffset))))
            (ioReadDirDecode buf (+ off reclen) n out)
          })
      }
    }))

;; The entries of the directory `path`, sorted by byte, with `.` and
;; `..` removed: `(Ok names)`, or `(Err e)` whose code is the errno. A
;; missing path is ENOENT, 2, and a file is ENOTDIR, 20.
;
; `.` and `..` are dropped because a caller that walks a directory and
; forgets to skip `..` walks the whole filesystem.
;
; Sorted, because `readdir` order is the filesystem's and is not stable
; across machines, so a program that lists a directory and prints,
; hashes or compiles what it finds is not reproducible unless something
; sorts. The sort is an insertion sort: one pass for an already-ordered
; listing, and no scratch allocation.
(pub :: listDir (-> String (Result (Vec String) Error)))
;@axiom:effect(io)
(pub fn (listDir path)
  {
    (let raw (ioReadDir path)?)
    (let out vecNew)
    {
      (listDirKeep raw 0 out)
      (Ok out)
    }
  })

; `Vec::vecLen` is qualified in the two functions below, where every
; other call in this module is bare. An entry file that declares its
; own `vecLen` captures a bare `vecLen` in an imported module, and the
; fixtures that pin a `for` loop's hygiene declare exactly that
; function (`tests/stdlib/466-for-loop.ax`,
; `tests/diagnostics/626-for-not-a-container.ax`).
(:: listDirKeep (-> (Vec String) Int (Vec String) Int))
(fn (listDirKeep raw i out)
  (if (>= i (Vec::vecLen raw))
    0
    {
      (let name (vecGet raw i))
      {
        (if (! (|| (strEq name ".") (strEq name "..")))
          (listDirInsert out name))
        (listDirKeep raw (+ i 1) out)
      }
    }))

; Push, then bubble the new entry down to where it belongs. The Vec
; below it is already sorted, so this settles in one comparison when
; the listing arrives in order.
(:: listDirInsert (-> (Vec String) String Int))
(fn (listDirInsert v s)
  {
    (vecPush v s)
    (listDirSift v (- (Vec::vecLen v) 1))
  })

(:: listDirSift (-> (Vec String) Int Int))
(fn (listDirSift v i)
  (if (<= i 0)
    0
    {
      (let a (vecGet v (- i 1)))
      (let b (vecGet v i))
      (if (<= (strCmp a b) 0)
        0
        {
          (vecSet v (- i 1) b)
          (vecSet v i a)
          (listDirSift v (- i 1))
        })
    }))

; ------------------------------------------------------------------
; The working directory.
;
; Two shapes, because Darwin has no `getcwd` syscall: `fcntl(fd,
; F_GETPATH, buf)` on a descriptor for `.` is the way in there, and
; `cwdUsesFcntlPath` picks it. Both answer bytes ending in a NUL, which
; is what the length is read from.
; ------------------------------------------------------------------
;; The process's working directory as an absolute path: `(Ok path)`, or
;; `(Err e)` whose code is the errno.
(pub :: cwd (Result String Error))
;@axiom:effect(io)
(pub fn (cwd)
  ioGetCwd)

(:: ioGetCwd (Result String Error))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioGetCwd)
  ; PATH_MAX is 4096 on Linux and 1024 on Darwin and FreeBSD; one
  ; buffer at the larger figure serves all, and a path too long for it
  ; comes back as ERANGE rather than truncated.
  {
    (let buf (rawAlloc 4097))
    (if (== usesSyscallAbi 0)
        {
          (let rc (platformGetCwd buf 4097))
          (if (< rc 0)
            (Err (mkError (- 0 rc) "getcwd"))
            (Ok (strDup (rawStrFromLit buf))))
        }
      (== cwdUsesFcntlPath 1)
        {
          (let fd (ioOpen (__addr ".") 0))
          (if (< fd 0)
            (Err (mkError (- 0 fd) "getcwd: open ."))
            {
              (let rc (__syscall3 sysCwdNum fd fGetPath buf))
              {
                (ioCloseQuiet fd)
                (if (< rc 0)
                  (Err (mkError (- 0 rc) "getcwd"))
                  (Ok (strDup (rawStrFromLit buf))))
              }
            })
        }
      {
        (let rc (__syscall2 sysCwdNum buf 4096))
        (if (< rc 0)
          (Err (mkError (- 0 rc) "getcwd"))
          (Ok (strDup (rawStrFromLit buf))))
      })
  })

; ------------------------------------------------------------------
; Process exit
; ------------------------------------------------------------------
;; End the process with status `code`, running no further code.
(pub :: exit (-> Int Int))
;@axiom:effect(io)
(pub fn (exit code)
  (sysExitWith code))

;; Print `s` to standard error and exit with `code`. Never returns.
(pub :: die (-> String Int Int))
;@axiom:effect(io)
(pub fn (die s code)
  ; `s` is already a String and its type is declared, so the macro's
  ; `show` resolves to the identity instance.
  {
    (eprintln s)
    (exit code)
  })

; ------------------------------------------------------------------
; A hole with a name.
;
; `(todo "Rect")` types as any result and never returns: it prints
; `todo: Rect` to standard error and exits 70, `die`'s shape, so a
; match arm, a branch or a body can be left unwritten without lying
; about its type, and the program says where it stopped. `(-> String
; a)` is the result-only signature AX3040 refuses elsewhere; it is
; admitted here for the reason tests/selfhost/976-diverging-tyvar.ax
; records: the tail is a `cast` of a call that never returns, and a
; value nobody is resumed to read is not fabricated (typecheck.ax
; `divTailOk`).
;
; This is what AX3005's quickfix writes into every arm it inserts -
; `((Rect _ _) (todo "Rect"))` - and it performs IO, so the function
; holding that arm must carry `;@axiom:effect(io)`. That is AX3042,
; whose quickfix writes exactly that line.
;
; Written with `writeStr` and `exit`, not `die`: `die`'s effect row is
; an upper bound in the checker's table (the `show` its `eprintln`
; expands to is a trait dispatch), and AX3042 does not accuse a caller
; on an upper bound. The two primitives below carry exact rows, so this
; one does too.
; ------------------------------------------------------------------
;; Exit 70 with `todo: <what>` on standard error; types as any result and never returns.
(pub :: todo (-> String a))
;@axiom:effect(io)
(pub fn (todo what)
  (as {
    (writeErr (concat (concat "todo: " what) "\n"))
    (exit 70)
  } a))

; ------------------------------------------------------------------
; Reading input.
;
; The readers take a `File` - `(readLine stdin)`, or a file `openPath`
; answered - and answer `Result` with end of input inside the `Ok`: a
; read that fails is not an input that ended.
;
; The line reader makes one `read(2)` per byte, so the descriptor is
; left at exactly the next unread byte - a child handed it, or a
; `readAll` after it, starts where this stopped. That is about ninety
; times slower than `readAll` on bulk input, which wants `readAll` and
; `strSplit`, or `Rpc`'s buffered reader.
; ------------------------------------------------------------------
;; One line of `f` without its newline: `(Ok (Some line))`; `(Ok None)`
;; at end of input when nothing was read; `(Err e)` whose code is the
;; errno, its message `readLine: errno 9`.
;
; A final line with no newline is still a line, and an empty line is
; `(Some "")`.
(pub :: readLine (-> File (Result (Option String) Error)))
;@axiom:effect(io)
(pub fn (readLine f)
  (match (ioReadLineFd (ioFd f))
    ((Ok line) (Ok line))
    ((Err e) (Err (ioFdError (errCode e) "readLine")))))

;; Everything left on `f` to end of input: `(Ok s)`, `(Ok "")` when
;; nothing arrived, or `(Err e)` whose code is the errno.
;
; On an exhausted file this is `(Ok "")`, which is not a failure: the
; stream ended, as it was going to.
(pub :: readAll (-> File (Result String Error)))
;@axiom:effect(io)
(pub fn (readAll f)
  (match (ioReadAllFd (ioFd f))
    ((Ok s) (Ok s))
    ((Err e) (Err (ioFdError (errCode e) "readAll")))))

; `op: errno N`. The code is carried through unchanged.
(:: ioFdError (-> Int String Error))
(fn (ioFdError code op)
  (mkError code (concat op (concat ": errno " (fmtInt code)))))

; A raw answer as a `Result`, named for the public call that made it.
(:: ioAnswer (-> String Int (Result Int Error)))
(fn (ioAnswer op n)
  (if (< n 0)
    (Err (ioFdError (- 0 n) op))
    (Ok n)))

;; Mutable input storage. The constructor and backing string stay private,
;; so safe code cannot alias an immutable String as a writable buffer.
;
; It is the only storage a read fills in place. A `String` is a value:
; a literal's bytes are the loader's, and a slice, an alias or a copy
; handed elsewhere shares the bytes of the string it came from. A reader
; that wrote into a caller's `String` changed every one of them, so the
; one that did was removed, and `fileRead` takes a `ReadBuffer`.
(pub struct ReadBuffer sealed
  (bytes : String))

;; Allocate a zeroed input buffer of n bytes. A negative size traps 77.
(pub :: readBufferNew (-> Int ReadBuffer))
(pub fn (readBufferNew n)
  (if (< n 0)
    __indexTrap
    (ReadBuffer :bytes (strAlloc n))))

;; The buffer's capacity, in bytes.
(pub :: readBufferLen (-> ReadBuffer Int))
(pub fn (readBufferLen buf)
  (strLen buf.bytes))

;; Read one byte, with the same bounds check as strByte.
(pub :: readBufferByte (-> ReadBuffer Int Int))
(pub fn (readBufferByte buf at)
  (strByte buf.bytes at))

;; Copy a checked range into an immutable String. Later reads into the
;; buffer do not change the returned bytes.
(pub :: readBufferText (-> ReadBuffer Int Int String))
(pub fn (readBufferText buf at count)
  (if (ioOutside buf.bytes at count)
    __indexTrap
    (strDup (strSlice buf.bytes at count))))

;; Copy `text` into `buf` from byte `at`, answering how many bytes it
;; copied, `strLen text`. A range outside `buf` stops the program with
;; status 77, as `fileRead`'s does.
(pub :: readBufferPut (-> ReadBuffer Int String Int))
(pub fn (readBufferPut buf at text)
  {
    (let n (strLen text))
    (if (ioOutside buf.bytes at n)
      __indexTrap
      {
        (rawCopy (+ (strData buf.bytes) at) (strData text) n)
        n
      })
  })

;; Read at most `count` bytes from `f` into `buf[at .. at + count)`:
;; `(Ok n)`, `(Ok 0)` at end of input, or `(Err e)`. A range outside
;; `buf` stops the program with status 77 before the kernel sees it. A
;; ReadBuffer cannot be captured by a parallel binding; its bytes are
;; used by one binding at a time.
(pub :: fileRead (-> File ReadBuffer Int Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (fileRead f buf at count)
  (if (ioOutside buf.bytes at count)
    __indexTrap
    (ioAnswer "fileRead" (ioReadFd (ioFd f) (+ (strData buf.bytes) at) count))))

; ------------------------------------------------------------------
; Terminals
;
; Raw mode is an owner: `termRaw` answers a `TermGuard`, and releasing
; the guard puts the terminal back as it was. `termRestore` does it
; early, once. The guard keeps its own close-on-exec duplicate of the
; terminal's descriptor and the saved attributes, sealed, so a restore
; can't be aimed at another descriptor or at other memory, and it
; still works after the `File` it came from is closed.
;
; Every request number, struct offset and flag bit comes from
; `Sys.Platform`: `struct termios` is 72 bytes on Darwin, 36 on Linux
; and 44 on FreeBSD, and Linux carries a `c_line` byte the BSDs do not.
; `struct winsize` is the same on every POSIX target - four `unsigned
; short`, rows first, columns second - so its offsets are here.
; ------------------------------------------------------------------
;; A terminal's size in character cells. A terminal that was never
;; sized reports 0 for both; treat 0 as unknown and fall back to 80x24.
(pub struct TermSize
  (rows : Int)
  (cols : Int))

;; A terminal in raw mode, and what it was before. Releasing the last
;; share restores it.
(pub struct TermGuard sealed
  (owner : Handle))

; ioctl(fd, request, arg): 0, or `-errno`.
(:: ioIoctl (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (ioIoctl fd req arg)
  (__syscall3 sysIoctlNum fd req arg))

; The answer where the platform has no terminal control (Windows): 78,
; the code `sysNowMonotonic` uses for "this platform cannot answer".
; No `ioctl` is made.
(:: ioTermUnsupported Int)
(fn (ioTermUnsupported)
  (- 0 78))

; A four-byte integer in the host's order, at byte `off` of `buf`.
(:: ioPutInt32 (-> Int Int Int Int))
(fn (ioPutInt32 buf off v)
  {
    (rawPutByte buf off (& v 255))
    (rawPutByte buf (+ off 1) (& (>> v 8) 255))
    (rawPutByte buf (+ off 2) (& (>> v 16) 255))
    (rawPutByte buf (+ off 3) (& (>> v 24) 255))
    buf
  })

(:: ioGetInt32 (-> Int Int Int))
(fn (ioGetInt32 buf off)
  (+ (rawGetByte buf off)
    (+ (<< (rawGetByte buf (+ off 1)) 8)
      (+ (<< (rawGetByte buf (+ off 2)) 16) (<< (rawGetByte buf (+ off 3)) 24)))))

; Eight bytes, little-endian, at byte `off` of `buf`: an ABI record is
; raw bytes, and `rawSetWord` would take a share of whatever word the
; kernel or the caller put there.
(:: ioPutWord (-> Int Int Int Int))
(fn (ioPutWord buf off v)
  {
    (ioPutInt32 buf off (& v 4294967295))
    (ioPutInt32 buf (+ off 4) (& (>> v 32) 4294967295))
  })

; The same, read back. Byte-wise because the offset is not always
; word-aligned: epoll's data word sits at byte 4 on x86_64.
(:: ioGetWord (-> Int Int Int))
(fn (ioGetWord buf off)
  (+ (ioGetInt32 buf off) (<< (ioGetInt32 buf (+ off 4)) 32)))

;; True when `f` is a terminal: it has terminal attributes to read, which
;; is what libc's `isatty` asks too. A pipe, a file or a socket answers
;; false, and so does every file on a target without `termios`.
(pub :: isTerminal (-> File Bool))
;@axiom:effect(io)
(pub fn (isTerminal f)
  (if (== ttyUsesTermios 0)
    (== (platformIsConsole (ioFd f)) 1)
    {
      (let attrs (strAlloc ioTermStateCap))
      (>= (ioIoctl (ioFd f) tcGetAttrReq (strData attrs)) 0)
    }))

;; The size of the terminal on `f`: `(Ok size)`, or `(Err e)` with the
;; kernel's errno when `f` is not one, ENOTTY for a pipe or a file. A
;; terminal may answer 0 rows and 0 columns; treat 0 as unknown.
(pub :: termSize (-> File (Result TermSize Error)))
;@axiom:effect(io)
(pub fn (termSize f)
  {
    (let wsBuf (strAlloc 8))
    (let ws (strData wsBuf))
    {
      (let rc
        (if (== ttyUsesTermios 0)
          (platformConsoleSize (ioFd f))
          (ioIoctl (ioFd f) tcWinSizeReq ws)))
      (if (< rc 0)
        (Err (mkError (- 0 rc) "termSize"))
        (if (== ttyUsesTermios 0)
          ; the platform packs the window as rows * 65536 + cols
          (Ok (TermSize :rows (/ rc 65536) :cols (% rc 65536)))
          (Ok
            (TermSize
              :rows (+ (rawGetByte ws 0) (<< (rawGetByte ws 1) 8))
              :cols (+ (rawGetByte ws 2) (<< (rawGetByte ws 3) 8))))))
    }
  })

; Read one of the four flag words out of a saved state, or clear bits in
; one: `n` is 0 for c_iflag, 1 for c_oflag, 2 for c_cflag and 3 for
; c_lflag, `termiosFlagBytes` apart on every target. They move the low
; 32 bits, where every flag any target defines lives; Darwin's upper
; half goes back untouched.
(:: ioTermFlagGet (-> Int Int Int))
(fn (ioTermFlagGet buf n)
  (ioGetInt32 buf (* n termiosFlagBytes)))

(:: ioTermFlagClear (-> Int Int Int Int))
(fn (ioTermFlagClear buf n mask)
  (ioPutInt32 buf (* n termiosFlagBytes) (& (ioTermFlagGet buf n) (^ mask (- 0 1)))))

; The saved state's size, never 0: a target with no terminal control
; has `termiosBytes` 0, and its calls never touch the block.
(:: ioTermStateCap Int)
(fn (ioTermStateCap)
  (if (< termiosBytes 8)
    8
    termiosBytes))

; The edit that makes raw mode, on a fresh copy of the saved state,
; written to `fd`:
;
;   c_lflag  ECHO, ICANON, IEXTEN off, and ISIG too unless `keepSignals`
;   c_iflag  IXON, ICRNL, ISTRIP, BRKINT off
;   c_oflag  OPOST off: a lone LF is not expanded to CR LF
;   c_cc     VMIN 1, VTIME 0: a `read` returns as soon as one byte is there
;
; c_cflag is not touched; it matters on a serial line, not on a pty.
(:: ioTermRawApply (-> Int String Bool Int))
;@axiom:effect(io)
(fn (ioTermRawApply fd save keepSignals)
  {
    (let workBuf (strAlloc ioTermStateCap))
    (let work (strData workBuf))
    {
      (rawCopy work (strData save) termiosBytes)
      (ioTermFlagClear work 0 (| tiosBrkint (| tiosIcrnl (| tiosIstrip tiosIxon))))
      (ioTermFlagClear work 1 tiosOpost)
      (ioTermFlagClear work 3
        (if keepSignals
          (| tiosEcho (| tiosIcanon tiosIexten))
          (| tiosEcho (| tiosIcanon (| tiosIexten tiosIsig)))))
      (rawPutByte work (+ termiosCcOff termiosVminIdx) 1)
      (rawPutByte work (+ termiosCcOff termiosVtimeIdx) 0)
      (ioIoctl fd tcSetAttrReq work)
    }
  })

; The guard's release: put `save` back on `fd` with the flushing
; request - so a half-typed line is not handed to the shell - and close
; `fd`, the guard's own duplicate. Answers the restore's 0 or `-errno`.
(:: ioTermRelease (-> Int String Int))
;@axiom:effect(io)
(fn (ioTermRelease fd save)
  {
    (let rc (ioIoctl fd tcSetAttrReq (strData save)))
    {
      (ioClose fd)
      rc
    }
  })

; Restore through the original live handle to quiesce its input
; reader. An adopted File's retired marker means its reader was closed,
; and the guard's private duplicate still names the original console.
; Standard stream File values never close their process handle/reader.
(:: ioWinTermRelease (-> Int Int (Option FileMarker) Int Int Int Int))
;@axiom:effect(io)
(fn (ioWinTermRelease dup fd marker mode outDup outMode)
  {
    (let target
      (if (|| (&& (>= fd 0) (<= fd 2)) (fileMarkerAlive marker))
        fd
        dup))
    (let restored (platformConsoleSetMode target mode))
    (let outRestored
      (if (< outDup 0)
        0
        {
          (let r (platformConsoleSetMode 1 outMode))
          (if (< r 0)
            (platformConsoleSetMode outDup outMode)
            r)
        }))
    (let _ (ioClose dup))
    (let _
      (if (< outDup 0)
        0
        (ioClose outDup)))
    (if (< restored 0)
      restored
      outRestored)
  })

;; Put the terminal on `f` into raw mode, saving what it was first:
;; `(Ok guard)`, or `(Err e)` with the kernel's errno, ENOTTY for a pipe
;; or a file. With `keepSignals` true, ^C still raises SIGINT; with false
;; it arrives as byte 3. Releasing the guard, or `termRestore`, puts it back.
(pub :: termRaw (-> File Bool (Result TermGuard Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (termRaw f keepSignals)
  (if (== ttyUsesTermios 0)
    ; A console's mode word is the saved state, and the guard's release
    ; writes it back. Raw clears line input (2), echo (4) and, unless
    ; the signals are kept, processed input (1, which turns Ctrl-C into
    ; an event), and turns on virtual-terminal input (0x200) so keys
    ; arrive as the escape sequences `Tui` reads; the output console is
    ; given virtual-terminal processing (4) for the sequences it writes,
    ; and that word is restored with the input's. Windows mode changes
    ; need a read/write handle; a read-only File returns EACCES.
    {
      (let fd (ioFd f))
      (let mode (platformConsoleMode fd))
      (if (< mode 0)
        (withContext (Err (mkError (- 0 mode) "termRaw")) "GetConsoleMode(input)")
        {
          (let outMode (platformConsoleMode 1))
          (let dup (windowsConsoleDup fd))
          (if (< dup 0)
            (withContext (Err (mkError (- 0 dup) "termRaw")) "DuplicateHandle(input)")
            {
              (let outDup
                (if (< outMode 0)
                  -1
                  (windowsConsoleDup 1)))
              (if (&& (>= outMode 0) (< outDup 0))
                {
                  (let _ (ioClose dup))
                  (withContext (Err (mkError (- 0 outDup) "termRaw")) "DuplicateHandle(output)")
                }
                {
                  (let marker f.marker)
                  (let guard
                    (TermGuard
                      :owner
                        (__resource_new
                          (lambda (d) (ioWinTermRelease d fd marker mode outDup outMode)) dup)))
                  (let raw
                    (|
                      (& mode
                        (^
                          (| 6
                            (if keepSignals
                              0
                              1))
                          (- 0 1)))
                      512))
                  (let r (platformConsoleSetMode fd raw))
                  (if (< r 0)
                    {
                      (let _ (__resource_close guard.owner))
                      (withContext (Err (mkError (- 0 r) "termRaw")) "SetConsoleMode(input)")
                    }
                    {
                      (let _
                        (if (< outMode 0)
                          0
                          (platformConsoleSetMode 1 (| outMode 4))))
                      (Ok guard)
                    })
                })
            })
        })
    }
    {
      (let dup (ioFcntl (ioFd f) fDupFdCloexec 0))
      (if (< dup 0)
        (Err (mkError (- 0 dup) "termRaw"))
        {
          (let save (strAlloc ioTermStateCap))
          {
            (let rc (ioIoctl dup tcGetAttrReq (strData save)))
            (if (< rc 0)
              {
                (ioClose dup)
                (Err (mkError (- 0 rc) "termRaw"))
              }
              {
                (let guard
                  (TermGuard :owner (__resource_new (lambda (d) (ioTermRelease d save)) dup)))
                {
                  (let r (ioTermRawApply dup save keepSignals))
                  (if (< r 0)
                    {
                      (let _ (__resource_close guard.owner))
                      (Err (mkError (- 0 r) "termRaw"))
                    }
                    (Ok guard))
                }
              })
          }
        })
    }))

;; Put the terminal back as `termRaw` found it, now rather than when the
;; guard's last share goes: `(Ok 0)`, or `(Err e)`. A second call answers
;; `(Ok 0)` and does nothing.
(pub :: termRestore (-> TermGuard (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (termRestore g)
  (sysResult "termRestore" (__resource_close g.owner)))

; ------------------------------------------------------------------
; Readiness
;
; A `Poller` answers which of many files can be read without blocking:
; kqueue on the BSDs, epoll on Linux, behind one set of names. A file is
; added with a token of the caller's choosing, and a wake answers the
; tokens, never a descriptor. The poller owns its kqueue or epoll
; descriptor and, on Linux, the signal descriptor `pollerAddSignals`
; makes; releasing the poller closes both.
;
; The two mechanisms differ in shape, not only in numbers. kqueue
; registers and collects with one call and carries the token in
; `udata`, at byte 24 of its 32-byte record on Darwin and of the first
; 32 of FreeBSD's 64; epoll needs `epoll_ctl` to register and carries
; the token in its data word, at byte 4 on x86_64 and 8 on aarch64.
; `Sys.Platform` carries the sizes and the epoll offset.
;
; Signals arrive the same way. On the BSDs each signal is its own
; registration on the kqueue, and the event's `ident` is the signal
; number. On Linux the signals become a readable descriptor of their
; own, and a wake on it is read for the number. Block the signals first
; (`Sys.sysSignalBlock`): an unblocked SIGTERM ends the process before
; anything observes it.
;
; A closed file leaves the poller's interest set as the kernel drops
; it, so a descriptor number a later file reuses is never reported
; under the old token.
; ------------------------------------------------------------------
;; The readiness poller `stdin` and the socket calls share: one owned
;; poll set, so two parts of a program cannot register the same
;; descriptor twice.
(pub struct Poller sealed
  (owner : Handle)
  (events : String)
  (cap : Int)
  (mut count : Int)
  (ts : String)
  (regs : String)
  (markers : (Vec MarkerSlot))
  (mut nregs : Int)
  (mut sigToken : Int)
  (mut sigFile : (Option File))
  (sigInfo : String))

; The poller's own descriptor, for one call. Traps 85 once closed.
(:: pollerFd (-> Poller Int))
;@axiom:effect(unsafe)
(fn (pollerFd p)
  (__resource_get p.owner))

; The byte offset of event `i`'s token.
(:: pollerTokenOffset (-> Int Int))
(fn (pollerTokenOffset i)
  (+ (* i pollEventSize)
    (if (== pollUsesKqueue 1)
      24
      pollEventFdOffset)))

; Fixed slots give each marker a declared counted field. Replacing or
; clearing a slot releases the previous marker without moving vector
; elements or making their ownership depend on a generic return value.
(:: pollerMarkers (-> Int (Vec MarkerSlot)))
(fn (pollerMarkers cap)
  {
    (let slots (vecWithCapacity cap))
    (for i in 0..cap
      {
        (let _ (vecPush slots (MarkerSlot :marker None)))
        0
      })
    slots
  })

(:: pollerMarkerAt (-> Poller Int (Option FileMarker)))
(fn (pollerMarkerAt p i)
  {
    (let slot (vecGet p.markers i))
    slot.marker
  })

;; A poller that answers at most `cap` events per wait: `(Ok p)`, or
;; `(Err e)` carrying the errno - EMFILE when the process has no
;; descriptor left.
(pub :: pollerNew (-> Int (Result Poller Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:pre((> cap 0))
(pub fn (pollerNew cap)
  {
    ; Without a syscall ABI there is no kernel object to own: the poller
    ; is its registration table, three words a row (descriptor,
    ; interest, token), and `pollerWait` hands the table to the
    ; platform's poll. Its owner is then a handle nothing closes.
    (let pfd
      (if (== usesSyscallAbi 0)
        0
        (__syscall3 sysPollCreateNum 0 0 0)))
    (if (< pfd 0)
      (Err (mkError (- 0 pfd) "pollerNew"))
      (Ok
        (Poller
          :owner
            (if (== usesSyscallAbi 0)
              (__resource_new pollerDropNone pfd)
              (__resource_new fileDrop pfd))
          :events (strAlloc (* cap pollEventSize))
          :cap cap
          :count 0
          :ts (strAlloc 16)
          :regs
            (strAlloc
              (if (== usesSyscallAbi 0)
                (* cap 24)
                8))
          :nregs 0
          :markers
            (pollerMarkers
              (if (== usesSyscallAbi 0)
                cap
                0))
          :sigToken (- 0 1)
          :sigFile None
          :sigInfo
            (strAlloc
              (if (< sigInfoSize 8)
                8
                sigInfoSize)))))
  })

; One registration record: watch `fd` (or, on the BSDs, the signal
; `ident`) under `filter` - `pollReadFilter`, `pollWriteFilter` or
; `pollSignalFilter` - `op` adding or deleting, with `token` the wake
; answers. On epoll the filter is the interest mask.
(:: pollerRec (-> Int Int Int Int String))
(fn (pollerRec ident filter op token)
  {
    (let rec (strAlloc pollEventSize))
    {
      (let p (strData rec))
      {
        (if (== pollUsesKqueue 1)
          ; struct kevent: ident, then a signed 16-bit filter, then flags,
          ; and udata at 24.
          {
            (ioPutWord p 0 ident)
            (rawPutByte p 8 (& filter 255))
            (rawPutByte p 9 (& (>> filter 8) 255))
            (rawPutByte p 10 (& op 255))
            (rawPutByte p 11 (& (>> op 8) 255))
            (ioPutWord p 24 token)
          }
          ; struct epoll_event: the interest mask, then the data word.
          {
            (ioPutWord p 0 filter)
            (ioPutWord p pollEventFdOffset token)
          })
        rec
      }
    }
  })

; Apply one registration record to the poller: kevent with a change
; list of one and no event list on the BSDs, epoll_ctl on Linux.
(:: pollerApply (-> Poller Int String Int (Option FileMarker) Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (pollerApply p fd rec op marker)
  {
    (let pfd (pollerFd p))
    (if (== usesSyscallAbi 0)
      {
        (pollerPrune p)
        (let r
          (pollerTable p fd (ioGetWord (strData rec) 0) (ioGetWord (strData rec) pollEventFdOffset)
            op marker))
        ; Prime the persistent input reader without waiting for it.
        ; A control probe would consume a pending signal, so only file
        ; and socket registrations take this path.
        (if (&& (>= r 0) (&& (== op pollAddOp) (!= fd -2)))
          {
            (let row (strAlloc 24))
            (let ptr (strData row))
            (ioPutWord ptr 0 fd)
            (ioPutWord ptr 8 (ioGetWord (strData rec) 0))
            (ioPutWord ptr 16 0)
            (let _ (platformPoll ptr 1 0))
          })
        r
      }
      (if (== pollUsesKqueue 1)
        (__syscall6 sysPollWaitNum pfd (strData rec) 1 0 0 0)
        (__syscall4 sysPollCtlNum pfd op fd (strData rec))))
  })

; The table a poller keeps where there is no kernel object: 24-byte rows
; of descriptor, interest and token. `pollAddOp` adds a row, or
; re-arms the descriptor's row; `pollDelOp` removes the descriptor's row
; and keeps the rows contiguous. A full table answers -EMFILE and the
; removal of an unknown descriptor -ENOENT, as `epoll_ctl` would.
(:: pollerTable (-> Poller Int Int Int Int (Option FileMarker) Int))
(fn (pollerTable p fd interest token op marker)
  {
    (let t (strData p.regs))
    (let at (pollerRowOf p fd 0))
    (if (== op pollAddOp)
      (if (>= at 0)
        {
          (ioPutWord t (+ (* at 24) 8) interest)
          (ioPutWord t (+ (* at 24) 16) token)
          (let slot (vecGet p.markers at))
          (set slot.marker marker)
          0
        }
        (if (>= p.nregs p.cap)
          (- 0 24)
          {
            (let i p.nregs)
            (ioPutWord t (* i 24) fd)
            (ioPutWord t (+ (* i 24) 8) interest)
            (ioPutWord t (+ (* i 24) 16) token)
            (set p.nregs (+ i 1))
            (let slot (vecGet p.markers i))
            (set slot.marker marker)
            0
          }))
      (if (< at 0)
        (- 0 2)
        {
          (let last (- p.nregs 1))
          (let _
            (if (!= at last)
              {
                (ioPutWord t (* at 24) (ioGetWord t (* last 24)))
                (ioPutWord t (+ (* at 24) 8) (ioGetWord t (+ (* last 24) 8)))
                (ioPutWord t (+ (* at 24) 16) (ioGetWord t (+ (* last 24) 16)))
                (let slot (vecGet p.markers at))
                (set slot.marker (pollerMarkerAt p last))
                0
              }
              0))
          (set p.nregs last)
          (let lastSlot (vecGet p.markers last))
          (set lastSlot.marker None)
          0
        }))
  })

; Controls and internal raw registrations have no File marker. A
; captured marker is process-safe to inspect even after its File dies.
(macro (fileMarkerAlive marker) (match marker
  ((None) true)
  ((Some cell)
    (!= (windowsMarkerAlive (as cell Int)) 0)
  )))

; Drop retired rows before capacity checks and waits. The last row
; fills each hole, with its marker moved alongside its descriptor.
(macro (pollerPrune p) {
  (let t (strData p.regs))
  (let mut i 0)
  (while (< i p.nregs)
    (if (fileMarkerAlive (pollerMarkerAt p i))
      (set i (+ i 1))
      {
        (let last (- p.nregs 1))
        (if (!= i last)
          {
            (ioPutWord t (* i 24) (ioGetWord t (* last 24)))
            (ioPutWord t (+ (* i 24) 8) (ioGetWord t (+ (* last 24) 8)))
            (ioPutWord t (+ (* i 24) 16) (ioGetWord t (+ (* last 24) 16)))
            (let slot (vecGet p.markers i))
            (set slot.marker (pollerMarkerAt p last))
          })
        (set p.nregs last)
        (let lastSlot (vecGet p.markers last))
        (set lastSlot.marker None)
      }))
  0
})

; The row of `fd` in the table, searching from `i`, or -1.
(:: pollerRowOf (-> Poller Int Int Int))
(fn (pollerRowOf p fd i)
  (if (>= i p.nregs)
    (- 0 1)
    (if (== (ioGetWord (strData p.regs) (* i 24)) fd)
      i
      (pollerRowOf p fd (+ i 1)))))

; The owner of a table-only poller: nothing to close.
(:: pollerDropNone (-> Int Int))
(fn (pollerDropNone h)
  0)

;; Watch `f` for readability under `token`: `(Ok 0)`, or `(Err e)`. The
;; poller does not keep `f` alive; close it, or let it go, and its
;; registration goes with it.
(pub :: pollerAdd (-> Poller File Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (pollerAdd p f token)
  {
    (let fd (ioFd f))
    (ioAnswer "pollerAdd"
      (pollerApply p fd (pollerRec fd pollReadFilter pollAddOp token) pollAddOp f.marker))
  })

;; Stop watching `f`: `(Ok 0)`, or `(Err e)` - ENOENT when it was not
;; being watched.
(pub :: pollerRemove (-> Poller File (Result Int Error)))
;@axiom:effect(io)
(pub fn (pollerRemove p f)
  {
    (let fd (ioFd f))
    (ioAnswer "pollerRemove"
      (pollerApply p fd (pollerRec fd pollReadFilter pollDelOp 0) pollDelOp f.marker))
  })

;; Watch the signals in `mask` (bit N-1 for signal N, `Sys.sysSigBit`)
;; under `token`: `(Ok 0)`, or `(Err e)`. Block them with
;; `Sys.sysSignalBlock` first. `pollerSignal` reads which one arrived.
;; Windows supports `Sys.Platform.sigInt` and `sigBreak`: other bits
;; answer `Err` 78. One table row holds the mask; 0 removes it. The
;; process mask persists after removal or close, and competing pollers
;; consume each pending control once between them.
(pub :: pollerAddSignals (-> Poller Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (pollerAddSignals p mask token)
  {
    (let _ (pollerFd p))
    (if (== usesSyscallAbi 0)
      ; The Windows runtime owns the blocked mask and pending bits.
      ; This table row keeps no callback pointer into the poller's
      ; arena, so closing a poller cannot race the native handler.
      {
        (pollerPrune p)
        (match (platformSignalBlock mask)
          ((Err e) (Err (errContextOf e "pollerAddSignals")))
          ((Ok _)
            {
              (let r
                (if (== mask 0)
                  (if (>= (pollerRowOf p -2 0) 0)
                    (pollerTable p -2 0 0 pollDelOp None)
                    0)
                  (pollerTable p -2 mask token pollAddOp None)))
              (if (< r 0)
                (Err (ioFdError (- 0 r) "pollerAddSignals"))
                {
                  (set p.sigToken token)
                  (Ok 0)
                })
            }
          ))
      }
      (if (== signalUsesSignalFd 1)
        {
          (let sigset (strAlloc 16))
          {
            (ioPutWord (strData sigset) 0 mask)
            ; signalfd4(-1, mask, sizemask, SFD_CLOEXEC): -1 creates a
            ; descriptor rather than updating one.
            {
              (let sfd (__syscall4 sysSignalFdNum (- 0 1) (strData sigset) sigsetBytes oCloexec))
              (if (< sfd 0)
                (Err (ioFdError (- 0 sfd) "pollerAddSignals"))
                {
                  (let sf (ioAdopt sfd))
                  (match (pollerAdd p sf token)
                    ((Err e) (Err e))
                    ((Ok n)
                      {
                        (set p.sigFile (Some sf))
                        (set p.sigToken token)
                        (Ok n)
                      }
                    ))
                })
            }
          }
        }
        ; The BSDs: one EVFILT_SIGNAL registration per signal in the mask.
        ; Signals are 1..31; bit N-1 is signal N.
        {
          (let mut rc 0)
          {
            (for signo in 1..32
              (if (!= (& mask (sysSigBit signo)) 0)
                {
                  (let r
                    (pollerApply p signo (pollerRec signo pollSignalFilter pollAddOp token)
                      pollAddOp None))
                  (if (< r 0)
                    (set rc r))
                }))
            (set p.sigToken token)
            (ioAnswer "pollerAddSignals" rc)
          }
        }))
  })

;; Wait for readiness: `(Ok n)` with `n` events to read with
;; `pollerToken` and `pollerSignal`, `(Ok 0)` when `timeoutMs` passed
;; first, or `(Err e)`. A negative `timeoutMs` waits for ever; 0 asks and
;; answers at once. EINTR answers `(Ok 0)`: nothing was collected.
(pub :: pollerWait (-> Poller Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (pollerWait p timeoutMs)
  ; kqueue takes a pointer to a timespec and reads NULL as "no
  ; timeout"; epoll takes milliseconds in a register.
  ; epoll_pwait's fifth argument is a signal mask this layer does not
  ; use, and its sixth that mask's size, which the kernel checks.
  {
    (let pfd (pollerFd p))
    (let r
      (if (== usesSyscallAbi 0)
        ; The table: each row's descriptor and interest go to the
        ; platform's poll in a scratch copy, which answers each row's
        ; readiness, and every ready row becomes one event record (the
        ; readiness, then the token at `pollEventFdOffset`) for
        ; `pollerToken` to read.
        {
          (pollerPrune p)
          (let n p.nregs)
          (let scratch
            (strAlloc
              (*
                (if (<= n 0)
                  1
                  n)
                24)))
          (let s (strData scratch))
          (let t (strData p.regs))
          (let mut i 0)
          (while (< i n)
            {
              (ioPutWord s (* i 24) (ioGetWord t (* i 24)))
              (ioPutWord s (+ (* i 24) 8) (ioGetWord t (+ (* i 24) 8)))
              (ioPutWord s (+ (* i 24) 16) 0)
              (set i (+ i 1))
            })
          (let got (platformPoll s n timeoutMs))
          (if (< got 0)
            got
            {
              (let e (strData p.events))
              (let mut k 0)
              (set i 0)
              (while (&& (< i n) (< k p.cap))
                {
                  ; Recheck after the native wait: closing a File and
                  ; reusing its HANDLE while the wait ran must not
                  ; publish readiness under the retired File's token.
                  (if (&& (!= (ioGetWord s (+ (* i 24) 16)) 0)
                        (fileMarkerAlive (pollerMarkerAt p i)))
                    {
                      (ioPutWord e (* k pollEventSize) (ioGetWord s (+ (* i 24) 16)))
                      (ioPutWord e (+ (* k pollEventSize) pollEventFdOffset)
                        (ioGetWord t (+ (* i 24) 16)))
                      (set k (+ k 1))
                    })
                  (set i (+ i 1))
                })
              k
            })
        }
        (if (== pollUsesKqueue 1)
          (if (< timeoutMs 0)
            (__syscall6 sysPollWaitNum pfd 0 0 (strData p.events) p.cap 0)
            {
              (ioPutWord (strData p.ts) 0 (/ timeoutMs 1000))
              (ioPutWord (strData p.ts) 8 (* (% timeoutMs 1000) 1000000))
              (__syscall6 sysPollWaitNum pfd 0 0 (strData p.events) p.cap (strData p.ts))
            })
          (__syscall6 sysPollWaitNum pfd (strData p.events) p.cap timeoutMs 0 pollSigsetSize))))
    (if (== r (- 0 4))
      {
        (set p.count 0)
        (Ok 0)
      }
      (if (< r 0)
        {
          (set p.count 0)
          (Err (ioFdError (- 0 r) "pollerWait"))
        }
        {
          (set p.count r)
          (Ok r)
        }))
  })

;; The token event `i` of the last wait carries. An `i` outside the
;; events that wait answered stops the program with status 77.
(pub :: pollerToken (-> Poller Int Int))
(pub fn (pollerToken p i)
  {
    (let _ (pollerFd p))
    (if (|| (< i 0) (>= i p.count))
      __indexTrap
      (ioGetWord (strData p.events) (pollerTokenOffset i)))
  })

;; The signal event `i` of the last wait delivered, or `None` when it is
;; not a signal. On Linux this reads the signal descriptor, once per
;; event. Windows records one console control in the event, so reading
;; it again answers the same number. An `i` outside the last wait's
;; events stops the program with status 77.
(pub :: pollerSignal (-> Poller Int (Option Int)))
;@axiom:effect(io)
(pub fn (pollerSignal p i)
  {
    (let _ (pollerFd p))
    (if (|| (< i 0) (>= i p.count))
      __indexTrap
      (if (== usesSyscallAbi 0)
        {
          (let event (ioGetWord (strData p.events) (* i pollEventSize)))
          (if (< event 0)
            (Some (- 0 event))
            None)
        }
        (if (== signalUsesSignalFd 1)
          (match p.sigFile
            ((None) None)
            ((Some sf)
              (if (!= (pollerToken p i) p.sigToken)
                None
                {
                  (let n (ioReadFd (ioFd sf) (strData p.sigInfo) sigInfoSize))
                  (if (< n sigInfoSize)
                    None
                    (Some (ioGetInt32 (strData p.sigInfo) 0)))
                })
            ))
          ; kqueue: the record's own 16-bit filter says whether it is a
          ; signal, and its `ident` is the number.
          {
            (let b (strData p.events))
            (let off (* i pollEventSize))
            (if (&& (== (rawGetByte b (+ off 8)) (& pollSignalFilter 255))
                  (== (rawGetByte b (+ off 9)) (& (>> pollSignalFilter 8) 255)))
              (Some (ioGetWord b off))
              None)
          })))
  })

;; Close the poller now rather than at its last share: `(Ok 0)`, or
;; `(Err e)`. Any later use traps 85.
(pub :: pollerClose (-> Poller (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (pollerClose p)
  {
    (match p.sigFile
      ((Some sf)
        {
          (let _ (fileClose sf))
          ()
        }
      )
      ((None) ()))
    (sysResult "pollerClose" (__resource_close p.owner))
  })

; ------------------------------------------------------------------
; Sockets
;
; TCP over a `File`. `Net` types these as `TcpListener` and
; `TcpStream`; the calls here take the socket address as the bytes
; `Internal.SocketAddress.netAddr4` and `Internal.SocketAddress.netAddr6` write, `netAddrMaxBytes` long, and
; refuse anything else with EINVAL before a syscall.
;
; Every socket made here is blocking, closes on its last share, and
; does not raise SIGPIPE on a closed peer: Darwin and FreeBSD set
; `SO_NOSIGPIPE` per socket, and Linux and FreeBSD send with
; `MSG_NOSIGNAL`, so the write answers EPIPE instead.
; ------------------------------------------------------------------
; Whether `addr` is a socket address this layer can hand the kernel:
; the right length and a family it knows.
(:: socketAddrOk (-> String Bool))
(fn (socketAddrOk addr)
  (if (!= (strLen addr) netAddrMaxBytes)
    false
    {
      (let fam (netAddrFamily (strData addr)))
      (|| (== fam afInet) (== fam afInet6))
    }))

(:: socketBadAddr (-> String (Result a Error)))
(fn (socketBadAddr op)
  (Err (mkError 22 (concat op ": not a socket address"))))

; Set an integer option on a raw socket descriptor: 0, or `-errno`.
(:: socketOptRaw (-> Int Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (socketOptRaw fd level name value)
  {
    (let v (strAlloc 4))
    {
      (ioPutInt32 (strData v) 0 value)
      (if (== usesSyscallAbi 0)
        (platformSetSockOpt fd level name (strData v) 4)
        (__syscall5 sysSetSockOptNum fd level name (strData v) 4))
    }
  })

; Clear or set `O_NONBLOCK`, keeping the other flags: 0, or `-errno`.
(:: ioSetNonBlocking (-> Int Bool Int))
;@axiom:effect(io)
(fn (ioSetNonBlocking fd on)
  (if (== usesSyscallAbi 0)
    (platformSetNonBlocking fd on)
    {
      (let fl (ioFcntl fd fGetFl 0))
      (if (< fl 0)
        fl
        (ioFcntl fd fSetFl
          (if on
            (| fl oNonblock)
            (& fl (^ oNonblock (- 0 1))))))
    }))

; A raw socket descriptor made ready to own: blocking, and no SIGPIPE
; where that is per socket. Closes `fd` and answers `-errno` on failure.
(:: socketReady (-> Int Int))
;@axiom:effect(io)
(fn (socketReady fd)
  {
    (let r (ioSetNonBlocking fd false))
    {
      (let r2
        (if (< r 0)
          r
          (if (== soNoSigPipe 0)
            0
            (socketOptRaw fd solSocket soNoSigPipe 1))))
      (if (< r2 0)
        {
          (ioClose fd)
          r2
        }
        fd)
    }
  })

;; A blocking TCP socket for the family of `addr`, not yet bound or
;; connected: `(Ok file)`, or `(Err e)`.
(pub :: socketOpen (-> String (Result File Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketOpen addr)
  (if (! (socketAddrOk addr))
    (socketBadAddr "socketOpen")
    {
      (let fd
        (if (== usesSyscallAbi 0)
          (platformSocket (netAddrFamily (strData addr)) sockStream 0)
          (__syscall3 sysSocketNum (netAddrFamily (strData addr)) sockStream 0)))
      (if (< fd 0)
        (Err (ioFdError (- 0 fd) "socketOpen"))
        {
          (let r (socketReady fd))
          (if (< r 0)
            (Err (ioFdError (- 0 r) "socketOpen"))
            (Ok (ioAdopt r)))
        })
    }))

;; Bind `s` to `addr`. The length comes from the family in the address.
(pub :: socketBind (-> File String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketBind s addr)
  (if (! (socketAddrOk addr))
    (socketBadAddr "socketBind")
    (ioAnswer "socketBind"
      (if (== usesSyscallAbi 0)
        (platformBind (ioFd s) (strData addr) (netAddrSize (strData addr)))
        (__syscall3 sysBindNum (ioFd s) (strData addr) (netAddrSize (strData addr)))))))

;; Listen on a bound socket, queueing up to `backlog` connections.
(pub :: socketListen (-> File Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketListen s backlog)
  (ioAnswer "socketListen"
    (if (== usesSyscallAbi 0)
      (platformListen (ioFd s) backlog)
      (__syscall3 sysListenNum (ioFd s) backlog 0))))

;; The next connection on a listening socket, as a blocking socket of its
;; own: `(Ok file)`, or `(Err e)` - EAGAIN when the listener does not
;; block and nothing is waiting. The accepted socket blocks whatever the
;; listener's mode, on every target.
(pub :: socketAccept (-> File (Result File Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketAccept s)
  {
    (let fd
      (if (== usesSyscallAbi 0)
        (platformAccept (ioFd s))
        (__syscall4 sysAcceptNum (ioFd s) 0 0 0)))
    (if (< fd 0)
      (Err (ioFdError (- 0 fd) "socketAccept"))
      {
        (let r (socketReady fd))
        (if (< r 0)
          (Err (ioFdError (- 0 r) "socketAccept"))
          (Ok (ioAdopt r)))
      })
  })

;; Connect `s` to `addr`. A non-blocking socket answers `(Err e)` with
;; EINPROGRESS, which is the kernel's contract rather than a failure.
(pub :: socketConnect (-> File String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketConnect s addr)
  (if (! (socketAddrOk addr))
    (socketBadAddr "socketConnect")
    (ioAnswer "socketConnect"
      (if (== usesSyscallAbi 0)
        (platformConnect (ioFd s) (strData addr) (netAddrSize (strData addr)))
        (__syscall3 sysConnectNum (ioFd s) (strData addr) (netAddrSize (strData addr)))))))

;; Close one or both halves: `how` is 0 for reading, 1 for writing and 2
;; for both. Anything else is EINVAL.
(pub :: socketShutdown (-> File Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketShutdown s how)
  (if (|| (< how 0) (> how 2))
    (Err (mkError 22 "socketShutdown: how is 0, 1 or 2"))
    (ioAnswer "socketShutdown"
      (if (== usesSyscallAbi 0)
        (platformShutdown (ioFd s) how)
        (__syscall3 sysShutdownNum (ioFd s) how 0)))))

;; Set an integer socket option, such as `soReuseAddr` at `solSocket` or
;; `tcpNoDelayOpt` at `ipprotoTcp`.
(pub :: socketSetInt (-> File Int Int Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (socketSetInt s level name value)
  (ioAnswer "socketSetInt" (socketOptRaw (ioFd s) level name value)))

;; Set the `soRcvTimeo` or `soSndTimeo` timeout, in microseconds; 0
;; waits for ever and a negative timeout is EINVAL.
(pub :: socketSetTimeout (-> File Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketSetTimeout s opt micros)
  (if (< micros 0)
    (Err (mkError 22 "socketSetTimeout: a timeout is not negative"))
    {
      (let tv (strAlloc 16))
      {
        ; struct timeval: seconds in the first word, microseconds in the
        ; second - a 4-byte field padded to 8 on Darwin, 8 bytes on Linux
        ; and FreeBSD, so the low four bytes carry it either way.
        (ioPutWord (strData tv) 0 (/ micros 1000000))
        (ioPutWord (strData tv) 8 (% micros 1000000))
        (ioAnswer
          "socketSetTimeout"
          (if (== usesSyscallAbi 0)
            ; Winsock reads a DWORD of milliseconds where POSIX reads a
            ; timeval; a timeout under a millisecond rounds up to one,
            ; since 0 would mean no timeout at all.
            {
              (ioPutInt32 (strData tv) 0 (/ (+ micros 999) 1000))
              (platformSetSockOpt (ioFd s) solSocket opt (strData tv) 4)
            }
            (__syscall5 sysSetSockOptNum (ioFd s) solSocket opt (strData tv) 16)))
      }
    }))

;; The address `s` is bound to, or with `peer` true the address of the
;; peer it is connected to, as `netAddrMaxBytes` bytes.
(pub :: socketAddr (-> File Bool (Result String Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketAddr s peer)
  {
    (let a (strAlloc netAddrMaxBytes))
    (let lenb (strAlloc 8))
    {
      (ioPutInt32 (strData lenb) 0 netAddrMaxBytes)
      {
        (let r
          (if (== usesSyscallAbi 0)
            (platformSocketAddr (ioFd s) peer (strData a) (strData lenb))
            (__syscall3
              (if peer
                sysGetPeerNameNum
                sysGetSockNameNum)
              (ioFd s) (strData a) (strData lenb))))
        (if (< r 0)
          (Err (ioFdError (- 0 r) "socketAddr"))
          (Ok a))
      }
    }
  })

;; Send all of `data`, continuing after a short send and retrying EINTR:
;; `(Ok n)`, or `(Err e)` - EPIPE when the peer has closed, never a
;; signal.
(pub :: socketSend (-> File String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketSend s data)
  {
    (let fd (ioFd s))
    (let n (strLen data))
    (let p (strData data))
    (let mut off 0)
    (let mut rc 0)
    {
      (while (&& (< off n) (== rc 0))
        {
          (let r
            (if (== usesSyscallAbi 0)
              (platformSend fd (+ p off) (- n off))
              (__syscall6 sysSendToNum fd (+ p off) (- n off) msgNoSignal 0 0)))
          (if (< r 0)
            (if (== r (- 0 4))
              ()
              ; EINTR: nothing was sent; try again
              (set rc r))
            (set off (+ off r)))
        })
      (if (< rc 0)
        (Err (ioFdError (- 0 rc) "socketSend"))
        (Ok off))
    }
  })

;; One send of as much of `data` as the socket takes now, retrying
;; EINTR: `(Ok n)`, where `n` can be short of `strLen data`, or `(Err e)`
;; - EAGAIN when a non-blocking socket took nothing, EPIPE when the peer
;; has closed. Unlike `socketSend`, a short send loses no count.
(pub :: socketSendSome (-> File String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketSendSome s data)
  {
    (let fd (ioFd s))
    (let mut r (- 0 4))
    {
      (while (== r (- 0 4))
        (set r (if (== usesSyscallAbi 0)
          (platformSend fd (strData data) (strLen data))
          (__syscall6 sysSendToNum fd (strData data) (strLen data) msgNoSignal 0 0))))
      (ioAnswer "socketSendSome" r)
    }
  })

; getsockopt(fd, level, name) of a 4-byte option into `cell`, which
; must hold 4 bytes: 0, or `-errno`.
(:: socketOptGetRaw (-> Int Int Int String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (socketOptGetRaw fd level name cell)
  {
    (let lenb (strAlloc 8))
    {
      (ioPutInt32 (strData lenb) 0 (strLen cell))
      (if (== usesSyscallAbi 0)
        (platformGetSockOpt fd level name (strData cell) (strData lenb))
        (__syscall5 sysGetSockOptNum fd level name (strData cell) (strData lenb)))
    }
  })

;; Read an integer option: `(Ok value)`, or `(Err e)`.
(pub :: socketGetInt (-> File Int Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (socketGetInt s level name)
  {
    (let v (strAlloc 4))
    {
      (let r (socketOptGetRaw (ioFd s) level name v))
      (if (< r 0)
        (Err (ioFdError (- 0 r) "socketGetInt"))
        (Ok (ioGetInt32 (strData v) 0)))
    }
  })

;; Read the `soRcvTimeo` or `soSndTimeo` timeout in microseconds, 0 when
;; reads or writes wait for ever.
(pub :: socketGetTimeout (-> File Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (socketGetTimeout s opt)
  {
    (let tv (strAlloc 16))
    {
      (let r (socketOptGetRaw (ioFd s) solSocket opt tv))
      (if (< r 0)
        (Err (ioFdError (- 0 r) "socketGetTimeout"))
        (if (== usesSyscallAbi 0)
          ; a DWORD of milliseconds, as `socketSetTimeout` writes it there
          (Ok (* (ioGetInt32 (strData tv) 0) 1000))
          ; seconds in the first word, microseconds in the low four bytes
          ; of the second, as `socketSetTimeout` writes them
          (Ok (+ (* (ioGetWord (strData tv) 0) 1000000) (ioGetInt32 (strData tv) 8)))))
    }
  })

;; Connect `s` to `addr`, waiting at most `ms` milliseconds: `(Ok 0)`, or
;; `(Err e)` - ETIMEDOUT when the time ran out first, or the connect's
;; own error. The connect runs non-blocking under a one-slot poller that
;; waits for the socket to become writable; the socket is blocking again
;; on every answer.
(pub :: socketConnectWithin (-> File String Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (socketConnectWithin s addr ms)
  (if (! (socketAddrOk addr))
    (socketBadAddr "socketConnectWithin")
    {
      (let fd (ioFd s))
      {
        (let r0 (ioSetNonBlocking fd true))
        (if (< r0 0)
          (ioAnswer "socketConnectWithin" r0)
          {
            (let r
              (if (== usesSyscallAbi 0)
                (platformConnect fd (strData addr) (netAddrSize (strData addr)))
                (__syscall3 sysConnectNum fd (strData addr) (netAddrSize (strData addr)))))
            {
              (let res
                (if (== r 0)
                    0
                  (!= r (- 0 eInProgress))
                    r
                  (socketAwaitConnect fd ms s.marker)))
              {
                (let back (ioSetNonBlocking fd false))
                (ioAnswer "socketConnectWithin"
                  (if (< res 0)
                    res
                    back))
              }
            }
          })
      }
    }))

; Wait up to `ms` for a non-blocking connect on `fd` to finish: 0, or
; `-errno`, `-ETIMEDOUT` when the time ran out. A wake means the connect
; finished either way, and SO_ERROR says which.
(:: socketAwaitConnect (-> Int Int (Option FileMarker) Int))
;@axiom:effect(io)
(fn (socketAwaitConnect fd ms marker)
  (match (pollerNew 1)
    ((Err e) (- 0 (errCode e)))
    ((Ok p)
      {
        (let r (pollerApply p fd (pollerRec fd pollWriteFilter pollAddOp 0) pollAddOp marker))
        (if (< r 0)
          r
          (match (pollerWait p ms)
            ((Err e) (- 0 (errCode e)))
            ((Ok 0) (- 0 eTimedOut))
            ((Ok _)
              {
                (let v (strAlloc 4))
                {
                  (let g (socketOptGetRaw fd solSocket soError v))
                  (if (< g 0)
                    g
                    (- 0 (ioGetInt32 (strData v) 0)))
                }
              }
            )))
      }
    )))

;; Switch `f` between blocking (`false`) and non-blocking (`true`),
;; keeping its other flags. A read or write that cannot proceed on a
;; non-blocking file answers `(Err e)` whose `errorKind` is `WouldBlock`.
(pub :: fileSetNonBlocking (-> File Bool (Result Int Error)))
;@axiom:effect(io)
(pub fn (fileSetNonBlocking f on)
  (ioAnswer "fileSetNonBlocking" (ioSetNonBlocking (ioFd f) on)))
