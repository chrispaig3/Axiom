;;! Str - length-prefixed strings, in Axiom.
;
; A `Str` is the address of a THREE-word header:
;
;     word 0 : length in bytes
;     word 1 : address of the bytes
;     word 2 : the block owning those bytes, or 0 when no block does
;              (a literal's belong to the loader, a syscall buffer's
;              to the kernel) - memory-model.md MM-VAL-7. This line
;              was missing from the day the third word was added: the
;              sentence above said THREE and the list showed two.
;
; The bytes are always NUL-terminated *in addition* to being
; length-counted. Carrying the length makes slicing, comparison, and
; concatenation O(1) in the length rather than requiring a scan, and
; makes a `Str` able to contain a NUL; keeping the terminator means
; `strCStr` can hand a path straight to `Sys.sysOpenPath` without
; copying. Both properties matter for a compiler: source text is sliced
; constantly, and file paths cross the syscall boundary constantly.
;
; A string *literal* is already a `Str`. The compiler emits a header of
; exactly this shape next to the literal's bytes, so `"hello"` is the
; address of a static one and needs no conversion:
;
;     (strLen "hello")            ; 5, a load of a constant
;     (println "hello, world")
;
; Its length is computed at compile time, which is why nothing here
; scans a literal. `(__addr "hello")` still yields the raw bytes for the
; cases that want NUL-terminated ones - see `rawStrFromLit` and `strCStr`.
(import Internal.Raw)
; For `strSplit`, which is the only thing here that answers a Vec.
; `Vec` imports `Mem` and nothing else, so this adds no cycle.
(import Vec)

;; A `Str` over freshly allocated, zeroed space for `len` bytes. A
;; negative `len` stops the program with status 77, as a bad index does.
;
; `len + 1` bytes are reserved so the NUL terminator never overwrites
; payload; the allocator zeroes, so the terminator is already in place.
;
; The negative case is refused HERE, before the arithmetic: `-1` asked
; the allocator for `len + 1 = 0` bytes, which it grants, and answered
; a `String` whose length was -1 - `(concat "XYZ" s)` printed `XY` and
; the program then crashed (tests/stdlib/849-size-refusals.ax).
;@axiom:restrict(no-io,no-foreign)
(pub :: strAlloc (-> Int String))
;@axiom:effect(unsafe)
(pub fn (strAlloc len)
  (if (< len 0)
    __indexTrap
    ; the header's own share of its buffer - one retain here makes
    ; the rule uniform ("a `Str` header's death releases its owner
    ; once"), which is what lets a slice outlive the header it was
    ; cut from without the buffer going early or staying forever
    {
      (let bytes (rawAlloc (+ len 1)))
      {
        (__retain bytes)
        (rawStrWrapOwned bytes len bytes)
      }
    }))

; ------------------------------------------------------------------
; Accessors
; ------------------------------------------------------------------
;; The length of `s` in bytes.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strLen (-> String Int))
(pub fn (strLen s)
  ; The one place a `String` is read AS a word address - the handle
  ; crossing into the Mem boundary is spelled with the cast, so the
  ; checker sees every other use of `s` as the string it is
  ; (memory-model.md MM-ALLOC-20).
  (rawGetWord (as s Int) 0))

;; The address of the first byte of `s`, for the raw-memory calls. It
;; stays valid while `s` is alive.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strData (-> String Int))
(pub fn (strData s)
  (rawGetWord (as s Int) 1))

;; The block owning this string's bytes, or 0 for bytes no block owns
;; (a literal's, a syscall buffer's, an arena keep block's interior).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strOwner (-> String Int))
(pub fn (strOwner s)
  (rawGetWord (as s Int) 2))

;; The byte at `i`, or 0 when `i` is out of range.
;
; Out-of-range reads return 0 rather than trapping because the callers
; that matter - a lexer's lookahead - want "one past the end" to behave
; like an end-of-input sentinel, and NUL is already that sentinel here.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strByte (-> String Int Int))
;@axiom:effect(unsafe)
(pub fn (strByte s i)
  (if (< i 0)
    0
    (if (>= i (strLen s))
      0
      (__load8 (strData s) i))))

;; The bytes of `s` as a NUL-terminated address, for a syscall: free
;; when a NUL follows `s`, and a fresh copy for a short slice.
;@axiom:restrict(no-io,no-foreign)
(pub :: strCStr (-> String Int))
(pub fn (strCStr s)
  (if (strTerminated s)
    (strData s)
    (strCStrCopy s)))

;; Whether `s` has no bytes.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strIsEmpty (-> String Bool))
(pub fn (strIsEmpty s)
  (== (strLen s) 0))

; ------------------------------------------------------------------
; Comparison
; ------------------------------------------------------------------
;; 0 when equal; otherwise negative if `a` sorts before `b`, positive if
;; after - lexicographic by unsigned byte, with a shorter prefix sorting
;; first.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strCmp (-> String String Int))
(pub fn (strCmp a b)
  {
    (let la (strLen a))
    (let lb (strLen b))
    {
      (let shared
        (if (< la lb)
          la
          lb))
      {
        (let diff (rawCmp (strData a) (strData b) shared))
        (if (!= diff 0)
          diff
          (- la lb))
      }
    }
  })

;; Whether `a` and `b` hold the same bytes.
;
; Faster than `(== (strCmp a b) 0)`. `strCmp` must produce an ordering,
; so it compares the shared prefix before it looks at the lengths.
; Equality checks the lengths first, which turns the commonest case, a
; miss, into two word loads and a compare.
;
; It matters because `strEq` is the compiler's hottest predicate: every
; keyword test in the lexer, every `lookupType`, every `findFSig`, and
; `mangledFor`, which walks a Vec holding every top-level name in the
; program once per call site. `findFSigIn` (codegen.ax) already carries
; a hand-rolled length pre-check in front of its `strEq` - somebody met
; this before and fixed it locally. This fixes it for every caller.
;
; Measured on `emit-llvm` of the compiler's own source, both compilers
; built the same way by the same builder at `--opt 1`, best of 5 on an
; idle machine: 2.8121s to 1.7218s, 1.63x. The self-hosting fixpoint
; holds under the change.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strEq (-> String String Bool))
(pub fn (strEq a b)
  {
    (let la (strLen a))
    (if (!= la (strLen b))
      false
      (== (rawCmp (strData a) (strData b) la) 0))
  })

; ------------------------------------------------------------------
; Slicing and joining
; ------------------------------------------------------------------
;; The `count` bytes of `s` starting at `start`, sharing `s`'s storage.
;; `start` and `count` are clamped to `s`: a range past either end
;; answers the bytes that are there, and a range outside `s` is empty.
;
; A slice is *not* NUL-terminated unless it happens to end where `s`
; does, so `strCStr` copies one, and `strDup` makes a copy
; that outlives an arena reset. Sharing rather than
; copying is the whole point - a tokenizer that copied every lexeme
; would allocate once per token.
;@axiom:restrict(no-io,no-foreign)
(pub :: strSlice (-> String Int Int String))
;@axiom:effect(unsafe)
(pub fn (strSlice s start count)
  ; the slice's own share of the bytes it now points into
  {
    (let len (strLen s))
    {
      (let from
        (if (< start 0)
          0
          (if (> start len)
            len
            start)))
      {
        (let avail (- len from))
        {
          (let n
            (if (< count 0)
              0
              (if (> count avail)
                avail
                count)))
          {
            (let owner (strOwner s))
            {
              (__retain owner)
              (rawStrWrapOwned (+ (strData s) from) n owner)
            }
          }
        }
      }
    }
  })

;; An owned, NUL-terminated copy of `s`.
;@axiom:restrict(no-io,no-foreign)
(pub :: strDup (-> String String))
(pub fn (strDup s)
  {
    (let len (strLen s))
    {
      (let out (strAlloc len))
      {
        (rawCopy (strData out) (strData s) len)
        out
      }
    }
  })

;; `a` followed by `b`, as a new string.
;@axiom:restrict(no-io,no-foreign)
(pub :: concat (-> String String String))
(pub fn (concat a b)
  {
    (let la (strLen a))
    (let lb (strLen b))
    {
      (let out (strAlloc (+ la lb)))
      {
        (rawCopy (strData out) (strData a) la)
        (rawCopy (+ (strData out) la) (strData b) lb)
        out
      }
    }
  })

; True when a NUL follows the bytes of `s`, so `strData` is already a C
; string. The read is in bounds for every `Str`: one built here owns
; its terminator, and the byte after a slice lies inside its parent.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: strTerminated (-> String Bool))
;@axiom:effect(unsafe)
(fn (strTerminated s)
  (== (__load8 (strData s) (strLen s)) 0))

; A fresh NUL-terminated copy of the bytes of `s`, for `strCStr`. No
; `Str` owns it, so it lives until its arena is reset.
;@axiom:restrict(no-io,no-foreign)
(:: strCStrCopy (-> String Int))
(fn (strCStrCopy s)
  {
    (let n (strLen s))
    (let p (rawAlloc (+ (strLen s) 1)))
    {
      (rawCopy p (strData s) n)
      p
    }
  })

; ------------------------------------------------------------------
; Searching
; ------------------------------------------------------------------
;; Index of the first `byte` at or after `from`, or `None`.
;
; A loop rather than a self tail call, so that answering an `Option`
; keeps the `no-alloc` claim above it. A function whose every tail is
; `None` or `(Some e)` is emitted as a two-register pair with no block
; behind it (docs/error-model.md section 5b), but a self tail call
; disqualifies it (`tailCallsSelf` in `core/codegen.ax`), and the
; boxed body would draw AX3049 against the claim. `strFind` below is a
; loop for the same reason.
;
; `hit` is a separate flag rather than a negative `found`, so a negative
; `from` is searched like any other index: `strByte` answers 0 below
; index 0, so `(strFindByte s 0 -3)` answers `(Some -3)`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strFindByte (-> String Int Int (Option Int)))
(pub fn (strFindByte s byte from)
  {
    (let len (strLen s))
    (let mut i from)
    (let mut hit 0)
    {
      (while (&& (== hit 0) (< i len))
        (if (== (strByte s i) byte)
          (set hit 1)
          (set i (+ i 1))))
      (if (== hit 0)
        None
        (Some i))
    }
  })

;; Whether `s` begins with `prefix`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strStartsWith (-> String String Bool))
(pub fn (strStartsWith s prefix)
  {
    (let lp (strLen prefix))
    (if (> lp (strLen s))
      false
      (== (rawCmp (strData s) (strData prefix) lp) 0))
  })

; ------------------------------------------------------------------
; Byte classification.
;
; One statement of each rule. The lexer, the formatter and `Cereal`
; once each had their own idea of what a space, a digit and a letter
; are, and a formatter that accepted a byte the lexer refuses could turn
; an invalid program into a valid one. The predicates in `lexer.ax` and
; `format.ax` keep their names, because diagnostics name them, and
; delegate here. `tests/selfhost/990-char-class.ax` sweeps all 256 byte
; values through every one of them and requires the delegations to agree.
; ------------------------------------------------------------------
;; Whether the byte is an ASCII digit, `0` to `9`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strIsDigit (-> Int Bool))
(pub fn (strIsDigit ch)
  (if (>= ch 48)
    (<= ch 57)
    false))

;; Whether the byte is an ASCII letter.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strIsAlpha (-> Int Bool))
(pub fn (strIsAlpha ch)
  (if (>= ch 65)
    (if (<= ch 90)
      true
      (if (>= ch 97)
        (<= ch 122)
        false))
    false))

;; Whether the byte is a space, tab, line feed or carriage return.
;
; Not `char::is_whitespace`: VT and FF are AX1001 to this language's
; lexer, and a formatter that skipped them turned a refused file into an
; accepted one.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strIsSpace (-> Int Bool))
(pub fn (strIsSpace ch)
  (match ch
    (32 true)
    (10 true)
    (13 true)
    (9 true)
    (_ false)))

;; The value of a hexadecimal digit byte, 0 to 15, or `None` for any
;; other byte.
;
; Answering `(Option Int)` keeps `no-alloc`: a function of this shape
; is emitted as a two-register pair and builds no block on any path, so
; the claim is checked against the IR (`scripts/check-unboxed-sums.sh`,
; tests/diagnostics/384-restrict-no-alloc-ctor.ax).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strHexVal (-> Int (Option Int)))
(pub fn (strHexVal ch)
  (if (&& (>= ch 48) (<= ch 57))
    (Some (- ch 48))
    (if (&& (>= ch 97) (<= ch 102))
      (Some (+ 10 (- ch 97)))
      (if (&& (>= ch 65) (<= ch 70))
        (Some (+ 10 (- ch 65)))
        None))))

;; Whether the byte is a hexadecimal digit, `0` to `9`, `a` to `f` or
;; `A` to `F`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strIsHexDigit (-> Int Bool))
(pub fn (strIsHexDigit ch)
  (match (strHexVal ch)
    ((Some v) true)
    ((None) false)))

; ------------------------------------------------------------------
; Splitting
; ------------------------------------------------------------------
;; Every segment of `s` between occurrences of `byte`, in order. Empty
;; segments are kept, so there is always one more segment than there are
;; separators: `(strSplit "a:" 58)` answers `"a"` and `""`.
;
; A `PATH` entry of "" means the working directory, and a caller that
; wants empty segments dropped can drop them, while a caller that needs
; them could not get them back.
;
; The segments are SLICES: they share `s`'s bytes and are not
; NUL-terminated. `strCStr` or `concat` where a syscall needs a C
; string - the two call sites this replaced both did that already, and
; for that reason.
;@axiom:restrict(no-io,no-foreign)
(pub :: strSplit (-> String Int (Vec String)))
(pub fn (strSplit s byte)
  {
    (let out vecNew)
    {
      (strSplitFrom s byte 0 out)
      out
    }
  })

;; Split `s` on `byte` starting at index `from`, pushing each piece
;; onto `out`. Answers how many pieces were pushed.
;@axiom:restrict(no-io,no-foreign)
(pub :: strSplitFrom (-> String Int Int (Vec String) Int))
(pub fn (strSplitFrom s byte from out)
  (match (strFindByte s byte from)
    ((None)
      {
        (vecPush out (strSlice s from (- (strLen s) from)))
        0
      }
    )
    ((Some cut)
      {
        (vecPush out (strSlice s from (- cut from)))
        (strSplitFrom s byte (+ cut 1) out)
      }
    )))

; A byte: an `Int` the range check has already admitted to `0 .. 255`.
; The upper bound is exclusive (`0 <= b < 256`), as for every
; two-bound subtype. Narrowing into it - `(cast Byte b)` - traps with
; status 80 outside the range, by the same compare-branch-trap a
; contract lowers to; widening back to `Int` is free, which is why the
; `__store8` below takes `b` with no cast at all.
(pub subtype Byte is Int range 0..256)

;; A one-byte `String` holding `b`.
;
; `Byte` and not `Int`, because the store keeps only the low eight bits:
; a value of 256 or more traps with status 80 at the call boundary
; rather than being silently truncated.
;@axiom:restrict(no-io,no-foreign)
(pub :: strFromByte (-> Byte String))
;@axiom:effect(unsafe)
(pub fn (strFromByte b)
  {
    (let s (strAlloc 1))
    {
      (__store8 (strData s) 0 b)
      s
    }
  })

; ------------------------------------------------------------------
; Building.
;
; `(set s (concat s piece))` in a loop copies everything built so far
; on every turn, so it is quadratic: 200,000 one-byte appends took 8.1
; seconds on darwin-aarch64. A `StrBuilder` keeps the bytes in storage
; of its own that doubles when it fills, so each byte is copied a
; constant number of times on average and the same loop is linear: 1.1
; milliseconds, doubling with each doubling of the count.
;
; The storage is a `String` this module allocated and never hands out
; while it can still be written. `bytes` is that storage, and its length
; is the capacity; `len` is how much of it is in use. Every write lands
; at `len` or above, in room the storage already has, and nothing
; writes below `len` again, so an appended byte is final. A builder
; whose storage is exactly full can therefore give that storage away as
; the finished `String`: the next push must first move to a bigger
; buffer, and the one given away is never written again. Any other
; finish copies the used bytes into a `String` of their exact size.
; Either way the builder stays usable, and nothing it does later can
; change a `String` it has finished.
; ------------------------------------------------------------------
;; A `String` under construction. Appending is amortised constant time
;; per byte, and `strBuilderFinish` answers the bytes as a `String`.
;; Only this module can build one or reach its storage, so no `String`
;; a program holds can change when the builder does.
(pub struct StrBuilder sealed
  (mut bytes : String)
  (mut len : Int))

; The capacity `strBuilderNew` starts with, and the least a growing
; builder moves to.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: strBuilderMinCap Int)
(fn (strBuilderMinCap)
  16)

;; An empty builder with room for a few bytes before it first grows.
;@axiom:restrict(no-io,no-foreign)
(pub :: strBuilderNew StrBuilder)
(pub fn (strBuilderNew)
  (strBuilderWithCapacity strBuilderMinCap))

;; An empty builder with room for `cap` bytes before it first grows. A
;; `cap` of 0 is allowed, and the first push that adds a byte grows it.
;; A negative `cap` stops the program with status 77, as `strAlloc`
;; does.
;@axiom:restrict(no-io,no-foreign)
(pub :: strBuilderWithCapacity (-> Int StrBuilder))
(pub fn (strBuilderWithCapacity cap)
  (StrBuilder :bytes (strAlloc cap) :len 0))

;; How many bytes the builder holds.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strBuilderLen (-> StrBuilder Int))
(pub fn (strBuilderLen b)
  b.len)

;; How many bytes the builder can hold before it next grows.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strBuilderCap (-> StrBuilder Int))
(pub fn (strBuilderCap b)
  (strLen b.bytes))

; Make room for `n` more bytes. When they don't fit, move to storage of
; twice the capacity, or of exactly `len + n` bytes when that is more,
; and never less than `strBuilderMinCap`. Doubling is what makes a run
; of appends linear: each move at least doubles the capacity, so all the
; moves together copy fewer bytes than the final capacity
; (tests/stdlib/990-str-builder-scale.ax counts them).
;@axiom:restrict(no-io,no-foreign)
(:: strBuilderReserve (-> StrBuilder Int Int))
(fn (strBuilderReserve b n)
  {
    (let need (+ b.len n))
    (let cap (strLen b.bytes))
    {
      (if (> need cap)
        {
          (let doubled
            (if (> (* cap 2) strBuilderMinCap)
              (* cap 2)
              strBuilderMinCap))
          (let big
            (strAlloc
              (if (> need doubled)
                need
                doubled)))
          {
            (rawCopy (strData big) (strData b.bytes) b.len)
            (set b.bytes big)
          }
        })
      need
    }
  })

;; Append the bytes of `s`. Answers the builder.
;@axiom:restrict(no-io,no-foreign)
(pub :: strBuilderPush (-> StrBuilder String StrBuilder))
(pub fn (strBuilderPush b s)
  {
    (let n (strLen s))
    {
      (strBuilderReserve b n)
      (rawCopy (+ (strData b.bytes) b.len) (strData s) n)
      (set b.len (+ b.len n))
      b
    }
  })

;; Append one byte. Answers the builder. A value outside 0 to 255 stops
;; the program with status 80 at the call, as for `strFromByte`.
;@axiom:restrict(no-io,no-foreign)
(pub :: strBuilderPushByte (-> StrBuilder Byte StrBuilder))
(pub fn (strBuilderPushByte b byte)
  {
    (strBuilderReserve b 1)
    (rawPutByte (strData b.bytes) b.len byte)
    (set b.len (+ b.len 1))
    b
  })

;; The bytes appended so far, as a `String` of exactly that length. The
;; builder stays usable, and later appends don't change the answer.
;@axiom:restrict(no-io,no-foreign)
;@axiom:post((== (strLen result) (strBuilderLen b)))
(pub :: strBuilderFinish (-> StrBuilder String))
(pub fn (strBuilderFinish b)
  (if (== b.len (strLen b.bytes))
    ; Exactly full: no push can write here again (see the banner).
    b.bytes
    {
      (let out (strAlloc b.len))
      {
        (rawCopy (strData out) (strData b.bytes) b.len)
        out
      }
    }))

;; The strings in `parts` with `sep` between each two, as one new
;; `String`: `(strJoin parts ", ")`. No parts join to "", and one part
;; joins to a copy of itself.
;
; Two walks: the first sizes the result, so the builder starts at
; exactly that capacity, and the second copies each part into its
; storage once. The fill writes through locals rather than calling
; `strBuilderPush` per part, which checks for room every time. Measured
; on ten `jsonWrite`s of a 200,000-element array, which join four
; pieces per element: pushing each part (and an empty separator)
; retired 18% more instructions than the private join this replaced,
; and this spelling 0.6% more (medians of five). The storage ends
; exactly full, so `strBuilderFinish` answers it without a second copy.
;@axiom:restrict(no-io,no-foreign)
(pub :: strJoin (-> (Vec String) String String))
(pub fn (strJoin parts sep)
  {
    (let count (vecLen parts))
    (let ls (strLen sep))
    (let mut total 0)
    {
      (for p in parts
        (set total (+ total (strLen p))))
      (if (> count 1)
        (set total (+ total (* (- count 1) ls))))
      {
        (let b (strBuilderWithCapacity total))
        (let d (strData b.bytes))
        (let mut at 0)
        {
          (for (p i) in parts
            {
              (if (&& (> i 0) (> ls 0))
                {
                  (rawCopy (+ d at) (strData sep) ls)
                  (set at (+ at ls))
                })
              (rawCopy (+ d at) (strData p) (strLen p))
              (set at (+ at (strLen p)))
            })
          (set b.len at)
          (strBuilderFinish b)
        }
      }
    }
  })

; ------------------------------------------------------------------
; Case, substring search, trimming and integer parsing.
;
; What a protocol parser needs: an ASCII fold, substring search,
; trimming and integer parsing. They are public and permanent
; (`scripts/check-compat.sh` holds them), and the two that can fail
; answer `Option` rather than a sentinel: `compat/SENTINELS` may fall
; and never rise, and `Option` is built in, so this costs `Str` no
; import.
; ------------------------------------------------------------------
;; `s` with every ASCII upper-case letter lowered, or `s` itself when it
;; has none. Bytes above 127 pass through untouched: this is an ASCII
;; fold, not a Unicode case mapping.
;@axiom:restrict(no-io,no-foreign)
;@axiom:post((== (strLen result) (strLen s)))
(pub :: strLower (-> String String))
;@axiom:effect(unsafe)
(pub fn (strLower s)
  {
    (let len (strLen s))
    (let mut upper 0)
    {
      (for k in 0..len
        (if (&& (>= (strByte s k) 65) (<= (strByte s k) 90))
          (set upper (+ upper 1))))
      (if (== upper 0)
        s
        {
          (let out (strAlloc len))
          (let d (strData out))
          {
            (for i in 0..len
              {
                (let c (strByte s i))
                (__store8 d i
                  (if (&& (>= c 65) (<= c 90))
                    (+ c 32)
                    c))
              })
            out
          }
        })
    }
  })

;; `s` with every ASCII lower-case letter raised, or `s` itself when
;; it has none. The companion of `strLower`.
;@axiom:restrict(no-io,no-foreign)
;@axiom:post((== (strLen result) (strLen s)))
(pub :: strUpper (-> String String))
;@axiom:effect(unsafe)
(pub fn (strUpper s)
  {
    (let len (strLen s))
    (let mut lower 0)
    {
      (for k in 0..len
        (if (&& (>= (strByte s k) 97) (<= (strByte s k) 122))
          (set lower (+ lower 1))))
      (if (== lower 0)
        s
        {
          (let out (strAlloc len))
          (let d (strData out))
          {
            (for i in 0..len
              {
                (let c (strByte s i))
                (__store8 d i
                  (if (&& (>= c 97) (<= c 122))
                    (- c 32)
                    c))
              })
            out
          }
        })
    }
  })

;; The index of the first occurrence of `needle` in `s` at or after
;; `from`, or `None`. An empty needle is found at `from` whenever
;; `from` is inside `s` or at its end, which is the rule that makes
;; `(strFind s "" (strLen s))` answer `(Some (strLen s))` rather than
;; nothing.
;@axiom:restrict(no-io,no-foreign)
(pub :: strFind (-> String String Int (Option Int)))
(pub fn (strFind s needle from)
  {
    (let len (strLen s))
    (let ln (strLen needle))
    (let mut i
      (if (< from 0)
        0
        from))
    (let mut found (- 0 1))
    {
      (while (&& (< found 0) (<= (+ i ln) len))
        (if (== (rawCmp (+ (strData s) i) (strData needle) ln) 0)
          (set found i)
          (set i (+ i 1))))
      (if (< found 0)
        None
        (Some found))
    }
  })

;; `s` without the `strIsSpace` bytes at either end. The result is a
;; slice sharing `s`'s storage, so it is not NUL-terminated unless it
;; ends where `s` does. A string that is all space trims to "".
;@axiom:restrict(no-io,no-foreign)
(pub :: strTrim (-> String String))
(pub fn (strTrim s)
  {
    (let len (strLen s))
    (let mut lo 0)
    (let mut hi (strLen s))
    {
      (while (&& (< lo len) (strIsSpace (strByte s lo)))
        (set lo (+ lo 1)))
      (while (&& (> hi lo) (strIsSpace (strByte s (- hi 1))))
        (set hi (- hi 1)))
      (strSlice s lo (- hi lo))
    }
  })

;; The decimal integer `s` spells - an optional `-`, then one or more
;; ASCII digits and nothing else - or `None`: for an empty string, a
;; sign alone, any other byte, and any value outside the 64-bit range.
;
; THE OVERFLOW TEST IS PER DIGIT, on the accumulator, and the
; accumulator runs NEGATIVE so that the most negative Int is
; representable on the way to it. `Rpc.ax` records what a parser
; without the test accepted: `18446744073709551621` wrapped to 5 and
; was taken as a length. Here it is `None`, and so is
; `9223372036854775808`, while `9223372036854775807` and
; `-9223372036854775808` both parse.
; There is no `no-alloc` claim, as for `strFind`: the `(Some ...)`
; answer allocates.
;@axiom:restrict(no-io,no-foreign)
(pub :: strParseInt (-> String (Option Int)))
(pub fn (strParseInt s)
  {
    (let len (strLen s))
    (let neg (== (strByte s 0) 45))
    (let mut i
      (if (== (strByte s 0) 45)
        1
        0))
    (let mut acc 0)
    (let mut bad 0)
    (let mut digits 0)
    {
      (while (&& (== bad 0) (< i len))
        {
          (let c (strByte s i))
          {
            (if (strIsDigit c)
              ; -922337203685477580 is the last accumulator a further
              ; digit can extend; at exactly that value the digit may
              ; be 7, or 8 when the sign is negative.
              {
                (let d (- c 48))
                (if (|| (< acc (- 0 922337203685477580))
                      (&& (== acc (- 0 922337203685477580))
                        (> d
                          (if neg
                            8
                            7))))
                  (set bad 1)
                  {
                    (set acc (- (* acc 10) d))
                    (set digits (+ digits 1))
                  })
              }
              (set bad 1))
            (set i (+ i 1))
          }
        })
      (if (|| (== bad 1) (== digits 0))
        None
        (Some
          (if neg
            acc
            (- 0 acc))))
    }
  })

;; `format` — a String, built at compile time from a literal's runs and
;; holes, or the hole lowering applied to anything else.
;
;   (format "x = {x}, y = {y}")   ; the interpolating form
;   (format n)                    ; = (show n); Rust's format!("{}", n)
;
; The macro is four tokens because `syntax/format` is the whole
; implementation: it reads the literal, splits it, and emits the
; `concat` chain with one rendering call per hole. See
; docs/macro-system.md MAC-CAP-10 for the grammar and the lowering.
;
; `show` itself is not declared anywhere: the expander emits a var node
; named `show` per hole and the checker resolves it from the hole's
; static type (`showIsHead`, `showBuiltin`, `showResolve`), so the
; macro needs no module of its own.
;
; It lives in `Str` and not `Fmt`. Every expansion of
; this macro emits `concat`, so from here the expander's qualifier
; resolves it on its FIRST path instead of the fallback. Fmt was the
; other candidate and is the wrong one twice over: `Fmt` imports
; `Str`, so `format` living in `Str` cannot import `Fmt` back without
; a module cycle - and it does not need to. A specifier's expansion
; names `fmtFloatPrec` and `fmtPadLeft`, and `expQualify` reaches
; those through `expUniqueModuleName` over the MERGED declaration
; list, not through import edges, so `{x:.2}` and `{n:>8}` resolve
; in a program that does not import `Fmt`.
(pub macro (format e) (syntax/format e))

; ------------------------------------------------------------------
; String lists.
;
; A `(Vec String)` of a million words is a million and one blocks, each
; with its own header and count, and dropping it visits every one. A
; `StrList` keeps the bytes of every string in one builder and the end
; of each in a `(Vec Int)`: two blocks however many strings it holds,
; and nothing to walk when it goes. Asking about a string in place
; allocates nothing; `strListGet` answers a slice of the shared bytes.
;
; A slice holds a share of the storage it points into (MM-VAL-7), and
; the builder never writes below its length again (see `StrBuilder`),
; so a string read from the list never changes, even after the builder
; moves to bigger storage.
; ------------------------------------------------------------------
;; A list of strings packed into one run of bytes. Add with
;; `strListPush`. Read with `strListGet`, or without allocating with
;; `strListByteLen`, `strListByte` and `strListEq`.
(pub struct StrList sealed
  (bytes : StrBuilder)
  (ends : (Vec Int)))

;; An empty list.
;@axiom:restrict(no-io,no-foreign)
(pub :: strListNew StrList)
(pub fn (strListNew)
  (StrList :bytes strBuilderNew :ends vecNew))

;; How many strings the list holds.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strListLen (-> StrList Int))
(pub fn (strListLen l)
  (vecLen l.ends))

;; Append a copy of the bytes of `s`. Answers the list.
;@axiom:restrict(no-io,no-foreign)
(pub :: strListPush (-> StrList String StrList))
(pub fn (strListPush l s)
  {
    (strBuilderPush l.bytes s)
    (vecPush l.ends (strBuilderLen l.bytes))
    l
  })

; Where string `i` starts in the shared bytes.
(:: strListStart (-> StrList Int Int))
(fn (strListStart l i)
  (if (== i 0)
    0
    (vecGet l.ends (- i 1))))

;; The length in bytes of string `i`. An `i` out of range stops the
;; program with status 77, as `vecGet` does.
(pub :: strListByteLen (-> StrList Int Int))
(pub fn (strListByteLen l i)
  (- (vecGet l.ends i) (strListStart l i)))

;; Byte `j` of string `i`. An `i` or a `j` out of range stops the
;; program with status 77.
(pub :: strListByte (-> StrList Int Int Int))
(pub fn (strListByte l i j)
  {
    (let start (strListStart l i))
    (if (|| (< j 0) (>= j (- (vecGet l.ends i) start)))
      __indexTrap
      (strByte l.bytes.bytes (+ start j)))
  })

;; String `i`, sharing the list's bytes the way `strSlice` shares its
;; parent's. Pushing more strings never changes one already read. An
;; `i` out of range stops the program with status 77.
(pub :: strListGet (-> StrList Int String))
(pub fn (strListGet l i)
  {
    (let start (strListStart l i))
    (strSlice l.bytes.bytes start (- (vecGet l.ends i) start))
  })

;; Whether string `i` holds exactly the bytes of `s`. Allocates nothing.
(pub :: strListEq (-> StrList Int String Bool))
(pub fn (strListEq l i s)
  {
    (let start (strListStart l i))
    (let n (- (vecGet l.ends i) start))
    (if (!= n (strLen s))
      false
      {
        (let mut k 0)
        (let mut same true)
        {
          (while (&& same (< k n))
            {
              (if (!= (strByte l.bytes.bytes (+ start k)) (strByte s k))
                (set same false))
              (set k (+ k 1))
            })
          same
        }
      })
  })
