; Str - length-prefixed strings, in Axiom.
;
; A `Str` is the address of a THREE-word header:
;
;     word 0 : length in bytes
;     word 1 : address of the bytes
;     word 2 : the block owning those bytes, or 0 when no block does
;              (a literal's belong to the loader, a syscall buffer's
;              to the kernel) - memory-model.md MM-VAL-7. This line
;              was missing from the day the third word was added: the
;              sentence above said THREE and the list showed two.
;
; The bytes are always NUL-terminated *in addition* to being
; length-counted. Carrying the length makes slicing, comparison, and
; concatenation O(1) in the length rather than requiring a scan, and
; makes a `Str` able to contain a NUL; keeping the terminator means
; `strCStr` can hand a path straight to `Sys.sysOpenPath` without
; copying. Both properties matter for a compiler: source text is sliced
; constantly, and file paths cross the syscall boundary constantly.
;
; A string *literal* is already a `Str`. The compiler emits a header of
; exactly this shape next to the literal's bytes, so `"hello"` is the
; address of a static one and needs no conversion:
;
;     (strLen "hello")            ; 5, a load of a constant
;     (println "hello, world")
;
; Its length is computed at compile time, which is why nothing here
; scans a literal. `(__addr "hello")` still yields the raw bytes for the
; cases that want NUL-terminated ones - see `strFromLit` and `strCStr`.

(import Mem)
; For `strSplit`, which is the only thing here that answers a Vec.
; `Vec` imports `Mem` and nothing else, so this adds no cycle.
(import Vec)

; ------------------------------------------------------------------
; Construction
; ------------------------------------------------------------------

; Wrap `len` bytes at `bytes` as a `Str` without copying.
;
; The caller keeps responsibility for `bytes` outliving the `Str` and
; for the NUL terminator at `bytes[len]`. Every other constructor in
; this module goes through here.
(pub :: strWrap (-> Int Int String))
(pub fn (strWrap bytes len)
  (strWrapOwned bytes len 0))

; The same, naming the block that OWNS the bytes (MM-LIFE-2d's `Str`
; half): word 2 holds the handle whose death should free them, or 0
; when no such block exists - a literal's bytes are loader-resident,
; a syscall's are the kernel's, and an interior wrap over an arena
; keep block belongs to the arena. A slice inherits its parent's
; owner rather than naming the parent, so the chain is one hop deep
; however many times a slice is sliced, and the address counted is
; never interior.
;
; The header is allocated MAPPED, with bit 2 set: word 2 is the only
; word of a `Str` that holds a handle to a counted block, so a header
; whose count reaches zero releases its owner and the owner's count
; reaches zero in turn. That is what turns the share this function
; records into reclamation instead of bookkeeping - before it, a dead
; `Str` was header-deep and its bytes' count simply stood
; (docs/memory-model.md MM-LIFE-2d). Word 1 is deliberately NOT
; mapped: for a slice it is an INTERIOR address, and no count
; reachable from a slice may free an interior pointer.
(pub :: strWrapOwned (-> Int Int Int String))
(pub fn (strWrapOwned bytes len owner)
  (let ((s (memAllocMapped 24 4)))
    {
      (memSetWord s 0 len)
      (memSetWord s 1 bytes)
      (memSetWord s 2 owner)
      ; The one place in the standard library a `String` is BUILT from
      ; raw words rather than received as one, so the one place the
      ; cast is the truth: `s` is an `Int` from the allocator until
      ; the three stores above make it a header. The checker refuses
      ; an `Int` body under a `String` signature since 2026-08-21
      ; (`tyIsReprScalar`), and this is the explicit escape it asks
      ; for rather than an exemption.
      (cast String s)
    }))

; A `Str` over freshly allocated, zeroed space for `len` bytes.
;
; `len + 1` bytes are reserved so the NUL terminator never overwrites
; payload; the allocator zeroes, so the terminator is already in place.
(pub :: strAlloc (-> Int String))
(pub fn (strAlloc len)
  (let ((bytes (memAlloc (+ len 1))))
    {
      ; the header's own share of its buffer - one retain here makes
      ; the rule uniform ("a `Str` header's death releases its owner
      ; once"), which is what lets a slice outlive the header it was
      ; cut from without the buffer going early or staying forever
      (__retain bytes)
      (strWrapOwned bytes len bytes)
    }))

; A `Str` sharing the bytes at a NUL-terminated address.
;
; For a literal this is no longer needed - `"hello"` is already a `Str`
; with a compile-time length, and `(strFromLit (__addr "hello"))` is the
; same value arrived at by scanning for a length that was known. It
; remains the bridge for NUL-terminated bytes that come from somewhere
; else: a syscall's output buffer.
;
; Cost is one scan for the length; the bytes are never copied.
(pub :: strFromLit (-> Int String))
(pub fn (strFromLit cstr)
  (strWrap cstr (cstrLen cstr 0)))

; Length of NUL-terminated bytes at `addr`, scanning from `i`.
(pub :: cstrLen (-> Int Int Int))
(pub fn (cstrLen addr i)
  (if (== (__load8 addr i) 0)
      i
      (cstrLen addr (+ i 1))))

; ------------------------------------------------------------------
; Accessors
; ------------------------------------------------------------------

(pub :: strLen (-> String Int))
(pub fn (strLen s)
  ; The one place a `String` is read AS a word address - the handle
  ; crossing into the Mem boundary is spelled with the cast, so the
  ; checker sees every other use of `s` as the string it is
  ; (memory-model.md MM-ALLOC-20).
  (memGetWord (cast Int s) 0))

(pub :: strData (-> String Int))
(pub fn (strData s)
  (memGetWord (cast Int s) 1))

; The block owning this string's bytes, or 0 for bytes no block owns
; (a literal's, a syscall buffer's, an arena keep block's interior).
(pub :: strOwner (-> String Int))
(pub fn (strOwner s)
  (memGetWord (cast Int s) 2))

; The byte at `i`, or 0 when `i` is out of range.
;
; Out-of-range reads return 0 rather than trapping because the callers
; that matter - a lexer's lookahead - want "one past the end" to behave
; like an end-of-input sentinel, and NUL is already that sentinel here.
(pub :: strByte (-> String Int Int))
(pub fn (strByte s i)
  (if (< i 0)
      0
      (if (>= i (strLen s))
          0
          (__load8 (strData s) i))))

; The bytes of `s` as a NUL-terminated address, for handing to a
; syscall.
;
; Free: every `Str` this module builds is already NUL-terminated.
(pub :: strCStr (-> String Int))
(pub fn (strCStr s)
  (strData s))

(pub :: strIsEmpty (-> String Bool))
(pub fn (strIsEmpty s)
  (== (strLen s) 0))

; ------------------------------------------------------------------
; Comparison
; ------------------------------------------------------------------

; 0 when equal; otherwise negative if `a` sorts before `b`, positive if
; after - lexicographic by unsigned byte, with a shorter prefix sorting
; first.
(pub :: strCmp (-> String String Int))
(pub fn (strCmp a b)
  (let ((la (strLen a))
        (lb (strLen b)))
    (let ((shared (if (< la lb) la lb)))
      (let ((diff (memCmp (strData a) (strData b) shared)))
        (if (!= diff 0) diff (- la lb))))))

; Equality, which is NOT `strCmp a b == 0` even though it answers the
; same thing. `strCmp` must produce an ORDERING, so it memcmps the
; shared prefix before it ever looks at the lengths - and equality does
; not need the ordering. Two strings of different lengths are unequal
; whatever their bytes say, so checking the length first turns the
; commonest case, a miss, into two word loads and a compare.
;
; It matters because `strEq` is the compiler's hottest predicate: every
; keyword test in the lexer, every `lookupType`, every `findFSig`, and
; `mangledFor`, which walks a Vec holding every top-level name in the
; program once per call site. `findFSigIn` (codegen.ax) already carries
; a hand-rolled length pre-check in front of its `strEq` - somebody met
; this before and fixed it locally. This fixes it for every caller.
;
; Measured on `emit-llvm` of the compiler's own source, both compilers
; built the same way by the same builder at `--opt 1`, best of 5 on an
; idle machine: 2.8121s to 1.7218s, 1.63x. The self-hosting fixpoint
; holds under the change.
(pub :: strEq (-> String String Bool))
(pub fn (strEq a b)
  (let ((la (strLen a)))
    (if (!= la (strLen b))
        false
        (== (memCmp (strData a) (strData b) la) 0))))

; ------------------------------------------------------------------
; Slicing and joining
; ------------------------------------------------------------------

; The `count` bytes of `s` starting at `start`, sharing `s`'s storage.
;
; A slice is *not* NUL-terminated unless it happens to end where `s`
; does, so `strCStr` must not be called on one; `strDup` produces an
; owned, terminated copy when that is needed. Sharing rather than
; copying is the whole point - a tokenizer that copied every lexeme
; would allocate once per token.
;
; `start` and `count` are clamped to `s`, so an out-of-range slice is
; empty rather than a read of unrelated memory.
(pub :: strSlice (-> String Int Int String))
(pub fn (strSlice s start count)
  (let ((len (strLen s)))
    (let ((from (if (< start 0) 0 (if (> start len) len start))))
      (let ((avail (- len from)))
        (let ((n (if (< count 0) 0 (if (> count avail) avail count))))
          (let ((owner (strOwner s)))
            {
              ; the slice's own share of the bytes it now points into
              (__retain owner)
              (strWrapOwned (+ (strData s) from) n owner)
            }))))))

; An owned, NUL-terminated copy of `s`.
(pub :: strDup (-> String String))
(pub fn (strDup s)
  (let ((len (strLen s)))
    (let ((out (strAlloc len)))
      {
        (memCopy (strData out) (strData s) len)
        out
      })))

(pub :: strConcat (-> String String String))
(pub fn (strConcat a b)
  (let ((la (strLen a))
        (lb (strLen b)))
    (let ((out (strAlloc (+ la lb))))
      {
        (memCopy (strData out) (strData a) la)
        (memCopy (+ (strData out) la) (strData b) lb)
        out
      })))

; ------------------------------------------------------------------
; Searching
; ------------------------------------------------------------------

; Index of the first `byte` at or after `from`, or -1.
(pub :: strFindByte (-> String Int Int Int))
(pub fn (strFindByte s byte from)
  (if (>= from (strLen s))
      (- 0 1)
      (if (== (strByte s from) byte)
          from
          (strFindByte s byte (+ from 1)))))

(pub :: strStartsWith (-> String String Bool))
(pub fn (strStartsWith s prefix)
  (let ((lp (strLen prefix)))
    (if (> lp (strLen s))
        false
        (== (memCmp (strData s) (strData prefix) lp) 0))))

; ------------------------------------------------------------------
; Byte classification.
;
; One statement of each rule, because there were three of "what is a
; space" and two each of "digit" and "alpha", in `lexer.ax`,
; `format.ax` and `Json.ax`, and nothing compared them. That is not a
; hypothetical: `isFSpace` used to admit VT (11) and FF (12) - they
; came from the retired compiler's `char::is_whitespace` and the lexer
; never accepted them - so `fmt` rewrote a file `check` refuses with
; AX1001 into one it accepts, turning an invalid program into a valid
; one at exit 0. The comment on `isFSpace` has said "exactly
; `lexer.ax`'s `isSpace`, byte for byte" ever since, which is a claim
; a reader has to verify by hand every time either one changes.
;
; The predicates in `lexer.ax` and `format.ax` are kept - they are
; named in diagnostics and imported by name - and now delegate here,
; so the claim is structural rather than editorial.
; `tests/selfhost/990-char-class.ax` sweeps all 256 byte values
; through every one of them and requires the delegations to agree,
; which is the check that would have caught the VT/FF drift.
; ------------------------------------------------------------------

(pub :: strIsDigit (-> Int Bool))
(pub fn (strIsDigit ch)
  (if (>= ch 48) (<= ch 57) false))

(pub :: strIsAlpha (-> Int Bool))
(pub fn (strIsAlpha ch)
  (if (>= ch 65)
      (if (<= ch 90) true (if (>= ch 97) (<= ch 122) false))
      false))

; Space, tab, LF, CR - and nothing else. Not `char::is_whitespace`:
; VT and FF are AX1001 to this language's lexer, and a formatter that
; skipped them turned a refused file into an accepted one.
(pub :: strIsSpace (-> Int Bool))
(pub fn (strIsSpace ch)
  (if (== ch 32) true
  (if (== ch 10) true
  (if (== ch 13) true
  (if (== ch 9)  true
  false)))))

; The value of a hex digit, or -1. Stated as the VALUE and not as a
; predicate because the value is what every caller needed: the JSON
; parser's `\uXXXX` escape and the language server's percent-decoding
; each carried a byte-identical copy of this ladder under its own name,
; while the predicate here had no caller at all.
(pub :: strHexVal (-> Int Int))
(pub fn (strHexVal ch)
  (if (&& (>= ch 48) (<= ch 57)) (- ch 48)
  (if (&& (>= ch 97) (<= ch 102)) (+ 10 (- ch 97))
  (if (&& (>= ch 65) (<= ch 70)) (+ 10 (- ch 65))
  (- 0 1)))))

(pub :: strIsHexDigit (-> Int Bool))
(pub fn (strIsHexDigit ch) (>= (strHexVal ch) 0))

; ------------------------------------------------------------------
; Splitting
; ------------------------------------------------------------------

; Every segment of `s` between occurrences of `byte`, in order, as a
; Vec of Str handles. Empty segments are KEPT: a `PATH` entry of ""
; means the working directory, and a caller that wants them dropped
; can drop them, while a caller that needs them cannot get them back.
; `strSplit "" 58` answers one empty segment, and `strSplit "a:" 58`
; answers two - the same rule as splitting on a separator anywhere
; else, and the one that makes the segment count equal the separator
; count plus one.
;
; The segments are SLICES: they share `s`'s bytes and are not
; NUL-terminated. `strCStr` or `strConcat` where a syscall needs a C
; string - the two call sites this replaced both did that already, and
; for that reason.
(pub :: strSplit (-> String Int Int))
(pub fn (strSplit s byte)
  (let ((out vecNew))
    { (strSplitFrom s byte 0 out) out }))

(pub :: strSplitFrom (-> String Int Int Int Int))
(pub fn (strSplitFrom s byte from out)
  (let ((cut (strFindByte s byte from)))
    (let ((end (if (< cut 0) (strLen s) cut)))
      {
        (vecPush out (cast Int (strSlice s from (- end from))))
        (if (< cut 0) 0 (strSplitFrom s byte (+ end 1) out))
      })))

; A one-byte `Str` holding `b`. The compiler driver and the JSON
; encoder each had this three-line allocate-and-store under a private
; name; it is a `Str` constructor, so it lives with the others.
(pub :: strFromByte (-> Int String))
(pub fn (strFromByte b)
  (let ((s (strAlloc 1))) { (__store8 (strData s) 0 b) s }))
