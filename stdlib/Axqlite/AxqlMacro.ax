; A SELECT from table `t`: its select list (`*`, one column, or a list
; of columns and `(as e name)` items), then its clauses in this order,
; each optional: `(where e)`, `(orderBy term ...)`, `(limit n)`, and
; `(offset n)` after a `limit`. `n` is an Axiom `Int`, bound as a
; parameter.
;
;     (axqlSelect users * (where (= id (int 7))))
;     (axqlSelect users (name (as (* age (int 12)) months)) (orderBy (name desc)) (limit 5) (offset 10))
(pub emacro axqlSelect (literals * where limit offset)
  ((axqlSelect axqlArgT *)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "SELECT * FROM ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlFinish axqlArgQb)
      }))
  ((axqlSelect axqlArgT * (where axqlArgW))
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "SELECT * FROM ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " WHERE ")
        (axqlExpr axqlArgQb axqlArgW)
        (axqlFinish axqlArgQb)
      }))
  ((axqlSelect axqlArgT * (limit axqlArgN))
