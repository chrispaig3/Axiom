; Axqlite.AxqlMacro - AXQL statements written as Axiom forms.
;
;     (axqlSelect users (id name) (where (> age (int minAge))) (orderBy (age desc)) (limit 10))
;         ; (Query "SELECT id, name FROM users WHERE age > ? ORDER BY age DESC LIMIT ?"
;         ;        [(VInt minAge), (VInt 10)])
;     (axqlInsert users (name age) (values (text "Ada") (int 36)))
;     (axqlUpdate users (assign (age (+ age (int 1)))) (where (= id (int uid))))
;     (axqlDelete users (where (< age (int 18))))
;     (axqlCreateTable IF NOT EXISTS users (id INTEGER PRIMARY KEY) (name TEXT NOT NULL))
;     (axqlTable User users (id RowId) (name String) (age OptInt))
;
; Each statement macro checks the statement's shape when the program
; compiles, and expands to a `Query`: the statement's AXQL text, which
; `axqRunOn` and its siblings parse like any other, and its parameters.
; A form out of place, such as a missing table, a clause out of order
; or a word the macro doesn't know, matches no rule and is a compile
; error at the invocation.
;
; Names and values: a bare identifier is the name of a table, a column or
; an index, written into the text (in double quotes when it must be). An
; Axiom value enters only through a marker (`(int e)`, `(real e)`,
; `(text e)`, `(blob e)`, or `(param v)` for a `Value`) and always as
; a bound parameter, `?` in the text. No value is ever spelled into the
; text, so a value can't change what a statement means. `null` is NULL.
;
; Limits: a macro can't tell the number 18 from a column name, so a
; macro form has no number or string literals, and a constant goes
; through a marker like any other value. A list inside a form (a select
; list, the values of a row, ORDER BY terms, an index's columns) holds
; at most 16 items, and an expression written as an item of a select
; list needs a name, `(as e name)`. `axqlTable` takes 1 to 16 fields.
; Names beginning `axqlArg` are the macros' own and can't be used in a
; form. The text form has none of these limits.
;
; The text: a macro writes one canonical spelling, with keywords in
; capitals, one space between words, `, ` between list items, and an
; operand in parentheses only when it is itself an operation, so
; `(and (> age (int 18)) (= name (text n)))` is `(age > ?) AND (name = ?)`.
(import Mem)
(import Str)
(import Vec)
(import Err)
(import Axqlite.Value)
(import Axqlite.AxqlParse)

; ------------------------------------------------------------------
; Queries.
; ------------------------------------------------------------------
; A statement's text with the values of its parameters, in order. The
; `axql...` macros build one; `axqRunOn`, `axqQueryOn` and
; `axqQueryEachOn` run one.
(pub struct Query
  (text : String)
  (params : (Vec Value)))

; A query being written: the text in pieces, and the parameters so far.
; The statement macros make one, append to it left to right, and finish
; it; a program has no need to touch one.
(pub struct QueryBuilder
  (pieces : (Vec String))
  (params : (Vec Value)))

; An empty builder.
(pub :: axqlBuilder QueryBuilder)
(pub fn (axqlBuilder)
  (QueryBuilder vecNew vecNew))

; Append text the macro spells.
(pub :: axqlPut (-> QueryBuilder String Int))
(pub fn (axqlPut qb s)
  {
    (vecPush qb.pieces s)
    0
  })

; Append a name, in double quotes when AXQL needs them.
(pub :: axqlPutName (-> QueryBuilder String Int))
(pub fn (axqlPutName qb name)
  (axqlPut qb (axqlQuoteName name)))

; Append a parameter: `?` in the text, `v` in the parameters.
(pub :: axqlPutParam (-> QueryBuilder Value Int))
(pub fn (axqlPutParam qb v)
  {
    (vecPush qb.params v)
    (axqlPut qb "?")
  })

; The finished query.
(pub :: axqlFinish (-> QueryBuilder Query))
(pub fn (axqlFinish qb)
  (let ((mut n 0))
    {
      (for p in qb.pieces
        (set n (+ n (strLen p))))
      (let (
        (out (strAlloc n))
        (mut at 0)
      )
        {
          (for p in qb.pieces
            {
              (memCopy (+ (strData out) at) (strData p) (strLen p))
              (set at (+ at (strLen p)))
            })
          (Query out qb.params)
        })
    }))

; `name` as AXQL writes a name: bare when it can be, else in double
; quotes with each `"` inside doubled.
(pub :: axqlQuoteName (-> String String))
(pub fn (axqlQuoteName name)
  (if (axqlNameNeedsQuotes name)
    (let (
      (n (strLen name))
      (mut quotes 0)
    )
      {
        (for i in 0..n
          (if (== (strByte name i) 34)
            (set quotes (+ quotes 1))
            0))
        (let (
          (out (strAlloc (+ (+ n quotes) 2)))
          (d (strData out))
          (mut k 1)
        )
          {
            (memPutByte d 0 34)
            (for i in 0..n
              (let ((c (strByte name i)))
                {
                  (memPutByte d k c)
                  (set k (+ k 1))
                  (if (== c 34)
                    {
                      (memPutByte d k 34)
                      (set k (+ k 1))
                    }
                    0)
                }))
            (memPutByte d k 34)
            out
          })
      })
    name))

; ------------------------------------------------------------------
; Types for `axqlTable`.
; ------------------------------------------------------------------
; A field that is its table's INTEGER PRIMARY KEY, the rowid.
(pub type RowId = Int)

; A field holding a BLOB's bytes.
(pub type Bytes = String)

; An INTEGER column that may be NULL: `None` is NULL.
(pub type OptInt = (Option Int))

; A REAL column that may be NULL.
(pub type OptFloat = (Option Float))

; A TEXT column that may be NULL.
(pub type OptString = (Option String))

; A BLOB column that may be NULL.
(pub type OptBytes = (Option String))

; Append a parameter's value with no `?`, for a statement whose text
; already holds its marks.
(pub :: axqlAddParam (-> QueryBuilder Value Int))
(pub fn (axqlAddParam qb v)
  {
    (vecPush qb.params v)
    0
  })

; An optional INTEGER as a parameter: `None` is NULL.
(pub :: axqlOptIntValue (-> (Option Int) Value))
(pub fn (axqlOptIntValue o)
  (match o
    ((Some n) (VInt n))
    ((None) VNull)))

; An optional REAL as a parameter.
(pub :: axqlOptFloatValue (-> (Option Float) Value))
(pub fn (axqlOptFloatValue o)
  (match o
    ((Some x) (VReal x))
    ((None) VNull)))

; An optional TEXT as a parameter.
(pub :: axqlOptTextValue (-> (Option String) Value))
(pub fn (axqlOptTextValue o)
  (match o
    ((Some s) (VText s))
    ((None) VNull)))

; An optional BLOB as a parameter.
(pub :: axqlOptBlobValue (-> (Option String) Value))
(pub fn (axqlOptBlobValue o)
  (match o
    ((Some b) (VBlob b))
    ((None) VNull)))

; Where a form's head isn't an operator AXQL has. It matches nothing,
; so the compiler's refusal names it: "no rule of macro
; `axqlUnknownOperator` matches this invocation".
(emacro axqlUnknownOperator (literals axqlNoSuchOperator)
  ((axqlUnknownOperator axqlNoSuchOperator) 0))

; ------------------------------------------------------------------
; Single forms.
; ------------------------------------------------------------------
; A name, as `axqlPutName` writes it, from an identifier.
(pub emacro axqlPutNameOf ((axqlPutNameOf axqlArgQb axqlArgC) (axqlPutName axqlArgQb (syntax/name axqlArgC))))

; One select-list item: a column, or `(as e name)`.
(emacro axqlItem (literals as)
  ((axqlItem axqlArgQb (as axqlArgE axqlArgN))
    {
      (axqlExpr axqlArgQb axqlArgE)
      (axqlPut axqlArgQb " AS ")
      (axqlPutName axqlArgQb (syntax/name axqlArgN))
    })
  ((axqlItem axqlArgQb axqlArgC) (axqlPutName axqlArgQb (syntax/name axqlArgC))))

; One ORDER BY term: a column, `(column desc)` or `(column asc)`, or
; `(desc e)` or `(asc e)` for any expression.
(emacro axqlOrderTerm (literals asc desc)
  ((axqlOrderTerm axqlArgQb (desc axqlArgE))
    {
      (axqlExpr axqlArgQb axqlArgE)
      (axqlPut axqlArgQb " DESC")
    })
  ((axqlOrderTerm axqlArgQb (asc axqlArgE))
    {
      (axqlExpr axqlArgQb axqlArgE)
      (axqlPut axqlArgQb " ASC")
    })
  ((axqlOrderTerm axqlArgQb (axqlArgC desc))
    {
      (axqlPutName axqlArgQb (syntax/name axqlArgC))
      (axqlPut axqlArgQb " DESC")
    })
  ((axqlOrderTerm axqlArgQb (axqlArgC asc))
    {
      (axqlPutName axqlArgQb (syntax/name axqlArgC))
      (axqlPut axqlArgQb " ASC")
    })
  ((axqlOrderTerm axqlArgQb axqlArgC) (axqlPutName axqlArgQb (syntax/name axqlArgC))))

; One `(column e)` assignment.
(emacro axqlAssign ((axqlAssign axqlArgQb (axqlArgC axqlArgE))
    {
      (axqlPutName axqlArgQb (syntax/name axqlArgC))
      (axqlPut axqlArgQb " = ")
      (axqlExpr axqlArgQb axqlArgE)
    }))

(emacro axqlTypeWord (literals INTEGER REAL TEXT BLOB)
  ((axqlTypeWord axqlArgQb INTEGER) (axqlPut axqlArgQb "INTEGER"))
  ((axqlTypeWord axqlArgQb REAL) (axqlPut axqlArgQb "REAL"))
  ((axqlTypeWord axqlArgQb TEXT) (axqlPut axqlArgQb "TEXT"))
  ((axqlTypeWord axqlArgQb BLOB) (axqlPut axqlArgQb "BLOB")))

; One column: `(name TYPE)` with `NOT NULL`, `PRIMARY KEY`, both, or
; neither after the type.
(emacro axqlColumnDef (literals NOT NULL PRIMARY KEY)
  ((axqlColumnDef axqlArgQb (axqlArgC axqlArgTy NOT NULL PRIMARY KEY))
    {
      (axqlColumnDef axqlArgQb (axqlArgC axqlArgTy))
      (axqlPut axqlArgQb " NOT NULL PRIMARY KEY")
    })
  ((axqlColumnDef axqlArgQb (axqlArgC axqlArgTy PRIMARY KEY NOT NULL))
    {
      (axqlColumnDef axqlArgQb (axqlArgC axqlArgTy))
      (axqlPut axqlArgQb " PRIMARY KEY NOT NULL")
    })
  ((axqlColumnDef axqlArgQb (axqlArgC axqlArgTy NOT NULL))
    {
      (axqlColumnDef axqlArgQb (axqlArgC axqlArgTy))
      (axqlPut axqlArgQb " NOT NULL")
    })
  ((axqlColumnDef axqlArgQb (axqlArgC axqlArgTy PRIMARY KEY))
    {
      (axqlColumnDef axqlArgQb (axqlArgC axqlArgTy))
      (axqlPut axqlArgQb " PRIMARY KEY")
    })
  ((axqlColumnDef axqlArgQb (axqlArgC axqlArgTy))
    {
      (axqlPutName axqlArgQb (syntax/name axqlArgC))
      (axqlPut axqlArgQb " ")
      (axqlTypeWord axqlArgQb axqlArgTy)
    }))

; An `axqlTable` field as its column.
(pub emacro axqlColumnOf (literals Int Float String Bytes RowId OptInt OptFloat OptString OptBytes)
  ((axqlColumnOf axqlArgQb axqlArgF Int) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "INTEGER NOT NULL"))
  ((axqlColumnOf axqlArgQb axqlArgF Float) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "REAL NOT NULL"))
  ((axqlColumnOf axqlArgQb axqlArgF String) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "TEXT NOT NULL"))
  ((axqlColumnOf axqlArgQb axqlArgF Bytes) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "BLOB NOT NULL"))
  ((axqlColumnOf axqlArgQb axqlArgF RowId) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "INTEGER PRIMARY KEY"))
  ((axqlColumnOf axqlArgQb axqlArgF OptInt) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "INTEGER"))
  ((axqlColumnOf axqlArgQb axqlArgF OptFloat) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "REAL"))
  ((axqlColumnOf axqlArgQb axqlArgF OptString) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "TEXT"))
  ((axqlColumnOf axqlArgQb axqlArgF OptBytes) (axqlPutColumn axqlArgQb (syntax/name axqlArgF) "BLOB")))

; Append `name TYPE...`.
(pub :: axqlPutColumn (-> QueryBuilder String String Int))
(pub fn (axqlPutColumn qb name decl)
  {
    (axqlPutName qb name)
    (axqlPut qb " ")
    (axqlPut qb decl)
  })

; An `axqlTable` field's value as a parameter.
(pub emacro axqlFieldValue (literals Int Float String Bytes RowId OptInt OptFloat OptString OptBytes)
  ((axqlFieldValue Int axqlArgV) (VInt axqlArgV))
  ((axqlFieldValue Float axqlArgV) (VReal axqlArgV))
  ((axqlFieldValue String axqlArgV) (VText axqlArgV))
  ((axqlFieldValue Bytes axqlArgV) (VBlob axqlArgV))
  ((axqlFieldValue RowId axqlArgV) (VInt axqlArgV))
  ((axqlFieldValue OptInt axqlArgV) (axqlOptIntValue axqlArgV))
  ((axqlFieldValue OptFloat axqlArgV) (axqlOptFloatValue axqlArgV))
  ((axqlFieldValue OptString axqlArgV) (axqlOptTextValue axqlArgV))
  ((axqlFieldValue OptBytes axqlArgV) (axqlOptBlobValue axqlArgV)))

; An `axqlTable` field read from a row by its column's name.
(pub emacro axqlReadField (literals Int Float String Bytes RowId OptInt OptFloat OptString OptBytes)
  ((axqlReadField axqlArgRd axqlArgF Int) (axqlReadInt axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF Float) (axqlReadReal axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF String) (axqlReadText axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF Bytes) (axqlReadBlob axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF RowId) (axqlReadInt axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF OptInt) (axqlReadOptInt axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF OptFloat) (axqlReadOptReal axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF OptString) (axqlReadOptText axqlArgRd (syntax/name axqlArgF)))
  ((axqlReadField axqlArgRd axqlArgF OptBytes) (axqlReadOptBlob axqlArgRd (syntax/name axqlArgF))))

; ------------------------------------------------------------------
; UPDATE, DELETE, and the DDL with no lists.
; ------------------------------------------------------------------
; An UPDATE of table `t`: `(assign (column e) ...)`, then an optional
; `(where e)`. The word is `assign` because `set` is Axiom's own.
;
;     (axqlUpdate users (assign (age (+ age (int 1))) (name (text n))) (where (= id (int uid))))
(pub emacro axqlUpdate (literals where)
  ((axqlUpdate axqlArgT axqlArgSets (where axqlArgW))
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "UPDATE ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " SET ")
        (axqlSpread axqlAssigns axqlArgQb axqlArgSets)
        (axqlPut axqlArgQb " WHERE ")
        (axqlExpr axqlArgQb axqlArgW)
        (axqlFinish axqlArgQb)
      }))
  ((axqlUpdate axqlArgT axqlArgSets)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "UPDATE ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " SET ")
        (axqlSpread axqlAssigns axqlArgQb axqlArgSets)
        (axqlFinish axqlArgQb)
      })))

; A DELETE from table `t`, with an optional `(where e)`.
;
;     (axqlDelete sessions (where (< expires (int now))))
(pub emacro axqlDelete (literals where)
  ((axqlDelete axqlArgT (where axqlArgW))
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "DELETE FROM ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " WHERE ")
        (axqlExpr axqlArgQb axqlArgW)
        (axqlFinish axqlArgQb)
      }))
  ((axqlDelete axqlArgT)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "DELETE FROM ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlFinish axqlArgQb)
      })))

; A DROP TABLE, with an optional `IF EXISTS`.
(pub emacro axqlDropTable (literals IF EXISTS)
  ((axqlDropTable IF EXISTS axqlArgT)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "DROP TABLE IF EXISTS ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlFinish axqlArgQb)
      }))
  ((axqlDropTable axqlArgT)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "DROP TABLE ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlFinish axqlArgQb)
      })))

; The words of a CREATE INDEX from the index's name on.
(emacro axqlIndexRest ((axqlIndexRest axqlArgQb axqlArgI axqlArgT axqlArgCols)
    {
      (axqlPutName axqlArgQb (syntax/name axqlArgI))
      (axqlPut axqlArgQb " ON ")
      (axqlPutName axqlArgQb (syntax/name axqlArgT))
      (axqlPut axqlArgQb " (")
      (axqlSpread axqlNames axqlArgQb axqlArgCols)
      (axqlPut axqlArgQb ")")
    }))

; A CREATE INDEX: optional `UNIQUE` and `IF NOT EXISTS`, the index's
; name, `ON`, the table, and its columns.
;
;     (axqlCreateIndex UNIQUE usersByEmail ON users (email))
(pub emacro axqlCreateIndex (literals UNIQUE IF NOT EXISTS ON)
  ((axqlCreateIndex UNIQUE IF NOT EXISTS axqlArgI ON axqlArgT axqlArgCols)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "CREATE UNIQUE INDEX IF NOT EXISTS ")
        (axqlIndexRest axqlArgQb axqlArgI axqlArgT axqlArgCols)
        (axqlFinish axqlArgQb)
      }))
  ((axqlCreateIndex UNIQUE axqlArgI ON axqlArgT axqlArgCols)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "CREATE UNIQUE INDEX ")
        (axqlIndexRest axqlArgQb axqlArgI axqlArgT axqlArgCols)
        (axqlFinish axqlArgQb)
      }))
  ((axqlCreateIndex IF NOT EXISTS axqlArgI ON axqlArgT axqlArgCols)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "CREATE INDEX IF NOT EXISTS ")
        (axqlIndexRest axqlArgQb axqlArgI axqlArgT axqlArgCols)
        (axqlFinish axqlArgQb)
      }))
  ((axqlCreateIndex axqlArgI ON axqlArgT axqlArgCols)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "CREATE INDEX ")
        (axqlIndexRest axqlArgQb axqlArgI axqlArgT axqlArgCols)
        (axqlFinish axqlArgQb)
      })))

; A DROP INDEX, with an optional `IF EXISTS`.
(pub emacro axqlDropIndex (literals IF EXISTS)
  ((axqlDropIndex IF EXISTS axqlArgI)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "DROP INDEX IF EXISTS ")
        (axqlPutName axqlArgQb (syntax/name axqlArgI))
        (axqlFinish axqlArgQb)
      }))
  ((axqlDropIndex axqlArgI)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "DROP INDEX ")
        (axqlPutName axqlArgQb (syntax/name axqlArgI))
        (axqlFinish axqlArgQb)
      })))

; The statements whose lists `axqlInsert` and `axqlCreateTable` pack
; under a head word.
(emacro axqlRow ((axqlRow axqlArgQb axqlArgR)
    {
      (axqlPut axqlArgQb "(")
      (axqlSpread axqlValuesOf axqlArgQb axqlArgR)
      (axqlPut axqlArgQb ")")
    }))

(emacro axqlInsertAll ((axqlInsertAll axqlArgT axqlArgRows)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "INSERT INTO ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " VALUES ")
        (axqlSpread axqlRows axqlArgQb axqlArgRows)
        (axqlFinish axqlArgQb)
      })))

(emacro axqlInsertInto ((axqlInsertInto axqlArgT axqlArgCols axqlArgRows)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb "INSERT INTO ")
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " (")
        (axqlSpread axqlNames axqlArgQb axqlArgCols)
        (axqlPut axqlArgQb ") VALUES ")
        (axqlSpread axqlRows axqlArgQb axqlArgRows)
        (axqlFinish axqlArgQb)
      })))

(emacro axqlCreateTableOf ((axqlCreateTableOf axqlArgHead axqlArgT axqlArgCols)
    (let ((axqlArgQb axqlBuilder))
      {
        (axqlPut axqlArgQb axqlArgHead)
        (axqlPutName axqlArgQb (syntax/name axqlArgT))
        (axqlPut axqlArgQb " (")
        (axqlSpread axqlColumnDefs axqlArgQb axqlArgCols)
        (axqlPut axqlArgQb ")")
        (axqlFinish axqlArgQb)
      })))

; One `?`, for a field of `axqlTable`'s INSERT.
(pub emacro axqlMark ((axqlMark axqlArgQb axqlArgF) (axqlPut axqlArgQb "?")))

; One `(name Type)` field of `axqlTable` as its column.
(pub emacro axqlFieldColumn ((axqlFieldColumn axqlArgQb (axqlArgF axqlArgT)) (axqlColumnOf axqlArgQb axqlArgF axqlArgT)))

; The second half of `axqlTable`, which it invokes: what it declares
; once the struct exists, because a struct's fields can be read by name
; only through `syntax/fields`, which answers only for a struct already
; declared. It is public because a declaration macro's own invocation is
; resolved where `axqlTable` is used; a program has no need to call it.
(pub macro axqlTableRest ((axqlTableRest axqlArgS axqlArgTbl axqlArgNames axqlArgTypes axqlArgFields)
   (pub :: (syntax/join (syntax/join create axqlArgS) Table) Query)
   (pub fn ((syntax/join (syntax/join create axqlArgS) Table))
     (let ((axqlArgQb axqlBuilder))
       {
         (axqlPut axqlArgQb "CREATE TABLE ")
         (axqlPutName axqlArgQb (syntax/name axqlArgTbl))
         (axqlPut axqlArgQb " (")
         (axqlSpread axqlFieldColumns axqlArgQb axqlArgFields)
         (axqlPut axqlArgQb ")")
         (axqlFinish axqlArgQb)
       }))
   (pub :: (syntax/join selectAll axqlArgS) Query)
   (pub fn ((syntax/join selectAll axqlArgS))
     (let ((axqlArgQb axqlBuilder))
       {
         (axqlPut axqlArgQb "SELECT ")
         (axqlSpread axqlFieldNames axqlArgQb axqlArgNames)
         (axqlPut axqlArgQb " FROM ")
         (axqlPutName axqlArgQb (syntax/name axqlArgTbl))
         (axqlFinish axqlArgQb)
       }))
   (pub :: (syntax/join insert axqlArgS) (-> Connection axqlArgS (Result Int Error)))
   ;@axiom:effect(io)
   (pub fn ((syntax/join insert axqlArgS) axqlArgDb axqlArgU)
     (let ((axqlArgQb axqlBuilder))
       {
         (axqlPut axqlArgQb "INSERT INTO ")
         (axqlPutName axqlArgQb (syntax/name axqlArgTbl))
         (axqlPut axqlArgQb " (")
         (axqlSpread axqlFieldNames axqlArgQb axqlArgNames)
         (axqlPut axqlArgQb ") VALUES (")
         (axqlSpread axqlMarks axqlArgQb axqlArgNames)
         (axqlPut axqlArgQb ")")
         (axqlFieldValues axqlArgQb axqlArgTypes (syntax/for (axqlArgG (syntax/fields axqlArgS)) axqlArgU.axqlArgG))
         (axqRunOn axqlArgDb (axqlFinish axqlArgQb))
       }))
   (pub :: (syntax/join query axqlArgS) (-> Connection Query (Result (Vec axqlArgS) Error)))
   ;@axiom:effect(io)
   (pub fn ((syntax/join query axqlArgS) axqlArgDb axqlArgQ)
     (axqQueryMap axqlArgDb axqlArgQ (lambda (axqlArgRow) ((syntax/join rowTo axqlArgS) axqlArgRow))))))

; ------------------------------------------------------------------
; The rule tables: one rule per list length, written out by
; tests/axqlite/tools/axql_macros.py (run it after changing a rule).
; ------------------------------------------------------------------
