;;! Axqlite.AxqlMacro - the compile-time help: queries with bound
;;! parameters, value literals, and codecs derived for your structs.
;;!
;;!     (bind (query "SELECT * FROM person WHERE age > $min") "min" (VInt 30))
;;!     (obj (name (VText "Ada")) (age (VInt 36)))
;;!     (deriveCodec personCodec Person
;;!       (name textCodec) (age (optionCodec intCodec)))
;
; A `Query` is AXQL text and the object its `$parameters` bind from:
; `query` starts one, `bind` adds a parameter, and `dbRunQuery` in
; `Axqlite` runs it. A parameter is a value, never text spliced into
; the statement, so a bound value can't change what it means.
;
; `obj` and `arr` spell a document or an array value, up to twelve
; parts each. Their elements are `Value` expressions, so every piece
; keeps the type the program wrote.
;
; `deriveCodec` assembles a `Codec` (in `Axqlite.Value`, where the
; codec parts live) for a struct you already have: name the codec,
; the struct, and one codec per field, in declaration order. The
; struct stays yours - the macro writes only the codec - and
; `Axqlite`'s `dbCreateAs` and kin run it. One to twelve fields.
; Names beginning `axqlArg` are the macros' own.
(import Str)
(import Vec)
(import Axqlite.Value)

; ------------------------------------------------------------------
; Queries.
; ------------------------------------------------------------------
;; AXQL text and the parameters it binds. `dbRunQuery` runs one.
(pub struct Query
  (text : String)
  (params : Value))

;; A query with nothing bound yet.
(pub :: query (-> String Query))
(pub fn (query text)
  (Query :text text :params emptyObject))

;; The query with `$name` bound to `value`.
(pub :: bind (-> Query String Value Query))
(pub fn (bind q name value)
  (Query :text q.text :params (objSet q.params name value)))

; ------------------------------------------------------------------
; Value literals.
; ------------------------------------------------------------------
(pub macro obj ((obj) (VObject vecNew))
  ((obj (axqlArgF1 axqlArgV1)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6) (axqlArgF7 axqlArgV7)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF7) :value axqlArgV7)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6) (axqlArgF7 axqlArgV7) (axqlArgF8 axqlArgV8)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF7) :value axqlArgV7)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF8) :value axqlArgV8)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6) (axqlArgF7 axqlArgV7) (axqlArgF8 axqlArgV8) (axqlArgF9 axqlArgV9)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF7) :value axqlArgV7)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF8) :value axqlArgV8)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF9) :value axqlArgV9)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6) (axqlArgF7 axqlArgV7) (axqlArgF8 axqlArgV8) (axqlArgF9 axqlArgV9) (axqlArgF10 axqlArgV10)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF7) :value axqlArgV7)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF8) :value axqlArgV8)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF9) :value axqlArgV9)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF10) :value axqlArgV10)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6) (axqlArgF7 axqlArgV7) (axqlArgF8 axqlArgV8) (axqlArgF9 axqlArgV9) (axqlArgF10 axqlArgV10) (axqlArgF11 axqlArgV11)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF7) :value axqlArgV7)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF8) :value axqlArgV8)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF9) :value axqlArgV9)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF10) :value axqlArgV10)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF11) :value axqlArgV11)) (VObject axqlArgFs) } })
  ((obj (axqlArgF1 axqlArgV1) (axqlArgF2 axqlArgV2) (axqlArgF3 axqlArgV3) (axqlArgF4 axqlArgV4) (axqlArgF5 axqlArgV5) (axqlArgF6 axqlArgV6) (axqlArgF7 axqlArgV7) (axqlArgF8 axqlArgV8) (axqlArgF9 axqlArgV9) (axqlArgF10 axqlArgV10) (axqlArgF11 axqlArgV11) (axqlArgF12 axqlArgV12)) { (let axqlArgFs vecNew) { (vecPush axqlArgFs (Field :name (syntax/name axqlArgF1) :value axqlArgV1)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF2) :value axqlArgV2)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF3) :value axqlArgV3)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF4) :value axqlArgV4)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF5) :value axqlArgV5)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF6) :value axqlArgV6)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF7) :value axqlArgV7)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF8) :value axqlArgV8)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF9) :value axqlArgV9)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF10) :value axqlArgV10)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF11) :value axqlArgV11)) (vecPush axqlArgFs (Field :name (syntax/name axqlArgF12) :value axqlArgV12)) (VObject axqlArgFs) } }))

(pub macro arr ((arr) (VArray vecNew))
  ((arr axqlArgV1) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6 axqlArgV7) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (vecPush axqlArgXs axqlArgV7) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6 axqlArgV7 axqlArgV8) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (vecPush axqlArgXs axqlArgV7) (vecPush axqlArgXs axqlArgV8) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6 axqlArgV7 axqlArgV8 axqlArgV9) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (vecPush axqlArgXs axqlArgV7) (vecPush axqlArgXs axqlArgV8) (vecPush axqlArgXs axqlArgV9) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6 axqlArgV7 axqlArgV8 axqlArgV9 axqlArgV10) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (vecPush axqlArgXs axqlArgV7) (vecPush axqlArgXs axqlArgV8) (vecPush axqlArgXs axqlArgV9) (vecPush axqlArgXs axqlArgV10) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6 axqlArgV7 axqlArgV8 axqlArgV9 axqlArgV10 axqlArgV11) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (vecPush axqlArgXs axqlArgV7) (vecPush axqlArgXs axqlArgV8) (vecPush axqlArgXs axqlArgV9) (vecPush axqlArgXs axqlArgV10) (vecPush axqlArgXs axqlArgV11) (VArray axqlArgXs) } })
  ((arr axqlArgV1 axqlArgV2 axqlArgV3 axqlArgV4 axqlArgV5 axqlArgV6 axqlArgV7 axqlArgV8 axqlArgV9 axqlArgV10 axqlArgV11 axqlArgV12) { (let axqlArgXs vecNew) { (vecPush axqlArgXs axqlArgV1) (vecPush axqlArgXs axqlArgV2) (vecPush axqlArgXs axqlArgV3) (vecPush axqlArgXs axqlArgV4) (vecPush axqlArgXs axqlArgV5) (vecPush axqlArgXs axqlArgV6) (vecPush axqlArgXs axqlArgV7) (vecPush axqlArgXs axqlArgV8) (vecPush axqlArgXs axqlArgV9) (vecPush axqlArgXs axqlArgV10) (vecPush axqlArgXs axqlArgV11) (vecPush axqlArgXs axqlArgV12) (VArray axqlArgXs) } }))

; ------------------------------------------------------------------
; Derived codecs. `deriveCodec` writes the two directions between a
; struct and a document from one codec per field. Writing reads the
; struct's own fields (through `axqlEncodeStruct`, which the macro
; system can only expand once the struct exists); reading builds it
; field by field with `codecField`.
; ------------------------------------------------------------------
(pub macro deriveCodec ((deriveCodec axqlArgName axqlArgS (axqlArgF1 axqlArgC1))
   (pub :: (syntax/join axqlArgName encode) (-> axqlArgS Value))
   (pub fn ((syntax/join axqlArgName encode) axqlArgR) { (let axqlArgFs vecNew) { (axqlPushCodecs axqlArgFs (codecs axqlArgC1) (syntax/for (axqlArgG (syntax/fields axqlArgS)) (axqlFieldPair (syntax/name axqlArgG) axqlArgR.axqlArgG))) (VObject axqlArgFs) } })
   (pub :: axqlArgName (Codec axqlArgS))
   (pub fn (axqlArgName)
     (Codec
       (lambda (axqlArgR) ((syntax/join axqlArgName encode) axqlArgR))
       (lambda (axqlArgDoc) (Ok (axqlArgS (codecField axqlArgC1 axqlArgDoc (syntax/name axqlArgF1))?))))))
  ((deriveCodec axqlArgName axqlArgS (axqlArgF1 axqlArgC1) (axqlArgF2 axqlArgC2))
   (pub :: (syntax/join axqlArgName encode) (-> axqlArgS Value))
   (pub fn ((syntax/join axqlArgName encode) axqlArgR) { (let axqlArgFs vecNew) { (axqlPushCodecs axqlArgFs (codecs axqlArgC1 axqlArgC2) (syntax/for (axqlArgG (syntax/fields axqlArgS)) (axqlFieldPair (syntax/name axqlArgG) axqlArgR.axqlArgG))) (VObject axqlArgFs) } })
   (pub :: axqlArgName (Codec axqlArgS))
   (pub fn (axqlArgName)
     (Codec
       (lambda (axqlArgR) ((syntax/join axqlArgName encode) axqlArgR))
       (lambda (axqlArgDoc) (Ok (axqlArgS (codecField axqlArgC1 axqlArgDoc (syntax/name axqlArgF1))? (codecField axqlArgC2 axqlArgDoc (syntax/name axqlArgF2))?))))))
  ((deriveCodec axqlArgName axqlArgS (axqlArgF1 axqlArgC1) (axqlArgF2 axqlArgC2) (axqlArgF3 axqlArgC3))
   (pub :: (syntax/join axqlArgName encode) (-> axqlArgS Value))
   (pub fn ((syntax/join axqlArgName encode) axqlArgR) { (let axqlArgFs vecNew) { (axqlPushCodecs axqlArgFs (codecs axqlArgC1 axqlArgC2 axqlArgC3) (syntax/for (axqlArgG (syntax/fields axqlArgS)) (axqlFieldPair (syntax/name axqlArgG) axqlArgR.axqlArgG))) (VObject axqlArgFs) } })
   (pub :: axqlArgName (Codec axqlArgS))
   (pub fn (axqlArgName)
     (Codec
       (lambda (axqlArgR) ((syntax/join axqlArgName encode) axqlArgR))
       (lambda (axqlArgDoc) (Ok (axqlArgS (codecField axqlArgC1 axqlArgDoc (syntax/name axqlArgF1))? (codecField axqlArgC2 axqlArgDoc (syntax/name axqlArgF2))? (codecField axqlArgC3 axqlArgDoc (syntax/name axqlArgF3))?))))))
  ((deriveCodec axqlArgName axqlArgS (axqlArgF1 axqlArgC1) (axqlArgF2 axqlArgC2) (axqlArgF3 axqlArgC3) (axqlArgF4 axqlArgC4))
   (pub :: (syntax/join axqlArgName encode) (-> axqlArgS Value))
   (pub fn ((syntax/join axqlArgName encode) axqlArgR) { (let axqlArgFs vecNew) { (axqlPushCodecs axqlArgFs (codecs axqlArgC1 axqlArgC2 axqlArgC3 axqlArgC4) (syntax/for (axqlArgG (syntax/fields axqlArgS)) (axqlFieldPair (syntax/name axqlArgG) axqlArgR.axqlArgG))) (VObject axqlArgFs) } })
   (pub :: axqlArgName (Codec axqlArgS))
   (pub fn (axqlArgName)
     (Codec
       (lambda (axqlArgR) ((syntax/join axqlArgName encode) axqlArgR))
       (lambda (axqlArgDoc) (Ok (axqlArgS (codecField axqlArgC1 axqlArgDoc (syntax/name axqlArgF1))? (codecField axqlArgC2 axqlArgDoc (syntax/name axqlArgF2))? (codecField axqlArgC3 axqlArgDoc (syntax/name axqlArgF3))? (codecField axqlArgC4 axqlArgDoc (syntax/name axqlArgF4))?))))))
  ((deriveCodec axqlArgName axqlArgS (axqlArgF1 axqlArgC1) (axqlArgF2 axqlArgC2) (axqlArgF3 axqlArgC3) (axqlArgF4 axqlArgC4) (axqlArgF5 axqlArgC5))
   (pub :: (syntax/join axqlArgName encode) (-> axqlArgS Value))
   (pub fn ((syntax/join axqlArgName encode) axqlArgR) { (let axqlArgFs vecNew) { (axqlPushCodecs axqlArgFs (codecs axqlArgC1 axqlArgC2 axqlArgC3 axqlArgC4 axqlArgC5) (syntax/for (axqlArgG (syntax/fields axqlArgS)) (axqlFieldPair (syntax/name axqlArgG) axqlArgR.axqlArgG))) (VObject axqlArgFs) } })
   (pub :: axqlArgName (Codec axqlArgS))
   (pub fn (axqlArgName)
     (Codec
       (lambda (axqlArgR) ((syntax/join axqlArgName encode) axqlArgR))
       (lambda (axqlArgDoc) (Ok (axqlArgS (codecField axqlArgC1 axqlArgDoc (syntax/name axqlArgF1))? (codecField axqlArgC2 axqlArgDoc (syntax/name axqlArgF2))? (codecField axqlArgC3 axqlArgDoc (syntax/name axqlArgF3))? (codecField axqlArgC4 axqlArgDoc (syntax/name axqlArgF4))? (codecField axqlArgC5 axqlArgDoc (syntax/name axqlArgF5))?))))))
  ((deriveCodec axqlArgName axqlArgS (axqlArgF1 axqlArgC1) (axqlArgF2 axqlArgC2) (axqlArgF3 axqlArgC3) (axqlArgF4 axqlArgC4) (axqlArgF5 axqlArgC5) (axqlArgF6 axqlArgC6))
   (pub :: (syntax/join axqlArgName encode) (-> axqlArgS Value))
   (pub fn ((syntax/join axqlArgName encode) axqlArgR) { (let axqlArgFs vecNew) { (axqlPushCodecs axqlArgFs (codecs axqlArgC1 axqlArgC2 axqlArgC3 axqlArgC4 axqlArgC5 axqlArgC6) (syntax/for (axqlArgG (syntax/fields axqlArgS)) (axqlFieldPair (syntax/name axqlArgG) axqlArgR.axqlArgG))) (VObject axqlArgFs) } })
   (pub :: axqlArgName (Codec axqlArgS))
   (pub fn (axqlArgName)
