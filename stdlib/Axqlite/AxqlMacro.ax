; The items of a select list. A list whose first item is `(as e n)`
; arrives with that item's three parts spread in front, because
; `((as e n) b)` and `(as e n b)` are one form.
(emacro axqlItems (literals as)
  ((axqlItems axqlArgQb as axqlArgE axqlArgN) (axqlItem axqlArgQb (as axqlArgE axqlArgN)))
  ((axqlItems axqlArgQb as axqlArgE axqlArgN axqlArgX2) { (axqlItem axqlArgQb (as axqlArgE axqlArgN)) (axqlPut axqlArgQb ", ") (axqlItems axqlArgQb axqlArgX2) })
  ((axqlItems axqlArgQb as axqlArgE axqlArgN axqlArgX2 axqlArgX3) { (axqlItem axqlArgQb (as axqlArgE axqlArgN)) (axqlPut axqlArgQb ", ") (axqlItems axqlArgQb axqlArgX2 axqlArgX3) })
  ((axqlItems axqlArgQb as axqlArgE axqlArgN axqlArgX2 axqlArgX3 axqlArgX4) { (axqlItem axqlArgQb (as axqlArgE axqlArgN)) (axqlPut axqlArgQb ", ") (axqlItems axqlArgQb axqlArgX2 axqlArgX3 axqlArgX4) })
