;;! Axqlite.AxqlExec - running statements against a database.
;;!
;;!     (axqlExecNew pager params false)       ; an executor on an open pager
;;!     (axqlRunScript ex parsed)             ; (Ok [values]), one per statement
;
; An `Exec` carries one run's state: the pager, the schema as loaded,
; the `$parameters` bound from outside, the `LET` variables in
; flight, and the transaction locks this run holds. `Axqlite` makes
; one per API call; a `BEGIN` leaves its write transaction open on
; the pager, and the next run on the same connection picks it up
; through the `inTxn` it is made with.
;
; LOCKING. A run takes what it needs statement by statement: a read
; lock for a query, a write transaction for a change. Outside an
; explicit transaction the run commits when it ends, and an error
; rolls everything back. Inside one - opened by `BEGIN` in an
; earlier run - an error leaves the transaction open for the caller
; to commit or cancel; a transaction a script opens and then fails
; inside is rolled back whole.
;
; Every statement answers a value. A query answers an array of rows,
; a write an array of the records it touched (or what its `RETURN`
; asks for), a definition `none`, and a script each statement's
; answer in order.
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Float)
(import Chrono)
(import Uuid)
(import Crypto.Random)
(import Axqlite.Value)
(import Axqlite.Pager)
(import Axqlite.Btree)
(import Axqlite.Record)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)
(import Axqlite.AxqlEval)
(import Axqlite.AxqlSchema)

; ------------------------------------------------------------------
; The executor's state.
; ------------------------------------------------------------------
; One variable binding.
(struct Binding
  (name : String)
  (mut value : Value))

;; One run over one pager.
(pub struct Exec
  (pager : Pager)
  (params : Value)
  (readOnly : Bool)
  (vars : (Vec Binding))
  (frames : (Vec Int))
  (mut schema : Schema)
  (mut schemaLoaded : Bool)
  (mut readOpen : Bool)
  (mut writeOpen : Bool)
  (mut explicit : Bool)
  (mut beganHere : Bool)
  (mut changes : Int)
  (mut eventDepth : Int)
  (mut callDepth : Int)
  (mut depth : Int))

;; An executor on `pager`, binding `$parameters` from the object
;; `params` (`VNone` for none). `inTxn` says a write transaction an
;; earlier run began is still open on the pager.
(pub :: axqlExecNew (-> Pager Value Bool Bool Exec))
(pub fn (axqlExecNew pager params readOnly inTxn)
  (Exec
    :pager pager
    :params params
    :readOnly readOnly
    :vars vecNew
    :frames (vecPush vecNew 0)
    :schema (Schema :entries vecNew)
    :schemaLoaded false
    :readOpen false
    :writeOpen inTxn
    :explicit inTxn
    :beganHere false
    :changes 0
    :eventDepth 0
    :callDepth 0
    :depth 0))

;; Whether this run sits inside an explicit transaction, for the
;; connection to remember when the run ends.
(pub :: axqlExecInTxn (-> Exec Bool))
(pub fn (axqlExecInTxn ex)
  ex.explicit)

;; How many records the run changed.
(pub :: axqlExecChanges (-> Exec Int))
(pub fn (axqlExecChanges ex)
  ex.changes)

; ------------------------------------------------------------------
; Locks and transactions.
; ------------------------------------------------------------------
(:: schemaOf (-> Exec (Result Schema Error)))
;@axiom:effect(io)
(fn (schemaOf ex)
  (if ex.schemaLoaded
    (Ok ex.schema)
    {
      (let _ (ensureRead ex)?)
      {
        (let s (axqlLoadSchema ex.pager)?)
        {
          (set ex.schema s)
          (set ex.schemaLoaded true)
          (Ok s)
        }
      }
    }))

(:: schemaDirty (-> Exec Int))
(fn (schemaDirty ex)
  {
    (set ex.schemaLoaded false)
    0
  })

(:: ensureRead (-> Exec (Result Int Error)))
;@axiom:effect(io)
(fn (ensureRead ex)
  (if (|| ex.readOpen ex.writeOpen)
    (Ok 0)
    {
      (let _ (pagerBeginRead ex.pager)?)
      {
        (set ex.readOpen true)
        (Ok 0)
      }
    }))

(:: ensureWrite (-> Exec (Result Int Error)))
;@axiom:effect(io)
(fn (ensureWrite ex)
  (if ex.writeOpen
    (Ok 0)
    (if ex.readOnly
      (axqErr axqReadOnly "the database was opened read-only" "axqlExec")
      {
        (let wasRead ex.readOpen)
        (match (pagerBeginWrite ex.pager)
          ((Ok _)
            {
              (set ex.writeOpen true)
              (set ex.readOpen false)
              {
                ; An upgrade may have lost the read's view, so what
                ; it read is read again.
                (if wasRead
                  (schemaDirty ex))
                (Ok 0)
              }
            }
          )
          ((Err e)
            {
              (set ex.readOpen false)
              (Err e)
            }
          ))
      })))

; End whatever this run holds outside an explicit transaction:
; commit a write, release a read.
(:: finishRun (-> Exec (Result Int Error)))
;@axiom:effect(io)
(fn (finishRun ex)
  (if ex.explicit
    (Ok 0)
    (if ex.writeOpen
      {
        (let r (pagerCommit ex.pager))
        {
          (set ex.writeOpen false)
          r
        }
      }
      (if ex.readOpen
        {
          (let r (pagerEndRead ex.pager))
          {
            (set ex.readOpen false)
            r
          }
        }
        (Ok 0)))))

; Roll back whatever this run holds. An explicit transaction opened
; by an earlier run stays open: it is the caller's to end.
(:: abortRun (-> Exec Int))
;@axiom:effect(io)
(fn (abortRun ex)
  (if (&& ex.explicit (! ex.beganHere))
    0
    {
      (if ex.writeOpen
        {
          (let _ (pagerRollback ex.pager))
          (set ex.writeOpen false)
        })
      (if ex.readOpen
        {
          (let _ (pagerEndRead ex.pager))
          (set ex.readOpen false)
        })
      (set ex.explicit false)
      (set ex.beganHere false)
      (schemaDirty ex)
    }))

; ------------------------------------------------------------------
; Variables.
; ------------------------------------------------------------------
(:: pushFrame (-> Exec Int))
(fn (pushFrame ex)
  {
    (vecPush ex.frames (vecLen ex.vars))
    0
  })

(:: popFrame (-> Exec Int))
(fn (popFrame ex)
  {
    (let n (vecLen ex.frames))
    (if (> n 1)
      {
        (let mark (vecGet ex.frames (- n 1)))
        {
          (while (> (vecLen ex.vars) mark)
            (vecPop ex.vars))
          (vecPop ex.frames)
          0
        }
      }
      0)
  })

(:: varSet (-> Exec String Value Int))
(fn (varSet ex name value)
  {
    (let mark (vecGet ex.frames (- (vecLen ex.frames) 1)))
    (let mut i (- (vecLen ex.vars) 1))
    (let mut done false)
    {
      (while (&& (! done) (>= i mark))
        {
          (let b (vecGet ex.vars i))
          (if (strEq b.name name)
            {
              (set b.value value)
              (set done true)
            }
            (set i (- i 1)))
        })
      (if (! done)
        {
          (vecPush ex.vars (Binding :name name :value value))
          0
        }
        0)
    }
  })

(:: varGet (-> Exec String (Option Value)))
(fn (varGet ex name)
  {
    (let mut i (- (vecLen ex.vars) 1))
    (let mut found None)
    {
      (while (&& (isNone found) (>= i 0))
        {
          (let b (vecGet ex.vars i))
          (if (strEq b.name name)
            (set found (Some b.value))
            (set i (- i 1)))
        })
      (match found
        ((Some _) found)
        ((None) (objGet ex.params name)))
    }
  })

; Run `f` with $this set, in its own frame. The shape every
; per-record evaluation takes.
(:: withThis (-> Exec Value (-> Exec (Result a Error)) (Result a Error)))
(fn (withThis ex this f)
  {
    (pushFrame ex)
    (varSet ex "this" this)
    {
      (let r (f ex))
      {
        (popFrame ex)
        r
      }
    }
  })

(:: thisOf (-> Exec Value))
(fn (thisOf ex)
  (match (varGet ex "this")
    ((Some v) v)
    ((None) VNone)))

; ------------------------------------------------------------------
; Flow: what a block answers, and how RETURN, BREAK and CONTINUE
; travel.
; ------------------------------------------------------------------
(data Flow
  (FValue Value)
  (FReturn Value)
  (FBreak)
  (FContinue))

; ------------------------------------------------------------------
; Running statements.
; ------------------------------------------------------------------
;; Run a whole script, answering one value per statement. The run's
;; transactions follow the rules in the header.
(pub :: axqlRunScript (-> Exec (Vec Parsed) (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (axqlRunScript ex parsed)
  {
    (let out vecNew)
    (match (runParsed ex parsed out 0)
      ((Err e)
        {
          (abortRun ex)
          (Err e)
        }
      )
      ((Ok _)
        (match (finishRun ex)
          ((Err e) (Err e))
          ((Ok _) (Ok out)))
      ))
  })

(:: runParsed (-> Exec (Vec Parsed) (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (runParsed ex parsed out i)
  (if (>= i (vecLen parsed))
    (Ok 0)
    {
      (let p (vecGet parsed i))
      {
        (let flow (execStmt ex p.stmt p.text)?)
        (match flow
          ((FValue v)
            {
              (vecPush out v)
              (runParsed ex parsed out (+ i 1))
            }
          )
          ((FReturn v)
            {
              (vecPush out v)
              (Ok 0)
            }
          )
          (_ (axqErr axqMisuse "BREAK or CONTINUE outside a loop" "axqlRunScript")))
      }
    }))

;; Run one parsed statement, answering its value. A `RETURN` at the
;; top level answers its value like any other.
(pub :: axqlRunParsed (-> Exec Parsed (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (axqlRunParsed ex p)
  {
    (let one (vecPush vecNew p))
    {
      (let rs (axqlRunScript ex one)?)
      (Ok (vecGet rs 0))
    }
  })

(:: execBlock (-> Exec (Vec Stmt) (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execBlock ex stmts)
  {
    (pushFrame ex)
    {
      (let r (execStmts ex stmts 0 VNone))
      {
        (popFrame ex)
        r
      }
    }
  })

(:: execStmts (-> Exec (Vec Stmt) Int Value (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execStmts ex stmts i last)
  (if (>= i (vecLen stmts))
    (Ok (FValue last))
    {
      (let flow (execStmt ex (vecGet stmts i) "")?)
      (match flow
        ((FValue v) (execStmts ex stmts (+ i 1) v))
        (_ (Ok flow)))
    }))

(:: execStmt (-> Exec Stmt String (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execStmt ex stmt text)
  (match stmt
    ((SExpr e)
      {
        (let _ (ensureRead ex)?)
        {
          (let v (eval ex e)?)
          (Ok (FValue v))
        }
      }
    )
    ((SSelect sel)
      {
        (let _ (ensureRead ex)?)
        {
          (let v (execSelect ex sel)?)
          (Ok (FValue v))
        }
      }
    )
    ((SLet name e)
      {
        (let _ (ensureRead ex)?)
        {
          (let v (eval ex e)?)
          {
            (varSet ex name v)
            (Ok (FValue VNone))
          }
        }
      }
    )
    ((SReturn e)
      {
        (let v (eval ex e)?)
        (Ok (FReturn v))
      }
    )
    ((SThrow e)
      {
        (let v (eval ex e)?)
        (axqErr axqThrown (rawDisplay v) "THROW")
      }
    )
    ((SIf cond body elifs els) (execIf ex cond body elifs els))
    ((SFor var iter body) (execFor ex var iter body))
    ((SBreak) (Ok FBreak))
    ((SContinue) (Ok FContinue))
    ((SBegin)
      (if ex.explicit
        (axqErr axqMisuse "already in a transaction" "BEGIN")
        {
          (let _ (ensureWrite ex)?)
          {
            (set ex.explicit true)
            (set ex.beganHere true)
            (Ok (FValue VNone))
          }
        })
    )
    ((SCommit)
      (if (! ex.explicit)
        (axqErr axqMisuse "COMMIT outside a transaction" "COMMIT")
        {
          (let _ (pagerCommit ex.pager)?)
          {
            (set ex.writeOpen false)
            (set ex.explicit false)
            (set ex.beganHere false)
            (schemaDirty ex)
            (Ok (FValue VNone))
          }
        })
    )
    ((SCancel)
      (if (! ex.explicit)
        (axqErr axqMisuse "CANCEL outside a transaction" "CANCEL")
        {
          (let _ (pagerRollback ex.pager)?)
          {
            (set ex.writeOpen false)
            (set ex.explicit false)
            (set ex.beganHere false)
            (schemaDirty ex)
            (Ok (FValue VNone))
          }
        })
    )
    ((SCreate w) (execWrite ex stmt w 0 text))
    ((SUpdate w) (execWrite ex stmt w 1 text))
    ((SUpsert w) (execWrite ex stmt w 2 text))
    ((SDelete w) (execWrite ex stmt w 3 text))
    ((SRelate r) (execRelate ex r))
    ((SInsert table data dup ret) (execInsert ex table data dup ret))
    ((SDefineTable _ _ _ _ _) (execDefineTable ex stmt text))
    ((SDefineField _ _ _ _ _ _ _ _ _) (execDefineField ex stmt text))
    ((SDefineIndex _ _ _ _ _ _) (execDefineIndex ex stmt text))
    ((SDefineEvent _ _ _ _ _ _) (execDefineNamed ex stmt text kindEvent))
    ((SDefineFunction _ _ _ _ _) (execDefineNamed ex stmt text kindFunction))
    ((SRemove kind name table ifExists) (execRemove ex kind name table ifExists))
    ((SLive sel) (execLive ex sel text))
    ((SKill e)
      {
        (let v (eval ex e)?)
        {
          (let _ (killLive ex v)?)
          (Ok (FValue (VBool true)))
        }
      }
    )
    ((SInfo kind name)
      {
        (let v (execInfo ex kind name)?)
        (Ok (FValue v))
      }
    )
    ((SShow table since limit)
      {
        (let v (execShow ex table since limit)?)
        (Ok (FValue v))
      }
    )))

(:: rawDisplay (-> Value String))
(fn (rawDisplay v)
  (match v
    ((VText s) s)
    (_ (valueText v))))

(:: execIf (-> Exec Expr (Vec Stmt) (Vec Elif) (Vec Stmt) (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execIf ex cond body elifs els)
  {
    (let c (eval ex cond)?)
    (if (valTruthy c)
      (execBlock ex body)
      (execElifs ex elifs els 0))
  })

(:: execElifs (-> Exec (Vec Elif) (Vec Stmt) Int (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execElifs ex elifs els i)
  (if (>= i (vecLen elifs))
    (execBlock ex els)
    {
      (let arm (vecGet elifs i))
      {
        (let c (eval ex arm.cond)?)
        (if (valTruthy c)
          (execBlock ex arm.body)
          (execElifs ex elifs els (+ i 1)))
      }
    }))

(:: execFor (-> Exec String Expr (Vec Stmt) (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execFor ex var iter body)
  {
    (let _ (ensureRead ex)?)
    {
      (let v (eval ex iter)?)
      (match v
        ((VArray xs) (forEach ex var xs body 0 VNone))
        (_ (axqErr axqType (concat "FOR loops over an array, not a " (valueTypeName v)) "FOR")))
    }
  })

(:: forEach (-> Exec String (Vec Value) (Vec Stmt) Int Value (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (forEach ex var xs body i last)
  (if (>= i (vecLen xs))
    (Ok (FValue last))
    {
      (pushFrame ex)
      (varSet ex var (vecGet xs i))
      {
        (let r (execStmts ex body 0 VNone))
        {
          (popFrame ex)
          (match r
            ((Err e) (Err e))
            ((Ok flow)
              (match flow
                ((FValue v) (forEach ex var xs body (+ i 1) v))
                ((FContinue) (forEach ex var xs body (+ i 1) last))
                ((FBreak) (Ok (FValue last)))
                (_ (Ok flow)))
            ))
        }
      }
    }))

; ------------------------------------------------------------------
; Records: the only places that touch table trees.
; ------------------------------------------------------------------
; A table definition or a schema error, loading the schema first.
(:: tableDef (-> Exec String (Result TableDef Error)))
;@axiom:effect(io)
(fn (tableDef ex name)
  {
    (let s (schemaOf ex)?)
    (axqlTableDef s name)
  })

; The table named `name`, or `None` when there is none.
(:: tableDefOpt (-> Exec String (Result (Option TableDef) Error)))
;@axiom:effect(io)
(fn (tableDefOpt ex name)
  {
    (let s (schemaOf ex)?)
    (match (axqlFindEntry s kindTable "" name)
      ((None) (Ok None))
      ((Some _)
        {
          (let d (axqlTableDef s name)?)
          (Ok (Some d))
        }
      ))
  })

; The table named `name`, made empty and schemaless when there is
; none. Needs a write transaction.
(:: ensureTable (-> Exec String (Result TableDef Error)))
;@axiom:effect(io)
(fn (ensureTable ex name)
  (match (tableDefOpt ex name)
    ((Err e) (Err e))
    ((Ok (Some d)) (Ok d))
    ((Ok (None))
      {
        (let _ (ensureWrite ex)?)
        {
          (let root (btreeCreate ex.pager btreeTable)?)
          {
            (let _
              (axqlPutEntry ex.pager
                (SchemaEntry :rowid 0 :kind kindTable :name name :table name :root root :text ""))?)
            {
              (schemaDirty ex)
              (Ok
                (TableDef
                  :name name
                  :root root
                  :schemafull false
                  :changefeed false
                  :fields vecNew
                  :indexes vecNew
                  :events vecNew))
            }
          }
        }
      }
    )))

; The B-tree key of a record's key scalar.
(:: recordKey (-> Value (Result String Error)))
(fn (recordKey key)
  (if (valueIsKey key)
    (keyEncodeValue key)
    (axqErr axqType (concat "a record's key is an int, text or a uuid, not a " (valueTypeName key))
      "axqlExec")))

; A stored document with its `id` put back in front.
(:: docWithId (-> String Value Value Value))
(fn (docWithId table key stored)
  (match stored
    ((VObject fs)
      {
        (let out vecNew)
        {
          (vecPush out (Field :name "id" :value (recordId table key)))
          (for f in fs
            (if (! (strEq f.name "id"))
              (vecPush out f)))
          (VObject out)
        }
      }
    )
    (_ stored)))

; A document as stored: without its `id`.
(:: docStored (-> Value Value))
(fn (docStored doc)
  (objDel doc "id"))

;;; The record `table:key`, as a document with its id, or `None`.
(pub :: axqlGetRecord (-> Exec TableDef Value (Result (Option Value) Error)))
;@axiom:effect(io)
(pub fn (axqlGetRecord ex t key)
  {
    (let _ (ensureRead ex)?)
    {
      (let k (recordKey key)?)
      {
        (let raw (btreeGet ex.pager t.root k)?)
        (match raw
          ((None) (Ok None))
          ((Some bytes)
            {
              (let stored (recDecode bytes)?)
              (Ok (Some (docWithId t.name key stored)))
            }
          ))
      }
    }
  })

; Every record of `t`, in key order.
(:: scanTable (-> Exec TableDef (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (scanTable ex t)
  {
    (let _ (ensureRead ex)?)
    {
      (let rows (Collect :items vecNew))
      {
        (let _
          (btreeScan ex.pager t.root None None true (lambda (k v) (collectRecord rows t k v)))?)
        (Ok rows.items)
      }
    }
  })

(struct Collect
  (items : (Vec Value)))

(:: collectRecord (-> Collect TableDef String String (Result Bool Error)))
(fn (collectRecord rows t k v)
  {
    (let stored (recDecode v)?)
    {
      (let keys (keyDecode k)?)
      {
        (vecPush rows.items (docWithId t.name (vecGet keys 0) stored))
        (Ok true)
      }
    }
  })

; The records of `t` one indexed field pins to `value`: the index
; doing the work a scan would, for the one-field equality a query
; most often asks. `None` when no index fits.
(:: indexLookup (-> Exec TableDef String Value (Result (Option (Vec Value)) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (indexLookup ex t field value)
  {
    (let idx (singleFieldIndex t field))
    (match idx
      ((None) (Ok None))
      ((Some ix)
        {
          (let _ (ensureRead ex)?)
          {
            (let prefix (keyEncodeValue value)?)
            {
              (let rows (Collect :items vecNew))
              {
                (let _
                  (btreeScan ex.pager ix.root (Some prefix) (keyPrefixEnd prefix) true
                    (lambda (k v) (collectIndexed ex rows t k)))?)
                (Ok (Some rows.items))
              }
            }
          }
        }
      ))
  })

(:: singleFieldIndex (-> TableDef String (Option IndexDef)))
(fn (singleFieldIndex t field)
  {
    (let mut found None)
    {
      (for ix in t.indexes
        (if (&& (isNone found) (&& (== (vecLen ix.fields) 1) (strEq (vecGet ix.fields 0) field)))
          (set found (Some ix))))
      found
    }
  })

(:: collectIndexed (-> Exec Collect TableDef String (Result Bool Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (collectIndexed ex rows t k)
  {
    (let keys (keyDecode k)?)
    {
      (let key (vecGet keys (- (vecLen keys) 1)))
      {
        (let rec (axqlGetRecord ex t key)?)
        (match rec
          ((Some doc)
            {
              (vecPush rows.items doc)
              (Ok true)
            }
          )
          ((None) (Ok true)))
      }
    }
  })

; ------------------------------------------------------------------
; The meta tree: counters, edge markers and live subscriptions.
; ------------------------------------------------------------------
(:: metaRoot (-> Exec Bool (Result (Option Int) Error)))
;@axiom:effect(io)
(fn (metaRoot ex create)
  {
    (let s (schemaOf ex)?)
    (match (axqlMetaRoot s)
      ((Some _) (Ok (axqlMetaRoot s)))
      ((None)
        (if (! create)
          (Ok None)
          {
            (let _ (ensureWrite ex)?)
            {
              (let root (btreeCreate ex.pager btreeTable)?)
              {
                (let _
                  (axqlPutEntry ex.pager
                    (SchemaEntry
                      :rowid 0
                      :kind kindMeta
                      :name "meta"
                      :table "meta"
                      :root root
                      :text ""))?)
                {
                  (schemaDirty ex)
                  (Ok (Some root))
                }
              }
            }
          })
      ))
  })

(:: metaGet (-> Exec String (Result (Option Value) Error)))
;@axiom:effect(io)
(fn (metaGet ex key)
  {
    (let root (metaRoot ex false)?)
    (match root
      ((None) (Ok None))
      ((Some r)
        {
          (let _ (ensureRead ex)?)
          {
            (let raw (btreeGet ex.pager r key)?)
            (match raw
              ((None) (Ok None))
              ((Some bytes)
                {
                  (let v (recDecode bytes)?)
                  (Ok (Some v))
                }
              ))
          }
        }
      ))
  })

(:: metaPut (-> Exec String Value (Result Int Error)))
;@axiom:effect(io)
(fn (metaPut ex key value)
  {
    (let root (metaRoot ex true)?)
    (match root
      ((None) (axqErr axqCorrupt "the meta tree could not be made" "axqlExec"))
      ((Some r)
        {
          (let _ (ensureWrite ex)?)
          {
            (let bytes (recEncode value)?)
            {
              (let _ (btreePut ex.pager r key bytes)?)
              (Ok 0)
            }
          }
        }
      ))
  })

(:: metaDelete (-> Exec String (Result Bool Error)))
;@axiom:effect(io)
(fn (metaDelete ex key)
  {
    (let root (metaRoot ex false)?)
    (match root
      ((None) (Ok false))
      ((Some r)
        {
          (let _ (ensureWrite ex)?)
          (btreeDelete ex.pager r key)
        }
      ))
  })

; The next free int key of a table: a counter that only rises, and
; past any key a hand-written id already holds.
(:: nextAutoKey (-> Exec TableDef (Result Value Error)))
;@axiom:effect(io)
(fn (nextAutoKey ex t)
  {
    (let counterKey (concat "c:" t.name))
    {
      (let cur (metaGet ex counterKey)?)
      {
        (let start
          (match cur
            ((Some (VInt n)) n)
            (_ 1)))
        (nextFreeKey ex t counterKey start)
      }
    }
  })

(:: nextFreeKey (-> Exec TableDef String Int (Result Value Error)))
;@axiom:effect(io)
(fn (nextFreeKey ex t counterKey n)
  {
    (let k (recordKey (VInt n))?)
    {
      (let _ (ensureRead ex)?)
      {
        (let taken (btreeGet ex.pager t.root k)?)
        (match taken
          ((Some _) (nextFreeKey ex t counterKey (+ n 1)))
          ((None)
            {
              (let _ (metaPut ex counterKey (VInt (+ n 1)))?)
              (Ok (VInt n))
            }
          ))
      }
    }
  })

; Mark a table as an edge table, so a graph step that names no edge
; knows where to walk.
(:: markEdgeTable (-> Exec String (Result Int Error)))
;@axiom:effect(io)
(fn (markEdgeTable ex table)
  (metaPut ex (concat "edge:" table) (VBool true)))

(:: edgeTables (-> Exec (Result (Vec String) Error)))
;@axiom:effect(io)
(fn (edgeTables ex)
  {
    (let root (metaRoot ex false)?)
    (match root
      ((None) (Ok vecNew))
      ((Some r)
        {
          (let _ (ensureRead ex)?)
          {
            (let names (Collect :items vecNew))
            {
              (let _
                (btreeScan ex.pager r (Some "edge:") (Some "edge;") true
                  (lambda (k v) (collectEdge names k)))?)
              {
                (let out vecNew)
                {
                  (for v in names.items
                    (match v
                      ((VText s) (vecPush out s))
                      (_ 0)))
                  (Ok out)
                }
              }
            }
          }
        }
      ))
  })

(:: collectEdge (-> Collect String (Result Bool Error)))
(fn (collectEdge names k)
  {
    (vecPush names.items (VText (strSlice k 5 (- (strLen k) 5))))
    (Ok true)
  })

; ------------------------------------------------------------------
; Expressions.
; ------------------------------------------------------------------
(:: eval (-> Exec Expr (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (eval ex e)
  (if (> ex.depth 512)
    (axqErr axqMisuse "this expression nests too deep to run" "axqlExec")
    {
      (set ex.depth (+ ex.depth 1))
      {
        (let r (evalInner ex e))
        {
          (set ex.depth (- ex.depth 1))
          r
        }
      }
    }))

(:: evalInner (-> Exec Expr (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalInner ex e)
  (match e
    ((ELit v) (Ok v))
    ((EArray xs) (evalEach ex xs))
    ((EObject fs) (evalObject ex fs))
    ((EParam name)
      (match (varGet ex name)
        ((Some v) (Ok v))
        ((None)
          (axqErr axqMisuse (concat (concat "parameter $" name) " was not bound") "axqlExec")
        ))
    )
    ((EName name) (Ok (valField (thisOf ex) name)))
    ((ETable name)
      {
        (let t (tableDef ex name)?)
        {
          (let rows (scanTable ex t)?)
          (Ok (VArray rows))
        }
      }
    )
    ((ERecord table keyExpr)
      {
        (let key (eval ex keyExpr)?)
        (if (valueIsKey key)
          {
            (let t (tableDef ex table)?)
            (Ok (recordId t.name key))
          }
          (axqErr axqType
            (concat "a record's key is an int, text or a uuid, not a " (valueTypeName key))
            "axqlExec"))
      }
    )
    ((EPath base steps)
      {
        (let v (eval ex base)?)
        (evalSteps ex v steps 0)
      }
    )
    ((EBinary op l r) (evalBinary ex op l r))
    ((EUnary op x)
      {
        (let v (eval ex x)?)
        (if (strEq op "not")
          (Ok (VBool (! (valTruthy v))))
          (valNeg v))
      }
    )
    ((ECall name args) (evalCall ex name args))
    ((ECast t x)
      {
        (let v (eval ex x)?)
        (valCast t v)
      }
    )
    ((EIf cond then els)
      {
        (let c (eval ex cond)?)
        (if (valTruthy c)
          (eval ex then)
          (match els
            ((Some arm) (eval ex arm))
            ((None) (Ok VNone))))
      }
    )
    ((EBlock stmts)
      {
        (let flow (execBlock ex stmts)?)
        (match flow
          ((FValue v) (Ok v))
          ((FReturn v) (Ok v))
          (_ (axqErr axqMisuse "BREAK or CONTINUE outside a loop" "axqlExec")))
      }
    )
    ((ESelect sel)
      {
        (pushFrame ex)
        (varSet ex "parent" (thisOf ex))
        {
          (let r (execSelect ex sel))
          {
            (popFrame ex)
            r
          }
        }
      }
    )))

(:: evalEach (-> Exec (Vec Expr) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalEach ex xs)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for x in xs
        (if (isNone failure)
          (match (eval ex x)
            ((Ok v) (vecPush out v))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok (VArray out))))
    }
  })

(:: evalObject (-> Exec (Vec EField) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalObject ex fs)
  {
    (let mut doc emptyObject)
    (let mut failure None)
    {
      (for f in fs
        (if (isNone failure)
          (match (eval ex f.expr)
            ((Ok v)
              (set doc (objSet doc f.name v))
            )
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok doc)))
    }
  })

(:: evalBinary (-> Exec String Expr Expr (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalBinary ex op l r)
  (if (strEq op "and")
      {
        (let a (eval ex l)?)
        (if (! (valTruthy a))
          (Ok (VBool false))
          {
            (let b (eval ex r)?)
            (Ok (VBool (valTruthy b)))
          })
      }
    (strEq op "or")
      {
        (let a (eval ex l)?)
        (if (valTruthy a)
          (Ok (VBool true))
          {
            (let b (eval ex r)?)
            (Ok (VBool (valTruthy b)))
          })
      }
    (strEq op "??")
      {
        (let a (eval ex l)?)
        (match a
          ((VNone) (eval ex r))
          (_ (Ok a)))
      }
    {
      (let a (eval ex l)?)
      {
        (let b (eval ex r)?)
        (evalOp op a b)
      }
    }))

(:: evalOp (-> String Value Value (Result Value Error)))
(fn (evalOp op a b)
  (if (strEq op "=")
      (Ok (VBool (valEqual a b)))
    (strEq op "!=")
      (Ok (VBool (! (valEqual a b))))
    (strEq op "?=")
      (Ok (VBool (valAnyEq a b)))
    (strEq op "*=")
      (Ok (VBool (valAllEq a b)))
    (strEq op "<")
      (Ok (VBool (< (valCompare a b) 0)))
    (strEq op "<=")
      (Ok (VBool (<= (valCompare a b) 0)))
    (strEq op ">")
      (Ok (VBool (> (valCompare a b) 0)))
    (strEq op ">=")
      (Ok (VBool (>= (valCompare a b) 0)))
    (strEq op "is")
      (Ok (VBool (valIdentical a b)))
    (strEq op "isnot")
      (Ok (VBool (! (valIdentical a b))))
    (strEq op "in")
      (Ok (VBool (valContains b a)))
    (strEq op "inside")
      (Ok (VBool (valContains b a)))
    (strEq op "outside")
      (Ok (VBool (! (valContains b a))))
    (strEq op "contains")
      (Ok (VBool (valContains a b)))
    (strEq op "+")
      (valAdd a b)
    (strEq op "-")
      (valSub a b)
    (strEq op "*")
      (valMul a b)
    (strEq op "/")
      (valDiv a b)
    (valMod a b)))

; Paths. A step over an array collects: each element steps, arrays
; in the answers flatten one level, and `none` drops out - the rule
; that makes `posts.tags` and `->wrote->post.title` compose.
(:: evalSteps (-> Exec Value (Vec Step) Int (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalSteps ex v steps i)
  (if (>= i (vecLen steps))
    (Ok v)
    {
      (let next (applyStep ex v (vecGet steps i))?)
      (evalSteps ex next steps (+ i 1))
    }))

(:: applyStep (-> Exec Value Step (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyStep ex v step)
  (match step
    ((SIndex idx)
      {
        (pushFrame ex)
        (varSet ex "this" v)
        {
          (let r
            (match (eval ex idx)
              ((Ok key) (Ok (valIndex v key)))
              ((Err e) (Err e))))
          {
            (popFrame ex)
            r
          }
        }
      }
    )
    (_ (applyCollect ex v step))))

(:: applyCollect (-> Exec Value Step (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyCollect ex v step)
  (match v
    ((VArray xs)
      {
        (let out vecNew)
        (let mut failure None)
        {
          (for x in xs
            (if (isNone failure)
              (match (applyStep1 ex x step)
                ((Ok r) (collectInto out r))
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok (VArray out))))
        }
      }
    )
    (_ (applyStep1 ex v step))))

(:: collectInto (-> (Vec Value) Value Int))
(fn (collectInto out r)
  (match r
    ((VNone) 0)
    ((VArray xs)
      {
        (for x in xs
          (match x
            ((VNone) 0)
            (_
              {
                (vecPush out x)
                0
              }
            )))
        0
      }
    )
    (_
      {
        (vecPush out r)
        0
      }
    )))

(:: applyStep1 (-> Exec Value Step (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyStep1 ex v step)
  (match step
    ((SField name)
      (match v
        ((VRecord rid)
          {
            (let doc (deref ex rid)?)
            (Ok (valField doc name))
          }
        )
        (_ (Ok (valField v name))))
    )
    ((SDeref)
      (match v
        ((VRecord rid) (deref ex rid))
        (_ (Ok v)))
    )
    ((SGraph g) (traverse ex v g))
    ((SIndex _) (Ok VNone))))

; A record link followed: the document, or `none` when it is gone.
(:: deref (-> Exec RecordId (Result Value Error)))
;@axiom:effect(io)
(fn (deref ex rid)
  (match (tableDefOpt ex rid.table)
    ((Err e) (Err e))
    ((Ok (None)) (Ok VNone))
    ((Ok (Some t))
      {
        (let rec (axqlGetRecord ex t rid.key)?)
        (Ok
          (match rec
            ((Some doc) doc)
            ((None) VNone)))
      }
    )))

; One graph step from one value, which must be a record or a
; document with an id.
(:: traverse (-> Exec Value Graph (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (traverse ex v g)
  {
    (let rid (recordOfValue v))
    (match rid
      ((None) (Ok (VArray vecNew)))
      ((Some r)
        {
          (let tables
            (if (strIsEmpty g.edge)
              (edgeTables ex)?
              (vecPush vecNew g.edge)))
          {
            (let out vecNew)
            (let mut failure None)
            {
              (for et in tables
                (if (isNone failure)
                  (match (traverseTable ex r et g out)
                    ((Ok _) 0)
                    ((Err e)
                      (set failure (Some e))
                    ))))
              (match failure
                ((Some e) (Err e))
                ((None) (Ok (VArray out))))
            }
          }
        }
      ))
  })

(:: recordOfValue (-> Value (Option RecordId)))
(fn (recordOfValue v)
  (match v
    ((VRecord rid) (Some rid))
    ((VObject _)
      (match (objGet v "id")
        ((Some (VRecord rid)) (Some rid))
        (_ None))
    )
    (_ None)))

(:: traverseTable (-> Exec RecordId String Graph (Vec Value) (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (traverseTable ex from edgeName g out)
  (match (tableDefOpt ex edgeName)
    ((Err e) (Err e))
    ((Ok (None)) (Ok 0))
    ((Ok (Some t))
      {
        (let edges (edgesFrom ex t from g.dir)?)
        (collectEdges ex edges g out)
      }
    )))

; The edge documents touching `from` in direction `dir`, by index
; when the table has the auto-indexes RELATE keeps, else by scan.
(:: edgesFrom (-> Exec TableDef RecordId Int (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (edgesFrom ex t from dir)
  (if (== dir 0)
      (edgesWhere ex t "in" from)
    (== dir 1)
      (edgesWhere ex t "out" from)
    {
      (let a (edgesWhere ex t "in" from)?)
      {
        (let b (edgesWhere ex t "out" from)?)
        {
          (for e in b
            (vecPush a e))
          (Ok a)
        }
      }
    }))

(:: edgesWhere (-> Exec TableDef String RecordId (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (edgesWhere ex t field from)
  {
    (let rid (recordId from.table from.key))
    {
      (let found (indexLookup ex t field rid)?)
      (match found
        ((Some rows) (Ok rows))
        ((None)
          {
            (let rows (scanTable ex t)?)
            {
              (let out vecNew)
              {
                (for row in rows
                  (if (valEqual (valField row field) rid)
                    (vecPush out row)))
                (Ok out)
              }
            }
          }
        ))
    }
  })

(:: collectEdges (-> Exec (Vec Value) Graph (Vec Value) (Result Int Error)))
;@axiom:effect(io)
(fn (collectEdges ex edges g out)
  {
    (let mut failure None)
    {
      (for e in edges
        (if (isNone failure)
          (if (strIsEmpty g.next)
            (vecPush out e)
            {
              (let far
                (if (== g.dir 1)
                  (valField e "in")
                  (valField e "out")))
              (match (recordOfValue far)
                ((None) 0)
                ((Some rid)
                  (if (&& (! (strEq g.next "*")) (! (axqlWordEq rid.table g.next)))
                    0
                    (match (deref ex rid)
                      ((Ok doc)
                        (match doc
                          ((VNone) 0)
                          (_ (vecPush out doc)))
                      )
                      ((Err err)
                        (set failure (Some err))
                      )))
                ))
            })))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok 0)))
    }
  })

; ------------------------------------------------------------------
; Calls.
; ------------------------------------------------------------------
(:: evalCall (-> Exec String (Vec Expr) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalCall ex name argExprs)
  (if (isUserFn name)
    (callUserFn ex name argExprs)
    {
      (let args (evalArgs ex argExprs)?)
      (callBuiltin ex name args)
    }))

(:: isUserFn (-> String Bool))
(fn (isUserFn name)
  (|| (strStartsWith name "fn::") (! (isKnownFn name))))

(:: isKnownFn (-> String Bool))
(fn (isKnownFn name)
  (|| (axqlIsBuiltin name) (strEq name "type::record")))

(:: evalArgs (-> Exec (Vec Expr) (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalArgs ex xs)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for x in xs
        (if (isNone failure)
          (match (eval ex x)
            ((Ok v) (vecPush out v))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok out)))
    }
  })

(:: callBuiltin (-> Exec String (Vec Value) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (callBuiltin ex name args)
  (if (strEq name "time::now")
      (match (datetimeNowUtc)
        ((Ok dt) (Ok (datetimeValue dt)))
        ((Err e) (Err e)))
    (strEq name "rand::uuid")
      (match uuidV4
        ((Ok u) (Ok (uuidValue u)))
        ((Err e) (Err e)))
    (strEq name "rand::int")
      (randIntFn args)
    (strEq name "rand::float")
      (match randomWord
        ((Ok w)
          (Ok (VFloat (/ (as (randNonNeg w) Float) 9223372036854775808.0)))
        )
        ((Err e) (Err e)))
    (strEq name "record::exists")
      (recordExistsFn ex args)
    (strEq name "type::record")
      (typeRecordFn ex args)
    {
      (let r (evalBuiltin name args)?)
      (match r
        ((Some v) (Ok v))
        ((None)
          (axqErr axqSchema (concat (concat "no such function: " name) (fnHint ex name)) "axqlExec")
        ))
    }))

(:: randNonNeg (-> Int Int))
(fn (randNonNeg w)
  (if (< w 0)
    (if (== w intMin)
      0
      (- 0 w))
    w))

(:: randIntFn (-> (Vec Value) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (randIntFn args)
  (if (!= (vecLen args) 2)
    (axqErr axqType "rand::int takes a low and a high bound" "axqlExec")
    (match (vecGet args 0)
      ((VInt lo)
        (match (vecGet args 1)
          ((VInt hi)
            (if (<= hi lo)
              (axqErr axqType "rand::int needs its high bound past its low" "axqlExec")
              (match (randomBelow (- hi lo))
                ((Ok n) (Ok (VInt (+ lo n))))
                ((Err e) (Err e))))
          )
          (_ (axqErr axqType "rand::int takes int bounds" "axqlExec")))
      )
      (_ (axqErr axqType "rand::int takes int bounds" "axqlExec")))))

(:: recordExistsFn (-> Exec (Vec Value) (Result Value Error)))
;@axiom:effect(io)
(fn (recordExistsFn ex args)
  (if (!= (vecLen args) 1)
    (axqErr axqType "record::exists takes one record" "axqlExec")
    (match (recordOfValue (vecGet args 0))
      ((None) (axqErr axqType "record::exists takes a record" "axqlExec"))
      ((Some rid)
        (match (tableDefOpt ex rid.table)
          ((Err e) (Err e))
          ((Ok (None)) (Ok (VBool false)))
          ((Ok (Some t))
            {
              (let rec (axqlGetRecord ex t rid.key)?)
              (Ok (VBool (isSome rec)))
            }
          ))
      ))))

(:: typeRecordFn (-> Exec (Vec Value) (Result Value Error)))
;@axiom:effect(io)
(fn (typeRecordFn ex args)
  (if (== (vecLen args) 2)
    (match (vecGet args 0)
      ((VText table)
        {
          (let key (vecGet args 1))
          (if (valueIsKey key)
            {
              (let t (tableDef ex table)?)
              (Ok (recordId t.name key))
            }
            (axqErr axqType "a record's key is an int, text or a uuid" "type::record"))
        }
      )
      (_ (axqErr axqType "type::record takes a table name and a key" "type::record")))
    {
      (let r (evalBuiltin "type::record" args)?)
      (match r
        ((Some v) (Ok v))
        ((None) (valCast TyRecord (vecGet args 0))))
    }))

(:: fnHint (-> Exec String String))
(fn (fnHint ex name)
  {
    (let s ex.schema)
    (if (! ex.schemaLoaded)
      ""
      {
        (let names vecNew)
        {
          (for e in s.entries
            (if (strEq e.kind kindFunction)
              (vecPush names e.name)))
          (if (== (vecLen names) 0)
            ""
            (axqlHint name names "defined functions are named"))
        }
      })
  })

(:: callUserFn (-> Exec String (Vec Expr) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (callUserFn ex name argExprs)
  {
    (let fname
      (if (strStartsWith name "fn::")
        (strSlice name 4 (- (strLen name) 4))
        name))
    {
      (let s (schemaOf ex)?)
      {
        (let def (axqlFunctionDef s fname)?)
        (match def
          ((None)
            (axqErr axqSchema (concat (concat "no such function: fn::" fname) (fnHint ex fname))
              "axqlExec")
          )
          ((Some f)
            (if (> ex.callDepth 64)
              (axqErr axqMisuse "functions call too deep" "axqlExec")
              {
                (let args (evalArgs ex argExprs)?)
                (runUserFn ex f args)
              })
          ))
      }
    }
  })

(:: runUserFn (-> Exec FunctionDef (Vec Value) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (runUserFn ex f args)
  (if (!= (vecLen args) (vecLen f.params))
    (axqErr axqType
      (concat (concat (concat (concat "fn::" f.name) " takes ") (fmtInt (vecLen f.params)))
        (concat " arguments, got " (fmtInt (vecLen args))))
      "axqlExec")
    {
      (pushFrame ex)
      (set ex.callDepth (+ ex.callDepth 1))
      {
        (let r (bindParams ex f args 0))
        {
          (let out
            (match r
              ((Err e) (Err e))
              ((Ok _)
                (match (execStmts ex f.body 0 VNone)
                  ((Err e) (Err e))
                  ((Ok flow)
                    (match flow
                      ((FValue v) (Ok v))
                      ((FReturn v) (Ok v))
                      (_ (axqErr axqMisuse "BREAK or CONTINUE outside a loop" "axqlExec")))
                  ))
              )))
          {
            (set ex.callDepth (- ex.callDepth 1))
            (popFrame ex)
            out
          }
        }
      }
    }))

(:: bindParams (-> Exec FunctionDef (Vec Value) Int (Result Int Error)))
(fn (bindParams ex f args i)
  (if (>= i (vecLen f.params))
    (Ok 0)
    {
      (let p (vecGet f.params i))
      {
        (let v
          (match p.ftype
            ((None) (vecGet args i))
            ((Some t) (valCast t (vecGet args i))?)))
        {
          (varSet ex p.name v)
          (bindParams ex f args (+ i 1))
        }
      }
    }))

; ------------------------------------------------------------------
; SELECT.
; ------------------------------------------------------------------
(:: execSelect (-> Exec Select (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execSelect ex sel)
  {
    (let _ (ensureRead ex)?)
    {
      (let rows (resolveRows ex sel)?)
      {
        (let kept (filterRows ex rows sel.where)?)
        (if (> (vecLen sel.group) 0)
          (execGrouped ex sel kept)
          {
            (let ordered (orderRows ex sel kept)?)
            {
              (let windowed (windowRows ex sel ordered)?)
              (projectRows ex sel windowed)
            }
          })
      }
    }
  })

; The rows a SELECT starts from, before WHERE.
(:: resolveRows (-> Exec Select (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (resolveRows ex sel)
  (if (== (vecLen sel.targets) 0)
    (Ok (vecPush vecNew emptyObject))
    {
      (let indexed (indexCandidate ex sel)?)
      (match indexed
        ((Some rows) (Ok rows))
        ((None)
          {
            (let out vecNew)
            (let mut failure None)
            {
              (for t in sel.targets
                (if (isNone failure)
                  (match (targetRows ex t out)
                    ((Ok _) 0)
                    ((Err e)
                      (set failure (Some e))
                    ))))
              (match failure
                ((Some e) (Err e))
                ((None) (Ok out)))
            }
          }
        ))
    }))

; The one place an index answers a query directly: a single table
; target whose WHERE pins one indexed field to a bound value with
; `=`, alone or inside ANDs. The full WHERE still runs after.
(:: indexCandidate (-> Exec Select (Result (Option (Vec Value)) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (indexCandidate ex sel)
  (if (!= (vecLen sel.targets) 1)
    (Ok None)
    (match (vecGet sel.targets 0)
      ((ETable name)
        (match sel.where
          ((None) (Ok None))
          ((Some w)
            {
              (let pin (findPin w))
              (match pin
                ((None) (Ok None))
                ((Some pe)
                  {
                    (let t (tableDef ex name)?)
                    {
                      (let keyValue (eval ex pe.value)?)
                      (indexLookup ex t pe.field keyValue)
                    }
                  }
                ))
            }
          ))
      )
      (_ (Ok None)))))

(struct Pin
  (field : String)
  (value : Expr))

(:: findPin (-> Expr (Option Pin)))
(fn (findPin e)
  (match e
    ((EBinary op l r)
      (if (strEq op "and")
        (match (findPin l)
          ((Some p) (Some p))
          ((None) (findPin r)))
        (if (strEq op "=")
          (match l
            ((EName f)
              (if (boundExpr r)
                (Some (Pin :field f :value r))
                None)
            )
            (_
              (match r
                ((EName f)
                  (if (boundExpr l)
                    (Some (Pin :field f :value l))
                    None)
                )
                (_ None))
            ))
          None))
    )
    (_ None)))

; Whether an expression can be evaluated before any row is read.
(:: boundExpr (-> Expr Bool))
(fn (boundExpr e)
  (match e
    ((ELit _) true)
    ((EParam _) true)
    ((ERecord _ k) (boundExpr k))
    ((ECast _ x) (boundExpr x))
    (_ false)))

(:: targetRows (-> Exec Expr (Vec Value) (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (targetRows ex target out)
  (match target
    ((ETable name)
      {
        (let t (tableDef ex name)?)
        {
          (let rows (scanTable ex t)?)
          {
            (for r in rows
              (vecPush out r))
            (Ok 0)
          }
        }
      }
    )
    ((ERecord table keyExpr)
      {
        (let key (eval ex keyExpr)?)
        {
          (let t (tableDef ex table)?)
          {
            (let rec (axqlGetRecord ex t key)?)
            (match rec
              ((Some doc)
                {
                  (vecPush out doc)
                  (Ok 0)
                }
              )
              ((None) (Ok 0)))
          }
        }
      }
    )
    (_
      {
        (let v (eval ex target)?)
        (rowsOfValue ex v out)
      }
    )))

; Rows from an evaluated target: records load, arrays spread, a
; text names its table, anything else is a row of itself.
(:: rowsOfValue (-> Exec Value (Vec Value) (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (rowsOfValue ex v out)
  (match v
    ((VRecord rid)
      {
        (let doc (deref ex rid)?)
        (match doc
          ((VNone) (Ok 0))
          (_
            {
              (vecPush out doc)
              (Ok 0)
            }
          ))
      }
    )
    ((VArray xs)
      {
        (let mut failure None)
        {
          (for x in xs
            (if (isNone failure)
              (match (rowsOfValue ex x out)
                ((Ok _) 0)
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok 0)))
        }
      }
    )
    ((VText name) (targetRows ex (ETable name) out))
    ((VNone) (Ok 0))
    (_
      {
        (vecPush out v)
        (Ok 0)
      }
    )))

(:: filterRows (-> Exec (Vec Value) (Option Expr) (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (filterRows ex rows wh)
  (match wh
    ((None) (Ok rows))
    ((Some w)
      {
        (let out vecNew)
        (let mut failure None)
        {
          (for row in rows
            (if (isNone failure)
              (match (withThis ex row (lambda (ignored) (eval ex w)))
                ((Ok c)
                  (if (valTruthy c)
                    (vecPush out row)
                    0)
                )
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok out)))
        }
      }
    )))

; Ordering: keys are worked out on the row before projection, so
; ORDER BY names fields of the record, not aliases.
(struct Keyed
  (row : Value)
  (keys : (Vec Value)))

(:: orderRows (-> Exec Select (Vec Value) (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (orderRows ex sel rows)
  (if (== (vecLen sel.order) 0)
    (Ok rows)
    {
      (let keyed vecNew)
      (let mut failure None)
      {
        (for row in rows
          (if (isNone failure)
            (match (orderKeys ex sel.order row)
              ((Ok ks) (insertKeyed keyed (Keyed :row row :keys ks) sel.order))
              ((Err e)
                (set failure (Some e))
              ))))
        (match failure
          ((Some e) (Err e))
          ((None)
            {
              (let out vecNew)
              {
                (for k in keyed
                  (vecPush out k.row))
                (Ok out)
              }
            }
          ))
      }
    }))

(:: orderKeys (-> Exec (Vec Order) Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (orderKeys ex orders row)
  (withThis ex row
    (lambda (ignored)
      {
        (let out vecNew)
        (let mut failure None)
        {
          (for o in orders
            (if (isNone failure)
              (match (eval ex o.expr)
                ((Ok v) (vecPush out v))
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok out)))
        }
      }
    )))

(:: insertKeyed (-> (Vec Keyed) Keyed (Vec Order) Int))
(fn (insertKeyed out k orders)
  {
    (let mut n (vecLen out))
    (let mut i 0)
    {
      (while (&& (< i n) (<= (keyedCompare (vecGet out i) k orders) 0))
        (set i (+ i 1)))
      (vecPush out k)
      (while (> n i)
        {
          (vecSet out n (vecGet out (- n 1)))
          (set n (- n 1))
        })
      (vecSet out i k)
      0
    }
  })

(:: keyedCompare (-> Keyed Keyed (Vec Order) Int))
(fn (keyedCompare a b orders)
  {
    (let mut c 0)
    (let mut i 0)
    {
      (while (&& (== c 0) (< i (vecLen orders)))
        {
          (set c (valCompare (vecGet a.keys i) (vecGet b.keys i)))
          {
            (let o (vecGet orders i))
            (if o.desc
              (set c (- 0 c)))
          }
          (set i (+ i 1))
        })
      c
    }
  })

(:: windowRows (-> Exec Select (Vec Value) (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (windowRows ex sel rows)
  {
    (let start (windowBound ex sel.start 0)?)
    {
      (let limit (windowBound ex sel.limit -1)?)
      {
        (let out vecNew)
        (let n (vecLen rows))
        (let mut i start)
        {
          (while (&& (< i n) (|| (< limit 0) (< (vecLen out) limit)))
            {
              (vecPush out (vecGet rows i))
              (set i (+ i 1))
            })
          (Ok out)
        }
      }
    }
  })

(:: windowBound (-> Exec (Option Expr) Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (windowBound ex bound dflt)
  (match bound
    ((None) (Ok dflt))
    ((Some e)
      {
        (let v (eval ex e)?)
        (match (valCast TyInt v)
          ((Ok (VInt n))
            (Ok
              (if (< n 0)
                0
                n))
          )
          (_ (axqErr axqType "LIMIT and START take an int" "axqlExec")))
      }
    )))

; Projection: each row becomes what the SELECT answers for it.
(:: projectRows (-> Exec Select (Vec Value) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (projectRows ex sel rows)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for row in rows
        (if (isNone failure)
          (match (projectRow ex sel row)
            ((Ok v) (vecPush out v))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok (VArray out))))
    }
  })

(:: projectRow (-> Exec Select Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (projectRow ex sel row)
  (withThis ex row
    (lambda (ignored)
      (if sel.value
        (eval ex (firstProjExpr sel))
        {
          (let doc (projectDoc ex sel row)?)
          (fetchDoc ex sel doc)
        })
    )))

(:: projectDoc (-> Exec Select Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (projectDoc ex sel row)
  {
    (let mut doc emptyObject)
    (let mut failure None)
    {
      (for p in sel.projs
        (if (isNone failure)
          (if p.star
            (match row
              ((VObject fs)
                {
                  (for f in fs
                    (set doc (objSet doc f.name f.value)))
                  0
                }
              )
              (_ 0))
            (match (eval ex p.expr)
              ((Ok v)
                (set doc (objSet doc (projName p) v))
              )
              ((Err e)
                (set failure (Some e))
              )))))
      (match failure
        ((Some e) (Err e))
        ((None)
          {
            (for name in sel.omit
              (set doc (objDel doc name)))
            (Ok doc)
          }
        ))
    }
  })

; FETCH: record fields named are replaced by the records they link.
(:: fetchDoc (-> Exec Select Value (Result Value Error)))
;@axiom:effect(io)
(fn (fetchDoc ex sel doc)
  (if (== (vecLen sel.fetch) 0)
    (Ok doc)
    {
      (let mut out doc)
      (let mut failure None)
      {
        (for name in sel.fetch
          (if (isNone failure)
            (match (fetchValue ex (valField out name))
              ((Ok v)
                (set out (objSet out name v))
              )
              ((Err e)
                (set failure (Some e))
              ))))
        (match failure
          ((Some e) (Err e))
          ((None) (Ok out)))
      }
    }))

(:: fetchValue (-> Exec Value (Result Value Error)))
;@axiom:effect(io)
(fn (fetchValue ex v)
  (match v
    ((VRecord rid) (deref ex rid))
    ((VArray xs)
      {
        (let out vecNew)
        (let mut failure None)
        {
          (for x in xs
            (if (isNone failure)
              (match (fetchValue ex x)
                ((Ok y) (vecPush out y))
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok (VArray out))))
        }
      }
    )
    (_ (Ok v))))

(:: firstProjExpr (-> Select Expr))
(fn (firstProjExpr sel)
  {
    (let p (vecGet sel.projs 0))
    p.expr
  })

; The name a projection answers under when AS did not give one.
(:: projName (-> Proj String))
(fn (projName p)
  (if (! (strIsEmpty p.alias))
    p.alias
    (exprName p.expr)))

(:: exprName (-> Expr String))
(fn (exprName e)
  (match e
    ((EName n) n)
    ((EPath _ steps) (stepsName steps (- (vecLen steps) 1)))
    ((ECall name _) (shortFnName name))
    ((EParam n) n)
    (_ "value")))

(:: stepsName (-> (Vec Step) Int String))
(fn (stepsName steps i)
  (if (< i 0)
    "value"
    (match (vecGet steps i)
      ((SField n) n)
      ((SGraph g)
        (if (strIsEmpty g.next)
          (if (strIsEmpty g.edge)
            "edges"
            g.edge)
          g.next)
      )
      (_ (stepsName steps (- i 1))))))

(:: shortFnName (-> String String))
(fn (shortFnName name)
  {
    (let mut at -1)
    {
      (for i in 0..(- (strLen name) 1)
        (if (&& (== (strByte name i) 58) (== (strByte name (+ i 1)) 58))
          (set at i)))
      (if (< at 0)
        name
        (strSlice name (+ at 2) (- (strLen name) (+ at 2))))
    }
  })

; ------------------------------------------------------------------
; GROUP BY.
; ------------------------------------------------------------------
(struct Group
  (keys : (Vec Value))
  (rows : (Vec Value)))

(:: execGrouped (-> Exec Select (Vec Value) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execGrouped ex sel rows)
  {
    (let groups (groupRows ex sel rows)?)
    {
      ; Order and window run on the groups' first rows' keys through
      ; the same machinery, on the key vectors as pseudo-rows is
      ; overkill: groups answer in first-seen order unless ORDER BY
      ; says otherwise, which the keyed sort over representatives
      ; gives.
      (let ordered (orderGroups ex sel groups)?)
      {
        (let out vecNew)
        (let mut failure None)
        {
          (for g in ordered
            (if (isNone failure)
              (match (projectGroup ex sel g)
                ((Ok v) (vecPush out v))
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None)
              {
                (let windowed (windowRows ex sel out)?)
                (Ok (VArray windowed))
              }
            ))
        }
      }
    }
  })

(:: groupRows (-> Exec Select (Vec Value) (Result (Vec Group) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (groupRows ex sel rows)
  {
    (let groups vecNew)
    (let mut failure None)
    {
      (for row in rows
        (if (isNone failure)
          (match (groupKeys ex sel.group row)
            ((Err e)
              (set failure (Some e))
            )
            ((Ok ks) (addToGroup groups ks row)))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok groups)))
    }
  })

(:: groupKeys (-> Exec (Vec Expr) Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (groupKeys ex group row)
  (withThis ex row
    (lambda (ignored)
      {
        (let out vecNew)
        (let mut failure None)
        {
          (for g in group
            (if (isNone failure)
              (match (eval ex g)
                ((Ok v) (vecPush out v))
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok out)))
        }
      }
    )))

(:: addToGroup (-> (Vec Group) (Vec Value) Value Int))
(fn (addToGroup groups ks row)
  {
    (let mut done false)
    {
      (for g in groups
        (if (&& (! done) (keysEqual g.keys ks))
          {
            (vecPush g.rows row)
            (set done true)
          }))
      (if (! done)
        {
          (vecPush groups (Group :keys ks :rows (vecPush vecNew row)))
          0
        }
        0)
    }
  })

(:: keysEqual (-> (Vec Value) (Vec Value) Bool))
(fn (keysEqual a b)
  (if (!= (vecLen a) (vecLen b))
    false
    {
      (let mut same true)
      {
        (for (x i) in a
          (if (! (valEqual x (vecGet b i)))
            (set same false)))
        same
      }
    }))

(:: orderGroups (-> Exec Select (Vec Group) (Result (Vec Group) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (orderGroups ex sel groups)
  (if (== (vecLen sel.order) 0)
    (Ok groups)
    {
      (let reps vecNew)
      {
        (for g in groups
          (vecPush reps (vecGet g.rows 0)))
        {
          (let ordered (orderRows ex sel reps)?)
          {
            (let out vecNew)
            {
              (for r in ordered
                (vecPush out (groupOfRow groups r)))
              (Ok out)
            }
          }
        }
      }
    }))

(:: groupOfRow (-> (Vec Group) Value Group))
(fn (groupOfRow groups row)
  {
    (let mut found (vecGet groups 0))
    {
      (for g in groups
        (if (valIdentical (vecGet g.rows 0) row)
          (set found g)))
      found
    }
  })

(:: projectGroup (-> Exec Select Group (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (projectGroup ex sel g)
  (if sel.value
    (evalGrouped ex g.rows (firstProjExpr sel))
    {
      (let mut doc emptyObject)
      (let mut failure None)
      {
        (for p in sel.projs
          (if (isNone failure)
            (if p.star
              (set failure (Some (mkError axqType "SELECT * does not group; name what to answer")))
              (match (evalGrouped ex g.rows p.expr)
                ((Ok v)
                  (set doc (objSet doc (projName p) v))
                )
                ((Err e)
                  (set failure (Some e))
                )))))
        (match failure
          ((Some e) (Err e))
          ((None) (fetchDoc ex sel doc)))
      }
    }))

; An expression over a whole group: an aggregate call gathers its
; argument from every row, and anything else reads the first row,
; which holds the group's own keys.
(:: evalGrouped (-> Exec (Vec Value) Expr (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalGrouped ex rows e)
  (match e
    ((ECall name args)
      (if (aggregateName name)
        (evalAggregate ex rows name args)
        {
          (let vs (evalGroupedArgs ex rows args)?)
          (callBuiltin ex name vs)
        })
    )
    ((EBinary op l r)
      {
        (let a (evalGrouped ex rows l)?)
        (if (strEq op "and")
            (if (! (valTruthy a))
              (Ok (VBool false))
              {
                (let b (evalGrouped ex rows r)?)
                (Ok (VBool (valTruthy b)))
              })
          (strEq op "or")
            (if (valTruthy a)
              (Ok (VBool true))
              {
                (let b (evalGrouped ex rows r)?)
                (Ok (VBool (valTruthy b)))
              })
          (strEq op "??")
            (match a
              ((VNone) (evalGrouped ex rows r))
              (_ (Ok a)))
          {
            (let b (evalGrouped ex rows r)?)
            (evalOp op a b)
          })
      }
    )
    ((EUnary op x)
      {
        (let v (evalGrouped ex rows x)?)
        (if (strEq op "not")
          (Ok (VBool (! (valTruthy v))))
          (valNeg v))
      }
    )
    ((ECast t x)
      {
        (let v (evalGrouped ex rows x)?)
        (valCast t v)
      }
    )
    (_
      (withThis ex (vecGet rows 0) (lambda (ignored) (eval ex e)))
    )))

(:: evalGroupedArgs (-> Exec (Vec Value) (Vec Expr) (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalGroupedArgs ex rows xs)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for x in xs
        (if (isNone failure)
          (match (evalGrouped ex rows x)
            ((Ok v) (vecPush out v))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok out)))
    }
  })

(:: aggregateName (-> String Bool))
(fn (aggregateName name)
  (|| (strEq name "count")
    (|| (strEq name "math::sum")
      (|| (strEq name "math::min") (|| (strEq name "math::max") (strEq name "math::mean"))))))

(:: evalAggregate (-> Exec (Vec Value) String (Vec Expr) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalAggregate ex rows name args)
  (if (== (vecLen args) 0)
    (if (strEq name "count")
      (Ok (VInt (vecLen rows)))
      (axqErr axqType (concat name " in a group takes the value to gather") "axqlExec"))
    (if (!= (vecLen args) 1)
      (axqErr axqType (concat name " in a group takes one value to gather") "axqlExec")
      {
        (let gathered vecNew)
        (let mut failure None)
        {
          (for row in rows
            (if (isNone failure)
              (match (withThis ex row (lambda (ignored) (eval ex (vecGet args 0))))
                ((Ok v) (vecPush gathered v))
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None)
              {
                (let r (evalBuiltin name (vecPush vecNew (VArray gathered)))?)
                (match r
                  ((Some v) (Ok v))
                  ((None) (axqErr axqSchema (concat "no such function: " name) "axqlExec")))
              }
            ))
        }
      })))

; ------------------------------------------------------------------
; Writes. A Ref is one record a write will touch, with what it held
; before (`none` when there was no such record).
; ------------------------------------------------------------------
(struct Ref
  (table : TableDef)
  (key : Value)
  (before : Value))

(struct Pair
  (before : Value)
  (after : Value))

; mode: 0 CREATE, 1 UPDATE, 2 UPSERT, 3 DELETE.
(:: execWrite (-> Exec Stmt Write Int String (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execWrite ex stmt w mode text)
  {
    (let _ (ensureWrite ex)?)
    {
      (let refs (resolveRefs ex w.targets mode)?)
      {
        (let pairs vecNew)
        (let mut failure None)
        {
          (for r in refs
            (if (isNone failure)
              (match (writeOne ex r w mode)
                ((Ok (Some pair)) (vecPush pairs pair))
                ((Ok (None)) 0)
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None)
              {
                (let v (writeReturn ex w.return mode w.only pairs)?)
                (Ok (FValue v))
              }
            ))
        }
      }
    }
  })

(:: resolveRefs (-> Exec (Vec Expr) Int (Result (Vec Ref) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (resolveRefs ex targets mode)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for t in targets
        (if (isNone failure)
          (match (refsOfTarget ex t mode out)
            ((Ok _) 0)
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok (dedupRefs out))))
    }
  })

(:: dedupRefs (-> (Vec Ref) (Vec Ref)))
(fn (dedupRefs refs)
  {
    (let out vecNew)
    {
      (for r in refs
        (if (! (refIn out r))
          (vecPush out r)))
      out
    }
  })

(:: refIn (-> (Vec Ref) Ref Bool))
(fn (refIn refs r)
  {
    (let mut found false)
    {
      (for x in refs
        (if (&& (strEq x.table.name r.table.name) (valIdentical x.key r.key))
          (set found true)))
      found
    }
  })

(:: refsOfTarget (-> Exec Expr Int (Vec Ref) (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (refsOfTarget ex target mode out)
  (match target
    ((ETable name)
      (if (== mode 0)
        {
          (let t (ensureTable ex name)?)
          {
            (let key (nextAutoKey ex t)?)
            {
              (vecPush out (Ref :table t :key key :before VNone))
              (Ok 0)
            }
          }
        }
        {
          (let t (tableDef ex name)?)
          {
            (let rows (scanTable ex t)?)
            {
              (for row in rows
                (match (recordOfValue row)
                  ((Some rid)
                    {
                      (vecPush out (Ref :table t :key rid.key :before row))
                      0
                    }
                  )
                  ((None) 0)))
              (Ok 0)
            }
          }
        })
    )
    ((ERecord table keyExpr)
      {
        (let key (eval ex keyExpr)?)
        {
          (let t
            (if (== mode 1)
              (tableDef ex table)?
              (if (== mode 3)
                (tableDef ex table)?
                (ensureTable ex table)?)))
          {
            (let rec (axqlGetRecord ex t key)?)
            {
              (vecPush out
                (Ref
                  :table t
                  :key key
                  :before
                    (match rec
                      ((Some doc) doc)
                      ((None) VNone))))
              (Ok 0)
            }
          }
        }
      }
    )
    (_
      {
        (let v (eval ex target)?)
        (refsOfValue ex v mode out)
      }
    )))

(:: refsOfValue (-> Exec Value Int (Vec Ref) (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (refsOfValue ex v mode out)
  (match v
    ((VRecord rid)
      {
        (let t
          (if (== mode 0)
            (ensureTable ex rid.table)?
            (if (== mode 2)
              (ensureTable ex rid.table)?
              (tableDef ex rid.table)?)))
        {
          (let rec (axqlGetRecord ex t rid.key)?)
          {
            (vecPush out
              (Ref
                :table t
                :key rid.key
                :before
                  (match rec
                    ((Some doc) doc)
                    ((None) VNone))))
            (Ok 0)
          }
        }
      }
    )
    ((VArray xs)
      {
        (let mut failure None)
        {
          (for x in xs
            (if (isNone failure)
              (match (refsOfValue ex x mode out)
                ((Ok _) 0)
                ((Err e)
                  (set failure (Some e))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok 0)))
        }
      }
    )
    ((VObject _)
      (match (recordOfValue v)
        ((Some rid) (refsOfValue ex (VRecord rid) mode out))
        ((None) (axqErr axqType "a write target object needs an id" "axqlExec")))
    )
    ((VText name) (refsOfTarget ex (ETable name) mode out))
    (_ (axqErr axqType (concat "a write target is not a " (valueTypeName v)) "axqlExec"))))

; One record through a write. `None` when the WHERE leaves it be.
(:: writeOne (-> Exec Ref Write Int (Result (Option Pair) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (writeOne ex r w mode)
  {
    (let t r.table)
    (let exists (! (isNoneDoc r.before)))
    (if (&& (== mode 0) exists)
      (axqErr axqExists (concat "the record already exists: " (valueText (recordId t.name r.key)))
        "CREATE")
      (if (== mode 3)
        (deleteOne ex r w)
        (if (&& (== mode 1) (! exists))
          (Ok None)
          {
            (let candidate (buildAfter ex r w mode)?)
            {
              (let passes
                (wherePasses ex w
                  (if exists
                    r.before
                    candidate))?)
              (if (! passes)
                (Ok None)
                {
                  (let after (processFields ex t r.before candidate (! exists))?)
                  (commitRecord ex r after
                    (if exists
                      "update"
                      "create"))
                })
            }
          })))
  })

(:: isNoneDoc (-> Value Bool))
(fn (isNoneDoc v)
  (match v
    ((VNone) true)
    (_ false)))

(:: deleteOne (-> Exec Ref Write (Result (Option Pair) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (deleteOne ex r w)
  (if (isNoneDoc r.before)
    (Ok None)
    {
      (let passes (wherePasses ex w r.before)?)
      (if (! passes)
        (Ok None)
        {
          (let t r.table)
          {
            (let _ (removeIndexKeys ex t r.key r.before)?)
            {
              (let k (recordKey r.key)?)
              {
                (let _ (btreeDelete ex.pager t.root k)?)
                {
                  (set ex.changes (+ ex.changes 1))
                  {
                    (let _ (feedAppend ex t "delete" r.key r.before)?)
                    {
                      (let _ (fireEvents ex t "delete" r.before VNone)?)
                      (Ok (Some (Pair :before r.before :after VNone)))
                    }
                  }
                }
              }
            }
          }
        })
    }))

(:: wherePasses (-> Exec Write Value (Result Bool Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (wherePasses ex w this)
  (match w.where
    ((None) (Ok true))
    ((Some e)
      {
        (let v (withThis ex this (lambda (ignored) (eval ex e)))?)
        (Ok (valTruthy v))
      }
    )))

(:: buildAfter (-> Exec Ref Write Int (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (buildAfter ex r w mode)
  {
    (let base
      (match r.before
        ((VObject _) r.before)
        (_ (docWithId r.table.name r.key emptyObject))))
    (withThis ex base
      (lambda (ignored)
        (match w.content
          ((CNone) (Ok base))
          ((CContent e)
            {
              (let v (eval ex e)?)
              (match v
                ((VObject _) (Ok (docWithId r.table.name r.key (docStored v))))
                (_
                  (axqErr axqType (concat "CONTENT takes an object, not a " (valueTypeName v))
                    "axqlExec")
                ))
            }
          )
          ((CSet assigns)
            (applyAssigns ex base assigns (lambda (x) (Ok x)))
          )
          ((CMerge e)
            {
              (let v (eval ex e)?)
              (Ok (docWithId r.table.name r.key (docStored (valMerge base v))))
            }
          )
          ((CPatch e)
            {
              (let v (eval ex e)?)
              {
                (let patched (valPatch base v)?)
                (Ok (docWithId r.table.name r.key (docStored patched)))
              }
            }
          ))
      ))
  })

(:: applyAssigns (-> Exec Value (Vec Assign) (-> Value (Result Value Error)) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyAssigns ex doc assigns finish)
  {
    (let mut cur doc)
    (let mut failure None)
    {
      (for a in assigns
        (if (isNone failure)
          (match (applyAssign ex cur a)
            ((Ok next)
              (set cur next)
            )
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (finish cur)))
    }
  })

(:: applyAssign (-> Exec Value Assign (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyAssign ex doc a)
  (if (strEq a.path "id")
    (axqErr axqType "a record's id can't be set" "axqlExec")
    {
      (let v (withThis ex doc (lambda (ignored) (eval ex a.expr)))?)
      (if (strEq a.op "=")
          (Ok (valSetPath doc a.path v))
        (strEq a.op "+=")
          {
            (let cur (valGetPath doc a.path))
            (match cur
              ((VNone) (Ok (valSetPath doc a.path v)))
              (_
                {
                  (let sum (valAdd cur v)?)
                  (Ok (valSetPath doc a.path sum))
                }
              ))
          }
        {
          (let cur (valGetPath doc a.path))
          (match cur
            ((VNone)
              {
                (let neg (valSub (VInt 0) v)?)
                (Ok (valSetPath doc a.path neg))
              }
            )
            (_
              {
                (let diff (valSub cur v)?)
                (Ok (valSetPath doc a.path diff))
              }
            ))
        })
    }))

; Store one record and everything that follows from it: indexes,
; the feed, and events.
(:: commitRecord (-> Exec Ref Value String (Result (Option Pair) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (commitRecord ex r after action)
  {
    (let t r.table)
    {
      (let _ (checkUnique ex t r.key after)?)
      {
        (let _ (removeIndexKeys ex t r.key r.before)?)
        {
          (let k (recordKey r.key)?)
          {
            (let bytes (recEncode (docStored after))?)
            {
              (let _
                (if (strEq action "create")
                  {
                    (let fresh (btreeInsertNew ex.pager t.root k bytes)?)
                    (if fresh
                      (Ok 0)
                      (axqErr axqExists
                        (concat "the record already exists: " (valueText (recordId t.name r.key)))
                        "CREATE"))
                  }
                  {
                    (let _ (btreePut ex.pager t.root k bytes)?)
                    (Ok 0)
                  })?)
              {
                (let _ (addIndexKeys ex t r.key after)?)
                {
                  (set ex.changes (+ ex.changes 1))
                  {
                    (let _ (feedAppend ex t action r.key after)?)
                    {
                      (let _ (fireEvents ex t action r.before after)?)
                      (Ok (Some (Pair :before r.before :after after)))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; What a write answers, from its touched pairs.
(:: writeReturn (-> Exec Return Int Bool (Vec Pair) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (writeReturn ex ret mode only pairs)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for p in pairs
        (if (isNone failure)
          (match (returnOf ex ret mode p)
            ((Ok v) (vecPush out v))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None)
          (if only
            (if (== (vecLen out) 0)
              (Ok VNone)
              (if (== (vecLen out) 1)
                (Ok (vecGet out 0))
                (axqErr axqMisuse "ONLY takes one record, and the write touched more" "axqlExec")))
            (match ret
              ((RetNone) (Ok (VArray vecNew)))
              (_ (Ok (VArray out)))))
        ))
    }
  })

(:: returnOf (-> Exec Return Int Pair (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (returnOf ex ret mode p)
  (match ret
    ((RetNone) (Ok VNone))
    ((RetBefore) (Ok p.before))
    ((RetAfter)
      (if (== mode 3)
        ; A delete answers what it removed, as Surreal does.
        (Ok p.before)
        (Ok p.after))
    )
    ((RetDiff) (Ok (valDiff (diffDoc p.before) (diffDoc p.after))))
    ((RetValue e)
      (withThis ex (returnThis mode p) (lambda (ignored) (eval ex e)))
    )
    ((RetFields projs)
      {
        (let sel
          (Select
            :value false
            :projs projs
            :omit vecNew
            :targets vecNew
            :where None
            :group vecNew
            :order vecNew
            :limit None
            :start None
            :fetch vecNew))
        (projectRow ex sel (returnThis mode p))
      }
    )))

(:: returnThis (-> Int Pair Value))
(fn (returnThis mode p)
  (if (== mode 3)
    p.before
    p.after))

(:: diffDoc (-> Value Value))
(fn (diffDoc v)
  (match v
    ((VObject _) v)
    (_ emptyObject)))

; ------------------------------------------------------------------
; Field rules.
; ------------------------------------------------------------------
(:: processFields (-> Exec TableDef Value Value Bool (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (processFields ex t before after isNew)
  {
    (let mut doc after)
    (let mut failure None)
    {
      (for fd in t.fields
        (if (isNone failure)
          (match (applyFieldDef ex fd doc before isNew)
            ((Ok next)
              (set doc next)
            )
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None)
          (if t.schemafull
            (checkSchemafull t doc)
            (Ok doc))
        ))
    }
  })

(:: checkSchemafull (-> TableDef Value (Result Value Error)))
(fn (checkSchemafull t doc)
  (match doc
    ((VObject fs)
      {
        (let mut bad "")
        {
          (for f in fs
            (if (&& (strIsEmpty bad) (&& (! (strEq f.name "id")) (! (fieldAllowed t f.name))))
              (set bad f.name)))
          (if (strIsEmpty bad)
            (Ok doc)
            (axqErr axqConstraint
              (concat (concat (concat "table " t.name) " is schemafull and has no field ") bad)
              "axqlExec"))
        }
      }
    )
    (_ (Ok doc))))

(:: fieldAllowed (-> TableDef String Bool))
(fn (fieldAllowed t name)
  {
    (let mut ok (|| (strEq name "in") (strEq name "out")))
    {
      (for fd in t.fields
        (if (strEq (firstPiece fd.name) name)
          (set ok true)))
      ok
    }
  })

(:: firstPiece (-> String String))
(fn (firstPiece path)
  {
    (let pieces (strSplit path 46))
    (if (== (vecLen pieces) 0)
      path
      (vecGet pieces 0))
  })

(:: applyFieldDef (-> Exec FieldDef Value Value Bool (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyFieldDef ex fd doc before isNew)
  {
    (let starAt (starPiece fd.name))
    (if (>= starAt 0)
      (applyFieldStar ex fd doc starAt)
      {
        (let present (pathPresent doc fd.name))
        {
          (let next (leafProcess ex fd doc (valGetPath doc fd.name) present)?)
          (match next
            ((None)
              {
                (let _ (checkReadonly fd doc before isNew)?)
                (Ok doc)
              }
            )
            ((Some v)
              {
                (let out (valSetPath doc fd.name v))
                {
                  (let _ (checkReadonly fd out before isNew)?)
                  (Ok out)
                }
              }
            ))
        }
      })
  })

(:: checkReadonly (-> FieldDef Value Value Bool (Result Int Error)))
(fn (checkReadonly fd doc before isNew)
  (if (|| (! fd.readonly) isNew)
    (Ok 0)
    (if (valEqual (valGetPath doc fd.name) (valGetPath before fd.name))
      (Ok 0)
      (axqErr axqConstraint (concat (concat "field " fd.name) " is readonly") "axqlExec"))))

; The pieces index of `*` in a dotted path, or -1.
(:: starPiece (-> String Int))
(fn (starPiece path)
  {
    (let pieces (strSplit path 46))
    (let mut at -1)
    {
      (for (piece i) in pieces
        (if (&& (< at 0) (strEq piece "*"))
          (set at i)))
      at
    }
  })

; A field under `a.*`: the rules apply to each element.
(:: applyFieldStar (-> Exec FieldDef Value Int (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyFieldStar ex fd doc starAt)
  {
    (let pieces (strSplit fd.name 46))
    {
      (let prefix (joinPieces pieces 0 starAt))
      {
        (let rest (joinPieces pieces (+ starAt 1) (vecLen pieces)))
        {
          (let arr (valGetPath doc prefix))
          (match arr
            ((VArray xs)
              {
                (let inner
                  (FieldDef
                    :name rest
                    :ftype fd.ftype
                    :dflt fd.dflt
                    :value fd.value
                    :assert fd.assert
                    :readonly false))
                {
                  (let out vecNew)
                  (let mut failure None)
                  {
                    (for x in xs
                      (if (isNone failure)
                        (match (applyFieldAt ex inner doc x rest)
                          ((Ok y) (vecPush out y))
                          ((Err e)
                            (set failure (Some e))
                          ))))
                    (match failure
                      ((Some e) (Err e))
                      ((None) (Ok (valSetPath doc prefix (VArray out)))))
                  }
                }
              }
            )
            (_ (Ok doc)))
        }
      }
    }
  })

(:: joinPieces (-> (Vec String) Int Int String))
(fn (joinPieces pieces from to)
  {
    (let parts vecNew)
    {
      (for i in from..to
        (vecPush parts (vecGet pieces i)))
      (strJoin parts ".")
    }
  })

(:: applyFieldAt (-> Exec FieldDef Value Value String (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (applyFieldAt ex fd doc elem rest)
  (if (strIsEmpty rest)
    {
      (let next (leafProcess ex fd doc elem true)?)
      (Ok
        (match next
          ((Some v) v)
          ((None) elem)))
    }
    (match elem
      ((VObject _)
        {
          (let present (pathPresent elem rest))
          {
            (let next (leafProcess ex fd doc (valGetPath elem rest) present)?)
            (Ok
              (match next
                ((Some v) (valSetPath elem rest v))
                ((None) elem)))
          }
        }
      )
      (_ (Ok elem)))))

; One field's DEFAULT, VALUE, TYPE and ASSERT over one value.
; `None` answers "leave it absent".
(:: leafProcess (-> Exec FieldDef Value Value Bool (Result (Option Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (leafProcess ex fd doc cur present)
  {
    (let step1
      (if (&& (! present) (isSome fd.dflt))
        {
          (let v (evalFieldExpr ex fd doc VNone (someExpr fd.dflt))?)
          (Some v)
        }
        (if present
          (Some cur)
          None)))
    {
      (let step2
        (match fd.value
          ((None) step1)
          ((Some e)
            {
              (let v
                (evalFieldExpr ex fd doc
                  (match step1
                    ((Some x) x)
                    ((None) VNone))
                  e)?)
              (Some v)
            }
          )))
      {
        (let step3
          (match step2
            ((None) None)
            ((Some v)
              (match fd.ftype
                ((None) (Some v))
                ((Some t)
                  (match v
                    ((VNone) (Some v))
                    (_
                      {
                        (let casted (valCast t v)?)
                        (Some casted)
                      }
                    ))
                ))
            )))
        {
          (let _
            (checkAssert ex fd doc
              (match step3
                ((Some x) x)
                ((None) VNone)))?)
          (Ok step3)
        }
      }
    }
  })

(:: checkAssert (-> Exec FieldDef Value Value (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (checkAssert ex fd doc value)
  (match fd.assert
    ((None) (Ok 0))
    ((Some e)
      {
        (let ok (evalFieldExpr ex fd doc value e)?)
        (if (valTruthy ok)
          (Ok 0)
          (axqErr axqConstraint (concat (concat "field " fd.name) " failed its assertion")
            "axqlExec"))
      }
    )))

(:: someExpr (-> (Option Expr) Expr))
(fn (someExpr e)
  (match e
    ((Some x) x)
    ((None) (ELit VNone))))

; A field expression sees the record as $this and the field's own
; incoming value as $value.
(:: evalFieldExpr (-> Exec FieldDef Value Value Expr (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (evalFieldExpr ex fd doc value e)
  {
    (pushFrame ex)
    (varSet ex "this" doc)
    (varSet ex "value" value)
    {
      (let r (eval ex e))
      {
        (popFrame ex)
        r
      }
    }
  })

(:: pathPresent (-> Value String Bool))
(fn (pathPresent doc path)
  {
    (let pieces (strSplit path 46))
    (presentPieces doc pieces 0)
  })

(:: presentPieces (-> Value (Vec String) Int Bool))
(fn (presentPieces v pieces i)
  (if (>= i (vecLen pieces))
    true
    (match v
      ((VObject _)
        (match (objGet v (vecGet pieces i))
          ((Some next) (presentPieces next pieces (+ i 1)))
          ((None) false))
      )
      ((VArray _)
        (match (strParseInt (vecGet pieces i))
          ((Some at)
            {
              (let next (valIndex v (VInt at)))
              (match next
                ((VNone) false)
                (_ (presentPieces next pieces (+ i 1))))
            }
          )
          ((None) false))
      )
      (_ false))))

; ------------------------------------------------------------------
; Indexes.
; ------------------------------------------------------------------
(:: indexKeyOf (-> TableDef IndexDef Value Value (Result String Error)))
(fn (indexKeyOf t ix key doc)
  {
    (let vals vecNew)
    {
      (for f in ix.fields
        (vecPush vals (valGetPath doc f)))
      (vecPush vals key)
      (match (keyEncode vals)
        ((Ok k) (Ok k))
        ((Err e)
          (axqErr axqType
            (concat (concat "index " ix.name)
              " can't hold this record: an indexed field has no key encoding")
            "axqlExec")
        ))
    }
  })

(:: addIndexKeys (-> Exec TableDef Value Value (Result Int Error)))
;@axiom:effect(io)
(fn (addIndexKeys ex t key doc)
  (match doc
    ((VNone) (Ok 0))
    (_
      {
        (let mut failure None)
        {
          (for ix in t.indexes
            (if (isNone failure)
              (match (indexKeyOf t ix key doc)
                ((Err e)
                  (set failure (Some e))
                )
                ((Ok k)
                  (match (btreePut ex.pager ix.root k "")
                    ((Ok _) 0)
                    ((Err e)
                      (set failure (Some e))
                    ))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok 0)))
        }
      }
    )))

(:: removeIndexKeys (-> Exec TableDef Value Value (Result Int Error)))
;@axiom:effect(io)
(fn (removeIndexKeys ex t key doc)
  (match doc
    ((VNone) (Ok 0))
    (_
      {
        (let mut failure None)
        {
          (for ix in t.indexes
            (if (isNone failure)
              (match (indexKeyOf t ix key doc)
                ((Err e)
                  (set failure (Some e))
                )
                ((Ok k)
                  (match (btreeDelete ex.pager ix.root k)
                    ((Ok _) 0)
                    ((Err e)
                      (set failure (Some e))
                    ))
                ))))
          (match failure
            ((Some e) (Err e))
            ((None) (Ok 0)))
        }
      }
    )))

; A unique index refuses a key another record already holds.
(:: checkUnique (-> Exec TableDef Value Value (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (checkUnique ex t key doc)
  {
    (let mut failure None)
    {
      (for ix in t.indexes
        (if (&& (isNone failure) ix.unique)
          (match (checkUniqueOne ex t ix key doc)
            ((Ok _) 0)
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok 0)))
    }
  })

(:: checkUniqueOne (-> Exec TableDef IndexDef Value Value (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (checkUniqueOne ex t ix key doc)
  {
    (let vals vecNew)
    {
      (for f in ix.fields
        (vecPush vals (valGetPath doc f)))
      {
        ; A missing value never collides, as in Surreal and SQL.
        (let mut anyNone false)
        {
          (for v in vals
            (match v
              ((VNone)
                (set anyNone true)
              )
              (_ 0)))
          (if anyNone
            (Ok 0)
            {
              (let prefix (keyEncode vals)?)
              {
                (let seen (Collect :items vecNew))
                {
                  (let _
                    (btreeScan ex.pager ix.root (Some prefix) (keyPrefixEnd prefix) true
                      (lambda (k v) (collectKey seen k)))?)
                  {
                    (let mut clash false)
                    {
                      (for item in seen.items
                        (match item
                          ((VText k)
                            {
                              (let keys (keyDecode k)?)
                              {
                                (if (! (valIdentical (vecGet keys (- (vecLen keys) 1)) key))
                                  (set clash true))
                                0
                              }
                            }
                          )
                          (_ 0)))
                      (if clash
                        (axqErr axqConstraint
                          (concat (concat "index " ix.name) " already holds this value") "axqlExec")
                        (Ok 0))
                    }
                  }
                }
              }
            })
        }
      }
    }
  })

(:: collectKey (-> Collect String (Result Bool Error)))
(fn (collectKey seen k)
  {
    (vecPush seen.items (VText k))
    (Ok true)
  })

; ------------------------------------------------------------------
; The change feed and events.
; ------------------------------------------------------------------
(:: ensureFeed (-> Exec TableDef (Result Int Error)))
;@axiom:effect(io)
(fn (ensureFeed ex t)
  {
    (let s (schemaOf ex)?)
    (match (axqlFeedRoot s t.name)
      ((Some r) (Ok r))
      ((None)
        {
          (let _ (ensureWrite ex)?)
          {
            (let root (btreeCreate ex.pager btreeTable)?)
            {
              (let _
                (axqlPutEntry ex.pager
                  (SchemaEntry
                    :rowid 0
                    :kind kindFeed
                    :name t.name
                    :table t.name
                    :root root
                    :text ""))?)
              {
                (schemaDirty ex)
                (Ok root)
              }
            }
          }
        }
      ))
  })

(:: feedAppend (-> Exec TableDef String Value Value (Result Int Error)))
;@axiom:effect(io)
(fn (feedAppend ex t action key result)
  {
    (let s (schemaOf ex)?)
    (match (axqlFeedRoot s t.name)
      ((None) (Ok 0))
      ((Some root)
        {
          (let last (btreeLastKey ex.pager root)?)
          {
            (let seq
              (match last
                ((None) 1)
                ((Some k) (+ (keyRowidOf k)? 1))))
            {
              (let fs vecNew)
              {
                (vecPush fs (Field :name "versionstamp" :value (VInt seq)))
                (vecPush fs (Field :name "action" :value (VText action)))
                (vecPush fs (Field :name "record" :value (recordId t.name key)))
                (vecPush fs (Field :name "result" :value result))
                {
                  (let bytes (recEncode (VObject fs))?)
                  {
                    (let _ (btreePut ex.pager root (keyRowid seq) bytes)?)
                    (Ok 0)
                  }
                }
              }
            }
          }
        }
      ))
  })

(:: feedLastSeq (-> Exec Int (Result Int Error)))
;@axiom:effect(io)
(fn (feedLastSeq ex root)
  {
    (let last (btreeLastKey ex.pager root)?)
    (match last
      ((None) (Ok 0))
      ((Some k) (keyRowidOf k)))
  })

(:: fireEvents (-> Exec TableDef String Value Value (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (fireEvents ex t action before after)
  (if (== (vecLen t.events) 0)
    (Ok 0)
    (if (> ex.eventDepth 16)
      (axqErr axqMisuse "events triggered events too deep" "axqlExec")
      {
        (set ex.eventDepth (+ ex.eventDepth 1))
        {
          (let mut failure None)
          {
            (for ev in t.events
              (if (isNone failure)
                (match (fireEvent ex ev action before after)
                  ((Ok _) 0)
                  ((Err e)
                    (set failure (Some e))
                  ))))
            (set ex.eventDepth (- ex.eventDepth 1))
            (match failure
              ((Some e) (Err e))
              ((None) (Ok 0)))
          }
        }
      })))

(:: fireEvent (-> Exec EventDef String Value Value (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (fireEvent ex ev action before after)
  {
    (pushFrame ex)
    (varSet ex "event" (VText action))
    (varSet ex "before" before)
    (varSet ex "after" after)
    (varSet ex "value"
      (if (strEq action "delete")
        before
        after))
    (varSet ex "this"
      (if (strEq action "delete")
        before
        after))
    {
      (let r
        (match (eval ex ev.when)
          ((Err e) (Err e))
          ((Ok c)
            (if (valTruthy c)
              (match (execStmts ex ev.then 0 VNone)
                ((Err e) (Err e))
                ((Ok _) (Ok 0)))
              (Ok 0))
          )))
      {
        (popFrame ex)
        r
      }
    }
  })

; ------------------------------------------------------------------
; RELATE and INSERT.
; ------------------------------------------------------------------
(:: execRelate (-> Exec Relate (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execRelate ex r)
  {
    (let _ (ensureWrite ex)?)
    {
      (let froms (relateSide ex r.from "from")?)
      {
        (let tos (relateSide ex r.to "to")?)
        {
          (let edge (ensureEdgeTable ex r.edge)?)
          {
            (let pairs vecNew)
            (let mut failure None)
            {
              (for f in froms
                (for t in tos
                  (if (isNone failure)
                    (match (relateOne ex r edge f t)
                      ((Ok pair) (vecPush pairs pair))
                      ((Err e)
                        (set failure (Some e))
                      )))))
              (match failure
                ((Some e) (Err e))
                ((None)
                  {
                    (let v (writeReturn ex r.return 0 r.only pairs)?)
                    (Ok (FValue v))
                  }
                ))
            }
          }
        }
      }
    }
  })

; One side of a RELATE, as the records it names. A side's records
; must exist: a dangling edge would answer queries with holes, so
; AXQLite refuses where SurrealDB allows.
(:: relateSide (-> Exec Expr String (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (relateSide ex e which)
  {
    (let rows vecNew)
    {
      (let _ (targetRowsRelaxed ex e rows)?)
      (if (== (vecLen rows) 0)
        (axqErr axqNotFound (concat (concat "the record to relate " which) " does not exist")
          "RELATE")
        (Ok rows))
    }
  })

(:: targetRowsRelaxed (-> Exec Expr (Vec Value) (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (targetRowsRelaxed ex e out)
  (match e
    ((ERecord table keyExpr)
      {
        (let key (eval ex keyExpr)?)
        (match (tableDefOpt ex table)
          ((Err err) (Err err))
          ((Ok (None)) (Ok 0))
          ((Ok (Some t))
            {
              (let rec (axqlGetRecord ex t key)?)
              (match rec
                ((Some doc)
                  {
                    (vecPush out doc)
                    (Ok 0)
                  }
                )
                ((None) (Ok 0)))
            }
          ))
      }
    )
    (_ (targetRows ex e out))))

; The edge table for `name`, made on first use with the two indexes
; traversal walks, and marked so edge-less steps find it.
(:: ensureEdgeTable (-> Exec String (Result TableDef Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (ensureEdgeTable ex name)
  {
    (let fresh (isNone (tableDefOpt ex name)?))
    {
      (let t (ensureTable ex name)?)
      (if (! fresh)
        (Ok t)
        {
          (let inRoot (defineIndexNow ex "__in" t (vecPush vecNew "in") false)?)
          {
            (let _ (putAutoIndex ex "__in" name "in" inRoot)?)
            {
              (let outRoot (defineIndexNow ex "__out" t (vecPush vecNew "out") false)?)
              {
                (let _ (putAutoIndex ex "__out" name "out" outRoot)?)
                {
                  (let _ (markEdgeTable ex name)?)
                  {
                    (schemaDirty ex)
                    (tableDef ex name)
                  }
                }
              }
            }
          }
        })
    }
  })

(:: relateOne (-> Exec Relate TableDef Value Value (Result Pair Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (relateOne ex r edge fromDoc toDoc)
  {
    (let fromRid (recordOfValue fromDoc))
    (let toRid (recordOfValue toDoc))
    (match fromRid
      ((None) (axqErr axqType "a RELATE side is not a record" "RELATE"))
      ((Some f)
        (match toRid
          ((None) (axqErr axqType "a RELATE side is not a record" "RELATE"))
          ((Some t)
            {
              (let key
                (match r.edgeId
                  ((Some ke) (eval ex ke)?)
                  ((None) (nextAutoKey ex edge)?)))
              {
                (let ref (Ref :table edge :key key :before VNone))
                {
                  (let w
                    (Write
                      :only r.only
                      :targets vecNew
                      :content r.content
                      :where None
                      :return r.return))
                  {
                    (let candidate (buildAfter ex ref w 0)?)
                    {
                      (let withEnds (objSet (objSet candidate "in" (VRecord f)) "out" (VRecord t)))
                      {
                        (let existing (axqlGetRecord ex edge key)?)
                        (if (isSome existing)
                          (axqErr axqExists
                            (concat "the edge already exists: "
                              (valueText (recordId edge.name key)))
                            "RELATE")
                          {
                            (let after (processFields ex edge VNone withEnds true)?)
                            {
                              (let pair (commitRecord ex ref after "create")?)
                              (match pair
                                ((Some p) (Ok p))
                                ((None) (Ok (Pair :before VNone :after after))))
                            }
                          })
                      }
                    }
                  }
                }
              }
            }
          ))
      ))
  })

(:: execInsert (-> Exec String Expr (Vec Assign) Return (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execInsert ex table data dup ret)
  {
    (let _ (ensureWrite ex)?)
    {
      (let v (eval ex data)?)
      {
        (let docs
          (match v
            ((VArray xs) xs)
            ((VObject _) (vecPush vecNew v))
            (_ vecNew)))
        (if (&& (== (vecLen docs) 0) (! (isArrayValue v)))
          (axqErr axqType "INSERT takes an object or an array of objects" "INSERT")
          {
            (let pairs vecNew)
            (let mut failure None)
            {
              (for doc in docs
                (if (isNone failure)
                  (match (insertOne ex table doc dup)
                    ((Ok pair) (vecPush pairs pair))
                    ((Err e)
                      (set failure (Some e))
                    ))))
              (match failure
                ((Some e) (Err e))
                ((None)
                  {
                    (let out (writeReturn ex ret 0 false pairs)?)
                    (Ok (FValue out))
                  }
                ))
            }
          })
      }
    }
  })

(:: isArrayValue (-> Value Bool))
(fn (isArrayValue v)
  (match v
    ((VArray _) true)
    (_ false)))

(:: insertOne (-> Exec String Value (Vec Assign) (Result Pair Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (insertOne ex table doc dup)
  (match doc
    ((VObject _)
      {
        (let idValue (valField doc "id"))
        {
          (let placed (insertPlace ex table idValue)?)
          (match placed
            ((Some ref) (insertAt ex ref doc dup))
            ((None)
              {
                (let t (ensureTable ex table)?)
                {
                  (let key (nextAutoKey ex t)?)
                  (insertAt ex (Ref :table t :key key :before VNone) doc dup)
                }
              }
            ))
        }
      }
    )
    (_ (axqErr axqType "INSERT takes objects" "INSERT"))))

(:: insertPlace (-> Exec String Value (Result (Option Ref) Error)))
;@axiom:effect(io)
(fn (insertPlace ex table idValue)
  (match idValue
    ((VNone)
      (if (strIsEmpty table)
        (axqErr axqType "an inserted object without an id needs INSERT INTO a table" "INSERT")
        (Ok None))
    )
    ((VRecord rid)
      {
        (let t (ensureTable ex rid.table)?)
        {
          (let rec (axqlGetRecord ex t rid.key)?)
          (Ok
            (Some
              (Ref
                :table t
                :key rid.key
                :before
                  (match rec
                    ((Some d) d)
                    ((None) VNone)))))
        }
      }
    )
    (_
      (if (strIsEmpty table)
        (axqErr axqType "an id that is only a key needs INSERT INTO a table" "INSERT")
        (if (! (valueIsKey idValue))
          (axqErr axqType "an inserted id is a record, or an int, text or uuid key" "INSERT")
          {
            (let t (ensureTable ex table)?)
            {
              (let rec (axqlGetRecord ex t idValue)?)
              (Ok
                (Some
                  (Ref
                    :table t
                    :key idValue
                    :before
                      (match rec
                        ((Some d) d)
                        ((None) VNone)))))
            }
          }))
    )))

(:: insertAt (-> Exec Ref Value (Vec Assign) (Result Pair Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (insertAt ex r doc dup)
  {
    (let t r.table)
    (let full (docWithId t.name r.key (docStored doc)))
    (if (isNoneDoc r.before)
      {
        (let after (processFields ex t VNone full true)?)
        {
          (let pair (commitRecord ex r after "create")?)
          (match pair
            ((Some p) (Ok p))
            ((None) (Ok (Pair :before VNone :after after))))
        }
      }
      (if (== (vecLen dup) 0)
        (axqErr axqExists
          (concat "the record already exists: " (valueText (recordId t.name r.key))) "INSERT")
        {
          (pushFrame ex)
          (varSet ex "input" full)
          {
            (let merged (applyAssigns ex r.before dup (lambda (x) (Ok x))))
            {
              (popFrame ex)
              {
                (let candidate merged?)
                {
                  (let after (processFields ex t r.before candidate false)?)
                  {
                    (let pair (commitRecord ex r after "update")?)
                    (match pair
                      ((Some p) (Ok p))
                      ((None) (Ok (Pair :before r.before :after after))))
                  }
                }
              }
            }
          }
        }))
  })

; ------------------------------------------------------------------
; Definitions.
; ------------------------------------------------------------------
(:: defineTextOf (-> Stmt String String))
(fn (defineTextOf stmt text)
  (if (strIsEmpty text)
    (stmtText stmt)
    text))

; The shared door of DEFINE for entries that own no tree, or keep
; the one they have under OVERWRITE (root -1).
(:: defineEntry (-> Exec String String String String Bool Bool Int (Result Flow Error)))
;@axiom:effect(io)
(fn (defineEntry ex kind table name text ifNotExists overwrite root)
  {
    (let s (schemaOf ex)?)
    {
      (let found (axqlFindEntry s kind table name))
      (match found
        ((Some e)
          (if ifNotExists
            (Ok (FValue VNone))
            (if overwrite
              {
                (let _ (ensureWrite ex)?)
                {
                  (let _
                    (axqlReplaceEntry ex.pager
                      (SchemaEntry
                        :rowid e.rowid
                        :kind kind
                        :name e.name
                        :table e.table
                        :root
                          (if (== root -1)
                            e.root
                            root)
                        :text text))?)
                  {
                    (schemaDirty ex)
                    (Ok (FValue VNone))
                  }
                }
              }
              (axqErr axqSchema
                (concat (concat (concat "the " kind) " ")
                  (concat (concat name " is already defined; ")
                    "add IF NOT EXISTS to keep it, or OVERWRITE to replace it"))
                "DEFINE")))
        )
        ((None)
          {
            (let _ (ensureWrite ex)?)
            {
              (let _
                (axqlPutEntry ex.pager
                  (SchemaEntry
                    :rowid 0
                    :kind kind
                    :name name
                    :table
                      (if (strIsEmpty table)
                        name
                        table)
                    :root
                      (if (< root 0)
                        0
                        root)
                    :text text))?)
              {
                (schemaDirty ex)
                (Ok (FValue VNone))
              }
            }
          }
        ))
    }
  })

(:: execDefineTable (-> Exec Stmt String (Result Flow Error)))
;@axiom:effect(io)
(fn (execDefineTable ex stmt text)
  (match stmt
    ((SDefineTable name ifNotExists overwrite _schema feed)
      {
        (let s (schemaOf ex)?)
        {
          (let found (axqlFindEntry s kindTable "" name))
          (match found
            ((None)
              {
                (let _ (ensureWrite ex)?)
                {
                  (let root (btreeCreate ex.pager btreeTable)?)
                  {
                    (let _
                      (axqlPutEntry ex.pager
                        (SchemaEntry
                          :rowid 0
                          :kind kindTable
                          :name name
                          :table name
                          :root root
                          :text (defineTextOf stmt text)))?)
                    {
                      (schemaDirty ex)
                      (afterDefineTable ex name feed)
                    }
                  }
                }
              }
            )
            ((Some _e)
              (if ifNotExists
                (Ok (FValue VNone))
                {
                  (let r
                    (defineEntry ex kindTable "" name (defineTextOf stmt text) ifNotExists
                      overwrite -1)?)
                  {
                    (let _ (afterDefineTable ex name feed)?)
                    (Ok r)
                  }
                })
            ))
        }
      }
    )
    (_ (Ok (FValue VNone)))))

(:: afterDefineTable (-> Exec String Bool (Result Flow Error)))
;@axiom:effect(io)
(fn (afterDefineTable ex name feed)
  (if (! feed)
    (Ok (FValue VNone))
    {
      (let t (tableDef ex name)?)
      {
        (let _ (ensureFeed ex t)?)
        (Ok (FValue VNone))
      }
    }))

(:: execDefineField (-> Exec Stmt String (Result Flow Error)))
;@axiom:effect(io)
(fn (execDefineField ex stmt text)
  (match stmt
    ((SDefineField name table ifNotExists overwrite _ft _d _v _a _ro)
      {
        (let _ (ensureTable ex table)?)
        (defineEntry ex kindField table name (defineTextOf stmt text) ifNotExists overwrite 0)
      }
    )
    (_ (Ok (FValue VNone)))))

(:: execDefineIndex (-> Exec Stmt String (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execDefineIndex ex stmt text)
  (match stmt
    ((SDefineIndex name table ifNotExists overwrite fields unique)
      (if (strStartsWith name "__")
        (axqErr axqSchema "an index name may not start with __: those are AXQLite's own" "DEFINE")
        {
          (let t (ensureTable ex table)?)
          {
            (let s (schemaOf ex)?)
            {
              (let found (axqlFindEntry s kindIndex table name))
              (match found
                ((Some _e)
                  (if overwrite
                    (redefineIndex ex stmt text t name fields unique)
                    (defineEntry ex kindIndex table name (defineTextOf stmt text) ifNotExists
                      overwrite -1))
                )
                ((None)
                  {
                    (let root (defineIndexNow ex name t fields unique)?)
                    (defineEntry ex kindIndex table name (defineTextOf stmt text) false false root)
                  }
                ))
            }
          }
        })
    )
    (_ (Ok (FValue VNone)))))

; OVERWRITE on an index rebuilds it: drop the old tree, fill a new
; one, and point the entry at it.
(:: redefineIndex (-> Exec Stmt String TableDef String (Vec String) Bool (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (redefineIndex ex stmt text t name fields unique)
  {
    (let s (schemaOf ex)?)
    (match (axqlFindEntry s kindIndex t.name name)
      ((None) (Ok (FValue VNone)))
      ((Some e)
        {
          (let _ (ensureWrite ex)?)
          {
            (let _ (btreeDrop ex.pager e.root)?)
            {
              (schemaDirty ex)
              {
                (let fresh (tableDef ex t.name)?)
                {
                  (let root (defineIndexNow ex name fresh fields unique)?)
                  (defineEntry ex kindIndex t.name name (defineTextOf stmt text) false true root)
                }
              }
            }
          }
        }
      ))
  })

; Make an index tree and fill it from the table as it stands.
(:: defineIndexNow (-> Exec String TableDef (Vec String) Bool (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (defineIndexNow ex name t fields unique)
  {
    (let _ (ensureWrite ex)?)
    {
      (let root (btreeCreate ex.pager btreeIndex)?)
      {
        (let ix (IndexDef :name name :root root :fields fields :unique unique))
        {
          (let rows (scanTable ex t)?)
          {
            (let withIx
              (TableDef
                :name t.name
                :root t.root
                :schemafull t.schemafull
                :changefeed t.changefeed
                :fields t.fields
                :indexes (vecPush vecNew ix)
                :events t.events))
            {
              (let mut failure None)
              {
                (for row in rows
                  (if (isNone failure)
                    (match (recordOfValue row)
                      ((None) 0)
                      ((Some rid)
                        (match (backfillOne ex withIx ix rid.key row)
                          ((Ok _) 0)
                          ((Err e)
                            (set failure (Some e))
                          ))
                      ))))
                (match failure
                  ((Some e) (Err e))
                  ((None) (Ok root)))
              }
            }
          }
        }
      }
    }
  })

(:: backfillOne (-> Exec TableDef IndexDef Value Value (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (backfillOne ex t ix key row)
  {
    (let _
      (if ix.unique
        (checkUniqueOne ex t ix key row)
        (Ok 0))?)
    {
      (let k (indexKeyOf t ix key row)?)
      {
        (let _ (btreePut ex.pager ix.root k "")?)
        (Ok 0)
      }
    }
  })

(:: execDefineNamed (-> Exec Stmt String String (Result Flow Error)))
;@axiom:effect(io)
(fn (execDefineNamed ex stmt text kind)
  (match stmt
    ((SDefineEvent name table ifNotExists overwrite _when _then)
      {
        (let _ (ensureTable ex table)?)
        (defineEntry ex kind table name (defineTextOf stmt text) ifNotExists overwrite 0)
      }
    )
    ((SDefineFunction name ifNotExists overwrite _params _body)
      (defineEntry ex kind "" name (defineTextOf stmt text) ifNotExists overwrite 0)
    )
    (_ (Ok (FValue VNone)))))

(:: execRemove (-> Exec String String String Bool (Result Flow Error)))
;@axiom:effect(io)
(fn (execRemove ex kind name table ifExists)
  {
    (let s (schemaOf ex)?)
    {
      (let entryKind
        (if (strEq kind "table")
            kindTable
          (strEq kind "field")
            kindField
          (strEq kind "index")
            kindIndex
          (strEq kind "event")
            kindEvent
          kindFunction))
      {
        (let found (axqlFindEntry s entryKind table name))
        (match found
          ((None)
            (if ifExists
              (Ok (FValue VNone))
              (axqErr axqSchema (concat (concat (concat "no such " kind) ": ") name) "REMOVE"))
          )
          ((Some e)
            {
              (let _ (ensureWrite ex)?)
              (if (strEq kind "table")
                (removeTable ex e)
                (if (strEq kind "index")
                  {
                    (let _ (btreeDrop ex.pager e.root)?)
                    {
                      (let _ (axqlDeleteEntry ex.pager e.rowid)?)
                      {
                        (schemaDirty ex)
                        (Ok (FValue VNone))
                      }
                    }
                  }
                  {
                    (let _ (axqlDeleteEntry ex.pager e.rowid)?)
                    {
                      (schemaDirty ex)
                      (Ok (FValue VNone))
                    }
                  }))
            }
          ))
      }
    }
  })

(:: removeTable (-> Exec SchemaEntry (Result Flow Error)))
;@axiom:effect(io)
(fn (removeTable ex e)
  {
    (let s (schemaOf ex)?)
    {
      (let _ (btreeDrop ex.pager e.root)?)
      {
        (let mut failure None)
        {
          (for x in s.entries
            (if (&& (isNone failure) (&& (! (strEq x.kind kindTable)) (axqlWordEq x.table e.name)))
              (match (dropEntryOf ex x)
                ((Ok _) 0)
                ((Err err)
                  (set failure (Some err))
                ))))
          (match failure
            ((Some err) (Err err))
            ((None)
              {
                (let _ (metaDelete ex (concat "c:" e.name))?)
                {
                  (let _ (metaDelete ex (concat "edge:" e.name))?)
                  {
                    (let _ (axqlDeleteEntry ex.pager e.rowid)?)
                    {
                      (schemaDirty ex)
                      (Ok (FValue VNone))
                    }
                  }
                }
              }
            ))
        }
      }
    }
  })

; An edge table's own index entry, with the text a reader can
; parse back into the same index.
(:: putAutoIndex (-> Exec String String String Int (Result Int Error)))
;@axiom:effect(io)
(fn (putAutoIndex ex name table field root)
  (axqlPutEntry ex.pager
    (SchemaEntry
      :rowid 0
      :kind kindIndex
      :name name
      :table table
      :root root
      :text
        (concat (concat (concat "DEFINE INDEX " name) (concat " ON " table))
          (concat " FIELDS " field)))))

(:: dropEntryOf (-> Exec SchemaEntry (Result Int Error)))
;@axiom:effect(io)
(fn (dropEntryOf ex x)
  {
    (let _
      (if (|| (strEq x.kind kindIndex) (strEq x.kind kindFeed))
        (btreeDrop ex.pager x.root)
        (Ok 0))?)
    (axqlDeleteEntry ex.pager x.rowid)
  })

; ------------------------------------------------------------------
; INFO, SHOW, LIVE.
; ------------------------------------------------------------------
(:: execInfo (-> Exec String String (Result Value Error)))
;@axiom:effect(io)
(fn (execInfo ex kind name)
  {
    (let _ (ensureRead ex)?)
    {
      (let s (schemaOf ex)?)
      (if (strEq kind "table")
        {
          (let t (axqlTableDef s name)?)
          (Ok (tableInfo s t))
        }
        {
          (let tables vecNew)
          (let mut failure None)
          {
            (for e in s.entries
              (if (&& (isNone failure) (strEq e.kind kindTable))
                (match (axqlTableDef s e.name)
                  ((Ok t) (vecPush tables (Field :name e.name :value (tableInfo s t))))
                  ((Err err)
                    (set failure (Some err))
                  ))))
            (match failure
              ((Some err) (Err err))
              ((None)
                {
                  (let fs vecNew)
                  {
                    (vecPush fs (Field :name "tables" :value (VObject tables)))
                    (vecPush fs (Field :name "functions" :value (VArray (functionNames s))))
                    (Ok (VObject fs))
                  }
                }
              ))
          }
        })
    }
  })

(:: functionNames (-> Schema (Vec Value)))
(fn (functionNames s)
  {
    (let out vecNew)
    {
      (for e in s.entries
        (if (strEq e.kind kindFunction)
          (vecPush out (VText (concat "fn::" e.name)))))
      out
    }
  })

(:: tableInfo (-> Schema TableDef Value))
(fn (tableInfo s t)
  {
    (let fs vecNew)
    {
      (vecPush fs (Field :name "name" :value (VText t.name)))
      (vecPush fs (Field :name "schemafull" :value (VBool t.schemafull)))
      (vecPush fs
        (Field
          :name "changefeed"
          :value (VBool (|| t.changefeed (isSome (axqlFeedRoot s t.name))))))
      {
        (let fields vecNew)
        {
          (for fd in t.fields
            (vecPush fields (fieldInfo fd)))
          (vecPush fs (Field :name "fields" :value (VArray fields)))
        }
      }
      {
        (let indexes vecNew)
        {
          (for ix in t.indexes
            (vecPush indexes (indexInfo ix)))
          (vecPush fs (Field :name "indexes" :value (VArray indexes)))
        }
      }
      {
        (let events vecNew)
        {
          (for ev in t.events
            (vecPush events (VText ev.name)))
          (vecPush fs (Field :name "events" :value (VArray events)))
        }
      }
      (VObject fs)
    }
  })

(:: fieldInfo (-> FieldDef Value))
(fn (fieldInfo fd)
  {
    (let fs vecNew)
    {
      (vecPush fs (Field :name "name" :value (VText fd.name)))
      (match fd.ftype
        ((Some t) (vecPush fs (Field :name "type" :value (VText (typeText t)))))
        ((None) (vecPush fs (Field :name "type" :value VNone))))
      (vecPush fs (Field :name "readonly" :value (VBool fd.readonly)))
      (vecPush fs (Field :name "hasDefault" :value (VBool (isSome fd.dflt))))
      (vecPush fs (Field :name "computed" :value (VBool (isSome fd.value))))
      (vecPush fs (Field :name "asserted" :value (VBool (isSome fd.assert))))
      (VObject fs)
    }
  })

(:: indexInfo (-> IndexDef Value))
(fn (indexInfo ix)
  {
    (let fs vecNew)
    {
      (vecPush fs (Field :name "name" :value (VText ix.name)))
      {
        (let fields vecNew)
        {
          (for f in ix.fields
            (vecPush fields (VText f)))
          (vecPush fs (Field :name "fields" :value (VArray fields)))
        }
      }
      (vecPush fs (Field :name "unique" :value (VBool ix.unique)))
      (VObject fs)
    }
  })

(:: execShow (-> Exec String (Option Expr) (Option Expr) (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execShow ex table since limit)
  {
    (let _ (ensureRead ex)?)
    {
      (let t (tableDef ex table)?)
      {
        (let s (schemaOf ex)?)
        (match (axqlFeedRoot s t.name)
          ((None) (Ok (VArray vecNew)))
          ((Some root)
            {
              (let from (windowBound ex since 0)?)
              {
                (let cap (windowBound ex limit -1)?)
                {
                  (let rows (Collect :items vecNew))
                  {
                    (let _
                      (btreeScan ex.pager root (Some (keyRowid (+ from 1))) None true
                        (lambda (k v) (collectFeed rows cap v)))?)
                    (Ok (VArray rows.items))
                  }
                }
              }
            }
          ))
      }
    }
  })

(:: collectFeed (-> Collect Int String (Result Bool Error)))
(fn (collectFeed rows cap v)
  (if (&& (>= cap 0) (>= (vecLen rows.items) cap))
    (Ok false)
    {
      (let doc (recDecode v)?)
      {
        (vecPush rows.items doc)
        (Ok true)
      }
    }))

(:: execLive (-> Exec Select String (Result Flow Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (execLive ex sel text)
  (if (!= (vecLen sel.targets) 1)
    (axqErr axqType "LIVE SELECT reads one table" "LIVE")
    (match (vecGet sel.targets 0)
      ((ETable name)
        (if (strIsEmpty text)
          (axqErr axqMisuse "LIVE needs its statement as text" "LIVE")
          {
            (let t (tableDef ex name)?)
            {
              (let root (ensureFeed ex t)?)
              {
                (let cursor (feedLastSeq ex root)?)
                (match uuidV4
                  ((Err e) (Err e))
                  ((Ok u)
                    {
                      (let id (uuidToString u))
                      {
                        (let fs vecNew)
                        {
                          (vecPush fs (Field :name "table" :value (VText t.name)))
                          (vecPush fs (Field :name "text" :value (VText text)))
                          (vecPush fs (Field :name "cursor" :value (VInt cursor)))
                          {
                            (let _ (metaPut ex (concat "live:" id) (VObject fs))?)
                            (Ok (FValue (VText id)))
                          }
                        }
                      }
                    }
                  ))
              }
            }
          })
      )
      (_ (axqErr axqType "LIVE SELECT reads one table" "LIVE")))))

(:: killLive (-> Exec Value (Result Int Error)))
;@axiom:effect(io)
(fn (killLive ex v)
  (match v
    ((VText id)
      {
        (let gone (metaDelete ex (concat "live:" id))?)
        (if gone
          (Ok 0)
          (axqErr axqNotFound (concat "no live query " id) "KILL"))
      }
    )
    (_ (axqErr axqType "KILL takes a live query's id, as text" "KILL"))))

;; The changes a live query has not been shown yet, each as
;; `{action, result}` with the record run through the query's own
;; WHERE and projection. Advances the query's cursor.
(pub :: axqlPollLive (-> Exec String (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (axqlPollLive ex id)
  {
    (let sub (metaGet ex (concat "live:" id))?)
    (match sub
      ((None) (axqErr axqNotFound (concat "no live query " id) "axqlPollLive"))
      ((Some doc) (pollSub ex id doc)))
  })

(:: pollSub (-> Exec String Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (pollSub ex id doc)
  {
    (let table (textField doc "table"))
    (let text (textField doc "text"))
    (let cursor
      (match (objGet doc "cursor")
        ((Some (VInt n)) n)
        (_ 0)))
    {
      (let t (tableDef ex table)?)
      {
        (let s (schemaOf ex)?)
        (match (axqlFeedRoot s t.name)
          ((None) (Ok vecNew))
          ((Some root)
            {
              (let parsed (axqlParse text)?)
              (match parsed.stmt
                ((SLive sel)
                  {
                    (let entries (Collect :items vecNew))
                    {
                      (let _
                        (btreeScan ex.pager root (Some (keyRowid (+ cursor 1))) None true
                          (lambda (k v) (collectFeed entries -1 v)))?)
                      {
                        (let out vecNew)
                        (let mut failure None)
                        (let mut last cursor)
                        {
                          (for entry in entries.items
                            {
                              (match (objGet entry "versionstamp")
                                ((Some (VInt n))
                                  (set last n)
                                )
                                (_ 0))
                              (if (isNone failure)
                                (match (liveEmit ex sel entry)
                                  ((Ok (Some v)) (vecPush out v))
                                  ((Ok (None)) 0)
                                  ((Err e)
                                    (set failure (Some e))
                                  )))
                            })
                          (match failure
                            ((Some e) (Err e))
                            ((None)
                              {
                                (let _
                                  (metaPut ex (concat "live:" id)
                                    (objSet doc "cursor" (VInt last)))?)
                                (Ok out)
                              }
                            ))
                        }
                      }
                    }
                  }
                )
                (_ (axqErr axqCorrupt "a live query without a LIVE SELECT" "axqlPollLive")))
            }
          ))
      }
    }
  })

(:: liveEmit (-> Exec Select Value (Result (Option Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (liveEmit ex sel entry)
  {
    (let action (textField entry "action"))
    (let result (valField entry "result"))
    {
      (let kept (filterRows ex (vecPush vecNew result) sel.where)?)
      (if (== (vecLen kept) 0)
        (Ok None)
        {
          (let shown (projectRow ex sel result)?)
          {
            (let fs vecNew)
            {
              (vecPush fs (Field :name "action" :value (VText action)))
              (vecPush fs (Field :name "result" :value shown))
              (Ok (Some (VObject fs)))
            }
          }
        })
    }
  })

(:: textField (-> Value String String))
(fn (textField doc name)
  (match (objGet doc name)
    ((Some (VText s)) s)
    (_ "")))

;; The whole database as AXQL that rebuilds it: every definition in
;; the order it was made, then one CREATE per record, tables in
;; schema order and records in key order.
(pub :: axqlDump (-> Exec (Result String Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (axqlDump ex)
  {
    (let _ (ensureRead ex)?)
    {
      (let s (schemaOf ex)?)
      {
        (let b strBuilderNew)
        {
          (for e in s.entries
            (if (&& (! (strEq e.kind kindFeed)) (&& (! (strEq e.kind kindMeta)) (! (strIsEmpty e.text))))
              {
                (strBuilderPush b e.text)
                (strBuilderPush b ";\n")
              }))
          {
            (let mut failure None)
            {
              (for e in s.entries
                (if (&& (isNone failure) (strEq e.kind kindTable))
                  (match (dumpTable ex s e b)
                    ((Ok _) 0)
                    ((Err err) (set failure (Some err))))))
              (match failure
                ((Some err) (Err err))
                ((None) (Ok (strBuilderFinish b))))
            }
          }
        }
      }
    }
  })

(:: dumpTable (-> Exec Schema SchemaEntry StrBuilder (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (dumpTable ex s e b)
  {
    (let t (axqlTableDef s e.name)?)
    {
      (let rows (scanTable ex t)?)
      {
        (for row in rows
          {
            (strBuilderPush b "CREATE ")
            (strBuilderPush b (valueText (valField row "id")))
            (strBuilderPush b " CONTENT ")
            (strBuilderPush b (valueText row))
            (strBuilderPush b ";\n")
          })
        (Ok 0)
      }
    }
  })

;; Finish a run that made its own calls (polling), for the API layer.
(pub :: axqlFinishRun (-> Exec (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlFinishRun ex)
  (finishRun ex))

;; Roll back a run that made its own calls, for the API layer.
(pub :: axqlAbortRun (-> Exec Int))
;@axiom:effect(io)
(pub fn (axqlAbortRun ex)
  (abortRun ex))

; ------------------------------------------------------------------
; Statements as text again, so a definition made from an AST the
; caller built still has the one textual shape the schema stores.
; ------------------------------------------------------------------
;; A statement written as AXQL. Definitions are covered in full;
;; other statements only where a definition's body needs them.
;; Every binary expression is parenthesised, which reads plainly
;; and parses back whole.
(pub :: stmtText (-> Stmt String))
(pub fn (stmtText stmt)
  (match stmt
    ((SDefineTable name ifNotExists overwrite schema feed)
      (concat
        (concat (concat (concat "DEFINE TABLE " (ifClauseText ifNotExists overwrite)) name)
          (if (== schema 1)
              " SCHEMAFULL"
            (== schema 2)
              " SCHEMALESS"
            ""))
        (if feed
          " CHANGEFEED"
          ""))
    )
    ((SDefineField name table ifNotExists overwrite ftype dflt value assert readonly)
      (concat
        (concat
          (concat (concat (concat "DEFINE FIELD " (ifClauseText ifNotExists overwrite)) name)
            (concat " ON " table))
          (concat
            (concat
              (optText " TYPE "
                (match ftype
                  ((Some t) (typeText t))
                  ((None) "")))
              (optExprText " DEFAULT " dflt))
            (concat (optExprText " VALUE " value) (optExprText " ASSERT " assert))))
        (if readonly
          " READONLY"
          ""))
    )
    ((SDefineIndex name table ifNotExists overwrite fields unique)
      (concat
        (concat
          (concat (concat (concat "DEFINE INDEX " (ifClauseText ifNotExists overwrite)) name)
            (concat " ON " table))
          (concat " FIELDS " (strJoin fields ", ")))
        (if unique
          " UNIQUE"
          ""))
    )
    ((SDefineEvent name table ifNotExists overwrite when then)
      (concat
        (concat
          (concat (concat (concat "DEFINE EVENT " (ifClauseText ifNotExists overwrite)) name)
            (concat " ON " table))
          (concat " WHEN " (exprText when)))
        (concat " THEN { " (concat (stmtsText then) " }")))
    )
    ((SDefineFunction name ifNotExists overwrite params body)
      (concat
        (concat
          (concat (concat "DEFINE FUNCTION " (ifClauseText ifNotExists overwrite))
            (concat (concat "fn::" name) (concat "(" (concat (paramsText params) ")"))))
          " { ")
        (concat (stmtsText body) " }"))
    )
    ((SExpr e) (exprText e))
    ((SReturn e) (concat "RETURN " (exprText e)))
    ((SLet name e) (concat (concat (concat "LET $" name) " = ") (exprText e)))
    ((SThrow e) (concat "THROW " (exprText e)))
    (_ "")))

(:: ifClauseText (-> Bool Bool String))
(fn (ifClauseText ifNotExists overwrite)
  (if ifNotExists
      "IF NOT EXISTS "
    overwrite
      "OVERWRITE "
    ""))

(:: optText (-> String String String))
(fn (optText prefix body)
  (if (strIsEmpty body)
    ""
    (concat prefix body)))

(:: optExprText (-> String (Option Expr) String))
(fn (optExprText prefix e)
  (match e
    ((None) "")
    ((Some x) (concat prefix (exprText x)))))

(:: paramsText (-> (Vec ParamDef) String))
(fn (paramsText params)
  {
    (let parts vecNew)
    {
      (for p in params
        (vecPush parts
          (concat (concat "$" p.name)
            (match p.ftype
              ((Some t) (concat ": " (typeText t)))
              ((None) "")))))
      (strJoin parts ", ")
    }
  })

(:: stmtsText (-> (Vec Stmt) String))
(fn (stmtsText stmts)
  {
    (let parts vecNew)
    {
      (for s in stmts
        (vecPush parts (stmtText s)))
      (strJoin parts "; ")
    }
  })

;; An expression written as AXQL.
(pub :: exprText (-> Expr String))
(pub fn (exprText e)
  (match e
    ((ELit v) (valueText v))
    ((EArray xs)
      {
        (let parts vecNew)
        {
          (for x in xs
            (vecPush parts (exprText x)))
          (concat (concat "[" (strJoin parts ", ")) "]")
        }
      }
    )
    ((EObject fs)
      {
        (let parts vecNew)
        {
          (for f in fs
            (vecPush parts (concat (concat f.name ": ") (exprText f.expr))))
          (concat (concat "{ " (strJoin parts ", ")) " }")
        }
      }
    )
    ((EParam n) (concat "$" n))
    ((ETable n) n)
    ((ERecord t k) (concat (concat t ":") (exprText k)))
    ((EName n) n)
    ((EPath base steps)
      {
        (let mut out (exprText base))
        {
          (for s in steps
            (set out (concat out (stepText s))))
          out
        }
      }
    )
    ((EBinary op l r)
      (concat (concat (concat "(" (exprText l)) (concat (concat " " (opText op)) " "))
        (concat (exprText r) ")"))
    )
    ((EUnary op x)
      (if (strEq op "not")
        (concat "NOT " (exprText x))
        (concat "-" (exprText x)))
    )
    ((ECall name args)
      {
        (let parts vecNew)
        {
          (for a in args
            (vecPush parts (exprText a)))
          (concat (concat (concat name "(") (strJoin parts ", ")) ")")
        }
      }
    )
    ((ECast t x) (concat (concat (concat "<" (typeText t)) ">") (exprText x)))
    ((EIf c then els)
      (concat (concat (concat "IF " (exprText c)) (concat " { " (concat (exprText then) " }")))
        (match els
          ((Some arm) (concat " ELSE { " (concat (exprText arm) " }")))
          ((None) "")))
    )
    ((EBlock stmts) (stmtsText stmts))
    ((ESelect sel) (concat "(" (concat (selectText sel) ")")))))

(:: opText (-> String String))
(fn (opText op)
  (if (strEq op "and")
      "AND"
    (strEq op "or")
      "OR"
    (strEq op "in")
      "IN"
    (strEq op "inside")
      "INSIDE"
    (strEq op "outside")
      "OUTSIDE"
    (strEq op "contains")
      "CONTAINS"
    (strEq op "is")
      "IS"
    (strEq op "isnot")
      "IS NOT"
    op))

(:: stepText (-> Step String))
(fn (stepText s)
  (match s
    ((SField n) (concat "." n))
    ((SDeref) ".*")
    ((SIndex e) (concat (concat "[" (exprText e)) "]"))
    ((SGraph g)
      {
        (let arrow
          (if (== g.dir 0)
              "->"
            (== g.dir 1)
              "<-"
            "<->"))
        (concat
          (concat arrow
            (if (strIsEmpty g.edge)
              "*"
              g.edge))
          (if (strIsEmpty g.next)
            ""
            (concat arrow g.next)))
      }
    )))

(:: selectText (-> Select String))
(fn (selectText sel)
  {
    (let parts vecNew)
    {
      (for p in sel.projs
        (vecPush parts
          (if p.star
            "*"
            (concat (exprText p.expr)
              (if (strIsEmpty p.alias)
                ""
                (concat " AS " p.alias))))))
      (concat
        (concat (concat "SELECT " (strJoin parts ", "))
          (if (== (vecLen sel.targets) 0)
            ""
            {
              (let ts vecNew)
              {
                (for t in sel.targets
                  (vecPush ts (exprText t)))
                (concat " FROM " (strJoin ts ", "))
              }
            }))
        (optExprText " WHERE " sel.where))
    }
  })
