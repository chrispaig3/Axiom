;;! Axqlite.Record - a value as bytes, and keys whose byte order is
;;! their values' order.
;;!
;;!     (recEncode (VObject fields))   ; (Ok <bytes>), `recDecode` reads back
;;!     (keyEncodeValue (VText "Ada")) ; the key of record person:Ada's key half
;;!     (keyCompare a b)               ; <0, 0 or >0, as memcmp orders
;
; These are the two byte formats a table and an index store. The B-tree
; (`Axqlite.Btree`) compares keys as byte strings and knows nothing
; about values; this module is where a value becomes bytes, and back.
;
; A RECORD is one value written out in full, as a table tree stores a
; record's document. Each value is a tag byte and a payload:
;
;     0  none       (nothing)
;     1  false      (nothing)
;     2  true       (nothing)
;     3  int        8 bytes, two's complement
;     4  float      8 bytes, the IEEE 754 binary64 bits
;     5  text       u32 length, then the bytes
;     6  bytes      u32 length, then the bytes
;     7  datetime   8 bytes, UTC microseconds since the epoch
;     8  duration   8 bytes, microseconds
;     9  uuid       the 16 bytes
;     10 array      u32 count, then each value
;     11 object     u32 count, then per field a u32 name length, the
;                   name's bytes, and the value
;     12 record     the table name as a text payload (u32 + bytes),
;                   then the key as a value
;
; Every integer is big-endian. Decoding checks every length against
; the record's size and answers `axqCorrupt` for a record that is
; short, has bytes left over, nests past 64 levels, or holds an
; unknown tag; it never reads past the record.
;
; A KEY sorts as its values do when two keys are compared bytewise
; (`keyCompare`, memcmp order). The type order is:
;
;     none < bool < number < text < bytes < datetime < duration
;          < uuid < record < array
;
; written as tags 1 to 13 (numbers take three: negative, zero,
; positive). Ints and floats share one numeric order: a number is
; written as its exact binary magnitude 1.m x 2^e, so (VInt 2) and
; (VFloat 2.0) are the same key, as are 0, 0.0 and -0.0, and 2^53 + 1
; still sorts above the float 2^53. The infinities sort beyond every
; finite number. A NaN has no place in the order and is refused
; (`axqType`), and so is an object. Text and bytes escape a 00 byte
; as 00 FF and end with 00 01, so a value sorts before every longer
; value it is a prefix of. A record writes its table escaped the same
; way, then its key's encoding. An array writes each element, then a
; 00 terminator.
;
; A table's key for a record is the key encoding of the record's key
; scalar alone. An index key is the encoding of the indexed fields'
; values followed by the record's key encoding, which makes every
; index key unique. The schema tree still keys its entries by rowid
; (`keyRowid`): 8 bytes with the sign bit flipped.
;
; LIMITS. A record holds at most 1 GiB (`axqTooBig` beyond) and nests
; at most 64 deep. `keyDecode` gives back the values of a key but not
; which numbers were ints: an integral number in the 64-bit range
; comes back as `VInt`, any other as `VFloat`.
(import Internal.Raw)
(import Str)
(import Vec)
(import Err)
(import Float)
(import Axqlite.Value)

; ------------------------------------------------------------------
; Bytes.
; ------------------------------------------------------------------
; Store the low `n` bytes of `v` big-endian at `a + off`.
(:: putBe (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (putBe a off n v)
  {
    (for i in 0..n
      (__store8 a (+ off i) (& (>> v (* 8 (- (- n 1) i))) 255)))
    0
  })

; The `n` bytes at `a + off` as a big-endian unsigned number (`n` <= 8;
; at 8 the top bit lands in the sign).
(:: getBe (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (getBe a off n)
  {
    (let mut v 0)
    {
      (for i in 0..n
        (set v (| (<< v 8) (__load8 a (+ off i)))))
      v
    }
  })

; `x` shifted right by `s` with zeros coming in, for `s` in 0..64.
(:: shrU (-> Int Int Int))
(fn (shrU x s)
  (if (<= s 0)
    x
    (if (>= s 64)
      0
      (& (>> x s) (- (<< 1 (- 64 s)) 1)))))

; `x` shifted left by `s`, for `s` in 0..64.
(:: shlU (-> Int Int Int))
(fn (shlU x s)
  (if (>= s 64)
    0
    (<< x s)))

; The position of the highest set bit of `x` > 0, 0..62.
(:: highBit (-> Int Int))
(fn (highBit x)
  {
    (let mut v x)
    (let mut p 0)
    {
      (while (> v 1)
        {
          (set v (>> v 1))
          (set p (+ p 1))
        })
      p
    }
  })

(:: corrupt (-> String String (Result a Error)))
(fn (corrupt what where)
  (axqErr axqCorrupt what where))

; A byte string being built.
(struct W
  (bs : (Vec Int)))

(:: wNew W)
(fn (wNew)
  (W :bs vecNew))

(:: wByte (-> W Int Int))
(fn (wByte w b)
  {
    (vecPush w.bs (& b 255))
    0
  })

; The low `n` bytes of `v`, big-endian.
(:: wBe (-> W Int Int Int))
(fn (wBe w n v)
  {
    (for i in 0..n
      (wByte w (>> v (* 8 (- (- n 1) i)))))
    0
  })

(:: wStr (-> W String Int))
;@axiom:effect(unsafe)
(fn (wStr w s)
  {
    (let a (strData s))
    {
      (for i in 0..(strLen s)
        (vecPush w.bs (__load8 a i)))
      0
    }
  })

(:: wFinish (-> W String))
;@axiom:effect(unsafe)
(fn (wFinish w)
  {
    (let n (vecLen w.bs))
    (let out (strAlloc n))
    {
      (for i in 0..n
        (__store8 (strData out) i (vecGet w.bs i)))
      out
    }
  })

; The string of `len` bytes at `a + off`.
(:: bytesAt (-> Int Int Int String))
(fn (bytesAt a off len)
  {
    (let out (strAlloc len))
    {
      (rawCopy (strData out) (+ a off) len)
      out
    }
  })

; ------------------------------------------------------------------
; Records.
; ------------------------------------------------------------------
; The largest record, in bytes.
(:: recMaxBytes Int)
(fn (recMaxBytes)
  1073741824)

(:: maxDepth Int)
(fn (maxDepth)
  64)

;; The bytes of one value, as the header describes. A NaN, a uuid that
;; isn't 16 bytes, or a record whose key is no scalar answers
;; `axqType`; nesting past 64 or a record over 1 GiB answers
;; `axqTooBig`.
(pub :: recEncode (-> Value (Result String Error)))
(pub fn (recEncode v)
  {
    (let w (wNew))
    {
      (let _ (encValue w v 0)?)
      (if (> (vecLen w.bs) recMaxBytes)
        (axqErr axqTooBig "a record over 1 GiB" "recEncode")
        (Ok (wFinish w)))
    }
  })

(:: encValue (-> W Value Int (Result Int Error)))
(fn (encValue w v depth)
  (if (> depth maxDepth)
    (axqErr axqTooBig "a value nested past 64 levels" "recEncode")
    (match v
      ((VNone) (Ok (wByte w 0)))
      ((VBool b)
        (Ok
          (wByte w
            (if b
              2
              1)))
      )
      ((VInt n)
        {
          (wByte w 3)
          (Ok (wBe w 8 n))
        }
      )
      ((VFloat x)
        (if (floatIsNan x)
          (axqErr axqType "a NaN can't be stored" "recEncode")
          {
            (wByte w 4)
            (Ok (wBe w 8 (floatToBits x)))
          })
      )
      ((VText s)
        {
          (wByte w 5)
          (wBe w 4 (strLen s))
          (Ok (wStr w s))
        }
      )
      ((VBytes s)
        {
          (wByte w 6)
          (wBe w 4 (strLen s))
          (Ok (wStr w s))
        }
      )
      ((VDatetime n)
        {
          (wByte w 7)
          (Ok (wBe w 8 n))
        }
      )
      ((VDuration n)
        {
          (wByte w 8)
          (Ok (wBe w 8 n))
        }
      )
      ((VUuid s)
        (if (!= (strLen s) 16)
          (axqErr axqType "a uuid is 16 bytes" "recEncode")
          {
            (wByte w 9)
            (Ok (wStr w s))
          })
      )
      ((VArray items)
        {
          (wByte w 10)
          (wBe w 4 (vecLen items))
          (encItems w items 0 (+ depth 1))
        }
      )
      ((VObject fs)
        {
          (wByte w 11)
          (wBe w 4 (vecLen fs))
          (encFields w fs 0 (+ depth 1))
        }
      )
      ((VRecord rid)
        (if (! (valueIsKey rid.key))
          (axqErr axqType "a record's key is an int, text or a uuid" "recEncode")
          {
            (wByte w 12)
            (wBe w 4 (strLen rid.table))
            (wStr w rid.table)
            (encValue w rid.key (+ depth 1))
          })
      ))))

(:: encItems (-> W (Vec Value) Int Int (Result Int Error)))
(fn (encItems w items i depth)
  (if (>= i (vecLen items))
    (Ok 0)
    {
      (let _ (encValue w (vecGet items i) depth)?)
      (encItems w items (+ i 1) depth)
    }))

(:: encFields (-> W (Vec Field) Int Int (Result Int Error)))
(fn (encFields w fs i depth)
  (if (>= i (vecLen fs))
    (Ok 0)
    {
      (let f (vecGet fs i))
      {
        (wBe w 4 (strLen f.name))
        (wStr w f.name)
        (let _ (encValue w f.value depth)?)
        (encFields w fs (+ i 1) depth)
      }
    }))

; A decoded value and the offset just past it.
(struct Dec
  (value : Value)
  (next : Int))

;; The value a record holds. Bytes that aren't a record answer
;; `axqCorrupt`.
(pub :: recDecode (-> String (Result Value Error)))
(pub fn (recDecode rec)
  {
    (let d (decValue (strData rec) 0 (strLen rec) 0)?)
    (if (!= d.next (strLen rec))
      (corrupt "a record with bytes left over" "recDecode")
      (Ok d.value))
  })

(:: decValue (-> Int Int Int Int (Result Dec Error)))
;@axiom:effect(unsafe)
(fn (decValue a at n depth)
  (if (> depth maxDepth)
    (corrupt "a record nested past 64 levels" "recDecode")
    (if (>= at n)
      (corrupt "a short record" "recDecode")
      {
        (let tag (__load8 a at))
        (if (== tag 0)
          (Ok (Dec :value VNone :next (+ at 1)))
          (if (== tag 1)
            (Ok (Dec :value (VBool false) :next (+ at 1)))
            (if (== tag 2)
              (Ok (Dec :value (VBool true) :next (+ at 1)))
              (if (== tag 3)
                (decFixed a at n 8 (lambda (x) (VInt x)))
                (if (== tag 4)
                  (decFixed a at n 8 (lambda (x) (VFloat (floatFromBits x))))
                  (if (== tag 5)
                    (decBytes a at n (lambda (s) (VText s)))
                    (if (== tag 6)
                      (decBytes a at n (lambda (s) (VBytes s)))
                      (if (== tag 7)
                        (decFixed a at n 8 (lambda (x) (VDatetime x)))
                        (if (== tag 8)
                          (decFixed a at n 8 (lambda (x) (VDuration x)))
                          (if (== tag 9)
                            (if (> (+ at 17) n)
                              (corrupt "a short record" "recDecode")
                              (Ok (Dec :value (VUuid (bytesAt a (+ at 1) 16)) :next (+ at 17))))
                            (if (== tag 10)
                              (decArray a at n depth)
                              (if (== tag 11)
                                (decObject a at n depth)
                                (if (== tag 12)
                                  (decRecord a at n depth)
                                  (corrupt "a record with an unknown tag" "recDecode"))))))))))))))
      })))

(:: decFixed (-> Int Int Int Int (-> Int Value) (Result Dec Error)))
(fn (decFixed a at n size mk)
  (if (> (+ at (+ 1 size)) n)
    (corrupt "a short record" "recDecode")
    (Ok (Dec :value (mk (getBe a (+ at 1) size)) :next (+ at (+ 1 size))))))

(:: decBytes (-> Int Int Int (-> String Value) (Result Dec Error)))
(fn (decBytes a at n mk)
  (if (> (+ at 5) n)
    (corrupt "a short record" "recDecode")
    {
      (let len (getBe a (+ at 1) 4))
      (if (|| (< len 0) (> (+ at (+ 5 len)) n))
        (corrupt "a short record" "recDecode")
        (Ok (Dec :value (mk (bytesAt a (+ at 5) len)) :next (+ at (+ 5 len)))))
    }))

(:: decArray (-> Int Int Int Int (Result Dec Error)))
(fn (decArray a at n depth)
  (if (> (+ at 5) n)
    (corrupt "a short record" "recDecode")
    {
      (let count (getBe a (+ at 1) 4))
      (if (< count 0)
        (corrupt "a record with a bad count" "recDecode")
        {
          (let items vecNew)
          {
            (let next (decItems a (+ at 5) n count items (+ depth 1))?)
            (Ok (Dec :value (VArray items) :next next))
          }
        })
    }))

(:: decItems (-> Int Int Int Int (Vec Value) Int (Result Int Error)))
(fn (decItems a at n left items depth)
  (if (<= left 0)
    (Ok at)
    {
      (let d (decValue a at n depth)?)
      {
        (vecPush items d.value)
        (decItems a d.next n (- left 1) items depth)
      }
    }))

(:: decObject (-> Int Int Int Int (Result Dec Error)))
(fn (decObject a at n depth)
  (if (> (+ at 5) n)
    (corrupt "a short record" "recDecode")
    {
      (let count (getBe a (+ at 1) 4))
      (if (< count 0)
        (corrupt "a record with a bad count" "recDecode")
        {
          (let fs vecNew)
          {
            (let next (decFields a (+ at 5) n count fs (+ depth 1))?)
            (Ok (Dec :value (VObject fs) :next next))
          }
        })
    }))

(:: decFields (-> Int Int Int Int (Vec Field) Int (Result Int Error)))
(fn (decFields a at n left fs depth)
  (if (<= left 0)
    (Ok at)
    (if (> (+ at 4) n)
      (corrupt "a short record" "recDecode")
      {
        (let len (getBe a at 4))
        (if (|| (< len 0) (> (+ at (+ 4 len)) n))
          (corrupt "a short record" "recDecode")
          {
            (let name (bytesAt a (+ at 4) len))
            {
              (let d (decValue a (+ at (+ 4 len)) n depth)?)
              {
                (vecPush fs (Field :name name :value d.value))
                (decFields a d.next n (- left 1) fs depth)
              }
            }
          })
      })))

(:: decRecord (-> Int Int Int Int (Result Dec Error)))
(fn (decRecord a at n depth)
  (if (> (+ at 5) n)
    (corrupt "a short record" "recDecode")
    {
      (let len (getBe a (+ at 1) 4))
      (if (|| (< len 0) (> (+ at (+ 5 len)) n))
        (corrupt "a short record" "recDecode")
        {
          (let table (bytesAt a (+ at 5) len))
          {
            (let d (decValue a (+ at (+ 5 len)) n (+ depth 1))?)
            (if (! (valueIsKey d.value))
              (corrupt "a record whose key is no scalar" "recDecode")
              (Ok (Dec :value (VRecord (RecordId :table table :key d.value)) :next d.next)))
          }
        })
    }))

; ------------------------------------------------------------------
; Keys.
; ------------------------------------------------------------------
(:: tagNone Int)
(fn (tagNone)
  1)

(:: tagFalse Int)
(fn (tagFalse)
  2)

(:: tagTrue Int)
(fn (tagTrue)
  3)

(:: tagNeg Int)
(fn (tagNeg)
  4)

(:: tagZero Int)
(fn (tagZero)
  5)

(:: tagPos Int)
(fn (tagPos)
  6)

(:: tagText Int)
(fn (tagText)
  7)

(:: tagBytes Int)
(fn (tagBytes)
  8)

(:: tagDatetime Int)
(fn (tagDatetime)
  9)

(:: tagDuration Int)
(fn (tagDuration)
  10)

(:: tagUuid Int)
(fn (tagUuid)
  11)

(:: tagRecord Int)
(fn (tagRecord)
  12)

(:: tagArray Int)
(fn (tagArray)
  13)

; The exponent bias: the smallest exponent, a subnormal's -1074, is 1
; after it, and an infinity's 1024 is 2099.
(:: expBias Int)
(fn (expBias)
  1075)

;; The 8-byte key of a schema entry: its rowid big-endian with its
;; sign bit flipped, so bytewise order is numeric order.
(pub :: keyRowid (-> Int String))
(pub fn (keyRowid n)
  {
    (let out (strAlloc 8))
    {
      (putBe (strData out) 0 8 (^ n intMin))
      out
    }
  })

;; The rowid a schema key holds.
(pub :: keyRowidOf (-> String (Result Int Error)))
(pub fn (keyRowidOf k)
  (if (!= (strLen k) 8)
    (corrupt "a schema key is not 8 bytes" "keyRowidOf")
    (Ok (^ (getBe (strData k) 0 8) intMin))))

; A number as sign, exponent and mantissa: `sign` -1, 0 or 1, `e` the
; power of two of its leading bit, and `mant` the bits after that bit,
; left-aligned in 64.
(struct Num
  (sign : Int)
  (e : Int)
  (mant : Int))

(:: numOfInt (-> Int Num))
(fn (numOfInt n)
  (if (== n 0)
    (Num :sign 0 :e 0 :mant 0)
    (if (== n intMin)
      (Num :sign -1 :e 63 :mant 0)
      {
        (let mag
          (if (< n 0)
            (- 0 n)
            n))
        (let sign
          (if (< n 0)
            -1
            1))
        {
          (let e (highBit mag))
          (Num :sign sign :e e :mant (shlU mag (- 64 e)))
        }
      })))

(:: numOfBits (-> Int Num))
(fn (numOfBits bits)
  {
    (let sign
      (if (< bits 0)
        -1
        1))
    (let ex (& (>> bits 52) 2047))
    (let frac (& bits 4503599627370495))
    (if (&& (== ex 0) (== frac 0))
      (Num :sign 0 :e 0 :mant 0)
      (if (== ex 2047)
        (Num :sign sign :e 1024 :mant 0)
        (if (> ex 0)
          (Num :sign sign :e (- ex 1023) :mant (<< frac 12))
          {
            (let p (highBit frac))
            (Num :sign sign :e (- p 1074) :mant (shlU frac (- 64 p)))
          })))
  })

(:: wNum (-> W Num Int))
(fn (wNum w num)
  (if (== num.sign 0)
    (wByte w tagZero)
    {
      (let ex (+ num.e expBias))
      (if (> num.sign 0)
        {
          (wByte w tagPos)
          (wBe w 2 ex)
          (wBe w 8 num.mant)
        }
        {
          (wByte w tagNeg)
          (wBe w 2 (^ ex 65535))
          (wBe w 8 (^ num.mant -1))
        })
    }))

; `s` with its 00 bytes written 00 FF, then a 00 01 ending.
(:: wEscaped (-> W String Int))
;@axiom:effect(unsafe)
(fn (wEscaped w s)
  {
    (let a (strData s))
    {
      (for i in 0..(strLen s)
        {
          (let b (__load8 a i))
          (if (== b 0)
            {
              (wByte w 0)
              (wByte w 255)
            }
            (wByte w b))
        })
      (wByte w 0)
      (wByte w 1)
    }
  })

(:: wKeyValue (-> W Value Int (Result Int Error)))
(fn (wKeyValue w v depth)
  (if (> depth maxDepth)
    (axqErr axqTooBig "a value nested past 64 levels" "keyEncode")
    (match v
      ((VNone) (Ok (wByte w tagNone)))
      ((VBool b)
        (Ok
          (wByte w
            (if b
              tagTrue
              tagFalse)))
      )
      ((VInt n) (Ok (wNum w (numOfInt n))))
      ((VFloat x)
        (if (floatIsNan x)
          (axqErr axqType "a NaN has no place in a key" "keyEncode")
          (Ok (wNum w (numOfBits (floatToBits x)))))
      )
      ((VText s)
        {
          (wByte w tagText)
          (Ok (wEscaped w s))
        }
      )
      ((VBytes s)
        {
          (wByte w tagBytes)
          (Ok (wEscaped w s))
        }
      )
      ((VDatetime n)
        {
          (wByte w tagDatetime)
          (Ok (wBe w 8 (^ n intMin)))
        }
      )
      ((VDuration n)
        {
          (wByte w tagDuration)
          (Ok (wBe w 8 (^ n intMin)))
        }
      )
      ((VUuid s)
        (if (!= (strLen s) 16)
          (axqErr axqType "a uuid is 16 bytes" "keyEncode")
          {
            (wByte w tagUuid)
            (Ok (wStr w s))
          })
      )
      ((VArray items)
        {
          (wByte w tagArray)
          {
            (let _ (wKeyItems w items 0 (+ depth 1))?)
            (Ok (wByte w 0))
          }
        }
      )
      ((VObject _) (axqErr axqType "an object has no place in a key" "keyEncode"))
      ((VRecord rid)
        {
          (wByte w tagRecord)
          (wEscaped w rid.table)
          (wKeyValue w rid.key (+ depth 1))
        }
      ))))

(:: wKeyItems (-> W (Vec Value) Int Int (Result Int Error)))
(fn (wKeyItems w items i depth)
  (if (>= i (vecLen items))
    (Ok 0)
    {
      (let _ (wKeyValue w (vecGet items i) depth)?)
      (wKeyItems w items (+ i 1) depth)
    }))

;; The key encoding of several values, one after another: the key an
;; index stores before the record's own key. A NaN or an object
;; answers `axqType`.
(pub :: keyEncode (-> (Vec Value) (Result String Error)))
(pub fn (keyEncode vals)
  {
    (let w (wNew))
    {
      (let _ (wKeyItems w vals 0 0)?)
      (Ok (wFinish w))
    }
  })

;; The key encoding of one value.
(pub :: keyEncodeValue (-> Value (Result String Error)))
(pub fn (keyEncodeValue v)
  (keyEncode (vecPush vecNew v)))

; The number a key's 10 exponent-and-mantissa bytes at `a + at` hold,
; `neg` when the tag said negative.
(:: numFromKey (-> Int Int Bool Value))
(fn (numFromKey a at neg)
  {
    (let ex
      (if neg
        (^ (getBe a at 2) 65535)
        (getBe a at 2)))
    (let mant
      (if neg
        (^ (getBe a (+ at 2) 8) -1)
        (getBe a (+ at 2) 8)))
    {
      (let e (- ex expBias))
      (if (&& (>= e 0) (<= e 62))
        ; integral when no mantissa bit lies below the units place
        (if (== (shlU mant e) 0)
          {
            (let mag (| (<< 1 e) (shrU mant (- 64 e))))
            (VInt
              (if neg
                (- 0 mag)
                mag))
          }
          (VFloat (floatFromBits (numBits neg e mant))))
        (if (&& (&& neg (== e 63)) (== mant 0))
          (VInt intMin)
          (VFloat (floatFromBits (numBits neg e mant)))))
    }
  })

; The binary64 bits of sign, exponent and mantissa. Exact for every
; number a float can hold; an integer beyond 53 bits never reaches
; here.
(:: numBits (-> Bool Int Int Int))
(fn (numBits neg e mant)
  {
    (let s
      (if neg
        intMin
        0))
    (if (>= e 1024)
      (| s 9218868437227405312)
      (if (>= e -1022)
        (| s (| (<< (+ e 1023) 52) (shrU mant 12)))
        {
          (let p (+ e 1074))
          (| s (| (shlU 1 p) (shrU mant (- 64 p))))
        }))
  })

; The escaped string starting at `a + at`, as a `Dec` whose value is
; the string as `VText`; `Err` when the terminator is missing or an
; escape is invalid.
(:: unescape (-> Int Int Int (Result Dec Error)))
;@axiom:effect(unsafe)
(fn (unescape a at n)
  {
    (let w (wNew))
    (let mut i at)
    (let mut done false)
    (let mut ok true)
    {
      (while (&& ok (! done))
        (if (>= i n)
          (set ok false)
          {
            (let b (__load8 a i))
            (if (== b 0)
              (if (>= (+ i 1) n)
                (set ok false)
                {
                  (let c (__load8 a (+ i 1)))
                  (if (== c 1)
                    {
                      (set done true)
                      (set i (+ i 2))
                    }
                    (if (== c 255)
                      {
                        (wByte w 0)
                        (set i (+ i 2))
                      }
                      (set ok false)))
                })
              {
                (wByte w b)
                (set i (+ i 1))
              })
          }))
      (if ok
        (Ok (Dec :value (VText (wFinish w)) :next i))
        (corrupt "bytes that aren't a key" "keyDecode"))
    }
  })

(:: keyDecValue (-> Int Int Int Int (Result Dec Error)))
;@axiom:effect(unsafe)
(fn (keyDecValue a at n depth)
  (if (> depth maxDepth)
    (corrupt "a key nested past 64 levels" "keyDecode")
    (if (>= at n)
      (corrupt "bytes that aren't a key" "keyDecode")
      {
        (let tag (__load8 a at))
        (if (== tag tagNone)
          (Ok (Dec :value VNone :next (+ at 1)))
          (if (== tag tagFalse)
            (Ok (Dec :value (VBool false) :next (+ at 1)))
            (if (== tag tagTrue)
              (Ok (Dec :value (VBool true) :next (+ at 1)))
              (if (== tag tagZero)
                (Ok (Dec :value (VInt 0) :next (+ at 1)))
                (if (|| (== tag tagNeg) (== tag tagPos))
                  (if (> (+ at 11) n)
                    (corrupt "bytes that aren't a key" "keyDecode")
                    (Ok (Dec :value (numFromKey a (+ at 1) (== tag tagNeg)) :next (+ at 11))))
                  (if (== tag tagText)
                    (unescape a (+ at 1) n)
                    (if (== tag tagBytes)
                      {
                        (let d (unescape a (+ at 1) n)?)
                        (Ok
                          (Dec
                            :value
                              (match d.value
                                ((VText s) (VBytes s))
                                (_ VNone))
                            :next d.next))
                      }
                      (if (|| (== tag tagDatetime) (== tag tagDuration))
                        (if (> (+ at 9) n)
                          (corrupt "bytes that aren't a key" "keyDecode")
                          (Ok
                            (Dec
                              :value
                                ((if (== tag tagDatetime)
                                  (lambda (x) (VDatetime x))
                                  (lambda (x) (VDuration x)))
                                  (^ (getBe a (+ at 1) 8) intMin))
                              :next (+ at 9))))
                        (if (== tag tagUuid)
                          (if (> (+ at 17) n)
                            (corrupt "bytes that aren't a key" "keyDecode")
                            (Ok (Dec :value (VUuid (bytesAt a (+ at 1) 16)) :next (+ at 17))))
                          (if (== tag tagRecord)
                            {
                              (let t (unescape a (+ at 1) n)?)
                              {
                                (let k (keyDecValue a t.next n (+ depth 1))?)
                                (Ok
                                  (Dec
                                    :value
                                      (VRecord
                                        (RecordId
                                          :table
                                            (match t.value
                                              ((VText s) s)
                                              (_ ""))
                                          :key k.value))
                                    :next k.next))
                              }
                            }
                            (if (== tag tagArray)
                              {
                                (let items vecNew)
                                {
                                  (let next (keyDecItems a (+ at 1) n items (+ depth 1))?)
                                  (Ok (Dec :value (VArray items) :next next))
                                }
                              }
                              (corrupt "bytes that aren't a key" "keyDecode"))))))))))))
      })))

(:: keyDecItems (-> Int Int Int (Vec Value) Int (Result Int Error)))
;@axiom:effect(unsafe)
(fn (keyDecItems a at n items depth)
  (if (>= at n)
    (corrupt "bytes that aren't a key" "keyDecode")
    (if (== (__load8 a at) 0)
      (Ok (+ at 1))
      {
        (let d (keyDecValue a at n depth)?)
        {
          (vecPush items d.value)
          (keyDecItems a d.next n items depth)
        }
      })))

;; The values a key encodes. Numbers come back as `VInt` when they
;; are integral and in the 64-bit range, and as `VFloat` otherwise.
;; Bytes that aren't a key answer `axqCorrupt`.
(pub :: keyDecode (-> String (Result (Vec Value) Error)))
(pub fn (keyDecode k)
  {
    (let a (strData k))
    (let n (strLen k))
    (let out vecNew)
    (let mut at 0)
    (let mut failure None)
    {
      (while (&& (isNone failure) (< at n))
        (match (keyDecValue a at n 0)
          ((Ok d)
            {
              (vecPush out d.value)
              (set at d.next)
            }
          )
          ((Err e)
            (set failure (Some e))
          )))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok out)))
    }
  })

;; The smallest key greater than every key that starts with `prefix`:
;; the prefix with its last byte below FF incremented and the rest
;; cut off. `None` when there is no such key (the prefix is empty or
;; all FF), meaning "no upper bound".
(pub :: keyPrefixEnd (-> String (Option String)))
;@axiom:effect(unsafe)
(pub fn (keyPrefixEnd prefix)
  {
    (let a (strData prefix))
    (let mut i (- (strLen prefix) 1))
    {
      (while (&& (>= i 0) (== (__load8 a i) 255))
        (set i (- i 1)))
      (if (< i 0)
        None
        {
          (let out (strAlloc (+ i 1)))
          {
            (rawCopy (strData out) a (+ i 1))
            (__store8 (strData out) i (+ (__load8 a i) 1))
            (Some out)
          }
        })
    }
  })

;; Compare two keys as the B-tree does: bytewise by unsigned value,
;; and a prefix before any longer key. Negative, zero or positive.
(pub :: keyCompare (-> String String Int))
(pub fn (keyCompare a b)
  (strCmp a b))
