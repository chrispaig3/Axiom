;;! Axqlite.AxqlEval - what values mean: their order, their arithmetic,
;;! their types, and how they are written as text.
;;!
;;!     (valCompare (VInt 2) (VFloat 2.5))   ; -1: numbers share one order
;;!     (valueText (recordId "person" (VText "ada")))   ; "person:ada"
;;!     (valCast TyInt (VText "42"))          ; (Ok (VInt 42))
;
; Everything here is pure: a value goes in, a value comes out, and no
; database is touched. `Axqlite.AxqlExec` evaluates expressions
; against records on top of these rules, so an operator means the
; same thing in a `WHERE`, a computed field and a test of this
; module.
;
; THE ORDER. Values compare first by type, in the order the key
; encoding writes them:
;
;     none < bool < number < text < bytes < datetime < duration
;          < uuid < record < array < object
;
; and then within a type. Ints and floats are one number order, exact
; at every magnitude, so `2 = 2.0` and `2^53 + 1 > 2^53` (the float)
; both hold. `IS` is stricter: same type as well as same value, so
; `2 IS 2.0` is false. An array compares element by element; an
; object by its field count, then by (name, value) pairs in name
; order. A record compares by table, then by key.
;
; TRUTH. `none` and `false` are falsy. Everything else - 0, "", [],
; a record - is truthy. `AND` and `OR` answer bools; `??` answers
; its left side unless that is `none`.
;
; ARITHMETIC. Int arithmetic is exact and refuses to overflow
; (`axqArithmetic`). A float in the mix makes a float. `/` on two
; ints answers an int when it divides evenly and a float otherwise.
; Text adds by joining, arrays by appending. A datetime plus or minus
; a duration is a datetime; two datetimes subtract to a duration.
; Anything else is `axqType`.
(import Str)
(import Vec)
(import Utf8)
(import Err)
(import Fmt)
(import Float)
(import Chrono)
(import Uuid)
(import Axqlite.Value)
(import Axqlite.Record)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)

; ------------------------------------------------------------------
; Order and equality.
; ------------------------------------------------------------------
(:: typeRank (-> Value Int))
(fn (typeRank v)
  (match v
    ((VNone) 0)
    ((VBool _) 1)
    ((VInt _) 2)
    ((VFloat _) 2)
    ((VText _) 3)
    ((VBytes _) 4)
    ((VDatetime _) 5)
    ((VDuration _) 6)
    ((VUuid _) 7)
    ((VRecord _) 8)
    ((VArray _) 9)
    ((VObject _) 10)))

;; How `a` stands to `b`: negative, zero or positive, in the order
;; the header describes. A NaN - which a database never holds -
;; compares as greater than every number here rather than trapping.
(pub :: valCompare (-> Value Value Int))
(pub fn (valCompare a b)
  {
    (let ra (typeRank a))
    (let rb (typeRank b))
    (if (!= ra rb)
      (if (< ra rb)
        -1
        1)
      (match a
        ((VArray xs)
          (match b
            ((VArray ys) (compareArrays xs ys 0))
            (_ 0))
        )
        ((VObject xs)
          (match b
            ((VObject ys) (compareObjects xs ys))
            (_ 0))
        )
        (_ (compareScalars a b))))
  })

(:: compareScalars (-> Value Value Int))
(fn (compareScalars a b)
  (match (keyEncodeValue a)
    ((Ok ka)
      (match (keyEncodeValue b)
        ((Ok kb) (keyCompare ka kb))
        ((Err _) -1))
    )
    ((Err _)
      (match (keyEncodeValue b)
        ((Ok _) 1)
        ((Err _) 0))
    )))

(:: compareArrays (-> (Vec Value) (Vec Value) Int Int))
(fn (compareArrays xs ys i)
  (if (>= i (vecLen xs))
      (if (>= i (vecLen ys))
        0
        -1)
    (>= i (vecLen ys))
      1
    {
      (let c (valCompare (vecGet xs i) (vecGet ys i)))
      (if (!= c 0)
        c
        (compareArrays xs ys (+ i 1)))
    }))

(:: compareObjects (-> (Vec Field) (Vec Field) Int))
(fn (compareObjects xs ys)
  (if (!= (vecLen xs) (vecLen ys))
    (if (< (vecLen xs) (vecLen ys))
      -1
      1)
    (compareSorted (sortedFields xs) (sortedFields ys) 0)))

(:: compareSorted (-> (Vec Field) (Vec Field) Int Int))
(fn (compareSorted xs ys i)
  (if (>= i (vecLen xs))
    0
    {
      (let x (vecGet xs i))
      (let y (vecGet ys i))
      {
        (let c (strCmp x.name y.name))
        (if (!= c 0)
          c
          {
            (let v (valCompare x.value y.value))
            (if (!= v 0)
              v
              (compareSorted xs ys (+ i 1)))
          })
      }
    }))

; The fields in name order.
(:: sortedFields (-> (Vec Field) (Vec Field)))
(fn (sortedFields fs)
  (vecSortBy fs (lambda (a b) (strCmp a.name b.name))))

;; Whether two values are equal: `valCompare` at zero.
(pub :: valEqual (-> Value Value Bool))
(pub fn (valEqual a b)
  (== (valCompare a b) 0))

;; Whether two values are the same in type and in value: what `IS`
;; answers. An int is never a float here, and an object's field order
;; is part of the value.
(pub :: valIdentical (-> Value Value Bool))
(pub fn (valIdentical a b)
  (match a
    ((VNone)
      (match b
        ((VNone) true)
        (_ false))
    )
    ((VBool x)
      (match b
        ((VBool y) (|| (&& x y) (&& (! x) (! y))))
        (_ false))
    )
    ((VInt x)
      (match b
        ((VInt y) (== x y))
        (_ false))
    )
    ((VFloat x)
      (match b
        ((VFloat y) (== (floatToBits x) (floatToBits y)))
        (_ false))
    )
    ((VText x)
      (match b
        ((VText y) (strEq x y))
        (_ false))
    )
    ((VBytes x)
      (match b
        ((VBytes y) (strEq x y))
        (_ false))
    )
    ((VDatetime x)
      (match b
        ((VDatetime y) (== x y))
        (_ false))
    )
    ((VDuration x)
      (match b
        ((VDuration y) (== x y))
        (_ false))
    )
    ((VUuid x)
      (match b
        ((VUuid y) (strEq x y))
        (_ false))
    )
    ((VArray xs)
      (match b
        ((VArray ys) (identicalArrays xs ys))
        (_ false))
    )
    ((VObject xs)
      (match b
        ((VObject ys) (identicalObjects xs ys))
        (_ false))
    )
    ((VRecord x)
      (match b
        ((VRecord y) (&& (strEq x.table y.table) (valIdentical x.key y.key)))
        (_ false))
    )))

(:: identicalArrays (-> (Vec Value) (Vec Value) Bool))
(fn (identicalArrays xs ys)
  (if (!= (vecLen xs) (vecLen ys))
    false
    {
      (let mut same true)
      {
        (for (x i) in xs
          (if (! (valIdentical x (vecGet ys i)))
            (set same false)))
        same
      }
    }))

(:: identicalObjects (-> (Vec Field) (Vec Field) Bool))
(fn (identicalObjects xs ys)
  (if (!= (vecLen xs) (vecLen ys))
    false
    {
      (let mut same true)
      {
        (for x in xs
          (match (objGet (VObject ys) x.name)
            ((None)
              (set same false)
            )
            ((Some y)
              (if (! (valIdentical x.value y))
                (set same false))
            )))
        same
      }
    }))

;; Whether `v` counts as true: everything but `none` and `false`.
(pub :: valTruthy (-> Value Bool))
(pub fn (valTruthy v)
  (match v
    ((VNone) false)
    ((VBool b) b)
    (_ true)))

; ------------------------------------------------------------------
; Arithmetic.
; ------------------------------------------------------------------
(:: typeErr (-> String String (Result a Error)))
(fn (typeErr msg where)
  (axqErr axqType msg where))

(:: arithErr (-> String String (Result a Error)))
(fn (arithErr msg where)
  (axqErr axqArithmetic msg where))

; `a` as a float, when it is a number.
(:: asFloat (-> Value (Option Float)))
(fn (asFloat v)
  (match v
    ((VInt n) (Some (intToFloat n)))
    ((VFloat x) (Some x))
    (_ None)))

(:: intToFloat (-> Int Float))
(fn (intToFloat n)
  (as n Float))

; Checked int arithmetic, on `Err`'s operators: `None` when the
; answer leaves 64 bits.
(:: checkedAdd (-> Int Int (Option Int)))
(fn (checkedAdd a b)
  (match (addChecked a b)
    ((Ok n) (Some n))
    ((Err _) None)))

(:: checkedSub (-> Int Int (Option Int)))
(fn (checkedSub a b)
  (match (subChecked a b)
    ((Ok n) (Some n))
    ((Err _) None)))

(:: checkedMul (-> Int Int (Option Int)))
(fn (checkedMul a b)
  (match (mulChecked a b)
    ((Ok n) (Some n))
    ((Err _) None)))

(:: overflow (-> String (Result a Error)))
(fn (overflow where)
  (arithErr "this arithmetic overflowed 64 bits" where))

;; `a + b`, by the rules in the header.
(pub :: valAdd (-> Value Value (Result Value Error)))
(pub fn (valAdd a b)
  (match a
    ((VInt x)
      (match b
        ((VInt y)
          (match (checkedAdd x y)
            ((Some r) (Ok (VInt r)))
            ((None) (overflow "valAdd")))
        )
        ((VFloat y) (Ok (VFloat (+ (intToFloat x) y))))
        (_ (typeErr (concat "+ does not take an int and a " (valueTypeName b)) "valAdd")))
    )
    ((VFloat x)
      (match (asFloat b)
        ((Some y) (Ok (VFloat (+ x y))))
        ((None) (typeErr (concat "+ does not take a float and a " (valueTypeName b)) "valAdd")))
    )
    ((VText x)
      (match b
        ((VText y) (Ok (VText (concat x y))))
        (_ (typeErr (concat "+ does not take text and a " (valueTypeName b)) "valAdd")))
    )
    ((VArray xs)
      (match b
        ((VArray ys)
          {
            (let out vecNew)
            {
              (for v in xs
                (vecPush out v))
              (for v in ys
                (vecPush out v))
              (Ok (VArray out))
            }
          }
        )
        (_ (typeErr (concat "+ does not take an array and a " (valueTypeName b)) "valAdd")))
    )
    ((VDatetime x)
      (match b
        ((VDuration y)
          (match (checkedAdd x y)
            ((Some r) (Ok (VDatetime r)))
            ((None) (overflow "valAdd")))
        )
        (_ (typeErr (concat "+ does not take a datetime and a " (valueTypeName b)) "valAdd")))
    )
    ((VDuration x)
      (match b
        ((VDuration y)
          (match (checkedAdd x y)
            ((Some r) (Ok (VDuration r)))
            ((None) (overflow "valAdd")))
        )
        ((VDatetime y)
          (match (checkedAdd x y)
            ((Some r) (Ok (VDatetime r)))
            ((None) (overflow "valAdd")))
        )
        (_ (typeErr (concat "+ does not take a duration and a " (valueTypeName b)) "valAdd")))
    )
    (_ (typeErr (concat "+ does not take a " (valueTypeName a)) "valAdd"))))

;; `a - b`.
(pub :: valSub (-> Value Value (Result Value Error)))
(pub fn (valSub a b)
  (match a
    ((VInt x)
      (match b
        ((VInt y)
          (match (checkedSub x y)
            ((Some r) (Ok (VInt r)))
            ((None) (overflow "valSub")))
        )
        ((VFloat y) (Ok (VFloat (- (intToFloat x) y))))
        (_ (typeErr (concat "- does not take an int and a " (valueTypeName b)) "valSub")))
    )
    ((VFloat x)
      (match (asFloat b)
        ((Some y) (Ok (VFloat (- x y))))
        ((None) (typeErr (concat "- does not take a float and a " (valueTypeName b)) "valSub")))
    )
    ((VDatetime x)
      (match b
        ((VDuration y)
          (match (checkedSub x y)
            ((Some r) (Ok (VDatetime r)))
            ((None) (overflow "valSub")))
        )
        ((VDatetime y)
          (match (checkedSub x y)
            ((Some r) (Ok (VDuration r)))
            ((None) (overflow "valSub")))
        )
        (_ (typeErr (concat "- does not take a datetime and a " (valueTypeName b)) "valSub")))
    )
    ((VDuration x)
      (match b
        ((VDuration y)
          (match (checkedSub x y)
            ((Some r) (Ok (VDuration r)))
            ((None) (overflow "valSub")))
        )
        (_ (typeErr (concat "- does not take a duration and a " (valueTypeName b)) "valSub")))
    )
    (_ (typeErr (concat "- does not take a " (valueTypeName a)) "valSub"))))

;; `a * b`.
(pub :: valMul (-> Value Value (Result Value Error)))
(pub fn (valMul a b)
  (match a
    ((VInt x)
      (match b
        ((VInt y)
          (match (checkedMul x y)
            ((Some r) (Ok (VInt r)))
            ((None) (overflow "valMul")))
        )
        ((VFloat y) (Ok (VFloat (* (intToFloat x) y))))
        (_ (typeErr (concat "* does not take an int and a " (valueTypeName b)) "valMul")))
    )
    ((VFloat x)
      (match (asFloat b)
        ((Some y) (Ok (VFloat (* x y))))
        ((None) (typeErr (concat "* does not take a float and a " (valueTypeName b)) "valMul")))
    )
    ((VDuration x)
      (match b
        ((VInt y)
          (match (checkedMul x y)
            ((Some r) (Ok (VDuration r)))
            ((None) (overflow "valMul")))
        )
        (_ (typeErr (concat "* does not take a duration and a " (valueTypeName b)) "valMul")))
    )
    (_ (typeErr (concat "* does not take a " (valueTypeName a)) "valMul"))))

;; `a / b`: an int when two ints divide evenly, a float otherwise.
;; Dividing by zero is `axqArithmetic`.
(pub :: valDiv (-> Value Value (Result Value Error)))
(pub fn (valDiv a b)
  (match a
    ((VInt x)
      (match b
        ((VInt y)
          (if (== y 0)
            (arithErr "division by zero" "valDiv")
            (if (== (% x y) 0)
              (if (&& (== x intMin) (== y -1))
                (overflow "valDiv")
                (Ok (VInt (/ x y))))
              (Ok (VFloat (/ (intToFloat x) (intToFloat y))))))
        )
        ((VFloat y) (floatDiv (intToFloat x) y))
        (_ (typeErr (concat "/ does not take an int and a " (valueTypeName b)) "valDiv")))
    )
    ((VFloat x)
      (match (asFloat b)
        ((Some y) (floatDiv x y))
        ((None) (typeErr (concat "/ does not take a float and a " (valueTypeName b)) "valDiv")))
    )
    ((VDuration x)
      (match b
        ((VInt y)
          (if (== y 0)
            (arithErr "division by zero" "valDiv")
            (Ok (VDuration (/ x y))))
        )
        (_ (typeErr (concat "/ does not take a duration and a " (valueTypeName b)) "valDiv")))
    )
    (_ (typeErr (concat "/ does not take a " (valueTypeName a)) "valDiv"))))

(:: floatDiv (-> Float Float (Result Value Error)))
(fn (floatDiv x y)
  (if (== y 0.0)
    (arithErr "division by zero" "valDiv")
    (Ok (VFloat (/ x y)))))

;; `a % b`: the remainder, on ints. A zero divisor is `axqArithmetic`.
(pub :: valMod (-> Value Value (Result Value Error)))
(pub fn (valMod a b)
  (match a
    ((VInt x)
      (match b
        ((VInt y)
          (if (== y 0)
            (arithErr "remainder by zero" "valMod")
            (if (&& (== x intMin) (== y -1))
              (Ok (VInt 0))
              (Ok (VInt (% x y)))))
        )
        (_ (typeErr (concat "% does not take an int and a " (valueTypeName b)) "valMod")))
    )
    (_ (typeErr (concat "% does not take a " (valueTypeName a)) "valMod"))))

;; `-a`.
(pub :: valNeg (-> Value (Result Value Error)))
(pub fn (valNeg a)
  (match a
    ((VInt x)
      (if (== x intMin)
        (overflow "valNeg")
        (Ok (VInt (- 0 x))))
    )
    ((VFloat x) (Ok (VFloat (- 0.0 x))))
    ((VDuration x)
      (if (== x intMin)
        (overflow "valNeg")
        (Ok (VDuration (- 0 x))))
    )
    (_ (typeErr (concat "- does not take a " (valueTypeName a)) "valNeg"))))

;; Whether `haystack` holds `needle`: an element of an array, or a
;; substring of text. Anything else is false, not an error, so a
;; `WHERE` over mixed documents stays quiet.
(pub :: valContains (-> Value Value Bool))
(pub fn (valContains haystack needle)
  (match haystack
    ((VArray xs)
      {
        (let mut found false)
        {
          (for x in xs
            (if (valEqual x needle)
              (set found true)))
          found
        }
      }
    )
    ((VText s)
      (match needle
        ((VText t) (isSome (strFind s t 0)))
        (_ false))
    )
    (_ false)))

;; `a ?= b`: `a` is `b`, or some element of array `a` is.
(pub :: valAnyEq (-> Value Value Bool))
(pub fn (valAnyEq a b)
  (match a
    ((VArray _) (valContains a b))
    (_ (valEqual a b))))

;; `a *= b`: `a` is `b`, or every element of nonempty array `a` is.
(pub :: valAllEq (-> Value Value Bool))
(pub fn (valAllEq a b)
  (match a
    ((VArray xs)
      (if (== (vecLen xs) 0)
        false
        {
          (let mut all true)
          {
            (for x in xs
              (if (! (valEqual x b))
                (set all false)))
            all
          }
        })
    )
    (_ (valEqual a b))))

; ------------------------------------------------------------------
; Datetimes and durations, as text.
; ------------------------------------------------------------------
; A datetime as ISO 8601 text in UTC: 2026-11-03T10:15:30Z, with a
; fractional part only when the microseconds need one.
(:: datetimeText (-> Int String))
(fn (datetimeText micros)
  (match (datetimeOfMicros micros)
    ((Err _) "1970-01-01T00:00:00Z")
    ((Ok dt)
      (match (datetimeFormat "%Y-%m-%dT%H:%M:%S" dt)
        ((Err _) "1970-01-01T00:00:00Z")
        ((Ok base)
          {
            (let rem (% micros 1000000))
            (let frac
              (if (< rem 0)
                (+ rem 1000000)
                rem))
            (if (== frac 0)
              (concat base "Z")
              (concat (concat (concat base ".") (trimZeros (padMicros frac))) "Z"))
          }
        ))
    )))

(:: padMicros (-> Int String))
(fn (padMicros n)
  {
    (let s (fmtInt n))
    (let mut out s)
    {
      (while (< (strLen out) 6)
        (set out (concat "0" out)))
      out
    }
  })

(:: trimZeros (-> String String))
(fn (trimZeros s)
  {
    (let mut n (strLen s))
    {
      (while (&& (> n 0) (== (strByte s (- n 1)) 48))
        (set n (- n 1)))
      (strSlice s 0 n)
    }
  })

; The microseconds a datetime text names: an RFC 3339 timestamp, a
; naive datetime read as UTC, or a plain date at midnight.
(:: parseDatetimeText (-> String (Option Int)))
(fn (parseDatetimeText s)
  (match (datetimeParseUtc s)
    ((Ok dt) (Some (microsOfDatetime dt)))
    ((Err _)
      (match (datetimeParse s)
        ((Ok dt) (Some (microsOfDatetime dt)))
        ((Err _)
          (match (dateParse s)
            ((Ok d)
              (match (timeParse "00:00:00")
                ((Ok t) (Some (microsOfDatetime (datetimeNew d t))))
                ((Err _) None))
            )
            ((Err _) None))
        ))
    )))

; A duration written back in the units it is read in: the largest
; units first, as `1h30m`. Zero is `0s`, and a negative duration
; carries its sign in front.
(:: durationText (-> Int String))
(fn (durationText micros)
  (if (== micros 0)
    "0s"
    (if (< micros 0)
      (if (== micros intMin)
        "-292471y"
        (concat "-" (durationTextPos (- 0 micros))))
      (durationTextPos micros))))

(:: durationTextPos (-> Int String))
(fn (durationTextPos micros)
  {
    (let parts vecNew)
    (let mut left micros)
    {
      (set left (durationTake parts left 31536000000000 "y"))
      (set left (durationTake parts left 604800000000 "w"))
      (set left (durationTake parts left 86400000000 "d"))
      (set left (durationTake parts left 3600000000 "h"))
      (set left (durationTake parts left 60000000 "m"))
      (set left (durationTake parts left 1000000 "s"))
      (set left (durationTake parts left 1000 "ms"))
      (set left (durationTake parts left 1 "us"))
      (strJoin parts "")
    }
  })

(:: durationTake (-> (Vec String) Int Int String Int))
(fn (durationTake parts left factor unit)
  {
    (let n (/ left factor))
    (if (> n 0)
      {
        (vecPush parts (concat (fmtInt n) unit))
        (- left (* n factor))
      }
      left)
  })

; ------------------------------------------------------------------
; Values as text.
; ------------------------------------------------------------------
;; A value written as AXQL: what a result prints as, and what a dump
;; writes, so the text reads back as the same value. Text is quoted,
;; a datetime is `d'...'`, a uuid `u'...'`, and a record `table:key`.
(pub :: valueText (-> Value String))
(pub fn (valueText v)
  (match v
    ((VNone) "none")
    ((VBool b)
      (if b
        "true"
        "false")
    )
    ((VInt n) (fmtInt n))
    ((VFloat x) (floatText x))
    ((VText s) (quoteText s))
    ((VBytes s) (bytesText s))
    ((VDatetime n) (concat (concat "d'" (datetimeText n)) "'"))
    ((VDuration n) (durationText n))
    ((VUuid s) (concat (concat "u'" (uuidText s)) "'"))
    ((VArray xs)
      {
        (let parts vecNew)
        {
          (for x in xs
            (vecPush parts (valueText x)))
          (concat (concat "[" (strJoin parts ", ")) "]")
        }
      }
    )
    ((VObject fs)
      {
        (let parts vecNew)
        {
          (for f in fs
            (vecPush parts (concat (concat (fieldNameText f.name) ": ") (valueText f.value))))
          (concat (concat "{ " (strJoin parts ", ")) " }")
        }
      }
    )
    ((VRecord rid) (concat (concat rid.table ":") (keyText rid.key)))))

; A value as the text a `<text>` cast answers: no quotes around
; text, and containers as `valueText` writes them.
(:: rawText (-> Value String))
(fn (rawText v)
  (match v
    ((VText s) s)
    ((VDatetime n) (datetimeText n))
    ((VUuid s) (uuidText s))
    ((VBytes s) s)
    (_ (valueText v))))

(:: floatText (-> Float String))
(fn (floatText x)
  (if (floatIsInfinite x)
      (if (< x 0.0)
        "-1e999"
        "1e999")
    (floatIsNan x)
      "0.0"
    {
      (let s (floatToString x))
      (if (|| (isSome (strFind s "." 0)) (|| (isSome (strFind s "e" 0)) (isSome (strFind s "E" 0))))
        s
        (concat s ".0"))
    }))

(:: quoteText (-> String String))
(fn (quoteText s)
  {
    (let b strBuilderNew)
    {
      (strBuilderPush b "'")
      (for i in 0..(strLen s)
        {
          (let c (strByte s i))
          (if (== c 39)
              (strBuilderPush b "\\'")
            (== c 92)
              (strBuilderPush b "\\\\")
            (== c 10)
              (strBuilderPush b "\\n")
            (== c 13)
              (strBuilderPush b "\\r")
            (== c 9)
              (strBuilderPush b "\\t")
            (strBuilderPush b (strSlice s i 1)))
        })
      (strBuilderPush b "'")
      (strBuilderFinish b)
    }
  })

(:: bytesText (-> String String))
(fn (bytesText s)
  {
    (let b strBuilderNew)
    {
      (strBuilderPush b "x'")
      (for i in 0..(strLen s)
        {
          (let c (strByte s i))
          (strBuilderPush b (hexPair c))
        })
      (strBuilderPush b "'")
      (strBuilderFinish b)
    }
  })

(:: hexPair (-> Int String))
(fn (hexPair c)
  (concat (hexDigitOf (/ c 16)) (hexDigitOf (% c 16))))

(:: hexDigitOf (-> Int String))
(fn (hexDigitOf d)
  (strSlice "0123456789abcdef" d 1))

(:: uuidText (-> String String))
(fn (uuidText bytes)
  (match (uuidFromBytes bytes)
    ((Ok u) (uuidToString u))
    ((Err _) (bytesText bytes))))

; A field name as an object writes it: bare when it is a plain name,
; quoted otherwise.
(:: fieldNameText (-> String String))
(fn (fieldNameText name)
  (if (isPlainName name)
    name
    (quoteText name)))

(:: isPlainName (-> String Bool))
(fn (isPlainName s)
  (if (== (strLen s) 0)
    false
    {
      (let mut ok (|| (strIsAlpha (strByte s 0)) (== (strByte s 0) 95)))
      {
        (for i in 1..(strLen s)
          (if (!
                (|| (strIsAlpha (strByte s i))
                  (|| (strIsDigit (strByte s i)) (== (strByte s i) 95))))
            (set ok false)))
        ok
      }
    }))

; A record's key as `table:key` writes it: a number bare, a plain
; name bare (hyphens welcome), any other text quoted, a uuid as one.
(:: keyText (-> Value String))
(fn (keyText k)
  (match k
    ((VInt n) (fmtInt n))
    ((VText s)
      (if (isKeyName s)
        s
        (quoteText s))
    )
    ((VUuid s) (uuidText s))
    (_ (valueText k))))

(:: isKeyName (-> String Bool))
(fn (isKeyName s)
  (if (== (strLen s) 0)
    false
    {
      (let mut ok (! (strIsDigit (strByte s 0))))
      {
        (for i in 0..(strLen s)
          {
            (let c (strByte s i))
            (if (! (|| (strIsAlpha c) (|| (strIsDigit c) (|| (== c 95) (== c 45)))))
              (set ok false))
          })
        ; A digits-only key would read back as a number.
        (&& ok (isNone (strParseInt s)))
      }
    }))

; ------------------------------------------------------------------
; Casts and types.
; ------------------------------------------------------------------
; The float `x` truncated toward zero, when it fits in an int.
(:: truncToInt (-> Float (Option Int)))
(fn (truncToInt x)
  (if (|| (floatIsNan x) (|| (>= x 9223372036854775808.0) (< x -9223372036854775808.0)))
    None
    (Some (as x Int))))

;; `v` cast to `t`, as `<text>`, `type::int` and a field's `TYPE`
;; do. `none` casts to `none` at every type. A cast that can't be
;; made is `axqType`.
(pub :: valCast (-> TypeExpr Value (Result Value Error)))
(pub fn (valCast t v)
  (match v
    ((VNone) (Ok VNone))
    (_ (castValue t v))))

(:: castValue (-> TypeExpr Value (Result Value Error)))
(fn (castValue t v)
  (match t
    ((TyAny) (Ok v))
    ((TyBool) (castBool v))
    ((TyInt) (castInt v))
    ((TyFloat) (castFloat v))
    ((TyText) (Ok (VText (rawText v))))
    ((TyBytes)
      (match v
        ((VBytes _) (Ok v))
        ((VText s) (Ok (VBytes s)))
        (_ (castErr t v)))
    )
    ((TyDatetime)
      (match v
        ((VDatetime _) (Ok v))
        ((VInt n) (Ok (VDatetime n)))
        ((VText s)
          (match (parseDatetimeText s)
            ((Some n) (Ok (VDatetime n)))
            ((None) (castErr t v)))
        )
        (_ (castErr t v)))
    )
    ((TyDuration)
      (match v
        ((VDuration _) (Ok v))
        ((VInt n) (Ok (VDuration n)))
        ((VText s)
          (match (axqlParseDuration s)
            ((Some n) (Ok (VDuration n)))
            ((None) (castErr t v)))
        )
        (_ (castErr t v)))
    )
    ((TyUuid)
      (match v
        ((VUuid _) (Ok v))
        ((VText s)
          (match (uuidParse s)
            ((Ok u) (Ok (VUuid (uuidBytes u))))
            ((Err _) (castErr t v)))
        )
        ((VBytes s)
          (if (== (strLen s) 16)
            (Ok (VUuid s))
            (castErr t v))
        )
        (_ (castErr t v)))
    )
    ((TyArray)
      (match v
        ((VArray _) (Ok v))
        (_ (Ok (VArray (vecPush vecNew v)))))
    )
    ((TyObject)
      (match v
        ((VObject _) (Ok v))
        (_ (castErr t v)))
    )
    ((TyRecord) (castRecord v ""))
    ((TyRecordOf table) (castRecord v table))
    ((TyOption inner) (castValue inner v))
    ((TyArrayOf inner)
      {
        (let arr (castValue TyArray v)?)
        (match arr
          ((VArray xs) (castEach inner xs))
          (_ (castErr t v)))
      }
    )))

(:: castErr (-> TypeExpr Value (Result a Error)))
(fn (castErr t v)
  (typeErr (concat (concat (concat "a " (valueTypeName v)) " can't be cast to ") (typeText t))
    "valCast"))

;; A type as AXQL spells it.
(pub :: typeText (-> TypeExpr String))
(pub fn (typeText t)
  (match t
    ((TyAny) "any")
    ((TyBool) "bool")
    ((TyInt) "int")
    ((TyFloat) "float")
    ((TyText) "text")
    ((TyBytes) "bytes")
    ((TyDatetime) "datetime")
    ((TyDuration) "duration")
    ((TyUuid) "uuid")
    ((TyArray) "array")
    ((TyObject) "object")
    ((TyRecord) "record")
    ((TyRecordOf table) (concat (concat "record<" table) ">"))
    ((TyOption inner) (concat (concat "option<" (typeText inner)) ">"))
    ((TyArrayOf inner) (concat (concat "array<" (typeText inner)) ">"))))

(:: castBool (-> Value (Result Value Error)))
(fn (castBool v)
  (match v
    ((VBool _) (Ok v))
    ((VInt n) (Ok (VBool (!= n 0))))
    ((VFloat x) (Ok (VBool (&& (!= x 0.0) (! (floatIsNan x))))))
    ((VText s)
      (if (strEq s "true")
          (Ok (VBool true))
        (strEq s "false")
          (Ok (VBool false))
        (castErr TyBool v))
    )
    (_ (castErr TyBool v))))

(:: castInt (-> Value (Result Value Error)))
(fn (castInt v)
  (match v
    ((VInt _) (Ok v))
    ((VFloat x)
      (match (truncToInt x)
        ((Some n) (Ok (VInt n)))
        ((None) (castErr TyInt v)))
    )
    ((VBool b)
      (Ok
        (VInt
          (if b
            1
            0)))
    )
    ((VText s)
      (match (strParseInt (strTrim s))
        ((Some n) (Ok (VInt n)))
        ((None) (castErr TyInt v)))
    )
    ((VDatetime n) (Ok (VInt n)))
    ((VDuration n) (Ok (VInt n)))
    (_ (castErr TyInt v))))

(:: castFloat (-> Value (Result Value Error)))
(fn (castFloat v)
  (match v
    ((VFloat _) (Ok v))
    ((VInt n) (Ok (VFloat (intToFloat n))))
    ((VBool b)
      (Ok
        (VFloat
          (if b
            1.0
            0.0)))
    )
    ((VText s)
      (match (floatParse (strTrim s))
        ((Ok x)
          (if (floatIsNan x)
            (castErr TyFloat v)
            (Ok (VFloat x)))
        )
        ((Err _) (castErr TyFloat v)))
    )
    (_ (castErr TyFloat v))))

(:: castRecord (-> Value String (Result Value Error)))
(fn (castRecord v table)
  (match v
    ((VRecord rid)
      (if (|| (strIsEmpty table) (strEq rid.table table))
        (Ok v)
        (typeErr (concat (concat (concat "a record of " rid.table) " is not a record of ") table)
          "valCast"))
    )
    ((VText s)
      (match (recordOfText s)
        ((Some r) (castRecord r table))
        ((None) (typeErr (concat "not a record id: " s) "valCast")))
    )
    (_ (castErr TyRecord v))))

; The record a `table:key` text names. A key that reads as an int is
; an int key, and one in uuid shape a uuid, so text that `valueText`
; wrote reads back whole.
(:: recordOfText (-> String (Option Value)))
(fn (recordOfText s)
  (match (strFind s ":" 0)
    ((None) None)
    ((Some at)
      {
        (let table (strSlice s 0 at))
        (let rest (strSlice s (+ at 1) (- (strLen s) (+ at 1))))
        (if (|| (strIsEmpty table) (strIsEmpty rest))
          None
          (Some (recordId table (keyOfText rest))))
      }
    )))

(:: keyOfText (-> String Value))
(fn (keyOfText s)
  (match (strParseInt s)
    ((Some n) (VInt n))
    ((None)
      (match (uuidParse s)
        ((Ok u) (VUuid (uuidBytes u)))
        ((Err _) (VText s)))
    )))

(:: castEach (-> TypeExpr (Vec Value) (Result Value Error)))
(fn (castEach t xs)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for x in xs
        (if (isNone failure)
          (match (valCast t x)
            ((Ok y) (vecPush out y))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok (VArray out))))
    }
  })

;; Whether `v` is of type `t`, with no conversion: what a schemafull
;; field checks after a cast, and what `type::is` answers.
(pub :: valIsType (-> TypeExpr Value Bool))
(pub fn (valIsType t v)
  (match t
    ((TyAny) true)
    ((TyBool)
      (match v
        ((VBool _) true)
        (_ false))
    )
    ((TyInt)
      (match v
        ((VInt _) true)
        (_ false))
    )
    ((TyFloat)
      (match v
        ((VFloat _) true)
        ((VInt _) true)
        (_ false))
    )
    ((TyText)
      (match v
        ((VText _) true)
        (_ false))
    )
    ((TyBytes)
      (match v
        ((VBytes _) true)
        (_ false))
    )
    ((TyDatetime)
      (match v
        ((VDatetime _) true)
        (_ false))
    )
    ((TyDuration)
      (match v
        ((VDuration _) true)
        (_ false))
    )
    ((TyUuid)
      (match v
        ((VUuid _) true)
        (_ false))
    )
    ((TyArray)
      (match v
        ((VArray _) true)
        (_ false))
    )
    ((TyObject)
      (match v
        ((VObject _) true)
        (_ false))
    )
    ((TyRecord)
      (match v
        ((VRecord _) true)
        (_ false))
    )
    ((TyRecordOf table)
      (match v
        ((VRecord rid) (strEq rid.table table))
        (_ false))
    )
    ((TyOption inner)
      (match v
        ((VNone) true)
        (_ (valIsType inner v)))
    )
    ((TyArrayOf inner)
      (match v
        ((VArray xs)
          {
            (let mut all true)
            {
              (for x in xs
                (if (! (valIsType inner x))
                  (set all false)))
              all
            }
          }
        )
        (_ false))
    )))

; ------------------------------------------------------------------
; Paths into documents.
; ------------------------------------------------------------------
;; The field `name` of `v`: a document's field, and `none` for
;; anything else or a missing field.
(pub :: valField (-> Value String Value))
(pub fn (valField v name)
  (match (objGet v name)
    ((Some x) x)
    ((None) VNone)))

;; `v` at index `key`: an array element (negative counts from the
;; end), a document field by text key, and `none` otherwise.
(pub :: valIndex (-> Value Value Value))
(pub fn (valIndex v key)
  (match key
    ((VInt i)
      (match v
        ((VArray xs)
          {
            (let n (vecLen xs))
            (let at
              (if (< i 0)
                (+ n i)
                i))
            (if (&& (>= at 0) (< at n))
              (vecGet xs at)
              VNone)
          }
        )
        (_ VNone))
    )
    ((VText name) (valField v name))
    (_ VNone)))

; The fields a dotted path walks, as its pieces.
(:: pathPieces (-> String (Vec String)))
(fn (pathPieces path)
  (strSplit path 46))

;; The value at dotted `path` in `v`, or `none`.
(pub :: valGetPath (-> Value String Value))
(pub fn (valGetPath v path)
  {
    (let mut cur v)
    {
      (for piece in (pathPieces path)
        (set cur (valStep cur piece)))
      cur
    }
  })

(:: valStep (-> Value String Value))
(fn (valStep v piece)
  (match v
    ((VArray _)
      (match (strParseInt piece)
        ((Some i) (valIndex v (VInt i)))
        ((None) (valField v piece)))
    )
    (_ (valField v piece))))

;; `v` with dotted `path` set to `value`, making documents on the
;; way. A numeric piece steps into an array when the value at hand
;; is one, growing it with `none` up to the index.
(pub :: valSetPath (-> Value String Value Value))
(pub fn (valSetPath v path value)
  (setPieces v (pathPieces path) 0 value))

(:: setPieces (-> Value (Vec String) Int Value Value))
(fn (setPieces v pieces i value)
  {
    (let piece (vecGet pieces i))
    (if (== i (- (vecLen pieces) 1))
      (match v
        ((VArray xs)
          (match (strParseInt piece)
            ((Some at) (VArray (setAt xs at value)))
            ((None) v))
        )
        (_ (objSet (asObject v) piece value)))
      (match v
        ((VArray xs)
          (match (strParseInt piece)
            ((Some at)
              (VArray (setAt xs at (setPieces (valIndex v (VInt at)) pieces (+ i 1) value)))
            )
            ((None) v))
        )
        (_ (objSet (asObject v) piece (setPieces (valField v piece) pieces (+ i 1) value)))))
  })

(:: asObject (-> Value Value))
(fn (asObject v)
  (match v
    ((VObject _) v)
    (_ emptyObject)))

(:: setAt (-> (Vec Value) Int Value (Vec Value)))
(fn (setAt xs at value)
  {
    (let out vecNew)
    {
      (for x in xs
        (vecPush out x))
      (if (< at 0)
        out
        {
          (while (< (vecLen out) at)
            (vecPush out VNone))
          (if (== (vecLen out) at)
            (vecPush out value)
            (vecSet out at value))
          out
        })
    }
  })

;; `v` with dotted `path` removed.
(pub :: valDelPath (-> Value String Value))
(pub fn (valDelPath v path)
  (delPieces v (pathPieces path) 0))

(:: delPieces (-> Value (Vec String) Int Value))
(fn (delPieces v pieces i)
  {
    (let piece (vecGet pieces i))
    (if (== i (- (vecLen pieces) 1))
      (match v
        ((VArray xs)
          (match (strParseInt piece)
            ((Some at) (VArray (removeAt xs at)))
            ((None) v))
        )
        ((VObject _) (objDel v piece))
        (_ v))
      (match v
        ((VObject _) (objSet v piece (delPieces (valField v piece) pieces (+ i 1))))
        (_ v)))
  })

(:: removeAt (-> (Vec Value) Int (Vec Value)))
(fn (removeAt xs at)
  {
    (let out vecNew)
    {
      (for (x i) in xs
        (if (!= i at)
          (vecPush out x)))
      out
    }
  })

;; Deep-merge `patch` into `base`: documents merge field by field,
;; and anything else in the patch replaces. What `MERGE` does.
(pub :: valMerge (-> Value Value Value))
(pub fn (valMerge base patch)
  (match patch
    ((VObject fs)
      {
        (let mut out (asObject base))
        {
          (for f in fs
            (set out (objSet out f.name (valMerge (valField out f.name) f.value))))
          out
        }
      }
    )
    (_ patch)))

; ------------------------------------------------------------------
; Patches and diffs. A patch is an array of {op, path, value?, from?}
; documents with `/a/0/b` pointer paths (`~1` for /, `~0` for ~).
; ------------------------------------------------------------------
;; Apply a patch to `base`, as a `PATCH` clause does. A malformed
;; operation is `axqType`; a failed `test` is `axqConstraint`.
(pub :: valPatch (-> Value Value (Result Value Error)))
(pub fn (valPatch base patch)
  (match patch
    ((VArray ops) (applyOps base ops 0))
    (_ (typeErr "a PATCH takes an array of operations" "valPatch"))))

(:: applyOps (-> Value (Vec Value) Int (Result Value Error)))
(fn (applyOps cur ops i)
  (if (>= i (vecLen ops))
    (Ok cur)
    {
      (let next (applyOp cur (vecGet ops i))?)
      (applyOps next ops (+ i 1))
    }))

(:: applyOp (-> Value Value (Result Value Error)))
(fn (applyOp cur op)
  {
    (let name (textOr (valField op "op") ""))
    (let path (textOr (valField op "path") ""))
    (let pieces (pointerPieces path))
    (if (strEq name "add")
        (Ok (patchSet cur pieces 0 (valField op "value")))
      (strEq name "replace")
        (Ok (patchSet cur pieces 0 (valField op "value")))
      (strEq name "remove")
        (Ok (patchDel cur pieces 0))
      (strEq name "copy")
        {
          (let from (pointerPieces (textOr (valField op "from") "")))
          (Ok (patchSet cur pieces 0 (patchGet cur from 0)))
        }
      (strEq name "move")
        {
          (let from (pointerPieces (textOr (valField op "from") "")))
          {
            (let moved (patchGet cur from 0))
            (Ok (patchSet (patchDel cur from 0) pieces 0 moved))
          }
        }
      (strEq name "test")
        (if (valEqual (patchGet cur pieces 0) (valField op "value"))
          (Ok cur)
          (axqErr axqConstraint (concat "a patch test failed at " path) "valPatch"))
      (typeErr (concat "no such patch operation: " name) "valPatch"))
  })

(:: textOr (-> Value String String))
(fn (textOr v dflt)
  (match v
    ((VText s) s)
    (_ dflt)))

(:: pointerPieces (-> String (Vec String)))
(fn (pointerPieces path)
  (if (strIsEmpty path)
    vecNew
    {
      (let raw (strSplit path 47))
      (let out vecNew)
      {
        (for (piece i) in raw
          (if (> i 0)
            (vecPush out (unescapePointer piece))))
        out
      }
    }))

(:: unescapePointer (-> String String))
(fn (unescapePointer piece)
  {
    (let b strBuilderNew)
    (let mut i 0)
    {
      (while (< i (strLen piece))
        {
          (let c (strByte piece i))
          (if (&& (== c 126) (< (+ i 1) (strLen piece)))
            {
              (strBuilderPush b
                (if (== (strByte piece (+ i 1)) 49)
                  "/"
                  "~"))
              (set i (+ i 2))
            }
            {
              (strBuilderPush b (strSlice piece i 1))
              (set i (+ i 1))
            })
        })
      (strBuilderFinish b)
    }
  })

(:: patchGet (-> Value (Vec String) Int Value))
(fn (patchGet v pieces i)
  (if (>= i (vecLen pieces))
    v
    (patchGet (valStep v (vecGet pieces i)) pieces (+ i 1))))

(:: patchSet (-> Value (Vec String) Int Value Value))
(fn (patchSet v pieces i value)
  (if (>= i (vecLen pieces))
    value
    {
      (let piece (vecGet pieces i))
      (match v
        ((VArray xs)
          (if (strEq piece "-")
            (VArray (setAt xs (vecLen xs) (patchSet VNone pieces (+ i 1) value)))
            (match (strParseInt piece)
              ((Some at)
                (VArray (setAt xs at (patchSet (valIndex v (VInt at)) pieces (+ i 1) value)))
              )
              ((None) v)))
        )
        (_ (objSet (asObject v) piece (patchSet (valField v piece) pieces (+ i 1) value))))
    }))

(:: patchDel (-> Value (Vec String) Int Value))
(fn (patchDel v pieces i)
  (if (>= i (vecLen pieces))
    VNone
    {
      (let piece (vecGet pieces i))
      (if (== i (- (vecLen pieces) 1))
        (match v
          ((VArray xs)
            (match (strParseInt piece)
              ((Some at) (VArray (removeAt xs at)))
              ((None) v))
          )
          ((VObject _) (objDel v piece))
          (_ v))
        (match v
          ((VObject _) (objSet v piece (patchDel (valField v piece) pieces (+ i 1))))
          (_ v)))
    }))

;; The patch that turns `before` into `after`: what `RETURN DIFF`
;; answers, and what a later `PATCH` can apply.
(pub :: valDiff (-> Value Value Value))
(pub fn (valDiff before after)
  {
    (let ops vecNew)
    {
      (diffInto ops "" before after)
      (VArray ops)
    }
  })

(:: diffInto (-> (Vec Value) String Value Value Int))
(fn (diffInto ops path before after)
  (if (valIdentical before after)
    0
    (match before
      ((VObject xs)
        (match after
          ((VObject ys) (diffObjects ops path xs ys))
          (_ (pushOp ops "replace" path after)))
      )
      (_ (pushOp ops "replace" path after)))))

(:: diffObjects (-> (Vec Value) String (Vec Field) (Vec Field) Int))
(fn (diffObjects ops path xs ys)
  {
    (for f in ys
      (match (objGet (VObject xs) f.name)
        ((None) (pushOp ops "add" (concat (concat path "/") (escapePointer f.name)) f.value))
        ((Some old) (diffInto ops (concat (concat path "/") (escapePointer f.name)) old f.value))))
    {
      (for f in xs
        (if (isNone (objGet (VObject ys) f.name))
          (pushOp ops "remove" (concat (concat path "/") (escapePointer f.name)) VNone)))
      0
    }
  })

(:: pushOp (-> (Vec Value) String String Value Int))
(fn (pushOp ops op path value)
  {
    (let fs vecNew)
    {
      (vecPush fs (Field :name "op" :value (VText op)))
      (vecPush fs (Field :name "path" :value (VText path)))
      (if (! (strEq op "remove"))
        (vecPush fs (Field :name "value" :value value)))
      (vecPush ops (VObject fs))
      0
    }
  })

(:: escapePointer (-> String String))
(fn (escapePointer piece)
  {
    (let b strBuilderNew)
    {
      (for i in 0..(strLen piece)
        {
          (let c (strByte piece i))
          (strBuilderPush b
            (if (== c 126)
                "~0"
              (== c 47)
                "~1"
              (strSlice piece i 1)))
        })
      (strBuilderFinish b)
    }
  })

; ------------------------------------------------------------------
; Built-in functions. `evalBuiltin` answers (Some value) for the
; pure ones it knows, and `None` for a name it does not, so the
; executor can answer the ones that need a database or the clock
; (`time::now`, `rand::*`, `record::exists`, `fn::*`).
; ------------------------------------------------------------------
;; Whether `name` is a function AXQL provides.
(pub :: axqlIsBuiltin (-> String Bool))
(pub fn (axqlIsBuiltin name)
  (isSome (builtinArity name)))

(:: builtinArity (-> String (Option String)))
(fn (builtinArity name)
  (if (isMathFn name)
      (Some name)
    (isStringFn name)
      (Some name)
    (isArrayFn name)
      (Some name)
    (isObjectFn name)
      (Some name)
    (isTypeFn name)
      (Some name)
    (isRecordFn name)
      (Some name)
    (|| (strEq name "count")
      (|| (strEq name "time::now")
        (|| (strEq name "rand::uuid") (|| (strEq name "rand::int") (strEq name "rand::float")))))
      (Some name)
    None))

(:: isMathFn (-> String Bool))
(fn (isMathFn name)
  (|| (strEq name "math::abs")
    (|| (strEq name "math::ceil")
      (|| (strEq name "math::floor")
        (|| (strEq name "math::round")
          (|| (strEq name "math::sqrt")
            (|| (strEq name "math::min")
              (|| (strEq name "math::max")
                (|| (strEq name "math::sum") (strEq name "math::mean"))))))))))

(:: isStringFn (-> String Bool))
(fn (isStringFn name)
  (|| (strEq name "string::len")
    (|| (strEq name "string::lowercase")
      (|| (strEq name "string::uppercase")
        (|| (strEq name "string::trim")
          (|| (strEq name "string::contains")
            (|| (strEq name "string::startsWith")
              (|| (strEq name "string::endsWith")
                (|| (strEq name "string::replace")
                  (|| (strEq name "string::split")
                    (|| (strEq name "string::join") (strEq name "string::slice"))))))))))))

(:: isArrayFn (-> String Bool))
(fn (isArrayFn name)
  (|| (strEq name "array::len")
    (|| (strEq name "array::first")
      (|| (strEq name "array::last")
        (|| (strEq name "array::push")
          (|| (strEq name "array::concat")
            (|| (strEq name "array::sort")
              (|| (strEq name "array::reverse")
                (|| (strEq name "array::distinct") (strEq name "array::flatten"))))))))))

(:: isObjectFn (-> String Bool))
(fn (isObjectFn name)
  (|| (strEq name "object::keys")
    (|| (strEq name "object::values") (strEq name "object::entries"))))

(:: isTypeFn (-> String Bool))
(fn (isTypeFn name)
  (|| (strEq name "type::is")
    (|| (strEq name "type::bool")
      (|| (strEq name "type::int")
        (|| (strEq name "type::float")
          (|| (strEq name "type::text")
            (|| (strEq name "type::string")
              (|| (strEq name "type::record")
                (|| (strEq name "type::uuid") (strEq name "type::datetime"))))))))))

(:: isRecordFn (-> String Bool))
(fn (isRecordFn name)
  (|| (strEq name "record::id") (|| (strEq name "record::tb") (strEq name "record::exists"))))

(:: fnErr (-> String String (Result a Error)))
(fn (fnErr name msg)
  (typeErr (concat (concat name ": ") msg) "evalBuiltin"))

(:: needArgs (-> String (Vec Value) Int (Result Int Error)))
(fn (needArgs name args n)
  (if (== (vecLen args) n)
    (Ok 0)
    (fnErr name
      (concat (concat (concat "takes " (fmtInt n)) " arguments, got ") (fmtInt (vecLen args))))))

(:: argAt (-> (Vec Value) Int Value))
(fn (argAt args i)
  (vecGet args i))

(:: textArg (-> String (Vec Value) Int (Result String Error)))
(fn (textArg name args i)
  (match (argAt args i)
    ((VText s) (Ok s))
    (_ (fnErr name "expected text"))))

(:: numArg (-> String (Vec Value) Int (Result Value Error)))
(fn (numArg name args i)
  {
    (let v (argAt args i))
    (match v
      ((VInt _) (Ok v))
      ((VFloat _) (Ok v))
      (_ (fnErr name "expected a number")))
  })

(:: arrayArg (-> String (Vec Value) Int (Result (Vec Value) Error)))
(fn (arrayArg name args i)
  (match (argAt args i)
    ((VArray xs) (Ok xs))
    (_ (fnErr name "expected an array"))))

;; Call a pure built-in. `None` when `name` is not one of these, so
;; the caller can try the rest.
(pub :: evalBuiltin (-> String (Vec Value) (Result (Option Value) Error)))
(pub fn (evalBuiltin name args)
  (if (isMathFn name)
      (mathFn name args)
    (isStringFn name)
      (stringFn name args)
    (isArrayFn name)
      (arrayFn name args)
    (isObjectFn name)
      (objectFn name args)
    (isTypeFn name)
      (typeFn name args)
    (strEq name "record::id")
      {
        (let _ (needArgs name args 1)?)
        (match (argAt args 0)
          ((VRecord rid) (Ok (Some rid.key)))
          (_ (fnErr name "expected a record")))
      }
    (strEq name "record::tb")
      {
        (let _ (needArgs name args 1)?)
        (match (argAt args 0)
          ((VRecord rid) (Ok (Some (VText rid.table))))
          (_ (fnErr name "expected a record")))
      }
    (strEq name "count")
      (countFn args)
    (Ok None)))

(:: countFn (-> (Vec Value) (Result (Option Value) Error)))
(fn (countFn args)
  (if (!= (vecLen args) 1)
    (fnErr "count" "takes one argument")
    (Ok
      (Some
        (VInt
          (match (argAt args 0)
            ((VArray xs)
              {
                (let mut n 0)
                {
                  (for x in xs
                    (match x
                      ((VNone) 0)
                      (_
                        (set n (+ n 1))
                      )))
                  n
                }
              }
            )
            ((VNone) 0)
            (_ 1)))))))

; The numbers of a math aggregate: one array argument, or the
; arguments themselves.
(:: numList (-> String (Vec Value) (Result (Vec Value) Error)))
(fn (numList name args)
  (if (== (vecLen args) 1)
    (match (argAt args 0)
      ((VArray xs) (Ok xs))
      (_ (Ok args)))
    (if (== (vecLen args) 0)
      (fnErr name "takes at least one argument")
      (Ok args))))

(:: mathFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (mathFn name args)
  (if (strEq name "math::abs")
      {
        (let _ (needArgs name args 1)?)
        {
          (let v (numArg name args 0)?)
          (match v
            ((VInt n)
              (if (== n intMin)
                (overflow "math::abs")
                (Ok
                  (Some
                    (VInt
                      (if (< n 0)
                        (- 0 n)
                        n)))))
            )
            ((VFloat x) (Ok (Some (VFloat (floatAbs x)))))
            (_ (fnErr name "expected a number")))
        }
      }
    (strEq name "math::sqrt")
      {
        (let _ (needArgs name args 1)?)
        {
          (let v (numArg name args 0)?)
          (match (asFloat v)
            ((Some x)
              (if (< x 0.0)
                (arithErr "the square root of a negative number" "math::sqrt")
                (Ok (Some (VFloat (floatSqrt x)))))
            )
            ((None) (fnErr name "expected a number")))
        }
      }
    (strEq name "math::floor")
      (roundFn name args 0)
    (strEq name "math::ceil")
      (roundFn name args 1)
    (strEq name "math::round")
      (roundFn name args 2)
    (strEq name "math::sum")
      (sumFn name args)
    (strEq name "math::mean")
      (meanFn name args)
    (strEq name "math::min")
      (minMaxFn name args false)
    (minMaxFn name args true)))

; mode: 0 floor, 1 ceil, 2 round (halves away from zero). Ints pass
; through; a float too large to name whole is already whole.
(:: roundFn (-> String (Vec Value) Int (Result (Option Value) Error)))
(fn (roundFn name args mode)
  {
    (let _ (needArgs name args 1)?)
    {
      (let v (numArg name args 0)?)
      (match v
        ((VInt _) (Ok (Some v)))
        ((VFloat x)
          (match (truncToInt x)
            ((None) (Ok (Some v)))
            ((Some t)
              {
                (let frac (- x (intToFloat t)))
                (Ok
                  (Some
                    (VInt
                      (if (== mode 0)
                          (if (< frac 0.0)
                            (- t 1)
                            t)
                        (== mode 1)
                          (if (> frac 0.0)
                            (+ t 1)
                            t)
                        (if (>= frac 0.5)
                          (+ t 1)
                          (if (<= frac -0.5)
                            (- t 1)
                            t))))))
              }
            ))
        )
        (_ (fnErr name "expected a number")))
    }
  })

(:: sumFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (sumFn name args)
  {
    (let xs (numList name args)?)
    {
      (let mut total (VInt 0))
      (let mut failure None)
      {
        (for x in xs
          (match x
            ((VNone) 0)
            (_
              (if (isNone failure)
                (match (valAdd total x)
                  ((Ok r)
                    (set total r)
                  )
                  ((Err e)
                    (set failure (Some e))
                  )))
            )))
        (match failure
          ((Some e) (Err e))
          ((None) (Ok (Some total))))
      }
    }
  })

(:: meanFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (meanFn name args)
  {
    (let xs (numList name args)?)
    {
      (let mut total 0.0)
      (let mut n 0)
      (let mut bad false)
      {
        (for x in xs
          (match (asFloat x)
            ((Some f)
              {
                (set total (+ total f))
                (set n (+ n 1))
              }
            )
            ((None)
              (match x
                ((VNone) 0)
                (_
                  (set bad true)
                ))
            )))
        (if bad
          (fnErr name "expected numbers")
          (if (== n 0)
            (Ok (Some VNone))
            (Ok (Some (VFloat (/ total (intToFloat n)))))))
      }
    }
  })

(:: minMaxFn (-> String (Vec Value) Bool (Result (Option Value) Error)))
(fn (minMaxFn name args isMax)
  {
    (let xs (numList name args)?)
    {
      (let mut best VNone)
      (let mut any false)
      {
        (for x in xs
          (match x
            ((VNone) 0)
            (_
              (if (! any)
                {
                  (set best x)
                  (set any true)
                }
                (if (if isMax
                  (> (valCompare x best) 0)
                  (< (valCompare x best) 0))
                  (set best x)))
            )))
        (Ok (Some best))
      }
    }
  })

(:: stringFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (stringFn name args)
  (if (strEq name "string::len")
      {
        (let _ (needArgs name args 1)?)
        {
          (let s (textArg name args 0)?)
          (Ok (Some (VInt (utf8Len s))))
        }
      }
    (strEq name "string::lowercase")
      {
        (let _ (needArgs name args 1)?)
        {
          (let s (textArg name args 0)?)
          (Ok (Some (VText (strLower s))))
        }
      }
    (strEq name "string::uppercase")
      {
        (let _ (needArgs name args 1)?)
        {
          (let s (textArg name args 0)?)
          (Ok (Some (VText (strUpper s))))
        }
      }
    (strEq name "string::trim")
      {
        (let _ (needArgs name args 1)?)
        {
          (let s (textArg name args 0)?)
          (Ok (Some (VText (strTrim s))))
        }
      }
    (strEq name "string::contains")
      {
        (let _ (needArgs name args 2)?)
        {
          (let s (textArg name args 0)?)
          {
            (let t (textArg name args 1)?)
            (Ok (Some (VBool (isSome (strFind s t 0)))))
          }
        }
      }
    (strEq name "string::startsWith")
      {
        (let _ (needArgs name args 2)?)
        {
          (let s (textArg name args 0)?)
          {
            (let t (textArg name args 1)?)
            (Ok (Some (VBool (strStartsWith s t))))
          }
        }
      }
    (strEq name "string::endsWith")
      {
        (let _ (needArgs name args 2)?)
        {
          (let s (textArg name args 0)?)
          {
            (let t (textArg name args 1)?)
            (Ok (Some (VBool (endsWith s t))))
          }
        }
      }
    (strEq name "string::replace")
      {
        (let _ (needArgs name args 3)?)
        {
          (let s (textArg name args 0)?)
          {
            (let from (textArg name args 1)?)
            {
              (let to (textArg name args 2)?)
              (Ok (Some (VText (replaceAll s from to))))
            }
          }
        }
      }
    (strEq name "string::split")
      {
        (let _ (needArgs name args 2)?)
        {
          (let s (textArg name args 0)?)
          {
            (let t (textArg name args 1)?)
            (Ok (Some (VArray (textVec (splitOn s t)))))
          }
        }
      }
    (strEq name "string::join")
      {
        (let _ (needArgs name args 2)?)
        {
          (let xs (arrayArg name args 0)?)
          {
            (let t (textArg name args 1)?)
            {
              (let parts vecNew)
              {
                (for x in xs
                  (vecPush parts (rawText x)))
                (Ok (Some (VText (strJoin parts t))))
              }
            }
          }
        }
      }
    ; string::slice: characters, as Surreal counts them.
    (if (== (vecLen args) 2)
      (sliceFn name args false)
      (if (== (vecLen args) 3)
        (sliceFn name args true)
        (fnErr name "takes two or three arguments")))))

(:: sliceFn (-> String (Vec Value) Bool (Result (Option Value) Error)))
(fn (sliceFn name args hasEnd)
  {
    (let s (textArg name args 0)?)
    {
      (let from (intArg name args 1)?)
      {
        (let n (utf8Len s))
        (let start (clampSlice from n))
        {
          (let end
            (if hasEnd
              (clampSlice (intArg name args 2)? n)
              n))
          (Ok
            (Some
              (VText
                (if (>= start end)
                  ""
                  (utf8Slice s start end)))))
        }
      }
    }
  })

(:: intArg (-> String (Vec Value) Int (Result Int Error)))
(fn (intArg name args i)
  (match (argAt args i)
    ((VInt n) (Ok n))
    (_ (fnErr name "expected an int"))))

(:: clampSlice (-> Int Int Int))
(fn (clampSlice at n)
  {
    (let p
      (if (< at 0)
        (+ n at)
        at))
    (if (< p 0)
      0
      (if (> p n)
        n
        p))
  })

(:: endsWith (-> String String Bool))
(fn (endsWith s t)
  (if (> (strLen t) (strLen s))
    false
    (strEq (strSlice s (- (strLen s) (strLen t)) (strLen t)) t)))

(:: replaceAll (-> String String String String))
(fn (replaceAll s from to)
  (if (strIsEmpty from)
    s
    {
      (let b strBuilderNew)
      (let mut at 0)
      (let mut done false)
      {
        (while (! done)
          (match (strFind s from at)
            ((None)
              {
                (strBuilderPush b (strSlice s at (- (strLen s) at)))
                (set done true)
              }
            )
            ((Some at2)
              {
                (strBuilderPush b (strSlice s at (- at2 at)))
                (strBuilderPush b to)
                (set at (+ at2 (strLen from)))
              }
            )))
        (strBuilderFinish b)
      }
    }))

(:: splitOn (-> String String (Vec String)))
(fn (splitOn s sep)
  (if (strIsEmpty sep)
      {
        (let out vecNew)
        {
          (for i in 0..(utf8Len s)
            (vecPush out (utf8Slice s i (+ i 1))))
          out
        }
      }
    (== (strLen sep) 1)
      (strSplit s (strByte sep 0))
    {
      (let out vecNew)
      (let mut at 0)
      (let mut done false)
      {
        (while (! done)
          (match (strFind s sep at)
            ((None)
              {
                (vecPush out (strSlice s at (- (strLen s) at)))
                (set done true)
              }
            )
            ((Some at2)
              {
                (vecPush out (strSlice s at (- at2 at)))
                (set at (+ at2 (strLen sep)))
              }
            )))
        out
      }
    }))

(:: textVec (-> (Vec String) (Vec Value)))
(fn (textVec ss)
  {
    (let out vecNew)
    {
      (for s in ss
        (vecPush out (VText s)))
      out
    }
  })

(:: arrayFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (arrayFn name args)
  (if (strEq name "array::len")
      {
        (let _ (needArgs name args 1)?)
        {
          (let xs (arrayArg name args 0)?)
          (Ok (Some (VInt (vecLen xs))))
        }
      }
    (strEq name "array::first")
      {
        (let _ (needArgs name args 1)?)
        {
          (let xs (arrayArg name args 0)?)
          (Ok (Some (valIndex (VArray xs) (VInt 0))))
        }
      }
    (strEq name "array::last")
      {
        (let _ (needArgs name args 1)?)
        {
          (let xs (arrayArg name args 0)?)
          (Ok (Some (valIndex (VArray xs) (VInt -1))))
        }
      }
    (strEq name "array::push")
      {
        (let _ (needArgs name args 2)?)
        {
          (let xs (arrayArg name args 0)?)
          {
            (let out vecNew)
            {
              (for x in xs
                (vecPush out x))
              (vecPush out (argAt args 1))
              (Ok (Some (VArray out)))
            }
          }
        }
      }
    (strEq name "array::concat")
      {
        (let _ (needArgs name args 2)?)
        {
          (let r (valAdd (argAt args 0) (argAt args 1))?)
          (Ok (Some r))
        }
      }
    (strEq name "array::sort")
      {
        (let _ (needArgs name args 1)?)
        {
          (let xs (arrayArg name args 0)?)
          (Ok (Some (VArray (sortValues xs))))
        }
      }
    (strEq name "array::reverse")
      {
        (let _ (needArgs name args 1)?)
        {
          (let xs (arrayArg name args 0)?)
          {
            (let out vecNew)
            {
              (for i in 0..(vecLen xs)
                (vecPush out (vecGet xs (- (- (vecLen xs) 1) i))))
              (Ok (Some (VArray out)))
            }
          }
        }
      }
    (strEq name "array::distinct")
      {
        (let _ (needArgs name args 1)?)
        {
          (let xs (arrayArg name args 0)?)
          {
            (let out vecNew)
            {
              (for x in xs
                (if (! (valContains (VArray out) x))
                  (vecPush out x)))
              (Ok (Some (VArray out)))
            }
          }
        }
      }
    {
      (let _ (needArgs name args 1)?)
      {
        (let xs (arrayArg name args 0)?)
        {
          (let out vecNew)
          {
            (for x in xs
              (match x
                ((VArray ys)
                  (for y in ys
                    (vecPush out y))
                )
                (_ (vecPush out x))))
            (Ok (Some (VArray out)))
          }
        }
      }
    }))

; The values in `valCompare` order.
(pub :: sortValues (-> (Vec Value) (Vec Value)))
(pub fn (sortValues xs)
  (vecSortBy xs (lambda (a b) (valCompare a b))))

(:: objectFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (objectFn name args)
  {
    (let _ (needArgs name args 1)?)
    (match (argAt args 0)
      ((VObject fs)
        (if (strEq name "object::keys")
            {
              (let out vecNew)
              {
                (for f in fs
                  (vecPush out (VText f.name)))
                (Ok (Some (VArray out)))
              }
            }
          (strEq name "object::values")
            {
              (let out vecNew)
              {
                (for f in fs
                  (vecPush out f.value))
                (Ok (Some (VArray out)))
              }
            }
          {
            (let out vecNew)
            {
              (for f in fs
                (vecPush out (VArray (vecPush (vecPush vecNew (VText f.name)) f.value))))
              (Ok (Some (VArray out)))
            }
          })
      )
      (_ (fnErr name "expected an object")))
  })

(:: typeFn (-> String (Vec Value) (Result (Option Value) Error)))
(fn (typeFn name args)
  (if (strEq name "type::is")
    {
      (let _ (needArgs name args 2)?)
      {
        (let t (textArg name args 1)?)
        (Ok (Some (VBool (strEq (valueTypeName (argAt args 0)) t))))
      }
    }
    {
      (let _ (needArgs name args 1)?)
      {
        (let v
          (valCast
            (if (strEq name "type::bool")
                TyBool
              (strEq name "type::int")
                TyInt
              (strEq name "type::float")
                TyFloat
              (|| (strEq name "type::text") (strEq name "type::string"))
                TyText
              (strEq name "type::record")
                TyRecord
              (strEq name "type::uuid")
                TyUuid
              TyDatetime)
            (argAt args 0))?)
        (Ok (Some v))
      }
    }))
