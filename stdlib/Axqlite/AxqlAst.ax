;;! Axqlite.AxqlAst - the shape of a parsed AXQL statement.
;;!
;;!     (SSelect (Select ...))     ; SELECT name FROM person WHERE age > 30
;;!     (SCreate (Write ...))      ; CREATE person:ada SET name = 'Ada'
;
; `Axqlite.AxqlParse` turns text into these forms, and
; `Axqlite.AxqlExec` runs them. Nothing here runs anything: an AST is
; plain data a program can build, inspect and pass to `dbRunStmt`.
;
; Targets - what `FROM`, `CREATE`, `UPDATE` and friends name - are
; expressions: a table is `ETable`, a record `ERecord`, and anything
; that evaluates to a record, a table name, or an array of either
; (a `$parameter`, a subquery) works where they do.
(import Str)
(import Vec)
(import Fmt)
(import Axqlite.Value)

; ------------------------------------------------------------------
; Types, as `DEFINE FIELD ... TYPE` and `<cast>` write them.
; ------------------------------------------------------------------
;; A type a field may declare, or a cast may name.
(pub data TypeExpr
  (TyAny)
  (TyBool)
  (TyInt)
  (TyFloat)
  (TyText)
  (TyBytes)
  (TyDatetime)
  (TyDuration)
  (TyUuid)
  (TyArray)
  (TyObject)
  (TyRecord)
  (TyRecordOf String)
  (TyOption TypeExpr)
  (TyArrayOf TypeExpr))

; ------------------------------------------------------------------
; Expressions.
; ------------------------------------------------------------------
;; One `name: expr` pair of an object literal.
(pub struct EField
  (name : String)
  (expr : Expr))

;; One step of a path: a field, an index, a dereference of a record
;; link (`.*`), or a step across the graph.
(pub data Step
  (SField String)
  (SIndex Expr)
  (SDeref)
  (SGraph Graph))

;; A step across the graph: `->edge->table`, `<-edge<-table`, or
;; `<->edge<->table`. `dir` is 0 out, 1 in, 2 both. An empty `edge`
;; crosses every edge table; an empty `next` stops at the edges
;; themselves.
(pub struct Graph
  (dir : Int)
  (edge : String)
  (next : String))

;; An expression.
(pub data Expr
  (ELit Value)
  (EArray (Vec Expr))
  (EObject (Vec EField))
  (EParam String)
  (ETable String)
  (ERecord String Expr)
  (EName String)
  (EPath Expr (Vec Step))
  (EBinary String Expr Expr)
  (EUnary String Expr)
  (ECall String (Vec Expr))
  (ECast TypeExpr Expr)
  (EIf Expr Expr (Option Expr))
  (EBlock (Vec Stmt))
  (ESelect Select))

; ------------------------------------------------------------------
; SELECT.
; ------------------------------------------------------------------
;; One thing a `SELECT` answers per record: an expression, the name it
;; is answered under (empty for the field's own name), or `star` for
;; the whole record.
(pub struct Proj
  (star : Bool)
  (expr : Expr)
  (alias : String))

;; One `ORDER BY` term.
(pub struct Order
  (expr : Expr)
  (desc : Bool))

;; A `SELECT` statement or subquery.
(pub struct Select
  (value : Bool)
  (projs : (Vec Proj))
  (omit : (Vec String))
  (targets : (Vec Expr))
  (where : (Option Expr))
  (group : (Vec Expr))
  (order : (Vec Order))
  (limit : (Option Expr))
  (start : (Option Expr))
  (fetch : (Vec String)))

; ------------------------------------------------------------------
; Writes.
; ------------------------------------------------------------------
;; One `field = expr` of a `SET` clause. `path` is dotted
;; (`address.city`); `op` is "=", "+=" or "-=".
(pub struct Assign
  (path : String)
  (op : String)
  (expr : Expr))

;; What a write does with the records it touches.
(pub data Content
  (CNone)
  (CSet (Vec Assign))
  (CContent Expr)
  (CMerge Expr)
  (CPatch Expr))

;; What a write answers.
(pub data Return
  (RetAfter)
  (RetNone)
  (RetBefore)
  (RetDiff)
  (RetValue Expr)
  (RetFields (Vec Proj)))

;; A `CREATE`, `UPDATE`, `UPSERT` or `DELETE` over some targets.
(pub struct Write
  (only : Bool)
  (targets : (Vec Expr))
  (content : Content)
  (where : (Option Expr))
  (return : Return))

;; A `RELATE from->edge->to`.
(pub struct Relate
  (only : Bool)
  (from : Expr)
  (edge : String)
  (edgeId : (Option Expr))
  (to : Expr)
  (content : Content)
  (return : Return))

;; One parameter of a defined function.
(pub struct ParamDef
  (name : String)
  (ftype : (Option TypeExpr)))

;; One `ELSE IF` arm of an `IF` statement.
(pub struct Elif
  (cond : Expr)
  (body : (Vec Stmt)))

; ------------------------------------------------------------------
; Statements.
; ------------------------------------------------------------------
;; One statement. `SDefineField`'s `ftype` is `None` for `TYPE` left
;; unwritten; `SDefineTable`'s `schema` is 0 for unwritten, 1 for
;; `SCHEMAFULL`, 2 for `SCHEMALESS`.
(pub data Stmt
  (SExpr Expr)
  (SSelect Select)
  (SCreate Write)
  (SUpdate Write)
  (SUpsert Write)
  (SDelete Write)
  (SRelate Relate)
  (SInsert String Expr (Vec Assign) Return)
  (SDefineTable String Bool Bool Int Bool)
  (SDefineField String String Bool Bool (Option TypeExpr) (Option Expr) (Option Expr) (Option Expr)
    Bool)
  (SDefineIndex String String Bool Bool (Vec String) Bool)
  (SDefineEvent String String Bool Bool Expr (Vec Stmt))
  (SDefineFunction String Bool Bool (Vec ParamDef) (Vec Stmt))
  (SRemove String String String Bool)
  (SLet String Expr)
  (SReturn Expr)
  (SThrow Expr)
  (SIf Expr (Vec Stmt) (Vec Elif) (Vec Stmt))
  (SFor String Expr (Vec Stmt))
  (SBreak)
  (SContinue)
  (SBegin)
  (SCommit)
  (SCancel)
  (SLive Select)
  (SKill Expr)
  (SInfo String String)
  (SShow String (Option Expr) (Option Expr)))

;; A parsed statement and the parameters its text names: every
;; `$name` it mentions, in order of first appearance, so a caller can
;; check a parameter object against it before running.
(pub struct Parsed
  (stmt : Stmt)
  (paramNames : (Vec String))
  (text : String))

;; Whether a statement reads records and answers them (`SELECT`,
;; `LIVE`, `INFO`, `SHOW`): what a read-only connection may run, and
;; what never counts as a change.
(pub :: stmtIsQuery (-> Stmt Bool))
(pub fn (stmtIsQuery s)
  (match s
    ((SSelect _) true)
    ((SLive _) true)
    ((SInfo _ _) true)
    ((SShow _ _ _) true)
    (_ false)))

;; Where byte `at` of `src` is, as "line L, column C", both counted
;; from 1 in bytes: how every AXQL error names its place.
(pub :: axqlPosText (-> String Int String))
(pub fn (axqlPosText src at)
  {
    (let mut line 1)
    (let mut lineStart 0)
    (let end
      (if (> at (strLen src))
        (strLen src)
        at))
    {
      (for i in 0..end
        (if (== (strByte src i) 10)
          {
            (set line (+ line 1))
            (set lineStart (+ i 1))
          }))
      (concat (concat "line " (fmtInt line)) (concat ", column " (fmtInt (+ (- at lineStart) 1))))
    }
  })
