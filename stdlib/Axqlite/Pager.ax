; Axqlite.Pager - one database file as numbered pages: the header,
; the page cache, the file lock, the rollback journal, commit, rollback
; and recovery.
;
;     (match (pagerOpen "app.db" true false 256)
;       ((Ok p)
;         (try _ (pagerBeginWrite p)
;           (try n (pagerAlloc p)          ; a fresh page number
;             (try page (pagerWrite p n)   ; its bytes, journalled first
;               { (pagerPutBe page 0 1 5) (pagerCommit p) }))))
;       ((Err e) ...))
;
; This is the layer under `Axqlite.Btree`: it knows pages, not keys.
; `docs/axqlite-format.md` is the byte-level specification of the file
; and the journal; this header says what the code promises.
;
; THE FILE is pages of 4096 bytes. Page 0 is the header; page 1 is the
; root of the schema table, created as an empty table leaf with the
; database. Every page ends with an XXH64 checksum of its first 4088
; bytes, seeded with its page number, so a torn, zeroed or misplaced
; page fails the check. Every read from the file is checked, and a page
; that fails answers `axqCorrupt`, never its bytes.
;
; A TRANSACTION holds the exclusive lock from `pagerBeginWrite` until
; `pagerCommit` or `pagerRollback`. Before a page is first changed its
; original bytes are appended to the rollback journal, `<file>-journal`.
; A commit syncs the journal, writes the changed pages, truncates the
; file if it shrank, syncs the file, then zeroes the journal's header
; and syncs the journal. That last sync is the commit point: a crash
; before it leaves a journal that puts every page back, and a crash
; after it leaves the new state. `pagerCommit` answering `Ok` means the
; transaction is durable. When it answers `Err` the transaction was
; rolled back.
;
; RECOVERY. Whenever a connection takes a lock it first looks for a hot
; journal, one with a valid header and at least one record whose
; checksum verifies. It then takes the exclusive lock, copies every
; valid record back, truncates the file to its original length, syncs,
; and zeroes the journal's header. A torn last record is ignored.
;
; LOCKS never wait. The lock is `flock` on the whole file: shared for a
; read, exclusive for a write transaction. A lock another connection
; holds answers `axqBusy` at once with nothing changed, and the caller
; decides when to retry. Each connection opens the file itself, so two
; connections in one process exclude each other as two processes do. A
; connection re-reads the header's change counter whenever it takes a
; lock, and drops its page cache when another connection has committed.
; `flock` is advisory, and on a network file system it may not work at
; all.
;
; MEMORY. A pager's state, cache and paths live in one private mapping
; (`Sys.sysMapPrivate`) that `pagerClose` frees, never in the arena, so
; a caller's region can't reclaim them under a live pager. The pager is
; a sealed word over the runtime's handle table (kind 11), so a closed
; pager used again stops the program with status 85.
;
; PAGES FOR `Btree`. `pagerGet` and `pagerWrite` answer the address of a
; page in the cache, valid until the next pager call of the next
; operation. `pagerOpBegin` starts an operation: every page fetched with
; `pagerGet` or `pagerWrite` stays in the cache until the next
; `pagerOpBegin`, so an operation can hold a path of pages at once. The
; transient forms don't pin, for walking long overflow chains. When
; every frame is pinned the cache grows by up to 64 frames; an operation
; needing more answers `axqTooBig`.
;
; FAULT INJECTION, for tests only: `pagerFaultArm` makes the Nth write,
; sync or truncate fail, tear, or lose power (every later write
; dropped), or lose power and with it every write since each file's
; last sync. `pagerAbandon` then drops the connection with no cleanup,
; as a crash would.
;
; LIMITS. Pages are 4096 bytes and a file holds at most 2^31 of them.
; An I/O error or a corrupt page inside a write transaction leaves the
; transaction needing `pagerRollback`; `pagerCommit` rolls it back.
(import Mem)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Sys)
(import Axqlite.Value)

; An open database file.
(pub struct Pager word
  (slot : Int))

; The handle-table kind of a pager.
(:: pagerKind Int)
(fn (pagerKind)
  11)

; The page size in bytes.
(pub :: pagerPageSize Int)
(pub fn (pagerPageSize)
  4096)

; The bytes of a page before its checksum; a page's content is
; `[0, pagerUsable)`.
(pub :: pagerUsable Int)
(pub fn (pagerUsable)
  4088)

(:: maxPages Int)
(fn (maxPages)
  2147483648)

(:: reserveFrames Int)
(fn (reserveFrames)
  64)

(:: jHeaderBytes Int)
(fn (jHeaderBytes)
  512)

; A journal record: page number, page, checksum.
(:: recordBytes Int)
(fn (recordBytes)
  4108)

; The fault kinds `pagerFaultArm` takes. A failed point answers EIO and
; the pager carries on; a tear writes the first `arg` bytes of the write
; and then loses power; a power loss drops that point and every later
; write, sync and truncate while answering success. The strict power
; loss also undoes every write made since its file's last sync, as a
; disk that loses its whole cache would; the journal and database
; variants undo only that file's unsynced writes and keep the other's,
; as a disk that wrote the two files' caches out in either order.
(pub :: pagerFaultFail Int)
(pub fn (pagerFaultFail)
  1)

(pub :: pagerFaultTear Int)
(pub fn (pagerFaultTear)
  2)

(pub :: pagerFaultPowerLoss Int)
(pub fn (pagerFaultPowerLoss)
  3)

(pub :: pagerFaultPowerLossStrict Int)
(pub fn (pagerFaultPowerLossStrict)
  4)

(pub :: pagerFaultPowerLossJournal Int)
(pub fn (pagerFaultPowerLossJournal)
  5)

(pub :: pagerFaultPowerLossDatabase Int)
(pub fn (pagerFaultPowerLossDatabase)
  6)

; ------------------------------------------------------------------
; Checksums: XXH64.
; ------------------------------------------------------------------
(:: xP1 Int)
(fn (xP1)
  -7046029288634856825)

(:: xP2 Int)
(fn (xP2)
  -4417276706812531889)

(:: xP3 Int)
(fn (xP3)
  1609587929392839161)

(:: xP4 Int)
(fn (xP4)
  -8796714831421723037)

(:: xP5 Int)
(fn (xP5)
  2870177450012600261)

; `x` shifted right by `s` in 1..63 with zeros coming in.
(:: shr (-> Int Int Int))
(fn (shr x s)
  (& (>> x s) (- (<< 1 (- 64 s)) 1)))

(:: rotl (-> Int Int Int))
(fn (rotl x r)
  (| (<< x r) (shr x (- 64 r))))

(:: xRound (-> Int Int Int))
(fn (xRound acc input)
  (* (rotl (+ acc (* input xP2)) 31) xP1))

(:: xMerge (-> Int Int Int))
(fn (xMerge acc v)
  (+ (* (^ acc (xRound 0 v)) xP1) xP4))

; The XXH64 hash of `len` bytes at `addr` with seed `seed`, as the
; reference implementation computes it (words read little-endian). It
; is the checksum of every page and journal record.
(pub :: pagerChecksum (-> Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (pagerChecksum addr len seed)
  (let (
    (mut i 0)
    (mut h 0)
  )
    {
      (if (>= len 32)
        (let (
          (mut v1 (+ (+ seed xP1) xP2))
          (mut v2 (+ seed xP2))
          (mut v3 seed)
          (mut v4 (- seed xP1))
        )
          {
            (while (<= (+ i 32) len)
              (let ((a (+ addr i)))
                {
                  (set v1 (* (rotl (+ v1 (* (__load64 a 0) xP2)) 31) xP1))
                  (set v2 (* (rotl (+ v2 (* (__load64 a 1) xP2)) 31) xP1))
                  (set v3 (* (rotl (+ v3 (* (__load64 a 2) xP2)) 31) xP1))
                  (set v4 (* (rotl (+ v4 (* (__load64 a 3) xP2)) 31) xP1))
                  (set i (+ i 32))
                }))
            (set h (+ (+ (rotl v1 1) (rotl v2 7)) (+ (rotl v3 12) (rotl v4 18))))
            (set h (xMerge h v1))
            (set h (xMerge h v2))
            (set h (xMerge h v3))
            (set h (xMerge h v4))
            0
          })
        {
          (set h (+ seed xP5))
          0
        })
      (set h (+ h len))
      (while (<= (+ i 8) len)
        {
          (set h (+ (* (rotl (^ h (xRound 0 (__load64 (+ addr i) 0))) 27) xP1) xP4))
          (set i (+ i 8))
        })
      (if (<= (+ i 4) len)
        (let ((w (| (| (__load8 addr i) (<< (__load8 addr (+ i 1)) 8)) (| (<< (__load8 addr (+ i 2)) 16) (<< (__load8 addr (+ i 3)) 24)))))
          {
            (set h (+ (* (rotl (^ h (* w xP1)) 23) xP2) xP3))
            (set i (+ i 4))
            0
          })
        0)
      (while (< i len)
        {
          (set h (* (rotl (^ h (* (__load8 addr i) xP5)) 11) xP1))
          (set i (+ i 1))
        })
      (set h (^ h (shr h 33)))
      (set h (* h xP2))
      (set h (^ h (shr h 29)))
      (set h (* h xP3))
      (^ h (shr h 32))
    }))

; ------------------------------------------------------------------
; Big-endian fields.
; ------------------------------------------------------------------
; The `n` bytes (1..8) at `addr + off`, big-endian and unsigned.
(pub :: pagerGetBe (-> Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (pagerGetBe addr off n)
  (let ((mut v 0))
    {
      (for i in 0..n
        (set v (| (<< v 8) (__load8 addr (+ off i)))))
      v
    }))

; Store the low `n` bytes of `v` big-endian at `addr + off`.
(pub :: pagerPutBe (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (pagerPutBe addr off n v)
  {
    (for i in 0..n
      (__store8 addr (+ off i) (& (>> v (* 8 (- (- n 1) i))) 255)))
    0
  })

; ------------------------------------------------------------------
; The state mapping. Word `i` of the mapping at `m`.
; ------------------------------------------------------------------
(:: wLen Int)
(fn (wLen)
  0)

(:: wDbFd Int)
(fn (wDbFd)
  1)

(:: wJFd Int)
(fn (wJFd)
  2)

(:: wLock Int)
