;;! Axqlite.AxqlParse - AXQL text into statements.
;;!
;;!     (axqlParse "SELECT name FROM person WHERE age > $min")
;;!         ; (Ok <Parsed>): one statement, its `$min` in paramNames
;;!     (axqlParse "SELEC 1")
;;!         ; (Err ...) axqSyntax "line 1, column 1: expected a statement, found \"SELEC\""
;;!     (axqlParseScript "CREATE person:ada SET name = 'Ada'; SELECT * FROM person;")
;;!         ; (Ok [<Parsed>, <Parsed>])
;
; AXQL is the query language of AXQLite. A statement is one of the
; forms `docs/axql.md` defines; a script is statements separated by
; `;`. Keywords may be written in any case and are keywords only
; where the grammar expects them, so a field may be called `order`
; or `text`. Names are `[A-Za-z_][A-Za-z0-9_]*`, or any text in
; backticks. Table and field names compare exactly when they name a
; field, and without regard to ASCII case when they name a table an
; index, an event or a function is defined on - `Axqlite.AxqlSchema`
; keeps that rule.
;
; Values enter a statement as literals or as `$parameters`, which the
; caller binds by name from one object. A parameter is a value, never
; text: `'x'); DELETE person; --` bound to `$x` is a text value like
; any other.
;
; Every syntax error is `axqSyntax` and names the line and column
; (counted in bytes, from 1) of the token it stopped at, so an editor
; can underline it. `axqlTokens` exposes the same scan as flat
; triples for colouring.
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Float)
(import Axqlite.Value)
(import Axqlite.AxqlAst)

; ------------------------------------------------------------------
; Limits.
; ------------------------------------------------------------------
;; How deep brackets and paths may nest in one expression. The parser
;; is recursive, so this is a stack budget: a deeper expression is a
;; refusal rather than a crash.
(pub :: axqlMaxDepth Int)
(pub fn (axqlMaxDepth)
  200)

;; The most operators one statement may hold, a stack budget like
;; `axqlMaxDepth`.
(pub :: axqlMaxOperators Int)
(pub fn (axqlMaxOperators)
  3000)

; ------------------------------------------------------------------
; Tokens.
; ------------------------------------------------------------------
(:: tkEof Int)
(fn (tkEof)
  0)

(:: tkIdent Int)
(fn (tkIdent)
  1)

(:: tkInt Int)
(fn (tkInt)
  2)

; The one integer literal a positive reading can't hold:
; 9223372036854775808, which is an int only under a minus sign.
(:: tkIntMin Int)
(fn (tkIntMin)
  3)

(:: tkFloat Int)
(fn (tkFloat)
  4)

(:: tkStr Int)
(fn (tkStr)
  5)

(:: tkBytes Int)
(fn (tkBytes)
  6)

(:: tkParam Int)
(fn (tkParam)
  7)

(:: tkDuration Int)
(fn (tkDuration)
  8)

(:: tkLParen Int)
(fn (tkLParen)
  10)

(:: tkRParen Int)
(fn (tkRParen)
  11)

(:: tkLBrace Int)
(fn (tkLBrace)
  12)

(:: tkRBrace Int)
(fn (tkRBrace)
  13)

(:: tkLBracket Int)
(fn (tkLBracket)
  14)

(:: tkRBracket Int)
(fn (tkRBracket)
  15)

(:: tkComma Int)
(fn (tkComma)
  16)

(:: tkSemi Int)
(fn (tkSemi)
  17)

(:: tkColon Int)
(fn (tkColon)
  18)

(:: tkColonColon Int)
(fn (tkColonColon)
  19)

(:: tkDot Int)
(fn (tkDot)
  20)

(:: tkArrowR Int)
(fn (tkArrowR)
  21)

(:: tkArrowL Int)
(fn (tkArrowL)
  22)

(:: tkArrowB Int)
(fn (tkArrowB)
  23)

(:: tkEq Int)
(fn (tkEq)
  24)

(:: tkNe Int)
(fn (tkNe)
  25)

(:: tkLt Int)
(fn (tkLt)
  26)

(:: tkLe Int)
(fn (tkLe)
  27)

(:: tkGt Int)
(fn (tkGt)
  28)

(:: tkGe Int)
(fn (tkGe)
  29)

(:: tkPlus Int)
(fn (tkPlus)
  30)

(:: tkMinus Int)
(fn (tkMinus)
  31)

(:: tkStar Int)
(fn (tkStar)
  32)

(:: tkSlash Int)
(fn (tkSlash)
  33)

(:: tkPercent Int)
(fn (tkPercent)
  34)

(:: tkBang Int)
(fn (tkBang)
  35)

(:: tkPlusEq Int)
(fn (tkPlusEq)
  36)

(:: tkMinusEq Int)
(fn (tkMinusEq)
  37)

(:: tkQQ Int)
(fn (tkQQ)
  38)

(:: tkAnyEq Int)
(fn (tkAnyEq)
  39)

(:: tkAllEq Int)
(fn (tkAllEq)
  40)

(:: tkDatetimeLit Int)
(fn (tkDatetimeLit)
  41)

(:: tkUuidLit Int)
(fn (tkUuidLit)
  42)

; One token: its kind, where it is in the source, and its text. For a
; string, bytes or backticked name the text is the decoded value; for
; everything else it is the source slice.
(struct Tok
  (kind : Int)
  (start : Int)
  (end : Int)
  (text : String))

; An `axqSyntax` error at byte `at` of `src`.
(:: synErrAt (-> String Int String (Result a Error)))
(fn (synErrAt src at msg)
  (axqErr axqSyntax (concat (concat (axqlPosText src at) ": ") msg) "axqlParse"))

; ------------------------------------------------------------------
; The lexer.
; ------------------------------------------------------------------
(struct Lx
  (src : String)
  (toks : (Vec Tok))
  (mut at : Int)
  (mut failed : Bool)
  (mut errAt : Int)
  (mut errMsg : String))

(:: lxFail (-> Lx Int String Int))
(fn (lxFail lx at msg)
  {
    (set lx.failed true)
    (set lx.errAt at)
    (set lx.errMsg msg)
    0
  })

(:: isIdentStart (-> Int Bool))
(fn (isIdentStart c)
  (|| (strIsAlpha c) (== c 95)))

(:: isIdentPart (-> Int Bool))
(fn (isIdentPart c)
  (|| (isIdentStart c) (strIsDigit c)))

(:: byteAt (-> String Int Int Int))
(fn (byteAt s i n)
  (if (< i n)
    (strByte s i)
    0))

(:: pushTok (-> Lx Int Int Int String Int))
(fn (pushTok lx kind start end text)
  {
    (vecPush lx.toks (Tok :kind kind :start start :end end :text text))
    0
  })

; Scan all of `lx.src` into tokens, ending with one `tkEof`. Stops at
; the first fault, which `lx.failed` records.
(:: lexAll (-> Lx Int Int))
(fn (lexAll lx n)
  {
    (while (&& (! lx.failed) (< lx.at n))
      (lexOne lx n))
    (pushTok lx tkEof lx.at lx.at "")
  })

(:: lexOne (-> Lx Int Int))
(fn (lexOne lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let c (strByte s i))
    (if (strIsSpace c)
      (set lx.at (+ i 1))
      (if (&& (== c 45) (== (byteAt s (+ i 1) n) 45))
        (set lx.at (skipLine s i n))
        (if (&& (== c 47) (== (byteAt s (+ i 1) n) 47))
          (set lx.at (skipLine s i n))
          (if (&& (== c 47) (== (byteAt s (+ i 1) n) 42))
            (skipBlock lx i n)
            (lexToken lx n)))))
  })

(:: skipLine (-> String Int Int Int))
(fn (skipLine s i n)
  {
    (let mut j i)
    {
      (while (&& (< j n) (!= (strByte s j) 10))
        (set j (+ j 1)))
      j
    }
  })

(:: skipBlock (-> Lx Int Int Int))
(fn (skipBlock lx i n)
  {
    (let s lx.src)
    (let mut j (+ i 2))
    (let mut done false)
    {
      (while (&& (! done) (< (+ j 1) n))
        (if (&& (== (strByte s j) 42) (== (strByte s (+ j 1)) 47))
          {
            (set done true)
            (set j (+ j 2))
          }
          (set j (+ j 1))))
      (if done
        (set lx.at j)
        (lxFail lx i "this comment is never closed"))
    }
  })

(:: lexToken (-> Lx Int Int))
(fn (lexToken lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let c (strByte s i))
    (if (isIdentStart c)
      (lexIdent lx n)
      (if (strIsDigit c)
        (lexNumber lx n)
        (if (== c 96)
          (lexBacktick lx n)
          (if (|| (== c 39) (== c 34))
            (lexString lx n c tkStr i)
            (if (== c 36)
              (lexParam lx n)
              (if (== c 46)
                (lexDot lx n)
                (lexPunct lx n)))))))
  })

(:: lexIdent (-> Lx Int Int))
(fn (lexIdent lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (if (&& (|| (== (strByte s i) 120) (== (strByte s i) 88)) (== (byteAt s (+ i 1) n) 39))
      (lexHex lx n)
      (if (&& (|| (== (strByte s i) 100) (== (strByte s i) 68)) (== (byteAt s (+ i 1) n) 39))
        {
          (set lx.at (+ i 1))
          (lexString lx n 39 tkDatetimeLit i)
        }
        (if (&& (|| (== (strByte s i) 117) (== (strByte s i) 85)) (== (byteAt s (+ i 1) n) 39))
          {
            (set lx.at (+ i 1))
            (lexString lx n 39 tkUuidLit i)
          }
          (lexName lx n))))
  })

; A plain name.
(:: lexName (-> Lx Int Int))
(fn (lexName lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let mut j i)
    {
      (while (&& (< j n) (isIdentPart (strByte s j)))
        (set j (+ j 1)))
      (pushTok lx tkIdent i j (strSlice s i (- j i)))
      (set lx.at j)
    }
  })

; x'4F4B': bytes written in hex.
(:: lexHex (-> Lx Int Int))
;@axiom:effect(unsafe)
(fn (lexHex lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let mut j (+ i 2))
    (let bytes vecNew)
    (let mut ok true)
    (let mut hi -1)
    {
      (while (&& ok (&& (< j n) (!= (strByte s j) 39)))
        {
          (let d (hexDigit (strByte s j)))
          (if (< d 0)
            (set ok false)
            (if (< hi 0)
              (set hi d)
              {
                (vecPush bytes (+ (* hi 16) d))
                (set hi -1)
              }))
          (set j (+ j 1))
        })
      (if (! (&& ok (&& (< j n) (== hi -1))))
        (lxFail lx i "a bytes literal is x'..' with an even number of hex digits")
        {
          (let out (strAlloc (vecLen bytes)))
          {
            (for (b k) in bytes
              (__store8 (strData out) k b))
            (pushTok lx tkBytes i (+ j 1) out)
            (set lx.at (+ j 1))
          }
        })
    }
  })

(:: hexDigit (-> Int Int))
(fn (hexDigit c)
  (if (strIsDigit c)
      (- c 48)
    (&& (>= c 97) (<= c 102))
      (- c 87)
    (&& (>= c 65) (<= c 70))
      (- c 55)
    -1))

(:: lexBacktick (-> Lx Int Int))
(fn (lexBacktick lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let mut j (+ i 1))
    {
      (while (&& (< j n) (!= (strByte s j) 96))
        (set j (+ j 1)))
      (if (>= j n)
        (lxFail lx i "this `name` is never closed")
        (if (== j (+ i 1))
          (lxFail lx i "a `name` can't be empty")
          {
            (pushTok lx tkIdent i (+ j 1) (strSlice s (+ i 1) (- j (+ i 1))))
            (set lx.at (+ j 1))
          }))
    }
  })

; A quoted string. Two quotes in a row are one quote; \n \r \t \\ and
; an escaped quote mean what they say. `kind` and `start` say what
; token it becomes and where it begins, so d'...' and u'...' share it.
(:: lexString (-> Lx Int Int Int Int Int))
;@axiom:effect(unsafe)
(fn (lexString lx n quote kind start)
  {
    (let s lx.src)
    (let i lx.at)
    (let bytes vecNew)
    (let mut j (+ i 1))
    (let mut done false)
    (let mut ok true)
    {
      (while (&& ok (! done))
        (if (>= j n)
          (set ok false)
          {
            (let c (strByte s j))
            (if (== c quote)
              (if (== (byteAt s (+ j 1) n) quote)
                {
                  (vecPush bytes quote)
                  (set j (+ j 2))
                }
                {
                  (set done true)
                  (set j (+ j 1))
                })
              (if (== c 92)
                {
                  (let e (escByte (byteAt s (+ j 1) n)))
                  (if (< e 0)
                    (set ok false)
                    {
                      (vecPush bytes e)
                      (set j (+ j 2))
                    })
                }
                {
                  (vecPush bytes c)
                  (set j (+ j 1))
                }))
          }))
      (if (! ok)
        (lxFail lx i "this string is never closed, or holds a bad escape")
        {
          (let out (strAlloc (vecLen bytes)))
          {
            (for (b k) in bytes
              (__store8 (strData out) k b))
            (pushTok lx kind start j out)
            (set lx.at j)
          }
        })
    }
  })

(:: escByte (-> Int Int))
(fn (escByte c)
  (if (== c 110)
      10
    (== c 114)
      13
    (== c 116)
      9
    (== c 48)
      0
    (== c 92)
      92
    (== c 39)
      39
    (== c 34)
      34
    -1))

(:: lexParam (-> Lx Int Int))
(fn (lexParam lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (if (! (isIdentStart (byteAt s (+ i 1) n)))
      (lxFail lx i "a parameter is $ followed by a name")
      {
        (let mut j (+ i 1))
        {
          (while (&& (< j n) (isIdentPart (strByte s j)))
            (set j (+ j 1)))
          (pushTok lx tkParam i j (strSlice s (+ i 1) (- j (+ i 1))))
          (set lx.at j)
        }
      })
  })

(:: lexDot (-> Lx Int Int))
(fn (lexDot lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (if (strIsDigit (byteAt s (+ i 1) n))
      (lexNumber lx n)
      {
        (pushTok lx tkDot i (+ i 1) ".")
        (set lx.at (+ i 1))
      })
  })

(:: lexNumber (-> Lx Int Int))
(fn (lexNumber lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let mut j i)
    (let mut isFloat false)
    {
      (while (&& (< j n) (strIsDigit (strByte s j)))
        (set j (+ j 1)))
      (if (&& (< j n) (== (strByte s j) 46))
        (if (|| (strIsDigit (byteAt s (+ j 1) n)) (== j i))
          {
            (set isFloat true)
            (set j (+ j 1))
            (while (&& (< j n) (strIsDigit (strByte s j)))
              (set j (+ j 1)))
          }
          (if (> j i)
            ; `5.` is a float; `1.foo` reads the same way, so the
            ; dot goes with the number only when what follows the
            ; dot can't start a field name.
            (if (! (isIdentStart (byteAt s (+ j 1) n)))
              {
                (set isFloat true)
                (set j (+ j 1))
              }))))
      (if (&& (&& (< j n) (|| (== (strByte s j) 101) (== (strByte s j) 69))) (expFollows s j n))
        {
          (set isFloat true)
          (set j (+ j 1))
          (if (&& (< j n) (|| (== (strByte s j) 43) (== (strByte s j) 45)))
            (set j (+ j 1)))
          (while (&& (< j n) (strIsDigit (strByte s j)))
            (set j (+ j 1)))
        })
      (if isFloat
        {
          (pushTok lx tkFloat i j (strSlice s i (- j i)))
          (set lx.at j)
        }
        (if (&& (< j n) (isDurationUnit (strByte s j)))
          (lexDuration lx n i j)
          {
            (let text (strSlice s i (- j i)))
            (pushTok lx
              (if (intTextIsMin text)
                tkIntMin
                tkInt)
              i j text)
            (set lx.at j)
          }))
    }
  })

(:: expFollows (-> String Int Int Bool))
(fn (expFollows s j n)
  {
    (let a (byteAt s (+ j 1) n))
    (|| (strIsDigit a) (&& (|| (== a 43) (== a 45)) (strIsDigit (byteAt s (+ j 2) n))))
  })

(:: intTextIsMin (-> String Bool))
(fn (intTextIsMin text)
  {
    ; Leading zeros mean the digits are read in full: 0092233.. is far
    ; past the limit, not the limit.
    (let mut t text)
    {
      (while (&& (> (strLen t) 1) (== (strByte t 0) 48))
        (set t (strSlice t 1 (- (strLen t) 1))))
      (strEq t "9223372036854775808")
    }
  })

(:: isDurationUnit (-> Int Bool))
(fn (isDurationUnit c)
  (|| (== c 121)
    (|| (== c 119)
      (|| (== c 100) (|| (== c 104) (|| (== c 109) (|| (== c 115) (|| (== c 117) (== c 110)))))))))

; Digits then units, as `1h30m`: the whole run is one token, and the
; parser reads its length.
(:: lexDuration (-> Lx Int Int Int Int))
(fn (lexDuration lx n i j0)
  {
    (let s lx.src)
    (let mut j j0)
    (let mut ok true)
    {
      (while (&& ok (&& (< j n) (isDurationUnit (strByte s j))))
        {
          (set j (+ j (unitLen s j n)))
          (if (&& (< j n) (strIsDigit (strByte s j)))
            (while (&& (< j n) (strIsDigit (strByte s j)))
              (set j (+ j 1)))
            (if (&& (< j n) (isIdentPart (strByte s j)))
              (set ok false)))
        })
      (if (! ok)
        (lxFail lx i "a duration is digits and units, as 1h30m")
        {
          (pushTok lx tkDuration i j (strSlice s i (- j i)))
          (set lx.at j)
        })
    }
  })

; How many bytes the unit at `j` takes: ms/us/ns are two, the rest one.
(:: unitLen (-> String Int Int Int))
(fn (unitLen s j n)
  (if (&& (|| (== (strByte s j) 109) (|| (== (strByte s j) 117) (== (strByte s j) 110)))
        (== (byteAt s (+ j 1) n) 115))
    (if (== (strByte s j) 109)
      ; `m` alone is a minute; `ms` a millisecond. A following digit
      ; after `ms` is what separates them from `m` then a stray `s`.
      2
      2)
    1))

(:: lexPunct (-> Lx Int Int))
(fn (lexPunct lx n)
  {
    (let s lx.src)
    (let i lx.at)
    (let c (strByte s i))
    (let c2 (byteAt s (+ i 1) n))
    (if (== c 40)
      (punct lx tkLParen i 1 "(")
      (if (== c 41)
        (punct lx tkRParen i 1 ")")
        (if (== c 123)
          (punct lx tkLBrace i 1 "{")
          (if (== c 125)
            (punct lx tkRBrace i 1 "}")
            (if (== c 91)
              (punct lx tkLBracket i 1 "[")
              (if (== c 93)
                (punct lx tkRBracket i 1 "]")
                (if (== c 44)
                  (punct lx tkComma i 1 ",")
                  (if (== c 59)
                    (punct lx tkSemi i 1 ";")
                    (if (== c 37)
                      (punct lx tkPercent i 1 "%")
                      (lexSymbol lx n c c2))))))))))
  })

(:: punct (-> Lx Int Int Int String Int))
(fn (punct lx kind i len text)
  {
    (pushTok lx kind i (+ i len) text)
    (set lx.at (+ i len))
  })

(:: lexSymbol (-> Lx Int Int Int Int))
(fn (lexSymbol lx n c c2)
  {
    (let s lx.src)
    (let i lx.at)
    (if (== c 58)
      (if (== c2 58)
        (punct lx tkColonColon i 2 "::")
        (punct lx tkColon i 1 ":"))
      (if (== c 61)
        (punct lx tkEq i 1 "=")
        (if (== c 33)
          (if (== c2 61)
            (punct lx tkNe i 2 "!=")
            (punct lx tkBang i 1 "!"))
          (if (== c 43)
            (if (== c2 61)
              (punct lx tkPlusEq i 2 "+=")
              (punct lx tkPlus i 1 "+"))
            (if (== c 42)
              (if (== c2 61)
                (punct lx tkAllEq i 2 "*=")
                (punct lx tkStar i 1 "*"))
              (if (== c 47)
                (punct lx tkSlash i 1 "/")
                (if (== c 63)
                  (if (== c2 63)
                    (punct lx tkQQ i 2 "??")
                    (if (== c2 61)
                      (punct lx tkAnyEq i 2 "?=")
                      (lxFail lx i "a stray `?`: parameters are $name")))
                  (lexAngle lx n c c2))))))))
  })

; `<`, `>`, `-` and the graph arrows. An arrow is an arrow only when
; a name or `*` follows it, so `a < -1` stays a comparison.
(:: lexAngle (-> Lx Int Int Int Int))
(fn (lexAngle lx n c c2)
  {
    (let s lx.src)
    (let i lx.at)
    (if (== c 45)
      (if (== c2 62)
        (if (arrowFollows s (+ i 2) n)
          (punct lx tkArrowR i 2 "->")
          (punct lx tkMinus i 1 "-"))
        (if (== c2 61)
          (punct lx tkMinusEq i 2 "-=")
          (punct lx tkMinus i 1 "-")))
      (if (== c 60)
        (if (== c2 45)
          (if (== (byteAt s (+ i 2) n) 62)
            (if (arrowFollows s (+ i 3) n)
              (punct lx tkArrowB i 3 "<->")
              (punct lx tkLt i 1 "<"))
            (if (arrowFollows s (+ i 2) n)
              (punct lx tkArrowL i 2 "<-")
              (punct lx tkLt i 1 "<")))
          (if (== c2 61)
            (punct lx tkLe i 2 "<=")
            (punct lx tkLt i 1 "<")))
        (if (== c 62)
          (if (== c2 61)
            (punct lx tkGe i 2 ">=")
            (punct lx tkGt i 1 ">"))
          (lxFail lx i (concat "an unexpected character: " (strSlice s i 1))))))
  })

(:: arrowFollows (-> String Int Int Bool))
(fn (arrowFollows s j n)
  {
    (let mut k j)
    {
      (while (&& (< k n) (strIsSpace (strByte s k)))
        (set k (+ k 1)))
      (&& (< k n)
        (|| (isIdentStart (strByte s k)) (|| (== (strByte s k) 42) (== (strByte s k) 36))))
    }
  })

; ------------------------------------------------------------------
; The parser.
; ------------------------------------------------------------------
(struct Ps
  (src : String)
  (toks : (Vec Tok))
  (mut at : Int)
  (mut ops : Int)
  (params : (Vec String)))

(:: peek (-> Ps Tok))
(fn (peek p)
  (vecGet p.toks p.at))

(:: peekKind (-> Ps Int))
(fn (peekKind p)
  {
    (let t (peek p))
    t.kind
  })

(:: peekStart (-> Ps Int))
(fn (peekStart p)
  {
    (let t (peek p))
    t.start
  })

(:: peekText (-> Ps String))
(fn (peekText p)
  {
    (let t (peek p))
    t.text
  })

; Advance and answer the token's text.
(:: advText (-> Ps String))
(fn (advText p)
  {
    (let t (advance p))
    t.text
  })

(:: lastStart (-> Ps Int))
(fn (lastStart p)
  {
    (let t (lastTok p))
    t.start
  })

(:: lastEnd (-> Ps Int))
(fn (lastEnd p)
  {
    (let t (lastTok p))
    t.end
  })

(:: peekAt (-> Ps Int Tok))
(fn (peekAt p ahead)
  (if (< (+ p.at ahead) (vecLen p.toks))
    (vecGet p.toks (+ p.at ahead))
    (vecGet p.toks (- (vecLen p.toks) 1))))

(:: advance (-> Ps Tok))
(fn (advance p)
  {
    (let t (peek p))
    {
      (if (< p.at (- (vecLen p.toks) 1))
        (set p.at (+ p.at 1)))
      t
    }
  })

; The token just passed.
(:: lastTok (-> Ps Tok))
(fn (lastTok p)
  (vecGet p.toks
    (if (== p.at 0)
      0
      (- p.at 1))))

; Whether the token at hand is the word `w`, in any case.
(:: atWord (-> Ps String Bool))
(fn (atWord p w)
  {
    (let t (peek p))
    (&& (== t.kind tkIdent) (wordEq t.text w))
  })

(:: wordAt (-> Ps Int String Bool))
(fn (wordAt p ahead w)
  {
    (let t (peekAt p ahead))
    (&& (== t.kind tkIdent) (wordEq t.text w))
  })

; Whether the token at hand is the word `w`; consume it when it is.
(:: eatWord (-> Ps String Bool))
(fn (eatWord p w)
  (if (atWord p w)
    {
      (advance p)
      true
    }
    false))

(:: atKind (-> Ps Int Bool))
(fn (atKind p kind)
  (== (peekKind p) kind))

(:: eatKind (-> Ps Int Bool))
(fn (eatKind p kind)
  (if (atKind p kind)
    {
      (advance p)
      true
    }
    false))

; Two names are one name when equal but for ASCII case.
(:: wordEq (-> String String Bool))
(fn (wordEq a b)
  {
    (let n (strLen a))
    (if (!= n (strLen b))
      false
      {
        (let mut i 0)
        (let mut same true)
        {
          (while (&& same (< i n))
            (if (== (lowerByte (strByte a i)) (lowerByte (strByte b i)))
              (set i (+ i 1))
              (set same false)))
          same
        }
      })
  })

(:: lowerByte (-> Int Int))
(fn (lowerByte c)
  (if (&& (>= c 65) (<= c 90))
    (+ c 32)
    c))

;; Whether two names are the same name, ignoring ASCII case: how
;; table, index, event and function names compare across AXQLite.
(pub :: axqlWordEq (-> String String Bool))
(pub fn (axqlWordEq a b)
  (wordEq a b))

; What a token is called in an error message.
(:: foundText (-> Tok String))
(fn (foundText t)
  (if (== t.kind tkEof)
    "the end of the statement"
    (concat (concat "\"" (tokShown t)) "\"")))

(:: tokShown (-> Tok String))
(fn (tokShown t)
  (if (== t.kind tkStr)
    "a string"
    (if (> (strLen t.text) 24)
      (concat (strSlice t.text 0 24) "...")
      t.text)))

; A refusal at the token at hand: "expected X, found Y".
(:: expected (-> Ps String (Result a Error)))
(fn (expected p what)
  (synErrAt p.src (peekStart p)
    (concat (concat (concat "expected " what) ", found ") (foundText (peek p)))))

(:: expectKind (-> Ps Int String (Result Tok Error)))
(fn (expectKind p kind what)
  (if (atKind p kind)
    (Ok (advance p))
    (expected p what)))

(:: expectWord (-> Ps String String (Result Tok Error)))
(fn (expectWord p w what)
  (if (atWord p w)
    (Ok (advance p))
    (expected p what)))

; One more operator in the statement, or a refusal past the budget.
(:: countOp (-> Ps (Result Int Error)))
(fn (countOp p)
  {
    (set p.ops (+ p.ops 1))
    (if (> p.ops axqlMaxOperators)
      (synErrAt p.src (peekStart p) "this statement holds too many operators")
      (Ok 0))
  })

; Note a parameter the statement names, once each.
(:: noteParam (-> Ps String Int))
(fn (noteParam p name)
  {
    (let mut seen false)
    {
      (for n in p.params
        (if (strEq n name)
          (set seen true)))
      (if (! seen)
        {
          (vecPush p.params name)
          0
        }
        0)
    }
  })

; A name where the grammar wants one: an identifier in its written
; case. Any identifier does, keyword-shaped or not; the caller has
; already claimed the words it needs.
(:: parseName (-> Ps String (Result String Error)))
(fn (parseName p what)
  (if (atKind p tkIdent)
    (Ok (advText p))
    (expected p what)))

; ------------------------------------------------------------------
; Statements.
; ------------------------------------------------------------------
; Statements up to `}` or the end, `;` between them optional and
; extra ones welcome.
(:: parseStmts (-> Ps (Result (Vec Stmt) Error)))
(fn (parseStmts p)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (while (&& (isNone failure) (&& (! (atKind p tkEof)) (! (atKind p tkRBrace))))
        (if (eatKind p tkSemi)
          0
          (match (parseStmt p)
            ((Ok s) (vecPush out s))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok out)))
    }
  })

(:: parseStmt (-> Ps (Result Stmt Error)))
(fn (parseStmt p)
  (if (atKind p tkIdent)
    (parseWordStmt p (peekText p))
    {
      (let e (parseExpr p 0)?)
      (Ok (SExpr e))
    }))

(:: parseWordStmt (-> Ps String (Result Stmt Error)))
(fn (parseWordStmt p w)
  (if (wordEq w "SELECT")
      {
        (let s (parseSelect p)?)
        (Ok (SSelect s))
      }
    (wordEq w "LIVE")
      {
        (advance p)
        {
          (let _ (expectWord p "SELECT" "SELECT after LIVE")?)
          (let s (parseSelectFrom p)?)
          (Ok (SLive s))
        }
      }
    (wordEq w "CREATE")
      (parseWrite p 0)
    (wordEq w "UPDATE")
      (parseWrite p 1)
    (wordEq w "UPSERT")
      (parseWrite p 2)
    (wordEq w "DELETE")
      (parseWrite p 3)
    (wordEq w "RELATE")
      (parseRelate p)
    (wordEq w "INSERT")
      (parseInsert p)
    (wordEq w "DEFINE")
      (parseDefine p)
    (wordEq w "REMOVE")
      (parseRemove p)
    (wordEq w "LET")
      (parseLet p)
    (wordEq w "RETURN")
      {
        (advance p)
        (if (|| (atKind p tkSemi) (|| (atKind p tkEof) (atKind p tkRBrace)))
          (Ok (SReturn (ELit VNone)))
          {
            (let e (parseExpr p 0)?)
            (Ok (SReturn e))
          })
      }
    (wordEq w "THROW")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (Ok (SThrow e))
        }
      }
    (wordEq w "IF")
      (parseIfStmt p)
    (wordEq w "FOR")
      (parseFor p)
    (wordEq w "BREAK")
      {
        (advance p)
        (Ok SBreak)
      }
    (wordEq w "CONTINUE")
      {
        (advance p)
        (Ok SContinue)
      }
    (wordEq w "BEGIN")
      {
        (advance p)
        {
          (eatWord p "TRANSACTION")
          (Ok SBegin)
        }
      }
    (wordEq w "COMMIT")
      {
        (advance p)
        {
          (eatWord p "TRANSACTION")
          (Ok SCommit)
        }
      }
    (wordEq w "CANCEL")
      {
        (advance p)
        {
          (eatWord p "TRANSACTION")
          (Ok SCancel)
        }
      }
    (wordEq w "KILL")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (Ok (SKill e))
        }
      }
    (wordEq w "INFO")
      (parseInfo p)
    (wordEq w "SHOW")
      (parseShow p)
    {
      (let e (parseExpr p 0)?)
      (Ok (SExpr e))
    }))

(:: parseLet (-> Ps (Result Stmt Error)))
(fn (parseLet p)
  {
    (advance p)
    {
      (let t (expectKind p tkParam "a $name after LET")?)
      {
        (let _ (expectKind p tkEq "= after the name")?)
        {
          (let e (parseExpr p 0)?)
          (Ok (SLet t.text e))
        }
      }
    }
  })

; `{` statements `}`.
(:: parseBlock (-> Ps (Result (Vec Stmt) Error)))
(fn (parseBlock p)
  {
    (let _ (expectKind p tkLBrace "a { block }")?)
    {
      (let body (parseStmts p)?)
      {
        (let _ (expectKind p tkRBrace "a } to close the block")?)
        (Ok body)
      }
    }
  })

(:: parseIfStmt (-> Ps (Result Stmt Error)))
(fn (parseIfStmt p)
  {
    (advance p)
    {
      (let cond (parseExpr p 0)?)
      {
        (let body (parseBlock p)?)
        {
          (let arms (parseElseArms p (ElseArms :elifs vecNew :els vecNew))?)
          (Ok (SIf cond body arms.elifs arms.els))
        }
      }
    }
  })

; The ELSE IF arms and ELSE body of an IF so far.
(struct ElseArms
  (elifs : (Vec Elif))
  (els : (Vec Stmt)))

(:: parseElseArms (-> Ps ElseArms (Result ElseArms Error)))
(fn (parseElseArms p arms)
  (if (! (eatWord p "ELSE"))
    (Ok arms)
    (if (eatWord p "IF")
      {
        (let cond (parseExpr p 0)?)
        {
          (let body (parseBlock p)?)
          {
            (vecPush arms.elifs (Elif :cond cond :body body))
            (parseElseArms p arms)
          }
        }
      }
      {
        (let body (parseBlock p)?)
        (Ok (ElseArms :elifs arms.elifs :els body))
      })))

(:: parseFor (-> Ps (Result Stmt Error)))
(fn (parseFor p)
  {
    (advance p)
    {
      (let t (expectKind p tkParam "a $name after FOR")?)
      {
        (let _ (expectWord p "IN" "IN after the name")?)
        {
          (let e (parseExpr p 0)?)
          {
            (let body (parseBlock p)?)
            (Ok (SFor t.text e body))
          }
        }
      }
    }
  })

(:: parseInfo (-> Ps (Result Stmt Error)))
(fn (parseInfo p)
  {
    (advance p)
    {
      (let _ (expectWord p "FOR" "FOR after INFO")?)
      (if (eatWord p "DB")
        (Ok (SInfo "db" ""))
        (if (eatWord p "DATABASE")
          (Ok (SInfo "db" ""))
          {
            (let _ (expectWord p "TABLE" "DB or TABLE after INFO FOR")?)
            {
              (let name (parseName p "a table name")?)
              (Ok (SInfo "table" name))
            }
          }))
    }
  })

(:: parseShow (-> Ps (Result Stmt Error)))
(fn (parseShow p)
  {
    (advance p)
    {
      (let _ (expectWord p "CHANGES" "CHANGES after SHOW")?)
      {
        (let _ (expectWord p "FOR" "FOR after SHOW CHANGES")?)
        {
          (let _ (expectWord p "TABLE" "TABLE after SHOW CHANGES FOR")?)
          {
            (let name (parseName p "a table name")?)
            {
              (let since
                (if (eatWord p "SINCE")
                  {
                    (let e (parseExpr p 0)?)
                    (Some e)
                  }
                  None))
              {
                (let limit
                  (if (eatWord p "LIMIT")
                    {
                      (let e (parseExpr p 0)?)
                      (Some e)
                    }
                    None))
                (Ok (SShow name since limit))
              }
            }
          }
        }
      }
    }
  })

; ------------------------------------------------------------------
; SELECT.
; ------------------------------------------------------------------
(:: parseSelect (-> Ps (Result Select Error)))
(fn (parseSelect p)
  {
    (advance p)
    (parseSelectFrom p)
  })

; A SELECT from just after its word.
(:: parseSelectFrom (-> Ps (Result Select Error)))
(fn (parseSelectFrom p)
  {
    (let isValue (eatWord p "VALUE"))
    {
      (let projs (parseProjs p isValue)?)
      {
        (let omit (parseOmit p)?)
        {
          (let targets
            (if (eatWord p "FROM")
              (parseTargets p)?
              vecNew))
          {
            (let wh (parseWhere p)?)
            {
              (let group (parseGroup p)?)
              {
                (let order (parseOrder p)?)
                {
                  (let limit (parseLimitStart p "LIMIT")?)
                  {
                    (let start (parseLimitStart p "START")?)
                    {
                      (let fetch (parseFetch p)?)
                      (Ok
                        (Select
                          :value isValue
                          :projs projs
                          :omit omit
                          :targets targets
                          :where wh
                          :group group
                          :order order
                          :limit limit
                          :start start
                          :fetch fetch))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

(:: parseProjs (-> Ps Bool (Result (Vec Proj) Error)))
(fn (parseProjs p isValue)
  {
    (let out vecNew)
    {
      (let _ (parseProjInto p out isValue)?)
      (if isValue
        (Ok out)
        {
          (while (eatKind p tkComma)
            {
              (let _ (parseProjInto p out false)?)
              0
            })
          (Ok out)
        })
    }
  })

(:: parseProjInto (-> Ps (Vec Proj) Bool (Result Int Error)))
(fn (parseProjInto p out isValue)
  (if (&& (! isValue) (eatKind p tkStar))
    {
      (vecPush out (Proj :star true :expr (ELit VNone) :alias ""))
      (Ok 0)
    }
    {
      (let e (parseExpr p 0)?)
      {
        (let alias
          (if (eatWord p "AS")
            (parseName p "a name after AS")?
            ""))
        {
          (vecPush out (Proj :star false :expr e :alias alias))
          (Ok 0)
        }
      }
    }))

(:: parseOmit (-> Ps (Result (Vec String) Error)))
(fn (parseOmit p)
  (if (! (eatWord p "OMIT"))
    (Ok vecNew)
    (parseNameList p "a field to omit")))

(:: parseFetch (-> Ps (Result (Vec String) Error)))
(fn (parseFetch p)
  (if (! (eatWord p "FETCH"))
    (Ok vecNew)
    (parseNameList p "a field to fetch")))

(:: parseNameList (-> Ps String (Result (Vec String) Error)))
(fn (parseNameList p what)
  {
    (let out vecNew)
    {
      (vecPush out (parseName p what)?)
      {
        (while (eatKind p tkComma)
          (vecPush out (parseName p what)?))
        (Ok out)
      }
    }
  })

; What a statement works on: expressions read as targets, where a
; bare name names its table.
(:: parseTargets (-> Ps (Result (Vec Expr) Error)))
(fn (parseTargets p)
  {
    (let out vecNew)
    {
      (vecPush out (targetOf (parseExpr p 0)?))
      {
        (while (eatKind p tkComma)
          (vecPush out (targetOf (parseExpr p 0)?)))
        (Ok out)
      }
    }
  })

; Read an expression as a target: a name is its table, and a path
; from a name starts at that table's records.
(:: targetOf (-> Expr Expr))
(fn (targetOf e)
  (match e
    ((EName n) (ETable n))
    ((EPath base steps)
      (match base
        ((EName n) (EPath (ETable n) steps))
        (_ e))
    )
    (_ e)))

(:: parseWhere (-> Ps (Result (Option Expr) Error)))
(fn (parseWhere p)
  (if (eatWord p "WHERE")
    {
      (let e (parseExpr p 0)?)
      (Ok (Some e))
    }
    (Ok None)))

(:: parseGroup (-> Ps (Result (Vec Expr) Error)))
(fn (parseGroup p)
  (if (! (eatWord p "GROUP"))
    (Ok vecNew)
    {
      (eatWord p "BY")
      (parseExprList p)
    }))

(:: parseExprList (-> Ps (Result (Vec Expr) Error)))
(fn (parseExprList p)
  {
    (let out vecNew)
    {
      (vecPush out (parseExpr p 0)?)
      {
        (while (eatKind p tkComma)
          (vecPush out (parseExpr p 0)?))
        (Ok out)
      }
    }
  })

(:: parseOrder (-> Ps (Result (Vec Order) Error)))
(fn (parseOrder p)
  (if (! (eatWord p "ORDER"))
    (Ok vecNew)
    {
      (eatWord p "BY")
      {
        (let out vecNew)
        {
          {
            (let _ (parseOrderInto p out)?)
            0
          }
          {
            (while (eatKind p tkComma)
              {
                (let _ (parseOrderInto p out)?)
                0
              })
            (Ok out)
          }
        }
      }
    }))

(:: parseOrderInto (-> Ps (Vec Order) (Result Int Error)))
(fn (parseOrderInto p out)
  {
    (let e (parseExpr p 0)?)
    {
      (let desc
        (if (eatWord p "DESC")
          true
          {
            (eatWord p "ASC")
            false
          }))
      {
        (vecPush out (Order :expr e :desc desc))
        (Ok 0)
      }
    }
  })

(:: parseLimitStart (-> Ps String (Result (Option Expr) Error)))
(fn (parseLimitStart p w)
  (if (eatWord p w)
    {
      (let e (parseExpr p 0)?)
      (Ok (Some e))
    }
    (Ok None)))

; ------------------------------------------------------------------
; Writes.
; ------------------------------------------------------------------
; kind: 0 CREATE, 1 UPDATE, 2 UPSERT, 3 DELETE.
(:: parseWrite (-> Ps Int (Result Stmt Error)))
(fn (parseWrite p kind)
  {
    (advance p)
    {
      (let only (eatWord p "ONLY"))
      {
        (let targets (parseTargets p)?)
        {
          (let content
            (if (== kind 3)
              CNone
              (parseContent p)?))
          {
            (let wh (parseWhere p)?)
            {
              (let ret (parseReturn p)?)
              {
                (let w (Write :only only :targets targets :content content :where wh :return ret))
                (Ok
                  (if (== kind 0)
                      (SCreate w)
                    (== kind 1)
                      (SUpdate w)
                    (== kind 2)
                      (SUpsert w)
                    (SDelete w)))
              }
            }
          }
        }
      }
    }
  })

(:: parseContent (-> Ps (Result Content Error)))
(fn (parseContent p)
  (if (eatWord p "CONTENT")
      {
        (let e (parseExpr p 0)?)
        (Ok (CContent e))
      }
    (atWord p "MERGE")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (Ok (CMerge e))
        }
      }
    (atWord p "PATCH")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (Ok (CPatch e))
        }
      }
    (atWord p "SET")
      {
        (advance p)
        {
          (let assigns (parseAssigns p)?)
          (Ok (CSet assigns))
        }
      }
    (Ok CNone)))

(:: parseAssigns (-> Ps (Result (Vec Assign) Error)))
(fn (parseAssigns p)
  {
    (let out vecNew)
    {
      {
        (let _ (parseAssignInto p out)?)
        0
      }
      {
        (while (eatKind p tkComma)
          {
            (let _ (parseAssignInto p out)?)
            0
          })
        (Ok out)
      }
    }
  })

(:: parseAssignInto (-> Ps (Vec Assign) (Result Int Error)))
(fn (parseAssignInto p out)
  {
    (let path (parsePathName p "a field to set")?)
    {
      (let op
        (if (eatKind p tkEq)
            "="
          (eatKind p tkPlusEq)
            "+="
          (eatKind p tkMinusEq)
            "-="
          "?"))
      (if (strEq op "?")
        (expected p "= after the field")
        {
          (let e (parseExpr p 0)?)
          {
            (vecPush out (Assign :path path :op op :expr e))
            (Ok 0)
          }
        })
    }
  })

; A dotted name: `address.city`.
(:: parsePathName (-> Ps String (Result String Error)))
(fn (parsePathName p what)
  {
    (let first (parseName p what)?)
    {
      (let mut path first)
      {
        (while (eatKind p tkDot)
          (if (eatKind p tkStar)
            (set path (concat path ".*"))
            (set path (concat (concat path ".") (parseName p "a field name after .")?))))
        (Ok path)
      }
    }
  })

; A write's RETURN clause; no clause answers AFTER.
(:: parseReturn (-> Ps (Result Return Error)))
(fn (parseReturn p)
  (if (! (atWord p "RETURN"))
    (Ok RetAfter)
    ; RETURN only starts a clause when what follows it can end the
    ; statement: NONE, BEFORE, AFTER, DIFF, VALUE, or fields. In a
    ; script `...; RETURN 1` the semicolon already ended the write.
    {
      (advance p)
      (if (eatWord p "NONE")
          (Ok RetNone)
        (eatWord p "BEFORE")
          (Ok RetBefore)
        (eatWord p "AFTER")
          (Ok RetAfter)
        (eatWord p "DIFF")
          (Ok RetDiff)
        (eatWord p "VALUE")
          {
            (let e (parseExpr p 0)?)
            (Ok (RetValue e))
          }
        {
          (let projs (parseProjs p false)?)
          (Ok (RetFields projs))
        })
    }))

(:: parseRelate (-> Ps (Result Stmt Error)))
(fn (parseRelate p)
  {
    (advance p)
    {
      (let only (eatWord p "ONLY"))
      {
        (let from (targetOf (parseSide p)?))
        {
          (let _ (expectKind p tkArrowR "-> after the record")?)
          {
            (let edge (parseName p "an edge table")?)
            {
              (let edgeId
                (if (eatKind p tkColon)
                  {
                    (let e (parseKey p)?)
                    (Some e)
                  }
                  None))
              {
                (let _ (expectKind p tkArrowR "-> after the edge")?)
                {
                  (let to (targetOf (parseSide p)?))
                  {
                    (let content (parseContent p)?)
                    {
                      (let ret (parseReturn p)?)
                      (Ok
                        (SRelate
                          (Relate
                            :only only
                            :from from
                            :edge edge
                            :edgeId edgeId
                            :to to
                            :content content
                            :return ret)))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; One side of a RELATE: a primary with field and index steps, but no
; graph steps, so the `->` that follows belongs to the statement.
(:: parseSide (-> Ps (Result Expr Error)))
(fn (parseSide p)
  {
    (let e (parsePrimary p 0)?)
    (parseSteps p e 0 false)
  })

(:: parseInsert (-> Ps (Result Stmt Error)))
(fn (parseInsert p)
  {
    (advance p)
    {
      (eatWord p "INTO")
      (if (|| (atKind p tkLBrace) (atKind p tkLBracket))
        {
          (let data (parseExpr p 0)?)
          {
            (let dup (parseOnDuplicate p)?)
            {
              (let ret (parseReturn p)?)
              (Ok (SInsert "" data dup ret))
            }
          }
        }
        {
          (let table (parseName p "a table to insert into")?)
          {
            (let data (parseExpr p 0)?)
            {
              (let dup (parseOnDuplicate p)?)
              {
                (let ret (parseReturn p)?)
                (Ok (SInsert table data dup ret))
              }
            }
          }
        })
    }
  })

(:: parseOnDuplicate (-> Ps (Result (Vec Assign) Error)))
(fn (parseOnDuplicate p)
  (if (! (eatWord p "ON"))
    (Ok vecNew)
    {
      (let _ (expectWord p "DUPLICATE" "DUPLICATE after ON")?)
      {
        (let _ (expectWord p "KEY" "KEY after DUPLICATE")?)
        {
          (let _ (expectWord p "UPDATE" "UPDATE after KEY")?)
          (parseAssigns p)
        }
      }
    }))

; ------------------------------------------------------------------
; Definitions.
; ------------------------------------------------------------------
; The `IF NOT EXISTS` or `OVERWRITE` a definition may carry, as
; (ifNotExists, overwrite) packed: 1 then 2 as bits of one int.
(:: parseIfClause (-> Ps (Result Int Error)))
(fn (parseIfClause p)
  (if (eatWord p "OVERWRITE")
    (Ok 2)
    (if (eatWord p "IF")
      {
        (let _ (expectWord p "NOT" "NOT after IF")?)
        {
          (let _ (expectWord p "EXISTS" "EXISTS after NOT")?)
          (Ok 1)
        }
      }
      (Ok 0))))

(:: parseDefine (-> Ps (Result Stmt Error)))
(fn (parseDefine p)
  {
    (advance p)
    (if (atWord p "TABLE")
        (parseDefineTable p)
      (atWord p "FIELD")
        (parseDefineField p)
      (atWord p "INDEX")
        (parseDefineIndex p)
      (atWord p "EVENT")
        (parseDefineEvent p)
      (atWord p "FUNCTION")
        (parseDefineFunction p)
      (expected p "TABLE, FIELD, INDEX, EVENT or FUNCTION after DEFINE"))
  })

(:: parseDefineTable (-> Ps (Result Stmt Error)))
(fn (parseDefineTable p)
  {
    (advance p)
    {
      (let mode (parseIfClause p)?)
      {
        (let name (parseName p "a table name")?)
        {
          (let mut schema 0)
          (let mut feed false)
          {
            (while (|| (atWord p "SCHEMAFULL") (|| (atWord p "SCHEMALESS") (atWord p "CHANGEFEED")))
              (if (eatWord p "SCHEMAFULL")
                (set schema 1)
                (if (eatWord p "SCHEMALESS")
                  (set schema 2)
                  {
                    (advance p)
                    (set feed true)
                  })))
            (Ok (SDefineTable name (== mode 1) (== mode 2) schema feed))
          }
        }
      }
    }
  })

(:: parseDefineField (-> Ps (Result Stmt Error)))
(fn (parseDefineField p)
  {
    (advance p)
    {
      (let mode (parseIfClause p)?)
      {
        (let name (parsePathName p "a field name")?)
        {
          (let _ (expectWord p "ON" "ON after the field")?)
          {
            (eatWord p "TABLE")
            {
              (let table (parseName p "a table name")?)
              (parseFieldClauses p name table mode None None None None false)
            }
          }
        }
      }
    }
  })

(:: parseFieldClauses
  (-> Ps String String Int (Option TypeExpr) (Option Expr) (Option Expr) (Option Expr) Bool
    (Result Stmt Error)))
(fn (parseFieldClauses p name table mode ftype dflt value assert readonly)
  (if (eatWord p "TYPE")
      {
        (let t (parseType p)?)
        (parseFieldClauses p name table mode (Some t) dflt value assert readonly)
      }
    (atWord p "DEFAULT")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (parseFieldClauses p name table mode ftype (Some e) value assert readonly)
        }
      }
    (atWord p "VALUE")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (parseFieldClauses p name table mode ftype dflt (Some e) assert readonly)
        }
      }
    (atWord p "ASSERT")
      {
        (advance p)
        {
          (let e (parseExpr p 0)?)
          (parseFieldClauses p name table mode ftype dflt value (Some e) readonly)
        }
      }
    (atWord p "READONLY")
      {
        (advance p)
        (parseFieldClauses p name table mode ftype dflt value assert true)
      }
    (Ok (SDefineField name table (== mode 1) (== mode 2) ftype dflt value assert readonly))))

(:: parseType (-> Ps (Result TypeExpr Error)))
(fn (parseType p)
  {
    (let name (parseName p "a type")?)
    (if (wordEq name "option")
        {
          (let inner (parseTypeArg p name)?)
          (Ok (TyOption inner))
        }
      (wordEq name "array")
        (if (atKind p tkLt)
          {
            (let inner (parseTypeArg p name)?)
            (Ok (TyArrayOf inner))
          }
          (Ok TyArray))
      (wordEq name "record")
        (if (atKind p tkLt)
          {
            (advance p)
            {
              (let table (parseName p "a table name")?)
              {
                (let _ (expectKind p tkGt "a > after the table")?)
                (Ok (TyRecordOf table))
              }
            }
          }
          (Ok TyRecord))
      (wordEq name "any")
        (Ok TyAny)
      (wordEq name "bool")
        (Ok TyBool)
      (wordEq name "int")
        (Ok TyInt)
      (wordEq name "float")
        (Ok TyFloat)
      (wordEq name "number")
        (Ok TyFloat)
      (wordEq name "text")
        (Ok TyText)
      (wordEq name "string")
        (Ok TyText)
      (wordEq name "bytes")
        (Ok TyBytes)
      (wordEq name "datetime")
        (Ok TyDatetime)
      (wordEq name "duration")
        (Ok TyDuration)
      (wordEq name "uuid")
        (Ok TyUuid)
      (wordEq name "object")
        (Ok TyObject)
      (synErrAt p.src (lastStart p) (concat "no such type: " name)))
  })

(:: parseTypeArg (-> Ps String (Result TypeExpr Error)))
(fn (parseTypeArg p name)
  {
    (let _ (expectKind p tkLt (concat "a <type> after " name))?)
    {
      (let inner (parseType p)?)
      {
        (let _ (expectKind p tkGt "a > after the type")?)
        (Ok inner)
      }
    }
  })

(:: parseDefineIndex (-> Ps (Result Stmt Error)))
(fn (parseDefineIndex p)
  {
    (advance p)
    {
      (let mode (parseIfClause p)?)
      {
        (let name (parseName p "an index name")?)
        {
          (let _ (expectWord p "ON" "ON after the index")?)
          {
            (eatWord p "TABLE")
            {
              (let table (parseName p "a table name")?)
              (if (! (|| (eatWord p "FIELDS") (eatWord p "COLUMNS")))
                (expected p "FIELDS before the fields")
                {
                  (let fields (parsePathList p)?)
                  {
                    (let unique (eatWord p "UNIQUE"))
                    (Ok (SDefineIndex name table (== mode 1) (== mode 2) fields unique))
                  }
                })
            }
          }
        }
      }
    }
  })

(:: parsePathList (-> Ps (Result (Vec String) Error)))
(fn (parsePathList p)
  {
    (let out vecNew)
    {
      (vecPush out (parsePathName p "a field name")?)
      {
        (while (eatKind p tkComma)
          (vecPush out (parsePathName p "a field name")?))
        (Ok out)
      }
    }
  })

(:: parseDefineEvent (-> Ps (Result Stmt Error)))
(fn (parseDefineEvent p)
  {
    (advance p)
    {
      (let mode (parseIfClause p)?)
      {
        (let name (parseName p "an event name")?)
        {
          (let _ (expectWord p "ON" "ON after the event")?)
          {
            (eatWord p "TABLE")
            {
              (let table (parseName p "a table name")?)
              {
                (let _ (expectWord p "WHEN" "WHEN before the condition")?)
                {
                  (let cond (parseExpr p 0)?)
                  {
                    (let _ (expectWord p "THEN" "THEN after the condition")?)
                    {
                      (let body
                        (if (atKind p tkLBrace)
                          (parseBlock p)?
                          {
                            (let s (parseStmt p)?)
                            (vecPush vecNew s)
                          }))
                      (Ok (SDefineEvent name table (== mode 1) (== mode 2) cond body))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

(:: parseDefineFunction (-> Ps (Result Stmt Error)))
(fn (parseDefineFunction p)
  {
    (advance p)
    {
      (let mode (parseIfClause p)?)
      {
        (let name (parseFnName p)?)
        {
          (let _ (expectKind p tkLParen "( before the parameters")?)
          {
            (let params (parseParamDefs p)?)
            {
              (let _ (expectKind p tkRParen ") after the parameters")?)
              {
                (let body (parseBlock p)?)
                (Ok (SDefineFunction name (== mode 1) (== mode 2) params body))
              }
            }
          }
        }
      }
    }
  })

; A function's name: `fn::greet`, or a bare `greet`.
(:: parseFnName (-> Ps (Result String Error)))
(fn (parseFnName p)
  {
    (let first (parseName p "a function name")?)
    (if (eatKind p tkColonColon)
      (if (wordEq first "fn")
        (parseName p "a function name after fn::")
        (synErrAt p.src (lastStart p) "a defined function is fn::name"))
      (Ok first))
  })

(:: parseParamDefs (-> Ps (Result (Vec ParamDef) Error)))
(fn (parseParamDefs p)
  {
    (let out vecNew)
    (if (atKind p tkRParen)
      (Ok out)
      {
        {
          (let _ (parseParamDefInto p out)?)
          0
        }
        {
          (while (eatKind p tkComma)
            {
              (let _ (parseParamDefInto p out)?)
              0
            })
          (Ok out)
        }
      })
  })

(:: parseParamDefInto (-> Ps (Vec ParamDef) (Result Int Error)))
(fn (parseParamDefInto p out)
  {
    (let t (expectKind p tkParam "a $parameter")?)
    {
      (let ftype
        (if (eatKind p tkColon)
          {
            (let ty (parseType p)?)
            (Some ty)
          }
          None))
      {
        (vecPush out (ParamDef :name t.text :ftype ftype))
        (Ok 0)
      }
    }
  })

(:: parseRemove (-> Ps (Result Stmt Error)))
(fn (parseRemove p)
  {
    (advance p)
    (if (atWord p "TABLE")
        {
          (advance p)
          {
            (let ifExists (parseIfExists p)?)
            {
              (let name (parseName p "a table name")?)
              (Ok (SRemove "table" name "" ifExists))
            }
          }
        }
      (atWord p "FIELD")
        (parseRemoveOn p "field" true)
      (atWord p "INDEX")
        (parseRemoveOn p "index" false)
      (atWord p "EVENT")
        (parseRemoveOn p "event" false)
      (atWord p "FUNCTION")
        {
          (advance p)
          {
            (let ifExists (parseIfExists p)?)
            {
              (let name (parseFnName p)?)
              (Ok (SRemove "function" name "" ifExists))
            }
          }
        }
      (expected p "TABLE, FIELD, INDEX, EVENT or FUNCTION after REMOVE"))
  })

(:: parseRemoveOn (-> Ps String Bool (Result Stmt Error)))
(fn (parseRemoveOn p kind isField)
  {
    (advance p)
    {
      (let ifExists (parseIfExists p)?)
      {
        (let name
          (if isField
            (parsePathName p "a field name")?
            (parseName p "a name")?))
        {
          (let _ (expectWord p "ON" "ON before the table")?)
          {
            (eatWord p "TABLE")
            {
              (let table (parseName p "a table name")?)
              (Ok (SRemove kind name table ifExists))
            }
          }
        }
      }
    }
  })

(:: parseIfExists (-> Ps (Result Bool Error)))
(fn (parseIfExists p)
  (if (eatWord p "IF")
    {
      (let _ (expectWord p "EXISTS" "EXISTS after IF")?)
      (Ok true)
    }
    (Ok false)))

; ------------------------------------------------------------------
; Expressions. Precedence, weakest first: ?? - OR - AND -
; comparison - additive - multiplicative - unary and cast - path.
; ------------------------------------------------------------------
(:: parseExpr (-> Ps Int (Result Expr Error)))
(fn (parseExpr p depth)
  (if (> depth axqlMaxDepth)
    (synErrAt p.src (peekStart p) "this expression nests too deep")
    (parseCoalesce p depth)))

(:: parseCoalesce (-> Ps Int (Result Expr Error)))
(fn (parseCoalesce p depth)
  {
    (let left (parseOr p depth)?)
    (if (eatKind p tkQQ)
      {
        (let _ (countOp p)?)
        {
          (let right (parseCoalesce p (+ depth 1))?)
          (Ok (EBinary "??" left right))
        }
      }
      (Ok left))
  })

(:: parseOr (-> Ps Int (Result Expr Error)))
(fn (parseOr p depth)
  {
    (let mut left (parseAnd p depth)?)
    (let mut failure None)
    {
      (while (&& (isNone failure) (atWord p "OR"))
        {
          (advance p)
          (match (parseAnd p (+ depth 1))
            ((Ok right)
              (match (countOp p)
                ((Ok _)
                  (set left (EBinary "or" left right))
                )
                ((Err e)
                  (set failure (Some e))
                ))
            )
            ((Err e)
              (set failure (Some e))
            ))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok left)))
    }
  })

(:: parseAnd (-> Ps Int (Result Expr Error)))
(fn (parseAnd p depth)
  {
    (let mut left (parseCompare p depth)?)
    (let mut failure None)
    {
      (while (&& (isNone failure) (atWord p "AND"))
        {
          (advance p)
          (match (parseCompare p (+ depth 1))
            ((Ok right)
              (match (countOp p)
                ((Ok _)
                  (set left (EBinary "and" left right))
                )
                ((Err e)
                  (set failure (Some e))
                ))
            )
            ((Err e)
              (set failure (Some e))
            ))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok left)))
    }
  })

; The comparison operator at hand, or "" when there is none. Eats it.
(:: eatCompare (-> Ps String))
(fn (eatCompare p)
  (if (eatKind p tkEq)
      "="
    (eatKind p tkNe)
      "!="
    (eatKind p tkAnyEq)
      "?="
    (eatKind p tkAllEq)
      "*="
    (eatKind p tkLe)
      "<="
    (eatKind p tkGe)
      ">="
    (eatKind p tkLt)
      "<"
    (eatKind p tkGt)
      ">"
    (atWord p "IN")
      {
        (advance p)
        "in"
      }
    (atWord p "CONTAINS")
      {
        (advance p)
        "contains"
      }
    (atWord p "INSIDE")
      {
        (advance p)
        "inside"
      }
    (atWord p "OUTSIDE")
      {
        (advance p)
        "outside"
      }
    (atWord p "IS")
      {
        (advance p)
        (if (eatWord p "NOT")
          "isnot"
          "is")
      }
    ""))

(:: parseCompare (-> Ps Int (Result Expr Error)))
(fn (parseCompare p depth)
  {
    (let left (parseAdd p depth)?)
    {
      (let negated
        (if (&& (atWord p "NOT")
              (|| (wordAt p 1 "IN") (|| (wordAt p 1 "INSIDE") (wordAt p 1 "CONTAINS"))))
          {
            (advance p)
            true
          }
          false))
      {
        (let op (eatCompare p))
        (if (strIsEmpty op)
          (Ok left)
          {
            (let _ (countOp p)?)
            {
              (let right (parseAdd p (+ depth 1))?)
              {
                (let e (EBinary op left right))
                (Ok
                  (if negated
                    (EUnary "not" e)
                    e))
              }
            }
          })
      }
    }
  })

(:: parseAdd (-> Ps Int (Result Expr Error)))
(fn (parseAdd p depth)
  {
    (let mut left (parseMul p depth)?)
    (let mut failure None)
    {
      (while (&& (isNone failure) (|| (atKind p tkPlus) (atKind p tkMinus)))
        {
          (let op
            (if (eatKind p tkPlus)
              "+"
              {
                (advance p)
                "-"
              }))
          (match (parseMul p (+ depth 1))
            ((Ok right)
              (match (countOp p)
                ((Ok _)
                  (set left (EBinary op left right))
                )
                ((Err e)
                  (set failure (Some e))
                ))
            )
            ((Err e)
              (set failure (Some e))
            ))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok left)))
    }
  })

(:: parseMul (-> Ps Int (Result Expr Error)))
(fn (parseMul p depth)
  {
    (let mut left (parseUnary p depth)?)
    (let mut failure None)
    {
      (while (&& (isNone failure)
               (|| (atKind p tkStar) (|| (atKind p tkSlash) (atKind p tkPercent))))
        {
          (let op
            (if (eatKind p tkStar)
              "*"
              (if (eatKind p tkSlash)
                "/"
                {
                  (advance p)
                  "%"
                })))
          (match (parseUnary p (+ depth 1))
            ((Ok right)
              (match (countOp p)
                ((Ok _)
                  (set left (EBinary op left right))
                )
                ((Err e)
                  (set failure (Some e))
                ))
            )
            ((Err e)
              (set failure (Some e))
            ))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok left)))
    }
  })

(:: parseUnary (-> Ps Int (Result Expr Error)))
(fn (parseUnary p depth)
  (if (eatKind p tkMinus)
      {
        (let _ (countOp p)?)
        (if (atKind p tkIntMin)
          {
            (advance p)
            (parseSteps p (ELit (VInt intMin)) depth true)
          }
          {
            (let e (parseUnary p (+ depth 1))?)
            (Ok (EUnary "-" e))
          })
      }
    (eatKind p tkPlus)
      (parseUnary p (+ depth 1))
    (eatKind p tkBang)
      {
        (let _ (countOp p)?)
        {
          (let e (parseUnary p (+ depth 1))?)
          (Ok (EUnary "not" e))
        }
      }
    (atWord p "NOT")
      {
        (advance p)
        {
          (let _ (countOp p)?)
          {
            (let e (parseUnary p (+ depth 1))?)
            (Ok (EUnary "not" e))
          }
        }
      }
    (atKind p tkLt)
      (if (castAhead p)
        {
          (advance p)
          {
            (let t (parseType p)?)
            {
              (let _ (expectKind p tkGt "a > to close the cast")?)
              {
                (let _ (countOp p)?)
                {
                  (let e (parseUnary p (+ depth 1))?)
                  (Ok (ECast t e))
                }
              }
            }
          }
        }
        (parsePostfix p depth))
    (parsePostfix p depth)))

; Whether the `<` at hand opens a cast: `<` a type word or `option<
; ...>`, then a `>` that isn't half of an arrow.
(:: castAhead (-> Ps Bool))
(fn (castAhead p)
  {
    (let t (peekAt p 1))
    (&& (== t.kind tkIdent) (isTypeWord t.text))
  })

(:: isTypeWord (-> String Bool))
(fn (isTypeWord w)
  (|| (wordEq w "any")
    (|| (wordEq w "bool")
      (|| (wordEq w "int")
        (|| (wordEq w "float")
          (|| (wordEq w "number")
            (|| (wordEq w "text")
              (|| (wordEq w "string")
                (|| (wordEq w "bytes")
                  (|| (wordEq w "datetime")
                    (|| (wordEq w "duration")
                      (|| (wordEq w "uuid")
                        (|| (wordEq w "array")
                          (|| (wordEq w "object")
                            (|| (wordEq w "record") (wordEq w "option"))))))))))))))))

(:: parsePostfix (-> Ps Int (Result Expr Error)))
(fn (parsePostfix p depth)
  {
    (let e (parsePrimary p depth)?)
    (parseSteps p e depth true)
  })

; The path steps after a primary. `graph` says arrows may follow.
(:: parseSteps (-> Ps Expr Int Bool (Result Expr Error)))
(fn (parseSteps p base depth graph)
  {
    (let steps vecNew)
    (let mut failure None)
    {
      (while (&& (isNone failure) (stepAhead p graph))
        (match (parseStep p depth)
          ((Ok s) (vecPush steps s))
          ((Err e)
            (set failure (Some e))
          )))
      (match failure
        ((Some e) (Err e))
        ((None)
          (Ok
            (if (== (vecLen steps) 0)
              base
              (EPath base steps)))
        ))
    }
  })

(:: stepAhead (-> Ps Bool Bool))
(fn (stepAhead p graph)
  (|| (atKind p tkDot)
    (|| (atKind p tkLBracket)
      (&& graph (|| (atKind p tkArrowR) (|| (atKind p tkArrowL) (atKind p tkArrowB)))))))

(:: parseStep (-> Ps Int (Result Step Error)))
(fn (parseStep p depth)
  (if (eatKind p tkDot)
      (if (eatKind p tkStar)
        (Ok SDeref)
        {
          (let name (parseName p "a field name after .")?)
          (Ok (SField name))
        })
    (eatKind p tkLBracket)
      {
        (let e (parseExpr p (+ depth 1))?)
        {
          (let _ (expectKind p tkRBracket "a ] after the index")?)
          (Ok (SIndex e))
        }
      }
    (parseGraphStep p)))

(:: parseGraphStep (-> Ps (Result Step Error)))
(fn (parseGraphStep p)
  {
    (let dir
      (if (eatKind p tkArrowR)
          0
        (eatKind p tkArrowL)
          1
        (eatKind p tkArrowB)
          2
        -1))
    (if (< dir 0)
      (expected p "a path step")
      {
        (let edge
          (if (eatKind p tkStar)
            ""
            (parseName p "an edge table after the arrow")?))
        {
          (let arrowKind
            (if (== dir 0)
                tkArrowR
              (== dir 1)
                tkArrowL
              tkArrowB))
          {
            (let next
              (if (eatKind p arrowKind)
                (if (eatKind p tkStar)
                  ""
                  (parseName p "a table after the arrow")?)
                ""))
            (Ok (SGraph (Graph :dir dir :edge edge :next next)))
          }
        }
      })
  })

; ------------------------------------------------------------------
; Primaries.
; ------------------------------------------------------------------
(:: parsePrimary (-> Ps Int (Result Expr Error)))
(fn (parsePrimary p depth)
  {
    (let t (peek p))
    (if (== t.kind tkInt)
        {
          (advance p)
          (intLiteral p t)
        }
      (== t.kind tkIntMin)
        (synErrAt p.src t.start "this integer is too large; the largest is 9223372036854775807")
      (== t.kind tkFloat)
        {
          (advance p)
          (match (floatParse t.text)
            ((Ok x)
              (if (floatIsNan x)
                (synErrAt p.src t.start "a float literal can't be a NaN")
                (Ok (ELit (VFloat x))))
            )
            ((Err _) (synErrAt p.src t.start "this isn't a number")))
        }
      (== t.kind tkStr)
        {
          (advance p)
          (Ok (ELit (VText t.text)))
        }
      (== t.kind tkBytes)
        {
          (advance p)
          (Ok (ELit (VBytes t.text)))
        }
      (== t.kind tkDuration)
        {
          (advance p)
          (durationLiteral p t)
        }
      (== t.kind tkDatetimeLit)
        {
          (advance p)
          (Ok (ECast TyDatetime (ELit (VText t.text))))
        }
      (== t.kind tkUuidLit)
        {
          (advance p)
          (Ok (ECast TyUuid (ELit (VText t.text))))
        }
      (== t.kind tkParam)
        {
          (advance p)
          {
            (noteParam p t.text)
            (Ok (EParam t.text))
          }
        }
      (== t.kind tkLBracket)
        (parseArray p depth)
      (== t.kind tkLBrace)
        (parseObject p depth)
      (== t.kind tkLParen)
        (parseParen p depth)
      (== t.kind tkIdent)
        (parseNamePrimary p depth)
      (|| (== t.kind tkArrowR) (|| (== t.kind tkArrowL) (== t.kind tkArrowB)))
        ; A path that starts with an arrow starts at the record at
        ; hand: `->wrote->post` is `$this->wrote->post`.
        (Ok (EParam "this"))
      (expected p "a value"))
  })

(:: intLiteral (-> Ps Tok (Result Expr Error)))
(fn (intLiteral p t)
  (match (parseIntText t.text)
    ((Some n) (Ok (ELit (VInt n))))
    ((None)
      (synErrAt p.src t.start "this integer is too large; the largest is 9223372036854775807")
    )))

; The int a run of digits names, read by piling up below zero so the
; most negative value is reachable. `None` past the range.
(:: parseIntText (-> String (Option Int)))
(fn (parseIntText text)
  {
    (let mut acc 0)
    (let mut ok true)
    {
      (for i in 0..(strLen text)
        {
          (let d (- (strByte text i) 48))
          (if (< acc -922337203685477580)
            (set ok false)
            {
              (set acc (* acc 10))
              (if (< acc (+ intMin d))
                (set ok false)
                (set acc (- acc d)))
            })
        })
      (if (! ok)
        None
        (if (== acc intMin)
          ; 9223372036854775808 itself: too large standing alone.
          None
          (Some (- 0 acc))))
    }
  })

(:: durationLiteral (-> Ps Tok (Result Expr Error)))
(fn (durationLiteral p t)
  (match (axqlParseDuration t.text)
    ((Some micros) (Ok (ELit (VDuration micros))))
    ((None)
      (synErrAt p.src t.start "a duration is digits and units (y w d h m s ms us ns), as 1h30m")
    )))

; The length of `1h30m` and its kin, in microseconds. A year is 365
; days, and nanoseconds below a microsecond are dropped. `None` for
; a shape that isn't a duration, or one that overflows.
(pub :: axqlParseDuration (-> String (Option Int)))
(pub fn (axqlParseDuration text)
  {
    (let n (strLen text))
    (let mut i 0)
    (let mut total 0)
    (let mut ok (> n 0))
    {
      (while (&& ok (< i n))
        {
          (let num (durationDigits text i))
          (match num
            ((None)
              (set ok false)
            )
            ((Some digits)
              {
                (set i (+ i digits))
                (match (durationUnitAt text i n)
                  ((None)
                    (set ok false)
                  )
                  ((Some unit)
                    {
                      (let amount (durationDigitsValue text (- i digits) digits))
                      {
                        (set i (+ i (durationUnitLen unit)))
                        (match amount
                          ((None)
                            (set ok false)
                          )
                          ((Some a)
                            {
                              (let factor (durationFactor unit))
                              (if (> a (/ 9223372036854775807 factor))
                                (set ok false)
                                {
                                  (let add (* a factor))
                                  (if (> add (- 9223372036854775807 total))
                                    (set ok false)
                                    (set total (+ total add)))
                                })
                            }
                          ))
                      }
                    }
                  ))
              }
            ))
        })
      (if ok
        (Some total)
        None)
    }
  })

; The digit count of the run at `i`, or `None` when there is none.
(:: durationDigits (-> String Int (Option Int)))
(fn (durationDigits text i)
  {
    (let mut j i)
    {
      (while (&& (< j (strLen text)) (strIsDigit (strByte text j)))
        (set j (+ j 1)))
      (if (== j i)
        None
        (Some (- j i)))
    }
  })

(:: durationDigitsValue (-> String Int Int (Option Int)))
(fn (durationDigitsValue text at count)
  (parseIntText (strSlice text at count)))

; The unit at `i` as a code: y w d h m s as themselves, ms 256, us
; 257, ns 258. `None` for anything else.
(:: durationUnitAt (-> String Int Int (Option Int)))
(fn (durationUnitAt text i n)
  (if (>= i n)
    None
    {
      (let c (strByte text i))
      (let two (&& (< (+ i 1) n) (== (strByte text (+ i 1)) 115)))
      (if (&& two (== c 109))
          (Some 256)
        (&& two (== c 117))
          (Some 257)
        (&& two (== c 110))
          (Some 258)
        (|| (== c 121) (|| (== c 119) (|| (== c 100) (|| (== c 104) (|| (== c 109) (== c 115))))))
          (Some c)
        None)
    }))

(:: durationUnitLen (-> Int Int))
(fn (durationUnitLen unit)
  (if (>= unit 256)
    2
    1))

(:: durationFactor (-> Int Int))
(fn (durationFactor unit)
  (if (== unit 121)
      31536000000000
    (== unit 119)
      604800000000
    (== unit 100)
      86400000000
    (== unit 104)
      3600000000
    (== unit 109)
      60000000
    (== unit 115)
      1000000
    (== unit 256)
      1000
    (== unit 257)
      1
    0))

(:: parseArray (-> Ps Int (Result Expr Error)))
(fn (parseArray p depth)
  {
    (advance p)
    {
      (let out vecNew)
      (if (eatKind p tkRBracket)
        (Ok (EArray out))
        {
          (vecPush out (parseExpr p (+ depth 1))?)
          {
            (while (&& (eatKind p tkComma) (! (atKind p tkRBracket)))
              (vecPush out (parseExpr p (+ depth 1))?))
            {
              (let _ (expectKind p tkRBracket "a ] to close the array")?)
              (Ok (EArray out))
            }
          }
        })
    }
  })

(:: parseObject (-> Ps Int (Result Expr Error)))
(fn (parseObject p depth)
  {
    (advance p)
    {
      (let out vecNew)
      (if (eatKind p tkRBrace)
        (Ok (EObject out))
        {
          (let _ (parseObjectField p out depth)?)
          {
            (while (&& (eatKind p tkComma) (! (atKind p tkRBrace)))
              {
                (let _ (parseObjectField p out depth)?)
                0
              })
            {
              (let _ (expectKind p tkRBrace "a } to close the object")?)
              (Ok (EObject out))
            }
          }
        })
    }
  })

(:: parseObjectField (-> Ps (Vec EField) Int (Result Int Error)))
(fn (parseObjectField p out depth)
  {
    (let name
      (if (atKind p tkStr)
        (advText p)
        (parseName p "a field name")?))
    {
      (let _ (expectKind p tkColon "a : after the field")?)
      {
        (let e (parseExpr p (+ depth 1))?)
        {
          (vecPush out (EField :name name :expr e))
          (Ok 0)
        }
      }
    }
  })

(:: parseParen (-> Ps Int (Result Expr Error)))
(fn (parseParen p depth)
  {
    (advance p)
    (if (atWord p "SELECT")
      {
        (let s (parseSelect p)?)
        {
          (let _ (expectKind p tkRParen "a ) after the subquery")?)
          (Ok (ESelect s))
        }
      }
      {
        (let e (parseExpr p (+ depth 1))?)
        {
          (let _ (expectKind p tkRParen "a ) to close the group")?)
          (Ok e)
        }
      })
  })

; A primary that starts with a name: a literal word, an IF, a call,
; a record id, or a field of the record at hand.
(:: parseNamePrimary (-> Ps Int (Result Expr Error)))
(fn (parseNamePrimary p depth)
  {
    (let t (peek p))
    (if (wordEq t.text "true")
        {
          (advance p)
          (Ok (ELit (VBool true)))
        }
      (wordEq t.text "false")
        {
          (advance p)
          (Ok (ELit (VBool false)))
        }
      (wordEq t.text "none")
        {
          (advance p)
          (Ok (ELit VNone))
        }
      (wordEq t.text "IF")
        (parseIfExpr p depth)
      (wordEq t.text "SELECT")
        {
          (let s (parseSelect p)?)
          (Ok (ESelect s))
        }
      (callAhead p)
        (parseCall p depth)
      {
        (advance p)
        (if (eatKind p tkColon)
          {
            (let key (parseKey p)?)
            (Ok (ERecord t.text key))
          }
          (Ok (EName t.text)))
      })
  })

; Whether the name at hand starts a call: `name(` or `name::`.
(:: callAhead (-> Ps Bool))
(fn (callAhead p)
  {
    (let t (peekAt p 1))
    (|| (== t.kind tkLParen) (== t.kind tkColonColon))
  })

(:: parseCall (-> Ps Int (Result Expr Error)))
(fn (parseCall p depth)
  {
    (let mut name (advText p))
    {
      (while (eatKind p tkColonColon)
        (set name (concat (concat name "::") (parseName p "a name after ::")?)))
      {
        (let _ (expectKind p tkLParen "( after the function")?)
        {
          (let args vecNew)
          {
            (let _ (parseArgsInto p args depth)?)
            0
          }
          {
            (let _ (expectKind p tkRParen ") after the arguments")?)
            {
              (let _ (countOp p)?)
              (Ok (ECall name args))
            }
          }
        }
      }
    }
  })

(:: parseArgsInto (-> Ps (Vec Expr) Int (Result Int Error)))
(fn (parseArgsInto p args depth)
  (if (atKind p tkRParen)
    (Ok 0)
    {
      (vecPush args (parseExpr p (+ depth 1))?)
      {
        (while (eatKind p tkComma)
          (vecPush args (parseExpr p (+ depth 1))?))
        (Ok 0)
      }
    }))

; IF as an expression: its arms are blocks, and a block answers its
; last statement's value.
(:: parseIfExpr (-> Ps Int (Result Expr Error)))
(fn (parseIfExpr p depth)
  {
    (advance p)
    {
      (let cond (parseExpr p (+ depth 1))?)
      {
        (let then (parseBlock p)?)
        {
          (let els
            (if (eatWord p "ELSE")
              (if (atWord p "IF")
                {
                  (let e (parseIfExpr p (+ depth 1))?)
                  (Some e)
                }
                {
                  (let body (parseBlock p)?)
                  (Some (EBlock body))
                })
              None))
          (Ok (EIf cond (EBlock then) els))
        }
      }
    }
  })

; A record's key after `table:` : a number, a string, or a name
; (hyphens and digits welcome, so uuid-shaped keys read whole and
; keep their text type).
(:: parseKey (-> Ps (Result Expr Error)))
(fn (parseKey p)
  {
    (let t (peek p))
    (if (== t.kind tkInt)
        {
          (advance p)
          (intLiteral p t)
        }
      (== t.kind tkIntMin)
        (synErrAt p.src t.start "this integer is too large for a key")
      (== t.kind tkStr)
        {
          (advance p)
          (Ok (ELit (VText t.text)))
        }
      (== t.kind tkParam)
        {
          (advance p)
          {
            (noteParam p t.text)
            (Ok (EParam t.text))
          }
        }
      (== t.kind tkIdent)
        {
          (let mut key (advText p))
          {
            (while (keyPartAhead p)
              (set key (concat (concat key "-") (keyPart p))))
            (Ok (ELit (VText key)))
          }
        }
      (expected p "a record key (a number, a string, or a name)"))
  })

; Whether another `-part` of a hyphenated key follows.
(:: keyPartAhead (-> Ps Bool))
(fn (keyPartAhead p)
  (&& (atKind p tkMinus)
    {
      (let t (peekAt p 1))
      (|| (== t.kind tkIdent) (|| (== t.kind tkInt) (== t.kind tkIntMin)))
    }))

(:: keyPart (-> Ps String))
(fn (keyPart p)
  {
    (advance p)
    (advText p)
  })

; ------------------------------------------------------------------
; Entry points.
; ------------------------------------------------------------------
(:: newPs (-> String (Result Ps Error)))
(fn (newPs src)
  {
    (let lx (Lx :src src :toks vecNew :at 0 :failed false :errAt 0 :errMsg ""))
    {
      (lexAll lx (strLen src))
      (if lx.failed
        (synErrAt src lx.errAt lx.errMsg)
        (Ok (Ps :src src :toks lx.toks :at 0 :ops 0 :params vecNew)))
    }
  })

;; Parse one statement. Anything after it but `;` is an error; parse
;; a script with `axqlParseScript`.
(pub :: axqlParse (-> String (Result Parsed Error)))
(pub fn (axqlParse src)
  {
    (let p (newPs src)?)
    {
      (while (eatKind p tkSemi)
        0)
      (if (atKind p tkEof)
        (expected p "a statement")
        {
          (let start (peekStart p))
          {
            (let stmt (parseStmt p)?)
            {
              (while (eatKind p tkSemi)
                0)
              (if (! (atKind p tkEof))
                (expected p "the end of the statement (axqlParseScript takes several)")
                (Ok
                  (Parsed
                    :stmt stmt
                    :paramNames p.params
                    :text (strSlice src start (- (lastEnd p) start)))))
            }
          }
        })
    }
  })

;; Parse a script: every statement in `src`, in order.
(pub :: axqlParseScript (-> String (Result (Vec Parsed) Error)))
(pub fn (axqlParseScript src)
  {
    (let p (newPs src)?)
    {
      (let out vecNew)
      (let mut failure None)
      {
        (while (&& (isNone failure) (! (atKind p tkEof)))
          (if (eatKind p tkSemi)
            0
            {
              (let start (peekStart p))
              (let paramsBefore (vecLen p.params))
              (match (parseStmt p)
                ((Ok stmt)
                  (vecPush out
                    (Parsed
                      :stmt stmt
                      :paramNames (paramsSince p paramsBefore)
                      :text (strSlice src start (- (lastEnd p) start))))
                )
                ((Err e)
                  (set failure (Some e))
                ))
            }))
        (match failure
          ((Some e) (Err e))
          ((None) (Ok out)))
      }
    }
  })

(:: paramsSince (-> Ps Int (Vec String)))
(fn (paramsSince p before)
  {
    (let out vecNew)
    {
      (for i in before..(vecLen p.params)
        (vecPush out (vecGet p.params i)))
      out
    }
  })

;; Parse one expression: how a value written as AXQL becomes an
;; expression to run.
(pub :: axqlParseExpr (-> String (Result Expr Error)))
(pub fn (axqlParseExpr src)
  {
    (let p (newPs src)?)
    {
      (let e (parseExpr p 0)?)
      (if (! (atKind p tkEof))
        (expected p "the end of the expression")
        (Ok e))
    }
  })

; ------------------------------------------------------------------
; Words, for editors.
; ------------------------------------------------------------------
;; The words that open a statement or a clause, upper case, in one
;; string. `axqlIsKeyword` is the check for one.
(pub :: axqlKeywords String)
(pub fn (axqlKeywords)
  "SELECT CREATE UPDATE UPSERT DELETE RELATE INSERT DEFINE REMOVE LET RETURN THROW IF ELSE FOR IN BREAK CONTINUE BEGIN COMMIT CANCEL TRANSACTION LIVE KILL INFO SHOW CHANGES TRUE FALSE NONE")

;; The words that are keywords only where the grammar expects them,
;; so a field may carry one as its name.
(pub :: axqlContextWords String)
(pub fn (axqlContextWords)
  "FROM WHERE GROUP BY ORDER LIMIT START FETCH OMIT AS VALUE CONTENT SET MERGE PATCH ONLY ON DUPLICATE KEY TABLE FIELD INDEX EVENT FUNCTION SCHEMAFULL SCHEMALESS CHANGEFEED TYPE DEFAULT ASSERT READONLY FIELDS COLUMNS UNIQUE WHEN THEN EXISTS OVERWRITE DESC ASC AND OR NOT IS CONTAINS INSIDE OUTSIDE INTO FOR SINCE")

;; The functions a statement may call without defining them, by name.
;; `Axqlite.AxqlEval` is where each one is answered.
(pub :: axqlFunctions String)
(pub fn (axqlFunctions)
  "count type::is type::bool type::int type::float type::text type::record type::uuid type::datetime string::len string::lowercase string::uppercase string::trim string::contains string::startsWith string::endsWith string::replace string::split string::join string::slice math::abs math::ceil math::floor math::round math::sqrt math::min math::max math::sum math::mean array::len array::first array::last array::push array::concat array::sort array::reverse array::distinct array::flatten object::keys object::values object::entries record::id record::tb record::exists time::now rand::uuid rand::int rand::float")

;; Whether `w`, in any case, is a keyword or a context word.
(pub :: axqlIsKeyword (-> String Bool))
(pub fn (axqlIsKeyword w)
  (|| (wordIn axqlKeywords w) (wordIn axqlContextWords w)))

(:: wordIn (-> String String Bool))
(fn (wordIn words w)
  {
    (let mut found false)
    {
      (for word in (strSplit words 32)
        (if (wordEq word w)
          (set found true)))
      found
    }
  })

;; The tokens of `src` as flat triples of start, end and class, where
;; the class is 1 for a keyword, 2 an identifier or quoted name, 3 a
;; number or duration, 4 a string or bytes, 5 a parameter and 6
;; punctuation. The scan stops where the lexer refuses, so a text
;; with a fault still yields its tokens up to it. For an editor that
;; colours a statement.
(pub :: axqlTokens (-> String (Vec Int)))
(pub fn (axqlTokens src)
  {
    (let lx (Lx :src src :toks vecNew :at 0 :failed false :errAt 0 :errMsg ""))
    (let out vecNew)
    {
      (lexAll lx (strLen src))
      (for t in lx.toks
        (if (!= t.kind tkEof)
          {
            (vecPush out t.start)
            (vecPush out t.end)
            (vecPush out (tokenClass t))
          }))
      out
    }
  })

(:: tokenClass (-> Tok Int))
(fn (tokenClass t)
  (if (== t.kind tkIdent)
      (if (axqlIsKeyword t.text)
        1
        2)
    (|| (== t.kind tkInt) (|| (== t.kind tkIntMin) (|| (== t.kind tkFloat) (== t.kind tkDuration))))
      3
    (|| (== t.kind tkStr)
      (|| (== t.kind tkBytes) (|| (== t.kind tkDatetimeLit) (== t.kind tkUuidLit))))
      4
    (== t.kind tkParam)
      5
    6))
