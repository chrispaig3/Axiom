;;! Axqlite.AxqlSchema - the tables, fields, indexes, events and
;;! functions a database holds.
;;!
;;!     (axqlLoadSchema pager)            ; (Ok <Schema>): every entry
;;!     (axqlTableDef schema "people")    ; (Ok <TableDef>) with its parts
;
; The schema lives in the schema tree, the B-tree rooted at page 1.
; Each entry is stored as one array value:
;
;     kind    'table', 'field', 'index', 'event', 'function', 'feed'
;             or 'meta'
;     name    the entry's own name
;     table   the table it belongs to (a table names itself)
;     root    its B-tree's root page, 0 when it has none
;     text    the DEFINE statement that made it, as written, or ""
;             for a table a write made without one
;
; The DEFINE text is the one source of truth: a field's type, an
; index's fields, an event's condition and a function's body are read
; back by parsing it. Names compare without regard to ASCII case for
; tables, indexes, events and functions, and exactly for fields,
; where case is part of the document.
;
; A table's records live in its own tree, keyed by the key encoding
; of the record's key scalar, holding the record's document without
; its `id`. An index's keys are the indexed fields' encodings
; followed by the record's key, with an empty value. A `feed` entry
; roots a table's change feed, and the single `meta` entry roots a
; tree of small counters and live subscriptions, keyed by plain
; prefixed text.
(import Str)
(import Vec)
(import Err)
(import Axqlite.Value)
(import Axqlite.Pager)
(import Axqlite.Btree)
(import Axqlite.Record)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)

; ------------------------------------------------------------------
; The schema's shape.
; ------------------------------------------------------------------
;; One row of the schema tree.
(pub struct SchemaEntry
  (rowid : Int)
  (kind : String)
  (name : String)
  (table : String)
  (root : Int)
  (text : String))

;; Every entry, in rowid order.
(pub struct Schema
  (entries : (Vec SchemaEntry)))

;; A defined field of a table.
(pub struct FieldDef
  (name : String)
  (ftype : (Option TypeExpr))
  (dflt : (Option Expr))
  (value : (Option Expr))
  (assert : (Option Expr))
  (readonly : Bool))

;; An index: its name, root page, the field paths it covers, and
;; whether it is unique.
(pub struct IndexDef
  (name : String)
  (root : Int)
  (fields : (Vec String))
  (unique : Bool))

;; A defined event of a table.
(pub struct EventDef
  (name : String)
  (when : Expr)
  (then : (Vec Stmt)))

;; A table: its name as first written, root page, whether it is
;; schemafull, whether it keeps a change feed, and its defined
;; fields, indexes and events.
(pub struct TableDef
  (name : String)
  (root : Int)
  (schemafull : Bool)
  (changefeed : Bool)
  (fields : (Vec FieldDef))
  (indexes : (Vec IndexDef))
  (events : (Vec EventDef)))

;; A defined function.
(pub struct FunctionDef
  (name : String)
  (params : (Vec ParamDef))
  (body : (Vec Stmt)))

;; The kind of a table entry.
(pub :: kindTable String)
(pub fn (kindTable)
  "table")

;; The kind of a field entry.
(pub :: kindField String)
(pub fn (kindField)
  "field")

;; The kind of an index entry.
(pub :: kindIndex String)
(pub fn (kindIndex)
  "index")

;; The kind of an event entry.
(pub :: kindEvent String)
(pub fn (kindEvent)
  "event")

;; The kind of a function entry.
(pub :: kindFunction String)
(pub fn (kindFunction)
  "function")

;; The kind of a change-feed entry.
(pub :: kindFeed String)
(pub fn (kindFeed)
  "feed")

;; The kind of the one meta entry.
(pub :: kindMeta String)
(pub fn (kindMeta)
  "meta")

(:: corrupt (-> String (Result a Error)))
(fn (corrupt msg)
  (axqErr axqCorrupt (concat "the schema tree is damaged: " msg) "axqlLoadSchema"))

; ------------------------------------------------------------------
; Entries as values.
; ------------------------------------------------------------------
(:: entryValue (-> SchemaEntry Value))
(fn (entryValue e)
  {
    (let xs vecNew)
    {
      (vecPush xs (VText e.kind))
      (vecPush xs (VText e.name))
      (vecPush xs (VText e.table))
      (vecPush xs (VInt e.root))
      (vecPush xs (VText e.text))
      (VArray xs)
    }
  })

(:: entryOfValue (-> Int Value (Result SchemaEntry Error)))
(fn (entryOfValue rowid v)
  (match v
    ((VArray xs)
      (if (!= (vecLen xs) 5)
        (corrupt "an entry without five values")
        (match (vecGet xs 0)
          ((VText kind)
            (match (vecGet xs 1)
              ((VText name)
                (match (vecGet xs 2)
                  ((VText table)
                    (match (vecGet xs 3)
                      ((VInt root)
                        (match (vecGet xs 4)
                          ((VText text)
                            (Ok
                              (SchemaEntry
                                :rowid rowid
                                :kind kind
                                :name name
                                :table table
                                :root root
                                :text text))
                          )
                          (_ (corrupt "an entry's statement is not text")))
                      )
                      (_ (corrupt "an entry's root is not an int")))
                  )
                  (_ (corrupt "an entry's table is not text")))
              )
              (_ (corrupt "an entry's name is not text")))
          )
          (_ (corrupt "an entry's kind is not text"))))
    )
    (_ (corrupt "an entry that is not an array"))))

; ------------------------------------------------------------------
; Reading the schema.
; ------------------------------------------------------------------
(struct Loader
  (entries : (Vec SchemaEntry)))

;; Read every entry of the schema tree. Needs a lock.
(pub :: axqlLoadSchema (-> Pager (Result Schema Error)))
;@axiom:effect(io)
(pub fn (axqlLoadSchema pager)
  {
    (let ld (Loader :entries vecNew))
    {
      (let _ (btreeScan pager btreeSchemaRoot None None true (lambda (k v) (loadEntry ld k v)))?)
      (Ok (Schema :entries ld.entries))
    }
  })

(:: loadEntry (-> Loader String String (Result Bool Error)))
(fn (loadEntry ld k v)
  {
    (let rowid (keyRowidOf k)?)
    {
      (let value (recDecode v)?)
      {
        (let e (entryOfValue rowid value)?)
        {
          (vecPush ld.entries e)
          (Ok true)
        }
      }
    }
  })

;; The entries of one kind, in the order they were made.
(pub :: axqlEntriesOf (-> Schema String (Vec SchemaEntry)))
(pub fn (axqlEntriesOf s kind)
  {
    (let out vecNew)
    {
      (for e in s.entries
        (if (strEq e.kind kind)
          (vecPush out e)))
      out
    }
  })

;; The entry of `kind` named `name`, on `table` when the kind has
;; one. Table, index, event and function names are case-blind; a
;; field entry matches its name exactly and its table as tables do.
(pub :: axqlFindEntry (-> Schema String String String (Option SchemaEntry)))
(pub fn (axqlFindEntry s kind table name)
  {
    (let mut found None)
    {
      (for e in s.entries
        (if (&& (isNone found)
              (&& (strEq e.kind kind)
                (&& (nameMatches kind e.name name)
                  (|| (strIsEmpty table) (axqlWordEq e.table table)))))
          (set found (Some e))))
      found
    }
  })

(:: nameMatches (-> String String String Bool))
(fn (nameMatches kind have want)
  (if (strEq kind kindField)
    ; Field paths may be quoted in a definition and dotted; the
    ; stored spelling is what a later mention must repeat.
    (strEq have want)
    (axqlWordEq have want)))

;; The names of every table, in the order they were made.
(pub :: axqlTableNames (-> Schema (Vec String)))
(pub fn (axqlTableNames s)
  {
    (let out vecNew)
    {
      (for e in s.entries
        (if (strEq e.kind kindTable)
          (vecPush out e.name)))
      out
    }
  })

; Parse an entry's DEFINE text.
(:: parseEntryText (-> SchemaEntry (Result Stmt Error)))
(fn (parseEntryText e)
  (if (strIsEmpty e.text)
    (axqErr axqCorrupt
      (concat "the schema tree is damaged: an entry without its statement: " e.name)
      "axqlLoadSchema")
    (match (axqlParse e.text)
      ((Ok p) (Ok p.stmt))
      ((Err err)
        (axqErr axqCorrupt
          (concat (concat "the schema tree is damaged: a statement does not parse: " e.name)
            (concat ": " (errorText err)))
          "axqlLoadSchema")
      ))))

;; The table named `name`, with its fields, indexes and events, or
;; `axqSchema` naming what might have been meant.
(pub :: axqlTableDef (-> Schema String (Result TableDef Error)))
(pub fn (axqlTableDef s name)
  (match (axqlFindEntry s kindTable "" name)
    ((None)
      (axqErr axqSchema
        (concat (concat "no such table: " name) (axqlHint name (axqlTableNames s) "tables"))
        "axqlTableDef")
    )
    ((Some e) (tableDefOf s e))))

(:: tableDefOf (-> Schema SchemaEntry (Result TableDef Error)))
(fn (tableDefOf s e)
  {
    (let shape (tableShape e)?)
    {
      (let fields (tableFields s e.name)?)
      {
        (let indexes (tableIndexes s e.name)?)
        {
          (let events (tableEvents s e.name)?)
          (Ok
            (TableDef
              :name e.name
              :root e.root
              :schemafull (== (vecGet shape 0) 1)
              :changefeed (== (vecGet shape 1) 1)
              :fields fields
              :indexes indexes
              :events events))
        }
      }
    }
  })

; (schemafull, changefeed) as two words in one Vec; an implicit
; table (no DEFINE text) is schemaless and feedless.
(:: tableShape (-> SchemaEntry (Result (Vec Int) Error)))
(fn (tableShape e)
  (if (strIsEmpty e.text)
    (Ok (vecPush (vecPush vecNew 0) 0))
    (match (parseEntryText e)
      ((Err err) (Err err))
      ((Ok stmt)
        (match stmt
          ((SDefineTable _ _ _ schema feed)
            (Ok
              (vecPush
                (vecPush vecNew
                  (if (== schema 1)
                    1
                    0))
                (if feed
                  1
                  0)))
          )
          (_ (corrupt "a table's statement is not DEFINE TABLE")))
      ))))

(:: tableFields (-> Schema String (Result (Vec FieldDef) Error)))
(fn (tableFields s table)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for e in s.entries
        (if (&& (isNone failure) (&& (strEq e.kind kindField) (axqlWordEq e.table table)))
          (match (parseEntryText e)
            ((Err err)
              (set failure (Some err))
            )
            ((Ok stmt)
              (match stmt
                ((SDefineField name _ _ _ ftype dflt value assert readonly)
                  (vecPush out
                    (FieldDef
                      :name name
                      :ftype ftype
                      :dflt dflt
                      :value value
                      :assert assert
                      :readonly readonly))
                )
                (_
                  (set failure (Some
                                 (mkError axqCorrupt
                                   "the schema tree is damaged: a field's statement is not DEFINE FIELD")))
                ))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }
  })

(:: tableIndexes (-> Schema String (Result (Vec IndexDef) Error)))
(fn (tableIndexes s table)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for e in s.entries
        (if (&& (isNone failure) (&& (strEq e.kind kindIndex) (axqlWordEq e.table table)))
          (match (parseEntryText e)
            ((Err err)
              (set failure (Some err))
            )
            ((Ok stmt)
              (match stmt
                ((SDefineIndex name _ _ _ fields unique)
                  (vecPush out (IndexDef :name name :root e.root :fields fields :unique unique))
                )
                (_
                  (set failure (Some
                                 (mkError axqCorrupt
                                   "the schema tree is damaged: an index's statement is not DEFINE INDEX")))
                ))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }
  })

(:: tableEvents (-> Schema String (Result (Vec EventDef) Error)))
(fn (tableEvents s table)
  {
    (let out vecNew)
    (let mut failure None)
    {
      (for e in s.entries
        (if (&& (isNone failure) (&& (strEq e.kind kindEvent) (axqlWordEq e.table table)))
          (match (parseEntryText e)
            ((Err err)
              (set failure (Some err))
            )
            ((Ok stmt)
              (match stmt
                ((SDefineEvent name _ _ _ when then)
                  (vecPush out (EventDef :name name :when when :then then))
                )
                (_
                  (set failure (Some
                                 (mkError axqCorrupt
                                   "the schema tree is damaged: an event's statement is not DEFINE EVENT")))
                ))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }
  })

;; The function named `name`, or `None`.
(pub :: axqlFunctionDef (-> Schema String (Result (Option FunctionDef) Error)))
(pub fn (axqlFunctionDef s name)
  (match (axqlFindEntry s kindFunction "" name)
    ((None) (Ok None))
    ((Some e)
      (match (parseEntryText e)
        ((Err err) (Err err))
        ((Ok stmt)
          (match stmt
            ((SDefineFunction fname _ _ params body)
              (Ok (Some (FunctionDef :name fname :params params :body body)))
            )
            (_ (corrupt "a function's statement is not DEFINE FUNCTION")))
        ))
    )))

;; The root page of table `name`'s change feed, or `None`.
(pub :: axqlFeedRoot (-> Schema String (Option Int)))
(pub fn (axqlFeedRoot s name)
  (match (axqlFindEntry s kindFeed name name)
    ((Some e) (Some e.root))
    ((None) None)))

;; The root page of the meta tree, or `None` when none was made yet.
(pub :: axqlMetaRoot (-> Schema (Option Int)))
(pub fn (axqlMetaRoot s)
  (match (axqlFindEntry s kindMeta "" "meta")
    ((Some e) (Some e.root))
    ((None) None)))

; ------------------------------------------------------------------
; Writing the schema. Each of these needs a write transaction and
; raises the schema version, so another connection rereads.
; ------------------------------------------------------------------
;; Add an entry. Its rowid field is ignored; the next free one is
;; used. Answers the rowid.
(pub :: axqlPutEntry (-> Pager SchemaEntry (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlPutEntry pager e)
  {
    (let last (btreeLastKey pager btreeSchemaRoot)?)
    {
      (let rowid
        (match last
          ((None) 1)
          ((Some k) (+ (keyRowidOf k)? 1))))
      {
        (let value (recEncode (entryValue e))?)
        {
          (let _ (btreePut pager btreeSchemaRoot (keyRowid rowid) value)?)
          {
            (let _ (pagerBumpSchemaVersion pager)?)
            (Ok rowid)
          }
        }
      }
    }
  })

;; Rewrite the entry at `rowid` wholesale.
(pub :: axqlReplaceEntry (-> Pager SchemaEntry (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlReplaceEntry pager e)
  {
    (let value (recEncode (entryValue e))?)
    {
      (let _ (btreePut pager btreeSchemaRoot (keyRowid e.rowid) value)?)
      (pagerBumpSchemaVersion pager)
    }
  })

;; Remove the entry at `rowid`.
(pub :: axqlDeleteEntry (-> Pager Int (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlDeleteEntry pager rowid)
  {
    (let _ (btreeDelete pager btreeSchemaRoot (keyRowid rowid))?)
    (pagerBumpSchemaVersion pager)
  })

; ------------------------------------------------------------------
; Naming what might have been meant.
; ------------------------------------------------------------------
;; A hint naming what `name` might have meant among `names`: the
;; closest one within two edits, else the list, else that there are
;; none. `what` says what they are ("tables").
(pub :: axqlHint (-> String (Vec String) String String))
(pub fn (axqlHint name names what)
  {
    (let mut best "")
    (let mut bestD 3)
    (let mut list "")
    {
      (for (n i) in names
        {
          (let d (editDistance name n))
          {
            (if (< d bestD)
              {
                (set best n)
                (set bestD d)
              })
            (if (< i 12)
              (set list (if (== i 0)
                n
                (concat list (concat ", " n)))))
          }
        })
      (if (> (vecLen names) 12)
        (set list (concat list ", ...")))
      (if (< bestD 3)
          (concat (concat "; did you mean " best) "?")
        (== (vecLen names) 0)
          (concat "; there are no " (concat what " yet"))
        (concat (concat (concat "; the " what) " are ") list))
    }
  })

; The Levenshtein distance of two names, in bytes, capped by the
; lengths: enough to spot a typo.
(:: editDistance (-> String String Int))
(fn (editDistance a b)
  {
    (let la (strLen a))
    (let lb (strLen b))
    (let row vecNew)
    {
      (for j in 0..(+ lb 1)
        (vecPush row j))
      {
        (for i in 1..(+ la 1)
          {
            (let next vecNew)
            {
              (vecPush next i)
              (for j in 1..(+ lb 1)
                {
                  (let cost
                    (if (== (lowByte (strByte a (- i 1))) (lowByte (strByte b (- j 1))))
                      0
                      1))
                  (vecPush next
                    (min3 (+ (vecGet row j) 1) (+ (vecGet next (- j 1)) 1)
                      (+ (vecGet row (- j 1)) cost)))
                })
              (copyRow row next)
            }
          })
        (vecGet row lb)
      }
    }
  })

(:: copyRow (-> (Vec Int) (Vec Int) Int))
(fn (copyRow row next)
  {
    (for (v j) in next
      (vecSet row j v))
    0
  })

(:: min3 (-> Int Int Int Int))
(fn (min3 a b c)
  (if (< a b)
    (if (< a c)
      a
      c)
    (if (< b c)
      b
      c)))

(:: lowByte (-> Int Int))
(fn (lowByte c)
  (if (&& (>= c 65) (<= c 90))
    (+ c 32)
    c))
