; Bit `i` of the 32-byte scalar at `s`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: geBit (-> Int Int Int))
;@axiom:ct(*s)
;@axiom:effect(unsafe)
;@axiom:precondition(`s` names 32 live bytes and 0 <= `i` < 256)
(fn (geBit s i)
  (& (>> (__load8 s (>> i 3)) (& i 7)) 1))

; h = h + the comb entry for the teeth of `s` at bit `i`. `comb` is
; one comb (eight Precomp points); `c` a Precomp, `ta` a field element
; and `r` a P1P1 of scratch. Every entry is read and one kept under a
; mask; the negation is a masked swap.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: geCombAdd (-> Int Int Int Int Int Int Int Int))
;@axiom:ct(*h, *s, *c, *ta, *r)
;@axiom:effect(unsafe)
;@axiom:precondition(each address names live writable memory of its kind, none overlapping)
(fn (geCombAdd h comb s i c ta r)
  (let ((teeth (| (| (geBit s i) (<< (geBit s (+ i 32)) 1))
                  (| (<< (geBit s (+ i 64)) 2) (<< (geBit s (+ i 96)) 3)))))
    (let ((high (>> teeth 3)))
      (let ((index (& (^ teeth (- high 1)) 7)))
        {
          (for j in 0..8
            (let ((m (ctMaskEq j index)) (e (+ comb (* j 240))))
              {
                (fe25519CMov m (gX c) (gX e))
                (fe25519CMov m (gY c) (gY e))
                (fe25519CMov m (gZ c) (gZ e))
              }))
          (fe25519Neg ta (gZ c))
          (let ((neg (ctMaskFromBit (^ high 1))))
            {
              (fe25519CSwap neg (gZ c) ta)
              (fe25519CSwap neg (gX c) (gY c))
            })
          (ge25519Madd r h c ta)
          (ge25519P1P1ToP3 h r)
        }))))

; h = [a]B for the 32-byte scalar at `a`, any value below 2^256, in
; time that does not depend on `a`.
(pub :: ge25519ScalarMultBase (-> Int Int Int))
;@axiom:ct(*h, *a)
;@axiom:effect(unsafe)
;@axiom:precondition(`h` names a live writable P3 and `a` 32 live bytes, not overlapping)
(pub fn (ge25519ScalarMultBase h a)
  (let ((w (memAlloc 4608)))
    (let (
      (table w)
      (s (+ w 3840))
      (half (+ w 3872))
      (halfOnes (+ w 3904))
      (c (+ w 3936))
      (ta (+ w 4176))
      (r (+ w 4256))
    )
      {
        (ge25519CombTable table)
        ; 1/2 and (2^256 - 1)/2 modulo L, little-endian words
        (__store64 half 0 3173121894899182071)
        (__store64 half 1 751957030100258411)
        (__store64 half 2 0)
        (__store64 half 3 576460752303423488)
        (__store64 halfOnes 0 7743403797640923790)
        (__store64 halfOnes 1 7167388622205675448)
        (__store64 halfOnes 2 -1)
        (__store64 halfOnes 3 576460752303423487)
        (sc25519MulAdd s a half halfOnes)
        (ge25519P3Zero h)
        (geCombAdd h table s 31 c ta r)
        (geCombAdd h (+ table 1920) s 159 c ta r)
        (for i in 30..-1 by -1
          {
            (ge25519P2Dbl r h ta)
            (ge25519P1P1ToP3 h r)
            (geCombAdd h table s i c ta r)
            (geCombAdd h (+ table 1920) s (+ i 128) c ta r)
          })
        (ctWipe w 4608)
      })))

; ------------------------------------------------------------------
; Double-scalar multiplication for verification, variable time
; (ref10's ge_double_scalarmult_vartime). Every input is public.
; ------------------------------------------------------------------
; Write the 256 signed digits of the 32-byte scalar at `a` as words at
; `r`, each 0 or odd in -15..15, with sum r_i 2^i equal to the scalar:
; ref10's `slide`, a signed sliding window.
(:: geSlide (-> Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`r` names 256 live writable words and `a` 32 live bytes)
(fn (geSlide r a)
  {
    (for i in 0..256
      (__store64 r i (geBit a i)))
    (for i in 0..256
      (if (== (__load64 r i) 0)
        0
        (let ((mut b 1) (mut stop 0))
          (while (&& (== stop 0) (&& (<= b 6) (< (+ i b) 256)))
            {
              (let ((rb (__load64 r (+ i b))))
                (if (== rb 0)
                  0
                  (let ((ri (__load64 r i)) (step (<< rb b)))
                    (if (<= (+ ri step) 15)
                      {
                        (__store64 r i (+ ri step))
                        (__store64 r (+ i b) 0)
                        0
                      }
                      (>= (- ri step) -15)
                      {
                        (__store64 r i (- ri step))
                        (let ((mut k (+ i b)) (mut done 0))
                          (while (&& (== done 0) (< k 256))
                            (if (== (__load64 r k) 0)
                              {
                                (__store64 r k 1)
                                (set done 1)
                              }
                              {
                                (__store64 r k 0)
                                (set k (+ k 1))
                              })))
                        0
                      }
                      {
                        (set stop 1)
                        0
                      }))))
              (set b (+ b 1))
            }))))
    0
  })

; The eight odd multiples P, 3P, ..., 15P of the P3 at `p` as Cached
; points at `tbl`. `t` is a P1P1, `u` and `p2` P3s, `fe` a field
; element, all scratch.
(:: geOddMultiples (-> Int Int Int Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(each address names live writable memory of its kind, none overlapping)
(fn (geOddMultiples tbl p t u p2 fe)
  {
    (ge25519P3ToCached tbl p fe)
    (ge25519P2Dbl t p fe)
    (ge25519P1P1ToP3 p2 t)
    (for k in 1..8
      {
        (ge25519Add t p2 (+ tbl (* (- k 1) 320)) fe)
        (ge25519P1P1ToP3 u t)
        (ge25519P3ToCached (+ tbl (* k 320)) u fe)
      })
    0
  })

; r = [a]A + [b]B, as a P2, for 32-byte scalars `a` and `b` below 2^253
; and the P3 `A`. Variable time: for verification only.
(pub :: ge25519DoubleScalarMultVartime (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`r` names a live writable P2, `A` a live P3, and `a` and `b` 32 live bytes each)
(pub fn (ge25519DoubleScalarMultVartime r a A b)
  (let ((w (memAlloc 10720)))
    (let (
      (aslide w)
      (bslide (+ w 2048))
      (ai (+ w 4096))
      (bi (+ w 6656))
      (t (+ w 9216))
      (u (+ w 9536))
      (p2 (+ w 9856))
      (base (+ w 10176))
      (fe (+ w 10496))
      (mut i 255)
    )
      {
        (geSlide aslide a)
        (geSlide bslide b)
        (geOddMultiples ai A t u p2 fe)
        (ge25519Base base)
        (geOddMultiples bi base t u p2 fe)
        (ge25519P2Zero r)
        (while (&& (>= i 0) (&& (== (__load64 aslide i) 0) (== (__load64 bslide i) 0)))
          (set i (- i 1)))
        (while (>= i 0)
          (let ((da (__load64 aslide i)) (db (__load64 bslide i)))
            {
              (ge25519P2Dbl t r fe)
              (if (> da 0)
                {
                  (ge25519P1P1ToP3 u t)
                  (ge25519Add t u (+ ai (* (/ da 2) 320)) fe)
                }
                (< da 0)
                {
                  (ge25519P1P1ToP3 u t)
                  (ge25519Sub t u (+ ai (* (/ (- 0 da) 2) 320)) fe)
                }
                0)
              (if (> db 0)
                {
                  (ge25519P1P1ToP3 u t)
                  (ge25519Add t u (+ bi (* (/ db 2) 320)) fe)
                }
                (< db 0)
                {
                  (ge25519P1P1ToP3 u t)
                  (ge25519Sub t u (+ bi (* (/ (- 0 db) 2) 320)) fe)
                }
                0)
              (ge25519P1P1ToP2 r t)
              (set i (- i 1))
            }))
        0
      })))
