;;! Aes - public algorithm sizes.
; ------------------------------------------------------------------
; Sizes.
; ------------------------------------------------------------------
;; The number of rounds for a key of `keyLen` bytes: 10, 12 or 14 for
;; 16, 24 or 32, and 0 for any other length.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: aesRounds (-> Int Int))
(pub fn (aesRounds keyLen)
  (if (== keyLen 16)
    10
    (if (== keyLen 24)
      12
      (if (== keyLen 32)
        14
        0))))

;; The bytes an expanded schedule for a key of `keyLen` bytes occupies:
;; eight words per round key, 704, 832 or 960. 0 for a bad length.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: aesScheduleBytes (-> Int Int))
(pub fn (aesScheduleBytes keyLen)
  {
    (let nr (aesRounds keyLen))
    (if (== nr 0)
      0
      (* 64 (+ nr 1)))
  })

;; The scratch `aesKeyExpand` needs: the 60-word FIPS 197 schedule and
;; an 8-word state.
(pub :: aesKeyWorkBytes Int)
(pub fn (aesKeyWorkBytes)
  544)

;; The bitsliced state: eight words, four blocks.
(pub :: aesStateBytes Int)
(pub fn (aesStateBytes)
  64)

;; The scratch `aesCtr32Xor` needs: the state and one 64-byte run of
;; keystream.
(pub :: aesCtrWorkBytes Int)
(pub fn (aesCtrWorkBytes)
  128)
