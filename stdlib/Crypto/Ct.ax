;;! Crypto.Ct - the constant-time building blocks every Crypto module
;;! shares.
;
; Masks, selection and word arithmetic support cryptographic algorithms.
; Raw byte and word access lives in Internal.CryptoCt. Applications can
; use Crypto.Aead, Crypto.Ed25519 and Crypto.X25519 for complete operations.
;
; WHAT "CONSTANT TIME" MEANS HERE. A function is constant time when
; nothing an attacker can time - which branches run, which addresses
; are touched, and which instructions have data-dependent latency -
; depends on a secret. Source that looks branchless is not enough:
; `opt` is free to turn `(^ b (& m (^ a b)))` back into a `select`
; once it proves `m` is 0 or -1, and the backend is free to turn a
; `select` into a branch. So every mask a secret produces passes
; through `ctBarrier`, an empty inline-assembly block that answers its
; operand in a register the optimiser cannot see into. After the
; barrier `m` is an arbitrary word to LLVM, and there is no `select`
; left to form. `scripts/check-crypto-ct.py` reads the optimised IR
; and holds the kernels to that (docs/crypto.md, "Constant time").
;
; THE BARRIER IS NOT FREE. Every `asm` block clobbers memory, so a
; barrier also forces loads after it to be reissued. Put one where a
; mask is made, not inside a loop over limbs that only uses one.
;
; WHAT THIS MODULE CANNOT PROMISE. A multiply whose latency depends on
; its operands, a cache line shared with another process, and a
; speculative load past a bounds check are all below the level Axiom
; source controls. The kernels avoid secret-indexed memory and
; secret-dependent division, which removes the software-visible
; channels; the hardware ones are listed in docs/crypto.md.
; ------------------------------------------------------------------
; The barrier.
; ------------------------------------------------------------------
;; `x`, unchanged, through an empty assembly block: the optimiser has
;; to treat the answer as any word at all. This is what stops a mask
;; from being reasoned back into a branch.
;
; The template is a comment naming the register, because an `asm`
; template has to name an operand (AX3091) and an empty instruction
; stream is what we want the assembler to see.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctBarrier (-> Int Int))
;@axiom:ct(x)
;@axiom:effect(unsafe)
(pub fn (ctBarrier x)
  (asm
    (aarch64 "// {r}" (inout r x))
    (x86_64 "# {r}" (inout r x))))

; ------------------------------------------------------------------
; Masks. A mask is a word that is either 0 or -1 (all ones), so it can
; choose between two values with `&`, `|` and `^` and no branch.
; ------------------------------------------------------------------
;; -1 when `x` is not zero, 0 when it is. For any nonzero `x`, one of
;; `x` and `-x` has the sign bit set (for the most negative word both
;; do), so an arithmetic shift of their `|` spreads it.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctMaskNz (-> Int Int))
;@axiom:ct(x)
(pub fn (ctMaskNz x)
  (ctBarrier (>> (| x (- 0 x)) 63)))

;; -1 when `x` is zero, 0 when it is not.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctMaskZero (-> Int Int))
;@axiom:ct(x)
(pub fn (ctMaskZero x)
  (^ (ctMaskNz x) -1))

;; -1 when `a` equals `b`, 0 otherwise.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctMaskEq (-> Int Int Int))
;@axiom:ct(a, b)
(pub fn (ctMaskEq a b)
  (ctMaskZero (^ a b)))

;; -1 when `a` is below `b` as UNSIGNED 64-bit words, 0 otherwise. This
;; is the borrow out of `a - b`, computed from the operands' top bits
;; (Hacker's Delight 2-13), so it is right across the whole range where
;; the signed `(- a b)` would overflow.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctMaskLtU (-> Int Int Int))
;@axiom:ct(a, b)
(pub fn (ctMaskLtU a b)
  (ctBarrier (>> (| (& (^ a -1) b) (& (^ (^ a b) -1) (- a b))) 63)))

;; -1 when `x` is negative, 0 otherwise.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctMaskNeg (-> Int Int))
;@axiom:ct(x)
(pub fn (ctMaskNeg x)
  (ctBarrier (>> x 63)))

;; `a` where `m` is -1, `b` where `m` is 0. `m` must be a mask.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctSelect (-> Int Int Int Int))
;@axiom:ct(m, a, b)
(pub fn (ctSelect m a b)
  (^ b (& m (^ a b))))

;; A mask from a 0/1 bit: 1 becomes -1 and 0 stays 0.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: ctMaskFromBit (-> Int Int))
;@axiom:ct(b)
(pub fn (ctMaskFromBit b)
  (ctBarrier (- 0 (& b 1))))

; ------------------------------------------------------------------
; Shifts and rotations on the words the algorithms use.
;
; `>>` is arithmetic, so a LOGICAL right shift is the arithmetic one
; with the sign copies masked off. For a constant `n` - the only kind
; the algorithms pass - `opt` folds the pair back into one `lshr`, and
; a rotation into one `ror` (measured at --opt 1 on aarch64).
; ------------------------------------------------------------------
;; `x` shifted right by `n` bits with zeros in, for 1 <= n <= 63.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: shrU (-> Int Int Int))
;@axiom:ct(x)
(pub fn (shrU x n)
  (& (>> x n) (- (<< 1 (- 64 n)) 1)))

;; A 64-bit rotation left by `n`, for 1 <= n <= 63.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: rotl64 (-> Int Int Int))
;@axiom:ct(x)
(pub fn (rotl64 x n)
  (| (<< x n) (shrU x (- 64 n))))

;; A 64-bit rotation right by `n`, for 1 <= n <= 63.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: rotr64 (-> Int Int Int))
;@axiom:ct(x)
(pub fn (rotr64 x n)
  (| (shrU x n) (<< x (- 64 n))))

;; The 32-bit words a SHA-256 or ChaCha20 state holds live in the low
;; half of an Int with the high half zero, so `>>` on one is already
;; logical. Every operation that can carry into the high half masks
;; back to 32 bits.
(pub :: mask32 Int)
(pub fn (mask32)
  4294967295)

;; A 32-bit rotation left by `n`, for 1 <= n <= 31, of a word in
;; 0..2^32-1. The answer is in the same range.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: rotl32 (-> Int Int Int))
;@axiom:ct(x)
(pub fn (rotl32 x n)
  (& (| (<< x n) (>> x (- 32 n))) 4294967295))

;; A 32-bit rotation right by `n`, for 1 <= n <= 31.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: rotr32 (-> Int Int Int))
;@axiom:ct(x)
(pub fn (rotr32 x n)
  (& (| (>> x n) (<< x (- 32 n))) 4294967295))

;; `a + b` modulo 2^32, for words in 0..2^32-1.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: add32 (-> Int Int Int))
;@axiom:ct(a, b)
(pub fn (add32 a b)
  (& (+ a b) 4294967295))
