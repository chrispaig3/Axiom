;;! Crypto.Hmac - HMAC-SHA-256 and HMAC-SHA-512.
;;!
;;!     (match (hmacSha256KeyFromSecret k)
;;!       ; k : SecretBytes
;;!       ((Ok key)
;;!         {
;;!           (let tag (hmacSha256 key "message"))  ; 32 bytes
;;!           (hmacSha256Verify key "message" tag)  ; true
;;!         }
;;!       )
;;!       ((Err e) false))
;;!
;;!     {
;;!       (let m (hmacSha256New key))  ; streaming
;;!       {
;;!         (hmacSha256Update m "mess")
;;!         (hmacSha256Update m "age")
;;!         (hmacSha256Final m)  ; the same tag
;;!       }
;;!     }
;
; A tag is a `String` of 32 bytes (HMAC-SHA-256) or 64 bytes
; (HMAC-SHA-512). Check one with `hmacSha256Verify`, never with
; `strEq`: the comparison takes the same time wherever the tags differ.
;
; WHAT IT GUARANTEES. The MAC of FIPS 198-1 over SHA-256 and SHA-512,
; for any key and any message. A key lives in the secret store (kind 22
; for `HmacSha256Key`, 23 for `HmacSha512Key`) as the two chaining
; values that hashing its inner and outer padded blocks produces,
; computed once when the key is made, beside the key bytes themselves.
; No branch or memory address depends on the key or the message; only
; their lengths are public. Every scratch buffer that held key material
; or an inner hash is erased before a call returns.
;
; STANDARD. FIPS 198-1, The Keyed-Hash Message Authentication Code
; (July 2008), section 4, with the hash functions of FIPS 180-4; the
; same construction as RFC 2104. The precomputed inner and outer states
; are the optimisation FIPS 198-1 section 6 describes.
;
; REFERENCE. Written from the standard over `Crypto.Sha2`.
;
; LIMITS. Keys may be any length from 1 byte up; a key longer than the
; hash's block (64 bytes for SHA-256, 128 for SHA-512) is hashed first,
; as the standard says, and one shorter than the digest is accepted but
; weaker than the hash. The empty key is refused. `hmacSha256Verify`
; accepts only a full-length tag; to check a truncated tag, compute the
; full one and compare its prefix with `bytesEqCt`. A streaming state
; keeps key-derived chaining values in arena memory until
; `hmacSha256Wipe`. The `...Raw` and `...Chains` functions are the
; hazardous layer for other Crypto modules, such as HKDF: they take
; the key, or its precomputed states, by address and check nothing.
(import Internal.CryptoCt)
(import Internal.CryptoBytes)
(import Internal.Raw)
(import Str)
(import Err)
(import Crypto.Ct)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Random)
(import Internal.Entropy)
(import Crypto.Secret)
(import Internal.CryptoSecret)
(import Crypto.Sha2)
(import Internal.CryptoHmac)

; ------------------------------------------------------------------
; Keys.
; ------------------------------------------------------------------
;; An HMAC-SHA-256 key: a handle to its bytes and their precomputed
;; inner and outer states in the secret store. Prints as
;; `<HmacSha256Key>`.
(pub struct HmacSha256Key sealed
  (slot : Int)
  (owner : Handle))

;; An HMAC-SHA-512 key. Prints as `<HmacSha512Key>`.
(pub struct HmacSha512Key sealed
  (slot : Int)
  (owner : Handle))

;; The drop cleanup of an HMAC key: wipe and free its mapping. An
;; explicit wipe claims it first, so it never runs twice.
(:: hmacSha256KeyDrop (-> Int Int))
;@axiom:effect(io)
(fn (hmacSha256KeyDrop h)
  (secretBlockFree hmacSha256Kind h))

;; A `HmacSha256Key` over live handle `h`, owning its wipe.
(:: hmacSha256KeyNew (-> Int HmacSha256Key))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (hmacSha256KeyNew h)
  (HmacSha256Key :slot h :owner (__resource_new hmacSha256KeyDrop h)))

(:: hmacSha512KeyDrop (-> Int Int))
;@axiom:effect(io)
(fn (hmacSha512KeyDrop h)
  (secretBlockFree hmacSha512Kind h))

;; A `HmacSha512Key` over live handle `h`, owning its wipe.
(:: hmacSha512KeyNew (-> Int HmacSha512Key))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (hmacSha512KeyNew h)
  (HmacSha512Key :slot h :owner (__resource_new hmacSha512KeyDrop h)))

;; A fresh random HMAC-SHA-256 key of 32 bytes, the hash's output length.
(pub :: hmacSha256KeyGenerate (Result HmacSha256Key Error))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (hmacSha256KeyGenerate)
  (match (hmacKeyRandom 256)
    ((Ok h) (Ok (hmacSha256KeyNew h)))
    ((Err e) (Err e))))

;; An HMAC-SHA-256 key holding a copy of `s`, which may be any length
;; from 1 byte. This is also the deterministic route for known-answer
;; tests and protocols that derive the key.
(pub :: hmacSha256KeyFromSecret (-> SecretBytes (Result HmacSha256Key Error)))
;@axiom:effect(io)
(pub fn (hmacSha256KeyFromSecret s)
  (match (hmacKeyBlock 256 (secretBytesAddr s) (secretLen s) "hmacSha256KeyFromSecret")
    ((Ok h) (Ok (hmacSha256KeyNew h)))
    ((Err e) (Err e))))

;; The key bytes of `k`, as a new `SecretBytes`.
(pub :: hmacSha256KeyExport (-> HmacSha256Key (Result SecretBytes Error)))
;@axiom:effect(io)
(pub fn (hmacSha256KeyExport k)
  (secretBytesFromAddr (+ (secretBlockAddr hmacSha256Kind k.slot) 64)
    (- (secretBlockLen hmacSha256Kind k.slot) 64)))

;; Erase `k` and free its storage. Any later use of `k` stops the
;; program with status 85. Answers 0.
(pub :: hmacSha256KeyWipe (-> HmacSha256Key Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (hmacSha256KeyWipe k)
  (__resource_close k.owner))

;; A fresh random HMAC-SHA-512 key of 64 bytes, the hash's output length.
(pub :: hmacSha512KeyGenerate (Result HmacSha512Key Error))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (hmacSha512KeyGenerate)
  (match (hmacKeyRandom 512)
    ((Ok h) (Ok (hmacSha512KeyNew h)))
    ((Err e) (Err e))))

;; An HMAC-SHA-512 key holding a copy of `s`, which may be any length
;; from 1 byte.
(pub :: hmacSha512KeyFromSecret (-> SecretBytes (Result HmacSha512Key Error)))
;@axiom:effect(io)
(pub fn (hmacSha512KeyFromSecret s)
  (match (hmacKeyBlock 512 (secretBytesAddr s) (secretLen s) "hmacSha512KeyFromSecret")
    ((Ok h) (Ok (hmacSha512KeyNew h)))
    ((Err e) (Err e))))

;; The key bytes of `k`, as a new `SecretBytes`.
(pub :: hmacSha512KeyExport (-> HmacSha512Key (Result SecretBytes Error)))
;@axiom:effect(io)
(pub fn (hmacSha512KeyExport k)
  (secretBytesFromAddr (+ (secretBlockAddr hmacSha512Kind k.slot) 128)
    (- (secretBlockLen hmacSha512Kind k.slot) 128)))

;; Erase `k` and free its storage. Answers 0.
(pub :: hmacSha512KeyWipe (-> HmacSha512Key Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (hmacSha512KeyWipe k)
  (__resource_close k.owner))

; ------------------------------------------------------------------
; One-shot MACs.
; ------------------------------------------------------------------
;; The 32-byte HMAC-SHA-256 tag of `msg` under `k`.
(pub :: hmacSha256 (-> HmacSha256Key String String))
(pub fn (hmacSha256 k msg)
  {
    (let out (strAlloc 32))
    {
      (hmacWithChains 256 (secretBlockAddr hmacSha256Kind k.slot) (strData msg) (strLen msg)
        (strData out))
      out
    }
  })

;; Whether `tag` is the HMAC-SHA-256 tag of `msg` under `k`. A tag that
;; is not 32 bytes answers false. The comparison takes the same time
;; wherever the tags differ.
(pub :: hmacSha256Verify (-> HmacSha256Key String String Bool))
(pub fn (hmacSha256Verify k msg tag)
  (if (!= (strLen tag) 32)
    false
    {
      (let want (rawAlloc 32))
      {
        (let ok
          {
            (hmacWithChains 256 (secretBlockAddr hmacSha256Kind k.slot) (strData msg) (strLen msg)
              want)
            (ctEqAddr want (strData tag) 32)
          })
        {
          (hmacErase want 4)
          ok
        }
      }
    }))

;; The 64-byte HMAC-SHA-512 tag of `msg` under `k`.
(pub :: hmacSha512 (-> HmacSha512Key String String))
(pub fn (hmacSha512 k msg)
  {
    (let out (strAlloc 64))
    {
      (hmacWithChains 512 (secretBlockAddr hmacSha512Kind k.slot) (strData msg) (strLen msg)
        (strData out))
      out
    }
  })

;; Whether `tag` is the HMAC-SHA-512 tag of `msg` under `k`. A tag that
;; is not 64 bytes answers false. The comparison takes the same time
;; wherever the tags differ.
(pub :: hmacSha512Verify (-> HmacSha512Key String String Bool))
(pub fn (hmacSha512Verify k msg tag)
  (if (!= (strLen tag) 64)
    false
    {
      (let want (rawAlloc 64))
      {
        (let ok
          {
            (hmacWithChains 512 (secretBlockAddr hmacSha512Kind k.slot) (strData msg) (strLen msg)
              want)
            (ctEqAddr want (strData tag) 64)
          })
        {
          (hmacErase want 8)
          ok
        }
      }
    }))

;; A streaming HMAC-SHA-256 under `k`.
(pub :: hmacSha256New (-> HmacSha256Key HmacSha256))
(pub fn (hmacSha256New k)
  (HmacSha256 :state (hmacStateFrom 256 (secretBlockAddr hmacSha256Kind k.slot))))

;; Absorb `msg`. Answers 0, or -1 when `m` is not a live HMAC-SHA-256
;; state.
(pub :: hmacSha256Update (-> HmacSha256 String Int))
(pub fn (hmacSha256Update m msg)
  (hmacSha256UpdateAddr m (strData msg) (strLen msg)))

;; The 32-byte tag of everything absorbed; `m` is then ready for another
;; message under the same key. A value that is not a live HMAC-SHA-256
;; state answers the empty string.
(pub :: hmacSha256Final (-> HmacSha256 String))
(pub fn (hmacSha256Final m)
  {
    (let out (strAlloc 32))
    (if (== (hmacSha256FinalAddr m (strData out)) 0)
      out
      "")
  })

;; An independent copy of `m`, which goes on from the same point.
(pub :: hmacSha256Copy (-> HmacSha256 HmacSha256))
(pub fn (hmacSha256Copy m)
  {
    (let s m.state)
    (HmacSha256 :state (bytesFromAddr (strData s) (strLen s)))
  })

;; Erase everything `m` holds, the key's chaining values included; every
;; later operation on it is refused. Answers 0, or -1 with nothing
;; written when `m` is not a state.
(pub :: hmacSha256Wipe (-> HmacSha256 Int))
(pub fn (hmacSha256Wipe m)
  (hmacStateWipe 256 m.state))

;; A streaming HMAC-SHA-512 under `k`.
(pub :: hmacSha512New (-> HmacSha512Key HmacSha512))
(pub fn (hmacSha512New k)
  (HmacSha512 :state (hmacStateFrom 512 (secretBlockAddr hmacSha512Kind k.slot))))

;; Absorb `msg`. Answers 0, or -1 when `m` is not a live HMAC-SHA-512
;; state.
(pub :: hmacSha512Update (-> HmacSha512 String Int))
(pub fn (hmacSha512Update m msg)
  (hmacSha512UpdateAddr m (strData msg) (strLen msg)))

;; The 64-byte tag of everything absorbed; `m` is then ready for another
;; message under the same key. A value that is not a live HMAC-SHA-512
;; state answers the empty string.
(pub :: hmacSha512Final (-> HmacSha512 String))
(pub fn (hmacSha512Final m)
  {
    (let out (strAlloc 64))
    (if (== (hmacSha512FinalAddr m (strData out)) 0)
      out
      "")
  })

;; An independent copy of `m`, which goes on from the same point.
(pub :: hmacSha512Copy (-> HmacSha512 HmacSha512))
(pub fn (hmacSha512Copy m)
  {
    (let s m.state)
    (HmacSha512 :state (bytesFromAddr (strData s) (strLen s)))
  })

;; Erase everything `m` holds, the key's chaining values included; every
;; later operation on it is refused. Answers 0, or -1 with nothing
;; written when `m` is not a state.
(pub :: hmacSha512Wipe (-> HmacSha512 Int))
(pub fn (hmacSha512Wipe m)
  (hmacStateWipe 512 m.state))
