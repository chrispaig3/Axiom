;;! Poly1305 - public algorithm sizes.
;; The state, 16 words:
;;   words 0-4    r, clamped, in 26-bit limbs
;;   words 5-9    the accumulator h, in 26-bit limbs
;;   words 10-13  s, the key's second half, as 32-bit words
;;   words 14-15  scratch for a padded final block
(pub :: poly1305StateBytes Int)
(pub fn (poly1305StateBytes)
  128)
