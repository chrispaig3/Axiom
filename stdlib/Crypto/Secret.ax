; Crypto.Secret - where key material lives.
;
;     (let ((k (unwrapOr (secretRandom 32) ...)))
;       {
;         (println "{k}")          ; prints <SecretBytes>, never the bytes
;         (secretLen k)            ; 32
;         (secretWipe k)           ; zeroed, unlocked, unmapped
;       })
;
; A secret is a HANDLE, not a buffer. `SecretBytes` and every key type
; in the Crypto modules is a sealed word struct (docs/memory-model.md
; MM-VAL-10a): only the module that declares it can make one or read
; its word, it has no fields another module can print, and `{k}` in a
; format string renders `<SecretBytes>`. So a key cannot reach a log
; line, a `Json` value or a `Fmt` rendering by accident, and one
; algorithm's key cannot be passed where another's is expected.
;
; THE BYTES LIVE IN A MAPPING OF THEIR OWN, outside the arena. Each
; secret is a private anonymous mapping (`Sys.sysMapPrivate`) that the
; store asks the kernel to lock out of swap (`sysMlock`) and, on Linux
; and FreeBSD, to leave out of core files (`sysExcludeFromCore`). Both
; requests are best effort: an unprivileged process may lock only a
; few megabytes, and when the kernel says no the secret is still made,
; unlocked, and `secretIsLocked` answers false.
;
; Outside the arena matters for a second reason. A region or an arena
; reset reclaims everything allocated since its mark, and a key held in
; arena memory would dangle under a handle that still looked valid. A
; mapping is freed only by `secretWipe`.
;
; LIVENESS IS THE RUNTIME'S HANDLE TABLE (MM-PAR-8). The handle word
; names a slot that records the secret's kind. Using a wiped secret, a
; secret of another kind, or a forged word stops the program with
; status 85 before any byte is read. Each key type has its own kind -
; the table below - so the runtime also refuses an X25519 key handed
; to an operation expecting an Ed25519 one, even through a `cast`.
;
; ERASURE. `secretWipe` overwrites the whole mapping with zeros through
; `ctWipe`, whose closing fence the optimiser cannot delete, then
; unlocks and unmaps it. The Crypto modules wipe every temporary they
; derive from a secret - a key schedule, a hash state, an intermediate
; product - before they return, on the error path as well as the
; normal one.
;
; WHAT ERASURE CANNOT REACH, stated so nobody relies on it: copies a
; caller made with `secretExposeCopy`; values that were in registers or
; spilled to the stack while an operation ran; a `parallel` binding's
; forked copy of the page; a core file on Darwin; and whatever the
; kernel or hardware kept. A program that never calls `secretWipe`
; keeps its secrets mapped until it exits - there is no destructor.
;
; KINDS. The handle table keeps 8 bits of kind. Kinds 1 to 11 are the
; runtime's and the standard library's: 1 and 5 the two kinds of spawn
; handle (a forked binding's and a thread's), 2 `Chan`, 3 `Sync`, 4
; `Task`, 6 and 7 `Net`'s listener and stream, 8 to 10 `Axqlite`'s
; connection, statement and transaction, and 11 its pager. 12 to 15
; are unassigned. The Crypto suite takes 16 to 63:
;
;   16 SecretBytes            17 X25519SecretKey       18 Ed25519SecretKey
;   19 Aes128GcmKey           20 Aes256GcmKey          21 ChaCha20Poly1305Key
;   22 HmacSha256Key          23 HmacSha512Key         24-63 unassigned
(import Mem)
(import Str)
(import Err)
(import Sys)
(import Crypto.Ct)
(import Crypto.Errors)
(import Crypto.Random)

; A secret of any length, with no algorithm attached. Algorithms take
; their own key types, made from one of these with an explicit
; conversion that checks the length.
(pub struct SecretBytes word shared
  (slot : Int))

; The header at the start of each mapping. The payload follows it on
; its own cache line, so no header word shares a line with key bytes.
;   word 0 : the mapping's length in bytes
;   word 1 : the payload's length in bytes
;   word 2 : flags, bit 0 locked, bit 1 excluded from core files
(:: secretHeader Int)
(fn (secretHeader)
  64)

(:: secretBytesKind Int)
(fn (secretBytesKind)
  16)

; ------------------------------------------------------------------
; The store. These take and answer raw handle words, and are for the
; Crypto modules' own key types; application code uses `SecretBytes`
; and the typed keys, never a raw word.
; ------------------------------------------------------------------
; A fresh zeroed secret of `n` payload bytes under handle kind `kind`,
; as a handle word.
(pub :: secretBlockNew (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`kind` is the kind this caller's key type owns, in 16..63)
(pub fn (secretBlockNew kind n)
  (if (< n 0)
    (cryptoLengthErr "a negative secret length" "secretBlockNew")
    (let ((len (+ n secretHeader)))
      (match (sysMapPrivate len)
        ((Err e) (cryptoErr cryptoNoSecretStore (concat "the kernel refused a mapping for a secret: " (errorText e)) "secretBlockNew"))
        ((Ok m)
          (let (
            (locked (if (isOk (sysMlock m len))
              1
              0))
            (noCore (if (isOk (sysExcludeFromCore m len))
              2
              0))
          )
            (let ((h (__handle_new kind m)))
              (if (== h 0)
                (let (
                  (_ (if (== locked 1)
                    (sysMunlock m len)
                    (Ok 0)))
                  (_ (sysUnmapPrivate m len))
                )
                  (cryptoErr cryptoNoSecretStore "the runtime's handle table is full" "secretBlockNew"))
                {
                  (__store64 m 0 len)
                  (__store64 m 1 n)
                  (__store64 m 2 (| locked noCore))
                  (Ok h)
                })))
        )))))

; The address of the payload of live secret `h` of kind `kind`. A dead,
; forged or other-kind handle stops the program with status 85.
(pub :: secretBlockAddr (-> Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(the answer is used only while `h` stays live)
(pub fn (secretBlockAddr kind h)
  (+ (__handle_get kind h) secretHeader))

; The payload length of live secret `h`.
(pub :: secretBlockLen (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (secretBlockLen kind h)
  (__load64 (__handle_get kind h) 1))

; Whether the kernel locked live secret `h` out of swap.
(pub :: secretBlockLocked (-> Int Int Bool))
;@axiom:effect(unsafe)
(pub fn (secretBlockLocked kind h)
  (!= (& (__load64 (__handle_get kind h) 2) 1) 0))

; Erase and free live secret `h`: zero the whole mapping, unlock it,
; unmap it, and retire the handle so any later use stops the program.
; A second free stops it too. Answers 0.
(pub :: secretBlockFree (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(no other binding is using `h`)
(pub fn (secretBlockFree kind h)
  (let ((m (__handle_free kind h)))
    (let (
      (len (__load64 m 0))
      (flags (__load64 m 2))
    )
      {
        (ctWipe m len)
        (let (
          (_ (if (!= (& flags 1) 0)
            (sysMunlock m len)
            (Ok 0)))
          (_ (sysUnmapPrivate m len))
        )
          0)
      })))

; A fresh secret of kind `kind` holding a copy of `n` bytes at `p`.
(pub :: secretBlockFrom (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`p` names `n` live bytes, and `kind` is this caller's)
(pub fn (secretBlockFrom kind p n)
  (match (secretBlockNew kind n)
    ((Err e) (Err e))
    ((Ok h)
      {
        (ctCopy (secretBlockAddr kind h) p n)
        (Ok h)
      }
    )))

; A fresh secret of kind `kind` holding `n` random bytes, drawn straight
; into the mapping so they are never anywhere else.
(pub :: secretBlockRandom (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(entropy)
;@axiom:precondition(`kind` is this caller's)
(pub fn (secretBlockRandom kind n)
  (match (secretBlockNew kind n)
    ((Err e) (Err e))
    ((Ok h)
      (match (randomFill (secretBlockAddr kind h) n)
        ((Ok _) (Ok h))
        ((Err e)
          {
            (secretBlockFree kind h)
            (Err e)
          }
        ))
    )))

; ------------------------------------------------------------------
; SecretBytes.
; ------------------------------------------------------------------
; A secret holding a copy of `s`'s bytes. The string itself is not
; touched: if it held the only other copy, the caller decides whether
; to overwrite it.
(pub :: secretFromString (-> String (Result SecretBytes Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (secretFromString s)
  (match (secretBlockFrom secretBytesKind (strData s) (strLen s))
    ((Ok h) (Ok (SecretBytes h)))
    ((Err e) (Err e))))

; A secret of `n` random bytes from `Crypto.Random`.
(pub :: secretRandom (-> Int (Result SecretBytes Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(entropy)
(pub fn (secretRandom n)
  (match (secretBlockRandom secretBytesKind n)
    ((Ok h) (Ok (SecretBytes h)))
    ((Err e) (Err e))))

; A secret holding a copy of `n` bytes at `p`. For Crypto modules that
; derive a secret into their own scratch memory and hand it out.
(pub :: secretFromAddr (-> Int Int (Result SecretBytes Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`p` names `n` live bytes)
(pub fn (secretFromAddr p n)
  (match (secretBlockFrom secretBytesKind p n)
    ((Ok h) (Ok (SecretBytes h)))
    ((Err e) (Err e))))

; How many bytes `s` holds. A secret's length is not secret.
(pub :: secretLen (-> SecretBytes Int))
(pub fn (secretLen s)
  (secretBlockLen secretBytesKind s.slot))

; The payload address of `s`, for a Crypto module reading it. Valid
; only while `s` stays live.
(pub :: secretAddr (-> SecretBytes Int))
;@axiom:effect(unsafe)
;@axiom:precondition(the answer is used only while `s` stays live)
(pub fn (secretAddr s)
  (secretBlockAddr secretBytesKind s.slot))

; Whether two secrets hold the same bytes, in time that depends only
; on their lengths.
(pub :: secretEq (-> SecretBytes SecretBytes Bool))
;@axiom:effect(unsafe)
(pub fn (secretEq a b)
  (if (!= (secretLen a) (secretLen b))
    false
    (ctEqAddr (secretAddr a) (secretAddr b) (secretLen a))))

; Whether the kernel locked `s` out of swap.
(pub :: secretIsLocked (-> SecretBytes Bool))
(pub fn (secretIsLocked s)
  (secretBlockLocked secretBytesKind s.slot))

; Erase `s` and free its storage. Any later use of `s`, or of a copy
; of the handle, stops the program with status 85. Answers 0.
(pub :: secretWipe (-> SecretBytes Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (secretWipe s)
  (secretBlockFree secretBytesKind s.slot))

; A COPY of the secret's bytes in an ordinary string. This is the one
; way a secret's value leaves the store, for writing a key to a file
; you have decided to trust. The copy is arena memory: it is not
; locked, not wiped by `secretWipe`, and can be printed. Prefer a
; typed key's own export, which says what the bytes are.
(pub :: secretExposeCopy (-> SecretBytes String))
;@axiom:effect(unsafe)
(pub fn (secretExposeCopy s)
  (let ((n (secretLen s)))
    (let ((out (strAlloc n)))
      {
        (ctCopy (strData out) (secretAddr s) n)
        out
      })))
