; Crypto.MlDsaPoly - the polynomial arithmetic under ML-DSA (FIPS 204):
; the ring Z_q[X]/(X^256 + 1) with q = 8380417, its number-theoretic
; transform, the rounding functions, sampling from SHAKE, and the bit
; encodings.
;
;     (let ((z (memAlloc 2048)) (a (memAlloc 2048)) (b (memAlloc 2048)))
;       {
;         (mlDsaZetaTable z)             ; the NTT's twiddle factors
;         (mlDsaNtt a z)                 ; a into the NTT domain
;         (mlDsaNtt b z)
;         (mlDsaPolyPointwise a a b)     ; a * b, pointwise, Montgomery
;         (mlDsaInvNttToMont a z)        ; the product a b, back again
;       })
;
; This is the hazardous layer under `Crypto.MlDsa`. It works on raw
; addresses and knows nothing about keys or parameter sets beyond the
; numbers it is handed.
;
; THE REPRESENTATION. A polynomial is 256 signed 64-bit words at an
; address, 2048 bytes, coefficient i at word i. The values are those
; the reference implementation keeps in 32-bit integers: every
; function here keeps the reference's bounds, so no intermediate needs
; more than 32 bits except the products Montgomery reduction takes,
; which need 64, and Axiom's `Int` holds both. Montgomery reduction
; truncates to 32 bits exactly where the reference casts to int32_t,
; and answers the reference's signed representative, below q in
; magnitude.
;
; CONSTANT TIME. The transform, the reductions, Power2Round, Decompose,
; MakeHint, the norm check, ExpandMask and every encoding run the same
; instructions and touch the same addresses whatever the coefficients
; are: Decompose multiplies and shifts where the standard divides, and
; the norm check folds every coefficient into one word before it looks
; at the answer. Three functions branch on their data, as FIPS 204 and
; the reference do: `mlDsaPolyUniform` (rejection sampling of the
; public matrix), `mlDsaPolyUniformEta` (rejection sampling of the
; secret vectors, where what is rejected is independent of what is
; kept, so the timing reveals only how many bytes were drawn) and
; `mlDsaPolyChallenge` (SampleInBall, whose input is the challenge
; hash, published in the signature). `mlDsaPolyUseHint` and
; `mlDsaHintUnpack` are for verification and branch on public data.
;
; STANDARD. FIPS 204, Module-Lattice-Based Digital Signature Standard
; (August 2024): NTT and NTT^-1 (Algorithms 41 and 42), the reductions
; of Appendix A, Power2Round, Decompose, HighBits, LowBits, MakeHint and
; UseHint (Algorithms 35 to 40), RejNTTPoly, RejBoundedPoly, ExpandMask
; and SampleInBall (Algorithms 30, 31, 34 and 29), SimpleBitPack,
; BitPack, SimpleBitUnpack, BitUnpack, HintBitPack and HintBitUnpack
; (Algorithms 16 to 21).
;
; REFERENCE. A port of the pq-crystals Dilithium reference
; implementation, ref/ at commit d35ba3fe (ntt.c, reduce.c,
; rounding.c and poly.c; public domain under CC0, or Apache 2.0),
; including its table of twiddle factors. The bit encodings are written
; from FIPS 204's generic algorithms rather than the reference's
; unrolled ones. tests/crypto/600-mldsa-poly.ax checks every function
; here against Python written from FIPS 204's algorithms.
;
; LIMITS. Every address must name the memory stated. Sampling functions
; take a SHAKE state and a scratch buffer from their caller, reuse them,
; and leave the SHAKE state wiped.
(import Mem)
(import Crypto.Ct)
(import Crypto.Sha3)

; q = 2^23 - 2^13 + 1.
(pub :: mlDsaQ Int)
(pub fn (mlDsaQ)
  8380417)

; Bytes in one polynomial: 256 words.
(pub :: mlDsaPolyBytes Int)
(pub fn (mlDsaPolyBytes)
  2048)

; ------------------------------------------------------------------
; Reductions (reduce.c; FIPS 204 Appendix A).
; ------------------------------------------------------------------
; The low 32 bits of `x` as a signed value: C's (int32_t) cast.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: sext32 (-> Int Int))
;@axiom:ct(x)
(fn (sext32 x)
  (>> (<< x 32) 32))

; a 2^-32 modulo q, for |a| < 2^31 q: the reference's
; montgomery_reduce, answering a value in (-q, q).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaMontReduce (-> Int Int))
;@axiom:ct(a)
(pub fn (mlDsaMontReduce a)
  (let ((t (sext32 (* a 58728449))))
    (>> (- a (* t 8380417)) 32)))

; A value congruent to `a` modulo q in [-6283008, 6283008], for
; a <= 2^31 - 2^22 - 1 (reduce32).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaReduce32 (-> Int Int))
;@axiom:ct(a)
(pub fn (mlDsaReduce32 a)
  (let ((t (>> (+ a 4194304) 23)))
    (- a (* t 8380417))))

; `a` plus q when `a` is negative (caddq).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaCaddq (-> Int Int))
;@axiom:ct(a)
(pub fn (mlDsaCaddq a)
  (+ a (& (ctBarrier (>> a 63)) 8380417)))

; The representative of `a` in [0, q) (freeze).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaFreeze (-> Int Int))
;@axiom:ct(a)
(pub fn (mlDsaFreeze a)
  (mlDsaCaddq (mlDsaReduce32 a)))

; ------------------------------------------------------------------
; The number-theoretic transform (ntt.c; FIPS 204 Algorithms 41, 42).
; ------------------------------------------------------------------
; The 256 twiddle factors at `z`: zeta^brv(k) 2^32 mod q, centred, for
; zeta = 1753 (the reference's zetas table).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaZetaTable (-> Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`z` names 256 live writable words)
(pub fn (mlDsaZetaTable z)
  {
    (__store64 z 0 0) (__store64 z 1 25847) (__store64 z 2 -2608894) (__store64 z 3 -518909) (__store64 z 4 237124) (__store64 z 5 -777960) (__store64 z 6 -876248) (__store64 z 7 466468)
    (__store64 z 8 1826347) (__store64 z 9 2353451) (__store64 z 10 -359251) (__store64 z 11 -2091905) (__store64 z 12 3119733) (__store64 z 13 -2884855) (__store64 z 14 3111497) (__store64 z 15 2680103)
    (__store64 z 16 2725464) (__store64 z 17 1024112) (__store64 z 18 -1079900) (__store64 z 19 3585928) (__store64 z 20 -549488) (__store64 z 21 -1119584) (__store64 z 22 2619752) (__store64 z 23 -2108549)
    (__store64 z 24 -2118186) (__store64 z 25 -3859737) (__store64 z 26 -1399561) (__store64 z 27 -3277672) (__store64 z 28 1757237) (__store64 z 29 -19422) (__store64 z 30 4010497) (__store64 z 31 280005)
    (__store64 z 32 2706023) (__store64 z 33 95776) (__store64 z 34 3077325) (__store64 z 35 3530437) (__store64 z 36 -1661693) (__store64 z 37 -3592148) (__store64 z 38 -2537516) (__store64 z 39 3915439)
    (__store64 z 40 -3861115) (__store64 z 41 -3043716) (__store64 z 42 3574422) (__store64 z 43 -2867647) (__store64 z 44 3539968) (__store64 z 45 -300467) (__store64 z 46 2348700) (__store64 z 47 -539299)
    (__store64 z 48 -1699267) (__store64 z 49 -1643818) (__store64 z 50 3505694) (__store64 z 51 -3821735) (__store64 z 52 3507263) (__store64 z 53 -2140649) (__store64 z 54 -1600420) (__store64 z 55 3699596)
    (__store64 z 56 811944) (__store64 z 57 531354) (__store64 z 58 954230) (__store64 z 59 3881043) (__store64 z 60 3900724) (__store64 z 61 -2556880) (__store64 z 62 2071892) (__store64 z 63 -2797779)
    (__store64 z 64 -3930395) (__store64 z 65 -1528703) (__store64 z 66 -3677745) (__store64 z 67 -3041255) (__store64 z 68 -1452451) (__store64 z 69 3475950) (__store64 z 70 2176455) (__store64 z 71 -1585221)
    (__store64 z 72 -1257611) (__store64 z 73 1939314) (__store64 z 74 -4083598) (__store64 z 75 -1000202) (__store64 z 76 -3190144) (__store64 z 77 -3157330) (__store64 z 78 -3632928) (__store64 z 79 126922)
    (__store64 z 80 3412210) (__store64 z 81 -983419) (__store64 z 82 2147896) (__store64 z 83 2715295) (__store64 z 84 -2967645) (__store64 z 85 -3693493) (__store64 z 86 -411027) (__store64 z 87 -2477047)
    (__store64 z 88 -671102) (__store64 z 89 -1228525) (__store64 z 90 -22981) (__store64 z 91 -1308169) (__store64 z 92 -381987) (__store64 z 93 1349076) (__store64 z 94 1852771) (__store64 z 95 -1430430)
    (__store64 z 96 -3343383) (__store64 z 97 264944) (__store64 z 98 508951) (__store64 z 99 3097992) (__store64 z 100 44288) (__store64 z 101 -1100098) (__store64 z 102 904516) (__store64 z 103 3958618)
    (__store64 z 104 -3724342) (__store64 z 105 -8578) (__store64 z 106 1653064) (__store64 z 107 -3249728) (__store64 z 108 2389356) (__store64 z 109 -210977) (__store64 z 110 759969) (__store64 z 111 -1316856)
    (__store64 z 112 189548) (__store64 z 113 -3553272) (__store64 z 114 3159746) (__store64 z 115 -1851402) (__store64 z 116 -2409325) (__store64 z 117 -177440) (__store64 z 118 1315589) (__store64 z 119 1341330)
    (__store64 z 120 1285669) (__store64 z 121 -1584928) (__store64 z 122 -812732) (__store64 z 123 -1439742) (__store64 z 124 -3019102) (__store64 z 125 -3881060) (__store64 z 126 -3628969) (__store64 z 127 3839961)
    (__store64 z 128 2091667) (__store64 z 129 3407706) (__store64 z 130 2316500) (__store64 z 131 3817976) (__store64 z 132 -3342478) (__store64 z 133 2244091) (__store64 z 134 -2446433) (__store64 z 135 -3562462)
    (__store64 z 136 266997) (__store64 z 137 2434439) (__store64 z 138 -1235728) (__store64 z 139 3513181) (__store64 z 140 -3520352) (__store64 z 141 -3759364) (__store64 z 142 -1197226) (__store64 z 143 -3193378)
    (__store64 z 144 900702) (__store64 z 145 1859098) (__store64 z 146 909542) (__store64 z 147 819034) (__store64 z 148 495491) (__store64 z 149 -1613174) (__store64 z 150 -43260) (__store64 z 151 -522500)
    (__store64 z 152 -655327) (__store64 z 153 -3122442) (__store64 z 154 2031748) (__store64 z 155 3207046) (__store64 z 156 -3556995) (__store64 z 157 -525098) (__store64 z 158 -768622) (__store64 z 159 -3595838)
    (__store64 z 160 342297) (__store64 z 161 286988) (__store64 z 162 -2437823) (__store64 z 163 4108315) (__store64 z 164 3437287) (__store64 z 165 -3342277) (__store64 z 166 1735879) (__store64 z 167 203044)
    (__store64 z 168 2842341) (__store64 z 169 2691481) (__store64 z 170 -2590150) (__store64 z 171 1265009) (__store64 z 172 4055324) (__store64 z 173 1247620) (__store64 z 174 2486353) (__store64 z 175 1595974)
    (__store64 z 176 -3767016) (__store64 z 177 1250494) (__store64 z 178 2635921) (__store64 z 179 -3548272) (__store64 z 180 -2994039) (__store64 z 181 1869119) (__store64 z 182 1903435) (__store64 z 183 -1050970)
    (__store64 z 184 -1333058) (__store64 z 185 1237275) (__store64 z 186 -3318210) (__store64 z 187 -1430225) (__store64 z 188 -451100) (__store64 z 189 1312455) (__store64 z 190 3306115) (__store64 z 191 -1962642)
    (__store64 z 192 -1279661) (__store64 z 193 1917081) (__store64 z 194 -2546312) (__store64 z 195 -1374803) (__store64 z 196 1500165) (__store64 z 197 777191) (__store64 z 198 2235880) (__store64 z 199 3406031)
    (__store64 z 200 -542412) (__store64 z 201 -2831860) (__store64 z 202 -1671176) (__store64 z 203 -1846953) (__store64 z 204 -2584293) (__store64 z 205 -3724270) (__store64 z 206 594136) (__store64 z 207 -3776993)
    (__store64 z 208 -2013608) (__store64 z 209 2432395) (__store64 z 210 2454455) (__store64 z 211 -164721) (__store64 z 212 1957272) (__store64 z 213 3369112) (__store64 z 214 185531) (__store64 z 215 -1207385)
    (__store64 z 216 -3183426) (__store64 z 217 162844) (__store64 z 218 1616392) (__store64 z 219 3014001) (__store64 z 220 810149) (__store64 z 221 1652634) (__store64 z 222 -3694233) (__store64 z 223 -1799107)
    (__store64 z 224 -3038916) (__store64 z 225 3523897) (__store64 z 226 3866901) (__store64 z 227 269760) (__store64 z 228 2213111) (__store64 z 229 -975884) (__store64 z 230 1717735) (__store64 z 231 472078)
    (__store64 z 232 -426683) (__store64 z 233 1723600) (__store64 z 234 -1803090) (__store64 z 235 1910376) (__store64 z 236 -1667432) (__store64 z 237 -1104333) (__store64 z 238 -260646) (__store64 z 239 -3833893)
    (__store64 z 240 -2939036) (__store64 z 241 -2235985) (__store64 z 242 -420899) (__store64 z 243 -2286327) (__store64 z 244 183443) (__store64 z 245 -976891) (__store64 z 246 1612842) (__store64 z 247 -3545687)
    (__store64 z 248 -554416) (__store64 z 249 3919660) (__store64 z 250 -48306) (__store64 z 251 -1362209) (__store64 z 252 3937738) (__store64 z 253 1400424) (__store64 z 254 -846154) (__store64 z 255 1976782)
    0
  })

; `a` into the NTT domain, in place. Coefficients below q in magnitude
; come out below 9q.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaNtt (-> Int Int Int))
;@axiom:ct(*a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial and `z` the zeta table)
(pub fn (mlDsaNtt a z)
  (let ((mut k 0) (mut len 128))
    {
      (while (> len 0)
        {
          (let ((mut start 0))
            (while (< start 256)
              {
                (set k (+ k 1))
                (let ((zeta (__load64 z k)))
                  (for j start (+ start len)
                    (let (
                      (t (mlDsaMontReduce (* zeta (__load64 a (+ j len)))))
                      (aj (__load64 a j))
                    )
                      {
                        (__store64 a (+ j len) (- aj t))
                        (__store64 a j (+ aj t))
                      })))
                (set start (+ start (* 2 len)))
              }))
          (set len (>> len 1))
        })
      0
    }))

; `a` out of the NTT domain, in place, multiplied by the Montgomery
; factor 2^32 (invntt_tomont). Coefficients below q in magnitude.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaInvNttToMont (-> Int Int Int))
;@axiom:ct(*a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial and `z` the zeta table)
(pub fn (mlDsaInvNttToMont a z)
  (let ((mut k 256) (mut len 1))
    {
      (while (< len 256)
        {
          (let ((mut start 0))
            (while (< start 256)
              {
                (set k (- k 1))
                (let ((zeta (- 0 (__load64 z k))))
                  (for j start (+ start len)
                    (let ((t (__load64 a j)) (u (__load64 a (+ j len))))
                      {
                        (__store64 a j (+ t u))
                        (__store64 a (+ j len) (mlDsaMontReduce (* zeta (- t u))))
                      })))
                (set start (+ start (* 2 len)))
              }))
          (set len (<< len 1))
        })
      ; f = 2^64 / 256 mod q, so the result carries one factor of 2^32
      (for j 0 256
        (__store64 a j (mlDsaMontReduce (* 41978 (__load64 a j)))))
      0
    }))

; ------------------------------------------------------------------
; Coefficient-wise arithmetic (poly.c).
; ------------------------------------------------------------------
; Every coefficient of `a` reduced to [-6283008, 6283008].
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyReduce (-> Int Int))
;@axiom:ct(*a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial)
(pub fn (mlDsaPolyReduce a)
  {
    (for i 0 256
      (__store64 a i (mlDsaReduce32 (__load64 a i))))
    0
  })

; q added to every negative coefficient of `a`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyCaddq (-> Int Int))
;@axiom:ct(*a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial)
(pub fn (mlDsaPolyCaddq a)
  {
    (for i 0 256
      (__store64 a i (mlDsaCaddq (__load64 a i))))
    0
  })

; c = a + b, without reduction.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyAdd (-> Int Int Int Int))
;@axiom:ct(*c, *a, *b)
;@axiom:effect(unsafe)
;@axiom:precondition(`c`, `a` and `b` each name a live polynomial, `c` writable)
(pub fn (mlDsaPolyAdd c a b)
  {
    (for i 0 256
      (__store64 c i (+ (__load64 a i) (__load64 b i))))
    0
  })

; c = a - b, without reduction.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolySub (-> Int Int Int Int))
;@axiom:ct(*c, *a, *b)
;@axiom:effect(unsafe)
;@axiom:precondition(`c`, `a` and `b` each name a live polynomial, `c` writable)
(pub fn (mlDsaPolySub c a b)
  {
    (for i 0 256
      (__store64 c i (- (__load64 a i) (__load64 b i))))
    0
  })

; a = a 2^13 (shiftl, with d = 13).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyShiftL (-> Int Int))
;@axiom:ct(*a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial)
(pub fn (mlDsaPolyShiftL a)
  {
    (for i 0 256
      (__store64 a i (<< (__load64 a i) 13)))
    0
  })

; c = a b 2^-32 pointwise, for NTT-domain `a` and `b`
; (poly_pointwise_montgomery).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyPointwise (-> Int Int Int Int))
;@axiom:ct(*c, *a, *b)
;@axiom:effect(unsafe)
;@axiom:precondition(`c`, `a` and `b` each name a live polynomial, `c` writable)
(pub fn (mlDsaPolyPointwise c a b)
  {
    (for i 0 256
      (__store64 c i (mlDsaMontReduce (* (__load64 a i) (__load64 b i)))))
    0
  })

; c = c + a b 2^-32 pointwise: one term of a row of the matrix-vector
; product (polyvecl_pointwise_acc_montgomery's loop body).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyPointwiseAcc (-> Int Int Int Int))
;@axiom:ct(*c, *a, *b)
;@axiom:effect(unsafe)
;@axiom:precondition(`c`, `a` and `b` each name a live polynomial, `c` writable)
(pub fn (mlDsaPolyPointwiseAcc c a b)
  {
    (for i 0 256
      (__store64 c i (+ (__load64 c i) (mlDsaMontReduce (* (__load64 a i) (__load64 b i))))))
    0
  })

; 1 when some coefficient of `a`, taken as its centred value, is at
; least `bound` in magnitude; 0 when all are below it (poly_chknorm).
; Every coefficient is examined and the answer folded into one word, so
; the time says nothing about which coefficient was too large or its
; sign. Coefficients must be reduced (below q/2 in magnitude).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyChkNorm (-> Int Int Int))
;@axiom:ct(*a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live polynomial)
(pub fn (mlDsaPolyChkNorm a bound)
  (if (> bound 1047552)
    1
    (let ((mut over 0))
      {
        (for i 0 256
          (let ((c (__load64 a i)))
            (let ((abs (- c (& (ctBarrier (>> c 63)) (* 2 c)))))
              ; -1 exactly when abs >= bound
              (set over (| over (ctBarrier (^ (>> (- abs bound) 63) -1)))))))
        (& (ctBarrier over) 1)
      })))

; ------------------------------------------------------------------
; Rounding (rounding.c; FIPS 204 Algorithms 35 to 40).
; ------------------------------------------------------------------
; a1 and a0 with a = a1 2^13 + a0 and -2^12 < a0 <= 2^12, for each
; coefficient of `a` in [0, q) (Power2Round).
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyPower2Round (-> Int Int Int Int))
;@axiom:ct(*a1, *a0, *a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a1`, `a0` and `a` each name a live polynomial, `a1` and `a0` writable)
(pub fn (mlDsaPolyPower2Round a1 a0 a)
  {
    (for i 0 256
      (let ((c (__load64 a i)))
        (let ((hi (>> (+ c 4095) 13)))
          {
            (__store64 a0 i (- c (<< hi 13)))
            (__store64 a1 i hi)
          })))
    0
  })

; The high part of one coefficient `c` in [0, q) for 2 gamma2 = (q-1)/16
; or (q-1)/44, with the multiply-and-shift division of the reference.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlDsaHigh (-> Int Int Int))
;@axiom:ct(c)
(fn (mlDsaHigh c gamma2)
  (let ((t (>> (+ c 127) 7)))
    (if (== gamma2 261888)
      (& (>> (+ (* t 1025) 2097152) 22) 15)
      (let ((u (>> (+ (* t 11275) 8388608) 24)))
        (^ u (& (ctBarrier (>> (- 43 u) 63)) u))))))

; a1 = HighBits and a0 = LowBits of each coefficient of `a` in [0, q),
; for gamma2 = (q-1)/88 or (q-1)/32 (Decompose): a = a1 2 gamma2 + a0
; modulo q, with a0 centred and the top interval folded to a1 = 0.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyDecompose (-> Int Int Int Int Int))
;@axiom:ct(*a1, *a0, *a)
;@axiom:effect(unsafe)
;@axiom:precondition(`a1`, `a0` and `a` each name a live polynomial, `a1` and `a0` writable)
(pub fn (mlDsaPolyDecompose a1 a0 a gamma2)
  {
    (for i 0 256
      (let ((c (__load64 a i)))
        (let ((hi (mlDsaHigh c gamma2)))
          (let ((lo (- c (* hi (* 2 gamma2)))))
            {
              (__store64 a0 i (- lo (& (ctBarrier (>> (- 4190208 lo) 63)) 8380417)))
              (__store64 a1 i hi)
            }))))
    0
  })

; h = 1 where the low part `a0` overflows into the high part `a1` (the
; reference's make_hint: a0 > gamma2, a0 < -gamma2, or a0 = -gamma2
; with a1 nonzero), 0 elsewhere, computed with masks. Answers how many
; ones it wrote.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyMakeHint (-> Int Int Int Int Int))
;@axiom:ct(*h, *a0, *a1)
;@axiom:effect(unsafe)
;@axiom:precondition(`h`, `a0` and `a1` each name a live polynomial, `h` writable)
(pub fn (mlDsaPolyMakeHint h a0 a1 gamma2)
  (let ((mut n 0))
    {
      (for i 0 256
        (let ((lo (__load64 a0 i)) (hi (__load64 a1 i)))
          (let (
            (above (>> (- gamma2 lo) 63))
            (below (>> (+ lo gamma2) 63))
            (edge (& (ctMaskEq lo (- 0 gamma2)) (ctMaskNz hi)))
          )
            (let ((bit (& (| (| above below) edge) 1)))
              {
                (__store64 h i bit)
                (set n (+ n bit))
              }))))
      n
    }))

; b = the high part of `a` corrected by hint `h` (UseHint), for each
; coefficient of `a` in [0, q). For verification: branches on its
; inputs.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyUseHint (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`b`, `a` and `h` each name a live polynomial, `b` writable)
(pub fn (mlDsaPolyUseHint b a h gamma2)
  {
    (for i 0 256
      (let ((c (__load64 a i)))
        (let ((hi (mlDsaHigh c gamma2)))
          (let ((lo0 (- c (* hi (* 2 gamma2)))))
            (let ((lo (- lo0 (& (>> (- 4190208 lo0) 63) 8380417))))
              (__store64 b i
                (if (== (__load64 h i) 0)
                  hi
                  (== gamma2 261888)
                  (if (> lo 0)
                    (& (+ hi 1) 15)
                    (& (- hi 1) 15))
                  (> lo 0)
                  (if (== hi 43) 0 (+ hi 1))
                  (if (== hi 0) 43 (- hi 1)))))))))
    0
  })

; ------------------------------------------------------------------
; Sampling (poly.c; FIPS 204 Algorithms 29 to 34).
; ------------------------------------------------------------------
; Â[i][j] = RejNTTPoly(rho || j || i) at `a`: coefficients below q
; drawn as 23-bit values from SHAKE128 (poly_uniform). `x` is a SHAKE128
; state and `buf` 840 bytes of scratch. Variable time, on public data.
(pub :: mlDsaPolyUniform (-> Int Int Int Int Shake128 Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial, `rho` 32 live bytes and `buf` 840 live writable bytes)
(pub fn (mlDsaPolyUniform a rho i j x buf)
  (let ((mut ctr 0) (mut have 840))
    {
      (shake128Wipe x)
      (shake128AbsorbAddr x rho 32)
      (__store8 buf 0 j)
      (__store8 buf 1 i)
      (shake128AbsorbAddr x buf 2)
      (shake128SqueezeAddr x buf 840)
      (while (< ctr 256)
        {
          (let ((mut pos 0))
            (while (&& (< ctr 256) (<= (+ pos 3) have))
              (let ((t (& (| (__load8 buf pos) (| (<< (__load8 buf (+ pos 1)) 8) (<< (__load8 buf (+ pos 2)) 16))) 8388607)))
                {
                  (set pos (+ pos 3))
                  (if (< t 8380417)
                    {
                      (__store64 a ctr t)
                      (set ctr (+ ctr 1))
                      0
                    }
                    0)
                })))
          (if (< ctr 256)
            {
              ; 168, a SHAKE128 block, is a multiple of 3: nothing carries over
              (shake128SqueezeAddr x buf 168)
              (set have 168)
              0
            }
            0)
        })
      0
    }))

; s = RejBoundedPoly(seed || nonce) at `a`: coefficients in [-eta,
; eta] drawn from half-bytes of SHAKE256 over the 64-byte seed and the
; two-byte nonce (poly_uniform_eta). `x` is a SHAKE256 state and `buf`
; 136 bytes of scratch; both are wiped before it returns. Rejection
; sampling on secret bytes: a half-byte is rejected or kept
; independently of the value it would give, so the time reveals how
; many were drawn and nothing about the coefficients.
(pub :: mlDsaPolyUniformEta (-> Int Int Int Int Shake256 Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial, `seed` 64 live bytes and `buf` 136 live writable bytes)
(pub fn (mlDsaPolyUniformEta a seed nonce eta x buf)
  (let ((mut ctr 0))
    {
      (shake256Wipe x)
      (shake256AbsorbAddr x seed 64)
      (__store8 buf 0 (& nonce 255))
      (__store8 buf 1 (>> nonce 8))
      (shake256AbsorbAddr x buf 2)
      (while (< ctr 256)
        {
          (shake256SqueezeAddr x buf 136)
          (let ((mut pos 0))
            (while (&& (< ctr 256) (< pos 136))
              (let ((b (__load8 buf pos)))
                {
                  (set pos (+ pos 1))
                  (set ctr (mlDsaEtaCoeff a ctr (& b 15) eta))
                  (if (< ctr 256)
                    {
                      (set ctr (mlDsaEtaCoeff a ctr (>> b 4) eta))
                      0
                    }
                    0)
                })))
        })
      (ctWipe buf 136)
      (shake256Wipe x)
    }))

; Store the coefficient half-byte `t` gives at `a[ctr]` when it is
; accepted (CoeffFromHalfByte) and answer the next index. For eta = 2,
; t mod 5 is the reference's multiply-and-shift, not a division.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlDsaEtaCoeff (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial and 0 <= `ctr` < 256)
(fn (mlDsaEtaCoeff a ctr t eta)
  (if (== eta 2)
    (if (< t 15)
      {
        (__store64 a ctr (- 2 (- t (* (>> (* 205 t) 10) 5))))
        (+ ctr 1)
      }
      ctr)
    (if (< t 9)
      {
        (__store64 a ctr (- 4 t))
        (+ ctr 1)
      }
      ctr)))

; y = ExpandMask's polynomial for `nonce` at `a`: coefficients in
; (-gamma1, gamma1] from SHAKE256(seed || nonce), unpacked 18 or 20 bits
; at a time (poly_uniform_gamma1). `x` is a SHAKE256 state and `buf`
; 640 bytes of scratch; both are wiped before it returns.
;@axiom:restrict(no-io,no-foreign)
(pub :: mlDsaPolyUniformGamma1 (-> Int Int Int Int Shake256 Int Int))
;@axiom:ct(*a, *seed, *buf)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial, `seed` 64 live bytes and `buf` 640 live writable bytes)
(pub fn (mlDsaPolyUniformGamma1 a seed nonce gamma1 x buf)
  (let ((bits (if (== gamma1 131072) 18 20)))
    {
      (shake256Wipe x)
      (shake256AbsorbAddr x seed 64)
      (__store8 buf 0 (& nonce 255))
      (__store8 buf 1 (>> nonce 8))
      (shake256AbsorbAddr x buf 2)
      (shake256SqueezeAddr x buf (* 32 bits))
      (mlDsaPolyUnpack a buf bits gamma1)
      (ctWipe buf 640)
      (shake256Wipe x)
    }))

; c = SampleInBall(ctilde) at `c`: tau coefficients of +-1, the rest 0,
; from SHAKE256 over the `clen` bytes at `ctilde` (poly_challenge). `x`
; is a SHAKE256 state and `buf` 136 bytes of scratch. Variable time:
; the positions come from rejection sampling on the hash output.
(pub :: mlDsaPolyChallenge (-> Int Int Int Int Shake256 Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`c` names a live writable polynomial, `ctilde` `clen` live bytes and `buf` 136 live writable bytes)
(pub fn (mlDsaPolyChallenge c ctilde clen tau x buf)
  {
    (shake256Wipe x)
    (shake256AbsorbAddr x ctilde clen)
    (shake256SqueezeAddr x buf 136)
    (let ((mut signs (ld64le buf 0)) (mut pos 8))
      {
        (for i 0 256
          (__store64 c i 0))
        (for i (- 256 tau) 256
          (let ((mut b 256))
            {
              (while (> b i)
                {
                  (if (>= pos 136)
                    {
                      (shake256SqueezeAddr x buf 136)
                      (set pos 0)
                      0
                    }
                    0)
                  (set b (__load8 buf pos))
                  (set pos (+ pos 1))
                })
              (__store64 c i (__load64 c b))
              (__store64 c b (- 1 (* 2 (& signs 1))))
              (set signs (shrU signs 1))
            }))
        (ctWipe buf 136)
        (shake256Wipe x)
      })
  })

; ------------------------------------------------------------------
; Bit encodings (FIPS 204 Algorithms 16 to 21).
; ------------------------------------------------------------------
; Pack the 256 values b + s a_i, each in `bits` bits, little-endian bit
; order, into 32 `bits` bytes at `out`. `s` is 1 or -1.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlDsaPackBits (-> Int Int Int Int Int Int))
;@axiom:ct(*out, *a)
;@axiom:effect(unsafe)
;@axiom:precondition(`out` names 32 `bits` live writable bytes and `a` a live polynomial)
(fn (mlDsaPackBits out a bits s b)
  (let ((mask (- (<< 1 bits) 1)) (mut acc 0) (mut nacc 0) (mut pos 0))
    {
      (for i 0 256
        {
          (set acc (| acc (<< (& (+ b (* s (__load64 a i))) mask) nacc)))
          (set nacc (+ nacc bits))
          (while (>= nacc 8)
            {
              (__store8 out pos (& acc 255))
              (set pos (+ pos 1))
              (set acc (>> acc 8))
              (set nacc (- nacc 8))
            })
        })
      0
    }))

; Unpack 256 `bits`-bit values v_i from `in` and store b + s v_i at `a`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlDsaUnpackBits (-> Int Int Int Int Int Int))
;@axiom:ct(*a, *in)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial and `in` 32 `bits` live bytes)
(fn (mlDsaUnpackBits a in bits s b)
  (let ((mask (- (<< 1 bits) 1)) (mut acc 0) (mut nacc 0) (mut pos 0))
    {
      (for i 0 256
        {
          (while (< nacc bits)
            {
              (set acc (| acc (<< (__load8 in pos) nacc)))
              (set pos (+ pos 1))
              (set nacc (+ nacc 8))
            })
          (__store64 a i (+ b (* s (& acc mask))))
          (set acc (>> acc bits))
          (set nacc (- nacc bits))
        })
      0
    }))

; SimpleBitPack: the coefficients of `a`, each in [0, 2^bits), as 32
; `bits` bytes at `out`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolySimplePack (-> Int Int Int Int))
;@axiom:ct(*out, *a)
;@axiom:effect(unsafe)
;@axiom:precondition(`out` names 32 `bits` live writable bytes and `a` a live polynomial)
(pub fn (mlDsaPolySimplePack out a bits)
  (mlDsaPackBits out a bits 1 0))

; BitPack: the values b - a_i, each in [0, 2^bits), as 32 `bits` bytes
; at `out`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyPack (-> Int Int Int Int Int))
;@axiom:ct(*out, *a)
;@axiom:effect(unsafe)
;@axiom:precondition(`out` names 32 `bits` live writable bytes and `a` a live polynomial)
(pub fn (mlDsaPolyPack out a bits b)
  (mlDsaPackBits out a bits -1 b))

; SimpleBitUnpack: 256 `bits`-bit values from `in` into `a`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolySimpleUnpack (-> Int Int Int Int))
;@axiom:ct(*a, *in)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial and `in` 32 `bits` live bytes)
(pub fn (mlDsaPolySimpleUnpack a in bits)
  (mlDsaUnpackBits a in bits 1 0))

; BitUnpack: b - v_i for the 256 `bits`-bit values v_i at `in`, into
; `a`.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaPolyUnpack (-> Int Int Int Int Int))
;@axiom:ct(*a, *in)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` names a live writable polynomial and `in` 32 `bits` live bytes)
(pub fn (mlDsaPolyUnpack a in bits b)
  (mlDsaUnpackBits a in bits -1 b))

; HintBitPack: the positions of the ones in the `k` hint polynomials at
; `h`, then each polynomial's running count, as omega + k bytes at
; `out`. The ones must number at most omega. Branches on the hint,
; which the signature publishes.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaHintPack (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`out` names omega + k live writable bytes and `h` k live polynomials holding at most omega ones)
(pub fn (mlDsaHintPack out h k omega)
  (let ((mut idx 0))
    {
      (for i 0 (+ omega k)
        (__store8 out i 0))
      (for i 0 k
        {
          (for j 0 256
            (if (!= (__load64 h (+ (* i 256) j)) 0)
              {
                (__store8 out idx j)
                (set idx (+ idx 1))
                0
              }
              0))
          (__store8 out (+ omega i) idx)
        })
      0
    }))

; HintBitUnpack: the `k` hint polynomials encoded in the omega + k bytes
; at `in`, into `h`. Answers 0, or -1 when the encoding is malformed: a
; count that goes down or passes omega, positions within a polynomial
; that do not strictly increase, or a nonzero byte after the last
; position (Algorithm 21). `h` is then unspecified. Branches on the
; encoding, which is public.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: mlDsaHintUnpack (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`h` names k live writable polynomials and `in` omega + k live bytes)
(pub fn (mlDsaHintUnpack h in k omega)
  (let ((mut idx 0) (mut bad 0))
    {
      (for i 0 (* k 256)
        (__store64 h i 0))
      (for i 0 k
        (if (!= bad 0)
          0
          (let ((end (__load8 in (+ omega i))))
            (if (|| (< end idx) (> end omega))
              {
                (set bad 1)
                0
              }
              (let ((first idx))
                {
                  (while (&& (== bad 0) (< idx end))
                    {
                      (if (&& (> idx first) (>= (__load8 in (- idx 1)) (__load8 in idx)))
                        {
                          (set bad 1)
                          0
                        }
                        {
                          (__store64 h (+ (* i 256) (__load8 in idx)) 1)
                          0
                        })
                      (set idx (+ idx 1))
                    })
                  0
                })))))
      (if (== bad 0)
        (for i idx omega
          (if (!= (__load8 in i) 0)
            {
              (set bad 1)
              0
            }
            0))
        0)
      (if (== bad 0) 0 -1)
    }))
