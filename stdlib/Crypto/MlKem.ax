; Algorithm 17): the deterministic form, for known-answer tests.
; Never reuse an m.
(pub :: mlKem512EncapsDerand (-> MlKem512EncapsKey SecretBytes (Result MlKem512Encapsulated Error)))
;@axiom:effect(io)
