; `cryptoInvalidKey` when a 12-bit value in it is q or more.
(pub :: mlKem512EncapsKeyFromBytes (-> String (Result MlKem512EncapsKey Error)))
;@axiom:effect(unsafe)
(pub fn (mlKem512EncapsKeyFromBytes b)
  (match (mlkemCheckEk 2 b "mlKem512EncapsKeyFromBytes")
    ((Err e) (Err e))
    ((Ok _) (Ok (MlKem512EncapsKey (bytesFromAddr (strData b) (strLen b)))))))

; The encapsulation key's 800 bytes.
(pub :: mlKem512EncapsKeyBytes (-> MlKem512EncapsKey String))
(pub fn (mlKem512EncapsKeyBytes ek)
  ek.bytes)

; A ciphertext holding a copy of `b`, which must be 768 bytes. Any
; bytes of that length are a ciphertext: whether it decapsulates to
; the sender's secret is never reported.
(pub :: mlKem512CiphertextFromBytes (-> String (Result MlKem512Ciphertext Error)))
;@axiom:effect(unsafe)
(pub fn (mlKem512CiphertextFromBytes b)
  (if (!= (strLen b) 768)
    (cryptoLengthErr "an ML-KEM-512 ciphertext is 768 bytes" "mlKem512CiphertextFromBytes")
    (Ok (MlKem512Ciphertext (bytesFromAddr (strData b) 768)))))

; The ciphertext's 768 bytes.
(pub :: mlKem512CiphertextBytes (-> MlKem512Ciphertext String))
(pub fn (mlKem512CiphertextBytes c)
  c.bytes)

; A fresh ML-KEM-512 key pair (ML-KEM.KeyGen, Algorithm 19): d and z
; drawn from the kernel's entropy source straight into the store.
