    ((Err e) (Err e))))

; The 64-byte seed d || z the key was made from, as a new
; `SecretBytes`; `cryptoUnsupported` for a key imported expanded.
(pub :: mlKem1024KeyExportSeed (-> MlKem1024DecapsKey (Result SecretBytes Error)))
;@axiom:effect(io)
(pub fn (mlKem1024KeyExportSeed dk)
  (mlkemExportSeed 4 dk.slot "mlKem1024KeyExportSeed"))

; The expanded decapsulation key, 3168 bytes (dk_PKE || ek || H(ek) ||
; z), as a new `SecretBytes`.
(pub :: mlKem1024KeyExportExpanded (-> MlKem1024DecapsKey (Result SecretBytes Error)))
;@axiom:effect(io)
(pub fn (mlKem1024KeyExportExpanded dk)
  (mlkemExportExpanded 4 dk.slot))

; The encapsulation key that belongs to `dk`, to publish.
(pub :: mlKem1024EncapsKey (-> MlKem1024DecapsKey MlKem1024EncapsKey))
(pub fn (mlKem1024EncapsKey dk)
  (MlKem1024EncapsKey (mlkemEkBytesOf 4 dk.slot)))

; Encapsulate against `ek` (ML-KEM.Encaps, Algorithm 20): a fresh
; random m, the ciphertext, and the 32-byte shared secret. The key is
; checked first, as section 7.2 requires.
(pub :: mlKem1024Encaps (-> MlKem1024EncapsKey (Result MlKem1024Encapsulated Error)))
;@axiom:effect(io)
(pub fn (mlKem1024Encaps ek)
  (match (mlkemEncapsRandom 4 ek.bytes "mlKem1024Encaps")
    ((Ok r) (Ok (MlKem1024Encapsulated (MlKem1024Ciphertext r.ct) r.secret)))
    ((Err e) (Err e))))

; Encapsulate with the caller's 32-byte `m` (Encaps_internal,
; Algorithm 17): the deterministic form, for known-answer tests.
; Never reuse an m.
(pub :: mlKem1024EncapsDerand (-> MlKem1024EncapsKey SecretBytes (Result MlKem1024Encapsulated Error)))
;@axiom:effect(io)
(pub fn (mlKem1024EncapsDerand ek m)
  (match (mlkemEncapsDerand 4 ek.bytes m "mlKem1024EncapsDerand")
    ((Ok r) (Ok (MlKem1024Encapsulated (MlKem1024Ciphertext r.ct) r.secret)))
    ((Err e) (Err e))))

; Decapsulate `c` with `dk` (ML-KEM.Decaps, Algorithm 21): the 32-byte
; shared secret. A ciphertext that was tampered with, or never came
; from this key, answers the implicit-rejection secret J(z || c)
; instead, indistinguishably; only a ciphertext that is not 1568
; bytes is refused.
(pub :: mlKem1024Decaps (-> MlKem1024DecapsKey MlKem1024Ciphertext (Result SecretBytes Error)))
;@axiom:effect(io)
(pub fn (mlKem1024Decaps dk c)
  (mlkemDecaps 4 dk.slot c.bytes "mlKem1024Decaps"))

; Erase the key and free its store. Any later use of `dk` stops the
; program with status 85. Answers 0.
(pub :: mlKem1024KeyWipe (-> MlKem1024DecapsKey Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (mlKem1024KeyWipe dk)
  (secretBlockFree 26 dk.slot))
