  (mlkemExportSeed 2 dk.slot "mlKem512KeyExportSeed"))

; The expanded decapsulation key, 1632 bytes (dk_PKE || ek || H(ek) ||
; z), as a new `SecretBytes`.
(pub :: mlKem512KeyExportExpanded (-> MlKem512DecapsKey (Result SecretBytes Error)))
;@axiom:effect(io)
(pub fn (mlKem512KeyExportExpanded dk)
  (mlkemExportExpanded 2 dk.slot))

; The encapsulation key that belongs to `dk`, to publish.
(pub :: mlKem512EncapsKey (-> MlKem512DecapsKey MlKem512EncapsKey))
(pub fn (mlKem512EncapsKey dk)
  (MlKem512EncapsKey (mlkemEkBytesOf 2 dk.slot)))

; Encapsulate against `ek` (ML-KEM.Encaps, Algorithm 20): a fresh
; random m, the ciphertext, and the 32-byte shared secret. The key is
; checked first, as section 7.2 requires.
(pub :: mlKem512Encaps (-> MlKem512EncapsKey (Result MlKem512Encapsulated Error)))
;@axiom:effect(io)
(pub fn (mlKem512Encaps ek)
  (match (mlkemEncapsRandom 2 ek.bytes "mlKem512Encaps")
    ((Ok r) (Ok (MlKem512Encapsulated (MlKem512Ciphertext r.ct) r.secret)))
    ((Err e) (Err e))))

