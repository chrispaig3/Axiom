; Crypto.MlKem - ML-KEM (FIPS 203), the module-lattice key-encapsulation
; mechanism, in its three parameter sets: ML-KEM-512, -768 and -1024.
;
;     (match (mlKem768KeyGenerate)                      ; the receiver
;       ((Ok dk)
;         (let ((ek (mlKem768EncapsKey dk)))      ; publish ek's bytes
;           (match (mlKem768Encaps ek)            ; the sender
;             ((Ok sent)
;               ; send (mlKem768CiphertextBytes sent.ciphertext);
;               ; sent.secret is the sender's 32-byte shared secret
;               (mlKem768Decaps dk sent.ciphertext))   ; the same 32 bytes
;             ((Err e) (Err e)))))
;       ((Err e) (Err e)))
;
; WHAT IT GUARANTEES. Encapsulation against a receiver's encapsulation
; key answers a ciphertext and a 32-byte shared secret; decapsulation
; of that ciphertext with the matching decapsulation key answers the
; same secret. This is the primitive only: turning the secret into
; keys for a cipher, and authenticating who sent what, are the
; protocol's job.
;
; IMPLICIT REJECTION. Decapsulation never says whether a ciphertext was
; well formed. For a ciphertext that does not re-encrypt to itself it
; answers a pseudorandom secret, J(z || c), that the sender cannot
; know; the choice between that and the real secret is a mask made
; from a constant-time comparison of the whole ciphertext, with no
; branch, no early exit, no error and no log line. Only a ciphertext
; of the wrong length is refused, because its length is public.
;
; INPUT CHECKS. An encapsulation key must be 384k + 32 bytes and every
; 12-bit value in it below q (FIPS 203 section 7.2, the modulus check:
; ByteEncode12(ByteDecode12(ek)) equals ek), or it is refused with
; `cryptoInvalidKey`; encapsulation repeats the check on every call,
; because an `MlKem768EncapsKey` can be built by any module. An
; imported decapsulation key must have the right length and carry
; H(ek) matching its embedded ek (section 7.3), or `cryptoInvalidKey`.
;
; KEYS. A decapsulation key is a sealed handle in the secret store,
; kinds 24, 25 and 26 for the three sets, holding the FIPS 203
; decapsulation key dk = dk_PKE || ek || H(ek) || z and, when it was
; made from one, the 64-byte seed d || z it came from. The seed is
; the compact form to store (`...KeyExportSeed`); the expanded form
; is what other implementations may hand you (`...KeyFromExpanded`).
; Shared secrets come back as `SecretBytes`.
;
; CONSTANT TIME. The polynomial arithmetic is `Crypto.MlKemPoly`: no
; division or reduction by q on a secret uses a division instruction
; (KyberSlash), and the samplers have no table. The hashes are
; `Crypto.Sha3`. Every buffer holding a secret - s, e, y, e1, e2, the
; messages m and m', r, K', the input to J, the hash inputs - is
; wiped before a call returns, on every path.
;
; STANDARD. FIPS 203, Module-Lattice-Based Key-Encapsulation Mechanism
; Standard (August 2024): K-PKE (Algorithms 13-15), the internal
; algorithms (16-18), KeyGen, Encaps and Decaps (19-21) and the input
; checking of section 7. G is SHA3-512, H SHA3-256, J SHAKE256 with a
; 32-byte output, PRF SHAKE256 and XOF SHAKE128 (section 4.1). The
; key-generation hash is G(d || k) of the final standard, not the
; round-3 Kyber form. Checked against NIST's ACVP keyGen and
; encapDecap vectors, Wycheproof's ML-KEM files and OpenSSL 3.6, by
; tests/crypto/500-mlkem-acvp.ax and the other 5NN tests.
;
; REFERENCE. Written from FIPS 203 directly; no reference
; implementation's code was used.
;
; LIMITS. No vector instructions, and a polynomial is held as 256
; words, so each call takes about 20 KiB of scratch from the arena: the
; secret part is wiped before the call returns, and all of it is
; reclaimed only when the arena is.
(import Mem)
(import Str)
(import Err)
(import Crypto.Ct)
(import Crypto.Errors)
(import Crypto.Bytes)
(import Crypto.Random)
(import Crypto.Secret)
(import Crypto.Sha3)
(import Crypto.MlKemPoly)

; ------------------------------------------------------------------
; Parameters (FIPS 203 section 8, Table 2), as functions of k.
; ------------------------------------------------------------------
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemEta1 (-> Int Int))
(fn (mlkemEta1 k)
  (if (== k 2)
    3
    2))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemDu (-> Int Int))
(fn (mlkemDu k)
  (if (== k 4)
    11
    10))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemDv (-> Int Int))
(fn (mlkemDv k)
  (if (== k 4)
    5
    4))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemEkLen (-> Int Int))
(fn (mlkemEkLen k)
  (+ (* 384 k) 32))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemDkLen (-> Int Int))
(fn (mlkemDkLen k)
  (+ (* 768 k) 96))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemCtLen (-> Int Int))
(fn (mlkemCtLen k)
  (* 32 (+ (* (mlkemDu k) k) (mlkemDv k))))

; The secret-store kind of each set's decapsulation key: 24, 25, 26.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemKind (-> Int Int))
(fn (mlkemKind k)
  (+ k 22))

; ------------------------------------------------------------------
; Scratch. One block per call, laid out for the largest set:
;   [0, 4P)          a vector of k polynomials (s-hat or y-hat)
;   [4P, 5P)         T0, a matrix entry or decoded operand
;   [5P, 6P)         T1, the accumulator
;   [6P, 7P)         T2, a noise polynomial or second operand
;   B = 7P, then byte buffers:
;   [B, B+64)        PRF input: seed || N
;   [B+64, B+256)    PRF output, 64 * eta bytes
;   [B+256, B+320)   unused
;   [B+320, B+384)   input to G
;   [B+384, B+448)   output of G: K (or rho) then r (or sigma)
;   [B+448, B+480)   m or m'
;   [B+480, B+512)   H(ek), or K-bar
;   [B+512, B+2112)  c', the re-encryption
;   [B+2112, B+3712) input to J: z || c
;   [B+3744, B+3776) the shared secret answered
; where P = mlkemPolyBytes. Everything is wiped before the call
; answers.
; ------------------------------------------------------------------
(:: mlkemWorkBytes Int)
(fn (mlkemWorkBytes)
  18432)

(:: mlkemB Int)
(fn (mlkemB)
  14336)

(:: mlkemT0 (-> Int Int))
(fn (mlkemT0 w)
  (+ w 8192))

(:: mlkemT1 (-> Int Int))
(fn (mlkemT1 w)
  (+ w 10240))

(:: mlkemT2 (-> Int Int))
(fn (mlkemT2 w)
  (+ w 12288))

; The address of polynomial `i` of the vector at the start of `w`.
(:: mlkemVec (-> Int Int Int))
(fn (mlkemVec w i)
  (+ w (* i 2048)))

; ------------------------------------------------------------------
; The hash functions (FIPS 203 section 4.1).
; ------------------------------------------------------------------
; PRF_eta(s, b): 64 * eta bytes of SHAKE256(s || b) into the PRF
; output buffer, from the 32-byte seed at `s`; then SamplePolyCBD_eta
; of them into `p`.
(:: mlkemNoise (-> Int Int Int Int Int Int))
;@axiom:ct(*w, *s)
;@axiom:effect(unsafe)
;@axiom:precondition(`w` is live scratch, `s` names 32 live bytes and `p` a live writable polynomial)
(fn (mlkemNoise w s n eta p)
  (let ((inp (+ w mlkemB)) (out (+ w (+ mlkemB 64))))
    {
      (ctCopy inp s 32)
      (__store8 inp 32 n)
      (shake256Addr inp 33 out (* 64 eta))
      (mlkemSampleCbd p out eta)
    }))

; The public scratch, apart from the secret one so that nothing
; derived from a secret ever reaches the samplers of the public matrix:
;   [0, P)          a matrix entry, or a decoded t-hat[j]
;   [P, P + 34)     rho || j || i
(:: mlkemPubBytes Int)
(fn (mlkemPubBytes)
  2112)

; Matrix entry A-hat[i, j] = SampleNTT(rho || j || i) into the public
; scratch's polynomial, rho being already in place.
(:: mlkemMatrixEntry (-> Int Int Int Int))
;@axiom:effect(unsafe)
;@axiom:precondition(`pw` is live public scratch with rho in place)
(fn (mlkemMatrixEntry pw i j)
  (let ((seed (+ pw 2048)))
    {
      (__store8 seed 32 j)
      (__store8 seed 33 i)
      (mlkemSampleNtt pw seed)
    }))

; ------------------------------------------------------------------
; K-PKE (Algorithms 13-15).
; ------------------------------------------------------------------
; K-PKE.KeyGen(d): ek_PKE to `ekOut` (384k + 32 bytes) and dk_PKE to
; `dkOut` (384k bytes) from the 32-byte seed at `d`.
(:: kpkeKeyGen (-> Int Int Int Int Int Int Int))
;@axiom:ct(*d, *w)
;@axiom:effect(unsafe)
;@axiom:precondition(`d` names 32 live bytes, `ekOut` and `dkOut` their lengths for `k`, `w` is live scratch of `mlkemWorkBytes` and `pw` public scratch of `mlkemPubBytes`)
(fn (kpkeKeyGen k d ekOut dkOut w pw)
  (let (
    (b (+ w mlkemB))
    (eta1 (mlkemEta1 k))
    (t1 (mlkemT1 w))
    (t2 (mlkemT2 w))
  )
    (let (
      (gin (+ b 320))
      (rho (+ b 384))
      (sigma (+ b 416))
    )
      {
        ; (rho, sigma) <- G(d || k)
        (ctCopy gin d 32)
        (__store8 gin 32 k)
        (sha3_512Addr gin 33 rho)
        ; rho is public: the matrix is sampled from a copy of it outside
        ; the secret scratch
        (ctCopy (+ pw 2048) rho 32)
        ; s-hat
        (for i 0 k
          {
            (mlkemNoise w sigma i eta1 (mlkemVec w i))
            (mlkemNtt (mlkemVec w i))
          })
        ; t-hat[i] = sum_j A-hat[i, j] s-hat[j] + e-hat[i], written as it
        ; is made
        (for i 0 k
          {
            (mlkemNoise w sigma (+ k i) eta1 t2)
            (mlkemNtt t2)
            (mlkemWipe t1 2048)
            (for j 0 k
              {
                (mlkemMatrixEntry pw i j)
                (mlkemMulAcc t1 pw (mlkemVec w j))
              })
            (mlkemPolyAdd t1 t2)
            (mlkemByteEncode (+ ekOut (* 384 i)) t1 12)
          })
        (ctCopy (+ ekOut (* 384 k)) rho 32)
        (for i 0 k
          (mlkemByteEncode (+ dkOut (* 384 i)) (mlkemVec w i) 12))
        0
      })))

; K-PKE.Encrypt(ek, m, r): the ciphertext to `cOut`. `ek` is 384k + 32
; bytes that have passed the modulus check, `m` the 32-byte message
; and `r` the 32-byte randomness.
(:: kpkeEncrypt (-> Int Int Int Int Int Int Int Int))
;@axiom:ct(*m, *r, *w)
;@axiom:effect(unsafe)
;@axiom:precondition(`ek` names 384k + 32 live bytes, `m` and `r` 32 each, `cOut` the ciphertext length for `k`, `w` is live scratch not overlapping them except at its byte buffers, and `pw` public scratch)
(fn (kpkeEncrypt k ek m r cOut w pw)
  (let (
    (eta1 (mlkemEta1 k))
    (du (mlkemDu k))
    (dv (mlkemDv k))
    (t1 (mlkemT1 w))
    (t2 (mlkemT2 w))
  )
    {
      (ctCopy (+ pw 2048) (+ ek (* 384 k)) 32)
      ; y-hat
      (for i 0 k
        {
          (mlkemNoise w r i eta1 (mlkemVec w i))
          (mlkemNtt (mlkemVec w i))
        })
      ; u[i] = NTT^-1(sum_j A-hat[j, i] y-hat[j]) + e1[i], compressed
      ; and encoded as it is made
      (for i 0 k
        {
          (mlkemWipe t1 2048)
          (for j 0 k
            {
              (mlkemMatrixEntry pw j i)
              (mlkemMulAcc t1 pw (mlkemVec w j))
            })
          (mlkemInvNtt t1)
          (mlkemNoise w r (+ k i) 2 t2)
          (mlkemPolyAdd t1 t2)
          (mlkemCompress t1 du)
          (mlkemByteEncode (+ cOut (* (* 32 du) i)) t1 du)
        })
      ; v = NTT^-1(t-hat . y-hat) + e2 + Decompress_1(m)
      (mlkemWipe t1 2048)
      (for j 0 k
        {
          (mlkemByteDecode pw (+ ek (* 384 j)) 12)
          (mlkemMulAcc t1 pw (mlkemVec w j))
        })
      (mlkemInvNtt t1)
      (mlkemNoise w r (* 2 k) 2 t2)
      (mlkemPolyAdd t1 t2)
      (mlkemByteDecode t2 m 1)
      (mlkemDecompress t2 1)
      (mlkemPolyAdd t1 t2)
      (mlkemCompress t1 dv)
      (mlkemByteEncode (+ cOut (* (* 32 du) k)) t1 dv)
    }))

; K-PKE.Decrypt(dk_PKE, c): the 32-byte message to `mOut`.
(:: kpkeDecrypt (-> Int Int Int Int Int Int))
;@axiom:ct(*dk, *w)
;@axiom:effect(unsafe)
;@axiom:precondition(`dk` names 384k live bytes, `c` the ciphertext length for `k`, `mOut` 32 writable bytes, and `w` is live scratch)
(fn (kpkeDecrypt k dk c mOut w)
  (let (
    (du (mlkemDu k))
    (dv (mlkemDv k))
    (t0 (mlkemT0 w))
    (t1 (mlkemT1 w))
    (t2 (mlkemT2 w))
  )
    {
      ; s-hat . NTT(u')
      (mlkemWipe t1 2048)
      (for j 0 k
        {
          (mlkemByteDecode t0 (+ c (* (* 32 du) j)) du)
          (mlkemDecompress t0 du)
          (mlkemNtt t0)
          (mlkemByteDecode t2 (+ dk (* 384 j)) 12)
          (mlkemMulAcc t1 t2 t0)
        })
      (mlkemInvNtt t1)
      ; w = v' - NTT^-1(...), then m = ByteEncode_1(Compress_1(w))
      (mlkemByteDecode t0 (+ c (* (* 32 du) k)) dv)
      (mlkemDecompress t0 dv)
      (mlkemPolySub t0 t1)
      (mlkemCompress t0 1)
      (mlkemByteEncode mOut t0 1)
    }))

; ------------------------------------------------------------------
; The internal algorithms (16-18).
; ------------------------------------------------------------------
; ML-KEM.KeyGen_internal(d, z): the decapsulation key dk_PKE || ek ||
; H(ek) || z to `dkOut`.
(:: mlkemKeyGenInternal (-> Int Int Int Int Int Int Int))
;@axiom:ct(*d, *z, *w)
;@axiom:effect(unsafe)
;@axiom:precondition(`d` and `z` name 32 live bytes, `dkOut` the decapsulation key length for `k`, `w` is live scratch and `pw` public scratch)
(fn (mlkemKeyGenInternal k d z dkOut w pw)
  (let ((ek (+ dkOut (* 384 k))))
    {
      (kpkeKeyGen k d ek dkOut w pw)
      (sha3_256Addr ek (mlkemEkLen k) (+ dkOut (+ (* 768 k) 32)))
      (ctCopy (+ dkOut (+ (* 768 k) 64)) z 32)
      0
    }))

; ML-KEM.Encaps_internal(ek, m): the ciphertext to `cOut` and the
; shared secret K to the 32 bytes at `kOut`.
(:: mlkemEncapsInternal (-> Int Int Int Int Int Int Int Int))
;@axiom:ct(*m, *w)
;@axiom:effect(unsafe)
;@axiom:precondition(`ek` has passed the checks of section 7.2, `m` names 32 live bytes, `cOut` and `kOut` their lengths, `w` is live scratch and `pw` public scratch)
(fn (mlkemEncapsInternal k ek m cOut kOut w pw)
  (let ((b (+ w mlkemB)))
    (let ((gin (+ b 320)) (gout (+ b 384)) (h (+ b 480)))
      {
        ; (K, r) <- G(m || H(ek))
        (sha3_256Addr ek (mlkemEkLen k) h)
        (ctCopy gin m 32)
        (ctCopy (+ gin 32) h 32)
        (sha3_512Addr gin 64 gout)
        (kpkeEncrypt k ek m (+ gout 32) cOut w pw)
        (ctCopy kOut gout 32)
        0
      })))

; -1 when the `n` bytes at `a` and `b` are equal, 0 otherwise, in time
; that depends only on `n` (a multiple of 8). Each running difference
; passes through the barrier, so the loop cannot stop early.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: mlkemEqMask (-> Int Int Int Int))
;@axiom:ct(*a, *b)
;@axiom:effect(unsafe)
;@axiom:precondition(`a` and `b` each name `n` live bytes, and `n` is a multiple of 8)
(fn (mlkemEqMask a b n)
  (let ((mut d 0))
    {
      (for i 0 (>> n 3)
        (set d (ctBarrier (| d (^ (ld64le a (* 8 i)) (ld64le b (* 8 i)))))))
      (ctMaskZero d)
    }))

; ML-KEM.Decaps_internal(dk, c): the shared secret to `kOut`. K' when
; c re-encrypts to itself, K-bar = J(z || c) otherwise, chosen by a
; mask: no branch depends on the comparison.
(:: mlkemDecapsInternal (-> Int Int Int Int Int Int Int))
;@axiom:ct(*dk, *w)
;@axiom:effect(unsafe)
;@axiom:precondition(`dk` names the decapsulation key length for `k`, `c` the ciphertext length, `kOut` 32 writable bytes, `w` is live scratch and `pw` public scratch)
(fn (mlkemDecapsInternal k dk c kOut w pw)
  (let (
    (b (+ w mlkemB))
    (ctLen (mlkemCtLen k))
    (ek (+ dk (* 384 k)))
    (h (+ dk (+ (* 768 k) 32)))
    (z (+ dk (+ (* 768 k) 64)))
  )
    (let (
      (gin (+ b 320))
      (gout (+ b 384))
      (m2 (+ b 448))
      (kbar (+ b 480))
      (c2 (+ b 512))
      (jin (+ b 2112))
    )
      {
        (kpkeDecrypt k dk c m2 w)
        ; (K', r') <- G(m' || h)
        (ctCopy gin m2 32)
        (ctCopy (+ gin 32) h 32)
        (sha3_512Addr gin 64 gout)
        ; K-bar <- J(z || c)
        (ctCopy jin z 32)
        (ctCopy (+ jin 32) c ctLen)
        (shake256Addr jin (+ 32 ctLen) kbar 32)
        ; c' <- K-PKE.Encrypt(ek, m', r')
        (kpkeEncrypt k ek m2 (+ gout 32) c2 w pw)
        (let ((same (mlkemEqMask c c2 ctLen)))
          (for i 0 4
            (st64le kOut (* 8 i) (ctSelect same (ld64le gout (* 8 i)) (ld64le kbar (* 8 i))))))
        0
      })))

; ------------------------------------------------------------------
; Input checks (section 7).
; ------------------------------------------------------------------
; Whether the 384k bytes of t-hat in the encapsulation key at `ek`
; survive ByteDecode12 then ByteEncode12 unchanged, which is whether
; every 12-bit value is below q (section 7.2). The key is public, so
; the answer may stop at the first difference.
(:: mlkemEkReduced (-> Int Int Bool))
;@axiom:effect(unsafe)
;@axiom:precondition(`ek` names 384k live bytes)
(fn (mlkemEkReduced k ek)
  (let ((p (strAlloc mlkemPolyBytes)) (enc (strAlloc 384)) (mut ok true))
    {
      (for i 0 k
        {
          (mlkemByteDecode (strData p) (+ ek (* 384 i)) 12)
          (mlkemByteEncode (strData enc) (strData p) 12)
          (for j 0 384
            (if (!= (__load8 (strData enc) j) (__load8 ek (+ (* 384 i) j)))
              {
                (set ok false)
                0
              }
              0))
          0
        })
      ok
    }))

; The encapsulation-key checks of section 7.2 on `ek`: `Ok 0`, or the
; refusal.
(:: mlkemCheckEk (-> Int String String (Result Int Error)))
;@axiom:effect(unsafe)
(fn (mlkemCheckEk k ek where)
  (if (!= (strLen ek) (mlkemEkLen k))
    (cryptoLengthErr "an encapsulation key has the wrong length for its parameter set" where)
    (if (mlkemEkReduced k (strData ek))
      (Ok 0)
      (cryptoErr cryptoInvalidKey "the encapsulation key is not reduced modulo q (FIPS 203 7.2)" where))))

; ------------------------------------------------------------------
; Decapsulation keys in the secret store. The block:
;   [0, 64)       the seed d || z, when the key was made from one
;   [64, 72)      1 when it was, 0 when it was imported expanded
;   [128, ...)    dk = dk_PKE || ek || H(ek) || z
; ------------------------------------------------------------------
(:: mlkemBlockBytes (-> Int Int))
(fn (mlkemBlockBytes k)
  (+ 128 (mlkemDkLen k)))

; A fresh key block whose seed bytes are filled by `fill` (d at
; offset 0, z at 32), expanded. Answers the handle.
(:: mlkemKeyFromSeedBlock (-> Int Int (Result Int Error)))
;@axiom:effect(unsafe)
;@axiom:precondition(`h` is a live block of kind `mlkemKind k` whose seed bytes are set)
(fn (mlkemKeyFromSeedBlock k h)
  (let ((a (secretBlockAddr (mlkemKind k) h)) (work (strAlloc mlkemWorkBytes)) (pub (strAlloc mlkemPubBytes)))
    {
      (__store64 a 8 1)
      (mlkemKeyGenInternal k a (+ a 32) (+ a 128) (strData work) (strData pub))
      (mlkemWipe (strData work) mlkemWorkBytes)
      (Ok h)
    }))

; A key from the 32-byte d at `d` and 32-byte z at `z`.
(:: mlkemKeyFromParts (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`d` and `z` each name 32 live bytes)
(fn (mlkemKeyFromParts k d z)
  (match (secretBlockNew (mlkemKind k) (mlkemBlockBytes k))
    ((Err e) (Err e))
    ((Ok h)
      (let ((a (secretBlockAddr (mlkemKind k) h)))
        {
          (ctCopy a d 32)
          (ctCopy (+ a 32) z 32)
          (mlkemKeyFromSeedBlock k h)
        }))))

; A key from 64 fresh random bytes d || z, drawn straight into the
; store.
(:: mlkemKeyRandom (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemKeyRandom k)
  (match (secretBlockNew (mlkemKind k) (mlkemBlockBytes k))
    ((Err e) (Err e))
    ((Ok h)
      (match (randomFill (secretBlockAddr (mlkemKind k) h) 64)
        ((Err e)
          {
            (secretBlockFree (mlkemKind k) h)
            (Err e)
          })
        ((Ok _) (mlkemKeyFromSeedBlock k h))))))

; A key from separate d and z secrets (the KeyGen_internal inputs).
(:: mlkemKeyDerand (-> Int SecretBytes SecretBytes String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemKeyDerand k d z where)
  (if (|| (!= (secretLen d) 32) (!= (secretLen z) 32))
    (cryptoLengthErr "d and z are 32 bytes each" where)
    (mlkemKeyFromParts k (secretAddr d) (secretAddr z))))

; A key from the 64-byte seed d || z.
(:: mlkemKeyFromSeed (-> Int SecretBytes String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemKeyFromSeed k s where)
  (if (!= (secretLen s) 64)
    (cryptoLengthErr "an ML-KEM seed is 64 bytes, d || z" where)
    (mlkemKeyFromParts k (secretAddr s) (+ (secretAddr s) 32))))

; A key from the expanded FIPS 203 form, after the checks of 7.3: the
; length, and H(ek) against the hash the key carries.
(:: mlkemKeyFromExpanded (-> Int SecretBytes String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemKeyFromExpanded k s where)
  (if (!= (secretLen s) (mlkemDkLen k))
    (cryptoLengthErr "a decapsulation key has the wrong length for its parameter set" where)
    (let ((p (secretAddr s)) (hash (strAlloc 32)))
      {
        (sha3_256Addr (+ p (* 384 k)) (mlkemEkLen k) (strData hash))
        (if (== (mlkemEqMask (strData hash) (+ p (+ (* 768 k) 32)) 32) 0)
          (cryptoErr cryptoInvalidKey "the decapsulation key's H(ek) does not match its ek (FIPS 203 7.3)" where)
          (match (secretBlockNew (mlkemKind k) (mlkemBlockBytes k))
            ((Err e) (Err e))
            ((Ok h)
              {
                (ctCopy (+ (secretBlockAddr (mlkemKind k) h) 128) p (mlkemDkLen k))
                (Ok h)
              })))
      })))

; The seed d || z of key `h`, or `cryptoUnsupported` for a key that
; was imported in expanded form and never had one.
(:: mlkemExportSeed (-> Int Int String (Result SecretBytes Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemExportSeed k h where)
  (let ((a (secretBlockAddr (mlkemKind k) h)))
    (if (!= (__load64 a 8) 1)
      (cryptoErr cryptoUnsupported "this key was imported in expanded form and has no seed" where)
      (secretFromAddr a 64))))

; The expanded decapsulation key of `h`.
(:: mlkemExportExpanded (-> Int Int (Result SecretBytes Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemExportExpanded k h)
  (secretFromAddr (+ (secretBlockAddr (mlkemKind k) h) 128) (mlkemDkLen k)))

; The encapsulation key embedded in key `h`, as bytes.
(:: mlkemEkBytesOf (-> Int Int String))
;@axiom:effect(unsafe)
(fn (mlkemEkBytesOf k h)
  (bytesFromAddr (+ (secretBlockAddr (mlkemKind k) h) (+ 128 (* 384 k))) (mlkemEkLen k)))

; ------------------------------------------------------------------
; Encapsulation and decapsulation.
; ------------------------------------------------------------------
; What encapsulation produces, before the parameter set's own type
; wraps it.
(struct MlKemRaw
  (ct : String)
  (secret : SecretBytes))

; Encaps_internal on `ek` after the checks of 7.2, with the 32-byte m
; at `m` (drawn by the caller or given for a known answer).
(:: mlkemEncapsWith (-> Int String Int String (Result MlKemRaw Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:precondition(`m` names 32 live bytes)
(fn (mlkemEncapsWith k ek m where)
  (match (mlkemCheckEk k ek where)
    ((Err e) (Err e))
    ((Ok _)
      (let ((work (strAlloc mlkemWorkBytes)) (pub (strAlloc mlkemPubBytes)) (ct (strAlloc (mlkemCtLen k))))
        (let ((w (strData work)))
          (let ((kOut (+ w (+ mlkemB 3744))))
            {
              (mlkemEncapsInternal k (strData ek) m (strData ct) kOut w (strData pub))
              (let ((r (secretFromAddr kOut 32)))
                {
                  (mlkemWipe w mlkemWorkBytes)
                  (match r
                    ((Err e) (Err e))
                    ((Ok s) (Ok (MlKemRaw ct s))))
                })
            }))))))

; Encapsulation with a fresh random m.
(:: mlkemEncapsRandom (-> Int String String (Result MlKemRaw Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemEncapsRandom k ek where)
  (let ((m (strAlloc 32)))
    (let ((r
      (match (randomFill (strData m) 32)
        ((Err e) (Err e))
        ((Ok _) (mlkemEncapsWith k ek (strData m) where)))))
      {
        (mlkemWipe (strData m) 32)
        r
      })))

; Encapsulation with a caller's m (EncapsDerand).
(:: mlkemEncapsDerand (-> Int String SecretBytes String (Result MlKemRaw Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemEncapsDerand k ek m where)
  (if (!= (secretLen m) 32)
    (cryptoLengthErr "m is 32 bytes" where)
    (mlkemEncapsWith k ek (secretAddr m) where)))

; Decaps: the shared secret for ciphertext `ct` under key `h`. A
; ciphertext of the right length always answers a secret.
(:: mlkemDecaps (-> Int Int String String (Result SecretBytes Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (mlkemDecaps k h ct where)
  (if (!= (strLen ct) (mlkemCtLen k))
    (cryptoLengthErr "a ciphertext has the wrong length for its parameter set" where)
    (let ((work (strAlloc mlkemWorkBytes)) (pub (strAlloc mlkemPubBytes)))
      (let ((w (strData work)))
        (let ((kOut (+ w (+ mlkemB 3744))))
          {
            (mlkemDecapsInternal k (+ (secretBlockAddr (mlkemKind k) h) 128) (strData ct) kOut w (strData pub))
            (let ((r (secretFromAddr kOut 32)))
              {
                (mlkemWipe w mlkemWorkBytes)
                r
              })
          })))))

