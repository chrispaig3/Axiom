  (match (mlkemEncapsDerand 2 ek.bytes m "mlKem512EncapsDerand")
    ((Ok r) (Ok (MlKem512Encapsulated (MlKem512Ciphertext r.ct) r.secret)))
    ((Err e) (Err e))))

