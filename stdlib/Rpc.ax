; Rpc.ax — the LSP base protocol's framing, over a file descriptor.
;
; A message is a header block, `\r\n\r\n`, and exactly `Content-Length`
; bytes of UTF-8 body:
;
;   Content-Length: 47\r\n
;   \r\n
;   {"jsonrpc":"2.0","method":"initialized",...}
;
; WHY A BUFFERED READER. `Sys.sysReadFd` performs ONE `read`, and a
; read is permitted to return fewer bytes than asked - a pipe hands
; over whatever the writer has flushed. Framing therefore cannot be
; done by reading a header "then" a body: the header, the terminator
; and the first bytes of the body routinely arrive in one read, and the
; rest of the body in several more. Reading to EOF is no help either,
; because a language server's peer does not close the pipe between
; messages - it waits for a reply. So this keeps a buffer and consumes
; messages out of it.
;
;   word 0  fd
;   word 1  buf, a Str whose LENGTH is the capacity
;   word 2  filled    - bytes of `buf` holding data
;   word 3  consumed  - how far the reader has got
;
; Bytes between `consumed` and `filled` are a message-in-progress. When
; the buffer fills, the live region is compacted to the front before
; growing, so a long session over a small buffer does not grow without
; bound.
;
; CONTENT-LENGTH IS COUNTED IN BYTES, not characters - the spec says so,
; and getting it wrong would desynchronise the stream permanently on the
; first non-ASCII message rather than failing visibly.
; `IO` is deliberately NOT imported. It defines `die`, and so does the
; compiler's own `main.ax`; Axiom's namespace is flat, so a program
; holding both has an ambiguous `die` at every call site. Writing is
; three lines over `Sys` and costs nothing.
(import Mem)

(import Str)

(import Fmt)

(import Sys)

(:: rdCap Int)

(fn (rdCap) 65536)

; The largest `Content-Length` this framer will accept, in bytes. A
; header naming more than this is refused, and refused exactly the way
; a missing or unparseable one is.
;
; WHY THERE IS A CEILING AT ALL. The header block is peer-supplied
; bytes arriving on `axiom lsp`'s stdin, and `rdContentLength`
; accumulates the value with `(+ (* v 10) ...)`, which the backend
; emits as plain `mul`/`add` - no `nsw`, no trap - so accumulation is
; silent two's-complement wraparound and a peer can spell ANY i64.
; Measured, both as the second message of an otherwise ordinary
; session - the reader half is tests/stdlib/390-rpc-framing.ax, the
; whole-server half was `axiom lsp` on a pipe:
;
;   Content-Length: 9223372036854775800  followed by `{}`
;     `rpcRead` answered 65,497 bytes of the reader's OWN
;     UNINITIALISED BUFFER as the message body - a heap disclosure
;     straight back to the peer - and left `consumed` at
;     -9223372036854775777, after which `filled - consumed` was
;     negative for the life of the process. Driven through the server
;     it died at the next `memAlloc` with exit 70 and never answered
;     the `shutdown` queued behind it.
;
;   Content-Length: 18446744073709551621  followed by a 5-byte body
;     Worse, because nothing failed: 2^64 + 5 wraps to exactly 5 and
;     the framer accepted the message. A length field a peer can make
;     mean a different number than it says is a framing bug whether or
;     not anything crashes.
;
; WHY THIS NUMBER. 64 MiB. The largest `textDocument/didOpen` this
; repository can generate is its own biggest source file,
; self_host/codegen.ax at 503,809 bytes, which JSON-escapes into a
; 521,218-byte body - so the ceiling is 128x the largest legal message
; anyone here has ever sent, and a real editor document is three orders
; of magnitude under it. It is also small enough that the in-loop test
; cannot itself wrap: `v` is at most 67,108,864 when the test runs, so
; the next `v * 10 + 9` is at most 671,088,649, ten orders of magnitude
; short of i64. Raising this is safe up to about 9e17; lowering it
; below ~1 MiB would start refusing this compiler's own sources.
(:: rdMaxBody Int)

(fn (rdMaxBody) 67108864)

(pub :: rdNew (-> Int Int))

(pub fn (rdNew fd)
  (let ((r (memAlloc 32)))
    {
      (memSetWord r 0 fd)
      (memSetWord r 1 (strAlloc rdCap))
      (memSetWord r 2 0)
      (memSetWord r 3 0)
      r
    }
  )
)

(:: rdFd (-> Int Int))

(fn (rdFd r) (memGetWord r 0))

(pub :: rdBuf (-> Int String))

(pub fn (rdBuf r) (memGetWordStr r 1))

(pub :: rdFilled (-> Int Int))

(pub fn (rdFilled r) (memGetWord r 2))

(pub :: rdConsumed (-> Int Int))

(pub fn (rdConsumed r) (memGetWord r 3))

; Re-seat a reader on freshly allocated storage, carrying `u` bytes of
; not-yet-consumed input from `addr`.
;
; A caller that reclaims its arena between messages needs this: the
; reader's buffer was allocated inside the region being reclaimed, so
; it cannot be kept, and the bytes of the *next* message that this read
; already pulled in cannot be dropped. `u` may exceed the default
; capacity - a partially-read large message is exactly the case - so
; the new buffer is at least as big as what it has to hold.
(pub :: rdReseat (-> Int Int Int Int))

(pub fn (rdReseat r addr u)
  (let ((buf 
    (strAlloc
      (if (> u rdCap)
        u
        rdCap
      )
    )
  ))
    {
      (memCopy (strData buf) addr u)
      (memSetWord r 1 buf)
      (memSetWord r 2 u)
      (memSetWord r 3 0)
      r
    }
  )
)

; Move the live region to the front, and double the buffer if it is
; still full afterwards. Answers nothing useful; it mutates `r`.
(:: rdCompact (-> Int Int))

(fn (rdCompact r)
  (let (
    (buf (rdBuf r))
    (c (rdConsumed r))
    (f (rdFilled r))
  )
    {
      (if (> c 0)
        {
          (memCopy (strData buf) (+ (strData buf) c) (- f c))
          (memSetWord r 2 (- f c))
          (memSetWord r 3 0)
        }
        0
      )
      ; Still no room? Grow. `strLen` of the buffer is its capacity.
      (if (>= (rdFilled r) (strLen (rdBuf r)))
        (let ((bigger (strAlloc (* (strLen (rdBuf r)) 2))))
          {
            (memCopy (strData bigger) (strData (rdBuf r)) (rdFilled r))
            (memSetWord r 1 bigger)
          }
        )
        0
      )
      0
    }
  )
)

; One `read` into the free tail. Answers the byte count: 0 at end of
; file, negative on error.
(:: rdFill (-> Int Int))

;@axiom:effect(io)
(fn (rdFill r)
  {
    (if (>= (rdFilled r) (strLen (rdBuf r)))
      (rdCompact r)
      0
    )
    (let ((n (match (sysReadFd (rdFd r) (+ (strData (rdBuf r)) (rdFilled r)) (- (strLen (rdBuf r)) (rdFilled r))) ((Ok k) k) ((Err e) (- 0 (errCode e))))))
      {
        (if (> n 0)
          (memSetWord r 2 (+ (rdFilled r) n))
          0
        )
        n
      }
    )
  }
)

; Bytes read but not yet consumed: the message currently in progress.
(:: rdAvail (-> Int Int))

(fn (rdAvail r) (- (rdFilled r) (rdConsumed r)))

; The offset of `\r\n\r\n` within the unconsumed region, or -1.
;
; RELATIVE to `consumed`, and that is load-bearing rather than a
; matter of taste. `rdFill` may compact, which slides the live region
; to the front and resets `consumed` to 0; an offset taken as an
; ABSOLUTE buffer position before such a fill is stale by the old
; `consumed` afterwards. This module shipped that way for one commit,
; and the symptom was not a corrupt message but a SILENTLY DROPPED
; one: the reader mis-sliced, saw a short body, answered "", and the
; server read that as the client hanging up. It needed a message
; larger than the free space to fire, so every small fixture passed -
; measured, a 100,000-byte body was lost where 60,000 was fine, and
; `self_host/codegen.ax` is ~150 KB. Relative offsets are invariant
; under compaction, so the question cannot be got wrong again.
(:: rdFindHeaderEnd (-> Int Int))

(fn (rdFindHeaderEnd r)
  (let (
    (buf (rdBuf r))
    (base (rdConsumed r))
    (n (rdAvail r))
    (mut i 0)
    (mut found (- 0 1))
  )
    {
      (while (&& (< found 0) (<= (+ i 4) n))
        {
          (if (&& (== (strByte buf (+ base i)) 13) (&& (== (strByte buf (+ (+ base i) 1)) 10) (&& (== (strByte buf (+ (+ base i) 2)) 13) (== (strByte buf (+ (+ base i) 3)) 10))))
            (set found i)
            0
          )
          (set i (+ i 1))
        })
      found
    }
  )
)

; ASCII lower-case of one byte.
(:: rdLower (-> Int Int))

(fn (rdLower b)
  (if (&& (>= b 65) (<= b 90))
    (+ b 32)
    b
  )
)

; Does the buffer hold `word` at `at`, compared case-insensitively?
(:: rdMatchCI (-> Int Int String Int Bool))

(fn (rdMatchCI r at word i)
  (if (>= i (strLen word))
    true
    (if (>= (+ at i) (rdFilled r))
      false
      (if (== (rdLower (strByte (rdBuf r) (+ at i))) (rdLower (strByte word i)))
        (rdMatchCI r at word (+ i 1))
        false
      )
    )
  )
)

; The `Content-Length` value in the header block, which runs from the
; consume point to `hdrRel` bytes past it, or -1 when the header is
; absent, unparseable, or names more than `rdMaxBody` bytes. A message
; with no Content-Length is not a message, and neither is one whose
; length field a peer wrote to overflow the accumulator. `hdrRel` is
; relative, for the reason above.
;
; The three refusals answer the SAME -1 on purpose. `rpcRead` turns -1
; into "" and the server treats "" as the client having gone away; if
; an over-long header answered anything else, a peer could tell the
; ceiling from a typo and probe for it.
(:: rdContentLength (-> Int Int Int))

(fn (rdContentLength r hdrRel)
  (let (
    (buf (rdBuf r))
    (base (rdConsumed r))
    (mut i 0)
    (mut len (- 0 1))
    (mut over 0)
  )
    (let ((end (+ base hdrRel)))
      {
        (while (&& (== over 0) (&& (< len 0) (< i hdrRel)))
          {
            (if (rdMatchCI r (+ base i) "content-length:" 0)
              (let (
                (mut p (+ (+ base i) 15))
                (mut v 0)
                (mut digits 0)
              )
                {
                  (while (&& (< p end) (== (strByte buf p) 32))
                    (set p (+ p 1)))
                  ; The ceiling is tested HERE, after each digit, and
                  ; deliberately not on the finished value: by then the
                  ; total is the thing that wrapped, so its sign says
                  ; nothing - `9223372036854775800` is positive and
                  ; `18446744073709551621` reads back as 5. Testing per
                  ; digit also means the length of the digit run needs
                  ; no separate cap (a header carrying a thousand nines
                  ; stops as soon as `v` passes `rdMaxBody`) while
                  ; `Content-Length: 0000000000000005` stays legal,
                  ; which a digit-count cap would have broken.
                  (while (&& (== over 0) (&& (< p end) (&& (>= (strByte buf p) 48) (<= (strByte buf p) 57))))
                    {
                      (set v (+ (* v 10) (- (strByte buf p) 48)))
                      (set digits (+ digits 1))
                      (set p (+ p 1))
                      (if (> v rdMaxBody)
                        (set over 1)
                        0
                      )
                    })
                  (if (&& (== over 0) (> digits 0))
                    (set len v)
                    0
                  )
                }
              )
              0
            )
            (set i (+ i 1))
          })
        ; `len` is assigned only where `over` stayed 0, and `over`
        ; stops the outer scan too, so an over-long field falls out of
        ; here still holding the -1 a missing one answers. It must NOT
        ; fall through to a later `content-length:` in the same block -
        ; that would let a peer hide a real length behind an
        ; overflowing one and pick which of the two the framer used.
        len
      }
    )
  )
)

; Read one whole message and answer its body. An empty Str means the
; stream ended or broke - the caller stops, which is what an LSP does
; when its client goes away without saying `exit`.
(pub :: rpcRead (-> Int String))

;@axiom:effect(io)
(pub fn (rpcRead r)
  ; 1. A complete header block.
  (let (
    (mut hdr (- 0 1))
    (mut dead 0)
  )
    {
      (while (&& (< hdr 0) (== dead 0))
        {
          (set hdr (rdFindHeaderEnd r))
          (if (< hdr 0)
            (if (< (rdFill r) 1)
              (set dead 1)
              0
            )
            0
          )
        })
      (if (== dead 1)
        ""
        (let ((n (rdContentLength r hdr)))
          (if (< n 0)
            ""
            ; 2. Enough bytes for the body. Growing here is why
            ; `rdCompact` exists: a message larger than the
            ; buffer must still arrive. Every offset below is
            ; re-derived from `rdConsumed` AFTER the fills,
            ; because a fill may have compacted.
            ;
            ; AND NOTHING BELOW MAY FORM `bodyRel + n`. `n` is the
            ; peer's number and `bodyRel` is the framer's, so their sum
            ; is the one quantity here an attacker can push past i64;
            ; formed once, it wraps NEGATIVE, and a negative sum makes
            ; the wait-for-body test false on its first evaluation - so
            ; the reader slices a body that never arrived (measured:
            ; 65,497 bytes of uninitialised buffer, handed to the peer)
            ; and then stores the wrapped sum into `consumed`, after
            ; which `rdAvail` is negative for the life of the process
            ; and `rdFindHeaderEnd` scans a negative bound forever. Both
            ; sites below therefore keep `n` alone on one side.
            ; `(- (rdAvail r) bodyRel)` cannot go negative:
            ; `rdFindHeaderEnd` located the terminator inside the
            ; unconsumed region, so avail is at least `hdr + 4`. The
            ; consume cursor is likewise associated
            ; `(consumed + bodyRel) + n` and never
            ; `consumed + (bodyRel + n)`, which is the same sum a
            ; second time; the wait loop only falls through once
            ; avail - bodyRel >= n, so that total is at most `filled`.
            ; This shape is safe for ANY `n`, which is why it and not
            ; `rdMaxBody` is what closes the hole - the ceiling only
            ; turns a wait for a body that can never arrive into an
            ; immediate refusal.
            (let ((bodyRel (+ hdr 4)))
              {
                (while (&& (< (- (rdAvail r) bodyRel) n) (== dead 0))
                  (if (< (rdFill r) 1)
                    (set dead 1)
                    0
                  ))
                (if (== dead 1)
                  ""
                  ; `strDup`, not `strSlice`: a slice would SHARE
                  ; the reader's buffer, and the next compaction
                  ; memcpys within that same allocation - so a
                  ; body handed to the caller, or any substring
                  ; the JSON parser kept of it, would change
                  ; under them later. One copy per message is
                  ; nothing next to the parse that follows it.
                  (let ((body (strDup (strSlice (rdBuf r) (+ (rdConsumed r) bodyRel) n))))
                    {
                      (memSetWord r 3 (+ (+ (rdConsumed r) bodyRel) n))
                      body
                    }
                  )
                )
              }
            )
          )
        )
      )
    }
  )
)

; Write all of `s`. The short-write loop - a single `write` may
; transfer fewer bytes than asked, and treating that as success is how
; a reply gets silently truncated - is `Sys`'s, stated once there.
(:: rpcPut (-> Int String Int))

;@axiom:effect(io)
(fn (rpcPut fd s) (sysWriteAllFd fd (strData s) (strLen s) 0))

; Frame `body` and write it.
(pub :: rpcWrite (-> Int String Int))

;@axiom:effect(io)
(pub fn (rpcWrite fd body)
  {
    (rpcPut fd "Content-Length: ")
    (rpcPut fd (fmtInt (strLen body)))
    (rpcPut fd "\r\n\r\n")
    (rpcPut fd body)
    (strLen body)
  }
)
