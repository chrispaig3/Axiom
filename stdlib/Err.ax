; Err — Axiom's failure type, its error record, and the propagation
; form that binds one.
;
; The specification is `docs/error-model.md`; this module is its
; `ERR-TYPE-*` and `ERR-REC-2` rules made real. Three of its decisions
; are measured rather than preferred, and each is noted where it lands:
;
;   - `Result` is an ordinary declaration, not a built-in beside
;     `Option`. A user-declared two-parameter ADT already checks, is
;     pure to construct and inspect, and is reclaimed at a release
;     boundary; a built-in would cost a seed rebuild for none of that
;     (ERR-TYPE-2).
;   - conversion between error types is a FUNCTION, because a
;     two-parameter trait declares and checks and its `impl` is
;     AX2003, so there is no `From` to hang it on (ERR-TYPE-3).
;   - every payload field declares its real type. The reference map is
;     built from declared types, so a `String` behind an `Int` field is
;     invisible to release and leaks (ERR-TYPE-5 / ERR-MEM-1).
(import Str)

; ------------------------------------------------------------------
; The failure type.
;
; Success first: `Result Int Error` reads "an Int, or an Error". The
; type-parameter list is ONE group - `(a e)` - because `(a) (e)` reads
; the second group as a constructor named `e`.
; ------------------------------------------------------------------
(pub data Result (a e)
  (Ok a)
  (Err e))

; ------------------------------------------------------------------
; The canonical error record.
;
; `code` is a stable number, `message` says what happened with no
; trailing punctuation, and `context` says what the caller was doing -
; "" when nobody said. Three fields, well inside AX3029's 46-word
; cliff, and every one of them declared at the type it holds.
; ------------------------------------------------------------------
(pub struct Error
  (code : Int)
  (message : String)
  (context : String))

; The codes this module raises itself. A program's own codes live in
; its own space; these are the ones `ERR-REC-2` needs.
(pub :: errDivideByZero Int)

(pub fn (errDivideByZero) 1)

(pub :: errOverflow Int)

(pub fn (errOverflow) 2)

(pub :: errShiftTooWide Int)

(pub fn (errShiftTooWide) 3)

; A descriptor accepted some bytes and then accepted none, without an
; errno to say why. It is NOT a syscall error - `write` returned 0,
; which is a legal answer - so it cannot borrow an errno, and it is not
; success either, which is exactly why `Sys.sysWriteAllFd` could not
; express it while it answered an Int. `ERR-REC-3` calls a short write
; a failure and not an absence: the bytes were meant to go and did not.
(pub :: errShortWrite Int)

(pub fn (errShortWrite) 4)

(pub :: mkError (-> Int String Error))

(pub fn (mkError code message) (Error code message ""))

(pub :: errCode (-> Error Int))

(pub fn (errCode e) e.code)

(pub :: errMessage (-> Error String))

(pub fn (errMessage e) e.message)

(pub :: errContext (-> Error String))

(pub fn (errContext e) e.context)

; The rendering `main` writes to fd 2 (ERR-REC-4), and the one a
; program builds a longer report out of. A plain function rather than a
; `Show` instance: dispatch is keyed on a type NAME, so an instance
; reached through a type variable is AX3025, and every caller here has
; a concrete `Error` in hand anyway.
(pub :: errorText (-> Error String))

(pub fn (errorText e)
  (if (== (strLen e.context) 0)
    e.message
    (strConcat (strConcat e.message " while ") e.context)
  )
)

; ------------------------------------------------------------------
; Inspecting.
; ------------------------------------------------------------------
(pub :: isOk (-> (Result a e) Bool))

(pub fn (isOk r)
  (match r
    ((Ok x) true)
    ((Err y) false)
  )
)

(pub :: isErr (-> (Result a e) Bool))

(pub fn (isErr r)
  (match r
    ((Ok x) false)
    ((Err y) true)
  )
)

(pub :: unwrapOr (-> (Result a e) a a))

(pub fn (unwrapOr r fallback)
  (match r
    ((Ok x) x)
    ((Err y) fallback)
  )
)

; ------------------------------------------------------------------
; Transforming.
;
; `mapErr` is what `ERR-TYPE-3` leaves in place of `From`: conversion
; between two error types is a function the program calls, and the
; compiler finds nothing on its behalf.
; ------------------------------------------------------------------
(pub :: mapOk (-> (Result a e) (-> a b) (Result b e)))

(pub fn (mapOk r f)
  (match r
    ((Ok x) (Ok (f x)))
    ((Err y) (Err y))
  )
)

(pub :: mapErr (-> (Result a e) (-> e f) (Result a f)))

(pub fn (mapErr r f)
  (match r
    ((Ok x) (Ok x))
    ((Err y) (Err (f y)))
  )
)

(pub :: andThen (-> (Result a e) (-> a (Result b e)) (Result b e)))

(pub fn (andThen r f)
  (match r
    ((Ok x) (f x))
    ((Err y) (Err y))
  )
)

; Attach what the caller was doing to an error in flight, passing `Ok`
; through untouched. It needs no binder, so it is a function and not a
; form.
;
; The field reads go through `errContextOf` rather than being written
; inline in the arm, and that is not tidiness. A `match` binder over a
; polymorphic scrutinee does not carry its instantiated type: reading
; `y.code` in the arm below WAS AX3004 `expected struct or data type,
; found _t206`, because the checker instantiated `Result a Error`'s
; constructor field to a variable and never resolved it against the
; signature. Handing `y` to a function whose PARAMETER is declared
; `Error` got the concrete type back, and that is why every
; error-inspecting combinator in this module was shaped this way.
;
; It is no longer required: `ctorPatEnv` (2026-08-21) instantiates a
; constructor pattern's field types against the scrutinee's, so the
; arm can read `y.code` directly. This function stays because it is
; PUBLIC - `docs/stdlib-api.md` lists it and importers may call it -
; and because deleting an exported name to tidy a rule that no longer
; binds costs its callers and buys nothing. `docs/error-model.md`
; ERR-TYPE-3a records the retirement; `tests/stdlib/371-err-module.ax`
; term 2 checks the direct spelling against this one.
(pub :: errContextOf (-> Error String Error))

(pub fn (errContextOf e ctx) (Error e.code e.message ctx))

(pub :: withContext (-> (Result a Error) String (Result a Error)))

(pub fn (withContext r ctx)
  (match r
    ((Ok x) (Ok x))
    ((Err y) (Err (errContextOf y ctx)))
  )
)

; ------------------------------------------------------------------
; Option, converted explicitly.
;
; `Option` says ABSENT and `Result` says FAILED, AND HERE IS WHY. A
; missing map key and a failed syscall are different facts, so there is
; no implicit coercion in either direction (ERR-TYPE-4).
; ------------------------------------------------------------------
(pub :: okOr (-> (Option a) e (Result a e)))

(pub fn (okOr o e)
  (match o
    ((Some x) (Ok x))
    ((None) (Err e))
  )
)

(pub :: toOption (-> (Result a e) (Option a)))

(pub fn (toOption r)
  (match r
    ((Ok x) (Some x))
    ((Err y) None)
  )
)

; ------------------------------------------------------------------
; Option, on its own terms.
;
; WHY THESE ARE HERE AND NOT IN A MODULE OF THEIR OWN. `Option` is a
; compiler builtin, so it has no defining module to hold them, and
; fourteen public functions across `Str`, `Vec`, `Intern`, `Utf8` and
; `Path` answer one. Until 2026-09-03 the standard library shipped
; ZERO ways to consume one: every caller in the tree hand-wrote the
; same four-line `match`, including the ones a few lines above this.
; This section is where they go because `okOr` and `toOption` already
; put the two outcome types in one file, and a user who has an
; `(Option a)` from `vecTry` should not have to know which of two
; modules names the thing that reads it.
;
; THE NAMING follows `Result`'s, which is why it is not uniform.
; `isSome`/`isNone` are bare, mirroring `isOk`/`isErr`: an `is` name
; says which case, and the case names are already unambiguous. The
; transforms carry `opt` because `Result` took the bare spellings
; first - `mapOk`, `andThen`, `unwrapOr` - and this language has no
; overloading, so the alternative to a prefix is a worse name for one
; of the two types. Prefixing the newcomer is the smaller cost.
;
; EACH OF THE TWO HIGHER-ORDER FUNCTIONS COSTS A CLOSURE RECORD per
; call, which is not reclaimed - the closure-argument leak, the same
; one `vecSortBy` pays. It is bounded by the number of calls and not
; by the data, which is why these are worth having anyway; a loop that
; calls `optMap` per element pays per element, and should use `match`.
; ------------------------------------------------------------------
; Whether the `Option` holds a value. The `Option` half of `isOk`.
(pub :: isSome (-> (Option a) Bool))

(pub fn (isSome o)
  (match o
    ((Some x) true)
    ((None) false)
  )
)

; Whether the `Option` is empty. Exactly `isSome` negated, spelled
; out because a caller reads for the case it cares about.
(pub :: isNone (-> (Option a) Bool))

(pub fn (isNone o)
  (match o
    ((Some x) false)
    ((None) true)
  )
)

; The value, or `fallback` when there is none. The one combinator that
; ends the `Option` rather than passing it on, and the reason most
; call sites need no `match` at all.
(pub :: optUnwrapOr (-> (Option a) a a))

(pub fn (optUnwrapOr o fallback)
  (match o
    ((Some x) x)
    ((None) fallback)
  )
)

; Apply `f` to the value if there is one, leaving an absence alone.
; The result type is `f`'s, so this is how an `(Option Int)` becomes
; an `(Option String)`.
(pub :: optMap (-> (Option a) (-> a b) (Option b)))

(pub fn (optMap o f)
  (match o
    ((Some x) (Some (f x)))
    ((None) None)
  )
)

; Chain a step that may itself be absent, without nesting two
; `Option`s. `optMap` with a function answering `(Option b)` would
; give `(Option (Option b))`; this is that flattened.
(pub :: optAndThen (-> (Option a) (-> a (Option b)) (Option b)))

(pub fn (optAndThen o f)
  (match o
    ((Some x) (f x))
    ((None) None)
  )
)

; The first of two that is present. `alt` is EVALUATED at the call, so
; this is not a short-circuit: a caller whose alternative is expensive
; should write the `match`. Said here because the name is borrowed
; from languages where it is lazy.
(pub :: optOr (-> (Option a) (Option a) (Option a)))

(pub fn (optOr o alt)
  (match o
    ((Some x) (Some x))
    ((None) alt)
  )
)

; ------------------------------------------------------------------
; ERR-REC-2: a value-returning alternative for every trap.
;
; `/` and `%` are unchanged and still trap - the compiler emits a zero
; test even for a literal zero divisor, writes `axiom: division by
; zero` to fd 2 and exits 72 (MM-VAL-3a). These are different functions
; with a different return type, so no existing program's meaning moves
; and no hot loop pays for a check it did not ask for.
;
; `INT_MIN / -1` is guarded here too. It is one of MM-VAL-3b's three
; genuinely undefined cases - it answers -9223372036854775808 at
; `--opt 0` and 1 at `--opt 1`, which is the kind of disagreement a
; checked operator exists to end.
; ------------------------------------------------------------------
(pub :: intMin Int)

(pub fn (intMin) (- (- 0 9223372036854775807) 1))

; ------------------------------------------------------------------
; The three that WRAP.
;
; `+`, `-` and `*` emit plain `add`/`sub`/`mul` with no `nsw`, so
; overflow is silent two's-complement wraparound. That is the safer of
; the two wrong answers - without `nsw`, LLVM cannot treat overflow as
; undefined and start deleting the branches around it - but it is still
; a wrong answer, and it is the one an attacker reaches for.
;
; THIS IS NOT HYPOTHETICAL IN THIS REPOSITORY. `stdlib/Rpc.ax` carries
; the measurement: a peer's `Content-Length` added to the framer's own
; offset is "the one quantity here an attacker can push past i64;
; formed once, it wraps NEGATIVE", the wait-for-body test then passes
; on its first evaluation, and the reader slices a body that never
; arrived - 65,497 bytes of uninitialised buffer, handed to the peer.
;
; That site was fixed by hand, by never forming the sum. THE HAND-FIX
; DOES NOT GENERALISE AND THESE DO: every parser that adds a length it
; was told to an offset it computed has the same shape, and the fix is
; the same three lines each time. Written once here, they are a
; `try!` away instead.
;
; The tests are the standard sign tests rather than a wider type,
; because there is no wider type: `Int` is the only integer this
; language has, so a checked operator cannot compute in i128 and
; compare. `addChecked` asks whether the operands agreed in sign and
; the answer did not, which is the only way an addition can overflow;
; `subChecked` asks whether they DISAGREED and the answer differs from
; the first; `mulChecked` divides the answer back out, which is exact
; whenever the multiplication did not wrap.
(pub :: addChecked (-> Int Int (Result Int Error)))

(pub fn (addChecked a b)
  ; Both operands on the same side of zero, the answer on the other:
  ; the sign bit of `(a ^ s) & (b ^ s)` is set exactly then.
  (let ((s (+ a b)))
    (if (< (& (^ a s) (^ b s)) 0)
      (Err (mkError errOverflow "sum is not representable"))
      (Ok s)
    )
  )
)

(pub :: subChecked (-> Int Int (Result Int Error)))

(pub fn (subChecked a b)
  ; A subtraction can only overflow when the operands disagree in
  ; sign, and then only if the answer disagrees with the first.
  (let ((s (- a b)))
    (if (< (& (^ a b) (^ a s)) 0)
      (Err (mkError errOverflow "difference is not representable"))
      (Ok s)
    )
  )
)

(pub :: mulChecked (-> Int Int (Result Int Error)))

(pub fn (mulChecked a b)
  (if (|| (== a 0) (== b 0))
    ; Answered before the division below, which would otherwise be by
    ; zero - and a zero product cannot have wrapped.
    (Ok 0)
    ; `intMin * -1` is excluded HERE so the division below is never
    ; asked to compute `intMin / -1`, which is undefined and answers
    ; differently per `--opt` (MM-VAL-3b). Both operand orders are
    ; excluded, because it is the same overflow written the other way.
    ;
    ; THIS GUARD IS NOT OBSERVABLE IN THE ANSWER, and that is worth
    ; saying rather than implying a test covers it. Removing it was
    ; tried: `312-checked-arithmetic.ax` still passes, because the
    ; undefined division happens to answer something other than `b` at
    ; every level this compiler emits. The guard is here so the
    ; implementation never PERFORMS the undefined operation, not
    ; because the wrong answer would otherwise escape - a checked
    ; operator whose correctness rests on what UB happens to do is not
    ; a checked operator.
    (if (|| (&& (== a intMin) (== b (- 0 1))) (&& (== b intMin) (== a (- 0 1))))
      (Err (mkError errOverflow "product is not representable"))
      (let ((p (* a b)))
        (if (!= (/ p a) b)
          (Err (mkError errOverflow "product is not representable"))
          (Ok p)
        )
      )
    )
  )
)

(pub :: divChecked (-> Int Int (Result Int Error)))

(pub fn (divChecked a b)
  (if (== b 0)
    (Err (mkError errDivideByZero "divided by zero"))
    (if (&& (== a intMin) (== b (- 0 1)))
      (Err (mkError errOverflow "quotient is not representable"))
      (Ok (/ a b))
    )
  )
)

(pub :: remChecked (-> Int Int (Result Int Error)))

(pub fn (remChecked a b)
  (if (== b 0)
    (Err (mkError errDivideByZero "took the remainder by zero"))
    (if (&& (== a intMin) (== b (- 0 1)))
      (Err (mkError errOverflow "remainder is not representable"))
      (Ok (% a b))
    )
  )
)

; A shift amount of 64 or more, and a negative one, are undefined and
; no masking is emitted - `(<< 1 100)` answers 68719476736 at `--opt 0`
; and 1 at `--opt 1`.
(pub :: shlChecked (-> Int Int (Result Int Error)))

(pub fn (shlChecked a n)
  (if (|| (< n 0) (>= n 64))
    (Err (mkError errShiftTooWide "shifted by 64 or more"))
    (Ok (<< a n))
  )
)

(pub :: shrChecked (-> Int Int (Result Int Error)))

(pub fn (shrChecked a n)
  (if (|| (< n 0) (>= n 64))
    (Err (mkError errShiftTooWide "shifted by 64 or more"))
    (Ok (>> a n))
  )
)

; ------------------------------------------------------------------
; ERR-SUGAR-2: the propagation form.
;
; `(try! x e body)` binds `x` to `e`'s success and answers its error
; unchanged:
;
;   (try! v (parse s) (use v))
;     ->  (match (parse s)
;           ((Err er) (Err er))
;           ((Ok v) (use v)))
;
; The body lands in the ARM, which is exactly the shape ERR-PROP-3
; requires: a self call there is in tail position and converts to a
; loop, where the same call in the SCRUTINEE costs a frame per step and
; dies at 262,144. So the form makes the stack-correct spelling the
; default one and leaves the dangerous spelling to be written by hand.
;
; This could not be written until 2026-08-16. A macro parameter in a
; binder position was gensymed like a template's own binder, so the
; arm bound `x.N` while the caller's body still said `v` - AX3001, on
; the macro whose whole job is to bind it. `x` is the caller's name
; now (`expBinderParam`, self_host/expand.ax), and an argument that is
; not a name is AX3035 rather than a silently wrong expansion.
;
; `er` is the template's own binder and is still renamed at every
; expansion, so a caller whose body mentions `er` means their own.
(pub macro (try! x e body) (match e
  ((Err er) (Err er))
  ((Ok x) body)
))
