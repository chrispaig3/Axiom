;;! Intern - a string interner, in Axiom.
;
; An interner maps string *content* to a small dense `Int` id, and the id
; back to a string. That is the whole point of it: after interning, two
; strings are equal exactly when their ids are equal, so a compiler's
; scope lookups, keyword tests, and duplicate-definition checks become
; integer comparisons instead of byte-by-byte ones, and every later table
; can be keyed by a dense `Int` - which is what `Map` wants.
;
; An `Intern` is the address of a four-word header:
;
;     word 0 : strs  - a `Vec` of `Str` handles, indexed by id
;     word 1 : cap   - table slots, always a power of two
;     word 2 : table - address of cap words, each holding `id + 1`
;     word 3 : identity - this header's address, a nonowning scalar
;
; WHY SLOTS HOLD `id + 1`. Ids are dense and start at 0, so 0 is a valid
; id and cannot double as "empty". Storing `id + 1` makes 0 mean empty,
; and `rawAlloc` zeroes, so a fresh table needs no initialisation pass and
; no separate state array. `Map` cannot use this trick - its keys are
; arbitrary `Int`s, so it has no spare value - which is why it pays for a
; third array and this does not.
;
; NO DELETE, DELIBERATELY, so no tombstones. Un-interning is not a
; meaningful operation: an id handed out once may be stored anywhere, and
; taking it back would either invalidate those copies or leave a hole in
; the dense id space that `rawInternLookup` could not answer for. So the
; empty/occupied distinction is the only one the table needs. `Map`'s
; tombstone machinery is absent here because it is not needed, not
; because it was forgotten.
;
; WHY THIS DOES NOT REUSE `Map`. `Map`'s keys are `Int`s compared with
; `==`; interning needs keys compared with `strEq`. Function values and
; comparison callbacks work, but `Map` does not accept a key comparator.
; An alternative is `Map` from content
; hash to id, but that is wrong: two distinct strings with the same hash
; would be one `Map` key, and the second would silently get the first's
; id. Fixing that needs a `Vec` of ids per bucket, i.e. a chained map
; built on top of an open-addressed one. A purpose-built table that
; compares with `strEq` is smaller and exact, so that is what this is.
; The `Map` import is for the hash constants and `mapRoundUpPow2`, which
; are genuinely shared.
;
; The owning vector retains every interned string, including sliced
; strings and their backing storage. Callers may release their original
; bindings after interning; lookup results keep their own string share.
; Strings are compared by content and their bytes are not copied.
;
; Growth replaces the slot table and returns the old block to the free
; list. The owning Vec also reclaims its replaced element block.
(import Internal.Raw)
(import Internal.RawVec)
(import Str)
(import Vec)
(import Map)

; ------------------------------------------------------------------
; Hashing string content
;
; A polynomial hash mod `mapHashPrime`: h = (h * M + byte) mod P over the
; bytes, seeded. This is the string analogue of `Map`'s multiply-mod-prime
; integer hash and it is chosen for the same reasons - it needs only
; `+ * %`. Axiom also has bitwise operators; this interner uses a
; polynomial hash mod a prime with a fixed multiplier for deterministic
; content hashing. A random multiplier gives a provably
; almost-universal family rather than an empirically good mixer. The
; multiplier is fixed rather than per-process for the determinism reason
; given in `Map`.
;
; Bounds: `h` is always less than P < 2^31 and M < 2^31, so `h * M` is
; under 2^62 and cannot overflow a signed 64-bit `Int` even with a byte
; added.
;
; The length is not folded in at the end, and does not need to be: a
; polynomial hash already separates strings of different lengths, because
; appending a byte multiplies the accumulated value by M. Folding `strLen`
; in as well would be one more multiply for no additional separation, so
; it is left out rather than added as a reflex.
;
; There *is* one extra multiply at the end, for a different reason. In the
; bare recurrence the final byte is added without being multiplied, so two
; strings differing only in their last byte have hashes differing by
; exactly that byte difference - which means `x1`, `x2`, ... `x9`, or any
; family of identifiers distinguished by a trailing digit, land in nine
; *consecutive* slots. For a table masked by a power of two and probed
; linearly, that is a guaranteed cluster, and identifiers ending in digits
; are not a hypothetical input for a compiler. `rawInternFinishHash` runs the
; accumulator through one more multiply so that a last-byte difference is
; spread across the whole word like any other.
; ------------------------------------------------------------------
; The multiplier. Odd, no small factors, and under `mapHashPrime` so that
; the product bound above holds.
(:: rawInternStrMul Int)
(fn (rawInternStrMul)
  1099087573)

; The starting value. Any non-zero seed does; a zero seed would make every
; string of leading NULs hash to 0 regardless of length.
(:: rawInternHashSeed Int)
(fn (rawInternHashSeed)
  1234567891)

(:: rawInternHashStr (-> String Int))
(fn (rawInternHashStr s)
  (rawInternFinishHash (rawInternHashFrom s 0 rawInternHashSeed)))

; One final multiply, so that the last byte of the string is mixed rather
; than merely added. See the note above on trailing digits.
(:: rawInternFinishHash (-> Int Int))
(fn (rawInternFinishHash h)
  (% (* h rawInternStrMul) mapHashPrime))

(:: rawInternHashFrom (-> String Int Int Int))
(fn (rawInternHashFrom s i h)
  (if (>= i (strLen s))
    h
    (rawInternHashFrom s (+ i 1) (% (+ (* h rawInternStrMul) (strByte s i)) mapHashPrime))))

;; The slot `s` probes first, in [0, cap).
;
; The `< 0` guard is here for the same reason as `Map.mapSlotOf`'s: `%` is
; `srem` and preserves the sign of its left operand, and a negative index
; would be a wild store rather than a wrong answer. `rawInternHashStr` cannot
; return a negative value, and the guard costs one compare.
(pub :: rawInternSlotOf (-> String Int Int))
(pub fn (rawInternSlotOf s cap)
  {
    (let h (% (rawInternHashStr s) cap))
    (if (< h 0)
      (+ h cap)
      h)
  })

; ------------------------------------------------------------------
; Construction
; ------------------------------------------------------------------
; The slot allocation is a counted leaf with `cap` words. Its first
; word has the same scalar representation as every subsequent slot.
(struct InternWords sealed
  (first : Int))

;; An owning interner. Its raw handle is borrowed through `rawInternWordOf`.
;; Keep this owner alive while that handle is used.
(pub struct InternalInternState sealed
  (strings : Strings)
  (mut capacity : Int)
  (mut slots : InternWords)
  (identity : Int))

; The raw allocator starts the leaf at count zero. The counted return
; supplies the one share stored by the interner's ordinary field store.
(:: rawInternWordsNew (-> Int InternWords))
;@axiom:effect(unsafe)
(fn (rawInternWordsNew cap)
  (as (rawAlloc (* cap 8)) InternWords))

; Slots in a fresh interner. 64 rather than `Map`'s 8: an interner is a
; single long-lived table per compilation rather than one of thousands of
; small ones, so the interesting cost is rehashing a table that is going
; to hold thousands of identifiers, not the footprint of an empty one.
(:: rawInternDefaultCap Int)
(fn (rawInternDefaultCap)
  64)

;; An empty interner with `rawInternDefaultCap` slots.
;
; `rawInternDefaultCap` is a *slot* count, so it is passed straight to
; `rawInternAllocTable` and not through `rawInternWithCapacity`, which takes a
; *string* count and doubles it.
(pub :: rawInternNew Int)
(pub fn (rawInternNew)
  (rawInternAllocTable rawInternDefaultCap))

;; An empty owning interner with `rawInternDefaultCap` slots.
;; Scope cleanup releases its strings and slot allocation.
(pub :: rawInternNewTyped InternalInternState)
(pub fn (rawInternNewTyped)
  (rawInternAllocTableTyped rawInternDefaultCap))

;; Borrow the raw handle of a live owning interner.
;; The returned word remains valid only while `owner` is alive.
;; It carries no ownership share; do not pass it to `rawInternFree`.
(pub :: rawInternWordOf (-> InternalInternState Int))
(pub fn (rawInternWordOf owner)
  owner.identity)

;; An interner sized so `want` distinct strings fit without rehashing.
;
; Doubled before rounding up, because the load factor below is 0.5; see
; `Map.mapWithCapacity`, which makes the same promise for the same reason.
(pub :: rawInternWithCapacity (-> Int Int))
(pub fn (rawInternWithCapacity want)
  (rawInternAllocTable (rawInternCapacityFor want)))

; Two slots per requested string, each eight bytes. Reject requests
; beyond the allocator's maximum before doubling can overflow.
(:: rawInternCapacityFor (-> Int Int))
(fn (rawInternCapacityFor want)
  (if (> want 288230376151711744)
    -1
    (mapRoundUpPow2
      (*
        (if (< want 1)
          1
          want)
        2))))

; A header over a `Vec` and a zeroed table of `cap` words.
;
; The `Vec` is given `cap` elements of room even though only `cap / 2`
; strings will be interned before the next rehash, because the `Vec` is
; the one structure here that survives a rehash untouched, so sizing it
; generously costs one allocation and saves a growth step.
(:: rawInternAllocTable (-> Int Int))
(fn (rawInternAllocTable cap)
  (as (rawInternAllocTableTyped cap) Int))

(:: rawInternAllocTableTyped (-> Int InternalInternState))
;@axiom:effect(unsafe)
(fn (rawInternAllocTableTyped cap)
  ; Words 0 and 2 are the map (5 = bits 0 and 2): the `Vec` and
  ; the slot table. Word 1 is `cap`, a number, and is not in it.
  ; The `Vec` owns the strings pushed into it, so the header's
  ; death reaches every interned string - which is the whole point
  ; of an interner being freeable at all, since it is the structure
  ; that holds every identifier a compilation ever saw.
  {
    (let it (rawAllocMapped 32 5))
    (let strs (vecWithCapacity cap))
    (let tbl (rawInternWordsNew cap))
    {
      (rawSetWord it 0 strs)
      (rawSetWord it 1 cap)
      (rawSetWord it 2 tbl)
      (rawSetWord it 3 it)
      (as it InternalInternState)
    }
  })

;; Hand `it` back: the slot table, the `Vec`, and one share of every
;; string in it. Answers 0.
;; `it` must be a live interner owning this share. Its raw Int handle
;; and any unretained views into it must not be used after release.
(pub :: rawInternFree (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (rawInternFree it)
  {
    (__release it)
    0
  })

; ------------------------------------------------------------------
; Accessors
; ------------------------------------------------------------------
; The `Vec` of interned strings, indexed by id.
;
; Exposed because it *is* the id-to-string mapping, and a caller that
; wants to walk every interned string in id order should read it directly
; rather than call `rawInternLookup` in a loop and pay a bounds check per
; string.
(:: rawInternStrs (-> Int Int))
(fn (rawInternStrs it)
  (rawGetWord it 0))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(:: rawInternStrsVec (-> Int (Vec String)))
;@axiom:effect(unsafe)
(fn (rawInternStrsVec it)
  (as (rawInternStrs it) (Vec String)))

;; How many strings the table can hold before it grows.
(pub :: rawInternCap (-> Int Int))
(pub fn (rawInternCap it)
  (rawGetWord it 1))

(:: rawInternTable (-> Int Int))
(fn (rawInternTable it)
  (rawGetWord it 2))

;; How many distinct strings have been interned. Ids are exactly
;; 0..rawInternCount-1, with no gaps - that is what "dense" means here, and it
;; is what lets a caller size a side table by `rawInternCount` and index it by
;; id.
(pub :: rawInternCount (-> Int Int))
(pub fn (rawInternCount it)
  (vecLen (rawInternStrsVec it)))

;; The string with id `id`, or an empty `Str` if `id` was never handed out.
;
; An empty `Str` rather than 0: 0 is not a valid `Str` handle, and
; returning it would turn a caller's off-by-one into a null dereference
; inside `strLen` instead of a visible empty string. The cost is a 17-byte
; allocation on a path that only a buggy caller takes.
(pub :: rawInternLookup (-> Int Int String))
(pub fn (rawInternLookup it id)
  (if (< id 0)
    (strAlloc 0)
    (if (>= id (rawInternCount it))
      (strAlloc 0)
      (rawVecGetStr (rawInternStrsVec it) id))))

; ------------------------------------------------------------------
; Lookup
; ------------------------------------------------------------------
;; The id of a string equal in content to `s`, or `None`.
;
; Comparison is `strEq`, not handle identity - that is the entire point.
; Two `Str` handles built separately from the same bytes are different
; `Int`s and must still find the same id.
;
; The scan stops at the first empty slot, which proves absence because an
; id is always placed at or after its home slot within an unbroken run of
; occupied slots, and nothing is ever removed. `left` bounds the scan at
; `cap` so that a load factor bug shows up as a wrong answer rather than
; as a hang.
;
; Nested `if`s with one comparison each, rather than `&&` or a
; `Bool`-returning helper, for the code generation reasons documented at
; length above `Map`'s probe loops.
;
; `Option` RATHER THAN -1, and the raw helper is kept rather than
; inlined here. `compat/SENTINELS`'s direction rule is "absence wants
; `Option`", and a miss in an interner is absence in its purest form:
; the string is not in the table, which is not a failure of anything.
; What the sentinel cost is visible at every call site this port
; touched - nine of them, every one `(< id 0)`, each re-deriving that
; -1 is the miss from a comment rather than from the type.
;
; `rawInternFindFrom` KEEPS THE -1 and is what `rawInternIntern` calls, for
; the reason `Path.ax`'s `pathExtIndex` goes to `pathLastSlashFrom`
; directly: the interner's own hot path uses the answer as a BRANCH it
; immediately discards, once per interned string, and wrapping it there
; would allocate a block per intern to unwrap it on the next line. The
; public boundary is where the type is worth having; the recursion
; underneath it is not a boundary.
(pub :: rawInternFind (-> Int String (Option Int)))
(pub fn (rawInternFind it s)
  {
    (let id (rawInternFindFrom it s (rawInternSlotOf s (rawInternCap it)) (rawInternCap it)))
    (if (< id 0)
      None
      (Some id))
  })

(:: rawInternFindFrom (-> Int String Int Int Int))
(fn (rawInternFindFrom it s i left)
  (if (<= left 0)
    (- 0 1)
    {
      (let cell (rawGetWord (rawInternTable it) i))
      (if (== cell 0)
        (- 0 1)
        (if (strEq (rawVecGetStr (rawInternStrsVec it) (- cell 1)) s)
          (- cell 1)
          (rawInternFindFrom it s (mapNextSlot i (rawInternCap it)) (- left 1))))
    }))

; ------------------------------------------------------------------
; Interning
; ------------------------------------------------------------------
; True when the table should be rehashed before another string is added.
;
; Load factor 0.5, as in `Map`, and for the same probe-count reason. It is
; `rawInternCount` and not a separate counter because nothing is ever
; removed, so live entries and occupied slots are the same number - the
; one simplification that having no delete actually buys.
(:: rawInternNeedsGrow (-> Int Bool))
(fn (rawInternNeedsGrow it)
  (>= (* (rawInternCount it) 2) (rawInternCap it)))

;; The id for `s`, interning it if its content is new.
;
; Returns the ID; the caller keeps the stable interner handle. Its
; header is mutated in place, and every operation
; that reallocates - the table here, the `Vec`'s element block - replaces
; a pointer *inside* the header rather than the header itself. So an
; `Intern` handle is valid for the life of the interner and a caller needs
; to keep only the id. The cost is that this design cannot ever move the
; header, which rules out a compacting or copying arena; that is written
; down here because it is a real constraint on future work and not
; obvious from the signatures.
(pub :: rawInternIntern (-> Int String Int))
(pub fn (rawInternIntern it s)
  {
    (let existing (rawInternFindFrom it s (rawInternSlotOf s (rawInternCap it)) (rawInternCap it)))
    (if (>= existing 0)
      existing
      ; Grow first, so the id is placed into a table that is already
      ; under its load factor. Growing afterwards could leave the
      ; table with no empty slot for the next `rawInternFind` to stop
      ; at.
      {
        (if (rawInternNeedsGrow it)
          (rawInternRehash it (* (rawInternCap it) 2))
          it)
        (rawInternAdd it s)
      })
  })

; Append `s` with the next id and place that id in the table. Returns the
; id.
;
; The id is `vecLen` *before* the push, which is what makes ids dense: the
; nth distinct string interned gets id n.
(:: rawInternAdd (-> Int String Int))
(fn (rawInternAdd it s)
  {
    (let id (rawInternCount it))
    {
      (vecPush (rawInternStrsVec it) s)
      (rawInternPlace it id (rawInternSlotOf s (rawInternCap it)) (rawInternCap it))
      id
    }
  })

; Write `id + 1` into the first empty slot at or after `i`.
;
; No key comparison happens here: `rawInternIntern` has already established
; that the content is absent, so the first empty slot is the right one.
(:: rawInternPlace (-> Int Int Int Int Int))
(fn (rawInternPlace it id i left)
  (if (<= left 0)
    it
    (if (== (rawGetWord (rawInternTable it) i) 0)
      (rawSetWord (rawInternTable it) i (+ id 1))
      (rawInternPlace it id (mapNextSlot i (rawInternCap it)) (- left 1)))))

; ------------------------------------------------------------------
; Rehashing
; ------------------------------------------------------------------
; Rebuild the table at `newCap` slots. Returns the handle.
;
; The old table is never read. Because ids are dense and the `Vec` holds
; every interned string in id order, the entire table can be regenerated
; by walking ids 0..count-1 - so unlike `Map.mapRehash` there is no need
; to capture the old array first, and no chance of copying a stale slot.
; Having a dense id space pays for itself here.
(:: rawInternRehash (-> Int Int Int))
;@axiom:effect(unsafe)
;@axiom:pre((&& (> newCap 0) (== (& newCap (- newCap 1)) 0)))
(fn (rawInternRehash it newCap)
  {
    (let old (rawInternTable it))
    (let tbl (rawAlloc (* newCap 8)))
    {
      (__retain tbl)
      (rawSetWord it 1 newCap)
      (rawSetWord it 2 tbl)
      (rawInternReplaceFrom it 0)
      ; The table holds ids, not handles, so the old one is a leaf and
      ; goes straight back to the free list. The strings never moved -
      ; they live in the `Vec`, which a rehash does not touch, and
      ; that is exactly why the `Vec` is sized generously at
      ; construction.
      (__release old)
      it
    }
  })

(:: rawInternReplaceFrom (-> Int Int Int))
(fn (rawInternReplaceFrom it id)
  (if (>= id (rawInternCount it))
    it
    {
      (rawInternPlace it id
        (rawInternSlotOf (rawVecGetStr (rawInternStrsVec it) id) (rawInternCap it))
        (rawInternCap it))
      (rawInternReplaceFrom it (+ id 1))
    }))

(pub :: rawInternWithCapacityTyped (-> Int InternalInternState))
(pub fn (rawInternWithCapacityTyped want)
  (rawInternAllocTableTyped (rawInternCapacityFor want)))
