;;! Internal.MappingPlatform - platform mapping fallback.
(import Err)

;; The platform's own private mapping of `len` zeroed bytes, where raw
;; `mmap` is not available; `Err` 78 where the syscall serves.
(pub :: platformMapPrivate (-> Int (Result Int Error)))
(pub fn (platformMapPrivate len)
  (Err (mkError 78 "platformMapPrivate")))

;; The platform's own release of a private mapping; `Err` 78 here.
(pub :: platformUnmapPrivate (-> Int Int (Result Int Error)))
(pub fn (platformUnmapPrivate addr len)
  (Err (mkError 78 "platformUnmapPrivate")))

;; The platform's own shared mapping of `len` zeroed bytes; `Err` 78 here.
(pub :: platformMapShared (-> Int (Result Int Error)))
(pub fn (platformMapShared len)
  (Err (mkError 78 "platformMapShared")))

;; The platform's own release of a shared mapping; `Err` 78 here.
(pub :: platformUnmapShared (-> Int Int (Result Int Error)))
(pub fn (platformUnmapShared addr len)
  (Err (mkError 78 "platformUnmapShared")))

;; The platform's own way to pin `len` bytes at `addr` in memory, where
;; raw `mlock` is not available; `Err` 78 where the syscall serves.
(pub :: platformMlock (-> Int Int (Result Int Error)))
(pub fn (platformMlock addr len)
  (Err (mkError 78 "platformMlock")))

;; The platform's own way to unpin them; `Err` 78 here.
(pub :: platformMunlock (-> Int Int (Result Int Error)))
(pub fn (platformMunlock addr len)
  (Err (mkError 78 "platformMunlock")))
