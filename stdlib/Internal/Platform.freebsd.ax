(pub :: platformConnect (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformConnect s addr len)
  (- 0 78))

;; send(s, buf, n): bytes sent, or `-errno`. -78 here.
(pub :: platformSend (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformSend s buf n)
  (- 0 78))

;; shutdown(s, how): 0, or `-errno`. -78 here.
