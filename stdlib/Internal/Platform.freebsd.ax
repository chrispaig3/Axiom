(pub :: impl_soRcvTimeo Int)
(pub fn (impl_soRcvTimeo)
  4102)

;; SO_SNDTIMEO - how long a write may wait
(pub :: impl_soSndTimeo Int)
(pub fn (impl_soSndTimeo)
  4101)

;; SO_NOSIGPIPE - a write to a closed peer answers EPIPE instead of raising SIGPIPE; 0 where the option does not exist
(pub :: impl_soNoSigPipe Int)
(pub fn (impl_soNoSigPipe)
  2048)

;; MSG_NOSIGNAL - the same, per write, for `sendto`; 0 where the flag does not exist
(pub :: impl_msgNoSignal Int)
(pub fn (impl_msgNoSignal)
  131072)

;; IPPROTO_TCP - the level TCP options are set at
(pub :: impl_ipprotoTcp Int)
(pub fn (impl_ipprotoTcp)
  6)

;; TCP_NODELAY - send small writes at once rather than join them
(pub :: impl_tcpNoDelayOpt Int)
(pub fn (impl_tcpNoDelayOpt)
  1)

;; IPPROTO_IP - the level of the IPv4 socket options, 0 everywhere.
(pub :: impl_ipprotoIp Int)
(pub fn (impl_ipprotoIp)
  0)

;; IP_TTL - the time-to-live of outgoing IPv4 packets: 2 on Linux, 4 on the
;; BSDs.
(pub :: impl_ipTtl Int)
(pub fn (impl_ipTtl)
  4)

;; IPPROTO_IPV6 - the level of the IPv6 socket options, 41 everywhere.
(pub :: impl_ipprotoIpv6 Int)
(pub fn (impl_ipprotoIpv6)
  41)

;; IPV6_UNICAST_HOPS - the hop limit of outgoing IPv6 packets, IPv6's
;; time-to-live: 16 on Linux, 4 on the BSDs.
(pub :: impl_ipv6UnicastHops Int)
(pub fn (impl_ipv6UnicastHops)
  4)

; ------------------------------------------------------------------
; Files a database keeps open: reads and writes at an offset, a sync
