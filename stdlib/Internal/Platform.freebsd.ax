  475)

;; pwrite(fd, buf, count, offset) - 476, not 174
(pub :: impl_sysPwriteNum Int)
(pub fn (impl_sysPwriteNum)
  476)

;; fsync(fd) - 95
(pub :: impl_sysFsyncNum Int)
(pub fn (impl_sysFsyncNum)
  95)

;; ftruncate(fd, length) - 480, not 201
(pub :: impl_sysFtruncateNum Int)
(pub fn (impl_sysFtruncateNum)
  480)

;; flock(fd, operation) - 131
(pub :: impl_sysFlockNum Int)
(pub fn (impl_sysFlockNum)
  131)

;; 0: fsync itself reaches the medium
(pub :: impl_fsyncUsesFullFsync Int)
(pub fn (impl_fsyncUsesFullFsync)
  0)

;; none
(pub :: impl_fFullFsync Int)
(pub fn (impl_fFullFsync)
  0)

;; O_RDWR = 0x0002
(pub :: impl_oRdwr Int)
(pub fn (impl_oRdwr)
  2)

;; O_CREAT = 0x0200
(pub :: impl_oCreat Int)
(pub fn (impl_oCreat)
  512)

;; O_CLOEXEC = 0x00100000, so a spawned child never inherits the
