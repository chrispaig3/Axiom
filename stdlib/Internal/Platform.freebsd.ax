;;! Internal.Platform - the numbers this target's kernel uses: syscall
;;! numbers, open and socket flags, errno values, poll and signal
;;! constants and struct layouts. One file per target; every file
;;! declares the same names, and the build picks the one for the
;;! target being compiled for (this one is `freebsd`).
; `Err` for the `(Result Int Error)` the two descriptor calls below
; answer. `Err` imports `Str`, which imports `Mem` and
; `Vec`, and none of those import this module, so the edge is acyclic.
(import Err)

;; Sys.Platform - FreeBSD syscall numbers and flags.
;
; Selected by the `.freebsd.ax` filename suffix when compiling for
; `--target=freebsd-x86_64` or `--target=freebsd-aarch64` (see the
; compiler's module resolution). One file serves both architectures for
; the reason one Darwin file does: FreeBSD's `sys/sys/syscall.h` is
; generated once from `sys/kern/syscalls.master` with no architecture
; conditional in it, and every struct this file describes is
; fixed-width or pointer-sized, so amd64 and arm64 - both LP64 - lay it
; out identically. Linux is the odd one out, with a table per
; architecture, which is why its two files sit beside this one.
;
; FreeBSD is BSD, so the numbers here are Darwin's neighbours - `read`
; is 3, `write` 4, `open` 5 on both - WITHOUT Darwin's 0x2000000 class
; bit, and the kernel answers an error the BSD way, through the carry
; flag with a positive errno, which the backend's FreeBSD syscall
; templates normalise into `-errno` exactly as the Darwin ones do (see
; `targetSyscallAsm` in `core/codegen.ax`).
;
; FreeBSD is a source-only target (README, Targets). Every number here
; is read from stable/14's `sys/kern/syscalls.master` and the headers
; under `sys/sys/`, and each legacy near-miss is checked against the
; table: the ones that assemble, run and half-work are named beside the
; number they must not be confused with. CI builds the compiler from the
; seed in FreeBSD 14 virtual machines, x86_64 and aarch64, runs it to a
; fixpoint and runs one program with it, which executes the calls the
; compiler makes; the rest of `tests/stdlib` does not run there. The
; lines marked MEASURED were run on FreeBSD 14.4 arm64.
;
; FLOOR: FreeBSD 12. `kevent` 560 with the 64-byte record, `getrandom`
; 563 and the current `struct dirent` all arrived in 12; the compiler
; pins the triple at 14.0.
; read(fd, buf, count) - 3
(pub :: impl_sysReadNum Int)
(pub fn (impl_sysReadNum)
  3)

;; write(fd, buf, count) - 4
(pub :: impl_sysWriteNum Int)
(pub fn (impl_sysWriteNum)
  4)

;; open(path, flags, mode) - 5
(pub :: impl_sysOpenNum Int)
(pub fn (impl_sysOpenNum)
  5)

;; close(fd) - 6
(pub :: impl_sysCloseNum Int)
(pub fn (impl_sysCloseNum)
  6)

;; exit(status) - 1, and it ends the PROCESS. FreeBSD has no
;; `exit_group`; the thread-only call is `thr_exit` (431). This is the
;; number `targetExitNum` in `core/codegen.ax` also carries for the
;; emitted abort paths, and `scripts/check-platform-constants.sh` is the
;; gate that keeps the two copies equal.
(pub :: impl_sysExitNum Int)
(pub fn (impl_sysExitNum)
  1)

;; lseek(fd, offset, whence) - 478. NOT 199, which is `freebsd6_lseek`
;; (COMPAT6): the pre-7 entry with a padding word in its argument list,
;; which reads the offset from the wrong register and seeks somewhere
;; plausible.
(pub :: impl_sysLseekNum Int)
(pub fn (impl_sysLseekNum)
  478)

;; FreeBSD has a real `open`, so no `openat` indirection is needed.
(pub :: impl_openNeedsDirFd Int)
(pub fn (impl_openNeedsDirFd)
  0)

;; AT_FDCWD is -100 here as on Linux. Unused (see `openNeedsDirFd`),
;; defined so `Sys.ax` type-checks against every platform module, and
;; carrying the real value rather than a placeholder so that flipping
;; the capability above is one edit.
(pub :: impl_atFdCwd Int)
(pub fn (impl_atFdCwd)
  (- 0 100))

;; The `O_RDONLY` flag for `open` on this platform: read only.
(pub :: impl_oRdonly Int)
(pub fn (impl_oRdonly)
  0)

;; O_WRONLY | O_CREAT | O_TRUNC = 0x0001 | 0x0200 | 0x0400. These are
;; BSD's flag values, the same as Darwin's and NOT Linux's 577: Linux
;; puts O_CREAT at 0x40 and O_TRUNC at 0x200, so a copied 577 here is
;; O_WRONLY | O_TRUNC | 0x40, which is O_NOCTTY - a file that is
;; truncated and never created.
(pub :: impl_oWronlyCreateTrunc Int)
(pub fn (impl_oWronlyCreateTrunc)
  1537)

;; O_WRONLY | O_CREAT | O_APPEND = 0x0001 | 0x0200 | 0x0008. See the
;; Darwin file for why append is a flag and not a seek.
(pub :: impl_oWronlyCreateAppend Int)
(pub fn (impl_oWronlyCreateAppend)
  521)

;; The `whence` value for `lseek` that measures from the end of the
;; file.
(pub :: impl_seekEnd Int)
(pub fn (impl_seekEnd)
  2)

;; The `whence` value for `lseek` that measures from the start of the
;; file.
(pub :: impl_seekSet Int)
(pub fn (impl_seekSet)
  0)

; ------------------------------------------------------------------
;; Starting a child process.
;
; FreeBSD has NO `posix_spawn` syscall - libc's `posix_spawn` is built
; over `vfork`/`execve` - so the fork/exec pair is the only route, and
; it is the easy one: `fork` answers 0 in the child through the return
; register, as `forkChildIsZero` at the end of this file records.
(pub :: impl_spawnUsesPosixSpawn Int)
(pub fn (impl_spawnUsesPosixSpawn)
  0)

;; Unused here (see `spawnUsesPosixSpawn`), defined so `Sys.ax`
;; type-checks against every platform module.
(pub :: impl_sysPosixSpawnNum Int)
;@axiom:syscall(spawn)
(pub fn (impl_sysPosixSpawnNum)
  0)

;; wait4(pid, status, options, rusage) - 7.
(pub :: impl_sysWait4Num Int)
;@axiom:syscall(block)
(pub fn (impl_sysWait4Num)
  7)

;; fork() - 2. Takes no arguments; `sysForkArg` exists for AArch64
;; Linux, where fork is spelled `clone(SIGCHLD)`, and is ignored here.
(pub :: impl_sysForkNum Int)
;@axiom:syscall(spawn)
(pub fn (impl_sysForkNum)
  2)

;; The argument the platform's fork syscall takes: 0 where `fork` takes
;; none, the `clone` flags where it is `clone`.
(pub :: impl_sysForkArg Int)
(pub fn (impl_sysForkArg)
  0)

;; execve(path, argv, envp) - 59.
;; The `execve` syscall number, or 0 where the platform runs a child
;; through its own path.
(pub :: impl_sysExecveNum Int)
(pub fn (impl_sysExecveNum)
  59)

;; unlink(path) - 10.
(pub :: impl_sysUnlinkNum Int)
(pub fn (impl_sysUnlinkNum)
  10)

;; mkdir(path, mode) - 136. The plain call, so `openNeedsDirFd` is 0
;; and `sysMkdir` uses the two-argument form.
(pub :: impl_sysMkdirNum Int)
(pub fn (impl_sysMkdirNum)
  136)

;; rmdir(path) - 137.
(pub :: impl_sysRmdirNum Int)
(pub fn (impl_sysRmdirNum)
  137)

;; rename(from, to) - 128.
(pub :: impl_sysRenameNum Int)
(pub fn (impl_sysRenameNum)
  128)

; ------------------------------------------------------------------
;; Reading a directory.
;
; `getdirentries(fd, buf, nbytes, off_t *basep)` - 554, and NOT 196,
; which is `freebsd11_getdirentries` (COMPAT11): the pre-12 entry
; returning the 32-bit-inode `struct dirent`, a different layout that
; this file's `direntNameOffset` would read a name out of the middle
; of.
;
; The fourth argument is the same in/out position cookie Darwin's
; `getdirentries64` takes, so `dirReadNeedsPosition` sends `Sys.ax`
; down the Darwin branch. `basep` is optional to the kernel and always
; passed here.
(pub :: impl_sysGetdentsNum Int)
(pub fn (impl_sysGetdentsNum)
  554)

;; 1 where reading a directory needs a position argument
;; (`getdirentries`), 0 where `getdents` keeps its own.
(pub :: impl_dirReadNeedsPosition Int)
(pub fn (impl_dirReadNeedsPosition)
  1)

;; Where the name starts inside one record. FreeBSD 12's `dirent` is
;
;   u64 d_fileno; s64 d_off; u16 d_reclen; u8 d_type; u8 d_pad0;
;   u16 d_namlen; u16 d_pad1; char d_name[];
;
; so d_reclen sits at 16, as it does on Darwin and Linux - the one
; offset the portable decoder relies on - and the name begins at 24: a
; THIRD value, against Darwin's 21 and Linux's 19, because of the two
; padding fields. Records are padded to 8 and the shortest the kernel
; emits is `_GENERIC_DIRLEN(1)` = 32 bytes, so `Sys.ax`'s
; `reclen > direntNameOffset` guard is satisfied by every conforming
; record.
(pub :: impl_direntNameOffset Int)
(pub fn (impl_direntNameOffset)
  24)

; ------------------------------------------------------------------
;; The working directory.
;
; `__getcwd(buf, buflen)` - 326 - is a REAL SYSCALL here, and this is
; the one place FreeBSD is easier than Darwin, whose table has a hole
; at that number (see the Darwin file). It writes the NUL-terminated
; path left-aligned into `buf` and answers 0, not a length; `Sys.ax`
; reads the bytes rather than the result, which is the one reading
; both this and Linux's length-answering `getcwd` support. So no
; descriptor and no `fcntl` detour.
(pub :: impl_cwdUsesFcntlPath Int)
(pub fn (impl_cwdUsesFcntlPath)
  0)

;; fcntl(fd, cmd, arg) - BSD 92.
(pub :: impl_sysCwdNum Int)
(pub fn (impl_sysCwdNum)
  326)

;; Unused here (see `cwdUsesFcntlPath`), defined so `Sys.ax`
;; type-checks against every platform module.
;; The `fcntl` command that answers a descriptor's path, or 0 where the
;; platform has none.
(pub :: impl_fGetPath Int)
(pub fn (impl_fGetPath)
  0)

; ------------------------------------------------------------------
;; The two errno values portable code above compares against. Both
;; agree with Darwin and Linux; `eAgain` below does not, which is why
;; all three are names.
(pub :: impl_eExist Int)
(pub fn (impl_eExist)
  17)

;; The `EISDIR` errno: the path names a directory.
(pub :: impl_eIsDir Int)
(pub fn (impl_eIsDir)
  21)

;; getpid() - 20
(pub :: impl_sysGetPidNum Int)
(pub fn (impl_sysGetPidNum)
  20)

;; clock_gettime(clockid, ts) - 232. timespec is {tv_sec i64, tv_nsec
;; i64} on both 64-bit architectures, the layout `Sys.ax` reads.
(pub :: impl_sysClockNum Int)
(pub fn (impl_sysClockNum)
  232)

;; 1 where wall-clock time comes from `gettimeofday`, 0 where it comes
;; from `clock_gettime`.
(pub :: impl_clockIsGettimeofday Int)
(pub fn (impl_clockIsGettimeofday)
  0)

;; 1 where environment names match without regard to ASCII case, as
;; Windows matches them, 0 where they match byte for byte.
(pub :: impl_envNamesFoldCase Int)
(pub fn (impl_envNamesFoldCase)
  0)

;; `clock_gettime` answers CLOCK_MONOTONIC here, so `sysNowMonotonic` is
;; answerable and `sysNowMicros` is monotonic on this platform, as on
;; Linux. Darwin's copy of this file explains why the capability is not
;; simply assumed.
(pub :: impl_clockHasMonotonic Int)
(pub fn (impl_clockHasMonotonic)
  1)

;; CLOCK_MONOTONIC IS 4 HERE, AND THIS CONSTANT EXISTS BECAUSE OF THAT.
;; The literal 1 is CLOCK_MONOTONIC on Linux and CLOCK_VIRTUAL on
;; FreeBSD, the process's consumed CPU time. That clock never runs
;; backwards either, so no assertion would catch the mix-up: every
;; timeout would simply run at the ratio of CPU time to wall time.
;; `sys/sys/_clock_id.h`: REALTIME 0, VIRTUAL 1, PROF 2, MONOTONIC 4.
(pub :: impl_clockMonotonicId Int)
(pub fn (impl_clockMonotonicId)
  4)

;; Whether `Sys.ax` reads the arm64 counter for its monotonic clock,
;; which it does only where `clock_gettime` has none. 0 here.
(pub :: impl_clockHasCounter Int)
(pub fn (impl_clockHasCounter)
  0)

; --------------------------------------------------------------------
; Sockets
;
; BSD numbers without Darwin's class bit, so every syscall below is the
; Darwin file's number minus 0x2000000; the flag and option values are
; BSD's too, and agree with Darwin's throughout this group EXCEPT
; `afInet6`. Not one of them was executed here.
; --------------------------------------------------------------------
;; socket(domain, type, protocol) - 97.
(pub :: impl_sysSocketNum Int)
(pub fn (impl_sysSocketNum)
  97)

;; bind(fd, addr, addrlen) - 104. addrlen is 16 for `sockaddr_in`, 28
;; for `sockaddr_in6`; `Sys.ax` reads it off the family in the buffer.
(pub :: impl_sysBindNum Int)
(pub fn (impl_sysBindNum)
  104)

;; listen(fd, backlog) - 106.
(pub :: impl_sysListenNum Int)
(pub fn (impl_sysListenNum)
  106)

;; accept(fd, addr, addrlen) - 30. FreeBSD does have `accept4` (541,
;; with SOCK_NONBLOCK = 0x20000000) and it is not used: `IO.socketAccept`
;; takes the Darwin shape - a plain `accept`, then `fcntl` - so the two
;; BSDs share one path. The fourth argument it passes is 0, and ignored
;; here as Darwin ignores it.
;
; MEASURED on FreeBSD 14.4 arm64, and it is the one place
; this kernel and Darwin's disagree about the same call: with an
; address buffer shorter than the peer's 16 bytes, `accept` writes the
; COPIED length back - caps of 4, 8 and 12 answered 4, 8 and 12 -
; where Darwin and Linux write the whole 16. The whole length still
; arrives, in `sin_len` at byte 0, whenever one byte fits. `IO` asks
; for a peer's address into a buffer of `netAddrMaxBytes`, which every
; address fits, so the difference never shows.
(pub :: impl_sysAcceptNum Int)
(pub fn (impl_sysAcceptNum)
  30)

;; connect(fd, addr, addrlen) - 98.
(pub :: impl_sysConnectNum Int)
(pub fn (impl_sysConnectNum)
  98)

;; setsockopt(fd, level, name, val, len) - 105.
(pub :: impl_sysSetSockOptNum Int)
(pub fn (impl_sysSetSockOptNum)
  105)

;; getsockopt(fd, level, name, val, lenptr) - 118.
(pub :: impl_sysGetSockOptNum Int)
(pub fn (impl_sysGetSockOptNum)
  118)

;; shutdown(fd, how) - 134.
(pub :: impl_sysShutdownNum Int)
(pub fn (impl_sysShutdownNum)
  134)

;; fcntl(fd, cmd, arg) - 92. Distinct from `sysCwdNum`, which is
;; `__getcwd` here and `fcntl(F_GETPATH)` on Darwin.
(pub :: impl_sysFcntlNum Int)
(pub fn (impl_sysFcntlNum)
  92)

;; The address family and socket type. `AF_INET` is 2 on both systems -
;; and that agreement is a trap, because `AF_INET6` is 30 here against
;; Linux's 10, so nothing else in this group may be assumed to match.
(pub :: impl_afInet Int)
(pub fn (impl_afInet)
  2)

;; AF_INET6 IS 28 - A THIRD VALUE, against Darwin's 30 and Linux's 10,
;; and the one constant in this group that agrees with neither
;; neighbour. `afInet` is 2 everywhere, and the Darwin file already
;; calls that agreement a trap; here it is a trap twice over, because
;; the rest of this group DOES agree with Darwin and a reader who
;; generalises from that copies 30. A wrong family fails loudly at
;; `socket` with -47 EAFNOSUPPORT (measured on Darwin for the reverse
;; mistake), which is the one mercy. `scripts/check-net.sh`'s IPv6 arm
;; - a listener on `::1` and a round-tripped connection - is the probe,
;; on the day a FreeBSD leg runs it.
(pub :: impl_afInet6 Int)
(pub fn (impl_afInet6)
  28)

;; The `SOCK_STREAM` socket type: a TCP byte stream.
(pub :: impl_sockStream Int)
(pub fn (impl_sockStream)
  1)

;; BSD's socket-option numbers, shared with Darwin: `SOL_SOCKET` is
;; 0xffff, and `SO_*` are bitmask-style constants where Linux's are
;; small sequential integers. A Linux number here sets some other
;; option rather than failing.
(pub :: impl_solSocket Int)
(pub fn (impl_solSocket)
  65535)

;; SO_REUSEADDR 0x0004.
;; The `SO_REUSEADDR` socket option.
(pub :: impl_soReuseAddr Int)
(pub fn (impl_soReuseAddr)
  4)

;; SO_REUSEPORT 0x0200.
;; The `SO_REUSEPORT` socket option.
(pub :: impl_soReusePort Int)
(pub fn (impl_soReusePort)
  512)

;; SO_ERROR 0x1007.
;; The `SO_ERROR` socket option, read after a non-blocking connect
;; finishes.
(pub :: impl_soError Int)
(pub fn (impl_soError)
  4103)

;; fcntl's file-status commands, and the flag a non-blocking socket sets.
;; `O_NONBLOCK` is 4 here, as on Darwin, and 2048 on Linux.
(pub :: impl_fGetFl Int)
(pub fn (impl_fGetFl)
  3)

;; The `fcntl` command that sets a descriptor's status flags.
(pub :: impl_fSetFl Int)
(pub fn (impl_fSetFl)
  4)

;; fcntl's F_DUPFD_CLOEXEC: a duplicate of a descriptor, closed on exec.
;; `IO.termRaw` keeps one, so its guard can restore the terminal however
;; the caller's file is closed.
(pub :: impl_fDupFdCloexec Int)
(pub fn (impl_fDupFdCloexec)
  17)

;; The `O_NONBLOCK` status flag.
(pub :: impl_oNonblock Int)
(pub fn (impl_oNonblock)
  4)

;; EAGAIN, 35 here as on Darwin; 11 on Linux.
(pub :: impl_eAgain Int)
(pub fn (impl_eAgain)
  35)

;; ENOSYS - the kernel has no such call: 38 on Linux, 78 on Darwin and FreeBSD.
(pub :: impl_eNoSys Int)
(pub fn (impl_eNoSys)
  78)

;; EOPNOTSUPP - the operation does not apply to this socket or file: 95 on
;; Linux, 102 on Darwin, 45 on FreeBSD.
(pub :: impl_eOpNotSupp Int)
(pub fn (impl_eOpNotSupp)
  45)

;; ENOTCONN - the socket is not connected: 107 on Linux, 57 on the BSDs.
(pub :: impl_eNotConn Int)
(pub fn (impl_eNotConn)
  57)

;; ECONNREFUSED - nothing listens on the port: 111 on Linux, 61 on the BSDs.
(pub :: impl_eConnRefused Int)
(pub fn (impl_eConnRefused)
  61)

;; ECONNRESET - the peer reset the connection: 104 on Linux, 54 on the BSDs.
(pub :: impl_eConnReset Int)
(pub fn (impl_eConnReset)
  54)

;; ECONNABORTED - the connection was aborted before it was accepted: 103 on
;; Linux, 53 on the BSDs.
(pub :: impl_eConnAborted Int)
(pub fn (impl_eConnAborted)
  53)

;; EHOSTUNREACH - no route to the host: 113 on Linux, 65 on the BSDs.
(pub :: impl_eHostUnreach Int)
(pub fn (impl_eHostUnreach)
  65)

;; ENETUNREACH - no route to the network: 101 on Linux, 51 on the BSDs.
(pub :: impl_eNetUnreach Int)
(pub fn (impl_eNetUnreach)
  51)

;; ENETDOWN - the network is down: 100 on Linux, 50 on the BSDs.
(pub :: impl_eNetDown Int)
(pub fn (impl_eNetDown)
  50)

;; EADDRINUSE - another socket holds the address: 98 on Linux, 48 on the BSDs.
(pub :: impl_eAddrInUse Int)
(pub fn (impl_eAddrInUse)
  48)

;; EADDRNOTAVAIL - the address is not one of this host's: 99 on Linux, 49
;; on the BSDs.
(pub :: impl_eAddrNotAvail Int)
(pub fn (impl_eAddrNotAvail)
  49)

;; EINPROGRESS - a non-blocking connect has started and not finished: 115
;; on Linux, 36 on the BSDs.
(pub :: impl_eInProgress Int)
(pub fn (impl_eInProgress)
  36)

;; `sockaddr_in` opens with a length byte, as every BSD's does:
;
;   0:1 sin_len=16 | 1:1 sin_family=2 | 2:2 sin_port (BE) | 4:4 addr
;
; and `sockaddr_in6` likewise: sin6_len=28, sin6_family=28 at offset
; 1, then port, flowinfo, the sixteen address bytes and scope_id - 28
; bytes. The Darwin file carries both layouts against Linux's.
(pub :: impl_sockaddrHasLenByte Int)
(pub fn (impl_sockaddrHasLenByte)
  1)

; --------------------------------------------------------------------
; Readiness
;
; kqueue, which FreeBSD invented and Darwin took: one call both
; registers interest and collects events. `Sys.ax` branches on
; `pollUsesKqueue` and takes the same path it takes on Darwin - with
; ONE difference, the record size, below.
; --------------------------------------------------------------------
;; 1 where readiness comes from `kqueue`, 0 where it comes from
;; `epoll`.
(pub :: impl_pollUsesKqueue Int)
(pub fn (impl_pollUsesKqueue)
  1)

;; kqueue() - 362. Takes no arguments.
(pub :: impl_sysPollCreateNum Int)
(pub fn (impl_sysPollCreateNum)
  362)

;; kevent(kq, changelist, nchanges, eventlist, nevents, timeout) - 560,
;; and NOT 363, which is `freebsd11_kevent` (COMPAT11): the pre-12 entry
;; that reads and writes the 32-byte `struct freebsd11_kevent`. That one
;; assembles, runs and returns records into a 64-byte-strided buffer at
;; the wrong stride, so every event after the first is read from the
;; middle of the one before it. Both of epoll's calls are this number,
;; because registering is this call with an eventlist of nothing.
(pub :: impl_sysPollWaitNum Int)
(pub fn (impl_sysPollWaitNum)
  560)

;; The syscall number that adds and removes descriptors in the poll set
;; (`kevent` or `epoll_ctl`).
(pub :: impl_sysPollCtlNum Int)
(pub fn (impl_sysPollCtlNum)
  560)

;; `struct kevent` is 64 BYTES here, not Darwin's 32:
;
;   0:8 ident (uintptr) | 8:2 filter (int16) | 10:2 flags (uint16)
;   12:4 fflags (uint32) | 16:8 data (int64) | 24:8 udata (ptr)
;   32:32 ext[4] (uint64)
;
; The first 32 bytes are Darwin's byte for byte, and `IO`'s poller
; writes only `ident`, `filter`, `flags` and `udata`, all inside that
; prefix, into a zeroed record, so `ext` is zero as the kernel requires
; of an unused extension. Only the stride differs, which `IO` reads
; from here.
(pub :: impl_pollEventSize Int)
(pub fn (impl_pollEventSize)
  64)

;; The byte offset of the descriptor inside one readiness event record.
(pub :: impl_pollEventFdOffset Int)
(pub fn (impl_pollEventFdOffset)
  0)

;; EVFILT_READ, -1: kqueue's filters are negative small integers written
;; into a SIGNED 16-bit field, which `Sys.ax` masks to two bytes.
(pub :: impl_pollReadFilter Int)
(pub fn (impl_pollReadFilter)
  (- 0 1))

;; The writability filter: EVFILT_WRITE (-2) for kqueue, EPOLLOUT (4) for
;; epoll. It goes where `pollReadFilter` goes.
(pub :: impl_pollWriteFilter Int)
(pub fn (impl_pollWriteFilter)
  (- 0 2))

;; EV_ADD and EV_DELETE, 1 and 2.
(pub :: impl_pollAddOp Int)
(pub fn (impl_pollAddOp)
  1)

;; The operation code that removes a descriptor from the poll set.
(pub :: impl_pollDelOp Int)
(pub fn (impl_pollDelOp)
  2)

;; The size of the mask argument epoll_pwait takes and kevent does not.
;; Zero here because nothing reads it.
(pub :: impl_pollSigsetSize Int)
(pub fn (impl_pollSigsetSize)
  0)

; --------------------------------------------------------------------
; Memory, and what "out of memory" means here.
;
; `vm.overcommit` is 0 by default, so an anonymous mapping that fits
; the ADDRESS SPACE is granted whether or not RAM and swap could back
; it, and a program that maps more than exists dies when it TOUCHES the
; pages, not when it maps them. Measured on FreeBSD 14.4 arm64: a
; `rawAlloc` of 2^47 bytes - which Linux refuses under its overcommit
; heuristic and Darwin refuses as past its user address space - was
; granted, because arm64 FreeBSD has 48 bits of user address space.
; The allocator's out-of-memory trap fires on a REFUSED mapping, so
; here it fires for a request past the address space and not for one
; past the machine; `tests/stdlib/314-out-of-memory.ax` asks for 2^60
; for that reason.
; --------------------------------------------------------------------
; --------------------------------------------------------------------
; Entropy
;
; getrandom(buf, len, flags) - 563, FreeBSD 12+. It is Linux's call by
; name and by shape - it answers the NUMBER OF BYTES written and may
; answer short - so `randomIsGetentropy` is 0 and `Sys.ax` takes the
; Linux loop. FreeBSD's `getentropy` is a libc function over this
; syscall, not a syscall of its own.
; --------------------------------------------------------------------
;; The syscall number that fills a buffer with random bytes.
(pub :: impl_sysRandomNum Int)
;@axiom:syscall(entropy)
(pub fn (impl_sysRandomNum)
  563)

;; 1 where random bytes come from `getentropy`, 0 where they come from
;; `getrandom`.
(pub :: impl_randomIsGetentropy Int)
(pub fn (impl_randomIsGetentropy)
  0)

;; The most bytes one random-bytes syscall may fill at a time.
(pub :: impl_randomMaxChunk Int)
(pub fn (impl_randomMaxChunk)
  256)

; --------------------------------------------------------------------
; Signals
;
; No `signalfd` - it is a Linux invention - so a signal is delivered
; through the same kqueue as a socket, with `EVFILT_SIGNAL`, exactly as
; on Darwin; `Sys.ax` takes that branch unchanged.
; --------------------------------------------------------------------
;; 1 where signals are read from a `signalfd`, 0 where a `kqueue`
;; filter delivers them.
(pub :: impl_signalUsesSignalFd Int)
(pub fn (impl_signalUsesSignalFd)
  0)

;; sigprocmask(how, set, oset) - 340. Three arguments; the fourth
;; `Sys.ax` passes is ignored, as Darwin ignores it.
(pub :: impl_sysSigProcMaskNum Int)
(pub fn (impl_sysSigProcMaskNum)
  340)

;; SIG_BLOCK, which is 1 here as on Darwin and 0 on Linux. The Darwin
;; file records what the wrong one does: 0 is not a value here at all,
;; and the kernel answers EINVAL - which is the loud failure, and better
;; than Linux's 1, which on Darwin is SIG_UNBLOCK and lets the signal
;; kill the process.
(pub :: impl_sigBlockHow Int)
(pub fn (impl_sigBlockHow)
  1)

;; `sigset_t` IS SIXTEEN BYTES HERE - `__uint32_t __bits[4]` - a THIRD
;; width against Darwin's 4 and Linux's 8, and the kernel copies all
;; sixteen in on `sigprocmask`. `Sys.ax` writes the mask as one 64-bit
;; word at offset 0, which puts signal N at bit N-1 of `__bits[0..1]`
;; on this little-endian layout, and zeroes the rest of the set to this
;; width first, so the caller's buffer has to hold sixteen bytes - the
;; contract on `sysSignalBlock` says so.
(pub :: impl_sigsetBytes Int)
(pub fn (impl_sigsetBytes)
  16)

;; EVFILT_SIGNAL, -6, the filter that marks an event as a signal rather
;; than a readable socket.
(pub :: impl_pollSignalFilter Int)
(pub fn (impl_pollSignalFilter)
  (- 0 6))

