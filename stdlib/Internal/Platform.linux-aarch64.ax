  64)

;; O_CLOEXEC = 0x80000, so a spawned child never inherits the
;; descriptor, or the lock held on it
(pub :: impl_oCloexec Int)
(pub fn (impl_oCloexec)
  524288)

; ------------------------------------------------------------------
; The clock and entropy as platform calls. This target reads its
; clocks and its entropy through `__syscallN`, so `Sys.ax` never
; reaches these six; they exist because every platform module
; declares one public surface (`check-stdlib-api.sh`), and Windows
; answers them for real.
; ------------------------------------------------------------------
;; Whether `Sys.ax` reads this platform's clocks through
;; `platformMonotonicNanos` and `platformRealtimeNanos`: 0 here, where
;; `clock_gettime` or the counter serves.
(pub :: impl_platformHasClock Int)
;@axiom:effect(pure)
(pub fn (impl_platformHasClock)
  0)

;; The platform's own monotonic clock in nanoseconds, where raw
;; `clock_gettime` is not available; `Err` 78 where the syscall serves.
(pub :: impl_platformMonotonicNanos (Result Int Error))
(pub fn (impl_platformMonotonicNanos)
  (Err (mkError 78 "platformMonotonicNanos")))

;; The platform's own wall clock in nanoseconds since the Unix epoch,
;; where raw `clock_gettime` is not available; `Err` 78 where the
;; syscall serves.
(pub :: impl_platformRealtimeNanos (Result Int Error))
(pub fn (impl_platformRealtimeNanos)
  (Err (mkError 78 "platformRealtimeNanos")))

;; The platform's own sleep for at least `nanos` nanoseconds, where the
;; raw wait is not available; `Err` 78 where the syscall serves.
(pub :: impl_platformSleepNanos (-> Int (Result Int Error)))
(pub fn (impl_platformSleepNanos nanos)
  (Err (mkError 78 "platformSleepNanos")))

;; Whether entropy uses a separate platform source: 0 here.
;; The entropy layer selects the kernel or hardware path otherwise.
(pub :: impl_platformHasEntropy Int)
;@axiom:effect(pure)
(pub fn (impl_platformHasEntropy)
  0)

; ------------------------------------------------------------------
; The signal mask as a platform call. This target uses `__syscallN`;
; Windows supplies the platform implementation.
; ------------------------------------------------------------------
;; The platform's own signal mask, where raw `sigprocmask` is not
;; available; `Err` 78 where the syscall serves.
(pub :: impl_platformSignalBlock (-> Int (Result Int Error)))
(pub fn (impl_platformSignalBlock mask)
  (Err (mkError 78 "platformSignalBlock")))

; ------------------------------------------------------------------
; Sockets and readiness as platform calls. This target makes every
; socket call through `__syscallN`, so `IO.ax` never reaches these
; twelve; they exist because every platform module declares one public
; surface (`check-stdlib-api.sh`), and Windows answers them for real.
; Each keeps the raw convention IO.ax already turns into `Result`: a
; descriptor or a count, or `-errno`.
; ------------------------------------------------------------------
;; socket(family, type, protocol): the descriptor, or `-errno`. -78 here.
(pub :: platformSocket (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformSocket family kind protocol)
  (- 0 78))

;; bind(s, addr, len): 0, or `-errno`. -78 here.
(pub :: platformBind (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformBind s addr len)
  (- 0 78))

;; listen(s, backlog): 0, or `-errno`. -78 here.
(pub :: platformListen (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformListen s backlog)
  (- 0 78))

;; accept(s): the new descriptor, or `-errno`. -78 here.
(pub :: platformAccept (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformAccept s)
  (- 0 78))

;; connect(s, addr, len): 0, `-EINPROGRESS` for a non-blocking socket
;; still connecting, or `-errno`. -78 here.
(pub :: platformConnect (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformConnect s addr len)
  (- 0 78))

;; send(s, buf, n): bytes sent, or `-errno`. -78 here.
(pub :: platformSend (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformSend s buf n)
  (- 0 78))

;; shutdown(s, how): 0, or `-errno`. -78 here.
(pub :: platformShutdown (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformShutdown s how)
  (- 0 78))

;; setsockopt(s, level, name, val, len): 0, or `-errno`. -78 here.
(pub :: platformSetSockOpt (-> Int Int Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformSetSockOpt s level name val len)
  (- 0 78))

;; getsockopt(s, level, name, val, lenCell): 0, or `-errno`. -78 here.
(pub :: platformGetSockOpt (-> Int Int Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformGetSockOpt s level name val lenCell)
  (- 0 78))

;; Make `s` non-blocking (`on`) or blocking: 0, or `-errno`. -78 here.
(pub :: platformSetNonBlocking (-> Int Bool Int))
;@axiom:effect(pure)
(pub fn (platformSetNonBlocking s on)
  (- 0 78))

;; getsockname or (`peer`) getpeername into `addr`, whose length cell is
;; `lenCell`: 0, or `-errno`. -78 here.
(pub :: platformSocketAddr (-> Int Bool Int Int Int))
;@axiom:effect(pure)
(pub fn (platformSocketAddr s peer addr lenCell)
  (- 0 78))

;; poll over `n` records at `fds`, each a descriptor word, an interest
;; word and a readiness word, for `ms` milliseconds (negative: no
;; limit): the count of ready records, or `-errno`. -78 here.
(pub :: platformPoll (-> Int Int Int Int))
;@axiom:effect(pure)
(pub fn (platformPoll fds n ms)
  (- 0 78))

; ------------------------------------------------------------------
; The console as platform calls. This target's terminal is the termios
; trio through `ioctl` (`ttyUsesTermios` 1), so `IO.ax` never reaches
; these four; Windows answers them over `GetConsoleMode` and its kin.
; ------------------------------------------------------------------
;; Whether `fd` is a console: 1 or 0. Unreached here.
(pub :: platformIsConsole (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformIsConsole fd)
  0)

;; The console's mode word, or `-errno`. -78 here.
(pub :: platformConsoleMode (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformConsoleMode fd)
  (- 0 78))

;; Set the console's mode word: 0, or `-errno`. -78 here.
(pub :: platformConsoleSetMode (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformConsoleSetMode fd mode)
  (- 0 78))

;; The console's window in character cells, as `rows * 65536 + cols`,
;; or `-errno`. -78 here.
(pub :: platformConsoleSize (-> Int Int))
;@axiom:effect(pure)
(pub fn (platformConsoleSize fd)
  (- 0 78))
