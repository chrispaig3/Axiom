(pub :: platformFtruncate (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformFtruncate fd len)
  (- 0 38))

;; The platform's own way to lock a file where raw `flock` is not
;; available; -38 where the raw syscall is used instead.
(pub :: platformFlock (-> Int Int Int))
;@axiom:effect(pure)
(pub fn (platformFlock fd op)
  (- 0 38))

