(pub :: impl_tiosIcanon Int)
(pub fn (impl_tiosIcanon)
  2)

;; The `ISIG` local-mode flag: the terminal turns Ctrl-C into a signal.
(pub :: impl_tiosIsig Int)
(pub fn (impl_tiosIsig)
  1)

;; The `IEXTEN` local-mode flag: extended input processing.
(pub :: impl_tiosIexten Int)
(pub fn (impl_tiosIexten)
  32768)

;; c_iflag bits. BRKINT, ISTRIP and ICRNL come from
