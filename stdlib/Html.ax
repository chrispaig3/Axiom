; ------------------------------------------------------------------
; Iteration
; ------------------------------------------------------------------
; `(for x xs body)` - `body` once per element of the `Vec` of Strings
; `xs`, with `x` bound to each. `x` is the CALLER's name (MAC-HYG-10);
; `i`, `n` and `v` are the template's and are renamed, so a body that
; mentions `i` means its own. Answers 0. `vecGetStr` rather than
; `vecGet`, because a value out of the polymorphic accessor has no
; named type and reaches MAC-CAP-10.6's AX3025 the moment a body
; interpolates it.
(pub macro (for x xs body) (let ((v xs))
  (let ((mut i 0))
    (let ((n (hVecLen v)))
      {
        (while (< i n)
          {
            (let ((x (hVecStr v i)))
              body
            )
            (set i (+ i 1))
          })
        0
      }
    )
  )
))

; `(forInt x xs body)` - the same over a `Vec` of Ints, `x` bound to
; each word.
(pub macro (forInt x xs body) (let ((v xs))
  (let ((mut i 0))
    (let ((n (hVecLen v)))
      {
        (while (< i n)
          {
            (let ((x (hVecWord v i)))
              body
            )
            (set i (+ i 1))
          })
        0
      }
    )
  )
))
