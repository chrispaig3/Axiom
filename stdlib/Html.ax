; ------------------------------------------------------------------
; Inline CSS and JS, and the `</script>` problem.
;
; `(style b css)` and `(script b js)` write their string VERBATIM
; except that every `</` becomes `<\/` (`hEscTagEnd`), so the closing
; tag cannot appear inside the element however the string was built.
; That is a RUN-TIME rewrite: a macro cannot read a literal's bytes at
; expansion (MAC-LANG-13), so nothing here refuses `"</script>"` at
; `check`. tests/stdlib/421-html-script.ax pins the rewrite.
; ------------------------------------------------------------------
; `<style>css</style>`, the CSS verbatim with `</` neutralised.
(pub macro (style b css) (let ((bb b))
  {
    (hRaw bb "<style>")
    (hCss bb css)
    (hRaw bb "</style>")
  }
))

; `<script>js</script>`, the JS verbatim with `</` neutralised.
(pub macro (script b js) (let ((bb b))
  {
    (hRaw bb "<script>")
    (hJs bb js)
    (hRaw bb "</script>")
  }
))

; `<script src="..."></script>` - an external script, attributes only.
(pub macro (scriptA b attrs) (let ((bb b))
  {
    (hOpen bb "script")
    attrs
    (hOpenEnd bb)
    (hClose bb "script")
  }
))

; ------------------------------------------------------------------
; Text
; ------------------------------------------------------------------
; Escaped text: `(text b "5 < 6")` writes `5 &lt; 6`. The default,
; and the form every string a peer supplied goes through.
(pub macro (text b s) (hText b s))

; UNESCAPED BYTES. THIS IS THE ONLY FORM THAT WRITES A STRING WITHOUT
; ESCAPING IT: `(raw b "<hr>")` writes `<hr>`, and `(raw b q)` with `q`
; from a request writes whatever the peer sent, markup and script
; included. Use it for markup the program itself wrote, never for
; data.
(pub macro (raw b s) (hRaw b s))

; ------------------------------------------------------------------
; Attributes, for the block between `<tag` and `>`. Each is
; `(name b value)` and writes ` name="value"` with the value escaped.
; ------------------------------------------------------------------
; ` name="value"` for any attribute name - the escape hatch for a name
; with no macro of its own (`type`, `for`, `title`, `style`, `data-*`,
; `aria-*`). The NAME is the author's literal and is written as it is.
(pub macro (attr b name value) (hAttr b name value))

; ` name` alone: a boolean attribute, `(flag b "disabled")`.
(pub macro (flag b name) (hFlag b name))

; ` class="..."`
(pub macro (class b v) (hAttr b "class" v))

; ` id="..."`
(pub macro (id b v) (hAttr b "id" v))

; ` href="..."`
(pub macro (href b v) (hAttr b "href" v))

; ` src="..."`
(pub macro (src b v) (hAttr b "src" v))

; ` alt="..."`
(pub macro (alt b v) (hAttr b "alt" v))

; ` name="..."`
(pub macro (name b v) (hAttr b "name" v))

; ` value="..."`
(pub macro (value b v) (hAttr b "value" v))

; ` rel="..."`
(pub macro (rel b v) (hAttr b "rel" v))

; ` action="..."`
(pub macro (action b v) (hAttr b "action" v))

; ` method="..."`
(pub macro (method b v) (hAttr b "method" v))

; ` placeholder="..."`
(pub macro (placeholder b v) (hAttr b "placeholder" v))

