; ------------------------------------------------------------------
; Void elements: no children, no closing tag.
; ------------------------------------------------------------------
; `<br>`
(pub macro (br b) (elVoid b "br"))

; `<hr>`
(pub macro (hr b) (elVoid b "hr"))

