; Sys - portable syscall wrappers.
;
; The lowest portable layer of Axiom's standard library. Everything here
; is written in Axiom on top of the `__syscallN` primitives; there is no
; C binding anywhere in this file, and none anywhere above it.
;
; Per-platform numbers and flags come from `Sys.Platform`, which the
; compiler resolves to the right `Sys/Platform.<os>[-<arch>].ax` for the
; target being compiled for. Branching on a *capability* exposed by that
; module (`openNeedsDirFd`) rather than on an OS name keeps this file
; from growing a platform list.
;
; Return values are raw kernel results, not exceptions: a successful
; result as-is, or `-errno` on failure. That convention holds on every
; supported platform because the backend's Darwin syscall sequence
; normalises Darwin's carry-flag/positive-errno protocol into a negative
; result (see `targetSyscallAsm` in `self_host/codegen.ax`, whose Darwin
; templates branch on carry and negate), so `sysFailed` is a
; single portable comparison rather than a per-OS special case.
(import Sys.Platform)

; ------------------------------------------------------------------
; File descriptors
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; Core operations
; ------------------------------------------------------------------
; write(fd, buf, count) -> bytes written, or a negative/errno result.
; A raw syscall answer turned into a `Result`.
;
; The convention it converts FROM is this file's own, stated at the top:
; a negative return is `-errno`, normalised out of Darwin's carry-flag
; protocol by the backend. The convention it converts TO is `Result`,
; where the failure is in the type.
;
; The message names the operation and the errno and NOT the path,
; because a path here is an `Int` - a NUL-terminated buffer address -
; and rendering one would mean reading foreign memory to build an error
; about a call that just failed. `IO.ax`'s wrappers have the `String`
; and put it in their own message.
(pub :: sysResult (-> String Int (Result Int Error)))

(pub fn (sysResult op n)
  (if (< n 0)
    (Err (mkError (- 0 n) (strConcat (strConcat op ": errno ") (fmtInt (- 0 n)))))
    (Ok n)
  )
)

; Write all `count` bytes at `buf` to `fd`: bytes written, or `-errno`.
;
; A single `write` is PERMITTED to transfer fewer bytes than asked - a
; pipe whose buffer filled, a signal arriving mid-call - and treating a
; short write as success is the classic way to truncate output
; silently. `sysWriteFile` and `sysAppendFile` both go through here for
; that reason; before this existed the only loop in the library was
; `IO.writeAll`, one layer up, so everything writing a FILE was
; single-shot.
;
; `done` is how many bytes are already out; callers pass 0.
; A zero-byte write is not progress, and looping on it
; spins forever; answer what got out and let the caller
; compare it against what it asked for.
; read(fd, buf, count) -> bytes read, 0 at end of file.
; open(path, flags) -> fd, or an error result.
;
; `path` is the address of NUL-terminated bytes - `(__addr "file.txt")`
; for a literal, or `strCStr` for a computed string.
;
; Newly created files get mode 0644. The mode argument is ignored unless
; the flags contain `O_CREAT`, but passing 0 - as an earlier version did -
; creates files with *no* permissions at all, which then cannot be read
; back even by the process that just wrote them.
; open(path, flags, mode), for callers that need a specific mode.
; lseek(fd, offset, whence) -> resulting absolute offset.
; Terminate the process. Never returns; the `0` afterwards exists only
; because every Axiom expression has a value.
; ------------------------------------------------------------------
; Error handling
; ------------------------------------------------------------------
; True when a syscall result denotes failure.
;
; One comparison suffices on every platform: see the note at the top of
; this file about how Darwin's carry-flag convention is normalised in
; the backend. `-errno` is always negative, and no successful result of
; any syscall this library exposes ever is.
; The errno behind a failed result, or 0 if it did not fail.
; ------------------------------------------------------------------
; File I/O utilities
; ------------------------------------------------------------------
(import Err)

(import Str)

(import Mem)

; `sysReadDir` answers a Vec of names. `Str` already imports `Vec` for
; `strSplit`, so this edge is not new - it is written down.
(import Vec)

; `netAddrText` renders an address as decimal octets and hexadecimal
; groups, both of which `Fmt` already does; a second `fmtInt` living
; here would be the drift this library keeps refusing elsewhere. The
; edge adds no cycle - `Fmt` imports `Mem` and `Str` and nothing else,
; and both are above this line.
(import Fmt)

(pub :: stdin Int)

(pub fn (stdin) 0)

(pub :: stdout Int)

(pub fn (stdout) 1)

(pub :: stderr Int)

(pub fn (stderr) 2)

(pub :: sysWriteFd (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (sysWriteFd fd buf count) (__syscall3 sysWrite fd buf count))

(pub :: sysWriteAllFd (-> Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (sysWriteAllFd fd buf count done)
  (if (>= done count)
    done
    (let ((n (sysWriteFd fd (+ buf done) (- count done))))
      (if (< n 1)
        (if (< n 0)
          n
          done
        )
        (sysWriteAllFd fd buf count (+ done n))
      )
    )
  )
)

(pub :: sysReadFd (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (sysReadFd fd buf count) (__syscall3 sysRead fd buf count))

(pub :: sysOpenPath (-> Int Int Int))

;@axiom:effect(io)
(pub fn (sysOpenPath path flags) (sysOpenPathMode path flags 420))

(:: sysOpenPathMode (-> Int Int Int Int))

;@axiom:effect(io)
(fn (sysOpenPathMode path flags mode)
  (if (== openNeedsDirFd 1)
    (__syscall4
      sysOpen      atFdCwd      path      flags      mode
    )
    (__syscall3 sysOpen path flags mode)
  )
)

(pub :: sysCloseFd (-> Int Int))

;@axiom:effect(io)
(pub fn (sysCloseFd fd) (__syscall1 sysClose fd))

(:: sysSeek (-> Int Int Int Int))

;@axiom:effect(io)
(fn (sysSeek fd offset whence) (__syscall3 sysLseek fd offset whence))

(pub :: sysExitWith (-> Int Int))

;@axiom:effect(io)
(pub fn (sysExitWith code)
  {
    (__syscall1 sysExit code)
    0
  }
)

(pub :: sysFailed (-> Int Bool))

(pub fn (sysFailed result) (< result 0))

(pub :: sysErrno (-> Int Int))

(pub fn (sysErrno result)
  (if (< result 0)
    (- 0 result)
    0
  )
)

; Open, read entire contents, close.  Returns an empty string on any
; error (missing file, permission, etc.).
;
; This used to read a single 65536-byte chunk, documented as "enough
; for the self-host bootstrap source files" - which held until
; `self_host/codegen.ax` grew past 64 KiB, at which point the compiler
; it feeds truncated its own source mid-token and reported a parse
; error pointing at a token that does not exist in the file. A read
; that silently caps at a size is a read that fails on the first input
; to cross it, in the caller least equipped to see why.
;
; `path` is a raw NUL-terminated char*, not a `Str` handle, because it
; goes straight to `sysOpenPath`. Use `(__addr "...")` for a literal or
; `strCStr` for a `Str`. `IO.readFile` is the `Str`-taking one.
;
; Named `sysReadFile` rather than `readFile` so that the two do not
; collide in the flat top-level namespace. They used to, and the
; collision was silent and wrong in the worst direction: `(readFile
; "path.txt")` resolved to *this* function, which took the `Str`
; header's address as a char*, opened garbage, and reported every file
; as missing.
(pub :: sysReadFile (-> Int String))

;@axiom:effect(io)
(pub fn (sysReadFile path)
  (let ((fd (sysOpenPath path oRdonly)))
    (if (sysFailed fd)
      ""
      (let ((s (sysReadAll fd (strAlloc 65536) 0 65536)))
        {
          (sysCloseFd fd)
          s
        }
      )
    )
  )
)

; Read `fd` to EOF into `buf`, doubling the buffer whenever it fills.
; `used` bytes hold data; `cap` is the buffer's capacity. A short read
; is retried rather than treated as EOF - only 0 (or an error) ends the
; loop - so a pipe delivers its whole stream too. The final byte after
; `used` is NUL because `strAlloc` reserves len+1 zeroed bytes and
; every growth copies into a fresh zeroed buffer.
(:: sysReadAll (-> Int String Int Int String))

;@axiom:effect(io)
(fn (sysReadAll fd buf used cap)
  (let ((n (sysReadFd fd (+ (strData buf) used) (- cap used))))
    (if (<= n 0)
      (if (== used 0)
        ""
        ; The retain is the same rule `strSlice` follows and for
        ; the same reason: this is a SECOND header naming `buf`'s
        ; owner, so it must take a second share (memory-model.md
        ; MM-VAL-7). Without it two headers claim one count, and
        ; the day something releases a `Str` header - MM-LIFE-2e's
        ; extension work - the first release frees a buffer the
        ; other header still points into. It was inert when it was
        ; written, which is the only reason it read as correct.
        (let ((own (strOwner buf)))
          {
            (__retain own)
            (strWrapOwned (strData buf) used own)
          }
        )
      )
      (let ((used2 (+ used n)))
        (if (< used2 cap)
          (sysReadAll fd buf used2 cap)
          (let ((big (strAlloc (* cap 2))))
            {
              (memCopy (strData big) (strData buf) used2)
              (sysReadAll fd big used2 (* cap 2))
            }
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; Command-line arguments.
;
; The entry wrapper captures `argc`/`argv` before `main` runs; the
; `__argc`/`__argv` primitives read them back. `__argv` is unchecked -
; the primitives are where the type system stops - so the bounds live
; here, and an out-of-range index answers the empty string rather
; than whatever address sits past the vector.
;
; EVERYTHING BELOW THAT READS THEM CARRIES `;@axiom:effect(io)`, and it
; does not make a syscall. `IO` means "reaches the outside world", and
; the command line is input this process did not compute: a function
; that reads it is not a function of its arguments, which is the thing
; `MM-EXEC-9b` says a purity claim ought to exclude. Until 2026-08-25
; `__argc`/`__argv` were registered like `__load64`, which computes, so
; every one of these was inferred effect-free and `;@axiom:pure` over
; one of them was accepted. That was `MM-EXEC-9a`'s second row.
; The same applies to the environment block below, which `sysEnvp`
; reaches through `__argv` past the end of the argument vector.
; ------------------------------------------------------------------
; How many arguments the process received, including the program name.
(pub :: sysArgc Int)

;@axiom:effect(io)
(pub fn (sysArgc) __argc)

; The i-th argument as a Str (0 is the program name), or "" when `i`
; is out of range. The bytes are the process's own argv storage -
; NUL-terminated, alive for the whole run, never freed or moved - so
; wrapping them without copying is sound.
(pub :: sysArg (-> Int String))

;@axiom:effect(io)
(pub fn (sysArg i)
  (if (|| (< i 0) (>= i __argc))
    ""
    (strFromLit (__argv i))
  )
)

; Write `s` to `path`, creating or truncating it. Answers the number of
; bytes written, or a negative errno from whichever step failed.
;
; A compiler driver writes its own intermediates, and this is the one
; direction of file I/O the library did not have: it could read a file
; and it could write to an already-open descriptor, but nothing put a
; string on disk under a name.
(pub :: sysWriteFile (-> Int String (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysWriteFile path s)
  (sysResult "sysWriteFile"
  (let ((fd (sysOpenPath path oWronlyCreateTrunc)))
    (if (sysFailed fd)
      fd
      (let ((n (sysWriteAllFd fd (strData s) (strLen s) 0)))
        {
          (sysCloseFd fd)
          n
        }
      )
    )
  )
))

; Append `s` to `path`, creating it if it is not there. Answers the
; number of bytes written, or a negative errno.
;
; The write direction this library did not have. `sysWriteFile`
; TRUNCATES, so the only way to add a line to a file was to read the
; whole thing, concatenate, and write it back - quadratic in the number
; of lines, and a window in which a crash loses the file entirely.
;
; O_APPEND is what makes it atomic rather than merely equivalent:
; the seek to the end and the write are one operation, so two
; processes appending to one log interleave whole writes instead of
; overwriting each other's last one. Opening for writing and seeking
; by hand does not have that property.
(pub :: sysAppendFile (-> Int String (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysAppendFile path s)
  (sysResult "sysAppendFile"
  (let ((fd (sysOpenPath path oWronlyCreateAppend)))
    (if (sysFailed fd)
      fd
      (let ((n (sysWriteAllFd fd (strData s) (strLen s) 0)))
        {
          (sysCloseFd fd)
          n
        }
      )
    )
  )
))

; Rename `old` to `new`, answering 0 or `-errno`. Both are
; NUL-terminated char* - `strCStr`.
;
; The verb the surface was missing. A file could be created, read,
; written and removed, and the only way to MOVE one was to copy the
; bytes and unlink the original - which is not the same operation: this
; one is atomic within a filesystem, so a reader of `new` sees either
; the whole old file or the whole new one and never a half-written
; prefix. That is how a build writes an output without a window in
; which the output exists and is incomplete.
;
; It does not cross filesystems: `-EXDEV` (18) is the kernel refusing,
; and copy-then-unlink is the caller's fallback.
;
; Same shape as `sysUnlink` and `sysMkdir`: AArch64 Linux has only
; `renameat`, which takes a directory fd before EACH path, so this
; branches on the existing `openNeedsDirFd` capability rather than
; growing a second one.
(pub :: sysRename (-> Int Int (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysRename old new)
  (sysResult "sysRename"
  (if (== openNeedsDirFd 1)
    (__syscall4
      sysRenameNum      atFdCwd      old      atFdCwd      new
    )
    (__syscall2 sysRenameNum old new)
  )
))

; Remove `path`. Answers 0, or `-errno`.
;
; AArch64 Linux has no `unlink` in its table - only `unlinkat` - which
; is the same shape as `open`/`openat`, so it branches on the same
; `openNeedsDirFd` capability rather than growing a second one.
(pub :: sysUnlink (-> Int (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysUnlink path)
  (sysResult "sysUnlink"
  (if (== openNeedsDirFd 1)
    (__syscall3 sysUnlinkNum atFdCwd path 0)
    (__syscall1 sysUnlinkNum path)
  )
))

; Create directory `path` with `mode`. Answers 0, or `-errno` - which
; is `-17` (EEXIST) when it is already there, and callers usually want
; to treat that as success.
;
; Same shape as `sysUnlink`: AArch64 Linux has only `mkdirat`, so this
; branches on the existing `openNeedsDirFd` capability rather than
; growing a second one. `path` must be NUL-terminated - `strCStr`.
(pub :: sysMkdir (-> Int Int (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysMkdir path mode)
  (sysResult "sysMkdir"
  (if (== openNeedsDirFd 1)
    (__syscall3 sysMkdirNum atFdCwd path mode)
    (__syscall2 sysMkdirNum path mode)
  )
))

; 0755, the mode a directory usually wants. A nullary function because
; that is how this language spells a constant.
(pub :: sysDirMode Int)

(pub fn (sysDirMode) 493)

; Remove the empty directory `path`. Answers 0, or `-errno`.
;
; `AT_REMOVEDIR` is 512 on Linux, and it is what makes `unlinkat` -
; the only call AArch64 has for either job - remove a directory rather
; than refuse with EISDIR.
(pub :: sysRmdir (-> Int (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysRmdir path)
  (sysResult "sysRmdir"
  (if (== openNeedsDirFd 1)
    (__syscall3 sysRmdirNum atFdCwd path 512)
    (__syscall1 sysRmdirNum path)
  )
))

; ------------------------------------------------------------------
; Four questions about a file that need no new syscall.
;
; `stat` is the obvious way to ask them and it is NOT here on purpose:
; its answer is a struct whose layout differs on every one of the four
; targets - offsets, widths and padding all move - so a portable
; `stat` is four record layouts, not one syscall number. `open`,
; `read` and `lseek` answer all four with calls this module already
; makes, and the three targets nothing here can execute stay honest.
; ------------------------------------------------------------------
; 1 when `path` names something that can be opened for reading.
;
; This is what `sysRunSearch` has always done to test a candidate, and
; for the reason that matters under fork+exec: once the fork has
; happened, "no such file" and "the child exited 127" are the same
; integer.
(pub :: sysFileExists (-> Int Bool))

;@axiom:effect(io)
(pub fn (sysFileExists path)
  (let ((fd (sysOpenPath path oRdonly)))
    (if (< fd 0)
      false
      {
        (sysCloseFd fd)
        true
      }
    )
  )
)

; The size of `path` in bytes, or `-errno`. Seeks to the end, which is
; what the size IS - no struct, no layout, no per-target record.
;
; A DIRECTORY answers a number here rather than failing: probed on
; darwin-aarch64 2026-08-15, `.` came back 416, the size of the
; directory file the filesystem keeps rather than anything a caller
; means by "how big is it". `sysIsDir` below is the discriminator, and
; it is the reason that measurement is recorded instead of papered
; over - a caller that must not be fooled asks two questions, and this
; one alone was never going to answer both.
(pub :: sysFileSize (-> Int (Result Int Error)))

;@axiom:effect(io)
(pub fn (sysFileSize path)
  (sysResult "sysFileSize"
  (let ((fd (sysOpenPath path oRdonly)))
    (if (< fd 0)
      fd
      (let ((n (sysSeek fd 0 seekEnd)))
        {
          (sysCloseFd fd)
          n
        }
      )
    )
  )
))

; 0 when `path` can be opened AND read as a file, otherwise the errno
; saying why not.
;
; The three-way answer `sysFileExists` collapses. Opening separates
; "not there" (ENOENT) and "not allowed" (EACCES); a ONE-BYTE read
; separates the third case, because both Darwin and Linux open a
; directory happily and defer EISDIR to `read` (probed 2026-08-08,
; re-probed 2026-08-15: `read` on a descriptor for `.` answers -21 on
; darwin-aarch64, and 1 on a regular file with a byte in it).
;
; The compiler's own front door has done exactly this since the day an
; EMPTY source file was reported as unreadable and a directory as
; missing - `sysReadFile` answers "" for all three. It lived in
; `main.ax` as `sourceReadErrno`, which is one program's private fix
; for a question every program reading a path has.
(pub :: sysReadErrno (-> Int Int))

;@axiom:effect(io)
(pub fn (sysReadErrno path)
  (let ((fd (sysOpenPath path oRdonly)))
    (if (sysFailed fd)
      (sysErrno fd)
      (let ((probe (strAlloc 1)))
        (let ((n (sysReadFd fd (strData probe) 1)))
          {
            (sysCloseFd fd)
            (if (< n 0)
              (sysErrno n)
              0
            )
          }
        )
      )
    )
  )
)

; True when `path` names a directory.
;
; One call to `sysReadErrno`, not a second probe: a path that reads
; back EISDIR is a directory, and there is no other way to earn that
; errno from a successful `open`. An empty file answers false here (it
; opens, and its zero-byte read is 0, not an error), which is the
; distinction `sysFileExists` cannot make and `sysFileSize` answers
; wrongly for.
(pub :: sysIsDir (-> Int Bool))

;@axiom:effect(io)
(pub fn (sysIsDir path) (== (sysReadErrno path) eIsDir))

; ------------------------------------------------------------------
; Reading a directory.
;
; The one filesystem question with NO answer in terms of calls this
; module already made, and so the one place a record layout could not
; be avoided the way `stat`'s was. There is no seek, no read and no
; open that enumerates a directory's names; `getdents64` (Linux) and
; `getdirentries64` (Darwin) are it.
;
; What makes that acceptable where `stat` was not is the size of the
; disagreement. `struct stat` is FOUR layouts, one per target, with
; every offset, width and pad free to move. A directory entry is TWO,
; and they differ in exactly one number: where the name starts, 19 on
; Linux and 21 on Darwin. `d_reclen` - the only other field portable
; code reads - is at offset 16 on both. So `direntNameOffset` is the
; whole of the per-target knowledge, and it sits in the platform
; module beside the syscall number, which is where this library keeps
; ABI facts.
;
; TWO FIELDS ARE DELIBERATELY NOT READ. `d_namlen` exists on Darwin
; and not on Linux, so the length comes from scanning for the NUL that
; both write. `d_type` exists on both and is NOT exposed, because
; filesystems are permitted to answer DT_UNKNOWN and some do - a
; caller that believed it would be wrong on those, and a caller that
; handled DT_UNKNOWN would have to call `sysIsDir` anyway. One correct
; way to ask is better than a fast way that is sometimes silent about
; not knowing.
; ------------------------------------------------------------------
; Bytes per `getdents` call. Large enough that a directory of a few
; hundred entries comes back in one syscall (a Darwin record is 32
; bytes for a short name), and the loop below handles any number.
(:: sysDirBufBytes Int)

(fn (sysDirBufBytes) 32768)

; Every name in the directory `path`, as a Vec of owned `Str` - `.`
; and `..` INCLUDED, in whatever order the filesystem gives them.
;
; Both of those are the raw call's answer rather than a convenience,
; and both are load-bearing:
;
;   - An empty Vec means FAILURE, and can mean nothing else, because a
;     directory always contains `.` and `..`. That is what lets this
;     answer a Vec handle rather than needing a second out-parameter
;     for the errno.
;   - The ORDER is the filesystem's, which is not stable across
;     machines or even across runs. Anything whose output depends on
;     it is not reproducible; `IO.listDir` sorts, and is what a caller
;     that has not thought about this should use.
;
; The names are COPIED. The syscall's buffer is reused by the next
; iteration of the loop, so a wrap over it would answer the same
; bytes N times over - which is the kind of bug that looks like a
; filesystem returning duplicates.
(pub :: sysReadDir (-> Int Int))

;@axiom:effect(io)
(pub fn (sysReadDir path)
  (let ((out vecNew))
    (let ((fd (sysOpenPath path oRdonly)))
      (if (sysFailed fd)
        out
        ; Darwin's fourth argument is an in/out scan cookie the
        ; kernel starts from; zero is the beginning. Linux keeps
        ; the position on the descriptor and never reads this.
        (let (
          (buf (memAlloc sysDirBufBytes))
          (pos (memAlloc 8))
        )
          {
            (memSetWord pos 0 0)
            (sysReadDirLoop fd buf pos out)
            (sysCloseFd fd)
            out
          }
        )
      )
    )
  )
)

; One `getdents` per pass until the directory is exhausted (0) or the
; kernel refuses (negative). A refusal mid-way keeps the names already
; decoded rather than discarding them, which matches `sysReadAll`'s
; rule for a short read.
(:: sysReadDirLoop (-> Int Int Int Int Int))

;@axiom:effect(io)
(fn (sysReadDirLoop fd buf pos out)
  (let ((n 
    (if (== dirReadNeedsPosition 1)
      (__syscall4
        sysGetdentsNum        fd        buf        sysDirBufBytes        pos
      )
      (__syscall3 sysGetdentsNum fd buf sysDirBufBytes)
    )
  ))
    (if (<= n 0)
      n
      {
        (sysReadDirDecode buf 0 n out)
        (sysReadDirLoop fd buf pos out)
      }
    )
  )
)

; Walk the `n` bytes of packed records at `buf`, pushing one owned copy
; of each name.
;
; TOTAL ON ANY BYTES, which matters because these are not this
; program's bytes. A conforming kernel returns whole records and `off`
; lands exactly on `n`, so no refusal below can fire - and the decoder
; does not get to assume that, because the cost of being wrong is
; reading a length out of uninitialised buffer and inventing a filename
; from it. THREE conditions make it total: the header must fit, the
; record must fit, and the record must be long enough to hold the name
; field - which is also what makes it advance.
;
; The third was missing until 2026-08-23, and the two that were here
; said nothing about where the NAME starts. `direntNameOffset` is 21 on
; Darwin and 19 on Linux, so a `d_reclen` of 1 through 18 satisfied both
; of them - `off + 18 <= n` and `off + reclen <= n` - and the NUL scan
; then began at `off + 21`, past the last byte the kernel wrote, and ran
; on through whatever the buffer happened to hold until it met a zero.
; `reclen > direntNameOffset` in place of `reclen > 0` puts the name's
; first byte inside the record, which the fit test has already put
; inside `n`; the shortest record either kernel emits is 24 bytes, so
; nothing a conforming one returns is refused by it.
(:: sysReadDirDecode (-> Int Int Int Int Int))

(fn (sysReadDirDecode buf off n out)
  ; 18 is the last byte of `d_reclen` on both layouts; without room for
  ; it there is no length to read.
  (if (> (+ off 18) n)
    0
    ; d_reclen: a little-endian u16 at offset 16 on both layouts.
    ; There is no `__load16`, and building it from two bytes is
    ; correct on every target this compiler emits for - all of
    ; them are little-endian, and a big-endian one would need a
    ; capability here the way the name offset already has one.
    ; A record that does not advance would spin this loop
    ; forever; one that runs past `n`, or one too short to
    ; reach its own name field, would read a name out of bytes
    ; the kernel did not write. Stopping loses the rest of the
    ; buffer, which is strictly better than any of the three.
    (let ((p (+ buf off)))
      (let ((reclen (+ (memGetByte p 16) (* (memGetByte p 17) 256))))
        (if (|| (<= reclen direntNameOffset) (> (+ off reclen) n))
          0
          {
            (vecPush
              out              (cast Int (strDup (strFromLit (+ p direntNameOffset))))
            )
            (sysReadDirDecode buf (+ off reclen) n out)
          }
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The working directory.
;
; Two shapes rather than one number, because Darwin has no `getcwd`
; syscall at ALL - the number that used to be `__getcwd` is a hole in
; the current table, and calling it kills the process with SIGSYS
; (probed on this host, 2026-08-15). `fcntl(fd, F_GETPATH, buf)` is
; the way in there, and the reason it does not repeat `stat`'s mistake
; is that its answer is BYTES: a NUL-terminated path into a buffer the
; caller supplies, with no offsets or widths to get wrong.
;
; There is no `chdir` here to match, and that is deliberate: nothing
; in this library or above it changes directory, a process that does
; has invalidated every relative path any other part of it is holding,
; and a setter with no caller is a syscall number nobody has run.
; ------------------------------------------------------------------
; The process's working directory as an absolute path, or "" if it
; cannot be determined.
;
; The length is read off the BYTES, with `strFromLit`, rather than off
; the syscall's result - the two platforms disagree about what that
; result means (Linux answers the length including the NUL, Darwin's
; `fcntl` answers 0) and the NUL is the one thing both write.
(pub :: sysGetCwd String)

;@axiom:effect(io)
(pub fn (sysGetCwd)
  ; PATH_MAX is 4096 on Linux and 1024 on Darwin; one buffer at the
  ; larger figure serves both, and a path too long for it comes back
  ; as "" (ERANGE) rather than truncated.
  (let ((buf (memAlloc 4097)))
    (if (== cwdUsesFcntlPath 1)
      (let ((fd (sysOpenPath (__addr ".") 0)))
        (if (sysFailed fd)
          ""
          (let ((rc (__syscall3 sysCwdNum fd fGetPath buf)))
            {
              (sysCloseFd fd)
              (if (< rc 0)
                ""
                (strDup (strFromLit buf))
              )
            }
          )
        )
      )
      (let ((rc (__syscall2 sysCwdNum buf 4096)))
        (if (< rc 0)
          ""
          (strDup (strFromLit buf))
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The environment.
;
; There is no `__envp` primitive and none is needed. The kernel lays the
; initial process stack out as
;
;   argc, argv[0..n-1], NULL, envp[0..m-1], NULL, ...
;
; contiguously, on Darwin and Linux alike, and `__argv` indexes that
; vector without bounds-checking - the primitives are where the type
; system stops. So `argv[argc]` is the NULL that ends the arguments and
; `argv[argc+1+i]` is the i-th environment entry. Probed: `argv[argc]`
; reads 0 and `argv[argc+1]` reads a `NAME=value` string.
;
; Deriving it beats adding a third parameter to the entry wrapper,
; which would have had to land in both compilers to keep the bootstrap
; building.
; ------------------------------------------------------------------
; The address of the i-th environment entry's bytes, or 0 past the end.
(:: sysEnvSlot (-> Int Int))

;@axiom:effect(io)
(fn (sysEnvSlot i) (__argv (+ (+ __argc 1) i)))

; How many entries the environment has.
(:: sysEnvCount Int)

;@axiom:effect(io)
(fn (sysEnvCount) (sysEnvCountFrom 0))

(:: sysEnvCountFrom (-> Int Int))

;@axiom:effect(io)
(fn (sysEnvCountFrom i)
  (if (== (sysEnvSlot i) 0)
    i
    (sysEnvCountFrom (+ i 1))
  )
)

; The value of the environment variable `name`, or "" when it is unset.
;
; The answer SHARES the environment's bytes rather than copying them,
; so it is not NUL-terminated - `strSlice` wraps an interior pointer.
; Anything handing it to a syscall as a path must copy it first, which
; `strConcat` and `strDup` both do.
(pub :: sysEnv (-> String String))

;@axiom:effect(io)
(pub fn (sysEnv name) (sysEnvLookup (strConcat name "=") 0))

(:: sysEnvLookup (-> String Int String))

;@axiom:effect(io)
(fn (sysEnvLookup prefix i)
  (let ((p (sysEnvSlot i)))
    (if (== p 0)
      ""
      (let ((e (strFromLit p)))
        (if (strStartsWith e prefix)
          (strSlice e (strLen prefix) (- (strLen e) (strLen prefix)))
          (sysEnvLookup prefix (+ i 1))
        )
      )
    )
  )
)

; A NULL-terminated copy of the process's own environment vector, in the
; form a child expects.
;
; The pointers are the parent's own environment strings, which live for
; the whole run, so only the vector is copied. A child spawned with this
; inherits the environment exactly; spawning with 0 instead gives it an
; empty one, which is rarely what a compiler driver wants - `cc` in
; particular resolves its toolchain through the environment.
(pub :: sysEnvp Int)

;@axiom:effect(io)
(pub fn (sysEnvp)
  (let ((n sysEnvCount))
    (let ((v (memAlloc (* (+ n 1) 8))))
      {
        (sysEnvpFill v 0 n)
        v
      }
    )
  )
)

(:: sysEnvpFill (-> Int Int Int Int))

;@axiom:effect(io)
(fn (sysEnvpFill v i n)
  (if (>= i n)
    (memSetWord v n 0)
    {
      (memSetWord v i (sysEnvSlot i))
      (sysEnvpFill v (+ i 1) n)
    }
  )
)

; ------------------------------------------------------------------
; Child processes.
;
; A compiler driver has to run `llc` and `cc`, which is the one thing
; this standard library could not do at all. The two platforms reach it
; differently, and the difference is forced rather than chosen: Darwin's
; `fork` returns TWO values - the pid in x0 and an "am I the child" flag
; in x1 - and `__syscallN` yields one register, so a Darwin child would
; read its parent's pid and both processes would take the parent branch.
; `posix_spawn` returns the pid through a pointer, which one register
; carries. Linux's `fork` returns 0 in the child through that same
; single register, so there it is expressible directly.
;
; `Sys.Platform.spawnUsesPosixSpawn` is the capability selecting between
; them, in keeping with `openNeedsDirFd`: nothing here names an OS.
; ------------------------------------------------------------------
; Start `path` with argument vector `argv` and environment `envp`,
; answering the child's pid, or `-errno`.
;
; `path` is a raw NUL-terminated char*, as `sysOpenPath` takes one.
; `argv` and `envp` are NULL-terminated arrays of such pointers; `argv`
; must include the program name at index 0, since the kernel does not
; supply it. Neither vector is searched for on `PATH` - `sysRunPath`
; does that.
(pub :: sysSpawn (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (sysSpawn path argv envp)
  (if (== spawnUsesPosixSpawn 1)
    (let ((pidbuf (memAlloc 8)))
      {
        (memSetWord pidbuf 0 0)
        ; FIVE arguments, not libc's six: the kernel entry point fuses
        ; the file actions and the attributes into one descriptor, so
        ; `(pid, path, adesc, argv, envp)` is the shape. See the note
        ; on `sysPosixSpawn` in the Darwin platform module for what the
        ; six-argument spelling does instead, and why it is nearly
        ; invisible.
        (let ((rc (__syscall5
          sysPosixSpawn          pidbuf          path          0          argv          envp
        )))
          (if (< rc 0)
            rc
            (memGetWord pidbuf 0)
          )
        )
      }
    )
    ; The path is tested BEFORE the fork, and only this backend needs
    ; the test. `posix_spawn` resolves the path in the PARENT and
    ; answers `-ENOENT` without creating a process; here the fork
    ; always succeeds, the failed `execve` is the CHILD's problem, and
    ; the only thing the parent gets back is the exit status set
    ; below - 127, a positive number indistinguishable from a tool
    ; that ran and exited 127. Conflating those two is exactly what
    ; `sysRun`'s contract says it does not do.
    ;
    ; `sysRunSearch` has its own test for the same reason and it is
    ; not this one: that one skips a candidate on ANY open failure,
    ; which is `execvp`'s rule for a PATH walk. This is the direct
    ; path, where ENOENT ONLY is deliberate - a file that cannot be
    ; opened can still be executable (mode 0711 is readable by nobody
    ; and runnable by everyone), and `execve` is the only thing
    ; entitled to decide that, so every other open failure still
    ; forks and asks it.
    (let ((probe (sysOpenPath path oRdonly)))
      (if (== probe (- 0 2))
        probe
        {
          (if (>= probe 0)
            (sysCloseFd probe)
            0
          )
          ; Through `sysForkProcess` rather than the raw syscall, because
          ; the test below is `pid == 0` and that is only the child on a
          ; platform where `fork` answers 0 to one of them. Darwin does
          ; not, so while this branch is unreachable there today -
          ; `spawnUsesPosixSpawn` sends it elsewhere - a raw fork here
          ; would have the CHILD fall through to `pid` and return into
          ; the caller as a second copy of the driver, which is the one
          ; failure the comment below is guarding against.
          (let ((pid sysForkProcess))
            (if (< pid 0)
              pid
              (if (== pid 0)
                ; The child. `execve` replaces this image, so
                ; reaching the next line means it failed - and
                ; the child must then die rather than return
                ; into the caller's code and become a second
                ; copy of the driver. 127 is the shell's
                ; convention for "command not found".
                {
                  (__syscall3 sysExecve path argv envp)
                  (__syscall1 sysExit 127)
                  0
                }
                pid
              )
            )
          )
        }
      )
    )
  )
)

; Wait for `pid` and answer the raw wait status, or `-errno`.
(pub :: sysWaitPid (-> Int Int))

;@axiom:effect(io)
(pub fn (sysWaitPid pid)
  ; The kernel writes a 32-bit int into an 8-byte word, so the upper
  ; half is whatever was there before. Zeroing first is what makes
  ; the read below the status rather than the status plus garbage.
  (let ((statbuf (memAlloc 8)))
    {
      (memSetWord statbuf 0 0)
      (let ((w (__syscall4
        sysWait4        pid        statbuf        0        0
      )))
        (if (< w 0)
          w
          (memGetWord statbuf 0)
        )
      )
    }
  )
)

; The exit code carried by a wait status, for a child that exited
; normally.
(pub :: sysExitCode (-> Int Int))

(pub fn (sysExitCode status) (& (>> status 8) 255))

; The signal that killed a child, or 0 if it exited normally.
(pub :: sysTermSignal (-> Int Int))

(pub fn (sysTermSignal status) (& status 127))

; Run `path` to completion and answer its exit code.
;
; A negative answer is the spawn's own `-errno` - the child never ran -
; which is what distinguishes "could not start llc" from "llc rejected
; the module", two failures a driver must not report the same way. A
; child killed by a signal answers 128+signal, the shell's convention.
(pub :: sysRun (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (sysRun path argv envp)
  (let ((pid (sysSpawn path argv envp)))
    (if (< pid 0)
      pid
      (let ((st (sysWaitPid pid)))
        (if (< st 0)
          st
          (if (!= (sysTermSignal st) 0)
            (+ 128 (sysTermSignal st))
            (sysExitCode st)
          )
        )
      )
    )
  )
)

; Run `name`, searching `PATH` for it when it contains no slash.
;
; This is `execvp`'s rule: a name with a slash is a path and is used as
; written, and a bare name is looked for in each `PATH` entry in order.
;
; THE CANDIDATE IS TESTED BEFORE IT IS SPAWNED, and it has to be, on one
; of the two backends. The search used to be done by attempting each
; candidate and moving on when the attempt came back negative. That is
; exactly right under `posix_spawn`, which resolves the path itself and
; answers `-ENOENT` without creating a process - and it is broken under
; `fork`+`execve`, where the fork ALWAYS succeeds, the failed `execve`
; happens in the child, and the only thing the parent gets back is the
; child's exit status. 127 is not negative, so the search stopped at the
; FIRST `PATH` entry and reported that status as the tool's own.
;
; Measured: on both Linux targets `axiom build` answered `AX4003: cc
; failed` with no output from `cc`, because `cc` had never run - it is
; in `/usr/bin` and the first `PATH` entry was LLVM's bindir. `llc`
; worked, from that same first entry, which is what made it look like a
; linker problem. Darwin was unaffected and no gate could see it: the
; whole Linux half of CI had been failing an earlier step for six days.
;
; `sysOpenPath` is the test, so this needs no new syscall on any
; platform - it already routes through `openNeedsDirFd` for the AArch64
; Linux `openat`-only asymmetry, which is the reason the original note
; gave for not testing first (`access` does not exist there).
;
; What that note said about racing is still true, and is accepted: the
; file can vanish between the test and the spawn. The alternative is a
; close-on-exec pipe carrying the child's errno, which is the correct
; POSIX answer and a larger change than the defect justifies. The window
; is a compiler driver locating `llc`.
;
; One more thing this walk does is a `posix_spawn` property and not a
; promise, and saying so is the point of this paragraph. THAT backend
; permission-checks in the parent, so a candidate which exists and is
; not executable comes back as `-EACCES`, the guard below sees a
; negative, and the walk moves on - `execvp`'s own behaviour, minus
; execvp's remembering of the EACCES to report if nothing later
; succeeds. A driver looking for `llc` wants the next candidate either
; way, so the difference does not matter.
;
; Under `fork`+`execve` it is not true. The open above succeeds on a
; mode-0644 file, the `execve` then fails in the child, and 127 comes
; back - non-negative, so the walk STOPS and reports it. Closing that
; needs the same close-on-exec errno pipe named above and is deferred
; for the same reason; a guard on 127 here is not the fix, because it
; would send a tool that legitimately exited 127 round every remaining
; `PATH` entry, which is the conflation this file spent `sysSpawn`
; arguing against. No gate reaches the case: every fake tool
; `check-driver.sh` plants is `chmod +x`.
;
; With `PATH` unset or exhausted the answer is `-2` (ENOENT), which is
; what a caller distinguishing "not installed" from "failed" reads.
;
; AN EMPTY `PATH` IS REFUSED HERE and never reaches the walk, because
; the sentence above was not true of it. `sysEnv` answers "" both for a
; variable that is unset and for one set to nothing, and an empty `path`
; used to be SEARCHED: the walk stops on `(> from (strLen path))`, which
; for the empty string is `0 > 0` and false, so its body ran once on an
; empty entry, and the rule that read an empty entry as "." made the one
; candidate `./name`.
;
; Measured on this host, 2026-08-23: a directory holding an executable
; `probe`, and `env -i ./probe` in it. `(sysRunPath "probe" ...)`
; answered 9 - the exit code of the copy in the WORKING DIRECTORY, which
; had run - where this comment promises -2. It answers -2 now. That
; matters because this is the lookup a compiler driver resolves `llc`
; and `cc` through, so `axiom build` inside a source tree it did not
; write, with no PATH in the environment, ran that tree's `./llc`.
;
; The other way to make the code agree with the comment is `execvp`'s
; own: fall back to a built-in `/usr/bin:/bin` when the variable is
; unset. It is not taken, because -2 is what the paragraph above
; promises and what the driver already reads as "not installed", and
; because a default would have this library guess at a host layout it is
; told nothing else about - a guess that is wrong on any target whose
; toolchain lives elsewhere, and wrong silently.
(pub :: sysRunPath (-> String Int Int Int))

;@axiom:effect(io)
(pub fn (sysRunPath name argv envp)
  (if (>= (strFindByte name 47 0) 0)
    (sysRun (strCStr (strDup name)) argv envp)
    (let ((path (sysEnv "PATH")))
      (if (== (strLen path) 0)
        (- 0 2)
        (sysRunSearch
          name          argv          envp          path          0
        )
      )
    )
  )
)

; Try `name` in each `:`-separated entry of `path` starting at `from`.
;
; `from` past the LAST BYTE ends the walk, and `>=` is what says so: at
; `from == strLen path` there is no entry left to read, only the empty
; slice that `>` let through - the one `sysRunPath`'s note above is
; about. The caller refuses an empty `path` as well; both guards are
; here because either alone leaves this function unable to state its own
; termination.
(:: sysRunSearch (-> String Int Int String Int Int))

;@axiom:effect(io)
(fn (sysRunSearch name argv envp path from)
  (if (>= from (strLen path))
    (- 0 2)
    ; AN EMPTY ENTRY IS SKIPPED rather than read as the
    ; working directory. POSIX does give `PATH=/usr/bin:`
    ; and `PATH=:/usr/bin` a `.` entry and the shell
    ; honours it, so this is a deliberate divergence and
    ; not a bug fix: no caller in this library or above it
    ; wants it. What comes through here are `llc`, `cc`
    ; and `sh`, and a file of one of those names sitting
    ; in whatever directory the compiler happened to be
    ; invoked from is never the one meant - it is the
    ; classic way a build in an untrusted tree runs that
    ; tree's code. Measured 2026-08-23:
    ; `env -i PATH=/nonexistent-dir: ./probe` ran `./probe`
    ; and answered its exit code, 9; it answers -2 now.
    ;
    ; A caller that does mean a program beside it has the
    ; spelling for one, and it is unambiguous: a name with
    ; a slash in it. `sysRunPath` hands `./llc` straight to
    ; `sysRun` and never comes here.
    (let ((colon (strFindByte path 58 from)))
      (let ((end 
        (if (< colon 0)
          (strLen path)
          colon
        )
      ))
        (let ((dir (strSlice path from (- end from))))
          (if (== (strLen dir) 0)
            (sysRunSearch
              name              argv              envp              path              (+ end 1)
            )
            ; `strConcat` copies, so the candidate is
            ; NUL-terminated even though `dir` - a slice sharing
            ; the environment's bytes - is not.
            ; Does it exist? A candidate that cannot be opened
            ; cannot be executed, and under fork+exec that is
            ; the ONLY point at which the two are still
            ; distinguishable - once the fork has happened, "no
            ; such file" and "the tool exited 127" are the same
            ; integer.
            (let ((cand (strConcat (strConcat dir "/") name)))
              (let ((cpath (strCStr cand)))
                (let ((fd (sysOpenPath cpath oRdonly)))
                  (if (< fd 0)
                    (sysRunSearch
                      name                      argv                      envp                      path                      (+ end 1)
                    )
                    {
                      (sysCloseFd fd)
                      (let ((rc (sysRun cpath argv envp)))
                        (if (>= rc 0)
                          rc
                          (sysRunSearch
                            name                            argv                            envp                            path                            (+ end 1)
                          )
                        )
                      )
                    }
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The calling process's own id - the per-session suffix scratch
; files need so two concurrent processes cannot collide. The
; syscall takes no arguments; the unused ones are simply zero.
(pub :: sysGetPid Int)

;@axiom:effect(io)
(pub fn (sysGetPid) (__syscall3 sysGetPidNum 0 0 0))

; Microseconds now, from the platform's cheapest correct clock: Darwin
; answers gettimeofday's timeval (realtime; Darwin's syscall table has
; no clock_gettime), Linux answers CLOCK_MONOTONIC via clock_gettime.
;
; SO ITS CLOCK CLASS DIFFERS BY PLATFORM, and that is a hazard rather
; than a detail. A duration computed from two of these is monotonic on
; Linux and steppable by `ntpd` on Darwin, so a timeout written against
; it is correct on one target and can go negative on the other, with
; nothing in the type or the name to say which you got. This function
; stays as it is - the REPL's `:time` is its only caller and reads it
; as elapsed wall time, which is what it wants - but a caller that
; needs a DURATION should ask `sysNowMonotonic` below and handle its
; refusal, rather than take whichever clock the target happened to have.
; The 16-byte buffer is caller-supplied so a timing loop allocates
; nothing. tv_usec is 32-bit on Darwin with struct padding above it -
; masked, not trusted. A negative answer is the syscall's own error.
(pub :: sysNowMicros (-> Int Int))

;@axiom:effect(io)
(pub fn (sysNowMicros buf)
  (if (== clockIsGettimeofday 1)
    (let ((r (__syscall3 sysClockNum buf 0 0)))
      (if (< r 0)
        r
        (+ (* (memGetWord buf 0) 1000000) (& (memGetWord buf 1) 4294967295))
      )
    )
    (let ((r (__syscall3 sysClockNum 1 buf 0)))
      (if (< r 0)
        r
        (+ (* (memGetWord buf 0) 1000000) (/ (memGetWord buf 1) 1000))
      )
    )
  )
)

; Microseconds from a clock that NEVER steps backwards, or a negative
; when this platform has none. The 16-byte buffer is the caller's, as
; above, so a timing loop allocates nothing.
;
; This is the clock a timeout, a rate limiter, a retry backoff or a
; latency histogram wants. `sysNowMicros` is not: on Darwin it is the
; realtime clock and `ntpd` may step it, so a duration taken across the
; step is wrong and can be negative.
;
; A NEGATIVE ANSWER IS NOT AN ERROR TO RETRY - on Darwin it is -ENOSYS
; and it is what this platform will answer every time, until the arm64
; `CNTVCT_EL0` read that `Sys/Platform.darwin.ax` describes lands as a
; codegen primitive. Ask `clockHasMonotonic` ONCE at startup rather than
; per call, and let the program decide: refuse to start, fall back to
; `sysNowMicros` with the hazard accepted deliberately, or run the
; affected work only where the clock exists. What it must not do is
; take the fallback silently, which is the bug this pair exists to make
; impossible to write by accident.
(pub :: sysNowMonotonic (-> Int Int))

;@axiom:effect(io)
(pub fn (sysNowMonotonic buf)
  (if (== clockHasMonotonic 0)
    (- 0 78)
    (let ((r (__syscall3 sysClockNum 1 buf 0)))
      (if (< r 0)
        r
        (+ (* (memGetWord buf 0) 1000000) (/ (memGetWord buf 1) 1000))
      )
    )
  )
)

; ------------------------------------------------------------------
; Sockets
;
; The thinnest portable layer over the numbers `Sys.Platform` carries,
; and the only place in the standard library that knows a socket from
; a file. Everything here answers the way the rest of this file does:
; a non-negative result, or the syscall's own `-errno`.
;
; TWO PLATFORM DIFFERENCES REACH THIS FAR and both are branched on a
; capability rather than assumed. `sockaddrHasLenByte` decides whether
; an address opens with a length byte, because Darwin's `sin_family` is
; one byte at offset 1 and Linux's is two bytes at offset 0 - layouts
; that cannot share a builder. `eAgain` decides what "nothing to take
; yet" looks like, because it is 35 on Darwin and 11 on Linux, so a
; caller comparing against a literal is right on one target and quietly
; wrong on the other.
;
; There is no `netClose`: `sysCloseFd` already closes any descriptor and
; a socket is one, so a second name for it would be two ways to spell
; the same call and one of them would drift.
;
; NUMERIC ADDRESSES ONLY, and that is structural rather than an
; omission. Resolving a name means `getaddrinfo`, which lives in libc,
; and linking libc costs the property `scripts/check-freestanding.sh`
; exists to hold. A resolver has to arrive as its own decision.
;
; TWO ADDRESS FAMILIES, AND AN ADDRESS CARRIES ITS OWN. `netAddr4` and
; `netAddr6` write the family into the `sockaddr` they build, and
; `netBind`, `netConnect`, `netAddrSize` and `netAddrText` read it back
; out - so one buffer decides its own length and its own rendering and
; no caller passes either. Both lengths were a literal 16 until
; 2026-08-24, which is what made this layer v4-only: measured on
; Darwin, `bind` of a correct `::1` answers -22 EINVAL at length 16 and
; 0 at 28.
;
; NOTHING HERE PARSES ADDRESS TEXT. `netAddrText` renders and has no
; inverse, because the only caller that has wanted one is a test that
; can compare the rendering instead.
; ------------------------------------------------------------------
; A TCP socket, or a negative errno.
(pub :: netSocketTcp Int)

;@axiom:effect(io)
(pub fn (netSocketTcp) (__syscall3 sysSocketNum afInet sockStream 0))

; The same over IPv6. Its own name rather than a family parameter,
; because the family is not a runtime choice at this layer: a caller
; already picked a builder when it made the address, and a socket whose
; family disagrees with the address it is given fails at `bind` and not
; here.
;
; `afInet6` IS THE CONSTANT IN THAT GROUP THAT DOES NOT AGREE - 30 on
; Darwin against Linux's 10, where `afInet` is 2 on both. Measured on
; Darwin 2026-08-24, `socket(10, SOCK_STREAM, 0)` answers -47
; EAFNOSUPPORT, so a cross-copied number dies at this call rather than
; three functions later. `scripts/check-net.sh`'s IPv6 arm runs on all
; three targets and is what holds the number to its platform.
(pub :: netSocketTcp6 Int)

;@axiom:effect(io)
(pub fn (netSocketTcp6) (__syscall3 sysSocketNum afInet6 sockStream 0))

; How many bytes an address of each family occupies, and how big a
; buffer that must take either has to be.
;
; THESE ARE SIZES, NOT PLATFORM NUMBERS. `sockaddr_in` is 16 and
; `sockaddr_in6` is 28 on all three targets, and they agree for a
; reason rather than by luck: Darwin spends its first byte on a length
; and one on the family where Linux spends two on the family, so the
; divergence `sockaddrHasLenByte` names is inside the first four bytes
; and the totals land together. That is why they live here and not in
; `Sys.Platform`.
(pub :: netAddr4Bytes Int)

(pub fn (netAddr4Bytes) 16)

(pub :: netAddr6Bytes Int)

(pub fn (netAddr6Bytes) 28)

; What `netAcceptFrom` wants, which is the larger of the two: a caller
; does not get to know the peer's family until it has the peer.
(pub :: netAddrMaxBytes Int)

(pub fn (netAddrMaxBytes) 28)

; Write an IPv4 `sockaddr_in` into `buf`, which must hold 16 bytes, and
; answer `buf`. The four octets are given in reading order, so
; 127.0.0.1 is `127 0 0 1`.
;
; `port` IS WRITTEN BIG-ENDIAN, which is the opposite of everything else
; this file stores and the reason it is two `memPutByte`s rather than a
; word write: the wire order for `sin_port` and `sin_addr` is network
; order, while all four targets this compiler emits for are
; little-endian machines. Port 8080 is 0x1F90 and goes down as 0x1F
; then 0x90.
(pub :: netAddr4 (-> Int Int Int Int Int Int Int))

(pub fn (netAddr4 buf port a b c d)
  {
    (memSet buf 0 16)
    (if (== sockaddrHasLenByte 1)
      {
        (memPutByte buf 0 16)
        (memPutByte buf 1 afInet)
      }
      {
        (memPutByte buf 0 afInet)
        (memPutByte buf 1 0)
      }
    )
    (memPutByte buf 2 (& (>> port 8) 255))
    (memPutByte buf 3 (& port 255))
    (memPutByte buf 4 a)
    (memPutByte buf 5 b)
    (memPutByte buf 6 c)
    (memPutByte buf 7 d)
    buf
  }
)

; Write an IPv6 `sockaddr_in6` into `buf`, which must hold
; `netAddr6Bytes`, and answer `buf`.
;
; THE EIGHT GROUPS ARE GIVEN IN READING ORDER, each the 16-bit number
; its text form spells: `::1` is `0 0 0 0 0 0 0 1`, `::` is eight
; zeroes, and `2001:db8::1` is `8193 3512 0 0 0 0 0 1`. That is
; `netAddr4`'s contract - octets in reading order - one field width up,
; and it is groups rather than sixteen octets because the text form a
; caller is transcribing from is groups.
;
; THE FAMILY IS WRITTEN AS TWO BYTES ON LINUX and one on Darwin, the
; same split `netAddr4` makes, but the high byte is computed rather
; than written as a literal zero: `sin6_family` is a 16-bit field and
; both numbers fitting in a byte is a property of 30 and 10, not of the
; layout.
;
; `flowinfo` (bytes 4:4) AND `scope_id` (24:4) ARE LEFT ZERO by the
; `memSet` and are not parameters. flowinfo is not read for a stream
; socket on either kernel; scope_id means something only for a
; link-local address, where it is an interface index - which is
; `if_nametoindex`, which is libc, which is the property
; `scripts/check-freestanding.sh` exists to hold. A link-local listener
; arrives as its own decision, the same way a resolver does.
(pub :: netAddr6 (-> Int Int Int Int Int Int Int Int Int Int Int))

(pub fn (netAddr6 buf port g0 g1 g2 g3 g4 g5 g6 g7)
  {
    (memSet buf 0 netAddr6Bytes)
    (if (== sockaddrHasLenByte 1)
      {
        (memPutByte buf 0 netAddr6Bytes)
        (memPutByte buf 1 afInet6)
      }
      {
        (memPutByte buf 0 (& afInet6 255))
        (memPutByte buf 1 (& (>> afInet6 8) 255))
      }
    )
    (memPutByte buf 2 (& (>> port 8) 255))
    (memPutByte buf 3 (& port 255))
    (netPutGroup buf 0 g0)
    (netPutGroup buf 1 g1)
    (netPutGroup buf 2 g2)
    (netPutGroup buf 3 g3)
    (netPutGroup buf 4 g4)
    (netPutGroup buf 5 g5)
    (netPutGroup buf 6 g6)
    (netPutGroup buf 7 g7)
    buf
  }
)

; The `i`th 16-bit group of a `sockaddr_in6` address, written
; big-endian at byte 8 + 2i. Network order, like `sin_port` and
; `sin_addr` and unlike everything else this file stores.
(:: netPutGroup (-> Int Int Int Int))

(fn (netPutGroup buf i g)
  {
    (memPutByte buf (+ 8 (* i 2)) (& (>> g 8) 255))
    (memPutByte buf (+ 9 (* i 2)) (& g 255))
    buf
  }
)

; The `i`th group read back, which is what `netAddrText` renders and
; what decides where a `::` may go.
(:: netGetGroup (-> Int Int Int))

(fn (netGetGroup addr i) (+ (<< (memGetByte addr (+ 8 (* i 2))) 8) (memGetByte addr (+ 9 (* i 2)))))

; The address family in a `sockaddr` - `afInet`, `afInet6`, or whatever
; else the kernel wrote there.
;
; THE ONLY FUNCTION THAT KNOWS WHERE THE FAMILY LIVES, and that is the
; point of it existing: one byte at offset 1 on Darwin, two host-order
; bytes at offset 0 on Linux. A caller that read the byte itself would
; be right on the machine it was written on and silently wrong on the
; other, which is the whole shape `sockaddrHasLenByte` was added to
; stop.
(pub :: netAddrFamily (-> Int Int))

(pub fn (netAddrFamily addr)
  (if (== sockaddrHasLenByte 1)
    (memGetByte addr 1)
    (+ (memGetByte addr 0) (<< (memGetByte addr 1) 8))
  )
)

; The port in a `sockaddr`, decoded from network order. This one does
; NOT branch on the platform or the family: both layouts diverge in the
; four bytes before it and agree from byte 2 on, so `sin_port` and
; `sin6_port` are the same two bytes in the same place.
(pub :: netAddrPort (-> Int Int))

(pub fn (netAddrPort addr) (+ (<< (memGetByte addr 2) 8) (memGetByte addr 3)))

; How many bytes of `addr` a syscall must be given, read off the family
; the buffer carries. This is what `netBind` and `netConnect` pass, and
; the reason neither of them takes a length.
;
; ANYTHING THAT IS NOT v6 TAKES 16, a buffer holding some other family
; included, and that is safe rather than lucky because the kernel
; checks the family before the length. Measured on Darwin 2026-08-24
; against a socket made by `netSocketTcp6`: an address carrying
; `afInet` with a length of 28 answers -47 EAFNOSUPPORT, and a correct
; `::1` with a length of 16 answers -22 EINVAL. Family first, then
; length - so a wrong family is never reported as a wrong size.
(pub :: netAddrSize (-> Int Int))

(pub fn (netAddrSize addr)
  (if (== (netAddrFamily addr) afInet6)
    netAddr6Bytes
    netAddr4Bytes
  )
)

; Bind a socket to an address built by `netAddr4` or `netAddr6`.
;
; THE LENGTH IS STILL NOT A PARAMETER, AND IS NO LONGER A LITERAL. It
; comes from `netAddrSize`, which reads the family out of the buffer,
; because the two families need different lengths and the address is
; the only thing that knows which it is.
;
; It was a literal 16 until 2026-08-24 and the measurement that put it
; there still holds for a v4 address: 0, 4, 8, 12, 20, 24 and 28 were
; each probed on Darwin and every one answered -22 EINVAL. The same
; probe against a correct `::1` answers -22 at 16 and 0 at 28. So there
; is exactly one right length per address - which is precisely why a
; caller must not be the one supplying it.
(pub :: netBind (-> Int Int Int))

;@axiom:effect(io)
(pub fn (netBind fd addr) (__syscall3 sysBindNum fd addr (netAddrSize addr)))

(pub :: netListen (-> Int Int Int))

;@axiom:effect(io)
(pub fn (netListen fd backlog) (__syscall3 sysListenNum fd backlog 0))

; Accept a connection, answering the new socket or a negative errno,
; and throw the peer's address away. `netAcceptFrom` below keeps it;
; this is the form for a caller that does not want the buffer, and it
; passes NULL for both of `accept`'s out-parameters.
;
; THE ACCEPTED SOCKET IS ALWAYS NON-BLOCKING, and that is a contract
; this layer DEFINES rather than a platform behaviour it reports.
;
; The two systems disagree, and silently. Measured 2026-08-24: a Darwin
; listener with `O_NONBLOCK` set answers `F_GETFL` 6, and the socket
; accepted from it answers 6 as well - the flag is INHERITED. Linux's
; accepted socket does not inherit it. So the same code accepts a
; non-blocking socket on one target and a blocking one on the other, and
; a read on it answers -EAGAIN here and waits there, with nothing in the
; result to say which happened.
;
; That is the defect this function exists to remove, and it cost this
; tree a fixture before it was found: `311-preforked-server.ax` reported
; every connection served and NONE echoed, because each worker's read
; met a socket in a state it had not chosen.
;
; Linux reaches it for free - `SOCK_NONBLOCK` is `accept4`'s fourth
; argument, which Darwin's `accept` does not read at all. Darwin pays
; one `fcntl`, unconditionally, because what it would otherwise inherit
; is the LISTENER's state and this function does not get to assume that.
;
; A caller that handles one connection at a time - a worker in a
; pre-forked pool - asks `netSetBlocking` for the other mode and gets a
; defined answer on both.
(pub :: netAccept (-> Int Int))

;@axiom:effect(io)
(pub fn (netAccept fd) (netAcceptFinish (__syscall4
  sysAcceptNum  fd  0  0  acceptNonblockFlag
)))

; The half of an accept that is not the syscall: put the accepted
; socket into the non-blocking state this layer promises, on the target
; where the kernel did not.
;
; SHARED BY `netAccept` AND `netAcceptFrom` rather than written twice.
; The paragraphs above are a CONTRACT this layer defines, and two
; copies of the code behind it is two places for it to stop being the
; same contract - which is the failure `311-preforked-server.ax` cost
; this tree once already.
(:: netAcceptFinish (-> Int Int))

;@axiom:effect(io)
(fn (netAcceptFinish c)
  (if (< c 0)
    c
    (if (== acceptNonblockFlag 0)
      {
        (netSetNonBlocking c)
        c
      }
      c
    )
  )
)

; Accept a connection AND KEEP THE PEER'S ADDRESS. Answers the new
; socket or a negative errno, exactly as `netAccept` does, and fills
; `addr` with the peer's `sockaddr`, which `netAddrFamily`,
; `netAddrPort` and `netAddrText` read.
;
; THE KERNEL ALREADY HAS THIS ADDRESS. `netAccept` passed NULL for the
; two out-parameters that would have received it, and once it has
; returned the information is gone: an access log, a per-IP rate limit
; and per-peer accounting cannot be added by a caller afterwards. That
; is the whole reason this exists.
;
; `cap` IS THE CALLER'S BUFFER SIZE because it is the caller's buffer.
; Pass `netAddrMaxBytes` unless there is a reason not to.
;
; A BUFFER TOO SMALL FOR THE ADDRESS ANSWERS NOTHING RATHER THAN
; SOMETHING WRONG, and that is worth the comparison it costs.
;
; A v6 peer needs 28 bytes. Given 16, the kernel copies what fits and
; writes the REAL length back, so the buffer holds a family, a port,
; the flowinfo and the first EIGHT bytes of the address - and the
; remaining bytes of the address field ARE NOT WRITTEN BY THIS CALL AT
; ALL. That is the whole defect, and it is worse than truncation,
; because what a reader gets back depends on what was in the buffer
; before:
;
;   a buffer used for a previous accept renders THAT PEER's address,
;     which is a live, plausible, wrong answer - the case measured
;     here, where a second accept into the same buffer read `::1`
;     back out of the bytes the first one left;
;   a freshly allocated buffer renders `::`, the unspecified address,
;     which is also a real address a socket can carry.
;
; Neither is distinguishable from a true answer by the caller. An
; access log that prints a wrong address is worse than one that prints
; an honest nothing, which is this section's rule everywhere else, so
; the family is cleared whenever the kernel's length exceeds `cap` and
; `netAddrText` then answers `af=0`.
;
; FOUND BY ATTACKING THE LAYER, NOT BY WRITING IT, and the comment
; here used to bless it: "truncates the address to its first four
; bytes with nothing in the result to say so". It is eight bytes, the
; rest is whatever was already there, and it was never a truncation.
;
; `lenbuf` IS A VALUE-RESULT CELL: four bytes, host order, written on
; the way in and overwritten on the way out. The kernel reads `cap` out
; of it and writes the address's real length back, which is what
; `netAddrLenRead` answers. Measured on Darwin 2026-08-24, given 28 and
; a loopback v4 peer: `accept` answered 16 and left
; `16 2 150 211 127 0 0 1` in the buffer - the length byte, the family,
; the port big-endian, then the four octets. Writing the capacity in is
; not optional; a cell left holding whatever was there before is how a
; caller reads a truncated address, or one larger than `cap` is how it
; smashes the memory past the buffer.
;
; It shares `netAcceptFinish` with `netAccept`, so the non-blocking
; contract above is this function's too and is not re-solved here.
(pub :: netAcceptFrom (-> Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (netAcceptFrom fd addr cap lenbuf)
  {
    (memSet addr 0 cap)
    (netPutInt32 lenbuf 0 cap)
    ; The accept SUCCEEDED - the descriptor is real and the caller
    ; owns it. Only the address is unusable, so only the address is
    ; withdrawn: clearing the family byte is what makes
    ; `netAddrFamily` answer 0 and `netAddrText` answer `af=0`.
    (let ((fd2 (netAcceptFinish (__syscall4
      sysAcceptNum      fd      addr      lenbuf      acceptNonblockFlag
    ))))
      {
        (if (&& (>= fd2 0) (> (netAddrLenRead lenbuf) cap))
          (memSet addr 0 cap)
          0
        )
        fd2
      }
    )
  }
)

; The length the kernel wrote back into a `netAcceptFrom` cell - 16 for
; a v4 peer, 28 for a v6 one. It is the REAL length of the peer's
; address, which is not necessarily how much of it arrived: the kernel
; copies what fits and reports the whole size either way, so a value
; larger than the `cap` that went in means the address was cut short.
; `netAcceptFrom` acts on that itself; a caller reads this to log the
; family it could not store.
;
; IT CANNOT CONFIRM THE VALUE-RESULT ROUND TRIP, and this comment used
; to claim it could. The kernel writes the true length whatever was in
; the cell, so a `netAcceptFrom` that never wrote `cap` in still leaves
; the right number here - which is exactly why the sentinel in
; `317-peer-address.ax` is 0 and not 0xFF.
(pub :: netAddrLenRead (-> Int Int))

(pub fn (netAddrLenRead lenbuf) (netGetInt32 lenbuf 0))

; A four-byte integer in the HOST's order, which is what the kernel
; reads a `socklen_t` and an `int` socket option as - unlike an
; address, whose port and octets are network order. Both spellings were
; written out twice before `netAcceptFrom` needed a third.
(:: netPutInt32 (-> Int Int Int Int))

(fn (netPutInt32 buf off v)
  {
    (memPutByte buf off (& v 255))
    (memPutByte buf (+ off 1) (& (>> v 8) 255))
    (memPutByte buf (+ off 2) (& (>> v 16) 255))
    (memPutByte buf (+ off 3) (& (>> v 24) 255))
    buf
  }
)

(:: netGetInt32 (-> Int Int Int))

(fn (netGetInt32 buf off) (+ (memGetByte buf off) (+ (<< (memGetByte buf (+ off 1)) 8) (+ (<< (memGetByte buf (+ off 2)) 16) (<< (memGetByte buf (+ off 3)) 24)))))

; Render an address as text: a dotted quad for `afInet`, RFC 5952 form
; for `afInet6`.
;
; THE FAMILY IN THE BUFFER DECIDES, so a v4 address cannot come back
; looking like a v6 one. That is the failure worth guarding rather than
; a hypothetical: the two layouts share their first four bytes, so a
; renderer that guessed v6 for a v4 address would read the port as the
; first group and the octets as the second.
;
; A family this layer does not build renders as `af=<n>` and not as a
; dotted quad of whatever was at byte 4. An access log that prints a
; wrong address is worse than one that prints an honest nothing.
;
; THIS ALLOCATES, and it is the only function in this section that
; does - which is why it is a separate call and not part of
; `netAcceptFrom`. It is made when a line is written, not on every
; accept.
(pub :: netAddrText (-> Int String))

(pub fn (netAddrText addr)
  (let ((fam (netAddrFamily addr)))
    (if (== fam afInet6)
      (netAddrText6 addr 0 (netAddrZeroRunStart addr 0 (- 0 1) 1) "")
      (if (== fam afInet)
        (netAddrText4 addr)
        (strConcat "af=" (fmtInt fam))
      )
    )
  )
)

(:: netAddrText4 (-> Int String))

(fn (netAddrText4 addr) (strConcat (strConcat (strConcat (fmtInt (memGetByte addr 4)) ".") (strConcat (fmtInt (memGetByte addr 5)) ".")) (strConcat (strConcat (fmtInt (memGetByte addr 6)) ".") (fmtInt (memGetByte addr 7)))))

; How many groups from `i` are zero. The run this answers is what a
; `::` stands for.
(:: netAddrZeroRun (-> Int Int Int))

(fn (netAddrZeroRun addr i)
  (if (>= i 8)
    0
    (if (== (netGetGroup addr i) 0)
      (+ 1 (netAddrZeroRun addr (+ i 1)))
      0
    )
  )
)

; Where the `::` goes, or -1 for an address that gets none.
;
; RFC 5952 §4.2 IS TWO RULES AND BOTH ARE HERE. A single zero group is
; NOT shortened - `best` starts at 1, so a run of 1 never wins the `>`
; below - because `1:0:2:3:4:5:6:7` and `1::2:3:4:5:6:7` are the same
; length and one of them is ambiguous. And where two runs tie, the
; leftmost wins, which is what a strict `>` gives.
(:: netAddrZeroRunStart (-> Int Int Int Int Int))

(fn (netAddrZeroRunStart addr i best bestLen)
  (if (>= i 8)
    best
    (let ((n (netAddrZeroRun addr i)))
      (if (> n bestLen)
        (netAddrZeroRunStart addr (+ i n) i n)
        (netAddrZeroRunStart
          addr          (+
            i            (if (> n 0)
              n
              1
            )
          )          best          bestLen
        )
      )
    )
  )
)

; The groups joined, lowercase and without leading zeroes - RFC 5952
; §4.1 and §4.3 - with the run beginning at `zs` collapsed to `::`.
;
; THE TWO EDGES ARE THE ENDS. A run that starts at group 0 leaves `acc`
; empty and contributes the FIRST of the two colons, the next group
; supplying the second; a run that reaches group 8 has no next group to
; do that, so it writes both. `::` itself is the second case with
; nothing before it.
(:: netAddrText6 (-> Int Int Int String String))

(fn (netAddrText6 addr i zs acc)
  (if (>= i 8)
    acc
    (if (== i zs)
      (let ((n (netAddrZeroRun addr i)))
        (netAddrText6
          addr          (+ i n)          zs          (strConcat
            acc            (if (== (+ i n) 8)
              "::"
              ":"
            )
          )
        )
      )
      (netAddrText6
        addr        (+ i 1)        zs        (strConcat
          (if (== i 0)
            acc
            (strConcat acc ":")
          )          (fmtHex (netGetGroup addr i))
        )
      )
    )
  )
)

; The same, with the port, in the form a URL authority uses:
; `127.0.0.1:80` and `[::1]:80`.
;
; THE BRACKETS ARE NOT DECORATION. A v6 address contains colons, so
; `::1:80` cannot be split back into an address and a port; RFC 3986
; §3.2.2 resolves that with the brackets, and a caller writing an
; access log should not have to know which family needs them.
(pub :: netAddrTextPort (-> Int String))

(pub fn (netAddrTextPort addr)
  (if (== (netAddrFamily addr) afInet6)
    (strConcat (strConcat "[" (netAddrText addr)) (strConcat "]:" (fmtInt (netAddrPort addr))))
    (strConcat (netAddrText addr) (strConcat ":" (fmtInt (netAddrPort addr))))
  )
)

; Take a descriptor OUT of non-blocking mode, preserving the other flags
; it carries. The counterpart of `netSetNonBlocking`, and what a caller
; that handles one connection synchronously wants from `netAccept`'s
; result.
(pub :: netSetBlocking (-> Int Int))

;@axiom:effect(io)
(pub fn (netSetBlocking fd)
  (let ((fl (__syscall3 sysFcntlNum fd fGetFl 0)))
    (if (< fl 0)
      fl
      (__syscall3 sysFcntlNum fd fSetFl (& fl (^ oNonblock (- 0 1))))
    )
  )
)

; Connect to an address built by `netAddr4` or `netAddr6`. The length
; comes off the family in the buffer for the same reason `netBind`'s
; does, and was the same literal 16.
(pub :: netConnect (-> Int Int Int))

;@axiom:effect(io)
(pub fn (netConnect fd addr) (__syscall3 sysConnectNum fd addr (netAddrSize addr)))

(pub :: netShutdown (-> Int Int Int))

;@axiom:effect(io)
(pub fn (netShutdown fd how) (__syscall3 sysShutdownNum fd how 0))

; Set an integer-valued socket option. The value crosses as four bytes
; in the host's own order, which is what the kernel reads an `int`
; option as - unlike an address, this one is NOT network order. That is
; `netPutInt32`, which `netAcceptFrom`'s `socklen_t` cell needs for the
; same reason.
(pub :: netSetOptInt (-> Int Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (netSetOptInt fd level name value v)
  {
    (netPutInt32 v 0 value)
    (__syscall5
      sysSetSockOptNum      fd      level      name      v      4
    )
  }
)

; Put a descriptor into non-blocking mode, preserving the flags it
; already carries - a bare `F_SETFL` of the one flag would clear the
; access mode with it.
(pub :: netSetNonBlocking (-> Int Int))

;@axiom:effect(io)
(pub fn (netSetNonBlocking fd)
  (let ((fl (__syscall3 sysFcntlNum fd fGetFl 0)))
    (if (< fl 0)
      fl
      (__syscall3 sysFcntlNum fd fSetFl (| fl oNonblock))
    )
  )
)

; Whether a negative answer means "nothing to take yet" rather than a
; broken socket. This is the whole reason `eAgain` is a capability: the
; number is 35 on Darwin and 11 on Linux, so an event loop written
; against a literal runs correctly on the machine it was written on.
(pub :: netWouldBlock (-> Int Bool))

(pub fn (netWouldBlock r) (== r (- 0 eAgain)))

; ------------------------------------------------------------------
; Readiness
;
; One descriptor that answers which of many others can be read without
; blocking - kqueue on Darwin, epoll on Linux - behind one set of names.
;
; THE TWO MECHANISMS DIFFER IN SHAPE, NOT ONLY IN NUMBERS, which is why
; this is a branch and not a table. kqueue registers and collects with
; ONE call; epoll needs `epoll_ctl` to register and `epoll_pwait` to
; collect. The event records disagree too: kqueue's is 32 bytes with the
; descriptor first, epoll's is 12 bytes on x86_64 and 16 on aarch64 with
; the descriptor at 4 or 8. `Sys.Platform` carries all three sizes and
; offsets; nothing here hardcodes one.
;
; THE CALLER OWNS THE EVENT BUFFER, sized by `netPollBufBytes`. That
; keeps a wait loop allocation-free, which is the whole point of having
; a readiness call at all: a server that allocated per poll would grow
; without bound under an allocator that does not free.
; ------------------------------------------------------------------
; Store a 64-bit value as eight little-endian bytes. NOT `memSetWord`:
; that takes a SHARE of a reference (`__retainref`, MM-LIFE-2d) because
; it is written for payload words that may be handles, and an ABI record
; is raw bytes the kernel wrote a meaning onto. Retaining one would be
; retaining whatever integer the kernel happened to put there.
(:: netPutWord (-> Int Int Int Int))

(fn (netPutWord buf off v)
  {
    (memPutByte buf off (& v 255))
    (memPutByte buf (+ off 1) (& (>> v 8) 255))
    (memPutByte buf (+ off 2) (& (>> v 16) 255))
    (memPutByte buf (+ off 3) (& (>> v 24) 255))
    (memPutByte buf (+ off 4) (& (>> v 32) 255))
    (memPutByte buf (+ off 5) (& (>> v 40) 255))
    (memPutByte buf (+ off 6) (& (>> v 48) 255))
    (memPutByte buf (+ off 7) (& (>> v 56) 255))
    buf
  }
)

; The same, read back. Byte-wise rather than `memGetWord` because the
; offset is not always word-aligned: epoll's data word sits at byte 4 on
; x86_64, where the struct is packed.
(:: netGetWord (-> Int Int Int))

(fn (netGetWord buf off) (+ (memGetByte buf off) (+ (<< (memGetByte buf (+ off 1)) 8) (+ (<< (memGetByte buf (+ off 2)) 16) (+ (<< (memGetByte buf (+ off 3)) 24) (+ (<< (memGetByte buf (+ off 4)) 32) (+ (<< (memGetByte buf (+ off 5)) 40) (+ (<< (memGetByte buf (+ off 6)) 48) (<< (memGetByte buf (+ off 7)) 56)))))))))

; How many bytes an event buffer for `n` events needs on this platform.
(pub :: netPollBufBytes (-> Int Int))

(pub fn (netPollBufBytes n) (* n pollEventSize))

; A readiness descriptor, or a negative errno.
(pub :: netPollCreate Int)

;@axiom:effect(io)
(pub fn (netPollCreate) (__syscall3 sysPollCreateNum 0 0 0))

; Write one registration record for `fd` into `rec`, which must hold
; `pollEventSize` bytes, and answer `rec`. Shared by add and delete
; because the two differ only in the operation word.
(:: netPollRec (-> Int Int Int Int))

(fn (netPollRec rec fd op)
  {
    (memSet rec 0 pollEventSize)
    (if (== pollUsesKqueue 1)
      ; struct kevent: ident, then a SIGNED 16-bit filter, then flags.
      {
        (netPutWord rec 0 fd)
        (memPutByte rec 8 (& pollReadFilter 255))
        (memPutByte rec 9 (& (>> pollReadFilter 8) 255))
        (memPutByte rec 10 (& op 255))
        (memPutByte rec 11 (& (>> op 8) 255))
      }
      ; struct epoll_event: the interest mask, then the token the
      ; kernel hands back - which is the descriptor itself here, so a
      ; woken event needs no side table to say what it was.
      {
        (netPutWord rec 0 pollReadFilter)
        (netPutWord rec pollEventFdOffset fd)
      }
    )
    rec
  }
)

; Watch `fd` for readability. `rec` is scratch of `pollEventSize` bytes.
;
; On Darwin this is `kevent` with a changelist of one and an eventlist
; of none, which registers without collecting; on Linux it is
; `epoll_ctl`. The argument orders do not correspond, which is why the
; branch is here rather than in the numbers.
(pub :: netPollAddRead (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (netPollAddRead pfd fd rec)
  {
    (netPollRec rec fd pollAddOp)
    (if (== pollUsesKqueue 1)
      (__syscall6
        sysPollWaitNum        pfd        rec        1        0        0        0
      )
      (__syscall4
        sysPollCtlNum        pfd        pollAddOp        fd        rec
      )
    )
  }
)

(pub :: netPollDelRead (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (netPollDelRead pfd fd rec)
  {
    (netPollRec rec fd pollDelOp)
    (if (== pollUsesKqueue 1)
      (__syscall6
        sysPollWaitNum        pfd        rec        1        0        0        0
      )
      (__syscall4
        sysPollCtlNum        pfd        pollDelOp        fd        rec
      )
    )
  }
)

; Wait for readiness, answering how many events landed in `buf` or a
; negative errno. A NEGATIVE `timeoutMs` BLOCKS INDEFINITELY, which is
; what a server's accept loop wants; zero polls and returns at once.
;
; The two calls spell the timeout differently and neither converts: epoll
; takes milliseconds in a register, kqueue takes a POINTER to a
; `timespec` and reads NULL as "no timeout". So the millisecond argument
; is this layer's, and the timespec is built here.
(pub :: netPollWait (-> Int Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (netPollWait pfd buf maxEvents timeoutMs ts)
  (if (== pollUsesKqueue 1)
    (if (< timeoutMs 0)
      (__syscall6
        sysPollWaitNum        pfd        0        0        buf        maxEvents        0
      )
      {
        (netPutWord ts 0 (/ timeoutMs 1000))
        (netPutWord ts 8 (* (% timeoutMs 1000) 1000000))
        (__syscall6
          sysPollWaitNum          pfd          0          0          buf          maxEvents          ts
        )
      }
    )
    ; epoll_pwait's fifth argument is a signal mask this layer does not
    ; use, and its sixth is that mask's size, which the kernel checks
    ; against its own `sigset_t` and rejects unless it is exactly 8.
    (__syscall6
      sysPollWaitNum      pfd      buf      maxEvents      timeoutMs      0      pollSigsetSize
    )
  )
)

; The descriptor named by event `i` of a buffer `netPollWait` filled.
;
; Reading it is the one place the three layouts are all visible at once:
; the field is kqueue's `ident` at 0, epoll's `data` at 4 on x86_64 and
; at 8 on aarch64, and the record stride is 32, 12 or 16. Both come from
; `Sys.Platform`; a literal here would be right on one target.
(pub :: netPollFdAt (-> Int Int Int))

(pub fn (netPollFdAt buf i) (netGetWord buf (+ (* i pollEventSize) pollEventFdOffset)))

; ------------------------------------------------------------------
; Entropy
;
; Cryptographically strong random bytes from the kernel, which is the
; only source there is: Axiom links no libc, so there is no `arc4random`
; and no seeded generator to fall back to, and a PRNG written here would
; be a PRNG with no seed.
;
; THE TWO CALLS DIFFER IN THEIR FAILURE SHAPE, not just their number.
; Darwin's `getentropy` fills the buffer completely or answers -errno,
; and refuses more than 256 bytes at a time - measured, a 257-byte
; request answers -22. Linux's `getrandom` answers the COUNT it wrote
; and may write fewer than asked when a signal interrupts it. So the
; loop below advances by the request on one platform and by the answer
; on the other, and `randomIsGetentropy` is which.
; ------------------------------------------------------------------
; Fill `n` bytes at `buf` with kernel entropy. Answers 0, or a negative
; errno with the buffer's contents unspecified.
;
; A ZERO-BYTE REQUEST IS 0 AND MAKES NO SYSCALL, so a caller computing a
; length does not have to special-case an empty one.
(pub :: sysRandomBytes (-> Int Int Int))

;@axiom:effect(io)
(pub fn (sysRandomBytes buf n)
  (let ((mut off 0))
    (let ((mut rc 0))
      {
        (while (&& (< off n) (== rc 0))
          (let ((want 
            (if (> (- n off) randomMaxChunk)
              randomMaxChunk
              (- n off)
            )
          ))
            (let ((r (__syscall3 sysRandomNum (+ buf off) want 0)))
              (if (< r 0)
                (set rc r)
                (if (== randomIsGetentropy 1)
                  ; getentropy filled `want` or it failed; there is no
                  ; partial answer to advance by.
                  (set off (+ off want))
                  ; getrandom answers a count. A zero would be neither a
                  ; failure nor progress, and looping on it would spin,
                  ; so it is treated as a failure the caller can see.
                  (if (== r 0)
                    (set rc (- 0 1))
                    (set off (+ off r))
                  )
                )
              )
            )
          ))
        (if (< rc 0)
          rc
          0
        )
      }
    )
  )
)

; ------------------------------------------------------------------
; Signals
;
; A server has to hear SIGTERM to shut down cleanly, and NEITHER
; PLATFORM DOES IT WITH A HANDLER HERE. That is a design decision and
; not a gap: an Axiom function is `i64(i64...)` and cannot take the
; shape `void(int, siginfo_t*, void*)` a handler needs, and routing a
; signal into the event loop instead removes the handler ABI, async-
; signal-safety and re-entrancy against a bump allocator in one move.
;
; THE TWO PLATFORMS DELIVER IT DIFFERENTLY AND THE SEAM IS VISIBLE.
; Darwin registers `EVFILT_SIGNAL` on the SAME readiness descriptor the
; sockets are on, and the event carries the signal number in `ident`.
; Linux makes the signal a readable descriptor of its own, adds THAT to
; the epoll set, and answers a 128-byte record when it is read. So a
; woken event names a signal on one platform and a descriptor on the
; other, and `netPollSignalAt` is the one function that knows which.
;
; BLOCK BEFORE WATCHING, on both. An unblocked signal takes its default
; disposition, and for SIGTERM that is death before anything observes it.
; ------------------------------------------------------------------
; The `sigset_t` bit for a signal. SIGNAL N IS BIT N-1, an off-by-one
; that is easy to write the other way and yields the neighbouring
; signal's mask rather than an error.
(pub :: sysSigBit (-> Int Int))

(pub fn (sysSigBit signo) (<< 1 (- signo 1)))

; Block the signals in `mask` so they become observable instead of
; fatal. `setbuf` is caller scratch of at least 8 bytes.
(pub :: sysSignalBlock (-> Int Int Int))

;@axiom:effect(io)
(pub fn (sysSignalBlock mask setbuf)
  {
    (netPutWord setbuf 0 mask)
    ; Darwin's `sigprocmask` takes three arguments and Linux's
    ; `rt_sigprocmask` takes a fourth, the mask's size, which it checks
    ; exactly. Passing it unconditionally is the shape `netAccept`
    ; already uses for `accept` against `accept4`.
    (__syscall4
      sysSigProcMaskNum      sigBlockHow      setbuf      0      sigsetBytes
    )
  }
)

; Watch the signals in `mask` on the readiness descriptor `pfd`, and
; answer a HANDLE to pass back to `netPollSignalAt` - the signal
; descriptor on Linux, and 0 on Darwin, which needs none.
;
; `rec` is scratch of `pollEventSize` bytes and `setbuf` of at least 8.
(pub :: netSignalOpen (-> Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (netSignalOpen pfd mask rec setbuf)
  (if (== signalUsesSignalFd 1)
    {
      (netPutWord setbuf 0 mask)
      ; signalfd4(-1, mask, sizemask, 0): -1 creates a descriptor rather
      ; than updating one.
      (let ((sfd (__syscall4
        sysSignalFdNum        (- 0 1)        setbuf        sigsetBytes        0
      )))
        (if (< sfd 0)
          sfd
          {
            (netPollRec rec sfd pollAddOp)
            (let ((r (__syscall4
              sysPollCtlNum              pfd              pollAddOp              sfd              rec
            )))
              (if (< r 0)
                r
                sfd
              )
            )
          }
        )
      )
    }
    ; Darwin has no signal descriptor: each signal is its own filter
    ; registration on the readiness descriptor, so the mask is walked a
    ; bit at a time. Signals are 1..31; bit N-1 is signal N.
    (let ((mut signo 1))
      (let ((mut rc 0))
        {
          (while (< signo 32)
            {
              (if (!= (& mask (sysSigBit signo)) 0)
                {
                  (memSet rec 0 pollEventSize)
                  (netPutWord rec 0 signo)
                  (memPutByte rec 8 (& pollSignalFilter 255))
                  (memPutByte rec 9 (& (>> pollSignalFilter 8) 255))
                  (memPutByte rec 10 (& pollAddOp 255))
                  (memPutByte rec 11 0)
                  (let ((r (__syscall6
                    sysPollWaitNum                    pfd                    rec                    1                    0                    0                    0
                  )))
                    (if (< r 0)
                      (set rc r)
                      0
                    )
                  )
                }
                0
              )
              (set signo (+ signo 1))
            })
          rc
        }
      )
    )
  )
)

; The signal named by event `i`, or a negative when that event is not a
; signal at all. `sigHandle` is what `netSignalOpen` answered and
; `scratch` is caller scratch of at least `sigInfoSize` bytes.
;
; THIS IS THE ONE FUNCTION THAT KNOWS THE SEAM. On Darwin the event's
; own filter says it is a signal and its `ident` IS the signal number,
; so nothing is read. On Linux the event names the signal descriptor and
; the number has to be read out of it - four bytes at offset 0 of a
; 128-byte record, and FOUR rather than eight, because eight would fold
; `ssi_errno` into the answer.
(pub :: netPollSignalAt (-> Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (netPollSignalAt buf i sigHandle scratch)
  (if (== signalUsesSignalFd 1)
    (if (!= (netPollFdAt buf i) sigHandle)
      (- 0 1)
      (let ((n (__syscall3 sysRead sigHandle scratch sigInfoSize)))
        (if (< n sigInfoSize)
          (- 0 1)
          (+ (memGetByte scratch 0) (+ (<< (memGetByte scratch 1) 8) (+ (<< (memGetByte scratch 2) 16) (<< (memGetByte scratch 3) 24))))
        )
      )
    )
    ; Darwin: compare the record's own 16-bit filter field, byte for
    ; byte, rather than sign-extending it back to an Int.
    (let ((off (* i pollEventSize)))
      (if (== (memGetByte buf (+ off 8)) (& pollSignalFilter 255))
        (if (== (memGetByte buf (+ off 9)) (& (>> pollSignalFilter 8) 255))
          (netPollFdAt buf i)
          (- 0 1)
        )
        (- 0 1)
      )
    )
  )
)

; Send a signal, which is how a test raises one against itself.
(pub :: sysKill (-> Int Int Int))

;@axiom:effect(io)
(pub fn (sysKill pid signo) (__syscall3 sysKillNum pid signo 0))

; ------------------------------------------------------------------
; Duplicating this process
;
; `sysSpawn` starts a DIFFERENT program; this starts another copy of
; THIS one, which is what a pre-forked server needs and what `Job`'s
; pool has never wanted.
;
; It answers the POSIX convention on every target - 0 in the child, the
; child's pid in the parent, a negative errno on failure - and one
; platform has to be normalised to reach it. Darwin's `fork` hands the
; child pid back to BOTH processes and distinguishes them in x1, which
; no primitive here reads; the child's answer equals its own pid and the
; parent's does not, so one `getpid` separates them. `forkChildIsZero`
; is which platform needs that.
;
; WHY THIS IS SAFE WHERE `posix_spawn` WAS CHOSEN INSTEAD: `sysSpawn`
; needs the child to become another program, and a fork whose child
; cannot tell it is the child would run the parent's code twice. That is
; the whole hazard, and the comparison below removes it.
;
; MM-PAR-3 is what makes the result usable without any further work:
; every process-wide mutable global - the five allocator words, the
; size-class heads, argc/argv, and one evidence slot per effect - is
; private after a fork. A worker inherits the parent's heap as it stood
; and can never corrupt a sibling's.
(pub :: sysForkProcess Int)

;@axiom:effect(io)
(pub fn (sysForkProcess)
  (let ((r (__syscall5
    sysFork    sysForkArg    0    0    0    0
  )))
    (if (< r 0)
      r
      (if (== forkChildIsZero 1)
        r
        (if (== r (__syscall3 sysGetPidNum 0 0 0))
          0
          r
        )
      )
    )
  )
)
