; Sys - portable syscall wrappers.
;
; The lowest portable layer of Axiom's standard library. Everything here
; is written in Axiom on top of the `__syscallN` primitives; there is no
; C binding anywhere in this file, and none anywhere above it.
;
; NO PUBLIC FUNCTION HERE TAKES OR ANSWERS A FILE DESCRIPTOR. Every
; descriptor a program reaches is held by an owner `IO` declares - a
; `File`, a `Poller` or a `TermGuard` - and the calls that act on one
; are private to `IO`. The two that remain here, an open and a close for
; the spawn path's ENOENT probe and the PATH search, are private and
; close what they open within one call.
;
; Per-platform numbers and flags come from `Sys.Platform`, which the
; compiler resolves to the right `Sys/Platform.<os>[-<arch>].ax` for the
; target being compiled for. Branching on a *capability* exposed by that
; module (`openNeedsDirFd`) rather than on an OS name keeps this file
; from growing a platform list.
;
; ONE EXCEPTION TO "THE PLATFORM MODULE IS A TABLE", stated here because
; this is where the rule is. `Sys/Platform.windows.ax` is not a table
; of syscall numbers - Windows has no syscall ABI a program may use -
; so it answers the capability `usesSyscallAbi` 0 and DOES THE WORK
; ITSELF over `extern "kernel32"` bindings. This file still names no
; OS: where it would call `__syscallN` it asks `usesSyscallAbi` and,
; when the answer is 0, calls the platform module's own function
; (`platformWriteFd`, `platformReadFd`, `platformExitWith`) instead.
; The asymmetry - three modules of constants, one of functions - is
; accepted rather than levelled, because levelling it would move every
; syscall in this file into four copies of the platform layer. What is
; NOT yet routed that way (files, processes, sockets, the clock,
; entropy, signals) reaches its `__syscallN` arm on Windows, which the
; compiler lowers there to a trap that says so (`emitPrimSyscall`).
;
; Return values are raw kernel results, not exceptions: a successful
; result as-is, or `-errno` on failure. That convention holds on every
; supported platform because the backend's BSD syscall sequences
; normalise the carry-flag/positive-errno protocol Darwin and FreeBSD
; share into a negative result (see `targetSyscallAsm` in
; `self_host/codegen.ax`, whose BSD templates branch on carry and
; negate), so a failure is a single portable comparison rather than
; a per-OS special case.
;
; Paths and buffers cross as raw addresses, and these functions trust
; them. A path is the address of live NUL-terminated bytes (`strCStr`
; makes one), and a buffer holds as many live bytes as the call reads
; or writes. A bad address is not caught: the call reads or writes
; whatever is there.
(import Sys.Platform)
; ------------------------------------------------------------------
; Results
;
; `sysResult` turns a raw answer into a `Result`: the convention it
; converts from is this file's own, stated at the top, and the message
; is the operation's name. It is a literal at every call site, so a
; failed call builds one `Error` and no string; a reader who wants a
; sentence builds it where they read it.
(import Err)
(import Str)
(import Mem)
(import Vec)
; `netAddrText` renders an address as decimal octets and hexadecimal
; groups, both of which `Fmt` already does; a second `fmtInt` living
; here would be the drift this library keeps refusing elsewhere. The
; edge adds no cycle - `Fmt` imports `Mem` and `Str` and nothing else,
; and both are above this line.
(import Fmt)

; The errno behind a failed result, or 0 if it did not fail.
(pub :: sysResult (-> String Int (Result Int Error)))
(pub fn (sysResult op n)
  (if (< n 0)
    (Err (mkError (- 0 n) op))
    (Ok n)))

; open(path, flags) with mode 0644, answering the raw descriptor or
; `-errno`. `path` is the address of NUL-terminated bytes. Private: the
; spawn path's ENOENT probe and the PATH search open and close within
; one call, and the Axqlite file calls below open through the mode form.
(:: sysOpenRaw (-> Int Int Int))
;@axiom:effect(io)
(fn (sysOpenRaw path flags)
  (sysOpenPathMode path flags 420))

; open(path, flags, mode). A mode of 0 with `O_CREAT` would create a file
; nobody can read back, which is why the short form passes 0644.
(:: sysOpenPathMode (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (sysOpenPathMode path flags mode)
  (if (== openNeedsDirFd 1)
    (__syscall4
      sysOpenNum
      atFdCwd
      path
      flags
      mode)
    (__syscall3 sysOpenNum path flags mode)))

; Close a descriptor.
;
; ANSWERS `(Result Int Error)`; `Ok 0` on success. A close that fails
; is not a formality - on a written-to file it is where a deferred
; write error surfaces, and it is the one errno a caller cannot get
; anywhere else.
(:: sysCloseFd (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (sysCloseFd fd)
  (sysResult "sysCloseFd" (__syscall1 sysCloseNum fd)))

; Terminate the process. Never returns; the `0` afterwards exists only
; because every Axiom expression has a value.
(pub :: sysExitWith (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysExitWith code)
  {
    (if (== usesSyscallAbi 1)
      (__syscall1 sysExitNum code)
      (platformExitWith code))
    0
  })

; ------------------------------------------------------------------
; Command-line arguments.
;
; The entry wrapper captures `argc`/`argv` before `main` runs; the
; `__argc`/`__argv` primitives read them back. `__argv` is unchecked -
; the primitives are where the type system stops - so the bounds live
; here, and an out-of-range index answers the empty string rather
; than whatever address sits past the vector.
;
; EVERYTHING BELOW THAT READS THEM CARRIES `;@axiom:effect(io)`, and it
; does not make a syscall. `IO` means "reaches the outside world", and
; the command line is input this process did not compute: a function
; that reads it is not a function of its arguments, which is the thing
; `MM-EXEC-9b` says a purity claim ought to exclude. Until 2026-08-25
; `__argc`/`__argv` were registered like `__load64`, which computes, so
; every one of these was inferred effect-free and `;@axiom:effect(pure)` over
; one of them was accepted. That was `MM-EXEC-9a`'s second row.
; The same applies to the environment block below, which `sysEnvp`
; reaches through `__argv` past the end of the argument vector.
; ------------------------------------------------------------------
; How many arguments the process received, including the program name.
(pub :: sysArgc Int)
;@axiom:effect(io)
(pub fn (sysArgc)
  __argc)

; The i-th argument as a Str (0 is the program name), or "" when `i`
; is out of range. The bytes are the process's own argv storage -
; NUL-terminated, alive for the whole run, never freed or moved - so
; wrapping them without copying is sound.
(pub :: sysArg (-> Int String))
;@axiom:effect(io)
(pub fn (sysArg i)
  (if (|| (< i 0) (>= i __argc))
    ""
    (strFromLit (__argv i))))

; ------------------------------------------------------------------
; The environment.
;
; There is no `__envp` primitive and none is needed. The kernel lays the
; initial process stack out as
;
;   argc, argv[0..n-1], NULL, envp[0..m-1], NULL, ...
;
; contiguously, on Darwin and Linux alike, and `__argv` indexes that
; vector without bounds-checking - the primitives are where the type
; system stops. So `argv[argc]` is the NULL that ends the arguments and
; `argv[argc+1+i]` is the i-th environment entry. Probed: `argv[argc]`
; reads 0 and `argv[argc+1]` reads a `NAME=value` string.
;
; Deriving it beats adding a third parameter to the entry wrapper,
; which would have had to land in both compilers to keep the bootstrap
; building.
; ------------------------------------------------------------------
; The address of the i-th environment entry's bytes, or 0 past the end.
(:: sysEnvSlot (-> Int Int))
;@axiom:effect(io)
(fn (sysEnvSlot i)
  (__argv (+ (+ __argc 1) i)))

; How many entries the environment has.
(:: sysEnvCount Int)
;@axiom:effect(io)
(fn (sysEnvCount)
  (sysEnvCountFrom 0))

(:: sysEnvCountFrom (-> Int Int))
;@axiom:effect(io)
(fn (sysEnvCountFrom i)
  (if (== (sysEnvSlot i) 0)
    i
    (sysEnvCountFrom (+ i 1))))

; The value of the environment variable `name`, or "" when it is unset.
;
; The answer SHARES the environment's bytes rather than copying them,
; so it is not NUL-terminated - `strSlice` wraps an interior pointer.
; Anything handing it to a syscall as a path must copy it first, which
; `concat` and `strDup` both do.
(pub :: sysEnv (-> String String))
;@axiom:effect(io)
(pub fn (sysEnv name)
  (sysEnvLookup (concat name "=") 0))

(:: sysEnvLookup (-> String Int String))
;@axiom:effect(io)
(fn (sysEnvLookup prefix i)
  (let ((p (sysEnvSlot i)))
    (if (== p 0)
      ""
      (let ((e (strFromLit p)))
        (if (strStartsWith e prefix)
          (strSlice e (strLen prefix) (- (strLen e) (strLen prefix)))
          (sysEnvLookup prefix (+ i 1)))))))

; A NULL-terminated copy of the process's own environment vector, in the
; form a child expects.
;
; The pointers are the parent's own environment strings, which live for
; the whole run, so only the vector is copied. A child spawned with this
; inherits the environment exactly; spawning with 0 instead gives it an
; empty one, which is rarely what a compiler driver wants - `cc` in
; particular resolves its toolchain through the environment.
(pub :: sysEnvp Int)
;@axiom:effect(io)
(pub fn (sysEnvp)
  (let ((n sysEnvCount))
    (let ((v (memAlloc (* (+ n 1) 8))))
      {
        (sysEnvpFill v 0 n)
        v
      })))

(:: sysEnvpFill (-> Int Int Int Int))
;@axiom:effect(io)
(fn (sysEnvpFill v i n)
  (if (>= i n)
    (memSetWord v n 0)
    {
      (memSetWord v i (sysEnvSlot i))
      (sysEnvpFill v (+ i 1) n)
    }))

; ------------------------------------------------------------------
; Child processes.
;
; A compiler driver has to run `llc` and `cc`, which is the one thing
; this standard library could not do at all. The two platforms reach it
; differently, and the difference is forced rather than chosen: Darwin's
; `fork` returns TWO values - the pid in x0 and an "am I the child" flag
; in x1 - and `__syscallN` yields one register, so a Darwin child would
; read its parent's pid and both processes would take the parent branch.
; `posix_spawn` returns the pid through a pointer, which one register
; carries. Linux's `fork` returns 0 in the child through that same
; single register, so there it is expressible directly.
;
; `Sys.Platform.spawnUsesPosixSpawn` is the capability selecting between
; them, in keeping with `openNeedsDirFd`: nothing here names an OS.
; (Nor does `usesSyscallAbi`, the capability under which a platform
; module does this work itself - see the header - which is how a third
; shape of process creation will arrive without a third arm here.)
; ------------------------------------------------------------------
; Start `path` with argument vector `argv` and environment `envp`.
; `(Ok pid)`, or `(Err e)` whose code is the errno - and `Err` means
; no child exists, which is what a caller must not confuse with a
; child that started and failed.
;
; `path` is a raw NUL-terminated char*, as `sysOpenPath` takes one.
; `argv` and `envp` are NULL-terminated arrays of such pointers; `argv`
; must include the program name at index 0, since the kernel does not
; supply it. Neither vector is searched for on `PATH` - `sysRunPath`
; does that.
(pub :: sysSpawn (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
(pub fn (sysSpawn path argv envp)
  (sysResult
    "sysSpawn"
    (if (== spawnUsesPosixSpawn 1)
      (let ((pidbuf (memAlloc 8)))
        {
          (memSetWord pidbuf 0 0)
          ; FIVE arguments, not libc's six: the kernel entry point fuses
          ; the file actions and the attributes into one descriptor, so
          ; `(pid, path, adesc, argv, envp)` is the shape. See the note
          ; on `sysPosixSpawnNum` in the Darwin platform module for what the
          ; six-argument spelling does instead, and why it is nearly
          ; invisible.
          (let ((rc (__syscall5
            sysPosixSpawnNum
            pidbuf
            path
            0
            argv
            envp)))
            (if (< rc 0)
              rc
              (memGetWord pidbuf 0)))
        })
      ; The path is tested BEFORE the fork, and only this backend needs
      ; the test. `posix_spawn` resolves the path in the PARENT and
      ; answers `-ENOENT` without creating a process; here the fork
      ; always succeeds, the failed `execve` is the CHILD's problem, and
      ; the only thing the parent gets back is the exit status set
      ; below - 127, a positive number indistinguishable from a tool
      ; that ran and exited 127. Conflating those two is exactly what
      ; `sysRun`'s contract says it does not do.
      ;
      ; `sysRunSearch` has its own test for the same reason and it is
      ; not this one: that one skips a candidate on ANY open failure,
      ; which is `execvp`'s rule for a PATH walk. This is the direct
      ; path, where ENOENT ONLY is deliberate - a file that cannot be
      ; opened can still be executable (mode 0711 is readable by nobody
      ; and runnable by everyone), and `execve` is the only thing
      ; entitled to decide that, so every other open failure still
      ; forks and asks it.
      (let ((probe (sysOpenRaw path oRdonly)))
        (if (== probe (- 0 2))
          probe
          {
            (if (>= probe 0)
              {
                (let ((_ (sysCloseFd probe))) 0)
                0
              }
              0)
            ; Through `sysForkProcess` rather than the raw syscall, because
            ; the test below is `pid == 0` and that is only the child on a
            ; platform where `fork` answers 0 to one of them. Darwin does
            ; not, so while this branch is unreachable there today -
            ; `spawnUsesPosixSpawn` sends it elsewhere - a raw fork here
            ; would have the CHILD fall through to `pid` and return into
            ; the caller as a second copy of the driver, which is the one
            ; failure the comment below is guarding against.
            (let ((pid sysForkProcess))
              (if (< pid 0)
                pid
                (if (== pid 0)
                  ; The child. `execve` replaces this image, so
                  ; reaching the next line means it failed - and
                  ; the child must then die rather than return
                  ; into the caller's code and become a second
                  ; copy of the driver. 127 is the shell's
                  ; convention for "command not found".
                  {
                    (__syscall3 sysExecveNum path argv envp)
                    (__syscall1 sysExitNum 127)
                    0
                  }
                  pid)))
          })))))

; Wait for `pid`. `(Ok status)` is the raw wait status; `(Err e)`
; carries the errno of a wait that could not be performed.
(pub :: sysWaitPid (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(pub fn (sysWaitPid pid)
  (sysResult
    "sysWaitPid"
    (let ((statbuf (memAlloc 8)))
      {
        ; The kernel writes a 32-bit int into an 8-byte word, so the upper
        ; half is whatever was there before. Zeroing first is what makes
        ; the read below the status rather than the status plus garbage.
        (memSetWord statbuf 0 0)
        (let ((w (__syscall4
          sysWait4Num
          pid
          statbuf
          0
          0)))
          (if (< w 0)
            w
            (memGetWord statbuf 0)))
      })))

; The exit code carried by a wait status, for a child that exited
; normally.
(pub :: sysExitCode (-> Int Int))
(pub fn (sysExitCode status)
  (& (>> status 8) 255))

; The signal that killed a child, or 0 if it exited normally.
(pub :: sysTermSignal (-> Int Int))
(pub fn (sysTermSignal status)
  (& status 127))

; Run `path` to completion and answer its exit code.
;
; `(Err e)` is the spawn's own errno - THE CHILD NEVER RAN - which is
; what distinguishes "could not start llc" from "llc rejected the
; module", two failures a driver must not report the same way. `(Ok c)`
; means it ran, and `c` is what it answered: its exit code, or
; 128+signal if a signal killed it, the shell's convention.
;
; The distinction used to be carried by the SIGN of one Int. It is
; carried by the arms now, which is the difference between a caller
; that may lose it and one that cannot.
; `path`, `argv` and `envp` are as `sysSpawn` takes them.
(pub :: sysRun (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (sysRun path argv envp)
  ; The three-way answer, now split by the type rather than by a sign.
  ; `Err` means THE CHILD NEVER RAN - the spawn's own errno - which is
  ; the distinction a driver must not lose: "could not start llc" and
  ; "llc rejected the module" are different failures. `Ok` means it
  ; ran, and carries what it answered, including `128+n` for a signal
  ; on the shell's convention.
  (match (sysSpawn path argv envp)
    ((Err e) (Err e))
    ((Ok pid)
      (match (sysWaitPid pid)
        ((Err e) (Err e))
        ((Ok st)
          (if (!= (sysTermSignal st) 0)
            (Ok (+ 128 (sysTermSignal st)))
            (Ok (sysExitCode st)))
        ))
    )))

; Run `name`, searching `PATH` for it when it contains no slash.
;
; This is `execvp`'s rule: a name with a slash is a path and is used as
; written, and a bare name is looked for in each `PATH` entry in order.
;
; THE CANDIDATE IS TESTED BEFORE IT IS SPAWNED, and it has to be, on one
; of the two backends. The search used to be done by attempting each
; candidate and moving on when the attempt came back negative. That is
; exactly right under `posix_spawn`, which resolves the path itself and
; answers `-ENOENT` without creating a process - and it is broken under
; `fork`+`execve`, where the fork ALWAYS succeeds, the failed `execve`
; happens in the child, and the only thing the parent gets back is the
; child's exit status. 127 is not negative, so the search stopped at the
; FIRST `PATH` entry and reported that status as the tool's own.
;
; Measured: on both Linux targets `axiom build` answered `AX4003: cc
; failed` with no output from `cc`, because `cc` had never run - it is
; in `/usr/bin` and the first `PATH` entry was LLVM's bindir. `llc`
; worked, from that same first entry, which is what made it look like a
; linker problem. Darwin was unaffected and no gate could see it: the
; whole Linux half of CI had been failing an earlier step for six days.
;
; `sysOpenPath` is the test, so this needs no new syscall on any
; platform - it already routes through `openNeedsDirFd` for the AArch64
; Linux `openat`-only asymmetry, which is the reason the original note
; gave for not testing first (`access` does not exist there).
;
; What that note said about racing is still true, and is accepted: the
; file can vanish between the test and the spawn. The alternative is a
; close-on-exec pipe carrying the child's errno, which is the correct
; POSIX answer and a larger change than the defect justifies. The window
; is a compiler driver locating `llc`.
;
; One more thing this walk does is a `posix_spawn` property and not a
; promise, and saying so is the point of this paragraph. THAT backend
; permission-checks in the parent, so a candidate which exists and is
; not executable comes back as `-EACCES`, the guard below sees a
; negative, and the walk moves on - `execvp`'s own behaviour, minus
; execvp's remembering of the EACCES to report if nothing later
; succeeds. A driver looking for `llc` wants the next candidate either
; way, so the difference does not matter.
;
; Under `fork`+`execve` it is not true. The open above succeeds on a
; mode-0644 file, the `execve` then fails in the child, and 127 comes
; back - non-negative, so the walk STOPS and reports it. Closing that
; needs the same close-on-exec errno pipe named above and is deferred
; for the same reason; a guard on 127 here is not the fix, because it
; would send a tool that legitimately exited 127 round every remaining
; `PATH` entry, which is the conflation this file spent `sysSpawn`
; arguing against. No gate reaches the case: every fake tool
; `check-driver.sh` plants is `chmod +x`.
;
; With `PATH` unset or exhausted the answer is `-2` (ENOENT), which is
; what a caller distinguishing "not installed" from "failed" reads.
;
; AN EMPTY `PATH` IS REFUSED HERE and never reaches the walk, because
; the sentence above was not true of it. `sysEnv` answers "" both for a
; variable that is unset and for one set to nothing, and an empty `path`
; used to be SEARCHED: the walk stops on `(> from (strLen path))`, which
; for the empty string is `0 > 0` and false, so its body ran once on an
; empty entry, and the rule that read an empty entry as "." made the one
; candidate `./name`.
;
; Measured on this host, 2026-08-23: a directory holding an executable
; `probe`, and `env -i ./probe` in it. `(sysRunPath "probe" ...)`
; answered 9 - the exit code of the copy in the WORKING DIRECTORY, which
; had run - where this comment promises "not found". It refuses now,
; and since 0.3.4 it refuses in the `Err` arm rather than as -2. That
; matters because this is the lookup a compiler driver resolves `llc`
; and `cc` through, so `axiom build` inside a source tree it did not
; write, with no PATH in the environment, ran that tree's `./llc`.
;
; The other way to make the code agree with the comment is `execvp`'s
; own: fall back to a built-in `/usr/bin:/bin` when the variable is
; unset. It is not taken, because -2 is what the paragraph above
; promises and what the driver already reads as "not installed", and
; because a default would have this library guess at a host layout it is
; told nothing else about - a guess that is wrong on any target whose
; toolchain lives elsewhere, and wrong silently.
; `argv` must be a NULL-terminated vector of addresses of NUL-terminated
; bytes, and `envp` 0 or another such vector.
(pub :: sysRunPath (-> String Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (sysRunPath name argv envp)
  (if (match (strFindByte name 47 0)
    ((None) false)
    ((Some _) true))
    (sysRun (strCStr (strDup name)) argv envp)
    (let ((path (sysEnv "PATH")))
      (if (== (strLen path) 0)
        (Err (mkError 2 "sysRunPath: PATH is empty"))
        (sysRunSearch
          name
          argv
          envp
          path
          0)))))

; Try `name` in each `:`-separated entry of `path` starting at `from`.
;
; `from` past the LAST BYTE ends the walk, and `>=` is what says so: at
; `from == strLen path` there is no entry left to read, only the empty
; slice that `>` let through - the one `sysRunPath`'s note above is
; about. The caller refuses an empty `path` as well; both guards are
; here because either alone leaves this function unable to state its own
; termination.
(:: sysRunSearch (-> String Int Int String Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (sysRunSearch name argv envp path from)
  (if (>= from (strLen path))
    ; PATH exhausted: nothing was found to run, which is a spawn
    ; failure and not a child's answer - ENOENT, in the `Err` arm.
    (Err (mkError 2 (concat (concat "sysRunSearch: " name) ": not found on PATH")))
    ; AN EMPTY ENTRY IS SKIPPED rather than read as the
    ; working directory. POSIX does give `PATH=/usr/bin:`
    ; and `PATH=:/usr/bin` a `.` entry and the shell
    ; honours it, so this is a deliberate divergence and
    ; not a bug fix: no caller in this library or above it
    ; wants it. What comes through here are `llc`, `cc`
    ; and `sh`, and a file of one of those names sitting
    ; in whatever directory the compiler happened to be
    ; invoked from is never the one meant - it is the
    ; classic way a build in an untrusted tree runs that
    ; tree's code. Measured 2026-08-23:
    ; `env -i PATH=/nonexistent-dir: ./probe` ran `./probe`
    ; and answered its exit code, 9; it answers -2 now.
    ;
    ; A caller that does mean a program beside it has the
    ; spelling for one, and it is unambiguous: a name with
    ; a slash in it. `sysRunPath` hands `./llc` straight to
    ; `sysRun` and never comes here.
    (let ((end 
      (match (strFindByte path 58 from)
        ((None) (strLen path))
        ((Some colon) colon))))
      (let ((dir (strSlice path from (- end from))))
        (if (== (strLen dir) 0)
          (sysRunSearch
            name
            argv
            envp
            path
            (+ end 1))
          ; `concat` copies, so the candidate is
          ; NUL-terminated even though `dir` - a slice sharing
          ; the environment's bytes - is not.
          ; Does it exist? A candidate that cannot be opened
          ; cannot be executed, and under fork+exec that is
          ; the ONLY point at which the two are still
          ; distinguishable - once the fork has happened, "no
          ; such file" and "the tool exited 127" are the same
          ; integer.
          (let ((cand (concat (concat dir "/") name)))
            (let ((cpath (strCStr cand)))
              (let ((fd (sysOpenRaw cpath oRdonly)))
                (if (< fd 0)
                  (sysRunSearch
                    name
                    argv
                    envp
                    path
                    (+ end 1))
                  {
                    (let ((_ (sysCloseFd fd))) 0)
                    ; `Ok` here means the child RAN, whatever it
                    ; answered - a non-zero exit is this entry's
                    ; result and ends the walk. Only a spawn failure
                    ; (`Err`) means try the next `PATH` entry, which
                    ; is the distinction the old `>= 0` was making by
                    ; sign.
                    (let ((rc (sysRun cpath argv envp)))
                      (if (isOk rc)
                        rc
                        (sysRunSearch
                          name
                          argv
                          envp
                          path
                          (+ end 1))))
                  })))))))))

; The calling process's own id - the per-session suffix scratch
; files need so two concurrent processes cannot collide. The
; syscall takes no arguments; the unused ones are simply zero.
(pub :: sysPid Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysPid)
  (__syscall3 sysGetPidNum 0 0 0))

; Microseconds now, from the platform's cheapest correct clock: Darwin
; answers gettimeofday's timeval (realtime; Darwin's syscall table has
; no clock_gettime), Linux and FreeBSD answer CLOCK_MONOTONIC via
; clock_gettime - under the id `clockMonotonicId` names, because the
; id is not portable: 1 on Linux, and on FreeBSD 4, where 1 is
; CLOCK_VIRTUAL, the process's CPU time. That one was a literal here
; until 2026-08-29, and a clock that measures CPU time never runs
; backwards either, so nothing would have caught it.
;
; SO ITS CLOCK CLASS DIFFERS BY PLATFORM, and that is a hazard rather
; than a detail. A duration computed from two of these is monotonic on
; Linux and steppable by `ntpd` on Darwin, so a timeout written against
; it is correct on one target and can go negative on the other, with
; nothing in the type or the name to say which you got. This function
; stays as it is - the REPL's `:time` is its only caller and reads it
; as elapsed wall time, which is what it wants - but a caller that
; needs a DURATION should ask `sysNowMonotonic` below and handle its
; refusal, rather than take whichever clock the target happened to have.
; The 16-byte buffer is caller-supplied so a timing loop allocates
; nothing on the path that answers a time: the `Ok` is two registers
; when the caller matches the call, and only the syscall's own failure
; builds the `Error` it carries. tv_usec is 32-bit on Darwin with
; struct padding above it - masked, not trusted. `(Result Int Error)`
; since 2026-09-03.
(pub :: sysNowMicros (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysNowMicros buf)
  (if (== clockIsGettimeofday 1)
    (let ((r (__syscall3 sysClockNum buf 0 0)))
      (if (< r 0)
        (Err (mkError (- 0 r) "sysNowMicros"))
        (Ok (+ (* (memGetWord buf 0) 1000000) (& (memGetWord buf 1) 4294967295)))))
    (let ((r (__syscall3 sysClockNum clockMonotonicId buf 0)))
      (if (< r 0)
        (Err (mkError (- 0 r) "sysNowMicros"))
        (Ok (+ (* (memGetWord buf 0) 1000000) (/ (memGetWord buf 1) 1000)))))))

; Microseconds from a clock that NEVER steps backwards, or `Err` when
; this platform has none. The 16-byte buffer is the caller's, as
; above, so a timing loop allocates nothing on the path that answers.
;
; This is the clock a timeout, a rate limiter, a retry backoff or a
; latency histogram wants. `sysNowMicros` is not: on Darwin it is the
; realtime clock and `ntpd` may step it, so a duration taken across the
; step is wrong and can be negative.
;
; THE `Err` IS NOT AN ERROR TO RETRY - on Darwin it carries ENOSYS
; and it is what this platform will answer every time, until the arm64
; `CNTVCT_EL0` read that `Sys/Platform.darwin.ax` describes lands as a
; codegen primitive. Ask `clockHasMonotonic` ONCE at startup rather than
; per call, and let the program decide: refuse to start, fall back to
; `sysNowMicros` with the hazard accepted deliberately, or run the
; affected work only where the clock exists. What it must not do is
; take the fallback silently, which is the bug this pair exists to make
; impossible to write by accident.
(pub :: sysNowMonotonic (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysNowMonotonic buf)
  (if (== clockHasMonotonic 0)
    (Err (mkError 78 "sysNowMonotonic"))
    (let ((r (__syscall3 sysClockNum clockMonotonicId buf 0)))
      (if (< r 0)
        (Err (mkError (- 0 r) "sysNowMonotonic"))
        (Ok (+ (* (memGetWord buf 0) 1000000) (/ (memGetWord buf 1) 1000)))))))

; Nanoseconds since 1970-01-01T00:00:00Z from the realtime clock, the
; wall clock `Chrono.datetimeNowUtc` reads. The system may step it, so
; two readings do not measure a duration: that is `sysNowMonotonic`'s
; job. Darwin answers gettimeofday's microseconds times 1000; Linux and
; FreeBSD answer clock_gettime(CLOCK_REALTIME). A target with no clock
; call (`sysClockNum` 0: Windows and bare metal) answers `Err` 78, as
; `sysNowMonotonic` does. An Int of nanoseconds reaches 2262-04-11, and
; a reading beyond that answers `Err` `errOverflow` rather than wrap.
; The 16-byte buffer is the caller's, as above.
(pub :: sysNowRealtimeNanos (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysNowRealtimeNanos buf)
  (if (== sysClockNum 0)
    (Err (mkError 78 "sysNowRealtimeNanos"))
    (let ((r
      (if (== clockIsGettimeofday 1)
        (__syscall3 sysClockNum buf 0 0)
        ; CLOCK_REALTIME is 0 on Linux and on FreeBSD alike, unlike
        ; the monotonic clock's id.
        (__syscall3 sysClockNum 0 buf 0))))
      (if (< r 0)
        (Err (mkError (- 0 r) "sysNowRealtimeNanos"))
        (let (
          (secs (memGetWord buf 0))
          (ns
            (if (== clockIsGettimeofday 1)
              (* (& (memGetWord buf 1) 4294967295) 1000)
              (memGetWord buf 1)))
        )
          (if (|| (>= secs 9223372036) (<= secs -9223372036))
            (Err (mkError errOverflow "sysNowRealtimeNanos"))
            (Ok (+ (* secs 1000000000) ns))))))))

; ------------------------------------------------------------------
; Socket addresses
;
; The bytes of a `sockaddr`, built and read here; `IO`'s socket calls
; hand them to the kernel and `Net` types them as a `SocketAddr`.
;
; TWO PLATFORM DIFFERENCES REACH THIS FAR and both are branched on a
; capability rather than assumed. `sockaddrHasLenByte` decides whether
; an address opens with a length byte, because Darwin's `sin_family` is
; one byte at offset 1 and Linux's is two bytes at offset 0 - layouts
; that cannot share a builder. `eAgain` decides what "nothing to take
; yet" looks like, because it is 35 on Darwin and 11 on Linux, so a
; caller comparing against a literal is right on one target and quietly
; wrong on the other.
;
; NUMERIC ADDRESSES ONLY, and that is structural rather than an
; omission. Resolving a name means `getaddrinfo`, which lives in libc,
; and linking libc costs the property `scripts/check-freestanding.sh`
; exists to hold. A resolver has to arrive as its own decision.
;
; TWO ADDRESS FAMILIES, AND AN ADDRESS CARRIES ITS OWN. `netAddr4` and
; `netAddr6` write the family into the `sockaddr` they build, and
; `netAddrSize` and `netAddrText` read it back out - so one buffer
; decides its own length and its own rendering and no caller passes
; either. Measured on Darwin, `bind` of a correct `::1` answers -22
; EINVAL at length 16 and 0 at 28.
;
; A function below that reads a socket address takes the raw address
; of one `netAddr4` or `netAddr6` wrote, or of one the kernel answered.
; ------------------------------------------------------------------
; How many bytes an address of each family occupies, and how big a
; buffer that must take either has to be.
;
; THESE ARE SIZES, NOT PLATFORM NUMBERS. `sockaddr_in` is 16 and
; `sockaddr_in6` is 28 on every target, and they agree for a reason
; rather than by luck: the BSDs spend their first byte on a length and
; one on the family where Linux spends two on the family, so the
; divergence `sockaddrHasLenByte` names is inside the first four bytes
; and the totals land together. That is why they live here and not in
; `Sys.Platform`.
(pub :: netAddr4Bytes Int)
(pub fn (netAddr4Bytes)
  16)

(pub :: netAddr6Bytes Int)
(pub fn (netAddr6Bytes)
  28)

; The size of a buffer that takes either family, which is the larger of
; the two: a caller does not get to know a peer's family until it has
; the peer.
(pub :: netAddrMaxBytes Int)
(pub fn (netAddrMaxBytes)
  28)

; Write an IPv4 `sockaddr_in` into `buf`, which must hold 16 bytes, and
; answer `buf`. The four octets are given in reading order, so
; 127.0.0.1 is `127 0 0 1`.
;
; `port` IS WRITTEN BIG-ENDIAN, which is the opposite of everything else
; this file stores and the reason it is two `memPutByte`s rather than a
; word write: the wire order for `sin_port` and `sin_addr` is network
; order, while all six targets this compiler emits for are
; little-endian machines. Port 8080 is 0x1F90 and goes down as 0x1F
; then 0x90.
(pub :: netAddr4 (-> Int Int Int Int Int Int Int))
(pub fn (netAddr4 buf port a b c d)
  {
    (memSet buf 0 16)
    (if (== sockaddrHasLenByte 1)
      {
        (memPutByte buf 0 16)
        (memPutByte buf 1 afInet)
      }
      {
        (memPutByte buf 0 afInet)
        (memPutByte buf 1 0)
      })
    (memPutByte buf 2 (& (>> port 8) 255))
    (memPutByte buf 3 (& port 255))
    (memPutByte buf 4 a)
    (memPutByte buf 5 b)
    (memPutByte buf 6 c)
    (memPutByte buf 7 d)
    buf
  })

; Write an IPv6 `sockaddr_in6` into `buf`, which must hold
; `netAddr6Bytes`, and answer `buf`.
;
; THE EIGHT GROUPS ARE GIVEN IN READING ORDER, each the 16-bit number
; its text form spells: `::1` is `0 0 0 0 0 0 0 1`, `::` is eight
; zeroes, and `2001:db8::1` is `8193 3512 0 0 0 0 0 1`. That is
; `netAddr4`'s contract - octets in reading order - one field width up,
; and it is groups rather than sixteen octets because the text form a
; caller is transcribing from is groups.
;
; THE FAMILY IS WRITTEN AS TWO BYTES ON LINUX and one on Darwin, the
; same split `netAddr4` makes, but the high byte is computed rather
; than written as a literal zero: `sin6_family` is a 16-bit field and
; both numbers fitting in a byte is a property of 30 and 10, not of the
; layout.
;
; `flowinfo` (bytes 4:4) AND `scope_id` (24:4) ARE LEFT ZERO by the
; `memSet` and are not parameters. flowinfo is not read for a stream
; socket on either kernel; scope_id means something only for a
; link-local address, where it is an interface index - which is
; `if_nametoindex`, which is libc, which is the property
; `scripts/check-freestanding.sh` exists to hold. A link-local listener
; arrives as its own decision, the same way a resolver does.
(pub :: netAddr6 (-> Int Int Int Int Int Int Int Int Int Int Int))
(pub fn (netAddr6 buf port g0 g1 g2 g3 g4 g5 g6 g7)
  {
    (memSet buf 0 netAddr6Bytes)
    (if (== sockaddrHasLenByte 1)
      {
        (memPutByte buf 0 netAddr6Bytes)
        (memPutByte buf 1 afInet6)
      }
      {
        (memPutByte buf 0 (& afInet6 255))
        (memPutByte buf 1 (& (>> afInet6 8) 255))
      })
    (memPutByte buf 2 (& (>> port 8) 255))
    (memPutByte buf 3 (& port 255))
    (netPutGroup buf 0 g0)
    (netPutGroup buf 1 g1)
    (netPutGroup buf 2 g2)
    (netPutGroup buf 3 g3)
    (netPutGroup buf 4 g4)
    (netPutGroup buf 5 g5)
    (netPutGroup buf 6 g6)
    (netPutGroup buf 7 g7)
    buf
  })

; The `i`th 16-bit group of a `sockaddr_in6` address, written
; big-endian at byte 8 + 2i. Network order, like `sin_port` and
; `sin_addr` and unlike everything else this file stores.
(:: netPutGroup (-> Int Int Int Int))
(fn (netPutGroup buf i g)
  {
    (memPutByte buf (+ 8 (* i 2)) (& (>> g 8) 255))
    (memPutByte buf (+ 9 (* i 2)) (& g 255))
    buf
  })

; The `i`th group read back, which is what `netAddrText` renders and
; what decides where a `::` may go.
(:: netGetGroup (-> Int Int Int))
(fn (netGetGroup addr i)
  (+ (<< (memGetByte addr (+ 8 (* i 2))) 8) (memGetByte addr (+ 9 (* i 2)))))

; The address family in a `sockaddr` - `afInet`, `afInet6`, or whatever
; else the kernel wrote there.
;
; THE ONLY FUNCTION THAT KNOWS WHERE THE FAMILY LIVES, and that is the
; point of it existing: one byte at offset 1 on Darwin, two host-order
; bytes at offset 0 on Linux. A caller that read the byte itself would
; be right on the machine it was written on and silently wrong on the
; other, which is the whole shape `sockaddrHasLenByte` was added to
; stop.
(pub :: netAddrFamily (-> Int Int))
(pub fn (netAddrFamily addr)
  (if (== sockaddrHasLenByte 1)
    (memGetByte addr 1)
    (+ (memGetByte addr 0) (<< (memGetByte addr 1) 8))))

; The port in a `sockaddr`, decoded from network order. This one does
; NOT branch on the platform or the family: both layouts diverge in the
; four bytes before it and agree from byte 2 on, so `sin_port` and
; `sin6_port` are the same two bytes in the same place.
(pub :: netAddrPort (-> Int Int))
(pub fn (netAddrPort addr)
  (+ (<< (memGetByte addr 2) 8) (memGetByte addr 3)))

; How many bytes of `addr` a syscall must be given, read off the family
; the buffer carries. This is what `IO.socketBind` and
; `IO.socketConnect` pass, and the reason neither of them takes a length.
;
; ANYTHING THAT IS NOT v6 TAKES 16, a buffer holding some other family
; included, and that is safe rather than lucky because the kernel
; checks the family before the length. Measured on Darwin 2026-08-24
; against an IPv6 socket: an address carrying
; `afInet` with a length of 28 answers -47 EAFNOSUPPORT, and a correct
; `::1` with a length of 16 answers -22 EINVAL. Family first, then
; length - so a wrong family is never reported as a wrong size.
(pub :: netAddrSize (-> Int Int))
(pub fn (netAddrSize addr)
  (if (== (netAddrFamily addr) afInet6)
    netAddr6Bytes
    netAddr4Bytes))

; Render an address as text: a dotted quad for `afInet`, RFC 5952 form
; for `afInet6`.
;
; THE FAMILY IN THE BUFFER DECIDES, so a v4 address cannot come back
; looking like a v6 one. That is the failure worth guarding rather than
; a hypothetical: the two layouts share their first four bytes, so a
; renderer that guessed v6 for a v4 address would read the port as the
; first group and the octets as the second.
;
; A family this layer does not build renders as `af=<n>` and not as a
; dotted quad of whatever was at byte 4. An access log that prints a
; wrong address is worse than one that prints an honest nothing.
;
; THIS ALLOCATES, and it is the only function in this section that
; does. It is made when a line is written, not on every accept.
(pub :: netAddrText (-> Int String))
(pub fn (netAddrText addr)
  (let ((fam (netAddrFamily addr)))
    (if (== fam afInet6)
      (netAddrText6 addr 0 (netAddrZeroRunStart addr 0 (- 0 1) 1) "")
      (if (== fam afInet)
        (netAddrText4 addr)
        (concat "af=" (fmtInt fam))))))

(:: netAddrText4 (-> Int String))
(fn (netAddrText4 addr)
  (concat (concat (concat (fmtInt (memGetByte addr 4)) ".") (concat (fmtInt (memGetByte addr 5)) ".")) (concat (concat (fmtInt (memGetByte addr 6)) ".") (fmtInt (memGetByte addr 7)))))

; How many groups from `i` are zero. The run this answers is what a
; `::` stands for.
(:: netAddrZeroRun (-> Int Int Int))
(fn (netAddrZeroRun addr i)
  (if (>= i 8)
    0
    (if (== (netGetGroup addr i) 0)
      (+ 1 (netAddrZeroRun addr (+ i 1)))
      0)))

; Where the `::` goes, or -1 for an address that gets none.
;
; RFC 5952 §4.2 IS TWO RULES AND BOTH ARE HERE. A single zero group is
; NOT shortened - `best` starts at 1, so a run of 1 never wins the `>`
; below - because `1:0:2:3:4:5:6:7` and `1::2:3:4:5:6:7` are the same
; length and one of them is ambiguous. And where two runs tie, the
; leftmost wins, which is what a strict `>` gives.
(:: netAddrZeroRunStart (-> Int Int Int Int Int))
(fn (netAddrZeroRunStart addr i best bestLen)
  (if (>= i 8)
    best
    (let ((n (netAddrZeroRun addr i)))
      (if (> n bestLen)
        (netAddrZeroRunStart addr (+ i n) i n)
        (netAddrZeroRunStart
          addr
          (+
            i
            (if (> n 0)
              n
              1))
          best
          bestLen)))))

; The groups joined, lowercase and without leading zeroes - RFC 5952
; §4.1 and §4.3 - with the run beginning at `zs` collapsed to `::`.
;
; THE TWO EDGES ARE THE ENDS. A run that starts at group 0 leaves `acc`
; empty and contributes the FIRST of the two colons, the next group
; supplying the second; a run that reaches group 8 has no next group to
; do that, so it writes both. `::` itself is the second case with
; nothing before it.
(:: netAddrText6 (-> Int Int Int String String))
(fn (netAddrText6 addr i zs acc)
  (if (>= i 8)
    acc
    (if (== i zs)
      (let ((n (netAddrZeroRun addr i)))
        (netAddrText6
          addr
          (+ i n)
          zs
          (concat
            acc
            (if (== (+ i n) 8)
              "::"
              ":"))))
      (netAddrText6
        addr
        (+ i 1)
        zs
        (concat
          (if (== i 0)
            acc
            (concat acc ":"))
          (fmtHex (netGetGroup addr i)))))))

; The same, with the port, in the form a URL authority uses:
; `127.0.0.1:80` and `[::1]:80`.
;
; THE BRACKETS ARE NOT DECORATION. A v6 address contains colons, so
; `::1:80` cannot be split back into an address and a port; RFC 3986
; §3.2.2 resolves that with the brackets, and a caller writing an
; access log should not have to know which family needs them.
(pub :: netAddrTextPort (-> Int String))
(pub fn (netAddrTextPort addr)
  (if (== (netAddrFamily addr) afInet6)
    (concat (concat "[" (netAddrText addr)) (concat "]:" (fmtInt (netAddrPort addr))))
    (concat (netAddrText addr) (concat ":" (fmtInt (netAddrPort addr))))))

; Whether a negative answer means "nothing to take yet" rather than a
; broken socket. This is the whole reason `eAgain` is a capability: the
; number is 35 on Darwin and 11 on Linux, so an event loop written
; against a literal runs correctly on the machine it was written on.
(pub :: netWouldBlock (-> Int Bool))
(pub fn (netWouldBlock r)
  (== r (- 0 eAgain)))

; ------------------------------------------------------------------
; Raw records
; ------------------------------------------------------------------
; Store a 64-bit value as eight little-endian bytes. NOT `memSetWord`:
; that takes a SHARE of a reference (`__retainref`, MM-LIFE-2d) because
; it is written for payload words that may be handles, and an ABI record
; is raw bytes the kernel wrote a meaning onto. Retaining one would be
; retaining whatever integer the kernel happened to put there.
(:: netPutWord (-> Int Int Int Int))
(fn (netPutWord buf off v)
  {
    (memPutByte buf off (& v 255))
    (memPutByte buf (+ off 1) (& (>> v 8) 255))
    (memPutByte buf (+ off 2) (& (>> v 16) 255))
    (memPutByte buf (+ off 3) (& (>> v 24) 255))
    (memPutByte buf (+ off 4) (& (>> v 32) 255))
    (memPutByte buf (+ off 5) (& (>> v 40) 255))
    (memPutByte buf (+ off 6) (& (>> v 48) 255))
    (memPutByte buf (+ off 7) (& (>> v 56) 255))
    buf
  })

; ------------------------------------------------------------------
; Entropy
;
; Cryptographically strong random bytes from the kernel, which is the
; only source there is: Axiom links no libc, so there is no `arc4random`
; and no seeded generator to fall back to, and a PRNG written here would
; be a PRNG with no seed.
;
; THE TWO CALLS DIFFER IN THEIR FAILURE SHAPE, not just their number.
; Darwin's `getentropy` fills the buffer completely or answers -errno,
; and refuses more than 256 bytes at a time - measured, a 257-byte
; request answers -22. Linux's `getrandom` answers the COUNT it wrote
; and may write fewer than asked when a signal interrupts it. So the
; loop below advances by the request on one platform and by the answer
; on the other, and `randomIsGetentropy` is which.
; ------------------------------------------------------------------
; Fill `n` bytes at `buf` with kernel entropy. `(Ok 0)`, or `(Err e)`
; whose code is the errno - and on `Err` the buffer's contents are
; unspecified, so a caller must not read them.
;
; A ZERO-BYTE REQUEST IS 0 AND MAKES NO SYSCALL, so a caller computing a
; length does not have to special-case an empty one.
;
; A TARGET WITH NO KERNEL ENTROPY CALL ANSWERS `Err`, code 78, and makes
; no call: `windows-x86_64` and `baremetal-aarch64`, where
; `sysRandomNum` is 0. Before 2026-09-29 the request reached the
; `__syscallN` trap there and the program exited 74, which was loud but
; left a caller no way to fall back to another source it trusts.
; `Crypto.Random` reads the CPU's RNDR register on bare metal.
(pub :: sysRandomBytes (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(entropy)
(pub fn (sysRandomBytes buf n)
  (sysResult
    "sysRandomBytes"
    (let ((mut off 0))
      (let ((mut rc
        (if (|| (== usesSyscallAbi 0) (== sysRandomNum 0))
          (if (> n 0)
            sysNoCall
            0)
          0)))
        {
          (while (&& (< off n) (== rc 0))
            (let ((want 
              (if (> (- n off) randomMaxChunk)
                randomMaxChunk
                (- n off))))
              (let ((r (__syscall3 sysRandomNum (+ buf off) want 0)))
                (if (< r 0)
                  (set rc r)
                  (if (== randomIsGetentropy 1)
                    ; getentropy filled `want` or it failed; there is no
                    ; partial answer to advance by.
                    (set off (+ off want))
                    ; getrandom answers a count. A zero would be neither a
                    ; failure nor progress, and looping on it would spin,
                    ; so it is treated as a failure the caller can see.
                    (if (== r 0)
                      (set rc (- 0 1))
                      (set off (+ off r))))))))
          (if (< rc 0)
            rc
            0)
        }))))

; ------------------------------------------------------------------
; Signals
;
; A server has to hear SIGTERM to shut down cleanly, and no platform
; does it with a handler here: an Axiom function is `i64(i64...)` and
; cannot take the shape `void(int, siginfo_t*, void*)` a handler needs.
; The signal is routed into the event loop instead - `IO.pollerAddSignals`
; - which removes the handler ABI, async-signal-safety and re-entrancy
; against a bump allocator in one move.
;
; BLOCK BEFORE WATCHING. An unblocked signal takes its default
; disposition, and for SIGTERM that is death before anything observes it.
; ------------------------------------------------------------------
; The `sigset_t` bit for a signal. SIGNAL N IS BIT N-1, an off-by-one
; that is easy to write the other way and yields the neighbouring
; signal's mask rather than an error.
(pub :: sysSigBit (-> Int Int))
(pub fn (sysSigBit signo)
  (<< 1 (- signo 1)))

; Block the signals in `mask` so they become observable instead of
; fatal. `setbuf` is caller scratch of at least 16 bytes: the mask is
; written as one 64-bit word, and the kernel then copies ITS OWN
; `sigset_t` width out of the buffer - `sigsetBytes`, which is 4 on
; Darwin, 8 on Linux and 16 on FreeBSD. Sixteen covers every target,
; and the bytes between the word and that width are zeroed here rather
; than left to whatever the caller's buffer held, because on FreeBSD
; they are signals 65 through 128 and a stale byte there blocks one.
; Answers `(Result Int Error)`; `Ok 0` on success. Runs once, before
; a server forks, so that every worker inherits the mask.
(pub :: sysSignalBlock (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysSignalBlock mask setbuf)
  {
    (memSet setbuf 0 sigsetBytes)
    (netPutWord setbuf 0 mask)
    ; The BSDs' `sigprocmask` takes three arguments and Linux's
    ; `rt_sigprocmask` takes a fourth, the mask's size, which it checks
    ; exactly. Passing it unconditionally is the shape `IO.socketAccept`
    ; uses for `accept` against `accept4`.
    (sysResult "sysSignalBlock" (__syscall4
      sysSigProcMaskNum
      sigBlockHow
      setbuf
      0
      sigsetBytes))
  })

; Send a signal, which is how a test raises one against itself.
;
; Answers `(Result Int Error)`; `Ok 0` on success. `Err` with ESRCH is
; the answer a pool driver needs and the sentinel hid: "that child is
; already gone" and "the signal was delivered" were both an Int.
(pub :: sysKill (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysKill pid signo)
  (sysResult "sysKill" (__syscall3 sysKillNum pid signo 0)))

; ------------------------------------------------------------------
; Duplicating this process
;
; `sysSpawn` starts a DIFFERENT program; this starts another copy of
; THIS one, which is what a pre-forked server needs and what `Job`'s
; pool has never wanted.
;
; It answers the POSIX convention on every target - 0 in the child, the
; child's pid in the parent, a negative errno on failure - and one
; platform has to be normalised to reach it. Darwin's `fork` hands the
; child pid back to BOTH processes and distinguishes them in x1, which
; no primitive here reads; the child's answer equals its own pid and the
; parent's does not, so one `getpid` separates them. `forkChildIsZero`
; is which platform needs that.
;
; WHY THIS IS SAFE WHERE `posix_spawn` WAS CHOSEN INSTEAD: `sysSpawn`
; needs the child to become another program, and a fork whose child
; cannot tell it is the child would run the parent's code twice. That is
; the whole hazard, and the comparison below removes it.
;
; MM-PAR-3 is what makes the result usable without any further work:
; every process-wide mutable global - the five allocator words, the
; size-class heads, argc/argv, and one evidence slot per effect - is
; private after a fork. A worker inherits the parent's heap as it stood
; and can never corrupt a sibling's.
(pub :: sysForkProcess Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(spawn)
(pub fn (sysForkProcess)
  (let ((r (__syscall5
    sysForkNum
    sysForkArg
    0
    0
    0
    0)))
    (if (< r 0)
      r
      (if (== forkChildIsZero 1)
        r
        (if (== r (__syscall3 sysGetPidNum 0 0 0))
          0
          r)))))

; ------------------------------------------------------------------
; Memory two bindings can share, and blocking on a word in it.
;
; A `parallel` binding runs in a forked child by default and in a
; thread under `--threads`, and an arena page is private either way -
; after a fork it is a COPY. A MAP_SHARED|MAP_ANON mapping made BEFORE
; the spawn is the same pages in both, so a word in it is visible to
; both lowerings (MM-PAR-10). `stdlib/Chan.ax` is built on these four.
; ------------------------------------------------------------------
; Map `len` bytes, readable and writable (PROT_READ|PROT_WRITE = 3),
; shared with every binding spawned after this call; answers the
; address, page-aligned and zeroed. Unmap it with `sysUnmapShared` once
; no binding can still touch it - a program obligation, as a handle's
; single join is (MM-PAR-8).
(pub :: sysMapShared (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysMapShared len)
  (sysResult "sysMapShared" (__syscall6
    sysMmapNum
    0
    len
    3
    mapSharedAnon
    (- 0 1)
    0)))

; `addr` and `len` must name a whole mapping `sysMapShared` answered,
; and nothing may touch it afterwards.
(pub :: sysUnmapShared (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysUnmapShared addr len)
  (sysResult "sysUnmapShared" (__syscall3 sysMunmapNum addr len 0)))

; ------------------------------------------------------------------
; Private pages, and keeping them out of swap and core files.
;
; `stdlib/Crypto/Secret.ax` keeps each secret in a mapping of its own,
; outside the arena, so these four exist for it. A target with no
; syscall ABI answers -78 from each without making a call, the same
; sentinel `sysNowMonotonic` uses for "this platform cannot answer",
; and so does a target whose number for the call is 0.
; ------------------------------------------------------------------
; The unsupported answer: 78, ENOSYS's portable spelling.
(:: sysNoCall Int)
(fn (sysNoCall)
  (- 0 78))

; Map `len` zeroed bytes, readable and writable, private to this
; process: a fork gets a copy, as it does of the arena. Answers the
; page-aligned address.
(pub :: sysMapPrivate (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysMapPrivate len)
  (sysResult
    "sysMapPrivate"
    (if (== usesSyscallAbi 0)
      sysNoCall
      (__syscall6 sysMmapNum 0 len 3 mapPrivateAnon (- 0 1) 0))))

; `addr` and `len` must name a whole mapping `sysMapPrivate` answered,
; and nothing may touch it afterwards.
(pub :: sysUnmapPrivate (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysUnmapPrivate addr len)
  (sysResult
    "sysUnmapPrivate"
    (if (== usesSyscallAbi 0)
      sysNoCall
      (__syscall3 sysMunmapNum addr len 0))))

; Lock `len` bytes at `addr` into memory, so the kernel never writes
; them to swap. The kernel may refuse: `RLIMIT_MEMLOCK` caps how much
; an unprivileged process may lock, and on Linux the default cap is a
; few megabytes. A refusal is an `Err` the caller decides about.
(pub :: sysMlock (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysMlock addr len)
  (sysResult
    "sysMlock"
    (if (== sysMlockNum 0)
      sysNoCall
      (__syscall3 sysMlockNum addr len 0))))

(pub :: sysMunlock (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysMunlock addr len)
  (sysResult
    "sysMunlock"
    (if (== sysMunlockNum 0)
      sysNoCall
      (__syscall3 sysMunlockNum addr len 0))))

; Keep `len` bytes at `addr` out of a core file (`MADV_DONTDUMP` on
; Linux, `MADV_NOCORE` on FreeBSD). Darwin has no such advice, and
; answers the unsupported sentinel.
; `addr` and `len` must name a whole mapping `sysMapPrivate` answered.
(pub :: sysExcludeFromCore (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (sysExcludeFromCore addr len)
  (sysResult
    "sysExcludeFromCore"
    (if (|| (== sysMadviseNum 0) (== madvNoDump 0))
      sysNoCall
      (__syscall3 sysMadviseNum addr len madvNoDump))))

; Block while the word at byte address `addr` - 8-aligned, inside a
; `sysMapShared` mapping - still holds `expected`. It returns when woken,
; when the word already differs on entry, or spuriously, so the caller
; re-checks its own condition every time. That is what makes a lost wake
; impossible: a waker changes the word BEFORE it wakes, so a waiter that
; read the old value either sees the new one on entry or is already in
; the queue the wake empties - with one caveat on Linux, which compares
; only the word's low 32 bits (FUTEX_WAIT, not PRIVATE: the key is the
; shared page): a waiter preempted across exactly a multiple of 2^32
; changes would sleep through them. Darwin compares all 64
; (UL_COMPARE_AND_WAIT64_SHARED = 6). Where `waitWordKind` is 0 it
; returns at once and the caller spins, which is correct and costs a
; core. No timeout here: `sysWaitWordTimeout` below is the timed form,
; and it pays for the timespec this one does not need.
;
; IT ANSWERS 0, AND DISCARDS THE KERNEL'S ANSWER, deliberately. Woken,
; EINTR, EAGAIN (the word differed): every one leads to the same
; re-check, so there is no failure a caller could act on - and a raw
; syscall result is what `tests/compat/verify-compat.py` counts as a
; failure sentinel wanting `Result`, rightly, everywhere a caller could.
; A wrong operation code would make every wait return at once; that is
; caught by running, not by an answer (`scripts/check-chan.sh` §2). The
; branch on `waitWordKind` is where the answer is consumed rather than
; passed on - the census reads a body with a branch of its own that way.
(pub :: sysWaitWord (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (sysWaitWord addr expected)
  (if (== waitWordKind 0)
    0
    {
      (sysWaitWordRaw addr expected)
      0
    }))

(:: sysWaitWordRaw (-> Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(fn (sysWaitWordRaw addr expected)
  (if (== waitWordKind 1)
    (__syscall6
      sysWaitWordNum
      addr
      0
      expected
      0
      0
      0)
    (if (== waitWordKind 2)
      (__syscall4
        sysWaitWordNum
        6
        addr
        expected
        0)
      0)))

; Wake every binding blocked in `sysWaitWord` on `addr`: FUTEX_WAKE (1)
; for INT_MAX waiters, or `__ulock_wake` with UL_COMPARE_AND_WAIT64_SHARED
; | ULF_WAKE_ALL (6 | 0x100). Answers 0 for `sysWaitWord`'s reason: a
; wake with nobody waiting is not an error anyone can act on.
(pub :: sysWakeWord (-> Int Int))
;@axiom:effect(io)
(pub fn (sysWakeWord addr)
  (if (== waitWordKind 0)
    0
    {
      (sysWakeWordRaw addr)
      0
    }))

(:: sysWakeWordRaw (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (sysWakeWordRaw addr)
  (if (== waitWordKind 1)
    (__syscall6
      sysWakeWordNum
      addr
      1
      2147483647
      0
      0
      0)
    (if (== waitWordKind 2)
      (__syscall3 sysWakeWordNum 262 addr 0)
      0)))

; ------------------------------------------------------------------
; A TIMED wait on a shared word, and a look at a child that does not
; reap it (R-C2; docs/memory-model.md MM-PAR-12 and MM-PAR-13).
;
; `stdlib/Chan.ax`, `stdlib/Sync.ax` and `stdlib/Task.ax` are built on
; these. Everything here is the seed's language - no atomic, no new
; primitive - because this file is compiled by the committed seed.
; ------------------------------------------------------------------
; The `Error` code every timed operation in the concurrency modules
; answers when its time ran out: `chanRecvTimeout`, `chanSendTimeout`,
; `mutexLockTimeout`, a task past its deadline. NOT an errno: ETIMEDOUT
; is 60 on Darwin and FreeBSD and 110 on Linux, so a code borrowed from
; the kernel would need one comparison and one fixture per target. It
; is above 255 so that it can never be mistaken for a wait status,
; which is what `Task.ax` puts in the same field for a task that
; trapped.
(pub :: sysTimedOut Int)
(pub fn (sysTimedOut)
  1001)

; A block of `n` bytes with a share taken, and the share given back.
; The release files the block for reuse (MM-LIFE-2k), so a timed loop
; that asks for a timespec on every pass does not grow the arena. Two
; private helpers so the `Unsafe` claim sits on the two lines that
; touch a count, not on the public functions above them - `Chan.ax`'s
; shape.
(:: sysScratch (-> Int Int))
;@axiom:effect(unsafe)
(fn (sysScratch n)
  (let ((b (memAlloc n)))
    {
      (__retain b)
      b
    }))

(:: sysScratchDone (-> Int Int))
;@axiom:effect(unsafe)
(fn (sysScratchDone b)
  {
    (__release b)
    0
  })

; Block while the word at `addr` still holds `expected`, for at most
; `nanos` nanoseconds. `sysWaitWord`'s contract - an 8-aligned word in
; a `sysMapShared` mapping, and every answer means "re-check your own
; condition" - plus a bound, and an answer that says why it returned:
;
;   0  woken - by a wake, a signal, or spuriously
;   1  timed out: the kernel measured `nanos` and nobody woke it
;   2  the word did not hold `expected` when the call began
;
; A caller must treat all three as advice. 2 is decided by a load made
; before the kernel is asked, so a change that lands between that load
; and the kernel's own compare answers 0 on Darwin (whose `__ulock_wait`
; reports a mismatch as a wake - measured: 0 at once, where a timeout
; answers -ETIMEDOUT after 200,201 us for 200,000 asked) and 2 on Linux
; (`futex` says EAGAIN). A non-positive `nanos` never sleeps: it
; answers 2 or 1 from that load alone.
;
; THE ENTRY LOAD IS A PLAIN ONE, and that is a stated reliance, not an
; oversight: this file is compiled by the seed, which has no atomic
; primitive, and the word is one other bindings write with atomics. An
; aligned 64-bit load is single-copy atomic on both ISAs the blocking
; kinds run on (x86-64, AArch64), the answer it feeds is advisory, and
; the syscall after it clobbers memory, so the compiler can neither
; hoist nor merge it. MM-PAR-12 names it beside MM-PAR-9's definition
; of a race.
;
; HOW EACH KIND TIMES OUT.
;   Linux (`waitWordKind` 1): FUTEX_WAIT with a RELATIVE timespec,
;     which the kernel measures on CLOCK_MONOTONIC. The timespec is 16
;     bytes some call must allocate; `sysScratch` takes and returns it.
;   Darwin (2): `__ulock_wait`'s fourth argument, in MICROseconds,
;     rounded UP so the wait is never shorter than asked, and at most
;     2^32-1 (71.6 minutes). A longer request that times out answers 0,
;     not 1 - the kernel did not measure the whole of it - and the
;     caller's loop waits again.
;   None (0): a spin that reads the word and the clock until one of
;     them answers - correct, and it costs a core, as `sysWaitWord`
;     does there.
(pub :: sysWaitWordTimeout (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (sysWaitWordTimeout addr expected nanos)
  (if (!= (memGetWord addr 0) expected)
    2
    (if (<= nanos 0)
      1
      (if (== waitWordKind 0)
        (sysWaitWordSpin addr expected nanos)
        (sysWaitWordTimed addr expected nanos)))))

(:: sysWaitWordTimed (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(fn (sysWaitWordTimed addr expected nanos)
  (if (== waitWordKind 1)
    (let ((ts (sysScratch 16)))
      {
        (memSetWord ts 0 (/ nanos 1000000000))
        (memSetWord ts 1 (% nanos 1000000000))
        (let ((r (__syscall6
          sysWaitWordNum
          addr
          0
          expected
          ts
          0
          0)))
          {
            (sysScratchDone ts)
            (sysWaitAnswer r 0)
          })
      })
    ; A wait past the kernel's 32-bit microseconds goes straight to the
    ; clamped path: rounding such a `nanos` up by adding 999 could wrap
    ; it negative, skip the clamp, and hand the kernel a truncated,
    ; SHORTER wait that it then reports as timed out.
    (let ((us (if (> nanos 4294967295000)
      4294967296
      (/ (+ nanos 999) 1000))))
      (if (> us 4294967295)
        (sysWaitAnswer (sysUlockWait addr expected 4294967295) 1)
        (sysWaitAnswer (sysUlockWait addr expected us) 0)))))

; `__ulock_wait(UL_COMPARE_AND_WAIT64_SHARED, addr, expected, us)`: the
; kernel's raw answer.
(:: sysUlockWait (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(fn (sysUlockWait addr expected us)
  (__syscall4
    sysWaitWordNum
    6
    addr
    expected
    us))

; The kernel's answer as the three codes. `clamped` is 1 when the
; kernel was asked for less than the caller's whole wait, so its
; timeout is a wake, not the end of the wait.
(:: sysWaitAnswer (-> Int Int Int))
(fn (sysWaitAnswer r clamped)
  (if (== r (- 0 eTimedOut))
    (if (== clamped 1)
      0
      1)
    (if (== r (- 0 eAgain))
      2
      0)))

; `waitWordKind` 0: no blocking wait exists, so read the word and the
; clock until one of them answers.
(:: sysWaitWordSpin (-> Int Int Int Int))
;@axiom:effect(io)
(fn (sysWaitWordSpin addr expected nanos)
  (let (
    (buf (sysScratch 16))
    (mut state 0)
  )
    (let ((start (sysTimeoutMicros buf)))
      {
        (while (== state 0)
          (if (!= (memGetWord addr 0) expected)
            (set state 2)
            (if (>= (* (- (sysTimeoutMicros buf) start) 1000) nanos)
              (set state 1)
              0)))
        (sysScratchDone buf)
        state
      })))

; Microseconds from the clock a timeout is measured on: the monotonic
; one where the platform has it and - DELIBERATELY, since nothing
; better is reachable without libSystem - the realtime clock on Darwin
; (`clockHasMonotonic` there says why). The timed loops above this file
; add only non-negative steps of this clock, each clamped to the slice
; the kernel was asked to wait, so a step of the realtime clock moves a
; wait by at most one slice; MM-PAR-12 states the bound. `buf` is 16
; bytes of caller scratch. A clock that cannot be read answers 0, which
; a caller reads as no time having passed: its wait then ends on the
; kernel's own timeout rather than early.
(pub :: sysTimeoutMicros (-> Int Int))
;@axiom:effect(io)
(pub fn (sysTimeoutMicros buf)
  (if (== clockHasMonotonic 1)
    (match (sysNowMonotonic buf)
      ((Ok t) t)
      ((Err e) 0))
    (match (sysNowMicros buf)
      ((Ok t) t)
      ((Err e) 0))))

; Bytes of caller scratch `sysChildExited` needs: a `siginfo_t` is 104
; bytes on Darwin and 128 on Linux.
(pub :: sysChildPollBytes Int)
(pub fn (sysChildPollBytes)
  128)

; Has the child `pid` ended? Without reaping it: `Ok True` means it has
; exited or been killed and is waiting to be reaped - so a join on it
; will not block - and it is STILL this process's child, still
; waitable, its pid not free for reuse. `Ok False` means it is running.
;
; WHY NOT `wait4` WITH WNOHANG. That reaps. `__proc_join_nr` then finds
; nothing to wait for and answers 78, and in the window between the two
; the pid is free - a sweep that SIGKILLs it (MM-PAR-7) could hit an
; unrelated process that has taken the number. WNOWAIT leaves the child
; a zombie until its owner joins it, which keeps the runtime's
; invariant: a handle's pid names its child until the join.
;
;   `childPollKind` 1 (Linux, Darwin): `waitid(P_PID, pid, info,
;     WEXITED|WNOHANG|WNOWAIT)`, which answers 0 either way; the
;     `si_signo` it writes (SIGCHLD) is what says a child was found, so
;     that word is zeroed before the call. Measured on Darwin: si_signo
;     0 while the child ran, then 20 with si_code 1 (CLD_EXITED), and a
;     join afterwards still reaped it with its status.
;   `childPollKind` 2 (FreeBSD): `wait6` with the same flags, which
;     answers the pid when one was found and 0 when none.
;   `childPollKind` 0: nothing can look, and the answer is `Err` 78.
;
; `buf` is `sysChildPollBytes` of caller scratch. `Err` carries the
; errno - ECHILD for a pid that is not this process's unreaped child.
; EINTR answers `Ok False`: not seen yet, ask again.
(pub :: sysChildExited (-> Int Int (Result Bool Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
;@axiom:effect(block)
(pub fn (sysChildExited pid buf)
  (if (== childPollKind 0)
    (Err (mkError 78 "sysChildExited"))
    {
      (memSetWord buf 0 0)
      (memSetWord buf 1 0)
      (let ((r (__syscall6
        sysWaitIdNum
        waitIdPidType
        pid
        buf
        waitPollOptions
        0
        0)))
        (if (< r 0)
          (if (== r (- 0 4))
            (Ok false)
            (Err (mkError (- 0 r) "sysChildExited")))
          (if (== childPollKind 2)
            (Ok (> r 0))
            (Ok (!= (& (memGetWord buf 0) 4294967295) 0)))))
    }))
