;;! Cereal - typed serialisation for JSON, TOML and YAML.
;;! Codecs share CerealValue and return Result with explicit resource limits.
(import Internal.CerealJson)
(import Internal.Raw)
(import Internal.RawVec)
(import Str)
(import Fmt)
(import Vec)
(import Utf8)
(import Err)

; The typed tree is shared by every codec. CNumber keeps exact decimal
; text when a JSON number is fractional or outside Axiom's Int range.
; CerealMember preserves dictionary order.
;; A parsed document from any of the three formats: null, a boolean, an
;; integer, a float, text, a list or an object of `CerealMember`s.
(pub data CerealValue
  (CNull)
  (CBool Bool)
  (CInt Int)
  (CNumber String)
  (CText String)
  (CArray (Vec CerealValue))
  (CObject (Vec CerealMember)))

;; One `key: value` member of a `CObject`.
(pub struct CerealMember
  (key : String)
  (value : CerealValue))

;; Which text format to read or write: JSON, TOML or YAML.
(pub data CerealFormat
  (CerealJson)
  (CerealToml)
  (CerealYaml))

;; What a parse may cost: the nesting `depth`, the input `bytes` and
;; the `nodes` it may build. Past any of them the parse answers `Err`
;; instead of running on.
(pub struct CerealLimits
  (depth : Int)
  (bytes : Int)
  (nodes : Int))

;; A codec converts application values to the common tree and back.
;; Compose these functions for records; no raw reference words cross
;; this interface, and a missing or wrongly typed field is an Error.
(pub data Codec a
  (Codec (-> a (Result CerealValue Error)) (-> CerealValue (Result a Error))))

;; The default limits: depth 64, one MiB of input, 100000 nodes.
(pub :: cerealLimits CerealLimits)
(pub fn (cerealLimits)
  (CerealLimits :depth 64 :bytes 1048576 :nodes 100000))

(:: cerealError (-> String (Result a Error)))
(fn (cerealError message)
  (Err (mkError 22 (concat "Cereal: " message))))

(:: cerealLimitsValid (-> CerealLimits Bool))
(fn (cerealLimitsValid limits)
  (&& (&& (>= limits.depth 1) (<= limits.depth 64))
    (&& (&& (>= limits.bytes 1) (<= limits.bytes 16777216))
      (&& (>= limits.nodes 1) (<= limits.nodes 1000000)))))

(:: cerealValidUtf8 (-> String Bool))
(fn (cerealValidUtf8 s)
  {
    (let mut i 0)
    (let mut valid true)
    (let len (strLen s))
    {
      (while (&& valid (< i len))
        {
          (let w (utf8WellFormedAt s i len))
          (if (== w 0)
            {
              (set valid false)
              ()
            }
            (set i (+ i w)))
        })
      valid
    }
  })

(:: cerealDecimalDigits (-> String Int Int))
(fn (cerealDecimalDigits text start)
  {
    (let mut p start)
    {
      (while (&& (< p (strLen text)) (strIsDigit (strByte text p)))
        (set p (+ p 1)))
      p
    }
  })

(:: cerealNumberValid (-> String Bool))
(fn (cerealNumberValid text)
  {
    (let len (strLen text))
    (let mut p 0)
    (let mut valid true)
    {
      (if (== (strByte text p) 45)
        (set p 1))
      {
        (let start p)
        {
          (set p (cerealDecimalDigits text p))
          (if (|| (== p start) (&& (> (- p start) 1) (== (strByte text start) 48)))
            {
              (set valid false)
              ()
            })
        }
      }
      (if (== (strByte text p) 46)
        {
          (set p (+ p 1))
          {
            (let start p)
            {
              (set p (cerealDecimalDigits text p))
              (if (== p start)
                {
                  (set valid false)
                  ()
                }
                ())
            }
          }
        })
      (if (|| (== (strByte text p) 101) (== (strByte text p) 69))
        {
          (set p (+ p 1))
          (if (|| (== (strByte text p) 43) (== (strByte text p) 45))
            (set p (+ p 1)))
          {
            (let start p)
            {
              (set p (cerealDecimalDigits text p))
              (if (== p start)
                {
                  (set valid false)
                  ()
                }
                ())
            }
          }
        })
      (&& valid (== p len))
    }
  })

(:: cerealNumberValue (-> String (Result CerealValue Error)))
(fn (cerealNumberValue text)
  (if (! (cerealNumberValid text))
    (cerealError "invalid decimal number")
    (match (strParseInt text)
      ((Some n) (Ok (CInt n)))
      ((None) (Ok (CNumber (strDup text)))))))

;; The member under `key` of a `CObject`, or `None` when the key is
;; absent or the value is not an object.
(pub :: cerealObjectGet (-> CerealValue String (Option CerealValue)))
(pub fn (cerealObjectGet value key)
  (match value
    ((CObject members) (cerealMemberGet members key 0))
    (_ None)))

(:: cerealMemberGet (-> (Vec CerealMember) String Int (Option CerealValue)))
(fn (cerealMemberGet members key i)
  (if (>= i (vecLen members))
    None
    {
      (let member (vecGet members i))
      (if (strEq member.key key)
        (Some member.value)
        (cerealMemberGet members key (+ i 1)))
    }))

;; The member under `key` of a `CObject`, or `Err` naming the missing
;; key.
(pub :: cerealRequired (-> CerealValue String (Result CerealValue Error)))
(pub fn (cerealRequired value key)
  (match value
    ((CObject members)
      (match (cerealMemberGet members key 0)
        ((Some v) (Ok v))
        ((None) (cerealError (concat "missing field: " key))))
    )
    (_ (cerealError "expected a dictionary"))))

;; The `CInt` inside, or `Err` when the value is not an integer.
(pub :: cerealInt (-> CerealValue (Result Int Error)))
(pub fn (cerealInt value)
  (match value
    ((CInt n) (Ok n))
    ((CNumber text)
      (match (strParseInt text)
        ((Some n) (Ok n))
        ((None) (cerealError "expected an integer within Int range")))
    )
    (_ (cerealError "expected an integer"))))

;; The `CText` inside, or `Err` when the value is not text.
(pub :: cerealText (-> CerealValue (Result String Error)))
(pub fn (cerealText value)
  (match value
    ((CText s) (Ok s))
    (_ (cerealError "expected a string"))))

;; The `CBool` inside, or `Err` when the value is not a boolean.
(pub :: cerealBool (-> CerealValue (Result Bool Error)))
(pub fn (cerealBool value)
  (match value
    ((CBool b) (Ok b))
    (_ (cerealError "expected a boolean"))))

(:: cerealIntValue (-> Int (Result CerealValue Error)))
(fn (cerealIntValue n)
  (Ok (CInt n)))

(:: cerealTextValue (-> String (Result CerealValue Error)))
(fn (cerealTextValue s)
  (Ok (CText s)))

(:: cerealBoolValue (-> Bool (Result CerealValue Error)))
(fn (cerealBoolValue b)
  (Ok (CBool b)))

(:: cerealIdentity (-> CerealValue (Result CerealValue Error)))
(fn (cerealIdentity value)
  (Ok value))

;; The `Codec` that reads and writes an `Int`.
(pub :: cerealIntCodec (Codec Int))
(pub fn (cerealIntCodec)
  (Codec cerealIntValue cerealInt))

;; The `Codec` that reads and writes a `String`.
(pub :: cerealTextCodec (Codec String))
(pub fn (cerealTextCodec)
  (Codec cerealTextValue cerealText))

;; The `Codec` that reads and writes a `Bool`.
(pub :: cerealBoolCodec (Codec Bool))
(pub fn (cerealBoolCodec)
  (Codec cerealBoolValue cerealBool))

;; The `Codec` that passes a `CerealValue` through unchanged, for a
;; field you want to keep as a tree.
(pub :: cerealValueCodec (Codec CerealValue))
(pub fn (cerealValueCodec)
  (Codec cerealIdentity cerealIdentity))

;; Encode `value` with the codec into a `CerealValue` tree.
(pub :: cerealToValue (-> (Codec a) a (Result CerealValue Error)))
(pub fn (cerealToValue codec value)
  (match codec
    ((Codec encode decode) (encode value))))

;; Decode a `CerealValue` tree with the codec.
(pub :: cerealFromValue (-> (Codec a) CerealValue (Result a Error)))
(pub fn (cerealFromValue codec value)
  (match codec
    ((Codec encode decode) (decode value))))

(:: cerealVecToValue (-> (Codec a) (Vec a) (Result CerealValue Error)))
(fn (cerealVecToValue codec items)
  {
    (let out vecNew)
    (let mut i 0)
    (let mut problem "")
    {
      (while (&& (< i (vecLen items)) (strEq problem ""))
        {
          (match (cerealToValue codec (vecGet items i))
            ((Ok value) (vecPush out value))
            ((Err e)
              {
                (set problem e.message)
                out
              }
            ))
          (set i (+ i 1))
        })
      (if (strEq problem "")
        (Ok (CArray out))
        (cerealError problem))
    }
  })

(:: cerealVecFromValue (-> (Codec a) CerealValue (Result (Vec a) Error)))
(fn (cerealVecFromValue codec value)
  (match value
    ((CArray items)
      {
        (let out vecNew)
        (let mut i 0)
        (let mut problem "")
        {
          (while (&& (< i (vecLen items)) (strEq problem ""))
            {
              (match (cerealFromValue codec (vecGet items i))
                ((Ok item) (vecPush out item))
                ((Err e)
                  {
                    (set problem e.message)
                    out
                  }
                ))
              (set i (+ i 1))
            })
          (if (strEq problem "")
            (Ok out)
            (cerealError problem))
        }
      }
    )
    (_ (cerealError "expected an array"))))

;; The `Codec` for a `Vec` of what `codec` handles, as a list.
(pub :: cerealVecCodec (-> (Codec a) (Codec (Vec a))))
(pub fn (cerealVecCodec codec)
  (Codec (lambda (items) (cerealVecToValue codec items))
    (lambda (value) (cerealVecFromValue codec value))))

(:: cerealOptionToValue (-> (Codec a) (Option a) (Result CerealValue Error)))
(fn (cerealOptionToValue codec value)
  (match value
    ((None) (Ok CNull))
    ((Some item) (cerealToValue codec item))))

(:: cerealOptionFromValue (-> (Codec a) CerealValue (Result (Option a) Error)))
(fn (cerealOptionFromValue codec value)
  (match value
    ((CNull) (Ok None))
    (_
      (match (cerealFromValue codec value)
        ((Err error) (Err error))
        ((Ok item) (Ok (Some item))))
    )))

;; The `Codec` for an `Option` of what `codec` handles: `None` is null.
(pub :: cerealOptionCodec (-> (Codec a) (Codec (Option a))))
(pub fn (cerealOptionCodec codec)
  (Codec (lambda (value) (cerealOptionToValue codec value))
    (lambda (value) (cerealOptionFromValue codec value))))

;; Include the field name in a record codec's error context.
(pub :: cerealField (-> (Codec a) CerealValue String (Result a Error)))
(pub fn (cerealField codec value key)
  {
    (let answer
      (match (cerealRequired value key)
        ((Err error) (Err error))
        ((Ok member) (cerealFromValue codec member))))
    (match answer
      ((Ok item) (Ok item))
      ((Err error)
        (Err
          (Error
            :code error.code
            :message error.message
            :context
              (concat key
                (if (strEq error.context "")
                  ""
                  (concat "." error.context)))))
      ))
  })

(struct CerealCheck
  (limits : CerealLimits)
  (mut nodes : Int)
  (mut problem : String))

(:: ccVisit (-> CerealCheck Int Int))
(fn (ccVisit check depth)
  {
    (if (strEq check.problem "")
      (if (> depth check.limits.depth)
        (set check.problem "nesting limit exceeded")
        (if (>= check.nodes check.limits.nodes)
          (set check.problem "node limit exceeded")
          (set check.nodes (+ check.nodes 1)))))
    0
  })

(:: ccString (-> CerealCheck String Int))
(fn (ccString check s)
  {
    (if (> (strLen s) check.limits.bytes)
      (set check.problem "byte limit exceeded")
      (if (! (cerealValidUtf8 s))
        (set check.problem "invalid UTF-8 text")))
    0
  })

(:: ccValue (-> CerealCheck CerealValue Int Int))
(fn (ccValue check value depth)
  {
    (ccVisit check depth)
    (if (strEq check.problem "")
      (match value
        ((CNull) ())
        ((CBool b) ())
        ((CInt n) ())
        ((CNumber text)
          {
            (ccString check text)
            (if (strEq check.problem "")
              (match (cerealNumberValue text)
                ((Ok n) ())
                ((Err e)
                  {
                    (set check.problem "invalid decimal number")
                    ()
                  }
                )))
          }
        )
        ((CText s) (ccString check s))
        ((CArray items)
          {
            (let mut i 0)
            (while (&& (< i (vecLen items)) (strEq check.problem ""))
              {
                (ccValue check (vecGet items i) (+ depth 1))
                (set i (+ i 1))
              })
          }
        )
        ((CObject members)
          {
            (let mut i 0)
            (while (&& (< i (vecLen members)) (strEq check.problem ""))
              {
                (let member (vecGet members i))
                {
                  (ccString check member.key)
                  (ccValue check member.value (+ depth 1))
                  (set i (+ i 1))
                }
              })
          }
        )))
    0
  })

(struct CerealWriter
  (limits : CerealLimits)
  (pieces : (Vec String))
  (mut size : Int)
  (mut problem : String))

(:: cwText (-> CerealWriter String Int))
(fn (cwText writer text)
  {
    (if (strEq writer.problem "")
      (if (> (strLen text) (- writer.limits.bytes writer.size))
        (set writer.problem "encoded byte limit exceeded")
        {
          (vecPush writer.pieces text)
          (set writer.size (+ writer.size (strLen text)))
        }))
    0
  })

(:: cwQuote (-> CerealWriter String Int))
(fn (cwQuote writer text)
  {
    (if (> (+ 2 (jsonEscapeLen text)) (- writer.limits.bytes writer.size))
      (set writer.problem "encoded byte limit exceeded")
      {
        (cwText writer "\"")
        (cwText writer (jsonEscape text))
        (cwText writer "\"")
      })
    0
  })

(:: cjWrite (-> CerealValue CerealWriter Int Int))
(fn (cjWrite value writer depth)
  (if (! (strEq writer.problem ""))
    0
    (match value
      ((CNull) (cwText writer "null"))
      ((CBool b)
        (cwText writer
          (if b
            "true"
            "false"))
      )
      ((CInt n) (cwText writer (fmtInt n)))
      ((CNumber text) (cwText writer text))
      ((CText text) (cwQuote writer text))
      ((CArray items)
        {
          (cwText writer "[")
          (for i in 0..(vecLen items)
            {
              (if (> i 0)
                (cwText writer ","))
              (cjWrite (vecGet items i) writer (+ depth 1))
            })
          (cwText writer "]")
        }
      )
      ((CObject members)
        {
          (cwText writer "{")
          (for i in 0..(vecLen members)
            {
              (let member (vecGet members i))
              {
                (if (> i 0)
                  (cwText writer ","))
                (cwQuote writer member.key)
                (cwText writer ":")
                (cjWrite member.value writer (+ depth 1))
              }
            })
          (cwText writer "}")
        }
      ))))

; The typed JSON path shares the established string grammar, but builds
; CerealValue directly. Its local cursor is a tracked struct, and no legacy
; Int tree survives a typed decode.
(:: cjFail (-> CjCursor CerealCheck String Int))
(fn (cjFail cursor check message)
  {
    (set cursor.bad 1)
    (if (strEq check.problem "")
      {
        (set check.problem message)
        ()
      }
      ())
    0
  })

(:: cjSkip (-> String CjCursor Int))
(fn (cjSkip source cursor)
  {
    (while (&& (< cursor.pos (strLen source)) (strIsSpace (strByte source cursor.pos)))
      (set cursor.pos (+ cursor.pos 1)))
    0
  })

(:: cjPeek (-> String CjCursor Int))
(fn (cjPeek source cursor)
  (if (< cursor.pos (strLen source))
    (strByte source cursor.pos)
    (- 0 1)))

(:: cjString (-> String CjCursor CerealCheck String))
(fn (cjString source cursor check)
  {
    (let text (jpString source cursor))
    (if (!= cursor.bad 0)
      {
        (cjFail cursor check "malformed JSON string")
        ""
      }
      (strDup text))
  })

(:: cjLiteral (-> String CjCursor CerealCheck String CerealValue CerealValue))
(fn (cjLiteral source cursor check word value)
  (if (jpMatches source cursor.pos word 0)
    {
      (set cursor.pos (+ cursor.pos (strLen word)))
      value
    }
    {
      (cjFail cursor check "invalid JSON literal")
      CNull
    }))

(:: cjTypedNumber (-> String CjCursor CerealCheck CerealValue))
(fn (cjTypedNumber source cursor check)
  {
    (let start cursor.pos)
    {
      (while (&& (< cursor.pos (strLen source))
               (&& (! (strIsSpace (cjPeek source cursor)))
                 (&& (!= (cjPeek source cursor) 44)
                   (&& (!= (cjPeek source cursor) 93) (!= (cjPeek source cursor) 125)))))
        (set cursor.pos (+ cursor.pos 1)))
      (match (cerealNumberValue (strDup (strSlice source start (- cursor.pos start))))
        ((Ok value) value)
        ((Err e)
          {
            (cjFail cursor check "invalid JSON number")
            CNull
          }
        ))
    }
  })

(:: cjTypedValue (-> String CjCursor CerealCheck Int CerealValue))
(fn (cjTypedValue source cursor check depth)
  {
    (cjSkip source cursor)
    (ccVisit check depth)
    (if (|| (!= cursor.bad 0) (! (strEq check.problem "")))
      CNull
      {
        (let b (cjPeek source cursor))
        (if (== b 123)
          (cjTypedObject source cursor check depth)
          (if (== b 91)
            (cjTypedArray source cursor check depth)
            (if (== b 34)
              (CText (cjString source cursor check))
              (if (== b 116)
                (cjLiteral source cursor check "true" (CBool true))
                (if (== b 102)
                  (cjLiteral source cursor check "false" (CBool false))
                  (if (== b 110)
                    (cjLiteral source cursor check "null" CNull)
                    (if (|| (== b 45) (&& (>= b 48) (<= b 57)))
                      (cjTypedNumber source cursor check)
                      {
                        (cjFail cursor check "expected a JSON value")
                        CNull
                      })))))))
      })
  })

(:: cjTypedArray (-> String CjCursor CerealCheck Int CerealValue))
(fn (cjTypedArray source cursor check depth)
  {
    (let items vecNew)
    (let mut done false)
    {
      (set cursor.pos (+ cursor.pos 1))
      (cjSkip source cursor)
      (if (== (cjPeek source cursor) 93)
        {
          (set cursor.pos (+ cursor.pos 1))
          (set done true)
          ()
        })
      (while (&& (! done) (&& (== cursor.bad 0) (strEq check.problem "")))
        {
          (vecPush items (cjTypedValue source cursor check (+ depth 1)))
          (cjSkip source cursor)
          (if (== (cjPeek source cursor) 93)
            {
              (set cursor.pos (+ cursor.pos 1))
              (set done true)
            }
            (if (== (cjPeek source cursor) 44)
              (set cursor.pos (+ cursor.pos 1))
              (cjFail cursor check "expected comma or closing JSON bracket")))
        })
      (CArray items)
    }
  })

(:: cjTypedObject (-> String CjCursor CerealCheck Int CerealValue))
(fn (cjTypedObject source cursor check depth)
  {
    (let members vecNew)
    (let mut done false)
    {
      (set cursor.pos (+ cursor.pos 1))
      (cjSkip source cursor)
      (if (== (cjPeek source cursor) 125)
        {
          (set cursor.pos (+ cursor.pos 1))
          (set done true)
          ()
        })
      (while (&& (! done) (&& (== cursor.bad 0) (strEq check.problem "")))
        {
          (cjSkip source cursor)
          {
            (let key (cjString source cursor check))
            {
              (cjSkip source cursor)
              (if (!= (cjPeek source cursor) 58)
                (cjFail cursor check "expected colon after JSON key")
                (set cursor.pos (+ cursor.pos 1)))
              {
                (let value (cjTypedValue source cursor check (+ depth 1)))
                (vecPush members (CerealMember :key key :value value))
              }
            }
          }
          (cjSkip source cursor)
          (if (== (cjPeek source cursor) 125)
            {
              (set cursor.pos (+ cursor.pos 1))
              (set done true)
            }
            (if (== (cjPeek source cursor) 44)
              (set cursor.pos (+ cursor.pos 1))
              (cjFail cursor check "expected comma or closing JSON brace")))
        })
      (CObject members)
    }
  })

(:: cjDecode (-> String CerealLimits (Result CerealValue Error)))
(fn (cjDecode source limits)
  {
    (let cursor (CjCursor :pos 0 :bad 0))
    (let check (CerealCheck :limits limits :nodes 0 :problem ""))
    {
      (let value (cjTypedValue source cursor check 0))
      {
        (cjSkip source cursor)
        (if (&& (== cursor.bad 0) (&& (strEq check.problem "") (== cursor.pos (strLen source))))
          (Ok value)
          (cerealError
            (if (strEq check.problem "")
              "unexpected text after JSON value"
              check.problem)))
      }
    }
  })

; TOML 1.0 subset: single-line basic/literal strings, booleans, signed
; decimal integers/floats, arrays, inline tables, dotted keys and tables.
; Duplicate definitions, malformed numbers, datetime values, non-finite
; floats, multiline strings and array tables are refused. The writer
; uses quoted keys and inline tables; TOML has no null value.
(struct CtParser
  (source : String)
  (limits : CerealLimits)
  (mut pos : Int)
  (mut nodes : Int)
  (mut problem : String))

(:: ctFail (-> CtParser String Int))
(fn (ctFail parser message)
  {
    (if (strEq parser.problem "")
      {
        (set parser.problem message)
        ()
      }
      ())
    0
  })

(:: ctSkip (-> CtParser Int))
(fn (ctSkip parser)
  {
    (while (&& (< parser.pos (strLen parser.source))
             (|| (== (strByte parser.source parser.pos) 32)
               (== (strByte parser.source parser.pos) 9)))
      (set parser.pos (+ parser.pos 1)))
    0
  })

(:: ctPeek (-> CtParser Int))
(fn (ctPeek parser)
  (if (< parser.pos (strLen parser.source))
    (strByte parser.source parser.pos)
    (- 0 1)))

(:: ctBareKey (-> Int Bool))
(fn (ctBareKey b)
  (|| (&& (>= b 65) (<= b 90))
    (|| (&& (>= b 97) (<= b 122)) (|| (&& (>= b 48) (<= b 57)) (|| (== b 95) (== b 45))))))

(:: ctString (-> CtParser String))
(fn (ctString parser)
  {
    (let quote (ctPeek parser))
    (let start parser.pos)
    (let mut escaped false)
    (let mut closed false)
    {
      (set parser.pos (+ parser.pos 1))
      (while (&& (< parser.pos (strLen parser.source)) (! closed))
        {
          (let b (ctPeek parser))
          {
            (if (&& (! escaped) (== b quote))
              (set closed true)
              (if (&& (== quote 34) (&& (! escaped) (== b 92)))
                (set escaped true)
                (set escaped false)))
            (set parser.pos (+ parser.pos 1))
          }
        })
      (if (! closed)
        {
          (ctFail parser "unterminated TOML string")
          ""
        }
        {
          (let raw (strSlice parser.source start (- parser.pos start)))
          (if (== quote 39)
            {
              (let mut i 1)
              (let mut bad false)
              {
                (while (< i (- (strLen raw) 1))
                  {
                    (if (|| (&& (< (strByte raw i) 32) (!= (strByte raw i) 9))
                          (== (strByte raw i) 127))
                      {
                        (set bad true)
                        ()
                      })
                    (set i (+ i 1))
                  })
                (if bad
                  {
                    (ctFail parser "control character in TOML literal string")
                    ""
                  }
                  (strDup (strSlice raw 1 (- (strLen raw) 2))))
              }
            }
            {
              (let decoded (jsonParse raw))
              (if (|| (== decoded 0) (!= (jsonTag decoded) JSTR))
                {
                  (ctFail parser "unsupported or malformed TOML string escape")
                  ""
                }
                {
                  (let mut i 1)
                  (let mut bad false)
                  {
                    ; TOML does not admit JSON's escaped slash or lone
                    ; surrogate replacement, nor a raw DEL character.
                    (while (&& (< i (- (strLen raw) 1)) (! bad))
                      {
                        (let b (strByte raw i))
                        {
                          (if (== b 127)
                            {
                              (set bad true)
                              ()
                            })
                          (if (== b 92)
                            {
                              (let next (strByte raw (+ i 1)))
                              {
                                (if (|| (== next 47) (== next 85))
                                  {
                                    (set bad true)
                                    ()
                                  })
                                (if (== next 117)
                                  {
                                    (let hex (jpHexDigits raw (+ i 2)))
                                    (match hex
                                      ((None)
                                        (set bad true)
                                      )
                                      ((Some code)
                                        (if (&& (>= code 55296) (<= code 57343))
                                          {
                                            (set bad true)
                                            ()
                                          }
                                          ())
                                      ))
                                  })
                                (set i (+ i
                                         (if (== next 117)
                                           6
                                           2)))
                              }
                            }
                            (set i (+ i 1)))
                        }
                      })
                    (if bad
                      {
                        (ctFail parser "unsupported TOML escape or invalid Unicode scalar")
                        ""
                      }
                      (strDup (jsonStrVal decoded)))
                  }
                })
            })
        })
    }
  })

(:: ctKeyPart (-> CtParser String))
(fn (ctKeyPart parser)
  {
    (ctSkip parser)
    (if (|| (== (ctPeek parser) 34) (== (ctPeek parser) 39))
      (ctString parser)
      {
        (let start parser.pos)
        {
          (while (&& (< parser.pos (strLen parser.source)) (ctBareKey (ctPeek parser)))
            (set parser.pos (+ parser.pos 1)))
          (if (== parser.pos start)
            (ctFail parser "expected a TOML key"))
          (strDup (strSlice parser.source start (- parser.pos start)))
        }
      })
  })

(:: ctKeyPath (-> CtParser (Vec String)))
(fn (ctKeyPath parser)
  {
    (let parts vecNew)
    (let mut done false)
    {
      (vecPush parts (ctKeyPart parser))
      (while (&& (! done) (strEq parser.problem ""))
        {
          (ctSkip parser)
          (if (== (ctPeek parser) 46)
            {
              (set parser.pos (+ parser.pos 1))
              (if (>= (vecLen parts) parser.limits.depth)
                (ctFail parser "TOML key path nesting limit exceeded")
                {
                  (vecPush parts (ctKeyPart parser))
                  ()
                })
            }
            (set done true))
        })
      parts
    }
  })

(:: ctPut (-> CerealValue (Vec String) Int CerealValue (Result Int Error)))
(fn (ctPut object path i value)
  (if (>= i (vecLen path))
    (cerealError "empty TOML key path")
    (match object
      ((CObject members)
        {
          (let key (vecGet path i))
          (match (cerealMemberGet members key 0)
            ((None)
              (if (== (+ i 1) (vecLen path))
                {
                  (vecPush members (CerealMember :key key :value value))
                  (Ok 0)
                }
                {
                  (let child (CObject vecNew))
                  {
                    (vecPush members (CerealMember :key key :value child))
                    (ctPut child path (+ i 1) value)
                  }
                })
            )
            ((Some prior)
              (if (== (+ i 1) (vecLen path))
                (cerealError "duplicate TOML key")
                (ctPut prior path (+ i 1) value))
            ))
        }
      )
      (_ (cerealError "TOML key extends a scalar or array")))))

(:: ctTable (-> CerealValue (Vec String) Int (Result CerealValue Error)))
(fn (ctTable object path i)
  (if (>= i (vecLen path))
    (Ok object)
    (match object
      ((CObject members)
        {
          (let key (vecGet path i))
          (match (cerealMemberGet members key 0)
            ((None)
              {
                (let child (CObject vecNew))
                {
                  (vecPush members (CerealMember :key key :value child))
                  (ctTable child path (+ i 1))
                }
              }
            )
            ((Some child)
              (match child
                ((CObject entries) (ctTable child path (+ i 1)))
                (_ (cerealError "TOML table conflicts with an existing value")))
            ))
        }
      )
      (_ (cerealError "expected a TOML table")))))

(:: ctIntegerText (-> String Bool))
(fn (ctIntegerText text)
  {
    (let mut i
      (if (== (strByte text 0) 45)
        1
        0))
    (let mut integer true)
    {
      (while (< i (strLen text))
        {
          (if (! (strIsDigit (strByte text i)))
            {
              (set integer false)
              ()
            })
          (set i (+ i 1))
        })
      integer
    }
  })

(:: ctNumber (-> CtParser String CerealValue))
(fn (ctNumber parser raw)
  {
    (let pieces vecNew)
    (let mut valid true)
    (let mut i 0)
    {
      (while (< i (strLen raw))
        {
          (let b (strByte raw i))
          {
            (if (== b 95)
              (if (! (&& (strIsDigit (strByte raw (- i 1))) (strIsDigit (strByte raw (+ i 1)))))
                {
                  (set valid false)
                  ()
                })
              (vecPush pieces (strSlice raw i 1)))
            (set i (+ i 1))
          }
        })
      {
        (let joined (strJoin pieces ""))
        (let text
          (if (strStartsWith joined "+")
            (strSlice joined 1 (- (strLen joined) 1))
            joined))
        (if (! valid)
          {
            (ctFail parser "invalid underscore in TOML number")
            CNull
          }
          (match (cerealNumberValue text)
            ((Ok value)
              (if (ctIntegerText text)
                (match value
                  ((CInt n) value)
                  (_
                    {
                      (ctFail parser "TOML integer is outside Int range")
                      CNull
                    }
                  ))
                value)
            )
            ((Err error)
              {
                (ctFail parser "unsupported or malformed TOML number")
                CNull
              }
            )))
      }
    }
  })

(:: ctValue (-> CtParser Int CerealValue))
(fn (ctValue parser depth)
  {
    (ctSkip parser)
    (if (> depth parser.limits.depth)
      (ctFail parser "TOML nesting limit exceeded"))
    (if (>= parser.nodes parser.limits.nodes)
      (ctFail parser "TOML node limit exceeded"))
    (set parser.nodes (+ parser.nodes 1))
    (if (! (strEq parser.problem ""))
      CNull
      {
        (let b (ctPeek parser))
        (if (|| (== b 34) (== b 39))
          (CText (ctString parser))
          (if (== b 91)
            (ctArray parser depth)
            (if (== b 123)
              (ctInline parser depth)
              {
                (let start parser.pos)
                {
                  (while (&& (< parser.pos (strLen parser.source))
                           (&& (! (strIsSpace (ctPeek parser)))
                             (&& (!= (ctPeek parser) 44)
                               (&& (!= (ctPeek parser) 93) (!= (ctPeek parser) 125)))))
                    (set parser.pos (+ parser.pos 1)))
                  {
                    (let word (strSlice parser.source start (- parser.pos start)))
                    (if (strEq word "true")
                      (CBool true)
                      (if (strEq word "false")
                        (CBool false)
                        (ctNumber parser word)))
                  }
                }
              })))
      })
  })

(:: ctArray (-> CtParser Int CerealValue))
(fn (ctArray parser depth)
  {
    (let items vecNew)
    (let mut done false)
    {
      (set parser.pos (+ parser.pos 1))
      (ctSkip parser)
      (if (== (ctPeek parser) 93)
        {
          (set done true)
          (set parser.pos (+ parser.pos 1))
          ()
        })
      (while (&& (! done) (strEq parser.problem ""))
        {
          (vecPush items (ctValue parser (+ depth 1)))
          (ctSkip parser)
          (if (== (ctPeek parser) 93)
            {
              (set done true)
              (set parser.pos (+ parser.pos 1))
            }
            (if (== (ctPeek parser) 44)
              {
                (set parser.pos (+ parser.pos 1))
                (ctSkip parser)
                (if (== (ctPeek parser) 93)
                  {
                    (set done true)
                    (set parser.pos (+ parser.pos 1))
                    ()
                  })
              }
              (ctFail parser "expected comma or closing bracket in TOML array")))
        })
      (CArray items)
    }
  })

(:: ctInline (-> CtParser Int CerealValue))
(fn (ctInline parser depth)
  {
    (let object (CObject vecNew))
    (let closed vecNew)
    (let mut done false)
    {
      (set parser.pos (+ parser.pos 1))
      (ctSkip parser)
      (if (== (ctPeek parser) 125)
        {
          (set done true)
          (set parser.pos (+ parser.pos 1))
          ()
        })
      (while (&& (! done) (strEq parser.problem ""))
        {
          (let path (ctKeyPath parser))
          {
            (if (!= (ctPeek parser) 61)
              (ctFail parser "expected equals in TOML inline table")
              (set parser.pos (+ parser.pos 1)))
            {
              (let value (ctValue parser (+ depth 1)))
              {
                (if (ctClosedPrefix closed path)
                  (ctFail parser "TOML inline value extends a closed definition")
                  0)
                (if (strEq parser.problem "")
                  (match (ctPut object path 0 value)
                    ((Ok n) (vecPush closed (ctPathKey path)))
                    ((Err e) (ctFail parser e.message))))
              }
            }
            (ctSkip parser)
            (if (== (ctPeek parser) 125)
              {
                (set done true)
                (set parser.pos (+ parser.pos 1))
              }
              (if (== (ctPeek parser) 44)
                {
                  (set parser.pos (+ parser.pos 1))
                  (ctSkip parser)
                  (if (== (ctPeek parser) 125)
                    (ctFail parser "TOML inline table has a trailing comma"))
                }
                (ctFail parser "expected comma or closing brace in TOML inline table")))
          }
        })
      object
    }
  })

(:: ctStripComment (-> String String))
(fn (ctStripComment line)
  {
    (let mut i 0)
    (let mut quote 0)
    (let mut escaped false)
    (let mut end (strLen line))
    {
      (while (< i end)
        {
          (let b (strByte line i))
          {
            (if (== quote 0)
              (if (== b 35)
                (set end i)
                (if (|| (== b 34) (== b 39))
                  {
                    (set quote b)
                    ()
                  }))
              (if (&& (! escaped) (== b quote))
                {
                  (set quote 0)
                  ()
                }))
            (if (&& (== quote 34) (&& (! escaped) (== b 92)))
              {
                (set escaped true)
                ()
              }
              (set escaped false))
            (set i (+ i 1))
          }
        })
      (strTrim (strSlice line 0 end))
    }
  })

(:: ctPathKey (-> (Vec String) String))
(fn (ctPathKey path)
  {
    (let pieces vecNew)
    {
      (for i in 0..(vecLen path)
        {
          (vecPush pieces "\"")
          (vecPush pieces (jsonEscape (vecGet path i)))
          (vecPush pieces "\"/")
        })
      (strJoin pieces "")
    }
  })

(:: ctPathPrefix (-> (Vec String) Int (Vec String)))
(fn (ctPathPrefix path count)
  {
    (let out vecNew)
    {
      (for i in 0..count
        (vecPush out (vecGet path i)))
      out
    }
  })

(:: ctClosedPrefix (-> (Vec String) (Vec String) Bool))
(fn (ctClosedPrefix closed path)
  {
    (let mut i 1)
    (let mut found false)
    {
      (while (&& (<= i (vecLen path)) (! found))
        {
          (if (>= (cerealStringIndex closed (ctPathKey (ctPathPrefix path i)) 0) 0)
            {
              (set found true)
              ()
            })
          (set i (+ i 1))
        })
      found
    }
  })

(:: ctDecode (-> String CerealLimits (Result CerealValue Error)))
(fn (ctDecode source limits)
  {
    (let root (CObject vecNew))
    (let lines (strSplit source 10))
    (let declared vecNew)
    (let closed vecNew)
    (let mut table vecNew)
    (let mut problem "")
    (let mut nodes 1)
    (let mut i 0)
    {
      (while (&& (< i (vecLen lines)) (strEq problem ""))
        {
          (let line (ctStripComment (vecGet lines i)))
          {
            (if (> (strLen line) 0)
              {
                (let parser (CtParser :source line :limits limits :pos 0 :nodes nodes :problem ""))
                {
                  (if (== (ctPeek parser) 91)
                    {
                      (set parser.pos 1)
                      (if (== (ctPeek parser) 91)
                        (ctFail parser "TOML array tables are not supported"))
                      {
                        (let path (ctKeyPath parser))
                        {
                          (ctSkip parser)
                          (if (!= (ctPeek parser) 93)
                            (ctFail parser "invalid TOML table header")
                            (set parser.pos (+ parser.pos 1)))
                          (ctSkip parser)
                          (if (!= parser.pos (strLen line))
                            (ctFail parser "unexpected text after TOML table header"))
                          (if (|| (>= (cerealStringIndex declared (ctPathKey path) 0) 0)
                                (ctClosedPrefix closed path))
                            (ctFail parser "duplicate or closed TOML table"))
                          (if (strEq parser.problem "")
                            (match (ctTable root path 0)
                              ((Ok object)
                                {
                                  (set table path)
                                  (vecPush declared (ctPathKey path))
                                }
                              )
                              ((Err e) (ctFail parser e.message))))
                        }
                      }
                    }
                    {
                      (let path (ctKeyPath parser))
                      {
                        (if (!= (ctPeek parser) 61)
                          (ctFail parser "expected equals after TOML key")
                          (set parser.pos (+ parser.pos 1)))
                        {
                          (let value (ctValue parser 1))
                          {
                            (ctSkip parser)
                            (if (!= parser.pos (strLen line))
                              (ctFail parser "unexpected text after TOML value"))
                            {
                              (let full vecNew)
                              {
                                (for j in 0..(vecLen table)
                                  (vecPush full (vecGet table j)))
                                (for j in 0..(vecLen path)
                                  (vecPush full (vecGet path j)))
                                (if (> (vecLen full) limits.depth)
                                  (ctFail parser "TOML key path nesting limit exceeded"))
                                (if (ctClosedPrefix closed full)
                                  (ctFail parser "TOML value extends a closed definition"))
                                (if (strEq parser.problem "")
                                  (match (ctPut root full 0 value)
                                    ((Ok n)
                                      {
                                        (vecPush closed (ctPathKey full))
                                        (for k in 1..(vecLen full)
                                          {
                                            (let prefix (ctPathKey (ctPathPrefix full k)))
                                            (if (< (cerealStringIndex declared prefix 0) 0)
                                              (vecPush declared prefix)
                                              declared)
                                          })
                                      }
                                    )
                                    ((Err e) (ctFail parser e.message))))
                              }
                            }
                          }
                        }
                      }
                    })
                  (set nodes parser.nodes)
                  (if (! (strEq parser.problem ""))
                    {
                      (set problem parser.problem)
                      ()
                    }
                    ())
                }
              })
            (set i (+ i 1))
          }
        })
      (if (strEq problem "")
        (Ok root)
        (cerealError problem))
    }
  })

(:: ctValidSource (-> String Bool))
(fn (ctValidSource source)
  {
    (let mut i 0)
    (let mut valid true)
    {
      (while (&& valid (< i (strLen source)))
        {
          (let b (strByte source i))
          {
            (if (|| (|| (== b 127) (&& (< b 32) (! (|| (== b 9) (|| (== b 10) (== b 13))))))
                  (&& (== b 13) (!= (strByte source (+ i 1)) 10)))
              {
                (set valid false)
                ()
              })
            (set i (+ i 1))
          }
        })
      valid
    }
  })

; TOML also requires DEL to be escaped. Size the entire quoted value
; before allocating any escaped substring.
(:: cwTomlQuote (-> CerealWriter String Int))
(fn (cwTomlQuote writer text)
  {
    (let mut count 0)
    (let mut i 0)
    (let mut start 0)
    {
      (for k in 0..(strLen text)
        (if (== (strByte text k) 127)
          (set count (+ count 1))))
      (if (> (+ 2 (+ (jsonEscapeLen text) (* count 5))) (- writer.limits.bytes writer.size))
        (set writer.problem "encoded byte limit exceeded")
        {
          (cwText writer "\"")
          (while (< i (strLen text))
            {
              (if (== (strByte text i) 127)
                {
                  (cwText writer (jsonEscape (strSlice text start (- i start))))
                  (cwText writer "\\u007f")
                  (set start (+ i 1))
                })
              (set i (+ i 1))
            })
          (cwText writer (jsonEscape (strSlice text start (- i start))))
          (cwText writer "\"")
        })
      0
    }
  })

(:: ctWriteValue (-> CerealValue CerealWriter Int Int))
(fn (ctWriteValue value writer depth)
  (match value
    ((CNull)
      {
        (set writer.problem "TOML cannot encode null")
        0
      }
    )
    ((CBool b)
      (cwText writer
        (if b
          "true"
          "false"))
    )
    ((CInt n) (cwText writer (fmtInt n)))
    ((CNumber n)
      (if (ctIntegerText n)
        (match (strParseInt n)
          ((Some number) (cwText writer n))
          ((None)
            {
              (set writer.problem "TOML integer is outside Int range")
              0
            }
          ))
        (cwText writer n))
    )
    ((CText text) (cwTomlQuote writer text))
    ((CArray items)
      {
        (cwText writer "[")
        (for i in 0..(vecLen items)
          {
            (if (> i 0)
              (cwText writer ", "))
            (ctWriteValue (vecGet items i) writer (+ depth 1))
          })
        (cwText writer "]")
      }
    )
    ((CObject members)
      {
        (cwText writer "{")
        (for i in 0..(vecLen members)
          {
            (let member (vecGet members i))
            {
              (if (> i 0)
                (cwText writer ", "))
              (cwTomlQuote writer member.key)
              (cwText writer " = ")
              (ctWriteValue member.value writer (+ depth 1))
            }
          })
        (cwText writer "}")
      }
    )))

(:: ctWrite (-> CerealValue CerealWriter Int Int))
(fn (ctWrite value writer depth)
  (match value
    ((CObject members)
      {
        (for i in 0..(vecLen members)
          {
            (let member (vecGet members i))
            {
              (cwTomlQuote writer member.key)
              (cwText writer " = ")
              (ctWriteValue member.value writer (+ depth 1))
              (cwText writer "\n")
            }
          })
        0
      }
    )
    (_
      {
        (set writer.problem "TOML requires a dictionary document root")
        0
      }
    )))

(:: cerealStringIndex (-> (Vec String) String Int Int))
(fn (cerealStringIndex items wanted i)
  (if (>= i (vecLen items))
    (- 0 1)
    (if (strEq (vecGet items i) wanted)
      i
      (cerealStringIndex items wanted (+ i 1)))))

;; Write a `CerealValue` tree in `format` under the given limits.
;; Invalid limits answer `Err`.
(pub :: cerealEncodeWith (-> CerealFormat CerealLimits CerealValue (Result String Error)))
(pub fn (cerealEncodeWith format limits value)
  (if (! (cerealLimitsValid limits))
    (cerealError "limits require depth 1..64, bytes 1..16777216 and nodes 1..1000000")
    {
      (let check (CerealCheck :limits limits :nodes 0 :problem ""))
      {
        (ccValue check value 0)
        (if (! (strEq check.problem ""))
          (cerealError check.problem)
          {
            (let writer (CerealWriter :limits limits :pieces vecNew :size 0 :problem ""))
            {
              (match format
                ((CerealJson) (cjWrite value writer 0))
                ((CerealToml)
                  (if (cyUniqueKeys value)
                    (ctWrite value writer 0)
                    (set writer.problem "duplicate dictionary key in TOML output"))
                )
                ((CerealYaml)
                  (if (cyUniqueKeys value)
                    (cyWrite value writer 0)
                    (set writer.problem "duplicate dictionary key in YAML output"))
                ))
              (if (strEq writer.problem "")
                (Ok (strJoin writer.pieces ""))
                (cerealError writer.problem))
            }
          })
      }
    }))

;; Write a `CerealValue` tree in `format` under the default limits.
(pub :: cerealEncode (-> CerealFormat CerealValue (Result String Error)))
(pub fn (cerealEncode format value)
  (cerealEncodeWith format cerealLimits value))

;; Parse `source` in `format` into a `CerealValue` tree under the given
;; limits. Past a limit, or on malformed input, it answers `Err`.
(pub :: cerealDecodeWith (-> CerealFormat CerealLimits String (Result CerealValue Error)))
(pub fn (cerealDecodeWith format limits source)
  (if (! (cerealLimitsValid limits))
    (cerealError "limits require depth 1..64, bytes 1..16777216 and nodes 1..1000000")
    (if (> (strLen source) limits.bytes)
      (cerealError "input byte limit exceeded")
      (if (! (cerealValidUtf8 source))
        (cerealError "invalid UTF-8 input")
        {
          (let parsed
            (match format
              ((CerealJson) (cjDecode source limits))
              ((CerealToml)
                (if (ctValidSource source)
                  (ctDecode source limits)
                  (cerealError "control character or lone CR in TOML input"))
              )
              ((CerealYaml) (cyDecode source limits))))
          (match parsed
            ((Err e) (Err e))
            ((Ok value)
              {
                (let check (CerealCheck :limits limits :nodes 0 :problem ""))
                {
                  (ccValue check value 0)
                  (if (strEq check.problem "")
                    (Ok value)
                    (cerealError check.problem))
                }
              }
            ))
        }))))

;; Parse `source` in `format` into a `CerealValue` tree under the
;; default limits.
(pub :: cerealDecode (-> CerealFormat String (Result CerealValue Error)))
(pub fn (cerealDecode format source)
  (cerealDecodeWith format cerealLimits source))

;; Encode `value` with the codec and write it in `format`: the one call
;; for turning a typed value into text.
(pub :: cerealSerialize (-> CerealFormat (Codec a) a (Result String Error)))
(pub fn (cerealSerialize format codec value)
  (match (cerealToValue codec value)
    ((Err e) (Err e))
    ((Ok tree) (cerealEncode format tree))))

;; Parse `source` in `format` and decode it with the codec: the one
;; call for turning text into a typed value.
(pub :: cerealDeserialize (-> CerealFormat (Codec a) String (Result a Error)))
(pub fn (cerealDeserialize format codec source)
  (match (cerealDecode format source)
    ((Err e) (Err e))
    ((Ok tree) (cerealFromValue codec tree))))

; YAML 1.2 subset, following https://yaml.org/spec/1.2.2/.
; Documents use LF or CRLF, space-indented mappings and sequences,
; string keys, single-line plain/single-quoted/JSON-quoted scalars,
; comments and JSON-compatible flow collections. Compact `- key: value`
; mappings and `- - value` sequences use one space after each dash.
; One optional opening `---` and closing `...` marker is accepted.
; Plain null/Null/NULL/~ and true/false in their core-schema spellings
; resolve as values; yes/no/on/off remain strings. Numbers use JSON's
; finite decimal grammar. Other numeric spellings, multiline scalars,
; anchors, aliases, tags, merge keys, directives, complex keys and
; multiple documents return Error. Nested flow collections stay on one
; physical line; an entire JSON flow document may span several lines.
; Encoding uses canonical JSON flow notation, which is valid YAML 1.2.
(struct CYLine
  (indent : Int)
  (text : String))

(struct CYState
  (lines : (Vec CYLine))
  (check : CerealCheck)
  (mut at : Int))

(:: cySpace (-> Int Bool))
(fn (cySpace b)
  (|| (== b 32) (== b 9)))

; Locate a block colon or comment outside quoted/flow content. A block
; colon requires following whitespace, so URLs remain plain strings.
(:: cyQuoteStart (-> String Int Bool))
(fn (cyQuoteStart text at)
  {
    (let mut i (- at 1))
    {
      (while (&& (>= i 0) (cySpace (strByte text i)))
        (set i (- i 1)))
      (|| (< i 0) (|| (== (strByte text i) 58) (&& (== i 0) (== (strByte text i) 45))))
    }
  })

(:: cyScan (-> String Bool Int))
(fn (cyScan text comment)
  {
    (let mut i 0)
    (let mut quote 0)
    (let mut flow 0)
    (let mut found (- 0 1))
    {
      (while (&& (< i (strLen text)) (< found 0))
        {
          (let b (strByte text i))
          {
            (if (== quote 34)
              (if (== b 92)
                (set i (+ i 1))
                (if (== b 34)
                  (set quote 0)))
              (if (== quote 39)
                (if (== b 39)
                  (if (== (strByte text (+ i 1)) 39)
                    (set i (+ i 1))
                    (set quote 0)))
                (if (&& (|| (== b 34) (== b 39)) (|| (> flow 0) (cyQuoteStart text i)))
                  (set quote b)
                  (if (&& comment (&& (== b 35) (|| (== i 0) (cySpace (strByte text (- i 1))))))
                    (set found i)
                    (if (|| (== b 91) (== b 123))
                      (set flow (+ flow 1))
                      (if (|| (== b 93) (== b 125))
                        (set flow (- flow 1))
                        (if (&& (! comment)
                              (&& (== flow 0)
                                (&& (== b 58)
                                  (|| (== (+ i 1) (strLen text))
                                    (cySpace (strByte text (+ i 1)))))))
                          (set found i))))))))
            (set i (+ i 1))
          }
        })
      found
    }
  })

(:: cyDash (-> String Bool))
(fn (cyDash text)
  (&& (== (strByte text 0) 45) (|| (== (strLen text) 1) (cySpace (strByte text 1)))))

(:: cyAddLine (-> (Vec CYLine) Int String Int))
(fn (cyAddLine lines indent text)
  {
    (let mut current text)
    (let mut col indent)
    (let mut done false)
    (let mut bad 0)
    {
      (while (! done)
        (if (&& (cyDash current) (> (strLen current) 2))
          {
            (let rest (strTrim (strSlice current 2 (- (strLen current) 2))))
            (if (|| (cyDash rest) (>= (cyScan rest false) 0))
              (if (|| (!= (strByte current 1) 32) (cySpace (strByte current 2)))
                {
                  (set bad 1)
                  (set done true)
                }
                {
                  (vecPush lines (CYLine :indent col :text "-"))
                  (set current rest)
                  (set col (+ col 2))
                })
              {
                (vecPush lines (CYLine :indent col :text current))
                (set done true)
              })
          }
          {
            (vecPush lines (CYLine :indent col :text current))
            (set done true)
          }))
      bad
    }
  })

(:: cyLines (-> String (Result (Vec CYLine) Error)))
(fn (cyLines source)
  {
    (let raw (strSplit source 10))
    (let lines vecNew)
    (let mut problem "")
    (let mut opened false)
    (let mut ended false)
    (let mut i 0)
    {
      (while (&& (< i (vecLen raw)) (strEq problem ""))
        {
          (let line (vecGet raw i))
          (let mut start 0)
          (let mut end (strLen line))
          {
            (if (&& (== i 0)
                  (&& (>= end 3)
                    (&& (== (strByte line 0) 239)
                      (&& (== (strByte line 1) 187) (== (strByte line 2) 191)))))
              (set start 3))
            (if (&& (> end start) (== (strByte line (- end 1)) 13))
              (set end (- end 1)))
            {
              (let mut n start)
              (let mut col 0)
              (let mut j start)
              {
                (while (&& (< n end) (== (strByte line n) 32))
                  {
                    (set n (+ n 1))
                    (set col (+ col 1))
                  })
                (if (&& (< n end) (== (strByte line n) 9))
                  {
                    (set problem "tabs cannot indent YAML")
                    ()
                  })
                (while (< j end)
                  {
                    (if (|| (&& (< (strByte line j) 32) (!= (strByte line j) 9))
                          (== (strByte line j) 127))
                      {
                        (set problem "non-printable YAML character")
                        ()
                      })
                    (set j (+ j 1))
                  })
                {
                  (let content (strSlice line n (- end n)))
                  (let cut (cyScan content true))
                  {
                    (let text
                      (strTrim
                        (if (< cut 0)
                          content
                          (strSlice content 0 cut))))
                    (if (! (== (strLen text) 0))
                      (if ended
                        (set problem "content after YAML document end")
                        (if (&& (== col 0) (strEq text "---"))
                          (if (|| opened (> (vecLen lines) 0))
                            (set problem "multiple YAML documents are unsupported")
                            (set opened true))
                          (if (&& (== col 0) (strEq text "..."))
                            (set ended true)
                            (if (|| (== (strByte text 0) 37)
                                  (&& (== col 0)
                                    (|| (strStartsWith text "--- ") (strStartsWith text "... "))))
                              (set problem "YAML directives or inline document markers are unsupported")
                              (if (!= (cyAddLine lines col text) 0)
                                {
                                  (set problem "compact YAML collections require one space after the dash")
                                  ()
                                }))))))
                  }
                }
              }
            }
            (set i (+ i 1))
          }
        })
      (if (strEq problem "")
        (Ok lines)
        (cerealError problem))
    }
  })

(:: cySingle (-> String (Result String Error)))
(fn (cySingle text)
  {
    (let pieces vecNew)
    (let mut i 1)
    (let mut start 1)
    (let mut closed false)
    (let mut problem "")
    {
      (while (&& (< i (strLen text)) (! closed))
        (if (== (strByte text i) 39)
          {
            (vecPush pieces (strSlice text start (- i start)))
            (if (== (strByte text (+ i 1)) 39)
              {
                (vecPush pieces "'")
                (set i (+ i 2))
                (set start i)
              }
              {
                (set closed true)
                (set i (+ i 1))
              })
          }
          (set i (+ i 1))))
      (if (|| (! closed) (!= i (strLen text)))
        (cerealError "invalid or multiline single-quoted YAML scalar")
        (Ok (strJoin pieces "")))
    }
  })

(:: cyNumericExtension (-> String Bool))
(fn (cyNumericExtension text)
  {
    (let lower (strLower text))
    (let at
      (if (|| (== (strByte text 0) 45) (== (strByte text 0) 43))
        1
        0))
    (||
      (|| (strEq lower ".nan")
        (|| (strEq lower ".inf") (|| (strEq lower "-.inf") (strEq lower "+.inf"))))
      (|| (strStartsWith (strSlice lower at (- (strLen lower) at)) "0x")
        (|| (strStartsWith (strSlice lower at (- (strLen lower) at)) "0o")
          (|| (&& (== (strByte text 0) 43) (strIsDigit (strByte text 1)))
            (|| (&& (== (strByte text at) 46) (strIsDigit (strByte text (+ at 1))))
              (&& (== (strByte text at) 48) (strIsDigit (strByte text (+ at 1)))))))))
  })

(:: cyFiniteNumber (-> String Bool))
(fn (cyFiniteNumber text)
  {
    (let mut i
      (if (|| (== (strByte text 0) 43) (== (strByte text 0) 45))
        1
        0))
    (let mut digits 0)
    (let mut exponent false)
    (let mut expDigits 0)
    {
      (while (&& (< i (strLen text)) (strIsDigit (strByte text i)))
        {
          (set digits (+ digits 1))
          (set i (+ i 1))
        })
      (if (== (strByte text i) 46)
        {
          (set i (+ i 1))
          (while (&& (< i (strLen text)) (strIsDigit (strByte text i)))
            {
              (set digits (+ digits 1))
              (set i (+ i 1))
            })
          ()
        })
      (if (|| (== (strByte text i) 101) (== (strByte text i) 69))
        {
          (set exponent true)
          (set i (+ i 1))
          (if (|| (== (strByte text i) 43) (== (strByte text i) 45))
            (set i (+ i 1)))
          (while (&& (< i (strLen text)) (strIsDigit (strByte text i)))
            {
              (set expDigits (+ expDigits 1))
              (set i (+ i 1))
            })
          ()
        })
      (&& (&& (> digits 0) (== i (strLen text))) (|| (! exponent) (> expDigits 0)))
    }
  })

(:: cyPlain (-> String (Result CerealValue Error)))
(fn (cyPlain text)
  {
    (let first (strByte text 0))
    (if (== (strLen text) 0)
      (Ok CNull)
      (if (|| (strEq text "null")
            (|| (strEq text "Null") (|| (strEq text "NULL") (strEq text "~"))))
        (Ok CNull)
        (if (|| (strEq text "true") (|| (strEq text "True") (strEq text "TRUE")))
          (Ok (CBool true))
          (if (|| (strEq text "false") (|| (strEq text "False") (strEq text "FALSE")))
            (Ok (CBool false))
            (if (|| (|| (== first 38) (== first 42))
                  (|| (== first 33)
                    (|| (== first 124)
                      (|| (== first 62)
                        (|| (== first 37)
                          (|| (== first 64)
                            (|| (== first 96)
                              (|| (== first 63)
                                (|| (== first 91)
                                  (|| (== first 93) (|| (== first 123) (== first 125))))))))))))
              (cerealError "unsupported YAML scalar syntax")
              (if (>= (cyScan text false) 0)
                (cerealError "mapping colon in a plain YAML scalar")
                (if (cyNumericExtension text)
                  (cerealError "non-JSON YAML number is unsupported")
                  (if (|| (strIsDigit first) (&& (== first 45) (strIsDigit (strByte text 1))))
                    (match (cerealNumberValue text)
                      ((Ok value) (Ok value))
                      ((Err error)
                        (if (cyFiniteNumber text)
                          (cerealError "non-JSON YAML number is unsupported")
                          (Ok (CText (strDup text))))
                      ))
                    (Ok (CText (strDup text)))))))))))
  })

(:: cerealDistinctKeys (-> (Vec CerealMember) Bool))
(fn (cerealDistinctKeys members)
  {
    (let keys vecNew)
    (let scratch vecNew)
    (let size (vecLen members))
    (let mut width 1)
    {
      (for i in 0..size
        {
          (let member (vecGet members i))
          {
            (vecPush keys member.key)
            (vecPush scratch "")
          }
        })
      (while (< width size)
        {
          (let mut start 0)
          {
            (while (< start size)
              {
                (let middle
                  (if (< (+ start width) size)
                    (+ start width)
                    size))
                (let end
                  (if (< (+ start (* width 2)) size)
                    (+ start (* width 2))
                    size))
                (let mut left start)
                (let mut right middle)
                (let mut at start)
                {
                  (while (< at end)
                    {
                      (if (|| (>= right end)
                            (&& (< left middle)
                              (<= (strCmp (vecGet keys left) (vecGet keys right)) 0)))
                        {
                          (vecSet scratch at (vecGet keys left))
                          (set left (+ left 1))
                        }
                        {
                          (vecSet scratch at (vecGet keys right))
                          (set right (+ right 1))
                        })
                      (set at (+ at 1))
                    })
                  (set start end)
                }
              })
            (for i in 0..size
              (vecSet keys i (vecGet scratch i)))
            (set width (* width 2))
          }
        })
      {
        (let mut i 1)
        (let mut distinct true)
        {
          (while (&& distinct (< i size))
            {
              (if (strEq (vecGet keys (- i 1)) (vecGet keys i))
                {
                  (set distinct false)
                  ()
                })
              (set i (+ i 1))
            })
          distinct
        }
      }
    }
  })

; YAML and TOML require unique dictionary keys, including nested ones.
(:: cyUniqueKeys (-> CerealValue Bool))
(fn (cyUniqueKeys value)
  (match value
    ((CArray items)
      {
        (let mut i 0)
        (let mut valid true)
        {
          (while (&& valid (< i (vecLen items)))
            {
              (set valid (cyUniqueKeys (vecGet items i)))
              (set i (+ i 1))
            })
          valid
        }
      }
    )
    ((CObject members)
      {
        (let mut i 0)
        (let mut valid (cerealDistinctKeys members))
        {
          (while (&& valid (< i (vecLen members)))
            {
              (let member (vecGet members i))
              {
                (set valid (cyUniqueKeys member.value))
                (set i (+ i 1))
              }
            })
          valid
        }
      }
    )
    (_ true)))

(:: cyFlow (-> CYState String Int (Result CerealValue Error)))
(fn (cyFlow state text depth)
  {
    (let check state.check)
    (let limits
      (CerealLimits
        :depth (- state.check.limits.depth depth)
        :bytes state.check.limits.bytes
        :nodes (- state.check.limits.nodes state.check.nodes)))
    (if (|| (< limits.depth 0) (< limits.nodes 1))
      (cerealError "YAML resource limit exceeded")
      (match (cjDecode text limits)
        ((Err error) (Err error))
        ((Ok value)
          {
            (ccValue check value depth)
            (if (! (strEq check.problem ""))
              (cerealError check.problem)
              (if (cyUniqueKeys value)
                (Ok value)
                (cerealError "duplicate YAML mapping key")))
          }
        )))
  })

(:: cyScalar (-> CYState String Int (Result CerealValue Error)))
(fn (cyScalar state text depth)
  {
    (let first (strByte text 0))
    (if (|| (== first 91) (|| (== first 123) (== first 34)))
      (cyFlow state text depth)
      {
        (ccVisit state.check depth)
        (if (! (strEq state.check.problem ""))
          (cerealError state.check.problem)
          (if (== first 39)
            (match (cySingle text)
              ((Err error) (Err error))
              ((Ok value) (Ok (CText value))))
            (cyPlain text)))
      })
  })

(:: cyKey (-> String (Result String Error)))
(fn (cyKey text)
  (if (strEq text "<<")
    (cerealError "YAML merge keys are unsupported")
    {
      (let first (strByte text 0))
      (if (== first 39)
        (cySingle text)
        (if (== first 34)
          (match (cjDecode text cerealLimits)
            ((Err error) (Err error))
            ((Ok value)
              (match value
                ((CText key) (Ok key))
                (_ (cerealError "YAML mapping keys must be strings")))
            ))
          (match (cyPlain text)
            ((Err error) (Err error))
            ((Ok value)
              (match value
                ((CText key) (Ok key))
                (_ (cerealError "YAML mapping keys must be strings")))
            ))))
    }))

(:: cyIndent (-> CYState Int))
(fn (cyIndent state)
  {
    (let line (vecGet state.lines state.at))
    line.indent
  })

(:: cyChild (-> CYState String Int Int (Result CerealValue Error)))
(fn (cyChild state inline indent depth)
  (if (> (strLen inline) 0)
    (cyScalar state inline depth)
    (if (&& (< state.at (vecLen state.lines)) (> (cyIndent state) indent))
      (cyBlock state (cyIndent state) depth)
      (cyScalar state "" depth))))

(:: cySequence (-> CYState Int Int (Result CerealValue Error)))
(fn (cySequence state indent depth)
  {
    (let items vecNew)
    (let mut done false)
    (let mut problem "")
    {
      (ccVisit state.check depth)
      (while (&& (! done) (&& (< state.at (vecLen state.lines)) (strEq problem "")))
        {
          (let line (vecGet state.lines state.at))
          (if (|| (!= line.indent indent) (! (cyDash line.text)))
            (set done true)
            {
              (set state.at (+ state.at 1))
              {
                (let inline (strTrim (strSlice line.text 1 (- (strLen line.text) 1))))
                (match (cyChild state inline indent (+ depth 1))
                  ((Ok value) (vecPush items value))
                  ((Err error)
                    {
                      (set problem error.message)
                      items
                    }
                  ))
              }
              (if (&& (< state.at (vecLen state.lines)) (> (cyIndent state) indent))
                {
                  (set problem "unexpected YAML indentation after a sequence value")
                  ()
                })
            })
        })
      (if (! (strEq state.check.problem ""))
        (cerealError state.check.problem)
        (if (strEq problem "")
          (Ok (CArray items))
          (cerealError problem)))
    }
  })

(:: cyMapping (-> CYState Int Int (Result CerealValue Error)))
(fn (cyMapping state indent depth)
  {
    (let members vecNew)
    (let mut done false)
    (let mut problem "")
    {
      (ccVisit state.check depth)
      (while (&& (! done) (&& (< state.at (vecLen state.lines)) (strEq problem "")))
        {
          (let line (vecGet state.lines state.at))
          (let colon (cyScan line.text false))
          (if (|| (!= line.indent indent) (< colon 0))
            (set done true)
            {
              (set state.at (+ state.at 1))
              (match (cyKey (strTrim (strSlice line.text 0 colon)))
                ((Err error)
                  (set problem error.message)
                )
                ((Ok key)
                  (match (cerealMemberGet members key 0)
                    ((Some previous)
                      {
                        (set problem "duplicate YAML mapping key")
                        ()
                      }
                    )
                    ((None)
                      {
                        (let inline
                          (strTrim
                            (strSlice line.text (+ colon 1) (- (strLen line.text) (+ colon 1)))))
                        (match (cyChild state inline indent (+ depth 1))
                          ((Ok value) (vecPush members (CerealMember :key key :value value)))
                          ((Err error)
                            (set problem error.message)
                          ))
                      }
                    ))
                ))
              (if (&& (< state.at (vecLen state.lines)) (> (cyIndent state) indent))
                {
                  (set problem "unexpected YAML indentation after a mapping value")
                  ()
                })
            })
        })
      (if (! (strEq state.check.problem ""))
        (cerealError state.check.problem)
        (if (strEq problem "")
          (Ok (CObject members))
          (cerealError problem)))
    }
  })

(:: cyBlock (-> CYState Int Int (Result CerealValue Error)))
(fn (cyBlock state indent depth)
  (if (> depth state.check.limits.depth)
    (cerealError "YAML nesting limit exceeded")
    {
      (let line (vecGet state.lines state.at))
      (if (cyDash line.text)
        (cySequence state indent depth)
        (if (>= (cyScan line.text false) 0)
          (cyMapping state indent depth)
          {
            (set state.at (+ state.at 1))
            (cyScalar state line.text depth)
          }))
    }))

(:: cyPrintable (-> String Bool))
(fn (cyPrintable source)
  {
    (let mut i 0)
    (let mut valid true)
    {
      (while (&& valid (< i (strLen source)))
        {
          (match (utf8DecodeAt source i)
            ((None)
              (set valid false)
            )
            ((Some cp)
              (if (!
                    (|| (|| (== cp 9) (|| (== cp 10) (== cp 13)))
                      (|| (&& (>= cp 32) (<= cp 126))
                        (|| (== cp 133) (&& (>= cp 160) (&& (!= cp 65534) (!= cp 65535)))))))
                {
                  (set valid false)
                  ()
                })
            ))
          (set i (utf8Next source i))
        })
      valid
    }
  })

(:: cyBlockDocument (-> String CerealLimits (Result CerealValue Error)))
(fn (cyBlockDocument source limits)
  (match (cyLines source)
    ((Err error) (Err error))
    ((Ok lines)
      {
        (let state
          (CYState :lines lines :check (CerealCheck :limits limits :nodes 0 :problem "") :at 0))
        (if (== (vecLen lines) 0)
          (cyScalar state "" 0)
          (if (!= (cyIndent state) 0)
            (cerealError "YAML root must start at indentation zero")
            (match (cyBlock state 0 0)
              ((Err error) (Err error))
              ((Ok value)
                (if (!= state.at (vecLen lines))
                  (cerealError "inconsistent YAML indentation or trailing content")
                  (Ok value))
              ))))
      }
    )))

(:: cyDecode (-> String CerealLimits (Result CerealValue Error)))
(fn (cyDecode source limits)
  (if (! (cerealLimitsValid limits))
    (cerealError "invalid codec resource limits")
    (if (> (strLen source) limits.bytes)
      (cerealError "YAML input byte limit exceeded")
      (if (! (cerealValidUtf8 source))
        (cerealError "invalid UTF-8 YAML input")
        (if (! (cyPrintable source))
          (cerealError "non-printable YAML character")
          {
            (let trimmed (strTrim source))
            (let first (strByte (strTrim source) 0))
            (if (|| (== first 91) (|| (== first 123) (== first 34)))
              {
                (let state
                  (CYState
                    :lines vecNew
                    :check (CerealCheck :limits limits :nodes 0 :problem "")
                    :at 0))
                (match (cyFlow state trimmed 0)
                  ((Ok value) (Ok value))
                  ((Err error) (cyBlockDocument source limits)))
              }
              (cyBlockDocument source limits))
          })))))

(:: cyWrite (-> CerealValue CerealWriter Int Int))
(fn (cyWrite value writer depth)
  (cjWrite value writer depth))

;; `cerealSerialize` under the given limits.
(pub :: cerealSerializeWith (-> CerealFormat CerealLimits (Codec a) a (Result String Error)))
(pub fn (cerealSerializeWith format limits codec value)
  (match (cerealToValue codec value)
    ((Err error) (Err error))
    ((Ok tree) (cerealEncodeWith format limits tree))))

;; `cerealDeserialize` under the given limits.
(pub :: cerealDeserializeWith (-> CerealFormat CerealLimits (Codec a) String (Result a Error)))
(pub fn (cerealDeserializeWith format limits codec source)
  (match (cerealDecodeWith format limits source)
    ((Err error) (Err error))
    ((Ok tree) (cerealFromValue codec tree))))
