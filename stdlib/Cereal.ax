; Cereal — typed serialisation for JSON, TOML and YAML.
; Codecs share CerealValue and return Result with explicit resource limits.
; The json* functions retain the raw-handle migration API for JSON-RPC.
; Raw consumers require live Cereal handles; new code uses typed values.
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Utf8)

; ------------------------------------------------------------------
; Tags
; ------------------------------------------------------------------
(:: JNULL Int)
(fn (JNULL)
  0)

(:: JBOOL Int)
(fn (JBOOL)
  1)

(:: JNUM Int)
(fn (JNUM)
  2)

(:: JSTR Int)
(fn (JSTR)
  3)

(:: JARR Int)
(fn (JARR)
  4)

(:: JOBJ Int)
(fn (JOBJ)
  5)

; The nesting limit. See the note above: this is a frame budget, not a
; grammar rule.
(:: jsonMaxDepth Int)
(fn (jsonMaxDepth)
  64)

; ------------------------------------------------------------------
; Construction
; ------------------------------------------------------------------
(:: jsonMake (-> Int a b Int))
;@axiom:effect(unsafe)
(fn (jsonMake tag a b)
  (let ((v (memAlloc 24)))
    {
      (memSetWord v 0 tag)
      (memSetWord v 1 a)
      (memSetWord v 2 b)
      v
    }))

(pub :: jsonNull Int)
(pub fn (jsonNull)
  (jsonMake JNULL 0 0))

(pub :: jsonBool (-> Int Int))
(pub fn (jsonBool b)
  (jsonMake
    JBOOL
    (if (== b 0)
      0
      1)
    0))

; A number from an integer. The raw text is rendered from the value, so
; `jsonNumText` is total for constructed values as well as parsed ones.
(pub :: jsonNum (-> Int Int))
(pub fn (jsonNum n)
  (jsonMake JNUM n (fmtInt n)))

(pub :: jsonStr (-> String Int))
(pub fn (jsonStr s)
  (jsonMake JSTR s 0))

(pub :: jsonArr Int)
(pub fn (jsonArr)
  (jsonMake JARR vecNew 0))

(pub :: jsonObj Int)
(pub fn (jsonObj)
  (jsonMake JOBJ vecNew vecNew))

; ------------------------------------------------------------------
; Inspection
; ------------------------------------------------------------------
(:: jsonTag (-> Int Int))
;@axiom:effect(unsafe)
(fn (jsonTag v)
  (if (== v 0)
    JNULL
    (memGetWord v 0)))

(pub :: jsonIsNull (-> Int Bool))
(pub fn (jsonIsNull v)
  (== (jsonTag v) JNULL))

(pub :: jsonBoolVal (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonBoolVal v)
  (if (== (jsonTag v) JBOOL)
    (memGetWord v 1)
    0))

; The integer value of a number, 0 for anything else. 0 is a real
; number, so a caller that must distinguish absence tests `jsonTag`
; first - the same contract `Utf8`'s -1 sentinel documents.
(pub :: jsonInt (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonInt v)
  (if (== (jsonTag v) JNUM)
    (memGetWord v 1)
    0))

(pub :: jsonNumText (-> Int String))
;@axiom:effect(unsafe)
(pub fn (jsonNumText v)
  (if (== (jsonTag v) JNUM)
    (memGetWordStr v 2)
    ""))

(pub :: jsonStrVal (-> Int String))
;@axiom:effect(unsafe)
(pub fn (jsonStrVal v)
  (if (== (jsonTag v) JSTR)
    (memGetWordStr v 1)
    ""))

(pub :: jsonArrLen (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonArrLen v)
  (if (== (jsonTag v) JARR)
    (vecLen (memGetWordVec v 1))
    0))

(pub :: jsonArrGet (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonArrGet v i)
  (if (== (jsonTag v) JARR)
    (if (|| (< i 0) (>= i (vecLen (memGetWordVec v 1))))
      0
      (vecGet (memGetWordVec v 1) i))
    0))

(pub :: jsonArrPush (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonArrPush v x)
  {
    (if (== (jsonTag v) JARR)
      (memSetWord v 1 (vecPush (memGetWordVec v 1) x))
      0)
    v
  })

(pub :: jsonObjLen (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonObjLen v)
  (if (== (jsonTag v) JOBJ)
    (vecLen (memGetWordVec v 1))
    0))

(:: jsonObjKeyAt (-> Int Int String))
;@axiom:effect(unsafe)
(fn (jsonObjKeyAt v i)
  (if (|| (< i 0) (>= i (jsonObjLen v)))
    ""
    (vecGetStr (memGetWordVec v 1) i)))

(:: jsonObjValAt (-> Int Int Int))
;@axiom:effect(unsafe)
(fn (jsonObjValAt v i)
  (if (|| (< i 0) (>= i (jsonObjLen v)))
    0
    (vecGet (memGetWordVec v 2) i)))

; The ONLY writer of the two parallel vecs, so they cannot desync. A
; repeated key appends rather than replacing, which is what a JSON
; reader that preserves what it was sent should do; `jsonGet` answers
; the first, matching the usual last-writer-loses reading being avoided
; here deliberately - LSP never sends duplicates, and inventing a
; replacement policy would be inventing behaviour no test can pin.
(pub :: jsonObjPut (-> Int String Int Int))
;@axiom:effect(unsafe)
(pub fn (jsonObjPut v k x)
  {
    (if (== (jsonTag v) JOBJ)
      {
        (memSetWord v 1 (vecPush (memGetWordVec v 1) k))
        (memSetWord v 2 (vecPush (memGetWordVec v 2) x))
        0
      }
      0)
    v
  })

; The value for `key`, or 0 when there is none. 0 is not a valid value
; pointer, so it is an unambiguous absence marker AT THIS LAYER - but
; `jsonTag` reports 0 as `JNULL`, so `jsonIsNull` cannot tell an absent
; member from one explicitly set to null. A caller that must
; distinguish the two tests against 0 directly, which is what
; `lsp.ax`'s dispatch does to tell a request from a notification: an
; absent `id` means notification, and a null `id` is a different thing
; the protocol does not let you answer the same way.
(pub :: jsonGet (-> Int String Int))
(pub fn (jsonGet v key)
  (jsonGetFrom v key 0))

(:: jsonGetFrom (-> Int String Int Int))
(fn (jsonGetFrom v key i)
  (if (>= i (jsonObjLen v))
    0
    (if (strEq (jsonObjKeyAt v i) key)
      (jsonObjValAt v i)
      (jsonGetFrom v key (+ i 1)))))

(pub :: jsonGetInt (-> Int String Int))
(pub fn (jsonGetInt v key)
  (jsonInt (jsonGet v key)))

(pub :: jsonGetStr (-> Int String String))
(pub fn (jsonGetStr v key)
  (jsonStrVal (jsonGet v key)))

; ------------------------------------------------------------------
; Integer rendering uses the imported Fmt.fmtInt, including the most
; negative Int. Parsed numbers retain their original text instead.
; Tested by tests/stdlib/340-json.ax.
; ------------------------------------------------------------------
; Joining
;
; Two walks: sum the lengths, allocate once, copy each piece in. The
; left-fold alternative is quadratic in a bump allocator and is the
; single most expensive mistake this project has measured.
; ------------------------------------------------------------------
(:: jsonJoin (-> (Vec a) String))
(fn (jsonJoin pieces)
  (let ((total (jsonJoinLen pieces)))
    (let ((out (strAlloc total)))
      {
        (jsonJoinFill pieces out)
        out
      })))

(:: jsonJoinLen (-> (Vec a) Int))
;@axiom:effect(unsafe)
(fn (jsonJoinLen pieces)
  (let (
    (mut k 0)
    (mut n 0)
  )
    {
      (while (< k (vecLen pieces))
        {
          (set n (+ n (strLen (vecGetStr pieces k))))
          (set k (+ k 1))
        })
      n
    }))

(:: jsonJoinFill (-> (Vec a) String Int))
;@axiom:effect(unsafe)
(fn (jsonJoinFill pieces out)
  (let ((mut off 0))
    {
      (for k in 0..(vecLen pieces)
        (let ((p (vecGetStr pieces k)))
          {
            (memCopy (+ (strData out) off) (strData p) (strLen p))
            (set off (+ off (strLen p)))
          }))
      off
    }))

; ------------------------------------------------------------------
; String escaping
;
; Two walks again, for the same reason. Escaped: `"` and `\` as their
; two-character forms, the five control characters with short spellings,
; and every other byte below 0x20 as `\u00XX`. Bytes above 0x7F that
; form WELL-FORMED UTF-8 pass through unchanged: JSON is defined over
; Unicode text, so re-encoding them as `\u` escapes would be legal and
; pointless.
;
; A byte above 0x7F that begins no well-formed sequence
; (`utf8WellFormedAt`: Unicode's Table 3-7, so an overlong form, an
; encoded surrogate and a truncated sequence count) is written as
; `�`, one per byte. "The input is already UTF-8" was an
; assumption, and a `String` is bytes: the LSP writes a document's own
; text back through here, and the compiler's JSON diagnostics - which
; took the same rule on 2026-09-27 (`jsonEsc` in self_host/render.ax)
; - were shown writing lines no strict reader parses. Not `\u00XX`:
; that names the character U+00XX, not the byte.
;
; DEL (0x7F) is NOT escaped - JSON does not require it, and every
; implementation this must interoperate with leaves it alone.
; ------------------------------------------------------------------
; The number of bytes `b` occupies once escaped.
(:: jsonEscLen (-> Int Int))
(fn (jsonEscLen b)
  (if (|| (== b 34) (== b 92))
    2
    (if (|| (== b 8) (|| (== b 12) (|| (== b 10) (|| (== b 13) (== b 9)))))
      2
      (if (< b 32)
        6
        1))))

(:: jsonEscape (-> String String))
(fn (jsonEscape s)
  (let ((total (jsonEscapeLen s)))
    (if (== total (strLen s))
      s
      (let ((out (strAlloc total)))
        {
          (jsonEscapeFill s out)
          out
        }))))

(:: jsonEscapeLen (-> String Int))
(fn (jsonEscapeLen s)
  (let (
    (mut n 0)
    (mut k 0)
    (len (strLen s))
  )
    {
      (while (< k len)
        (let ((b (strByte s k)))
          (if (< b 128)
            {
              (set n (+ n (jsonEscLen b)))
              (set k (+ k 1))
            }
            (let ((w (utf8WellFormedAt s k len)))
              (if (== w 0)
                {
                  (set n (+ n 6))
                  (set k (+ k 1))
                }
                {
                  (set n (+ n w))
                  (set k (+ k w))
                })))))
      n
    }))

; The lower-case hex digit for the low nibble of `b`.
(:: jsonHexDigit (-> Int Int))
(fn (jsonHexDigit b)
  (strByte "0123456789abcdef" (& b 15)))

; A one-byte string holding `b`. Needed for the control characters
; Axiom's own string syntax cannot spell.
(:: jsonEscapeFill (-> String String Int))
;@axiom:effect(unsafe)
(fn (jsonEscapeFill s out)
  (let (
    (mut off 0)
    (mut skip 0)
    (len (strLen s))
    (d (strData out))
  )
    {
      ; `skip` counts the continuation bytes still owed to a
      ; well-formed sequence whose lead byte was just copied; they are
      ; copied as they come. A byte that begins no well-formed sequence
      ; is `�` - the rule `jsonEscapeLen` sized the buffer by.
      (for k in 0..len
        (let ((b (strByte s k)))
          (if (> skip 0)
            {
              (__store8 d off b)
              (set off (+ off 1))
              (set skip (- skip 1))
            }
            (let ((w (if (< b 128)
              1
              (utf8WellFormedAt s k len))))
              (if (== w 0)
                {
                  (__store8 d off 92)
                  (__store8 d (+ off 1) 117)
                  (__store8 d (+ off 2) 102)
                  (__store8 d (+ off 3) 102)
                  (__store8 d (+ off 4) 102)
                  (__store8 d (+ off 5) 100)
                  (set off (+ off 6))
                }
                {
                  (set skip (- w 1))
                  (jsonEscapeOne d off b)
                  (set off (+ off (jsonEscLen b)))
                })))))
      off
    }))

; One byte that is text: its escape, or itself, written at `off`.
(:: jsonEscapeOne (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (jsonEscapeOne d off0 b)
  (let ((mut off off0))
    {
          (if (== b 34)
            {
              (__store8 d off 92)
              (__store8 d (+ off 1) 34)
              (set off (+ off 2))
            }
            (if (== b 92)
              {
                (__store8 d off 92)
                (__store8 d (+ off 1) 92)
                (set off (+ off 2))
              }
              (if (== b 8)
                {
                  (__store8 d off 92)
                  (__store8 d (+ off 1) 98)
                  (set off (+ off 2))
                }
                (if (== b 12)
                  {
                    (__store8 d off 92)
                    (__store8 d (+ off 1) 102)
                    (set off (+ off 2))
                  }
                  (if (== b 10)
                    {
                      (__store8 d off 92)
                      (__store8 d (+ off 1) 110)
                      (set off (+ off 2))
                    }
                    (if (== b 13)
                      {
                        (__store8 d off 92)
                        (__store8 d (+ off 1) 114)
                        (set off (+ off 2))
                      }
                      (if (== b 9)
                        {
                          (__store8 d off 92)
                          (__store8 d (+ off 1) 116)
                          (set off (+ off 2))
                        }
                        (if (< b 32)
                          {
                            (__store8 d off 92)
                            (__store8 d (+ off 1) 117)
                            (__store8 d (+ off 2) 48)
                            (__store8 d (+ off 3) 48)
                            (__store8 d (+ off 4) (jsonHexDigit (/ b 16)))
                            (__store8 d (+ off 5) (jsonHexDigit b))
                            (set off (+ off 6))
                          }
                          {
                            (__store8 d off b)
                            (set off (+ off 1))
                          }))))))))
      off
    }))

; ------------------------------------------------------------------
; Serialisation
; ------------------------------------------------------------------
(pub :: jsonWrite (-> Int String))
(pub fn (jsonWrite v)
  (let ((pieces vecNew))
    {
      (jsonWriteInto v pieces)
      (jsonJoin pieces)
    }))

(:: jsonWriteInto (-> Int (Vec String) (Vec String)))
;@axiom:effect(unsafe)
(fn (jsonWriteInto v pieces)
  (let ((t (jsonTag v)))
    (if (== t JNULL)
      (vecPush pieces "null")
      (if (== t JBOOL)
        (vecPush
          pieces
          (if (== (memGetWord v 1) 0)
            "false"
            "true"))
        (if (== t JNUM)
          (vecPush pieces (memGetWordStr v 2))
          (if (== t JSTR)
            {
              (vecPush pieces "\"")
              (vecPush pieces (jsonEscape (memGetWordStr v 1)))
              (vecPush pieces "\"")
            }
            (if (== t JARR)
              (jsonWriteArr v pieces)
              (jsonWriteObj v pieces))))))))

(:: jsonWriteArr (-> Int (Vec String) (Vec String)))
;@axiom:effect(unsafe)
(fn (jsonWriteArr v pieces)
  (let ((items (memGetWordVec v 1)))
    {
      (vecPush pieces "[")
      (for i in 0..(vecLen items)
        {
          (if (> i 0)
            (vecPush pieces ",")
            (cast (Vec String) 0))
          (jsonWriteInto (vecGet items i) pieces)
        })
      (vecPush pieces "]")
    }))

(:: jsonWriteObj (-> Int (Vec String) (Vec String)))
;@axiom:effect(unsafe)
(fn (jsonWriteObj v pieces)
  (let (
    (keys (memGetWordVec v 1))
    (vals (memGetWordVec v 2))
  )
    {
      (vecPush pieces "{")
      (for i in 0..(vecLen keys)
        {
          (if (> i 0)
            (vecPush pieces ",")
            (cast (Vec String) 0))
          (vecPush pieces "\"")
          (vecPush pieces (jsonEscape (vecGetStr keys i)))
          (vecPush pieces "\":")
          (jsonWriteInto (vecGet vals i) pieces)
        })
      (vecPush pieces "}")
    }))

; ------------------------------------------------------------------
; Parsing
;
; The cursor is a record - position, and an error flag - passed down
; and mutated, so no parse function allocates a pair per token. Once
; the error flag is set every parse function returns immediately, so a
; malformed input costs one pass and cannot loop.
; ------------------------------------------------------------------
(struct CjCursor (mut pos : Int) (mut bad : Int))

(:: jcNew CjCursor)
(fn (jcNew)
  (CjCursor 0 0))

(:: jcPos (-> CjCursor Int))
(fn (jcPos c)
  c.pos)

(:: jcSetPos (-> CjCursor Int Int))
(fn (jcSetPos c p)
  {
    (set c.pos p)
    p
  })

(:: jcBad (-> CjCursor Bool))
(fn (jcBad c)
  (!= c.bad 0))

(:: jcFail (-> CjCursor Int))
(fn (jcFail c)
  {
    (set c.bad 1)
    0
  })

; The byte at the cursor, or -1 at the end of the input.
(:: jcPeek (-> String CjCursor Int))
(fn (jcPeek src c)
  (if (>= (jcPos c) (strLen src))
    (- 0 1)
    (strByte src (jcPos c))))

(:: jcSkipWs (-> String CjCursor Int))
(fn (jcSkipWs src c)
  (let ((mut p (jcPos c)))
    {
      (while (&& (< p (strLen src)) (strIsSpace (strByte src p)))
        (set p (+ p 1)))
      ; JSON's insignificant whitespace is space, tab, LF
      ; and CR - the same four bytes `strIsSpace` names, and
      ; this used to say so a fourth time in its own idiom.
      (jcSetPos c p)
    }))

; Parse a whole document: one value, then nothing but whitespace.
; Answers 0 on any error, which is why every accessor tolerates 0.
(pub :: jsonParse (-> String Int))
(pub fn (jsonParse src)
  (let ((c jcNew))
    (let ((v (jpValue src c 0)))
      {
        (jcSkipWs src c)
        (if (|| (jcBad c) (< (jcPos c) (strLen src)))
          0
          v)
      })))

(:: jpValue (-> String CjCursor Int Int))
(fn (jpValue src c depth)
  {
    (jcSkipWs src c)
    (if (jcBad c)
      0
      (if (> depth jsonMaxDepth)
        {
          (jcFail c)
          0
        }
        (let ((b (jcPeek src c)))
          (if (== b 123)
            (jpObject src c depth)
            (if (== b 91)
              (jpArray src c depth)
              (if (== b 34)
                (jsonStr (jpString src c))
                (if (== b 116)
                  (jpLit src c "true" (jsonBool 1))
                  (if (== b 102)
                    (jpLit src c "false" (jsonBool 0))
                    (if (== b 110)
                      (jpLit src c "null" jsonNull)
                      (if (|| (== b 45) (&& (>= b 48) (<= b 57)))
                        (jpNumber src c)
                        {
                          (jcFail c)
                          0
                        }))))))))))
  })

(:: jpLit (-> String CjCursor String Int Int))
(fn (jpLit src c word v)
  (if (jpMatches src (jcPos c) word 0)
    {
      (jcSetPos c (+ (jcPos c) (strLen word)))
      v
    }
    {
      (jcFail c)
      0
    }))

(:: jpMatches (-> String Int String Int Bool))
(fn (jpMatches src at word i)
  (if (>= i (strLen word))
    true
    (if (>= (+ at i) (strLen src))
      false
      (if (== (strByte src (+ at i)) (strByte word i))
        (jpMatches src at word (+ i 1))
        false))))

; A number, as its integer value plus the exact bytes it was written
; with. The fraction and exponent are CONSUMED and preserved in the
; text but do not contribute to the integer - see the header note.
(:: jpNumber (-> String CjCursor Int))
(fn (jpNumber src c)
  (let ((start (jcPos c)))
    (let (
      (mut p start)
      (mut neg 0)
      (mut val 0)
      (mut digits 0)
    )
      {
        (if (== (jcPeek src c) 45)
          {
            (set neg 1)
            (set p (+ p 1))
          }
          0)
        (while (&& (< p (strLen src)) (&& (>= (strByte src p) 48) (<= (strByte src p) 57)))
          {
            (set val (+ (* val 10) (- (strByte src p) 48)))
            (set digits (+ digits 1))
            (set p (+ p 1))
          })
        ; A lone `-`, or `-.5`, is not a number.
        (if (== digits 0)
          (jcFail c)
          0)
        ; A leading zero is a whole integer part, not a digit prefix.
        (if (&& (> digits 1) (== (strByte src (+ start neg)) 48))
          (jcFail c)
          0)
        ; Fraction and exponent: consumed so the cursor lands after the
        ; whole literal, and kept in the text.
        (if (&& (< p (strLen src)) (== (strByte src p) 46))
          {
            (set p (+ p 1))
            (let ((fraction p))
              {
                (while (&& (< p (strLen src)) (&& (>= (strByte src p) 48) (<= (strByte src p) 57)))
                  (set p (+ p 1)))
                (if (== p fraction) (jcFail c) 0)
              })
          }
          0)
        (if (&& (< p (strLen src)) (|| (== (strByte src p) 101) (== (strByte src p) 69)))
          {
            (set p (+ p 1))
            (if (&& (< p (strLen src)) (|| (== (strByte src p) 43) (== (strByte src p) 45)))
              (set p (+ p 1))
              0)
            (let ((exponent p))
              {
                (while (&& (< p (strLen src)) (&& (>= (strByte src p) 48) (<= (strByte src p) 57)))
                  (set p (+ p 1)))
                (if (== p exponent) (jcFail c) 0)
              })
          }
          0)
        (jcSetPos c p)
        (if (jcBad c)
          0
          (jsonMake
            JNUM
            (if (== neg 1)
              (- 0 val)
              val)
            (strSlice src start (- p start))))
      })))

; A string literal, answering its DECODED bytes. The cursor is left
; after the closing quote.
;
; Escapes are decoded into a piece vector rather than a growing
; concatenation, and the common case - a string with no escape at all -
; takes a single slice and allocates nothing.
(:: jpString (-> String CjCursor String))
;@axiom:effect(unsafe)
(fn (jpString src c)
  (if (!= (jcPeek src c) 34)
    {
      (jcFail c)
      ""
    }
    (let (
      (pieces vecNew)
      (mut p (+ (jcPos c) 1))
      (mut run (+ (jcPos c) 1))
      (mut done 0)
    )
      {
        (while (== done 0)
          (if (>= p (strLen src))
            {
              (jcFail c)
              (set done 1)
            }
            (let ((b (strByte src p)))
              (if (== b 34)
                {
                  (if (> p run)
                    (vecPush pieces (strSlice src run (- p run)))
                    (cast (Vec String) 0))
                  (set p (+ p 1))
                  (set done 1)
                }
                (if (== b 92)
                  {
                    (if (> p run)
                      (vecPush pieces (strSlice src run (- p run)))
                      (cast (Vec String) 0))
                    (set p (jpEscape src c (+ p 1) pieces))
                    (set run p)
                    (if (jcBad c)
                      (set done 1)
                      0)
                  }
                  ; A raw control character is invalid JSON. It
                  ; is refused rather than passed through: a
                  ; server that accepts a bare newline inside a
                  ; string accepts a message its peer never
                  ; meant to send.
                  (if (< b 32)
                    {
                      (jcFail c)
                      (set done 1)
                    }
                    (set p (+ p 1))))))))
        (jcSetPos c p)
        (if (jcBad c)
          ""
          (jsonJoin pieces))
      })))

; Decode one escape whose backslash was at `p - 1`, pushing its bytes.
; Answers the offset just past the escape.
(:: jpEscape (-> String CjCursor Int (Vec String) Int))
(fn (jpEscape src c p pieces)
  (if (>= p (strLen src))
    {
      (jcFail c)
      p
    }
    (let ((b (strByte src p)))
      (if (== b 34)
        {
          (vecPush pieces "\"")
          (+ p 1)
        }
        (if (== b 92)
          {
            (vecPush pieces "\\")
            (+ p 1)
          }
          (if (== b 47)
            {
              (vecPush pieces "/")
              (+ p 1)
            }
            ; Backspace and formfeed have no Axiom string escape - the
            ; lexer accepts only \n \t \r \\ \" \' \0 and makes anything
            ; else a hard error - so their bytes are built rather than
            ; written.
            (if (== b 98)
              {
                (vecPush pieces (strFromByte 8))
                (+ p 1)
              }
              (if (== b 102)
                {
                  (vecPush pieces (strFromByte 12))
                  (+ p 1)
                }
                (if (== b 110)
                  {
                    (vecPush pieces "\n")
                    (+ p 1)
                  }
                  (if (== b 114)
                    {
                      (vecPush pieces "\r")
                      (+ p 1)
                    }
                    (if (== b 116)
                      {
                        (vecPush pieces "\t")
                        (+ p 1)
                      }
                      (if (== b 117)
                        (jpUnicode src c (+ p 1) pieces)
                        {
                          (jcFail c)
                          p
                        }))))))))))))

; `\uXXXX`, including the surrogate pair a code point above the BMP is
; written with. An unpaired surrogate is replaced by U+FFFD rather than
; refused: it cannot be encoded as UTF-8, and refusing a whole message
; over one bad character is the less useful of the two failures.
(:: jpUnicode (-> String CjCursor Int (Vec String) Int))
(fn (jpUnicode src c p pieces)
  (let ((hi (jpHex4 src c p)))
    (if (jcBad c)
      p
      (if (&& (>= hi 55296) (<= hi 56319))
        ; A high surrogate. A `\uXXXX` low surrogate must follow.
        (if (&& (< (+ p 6) (strLen src)) (&& (== (strByte src (+ p 4)) 92) (== (strByte src (+ p 5)) 117)))
          (let ((lo (jpHex4 src c (+ p 6))))
            (if (jcBad c)
              p
              (if (&& (>= lo 56320) (<= lo 57343))
                {
                  (vecPush pieces (utf8FromChar (+ 65536 (+ (* (- hi 55296) 1024) (- lo 56320)))))
                  (+ p 10)
                }
                {
                  (vecPush pieces (utf8FromChar utf8Replacement))
                  (+ p 4)
                })))
          {
            (vecPush pieces (utf8FromChar utf8Replacement))
            (+ p 4)
          })
        (if (&& (>= hi 56320) (<= hi 57343))
          ; A low surrogate with no high one before it.
          {
            (vecPush pieces (utf8FromChar utf8Replacement))
            (+ p 4)
          }
          {
            (vecPush pieces (utf8FromChar hi))
            (+ p 4)
          })))))

(:: jpHex4 (-> String CjCursor Int Int))
(fn (jpHex4 src c p)
  (if (> (+ p 4) (strLen src))
    {
      (jcFail c)
      0
    }
    (match (jpHexDigits src p)
      ((Some v) v)
      ((None)
        {
          (jcFail c)
          0
        }
      ))))

; The four hex digits at `p` as one value, or `None` when any of them
; is not a digit. Each `strHexVal` is matched directly and read from
; registers; the four-deep nest is the shape a lookup that answers
; `Option` asks of a caller that needs all four before it can answer.
(:: jpHexDigits (-> String Int (Option Int)))
(fn (jpHexDigits src p)
  (match (strHexVal (strByte src p))
    ((None) None)
    ((Some a)
      (match (strHexVal (strByte src (+ p 1)))
        ((None) None)
        ((Some b)
          (match (strHexVal (strByte src (+ p 2)))
            ((None) None)
            ((Some d)
              (match (strHexVal (strByte src (+ p 3)))
                ((None) None)
                ((Some e) (Some (+ (* a 4096) (+ (* b 256) (+ (* d 16) e))))))
            ))
        ))
    )))

(:: jpArray (-> String CjCursor Int Int))
(fn (jpArray src c depth)
  (let (
    (v jsonArr)
    (mut done 0)
    (mut first 1)
  )
    {
      (jcSetPos c (+ (jcPos c) 1))
      (while (== done 0)
        {
          (jcSkipWs src c)
          (if (jcBad c)
            (set done 1)
            (let ((b (jcPeek src c)))
              (if (== b 93)
                {
                  (jcSetPos c (+ (jcPos c) 1))
                  (set done 1)
                }
                (if (< b 0)
                  {
                    (jcFail c)
                    (set done 1)
                  }
                  ; Every element after the first is preceded
                  ; by a comma, and a trailing comma therefore
                  ; fails at the `]` that follows it.
                  {
                    (if (== first 0)
                      (if (== b 44)
                        (jcSetPos c (+ (jcPos c) 1))
                        {
                          (jcFail c)
                          (set done 1)
                        })
                      0)
                    (if (== done 0)
                      (let ((x (jpValue src c (+ depth 1))))
                        {
                          (if (jcBad c)
                            (set done 1)
                            (jsonArrPush v x))
                          (set first 0)
                        })
                      0)
                  }))))
        })
      (if (jcBad c)
        0
        v)
    }))

(:: jpObject (-> String CjCursor Int Int))
(fn (jpObject src c depth)
  (let (
    (v jsonObj)
    (mut done 0)
    (mut first 1)
  )
    {
      (jcSetPos c (+ (jcPos c) 1))
      (while (== done 0)
        {
          (jcSkipWs src c)
          (if (jcBad c)
            (set done 1)
            (let ((b (jcPeek src c)))
              (if (== b 125)
                {
                  (jcSetPos c (+ (jcPos c) 1))
                  (set done 1)
                }
                (if (< b 0)
                  {
                    (jcFail c)
                    (set done 1)
                  }
                  {
                    (if (== first 0)
                      (if (== b 44)
                        (jcSetPos c (+ (jcPos c) 1))
                        {
                          (jcFail c)
                          (set done 1)
                        })
                      0)
                    (if (== done 0)
                      {
                        (jcSkipWs src c)
                        (let ((k (jpString src c)))
                          {
                            (jcSkipWs src c)
                            (if (jcBad c)
                              (set done 1)
                              (if (!= (jcPeek src c) 58)
                                {
                                  (jcFail c)
                                  (set done 1)
                                }
                                {
                                  (jcSetPos c (+ (jcPos c) 1))
                                  (let ((x (jpValue src c (+ depth 1))))
                                    (if (jcBad c)
                                      (set done 1)
                                      (jsonObjPut v k x)))
                                }))
                            (set first 0)
                          })
                      }
                      0)
                  }))))
        })
      (if (jcBad c)
        0
        v)
    }))

; The typed tree is shared by every codec. CNumber keeps exact decimal
; text when a JSON number is fractional or outside Axiom's Int range.
; CerealMember preserves dictionary order. The json* functions above remain
; a migration interface; new code uses CerealValue and Result throughout.
(import Err)

(pub data CerealValue
  (CNull)
  (CBool Bool)
  (CInt Int)
  (CNumber String)
  (CText String)
  (CArray (Vec CerealValue))
  (CObject (Vec CerealMember)))

(pub struct CerealMember
  (key : String)
  (value : CerealValue))

(pub data CerealFormat (CerealJson) (CerealToml) (CerealYaml))

(pub struct CerealLimits
  (depth : Int)
  (bytes : Int)
  (nodes : Int))

; A codec converts application values to the common tree and back.
; Compose these functions for records; no raw reference words cross
; this interface, and a missing or wrongly typed field is an Error.
(pub data Codec (a)
  (Codec (-> a (Result CerealValue Error)) (-> CerealValue (Result a Error))))

(pub :: cerealLimits CerealLimits)
(pub fn (cerealLimits) (CerealLimits 64 1048576 100000))

(:: cerealError (-> String (Result a Error)))
(fn (cerealError message) (Err (mkError 22 (concat "Cereal: " message))))

(:: cerealLimitsValid (-> CerealLimits Bool))
(fn (cerealLimitsValid limits)
  (&& (&& (>= limits.depth 1) (<= limits.depth 64))
    (&& (&& (>= limits.bytes 1) (<= limits.bytes 16777216))
      (&& (>= limits.nodes 1) (<= limits.nodes 1000000)))))

(:: cerealValidUtf8 (-> String Bool))
(fn (cerealValidUtf8 s)
  (let ((mut i 0) (mut valid true) (len (strLen s)))
    {
      (while (&& valid (< i len))
        (let ((w (utf8WellFormedAt s i len)))
          (if (== w 0) { (set valid false) 0 } { (set i (+ i w)) 0 })))
      valid
    }))

(:: cerealDecimalDigits (-> String Int Int))
(fn (cerealDecimalDigits text start)
  (let ((mut p start))
    { (while (&& (< p (strLen text)) (strIsDigit (strByte text p)))
        (set p (+ p 1))) p }))

(:: cerealNumberValid (-> String Bool))
(fn (cerealNumberValid text)
  (let ((len (strLen text)) (mut p 0) (mut valid true))
    { (if (== (strByte text p) 45) (set p 1) 0)
      (let ((start p))
        { (set p (cerealDecimalDigits text p))
          (if (|| (== p start) (&& (> (- p start) 1) (== (strByte text start) 48)))
            { (set valid false) 0 } 0) })
      (if (== (strByte text p) 46)
        { (set p (+ p 1))
          (let ((start p))
            { (set p (cerealDecimalDigits text p))
              (if (== p start) { (set valid false) 0 } 0) }) } 0)
      (if (|| (== (strByte text p) 101) (== (strByte text p) 69))
        { (set p (+ p 1))
          (if (|| (== (strByte text p) 43) (== (strByte text p) 45)) (set p (+ p 1)) 0)
          (let ((start p))
            { (set p (cerealDecimalDigits text p))
              (if (== p start) { (set valid false) 0 } 0) }) } 0)
      (&& valid (== p len)) }))

(:: cerealNumberValue (-> String (Result CerealValue Error)))
(fn (cerealNumberValue text)
  (if (! (cerealNumberValid text))
    (cerealError "invalid decimal number")
    (match (strParseInt text)
      ((Some n) (Ok (CInt n)))
      ((None) (Ok (CNumber (strDup text)))))))

(pub :: cerealObjectGet (-> CerealValue String (Option CerealValue)))
(pub fn (cerealObjectGet value key)
  (match value
    ((CObject members) (cerealMemberGet members key 0))
    (_ None)))

(:: cerealMemberGet (-> (Vec CerealMember) String Int (Option CerealValue)))
(fn (cerealMemberGet members key i)
  (if (>= i (vecLen members))
    None
    (let ((member (vecGet members i)))
      (if (strEq member.key key)
        (Some member.value)
        (cerealMemberGet members key (+ i 1))))))

(pub :: cerealRequired (-> CerealValue String (Result CerealValue Error)))
(pub fn (cerealRequired value key)
  (match value
    ((CObject members)
      (match (cerealMemberGet members key 0)
        ((Some v) (Ok v))
        ((None) (cerealError (concat "missing field: " key)))))
    (_ (cerealError "expected a dictionary"))))

(pub :: cerealInt (-> CerealValue (Result Int Error)))
(pub fn (cerealInt value)
  (match value
    ((CInt n) (Ok n))
    ((CNumber text)
      (match (strParseInt text)
        ((Some n) (Ok n))
        ((None) (cerealError "expected an integer within Int range"))))
    (_ (cerealError "expected an integer"))))

(pub :: cerealText (-> CerealValue (Result String Error)))
(pub fn (cerealText value)
  (match value
    ((CText s) (Ok s))
    (_ (cerealError "expected a string"))))

(pub :: cerealBool (-> CerealValue (Result Bool Error)))
(pub fn (cerealBool value)
  (match value
    ((CBool b) (Ok b))
    (_ (cerealError "expected a boolean"))))

(:: cerealIntValue (-> Int (Result CerealValue Error)))
(fn (cerealIntValue n) (Ok (CInt n)))
(:: cerealTextValue (-> String (Result CerealValue Error)))
(fn (cerealTextValue s) (Ok (CText s)))
(:: cerealBoolValue (-> Bool (Result CerealValue Error)))
(fn (cerealBoolValue b) (Ok (CBool b)))
(:: cerealIdentity (-> CerealValue (Result CerealValue Error)))
(fn (cerealIdentity value) (Ok value))

(pub :: cerealIntCodec (Codec Int))
(pub fn (cerealIntCodec) (Codec cerealIntValue cerealInt))
(pub :: cerealTextCodec (Codec String))
(pub fn (cerealTextCodec) (Codec cerealTextValue cerealText))
(pub :: cerealBoolCodec (Codec Bool))
(pub fn (cerealBoolCodec) (Codec cerealBoolValue cerealBool))
(pub :: cerealValueCodec (Codec CerealValue))
(pub fn (cerealValueCodec) (Codec cerealIdentity cerealIdentity))

(pub :: cerealToValue (-> (Codec a) a (Result CerealValue Error)))
(pub fn (cerealToValue codec value)
  (match codec ((Codec encode decode) (encode value))))
(pub :: cerealFromValue (-> (Codec a) CerealValue (Result a Error)))
(pub fn (cerealFromValue codec value)
  (match codec ((Codec encode decode) (decode value))))

(:: cerealVecToValue (-> (Codec a) (Vec a) (Result CerealValue Error)))
(fn (cerealVecToValue codec items)
  (let ((out vecNew) (mut i 0) (mut problem ""))
    {
      (while (&& (< i (vecLen items)) (strEq problem ""))
        {
          (match (cerealToValue codec (vecGet items i))
            ((Ok value) (vecPush out value))
            ((Err e) { (set problem e.message) out }))
          (set i (+ i 1))
        })
      (if (strEq problem "") (Ok (CArray out)) (cerealError problem))
    }))

(:: cerealVecFromValue (-> (Codec a) CerealValue (Result (Vec a) Error)))
(fn (cerealVecFromValue codec value)
  (match value
    ((CArray items)
      (let ((out vecNew) (mut i 0) (mut problem ""))
        {
          (while (&& (< i (vecLen items)) (strEq problem ""))
            {
              (match (cerealFromValue codec (vecGet items i))
                ((Ok item) (vecPush out item))
                ((Err e) { (set problem e.message) out }))
              (set i (+ i 1))
            })
          (if (strEq problem "") (Ok out) (cerealError problem))
        }))
    (_ (cerealError "expected an array"))))

(pub :: cerealVecCodec (-> (Codec a) (Codec (Vec a))))
(pub fn (cerealVecCodec codec)
  (Codec
    (lambda (items) (cerealVecToValue codec items))
    (lambda (value) (cerealVecFromValue codec value))))

(:: cerealOptionToValue (-> (Codec a) (Option a) (Result CerealValue Error)))
(fn (cerealOptionToValue codec value)
  (match value ((None) (Ok CNull)) ((Some item) (cerealToValue codec item))))

(:: cerealOptionFromValue (-> (Codec a) CerealValue (Result (Option a) Error)))
(fn (cerealOptionFromValue codec value)
  (match value
    ((CNull) (Ok None))
    (_ (match (cerealFromValue codec value)
      ((Err error) (Err error)) ((Ok item) (Ok (Some item)))))))

(pub :: cerealOptionCodec (-> (Codec a) (Codec (Option a))))
(pub fn (cerealOptionCodec codec)
  (Codec (lambda (value) (cerealOptionToValue codec value))
    (lambda (value) (cerealOptionFromValue codec value))))

; Include the field name in a record codec's error context.
(pub :: cerealField (-> (Codec a) CerealValue String (Result a Error)))
(pub fn (cerealField codec value key)
  (let ((answer (match (cerealRequired value key)
          ((Err error) (Err error))
          ((Ok member) (cerealFromValue codec member)))))
    (match answer
      ((Ok item) (Ok item))
      ((Err error) (Err (Error error.code error.message
        (concat key (if (strEq error.context "") "" (concat "." error.context)))))))))

(struct CerealCheck
  (limits : CerealLimits)
  (mut nodes : Int)
  (mut problem : String))

(:: ccVisit (-> CerealCheck Int Int))
(fn (ccVisit check depth)
  {
    (if (strEq check.problem "")
      (if (> depth check.limits.depth)
        { (set check.problem "nesting limit exceeded") 0 }
        (if (>= check.nodes check.limits.nodes)
          { (set check.problem "node limit exceeded") 0 }
          { (set check.nodes (+ check.nodes 1)) 0 }))
      0)
    0
  })

(:: ccString (-> CerealCheck String Int))
(fn (ccString check s)
  {
    (if (> (strLen s) check.limits.bytes)
      { (set check.problem "byte limit exceeded") 0 }
      (if (! (cerealValidUtf8 s))
        { (set check.problem "invalid UTF-8 text") 0 }
        0))
    0
  })

(:: ccValue (-> CerealCheck CerealValue Int Int))
(fn (ccValue check value depth)
  {
    (ccVisit check depth)
    (if (strEq check.problem "")
      (match value
        ((CNull) 0)
        ((CBool b) 0)
        ((CInt n) 0)
        ((CNumber text)
          { (ccString check text)
            (if (strEq check.problem "")
              (match (cerealNumberValue text)
                ((Ok n) 0)
                ((Err e) { (set check.problem "invalid decimal number") 0 })) 0) })
        ((CText s) (ccString check s))
        ((CArray items)
          (let ((mut i 0))
            { (while (&& (< i (vecLen items)) (strEq check.problem ""))
                { (ccValue check (vecGet items i) (+ depth 1))
                  (set i (+ i 1)) }) 0 }))
        ((CObject members)
          (let ((mut i 0))
            { (while (&& (< i (vecLen members)) (strEq check.problem ""))
                (let ((member (vecGet members i)))
                  { (ccString check member.key)
                    (ccValue check member.value (+ depth 1))
                    (set i (+ i 1)) })) 0 })))
      0)
    0
  })

(struct CerealWriter
  (limits : CerealLimits)
  (pieces : (Vec String))
  (mut size : Int)
  (mut problem : String))

(:: cwText (-> CerealWriter String Int))
(fn (cwText writer text)
  {
    (if (strEq writer.problem "")
      (if (> (strLen text) (- writer.limits.bytes writer.size))
        { (set writer.problem "encoded byte limit exceeded") 0 }
        { (vecPush writer.pieces text)
          (set writer.size (+ writer.size (strLen text))) 0 })
      0)
    0
  })

(:: cwQuote (-> CerealWriter String Int))
(fn (cwQuote writer text)
  {
    (if (> (+ 2 (jsonEscapeLen text)) (- writer.limits.bytes writer.size))
      { (set writer.problem "encoded byte limit exceeded") 0 }
      { (cwText writer "\"")
        (cwText writer (jsonEscape text))
        (cwText writer "\"") })
    0
  })

(:: cjWrite (-> CerealValue CerealWriter Int Int))
(fn (cjWrite value writer depth)
  (if (! (strEq writer.problem ""))
    0
    (match value
      ((CNull) (cwText writer "null"))
      ((CBool b) (cwText writer (if b "true" "false")))
      ((CInt n) (cwText writer (fmtInt n)))
      ((CNumber text) (cwText writer text))
      ((CText text) (cwQuote writer text))
      ((CArray items)
        { (cwText writer "[")
          (for i in 0..(vecLen items)
            { (if (> i 0) (cwText writer ",") 0)
              (cjWrite (vecGet items i) writer (+ depth 1)) })
          (cwText writer "]") })
      ((CObject members)
        { (cwText writer "{")
          (for i in 0..(vecLen members)
            (let ((member (vecGet members i)))
              { (if (> i 0) (cwText writer ",") 0)
                (cwQuote writer member.key)
                (cwText writer ":")
                (cjWrite member.value writer (+ depth 1)) }))
          (cwText writer "}") }))))


; The typed JSON path shares the established string grammar, but builds
; CerealValue directly. Its local cursor is a tracked struct, and no legacy
; Int tree survives a typed decode.

(:: cjFail (-> CjCursor CerealCheck String Int))
(fn (cjFail cursor check message)
  { (set cursor.bad 1)
    (if (strEq check.problem "") { (set check.problem message) 0 } 0) 0 })

(:: cjSkip (-> String CjCursor Int))
(fn (cjSkip source cursor)
  { (while (&& (< cursor.pos (strLen source)) (strIsSpace (strByte source cursor.pos)))
      (set cursor.pos (+ cursor.pos 1))) 0 })

(:: cjPeek (-> String CjCursor Int))
(fn (cjPeek source cursor)
  (if (< cursor.pos (strLen source)) (strByte source cursor.pos) (- 0 1)))

(:: cjString (-> String CjCursor CerealCheck String))
(fn (cjString source cursor check)
  (let ((text (jpString source cursor)))
    (if (!= cursor.bad 0)
      { (cjFail cursor check "malformed JSON string") "" }
      (strDup text))))

(:: cjLiteral (-> String CjCursor CerealCheck String CerealValue CerealValue))
(fn (cjLiteral source cursor check word value)
  (if (jpMatches source cursor.pos word 0)
    { (set cursor.pos (+ cursor.pos (strLen word))) value }
    { (cjFail cursor check "invalid JSON literal") CNull }))

(:: cjTypedNumber (-> String CjCursor CerealCheck CerealValue))
(fn (cjTypedNumber source cursor check)
  (let ((start cursor.pos))
    { (while (&& (< cursor.pos (strLen source))
          (&& (! (strIsSpace (cjPeek source cursor)))
            (&& (!= (cjPeek source cursor) 44)
              (&& (!= (cjPeek source cursor) 93) (!= (cjPeek source cursor) 125)))))
        (set cursor.pos (+ cursor.pos 1)))
      (match (cerealNumberValue (strDup (strSlice source start (- cursor.pos start))))
        ((Ok value) value)
        ((Err e) { (cjFail cursor check "invalid JSON number") CNull })) }))

(:: cjTypedValue (-> String CjCursor CerealCheck Int CerealValue))
(fn (cjTypedValue source cursor check depth)
  { (cjSkip source cursor) (ccVisit check depth)
    (if (|| (!= cursor.bad 0) (! (strEq check.problem "")))
      CNull
      (let ((b (cjPeek source cursor)))
        (if (== b 123) (cjTypedObject source cursor check depth)
          (if (== b 91) (cjTypedArray source cursor check depth)
            (if (== b 34) (CText (cjString source cursor check))
              (if (== b 116) (cjLiteral source cursor check "true" (CBool true))
                (if (== b 102) (cjLiteral source cursor check "false" (CBool false))
                  (if (== b 110) (cjLiteral source cursor check "null" CNull)
                    (if (|| (== b 45) (&& (>= b 48) (<= b 57)))
                      (cjTypedNumber source cursor check)
                      { (cjFail cursor check "expected a JSON value") CNull }))))))))) })

(:: cjTypedArray (-> String CjCursor CerealCheck Int CerealValue))
(fn (cjTypedArray source cursor check depth)
  (let ((items vecNew) (mut done false))
    { (set cursor.pos (+ cursor.pos 1)) (cjSkip source cursor)
      (if (== (cjPeek source cursor) 93)
        { (set cursor.pos (+ cursor.pos 1)) (set done true) 0 } 0)
      (while (&& (! done) (&& (== cursor.bad 0) (strEq check.problem "")))
        { (vecPush items (cjTypedValue source cursor check (+ depth 1)))
          (cjSkip source cursor)
          (if (== (cjPeek source cursor) 93)
            { (set cursor.pos (+ cursor.pos 1)) (set done true) 0 }
            (if (== (cjPeek source cursor) 44)
              { (set cursor.pos (+ cursor.pos 1)) 0 }
              (cjFail cursor check "expected comma or closing JSON bracket"))) })
      (CArray items) }))

(:: cjTypedObject (-> String CjCursor CerealCheck Int CerealValue))
(fn (cjTypedObject source cursor check depth)
  (let ((members vecNew) (mut done false))
    { (set cursor.pos (+ cursor.pos 1)) (cjSkip source cursor)
      (if (== (cjPeek source cursor) 125)
        { (set cursor.pos (+ cursor.pos 1)) (set done true) 0 } 0)
      (while (&& (! done) (&& (== cursor.bad 0) (strEq check.problem "")))
        { (cjSkip source cursor)
          (let ((key (cjString source cursor check)))
            { (cjSkip source cursor)
              (if (!= (cjPeek source cursor) 58) (cjFail cursor check "expected colon after JSON key")
                { (set cursor.pos (+ cursor.pos 1)) 0 })
              (let ((value (cjTypedValue source cursor check (+ depth 1))))
                (vecPush members (CerealMember key value))) })
          (cjSkip source cursor)
          (if (== (cjPeek source cursor) 125)
            { (set cursor.pos (+ cursor.pos 1)) (set done true) 0 }
            (if (== (cjPeek source cursor) 44)
              { (set cursor.pos (+ cursor.pos 1)) 0 }
              (cjFail cursor check "expected comma or closing JSON brace"))) })
      (CObject members) }))

(:: cjDecode (-> String CerealLimits (Result CerealValue Error)))
(fn (cjDecode source limits)
  (let ((cursor (CjCursor 0 0)) (check (CerealCheck limits 0 "")))
    (let ((value (cjTypedValue source cursor check 0)))
      { (cjSkip source cursor)
        (if (&& (== cursor.bad 0) (&& (strEq check.problem "") (== cursor.pos (strLen source))))
          (Ok value)
          (cerealError (if (strEq check.problem "") "unexpected text after JSON value" check.problem))) })))

; TOML 1.0 subset: single-line basic/literal strings, booleans, signed
; decimal integers/floats, arrays, inline tables, dotted keys and tables.
; Duplicate definitions, malformed numbers, datetime values, non-finite
; floats, multiline strings and array tables are refused. The writer
; uses quoted keys and inline tables; TOML has no null value.
(struct CtParser
  (source : String)
  (limits : CerealLimits)
  (mut pos : Int)
  (mut nodes : Int)
  (mut problem : String))

(:: ctFail (-> CtParser String Int))
(fn (ctFail parser message)
  { (if (strEq parser.problem "") { (set parser.problem message) 0 } 0) 0 })

(:: ctSkip (-> CtParser Int))
(fn (ctSkip parser)
  { (while (&& (< parser.pos (strLen parser.source))
        (|| (== (strByte parser.source parser.pos) 32)
          (== (strByte parser.source parser.pos) 9)))
      (set parser.pos (+ parser.pos 1))) 0 })

(:: ctPeek (-> CtParser Int))
(fn (ctPeek parser)
  (if (< parser.pos (strLen parser.source))
    (strByte parser.source parser.pos) (- 0 1)))

(:: ctBareKey (-> Int Bool))
(fn (ctBareKey b)
  (|| (&& (>= b 65) (<= b 90))
    (|| (&& (>= b 97) (<= b 122))
      (|| (&& (>= b 48) (<= b 57)) (|| (== b 95) (== b 45))))))

(:: ctString (-> CtParser String))
(fn (ctString parser)
  (let ((quote (ctPeek parser))
        (start parser.pos) (mut escaped false) (mut closed false))
    {
      (set parser.pos (+ parser.pos 1))
      (while (&& (< parser.pos (strLen parser.source)) (! closed))
        (let ((b (ctPeek parser)))
          {
            (if (&& (! escaped) (== b quote))
              { (set closed true) 0 }
              (if (&& (== quote 34) (&& (! escaped) (== b 92)))
                { (set escaped true) 0 }
                { (set escaped false) 0 }))
            (set parser.pos (+ parser.pos 1))
          }))
      (if (! closed)
        { (ctFail parser "unterminated TOML string") "" }
        (let ((raw (strSlice parser.source start (- parser.pos start))))
          (if (== quote 39)
            (let ((mut i 1) (mut bad false))
              { (while (< i (- (strLen raw) 1))
                  { (if (|| (&& (< (strByte raw i) 32) (!= (strByte raw i) 9)) (== (strByte raw i) 127)) { (set bad true) 0 } 0)
                    (set i (+ i 1)) })
                (if bad { (ctFail parser "control character in TOML literal string") "" }
                  (strDup (strSlice raw 1 (- (strLen raw) 2)))) })
            (let ((decoded (jsonParse raw)))
              (if (|| (== decoded 0) (!= (jsonTag decoded) JSTR))
                { (ctFail parser "unsupported or malformed TOML string escape") "" }
                (let ((mut i 1) (mut bad false))
                  {
                    ; TOML does not admit JSON's escaped slash or lone
                    ; surrogate replacement, nor a raw DEL character.
                    (while (&& (< i (- (strLen raw) 1)) (! bad))
                      (let ((b (strByte raw i)))
                        {
                          (if (== b 127) { (set bad true) 0 } 0)
                          (if (== b 92)
                            (let ((next (strByte raw (+ i 1))))
                              { (if (|| (== next 47) (== next 85)) { (set bad true) 0 } 0)
                                (if (== next 117)
                                  (let ((hex (jpHexDigits raw (+ i 2))))
                                    (match hex
                                      ((None) { (set bad true) 0 })
                                      ((Some code)
                                        (if (&& (>= code 55296) (<= code 57343))
                                          { (set bad true) 0 } 0)))) 0)
                                (set i (+ i (if (== next 117) 6 2))) })
                            { (set i (+ i 1)) 0 })
                        }))
                    (if bad
                      { (ctFail parser "unsupported TOML escape or invalid Unicode scalar") "" }
                      (strDup (jsonStrVal decoded)))
                  }))))))
    }))

(:: ctKeyPart (-> CtParser String))
(fn (ctKeyPart parser)
  { (ctSkip parser)
    (if (|| (== (ctPeek parser) 34) (== (ctPeek parser) 39))
      (ctString parser)
      (let ((start parser.pos))
        { (while (&& (< parser.pos (strLen parser.source)) (ctBareKey (ctPeek parser)))
            (set parser.pos (+ parser.pos 1)))
          (if (== parser.pos start) (ctFail parser "expected a TOML key") 0)
          (strDup (strSlice parser.source start (- parser.pos start))) })) })

(:: ctKeyPath (-> CtParser (Vec String)))
(fn (ctKeyPath parser)
  (let ((parts vecNew) (mut done false))
    { (vecPush parts (ctKeyPart parser))
      (while (&& (! done) (strEq parser.problem ""))
        { (ctSkip parser)
          (if (== (ctPeek parser) 46)
            { (set parser.pos (+ parser.pos 1))
              (if (>= (vecLen parts) parser.limits.depth)
                (ctFail parser "TOML key path nesting limit exceeded")
                { (vecPush parts (ctKeyPart parser)) 0 }) 0 }
            { (set done true) 0 }) })
      parts }))

(:: ctPut (-> CerealValue (Vec String) Int CerealValue (Result Int Error)))
(fn (ctPut object path i value)
  (if (>= i (vecLen path))
    (cerealError "empty TOML key path")
    (match object
      ((CObject members)
        (let ((key (vecGet path i)))
          (match (cerealMemberGet members key 0)
            ((None)
              (if (== (+ i 1) (vecLen path))
                { (vecPush members (CerealMember key value)) (Ok 0) }
                (let ((child (CObject vecNew)))
                  { (vecPush members (CerealMember key child))
                    (ctPut child path (+ i 1) value) })))
            ((Some prior)
              (if (== (+ i 1) (vecLen path))
                (cerealError "duplicate TOML key")
                (ctPut prior path (+ i 1) value))))))
      (_ (cerealError "TOML key extends a scalar or array")))))

(:: ctTable (-> CerealValue (Vec String) Int (Result CerealValue Error)))
(fn (ctTable object path i)
  (if (>= i (vecLen path))
    (Ok object)
    (match object
      ((CObject members)
        (let ((key (vecGet path i)))
          (match (cerealMemberGet members key 0)
            ((None)
              (let ((child (CObject vecNew)))
                { (vecPush members (CerealMember key child)) (ctTable child path (+ i 1)) }))
            ((Some child)
              (match child
                ((CObject entries) (ctTable child path (+ i 1)))
                (_ (cerealError "TOML table conflicts with an existing value")))))))
      (_ (cerealError "expected a TOML table")))))

(:: ctIntegerText (-> String Bool))
(fn (ctIntegerText text)
  (let ((mut i (if (== (strByte text 0) 45) 1 0)) (mut integer true))
    { (while (< i (strLen text))
        { (if (! (strIsDigit (strByte text i))) { (set integer false) 0 } 0)
          (set i (+ i 1)) }) integer }))

(:: ctNumber (-> CtParser String CerealValue))
(fn (ctNumber parser raw)
  (let ((pieces vecNew) (mut valid true) (mut i 0))
    { (while (< i (strLen raw))
        (let ((b (strByte raw i)))
          { (if (== b 95)
              (if (! (&& (strIsDigit (strByte raw (- i 1))) (strIsDigit (strByte raw (+ i 1)))))
                { (set valid false) 0 } 0)
              { (vecPush pieces (strSlice raw i 1)) 0 })
            (set i (+ i 1)) }))
      (let ((joined (jsonJoin pieces))
            (text (if (strStartsWith joined "+") (strSlice joined 1 (- (strLen joined) 1)) joined)))
        (if (! valid) { (ctFail parser "invalid underscore in TOML number") CNull }
          (match (cerealNumberValue text)
            ((Ok value)
              (if (ctIntegerText text)
                (match value
                  ((CInt n) value)
                  (_ { (ctFail parser "TOML integer is outside Int range") CNull }))
                value))
            ((Err error) { (ctFail parser "unsupported or malformed TOML number") CNull })))) }))

(:: ctValue (-> CtParser Int CerealValue))
(fn (ctValue parser depth)
  { (ctSkip parser)
    (if (> depth parser.limits.depth) (ctFail parser "TOML nesting limit exceeded") 0)
    (if (>= parser.nodes parser.limits.nodes) (ctFail parser "TOML node limit exceeded") 0)
    (set parser.nodes (+ parser.nodes 1))
    (if (! (strEq parser.problem ""))
      CNull
      (let ((b (ctPeek parser)))
        (if (|| (== b 34) (== b 39)) (CText (ctString parser))
          (if (== b 91) (ctArray parser depth)
            (if (== b 123) (ctInline parser depth)
              (let ((start parser.pos))
                { (while (&& (< parser.pos (strLen parser.source))
                      (&& (! (strIsSpace (ctPeek parser)))
                        (&& (!= (ctPeek parser) 44)
                          (&& (!= (ctPeek parser) 93) (!= (ctPeek parser) 125)))))
                    (set parser.pos (+ parser.pos 1)))
                  (let ((word (strSlice parser.source start (- parser.pos start))))
                    (if (strEq word "true") (CBool true)
                      (if (strEq word "false") (CBool false)
                        (ctNumber parser word)))) })))))) })

(:: ctArray (-> CtParser Int CerealValue))
(fn (ctArray parser depth)
  (let ((items vecNew) (mut done false))
    { (set parser.pos (+ parser.pos 1))
      (ctSkip parser)
      (if (== (ctPeek parser) 93)
        { (set done true) (set parser.pos (+ parser.pos 1)) 0 } 0)
      (while (&& (! done) (strEq parser.problem ""))
        { (vecPush items (ctValue parser (+ depth 1)))
          (ctSkip parser)
          (if (== (ctPeek parser) 93)
            { (set done true) (set parser.pos (+ parser.pos 1)) 0 }
            (if (== (ctPeek parser) 44)
              { (set parser.pos (+ parser.pos 1)) (ctSkip parser)
                (if (== (ctPeek parser) 93)
                  { (set done true) (set parser.pos (+ parser.pos 1)) 0 } 0) }
              (ctFail parser "expected comma or closing bracket in TOML array"))) })
      (CArray items) }))

(:: ctInline (-> CtParser Int CerealValue))
(fn (ctInline parser depth)
  (let ((object (CObject vecNew)) (closed vecNew) (mut done false))
    { (set parser.pos (+ parser.pos 1)) (ctSkip parser)
      (if (== (ctPeek parser) 125)
        { (set done true) (set parser.pos (+ parser.pos 1)) 0 } 0)
      (while (&& (! done) (strEq parser.problem ""))
        (let ((path (ctKeyPath parser)))
          { (if (!= (ctPeek parser) 61) (ctFail parser "expected equals in TOML inline table")
              { (set parser.pos (+ parser.pos 1)) 0 })
            (let ((value (ctValue parser (+ depth 1))))
              (if (ctClosedPrefix closed path) (ctFail parser "TOML inline value extends a closed definition") 0)
              (if (strEq parser.problem "")
                (match (ctPut object path 0 value)
                  ((Ok n) { (vecPush closed (ctPathKey path)) 0 })
                  ((Err e) (ctFail parser e.message))) 0))
            (ctSkip parser)
            (if (== (ctPeek parser) 125)
              { (set done true) (set parser.pos (+ parser.pos 1)) 0 }
              (if (== (ctPeek parser) 44)
                { (set parser.pos (+ parser.pos 1)) (ctSkip parser)
                  (if (== (ctPeek parser) 125) (ctFail parser "TOML inline table has a trailing comma") 0) }
                (ctFail parser "expected comma or closing brace in TOML inline table"))) }))
      object }))

(:: ctStripComment (-> String String))
(fn (ctStripComment line)
  (let ((mut i 0) (mut quote 0) (mut escaped false) (mut end (strLen line)))
    { (while (< i end)
        (let ((b (strByte line i)))
          { (if (== quote 0)
              (if (== b 35) { (set end i) 0 }
                (if (|| (== b 34) (== b 39)) { (set quote b) 0 } 0))
              (if (&& (! escaped) (== b quote)) { (set quote 0) 0 } 0))
            (if (&& (== quote 34) (&& (! escaped) (== b 92)))
              { (set escaped true) 0 } { (set escaped false) 0 })
            (set i (+ i 1)) }))
      (strTrim (strSlice line 0 end)) }))

(:: ctPathKey (-> (Vec String) String))
(fn (ctPathKey path)
  (let ((pieces vecNew))
    { (for i in 0..(vecLen path)
        { (vecPush pieces "\"") (vecPush pieces (jsonEscape (vecGet path i))) (vecPush pieces "\"/") })
      (jsonJoin pieces) }))

(:: ctPathPrefix (-> (Vec String) Int (Vec String)))
(fn (ctPathPrefix path count)
  (let ((out vecNew))
    { (for i in 0..count (vecPush out (vecGet path i))) out }))

(:: ctClosedPrefix (-> (Vec String) (Vec String) Bool))
(fn (ctClosedPrefix closed path)
  (let ((mut i 1) (mut found false))
    { (while (&& (<= i (vecLen path)) (! found))
        { (if (>= (cerealStringIndex closed (ctPathKey (ctPathPrefix path i)) 0) 0)
            { (set found true) 0 } 0)
          (set i (+ i 1)) }) found }))

(:: ctDecode (-> String CerealLimits (Result CerealValue Error)))
(fn (ctDecode source limits)
  (let ((root (CObject vecNew)) (lines (strSplit source 10))
        (declared vecNew) (closed vecNew) (mut table vecNew)
        (mut problem "") (mut nodes 1) (mut i 0))
    { (while (&& (< i (vecLen lines)) (strEq problem ""))
        (let ((line (ctStripComment (vecGet lines i))))
          { (if (> (strLen line) 0)
              (let ((parser (CtParser line limits 0 nodes "")))
                { (if (== (ctPeek parser) 91)
                    { (set parser.pos 1)
                      (if (== (ctPeek parser) 91) (ctFail parser "TOML array tables are not supported") 0)
                      (let ((path (ctKeyPath parser)))
                        { (ctSkip parser)
                          (if (!= (ctPeek parser) 93) (ctFail parser "invalid TOML table header")
                            { (set parser.pos (+ parser.pos 1)) 0 })
                          (ctSkip parser)
                          (if (!= parser.pos (strLen line)) (ctFail parser "unexpected text after TOML table header") 0)
                          (if (|| (>= (cerealStringIndex declared (ctPathKey path) 0) 0) (ctClosedPrefix closed path))
                            (ctFail parser "duplicate or closed TOML table") 0)
                          (if (strEq parser.problem "")
                            (match (ctTable root path 0)
                              ((Ok object) { (set table path) (vecPush declared (ctPathKey path)) 0 })
                              ((Err e) (ctFail parser e.message))) 0) }) }
                    (let ((path (ctKeyPath parser)))
                      { (if (!= (ctPeek parser) 61) (ctFail parser "expected equals after TOML key")
                          { (set parser.pos (+ parser.pos 1)) 0 })
                        (let ((value (ctValue parser 1)))
                          { (ctSkip parser)
                            (if (!= parser.pos (strLen line)) (ctFail parser "unexpected text after TOML value") 0)
                            (let ((full vecNew))
                              { (for j in 0..(vecLen table) (vecPush full (vecGet table j)))
                                (for j in 0..(vecLen path) (vecPush full (vecGet path j)))
                                (if (> (vecLen full) limits.depth) (ctFail parser "TOML key path nesting limit exceeded") 0)
                                (if (ctClosedPrefix closed full) (ctFail parser "TOML value extends a closed definition") 0)
                                (if (strEq parser.problem "")
                                  (match (ctPut root full 0 value)
                                    ((Ok n) { (vecPush closed (ctPathKey full))
                                      (for k in 1..(vecLen full)
                                        (let ((prefix (ctPathKey (ctPathPrefix full k))))
                                          (if (< (cerealStringIndex declared prefix 0) 0) (vecPush declared prefix) declared))) 0 })
                                    ((Err e) (ctFail parser e.message))) 0) }) }) }))
                  (set nodes parser.nodes)
                  (if (! (strEq parser.problem "")) { (set problem parser.problem) 0 } 0) }) 0)
            (set i (+ i 1)) }))
      (if (strEq problem "") (Ok root) (cerealError problem)) }))

(:: ctValidSource (-> String Bool))
(fn (ctValidSource source)
  (let ((mut i 0) (mut valid true))
    { (while (&& valid (< i (strLen source)))
        (let ((b (strByte source i)))
          { (if (|| (|| (== b 127) (&& (< b 32) (! (|| (== b 9) (|| (== b 10) (== b 13))))))
                (&& (== b 13) (!= (strByte source (+ i 1)) 10)))
              { (set valid false) 0 } 0)
            (set i (+ i 1)) })) valid }))

; TOML also requires DEL to be escaped. Size the entire quoted value
; before allocating any escaped substring.
(:: cwTomlQuote (-> CerealWriter String Int))
(fn (cwTomlQuote writer text)
  (let ((mut count 0) (mut i 0) (mut start 0))
    { (for k in 0..(strLen text)
        (if (== (strByte text k) 127) (set count (+ count 1)) 0))
      (if (> (+ 2 (+ (jsonEscapeLen text) (* count 5))) (- writer.limits.bytes writer.size))
        { (set writer.problem "encoded byte limit exceeded") 0 }
        { (cwText writer "\"")
          (while (< i (strLen text))
            { (if (== (strByte text i) 127)
                { (cwText writer (jsonEscape (strSlice text start (- i start))))
                  (cwText writer "\\u007f") (set start (+ i 1)) } 0)
              (set i (+ i 1)) })
          (cwText writer (jsonEscape (strSlice text start (- i start))))
          (cwText writer "\"") }) 0 }))

(:: ctWriteValue (-> CerealValue CerealWriter Int Int))
(fn (ctWriteValue value writer depth)
  (match value
    ((CNull) { (set writer.problem "TOML cannot encode null") 0 })
    ((CBool b) (cwText writer (if b "true" "false")))
    ((CInt n) (cwText writer (fmtInt n)))
    ((CNumber n)
      (if (ctIntegerText n)
        (match (strParseInt n)
          ((Some number) (cwText writer n))
          ((None) { (set writer.problem "TOML integer is outside Int range") 0 }))
        (cwText writer n)))
    ((CText text) (cwTomlQuote writer text))
    ((CArray items)
      { (cwText writer "[")
        (for i in 0..(vecLen items)
          { (if (> i 0) (cwText writer ", ") 0)
            (ctWriteValue (vecGet items i) writer (+ depth 1)) })
        (cwText writer "]") })
    ((CObject members)
      { (cwText writer "{")
        (for i in 0..(vecLen members)
          (let ((member (vecGet members i)))
            { (if (> i 0) (cwText writer ", ") 0)
              (cwTomlQuote writer member.key) (cwText writer " = ")
              (ctWriteValue member.value writer (+ depth 1)) }))
        (cwText writer "}") })))

(:: ctWrite (-> CerealValue CerealWriter Int Int))
(fn (ctWrite value writer depth)
  (match value
    ((CObject members)
      { (for i in 0..(vecLen members)
          (let ((member (vecGet members i)))
            { (cwTomlQuote writer member.key) (cwText writer " = ")
              (ctWriteValue member.value writer (+ depth 1))
              (cwText writer "\n") })) 0 })
    (_ { (set writer.problem "TOML requires a dictionary document root") 0 })))

(:: cerealStringIndex (-> (Vec String) String Int Int))
(fn (cerealStringIndex items wanted i)
  (if (>= i (vecLen items)) (- 0 1)
    (if (strEq (vecGet items i) wanted) i
      (cerealStringIndex items wanted (+ i 1)))))

(pub :: cerealEncodeWith (-> CerealFormat CerealLimits CerealValue (Result String Error)))
(pub fn (cerealEncodeWith format limits value)
  (if (! (cerealLimitsValid limits))
    (cerealError "limits require depth 1..64, bytes 1..16777216 and nodes 1..1000000")
    (let ((check (CerealCheck limits 0 "")))
      { (ccValue check value 0)
        (if (! (strEq check.problem ""))
          (cerealError check.problem)
          (let ((writer (CerealWriter limits vecNew 0 "")))
            { (match format
                ((CerealJson) (cjWrite value writer 0))
                ((CerealToml) (if (cyUniqueKeys value) (ctWrite value writer 0) { (set writer.problem "duplicate dictionary key in TOML output") 0 }))
                ((CerealYaml) (if (cyUniqueKeys value) (cyWrite value writer 0) { (set writer.problem "duplicate dictionary key in YAML output") 0 })))
              (if (strEq writer.problem "")
                (Ok (jsonJoin writer.pieces))
                (cerealError writer.problem)) })) })))

(pub :: cerealEncode (-> CerealFormat CerealValue (Result String Error)))
(pub fn (cerealEncode format value)
  (cerealEncodeWith format cerealLimits value))

(pub :: cerealDecodeWith (-> CerealFormat CerealLimits String (Result CerealValue Error)))
(pub fn (cerealDecodeWith format limits source)
  (if (! (cerealLimitsValid limits))
    (cerealError "limits require depth 1..64, bytes 1..16777216 and nodes 1..1000000")
    (if (> (strLen source) limits.bytes)
      (cerealError "input byte limit exceeded")
      (if (! (cerealValidUtf8 source))
        (cerealError "invalid UTF-8 input")
        (let ((parsed (match format
          ((CerealJson) (cjDecode source limits))
          ((CerealToml) (if (ctValidSource source) (ctDecode source limits) (cerealError "control character or lone CR in TOML input")))
          ((CerealYaml) (cyDecode source limits)))))
          (match parsed
            ((Err e) (Err e))
            ((Ok value)
              (let ((check (CerealCheck limits 0 "")))
                { (ccValue check value 0)
                  (if (strEq check.problem "") (Ok value) (cerealError check.problem)) }))))))))

(pub :: cerealDecode (-> CerealFormat String (Result CerealValue Error)))
(pub fn (cerealDecode format source)
  (cerealDecodeWith format cerealLimits source))

(pub :: cerealSerialize (-> CerealFormat (Codec a) a (Result String Error)))
(pub fn (cerealSerialize format codec value)
  (match (cerealToValue codec value)
    ((Err e) (Err e))
    ((Ok tree) (cerealEncode format tree))))

(pub :: cerealDeserialize (-> CerealFormat (Codec a) String (Result a Error)))
(pub fn (cerealDeserialize format codec source)
  (match (cerealDecode format source)
    ((Err e) (Err e))
    ((Ok tree) (cerealFromValue codec tree))))
; YAML 1.2 subset, following https://yaml.org/spec/1.2.2/.
; Documents use LF or CRLF, space-indented mappings and sequences,
; string keys, single-line plain/single-quoted/JSON-quoted scalars,
; comments and JSON-compatible flow collections. Compact `- key: value`
; mappings and `- - value` sequences use one space after each dash.
; One optional opening `---` and closing `...` marker is accepted.
; Plain null/Null/NULL/~ and true/false in their core-schema spellings
; resolve as values; yes/no/on/off remain strings. Numbers use JSON's
; finite decimal grammar. Other numeric spellings, multiline scalars,
; anchors, aliases, tags, merge keys, directives, complex keys and
; multiple documents return Error. Nested flow collections stay on one
; physical line; an entire JSON flow document may span several lines.
; Encoding uses canonical JSON flow notation, which is valid YAML 1.2.

(struct CYLine (indent : Int) (text : String))
(struct CYState
  (lines : (Vec CYLine))
  (check : CerealCheck)
  (mut at : Int))

(:: cySpace (-> Int Bool))
(fn (cySpace b) (|| (== b 32) (== b 9)))

; Locate a block colon or comment outside quoted/flow content. A block
; colon requires following whitespace, so URLs remain plain strings.
(:: cyQuoteStart (-> String Int Bool))
(fn (cyQuoteStart text at)
  (let ((mut i (- at 1)))
    { (while (&& (>= i 0) (cySpace (strByte text i))) (set i (- i 1)))
      (|| (< i 0) (|| (== (strByte text i) 58)
        (&& (== i 0) (== (strByte text i) 45)))) }))

(:: cyScan (-> String Bool Int))
(fn (cyScan text comment)
  (let ((mut i 0) (mut quote 0) (mut flow 0) (mut found (- 0 1)))
    {
      (while (&& (< i (strLen text)) (< found 0))
        (let ((b (strByte text i)))
          {
            (if (== quote 34)
              (if (== b 92) (set i (+ i 1))
                (if (== b 34) (set quote 0) 0))
              (if (== quote 39)
                (if (== b 39)
                  (if (== (strByte text (+ i 1)) 39) (set i (+ i 1)) (set quote 0))
                  0)
                (if (&& (|| (== b 34) (== b 39)) (|| (> flow 0) (cyQuoteStart text i))) (set quote b)
                  (if (&& comment (&& (== b 35)
                      (|| (== i 0) (cySpace (strByte text (- i 1))))))
                    (set found i)
                    (if (|| (== b 91) (== b 123)) (set flow (+ flow 1))
                      (if (|| (== b 93) (== b 125)) (set flow (- flow 1))
                        (if (&& (! comment) (&& (== flow 0) (&& (== b 58)
                            (|| (== (+ i 1) (strLen text)) (cySpace (strByte text (+ i 1)))))))
                          (set found i) 0)))))))
            (set i (+ i 1))
          }))
      found
    }))

(:: cyDash (-> String Bool))
(fn (cyDash text)
  (&& (== (strByte text 0) 45)
    (|| (== (strLen text) 1) (cySpace (strByte text 1)))))

(:: cyAddLine (-> (Vec CYLine) Int String Int))
(fn (cyAddLine lines indent text)
  (let ((mut current text) (mut col indent) (mut done false) (mut bad 0))
    { (while (! done)
        (if (&& (cyDash current) (> (strLen current) 2))
          (let ((rest (strTrim (strSlice current 2 (- (strLen current) 2)))))
            (if (|| (cyDash rest) (>= (cyScan rest false) 0))
              (if (|| (!= (strByte current 1) 32) (cySpace (strByte current 2)))
                { (set bad 1) (set done true) 0 }
                { (vecPush lines (CYLine col "-"))
                  (set current rest) (set col (+ col 2)) })
              { (vecPush lines (CYLine col current)) (set done true) 0 }))
          { (vecPush lines (CYLine col current)) (set done true) 0 }))
      bad }))

(:: cyLines (-> String (Result (Vec CYLine) Error)))
(fn (cyLines source)
  (let ((raw (strSplit source 10)) (lines vecNew) (mut problem "")
        (mut opened false) (mut ended false) (mut i 0))
    {
      (while (&& (< i (vecLen raw)) (strEq problem ""))
        (let ((line (vecGet raw i)) (mut start 0) (mut end (strLen line)))
          {
            (if (&& (== i 0) (&& (>= end 3) (&& (== (strByte line 0) 239)
                (&& (== (strByte line 1) 187) (== (strByte line 2) 191)))))
              (set start 3) 0)
            (if (&& (> end start) (== (strByte line (- end 1)) 13)) (set end (- end 1)) 0)
            (let ((mut n start) (mut col 0) (mut j start))
              {
                (while (&& (< n end) (== (strByte line n) 32))
                  { (set n (+ n 1)) (set col (+ col 1)) })
                (if (&& (< n end) (== (strByte line n) 9)) { (set problem "tabs cannot indent YAML") 0 } 0)
                (while (< j end)
                  { (if (|| (&& (< (strByte line j) 32) (!= (strByte line j) 9))
                        (== (strByte line j) 127))
                      { (set problem "non-printable YAML character") 0 } 0)
                    (set j (+ j 1)) })
                (let ((content (strSlice line n (- end n))) (cut (cyScan content true)))
                  (let ((text (strTrim (if (< cut 0) content (strSlice content 0 cut)))))
                    (if (== (strLen text) 0) 0
                      (if ended { (set problem "content after YAML document end") 0 }
                        (if (&& (== col 0) (strEq text "---"))
                          (if (|| opened (> (vecLen lines) 0)) { (set problem "multiple YAML documents are unsupported") 0 }
                            { (set opened true) 0 })
                          (if (&& (== col 0) (strEq text "...")) { (set ended true) 0 }
                            (if (|| (== (strByte text 0) 37) (&& (== col 0) (|| (strStartsWith text "--- ") (strStartsWith text "... ")))) { (set problem "YAML directives or inline document markers are unsupported") 0 }
                              (if (!= (cyAddLine lines col text) 0)
                                { (set problem "compact YAML collections require one space after the dash") 0 } 0))))))))
                0
              })
            (set i (+ i 1))
          }))
      (if (strEq problem "") (Ok lines) (cerealError problem))
    }))

(:: cySingle (-> String (Result String Error)))
(fn (cySingle text)
  (let ((pieces vecNew) (mut i 1) (mut start 1) (mut closed false) (mut problem ""))
    {
      (while (&& (< i (strLen text)) (! closed))
        (if (== (strByte text i) 39)
          { (vecPush pieces (strSlice text start (- i start)))
            (if (== (strByte text (+ i 1)) 39)
              { (vecPush pieces "'") (set i (+ i 2)) (set start i) }
              { (set closed true) (set i (+ i 1)) }) }
          (set i (+ i 1))))
      (if (|| (! closed) (!= i (strLen text)))
        (cerealError "invalid or multiline single-quoted YAML scalar")
        (Ok (jsonJoin pieces)))
    }))

(:: cyNumericExtension (-> String Bool))
(fn (cyNumericExtension text)
  (let ((lower (strLower text))
        (at (if (|| (== (strByte text 0) 45) (== (strByte text 0) 43)) 1 0)))
    (|| (|| (strEq lower ".nan") (|| (strEq lower ".inf") (|| (strEq lower "-.inf") (strEq lower "+.inf"))))
      (|| (strStartsWith (strSlice lower at (- (strLen lower) at)) "0x")
        (|| (strStartsWith (strSlice lower at (- (strLen lower) at)) "0o")
          (|| (&& (== (strByte text 0) 43) (strIsDigit (strByte text 1)))
            (|| (&& (== (strByte text at) 46) (strIsDigit (strByte text (+ at 1))))
              (&& (== (strByte text at) 48) (strIsDigit (strByte text (+ at 1)))))))))))

(:: cyFiniteNumber (-> String Bool))
(fn (cyFiniteNumber text)
  (let ((mut i (if (|| (== (strByte text 0) 43) (== (strByte text 0) 45)) 1 0))
        (mut digits 0) (mut exponent false) (mut expDigits 0))
    { (while (&& (< i (strLen text)) (strIsDigit (strByte text i)))
        { (set digits (+ digits 1)) (set i (+ i 1)) })
      (if (== (strByte text i) 46)
        { (set i (+ i 1))
          (while (&& (< i (strLen text)) (strIsDigit (strByte text i)))
            { (set digits (+ digits 1)) (set i (+ i 1)) }) 0 } 0)
      (if (|| (== (strByte text i) 101) (== (strByte text i) 69))
        { (set exponent true) (set i (+ i 1))
          (if (|| (== (strByte text i) 43) (== (strByte text i) 45)) (set i (+ i 1)) 0)
          (while (&& (< i (strLen text)) (strIsDigit (strByte text i)))
            { (set expDigits (+ expDigits 1)) (set i (+ i 1)) }) 0 } 0)
      (&& (&& (> digits 0) (== i (strLen text))) (|| (! exponent) (> expDigits 0))) }))

(:: cyPlain (-> String (Result CerealValue Error)))
(fn (cyPlain text)
  (let ((first (strByte text 0)))
    (if (== (strLen text) 0) (Ok CNull)
      (if (|| (strEq text "null") (|| (strEq text "Null") (|| (strEq text "NULL") (strEq text "~")))) (Ok CNull)
        (if (|| (strEq text "true") (|| (strEq text "True") (strEq text "TRUE"))) (Ok (CBool true))
          (if (|| (strEq text "false") (|| (strEq text "False") (strEq text "FALSE"))) (Ok (CBool false))
            (if (|| (|| (== first 38) (== first 42)) (|| (== first 33) (|| (== first 124) (|| (== first 62)
                (|| (== first 37) (|| (== first 64) (|| (== first 96) (|| (== first 63) (|| (== first 91)
                (|| (== first 93) (|| (== first 123) (== first 125))))))))))))
              (cerealError "unsupported YAML scalar syntax")
              (if (>= (cyScan text false) 0) (cerealError "mapping colon in a plain YAML scalar")
                (if (cyNumericExtension text) (cerealError "non-JSON YAML number is unsupported")
                  (if (|| (strIsDigit first) (&& (== first 45) (strIsDigit (strByte text 1))))
                    (match (cerealNumberValue text)
                      ((Ok value) (Ok value))
                      ((Err error) (if (cyFiniteNumber text) (cerealError "non-JSON YAML number is unsupported")
                        (Ok (CText (strDup text))))))
                    (Ok (CText (strDup text)))))))))))))

(:: cerealDistinctKeys (-> (Vec CerealMember) Bool))
(fn (cerealDistinctKeys members)
  (let ((keys vecNew) (scratch vecNew) (size (vecLen members)) (mut width 1))
    { (for i in 0..size
        (let ((member (vecGet members i)))
          { (vecPush keys member.key) (vecPush scratch "") }))
      (while (< width size)
        (let ((mut start 0))
          { (while (< start size)
              (let ((middle (if (< (+ start width) size) (+ start width) size))
                    (end (if (< (+ start (* width 2)) size) (+ start (* width 2)) size))
                    (mut left start) (mut right middle) (mut at start))
                { (while (< at end)
                    { (if (|| (>= right end) (&& (< left middle) (<= (strCmp (vecGet keys left) (vecGet keys right)) 0)))
                        { (vecSet scratch at (vecGet keys left)) (set left (+ left 1)) }
                        { (vecSet scratch at (vecGet keys right)) (set right (+ right 1)) })
                      (set at (+ at 1)) })
                  (set start end) }))
            (for i in 0..size (vecSet keys i (vecGet scratch i)))
            (set width (* width 2)) }))
      (let ((mut i 1) (mut distinct true))
        { (while (&& distinct (< i size))
            { (if (strEq (vecGet keys (- i 1)) (vecGet keys i)) { (set distinct false) 0 } 0)
              (set i (+ i 1)) }) distinct }) }))

; YAML and TOML require unique dictionary keys, including nested ones.
(:: cyUniqueKeys (-> CerealValue Bool))
(fn (cyUniqueKeys value)
  (match value
    ((CArray items)
      (let ((mut i 0) (mut valid true))
        { (while (&& valid (< i (vecLen items)))
            { (set valid (cyUniqueKeys (vecGet items i))) (set i (+ i 1)) }) valid }))
    ((CObject members)
      (let ((mut i 0) (mut valid (cerealDistinctKeys members)))
        { (while (&& valid (< i (vecLen members)))
            (let ((member (vecGet members i)))
              { (set valid (cyUniqueKeys member.value)) (set i (+ i 1)) })) valid }))
    (_ true)))

(:: cyFlow (-> CYState String Int (Result CerealValue Error)))
(fn (cyFlow state text depth)
  (let ((check state.check)
        (limits (CerealLimits (- state.check.limits.depth depth)
          state.check.limits.bytes (- state.check.limits.nodes state.check.nodes))))
    (if (|| (< limits.depth 0) (< limits.nodes 1)) (cerealError "YAML resource limit exceeded")
      (match (cjDecode text limits)
        ((Err error) (Err error))
        ((Ok value)
          { (ccValue check value depth)
            (if (! (strEq check.problem "")) (cerealError check.problem)
              (if (cyUniqueKeys value) (Ok value) (cerealError "duplicate YAML mapping key"))) })))))

(:: cyScalar (-> CYState String Int (Result CerealValue Error)))
(fn (cyScalar state text depth)
  (let ((first (strByte text 0)))
    (if (|| (== first 91) (|| (== first 123) (== first 34)))
      (cyFlow state text depth)
      { (ccVisit state.check depth)
        (if (! (strEq state.check.problem "")) (cerealError state.check.problem)
          (if (== first 39)
            (match (cySingle text)
              ((Err error) (Err error))
              ((Ok value) (Ok (CText value))))
            (cyPlain text))) })))

(:: cyKey (-> String (Result String Error)))
(fn (cyKey text)
  (if (strEq text "<<") (cerealError "YAML merge keys are unsupported")
    (let ((first (strByte text 0)))
      (if (== first 39) (cySingle text)
        (if (== first 34)
          (match (cjDecode text cerealLimits)
            ((Err error) (Err error))
            ((Ok value) (match value
              ((CText key) (Ok key))
              (_ (cerealError "YAML mapping keys must be strings")))))
          (match (cyPlain text)
            ((Err error) (Err error))
            ((Ok value) (match value
              ((CText key) (Ok key))
              (_ (cerealError "YAML mapping keys must be strings"))))))))))

(:: cyIndent (-> CYState Int))
(fn (cyIndent state)
  (let ((line (vecGet state.lines state.at))) line.indent))

(:: cyChild (-> CYState String Int Int (Result CerealValue Error)))
(fn (cyChild state inline indent depth)
  (if (> (strLen inline) 0) (cyScalar state inline depth)
    (if (&& (< state.at (vecLen state.lines)) (> (cyIndent state) indent))
      (cyBlock state (cyIndent state) depth)
      (cyScalar state "" depth))))

(:: cySequence (-> CYState Int Int (Result CerealValue Error)))
(fn (cySequence state indent depth)
  (let ((items vecNew) (mut done false) (mut problem ""))
    { (ccVisit state.check depth)
      (while (&& (! done) (&& (< state.at (vecLen state.lines)) (strEq problem "")))
        (let ((line (vecGet state.lines state.at)))
          (if (|| (!= line.indent indent) (! (cyDash line.text))) { (set done true) 0 }
            { (set state.at (+ state.at 1))
              (let ((inline (strTrim (strSlice line.text 1 (- (strLen line.text) 1)))))
                (match (cyChild state inline indent (+ depth 1))
                  ((Ok value) (vecPush items value))
                  ((Err error) { (set problem error.message) items })))
              (if (&& (< state.at (vecLen state.lines)) (> (cyIndent state) indent))
                { (set problem "unexpected YAML indentation after a sequence value") 0 } 0)
              0 })))
      (if (! (strEq state.check.problem "")) (cerealError state.check.problem)
        (if (strEq problem "") (Ok (CArray items)) (cerealError problem))) }))

(:: cyMapping (-> CYState Int Int (Result CerealValue Error)))
(fn (cyMapping state indent depth)
  (let ((members vecNew) (mut done false) (mut problem ""))
    { (ccVisit state.check depth)
      (while (&& (! done) (&& (< state.at (vecLen state.lines)) (strEq problem "")))
        (let ((line (vecGet state.lines state.at)) (colon (cyScan line.text false)))
          (if (|| (!= line.indent indent) (< colon 0)) { (set done true) 0 }
            { (set state.at (+ state.at 1))
              (match (cyKey (strTrim (strSlice line.text 0 colon)))
                ((Err error) { (set problem error.message) 0 })
                ((Ok key)
                  (match (cerealMemberGet members key 0)
                    ((Some previous) { { (set problem "duplicate YAML mapping key") 0 } 0 })
                    ((None)
                      (let ((inline (strTrim (strSlice line.text (+ colon 1) (- (strLen line.text) (+ colon 1))))))
                        (match (cyChild state inline indent (+ depth 1))
                          ((Ok value) { (vecPush members (CerealMember key value)) 0 })
                          ((Err error) { (set problem error.message) 0 })))))))
              (if (&& (< state.at (vecLen state.lines)) (> (cyIndent state) indent))
                { (set problem "unexpected YAML indentation after a mapping value") 0 } 0)
              0 })))
      (if (! (strEq state.check.problem "")) (cerealError state.check.problem)
        (if (strEq problem "") (Ok (CObject members)) (cerealError problem))) }))

(:: cyBlock (-> CYState Int Int (Result CerealValue Error)))
(fn (cyBlock state indent depth)
  (if (> depth state.check.limits.depth) (cerealError "YAML nesting limit exceeded")
    (let ((line (vecGet state.lines state.at)))
      (if (cyDash line.text) (cySequence state indent depth)
        (if (>= (cyScan line.text false) 0) (cyMapping state indent depth)
          { (set state.at (+ state.at 1)) (cyScalar state line.text depth) })))))

(:: cyPrintable (-> String Bool))
(fn (cyPrintable source)
  (let ((mut i 0) (mut valid true))
    { (while (&& valid (< i (strLen source)))
        { (match (utf8DecodeAt source i)
            ((None) { (set valid false) 0 })
            ((Some cp)
              { (if (! (|| (|| (== cp 9) (|| (== cp 10) (== cp 13)))
                    (|| (&& (>= cp 32) (<= cp 126))
                      (|| (== cp 133) (&& (>= cp 160) (&& (!= cp 65534) (!= cp 65535)))))))
                  { (set valid false) 0 } 0) }))
          (set i (utf8Next source i)) }) valid }))

(:: cyBlockDocument (-> String CerealLimits (Result CerealValue Error)))
(fn (cyBlockDocument source limits)
  (match (cyLines source)
    ((Err error) (Err error))
    ((Ok lines)
      (let ((state (CYState lines (CerealCheck limits 0 "") 0)))
        (if (== (vecLen lines) 0) (cyScalar state "" 0)
          (if (!= (cyIndent state) 0) (cerealError "YAML root must start at indentation zero")
            (match (cyBlock state 0 0)
              ((Err error) (Err error))
              ((Ok value)
                (if (!= state.at (vecLen lines)) (cerealError "inconsistent YAML indentation or trailing content")
                  (Ok value))))))))))

(:: cyDecode (-> String CerealLimits (Result CerealValue Error)))
(fn (cyDecode source limits)
  (if (! (cerealLimitsValid limits)) (cerealError "invalid codec resource limits")
    (if (> (strLen source) limits.bytes) (cerealError "YAML input byte limit exceeded")
      (if (! (cerealValidUtf8 source)) (cerealError "invalid UTF-8 YAML input")
        (if (! (cyPrintable source)) (cerealError "non-printable YAML character")
          (let ((trimmed (strTrim source)) (first (strByte (strTrim source) 0)))
            (if (|| (== first 91) (|| (== first 123) (== first 34)))
              (let ((state (CYState vecNew (CerealCheck limits 0 "") 0)))
                (match (cyFlow state trimmed 0)
                  ((Ok value) (Ok value))
                  ((Err error) (cyBlockDocument source limits))))
              (cyBlockDocument source limits))))))))

(:: cyWrite (-> CerealValue CerealWriter Int Int))
(fn (cyWrite value writer depth) (cjWrite value writer depth))

(pub :: cerealSerializeWith (-> CerealFormat CerealLimits (Codec a) a (Result String Error)))
(pub fn (cerealSerializeWith format limits codec value)
  (match (cerealToValue codec value)
    ((Err error) (Err error)) ((Ok tree) (cerealEncodeWith format limits tree))))

(pub :: cerealDeserializeWith (-> CerealFormat CerealLimits (Codec a) String (Result a Error)))
(pub fn (cerealDeserializeWith format limits codec source)
  (match (cerealDecodeWith format limits source)
    ((Err error) (Err error)) ((Ok tree) (cerealFromValue codec tree))))
