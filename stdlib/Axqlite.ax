;;! Axqlite - an embedded, single-file, multi-model database.
;;!
;;!     (dbWith "app.db" openOptions
;;!       (lambda (db)
;;!         {
;;!           (let _ (dbRun db "CREATE person:ada SET name = 'Ada', age = 36" VNone)?)
;;!           (let rows (dbRun db "SELECT name FROM person WHERE age > $min" (bind (query "") "min" (VInt 30)).params)?)
;;!           (Ok rows)
;;!         }))
;
; A database is one file of records. A record is a document with an
; identity, `person:ada`: fields of any shape, nested documents and
; lists, links to other records, and edges between them, in tables
; that may be schemaless or schemafull. `docs/axql.md` defines AXQL,
; the query language; `docs/axqlite.md` is the guide.
;
; There are two ways in, and they compose. Statements are AXQL text
; with `$parameters` bound from a value (`dbQuery`, `dbRun`), which
; is the way graphs, schema and events are written. The record
; functions (`dbCreate`, `dbGet`, `dbSelect`, `dbUpdate`,
; `dbRelate`, ...) work on values directly, with no text at all, and
; `defineRecord` in `Axqlite.AxqlMacro` builds typed structs over
; them. Everything answers `Value`s from `Axqlite.Value`; a record
; comes back as a document whose `id` field holds its record id.
;
; A `Db` closes when its last owner leaves scope, rolling back a
; transaction it has open, as a file does. Closing twice answers
; `Ok`; any other use after a close stops with status 85.
;
; Transactions: outside one, every call commits on its own.
; `dbTransaction` runs a function in one, `dbBegin` with `dbCommit`
; or `dbCancel` spells it out, and `BEGIN` in AXQL is the same
; transaction. Inside one a call that fails is undone and the
; transaction stays open. A commit is durable when it answers:
; `docs/axqlite.md` says what the journal guarantees after a crash.
;
; Concurrency: a `Db` is used by one binding at a time - it isn't
; `shared`, so the compiler refuses to let a `parallel` binding
; capture one. Connections to one file coordinate through a lock
; that never waits: a lock that isn't free answers `axqBusy` at
; once, having changed nothing.
;
; A memory database (`dbMemory`) is a real database in a temporary
; file the close removes: same code paths, nothing kept.
(import Internal.Raw)
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Sys)
(import Internal.Mapping)
(import Crypto.Random)
(import Axqlite.Value)
(import Axqlite.Pager)
(import Axqlite.Btree)
(import Axqlite.Record)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)
(import Axqlite.AxqlEval)
(import Axqlite.AxqlSchema)
(import Axqlite.AxqlExec)
(import Axqlite.AxqlMacro)

; ------------------------------------------------------------------
; Options.
; ------------------------------------------------------------------
;; How `dbOpen` opens a database: whether a missing file becomes a
;; new database, whether it may only read, and how many 4096-byte
;; pages its cache holds.
(pub struct OpenOptions
  (create : Bool)
  (readOnly : Bool)
  (cachePages : Int))

;; The defaults: create the file when it's missing, read and write,
;; and cache 256 pages (1 MiB).
(pub :: openOptions OpenOptions)
(pub fn (openOptions)
  (OpenOptions :create true :readOnly false :cachePages 256))

;; Open a database that must already exist, for reading only. Every
;; write on it is `axqReadOnly`.
(pub :: readOnlyOptions OpenOptions)
(pub fn (readOnlyOptions)
  (OpenOptions :create false :readOnly true :cachePages 256))

; ------------------------------------------------------------------
; The handle.
; ------------------------------------------------------------------
;; An open database.
(pub struct Db sealed
  (slot : Int)
  (owner : Handle)
  (path : String))

; The handle table's kinds: 1 to 7 are the runtime's and the
; library's, `Axqlite.Pager` takes 11, and `Crypto` 16 up.
(:: dbKind Int)
(fn (dbKind)
  8)

(:: dbBytes Int)
(fn (dbBytes)
  4096)

; The mapping's words, each an 8-byte slot past the length at 0.
(:: cwPager Int)
(fn (cwPager)
  8)

(:: cwInTxn Int)
(fn (cwInTxn)
  16)

(:: cwChanges Int)
(fn (cwChanges)
  24)

(:: cwTxnSerial Int)
(fn (cwTxnSerial)
  32)

(:: cwMemory Int)
(fn (cwMemory)
  40)

(:: cwReadOnly Int)
(fn (cwReadOnly)
  48)

(:: cwPathLen Int)
(fn (cwPathLen)
  56)

; The connection state a drop runs on: a borrowed view of the slot.
(struct DbState
  (slot : Int))

(:: misuse (-> String String (Result a Error)))
(fn (misuse msg where)
  (axqErr axqMisuse msg where))

(:: dbWord (-> Db Int Int))
;@axiom:effect(unsafe)
(fn (dbWord db word)
  (__load64 (__handle_get dbKind db.slot) word))

(:: dbWordSet (-> Db Int Int Int))
;@axiom:effect(unsafe)
(fn (dbWordSet db word v)
  {
    (__store64 (__handle_get dbKind db.slot) word v)
    0
  })

; The pager of a live database.
(:: dbPager (-> Db Pager))
;@axiom:effect(unsafe)
(fn (dbPager db)
  (as (dbWord db cwPager) Pager))

; The database's path as written in its mapping at open, so a drop
; can name the file a memory database leaves behind.
(:: dbPathAt (-> Int String))
;@axiom:effect(unsafe)
(fn (dbPathAt slot)
  {
    (let m (__handle_get dbKind slot))
    (let n (__load64 m cwPathLen))
    (let out (strAlloc n))
    {
      (rawCopy (strData out) (+ m 512) n)
      out
    }
  })

; What the runtime runs when a `Db` is dropped: the close itself,
; on a borrowed handle. It lives in this module because only it can
; name the kind.
(:: dbDrop (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (dbDrop slot)
  {
    (let _ (dbClose (Db :slot slot :owner (as 0 Handle) :path (dbPathAt slot))))
    0
  })

; ------------------------------------------------------------------
; Opening and closing.
; ------------------------------------------------------------------
;; Open the database at `path`, as `opts` says. A missing file is a
;; new empty database when `opts.create` holds, and `axqIoFailed`
;; when it doesn't. A file that isn't an AXQLite 2 database -
;; including one the older AXQLite wrote - is `axqNotADatabase`.
(pub :: dbOpen (-> String OpenOptions (Result Db Error)))
;@axiom:effect(io)
(pub fn (dbOpen path opts)
  (dbOpenAt path opts false))

;; A database that lives only until it closes: a temporary file
;; under `$TMPDIR` (or `/tmp`), removed with its journal by the
;; close. For tests and scratch work.
(pub :: dbMemory (-> OpenOptions (Result Db Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbMemory opts)
  (match randomWord
    ((Err e) (Err (errContextOf e "dbMemory")))
    ((Ok w)
      {
        (let env (sysEnv "TMPDIR"))
        (let dir
          (if (strIsEmpty env)
            "/tmp"
            env))
        (let path (concat (concat (concat dir "/axqlite-mem-") (fmtInt (randNonNeg w))) ".db"))
        (dbOpenAt path (OpenOptions :create true :readOnly false :cachePages opts.cachePages) true)
      }
    )))

(:: randNonNeg (-> Int Int))
(fn (randNonNeg w)
  (if (< w 0)
    (if (== w intMin)
      0
      (- 0 w))
    w))

(:: dbOpenAt (-> String OpenOptions Bool (Result Db Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (dbOpenAt path opts memory)
  (if (< opts.cachePages 1)
    (misuse "the page cache needs at least one page" "dbOpen")
    {
      (let pager (pagerOpen path opts.create opts.readOnly opts.cachePages)?)
      (match (sysMapPrivate dbBytes)
        ((Err e)
          {
            (let _ (pagerClose pager))
            (Err (errContextOf e "dbOpen"))
          }
        )
        ((Ok m)
          {
            (let h (__handle_new dbKind m))
            (if (== h 0)
              {
                (let _ (pagerClose pager))
                (let _ (sysUnmapPrivate m dbBytes))
                (misuse "the runtime's handle table is full" "dbOpen")
              }
              {
                (__store64 m 0 dbBytes)
                (__store64 m cwPager (as pager Int))
                (__store64 m cwMemory
                  (if memory
                    1
                    0))
                (__store64 m cwReadOnly
                  (if opts.readOnly
                    1
                    0))
                (__store64 m cwPathLen
                  (if (> (strLen path) 3000)
                    0
                    (strLen path)))
                (rawCopy (+ m 512) (strData path)
                  (if (> (strLen path) 3000)
                    0
                    (strLen path)))
                (Ok (Db :slot h :owner (__resource_new dbDrop h) :path path))
              })
          }
        ))
    }))

;; Close the database, rolling back a transaction it has open, and
;; removing a memory database's file. Closing again answers `Ok`;
;; any other later use stops with status 85.
(pub :: dbClose (-> Db (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (dbClose db)
  (if (! (ownerLive db.owner))
    (Ok 0)
    {
      (let memory (== (dbWord db cwMemory) 1))
      (let pager (dbPager db))
      (let m (__handle_free dbKind db.slot))
      {
        (let r (pagerClose pager))
        (let _ (sysUnmapPrivate m dbBytes))
        (let _ (__resource_disarm db.owner))
        {
          (if memory
            {
              (let _ (removeFile db.path))
              (let _ (removeFile (concat db.path "-journal")))
              0
            })
          (match r
            ((Ok _) (Ok 0))
            ((Err e) (Err (errContextOf e "dbClose"))))
        }
      }
    }))

; True until `owner` is closed or disarmed.
(:: ownerLive (-> Handle Bool))
;@axiom:effect(unsafe)
(fn (ownerLive owner)
  {
    (let w (as owner Int))
    (|| (== w 0) (!= (__load64 w 1) 0))
  })

;; Open the database at `path`, run `f` on it, and close it whatever
;; `f` answers. The answer is `f`'s, unless closing fails and `f`
;; succeeded. The usual way to use a database.
(pub :: dbWith (-> String OpenOptions (-> Db (Result a Error)) (Result a Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbWith path opts f)
  (match (dbOpen path opts)
    ((Err e) (Err e))
    ((Ok db) (dbWithDb db f))))

;; `dbWith` for a memory database.
(pub :: dbWithMemory (-> OpenOptions (-> Db (Result a Error)) (Result a Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbWithMemory opts f)
  (match (dbMemory opts)
    ((Err e) (Err e))
    ((Ok db) (dbWithDb db f))))

(:: dbWithDb (-> Db (-> Db (Result a Error)) (Result a Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (dbWithDb db f)
  {
    (let r (f db))
    (match (dbClose db)
      ((Ok _) r)
      ((Err e)
        (match r
          ((Ok _) (Err e))
          ((Err _) r))
      ))
  })

; ------------------------------------------------------------------
; Running statements.
; ------------------------------------------------------------------
; One executor for one call, with the call's housekeeping around it:
; the transaction flag and the change count ride back.
(:: dbExec (-> Db Value Exec))
(fn (dbExec db params)
  (axqlExecNew (dbPager db) params (dbReadOnlyWord db) (== (dbWord db cwInTxn) 1)))

(:: dbReadOnlyWord (-> Db Bool))
(fn (dbReadOnlyWord db)
  (== (dbWord db cwReadOnly) 1))

(:: dbExecDone (-> Db Exec Int))
(fn (dbExecDone db ex)
  {
    (dbWordSet db cwInTxn
      (if (axqlExecInTxn ex)
        1
        0))
    (dbWordSet db cwChanges (+ (dbWord db cwChanges) (axqlExecChanges ex)))
  })

;; Run a script - one or more AXQL statements - answering one value
;; per statement. `params` is an object binding the `$names` the
;; text mentions, or `VNone` when it mentions none.
(pub :: dbQuery (-> Db String Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbQuery db text params)
  (match (axqlParseScript text)
    ((Err e) (Err (errContextOf e "dbQuery")))
    ((Ok parsed) (dbRunParsed db parsed params))))

;; Run a script and answer its last statement's value: the common
;; case of one statement, and of setup followed by a query.
(pub :: dbRun (-> Db String Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbRun db text params)
  {
    (let rs (dbQuery db text params)?)
    (Ok
      (if (== (vecLen rs) 0)
        VNone
        (vecGet rs (- (vecLen rs) 1))))
  })

;; Run a `Query` (from `Axqlite.AxqlMacro`): its text with its bound
;; parameters, answering the last statement's value.
(pub :: dbRunQuery (-> Db Query (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbRunQuery db q)
  (dbRun db q.text q.params))

;; Evaluate one AXQL expression against the database: handy for a
;; value written as text, and for trying a graph walk by hand.
(pub :: dbEval (-> Db String Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbEval db text params)
  (dbRun db text params))

(:: dbRunParsed (-> Db (Vec Parsed) Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (dbRunParsed db parsed params)
  {
    (let ex (dbExec db params))
    {
      (let r (axqlRunScript ex parsed))
      {
        (dbExecDone db ex)
        r
      }
    }
  })

; ------------------------------------------------------------------
; Prepared statements: parse once, run with fresh parameters.
; ------------------------------------------------------------------
;; A parsed script, ready to run. Plain data: it holds no lock and
;; may run on any database.
(pub struct Statement
  (text : String)
  (parsed : (Vec Parsed)))

;; Parse a script without running it. A syntax error is `axqSyntax`
;; here, before any database is touched.
(pub :: dbPrepare (-> String (Result Statement Error)))
(pub fn (dbPrepare text)
  (match (axqlParseScript text)
    ((Err e) (Err (errContextOf e "dbPrepare")))
    ((Ok parsed) (Ok (Statement :text text :parsed parsed)))))

;; Run a prepared statement with these parameters, answering one
;; value per statement.
(pub :: dbRunStmt (-> Db Statement Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbRunStmt db stmt params)
  (dbRunParsed db stmt.parsed params))

;; The `$names` a prepared statement binds, in order, each once.
(pub :: stmtParams (-> Statement (Vec String)))
(pub fn (stmtParams stmt)
  {
    (let out vecNew)
    {
      (for p in stmt.parsed
        (for n in p.paramNames
          (if (! (nameIn out n))
            (vecPush out n))))
      out
    }
  })

(:: nameIn (-> (Vec String) String Bool))
(fn (nameIn names n)
  {
    (let mut found false)
    {
      (for x in names
        (if (strEq x n)
          (set found true)))
      found
    }
  })

; ------------------------------------------------------------------
; The record API: no text, values in and out. Each one runs the
; statement its name says, so field rules, indexes and events all
; apply exactly as they do from AXQL.
; ------------------------------------------------------------------
; A value as the expression that evaluates to it.
(:: exprOf (-> Value Expr))
(fn (exprOf v)
  (match v
    ((VArray xs)
      {
        (let out vecNew)
        {
          (for x in xs
            (vecPush out (exprOf x)))
          (EArray out)
        }
      }
    )
    ((VObject fs)
      {
        (let out vecNew)
        {
          (for f in fs
            (vecPush out (EField :name f.name :expr (exprOf f.value))))
          (EObject out)
        }
      }
    )
    ((VRecord rid) (ERecord rid.table (exprOf rid.key)))
    (_ (ELit v))))

(:: writeStmt (-> Stmt (Vec Parsed)))
(fn (writeStmt stmt)
  (vecPush vecNew (Parsed :stmt stmt :paramNames vecNew :text "")))

(:: oneWrite (-> Expr Content Bool Write))
(fn (oneWrite target content only)
  (Write :only only :targets (vecPush vecNew target) :content content :where None :return RetAfter))

; The one value a one-record write made, from its run's answers.
(:: oneValue (-> (Vec Value) String (Result Value Error)))
(fn (oneValue rs where)
  (if (== (vecLen rs) 0)
    (axqErr axqMisuse "the write answered nothing" where)
    (Ok (vecGet rs 0))))

;; Create the record `record` (a `VRecord`) holding `content` (an
;; object), answering it as stored, computed fields filled in. A
;; record already there is `axqExists`.
(pub :: dbCreate (-> Db Value Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbCreate db record content)
  {
    (let rs
      (dbRunParsed db
        (writeStmt (SCreate (oneWrite (exprOf record) (CContent (exprOf content)) true))) VNone)?)
    (oneValue rs "dbCreate")
  })

;; Create a record in `table` with the next free int key, answering
;; it as stored.
(pub :: dbCreateIn (-> Db String Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbCreateIn db table content)
  {
    (let rs
      (dbRunParsed db
        (writeStmt (SCreate (oneWrite (ETable table) (CContent (exprOf content)) true))) VNone)?)
    (oneValue rs "dbCreateIn")
  })

;; The record `record`, or `None` when there is no such record.
(pub :: dbGet (-> Db Value (Result (Option Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbGet db record)
  {
    (let rows (dbSelect db record)?)
    (Ok
      (if (== (vecLen rows) 0)
        None
        (Some (vecGet rows 0))))
  })

;; Every record a target names: a table name as text, one record, or
;; an array of records. Answers their documents, in key order.
(pub :: dbSelect (-> Db Value (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbSelect db target)
  {
    (let sel
      (Select
        :value false
        :projs (vecPush vecNew (Proj :star true :expr (ELit VNone) :alias ""))
        :omit vecNew
        :targets (vecPush vecNew (EParam "target"))
        :where None
        :group vecNew
        :order vecNew
        :limit None
        :start None
        :fetch vecNew))
    {
      (let params (objSet emptyObject "target" target))
      {
        (let rs (dbRunParsed db (writeStmt (SSelect sel)) params)?)
        (match (vecGet rs 0)
          ((VArray rows) (Ok rows))
          (_ (Ok vecNew)))
      }
    }
  })

;; Replace the record `record` with `content`, answering it as
;; stored, or `None` when there was no such record.
(pub :: dbUpdate (-> Db Value Value (Result (Option Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbUpdate db record content)
  {
    (let rs
      (dbRunParsed db
        (writeStmt (SUpdate (oneWrite (exprOf record) (CContent (exprOf content)) false))) VNone)?)
    (okOption rs)
  })

;; Merge `patch` into the record `record`, deep field by field,
;; answering it as stored, or `None` when there was none.
(pub :: dbMerge (-> Db Value Value (Result (Option Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbMerge db record patch)
  {
    (let rs
      (dbRunParsed db
        (writeStmt (SUpdate (oneWrite (exprOf record) (CMerge (exprOf patch)) false))) VNone)?)
    (okOption rs)
  })

;; Create the record `record` with `content`, or replace it when it
;; is already there. Answers it as stored.
(pub :: dbUpsert (-> Db Value Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbUpsert db record content)
  {
    (let rs
      (dbRunParsed db
        (writeStmt (SUpsert (oneWrite (exprOf record) (CContent (exprOf content)) true))) VNone)?)
    (oneValue rs "dbUpsert")
  })

;; Delete the record `record`, answering what it held, or `None`
;; when there was none.
(pub :: dbDelete (-> Db Value (Result (Option Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbDelete db record)
  {
    (let rs (dbRunParsed db (writeStmt (SDelete (oneWrite (exprOf record) CNone false))) VNone)?)
    (okOption rs)
  })

(:: okOption (-> (Vec Value) (Result (Option Value) Error)))
(fn (okOption rs)
  (if (== (vecLen rs) 0)
    (Ok None)
    (match (vecGet rs 0)
      ((VArray rows)
        (Ok
          (if (== (vecLen rows) 0)
            None
            (Some (vecGet rows 0))))
      )
      (_ (Ok None)))))

;; Relate `from` to `to` through the edge table `edge`, holding
;; `content` on the edge. Answers the edge as stored. A side that
;; doesn't exist is `axqNotFound`.
(pub :: dbRelate (-> Db Value String Value Value (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbRelate db from edge to content)
  {
    (let r
      (Relate
        :only true
        :from (exprOf from)
        :edge edge
        :edgeId None
        :to (exprOf to)
        :content (CContent (exprOf content))
        :return RetAfter))
    {
      (let rs (dbRunParsed db (writeStmt (SRelate r)) VNone)?)
      (oneValue rs "dbRelate")
    }
  })

; ------------------------------------------------------------------
; The record API through a Codec: your struct crosses by the codec
; you assemble for it (or `deriveCodec` assembles), exactly as a
; Cereal codec carries a struct into JSON.
; ------------------------------------------------------------------
;; Create the record `record` holding `value` written by `codec`,
;; answering it read back - computed fields and defaults included.
(pub :: dbCreateAs (-> Db Value (Codec a) a (Result a Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbCreateAs db record codec value)
  {
    (let made (dbCreate db record (toValue codec value))?)
    (fromValue codec made)
  })

;; The record `record` read by `codec`, or `None`.
(pub :: dbGetAs (-> Db Value (Codec a) (Result (Option a) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbGetAs db record codec)
  (match (dbGet db record)
    ((Err e) (Err e))
    ((Ok (None)) (Ok None))
    ((Ok (Some doc))
      (match (fromValue codec doc)
        ((Ok y) (Ok (Some y)))
        ((Err e) (Err e)))
    )))

;; Every record a target names, read by `codec`.
(pub :: dbSelectAs (-> Db Value (Codec a) (Result (Vec a) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbSelectAs db target codec)
  {
    (let rows (dbSelect db target)?)
    {
      (let out vecNew)
      (let mut failure None)
      {
        (for row in rows
          (if (isNone failure)
            (match (fromValue codec row)
              ((Ok y) (vecPush out y))
              ((Err e)
                (set failure (Some e))
              ))))
        (match failure
          ((Some e) (Err e))
          ((None) (Ok out)))
      }
    }
  })

;; Replace the record `record` with `value`, answering it read back,
;; or `None` when there was none.
(pub :: dbUpdateAs (-> Db Value (Codec a) a (Result (Option a) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbUpdateAs db record codec value)
  (match (dbUpdate db record (toValue codec value))
    ((Err e) (Err e))
    ((Ok (None)) (Ok None))
    ((Ok (Some doc))
      (match (fromValue codec doc)
        ((Ok y) (Ok (Some y)))
        ((Err e) (Err e)))
    )))

;; Create or replace the record `record` with `value`, answering it
;; read back.
(pub :: dbUpsertAs (-> Db Value (Codec a) a (Result a Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbUpsertAs db record codec value)
  {
    (let made (dbUpsert db record (toValue codec value))?)
    (fromValue codec made)
  })

;; Delete the record `record`, answering what it held read by
;; `codec`, or `None`.
(pub :: dbDeleteAs (-> Db Value (Codec a) (Result (Option a) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbDeleteAs db record codec)
  (match (dbDelete db record)
    ((Err e) (Err e))
    ((Ok (None)) (Ok None))
    ((Ok (Some doc))
      (match (fromValue codec doc)
        ((Ok y) (Ok (Some y)))
        ((Err e) (Err e)))
    )))

; ------------------------------------------------------------------
; Transactions, live queries, and the dump.
; ------------------------------------------------------------------
;; An open explicit transaction, from `dbBegin`.
(pub struct Transaction
  (db : Db)
  (serial : Int))

;; Open a transaction on `db`. A transaction already open is
;; `axqMisuse`. Commit it with `dbCommit`, cancel it with
;; `dbCancel`; closing the database cancels it.
(pub :: dbBegin (-> Db (Result Transaction Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbBegin db)
  {
    (let _ (dbRun db "BEGIN" VNone)?)
    {
      (let serial (+ (dbWord db cwTxnSerial) 1))
      {
        (dbWordSet db cwTxnSerial serial)
        (Ok (Transaction :db db :serial serial))
      }
    }
  })

(:: checkTxn (-> Transaction String (Result Int Error)))
(fn (checkTxn tx where)
  (if (|| (!= (dbWord tx.db cwTxnSerial) tx.serial) (== (dbWord tx.db cwInTxn) 0))
    (misuse "this transaction is already finished" where)
    (Ok 0)))

;; Commit `tx`, durably.
(pub :: dbCommit (-> Transaction (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbCommit tx)
  {
    (let _ (checkTxn tx "dbCommit")?)
    {
      (let _ (dbRun tx.db "COMMIT" VNone)?)
      (Ok 0)
    }
  })

;; Cancel `tx`, undoing everything it did.
(pub :: dbCancel (-> Transaction (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbCancel tx)
  {
    (let _ (checkTxn tx "dbCancel")?)
    {
      (let _ (dbRun tx.db "CANCEL" VNone)?)
      (Ok 0)
    }
  })

;; Run `f` in one transaction: commit its `Ok`, cancel its `Err`.
;; The answer is `f`'s either way.
(pub :: dbTransaction (-> Db (-> Db (Result a Error)) (Result a Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbTransaction db f)
  (match (dbBegin db)
    ((Err e) (Err e))
    ((Ok tx)
      {
        (let r (f db))
        (match r
          ((Ok _)
            (match (dbCommit tx)
              ((Ok _) r)
              ((Err e) (Err e)))
          )
          ((Err _)
            {
              (let _ (dbCancel tx))
              r
            }
          ))
      }
    )))

;; Whether a transaction is open on `db`.
(pub :: dbInTransaction (-> Db Bool))
(pub fn (dbInTransaction db)
  (== (dbWord db cwInTxn) 1))

;; How many records writes on `db` have changed since it opened.
(pub :: dbChanges (-> Db Int))
(pub fn (dbChanges db)
  (dbWord db cwChanges))

;; Subscribe to a table's changes: run the `LIVE SELECT`, answering
;; its id as text, then read what it sees with `dbPoll`. This is
;; `dbRun` on the statement, named for the job.
(pub :: dbLive (-> Db String (Result Value Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbLive db text)
  (dbRun db text VNone))

;; The changes a live query has not been shown yet, each an object
;; `{action, result}`. Takes a write lock, as it advances the
;; query's place in the feed.
(pub :: dbPoll (-> Db String (Result (Vec Value) Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbPoll db id)
  {
    (let ex (dbExec db VNone))
    {
      (let r (axqlPollLive ex id))
      (match r
        ((Ok rows)
          (match (axqlFinishRun ex)
            ((Ok _)
              {
                (dbExecDone db ex)
                (Ok rows)
              }
            )
            ((Err e) (Err e)))
        )
        ((Err e)
          {
            (let _ (axqlAbortRun ex))
            {
              (dbExecDone db ex)
              (Err (errContextOf e "dbPoll"))
            }
          }
        ))
    }
  })

;; End a live query. A query that isn't there is `axqNotFound`.
(pub :: dbKill (-> Db String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbKill db id)
  {
    (let _ (dbRun db "KILL $id" (objSet emptyObject "id" (VText id)))?)
    (Ok 0)
  })

;; The whole database as AXQL that rebuilds it: definitions in the
;; order they were made, then a CREATE per record. Running it into
;; an empty database (with `dbQuery`) restores this one.
(pub :: dbDump (-> Db (Result String Error)))
;@axiom:effect(io)
;@axiom:effect(entropy)
(pub fn (dbDump db)
  {
    (let ex (dbExec db VNone))
    {
      (let r (axqlDump ex))
      (match r
        ((Ok text)
          (match (axqlFinishRun ex)
            ((Ok _)
              {
                (dbExecDone db ex)
                (Ok text)
              }
            )
            ((Err e) (Err e)))
        )
        ((Err e)
          {
            (let _ (axqlAbortRun ex))
            {
              (dbExecDone db ex)
              (Err (errContextOf e "dbDump"))
            }
          }
        ))
    }
  })
