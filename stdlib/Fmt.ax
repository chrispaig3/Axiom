; Fmt - number formatting, in Axiom.
;
; This module is what replaced `printf`. Formatting an integer used to
; have meant an FFI binding to a C variadic function - a construct Axiom's
; type system cannot describe and its effect analysis cannot see through.
; Doing it in Axiom instead is about 40 lines, is fully type-checked, and
; leaves nothing for a C library to do.

(import Mem)
(import Str)

; True for the one `Int` that is its own negation: the most negative
; value, whose magnitude does not fit in an `Int`. Zero negates to itself
; too, so it is excluded.
;
; This is the test to use rather than comparing against a literal. Axiom
; has no literal for the most negative `Int` - writing its digits is an
; overflowing positive literal - and the obvious stand-in,
; `(- 0 9223372036854775807)`, is one *greater* than it. Code guarded that
; way looks correct and never fires.
(:: intIsMostNegative (-> Int Bool))
(fn (intIsMostNegative n)
  (&& (< n 0) (== (- 0 n) n)))

; Decimal digits in `n`, counting a leading `-` and treating 0 as one
; digit.
(pub :: fmtIntWidth (-> Int Int))
(pub fn (fmtIntWidth n)
  (if (intIsMostNegative n)
      20                                  ; "-9223372036854775808"
      (if (< n 0)
          (+ 1 (fmtIntWidth (- 0 n)))
          (if (< n 10)
              1
              (+ 1 (fmtIntWidth (/ n 10)))))))

; `n` in base 10 as a `Str`.
;
; Digits are written back-to-front into an exactly-sized buffer, which
; avoids both a reverse pass and the "how big should the scratch buffer
; be" guess that the C version needed.
;
; `Int` is 64-bit and two's complement, so the most negative value has no
; positive counterpart. Negating it yields itself, so every path that
; formats `|n|` - `fmtNat`, and `fmtIntWidth` inside it - recurses
; forever on that one input. It has exactly one spelling, so it is
; answered outright.
;
; Detected with `intIsMostNegative`, not by comparing against a literal:
; the guard here used to read `(== n (- 0 9223372036854775807))`, which
; is `MIN + 1` and therefore never true of `MIN` itself.
(pub :: fmtInt (-> Int String))
(pub fn (fmtInt n)
  (if (intIsMostNegative n)
      "-9223372036854775808"
      (if (< n 0)
          (strConcat "-" (fmtNat (- 0 n)))
          (fmtNat n))))

; `n` (assumed non-negative) in base 10.
(:: fmtNat (-> Int String))
(fn (fmtNat n)
  (let ((width (fmtIntWidth n)))
    (let ((out (strAlloc width)))
      {
        (fmtDigits (strData out) n (- width 1))
        out
      })))

; Write `n`'s decimal digits into `buf` ending at index `at`, working
; right to left.
(:: fmtDigits (-> Int Int Int Int))
(fn (fmtDigits buf n at)
  (let ((digit (+ 48 (% n 10))))
    {
      (__store8 buf at digit)
      (if (< n 10)
          buf
          (fmtDigits buf (/ n 10) (- at 1)))
    }))

; `n` in base 16, lower case, no `0x` prefix, no leading zeros.
;
; Used for addresses and bit patterns in compiler diagnostics, where
; decimal is unreadable.
(pub :: fmtHex (-> Int Int))
(pub fn (fmtHex n)
  (if (== n 0)
      "0"
      (let ((width (fmtHexWidth n 0)))
        (let ((out (strAlloc width)))
          {
            (fmtHexDigits (strData out) n (- width 1))
            out
          }))))

(:: fmtHexWidth (-> Int Int Int))
(fn (fmtHexWidth n acc)
  (if (== n 0)
      acc
      (fmtHexWidth (/ n 16) (+ acc 1))))

(:: fmtHexDigits (-> Int Int Int Int))
(fn (fmtHexDigits buf n at)
  (let ((nibble (% n 16)))
    (let ((digit (if (< nibble 10) (+ 48 nibble) (+ 87 nibble))))
      {
        (__store8 buf at digit)
        (if (< n 16)
            buf
            (fmtHexDigits buf (/ n 16) (- at 1)))
      })))

; `s` padded on the left with spaces to at least `width` bytes.
(pub :: fmtPadLeft (-> String Int Int))
(pub fn (fmtPadLeft s width)
  (let ((len (strLen s)))
    (if (>= len width)
        s
        (let ((out (strAlloc width)))
          {
            (memSet (strData out) 32 (- width len))
            (memCopy (+ (strData out) (- width len)) (strData s) len)
            out
          }))))

; ------------------------------------------------------------------
; Floating point
; ------------------------------------------------------------------
;
; Fixed-point rendering with a chosen number of decimal places, not the
; shortest round-tripping form. Shortest-round-trip (Ryu, Grisu) needs
; big-integer arithmetic and is a module of its own; this is the part a
; program printing a measurement actually wants, and it is exact for
; every value it claims to print because the digits are produced by
; integer arithmetic after one scaling multiply.

; 10^n, for the scaling factor. `n` is a place count, so it is small.
(:: powTen (-> Int Int))
(fn (powTen n)
  (if (<= n 0)
      1
      (* 10 (powTen (- n 1)))))

; `n` rendered in base 10, left-padded with `0` to at least `width`.
;
; Distinct from `fmtPadLeft`, which pads with spaces: a fractional part
; needs `0.05` rather than `0. 5`, so the digits it is missing on the
; left are zeros.
(:: fmtPadZeros (-> Int Int String))
(fn (fmtPadZeros n width)
  (let ((s (fmtNat n))
        (len (strLen s)))
    (if (>= len width)
        s
        (let ((out (strAlloc width)))
          {
            (memSet (strData out) 48 (- width len))
            (memCopy (+ (strData out) (- width len)) (strData s) len)
            out
          }))))

; `x` with six decimal places.
(pub :: fmtFloat (-> Float String))
(pub fn (fmtFloat x)
  (fmtFloatPrec x 6))

; `x` with `places` decimal places, rounded half away from zero.
(pub :: fmtFloatPrec (-> Float Int String))
(pub fn (fmtFloatPrec x places)
  (if (< x 0.0)
      (strConcat "-" (fmtFloatAbs (- 0.0 x) places))
      (fmtFloatAbs x places)))

; The non-negative case.
;
; Rounding is applied to the scaled fraction and can carry - `0.999` at
; two places is `1.00`, not `0.100` - so the carry is folded back into
; the integer part rather than left to overflow the fraction field.
(:: fmtFloatAbs (-> Float Int String))
(fn (fmtFloatAbs x places)
  (let ((whole (__floatToInt x))
        (frac (- x (__intToFloat whole)))
        (scale (powTen places))
        (scaled (__floatToInt (+ (* frac (__intToFloat scale)) 0.5)))
        (carried (if (>= scaled scale) 1 0))
        (whole2 (+ whole carried))
        (frac2 (- scaled (* carried scale))))
    (if (<= places 0)
        (fmtInt whole2)
        (strConcat (strConcat (fmtInt whole2) ".")
                   (fmtPadZeros frac2 places)))))
