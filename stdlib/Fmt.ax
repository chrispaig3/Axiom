; Fmt - number formatting, in Axiom.
;
; This module is what replaced `printf`. Formatting an integer used to
; have meant an FFI binding to a C variadic function - a construct Axiom's
; type system cannot describe and its effect analysis cannot see through.
; Doing it in Axiom instead is about 40 lines, is fully type-checked, and
; leaves nothing for a C library to do.
(import Mem)

(import Str)

; True for the one `Int` that is its own negation: the most negative
; value, whose magnitude does not fit in an `Int`. Zero negates to itself
; too, so it is excluded.
;
; This is the test to use rather than comparing against a literal. Axiom
; has no literal for the most negative `Int` - writing its digits is an
; overflowing positive literal - and the obvious stand-in,
; `(- 0 9223372036854775807)`, is one *greater* than it. Code guarded that
; way looks correct and never fires.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: intIsMostNegative (-> Int Bool))

(fn (intIsMostNegative n) (&& (< n 0) (== (- 0 n) n)))

; Decimal digits in `n`, counting a leading `-` and treating 0 as one
; digit.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: fmtIntWidth (-> Int Int))

(pub fn (fmtIntWidth n)
  (if (intIsMostNegative n)
    20  ; "-9223372036854775808"
    (if (< n 0)
      (+ 1 (fmtIntWidth (- 0 n)))
      (if (< n 10)
        1
        (+ 1 (fmtIntWidth (/ n 10)))
      )
    )
  )
)

; `n` in base 10 as a `Str`.
;
; Digits are written back-to-front into an exactly-sized buffer, which
; avoids both a reverse pass and the "how big should the scratch buffer
; be" guess that the C version needed.
;
; `Int` is 64-bit and two's complement, so the most negative value has no
; positive counterpart. Negating it yields itself, so every path that
; formats `|n|` - `fmtNat`, and `fmtIntWidth` inside it - recurses
; forever on that one input. It has exactly one spelling, so it is
; answered outright.
;
; Detected with `intIsMostNegative`, not by comparing against a literal:
; the guard here used to read `(== n (- 0 9223372036854775807))`, which
; is `MIN + 1` and therefore never true of `MIN` itself.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtInt (-> Int String))

(pub fn (fmtInt n)
  (if (intIsMostNegative n)
    "-9223372036854775808"
    (if (< n 0)
      (strConcat "-" (fmtNat (- 0 n)))
      (fmtNat n)
    )
  )
)

; `n` (assumed non-negative) in base 10.
;@axiom:restrict(no-io,no-foreign)
(:: fmtNat (-> Int String))

(fn (fmtNat n)
  (let ((width (fmtIntWidth n)))
    (let ((out (strAlloc width)))
      {
        (fmtDigits (strData out) n (- width 1))
        out
      }
    )
  )
)

; Write `n`'s decimal digits into `buf` ending at index `at`, working
; right to left.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtDigits (-> Int Int Int Int))

(fn (fmtDigits buf n at)
  (let ((digit (+ 48 (% n 10))))
    {
      (__store8 buf at digit)
      (if (< n 10)
        buf
        (fmtDigits buf (/ n 10) (- at 1))
      )
    }
  )
)

; `n` in base 16, lower case, no `0x` prefix, no leading zeros.
;
; Used for addresses and bit patterns in compiler diagnostics, where
; decimal is unreadable.
; Hexadecimal is UNSIGNED - the word's bits, as Rust's `{:x}` prints
; them - so `-1` is `ffffffffffffffff` and not a one-byte answer.
;
; It printed one byte until 2026-08-15, and the byte was garbage:
; `(% -1 16)` is `-1` under signed remainder, `48 + -1` is 47, and
; `(fmtHex -1)` answered `/`. `(/ n 16)` compounded it, rounding
; toward zero so the loop stopped after one digit. Nothing in the
; corpus had ever passed a negative - `020-fmt` covers 0, 255 and
; 48879 - and nothing could reach it from a print until the `{n:x}`
; specifier existed, which is what surfaced it.
;
; The fix is to divide by SHIFTING and to take digits by MASKING,
; which is unsigned by construction. `>>` sign-extends, so the mask
; clears the four bits it dragged in; a logical `>>` would make the
; mask a no-op rather than wrong, so this is correct either way.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexShr4 (-> Int Int))

(fn (fmtHexShr4 n) (& (>> n 4) 1152921504606846975))

;@axiom:restrict(no-io,no-foreign)
(pub :: fmtHex (-> Int String))

(pub fn (fmtHex n)
  (if (== n 0)
    "0"
    (let ((width (fmtHexWidth n 0)))
      (let ((out (strAlloc width)))
        {
          (fmtHexDigits (strData out) n (- width 1))
          out
        }
      )
    )
  )
)

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexWidth (-> Int Int Int))

(fn (fmtHexWidth n acc)
  (if (== n 0)
    acc
    (fmtHexWidth (fmtHexShr4 n) (+ acc 1))
  )
)

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexDigits (-> Int Int Int Int))

(fn (fmtHexDigits buf n at)
  (let ((nibble (& n 15)))
    (let ((digit 
      (if (< nibble 10)
        (+ 48 nibble)
        (+ 87 nibble)
      )
    ))
      {
        (__store8 buf at digit)
        (let ((rest (fmtHexShr4 n)))
          (if (== rest 0)
            buf
            (fmtHexDigits buf rest (- at 1))
          )
        )
      }
    )
  )
)

; `s` padded on the left with spaces to at least `width` bytes.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadLeft (-> String Int String))

(pub fn (fmtPadLeft s width)
  (let ((len (strLen s)))
    (if (>= len width)
      s
      (let ((out (strAlloc width)))
        {
          (memSet (strData out) 32 (- width len))
          (memCopy (+ (strData out) (- width len)) (strData s) len)
          out
        }
      )
    )
  )
)

; `s` padded on the right with spaces to at least `width` bytes.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadRight (-> String Int String))

(pub fn (fmtPadRight s width)
  (let ((len (strLen s)))
    (if (>= len width)
      s
      (let ((out (strAlloc width)))
        {
          (memCopy (strData out) (strData s) len)
          (memSet (+ (strData out) len) 32 (- width len))
          out
        }
      )
    )
  )
)

; `s` centred in `width` bytes. An odd remainder goes to the RIGHT,
; which is the convention Rust's `{:^}` uses and the one that makes a
; column of centred labels line up with a left-aligned header.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadCenter (-> String Int String))

(pub fn (fmtPadCenter s width)
  (let ((len (strLen s)))
    (if (>= len width)
      s
      (let ((pad (- width len)))
        (let ((left (/ pad 2)))
          (let ((out (strAlloc width)))
            {
              (memSet (strData out) 32 left)
              (memCopy (+ (strData out) left) (strData s) len)
              (memSet (+ (strData out) (+ left len)) 32 (- pad left))
              out
            }
          )
        )
      )
    )
  )
)

; `s` padded on the left with ZEROS to at least `width` bytes, with a
; leading sign kept in front of them: `-7` at width 4 is `-007` and
; not `00-7`. That is the whole reason this is not `fmtPadLeft` with a
; different byte, and it is why the format specifier `{n:04}` can be
; one call rather than a sign test at every call site.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadZerosLeft (-> String Int String))

(pub fn (fmtPadZerosLeft s width)
  (let ((len (strLen s)))
    (if (>= len width)
      s
      (let (
        (neg (if (== len 0)
          0
          (if (== (strByte s 0) 45)
            1
            0
          )
        ))
        (out (strAlloc width))
      )
        {
          (if (== neg 1)
            (__store8 (strData out) 0 45)
            0
          )
          (memSet (+ (strData out) neg) 48 (- width len))
          (memCopy (+ (strData out) (+ neg (- width len))) (+ (strData s) neg) (- len neg))
          out
        }
      )
    )
  )
)

; Uppercase hexadecimal, for the `{n:X}` specifier. Same digits as
; `fmtHex`, and deliberately a separate function rather than a flag:
; the specifier picks one at expansion time, so a branch would be a
; runtime test of a compile-time constant.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtHexUpper (-> Int String))

(pub fn (fmtHexUpper n)
  (if (== n 0)
    "0"
    (let ((width (fmtHexWidth n 0)))
      (let ((out (strAlloc width)))
        {
          (fmtHexDigitsUpper (strData out) n (- width 1))
          out
        }
      )
    )
  )
)

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexDigitsUpper (-> Int Int Int Int))

(fn (fmtHexDigitsUpper buf n at)
  (let ((nibble (& n 15)))
    (let ((digit 
      (if (< nibble 10)
        (+ 48 nibble)
        (+ 55 nibble)
      )
    ))
      {
        (__store8 buf at digit)
        (let ((rest (fmtHexShr4 n)))
          (if (== rest 0)
            buf
            (fmtHexDigitsUpper buf rest (- at 1))
          )
        )
      }
    )
  )
)

; ------------------------------------------------------------------
; Floating point
; ------------------------------------------------------------------
;
; Fixed-point rendering with a chosen number of decimal places, not the
; shortest round-tripping form. Shortest-round-trip (Ryu, Grisu) needs
; big-integer arithmetic and is a module of its own; this is the part a
; program printing a measurement actually wants, and it is exact for
; every value it claims to print because the digits are produced by
; integer arithmetic after one scaling multiply.
; 10^n, for the scaling factor. `n` is a place count, so it is small.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: powTen (-> Int Int))

(fn (powTen n)
  (if (<= n 0)
    1
    (* 10 (powTen (- n 1)))
  )
)

; `n` rendered in base 10, left-padded with `0` to at least `width`.
;
; Distinct from `fmtPadLeft`, which pads with spaces: a fractional part
; needs `0.05` rather than `0. 5`, so the digits it is missing on the
; left are zeros. The padding itself is `fmtPadZerosLeft`'s, whose
; sign guard is a no-op here because `fmtNat` never answers a `-`.
;@axiom:restrict(no-io,no-foreign)
(:: fmtPadZeros (-> Int Int String))

(fn (fmtPadZeros n width) (fmtPadZerosLeft (fmtNat n) width))

; `x` with six decimal places.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtFloat (-> Float String))

(pub fn (fmtFloat x) (fmtFloatPrec x 6))

; `x` with `places` decimal places, rounded half away from zero.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtFloatPrec (-> Float Int String))

(pub fn (fmtFloatPrec x places)
  (if (< x 0.0)
    (strConcat "-" (fmtFloatAbs (- 0.0 x) places))
    (fmtFloatAbs x places)
  )
)

; The non-negative case.
;
; Rounding is applied to the scaled fraction and can carry - `0.999` at
; two places is `1.00`, not `0.100` - so the carry is folded back into
; the integer part rather than left to overflow the fraction field.
;@axiom:restrict(no-io,no-foreign)
(:: fmtFloatAbs (-> Float Int String))

(fn (fmtFloatAbs x places)
  (let (
    (whole (__floatToInt x))
    (frac (- x (__intToFloat whole)))
    (scale (powTen places))
    (scaled (__floatToInt (+ (* frac (__intToFloat scale)) 0.5)))
    (carried (if (>= scaled scale)
      1
      0
    ))
    (whole2 (+ whole carried))
    (frac2 (- scaled (* carried scale)))
  )
    (if (<= places 0)
      (fmtInt whole2)
      (strConcat (strConcat (fmtInt whole2) ".") (fmtPadZeros frac2 places))
    )
  )
)

; ------------------------------------------------------------------
; `format` — a String, built at compile time from a literal's runs and
; holes, or the hole lowering applied to anything else.
;
;   (format "x = {x}, y = {y}")   ; the interpolating form
;   (format n)                    ; Rust's format!("{}", n)
;
; The macro is four tokens because `syntax/format` is the whole
; implementation: it reads the literal, splits it, and emits the
; `strConcat` chain with one rendering call per hole. See
; docs/macro-system.md MAC-CAP-10 for the grammar and the lowering.
;
; It lives HERE because the lowering it emits targets this module:
; a hole on an `Int` becomes `fmtInt`, on a `Float` `fmtFloat`, and
; every width and precision specifier is one of the `fmtPad*`
; functions above. It was `stdlib/Show.ax` until 0.7.4, a module whose
; other 40 lines argued for a trait system that no longer exists;
; `IO` imported it solely to carry this macro, and that edge is gone
; with the file.
(pub macro (format e) (syntax/format e))
