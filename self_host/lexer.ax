; lexer.ax — character-at-a-time tokenizer.
;
; Dependencies: core.ax (Span, Token, TokenKind), Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Utf8)
(import Vec)

; ------------------------------------------------------------------
; Character predicates.
; ------------------------------------------------------------------

(pub :: isDigit (-> Int Bool))
(pub fn (isDigit ch)
  (if (>= ch 48)
      (<= ch 57)
      false))

(pub :: isAlpha (-> Int Bool))
(pub fn (isAlpha ch)
  (if (>= ch 65)
      (if (<= ch 90) true
      (if (>= ch 97)
          (<= ch 122)
          false))
      false))

; `^` (94) is an operator character like the rest - leaving it out did
; not make it an error, it made the lexer's fallback *silently skip*
; the byte, so `(^ a b)` lexed as `(a b)` and xor became application.
(pub :: isIdentStart (-> Int Bool))
(pub fn (isIdentStart ch)
  (if (isAlpha ch) true (if (== ch 95) true (if (== ch 43) true (if (== ch 45) true (if (== ch 42) true (if (== ch 47) true (if (== ch 37) true (if (== ch 60) true (if (== ch 62) true (if (== ch 61) true (if (== ch 33) true (if (== ch 38) true (if (== ch 124) true (if (== ch 63) true (if (== ch 94) true false))))))))))))))))

(pub :: isIdentChar (-> Int Bool))
(pub fn (isIdentChar ch)
  (if (isAlpha ch) true (if (isDigit ch) true (if (== ch 95) true (if (== ch 45) true (if (== ch 33) true (if (== ch 63) true (if (== ch 42) true (if (== ch 43) true (if (== ch 47) true (if (== ch 60) true (if (== ch 62) true (if (== ch 61) true (if (== ch 37) true (if (== ch 38) true (if (== ch 124) true (if (== ch 39) true (if (== ch 94) true false))))))))))))))))))

(pub :: isSpace (-> Int Bool))
(pub fn (isSpace ch)
  (if (== ch 32) true
  (if (== ch 10) true
  (if (== ch 13) true
  (if (== ch 9)  true
  false)))))

; ------------------------------------------------------------------
; Skip whitespace and comments.
; ------------------------------------------------------------------

(pub :: skipWhitespace (-> Int Int Int Int))
; A loop rather than a recursion, and `skipLineComment` returns to it
; rather than calling back, for the reason `lexTokens` below is a loop:
; the two used to call each other in tail position, one frame per byte
; of a comment-and-whitespace run, and stage1's tail-call rewrite fires
; only for a SELF call. `skipLineComment` is self-recursive, so that
; one it does flatten.
(pub fn (skipWhitespace src pos len)
  (let ((mut p pos)
        (mut go 1))
    {
      (while (== go 1)
        (if (>= p len)
            (set go 0)
            (let ((ch (strByte src p)))
              (if (isSpace ch)
                  (set p (+ p 1))
              (if (== ch 59)
                  (set p (skipLineComment src (+ p 1) len))
                  (set go 0))))))
      p
    }))

; The position just past the newline that ends this comment, or `len`.
; It used to continue into `skipWhitespace` itself; the caller's loop
; does that now, which is the same walk without the mutual recursion.
(pub :: skipLineComment (-> Int Int Int Int))
(pub fn (skipLineComment src pos len)
  (if (>= pos len)
      pos
      (if (== (strByte src pos) 10)
          (+ pos 1)
          (skipLineComment src (+ pos 1) len))))

; ------------------------------------------------------------------
; Emit a token.
; ------------------------------------------------------------------

(pub :: emitToken (-> TokenKind Int Int Int Int Int))
(pub fn (emitToken kind start end tokens src)
  (let ((lex (strSlice src start (- end start))))
    (vecPush tokens (mkToken kind lex (mkSpan start end)))))

; ------------------------------------------------------------------
; Skip helpers.
; ------------------------------------------------------------------

(pub :: skipIdent (-> Int Int Int Int))
(pub fn (skipIdent src pos len)
  (if (>= pos len)
      pos
      (let ((ch (strByte src pos)))
        (if (isIdentChar ch)
            (skipIdent src (+ pos 1) len)
        pos))))

; `_` is a digit separator, consumed as part of the number and filtered
; out when the value is decoded - `1_000_000` is one token, exactly as
; stage0's `consume_number` treats it. Stopping at the `_` split the
; literal into an integer and an identifier, and the identifier went on
; to be emitted as an SSA name nothing defines.
(pub :: skipDigits (-> Int Int Int Int))
(pub fn (skipDigits src pos len)
  (if (>= pos len)
      pos
      (let ((ch (strByte src pos)))
        (if (isDigit ch)
            (skipDigits src (+ pos 1) len)
        (if (== ch 95)
            (skipDigits src (+ pos 1) len)
        pos)))))

; A backslash escapes whatever follows it, so an escaped quote does not
; end the literal. Without this, `"c\""` ended at the middle quote and
; the rest of the file lexed as garbage - which is exactly what a
; compiler emitting LLVM has to write.
(pub :: scanStringEnd (-> Int Int Int Int))
(pub fn (scanStringEnd src pos len)
  (if (>= pos len)
      pos
      (let ((ch (strByte src pos)))
        (if (== ch 92)
            (scanStringEnd src (+ pos 2) len)
        (if (== ch 34)
            (+ pos 1)
        (if (== ch 10)
            pos
        (scanStringEnd src (+ pos 1) len)))))))

; ------------------------------------------------------------------
; Main lexer loop.
; ------------------------------------------------------------------

; The token loop is a `while`, and that is a correctness property
; rather than a style choice.
;
; `lexTokens` and `dispatchChar` used to call each other in tail
; position - one frame pair per token, never released until EOF - and
; stage1's tail-call rewrite fires only for a SELF call, so a compiler
; built BY STAGE1 grew a frame per token of its input. Measured: the
; stage1-built `300-pipeline` died between 96 KB and 146 KB of source
; while the same program built by stage0, whose `opt` run flattens
; mutual tail calls, read 396 KB without trouble. The compiler's own
; `codegen.ax` sat just under the line, so the ceiling arrived exactly
; the way the `Mem` byte loops' did: as an unrelated-looking
; conformance failure after an unrelated change made the source
; longer.
;
; Each branch of `stepToken` pushes its token and answers the next
; position, so the loop owns the only frame. Every branch advances by
; at least one byte, which is what makes the loop terminate where the
; recursion terminated by running out of input.
(pub :: lexTokens (-> Int Int Int Int Int))
(pub fn (lexTokens src pos len tokens)
  (let ((mut p pos))
    {
      (while (< p len)
        (set p (stepToken src p len tokens (strByte src p))))
      ; `p` may sit past `len` when the last token overshot - a char
      ; literal at EOF - which is the position the recursive version
      ; gave EOF too.
      (emitToken TK_EOF p p tokens src)
    }))

(pub :: stepToken (-> Int Int Int Int Int Int))
(pub fn (stepToken src pos len tokens ch)
  (if (== ch 45)
      (if (&& (< (+ pos 1) len) (== (strByte src (+ pos 1)) 62))
          { (emitToken TK_RARROW pos (+ pos 2) tokens src) (+ pos 2) }
          ; `-` directly against a digit is a negative literal, exactly
          ; as stage0 lexes it. Falling through to the identifier rule
          ; made `-5` an ident, which codegen emitted as the SSA name
          ; `%-5` - a value nothing defines.
          (if (&& (< (+ pos 1) len) (isDigit (strByte src (+ pos 1))))
              (stepNumberFrom src pos (+ pos 1) len tokens)
              (stepIdentToken src pos len tokens)))
(if (== ch 58)
      (if (&& (< (+ pos 1) len) (== (strByte src (+ pos 1)) 58))
          { (emitToken TK_DOUBLE_COLON pos (+ pos 2) tokens src) (+ pos 2) }
          { (emitToken TK_COLON pos (+ pos 1) tokens src) (+ pos 1) })
(if (isDigit ch)
      (stepNumberFrom src pos (+ pos 1) len tokens)
(if (isIdentStart ch)
      (let ((ep (skipIdent src (+ pos 1) len)))
        { (emitToken TK_IDENT pos ep tokens src) ep })
(if (== ch 34)
      (let ((ep (scanStringEnd src (+ pos 1) len)))
        (let ((kind (if (< ep len) TK_STRING TK_ERROR)))
          { (emitToken kind pos ep tokens src) ep }))
(if (== ch 40)
      { (emitToken TK_LPAREN pos (+ pos 1) tokens src) (+ pos 1) }
(if (== ch 41)
      { (emitToken TK_RPAREN pos (+ pos 1) tokens src) (+ pos 1) }
(if (== ch 46)
      { (emitToken TK_DOT pos (+ pos 1) tokens src) (+ pos 1) }
(if (== ch 39)
      ; A leading `'` starts a char literal unless what follows is a
      ; space, `(` or `[` - stage0's exact rule; a mid-identifier `'`
      ; never reaches here because isIdentChar consumes it.
      (if (&& (< (+ pos 1) len)
              (&& (!= (strByte src (+ pos 1)) 32)
                  (&& (!= (strByte src (+ pos 1)) 40)
                      (!= (strByte src (+ pos 1)) 91))))
          ; A char literal is quote + one CHARACTER + quote, and a
          ; character is not a byte: `'é'` is four bytes and `'😀'`
          ; six. Hardcoding three made stage1 fail to parse any
          ; non-ASCII char literal at all, where stage0 - which lexes
          ; a Vec<char> - reads it fine.
          (let ((ep (if (== (strByte src (+ pos 1)) 92)
                        (+ pos 4)
                        (+ (+ pos 2) (utf8SeqLen (strByte src (+ pos 1)))))))
            { (emitToken TK_CHARLIT pos ep tokens src) ep })
          { (emitToken TK_QUOTE pos (+ pos 1) tokens src) (+ pos 1) })
(if (== ch 123)
      { (emitToken TK_LBRACE pos (+ pos 1) tokens src) (+ pos 1) }
(if (== ch 125)
      { (emitToken TK_RBRACE pos (+ pos 1) tokens src) (+ pos 1) }
(if (== ch 91)
      { (emitToken TK_LBRACKET pos (+ pos 1) tokens src) (+ pos 1) }
(if (== ch 93)
      { (emitToken TK_RBRACKET pos (+ pos 1) tokens src) (+ pos 1) }
(if (isSpace ch)
      (+ pos 1)
(if (== ch 59)
      (skipWhitespace src pos len)
(+ pos 1)))))))))))))))))

(pub :: stepIdentToken (-> Int Int Int Int Int))
(pub fn (stepIdentToken src pos len tokens)
  (let ((ep (skipIdent src (+ pos 1) len)))
    { (emitToken TK_IDENT pos ep tokens src) ep }))

; Digits (and separators), then `.digit`, make a float literal: `1.5`
; is one token, where `1.x` is an integer followed by a field access.
; Deciding by the character *after* the dot is what stage0's lexer does
; too. `numStart` may sit on a leading `-`; the scan begins at
; `scanFrom`.
(pub :: stepNumberFrom (-> Int Int Int Int Int Int))
(pub fn (stepNumberFrom src numStart scanFrom len tokens)
  (let ((ep (skipDigits src scanFrom len)))
    (if (&& (< (+ ep 1) len)
            (&& (== (strByte src ep) 46)
                (isDigit (strByte src (+ ep 1)))))
        (let ((fp (skipDigits src (+ ep 1) len)))
          { (emitToken TK_FLOAT numStart fp tokens src) fp })
        { (emitToken TK_INT numStart ep tokens src) ep })))

; Public lexer interface.
; ------------------------------------------------------------------

(pub :: lex (-> Int Int))
(pub fn (lex src)
  (lexTokens src 0 (strLen src) (vecNew)))

; ------------------------------------------------------------------
; AXTAGs, scanned separately from tokenization.
;
; stage0's lexer emits an `Axtag` token and its parser consumes the
; contiguous run of them sitting immediately before a declaration.
; Reproducing that inside `lexTokens` would mean threading an
; accumulator through every one of its recursive calls, and a stray
; token in the stream is the kind of change that breaks parsing
; somewhere unrelated. This is a second pass instead: it produces
; (offset, content) pairs, and the parser partitions them by
; declaration position, which is the same attachment stage0 performs -
; an AXTAG anywhere other than directly above a declaration is a parse
; error under stage0 (probed: `expected expression, found
; `;@axiom:pure``), so no well-formed program can tell the two rules
; apart.
;
; It must skip exactly what the lexer skips, or a `;@axiom:` inside a
; string literal becomes a tag: string bodies with their escapes, and
; char literals.
(pub struct AxtagEnt (off : Int) (content : Int))

(pub :: scanAxtags (-> Int Int))
(pub fn (scanAxtags src)
  (let ((acc vecNew))
    { (scanAxtagsFrom src 0 (strLen src) acc) acc }))

(pub :: scanAxtagsFrom (-> Int Int Int Int Int))
(pub fn (scanAxtagsFrom src pos len acc)
  (if (>= pos len)
      0
      (let ((ch (strByte src pos)))
        (if (== ch 34)
            (scanAxtagsFrom src (skipStringBody src (+ pos 1) len) len acc)
        (if (== ch 39)
            (scanAxtagsFrom src (skipCharBody src (+ pos 1) len) len acc)
        (if (== ch 59)
            (let ((nl (findNewline src pos len)))
              {
                (if (== (hasAxiomPrefix src (+ pos 1) len) 1)
                    (vecPush acc
                      (cast Int (AxtagEnt pos
                                  (strSlice src (+ pos 8)
                                            (- nl (+ pos 8))))))
                    0)
                (scanAxtagsFrom src nl len acc)
              })
        (scanAxtagsFrom src (+ pos 1) len acc)))))))

; `@axiom:` is seven bytes; the tag's content starts one past them,
; which is why the slice above begins at pos+8 (the `;` plus seven).
(pub :: hasAxiomPrefix (-> Int Int Int Int))
(pub fn (hasAxiomPrefix src pos len)
  (if (> (+ pos 7) len)
      0
      (if (&& (== (strByte src pos) 64)
          (&& (== (strByte src (+ pos 1)) 97)
          (&& (== (strByte src (+ pos 2)) 120)
          (&& (== (strByte src (+ pos 3)) 105)
          (&& (== (strByte src (+ pos 4)) 111)
          (&& (== (strByte src (+ pos 5)) 109)
              (== (strByte src (+ pos 6)) 58)))))))
          1
          0)))

(pub :: findNewline (-> Int Int Int Int))
(pub fn (findNewline src pos len)
  (if (>= pos len)
      len
      (if (== (strByte src pos) 10)
          pos
          (findNewline src (+ pos 1) len))))

(pub :: skipStringBody (-> Int Int Int Int))
(pub fn (skipStringBody src pos len)
  (if (>= pos len)
      len
      (let ((ch (strByte src pos)))
        (if (== ch 92)
            (skipStringBody src (+ pos 2) len)
        (if (== ch 34)
            (+ pos 1)
        (skipStringBody src (+ pos 1) len))))))

(pub :: skipCharBody (-> Int Int Int Int))
(pub fn (skipCharBody src pos len)
  (if (>= pos len)
      len
      (let ((ch (strByte src pos)))
        (if (== ch 92)
            (skipCharBody src (+ pos 2) len)
        (if (== ch 39)
            (+ pos 1)
        (skipCharBody src (+ pos 1) len))))))
