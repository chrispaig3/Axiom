; driver.ax - the command-line surface, and the native toolchain.
;
; Until this module existed, the self-hosted compiler was
; `stage1 FILE [TARGET] > out.ll`: it emitted LLVM text on stdout and
; could do nothing else. Producing an executable meant a human running
; `llc` and `cc` afterwards, which is what every gate script in this
; repository does. A compiler that cannot finish the job is a component,
; not a compiler, and this is the difference.
;
; ------------------------------------------------------------------
; The argument grammar is STRICTLY ADDITIVE, and that is a constraint
; rather than a courtesy.
;
; Five harnesses invoke stage1 as `stage1 FILE [TARGET]` -
; check-self-host.sh, check-diagnostics.sh (twice), check-bootstrap.sh
; and check-stdlib-selfhost.sh. A subcommand CLI that replaced that
; spelling would break all five in the same commit, and they are the
; only gates that watch stage1 at all: losing them simultaneously means
; losing the ability to bisect anything that follows. So a first
; argument that names a known subcommand is parsed as one, and anything
; else keeps its old meaning as an input path.
;
; The cost of that rule is a file literally named `build`, `check`,
; `run`, `emit-llvm` or `version` with no extension, which is read as a
; subcommand. `--` now ends option parsing, which is the fix for a
; filename beginning with a dash; a bare word that collides with a
; subcommand name is still ambiguous and still resolves to the command.
;
; The ambiguity cuts the other way too, and used to cut silently:
; `axiom buidl f.ax` was read as FILE=`buidl` TARGET=`f.ax` and answered
; `cannot read input: buidl`, discarding the filename the user had
; actually typed. `rejectTypoedSubcommand` breaks that tie by asking the
; filesystem - an unreadable first operand within two edits of a command
; name is a typo, not a file.
; ------------------------------------------------------------------
(import core)

(import Host)

(import Mem)

(import Str)

(import Vec)

(import Sys)

(import Path)

(import parser)

(import codegen)

(import build)

(import diag)

(import render)

; ------------------------------------------------------------------
; Exit codes.
;
;   0  success
;   1  the PROGRAM is wrong: an unreadable input, a syntax error, a
;      failing check, no entry point (AX4001), or an unresolvable import
;      (AX5001 - stage0's code for it)
;   2  the COMMAND LINE is wrong: an unknown command or flag, or a flag
;      given the wrong number of values
;   3  a module could not be read or parsed, or a target name is unknown
;      - `dieImport`'s status, which the rest of the compiler reaches
;      through codegen rather than through this file
;   4  a native tool failed or is missing
;
; Two of these were previously documented wrongly in this comment, in
; opposite directions, and the errors survived because nothing derived
; the table from the code. It claimed 2 meant "a parse error" - untrue
; since the parse-error port moved syntax errors to 1, leaving 2 unused
; until usage errors took it - and it claimed 3 was "retired", which was
; true only of the import path: `dieImport` still exits 3 from four
; sites, and an entry file importing an unparsable module still does.
;
; 4 is deliberately distinct from 1 and is this compiler's own choice,
; NOT the retired compiler's - that one exited 1 for a failing llc or
; cc. The distinction is kept because "your program is wrong" and "llc
; is not installed" are not the same news, and a driver that reports
; them identically sends the reader to the wrong place.
; ------------------------------------------------------------------
(pub :: exitToolFailed Int)

(pub fn (exitToolFailed) 4)

; ------------------------------------------------------------------
; Running a native tool.
; ------------------------------------------------------------------
; Run `tool` with the arguments in `args`, a Vec of Str, answering the
; child's exit code, or a negative errno if it could not be started.
;
; `argv[0]` is the tool's own name, which the kernel does not supply and
; which several tools read back out of their own argv.
(pub :: runTool (-> String Int Int))

;@axiom:effect(io)
(pub fn (runTool tool args)
  (let ((n (vecLen args)))
    (let ((v (memAlloc (* (+ n 2) 8))))
      {
        (memSetWord v 0 (strCStr (strDup tool)))
        (fillArgv v args 0 n)
        (memSetWord v (+ n 1) 0)
        ; The stdlib boundary. `sysRunPath` answers a `Result` since
        ; 0.3.4 - `Err` is the spawn failing, the tool never ran - and
        ; the compiler's own phases are ERR-ADOPT-1 slice 4, not this
        ; one. So the Result is collapsed here, and it is collapsed
        ; back onto THE EXACT CONTRACT EVERY CALLER ALREADY TESTS: a
        ; NEGATED ERRNO when the tool could not be started, the child's
        ; own code otherwise.
        ;
        ; It was `127` for one commit - "command not found", the
        ; shell's convention - and that broke the build on all three
        ; platforms. Every caller here distinguishes the two cases BY
        ; SIGN: `(if (< rc 0)` above `opt` prints "not found on PATH;
        ; building without mid-level optimisation" and CONTINUES, while
        ; any non-zero non-negative rc fails the build. 127 is
        ; positive, so a missing `opt` stopped being survivable -
        ; which `check-driver.sh` exists to catch and did.
        (match (sysRunPath tool v sysEnvp)
          ((Ok code) code)
          ((Err e) (- 0 (errCode e)))
        )
      }
    )
  )
)

(pub :: fillArgv (-> Int Int Int Int Int))

(pub fn (fillArgv v args i n)
  (if (>= i n)
    0
    ; Every element is copied, because a Str produced by slicing
    ; shares its bytes with a larger string and stops at no NUL.
    {
      (memSetWord v (+ i 1) (strCStr (strDup (vecGetStr args i))))
      (fillArgv v args (+ i 1) n)
    }
  )
)

(pub :: argsOf3 (-> String String String Int))

(pub fn (argsOf3 a b c)
  (let ((v vecNew))
    {
      (vecPush
        v        (cast Int a)
      )
      (vecPush
        v        (cast Int b)
      )
      (vecPush
        v        (cast Int c)
      )
      v
    }
  )
)

; ------------------------------------------------------------------
; The build pipeline: IR -> opt -> llc -> cc.
;
; The order, the argument vectors and the failure rules are stage0's,
; because two compilers that drive the toolchain differently are two
; compilers that produce different binaries from the same source - and
; the bootstrap fixpoint cannot see that, since both stages would carry
; the same driver. Copying stage0 is what keeps the comparison honest
; while stage0 is still around to compare against.
; ------------------------------------------------------------------
; `-relocation-model=pic` is required of EVERY llc invocation in this
; project. llc's default relocation model for ELF is `static`, every
; current Linux distribution links PIE by default, and Axiom always has
; a `.bss` global - the bump allocator's cursor - so the link fails with
; `R_X86_64_32S against .bss`. It is masked at -O2, where the x86
; backend picks PC-relative addressing anyway, and cannot be reproduced
; on macOS at all.
(pub :: llcRelocArg String)

(pub fn (llcRelocArg) "-relocation-model=pic")

; Optimise `llPath` into `<base>.opt.ll`, answering the path llc should
; read.
;
; A MISSING `opt` is a warning and the unoptimised IR is used; a PRESENT
; `opt` that fails is fatal. That distinction is stage0's and it is
; load-bearing in both directions. It has to be a warning because `opt`
; is not always installed - and it has to be survivable, because
; without its tail-call pass a stage2 compiling its own source
; overflows its stack.
(pub :: runOpt (-> String Int String String))

;@axiom:effect(io)
(pub fn (runOpt llPath optLevel outPath)
  (if (<= optLevel 0)
    llPath
    (let ((lvl 
      (if (> optLevel 3)
        3
        optLevel
      )
    ))
      (let ((args 
        (let ((v vecNew))
          {
            (vecPush
              v              (cast Int (cat2 "-O" (fmtIntStr lvl)))
            )
            (vecPush
              v              (cast Int llPath)
            )
            (vecPush
              v              (cast Int "-S")
            )
            (vecPush
              v              (cast Int "-o")
            )
            (vecPush
              v              (cast Int outPath)
            )
            v
          }
        )
      ))
        (let ((rc (runTool "opt" args)))
          (if (< rc 0)
            {
              (writeStderrStr "warning: `opt` not found on PATH; building without mid-level optimisation (deeply recursive code may exhaust the stack)\n")
              llPath
            }
            (if (!= rc 0)
              ""
              outPath
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; A toolchain failure as AX4003.
;
; `error: llc failed` was a bare stderr write: no code, no span, no
; format, invisible to anything reading AXDL or JSON, and unexplainable
; even though `axiom explain AX4003` has had an answer for it since the
; registry existed. stage0 had the same gap from the other side - it
; defined TOOLCHAIN_FAILURE and returned bare `String`s - so this is one
; of the two codes neither compiler ever constructed.
;
; The MESSAGE keeps the wording the driver has always used. That is not
; only because check-driver.sh greps it: naming the tool that failed is
; the whole content of the diagnostic, and the reason the gate greps it
; is that a build blamed on the wrong tool is the failure mode here -
; `cc` complaining about an object llc never wrote.
;
; Spanless, like AX4001 and AX5001: there is no source position for "the
; assembler exited 1". Returns `exitToolFailed` so the call sites read
; the way they did.
(pub :: toolFailDiag (-> String String Int))

;@axiom:effect(io)
(pub fn (toolFailDiag msg help)
  (let (
    (d (mkDiag
      SEV_ERROR      "AX4003"      "toolchain-failure"      0      msg      0      0      help
    ))
    (ds vecNew)
    (units vecNew)
  )
    {
      (vecPush ds d)
      (vecPush
        units        (cast Int (CUnit2
          "<toolchain>"          ""          (cast String 0)
        ))
      )
      (let ((out (renderDiagsFormat diagFormatFromArgv ds units)))
        (sysWriteFd 2 (strData out) (strLen out))
      )
      exitToolFailed
    }
  )
)

; ------------------------------------------------------------------
; Which linker, which archive spelling, which suffix: the MODULE
; decides, by the `target triple` line the emitter wrote first, not the
; host. A Windows executable is linked on macOS and Linux (cross) long
; before any Windows runner exists, and `uname` on those hosts would
; answer for the wrong machine. The four POSIX targets share one
; answer - `cc`, `lib<name>.a`, no suffix - and windows-x86_64 has the
; other: `lld-link`, `<name>.lib`, `.exe`.
; ------------------------------------------------------------------
(pub :: irTargetIsWindows (-> String Bool))

(pub fn (irTargetIsWindows ir) (>= (strFindSub ir "target triple = \"x86_64-pc-windows-msvc\"" 0) 0))

; `<dir>/lib<name>.a`, or `<dir>/<name>.lib` where the link is
; lld-link's: both the auto-link probe and the grounding pass spell an
; archive's path through here, so the two cannot disagree about what a
; library is called.
(pub :: archivePathIn (-> String String Bool String))

(pub fn (archivePathIn dir lib isWin)
  (if isWin
    (cat3 (cat2 dir "/") lib ".lib")
    (cat2 (cat3 dir "/lib" lib) ".a")
  )
)

; Copy the caller's already-formatted link arguments (`-L<dir>`,
; `-l<name>`) onto the `cc` argument vector.
(pub :: appendLinkArgs (-> Int Int Int Int))

(pub fn (appendLinkArgs v linkArgs i)
  (if (== linkArgs 0)
    0
    (if (>= i (vecLen linkArgs))
      0
      {
        (vecPush v (vecGet linkArgs i))
        (appendLinkArgs v linkArgs (+ i 1))
      }
    )
  )
)

; The same arguments in lld-link's spelling: `-L<dir>` is
; `/libpath:<dir>` and `-l<name>` is `<name>.lib`. Anything else is
; copied as it came, which is what `cc` would have done with it too.
(pub :: appendLinkArgsWindows (-> Int Int Int Int))

(pub fn (appendLinkArgsWindows v linkArgs i)
  (if (== linkArgs 0)
    0
    (if (>= i (vecLen linkArgs))
      0
      (let ((a
        (cast String (vecGet linkArgs i))
      ))
        {
          (if (strStartsWith a "-L")
            (vecPush
              v              (cast Int (cat2 "/libpath:" (strSlice a 2 (- (strLen a) 2))))
            )
            (if (strStartsWith a "-l")
              (vecPush
                v                (cast Int (cat2 (strSlice a 2 (- (strLen a) 2)) ".lib"))
              )
              (vecPush v (vecGet linkArgs i))
            )
          )
          (appendLinkArgsWindows v linkArgs (+ i 1))
        }
      )
    )
  )
)

; Assemble `llPath` to `objPath`, then link it to `outPath`.
; Answers 0, or `exitToolFailed`.
;
; `isWin` selects the linker: `cc` for the four POSIX targets, and for
; windows-x86_64 `lld-link /subsystem:console /entry:mainCRTStartup
; /out:<out> <obj> <libs>` - no C compiler anywhere on that path, by
; decision (the design's Q2), which is one tool fewer than the status
; quo rather than one more. `--emit-staticlib` is refused there for
; now: `ar` has no place in a Windows link and `llvm-lib` is a later
; phase, and saying so beats half-supporting it (Q11).
(pub :: assembleAndLink (-> String String String Int Int Bool Int))

;@axiom:effect(io)
(pub fn (assembleAndLink llPath objPath outPath optLevel linkArgs isWin)
  (let ((lvl 
    (if (> optLevel 3)
      3
      (if (< optLevel 0)
        0
        optLevel
      )
    )
  ))
    (let ((llcArgs 
      (let ((v vecNew))
        {
          (vecPush
            v            (cast Int llPath)
          )
          (vecPush
            v            (cast Int "-filetype=obj")
          )
          (vecPush
            v            (cast Int "-o")
          )
          (vecPush
            v            (cast Int objPath)
          )
          (vecPush
            v            (cast Int (cat2 "-O" (fmtIntStr lvl)))
          )
          (vecPush
            v            (cast Int llcRelocArg)
          )
          v
        }
      )
    ))
      (let ((rc (runTool "llc" llcArgs)))
        (if (!= rc 0)
          (toolFailDiag
            (if (< rc 0)
              "could not run `llc`"
              "llc failed"
            )            "install LLVM and put `llc` on PATH; `--emit-llvm` keeps the IR so the step can be run by hand"
          )
          (if isWin
            (if cgStaticlib
              (toolFailDiag
                "`--emit-staticlib` is not supported for windows-x86_64 yet"                "the Windows link is lld-link's and `ar` has no place in it; an archive for a Windows host is a later phase of the Windows track"
              )
              (let ((linkArgsW
                (let ((v vecNew))
                  {
                    (vecPush
                      v                      (cast Int "/subsystem:console")
                    )
                    (vecPush
                      v                      (cast Int "/entry:mainCRTStartup")
                    )
                    (vecPush
                      v                      (cast Int (cat2 "/out:" outPath))
                    )
                    (vecPush
                      v                      (cast Int objPath)
                    )
                    (appendLinkArgsWindows v linkArgs 0)
                    v
                  }
                )
              ))
                (let ((rcw (runTool "lld-link" linkArgsW)))
                  (if (!= rcw 0)
                    (toolFailDiag
                      (if (< rcw 0)
                        "could not run `lld-link`"
                        "lld-link failed"
                      )                      "lld-link links a windows-x86_64 executable; it ships with LLVM's lld (`brew install lld`, `apt-get install lld`, choco's llvm) - put it on PATH, and put a `kernel32.lib` on a `--link-search` directory"
                    )
                    0
                  )
                )
              )
            )
          (if cgStaticlib
            ; `--emit-staticlib`: the object is ARCHIVED, not linked -
            ; a Rust (or C) host links it, and its `pub fn`s are the
            ; host's `extern "C"` symbols (docs/ffi.md, the other
            ; direction). The module was emitted without the `@main`
            ; wrapper, so the host's own `main` is the only one.
            (let ((arArgs 
              (let ((v vecNew))
                {
                  (vecPush
                    v                    (cast Int "rcs")
                  )
                  (vecPush
                    v                    (cast Int outPath)
                  )
                  (vecPush
                    v                    (cast Int objPath)
                  )
                  v
                }
              )
            ))
              {
                (unwrapOr (sysUnlink (strCStr outPath)) 0)
                (let ((rc3 (runTool "ar" arArgs)))
                  (if (!= rc3 0)
                    (toolFailDiag
                      (if (< rc3 0)
                        "could not run `ar`"
                        "ar failed"
                      )                      "`ar` writes the static archive; put it on PATH (it ships with every C toolchain)"
                    )
                    0
                  )
                )
              }
            )
            ; The FFI's link inputs, in DECLARATION
            ; ORDER. `check-reproducible.sh` compares
            ; bytes, and an unordered link line would
            ; flip them run to run.
            ;
            ; Before `--link-lib`, this vector was
            ; three entries and the language could not
            ; name an external symbol, so there was
            ; nothing for a `-l` to resolve.
            (let ((ccArgs 
              (let ((v vecNew))
                {
                  (vecPush
                    v                    (cast Int objPath)
                  )
                  (appendLinkArgs v linkArgs 0)
                  (vecPush
                    v                    (cast Int "-o")
                  )
                  (vecPush
                    v                    (cast Int outPath)
                  )
                  v
                }
              )
            ))
              (let ((rc2 (runTool "cc" ccArgs)))
                (if (!= rc2 0)
                  (toolFailDiag
                    (if (< rc2 0)
                      "could not run `cc`"
                      "cc failed"
                    )                    "a C compiler drives the link step; put `cc` on PATH"
                  )
                  0
                )
              )
            )
          )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `--crate DIR`, the whole of it: before the program is compiled, each
; crate's binding module is brought up to date with its source when
; `axiom-bindgen` is on PATH (`cargo install --path rust/axiom-bindgen`
; puts it there), and its archive is built when `cargo` is and the
; archive is missing. Each step says what it ran on stderr. Neither
; tool present, nothing happens and the ordinary diagnostics apply -
; AX5001 for a missing module, AX4004 for a missing archive.
;
; The package name comes from `DIR/Cargo.toml`; the archive stem is
; the name with `-` as `_`; the module is the stem of the one `.ax`
; file in `DIR/axiom/`, or, for a fresh crate, the package name in
; CamelCase with a leading `axiom-` dropped (`axiom-demo` -> `Demo`,
; `greeter` -> `Greeter`).
; ------------------------------------------------------------------
(pub :: prepareCrates Int)

;@axiom:effect(io)
(pub fn (prepareCrates)
  (let (
    (crates crateDirsOf)
    (mut i 0)
  )
    {
      (while (< i (vecLen crates))
        {
          (prepareCrate
            (cast String (vecGet crates i))
          )
          (set i (+ i 1))
        })
      0
    }
  )
)

(pub :: prepareCrate (-> String Int))

;@axiom:effect(io)
(pub fn (prepareCrate dirIn)
  (let ((dir (pathWithSlash dirIn)))
    (let ((pkg (cargoPackageName (cat2 dir "Cargo.toml"))))
      (if (== (strLen pkg) 0)
        0
        (let (
          (stem (dashesToUnderscores pkg))
          (module (crateModuleName dir pkg))
        )
          {
            (if (sysFileExists (strCStr (cat2 dir "src")))
              (refreshBindings dir stem module)
              0
            )
            ; A cargo staticlib is `lib<stem>.a` on every host this
            ; driver runs on - the `.lib` spelling belongs to the import
            ; libraries a WINDOWS LINK consumes, and `--crate` for a
            ; Windows target is not a thing yet (docs/ffi.md has no
            ; Windows story) - so the archive is looked for as `.a`.
            (if (libExistsIn (crateTargetDirs dir) stem 0 false)
              0
              (buildCrate dir pkg)
            )
            0
          }
        )
      )
    )
  )
)

(pub :: crateTargetDirs (-> String Int))

(pub fn (crateTargetDirs dir)
  (let ((v vecNew))
    {
      (vecPush
        v        (cast Int (cat2 dir "target/release"))
      )
      (vecPush
        v        (cast Int (cat2 dir "../target/release"))
      )
      (vecPush
        v        (cast Int (cat2 dir "../../target/release"))
      )
      v
    }
  )
)

; Regenerate the module when `axiom-bindgen --check` finds it stale or
; absent. Exit 2 from `--check` is "no such file" as well as a usage
; error, so a missing module regenerates; a bindgen that is not on
; PATH answers below zero and nothing is written.
(pub :: refreshBindings (-> String String String Int))

;@axiom:effect(io)
(pub fn (refreshBindings dir stem module)
  (let ((modPath (cat3 (cat2 dir "axiom/") module ".ax")))
    (let ((checkArgs 
      (let ((v vecNew))
        {
          (vecPush
            v            (cast Int "--src")
          )
          (vecPush
            v            (cast Int (cat2 dir "src"))
          )
          (vecPush
            v            (cast Int "--lib")
          )
          (vecPush
            v            (cast Int stem)
          )
          (vecPush
            v            (cast Int "--module")
          )
          (vecPush
            v            (cast Int module)
          )
          (vecPush
            v            (cast Int "--check")
          )
          (vecPush
            v            (cast Int modPath)
          )
          (vecPush
            v            (cast Int "--quiet")
          )
          v
        }
      )
    ))
      (let ((rc (runToolQuiet "axiom-bindgen" checkArgs)))
        (if (|| (< rc 0) (== rc 0))
          0
          (let ((genArgs 
            (let ((v vecNew))
              {
                (vecPush
                  v                  (cast Int "--src")
                )
                (vecPush
                  v                  (cast Int (cat2 dir "src"))
                )
                (vecPush
                  v                  (cast Int "--lib")
                )
                (vecPush
                  v                  (cast Int stem)
                )
                (vecPush
                  v                  (cast Int "--module")
                )
                (vecPush
                  v                  (cast Int module)
                )
                (vecPush
                  v                  (cast Int "-o")
                )
                (vecPush
                  v                  (cast Int (cat2 dir "axiom"))
                )
                v
              }
            )
          ))
            {
              (writeStderrStr (cat3 "axiom: regenerating " modPath " with axiom-bindgen\n"))
              (runTool "axiom-bindgen" genArgs)
            }
          )
        )
      )
    )
  )
)

(pub :: buildCrate (-> String String Int))

;@axiom:effect(io)
(pub fn (buildCrate dir pkg)
  (let ((args 
    (let ((v vecNew))
      {
        (vecPush
          v          (cast Int "build")
        )
        (vecPush
          v          (cast Int "--release")
        )
        (vecPush
          v          (cast Int "--manifest-path")
        )
        (vecPush
          v          (cast Int (cat2 dir "Cargo.toml"))
        )
        v
      }
    )
  ))
    {
      (writeStderrStr (cat3 "axiom: building crate `" pkg "` with cargo (no archive found)\n"))
      (runTool "cargo" args)
    }
  )
)

; `runTool` for a probe whose exit status is the whole answer. The
; tool is asked to be quiet by flag (`--quiet` rides in `args`): the
; driver redirects no descriptor, so a tool that talks anyway is heard.
(pub :: runToolQuiet (-> String Int Int))

;@axiom:effect(io)
(pub fn (runToolQuiet tool args) (runTool tool args))

; `name = "..."` under `[package]` in a Cargo manifest, or "".
(pub :: cargoPackageName (-> String String))

;@axiom:effect(io)
(pub fn (cargoPackageName path)
  (if (sysFileExists (strCStr path))
    (let ((text (sysReadFile (strCStr path))))
      (let ((at (strFindSub text "[package]" 0)))
        (if (< at 0)
          ""
          (let ((nm (strFindSub text "name" at)))
            (if (< nm 0)
              ""
              (let ((q1 (strFindByte text 34 nm)))
                (if (< q1 0)
                  ""
                  (let ((q2 (strFindByte text 34 (+ q1 1))))
                    (if (< q2 0)
                      ""
                      (strSlice text (+ q1 1) (- q2 (+ q1 1)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    ""
  )
)

(pub :: dashesToUnderscores (-> String String))

(pub fn (dashesToUnderscores s)
  (let (
    (out (strDup s))
    (mut i 0)
  )
    {
      (while (< i (strLen out))
        {
          (if (== (strByte out i) 45)
            (__store8 (strData out) i 95)
            0
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

; The module name: the one `.ax` in `DIR/axiom/`, else CamelCase of
; the package name without a leading `axiom-`.
(pub :: crateModuleName (-> String String String))

;@axiom:effect(io)
(pub fn (crateModuleName dir pkg)
  (let (
    (entries (sysReadDir (strCStr (cat2 dir "axiom"))))
    (mut found "")
    (mut n 0)
    (mut i 0)
  )
    {
      (while (< i (vecLen entries))
        {
          ; `Name.ax` and nothing else: the first `.` is the
          ; extension's. Until 2026-08-22 this compared with `<`,
          ; which no plain name satisfies, so a crate whose module
          ; was `Hash.ax` got a second module named for the package
          (let ((e 
            (cast String (vecGet entries i))
          ))
            (if (&& (> (strLen e) 3) (&& (strEq (strSlice e (- (strLen e) 3) 3) ".ax") (== (strFindByte e 46 0) (- (strLen e) 3))))
              {
                (if (== (strLen found) 0)
                  {
                    (set found (strSlice e 0 (strFindByte e 46 0)))
                    0
                  }
                  0
                )
                (set n (+ n 1))
                0
              }
              0
            )
          )
          (set i (+ i 1))
        })
      ; EXACTLY one, not the first of several. `sysReadDir` answers in
      ; directory order, which is a filesystem fact rather than a
      ; property of the crate: two `.ax` files under `axiom/` and the
      ; module this crate is bound as depends on which one the kernel
      ; happens to hand back first, so the same crate could bind
      ; differently on two machines and the emitted binding would name
      ; a different module. At one candidate there is nothing to choose
      ; between and the order cannot matter; above one the answer no
      ; longer depends on the listing at all, because the
      ; package-derived name below does not read it.
      ;
      ; Sorting was the other option and it is deterministic-WRONG: it
      ; still picks one file of several and still overwrites it, just
      ; alphabetically, so a hand-written module beside a generated one
      ; gets clobbered on every machine instead of on some of them.
      (if (== n 1)
        found
        (camelOf
          (if (strStartsWith pkg "axiom-")
            (strSlice pkg 6 (- (strLen pkg) 6))
            pkg
          )
        )
      )
    }
  )
)

; `my-crate_name` -> `MyCrateName`.
(pub :: camelOf (-> String String))

(pub fn (camelOf s)
  (let (
    (out (strAlloc (strLen s)))
    (mut i 0)
    (mut o 0)
    (mut up 1)
  )
    {
      (while (< i (strLen s))
        {
          (let ((b (strByte s i)))
            (if (|| (== b 45) (== b 95))
              (set up 1)
              {
                (__store8
                  (strData out)                  o                  (if (&& (== up 1) (&& (>= b 97) (<= b 122)))
                    (- b 32)
                    b
                  )
                )
                (set o (+ o 1))
                (set up 0)
              }
            )
          )
          (set i (+ i 1))
        })
      (strSlice out 0 o)
    }
  )
)

; `--emit-staticlib` anywhere on the command line.
; ------------------------------------------------------------------
; GROUNDING: every `declare` the module writes must name a symbol that
; some archive on the link line could define.
;
; This is the FFI's central claim, made mechanical. `foreign` emitted
; `call i64 @putchar(...)` into a module that declared no `@putchar`;
; `check` answered OK and the program died two stages later inside
; `opt`, with a message about generated code and no span into the
; source (the self-hosting record). An `extern` naming a symbol that
; does not exist is the same defect, and this refuses it BEFORE the
; toolchain runs - which is the whole difference between a compiler
; diagnostic and a linker error about a file the user never wrote.
;
; What it proves, precisely: the name appears nowhere in any archive on
; the link line, so nothing there can define it. The converse is
; weaker - a name that DOES appear might be a string constant rather
; than a definition - so this refuses ABSENCE and never manufactures
; presence. That asymmetry is the right one: a false rejection would
; break a correct build, and the case that actually happens is a typo,
; which is absence.
;
; The declares are read out of the IR the driver already holds, not
; passed down from codegen. That is deliberate: it checks exactly the
; text that is about to be assembled, so a declare the emitter writes
; by some path this file does not know about is still covered.
; ------------------------------------------------------------------
(pub :: buildFailDiag (-> String String String String Int))

;@axiom:effect(io)
(pub fn (buildFailDiag code slug msg help)
  (let (
    (d (mkDiag
      SEV_ERROR      code      slug      0      msg      0      0      help
    ))
    (ds vecNew)
    (units vecNew)
  )
    {
      (vecPush ds d)
      (vecPush
        units        (cast Int (CUnit2
          "<link>"          ""          (cast String 0)
        ))
      )
      (let ((out (renderDiagsFormat diagFormatFromArgv ds units)))
        (sysWriteFd 2 (strData out) (strLen out))
      )
      exitToolFailed
    }
  )
)

; The first index at or after `from` where `needle` occurs in `hay`, or
; -1. Anchored on the first byte so the common case is one scan.
(pub :: strFindSub (-> String String Int Int))

(pub fn (strFindSub hay needle from)
  (if (== (strLen needle) 0)
    from
    (let ((i (strFindByte hay (strByte needle 0) from)))
      (if (< i 0)
        (- 0 1)
        (if (subMatchesAt hay needle i 0)
          i
          (strFindSub hay needle (+ i 1))
        )
      )
    )
  )
)

(pub :: subMatchesAt (-> String String Int Int Bool))

(pub fn (subMatchesAt hay needle at k)
  (if (>= k (strLen needle))
    true
    (if (>= (+ at k) (strLen hay))
      false
      (if (== (strByte hay (+ at k)) (strByte needle k))
        (subMatchesAt hay needle at (+ k 1))
        false
      )
    )
  )
)

; `-L<dir>` and `-l<name>` back into `<dir>/lib<name>.a` paths - or
; `<dir>/<name>.lib` for a Windows link - every directory crossed with
; every library, because the link line does not say which archive
; lives where and neither does this.
(pub :: archivePathsOf (-> Int Bool Int))

(pub fn (archivePathsOf linkArgs isWin)
  (let (
    (dirs vecNew)
    (libs vecNew)
    (out vecNew)
    (mut i 0)
  )
    {
      (if (== linkArgs 0)
        0
        (while (< i (vecLen linkArgs))
          {
            (let ((a 
              (cast String (vecGet linkArgs i))
            ))
              (if (strStartsWith a "-L")
                (vecPush
                  dirs                  (cast Int (strSlice a 2 (- (strLen a) 2)))
                )
                (if (strStartsWith a "-l")
                  (vecPush
                    libs                    (cast Int (strSlice a 2 (- (strLen a) 2)))
                  )
                  0
                )
              )
            )
            (set i (+ i 1))
          })
      )
      (let ((mut d 0))
        (while (< d (vecLen dirs))
          {
            (let ((mut l 0))
              (while (< l (vecLen libs))
                {
                  (vecPush
                    out                    (cast Int (archivePathIn
                      (cast String (vecGet dirs d))                      (cast String (vecGet libs l))                      isWin
                    ))
                  )
                  (set l (+ l 1))
                })
            )
            (set d (+ d 1))
          })
      )
      out
    }
  )
)

; The `; axiom-extern-lib NAME` lines codegen writes beside the
; declares: one per `extern` block the program or its imports
; declare.
(pub :: externLibsOf (-> String Int))

(pub fn (externLibsOf ir)
  (let (
    (out vecNew)
    (mut at 0)
  )
    {
      (while (>= at 0)
        (let ((d (strFindSub ir "\n; axiom-extern-lib " at)))
          (if (< d 0)
            (set at (- 0 1))
            (let ((start (+ d 20)))
              (let ((end (strFindByte ir 10 start)))
                (if (< end 0)
                  (set at (- 0 1))
                  {
                    (let ((nm (strSlice ir start (- end start))))
                      (if (== (strIndexIn out nm) (- 0 1))
                        (vecPush
                          out                          (cast Int nm)
                        )
                        0
                      )
                    )
                    (set at end)
                  }
                )
              )
            )
          )
        ))
      out
    }
  )
)

; The link line a build actually uses: the explicit `--link-search`
; and `--link-lib` arguments first, then every directory of
; `$AXIOM_LINK_SEARCH`, then `<dir>/../target/release` and
; `<dir>/../../target/release` beside each `$AXIOM_PATH` entry (a
; crate's `axiom/` binding directory sits next to its `target/`),
; and then `-l<lib>` for every `extern` block whose `lib<lib>.a` some
; search directory holds and no explicit flag already names. The
; block's library string was dead data until 2026-08-22: every build
; repeated it as `--link-lib` and named the target directory too.
(pub :: effectiveLinkArgs (-> String Int Int))

;@axiom:effect(io)
(pub fn (effectiveLinkArgs ir explicit)
  (let (
    (v vecNew)
    (dirs vecNew)
    (libs vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen explicit))
        {
          (let ((a 
            (cast String (vecGet explicit i))
          ))
            {
              (vecPush
                v                (cast Int a)
              )
              (if (strStartsWith a "-L")
                (vecPush
                  dirs                  (cast Int (strSlice a 2 (- (strLen a) 2)))
                )
                (if (strStartsWith a "-l")
                  (vecPush
                    libs                    (cast Int (strSlice a 2 (- (strLen a) 2)))
                  )
                  0
                )
              )
            }
          )
          (set i (+ i 1))
        })
      (addSearchDir v dirs (sysEnv "AXIOM_LINK_SEARCH"))
      (addAxiomPathDirs v dirs (sysEnv "AXIOM_PATH"))
      ; a crate's own `target/release`, or its workspace's one or two
      ; levels up (`rust/examples/demo` builds into `rust/target`)
      (let (
        (crates crateDirsOf)
        (mut c 0)
      )
        (while (< c (vecLen crates))
          {
            (let ((cd 
              (pathWithSlash
                (cast String (vecGet crates c))
              )
            ))
              {
                (addOneDir v dirs (cat2 cd "target/release"))
                (addOneDir v dirs (cat2 cd "../target/release"))
                (addOneDir v dirs (cat2 cd "../../target/release"))
              }
            )
            (set c (+ c 1))
          })
      )
      (let (
        (wanted (externLibsOf ir))
        (mut j 0)
      )
        (while (< j (vecLen wanted))
          {
            (let ((lib 
              (cast String (vecGet wanted j))
            ))
              (if (== (strIndexIn libs lib) (- 0 1))
                (if (libExistsIn dirs lib 0 (irTargetIsWindows ir))
                  {
                    (vecPush
                      v                      (cast Int (cat2 "-l" lib))
                    )
                    (vecPush
                      libs                      (cast Int lib)
                    )
                  }
                  0
                )
                0
              )
            )
            (set j (+ j 1))
          })
      )
      v
    }
  )
)

(pub :: addSearchDir (-> Int Int String Int))

;@axiom:effect(io)
(pub fn (addSearchDir v dirs list)
  (let (
    (parts (strSplit list 58))
    (mut i 0)
  )
    {
      (while (< i (vecLen parts))
        {
          (let ((d 
            (cast String (vecGet parts i))
          ))
            (if (&& (> (strLen d) 0) (== (strIndexIn dirs d) (- 0 1)))
              (if (sysFileExists (strCStr d))
                {
                  (vecPush
                    v                    (cast Int (cat2 "-L" d))
                  )
                  (vecPush
                    dirs                    (cast Int d)
                  )
                }
                0
              )
              0
            )
          )
          (set i (+ i 1))
        })
      0
    }
  )
)

(pub :: addAxiomPathDirs (-> Int Int String Int))

;@axiom:effect(io)
(pub fn (addAxiomPathDirs v dirs list)
  (let (
    (parts (strSplit list 58))
    (mut i 0)
  )
    {
      (while (< i (vecLen parts))
        {
          (let ((p 
            (cast String (vecGet parts i))
          ))
            (if (> (strLen p) 0)
              {
                (addOneDir v dirs (cat2 (pathWithSlash p) "../target/release"))
                (addOneDir v dirs (cat2 (pathWithSlash p) "../../target/release"))
              }
              0
            )
          )
          (set i (+ i 1))
        })
      0
    }
  )
)

(pub :: addOneDir (-> Int Int String Int))

;@axiom:effect(io)
(pub fn (addOneDir v dirs d)
  (if (== (strIndexIn dirs d) (- 0 1))
    (if (sysFileExists (strCStr d))
      {
        (vecPush
          v          (cast Int (cat2 "-L" d))
        )
        (vecPush
          dirs          (cast Int d)
        )
        0
      }
      0
    )
    0
  )
)

(pub :: libExistsIn (-> Int String Int Bool Bool))

;@axiom:effect(io)
(pub fn (libExistsIn dirs lib i isWin)
  (if (>= i (vecLen dirs))
    false
    (if (sysFileExists
      (strCStr
        (archivePathIn
          (cast String (vecGet dirs i))          lib          isWin
        )
      )
    )
      true
      (libExistsIn dirs lib (+ i 1) isWin)
    )
  )
)

; Read every archive once. A path that does not exist reads empty and
; simply grounds nothing, which lets `cc` produce its own error about
; the missing file rather than this pass inventing one.
(pub :: readArchives (-> Int Int))

;@axiom:effect(io)
(pub fn (readArchives paths)
  (let (
    (out vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen paths))
        {
          (vecPush
            out            (cast Int (sysReadFile
              (strCStr
                (cast String (vecGet paths i))
              )
            ))
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

; A symbol is grounded by an archive when the archive's symbol tables
; hold the WHOLE name: `\0_name\0` (Mach-O, a leading underscore),
; `\0name\0` (ELF), or `\0__imp_name\0` (a COFF import library, whose
; members are import descriptors rather than code: the linker resolves
; a call to `name` through `__imp_name`, and an import library made by
; `llvm-dlltool` lists ONLY that spelling - measured 2026-08-29 on one
; generated from a `.def`: `\0VirtualAlloc\0` 0 times, `__imp_
; VirtualAlloc` 2). A bare substring scan - what this was until
; 2026-08-22 - let `axffi_trip` ground against `axffi_triple` and die
; in the linker with a message about `cc`.
(pub :: symbolGrounded (-> Int String Int Bool))

(pub fn (symbolGrounded blobs name i)
  (if (>= i (vecLen blobs))
    false
    (if (blobDefines
      (cast String (vecGet blobs i))      name
    )
      true
      (symbolGrounded blobs name (+ i 1))
    )
  )
)

(pub :: blobDefines (-> String String Bool))

(pub fn (blobDefines blob name)
  (if (nulAfter blob (cat2 "_" name) 0)
    true
    (if (nulAfter blob (cat2 "__imp_" name) 0)
      true
      (nulAfter blob name 0)
    )
  )
)

; Some occurrence of `needle` that ENDS the string it sits in and does
; not continue an identifier to its left.
;
; The left test used to demand a NUL, and that is a Mach-O fact rather
; than a fact about archives. Measured on the linux-x86_64 runner, every
; occurrence of `axffi_abi_probe` in `libaxiom_demo.a`:
;
;   off=10608   before=0xbe  after=0x00
;   off=10624   before=0x00  after='_'
;   off=277958  before='.'   after='_'
;   off=278570  before='.'   after=0x00
;
; Not one is `\0name\0`. The first is the archive symbol index, where
; the earliest name follows the binary offset table rather than a NUL -
; and `axffi_abi_probe` sorts first among the crate's symbols, so it is
; that name. The last is `.text.axffi_abi_probe`: with
; `-ffunction-sections` the symbol's own `.strtab` entry is TAIL-SHARED
; with the section name, which is exactly what tail merging is for and
; means the standalone spelling never appears. `axffi_fnv1a` in the
; nostd archive is the same story.
;
; So the symbol was defined, the archive said so, and the compiler
; refused the program with AX4004 - on Linux only, since Mach-O writes
; `\0_name\0` and satisfied the old test by accident of format.
;
; The trailing NUL is what carries the real check and is unchanged: it
; is what keeps `axffi_trip` from grounding against `axffi_triple`, the
; defect this function was tightened for on 2026-08-22. To its left, a
; byte that cannot continue an identifier says the same thing portably -
; a NUL, a `.`, or the last byte of an offset table all qualify, and
; `e` in `axffi_triple` does not.
;
; Also: the old form COMMITTED to the underscore spelling the moment it
; saw `\0_name` anywhere, and answered whatever that branch decided. It
; tries both now.
(pub :: nulAfter (-> String String Int Bool))

(pub fn (nulAfter blob needle from)
  (let ((at (strFindSub blob needle from)))
    (if (< at 0)
      false
      (let ((end (+ at (strLen needle))))
        (if (&& (&& (< end (strLen blob)) (== (strByte blob end) 0)) (== (identByteAt blob (- at 1)) 0))
          true
          (nulAfter blob needle (+ at 1))
        )
      )
    )
  )
)

; Is the byte at `i` one an identifier can be made of? Off the front of
; the blob is not, which is what makes a name at offset 0 groundable.
(pub :: identByteAt (-> String Int Int))

(pub fn (identByteAt blob i)
  (if (< i 0)
    0
    (let ((b (strByte blob i)))
      (if (|| (|| (&& (>= b 65) (<= b 90)) (&& (>= b 97) (<= b 122))) (|| (&& (>= b 48) (<= b 57)) (== b 95)))
        1
        0
      )
    )
  )
)

; Every `axffi_` name an archive's tables hold, for a did-you-mean.
(pub :: archiveFfiNames (-> Int Int))

(pub fn (archiveFfiNames blobs)
  (let (
    (out vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen blobs))
        {
          (collectFfiNames
            (cast String (vecGet blobs i))            out            0
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

(pub :: collectFfiNames (-> String Int Int Int))

(pub fn (collectFfiNames blob out from)
  (let ((at (strFindSub blob "axffi_" from)))
    (if (< at 0)
      0
      (let ((end (strFindByte blob 0 at)))
        (if (< end 0)
          0
          {
            (let ((nm (strSlice blob at (- end at))))
              (if (&& (< (strLen nm) 200) (== (strIndexIn out nm) (- 0 1)))
                (vecPush
                  out                  (cast Int nm)
                )
                0
              )
            )
            (collectFfiNames blob out end)
          }
        )
      )
    )
  )
)

; The candidate sharing the longest prefix with `name`, when that
; prefix reaches past `axffi_`; "" otherwise.
(pub :: closestFfiName (-> Int String String))

(pub fn (closestFfiName names name)
  (let (
    (mut best "")
    (mut bestLen 6)
    (mut i 0)
  )
    {
      (while (< i (vecLen names))
        {
          (let ((c 
            (cast String (vecGet names i))
          ))
            (let ((k (commonPrefixLen c name 0)))
              (if (> k bestLen)
                {
                  (set best c)
                  (set bestLen k)
                }
                0
              )
            )
          )
          (set i (+ i 1))
        })
      best
    }
  )
)

(pub :: commonPrefixLen (-> String String Int Int))

(pub fn (commonPrefixLen a b i)
  (if (|| (>= i (strLen a)) (>= i (strLen b)))
    i
    (if (== (strByte a i) (strByte b i))
      (commonPrefixLen a b (+ i 1))
      i
    )
  )
)

; The name in each `declare i64 @NAME(` line of the IR.
(pub :: declareNamesOf (-> String Int))

(pub fn (declareNamesOf ir)
  (let (
    (out vecNew)
    (mut at 0)
  )
    {
      (while (>= at 0)
        (let ((d (strFindSub ir "\ndeclare " at)))
          (if (< d 0)
            (set at (- 0 1))
            (let ((sym (strFindByte ir 64 d)))
              (if (< sym 0)
                (set at (- 0 1))
                (let ((open (strFindByte ir 40 sym)))
                  (if (< open 0)
                    (set at (- 0 1))
                    {
                      (vecPush
                        out                        (cast Int (strSlice ir (+ sym 1) (- open (+ sym 1))))
                      )
                      (set at open)
                    }
                  )
                )
              )
            )
          )
        ))
      out
    }
  )
)

; The grounding check WITH a source span: the extern item that bound
; the ungrounded symbol is found among the resolved declarations, and
; the diagnostic points at it, distinguishing the three mistakes that
; used to share one message - nothing linked at all, an archive
; linked that does not define the name, and a name close to one an
; archive does define. `compileFile` runs this before the toolchain;
; `groundDeclares` below stays as the span-less fallback for IR built
; by another path.
(pub :: groundExternsSpanned (-> String Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (groundExternsSpanned ir decls units dfmt linkArgs)
  (let ((names (declareNamesOf ir)))
    (if (== (vecLen names) 0)
      0
      (let ((paths (existingPaths (archivePathsOf linkArgs (irTargetIsWindows ir)))))
        (let ((blobs (readArchives paths)))
          (groundEachSpanned
            names            blobs            paths            decls            units            dfmt            0
          )
        )
      )
    )
  )
)

(pub :: existingPaths (-> Int Int))

;@axiom:effect(io)
(pub fn (existingPaths paths)
  (let (
    (out vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen paths))
        {
          (if (sysFileExists
            (strCStr
              (cast String (vecGet paths i))
            )
          )
            (vecPush out (vecGet paths i))
            0
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

(pub :: groundEachSpanned (-> Int Int Int Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (groundEachSpanned names blobs paths decls units dfmt i)
  (if (>= i (vecLen names))
    0
    (let ((n 
      (cast String (vecGet names i))
    ))
      (if (symbolGrounded blobs n 0)
        ; grounded: now the SHAPE. A shim `#[axiom_export]` writes
        ; also exports `<sym>__sig_<params>_<ret>`, a no-op whose
        ; name spells the shim's arity and word kinds (i: a word,
        ; f: Float bits, s: a String, c: a callback), and the item's
        ; declared type spells the same string here; a difference
        ; is AX4005 at the item - a two-argument declaration over a
        ; three-argument shim used to build, link and answer garbage
        (let (
          (want (let ((it (findExternItem decls n 0)))
            (if (== it 0)
              ""
              (externSigTag (nodeB it))
            )
          ))
          (have (descriptorsOf blobs n))
        )
          (if (|| (== (strLen want) 0) (|| (== (vecLen have) 0) (>= (strIndexIn have want) 0)))
            (groundEachSpanned
              names              blobs              paths              decls              units              dfmt              (+ i 1)
            )
            (let ((item (findExternItem decls n 0)))
              (let (
                (d (mkDiag
                  SEV_ERROR                  "AX4005"                  "extern-shape"                  (if (== item 0)
                    0
                    (nodeSpan item)
                  )                  (cat3
                    (cat3 "`" n "` is exported by the crate for ")                    (cat3
                      (sigTagSpelled
                        (cast String (vecGet have 0))
                      )                      "; the `extern` item declares "                      (sigTagSpelled want)
                    )                    ""
                  )                  0                  0                  "the Rust shim and the `extern` item must agree on every parameter and the result (docs/ffi.md, the type table); regenerate the binding module with `axiom-bindgen`, or fix the hand-written item"
                ))
                (ds vecNew)
              )
                {
                  (let ((u (findExternUnit decls n units 0)))
                    (if (>= u 0)
                      (diagSetUnit d u)
                      0
                    )
                  )
                  (vecPush ds d)
                  (let ((out 
                    (renderDiagsFormat
                      dfmt                      ds                      (if (== item 0)
                        (let ((uv vecNew))
                          {
                            (vecPush
                              uv                              (cast Int (CUnit2
                                "<link>"                                ""                                (cast String 0)
                              ))
                            )
                            uv
                          }
                        )
                        units
                      )
                    )
                  ))
                    (sysWriteFd 2 (strData out) (strLen out))
                  )
                  exitToolFailed
                }
              )
            )
          )
        )
        ; the item's span is in ITS module's unit - an
        ; imported binding module, usually
        (let (
          (item (findExternItem decls n 0))
          (lib (findExternLib decls n 0))
        )
          (let (
            (msg (if (== (vecLen paths) 0)
              (cat3 "no archive is linked, and `" n "` needs one")
              (cat3 "no linked archive defines `" n "`")
            ))
            (help (if (== (vecLen paths) 0)
              (cat3 "pass `--link-lib NAME --link-search DIR` where DIR holds `libNAME.a`, or set `AXIOM_LINK_SEARCH` to the directory; the `extern` block names library \"" lib "\", and `axiom build` links `lib<name>.a` by itself when a search directory holds it (an `AXIOM_PATH` entry's `../target/release` is searched too)")
              (let ((near (closestFfiName (archiveFfiNames blobs) n)))
                (cat3
                  (cat3 "searched: " (joinPaths paths 0) "; ")                  (if (== (strLen near) 0)
                    "check the `(symbol \"...\")` clause against the crate's `#[axiom_export]` names"
                    (cat3 "did you mean `" near "`?")
                  )                  ""
                )
              )
            ))
          )
            (let (
              (d (mkDiag
                SEV_ERROR                "AX4004"                "ungrounded-symbol"                (if (== item 0)
                  0
                  (nodeSpan item)
                )                msg                0                0                help
              ))
              (ds vecNew)
            )
              {
                (let ((u (findExternUnit decls n units 0)))
                  (if (>= u 0)
                    (diagSetUnit d u)
                    0
                  )
                )
                (vecPush ds d)
                (let ((out 
                  (renderDiagsFormat
                    dfmt                    ds                    (if (== item 0)
                      (let ((u vecNew))
                        {
                          (vecPush
                            u                            (cast Int (CUnit2
                              "<link>"                              ""                              (cast String 0)
                            ))
                          )
                          u
                        }
                      )
                      units
                    )
                  )
                ))
                  (sysWriteFd 2 (strData out) (strLen out))
                )
                exitToolFailed
              }
            )
          )
        )
      )
    )
  )
)

; The index in `units` of the module that declares `sym`, or -1.
; The entry file's declarations have no module (0) and sit at unit 0.
(pub :: findExternUnit (-> Int String Int Int Int))

(pub fn (findExternUnit decls sym units i)
  (if (>= i (vecLen decls))
    (- 0 1)
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_EXTERN) (!= (findExternItemIn (nodeC d) sym 0) 0))
        (if (==
          (cast Int (nodeModule d))          0
        )
          0
          (unitIndexOf
            units            (cast String (nodeModule d))            0
          )
        )
        (findExternUnit decls sym units (+ i 1))
      )
    )
  )
)

; The descriptor string an extern item's declared type spells:
; `<params>_<ret>`, one tag per parameter, the result after the
; underscore. Mirrors rust/axiom-ffi-classify.
(pub :: externSigTag (-> Int String))

(pub fn (externSigTag ty)
  (if (== ty 0)
    ""
    (cat3 (sigParamTags ty) "_" (sigTagOf (sigResultOf ty)))
  )
)

(pub :: sigParamTags (-> Int String))

(pub fn (sigParamTags ty)
  (if (&& (!= ty 0) (== (nodeTag ty) TAG_T_ARR))
    (cat2 (sigTagOf (nodeA ty)) (sigParamTags (nodeB ty)))
    ""
  )
)

(pub :: sigResultOf (-> Int Int))

(pub fn (sigResultOf ty)
  (if (&& (!= ty 0) (== (nodeTag ty) TAG_T_ARR))
    (sigResultOf (nodeB ty))
    ty
  )
)

(pub :: sigTagOf (-> Int String))

(pub fn (sigTagOf t)
  (if (== t 0)
    "i"
    (if (== (nodeTag t) TAG_T_ARR)
      "c"
      (if (== (nodeTag t) TAG_T_CON)
        (let ((n (nodeAName t)))
          (if (strEq n "Float")
            "f"
            (if (strEq n "String")
              "s"
              "i"
            )
          )
        )
        "i"
      )
    )
  )
)

; Every `<sym>__sig_...` name an archive holds, as the part after
; `__sig_`.
(pub :: descriptorsOf (-> Int String Int))

(pub fn (descriptorsOf blobs sym)
  (let (
    (out vecNew)
    (mut i 0)
    (prefix (cat2 sym "__sig_"))
  )
    {
      (while (< i (vecLen blobs))
        {
          (collectPrefixed
            (cast String (vecGet blobs i))            prefix            out            0
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

(pub :: collectPrefixed (-> String String Int Int Int))

(pub fn (collectPrefixed blob prefix out from)
  (let ((at (strFindSub blob prefix from)))
    (if (< at 0)
      0
      (let ((end (strFindByte blob 0 at)))
        (if (< end 0)
          0
          {
            (let ((tail (strSlice blob (+ at (strLen prefix)) (- end (+ at (strLen prefix))))))
              (if (&& (< (strLen tail) 80) (== (strIndexIn out tail) (- 0 1)))
                (vecPush
                  out                  (cast Int tail)
                )
                0
              )
            )
            (collectPrefixed blob prefix out end)
          }
        )
      )
    )
  )
)

; `ii_i` spelled as a developer reads it: `(-> Int Int Int)`.
(pub :: sigTagSpelled (-> String String))

(pub fn (sigTagSpelled tag)
  (let ((us (strFindByte tag 95 0)))
    (if (< us 0)
      (cat3 "`" tag "`")
      (let (
        (ps (strSlice tag 0 us))
        (r (strSlice tag (+ us 1) (- (strLen tag) (+ us 1))))
      )
        (if (== (strLen ps) 0)
          (cat3 "`" (tagWord r) "` (nullary)")
          (cat3 "`(-> " (cat2 (tagWords ps 0) (tagWord r)) ")`")
        )
      )
    )
  )
)

(pub :: tagWords (-> String Int String))

(pub fn (tagWords ps i)
  (if (>= i (strLen ps))
    ""
    (cat3 (tagWord (strSlice ps i 1)) " " (tagWords ps (+ i 1)))
  )
)

(pub :: tagWord (-> String String))

(pub fn (tagWord t)
  (if (strEq t "f")
    "Float"
    (if (strEq t "s")
      "String"
      (if (strEq t "c")
        "(-> Int ...)"
        "Int"
      )
    )
  )
)

(pub :: joinPaths (-> Int Int String))

(pub fn (joinPaths paths i)
  (if (>= i (vecLen paths))
    ""
    (cat2
      (cast String (vecGet paths i))      (if (< (+ i 1) (vecLen paths))
        (cat2 ", " (joinPaths paths (+ i 1)))
        ""
      )
    )
  )
)

; The extern ITEM node binding linker symbol `sym`, or 0.
(pub :: findExternItem (-> Int String Int Int))

(pub fn (findExternItem decls sym i)
  (if (>= i (vecLen decls))
    0
    (let ((d (vecGet decls i)))
      (if (== (nodeTag d) TAG_D_EXTERN)
        (let ((it (findExternItemIn (nodeC d) sym 0)))
          (if (== it 0)
            (findExternItem decls sym (+ i 1))
            it
          )
        )
        (findExternItem decls sym (+ i 1))
      )
    )
  )
)

(pub :: findExternItemIn (-> Int String Int Int))

(pub fn (findExternItemIn items sym i)
  (if (== items 0)
    0
    (if (>= i (vecLen items))
      0
      (if (strEq (nodeCName (vecGet items i)) sym)
        (vecGet items i)
        (findExternItemIn items sym (+ i 1))
      )
    )
  )
)

(pub :: findExternLib (-> Int String Int String))

(pub fn (findExternLib decls sym i)
  (if (>= i (vecLen decls))
    ""
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_EXTERN) (!= (findExternItemIn (nodeC d) sym 0) 0))
        (nodeAName d)
        (findExternLib decls sym (+ i 1))
      )
    )
  )
)

; 0 when every declare is grounded; otherwise the build's exit code,
; having reported the FIRST ungrounded symbol.
(pub :: groundDeclares (-> String Int Int))

;@axiom:effect(io)
(pub fn (groundDeclares ir linkArgs)
  (let ((names (declareNamesOf ir)))
    (if (== (vecLen names) 0)
      0
      (let ((blobs (readArchives (archivePathsOf linkArgs (irTargetIsWindows ir)))))
        (groundEach names blobs 0)
      )
    )
  )
)

(pub :: groundEach (-> Int Int Int Int))

;@axiom:effect(io)
(pub fn (groundEach names blobs i)
  (if (>= i (vecLen names))
    0
    (let ((n 
      (cast String (vecGet names i))
    ))
      (if (symbolGrounded blobs n 0)
        (groundEach names blobs (+ i 1))
        (buildFailDiag "AX4004" "ungrounded-symbol" (cat3 "no archive on the link line defines `" n "`") "check the `(symbol \"...\")` clause against the crate, and check that `--link-lib`/`--link-search` name the archive defining it; this is refused here rather than in `opt` or `cc` because a linker error about generated code cannot point at the declaration that caused it")
      )
    )
  )
)

; Write `ir` beside `outPath`, drive the toolchain, and clean up.
;
; Intermediates are removed on the FAILURE paths too, which is stage0's
; behaviour and the reason its cleanup runs before the error is
; propagated: a failed build that leaves a `.o` behind makes the next
; one ambiguous. `keepLl` is `--emit-llvm`, and preserves the
; PRE-`opt` IR - also stage0's choice, and worth knowing before writing
; a gate that greps it, since it is the optimiser's input rather than
; what llc consumed.
(pub :: buildToExecutable (-> String String Int Int Int Int))

;@axiom:effect(io)
(pub fn (buildToExecutable ir outPath optLevel keepLl linkArgs)
  ; Grounding FIRST, before a byte is written or a tool is spawned: an
  ; ungrounded symbol is a defect in the program, and reporting it after
  ; `opt` has already refused the module reports the wrong thing.
  (let ((ug (groundDeclares ir linkArgs)))
    (if (!= ug 0)
      ug
      ; `.exe` for a Windows module, appended HERE and nowhere else -
      ; unless the caller already spelled it. The intermediates keep
      ; `outPath`'s stem either way, so `--emit-llvm` leaves `<out>.ll`
      ; beside `<out>.exe` rather than `<out>.exe.ll`.
      (let (
        (isWin (irTargetIsWindows ir))
        (llPath (cat2 outPath ".ll"))
        (objPath (cat2 outPath ".o"))
        (optPath (cat2 outPath ".opt.ll"))
      )
      (let ((exePath (if (&& isWin (!= (endsWithExe outPath) 1)) (cat2 outPath ".exe") outPath)))
        (if (isErr (sysWriteFile (strCStr llPath) ir))
          (toolFailDiag "could not write LLVM IR" "check that the output directory exists and is writable")
          (let ((toAssemble (runOpt llPath optLevel optPath)))
            (if (== (strLen toAssemble) 0)
              {
                (unwrapOr (sysUnlink (strCStr llPath)) 0)
                (toolFailDiag "opt failed" "`opt` is optional - a PATH without it warns and builds - so this is a failure of the one that is installed")
              }
              (let ((rc (assembleAndLink
                toAssemble                objPath                exePath                optLevel                linkArgs                isWin
              )))
                {
                  (unwrapOr (sysUnlink (strCStr objPath)) 0)
                  (if (!= (strCmp toAssemble llPath) 0)
                    (unwrapOr (sysUnlink (strCStr optPath)) 0)
                    0
                  )
                  (if (== keepLl 0)
                    (unwrapOr (sysUnlink (strCStr llPath)) 0)
                    0
                  )
                  rc
                }
              )
            )
          )
        )
      )
      )
    )
  )
)

; Does `p` already end in `.exe`? 1 or 0, so the test above reads as
; the others in this file do.
(pub :: endsWithExe (-> String Int))

(pub fn (endsWithExe p)
  (if (< (strLen p) 4)
    0
    (if (strEq (strSlice p (- (strLen p) 4) 4) ".exe")
      1
      0
    )
  )
)

(pub :: writeStderrStr (-> String Int))

;@axiom:effect(io)
(pub fn (writeStderrStr s) (sysWriteFd 2 (strData s) (strLen s)))

; Decimal rendering of a small non-negative int, for `-O<n>`.
;
; `Fmt` is not imported here: the compiler's own modules keep their
; import surface small, and the only numbers this module renders are 0
; through 3.
(pub :: fmtIntStr (-> Int String))

(pub fn (fmtIntStr n)
  (if (== n 0)
    "0"
    (if (== n 1)
      "1"
      (if (== n 2)
        "2"
        (if (== n 3)
          "3"
          "1"
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; Argument parsing.
; ------------------------------------------------------------------
(pub :: isSubcommand (-> String Bool))

(pub fn (isSubcommand s) (|| (strEq s "build") (|| (strEq s "lsp") (|| (strEq s "check") (|| (strEq s "run") (|| (strEq s "test") (|| (strEq s "emit-llvm") (|| (strEq s "fmt") (|| (strEq s "explain") (|| (strEq s "symbols") (|| (strEq s "repl") (|| (strEq s "version") (|| (strEq s "--version") (|| (strEq s "-V") (|| (strEq s "help") (|| (strEq s "--help") (strEq s "-h")))))))))))))))))

; `--help` has to be recognised as a subcommand rather than parsed as a
; flag: the scan that lets global options precede a subcommand skips
; anything beginning with `-`, so `--help` was skipped, no positional
; remained, and the compiler fell back to reading `in.ax` and reported
; `cannot read input`. A compiler whose --help is an obscure file error
; is a compiler nobody gets past.
(pub :: usageText String)

(pub fn (usageText) (cat3 (strConcat (strConcat "Axiom " axiomVersion) "\n\nUSAGE:\n  axiom [OPTIONS] <COMMAND> [ARGS]\n  axiom [OPTIONS] <FILE> [TARGET]   emit LLVM IR to stdout\n\nCOMMANDS:\n  build      compile a source file to an executable\n  check      check syntax and types, emitting no code\n  run        compile a source file and run it, forwarding any further ARGS\n  test       run every `test`-named function in a file or directory\n  emit-llvm  print the generated LLVM IR\n  fmt        format a source file in place (--check to only report)\n  explain    describe a diagnostic code (--list for all codes)\n  symbols    list every top-level symbol in AXSYM (--builtins, --calls too)\n  repl       start the interactive read-eval-print loop\n  lsp        run the language server on stdin/stdout (JSON-RPC)\n  version    print the version\n  help       print this message, or `help <COMMAND>` for one command\n\n") "OPTIONS:\n  --input <PATH>     input file (build, check, run, emit-llvm; a bare\n                     path also works)\n  --output <PATH>    output file (build, emit-llvm; default: the `name` in\n                     the project's `axiom.pkg`, else `output`;\n                     `.exe` is appended for windows-x86_64 unless already spelled)\n  -o <PATH>          short for --output\n  --target <NAME>    darwin-aarch64, darwin-x86_64, linux-aarch64, linux-x86_64, freebsd-x86_64, freebsd-aarch64, windows-x86_64\n                     (the last three emit and are not yet supported; README, Targets)\n  --opt <0-3>        optimisation level (build, run, test; default 1)\n  --filter <TEXT>    run only the tests whose name contains TEXT (test)\n  --crate <DIR>      a Rust crate to bind: its `axiom/` module directory\n                     is searched for imports and its `target/release`\n                     for the archive, repeatable (build, run, check)\n  --link-lib <NAME>  link an FFI archive, repeatable (build, run);\n                     an `extern` block's library links by itself when a\n                     search directory holds `libNAME.a`\n  --link-search <DIR>  where to look for it, repeatable (build, run);\n                     `$AXIOM_LINK_SEARCH` and `<AXIOM_PATH entry>/../target/release` too\n  --emit-llvm        keep the generated .ll beside the executable (build)\n  --emit-staticlib   write a static archive instead of an executable: no\n                     `main` is needed, every `pub fn` of the file is a C\n                     symbol a Rust or C host can call (build)\n  --emit-rust-binding <PATH>  with --emit-staticlib, also write a Rust\n                     module binding the archive's `pub` functions (build)\n  --check            report whether the file is formatted, do not write (fmt)\n  --builtins         also list the built-in operators (symbols)\n  --calls            also list each function's resolved call edges as\n                     `#calls=` - the graph behind `#effects=` (symbols)\n  --list             list every diagnostic code (explain)\n  --no-banner        skip the startup banner (repl)\n  --diagnostic-format <human|ai|json>  how to render diagnostics (default human)\n  -h, --help         print help; accepted anywhere, including after the file\n  -V, --version      print the version; before the command\n  --                 end of options, so a file whose name begins with `-`\n                     can be named at all\n\n" "EXIT CODES:\n  0  success\n  1  the program is wrong: unreadable input, a syntax error, a failing\n     check, no entry point, or an unresolvable import\n  2  the command line is wrong: an unknown command or flag, or a flag\n     given the wrong number of values\n  3  a module could not be read or parsed, or a target name is unknown\n  4  a native tool failed or is missing (llc, cc; lld-link for windows-x86_64)\n"))

; One command's help: its synopsis and the flags it actually reads.
;
; `axiom build --help` used to answer `error: build needs an input
; file` - the one question a CLI must never refuse. Worse,
; `axiom fmt FILE --help` REWROTE the file, and `axiom repl --help`
; dropped the user into the REPL, because `--help` was recognised only
; at argv[1] and every other position fell through to the subcommand.
;
; A synopsis and a flag list rather than a page of prose: the flags are
; the part a reader cannot guess, and check-driver.sh asserts that every
; flag the table accepts appears in `axiom --help`, so the two cannot
; drift apart silently.
(pub :: helpForCommand (-> String String))

(pub fn (helpForCommand c)
  (if (strEq c "build")
    "axiom build - compile a source file to an executable\n\nUSAGE:\n  axiom build [--input] <FILE> [--output <PATH>] [--opt <0-3>] [--emit-llvm]\n\n  --input <PATH>   the source file; a bare path works too\n  --output <PATH>  where to write the executable (default: the `name` in\n                   the project's `axiom.pkg`, else `output`)\n  -o <PATH>        short for --output\n  --opt <0-3>      optimisation level (default 1)\n  --emit-llvm      keep the generated .ll beside the executable\n"
    (if (strEq c "check")
      "axiom check - check syntax and types, emitting no code\n\nUSAGE:\n  axiom check <FILE>\n\nPrints `OK` and exits 0 when the module checks. Warnings are reported\nand do not fail. A module with no `main` checks clean: only `build`\nand `run` need an entry point.\n"
      (if (strEq c "run")
        "axiom run - compile a source file and run it\n\nUSAGE:\n  axiom run <FILE> [ARGS...]\n\nEverything after FILE is passed to the program, not read by the\ncompiler. Use `--` before an argument that begins with a dash. The\nprogram's own exit status becomes this command's.\n\n  --opt <0-3>      optimisation level (default 1)\n"
        (if (strEq c "test")
          "axiom test - run every `test`-named function in a file or directory\n\nUSAGE:\n  axiom test <FILE|DIR> [--filter <TEXT>] [--opt <0-3>]\n\nA test is a top-level function whose name begins with `test` and which\ntakes no parameters. Nothing else is discovered, and a `test`-named\nfunction that DOES take parameters is refused rather than skipped.\n\nEach test runs inside its own recovery point, so a failing assertion,\nan unhandled effect, an allocation failure or a division by zero ends\nthat test and no other. Assertions are `stdlib/Test.ax`.\n\nDIR runs every `.ax` file directly inside it, in name order.\n\n  --filter <TEXT>  run only the tests whose name contains TEXT\n  --opt <0-3>      optimisation level (default 1)\n\nExit 0 when every test passed, 1 when any failed or none was found.\n"
          (if (strEq c "emit-llvm")
            "axiom emit-llvm - print the generated LLVM IR\n\nUSAGE:\n  axiom emit-llvm <FILE> [-o <PATH>]\n\n  --output <PATH>  write the IR to PATH instead of stdout\n  -o <PATH>        short for --output\n\nA module with no `main` is fine here: no executable is produced.\n"
            (if (strEq c "fmt")
              "axiom fmt - format a source file in place\n\nUSAGE:\n  axiom fmt <FILE> [--check]\n\n  --check   report whether FILE is formatted and exit 1 if it is not,\n            WITHOUT writing to it\n\nThe formatter verifies before it writes: the output must re-parse, keep\nevery comment, and be a fixed point. A refusal leaves FILE untouched.\n"
              (if (strEq c "explain")
                "axiom explain - describe a diagnostic code\n\nUSAGE:\n  axiom explain <CODE>\n  axiom explain --list\n\nCODE may be written `AX3001`, `3001` or `ax-3001`.\n\n  --list    list every known code instead\n"
                (if (strEq c "symbols")
                  "axiom symbols - list every top-level symbol, in AXSYM\n\nUSAGE:\n  axiom symbols <FILE> [--builtins]\n\n  --builtins   also list the always-in-scope operators\n\nTwo renderings, chosen by --diagnostic-format: `human` (the default)\nprints an aligned table of kind, name, type and location; `ai` prints\nAXSYM itself, which is the same facts plus each symbol's nid and its\nmetadata - `#effects=`, `#effect-params=`, `#effects-incomplete` and\nany AXTAG. `json` has no rendering of its own and falls back to AXSYM\nwith a note on stderr.\n"
                  (if (strEq c "repl")
                    "axiom repl - the interactive read-eval-print loop\n\nUSAGE:\n  axiom repl [--no-banner]\n\n  --no-banner   skip the startup banner\n\nType :help at the prompt for the meta-commands.\n"
                    (if (strEq c "lsp")
                      "axiom lsp - run the language server\n\nUSAGE:\n  axiom lsp\n\nSpeaks JSON-RPC over stdin and stdout, so it takes no operand and\nwrites nothing else to stdout.\n"
                      (if (strEq c "version")
                        "axiom version - print the version\n\nUSAGE:\n  axiom version\n  axiom --version\n"
                        usageText
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The value of `--name` / `--name=value`, or "" when absent.
; Every `--link-search DIR` and `--link-lib NAME` on the command line,
; rendered as the `cc` arguments they become.
;
; Search paths first as a group, then libraries: `-L` before `-l`
; matters to some linkers and costs nothing here. Within each group the
; order is COMMAND-LINE order, because `check-reproducible.sh` compares
; bytes and an unordered link line would flip them run to run.
;
; This is the FFI's only reach into the driver. Before it, `cc` was
; invoked with exactly three arguments and the language had no way to
; name an external symbol, so there was nothing for a `-l` to resolve.
(pub :: linkArgsOf Int)

;@axiom:effect(io)
(pub fn (linkArgsOf)
  (let ((v vecNew))
    {
      (collectFlagInto
        v        "--link-search"        "-L"        1        sysArgc
      )
      (collectFlagInto
        v        "--link-lib"        "-l"        1        sysArgc
      )
      v
    }
  )
)

; Both `--flag VALUE` and `--flag=VALUE`, the two spellings
; `flagValueAt` already accepts, but collecting EVERY occurrence rather
; than the first: a program may bind more than one library.
(pub :: collectFlagInto (-> Int String String Int Int Int))

;@axiom:effect(io)
(pub fn (collectFlagInto v name prefix i n)
  (if (>= i n)
    0
    (let ((a (sysArg i)))
      (if (strEq a name)
        (if (< (+ i 1) n)
          {
            (vecPush
              v              (cast Int (cat2 prefix (sysArg (+ i 1))))
            )
            (collectFlagInto
              v              name              prefix              (+ i 2)              n
            )
          }
          0
        )
        (let ((eq (cat2 name "=")))
          (if (strStartsWith a eq)
            {
              (vecPush
                v                (cast Int (cat2 prefix (strSlice a (strLen eq) (- (strLen a) (strLen eq)))))
              )
              (collectFlagInto
                v                name                prefix                (+ i 1)                n
              )
            }
            (collectFlagInto
              v              name              prefix              (+ i 1)              n
            )
          )
        )
      )
    )
  )
)

(pub :: flagValue (-> String Int String))

;@axiom:effect(io)
(pub fn (flagValue name from) (flagValueAt name from sysArgc))

(pub :: flagValueAt (-> String Int Int String))

;@axiom:effect(io)
(pub fn (flagValueAt name i n)
  (if (>= i n)
    ""
    (let ((a (sysArg i)))
      (if (strEq a name)
        (if (< (+ i 1) n)
          (sysArg (+ i 1))
          ""
        )
        (let ((eq (cat2 name "=")))
          (if (strStartsWith a eq)
            (strSlice a (strLen eq) (- (strLen a) (strLen eq)))
            (flagValueAt name (+ i 1) n)
          )
        )
      )
    )
  )
)

; The INDEX of the first argument at or after `from` that is not a flag
; and is not the value of one, or -1.
;
; Global flags may precede the subcommand, because stage0's are accepted
; anywhere and the gates rely on it: `check-cross-targets.sh` invokes
; `axiom --target=<t> emit-llvm <file> -o <out>`. Dispatching on argv[1]
; alone read `--target=linux-x86_64` as an input filename and answered
; `cannot read input`.
; How many SEPARATE arguments this flag consumes after itself: 1 for a
; value flag, 0 for a boolean, -1 when the name is not a flag at all.
;
; Kept as a table rather than inferred, because inferring it is what
; broke. The scan below used to skip TWO arguments for any flag without
; an `=`, on the assumption that a flag always takes a value, so
;
;     axiom --emit-llvm prog.ax
;
; read `prog.ax` as the VALUE of `--emit-llvm` and found no positional
; after it. Any boolean flag before a positional did it. There is no way
; to tell a boolean from a value-taking flag by looking at the flag.
;
; The -1 arm is the new half, and it is what makes an unrecognised flag
; an ERROR rather than something silently stepped over. Skipping is
; indistinguishable from accepting, which is why `axiom check --bogus
; f.ax` used to print OK and exit 0, and why a mistyped
; `--diagnostic-formt=json` quietly produced human output.
(pub :: flagArity (-> String Int))

(pub fn (flagArity a)
  (if (|| (strEq a "--input") (|| (strEq a "--output") (|| (strEq a "-o") (|| (strEq a "--target") (|| (strEq a "--opt") (|| (strEq a "--link-lib") (|| (strEq a "--link-search") (|| (strEq a "--crate") (|| (strEq a "--emit-rust-binding") (|| (strEq a "--filter") (strEq a "--diagnostic-format")))))))))))
    1
    (if (|| (strEq a "--emit-llvm") (|| (strEq a "--emit-staticlib") (|| (strEq a "--check") (|| (|| (strEq a "--builtins") (strEq a "--calls")) (|| (strEq a "--list") (|| (strEq a "--no-banner") (|| (strEq a "--gc") (|| (strEq a "--help") (|| (strEq a "-h") (|| (strEq a "--version") (strEq a "-V")))))))))))
      0
      (- 0 1)
    )
  )
)

; `--gc` is in the table above in order to be REFUSED by name.
;
; The retired compiler had `--gc` as a global boolean that swapped the
; bump allocator for a 1,098-line mark-sweep collector
; (axiom-codegen/src/gc.rs, deleted with the rest in 430a138). This
; compiler has no collector at all. The flag was neither implemented nor
; rejected, so `axiom --gc build ...` produced a bump-allocator binary
; and said nothing - while README.md's opening paragraph, docs/reference.md
; and scripts/bench-datastructures.sh all still promised a collector. A
; benchmark labelled "axiom under --gc" was measuring the allocator it
; existed to compare against.
;
; A silent downgrade of a memory-management request is exactly the
; failure its user cannot detect, so this refuses while the collector
; does not exist. Recorded in the self-hosting record.
(pub :: flagUnimplemented (-> String Bool))

(pub fn (flagUnimplemented a) (strEq a "--gc"))

; `--name=value` split into its two halves.
(pub :: flagNamePart (-> String String))

(pub fn (flagNamePart a)
  (let ((e (strFindByte a 61 0)))
    (if (< e 0)
      a
      (strSlice a 0 e)
    )
  )
)

(pub :: flagHasValuePart (-> String Bool))

(pub fn (flagHasValuePart a) (>= (strFindByte a 61 0) 0))

(pub :: flagValuePart (-> String String))

(pub fn (flagValuePart a)
  (let ((e (strFindByte a 61 0)))
    (if (< e 0)
      ""
      (strSlice a (+ e 1) (- (strLen a) (+ e 1)))
    )
  )
)

; Is this argument written as a flag at all? A bare `-` is not: it names
; standard input by convention, and refusing it here would be a worse
; answer than the read error a caller gives it.
(pub :: looksLikeFlag (-> String Bool))

(pub fn (looksLikeFlag a) (&& (strStartsWith a "-") (> (strLen a) 1)))

(pub :: positionalIndex (-> Int Int))

;@axiom:effect(io)
(pub fn (positionalIndex from)
  (if (>= from sysArgc)
    (- 0 1)
    (let ((a (sysArg from)))
      (if (strEq a "--")
        ; `--` ends option parsing, so what follows is an operand
        ; even when it begins with a dash. Without this the marker
        ; was accepted by `checkArgs` and then ignored here, and
        ; `axiom check -- -weird.ax` answered `check needs an input
        ; file` - a separator the usage text documents and the
        ; operand scan did not implement.
        (if (< (+ from 1) sysArgc)
          (+ from 1)
          (- 0 1)
        )
        (if (strStartsWith a "-")
          ; A flag carries its value with `=`, or takes the next
          ; argument, or takes none at all - and only the flag's name
          ; can decide which. An unknown flag is stepped over here
          ; rather than diagnosed, because `checkArgs` has already
          ; refused the invocation before any of this runs; reaching
          ; this point means every flag in argv is in the table.
          (if (flagHasValuePart a)
            (positionalIndex (+ from 1))
            (if (== (flagArity a) 1)
              (positionalIndex (+ from 2))
              (positionalIndex (+ from 1))
            )
          )
          from
        )
      )
    )
  )
)

(pub :: positionalFrom (-> Int String))

;@axiom:effect(io)
(pub fn (positionalFrom from)
  (let ((i (positionalIndex from)))
    (if (< i 0)
      ""
      (sysArg i)
    )
  )
)

; The subcommand this invocation names, or "".
;
; argv[1] is consulted directly first so that `--version` - a flag by
; spelling and a subcommand by meaning - is not skipped as a flag by the
; scan below it.
(pub :: subcommandIndex Int)

;@axiom:effect(io)
(pub fn (subcommandIndex)
  (let ((a1 
    (if (> sysArgc 1)
      (sysArg 1)
      ""
    )
  ))
    (if (isSubcommand a1)
      1
      (positionalIndex 1)
    )
  )
)

(pub :: subcommandName String)

;@axiom:effect(io)
(pub fn (subcommandName)
  (let ((i subcommandIndex))
    (if (< i 0)
      ""
      (let ((a (sysArg i)))
        (if (isSubcommand a)
          a
          ""
        )
      )
    )
  )
)

; Where a subcommand's own operands begin - one past the subcommand,
; which is NOT always index 2: a global flag in front of it shifts
; everything right, and reading from a fixed 2 hands the subcommand's
; own name back as the input filename.
(pub :: operandStart Int)

;@axiom:effect(io)
(pub fn (operandStart) (+ subcommandIndex 1))

; The optimisation level, refusing a value it cannot honour.
;
; It used to fall back to 1 for anything it did not recognise, so
; `--opt banana` and `--opt 9` both built at -O1 in silence - the user
; asked for one thing and got another with no way to tell. The retired
; compiler parsed a u8 and clamped, so `--opt 200` also silently became
; -O3; refusing outside 0-3 is stricter than that on purpose, because a
; clamp is a silent answer to a question the user got wrong.
(pub :: optLevelArg Int)

;@axiom:effect(io)
(pub fn (optLevelArg)
  ; `checkArgs` has already refused every value this cannot honour, so
  ; the fallback here is unreachable rather than a silent substitution.
  ; It is kept because the alternative is a partial function, and a
  ; compiler that trusts an earlier pass to have run is one bad refactor
  ; from building at the wrong level in silence.
  (let ((v (flagValue "--opt" 1)))
    (if (&&
      (== (strLen v) 1)      (let ((c (strByte v 0)))
        (&& (>= c 48) (<= c 51))
      )
    )
      (- (strByte v 0) 48)
      1
    )
  )
)

(pub :: targetArg (-> String String))

;@axiom:effect(io)
(pub fn (targetArg fallback)
  (let ((v (flagValue "--target" 1)))
    (if (== (strLen v) 0)
      fallback
      v
    )
  )
)

; ------------------------------------------------------------------
; Validating the invocation, once, before any subcommand acts.
;
; Until this existed there was no such pass: `flagValue`, `hasFlag` and
; `positionalIndex` each walked argv with its own idea of what a flag
; was, and none could say that a flag was not one. Two of the results
; destroyed a user's file:
;
;   axiom fmt --check=true FILE   REWROTE FILE and printed `OK: FILE
;                                 formatted`. `hasFlag` matches exactly,
;                                 so `--check=true` was not `--check`
;                                 and the arm fell through to the write.
;   axiom fmt FILE --help         REWROTE FILE, because `--help` was
;                                 only ever recognised at argv[1].
;
; The rule is deliberately the WEAKEST one that kills the class: a flag
; must EXIST and must be given the right number of values. It does NOT
; police which subcommand owns which flag. That restraint is a gate
; constraint, not tidiness - the legacy `axiom FILE [TARGET]` spelling
; has no subcommand at all, and check-driver.sh requires
; `axiom --emit-llvm hello.ax` to exit 0 with IR on stdout and
; `axiom --check nosuch.ax` to name the file it could not read. Under
; per-subcommand ownership those belong to `build` and `fmt`, so both
; become usage errors and five gate cases flip. Existence and arity fix
; the data loss and the silent typos without disturbing a single
; existing invocation.
; ------------------------------------------------------------------
; A usage error: the message, a pointer at `--help`, and exit 2.
;
; 2 is the status the retired compiler used for every usage error (clap
; 4.6.4's default), and it is free here: the parse-error port moved
; syntax errors to 1, so nothing has produced 2 since. The split that
; matters is stream and status together - help the user ASKED for goes
; to stdout with 0, an invocation they got wrong goes to stderr with 2.
(pub :: usageError (-> String Int))

;@axiom:effect(io)
(pub fn (usageError msg)
  {
    (writeStderrStr msg)
    (writeStderrStr "\nFor more information, try `axiom --help`.\n")
    (sysExitWith 2)
    2
  }
)

; Edit distance between `a` and `b`, two rows of the DP table.
;
; Only the SUBCOMMAND suggestion earns this. `axiom buidl f.ax` gave a
; user no clue at all - it was read as a FILENAME, so the answer was
; `cannot read input: buidl` and their real filename was discarded -
; whereas `unrecognised flag `--diagnostic-formt`` already names the
; thing that is wrong.
(pub :: editDistance (-> String String Int))

(pub fn (editDistance a b)
  (let (
    (n (strLen a))
    (m (strLen b))
    (mut prev vecNew)
  )
    {
      (let ((mut j 0))
        (while (<= j m)
          {
            (vecPush prev j)
            (set j (+ j 1))
          })
      )
      (let ((mut i 1))
        (while (<= i n)
          (let ((cur vecNew))
            {
              (vecPush cur i)
              (let ((mut j 1))
                (while (<= j m)
                  {
                    (let ((cost 
                      (if (== (strByte a (- i 1)) (strByte b (- j 1)))
                        0
                        1
                      )
                    ))
                      (let (
                        (d1 (+ (vecGet prev j) 1))
                        (d2 (+ (vecGet cur (- j 1)) 1))
                        (d3 (+ (vecGet prev (- j 1)) cost))
                      )
                        (vecPush
                          cur                          (if (&& (<= d1 d2) (<= d1 d3))
                            d1
                            (if (<= d2 d3)
                              d2
                              d3
                            )
                          )
                        )
                      )
                    )
                    (set j (+ j 1))
                  })
              )
              (set prev cur)
              (set i (+ i 1))
            }
          ))
      )
      (vecGet prev m)
    }
  )
)

(pub :: subcommandNames Int)

(pub fn (subcommandNames)
  (let ((v vecNew))
    {
      (vecPush
        v        (cast Int "build")
      )
      (vecPush
        v        (cast Int "check")
      )
      (vecPush
        v        (cast Int "run")
      )
      (vecPush
        v        (cast Int "test")
      )
      (vecPush
        v        (cast Int "emit-llvm")
      )
      (vecPush
        v        (cast Int "fmt")
      )
      (vecPush
        v        (cast Int "explain")
      )
      (vecPush
        v        (cast Int "symbols")
      )
      (vecPush
        v        (cast Int "repl")
      )
      (vecPush
        v        (cast Int "lsp")
      )
      (vecPush
        v        (cast Int "version")
      )
      (vecPush
        v        (cast Int "help")
      )
      v
    }
  )
)

; The known subcommand within two edits of `w`, or "".
;
; Two, not one, because the commonest typo of all is a transposition -
; `buidl` for `build` - and plain Levenshtein scores a swap as two
; edits, not one. A threshold of 1 therefore misses the exact case this
; exists to catch, which is how it was first measured.
;
; A wrong suggestion costs nothing here: the caller only asks after the
; operand has already failed to open, so there is no reading of the
; argument under which the invocation was going to work.
(pub :: nearestSubcommand (-> String String))

(pub fn (nearestSubcommand w) (nearestSubcommandFrom w subcommandNames 0))

(pub :: nearestSubcommandFrom (-> String Int Int String))

(pub fn (nearestSubcommandFrom w v i)
  (if (>= i (vecLen v))
    ""
    (let ((c (vecGetStr v i)))
      (if (<= (editDistance w c) 2)
        c
        (nearestSubcommandFrom w v (+ i 1))
      )
    )
  )
)

; Is `want` present as a FLAG - anywhere in argv, not as another flag's
; value, and not after `--`?
;
; Anywhere is the whole point. `--help` used to be recognised only at
; argv[1], so `axiom fmt FILE --help` fell through to fmt's write path
; and rewrote the file it had been asked to explain.
;
; After `run`'s own file operand every argument belongs to the PROGRAM,
; so the scan stops there: `axiom run prog.ax --help` asks prog.ax for
; its help, not this compiler for its own.
(pub :: hasFlagAnywhere (-> String String Bool))

;@axiom:effect(io)
(pub fn (hasFlagAnywhere cmd want) (hasFlagAnywhereFrom cmd want 1 0))

(pub :: hasFlagAnywhereFrom (-> String String Int Int Bool))

;@axiom:effect(io)
(pub fn (hasFlagAnywhereFrom cmd want i endOpts)
  (if (>= i sysArgc)
    false
    (let ((a (sysArg i)))
      (if (&& (== endOpts 0) (strEq a "--"))
        false
        (if (||
          (== endOpts 1)          (if (looksLikeFlag a)
            false
            true
          )
        )
          (hasFlagAnywhereFrom
            cmd            want            (+ i 1)            (if (&& (strEq cmd "run") (> i subcommandIndex))
              1
              endOpts
            )
          )
          (let ((name (flagNamePart a)))
            (if (strEq name want)
              true
              (if (&&
                (== (flagArity name) 1)                (if (flagHasValuePart a)
                  false
                  true
                )
              )
                (hasFlagAnywhereFrom cmd want (+ i 2) endOpts)
                (hasFlagAnywhereFrom cmd want (+ i 1) endOpts)
              )
            )
          )
        )
      )
    )
  )
)

; Walk argv once and refuse anything the table does not describe.
;
; Answers 0 for a well-formed invocation; a bad one never returns,
; because there is nothing a caller could do with the news.
(pub :: checkArgs (-> String Int))

;@axiom:effect(io)
(pub fn (checkArgs cmd) (checkArgsFrom cmd 1 0))

(pub :: checkArgsFrom (-> String Int Int Int))

;@axiom:effect(io)
(pub fn (checkArgsFrom cmd i endOpts)
  (if (>= i sysArgc)
    0
    (let ((a (sysArg i)))
      (if (&& (== endOpts 0) (strEq a "--"))
        ; Everything after `--` is an operand, so a file whose name
        ; begins with `-` can be named at all. driver.ax has carried
        ; a note since the subcommand CLI landed that this was the
        ; fix if it ever mattered; validation is what makes it
        ; matter, since a leading dash is now an error rather than a
        ; silent skip.
        (checkArgsFrom cmd (+ i 1) 1)
        (if (||
          (== endOpts 1)          (if (looksLikeFlag a)
            false
            true
          )
        )
          (checkArgsFrom
            cmd            (+ i 1)            (if (&& (strEq cmd "run") (> i subcommandIndex))
              1
              endOpts
            )
          )
          (let ((name (flagNamePart a)))
            (let ((ar (flagArity name)))
              (if (< ar 0)
                (usageError (cat3 "error: unrecognised flag `" name "`\n"))
                (if (flagUnimplemented name)
                  (usageError (cat3 "error: `" name "` is not supported by this compiler.\n       The tracing collector it selected belonged to the retired\n       Rust implementation; this compiler has only the bump\n       allocator.\n"))
                  (if (&& (== ar 0) (flagHasValuePart a))
                    (usageError (cat2 (cat3 "error: `" name "` takes no value, but `") (cat2 (flagValuePart a) "` was given\n")))
                    (if (&&
                      (== ar 1)                      (if (flagHasValuePart a)
                        false
                        true
                      )
                    )
                      (if (>= (+ i 1) sysArgc)
                        (usageError (cat3 "error: a value is required for `" name "` but none was given\n"))
                        {
                          (checkFlagValue name (sysArg (+ i 1)))
                          (checkArgsFrom cmd (+ i 2) endOpts)
                        }
                      )
                      {
                        (if (flagHasValuePart a)
                          (checkFlagValue name (flagValuePart a))
                          0
                        )
                        (checkArgsFrom cmd (+ i 1) endOpts)
                      }
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The values that have exactly one right shape are checked HERE, in the
; same walk as the names, so a wrong command line is refused before any
; subcommand acts on it.
;
; `--opt` was previously parsed where it is USED, which in `build` is
; after `compileFile` has already run - so `axiom build --input bad.ax
; --opt banana` reported the type error, and only mentioned the bad
; optimisation level on the next run, after the user had fixed the
; first thing. A command line that cannot be honoured should be refused
; before the compiler does a minute of work on it.
;
; `--diagnostic-format` is deliberately NOT here: an unknown value there
; warns and falls back to `human`, which is the retired compiler's
; behaviour and the right one for a presentation flag - a typo should
; degrade the report, not fail the build. `--target` is not here either,
; because `checkedTargetCode` already refuses it by name with the list
; of valid targets.
(pub :: checkFlagValue (-> String String Int))

;@axiom:effect(io)
(pub fn (checkFlagValue name v)
  (if (strEq name "--opt")
    (if (&&
      (== (strLen v) 1)      (let ((c (strByte v 0)))
        (&& (>= c 48) (<= c 51))
      )
    )
      0
      (usageError (cat3 "error: `--opt` takes 0, 1, 2 or 3, but was given `" v "`\n"))
    )
    0
  )
)
