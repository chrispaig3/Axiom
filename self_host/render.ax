; render.ax — human-readable and JSON diagnostic rendering, in Axiom.
;
; AXDL (diag.ax) is the byte-pinned cross-compiler surface; the two
; renderers here are stage1's OWN presentation layer, pinned by
; three-way goldens (tests/diagnostics/*.human, checked by
; scripts/check-render-selfhost.sh) and cross-checked mechanically
; against the AXDL goldens, which stage0 itself equals. The layout is
; native by decision rather than a byte-clone of stage0's: stage0's
; human renderer is the third-party `ariadne` crate, and reproducing a
; retiring dependency's per-character ANSI stream would pin this
; compiler to internals the project is deleting - the same reasoning
; that replaced the phase-4 byte-identity criterion. Two information
; deltas versus stage0, both deliberate and both in stage1's favor:
;
;   * no color: stage0 emits ANSI escapes even when piped, wrapping
;     every snippet character individually; this renderer emits plain
;     text a terminal, a log file and a diff all read the same way;
;   * ALL helps render: ariadne 0.4.1 keeps only the last `with_help`,
;     so stage0's human output silently drops every help but the
;     appended `axiom explain` line. The AXDL line shows what was
;     lost; here it is not lost.
;
; One block per diagnostic:
;
;   error[AX3006]: duplicate definition `main`
;     --> tests/diagnostics/010-duplicate-fn.ax:3:6
;      |
;    2 | (fn (main) 0)
;      |      ---- `main` first defined here
;    3 | (fn (main) 1)
;      |      ^^^^
;      |
;      = help: rename one of the definitions, or remove the duplicate
;      = help: run `axiom explain AX3006` for a full explanation
;
; followed by one blank line. Labeled lines render in source order,
; the primary span underlined with `^`, the related span with `-`; a
; gap of more than one line between them is marked by a `...` line.
; Columns count characters, not bytes (diag.ax's colOf), so the caret
; padding is correct wherever the text is - self_host/core.ax alone
; carries 18 non-ASCII bytes. Two labels on the same source line each
; render their own copy of the line - 070-nonascii-same-line.human is
; the pinned example - and merging the two caret rows under one line
; print is a later diagnostic's business if the repetition ever reads
; badly in practice.
(import core)

(import Mem)

(import Str)

(import Vec)

(import Utf8)

(import diag)

(import style)

; ------------------------------------------------------------------
; Small string tools. `repByte` is a filled `strAlloc`, not a
; strConcat fold: the fold's peak is the sum of every intermediate
; (the 16.9 GB lesson in the self-hosting record), and a caret line for
; a wide span would pay it per character.
; ------------------------------------------------------------------
(pub :: repByte (-> Int Int String))

(pub fn (repByte n ch)
  (let ((m 
    (if (< n 0)
      0
      n
    )
  ))
    (let (
      (s (strAlloc m))
      (mut i 0)
    )
      {
        (while (< i m)
          {
            (memPutByte (strData s) i ch)
            (set i (+ i 1))
          })
        s
      }
    )
  )
)

(pub :: spacesN (-> Int String))

(pub fn (spacesN n) (repByte n 32))

; `n` right-justified in `w` columns.
; `visLen` rather than `strLen`: the renderer paints finished fragments
; and computes widths on plain text, so this should never see an escape -
; and if the discipline ever slips, a gutter measured in bytes would be
; seven columns wide per colour.
(pub :: rjNum (-> Int Int String))

(pub fn (rjNum n w)
  (let ((t (decStr n)))
    (strConcat (spacesN (- w (visLen t))) t)
  )
)

; Byte offset one past the last byte of the line containing `off`.
(pub :: lineEndOf (-> String Int Int))

(pub fn (lineEndOf src off)
  (let (
    (n (strLen src))
    (mut i off)
  )
    {
      (while (&& (< i n) (!= (strByte src i) 10))
        (set i (+ i 1)))
      i
    }
  )
)

; Characters (non-continuation bytes) in [a, b).
;
; No longer on any hot path: the JSON surface's `char_start`/`char_end`
; used to call it as `charsBetween src 0 off`, a scan from byte 0 per
; span, and now calls `charsToIx` (diag.ax) instead. It is kept because
; it is the DEFINITION those counts are checked against -
; `tests/diagnostics/verify-json.py` names it as the semantics its
; derivation reproduces - and because a character count over an
; arbitrary byte range has no other spelling here.
(pub :: charsBetween (-> String Int Int Int))

(pub fn (charsBetween src a b)
  (let (
    (mut i a)
    (mut n 0)
  )
    {
      (while (< i b)
        {
          (if (utf8IsCont (strByte src i))
            0
            (set n (+ n 1))
          )
          (set i (+ i 1))
        })
      n
    }
  )
)

; ASCII-lowercased copy, for flag-value comparison - stage0 accepts
; `HUMAN` and `Json` (`to_ascii_lowercase` in render.rs).
(pub :: lowerAscii (-> String String))

(pub fn (lowerAscii s)
  (let ((n (strLen s)))
    (let (
      (out (strAlloc n))
      (mut i 0)
    )
      {
        (while (< i n)
          (let ((c (strByte s i)))
            {
              (memPutByte
                (strData out)                i                (if (&& (>= c 65) (<= c 90))
                  (+ c 32)
                  c
                )
              )
              (set i (+ i 1))
            }
          ))
        out
      }
    )
  )
)

; ------------------------------------------------------------------
; Format names, exactly the aliases stage0 accepts: human|pretty|rustc,
; ai|agent|compact, json. Answers 0/1/2, or -1 for a name it does not
; know - the caller owns the fallback warning, because only it knows
; whether a flag was given at all.
; ------------------------------------------------------------------
(pub :: FMT_HUMAN Int)

(pub fn (FMT_HUMAN) 0)

(pub :: FMT_AI Int)

(pub fn (FMT_AI) 1)

(pub :: FMT_JSON Int)

(pub fn (FMT_JSON) 2)

(pub :: parseDiagFormatName (-> String Int))

(pub fn (parseDiagFormatName s)
  (let ((v (lowerAscii s)))
    (if (|| (strEq v "human") (|| (strEq v "pretty") (strEq v "rustc")))
      FMT_HUMAN
      (if (|| (strEq v "ai") (|| (strEq v "agent") (strEq v "compact")))
        FMT_AI
        (if (strEq v "json")
          FMT_JSON
          (- 0 1)
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The human renderer.
; ------------------------------------------------------------------
(pub :: sevWord (-> Int String))

(pub fn (sevWord sev)
  (if (== sev SEV_ERROR)
    "error"
    "warning"
  )
)

; ------------------------------------------------------------------
; Display columns.
;
; A CHARACTER column is what AXDL reports and what `colOf` counts. A
; DISPLAY column is where the caret actually lands, and the two stop
; being the same number as soon as a tab appears earlier on the line.
; Every column below is a display column; every column AXDL, `-->` and
; the JSON carry stays a character column, because those are machine
; positions and a tab is one character wherever it is drawn.
;
; A tab advances to the next multiple of TAB_WIDTH rather than emitting
; a fixed four spaces, which is what makes indented code line up - and
; is what stage0 did, by way of ariadne's `tab_width: 4`. Before this
; the renderer echoed the tab raw and then padded the caret with
; SPACES, so a caret under tab-indented source pointed at the wrong
; column by however much the terminal's tab stop differed from one.
; ------------------------------------------------------------------
(pub :: TAB_WIDTH Int)

(pub fn (TAB_WIDTH) 4)

; How wide a line may be quoted before it is quoted as a window, and how
; much of it to keep to the left of the span. A diagnostic on a
; generated or minified line used to echo the whole thing: measured, a
; 4000-column line printed in full, which is not a snippet.
(pub :: LINE_MAX Int)

(pub fn (LINE_MAX) 160)

(pub :: LEFT_CTX Int)

(pub fn (LEFT_CTX) 20)

; The 1-based display column of byte offset `off` within its own line.
; A byte order mark at the start of the text draws nothing, and is not
; counted (`pastBom`) - the same rule `colOf` follows.
; `ix` is `src`'s line index (diag.ax): the line start it begins at
; used to be a rescan from byte 0, which made every caret position
; O(offset) and the whole render O(diagnostics x file size).
(pub :: dispColAt (-> String Int Int Int))

(pub fn (dispColAt src ix off)
  (let (
    (mut i (pastBom src (lineStartOfIx ix off)))
    (mut col 0)
  )
    {
      (while (< i off)
        {
          (if (== (strByte src i) 9)
            (set col (* (+ (/ col TAB_WIDTH) 1) TAB_WIDTH))
            (if (utf8IsCont (strByte src i))
              0
              (set col (+ col 1))
            )
          )
          (set i (+ i 1))
        })
      (+ col 1)
    }
  )
)

; Display width of the bytes in [ls, le).
(pub :: dispWidthLine (-> String Int Int Int))

(pub fn (dispWidthLine src ls le)
  (let (
    (mut i ls)
    (mut col 0)
  )
    {
      (while (< i le)
        {
          (if (== (strByte src i) 9)
            (set col (* (+ (/ col TAB_WIDTH) 1) TAB_WIDTH))
            (if (utf8IsCont (strByte src i))
              0
              (set col (+ col 1))
            )
          )
          (set i (+ i 1))
        })
      col
    }
  )
)

; Where the quoted window of a line of display width `dw` begins, given
; a span starting at 1-based display column `dcol`. 0 whenever the whole
; line fits, which is every line in the corpus.
(pub :: winStart (-> Int Int Int))

(pub fn (winStart dw dcol)
  (if (<= dw LINE_MAX)
    0
    ; A window that would run off the end is pushed back to end at
    ; the line's end instead, so the last columns are never quoted
    ; as a short window with nothing after them.
    (let ((s0 (- (- dcol 1) LEFT_CTX)))
      (let ((s 
        (if (< s0 0)
          0
          s0
        )
      ))
        (if (>= (+ s LINE_MAX) dw)
          (let ((t (- dw LINE_MAX)))
            (if (< t 0)
              0
              t
            )
          )
          s
        )
      )
    )
  )
)

(pub :: winEnd (-> Int Int Int))

(pub fn (winEnd dw dcol)
  (if (<= dw LINE_MAX)
    dw
    (let ((e (+ (winStart dw dcol) LINE_MAX)))
      (if (> e dw)
        dw
        e
      )
    )
  )
)

; The bytes of [ls, le) whose display columns lie in [a, b), with tabs
; expanded. A tab is emitted column by column, so one straddling the
; window's edge contributes only the columns inside it; a multi-byte
; character is emitted whole at its lead byte.
(pub :: expandWindow (-> String Int Int Int Int String))

(pub fn (expandWindow src ls le a b)
  (let (
    (parts vecNew)
    (mut i ls)
    (mut col 0)
  )
    {
      (while (< i le)
        (let ((by (strByte src i)))
          {
            (if (== by 9)
              (let ((stop (* (+ (/ col TAB_WIDTH) 1) TAB_WIDTH)))
                (while (< col stop)
                  {
                    (if (&& (>= col a) (< col b))
                      (vecPush parts " ")
                      (cast (Vec String) 0)
                    )
                    (set col (+ col 1))
                  })
              )
              (if (utf8IsCont by)
                0
                (let ((n0 (utf8SeqLen by)))
                  (let ((n 
                    (if (> (+ i n0) le)
                      (- le i)
                      n0
                    )
                  ))
                    {
                      (if (&& (>= col a) (< col b))
                        (vecPush parts (strSlice src i n))
                        (cast (Vec String) 0)
                      )
                      (set col (+ col 1))
                    }
                  )
                )
              )
            )
            (set i (+ i 1))
          }
        ))
      (catStrs parts)
    }
  )
)

; The two lines one labeled span renders as: the source line with its
; gutter, and the underline row beneath it. `ch` is the underline
; byte - `^` for the primary span, `-` for the related one. The run
; covers the span clamped to its own line and to the quoted window, and
; is never shorter than one column even for an empty span.
(pub :: labelBlock (-> String Int Int Int Int Int String String String))

(pub fn (labelBlock src ix gw start end ch msg sgr)
  ; Clamp the underline to the window it is drawn in.
  (let (
    (ls (lineStartOfIx ix start))
    (le (lineEndOf src start))
    (ln (lineOfIx ix start))
  )
    (let (
      (dcol (dispColAt src ix start))
      (dw (dispWidthLine src ls le))
      (m (if (==
        (cast Int msg)        0
      )
        ""
        msg
      ))
    )
      (let (
        (dend (dispColAt
          src          ix          (if (< end le)
            end
            le
          )
        ))
        (ws (winStart dw dcol))
        (we (winEnd dw dcol))
      )
        (let ((run0 (- dend dcol)))
          (let ((run1 
            (if (< run0 1)
              1
              run0
            )
          ))
            (let ((run2 
              (if (> (+ (- dcol 1) run1) we)
                (- we (- dcol 1))
                run1
              )
            ))
              (let (
                (run (if (< run2 1)
                  1
                  run2
                ))
                (lead (if (> ws 0)
                  "..."
                  ""
                ))
                (tail (if (< we dw)
                  "..."
                  ""
                ))
              )
                (strConcat
                  (strConcat (strConcat (paint SGR_GUT (strConcat (rjNum ln gw) " |")) (strConcat " " (strConcat (strConcat lead (expandWindow
                    src                    ls                    le                    ws                    we
                  )) tail))) "\n")                  (strConcat
                    (strConcat
                      (strConcat (paint SGR_GUT (strConcat (spacesN gw) " |")) " ")                      (strConcat
                        (spacesN (+ (strLen lead) (- (- dcol 1) ws)))                        (paint
                          sgr                          (strConcat
                            (repByte run ch)                            (if (== (strLen m) 0)
                              ""
                              (strConcat " " m)
                            )
                          )
                        )
                      )
                    )                    "\n"
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The last position in `src` that a caret can sit on: one past the
; final character of the last non-empty line. A span at or beyond the
; end of the source is moved here, and every other span is left alone.
(pub :: clampToSource (-> String Int Int))

(pub fn (clampToSource src span)
  (if (== span 0)
    0
    (let ((n (strLen src)))
      (if (< (spanStart span) n)
        span
        ; Step back over a trailing newline so the caret lands at
        ; the end of the last line of text rather than on a line
        ; that has no characters in it.
        (let ((p 
          (if (&& (> n 0) (== (strByte src (- n 1)) 10))
            (- n 1)
            n
          )
        ))
          (mkSpan p p)
        )
      )
    )
  )
)

; `   = help: ...` - one per help the diagnostic carries, in the order
; stage0 stores them, with the standing `axiom explain` pointer last.
; `= help: ...`. The marker is painted and the prose is not, the way
; rustc does it: the eye finds the label, the sentence stays readable in
; a log. A machine-applicable replacement takes its own colour, because
; it is the one part of a help that is text to type rather than text to
; read.
; ------------------------------------------------------------------
; Control bytes in a diagnostic's own TEXT, escaped for the human
; surface.
;
; This is not `quoteStr`: human text is not quoted, so `"` and `\`
; stand for themselves and only the bytes a TERMINAL would act on are
; rewritten. Diagnostic text can hold one, because some of it is a
; source slice - a macro rule's accepted shape is the author's own
; pattern spelling (MAC-LANG-18), and a string literal's spelling is
; whatever bytes the file holds. Two reasons this matters more here
; than in AXDL:
;
;   * this surface goes to a terminal, so a raw ESC lets a diagnostic
;     write escape SEQUENCES into whatever prints it - the renderer's
;     own colours are chosen by `style.ax`, and nothing from a source
;     file should be able to add to them;
;   * a raw newline splits one diagnostic's heading across lines, and
;     `scripts/check-render-selfhost.sh` cross-derives this surface
;     from the AXDL golden, which escapes them - so the two disagree
;     the moment either sees one.
;
; Found 2026-08-16, with the AXDL and JSON halves of the same hole;
; `tests/diagnostics/478-json-control-bytes.ax` pins all three.
; A diagnostic with no label carries 0 rather than an empty String, and
; every caller downstream already tests for it (`renderDiagJson` does,
; at the `diagLabel` read). Walking one here read `strLen` off a null
; handle and took the whole renderer down with SIGSEGV - a crash that
; only the human surface showed, because it is the only one that walks
; a label unconditionally. Answer the null back and let the existing
; tests keep deciding what an absent label prints as.
;
; PERFORMANCE, 2026-08-24, after an audit reproduced it: this used to
; rebuild the whole answer on every input byte -
; `(set acc (strConcat acc (strSlice s i 1)))` - allocating a fresh
; buffer of length i+1 per byte. The allocator is a bump allocator with
; NO FREE, so no intermediate is ever reclaimed and a string of length
; n costs sum(i+1) = n^2/2 bytes allocated as well as n^2/2 bytes
; copied.
;
; That length is chosen by the source file, not by this compiler:
; AX3001's message is "undefined variable `<ident>`" with the
; identifier copied VERBATIM, so one long identifier sets it. Measured
; on `axiom check` over a file whose only error is one undefined
; identifier of length n:
;
;     n = 16 KB   0.146s    263 MB peak RSS
;     n = 32 KB   0.494s   1040 MB peak RSS
;     n = 64 KB   1.931s   4142 MB peak RSS
;
; - 4x per doubling in both, the signature of the n^2, and the memory
; is the worse half. The same 64 KB identifier costs 0.035s and 2.3 MB
; when it is DEFINED and so produces no diagnostic, which is what
; proves the renderer is the cost and not the lexer.
;
; After, same three points: 0.039s / 2.4 MB, 0.054s / 2.8 MB, 0.055s /
; 4.0 MB - flat where it was quadrupling. It is linear from there on,
; which the old shape could not have reached at all: 1 MB costs 0.322s
; and 35 MB, 4 MB costs 1.157s and 134 MB.
;
; It now accumulates escape-free RUNS as slices - `strSlice` is a
; header over the original bytes, no copy - and joins once with
; `catStrs`, the single linear join this module already uses
; everywhere else. An escape-free string is answered back unchanged and
; touches the allocator not at all, the way `stdlib/Json.ax`'s
; `jsonEscape` answers its own; the worst case is one escape per byte,
; O(n).
;
; The output is byte for byte what it was: the escape tests below are
; in the original order and produce the same bytes, and `run` reaching
; the end unmoved means no byte needed escaping, so answering `s` is
; answering the copy the old code would have built.
(pub :: ctlEsc (-> String String))

(pub fn (ctlEsc s)
  (if (==
    (cast Int s) 0
  )
    s
    ; Start of the current escape-free run, and doubling as the "has
    ; anything been escaped at all" flag: any escape moves it past 0.
    (let (
      (n (strLen s))
      (parts vecNew)
      (mut i 0)
      (mut run 0)
    )
      {
        (while (< i n)
          (let ((b (strByte s i)))
            {
              (if (|| (< b 32) (== b 127))
                {
                  (if (> i run)
                    (vecPush parts (strSlice s run (- i run)))
                    (cast (Vec String) 0)
                  )
                  (vecPush
                    parts                    (if (== b 10)
                      "\\n"
                      (if (== b 9)
                        "\\t"
                        (if (== b 13)
                          "\\r"
                          (quoteUesc b)
                        )
                      )
                    )
                  )
                  (set run (+ i 1))
                }
                0
              )
              (set i (+ i 1))
            }
          ))
        (if (== run 0)
          s
          {
            (if (> n run)
              (vecPush parts (strSlice s run (- n run)))
              (cast (Vec String) 0)
            )
            (catStrs parts)
          }
        )
      }
    )
  )
)

; `ctlEsc` is applied to the DIAGNOSTIC'S OWN text at the point it
; enters a line, never to a composed one: `helpLineFix` hands
; `helpLine` a string that already carries `paint`'s SGR escapes, and
; escaping those turns the renderer's own colours into the literal
; text `\u{1b}[...`. Seven fixtures with a machine-applicable fix said
; so immediately when the escape sat inside `helpLine` instead.
(pub :: helpLine (-> Int String String))

(pub fn (helpLine gw text) (strConcat (strConcat (strConcat (spacesN gw) (paint SGR_GUT " = ")) (paint SGR_HELP "help: ")) (strConcat text "\n")))

(pub :: helpLineEsc (-> Int String String))

(pub fn (helpLineEsc gw text) (helpLine gw (ctlEsc text)))

; A fix that spans lines is printed as the block of source it is.
;
; The replacement went through `ctlEsc` like every other string that
; enters a line, so a line break inside it printed as the two bytes
; `\n` - right on the AXDL line, which is escaped precisely so that one
; diagnostic stays one line, and wrong on this surface, which is for a
; person:
;
;   = help: add the missing arms, each a `todo` until it is written ~> \n      ((B) (todo "B"))
;   = help: import `todo` from IO ~> (import IO (todo))\n
;
; Ten goldens carried that and check-render-selfhost.sh was green on
; every one, because its help-line derivation read the AXDL's `~>`
; field with the `\n` still escaped and so matched the defect byte for
; byte. The gate now undoes that one escape before deriving, and fails
; by name on the two bytes.
;
; The rule. A replacement with no line break stays on the help line
; after `~>`, as before: ` ~> mut x` is text to splice into a line. One
; WITH a line break ends the help line at `~>` and follows on lines of
; its own, one per line of the replacement, each indented to the
; column the help text starts in (`gw` plus the width of ` = help: `)
; and otherwise verbatim - the source's own indentation is kept, so a
; two-arm insertion reads with the arms aligned as they will sit in
; the file:
;
;   = help: add the missing arms, each a `todo` until it is written ~>
;                ((Green _) (todo "Green"))
;                ((Blue) (todo "Blue"))
;   = help: import `todo` from IO ~>
;           (import IO (todo))
;
; A leading line break prints no empty line - the arms insertion
; begins with one because it is anchored at the end of the last arm,
; and the break after `~>` is it. A trailing one prints no empty line
; either - the whole-line insertions `(import IO (todo))\n` and
; `;@axiom:effect(io)\n` end in one, and the last line's own
; terminator is it. What keeps a whole-line insertion unambiguous is
; the form itself: a replacement printed on lines of its own is lines,
; and the only replacement that shares the help line is one with no
; line break in it. An empty line INSIDE a replacement prints as its
; indentation alone, never as a blank line, because a blank line is
; what separates one diagnostic's block from the next and the gate
; splits on exactly that.
;
; Every other control byte still escapes: the split is on byte 10 and
; each line still passes through `ctlEsc`, so a tab in a replacement
; prints `\t` as it did. Painted per line rather than once around the
; block, because the gate's escape check requires every line's SGR
; sequences to open and reset on that line - a colour left open at a
; newline is one the terminal keeps.
(pub :: helpLineFix (-> Int String String String))

(pub fn (helpLineFix gw text repl)
  ; `strFindByte` answers `(Option Int)` since the ERR-ADOPT slice, so
  ; "carries no newline" is `None` rather than a negative index.
  (match (strFindByte repl 10 0)
    ((None) (helpLine gw (strConcat (ctlEsc text) (paint SGR_FIX (strConcat " ~> " (ctlEsc repl))))))
    ((Some _) (strConcat (helpLine gw (strConcat (ctlEsc text) (paint SGR_FIX " ~>"))) (fixBlock (+ gw 9) repl)))
  )
)

; The lines of a multi-line replacement, each indented `indent`
; columns, escaped and painted on its own. An empty first or last
; segment is the leading or trailing line break and prints nothing;
; an empty segment between two others prints its indentation only.
(pub :: fixBlock (-> Int String String))

(pub fn (fixBlock indent repl)
  (let (
    (segs (strSplit repl 10))
    (acc vecNew)
    (mut i 0)
    (mut end (vecLen segs))
  )
    {
      (if (== (strLen (vecGetStr segs 0)) 0)
        (set i 1)
        0
      )
      (if (== (strLen (vecGetStr segs (- end 1))) 0)
        (set end (- end 1))
        0
      )
      (while (< i end)
        (let ((seg (vecGetStr segs i)))
          {
            (vecPush acc (spacesN indent))
            (if (> (strLen seg) 0)
              (vecPush acc (paint SGR_FIX (ctlEsc seg)))
              (cast (Vec String) 0)
            )
            (vecPush acc "\n")
            (set i (+ i 1))
          }
        ))
      (catStrs acc)
    }
  )
)

; `   = note: ...`, which renders before the helps.
(pub :: noteLine (-> Int String String))

(pub fn (noteLine gw text) (strConcat (strConcat (strConcat (spacesN gw) (paint SGR_GUT " = ")) (paint SGR_TITLE "note: ")) (strConcat (ctlEsc text) "\n")))

; ------------------------------------------------------------------
; The rows of one snippet: one per labeled span, in source order.
;
; This was two spans and a comparison - the primary, and at most one
; related - because the Diag record held at most one related span. It
; now holds a vector of them, so the snippet is a sorted list.
; ------------------------------------------------------------------
(pub struct SnipRow
  (span : Int)
  (ch : Int)
  (msg : String)
  (sgr : String))

(pub :: rowSpan (-> Int Int))

(pub fn (rowSpan r) (memGetWord r 0))

(pub :: rowCh (-> Int Int))

(pub fn (rowCh r) (memGetWord r 1))

(pub :: rowMsg (-> Int String))

(pub fn (rowMsg r) (memGetWordStr r 2))

(pub :: rowSgr (-> Int String))

(pub fn (rowSgr r) (memGetWordStr r 3))

; Insertion sort by span START. The code this replaces compared LINE
; numbers and put the related span first on a tie, which agreed with
; source order on every corpus case only because the related span is
; also the leftmost one there - 070-nonascii-same-line puts two labels
; on line 3 at columns 6 and 22, and the first defined is the first
; written. Sorting by offset says the same thing about that case and the
; right thing about the case where it is not.
(pub :: sortRows (-> (Vec Int) (Vec Int)))

(pub fn (sortRows rows)
  (let (
    (n (vecLen rows))
    (mut i 1)
  )
    {
      (while (< i n)
        (let (
          (cur (vecGet rows i))
          (mut j i)
        )
          {
            (while (&& (> j 0) (> (spanStart (rowSpan (vecGet rows (- j 1)))) (spanStart (rowSpan cur))))
              {
                (vecSet rows j (vecGet rows (- j 1)))
                (set j (- j 1))
              })
            (vecSet rows j cur)
            (set i (+ i 1))
          }
        ))
      rows
    }
  )
)

; The primary span underlined with `^` and carrying the diagnostic's own
; label, then every related span with `-` and its note.
;
; ONLY the related spans this snippet can draw. A snippet is quoted out
; of ONE source - `src` and `ix` are the diagnostic's own unit's - so a
; related location in another unit cannot be underlined here at all:
; its line number indexes a different file, and drawing it against this
; one would quote the wrong text under a caret that looks right. Those
; become note lines instead (`secNoteText`), which is the same
; degradation an expansion frame with no reachable unit already takes.
; A related location with no span at all has nothing to underline
; anywhere and becomes a note too.
(pub :: snipRowsOf (-> Int Int (Vec Int) (Vec Int) (Vec a)))

(pub fn (snipRowsOf d span units ixs)
  ; The primary underline takes the diagnostic's own severity
  ; colour; a related one is always secondary.
  (let (
    (rows vecNew)
    (mut i 0)
  )
    {
      (vecPush
        rows        (cast Int (SnipRow span 94 (ctlEsc (diagLabel d)) (sgrForSev (diagSev d))))
      )
      (while (< i (diagSecCount d))
        {
          (if (== (secDrawable d i units ixs) 1)
            {
              (vecPush
                rows                (cast Int (SnipRow (diagSecSpan d i) 45 (ctlEsc (diagSecMsg d i)) SGR_SEC))
              )
              0
            }
            0
          )
          (set i (+ i 1))
        })
      (sortRows rows)
    }
  )
)

; Can related location `i` be underlined in the PRIMARY snippet? It
; needs a span, and it needs to index the source that snippet is
; quoted from.
(pub :: secDrawable (-> Int Int (Vec Int) (Vec Int) Int))

; `ixs` is unread, and deliberately: drawability is decided by
; `diagSecOwn` and not by `diagSecCross`, because "another unit I
; cannot resolve" is still another unit. Folding the two would draw
; that span against this snippet's source, which is the wrong file.
(pub fn (secDrawable d i units ixs)
  (if (== (diagSecSpan d i) 0)
    0
    (diagSecOwn d i)
  )
)

; The one note line a related location renders as when the snippet
; cannot draw it. Cross-unit, its own file and position are spelled in
; the parenthetical - the same text `fmtSpanIx` puts on the AXDL line,
; so this stays a concatenation and not a second opinion, and
; `check-render-selfhost.sh` derives it from the `^` field. With no
; span the parenthetical says THAT, rather than being left off: a bare
; `note: __syscall3` reads like a truncated line, and the reason there
; is no position is the information.
(pub :: secNoteText (-> Int Int (Vec Int) (Vec Int) String))

(pub fn (secNoteText d i units ixs)
  (if (== (diagSecCross d i units ixs) 1)
    (let ((u (vecGet units (diagSecUnit d i))))
      (strConcat
        (strConcat (strConcat (diagSecMsg d i) " (") (memGetWordStr u 0))        (strConcat (strConcat ":" (fmtSpanIx (memGetWordStr u 1) (vecGet ixs (diagSecUnit d i)) (diagSecSpan d i))) ")")
      )
    )
    (if (== (diagSecSpan d i) 0)
      (strConcat (diagSecMsg d i) " (no declaration to point at)")
      ; Another unit, and no table to name it with. There is a
      ; position; this renderer cannot say where, and says nothing
      ; rather than something false.
      (diagSecMsg d i)
    )
  )
)

; Width of the widest line number any row will print.
(pub :: rowsGutterWidth (-> String Int (Vec Int) Int))

(pub fn (rowsGutterWidth src ix rows)
  (let (
    (mut i 0)
    (mut w 1)
  )
    {
      (while (< i (vecLen rows))
        (let ((n (strLen (decStr (lineOfIx ix (spanStart (rowSpan (vecGet rows i))))))))
          {
            (if (> n w)
              (set w n)
              0
            )
            (set i (+ i 1))
          }
        ))
      w
    }
  )
)

; The labeled blocks, in order, with a `...` row wherever two adjacent
; rows are more than one line apart.
(pub :: snipBody (-> String Int Int (Vec Int) String))

(pub fn (snipBody src ix gw rows)
  (let (
    (out vecNew)
    (mut i 0)
    (mut prev 0)
  )
    {
      (while (< i (vecLen rows))
        (let ((r (vecGet rows i)))
          (let ((ln (lineOfIx ix (spanStart (rowSpan r)))))
            {
              (if (&& (> i 0) (> (- ln prev) 1))
                (vecPush out (strConcat (paint SGR_GUT "...") "\n"))
                (cast (Vec String) 0)
              )
              (vecPush out (labelBlock
                src                ix                gw                (spanStart (rowSpan r))                (spanEnd (rowSpan r))                (rowCh r)                (rowMsg r)                (rowSgr r)
              ))
              (set prev ln)
              (set i (+ i 1))
            }
          )
        ))
      (catStrs out)
    }
  )
)

; One diagnostic as its human block, blank-line terminated.
; The one note line an expansion frame renders as, shared by the human
; renderer below and derived by check-render-selfhost from the AXDL
; `&` field's name and LOC - three spellings, one decision. The
; parenthetical repeats fmtSpan's exact text, so the derivation is a
; concatenation and not a re-parse.
(pub :: traceNoteText (-> Int Int (Vec Int) (Vec Int) String))

(pub fn (traceNoteText d i units ixs)
  (let ((base (strConcat (strConcat "in this expansion of `" (diagTraceName d i)) "`")))
    (let (
      (fs (diagTraceSpan d i))
      (fu (diagTraceUnit d i))
    )
      (if (|| (== fs 0) (|| (== (cast Int units) 0) (>= fu (vecLen units))))
        base
        (let ((u (vecGet units fu)))
          (strConcat (strConcat (strConcat (strConcat (strConcat base " (") (memGetWordStr u 0)) ":") (fmtSpanIx (memGetWordStr u 1) (vecGet ixs fu) fs)) ")")
        )
      )
    )
  )
)

; MAC-DIAG-5: a frame whose unit the caller supplied renders as a
; SECOND location block - the macro's own file, opened, with its
; template's line under a caret - instead of the one-line note above.
; The note form remains for a frame with no span or no reachable
; unit, which is what a REPL-shaped or spanless expansion leaves.
(pub :: traceResolvable (-> Int Int (Vec Int) Int))

(pub fn (traceResolvable d i units)
  (let (
    (fs (diagTraceSpan d i))
    (fu (diagTraceUnit d i))
  )
    (if (|| (== fs 0) (|| (== (cast Int units) 0) (>= fu (vecLen units))))
      0
      1
    )
  )
)

(pub :: traceRows (-> Int Int (Vec Int)))

(pub fn (traceRows d i)
  (let ((rows vecNew))
    {
      (vecPush
        rows        (cast Int (SnipRow (diagTraceSpan d i) 94 (strConcat (strConcat "in this expansion of `" (diagTraceName d i)) "`") SGR_SEC))
      )
      rows
    }
  )
)

; The gutter is one width for the whole report: a frame's line number
; can be wider than the primary's, and two blocks whose bars do not
; line up read as two reports.
(pub :: traceGutterWidth (-> Int (Vec Int) (Vec Int) Int Int))

(pub fn (traceGutterWidth d units ixs w0)
  (let (
    (mut i 0)
    (mut w w0)
  )
    {
      (while (< i (diagTraceCount d))
        {
          (if (== (traceResolvable d i units) 1)
            (let ((u (vecGet units (diagTraceUnit d i))))
              (let ((n (rowsGutterWidth (memGetWordStr u 1) (vecGet ixs (diagTraceUnit d i)) (traceRows d i))))
                (if (> n w)
                  (set w n)
                  0
                )
              )
            )
            0
          )
          (set i (+ i 1))
        })
      w
    }
  )
)

(pub :: traceBlocks (-> Int (Vec Int) (Vec Int) Int String))

(pub fn (traceBlocks d units ixs gw)
  (let (
    (out vecNew)
    (mut i 0)
  )
    {
      (while (< i (diagTraceCount d))
        {
          (if (== (traceResolvable d i units) 1)
            ; The FRAME's index, not the diagnostic's: this block
            ; is drawn against the macro's own source.
            (let (
              (u (vecGet units (diagTraceUnit d i)))
              (rows (traceRows d i))
            )
              (let (
                (fsrc (memGetWordStr u 1))
                (fix (vecGet ixs (diagTraceUnit d i)))
                (ffile (memGetWord u 0))
                (fs (diagTraceSpan d i))
              )
                (let ((bar (strConcat (paint SGR_GUT (strConcat (spacesN gw) " |")) "\n")))
                  {
                    (vecPush
                      out                      (strConcat
                        (strConcat (spacesN gw) (paint SGR_GUT "--> "))                        (strConcat
                          (strConcat
                            (strConcat
                              (strConcat
                                (cast String ffile)                                ":"
                              )                              (decStr (lineOfIx fix (spanStart fs)))
                            )                            ":"
                          )                          (strConcat (decStr (colOfIx fsrc fix (spanStart fs))) "\n")
                        )
                      )
                    )
                    (vecPush out bar)
                    (vecPush out (snipBody fsrc fix gw rows))
                    (vecPush out bar)
                  }
                )
              )
            )
            (cast (Vec String) 0)
          )
          (set i (+ i 1))
        })
      (catStrs out)
    }
  )
)

; `ix` is `src`'s line index and `ixs` the whole unit table's, both
; built once per render by the caller - see THE LINE INDEX in diag.ax.
(pub :: renderDiagHuman (-> Int String String (Vec Int) Int (Vec Int) String))

(pub fn (renderDiagHuman d src file units ix ixs)
  ; A span that starts AT the end of the source is the
  ; end-of-file diagnostic - an unclosed `(` is the commonest
  ; syntax error there is - and it used to render spanless,
  ; with no snippet at all. There is a line to show: the last
  ; one, with the caret one past its final character, which is
  ; where stage0's own human renderer puts it (probed: AXDL
  ; says 2:1 for a one-line file, the report says 1:11). Only
  ; the DISPLAY position is clamped; the machine-readable
  ; location still reports where the file actually ran out.
  ; A spanless diagnostic draws no snippet, so it has no rows and
  ; its gutter is one column wide.
  ; An expansion frame whose file this
  ; renderer could open became a location
  ; block above (MAC-DIAG-5); one it could
  ; not still reads as a note, which is
  ; the whole of what MAC-DIAG-4 shipped.
  ; A MACHINE-APPLICABLE help shows the
  ; replacement it would apply. stage0
  ; stored one and never printed it:
  ; ariadne read only `help.message`,
  ; so `~>` reached AXDL and no human
  ; ever saw it. The `~>` spelling is
  ; AXDL's, deliberately - one fact,
  ; one notation, whichever surface a
  ; reader is looking at.
  (let (
    (sev (diagSev d))
    (code (diagCode d))
    (span (diagSpan d))
    (msg (diagMsg d))
  )
    (let (
      (head (strConcat (paint (sgrForSev sev) (strConcat (strConcat (strConcat (sevWord sev) "[") code) "]")) (strConcat (paint SGR_TITLE (strConcat ": " (ctlEsc msg))) "\n")))
      (span (clampToSource src span))
      (spanless (== span 0))
    )
      (let ((rows
        (if spanless
          vecNew
          (snipRowsOf d span units ixs)
        )
      ))
        (let ((gw 
          (traceGutterWidth
            d            units            ixs            (if spanless
              1
              (rowsGutterWidth src ix rows)
            )
          )
        ))
          (let (
            (loc (strConcat
              (strConcat (spacesN gw) (paint SGR_GUT "--> "))              (if spanless
                (strConcat file "\n")
                (strConcat (strConcat (strConcat (strConcat file ":") (decStr (lineOfIx ix (spanStart span)))) ":") (strConcat (decStr (colOfIx src ix (spanStart span))) "\n"))
              )
            ))
            (bar (strConcat (paint SGR_GUT (strConcat (spacesN gw) " |")) "\n"))
          )
            (let (
              (snippet (strConcat
                (if spanless
                  ""
                  (strConcat (strConcat bar (snipBody src ix gw rows)) bar)
                )                (traceBlocks d units ixs gw)
              ))
              (notes (let (
                (acc vecNew)
                (mut i 0)
              )
                {
                  (while (< i (diagNoteCount d))
                    {
                      (vecPush acc (noteLine gw (diagNote d i)))
                      (set i (+ i 1))
                    })
                  ; A related location the snippet could not draw -
                  ; another unit's, or none at all - as a note. The
                  ; snippet has already drawn every other one.
                  (set i 0)
                  (while (< i (diagSecCount d))
                    {
                      (if (== (secDrawable d i units ixs) 1)
                        0
                        { (vecPush acc (noteLine gw (secNoteText d i units ixs))) 0 }
                      )
                      (set i (+ i 1))
                    })
                  (set i 0)
                  (while (< i (diagTraceCount d))
                    {
                      (if (== (traceResolvable d i units) 1)
                        0
                        { (vecPush acc (noteLine gw (traceNoteText d i units ixs))) 0 }
                      )
                      (set i (+ i 1))
                    })
                  (catStrs acc)
                }
              ))
            )
              (let ((helps 
                (let (
                  (acc vecNew)
                  (mut i 0)
                )
                  {
                    (while (< i (diagHelpCount d))
                      {
                        (vecPush
                          acc                          (if (== (diagHelpFixSpan d i) 0)
                            (helpLineEsc gw (diagHelpMsg d i))
                            (helpLineFix gw (diagHelpMsg d i) (diagHelpFixText d i))
                          )
                        )
                        (set i (+ i 1))
                      })
                    (vecPush acc (helpLine gw (strConcat (strConcat "run `axiom explain " code) "` for a full explanation")))
                    (catStrs acc)
                  }
                )
              ))
                (strConcat (strConcat (strConcat (strConcat (strConcat head loc) snippet) notes) helps) "\n")
              )
            )
          )
        )
      )
    )
  )
)

; Every diagnostic, each rendered against the source file its `unit`
; field names - the same table renderDiagsUnits (AXDL) reads.
(pub :: renderDiagsHumanUnits (-> (Vec Int) (Vec Int) String))

(pub fn (renderDiagsHumanUnits ds units)
  ; ONE index per unit for the whole report. The number of
  ; diagnostics is uncapped and each used to rescan its source from
  ; byte 0 for the primary span, every secondary row and every
  ; expansion frame, which made this O(diagnostics x file size):
  ; 1000 AXTAG warnings cost 0.218s, 2000 cost 0.790s, 4000 cost
  ; 3.146s - 4x per doubling - and the audit's 16,000 cost 49.788s.
  ; They now cost 0.037s, 0.051s, 0.095s and 0.635s. See THE LINE
  ; INDEX in diag.ax for the whole measurement.
  (let (
    (blocks vecNew)
    (ixs (unitIndexes units))
    (mut i 0)
  )
    {
      (while (< i (vecLen ds))
        (let ((d (vecGet ds i)))
          (let ((u 
            (vecGet
              units              (if (< (diagUnit d) (vecLen units))
                (diagUnit d)
                0
              )
            )
          ))
            {
              (vecPush blocks (renderDiagHuman
                d                (memGetWordStr u 1)                (memGetWordStr u 0)                units                (indexForUnit ixs (diagUnit d))                ixs
              ))
              (set i (+ i 1))
            }
          )
        ))
      ; A single linear join, not a strConcat fold - the fold's peak
      ; is the sum of every intermediate (see catStrs in diag.ax).
      (catStrs blocks)
    }
  )
)

; The trailer stage0's CLI prints after failed compilation, in every
; format - the AXDL differential gate never saw it because its grep
; keeps only `^[EWNH] ` lines (probed 2026-08-07: stage0 prints it in
; `ai` mode too). Errors only, post-suppression, pluralized.
(pub :: renderFailTrailer (-> Int String))

(pub fn (renderFailTrailer n)
  (strConcat
    (strConcat "compilation failed due to " (decStr n))    (if (== n 1)
      " previous error\n"
      " previous errors\n"
    )
  )
)

; ------------------------------------------------------------------
; JSON Lines, stage0's `render_json` shape: one object per line. The
; escapes are the three stage0 applies - `\"`, `\\`, `\n` - no more.
; `char_start`/`char_end` are CHARACTER offsets: stage0's spans count
; characters end to end, stage1's count bytes, so the conversion here
; is what keeps the two compilers' JSON agreeing on a non-ASCII file.
;
; `label` used to be the literal `""`, recorded as a known delta because
; AXDL never printed stage0's primary label and so stage1 never stored
; one. It stores one now, and prints it. `related`, `notes` and `help`
; are arrays over the Diag's vectors rather than over one, one and two
; scalar fields; `expansion` is new and has no stage0 counterpart -
; stage0 carried the backtrace in its Diagnostic and its AXDL grammar,
; but never in its JSON, because nothing ever populated it.
; ------------------------------------------------------------------
; A hex digit, and the `\u00XX` form for a control byte with no
; two-character escape. Named apart from codegen's `hexDigit`/`hex2`
; because imports join one flat top-level namespace.
(pub :: jsonHexDigit (-> Int Int))

(pub fn (jsonHexDigit n)
  (if (< n 10)
    (+ 48 n)
    (+ 55 n)
  )
)

(pub :: jsonUesc (-> Int String))

(pub fn (jsonUesc b)
  (let ((s (strAlloc 6)))
    {
      (__store8 (strData s) 0 92)  ; \
      (__store8 (strData s) 1 117)  ; u
      (__store8 (strData s) 2 48)  ; 0
      (__store8 (strData s) 3 48)  ; 0
      (__store8 (strData s) 4 (jsonHexDigit (/ b 16)))
      (__store8 (strData s) 5 (jsonHexDigit (% b 16)))
      s
    }
  )
)

; RFC 8259 forbids a raw byte below 0x20 inside a string, and this
; escaped three of them: `\"`, `\\` and `\n`, stage0's set. Every
; other control byte went through untouched, so any diagnostic that
; QUOTED a source lexeme carrying one emitted JSON no parser accepts.
; A tab is the easy one - `(data D "a<TAB>b")` is a one-line program
; whose AX2001 message echoes the literal - and a CR arrives free on
; every CRLF file. Found 2026-08-16; `tests/diagnostics/478-json-
; control-bytes.ax` pins it, and the `.json` golden is machine-checked
; as parseable rather than only diffed.
;
; The two-character forms are used where JSON defines them, so the
; common cases stay readable in a log; the rest take `\u00XX`. Bytes
; at or above 0x20 are copied as-is, which keeps UTF-8 sequences
; intact - JSON strings carry them literally.
;
; PERFORMANCE, 2026-08-24: this carried `ctlEsc`'s quadratic shape
; exactly - a fresh buffer of length i+1 per input byte, never
; reclaimed - and the JSON surface is reached by the same untrusted
; spelling, so it measured the same. `axiom check
; --diagnostic-format=json` over one undefined identifier of length n:
;
;     n = 16 KB   0.144s    263 MB peak RSS
;     n = 32 KB   0.492s   1039 MB peak RSS
;     n = 64 KB   1.861s   4142 MB peak RSS
;
; After: 0.030s / 2.2 MB, 0.041s / 2.6 MB, 0.044s / 3.3 MB, and a 1 MB
; identifier costs 0.324s / 25 MB. Same run-and-join rewrite as
; `ctlEsc` above, and the escape tests are in their original order, so
; the bytes are unchanged. Note the set differs from `ctlEsc`'s: `"`
; and `\` are escaped because this IS quoted, and DEL is not, per the
; comment above.
(pub :: jsonEsc (-> String String))

(pub fn (jsonEsc s)
  (let (
    (n (strLen s))
    (parts vecNew)
    (mut i 0)
    (mut run 0)
  )
    {
      (while (< i n)
        (let ((b (strByte s i)))
          {
            (if (|| (< b 32) (|| (== b 34) (== b 92)))
              {
                (if (> i run)
                  (vecPush parts (strSlice s run (- i run)))
                  (cast (Vec String) 0)
                )
                (vecPush
                  parts                  (if (== b 34)
                    "\\\""
                    (if (== b 92)
                      "\\\\"
                      (if (== b 10)
                        "\\n"
                        (if (== b 9)
                          "\\t"
                          (if (== b 13)
                            "\\r"
                            (if (== b 8)
                              "\\b"
                              (if (== b 12)
                                "\\f"
                                (jsonUesc b)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
                (set run (+ i 1))
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      (if (== run 0)
        s
        {
          (if (> n run)
            (vecPush parts (strSlice s run (- n run)))
            (cast (Vec String) 0)
          )
          (catStrs parts)
        }
      )
    }
  )
)

; Six position queries per span, and `char_start`/`char_end` used to be
; counts from byte 0 on top of the four line/column scans - the widest
; of the three surfaces and the one that paid most. All six now read
; the index; `charsToIx` walks only the span's own line.
(pub :: jsonSpan (-> String Int Int String))

(pub fn (jsonSpan src ix span)
  (let (
    (s (spanStart span))
    (e0 (spanEnd span))
  )
    (let ((e 
      (if (< e0 s)
        s
        e0
      )
    ))
      (strConcat (strConcat (strConcat (strConcat (strConcat (strConcat (strConcat (strConcat (strConcat (strConcat "{\"start\":{\"line\":" (decStr (lineOfIx ix s))) ",\"col\":") (decStr (colOfIx src ix s))) "},\"end\":{\"line\":") (decStr (lineOfIx ix e))) ",\"col\":") (decStr (colOfIx src ix e))) "},\"char_start\":") (decStr (charsToIx src ix s))) (strConcat (strConcat ",\"char_end\":" (decStr (charsToIx src ix e))) "}"))
    )
  )
)

; A JSON array of quoted strings.
(pub :: jsonStrArray (-> (Vec String) String))

(pub fn (jsonStrArray items)
  (let (
    (parts vecNew)
    (mut i 0)
  )
    {
      (vecPush parts "[")
      (while (< i (vecLen items))
        {
          (if (> i 0)
            (vecPush parts ",")
            (cast (Vec String) 0)
          )
          (vecPush parts "\"")
          (vecPush parts (jsonEsc (vecGetStr items i)))
          (vecPush parts "\"")
          (set i (+ i 1))
        })
      (vecPush parts "]")
      (catStrs parts)
    }
  )
)

(pub :: jsonHelpArray (-> Int String))

(pub fn (jsonHelpArray d)
  (let (
    (v vecNew)
    (mut i 0)
  )
    {
      (while (< i (diagHelpCount d))
        {
          (vecPush v (diagHelpMsg d i))
          (set i (+ i 1))
        })
      (jsonStrArray v)
    }
  )
)

(pub :: jsonNoteArray (-> Int String))

(pub fn (jsonNoteArray d)
  (let (
    (v vecNew)
    (mut i 0)
  )
    {
      (while (< i (diagNoteCount d))
        {
          (vecPush v (diagNote d i))
          (set i (+ i 1))
        })
      (jsonStrArray v)
    }
  )
)

; One object per frame: `{"macro":name}` bare, plus
; `"file"/"line"/"col"` - the macro declaration's START position in
; ITS OWN unit - when the frame carries a span the unit table can
; resolve. The numbers are the same ones the AXDL LOC prints, which is
; what lets verify-json.py derive this array from that field.
(pub :: jsonTraceArray (-> Int (Vec Int) (Vec Int) String))

(pub fn (jsonTraceArray d units ixs)
  (let (
    (parts vecNew)
    (mut i 0)
  )
    {
      (vecPush parts "[")
      (while (< i (diagTraceCount d))
        {
          (if (> i 0)
            (vecPush parts ",")
            (cast (Vec String) 0)
          )
          (vecPush parts "{\"macro\":\"")
          (vecPush parts (jsonEsc (diagTraceName d i)))
          (vecPush parts "\"")
          (let (
            (fs (diagTraceSpan d i))
            (fu (diagTraceUnit d i))
          )
            (if (|| (== fs 0) (|| (== (cast Int units) 0) (>= fu (vecLen units))))
              0
              (let ((u (vecGet units fu)))
                (let (
                  (fsrc (memGetWordStr u 1))
                  (fix (vecGet ixs fu))
                )
                  {
                    { (vecPush parts ",\"file\":\"") 0 }
                    (vecPush parts (jsonEsc (memGetWordStr u 0)))
                    (vecPush parts "\",\"line\":")
                    (vecPush parts (decStr (lineOfIx fix (spanStart fs))))
                    (vecPush parts ",\"col\":")
                    (vecPush parts (decStr (colOfIx fsrc fix (spanStart fs))))
                    0
                  }
                )
              )
            )
          )
          (vecPush parts "}")
          (set i (+ i 1))
        })
      (vecPush parts "]")
      (catStrs parts)
    }
  )
)

; One object per related location. `{"span":...,"label":...}` when it
; points into the diagnostic's own unit, which is every one this array
; used to hold; plus a `"file"` beside the span - and the span read
; against THAT unit's source - when it points into another, the shape
; `expansion` already uses; and the label alone, with no span key at
; all, when the location is absent. A consumer reads the three the way
; it reads a spanless diagnostic: the pair is there or it is not.
(pub :: jsonRelatedArray (-> Int String Int (Vec Int) (Vec Int) String))

(pub fn (jsonRelatedArray d src ix units ixs)
  (let (
    (parts vecNew)
    (mut i 0)
  )
    {
      (vecPush parts "[")
      (while (< i (diagSecCount d))
        {
          (if (> i 0)
            (vecPush parts ",")
            (cast (Vec String) 0)
          )
          (vecPush parts "{")
          ; The span pair is omitted for the same two cases the AXDL
          ; `^-` covers: no location, and a location in a unit this
          ; renderer has no table to name.
          (if (|| (== (diagSecSpan d i) 0) (&& (== (diagSecOwn d i) 0) (== (diagSecCross d i units ixs) 0)))
            (cast (Vec String) 0)
            (if (== (diagSecOwn d i) 1)
              {
                { (vecPush parts "\"span\":") 0 }
                (vecPush parts (jsonSpan src ix (diagSecSpan d i)))
                (vecPush parts ",")
              }
              (let ((u (vecGet units (diagSecUnit d i))))
                {
                  { (vecPush parts "\"span\":") 0 }
                  (vecPush parts (jsonSpan (memGetWordStr u 1) (vecGet ixs (diagSecUnit d i)) (diagSecSpan d i)))
                  (vecPush parts ",\"file\":\"")
                  (vecPush parts (jsonEsc (memGetWordStr u 0)))
                  (vecPush parts "\",")
                }
              )
            )
          )
          (vecPush parts "\"label\":\"")
          (vecPush
            parts            (jsonEsc
              (if (==
                (cast Int (diagSecMsg d i))                0
              )
                ""
                (diagSecMsg d i)
              )
            )
          )
          (vecPush parts "\"}")
          (set i (+ i 1))
        })
      (vecPush parts "]")
      (catStrs parts)
    }
  )
)

(pub :: renderDiagJson (-> Int String String (Vec Int) Int (Vec Int) String))

(pub fn (renderDiagJson d src file units ix ixs)
  (let (
    (sev (diagSev d))
    (code (diagCode d))
    (slug (diagSlug d))
    (span (diagSpan d))
    (msg (diagMsg d))
    (label (if (==
      (cast Int (diagLabel d))      0
    )
      ""
      (diagLabel d)
    ))
  )
    (strConcat
      (strConcat
        (strConcat
          (strConcat
            (strConcat (strConcat (strConcat (strConcat (strConcat "{\"severity\":\"" (sevWord sev)) "\",") (strConcat (strConcat (strConcat (strConcat "\"code\":\"" code) "\",\"slug\":\"") slug) "\",")) (strConcat (strConcat "\"message\":\"" (jsonEsc msg)) "\",")) (strConcat (strConcat "\"file\":\"" (jsonEsc file)) "\","))            (if (== span 0)
              ""
              (strConcat (strConcat (strConcat (strConcat "\"span\":" (jsonSpan src ix span)) ",\"label\":\"") (jsonEsc label)) "\",")
            )
          )          (strConcat (strConcat "\"related\":" (jsonRelatedArray d src ix units ixs)) ",")
        )        (strConcat (strConcat "\"notes\":" (jsonNoteArray d)) ",")
      )      (strConcat (strConcat (strConcat (strConcat "\"help\":" (jsonHelpArray d)) ",\"expansion\":") (jsonTraceArray d units ixs)) "}")
    )
  )
)

(pub :: renderDiagsJsonUnits (-> (Vec Int) (Vec Int) String))

(pub fn (renderDiagsJsonUnits ds units)
  ; One index per unit for the whole report, as the other two
  ; surfaces build.
  (let (
    (blocks vecNew)
    (ixs (unitIndexes units))
    (mut i 0)
  )
    {
      (while (< i (vecLen ds))
        (let ((d (vecGet ds i)))
          (let ((u 
            (vecGet
              units              (if (< (diagUnit d) (vecLen units))
                (diagUnit d)
                0
              )
            )
          ))
            {
              (vecPush blocks (renderDiagJson
                d                (memGetWordStr u 1)                (memGetWordStr u 0)                units                (indexForUnit ixs (diagUnit d))                ixs
              ))
              (vecPush blocks "\n")
              (set i (+ i 1))
            }
          )
        ))
      (catStrs blocks)
    }
  )
)

; ------------------------------------------------------------------
; The dispatch every diagnostic-printing call site goes through.
; ------------------------------------------------------------------
(pub :: renderDiagsFormat (-> Int (Vec Int) (Vec Int) String))

(pub fn (renderDiagsFormat fmt ds units)
  (if (== fmt FMT_AI)
    (renderDiagsUnits ds units)
    (if (== fmt FMT_JSON)
      (renderDiagsJsonUnits ds units)
      (renderDiagsHumanUnits ds units)
    )
  )
)
