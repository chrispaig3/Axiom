;; Self-hosted type checker stub for Axiom.
;; The type checker validates that expressions have
;; consistent types.

(import core)
(import parser)

(:: axiom_check (-> String Bool))
(fn (axiom_check ast)
  true)

;; The type checker demonstrates a key self-hosting principle:
;; type safety as symbolic reasoning. The checker verifies
;; that every expression's type is consistent with its
;; usage — a transformation on the AST that Axiom can
;; express natively through pattern matching and recursion.
