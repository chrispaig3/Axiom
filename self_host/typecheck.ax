; typecheck.ax — semantic analysis in Axiom.
;
; This is type checking proper: the checker infers a type for every
; expression and compares them exactly where stage0 compares them,
; because Phase 3's acceptance criterion is byte-identical AXDL
; against stage0 (docs/self-hosting.md), and the sweep in
; scripts/check-diagnostics.sh requires total silence on the
; compiler's own source. Both constraints bind at once, so every rule
; here is either a probed/read stage0 behavior reproduced exactly, or
; a recorded gap in the UNDER-reporting direction - a checker that
; rejects a valid program is worse than no checker.
;
; The stage0 model, replicated:
;
;   * Types are structural nodes (TAG_T_* in parser.ax). There is no
;     unification and no substitution anywhere: `tyCompat` treats a
;     type VARIABLE on either side, at any depth, as matching
;     anything, `String` and `Int` are mutually compatible by fiat
;     (a Str handle is a machine word; without this rule every string
;     in a Vec would be a type error), and the poison type TAG_T_ERR
;     matches everything so one root cause never cascades.
;
;   * Function types come from signatures, authoritatively. A `fn`
;     with no signature gets a placeholder `_fn_N` type variable and
;     every parameter typed `Int` - Int, not a wildcard (probed:
;     stage0 2185). Parameters BEYOND a signature's arrows bind at
;     fresh `_tN` wildcards. The fresh-name counter's increment sites
;     are copied from stage0 exactly, because `_tN` names render
;     inside AX3004 messages.
;
;   * Two flavors of type variable. A RENDERED one (`_tN`, `_fn_N`, a
;     source tyvar) follows stage0 everywhere, including the
;     "expected function type, found _t0" arm. A SILENT one (name "")
;     marks what stage1 cannot know - effect operations, macro heads,
;     unparseable types - and is never rendered and never the subject
;     of a diagnostic: applying it is quiet, reading a field off it
;     is quiet. Under-report, never mis-report.
;
;   * Emission anchors: expression positions anchor through spanOf,
;     which mirrors stage0's Expr::span() (an application's span is
;     its head's, a field access's its BASE's, a let's its body's). A
;     node stage1 kept no span for suppresses the diagnostic rather
;     than mis-pointing it; suppression only ever omits lines, never
;     reorders the ones stage0 also emits.
;
; Pass order (probed, pinned by goldens 040/130): every AX3006, then
; every AX3015, then the body walk in declaration order, with
; signature scope entries pushed AS ENCOUNTERED - a `set` in
; an earlier body does not see a later signature (probed: AX3001, not
; AX3012).
;
; Dependencies: core.ax, parser.ax, diag.ax, Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Vec)
(import parser)
(import diag)

; ------------------------------------------------------------------
; Type rendering: stage0's `Display for TypeId`, byte for byte, since
; these strings appear verbatim inside AX3004 messages and the gate
; compares whole lines. The shapes, pinned by `axiom symbols` probes
; and tests/selfhost/720-type-render.ax:
;
;   {unknown}                        poison (and an absent type)
;   a, _t3                           type variable, its name alone
;   Int / Maybe Int                  constructor; args space-separated,
;                                    NO parens - nested applications
;                                    flatten (`Option List Int`)
;   (Int -> (Int -> Bool))           arrow, always parenthesised, binary
;   () / (Int, Bool)                 tuple; empty tuple is unit
;   [Int]                            list
;   *Any / *mut Any                  pointer
; ------------------------------------------------------------------
(pub :: tyRender (-> Int Int))
(pub fn (tyRender t)
  (if (== t 0)
      "{unknown}"
      (let ((tag (nodeTag t)))
        (if (== tag TAG_T_VAR)
            (nodeA t)
        (if (== tag TAG_T_CON)
            (tyRenderApp (nodeA t) (nodeB t) 0)
        (if (== tag TAG_T_ARR)
            (strConcat (strConcat (strConcat (strConcat
              "(" (tyRender (nodeA t))) " -> ") (tyRender (nodeB t))) ")")
        (if (== tag TAG_T_TUP)
            (strConcat (strConcat "(" (tyRenderJoin (nodeA t) 0 "")) ")")
        (if (== tag TAG_T_LIST)
            (strConcat (strConcat "[" (tyRender (nodeA t))) "]")
        (if (== tag TAG_T_PTR)
            (strConcat (if (== (nodeB t) 1) "*mut " "*")
                       (tyRender (nodeA t)))
        "{unknown}")))))))))

(pub :: tyRenderApp (-> String Int Int Int))
(pub fn (tyRenderApp acc args i)
  (if (>= i (vecLen args))
      acc
      (tyRenderApp (strConcat (strConcat acc " ")
                              (tyRender (vecGet args i)))
                   args (+ i 1))))

(pub :: tyRenderJoin (-> Int Int String Int))
(pub fn (tyRenderJoin xs i acc)
  (if (>= i (vecLen xs))
      acc
      (tyRenderJoin xs (+ i 1)
        (if (== i 0)
            (tyRender (vecGet xs 0))
            (strConcat (strConcat acc ", ") (tyRender (vecGet xs i)))))))

; ------------------------------------------------------------------
; Type predicates and constructors.
; ------------------------------------------------------------------
(pub :: tyIsErr (-> Int Int))
(pub fn (tyIsErr t)
  (if (== t 0) 0 (if (== (nodeTag t) TAG_T_ERR) 1 0)))

; The silent wildcard: a nameless type variable. It marks the types
; stage1 cannot know (effect operations, macro spines, a type its
; grammar could not represent) and is never rendered - tyCompat lets
; it match anything, and the two places stage0 would still complain
; about a TVar (applying a non-function, reading a field) go quiet
; for it specifically.
(pub :: tyIsSilentWild (-> Int Int))
(pub fn (tyIsSilentWild t)
  (if (== t 0)
      1
      (if (&& (== (nodeTag t) TAG_T_VAR) (== (strLen (nodeA t)) 0)) 1 0)))

(pub :: mkSilentWild Int)
(pub fn (mkSilentWild) (mkTVar ""))

; Is this type EXACTLY `String`? Deliberately not "compatible with
; String": `tyCompat` says `String` and `Int` are interchangeable (the
; uniform-representation fiat), so asking it here would answer yes for
; every `Int` in the program and turn every integer comparison into a
; string comparison. This asks the narrow question - did the checker
; CONCLUDE `String` - which is the same question `tyIsFloatTy` asks for
; the `fadd`/`add` choice.
(pub :: tyIsStringTy (-> Int Int))
(pub fn (tyIsStringTy t)
  (if (== t 0)
      0
      (if (!= (nodeTag t) TAG_T_CON)
          0
          (if (strEq (nodeA t) "String") 1 0))))

(pub :: tyIsFloatTy (-> Int Int))
(pub fn (tyIsFloatTy t)
  (if (== t 0)
      0
      (if (!= (nodeTag t) TAG_T_CON)
          0
          (let ((n (nodeA t)))
            (if (strEq n "Float") 1
            (if (strEq n "Double") 1
            (if (strEq n "F32") 1
            (if (strEq n "F64") 1
            0))))))))

(pub :: mkIntTy Int)    (pub fn (mkIntTy)    (mkTCon "Int" vecNew))
(pub :: mkBoolTy Int)   (pub fn (mkBoolTy)   (mkTCon "Bool" vecNew))
(pub :: mkFloatTy Int)  (pub fn (mkFloatTy)  (mkTCon "Float" vecNew))
(pub :: mkCharTy Int)   (pub fn (mkCharTy)   (mkTCon "Char" vecNew))
(pub :: mkStringTy Int) (pub fn (mkStringTy) (mkTCon "String" vecNew))
(pub :: mkI64Ty Int)    (pub fn (mkI64Ty)    (mkTCon "I64" vecNew))
(pub :: mkUnitTy Int)   (pub fn (mkUnitTy)   (mkTTup vecNew))

; ------------------------------------------------------------------
; Compatibility - stage0's `compatible_with`, the whole "unifier".
; Rules in order: a type variable on EITHER side matches anything (no
; substitution exists, so `Tree a` vs `Tree Int` must pass); poison
; matches anything; `String` and `Int` are mutually compatible BY
; NAME (argument lists ignored - the uniform-representation rule);
; constructors need equal names, equal argument counts, and pairwise
; compatibility; arrows, tuples, lists pairwise; pointers also need
; EQUAL mutability. An absent type (0) matches anything - stage1's
; spelling of "I kept no type here".
; ------------------------------------------------------------------
(pub :: tyCompat (-> Int Int Int))
(pub fn (tyCompat a b)
  (if (|| (== a 0) (== b 0))
      1
      (let ((ta (nodeTag a))
            (tb (nodeTag b)))
        ; Poison BEFORE variables. The two orders differ on exactly one
        ; pair - a source type variable against `TAG_T_ERR` - and
        ; getting it wrong turns cascade suppression off for every
        ; polymorphic signature.
        (if (|| (== ta TAG_T_ERR) (== tb TAG_T_ERR))
            1
        (if (|| (== ta TAG_T_VAR) (== tb TAG_T_VAR))
            (tyVarCompat a b ta tb)
        (if (&& (== ta TAG_T_CON) (== tb TAG_T_CON))
            (if (|| (&& (strEq (nodeA a) "String") (strEq (nodeA b) "Int"))
                    (&& (strEq (nodeA a) "Int") (strEq (nodeA b) "String")))
                1
                (if (&& (strEq (nodeA a) (nodeA b))
                        (== (vecLen (nodeB a)) (vecLen (nodeB b))))
                    (tyCompatVec (nodeB a) (nodeB b) 0)
                    0))
        (if (&& (== ta TAG_T_ARR) (== tb TAG_T_ARR))
            (if (== (tyCompat (nodeA a) (nodeA b)) 1)
                (tyCompat (nodeB a) (nodeB b))
                0)
        (if (&& (== ta TAG_T_TUP) (== tb TAG_T_TUP))
            (if (== (vecLen (nodeA a)) (vecLen (nodeA b)))
                (tyCompatVec (nodeA a) (nodeA b) 0)
                0)
        (if (&& (== ta TAG_T_LIST) (== tb TAG_T_LIST))
            (tyCompat (nodeA a) (nodeA b))
        (if (&& (== ta TAG_T_PTR) (== tb TAG_T_PTR))
            (if (== (nodeB a) (nodeB b))
                (tyCompat (nodeA a) (nodeA b))
                0)
        0))))))))))

(pub :: tyCompatVec (-> Int Int Int Int))
(pub fn (tyCompatVec xs ys i)
  (if (>= i (vecLen xs))
      1
      (if (== (tyCompat (vecGet xs i) (vecGet ys i)) 1)
          (tyCompatVec xs ys (+ i 1))
          0)))

; ------------------------------------------------------------------
; Three flavours of type variable, and only one of them is rigid.
;
;   `_tN` / `_fn_N`  placeholders this checker mints - "I have no type
;                    here". They match anything, which is what makes a
;                    `fn` with no signature usable at all.
;   `""`             the silent wildcard: what stage1 cannot know -
;                    macro heads, unparseable types. Matches anything,
;                    renders nowhere.
;   `a`, `b`, ...    written by the PROGRAMMER in a signature. RIGID:
;                    inside the body it stands for ONE unknown type
;                    and supports no operation that needs a concrete
;                    one; at a reference site it is INSTANTIATED to a
;                    fresh placeholder, so a caller may still pass
;                    anything.
;
; Until 2026-08-10 all three matched anything at any depth, and the
; consequence was that writing `a` was strictly WEAKER than writing
; `Int`:
;
;   (:: bad (-> Int Int))  (fn (bad x) (+ x 1))
;   (bad (Pt 3 4))         AX3004: expected Int, found Pt        exit 1
;
;   (:: bad (-> a   Int))  (fn (bad x) (+ x 1))
;   (bad (Pt 3 4))         prints 4372529169                     exit 0
;
; The struct handle arrived in `x`, `+` added one to a pointer, and
; the program answered an address. README.md listed "polymorphic
; signatures" under **Complete** while the rule disabled checking
; rather than generalising it.
;
; The discriminator is the leading `_`, and it is disjoint by
; construction rather than by convention: `parser.ax`'s
; `lexStartsLower` admits bytes 97-122 and nothing else, so a
; source-written type variable always starts with a lowercase letter
; and can never collide with a minted one.
(pub :: tyIsSrcVar (-> Int Int))
(pub fn (tyIsSrcVar t)
  (if (!= (nodeTag t) TAG_T_VAR)
      0
      (let ((n (nodeA t)))
        (if (== (strLen n) 0)
            0
            (if (== (strByte n 0) 95) 0 1)))))

; Compatibility when at least one side is a variable. A minted
; placeholder still matches anything - that is the whole reason it
; exists. Two source variables agree when they are the SAME variable,
; which is what makes `(-> a a Bool)` say something. A source variable
; against a concrete type does not match, and that is the rule the
; body of a polymorphic function now obeys.
(pub :: tyVarCompat (-> Int Int Int Int Int))
(pub fn (tyVarCompat a b ta tb)
  (if (&& (== ta TAG_T_VAR) (== tb TAG_T_VAR))
      (if (&& (== (tyIsSrcVar a) 1) (== (tyIsSrcVar b) 1))
          (if (strEq (nodeA a) (nodeA b)) 1 0)
          1)
      (if (== ta TAG_T_VAR)
          (if (== (tyIsSrcVar a) 1) 0 1)
          (if (== (tyIsSrcVar b) 1) 0 1))))

; Does this type mention a source-written variable anywhere?
; Asked before every instantiation, and the answer is 0 for every
; declaration in this repository - 0 of 1,733 signatures in
; `self_host/` + `stdlib/` and 0 of 549 in `tests/` use one - so the
; walk is what keeps instantiation off the hot path rather than a
; flag that would have to be maintained.
(pub :: tyHasSrcVar (-> Int Int))
(pub fn (tyHasSrcVar t)
  (if (== t 0)
      0
      (let ((tg (nodeTag t)))
        (if (== tg TAG_T_VAR)
            (tyIsSrcVar t)
        (if (== tg TAG_T_CON)
            (tyHasSrcVarVec (nodeB t) 0)
        (if (== tg TAG_T_ARR)
            (if (== (tyHasSrcVar (nodeA t)) 1) 1 (tyHasSrcVar (nodeB t)))
        (if (== tg TAG_T_TUP)
            (tyHasSrcVarVec (nodeA t) 0)
        (if (|| (== tg TAG_T_LIST) (== tg TAG_T_PTR))
            (tyHasSrcVar (nodeA t))
        0))))))))

(pub :: tyHasSrcVarVec (-> Int Int Int))
(pub fn (tyHasSrcVarVec xs i)
  (if (== xs 0)
      0
      (if (>= i (vecLen xs))
          0
          (if (== (tyHasSrcVar (vecGet xs i)) 1)
              1
              (tyHasSrcVarVec xs (+ i 1))))))

; Instantiation: a fresh `_tN` for each DISTINCT source variable in
; the type, shared across every occurrence of that variable, so
; `(-> a a Bool)` instantiates to `(-> _t7 _t7 Bool)` and not to two
; unrelated placeholders. That is the one property a caller's
; arguments still have to satisfy; everything else about the call is
; as permissive as it was, which is why this change refuses no
; program the corpus contains.
;
; What it deliberately does NOT do is SOLVE those placeholders. A
; minted variable matches anything, so `(id 5)` has a wildcard type
; rather than `Int`, and a second argument that disagrees with the
; first is accepted. Under-report, never mis-report - the same trade
; this file records for effect operations before they carried their
; arrow. The result is that the DEFINITION of a polymorphic function
; is checked, which is where the wrong answer came from.
(pub :: tyInst (-> Int Int Int))
(pub fn (tyInst tc t)
  (if (== (tyHasSrcVar t) 0)
      t
      (tyInstIn tc t vecNew)))

; `env` is a flat Vec of alternating name, node.
(pub :: tyInstIn (-> Int Int Int Int))
(pub fn (tyInstIn tc t env)
  (if (== t 0)
      0
      (let ((tg (nodeTag t)))
        (if (== tg TAG_T_VAR)
            (if (== (tyIsSrcVar t) 0) t (tyInstVar tc (nodeA t) env 0))
        (if (== tg TAG_T_CON)
            (mkTCon (nodeA t) (tyInstVec tc (nodeB t) env vecNew 0))
        (if (== tg TAG_T_ARR)
            (mkTArr (tyInstIn tc (nodeA t) env) (tyInstIn tc (nodeB t) env))
        (if (== tg TAG_T_TUP)
            (mkTTup (tyInstVec tc (nodeA t) env vecNew 0))
        (if (== tg TAG_T_LIST)
            (mkNode TAG_T_LIST (tyInstIn tc (nodeA t) env) 0 0)
        (if (== tg TAG_T_PTR)
            (mkTPtr (tyInstIn tc (nodeA t) env) (nodeB t))
        t)))))))))

(pub :: tyInstVar (-> Int String Int Int Int))
(pub fn (tyInstVar tc name env i)
  (if (>= i (vecLen env))
      (let ((fresh (freshTVar tc 1)))
        { (vecPush env name) (vecPush env fresh) fresh })
      (if (strEq (vecGet env i) name)
          (vecGet env (+ i 1))
          (tyInstVar tc name env (+ i 2)))))

(pub :: tyInstVec (-> Int Int Int Int Int Int))
(pub fn (tyInstVec tc xs env acc i)
  (if (== xs 0)
      acc
      (if (>= i (vecLen xs))
          acc
          {
            (vecPush acc (tyInstIn tc (vecGet xs i) env))
            (tyInstVec tc xs env acc (+ i 1))
          })))

(pub :: arrowDepth (-> Int Int))
(pub fn (arrowDepth t)
  (if (== t 0)
      0
      (if (== (nodeTag t) TAG_T_ARR)
          (+ 1 (arrowDepth (nodeB t)))
          0)))

; ------------------------------------------------------------------
; Which namespace a declaration defines into, or 0 for a declaration
; that defines nothing. Values and types are separate namespaces in
; stage0, so `(data Foo ...)` and `(fn (Foo) ...)` do not collide.
;
; stage1's parser turns `type` and `trait` into TAG_NIL (parser.ax's
; skipUnknownDecl), so `fn` - and `define`, its documented synonym,
; which stage0 parses through the same function - is the only value
; definition that reaches here. RECORDED GAP: stage0 also counts
; `type` in the type namespace, so a duplicate `type` in the entry
; file is an AX3006 stage1 stays silent about. Under-reporting, never
; over-reporting: the direction that cannot reject a valid program.
; ------------------------------------------------------------------
(pub :: NS_NONE Int)  (pub fn (NS_NONE)  0)
(pub :: NS_VALUE Int) (pub fn (NS_VALUE) 1)
(pub :: NS_TYPE Int)  (pub fn (NS_TYPE)  2)

; A MACRO occupies the value namespace too. It defines a name that an
; expression can be headed by, and expansion consults the macro table
; before anything else, so a macro and a function of the same name are
; not two definitions that coexist - the macro simply wins and the
; function becomes unreachable. Measured before this line existed:
; `(macro (thing x) (+ x 1))` beside `(fn (thing n) (* n 2))` checked
; `OK` and answered 11 where the function says 20, with no diagnostic
; from either compiler.
(pub :: declNamespace (-> Int Int))
(pub fn (declNamespace tag)
  (if (|| (== tag TAG_D_FN) (== tag TAG_D_MACRO))
      NS_VALUE
  (if (|| (== tag TAG_D_DATA) (== tag TAG_D_STRUCT))
      NS_TYPE
      NS_NONE)))

; ------------------------------------------------------------------
; Index of the first declaration before `i` that defines the same name
; in the same namespace, or -1.
;
; The FIRST one, not the nearest: stage0 records a name's first span
; and never overwrites it, so three definitions of `main` produce two
; diagnostics that both point back at the first (verified by probe).
; ------------------------------------------------------------------
; Answered from an INDEX rather than by re-scanning. `firstDefinerFrom`
; walked `decls[0..i)` once per declaration, which is quadratic in the
; entry file's own declaration count, and `main.ax` hides it with 21
; entry declarations. Measured on N top-level declarations before the
; index: N=2000 0.04s, 4000 0.19s, 8000 0.78s - ratios 4.00, 4.75,
; 4.11 per doubling.
;
; `bs` is `dupIdxBuild`'s buckets. Entries are appended in declaration
; order, so within a bucket the indices increase, so the FIRST entry
; that matches is the smallest matching index - which is the "first,
; not nearest" rule this check has always had, unchanged. The bucket
; interleaves names that hash together and that does not disturb the
; order.
(pub :: firstDefiner (-> Int Int Int String Int))
(pub fn (firstDefiner bs i ns name)
  (let ((v (vecGet bs (% (fnIdxHash name) (vecLen bs)))))
    (if (== v 0)
        (- 0 1)
        (firstDefinerScan v i ns name 0))))

(pub :: firstDefinerScan (-> Int Int Int String Int Int))
(pub fn (firstDefinerScan v i ns name k)
  (if (>= k (vecLen v))
      (- 0 1)
      (let ((e (vecGet v k)))
        (if (&& (< (memGetWord e 2) i)
                (&& (== (memGetWord e 1) ns)
                    (strEq (memGetWord e 0) name)))
            (memGetWord e 2)
            (firstDefinerScan v i ns name (+ k 1))))))

; One entry per (name, namespace) a declaration defines, carrying the
; declaration's index. A `trait` or an `effect` contributes one per
; method or operation, which is why this is built from `declFields`
; and `declNamespace` rather than from `nodeA` alone - the index has
; to answer exactly what `declDefinesNS` answers, and that predicate
; is where the two multi-name declarations are named.
(pub struct DupRef (name : Int) (ns : Int) (idx : Int))

(pub :: dupIdxBuild (-> Int Int))
(pub fn (dupIdxBuild decls)
  (let ((nb (fnIdxBuckets (vecLen decls))) (bs vecNew) (mut i 0))
    {
      (while (< i nb) { (vecPush bs 0) (set i (+ i 1)) })
      (set i 0)
      (while (< i (vecLen decls))
        {
          (dupIdxAddDecl bs (vecGet decls i) i)
          (set i (+ i 1))
        })
      bs
    }))

(pub :: dupIdxAddDecl (-> Int Int Int Int))
(pub fn (dupIdxAddDecl bs d i)
  (let ((fs (declFields d)))
    (if (!= fs 0)
        (dupIdxAddFields bs fs i 0)
        (let ((ns (declNamespace (nodeTag d))))
          (if (== ns NS_NONE)
              0
              (dupIdxPut bs (nodeA d) ns i))))))

(pub :: dupIdxAddFields (-> Int Int Int Int Int))
(pub fn (dupIdxAddFields bs fs i k)
  (if (>= k (vecLen fs))
      0
      {
        (dupIdxPut bs (nodeA (vecGet fs k)) NS_VALUE i)
        (dupIdxAddFields bs fs i (+ k 1))
      }))

(pub :: dupIdxPut (-> Int String Int Int Int))
(pub fn (dupIdxPut bs name ns i)
  (let ((b (% (fnIdxHash name) (vecLen bs))))
    (if (== (vecGet bs b) 0)
        (let ((v vecNew))
          { (vecPush v (cast Int (DupRef name ns i))) (vecSet bs b v) 0 })
        { (vecPush (vecGet bs b) (cast Int (DupRef name ns i))) 0 })))

; The TAG_FIELD vector of a declaration that defines MORE THAN ONE
; value name, or 0 for the ordinary kind that defines just `nodeA`.
;
; Two declarations are in this class and both were invisible to the
; duplicate check. A `trait` keeps its methods in slot b; an `effect`
; keeps its operations' names in slot b and the same names with their
; TYPES in slot c, which is the vector with the spans on it.
(pub :: declFields (-> Int Int))
(pub fn (declFields d)
  (if (== (nodeTag d) TAG_D_TRAIT)
      (nodeB d)
      (if (== (nodeTag d) TAG_D_EFFECT)
          (nodeC d)
          0)))

; Does this declaration define `name` in namespace `ns`?
;
; The namespaced twin of `declDefines`, which the missing-definition
; pass uses and which is deliberately namespace-blind. Every ordinary
; declaration defines a single name and it is `nodeA`; `declFields`
; names the two that do not. Until this predicate existed, neither of
; those collided with anything: a trait method and a top-level `fn` of
; the same spelling both "existed" and the implementation won every
; call at exit 0, and a top-level `fn` named after an effect operation
; built cleanly and trapped at run time with exit 71, no stdout and no
; stderr, where `docs/reference.md:917` says it is a duplicate
; definition. `declDefines` already knew an `effect` declares its
; operations - the same fact, one pass over.
(pub :: declDefinesNS (-> Int Int String Int))
(pub fn (declDefinesNS d ns name)
  (let ((fs (declFields d)))
    (if (!= fs 0)
        (if (&& (== ns NS_VALUE) (!= (findFieldNamed fs name 0) 0)) 1 0)
        (if (&& (== (declNamespace (nodeTag d)) ns) (strEq (nodeA d) name)) 1 0))))

; The span to blame for that definition. For a trait or an effect it
; is the METHOD or OPERATION name's span, not the declaration's own:
; the label says "first defined here", and the line the reader has to
; change is the `where` entry.
(pub :: declDefSpan (-> Int String Int))
(pub fn (declDefSpan d name)
  (let ((fs (declFields d)))
    (if (== fs 0)
        (nodeSpan d)
        (let ((f (findFieldNamed fs name 0)))
          (if (== f 0) (nodeSpan d) (nodeSpan f))))))

; ------------------------------------------------------------------
; Pass 1: duplicate definitions.
;
; Only the entry file's declarations are examined. stage0 keys this
; check by (name, module) - a name defined once per module in two
; modules is legal, and that is the ambiguity check's business, not
; this one - and stage1's merged declaration list does not record which
; module each declaration came from. Checking the entry file alone is
; the sound subset: it reports exactly the duplicates stage0 reports
; for a single-file program and never invents one, which is the
; property that matters, since a checker that rejects the compiler's
; own source is worse than no checker. Duplicates *inside an imported
; module* go unreported until declarations carry their origin.
; ------------------------------------------------------------------
(pub :: checkDuplicates (-> Int Int Int Int Int))
(pub fn (checkDuplicates bs decls out i)
  (if (>= i (vecLen decls))
      out
      (let ((d (vecGet decls i)))
        {
          (let ((fs (declFields d)))
            (if (!= fs 0)
                ; A trait defines one value name per method and an
                ; effect one per operation, so these are the two
                ; declarations that need a loop here.
                (checkFieldDupes bs decls out i fs 0)
                (let ((ns (declNamespace (nodeTag d))))
                  (if (== ns NS_NONE)
                      0
                      (let ((name (nodeA d)))
                        (let ((j (firstDefiner bs i ns name)))
                          (if (< j 0)
                              0
                              (dupDiag decls out j name (nodeSpan d)))))))))
          (checkDuplicates bs decls out (+ i 1))
        })))

(pub :: checkFieldDupes (-> Int Int Int Int Int Int Int))
(pub fn (checkFieldDupes bs decls out i fields k)
  (if (>= k (vecLen fields))
      0
      (let ((m (vecGet fields k)))
        {
          (let ((j (firstDefiner bs i NS_VALUE (nodeA m))))
            (if (< j 0)
                0
                (dupDiag decls out j (nodeA m) (nodeSpan m))))
          (checkFieldDupes bs decls out i fields (+ k 1))
        })))

(pub :: dupDiag (-> Int Int Int String Int Int))
(pub fn (dupDiag decls out j name sp)
  {
    (vecPush out
      (diagSetLabel (mkDiag SEV_ERROR "AX3006" "duplicate-definition"
              sp
              (strConcat (strConcat "duplicate definition `" name) "`")
              (declDefSpan (vecGet decls j) name)
              (strConcat (strConcat "`" name) "` first defined here")
              "rename one of the definitions, or remove the duplicate")
        (strConcat (strConcat "`" name) "` redefined here")))
    0
  })

; ------------------------------------------------------------------
; Pass 2: a signature with no definition behind it.
;
; The signatures examined are the entry file's; the definitions that
; satisfy them come from ANY module, exactly as stage0 does it - an
; entry-file signature over an imported definition is the same
; signature-then-definition pattern with the definition arriving
; through an import.
; ------------------------------------------------------------------
; Does `full` name the definition an entry-file signature for `bare`
; is looking for?
;
; Not string equality, because by the time the checker runs, import
; resolution has rewritten every *imported* declaration's name in place
; to `Mod$name` (codegen.ax's `mangleDecl`). Entry-file declarations
; keep their bare name. A signature in the entry file for a function
; that arrives through an import - which stage0 accepts, counting
; definitions from any module - therefore never matched, and every such
; program drew a false AX3015.
(pub :: nameMatches (-> String String Int))
(pub fn (nameMatches full bare)
  (if (strEq full bare)
      1
      (let ((m (strLen full))
            (n (strLen bare)))
        (if (<= m (+ n 1))
            0
            (if (&& (== (strByte full (- (- m n) 1)) 36)
                    (strEq (strSlice full (- m n) n) bare))
                1
                0)))))

; A definition that is not exported does not answer an ENTRY-FILE
; signature: the entry file cannot name it, so a `(:: f T)` with only
; a private `M$f` behind it is still AX3015, and saying so here is
; what keeps it from becoming an undefined symbol at link time.
(pub :: isDefined (-> Int String Int))
(pub fn (isDefined bs name)
  (let ((v (vecGet bs (% (fnIdxHash name) (vecLen bs)))))
    (if (== v 0)
        0
        (defIdxHas v name 0))))

(pub :: defIdxHas (-> Int String Int Int))
(pub fn (defIdxHas v name k)
  (if (>= k (vecLen v))
      0
      (if (strEq (vecGet v k) name)
          1
          (defIdxHas v name (+ k 1)))))

; The set of names an exported definition answers to, which is what
; `isDefined` used to compute by scanning the WHOLE program per
; signature - `main.ax` pays that 21 times against a 1,326-function
; closure, and a generated entry file pays it per declaration.
;
; The keys are exactly the strings `nameMatches full k` accepts, and
; that equivalence is the whole correctness argument: `full` itself,
; and the suffix after every `$` at a position past the first byte.
; The position matters - `nameMatches` demands `m > n + 1`, so a name
; that merely BEGINS with `$` matches nothing, and inserting that
; suffix would invent a definition. `Mod$f` answers to `Mod$f` and to
; `f`; `$f` answers only to itself.
(pub :: defIdxBuild (-> Int Int))
(pub fn (defIdxBuild allDecls)
  (let ((nb (fnIdxBuckets (vecLen allDecls))) (bs vecNew) (mut i 0))
    {
      (while (< i nb) { (vecPush bs 0) (set i (+ i 1)) })
      (set i 0)
      (while (< i (vecLen allDecls))
        {
          (let ((d (vecGet allDecls i)))
            ; A definition that is not exported does not answer an
            ; entry-file signature, so it is not in the index at all -
            ; the `nodeVis` test the linear scan made, made once.
            (if (&& (== (nodeTag d) TAG_D_FN) (== (nodeVis d) 1))
                (defIdxAddKeys bs (nodeA d))
                0))
          (set i (+ i 1))
        })
      bs
    }))

(pub :: defIdxAddKeys (-> Int String Int))
(pub fn (defIdxAddKeys bs full)
  {
    (defIdxPut bs full)
    (defIdxAddSuffixes bs full 1)
  })

(pub :: defIdxAddSuffixes (-> Int String Int Int))
(pub fn (defIdxAddSuffixes bs full i)
  (if (>= i (strLen full))
      0
      {
        (if (== (strByte full i) 36)
            (defIdxPut bs (strSlice full (+ i 1) (- (strLen full) (+ i 1))))
            0)
        (defIdxAddSuffixes bs full (+ i 1))
      }))

(pub :: defIdxPut (-> Int String Int))
(pub fn (defIdxPut bs name)
  (let ((b (% (fnIdxHash name) (vecLen bs))))
    (if (== (vecGet bs b) 0)
        (let ((v vecNew)) { (vecPush v name) (vecSet bs b v) 0 })
        { (vecPush (vecGet bs b) name) 0 })))

; ------------------------------------------------------------------
; `(import M (a b))` naming something `M` does not export.
;
; The list was never read after `resolveDeclsPhase` used it to decide
; visibility, so `(import M (noSuch))` was accepted in silence and the
; mistake surfaced as an AX3001 wherever the name was used - or as
; nothing at all if it never was, which is the case for a typo in a
; list of otherwise-good names.
;
; Only the ENTRY file's imports. A nested module's import list is its
; author's business and its declarations are not in `entryDecls` to
; walk; the entry file's is where a reader's typo lives.
; ------------------------------------------------------------------
(pub :: checkImportNames (-> Int Int Int Int Int))
(pub fn (checkImportNames entryDecls allDecls out i)
  (if (>= i (vecLen entryDecls))
      0
      (let ((d (vecGet entryDecls i)))
        {
          (if (== (nodeTag d) TAG_D_IMPORT)
              (let ((names (nodeB d)))
                (if (== names 0)
                    0
                    (checkImportNameList (nodeA d) names (nodeSpan d) allDecls out 0)))
              0)
          (checkImportNames entryDecls allDecls out (+ i 1))
        })))

(pub :: checkImportNameList (-> String Int Int Int Int Int Int))
(pub fn (checkImportNameList modName names sp allDecls out i)
  (if (>= i (vecLen names))
      0
      {
        (let ((n (vecGet names i)))
          (if (== (declaredInModule allDecls modName n 0) 1)
              (if (== (exportedFromModule allDecls modName n 0) 1)
                  0
                  (importDiag out sp
                    (strConcat (strConcat (strConcat (strConcat
                      "module `" modName) "` declares `") n)
                      "` but does not export it")
                    "write `pub` on its declaration"))
              (importDiag out sp
                (strConcat (strConcat (strConcat (strConcat
                  "module `" modName) "` declares no `") n) "`")
                "check the spelling, or import the module without a name list")))
        (checkImportNameList modName names sp allDecls out (+ i 1))
      }))

(pub :: importDiag (-> Int Int Int Int Int))
(pub fn (importDiag out sp msg help)
  {
    (vecPush out
      (diagSetLabel
        (mkDiagNote SEV_ERROR "AX3023" "private-name" sp msg 0 0 help
                    "an import\'s name list is checked against what the module exports")
        "not exported"))
    0
  })

(pub :: declaredInModule (-> Int String String Int Int))
(pub fn (declaredInModule allDecls modName n i)
  (if (>= i (vecLen allDecls))
      0
      (let ((d (vecGet allDecls i)))
        (if (&& (!= (nodeModule d) 0)
                (&& (strEq (nodeModule d) modName)
                    (strEq (bareOf (nodeA d)) n)))
            1
            (declaredInModule allDecls modName n (+ i 1))))))

(pub :: exportedFromModule (-> Int String String Int Int))
(pub fn (exportedFromModule allDecls modName n i)
  (if (>= i (vecLen allDecls))
      0
      (let ((d (vecGet allDecls i)))
        (if (&& (== (nodeVis d) 1)
                (&& (!= (nodeModule d) 0)
                    (&& (strEq (nodeModule d) modName)
                        (strEq (bareOf (nodeA d)) n))))
            1
            (exportedFromModule allDecls modName n (+ i 1))))))

(pub :: checkMissingDefs (-> Int Int Int Int Int))
(pub fn (checkMissingDefs bs entryDecls out i)
  (if (>= i (vecLen entryDecls))
      out
      (let ((d (vecGet entryDecls i)))
        (if (!= (nodeTag d) TAG_D_SIG)
            (checkMissingDefs bs entryDecls out (+ i 1))
            (let ((name (nodeA d)))
              (if (== (isDefined bs name) 1)
                  (checkMissingDefs bs entryDecls out (+ i 1))
                  {
                    (vecPush out
                      (diagSetLabel (mkDiag SEV_ERROR "AX3015" "missing-definition"
                              (nodeSpan d)
                              (strConcat (strConcat "`" name)
                                         "` has a signature but no definition")
                              0 0
                              "add the definition, or if it lives in another module, mark that definition `pub` so the import carries it")
                        (strConcat (strConcat "no `fn` defines `" name) "`")))
                    (checkMissingDefs bs entryDecls out (+ i 1))
                  }))))))

; ------------------------------------------------------------------
; The checker's tables. Axiom has no globals, so one TC handle rides
; through the whole walk.
;
;   fns      Vec of FnEnt, in registration order - which is also the
;            suggestion pool's visit order, so it is semantic:
;            operators, then primitives, then declarations as they
;            appear in the resolved module list.
;   datas    Vec of DataEnt; the builtin Option is FIRST, which is
;            what puts `Some`/`None` ahead of every user constructor
;            in suggestion and resolution order.
;   structs  Vec of StructEnt.
;   scope    one Vec: module-level entries (signatures, pushed as the
;            declaration walk reaches them - order matters, probed)
;            below frameBase, the current function's frame above it.
;            Value resolution reads the FRAME only;
;            `set` target resolution reads the whole vec - stage0's
;            asymmetry, kept deliberately.
;   counter  the fresh-type-variable counter. Its increment sites are
;            copied from stage0 exactly, because `_tN` names render.
; ------------------------------------------------------------------
; `effects` is a Vec of TAGGED effect strings: "b:IO" for a built-in,
; "c:Console" for a custom one. The tag is not decoration - stage0's
; `Effect::IO` and `Effect::Custom("IO")` are different values, so an
; `(effect IO ...)` declaration's operations do NOT become handled by
; a handle list naming the built-in `IO`. Storing the display name
; alone would silently merge them.
; `eparams` is the list of parameter indices this function is
; EFFECT-TRANSPARENT in: it performs whatever a value passed there
; performs. `apply` is `{effects: [], eparams: [0]}` - exactly as pure
; as its argument.
(pub struct FnEnt (name : Int) (ty : Int) (paramCount : Int)
                  (isBuiltin : Int) (isEffectOp : Int)
                  (effects : Int) (eparams : Int))
; `fieldNames` is the constructor's declared field names when it was
; written as a struct variant, and 0 otherwise. A NAMED pattern is
; reordered against it.
(pub struct CtorEnt (name : Int) (fieldTys : Int) (resTy : Int) (ctorTy : Int) (fieldNames : Int))
; `module` is the module that DECLARED this type, or 0 for the entry
; file and for builtins. It exists so a QUALIFIED reference can be
; checked rather than merely stripped: `mangleDecl` rewrites `fn` and
; `::` declarations to `Mod$name`, so `Mod::f` resolves by matching a
; rewritten declaration - but it does not rewrite `data` or `struct`,
; so `Mod::Ctor` matched nothing and every qualified constructor
; reference was a false AX3001 on a valid program. Recording the
; module here answers it without renaming anything: see `ctorMatches`.
; A trait, as the dispatcher needs it: the name it is keyed on, the
; single type parameter its methods are written against, and its
; method signatures. Supertraits and default bodies are still parsed
; and dropped - see docs/self-hosting.md 22 for what this slice covers.
(pub struct TraitEnt (name : Int) (tyvar : Int) (methods : Int))

(pub struct DataEnt (name : Int) (ctors : Int) (module : Int))
(pub struct StructEnt (name : Int) (fields : Int) (module : Int))
(pub struct TC (fns : Int) (datas : Int) (structs : Int) (scope : Int)
               (out : Int) (counter : Int) (frameBase : Int)
               (macros : Int) (effects : Int)
               (entryDecls : Int) (allDecls : Int)
               (curParams : Int) (curCallable : Int)
               (units : Int) (curUnit : Int) (ambTbl : Int)
               ; The module whose body is being checked, or 0 for the
               ; entry file. A bare reference inside it resolves to
               ; that module's own definition first - the same rule
               ; codegen's `mangledFor` and stage0's
               ; `resolve_bare_fn` apply, and all three have to agree
               ; or the checker types against one definition while
               ; the emitter calls another.
               (curModule : Int)
               ; `type` and `trait` declaration nodes, in collection
               ; order. Nothing in checking or emission reads them -
               ; they exist for `symbols`, whose A and T rows walk
               ; them the way stage0 walks tc.aliases/tc.traits.
               (aliases : Int) (traits : Int)
               ; The mangled `Mod$name` of every declaration carried
               ; into the program that its own module does not export.
               ; Empty for every program in this repository. See the
               ; visibility section for why it lives here and not on
               ; the entries.
               (privates : Int)
               ; The exact-name index over `fns`, or 0 before it is
               ; built. Appended, like every field before it: every
               ; reader indexes this record by position, which is how
               ; the unit table broke the last time it grew in the
               ; middle. See the exact-name index section.
               (fnIdx : Int)
               ; The same thing for the ambiguity table, and appended
               ; for the same reason. `ambFind` was a linear scan of a
               ; Vec that grows with the PROGRAM, and `ambRecord` calls
               ; it once per name it records, so building the table was
               ; quadratic on its own - 935 of ~1200 profile samples on
               ; a 32,000-declaration entry file, after the two entry
               ; passes were indexed and while nothing else was close.
               ; The name-index slice fixed `tcFns` and left this one.
               (ambIdx : Int))

(pub :: tcFns (-> Int Int))     (pub fn (tcFns tc)     (memGetWord tc 0))
(pub :: tcDatas (-> Int Int))   (pub fn (tcDatas tc)   (memGetWord tc 1))
(pub :: tcStructs (-> Int Int)) (pub fn (tcStructs tc) (memGetWord tc 2))
(pub :: tcScope (-> Int Int))   (pub fn (tcScope tc)   (memGetWord tc 3))
(pub :: tcOut (-> Int Int))     (pub fn (tcOut tc)     (memGetWord tc 4))
(pub :: tcCounter (-> Int Int)) (pub fn (tcCounter tc) (memGetWord tc 5))
(pub :: tcBumpCounter (-> Int Int))
(pub fn (tcBumpCounter tc) (memSetWord tc 5 (+ (memGetWord tc 5) 1)))
(pub :: tcFrameBase (-> Int Int)) (pub fn (tcFrameBase tc) (memGetWord tc 6))
(pub :: tcMacros (-> Int Int))  (pub fn (tcMacros tc)  (memGetWord tc 7))
(pub :: tcEffects (-> Int Int)) (pub fn (tcEffects tc) (memGetWord tc 8))
(pub :: tcAliases (-> Int Int)) (pub fn (tcAliases tc) (memGetWord tc 17))
(pub :: tcTraits (-> Int Int))  (pub fn (tcTraits tc)  (memGetWord tc 18))

; A fresh `_tN`. stage0 mints the name from the current counter and
; increments at SOME sites but not others; callers say which.
(pub :: freshTVar (-> Int Int Int))
(pub fn (freshTVar tc bump)
  (let ((t (mkTVar (strConcat "_t" (decStr (tcCounter tc))))))
    {
      (if (== bump 1) (tcBumpCounter tc) 0)
      t
    }))

; Int -> Int -> ... -> Int with `arity` arrows; arity 0 is bare Int.
(pub :: mkIntArrow (-> Int Int))
(pub fn (mkIntArrow arity)
  (if (== arity 0)
      mkIntTy
      (mkTArr mkIntTy (mkIntArrow (- arity 1)))))

(pub :: regFn (-> Int Int Int Int))
(pub fn (regFn fns name ty)
  (vecPush fns (cast Int (FnEnt name ty (- 0 1) 1 0 vecNew vecNew))))

; ------------------------------------------------------------------
; Registration: stage0's TypeChecker::new(), in its order - the order
; is observable through suggestion tie-breaking. Arithmetic and
; bitwise operators are Int -> Int -> Int, comparisons return Bool,
; the logical pair takes Bool; then every primitive at its arity;
; then the builtin Option, whose constructors are in scope in every
; program without being declared in any of them.
; ------------------------------------------------------------------
; Every carried-but-not-exported declaration, keyed the way the
; lookups ask: `Mod$name`. `fn` and `::` already carry that spelling
; because `mangleDecl` rewrote them; `data` and `struct` do not, so
; theirs is built from the module recorded on the node.
;
; Collected once, before anything is looked up, and empty unless the
; program actually declares something private.
(pub :: collectPrivates (-> Int Int Int Int))
(pub fn (collectPrivates decls out i)
  (if (>= i (vecLen decls))
      (if (== (vecLen out) 0) 0 out)
      (let ((d (vecGet decls i)))
        {
          (if (&& (== (nodeVis d) 0) (!= (nodeModule d) 0))
              (let ((k (if (|| (== (nodeTag d) TAG_D_FN)
                               (== (nodeTag d) TAG_D_SIG))
                           (nodeA d)
                           (privKey (nodeModule d) (nodeA d)))))
                (if (== (strInVec out k 0) 1) 0 (vecPush out k)))
              0)
          (collectPrivates decls out (+ i 1))
        })))

(pub :: tcNew (-> Int Int Int Int))
(pub fn (tcNew entryDecls allDecls units)
  (let ((fns vecNew)
        (datas vecNew))
    {
      (regFn fns "+" (mkIntArrow 2))
      (regFn fns "-" (mkIntArrow 2))
      (regFn fns "*" (mkIntArrow 2))
      (regFn fns "/" (mkIntArrow 2))
      (regFn fns "%" (mkIntArrow 2))
      (regFn fns "&" (mkIntArrow 2))
      (regFn fns "|" (mkIntArrow 2))
      (regFn fns "^" (mkIntArrow 2))
      (regFn fns "<<" (mkIntArrow 2))
      (regFn fns ">>" (mkIntArrow 2))
      (regFn fns "==" (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy)))
      (regFn fns "!=" (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy)))
      (regFn fns "<" (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy)))
      (regFn fns ">" (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy)))
      (regFn fns "<=" (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy)))
      (regFn fns ">=" (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy)))
      (regFn fns "&&" (mkTArr mkBoolTy (mkTArr mkBoolTy mkBoolTy)))
      (regFn fns "||" (mkTArr mkBoolTy (mkTArr mkBoolTy mkBoolTy)))
      (regFn fns "__syscall0" (mkIntArrow 1))
      (regFn fns "__syscall1" (mkIntArrow 2))
      (regFn fns "__syscall2" (mkIntArrow 3))
      (regFn fns "__syscall3" (mkIntArrow 4))
      (regFn fns "__syscall4" (mkIntArrow 5))
      (regFn fns "__syscall5" (mkIntArrow 6))
      (regFn fns "__syscall6" (mkIntArrow 7))
      (regFn fns "__load8" (mkIntArrow 2))
      (regFn fns "__store8" (mkIntArrow 3))
      (regFn fns "__load64" (mkIntArrow 2))
      (regFn fns "__store64" (mkIntArrow 3))
      (regFn fns "__alloc" (mkIntArrow 1))
      (regFn fns "__argc" (mkIntArrow 0))
      (regFn fns "__argv" (mkIntArrow 1))
      (regFn fns "__axiom_arena_mark" (mkIntArrow 0))
      (regFn fns "__axiom_arena_reset" (mkIntArrow 1))
      (regFn fns "__axiom_arena_reset_keeping" (mkIntArrow 3))
      (regFn fns "__addr" (mkTArr mkStringTy mkIntTy))
      ; Not spellable in source - `checkNumeric` rewrites `==`/`!=`
      ; into these. They are registered anyway because the rewritten
      ; node outlives the check: `axiom symbols`, the language server
      ; and any second pass over the same tree meet it, and an
      ; unregistered head is AX3001 on a program that compiles.
      (regFn fns "__streq"
        (mkTArr mkStringTy (mkTArr mkStringTy mkBoolTy)))
      (regFn fns "__strne"
        (mkTArr mkStringTy (mkTArr mkStringTy mkBoolTy)))
      (regFn fns "__intToFloat" (mkTArr mkIntTy mkFloatTy))
      (regFn fns "__floatToInt" (mkTArr mkFloatTy mkIntTy))
      (let ((optRes (mkTCon "Option"
                      (let ((v vecNew)) { (vecPush v (mkTVar "a")) v })))
            (optCtors vecNew))
        {
          (vecPush optCtors
            (cast Int (CtorEnt "Some"
                        (let ((v vecNew)) { (vecPush v (mkTVar "a")) v })
                        optRes
                        (mkTArr (mkTVar "a") optRes)
                        0)))
          (vecPush optCtors (cast Int (CtorEnt "None" vecNew optRes optRes 0)))
          (vecPush datas (cast Int (DataEnt "Option" optCtors 0)))
        })
      (let ((tc (cast Int (TC fns datas vecNew vecNew vecNew 0 0
                              vecNew vecNew entryDecls allDecls
                              vecNew vecNew units 0 vecNew 0
                              vecNew vecNew (collectPrivates allDecls vecNew 0)
                              0 0))))
        {
          ; The exact-name index, before collection rather than after:
          ; collection itself looks a name up per declaration.
          (memSetWord tc 20
            (fnIdxBuildSized (tcFns tc) (vecLen allDecls)))
          (memSetWord tc 21 (ambIdxNew (vecLen allDecls)))
          (tcCollect tc allDecls 0)
          ; Type constructors named in signatures, once collection has
          ; seen every `data`/`struct`/`type` - a signature may name a
          ; type declared later in the file or in another module.
          (tcCheckSigTypes tc allDecls 0)
          ; The ambiguity table, once: builtins are module-less
          ; winners and have no declaration to walk, so they are
          ; seeded rather than collected.
          (ambRecord tc "None" 0)
          (ambRecord tc "Some" 0)
          (ambBuild tc allDecls 0)
          ; Effects are inferred once, after every declaration is
          ; registered and before any body is checked, because an
          ; AX3011 at a handle asks what the body performs and the
          ; answer may come from a function declared later.
          (inferEffects tc allDecls)
          tc
        })
    }))

; ------------------------------------------------------------------
; Collection: one pass over the RESOLVED declaration list, in order,
; mirroring stage0's collect_declarations. Keying is exact-name -
; imported names arrive pre-mangled to `Mod$name`, which is stage0's
; (name, module) key spelled as one string. A later signature for the
; same name overwrites (stage0 1905).
; ------------------------------------------------------------------
(pub :: tcCollect (-> Int Int Int Int))
(pub fn (tcCollect tc decls i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (let ((tag (nodeTag d)))
          {
            (if (== tag TAG_D_DATA)
                (tcCollectData tc d)
            (if (== tag TAG_D_STRUCT)
                (vecPush (tcStructs tc)
                         (cast Int (StructEnt (nodeA d) (nodeB d) (nodeModule d))))
            (if (== tag TAG_D_SIG)
                (tcCollectSig tc d)
            (if (== tag TAG_D_FN)
                (tcCollectFn tc d)
            (if (== tag TAG_D_EFFECT)
                {
                  ; The whole declaration node, not just its name:
                  ; AX3017 reports how many operations an effect
                  ; declares, and that count is `(vecLen (nodeB d))`.
                  (vecPush (tcEffects tc) d)
                  ; Slot c, not slot b: the TYPES the parser kept
                  ; beside the names, so an operation is a callable
                  ; with a real arrow and a real arity. It used to
                  ; take slot b - the bare names - and register a
                  ; silent wildcard at arity -1, which made
                  ; `(two 3 4 5)` check clean and SIGSEGV and
                  ; `(two 3)` check clean and answer a heap address.
                  (tcCollectEffectOps tc (nodeC d) 0 (nodeA d) (nodeModule d))
                }
            (if (== tag TAG_D_MACRO)
                ; The NODE, not the name: a macro its module does not
                ; export is not a macro name HERE, and deciding that
                ; needs its module and its visibility flag. Storing
                ; only the string made a private macro's invocation
                ; type-check as a macro (silent wildcard), reach
                ; codegen as a call to a symbol nothing defines, and
                ; fail in `opt` at exit 4 - the link failure this
                ; repository twice records as the wrong trade.
                (vecPush (tcMacros tc) d)
            (if (== tag TAG_D_ALIAS)
                (vecPush (tcAliases tc) d)
            (if (== tag TAG_D_TRAIT)
                (vecPush (tcTraits tc) d)
            0))))))))
            (tcCollect tc decls (+ i 1))
          }))))

; Every operation of `(effect E ...)` carries `Custom(E)` as its
; INHERENT effect - stage0 attaches it at registration so the
; collector needs no special case for operations at all.
; An operation of an IMPORTED effect is registered twice: under its
; bare name and under `Mod$op`. stage1 resolves a qualified reference
; by mangling it into a flat name, which works for every other kind of
; declaration because `mangleDecl` rewrote the declaration to match -
; and an `effect` declaration is one of the two it does not rewrite.
; So `(EffMod::ask 21)`, a program stage0 compiles and runs, drew a
; false `AX3001 undefined variable EffMod$ask`. Registering the
; mangled spelling costs one entry and no rule: every lookup that goes
; by name now finds the operation under either spelling, with the same
; silent-wildcard type and the same inherent `Custom(E)`.

; ------------------------------------------------------------------
; Traits: lowering, and dispatch.
;
; An `impl` becomes ordinary declarations. `(impl (Eq Int) where ((eq
; <expr>)))` appends a signature and a definition named `Eq#Int#eq`,
; and a call to `eq` whose dispatch argument is an `Int` is rewritten
; to name it. The separator is `#` rather than `$` deliberately:
; `bareOf`/`nameMatches` treat `$` as the module boundary, so
; `Eq$Int$eq` would suffix-match a BARE `eq` and whichever impl came
; first would silently win every unqualified call.
;
; The definition is eta-expanded - `(fn (Eq#Int#eq a b) ((<expr> a) b))`
; - rather than having the lambda spliced in, because the implementing
; expression need not be a lambda at all: `(eq myNamedFunction)` is as
; legitimate as `(eq (lambda (x y) ...))`, and applying it is the one
; thing both shapes support.
; ------------------------------------------------------------------
; The parameters are not called `trait`: the parser accepts a keyword
; as a binder and `format.ax`'s scanner refuses the file outright, with
; no line and no reason - found by `check-fmt.sh`, which is the only
; thing that compares those two readings of a name.
; ------------------------------------------------------------------
; The lowering pass. Runs after expansion and before checking, over the
; merged declaration list, appending to it: the generated declarations
; are then collected and checked exactly like hand-written ones, which
; is the point - an impl body was previously never checked at all.
; ------------------------------------------------------------------
; `fields` is the effect declaration's `opFields` - TAG_FIELD nodes
; carrying the operation's NAME and its DECLARED TYPE. The parser has
; kept both since effects landed, and `symbols` walks exactly this
; vector to print an operation's real arrow; this collector took the
; parallel name-only vector and registered a silent wildcard with
; arity -1 instead. One site discarding a type the parser already
; kept, which is the same sentence `docs/self-hosting.md` 29 writes
; about `parseSigDecl`.
(pub :: tcCollectEffectOps (-> Int Int Int Int String Int))
(pub fn (tcCollectEffectOps tc fields i effName modName)
  (if (== fields 0)
      0
      (if (>= i (vecLen fields))
          0
          (let ((f (vecGet fields i)))
            {
              (tcAddEffectOp tc (nodeA f) (nodeB f) effName)
              (if (== modName 0)
                  0
                  ; `strConcat` twice rather than `cat3`, which lives in
                  ; codegen.ax and is not imported here - stage0's flat
                  ; namespace resolves it across the merged declaration list
                  ; and stage1 refuses it, which is the open B4 item and the
                  ; stricter of the two answers.
                  (tcAddEffectOp tc (strConcat (strConcat modName "$")
                                               (nodeA f))
                                 (nodeB f) effName))
              (tcCollectEffectOps tc fields (+ i 1) effName modName)
            }))))

; An operation's arity is its declared arrow's depth. `->` right-folds,
; so `(-> Int Int Int)` IS `(-> Int (-> Int Int))` and the depth is the
; only reading available - but for an OPERATION it is also the right
; one, because the lowering applies the handler to the operation's
; arguments and there is no partial application to preserve.
;
; A type the parser could not read leaves 0 in the field, and that
; keeps the old under-report: silent wildcard, arity -1, calls check
; quietly. Under-report, never mis-report.
(pub :: tcAddEffectOp (-> Int Int Int Int Int))
(pub fn (tcAddEffectOp tc name ty effName)
  (tcPushFn tc
    (cast Int (FnEnt name
                     (if (== ty 0) mkSilentWild ty)
                     (if (== ty 0) (- 0 1) (arrowDepth ty))
                     0 1
                     (let ((v vecNew))
                       { (vecPush v (customEff effName)) v })
                     vecNew))))

; ------------------------------------------------------------------
; Effects, as tagged strings. `effEq` is plain string equality, which
; is why the tag has to be part of the string rather than a separate
; word: these live in Vecs and are compared by value.
; ------------------------------------------------------------------
(pub :: builtinEff (-> Int String))
(pub fn (builtinEff n) (strConcat "b:" n))

(pub :: customEff (-> Int String))
(pub fn (customEff n) (strConcat "c:" n))

; The name stage0's `Display for Effect` prints, which is what an
; AX3011 message quotes: the tag's two bytes removed.
(pub :: effRender (-> String String))
(pub fn (effRender e) (strSlice e 2 (- (strLen e) 2)))

(pub :: effIn (-> Int String Int))
(pub fn (effIn v e) (strInVec v e 0))

; Union into `acc`, answering 1 when anything was added - the
; fixpoint's "changed" signal.
(pub :: effUnion (-> Int Int Int Int))
(pub fn (effUnion acc src i)
  (if (>= i (vecLen src))
      0
      (let ((rest (effUnion acc src (+ i 1))))
        (if (== (effIn acc (vecGet src i)) 1)
            rest
            { (vecPush acc (vecGet src i)) 1 }))))

(pub :: effAdd (-> Int String Int))
(pub fn (effAdd acc e)
  (if (== (effIn acc e) 1) 0 { (vecPush acc e) 1 }))

(pub :: tcCollectData (-> Int Int Int))
(pub fn (tcCollectData tc d)
  (let ((tvs (nodeTy d)))
    (let ((tvNodes vecNew))
      {
        (tvNamesToNodes tvs tvNodes 0)
        (let ((resTy (mkTCon (nodeA d) tvNodes))
              (ctors vecNew))
          {
            (tcCollectCtors (nodeB d) resTy ctors 0)
            (vecPush (tcDatas tc) (cast Int (DataEnt (nodeA d) ctors (nodeModule d))))
          })
      })))

(pub :: tvNamesToNodes (-> Int Int Int Int))
(pub fn (tvNamesToNodes tvs acc i)
  (if (== tvs 0)
      0
      (if (>= i (vecLen tvs))
          0
          {
            (vecPush acc (mkTVar (vecGet tvs i)))
            (tvNamesToNodes tvs acc (+ i 1))
          })))

; A constructor's type is its fields curried onto the APPLIED data
; type - `Nil : List a`, never bare `List` (stage0 registers nullary
; constructors with the type arguments too, a recorded old bug).
(pub :: tcCollectCtors (-> Int Int Int Int Int))
(pub fn (tcCollectCtors ctorNodes resTy acc i)
  (if (>= i (vecLen ctorNodes))
      0
      (let ((c (vecGet ctorNodes i)))
        (let ((fieldTys (if (== (nodeTy c) 0) vecNew (nodeTy c))))
          {
            (vecPush acc
              (cast Int (CtorEnt (nodeA c) fieldTys resTy
                                 (ctorArrowOf fieldTys resTy
                                              (- (vecLen fieldTys) 1))
                                 (nodeFieldNames c))))
            (tcCollectCtors ctorNodes resTy acc (+ i 1))
          }))))

(pub :: ctorArrowOf (-> Int Int Int Int))
(pub fn (ctorArrowOf fieldTys acc i)
  (if (< i 0)
      acc
      (ctorArrowOf fieldTys (mkTArr (vecGet fieldTys i) acc) (- i 1))))

(pub :: tcCollectSig (-> Int Int Int))
(pub fn (tcCollectSig tc d)
  (let ((ty (if (== (nodeTy d) 0) mkSilentWild (nodeTy d))))
    (let ((ent (fnEntExact tc (nodeA d))))
      (if (== ent 0)
          (tcPushFn tc (cast Int (FnEnt (nodeA d) ty (- 0 1) 0 0 vecNew vecNew)))
          (memSetWord ent 1 ty)))))

; Every push to `fns` goes through here, so the exact-name index cannot
; fall behind the table it indexes - including if a later pass ever
; pushes after `checkModuleTc` has built it, which nothing does today
; and which would otherwise be a silently wrong lookup rather than a
; slow one.
(pub :: tcPushFn (-> Int Int Int))
(pub fn (tcPushFn tc ent)
  { (vecPush (tcFns tc) ent) (fnIdxNote tc ent) ent })

(pub :: tcCollectFn (-> Int Int Int))
(pub fn (tcCollectFn tc d)
  (let ((ent0 (fnEntExact tc (nodeA d))))
    (let ((ent (if (!= ent0 0)
                   ent0
                   (let ((ph (mkTVar (strConcat "_fn_" (decStr (tcCounter tc))))))
                     {
                       (tcBumpCounter tc)
                       (tcPushFn tc (cast Int (FnEnt (nodeA d) ph (- 0 1) 0 0 vecNew vecNew)))
                     }))))
      (memSetWord ent 2 (vecLen (nodeB d))))))

; ------------------------------------------------------------------
; Lookups. Exact name first over the whole table, then the `Mod$name`
; suffix pass - which reproduces stage0's entry-first (module-less
; first) resolution, because entry declarations keep bare names and a
; bare reference matches them exactly while an imported one only
; matches through its suffix.
; ------------------------------------------------------------------
(pub :: findFnEntExact (-> Int String Int Int))
(pub fn (findFnEntExact fns name i)
  (if (>= i (vecLen fns))
      0
      (let ((e (vecGet fns i)))
        (if (strEq (memGetWord e 0) name)
            e
            (findFnEntExact fns name (+ i 1))))))

(pub :: findFnEntSuffix (-> Int String Int Int))
(pub fn (findFnEntSuffix fns name i)
  (if (>= i (vecLen fns))
      0
      (let ((e (vecGet fns i)))
        (if (== (nameMatches (memGetWord e 0) name) 1)
            e
            (findFnEntSuffix fns name (+ i 1))))))

; ------------------------------------------------------------------
; Visibility.
;
; A declaration that is not exported is still IN the program - its own
; module's bodies call it - so every lookup that can be reached from
; outside that module has to refuse it, and these are the predicates
; they share. Privacy used to be enforced by the declaration's
; ABSENCE, which is why it took the module's own calls down with it.
;
; It is recorded in ONE place, `tc`'s word 19: the mangled `Mod$name`
; of every carried-but-not-exported declaration. Not on the entries -
; a field on `FnEnt` costs a word on all ~1,600 of them, in the table
; `findFnEnt` scans linearly and where a self-check spends most of its
; time, and it measured 1.30s -> 1.38s. This Vec is EMPTY for every
; program in this repository and for every program that declares
; nothing private - answered as 0 rather than as an empty Vec, so
; every lookup's guard is one word compare against a constant.
;
; `data` and `struct` names are not rewritten to `Mod$name` - only
; `fn` and `::` are - so their key is built from the module recorded
; beside them.
; ------------------------------------------------------------------
(pub :: privKey (-> String String String))
(pub fn (privKey declMod name)
  (if (== declMod 0) name (strConcat (strConcat declMod "$") name)))

; 1 when a reference made from `curMod` may NOT name `key`.
(pub :: privBlocks (-> Int String String Int))
(pub fn (privBlocks privs key curMod)
  (if (== (strInVec privs key 0) 0)
      0
      (if (== curMod 0)
          1
          (if (strStartsWith key (strConcat curMod "$")) 0 1))))

(pub :: findFnEntVisibleExact (-> Int Int String String Int))
(pub fn (findFnEntVisibleExact privs fns name curMod)
  (findFnEntVisibleExactFrom privs fns name curMod 0))

(pub :: findFnEntVisibleExactFrom (-> Int Int String String Int Int))
(pub fn (findFnEntVisibleExactFrom privs fns name curMod i)
  (if (>= i (vecLen fns))
      0
      (let ((e (vecGet fns i)))
        (if (strEq (memGetWord e 0) name)
            (if (== (privBlocks privs (memGetWord e 0) curMod) 0)
                e
                (findFnEntVisibleExactFrom privs fns name curMod (+ i 1)))
            (findFnEntVisibleExactFrom privs fns name curMod (+ i 1))))))

(pub :: findFnEntVisibleSuffix (-> Int Int String String Int))
(pub fn (findFnEntVisibleSuffix privs fns name curMod)
  (findFnEntVisibleSuffixFrom privs fns name curMod 0))

(pub :: findFnEntVisibleSuffixFrom (-> Int Int String String Int Int))
(pub fn (findFnEntVisibleSuffixFrom privs fns name curMod i)
  (if (>= i (vecLen fns))
      0
      (let ((e (vecGet fns i)))
        (if (== (nameMatches (memGetWord e 0) name) 1)
            (if (== (privBlocks privs (memGetWord e 0) curMod) 0)
                e
                (findFnEntVisibleSuffixFrom privs fns name curMod (+ i 1)))
            (findFnEntVisibleSuffixFrom privs fns name curMod (+ i 1))))))

; The module-local step needs no visibility test - it asks for
; `Mod$name` with `Mod` the module being checked, so anything it finds
; is that module's own. Both steps after it can reach another module's
; declaration, and when anything in the program is private both are
; filtered.
;
; Getting this wrong is not a missing diagnostic, it is a link
; failure: `mangledFor` holds no bare entry for a private name, so a
; reference the checker lets through is emitted verbatim and `opt`
; reports `use of undefined value` against generated code, at exit 4,
; blaming the toolchain. The clean AX3023 is this function's job.
(pub :: findFnEnt (-> Int String Int))
(pub fn (findFnEnt tc name)
  (let ((m (memGetWord tc 16)))
    (let ((local (if (== m 0)
                     0
                     (fnEntExact tc (strConcat (strConcat m "$") name)))))
      (if (!= local 0)
          local
          (if (== (memGetWord tc 19) 0)
              (let ((e (fnEntExact tc name)))
                (if (!= e 0) e (findFnEntSuffix (tcFns tc) name 0)))
              (let ((e (findFnEntVisibleExact (memGetWord tc 19) (tcFns tc) name m)))
                (if (!= e 0)
                    e
                    (findFnEntVisibleSuffix (memGetWord tc 19) (tcFns tc) name m))))))))

; The same question asked of the whole table rather than of the
; visible part of it: used only to tell "there is no such name" from
; "there is one and it is private", which are the same AX3001 today
; and should not read the same to whoever gets it.
(pub :: findFnEntAnywhere (-> Int String Int))
(pub fn (findFnEntAnywhere tc name)
  (let ((e (fnEntExact tc name)))
    (if (!= e 0) e (findFnEntSuffix (tcFns tc) name 0))))

; ------------------------------------------------------------------
; The exact-name index.
;
; `findFnEnt` performed up to three full linear scans of `tcFns` per
; reference - `Mod$name` exactly, then the bare name exactly, then the
; `$`-suffix pass - over a table holding about 1,600 entries when the
; compiler checks itself. A per-call-site sampling profile of `axiom
; check self_host/main.ax` put **83% of the program in the two EXACT
; passes** and under 5% in the suffix one. So only the exact passes are
; indexed, and `findFnEntSuffix` is left exactly as it was.
;
; That split is the whole design. Indexing an exact match is a
; statement about string equality and nothing else; indexing the suffix
; pass would mean reasoning about where `$` falls in a name, which
; module mangling has already rewritten, and which of several matches
; wins - in the function whose own comment says getting it wrong "is
; not a missing diagnostic, it is a link failure".
;
; SHAPE. Buckets, not open addressing: this table is built once and
; never deleted from, so probing, tombstones and growth would all be
; machinery for cases that cannot arise. Each bucket keeps insertion
; order and the scan takes the first match, which is what the linear
; scan answered - and it has to be, because `tcAddEffectOp` pushes with
; no presence test, so two entries legitimately share a name and only
; the first is reachable.
;
; The hash is the shape `stdlib/Intern.ax` uses - a multiplicative hash
; with an odd multiplier, reduced mod 2^31-1 at every step - spelled out
; here rather than imported. `typecheck.ax` importing `Intern` pulls
; `Map` with it and puts 63 declarations into six entry files' import
; closures for one hash function, in a flat namespace that already
; carries five separate `fmtInt`s. Intern's own note explains why the
; running value stays under the prime: the product of a value below
; 2^31 and a multiplier below 2^31 is below 2^62, so nothing overflows
; into the sign bit before the `%` brings it back down, and no negative
; index can reach `vecGet`.
; ------------------------------------------------------------------
(pub :: fnIdxMul Int)   (pub fn (fnIdxMul)   1099087573)
(pub :: fnIdxSeed Int)  (pub fn (fnIdxSeed)  1234567891)
(pub :: fnIdxPrime Int) (pub fn (fnIdxPrime) 2147483647)

(pub :: fnIdxHash (-> String Int))
(pub fn (fnIdxHash s) (fnIdxHashFrom s 0 fnIdxSeed))

(pub :: fnIdxHashFrom (-> String Int Int Int))
(pub fn (fnIdxHashFrom s i h)
  (if (>= i (strLen s))
      h
      (fnIdxHashFrom s (+ i 1)
                     (% (+ (* h fnIdxMul) (strByte s i)) fnIdxPrime))))

; Buckets for a table of `n` entries: enough that the average bucket
; holds well under one, and never fewer than 17 so a tiny program still
; spreads. Odd, because the hash's low bits are the ones `%` keeps.
(pub :: fnIdxBuckets (-> Int Int))
(pub fn (fnIdxBuckets n) (+ (* 2 n) 17))

; A Vec of `fnIdxBuckets` slots, each 0 until something hashes to it -
; an empty `Vec` header per slot would be 3 words times the bucket
; count for nothing.
(pub :: fnIdxBuild (-> Int Int))
(pub fn (fnIdxBuild fns) (fnIdxBuildSized fns 0))

; Built with the eventual size in hand rather than the current one.
;
; The index is created in `tcNew`, BEFORE collection, because
; `tcCollectSig` and `tcCollectFn` each look a name up before deciding
; whether to push - so a table indexed only afterwards leaves collection
; itself a linear scan per declaration, which is quadratic in the
; declaration count and, on a single large module, becomes the dominant
; cost once the body-checking scans are gone. Measured on a generated
; module of N cross-referencing functions before this: N=1000 0.05s,
; N=2000 0.15s.
;
; Sizing needs a hint because the table is nearly empty at that point -
; about sixty builtins - and these buckets never grow. The declaration
; count is the hint: every `::` and `fn` in the program contributes at
; most one entry, so it is an upper bound on the table and the average
; bucket stays well under one.
(pub :: fnIdxBuildSized (-> Int Int Int))
(pub fn (fnIdxBuildSized fns hint)
  (let ((n (if (> hint (vecLen fns)) hint (vecLen fns))))
   (let ((nb (fnIdxBuckets n)) (bs vecNew) (mut i 0))
    {
      (while (< i nb) { (vecPush bs 0) (set i (+ i 1)) })
      (set i 0)
      (while (< i (vecLen fns))
        {
          (fnIdxAdd bs (vecGet fns i))
          (set i (+ i 1))
        })
      bs
    })))

(pub :: fnIdxAdd (-> Int Int Int))
(pub fn (fnIdxAdd bs ent)
  (let ((b (% (fnIdxHash (memGetWord ent 0)) (vecLen bs))))
    (if (== (vecGet bs b) 0)
        (let ((v vecNew)) { (vecPush v ent) (vecSet bs b v) 0 })
        { (vecPush (vecGet bs b) ent) 0 })))

(pub :: fnIdxGet (-> Int String Int))
(pub fn (fnIdxGet bs name)
  (if (== (vecGet bs (% (fnIdxHash name) (vecLen bs))) 0)
      0
      (fnIdxScan (vecGet bs (% (fnIdxHash name) (vecLen bs))) name 0)))

(pub :: fnIdxScan (-> Int String Int Int))
(pub fn (fnIdxScan v name i)
  (if (>= i (vecLen v))
      0
      (if (strEq (memGetWord (vecGet v i) 0) name)
          (vecGet v i)
          (fnIdxScan v name (+ i 1)))))

; The exact-name question, however it is currently answerable. Word 20
; is 0 until `checkModuleTc` builds the index after collection, and
; during collection the scan answers - which is the same answer, just
; the slow way, and is why the three push sites also maintain the index
; when it exists rather than relying on an ordering.
(pub :: fnEntExact (-> Int String Int))
(pub fn (fnEntExact tc name)
  (if (== (memGetWord tc 20) 0)
      (findFnEntExact (tcFns tc) name 0)
      (fnIdxGet (memGetWord tc 20) name)))

; Keep the index in step with a push. A no-op before the index exists.
(pub :: fnIdxNote (-> Int Int Int))
(pub fn (fnIdxNote tc ent)
  (if (== (memGetWord tc 20) 0)
      0
      (fnIdxAdd (memGetWord tc 20) ent)))

; Constructor lookup, FORWARD order - Option's are first. Used for
; type resolution and patterns (stage0's find_constructor).
; A `data`/`struct` name is NOT rewritten to `Mod$name` - only `fn`
; and `::` are - so a type's privacy cannot be read off its name the
; way a function's can, and these three lookups take the declaring
; module from the entry beside it.
;
; The predicate is the same one: exported, or asked from inside the
; module that declared it.
(pub :: findCtor (-> Int String Int))
(pub fn (findCtor tc name)
  (findCtorFrom (tcDatas tc) name (memGetWord tc 19)
                (memGetWord tc 16) 0))

(pub :: findCtorFrom (-> Int String Int String Int Int))
(pub fn (findCtorFrom datas name privs curMod i)
  (if (>= i (vecLen datas))
      0
      (let ((d (vecGet datas i)))
        (if (&& (!= privs 0)
                (== (privBlocks privs (privKey (memGetWord d 2) (memGetWord d 0)) curMod) 1))
            (findCtorFrom datas name privs curMod (+ i 1))
            (let ((c (ctorInData (memGetWord d 1) (memGetWord d 2) name 0)))
              (if (!= c 0)
                  c
                  (findCtorFrom datas name privs curMod (+ i 1))))))))

(pub :: ctorInData (-> Int String String Int Int))
(pub fn (ctorInData ctors declMod name i)
  (if (>= i (vecLen ctors))
      0
      (let ((c (vecGet ctors i)))
        (if (== (declMatches declMod (memGetWord c 0) name) 1)
            c
            (ctorInData ctors declMod name (+ i 1))))))

; The LAST matching constructor - stage0's bare-value and saturation
; paths use rfind, and the difference is observable when two datas
; declare the same constructor name.
(pub :: rfindCtor (-> Int String Int))
(pub fn (rfindCtor tc name)
  (rfindCtorFrom (tcDatas tc) name (memGetWord tc 19)
                 (memGetWord tc 16)
                 (- (vecLen (tcDatas tc)) 1)))

(pub :: rfindCtorFrom (-> Int String Int String Int Int))
(pub fn (rfindCtorFrom datas name privs curMod i)
  (if (< i 0)
      0
      (let ((d (vecGet datas i)))
        (if (&& (!= privs 0)
                (== (privBlocks privs (privKey (memGetWord d 2) (memGetWord d 0)) curMod) 1))
            (rfindCtorFrom datas name privs curMod (- i 1))
            (let ((c (rctorInData (memGetWord d 1) (memGetWord d 2) name
                                  (- (vecLen (memGetWord d 1)) 1))))
              (if (!= c 0)
                  c
                  (rfindCtorFrom datas name privs curMod (- i 1))))))))

(pub :: rctorInData (-> Int String String Int Int))
(pub fn (rctorInData ctors declMod name i)
  (if (< i 0)
      0
      (let ((c (vecGet ctors i)))
        (if (== (declMatches declMod (memGetWord c 0) name) 1)
            c
            (rctorInData ctors declMod name (- i 1))))))

(pub :: findStruct (-> Int String Int))
(pub fn (findStruct tc name)
  (findStructFrom (tcStructs tc) name (memGetWord tc 19)
                  (memGetWord tc 16) 0))

(pub :: findStructFrom (-> Int String Int String Int Int))
(pub fn (findStructFrom structs name privs curMod i)
  (if (>= i (vecLen structs))
      0
      (let ((s (vecGet structs i)))
        (if (== (declMatches (memGetWord s 2) (memGetWord s 0) name) 1)
            (if (|| (== privs 0)
                    (== (privBlocks privs (privKey (memGetWord s 2) (memGetWord s 0)) curMod) 0))
                s
                (findStructFrom structs name privs curMod (+ i 1)))
            (findStructFrom structs name privs curMod (+ i 1))))))

(pub :: findData (-> Int String Int))
(pub fn (findData tc name)
  (findDataFrom (tcDatas tc) name (memGetWord tc 19)
                (memGetWord tc 16) 0))

(pub :: findDataFrom (-> Int String Int String Int Int))
(pub fn (findDataFrom datas name privs curMod i)
  (if (>= i (vecLen datas))
      0
      (let ((e (vecGet datas i)))
        (if (== (nameMatches (memGetWord e 0) name) 1)
            (if (|| (== privs 0)
                    (== (privBlocks privs (privKey (memGetWord e 2) (memGetWord e 0)) curMod) 0))
                e
                (findDataFrom datas name privs curMod (+ i 1)))
            (findDataFrom datas name privs curMod (+ i 1))))))

; ------------------------------------------------------------------
; Type constructors named in a SIGNATURE.
;
; `parseTypeAtom` turns every capitalised name that is not one of
; `typeKeywordCanon`'s primitives into a bare `TAG_T_CON`, and nothing
; ever asked whether it named anything (`parser.ax:1261-1266`). So
;
;   (:: g (-> Nonexistent Int))
;   (fn (g x) 1)
;   (fn (main) (g 5))
;
; was accepted, and the diagnostic that eventually arrived was an
; AX3004 at the CALLER - blaming the caller's `Int` for the declarer's
; typo. AX3002 had exactly one construction site in this file and it
; is the `(struct Name ...)` expression, so no signature, annotation
; or field type had ever been resolved against anything.
;
; Type VARIABLES need no check: `lexStartsLower` sends every
; lowercase-initial name to `TAG_T_VAR` before this can see it. So the
; subject here is exactly the capitalised names.
;
; Anchoring: a type node carries NO span - `mkTCon` is `mkNode`, not
; `mkNodeAt` - so the diagnostic sits on the signature's own name span,
; and only the FIRST unknown constructor in a signature is reported.
; Pointing every one of them at that same span would print the same
; caret twice for `(-> Nope Nope)`, and this repository's rule for a
; shape it kept no span for is to say less rather than to mis-point.
; ------------------------------------------------------------------
(pub :: tcAliasFind (-> Int String Int))
(pub fn (tcAliasFind tc name)
  (tcAliasFindFrom (tcAliases tc) name 0))

(pub :: tcAliasFindFrom (-> Int String Int Int))
(pub fn (tcAliasFindFrom av name i)
  (if (>= i (vecLen av))
      0
      (if (strEq (nodeA (vecGet av i)) name)
          (vecGet av i)
          (tcAliasFindFrom av name (+ i 1)))))

; Existence, deliberately IGNORING visibility. `findDataFrom` and
; `findStructFrom` skip their privacy filter when `privs` is 0, and
; that is what is wanted: reaching a type another module keeps private
; is AX3023's subject, and answering AX3002 for it would say "no such
; type" about one that exists.
;
; An ALIAS name counts as known. An alias is a declaration; saying
; "undefined type" about it would be false.
;
; It is also EXPANDED now - see `tcExpandSigAliases`. The note that
; used to stand here said expansion was a larger slice because
; `parseSigDecl` stores per-arrow float flags in the node's `b` slot,
; reconstructed at PARSE time from the tokens because float-ness is
; not observable at runtime, and codegen keys on that exact shape - so
; expanding `(type F = Float)` in the checker alone would have the
; checker say `Float` where the emitter still says `Int`. That was
; right, and it is why expansion rewrites the FLAGS as well as the
; type.
(pub :: tyConKnown (-> Int String Int))
(pub fn (tyConKnown tc name)
  (if (!= (typeKeywordCanon name) 0)
      1
  (if (strEq name "Linear")
      1
  (if (!= (findDataFrom (tcDatas tc) name 0 0 0) 0)
      1
  (if (!= (findStructFrom (tcStructs tc) name 0 0 0) 0)
      1
  (if (!= (tcAliasFind tc name) 0)
      1
      0))))))

; The name of the first type constructor in `t` that resolves to
; nothing, or 0. A known head with an unknown ARGUMENT is still a
; miss, so `(Box Nope)` reports `Nope`.
(pub :: tyUnknownCon (-> Int Int Int))
(pub fn (tyUnknownCon tc t)
  (if (== t 0)
      0
      (if (== (nodeTag t) TAG_T_CON)
          (if (== (tyConKnown tc (nodeA t)) 0)
              (nodeA t)
              (tyUnknownConVec tc (nodeB t) 0))
      (if (== (nodeTag t) TAG_T_ARR)
          (if (!= (tyUnknownCon tc (nodeA t)) 0)
              (tyUnknownCon tc (nodeA t))
              (tyUnknownCon tc (nodeB t)))
      (if (== (nodeTag t) TAG_T_TUP)
          (tyUnknownConVec tc (nodeA t) 0)
      (if (== (nodeTag t) TAG_T_LIST)
          (tyUnknownCon tc (nodeA t))
      (if (== (nodeTag t) TAG_T_PTR)
          (tyUnknownCon tc (nodeA t))
          0)))))))

(pub :: tyUnknownConVec (-> Int Int Int Int))
(pub fn (tyUnknownConVec tc xs i)
  (if (>= i (vecLen xs))
      0
      (if (!= (tyUnknownCon tc (vecGet xs i)) 0)
          (tyUnknownCon tc (vecGet xs i))
          (tyUnknownConVec tc xs (+ i 1)))))

; ------------------------------------------------------------------
; `type` aliases, expanded.
;
; `docs/reference.md:808` says an alias "does not create a new type -
; `StringList` and `[String]` are interchangeable". The compiler
; answered two different ways depending on POSITION:
;
;   (type Count = Int)
;   (:: h (-> Count Int))  (fn (h c) c)
;   (h 42)                     AX3004: expected Count, found Int
;   (:: mkc (-> Int Count)) (fn (mkc n) n)
;   (h (mkc 42))               exit 0, prints 42
;
; because argument checking compares constructor NAMES through
; `tyCompat` while the declared-return check names only `Bool` and
; `Float`. `tcAliases` was populated at collection and read by
; `symbols` and by nobody else, so the declaration existed and was
; never expanded.
;
; Expansion happens once, over the signature, and writes THREE places
; so no reader is left with the unexpanded spelling: the declaration
; node's type slot, its float-flag slot, and the `FnEnt`'s type - which
; is what `checkVar` hands a call site, what `bindFnParams` peels for
; the parameters and what `checkDeclaredReturn` compares the body
; against. One write per reader; the positions cannot disagree again
; because there is nothing left for them to disagree about.
;
; The FLAGS are the half that makes this sound rather than a swapped
; defect. They are one bit per arrow position - is it a bare `Float` -
; and codegen reads them because by emission time there is no checker
; to ask. Recomputing them from the expanded NODE reproduces
; `sigFloatFlags` exactly as long as the vector keeps its ORIGINAL
; length: position k is the k-th peel's parameter for every k but the
; last, and the last is whatever is left, which is precisely how
; `spineFlags` reads the token spine. Walking the node to exhaustion
; instead would give `(-> Int (-> Float Float))` three flags where the
; parser gives two.
;
; A cyclic alias - `(type A = B)` beside `(type B = A)` - stops at the
; depth cap and stays nominal, which is what it was before. Recorded,
; not diagnosed.
(pub :: aliasMaxDepth Int)
(pub fn (aliasMaxDepth) 32)

(pub :: tyHasAliasCon (-> Int Int Int))
(pub fn (tyHasAliasCon tc t)
  (if (== t 0)
      0
      (let ((tg (nodeTag t)))
        (if (== tg TAG_T_CON)
            (if (!= (tcAliasFind tc (nodeA t)) 0)
                1
                (tyHasAliasConVec tc (nodeB t) 0))
        (if (== tg TAG_T_ARR)
            (if (== (tyHasAliasCon tc (nodeA t)) 1) 1 (tyHasAliasCon tc (nodeB t)))
        (if (== tg TAG_T_TUP)
            (tyHasAliasConVec tc (nodeA t) 0)
        (if (|| (== tg TAG_T_LIST) (== tg TAG_T_PTR))
            (tyHasAliasCon tc (nodeA t))
        0)))))))

(pub :: tyHasAliasConVec (-> Int Int Int Int))
(pub fn (tyHasAliasConVec tc xs i)
  (if (== xs 0)
      0
      (if (>= i (vecLen xs))
          0
          (if (== (tyHasAliasCon tc (vecGet xs i)) 1)
              1
              (tyHasAliasConVec tc xs (+ i 1))))))

(pub :: tyExpandAliases (-> Int Int Int Int))
(pub fn (tyExpandAliases tc t depth)
  (if (== t 0)
      0
      (if (>= depth aliasMaxDepth)
          t
          (let ((tg (nodeTag t)))
            (if (== tg TAG_T_CON)
                (let ((al (tcAliasFind tc (nodeA t))))
                  (if (== al 0)
                      (mkTCon (nodeA t) (tyExpandAliasesVec tc (nodeB t) depth vecNew 0))
                      ; An alias's TARGET may itself name one, so the
                      ; expansion is re-entered rather than returned.
                      ; Parameterised aliases need substitution and are
                      ; not covered: only the zero-parameter spelling
                      ; expands, which is the one `docs/reference.md`
                      ; documents and the only one `symbols` prints.
                      (if (!= (vecLen (nodeB t)) 0)
                          t
                          (tyExpandAliases tc (nodeB al) (+ depth 1)))))
            (if (== tg TAG_T_ARR)
                (mkTArr (tyExpandAliases tc (nodeA t) depth)
                        (tyExpandAliases tc (nodeB t) depth))
            (if (== tg TAG_T_TUP)
                (mkTTup (tyExpandAliasesVec tc (nodeA t) depth vecNew 0))
            (if (== tg TAG_T_LIST)
                (mkNode TAG_T_LIST (tyExpandAliases tc (nodeA t) depth) 0 0)
            (if (== tg TAG_T_PTR)
                (mkTPtr (tyExpandAliases tc (nodeA t) depth) (nodeB t))
            t)))))))))

(pub :: tyExpandAliasesVec (-> Int Int Int Int Int Int))
(pub fn (tyExpandAliasesVec tc xs depth acc i)
  (if (== xs 0)
      acc
      (if (>= i (vecLen xs))
          acc
          {
            (vecPush acc (tyExpandAliases tc (vecGet xs i) depth))
            (tyExpandAliasesVec tc xs depth acc (+ i 1))
          })))

; 1 when this type is a bare `Float`, which is the only thing a float
; flag is ever set for - an applied constructor, an arrow, a tuple, a
; list or a pointer is a word.
(pub :: tyIsBareFloat (-> Int Int))
(pub fn (tyIsBareFloat t)
  (if (== t 0)
      0
      (if (!= (nodeTag t) TAG_T_CON)
          0
          (if (!= (vecLen (nodeB t)) 0)
              0
              (if (strEq (nodeA t) "Float") 1 0)))))

; The flag vector `sigFloatFlags` would have produced for `t`, at the
; length the parser already chose.
(pub :: tyFloatFlags (-> Int Int Int))
(pub fn (tyFloatFlags t n)
  (tyFloatFlagsFrom t n 0 vecNew))

(pub :: tyFloatFlagsFrom (-> Int Int Int Int Int))
(pub fn (tyFloatFlagsFrom t n i acc)
  (if (>= i n)
      acc
      (if (== (+ i 1) n)
          { (vecPush acc (tyIsBareFloat t)) acc }
          (if (!= (nodeTag t) TAG_T_ARR)
              ; Fewer arrows than flags cannot happen for a type this
              ; pass expanded - the length came from the same spine -
              ; but answering the flags already collected is the
              ; conservative end rather than reading off a non-arrow.
              acc
              {
                (vecPush acc (tyIsBareFloat (nodeA t)))
                (tyFloatFlagsFrom (nodeB t) n (+ i 1) acc)
              }))))

; One pass over the resolved declaration list, after `tcCollect` has
; registered every `data`, `struct` and `type` - a signature may name
; a type declared later in the file, or in another module.
(pub :: tcCheckSigTypes (-> Int Int Int Int))
(pub fn (tcCheckSigTypes tc decls i)
  (if (>= i (vecLen decls))
      0
      {
        (if (== (nodeTag (vecGet decls i)) TAG_D_SIG)
            {
              ; Expansion FIRST: `tcCheckSigTypeOf` poisons a signature
              ; naming an unknown type, and an alias is a known one.
              (tcExpandSigAliases tc (vecGet decls i))
              (tcCheckSigTypeOf tc (vecGet decls i))
            }
            0)
        (tcCheckSigTypes tc decls (+ i 1))
      }))

(pub :: tcExpandSigAliases (-> Int Int Int))
(pub fn (tcExpandSigAliases tc d)
  (if (== (tyHasAliasCon tc (nodeTy d)) 0)
      0
      (let ((ex (tyExpandAliases tc (nodeTy d) 0))
            (n (if (== (nodeB d) 0) 0 (vecLen (nodeB d)))))
        {
          (setNodeTy d ex)
          (if (== n 0) 0 (memSetWord d 2 (tyFloatFlags ex n)))
          (let ((ent (fnEntExact tc (nodeA d))))
            (if (== ent 0) 0 (memSetWord ent 1 ex)))
        })))

(pub :: tcCheckSigTypeOf (-> Int Int Int))
(pub fn (tcCheckSigTypeOf tc d)
  (let ((bad (tyUnknownCon tc (nodeTy d))))
    (if (== bad 0)
        0
        {
          (if (== (nodeSpan d) 0)
              0
              (emitDiag tc
                (diagSetLabel (mkDiag SEV_ERROR "AX3002" "undefined-type"
                        (nodeSpan d)
                        (strConcat (strConcat "undefined type `" bad) "`")
                        0 0
                        "check for typos, or a missing `data`/`struct`/`type` declaration")
                  (strConcat (strConcat "no type named `" bad) "` is visible here"))))
          (let ((ent (fnEntExact tc (nodeA d))))
            (if (== ent 0)
                0
                (memSetWord ent 1 (tyPoisonUnknown tc (nodeTy d)))))
        })))

; The same type with every unresolvable constructor replaced by
; poison, the structure kept. `tyCompat` treats poison as compatible
; with everything, so the one AX3002 at the declaration becomes the
; only thing reported: without this a signature naming an undefined
; type drew a further AX3004 at every CALL SITE - measured, one bad
; signature and four calls gave five errors, which is the cascade the
; poison discipline at the top of this file exists to prevent, and
; what the sibling AX3002 site already does by answering `TAG_T_ERR`.
;
; The arrow shape is preserved rather than poisoning the whole type,
; because `peelArrows` and `bindFnParams` read it and a NON-arrow
; signature means "every parameter is Int" to them - so poisoning
; wholesale would quietly retype the parameters instead of excusing
; them.
;
; A fresh tree is built rather than the nodes edited: the declaration's
; own `ty` slot is what `symbols` renders, and only the checker's copy
; in `FnEnt` word 1 should carry poison.
(pub :: tyPoisonUnknown (-> Int Int Int))
(pub fn (tyPoisonUnknown tc t)
  (if (== t 0)
      0
      (if (== (nodeTag t) TAG_T_CON)
          (if (== (tyConKnown tc (nodeA t)) 0)
              mkTErr
              (mkTCon (nodeA t) (tyPoisonUnknownVec tc (nodeB t) vecNew 0)))
      (if (== (nodeTag t) TAG_T_ARR)
          (mkTArr (tyPoisonUnknown tc (nodeA t)) (tyPoisonUnknown tc (nodeB t)))
      (if (== (nodeTag t) TAG_T_TUP)
          (mkTTup (tyPoisonUnknownVec tc (nodeA t) vecNew 0))
      (if (== (nodeTag t) TAG_T_LIST)
          (mkNode TAG_T_LIST (tyPoisonUnknown tc (nodeA t)) 0 0)
      (if (== (nodeTag t) TAG_T_PTR)
          (mkTPtr (tyPoisonUnknown tc (nodeA t)) (nodeB t))
          t)))))))

(pub :: tyPoisonUnknownVec (-> Int Int Int Int Int))
(pub fn (tyPoisonUnknownVec tc xs out i)
  (if (>= i (vecLen xs))
      out
      {
        (vecPush out (tyPoisonUnknown tc (vecGet xs i)))
        (tyPoisonUnknownVec tc xs out (+ i 1))
      }))

; A struct's field type by name, or -1 when absent. Fields are the
; parser's TAG_FIELD nodes: name in a, parsed type in ty.
(pub :: structFieldTy (-> Int String Int))
(pub fn (structFieldTy ent fname)
  (structFieldTyFrom (memGetWord ent 1) fname 0))

(pub :: structFieldTyFrom (-> Int String Int Int))
(pub fn (structFieldTyFrom fields fname i)
  (if (>= i (vecLen fields))
      (- 0 1)
      (let ((f (vecGet fields i)))
        (if (strEq (nodeA f) fname)
            (if (== (nodeTy f) 0) mkSilentWild (nodeTy f))
            (structFieldTyFrom fields fname (+ i 1))))))

; How many arguments a function's use must supply before it can be a
; value: the declared parameter count when a definition was seen, the
; ARROW DEPTH for builtins (their type is the whole truth), and -1 -
; unmeasurable - for a signature-only name (a one-parameter function
; returning a closure has arrow depth 2 but arity 1, so depth would
; wrongly flag legal code).
(pub :: repArity (-> Int Int))
(pub fn (repArity ent)
  (if (>= (memGetWord ent 2) 0)
      (memGetWord ent 2)
      (if (== (memGetWord ent 3) 1)
          (arrowDepth (memGetWord ent 1))
          (- 0 1))))

; ------------------------------------------------------------------
; Scope. One entry per binding: name, mutability, the binder's span
; (0 = unknown, suppresses AX3012's anchor), and now the TYPE.
; Entries below frameBase belong to the module walk (signatures); the
; frame region above it is the current function.
; ------------------------------------------------------------------
(pub struct SEnt (name : Int) (mutable : Int) (bsp : Int) (ty : Int))

(pub :: pushScope (-> Int Int Int Int Int Int))
(pub fn (pushScope scope name mutFlag bsp ty)
  (vecPush scope (cast Int (SEnt name mutFlag bsp ty))))

(pub :: sEntTy (-> Int Int))
(pub fn (sEntTy ent) (memGetWord ent 3))

; The innermost entry for `name` anywhere in the vec - `set` target
; resolution and the whole-scope suggestion pool use this.
(pub :: scopeFind (-> Int String Int))
(pub fn (scopeFind scope name)
  (scopeFindFrom scope name (- (vecLen scope) 1)))

(pub :: scopeFindFrom (-> Int String Int Int))
(pub fn (scopeFindFrom scope name i)
  (if (< i 0)
      0
      (if (strEq (memGetWord (vecGet scope i) 0) name)
          (vecGet scope i)
          (scopeFindFrom scope name (- i 1)))))

; The innermost FRAME entry - value resolution reads only the current
; function's bindings; module-level names resolve through the
; function table (same types, stage0's route).
(pub :: scopeFindFrame (-> Int String Int))
(pub fn (scopeFindFrame tc name)
  (scopeFindFrameFrom (tcScope tc) name
                      (- (vecLen (tcScope tc)) 1) (tcFrameBase tc)))

(pub :: scopeFindFrameFrom (-> Int String Int Int Int))
(pub fn (scopeFindFrameFrom scope name i base)
  (if (< i base)
      0
      (if (strEq (memGetWord (vecGet scope i) 0) name)
          (vecGet scope i)
          (scopeFindFrameFrom scope name (- i 1) base))))

(pub :: scopeTrunc (-> Int Int Int))
(pub fn (scopeTrunc scope n)
  (if (<= (vecLen scope) n)
      0
      { (vecPop scope) (scopeTrunc scope n) }))

; ------------------------------------------------------------------
; spanOf: stage0's Expr::span(), the anchor for every EXPRESSION-
; position diagnostic. An application's span is its ultimate head's;
; a field access or field store anchors at its BASE (the field-name
; span in the node's own slot belongs to AX3007 alone); a let's span
; is its BODY's. A shape with no span answers 0 and the caller
; suppresses - never mis-points.
; ------------------------------------------------------------------
(pub :: spanOf (-> Int Int))
(pub fn (spanOf e)
  (if (== e 0)
      0
      (let ((tag (nodeTag e)))
        (if (== tag TAG_E_APP)
            (spanOf (nodeA e))
        (if (|| (== tag TAG_E_FIELD) (== tag TAG_E_SETF))
            (spanOf (nodeA e))
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
            (spanOf (nodeC e))
        (if (|| (== tag TAG_E_IF) (== tag TAG_E_WHILE))
            (spanOf (nodeA e))
        (if (== tag TAG_E_MATCH)
            (spanOf (nodeA e))
        (if (== tag TAG_E_COND)
            (if (== (vecLen (nodeA e)) 0)
                0
                (spanOf (nodeA (vecGet (nodeA e) 0))))
        (if (== tag TAG_E_BEGIN)
            (if (== (vecLen (nodeA e)) 0)
                0
                (spanOf (vecGet (nodeA e) 0)))
        ; A handle's span is its BODY's, and recursively so - stage0's
        ; `Expr::span()` takes the first field of an EHandle exactly
        ; as it takes the function side of an EApp. Nested handles
        ; therefore all report at the innermost body, and without
        ; this arm the node's own zero span suppressed every
        ; diagnostic anchored at a handle whose body is another one.
        (if (== tag TAG_E_HANDLE)
            (spanOf (nodeA e))
        (nodeSpan e))))))))))))

; ------------------------------------------------------------------
; Diagnostic emission helpers. EVERY emission guards its anchor: a
; zero span renders address zero, and a diagnostic stage1 cannot
; place is one it does not print.
; ------------------------------------------------------------------
(pub :: emitMismatch (-> Int String String Int Int))
(pub fn (emitMismatch tc expected found span)
  (if (== span 0)
      0
      {
        (emitDiag tc
          (diagSetLabel (mkDiag SEV_ERROR "AX3004" "type-mismatch"
                  span
                  (strConcat (strConcat (strConcat
                    "type mismatch: expected " expected) ", found ") found)
                  0 0 0)
            (strConcat (strConcat (strConcat (strConcat "this has type `" found) "`, expected `") expected) "`")))
        0
      }))

(pub :: emitAX3012 (-> Int Int Int Int Int))
(pub fn (emitAX3012 name tspan bspan out)
  {
    (vecPush out
      (diagSetLabel (mkDiagFix2 SEV_ERROR "AX3012" "assign-to-immutable"
        tspan
        (strConcat (strConcat "cannot assign to immutable binding `" name) "`")
        bspan
        (strConcat (strConcat "`" name) "` is bound here")
        (strConcat (strConcat "declare it mutable: `(mut " name) " ...)`")
        bspan
        (strConcat "mut " name)
        "only a binding introduced by `(let ((mut x ...)) ...)` may be the target of `set`")
        (strConcat (strConcat "`" name) "` cannot be assigned")))
    0
  })

; ------------------------------------------------------------------
; Operators, keywords and forms that are always in scope and are not
; declarations. Primitives are covered by the `__` prefix instead of
; being listed: every one of them has it, and stage0's own suggestion
; machinery skips `__` names for the same reason.
; ------------------------------------------------------------------
(pub :: isBuiltinName (-> String Int))
(pub fn (isBuiltinName n)
  (if (strStartsWith n "__") 1
  (if (strEq n "+") 1 (if (strEq n "-") 1 (if (strEq n "*") 1
  (if (strEq n "/") 1 (if (strEq n "%") 1 (if (strEq n "&") 1
  (if (strEq n "|") 1 (if (strEq n "^") 1 (if (strEq n "<<") 1
  (if (strEq n ">>") 1 (if (strEq n "==") 1 (if (strEq n "!=") 1
  (if (strEq n "<") 1 (if (strEq n ">") 1 (if (strEq n "<=") 1
  (if (strEq n ">=") 1 (if (strEq n "&&") 1 (if (strEq n "||") 1
  (if (strEq n "true") 1 (if (strEq n "false") 1
  (if (strEq n "cast") 1 (if (strEq n "sizeof") 1 (if (strEq n "alignof") 1
  ; `handle` is a keyword form stage1's parser does not implement, so
  ; `(handle body (E) h)` arrives here as an ordinary application with
  ; `handle` as its head. stage1 cannot lower the effect system, but
  ; reporting its keyword as an undefined *variable* is a false
  ; positive on a program stage0 compiles silently.
  (if (strEq n "handle") 1
  ; The built-in effect names. A `handle` list is parsed as an
  ; application by a parser with no `handle` form, so `(Console IO
  ; Alloc)` puts each of these where an argument goes.
  (if (strEq n "IO") 1 (if (strEq n "Pure") 1 (if (strEq n "Alloc") 1
  (if (strEq n "Mut") 1 (if (strEq n "Div") 1 (if (strEq n "Err") 1
  0))))))))))))))))))))))))))))))))

(pub :: strInVec (-> Int String Int Int))
(pub fn (strInVec v n i)
  (if (>= i (vecLen v))
      0
      (if (strEq (vecGet v i) n)
          1
          (strInVec v n (+ i 1)))))

(pub :: isMacroName (-> Int String Int))
(pub fn (isMacroName tc n)
  (isMacroVisible (tcMacros tc) n (memGetWord tc 16) 0))

; Visible from the module being checked: exported, or the entry
; file's, or this module's own. The same rule `expFindMacroIn`
; applies, and the two have to agree - one decides whether the name
; type-checks and the other whether it expands.
(pub :: isMacroVisible (-> Int String String Int Int))
(pub fn (isMacroVisible ms n curMod i)
  (if (>= i (vecLen ms))
      0
      (let ((m (vecGet ms i)))
        (if (&& (strEq (nodeA m) n)
                (|| (== (nodeVis m) 1)
                    (|| (== (nodeModule m) 0)
                        (&& (!= curMod 0) (strEq (nodeModule m) curMod)))))
            1
            (isMacroVisible ms n curMod (+ i 1))))))

; Declared anywhere, visible or not - for telling "no such macro" from
; "a macro you may not name".
(pub :: isMacroAnywhere (-> Int String Int))
(pub fn (isMacroAnywhere tc n)
  (isMacroNamedIn (tcMacros tc) n 0))

(pub :: isMacroNamedIn (-> Int String Int Int))
(pub fn (isMacroNamedIn ms n i)
  (if (>= i (vecLen ms))
      0
      (if (strEq (nodeA (vecGet ms i)) n)
          1
          (isMacroNamedIn ms n (+ i 1)))))

(pub :: isEffectName (-> Int String Int))
(pub fn (isEffectName tc n)
  (if (== (findEffectDecl tc n) 0) 0 1))

; The TAG_D_EFFECT node declaring `n`, or 0. Its ops vector's length
; is what AX3017 reports.
(pub :: findEffectDecl (-> Int String Int))
(pub fn (findEffectDecl tc n)
  (findEffectDeclFrom (tcEffects tc) n 0))

(pub :: findEffectDeclFrom (-> Int String Int Int))
(pub fn (findEffectDeclFrom effs n i)
  (if (>= i (vecLen effs))
      0
      (let ((d (vecGet effs i)))
        (if (strEq (nodeA d) n)
            d
            (findEffectDeclFrom effs n (+ i 1))))))

; The six built-in effect names a handle list may name. stage0 lexes
; `IO`/`Pure`/`Mut`/`Div` as keyword tokens and special-cases
; `Alloc`/`alloc` and `Err` out of the identifier path, so none of
; them is ever a `Custom` effect - and only `Custom` entries are
; subject to AX3016 and AX3017.
(pub :: isBuiltinEffect (-> String Int))
(pub fn (isBuiltinEffect n)
  (if (strEq n "IO") 1 (if (strEq n "Pure") 1
  (if (strEq n "Mut") 1 (if (strEq n "Div") 1
  (if (strEq n "Alloc") 1 (if (strEq n "alloc") 1
  (if (strEq n "Err") 1 0))))))))

(pub :: isCastLike (-> String Int))
(pub fn (isCastLike n)
  (if (strEq n "cast") 1
  (if (strEq n "sizeof") 1
  (if (strEq n "alignof") 1
  0))))

; How many arguments an application spine supplies, and its head.
(pub :: spineArgs (-> Int Int Int))
(pub fn (spineArgs e acc)
  (if (== (nodeTag e) TAG_E_APP)
      (spineArgs (nodeA e) (+ acc 1))
      acc))

(pub :: spineHead (-> Int Int))
(pub fn (spineHead e)
  (if (== (nodeTag e) TAG_E_APP)
      (spineHead (nodeA e))
      e))

; The spine's arguments in SOURCE order.
(pub :: spineArgVec (-> Int Int Int))
(pub fn (spineArgVec e acc)
  (if (== (nodeTag e) TAG_E_APP)
      {
        (spineArgVec (nodeA e) acc)
        (vecPush acc (nodeB e))
        acc
      }
      acc))

; ------------------------------------------------------------------
; The expression walk. checkExpr answers the expression's TYPE and
; pushes diagnostics in stage0's traversal order. `inHead` is true
; only while checking the function side of an application - the flag
; that lets a bare multi-parameter function name pass in head
; position (AX3013 elsewhere) and confines the saturation check to
; each spine's ROOT.
; ------------------------------------------------------------------
(pub :: checkExpr (-> Int Int Int))
(pub fn (checkExpr tc e)
  (checkExprH tc e 0))

(pub :: checkExprH (-> Int Int Int Int))
(pub fn (checkExprH tc e inHead)
  (if (== e 0)
      mkUnitTy
      (let ((tag (nodeTag e)))
        (if (== tag TAG_E_INT) mkIntTy
        (if (== tag TAG_E_FLT) mkFloatTy
        (if (== tag TAG_E_CHAR) mkCharTy
        (if (== tag TAG_E_STR) mkStringTy
        (if (== tag TAG_E_VAR)
            (checkVar tc e inHead)
        (if (== tag TAG_E_APP)
            (checkApp tc e inHead)
        (if (== tag TAG_E_LAM)
            (checkLam tc e)
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
            (let ((initTy (checkExprH tc (nodeB e) 0)))
              (let ((mark (vecLen (tcScope tc))))
                {
                  (pushScope (tcScope tc) (nodeA e)
                             (if (== tag TAG_E_LETM) 1 0)
                             (nodeSpan e) initTy)
                  (let ((bodyTy (checkExprH tc (nodeC e) 0)))
                    {
                      (scopeTrunc (tcScope tc) mark)
                      bodyTy
                    })
                }))
        (if (== tag TAG_E_IF)
            (checkIf tc e)
        (if (== tag TAG_E_COND)
            (checkCond tc e)
        (if (== tag TAG_E_BEGIN)
            (checkExprSeq tc (nodeA e) 0 mkUnitTy)
        (if (== tag TAG_E_MATCH)
            (checkMatch tc e)
        (if (== tag TAG_E_WHILE)
            {
              (checkCondBool tc (nodeA e))
              (checkExprSeq tc (nodeB e) 0 mkUnitTy)
              mkIntTy
            }
        (if (== tag TAG_E_SET)
            (checkSet tc e)
        (if (== tag TAG_E_SETF)
            (checkSetField tc e)
        (if (== tag TAG_E_FIELD)
            (checkField tc e)
        (if (== tag TAG_E_HANDLE)
            (checkHandle tc e)
        (if (== tag TAG_E_STRUCTCON)
            (checkStructConNode tc e)
        ; `(alloc Type [count])` types `*mut Type` and evaluates
        ; nothing - stage0's IR generator has no case for it. The
        ; count, when present, is still an expression stage0 walks,
        ; so a diagnostic inside it is reported.
        (if (== tag TAG_E_ALLOC)
            {
              (if (!= (nodeB e) 0) (checkExprH tc (nodeB e) 0) 0)
              (mkTPtr (nodeA e) 1)
            }
        mkSilentWild))))))))))))))))))))))

(pub :: checkExprSeq (-> Int Int Int Int Int))
(pub fn (checkExprSeq tc v i last)
  (if (>= i (vecLen v))
      last
      (let ((t (checkExprH tc (vecGet v i) 0)))
        (checkExprSeq tc v (+ i 1) t))))

; A condition must be Bool. Skipped when the condition is already
; poisoned; a wildcard passes through tyCompat.
(pub :: checkCondBool (-> Int Int Int))
(pub fn (checkCondBool tc cnd)
  (let ((cty (checkExprH tc cnd 0)))
    {
      (if (&& (== (tyIsErr cty) 0)
              (== (tyCompat cty mkBoolTy) 0))
          (emitMismatch tc "Bool" (tyRender cty) (spanOf cnd))
          0)
      cty
    }))

(pub :: checkIf (-> Int Int Int))
(pub fn (checkIf tc e)
  {
    (checkCondBool tc (nodeA e))
    (let ((thenTy (checkExprH tc (nodeB e) 0)))
      (let ((elseTy (checkExprH tc (nodeC e) 0)))
        {
          ; Branches must agree; the report anchors at the ELSE with
          ; the then-branch as the expectation - stage0's shape.
          (if (&& (== (tyIsErr thenTy) 0)
                  (&& (== (tyIsErr elseTy) 0)
                      (== (tyCompat thenTy elseTy) 0)))
              (emitMismatch tc (tyRender thenTy) (tyRender elseTy)
                            (spanOf (nodeC e)))
              0)
          (if (== (tyIsErr thenTy) 1) elseTy thenTy)
        }))
  })

; `cond`: every clause's test must be Bool; clause bodies are NEVER
; joined against each other; only a real `else` is compared, against
; the LAST clause's type; the result is the last clause's type -
; stage0's ECond, probed.
(pub :: checkCond (-> Int Int Int))
(pub fn (checkCond tc e)
  (let ((resTy (checkCondClauses tc (nodeA e) 0 (freshTVar tc 0))))
    (if (== (nodeB e) 0)
        resTy
        (let ((elseTy (checkExprH tc (nodeB e) 0)))
          {
            (if (&& (== (tyIsErr resTy) 0)
                    (&& (== (tyIsErr elseTy) 0)
                        (== (tyCompat resTy elseTy) 0)))
                (emitMismatch tc (tyRender resTy) (tyRender elseTy)
                              (spanOf (nodeB e)))
                0)
            resTy
          }))))

(pub :: checkCondClauses (-> Int Int Int Int Int))
(pub fn (checkCondClauses tc clauses i resTy)
  (if (>= i (vecLen clauses))
      resTy
      (let ((cl (vecGet clauses i)))
        {
          (checkCondBool tc (nodeA cl))
          (checkCondClauses tc clauses (+ i 1)
                            (checkExprH tc (nodeB cl) 0))
        })))

(pub :: checkLam (-> Int Int Int))
(pub fn (checkLam tc e)
  (let ((params (nodeA e))
        (mark (vecLen (tcScope tc)))
        (ptys vecNew))
    {
      ; A lambda with no parameters can never be called, so it is
      ; refused rather than built. `(f)` and `f` are the SAME
      ; expression - a one-element list is its head - which is how a
      ; bare reference to a nullary top-level `fn` calls it, and it
      ; leaves no syntax that applies a nullary closure. Before this it
      ; was accepted, lifted, and evaluated to the closure record's
      ; ADDRESS: `(let ((f (lambda () 42))) (f))` answered 16, at exit
      ; 0, and `((lambda () 42))` the same.
      (if (== (vecLen params) 0)
          (emitDiag tc
            (diagSetLabel
              (mkDiagNote SEV_ERROR "AX3008" "semantic-error"
                          (nodeSpan e)
                          "a lambda with no parameters can never be called"
                          0 0
                          "give it a parameter, or write a top-level `(fn (name) body)` - a bare reference to a nullary function does call it"
                          "`(f)` and `f` are the same expression, so no syntax applies a nullary closure; it used to evaluate to the closure record's address")
              "this lambda takes no parameters"))
          0)
      (bindLamParams tc params ptys 0)
      (let ((bodyTy (checkExprH tc (nodeB e) 0)))
        {
          (scopeTrunc (tcScope tc) mark)
          (if (== (vecLen ptys) 0)
              (mkTArr mkUnitTy bodyTy)
              (if (== (vecLen ptys) 1)
                  (mkTArr (vecGet ptys 0) bodyTy)
                  (mkTArr (mkTTup ptys) bodyTy)))
        })
    }))

(pub :: bindLamParams (-> Int Int Int Int Int))
(pub fn (bindLamParams tc params ptys i)
  (if (>= i (vecLen params))
      0
      (let ((t (freshTVar tc 1)))
        {
          (vecPush ptys t)
          (pushScope (tcScope tc) (vecGet params i) 0 0 t)
          (bindLamParams tc params ptys (+ i 1))
        })))

; ------------------------------------------------------------------
; Variable references, in stage0's check_var order. Frame-local wins
; silently. In VALUE position (not an application head), a name that
; cannot be a value is refused: an effect operation goes quiet with
; poison (stage0 emits AX3017 there and poisons; the poison is the
; part that keeps later bytes identical), a function of two or more
; parameters is AX3013 with 0 supplied, a fieldful constructor is
; AX3009 with 0 found (the LAST declaration of the name - rfind,
; stage0's order). Then the function table, then constructors, then
; the always-in-scope names, then AX3001.
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; AX3014: a bare name two or more IMPORTED modules define, with no
; entry-file definition to win. Refused in every position, head or
; value; `Mod::name` picks explicitly.
;
; A DEFINER is a `fn` or an effect operation - a bare
; signature neither creates ambiguity nor outranks a real definer -
; plus a data constructor, because candidates are the union across
; BOTH namespaces: a function in one module and a constructor of the
; same name in another are exactly as unresolvable as two functions.
;
; A module-less definition wins outright, and that covers builtins as
; well as the entry file: `Option`'s `None`/`Some` and the operators
; are registered directly into the tables and never pass through a
; declaration list, so without the check two imports defining a
; `None` constructor would make the BUILTIN spelling ambiguous.
(pub :: checkAmbiguous (-> Int String Int Int))
(pub fn (checkAmbiguous tc name span)
  (let ((mods (definingModules tc (bareOf name))))
    ; A QUALIFIED reference names one module, so it cannot be
    ; ambiguous - it is the escape this diagnostic's own help text
    ; tells the reader to write. The check asked `bareOf name`, which
    ; strips the qualifier that answers the question, so `AmbA::dup`
    ; reported `ambiguous name \`dup\`` and helpfully suggested
    ; writing `AmbA::dup`. The documented escape from the flat
    ; namespace did not work, which is why 149 imports still carry no
    ; name list and two `fmtInt`/`die` pairs are still duplicated by
    ; hand.
    (if (!= (modOf name) 0)
        0
    (if (< (vecLen mods) 2)
        0
        (if (== span 0)
            0
            {
              (emitDiag tc
                (diagSetLabel (mkDiag SEV_ERROR "AX3014" "ambiguous-name"
                        span
                        (strConcat (strConcat (strConcat (strConcat
                          "ambiguous name `" (bareOf name))
                          "`: defined in ") (joinModules mods 0 "")) "")
                        0 0
                        (strConcat "qualify the reference: "
                                   (joinQualified mods (bareOf name) 0 "")))
                  (strConcat (strConcat "`" (bareOf name)) "` could mean more than one definition")))
              1
            })))))

; The distinct modules defining `n`, in declaration order - or an
; empty Vec when anything module-less defines it.
; Built ONCE, at collection, instead of scanning every declaration at
; every reference. The scan was linear in the declaration list and
; the list is the whole program, so once the walk covered imported
; modules too it went quadratic and stage1 stopped terminating on any
; stdlib-sized input. stage0 keeps a map for the same reason.
(pub :: definingModules (-> Int String Int))
(pub fn (definingModules tc n)
  (let ((e (ambFind tc n)))
    (if (== e 0)
        vecNew
        (if (== (memGetWord e 2) 1) vecNew (memGetWord e 1)))))

(pub struct AmbEnt (name : Int) (mods : Int) (moduleless : Int))

; Buckets over the entries, keyed on the name. An entry is MUTATED
; after insert - a module appended to its list, or its module-less
; flag set - but its NAME never changes, which is the same
; precondition the exact-name index over `tcFns` records and relies
; on.
(pub :: ambIdxNew (-> Int Int))
(pub fn (ambIdxNew hint)
  (let ((nb (fnIdxBuckets hint)) (bs vecNew) (mut i 0))
    { (while (< i nb) { (vecPush bs 0) (set i (+ i 1)) }) bs }))

(pub :: ambFind (-> Int String Int))
(pub fn (ambFind tc n)
  (let ((bs (memGetWord tc 21)))
    (if (== bs 0)
        0
        (let ((v (vecGet bs (% (fnIdxHash n) (vecLen bs)))))
          (if (== v 0) 0 (ambFindIn v n 0))))))

(pub :: ambFindIn (-> Int String Int Int))
(pub fn (ambFindIn v n i)
  (if (>= i (vecLen v))
      0
      (if (strEq (memGetWord (vecGet v i) 0) n)
          (vecGet v i)
          (ambFindIn v n (+ i 1)))))

(pub :: ambRecord (-> Int String String Int))
(pub fn (ambRecord tc n m)
  (let ((e (ambFind tc n)))
    (if (== e 0)
        (let ((ent (cast Int (AmbEnt n
                               (let ((v vecNew))
                                 { (if (!= m 0) (vecPush v m) 0) v })
                               (if (== m 0) 1 0)))))
          {
            ; Both, in step: the Vec is what `symbols` and every other
            ; reader walks, the buckets are what `ambFind` reads.
            (vecPush (memGetWord tc 15) ent)
            (ambIdxPut (memGetWord tc 21) n ent)
            0
          })
        (if (== m 0)
            (memSetWord e 2 1)
            (if (== (strInVec (memGetWord e 1) m 0) 1)
                0
                { (vecPush (memGetWord e 1) m) 0 })))))

(pub :: ambIdxPut (-> Int String Int Int))
(pub fn (ambIdxPut bs n ent)
  (let ((b (% (fnIdxHash n) (vecLen bs))))
    (if (== (vecGet bs b) 0)
        (let ((v vecNew)) { (vecPush v ent) (vecSet bs b v) 0 })
        { (vecPush (vecGet bs b) ent) 0 })))

; One pass over the merged list, recording every DEFINER's module.
(pub :: ambBuild (-> Int Int Int Int))
(pub fn (ambBuild tc decls i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        {
          (ambBuildDecl tc d)
          (ambBuild tc decls (+ i 1))
        })))

; A declaration nobody outside its module may name cannot make a bare
; reference ambiguous, so it is not recorded. Without this a module's
; private helper would collide with an unrelated public name in
; another module and report AX3014 about two definitions, only one of
; which the reference could ever have reached.
(pub :: ambBuildDecl (-> Int Int Int))
(pub fn (ambBuildDecl tc d)
  (if (== (nodeVis d) 0)
      0
  (let ((tag (nodeTag d))
        (m (nodeModule d)))
    (if (== tag TAG_D_FN)
        (ambRecord tc (bareOf (nodeA d)) m)
    (if (== tag TAG_D_EFFECT)
        (ambRecordAll tc (nodeB d) 0 m)
    (if (== tag TAG_D_DATA)
        (ambRecordCtors tc (nodeB d) 0 m)
    0))))))

(pub :: ambRecordAll (-> Int Int Int String Int))
(pub fn (ambRecordAll tc v i m)
  (if (>= i (vecLen v))
      0
      { (ambRecord tc (vecGet v i) m) (ambRecordAll tc v (+ i 1) m) }))

(pub :: ambRecordCtors (-> Int Int Int String Int))
(pub fn (ambRecordCtors tc ctors i m)
  (if (>= i (vecLen ctors))
      0
      {
        (ambRecord tc (bareOf (nodeA (vecGet ctors i))) m)
        (ambRecordCtors tc ctors (+ i 1) m)
      }))

(pub :: tcAllDecls (-> Int Int)) (pub fn (tcAllDecls tc) (memGetWord tc 10))

; Every diagnostic records which source file its spans index. Stamped
; here rather than at the ~30 construction sites, so a new check
; cannot forget to do it.
; The unit a declaration's spans index: 0 (the entry file) when it
; carries no module stamp, else that module's entry.
(pub :: unitIndexFor (-> Int String Int))
(pub fn (unitIndexFor units m)
  (if (== m 0) 0 (unitIndexForFrom units m 0)))

(pub :: unitIndexForFrom (-> Int String Int Int))
(pub fn (unitIndexForFrom units m i)
  (if (>= i (vecLen units))
      0
      (if (== (memGetWord (vecGet units i) 2) 0)
          (unitIndexForFrom units m (+ i 1))
          (if (strEq (memGetWord (vecGet units i) 2) m)
              i
              (unitIndexForFrom units m (+ i 1))))))

(pub :: emitDiag (-> Int Int Int))
(pub fn (emitDiag tc d)
  { (diagSetUnit d (memGetWord tc 14)) (vecPush (tcOut tc) d) })

; A constructor of a data type that came from no module - the builtin
; `Option`, whose entries are registered directly.
(pub :: builtinCtorNamed (-> Int String Int))
(pub fn (builtinCtorNamed tc n)
  (if (|| (strEq n "None") (strEq n "Some")) 1 0))

; Does this declaration DEFINE `n`? Signatures do not.
(pub :: declDefines (-> Int String Int))
(pub fn (declDefines d n)
  (let ((tag (nodeTag d)))
    (if (== tag TAG_D_FN)
        (if (strEq (bareOf (nodeA d)) n) 1 0)
    (if (== tag TAG_D_EFFECT)
        (strInVec (nodeB d) n 0)
    (if (== tag TAG_D_DATA)
        (ctorNamedIn (nodeB d) n 0)
    0)))))

(pub :: ctorNamedIn (-> Int String Int Int))
(pub fn (ctorNamedIn ctors n i)
  (if (>= i (vecLen ctors))
      0
      (if (strEq (bareOf (nodeA (vecGet ctors i))) n)
          1
          (ctorNamedIn ctors n (+ i 1)))))

(pub :: joinModules (-> Int Int String Int))
(pub fn (joinModules v i acc)
  (if (>= i (vecLen v))
      acc
      (joinModules v (+ i 1)
        (if (== i 0)
            (vecGet v i)
            (strConcat (strConcat acc ", ") (vecGet v i))))))

(pub :: joinQualified (-> Int String Int String Int))
(pub fn (joinQualified v n i acc)
  (if (>= i (vecLen v))
      acc
      (joinQualified v n (+ i 1)
        (let ((one (strConcat (strConcat (strConcat "`" (vecGet v i)) "::") 
                              (strConcat n "`"))))
          (if (== i 0) one (strConcat (strConcat acc " or ") one))))))

(pub :: checkVar (-> Int Int Int Int))
(pub fn (checkVar tc e inHead)
  (let ((name (nodeA e)))
    (if (|| (strEq name "true") (strEq name "false"))
        mkBoolTy
        (let ((fr (scopeFindFrame tc name)))
          (if (!= fr 0)
              (sEntTy fr)
            (if (== (checkAmbiguous tc name (nodeSpan e)) 1)
                (mkNode TAG_T_ERR 0 0 0)
              (let ((refused (if (== inHead 0)
                                 (checkBareValue tc name (nodeSpan e))
                                 0)))
                (if (== refused 1)
                    (mkNode TAG_T_ERR 0 0 0)
                    (let ((ent (findFnEnt tc name)))
                      (if (!= ent 0)
                          ; INSTANTIATED. A signature's type variables
                          ; are rigid where the body reads them and
                          ; fresh where a caller does; this is the
                          ; only place a declaration's type becomes a
                          ; reference's type, so it is the only place
                          ; that distinction has to be made.
                          (tyInst tc (memGetWord ent 1))
                          (let ((ctor (findCtor tc name)))
                            (if (!= ctor 0)
                                (tyInst tc (memGetWord ctor 3))
                                ; A trait method is always in scope and
                                ; is never a top-level function:
                                ; dispatch rewrites a CALL to a concrete
                                ; implementation, and a reference that
                                ; reaches here is one dispatch could not
                                ; resolve - already reported as AX3025,
                                ; so going quiet stops a second and
                                ; wrong AX3001 on top of it. Registering
                                ; these in `tcFns` instead made
                                ; `symbols` print them as positionless
                                ; functions with no type.
                                (if (|| (== (isBuiltinName name) 1)
                                        (|| (== (isMacroName tc name) 1)
                                            (|| (== (isEffectName tc name) 1)
                                                (!= (findTraitOwning (tcTraits tc) name 0) 0))))
                                    mkSilentWild
                                    (emitUndefinedVar tc name (nodeSpan e)))))))))))))))

; The bare-value refusals. Answers 1 when the reference was refused
; (poison the expression), 0 to continue resolving.
(pub :: checkBareValue (-> Int String Int Int))
(pub fn (checkBareValue tc name span)
  (let ((ent (findFnEnt tc name)))
    (if (!= ent 0)
        (if (== (memGetWord ent 4) 1)
            ; An effect operation cannot be a bare value: it is
            ; dispatch, not data, so there is no closure to hand
            ; around. stage0 refuses with AX3017 and returns poison,
            ; and the poison is load-bearing independently of the
            ; message - without it the wildcard type would let a later
            ; check fire where stage0 is silent.
            {
              (if (== span 0)
                  0
                  (emitDiag tc
                    (mkDiag SEV_ERROR "AX3017" "effect-handler-unsupported"
                            span
                            (strConcat (strConcat (strConcat (strConcat (strConcat
                              "effect operation `" (bareOf name))
                              "` cannot be used as a bare value; call it, or wrap it: `(lambda (x) (")
                              (bareOf name)) " x))`") "")
                            0 0 0)))
              1
            }
            (let ((ar (repArity ent)))
              (if (>= ar 2)
                  (if (== span 0)
                      1
                      {
                        (emitDiag tc
                          (diagSetLabel (mkDiagNote SEV_ERROR "AX3013" "partial-application"
                                  span
                                  (strConcat (strConcat (strConcat (strConcat
                                    "partial application of `" name)
                                    "`: it takes ") (decStr ar))
                                    " argument(s) and 0 were supplied")
                                  0 0
                                  "bind the missing arguments with a lambda: `(lambda (y) (f x y))` builds the value `(f x)` would mean"
                                  "a partial application has to hold the arguments it was not given, and a top-level function has no closure record to hold them in")
                            (strConcat (strConcat (strConcat (strConcat "`" name) "` takes ") (decStr ar)) " arguments, so it cannot be used as a bare value")))
                        1
                      })
                  0)))
        (let ((ctor (rfindCtor tc name)))
          (if (== ctor 0)
              0
              (let ((fc (vecLen (memGetWord ctor 1))))
                (if (== fc 0)
                    0
                    (if (== span 0)
                        1
                        {
                          (emitDiag tc
                            (diagSetLabel (mkDiag SEV_ERROR "AX3009" "constructor-arity-mismatch"
                                    span
                                    (strConcat (strConcat (strConcat (strConcat (strConcat
                                      "constructor `" name)
                                      "` expects ") (decStr fc))
                                      " argument(s), found ") "0")
                                    0 0
                                    (strConcat (strConcat "this constructor takes exactly "
                                      (decStr fc))
                                      " field(s); add or remove arguments to match"))
                              "0 argument(s) provided here"))
                          1
                        }))))))))

; A name that IS defined, in a module that does not export it, is a
; different mistake from a name that is defined nowhere, and it used
; to be impossible to make: privacy was enforced by dropping the
; declaration, so the reference and the module's own calls failed
; together and the message was right about both by accident. Now the
; declaration is there and only the reference is refused, so the
; reference gets told why.
;
; The suggestion machinery is skipped for this branch on purpose -
; "did you mean `helper`?" about the very name that was written is
; noise.
(pub :: emitPrivateVar (-> Int String Int String Int))
(pub fn (emitPrivateVar tc name span declName)
  {
    (if (!= span 0)
        (emitDiag tc
          (diagSetLabel
            (mkDiag SEV_ERROR "AX3023" "private-name"
                    span
                    (strConcat (strConcat (strConcat (strConcat
                      "`" (srcSpelling name))
                      "` is private to module `") (modOf declName)) "`")
                    0 0
                    "a name leaves its module when its declaration is written `pub`; if the import that brought the module in carries a name list, the name has to appear there too")
            (strConcat (strConcat "`" (bareOf declName)) "` is not exported by its module")))
        0)
    (mkNode TAG_T_ERR 0 0 0)
  })

(pub :: emitUndefinedVar (-> Int String Int Int))
(pub fn (emitUndefinedVar tc name span)
  (let ((hidden (if (== (memGetWord tc 19) 0) 0 (findFnEntAnywhere tc name))))
    (if (&& (!= hidden 0)
            (== (strInVec (memGetWord tc 19) (memGetWord hidden 0) 0) 1))
        (emitPrivateVar tc name span (memGetWord hidden 0))
        (if (== (isMacroAnywhere tc name) 1)
            (emitPrivateVar tc name span
                            (privKey (macroModuleOf (tcMacros tc) name 0) name))
            (let ((cm (ctorHiddenModule tc name)))
              (if (!= cm 0)
                  (emitPrivateVar tc name span (privKey cm name))
                  (emitUndefinedVarPlain tc name span)))))))

; The module of an INVISIBLE `data` declaring a constructor of this
; name, or 0. A private type's constructors are already refused - the
; lookup filters them - but as `AX3001`/`AX3003`, which say the name
; does not exist when it plainly does.
(pub :: ctorHiddenModule (-> Int String Int))
(pub fn (ctorHiddenModule tc name)
  (if (== (memGetWord tc 19) 0)
      0
      (ctorHiddenIn (tcDatas tc) (memGetWord tc 19) (memGetWord tc 16) name 0)))

(pub :: ctorHiddenIn (-> Int Int String String Int Int))
(pub fn (ctorHiddenIn datas privs curMod name i)
  (if (>= i (vecLen datas))
      0
      (let ((d (vecGet datas i)))
        (if (&& (== (privBlocks privs (privKey (memGetWord d 2) (memGetWord d 0)) curMod) 1)
                (!= (ctorInData (memGetWord d 1) (memGetWord d 2) name 0) 0))
            (memGetWord d 2)
            (ctorHiddenIn datas privs curMod name (+ i 1))))))

(pub :: macroModuleOf (-> Int String Int Int))
(pub fn (macroModuleOf ms n i)
  (if (>= i (vecLen ms))
      0
      (if (strEq (nodeA (vecGet ms i)) n)
          (nodeModule (vecGet ms i))
          (macroModuleOf ms n (+ i 1)))))

(pub :: emitUndefinedVarPlain (-> Int String Int Int))
(pub fn (emitUndefinedVarPlain tc name span)
  (let ((best (newBest)))
    {
      (offerScope best name (tcScope tc) 0)
      (offerFnEnts best name (tcFns tc) 0)
      (offerCtorEnts best name (tcDatas tc) 0)
      (if (!= span 0)
          (emitDiag tc
            (let ((msg (strConcat (strConcat "undefined variable `" (srcSpelling name)) "`")))
              (diagSetLabel (if (== (memGetWord best 0) 0)
                  (mkDiag SEV_ERROR "AX3001" "undefined-variable"
                          span msg 0 0
                          "variables must be defined (via `define`/`fn`, a `let` binding, or a lambda parameter) before they are used; check for typos")
                  (mkDiagFix SEV_ERROR "AX3001" "undefined-variable"
                             span msg 0 0
                             (strConcat (strConcat
                               "a similarly named binding `" (memGetWord best 0))
                               "` is in scope; did you mean this?")
                             span (memGetWord best 0)))
                (strConcat (strConcat "no binding named `" (srcSpelling name)) "` in scope"))))
          0)
      (mkNode TAG_T_ERR 0 0 0)
    }))

; ------------------------------------------------------------------
; Applications. At each spine's ROOT: the saturation check (AX3013 /
; AX3009 for under-application, with the refused spine's arguments
; still checked and the head left alone). At EVERY level - stage0
; does not gate these on the root: the numeric-operator intercept,
; the cast/sizeof/alignof forms (their first argument is a TYPE, not
; a variable reference), the macro-head skip, and struct
; construction. Then the general rule: an arrow consumes an argument
; (a mismatched argument reports and does NOT poison the result - a
; curried call reports every bad argument); poison propagates
; silently; a silent wildcard stays silent; anything else is
; "expected function type".
; ------------------------------------------------------------------
(pub :: checkApp (-> Int Int Int Int))
(pub fn (checkApp tc e inHead)
  (let ((head (spineHead e)))
    (let ((headIsVar (if (== (nodeTag head) TAG_E_VAR) 1 0)))
      ; Trait dispatch happens FIRST and by rewriting: if the head
      ; names a trait method and an implementation covers the dispatch
      ; argument's type, the head's name becomes that implementation's
      ; and everything below - saturation, argument checking, and
      ; later the emitter, which reads these same nodes - proceeds as
      ; for any ordinary call.
      ; Only at the spine ROOT (`inHead` 0). `checkApp` runs at every
      ; level of a curried spine and `spineHead` answers the same node
      ; each time, so dispatching at each level reported the same
      ; missing implementation once per argument.
      ;
      ; And only when nothing else claims the spelling - see
      ; `traitNameFree`. `checkSaturation`, twenty lines down, has
      ; asked `scopeFindFrame` first since it was written; this call
      ; was added later and asked nothing.
      (let ((_td (if (&& (== headIsVar 1)
                         (&& (== inHead 0)
                             (== (traitNameFree tc (nodeA head)) 1)))
                     (traitRewrite tc e head (nodeA head))
                     0)))
      (let ((hname (if (== headIsVar 1) (nodeA head) 0)))
        (if (&& (== inHead 0)
                (&& (== headIsVar 1)
                    (== (checkSaturation tc e head hname) 1)))
            (mkNode TAG_T_ERR 0 0 0)
        (if (&& (== headIsVar 1) (== (isNumericTwoArg tc e hname) 1))
            (checkNumeric tc hname (nodeB (nodeA e)) (nodeB e) head)
        (if (&& (== headIsVar 1) (== (isCastLike hname) 1))
            (checkCastForm tc e hname)
        (if (&& (== headIsVar 1) (== (isMacroName tc hname) 1))
            ; A macro call cannot be typed before expansion, and
            ; expansion lives in codegen. The arguments are still
            ; REAL expressions the expansion will splice, so they
            ; are checked as expressions; the spine structure is not.
            {
              (checkSpineArgsOnly tc e)
              mkSilentWild
            }
        (if (&& (== headIsVar 1)
                (!= (findStructIfConstruct tc e hname) 0))
            (checkStructCon tc e (findStructIfConstruct tc e hname))
        (let ((funcTy (checkExprH tc (nodeA e) 1)))
          (let ((argTy (checkExprH tc (nodeB e) 0)))
            (if (== (nodeTag funcTy) TAG_T_ARR)
                {
                  (if (== (tyCompat argTy (nodeA funcTy)) 0)
                      (emitMismatch tc (tyRender (nodeA funcTy))
                                    (tyRender argTy) (spanOf (nodeB e)))
                      0)
                  (nodeB funcTy)
                }
                (if (== (tyIsErr funcTy) 1)
                    funcTy
                    (if (== (tyIsSilentWild funcTy) 1)
                        mkSilentWild
                        {
                          (emitMismatch tc "function type" (tyRender funcTy)
                                        (spanOf e))
                          (mkNode TAG_T_ERR 0 0 0)
                        })))))))))))))))

; Rewrite a trait-method call to the implementation its dispatch
; argument selects. Answers 0 always; it works by mutating the head
; node, which the emitter reads later from the same tree.
;
; No implementation is a DIAGNOSTIC rather than silence, and the
; method name stays registered as a wildcard so the caller does not
; also collect an `AX3001` about a name that plainly exists.
(pub :: traitRewrite (-> Int Int Int String Int))
(pub fn (traitRewrite tc e head hname)
  (let ((tr (findTraitOwning (tcTraits tc) hname 0)))
    (if (== tr 0)
        0
        (let ((v (traitTyvar tr))
              (decl (findFieldNamed (nodeB tr) hname 0)))
          (if (|| (== (strLen v) 0) (== decl 0))
              0
              (let ((di (traitDispatchIdx (nodeB decl) v 0)))
                (if (< di 0)
                    (traitDiag tc (spanOf e)
                      (strConcat (strConcat (strConcat (strConcat
                        "cannot tell which implementation of `" (nodeA tr))
                        "` `") hname)
                        "` means: no parameter of it has the trait's own type")
                      "give the method a parameter of the trait's type; there is no return-type-directed dispatch"
                      "an implementation is selected by the type of an argument")
                    (let ((args (spineArgVec e vecNew)))
                      (if (<= (vecLen args) di)
                          0
                          (let ((at (checkExprH tc (vecGet args di) 0)))
                            (let ((tn (tyHeadName at)))
                              (if (== (strLen tn) 0)
                                  0
                                  (let ((full (traitImplName (nodeA tr) tn hname)))
                                    (if (!= (fnEntExact tc full) 0)
                                        { (memSetWord head 1 full) 0 }
                                        (traitDiag tc (spanOf (vecGet args di))
                                          (strConcat (strConcat (strConcat (strConcat
                                            "no implementation of `" (nodeA tr))
                                            "` for `") tn) "`")
                                          "write `(impl (Trait Type) where ((method ...)))` for it"
                                          "a trait method is dispatched on the type of its argument, and this type has no implementation")))))))))))))))

; Is `name` still the trait's to claim at this call site?
;
; Dispatch rewrites the head node to an implementation's mangled name,
; so it is name RESOLUTION and has to obey the same order as every
; other resolution in this file: a frame-local binding first, then a
; declaration. Asking neither made a trait method's spelling globally
; unavailable - it captured `let` bindings, lambda and function
; parameters, top-level functions and imported standard-library
; functions alike, and the implementation won every one of them at
; exit 0. `(let ((sz (lambda (q) 7))) (sz 5))` answered 111.
;
; The two questions are the two ways a name can already be taken:
;   - `scopeFindFrame`, a parameter or a `let` binding, which shadows;
;   - `findFnEnt`, a real declaration of that name. A trait method is
;     never itself in `tcFns` (an `impl` lowers to `Trait#Type#method`,
;     and `checkVar`'s trait arm exists precisely because the bare
;     name resolves to nothing), so a hit here is always something
;     else. In the entry file that collision is now `AX3006`; across
;     modules the concrete definition simply wins, which is what makes
;     `(import Str)` beside a trait method named `strLen` a working
;     program again instead of `AX3025`.
(pub :: traitNameFree (-> Int String Int))
(pub fn (traitNameFree tc name)
  (if (!= (scopeFindFrame tc name) 0)
      0
      (if (!= (findFnEnt tc name) 0)
          0
          1)))

(pub :: findTraitOwning (-> Int String Int Int))
(pub fn (findTraitOwning trs name i)
  (if (>= i (vecLen trs))
      0
      (if (!= (findFieldNamed (nodeB (vecGet trs i)) name 0) 0)
          (vecGet trs i)
          (findTraitOwning trs name (+ i 1)))))

(pub :: traitDiag (-> Int Int Int Int Int Int))
(pub fn (traitDiag tc sp msg help note)
  {
    (emitDiag tc
      (diagSetLabel
        (mkDiagNote SEV_ERROR "AX3025" "trait-impl" sp msg 0 0 help note)
        "no implementation selected"))
    0
  })

; Exactly `(op l r)` with a bare operator head - stage0's
; numeric_builtin_app is purely syntactic; no shadow check exists.
(pub :: isNumericTwoArg (-> Int Int String Int))
(pub fn (isNumericTwoArg tc e name)
  (if (!= (nodeTag (nodeA e)) TAG_E_APP)
      0
      (if (!= (nodeTag (nodeA (nodeA e))) TAG_E_VAR)
          0
          (if (== (isNumOp name) 0)
              0
              1))))

(pub :: isNumOp (-> String Int))
(pub fn (isNumOp n)
  (if (strEq n "+") 1 (if (strEq n "-") 1 (if (strEq n "*") 1
  (if (strEq n "/") 1 (if (strEq n "==") 1 (if (strEq n "!=") 1
  (if (strEq n "<") 1 (if (strEq n ">") 1 (if (strEq n "<=") 1
  (if (strEq n ">=") 1 0)))))))))))

(pub :: isNumCmpOp (-> String Int))
(pub fn (isNumCmpOp n)
  (if (strEq n "==") 1 (if (strEq n "!=") 1 (if (strEq n "<") 1
  (if (strEq n ">") 1 (if (strEq n "<=") 1 (if (strEq n ">=") 1
  0)))))))

; The numeric matrix, stage0's check_numeric_builtin: operands first
; (left then right, both always), poison silences everything (a
; comparison still answers Bool; arithmetic answers poison), a float
; on EITHER side selects the float path where every non-float operand
; must be compatible with Float, otherwise both operands must be
; compatible with Int - which a String is, by the fiat rule.
;
; `head` is the spine node whose word 1 is the operator's own
; identifier, and it is here for one job: `==` and `!=` over two
; `String`s are rewritten in place into `__streq`/`__strne`, so the
; emitter compares CONTENT rather than the two handles. See
; `equalityIsStringly` for when that fires and why it cannot fire on an
; ordinary `Int`.
(pub :: checkNumeric (-> Int String Int Int Int Int))
(pub fn (checkNumeric tc op l r head)
  (let ((lt (checkExprH tc l 0)))
    (let ((rt (checkExprH tc r 0)))
      {
      ; Word 1 of the head VAR node is the operator's name. Writing
      ; `(nodeA head)` instead - the name STRING itself - corrupts the
      ; interned `"=="`, and the symptom is a comparison that stops
      ; answering `Bool` several checks later.
      (if (== (equalityIsStringly op lt rt) 1)
          (memSetWord head 1 (if (strEq op "==") "__streq" "__strne"))
          0)
      (if (|| (== (tyIsErr lt) 1) (== (tyIsErr rt) 1))
          (if (== (isNumCmpOp op) 1) mkBoolTy (mkNode TAG_T_ERR 0 0 0))
          (if (|| (== (tyIsFloatTy lt) 1) (== (tyIsFloatTy rt) 1))
              {
                (if (&& (== (tyIsFloatTy lt) 0)
                        (== (tyCompat lt mkFloatTy) 0))
                    (emitMismatch tc "Float" (tyRender lt) (spanOf l))
                    0)
                (if (&& (== (tyIsFloatTy rt) 0)
                        (== (tyCompat rt mkFloatTy) 0))
                    (emitMismatch tc "Float" (tyRender rt) (spanOf r))
                    0)
                (if (== (isNumCmpOp op) 1) mkBoolTy mkFloatTy)
              }
              {
                (if (== (tyCompat lt mkIntTy) 0)
                    (emitMismatch tc "Int" (tyRender lt) (spanOf l))
                    0)
                (if (== (tyCompat rt mkIntTy) 0)
                    (emitMismatch tc "Int" (tyRender rt) (spanOf r))
                    0)
                (if (== (isNumCmpOp op) 1) mkBoolTy mkIntTy)
              }))
      })))

; Does this comparison compare two STRINGS?
;
; All three conditions are load-bearing:
;
;   - the operator is `==` or `!=`. The orderings are left alone: `<`
;     on two strings would have to mean `strCmp`, a bigger decision
;     than fixing equality, and an address ordering is at least not a
;     WRONG answer to a question anyone asks.
;   - BOTH sides are exactly `String` (`tyIsStringTy`, not `tyCompat`).
;     One side a string and the other an `Int` is exactly the shape the
;     fiat permits and nothing can distinguish, so it keeps the old
;     integer comparison rather than dereferencing a number.
;   - poison is excluded by the caller's own test, which runs after
;     this one only because a poisoned operand must not rewrite the
;     node and then be reported as a type error about it.
;
; The consequence worth stating: under the fiat most string-valued
; expressions are typed `Int`, so this fires where the author WROTE the
; types down and not otherwise. That is the same bargain `fadd` makes,
; and it is an argument for removing the fiat rather than against
; fixing equality.
(pub :: equalityIsStringly (-> String Int Int Int))
(pub fn (equalityIsStringly op lt rt)
  (if (&& (|| (strEq op "==") (strEq op "!="))
          (&& (== (tyIsStringTy lt) 1) (== (tyIsStringTy rt) 1)))
      1
      0))

; `(cast Type v)`, `(sizeof Type)`, `(alignof Type)`: argument zero is
; a TYPE, and a type name is not a variable reference - checking it
; drew AX3001 `Int` on the compiler's own source, in three files. The
; remaining arguments are ordinary expressions. A cast's result is
; the named type; sizeof/alignof answer Int.
(pub :: checkCastForm (-> Int Int String Int))
(pub fn (checkCastForm tc e hname)
  (let ((args (spineArgVec e vecNew)))
    {
      (checkArgsFromIndex tc args 1)
      ; `sizeof` and `alignof` take one TYPE and answer a constant, so
      ; a surplus argument has nowhere to go: the emitter dropped it in
      ; silence and `(sizeof Int 99)` answered 8. `cast` is exempt -
      ; its result is routinely a function value, and a surplus
      ; argument there is an application of it.
      (if (&& (if (strEq hname "cast") false true)
              (> (vecLen args) 1))
          (emitDiag tc
            (diagSetLabel
              (mkDiagNote SEV_ERROR "AX3008" "semantic-error"
                          (spanOf (vecGet args 1))
                          (strConcat (strConcat "`" hname)
                                     "` takes one type and answers a constant, so this argument has nowhere to go")
                          0 0
                          "remove the extra argument"
                          "it used to be discarded in silence")
              "extra argument"))
          0)
      (if (strEq hname "cast")
          (if (>= (vecLen args) 1)
              (exprToType (vecGet args 0))
              mkSilentWild)
          mkIntTy)
    }))

(pub :: checkArgsFromIndex (-> Int Int Int Int))
(pub fn (checkArgsFromIndex tc args i)
  (if (>= i (vecLen args))
      0
      {
        (checkExprH tc (vecGet args i) 0)
        (checkArgsFromIndex tc args (+ i 1))
      }))

; A type spelled in expression position (cast's first argument),
; converted by the type grammar's atom rules. Unconvertible shapes
; answer the silent wildcard.
(pub :: exprToType (-> Int Int))
(pub fn (exprToType e)
  (if (== e 0)
      mkSilentWild
      (if (== (nodeTag e) TAG_E_VAR)
          (typeNameToType (nodeA e))
          (if (== (nodeTag e) TAG_E_APP)
              (let ((head (spineHead e)))
                (if (!= (nodeTag head) TAG_E_VAR)
                    mkSilentWild
                    (let ((args (spineArgVec e vecNew))
                          (tys vecNew))
                      {
                        (exprsToTypes args tys 0)
                        (if (strEq (nodeA head) "*")
                            (if (== (vecLen tys) 1)
                                (mkTPtr (vecGet tys 0) 0)
                                mkSilentWild)
                            (mkTCon (nodeA head) tys))
                      })))
              mkSilentWild))))

(pub :: exprsToTypes (-> Int Int Int Int))
(pub fn (exprsToTypes args acc i)
  (if (>= i (vecLen args))
      0
      {
        (vecPush acc (exprToType (vecGet args i)))
        (exprsToTypes args acc (+ i 1))
      }))

(pub :: typeNameToType (-> String Int))
(pub fn (typeNameToType n)
  (let ((canon (typeKeywordCanon n)))
    (if (!= canon 0)
        (mkTCon canon vecNew)
        (if (== (lexStartsLower n) 1)
            (mkTVar n)
            (mkTCon n vecNew)))))

; Saturation, once per spine at its root. A frame-local head is a
; function VALUE applied stepwise - not measurable. A resolved
; function with a measurable arity refuses under-application
; (AX3013); when no function matches, the LAST constructor of the
; name refuses through its arrow depth (AX3009). A refused spine's
; arguments are still checked, left to right; the head is not
; (reporting it again would double the diagnostic). Answers 1 when
; refused.
(pub :: checkSaturation (-> Int Int Int String Int))
(pub fn (checkSaturation tc e head hname)
  (if (!= (scopeFindFrame tc hname) 0)
      0
      (if (== (isCastLike hname) 1)
          0
          (if (== (isMacroName tc hname) 1)
              0
              (let ((ent (findFnEnt tc hname)))
                (if (!= ent 0)
                    (let ((ar (repArity ent))
                          (got (spineArgs e 0)))
                      (if (< ar 0)
                          0
                          (if (>= got ar)
                              0
                              (if (== (nodeSpan head) 0)
                                  0
                                  {
                                    (emitDiag tc
                                      (diagSetLabel (mkDiagNote SEV_ERROR "AX3013" "partial-application"
                                              (nodeSpan head)
                                              (strConcat (strConcat (strConcat (strConcat (strConcat
                                                "partial application of `" hname)
                                                "`: it takes ") (decStr ar))
                                                " argument(s) and ") (strConcat (decStr got) " were supplied"))
                                              0 0
                                              "bind the missing arguments with a lambda: `(lambda (y) (f x y))` builds the value `(f x)` would mean"
                                              "a partial application has to hold the arguments it was not given, and a top-level function has no closure record to hold them in")
                                        (strConcat (strConcat (strConcat (strConcat (strConcat "`" hname) "` takes ") (decStr ar)) " argument(s); ") (strConcat (decStr (- ar got)) " more needed"))))
                                    (checkSpineArgsOnly tc e)
                                    1
                                  }))))
                    (let ((ctor (rfindCtor tc hname)))
                      (if (== ctor 0)
                          0
                          (let ((want (arrowDepth (memGetWord ctor 3)))
                                (got (spineArgs e 0)))
                            (if (>= got want)
                                0
                                (if (== (nodeSpan head) 0)
                                    0
                                    {
                                      (emitDiag tc
                                        (diagSetLabel (mkDiag SEV_ERROR "AX3009" "constructor-arity-mismatch"
                                                (nodeSpan head)
                                                (strConcat (strConcat (strConcat (strConcat (strConcat
                                                  "constructor `" hname)
                                                  "` expects ") (decStr want))
                                                  " argument(s), found ") (decStr got))
                                                0 0
                                                (strConcat (strConcat "this constructor takes exactly "
                                                  (decStr want))
                                                  " field(s); add or remove arguments to match"))
                                          (strConcat (decStr got) " argument(s) provided here")))
                                      (checkSpineArgsOnly tc e)
                                      1
                                    })))))))))))

(pub :: checkSpineArgsOnly (-> Int Int Int))
(pub fn (checkSpineArgsOnly tc e)
  (let ((args (spineArgVec e vecNew)))
    (checkArgsFromIndex tc args 0)))

; Struct construction: the head names a struct (any module - stage0
; ignores the module here). Wrong field count is AX3008 with the
; ARGUMENTS UNCHECKED and a poisoned result; the right count checks
; every argument against its field's declared type, reporting each
; mismatch and keeping the struct type as the result.
(pub :: findStructIfConstruct (-> Int Int String Int))
(pub fn (findStructIfConstruct tc e hname)
  (findStruct tc hname))

(pub :: checkStructCon (-> Int Int Int Int))
(pub fn (checkStructCon tc e ent)
  (checkStructConAt tc (spineArgVec e vecNew) (spanOf e) ent))

; The shared half, reached from both construction spellings: the
; application form `(P 1 2)` above, and the keyword form
; `(struct P 1 2)` below. stage0 checks them through different AST
; nodes but with identical rules and identical message text, so one
; body serves both and the strings cannot drift apart.
(pub :: checkStructConAt (-> Int Int Int Int Int))
(pub fn (checkStructConAt tc args span ent)
  (let ((fields (memGetWord ent 1)))
    (if (!= (vecLen args) (vecLen fields))
        {
          (if (!= span 0)
              (emitDiag tc
                (let ((msg (strConcat (strConcat (strConcat (strConcat (strConcat
                             "struct `" (bareOf (memGetWord ent 0)))
                             "` expects ") (decStr (vecLen fields)))
                             " field(s), found ") (decStr (vecLen args)))))
                  (mkDiag SEV_ERROR "AX3008" "semantic-error"
                          span msg 0 0 0)))
              0)
          (mkNode TAG_T_ERR 0 0 0)
        }
        {
          (checkStructFields tc args fields 0)
          (mkTCon (bareOf (memGetWord ent 0)) vecNew)
        })))

; ------------------------------------------------------------------
; Effect inference: stage0's `collect_effects` walk and the monotone
; fixpoint over it. What introduces an effect, and nothing else does:
;
;   calling `__syscallN`         IO
;   calling anything else        that callee's inferred effects
;   an effect operation          Custom(E), stored on its entry
;   `(alloc T)`                  Alloc
;   `(set base.field v)`         Mut
;   a `handle` naming a resolved custom effect   Alloc
;
; What this deliberately does NOT model is effect POLYMORPHISM:
; stage0 marks a parameter effect-transparent when it is called, and
; instantiates the mark with each call site's argument. Omitting it
; makes stage1's sets a SUBSET of stage0's, so every diagnostic that
; reads them under-reports rather than inventing one - the direction
; this file is required to fail in. A call through a local or a
; parameter therefore contributes nothing here.
;
; `bound` is the list of names lexically bound at the walk's start
; plus everything bound inside it. Without it a local shadowing an
; effectful top-level name re-resolves globally and attributes
; effects the body cannot perform - the same shadowing bug stage0
; records having hit in its own mid-recursion check.
(pub :: collectEffects (-> Int Int Int Int))
(pub fn (collectEffects tc e bound)
  (let ((acc vecNew))
    { (walkEffects tc e bound acc) acc }))

; Which parameters can hold a callable value, from the declared type -
; stage0's `param_callables`. An arrow, a type variable or poison can;
; a concrete `Int` cannot, and marking one would claim a transparency
; the signature forbids.
(pub :: paramCallablesOf (-> Int Int Int))
(pub fn (paramCallablesOf ty count)
  (let ((v vecNew))
    { (paramCallablesInto v ty count 0) v }))

(pub :: paramCallablesInto (-> Int Int Int Int Int))
(pub fn (paramCallablesInto v ty count i)
  (if (>= i count)
      0
      (if (== ty 0)
          { (vecPush v 1) (paramCallablesInto v 0 count (+ i 1)) }
          (if (!= (nodeTag ty) TAG_T_ARR)
              { (vecPush v 1) (paramCallablesInto v 0 count (+ i 1)) }
              {
                (vecPush v (tyIsCallable (nodeA ty)))
                (paramCallablesInto v (nodeB ty) count (+ i 1))
              }))))

(pub :: tyIsCallable (-> Int Int))
(pub fn (tyIsCallable t)
  (if (== t 0)
      1
      (let ((tg (nodeTag t)))
        (if (== tg TAG_T_ARR) 1
        (if (== tg TAG_T_VAR) 1
        (if (== tg TAG_T_ERR) 1
        0))))))

; The scope a function body is walked in.
(pub :: bodyScopeOf (-> Int Int Int))
(pub fn (bodyScopeOf tc d)
  (let ((ent (findFnEnt tc (nodeA d))))
    (bsNew (nodeB d)
           (paramCallablesOf (if (== ent 0) 0 (memGetWord ent 1))
                             (vecLen (nodeB d)))
           vecNew)))

(pub :: walkEffects (-> Int Int Int Int Int))
(pub fn (walkEffects tc e bound acc)
  (if (== e 0)
      0
      (let ((tag (nodeTag e)))
        (if (== tag TAG_E_APP)
            {
              (walkEffectsSpine tc e bound acc)
              0
            }
        (if (== tag TAG_E_VAR)
            ; A bare reference to an effectful name is attributed
            ; exactly as a call is - stage0's reference-site rule,
            ; which is what keeps a function value's effects from
            ; escaping attribution entirely. Not a head, so a bound
            ; name here is an ordinary local read.
            (effRefSite tc (nodeA e) bound acc 0)
        (if (== tag TAG_E_ALLOC)
            {
              (effAdd acc (builtinEff "Alloc"))
              (walkEffects tc (nodeB e) bound acc)
            }
        (if (== tag TAG_E_SETF)
            {
              (effAdd acc (builtinEff "Mut"))
              (walkEffects tc (nodeA e) bound acc)
              (walkEffects tc (nodeC e) bound acc)
            }
        (if (== tag TAG_E_HANDLE)
            (walkEffectsHandle tc e bound acc)
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
            {
              (walkEffects tc (nodeB e) bound acc)
              ; A `let` whose initialiser is a bare reference to a
              ; parameter is an ALIAS of it: calling the local is
              ; calling the parameter under another name, which is
              ; stage0's `param_alias_of` through `lookup_shadow`.
              (let ((b2 (bsWith bound (nodeA e)
                          (if (== (nodeTag (nodeB e)) TAG_E_VAR)
                              (bsParamAlias bound (nodeA (nodeB e)))
                              (- 0 1)))))
                (walkEffects tc (nodeC e) b2 acc))
            }
        (if (== tag TAG_E_LAM)
            (walkEffects tc (nodeB e) (bsWithParams bound (nodeA e) 0) acc)
        (if (== tag TAG_E_IF)
            {
              (walkEffects tc (nodeA e) bound acc)
              (walkEffects tc (nodeB e) bound acc)
              (walkEffects tc (nodeC e) bound acc)
            }
        (if (== tag TAG_E_BEGIN)
            (walkEffectsVec tc (nodeA e) 0 bound acc)
        (if (== tag TAG_E_WHILE)
            {
              (walkEffects tc (nodeA e) bound acc)
              (walkEffectsVec tc (nodeB e) 0 bound acc)
            }
        (if (== tag TAG_E_SET)
            (walkEffects tc (nodeB e) bound acc)
        (if (== tag TAG_E_FIELD)
            (walkEffects tc (nodeA e) bound acc)
        (if (== tag TAG_E_STRUCTCON)
            (walkEffectsVec tc (nodeB e) 0 bound acc)
        (if (== tag TAG_E_COND)
            (walkEffectsCond tc (nodeA e) 0 bound acc)
        (if (== tag TAG_E_MATCH)
            {
              (walkEffects tc (nodeA e) bound acc)
              (walkEffectsArms tc (nodeB e) 0 bound acc)
            }
        0))))))))))))))))))

(pub :: walkEffectsVec (-> Int Int Int Int Int Int))
(pub fn (walkEffectsVec tc v i bound acc)
  (if (>= i (vecLen v))
      0
      {
        (walkEffects tc (vecGet v i) bound acc)
        (walkEffectsVec tc v (+ i 1) bound acc)
      }))

(pub :: walkEffectsCond (-> Int Int Int Int Int Int))
(pub fn (walkEffectsCond tc cls i bound acc)
  (if (>= i (vecLen cls))
      0
      (let ((c (vecGet cls i)))
        {
          (walkEffects tc (nodeA c) bound acc)
          (walkEffects tc (nodeB c) bound acc)
          (walkEffectsCond tc cls (+ i 1) bound acc)
        })))

; A match arm binds its pattern's variables, which must shadow.
(pub :: walkEffectsArms (-> Int Int Int Int Int Int))
(pub fn (walkEffectsArms tc arms i bound acc)
  (if (>= i (vecLen arms))
      0
      (let ((a (vecGet arms i)))
        {
          (walkEffects tc (nodeB a) (bsWithPattern bound (nodeA a)) acc)
          (walkEffectsArms tc arms (+ i 1) bound acc)
        })))

; A handle subtracts what it handles from the BODY's effects only,
; then adds Alloc when it installs a real dynamic handler. The
; handler expression's own effects pass through undiminished.
(pub :: walkEffectsHandle (-> Int Int Int Int Int))
(pub fn (walkEffectsHandle tc e bound acc)
  (let ((inner (collectEffects tc (nodeA e) bound)))
    {
      (effUnionUnhandled acc inner (nodeB e) 0)
      (if (== (handleIsDynamic tc (nodeB e) 0) 1)
          (effAdd acc (builtinEff "Alloc"))
          0)
      (walkEffects tc (nodeC e) bound acc)
    }))

(pub :: effUnionUnhandled (-> Int Int Int Int Int))
(pub fn (effUnionUnhandled acc inner effs i)
  (if (>= i (vecLen inner))
      0
      {
        (if (== (effHandledBy effs (vecGet inner i) 0) 1)
            0
            (effAdd acc (vecGet inner i)))
        (effUnionUnhandled acc inner effs (+ i 1))
      }))

; Does this handle's effect-name list cover `e`? A name in the list
; is the built-in effect when it spells one and a custom effect
; otherwise - stage0's parser decides this, not the declarations.
(pub :: effHandledBy (-> Int String Int Int))
(pub fn (effHandledBy effs e i)
  (if (>= i (vecLen effs))
      0
      (let ((n (nodeA (vecGet effs i))))
        (if (strEq (if (== (isBuiltinEffect n) 1)
                       (builtinEff (if (strEq n "alloc") "Alloc" n))
                       (customEff n))
                   e)
            1
            (effHandledBy effs e (+ i 1))))))

; A handle installs evidence - and so allocates - exactly when one of
; its names resolves to a declared effect, which mirrors the gate
; stage0's generator uses.
(pub :: handleIsDynamic (-> Int Int Int Int))
(pub fn (handleIsDynamic tc effs i)
  (if (>= i (vecLen effs))
      0
      (let ((n (nodeA (vecGet effs i))))
        (if (&& (== (isBuiltinEffect n) 0)
                (!= (findEffectDecl tc n) 0))
            1
            (handleIsDynamic tc effs (+ i 1))))))

; The spine: every argument is walked for its own effects, then the
; head decides what the call itself adds - and, when the callee is
; known to be effect-transparent somewhere, which argument escapes
; into that position.
(pub :: walkEffectsSpine (-> Int Int Int Int Int))
(pub fn (walkEffectsSpine tc e bound acc)
  (let ((args (spineArgVec e vecNew))
        (head (spineHead e)))
    {
      (walkEffectsVec tc args 0 bound acc)
      (if (== (nodeTag head) TAG_E_VAR)
          (walkCallHead tc (nodeA head) args bound acc)
          (walkEffects tc head bound acc))
    }))

; stage0's `walk_call`, by callee kind.
(pub :: walkCallHead (-> Int String Int Int Int Int))
(pub fn (walkCallHead tc n args bound acc)
  (if (== (bsIsLocal bound n) 1)
      ; Calling a local or a parameter. If it aliases a parameter,
      ; THAT parameter is effect-transparent - this is the case the
      ; whole pass exists for - and whatever is handed to it may be
      ; called too.
      {
        (markEparam bound (bsParamAlias bound n))
        (escapeArgs bound args 0)
      }
      (if (== (isSyscallPrim n) 1)
          (effAdd acc (builtinEff "IO"))
          (let ((ent (findFnEnt tc n)))
            (if (== ent 0)
                ; An unresolved callee: treat it like a local, since
                ; what it does with its arguments is unknown.
                (escapeArgs bound args 0)
                {
                  (effUnion acc (memGetWord ent 5) 0)
                  ; Instantiate the callee's transparent positions
                  ; with what this call passes there.
                  (instantiateEparams bound (memGetWord ent 6) args 0)
                })))))

(pub :: escapeArgs (-> Int Int Int Int))
(pub fn (escapeArgs bound args i)
  (if (>= i (vecLen args))
      0
      { (escapeValue bound (vecGet args i)) (escapeArgs bound args (+ i 1)) }))

(pub :: instantiateEparams (-> Int Int Int Int Int))
(pub fn (instantiateEparams bound marks args i)
  (if (>= i (vecLen marks))
      0
      {
        (if (< (vecGet marks i) (vecLen args))
            (escapeValue bound (vecGet args (vecGet marks i)))
            0)
        (instantiateEparams bound marks args (+ i 1))
      }))

; What naming `n` contributes when it is NOT a call head: stage0's
; reference-site rule, which is what keeps a function value's effects
; from escaping attribution entirely. A lexically bound name
; contributes nothing - its initialiser was walked where it was
; bound.
(pub :: effRefSite (-> Int String Int Int Int Int))
(pub fn (effRefSite tc n bound acc inHead)
  (if (== (bsIsLocal bound n) 1)
      0
      (if (== (isSyscallPrim n) 1)
          (effAdd acc (builtinEff "IO"))
          (let ((ent (findFnEnt tc n)))
            (if (== ent 0)
                0
                {
                  (effUnion acc (memGetWord ent 5) 0)
                })))))

; ------------------------------------------------------------------
; AX3010: an AXTAG claim the body does not support. A WARNING, and
; the only diagnostic stage1 emits that is not an error.
;
; Three forms, all of stage0's:
;   `;@axiom:pure`          -> "`pure` claim contradicted: body performs X, Y"
;   `;@axiom:effect(pure)`  -> "`effect(pure)` claim contradicted: ..."
;   `;@axiom:effect(v)`     -> "`effect(v)` claim unsupported: missing X"
; and the rendered message is prefixed "AXTAG mismatch on `name`: ".
; Effects are joined ", " SORTED BY THEIR DISPLAY NAME, because
; stage0 collects into a HashSet and sorts by `format!("{}")` before
; rendering - insertion order would be a different string.
;
; The gate that makes this sound: stage1 does not model effect
; polymorphism, so its effect sets are a SUBSET of stage0's, and a
; subset is fine for a per-effect diagnostic like AX3011 (fewer
; lines) but fatal here, where the set is rendered INTO the message -
; "body performs IO" against "body performs IO, Mut" is a
; mis-report, not an omission. So the walk records whether it saw a
; call it could not resolve: a head that is a lexically bound name,
; or a name with no entry at all. Those are precisely the calls that
; make stage0's `effect_params` non-empty, and when there are none,
; stage1's concrete set equals stage0's and its `effect_params` is
; empty - which is also the condition stage0 uses to decide whether a
; missing claimed effect is a lie. Anything else stays silent.
(pub :: effIncomplete Int)
(pub fn (effIncomplete) "?:incomplete")

(pub :: effIsComplete (-> Int Int))
(pub fn (effIsComplete v) (if (== (effIn v effIncomplete) 1) 0 1))

; The concrete effects, sorted by display name, joined with ", ".
(pub :: effJoin (-> Int Int))
(pub fn (effJoin v)
  (effJoinFrom (effSorted v) 0 ""))

(pub :: effJoinFrom (-> Int Int String Int))
(pub fn (effJoinFrom v i acc)
  (if (>= i (vecLen v))
      acc
      (effJoinFrom v (+ i 1)
        (if (== i 0)
            (effRender (vecGet v i))
            (strConcat (strConcat acc ", ") (effRender (vecGet v i)))))))

; Insertion sort by rendered name - the sets are three or four
; entries, and this has to agree with stage0's `sort_by_key` on the
; same strings.
(pub :: effSorted (-> Int Int))
(pub fn (effSorted v)
  (let ((out vecNew))
    { (effSortInto out v 0) out }))

(pub :: effSortInto (-> Int Int Int Int))
(pub fn (effSortInto out v i)
  (if (>= i (vecLen v))
      0
      {
        (if (strEq (vecGet v i) effIncomplete)
            0
            (effInsertSorted out (vecGet v i)))
        (effSortInto out v (+ i 1))
      }))

(pub :: effInsertSorted (-> Int Int Int))
(pub fn (effInsertSorted out e)
  (let ((n (vecLen out)))
    {
      (vecPush out e)
      (effShiftDown out n)
    }))

(pub :: effShiftDown (-> Int Int Int))
(pub fn (effShiftDown out i)
  (if (<= i 0)
      0
      (if (< (strCmp (effRender (vecGet out i))
                     (effRender (vecGet out (- i 1)))) 0)
          {
            (let ((tmp (vecGet out i)))
              {
                (vecSet out i (vecGet out (- i 1)))
                (vecSet out (- i 1) tmp)
              })
            (effShiftDown out (- i 1))
          }
          0)))

; The syscall primitives are the IO ones; every other `__` primitive
; is pure. stage0 drives this off PRIMITIVES' `is_io` column.
(pub :: isSyscallPrim (-> String Int))
(pub fn (isSyscallPrim n)
  (if (strEq n "__syscall0") 1 (if (strEq n "__syscall1") 1
  (if (strEq n "__syscall2") 1 (if (strEq n "__syscall3") 1
  (if (strEq n "__syscall4") 1 (if (strEq n "__syscall5") 1
  (if (strEq n "__syscall6") 1 0))))))))

; ------------------------------------------------------------------
; The walk's scope. `names` is the shadow list - one entry per `let`,
; lambda parameter or match binder, carrying the PARAMETER INDEX it
; aliases or -1 - while `params`, `callable` and `eparams` are
; constant for the whole walk and shared by every derived scope.
;
; Parameters are deliberately NOT in `names`: stage0 keeps them in a
; separate list so `param_index` can still find one, and a parameter
; masked as a shadow of itself would be invisible to the
; effect-transparency marks that are the whole point of tracking it.
(pub struct BEnt (name : Int) (pidx : Int))
(pub struct BScope (names : Int) (params : Int) (callable : Int)
                   (eparams : Int))

(pub :: bsNew (-> Int Int Int Int))
(pub fn (bsNew params callable eparams)
  (cast Int (BScope vecNew params callable eparams)))

(pub :: bsNames (-> Int Int))    (pub fn (bsNames b)    (memGetWord b 0))
(pub :: bsParams (-> Int Int))   (pub fn (bsParams b)   (memGetWord b 1))
(pub :: bsCallable (-> Int Int)) (pub fn (bsCallable b) (memGetWord b 2))
(pub :: bsEparams (-> Int Int))  (pub fn (bsEparams b)  (memGetWord b 3))

(pub :: bsWith (-> Int Int Int Int))
(pub fn (bsWith b n pidx)
  (let ((v vecNew))
    {
      (copyInto v (bsNames b) 0)
      (vecPush v (cast Int (BEnt n pidx)))
      (cast Int (BScope v (bsParams b) (bsCallable b) (bsEparams b)))
    }))

(pub :: copyInto (-> Int Int Int Int))
(pub fn (copyInto dst src i)
  (if (>= i (vecLen src))
      0
      { (vecPush dst (vecGet src i)) (copyInto dst src (+ i 1)) }))

; The LAST entry for `n`, which is the innermost binding.
(pub :: bsFind (-> Int String Int))
(pub fn (bsFind b n) (bsFindFrom (bsNames b) n (- (vecLen (bsNames b)) 1)))

(pub :: bsFindFrom (-> Int String Int Int))
(pub fn (bsFindFrom names n i)
  (if (< i 0)
      0
      (if (strEq (memGetWord (vecGet names i) 0) n)
          (vecGet names i)
          (bsFindFrom names n (- i 1)))))

(pub :: nameIndexIn (-> Int String Int Int))
(pub fn (nameIndexIn v n i)
  (if (>= i (vecLen v))
      (- 0 1)
      (if (strEq (vecGet v i) n) i (nameIndexIn v n (+ i 1)))))

; Is this name lexically bound at all - a shadow entry or a parameter?
(pub :: bsIsLocal (-> Int String Int))
(pub fn (bsIsLocal b n)
  (if (!= (bsFind b n) 0)
      1
      (if (>= (nameIndexIn (bsParams b) n 0) 0) 1 0)))

; stage0's `param_alias_of`: the parameter index this name stands
; for, or -1. A shadow entry answers with the alias it recorded; an
; unshadowed name falls through to the parameter list.
(pub :: bsParamAlias (-> Int String Int))
(pub fn (bsParamAlias b n)
  (let ((ent (bsFind b n)))
    (if (!= ent 0)
        (memGetWord ent 1)
        (nameIndexIn (bsParams b) n 0))))

; Mark parameter `i` effect-transparent, if it is one a value can
; arrive in. stage0 gates on `param_callable`: a parameter declared
; `Int` cannot be called, so marking it would claim a transparency
; the type forbids.
(pub :: markEparam (-> Int Int Int))
(pub fn (markEparam b i)
  (if (< i 0)
      0
      (if (== (paramIsCallable (bsCallable b) i) 0)
          0
          (if (== (intInVec (bsEparams b) i 0) 1)
              0
              { (vecPush (bsEparams b) i) 0 }))))

(pub :: paramIsCallable (-> Int Int Int))
(pub fn (paramIsCallable callable i)
  (if (>= i (vecLen callable)) 1 (vecGet callable i)))

(pub :: intInVec (-> Int Int Int Int))
(pub fn (intInVec v n i)
  (if (>= i (vecLen v))
      0
      (if (== (vecGet v i) n) 1 (intInVec v n (+ i 1)))))

; stage0's `escape_value`: a value flowing somewhere it may be CALLED.
; Only a parameter alias needs marking - a named function or lambda
; was attributed where it was written.
(pub :: escapeValue (-> Int Int Int))
(pub fn (escapeValue b e)
  (let ((inner (stripGrouping e)))
    (if (== (nodeTag inner) TAG_E_VAR)
        (markEparam b (bsParamAlias b (nodeA inner)))
        0)))

(pub :: stripGrouping (-> Int Int))
(pub fn (stripGrouping e) e)

(pub :: bsWithParams (-> Int Int Int Int))
(pub fn (bsWithParams b params i)
  (if (>= i (vecLen params))
      b
      (bsWithParams (bsWith b (vecGet params i) (- 0 1)) params (+ i 1))))

; A pattern's binders are its non-head variables - the same rule the
; AX3013 scope walk uses. They bind values, never parameter aliases.
(pub :: bsWithPattern (-> Int Int Int))
(pub fn (bsWithPattern b pat)
  (let ((v vecNew))
    {
      (patBinders pat v)
      (bsWithParams b v 0)
    }))

(pub :: patBinders (-> Int Int Int))
(pub fn (patBinders pat acc)
  (if (== pat 0)
      0
      (let ((tag (nodeTag pat)))
        (if (== tag TAG_E_VAR)
            { (vecPush acc (nodeA pat)) 0 }
        (if (== tag TAG_E_APP)
            { (patBinders (nodeB pat) acc) (patBindersHead (nodeA pat) acc) }
        0)))))

; The spine's head of a constructor pattern names the constructor,
; not a binder, so only the arguments' binders are collected.
(pub :: patBindersHead (-> Int Int Int))
(pub fn (patBindersHead pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
      { (patBinders (nodeB pat) acc) (patBindersHead (nodeA pat) acc) }
      0))

; ------------------------------------------------------------------
; The fixpoint. Monotone: every round can only add, and one round per
; function suffices because each round propagates at least one
; call-graph edge. stage0 bounds it the same way, and for the same
; stated reason - termination must not depend on the walk staying
; monotone if it ever changes.
(pub :: inferEffects (-> Int Int Int))
(pub fn (inferEffects tc decls)
  (inferEffectsRound tc decls 0 (+ (vecLen decls) 1)))

(pub :: inferEffectsRound (-> Int Int Int Int Int))
(pub fn (inferEffectsRound tc decls round limit)
  (if (>= round limit)
      0
      (if (== (inferEffectsPass tc decls 0) 0)
          0
          (inferEffectsRound tc decls (+ round 1) limit))))

; One pass over every `fn` in the program - imported modules
; included, since a call into one has to know what it performs.
; Answers 1 when anything grew.
(pub :: inferEffectsPass (-> Int Int Int Int))
(pub fn (inferEffectsPass tc decls i)
  (if (>= i (vecLen decls))
      0
      (let ((rest (inferEffectsPass tc decls (+ i 1)))
            (d (vecGet decls i)))
        (if (!= (nodeTag d) TAG_D_FN)
            rest
            ; Set BEFORE the entry lookup, for the reason `tcCheckFn`
            ; states: `nodeA d` is this module's mangled name, and a
            ; declaration its own module does not export is invisible
            ; to a lookup made from nowhere. Looked up first, every
            ; private function's entry came back 0, its body's effects
            ; were never accumulated, and the whole standard library
            ; drew `AX3010 effect(io) claim unsupported` the moment one
            ; import carried a name list.
            (let ((_m (memSetWord tc 16 (nodeModule d)))
                  (ent (findFnEnt tc (nodeA d))))
              (if (== ent 0)
                  { (memSetWord tc 16 0) rest }
                  (let ((sc (bodyScopeOf tc d)))
                    (let ((got (collectEffects tc (nodeC d) sc))
                          (_m0 (memSetWord tc 16 0)))
                      (let ((g1 (effUnion (memGetWord ent 5) got 0))
                            (g2 (intUnion (memGetWord ent 6)
                                          (bsEparams sc) 0)))
                        (if (|| (== g1 1) (== g2 1)) 1 rest))))))))))

(pub :: intUnion (-> Int Int Int Int))
(pub fn (intUnion acc src i)
  (if (>= i (vecLen src))
      0
      (let ((rest (intUnion acc src (+ i 1))))
        (if (== (intInVec acc (vecGet src i) 0) 1)
            rest
            { (vecPush acc (vecGet src i)) 1 }))))

; `(handle body (Effect...) handler)`. stage0's order is the whole
; rule and it is not the source order: the BODY is checked, then the
; HANDLER, and only then does the effect list produce diagnostics -
; so a mistake inside either expression is reported before AX3016 on
; a misspelled effect beside it.
;
; Only CUSTOM effects are subject to these checks. The six built-in
; names never become `Custom` in stage0's parser, so they are skipped
; here rather than looked up and refused.
;
; Two shapes stay UNDER-reported and are recorded rather than
; guessed. stage0 follows an unhandled effect with AX3011, which
; needs the effect fixpoint stage1 does not run, and it checks the
; handler's type against the operation's declared arrow (AX3004),
; which needs the op type stage1's `effect` parser discards. Both
; omit lines; neither reorders or invents one.
(pub :: checkHandle (-> Int Int Int))
(pub fn (checkHandle tc e)
  {
    (checkExprH tc (nodeA e) 0)
    (checkExprH tc (nodeC e) 0)
    ; The form's own span is its BODY's - stage0's `Expr::span()`
    ; recurses into the first field of an EHandle exactly as it does
    ; for an application's head.
    (checkHandleEffects tc (nodeB e) 0 0 (spanOf (nodeA e)))
    ; AX3011: every effect the body performs that the list does not
    ; name. Seeded with the names lexically bound HERE - the walk
    ; starts mid-function, and a local shadowing an effectful
    ; top-level name would otherwise re-resolve globally and produce
    ; an error the body contradicts.
    ;
    ; The seed starts at frameBase, NOT at 0. Everything below it is
    ; the module walk's own entries - every signature seen so far -
    ; and seeding with those makes every top-level
    ; function look lexically bound, so a call to one contributes
    ; nothing and the whole fixpoint's work is discarded at the only
    ; place that reads it. stage0 seeds from its `__scope__` marker
    ; for the same reason.
    (checkUnhandled tc
      (collectEffects tc (nodeA e) (handleScopeOf tc))
      (nodeB e) 0 (spanOf (nodeA e)))
    mkSilentWild
  })

(pub :: checkUnhandled (-> Int Int Int Int Int Int))
(pub fn (checkUnhandled tc inner effs i span)
  (if (>= i (vecLen inner))
      0
      {
        ; The incompleteness sentinel travels in the same Vec and is
        ; NOT an effect: reporting it printed `unhandled effect
        ; `incomplete`` on a valid program - a handle whose body calls
        ; a local. Every consumer that renders an effect has to skip
        ; it, and no file in the swept trees calls through a local
        ; inside a handle body, so only the probe bank saw it.
        (if (strEq (vecGet inner i) effIncomplete)
            0
            (if (&& (== (effHandledBy effs (vecGet inner i) 0) 0) (!= span 0))
                (emitDiag tc
                  (mkDiag SEV_ERROR "AX3011" "effect-mismatch"
                          span
                          (strConcat (strConcat "effect mismatch: unhandled effect `"
                                                (effRender (vecGet inner i))) "`")
                          0 0 0))
                0))
        (checkUnhandled tc inner effs (+ i 1) span)
      }))

; Every name currently in scope, which seeds the collector's `bound`
; list at a handle site.
; The scope a handle's body is walked in: the enclosing function's
; parameters and their callability, plus every frame binder live at
; this node as a plain shadow. Parameters are EXCLUDED from the
; shadow list - stage0 excludes them for the same reason, that a
; parameter masked as a shadow of itself is invisible to the
; transparency marks.
(pub :: handleScopeOf (-> Int Int))
(pub fn (handleScopeOf tc)
  (let ((base (bsNew (memGetWord tc 11) (memGetWord tc 12) vecNew)))
    (seedFrameBinders base (tcScope tc) (tcFrameBase tc))))

(pub :: seedFrameBinders (-> Int Int Int Int))
(pub fn (seedFrameBinders b scope i)
  (if (>= i (vecLen scope))
      b
      (let ((n (memGetWord (vecGet scope i) 0)))
        (seedFrameBinders
          (if (>= (nameIndexIn (bsParams b) n 0) 0)
              b
              (bsWith b n (- 0 1)))
          scope (+ i 1)))))

; One pass over the effect list, counting the custom effects that
; resolved to a one-operation declaration. stage0 reports AX3017 a
; second time, at the FORM rather than at a name, when more than one
; such effect survives - a dynamic handle installs one evidence
; record, so two is not a shape it can lower.
(pub :: checkHandleEffects (-> Int Int Int Int Int Int))
(pub fn (checkHandleEffects tc effs i dynN formSpan)
  (if (>= i (vecLen effs))
      (if (&& (> dynN 1) (!= formSpan 0))
          (emitDiag tc
            (mkDiag SEV_ERROR "AX3017" "effect-handler-unsupported"
                    formSpan
                    (strConcat (decStr dynN)
                      " custom effects in one handle; nest one `handle` per effect")
                    0 0 0))
          0)
      (let ((nm (vecGet effs i)))
        (if (== (isBuiltinEffect (nodeA nm)) 1)
            (checkHandleEffects tc effs (+ i 1) dynN formSpan)
            (let ((d (findEffectDecl tc (nodeA nm))))
              (if (== d 0)
                  {
                    (if (!= (nodeSpan nm) 0)
                        (emitDiag tc
                          (diagSetLabel (mkDiag SEV_ERROR "AX3016" "unknown-effect"
                                  (nodeSpan nm)
                                  (strConcat (strConcat "unknown effect `"
                                                        (nodeA nm)) "`")
                                  0 0
                                  "declare it with `(effect Name (op :: sig))`, import the module that does, or fix the spelling")
                            (strConcat (strConcat "no effect named `" (nodeA nm)) "` is declared")))
                        0)
                    (checkHandleEffects tc effs (+ i 1) dynN formSpan)
                  }
                  (if (!= (vecLen (nodeB d)) 1)
                      {
                        (if (!= (nodeSpan nm) 0)
                            (emitDiag tc
                              (mkDiag SEV_ERROR "AX3017"
                                      "effect-handler-unsupported"
                                      (nodeSpan nm)
                                      (strConcat (strConcat (strConcat (strConcat
                                        "effect `" (nodeA nm))
                                        "` declares ") (decStr (vecLen (nodeB d))))
                                        " operations; a dynamic handler covers exactly one")
                                      0 0 0))
                            0)
                        (checkHandleEffects tc effs (+ i 1) dynN formSpan)
                      }
                      (checkHandleEffects tc effs (+ i 1) (+ dynN 1) formSpan))))))))

; `(struct Name field...)` - the keyword construction form. A name
; that resolves to no struct is AX3002, the twelfth diagnostic and
; the only one whose subject is a TYPE. Two details are stage0's and
; neither is guessable: the arguments are NOT checked when the name
; misses (stage0 returns TError straight from the `None` arm, so an
; undefined variable among the fields goes unreported), and the help
; is fixed prose with no "did you mean" - `SemError::UndefinedType`
; is constructed with `suggestion: None` at its one emission site, so
; a suggestion is unreachable however close a struct name sits.
(pub :: checkStructConNode (-> Int Int Int))
(pub fn (checkStructConNode tc e)
  (let ((ent (findStruct tc (nodeA e))))
    (if (== ent 0)
        {
          (if (!= (nodeSpan e) 0)
              (emitDiag tc
                (diagSetLabel (mkDiag SEV_ERROR "AX3002" "undefined-type"
                        (nodeSpan e)
                        (strConcat (strConcat "undefined type `" (nodeA e)) "`")
                        0 0
                        "check for typos, or a missing `data`/`struct`/`type` declaration")
                  (strConcat (strConcat "no type named `" (nodeA e)) "` is visible here")))
              0)
          (mkNode TAG_T_ERR 0 0 0)
        }
        (checkStructConAt tc (nodeB e) (nodeSpan e) ent))))

(pub :: checkStructFields (-> Int Int Int Int Int))
(pub fn (checkStructFields tc args fields i)
  (if (>= i (vecLen args))
      0
      (let ((aty (checkExprH tc (vecGet args i) 0)))
        (let ((fty (if (== (nodeTy (vecGet fields i)) 0)
                       mkSilentWild
                       (nodeTy (vecGet fields i)))))
          {
            (if (== (tyCompat aty fty) 0)
                (emitMismatch tc (tyRender fty) (tyRender aty)
                              (spanOf (vecGet args i)))
                0)
            (checkStructFields tc args fields (+ i 1))
          }))))

; ------------------------------------------------------------------
; Field access and field store. The base must be a plain constructor
; type; its struct's field types answer reads and check writes. A
; miss is AX3007 anchored at the FIELD NAME token. stage0 has a
; data-named-field fallback here; stage1's parser keeps no named
; constructor fields, so that road is empty by construction. The
; result type is I64 on every path stage0 answers I64 - including
; setf's SUCCESS - and the non-constructor-base complaint fires even
; on poison (stage0 has no guard there; probed, `found {unknown}`
; cascades), but stays quiet for the silent wildcard, which marks
; what stage1 alone cannot know.
; ------------------------------------------------------------------
(pub :: checkField (-> Int Int Int))
(pub fn (checkField tc e)
  (let ((baseTy (checkExprH tc (nodeA e) 0)))
    (if (== (nodeTag baseTy) TAG_T_CON)
        (let ((ent (findStruct tc (nodeA baseTy))))
          (let ((fty (if (== ent 0) (- 0 1) (structFieldTy ent (nodeB e)))))
            (if (!= fty (- 0 1))
                fty
                ; Not a struct field. It may still be a DATA
                ; constructor's named field: stage0 scans every data
                ; type and every constructor that has field names,
                ; first match winning, without consulting the
                ; scrutinee's own type. That looseness is deliberate
                ; there and is reproduced here rather than tightened,
                ; because tightening it would refuse programs stage0
                ; accepts.
                (let ((dty (dataFieldTy tc (nodeB e))))
                  (if (!= dty 0)
                      dty
                      {
                        (emitFieldNotFound tc (nodeB e) (nodeA baseTy) (nodeSpan e))
                        mkI64Ty
                      })))))
        {
          (if (== (tyIsSilentWild baseTy) 0)
              (emitMismatch tc "struct or data type" (tyRender baseTy)
                            (spanOf (nodeA e)))
              0)
          mkI64Ty
        })))

; The type of a named constructor field, searching every data type in
; declaration order, or 0. Mirrors stage0's `find_data_field_by_name`.
(pub :: dataFieldTy (-> Int String Int))
(pub fn (dataFieldTy tc fname) (dataFieldTyFrom (tcDatas tc) fname 0))

(pub :: dataFieldTyFrom (-> Int String Int Int))
(pub fn (dataFieldTyFrom datas fname i)
  (if (>= i (vecLen datas))
      0
      (let ((r (dataFieldTyInCtors (memGetWord (vecGet datas i) 1) fname 0)))
        (if (!= r 0) r (dataFieldTyFrom datas fname (+ i 1))))))

(pub :: dataFieldTyInCtors (-> Int String Int Int))
(pub fn (dataFieldTyInCtors ctors fname i)
  (if (>= i (vecLen ctors))
      0
      (let ((c (vecGet ctors i)))
        (let ((declared (memGetWord c 4)))
          (if (== declared 0)
              (dataFieldTyInCtors ctors fname (+ i 1))
              (let ((j (declaredFieldIndex declared fname 0)))
                (if (< j 0)
                    (dataFieldTyInCtors ctors fname (+ i 1))
                    (let ((tys (memGetWord c 1)))
                      (if (< j (vecLen tys)) (vecGet tys j) mkI64Ty)))))))))

(pub :: declaredFieldIndex (-> Int String Int Int))
(pub fn (declaredFieldIndex declared fname i)
  (if (>= i (vecLen declared))
      (- 0 1)
      (if (strEq (vecGet declared i) fname) i
          (declaredFieldIndex declared fname (+ i 1)))))

(pub :: emitFieldNotFound (-> Int Int String Int Int))
(pub fn (emitFieldNotFound tc fname tyName span)
  (if (== span 0)
      0
      {
        (emitDiag tc
          (diagSetLabel (mkDiag SEV_ERROR "AX3007" "field-not-found"
                  span
                  (strConcat (strConcat (strConcat (strConcat
                    "field `" fname) "` not found on type `") tyName) "`")
                  0 0
                  (strConcat (strConcat
                    "check the field name and the definition of `" tyName) "`"))
            (strConcat (strConcat (strConcat (strConcat "no field `" fname) "` on `") tyName) "`")))
        0
      }))

(pub :: checkSetField (-> Int Int Int))
(pub fn (checkSetField tc e)
  (let ((baseTy (checkExprH tc (nodeA e) 0)))
    {
      (if (== (nodeTag baseTy) TAG_T_CON)
          (let ((ent (findStruct tc (nodeA baseTy))))
            (let ((fty (if (== ent 0) (- 0 1) (structFieldTy ent (nodeB e)))))
              (if (!= fty (- 0 1))
                  ; Field found: the VALUE is checked, against the
                  ; field's type. On a miss the value is NEVER checked
                  ; - stage0's rule, probed; its diagnostics are lost.
                  (let ((vty (checkExprH tc (nodeC e) 0)))
                    (if (== (tyCompat vty fty) 0)
                        (emitMismatch tc (tyRender fty) (tyRender vty)
                                      (spanOf (nodeC e)))
                        0))
                  (emitFieldNotFound tc (nodeB e) (nodeA baseTy) (nodeSpan e)))))
          (if (== (tyIsSilentWild baseTy) 0)
              (emitMismatch tc "struct or data type" (tyRender baseTy)
                            (spanOf (nodeA e)))
              0))
      mkI64Ty
    }))

; ------------------------------------------------------------------
; `set`. VALUE first, target second - probed, golden 200. The target:
; the innermost binding ANYWHERE in scope (module signatures
; included - stage0's lookup_var has no frame restriction, which is
; exactly what makes a top-level target AX3012 with an AX3004 cascade
; through the binding's declared type). A binder stage1 has no span
; for suppresses BOTH halves. An unbound name that any signature,
; or imported definition covers stays silent (stage0 answers
; AX3012 anchored in another file - bytes stage1 cannot render);
; otherwise AX3001 with candidates from scope alone.
; ------------------------------------------------------------------
(pub :: checkSet (-> Int Int Int))
(pub fn (checkSet tc e)
  (let ((valTy (checkExprH tc (nodeB e) 0)))
    (let ((name (nodeA e)))
      (let ((ent (scopeFind (tcScope tc) name)))
        (if (!= ent 0)
            (let ((suppressed
                    (if (== (memGetWord ent 1) 1)
                        0
                        (if (== (memGetWord ent 2) 0)
                            1
                            { (emitAX3012 name (nodeSpan e) (memGetWord ent 2)
                                          (tcOut tc))
                              0 }))))
              {
                (if (&& (== suppressed 0)
                        (&& (== (tyIsErr valTy) 0)
                            (&& (== (tyIsErr (sEntTy ent)) 0)
                                (== (tyCompat valTy (sEntTy ent)) 0))))
                    (emitMismatch tc (tyRender (sEntTy ent)) (tyRender valTy)
                                  (spanOf (nodeB e)))
                    0)
                (sEntTy ent)
              })
            (if (== (isBuiltinName name) 1)
                mkSilentWild
                (if (== (setTargetCovered tc name) 1)
                    mkSilentWild
                    (let ((best (newBest)))
                      {
                        (offerScope best name (tcScope tc) 0)
                        (if (!= (nodeSpan e) 0)
                            (emitDiag tc
                              (let ((msg (strConcat (strConcat "undefined variable `" (srcSpelling name)) "`")))
                                (diagSetLabel (if (== (memGetWord best 0) 0)
                                    (mkDiag SEV_ERROR "AX3001" "undefined-variable"
                                            (nodeSpan e) msg 0 0
                                            "variables must be defined (via `define`/`fn`, a `let` binding, or a lambda parameter) before they are used; check for typos")
                                    (mkDiagFix SEV_ERROR "AX3001" "undefined-variable"
                                               (nodeSpan e) msg 0 0
                                               (strConcat (strConcat
                                                 "a similarly named binding `" (memGetWord best 0))
                                                 "` is in scope; did you mean this?")
                                               (nodeSpan e) (memGetWord best 0)))
                                  (strConcat (strConcat "no binding named `" (srcSpelling name)) "` in scope"))))
                            0)
                        (mkNode TAG_T_ERR 0 0 0)
                      }))))))))

; An IMPORTED declaration of the name - its stored name carries a
; `$`. stage0 resolves such a target through the scope entry the
; merged walk parked and answers AX3012 anchored in the OTHER file;
; stage1 renders every span against one source, so silence is the
; sound subset. ONLY imported declarations qualify: an entry-file
; signature is already a scope entry when the walk has passed it, and
; when it has NOT - the signature comes later in the file - stage0
; answers AX3001 (probed), which the fallthrough here preserves. An
; entry-file sig-less `fn` also stays AX3001: a plain `fn` never
; parks a scope entry in stage0 either.
(pub :: setTargetCovered (-> Int String Int))
(pub fn (setTargetCovered tc name)
  (setTargetCoveredFrom (memGetWord tc 10) name 0))

(pub :: setTargetCoveredFrom (-> Int String Int Int))
(pub fn (setTargetCoveredFrom decls name i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (let ((tag (nodeTag d)))
          (if (&& (|| (== tag TAG_D_SIG) (== tag TAG_D_FN))
                  (&& (== (nameMatches (nodeA d) name) 1)
                      (if (strEq (nodeA d) name) false true)))
              1
              (setTargetCoveredFrom decls name (+ i 1)))))))

; ------------------------------------------------------------------
; match. The scrutinee first; each arm's pattern binds its variables
; at the constructor's DECLARED field types - tyvars as written,
; never substituted, which is why tyCompat treats them as wildcards -
; then the arm body; arm results are NEVER compared (stage0 keeps the
; last arm's type). After every arm: exhaustiveness, only when no
; catch-all arm exists and the scrutinee's type is a known data type;
; the missing list is the declaration order, and the anchor is the
; SCRUTINEE. Pattern errors therefore precede body errors, and AX3005
; comes after everything in its match - probed order.
; ------------------------------------------------------------------
(pub :: checkMatch (-> Int Int Int))
(pub fn (checkMatch tc e)
  (let ((scrutTy (checkExprH tc (nodeA e) 0))
        (covered vecNew)
        (catchall (memAlloc 8)))
    {
      (memSetWord catchall 0 0)
      (let ((resTy (checkArms tc (nodeB e) 0 covered catchall
                              (freshTVar tc 0))))
        {
          (if (&& (== (memGetWord catchall 0) 0)
                  (== (nodeTag scrutTy) TAG_T_CON))
              (let ((dent (findData tc (nodeA scrutTy))))
                (if (== dent 0)
                    0
                    (checkExhaustive tc dent covered (spanOf (nodeA e)))))
              0)
          resTy
        })
    }))

(pub :: checkArms (-> Int Int Int Int Int Int Int))
(pub fn (checkArms tc arms i covered catchall resTy)
  (if (>= i (vecLen arms))
      resTy
      (let ((arm (vecGet arms i))
            (mark (vecLen (tcScope tc))))
        {
          (recordCoverage (nodeA arm) covered catchall)
          (checkPatternTyped tc (nodeA arm) 0)
          (let ((t (checkExprH tc (nodeB arm) 0)))
            {
              (scopeTrunc (tcScope tc) mark)
              (checkArms tc arms (+ i 1) covered catchall t)
            })
        })))

; What an arm covers: a parenthesised nullary constructor or a
; fieldful pattern's head name. A bare identifier is a catch-all -
; except `true`/`false`, which are literal TESTS (codegen agrees),
; and literals, which cover nothing.
(pub :: recordCoverage (-> Int Int Int Int))
(pub fn (recordCoverage pat covered catchall)
  (let ((tag (nodeTag pat)))
    ; A NAMED constructor arm covers its constructor exactly as a
    ; positional one does - stage0's exhaustiveness treats `PCon` and
    ; `PConNamed` in the same arm of the same match.
    (if (|| (== tag TAG_P_CON0) (== tag TAG_P_CONNAMED))
        { (vecPush covered (nodeA pat)) 0 }
        (if (== tag TAG_E_APP)
            (let ((head (spineHead pat)))
              (if (== (nodeTag head) TAG_E_VAR)
                  { (vecPush covered (nodeA head)) 0 }
                  0))
            (if (== tag TAG_E_VAR)
                (if (|| (strEq (nodeA pat) "true") (strEq (nodeA pat) "false"))
                    0
                    { (memSetWord catchall 0 1) 0 })
                0)))))

(pub :: checkExhaustive (-> Int Int Int Int Int))
(pub fn (checkExhaustive tc dent covered span)
  (if (== span 0)
      0
      (let ((missing (missingCtors (memGetWord dent 1) covered vecNew 0)))
        (if (== (vecLen missing) 0)
            0
            {
              (emitDiag tc
                (diagSetLabel (mkDiag SEV_ERROR "AX3005" "non-exhaustive-match"
                        span
                        (strConcat "non-exhaustive pattern match: missing "
                                   (joinComma missing 0 ""))
                        0 0
                        "add the missing arms, or a wildcard `_` arm to catch the rest")
                  (strConcat "this `match` does not cover: " (joinComma missing 0 ""))))
              0
            }))))

(pub :: missingCtors (-> Int Int Int Int Int))
(pub fn (missingCtors ctors covered acc i)
  (if (>= i (vecLen ctors))
      acc
      (let ((cn (bareOf (memGetWord (vecGet ctors i) 0))))
        {
          (if (== (coveredHas covered cn 0) 0)
              (vecPush acc cn)
              0)
          (missingCtors ctors covered acc (+ i 1))
        })))

(pub :: coveredHas (-> Int String Int Int))
(pub fn (coveredHas covered name i)
  (if (>= i (vecLen covered))
      0
      (if (strEq (bareOf (vecGet covered i)) name)
          1
          (coveredHas covered name (+ i 1)))))

(pub :: joinComma (-> Int Int String Int))
(pub fn (joinComma xs i acc)
  (if (>= i (vecLen xs))
      acc
      (joinComma xs (+ i 1)
        (if (== i 0)
            (vecGet xs 0)
            (strConcat (strConcat acc ", ") (vecGet xs i))))))

; ------------------------------------------------------------------
; Patterns, typed. A bare identifier binds at the expected type -
; `_` excepted: stage0 parses it as a wildcard that binds nothing,
; and a bound `_` would join the suggestion pool. A constructor
; pattern checks existence (AX3003, suggestions from constructors
; alone) and arity (AX3009), then binds each argument at the
; constructor's declared field type; arguments past the declared
; fields, and every argument of an UNKNOWN constructor, bind at fresh
; `_tN` wildcards - and each such fallback bumps the counter, stage0's
; check_pattern discipline, literals and wildcards included.
;
; `expected` is 0 at the top of an arm (the scrutinee's type is not
; threaded into patterns - stage0 binds a top-level variable pattern
; at the scrutinee type, and so does checkMatch's caller via
; checkPatternTypedAt).
; ------------------------------------------------------------------
(pub :: checkPatternTyped (-> Int Int Int Int))
(pub fn (checkPatternTyped tc pat scrutTy)
  (let ((tag (nodeTag pat)))
    (if (== tag TAG_E_VAR)
        (if (|| (strEq (nodeA pat) "true") (strEq (nodeA pat) "false"))
            0
            (if (strEq (nodeA pat) "_")
                0
                { (pushScope (tcScope tc) (nodeA pat) 0 (nodeSpan pat)
                             (if (== scrutTy 0) mkSilentWild scrutTy))
                  0 }))
    (if (== tag TAG_P_CON0)
        (checkCtorPattern tc (nodeA pat) vecNew (nodeSpan pat))
    (if (== tag TAG_E_APP)
        (let ((head (spineHead pat)))
          (if (!= (nodeTag head) TAG_E_VAR)
              0
              (checkCtorPattern tc (nodeA head)
                                (spineArgVec pat vecNew)
                                (nodeSpan head))))
    ; A NAMED constructor pattern. Every field it mentions must be one
    ; the constructor declares - a miss is AX3007, anchored at the
    ; FIELD NAME, which is why the parser keeps each name as a spanned
    ; node. The pattern is then reordered into the positional spine
    ; and checked by the ordinary path, so field types, binding and
    ; AX3003 all behave as they do for `(Rect w h)`.
    ;
    ; There is deliberately no arity check: stage0 fills an omitted
    ; field with a wildcard, so a partial named pattern is legal.
    (if (== tag TAG_P_CONNAMED)
        (let ((ctor (findCtor tc (nodeA pat))))
          (if (== ctor 0)
              (checkCtorPattern tc (nodeA pat) vecNew (nodeSpan pat))
              (let ((declared (memGetWord ctor 4)))
                {
                  (checkNamedPatFields tc (nodeB pat) declared
                                       (bareOf (nodeA pat)) 0)
                  (if (== declared 0)
                      0
                      (checkCtorPattern tc (nodeA pat)
                        (spineArgVec (namedPatSpine (nodeA pat) declared
                                                    (nodeB pat) (nodeC pat)
                                                    (nodeSpan pat))
                                     vecNew)
                        (nodeSpan pat)))
                })))
    0))))))

; Each field the pattern names must be declared. AX3007's message and
; help are the field-access ones, byte for byte.
(pub :: checkNamedPatFields (-> Int Int Int String Int Int))
(pub fn (checkNamedPatFields tc names declared tyName i)
  (if (>= i (vecLen names))
      0
      {
        (let ((nm (vecGet names i)))
          (if (== (declaredHasField declared (nodeA nm)) 1)
              0
              (emitFieldNotFound tc (nodeA nm) tyName (nodeSpan nm))))
        (checkNamedPatFields tc names declared tyName (+ i 1))
      }))

(pub :: checkCtorPattern (-> Int String Int Int Int))
(pub fn (checkCtorPattern tc cname args span)
  (let ((ctor (findCtor tc cname)))
    (if (== ctor 0)
        {
          (emitUndefinedCtor tc cname span)
          (bindPatternArgsFresh tc args 0)
          0
        }
        ; Instantiated for the same reason a reference to the
        ; constructor is: a pattern BINDS these types onto names, and
        ; a binder holding the declaring type's own rigid `a` would
        ; make `(match (Some 42) ((Some x) x))` answer a variable no
        ; concrete type is compatible with.
        (let ((fieldTys (tyInstVec tc (memGetWord ctor 1) vecNew vecNew 0)))
          {
            (if (!= (vecLen args) (vecLen fieldTys))
                (if (== span 0)
                    0
                    (emitDiag tc
                      (diagSetLabel (mkDiag SEV_ERROR "AX3009" "constructor-arity-mismatch"
                              span
                              (strConcat (strConcat (strConcat (strConcat (strConcat
                                "constructor `" cname)
                                "` expects ") (decStr (vecLen fieldTys)))
                                " argument(s), found ") (decStr (vecLen args)))
                              0 0
                              (strConcat (strConcat "this constructor takes exactly "
                                (decStr (vecLen fieldTys)))
                                " field(s); add or remove arguments to match"))
                        (strConcat (decStr (vecLen args)) " argument(s) provided here"))))
                0)
            (bindPatternArgs tc args fieldTys 0)
            0
          }))))

(pub :: bindPatternArgs (-> Int Int Int Int Int))
(pub fn (bindPatternArgs tc args fieldTys i)
  (if (>= i (vecLen args))
      0
      (let ((arg (vecGet args i)))
        {
          (if (< i (vecLen fieldTys))
              (bindOnePatArg tc arg (vecGet fieldTys i))
              (bindOnePatArg tc arg (freshTVar tc 1)))
          (bindPatternArgs tc args fieldTys (+ i 1))
        })))

(pub :: bindPatternArgsFresh (-> Int Int Int Int))
(pub fn (bindPatternArgsFresh tc args i)
  (if (>= i (vecLen args))
      0
      {
        (bindOnePatArg tc (vecGet args i) (freshTVar tc 1))
        (bindPatternArgsFresh tc args (+ i 1))
      }))

; One argument position: a bare name binds at the given type, a
; nested constructor pattern recurses with its own checks, a literal
; binds nothing.
(pub :: bindOnePatArg (-> Int Int Int Int))
(pub fn (bindOnePatArg tc arg ty)
  (let ((tag (nodeTag arg)))
    (if (== tag TAG_E_VAR)
        (if (|| (strEq (nodeA arg) "true") (strEq (nodeA arg) "false"))
            0
            (if (strEq (nodeA arg) "_")
                0
                { (pushScope (tcScope tc) (nodeA arg) 0 (nodeSpan arg) ty)
                  0 }))
        ; A nested constructor pattern recurses, and a NAMED one is a
        ; constructor pattern: without this arm `(Wrap { inner =
        ; (Rect { w, h }) })` bound nothing for `w` or `h` and every
        ; use of them was an undefined variable.
        (if (|| (== tag TAG_E_APP)
                (|| (== tag TAG_P_CON0) (== tag TAG_P_CONNAMED)))
            (checkPatternTyped tc arg 0)
            0))))

(pub :: emitUndefinedCtor (-> Int String Int Int))
(pub fn (emitUndefinedCtor tc cname span)
  (if (== span 0)
      0
      (let ((best (newBest)))
        {
          (offerCtorEnts best cname (tcDatas tc) 0)
          ; A constructor of a type its module does not export is
          ; refused either way - the lookup filters it - but saying it
          ; does not exist is wrong about a name that plainly does.
          (if (!= (ctorHiddenModule tc cname) 0)
              (emitPrivateVar tc cname span
                              (privKey (ctorHiddenModule tc cname) cname))
          (emitDiag tc
            (let ((msg (strConcat (strConcat "undefined constructor `" cname) "`")))
              (diagSetLabel (if (== (memGetWord best 0) 0)
                  (mkDiag SEV_ERROR "AX3003" "undefined-constructor"
                          span msg 0 0
                          "check the `data` declaration for the correct constructor name")
                  (mkDiagFix SEV_ERROR "AX3003" "undefined-constructor"
                             span msg 0 0
                             (strConcat (strConcat
                               "a similarly named constructor `" (memGetWord best 0))
                               "` is visible; did you mean this?")
                             span (memGetWord best 0)))
                (strConcat (strConcat "no constructor named `" cname) "` is visible here")))))
          0
        })))

; ------------------------------------------------------------------
; The suggestion. Byte-identical output means reproducing stage0's
; `suggest_closest` exactly: Levenshtein distance, a threshold of
; `(min(len)/2)` clamped to [1,2], candidates equal to the name or
; beginning `__` skipped, and the FIRST strictly-smaller distance
; winning - so the order candidates are visited in decides ties.
; stage0 visits scope, then the function TABLE - operators and
; primitives included, struct names absent (probed: a typo near a
; struct name draws no suggestion) - then every constructor, the
; builtin Option's first.
; ------------------------------------------------------------------
(pub :: levenshtein (-> String String Int))
(pub fn (levenshtein a b)
  (let ((la (strLen a))
        (lb (strLen b)))
    (let ((prev (memAlloc (* 8 (+ lb 1))))
          (cur (memAlloc (* 8 (+ lb 1)))))
      {
        (levInitRow prev lb 0)
        (levRows a b la lb prev cur 1)
      })))

(pub :: levInitRow (-> Int Int Int Int))
(pub fn (levInitRow row lb j)
  (if (> j lb)
      0
      { (memSetWord row j j) (levInitRow row lb (+ j 1)) }))

(pub :: levRows (-> String String Int Int Int Int Int Int))
(pub fn (levRows a b la lb prev cur i)
  (if (> i la)
      (memGetWord prev lb)
      {
        (memSetWord cur 0 i)
        (levCols a b lb prev cur i 1)
        (levCopyRow cur prev lb 0)
        (levRows a b la lb prev cur (+ i 1))
      }))

(pub :: levCols (-> String String Int Int Int Int Int Int))
(pub fn (levCols a b lb prev cur i j)
  (if (> j lb)
      0
      (let ((cost (if (== (strByte a (- i 1)) (strByte b (- j 1))) 0 1)))
        (let ((del (+ (memGetWord prev j) 1))
              (ins (+ (memGetWord cur (- j 1)) 1))
              (sub (+ (memGetWord prev (- j 1)) cost)))
          {
            (memSetWord cur j (minOf3 del ins sub))
            (levCols a b lb prev cur i (+ j 1))
          }))))

(pub :: minOf3 (-> Int Int Int Int))
(pub fn (minOf3 a b c)
  (let ((m (if (< a b) a b)))
    (if (< m c) m c)))

(pub :: levCopyRow (-> Int Int Int Int Int))
(pub fn (levCopyRow src dst lb j)
  (if (> j lb)
      0
      { (memSetWord dst j (memGetWord src j)) (levCopyRow src dst lb (+ j 1)) }))

; `(min(len)/2)` clamped into [1,2], stage0's rule verbatim.
(pub :: suggestThreshold (-> Int Int Int))
(pub fn (suggestThreshold la lb)
  (let ((m (if (< la lb) la lb)))
    (let ((t (/ m 2)))
      (if (< t 1) 1 (if (> t 2) 2 t)))))

; A cell holding the best candidate found so far and its distance, so
; the search can run over two sequences without rebuilding a list.
(pub :: newBest Int)
(pub fn (newBest)
  (let ((c (memAlloc 16)))
    { (memSetWord c 0 0) (memSetWord c 1 999) c }))

(pub :: offerCandidate (-> Int String String Int))
(pub fn (offerCandidate best name cand)
  (if (|| (strEq cand name) (strStartsWith cand "__"))
      0
      (let ((d (levenshtein name cand)))
        (if (&& (<= d (suggestThreshold (strLen name) (strLen cand)))
                (< d (memGetWord best 1)))
            { (memSetWord best 0 cand) (memSetWord best 1 d) 0 }
            0))))

(pub :: offerScope (-> Int String Int Int Int))
(pub fn (offerScope best name scope i)
  (if (>= i (vecLen scope))
      0
      { (offerCandidate best name (memGetWord (vecGet scope i) 0))
        (offerScope best name scope (+ i 1)) }))

(pub :: offerFnEnts (-> Int String Int Int Int))
(pub fn (offerFnEnts best name fns i)
  (if (>= i (vecLen fns))
      0
      { (offerCandidate best name (bareOf (memGetWord (vecGet fns i) 0)))
        (offerFnEnts best name fns (+ i 1)) }))

(pub :: offerCtorEnts (-> Int String Int Int Int))
(pub fn (offerCtorEnts best name datas i)
  (if (>= i (vecLen datas))
      0
      { (offerCtorsOf best name (memGetWord (vecGet datas i) 1) 0)
        (offerCtorEnts best name datas (+ i 1)) }))

(pub :: offerCtorsOf (-> Int String Int Int Int))
(pub fn (offerCtorsOf best name ctors i)
  (if (>= i (vecLen ctors))
      0
      { (offerCandidate best name (bareOf (memGetWord (vecGet ctors i) 0)))
        (offerCtorsOf best name ctors (+ i 1)) }))

; A declaration's source-spelled name: import resolution rewrites an
; imported one to `Mod$name` in place, and a suggestion has to read
; back as something the programmer could type.
(pub :: bareOf (-> String Int))
(pub fn (bareOf s) (bareOfFrom s (- (strLen s) 1)))

; The MODULE part of a qualified name `Mod$name`, or 0 when there is
; none. The mirror of `bareOf`, which answers the other half.
; A name as the PROGRAMMER wrote it. A qualified reference is parsed
; into the flat `Mod$name` spelling the declarations use, and a
; diagnostic that quotes it back reports a name that appears nowhere in
; the source: `undefined variable `Nope$Red`` for a line reading
; `Nope::Red`. stage0 reports the source spelling; so does this now.
(pub :: srcSpelling (-> String String))
(pub fn (srcSpelling s)
  (let ((m (modOf s)))
    (if (== m 0) s (strConcat (strConcat m "::") (bareOf s)))))

(pub :: modOf (-> String Int))
(pub fn (modOf s) (modOfFrom s (- (strLen s) 1)))

(pub :: modOfFrom (-> String Int Int))
(pub fn (modOfFrom s i)
  (if (< i 0)
      0
      (if (== (strByte s i) 36)
          (strSlice s 0 i)
          (modOfFrom s (- i 1)))))

; Does a type or constructor named `declName`, declared by module
; `declMod`, answer to the reference `ref`?
;
; A BARE reference behaves exactly as it always did - `nameMatches`,
; which also lets a bare reference reach a declaration `mangleDecl`
; rewrote. A QUALIFIED one now has its module CHECKED against the
; declaring module rather than ignored, and that is the whole fix:
; `mangleDecl` rewrites `fn` and `::` declarations, so `Mod::f`
; resolved by matching a rewritten name, and it does not rewrite
; `data` or `struct`, so `Mod::Ctor` matched nothing at all and every
; qualified constructor reference was a false AX3001 on a program
; stage0 compiles and runs.
;
; stage0 checks the module for data constructors and for functions and
; does NOT for struct constructors - `(Nope::Pt 1 2)` is accepted
; there, measured 2026-08-08. This is the stricter of the two answers,
; applied uniformly: a qualified reference names a module or it does
; not resolve.
(pub :: declMatches (-> String String String Int))
(pub fn (declMatches declMod declName ref)
  (let ((m (modOf ref)))
    (if (== m 0)
        (nameMatches declName ref)
        (if (&& (!= declMod 0)
                (&& (strEq declMod m) (strEq declName (bareOf ref))))
            1
            0))))

(pub :: bareOfFrom (-> String Int Int))
(pub fn (bareOfFrom s i)
  (if (< i 0)
      s
      (if (== (strByte s i) 36)
          (strSlice s (+ i 1) (- (strLen s) (+ i 1)))
          (bareOfFrom s (- i 1)))))

; ------------------------------------------------------------------
; The declaration walk: signatures park scope entries AS
; THE WALK REACHES THEM (order-sensitive, probed: a `set` in an
; earlier body does not see a later signature), and every entry-file
; function body is checked with its parameters typed by peeling the
; signature's arrows - a missing or non-arrow signature types every
; parameter Int; parameters past the arrows bind at fresh `_tN`. The
; inferred arrow is recorded only over a still-placeholder type: a
; declared signature is authoritative and never overwritten.
; ------------------------------------------------------------------
(pub :: tcWalkDecls (-> Int Int Int))
; The MERGED list, not the entry file's: stage0 type-checks the
; bodies of imported modules too, and renders each diagnostic against
; its own filename. `resolveDecls` accumulates depth-first, so the
; order is dependencies first and the entry file last - which is the
; order stage0 reports in (probed with two bad modules and a bad
; entry). Each declaration's `module` stamp picks the unit its spans
; index.
(pub fn (tcWalkDecls tc i)
  (let ((decls (memGetWord tc 10)))
    (if (>= i (vecLen decls))
        0
        (let ((d (vecGet decls i)))
          {
            (memSetWord tc 14 (unitIndexFor (memGetWord tc 13) (nodeModule d)))
            (let ((tag (nodeTag d)))
              (if (== tag TAG_D_SIG)
                  (pushScope (tcScope tc) (nodeA d) 0 (nodeSpan d)
                             (if (== (nodeTy d) 0) mkSilentWild (nodeTy d)))
                  ; The body first, then its tags - stage0's
                  ; `check_decls` runs `check_expr(body)` and only
                  ; then walks `axtags`, so every diagnostic from a
                  ; function's body precedes its AX3010.
                  (if (== tag TAG_D_FN)
                      { (tcCheckFn tc d) (checkAxtags tc d) }
                      0)))
            (tcWalkDecls tc (+ i 1))
          }))))

; Every AXTAG on one declaration, in source order.
(pub :: checkAxtags (-> Int Int Int))
(pub fn (checkAxtags tc d)
  (if (== (memGetWord d 7) 0)
      0
      (let ((_m (memSetWord tc 16 (nodeModule d)))
            (sc (bodyScopeOf tc d)))
        (let ((eff (collectEffects tc (nodeC d) sc))
              (_m0 (memSetWord tc 16 0)))
          (checkAxtagsFrom tc d (memGetWord d 7) 0 eff (bsEparams sc))))))

(pub :: checkAxtagsFrom (-> Int Int Int Int Int Int Int))
(pub fn (checkAxtagsFrom tc d tags i eff eparams)
  (if (>= i (vecLen tags))
      0
      {
        (checkOneAxtag tc d (memGetWord (vecGet tags i) 1) eff eparams)
        (checkAxtagsFrom tc d tags (+ i 1) eff eparams)
      }))

; `content` is what followed `;@axiom:` - either `key` or
; `key(value)`. Only `pure` and `effect` are validated; every other
; key is metadata stage0 records and does not check.
(pub :: checkOneAxtag (-> Int Int String Int Int Int))
(pub fn (checkOneAxtag tc d content eff eparams)
  (let ((op (strFindByte content 40 0)))
    (let ((key (if (< op 0) content (strSlice content 0 op)))
          (val (if (< op 0)
                   ""
                   (strSlice content (+ op 1)
                             (- (axtagCloseAt content) (+ op 1))))))
      (if (strEq key "pure")
          (axtagContradicted tc d "`pure` claim" eff)
      (if (strEq key "effect")
          (if (strEq val "pure")
              (axtagContradicted tc d "`effect(pure)` claim" eff)
              (axtagUnsupported tc d val eff eparams))
      0)))))

; The LAST `)`, scanned backwards, which is stage0's `rfind` - a
; value may contain parens of its own.
(pub :: axtagCloseAt (-> String Int))
(pub fn (axtagCloseAt content)
  (axtagCloseFrom content (- (strLen content) 1)))

(pub :: axtagCloseFrom (-> String Int Int))
(pub fn (axtagCloseFrom content i)
  (if (< i 0)
      (strLen content)
      (if (== (strByte content i) 41)
          i
          (axtagCloseFrom content (- i 1)))))

; ASCII case-insensitive equality, for matching `effect(console)`
; against a declared `Console`.
(pub :: strEqCI (-> String String Int))
(pub fn (strEqCI a b)
  (if (!= (strLen a) (strLen b))
      0
      (strEqCIFrom a b 0)))

(pub :: strEqCIFrom (-> String String Int Int))
(pub fn (strEqCIFrom a b i)
  (if (>= i (strLen a))
      1
      (if (== (lowerByte (strByte a i)) (lowerByte (strByte b i)))
          (strEqCIFrom a b (+ i 1))
          0)))

(pub :: lowerByte (-> Int Int))
(pub fn (lowerByte c)
  (if (&& (>= c 65) (<= c 90)) (+ c 32) c))

; A `pure` claim is contradicted by ANY concrete effect.
(pub :: axtagContradicted (-> Int Int String Int Int))
(pub fn (axtagContradicted tc d label eff)
  (if (== (vecLen (effSorted eff)) 0)
      0
      (emitAxtag tc d
        (strConcat (strConcat label " contradicted: body performs ")
                   (effJoin eff)))))

; A claimed effect the body does not perform. stage0 suppresses this
; when the effect COULD arrive through a callback - but only when the
; function has effect-transparent parameters, and this check only
; runs when it has none (the completeness gate), so every missing
; claim here is one stage0 also reports.
(pub :: axtagUnsupported (-> Int Int String Int Int Int))
(pub fn (axtagUnsupported tc d val eff eparams)
  (let ((want (axtagEffectOf tc val)))
    (if (== (strLen want) 0)
        0
        (if (== (effIn eff want) 1)
            0
            ; stage0 suppresses a claimed-but-absent effect when a
            ; CALLBACK could still supply it: the function has
            ; effect-transparent parameters and the effect names
            ; something that exists. An effect no declaration
            ; introduces can never arrive that way, so the
            ; suppression must not swallow it.
            (if (&& (> (vecLen eparams) 0) (== (axtagCouldExist tc want) 1))
                0
                (emitAxtag tc d
                  (strConcat (strConcat (strConcat
                    "`effect(" val) ")` claim unsupported: missing ")
                    (effRender want))))))))

; Only a CUSTOM effect can fail to exist; the built-ins always do.
(pub :: axtagCouldExist (-> Int String Int))
(pub fn (axtagCouldExist tc e)
  (if (strEq (strSlice e 0 2) "b:")
      1
      (if (== (findEffectDecl tc (effRender e)) 0) 0 1)))

; `effect(io)` names the built-in IO; a value naming no builtin is a
; custom effect, matched against the declarations case-insensitively
; and canonicalised to the DECLARED spelling - stage0's rule, and the
; reason `effect(console)` validates against `(effect Console ...)`.
(pub :: axtagEffectOf (-> Int String String))
(pub fn (axtagEffectOf tc val)
  (if (strEq val "io") (builtinEff "IO")
  (if (strEq val "mut") (builtinEff "Mut")
  (if (strEq val "div") (builtinEff "Div")
  (if (strEq val "alloc") (builtinEff "Alloc")
  (if (== (strLen val) 0) ""
  (customEff (canonicalEffectName tc val))))))))

(pub :: canonicalEffectName (-> Int String Int))
(pub fn (canonicalEffectName tc val)
  (let ((exact (findEffectDecl tc val)))
    (if (!= exact 0)
        val
        (let ((ci (findEffectDeclCI (tcEffects tc) val 0)))
          (if (== ci 0) val (nodeA ci))))))

(pub :: findEffectDeclCI (-> Int String Int Int))
(pub fn (findEffectDeclCI effs val i)
  (if (>= i (vecLen effs))
      0
      (let ((dd (vecGet effs i)))
        (if (== (strEqCI (nodeA dd) val) 1)
            dd
            (findEffectDeclCI effs val (+ i 1))))))

(pub :: emitAxtag (-> Int Int String Int))
(pub fn (emitAxtag tc d msg)
  (if (== (nodeSpan d) 0)
      0
      (emitDiag tc
        (mkDiag SEV_WARNING "AX3010" "axtag-mismatch"
                (nodeSpan d)
                (strConcat (strConcat (strConcat (strConcat
                  "AXTAG mismatch on `" (bareOf (nodeA d)))
                  "`: ") msg) "")
                0 0 0))))

(pub :: tcCheckFn (-> Int Int Int))
(pub fn (tcCheckFn tc d)
  ; Set BEFORE the entry lookup: `nodeA d` is already this module's
  ; mangled name, so the lookup is unaffected, but every reference the
  ; body makes below resolves module-locally.
  (let ((_m (memSetWord tc 16 (nodeModule d)))
        (ent (findFnEnt tc (nodeA d)))
        (params (nodeB d))
        (base (vecLen (tcScope tc))))
    {
      (memSetWord tc 6 base)
      ; The current function's parameters and their callability, for
      ; any handle site inside the body to seed its collector scope
      ; with. Without them a call through a parameter inside a handle
      ; would look like a call to an unknown global.
      (memSetWord tc 11 params)
      (memSetWord tc 12 (paramCallablesOf (if (== ent 0) 0 (memGetWord ent 1))
                                          (vecLen params)))
      (let ((sigTy (if (== ent 0) 0 (memGetWord ent 1)))
            (ptys vecNew))
        {
          (bindFnParams tc params ptys sigTy 0)
          (let ((bodyTy (checkExprH tc (nodeC d) 0)))
            {
              (checkDeclaredReturn tc d (peelArrows sigTy (vecLen params)) bodyTy)
              (if (&& (!= ent 0)
                      (&& (!= (memGetWord ent 1) 0)
                          (== (nodeTag (memGetWord ent 1)) TAG_T_VAR)))
                  (memSetWord ent 1
                              (ctorArrowOf ptys bodyTy (- (vecLen ptys) 1)))
                  0)
              (scopeTrunc (tcScope tc) base)
              (memSetWord tc 16 0)
            })
        })
    }))

; The signature's result type: its arrows peeled by as many
; parameters as the definition has. 0 when the signature runs out of
; arrows first, which is the case this cannot say anything about.
(pub :: peelArrows (-> Int Int Int))
(pub fn (peelArrows t n)
  (if (<= n 0)
      t
      (if (== t 0)
          0
          (if (!= (nodeTag t) TAG_T_ARR)
              0
              (peelArrows (nodeB t) (- n 1))))))

; A signature that promises a FUNCTION where the body answers a
; concrete non-function is refused, because the emitter believes both
; halves and they disagree about the shape of the call:
;
;   (:: g (-> Int Int Int))
;   (fn (g a) a)
;   (fn (main) (g 41 2))
;
; `check` used to accept that. The call site reads the signature -
; two parameters, one supplied to the definition, so the second is an
; application of the RESULT - and emits `call @g(41)` followed by a
; load of word 0 of the answer as a code pointer. The answer is 41.
; SIGSEGV, no output, exit 139, on a program `check` called OK.
;
; Deliberately narrow. `(-> Int (-> Int Int))` and `(-> Int Int Int)`
; are the SAME type - the parser right-folds - so arity alone cannot
; tell a curried return from a wrong one, and a function that really
; does return a closure (`tests/stdlib/140-function-values.ax`) must
; keep working. So when the declared result IS an arrow, what is
; refused is only a body whose type is a concrete non-arrow: not a
; type variable, not poison, not a silent wildcard, all of which mean
; "not known" rather than "known to be wrong".
;
; When the declared result is NOT an arrow this used to check nothing
; at all, and that was the louder half of the same defect. A signature
; naming a representation the body does not produce is believed by
; every reader downstream:
;
;   (:: f (-> Int Float))  (fn (f x) 42)
;   (println (fmtFloat (f 1)))  ->  0.000000   at exit 0
;
; `tyReprClash` below is what decides that case, and why it cannot
; simply be `tyCompat`.
(pub :: checkDeclaredReturn (-> Int Int Int Int Int))
(pub fn (checkDeclaredReturn tc d want got)
  (if (== want 0)
      0
  (if (== got 0)
      0
  (if (== (tyIsErr got) 1)
      0
  (if (== (tyIsSilentWild got) 1)
      0
  (if (== (tyIsSrcVar want) 1)
      ; A signature promising a type VARIABLE promises the CALLER a
      ; type the caller chooses, so the body may answer only that same
      ; variable. A different one, or any concrete type, breaks the
      ; promise the same way the `Float`-over-`Int` case two arms down
      ; does: every reader downstream believes the signature. A minted
      ; `_tN` body stays quiet, because it means "not known" rather
      ; than "known to be wrong".
      ;
      ;   (:: f (-> a b a))  (fn (f x y) y)   was accepted, answered y
      (if (== (nodeTag got) TAG_T_VAR)
          (if (== (tyIsSrcVar got) 1)
              (if (strEq (nodeA want) (nodeA got))
                  0
                  (emitMismatch tc (tyRender want) (tyRender got) (spanOf (nodeC d))))
              0)
          (emitMismatch tc (tyRender want) (tyRender got) (spanOf (nodeC d))))
  (if (== (nodeTag got) TAG_T_VAR)
      0
  (if (== (nodeTag want) TAG_T_ARR)
      (if (== (nodeTag got) TAG_T_ARR)
          0
          (emitMismatch tc (tyRender want) (tyRender got) (spanOf (nodeC d))))
      (if (== (tyReprClash want got) 1)
          (emitMismatch tc (tyRender want) (tyRender got) (spanOf (nodeC d)))
          0)))))))))

; 1 when `want` and `got` are two plain type constructors that cannot
; share a representation, so believing the signature over the body is
; a miscompile rather than a naming difference.
;
; This is deliberately NOT `tyCompat`. `Int` is this language's
; universal heap-handle type, and the whole tree relies on it: the
; compiler's own `(pub :: mkSpan (-> Int Int Int))` has the body
; `(Span start end)`, and `Job.ax`'s `jobPoolNew` answers a `JobPool`
; through an `Int` signature. Comparing a declared result with an
; inferred one through `tyCompat` reports 21 of this repository's 271
; files, every one of them a handle returned through `Int` on purpose.
;
; `Bool` and `Float` are the two names that are not handles. A `Float`
; declared over an `Int` body is a silent wrong answer, measured:
;
;   (:: f (-> Int Float))  (fn (f x) 42)
;   (println (fmtFloat (f 1)))  ->  0.000000   at exit 0
;
; because the integer bit pattern is read as a double and 42 is a
; denormal. `Bool` over `Int` is the same shape one step less loud -
; `(if (f 1) 7 9)` answers 7, having read 42 as true.
;
; Only argument-free constructors are compared. Anything applied
; (`Box Int`), any arrow, tuple, list or pointer, and anything either
; side does not know, stays permitted - the point is to name the two
; representations that cannot be punned, not to start checking types
; the handle convention deliberately conflates.
(pub :: tyReprClash (-> Int Int Int))
(pub fn (tyReprClash want got)
  (if (|| (!= (nodeTag want) TAG_T_CON) (!= (nodeTag got) TAG_T_CON))
      0
      (if (|| (!= (vecLen (nodeB want)) 0) (!= (vecLen (nodeB got)) 0))
          0
          (if (strEq (nodeA want) (nodeA got))
              0
              (if (|| (tyIsReprScalar (nodeA want)) (tyIsReprScalar (nodeA got)))
                  1
                  0)))))

(pub :: tyIsReprScalar (-> String Bool))
(pub fn (tyIsReprScalar name)
  (|| (strEq name "Bool") (strEq name "Float")))

; Parameter types: peel the signature's arrows left to right. The
; walk keeps its own cursor because a non-arrow signature - or none -
; means EVERY parameter is Int (stage0 2185, probed), while arrows
; that run out mid-list leave the REST at fresh `_tN` (stage0
; 2188-2196). The counter bumps once per parameter regardless of
; where the type came from - `_tN` names render, so the discipline is
; not a style choice.
(pub :: bindFnParams (-> Int Int Int Int Int Int))
(pub fn (bindFnParams tc params ptys sigTy i)
  (if (>= i (vecLen params))
      0
      (let ((isArrowSig (if (== sigTy 0)
                            0
                            (if (== (nodeTag sigTy) TAG_T_ARR) 1 0))))
        (let ((pty (if (== isArrowSig 1)
                       (nthParamTy sigTy i (freshTVar tc 0))
                       mkIntTy)))
          {
            (tcBumpCounter tc)
            (vecPush ptys pty)
            (pushScope (tcScope tc) (vecGet params i) 0 0 pty)
            (bindFnParams tc params ptys sigTy (+ i 1))
          }))))

; The i-th parameter position of an arrow chain, or `fallback` when
; the arrows run out first.
(pub :: nthParamTy (-> Int Int Int Int))
(pub fn (nthParamTy ty i fallback)
  (if (== ty 0)
      fallback
      (if (!= (nodeTag ty) TAG_T_ARR)
          fallback
          (if (== i 0)
              (nodeA ty)
              (nthParamTy (nodeB ty) (- i 1) fallback)))))

; ------------------------------------------------------------------
; Every diagnostic for one module, in stage0's emission order.
; ------------------------------------------------------------------
(pub :: checkModule (-> Int Int Int Int))
(pub fn (checkModule entryDecls allDecls units)
  (tcOut (checkModuleTc entryDecls allDecls units)))

; The same three passes, answering the CHECKER rather than its
; diagnostics alone - `symbols` needs the populated tables after a
; clean check, and the diagnostics are still there behind `tcOut`.
(pub :: checkModuleTc (-> Int Int Int Int))
(pub fn (checkModuleTc entryDecls allDecls units)
  (let ((tc (tcNew entryDecls allDecls units)))
    (let ((out (tcOut tc)))
      {
        ; Both indexes are built once, here, rather than by the
        ; passes - each is used by exactly one pass and neither
        ; survives the call.
        (checkDuplicates (dupIdxBuild entryDecls) entryDecls out 0)
        (checkImportNames entryDecls allDecls out 0)
        (checkMissingDefs (defIdxBuild allDecls) entryDecls out 0)
        (tcWalkDecls tc 0)
        tc
      })))
