; typecheck.ax — semantic analysis: name resolution, type checking.
;
; Walks the AST produced by parser.ax, building symbol tables and
; checking types. Uses the same tagged-node representation.
; Dependencies: core.ax, parser.ax, Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Vec)
(import parser)

; ------------------------------------------------------------------
; Symbol table entry.
; ------------------------------------------------------------------
(pub struct SymEntry (name : Int) (ty : Int) (kind : Int))

(pub :: SYM_FN     Int) (fn (SYM_FN)     0)
(pub :: SYM_DATA   Int) (fn (SYM_DATA)   1)
(pub :: SYM_STRUCT Int) (fn (SYM_STRUCT) 2)
(pub :: SYM_VAR    Int) (fn (SYM_VAR)    3)

; ------------------------------------------------------------------
; Type checking context: maps names to SymEntry handles.
; ------------------------------------------------------------------
(pub struct TCtx (syms : Int) (errors : Int))

(pub :: newTCtx Int)
(pub fn (newTCtx)
  (TCtx vecNew vecNew))

; ------------------------------------------------------------------
; Lookup a name in the symbol table. Returns 0 if not found.
; ------------------------------------------------------------------
(pub :: lookup (-> Int Int Int))
(pub fn (lookup ctx name)
  (lookupIn (memGetWord ctx 0) name 0))

(pub :: lookupIn (-> Int Int Int Int))
(pub fn (lookupIn syms name i)
  (if (>= i (vecLen syms))
      0
      (let ((entry (vecGet syms i)))
        (if (== (memGetWord entry 0) name)
            entry
            (lookupIn syms name (+ i 1))))))

; ------------------------------------------------------------------
; Check an expression node and return its type (as an ASTNode handle).
; ------------------------------------------------------------------
(pub :: checkExpr (-> Int Int Int))
(pub fn (checkExpr ctx node)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_E_INT)
        (mkNode TAG_NIL 0 0 0)   ; return Int type placeholder
    (if (== tag TAG_E_STR)
        (mkNode TAG_NIL 0 0 0)   ; return Str type placeholder
    (if (== tag TAG_E_VAR)
        (let ((name (nodeA node)))
          (let ((entry (lookup ctx name)))
            (if (== entry 0)
                (mkNode TAG_NIL 0 0 0)   ; error: undefined
                (memGetWord entry 1))))  ; return entry's type
    (if (== tag TAG_E_APP)
        (mkNode TAG_NIL 0 0 0)   ; placeholder
    (mkNode TAG_NIL 0 0 0)))))))  ; default

; ------------------------------------------------------------------
; Register a declaration in the context.
; ------------------------------------------------------------------
(pub :: registerDecl (-> Int Int Int Int Int))
(pub fn (registerDecl ctx name ty kind)
  (let ((entry (SymEntry name ty kind)))
    (vecPush (memGetWord ctx 0) (cast Int entry))))  ; returns vec handle, caller discards

; ------------------------------------------------------------------
; Check a declaration node.
; ------------------------------------------------------------------
(pub :: checkDecl (-> Int Int Int))
(pub fn (checkDecl ctx node)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_D_FN)
        (let ((name (nodeA node))
              (body (nodeB node)))
          {
            (registerDecl ctx name (mkNode TAG_NIL 0 0 0) SYM_FN)
            (checkExpr ctx body)
            0
          })
    (if (== tag TAG_D_STRUCT)
        (let ((name (nodeA node)))
          {
            (registerDecl ctx name (mkNode TAG_NIL 0 0 0) SYM_STRUCT)
            0
          })
    0))))

; ------------------------------------------------------------------
; Check a module (vec of declaration nodes).
; ------------------------------------------------------------------
(pub :: checkModule (-> Int Int))
(pub fn (checkModule decls)
  (let ((ctx (newTCtx)))
    (checkDecls ctx decls 0)
    ctx))

(pub :: checkDecls (-> Int Int Int Int))
(pub fn (checkDecls ctx decls i)
  (if (>= i (vecLen decls))
      0
      (let ((node (vecGet decls i)))
        {
          (checkDecl ctx node)
          (checkDecls ctx decls (+ i 1))
        })))
