(pub fn (tcCounter tc)
  (memGetWord tc 5))

(pub :: tcBumpCounter (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (tcBumpCounter tc)
  (memSetWord tc 5 (+ (memGetWord tc 5) 1)))

(pub :: tcFrameBase (-> Int Int))
