; typecheck.ax — semantic analysis in Axiom.
;
; This module was a stub for as long as stage1 could not say *where* a
; problem was: its AST carried no spans, so no diagnostic could name a
; location, and Phase 3's acceptance criterion is byte-identical AXDL
; against stage0 (docs/self-hosting.md). Declaration names now carry
; their span, `diag.ax` renders AXDL, and this module produces the
; diagnostics.
;
; WHAT IS CHECKED, and why these two first. Both are
; *declaration-level*: they need no type inference, no scope walk, and
; none of the resolution subtleties (entry-first bare names, poison
; propagation, tyvar-as-wildcard compatibility) that a naive
; reimplementation gets quietly wrong. Between them they exercise every
; AXDL field stage1 can currently produce - primary span, related span,
; help - which is what makes the differential gate meaningful rather
; than decorative.
;
;   AX3006 duplicate-definition — a name defined twice in one module.
;   AX3015 missing-definition   — an entry-file signature with no
;                                 definition behind it.
;
; ORDER MATTERS and is not incidental: stage0 runs
; `check_duplicate_definitions` over every declaration before
; `check_entry_signatures` runs over any, so every AX3006 precedes
; every AX3015 whatever order they appear in the source (verified by
; probe, in both source orderings). Two passes in that order is the
; whole rule.
;
; Dependencies: core.ax, parser.ax, diag.ax, Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Vec)
(import parser)
(import diag)

; ------------------------------------------------------------------
; Which namespace a declaration defines into, or 0 for a declaration
; that defines nothing. Values and types are separate namespaces in
; stage0, so `(data Foo ...)` and `(fn (Foo) ...)` do not collide.
;
; stage1's parser turns `type` and `trait` into TAG_NIL (parser.ax's
; skipUnknownDecl), so `fn` - and `define`, its documented synonym,
; which stage0 parses through the same function - is the only value
; definition that reaches here. `foreign` is parsed for its name alone
; (TAG_D_FOREIGN) because stage0 counts one as a definition, and
; skipping it made a signature beside a foreign binding look
; unsatisfied. RECORDED GAP: stage0 also counts `foreign` in the
; *duplicate* value namespace and `type` in the type namespace, so a
; duplicate `foreign` or `type` in the entry file is an AX3006 stage1
; stays silent about. Under-reporting, never over-reporting: the
; direction that cannot reject a valid program.
; ------------------------------------------------------------------
(pub :: NS_NONE Int)  (pub fn (NS_NONE)  0)
(pub :: NS_VALUE Int) (pub fn (NS_VALUE) 1)
(pub :: NS_TYPE Int)  (pub fn (NS_TYPE)  2)

(pub :: declNamespace (-> Int Int))
(pub fn (declNamespace tag)
  (if (== tag TAG_D_FN)
      NS_VALUE
  (if (|| (== tag TAG_D_DATA) (== tag TAG_D_STRUCT))
      NS_TYPE
      NS_NONE)))

; ------------------------------------------------------------------
; Index of the first declaration before `i` that defines the same name
; in the same namespace, or -1.
;
; The FIRST one, not the nearest: stage0 records a name's first span
; and never overwrites it, so three definitions of `main` produce two
; diagnostics that both point back at the first (verified by probe).
; ------------------------------------------------------------------
(pub :: firstDefiner (-> Int Int Int Int Int))
(pub fn (firstDefiner decls i ns name)
  (firstDefinerFrom decls 0 i ns name))

(pub :: firstDefinerFrom (-> Int Int Int Int Int Int))
(pub fn (firstDefinerFrom decls j i ns name)
  (if (>= j i)
      (- 0 1)
      (let ((d (vecGet decls j)))
        (if (&& (== (declNamespace (nodeTag d)) ns)
                (strEq (nodeA d) name))
            j
            (firstDefinerFrom decls (+ j 1) i ns name)))))

; ------------------------------------------------------------------
; Pass 1: duplicate definitions.
;
; Only the entry file's declarations are examined. stage0 keys this
; check by (name, module) - a name defined once per module in two
; modules is legal, and that is the ambiguity check's business, not
; this one - and stage1's merged declaration list does not record which
; module each declaration came from. Checking the entry file alone is
; the sound subset: it reports exactly the duplicates stage0 reports
; for a single-file program and never invents one, which is the
; property that matters, since a checker that rejects the compiler's
; own source is worse than no checker. Duplicates *inside an imported
; module* go unreported until declarations carry their origin.
; ------------------------------------------------------------------
(pub :: checkDuplicates (-> Int Int Int Int))
(pub fn (checkDuplicates decls out i)
  (if (>= i (vecLen decls))
      out
      (let ((d (vecGet decls i)))
        (let ((ns (declNamespace (nodeTag d))))
          (if (== ns NS_NONE)
              (checkDuplicates decls out (+ i 1))
              (let ((name (nodeA d)))
                (let ((j (firstDefiner decls i ns name)))
                  (if (< j 0)
                      (checkDuplicates decls out (+ i 1))
                      {
                        (vecPush out
                          (mkDiag SEV_ERROR "AX3006" "duplicate-definition"
                                  (nodeSpan d)
                                  (strConcat (strConcat "duplicate definition `" name) "`")
                                  (nodeSpan (vecGet decls j))
                                  (strConcat (strConcat "`" name) "` first defined here")
                                  "rename one of the definitions, or remove the duplicate"))
                        (checkDuplicates decls out (+ i 1))
                      }))))))))

; ------------------------------------------------------------------
; Pass 2: a signature with no definition behind it.
;
; The signatures examined are the entry file's; the definitions that
; satisfy them come from ANY module, exactly as stage0 does it - an
; entry-file signature over an imported definition is the same
; signature-then-definition pattern with the definition arriving
; through an import.
; ------------------------------------------------------------------
; Does `full` name the definition an entry-file signature for `bare`
; is looking for?
;
; Not string equality, because by the time the checker runs, import
; resolution has rewritten every *imported* declaration's name in place
; to `Mod$name` (codegen.ax's `mangleDecl`). Entry-file declarations
; keep their bare name. A signature in the entry file for a function
; that arrives through an import - which stage0 accepts, counting
; definitions from any module - therefore never matched, and every such
; program drew a false AX3015.
(pub :: nameMatches (-> Int Int Int))
(pub fn (nameMatches full bare)
  (if (strEq full bare)
      1
      (let ((m (strLen full))
            (n (strLen bare)))
        (if (<= m (+ n 1))
            0
            (if (&& (== (strByte full (- (- m n) 1)) 36)
                    (strEq (strSlice full (- m n) n) bare))
                1
                0)))))

(pub :: isDefined (-> Int Int Int Int))
(pub fn (isDefined allDecls name i)
  (if (>= i (vecLen allDecls))
      0
      (let ((d (vecGet allDecls i)))
        (if (&& (|| (== (nodeTag d) TAG_D_FN) (== (nodeTag d) TAG_D_FOREIGN))
                (== (nameMatches (nodeA d) name) 1))
            1
            (isDefined allDecls name (+ i 1))))))

(pub :: checkMissingDefs (-> Int Int Int Int Int))
(pub fn (checkMissingDefs entryDecls allDecls out i)
  (if (>= i (vecLen entryDecls))
      out
      (let ((d (vecGet entryDecls i)))
        (if (!= (nodeTag d) TAG_D_SIG)
            (checkMissingDefs entryDecls allDecls out (+ i 1))
            (let ((name (nodeA d)))
              (if (== (isDefined allDecls name 0) 1)
                  (checkMissingDefs entryDecls allDecls out (+ i 1))
                  {
                    (vecPush out
                      (mkDiag SEV_ERROR "AX3015" "missing-definition"
                              (nodeSpan d)
                              (strConcat (strConcat "`" name)
                                         "` has a signature but no definition")
                              0 0
                              "add the definition, or if it lives in another module, mark that definition `pub` so the import carries it"))
                    (checkMissingDefs entryDecls allDecls out (+ i 1))
                  }))))))

; ------------------------------------------------------------------
; Pass 3: partial application (AX3013).
;
; A top-level function applied to fewer arguments than its definition
; declares has no runtime representation - a call site would simply
; omit the missing arguments and the callee would read whatever was in
; the argument registers - so stage0 refuses it rather than
; miscompiling it. stage1 emitted the same broken code silently.
;
; The span is the application's, which is its HEAD's: stage0's
; `Expr::span()` recurses to the function side of an `EApp`, so the
; report points at `f` in `(f 1)`. `mkEApp` copies that span at
; construction, which is what makes this checkable at all.
;
; Two things this deliberately does NOT do, both in the
; under-reporting direction:
;
;   * Only a head that resolves to a `fn` with a known parameter count
;     is measured. stage0 also measures builtins and foreign bindings
;     through their arrow depth; stage1 keeps no type structure for a
;     signature, so it has no arrow to count.
;   * A head shadowed by a local is skipped, as stage0 skips a
;     frame-local head - a local may hold a one-parameter function
;     returning a closure, and only that shape survives stepwise
;     application, so its saturation is not statically knowable.
; ------------------------------------------------------------------

; Parameter count of the top-level `fn` named `name`, or -1.
(pub :: fnArity (-> Int Int Int Int))
(pub fn (fnArity decls name i)
  (if (>= i (vecLen decls))
      (- 0 1)
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN) (== (nameMatches (nodeA d) name) 1))
            (vecLen (nodeB d))
            (fnArity decls name (+ i 1))))))

(pub :: scopeHas (-> Int Int Int Int))
(pub fn (scopeHas scope name i)
  (if (>= i (vecLen scope))
      0
      (if (strEq (vecGet scope i) name)
          1
          (scopeHas scope name (+ i 1)))))

; Drop `scope` back to `n` entries - the walk pushes binders on the way
; in and truncates on the way out.
(pub :: scopeTrunc (-> Int Int Int))
(pub fn (scopeTrunc scope n)
  (if (<= (vecLen scope) n)
      0
      { (vecPop scope) (scopeTrunc scope n) }))

; Bind every variable a match pattern introduces. A pattern parses as
; an expression, so `(Cons h t)` is an application whose head names the
; constructor and whose arguments are the binders; a bare identifier is
; itself a binder, which is stage0's rule.
(pub :: bindPattern (-> Int Int Int))
(pub fn (bindPattern pat scope)
  (let ((tag (nodeTag pat)))
    (if (== tag TAG_E_VAR)
        { (vecPush scope (nodeA pat)) 0 }
        (if (== tag TAG_E_APP)
            { (bindPatternArgs pat scope) 0 }
            0))))

; The arguments of a constructor pattern, left to right; the head is
; the constructor and binds nothing.
(pub :: bindPatternArgs (-> Int Int Int))
(pub fn (bindPatternArgs pat scope)
  (if (== (nodeTag pat) TAG_E_APP)
      {
        (bindPatternArgs (nodeA pat) scope)
        (bindPattern (nodeB pat) scope)
        0
      }
      0))

; How many arguments an application spine supplies, and its head.
(pub :: spineArgs (-> Int Int Int))
(pub fn (spineArgs e acc)
  (if (== (nodeTag e) TAG_E_APP)
      (spineArgs (nodeA e) (+ acc 1))
      acc))

(pub :: spineHead (-> Int Int))
(pub fn (spineHead e)
  (if (== (nodeTag e) TAG_E_APP)
      (spineHead (nodeA e))
      e))

(pub :: checkExpr (-> Int Int Int Int Int Int))
(pub fn (checkExpr decls adecls scope e out)
  (let ((tag (nodeTag e)))
    (if (== tag TAG_E_VAR)
        (checkVarRef adecls scope e out)
    (if (== tag TAG_E_APP)
        ; Once per SPINE, at its root. Recursing into `(nodeA e)` as
        ; an expression would re-enter the same spine one argument
        ; shorter and report it again for every prefix - `(f a b c)`
        ; drew three diagnostics, two of them describing calls the
        ; source never made. stage0 says "runs once per spine, at the
        ; root" for the same reason.
        {
          (checkSpine decls adecls scope e out)
          ; `(cast Type v)`, `(sizeof Type)` and `(alignof Type)` put a
          ; TYPE where an argument goes, and a type name is not a
          ; variable reference - `(cast Int x)` would otherwise report
          ; `Int` as undefined, which it did, on the compiler's own
          ; source, in three files.
          (checkSpineParts decls adecls scope e out
                           (typeArgHead (spineHead e)))
          0
        }
    (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
        (let ((n (vecLen scope)))
          {
            (checkExpr decls adecls scope (nodeB e) out)
            (vecPush scope (nodeA e))
            (checkExpr decls adecls scope (nodeC e) out)
            (scopeTrunc scope n)
            0
          })
    (if (== tag TAG_E_LAM)
        (let ((n (vecLen scope)))
          {
            (bindNames (nodeA e) scope 0)
            (checkExpr decls adecls scope (nodeB e) out)
            (scopeTrunc scope n)
            0
          })
    (if (== tag TAG_E_IF)
        {
          (checkExpr decls adecls scope (nodeA e) out)
          (checkExpr decls adecls scope (nodeB e) out)
          (checkExpr decls adecls scope (nodeC e) out)
          0
        }
    (if (== tag TAG_E_BEGIN)
        (checkExprVec decls adecls scope (nodeA e) out 0)
    (if (== tag TAG_E_MATCH)
        {
          (checkExpr decls adecls scope (nodeA e) out)
          (checkArms decls adecls scope (nodeB e) out 0)
          0
        }
    (if (== tag TAG_E_WHILE)
        {
          (checkExpr decls adecls scope (nodeA e) out)
          (checkExprVec decls adecls scope (nodeB e) out 0)
          0
        }
    (if (== tag TAG_E_SET)
        {
          ; The assigned NAME is a reference too. An unknown one is
          ; AX3001 - with candidates drawn from scope alone, which is
          ; what stage0 offers here; a known-but-immutable target is
          ; AX3012 instead, which stage1 still reports only at
          ; emission and not as a diagnostic.
          (checkSetTarget adecls scope e out)
          (checkExpr decls adecls scope (nodeB e) out)
          0
        }
    (if (== tag TAG_E_SETF)
        {
          (checkExpr decls adecls scope (nodeA e) out)
          (checkExpr decls adecls scope (nodeC e) out)
          0
        }
    (if (== tag TAG_E_FIELD)
        (checkExpr decls adecls scope (nodeA e) out)
    0)))))))))))))

; The arguments of an application spine, plus its head when the head
; is something with an inside (a lambda, a parenthesised expression) -
; a bare name has nothing to walk.
; Does this head take a type as its first argument?
(pub :: typeArgHead (-> Int Int))
(pub fn (typeArgHead head)
  (if (!= (nodeTag head) TAG_E_VAR)
      0
      (let ((n (nodeA head)))
        (if (|| (strEq n "cast")
                (|| (strEq n "sizeof") (strEq n "alignof")))
            1
            0))))

(pub :: checkSpineParts (-> Int Int Int Int Int Int Int))
(pub fn (checkSpineParts decls adecls scope e out skipFirst)
  (if (== (nodeTag e) TAG_E_APP)
      {
        (checkSpineParts decls adecls scope (nodeA e) out skipFirst)
        ; The innermost application holds argument zero, which is the
        ; type position for the forms that have one.
        (if (&& (== skipFirst 1) (!= (nodeTag (nodeA e)) TAG_E_APP))
            0
            (checkExpr decls adecls scope (nodeB e) out))
        0
      }
      (if (== (nodeTag e) TAG_E_VAR)
          (checkVarRef adecls scope e out)
          (checkExpr decls adecls scope e out))))

; One variable reference. Known if it is locally bound, declared
; anywhere in the resolved module, or one of the always-in-scope
; builtins - operators, `true`/`false`, `cast`/`sizeof`/`alignof`, and
; anything beginning `__`, which is every primitive.
(pub :: checkVarRef (-> Int Int Int Int Int))
(pub fn (checkVarRef adecls scope e out)
  (let ((name (nodeA e)))
    (if (|| (== (scopeHas scope name 0) 1)
            (|| (== (isBuiltinName name) 1)
                (== (isDeclaredName adecls name) 1)))
        0
        (let ((best (newBest)))
          {
            (offerScope best name scope 0)
            (offerDecls best name adecls 0)
            (vecPush out
              (let ((msg (strConcat (strConcat "undefined variable `" name) "`")))
                (if (== (memGetWord best 0) 0)
                    (mkDiag SEV_ERROR "AX3001" "undefined-variable"
                            (nodeSpan e) msg 0 0
                            "variables must be defined (via `define`/`fn`, a `let` binding, or a lambda parameter) before they are used; check for typos")
                    (mkDiagFix SEV_ERROR "AX3001" "undefined-variable"
                               (nodeSpan e) msg 0 0
                               (strConcat (strConcat
                                 "a similarly named binding `" (memGetWord best 0))
                                 "` is in scope; did you mean this?")
                               (nodeSpan e) (memGetWord best 0)))))
            0
          }))))

(pub :: checkSetTarget (-> Int Int Int Int Int))
(pub fn (checkSetTarget adecls scope e out)
  (let ((name (nodeA e)))
    (if (|| (== (scopeHas scope name 0) 1)
            (|| (== (isBuiltinName name) 1)
                (== (isDeclaredName adecls name) 1)))
        0
        (let ((best (newBest)))
          {
            (offerScope best name scope 0)
            (vecPush out
              (let ((msg (strConcat (strConcat "undefined variable `" name) "`")))
                (if (== (memGetWord best 0) 0)
                    (mkDiag SEV_ERROR "AX3001" "undefined-variable"
                            (nodeSpan e) msg 0 0
                            "variables must be defined (via `define`/`fn`, a `let` binding, or a lambda parameter) before they are used; check for typos")
                    (mkDiagFix SEV_ERROR "AX3001" "undefined-variable"
                               (nodeSpan e) msg 0 0
                               (strConcat (strConcat
                                 "a similarly named binding `" (memGetWord best 0))
                                 "` is in scope; did you mean this?")
                               (nodeSpan e) (memGetWord best 0)))))
            0
          }))))

(pub :: checkExprVec (-> Int Int Int Int Int Int Int))
(pub fn (checkExprVec decls adecls scope v out i)
  (if (>= i (vecLen v))
      0
      {
        (checkExpr decls adecls scope (vecGet v i) out)
        (checkExprVec decls adecls scope v out (+ i 1))
      }))

(pub :: bindNames (-> Int Int Int Int))
(pub fn (bindNames v scope i)
  (if (>= i (vecLen v))
      0
      { (vecPush scope (vecGet v i)) (bindNames v scope (+ i 1)) }))

(pub :: checkArms (-> Int Int Int Int Int Int Int))
(pub fn (checkArms decls adecls scope arms out i)
  (if (>= i (vecLen arms))
      0
      (let ((arm (vecGet arms i))
            (n (vecLen scope)))
        {
          (bindPattern (nodeA arm) scope)
          (checkExpr decls adecls scope (nodeB arm) out)
          (scopeTrunc scope n)
          (checkArms decls adecls scope arms out (+ i 1))
        })))

; One application spine, at its root.
(pub :: checkSpine (-> Int Int Int Int Int Int))
(pub fn (checkSpine decls adecls scope e out)
  (let ((head (spineHead e)))
    (if (!= (nodeTag head) TAG_E_VAR)
        0
        (let ((name (nodeA head)))
          (if (== (scopeHas scope name 0) 1)
              0
              (let ((want (fnArity decls name 0))
                    (got (spineArgs e 0)))
                (if (< want 0)
                    0
                    (if (>= got want)
                        0
                        {
                          (vecPush out
                            (mkDiag SEV_ERROR "AX3013" "partial-application"
                                    (nodeSpan e)
                                    (strConcat (strConcat (strConcat (strConcat (strConcat
                                      "partial application of `" name)
                                      "`: it takes ") (decStr want))
                                      " argument(s) and ") (strConcat (decStr got) " were supplied"))
                                    0 0
                                    "bind the missing arguments with a lambda: `(lambda (y) (f x y))` builds the value `(f x)` would mean"))
                          0
                        }))))))))

(pub :: checkBodies (-> Int Int Int Int Int))
(pub fn (checkBodies decls adecls out i)
  (if (>= i (vecLen decls))
      out
      (let ((d (vecGet decls i)))
        (if (!= (nodeTag d) TAG_D_FN)
            (checkBodies decls adecls out (+ i 1))
            (let ((scope vecNew))
              {
                (bindNames (nodeB d) scope 0)
                (checkExpr decls adecls scope (nodeC d) out)
                (checkBodies decls adecls out (+ i 1))
              })))))

; ------------------------------------------------------------------
; Pass 4: undefined variables (AX3001).
;
; The most common diagnostic there is, and the one with the most ways
; to be WRONG in the direction that matters. Every category of name a
; program may legally reference has to be recognised here, because a
; name this pass fails to know about is a valid program stage1
; rejects - and the compiler's own source is the first casualty. The
; gate's sweep over `self_host/` and `stdlib/` is the check that
; matters, not the corpus.
;
; stage0 reports these in plain traversal order, left to right, and
; reports the SAME name once per occurrence rather than once per name
; (probed: `zzz2` twice in one expression draws two diagnostics). The
; walk this rides on already visits in that order.
; ------------------------------------------------------------------

; Operators, keywords and forms that are always in scope and are not
; declarations. Primitives are covered by the `__` prefix instead of
; being listed: every one of them has it, and stage0's own suggestion
; machinery skips `__` names for the same reason.
(pub :: isBuiltinName (-> Int Int))
(pub fn (isBuiltinName n)
  (if (strStartsWith n "__") 1
  (if (strEq n "+") 1 (if (strEq n "-") 1 (if (strEq n "*") 1
  (if (strEq n "/") 1 (if (strEq n "%") 1 (if (strEq n "&") 1
  (if (strEq n "|") 1 (if (strEq n "^") 1 (if (strEq n "<<") 1
  (if (strEq n ">>") 1 (if (strEq n "==") 1 (if (strEq n "!=") 1
  (if (strEq n "<") 1 (if (strEq n ">") 1 (if (strEq n "<=") 1
  (if (strEq n ">=") 1 (if (strEq n "&&") 1 (if (strEq n "||") 1
  (if (strEq n "true") 1 (if (strEq n "false") 1
  (if (strEq n "cast") 1 (if (strEq n "sizeof") 1 (if (strEq n "alignof") 1
  ; `handle` is a keyword form stage1's parser does not implement, so
  ; `(handle body (E) h)` arrives here as an ordinary application with
  ; `handle` as its head. stage1 cannot lower the effect system, but
  ; reporting its keyword as an undefined *variable* is a false
  ; positive on a program stage0 compiles silently.
  (if (strEq n "handle") 1
  ; The built-in effect names. A `handle` list is parsed as an
  ; application by a parser with no `handle` form, so `(Console IO
  ; Alloc)` puts each of these where an argument goes.
  (if (strEq n "IO") 1 (if (strEq n "Pure") 1 (if (strEq n "Alloc") 1
  (if (strEq n "Mut") 1 (if (strEq n "Div") 1 (if (strEq n "Err") 1
  0))))))))))))))))))))))))))))))))

; Is `n` declared anywhere in the resolved declaration list - as a
; function, a foreign binding, a data constructor, a struct (structs
; are constructors too), a macro, or a signature?
; `Option` is built in: stage0 registers it ahead of every
; user-declared type - which is why the first user constructor tag is
; 2, a fact stage1's codegen already relies on - so `None` and `Some`
; are in scope in every program without being declared in any of them.
(pub :: isBuiltinCtor (-> Int Int))
(pub fn (isBuiltinCtor n)
  (if (|| (strEq n "None") (strEq n "Some")) 1 0))

(pub :: isDeclaredName (-> Int Int Int))
(pub fn (isDeclaredName decls n)
  (if (== (isBuiltinCtor n) 1) 1 (declaredFrom decls n 0)))

(pub :: declaredFrom (-> Int Int Int Int))
(pub fn (declaredFrom decls n i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (let ((tag (nodeTag d)))
          (if (&& (|| (== tag TAG_D_FN)
                      (|| (== tag TAG_D_FOREIGN)
                          (|| (== tag TAG_D_STRUCT)
                              (|| (== tag TAG_D_MACRO) (== tag TAG_D_SIG)))))
                  (== (nameMatches (nodeA d) n) 1))
              1
              (if (&& (== tag TAG_D_DATA) (== (ctorNamed (nodeB d) n 0) 1))
                  1
                  ; An effect declares its own name - which appears in
                  ; a `handle` list - and one callable per operation.
                  (if (&& (== tag TAG_D_EFFECT)
                          (|| (== (nameMatches (nodeA d) n) 1)
                              (== (opNamed (nodeB d) n 0) 1)))
                      1
                      (declaredFrom decls n (+ i 1)))))))))

(pub :: opNamed (-> Int Int Int Int))
(pub fn (opNamed ops n i)
  (if (>= i (vecLen ops))
      0
      (if (strEq (vecGet ops i) n)
          1
          (opNamed ops n (+ i 1)))))

(pub :: ctorNamed (-> Int Int Int Int))
(pub fn (ctorNamed ctors n i)
  (if (>= i (vecLen ctors))
      0
      (if (== (nameMatches (nodeA (vecGet ctors i)) n) 1)
          1
          (ctorNamed ctors n (+ i 1)))))

; ------------------------------------------------------------------
; The suggestion. Byte-identical output means reproducing stage0's
; `suggest_closest` exactly: Levenshtein distance, a threshold of
; `(min(len)/2)` clamped to [1,2], candidates equal to the name or
; beginning `__` skipped, and the FIRST strictly-smaller distance
; winning - so the order candidates are visited in decides ties.
; stage0 visits scope, then functions, then constructors; this visits
; locals, then declarations in order, which is the same sequence.
; ------------------------------------------------------------------
(pub :: levenshtein (-> Int Int Int))
(pub fn (levenshtein a b)
  (let ((la (strLen a))
        (lb (strLen b)))
    (let ((prev (memAlloc (* 8 (+ lb 1))))
          (cur (memAlloc (* 8 (+ lb 1)))))
      {
        (levInitRow prev lb 0)
        (levRows a b la lb prev cur 1)
      })))

(pub :: levInitRow (-> Int Int Int Int))
(pub fn (levInitRow row lb j)
  (if (> j lb)
      0
      { (memSetWord row j j) (levInitRow row lb (+ j 1)) }))

(pub :: levRows (-> Int Int Int Int Int Int Int Int))
(pub fn (levRows a b la lb prev cur i)
  (if (> i la)
      (memGetWord prev lb)
      {
        (memSetWord cur 0 i)
        (levCols a b lb prev cur i 1)
        (levCopyRow cur prev lb 0)
        (levRows a b la lb prev cur (+ i 1))
      }))

(pub :: levCols (-> Int Int Int Int Int Int Int Int))
(pub fn (levCols a b lb prev cur i j)
  (if (> j lb)
      0
      (let ((cost (if (== (strByte a (- i 1)) (strByte b (- j 1))) 0 1)))
        (let ((del (+ (memGetWord prev j) 1))
              (ins (+ (memGetWord cur (- j 1)) 1))
              (sub (+ (memGetWord prev (- j 1)) cost)))
          {
            (memSetWord cur j (minOf3 del ins sub))
            (levCols a b lb prev cur i (+ j 1))
          }))))

(pub :: minOf3 (-> Int Int Int Int))
(pub fn (minOf3 a b c)
  (let ((m (if (< a b) a b)))
    (if (< m c) m c)))

(pub :: levCopyRow (-> Int Int Int Int Int))
(pub fn (levCopyRow src dst lb j)
  (if (> j lb)
      0
      { (memSetWord dst j (memGetWord src j)) (levCopyRow src dst lb (+ j 1)) }))

; `(min(len)/2)` clamped into [1,2], stage0's rule verbatim.
(pub :: suggestThreshold (-> Int Int Int))
(pub fn (suggestThreshold la lb)
  (let ((m (if (< la lb) la lb)))
    (let ((t (/ m 2)))
      (if (< t 1) 1 (if (> t 2) 2 t)))))

; A cell holding the best candidate found so far and its distance, so
; the search can run over two sequences without rebuilding a list.
(pub :: newBest Int)
(pub fn (newBest)
  (let ((c (memAlloc 16)))
    { (memSetWord c 0 0) (memSetWord c 1 999) c }))

(pub :: offerCandidate (-> Int Int Int Int))
(pub fn (offerCandidate best name cand)
  (if (|| (strEq cand name) (strStartsWith cand "__"))
      0
      (let ((d (levenshtein name cand)))
        (if (&& (<= d (suggestThreshold (strLen name) (strLen cand)))
                (< d (memGetWord best 1)))
            { (memSetWord best 0 cand) (memSetWord best 1 d) 0 }
            0))))

(pub :: offerScope (-> Int Int Int Int Int))
(pub fn (offerScope best name scope i)
  (if (>= i (vecLen scope))
      0
      { (offerCandidate best name (vecGet scope i))
        (offerScope best name scope (+ i 1)) }))

; stage0 offers candidates in three separate passes - everything in
; scope, then every function, then every constructor - and the FIRST
; strictly-smaller distance wins, so a single interleaved walk would
; break ties differently and print a different name. The builtin
; `Option` constructors lead the constructor pass because stage0
; registers that type before any declared one.
(pub :: offerDecls (-> Int Int Int Int Int))
(pub fn (offerDecls best name decls i)
  {
    (offerFns best name decls 0)
    ; `Some` before `None`: a constructor is registered as a function
    ; in stage0 too, and functions are offered before constructors, so
    ; the one-argument `Some` is reached first. Both sit at distance 2
    ; from `nope`, and the first strictly-smaller distance wins, so
    ; this order is the whole difference between printing `Some` and
    ; printing `None`. Determined by probe, not by reading.
    (offerCandidate best name "Some")
    (offerCandidate best name "None")
    (offerAllCtors best name decls 0)
    0
  })

(pub :: offerFns (-> Int Int Int Int Int))
(pub fn (offerFns best name decls i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (let ((tag (nodeTag d)))
          {
            (if (|| (== tag TAG_D_FN)
                    (|| (== tag TAG_D_FOREIGN) (== tag TAG_D_STRUCT)))
                (offerCandidate best name (bareOf (nodeA d)))
                0)
            (offerFns best name decls (+ i 1))
          }))))

(pub :: offerAllCtors (-> Int Int Int Int Int))
(pub fn (offerAllCtors best name decls i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        {
          (if (== (nodeTag d) TAG_D_DATA)
              (offerCtors best name (nodeB d) 0)
              0)
          (offerAllCtors best name decls (+ i 1))
        })))

(pub :: offerCtors (-> Int Int Int Int Int))
(pub fn (offerCtors best name ctors i)
  (if (>= i (vecLen ctors))
      0
      { (offerCandidate best name (bareOf (nodeA (vecGet ctors i))))
        (offerCtors best name ctors (+ i 1)) }))

; A declaration's source-spelled name: import resolution rewrites an
; imported one to `Mod$name` in place, and a suggestion has to read
; back as something the programmer could type.
(pub :: bareOf (-> Int Int))
(pub fn (bareOf s) (bareOfFrom s (- (strLen s) 1)))

(pub :: bareOfFrom (-> Int Int Int))
(pub fn (bareOfFrom s i)
  (if (< i 0)
      s
      (if (== (strByte s i) 36)
          (strSlice s (+ i 1) (- (strLen s) (+ i 1)))
          (bareOfFrom s (- i 1)))))

; ------------------------------------------------------------------
; Every diagnostic for one module, in stage0's emission order.
; ------------------------------------------------------------------
(pub :: checkModule (-> Int Int Int))
(pub fn (checkModule entryDecls allDecls)
  (let ((out vecNew))
    {
      (checkDuplicates entryDecls out 0)
      (checkMissingDefs entryDecls allDecls out 0)
      (checkBodies entryDecls allDecls out 0)
      out
    }))
