              "AX3060"
              "region-escape"
              (nodeSpan body)
              "region safety cannot be proved: this function exceeds the lifetime origin capacity"
              0
              0
              "split this function into smaller functions so each region has a distinct tracked origin"))
            0)
          (memSetWord (rgnFacts rc) 5 1)
          0
        }
        (let ((bit (<< 1 (+ (+ n 1) k))))
          {
            (if (== k (vecLen forms))
              {
                (vecPush forms body)
                (vecPush (rgnFormParents rc) savedRid)
                (vecPushStr (rgnFormNames rc) name)
                0
              }
              0)
            (memSetWord rc 7 bit)
            (memSetWord rc 8 (+ (+ (vecLen (rgnRegionNames rc)) 1) k))
            (let ((v (rgnExpr rc body)))
              {
                (memSetWord rc 7 savedBit)
                (memSetWord rc 8 savedRid)
                (if (!= (& v bit) 0)
                  (| (& v (^ v bit)) savedBit)
                  v)
              })
          }))}))

; A recovery point, `(__axiom_recover mark thunk)`: an abort resets the
; arena to `mark`, reclaiming everything the thunk allocated, so the
; thunk is an extent reclaimed as a whole, exactly as a region is, and
; it is walked as one. What it allocates may be stored nowhere older:
; the reclamation audit's probe grew a `Vec` built before the point
; inside the thunk, trapped, and read the reclaimed block afterwards
; through the safe surface (AN-42; `tests/diagnostics/1033-recover-escape.ax`).
; A normal return keeps the allocations, but a trap can come after any
; store, so the rule is the region's.
;
; The walk needs the thunk's body. A lambda written at the call has it;
; a top-level function captures nothing and is handed only an `Int`;
; anything else - a `let`-bound closure, a parameter - is a thunk this
; check can't see, and is AX3090. The answer is the status or the
; thunk's word, so it carries no origin.
(pub :: rgnRecoverForm (-> Int (Vec Int) Int Int))
(pub fn (rgnRecoverForm rc args span)
  (let ((thunk (vecGet args 1)))
    {
      (rgnExpr rc (vecGet args 0))
      (if (== (nodeTag thunk) TAG_E_LAM)
        (rgnFormWalk rc thunk "#recover")
        (if (&& (== (nodeTag thunk) TAG_E_VAR) (&& (< (rgnEnvFind rc (nodeAName thunk)) 0) (!= (findFnEnt (rgnTc rc) (nodeAName thunk)) 0)))
          0
          (if (|| (== span 0) (== (rgnReport rc) 0))
            0
            (emitDiag (rgnTc rc) (mkDiag
              SEV_ERROR
              "AX3090"
              "recover-thunk-unseen"
              span
              "a recovery point's thunk has to be a lambda written at the call, or a top-level function"
              0
              0
              "an abort reclaims everything the thunk allocated, so the thunk is held to storing none of it anywhere older; that is checked on a lambda written here, and a top-level function captures nothing. Write the lambda at the call")))))
      0
    }))

; ---- calls ----
(pub :: rgnApp (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnApp rc e)
  (let (
    (head (spineHead e))
    (args (spineArgVec e vecNew))
    (tc (rgnTc rc))
  )
    (if (!= (nodeTag head) TAG_E_VAR)
      (rgnUnknownCall rc args (spanOf e) (rgnExpr rc head))
      (let ((n (nodeAName head)))
        (if (>= (rgnEnvFind rc n) 0)
          (rgnUnknownCall rc args (spanOf e) (rgnExpr rc head))
          (if (&& (strEq n "__axiom_recover") (== (vecLen args) 2))
            (rgnRecoverForm rc args (spanOf e))
            (if (== (isCastLike n) 1)
              (rgnLastArg rc args)
              (if (!= (findCtor tc n) 0)
                (| (memGetWord rc 7) (rgnArgsUnion rc args 0 0))
                (if (!= (findStructIfConstruct tc n) 0)
                  (| (memGetWord rc 7) (rgnArgsUnion rc args 0 0))
                  (let ((ent (findFnEnt tc n)))
                    (if (== ent 0)
                      (rgnUnknownCall rc args (spanOf e) 0)
                      (if (== (memGetWord ent 3) 1)
                        (rgnBuiltinCall rc n args (spanOf e))
                        (if (== (memGetWord ent 4) 1)
                          (rgnUnknownCall rc args (spanOf e) 0)
                          (if (== (memGetWord ent 4) 2)
                            {
                              (rgnArgsUnion rc args 0 0)
                              (memGetWord rc 7)
                            }
                            (rgnKnownCall
                              rc
                              ent
                              n
                              args
                              (spanOf e)
                              e)))))))))))))))

(pub :: rgnLastArg (-> Int (Vec Int) Int))
(pub fn (rgnLastArg rc args)
  (if (== (vecLen args) 0)
    0
    (let (
      (mut i 0)
      (mut last 0)
    )
      {
        (while (< i (vecLen args))
          {
            (set last (rgnExpr rc (vecGet args i)))
            (set i (+ i 1))
          })
        last
      })))

; A callee the walk cannot read: assume it stores every argument into
; every argument and allocates its result. A closure may also read
; and write its captures, so those origins participate in both sides
; of the lifetime relation, including calls with no reference arguments.
(pub :: rgnUnknownCall (-> Int (Vec Int) Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnUnknownCall rc args span captures)
  (let (
    (masks (rgnIntVec))
    (mut i 0)
    (mut u captures)
  )
    {
      (while (< i (vecLen args))
        {
          (vecPush masks (rgnExpr rc (vecGet args i)))
          (set u (| u (vecGet masks i)))
          (set i (+ i 1))
        })
      (if (!= captures 0)
        {
          (rgnEmitEscape
            rc
            (rgnStoreBadMask rc (| u (memGetWord rc 7)) captures)
            span
            "the captures of a call the compiler cannot resolve"
            " - the call may store its arguments or fresh values into a capture"
            0)
          (rgnNoteFlow rc (| u (memGetWord rc 7)) captures "<unresolved call>")
        }
        0)
      (set i 0)
      (while (< i (vecLen args))
        {
          (if (!= (vecGet masks i) 0)
            {
              (rgnEmitEscape
                rc
                (rgnStoreBadMask rc (| u (memGetWord rc 7)) (vecGet masks i))
                span
                (concat (concat "argument " (fmtInt (+ i 1))) " of a call the compiler cannot resolve")
                " - a call through a parameter, a closure or a field is assumed to store every argument into every argument"
                0)
              (rgnNoteFlow rc (| u (memGetWord rc 7)) (vecGet masks i) "<unresolved call>")
            }
            0)
          (set i (+ i 1))
        })
      (if (== (memGetWord (rgnFacts rc) 5) 0)
        {
          (memSetWord (rgnFacts rc) 5 1)
          (memSetWord rc 14 1)
        }
        0)
      (| (memGetWord rc 7) u)
    }))

; A primitive with no body, classified by name. Stores and reads
; through a handle are the two shapes that matter; everything else
; answers a word.
(pub :: rgnBuiltinCall (-> Int String (Vec Int) Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnBuiltinCall rc n args span)
  (let (
    (masks (rgnIntVec))
    (mut i 0)
  )
    {
      (while (< i (vecLen args))
        {
          (vecPush masks (rgnExpr rc (vecGet args i)))
          (set i (+ i 1))
        })
      (if (|| (strEq n "__store64") (|| (strEq n "__atomic_store") (|| (strEq n "__atomic_cas") (strEq n "__atomic_add"))))
        (if (>= (vecLen masks) 2)
          (let ((v (vecGet masks (- (vecLen masks) 1))))
            {
              (rgnEmitEscape
                rc
                (rgnStoreBadMask rc v (vecGet masks 0))
                span
                (concat (concat "the block `" n) "` writes")
                ""
                (vecGet args (- (vecLen args) 1)))
              (rgnNoteFlow rc v (vecGet masks 0) "")
              0
            })
          0)
        (if (|| (strEq n "__load64") (|| (strEq n "__load8") (strEq n "__atomic_load")))
          (if (>= (vecLen masks) 1)
            (vecGet masks 0)
            0)
          (if (strEq n "__alloc")
            (memGetWord rc 7)
            (if (strEq n "__axiom_arena_reset_keeping")
              (if (>= (vecLen masks) 2)
                (vecGet masks 1)
                0)
              (if (strEq n "__call_word")
                (rgnUnknownCall rc args span 0)
                0)))))
    }))

; A user function: its signature's regions instantiate against the
; arguments, and its facts say what it stores where.
;
; `e` is the application node itself, carried so the post-fixpoint
; stamp walks can record a proven-fresh result on it (`nodeResWord`
; 0 to 2; never touching 1). Only `rgnApp` calls this, so the extra
; word moves one site.
(pub :: rgnKnownCall (-> Int Int String (Vec Int) Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnKnownCall rc ent spelled args span e)
  ; the entry's own name is the mangled one the declaration carries
  ; (`Vec$vecPush`); the spelling at the call may be bare or qualified
  (let (
    (masks (rgnIntVec))
    (callee (memGetWordStr ent 0))
    (sig (memGetWord ent 1))
    (f (memGetWord ent 8))
    (tc (rgnTc rc))
    (instNames (rgnStrVec))
    (instMasks (rgnIntVec))
    (mut i 0)
    (mut res 0)
    (mut ok 1)
  )
    {
      (while (< i (vecLen args))
        {
          (vecPush masks (rgnExpr rc (vecGet args i)))
          (set i (+ i 1))
        })
      ; 1. the annotated parameters: bind each region name to the
      ;    union of its arguments' origins, and every argument under
      ;    one name must carry exactly that union - two arguments in
      ;    two regions cannot both be `@r`.
      (set i 0)
      (while (< i (vecLen args))
        {
          (let ((rn (rgnParamRegion sig i)))
            (if (== rn 0)
              0
              (let ((k 
                (strVecIdx
                  instNames
                  (cast String rn))))
                (if (< k 0)
                  {
                    (vecPushStr
                      instNames
                      (cast String rn))
                    (vecPush instMasks (vecGet masks i))
                    0
                  }
                  {
                    (if (&& (== (rgnReport rc) 1) (== (rgnSameRegion rc (vecGet instMasks k) (vecGet masks i)) 0))
                      (emitDiag
                        tc
                        (mkDiag
                          SEV_ERROR
                          "AX3063"
                          "region-argument"
                          span
                          (concat
                            (concat
                              (concat
                                (concat (concat "`" (bareOf callee)) "` names one region `@")
                                (cast String rn))
                              "` for two of these arguments, and they do not live in the same region: ")
                            (concat (concat (rgnOriginText rc (rgnFirstBit (vecGet instMasks k))) " against ") (rgnOriginText rc (rgnFirstBit (vecGet masks i)))))
                          0
                          0
                          "a region parameter is instantiated ONCE per call, like a type variable; every argument annotated with it must live in that one region. Pass values from one region, or give the parameters different region names"))
                      0)
                    (vecSet instMasks k (| (vecGet instMasks k) (vecGet masks i)))
                    0
                  }))))
          (set i (+ i 1))
        })
      ; 2. the facts: what the callee stores through each parameter
      (if (== f 0)
        0
        {
          (set i 0)
          (while (< i (vecLen args))
            {
              (if (< i (memGetWord f 7))
                (let (
                  (fresh (!= (& (memGetWord f 1) (<< 1 i)) 0))
                  (from (vecGet (memGetWordVec f 2) i))
                  (into (concat (concat (concat (concat "parameter `" (rgnCalleeParamName tc callee i)) "` of `") (bareOf callee)) "`"))
                )
                  {
                    (if fresh
                      {
                        (rgnEmitEscape
                          rc
                          (rgnStoreBadMask rc (memGetWord rc 7) (vecGet masks i))
                          span
                          into
                          (concat (concat " - `" (bareOf callee)) "` stores a value it allocates into that parameter")
                          0)
                        (rgnNoteFlow rc (memGetWord rc 7) (vecGet masks i) callee)
                      }
                      0)
                    (let ((mut j 0))
                      (while (< j (vecLen args))
                        {
                          (if (!= (& from (<< 1 j)) 0)
                            {
                              (rgnEmitEscape
                                rc
                                (rgnStoreBadMask rc (vecGet masks j) (vecGet masks i))
                                span
                                into
                                (concat (concat (concat (concat " - `" (bareOf callee)) "` stores its parameter `") (rgnCalleeParamName tc callee j)) "` into it")
                                (vecGet args j))
                              (rgnNoteFlow rc (vecGet masks j) (vecGet masks i) callee)
                            }
                            0)
                          (set j (+ j 1))
                        }))
                  })
                0)
              (set i (+ i 1))
            })
          (if (!= (memGetWord f 5) 0)
            (if (== (memGetWord (rgnFacts rc) 5) 0)
              {
                (memSetWord (rgnFacts rc) 5 1)
                (memSetWord rc 14 1)
              }
              0)
            0)
        })
      ; 3. the result: the declared region if the signature names one,
      ;    else what the facts say - fresh, and/or some parameters'
      (let ((rr (tyRegion (rgnResultTy sig))))
        (if (!= rr 0)
          (let ((k 
            (strVecIdx
              instNames
              (cast String rr))))
            (if (< k 0)
              (memGetWord rc 7)
              (vecGet instMasks k)))
          (if (== f 0)
            (memGetWord rc 7)
            {
              (if (!= (memGetWord f 4) 0)
                (set res (memGetWord rc 7))
                0)
              (set i 0)
              (while (< i (vecLen args))
                {
                  (if (!= (& (memGetWord f 3) (<< 1 i)) 0)
                    (set res (| res (vecGet masks i)))
                    0)
                  (set i (+ i 1))
                })
              ; S4 slice 2's witness stamp: this call's answer is
              ; freshly allocated by the callee - its facts say the
              ; result derives from CUR0, from no HEAP parameter (a
              ; scalar-typed parameter contributes no alias: an `Int`
              ; field needs no release, so a cell built over words is
              ; still a fresh cell), and from no call the walk could
              ; not resolve - so record it on the node for codegen's
              ; elision. The call must be saturated (every parameter
              ; present, so no bit hides past the argument list); a
              ; partial application abstains. Upgrade only (0 to 2; a
              ; word answer stays 1), only on the post-fixpoint stamp
              ; walks (`rgnStamping`, word 40), never while facts are
              ; still moving, and never when truncation made every row
              ; a lower bound (word 28 is 2 then, not 1). An annotated
              ; result takes the branch above and is never stamped: it
              ; lives where the signature says, not in the current
              ; region, so no reset reclaims it. Over-stamping would
              ; leak a share, never free one early - and the RSS half
              ; of the gate watches the ratio - but the rule above is
              ; stated as the guarantee, not the tendency.
              ;
              ; No signature, no stamp: without declared parameter
              ; types there is nothing to prove scalar with, so a
              ; signature-less callee abstains rather than guessing.
              (if (== sig 0)
                (set ok 0)
                {
                  (set ok 1)
                  (set i 0)
                  (while (< i (vecLen args))
                    {
                      (if (&& (!= (& (memGetWord f 3) (<< 1 i)) 0) (== (rgTyScalar tc (nthParamTy sig i 0)) 0))
                        (set ok 0)
                        0)
                      (set i (+ i 1))
                    })
                  0
                })
              (if (&& (== (memGetWord tc 40) 1) (&& (== (memGetWord tc 28) 1) (&& (== (nodeResWord e) 0) (&& (!= (memGetWord f 4) 0) (&& (== (memGetWord f 5) 0) (&& (== (vecLen args) (memGetWord f 7)) (== ok 1)))))))
                (setNodeResWord e 2)
                0)
              res
            })))
    }))

; The set of region identities an origin mask stands in, as a mask
; over identities. A static value (origin mask 0) stands in none - it
; outlives every region, so it agrees with any.
(pub :: rgnMaskRids (-> Int Int Int))
(pub fn (rgnMaskRids rc mask)
  (let (
    (mut i 0)
    (mut acc 0)
  )
    {
      (while (< i 63)
        {
          (if (!= (& mask (<< 1 i)) 0)
            (set acc (| acc (<< 1 (rgnOriginRid rc i))))
            0)
          (set i (+ i 1))
        })
      acc
    }))

; Do two origin masks stand in one region? Equal identity sets, or
; either empty (static).
(pub :: rgnSameRegion (-> Int Int Int Int))
(pub fn (rgnSameRegion rc a b)
  (let (
    (ra (rgnMaskRids rc a))
    (rb (rgnMaskRids rc b))
  )
    (if (|| (== ra 0) (== rb 0))
      1
      (if (== ra rb)
        1
        0))))

; The i-th parameter's NAME of a callee, from its `fn` declaration,
; or its index when the declaration is not at hand.
(pub :: rgnCalleeParamName (-> Int String Int String))
;@axiom:effect(unsafe)
(pub fn (rgnCalleeParamName tc callee i)
  (let ((d (rgnDeclOf tc callee)))
    (if (== d 0)
      (fmtInt i)
      (if (< i (vecLen (nodeBVec d)))
        (vecGetStr (nodeBVec d) i)
        (fmtInt i)))))

(pub :: rgnDeclOf (-> Int String Int))
;@axiom:effect(unsafe)
(pub fn (rgnDeclOf tc name)
  (rgnDeclOfFrom (memGetWordVec tc 10) name 0))

(pub :: rgnDeclOfFrom (-> (Vec Int) String Int Int))
(pub fn (rgnDeclOfFrom decls name i)
  (if (>= i (vecLen decls))
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeAName d) name))
        d
        (rgnDeclOfFrom decls name (+ i 1))))))

; ---- one function ----
(pub :: rgnWalkFn (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnWalkFn tc d ent report)
  (let (
    (rc (rgnCtxNew tc d ent report))
    (sig (memGetWord ent 1))
    (params (nodeBVec d))
    (mut i 0)
  )
    (if (> (vecLen params) 61)
      {
        (if (== report 1)
          (emitDiag tc (mkDiag
            SEV_ERROR
            "AX3060"
            "region-escape"
            (nodeSpan d)
            "region safety cannot be proved: this function has more than 61 parameter origins"
            0
            0
            "split this function into smaller functions so every parameter has a distinct tracked origin"))
          0)
        (memSetWord (rgnFacts rc) 5 1)
        0
      }
      {
        ; the parameters: origin bit 1+i, region = declared or CUR0
        (while (< i (vecLen params))
          {
            (let ((rn (rgnParamRegion sig i)))
              (vecPush
                (rgnParamRids rc)
                (if (== rn 0)
                  0
                  (rgnNameRid
                    rc
                    (cast String rn)))))
            (rgnBind rc (vecGetStr params i) (<< 1 (+ i 1)) (vecGet (rgnParamRids rc) i))
            (set i (+ i 1))
          })
        (let (
          (rr (tyRegion (rgnResultTy sig)))
          (body (rgnExpr rc (nodeC d)))
        )
          (let ((resRid
            (if (== rr 0)
              0
              (if (>=
                (strVecIdx
                  (rgnRegionNames rc)
                  (cast String rr))
                0)
                (rgnNameRid
                  rc
                  (cast String rr))
                (- 0 1)))))
            {
              (if (== resRid (- 0 1))
                (if (== report 1)
                  (emitDiag
                    tc
                    (mkDiag
                      SEV_ERROR
                      "AX3063"
                      "region-argument"
                      (nodeSpan d)
                      (concat
                        (concat
                          (concat (concat "`" (bareOf (nodeAName d))) "` answers a value in region `@")
                          (cast String rr))
                        "`, which no parameter supplies")
                      0
                      0
                      "a region parameter is chosen by the CALLER through an argument, as a type variable is; a region named only in the result is one the callee would have to invent. Name it on a parameter, or drop the annotation and answer a value in the caller's current region"))
                  0)
                {
                  (rgnEmitReturn rc (rgnStoreBad rc body resRid) (nodeSpan d) (nodeC d))
                  0
                })
              (rgnFactsOr rc 3 (>> (& body (rgnParamMask rc)) 1))
              (if (!= (& body (rgnFreshMask rc)) 0)
                (if (== (memGetWord (rgnFacts rc) 4) 0)
                  {
                    (memSetWord (rgnFacts rc) 4 1)
                    (memSetWord rc 14 1)
                  }
                  0)
                0)
              (memGetWord rc 14)
            }))
      })))

(pub :: rgnEmitReturn (-> Int Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnEmitReturn rc bad span bodyNode)
  (if (== (rgnReport rc) 0)
    0
    (if (== bad 0)
      0
      (let (
        (v (/ (- bad 1) 64))
        (t (% (- bad 1) 64))
        (capBad (rgnCaptureBad rc bodyNode (% (- bad 1) 64)))
        (cap (if (== (rgnCaptureBad rc bodyNode (% (- bad 1) 64)) 0)
          ""
          (rgnCaptureFor rc bodyNode (/ (- (rgnCaptureBad rc bodyNode (% (- bad 1) 64)) 1) 64))))
      )
        (if (== (strLen cap) 0)
          (emitDiag (rgnTc rc) (mkDiag
            SEV_ERROR
            "AX3061"
            "region-return"
            span
            (concat (concat (concat (concat "`" (bareOf (nodeAName (memGetWord rc 1)))) "` answers ") (rgnOriginText rc v)) (concat ", and its result is declared to live in " (rgnRidText rc t)))
            0
            0
            "MM-RGN-3 at the return: the result is read by a caller in the declared region, after every shorter region has been reclaimed. Answer a value that lives in the declared region - one derived from a parameter annotated with it - or drop the result's annotation, which makes the result the caller's current region and lets the caller decide"))
          (emitDiag (rgnTc rc) (mkDiag
            SEV_ERROR
            "AX3062"
            "region-capture"
            span
            (concat (concat (concat (concat (concat "`" (bareOf (nodeAName (memGetWord rc 1)))) "` answers a closure that captures `") cap) "`, which lives in ") (concat (concat (rgnRidText rc (rgnOriginRid rc (/ (- capBad 1) 64))) ", and its result is declared to live in ") (rgnRidText rc t)))
            0
            0
            "MM-RGN-3 for a closure: a lambda's region is the region it is created in AND the region of everything it captures, because its record holds a reference to each capture. It may be answered into a region only if every capture outlives it. Capture a copy made in that region, or stop capturing the short-lived value")))))))

; ---- the driver ----
(pub :: rgnCheckAll (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnCheckAll tc)
  (if (== (rgnProgramUsesRegions tc) 1)
    {
      (rgnEnsureFacts tc)
      ; S4 slice 2's stamp walk: facts are final now, so record
      ; proven-fresh call results on their nodes for codegen. The
      ; flag is down during `rgnRounds`' own passes, which is what
      ; keeps a still-moving row from ever becoming a stamp.
      (memSetWord tc 40 1)
      (rgnPass tc (memGetWordVec tc 10) 0 1)
      (memSetWord tc 40 0)
      0
    }
    ; A region form with no `@r` gets its facts for the witness, and
    ; since this fix its reporting pass too: a store hidden behind a
    ; call is invisible to S2's scope check, and only the facts walk
    ; can refuse it. Reporting here used to double-report every S2
    ; shape (AX3059 with AX3060 on 631, measured 2026-09-12); S2 now
    ; records its refused store spans on TC word 41 and `rgnEmitEscape`
    ; suppresses the same-store double, so each shape draws exactly
    ; one diagnostic. Truncated still means the witness abstains:
    ; `rgnEnsureFacts` records it on words 28/33 and the stamp walk
    ; below stamps nothing.
    ; (Reporting on truncated facts can under-report a deep chain -
    ; the fixpoint's round cap is the next fix, not this one.)
    (if (== (memGetWord tc 39) 1)
      {
        (rgnEnsureFacts tc)
        (memSetWord tc 40 1)
        (rgnPass tc (memGetWordVec tc 10) 0 1)
        (memSetWord tc 40 0)
        0
      }
      0)))

; The facts fixpoint, run once per module and on first demand - the
; region pass demands it, and so does a `restrict(no-escape)` claim
; checked in the middle of `tcWalkDecls`. TC word 28 records that it
; has run.
(pub :: rgnEnsureFacts (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnEnsureFacts tc)
  (if (!= (memGetWord tc 28) 0)
    0
    {
      (memSetWord tc 28 1)
      ; Word 33 is the fixpoint's own verdict: 1 when it gave up. Kept
      ; beside word 28 ("has run") because "ran" and "converged" are
      ; different facts and only one of them licenses a silence. The
      ; bound is the program's own size, as `inferEffects` passes it:
      ; a monotone chain over N functions needs up to N rounds, so
      ; `len+1` converges every real program and the cap below is the
      ; safety net it always was, not a number any program reaches.
      (let ((decls (memGetWordVec tc 10)))
        (memSetWord tc 33 (rgnRounds tc decls 0 (+ (vecLen decls) 1))))
      0
    }))

; THE ROUND CAP WAS A TRUNCATION, AND THE BOUND IS THE PROGRAM NOW.
;
; 40 was a bare constant, not a bound derived from the program. A
; monotone chain fixpoint over N functions needs up to N rounds, so a
; call chain deeper than the cap stopped propagating BEFORE it had
; converged - and the facts that came out were an under-approximation
; the walk then treated as final.
;
; Measured 2026-09-03 on generated chains f0 -> f1 -> ... -> fN whose
; leaf does `(memSetWord p 0 (memAlloc 8))`, with
; `restrict(no-escape)` on f0: `check` reported AX3049 at depths 5, 20,
; 30, 38 and 39, and printed `OK` at 40, 41, 42 and 60. The bisect was
; exact - depth 39 refused, depth 40 accepted a claim the analysis can
; itself refute one round later. Timing confirms saturation rather
; than convergence: 0.05s at depth 5, 0.11s at 20, 0.24s at 39, and
; 0.24s at 60, linear in rounds and then flat.
;
; Fixed the way `inferEffects` is fixed: the bound is `(vecLen decls)
; + 1`, so every chain the program can write converges - a chain is
; never longer than the declaration list holding it. The truncation
; machinery below stays exactly as it is (word 28 goes to 2, word 33
; carries 1, `#mir-truncated` prints): a net, not a number any program
; reaches, and the gate that watched the old boundary now watches a
; 60-deep chain converge instead. The worklist over `callersIdxBuild`
; stays future work: it buys speed on adversarial declaration orders,
; and this buys correctness on every order.
;
; The value is 2 rather than a second word because every reader of
; word 28 asks `!= 0`; 2 is still "done".
(pub :: rgnRounds (-> Int (Vec Int) Int Int Int))
; Answers 0 when the facts CONVERGED and 1 when the round cap was
; reached with facts still moving. Both used to answer 0, so a caller
; could not tell a proven claim from an abandoned one - and
; `restrictNoEscape` read that silence as proof. Measured before the
; fix, with the callees declared BELOW their callers so one level
; propagates per pass: a chain of depth 38 was refused and depth 39 was
; ACCEPTED, on a body that provably stores a fresh allocation into its
; parameter. Declaration order is why this hid so long - the same chain
; written leaf-first converges in two passes at any depth.
;@axiom:effect(unsafe)
(pub fn (rgnRounds tc decls round limit)
  (if (>= round limit)
    ; The cap was reached with facts still moving. TWO consumers need
    ; to know, and both are set here so they cannot drift: word 28
    ; becomes 2, which `rgnTruncated` reads for AXIR's
    ; `#mir-truncated`, and the ANSWER becomes 1, which word 33
    ; carries to `restrictNoEscape` so an abandoned fixpoint stops
    ; buying the silence a proven one does. Word 28 == 2 and word 33
    ; == 1 are one fact spelled twice, written at one site.
    {
      (memSetWord tc 28 2)
      1
    }
    (if (== (rgnPass tc decls 0 0) 0)
      0
      (rgnRounds tc decls (+ round 1) limit))))

; Whether the facts fixpoint stopped at its round cap rather than
; converging. Read by the AXSYM/AXIR projection, which must not
; publish an under-approximation without saying so.
(pub :: rgnFactsTruncated (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnFactsTruncated tc)
  (if (== (memGetWord tc 28) 2)
    1
    0))

; One walk over every `fn`; answers whether any facts changed.
(pub :: rgnPass (-> Int (Vec Int) Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnPass tc decls i report)
  (if (&& (== i 0) (&& (== report 1) (== (rgnFactsTruncated tc) 1)))
    {
      (emitDiag
        tc
        (mkDiag
          SEV_ERROR
          "AX3060"
          "region-escape"
          (if (== (vecLen decls) 0)
            0
            (nodeSpan (vecGet decls 0)))
          "region safety cannot be proved: lifetime analysis did not converge"
          0
          0
          "simplify the lifetime dependencies or split the call graph into smaller functions"))
      0
    }
    (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (if (!= (nodeTag d) TAG_D_FN)
          (rgnPass tc decls (+ i 1) report)
          (let (
            (_m (memSetWord tc 16 (nodeModule d)))
            (ent (findFnEnt tc (nodeAName d)))
            (_m0 (memSetWord tc 16 0))
          )
            (if (== ent 0)
              (rgnPass tc decls (+ i 1) report)
              (let (
                (_m1 (memSetWord tc 16 (nodeModule d)))
                (changed (rgnWalkFn tc d ent report))
                (_m2 (memSetWord tc 16 0))
              )
                (if (== (rgnPass tc decls (+ i 1) report) 1)
                  1
                  changed)))))))))

; ---- `restrict(no-escape)` ----
; The claim: this declaration stores nothing it allocates into any of
; its parameters. Read off the facts, on the rail every restriction
; rides: refuted (AX3049, naming the parameter and the callee the
; store went through), unverifiable (AX3051, or AX3057 under
; `strict`) when the body calls something the walk cannot resolve,
; silent when proven.
; The first parameter a fresh value flows into through a RESOLVED
; door - this body or a named callee - or -1. A flow recorded by an
; unresolved call is the conservative assumption, not a finding, and
; the claim over it is unverifiable rather than refuted.
(pub :: rgnResolvedCulprit (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (rgnResolvedCulprit f i)
  (if (>= i (memGetWord f 7))
    (- 0 1)
    (if (&&
      (!= (& (memGetWord f 1) (<< 1 i)) 0)
      (if (strEq (vecGetStr (memGetWordVec f 6) i) "<unresolved call>")
        false
        true))
      i
      (rgnResolvedCulprit f (+ i 1)))))

(pub :: restrictNoEscape (-> Int Int String Int))
;@axiom:effect(unsafe)
(pub fn (restrictNoEscape tc d r)
  {
    (rgnEnsureFacts tc)
    (let ((ent (findFnEnt tc (nodeAName d))))
      (if (== ent 0)
        0
        (let ((f (memGetWord ent 8)))
          (if (== f 0)
            0
            (let ((i (rgnResolvedCulprit f 0)))
              (if (>= i 0)
                (emitRestrictViolated
                  tc
                  d
                  r
                  (concat
                    (concat (concat "the body stores a value it allocates into its parameter `" (rgnCalleeParamName tc (nodeAName d) i)) "`")
                    (if (== (strLen (vecGetStr (memGetWordVec f 6) i)) 0)
                      " in its own body"
                      (concat (concat " through `" (bareOf (vecGetStr (memGetWordVec f 6) i))) "`")))
                  (cast (Vec Int) 0))
                (if (!= (memGetWord f 5) 0)
                  (emitRestrictUnverifiable
                    tc
                    d
                    r
                    "the body calls a value the compiler could not resolve - a parameter, a closure or a field - so where its allocations flow is not something the walk can settle"
                    (cast (Vec Int) 0))
                  ; No culprit and no unresolved call - but that is only
                  ; proof if the facts SETTLED. If the fixpoint hit its
                  ; round cap the facts are a lower bound, not an answer,
                  ; and the claim is unproven rather than proven.
                  (if (!= (memGetWord tc 33) 0)
                    (emitRestrictUnverifiable
                      tc
                      d
                      r
                      "the region fixpoint reached its round limit before the facts settled, so this claim is unproven rather than proven - the call chain below this declaration is deeper than the walk resolves. `strict` already means an unproven claim is refused; without it this is a warning"
                      (cast (Vec Int) 0))
                    0))))))))
  })

; ------------------------------------------------------------------
; Every diagnostic for one module, in stage0's emission order.
; ------------------------------------------------------------------
(pub :: checkModule (-> (Vec Int) (Vec Int) (Vec Int) (Vec Int)))
(pub fn (checkModule entryDecls allDecls units)
  (tcOutVec (checkModuleTc entryDecls allDecls units)))

; The same three passes, answering the CHECKER rather than its
; diagnostics alone - `symbols` needs the populated tables after a
; clean check, and the diagnostics are still there behind `tcOut`.
(pub :: checkModuleTc (-> (Vec Int) (Vec Int) (Vec Int) Int))
(pub fn (checkModuleTc entryDecls allDecls units)
  ; Both indexes are built once, here, rather than by the
  ; passes - each is used by exactly one pass and neither
  ; survives the call.
  (let ((tc (tcNew entryDecls allDecls units)))
    (let ((out (tcOutVec tc)))
      {
        (checkDuplicates (dupIdxBuild entryDecls) entryDecls out 0)
        (checkReservedNames entryDecls out 0)
        (checkImportNames entryDecls allDecls out 0)
        ; An import leaves the list before `allDecls` is built, so its
        ; tags are asked here, over the entry file's own.
        (checkStrayImportAxtags tc entryDecls 0)
        (checkMissingDefs (defIdxBuild allDecls) entryDecls out 0)
        (tcWalkDecls tc 0)
        ; The unsafe boundary's questions that needed every body typed
        ; first (R-B6): a forging callee under `restrict(no-unsafe)`,
        ; and the forging bodies' rows.
        (unsafeLatePass tc)
        ; Stage S3's escape rule, after every body has been checked:
        ; it reads the call graph the effect fixpoint built and the
        ; signatures as declared, and it is ABSENT - not silent - for a
        ; program whose signatures name no region (`rgnCheckAll`).
        (rgnCheckAll tc)
        ; LAST, after every pass that reads the tree as written: word
        ; struct constructions and field reads become the words they
        ; are (MM-VAL-10a). Nothing is recorded for a program that
        ; declares no word struct, so this is a no-op for it.
        (wordLowerApply tc)
        tc
      })))

; ------------------------------------------------------------------
; Constant time: `;@axiom:ct(a, *p)` (AX3092, AX3093).
;
; The claim names a function's secret parameters: `a` for a secret
; value and `*p` for an address whose memory is secret. Every other
; parameter is public. The body is walked with a taint on every
; binding - 0 public, 1 an address into secret memory, 2 a secret
; value - one round after another until no taint grows, and the last
; round's findings are reported: a branch on a secret (`if`, `while`,
; `&&`, `||`, a `match` of more than one arm), a load or store at an
; address computed from one, a division with a secret operand, and a
; secret handed to a function whose own claim doesn't name that
; parameter. A call to a claimed function answers the taint of that
; function's result, found once by walking its body under its own
; claim.
;
; A taint lives on the binding, keyed by the node that made it, so two
; bindings that share a name in different scopes stay apart. This is
; the source half of the evidence: `scripts/check-crypto.sh` asks the
; same questions of the optimised IR (`scripts/lib/ct-taint.py`),
; where a branch the optimiser put back would show.
; ------------------------------------------------------------------
(struct CtWalk
  (tc : Int)
  (fnName : String)
  (claim : String)
  (keys : (Vec Int))
  (taints : (Vec Int))
  (names : (Vec String))
  (rows : (Vec Int))
  (spans : (Vec Int))
  (msgs : (Vec String))
  (labels : (Vec String))
  (grew : (Vec Int)))

(pub :: ctJoin (-> Int Int Int))
(pub fn (ctJoin a b)
  (if (> a b)
    a
    b))

; Every name in every `ct(...)` tag of `tags`, pushed once each; a
; tag naming nothing pushes the empty name, so it is reported rather
; than read as a claim of nothing.
(pub :: ctCollect (-> (Vec Int) (Vec String) Int Int))
;@axiom:effect(unsafe)
(pub fn (ctCollect tags cs i)
  (if (==
    (cast Int tags)
    0)
    0
    (if (>= i (vecLen tags))
      0
      (let ((content (memGetWordStr (vecGet tags i) 1)))
        (let ((op
          (match (strFindByte content 40 0)
            ((None) (- 0 1))
            ((Some k) k))))
          {
            (if (strEq
              (if (< op 0)
                content
                (strSlice content 0 op))
              "ct")
              {
                (restrictSplit (axtagListValue content op) cs)
                0
              }
              0)
            (ctCollect tags cs (+ i 1))
          })))))

; A function's claim, from its signature and its `fn` together. Empty
; when it makes none.
(pub :: ctClaimOf (-> Int Int (Vec String)))
;@axiom:effect(unsafe)
(pub fn (ctClaimOf tc d)
  (let ((cs vecNew))
    {
      (ctCollect (sigAxtagsFor tc (nodeAName d)) cs 0)
      (ctCollect (memGetWordVec d 7) cs 0)
      cs
    }))

; What a claim says of parameter `p`: 2 a secret value, 1 an address
; into secret memory, 0 public.
(pub :: ctParamKind (-> (Vec String) String Int))
(pub fn (ctParamKind cs p)
  (if (== (strInVec cs p 0) 1)
    2
    (if (== (strInVec cs (concat "*" p) 0) 1)
      1
      0)))

; The claim as written, `a, *p`, for messages.
(pub :: ctClaimText (-> (Vec String) String))
(pub fn (ctClaimText cs)
  (let (
    (mut i 0)
    (mut s "")
  )
    {
      (while (< i (vecLen cs))
        {
          (set s (if (== i 0)
            (vecGet cs i)
            (concat s (concat ", " (vecGet cs i)))))
          (set i (+ i 1))
        })
      s
    }))

; The declarations that make a claim, found once per compilation and
; kept in the unsafe record's word 4, beside their result taints in
; word 5: -1 until asked, 3 while being found.
(pub :: ctTable (-> Int (Vec Int)))
;@axiom:effect(unsafe)
(pub fn (ctTable tc)
  (let ((u (memGetWord tc 44)))
    {
      (if (== (memGetWord u 4) 0)
        (let (
          (decls (memGetWordVec tc 10))
          (tab vecNew)
          (sums vecNew)
          (mut i 0)
        )
          {
            (while (< i (vecLen decls))
              {
                (let ((dd (vecGet decls i)))
                  (if (== (nodeTag dd) TAG_D_FN)
                    (if (> (vecLen (ctClaimOf tc dd)) 0)
                      {
                        (vecPush tab dd)
                        (vecPush sums (- 0 1))
                        0
                      }
                      0)
                    0))
                (set i (+ i 1))
              })
            (memSetWord u 5 (cast Int sums))
            (memSetWord u 4 (cast Int tab))
            0
          })
        0)
      (cast (Vec Int) (memGetWord u 4))
    }))

(pub :: ctSums (-> Int (Vec Int)))
;@axiom:effect(unsafe)
(pub fn (ctSums tc)
  (cast (Vec Int) (memGetWord (memGetWord tc 44) 5)))

; The declared name a call's head resolves to, the way the checker
; resolves it: a call names its callee bare, even across modules.
(pub :: ctResolve (-> Int String String))
;@axiom:effect(unsafe)
(pub fn (ctResolve tc n)
  (let ((ent (findFnEnt tc n)))
    (if (== ent 0)
      n
      (memGetWordStr ent 0))))

; Run `f` over `d` with the checker's current module set to `d`'s,
; which is what `findFnEnt` resolves a bare name against.
(pub :: ctInModule (-> Int Int (-> Int Int) Int))
;@axiom:effect(unsafe)
(pub fn (ctInModule tc d f)
  (let ((saved (memGetWord tc 16)))
    {
      (memSetWord tc 16 (nodeModule d))
      (let ((r (f d)))
        {
          (memSetWord tc 16 saved)
          r
        })
    }))

(pub :: ctTableIndex (-> (Vec Int) String Int))
(pub fn (ctTableIndex tab name)
  (let (
    (mut i 0)
    (mut at (- 0 1))
  )
    {
      (while (&& (< i (vecLen tab)) (< at 0))
        {
          (if (strEq (nodeAName (vecGet tab i)) name)
            {
              (set at i)
              0
            }
            0)
          (set i (+ i 1))
        })
      at
    }))

; The result taint of the `k`th claimed function: its body walked once
; under its own claim. A function reached again while its own walk is
; under way answers secret, which is never wrong.
(pub :: ctSummary (-> Int Int Int))
(pub fn (ctSummary tc k)
  (let (
    (sums (ctSums tc))
    (s (vecGet (ctSums tc) k))
  )
    (if (== s 3)
      2
      (if (>= s 0)
        s
        (let ((dd (vecGet (ctTable tc) k)))
          {
            (vecSet sums k 3)
            (let (
              (cs (ctClaimOf tc dd))
            )
              (let ((r (ctInModule tc dd (lambda (x) (ctRounds (ctWalkNew tc (nodeAName x) (ctClaimText cs)) x cs)))))
                {
                  (vecSet sums k r)
                  r
                }))
          })))))

; A walk of the function named `name`, whose claim reads `claim`.
(pub :: ctWalkNew (-> Int String String CtWalk))
(pub fn (ctWalkNew tc name claim)
  (CtWalk
    tc
    (bareOf name)
    claim
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew
    (vecPush vecNew 0)))

; The row a binding's key names, made on first sight.
(pub :: ctRowFor (-> CtWalk Int Int))
(pub fn (ctRowFor w key)
  (let (
    (mut i 0)
    (mut at (- 0 1))
  )
    {
      (while (&& (< i (vecLen w.keys)) (< at 0))
        {
          (if (== (vecGet w.keys i) key)
            {
              (set at i)
              0
            }
            0)
          (set i (+ i 1))
        })
      (if (< at 0)
        {
          (vecPush w.keys key)
          (vecPush w.taints 0)
          (- (vecLen w.keys) 1)
        }
        at)
    }))

(pub :: ctRaise (-> CtWalk Int Int Int))
(pub fn (ctRaise w row t)
  (if (> t (vecGet w.taints row))
    {
      (vecSet w.taints row t)
      (vecSet w.grew 0 1)
      0
    }
    0))

(pub :: ctBind (-> CtWalk String Int Int Int))
(pub fn (ctBind w name key t)
  (let ((row (ctRowFor w key)))
    {
      (ctRaise w row t)
      (vecPush w.names name)
      (vecPush w.rows row)
      0
    }))

; The row the innermost binding of `name` uses, or -1 for a name bound
; outside the body (a function, a constant), which is public.
(pub :: ctScopeRow (-> CtWalk String Int))
(pub fn (ctScopeRow w name)
  (let (
    (mut i (- (vecLen w.names) 1))
    (mut at (- 0 1))
  )
    {
      (while (&& (>= i 0) (< at 0))
        {
          (if (strEq (vecGet w.names i) name)
            {
              (set at (vecGet w.rows i))
              0
            }
            0)
          (set i (- i 1))
        })
      at
    }))

(pub :: ctUnscope (-> CtWalk Int Int))
(pub fn (ctUnscope w mark)
  {
    (while (> (vecLen w.names) mark)
      {
        (vecPop w.names)
        (vecPop w.rows)
        0
      })
    0
  })

(pub :: ctHit (-> CtWalk Int String String Int))
(pub fn (ctHit w span msg label)
  {
    (vecPush w.spans span)
    (vecPush w.msgs (concat msg (concat " (`" (concat w.fnName (concat "` claims `ct(" (concat w.claim ")`)"))))))
    (vecPush w.labels label)
    0
  })

; The name a node's span covers, for a message that leads with it:
; a variable's, or an application's head's.
(pub :: ctSpanText (-> Int String))
(pub fn (ctSpanText e)
  (if (== (nodeTag e) TAG_E_VAR)
    (bareOf (nodeAName e))
    (if (== (nodeTag e) TAG_E_APP)
      (let ((h (spineHead e)))
        (if (== (nodeTag h) TAG_E_VAR)
          (bareOf (nodeAName h))
          ""))
      "")))

; A branch on a secret, reported at its condition: an `if` node carries
; no span of its own.
(pub :: ctBranchHit (-> CtWalk Int Int String Int))
(pub fn (ctBranchHit w e cond kw)
  (let ((txt (ctSpanText cond)))
    (ctHit
      w
      (if (== (nodeSpan cond) 0)
        (nodeSpan e)
        (nodeSpan cond))
      (if (== (strLen txt) 0)
        (concat (concat "`" kw) "` branches on a secret")
        (concat (concat (concat (concat "`" txt) "` is secret, and `") kw) "` branches on it"))
      "a branch on a secret")))

(pub :: ctEvalVec (-> CtWalk (Vec Int) Int))
(pub fn (ctEvalVec w es)
  (let (
    (mut i 0)
    (mut t 0)
  )
    {
      (while (< i (vecLen es))
        {
          (set t (ctEval w (vecGet es i)))
          (set i (+ i 1))
        })
      t
    }))

(pub :: ctEvalArgs (-> CtWalk (Vec Int) (Vec Int)))
(pub fn (ctEvalArgs w es)
  (let (
    (ts vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen es))
        {
          (vecPush ts (ctEval w (vecGet es i)))
          (set i (+ i 1))
        })
      ts
    }))

; The highest taint among the first `n` of `ts`.
(pub :: ctMaxTo (-> (Vec Int) Int Int))
(pub fn (ctMaxTo ts n)
  (let (
    (mut i 0)
    (mut m 0)
  )
    {
      (while (&& (< i n) (< i (vecLen ts)))
        {
          (set m (ctJoin m (vecGet ts i)))
          (set i (+ i 1))
        })
      m
    }))

(pub :: ctIsArith (-> String Bool))
(pub fn (ctIsArith n)
  (|| (strEq n "+") (|| (strEq n "-") (|| (strEq n "*") (|| (strEq n "&") (|| (strEq n "|") (|| (strEq n "^") (|| (strEq n "<<") (strEq n ">>")))))))))

(pub :: ctIsCompare (-> String Bool))
(pub fn (ctIsCompare n)
  (|| (strEq n "==") (|| (strEq n "!=") (|| (strEq n "<") (|| (strEq n ">") (|| (strEq n "<=") (|| (strEq n ">=") (strEq n "!"))))))))

(pub :: ctIsCtor (-> String Bool))
(pub fn (ctIsCtor b)
  (if (== (strLen b) 0)
    false
    (&& (>= (strByte b 0) 65) (<= (strByte b 0) 90))))

(pub :: ctEvalApp (-> CtWalk Int Int))
(pub fn (ctEvalApp w e)
  (let (
    (head (spineHead e))
    (ts (ctEvalArgs w (spineArgVec e vecNew)))
  )
    (if (== (nodeTag head) TAG_E_VAR)
      (ctEvalNamed w e (nodeAName head) ts)
      {
        (ctEval w head)
        (if (> (ctMaxTo ts (vecLen ts)) 0)
          (ctHit w (nodeSpan e) "a call through a value gets a secret" "a secret to an unclaimed call")
          0)
        0
      })))

(pub :: ctEvalNamed (-> CtWalk Int String (Vec Int) Int))
(pub fn (ctEvalNamed w e n ts)
  (let (
    (m (ctMaxTo ts (vecLen ts)))
    (b (bareOf n))
  )
    (if (ctIsArith n)
      m
      (if (ctIsCompare n)
        (if (== m 2)
          2
          0)
        (if (|| (strEq n "/") (strEq n "%"))
          {
            (if (== m 2)
              (ctHit w (nodeSpan e) (concat (concat "`" n) "` has a secret operand") "a division by or of a secret")
              0)
            (if (> m 0)
              2
              0)
          }
          (if (|| (strEq n "&&") (strEq n "||"))
            {
              (if (== m 2)
                (ctHit w (nodeSpan e) (concat (concat "`" n) "` short-circuits on a secret") "a branch on a secret")
                0)
              m
            }
            (if (strStartsWith n "__load")
              (if (== m 2)
                {
                  (ctHit w (nodeSpan e) (concat (concat "`" n) "` reads at an address computed from a secret") "an address from a secret")
                  2
                }
                (if (== m 1)
                  2
                  0))
              (if (strStartsWith n "__store")
                {
                  (if (== (ctMaxTo ts 2) 2)
                    (ctHit w (nodeSpan e) (concat (concat "`" n) "` writes at an address computed from a secret") "an address from a secret")
                    0)
                  0
                }
                (if (== (isAsmPrim n) 1)
                  (if (> m 0)
                    2
                    0)
                  (if (ctIsCtor b)
                    (if (> m 0)
                      2
                      0)
                    (ctEvalCall w e n ts m)))))))))))

; A call to a named function. Public arguments make a public result.
; A secret may go only where the callee's own claim names that
; parameter - a secret value to `x`, an address into secret memory to
; `x` or `*x` - and the result is then the callee's result taint.
(pub :: ctEvalCall (-> CtWalk Int String (Vec Int) Int Int))
(pub fn (ctEvalCall w e n ts m)
  (if (== m 0)
    0
    (let ((k (ctTableIndex (ctTable w.tc) (ctResolve w.tc n))))
      (if (< k 0)
        {
          (ctHit w (nodeSpan e) (concat (concat "`" (bareOf n)) "` gets a secret, and makes no `ct(...)` claim") "a secret to an unclaimed call")
          0
        }
        (let ((dd (vecGet (ctTable w.tc) k)))
          {
            (ctCheckArgs w e dd (ctClaimOf w.tc dd) ts 0)
            (ctSummary w.tc k)
          })))))

(pub :: ctCheckArgs (-> CtWalk Int Int (Vec String) (Vec Int) Int Int))
(pub fn (ctCheckArgs w e dd cs ts i)
  (if (>= i (vecLen ts))
    0
    (let (
      (t (vecGet ts i))
      (p (restrictParamName dd i))
    )
      {
        (if (&& (> t 0) (== (ctParamKind cs p) 0))
          (ctHit w (nodeSpan e) (concat (concat (concat (concat "`" (bareOf (nodeAName dd))) "` gets a secret for `") p) "`, which its `ct(...)` claim doesn't name") "a secret to a public parameter")
          (if (&& (== t 2) (== (ctParamKind cs p) 1))
            (ctHit w (nodeSpan e) (concat (concat (concat (concat (concat (concat "`" (bareOf (nodeAName dd))) "` gets a secret value for `") p) "`, which its claim names as an address, `*") p) "`") "a secret to a public parameter")
            0))
        (ctCheckArgs w e dd cs ts (+ i 1))
      })))

; A pattern's binders take the scrutinee's taint.
(pub :: ctBindPat (-> CtWalk Int Int Int))
(pub fn (ctBindPat w pat t)
  (if (== pat 0)
    0
    (let ((tag (nodeTag pat)))
      (if (== tag TAG_E_VAR)
        (ctBind w (nodeAName pat) pat t)
        (if (== tag TAG_E_APP)
          {
            (ctBindPat w (nodeB pat) t)
            (ctBindPatHead w (nodeA pat) t)
          }
          (if (== tag TAG_P_CONNAMED)
            (ctBindPats w (nodeCVec pat) 0 t)
            0))))))

(pub :: ctBindPatHead (-> CtWalk Int Int Int))
(pub fn (ctBindPatHead w pat t)
  (if (== (nodeTag pat) TAG_E_APP)
    {
      (ctBindPat w (nodeB pat) t)
      (ctBindPatHead w (nodeA pat) t)
    }
    0))

(pub :: ctBindPats (-> CtWalk (Vec Int) Int Int Int))
(pub fn (ctBindPats w pats i t)
  (if (>= i (vecLen pats))
    0
    {
      (ctBindPat w (vecGet pats i) t)
      (ctBindPats w pats (+ i 1) t)
    }))

(pub :: ctEvalArms (-> CtWalk (Vec Int) Int Int))
(pub fn (ctEvalArms w arms s)
  (let (
    (mut i 0)
    (mut r 0)
  )
    {
      (while (< i (vecLen arms))
        {
          (let (
            (a (vecGet arms i))
            (mark (vecLen w.names))
          )
            {
              (ctBindPat w (nodeA a) s)
              (set r (ctJoin r (ctEval w (nodeB a))))
              (ctUnscope w mark)
            })
          (set i (+ i 1))
        })
      r
    }))

(pub :: ctEval (-> CtWalk Int Int))
(pub fn (ctEval w e)
  (if (== e 0)
    0
    (let ((tag (nodeTag e)))
      (if (== tag TAG_E_VAR)
        (let ((row (ctScopeRow w (nodeAName e))))
          (if (< row 0)
            0
            (vecGet w.taints row)))
        (if (== tag TAG_E_APP)
          (ctEvalApp w e)
          (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
            (let (
              (t (ctEval w (nodeB e)))
              (mark (vecLen w.names))
            )
              {
                (ctBind w (nodeAName e) e t)
                (let ((r (ctEval w (nodeC e))))
                  {
                    (ctUnscope w mark)
                    r
                  })
              })
            (if (== tag TAG_E_IF)
              (let ((c (ctEval w (nodeA e))))
                {
                  (if (== c 2)
                    (ctBranchHit w e (nodeA e) "if")
                    0)
                  (ctJoin c (ctJoin (ctEval w (nodeB e)) (ctEval w (nodeC e))))
                })
              (if (== tag TAG_E_WHILE)
                (let ((c (ctEval w (nodeA e))))
                  {
                    (if (== c 2)
                      (ctBranchHit w e (nodeA e) "while")
                      0)
                    (ctEvalVec w (nodeBVec e))
                    0
                  })
                (if (== tag TAG_E_BEGIN)
                  (ctEvalVec w (nodeAVec e))
                  (if (== tag TAG_E_MATCH)
                    (let (
                      (s (ctEval w (nodeA e)))
                      (arms (nodeBVec e))
                    )
                      {
                        (if (&& (== s 2) (> (vecLen arms) 1))
                          (ctBranchHit w e (nodeA e) "match")
                          0)
                        (ctEvalArms w arms s)
                      })
                    (if (== tag TAG_E_SET)
                      (let (
                        (t (ctEval w (nodeB e)))
                        (row (ctScopeRow w (nodeAName e)))
                      )
                        {
                          (if (>= row 0)
                            (ctRaise w row t)
                            0)
                          0
                        })
                      (if (== tag TAG_E_REGION)
                        (ctEval w (nodeB e))
                        (if (== tag TAG_E_LAM)
                          {
                            (ctEval w (nodeB e))
                            0
                          }
                          (if (== tag TAG_E_FIELD)
                            (if (> (ctEval w (nodeA e)) 0)
                              2
                              0)
                            (if (== tag TAG_E_SETF)
                              {
                                (ctEval w (nodeA e))
                                (ctEval w (nodeC e))
                                0
                              }
                              (if (== tag TAG_E_STRUCTCON)
                                (let ((ts (ctEvalArgs w (nodeBVec e))))
                                  (if (> (ctMaxTo ts (vecLen ts)) 0)
                                    2
                                    0))
                                (if (== tag TAG_E_HANDLE)
                                    (let ((t (ctEval w (nodeA e))))
                                      {
                                        (ctEval w (nodeC e))
                                        t
                                      })
                                    0)))))))))))))))))

(pub :: ctBindParams (-> CtWalk (Vec String) (Vec String) Int Int))
(pub fn (ctBindParams w ps cs i)
  (if (>= i (vecLen ps))
    0
    {
      (ctBind w (vecGet ps i) (- 0 (+ i 1)) (ctParamKind cs (vecGet ps i)))
      (ctBindParams w ps cs (+ i 1))
    }))

; Walk `d`'s body under claim `cs` until no taint grows, and answer the
; taint of its result. `w`'s findings are the last round's.
(pub :: ctRounds (-> CtWalk Int (Vec String) Int))
(pub fn (ctRounds w d cs)
  (let (
    (mut round 0)
    (mut r 0)
    (mut more true)
  )
    {
      (while more
        {
          (vecSet w.grew 0 0)
          (while (> (vecLen w.spans) 0)
            {
              (vecPop w.spans)
              (vecPop w.msgs)
              (vecPop w.labels)
              0
            })
          (ctBindParams w (nodeBVec d) cs 0)
          (set r (ctEval w (nodeC d)))
          (ctUnscope w 0)
          (set round (+ round 1))
          (set more (&& (== (vecGet w.grew 0) 1) (< round 12)))
        })
      r
    }))

; AX3093 for a claim that names nothing, or names something that isn't
; a parameter. Answers 1 when the claim is well formed.
(pub :: ctClaimShape (-> Int Int (Vec String) Int))
(pub fn (ctClaimShape tc d cs)
  (let (
    (ps (nodeBVec d))
    (mut i 0)
    (mut ok 1)
  )
    {
      (while (< i (vecLen cs))
        {
          (let (
            (c (vecGet cs i))
            (p
              (if (strStartsWith (vecGet cs i) "*")
                (strSlice (vecGet cs i) 1 (- (strLen (vecGet cs i)) 1))
                (vecGet cs i)))
          )
            (if (== (strLen p) 0)
              {
                (set ok 0)
                (emitCtMalformed tc d (concat (concat "`" (bareOf (nodeAName d))) "` claims `ct(...)` and names no parameter"))
              }
              (if (== (strInVec ps p 0) 1)
                0
                {
                  (set ok 0)
                  (emitCtMalformed tc d (concat (concat (concat (concat "`" (bareOf (nodeAName d))) "` claims `ct(") c) (concat (concat ")`, and `" p) "` isn't one of its parameters")))
                })))
          (set i (+ i 1))
        })
      ok
    }))

(pub :: emitCtMalformed (-> Int Int String Int))
(pub fn (emitCtMalformed tc d msg)
  (if (== (nodeSpan d) 0)
    0
    (emitDiag tc (mkDiag
      SEV_ERROR
      "AX3093"
      "ct-claim-malformed"
      (nodeSpan d)
      msg
      0
      0
      "`ct(...)` names the parameters that carry secrets: `name` for a secret value, `*name` for an address whose memory is secret. Name only this function's own parameters"))))

(pub :: emitCtHits (-> Int Int CtWalk Int Int))
(pub fn (emitCtHits tc d w i)
  (if (>= i (vecLen w.spans))
    0
    {
      (emitDiag tc (diagSetLabel (mkDiag
        SEV_ERROR
        "AX3092"
        "ct-claim-violated"
        (if (== (vecGet w.spans i) 0)
          (nodeSpan d)
          (vecGet w.spans i))
        (vecGet w.msgs i)
        0
        0
        "a function that claims `ct(...)` promises its timing doesn't depend on the parameters it names. A branch, a memory address or a division that depends on one breaks the promise, and so does handing one to a function whose own claim doesn't name it. Compute both sides and choose between them with the masks in `Crypto.Ct` (`ctSelect`, `ctMaskEq`), claim the callee's parameter, or take the parameter out of this claim") (vecGet w.labels i)))
      (emitCtHits tc d w (+ i 1))
    }))

; The check itself, for one function: nothing to do without a claim.
(pub :: checkCtClaim (-> Int Int Int))
(pub fn (checkCtClaim tc d)
  (let ((cs (ctClaimOf tc d)))
    (if (== (vecLen cs) 0)
      0
      (if (== (ctClaimShape tc d cs) 0)
        0
        (let ((w (ctWalkNew tc (nodeAName d) (ctClaimText cs))))
          {
            (ctInModule tc d (lambda (x) (ctRounds w x cs)))
            (emitCtHits tc d w 0)
          })))))

(pub :: checkExprH (-> Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (checkExprH tc e inHead)
  (let ((cache (memGetWordVec tc 46)))
    (let ((ty (if (if (>= (vecLen cache) 2)
      (== (vecGet cache (- (vecLen cache) 2)) e)
      false)
      (vecGet cache (- (vecLen cache) 1))
      (checkExprHCore tc e inHead))))
    { (if (if (== e 0) false (&& (== (isPendingNode ty) 0) (|| (== (nodeTag e) TAG_E_LAM) (== (nodeTag e) TAG_E_APP))))
        (setNodeBinderTy e
          (if (== (nodeTag e) TAG_E_APP)
            (mkNode TAG_EVSTAMP (tyResolve ty) (evClassOf tc (tyResolve ty)) (memGetWord tc 24))
            (tyResolve ty)))
        e)
      ty })))

(pub :: checkLam (-> Int Int Int))
(pub fn (checkLam tc e)
  (let ((ty (checkLamCore tc e)))
    { (if (if (== e 0) false (&& (== (isPendingNode ty) 0) (|| (== (nodeTag e) TAG_E_LAM) (== (nodeTag e) TAG_E_APP))))
        (setNodeBinderTy e (tyResolve ty))
        e)
      ty }))

(pub :: checkLamAgainst (-> Int Int Int Int))
(pub fn (checkLamAgainst tc e arrow)
  (let ((ty (checkLamAgainstCore tc e arrow)))
    { (if (if (== e 0) false (&& (== (isPendingNode ty) 0) (|| (== (nodeTag e) TAG_E_LAM) (== (nodeTag e) TAG_E_APP))))
        (setNodeBinderTy e (tyResolve ty))
        e)
      ty }))
