; The declaration NAMESPACE: how a bare name reaches a definition, and
; which names may leave a module.
;
; This module exists because two passes need the same answers and the
; import graph will not let them share a file. Import resolution
; (codegen.ax) mangles a module's declarations to `Mod$name` and
; records which of them are exported; declaration-macro expansion
; (expand.ax) generates declarations in a module AFTER that pass has
; run and has to put them in the same namespace by the same rules
; (macro-system.md MAC-EXP-16). `codegen` imports `expand`, so the
; helpers cannot live in either - and duplicating them is the failure
; this repository keeps finding, two implementations of one rule that
; drift.
;
; Everything here is a pure function over the two lockstep Vecs the
; resolver threads (`bares` / `fulls`), the index it keeps beside them
; (`MangleIdx`, below), the import filters it records, and the AST
; nodes it renames.
(import Mem)

(import Str)

(import Vec)

(import Intern)

(import parser)

; ------------------------------------------------------------------
; The name index.
;
; Every declaration the resolver records asks `bares` once or twice
; whether a name is already claimed, and `bares` used to answer by
; scanning itself - so resolving a module of N declarations was N
; scans of a vector growing to N, quadratic in the declaration count.
; Measured on the generated modules `scripts/check-name-scale.sh`
; builds, with the compiler at df60fdb: checking the public module
; took 0.24 s at N=2000, 0.83 s at N=4000 and 3.26 s at N=8000, a
; per-doubling ratio of 3.45x and then 3.93x, on its way to 4x; the
; private module went 0.18 s, 0.56 s, 2.12 s (3.14x, 3.78x). That
; gate's own header recorded the scan as 55.7% of a check at N=8000
; and declined to gate a doubling ratio because of it. With this
; index the same modules read 0.08 s, 0.12 s, 0.22 s public and
; 0.08 s, 0.12 s, 0.23 s private - 1.63x/1.76x and 1.58x/1.83x per
; doubling - so at N=8000 the scan was fifteen times the rest of the
; check, not 55.7% of it, and the gate now asserts the ratio.
;
; WHY IT IS NOT INSIDE `bares`. `bares` is a plain `Vec` that every
; caller of `resolveImports` (main.ax, repl.ax, lsp.ax) allocates
; with `vecNew`, and a `Vec` header is four words with no spare one;
; Axiom has no global state to keep a side table in. So the index is
; a separate structure, created by `resolveImports` and by
; `expandProgram` and threaded beside `bares` to every writer in this
; module. The signatures those callers use - `resolveImports`,
; `expandProgram`, `lspResolveFor` - are unchanged; what moved is the
; writers' (`mangleRecord`, `mangleRecordSelf`, `mangleRecordEntry`,
; `mangleExternItems`, `mangleDecl`), which take `idx` beside `bares`.
;
; WHY IT CANNOT GO STALE. `bares` is append-only: `vecPush` is the
; only operation any writer applies to it (`mangleRecordEntry`'s
; `vecSet` is on `fulls`). So the index records how much of `bares`
; it has absorbed and catches up on every question, from that mark to
; the end. An index created over a `bares` that already holds entries
; is right from its first question, a push it did not see is absorbed
; by the next one, and no writer carries a "keep the index in step"
; obligation to forget - the failure `typecheck.ax`'s `tcPushFn`
; prevents by routing every push through one door is prevented here
; by there being nothing to keep in step.
;
; The table is a stdlib `Intern`: the structure `codegen.ax`'s
; `buildNameIndexes` already keys `bares` with at emission, growing
; itself (load factor 0.5, doubling) since the declaration count is
; not known when the resolver starts, and carrying its own string
; hash - which matters because the checker's `fnIdxHash` lives in
; typecheck.ax and modules flow one way: this module is imported by
; expand.ax and codegen.ax and cannot import the checker. Ids are
; dense in first-interning order, so `pos` - intern id to the FIRST
; index in `bares` carrying that name, what `mangleRecordEntry`'s
; scan answered - is one push per new name.
;
;   names — Intern over bares[0..done)
;   pos   — Vec, intern id -> first index in `bares`
;   done  — entries of `bares` absorbed so far
; ------------------------------------------------------------------
(pub struct MangleIdx
  (names : Int)
  (pos : Int)
  (done : Int))

(pub :: mangleIdxNew Int)

(pub fn (mangleIdxNew) (cast Int (MangleIdx internNew vecNew 0)))

; Absorb every entry of `bares` from `done` to its end. Answers the
; new `done`.
(pub :: mangleIdxSync (-> Int Int Int))

(pub fn (mangleIdxSync idx bares)
  (let ((mut i (memGetWord idx 2)))
    {
      (while (< i (vecLen bares))
        {
          (let ((id (internIntern (memGetWord idx 0) (vecGetStr bares i))))
            (if (== id (vecLen (memGetWord idx 1)))
              (vecPush (memGetWord idx 1) i)
              0
            )
          )
          (set i (+ i 1))
        })
      (memSetWord idx 2 i)
      i
    }
  )
)

; Is `name` in `bares`? The indexed form of `mangleHasIn`, and the
; one every writer here asks.
(pub :: mangleIdxHas (-> Int Int String Bool))

(pub fn (mangleIdxHas idx bares name)
  {
    (mangleIdxSync idx bares)
    (match (internFind (memGetWord idx 0) name)
      ((Some _) true)
      ((None) false)
    )
  }
)

; The first index in `bares` holding `name`, or -1.
(pub :: mangleIdxIndexOf (-> Int Int String Int))

(pub fn (mangleIdxIndexOf idx bares name)
  {
    (mangleIdxSync idx bares)
    (match (internFind (memGetWord idx 0) name)
      ((Some id) (vecGet (memGetWord idx 1) id))
      ((None) (- 0 1))
    )
  }
)

; Record how a bare reference reaches `full`, unless the bare name is
; already claimed. First-writer-wins is what makes the entry file win:
; `resolveImports` records every entry-file function before any import
; is read.
(pub :: mangleRecord (-> Int Int Int String String Int))

(pub fn (mangleRecord idx bares fulls bare full)
  ; The mangled name maps to itself, recorded whether or not the bare
  ; name was already claimed - which it usually is, by the entry
  ; file. This is how a reference made INSIDE a module asks whether
  ; that module defines the name at all, and the bare slot cannot
  ; answer it: it holds exactly one winner per name.
  ;
  ; It changes no existing lookup. The only name that can match one
  ; of these entries is a qualified reference, `Mod::name`, which
  ; stage1 already spells `Mod$name` and which already resolved to
  ; itself by falling off the end of the map.
  {
    (if (|| (strEq bare full) (mangleIdxHas idx bares full))
      0
      {
        (vecPush bares full)
        (vecPush fulls full)
        0
      }
    )
    (if (mangleIdxHas idx bares bare)
      0
      {
        (vecPush bares bare)
        (vecPush fulls full)
        0
      }
    )
  }
)

; The entry file's claim on a bare name, which OVERRIDES whatever an
; import recorded. `mangleRecord` gives the entry file the bare slot by
; running first (`recordEntryFns`, before any import is read), and that
; is enough for declarations the parser produced. It is not enough for
; declarations phase D GENERATES: expansion runs after import
; resolution, and it walks the merged list, where a module's
; declarations come before the entry file's - so a module-side
; invocation claimed the slot first and a bare call in the entry file
; reached the MODULE's function.
;
; Measured before this existed: an entry file generating `tagShape`
; answering 42, importing a module that generates its own `tagShape`
; answering 7, checked clean and answered 7.
(pub :: mangleRecordEntry (-> Int Int Int String Int))

(pub fn (mangleRecordEntry idx bares fulls name)
  (let ((i (mangleIdxIndexOf idx bares name)))
    (if (< i 0)
      {
        (vecPush bares name)
        (vecPush fulls name)
        0
      }
      {
        (vecSet fulls i name)
        0
      }
    )
  )
)

; Is `bare` in `bares`, by scanning it. The UN-INDEXED form, kept for
; the one caller that holds no index: `mangledFor` in codegen.ax, the
; emitter's fallback on the REPL's and LSP's partial paths before
; `buildNameIndexes` has run. Every writer in this module asks
; `mangleIdxHas` instead - see the note above `MangleIdx`.
(pub :: mangleHasIn (-> Int String Int Bool))

(pub fn (mangleHasIn bares bare i)
  (if (>= i (vecLen bares))
    false
    (if (strEq (vecGetStr bares i) bare)
      true
      (mangleHasIn bares bare (+ i 1))
    )
  )
)

; Rewrite an imported function's definition to its mangled name, in
; place - `emitFnDef` reads the same node later, so the header and the
; map cannot disagree. Entry-file declarations (modName 0) are left
; bare; they were already recorded by `recordEntryFns`. A signature is
; renamed the same way, so the float-signature registry and the
; definitions it describes stay keyed identically.
;
; `exported` decides which of `mangleRecord`'s two recordings happens.
; A declaration that is carried but NOT exported records only
; `Mod$name -> Mod$name`, so a reference made inside its own module
; still reaches it and no bare name anywhere else can. That split is
; the whole of module privacy in the emitter; the checker enforces the
; other side (see `findFnEnt`), and it has to, because a bare
; reference that gets past it lands here as a name this map does not
; hold and is emitted unchanged - an undefined symbol reported by
; `opt` against generated code.
(pub :: mangleDecl (-> Int String Int Int Int Int Int))

(pub fn (mangleDecl node modName idx bares fulls exported)
  (if (==
    (cast Int modName)    0
  )
    0
    (if (== (nodeTag node) TAG_D_FN)
      (let ((bare (nodeAName node)))
        (let ((full 
          (strConcat
            (strConcat
              (strDup
                (cast String modName)
              )              "$"
            )            (strDup bare)
          )
        ))
          {
            (memSetWord node 1 full)
            (if (== exported 1)
              (mangleRecord idx bares fulls bare full)
              (mangleRecordSelf idx bares fulls full)
            )
          }
        )
      )
      (if (== (nodeTag node) TAG_D_SIG)
        {
          (memSetWord
            node            1            (strConcat
              (strConcat
                (strDup
                  (cast String modName)
                )                "$"
              )              (strDup (nodeAName node))
            )
          )
          0
        }
        ; An `extern` block from an imported module. Its items are
        ; RECORDED and never RENAMED: `Mod$name` would be a symbol no
        ; archive defines, and the mapping wanted here is the Axiom name
        ; to the LINKER symbol, which is what `mangledFor` then answers
        ; at every call site.
        ;
        ; Without this arm an imported binding module emits its calls
        ; against the Axiom name - `call i64 @ffiFreeBytes(...)` beside
        ; a `declare` for `@axffi_free_bytes` - and dies in `opt` with
        ; "use of undefined value". That is exactly the `foreign` bug,
        ; reached from the one direction the entry-file fixtures could
        ; not see, because `recordEntryFns` covers only the entry file.
        (if (== (nodeTag node) TAG_D_EXTERN)
          (mangleExternItems (nodeC node) 0 idx bares fulls)
          0
        )
      )
    )
  )
)

; Record every item of an `extern` block: the Axiom name maps to the
; `(symbol "...")` clause the parser resolved. Visibility does not
; change the mapping - an unexported item is simply never referenced
; from outside, and recording it costs one entry.
(pub :: mangleExternItems (-> Int Int Int Int Int Int))

(pub fn (mangleExternItems items i idx bares fulls)
  (if (== items 0)
    0
    (if (>= i (vecLen items))
      0
      {
        (let ((f (vecGet items i)))
          (mangleRecord idx bares fulls (nodeAName f) (nodeCName f))
        )
        (mangleExternItems items (+ i 1) idx bares fulls)
      }
    )
  )
)

; The half of `mangleRecord` that a private declaration gets: the
; mangled name maps to itself, and the bare slot is left for whoever
; can legitimately claim it.
(pub :: mangleRecordSelf (-> Int Int Int String Int))

(pub fn (mangleRecordSelf idx bares fulls full)
  (if (mangleIdxHas idx bares full)
    0
    {
      (vecPush bares full)
      (vecPush fulls full)
      0
    }
  )
)

; Is `name` in this Vec of names? The set test both the resolver's
; `seen` list and an import's name list are asked. It lives here
; rather than beside its first caller because its SECOND caller is
; the filter test below, which expansion needs.
(pub :: seenHasIn (-> Int String Int Bool))

(pub fn (seenHasIn seen name i)
  (if (>= i (vecLen seen))
    false
    (if (strEq (vecGetStr seen i) name)
      true
      (seenHasIn seen name (+ i 1))
    )
  )
)

(pub :: filterKeeps (-> Int String Bool))

(pub fn (filterKeeps filter name)
  (if (== filter 0)
    true
    (seenHasIn filter name 0)
  )
)

; `mods` is a vector of (module name, filter) pairs, one per module
; resolution merged. It exists for one reader: phase D, which
; instantiates declaration macros AFTER this pass and so has to apply
; a module's import filter to names that did not exist while the pass
; was running (MAC-EXP-16). A pair rather than two parallel vectors,
; because a parallel pair is one push away from desyncing and this
; table is written in exactly one place.
(pub :: modFilterRecord (-> Int String Int Int))

(pub fn (modFilterRecord mods name filter)
  (if (== mods 0)
    0
    (let ((pair vecNew))
      {
        (vecPush
          pair          (cast Int name)
        )
        (vecPush pair filter)
        (vecPush
          mods          (cast Int pair)
        )
        0
      }
    )
  )
)

; The filter recorded for `name`, or 0 - which `filterKeeps` reads as
; "the import named nothing, so everything is kept". The entry file
; (module 0) has no import and therefore no filter, which is the same
; answer.
(pub :: modFilterFor (-> Int String Int))

(pub fn (modFilterFor mods name)
  (if (== mods 0)
    0
    (modFilterForIn mods name 0)
  )
)

(pub :: modFilterForIn (-> Int String Int Int))

(pub fn (modFilterForIn mods name i)
  (if (>= i (vecLen mods))
    0
    (let ((pair (vecGet mods i)))
      (if (strEq
        (cast String (vecGet pair 0))        name
      )
        (vecGet pair 1)
        (modFilterForIn mods name (+ i 1))
      )
    )
  )
)
