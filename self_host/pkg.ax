; pkg.ax - `axiom.pkg`, the project manifest.
;
; WHAT A DEPENDENCY WAS BEFORE THIS. A directory on `$AXIOM_PATH`, a
; colon-separated environment variable. That is a real mechanism and it
; stays - but nothing records what a program depends on, so nothing
; travels with the project, nothing can be checked, and two directories
; providing a module of the same name resolve first-wins by environment
; order, silently, with the loser's declarations compiled against
; nobody. It is the value-namespace twin of the type collision `AX3044`
; closed on 2026-08-24, and it had the same failure mode: a wrong
; answer at exit 0.
;
; THE MANIFEST. `axiom.pkg`, at or above the entry file's directory, is
; a line-based file - `#` comments, blank lines ignored, one
; `key value` pair per line:
;
;     # axiom.pkg
;     name     myapp
;     version  0.1.0
;     depend   vendor/axiom-json
;     depend   ../shared/modules
;
; `depend` names a DIRECTORY of modules, resolved against the
; manifest's own directory so the project relocates, and each one joins
; the module search path after the entry file's directory and before
; `$AXIOM_PATH`. `version` is recorded and read by nothing yet; it is
; here because a manifest that cannot say what package it describes is
; a search path with extra steps, and because it is what a registry
; would key on if there is ever one.
;
; `name` IS READ, since 2026-08-31: it is the file `axiom build` writes
; when neither `--output` nor `-o` says otherwise, in place of the
; literal `output` every project shared before. A manifest key that
; nothing reads is a key nobody can tell from a typo, which is the
; other half of this file's job - see below.
;
; A MANIFEST LINE THAT MEANS NOTHING IS REFUSED. Three shapes used to
; be read as silence, measured on the 0.6.1 binary before this changed:
;
;     $ printf 'name\tprobe\ndepend\tvendor/lib\n' > axiom.pkg
;     $ axiom check app.ax
;     error[AX5001]: cannot resolve import `Widget`      # exit 1
;
; a TAB between key and value - the split was `strStartsWith t "depend "`,
; one literal space - and the same wall of missing modules for a
; misspelled key (`dependd vendor/lib`) and for a key with no value at
; all (`depend` alone on its line). In every case the manifest that
; caused it was never named. `pkgCheckLines` now walks the file once
; and refuses an unknown key, a key with no value, a second `name` or
; `version`, and a `name` that is not a file name - each at
; `axiom.pkg:LINE`, before a byte is compiled - and the key/value split
; is any run of whitespace rather than one space.
;
; WHAT THIS IS NOT, said out loud so nobody has to discover it: there
; is no registry, no lockfile, no version constraint and no fetching.
; A dependency is a path on this machine. Every one of those is a
; policy decision that wants a maintainer to make it, and shipping a
; half-made one is worse than shipping the mechanism it would rest on.
;
; TWO DEPENDENCIES MAY NOT PROVIDE ONE MODULE. That is the property
; that makes this more than `$AXIOM_PATH`, and `pkgVerify` refuses it
; before a byte is compiled, naming both files and the manifest. It is
; checked at the MANIFEST rather than per-import on purpose: the fault
; is in the project's configuration, and reporting it only for the
; imports that happen to be ambiguous would let a program build today
; and stop building when somebody adds an import.
(import Str)

(import Vec)

(import Sys)

(import Path)

(import Fmt)

; `strConcat` three and four ways. `codegen.ax` has `cat3`/`cat4` and
; this module cannot import it: `codegen` imports THIS one, for the
; search path, and a cycle is worse than eight lines.
(pub :: pkg3 (-> String String String String))

(pub fn (pkg3 a b c) (strConcat (strConcat a b) c))

(pub :: pkg4 (-> String String String String String))

(pub fn (pkg4 a b c d) (strConcat (strConcat a (strConcat b c)) d))

; The manifest's file name. One place, because three functions here
; and one message all say it.
(pub :: pkgManifestName String)

(pub fn (pkgManifestName) "axiom.pkg")

; The nearest `axiom.pkg` at or above `dir`, or "".
;
; UP TO EIGHT LEVELS. A bound rather than a walk to the root, because
; an unbounded walk reads a file per level of every path anyone ever
; compiles from, and because a manifest eight directories above the
; file being compiled is more likely to be somebody else's than yours.
; The number is stated here rather than derived: no project in this
; repository is deeper than three.
(pub :: pkgFindManifest (-> String String))

;@axiom:effect(io)
(pub fn (pkgFindManifest dir)
  (pkgFindManifestFrom
    (if (== (strLen dir) 0)
      "./"
      (pathWithSlash dir)
    )    0
  )
)

(pub :: pkgFindManifestFrom (-> String Int String))

;@axiom:effect(io)
(pub fn (pkgFindManifestFrom dir depth)
  (if (> depth 8)
    ""
    (let ((cand (strConcat dir pkgManifestName)))
      (if (sysFileExists (strCStr cand))
        cand
        (let ((up (pathWithSlash (strConcat dir ".."))))
          (pkgFindManifestFrom up (+ depth 1))
        )
      )
    )
  )
)

; The value of the first `key` line in `text`, or "".
(pub :: pkgValue (-> String String String))

(pub fn (pkgValue text key)
  (let (
    (lines (strSplit text 10))
    (n (vecLen lines))
    (mut i 0)
  )
    (let ((mut found ""))
      {
        (while (< i n)
          {
            ; Both arms answer `Int`: `set` answers the value it
            ; assigned, which is a `String` here, and an `if` whose
            ; arms disagree is a type error reported against the `0`.
            (let ((v (pkgLineValue (vecGetStr lines i) key)))
              (if (&& (== (strLen found) 0) (> (strLen v) 0))
                {
                  (set found v)
                  0
                }
                0
              )
            )
            (set i (+ i 1))
          })
        found
      }
    )
  )
)

; Every value of `key`, in file order.
(pub :: pkgValues (-> String String (Vec Int)))

(pub fn (pkgValues text key)
  (let (
    (lines (strSplit text 10))
    (out vecNew)
    (n (vecLen lines))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (let ((v (pkgLineValue (vecGetStr lines i) key)))
            (if (> (strLen v) 0)
              (vecPush
                out                (cast Int v)
              )
              (cast (Vec Int) 0)
            )
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

; One line's value for `key`, or "".
;
; The key must be the line's WHOLE first token, so `dependency` is not
; read as `depend`, and a `#` anywhere starts a comment - which means a
; path may not contain one. That is a restriction worth stating rather
; than a bug: a `#` in a path is legal on every filesystem here, and a
; manifest format with no way to write a comment is a manifest format
; nobody annotates.
;
; THE TOKEN IS TAKEN, NOT MATCHED. This used to ask
; `strStartsWith t (strConcat key " ")` - the key followed by one
; literal space - which read `depend<TAB>vendor/lib` as no line at all
; and reported it as every module the directory would have provided
; going missing. `pkgKeyOf` splits on any whitespace, so a tab-aligned
; manifest means what it looks like, and the token it returns is what
; `pkgCheckLines` refuses when it is not a key.
(pub :: pkgLineValue (-> String String String))

(pub fn (pkgLineValue line key)
  (let ((t (pkgTrim (pkgUncomment line))))
    (let ((k (pkgKeyOf t)))
      (if (strEq k key)
        (pkgTrim (strSlice t (strLen k) (- (strLen t) (strLen k))))
        ""
      )
    )
  )
)

; The leading run of non-space bytes of an already-trimmed line: its
; key, or "" for a line that is blank once its comment is removed.
(pub :: pkgKeyOf (-> String String))

(pub fn (pkgKeyOf t)
  (let (
    (n (strLen t))
    (mut i 0)
  )
    {
      (while (if (< i n)
        (if (strIsSpace (strByte t i))
          false
          true
        )
        false
      )
        (set i (+ i 1)))
      (strSlice t 0 i)
    }
  )
)

; The three keys a manifest may write. A closed set on purpose: the
; format has no version field of its own, so a key it does not know is
; a typo rather than a message from the future.
(pub :: pkgKnownKey (-> String Bool))

(pub fn (pkgKnownKey k)
  (|| (strEq k "name") (|| (strEq k "version") (strEq k "depend")))
)

(pub :: pkgUncomment (-> String String))

(pub fn (pkgUncomment line)
  (let ((at (strFindByte line 35 0)))
    (if (< at 0)
      line
      (strSlice line 0 at)
    )
  )
)

(pub :: pkgTrim (-> String String))

(pub fn (pkgTrim s)
  (let (
    (n (strLen s))
    (mut a 0)
    (mut b (strLen s))
  )
    {
      (while (if (< a b)
        (strIsSpace (strByte s a))
        false
      )
        (set a (+ a 1)))
      (while (if (< a b)
        (strIsSpace (strByte s (- b 1)))
        false
      )
        (set b (- b 1)))
      (strSlice s a (- b a))
    }
  )
)

; The dependency directories the manifest at or above `entryDir`
; declares, each with a trailing slash and resolved against the
; MANIFEST's directory - so `depend vendor/lib` means the same thing
; wherever the project is checked out and whatever directory the
; compiler is run from.
;
; An empty Vec when there is no manifest, which is every invocation
; this repository's own gates make: the mechanism costs a project that
; does not use it one `sysFileExists` per directory level.
(pub :: pkgDependDirs (-> String (Vec Int)))

;@axiom:effect(io)
(pub fn (pkgDependDirs entryDir)
  (let ((mf (pkgFindManifest entryDir)))
    (if (== (strLen mf) 0)
      vecNew
      (let (
        (base (pathDir mf))
        (raw (pkgValues (sysReadFile (strData mf)) "depend"))
      )
        (let (
          (out vecNew)
          (n (vecLen raw))
          (mut i 0)
        )
          {
            (while (< i n)
              {
                (vecPush
                  out                  (cast Int (pathWithSlash (pkgResolve base (vecGetStr raw i))))
                )
                (set i (+ i 1))
              })
            out
          }
        )
      )
    )
  )
)

; A manifest path against the manifest's own directory. An absolute
; path is taken as it stands.
(pub :: pkgResolve (-> String String String))

(pub fn (pkgResolve base p)
  (if (pathIsAbsolute p)
    p
    (strConcat (pathWithSlash base) p)
  )
)

; The `name` the manifest at or above `entryDir` declares, or "".
;
; This is what `axiom build` writes to when the command line says
; nothing. The driver reads it BEFORE `compileFile` and therefore
; before `pkgVerify` - a `let` binding is not a use - so the check that
; makes this safe is not the one that has already run; it is that
; `pkgVerify` exits 3 from inside `compileFile`, which is between this
; call and any write, and that `pkgNameOk` admits no `/` and no `..`
; anyway, so the string could not name another directory even if the
; verification were removed.
(pub :: pkgName (-> String String))

;@axiom:effect(io)
(pub fn (pkgName entryDir)
  (let ((mf (pkgFindManifest entryDir)))
    (if (== (strLen mf) 0)
      ""
      (pkgValue (sysReadFile (strData mf)) "name")
    )
  )
)

; A package name is letters, digits, `.`, `-` and `_`, and is not `.`
; or `..`. Deliberately narrower than the filesystem: the name is spent
; as a path, so `..` or a `/` in it would write the executable
; somewhere the command line never mentioned.
(pub :: pkgNameOk (-> String Bool))

(pub fn (pkgNameOk s)
  (if (== (strLen s) 0)
    false
    (if (|| (strEq s ".") (strEq s ".."))
      false
      (pkgNameBytesOk s 0)
    )
  )
)

(pub :: pkgNameBytesOk (-> String Int Bool))

(pub fn (pkgNameBytesOk s i)
  (if (>= i (strLen s))
    true
    (if (pkgIsNameByte (strByte s i))
      (pkgNameBytesOk s (+ i 1))
      false
    )
  )
)

; `.` is 46, `-` is 45, `_` is 95.
(pub :: pkgIsNameByte (-> Int Bool))

(pub fn (pkgIsNameByte b)
  (|| (strIsAlpha b) (|| (strIsDigit b) (|| (== b 46) (|| (== b 45) (== b 95)))))
)

; `error: axiom.pkg:LINE: `, the prefix every line-level refusal here
; shares. The line number is 1-based and counts blank and comment lines
; like every editor does, because the reader's next move is to open the
; file at it.
(pub :: pkgAt (-> String Int String))

(pub fn (pkgAt mf line)
  (pkg4 "error: " mf ":" (pkg3 (fmtInt line) ": " ""))
)

; Walk the manifest once and refuse every line that cannot mean what it
; says. Answers 0; every failure exits.
;
; WHY THIS EXISTS. Before it, the reader of a manifest was
; `pkgLineValue` and nothing else: a line it did not recognise
; contributed nothing and said nothing. Measured on 0.6.1, `dependd
; vendor/lib`, `depend` with no value, and `depend<TAB>vendor/lib` all
; produced the identical output - `error[AX5001]: cannot resolve import
; `Widget``, exit 1 - which names the import, names the directories
; that were searched, and never names the file that was supposed to
; have added one. That is this repository's most-hunted defect wearing
; a manifest: a configuration mistake reported as a source mistake,
; somewhere else, later.
;
; Four refusals, all of them the same shape - the file, the line, and
; what the line would have had to be:
;
;   1. A key that is not `name`, `version` or `depend`.
;   2. A key with no value.
;   3. A second `name` or `version`. The first wins in `pkgValue`, so
;      the second is a line the file contains and the compiler ignores.
;      `depend` is exempt: repeating it is how you declare two.
;   4. A `name` that is not a file name, since it is spent as one.
(pub :: pkgCheckLines (-> String String Int))

;@axiom:effect(io)
(pub fn (pkgCheckLines text mf)
  (let (
    (lines (strSplit text 10))
    (n (vecLen lines))
    (mut i 0)
    (mut sawName 0)
    (mut sawVersion 0)
  )
    {
      (while (< i n)
        {
          (let ((t (pkgTrim (pkgUncomment (vecGetStr lines i)))))
            (if (== (strLen t) 0)
              0
              (let ((k (pkgKeyOf t)))
                (let ((v (pkgTrim (strSlice t (strLen k) (- (strLen t) (strLen k))))))
                  (if (pkgKnownKey k)
                    (if (== (strLen v) 0)
                      (pkgDie (pkg3 (pkgAt mf (+ i 1)) (pkg3 "`" k "` has no value\n") (pkg3 "       `depend` takes a directory of modules; `name` and `version`\n" "       take a word. The key and its value are separated by any run of\n" "       spaces or tabs.\n")))
                      (if (strEq k "name")
                        {
                          (if (> sawName 0)
                            (pkgDie (pkg3 (pkgAt mf (+ i 1)) "`name` is given twice\n" (pkg3 "       The first would win and this one would be ignored, which is a\n" "       manifest that says two things and means one.\n" "")))
                            0
                          )
                          (set sawName 1)
                          (if (pkgNameOk v)
                            0
                            (pkgDie (pkg3 (pkgAt mf (+ i 1)) (pkg3 "`name` is not a package name: `" v "`\n") (pkg4 "       A package name is letters, digits, `.`, `-` and `_`, and is\n" "       neither `.` nor `..`. It is the file `axiom build` writes when\n" "       no --output is given, so it names a FILE and not a path.\n" "")))
                          )
                          0
                        }
                        (if (strEq k "version")
                          {
                            (if (> sawVersion 0)
                              (pkgDie (pkg3 (pkgAt mf (+ i 1)) "`version` is given twice\n" (pkg3 "       The first would win and this one would be ignored, which is a\n" "       manifest that says two things and means one.\n" "")))
                              0
                            )
                            (set sawVersion 1)
                            0
                          }
                          0
                        )
                      )
                    )
                    (pkgDie (pkg3 (pkgAt mf (+ i 1)) (pkg3 "unknown key `" k "`\n") (pkg4 "       The manifest's keys are `name`, `version` and `depend`, and `#`\n" "       starts a comment. An unknown key used to be ignored, which made\n" "       a misspelled `depend` report as every module it would have\n" "       provided going missing - one at a time, naming this file never.\n")))
                  )
                )
              )
            )
          )
          (set i (+ i 1))
        })
      0
    }
  )
)

; Refuse a manifest that cannot mean one thing.
;
; Every failure here is configuration rather than source, so all of
; them are reported the way the driver reports a bad command line - a
; plain `error:` line naming the file, and where there is one, the line
; - rather than as an `AXnnnn` with a span. There is no span: the fault
; is in a manifest, and the code ranges in `docs/diagnostics.md` are
; about what the SOURCE said.
;
;   0. Any line that cannot mean what it says: `pkgCheckLines`, which
;      runs FIRST, because a misspelled `depend` is not a dependency
;      whose directory is missing - it is a line nothing reads, and
;      reporting it as the former would name a path the file does not
;      contain.
;   1. A `depend` directory that is not a directory. Silence here means
;      every module it was meant to provide reports as missing, one at
;      a time, naming the module and never the manifest.
;   2. Two `depend` directories providing a module of the same name.
;      Whichever came first would win, and the other package's modules
;      would compile against declarations from a package they have
;      never heard of.
;
; Answers 0, so a caller can bind it. Every failure exits.
(pub :: pkgVerify (-> String Int))

;@axiom:effect(io)
(pub fn (pkgVerify entryDir)
  (let ((mf (pkgFindManifest entryDir)))
    (if (== (strLen mf) 0)
      0
      (let ((_lines (pkgCheckLines (sysReadFile (strData mf)) mf)))
      (let ((dirs (pkgDependDirs entryDir)))
        (let (
          (n (vecLen dirs))
          (mut i 0)
        )
          {
            (while (< i n)
              {
                (if (sysIsDir (strCStr (vecGetStr dirs i)))
                  0
                  (pkgDie (pkg4 (pkg3 "error: " mf " names a dependency directory that is not there:\n") (pkg3 "       " (vecGetStr dirs i) "\n") "       `depend` names a DIRECTORY of modules, resolved against the\n" "       manifest's own directory.\n"))
                )
                (set i (+ i 1))
              })
            (pkgCheckOverlap dirs mf 0)
          }
        )
      )
      )
    )
  )
)

; Every pair of dependency directories, checked for a module both
; provide. Quadratic in the number of dependencies and linear in their
; contents, which is the right shape for a list a human typed.
(pub :: pkgCheckOverlap (-> (Vec Int) String Int Int))

;@axiom:effect(io)
(pub fn (pkgCheckOverlap dirs mf i)
  (if (>= i (vecLen dirs))
    0
    {
      (pkgCheckPair dirs mf i (+ i 1))
      (pkgCheckOverlap dirs mf (+ i 1))
    }
  )
)

(pub :: pkgCheckPair (-> (Vec Int) String Int Int Int))

;@axiom:effect(io)
(pub fn (pkgCheckPair dirs mf i j)
  (if (>= j (vecLen dirs))
    0
    {
      (let ((clash (pkgFirstShared (vecGetStr dirs i) (vecGetStr dirs j))))
        (if (== (strLen clash) 0)
          0
          (pkgDie (pkg4 (pkg3 "error: two dependencies in " mf " provide the module `") (pkg3 (pathStem clash) "`:\n" "") (pkg3 "       " (strConcat (vecGetStr dirs i) clash) "\n") (pkg4 "       " (strConcat (vecGetStr dirs j) clash) "\n" "       One of them would win by declaration order and the other's\n       modules would compile against declarations they never named.\n")))
        )
      )
      (pkgCheckPair dirs mf i (+ j 1))
    }
  )
)

; The first `.ax` file both directories hold, or "".
(pub :: pkgFirstShared (-> String String String))

;@axiom:effect(io)
(pub fn (pkgFirstShared a b)
  (let (
    (entries (sysReadDir (strCStr a)))
    (n (vecLen (sysReadDir (strCStr a))))
  )
    (let (
      (mut i 0)
      (mut hit "")
    )
      {
        (while (< i (vecLen entries))
          {
            (let ((name (vecGetStr entries i)))
              (if (&& (== (strLen hit) 0) (&& (strEq (pathExt name) ".ax") (sysFileExists (strCStr (strConcat b name)))))
                {
                  (set hit name)
                  0
                }
                0
              )
            )
            (set i (+ i 1))
          })
        hit
      }
    )
  )
)

; The driver's refusal shape: the message on fd 2, exit 3 - this
; compiler's code for "a module could not be read or parsed", which is
; what a manifest naming a module twice or naming nothing amounts to.
(pub :: pkgDie (-> String Int))

;@axiom:effect(io)
(pub fn (pkgDie msg)
  {
    (sysWriteAllFd 2 (strData msg) (strLen msg) 0)
    (sysExitWith 3)
    0
  }
)
