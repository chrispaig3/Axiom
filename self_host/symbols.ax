; symbols.ax - `axiom symbols` (AXSYM), self-hosted: the foundation.
;
; AXSYM's grammar is one line per fact:
;
;   <KIND> <NAME> <FILE>:<LOC> "<TYPE>" @<nid> [#<meta>]*
;
; with `-` in place of the location for builtins. The type string is
; the type CHECKER's rendering - curried infix arrows, bare
; application arguments - not the source syntax the formatter prints:
; `(-> Int Int Int)` in source is `"(Int -> (Int -> Int))"` here,
; because that is what stage0's `TypeId::Display` emits and the
; criterion is its bytes.
;
; The `@nid` is FNV-1a 64 over `DKind:name`. stage0 used to feed the
; same key through Rust's `DefaultHasher` - std documents that
; hasher's algorithm as unspecified and subject to change, so a
; "stable node ID" was stable only until a toolchain upgrade, and a
; port would have chained this compiler to std's internals. Both
; compilers now use FNV-1a 64, which is four lines in either language.
;
; This module deliberately imports nothing from typecheck.ax: the
; fact COLLECTION walks checker tables and lives with them; this file
; is the rendering half, testable against cached stage0 output alone.
(import Mem)

(import Str)

(import Vec)

(import Utf8)

(import core)

(import parser)

(import typecheck)

; for `expGenOf`: the (name, macro) pairs phase D answers, which is
; what marks a row `#generated` (MAC-TOOL-4).
(import expand)

(import diag)

; A minimal digit formatter, local so this module need not import
; `Fmt` - codegen defines its own `fmtInt`, and importing a second
; would make every bare `fmtInt` in the program ambiguous. Reached
; only by the effect-params index fallback, which no probed checker
; state can construct.
(pub :: symsDigits (-> Int String))

(pub fn (symsDigits n)
  (if (< n 10)
    (let ((s (strAlloc 1)))
      {
        (__store8 (strData s) 0 (+ n 48))
        s
      }
    )
    (strConcat
      (symsDigits (/ n 10))      (let ((s (strAlloc 1)))
        {
          (__store8 (strData s) 0 (+ (% n 10) 48))
          s
        }
      )
    )
  )
)

; ------------------------------------------------------------------
; FNV-1a 64.
;
; offset basis 0xcbf29ce484222325 exceeds 2^63, so it is spelled as
; the negative decimal of the same bit pattern - hex literals do not
; exist and `*`/`^` wrap mod 2^64, which is exactly what FNV wants.
; ------------------------------------------------------------------
(pub :: fnv1a64 (-> String Int))

(pub fn (fnv1a64 s)
  (let (
    (mut h (- 0 3750763034362895579))
    (mut i 0)
    (n (strLen s))
  )
    {
      (while (< i n)
        {
          (set h (* (^ h (strByte s i)) 1099511628211))
          (set i (+ i 1))
        })
      h
    }
  )
)

; The 16-digit zero-padded lowercase hex of a 64-bit value, treated
; as unsigned. `fmtHexDigits` divides, and division is signed, so a
; hash with the top bit set needs its nibbles extracted by shift and
; mask instead: an arithmetic shift sign-fills only ABOVE bit 3, and
; `& 15` keeps bits 0-3, so every nibble comes out true.
(pub :: symHex16 (-> Int String))

(pub fn (symHex16 h)
  (let (
    (out (strAlloc 16))
    (mut k 0)
  )
    {
      (while (< k 16)
        (let ((nib (& (>> h (* 4 (- 15 k))) 15)))
          {
            (__store8
              (strData out)              k              (if (< nib 10)
                (+ 48 nib)
                (+ 87 nib)
              )
            )
            (set k (+ k 1))
          }
        ))
      out
    }
  )
)

(pub :: symNid (-> String String String))

(pub fn (symNid kindKey name) (symHex16 (fnv1a64 (strConcat kindKey name))))

; ------------------------------------------------------------------
; The type checker's type rendering: `TypeId::Display`, over the
; TAG_T_* nodes of parser.ax.
;
;   TError        {unknown}
;   TVar          name
;   TCon          name, or `name arg arg` with each arg rendered
;                 recursively and NO wrapping parens of its own
;   TArr          (a -> b), fully parenthesised, right-nested
;   TTuple        (a, b); the empty tuple is `()`
;   TList         [a]
;   TPtr          *a  or  *mut a
; ------------------------------------------------------------------
(pub :: symTy (-> Int String))

(pub fn (symTy t)
  (if (== t 0)
    "{unknown}"
    (let ((tag (nodeTag t)))
      (if (== tag TAG_T_ERR)
        "{unknown}"
        (if (== tag TAG_T_VAR)
          (nodeAName t)
          (if (== tag TAG_T_CON)
            (let ((args (nodeB t)))
              (if (|| (== args 0) (== (vecLen args) 0))
                (nodeAName t)
                (let (
                  (mut s (nodeAName t))
                  (mut i 0)
                )
                  {
                    (while (< i (vecLen args))
                      {
                        (set s (strConcat s (strConcat " " (symTy (vecGet args i)))))
                        (set i (+ i 1))
                      })
                    s
                  }
                )
              )
            )
            (if (== tag TAG_T_ARR)
              (strConcat "(" (strConcat (symTy (nodeA t)) (strConcat " -> " (strConcat (symTy (nodeB t)) ")"))))
              (if (== tag TAG_T_TUP)
                (let (
                  (xs (nodeA t))
                  (mut s "(")
                  (mut i 0)
                )
                  {
                    (if (== xs 0)
                      0
                      (while (< i (vecLen xs))
                        {
                          (if (> i 0)
                            (set s (strConcat s ", "))
                            ""
                          )
                          (set s (strConcat s (symTy (vecGet xs i))))
                          (set i (+ i 1))
                        })
                    )
                    (strConcat s ")")
                  }
                )
                (if (== tag TAG_T_LIST)
                  (strConcat "[" (strConcat (symTy (nodeA t)) "]"))
                  (if (== tag TAG_T_PTR)
                    (strConcat
                      (if (== (nodeB t) 1)
                        "*mut "
                        "*"
                      )                      (symTy (nodeA t))
                    )
                    "{unknown}"
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; One AXSYM line. The location string is the caller's - it owns the
; file registry and the char-column conversion - and `-` means
; builtin. An empty `nid` is OMITTED, not printed empty: constructor
; facts carry none (measured: `C Some - "(a -> Option a)" #of=Option`
; has no `@`). Metas arrive as a Vec of ready `key=value` strings and
; print in order, each as ` #meta`.
; ------------------------------------------------------------------
(pub :: symLine (-> String String String String String Int String))

(pub fn (symLine kind name loc ty nid metas)
  (let ((mut s kind))
    {
      (set s (strConcat s (strConcat " " name)))
      (set s (strConcat s (strConcat " " loc)))
      (set s (strConcat s (strConcat " \"" (strConcat ty "\""))))
      (if (> (strLen nid) 0)
        (set s (strConcat s (strConcat " @" nid)))
        ""
      )
      (let ((mut i 0))
        (if (== metas 0)
          0
          (while (< i (vecLen metas))
            {
              (set s (strConcat s (strConcat " #" (vecGetStr metas i))))
              (set i (+ i 1))
            })
        )
      )
      (strConcat s "\n")
    }
  )
)

; ------------------------------------------------------------------
; Fact collection.
;
; stage0 walks its checker tables for the facts and its AST for the
; spans; this walks stage1's TC tables and the resolved declaration
; list the same way. Keys are the REGISTERED names - imported
; declarations arrive pre-mangled to `Mod$name`, which is stage0's
; (name, module) pair spelled as one string - and the printed name is
; the bare half. Maps are parallel Vecs with linear lookup: a module
; has tens of declarations, not thousands.
; ------------------------------------------------------------------
(pub :: saIdx (-> Int String Int))

(pub fn (saIdx names key)
  (let (
    (mut i 0)
    (mut hit (- 0 1))
  )
    {
      (while (< i (vecLen names))
        {
          (if (&& (< hit 0) (strEq (vecGetStr names i) key))
            (set hit i)
            0
          )
          (set i (+ i 1))
        })
      hit
    }
  )
)

; Insert-or-overwrite (stage0's `insert`).
(pub :: saPut (-> Int Int String a Int))

(pub fn (saPut names vals key val)
  (let ((i (saIdx names key)))
    (if (< i 0)
      {
        (vecPush names key)
        (vecPush vals val)
        0
      }
      {
        (vecSet vals i val)
        0
      }
    )
  )
)

; Insert-if-absent (stage0's `or_insert`).
(pub :: saPutSoft (-> Int Int String Int Int))

(pub fn (saPutSoft names vals key val)
  (if (< (saIdx names key) 0)
    {
      (vecPush names key)
      (vecPush vals val)
      0
    }
    0
  )
)

; The two-value variants, for one names Vec shared by TWO value Vecs
; (a span AND a unit). The single-value put breaks lockstep there: the
; first put pushes the name, the second then finds it present and
; `vecSet`s into a value Vec that has no such slot yet.
(pub :: saPut2 (-> Int Int Int String Int Int Int))

(pub fn (saPut2 names v1 v2 key a b)
  (let ((i (saIdx names key)))
    (if (< i 0)
      {
        (vecPush names key)
        (vecPush v1 a)
        (vecPush v2 b)
        0
      }
      {
        (vecSet v1 i a)
        (vecSet v2 i b)
        0
      }
    )
  )
)

(pub :: saPutSoft2 (-> Int Int Int String Int Int Int))

(pub fn (saPutSoft2 names v1 v2 key a b)
  (if (< (saIdx names key) 0)
    {
      (vecPush names key)
      (vecPush v1 a)
      (vecPush v2 b)
      0
    }
    0
  )
)

(pub :: saGet (-> Int Int String Int))

(pub fn (saGet names vals key)
  (let ((i (saIdx names key)))
    (if (< i 0)
      0
      (vecGet vals i)
    )
  )
)

; Byte-wise ascending insertion sort, in place: stage0's effect list
; arrives sorted (probed: `Beta,zeta`), and byte order is what Rust's
; string ordering is.
(pub :: strLtBytes (-> String String Bool))

(pub fn (strLtBytes a b)
  (let (
    (la (strLen a))
    (lb (strLen b))
    (mut i 0)
    (mut ans (- 0 1))
  )
    {
      (while (&& (< ans 0) (&& (< i la) (< i lb)))
        (let (
          (ca (strByte a i))
          (cb (strByte b i))
        )
          (if (< ca cb)
            (set ans 1)
            (if (> ca cb)
              (set ans 0)
              (set i (+ i 1))
            )
          )
        ))
      (if (< ans 0)
        (< la lb)
        (== ans 1)
      )
    }
  )
)

(pub :: saSort (-> Int Int))

(pub fn (saSort v)
  (let ((mut i 1))
    {
      (while (< i (vecLen v))
        (let ((mut j i))
          {
            (while (&& (> j 0) (strLtBytes (vecGetStr v j) (vecGetStr v (- j 1))))
              {
                (let ((t (vecGet v j)))
                  {
                    (vecSet v j (vecGet v (- j 1)))
                    (vecSet v (- j 1) t)
                  }
                )
                (set j (- j 1))
              })
            (set i (+ i 1))
          }
        ))
      v
    }
  )
)

(pub :: saJoinComma (-> Int String))

(pub fn (saJoinComma v)
  (let (
    (mut s "")
    (mut i 0)
  )
    {
      (while (< i (vecLen v))
        {
          (if (> i 0)
            (set s (strConcat s ","))
            ""
          )
          (set s (strConcat s (vecGetStr v i)))
          (set i (+ i 1))
        })
      s
    }
  )
)

; A byte AXSYM's own grammar reads, and therefore one an AXTAG may not
; put into a meta token unescaped: space and every control byte
; (`< 33`), `"`, `#`, `%` - the escape introducer, which has to be
; escaped too or the encoding would not be reversible - and DEL. A
; byte at or above 128 passes through, which keeps a UTF-8 tag value
; intact.
(pub :: saAxStructural (-> Int Bool))

(pub fn (saAxStructural b) (|| (< b 33) (|| (== b 34) (|| (== b 35) (|| (== b 37) (== b 127))))))

; Named apart from render.ax's `jsonHexDigit` and codegen's `hexDigit`
; because imports join one flat top-level namespace.
(pub :: saHexDigit (-> Int Int))

(pub fn (saHexDigit n)
  (if (< n 10)
    (+ 48 n)
    (+ 55 n)
  )
)

; An AXTAG's own bytes, made safe to put on an AXSYM line: every
; structural byte as `%XX`, everything else verbatim.
;
; WHY THIS EXISTS. `symLine` prints each meta as ` #meta` and
; `axsymMetaScan` (stdlib/Agent/Tags.ax) opens a NEW token at any `#`
; that follows a space, so an AXTAG whose value carried one used to
; forge as many metadata fields as it liked. Measured on a three-line
; file:
;
;   ;@axiom:agent:note(ok #effect=io #effects=Alloc #agent:allowed=all)
;   (fn (fB n) (+ n 1))
;
; `check` printed OK and exited 0, and the row read
;
;   F fB tags.ax:2:6-8 "(Int -> Int)" @4de8a934d7defbcf
;     #agent:note=ok #effect=io #effects=Alloc #agent:allowed=all
;
; of which exactly ONE field - `#agent:note=ok` - was a tag anyone
; wrote. On a function that really performs IO the same shape put
; `#effects=Alloc` in front of the compiler's own `#effects=IO`, and
; `symEffects`, which answered the FIRST match, said `Alloc`. The
; `agent:*` namespace is the perfect carrier because AX3039 never
; fires on a key containing `:`, so the forgery drew no diagnostic at
; all. `docs/agent-harness.md` §3.4 has `Agent.Policy` reading exactly
; those two fields off this line, so what the hole bought was a policy
; gate reporting whatever the file under inspection asked it to.
;
; ESCAPED RATHER THAN REJECTED. This runs off the checker's tables,
; long after the parse, with no span to point a diagnostic at - so a
; rejection here could only drop the value in silence, and a row that
; silently drops what the source says is a second way for AXSYM to
; stop being an injective rendering of what the compiler knows. `%XX`
; keeps it injective, and `axsymUnpct` hands the author's exact bytes
; back, so `agent:*` tags still survive fmt, AXSYM and import
; (docs/agent-harness.md §7) unchanged. The KEY is escaped as well as
; the value: `scanAxtags` takes everything from `;@axiom:` to the
; newline, so `;@axiom:a #effects=IO` is a key with a space in it and
; forges the same field one byte earlier.
;
; Measured over this repository: no AXTAG in stdlib/, self_host/ or
; tests/ contains a byte this escapes, so the whole corpus renders
; identically and neither AXSYM golden moves.
(pub :: saAxSafe (-> String String))

(pub fn (saAxSafe s)
  (let (
    (n (strLen s))
    (mut i 0)
    (mut acc "")
  )
    {
      (while (< i n)
        (let ((b (strByte s i)))
          {
            (if (saAxStructural b)
              (set acc (strConcat acc (strConcat "%" (strConcat (strFromByte (saHexDigit (/ b 16))) (strFromByte (saHexDigit (% b 16)))))))
              (set acc (strConcat acc (strSlice s i 1)))
            )
            (set i (+ i 1))
          }
        ))
      acc
    }
  )
)

; An AXTAG's content as its AXSYM meta: `effect(io)` is `effect=io`,
; a bare or empty-parens tag is its key alone - the value runs from
; the first `(` to the LAST `)`, exactly stage0's parse. Both halves
; go through `saAxSafe`; the `=` between them is the compiler's, not
; the author's, and is the only structural byte the token can carry.
(pub :: saAxMeta (-> String String))

(pub fn (saAxMeta content)
  (let (
    (n (strLen content))
    (mut paren (- 0 1))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (if (&& (< paren 0) (== (strByte content i) 40))
            (set paren i)
            0
          )
          (set i (+ i 1))
        })
      (if (< paren 0)
        (saAxSafe content)
        (let ((mut close (- n 1)))
          {
            (while (&& (> close paren) (!= (strByte content close) 41))
              (set close (- close 1)))
            (if (<= (- close paren) 1)
              (saAxSafe (strSlice content 0 paren))
              (strConcat (saAxSafe (strSlice content 0 paren)) (strConcat "=" (saAxSafe (strSlice content (+ paren 1) (- close (+ paren 1))))))
            )
          }
        )
      )
    }
  )
)

; The unit index a module's declarations render against: unit 0 is
; the entry file; an import's unit carries its module name.
(pub :: saUnitOf (-> Int a Int))

(pub fn (saUnitOf units module)
  (if (==
    (cast Int module)    0
  )
    0
    (let (
      (mut i 1)
      (mut hit 0)
    )
      {
        (while (< i (vecLen units))
          {
            (if (&&
              (== hit 0)              (strEq
                (memGetWordStr (vecGet units i) 2)                (cast String module)
              )
            )
              (set hit i)
              0
            )
            (set i (+ i 1))
          })
        hit
      }
    )
  )
)

; The whole collection state, one handle: parallel-vec maps for the
; three span namespaces, ctor spans, nid variants, axtags, and fn
; parameter names.
(pub struct SymMaps
  (fnN : Int)
  (fnS : Int)
  (fnU : Int)
  (tyN : Int)
  (tyS : Int)
  (tyU : Int)
  (trN : Int)
  (trS : Int)
  (trU : Int)
  (ctN : Int)
  (ctS : Int)
  (ctU : Int)
  (nidN : Int)
  (nidV : Int)
  (tagN : Int)
  (tagV : Int)
  (prmN : Int)
  (prmV : Int)
  (opN : Int)
  (opV : Int)
  ; Macros. `symbols` emitted no row for one until 2026-08-26, so
  ; twelve public names in the standard library - `println` and
  ; `format` among them - were API that nothing over this stream could
  ; see. `compat/UNCOVERED` listed them as a hole; these three slots
  ; are what closes it.
  (mcN : Int)
  (mcS : Int)
  (mcU : Int)
  ; The effect DECLARATION itself. Its operations were already keyed
  ; (slots 18/19), which is what a handler needs; the effect's own name
  ; had no row, so `Assert` was public API outside the stream.
  (efN : Int)
  (efS : Int)
  (efU : Int))

(pub :: smNew Int)

(pub fn (smNew)
  (cast Int (SymMaps
    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew    vecNew
  ))
)

; One declaration into the maps. The rules are stage0's exactly:
; DSig overwrites a function span, DFn only fills an absent one;
; the nid variant is the LAST declaration mentioning the name;
; the axtag set is the last NON-EMPTY one.
; A GENERATED declaration is not a symbol. Lowering an `impl` appends
; a signature and a definition named `Trait#Type#method`, and those
; are the compiler's business: `symbols` reports what the file
; declares, and the position verifier is right to refuse a claim the
; source does not spell. `#` is not an identifier byte, so a name that
; contains one cannot have been written.
(pub :: smGenerated (-> String Bool))

(pub fn (smGenerated name) (>= (strFindByte name 35 0) 0))

(pub :: smCollect (-> Int Int Int Int))

(pub fn (smCollect sm d units)
  (if (smGenerated (nodeAName d))
    0
    (let (
      (tag (nodeTag d))
      (name (nodeAName d))
      (u (saUnitOf units (nodeModule d)))
    )
      {
        (if (== tag TAG_D_SIG)
          {
            (saPut2
              (memGetWord sm 0)              (memGetWord sm 1)              (memGetWord sm 2)              name              (nodeSpan d)              u
            )
            (smNid sm name "DSig:")
            (smTags sm d name)
          }
          (if (== tag TAG_D_FN)
            {
              (saPutSoft2
                (memGetWord sm 0)                (memGetWord sm 1)                (memGetWord sm 2)                name                (nodeSpan d)                u
              )
              (smNid sm name "DFn:")
              (smTags sm d name)
              (saPut (memGetWord sm 16) (memGetWord sm 17) name (nodeB d))
            }
            (if (== tag TAG_D_DATA)
              {
                (saPut2
                  (memGetWord sm 3)                  (memGetWord sm 4)                  (memGetWord sm 5)                  name                  (nodeSpan d)                  u
                )
                (smNid sm name "DData:")
                (smTags sm d name)
                (let (
                  (ctors (nodeB d))
                  (mut i 0)
                )
                  (while (< i (vecLen ctors))
                    (let ((c (vecGet ctors i)))
                      {
                        (saPut2
                          (memGetWord sm 9)                          (memGetWord sm 10)                          (memGetWord sm 11)                          (nodeAName c)                          (nodeSpan c)                          u
                        )
                        (set i (+ i 1))
                      }
                    ))
                )
              }
              (if (== tag TAG_D_STRUCT)
                {
                  (saPut2
                    (memGetWord sm 3)                    (memGetWord sm 4)                    (memGetWord sm 5)                    name                    (nodeSpan d)                    u
                  )
                  (smNid sm name "DStruct:")
                  (smTags sm d name)
                }
                (if (== tag TAG_D_ALIAS)
                  {
                    (saPut2
                      (memGetWord sm 3)                      (memGetWord sm 4)                      (memGetWord sm 5)                      name                      (nodeSpan d)                      u
                    )
                    (smNid sm name "DType:")
                    (smTags sm d name)
                  }
                  (if (== tag TAG_D_MACRO)
                    {
                      (saPut2
                        (memGetWord sm 20)                        (memGetWord sm 21)                        (memGetWord sm 22)                        name                        (nodeSpan d)                        u
                      )
                      (smNid sm name "DMacro:")
                      (smTags sm d name)
                    }
                  (if (== tag TAG_D_TRAIT)
                    {
                      (saPut2
                        (memGetWord sm 6)                        (memGetWord sm 7)                        (memGetWord sm 8)                        name                        (nodeSpan d)                        u
                      )
                      (smNid sm name "DTrait:")
                      (smTags sm d name)
                    }
                    (if (== tag TAG_D_EXTERN)
                      ; An `extern` item has a LOCATION: the item in its block,
                      ; keyed like a signature so `symbols` and the LSP point at
                      ; it rather than answering `builtin` (the checker registers
                      ; it as a function with no span of its own)
                      (let (
                        (items (nodeC d))
                        (mut i 0)
                      )
                        (if (== items 0)
                          0
                          (while (< i (vecLen items))
                            (let ((f (vecGet items i)))
                              {
                                (saPut2
                                  (memGetWord sm 0)                                  (memGetWord sm 1)                                  (memGetWord sm 2)                                  (nodeAName f)                                  (nodeSpan f)                                  u
                                )
                                (smNid sm (nodeAName f) "DExtern:")
                                (if (== (nodeModule d) 0)
                                  0
                                  (saPut2
                                    (memGetWord sm 0)                                    (memGetWord sm 1)                                    (memGetWord sm 2)                                    (strConcat (strConcat (nodeModuleName d) "$") (nodeAName f))                                    (nodeSpan f)                                    u
                                  )
                                )
                                (set i (+ i 1))
                              }
                            ))
                        )
                      )
                      (if (== tag TAG_D_EFFECT)
                        ; Operation types, keyed under both spellings the checker
                        ; registers ops with - AND the effect's own name, which
                        ; had no row until 2026-08-26.
                        (let (
                          (fields (nodeC d))
                          (mut i 0)
                          (_e (saPut2
                            (memGetWord sm 23)                            (memGetWord sm 24)                            (memGetWord sm 25)                            name                            (nodeSpan d)                            u
                          ))
                          (_n (smNid sm name "DEffect:"))
                        )
                          (if (== fields 0)
                            0
                            (while (< i (vecLen fields))
                              (let ((f (vecGet fields i)))
                                {
                                  (saPut (memGetWord sm 18) (memGetWord sm 19) (nodeAName f) (nodeB f))
                                  (if (== (nodeModule d) 0)
                                    0
                                    (saPut (memGetWord sm 18) (memGetWord sm 19) (strConcat (strConcat (nodeModuleName d) "$") (nodeAName f)) (nodeB f))
                                  )
                                  (set i (+ i 1))
                                }
                              ))
                          )
                        )
                        0
                      )
                    )
                  )
                  )
                )
              )
            )
          )
        )
        0
      }
    )
  )
)

(pub :: smNid (-> Int String String Int))

(pub fn (smNid sm name variant) (saPut (memGetWord sm 12) (memGetWord sm 13) name variant))

(pub :: smTags (-> Int Int String Int))

(pub fn (smTags sm d name)
  (let ((tags (nodeAxtags d)))
    (if (== tags 0)
      (saPutSoft (memGetWord sm 14) (memGetWord sm 15) name 0)
      (if (== (vecLen tags) 0)
        (saPutSoft (memGetWord sm 14) (memGetWord sm 15) name tags)
        (saPut (memGetWord sm 14) (memGetWord sm 15) name tags)
      )
    )
  )
)

(pub :: smBuild (-> Int Int Int))

(pub fn (smBuild decls units)
  (let (
    (sm smNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen decls))
        {
          (smCollect sm (vecGet decls i) units)
          (set i (+ i 1))
        })
      sm
    }
  )
)

; ------------------------------------------------------------------
; Emission: fn facts, then each data with its constructors, then
; structs, aliases, traits - stage0's table order.
; ------------------------------------------------------------------
; The location string for `key` in the span namespace held at map
; slots (nIx, sIx, uIx), or "" when the name has no recorded span.
(pub :: smLocReal (-> Int Int Int Int String Int String))

(pub fn (smLocReal sm nIx sIx uIx key units)
  (let ((i (saIdx (memGetWord sm nIx) key)))
    (if (< i 0)
      ""
      (let ((sp (vecGet (memGetWord sm sIx) i)))
        (if (== sp 0)
          ""
          (let ((unit (vecGet units (vecGet (memGetWord sm uIx) i))))
            (strConcat (memGetWordStr unit 0) (strConcat ":" (fmtSpan (memGetWordStr unit 1) sp)))
          )
        )
      )
    )
  )
)

; The nid for `key`, or "" for a name with no recorded declaration
; (builtins, effect operations).
(pub :: smNidFor (-> Int String String))

(pub fn (smNidFor sm key)
  (let ((i (saIdx (memGetWord sm 12) key)))
    (if (< i 0)
      ""
      (symNid (vecGetStr (memGetWord sm 13) i) (bareOf key))
    )
  )
)

; The AXTAG metas for `key`, pushed in source order.
;
; EVERY CALLER PUSHES THESE FIRST, and the compiler's own derived keys
; - `effects=`, `effect-params=`, `generated=`, `ctors=`, `fields=`,
; `tyvars=`, `methods=` - after them. That ordering is the second half
; of the forgery fix `saAxSafe` opens, and it is the half that still
; holds if a future escape misses a byte: `symTagFrom`
; (stdlib/Agent/Tags.ax) answers the LAST `#key` on the line, so a
; compiler-owned key can no longer be shadowed by anything a file
; contains, whether the collision arrives through a value (` #effects=`
; inside an AXTAG value) or through the key itself.
;
; The key collision is real and is NOT what `saAxSafe` closes:
;
;   ;@axiom:effects(Alloc)
;   (fn (leak n) { (println "io") n })
;
; is a legal, well-formed AXTAG. It draws AX3039 - a WARNING, exit 0 -
; and used to render `#effects=Alloc #effects=IO`, first match `Alloc`,
; on a function that writes to stdout. Four of these seven derived keys
; were emitted BEFORE the author's tags until this change (`D`, `S`,
; `A`, `T`), which is why the ordering is stated here rather than left
; to whichever site is read first.
(pub :: smTagMetas (-> Int String Int Int))

(pub fn (smTagMetas sm key metas)
  (let ((tags (saGet (memGetWord sm 14) (memGetWord sm 15) key)))
    (if (== tags 0)
      0
      (let ((mut i 0))
        (while (< i (vecLen tags))
          {
            (vecPush metas (saAxMeta (memGetWordStr (vecGet tags i) 1)))
            (set i (+ i 1))
          })
      )
    )
  )
)

; ------------------------------------------------------------------
; The human table.
;
; `symbols` prints AXSYM by default and printed it under every format,
; which was the last of the three divergences the self-hosting record
; recorded OPEN: stage0's bare `symbols` printed an aligned table and
; only `--diagnostic-format=ai` gave AXSYM. The flag surface matched;
; the default did not.
;
; Derived from the AXSYM text by re-reading it, not by threading a mode
; through fact collection. Two reasons. The fact walk is four hundred
; lines with a dozen `symLine` call sites, and a second renderer
; interleaved through it is a second place for a fact to go missing.
; And a table derived from AXSYM cannot disagree with AXSYM about what
; the symbols are - which is a property the gate would otherwise have
; had to check, and now gets for free.
;
; stage0's format, verbatim: `{:<8} {:<20} {:<40} [{}]`, with the kind
; as its Rust variant name and a spanless fact reading `builtin` where
; AXSYM writes `-`. Columns are padded in CHARACTERS, so a non-ASCII
; name pads to the width a reader sees.
; ------------------------------------------------------------------
(pub :: symKindWord (-> String String))

(pub fn (symKindWord k)
  (if (strEq k "F")
    "Fn"
    (if (strEq k "D")
      "Data"
      (if (strEq k "C")
        "Ctor"
        (if (strEq k "S")
          "Struct"
          (if (strEq k "A")
            "Alias"
            (if (strEq k "E")
              "Effect"
              (if (strEq k "M")
              "Macro"
              (if (strEq k "T")
                "Trait"
                k
              )
            )
            )
          )
        )
      )
    )
  )
)

; Characters, not bytes - the same rule every column in this compiler
; counts by.
(pub :: symCharLen (-> String Int))

(pub fn (symCharLen s)
  (let (
    (n (strLen s))
    (mut i 0)
    (mut c 0)
  )
    {
      (while (< i n)
        {
          (if (utf8IsCont (strByte s i))
            0
            (set c (+ c 1))
          )
          (set i (+ i 1))
        })
      c
    }
  )
)

(pub :: symPad (-> String Int String))

(pub fn (symPad s w)
  (let ((have (symCharLen s)))
    (if (>= have w)
      s
      (let (
        (out (strAlloc (- w have)))
        (mut i 0)
      )
        {
          (while (< i (- w have))
            {
              (memPutByte (strData out) i 32)
              (set i (+ i 1))
            })
          (strConcat s out)
        }
      )
    )
  )
)

; One past the last byte of the line starting at `i`.
; The byte after the next space at or after `i`, and the field before
; it. Fields one to three of an AXSYM line are space-delimited and
; contain no spaces; the type that follows them is quoted and may.
(pub :: symField (-> String Int Int Int))

(pub fn (symField s i e)
  (let ((mut j i))
    {
      (while (&& (< j e) (!= (strByte s j) 32))
        (set j (+ j 1)))
      j
    }
  )
)

(pub :: symbolsHumanTable (-> String String))

(pub fn (symbolsHumanTable axsym)
  (let (
    (n (strLen axsym))
    (parts vecNew)
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((e (lineEndFrom axsym i)))
          {
            (if (> e i)
              ; the type is quoted; take what is between
              ; the first `"` after the location and the
              ; last one on the line
              (let ((k1 (symField axsym i e)))
                (let ((k2 (symField axsym (+ k1 1) e)))
                  (let ((k3 (symField axsym (+ k2 1) e)))
                    (let (
                      (kind (strSlice axsym i (- k1 i)))
                      (name (strSlice axsym (+ k1 1) (- k2 (+ k1 1))))
                      (loc (strSlice axsym (+ k2 1) (- k3 (+ k2 1))))
                      (ty (let (
                        (a (+ k3 2))
                        (mut b (- e 1))
                      )
                        {
                          (while (&& (> b a) (!= (strByte axsym b) 34))
                            (set b (- b 1)))
                          (if (> b a)
                            (strSlice axsym a (- b a))
                            ""
                          )
                        }
                      ))
                    )
                      {
                        (vecPush parts (symPad (symKindWord kind) 8))
                        (vecPush parts " ")
                        (vecPush parts (symPad name 20))
                        (vecPush parts " ")
                        (vecPush parts (symPad ty 40))
                        (vecPush parts " [")
                        (vecPush
                          parts                          (if (strEq loc "-")
                            "builtin"
                            loc
                          )
                        )
                        (vecPush parts "]\n")
                      }
                    )
                  )
                )
              )
              0
            )
            (set i (+ e 1))
          }
        ))
      (catStrs parts)
    }
  )
)

; `gens` is `expandProgram`'s answer - the (name, macro) pairs of every
; declaration phase D generated. A row it names carries `#generated=`
; and the macro's own name, which is what tells a reader why a symbol
; has no visible definition (MAC-TOOL-4). 0 means "no table", which is
; every caller that did not expand.
(pub :: symbolsRenderGens (-> Int Int Int Int String))

(pub fn (symbolsRenderGens tc builtins gens calls)
  ; --- functions --------------------------------------------
  (let (
    (units (memGetWord tc 13))
    (decls (tcAllDecls tc))
    (lines vecNew)
  )
    (let ((sm (smBuild decls units)))
      {
        (let (
          (fns (tcFns tc))
          (mut i 0)
        )
          (while (< i (vecLen fns))
            (let ((e (vecGet fns i)))
              (let (
                (name (memGetWordStr e 0))
                (isB (memGetWord e 3))
                (isOp (memGetWord e 4))
              )
                {
                  ; A GENERATED name is not a symbol. Lowering an
                  ; `impl` appends `Trait#Type#method` declarations,
                  ; and they are the compiler's business: `symbols`
                  ; reports what the file declares, and the position
                  ; verifier is right to refuse a claim the source does
                  ; not spell. `#` is not an identifier byte, so a name
                  ; containing one cannot have been written.
                  (if (|| (smGenerated name) (|| (&& (== isB 1) (== builtins 0)) (&& (== isOp 1) (!= (strLen (bareOf name)) (strLen name)))))
                    0
                    (let (
                      (metas vecNew)
                      (loc (smLocReal
                        sm                        0                        1                        2                        name                        units
                      ))
                    )
                      {
                        (smTagMetas sm name metas)
                        (let ((gm (expGenOf gens name)))
                          (if (==
                            (cast Int gm)                            0
                          )
                            0
                            (vecPush metas (strConcat "generated=" gm))
                          )
                        )
                        ; The incompleteness sentinel rides in the same
                        ; Vec and is NOT an effect: rendering it put
                        ; `incomplete` in the middle of `#effects=IO,
                        ; incomplete`, where it reads like an effect
                        ; named "incomplete". It gets its own meta,
                        ; because what it says is about the LIST rather
                        ; than a member of it - `#effects=` is a lower
                        ; bound, not the set. A function with nothing but
                        ; the sentinel prints `#effects-incomplete` and no
                        ; `#effects=` at all, which is the honest
                        ; rendering of "the walk did not resolve a call
                        ; and found nothing else".
                        (let ((effs (memGetWord e 5)))
                          (if (== isB 0)
                            (let (
                              (disp vecNew)
                              (mut k 0)
                              (mut partial 0)
                              (mut overapprox 0)
                            )
                              {
                                (while (< k (vecLen effs))
                                  {
                                    (if (strEq (vecGetStr effs k) effIncomplete)
                                      (set partial 1)
                                      (if (strEq (vecGetStr effs k) effByRef)
                                        (set overapprox 1)
                                        (vecPush disp (effRender (vecGetStr effs k)))
                                      )
                                    )
                                    (set k (+ k 1))
                                  })
                                (if (> (vecLen disp) 0)
                                  (vecPush metas (strConcat "effects=" (saJoinComma (saSort disp))))
                                  0
                                )
                                (if (== partial 1)
                                  (vecPush metas "effects-incomplete")
                                  0
                                )
                                ; The opposite admission. `-incomplete`
                                ; says the row is a LOWER bound; this
                                ; says it may be an UPPER one, because
                                ; some of it was contributed by NAMING
                                ; a function rather than calling one.
                                ; Without it a reader sees
                                ; `#effects=IO` on `(fn (handoff k)
                                ; shout)` and believes a body that does
                                ; no IO performs some.
                                (if (== overapprox 1)
                                  (vecPush metas "effects-overapprox")
                                  0
                                )
                              }
                            )
                            0
                          )
                        )
                        ; The edges the effect walk resolved to build
                        ; the row above, opt-in behind `--calls`.
                        ;
                        ; OFF BY DEFAULT, and that is the whole reason
                        ; it is a flag. `tests/tools/symbols-zoo.golden`
                        ; pins 147 rows and `check-tools-selfhost`
                        ; compares them byte for byte, so a key on every
                        ; row would put an edge list into the diff of
                        ; every future stdlib edit - the noise that made
                        ; `ac95e2b` a separate commit. `--builtins` is
                        ; the precedent: content selection on this
                        ; subcommand, not a new axis on the build.
                        ;
                        ; UNFILTERED, deliberately. An operator is a
                        ; `FnEnt` in this language, so `+` and `==` are
                        ; call edges and hiding them would make this key
                        ; disagree with what the checker calls a call.
                        ; `__alloc` is the load-bearing case: it is a
                        ; builtin AND it is what puts `Alloc` in the row
                        ; beside this one, so a graph that dropped
                        ; builtins could not explain its own effect set.
                        ;
                        ; Sorted into a COPY. `saSort` sorts in place,
                        ; and the vec here is the checker's live entry
                        ; word - a renderer that reordered it would be
                        ; mutating analysis state to print it.
                        (let ((cls (memGetWord e 7)))
                          (if (&& (== calls 1) (== isB 0))
                            (let (
                              (cv vecNew)
                              (mut k 0)
                            )
                              {
                                (while (< k (vecLen cls))
                                  {
                                    (vecPush cv (vecGetStr cls k))
                                    (set k (+ k 1))
                                  })
                                (if (> (vecLen cv) 0)
                                  (vecPush metas (strConcat "calls=" (saJoinComma (saSort cv))))
                                  0
                                )
                              }
                            )
                            0
                          )
                        )
                        (let ((eps (memGetWord e 6)))
                          (if (&& (> (vecLen eps) 0) (== isB 0))
                            (let (
                              (params (saGet (memGetWord sm 16) (memGetWord sm 17) name))
                              (pnames vecNew)
                              (mut k 0)
                            )
                              {
                                (while (< k (vecLen eps))
                                  (let ((pi (vecGet eps k)))
                                    {
                                      (vecPush
                                        pnames                                        (if (&& (!= params 0) (< pi (vecLen params)))
                                          (vecGetStr params pi)
                                          (symsDigits pi)
                                        )
                                      )
                                      (set k (+ k 1))
                                    }
                                  ))
                                (vecPush metas (strConcat "effect-params=" (saJoinComma pnames)))
                              }
                            )
                            0
                          )
                        )
                        (let ((opTy (saGet (memGetWord sm 18) (memGetWord sm 19) name)))
                          (vecPush
                            lines                            (symLine
                              "F"                              (bareOf name)                              (if (== (strLen loc) 0)
                                "-"
                                loc
                              )                              (if (&& (== isOp 1) (!= opTy 0))
                                (symTy opTy)
                                (symTy (memGetWord e 1))
                              )                              (smNidFor sm name)                              metas
                            )
                          )
                        )
                      }
                    )
                  )
                  (set i (+ i 1))
                }
              )
            ))
        )
        ; --- data types and their constructors --------------------
        (let (
          (datas (tcDatas tc))
          (mut i 0)
        )
          (while (< i (vecLen datas))
            (let ((d (vecGet datas i)))
              (let (
                (name (memGetWordStr d 0))
                (ctors (memGetWord d 1))
              )
                {
                  (let (
                    (metas vecNew)
                    (cnames vecNew)
                    (mut k 0)
                  )
                    {
                      (while (< k (vecLen ctors))
                        {
                          (vecPush cnames (bareOf (memGetWordStr (vecGet ctors k) 0)))
                          (set k (+ k 1))
                        })
                      ; Author tags first, derived keys after: see
                      ; `smTagMetas`.
                      (smTagMetas sm name metas)
                      (if (> (vecLen cnames) 0)
                        (vecPush metas (strConcat "ctors=" (saJoinComma cnames)))
                        0
                      )
                      (vecPush
                        lines                        (symLine
                          "D"                          (bareOf name)                          (let ((loc (smLocReal
                            sm                            3                            4                            5                            name                            units
                          )))
                            (if (== (strLen loc) 0)
                              "-"
                              loc
                            )
                          )                          (strConcat "data " (bareOf name))                          (smNidFor sm name)                          metas
                        )
                      )
                    }
                  )
                  (let ((mut k 0))
                    (while (< k (vecLen ctors))
                      (let ((c (vecGet ctors k)))
                        {
                          (vecPush
                            lines                            (symLine
                              "C"                              (bareOf (memGetWordStr c 0))                              (let ((loc (smLocReal
                                sm                                9                                10                                11                                (memGetWordStr c 0)                                units
                              )))
                                (if (== (strLen loc) 0)
                                  "-"
                                  loc
                                )
                              )                              (symTy (memGetWord c 3))                              ""                              (let ((m vecNew))
                                {
                                  (vecPush m (strConcat "of=" (bareOf name)))
                                  m
                                }
                              )
                            )
                          )
                          (set k (+ k 1))
                        }
                      ))
                  )
                  (set i (+ i 1))
                }
              )
            ))
        )
        ; --- structs ----------------------------------------------
        (let (
          (sts (tcStructs tc))
          (mut i 0)
        )
          (while (< i (vecLen sts))
            (let ((s (vecGet sts i)))
              (let (
                (name (memGetWordStr s 0))
                (fields (memGetWord s 1))
              )
                {
                  (let (
                    (metas vecNew)
                    (fparts vecNew)
                    (mut k 0)
                  )
                    {
                      (while (< k (vecLen fields))
                        (let ((f (vecGet fields k)))
                          {
                            (vecPush fparts (strConcat (nodeAName f) (strConcat ":" (symTy (nodeTy f)))))
                            (set k (+ k 1))
                          }
                        ))
                      ; Author tags first, derived keys after: see
                      ; `smTagMetas`.
                      (smTagMetas sm name metas)
                      (vecPush metas (strConcat "fields=" (saJoinComma fparts)))
                      (vecPush
                        lines                        (symLine
                          "S"                          (bareOf name)                          (let ((loc (smLocReal
                            sm                            3                            4                            5                            name                            units
                          )))
                            (if (== (strLen loc) 0)
                              "-"
                              loc
                            )
                          )                          (strConcat "struct " (bareOf name))                          (smNidFor sm name)                          metas
                        )
                      )
                    }
                  )
                  (set i (+ i 1))
                }
              )
            ))
        )
        ; --- type aliases -----------------------------------------
        (let (
          (als (tcAliases tc))
          (mut i 0)
        )
          (while (< i (vecLen als))
            (let ((d (vecGet als i)))
              (let ((name (nodeAName d)))
                {
                  ; Author tags first, derived keys after: see
                  ; `smTagMetas`.
                  (let (
                    (metas vecNew)
                    (tvs (nodeC d))
                  )
                    {
                      (smTagMetas sm name metas)
                      (if (&& (!= tvs 0) (> (vecLen tvs) 0))
                        (vecPush metas (strConcat "tyvars=" (saJoinComma tvs)))
                        0
                      )
                      (vecPush
                        lines                        (symLine
                          "A"                          (bareOf name)                          (let ((loc (smLocReal
                            sm                            3                            4                            5                            name                            units
                          )))
                            (if (== (strLen loc) 0)
                              "-"
                              loc
                            )
                          )                          (symTy (nodeB d))                          (smNidFor sm name)                          metas
                        )
                      )
                    }
                  )
                  (set i (+ i 1))
                }
              )
            ))
        )
        ; --- traits -----------------------------------------------
        (let (
          (trs (tcTraits tc))
          (mut i 0)
        )
          (while (< i (vecLen trs))
            (let ((d (vecGet trs i)))
              (let ((name (nodeAName d)))
                {
                  (let (
                    (metas vecNew)
                    (mparts vecNew)
                    (methods (nodeB d))
                    (mut k 0)
                  )
                    {
                      (while (< k (vecLen methods))
                        (let ((m (vecGet methods k)))
                          {
                            (vecPush mparts (strConcat (nodeAName m) (strConcat ":" (symTy (nodeB m)))))
                            (set k (+ k 1))
                          }
                        ))
                      ; Author tags first, derived keys after: see
                      ; `smTagMetas`.
                      (smTagMetas sm name metas)
                      (vecPush metas (strConcat "methods=" (saJoinComma mparts)))
                      (vecPush
                        lines                        (symLine
                          "T"                          (bareOf name)                          (let ((loc (smLocReal
                            sm                            6                            7                            8                            name                            units
                          )))
                            (if (== (strLen loc) 0)
                              "-"
                              loc
                            )
                          )                          (strConcat "trait " (bareOf name))                          (smNidFor sm name)                          metas
                        )
                      )
                    }
                  )
                  (set i (+ i 1))
                }
              )
            ))
        )
        ; --- macros -----------------------------------------------
        ; The name vector collected above IS the list. Every other walk
        ; here iterates a `tc` list and uses `sm` only for the span and
        ; the nid, but the checker keeps no macro list - macros are
        ; consumed by the expander before it runs - so the collection
        ; is the only place they survive.
        ;
        ; A macro has no TYPE. The row says `macro <name>`, the shape
        ; `trait <name>` already uses, and carries its parameter names
        ; as `#params=` so a reader can see the arity a call must
        ; satisfy. Without this row `println`, `format` and `try!` were
        ; public API no gate over this stream could see
        ; (`compat/UNCOVERED`).
        (let (
          (mcs (memGetWord sm 20))
          (mut i 0)
        )
          (while (< i (vecLen mcs))
            (let ((name (vecGetStr mcs i)))
              {
                (let ((metas vecNew))
                  {
                    (smTagMetas sm name metas)
                    (vecPush
                      lines                      (symLine
                        "M"                        (bareOf name)                        (let ((loc (smLocReal
                          sm                          20                          21                          22                          name                          units
                        )))
                          (if (== (strLen loc) 0)
                            "-"
                            loc
                          )
                        )                        (strConcat "macro " (bareOf name))                        (smNidFor sm name)                        metas
                      )
                    )
                  }
                )
                (set i (+ i 1))
              }
            ))
        )
        ; --- effects ----------------------------------------------
        ; The effect's own name. Its OPERATIONS were always keyed - a
        ; handler needs those - but the declaration had no row, so
        ; `Assert` was the last public name outside this stream.
        (let (
          (efs (memGetWord sm 23))
          (mut i 0)
        )
          (while (< i (vecLen efs))
            (let ((name (vecGetStr efs i)))
              {
                (let ((metas vecNew))
                  {
                    (smTagMetas sm name metas)
                    (vecPush
                      lines                      (symLine
                        "E"                        (bareOf name)                        (let ((loc (smLocReal
                          sm                          23                          24                          25                          name                          units
                        )))
                          (if (== (strLen loc) 0)
                            "-"
                            loc
                          )
                        )                        (strConcat "effect " (bareOf name))                        (smNidFor sm name)                        metas
                      )
                    )
                  }
                )
                (set i (+ i 1))
              }
            ))
        )
        ; --- join -------------------------------------------------
        (let (
          (mut total 0)
          (mut i 0)
        )
          {
            (while (< i (vecLen lines))
              {
                (set total (+ total (strLen (vecGetStr lines i))))
                (set i (+ i 1))
              })
            (let (
              (out (strAlloc total))
              (mut j 0)
              (mut off 0)
            )
              {
                (while (< j (vecLen lines))
                  (let ((f (vecGetStr lines j)))
                    {
                      (memCopy (+ (strData out) off) (strData f) (strLen f))
                      (set off (+ off (strLen f)))
                      (set j (+ j 1))
                    }
                  ))
                out
              }
            )
          }
        )
      }
    )
  )
)
