; main.ax — self-hosted Axiom compiler entry point.
;
; Ties together the compiler pipeline: lex → parse → typecheck → codegen.
; Dependencies: core.ax, lexer.ax, parser.ax, typecheck.ax, codegen.ax.

(import core)
(import Mem)
(import Str)
(import Vec)
(import Sys)
(import lexer)
(import parser)
(import typecheck)
(import codegen)

; ------------------------------------------------------------------
; Compile source text, return LLVM IR Str.
; ------------------------------------------------------------------
(pub :: compileString (-> Int Int))
(pub fn (compileString src)
  (let ((tokens (lex src)))
    (let ((pr (parseModule tokens)))
      (if (== (memGetWord pr 0) 0)
          (strFromLit (__addr "; parse error\n"))
          (let ((decls (memGetWord pr 1)))
            (let ((ctx (checkModule decls)))
              (emitModule decls 0)))))))

; ------------------------------------------------------------------
; Write a Str to stdout.
; ------------------------------------------------------------------
(pub :: writeStdout (-> Int Int))
(pub fn (writeStdout s)
  (sysWriteFd 1 (strData s) (strLen s)))

; ------------------------------------------------------------------
; Entry point.
; ------------------------------------------------------------------
(pub :: main Int)
(pub fn (main)
  0)
