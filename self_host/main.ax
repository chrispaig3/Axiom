; main.ax — self-hosted Axiom compiler entry point.

(import core)
(import Mem)
(import Str)
(import Vec)
(import Sys)
(import lexer)
(import parser)
(import typecheck)
(import codegen)

(pub :: writeStdout (-> Int Int))
(pub fn (writeStdout s) (sysWriteFd 1 (strData s) (strLen s)))

(pub :: main Int)
(pub fn (main)
  (let ((src (strFromLit (__addr "(struct Foo (x : Int)) (fn (bar) 42)"))))
    (let ((tokens (lex src)))
      (let ((pr (parseModule tokens)))
        (if (== (memGetWord pr 0) 0)
            (sysWriteFd 2 (strData (strFromLit (__addr "PFAIL\n"))) 6)
            (let ((decls (memGetWord pr 1))
                  (cg (newCG))
                  (c1 (scanDecls decls cg 0))
                  (c2 (emitLine c1 (strFromLit (__addr "HDR1"))))
                  (c3 (emitLine c2 (strFromLit (__addr ""))))
                  (c4 (emitLine c3 (strFromLit (__addr "HDR3"))))
                  (c5 (emitLine c4 (strFromLit (__addr ""))))
                  (c6 (emitModuleTail decls c5 0))
                  (out (renderCG c6)))
              (writeStdout out)
              0))))
    0))
