; main.ax — self-hosted Axiom compiler entry point.

(import core)
(import Mem)
(import Str)
(import Vec)
(import Sys)
(import lexer)
(import parser)
(import typecheck)
(import codegen)

(pub :: writeStdout (-> Int Int))
(pub fn (writeStdout s) (sysWriteFd 1 (strData s) (strLen s)))

(pub :: main Int)
(pub fn (main)
  (let ((src (strFromLit (__addr "(data Maybe (Nothing) (Just a)) (fn (maybeVal x) (if x 42 0))"))))
    (let ((tokens (lex src)))
      (let ((pr (parseModule tokens)))
        (if (== (memGetWord pr 0) 0)
            (sysWriteFd 2 (strData (strFromLit (__addr "PFAIL\n"))) 6)
            (let ((decls (memGetWord pr 1))
                  (out (emitModule decls (strFromLit (__addr "arm64-apple-macosx14.0.0")))))
              (writeStdout out)
              0))))
    0))
