(pub fn (expModuleize made env mod)
  (let ((filter 
    (modFilterFor
      (expMods env)      (cast String mod)
    )
  ))
    (expModuleizeIn
      made      env      mod      filter      0      0
    )
  )
)

(pub :: expModuleizeIn (-> Int Int a Int Int Int Int))

(pub fn (expModuleizeIn made env mod filter i vis0)
  (if (>= i (vecLen made))
    vis0
    (let ((g (vecGet made i)))
      (let ((exported 
        (if (&& (== (nodeVis g) 1) (filterKeeps filter (nodeA g)))
          1
          0
        )
      ))
        {
          (memSetWord g 8 mod)
          (memSetWord g 5 exported)
          ; After the stamps, because it rewrites the name the
          ; filter was asked about.
          (mangleDecl
            g            (cast String mod)            (expBares env)            (expFulls env)            exported
          )
          (expModuleizeIn
            made            env            mod            filter            (+ i 1)            (if (== i 0)
              exported
              vis0
            )
          )
        }
      )
    )
  )
)

