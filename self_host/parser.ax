;; Self-hosted parser stub for Axiom.
;; The parser transforms tokens into an AST.

(import core)
(import lexer)

(:: axiom_parse (-> String String))
(fn (axiom_parse source)
  source)

;; The parser demonstrates a key self-hosting principle:
;; symbolic structure transformation. A flat list of tokens
;; is organized into a tree of declarations and expressions —
;; the AST that all subsequent compiler phases operate on.
