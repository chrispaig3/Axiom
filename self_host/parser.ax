; parser.ax — recursive-descent S-expression parser.
;
; Consumes a Vec of Token handles and produces ASTNodes.
; Dependencies: core.ax, Mem, Str, Vec, lexer.ax.

(import core)
(import Mem)
(import Str)
(import Utf8)
(import Vec)
(import lexer)
(import diag)

; ------------------------------------------------------------------
; AST node: tagged union. tag + a,b,c fields. Unused = 0.
; ------------------------------------------------------------------
; `axtags` is the Vec of `;@axiom:key(value)` tags written directly
; above a DECLARATION, and 0 everywhere else. It is the eighth word so
; that `ty` keeps index 6 and every existing `memGetWord` reader is
; untouched.
; `module` is the module a declaration was SPLICED FROM - 0 for the
; entry file, the module's name otherwise. Stamped by `resolveDecls`,
; which is the only place that knows it, and the ninth word for the
; same reason `axtags` was the eighth: every existing reader indexes
; by position. Without it the merged declaration list cannot say
; which module defined what, which is what AX3014 has to answer.
; `fieldNames` is a constructor's declared field names when it was
; written as a STRUCT VARIANT - `(Rect { w : Int, h : Int })` - and 0
; for a positional one. Tenth word for the same reason `axtags` was
; eighth and `module` ninth: every existing reader indexes by
; position, so appending is the only change that is free.
(pub struct ASTNode (tag : Int) (a : Int) (b : Int) (c : Int) (span : Int) (vis : Int) (ty : Int) (axtags : Int) (module : Int) (fieldNames : Int))

; A declaration's visibility: 1 when it was written `pub`, 0 otherwise.
; stage0 splices only the PUBLIC declarations of an imported module
; into the program; stage1 spliced all of them, so a reference to a
; private imported name compiled here and was AX3001 there.
(pub :: nodeVis (-> Int Int))   (pub fn (nodeVis n) (memGetWord n 5))
(pub :: nodeAxtags (-> Int Int)) (pub fn (nodeAxtags n) (memGetWord n 7))
(pub :: setNodeSpan (-> Int Int Int))
(pub fn (setNodeSpan n sp) { (memSetWord n 4 sp) n })
(pub :: markPub (-> Int Int))
(pub fn (markPub n) { (if (== n 0) 0 (memSetWord n 5 1)) n })

; A declaration's parsed TYPE, or 0 when none was kept. Word 6 is new
; and additive: every existing consumer reads words 0-5 by index, so
; nothing moves. What lives here varies by tag - a type node for
; TAG_D_SIG/TAG_D_FOREIGN/TAG_FIELD, a Vec of field type nodes for
; TAG_CTOR, a Vec of tyvar name Strs for TAG_D_DATA.
(pub :: nodeTy (-> Int Int))    (pub fn (nodeTy n) (memGetWord n 6))
(pub :: setNodeTy (-> Int Int Int))
(pub fn (setNodeTy n t) { (memSetWord n 6 t) n })

; Node tags.
(pub :: TAG_NIL Int)       (pub fn (TAG_NIL) 0)
(pub :: TAG_E_INT Int)     (pub fn (TAG_E_INT) 1)
(pub :: TAG_E_STR Int)     (pub fn (TAG_E_STR) 2)
(pub :: TAG_E_VAR Int)     (pub fn (TAG_E_VAR) 3)
(pub :: TAG_E_APP Int)     (pub fn (TAG_E_APP) 4)
(pub :: TAG_E_LAM Int)     (pub fn (TAG_E_LAM) 5)
(pub :: TAG_E_LET Int)     (pub fn (TAG_E_LET) 6)
(pub :: TAG_E_IF Int)      (pub fn (TAG_E_IF) 7)
(pub :: TAG_E_BEGIN Int)   (pub fn (TAG_E_BEGIN) 8)
(pub :: TAG_E_QUOTE Int)   (pub fn (TAG_E_QUOTE) 9)
(pub :: TAG_E_MATCH Int)   (pub fn (TAG_E_MATCH) 16)
; One arm of a `match`: word 1 is the pattern, word 2 the body.
(pub :: TAG_M_ARM Int)     (pub fn (TAG_M_ARM) 17)
(pub :: TAG_D_FN Int)      (pub fn (TAG_D_FN) 10)
(pub :: TAG_D_SIG Int)     (pub fn (TAG_D_SIG) 11)
(pub :: TAG_D_DATA Int)    (pub fn (TAG_D_DATA) 12)
(pub :: TAG_D_STRUCT Int)  (pub fn (TAG_D_STRUCT) 13)
(pub :: TAG_D_IMPORT Int)  (pub fn (TAG_D_IMPORT) 14)
(pub :: TAG_D_MACRO Int)   (pub fn (TAG_D_MACRO) 15)
(pub :: TAG_CTOR Int)     (pub fn (TAG_CTOR) 20)
(pub :: TAG_FIELD Int)    (pub fn (TAG_FIELD) 21)
; A float literal: word 1 holds the IEEE-754 bit pattern of the value,
; which *is* the value - a float is carried as the i64 of its bits
; everywhere, so the emitter prints word 1 as a plain integer constant.
(pub :: TAG_E_FLT Int)    (pub fn (TAG_E_FLT) 22)
; A parenthesised nullary-constructor pattern, `(Nil)`. The parens are
; what distinguish it from a binder - stage0 parses a BARE identifier
; in pattern position as a binder even when it names a constructor -
; and expression parsing erases parens, so the shape is marked before
; the erasure. Word 1 is the constructor's name.
(pub :: TAG_P_CON0 Int)   (pub fn (TAG_P_CON0) 23)
; A mutable binding: like TAG_E_LET, but the name gets storage - an
; alloca written by `set` and read by a load at every use - rather
; than a value register.
(pub :: TAG_E_LETM Int)   (pub fn (TAG_E_LETM) 24)
; (set name value): word 1 the name, word 2 the value expression.
(pub :: TAG_E_SET Int)    (pub fn (TAG_E_SET) 25)
; (while cond body...): word 1 the condition, word 2 the body Vec.
(pub :: TAG_E_WHILE Int)  (pub fn (TAG_E_WHILE) 26)
; Field access `base.field`: word 1 the base expression, word 2 the
; field's name. Chains fold left: `a.b.c` is ((a.b).c).
(pub :: TAG_E_FIELD Int)  (pub fn (TAG_E_FIELD) 27)
; Field store `(set base.field v)`: word 1 the base expression, word 2
; the field's name, word 3 the value. Evaluates to 0, stage0's rule.
(pub :: TAG_E_SETF Int)   (pub fn (TAG_E_SETF) 28)
; A `foreign` binding. stage1 emits nothing for one - the compiler is
; freestanding and `emitDecl` ignores every tag but TAG_D_FN - but the
; *name* has to survive parsing, because stage0 counts a foreign
; binding as a definition when it checks whether a signature has one
; behind it. Skipping the form outright made `(:: putchar ...)` beside
; `(foreign putchar ...)` look like a signature with nothing behind
; it, and stage1 rejected a program stage0 compiles.
(pub :: TAG_D_FOREIGN Int) (pub fn (TAG_D_FOREIGN) 29)
; An `(effect Name (op :: sig) ...)` declaration. stage1 lowers no
; part of the effect system, but the NAMES have to survive parsing:
; the effect's own name appears in a `handle` list and each operation
; is a callable, so a checker that never saw them reports every one as
; an undefined variable - which it did, on programs stage0 compiles
; without a word. Word 1 is the effect's name, word 2 a Vec of its
; operation names.
(pub :: TAG_D_EFFECT Int)  (pub fn (TAG_D_EFFECT) 30)
; `type` and `trait` declarations, retained for `symbols`. Until the
; port they were consumed by skipUnknownDecl into TAG_NIL - stage1
; emits no code for either, and every downstream tag dispatch
; else-skips, so carrying them is free. ALIAS: a=name, b=target type
; node, c=tyvars (Vec of Str), span=name token. TRAIT: a=name, b=Vec
; of TAG_FIELD method nodes (a=method name, b=type node), span=name
; token. A malformed spelling falls back to skipUnknownDecl, which is
; byte-for-byte the old behaviour.
(pub :: TAG_D_ALIAS Int)   (pub fn (TAG_D_ALIAS) 47)
(pub :: TAG_D_TRAIT Int)   (pub fn (TAG_D_TRAIT) 48)
; A `cond` form, kept structural rather than desugared at parse time:
; stage0's checker treats `cond` unlike nested `if` (clause bodies are
; never joined against each other; only a real `else` is compared, and
; only against the LAST clause - probed), so a checker over the
; desugared tree over-reports. Word 1 is a Vec of clause nodes
; (TAG_M_ARM: a=test, b=body), word 2 the else body or 0 for none.
; Codegen lowers this to the same nested-if chain the parser used to
; build, in a pre-pass that runs before TCO analysis.
(pub :: TAG_E_COND Int)    (pub fn (TAG_E_COND) 31)
; Type expression nodes, produced by parseType. The type checker is
; the only consumer; codegen never reads them.
(pub :: TAG_T_VAR Int)     (pub fn (TAG_T_VAR) 32)   ; a=name
(pub :: TAG_T_CON Int)     (pub fn (TAG_T_CON) 33)   ; a=name, b=Vec args
(pub :: TAG_T_ARR Int)     (pub fn (TAG_T_ARR) 34)   ; a=param, b=result
(pub :: TAG_T_TUP Int)     (pub fn (TAG_T_TUP) 35)   ; a=Vec; empty = unit
(pub :: TAG_T_LIST Int)    (pub fn (TAG_T_LIST) 36)  ; a=inner
(pub :: TAG_T_PTR Int)     (pub fn (TAG_T_PTR) 37)   ; a=inner, b=mut
(pub :: TAG_T_ERR Int)     (pub fn (TAG_T_ERR) 38)   ; poison, no payload
; A character literal. It used to collapse into TAG_E_INT, but stage0
; types a char literal `Char`, not `Int`, and `Char` has no
; compatibility fiat with `Int` - `(charToStr 'q')` against
; `(-> Char Int)` is silent under stage0 and would be a false AX3004
; if the literal arrived typed `Int`. Codegen emits it exactly as an
; integer (word 1 is the codepoint), so representation is unchanged.
(pub :: TAG_E_CHAR Int)    (pub fn (TAG_E_CHAR) 39)
; `(struct Name field...)` in EXPRESSION position - stage0's
; parse_struct_con, a construction form distinct from the application
; spelling `(Name field...)`. Without it the form parsed as an
; application of a variable named `struct`, and a VALID program drew
; two false AX3001s (one for `struct`, one for the type name), which
; is the failure the whole checker is written to avoid. a=name,
; b=Vec of argument nodes; the span is the NAME's, which is where
; stage0 anchors every diagnostic about the form.
(pub :: TAG_E_STRUCTCON Int) (pub fn (TAG_E_STRUCTCON) 40)
; `(alloc Type [count])`. stage0 types this `*mut Type` and its IR
; generator has NO case for it, so it falls to the generator's
; catch-all and emits the constant 0 - verified by running a
; stage0-built binary. stage1 reproduces both halves: the pointer
; type, and the zero. a=type node, b=count node (0 when absent).
(pub :: TAG_E_ALLOC Int)   (pub fn (TAG_E_ALLOC) 41)
; `(handle body (Effect...) handler)`. Parsed as an application until
; now, which had two costs: an unknown effect name drew AX3001
; `undefined variable` where stage0 says AX3016 `unknown effect`, and
; emission produced `call i64 @Console(i64 %IO, i64 %Alloc)` - a call
; to a symbol nothing defines, which llc rejects. a=body, b=Vec of
; TAG_E_VAR nodes naming the handled effects (each carrying its own
; span, which is where AX3016 and AX3017 anchor), c=handler.
(pub :: TAG_E_HANDLE Int)  (pub fn (TAG_E_HANDLE) 42)
; A NAMED constructor pattern: `(Rect { h = h, w = w })`. a=constructor
; name, b=Vec of field-name nodes (TAG_E_VAR, so each carries its own
; span - AX3007 anchors at the field name), c=Vec of sub-patterns,
; positionally aligned with b. The span is the constructor's.
;
; It is NOT desugared at parse time, because the declaration that says
; what order the fields are in may not have been seen yet. Both the
; checker and the emitter reorder it against the constructor's
; recorded field names, which is where stage0 does it too.
(pub :: TAG_P_CONNAMED Int) (pub fn (TAG_P_CONNAMED) 43)

(pub :: nodeTag (-> Int Int))   (pub fn (nodeTag n) (memGetWord n 0))
(pub :: nodeA   (-> Int Int))   (pub fn (nodeA   n) (memGetWord n 1))
(pub :: nodeB   (-> Int Int))   (pub fn (nodeB   n) (memGetWord n 2))
(pub :: nodeC   (-> Int Int))   (pub fn (nodeC   n) (memGetWord n 3))

(pub :: mkNode (-> Int Int Int Int Int))  (pub fn (mkNode t a b c) (ASTNode t a b c 0 0 0 0 0 0))
(pub :: mkNodeAt (-> Int Int Int Int Int Int))
(pub fn (mkNodeAt t a b c sp) (ASTNode t a b c sp 0 0 0 0 0))
(pub :: nodeSpan (-> Int Int))  (pub fn (nodeSpan n) (memGetWord n 4))
(pub :: nodeModule (-> Int Int)) (pub fn (nodeModule n) (memGetWord n 8))
(pub :: nodeFieldNames (-> Int Int)) (pub fn (nodeFieldNames n) (memGetWord n 9))
(pub :: mkEInt (-> Int Int))              (pub fn (mkEInt v)     (mkNode TAG_E_INT v 0 0))
(pub :: mkEFlt (-> Int Int))              (pub fn (mkEFlt bits)  (mkNode TAG_E_FLT bits 0 0))
(pub :: mkEStr (-> Int Int))              (pub fn (mkEStr s)     (mkNode TAG_E_STR s 0 0))
(pub :: mkEVar (-> Int Int))              (pub fn (mkEVar n)     (mkNode TAG_E_VAR n 0 0))
; Type-node constructors. parseType builds these; only the checker
; reads them.
(pub :: mkTVar (-> Int Int))   (pub fn (mkTVar n)     (mkNode TAG_T_VAR n 0 0))
(pub :: mkTCon (-> Int Int Int)) (pub fn (mkTCon n args) (mkNode TAG_T_CON n args 0))
(pub :: mkTArr (-> Int Int Int)) (pub fn (mkTArr p r)   (mkNode TAG_T_ARR p r 0))
(pub :: mkTTup (-> Int Int))   (pub fn (mkTTup xs)    (mkNode TAG_T_TUP xs 0 0))
(pub :: mkTPtr (-> Int Int Int)) (pub fn (mkTPtr inner m) (mkNode TAG_T_PTR inner m 0))
(pub :: mkTErr Int)            (pub fn (mkTErr)       (mkNode TAG_T_ERR 0 0 0))
; An application's span is its FUNCTION's span, not the open paren's -
; stage0's `Expr::span()` recurses to the head for `EApp`, so a
; diagnostic about `(f 1)` points at `f`. Copying the child's span at
; construction is exactly equivalent to that recursion and costs one
; word instead of a walk.
(pub :: mkEApp (-> Int Int Int))
(pub fn (mkEApp f x)   (mkNodeAt TAG_E_APP f x 0 (nodeSpan f)))
(pub :: mkEVarAt (-> Int Int Int))
(pub fn (mkEVarAt n sp) (mkNodeAt TAG_E_VAR n 0 0 sp))
(pub :: mkELam (-> Int Int Int))          (pub fn (mkELam p b)   (mkNode TAG_E_LAM p b 0))
; A `let` node's span is its BINDER's - the token the name came from.
; stage0's `Expr::span()` answers the body's span for a `let`, but
; nothing in stage1 asks that question; what its diagnostics need is
; where the binding was introduced, which is where AX3012's secondary
; and its `mut` fix point.
(pub :: mkELet (-> Int Int Int Int))      (pub fn (mkELet n v b) (mkNode TAG_E_LET n v b))
(pub :: mkELetAt (-> Int Int Int Int Int))
(pub fn (mkELetAt n v b sp) (mkNodeAt TAG_E_LET n v b sp))
(pub :: mkEIf  (-> Int Int Int Int))      (pub fn (mkEIf  t c a) (mkNode TAG_E_IF  t c a))
(pub :: mkEBegin (-> Int Int))            (pub fn (mkEBegin xs)  (mkNode TAG_E_BEGIN xs 0 0))
(pub :: mkDFn   (-> Int Int Int Int))     (pub fn (mkDFn n p b)  (mkNode TAG_D_FN n p b))
(pub :: mkDSig  (-> Int Int Int))         (pub fn (mkDSig n t)   (mkNode TAG_D_SIG n t 0))
; Span-carrying variants. A diagnostic about a declaration points at
; its *name*, so the name token's span is the one worth keeping - and
; the only one this slice's checks ever report. Everything else keeps
; span 0, which no consumer reads.
(pub :: mkDFnAt  (-> Int Int Int Int Int))
(pub fn (mkDFnAt n p b sp)  (mkNodeAt TAG_D_FN n p b sp))
(pub :: mkDSigAt (-> Int Int Int Int))
(pub fn (mkDSigAt n t sp)   (mkNodeAt TAG_D_SIG n t 0 sp))
(pub :: mkDImport (-> Int Int Int))       (pub fn (mkDImport m ns) (mkNode TAG_D_IMPORT m ns 0))
(pub :: mkDData (-> Int Int Int))         (pub fn (mkDData n cs)   (mkNode TAG_D_DATA n cs 0))
(pub :: mkDStruct (-> Int Int Int))        (pub fn (mkDStruct n fs) (mkNode TAG_D_STRUCT n fs 0))
(pub :: mkDDataAt (-> Int Int Int Int))
(pub fn (mkDDataAt n cs sp)   (mkNodeAt TAG_D_DATA n cs 0 sp))
(pub :: mkDStructAt (-> Int Int Int Int))
(pub fn (mkDStructAt n fs sp) (mkNodeAt TAG_D_STRUCT n fs 0 sp))
(pub :: mkDMacro (-> Int Int Int Int))     (pub fn (mkDMacro n ps b) (mkNode TAG_D_MACRO n ps b))
(pub :: mkCtor (-> Int Int Int Int))       (pub fn (mkCtor n a fl) (mkNode TAG_CTOR n a fl))
(pub :: mkField (-> Int Int Int))          (pub fn (mkField n t)   (mkNode TAG_FIELD n t 0))

; ------------------------------------------------------------------
; Parse result.
; ------------------------------------------------------------------
; `exp` is what the parser WANTED at `pos`, as the noun stage0 puts in
; its message - "identifier", "expression", "pattern". It is the whole
; diagnostic payload, because stage0's AX2001 is mechanically derived
; from that one string:
;
;   E AX2001 f.ax:3:4-5 unexpected-token "expected identifier, found `)`"
;                                        ?"Axiom expected identifier at this position"
;
; and the code and span are derivable from `pos` alone - past the last
; token is AX2002, otherwise the found token's own span. So a site
; teaches the diagnostic everything it needs by naming its expectation,
; and a site that has not been taught yet answers `""`, which reports
; AX2003 rather than inventing an expectation it does not have.
(pub struct PResult (ok : Int) (value : Int) (pos : Int) (exp : Int)
                    (code : Int))

(pub :: pOk (-> Int Int Int))     (pub fn (pOk v p) (PResult 1 v p "" ""))
(pub :: pErr (-> Int Int))        (pub fn (pErr p)   (PResult 0 0 p "" ""))
(pub :: pErrExp (-> Int Int Int)) (pub fn (pErrExp p e) (PResult 0 0 p e ""))
(pub :: pResExp (-> Int Int))     (pub fn (pResExp r) (memGetWord r 3))
(pub :: pResCode (-> Int Int))    (pub fn (pResCode r) (memGetWord r 4))

; A keyword that USED to be Axiom. The point of keeping `union` and
; `region` reserved is that old source gets an explanation instead of
; being silently reinterpreted as an ordinary identifier, so the
; explanation is the diagnostic and `exp` carries the keyword.
(pub :: pErrRemoved (-> Int Int Int))
(pub fn (pErrRemoved p kw) (PResult 0 0 p kw "AX2004"))

; The diagnostic for a failed parse, from the failure's token position.
;
; Before this, a parse failure was a bare `parse failed` on stderr and
; exit 2, against stage0's coded, spanned diagnostic and exit 1 - so
; every tool built on this frontend inherited it, and the language
; server published one spanless error at the top of the file for a
; typo anywhere in it.
;
; Three codes, chosen the way stage0 chooses them:
;
;   AX2002  the position is past the last token - the file ended while
;           a form was still open. Zero-width span at end of source,
;           which is what stage0's caret sits on.
;   AX2001  a token is there and the site said what it wanted. The
;           message and the help both come from that one noun.
;   AX2003  a token is there and the site has not been taught its
;           expectation yet. Reported as a plain syntax error rather
;           than as an AX2001 with an empty noun in it: an honest
;           weaker code beats a well-formed lie, and it shrinks as
;           sites are taught.
(pub :: parseErrDiag (-> Int Int Int Int))
(pub fn (parseErrDiag tokens r src)
  (let ((pos (memGetWord r 2))
        (exp (pResExp r)))
    ; AX2002 is NOT "the position is at EOF" - stage0 emits it from
    ; exactly one routine, the one that demands a SPECIFIC token kind
    ; (`expect(RParen)` and friends), and reports AX2001 with a found
    ; text of `EOF` from every site that wanted a CATEGORY. So the
    ; distinction is already carried here: a site that named its
    ; expectation gets AX2001 wherever it failed, and a site that did
    ; not is the specific-token case, which at EOF is AX2002.
    (if (&& (== (strLen exp) 0)
            (|| (>= pos (vecLen tokens))
                (== (kindInt (tokenKind (vecGet tokens pos))) (kindInt TK_EOF))))
        (mkDiag SEV_ERROR "AX2002" "unexpected-eof"
                (mkSpan (strLen src) (strLen src))
                "unexpected end of file" 0 ""
                (strConcat "count `(`/`[`/`{` against `)`/`]`/`}` "
                           "working backward from the end of the file"))
        (let ((tok (vecGet tokens pos)))
          (if (strEq (pResCode r) "AX2004")
              (mkDiag SEV_ERROR "AX2004" "removed-construct"
                      (tokenSpan tok)
                      (strConcat (strConcat "`" exp) "` is no longer part of Axiom")
                      0 "" (removedHelp exp))
          (if (== (strLen exp) 0)
              (mkDiag SEV_ERROR "AX2003" "syntax-error"
                      (tokenSpan tok) "syntax error" 0 "" 0)
              (mkDiag SEV_ERROR "AX2001" "unexpected-token"
                      (tokenSpan tok)
                      (strConcat (strConcat "expected " exp)
                                 (strConcat ", found `"
                                            (strConcat (foundText tok) "`")))
                      0 ""
                      (strConcat (strConcat "Axiom expected " exp)
                                 " at this position"))))))))

; The EOF token has no lexeme; stage0 spells it `EOF` in the message.
(pub :: foundText (-> Int Int))
(pub fn (foundText tok)
  (if (== (kindInt (tokenKind tok)) (kindInt TK_EOF))
      "EOF"
      (tokenLexeme tok)))

; stage0's advice for each removed keyword, verbatim: this is the one
; place the two compilers' text has to agree exactly, since the whole
; construct exists to be read by a person porting old source.
(pub :: removedHelp (-> Int Int))
(pub fn (removedHelp kw)
  (if (strEq kw "union")
      (strConcat "use `data` for a tagged sum whose variants the compiler can check "
                 "for exhaustiveness, or `struct` for a product of fields")
      (strConcat "delete the `region` wrapper and keep its body; values are dropped "
                 "deterministically at the end of the arena they belong to")))

; ------------------------------------------------------------------
; Token helpers.
; ------------------------------------------------------------------
(pub :: kindInt (-> TokenKind Int))
(pub fn (kindInt k) (cast Int k))

(pub :: peekToken (-> Int Int Int))
(pub fn (peekToken tokens pos)
  (if (>= pos (vecLen tokens)) 0 (vecGet tokens pos)))

(pub :: peekIs (-> Int Int TokenKind Bool))
(pub fn (peekIs tokens pos kind)
  (let ((t (peekToken tokens pos)))
    (if (== t 0)
        (== (kindInt TK_EOF) (kindInt kind))
        (== (kindInt (tokenKind t)) (kindInt kind)))))

(pub :: advance (-> Int Int)) (pub fn (advance p) (+ p 1))

; ------------------------------------------------------------------
; Skip to matching close-paren. depth starts at 1.
; ------------------------------------------------------------------
(pub :: skipParens (-> Int Int Int Int))
(pub fn (skipParens tokens pos depth)
  (if (>= pos (vecLen tokens)) (pErr pos)
  (if (peekIs tokens pos TK_RPAREN)
      (if (== depth 1) (pOk 0 (advance pos))
          (skipParens tokens (advance pos) (- depth 1)))
  (if (peekIs tokens pos TK_LPAREN)
      (skipParens tokens (advance pos) (+ depth 1))
  (skipParens tokens (advance pos) depth)))))

; ------------------------------------------------------------------
; Parse literals.
; ------------------------------------------------------------------
(pub :: parseLit (-> Int Int Int))
(pub fn (parseLit tokens pos)
  ; Literals carry their token's span now: an AX3004 about an argument
  ; or an if-join anchors at the literal in stage0, and a span the
  ; checker does not have is a diagnostic it must suppress.
  (if (peekIs tokens pos TK_INT)
      (let ((t (vecGet tokens pos)))
        (pOk (mkNodeAt TAG_E_INT (strToInt (tokenLexeme t)) 0 0 (tokenSpan t))
             (advance pos)))
  (if (peekIs tokens pos TK_FLOAT)
      (let ((t (vecGet tokens pos)))
        (pOk (mkNodeAt TAG_E_FLT (floatLexemeBits (tokenLexeme t)) 0 0 (tokenSpan t))
             (advance pos)))
  (if (peekIs tokens pos TK_CHARLIT)
      ; A char is its codepoint word at runtime, but its TYPE is Char,
      ; so it keeps its own tag; codegen emits it as the integer it is.
      (let ((t (vecGet tokens pos)))
        (pOk (mkNodeAt TAG_E_CHAR (charLexemeCode (tokenLexeme t)) 0 0 (tokenSpan t))
             (advance pos)))
  (if (peekIs tokens pos TK_STRING)
      (let ((t (vecGet tokens pos)))
        (pOk (mkNodeAt TAG_E_STR (tokenLexeme t) 0 0 (tokenSpan t))
             (advance pos)))
  (pErr pos))))))

; The code point a char lexeme denotes; the lexeme includes its
; quotes. A code point, not a byte: `'é'` is 233 and `'世'` 19990 in
; stage0, and reading one byte answered 195 and 228 - the lead bytes
; of their encodings.
; Escapes are stage0's set: \n \t \r \0, and \\ \' \" denote
; themselves - as does any other escaped byte here, where stage0
; instead reports an error this parser has no channel for.
(pub :: charLexemeCode (-> Int Int))
(pub fn (charLexemeCode lex)
  (if (== (strByte lex 1) 92)
      (let ((e (strByte lex 2)))
        (if (== e 110) 10
        (if (== e 116) 9
        (if (== e 114) 13
        (if (== e 48) 0
        e)))))
      (utf8DecodeAt lex 1)))

; The IEEE-754 bits of the value a float lexeme denotes, computed as
; intPart + fracPart / 10^digits with the compiler's own float
; arithmetic - this compiler is itself an Axiom program, so `1.5` can be
; evaluated with the same `fadd`/`fdiv` the program being compiled will
; use. `cast` reinterprets rather than converts, which is what makes the
; result the bit pattern.
;
; The two operations round separately, where stage0's strtod rounds
; once, so a literal with more precision than a double carries could
; differ from stage0's in the last ulp. Every literal in the current
; corpus (`0.0`, `0.5`, `10.0`, ...) is exactly representable, so the
; results agree today; byte-identical emission for arbitrary literals
; (phase 4) needs a single-rounding conversion here.
(pub :: floatLexemeBits (-> Int Int))
(pub fn (floatLexemeBits lex)
  ; A negative literal negates the whole magnitude - summing a negative
  ; integer part with a positive fraction would be off by twice the
  ; fraction.
  (if (== (strByte lex 0) 45)
      (cast Int (- 0.0 (cast Float (floatMagBits lex 1))))
      (floatMagBits lex 0)))

(pub :: floatMagBits (-> Int Int Int))
(pub fn (floatMagBits lex start)
  (let ((dot (floatDotIndex lex 0)))
    (let ((ip (strToIntFrom lex start 0))
          (fp (strToIntFrom lex (+ dot 1) 0))
          (p10 (powTenAt lex (+ dot 1) 1)))
      (cast Int (+ (__intToFloat ip)
                   (/ (__intToFloat fp) (__intToFloat p10)))))))

; Index of the `.` - the lexer guarantees exactly one, with digits on
; both sides.
(pub :: floatDotIndex (-> Int Int Int))
(pub fn (floatDotIndex lex i)
  (if (>= i (strLen lex))
      i
      (if (== (strByte lex i) 46)
          i
          (floatDotIndex lex (+ i 1)))))

; 10^(number of digits from `i` to the end of `lex`). A `_` separator
; is part of the lexeme but not a digit, so it must not scale the
; denominator - `1.5_0` has two fractional digits, not three.
(pub :: powTenAt (-> Int Int Int Int))
(pub fn (powTenAt lex i acc)
  (if (>= i (strLen lex))
      acc
      (powTenAt lex (+ i 1)
                (if (== (strByte lex i) 95) acc (* acc 10)))))

(pub :: parseIdentRef (-> Int Int Int))
; A dotted chain of identifiers is either FIELD ACCESS (`p.x.y`) or a
; MODULE PATH (`Sys.Platform::sysRead`), and which one is only known at
; the end: `::` makes it a module path. So the chain is collected
; first and the decision taken after - stage0's rule, and it records
; having got this wrong in the other order, where committing to a
; field access as each dot was consumed left the `::` unconsumed and
; reported "expected expression, found `::`" for exactly the dotted
; module names `import Sys.Platform` creates.
;
; A qualified reference needs no node of its own. The path joined by
; `.`, then `$`, then the name IS the mangled symbol every imported
; declaration already carries - `Mem::memAlloc` is `Mem$memAlloc`,
; which is what `mangleDecl` wrote and what the checker and emitter
; both look up. So it resolves to an ordinary variable reference with
; the mangled name, and nothing downstream needs to know.
(pub fn (parseIdentRef tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        (let ((chain (let ((v vecNew))
                       { (vecPush v (tokenLexeme t)) v })))
          (let ((afterChain (parseDottedChain tokens (advance pos) chain)))
            (if (peekIs tokens afterChain TK_DOUBLE_COLON)
                (parseQualifiedTail tokens afterChain chain (tokenSpan t))
                (parseFieldChain tokens (advance pos)
                                 (mkEVarAt (tokenLexeme t) (tokenSpan t)))))))
  (pErrExp pos "expression")))

; Consume `.ident` runs, recording the segments, and answer the
; position after them. Used only to LOOK AHEAD for a `::`; when there
; is none the caller re-parses from the start as a field chain, which
; costs one extra pass over a handful of tokens and keeps the field
; path exactly as it was.
(pub :: parseDottedChain (-> Int Int Int Int))
(pub fn (parseDottedChain tokens pos acc)
  (if (&& (peekIs tokens pos TK_DOT)
          (peekIs tokens (advance pos) TK_IDENT))
      {
        (vecPush acc (tokenLexeme (vecGet tokens (advance pos))))
        (parseDottedChain tokens (advance (advance pos)) acc)
      }
      pos))

; At the `::`. Every further `::ident` extends the path; the LAST
; segment is the name and the rest are the module.
(pub :: parseQualifiedTail (-> Int Int Int Int Int))
(pub fn (parseQualifiedTail tokens pos chain sp)
  (if (peekIs tokens pos TK_DOUBLE_COLON)
      (if (peekIs tokens (advance pos) TK_IDENT)
          {
            (vecPush chain (tokenLexeme (vecGet tokens (advance pos))))
            (parseQualifiedTail tokens (advance (advance pos)) chain sp)
          }
          (pErr pos))
      (pOk (mkEVarAt (mangledFromChain chain) sp) pos)))

; `[A B name]` -> `A.B$name`: the module segments joined by `.`, then
; `$`, then the name. That is the spelling `mangleDecl` gives an
; imported declaration, so the reference and the definition meet.
(pub :: mangledFromChain (-> Int Int))
(pub fn (mangledFromChain chain)
  (strConcat (strConcat (joinDotted chain 0 "") "$")
             (vecGet chain (- (vecLen chain) 1))))

(pub :: joinDotted (-> Int Int Int Int))
(pub fn (joinDotted chain i acc)
  (if (>= i (- (vecLen chain) 1))
      acc
      (joinDotted chain (+ i 1)
        (if (== i 0)
            (vecGet chain 0)
            (strConcat (strConcat acc ".") (vecGet chain i))))))

; `.field` suffixes make field accesses, folded left so `a.b.c` reads
; the `c` of the value at `a.b`. Dotted module paths never reach here -
; imports parse through parseModPath.
(pub :: parseFieldChain (-> Int Int Int Int))
(pub fn (parseFieldChain tokens pos base)
  ; The node's span is the FIELD NAME token's - AX3007's anchor. An
  ; expression-position anchor for the whole access is the BASE's span
  ; (stage0's EField.span() recurses to the base), which the checker
  ; computes by walking, not by reading this slot.
  (if (&& (peekIs tokens pos TK_DOT)
          (peekIs tokens (advance pos) TK_IDENT))
      (parseFieldChain tokens (advance (advance pos))
        (mkNodeAt TAG_E_FIELD base
                  (tokenLexeme (vecGet tokens (advance pos))) 0
                  (tokenSpan (vecGet tokens (advance pos)))))
      (pOk base pos)))

; ------------------------------------------------------------------
; Parse an identifier token, returning the lexeme Str handle.
; ------------------------------------------------------------------
(pub :: parseIdentName (-> Int Int Int))
(pub fn (parseIdentName tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        (pOk (tokenLexeme t) (advance pos)))
  (pErrExp pos "identifier")))

; ------------------------------------------------------------------
; Parse a list of identifiers until ), returning a Vec of Str handles.
; ------------------------------------------------------------------
(pub :: parseIdentList (-> Int Int Int Int))
(pub fn (parseIdentList tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        (parseIdentList tokens (advance pos)
          (vecPush acc (tokenLexeme t))))
  (pErrExp pos "identifier"))))

; ------------------------------------------------------------------
; Parse an expression list until ), returning a Vec of Expr handles.
; ------------------------------------------------------------------
(pub :: parseExprList (-> Int Int Int Int))
(pub fn (parseExprList tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_EOF)
      ; At EOF the two compilers want different things, and stage0 is
      ; right about which: with nothing parsed yet the list is still
      ; waiting for its first EXPRESSION (AX2001, found `EOF`), but
      ; once one has been parsed the only thing that can legally come
      ; next is the closing paren - a specific token, which is the one
      ; routine stage0 reports AX2002 from. Probed both ways:
      ; `(fn (main)` gives "expected expression, found `EOF`" and
      ; `(fn (main) (+ 1 2)` gives "unexpected end of file".
      (if (== (vecLen acc) 0)
          (pErrExp pos "expression")
          (pErr pos))
      (let ((r (parseExpr tokens pos)))
        (if (== (memGetWord r 0) 0)
            r
            (parseExprList tokens (memGetWord r 2)
              (vecPush acc (memGetWord r 1))))))))

; ------------------------------------------------------------------
; Keyword string literals for comparison.
; ------------------------------------------------------------------
(pub :: kwFn    Int) (pub fn (kwFn)    "fn")
; stage0 parses `define` and `fn` through the same function, and the
; reference documents both. Without this a `(define (f x) ...)` became
; an inert TAG_NIL node, so the checker saw a signature with no
; definition behind it and reported AX3015 on a valid program.
(pub :: kwDefine Int) (pub fn (kwDefine) "define")
(pub :: kwForeign Int) (pub fn (kwForeign) "foreign")
(pub :: kwEffect Int) (pub fn (kwEffect) "effect")
(pub :: kwData  Int) (pub fn (kwData)  "data")
(pub :: kwStruct Int)(pub fn (kwStruct)"struct")
(pub :: kwLet   Int) (pub fn (kwLet)   "let")
(pub :: kwIf    Int) (pub fn (kwIf)    "if")
(pub :: kwMatch Int) (pub fn (kwMatch) "match")
(pub :: kwImport Int)(pub fn (kwImport)"import")
(pub :: kwMacro Int) (pub fn (kwMacro) "macro")
(pub :: kwPub   Int) (pub fn (kwPub)   "pub")
(pub :: kwCond  Int) (pub fn (kwCond)  "cond")
(pub :: kwElse  Int) (pub fn (kwElse)  "else")

(pub :: kwEq (-> Int Int Bool))
(pub fn (kwEq name lit)
  (strEq name lit))

; ------------------------------------------------------------------
; Top-level declaration parse: (keyword ...)
; ------------------------------------------------------------------
(pub :: parseDecl (-> Int Int Int))
(pub fn (parseDecl tokens pos)
  (if (peekIs tokens pos TK_EOF)
      (pOk 0 pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseTopForm tokens (advance pos))
  (pErrExp pos "("))))

(pub :: parseTopForm (-> Int Int Int))
(pub fn (parseTopForm tokens pos)
  (if (peekIs tokens pos TK_DOUBLE_COLON)
      (parseSigDecl tokens (advance pos))
  (if (peekIs tokens pos TK_IDENT)
      (let ((kw (vecGet tokens pos)))
        (let ((name (tokenLexeme kw)))
          (if (|| (kwEq name "union") (kwEq name "region"))
              ; Reserved, not unknown. Falling through to the
              ; unknown-declaration refusal below would report a
              ; generic syntax error and lose the migration advice
              ; that is the entire reason these two keywords are still
              ; reserved.
              (pErrRemoved pos name)
          (if (kwEq name (kwPub))
              (let ((r (parseTopForm tokens (advance pos))))
                (if (== (memGetWord r 0) 0)
                    r
                    { (markPub (memGetWord r 1)) r }))
          (if (|| (kwEq name (kwFn)) (kwEq name (kwDefine)))
              (parseFnDecl tokens (advance pos) name)
  (if (kwEq name (kwData))
      (parseDataDecl tokens (advance pos))
  (if (kwEq name (kwStruct))
      (parseStructDecl tokens (advance pos))
  (if (kwEq name (kwImport))
      (parseImportDecl tokens (advance pos))
  (if (kwEq name (kwMacro))
      (parseMacroDecl tokens (advance pos))
  (if (kwEq name (kwForeign))
      (parseForeignDecl tokens (advance pos))
  (if (kwEq name (kwEffect))
      (parseEffectDecl tokens (advance pos))
  (if (kwEq name "type")
      (parseAliasDecl tokens (advance pos) pos)
  (if (kwEq name "trait")
      (parseTraitDecl tokens (advance pos) pos)
  ; `impl` is the one declaration form stage0 parses that this
  ; parser has not learned; it is consumed as an inert node BY NAME,
  ; which is what the blanket skip below used to do for it
  ; implicitly. Naming it here is what let the blanket become a
  ; refusal - and the syntax zoo is what found it, five minutes
  ; after the refusal landed: a missing parse form hides inside a
  ; tolerance until the tolerance dies.
  (if (kwEq name "impl")
      (skipUnknownDecl tokens pos)
  ; Any OTHER head is a PARSE ERROR now, as it is in stage0
  ; (AX2001 "expected declaration keyword"). The skip was cover for
  ; forms this parser had not learned - foreign, type, trait, impl -
  ; and every one of those is now parsed or named above, so all the
  ; tolerance still accepted was invalid programs: `(+ 1 2)` at top
  ; level checked clean under stage1 (exit 0, OK) while stage0
  ; refused it, and anything typo'd into an unknown head VANISHED
  ; from the declaration list with no diagnostic - silent code loss
  ; wearing exit 0 (probed 2026-08-07). Malformed spellings of KNOWN
  ; keywords still degrade inside their own parsers, which is a
  ; different tolerance with a different blast radius.
  (pErr pos)))))))))))))))
  (pErr pos))))

; A form this parser does not know - `foreign`, `type`, `trait` - is
; consumed and stands in the declaration list as an inert TAG_NIL node.
; It used to be skipped with bare `skipParens`, whose success value is
; 0 - and `parseDecls` reads value 0 as the clean end of the module, so
; one unknown declaration silently dropped every declaration after it,
; with no diagnostic and exit 0. Truncation that looks like success is
; the worst spelling of unsupported.
; Parse `(foreign name :: Type = "symbol")`, keeping only the name.
; The type and the symbol are of no use to a backend that cannot emit
; a call to one; the name is, because it is a definition for the
; purpose of AX3015.
(pub :: parseForeignDecl (-> Int Int Int))
(pub fn (parseForeignDecl tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0)
        nr
        (let ((name (memGetWord nr 1))
              (nameSpan (tokenSpan (vecGet tokens pos)))
              (rest (skipParens tokens (memGetWord nr 2) 1)))
          (if (== (memGetWord rest 0) 0)
              rest
              ; The declared type now survives in the ty slot: stage0
              ; measures a foreign's saturation through its arrow depth
              ; (AX3013) and checks call arguments against it, and both
              ; need the structure. skipParens still owns the end
              ; position; a failed type parse leaves ty 0 (wildcard).
              (let ((tyNode
                      (if (peekIs tokens (memGetWord nr 2) TK_DOUBLE_COLON)
                          (let ((tr (parseType tokens (advance (memGetWord nr 2)))))
                            (if (== (memGetWord tr 0) 0) 0 (memGetWord tr 1)))
                          0))
                    ; The link symbol from `= "sym"`, for `symbols`'
                    ; `#symbol=` meta. The lexeme is the raw slice with
                    ; its quotes; corpus symbols are plain names, so
                    ; stripping the quotes IS the decode.
                    (symName (foreignSymbolAfter tokens (memGetWord nr 2))))
                (pOk (setNodeTy (mkNodeAt TAG_D_FOREIGN name symName 0 nameSpan) tyNode)
                     (memGetWord rest 2))))))))

; The string after `= ` in a foreign declaration, quotes stripped, or
; "" when the shape is absent. Scans forward from `pos` to the `=`,
; tracking paren depth so the TYPE's own closing parens do not end the
; walk - `(-> Int Int)` sits between the name and the `=`, and the
; first cut stopped at its `)` and answered "" for every arrow-typed
; foreign.
(pub :: foreignSymbolAfter (-> Int Int Int))
(pub fn (foreignSymbolAfter tokens pos)
  (foreignSymbolScan tokens pos 0))

(pub :: foreignSymbolScan (-> Int Int Int Int))
(pub fn (foreignSymbolScan tokens pos depth)
  (if (peekIs tokens pos TK_EOF)
      ""
      (if (&& (peekIs tokens pos TK_RPAREN) (== depth 0))
          ""
          (if (peekIs tokens pos TK_RPAREN)
              (foreignSymbolScan tokens (advance pos) (- depth 1))
              (if (peekIs tokens pos TK_LPAREN)
                  (foreignSymbolScan tokens (advance pos) (+ depth 1))
                  (if (&& (== depth 0)
                          (&& (peekIs tokens pos TK_IDENT)
                              (&& (strEq (tokenLexeme (vecGet tokens pos)) "=")
                                  (peekIs tokens (advance pos) TK_STRING))))
                      (let ((lex (tokenLexeme (vecGet tokens (advance pos)))))
                        (if (>= (strLen lex) 2)
                            (strSlice lex 1 (- (strLen lex) 2))
                            ""))
                      (foreignSymbolScan tokens (advance pos) depth)))))))

; Parse `(effect Name (op :: Type) ...)`, keeping the effect's name
; and its operations' names. Nothing else survives: stage1 emits no
; effect code, and a type it cannot lower is a type it need not
; record.
(pub :: parseEffectDecl (-> Int Int Int))
(pub fn (parseEffectDecl tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0)
        nr
        (let ((name (memGetWord nr 1))
              (nameSpan (tokenSpan (vecGet tokens pos))))
          ; Two parallel vectors: `ops` keeps the bare NAME strings
          ; every existing reader indexes (codegen's evidence slots,
          ; the ambiguity table, AX3017's count), and `opFields` keeps
          ; TAG_FIELD nodes with the declared TYPES beside them, in
          ; the c slot nothing read before - `symbols` prints an
          ; operation's real arrow where the checker deliberately
          ; keeps a silent wildcard.
          (let ((ops vecNew) (opFields vecNew))
            (let ((r (parseEffectOps tokens (memGetWord nr 2) ops opFields)))
              (if (== (memGetWord r 0) 0)
                  r
                  (pOk (mkNodeAt TAG_D_EFFECT name ops opFields nameSpan)
                       (memGetWord r 2)))))))))

; The type is parsed opportunistically and `skipParens` still owns
; the end position, so acceptance is unchanged; a type the parser
; cannot read leaves 0 in the field and only `symbols` is the poorer
; for it.
(pub :: parseEffectOps (-> Int Int Int Int Int))
(pub fn (parseEffectOps tokens pos ops opFields)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk 0 (advance pos))
      (if (peekIs tokens pos TK_LPAREN)
          (let ((nr (parseIdentName tokens (advance pos))))
            (if (== (memGetWord nr 0) 0)
                nr
                (let ((tyNode
                       (if (peekIs tokens (memGetWord nr 2) TK_DOUBLE_COLON)
                           (let ((tr (parseType tokens (advance (memGetWord nr 2)))))
                             (if (== (memGetWord tr 0) 0) 0 (memGetWord tr 1)))
                           0)))
                  {
                    (vecPush ops (memGetWord nr 1))
                    (vecPush opFields (mkField (memGetWord nr 1) tyNode))
                    (let ((r (skipParens tokens (memGetWord nr 2) 1)))
                      (if (== (memGetWord r 0) 0)
                          r
                          (parseEffectOps tokens (memGetWord r 2) ops opFields)))
                  })))
          (pErr pos))))

; `(type Name [tyvars] = Type)`. The name span, the tyvars, and the
; target's STRUCTURE all survive - `symbols` renders the target in the
; checker's notation. Any shape this does not recognise falls back to
; the old skip, so acceptance is unchanged: only well-formed aliases
; gain a node.
(pub :: parseAliasDecl (-> Int Int Int Int))
(pub fn (parseAliasDecl tokens pos origPos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((nr (parseIdentName tokens pos)))
        (if (== (memGetWord nr 0) 0)
            (skipUnknownDecl tokens origPos)
            (let ((name (memGetWord nr 1))
                  (nameSpan (tokenSpan (vecGet tokens pos)))
                  (tvs vecNew))
              ; NOT `collectTyParams`: its bare-run test is merely
              ; "does not start uppercase", and `=` lexes as an ident
              ; here, so the alias's own `=` was swallowed as a tyvar
              ; and every alias fell back to the inert skip. A tyvar
              ; must start with a lowercase LETTER.
              (let ((afterTvs (aliasTyvarsEnd tokens (memGetWord nr 2) tvs)))
                (if (&& (peekIs tokens afterTvs TK_IDENT)
                        (strEq (tokenLexeme (vecGet tokens afterTvs)) "="))
                    (let ((tr (parseType tokens (advance afterTvs))))
                      (if (== (memGetWord tr 0) 0)
                          (skipUnknownDecl tokens origPos)
                          (if (peekIs tokens (memGetWord tr 2) TK_RPAREN)
                              (pOk (mkNodeAt TAG_D_ALIAS name (memGetWord tr 1)
                                             tvs nameSpan)
                                   (advance (memGetWord tr 2)))
                              (skipUnknownDecl tokens origPos))))
                    (skipUnknownDecl tokens origPos))))))
      (skipUnknownDecl tokens origPos)))

; Type parameters between an alias's name and its `=`: a paren list,
; or a bare run of idents that start with a lowercase LETTER.
(pub :: aliasTyvarsEnd (-> Int Int Int Int))
(pub fn (aliasTyvarsEnd tokens pos tvs)
  (if (peekIs tokens pos TK_LPAREN)
      (collectTyParams tokens pos tvs)
      (if (&& (peekIs tokens pos TK_IDENT)
              (let ((b (strByte (tokenLexeme (vecGet tokens pos)) 0)))
                (&& (>= b 97) (<= b 122))))
          {
            (vecPush tvs (tokenLexeme (vecGet tokens pos)))
            (aliasTyvarsEnd tokens (advance pos) tvs)
          }
          pos)))

; `(trait (Name a) [(supertraits)] [(effects)] [where (m :: T ...)])`.
; What survives is what `symbols` prints: the name, its span, and the
; method name/type pairs. Supertraits, effect lists, and method
; defaults are consumed and dropped - AXSYM has no field for any of
; them. Fallback on any unrecognised shape, as for aliases.
(pub :: parseTraitDecl (-> Int Int Int Int))
(pub fn (parseTraitDecl tokens pos origPos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((np (advance pos)))
        (if (peekIs tokens np TK_IDENT)
            (let ((name (tokenLexeme (vecGet tokens np)))
                  (nameSpan (tokenSpan (vecGet tokens np)))
                  (hr (skipParens tokens np 1)))
              (if (== (memGetWord hr 0) 0)
                  (skipUnknownDecl tokens origPos)
                  (parseTraitRest tokens (memGetWord hr 2) name nameSpan origPos)))
            (skipUnknownDecl tokens origPos)))
      (skipUnknownDecl tokens origPos)))

(pub :: parseTraitRest (-> Int Int Int Int Int Int))
(pub fn (parseTraitRest tokens pos name nameSpan origPos)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk (mkNodeAt TAG_D_TRAIT name vecNew 0 nameSpan) (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      ; A supertrait or effect list: structure `symbols` cannot print.
      (let ((r (skipParens tokens (advance pos) 1)))
        (if (== (memGetWord r 0) 0)
            (skipUnknownDecl tokens origPos)
            (parseTraitRest tokens (memGetWord r 2) name nameSpan origPos)))
  (if (&& (peekIs tokens pos TK_IDENT)
          (strEq (tokenLexeme (vecGet tokens pos)) "where"))
      (if (peekIs tokens (advance pos) TK_LPAREN)
          (let ((methods vecNew))
            (let ((mr (parseTraitMethods tokens (advance (advance pos)) methods)))
              (if (== (memGetWord mr 0) 0)
                  (skipUnknownDecl tokens origPos)
                  (if (peekIs tokens (memGetWord mr 2) TK_RPAREN)
                      (pOk (mkNodeAt TAG_D_TRAIT name methods 0 nameSpan)
                           (advance (memGetWord mr 2)))
                      (skipUnknownDecl tokens origPos)))))
          (skipUnknownDecl tokens origPos))
  (skipUnknownDecl tokens origPos)))))

; `name :: Type [= default] [(effects)]`, repeated to the closing
; paren of the `where` group. The default expression is parsed and
; discarded; the effect list is skipped.
(pub :: parseTraitMethods (-> Int Int Int Int))
(pub fn (parseTraitMethods tokens pos methods)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk 0 (advance pos))
      (if (peekIs tokens pos TK_IDENT)
          (let ((mname (tokenLexeme (vecGet tokens pos))))
            (if (peekIs tokens (advance pos) TK_DOUBLE_COLON)
                (let ((tr (parseType tokens (advance (advance pos)))))
                  (if (== (memGetWord tr 0) 0)
                      (pErr pos)
                      (let ((afterTy (memGetWord tr 2)))
                        (let ((afterDflt
                               (if (&& (peekIs tokens afterTy TK_IDENT)
                                       (strEq (tokenLexeme (vecGet tokens afterTy)) "="))
                                   (let ((er (parseExpr tokens (advance afterTy))))
                                     (if (== (memGetWord er 0) 0)
                                         (- 0 1)
                                         (memGetWord er 2)))
                                   afterTy)))
                          (if (< afterDflt 0)
                              (pErr afterTy)
                              (let ((afterFx
                                     (if (peekIs tokens afterDflt TK_LPAREN)
                                         (let ((fr (skipParens tokens (advance afterDflt) 1)))
                                           (if (== (memGetWord fr 0) 0)
                                               (- 0 1)
                                               (memGetWord fr 2)))
                                         afterDflt)))
                                (if (< afterFx 0)
                                    (pErr afterDflt)
                                    {
                                      (vecPush methods (mkField mname (memGetWord tr 1)))
                                      (parseTraitMethods tokens afterFx methods)
                                    })))))))
                (pErr pos)))
          (pErr pos))))

(pub :: skipUnknownDecl (-> Int Int Int))
(pub fn (skipUnknownDecl tokens pos)
  (let ((r (skipParens tokens pos 1)))
    (if (== (memGetWord r 0) 0)
        r
        (pOk (mkNode TAG_NIL "" 0 0) (memGetWord r 2)))))

; ------------------------------------------------------------------
; Type expressions, kept structurally. The grammar mirrors stage0's
; parse_type exactly, because the checker's rendered types must match
; stage0's byte-for-byte:
;
;   ATOM  := '*' ATOM | 'linear' ATOM | KEYWORD | lowercase-IDENT
;          | IDENT | '(' TYPE... ')'
;   TYPE  := '(' '->' ATOM+ ')'         right-folded, binary, curried
;          | '(' ')'                    unit, an empty tuple
;          | '(' Upper-nonkeyword ATOM* ')'   type application
;          | '(' ATOM+ ')'              tuple; one element unwraps
;          | ATOM
;
; The keyword distinction is load-bearing: stage0 lexes `Int` as its
; own token kind, so `(Int Bool)` is a TUPLE while `(Foo Bar)` is an
; application - probed via `axiom symbols` rendering `(Int, Bool)`.
; stage1 lexes both as plain idents, so the keyword set is spelled out
; here. `Integer` canonicalises to `Int`, everything else to itself.
; ------------------------------------------------------------------
(pub :: typeKeywordCanon (-> Int Int))
(pub fn (typeKeywordCanon n)
  (if (strEq n "Int") "Int" (if (strEq n "Integer") "Int"
  (if (strEq n "Float") "Float" (if (strEq n "Double") "Double"
  (if (strEq n "Bool") "Bool" (if (strEq n "Char") "Char"
  (if (strEq n "String") "String" (if (strEq n "Void") "Void"
  (if (strEq n "Any") "Any"
  (if (strEq n "I8") "I8" (if (strEq n "I16") "I16"
  (if (strEq n "I32") "I32" (if (strEq n "I64") "I64"
  (if (strEq n "I128") "I128" (if (strEq n "Isize") "Isize"
  (if (strEq n "U8") "U8" (if (strEq n "U16") "U16"
  (if (strEq n "U32") "U32" (if (strEq n "U64") "U64"
  (if (strEq n "U128") "U128" (if (strEq n "Usize") "Usize"
  (if (strEq n "F32") "F32" (if (strEq n "F64") "F64"
  0))))))))))))))))))))))))

(pub :: lexStartsLower (-> Int Int))
(pub fn (lexStartsLower s)
  (if (== (strLen s) 0)
      0
      (if (&& (>= (strByte s 0) 97) (<= (strByte s 0) 122)) 1 0)))

(pub :: parseTypeAtom (-> Int Int Int))
(pub fn (parseTypeAtom tokens pos)
  ; `[T]` is the list type. The brackets only just became tokens -
  ; the lexer skipped them, so `[(Box Int)]` arrived as `(Box Int)`
  ; and `symbols` rendered a list-typed signature without its list.
  (if (peekIs tokens pos TK_LBRACKET)
      (let ((r (parseType tokens (advance pos))))
        (if (== (memGetWord r 0) 0) r
            (if (peekIs tokens (memGetWord r 2) TK_RBRACKET)
                (pOk (mkNode TAG_T_LIST (memGetWord r 1) 0 0)
                     (advance (memGetWord r 2)))
                (pErr (memGetWord r 2)))))
  (if (peekIs tokens pos TK_IDENT)
      (let ((s (tokenLexeme (vecGet tokens pos))))
        ; `* T` and `linear T` prefix the NEXT atom. `*Any` without the
        ; space lexes as one identifier here (stage1's `*` is an ident
        ; character) and lands in the TCon fallback - a recorded lexer
        ; gap; spell pointers `(* T)`.
        (if (strEq s "*")
            (let ((r (parseTypeAtom tokens (advance pos))))
              (if (== (memGetWord r 0) 0) r
                  (pOk (mkTPtr (memGetWord r 1) 0) (memGetWord r 2))))
        (if (strEq s "linear")
            (let ((r (parseTypeAtom tokens (advance pos))))
              (if (== (memGetWord r 0) 0) r
                  (pOk (mkTCon "Linear"
                               (let ((v vecNew)) { (vecPush v (memGetWord r 1)) v }))
                       (memGetWord r 2))))
        (let ((canon (typeKeywordCanon s)))
          (if (!= canon 0)
              (pOk (mkTCon canon vecNew) (advance pos))
          (if (== (lexStartsLower s) 1)
              (pOk (mkTVar s) (advance pos))
              (pOk (mkTCon s vecNew) (advance pos))))))))
  (if (peekIs tokens pos TK_LPAREN)
      (parseTypeParens tokens (advance pos))
  (pErrExp pos "type")))))

(pub :: parseType (-> Int Int Int))
(pub fn (parseType tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseTypeParens tokens (advance pos))
      (parseTypeAtom tokens pos)))

; A run of atoms up to the closing paren, which is consumed.
(pub :: parseTypeAtoms (-> Int Int Int Int))
(pub fn (parseTypeAtoms tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErrExp pos "type")
      (let ((r (parseTypeAtom tokens pos)))
        (if (== (memGetWord r 0) 0) r
            (parseTypeAtoms tokens (memGetWord r 2)
                            (vecPush acc (memGetWord r 1))))))))

; `pos` is just past the opening paren.
(pub :: parseTypeParens (-> Int Int Int))
(pub fn (parseTypeParens tokens pos)
  (if (peekIs tokens pos TK_RARROW)
      (let ((r (parseTypeAtoms tokens (advance pos) vecNew)))
        (if (== (memGetWord r 0) 0) r
            (let ((tys (memGetWord r 1)))
              (if (< (vecLen tys) 2)
                  (pErrExp pos "type")
                  (pOk (foldArrows tys (- (vecLen tys) 2)
                                   (vecGet tys (- (vecLen tys) 1)))
                       (memGetWord r 2))))))
  (if (peekIs tokens pos TK_RPAREN)
      (pOk (mkTTup vecNew) (advance pos))
  (if (&& (peekIs tokens pos TK_IDENT)
          (&& (identStartsUpper tokens pos)
              (== (typeKeywordCanon (tokenLexeme (vecGet tokens pos))) 0)))
      ; Type application: (Maybe Int), (Vec Float). A keyword head -
      ; (Int Bool) - is NOT an application; it falls through to the
      ; tuple loop, stage0's rule.
      (let ((head (tokenLexeme (vecGet tokens pos))))
        (let ((r (parseTypeAtoms tokens (advance pos) vecNew)))
          (if (== (memGetWord r 0) 0) r
              (pOk (mkTCon head (memGetWord r 1)) (memGetWord r 2)))))
  (let ((r (parseTypeAtoms tokens pos vecNew)))
    (if (== (memGetWord r 0) 0) r
        (let ((tys (memGetWord r 1)))
          (if (== (vecLen tys) 1)
              (pOk (vecGet tys 0) (memGetWord r 2))
              (pOk (mkTTup tys) (memGetWord r 2))))))))))

; `(-> A B C)` folds right: A -> (B -> C). `i` walks from the second-
; to-last element down to 0, wrapping `acc` each step.
(pub :: foldArrows (-> Int Int Int Int))
(pub fn (foldArrows tys i acc)
  (if (< i 0)
      acc
      (foldArrows tys (- i 1) (mkTArr (vecGet tys i) acc))))

; ------------------------------------------------------------------
; Parse (:: name (-> ...))
; ------------------------------------------------------------------
(pub :: parseSigDecl (-> Int Int Int))
(pub fn (parseSigDecl tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (let ((name (memGetWord nr 1))
              (typePos (memGetWord nr 2))
              (rest (skipParens tokens (memGetWord nr 2) 1)))
          (if (== (memGetWord rest 0) 0) rest
              (let ((endPos (memGetWord rest 2)))
                ; The signature used to be skipped outright. The emitter
                ; now needs one bit per arrow position - is it `Float` -
                ; because float-ness of a value is not observable at
                ; runtime: every value is an i64 word, and by emission
                ; time there is no type checker left to ask. This is the
                ; same reconstruction stage0's IR generator performs.
                ;
                ; The FULL type structure now survives too, in the ty
                ; slot, for the checker. The float flags stay in `b`
                ; untouched - codegen keys on that exact shape. A type
                ; the grammar cannot represent leaves ty 0, and the
                ; checker treats an absent type as a silent wildcard:
                ; under-reported, never mis-typed. Position always comes
                ; from skipParens, so a failed type parse cannot skew
                ; the token stream.
                (let ((tr (parseType tokens typePos)))
                  (pOk (setNodeTy
                         (mkDSigAt name (sigFloatFlags tokens typePos)
                                   (tokenSpan (vecGet tokens pos)))
                         (if (== (memGetWord tr 0) 0) 0 (memGetWord tr 1)))
                       endPos))))))))

; One flag per arrow position, return type last: `(-> Float Int Float)`
; is [1, 0, 1], and a bare type - `(:: pi Float)` - is a one-entry
; spine. A parenthesised position (a nested arrow, a type application
; like `(Vec Float)`) is a closure or a pointer, carried as a word,
; never a bare float.
(pub :: sigFloatFlags (-> Int Int Int))
(pub fn (sigFloatFlags tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((v vecNew))
        {
          (vecPush v (identIsFloat tokens pos))
          v
        })
  (if (&& (peekIs tokens pos TK_LPAREN)
          (peekIs tokens (advance pos) TK_RARROW))
      (spineFlags tokens (advance (advance pos)) vecNew)
  (let ((v vecNew))
    {
      (vecPush v 0)
      v
    }))))

(pub :: identIsFloat (-> Int Int Int))
(pub fn (identIsFloat tokens pos)
  (if (strEq (tokenLexeme (vecGet tokens pos)) "Float") 1 0))

(pub :: spineFlags (-> Int Int Int Int))
(pub fn (spineFlags tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      acc
  (if (peekIs tokens pos TK_IDENT)
      {
        (vecPush acc (identIsFloat tokens pos))
        (spineFlags tokens (advance pos) acc)
      }
  (if (peekIs tokens pos TK_LPAREN)
      (let ((r (skipParens tokens (advance pos) 1)))
        (if (== (memGetWord r 0) 0)
            acc
            {
              (vecPush acc 0)
              (spineFlags tokens (memGetWord r 2) acc)
            }))
  acc))))

; ------------------------------------------------------------------
; Parse a dotted module path: Ident ('.' Ident)*
;
; The dotted form is preserved verbatim in the returned Str (`Sys.Platform`
; stays `Sys.Platform`); translating it to a file path is the resolver's
; job, not the parser's.
; ------------------------------------------------------------------
(pub :: parseModPath (-> Int Int Int))
(pub fn (parseModPath tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (parseModPathRest tokens (memGetWord nr 2) (memGetWord nr 1)))))

(pub :: parseModPathRest (-> Int Int Int Int))
(pub fn (parseModPathRest tokens pos acc)
  (if (peekIs tokens pos TK_DOT)
      (let ((nr (parseIdentName tokens (advance pos))))
        (if (== (memGetWord nr 0) 0) nr
            (parseModPathRest tokens (memGetWord nr 2)
              (strConcat (strConcat acc ".")
                         (memGetWord nr 1)))))
      (pOk acc pos)))

; ------------------------------------------------------------------
; Parse (import Module (names...)) / (import Mod.Sub)
; ------------------------------------------------------------------
(pub :: parseImportDecl (-> Int Int Int))
(pub fn (parseImportDecl tokens pos)
  (let ((mr (parseModPath tokens pos)))
    (if (== (memGetWord mr 0) 0) mr
        (let ((modName (memGetWord mr 1))
              (nextPos (memGetWord mr 2)))
          (if (peekIs tokens nextPos TK_LPAREN)
              (let ((namesR (parseIdentList tokens (advance nextPos) vecNew)))
                (if (== (memGetWord namesR 0) 0) namesR
                    (let ((names (memGetWord namesR 1))
                          (afterNames (memGetWord namesR 2)))
                      (if (peekIs tokens afterNames TK_RPAREN)
                          (pOk (mkDImport modName names) (advance afterNames))
                          (pErr afterNames)))))
              (if (peekIs tokens nextPos TK_RPAREN)
                  (pOk (mkDImport modName vecNew) (advance nextPos))
                  (pErr nextPos)))))))

; ------------------------------------------------------------------
; Parse (data Name (Ctor1 ...) (Ctor2) ...)
; ------------------------------------------------------------------
(pub :: parseDataDecl (-> Int Int Int))
(pub fn (parseDataDecl tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (let ((name (memGetWord nr 1))
              (nextPos (memGetWord nr 2)))
          ; Type parameters are COLLECTED now, not merely skipped: a
          ; constructor's result type is `TCon(name, tyvars)` - `Nil`
          ; is `List a`, never bare `List` - and tyCompat compares TCon
          ; argument COUNTS, so losing the tyvars would make the
          ; checker call `Tree` and `Tree a` different types.
          (let ((tvs vecNew))
            (parseConstructors tokens (collectTyParams tokens nextPos tvs)
                               name (tokenSpan (vecGet tokens pos)) vecNew
                               tvs))))))

; Position-identical twin of skipTypeParams that also records the
; parameter names into `tvs`. Any shape skipTypeParams declines to
; treat as a parameter list is declined here identically, so parse
; positions cannot drift.
(pub :: collectTyParams (-> Int Int Int Int))
(pub fn (collectTyParams tokens pos tvs)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((inPos (advance pos)))
        (if (peekIs tokens inPos TK_RPAREN)
            (advance inPos)
            (if (peekIs tokens inPos TK_IDENT)
                (if (identStartsUpper tokens inPos)
                    pos
                    (let ((r (skipParens tokens inPos 1)))
                      (if (== (memGetWord r 0) 0)
                          pos
                          {
                            (collectIdentsUntilRParen tokens inPos tvs)
                            (memGetWord r 2)
                          })))
                pos)))
      (if (peekIs tokens pos TK_IDENT)
          (if (identStartsUpper tokens pos)
              pos
              {
                (vecPush tvs (tokenLexeme (vecGet tokens pos)))
                (collectTyParams tokens (advance pos) tvs)
              })
          pos)))

(pub :: collectIdentsUntilRParen (-> Int Int Int Int))
(pub fn (collectIdentsUntilRParen tokens pos tvs)
  (if (peekIs tokens pos TK_IDENT)
      {
        (vecPush tvs (tokenLexeme (vecGet tokens pos)))
        (collectIdentsUntilRParen tokens (advance pos) tvs)
      }
      0))

; `(data Tree (a) (Leaf) (Node a))` - the first parenthesised group is
; the type-parameter list when it is empty or opens with a lowercase
; name; constructors are uppercase. Registering `(a)` as a nullary
; constructor turned every binder named `a` anywhere in the module into
; a tag test that bound nothing, and the arm bodies dereferenced values
; that were never bound.
(pub :: skipTypeParams (-> Int Int Int))
(pub fn (skipTypeParams tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((inPos (advance pos)))
        (if (peekIs tokens inPos TK_RPAREN)
            (advance inPos)
            (if (peekIs tokens inPos TK_IDENT)
                (if (identStartsUpper tokens inPos)
                    pos
                    (let ((r (skipParens tokens inPos 1)))
                      (if (== (memGetWord r 0) 0)
                          pos
                          (memGetWord r 2))))
                pos)))
      ; The formatter also writes the parameters bare - `(data M9 a
      ; (J9 a))` - so a run of lowercase names before the first
      ; constructor group is the same list, unparenthesised.
      (if (peekIs tokens pos TK_IDENT)
          (if (identStartsUpper tokens pos)
              pos
              (skipTypeParams tokens (advance pos)))
          pos)))

(pub :: parseConstructors (-> Int Int Int Int Int Int Int))
(pub fn (parseConstructors tokens pos dataName nameSpan acc tvs)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk (setNodeTy (mkDDataAt dataName acc nameSpan) tvs) (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      (let ((r (parseOneCtor tokens (advance pos))))
        (if (== (memGetWord r 0) 0) r
            (let ((ctor (memGetWord r 1))
                  (nextPos (memGetWord r 2)))
              (parseConstructors tokens nextPos dataName nameSpan
                                 (vecPush acc ctor) tvs))))
  ; `deriving (Eq Show)` after the last constructor. Consumed and
  ; dropped: no derive machinery exists in this compiler yet, and
  ; AXSYM has no field for it either - but refusing the keyword made
  ; the zoo unparseable the moment `symbols` first fed it through
  ; this parser.
  (if (&& (peekIs tokens pos TK_IDENT)
          (strEq (tokenLexeme (vecGet tokens pos)) "deriving"))
      (if (peekIs tokens (advance pos) TK_LPAREN)
          (let ((r (skipParens tokens (advance (advance pos)) 1)))
            (if (== (memGetWord r 0) 0)
                r
                (parseConstructors tokens (memGetWord r 2) dataName nameSpan
                                   acc tvs)))
          (pErrExp pos "identifier"))
  (pErrExp pos "identifier")))))

(pub :: parseOneCtor (-> Int Int Int))
(pub fn (parseOneCtor tokens pos)
  (let ((r0 (parseOneCtorInner tokens pos)))
    (if (== (memGetWord r0 0) 0)
        r0
        ; Stamp the constructor's NAME span onto the node: `symbols`
        ; reports each constructor at its own name, and until it the
        ; ctor nodes carried none.
        {
          (setNodeSpan (memGetWord r0 1) (tokenSpan (vecGet tokens pos)))
          r0
        })))

(pub :: parseOneCtorInner (-> Int Int Int))
(pub fn (parseOneCtorInner tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (let ((ctorName (memGetWord nr 1))
              (nextPos (memGetWord nr 2)))
          (if (peekIs tokens nextPos TK_RPAREN)
              (pOk (setNodeTy (mkCtor ctorName 0 vecNew) vecNew)
                   (advance nextPos))
          ; A STRUCT VARIANT: `(Rect { w : Int, h : Int })`. The field
          ; names are recorded, and everything else about the
          ; constructor - arity, per-field float flags, per-field type
          ; nodes - is built exactly as the positional spelling builds
          ; it. A named constructor IS a positional one that also
          ; knows what its fields are called, which is why every
          ; consumer downstream needs no change: a positional pattern
          ; over a named declaration already works once this parses.
          (if (peekIs tokens nextPos TK_LBRACE)
              (parseNamedFieldTypes tokens (advance nextPos) vecNew ctorName
                                    vecNew vecNew)
              (parseFieldTypes tokens nextPos vecNew ctorName vecNew)))))))

; `name : Type` pairs to the closing brace, commas optional - stage0
; treats a comma as separator-or-not, so `{ w : Int h : Int }` parses
; the same as `{ w : Int, h : Int }`.
(pub :: parseNamedFieldTypes (-> Int Int Int Int Int Int Int))
(pub fn (parseNamedFieldTypes tokens pos flags ctorName tys names)
  (if (peekIs tokens pos TK_RBRACE)
      (if (peekIs tokens (advance pos) TK_RPAREN)
          (pOk (setCtorFieldNames
                 (setNodeTy (mkCtor ctorName (vecLen flags) flags) tys)
                 names)
               (advance (advance pos)))
          (pErr (advance pos)))
  ; No comma case: stage1's lexer has no comma token and skips the
  ; byte, so `{ w : Int, h : Int }` arrives as `{ w : Int h : Int }`.
  (if (peekIs tokens pos TK_IDENT)
      (let ((fname (tokenLexeme (vecGet tokens pos))))
        (if (peekIs tokens (advance pos) TK_COLON)
            (let ((tr (parseType tokens (advance (advance pos)))))
              (if (== (memGetWord tr 0) 0) tr
                  {
                    (vecPush names fname)
                    ; The float flag follows the positional rule
                    ; exactly: a BARE `Float` is 1, anything else
                    ; including a parenthesised type is 0.
                    (vecPush flags (if (peekIs tokens (advance (advance pos)) TK_IDENT)
                                       (identIsFloat tokens (advance (advance pos)))
                                       0))
                    (vecPush tys (memGetWord tr 1))
                    (parseNamedFieldTypes tokens (memGetWord tr 2) flags
                                          ctorName tys names)
                  }))
            (pErr (advance pos))))
  (pErr pos))))

(pub :: setCtorFieldNames (-> Int Int Int))
(pub fn (setCtorFieldNames n names) { (memSetWord n 9 names) n })

; Field types are retained as one float flag per field - a bare `Float`
; is 1, anything else (including any parenthesised type) is 0 - so a
; pattern that binds a constructor's field knows whether the word it
; binds is IEEE-754 bits. The arity is the flag count.
;
; The STRUCTURE of each field type also survives now, as a Vec of type
; nodes in the ctor's ty slot - the checker binds pattern variables at
; these types and checks construction arguments against them. The flag
; rule above is deliberately unchanged (`(Float)` parenthesised is
; still flag 0), so codegen behaves bit-identically.
(pub :: parseFieldTypes (-> Int Int Int Int Int Int))
(pub fn (parseFieldTypes tokens pos flags ctorName tys)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk (setNodeTy (mkCtor ctorName (vecLen flags) flags) tys)
           (advance pos))
  (if (peekIs tokens pos TK_IDENT)
      {
        (vecPush flags (identIsFloat tokens pos))
        (vecPush tys (typeNodeOrWildcard (parseTypeAtom tokens pos)))
        (parseFieldTypes tokens (advance pos) flags ctorName tys)
      }
  (if (peekIs tokens pos TK_LPAREN)
      (let ((afterSkip (skipParens tokens (advance pos) 1)))
        (if (== (memGetWord afterSkip 0) 0) afterSkip
            {
              (vecPush flags 0)
              (vecPush tys (typeNodeOrWildcard (parseType tokens pos)))
              (parseFieldTypes tokens (memGetWord afterSkip 2) flags ctorName tys)
            }))
  (pErr pos)))))

; A parsed type, or the silent wildcard for one the grammar cannot
; represent - the checker treats a nameless TVar as matching anything
; and never renders it, so failure here can only under-report.
(pub :: typeNodeOrWildcard (-> Int Int))
(pub fn (typeNodeOrWildcard r)
  (if (== (memGetWord r 0) 0)
      (mkTVar "")
      (memGetWord r 1)))

; ------------------------------------------------------------------
; Parse (struct Name (field1 : Type1) (field2 : Type2) ...)
; ------------------------------------------------------------------
(pub :: parseStructDecl (-> Int Int Int))
(pub fn (parseStructDecl tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (let ((name (memGetWord nr 1))
              (nextPos (memGetWord nr 2)))
          (parseFields tokens nextPos name
                       (tokenSpan (vecGet tokens pos)) vecNew)))))

(pub :: parseFields (-> Int Int Int Int Int Int))
(pub fn (parseFields tokens pos structName nameSpan acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk (mkDStructAt structName acc nameSpan) (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      (let ((r (parseOneField tokens (advance pos))))
        (if (== (memGetWord r 0) 0) r
            (let ((field (memGetWord r 1))
                  (nextPos (memGetWord r 2)))
              (parseFields tokens nextPos structName nameSpan (vecPush acc field)))))
  (pErrExp pos "identifier"))))

; `(mut name : Type)` - the marker sits INSIDE the parens, before the
; name. Reading it as the field's name gave the zoo's `Rec` a field
; called `mut` with a wildcard type; the marker itself is not recorded
; (nothing downstream reads mutability yet), only skipped.
(pub :: parseOneField (-> Int Int Int))
(pub fn (parseOneField tokens pos)
  (if (&& (peekIs tokens pos TK_IDENT)
          (&& (strEq (tokenLexeme (vecGet tokens pos)) "mut")
              (peekIs tokens (advance pos) TK_IDENT)))
      (parseOneFieldNamed tokens (advance pos))
      (parseOneFieldNamed tokens pos)))

(pub :: parseOneFieldNamed (-> Int Int Int))
(pub fn (parseOneFieldNamed tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (let ((fieldName (memGetWord nr 1))
              (nextPos (memGetWord nr 2)))
          ; `(name : Type)` - the type used to be skipped whole; the
          ; field's float flag survives (a bare `Float` is 1), so
          ; `p.f` arithmetic picks float instructions - and the full
          ; structure now rides in the ty slot for the checker. The
          ; flag rule and every token position are unchanged.
          (let ((fieldTy
                  (if (peekIs tokens nextPos TK_COLON)
                      (typeNodeOrWildcard (parseType tokens (advance nextPos)))
                      (mkTVar ""))))
            (if (&& (peekIs tokens nextPos TK_COLON)
                    (peekIs tokens (advance nextPos) TK_IDENT))
                (let ((fl (identIsFloat tokens (advance nextPos))))
                  (if (peekIs tokens (advance (advance nextPos)) TK_RPAREN)
                      (pOk (setNodeTy (mkField fieldName fl) fieldTy)
                           (advance (advance (advance nextPos))))
                      (let ((r (skipParens tokens (advance (advance nextPos)) 1)))
                        (if (== (memGetWord r 0) 0) r
                            (pOk (setNodeTy (mkField fieldName fl) fieldTy)
                                 (memGetWord r 2))))))
                (let ((afterSkip (skipParens tokens nextPos 1)))
                  (if (== (memGetWord afterSkip 0) 0) afterSkip
                      (pOk (setNodeTy (mkField fieldName 0) fieldTy)
                           (memGetWord afterSkip 2))))))))))

; ------------------------------------------------------------------
; Parse (macro (name params...) template)
;
; The name lives *inside* the head parens, exactly as a function's
; does - `(pub macro (when test body) (if test body 0))` is the real
; grammar. The previous version expected `(macro name (params) body)`,
; a spelling that appears nowhere in the language, so every macro in
; `stdlib/Pre.ax` was a parse error and the whole module was refused.
; ------------------------------------------------------------------
(pub :: parseMacroDecl (-> Int Int Int))
(pub fn (parseMacroDecl tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((nr (parseIdentName tokens (advance pos))))
        (if (== (memGetWord nr 0) 0) nr
            (let ((macName (memGetWord nr 1))
                  ; Consumes the head's closing paren too.
                  (paramsR (parseIdentList tokens (memGetWord nr 2) vecNew)))
              (if (== (memGetWord paramsR 0) 0) paramsR
                  (let ((params (memGetWord paramsR 1))
                        (bodyR (parseExpr tokens (memGetWord paramsR 2))))
                    (if (== (memGetWord bodyR 0) 0) bodyR
                        (let ((body (memGetWord bodyR 1))
                              (afterBody (memGetWord bodyR 2)))
                          (if (peekIs tokens afterBody TK_RPAREN)
                              (pOk (mkDMacro macName params body) (advance afterBody))
                              (pErr afterBody)))))))))
      (pErr pos)))

; ------------------------------------------------------------------
; Parse (fn (name args...) body) at top level.
; ------------------------------------------------------------------
(pub :: parseFnDecl (-> Int Int Int Int))
(pub fn (parseFnDecl tokens pos kwName)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((headerStart (advance pos)))
        (let ((nr (parseIdentName tokens headerStart)))
          (if (== (memGetWord nr 0) 0) nr
              (let ((fnName (memGetWord nr 1))
                    (afterName (memGetWord nr 2)))
                (let ((paramsR (parseIdentList tokens afterName vecNew)))
                  (if (== (memGetWord paramsR 0) 0) paramsR
                      (let ((params (memGetWord paramsR 1))
                            (afterParams (memGetWord paramsR 2)))
                        ; A body of SEVERAL expressions sequences them,
                        ; exactly as `let` bodies do - stage0's
                        ; parse_body_exprs wraps two or more in a
                        ; begin - and this parser demanded exactly one
                        ; until the zoo's `(fn (manyBody n) 1 n)` met
                        ; it. parseExprList consumes the closing paren.
                        (let ((bodyR (parseExprList tokens afterParams vecNew)))
                          (if (== (memGetWord bodyR 0) 0) bodyR
                              (let ((exprs (memGetWord bodyR 1))
                                    (afterBody (memGetWord bodyR 2)))
                                (if (== (vecLen exprs) 0)
                                    (pErr afterParams)
                                    (pOk (mkDFnAt fnName params
                                                  (if (== (vecLen exprs) 1)
                                                      (vecGet exprs 0)
                                                      (mkEBegin exprs))
                                                  (tokenSpan (vecGet tokens headerStart)))
                                         afterBody))))))))))))
  ; The bare nullary form: `(fn answer 42)` - no parens around the
  ; name - which the reference documents and stage0 accepts, with an
  ; optional `=` before the body (`(fn f = 7)`), which stage0's
  ; `parse_define` eats and this parser refused until the zoo first
  ; went through it.
  (if (peekIs tokens pos TK_IDENT)
      (let ((nr (parseIdentName tokens pos)))
        (if (== (memGetWord nr 0) 0) nr
            (let ((fnName (memGetWord nr 1))
                  (bodyR (parseExpr tokens
                           (if (&& (peekIs tokens (memGetWord nr 2) TK_IDENT)
                                   (strEq (tokenLexeme (vecGet tokens (memGetWord nr 2))) "="))
                               (advance (memGetWord nr 2))
                               (memGetWord nr 2)))))
              (if (== (memGetWord bodyR 0) 0) bodyR
                  (let ((body (memGetWord bodyR 1))
                        (afterBody (memGetWord bodyR 2)))
                    (if (peekIs tokens afterBody TK_RPAREN)
                        (pOk (mkDFnAt fnName vecNew body
                                      (tokenSpan (vecGet tokens pos)))
                             (advance afterBody))
                        (pErr afterBody)))))))
  (pErrExp pos "identifier"))))

; ------------------------------------------------------------------
; Expression parsing.
; ------------------------------------------------------------------
(pub :: parseExpr (-> Int Int Int))
(pub fn (parseExpr tokens pos)
  (if (peekIs tokens pos TK_INT)
      (parseLit tokens pos)
  (if (peekIs tokens pos TK_FLOAT)
      (parseLit tokens pos)
  (if (peekIs tokens pos TK_CHARLIT)
      (parseLit tokens pos)
  (if (peekIs tokens pos TK_STRING)
      (parseLit tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (parseIdentRef tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseSExpr tokens pos)
  (if (peekIs tokens pos TK_LBRACE)
      (parseBlock tokens (advance pos))
  (pErrExp pos "expression")))))))))

; ------------------------------------------------------------------
; Parse an S-expression: dispatch on first token.
; ------------------------------------------------------------------
(pub :: parseSExpr (-> Int Int Int))
(pub fn (parseSExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseInner tokens (advance pos))
  (pErrExp pos "expression")))

(pub :: parseInner (-> Int Int Int))
(pub fn (parseInner tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((kw (vecGet tokens pos)))
        (let ((name (tokenLexeme kw)))
          (if (kwEq name (kwPub))
              (parseInner tokens (advance pos))
          (if (kwEq name (kwFn))
              (parseLamExpr tokens (advance pos))
          ; stage0 spells an anonymous function `lambda`; expression
          ; position `fn` is stage1's older spelling and both stay.
          (if (kwEq name "lambda")
              (parseLamExpr tokens (advance pos))
          (if (kwEq name (kwLet))
              (parseLetExpr tokens (advance pos))
          (if (kwEq name (kwIf))
              (parseIfExpr tokens (advance pos))
          (if (kwEq name (kwMatch))
              (parseMatchExpr tokens (advance pos))
          (if (kwEq name (kwCond))
              (parseCondExpr tokens (advance pos))
          (if (kwEq name "while")
              (parseWhileExpr tokens (advance pos))
          (if (kwEq name "set")
              (parseSetExpr tokens (advance pos))
          ; The three keyword-headed forms stage0 parses here that
          ; stage1 used to leave to parseAppForm. Each arrived as an
          ; application of a bare name and drew a false AX3001 on a
          ; program stage0 compiles in silence; `struct` drew two,
          ; since its type name landed where an argument goes.
          (if (kwEq name (kwStruct))
              (parseStructConExpr tokens (advance pos))
          (if (kwEq name "consume")
              (parseConsumeExpr tokens (advance pos))
          (if (kwEq name "alloc")
              (parseAllocExpr tokens (advance pos) (tokenSpan kw))
          (if (kwEq name "handle")
              (parseHandleExpr tokens (advance pos))
          (parseAppForm tokens pos))))))))))))))))
  (if (peekIs tokens pos TK_DOUBLE_COLON)
      (parseTypeSigExpr tokens (advance pos))
  (if (peekIs tokens pos TK_RPAREN)
      (pOk 0 (advance pos))
  (parseAppForm tokens pos)))))

; `(:: expr Type)` - a type ascription in EXPRESSION position, which is
; not the same form as the top-level `(:: name Type)` declaration even
; though it is spelled with the same token. Only the declaration was
; parsed, so an ascribed expression reached `parseAppForm`, which asked
; for an expression, found `::`, and answered a bare `parse failed` with
; no span - a program stage0 compiles, refused by stage1 with nothing in
; the message to act on.
;
; It lowers to the `cast` spine rather than to a node of its own,
; because in stage0 the two forms are the same function: `check_expr`
; checks the inner expression and answers the written type for both
; (`axiom-sema/src/lib.rs:2825-2832`), and the IR generator is
; transparent for both (`axiom-ir/src/generator.rs:303-307`). Sharing
; the shape means no new case in the checker and none in the emitter,
; which is the pairing this compiler has already been bitten by: a
; checker taught a node the emitter does not know is a segfault, not a
; diagnostic.
;
; The synthetic head carries the *inner expression's* span, because
; stage0's `Expr::span()` for `ETypeSig` delegates to it, and `mkEApp`
; copies the head's span to the application.
(pub :: parseTypeSigExpr (-> Int Int Int))
(pub fn (parseTypeSigExpr tokens pos)
  (let ((er (parseExpr tokens pos)))
    (if (== (memGetWord er 0) 0) er
        (let ((inner (memGetWord er 1))
              (tr (parseExpr tokens (memGetWord er 2))))
          (if (== (memGetWord tr 0) 0) tr
              (let ((tyExpr (memGetWord tr 1))
                    (after (memGetWord tr 2)))
                (if (peekIs tokens after TK_RPAREN)
                    (pOk (mkEApp (mkEApp (mkEVarAt "cast" (nodeSpan inner)) tyExpr) inner)
                         (advance after))
                    (pErr after))))))))

; ------------------------------------------------------------------
; (while cond body...) - body takes any number of expressions.
; ------------------------------------------------------------------
(pub :: parseWhileExpr (-> Int Int Int))
(pub fn (parseWhileExpr tokens pos)
  (let ((condR (parseExpr tokens pos)))
    (if (== (memGetWord condR 0) 0) condR
        (let ((cnd (memGetWord condR 1))
              ; Consumes the while form's closing paren.
              (bodyR (parseExprList tokens (memGetWord condR 2) vecNew)))
          (if (== (memGetWord bodyR 0) 0) bodyR
              (pOk (mkNode TAG_E_WHILE cnd (memGetWord bodyR 1) 0)
                   (memGetWord bodyR 2)))))))

; ------------------------------------------------------------------
; (struct Name field...) - struct construction in expression position,
; stage0's parse_struct_con. The node carries the NAME'S span because
; every diagnostic stage0 produces about this form anchors there:
; AX3002 when the name resolves to no struct, AX3008 on a field-count
; mismatch (`expr.span()` of an EStructCon is its name's), and only a
; field's own AX3004 anchors at an argument.
; ------------------------------------------------------------------
(pub :: parseStructConExpr (-> Int Int Int))
(pub fn (parseStructConExpr tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((nameTok (vecGet tokens pos))
            (argsR (parseExprList tokens (advance pos) vecNew)))
        (if (== (memGetWord argsR 0) 0) argsR
            (pOk (mkNodeAt TAG_E_STRUCTCON (tokenLexeme nameTok)
                           (memGetWord argsR 1) 0
                           (tokenSpan nameTok))
                 (memGetWord argsR 2))))
  (pErr pos)))

; ------------------------------------------------------------------
; (consume e) - stage0 keeps an EConsume node, but every consumer
; sees through it: the checker types it as its operand, the IR
; generator lowers it to its operand, and `Expr::span()` answers the
; OPERAND's span. Collapsing it here is therefore exactly equivalent
; and costs no node - `(consume 42)` runs to 42 under stage0, probed.
; ------------------------------------------------------------------
(pub :: parseConsumeExpr (-> Int Int Int))
(pub fn (parseConsumeExpr tokens pos)
  (let ((r (parseExpr tokens pos)))
    (if (== (memGetWord r 0) 0) r
        (if (peekIs tokens (memGetWord r 2) TK_RPAREN)
            (pOk (memGetWord r 1) (advance (memGetWord r 2)))
            (pErr (memGetWord r 2))))))

; ------------------------------------------------------------------
; (alloc Type) / (alloc Type count) - the count is optional, and both
; shapes type as `*mut Type`. Nothing evaluates: stage0's IR generator
; has no EAlloc case at all, so the form reaches its catch-all and
; emits the constant 0 (probed: a stage0-built `(cast Int (alloc Int
; 4))` exits 0). stage1 reproduces the type and the zero rather than
; inventing an allocation stage0 does not perform.
; ------------------------------------------------------------------
; The span is the `alloc` KEYWORD's, which is stage0's - `EAlloc`
; carries the token span `parse_alloc` captured, rather than deriving
; one from a subexpression. It is load-bearing: an AX3011 whose
; handle body is a bare `(alloc T)` anchors there, and a node with no
; span suppresses the diagnostic instead of misplacing it.
(pub :: parseAllocExpr (-> Int Int Int Int))
(pub fn (parseAllocExpr tokens pos kwSpan)
  (let ((tr (parseType tokens pos)))
    (if (== (memGetWord tr 0) 0) tr
        (if (peekIs tokens (memGetWord tr 2) TK_RPAREN)
            (pOk (mkNodeAt TAG_E_ALLOC (memGetWord tr 1) 0 0 kwSpan)
                 (advance (memGetWord tr 2)))
            (let ((cr (parseExpr tokens (memGetWord tr 2))))
              (if (== (memGetWord cr 0) 0) cr
                  (if (peekIs tokens (memGetWord cr 2) TK_RPAREN)
                      (pOk (mkNodeAt TAG_E_ALLOC (memGetWord tr 1)
                                     (memGetWord cr 1) 0 kwSpan)
                           (advance (memGetWord cr 2)))
                      (pErr (memGetWord cr 2)))))))))

; ------------------------------------------------------------------
; (handle body (Effect...) handler) - stage0's parse_handle. The
; effect list is OPTIONAL: stage0 only reads one when the next token
; opens a paren, and otherwise goes straight to the handler.
;
; Each effect name is kept as a TAG_E_VAR node so it carries its own
; span; AX3016 and AX3017 both anchor at the name, not at the form.
; ------------------------------------------------------------------
(pub :: parseHandleExpr (-> Int Int Int))
(pub fn (parseHandleExpr tokens pos)
  (let ((bodyR (parseExpr tokens pos)))
    (if (== (memGetWord bodyR 0) 0) bodyR
        (let ((effsR (if (peekIs tokens (memGetWord bodyR 2) TK_LPAREN)
                         (parseEffectNames tokens
                                           (advance (memGetWord bodyR 2))
                                           vecNew)
                         (pOk vecNew (memGetWord bodyR 2)))))
          (if (== (memGetWord effsR 0) 0) effsR
              (let ((hR (parseExpr tokens (memGetWord effsR 2))))
                (if (== (memGetWord hR 0) 0) hR
                    (if (peekIs tokens (memGetWord hR 2) TK_RPAREN)
                        (pOk (mkNode TAG_E_HANDLE (memGetWord bodyR 1)
                                     (memGetWord effsR 1) (memGetWord hR 1))
                             (advance (memGetWord hR 2)))
                        (pErr (memGetWord hR 2))))))))))

; The names inside a handle's effect list, each as a spanned var node.
(pub :: parseEffectNames (-> Int Int Int Int))
(pub fn (parseEffectNames tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        {
          (vecPush acc (mkEVarAt (tokenLexeme t) (tokenSpan t)))
          (parseEffectNames tokens (advance pos) acc)
        })
  (pErr pos))))

; ------------------------------------------------------------------
; (set name value) - a store into a `mut` binding. The field form
; `(set r.field v)` needs storage stage1 does not model; the dot after
; the name makes this a parse error rather than a miscompile.
; ------------------------------------------------------------------
(pub :: parseSetExpr (-> Int Int Int))
(pub fn (parseSetExpr tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    ; stage0 names what a `set` target IS here rather than inheriting
    ; the generic "identifier" its own ident parser would give.
    (if (== (memGetWord nr 0) 0)
        (pErrExp (memGetWord nr 2)
                 "the name of a `mut` binding, or a field path")
        (if (peekIs tokens (memGetWord nr 2) TK_DOT)
            ; A dotted target is a field store: the chain builds the
            ; base the same way expression-position access does, and
            ; the LAST segment names the field written.
            (parseSetField tokens (memGetWord nr 2)
                           (mkEVarAt (memGetWord nr 1) (tokenSpan (vecGet tokens pos))))
            (let ((valR (parseExpr tokens (memGetWord nr 2))))
              (if (== (memGetWord valR 0) 0) valR
                  (let ((val (memGetWord valR 1))
                        (afterVal (memGetWord valR 2)))
                    (if (peekIs tokens afterVal TK_RPAREN)
                        ; The node's span is its TARGET's - stage0
                        ; points both AX3001 and AX3012 about a `set`
                        ; at the name being assigned, not at the form.
                        (pOk (mkNodeAt TAG_E_SET (memGetWord nr 1) val 0
                                       (tokenSpan (vecGet tokens pos)))
                             (advance afterVal))
                        (pErr afterVal)))))))))

; At a `.`: if another `.` follows the field, the field folds into the
; base; otherwise it is the store target and the value follows.
(pub :: parseSetField (-> Int Int Int Int))
(pub fn (parseSetField tokens pos base)
  (if (&& (peekIs tokens pos TK_DOT)
          (peekIs tokens (advance pos) TK_IDENT))
      (let ((fname (tokenLexeme (vecGet tokens (advance pos))))
            (after (advance (advance pos))))
        (if (peekIs tokens after TK_DOT)
            (parseSetField tokens after
              (mkNodeAt TAG_E_FIELD base fname 0
                        (tokenSpan (vecGet tokens (advance pos)))))
            (let ((valR (parseExpr tokens after)))
              (if (== (memGetWord valR 0) 0) valR
                  (let ((val (memGetWord valR 1))
                        (afterVal (memGetWord valR 2)))
                    (if (peekIs tokens afterVal TK_RPAREN)
                        ; Span = the stored field's name token, AX3007's
                        ; anchor, as on TAG_E_FIELD.
                        (pOk (mkNodeAt TAG_E_SETF base fname val
                                       (tokenSpan (vecGet tokens (advance pos))))
                             (advance afterVal))
                        (pErr afterVal)))))))
      (pErrExp pos "the name of a `mut` binding, or a field path")))

; ------------------------------------------------------------------
; Parse (cond (test body...) ... (else body...)) STRUCTURALLY: a
; TAG_E_COND node whose word 1 is a Vec of clause pairs (TAG_M_ARM:
; a=test, b=body) and word 2 the else body, or 0 for none.
;
; It used to desugar to a chain of `if` right here, but stage0's
; checker treats `cond` unlike nested `if`: clause bodies are never
; joined against each other, only a real `else` is compared - and only
; against the LAST clause - and a `cond` with no `else` is never
; compared at all (probed; `(cond ((f) true))` is silent where the
; desugared `(if (f) true 0)` would join Bool against Int). Codegen
; lowers this node to the exact same if-chain the parser used to
; build, in a pre-pass that runs before TCO analysis, so emission is
; bit-identical.
;
; `else` is not a token: it is an ordinary identifier recognised by
; name here, so it stays usable as a variable everywhere else.
; ------------------------------------------------------------------
(pub :: parseCondExpr (-> Int Int Int))
(pub fn (parseCondExpr tokens pos)
  (parseCondClauses tokens pos vecNew))

(pub :: parseCondClauses (-> Int Int Int Int))
(pub fn (parseCondClauses tokens pos clauses)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk (mkNode TAG_E_COND clauses 0 0) (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      (let ((inPos (advance pos)))
        (if (&& (peekIs tokens inPos TK_IDENT)
                (kwEq (tokenLexeme (vecGet tokens inPos)) (kwElse)))
            ; (else body...) - the chain's tail; the clause list must
            ; end here, so the cond's own rparen follows.
            (let ((bodyR (parseExprList tokens (advance inPos) vecNew)))
              (if (== (memGetWord bodyR 0) 0) bodyR
                  (let ((body (condBodyOf (memGetWord bodyR 1)))
                        (afterClause (memGetWord bodyR 2)))
                    (if (peekIs tokens afterClause TK_RPAREN)
                        (pOk (mkNode TAG_E_COND clauses body 0)
                             (advance afterClause))
                        (pErr afterClause)))))
            (let ((testR (parseExpr tokens inPos)))
              (if (== (memGetWord testR 0) 0) testR
                  (let ((test (memGetWord testR 1))
                        (bodyR (parseExprList tokens (memGetWord testR 2) vecNew)))
                    (if (== (memGetWord bodyR 0) 0) bodyR
                        {
                          (vecPush clauses
                            (mkNode TAG_M_ARM test
                                    (condBodyOf (memGetWord bodyR 1)) 0))
                          (parseCondClauses tokens (memGetWord bodyR 2) clauses)
                        }))))))
  (pErr pos))))

; A clause body of several expressions is a block; of one, itself; of
; none, 0.
(pub :: condBodyOf (-> Int Int))
(pub fn (condBodyOf exprs)
  (if (== (vecLen exprs) 0)
      (mkEInt 0)
      (if (== (vecLen exprs) 1)
          (vecGet exprs 0)
          (mkEBegin exprs))))

; ------------------------------------------------------------------
; Parse (fn (args...) body) as lambda expression.
; ------------------------------------------------------------------
(pub :: parseLamExpr (-> Int Int Int))
(pub fn (parseLamExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((paramsR (parseIdentList tokens (advance pos) vecNew)))
        (if (== (memGetWord paramsR 0) 0) paramsR
            (let ((params (memGetWord paramsR 1))
                  (afterParams (memGetWord paramsR 2)))
              (let ((bodyR (parseExpr tokens afterParams)))
                (if (== (memGetWord bodyR 0) 0) bodyR
                    (let ((body (memGetWord bodyR 1))
                          (afterBody (memGetWord bodyR 2)))
                      (if (peekIs tokens afterBody TK_RPAREN)
                          (pOk (mkELam params body) (advance afterBody))
                          (pErr afterBody))))))))
  (pErr pos)))

; ------------------------------------------------------------------
; Parse (let ((n1 v1) (n2 v2) ...) body)
;
; Multi-binding `let` is desugared into nested single-binding lets:
;
;   (let ((a 1) (b 2)) body)  =>  (let ((a 1)) (let ((b 2)) body))
;
; That keeps TAG_E_LET at one binding per node, so codegen needs no
; change, and it is exactly the sequential-evaluation semantics `let`
; already has: a later binding may refer to an earlier one.
;
; Bindings are collected left to right, then folded right to left so the
; first binding ends up outermost.
;
; The body is a sequence of one or more expressions, implicitly
; sequenced. `(let ((c ...)) (check c) c)` is common: the leading calls
; run for effect and the last expression is the value. A single-expression
; body is used directly; two or more are wrapped in TAG_E_BEGIN, which
; codegen already lowers as a sequence whose value is the last element.
; ------------------------------------------------------------------
(pub :: parseLetExpr (-> Int Int Int))
(pub fn (parseLetExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)                    ; enter ((n v) ...)
      (let ((br (parseBindPairs tokens (advance pos) vecNew)))
        (if (== (memGetWord br 0) 0) br
            (let ((binds (memGetWord br 1))
                  (afterBinds (memGetWord br 2)))
              ; parseExprList consumes the closing paren of the let form.
              (let ((bodyR (parseExprList tokens afterBinds vecNew)))
                (if (== (memGetWord bodyR 0) 0) bodyR
                    (let ((exprs (memGetWord bodyR 1))
                          (afterBody (memGetWord bodyR 2)))
                      (if (== (vecLen exprs) 0)
                          (pErr afterBinds)             ; (let (...)) has no value
                          (let ((body (if (== (vecLen exprs) 1)
                                          (vecGet exprs 0)
                                          (mkEBegin exprs))))
                            (pOk (foldLets binds body (- (vecLen binds) 1))
                                 afterBody)))))))))
  (pErr pos)))

; Parse the binding list ((n1 v1) (n2 v2) ...), returning a Vec of
; binding pairs carried as TAG_NIL nodes with a=name and b=value.
(pub :: parseBindPairs (-> Int Int Int Int))
(pub fn (parseBindPairs tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      (let ((nr (parseIdentName tokens (advance pos))))
        (if (== (memGetWord nr 0) 0) nr
            ; `(mut i 0)` - the marker is the word `mut`, then the real
            ; name. Word c of the pair records mutability for foldLets.
            (let ((isMut (if (strEq (memGetWord nr 1) "mut") 1 0)))
              (let ((nr2 (if (== isMut 1)
                             (parseIdentName tokens (memGetWord nr 2))
                             nr)))
                (if (== (memGetWord nr2 0) 0) nr2
                    (let ((name (memGetWord nr2 1)))
                      (let ((valR (parseExpr tokens (memGetWord nr2 2))))
                        (if (== (memGetWord valR 0) 0) valR
                            (let ((val (memGetWord valR 1))
                                  (afterVal (memGetWord valR 2)))
                              (if (peekIs tokens afterVal TK_RPAREN) ; close (n v)
                                  ; The pair carries the NAME token's
                                  ; span - the position after parsing
                                  ; the name, minus one, is its token.
                                  (parseBindPairs tokens (advance afterVal)
                                    (vecPush acc
                                      (mkNodeAt TAG_NIL name val isMut
                                        (tokenSpan (vecGet tokens
                                          (- (memGetWord nr2 2) 1))))))
                                  (pErr afterVal)))))))))))
  (pErr pos))))

; Fold binding pairs [0..i] around `body`, innermost binding first.
(pub :: foldLets (-> Int Int Int Int))
(pub fn (foldLets binds body i)
  (if (< i 0)
      body
      (let ((b (vecGet binds i)))
        (foldLets binds
                  (if (== (nodeC b) 1)
                      (mkNodeAt TAG_E_LETM (nodeA b) (nodeB b) body (nodeSpan b))
                      (mkELetAt (nodeA b) (nodeB b) body (nodeSpan b)))
                  (- i 1)))))

; ------------------------------------------------------------------
; Parse (if test then else)
; ------------------------------------------------------------------
(pub :: parseIfExpr (-> Int Int Int))
(pub fn (parseIfExpr tokens pos)
  (let ((testR (parseExpr tokens pos)))
    (if (== (memGetWord testR 0) 0) testR
        (let ((test (memGetWord testR 1))
              (afterTest (memGetWord testR 2)))
          (let ((thenR (parseExpr tokens afterTest)))
            (if (== (memGetWord thenR 0) 0) thenR
                (let ((thenEx (memGetWord thenR 1))
                      (afterThen (memGetWord thenR 2)))
                  (let ((elseR (parseExpr tokens afterThen)))
                    (if (== (memGetWord elseR 0) 0) elseR
                        (let ((elseEx (memGetWord elseR 1))
                              (afterElse (memGetWord elseR 2)))
                          (if (peekIs tokens afterElse TK_RPAREN)
                              (pOk (mkEIf test thenEx elseEx) (advance afterElse))
                              (pErr afterElse))))))))))))

; ------------------------------------------------------------------
; Parse (match scrutinee (pat body) ...)
; ------------------------------------------------------------------
(pub :: parseMatchExpr (-> Int Int Int))
(pub fn (parseMatchExpr tokens pos)
  (let ((scrutR (parseExpr tokens pos)))
    (if (== (memGetWord scrutR 0) 0) scrutR
        (let ((scrut (memGetWord scrutR 1))
              (afterScrut (memGetWord scrutR 2)))
          (let ((armsR (parseMatchArms tokens afterScrut vecNew)))
            (if (== (memGetWord armsR 0) 0) armsR
                (let ((arms (memGetWord armsR 1))
                      (afterArms (memGetWord armsR 2)))
                  (if (peekIs tokens afterArms TK_RPAREN)
                      (pOk (mkNode TAG_E_MATCH scrut arms 0) (advance afterArms))
                      (pErr afterArms)))))))))

; Stops *at* the closing paren without consuming it: `parseMatchExpr`
; expects to find it and consume it itself. Consuming it here made every
; `match` a parse error, since the caller then demanded a second one.
(pub :: parseMatchArms (-> Int Int Int Int))
(pub fn (parseMatchArms tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc pos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((armR (parseMatchArm tokens (advance pos))))
        (if (== (memGetWord armR 0) 0) armR
            (let ((arm (memGetWord armR 1))
                  (afterArm (memGetWord armR 2)))
              (parseMatchArms tokens afterArm (vecPush acc arm)))))
  (pErr pos))))

; Parse `(pat body)`.
;
; The pattern is kept. It used to be parsed and thrown away, which left
; codegen with a list of bodies and no way to tell which one applied.
(pub :: identStartsUpper (-> Int Int Bool))
(pub fn (identStartsUpper tokens pos)
  (let ((s (tokenLexeme (vecGet tokens pos))))
    (if (== (strLen s) 0)
        false
        (&& (>= (strByte s 0) 65) (<= (strByte s 0) 90)))))

; Pattern position: `( UpperIdent )` is a nullary-constructor test;
; everything else parses as an expression does. A bare identifier -
; constructor-named or not - is a binder, which is stage0's rule.
; RECURSIVE, because a nullary constructor nested inside a fieldful
; pattern is still a constructor. `(Wrap (Red))` used to parse its
; argument with `parseExpr`, which has no pattern context and made
; `(Red)` an ordinary variable reference - a BINDER, matching anything,
; so the first arm swallowed every scrutinee and
; `tests/stdlib/120-pattern-representation.ax` answered from the wrong
; arm. The same erasure was already recorded as an under-reporting gap
; in the checker; in the emitter it is a miscompile.
;
; A fieldful pattern still builds the application spine `parseExpr`
; would have built, so every consumer downstream is unchanged - only
; the ARGUMENTS are parsed as patterns rather than as expressions.
(pub :: parseArmPattern (-> Int Int Int))
(pub fn (parseArmPattern tokens pos)
  (if (&& (peekIs tokens pos TK_LPAREN)
          (&& (peekIs tokens (advance pos) TK_IDENT)
              (identStartsUpper tokens (advance pos))))
      (let ((nameTok (vecGet tokens (advance pos))))
        (if (peekIs tokens (advance (advance pos)) TK_RPAREN)
            (pOk (mkNodeAt TAG_P_CON0 (tokenLexeme nameTok) 0 0
                           (tokenSpan nameTok))
                 (advance (advance (advance pos))))
            (if (peekIs tokens (advance (advance pos)) TK_LBRACE)
                (parseNamedPatFields tokens (advance (advance (advance pos)))
                                     (tokenLexeme nameTok) (tokenSpan nameTok)
                                     vecNew vecNew)
                (parseArmPatternArgs tokens (advance (advance pos))
                  (mkEVarAt (tokenLexeme nameTok) (tokenSpan nameTok))))))
      (parseExpr tokens pos)))

; Reorder a named constructor pattern into the positional spine the
; rest of both compilers already understands. `declared` is the
; constructor's field names in declaration order; `names` and `pats`
; are what the pattern wrote, positionally aligned with each other.
;
; A field the pattern omits becomes `_`, which binds nothing - stage0
; fills the same hole with a wildcard, so a partial named pattern is
; legal by construction and needs no arity check.
(pub :: namedPatSpine (-> Int Int Int Int Int Int))
(pub fn (namedPatSpine cname declared names pats sp)
  (namedPatSpineFrom declared names pats 0 (mkEVarAt cname sp)))

(pub :: namedPatSpineFrom (-> Int Int Int Int Int Int))
(pub fn (namedPatSpineFrom declared names pats i acc)
  (if (>= i (vecLen declared))
      acc
      (let ((j (namedFieldIndex names (vecGet declared i) 0)))
        (namedPatSpineFrom declared names pats (+ i 1)
          (mkEApp acc (if (< j 0) (mkEVar "_") (vecGet pats j)))))))

; Where the pattern mentions field `n`, or -1. `names` holds spanned
; TAG_E_VAR nodes so a miss can be reported at the field name.
(pub :: namedFieldIndex (-> Int Int Int Int))
(pub fn (namedFieldIndex names n i)
  (if (>= i (vecLen names))
      (- 0 1)
      (if (strEq (nodeA (vecGet names i)) n)
          i
          (namedFieldIndex names n (+ i 1)))))

; Is `n` one of the constructor's declared fields?
(pub :: declaredHasField (-> Int Int Int))
(pub fn (declaredHasField declared n)
  (if (== declared 0) 0 (declaredHasFieldFrom declared n 0)))

(pub :: declaredHasFieldFrom (-> Int Int Int Int))
(pub fn (declaredHasFieldFrom declared n i)
  (if (>= i (vecLen declared))
      0
      (if (strEq (vecGet declared i) n) 1 (declaredHasFieldFrom declared n (+ i 1)))))

(pub :: peekIsEq (-> Int Int Bool))
(pub fn (peekIsEq tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (strEq (tokenLexeme (vecGet tokens pos)) "=")
      false))

; `{ f = pat, g }` to the closing brace. A bare name PUNS: `{ w, h }`
; means `{ w = w, h = h }`, which is stage0's rule and is resolved
; here at parse time, since it needs no knowledge of the declaration.
(pub :: parseNamedPatFields (-> Int Int Int Int Int Int Int))
(pub fn (parseNamedPatFields tokens pos cname csp names pats)
  (if (peekIs tokens pos TK_RBRACE)
      (if (peekIs tokens (advance pos) TK_RPAREN)
          (pOk (mkNodeAt TAG_P_CONNAMED cname names pats csp)
               (advance (advance pos)))
          (pErr (advance pos)))
  (if (peekIs tokens pos TK_IDENT)
      (let ((fTok (vecGet tokens pos)))
        {
          (vecPush names (mkEVarAt (tokenLexeme fTok) (tokenSpan fTok)))
          ; `=` has no token of its own: it is an operator character,
          ; so the lexer hands it back as an identifier whose lexeme
          ; is "=".
          (if (peekIsEq tokens (advance pos))
              (let ((pr (parseArmPattern tokens (advance (advance pos)))))
                (if (== (memGetWord pr 0) 0)
                    pr
                    {
                      (vecPush pats (memGetWord pr 1))
                      (parseNamedPatFields tokens (memGetWord pr 2) cname csp
                                           names pats)
                    }))
              {
                (vecPush pats (mkEVarAt (tokenLexeme fTok) (tokenSpan fTok)))
                (parseNamedPatFields tokens (advance pos) cname csp names pats)
              })
        })
  (pErr pos))))

(pub :: parseArmPatternArgs (-> Int Int Int Int))
(pub fn (parseArmPatternArgs tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (let ((r (parseArmPattern tokens pos)))
        (if (== (memGetWord r 0) 0) r
            (parseArmPatternArgs tokens (memGetWord r 2)
                                 (mkEApp acc (memGetWord r 1))))))))

(pub :: parseMatchArm (-> Int Int Int))
(pub fn (parseMatchArm tokens pos)
  (let ((patR (parseArmPattern tokens pos)))
    (if (== (memGetWord patR 0) 0) patR
        (let ((pat (memGetWord patR 1))
              (afterPat (memGetWord patR 2)))
          (let ((bodyR (parseExpr tokens afterPat)))
            (if (== (memGetWord bodyR 0) 0) bodyR
                (let ((body (memGetWord bodyR 1))
                      (afterBody (memGetWord bodyR 2)))
                  (if (peekIs tokens afterBody TK_RPAREN)
                      (pOk (mkNode TAG_M_ARM pat body 0) (advance afterBody))
                      (pErr afterBody)))))))))

; ------------------------------------------------------------------
; Parse { expr1 expr2 ... }
; ------------------------------------------------------------------
(pub :: parseBlock (-> Int Int Int))
(pub fn (parseBlock tokens pos)
  (parseBlockBody tokens pos vecNew))

(pub :: parseBlockBody (-> Int Int Int Int))
(pub fn (parseBlockBody tokens pos acc)
  (if (peekIs tokens pos TK_RBRACE)
      (pOk (mkEBegin acc) (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (let ((r (parseExpr tokens pos)))
        (if (== (memGetWord r 0) 0) r
            (parseBlockBody tokens (memGetWord r 2)
              (vecPush acc (memGetWord r 1))))))))

; ------------------------------------------------------------------
; Function application: (f args...)
; ------------------------------------------------------------------
(pub :: parseAppForm (-> Int Int Int))
(pub fn (parseAppForm tokens pos)
  (let ((r (parseExpr tokens pos)))
    (if (== (memGetWord r 0) 0) r
        (let ((fnExpr (memGetWord r 1))
              (nextPos (memGetWord r 2)))
          (let ((ar (parseArgs tokens nextPos fnExpr)))
            (if (== (memGetWord ar 0) 0) ar
                (pOk (unaryMinusToBinary (memGetWord ar 1)) (memGetWord ar 2))))))))

; `(- x)` is negation, not a one-argument call to a function named `-`.
;
; stage0 desugars it in the parser - `parse_expr_inner` turns a `-` head
; with exactly one argument into `EInfix(0, "-", x)` - and stage1 did
; not, so its type checker met a two-parameter builtin supplied with one
; argument and reported **AX3013 partial-application on a valid
; program**. `codegen.ax:emitCall` had the special case, which is what
; makes this the `cond` shape from the roadmap: the form was implemented
; at one end of the pipeline and absent at the other, so the stage that
; runs first refused what the stage that runs last was ready for. The
; codegen case is gone with this, since nothing can now reach it.
;
; Rewriting to the two-argument application rather than adding a node
; keeps every later stage untouched: `(- 0 x)` is a shape both compilers
; already agree on.
(pub :: unaryMinusToBinary (-> Int Int))
(pub fn (unaryMinusToBinary e)
  (if (== (nodeTag e) TAG_E_APP)
      (let ((head (nodeA e)))
        (if (&& (== (nodeTag head) TAG_E_VAR) (strEq (nodeA head) "-"))
            (mkEApp (mkEApp head (mkEInt 0)) (nodeB e))
            e))
      e))

(pub :: parseArgs (-> Int Int Int Int))
(pub fn (parseArgs tokens pos fnExpr)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk fnExpr (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (let ((r (parseExpr tokens pos)))
        (if (== (memGetWord r 0) 0) r
            (let ((arg (memGetWord r 1))
                  (nextPos (memGetWord r 2)))
              (parseArgs tokens nextPos (mkEApp fnExpr arg))))))))

; ------------------------------------------------------------------
; Parse declarations until EOF.
; ------------------------------------------------------------------
(pub :: parseDecls (-> Int Int Int Int))
(pub fn (parseDecls tokens pos acc)
  (let ((r (parseDecl tokens pos)))
    (if (== (memGetWord r 0) 0) r
        (let ((val (memGetWord r 1))
              (nextPos (memGetWord r 2)))
          (if (== val 0)
              (pOk acc nextPos)
              (parseDecls tokens nextPos (vecPush acc val)))))))

; ------------------------------------------------------------------
; Top-level: parse a module.
; ------------------------------------------------------------------
(pub :: parseModule (-> Int Int))
(pub fn (parseModule tokens)
  (let ((r (parseDecls tokens 0 vecNew)))
    r))

; As `parseModule`, then attaching AXTAGs. Declarations arrive in
; source order and every one carries its NAME's span, so the tags
; belonging to a declaration are exactly those whose offset precedes
; its name and follows the previous declaration's - the partition
; stage0's `collect_axtags` performs by consuming a contiguous run of
; Axtag tokens at each declaration boundary.
; ------------------------------------------------------------------
; The nesting limit.
;
; stage0 refuses past 1024 with AX2005 (`nesting is too deep (limit is
; 1024)`). stage1 had no limit and no depth counter anywhere, and the
; consequence was worse than a missing diagnostic: measured 2026-08-08,
; a 20,000-deep expression that stage0 REJECTS was ACCEPTED by stage1
; and checked clean, and at 100,000 stage1 died of SIGSEGV (signal 11)
; where stage0 still answered in the ordinary way. Accepting a program
; the other compiler refuses is the worse half of that: a crash is at
; least loud.
;
; Counted over the TOKEN STREAM rather than threaded through the parse
; functions. Every `parse*` function would need a depth parameter
; otherwise - sixty-odd of them - and this measures the same thing for
; the shape that matters, since a nesting level in this syntax is a
; delimiter. Braces and brackets are counted with parens because each
; one is a recursive descent in the parser too.
;
; It is deliberately NOT exact agreement with stage0's counter, which
; counts parse recursion rather than delimiters; the two coincide on
; every nesting form the grammar has, and where they might not, both
; compilers still refuse. What stage1 does not yet do is SAY AX2005:
; its parser carries no diagnostic payload, so this is a bare refusal
; and main.ax's `parse failed` (exit 2, against stage0's exit 1 for
; the same input). Both refuse, which is the parity standard this
; project uses where exit codes legitimately differ; the code and the
; span arrive with the parse-error port.
; ------------------------------------------------------------------
(pub :: parseMaxDepth Int)
(pub fn (parseMaxDepth) 1024)

; The deepest delimiter nesting reached anywhere in `tokens`.
;
; A closer at depth 0 is unbalanced input, which the parser reports on
; its own terms; it is floored here rather than allowed to go negative,
; so a stray `)` early in a file cannot mask real depth after it.
(pub :: maxNestDepth (-> Int Int))
(pub fn (maxNestDepth tokens)
  (let ((mut i 0) (mut d 0) (mut best 0) (n (vecLen tokens)))
    {
      (while (< i n)
        {
          (if (|| (peekIs tokens i TK_LPAREN)
                  (|| (peekIs tokens i TK_LBRACE)
                      (peekIs tokens i TK_LBRACKET)))
              {
                (set d (+ d 1))
                (if (> d best) (set best d) 0)
              }
              (if (|| (peekIs tokens i TK_RPAREN)
                      (|| (peekIs tokens i TK_RBRACE)
                          (peekIs tokens i TK_RBRACKET)))
                  (if (> d 0) (set d (- d 1)) 0)
                  0))
          (set i (+ i 1))
        })
      best
    }))

(pub :: parseModuleWith (-> Int Int Int))
(pub fn (parseModuleWith tokens axtags)
  ; The depth check runs BEFORE `parseDecls`, because the failure it
  ; prevents is that call exhausting the stack.
  (if (> (maxNestDepth tokens) parseMaxDepth)
      (pErr 0)
      (let ((r (parseDecls tokens 0 vecNew)))
        (if (== (memGetWord r 0) 0)
            r
            { (attachAxtags (memGetWord r 1) 0 axtags 0) r }))))

(pub :: attachAxtags (-> Int Int Int Int Int))
(pub fn (attachAxtags decls i axtags next)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (let ((limit (if (== (nodeSpan d) 0)
                         next
                         (spanStart (nodeSpan d)))))
          (let ((upto (axtagsUpto axtags next limit)))
            {
              (if (> upto next)
                  (memSetWord d 7 (axtagSlice axtags next upto))
                  0)
              (attachAxtags decls (+ i 1) axtags upto)
            })))))

; The index one past the last tag whose offset precedes `limit`.
(pub :: axtagsUpto (-> Int Int Int Int))
(pub fn (axtagsUpto axtags i limit)
  (if (>= i (vecLen axtags))
      i
      (if (< (memGetWord (vecGet axtags i) 0) limit)
          (axtagsUpto axtags (+ i 1) limit)
          i)))

(pub :: axtagSlice (-> Int Int Int Int))
(pub fn (axtagSlice axtags from upto)
  (let ((v vecNew))
    { (axtagSliceInto v axtags from upto) v }))

(pub :: axtagSliceInto (-> Int Int Int Int Int))
(pub fn (axtagSliceInto v axtags from upto)
  (if (>= from upto)
      0
      {
        (vecPush v (vecGet axtags from))
        (axtagSliceInto v axtags (+ from 1) upto)
      }))
