; parser.ax — recursive-descent S-expression parser.
;
; Consumes a Vec of Token handles and produces ASTNodes.
; Dependencies: core.ax, Mem, Str, Vec, lexer.ax.

(import core)
(import Mem)
(import Str)
(import Vec)
(import lexer)

; ------------------------------------------------------------------
; AST node: tagged union. tag + a,b,c fields. Unused = 0.
; ------------------------------------------------------------------
(struct ASTNode (tag : Int) (a : Int) (b : Int) (c : Int))

; Node tags.
(:: TAG_NIL Int)       (fn (TAG_NIL) 0)
(:: TAG_E_INT Int)     (fn (TAG_E_INT) 1)
(:: TAG_E_STR Int)     (fn (TAG_E_STR) 2)
(:: TAG_E_VAR Int)     (fn (TAG_E_VAR) 3)
(:: TAG_E_APP Int)     (fn (TAG_E_APP) 4)
(:: TAG_E_LAM Int)     (fn (TAG_E_LAM) 5)
(:: TAG_E_LET Int)     (fn (TAG_E_LET) 6)
(:: TAG_E_IF Int)      (fn (TAG_E_IF) 7)
(:: TAG_E_BEGIN Int)   (fn (TAG_E_BEGIN) 8)
(:: TAG_E_QUOTE Int)   (fn (TAG_E_QUOTE) 9)
(:: TAG_E_MATCH Int)   (fn (TAG_E_MATCH) 16)
(:: TAG_D_FN Int)      (fn (TAG_D_FN) 10)
(:: TAG_D_SIG Int)     (fn (TAG_D_SIG) 11)
(:: TAG_D_DATA Int)    (fn (TAG_D_DATA) 12)
(:: TAG_D_STRUCT Int)  (fn (TAG_D_STRUCT) 13)
(:: TAG_D_IMPORT Int)  (fn (TAG_D_IMPORT) 14)
(:: TAG_D_MACRO Int)   (fn (TAG_D_MACRO) 15)

(:: nodeTag (-> Int Int))   (fn (nodeTag n) (memGetWord n 0))
(:: nodeA   (-> Int Int))   (fn (nodeA   n) (memGetWord n 1))
(:: nodeB   (-> Int Int))   (fn (nodeB   n) (memGetWord n 2))
(:: nodeC   (-> Int Int))   (fn (nodeC   n) (memGetWord n 3))

(:: mkNode (-> Int Int Int Int Int))  (fn (mkNode t a b c) (ASTNode t a b c))
(:: mkEInt (-> Int Int))              (fn (mkEInt v)     (mkNode TAG_E_INT v 0 0))
(:: mkEStr (-> Int Int))              (fn (mkEStr s)     (mkNode TAG_E_STR s 0 0))
(:: mkEVar (-> Int Int))              (fn (mkEVar n)     (mkNode TAG_E_VAR n 0 0))
(:: mkEApp (-> Int Int Int))          (fn (mkEApp f x)   (mkNode TAG_E_APP f x 0))
(:: mkELam (-> Int Int Int))          (fn (mkELam p b)   (mkNode TAG_E_LAM p b 0))
(:: mkELet (-> Int Int Int Int))      (fn (mkELet n v b) (mkNode TAG_E_LET n v b))
(:: mkEIf  (-> Int Int Int Int))      (fn (mkEIf  t c a) (mkNode TAG_E_IF  t c a))
(:: mkEBegin (-> Int Int))            (fn (mkEBegin xs)  (mkNode TAG_E_BEGIN xs 0 0))
(:: mkDFn   (-> Int Int Int))         (fn (mkDFn n b)    (mkNode TAG_D_FN n b 0))
(:: mkDSig  (-> Int Int Int))         (fn (mkDSig n t)   (mkNode TAG_D_SIG n t 0))
(:: mkDImport (-> Int Int Int))       (fn (mkDImport m ns) (mkNode TAG_D_IMPORT m ns 0))

; ------------------------------------------------------------------
; Parse result.
; ------------------------------------------------------------------
(struct PResult (ok : Int) (value : Int) (pos : Int))

(:: pOk (-> Int Int Int))     (fn (pOk v p) (PResult 1 v p))
(:: pErr (-> Int Int))        (fn (pErr p)   (PResult 0 0 p))

; ------------------------------------------------------------------
; Token helpers.
; ------------------------------------------------------------------
(:: kindInt (-> TokenKind Int))
(fn (kindInt k) (cast Int k))

(:: peekToken (-> Int Int Int))
(fn (peekToken tokens pos)
  (if (>= pos (vecLen tokens)) 0 (vecGet tokens pos)))

(:: peekIs (-> Int Int TokenKind Bool))
(fn (peekIs tokens pos kind)
  (let ((t (peekToken tokens pos)))
    (if (== t 0)
        (== (kindInt TK_EOF) (kindInt kind))
        (== (kindInt (tokenKind t)) (kindInt kind)))))

(:: advance (-> Int Int)) (fn (advance p) (+ p 1))

; ------------------------------------------------------------------
; Skip to matching close-paren. depth starts at 1.
; ------------------------------------------------------------------
(:: skipParens (-> Int Int Int Int))
(fn (skipParens tokens pos depth)
  (if (>= pos (vecLen tokens)) (pErr pos)
  (if (peekIs tokens pos TK_RPAREN)
      (if (== depth 1) (pOk 0 (advance pos))
          (skipParens tokens (advance pos) (- depth 1)))
  (if (peekIs tokens pos TK_LPAREN)
      (skipParens tokens (advance pos) (+ depth 1))
  (skipParens tokens (advance pos) depth)))))

; ------------------------------------------------------------------
; Parse literals.
; ------------------------------------------------------------------
(:: parseLit (-> Int Int Int))
(fn (parseLit tokens pos)
  (if (peekIs tokens pos TK_INT)
      (let ((t (vecGet tokens pos)))
        (pOk (mkEInt (strToInt (tokenLexeme t))) (advance pos)))
  (if (peekIs tokens pos TK_STRING)
      (let ((t (vecGet tokens pos)))
        (pOk (mkEStr (tokenLexeme t)) (advance pos)))
  (pErr pos))))

(:: parseIdentRef (-> Int Int Int))
(fn (parseIdentRef tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        (pOk (mkEVar (tokenLexeme t)) (advance pos)))
  (pErr pos)))

; ------------------------------------------------------------------
; Parse an identifier token, returning the lexeme Str handle.
; ------------------------------------------------------------------
(:: parseIdentName (-> Int Int Int))
(fn (parseIdentName tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        (pOk (tokenLexeme t) (advance pos)))
  (pErr pos)))

; ------------------------------------------------------------------
; Parse a list of identifiers until ), returning a Vec of Str handles.
; ------------------------------------------------------------------
(:: parseIdentList (-> Int Int Int Int))
(fn (parseIdentList tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_IDENT)
      (let ((t (vecGet tokens pos)))
        (parseIdentList tokens (advance pos)
          (vecPush acc (tokenLexeme t))))
  (pErr pos))))

; ------------------------------------------------------------------
; Parse an expression list until ), returning a Vec of Expr handles.
; ------------------------------------------------------------------
(:: parseExprList (-> Int Int Int Int))
(fn (parseExprList tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (let ((r (parseExpr tokens pos)))
        (if (== (memGetWord r 0) 0)
            r
            (parseExprList tokens (memGetWord r 2)
              (vecPush acc (memGetWord r 1))))))))

; ------------------------------------------------------------------
; Keyword string literals for comparison.
; ------------------------------------------------------------------
(:: kwFn    Int) (fn (kwFn)    (strFromLit (__addr "fn")))
(:: kwData  Int) (fn (kwData)  (strFromLit (__addr "data")))
(:: kwStruct Int)(fn (kwStruct)(strFromLit (__addr "struct")))
(:: kwLet   Int) (fn (kwLet)   (strFromLit (__addr "let")))
(:: kwIf    Int) (fn (kwIf)    (strFromLit (__addr "if")))
(:: kwMatch Int) (fn (kwMatch) (strFromLit (__addr "match")))
(:: kwImport Int)(fn (kwImport)(strFromLit (__addr "import")))
(:: kwMacro Int) (fn (kwMacro) (strFromLit (__addr "macro")))
(:: kwBegin Int) (fn (kwBegin) (strFromLit (__addr "begin")))

(:: kwEq (-> Int Int Bool))
(fn (kwEq name lit)
  (strEq name lit))

; ------------------------------------------------------------------
; Top-level declaration parse: (keyword ...)
; ------------------------------------------------------------------
(:: parseDecl (-> Int Int Int))
(fn (parseDecl tokens pos)
  (if (peekIs tokens pos TK_EOF)
      (pOk 0 pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseTopForm tokens (advance pos))
  (pErr pos))))

(:: parseTopForm (-> Int Int Int))
(fn (parseTopForm tokens pos)
  (if (peekIs tokens pos TK_DOUBLE_COLON)
      (parseSigDecl tokens (advance pos))
  (if (peekIs tokens pos TK_IDENT)
      (let ((kw (vecGet tokens pos)))
        (let ((name (tokenLexeme kw)))
          (if (kwEq name (kwFn))
              (parseFnDecl tokens (advance pos) name)
          (if (kwEq name (kwData))
              (skipParens tokens (advance pos) 1)   ; TODO: real data parsing
          (if (kwEq name (kwStruct))
              (skipParens tokens (advance pos) 1)   ; TODO: real struct parsing
          (if (kwEq name (kwImport))
              (parseImportDecl tokens (advance pos))
          (if (kwEq name (kwMacro))
              (skipParens tokens (advance pos) 1)   ; TODO: real macro parsing
          (skipParens tokens pos 1))))))))             ; unknown form, skip
  (skipParens tokens pos 1))))                         ; non-keyword form, skip

; ------------------------------------------------------------------
; Parse (:: name (-> ...))
; ------------------------------------------------------------------
(:: parseSigDecl (-> Int Int Int))
(fn (parseSigDecl tokens pos)
  (let ((nr (parseIdentName tokens pos)))
    (if (== (memGetWord nr 0) 0) nr
        (let ((name (memGetWord nr 1))
              (rest (skipParens tokens (memGetWord nr 2) 1)))
          (if (== (memGetWord rest 0) 0) rest
              (let ((endPos (memGetWord rest 2)))
                (pOk (mkDSig name 0) endPos)))))))

; ------------------------------------------------------------------
; Parse (import Module (names...))
; ------------------------------------------------------------------
(:: parseImportDecl (-> Int Int Int))
(fn (parseImportDecl tokens pos)
  (let ((mr (parseIdentName tokens pos)))
    (if (== (memGetWord mr 0) 0) mr
        (let ((modName (memGetWord mr 1))
              (nextPos (memGetWord mr 2)))
          (if (peekIs tokens nextPos TK_LPAREN)
              (let ((namesR (parseIdentList tokens (advance nextPos) vecNew)))
                (if (== (memGetWord namesR 0) 0) namesR
                    (let ((names (memGetWord namesR 1))
                          (afterNames (memGetWord namesR 2)))
                      (if (peekIs tokens afterNames TK_RPAREN)
                          (pOk (mkDImport modName names) (advance afterNames))
                          (pErr afterNames)))))
              (if (peekIs tokens nextPos TK_RPAREN)
                  (pOk (mkDImport modName vecNew) (advance nextPos))
                  (pErr nextPos)))))))

; ------------------------------------------------------------------
; Parse (fn (name args...) body) at top level.
; ------------------------------------------------------------------
(:: parseFnDecl (-> Int Int Int Int))
(fn (parseFnDecl tokens pos kwName)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((headerStart (advance pos)))
        (let ((nr (parseIdentName tokens headerStart)))
          (if (== (memGetWord nr 0) 0) nr
              (let ((fnName (memGetWord nr 1))
                    (afterName (memGetWord nr 2)))
                (let ((paramsR (parseIdentList tokens afterName vecNew)))
                  (if (== (memGetWord paramsR 0) 0) paramsR
                      (let ((afterParams (memGetWord paramsR 2)))
                        (let ((bodyR (parseExpr tokens afterParams)))
                          (if (== (memGetWord bodyR 0) 0) bodyR
                              (let ((body (memGetWord bodyR 1))
                                    (afterBody (memGetWord bodyR 2)))
                                (if (peekIs tokens afterBody TK_RPAREN)
                                    (pOk (mkDFn fnName body) (advance afterBody))
                                    (pErr afterBody))))))))))))
  (pErr pos)))

; ------------------------------------------------------------------
; Expression parsing.
; ------------------------------------------------------------------
(:: parseExpr (-> Int Int Int))
(fn (parseExpr tokens pos)
  (if (peekIs tokens pos TK_INT)
      (parseLit tokens pos)
  (if (peekIs tokens pos TK_STRING)
      (parseLit tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (parseIdentRef tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseSExpr tokens pos)
  (if (peekIs tokens pos TK_LBRACE)
      (parseBlock tokens (advance pos))
  (pErr pos)))))))

; ------------------------------------------------------------------
; Parse an S-expression: dispatch on first token.
; ------------------------------------------------------------------
(:: parseSExpr (-> Int Int Int))
(fn (parseSExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (parseInner tokens (advance pos))
  (pErr pos)))

(:: parseInner (-> Int Int Int))
(fn (parseInner tokens pos)
  (if (peekIs tokens pos TK_IDENT)
      (let ((kw (vecGet tokens pos)))
        (let ((name (tokenLexeme kw)))
          (if (kwEq name (kwFn))
              (parseLamExpr tokens (advance pos))
          (if (kwEq name (kwLet))
              (parseLetExpr tokens (advance pos))
          (if (kwEq name (kwIf))
              (parseIfExpr tokens (advance pos))
          (if (kwEq name (kwMatch))
              (parseMatchExpr tokens (advance pos))
          (if (kwEq name (kwBegin))
              (parseBlockBody tokens (advance pos) vecNew)
          (parseAppForm tokens pos))))))))
  (if (peekIs tokens pos TK_RPAREN)
      (pOk 0 (advance pos))
  (parseAppForm tokens pos))))

; ------------------------------------------------------------------
; Parse (fn (args...) body) as lambda expression.
; ------------------------------------------------------------------
(:: parseLamExpr (-> Int Int Int))
(fn (parseLamExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((paramsR (parseIdentList tokens (advance pos) vecNew)))
        (if (== (memGetWord paramsR 0) 0) paramsR
            (let ((params (memGetWord paramsR 1))
                  (afterParams (memGetWord paramsR 2)))
              (let ((bodyR (parseExpr tokens afterParams)))
                (if (== (memGetWord bodyR 0) 0) bodyR
                    (let ((body (memGetWord bodyR 1))
                          (afterBody (memGetWord bodyR 2)))
                      (if (peekIs tokens afterBody TK_RPAREN)
                          (pOk (mkELam params body) (advance afterBody))
                          (pErr afterBody))))))))
  (pErr pos)))

; ------------------------------------------------------------------
; Parse (let ((name val) ...) body)
; ------------------------------------------------------------------
(:: parseLetExpr (-> Int Int Int))
(fn (parseLetExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
      (let ((bindList (advance pos)))
        (let ((bindR (parseLetBindings tokens bindList)))
          (if (== (memGetWord bindR 0) 0) bindR
              (let ((bindings (memGetWord bindR 1))
                    (afterBind (memGetWord bindR 2)))
                (let ((bodyR (parseExpr tokens afterBind)))
                  (if (== (memGetWord bodyR 0) 0) bodyR
                      (let ((body (memGetWord bodyR 1))
                            (afterBody (memGetWord bodyR 2)))
                        (if (peekIs tokens afterBody TK_RPAREN)
                            (pOk (mkELet bindings 0 body) (advance afterBody))
                            (pErr afterBody)))))))))
  (pErr pos)))

; Parse ((name val) ...) within let, returning a Vec of (name, val) pairs or a single name.
; For now, just handle single-binding let.
(:: parseLetBindings (-> Int Int Int))
(fn (parseLetBindings tokens pos)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk 0 (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      (let ((inner (advance pos)))
        (let ((nr (parseIdentName tokens inner)))
          (if (== (memGetWord nr 0) 0) nr
              (let ((name (memGetWord nr 1))
                    (afterName (memGetWord nr 2)))
                (let ((valR (parseExpr tokens afterName)))
                  (if (== (memGetWord valR 0) 0) valR
                      (let ((val (memGetWord valR 1))
                            (afterVal (memGetWord valR 2)))
                        (if (peekIs tokens afterVal TK_RPAREN)
                            (pOk name (advance afterVal))
                            (pErr afterVal)))))))))
  (pErr pos))))

; ------------------------------------------------------------------
; Parse (if test then else)
; ------------------------------------------------------------------
(:: parseIfExpr (-> Int Int Int))
(fn (parseIfExpr tokens pos)
  (let ((testR (parseExpr tokens pos)))
    (if (== (memGetWord testR 0) 0) testR
        (let ((test (memGetWord testR 1))
              (afterTest (memGetWord testR 2)))
          (let ((thenR (parseExpr tokens afterTest)))
            (if (== (memGetWord thenR 0) 0) thenR
                (let ((thenEx (memGetWord thenR 1))
                      (afterThen (memGetWord thenR 2)))
                  (let ((elseR (parseExpr tokens afterThen)))
                    (if (== (memGetWord elseR 0) 0) elseR
                        (let ((elseEx (memGetWord elseR 1))
                              (afterElse (memGetWord elseR 2)))
                          (if (peekIs tokens afterElse TK_RPAREN)
                              (pOk (mkEIf test thenEx elseEx) (advance afterElse))
                              (pErr afterElse))))))))))))

; ------------------------------------------------------------------
; Parse (match scrutinee (pat body) ...)
; ------------------------------------------------------------------
(:: parseMatchExpr (-> Int Int Int))
(fn (parseMatchExpr tokens pos)
  (let ((scrutR (parseExpr tokens pos)))
    (if (== (memGetWord scrutR 0) 0) scrutR
        (let ((scrut (memGetWord scrutR 1))
              (afterScrut (memGetWord scrutR 2)))
          (let ((armsR (parseMatchArms tokens afterScrut vecNew)))
            (if (== (memGetWord armsR 0) 0) armsR
                (let ((arms (memGetWord armsR 1))
                      (afterArms (memGetWord armsR 2)))
                  (if (peekIs tokens afterArms TK_RPAREN)
                      (pOk (mkNode TAG_E_MATCH scrut arms 0) (advance afterArms))
                      (pErr afterArms)))))))))

(:: parseMatchArms (-> Int Int Int Int))
(fn (parseMatchArms tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk acc (advance pos))
  (if (peekIs tokens pos TK_LPAREN)
      (let ((armR (parseMatchArm tokens (advance pos))))
        (if (== (memGetWord armR 0) 0) armR
            (let ((arm (memGetWord armR 1))
                  (afterArm (memGetWord armR 2)))
              (parseMatchArms tokens afterArm (vecPush acc arm)))))
  (pErr pos))))

; Parse (pat body) — for now, skip pat and parse body.
(:: parseMatchArm (-> Int Int Int))
(fn (parseMatchArm tokens pos)
  (let ((patR (parseExpr tokens pos)))
    (if (== (memGetWord patR 0) 0) patR
        (let ((afterPat (memGetWord patR 2)))
          (let ((bodyR (parseExpr tokens afterPat)))
            (if (== (memGetWord bodyR 0) 0) bodyR
                (let ((body (memGetWord bodyR 1))
                      (afterBody (memGetWord bodyR 2)))
                  (if (peekIs tokens afterBody TK_RPAREN)
                      (pOk body (advance afterBody))
                      (pErr afterBody)))))))))

; ------------------------------------------------------------------
; Parse { expr1 expr2 ... }
; ------------------------------------------------------------------
(:: parseBlock (-> Int Int Int))
(fn (parseBlock tokens pos)
  (parseBlockBody tokens pos vecNew))

(:: parseBlockBody (-> Int Int Int Int))
(fn (parseBlockBody tokens pos acc)
  (if (peekIs tokens pos TK_RBRACE)
      (pOk (mkEBegin acc) (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (let ((r (parseExpr tokens pos)))
        (if (== (memGetWord r 0) 0) r
            (parseBlockBody tokens (memGetWord r 2)
              (vecPush acc (memGetWord r 1))))))))

; ------------------------------------------------------------------
; Function application: (f args...)
; ------------------------------------------------------------------
(:: parseAppForm (-> Int Int Int))
(fn (parseAppForm tokens pos)
  (let ((r (parseExpr tokens pos)))
    (if (== (memGetWord r 0) 0) r
        (let ((fnExpr (memGetWord r 1))
              (nextPos (memGetWord r 2)))
          (parseArgs tokens nextPos fnExpr)))))

(:: parseArgs (-> Int Int Int Int))
(fn (parseArgs tokens pos fnExpr)
  (if (peekIs tokens pos TK_RPAREN)
      (pOk fnExpr (advance pos))
  (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (let ((r (parseExpr tokens pos)))
        (if (== (memGetWord r 0) 0) r
            (let ((arg (memGetWord r 1))
                  (nextPos (memGetWord r 2)))
              (parseArgs tokens nextPos (mkEApp fnExpr arg))))))))

; ------------------------------------------------------------------
; Parse declarations until EOF.
; ------------------------------------------------------------------
(:: parseDecls (-> Int Int Int Int))
(fn (parseDecls tokens pos acc)
  (let ((r (parseDecl tokens pos)))
    (if (== (memGetWord r 0) 0) r
        (let ((val (memGetWord r 1))
              (nextPos (memGetWord r 2)))
          (if (== val 0)
              (pOk acc nextPos)
              (parseDecls tokens nextPos (vecPush acc val)))))))

; ------------------------------------------------------------------
; Top-level: parse a module.
; ------------------------------------------------------------------
(:: parseModule (-> Int Int))
(fn (parseModule tokens)
  (let ((r (parseDecls tokens 0 vecNew)))
    r))
