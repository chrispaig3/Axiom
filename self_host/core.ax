;; Core data structures for the self-hosted Axiom compiler.

(struct Span
  (span_start Int)
  (span_end Int)
  (span_file_id Int))

(struct TokenKind
  (tk_ident String)
  (tk_int Int)
  (tk_fn)
  (tk_let)
  (tk_if)
  (tk_struct)
  (tk_type)
  (tk_import)
  (tk_println)
  (tk_eof))

(struct Token
  (token_kind TokenKind)
  (token_span Span))

(struct Module
  (make_module (List Token) (List Token) Span))
