;; Self-hosted code generator stub for Axiom.
;; The code generator transforms the typed AST into LLVM IR.

(import core)
(import parser)
(import typecheck)

(:: axiom_codegen (-> String String))
(fn (axiom_codegen ast)
  "")

;; The code generator demonstrates a key self-hosting principle:
;; compilation as symbolic transformation. The typed AST is
;; transformed into LLVM IR — another symbolic representation —
;; using the same pattern matching and recursion that Axiom
;; uses for all computation.
