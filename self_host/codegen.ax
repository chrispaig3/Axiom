; codegen.ax — LLVM IR text emitter.
; Dependencies: core.ax, parser.ax, Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Sys)
(import Path)
(import parser)
(import namespace)
(import diag)
(import expand)
(import render)
; `Intern`: the O(1) indexes `emitResolved` builds over the signature
; table and the mangle map, for the ownership questions asked at
; every call site (`findFSigCg`, `mangledForCg`).
(import Intern)

; ------------------------------------------------------------------
; Type registry: constructor/struct name -> arity, kind, tag.
; ------------------------------------------------------------------
; `rep` records the data type's representation, matching stage0's S1
; rule: 0 = boxed, 1 = all-nullary (every value is its immediate tag),
; 2 = mixed - nullary constructors are immediate tags while fieldful
; siblings are heap blocks, so a fieldful arm's tag read must first
; test `value < 4096` (no immediate reaches it, every heap address
; exceeds it) before loading word 0. An unconditional load there
; dereferences a small integer; treating every value as immediate
; makes a pointer fail every tag compare. The tag lives where the
; *constructor named at the site* says, plus that one runtime test
; for the fieldful-in-mixed case.
;
; `fieldFlags` is one 0/1 per field: is it declared `Float`. A pattern
; binder for that field carries the flag into the symbol table.
; `fieldNames` is a data constructor's declared field names when it
; was written as a struct variant, 0 otherwise; a named pattern is
; reordered against it at emission.
; `fieldTys` is a data constructor's Vec of declared field TYPE nodes
; (the parser's ty slot, one TAG_T_* node per field), 0 when nothing
; recorded one - it is what MM-LIFE-2d's shape constant is computed
; from at construction sites. A struct's field types ride inside its
; slot-7 TAG_FIELD nodes already, so struct entries leave this 0.
(pub struct TypeEntry (name : String) (nameLen : Int) (kind : Int) (arity : Int) (tag : Int) (rep : Int) (fieldFlags : Int) (fieldNames : Int) (fieldTys : Int))
(pub :: TF_DATA   Int) (pub fn (TF_DATA)   0)
(pub :: TF_STRUCT Int) (pub fn (TF_STRUCT) 1)
(pub :: eNameLen (-> Int Int)) (pub fn (eNameLen e) (memGetWord e 1))
(pub :: eKind  (-> Int Int)) (pub fn (eKind  e) (memGetWord e 2))
(pub :: eArity (-> Int Int)) (pub fn (eArity e) (memGetWord e 3))
(pub :: eTag   (-> Int Int)) (pub fn (eTag   e) (memGetWord e 4))
(pub :: eRep     (-> Int Int)) (pub fn (eRep e)     (memGetWord e 5))
(pub :: eFieldFlags (-> Int Int)) (pub fn (eFieldFlags e) (memGetWord e 6))

; A length is not a name. An entry used to carry a `nameHash` word
; beside its `nameLen` and match on the pair alone, so every name of the
; same length was the same name: with a `(struct P ...)` in scope,
; `(+ a b)` found `P` in the type registry and was emitted as a struct
; construction. Equality is decided by comparing the bytes now, and the
; hash word was `strLen` - the same value as `nameLen`, one word further
; along - so the entry carried its length twice and read it once.

(pub :: eName (-> Int String)) (pub fn (eName e) (memGetWord e 0))

(pub :: addType (-> Int String Int Int Int Int Int Int))
(pub fn (addType types name kind arity tag rep fieldFlags)
  (addTypeNamed types name kind arity tag rep fieldFlags 0 0))

(pub :: addTypeNamed (-> Int String Int Int Int Int Int Int Int Int))
(pub fn (addTypeNamed types name kind arity tag rep fieldFlags fieldNames fieldTys)
  (let ((nl (strLen name)))
    (vecPush types (cast Int (TypeEntry name nl kind arity tag rep fieldFlags fieldNames fieldTys)))))
(pub :: eFieldNames (-> Int Int)) (pub fn (eFieldNames e) (memGetWord e 7))
(pub :: eFieldTys (-> Int Int)) (pub fn (eFieldTys e) (memGetWord e 8))

(pub :: lookupType (-> Int String Int))
(pub fn (lookupType types name)
  (lookupByIdx types name (strLen name) 0))

; A LOOP, not a recursion, for the reason `lexTokens` and
; `skipLineComment` are loops: this walks the whole type table, so it
; used to cost ONE STACK FRAME PER ENTRY, and the table holds every
; constructor and struct of every module in the program. The self tail
; call the IR rewrites into a jump does not fire through the `let`
; here, so the frames were real.
;
; It presented the way this ceiling always presents - as an unrelated
; change tipping something over. Adding one alias entry per imported
; constructor (`addQualified`) lengthened the table, and stage2 then
; died of SIGSEGV compiling its own source, in a build without `opt`
; to eliminate the frames. `lldb` named it in one backtrace: 25 frames
; of `codegen$lookupByIdx`, and `Vec$vecGet` on top of them holding
; the address that had run off the stack.
(pub :: lookupByIdx (-> Int String Int Int Int))
(pub fn (lookupByIdx types name nLen i)
  (let ((mut k i) (mut found 0))
    {
      (while (&& (< k (vecLen types)) (== found 0))
        {
          (let ((e (vecGet types k)))
            (if (&& (== (eNameLen e) nLen) (strEq (eName e) name))
                (set found e)
                0))
          (set k (+ k 1))
        })
      found
    }))

; ------------------------------------------------------------------
; The effect registry: what a `handle` installs into and what an
; operation dispatches through.
;
; One entry per declared effect and one per operation, both carrying
; the same SLOT - the mutable global holding that effect's innermost
; evidence record. The name is the one written in source, because
; `mangleDecl` rewrites only `fn` and `::` declarations: an imported
; `(effect Console ...)` keeps its bare name, and the declaration's
; module word is the only thing that says where it came from. That is
; also why the slot, not the name, is the identity - two modules may
; each declare a `Console`, and stage0 keys their slots by
; (name, module), so they are two globals rather than one shared one.
; ------------------------------------------------------------------
(pub struct EffEnt (name : String) (slot : String) (isEntry : Int))
(pub :: effName (-> Int String))    (pub fn (effName e) (memGetWord e 0))
(pub :: effSlot (-> Int String))    (pub fn (effSlot e) (memGetWord e 1))
(pub :: effIsEntry (-> Int Int)) (pub fn (effIsEntry e) (memGetWord e 2))

; stage0's `effect_slot_name`: `__axiom_ev_` over the mangled effect
; name, so an entry-file `Console` is `__axiom_ev_Console` and an
; imported one `__axiom_ev_M$Console`.
(pub :: effSlotFor (-> String a String))
(pub fn (effSlotFor name modName)
  (if (== (cast Int modName) 0)
      (cat2 "__axiom_ev_" name)
      (cat4 "__axiom_ev_" (cast String modName) "$" name)))

; Entry file first, then whatever module defines it - the resolution
; rule every other bare-name lookup in this compiler uses. A first
; match alone would let an import outrank the file being compiled.
(pub :: lookupEff (-> Int String Int))
(pub fn (lookupEff tbl name)
  (let ((e (lookupEffIn tbl name 1 0)))
    (if (!= e 0) e (lookupEffIn tbl name 0 0))))

(pub :: lookupEffIn (-> Int String Int Int Int))
(pub fn (lookupEffIn tbl name entryOnly i)
  (if (>= i (vecLen tbl))
      0
      (let ((e (vecGet tbl i)))
        (if (&& (strEq (effName e) name)
                (|| (== entryOnly 0) (== (effIsEntry e) 1)))
            e
            (lookupEffIn tbl name entryOnly (+ i 1))))))

; The registry entry a bare name reaches, asked from the module the
; reference sits in - `mangledFor`'s rule, applied to effects. A name
; the module does not declare falls through to `lookupEff`, so this
; only ever prepends a candidate.
(pub :: lookupEffFor (-> Int Int String Int))
(pub fn (lookupEffFor cg tbl name)
  (let ((m (memGetWord cg 34)))
    (let ((local (if (== m 0)
                     0
                     (lookupEffIn tbl (cat3 m "$" name) 0 0))))
      (if (!= local 0)
          local
          (lookupEff tbl name)))))

(pub :: effSlotRegistered (-> Int String Int Bool))
(pub fn (effSlotRegistered tbl slot i)
  (if (>= i (vecLen tbl))
      false
      (if (strEq (effSlot (vecGet tbl i)) slot)
          true
          (effSlotRegistered tbl slot (+ i 1)))))

; ------------------------------------------------------------------
; CG state: output buffer + temp counter + last result + type registry.
; Field 0 = lines (Vec of Str)
; Field 1 = tmp (Int, register counter)
; Field 2 = result (Str, current result value)
; Field 3 = types (Vec of TypeEntry, constructor/struct registry)
; Field 4 = tagN (Int, next data constructor tag)
; Field 5 = argVec (Vec of Int, temp storage during EApp flattening)
; Field 6 = symnames (Vec of Int, symbol table — bound variable names)
; Field 7 = symregs (Vec of Int, symbol table — bound variable register strings)
; Field 8 = decls (Int, module declarations for re-scanning before emit)
; Field 9 = argsTyped (Str, argument list with a type before each entry)
;
; Two argument spellings are needed because LLVM writes the type once for
; a binary operator and once per operand for a call:
;
;     add i64 %a, %b          <- field 2, bare
;     call i64 @f(i64 %a, i64 %b)   <- field 9, typed
;
; Emitting the bare form into a call produced `call i64 @add(i64 40, 2)`,
; which `llc` rejects.
; ------------------------------------------------------------------
; Field 10 = strings (Vec of Str, the module's interned literals)
; Field 11 = curBlock (Str, the label currently being emitted into)
; Field 12 = mangleBares (Vec of Str, bare function names, see mangledFor)
; Field 13 = mangleFulls (Vec of Str, the symbol each bare name reaches)
;
; Floats are carried as the i64 of their IEEE-754 bits, so nothing about
; a *value* says it is a float - only the signatures do, and by emission
; time there is no type checker left to ask. Fields 14-18 are the
; reconstruction (the same one stage0's IR generator performs): what the
; signatures said, and the float-ness of the result currently in field 2,
; which is what decides `add` against `fadd` at each operator.
;
; Field 14 = resultIsFloat (Int 0/1, float-ness of field 2's value)
; Field 15 = floatSigs (Vec of FSig, per-function arrow-position flags)
; Field 16 = symfloats (Vec of 0/1, parallel to fields 6/7)
; Field 17 = curParams (Vec of Str, parameter names of the function being emitted)
; Field 18 = curFlags (Vec of 0/1 from this function's own signature, 0 if it has none)
; Field 19 = macros (Vec of D_MACRO nodes: name, param names, template)
; Field 20 = symkinds (Vec of 0/1 parallel to fields 6/7/16: 0 = the
;            register IS the value, 1 = the register is an alloca and
;            every read is a load - which is what lets `set` store and
;            `while` observe the store on the next trip)
; Field 21 = pendingLams (Vec of lifted-lambda descriptors, emitted as
;            top-level functions after the function that created them
;            closes - a lambda body cannot be emitted mid-function into
;            a line buffer that is one flat stream)
; Field 22 = lamN (Int, fresh `_lam_N` name counter)
; Field 23 = thunkFulls (Vec of Str, mangled names needing a forwarding
;            thunk; index in this Vec is the thunk's number)
; Field 24 = thunkArities (Vec of Int, parallel to 23)
; Field 25 = thunksEmitted (Int, how many of field 23's thunks have
;            been written out, so a later drain does not define one
;            twice)
; Field 26 = target (Int code, see `targetCode`; what the syscall asm,
;            allocator numbers, and triple are emitted for)
; Field 32 = effDecls (Vec of EffEnt, one per declared effect: what a
;            `handle` naming it installs into, and what the evidence
;            globals are emitted from)
; Field 33 = effOps (Vec of EffEnt, one per operation of every declared
;            effect, carrying that effect's slot: what a call to the
;            operation dispatches through)
;
; Both are APPENDED rather than inserted. Every reader of this record
; indexes by position, so a field that moves corrupts whatever now
; sits at its old index - which is exactly how the unit table broke
; when `TC` grew (docs/self-hosting.md).
; Field 34 = curModule (Str, the module whose declaration is being
;            emitted, or 0 for the entry file; `mangledFor` resolves a
;            bare reference to that module's own definition first)
; Field 35 = dataTyNames (Vec of Str, every declared data TYPE name -
;            the registry's rows are per-CONSTRUCTOR, so `Maybe` in a
;            field's declared type finds nothing there; this Vec is
;            what MM-LIFE-2d's field classifier asks. Bare names only:
;            a module-qualified type spelling in a field position
;            classifies as unknown and the block stays a leaf, which
;            under-reclaims and never over-frees)
; Field 36 = curDeclNode (the top-level declaration being emitted;
;            an evidence stamp names its author, and `evStampOk`
;            refuses a stamp another declaration wrote - a
;            macro-spliced argument node is a shared object)
(pub struct CG (lines : Int) (tmp : Int) (result : String) (types : Int) (tagN : Int) (argVec : Int) (symnames : Int) (symregs : Int) (decls : Int) (argsTyped : String) (strings : Int) (curBlock : String) (mangleBares : Int) (mangleFulls : Int) (resultIsFloat : Int) (floatSigs : Int) (symfloats : Int) (curParams : Int) (curFlags : Int) (macros : Int) (symkinds : Int) (pendingLams : Int) (lamN : Int) (thunkFulls : Int) (thunkArities : Int) (thunksEmitted : Int) (target : Int) (tcoName : Int) (tcoSlots : Int) (tcoLabel : String) (tailOK : Int) (terminated : Int) (effDecls : Int) (effOps : Int) (curModule : Int) (dataTyNames : Int) (curDeclNode : Int) (sigIntern : Int) (sigById : Int) (bareIntern : Int) (bareFirst : Int) (tailRetain : Int) (pendingOwned : Int) (allocaMark : Int) (hoisted : Int))

; ------------------------------------------------------------------
; Tail-call optimisation, fields 27-31.
;
; A self tail call becomes parameter reassignment plus a branch back to
; the function's loop header - stage0's rule, and without it a
; self-recursive Axiom function compiled by stage1 is a real call chain
; that overflows the stack where the same source compiled by stage0
; loops forever in constant space. `stdlib/Mem.ax` met that ceiling for
; real: its byte loops were self tail calls, and a `memCopy` of a few
; hundred kilobytes segfaulted a stage1-built compiler.
;
;   tcoName   the symbol this function is being emitted as, or 0 when
;             the body contains no self tail call and none of this
;             applies - which is most functions, and they emit exactly
;             the LLVM they did before.
;   tcoSlots  one alloca register per parameter, in parameter order.
;   tcoLabel  the loop header to branch back to.
;   tailOK    set only for the instant between `emitExprTail` deciding
;             an application sits in tail position and `dispatchCall`
;             reading it. Anything else that emits a call clears it, so
;             a call in argument position can never be rewritten.
;   terminated  the current block already ended with a terminator, so
;             no `br` or `ret` may follow and a phi must not name it as
;             a predecessor.
; ------------------------------------------------------------------

; The constructor tag counter starts at 2, not 0: stage0's tag is the
; ordinal position in a flat walk of every data type the type checker
; collected, and the builtin `Option` walks first, so the first
; user-declared constructor is 2. Tags only ever meet tags from the
; same scheme, but the two stages must still agree whenever a program
; lets one escape (probed: stage0 gives the first user constructor 2).
;
; `Some` is 0 and `None` is 1, not the other way round - this comment
; used to say the reverse. Probed directly against stage0:
; `(cast Int (None))` exits 1, and `(__load64 (cast Int (Some 7)) 0)`
; - the tag word of the heap block - is 0.
;
; The registry is SEEDED with both, because `Option` is builtin and so
; has no declaration for `scanCtors` to walk. Without the seed a match
; on `(Some x)` found no entry, bound nothing, and emitted
; `store i64 %x` naming a register that does not exist - invalid IR
; that llc refused (tests/stdlib/270-nullary-unboxed.ax). Its
; representation is 2, mixed: `None` is an immediate tag and `Some` a
; heap block, which is exactly the case the `< 4096` runtime test
; exists for.
(pub :: newCG Int)
(pub fn (newCG)
  (let ((ts vecNew))
    {
      (addTypeNamed ts "Some" TF_DATA 1 0 2
                    (let ((f vecNew)) { (vecPush f 0) f })
                    0
                    (let ((ft vecNew)) { (vecPush ft (cast Int (mkTVar "a"))) ft }))
      (addType ts "None" TF_DATA 0 1 2 vecNew)
      (CG vecNew 0 "" ts 2 vecNew vecNew vecNew 0 "" vecNew "entry" vecNew vecNew 0 vecNew vecNew 0 0 vecNew vecNew vecNew 0 vecNew vecNew 0 0 0 vecNew "" 0 0 vecNew vecNew 0 vecNew 0 0 vecNew 0 vecNew vecNew vecNew (- 0 1) vecNew)
    }))

(pub :: zeroFloat (-> Int Int))
(pub fn (zeroFloat cg)
  {
    (memSetWord cg 14 0)
    cg
  })

; ------------------------------------------------------------------
; Per-function float signatures, keyed by the (mangled) defined name.
; `flags` is one 0/1 per arrow position, return type last - the shape
; `sigFloatFlags` in the parser produces.
; ------------------------------------------------------------------
; `sigTy` is the D_SIG's parsed type tree (node word 6) - the SAME
; object the checker walked, which is what keeps MM-LIFE-2d's
; evidence ordering agreed between the phases without a protocol.
; `owned` is MM-LIFE-2c's ownership of the function's RESULT, inferred
; by `inferOwnership` below: 1 when every value the body can answer
; carries a share of its own (a construction, a static, an allocation,
; the result of another owned-result function), 0 when some path
; answers a share the frame only borrowed (a parameter, a field, a
; match binder, a raw load). Event 2 retains the result of a
; reference-returning function exactly when this is 0.
(pub struct FSig (name : String) (nameLen : Int) (flags : Int) (sigTy : Int) (takesEv : Int) (owned : Int) (arity : Int) (stash : Int) (ret : Int))

(pub :: scanFloatSigs (-> Int Int Int Int))
(pub fn (scanFloatSigs decls sigs i)
  (if (>= i (vecLen decls))
      sigs
      {
        (let ((d (vecGet decls i)))
          (if (== (nodeTag d) TAG_D_SIG)
              (vecPush sigs (cast Int (FSig (nodeA d) (strLen (nodeA d)) (nodeB d) (nodeTy d)
                                            (cgTakesEvidence (nodeTy d)) 1 (- 0 1) 0 0)))
              ; an `extern` item is a signed global under its LINKER
              ; SYMBOL (what `mangledForCg` answers for its name), with
              ; the masks the boundary contract gives it: a Rust shim
              ; BORROWS every argument for the call (docs/ffi.md, C1 -
              ; a shim that keeps one takes its own share with
              ; `axiom_retain`) and answers a fresh word or a share of
              ; its own, so it parks nothing and answers nothing of
              ; what it was handed. Without an entry every extern
              ; call parked every argument, and a `Counter` cell
              ; handed to `counterValueRaw` never died
              (if (== (nodeTag d) TAG_D_EXTERN)
                  (scanExternSigs (nodeC d) sigs 0)
                  0)))
        (scanFloatSigs decls sigs (+ i 1))
      }))

(pub :: scanExternSigs (-> Int Int Int Int))
(pub fn (scanExternSigs items sigs i)
  (if (== items 0)
      0
      (if (>= i (vecLen items))
          0
          (let ((f (vecGet items i)))
            {
              (if (== (nodeB f) 0)
                  0
                  (vecPush sigs (cast Int (FSig (nodeC f) (strLen (nodeC f)) 0 (nodeB f)
                                                0 1 (arrowArity (nodeB f)) 0 0))))
              (scanExternSigs items sigs (+ i 1))
            }))))

(pub :: findFSig (-> Int String Int))
(pub fn (findFSig sigs name)
  (let ((n (declSpellingOf name)))
    (findFSigIn sigs n (strLen n) 0)))

(pub :: findFSigIn (-> Int String Int Int Int))
(pub fn (findFSigIn sigs name nl i)
  (if (>= i (vecLen sigs))
      0
      (let ((e (vecGet sigs i)))
        (if (&& (== (memGetWord e 1) nl) (strEq (memGetWord e 0) name))
            e
            (findFSigIn sigs name nl (+ i 1))))))

; The signature table and the mangle map, indexed. `findFSig` and
; `mangledFor` are linear scans - 1,700 signatures, 1,600 bares - and
; were asked a few times per function; the ownership questions below
; ask them at every call site, several times, and a self-compile went
; from 2.8 s to 5.0 s on the scans alone. Built once in
; `emitResolved`, after every `mangleRecord` has run.
(pub :: buildNameIndexes (-> Int Int))
(pub fn (buildNameIndexes cg)
  (let ((sigs (memGetWord cg 15))
        (si internNew)
        (byId vecNew)
        (bares (memGetWord cg 12))
        (bi internNew)
        (first vecNew))
    {
      (let ((mut i 0))
        (while (< i (vecLen sigs))
          {
            (let ((e (vecGet sigs i)))
              (let ((id (internIntern si (memGetWord e 0))))
                (if (== id (vecLen byId)) (vecPush byId e) 0)))
            (set i (+ i 1))
          }))
      (let ((mut j 0))
        (while (< j (vecLen bares))
          {
            (let ((id (internIntern bi (vecGet bares j))))
              (if (== id (vecLen first)) (vecPush first j) 0))
            (set j (+ j 1))
          }))
      (memSetWord cg 37 si)
      (memSetWord cg 38 byId)
      (memSetWord cg 39 bi)
      (memSetWord cg 40 first)
      cg
    }))

; `findFSig` through the index; the linear scan when no index has
; been built (the REPL's and LSP's partial paths).
(pub :: findFSigCg (-> Int String Int))
(pub fn (findFSigCg cg name)
  (let ((si (memGetWord cg 37)))
    (if (== si 0)
        (findFSig (memGetWord cg 15) name)
        (let ((id (internFind si (declSpellingOf name))))
          (if (< id 0) 0 (vecGet (memGetWord cg 38) id))))))

; `mangledFor` through the index: the same answer, the module-local
; spelling first, then the first bare record, then the name itself.
(pub :: mangledForCg (-> Int String String))
(pub fn (mangledForCg cg name)
  (let ((bi (memGetWord cg 39)))
    (if (== bi 0)
        (mangledFor cg name)
        (if (strEq name "main")
            "__axiom_user_main"
            (let ((m (memGetWord cg 34)))
              (let ((hit (if (== (cast Int m) 0)
                             (- 0 1)
                             (internFind bi (cat3 m "$" name)))))
                (if (>= hit 0)
                    (cat3 m "$" name)
                    (let ((id (internFind bi name)))
                      (if (< id 0)
                          name
                          (vecGet (memGetWord cg 13)
                                  (vecGet (memGetWord cg 40) id)))))))))))

; A signed function's parameter count, recorded by `inferOwnership`
; from its definition; -1 for a name with no signature or no body.
(pub :: fnArityCg (-> Int String Int))
(pub fn (fnArityCg cg name)
  (let ((e (findFSigCg cg (mangledForCg cg name))))
    (if (== e 0) (- 0 1) (memGetWord e 6))))

; ------------------------------------------------------------------
; MM-LIFE-2c events 2 and 3, made exact: WHO OWNS A RESULT.
;
; The memory model records the pair - retain a reference result
; before every return, release a `let` bound to such a call - as
; built, measured at 285 retains for 8 releases, and declined. The
; version measured retained EVERY tail that was not a direct
; construction, and that is where the 285 came from: a string built
; by `strConcat`, returned through a `let` or a `cast`, is born at
; count 1 and was retained to 2, and the one share a caller could
; ever hand back left it at 1 forever. Retaining what is already owned
; is the leak; not retaining what is borrowed is the dangle. The pair
; is sound and cheap only if the emitter can tell the two apart, and
; it can, by asking the same question of every function in the program
; and iterating to a fixpoint:
;
;   a result is OWNED when every tail the body can answer is a direct
;   construction, a literal (statics are immortal), a lambda, an
;   `__alloc`, a word, or a call to a function whose result is owned;
;   `cast` answers its operand's ownership; a `let`-bound name answers
;   its initialiser's; a `match` binder, a parameter, a field read, a
;   raw load, a local function value's answer, an effect operation's
;   answer are BORROWED.
;
; The fixpoint is the GREATEST one - every function starts owned and
; loses it when a path shows otherwise - so recursion through an
; owned-result function stays owned, which is the truth: a value
; reached through the cycle is produced at its end.
;
; With that, event 2 retains a reference-class result iff the function
; is not owned (`borrowedTailLeaves`), so every reference-returning global
; hands its caller exactly one share; event 3 releases a `let` bound
; to any such call or construction (`valueOwnedRef`), not only to a
; direct construction; an owned value discarded in statement position
; is released on the spot; and an owned value passed to a global whose
; result class is known, or stored into a constructor's or struct's
; reference field, is released once the callee or the store has taken
; its own share (`releaseOwnedArgs`, `emitFieldStores`, `emitSetF`).
; Words are never released - a `release` on an integer that is not a
; handle is a wild read - so everything here is gated on the declared
; result or field class being a reference (`fldClass` 2).
;
; What stays leaked, deliberately: a temporary passed to a primitive,
; a `cast`, a local function value, or a function whose result is a
; type variable (none of those retains what it is handed back);
; a `match` scrutinee built in place; a temporary stored through
; `set`. Each is the leak direction, and each is narrower than the
; old rule's "everything not bound to a direct construction".
; ------------------------------------------------------------------
(pub :: inferOwnership (-> Int Int Int))
(pub fn (inferOwnership cg decls)
  (if (== (inferOwnershipPass cg decls 0 0) 0)
      { (memSetWord cg 34 0) (memSetWord cg 36 0) }
      (inferOwnership cg decls)))

; One pass: recompute every signed function; answer 1 if any flag
; moved (always 1 -> 0, so the loop terminates).
(pub :: inferOwnershipPass (-> Int Int Int Int Int))
(pub fn (inferOwnershipPass cg decls i changed)
  (if (>= i (vecLen decls))
      changed
      (let ((d (vecGet decls i)))
        (if (!= (nodeTag d) TAG_D_FN)
            (inferOwnershipPass cg decls (+ i 1) changed)
            ; the body's bare references resolve in the module that
            ; wrote it - a private sibling has no bare-map entry and
            ; is reachable only as `Mod$name` (`emitModuleTail` sets
            ; the same word for the same reason)
            (let ((_m (memSetWord cg 34 (nodeModule d)))
                  (_d (memSetWord cg 36 d))
                  (e (findFSigCg cg (nodeA d))))
              (if (== e 0)
                  (inferOwnershipPass cg decls (+ i 1) changed)
                  (if (== (memGetWord e 5) 0)
                      (inferOwnershipPass cg decls (+ i 1) changed)
                      (if (== (let ((_a (memSetWord e 6 (vecLen (nodeB d)))))
                                (tailOwned cg (nodeC d) (nodeB d) vecNew))
                              1)
                          (inferOwnershipPass cg decls (+ i 1) changed)
                          {
                            (memSetWord e 5 0)
                            (inferOwnershipPass cg decls (+ i 1) 1)
                          }))))))))

; The ownership of the named global's result under the current
; assumption: 0 when it has no signature, which is also what a local,
; a constructor-less head and an effect operation answer.
(pub :: fnResultOwned (-> Int String Int))
(pub fn (fnResultOwned cg name)
  (let ((e (findFSigCg cg (mangledForCg cg name))))
    (if (== e 0) 0 (memGetWord e 5))))

; Is every value `e` can answer owned? `params` are the enclosing
; function's parameters; `env` is a flat name/flag vector of the
; `let` bindings and match binders in scope.
(pub :: tailOwned (-> Int Int Int Int Int))
(pub fn (tailOwned cg e params env)
  (if (== e 0)
      1
      (let ((tg (nodeTag e)))
        (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR)
            (|| (== tg TAG_E_CHAR) (== tg TAG_E_LAM)))))
            1
        (if (== tg TAG_E_VAR)
            (let ((k (envFlagOf env (nodeA e))))
              (if (>= k 0)
                  k
                  (if (>= (paramIndexIn params (nodeA e) 0) 0)
                      0
                      ; a nullary constructor is an immediate: owned,
                      ; and releasing it is a no-op
                      (if (!= (lookupType (memGetWord cg 3) (nodeA e)) 0)
                          1
                          ; a bare global name: a nullary function's
                          ; answer, or a function value - the former by
                          ; its own flag, the latter a record of its own
                          (fnResultOwned cg (nodeA e))))))
        (if (== tg TAG_E_FIELD)
            0
        (if (== tg TAG_E_APP)
            (tailOwnedApp cg e params env)
        (if (== tg TAG_E_IF)
            (if (== (tailOwned cg (nodeB e) params env) 1)
                (tailOwned cg (nodeC e) params env)
                0)
        (if (== tg TAG_E_COND)
            (if (== (tailOwnedClauses cg (nodeA e) params env 0) 1)
                (tailOwned cg (nodeB e) params env)
                0)
        (if (== tg TAG_E_MATCH)
            (tailOwnedArms cg (nodeB e) params env 0)
        (if (== tg TAG_E_BEGIN)
            (if (== (vecLen (nodeA e)) 0)
                1
                (tailOwned cg (vecGet (nodeA e) (- (vecLen (nodeA e)) 1)) params env))
        (if (== tg TAG_E_LET)
            (tailOwned cg (nodeC e) params
                       (envWith env (nodeA e) (tailOwned cg (nodeB e) params env)))
        (if (== tg TAG_E_LETM)
            ; a mutable slot may be reassigned to anything
            (tailOwned cg (nodeC e) params (envWith env (nodeA e) 0))
        (if (== tg TAG_E_SET)
            ; `(set k v)` evaluates to `v`, as owned as `v` is
            (tailOwned cg (nodeB e) params env)
        (if (|| (== tg TAG_E_WHILE)
            (|| (== tg TAG_E_SETF) (== tg TAG_E_STRUCTCON)))
            ; words, and a keyword construction born at count 1
            1
        (if (== tg TAG_E_ALLOC)
            ; `(alloc T n)` is raw memory at count 0 - see `__alloc`
            0
            0))))))))))))))))

; An application's ownership, by its head.
(pub :: tailOwnedApp (-> Int Int Int Int Int))
(pub fn (tailOwnedApp cg e params env)
  (let ((hd (spineHead e)))
    (if (!= (nodeTag hd) TAG_E_VAR)
        0
        (let ((n (nodeA hd)))
          (if (isCastName n)
              ; `(cast T v)`: v's ownership, v being the second
              ; argument of the flattened spine
              (if (>= (spineArity e) 2)
                  (tailOwned cg (spineArgAt e 1) params env)
                  0)
          (if (|| (strEq n "sizeof") (strEq n "alignof"))
              1
          (if (isBinop n)
              ; arithmetic on a word of a borrowed reference is still
              ; that reference, laundered: owned iff every operand is
              (tailOwnedArgsAll cg e (spineArity e) params env 0)
          (if (|| (isCmpOp n) (isAndOr n))
              1
          (if (isPrimName n)
              ; a static's address and a converted number are words;
              ; a load answers what some block holds; and a FRESH
              ; ALLOCATION is born at count 0 - free-floating, owned
              ; by nobody until a store takes the first share - so a
              ; reference-class function answering one must ADOPT it
              ; (event 2's retain takes it to 1), which is why it
              ; answers 0 here rather than 1. A constructor
              ; expression is the one birth at count 1 (`A1` in
              ; `emitConstructor`); every `String` comes through
              ; `__alloc`.
              (if (|| (strEq n "__load64")
                  (|| (strEq n "__load8")
                  (|| (strEq n "__argv") (strEq n "__alloc"))))
                  0
                  1)
          (if (|| (>= (envFlagOf env n) 0) (>= (paramIndexIn params n 0) 0))
              ; a local function value: no signature, no event 2
              0
          (if (!= (findFSigCg cg (mangledForCg cg n)) 0)
              ; a reference-returning global answers ONE share by
              ; construction - it retains a borrowed tail itself - so
              ; its flag is its own business; a word-returning one or a
              ; type-variable one answers what its tails answer
              (if (== (fnResultClass cg n) 2) 1 (fnResultOwned cg n))
              (if (!= (lookupType (memGetWord cg 3) n) 0)
                  1
                  0))))))))))))

(pub :: tailOwnedArgsAll (-> Int Int Int Int Int Int Int))
(pub fn (tailOwnedArgsAll cg e n_ params env i)
  (if (>= i n_)
      1
      (if (== (tailOwned cg (spineArgAt e i) params env) 1)
          (tailOwnedArgsAll cg e n_ params env (+ i 1))
          0)))

(pub :: tailOwnedClauses (-> Int Int Int Int Int Int))
(pub fn (tailOwnedClauses cg cls params env i)
  (if (>= i (vecLen cls))
      1
      (if (== (tailOwned cg (nodeB (vecGet cls i)) params env) 1)
          (tailOwnedClauses cg cls params env (+ i 1))
          0)))

(pub :: tailOwnedArms (-> Int Int Int Int Int Int))
(pub fn (tailOwnedArms cg arms params env i)
  (if (>= i (vecLen arms))
      1
      (let ((arm (vecGet arms i)))
        (let ((bs (patBindersCg (nodeA arm) vecNew)))
          (if (== bs 0)
              0
              (if (== (tailOwned cg (nodeB arm) params (envWithAll env bs 0)) 1)
                  (tailOwnedArms cg arms params env (+ i 1))
                  0))))))

; The spine's argument count and i-th argument, WITHOUT building a
; vector: the flow walks below run over every application several
; times per fixpoint pass, and a vector per visit was 60 MB of a
; self-compile in an arena that never frees.
(pub :: spineArity (-> Int Int))
(pub fn (spineArity e)
  (if (== (nodeTag e) TAG_E_APP) (+ 1 (spineArity (nodeA e))) 0))

(pub :: spineArgAt (-> Int Int Int))
(pub fn (spineArgAt e i)
  (spineArgFromEnd e (- (- (spineArity e) 1) i)))

(pub :: spineArgFromEnd (-> Int Int Int))
(pub fn (spineArgFromEnd e k)
  (if (<= k 0) (nodeB e) (spineArgFromEnd (nodeA e) (- k 1))))

; The flat name/flag environment: innermost binding wins, -1 when
; the name is not bound.
(pub :: envFlagOf (-> Int String Int))
(pub fn (envFlagOf env name)
  (envFlagFrom env name (- (vecLen env) 2)))

(pub :: envFlagFrom (-> Int String Int Int))
(pub fn (envFlagFrom env name i)
  (if (< i 0)
      (- 0 1)
      (if (strEq (cast String (vecGet env i)) name)
          (cast Int (vecGet env (+ i 1)))
          (envFlagFrom env name (- i 2)))))

(pub :: envWith (-> Int String Int Int))
(pub fn (envWith env name flag)
  (let ((v (vecAppendFrom env vecNew 0)))
    { (vecPush v (cast Int name)) (vecPush v flag) v }))

; The arms' binders with their flows: a binder of a REFERENCE field
; carries the scrutinee's flow (the field is storage the block owns);
; a binder of a SCALAR field carries nothing - `(ICons x r)`'s `x` is
; a number, and a function summing it answered "a word of the list",
; so no caller ever released one.
(pub :: envWithPat (-> Int Int Int Int Int))
(pub fn (envWithPat cg env pat flag)
  (let ((v (vecAppendFrom env vecNew 0)))
    { (envPushPat cg v pat flag) v }))

(pub :: envPushPat (-> Int Int Int Int Int))
(pub fn (envPushPat cg v pat flag)
  (if (== pat 0)
      0
      (let ((tag (nodeTag pat)))
        (if (== tag TAG_E_VAR)
            { (vecPush v (cast Int (nodeA pat))) (vecPush v flag) 0 }
        (if (== tag TAG_E_APP)
            (let ((hd (spineHead pat)))
              (let ((entry (if (== (nodeTag hd) TAG_E_VAR)
                               (lookupType (memGetWord cg 3) (nodeA hd))
                               0)))
                (envPushPatArgs cg v pat (spineArity pat) entry flag 0)))
        (if (== tag TAG_P_CONNAMED)
            (envPushPatVec cg v (nodeC pat) flag 0)
            0))))))

(pub :: envPushPatArgs (-> Int Int Int Int Int Int Int Int))
(pub fn (envPushPatArgs cg v pat n_ entry flag i)
  (if (>= i n_)
      0
      (let ((tn (if (== entry 0) 0 (fieldTypeNode entry i))))
        (let ((f (if (== tn 0) flag (if (== (fldClass cg tn) 0) 0 flag))))
          { (envPushPat cg v (spineArgAt pat i) f)
            (envPushPatArgs cg v pat n_ entry flag (+ i 1)) }))))

(pub :: envPushPatVec (-> Int Int Int Int Int Int))
(pub fn (envPushPatVec cg v subs flag i)
  (if (== subs 0)
      0
      (if (>= i (vecLen subs))
          0
          { (envPushPat cg v (vecGet subs i) flag)
            (envPushPatVec cg v subs flag (+ i 1)) })))

(pub :: envWithAll (-> Int Int Int Int))
(pub fn (envWithAll env names flag)
  (let ((v (vecAppendFrom env vecNew 0)))
    (envPushAll v names flag 0)))

(pub :: envPushAll (-> Int Int Int Int Int))
(pub fn (envPushAll v names flag i)
  (if (>= i (vecLen names))
      v
      { (vecPush v (vecGet names i)) (vecPush v flag) (envPushAll v names flag (+ i 1)) }))

; ------------------------------------------------------------------
; WHERE AN ARGUMENT GOES: the parameter-escape half of the model.
;
; A caller may hand back a temporary's share after a call, and a
; `let` may release its block after passing it to a callee, only if
; the callee kept nothing of it that counting did not see. The stores
; counting sees are the reference-typed ones (events 5 and 6,
; `memSetWord`'s `__retainref`). The ones it cannot see are the
; erasures: a value parked in a field declared `Int` through a
; `cast`, in a mutable slot through `set`, in raw memory through
; `__store64`, in a closure's record, or handed on to a callee that
; does one of those - `mkDiag` parks its message through
; `(cast Int msg)` in an `Int`-declared field, and the first draft of
; this released the message right after the call. Retaining at every
; `cast` instead was measured and rejected: `strLen` and `strData` are
; casts, and every string in the compiler grew a share per read.
;
; So each signed function carries two masks over its parameters:
; STASH - the parameters some part of whose reference the body parks
; beyond the frame uncounted; RET - the parameters whose reference
; may be (part of) a WORD the function answers, for a function whose
; result is not itself a counted reference. Both are least fixpoints
; over the call graph: a call to `g` stashes what `g` stashes, and
; answers what `g` answers.
;
; TWO FORMS. A reference reaches a callee either typed - a `String`
; parameter, which `memSetWord`'s `__retainref` will count before
; storing - or already laundered to a WORD by `cast`, `strData`,
; `strOwner`, `__addr` or arithmetic on one of those, which no witness
; retains. `(memSetWord m 0 (cast Int s))` parks `s` uncounted where
; `(memSetWord m 0 s)` does not. So every flow mask, and every
; summary, has two halves: bits 0-29 for "parameter i as it arrived",
; bits 30-59 for "a word of parameter i, laundered here". A summary's
; word half says what happens to a parameter that ARRIVES as a word;
; its arrival half, to one that arrives typed. A `__retainref` of a
; parameter cancels its arrival-half stash only - the witness for a
; word is `Int`, and retains nothing. The refutation pass found both
; holes the single-form draft had: the cancel trusted blindly, and
; `(+ (cast Int s) 0)` dropping `s` at the operator.
; ------------------------------------------------------------------
(pub :: inferFlows (-> Int Int Int))
(pub fn (inferFlows cg decls)
  (if (== (inferFlowsPass cg decls 0 0) 0)
      { (memSetWord cg 34 0) (memSetWord cg 36 0) }
      (inferFlows cg decls)))

(pub :: inferFlowsPass (-> Int Int Int Int Int))
(pub fn (inferFlowsPass cg decls i changed)
  (if (>= i (vecLen decls))
      changed
      (let ((d (vecGet decls i)))
        (if (!= (nodeTag d) TAG_D_FN)
            (inferFlowsPass cg decls (+ i 1) changed)
            (let ((_m (memSetWord cg 34 (nodeModule d)))
                  (_d (memSetWord cg 36 d))
                  (e (findFSigCg cg (nodeA d))))
              (if (== e 0)
                  (inferFlowsPass cg decls (+ i 1) changed)
                  (let ((cell (regionNew)))
                    {
                      (flowStashes cg (nodeC d) (nodeB d) vecNew cell)
                      ; MM-LIFE-2g's own stores: a parameter the body
                      ; handed to `__retainref` is COUNTED before it
                      ; is parked - when it arrived typed. `__retain`
                      ; counts the word it is given whatever its form.
                      ; A summary's word half always contains its
                      ; arrival half: what parks a typed reference
                      ; uncounted parks a word too. The count pairs
                      ; with the stash only on the paths it runs on:
                      ; `regionNet` nets each branch's stashes against
                      ; the counts of that branch and its enclosing
                      ; regions, never a sibling's.
                      (let ((st0 (| (regionNet cell) (tyvarSlotsMask cg e d))))
                      (let ((st (| (memGetWord e 7) (| st0 (arrivalToWord st0))))
                            (rt (| (memGetWord e 8)
                                   (flowMask cg (nodeC d) (nodeB d) vecNew))))
                        (if (&& (== st (memGetWord e 7)) (== rt (memGetWord e 8)))
                            (inferFlowsPass cg decls (+ i 1) changed)
                            {
                              (memSetWord e 7 st)
                              (memSetWord e 8 rt)
                              (inferFlowsPass cg decls (+ i 1) 1)
                            })))
                    })))))))

; A self-tail-calling function's TYPE-VARIABLE and `Int` parameters,
; every form: the loop's slot for such a parameter takes no retain
; (a type variable's class is decided by evidence the boundary does
; not consult; a word is a word), so an argument handed to it is
; parked uncounted - a `let`'s temporary paid at the jump was freed
; under the slot, and `(l1 s (asWord t) (- n 1))` handed the slot a
; pointer into `t`. Parked, the walk keeps it; the leak is the safe
; direction until the boundary retains by evidence.
(pub :: tyvarSlotsMask (-> Int Int Int Int))
(pub fn (tyvarSlotsMask cg e d)
  (if (== (tailCallsSelf (nodeC d) (bareOf (nodeA d)) (vecLen (nodeB d))) 1)
      (tyvarSlotsFrom cg (memGetWord e 3) (vecLen (nodeB d)) 0)
      0))

(pub :: tyvarSlotsFrom (-> Int Int Int Int Int))
(pub fn (tyvarSlotsFrom cg sigTy n i)
  (if (>= i n)
      0
      (| (let ((cls (fldClass cg (arrowParamTy sigTy i))))
           ; an `Int` slot: a word of a binding handed to it is
           ; parked there uncounted, and the binding must outlive the
           ; jump; a type-variable slot is retained by evidence, so
           ; only a WORD arriving there is parked (the weak bits)
           (if (== cls 0)
               (bothForms (paramBit i))
               (if (== cls 1)
                   (wordBit i)
                   0)))
         (tyvarSlotsFrom cg sigTy n (+ i 1)))))

; The encoding: THREE forms of parameter i, twenty parameters per
; form (i >= 19 share bit 19).
;
;   bit i        ARRIVAL - parameter i as it came: a typed reference,
;                or a type-variable value of whatever kind
;   bit 20 + i   HEADER WORD - the handle laundered into a word by
;                `cast`, `__addr` or arithmetic; an `Int` parameter
;                arrives as one
;   bit 40 + i   OWNER WORD - a pointer into, or to, the block the
;                string's header OWNS: `strData`, `strOwner`, a load
;                of a header word past index 0; an `Int` parameter
;                may be one of these too
;
; A count pairs with a park of the SAME thing: `(__retainref s)` and
; `(__retain (cast Int s))` count the header and license a park of
; the header (bit i, bit 20+i); `(__retain (strOwner s))` counts the
; owner and licenses a park of the owner (bit 40+i) - `strSlice` and
; `sysReadAll` - and nothing of the header, which two forms could
; not say: the owner's count cancelled a park of the header, and
; `(match o ((Full x) { (__retainref x) (__store64 m 0 (cast Int o))
; 0 }))` freed `o` under the store.
(pub :: paramBit (-> Int Int))
(pub fn (paramBit i)
  (if (< i 0) 0 (if (>= i 19) (<< 1 19) (<< 1 i))))

(pub :: wordBit (-> Int Int))
(pub fn (wordBit i)
  (if (< i 0) 0 (if (>= i 19) (<< 1 39) (<< 1 (+ 20 i)))))

(pub :: ownerBit (-> Int Int))
(pub fn (ownerBit i)
  (if (< i 0) 0 (if (>= i 19) (<< 1 59) (<< 1 (+ 40 i)))))

; All three forms of parameter i.
(pub :: anyBit (-> Int Int))
(pub fn (anyBit i) (| (paramBit i) (| (wordBit i) (ownerBit i))))

(pub :: arrivalPart (-> Int Int))
(pub fn (arrivalPart m) (& m (- (<< 1 20) 1)))

(pub :: wordPart (-> Int Int))
(pub fn (wordPart m) (& m (<< (- (<< 1 20) 1) 20)))

(pub :: ownerPart (-> Int Int))
(pub fn (ownerPart m) (& m (<< (- (<< 1 20) 1) 40)))

; The two word forms together.
(pub :: wordParts (-> Int Int))
(pub fn (wordParts m) (| (wordPart m) (ownerPart m)))

; The arrival third moved to the header-word third.
(pub :: arrivalToWord (-> Int Int))
(pub fn (arrivalToWord m) (<< (arrivalPart m) 20))

; The header-word third moved to the arrival third.
(pub :: wordToArrival (-> Int Int))
(pub fn (wordToArrival m) (>> (wordPart m) 20))

(pub :: ownerToArrival (-> Int Int))
(pub fn (ownerToArrival m) (>> (ownerPart m) 40))

; The parameters `m` mentions in any form, as arrival bits.
(pub :: paramsOf (-> Int Int))
(pub fn (paramsOf m) (| (arrivalPart m) (| (wordToArrival m) (ownerToArrival m))))

; Everything in `m` laundered by `cast`, `__addr` or arithmetic: an
; arrival or a header word becomes a header word; an owner word
; under arithmetic is still a pointer into the owner.
(pub :: toWord (-> Int Int))
(pub fn (toWord m) (| (arrivalToWord m) (wordParts m)))

; Everything in `m` read through `strData`, `strOwner` or a header
; word past index 0: the owner of whatever it was.
(pub :: toOwner (-> Int Int))
(pub fn (toOwner m) (<< (paramsOf m) 40))

; Everything in `m` in every form - what an uncounted park records:
; the parameter is parked however it arrived or was laundered.
(pub :: bothForms (-> Int Int))
(pub fn (bothForms m)
  (let ((ps (paramsOf m)))
    (| ps (| (<< ps 20) (<< ps 40)))))

; The forms a value of flow `m` is parked in, or counted in: a
; header - typed, or as a header word - in both header forms, an
; owner word as the owner. What `__retain` counts and what a raw
; store, a word field or a capture parks.
(pub :: parkForms (-> Int Int))
(pub fn (parkForms m)
  (let ((hp (| (arrivalPart m) (wordToArrival m))))
    (| (| hp (<< hp 20)) (ownerPart m))))

(pub :: fnStashMask (-> Int String Int))
(pub fn (fnStashMask cg name)
  (let ((e (findFSigCg cg (mangledForCg cg name))))
    (if (== e 0) 0 (memGetWord e 7))))

(pub :: fnRetMask (-> Int String Int))
(pub fn (fnRetMask cg name)
  (let ((e (findFSigCg cg (mangledForCg cg name))))
    (if (== e 0) 0 (memGetWord e 8))))

; The mask of parameters whose reference may be (part of) `e`'s
; value, in the form it has here. `env` is a flat name/mask vector
; for `let` bindings and match binders.
(pub :: flowMask (-> Int Int Int Int Int))
(pub fn (flowMask cg e params env)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== tg TAG_E_VAR)
            (let ((k (envFlagOf env (nodeA e))))
              (if (>= k 0)
                  (& k (- MUST_BIT 1))
                  (paramFlowBit cg params (paramIndexIn params (nodeA e) 0))))
        (if (== tg TAG_E_FIELD)
            ; a reference field is storage the base owns - a word of
            ; it is a word of the base; a scalar field is a number
            (if (== (fieldReadIsScalar cg e) 1)
                0
                (flowMask cg (nodeA e) params env))
        (if (== tg TAG_E_APP)
            (flowMaskApp cg e params env)
        (if (== tg TAG_E_IF)
            (| (flowMask cg (nodeB e) params env) (flowMask cg (nodeC e) params env))
        (if (== tg TAG_E_COND)
            (| (flowMaskClauses cg (nodeA e) params env 0) (flowMask cg (nodeB e) params env))
        (if (== tg TAG_E_MATCH)
            (flowMaskArms cg (nodeB e) params env (flowMask cg (nodeA e) params env) 0)
        (if (== tg TAG_E_BEGIN)
            (if (== (vecLen (nodeA e)) 0)
                0
                (flowMask cg (vecGet (nodeA e) (- (vecLen (nodeA e)) 1)) params env))
        (if (== tg TAG_E_LET)
            (flowMask cg (nodeC e) params
                      (envWith env (nodeA e) (letFlag cg (nodeB e) params env)))
        (if (== tg TAG_E_LETM)
            (flowMask cg (nodeC e) params
                      (envWith env (nodeA e) (mutFlag cg (nodeA e) (nodeB e) (nodeC e) params env)))
        (if (== tg TAG_E_HANDLE)
            ; the body's value, or the handler's
            (| (flowMask cg (nodeA e) params env) (flowMask cg (nodeC e) params env))
        (if (== tg TAG_E_SET)
            ; `(set k v)` evaluates to `v`
            (flowMask cg (nodeB e) params env)
            0))))))))))))))

; Parameter i as it arrives: a typed reference or a type variable in
; the arrival form; a parameter declared a machine word (`Int`) is a
; word already - a header word or an owner word, the callee cannot
; tell which, so both - and a witness-directed store of it counts
; nothing (`strWrapOwned`'s `(memSetWord s 1 bytes)` parks `bytes`).
(pub :: paramFlowBit (-> Int Int Int Int))
(pub fn (paramFlowBit cg params i)
  (if (< i 0)
      0
      (let ((d (memGetWord cg 36)))
        (if (== d 0)
            (paramBit i)
            (if (|| (!= (vecLen params) (vecLen (nodeB d)))
                    (if (strEq (cast String (vecGet params i)) (cast String (vecGet (nodeB d) i))) false true))
                (paramBit i)
                (let ((e (findFSigCg cg (nodeA d))))
                  (if (== e 0)
                      (paramBit i)
                      (if (== (fldClass cg (arrowParamTy (memGetWord e 3) i)) 0)
                          (| (wordBit i) (ownerBit i))
                          (paramBit i)))))))))

(pub :: flowMaskApp (-> Int Int Int Int Int))
(pub fn (flowMaskApp cg e params env)
  (let ((hd (spineHead e))
        (n_ (spineArity e)))
    (if (!= (nodeTag hd) TAG_E_VAR)
        (flowMaskAll cg e n_ params env 0)
        (let ((n (nodeA hd)))
          ; the named word-taking heads, and arithmetic on what they
          ; answer, hand the reference out as a WORD - `cast` its
          ; second argument, the rest every argument; every OTHER
          ; word, a load included, is a scalar: `strLen` is
          ; `memGetWord s 0` and is a length, and MM-LIFE-2g names
          ; the four heads as the whole of how a reference becomes a
          ; word
          (if (isCastName n)
              (if (>= n_ 2) (toWord (aliasFlow cg (spineArgAt e 1) params env)) 0)
          (if (strEq n "__addr")
              (toWord (aliasFlowAll cg e n_ params env 0))
          (if (== (wordTakingHead hd) 1)
              ; `strData`, `strOwner`: the OWNER of whatever the
              ; operand aliases - a slice's owner is its parent's
              (toOwner (aliasFlowAll cg e n_ params env 0))
          (if (isBinop n)
              (toWord (flowMaskAll cg e n_ params env 0))
          (if (|| (isCmpOp n) (isAndOr n))
              0
          (if (|| (strEq n "memGetWord") (strEq n "__load64"))
              ; a header word: word 0 of a String is its length, a
              ; scalar; words past it are pointers into what the
              ; address aliases - `strData` and `strOwner` hand-rolled.
              ; A byte (`__load8`) is never a pointer
              (if (&& (>= n_ 2) (== (headerWordRead cg params (spineArgAt e 0) (spineArgAt e 1)) 1))
                  0
                  (if (>= n_ 1) (toOwner (aliasFlow cg (spineArgAt e 0) params env)) 0))
          (if (isPrimName n)
              0
          (if (|| (>= (envFlagOf env n) 0) (>= (paramIndexIn params n 0) 0))
              ; a local function value: whatever it was given
              (flowMaskAll cg e n_ params env 0)
          (if (!= (findFSigCg cg (mangledForCg cg n)) 0)
              (if (== (fnResultClass cg n) 2)
                  ; a counted reference of its own (event 2)
                  0
                  (flowMaskSel cg e n_ params env (fnRetMask cg n) 0))
              (if (!= (lookupType (memGetWord cg 3) n) 0)
                  ; a construction is a fresh block
                  0
                  (flowMaskAll cg e n_ params env 0)))))))))))))))

; `flowMask` that looks THROUGH a reference-returning call or a
; construction to what its arguments carried - what the result may
; share storage with, for the word-taking heads: a slice shares its
; parent's bytes, a constructor holds its arguments.
(pub :: aliasFlow (-> Int Int Int Int Int))
(pub fn (aliasFlow cg e params env)
  (| (flowMask cg e params env)
     (if (== e 0)
         0
         (if (!= (nodeTag e) TAG_E_APP)
             0
             (let ((hd (spineHead e)))
               (if (!= (nodeTag hd) TAG_E_VAR)
                   0
                   (let ((n (nodeA hd)))
                     (if (|| (isCastName n) (|| (isPrimName n) (|| (isBinop n) (|| (isCmpOp n) (isAndOr n)))))
                         0
                         (if (|| (!= (lookupType (memGetWord cg 3) n) 0)
                                 (== (fnResultClass cg n) 2))
                             (aliasFlowAll cg e (spineArity e) params env 0)
                             0)))))))))

(pub :: aliasFlowAll (-> Int Int Int Int Int Int Int))
(pub fn (aliasFlowAll cg e n_ params env i)
  (if (>= i n_)
      0
      (| (aliasFlow cg (spineArgAt e i) params env)
         (aliasFlowAll cg e n_ params env (+ i 1)))))

; The address is a HANDLE - a name, a field, or a cast of one - so
; its word 0 is the header's length. An address computed by
; arithmetic (`(+ (cast Int s) 8)`) points anywhere, and its word 0
; is whatever lives there.
; Is `(__load64 addr idx)` a read of a NUMBER: word 0 of a String
; handle (its length), or the count or shape word of any handle -
; `(- h 16)` at index 0 or 1, `(- h 8)` at index 0? Every other
; 64-bit load of a handle-relative address is a pointer the handle's
; block owns.
(pub :: headerWordRead (-> Int Int Int Int Int))
(pub fn (headerWordRead cg params addr idx)
  (if (|| (== idx 0) (!= (nodeTag idx) TAG_E_INT))
      0
      (let ((k (nodeA idx)))
        (if (== (minusLiteral addr) 16)
            (if (&& (>= k 0) (&& (<= k 1) (== (addrIsHandle cg params (spineArgAt addr 0)) 1))) 1 0)
            (if (== (minusLiteral addr) 8)
                (if (&& (== k 0) (== (addrIsHandle cg params (spineArgAt addr 0)) 1)) 1 0)
                (if (&& (== k 0) (== (addrIsHandle cg params addr) 1)) 1 0))))))

; `(- x LIT)`: the literal, or -1 for any other shape.
(pub :: minusLiteral (-> Int Int))
(pub fn (minusLiteral e)
  (if (== e 0)
      (- 0 1)
      (if (!= (nodeTag e) TAG_E_APP)
          (- 0 1)
          (let ((hd (spineHead e)))
            (if (&& (== (nodeTag hd) TAG_E_VAR)
                    (&& (strEq (nodeA hd) "-")
                        (&& (== (spineArity e) 2)
                            (== (nodeTag (spineArgAt e 1)) TAG_E_INT))))
                (nodeA (spineArgAt e 1))
                (- 0 1))))))

(pub :: addrIsHandle (-> Int Int Int Int))
(pub fn (addrIsHandle cg params e)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== tg TAG_E_VAR)
            ; a PARAMETER declared `String` - word 0 of a String is its
            ; length; word 0 of a struct is its first field, and a `let`
            ; alias, a `mut` slot or an `Int` parameter may hold an
            ; address computed by arithmetic, which points anywhere
            (if (== (paramIsString cg params (paramIndexIn params (nodeA e) 0)) 1) 1 0)
        (if (== tg TAG_E_FIELD)
            (if (== (fieldReadIsScalar cg e) 1) 0 1)
            (if (== tg TAG_E_APP)
                (let ((hd (spineHead e)))
                  (if (!= (nodeTag hd) TAG_E_VAR)
                      0
                      (if (&& (isCastName (nodeA hd)) (== (spineArity e) 2))
                          (if (== (isRefCallNode cg (spineArgAt e 1)) 1)
                              ; a reference-returning call's answer or
                              ; a construction is a handle: its header
                              ; words are numbers
                              1
                              (addrIsHandle cg params (spineArgAt e 1)))
                          ; `(- handle 16)`, `(- handle 8)`: the block's
                          ; own count or shape word, a number; any other
                          ; offset is somewhere else
                          (if (&& (strEq (nodeA hd) "-")
                                  (&& (== (spineArity e) 2)
                                      (&& (== (nodeTag (spineArgAt e 1)) TAG_E_INT)
                                          (|| (== (nodeA (spineArgAt e 1)) 8)
                                              (== (nodeA (spineArgAt e 1)) 16)))))
                              (addrIsHandle cg params (spineArgAt e 0))
                              0))))
                0))))))

; OR over the spine's arguments, `n_` of them.
(pub :: flowMaskAll (-> Int Int Int Int Int Int Int))
(pub fn (flowMaskAll cg e n_ params env i)
  (if (>= i n_)
      0
      (| (flowMask cg (spineArgAt e i) params env)
         (flowMaskAll cg e n_ params env (+ i 1)))))

; What a callee's RET mask makes of the arguments: a parameter it
; answers as it arrived keeps the argument's form; one it answers as a
; word launders it.
(pub :: flowMaskSel (-> Int Int Int Int Int Int Int Int))
(pub fn (flowMaskSel cg e n_ params env mask i)
  (if (>= i n_)
      0
      (| (let ((f (flowMask cg (spineArgAt e i) params env)))
           (| (if (!= (& mask (paramBit i)) 0) f 0)
              (| (if (!= (& mask (wordBit i)) 0) (toWord f) 0)
                 (if (!= (& mask (ownerBit i)) 0) (toOwner f) 0))))
         (flowMaskSel cg e n_ params env mask (+ i 1)))))

(pub :: flowMaskClauses (-> Int Int Int Int Int Int))
(pub fn (flowMaskClauses cg cls params env i)
  (if (>= i (vecLen cls))
      0
      (| (flowMask cg (nodeB (vecGet cls i)) params env)
         (flowMaskClauses cg cls params env (+ i 1)))))

(pub :: flowMaskArms (-> Int Int Int Int Int Int Int))
(pub fn (flowMaskArms cg arms params env scrut i)
  (if (>= i (vecLen arms))
      0
      (let ((arm (vecGet arms i)))
        (let ((bs (patBindersCg (nodeA arm) vecNew)))
          (| (flowMask cg (nodeB arm) params
                       (if (== bs 0) env (envWithPat cg env (nodeA arm) scrut)))
             (flowMaskArms cg arms params env scrut (+ i 1)))))))

; Walk the whole body and OR into `cell` word 0 the parameters some
; part of whose reference is parked beyond the frame uncounted, and
; into word 1 the ones `__retainref`/`__retain` counted.
(pub :: flowStashes (-> Int Int Int Int Int Int))
(pub fn (flowStashes cg e params env cell)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== tg TAG_E_APP)
            (flowStashesApp cg e params env cell)
        (if (== tg TAG_E_FIELD)
            (flowStashes cg (nodeA e) params env cell)
        ; every arm is a REGION of its own: a `__retainref` that runs
        ; only on some path counts on that path only, and pairs with
        ; the stashes of that path (`strSlice` retains and parks under
        ; one branch) and never with a sibling's or the unconditional
        ; ones outside it
        (if (== tg TAG_E_IF)
            { (flowStashes cg (nodeA e) params env cell)
              (branchEnter cell)
              (flowStashes cg (nodeB e) params env cell)
              (branchLeave cell)
              (branchEnter cell)
              (flowStashes cg (nodeC e) params env cell)
              (branchLeave cell) }
        (if (== tg TAG_E_COND)
            { (flowStashesClauses cg (nodeA e) params env cell 0)
              (branchEnter cell)
              (flowStashes cg (nodeB e) params env cell)
              (branchLeave cell) }
        (if (== tg TAG_E_MATCH)
            { (flowStashes cg (nodeA e) params env cell)
              (flowStashesArms cg (nodeB e) params env cell
                               (flowMask cg (nodeA e) params env) 0) }
        (if (== tg TAG_E_BEGIN)
            (flowStashesVec cg (nodeA e) params env cell 0)
        (if (== tg TAG_E_WHILE)
            ; the condition runs once more than the body, and the
            ; body may never run: two regions
            { (branchEnter cell)
              (flowStashes cg (nodeA e) params env cell)
              (branchLeave cell)
              (branchEnter cell)
              (flowStashesVec cg (nodeB e) params env cell 0)
              (branchLeave cell) }
        (if (== tg TAG_E_LET)
            { (flowStashes cg (nodeB e) params env cell)
              (flowStashes cg (nodeC e) params
                           (envWith env (nodeA e) (letFlag cg (nodeB e) params env)) cell) }
        (if (== tg TAG_E_LETM)
            ; a `mut` slot is frame storage: it dies with the frame,
            ; so what is put in it is parked only where a lambda
            ; captures the slot's value (`lamCaptureMask`, through
            ; the alias recorded here). Counted as a park, every
            ; `(let ((mut t s)) ...)` marked `s` stashed, and a loop
            ; never gave the slot's share back
            { (flowStashes cg (nodeB e) params env cell)
              (flowStashes cg (nodeC e) params
                           (envWith env (nodeA e) (mutFlag cg (nodeA e) (nodeB e) (nodeC e) params env)) cell) }
        (if (== tg TAG_E_SET)
            (flowStashes cg (nodeB e) params env cell)
        (if (== tg TAG_E_SETF)
            { (flowStashes cg (nodeA e) params env cell)
              (flowStashes cg (nodeC e) params env cell)
              ; a reference field retains (event 5); a word field parks
              (if (== (fieldReadIsScalar cg e) 1)
                  (stashAdd cell (parkForms (flowMask cg (nodeC e) params env)))
                  0) }
        (if (== tg TAG_E_HANDLE)
            ; the body in this region; the handler in one of its own -
            ; a `handle` naming only built-in effects never evaluates
            ; it (B is the Vec of effect names, not a node)
            { (flowStashes cg (nodeA e) params env cell)
              (branchEnter cell)
              (flowStashes cg (nodeC e) params env cell)
              (branchLeave cell) }
        (if (== tg TAG_E_LAM)
            ; a capture of a PARAMETER takes a share (event 4's
            ; exception, `emitLambda`); a capture of a local that
            ; aliases one takes none, and parks it
            (stashAdd cell (parkForms (lamCaptureMask cg (nodeB e) params env)))
        (if (== tg TAG_E_STRUCTCON)
            (let ((entry (lookupType (memGetWord cg 3) (nodeA e))))
              { (flowStashesVec cg (nodeB e) params env cell 0)
                (if (== entry 0)
                    0
                    (flowStashesFieldsVec cg entry (nodeB e) params env cell 0)) })
            0)))))))))))))))))

; The region cell: word 0 the stashes pending in the open region
; (a child's, already netted against the child's own counts, joins
; its parent's on leave), word 1 the counts taken in the open region,
; word 2 a stack of the enclosing regions' (stash, count) pairs. A
; count cancels a stash when the count's region encloses the stash's:
; the same arm, or any region around it - that is every path the
; stash runs on.
(pub :: regionNew Int)
(pub fn (regionNew)
  (let ((cell (memAlloc 24)))
    { (memSetWord cell 0 0) (memSetWord cell 1 0) (memSetWord cell 2 vecNew) cell }))

(pub :: stashAdd (-> Int Int Int))
(pub fn (stashAdd cell m)
  { (memSetWord cell 0 (| (memGetWord cell 0) m)) 0 })

; A count never lands on a SATURATED bit: parameters past index 18
; share bit 19 in every form, so a count of one would license a park
; of any other; the park stays, the leak direction.
(pub :: countedAdd (-> Int Int Int))
(pub fn (countedAdd cell m)
  { (memSetWord cell 1 (| (memGetWord cell 1) (& m (unsaturated)))) 0 })

(pub :: unsaturated Int)
(pub fn (unsaturated)
  (^ (- (<< 1 60) 1) (| (<< 1 19) (| (<< 1 39) (<< 1 59)))))

; The flow a COUNT is credited to: what the retained expression MUST
; be - the parameter itself, a `cast` of it, a `let` alias of one of
; those - and one parameter only. `(__retainref r.name)` retains the
; field, not the record `r` whose park it would otherwise cancel;
; `(__retainref (if c s t))` retains one of two, and cancels neither.
(pub :: countFlow (-> Int Int Int Int Int))
(pub fn (countFlow cg e params env)
  (let ((m (mustFlow cg e params env)))
    (if (== (popcount (paramsOf m)) 1) m 0)))

; The flow of `e` when `e` MUST be that: a parameter, a `let` alias
; recorded as must (`MUST_BIT` on its environment flag - its own
; initialiser was one of these), a `cast` of one; anything else - a
; field, a match binder, a join, a call - 0.
(pub :: mustFlow (-> Int Int Int Int Int))
(pub fn (mustFlow cg e params env)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== tg TAG_E_VAR)
            (let ((k (envFlagOf env (nodeA e))))
              (if (>= k 0)
                  (if (!= (& k MUST_BIT) 0) (& k (- MUST_BIT 1)) 0)
                  (paramFlowBit cg params (paramIndexIn params (nodeA e) 0))))
            (if (== tg TAG_E_APP)
                (let ((hd (spineHead e)))
                  (if (!= (nodeTag hd) TAG_E_VAR)
                      0
                      (let ((n (nodeA hd)))
                        (if (&& (isCastName n) (== (spineArity e) 2))
                            (toWord (mustFlow cg (spineArgAt e 1) params env))
                        (if (&& (strEq n "__addr") (== (spineArity e) 1))
                            (toWord (mustFlow cg (spineArgAt e 0) params env))
                        ; the owner of one string is one block, and so
                        ; is its data pointer: `sysReadAll` counts
                        ; `(strOwner buf)` through a `let`
                        (if (&& (|| (strEq n "strData") (strEq n "strOwner")) (== (spineArity e) 1))
                            (toOwner (mustFlow cg (spineArgAt e 0) params env))
                        (if (&& (|| (strEq n "memGetWord") (strEq n "__load64"))
                                (&& (== (spineArity e) 2)
                                    (&& (== (nodeTag (spineArgAt e 1)) TAG_E_INT)
                                        (!= (nodeA (spineArgAt e 1)) 0))))
                            (toOwner (mustFlow cg (spineArgAt e 0) params env))
                            0)))))))
                0)))))

(pub :: MUST_BIT Int)
(pub fn (MUST_BIT) (<< 1 60))

; A `mut` slot's flow: its initialiser joined with every `(set name
; v)` in its scope - to a fixpoint, since a `set` may read the slot
; (`(set t (strConcat t "x"))`). The flag of the slot is what a park
; or an answer of it carries: `(let ((mut t 0)) { (set t (cast Int
; s)) (__store64 m 0 t) })` parks a header word of `s`.
(pub :: mutFlag (-> Int String Int Int Int Int Int))
(pub fn (mutFlag cg name init body params env)
  (mutFlagIter cg name body params env (flowMask cg init params env) 0))

(pub :: mutFlagIter (-> Int String Int Int Int Int Int Int))
(pub fn (mutFlagIter cg name body params env f k)
  (let ((f2 (| f (setFlows cg name body params (envWith env name f)))))
    (if (|| (== f2 f) (>= k 6))
        f2
        (mutFlagIter cg name body params env f2 (+ k 1)))))

; OR of the flows of every `(set name v)` under `e`; a nested binding
; of the same name is not distinguished (conservative).
(pub :: setFlows (-> Int String Int Int Int Int))
(pub fn (setFlows cg name e params env)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR)
            (|| (== tg TAG_E_CHAR)
            (|| (== tg TAG_E_VAR) (== tg TAG_E_QUOTE))))))
            0
        (if (== tg TAG_E_SET)
            (| (if (strEq (nodeA e) name) (flowMask cg (nodeB e) params env) 0)
               (setFlows cg name (nodeB e) params env))
        (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
            (| (setFlows cg name (nodeA e) params env)
               (| (setFlows cg name (nodeB e) params env)
                  (setFlows cg name (nodeC e) params env)))
        ; a binding's word 1 is its NAME, a String, not a node; the
        ; body sees the binding (`(set u t)` with `t` an inner alias
        ; of a word of a parameter)
        (if (== tg TAG_E_LET)
            (| (setFlows cg name (nodeB e) params env)
               (setFlows cg name (nodeC e) params
                         (envWith env (nodeA e) (letFlag cg (nodeB e) params env))))
        (if (== tg TAG_E_LETM)
            (| (setFlows cg name (nodeB e) params env)
               (setFlows cg name (nodeC e) params
                         (envWith env (nodeA e) (mutFlag cg (nodeA e) (nodeB e) (nodeC e) params env))))
        (if (== tg TAG_E_SETF)
            (| (setFlows cg name (nodeA e) params env)
               (setFlows cg name (nodeC e) params env))
        (if (|| (== tg TAG_E_FIELD) (== tg TAG_E_ALLOC))
            (setFlows cg name (nodeA e) params env)
        (if (== tg TAG_E_BEGIN)
            (setFlowsVec cg name (nodeA e) params env 0)
        (if (== tg TAG_E_COND)
            (| (setFlowsClauses cg name (nodeA e) params env 0)
               (setFlows cg name (nodeB e) params env))
        (if (== tg TAG_E_MATCH)
            (| (setFlows cg name (nodeA e) params env)
               (setFlowsArms cg name (nodeB e) params env
                             (flowMask cg (nodeA e) params env) 0))
        (if (== tg TAG_E_WHILE)
            (| (setFlows cg name (nodeA e) params env)
               (setFlowsVec cg name (nodeB e) params env 0))
        (if (== tg TAG_E_LAM)
            (setFlows cg name (nodeB e) params env)
        (if (== tg TAG_E_STRUCTCON)
            (setFlowsVec cg name (nodeB e) params env 0)
        (if (== tg TAG_E_HANDLE)
            (| (setFlows cg name (nodeA e) params env)
               (setFlows cg name (nodeC e) params env))
            0)))))))))))))))))

(pub :: setFlowsVec (-> Int String Int Int Int Int Int))
(pub fn (setFlowsVec cg name v params env i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (| (setFlows cg name (vecGet v i) params env)
             (setFlowsVec cg name v params env (+ i 1))))))

(pub :: setFlowsClauses (-> Int String Int Int Int Int Int))
(pub fn (setFlowsClauses cg name cls params env i)
  (if (== cls 0)
      0
      (if (>= i (vecLen cls))
          0
          (let ((c (vecGet cls i)))
            (| (| (setFlows cg name (nodeA c) params env)
                  (setFlows cg name (nodeB c) params env))
               (setFlowsClauses cg name cls params env (+ i 1)))))))

(pub :: setFlowsArms (-> Int String Int Int Int Int Int Int))
(pub fn (setFlowsArms cg name arms params env scrut i)
  (if (== arms 0)
      0
      (if (>= i (vecLen arms))
          0
          (let ((arm (vecGet arms i)))
            (| (setFlows cg name (nodeB arm) params (envWithPat cg env (nodeA arm) scrut))
               (setFlowsArms cg name arms params env scrut (+ i 1)))))))

; A `let`'s environment flag: its flow, marked must when the
; initialiser must be what it flows from.
(pub :: letFlag (-> Int Int Int Int Int))
(pub fn (letFlag cg init params env)
  (let ((f (flowMask cg init params env)))
    (if (!= (mustFlow cg init params env) 0) (| f MUST_BIT) f)))

(pub :: popcount (-> Int Int))
(pub fn (popcount m)
  (if (== m 0) 0 (+ (& m 1) (popcount (>> m 1)))))

; What the open region parks net of its own counts.
(pub :: regionNet (-> Int Int))
(pub fn (regionNet cell)
  (& (memGetWord cell 0) (^ (memGetWord cell 1) (- 0 1))))

(pub :: branchEnter (-> Int Int))
(pub fn (branchEnter cell)
  (let ((stk (memGetWord cell 2)))
    { (vecPush stk (memGetWord cell 0))
      (vecPush stk (memGetWord cell 1))
      (memSetWord cell 0 0)
      (memSetWord cell 1 0)
      0 }))

(pub :: branchLeave (-> Int Int))
(pub fn (branchLeave cell)
  (let ((stk (memGetWord cell 2))
        (net (regionNet cell)))
    (let ((n (vecLen stk)))
      (let ((outerStash (vecGet stk (- n 2)))
            (outerCount (vecGet stk (- n 1))))
        { (vecPop stk)
          (vecPop stk)
          (memSetWord cell 0 (| outerStash net))
          (memSetWord cell 1 outerCount)
          0 }))))

(pub :: flowStashesVec (-> Int Int Int Int Int Int Int))
(pub fn (flowStashesVec cg v params env cell i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          { (flowStashes cg (vecGet v i) params env cell)
            (flowStashesVec cg v params env cell (+ i 1)) })))

(pub :: flowStashesClauses (-> Int Int Int Int Int Int Int))
(pub fn (flowStashesClauses cg cls params env cell i)
  (if (>= i (vecLen cls))
      0
      (let ((c (vecGet cls i)))
        ; the TEST is a region of its own: it runs whenever the
        ; clauses before it failed, whether or not this body runs,
        ; so a count in the body licenses no park in the test
        { (branchEnter cell)
          (flowStashes cg (nodeA c) params env cell)
          (branchLeave cell)
          (branchEnter cell)
          (flowStashes cg (nodeB c) params env cell)
          (branchLeave cell)
          (flowStashesClauses cg cls params env cell (+ i 1)) })))

(pub :: flowStashesArms (-> Int Int Int Int Int Int Int Int))
(pub fn (flowStashesArms cg arms params env cell scrut i)
  (if (>= i (vecLen arms))
      0
      (let ((arm (vecGet arms i)))
        (let ((bs (patBindersCg (nodeA arm) vecNew)))
          { (branchEnter cell)
            (flowStashes cg (nodeB arm) params
                         (if (== bs 0) env (envWithPat cg env (nodeA arm) scrut)) cell)
            (branchLeave cell)
            (flowStashesArms cg arms params env cell scrut (+ i 1)) }))))

; A call: what its arguments park, by the callee's own summary and
; each argument's FORM; a constructor: what its WORD fields park; a
; raw store: its value; a cast: nothing of itself (its consumer
; decides).
(pub :: flowStashesApp (-> Int Int Int Int Int Int))
(pub fn (flowStashesApp cg e params env cell)
  (let ((hd (spineHead e))
        (n_ (spineArity e)))
    (if (&& (== (nodeTag hd) TAG_E_VAR) (isAndOr (nodeA hd)))
        ; `&&`/`||`: the first operand always runs, every later one
        ; only sometimes - each of those is a region of its own, so a
        ; count in one licenses no park outside it
        (flowStashesArgsRegions cg e n_ params env cell 0)
    {
      (flowStashesArgs cg e n_ params env cell 0)
      (selfSlotParks cg e hd n_ params env cell)
      (if (!= (nodeTag hd) TAG_E_VAR)
          ; a lambda applied where it stands, or a call answering a
          ; closure: the HEAD is walked for what it captures, and
          ; every argument is parked (a local function value)
          { (flowStashes cg hd params env cell)
            (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0))) }
          (let ((n (nodeA hd)))
            (if (|| (isCastName n) (|| (isBinop n) (|| (isCmpOp n) (isAndOr n))))
                0
            (if (isPrimName n)
                (if (|| (strEq n "__store64") (strEq n "__store8"))
                    (if (>= n_ 3)
                        (stashAdd cell (parkForms (flowMask cg (spineArgAt e 2) params env)))
                        0)
                    (if (strEq n "__retainref")
                        ; counts a typed arrival; a word's witness is
                        ; `Int` and it retains nothing
                        (if (>= n_ 1)
                            (countedAdd cell (arrivalPart (countFlow cg (spineArgAt e 0) params env)))
                            0)
                        (if (strEq n "__retain")
                            ; counts the word it is given, whatever it was
                            (if (>= n_ 1)
                                (countedAdd cell (parkForms (countFlow cg (spineArgAt e 0) params env)))
                                0)
                            (if (strEq n "__call_word")
                                ; a function reached by address may park
                                ; what it is handed
                                (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0)))
                                0))))
            (if (|| (>= (envFlagOf env n) 0) (>= (paramIndexIn params n 0) 0))
                (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0)))
            (if (!= (findFSigCg cg (mangledForCg cg n)) 0)
                (stashAdd cell (stashSel cg e n_ params env (fnStashMask cg n) 0))
                (let ((entry (lookupType (memGetWord cg 3) n)))
                  (if (== entry 0)
                      ; an effect operation, or a name nothing signed
                      (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0)))
                      (flowStashesFields cg entry e n_ params env cell 0)))))))))
    })))

(pub :: flowStashesArgsRegions (-> Int Int Int Int Int Int Int Int))
(pub fn (flowStashesArgsRegions cg e n_ params env cell i)
  (if (>= i n_)
      0
      { (if (== i 0)
            (flowStashes cg (spineArgAt e i) params env cell)
            { (branchEnter cell)
              (flowStashes cg (spineArgAt e i) params env cell)
              (branchLeave cell) })
        (flowStashesArgsRegions cg e n_ params env cell (+ i 1)) }))

; A call to the function being summarised: its `Int` parameters are
; SLOTS of the loop the self tail call becomes, and a word of a
; reference flowing into one is parked there uncounted - the boundary
; would release the old reference under it (`(i1 (strConcat ..) (cast
; Int s) (- n 1))`). Every self call is treated so; a non-tail one
; parks conservatively.
(pub :: selfSlotParks (-> Int Int Int Int Int Int Int Int))
(pub fn (selfSlotParks cg e hd n_ params env cell)
  (let ((d (memGetWord cg 36)))
    (if (|| (== d 0) (!= (nodeTag hd) TAG_E_VAR))
        0
        (if (if (strEq (mangledForCg cg (nodeA hd)) (nodeA d)) false true)
            0
            (let ((en (findFSigCg cg (nodeA d))))
              (if (== en 0)
                  0
                  (selfSlotParksFrom cg e (memGetWord en 3) n_ params env cell 0)))))))

(pub :: selfSlotParksFrom (-> Int Int Int Int Int Int Int Int Int))
(pub fn (selfSlotParksFrom cg e sigTy n_ params env cell i)
  (if (>= i n_)
      0
      { (if (== (fldClass cg (arrowParamTy sigTy i)) 0)
            (stashAdd cell (parkForms (flowMask cg (spineArgAt e i) params env)))
            0)
        (selfSlotParksFrom cg e sigTy n_ params env cell (+ i 1)) }))

; The arguments a callee's STASH summary parks, by position and form:
; an argument's arrival half is parked if the callee parks a typed
; arrival there, its word half if the callee parks a word there; a
; parked word is parked in both forms of what it was a word of.
(pub :: stashSel (-> Int Int Int Int Int Int Int Int))
(pub fn (stashSel cg e n_ params env mask i)
  (if (>= i n_)
      0
      ; the callee's ARRIVAL bit is a STRONG park - whatever it is
      ; given is parked uncounted: a typed argument as it arrived,
      ; and a word of one of our parameters in every form, since a
      ; word laundered here is parked whatever form that parameter
      ; came in. Its WORD bits are WEAK - parked only when a word
      ; arrives, its typed arrival being counted: nothing of a typed
      ; argument, and a word argument in every form.
      ; The callee's ARRIVAL bit is a STRONG park - whatever it is
      ; given is parked uncounted - and so is its OWNER bit: an owner
      ; word is never what `__retainref` counted. Its HEADER bit is
      ; WEAK - parked only when a header word arrives, the typed
      ; arrival being counted: a word argument parks in its forms,
      ; and an arrival forwarded as itself (`(fn (put m x) (memSetWord
      ; m 0 x))`) inherits the weak bit, so a word handed to `put`
      ; two calls up is still seen.
      (| (let ((f (flowMask cg (spineArgAt e i) params env)))
           (| (if (!= (& mask (| (paramBit i) (ownerBit i))) 0)
                  (parkForms f)
                  0)
              (if (!= (& mask (wordBit i)) 0)
                  (| (parkForms (wordParts f)) (arrivalToWord (arrivalPart f)))
                  0)))
         (stashSel cg e n_ params env mask (+ i 1)))))

(pub :: flowStashesArgs (-> Int Int Int Int Int Int Int Int))
(pub fn (flowStashesArgs cg e n_ params env cell i)
  (if (>= i n_)
      0
      { (flowStashes cg (spineArgAt e i) params env cell)
        (flowStashesArgs cg e n_ params env cell (+ i 1)) }))

; A constructor's WORD fields (declared a machine scalar) park what
; is stored in them; reference fields retain (event 6), and a
; type-variable field retains under its witness when the value is a
; typed reference - a word laundered into one parks.
(pub :: flowStashesFields (-> Int Int Int Int Int Int Int Int Int))
(pub fn (flowStashesFields cg entry e n_ params env cell i)
  (if (>= i n_)
      0
      (let ((tn (fieldTypeNode entry i))
            (f (flowMask cg (spineArgAt e i) params env)))
        {
          (if (== (ctorFieldParks cg entry e tn i) 1)
              (stashAdd cell (parkForms f))
              (stashAdd cell (parkForms (wordParts f))))
          (flowStashesFields cg entry e n_ params env cell (+ i 1))
        })))

(pub :: flowStashesFieldsVec (-> Int Int Int Int Int Int Int Int))
(pub fn (flowStashesFieldsVec cg entry args params env cell i)
  (if (>= i (vecLen args))
      0
      (let ((tn (fieldTypeNode entry i))
            (f (flowMask cg (vecGet args i) params env)))
        {
          (if (if (== tn 0) true (== (fldClass cg tn) 0))
              (stashAdd cell (parkForms f))
              (stashAdd cell (parkForms (wordParts f))))
          (flowStashesFieldsVec cg entry args params env cell (+ i 1))
        })))

; The declared type node of field `j` of a constructor or struct
; entry, or 0.
(pub :: fieldTypeNode (-> Int Int Int))
(pub fn (fieldTypeNode entry j)
  (if (== (eKind entry) TF_DATA)
      (let ((ftys (eFieldTys entry)))
        (if (== ftys 0) 0 (if (< j (vecLen ftys)) (vecGet ftys j) 0)))
      (let ((fs (eFieldFlags entry)))
        (if (< j (vecLen fs)) (nodeTy (vecGet fs j)) 0))))

; What a lambda body parks by capture: the `let`-bound locals it
; mentions, with their flows - a parameter captured directly takes a
; share (`emitLambda` retains reference parameters it captures).
(pub :: lamCaptureMask (-> Int Int Int Int Int))
(pub fn (lamCaptureMask cg body params env)
  (| (lamCaptureFrom body env 0)
     (lamParamCaptures cg body params 0)))

; `emitLambda` retains a captured parameter only when its class is a
; reference (`retainParamCaps`): a type-variable or `Int` parameter
; is captured uncounted - parked.
(pub :: lamParamCaptures (-> Int Int Int Int Int))
(pub fn (lamParamCaptures cg body params i)
  (if (>= i (vecLen params))
      0
      (| (if (&& (== (mentions (cast String (vecGet params i)) body) 1)
                 (!= (paramClassOf cg params i) 2))
             (parkForms (paramFlowBit cg params i))
             0)
         (lamParamCaptures cg body params (+ i 1)))))

; A call to a signed global whose result class is a reference, or a
; constructor application: what it answers is a handle.
(pub :: isRefCallNode (-> Int Int Int))
(pub fn (isRefCallNode cg e)
  (if (== e 0)
      0
      (if (!= (nodeTag e) TAG_E_APP)
          0
          (let ((hd (spineHead e)))
            (if (!= (nodeTag hd) TAG_E_VAR)
                0
                (let ((n (nodeA hd)))
                  (if (|| (isCastName n) (|| (isPrimName n) (|| (isBinop n) (|| (isCmpOp n) (isAndOr n)))))
                      0
                      (if (!= (lookupType (memGetWord cg 3) n) 0)
                          1
                          (if (== (fnResultClass cg n) 2) 1 0)))))))))

(pub :: paramIsString (-> Int Int Int Int))
(pub fn (paramIsString cg params i)
  (if (< i 0)
      0
      (let ((d (memGetWord cg 36)))
        (if (== d 0)
            0
            (if (|| (!= (vecLen params) (vecLen (nodeB d)))
                    (if (strEq (cast String (vecGet params i)) (cast String (vecGet (nodeB d) i))) false true))
                0
                (let ((e (findFSigCg cg (nodeA d))))
                  (if (== e 0)
                      0
                      (let ((t (arrowParamTy (memGetWord e 3) i)))
                        (if (== t 0)
                            0
                            (if (&& (== (nodeTag t) TAG_T_CON) (strEq (nodeA t) "String")) 1 0))))))))))

(pub :: paramClassOf (-> Int Int Int Int))
(pub fn (paramClassOf cg params i)
  (let ((d (memGetWord cg 36)))
    (if (== d 0)
        2
        (if (!= (vecLen params) (vecLen (nodeB d)))
            2
            (let ((e (findFSigCg cg (nodeA d))))
              (if (== e 0) 2 (fldClass cg (arrowParamTy (memGetWord e 3) i))))))))

(pub :: lamCaptureFrom (-> Int Int Int Int))
(pub fn (lamCaptureFrom body env i)
  (if (>= (+ i 1) (vecLen env))
      0
      (| (if (== (mentions (cast String (vecGet env i)) body) 1)
             (& (cast Int (vecGet env (+ i 1))) (- MUST_BIT 1))
             0)
         (lamCaptureFrom body env (+ i 2)))))

; The declared result class of the named global: `fldClass` of its
; signature's result - 0 a word, 2 a reference, 1 unclassifiable or
; a type variable, and -1 when there is no signature at all.
(pub :: fnResultClass (-> Int String Int))
(pub fn (fnResultClass cg name)
  (let ((e (findFSigCg cg (mangledForCg cg name))))
    (if (== e 0)
        (- 0 1)
        (let ((res (sigResultTy (memGetWord e 3))))
          (if (== res 0) 1 (fldClass cg res))))))

; Does this expression's VALUE carry a share of its own that the
; frame holding it may hand back - and is it a reference, so that
; handing it back means something? A direct construction; a call to a
; signed global whose result is a reference, applied to exactly its
; arity (a surplus argument applies the closure it answers, whose
; result nothing signed); and the joins over `if`, `cond`, `match`,
; `let` and a block. A match here is only as owned as its arms, and
; an arm answering a binder is not.
(pub :: valueOwnedRef (-> Int Int Int))
(pub fn (valueOwnedRef cg e)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== (argIsDirectCon cg e) 1)
            1
        (if (== tg TAG_E_STR)
            ; a static: immortal, and releasing it is a no-op, so a
            ; branch answering one does not stop the join being owned
            1
        (if (== tg TAG_E_VAR)
            ; a nullary constructor - `None`, `Nil` - is an immediate,
            ; a no-op to release, so `(if c (Some x) None)` is owned
            ; and the `Some` it builds is given back
            (if (!= (lookupType (memGetWord cg 3) (nodeA e)) 0)
                (if (isLocalValue cg (nodeA e)) 0 1)
                0)
        (if (== tg TAG_E_APP)
            (let ((hd (spineHead e)))
              (if (!= (nodeTag hd) TAG_E_VAR)
                  0
                  (let ((n (nodeA hd)))
                    ; the indexed questions first - most arguments are
                    ; not calls to reference-returning globals, and the
                    ; constructor-table scan is the expensive one
                    (if (!= (fnResultClass cg n) 2)
                        0
                        (if (|| (isCastName n) (|| (isPrimName n) (isLocalValue cg n)))
                            0
                            (if (!= (lookupType (memGetWord cg 3) n) 0)
                                0
                                (if (== (spineArity e)
                                        (fnArityCg cg n))
                                    1
                                    0)))))))
        (if (== tg TAG_E_IF)
            (if (== (valueOwnedRef cg (nodeB e)) 1) (valueOwnedRef cg (nodeC e)) 0)
        (if (== tg TAG_E_COND)
            (if (== (valueOwnedRefClauses cg (nodeA e) 0) 1)
                (valueOwnedRef cg (nodeB e))
                0)
        (if (== tg TAG_E_MATCH)
            (valueOwnedRefArms cg (nodeB e) 0)
        (if (== tg TAG_E_LET)
            (valueOwnedRef cg (nodeC e))
        (if (== tg TAG_E_BEGIN)
            (if (== (vecLen (nodeA e)) 0)
                0
                (valueOwnedRef cg (vecGet (nodeA e) (- (vecLen (nodeA e)) 1))))
            0))))))))))))

(pub :: valueOwnedRefClauses (-> Int Int Int Int))
(pub fn (valueOwnedRefClauses cg cls i)
  (if (>= i (vecLen cls))
      1
      (if (== (valueOwnedRef cg (nodeB (vecGet cls i))) 1)
          (valueOwnedRefClauses cg cls (+ i 1))
          0)))

(pub :: valueOwnedRefArms (-> Int Int Int Int))
(pub fn (valueOwnedRefArms cg arms i)
  (if (>= i (vecLen arms))
      (if (== i 0) 0 1)
      (if (== (valueOwnedRef cg (nodeB (vecGet arms i))) 1)
          (valueOwnedRefArms cg arms (+ i 1))
          0)))

; ------------------------------------------------------------------
; MM-LIFE-2d evidence, emission side. A polymorphic function - one
; whose signature has a type variable in a PARAM position - takes
; one hidden trailing `i64 %__evw.h`; every direct call to it passes
; the word the checker's stamp describes: constant bits, plus
; `(lshr caller-word, k) & 1` per symbolic entry. The register and
; its symbol-table name both contain a dot, which no Axiom
; identifier can spell - collision with user code is impossible by
; construction, so no reserved-name diagnostic exists for it.
;
; The walk below mirrors typecheck's `sigTyVarsInto` over the SAME
; D_SIG tree (FSig now carries it): one ordering convention, two
; implementations, pinned against each other by the evidence fixture.
; Only the WALK is duplicated on purpose - the leaf predicates it
; needs (`tyIsSrcVar`, `nameVecHas`, `nameVecIdx`) are core.ax's, so
; the two orderings are compared, not two copies of a list search.
; ------------------------------------------------------------------
(pub :: cgSigVarsInto (-> Int Int Int))
(pub fn (cgSigVarsInto t acc)
  (if (== t 0)
      0
      (let ((tg (nodeTag t)))
        (if (== tg TAG_T_VAR)
            (if (== (tyIsSrcVar t) 1)
                (if (== (strVecHas acc (nodeA t)) 1)
                    0
                    (vecPush acc (cast Int (nodeA t))))
                0)
        (if (== tg TAG_T_CON)
            (cgSigVarsVec (nodeB t) acc)
        (if (== tg TAG_T_ARR)
            {
              (cgSigVarsInto (nodeA t) acc)
              (cgSigVarsInto (nodeB t) acc)
            }
        (if (== tg TAG_T_TUP)
            (cgSigVarsVec (nodeA t) acc)
        (if (|| (== tg TAG_T_LIST) (== tg TAG_T_PTR))
            (cgSigVarsInto (nodeA t) acc)
        0))))))))

(pub :: cgSigVarsVec (-> Int Int Int))
(pub fn (cgSigVarsVec xs acc)
  (if (== xs 0)
      0
      (let ((mut i 0))
        {
          (while (< i (vecLen xs))
            {
              (cgSigVarsInto (vecGet xs i) acc)
              (set i (+ i 1))
            })
          0
        })))

(pub :: cgParamPosVars (-> Int Int Int))
(pub fn (cgParamPosVars t acc)
  (if (&& (!= t 0) (== (nodeTag t) TAG_T_ARR))
      {
        (cgSigVarsInto (nodeA t) acc)
        (cgParamPosVars (nodeB t) acc)
      }
      0))

; A signature whose every variable is return-only takes no word: no
; param position can ever witness one, so the bits would be zeros
; forever - which exempts the hottest accessors (memGetWord, vecGet,
; nodeA/B/C) from the extra argument outright.
(pub :: cgTakesEvidence (-> Int Int))
(pub fn (cgTakesEvidence t)
  (if (== t 0)
      0
      (let ((acc vecNew))
        {
          (cgParamPosVars t acc)
          (if (> (vecLen acc) 0) 1 0)
        })))

; memoized at scan time - a walk and a Vec per CALL was 14 MiB of
; the bootstrap gate's self-compile ceiling
(pub :: fnTakesEvw (-> Int String Int))
(pub fn (fnTakesEvw cg full)
  (let ((e (findFSig (memGetWord cg 15) full)))
    (if (== e 0) 0 (memGetWord e 4))))

; A stamp is a function of the node alone: a macro-spliced argument
; node is a shared object, so a stamp written while checking one
; declaration must not steer emission inside another. The stamp
; carries its author; a mismatch demotes to no-stamp (all zeros -
; the conservative direction).
(pub :: evStampOk (-> Int Int Int))
(pub fn (evStampOk cg stamp)
  (if (== stamp 0)
      0
      (if (!= (nodeTag stamp) TAG_EVSTAMP)
          0
          (if (== (nodeA stamp) (memGetWord cg 36))
              stamp
              0))))

; Read the enclosing function's own evidence word into field 2 - the
; direct param register, or a load when TCO parked it in a slot. A
; monomorphic caller answers the constant 0 (unreachable from a
; checked stamp; defensive).
(pub :: emitEvwRead (-> Int Int))
(pub fn (emitEvwRead cg)
  (let ((symReg (lookupSym cg "__evw.")))
    (if (== symReg 0)
        {
          (memSetWord cg 2 (constStr 0))
          cg
        }
        (if (>= (lookupSymKind cg "__evw.") 1)
            (let ((rn (allocReg cg)))
              (let ((r (regStr rn)))
                {
                  (emitLine cg (cat4 (cat2 "  " r)
                                     " = load i64, ptr "
                                     (strDup (cast String symReg))
                                     ""))
                  (memSetWord cg 2 r)
                  cg
                }))
            {
              (memSetWord cg 2 (strDup (cast String symReg)))
              cg
            }))))

; The callee's evidence word from a validated stamp: constant bits
; first (bit 63 via `shl 1, 63` - a literal with the sign bit set
; would pass through fmtInt, which renders negatives wrong), then
; one lshr/and/shl/or chain per symbolic entry. Answers cg with the
; value string in field 2. An absent stamp answers "0".
(pub :: emitEvWordVal (-> Int Int Int))
(pub fn (emitEvWordVal cg stamp)
  (if (== stamp 0)
      {
        (memSetWord cg 2 (constStr 0))
        cg
      }
      (let ((w (nodeB stamp))
            (mut c 0)
            (mut hasHigh 0)
            (mut hasSym 0))
        {
          (let ((mut i 0))
            (while (< i (vecLen w))
              {
                (let ((v (vecGet w i)))
                  (if (== v 1)
                      (if (>= i 63) (set hasHigh 1) (set c (+ c (pow2 i))))
                      (if (>= (cast Int v) 2) (set hasSym 1) 0)))
                (set i (+ i 1))
              }))
          (if (&& (== hasSym 0) (== hasHigh 0))
              {
                (memSetWord cg 2 (constStr c))
                cg
              }
              (let ((cgR (if (== hasSym 1) (emitEvwRead cg) cg)))
                (let ((src (if (== hasSym 1) (strDup (memGetWord cgR 2)) ""))
                      (mut acc (constStr c))
                      (mut cgX cgR))
                  {
                    (if (== hasHigh 1)
                        (let ((hn (allocReg cgX)))
                          (let ((hr (regStr hn)))
                            (let ((cgH (emitLine cgX (cat2 (cat2 "  " hr)
                                                          " = shl i64 1, 63"))))
                              (let ((on (allocReg cgH)))
                                (let ((orr (regStr on)))
                                  {
                                    (set cgX (emitLine cgH (cat4 (cat3 (cat2 "  " orr)
                                                                       " = or i64 "
                                                                       acc)
                                                                 ", "
                                                                 hr "")))
                                    (set acc orr)
                                    0
                                  })))))
                        0)
                    (let ((mut i2 0))
                      (while (< i2 (vecLen w))
                        {
                          (let ((v2 (cast Int (vecGet w i2))))
                            (if (>= v2 2)
                                (let ((k (- v2 2)))
                                  (let ((an (allocReg cgX)))
                                    (let ((ar (regStr an)))
                                      (let ((cgA (emitLine cgX (cat4 (cat3 (cat2 "  " ar)
                                                                          " = lshr i64 "
                                                                          src)
                                                                    ", "
                                                                    (constStr k) ""))))
                                        (let ((bn (allocReg cgA)))
                                          (let ((br (regStr bn)))
                                            (let ((cgB (emitLine cgA (cat3 (cat2 "  " br)
                                                                          " = and i64 "
                                                                          (cat2 ar ", 1")))))
                                              (let ((sn (allocReg cgB)))
                                                (let ((sr (regStr sn)))
                                                  (let ((cgS (emitLine cgB (cat4 (cat3 (cat2 "  " sr)
                                                                                      " = shl i64 "
                                                                                      br)
                                                                                ", "
                                                                                (constStr i2) ""))))
                                                    (let ((on2 (allocReg cgS)))
                                                      (let ((or2 (regStr on2)))
                                                        {
                                                          (set cgX (emitLine cgS (cat4 (cat3 (cat2 "  " or2)
                                                                                            " = or i64 "
                                                                                            acc)
                                                                                      ", "
                                                                                      sr "")))
                                                          (set acc or2)
                                                          0
                                                        }))))))))))))
                                0))
                          (set i2 (+ i2 1))
                        }))
                    (memSetWord cgX 2 acc)
                    cgX
                  })))
        })))

; Whether function `name` (already mangled) returns a float. Unknown
; names answer 0: a function with no signature cannot traffic in floats,
; because nothing could have told the emitter which of its words are
; bit patterns.
(pub :: fnRetIsFloat (-> Int String Int))
(pub fn (fnRetIsFloat cg name)
  (let ((e (findFSig (memGetWord cg 15) name)))
    (if (== e 0)
        0
        (let ((flags (memGetWord e 2)))
          (if (== flags 0)
              0
              (if (== (vecLen flags) 0)
                  0
                  (vecGet flags (- (vecLen flags) 1))))))))

; Whether parameter `idx` of the function being emitted is a float. The
; last flag is the return type, so a bare-type signature has no
; parameter flags at all.
(pub :: paramIsFloat (-> Int Int Int))
(pub fn (paramIsFloat cg idx)
  (let ((flags (memGetWord cg 18)))
    (if (== flags 0)
        0
        (if (>= idx (- (vecLen flags) 1))
            0
            (vecGet flags idx)))))

(pub :: paramFloatByName (-> Int String Int))
(pub fn (paramFloatByName cg name)
  (let ((params (memGetWord cg 17)))
    (if (== params 0)
        0
        (paramFloatIdx cg params name 0))))

(pub :: paramFloatIdx (-> Int Int String Int Int))
(pub fn (paramFloatIdx cg params name i)
  (if (>= i (vecLen params))
      0
      (if (strEq (vecGet params i) name)
          (paramIsFloat cg i)
          (paramFloatIdx cg params name (+ i 1)))))

; ------------------------------------------------------------------
; Macros were expanded HERE, at emit time, by a substituter that lived
; in this file. They are expanded in `self_host/expand.ax` now, as a
; pass between import resolution and the checker, and this file no
; longer knows what a macro is. Its header records what the move was
; worth; the short version is that emitting an expansion is too late
; to type-check it, and everything a macro generated was therefore
; unchecked.
;
; Field 19 of `CG` held the macro table and is left in place rather
; than reclaimed, for the reason the retired TAG_D_FOREIGN tag number
; is left vacant: a retired slot costs a word, and a recycled one
; turns a stale reader into a silent wrong answer.
; ------------------------------------------------------------------

(pub :: emitLine (-> Int String Int))
(pub fn (emitLine cg line)
  (let ((updated (vecPush (memGetWord cg 0) (strDup line))))
    {
      (memSetWord cg 0 updated)
      cg
    }))

(pub :: allocReg (-> Int Int))
(pub fn (allocReg cg)
  (let ((n (memGetWord cg 1)))
    {
      (memSetWord cg 1 (+ n 1))
      n
    }))

; Integer formatting is `Fmt.fmtInt`. The copy that used to live here
; negated with `(- 0 n)`, which is a no-op on the most negative Int and
; recursed forever on it - the very bug Fmt.ax records having found and
; fixed. One formatter, one fix.
; ------------------------------------------------------------------
; Render accumulated lines into one string.
;
; MEASURE THE WHOLE OUTPUT FIRST, THEN ALLOCATE ONCE.
;
; This used to left-fold `strConcat` over the line vector, which is one
; allocation and one full copy of everything emitted so far per line -
; quadratic in the output, and it was the compiler's dominant cost by an
; enormous margin. `strConcat` allocates from a bump allocator that
; never frees, so nothing is reclaimed between iterations either, and
; the peak is the SUM of every intermediate rather than the largest one.
; Measured on the compiler compiling its own source (1,111,426 bytes of
; IR over 32,593 lines), with `/usr/bin/time -l`:
;
;   fold:  16,973,342,080 bytes peak footprint, 15.63 s
;   join:  see docs/self-hosting.md - two orders of magnitude less
;
; The law is peak ~= (bytes x lines) / 2, so the cost grew with the
; SQUARE of the compiler's own size: every module added to `self_host/`
; paid for itself twice. That is a bad shape for a self-hosted compiler
; to have, independently of the absolute number.
;
; The replacement is the same walk twice - once to add up the lengths,
; once to copy - so it allocates exactly one buffer of exactly the right
; size. Both walks are `while` loops rather than self tail calls for the
; reason `stdlib/Mem.ax` records at length: their depth is the size of
; the data, and stage1 emits no tail-call elimination, so the recursive
; spelling is a real call chain one frame deep per line.
; ------------------------------------------------------------------
(pub :: renderCG (-> Int String))
(pub fn (renderCG cg)
  (joinLines (memGetWord cg 0)))

; The exact size of the joined result: every line plus its newline.
(pub :: joinSize (-> Int Int))
(pub fn (joinSize lines)
  (let ((mut i 0)
        (mut n 0))
    {
      (while (< i (vecLen lines))
        {
          (set n (+ n (+ (strLen (vecGet lines i)) 1)))
          (set i (+ i 1))
        })
      n
    }))

(pub :: joinLines (-> Int String))
(pub fn (joinLines lines)
  (let ((out (strAlloc (joinSize lines)))
        (mut i 0)
        (mut off 0))
    {
      (while (< i (vecLen lines))
        (let ((line (vecGet lines i)))
          {
            (memCopy (+ (strData out) off) (strData line) (strLen line))
            (set off (+ off (strLen line)))
            (__store8 (strData out) off 10)
            (set off (+ off 1))
            (set i (+ i 1))
          }))
      out
    }))

; ------------------------------------------------------------------
; String helpers.
; ------------------------------------------------------------------
(pub :: cat2 (-> String String String))
(pub fn (cat2 a b) (strConcat a b))

(pub :: cat3 (-> String String String String))
(pub fn (cat3 a b c) (strConcat (strConcat a b) c))

(pub :: cat4 (-> String String String String String))
(pub fn (cat4 a b c d)
  (strConcat (strConcat a (strConcat b c)) d))

(pub :: regStr (-> Int String))
(pub fn (regStr n) (cat2 "%t" (fmtInt n)))

(pub :: constStr (-> Int String))
(pub fn (constStr n) (fmtInt n))


; ------------------------------------------------------------------
; String literals.
;
; A literal is interned once per module and emitted as a private global.
; Every byte is written as a hex escape rather than passed through
; literally: the body then contains no quote or backslash that could
; close the constant early, and no judgement is needed about which bytes
; LLVM considers printable.
; ------------------------------------------------------------------
(pub :: internString (-> Int String Int))
(pub fn (internString cg lexeme)
  (let ((tbl (memGetWord cg 10))
        (found (findString tbl lexeme 0)))
    (if (>= found 0)
        found
        (let ((id (vecLen tbl)))
          {
            (vecPush tbl lexeme)
            id
          }))))

(pub :: findString (-> Int String Int Int))
(pub fn (findString tbl s i)
  (if (>= i (vecLen tbl))
      (- 0 1)
      (if (strEq (vecGet tbl i) s)
          i
          (findString tbl s (+ i 1)))))

(pub :: hexDigit (-> Int Int))
(pub fn (hexDigit n)
  (if (< n 10) (+ 48 n) (+ 55 n)))

(pub :: hex2 (-> Int String))
(pub fn (hex2 n)
  (let ((s (strAlloc 2)))
    {
      (__store8 (strData s) 0 (hexDigit (/ n 16)))
      (__store8 (strData s) 1 (hexDigit (% n 16)))
      s
    }))

; The byte a source escape denotes. Anything unrecognised stands for
; itself, which is what `\"` and `\\` need.
; `lexeme` still carries its surrounding quotes, so the body runs from
; index 1 to len-1.
;
; Two passes over the literal, and the reason is a MEASUREMENT. This
; was one pass that grew an accumulator - `(cat3 acc "\\" (hex2 c))`
; per byte - which allocates a fresh string per byte, each about as
; long as everything escaped so far: quadratic in the literal's
; length, and nothing here is freed yet. `self_host/explain.ax` holds
; the longest literals in the tree, and lengthening ONE of them by
; about 1.4 KB - `AX3032`'s text, zero new lines - moved the
; self-compile's peak RSS by 5.3 MiB, from 534 to 539 against
; check-bootstrap's 540 MiB ceiling. That gate's failure text guesses
; "suspect an accumulator that copies", and this was the accumulator.
;
; Counting first costs one allocation-free scan and makes the fill
; linear. What that is worth was much larger than the literal that
; exposed it, because the square was being paid on EVERY literal the
; compiler emits: the same self-compile, same input, went 542 -> 393
; MiB, and the two emit BYTE-IDENTICAL IR. 149 MiB, or 27%, was the
; compiler escaping its own strings a character at a time.
;
; (`llvmSymBody` below still folds this way. It escapes a symbol NAME,
; where the corpus's longest is 48 bytes against this literal's 3,300,
; so the square is not worth a second pass there - recorded so the
; asymmetry reads as a decision.)
(pub :: escBody (-> String Int Int String))
(pub fn (escBody s i limit)
  (let ((out (strAlloc (* 3 (escCount s i limit 0)))))
    { (escFill s i limit (strData out) 0) out }))

; How many BYTES the literal denotes: a source escape is two bytes and
; denotes one, which is why this cannot be `limit - i`.
(pub :: escCount (-> String Int Int Int Int))
(pub fn (escCount s i limit n)
  (if (>= i limit)
      n
      (if (&& (== (strByte s i) 92) (< (+ i 1) limit))
          (escCount s (+ i 2) limit (+ n 1))
          (escCount s (+ i 1) limit (+ n 1)))))

(pub :: escFill (-> String Int Int Int Int Int))
(pub fn (escFill s i limit p o)
  (if (>= i limit)
      o
      (if (&& (== (strByte s i) 92) (< (+ i 1) limit))
          {
            (escPut p o (unescByte (strByte s (+ i 1))))
            (escFill s (+ i 2) limit p (+ o 3))
          }
          {
            (escPut p o (strByte s i))
            (escFill s (+ i 1) limit p (+ o 3))
          })))

; One byte as LLVM's `\XX`, the three characters `emitStringGlobals`
; divides by to recover the count.
(pub :: escPut (-> Int Int Int Int))
(pub fn (escPut p o c)
  {
    (__store8 p o 92)
    (__store8 p (+ o 1) (hexDigit (/ c 16)))
    (__store8 p (+ o 2) (hexDigit (% c 16)))
    0
  })

; ------------------------------------------------------------------
; A user's name, as LLVM has to read it.
;
; LLVM's unquoted identifier is `[-a-zA-Z$._][-a-zA-Z$._0-9]*`. Axiom's
; is deliberately wider: `isIdentChar` (lexer.ax) admits
; `! * + / < > = % & | ' ^` so that `(+ a b)` is a call, `set!` is a
; name and `foo'` is a name. Twelve of those bytes are outside LLVM's
; set, and this file wrote every name out bare, so a program the lexer,
; the parser, the checker, `fmt` and `symbols` all accepted died in
; `opt`:
;
;   define i64 @foo'(i64 %n)
;   opt: error: expected '(' in function argument list
;
; reported as `AX4003 opt failed` against `<toolchain>` - the compiler
; blaming the native tools for its own output, with no span into the
; source, for a program it had just called well typed. Measured one
; probe per shape, as a function name and again as a parameter name:
; `plain` and `x-5` ran and answered 42, and the other twelve exited 4.
; `x-5` survives only because `-` happens to be legal in both sets.
;
; The rule here is LLVM's, written out rather than expressed as "not
; `isIdentChar`". They are two different agreements and each side has
; to be free to move without the other silently following - which is
; the defect this repository keeps finding: the parser and the
; formatter, the lexer and the AXTAG scanner, the server's promises and
; the server's behaviour. Stating LLVM's set here means widening
; Axiom's cannot quietly break the backend.
;
; A name already inside LLVM's set is returned UNCHANGED. Every one of
; the 1,629 top-level names in `stdlib/` and `self_host/` is, and so is
; every `Mod$name` the module mangle produces, because `$` is in both
; sets - so this cannot move the bootstrap's IR by a byte.
(pub :: llvmPlainByte (-> Int Bool))
(pub fn (llvmPlainByte c)
  (if (&& (>= c 97) (<= c 122)) true      ; a-z
  (if (&& (>= c 65) (<= c 90))  true      ; A-Z
  (if (&& (>= c 48) (<= c 57))  true      ; 0-9
  (if (== c 45) true                      ; -
  (if (== c 36) true                      ; $, the module mangle
  (if (== c 46) true                      ; .
  (if (== c 95) true                      ; _
  false))))))))

; A leading digit is refused even though a digit is legal further in:
; `@42` is LLVM's NUMBERED global, which is a different thing from a
; global whose name is "42". `isIdentStart` cannot produce one today
; and this does not rely on that staying true.
(pub :: llvmSymIsPlain (-> String Int Int Bool))
(pub fn (llvmSymIsPlain s i n)
  (if (>= i n)
      true
      (let ((c (strByte s i)))
        (if (llvmPlainByte c)
            (if (&& (== i 0) (&& (>= c 48) (<= c 57)))
                false
                (llvmSymIsPlain s (+ i 1) n))
            false))))

; Inside the quotes LLVM reads `\xx` hex escapes, so the two bytes that
; would end the name early have to become them. Neither `"` nor `\` is
; in `isIdentChar`, so neither is reachable from a source name today;
; they are handled because the quoting rule belongs to LLVM and must
; not depend on where Axiom's set happens to stop.
(pub :: llvmSymBody (-> String Int Int String String))
(pub fn (llvmSymBody s i n acc)
  (if (>= i n)
      acc
      (let ((c (strByte s i)))
        (llvmSymBody s (+ i 1) n
                     (if (|| (== c 34) (== c 92))
                         (cat3 acc "\\" (hex2 c))
                         (cat3 acc (strSlice s i 1) ""))))))

; The empty name quotes rather than emitting a bare sigil: `@` alone is
; not an identifier, and `@""` is.
(pub :: llvmSym (-> String String))
(pub fn (llvmSym name)
  (let ((n (strLen name)))
    (if (&& (> n 0) (llvmSymIsPlain name 0 n))
        name
        (cat3 "\"" (llvmSymBody name 0 n "") "\""))))

; Every byte became exactly three characters, so the byte count is the
; escaped length over three; the array is one longer for the terminator.
(pub :: emitStringGlobals (-> Int Int Int))
(pub fn (emitStringGlobals cg i)
  (let ((tbl (memGetWord cg 10)))
    (if (>= i (vecLen tbl))
        cg
        (let ((lex (vecGet tbl i)))
          (let ((body (escBody lex 1 (- (strLen lex) 1)))) 
            (let ((n (+ (/ (strLen body) 3) 1)))
              {
                (emitLine cg
                  (cat4 (cat3 "@str_" (fmtInt i) " = private unnamed_addr constant [")
                        (cat3 (fmtInt n) " x i8]  c\"" body)
                        "\\00\""
                        ""))
                ; The `Str` header the literal itself evaluates to, over
                ; the bytes just emitted. `n` counts the NUL, the length
                ; word does not.
                ; MM-LIFE-2b statics: the literal's block is laid out
                ; under the same header shape, count all-ones - a
                ; static is never reclaimed and never written, and
                ; retain/release read the sentinel and stop. The
                ; circulating address is element 2, so every consumer
                ; still loads len at +0 and bytes at +8 from the
                ; handle it holds. The fifth word is MM-LIFE-2d's
                ; OWNER (`Str` half): zero, because a literal's bytes
                ; are loader-resident and no block's death may free
                ; them - a slice of a literal inherits that zero and
                ; retains nothing.
                (emitLine cg
                  (cat4 (cat3 "@strhdr_" (fmtInt i)
                              " = private unnamed_addr constant { i64, i64, i64, ptr, i64 } { i64 -1, i64 0, i64 ")
                        (cat3 (fmtInt (- n 1)) ", ptr @str_" (fmtInt i))
                        ", i64 0 }, align 16"
                        ""))
                (emitStringGlobals cg (+ i 1))
              }))))))

; ------------------------------------------------------------------
; Nullary top-level functions read like variables but lower to calls.
; ------------------------------------------------------------------

; The entry file's `main` is EMITTED as `__axiom_user_main`
; (`emitFnDef`, `mangledFor`), but every table the emitter consults -
; the declaration list, the signature vector - still holds the
; declaration's own spelling. A lookup arriving with the emitted
; symbol must ask under the declared name, or a reference to `main`
; misses every known-function arm and falls through to the parameter
; arm, which leaves the bare register `%main` in the IR: `check` said
; OK and `opt` refused (MM-EXEC-15a) - while `mangledFor`'s own
; comment claimed the rename was handled.
(pub :: declSpellingOf (-> String String))
(pub fn (declSpellingOf full)
  (if (strEq full "__axiom_user_main") "main" full))

(pub :: isNullaryFn (-> Int String Bool))
(pub fn (isNullaryFn decls name)
  (if (== decls 0) false (isNullaryFnIn decls (declSpellingOf name) 0)))

(pub :: isNullaryFnIn (-> Int String Int Bool))
(pub fn (isNullaryFnIn decls name i)
  (if (>= i (vecLen decls))
      false
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN)
                (&& (strEq (nodeA d) name) (== (vecLen (nodeB d)) 0)))
            true
        ; A ZERO-ARITY `extern` item is a nullary function too, and
        ; this is the one place that decides so. Without this arm the
        ; reference is emitted as a bare `%name` register that no
        ; instruction defines, and the module dies in `opt` with
        ; "use of undefined value" - the exact failure shape `foreign`
        ; had, arriving through a different door.
        ;
        ; It matters only for arity 0: every other arity reaches
        ; `emitPlainCall` through an application node.
        (if (&& (== (nodeTag d) TAG_D_EXTERN) (externHasNullary (nodeC d) name 0))
            true
            (isNullaryFnIn decls name (+ i 1)))))))

; Whether `name` is an item of this block whose declared type is not an
; arrow - i.e. takes no arguments.
(pub :: externHasNullary (-> Int String Int Bool))
(pub fn (externHasNullary items name i)
  (if (== items 0)
      false
      (if (>= i (vecLen items))
          false
          (let ((f (vecGet items i)))
            ; Either spelling: the Axiom name in slot a, or the LINKER
            ; SYMBOL in slot c. `emitVar` resolves a reference through
            ; `mangledFor` BEFORE asking, and for an extern that map
            ; answers the symbol - so a lookup arriving here is holding
            ; the symbol while the declaration list holds the Axiom
            ; name. This is the same shape the comment above
            ; `declSpellingOf` records for `main`, which is why that
            ; helper exists at all.
            (if (&& (|| (strEq (nodeA f) name) (strEq (nodeC f) name))
                    (== (arrowArity (nodeB f)) 0))
                true
                (externHasNullary items name (+ i 1)))))))

; ------------------------------------------------------------------
; Pre-scan declarations: build the type registry.
; ------------------------------------------------------------------
(pub :: scanDecls (-> Int Int Int Int))
(pub fn (scanDecls decls cg i)
  (if (>= i (vecLen decls)) cg
      (scanDecls decls (scanOne (vecGet decls i) cg) (+ i 1))))

; `(effect E (op :: ...))` registers the effect and every one of its
; operations against one evidence slot.
;
; Registered ONCE per slot, because `scanDecls` runs again before
; every function body - the type registry is rebuilt per function, and
; a second registration here would emit a duplicate evidence global,
; which llc refuses outright rather than tolerating.
(pub :: scanEffect (-> Int Int Int))
(pub fn (scanEffect node cg)
  (let ((tbl (memGetWord cg 32))
        (slot (effSlotFor (nodeA node) (nodeModule node)))
        (isEntry (if (== (nodeModule node) 0) 1 0)))
    (if (effSlotRegistered tbl slot 0)
        cg
        {
          (vecPush tbl (cast Int (EffEnt (nodeA node) slot isEntry)))
          ; The effect's own name under its mangled spelling as well,
          ; for the same reason its operations get one: a `handle`
          ; INSIDE the declaring module must install the slot that
          ; module's operations dispatch on. Resolve the two by
          ; different rules and a module that declares its own
          ; `Console` installs the handler in one global while its own
          ; `log` reads another - the operation finds nothing and traps
          ; on valid source.
          (if (== (nodeModule node) 0)
              0
              (vecPush tbl (cast Int (EffEnt (cat3 (nodeModule node) "$" (nodeA node))
                                             slot isEntry))))
          (scanEffectOps (nodeB node) slot isEntry (nodeModule node)
                         (memGetWord cg 33) 0)
          cg
        })))

; An operation of an imported effect is registered under its bare name
; and under `Mod$op`, because that is what a qualified reference
; resolves to: stage1 spells `EffMod::ask` as the flat name
; `EffMod$ask`, and an `effect` declaration is one of the two kinds
; `mangleDecl` never rewrites. Both spellings dispatch through the one
; slot, which is the only thing that has to be single.
(pub :: scanEffectOps (-> Int String Int a Int Int Int))
(pub fn (scanEffectOps ops slot isEntry modName tbl i)
  (if (>= i (vecLen ops))
      0
      {
        (vecPush tbl (cast Int (EffEnt (vecGet ops i) slot isEntry)))
        (if (== (cast Int modName) 0)
            0
            (vecPush tbl (cast Int (EffEnt (cat3 (cast String modName) "$" (vecGet ops i))
                                           slot isEntry))))
        (scanEffectOps ops slot isEntry modName tbl (+ i 1))
      }))

(pub :: scanOne (-> Int Int Int))
(pub fn (scanOne node cg)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_D_EFFECT)
        (scanEffect node cg)
    (if (== tag TAG_D_DATA)
        (let ((name (nodeA node))
              (ctors (nodeB node)))
          {
            (vecPush (memGetWord cg 35) (cast Int name))
            (scanCtors ctors cg 0 (ctorsRep ctors (memGetWord cg 4))
                       (nodeModule node))
          })
    (if (== tag TAG_D_STRUCT)
        (let ((name (nodeA node))
              (fields (nodeB node))
              (types (memGetWord cg 3)))
          {
            ; A struct's slot 7 holds its FIELD list (mkField nodes:
            ; name and float flag) where a data constructor's holds
            ; float flags alone - the kind decides the reading.
            (memSetWord cg 3 (addQualified
                                (addType types name TF_STRUCT (vecLen fields) 0 0 fields)
                                (nodeModule node) name
                                TF_STRUCT (vecLen fields) 0 0 fields 0 0))
            cg
          })
    cg)))))

(pub :: ctorsHasNullary (-> Int Int Int))
(pub fn (ctorsHasNullary ctors i)
  (if (>= i (vecLen ctors))
      0
      (if (== (nodeB (vecGet ctors i)) 0)
          1
          (ctorsHasNullary ctors (+ i 1)))))

(pub :: ctorsHasBoxed (-> Int Int Int))
(pub fn (ctorsHasBoxed ctors i)
  (if (>= i (vecLen ctors))
      0
      (if (> (nodeB (vecGet ctors i)) 0)
          1
          (ctorsHasBoxed ctors (+ i 1)))))

; The representation code every constructor of one `data` type
; carries: 0 = boxed (no nullary constructor unboxes - the type has
; none, or a tag would reach the 4096 immediate limit), 1 =
; all-nullary (every value IS its tag), 2 = mixed (nullary
; constructors are immediate tags, fieldful ones are heap blocks, and
; a match site telling them apart needs the runtime `< 4096` test -
; every heap address is mmap-page memory at or above it). Mirrors
; stage0's S1 rule exactly; `firstTag` is the counter before this
; type's constructors are assigned.
(pub :: ctorsRep (-> Int Int Int))
(pub fn (ctorsRep ctors firstTag)
  (if (== (ctorsHasNullary ctors 0) 0)
      0
      (if (>= (+ firstTag (vecLen ctors)) 4096)
          0
          (if (== (ctorsHasBoxed ctors 0) 1) 2 1))))

; A SECOND entry for a declaration that arrived through an import,
; under the `Mod$name` spelling a qualified reference is parsed into.
;
; `mangleDecl` renames `fn` and `::` declarations, so `Mod::f` finds a
; declaration whose name already matches. It does not rename `data` or
; `struct`, so `Mod::Ctor` found nothing, and the checker refused a
; program stage0 compiles - measured `AX3001 undefined variable
; Box$Red` against stage0's `OK`. `lookupType` is exact string
; equality over a flat table, so an alias here costs one entry and
; changes no rule: the tag, arity and representation are the SAME
; values, which is what keeps a constructor reached under either
; spelling one constructor rather than two.
(pub :: addQualified (-> Int a String Int Int Int Int Int Int Int Int))
(pub fn (addQualified types modName name kind arity tag rep fieldFlags fieldNames fieldTys)
  (if (== (cast Int modName) 0)
      types
      (addTypeNamed types (cat3 (strDup (cast String modName)) "$" (strDup name))
                    kind arity tag rep fieldFlags fieldNames fieldTys)))

(pub :: scanCtors (-> Int Int Int Int String Int))
(pub fn (scanCtors ctors cg i rep modName)
  (if (>= i (vecLen ctors)) cg
      (let ((node (vecGet ctors i)))
        (let ((n (nodeA node))
              (a (nodeB node))
              (t (memGetWord cg 4))
              (types (memGetWord cg 3)))
          {
            ; `t` is this constructor's tag; the counter is bumped for
            ; the next one. Storing `t - 1` gave the first constructor
            ; of the module tag -1, and `fmtInt` rendered that as `/` -
            ; a stray character in the middle of an argument list.
            (memSetWord cg 4 (+ t 1))
            (memSetWord cg 3 (addQualified
                                (addTypeNamed types n TF_DATA a t rep (nodeC node)
                                              (nodeFieldNames node) (nodeTy node))
                                modName n TF_DATA a t rep (nodeC node)
                                (nodeFieldNames node) (nodeTy node)))
            (scanCtors ctors cg (+ i 1) rep modName)
          }))))

; ------------------------------------------------------------------
; Import resolution: recursively collect declarations from all modules.
;
; Two contracts drive the shape of this code.
;
; `Sys.sysReadFile` takes a raw NUL-terminated char*, not a `Str`
; handle,
; because it hands the pointer straight to `sysOpenPath`. Every path
; therefore crosses the boundary via `strCStr`. Paths built by
; `strConcat` are already NUL-terminated (`strAlloc` reserves len+1 and
; the allocator zeroes), so no extra terminator work is needed. Passing
; a `Str` handle here silently opens garbage and reports every module
; as missing.
;
; `sysReadFile` reports failure as an empty `Str`, never as 0, so
; `strLen == 0` is the "not found" test.
;
; Resolution is diamond-safe: a `seen` Vec of module names ensures each
; module contributes its declarations exactly once. The import graph is
; a DAG with heavily shared nodes -- core, Mem, Str and Vec are each
; reached by several paths -- and emitting a module twice would produce
; duplicate LLVM symbol definitions. Marking a module seen *before*
; recursing into it also makes an import cycle terminate.
; ------------------------------------------------------------------

; An owned copy of `s` with every '.' turned into '/', mapping a dotted
; module path onto a relative file path: Sys.Platform -> Sys/Platform.
; `strDup` gives an owned, NUL-terminated buffer, so rewriting the bytes
; in place cannot disturb the original.
(pub :: modPathToFile (-> String String))
(pub fn (modPathToFile s)
  (let ((out (strDup s)))
    {
      (dotsToSlashes (strData out) 0 (strLen out))
      out
    }))

(pub :: dotsToSlashes (-> Int Int Int Int))
(pub fn (dotsToSlashes p i n)
  (if (>= i n)
      0
      {
        (if (== (__load8 p i) 46) (__store8 p i 47) 0)
        (dotsToSlashes p (+ i 1) n)
      }))

; Source text of module `name`, searching self_host/ then stdlib/.
; Returns 0 when the module resolves to no readable file.
; Source of module `name`, preferring a target-specific file.
;
; `Sys.Platform` resolves to `Sys/Platform.darwin.ax` before
; `Sys/Platform.ax`, the same order stage0 uses, so the syscall tables
; live in Axiom source rather than in a table inside the compiler.
; Without it the platform module resolves to nothing and every constant
; it defines - `sysWrite`, `oRdonly` - is an undefined symbol.
(pub :: readModuleSrc (-> String Int String a))
(pub fn (readModuleSrc name tcode entryDir)
  (let ((p (moduleSrcPath name tcode entryDir)))
    (if (== (strLen p) 0)
        (cast a 0)
        (cast a (sysReadFile (strCStr p))))))

; The path the suffix ladder resolved, or "". A diagnostic about a
; module has to name the FILE, and only the search knows which
; candidate won - `readModuleSrc` used to answer the bytes and throw
; the path away, so an imported module that failed to parse could not
; be reported against anything. The ladder lives here once and
; `readModuleSrc` reads through it, rather than being stated twice.
(pub :: moduleSrcPath (-> String Int String String))
(pub fn (moduleSrcPath name tcode entryDir)
  (let ((stem (modPathToFile name)))
    (let ((a (tryModulePath stem (targetOsArchSuffix tcode) entryDir)))
      (if (> (strLen a) 0)
          a
          (let ((b (tryModulePath stem (targetOsSuffix tcode) entryDir)))
            (if (> (strLen b) 0)
                b
                (tryModulePath stem ".ax" entryDir)))))))

; Every directory a module is looked up in, in order.
;
; This is stage0's `module_search_dirs` reproduced: the entry file's own
; directory first, so a project can shadow a standard-library module
; with its own file of the same name; then `AXIOM_PATH` entries,
; colon-separated, for vendored or generated code; then the standard
; library, located by `AXIOM_STDLIB` or, failing that, relative to the
; compiler binary - `<exe>/../stdlib` for an installed layout and
; `<exe>/../../stdlib` for a build tree.
;
; Before this, stage1 searched the entry directory and then the literal
; strings `self_host/` and `stdlib/` RELATIVE TO ITS WORKING DIRECTORY,
; which is why every gate script salts its work directory with
; `ln -s "$repo_root/stdlib"`. A user compiling a hello-world that
; imports `IO` from any other directory got `cannot read module: IO`
; and exit 3. Probed before the change, from a scratch directory.
;
; Those two CWD-relative entries are kept at the END as a fallback,
; because five harnesses depend on them and breaking all of them in one
; commit destroys the ability to bisect the only gates that watch
; stage1. They are history, not the rule.
;
; `sysArg 0` is argv[0] rather than a real `current_exe`, so a compiler
; invoked by a bare name found on PATH resolves the exe-relative
; entries against the working directory instead. That degrades to the
; old behaviour rather than to something wrong, and `AXIOM_STDLIB`
; overrides it.
(pub :: moduleSearchDirs (-> String Int))
(pub fn (moduleSearchDirs entryDir)
  (let ((v vecNew))
    {
      (vecPush v (cast Int entryDir))
      (pushPathList v (sysEnv "AXIOM_PATH"))
      ; `--crate DIR`: the crate's generated binding module lives in
      ; `DIR/axiom/`, and the driver searches `DIR/target/release` for
      ; its archive - one flag where `AXIOM_PATH`, `--link-search` and
      ; `--link-lib` were three
      (pushCrateDirs v 1)
      (let ((sl (sysEnv "AXIOM_STDLIB")))
        (if (> (strLen sl) 0)
            (vecPush v (cast Int (pathWithSlash sl)))
            (let ((exe (pathDir (sysArg 0))))
              {
                (vecPush v (cast Int (cat2 exe "../stdlib/")))
                (vecPush v (cast Int (cat2 exe "../../stdlib/")))
              })))
      (vecPush v (cast Int "self_host/"))
      (vecPush v (cast Int "stdlib/"))
      v
    }))

; Append each non-empty `:`-separated entry of `list`, slash-terminated.
(pub :: pushPathList (-> Int String Int))
(pub fn (pushPathList v list)
  ; `strSplit` owns the colon scan now. This was one of two open-coded
  ; copies of it - the other is `Sys.sysRunSearch`, which keeps its
  ; own because it stops at the first candidate that runs and building
  ; the whole vector first would open files it never needs.
  ;
  ; Empty entries are dropped HERE rather than by the split, because
  ; the two callers disagree about them: an empty `PATH` entry means
  ; the working directory to `sysRunSearch` and means nothing to a
  ; module search path.
  (let ((parts (strSplit list 58)))
    (pushPathParts v parts 0)))

(pub :: pushPathParts (-> Int Int Int Int))
(pub fn (pushPathParts v parts i)
  (if (>= i (vecLen parts))
      0
      {
        (let ((d (vecGet parts i)))
          (if (> (strLen d) 0)
              (vecPush v (cast Int (pathWithSlash d)))
              0))
        (pushPathParts v parts (+ i 1))
      }))

(pub :: tryModulePath (-> String String String String))
(pub fn (tryModulePath stem suffix entryDir)
  (searchDirsFor (moduleSearchDirs entryDir) (cat2 stem suffix) 0))

; The first search directory in which `base` is a readable, non-empty
; file, or "".
;
; An existing but EMPTY module reads as absent here, which is what the
; predecessor did too - `sysReadFile` answers "" for both - and is
; recorded rather than fixed, because an empty module contributes no
; declarations and so fails identically one step later.
(pub :: searchDirsFor (-> Int String Int String))
(pub fn (searchDirsFor dirs base i)
  (if (>= i (vecLen dirs))
      ""
      (let ((cand (cat2 (vecGet dirs i) base)))
        (if (!= (strLen (cast String (sysReadFile (strCStr cand)))) 0)
            cand
            (searchDirsFor dirs base (+ i 1))))))


; A module that cannot be read or parsed used to be *skipped*, so every
; function it defined surfaced later as `use of undefined value` out of
; llc - a codegen-shaped report for an import-shaped failure, with the
; module's name nowhere in it. That is how `stdlib/Fmt.ax` failing to
; parse presented as `@fmtInt` being undefined in a module that had
; visibly imported it. Refusing at the point of failure names the
; module, and matches the rule held everywhere else: a malformed input
; produces a diagnostic, not something worse further away.
(pub :: dieImport (-> String String Int))
(pub fn (dieImport msg name)
  {
    (sysWriteFd 2 (strData msg) (strLen msg))
    (sysWriteFd 2 (strData name) (strLen name))
    (sysWriteFd 2 (strData "\n") (strLen "\n"))
    ; Exit 3 is this compiler's import-failure code - except under
    ; `symbols`, where stage0 folds EVERY failure into exit 1 and the
    ; parity gate compares statuses. The subcommand is re-derived from
    ; argv here because driver.ax owns `subcommandName` and importing
    ; it from codegen would be a cycle: the first argument not opening
    ; with `-` is the subcommand, the same rule the driver applies.
    (sysExitWith (if (strEq (firstOperandArg 1) "symbols") 1 3))
    0
  })


; An internal invariant, violated, as AX4002.
;
; Reaching codegen with an unknown struct field or a `set` whose target
; is not a `mut` binding means the checker did not fire the diagnostic
; that was supposed to stop it - AX3007 and AX3012 respectively. That is
; literally what AX4002 is for, and it was the other code in the
; registry that neither compiler ever constructed.
;
; The exit status is `dieImport`'s, unchanged, because it is the one
; every gate already expects for a codegen bail-out and this commit is
; about the diagnostic rather than the status.
(pub :: dieCodegenDiag (-> String String Int))
;@axiom:effect(io)
(pub fn (dieCodegenDiag msg name)
  (let ((d (mkDiag SEV_ERROR "AX4002" "codegen-failure" 0
                   (cat2 msg name) 0 0
                   "this is a compiler bug: the check that should have refused this program did not run"))
        (ds vecNew)
        (units vecNew))
    {
      (vecPush ds d)
      (vecPush units (cast Int (CUnit2 "<codegen>" "" (cast String 0))))
      (let ((out (cast String (renderDiagsFormat diagFormatFromArgv ds units))))
        (sysWriteFd 2 (strData out) (strLen out)))
      (sysExitWith (if (strEq (firstOperandArg 1) "symbols") 1 3))
      0
    }))

; Every `--crate DIR` (or `--crate=DIR`) on the command line, as a
; module search directory `DIR/axiom/`.
(pub :: pushCrateDirs (-> Int Int Int))
(pub fn (pushCrateDirs v i)
  (if (>= i (sysArgc))
      0
      (let ((a (sysArg i)))
        (if (strEq a "--crate")
            {
              (if (< (+ i 1) (sysArgc))
                  (vecPush v (cast Int (cat2 (pathWithSlash (sysArg (+ i 1))) "axiom/")))
                  0)
              (pushCrateDirs v (+ i 2))
            }
            (if (strStartsWith a "--crate=")
                {
                  (vecPush v (cast Int (cat2 (pathWithSlash (strSlice a 8 (- (strLen a) 8))) "axiom/")))
                  (pushCrateDirs v (+ i 1))
                }
                (pushCrateDirs v (+ i 1)))))))

; `--emit-staticlib` on the command line: the module is an archive
; for a host, not a program.
(pub :: cgStaticlib Bool)
(pub fn (cgStaticlib) (argHas "--emit-staticlib" 1))

(pub :: argHas (-> String Int Bool))
(pub fn (argHas flag i)
  (if (>= i (sysArgc))
      false
      (if (strEq (sysArg i) flag) true (argHas flag (+ i 1)))))

(pub :: crateDirsOf Int)
(pub fn (crateDirsOf)
  (let ((v vecNew))
    { (collectCrateDirs v 1) v }))

(pub :: collectCrateDirs (-> Int Int Int))
(pub fn (collectCrateDirs v i)
  (if (>= i (sysArgc))
      0
      (let ((a (sysArg i)))
        (if (strEq a "--crate")
            {
              (if (< (+ i 1) (sysArgc)) (vecPush v (cast Int (sysArg (+ i 1)))) 0)
              (collectCrateDirs v (+ i 2))
            }
            (if (strStartsWith a "--crate=")
                { (vecPush v (cast Int (strSlice a 8 (- (strLen a) 8)))) (collectCrateDirs v (+ i 1)) }
                (collectCrateDirs v (+ i 1)))))))

(pub :: firstOperandArg (-> Int String))
(pub fn (firstOperandArg i)
  (if (>= i (sysArgc))
      ""
      (let ((a (sysArg i)))
        (if (strStartsWith a "-")
            (firstOperandArg (+ i 1))
            a))))

; Declaration Vec for module `name`; a module that cannot be read or
; parsed is a fatal diagnostic, never a 0 this returns.
(pub :: parseModuleOrDie (-> String Int String Int))
; As `parseModuleOrDie`, and additionally records the module in the
; UNIT TABLE - the path a diagnostic about this module renders
; against, its text, and its name so the checker can find the index
; from a declaration's `module` stamp.
(pub :: parseModuleOrDieUnit (-> String Int String Int Int))
(pub fn (parseModuleOrDieUnit name tcode entryDir units)
  {
    (if (== (unitIndexOf units name 0) (- 0 1))
        (vecPush units (cast Int (CUnit2 (moduleSrcPath name tcode entryDir)
                                         (readModuleSrc name tcode entryDir)
                                         name)))
        0)
    (parseModuleOrDie name tcode entryDir)
  })

(pub :: unitIndexOf (-> Int String Int Int))
(pub fn (unitIndexOf units name i)
  (if (>= i (vecLen units))
      (- 0 1)
      (if (== (memGetWord (vecGet units i) 2) 0)
          (unitIndexOf units name (+ i 1))
          (if (strEq (memGetWord (vecGet units i) 2) name)
              i
              (unitIndexOf units name (+ i 1))))))

; The unresolvable import is a REAL DIAGNOSTIC now - AX5001,
; spanless, rendered in the chosen format like every other refusal -
; where it used to be a bare "cannot read module" line and exit 3.
; stage0's shape, probed 2026-08-08: `E AX5001 <import>:-
; module-not-found "cannot resolve import \`Name\`"` with one help
; listing every candidate filename and every directory searched, and
; exit 1. The help's paths are THIS binary's search list
; (moduleSearchDirs), so the bytes legitimately differ between two
; differently-located compilers - the pin is structural, in
; check-self-host.sh and check-driver.sh, not a corpus golden.
;
; The format flag is re-derived from argv here for the same reason
; dieImport re-derives the subcommand: driver.ax owns flagValue and
; importing it from codegen would be a cycle. No fallback warning on
; an unknown value - main.ax's diagFormatArg already warned once at
; entry, and warning twice for one typo is chatter.
(pub :: diagFormatFromArgv Int)
(pub fn (diagFormatFromArgv)
  (diagFormatScan 1))

(pub :: diagFormatScan (-> Int Int))
(pub fn (diagFormatScan i)
  (if (>= i (sysArgc))
      FMT_HUMAN
      (let ((a (sysArg i)))
        (if (strEq a "--diagnostic-format")
            (if (< (+ i 1) (sysArgc))
                (let ((c (parseDiagFormatName (sysArg (+ i 1)))))
                  (if (>= c 0) c FMT_HUMAN))
                FMT_HUMAN)
            (if (strStartsWith a "--diagnostic-format=")
                (let ((c (parseDiagFormatName
                           (strSlice a 20 (- (strLen a) 20)))))
                  (if (>= c 0) c FMT_HUMAN))
                (diagFormatScan (+ i 1)))))))

; `looked for 'A' or 'B' or 'C' in 'd1', 'd2', ...` - the same
; candidates and directories readModuleSrc searched, in the same
; order, so the help never claims a search that did not happen.
; Answers the `String` its body always built; the signature said
; `Int` until the checker compared the two (2026-08-21).
(pub :: importHelpText (-> String Int String String))
(pub fn (importHelpText name tcode entryDir)
  (let ((stem (modPathToFile name))
        (dirs (moduleSearchDirs entryDir)))
    (let ((parts vecNew))
      {
        (vecPush parts "looked for '")
        (vecPush parts (cat2 stem (targetOsArchSuffix tcode)))
        (vecPush parts "' or '")
        (vecPush parts (cat2 stem (targetOsSuffix tcode)))
        (vecPush parts "' or '")
        (vecPush parts (cat2 stem ".ax"))
        (vecPush parts "' in ")
        (let ((mut i 0))
          (while (< i (vecLen dirs))
            {
              (if (> i 0) (vecPush parts ", ") 0)
              (vecPush parts "'")
              (vecPush parts (cast Int (vecGet dirs i)))
              (vecPush parts "'")
              (set i (+ i 1))
            }))
        (catStrs parts)
      })))

(pub :: dieImportDiag (-> String Int String Int))
;@axiom:effect(io)
(pub fn (dieImportDiag name tcode entryDir)
  (let ((d (mkDiag SEV_ERROR "AX5001" "module-not-found" 0
                   (cat3 "cannot resolve import `" name "`")
                   0 0 (importHelpText name tcode entryDir)))
        (ds vecNew)
        (units vecNew))
    {
      (vecPush ds d)
      (vecPush units (cast Int (CUnit2 "<import>" "" (cast String 0))))
      (let ((out (cast String (renderDiagsFormat diagFormatFromArgv ds units))))
        (sysWriteFd 2 (strData out) (strLen out)))
      ; Exit 1, stage0's code for this failure. The old 3 had exactly
      ; two consumers, both gates, both updated in this commit; the
      ; `symbols` fold to 1 is now the rule rather than the exception.
      (sysExitWith 1)
      0
    }))

; An IMPORTED module that does not lex or parse, reported the way the
; entry file's failure is reported.
;
; It used to be `dieImport`: `error: cannot parse module: Broken` on fd
; 2, exit 3, no code, no span, no snippet, and byte-identical under
; `--diagnostic-format=json` - while checking that same file DIRECTLY
; gave a complete `AX2001`/`AX2002` with file, line, column, caret and
; help at exit 1. The information was held by the caller and thrown
; away; `dieImportDiag`, three definitions above, already had the right
; shape for the module that could not be FOUND.
;
; This was the last surface untouched by the parse-error port, and it
; is the one a person compiling a multi-module program meets first: it
; is what a compiler prints when a file it was told to read is broken.
(pub :: dieModuleParse (-> String String Int Int Int Int String Int))
;@axiom:effect(io)
(pub fn (dieModuleParse name src toks pr lexD tcode entryDir)
  (let ((path (moduleSrcPath name tcode entryDir))
        (ds vecNew)
        (units vecNew))
    {
      (vecPush ds (if (== lexD 0) (parseErrDiag toks pr src) lexD))
      ; The unit carries the RESOLVED path, not the module name, so the
      ; `-->` line names a file the reader can open.
      (vecPush units (cast Int (CUnit2 path src (cast String 0))))
      (let ((out (cast String (renderDiagsFormat diagFormatFromArgv ds units))))
        (sysWriteFd 2 (strData out) (strLen out)))
      (let ((tr (renderFailTrailer 1)))
        (sysWriteFd 2 (strData tr) (strLen tr)))
      ; Exit 1, the status every other diagnostic exits with and the
      ; one `dieImportDiag` moved to when AX5001 became a real
      ; diagnostic. The old 3 said "import machinery" about what is
      ; simply a syntax error in a file.
      (sysExitWith 1)
      0
    }))

(pub fn (parseModuleOrDie name tcode entryDir)
  (let ((src (readModuleSrc name tcode entryDir)))
    (if (== src 0)
        (dieImportDiag name tcode entryDir)
        ; `parseModuleWith`, not `parseModule`: an imported module's
        ; AXTAGs have to attach to its declarations exactly as the
        ; entry file's do, or `symbols` prints `#effects=IO` beside a
        ; missing `#effect=io` claim and every tag check on imported
        ; code silently never runs.
        (let ((toks (lex (cast String src))))
        (let ((lexD (lexErrDiag toks (cast String src))))
        (let ((pr (if (== lexD 0)
                      (parseModuleWith toks (scanAxtags (cast String src)))
                      (pErr 0))))
          (if (|| (> lexD 0) (== (memGetWord pr 0) 0))
              (dieModuleParse name (cast String src) toks pr lexD tcode entryDir)
              (memGetWord pr 1))))))))

(pub :: seenHas (-> Int String Bool))
(pub fn (seenHas seen name)
  (seenHasIn seen name 0))


; ------------------------------------------------------------------
; Name mangling.
;
; Two modules may export the same name - `IO.ax` and `Sys.ax` once
; both defined `readFile`, since renamed - and emitting both bare
; produced two `define i64 @readFile` in one LLVM module, which `llc`
; rejects. The scheme is stage0's: a declaration imported from module
; `M` defines the symbol `M$name`, a declaration in the entry file
; keeps its bare name - `@main` must stay `@main` for the linker - and
; a bare *reference* resolves through one flat map, entry file first,
; then imports in resolution order. (stage0's checker now refuses a
; bare reference that two imports define and the entry does not -
; AX3014 - so the imports-in-order tail of that rule only decides
; programs stage0 would no longer accept.) `$` and `.` are both legal
; in an unquoted LLVM identifier, so `Sys.Platform$sysWrite` needs no
; quoting.
;
; The map is two Vecs pushed in lockstep rather than a Map, because it
; is small (one entry per top-level function) and built once.
; ------------------------------------------------------------------


; The symbol a bare reference reaches: the DEFINING MODULE'S OWN
; definition when the reference is made inside a module that has one,
; then the entry file's, then the first-resolved import's, and the name
; unchanged when nothing claims it - parameters, locals and primitives
; never enter the map.
;
; The module-local step is what stops an import from changing an
; imported module's behaviour. `Lib.libCall` calling its own `helper`
; reached the ENTRY FILE's `helper` when the entry defined one, in a
; program both compilers accepted and neither diagnosed - so importing
; a module could silently rewrite what that module does. stage0 applies
; the same rule in `mangled_name_for`, and the two have to agree
; symbol for symbol or the fixpoint is comparing different programs.
(pub :: mangledFor (-> Int String String))
(pub fn (mangledFor cg name)
  ; A reference to `main` - a recursive call, or main as a value -
  ; must reach the renamed user function, never the argv wrapper,
  ; which would re-store whatever its two parameters happened to be.
  (if (strEq name "main")
      "__axiom_user_main"
      (let ((m (memGetWord cg 34)))
        (if (== (cast Int m) 0)
            (mangledForIn (memGetWord cg 12) (memGetWord cg 13) name 0)
            (let ((local (cat3 m "$" name)))
              (if (mangleHasIn (memGetWord cg 12) local 0)
                  local
                  (mangledForIn (memGetWord cg 12) (memGetWord cg 13) name 0)))))))

(pub :: mangledForIn (-> Int Int String Int String))
(pub fn (mangledForIn bares fulls name i)
  (if (>= i (vecLen bares))
      name
      (if (strEq (vecGet bares i) name)
          (vecGet fulls i)
          (mangledForIn bares fulls name (+ i 1)))))


; Every entry-file function maps to itself, recorded ahead of every
; import so that a collision resolves to the file being compiled.
(pub :: recordEntryFns (-> Int Int Int Int Int))
(pub fn (recordEntryFns decls bares fulls i)
  (if (>= i (vecLen decls))
      0
      {
        (let ((d (vecGet decls i)))
          (if (== (nodeTag d) TAG_D_FN)
              (mangleRecord bares fulls (nodeA d) (nodeA d))
          ; An `extern` item maps its AXIOM name to its LINKER SYMBOL,
          ; which is what makes the call site need no new code at all:
          ; `mangledFor` already resolves through these two vectors, so
          ; `emitPlainCall` emits its usual `call i64 @<sym>(...)` and
          ; the symbol it names is the Rust one.
          (if (== (nodeTag d) TAG_D_EXTERN)
              (recordExternSyms bares fulls (nodeC d) 0)
              0)))
        (recordEntryFns decls bares fulls (+ i 1))
      }))

(pub :: recordExternSyms (-> Int Int Int Int Int))
(pub fn (recordExternSyms bares fulls items i)
  (if (== items 0)
      0
      (if (>= i (vecLen items))
          0
          {
            ; a = the Axiom name, c = the `(symbol "s")` clause the
            ; parser resolved (defaulting to the Axiom name).
            (let ((f (vecGet items i)))
              (mangleRecord bares fulls (nodeA f) (nodeC f)))
            (recordExternSyms bares fulls items (+ i 1))
          })))

(pub :: resolveImports (-> Int Int Int Int Int String Int Int))
(pub fn (resolveImports decls bares fulls mods tcode entryDir units)
  {
    (recordEntryFns decls bares fulls 0)
    (resolveDecls decls vecNew vecNew 0 (cast String 0) bares fulls mods 0 tcode entryDir units)
  })

; Append every non-import declaration reachable from `decls` onto `acc`,
; depth-first so that a module's dependencies land ahead of it.
; `modName` is the module the list came from, 0 for the entry file; an
; imported function is renamed to `modName$name` as it lands.
;
; `filter` is the import's name list, 0 when the import named none:
; `(import M (a b))` splices only M's declarations named `a` or `b`,
; exactly as stage0 filters through its `wanted` set - including the
; harsh part, where a kept function's un-named private helpers vanish
; with it. M's own nested imports are processed regardless: in stage0
; they live outside the filtered declaration list, so a name list never
; suppresses a dependency.
;
; `acc` and `seen` are threaded rather than rebuilt: `vecPush` mutates in
; place and returns the same handle, so both stay stable across the whole
; traversal and siblings observe each other's additions.
(pub :: resolveDecls (-> Int Int Int Int String Int Int Int Int Int String Int Int))
(pub fn (resolveDecls decls acc seen i modName bares fulls mods filter tcode entryDir units)
  ; Two passes: stage0 partitions a module's imports into
  ; `Module::imports` and resolves ALL of them before any of the
  ; module's own declarations, at every level. Splicing an import at
  ; its source position agreed with stage0 on every file whose imports
  ; sit at the top - which is nearly all of them - and diverged the
  ; program's declaration order on the ones with a mid-file import,
  ; found when Sys.ax (a late `(import Mem)`) met the `symbols`
  ; differential: stage0 listed Mem's functions before Sys's own, this
  ; resolver the other way round.
  (resolveDeclsPhase decls
    (resolveDeclsPhase decls acc seen i modName bares fulls mods filter tcode entryDir units 0)
    seen i modName bares fulls mods filter tcode entryDir units 1))

; One pass: phase 0 consumes only the `(import ...)` entries (each
; imported module resolving BOTH its phases depth-first), phase 1 only
; the module's own declarations.
(pub :: resolveDeclsPhase (-> Int Int Int Int String Int Int Int Int Int String Int Int Int))
(pub fn (resolveDeclsPhase decls acc seen i modName bares fulls mods filter tcode entryDir units phase)
  (if (>= i (vecLen decls)) acc
      (let ((first (vecGet decls i)))
        (if (== (nodeTag first) TAG_D_IMPORT)
            (if (== phase 1)
                (resolveDeclsPhase decls acc seen (+ i 1) modName bares fulls mods filter tcode entryDir units phase)
                (let ((name (memGetWord first 1)))
                  (if (seenHas seen name)
                      (resolveDeclsPhase decls acc seen (+ i 1) modName bares fulls mods filter tcode entryDir units phase)
                      {
                        (vecPush seen name)
                        (let ((modDecls (parseModuleOrDieUnit name tcode entryDir units))
                              (subFilter (let ((ns (nodeB first)))
                                           (if (== ns 0)
                                               0
                                               (if (== (vecLen ns) 0) 0 ns)))))
                          {
                          ; The import's name list, recorded against
                          ; the module it filtered. A module is merged
                          ; exactly once (the `seen` test above), so
                          ; there is exactly one filter per module -
                          ; and phase D needs it, because a
                          ; declaration a macro generates INSIDE this
                          ; module does not exist yet when the filter
                          ; is applied here (MAC-EXP-16).
                          (modFilterRecord mods name subFilter)
                          (resolveDeclsPhase decls
                                        (resolveDecls modDecls acc seen 0 name bares fulls mods subFilter tcode entryDir units)
                                        seen
                                        (+ i 1)
                                        modName bares fulls mods filter tcode entryDir units phase)
                          })
                      })))
            (if (== phase 0)
                (resolveDeclsPhase decls acc seen (+ i 1) modName bares fulls mods filter tcode entryDir units phase)
                ; `pub` and the import's name list decide which BARE
                ; NAMES are visible, not which declarations exist. They
                ; used to decide both, through this one `if`, and the
                ; two are different things: the module's public bodies
                ; were spliced and the declarations they call were
                ; dropped, so a module with a private helper was a
                ; module nobody could import - it failed with AX3001 at
                ; ITS OWN lines, in a file that merely read it.
                ;
                ; Worse where the importing program happened to define
                ; the same name: the dropped declaration left the bare
                ; slot free, the importer's definition claimed it, and
                ; the imported module's own call landed on it. Measured
                ; on `(import IO (println))` beside an entry-file
                ; `writeStr`: the standard library printed the entry
                ; file's bytes, twice, at exit 0, with no diagnostic
                ; from any pass. Importing a module could rewrite what
                ; that module does.
                ;
                ; So every declaration is carried, and `exported` -
                ; recorded on the node, where the checker reads it -
                ; says whether anything outside may name it.
                (let ((exported (if (&& (filterKeeps filter (nodeA first))
                                        (|| (== (cast Int modName) 0) (== (nodeVis first) 1)))
                                    1
                                    0)))
                  {
                    ; Provenance, recorded before mangling rewrites the
                    ; name: this is the only point in the pipeline that
                    ; knows which module a declaration came from.
                    (memSetWord first 8 modName)
                    ; From here on word 5 answers "may a reference from
                    ; outside this module name it", not "was it written
                    ; `pub`". The entry file's own declarations are all
                    ; visible; nothing imports them.
                    (memSetWord first 5 exported)
                    (mangleDecl first modName bares fulls exported)
                    (resolveDeclsPhase decls (vecPush acc first) seen (+ i 1) modName bares fulls mods filter tcode entryDir units phase)
                  }))))))



; ------------------------------------------------------------------
; Targets.
;
; Everything per-target in one place, mirroring stage0's
; `axiom-codegen/src/target.rs` value for value: the triple, the
; syscall inline-assembly (register conventions differ per arch, and
; Darwin returns a positive errno with the carry flag set where Linux
; returns -errno, so the Darwin templates branch on carry and negate -
; `result < 0` is then a complete failure test on all four targets),
; the mmap/exit syscall numbers (Darwin's carry the 0x2000000 Unix
; class bit), the MAP_PRIVATE|MAP_ANON flag value, and the platform
; module suffixes. Codes: 0 darwin-aarch64, 1 darwin-x86_64,
; 2 linux-aarch64, 3 linux-x86_64; -1 is "unknown", refused loudly.
; ------------------------------------------------------------------

(pub :: targetCode (-> String Int))
(pub fn (targetCode name)
  (if (strEq name "darwin-aarch64") 0
  (if (strEq name "darwin-x86_64") 1
  (if (strEq name "linux-aarch64") 2
  (if (strEq name "linux-x86_64") 3
  (- 0 1))))))

(pub :: targetTriple (-> Int String))
(pub fn (targetTriple t)
  (if (== t 0) "arm64-apple-macosx14.0.0"
  (if (== t 1) "x86_64-apple-macosx14.0.0"
  (if (== t 2) "aarch64-unknown-linux-gnu"
  "x86_64-unknown-linux-gnu"))))

; The `"body", "constraints"` middle of a syscall call instruction,
; escaped and quoted ready to sit between `asm sideeffect ` and the
; argument list. One fragment per target, byte-for-byte the strings
; stage0 emits.
(pub :: targetSyscallAsm (-> Int String))
(pub fn (targetSyscallAsm t)
  ; The argument registers are CLOBBERS as well as inputs on arm64,
  ; because Darwin's `svc` destroys them - probed, x1 comes back 0.
  ; Without this LLVM keeps a value in an argument register across the
  ; syscall at -O1 and above, which set `@__axiom_bump_end` to
  ; `addr + 0` and made every allocation map a fresh megabyte. stage0
  ; carries the same clobbers and the same explanation.
  ;
  ; `~{cc}` is on every template for the same reason one register
  ; short of it already shipped a bug: the Darwin kernel answers
  ; through the CARRY FLAG (the templates' own `b.cc`/`jnc` read it),
  ; and with no flags clobber declared, a countdown loop with a
  ; syscall in its body compiled to an `adds` before the `svc` and
  ; its `b.lo` after - an infinite loop, measured 2026-08-07 at every
  ; opt level. Linux preserves the flags; the clobber is kept anyway,
  ; because an ABI assumption is exactly what failed here.
  ;
  ; linux-x86_64 also declares its argument registers clobbered now,
  ; matching stage0's STRING (stage0's comment claimed the narrow
  ; list while its string had been widened; the two compilers must
  ; match the string, because the string is what compiles).
  (if (== t 0) "\"svc #0x80\\0Ab.cc 1f\\0Aneg x0, x0\\0A1:\", \"={x0},{x16},{x0},{x1},{x2},{x3},{x4},{x5},~{x1},~{x2},~{x3},~{x4},~{x5},~{x16},~{cc},~{memory}\""
  ; Darwin/x86-64 declares its argument registers clobbered, as
  ; Darwin/arm64 does and as Linux deliberately does not: Linux
  ; documents that it preserves everything but rax/rcx/r11, Darwin
  ; documents nothing and on arm64 demonstrably destroys them. `rdx`
  ; is Darwin's second return register, so the kernel writes it while
  ; `{dx}` is listed here as a live input.
  (if (== t 1) "\"syscall\\0Ajnc 1f\\0Anegq %rax\\0A1:\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rdi},~{rsi},~{rdx},~{r10},~{r8},~{r9},~{rcx},~{r11},~{cc},~{memory}\""
  (if (== t 2) "\"svc #0\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{x1},~{x2},~{x3},~{x4},~{x5},~{x8},~{cc},~{memory}\""
  "\"syscall\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rdi},~{rsi},~{rdx},~{r10},~{r8},~{r9},~{rcx},~{r11},~{cc},~{memory}\""))))

(pub :: targetMmapNum (-> Int Int))
(pub fn (targetMmapNum t)
  (if (== t 0) 33554629
  (if (== t 1) 33554629
  (if (== t 2) 222
  9))))

; The number the emitted abort paths - allocator OOM, arena OOM, and an
; unhandled effect - exit through. It must be the one `Sys.Platform`
; picks, and on Linux it was not: this returned 93 and 60, which are
; `exit`, while `Platform.linux-aarch64.ax` returns 94 and
; `Platform.linux-x86_64.ax` returns 231, which are `exit_group`. The
; aarch64 module states the rule in as many words - "exit_group (94),
; not exit (93)" - and the compiler emitted 93 anyway, so the two
; implementations of "how this platform exits" disagreed with each
; other while agreeing on darwin, where 33554433 is the only spelling.
;
; Latent rather than live: `exit` ends the calling thread, and nothing
; Axiom emits has a second one, so the process dies either way. It stops
; being latent the moment one of these programs has two threads, and
; the failure then is a process that aborts and stays alive.
(pub :: targetExitNum (-> Int Int))
(pub fn (targetExitNum t)
  (if (== t 0) 33554433
  (if (== t 1) 33554433
  (if (== t 2) 94
  231))))

; `write`, per target, for the runtime traps. Darwin BSD 4 is
; 0x2000004; linux-x86_64 is 1 and linux-aarch64 is 64.
(pub :: targetWriteNum (-> Int Int))
(pub fn (targetWriteNum t)
  (if (== t 0) 33554436
  (if (== t 1) 33554436
  (if (== t 2) 64
  1))))

(pub :: targetMapFlags (-> Int Int))
(pub fn (targetMapFlags t)
  (if (|| (== t 0) (== t 1)) 4098 34))

; Platform module suffixes, most specific first: `.{os}-{arch}.ax`,
; then `.{os}.ax`, then `.ax` - the same order stage0 searches.
(pub :: targetOsArchSuffix (-> Int String))
(pub fn (targetOsArchSuffix t)
  (if (== t 0) ".darwin-aarch64.ax"
  (if (== t 1) ".darwin-x86_64.ax"
  (if (== t 2) ".linux-aarch64.ax"
  ".linux-x86_64.ax"))))

(pub :: targetOsSuffix (-> Int String))
(pub fn (targetOsSuffix t)
  (if (|| (== t 0) (== t 1)) ".darwin.ax" ".linux.ax"))

; ------------------------------------------------------------------
; The allocator, emitted rather than linked.
;
; A program stage1 compiles has to stand on its own: `axiom_alloc` is
; what every constructor and every `Str` goes through, and nothing else
; in the output defines it. This is the same `mmap`-backed bump
; allocator the Rust backend emits, parameterized by the target the
; driver named.
; ------------------------------------------------------------------
(pub :: emitAllocator (-> Int Int))
(pub fn (emitAllocator cg)
  {
    ; The process's arguments, captured by the `@main` wrapper below
    ; before the user's (renamed) main runs; `__argc`/`__argv` read
    ; them back. Matches stage0's convention exactly - the C runtime
    ; calls main(argc, argv), and before the wrapper existed those
    ; two values arrived silently in whatever register the first
    ; parameter happened to occupy.
    (emitLine cg "@__axiom_argc = internal global i64 0")
    (emitLine cg "@__axiom_argv = internal global i64 0")
    (emitLine cg "")
    ; A STATIC ARCHIVE (`--emit-staticlib`) has no `main`: the host that
    ; links it has its own, and the module's `pub fn`s are what it
    ; calls. The runtime below is emitted in full - the allocator
    ; initialises on first use, so the host needs no init call.
    (if (cgStaticlib)
        0
        {
          (emitLine cg "define i64 @main(i64 %argc, i64 %argv) #0 {")
          (emitLine cg "entry:")
          (emitLine cg "  store i64 %argc, ptr @__axiom_argc")
          (emitLine cg "  store i64 %argv, ptr @__axiom_argv")
          (emitLine cg "  %r = call i64 @__axiom_user_main()")
          (emitLine cg "  ret i64 %r")
          (emitLine cg "}")
          (emitLine cg "")
        })
    (emitLine cg "@__axiom_bump = internal global i64 0")
    (emitLine cg "@__axiom_bump_end = internal global i64 0")
    ; Every mapped chunk carries a two-word header - its total size and
    ; the chunk mapped before it - so the chunks form a list in
    ; allocation order. `@__axiom_chunk` is its head; a reset walks it
    ; back to the marked chunk and moves what it passes onto
    ; `@__axiom_free`, where the next refill finds it. Without the list
    ; a reset could only restore a waterline, so every chunk mapped
    ; after the mark was stranded: 576 KiB per iteration measured on a
    ; loop whose body crosses a chunk boundary.
    (emitLine cg "@__axiom_chunk = internal global i64 0")
    (emitLine cg "@__axiom_free = internal global i64 0")
    ; How far into the current chunk memory has ever been handed out.
    ; Above it is still the zeroes `mmap` gave us; below it is whatever
    ; the program wrote, and has to be scrubbed before it is handed out
    ; again - see `handout`.
    (emitLine cg "@__axiom_high = internal global i64 0")
    ; MM-LIFE-2e: one free-list head per 16-byte size class, classes
    ; 16..65536 (index = size/16; slot 0 unused). Release at zero
    ; pushes a block - header included - onto its class; the
    ; allocator pops before bumping. EXACT-size classes, so reuse
    ; never splits a block and MM-ALLOC-3's alignment holds by
    ; construction.
    ;
    ; The ceiling was 1024 bytes until 2026-08-15, and the measurement
    ; that moved it is a cliff: 20,000 iterations of a tail loop
    ; allocating one string and dropping the previous one peak at
    ; 1,312 KiB for a 1008-byte payload and 21,936 KiB for a 1024-byte
    ; one - a program whose buffers are a kilobyte and a byte
    ; reclaimed NOTHING, and its RSS tracked the iteration count
    ; rather than the live set. At 8 KiB the same loop was 162,560 KiB
    ; and is now 1,328 KiB, and FASTER (0.27s against 0.44s): reusing
    ; a hot block beats faulting fresh pages, so the handout scrub is
    ; more than repaid.
    ;
    ; 64 KiB rather than the 262,128 the shape word's count field can
    ; describe, because the wider array was measured to buy nothing: a
    ; self-compile peaks at 534.3 MB under both, and at 1 KiB, since
    ; nothing large DIES in it - the compiler's own containers are
    ; Int-typed and events 2 and 3 do not emit. What the ceiling costs
    ; is this array (4097 words of BSS, 352 bytes of binary) and the
    ; per-reset scrub below.
    (emitLine cg "@__axiom_slabs = internal global [4097 x i64] zeroinitializer")
    (emitLine cg "")
    (emitLine cg "define i64 @axiom_alloc(i64 %size) #0 {")
    (emitLine cg "entry:")
    ; A zero-byte request keeps its MM-ALLOC-8b behavior exactly: the
    ; unadvanced bump, no chunk mapped, no header written - a 0-byte
    ; block is not a counted block, and 160-arena's waterline probe
    ; spends that rule.
    (emitLine cg "  %iszero = icmp eq i64 %size, 0")
    (emitLine cg "  br i1 %iszero, label %zero, label %sized")
    (emitLine cg "zero:")
    (emitLine cg "  %zb = load i64, ptr @__axiom_bump")
    (emitLine cg "  ret i64 %zb")
    (emitLine cg "sized:")
    (emitLine cg "  %padded = add i64 %size, 15")
    (emitLine cg "  %sz0 = and i64 %padded, -16")
    ; MM-LIFE-2b: the 16-byte count/shape header below every counted
    ; block - one rounding step, never more.
    (emitLine cg "  %sz = add i64 %sz0, 16")
    ; The pop path re-enters `handout` like any other landing: the
    ; recycled block sits below the high-water mark, so the existing
    ; scrub wipes its old contents - link word included - and
    ; `wiped` rewrites the header. Zeroing (MM-ALLOC-6) is the same
    ; promise on the same path.
    (emitLine cg "  %small = icmp ule i64 %sz0, 65536")
    (emitLine cg "  br i1 %small, label %try_pop, label %bump_path")
    (emitLine cg "try_pop:")
    (emitLine cg "  %cls = lshr i64 %sz0, 4")
    (emitLine cg "  %slotp = getelementptr [4097 x i64], ptr @__axiom_slabs, i64 0, i64 %cls")
    (emitLine cg "  %shead = load i64, ptr %slotp")
    (emitLine cg "  %sempty = icmp eq i64 %shead, 0")
    (emitLine cg "  br i1 %sempty, label %bump_path, label %pop")
    (emitLine cg "pop:")
    (emitLine cg "  %pnextp = inttoptr i64 %shead to ptr")
    (emitLine cg "  %pnext = load i64, ptr %pnextp")
    (emitLine cg "  store i64 %pnext, ptr %slotp")
    (emitLine cg "  %pe = add i64 %shead, %sz")
    (emitLine cg "  %ph = load i64, ptr @__axiom_high")
    (emitLine cg "  br label %handout")
    (emitLine cg "bump_path:")
    (emitLine cg "  %cur = load i64, ptr @__axiom_bump")
    (emitLine cg "  %next = add i64 %cur, %sz")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %fits = icmp ule i64 %next, %end")
    (emitLine cg "  br i1 %fits, label %fast, label %refill")
    (emitLine cg "fast:")
    (emitLine cg "  store i64 %next, ptr @__axiom_bump")
    (emitLine cg "  %high = load i64, ptr @__axiom_high")
    (emitLine cg "  br label %handout")
    (emitLine cg "refill:")
    (emitLine cg "  %need = add i64 %sz, 16")
    (emitLine cg "  %big = icmp ugt i64 %need, 1048576")
    (emitLine cg "  %rounded0 = add i64 %need, 65535")
    (emitLine cg "  %rounded = and i64 %rounded0, -65536")
    (emitLine cg "  %chunk = select i1 %big, i64 %rounded, i64 1048576")
    ; First fit over the chunks a reset has freed. The list is short -
    ; it holds only what outlived a mark - and a chunk on it is a whole
    ; mapping, so reuse is what keeps a resetting loop's RSS flat
    ; rather than merely its waterline.
    (emitLine cg "  %fhead = load i64, ptr @__axiom_free")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg "  %cand = phi i64 [ %fhead, %refill ], [ %cnext, %scan_next ]")
    (emitLine cg "  %prev = phi i64 [ 0, %refill ], [ %cand, %scan_next ]")
    (emitLine cg "  %exhausted = icmp eq i64 %cand, 0")
    (emitLine cg "  br i1 %exhausted, label %map, label %scan_test")
    (emitLine cg "scan_test:")
    (emitLine cg "  %candp = inttoptr i64 %cand to ptr")
    (emitLine cg "  %candsz = load i64, ptr %candp")
    (emitLine cg "  %candlink = add i64 %cand, 8")
    (emitLine cg "  %candlinkp = inttoptr i64 %candlink to ptr")
    (emitLine cg "  %cnext = load i64, ptr %candlinkp")
    (emitLine cg "  %roomy = icmp uge i64 %candsz, %chunk")
    (emitLine cg "  br i1 %roomy, label %unlink, label %scan_next")
    (emitLine cg "scan_next:")
    (emitLine cg "  br label %scan")
    (emitLine cg "unlink:")
    (emitLine cg "  %cand_end = add i64 %cand, %candsz")
    (emitLine cg "  %at_head = icmp eq i64 %prev, 0")
    (emitLine cg "  br i1 %at_head, label %unlink_head, label %unlink_mid")
    (emitLine cg "unlink_head:")
    (emitLine cg "  store i64 %cnext, ptr @__axiom_free")
    (emitLine cg "  br label %install")
    (emitLine cg "unlink_mid:")
    (emitLine cg "  %prevlink = add i64 %prev, 8")
    (emitLine cg "  %prevlinkp = inttoptr i64 %prevlink to ptr")
    (emitLine cg "  store i64 %cnext, ptr %prevlinkp")
    (emitLine cg "  br label %install")
    (emitLine cg "map:")
    (emitLine cg (strConcat
                   (cat4 "  %addr = call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetMmapNum (memGetWord cg 26))))
                   (cat3 ", i64 0, i64 %chunk, i64 3, i64 "
                         (fmtInt (targetMapFlags (memGetWord cg 26)))
                         ", i64 -1, i64 0)")))
    (emitLine cg "  %failed_low = icmp ult i64 %addr, 4096")
    (emitLine cg "  %failed_neg = icmp ugt i64 %addr, -4096")
    (emitLine cg "  %failed = or i1 %failed_low, %failed_neg")
    (emitLine cg "  br i1 %failed, label %oom, label %mapped")
    (emitLine cg "mapped:")
    (emitLine cg "  %virgin_high = add i64 %addr, 16")
    (emitLine cg "  br label %install")
    ; Link the chunk - mapped or recycled - onto the active list and
    ; allocate out of it. The header sits at the base, so the address
    ; handed back is base + 16. `%chunk_high` is the chunk's high water
    ; BEFORE this request: a recycled chunk is dirty to its last byte,
    ; a fresh mapping is the kernel's zeroes all the way down.
    (emitLine cg "install:")
    (emitLine cg "  %base = phi i64 [ %addr, %mapped ], [ %cand, %unlink_head ], [ %cand, %unlink_mid ]")
    (emitLine cg "  %bsize = phi i64 [ %chunk, %mapped ], [ %candsz, %unlink_head ], [ %candsz, %unlink_mid ]")
    (emitLine cg "  %chunk_high = phi i64 [ %virgin_high, %mapped ], [ %cand_end, %unlink_head ], [ %cand_end, %unlink_mid ]")
    (emitLine cg "  %basep = inttoptr i64 %base to ptr")
    (emitLine cg "  store i64 %bsize, ptr %basep")
    (emitLine cg "  %baselink = add i64 %base, 8")
    (emitLine cg "  %baselinkp = inttoptr i64 %baselink to ptr")
    (emitLine cg "  %chead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  store i64 %chead, ptr %baselinkp")
    (emitLine cg "  store i64 %base, ptr @__axiom_chunk")
    (emitLine cg "  %data = add i64 %base, 16")
    (emitLine cg "  %new_bump = add i64 %data, %sz")
    (emitLine cg "  store i64 %new_bump, ptr @__axiom_bump")
    (emitLine cg "  %new_end = add i64 %base, %bsize")
    (emitLine cg "  store i64 %new_end, ptr @__axiom_bump_end")
    (emitLine cg "  br label %handout")
    ; Both paths converge here to hand out `[%hb, %he)`. Memory below
    ; the high-water mark has been handed out before, so it holds
    ; whatever the program last wrote and has to be scrubbed:
    ; `memAlloc` promises ZEROED memory and the standard library spends
    ; that promise - `Map` and `Intern` read an all-zero state array as
    ; "every slot empty", `strAlloc` reserves a byte for its NUL
    ; terminator and never writes one. A fresh mapping arrives zeroed
    ; from the kernel, so the promise used to hold for free and
    ; silently stopped the moment a reset handed the same bytes out
    ; twice: `strAlloc 3` after a reset measured a `cstrLen` of 17.
    ;
    ; Scrubbing HERE rather than in the reset is what lets §4.1's
    ; copy-at-boundary work: the value being copied down sits above the
    ; restored waterline, in memory the reset gave back, and must
    ; survive being read until the copy finishes.
    ; A RECYCLED block is dirty to its last byte and belongs to
    ; whichever chunk it was allocated from, so neither of the
    ; watermark's two jobs applies to it.
    ;
    ; `@__axiom_high` describes the CURRENT chunk - `install` resets it
    ; to the new chunk's base and a reset rewinds it - while a block on
    ; a size-class free list may have come from any chunk the program
    ; has ever mapped. Comparing the two is comparing addresses from
    ; different mappings, and mmap does not promise they ascend. Where
    ; the popped block sits above the current chunk's watermark, the
    ; old `%stop` came out BELOW `%hb`, the wipe loop ran zero times,
    ; and the block was handed back with its previous contents -
    ; against MM-ALLOC-6, which `strAlloc` (never writes its NUL) and
    ; `Map`/`Intern` (read all-zero as "empty") both spend. The same
    ; comparison then stored a foreign address into the watermark.
    ;
    ; So the pop path scrubs the whole block and leaves the watermark
    ; alone. It costs nothing in the cases that were already right: for
    ; a popped block below the watermark `%bstop` was `%he` already.
    ; This is a pre-existing hazard - the pop path has always compared
    ; these two - which raising the pool ceiling to 64 KiB widened from
    ; blocks under 1 KiB to blocks under 64 KiB.
    (emitLine cg "handout:")
    (emitLine cg "  %hb = phi i64 [ %cur, %fast ], [ %data, %install ], [ %shead, %pop ]")
    (emitLine cg "  %he = phi i64 [ %next, %fast ], [ %new_bump, %install ], [ %pe, %pop ]")
    (emitLine cg "  %hh = phi i64 [ %high, %fast ], [ %chunk_high, %install ], [ %ph, %pop ]")
    (emitLine cg "  %recyc = phi i1 [ false, %fast ], [ false, %install ], [ true, %pop ]")
    (emitLine cg "  %past = icmp ugt i64 %he, %hh")
    (emitLine cg "  %bstop = select i1 %past, i64 %hh, i64 %he")
    (emitLine cg "  %stop = select i1 %recyc, i64 %he, i64 %bstop")
    (emitLine cg "  %nh = select i1 %past, i64 %he, i64 %hh")
    (emitLine cg "  %newhigh = select i1 %recyc, i64 %hh, i64 %nh")
    (emitLine cg "  store i64 %newhigh, ptr @__axiom_high")
    (emitLine cg "  br label %wipe")
    (emitLine cg "wipe:")
    (emitLine cg "  %wi = phi i64 [ %hb, %handout ], [ %wnext, %wipe_body ]")
    (emitLine cg "  %wmore = icmp ult i64 %wi, %stop")
    (emitLine cg "  br i1 %wmore, label %wipe_body, label %wiped")
    (emitLine cg "wipe_body:")
    (emitLine cg "  %wp = inttoptr i64 %wi to ptr")
    (emitLine cg "  store i64 0, ptr %wp")
    (emitLine cg "  %wnext = add i64 %wi, 8")
    (emitLine cg "  br label %wipe")
    (emitLine cg "wiped:")
    ; The count word, explicitly zero, and the LEAF shape:
    ; MM-LIFE-2b says a block that does not record its own size makes
    ; the release path unimplementable, and only the allocator knows
    ; the size of a raw allocation. MM-LIFE-2d's encoding: bit 0 the
    ; form (0 = record), bits 1..15 the padded payload WORD count,
    ; bits 16..62 the reference bitmap - which the allocator leaves
    ; EMPTY, because it cannot know a field from an int. memAlloc'd
    ; memory is therefore a leaf by construction, the unsafe layer's
    ; own rule; monomorphic construction sites overwrite the word
    ; with their record shape. A payload past 32767 words overflows
    ; the count field and stores 0 - the unknown-size sentinel
    ; release refuses to file (262KB read buffers exist; the clamp is
    ; not decorative).
    (emitLine cg "  %cwp = inttoptr i64 %hb to ptr")
    (emitLine cg "  store i64 0, ptr %cwp")
    (emitLine cg "  %shpw = add i64 %hb, 8")
    (emitLine cg "  %shpwp = inttoptr i64 %shpw to ptr")
    (emitLine cg "  %wcnt = lshr i64 %sz0, 3")
    (emitLine cg "  %wbig = icmp ugt i64 %wcnt, 32767")
    (emitLine cg "  %wleaf = select i1 %wbig, i64 0, i64 %wcnt")
    (emitLine cg "  %wshp = shl i64 %wleaf, 1")
    (emitLine cg "  store i64 %wshp, ptr %shpwp")
    (emitLine cg "  %user = add i64 %hb, 16")
    (emitLine cg "  ret i64 %user")
    (emitLine cg "oom:")
    (emitLine cg (strConcat
                   (cat4 "  call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetExitNum (memGetWord cg 26))))
                   ", i64 70, i64 0, i64 0, i64 0, i64 0, i64 0)"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    ; MM-LIFE-2b's other two owners of the header. Emitted, exempted,
    ; and - in this slice - called only by the `__retain`/`__release`
    ; primitives a fixture spends; the ownership events of MM-LIFE-2c
    ; are what will make the compiler call them. Three exemptions,
    ; each by a test that already exists: an immediate is skipped with
    ; the SAME signed compare a mixed-representation match emits
    ; (MM-VAL-9's `icmp slt`), a static's all-ones count is read and
    ; never written, and a count of zero is never decremented -
    ; 0 - 1 IS the statics sentinel, so an unbalanced release must
    ; not be able to forge one (the double-release stays a no-op the
    ; fixture can observe, instead of an immortal block it cannot).
    (emitLine cg "define void @axiom_retain(i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %imm = icmp slt i64 %h, 4096")
    (emitLine cg "  br i1 %imm, label %done, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %hoff = add i64 %h, -16")
    (emitLine cg "  %cp = inttoptr i64 %hoff to ptr")
    (emitLine cg "  %c = load i64, ptr %cp")
    (emitLine cg "  %stat = icmp eq i64 %c, -1")
    (emitLine cg "  br i1 %stat, label %done, label %bump")
    (emitLine cg "bump:")
    (emitLine cg "  %c1 = add i64 %c, 1")
    (emitLine cg "  store i64 %c1, ptr %cp")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; MM-LIFE-2e + 2d: the release path. A handle below 4096 is an
    ; immediate, a count of -1 a static, a count of 0 a free-floating
    ; block nobody adopted: each is left alone. Otherwise the count
    ; drops, and at zero the block is dead. A dead RECORD with no
    ; reference map files at once; one of the FOREIGN FORM (form bit 1,
    ; MM-FFI-6) runs its destructor first; a dead RECORD with a map is
    ; DEFERRED: its count word - dead storage from here on, and the
    ; free-list link once it files - links it into a dead list this
    ; invocation keeps in a local, and nothing else is stored
    ; anywhere. The drain pops a dead record, walks its map releasing
    ; each payload reference through the same `relone` path (a child
    ; that dies joins the dead list, it is never recursed into), then
    ; files the record by its size class: class = count >> 1, THE one
    ; convention, and a count of zero (a pre-encoding block, or a
    ; payload too large for the field) or above 8192 (past the 64 KiB
    ; pool ceiling) is skipped rather than misfiled.
    ;
    ; No recursion and no auxiliary stack, so the depth and the
    ; breadth of what dies never matter: the recursive walk took the
    ; process down the first time events 2/3 freed a 400,000-cell
    ; list whole (`tests/selfhost/700-tco.ax`); deferring the LAST
    ; field did the same for a list whose link is not its last field;
    ; and a 4,096-entry worklist with a recursive fallback did the
    ; same for `(Cons String L)` - every level left its string pending
    ; until the chain ended, and 170,000 levels filled the worklist
    ; and then the machine stack. The dead list costs one word the
    ; block already owns.
    (emitLine cg "define void @axiom_release(i64 %h0) #0 {")
    (emitLine cg "start:")
    (emitLine cg "  %dead = alloca i64")
    (emitLine cg "  %cur = alloca i64")
    (emitLine cg "  %D = alloca i64")
    (emitLine cg "  %wi = alloca i64")
    (emitLine cg "  %wm = alloca i64")
    (emitLine cg "  store i64 0, ptr %dead")
    (emitLine cg "  store i64 0, ptr %D")
    (emitLine cg "  store i64 %h0, ptr %cur")
    (emitLine cg "  br label %relone")
    (emitLine cg "relone:")
    (emitLine cg "  %h = load i64, ptr %cur")
    (emitLine cg "  %imm = icmp slt i64 %h, 4096")
    (emitLine cg "  br i1 %imm, label %after, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %hoff = add i64 %h, -16")
    (emitLine cg "  %cp = inttoptr i64 %hoff to ptr")
    (emitLine cg "  %c = load i64, ptr %cp")
    (emitLine cg "  %stat = icmp eq i64 %c, -1")
    (emitLine cg "  br i1 %stat, label %after, label %live")
    (emitLine cg "live:")
    (emitLine cg "  %zero = icmp eq i64 %c, 0")
    (emitLine cg "  br i1 %zero, label %after, label %dec")
    (emitLine cg "dec:")
    (emitLine cg "  %c1 = add i64 %c, -1")
    (emitLine cg "  store i64 %c1, ptr %cp")
    (emitLine cg "  %isdead = icmp eq i64 %c1, 0")
    (emitLine cg "  br i1 %isdead, label %dead0, label %after")
    (emitLine cg "dead0:")
    (emitLine cg "  %shq = add i64 %h, -8")
    (emitLine cg "  %shqp = inttoptr i64 %shq to ptr")
    (emitLine cg "  %shw = load i64, ptr %shqp")
    (emitLine cg "  %formb = and i64 %shw, 1")
    (emitLine cg "  %isrec = icmp eq i64 %formb, 0")
    (emitLine cg "  %map0 = lshr i64 %shw, 16")
    (emitLine cg "  %hasmap = icmp ne i64 %map0, 0")
    (emitLine cg "  %dowalk = and i1 %isrec, %hasmap")
    (emitLine cg "  br i1 %dowalk, label %defer, label %notrec")
    ; the FOREIGN FORM (form bit 1, stdlib/Ffi.ax): payload word 0 is
    ; the address of a C destructor `i64 (i64)`, word 1 the Rust value
    ; it takes. A dead handle runs the destructor once - the pointer is
    ; zeroed by an explicit `ffiHandleClose` so a closed handle's death
    ; calls nothing - and then files like any block. The call may
    ; re-enter `@axiom_release` (a Rust `Drop` giving back Axiom
    ; values it retained): every invocation's dead list is its own
    (emitLine cg "notrec:")
    (emitLine cg "  br i1 %isrec, label %filev, label %foreign")
    (emitLine cg "foreign:")
    (emitLine cg "  %fdp = inttoptr i64 %h to ptr")
    (emitLine cg "  %fdrop = load i64, ptr %fdp")
    (emitLine cg "  %fa1 = add i64 %h, 8")
    (emitLine cg "  %fap = inttoptr i64 %fa1 to ptr")
    (emitLine cg "  %farg = load i64, ptr %fap")
    (emitLine cg "  %fhas = icmp ne i64 %fdrop, 0")
    (emitLine cg "  %fliv = icmp ne i64 %farg, 0")
    (emitLine cg "  %fdo = and i1 %fhas, %fliv")
    (emitLine cg "  br i1 %fdo, label %fcall, label %filev")
    (emitLine cg "fcall:")
    (emitLine cg "  store i64 0, ptr %fap")
    (emitLine cg "  %ffp = inttoptr i64 %fdrop to ptr")
    (emitLine cg "  %fres = call i64 %ffp(i64 %farg)")
    (emitLine cg "  br label %filev")
    (emitLine cg "defer:")
    (emitLine cg "  %dh = load i64, ptr %dead")
    (emitLine cg "  store i64 %dh, ptr %cp")
    (emitLine cg "  store i64 %h, ptr %dead")
    (emitLine cg "  br label %after")
    (emitLine cg "filev:")
    (emitLine cg "  %bcnt0 = lshr i64 %shw, 1")
    (emitLine cg "  %bcnt = and i64 %bcnt0, 32767")
    (emitLine cg "  %ok1 = icmp ne i64 %bcnt, 0")
    (emitLine cg "  %ok2 = icmp ule i64 %bcnt, 8192")
    (emitLine cg "  %ok = and i1 %ok1, %ok2")
    (emitLine cg "  br i1 %ok, label %push, label %after")
    (emitLine cg "push:")
    (emitLine cg "  %pcls = lshr i64 %bcnt, 1")
    (emitLine cg "  %pslotp = getelementptr [4097 x i64], ptr @__axiom_slabs, i64 0, i64 %pcls")
    (emitLine cg "  %ohead = load i64, ptr %pslotp")
    (emitLine cg "  store i64 %ohead, ptr %cp")
    (emitLine cg "  store i64 %hoff, ptr %pslotp")
    (emitLine cg "  br label %after")
    (emitLine cg "after:")
    (emitLine cg "  %D0 = load i64, ptr %D")
    (emitLine cg "  %hasD = icmp ne i64 %D0, 0")
    (emitLine cg "  br i1 %hasD, label %walk, label %drain")
    (emitLine cg "walk:")
    (emitLine cg "  %Dw = load i64, ptr %D")
    (emitLine cg "  %m = load i64, ptr %wm")
    (emitLine cg "  %mzero = icmp eq i64 %m, 0")
    (emitLine cg "  br i1 %mzero, label %fileD, label %testbit")
    (emitLine cg "testbit:")
    (emitLine cg "  %i = load i64, ptr %wi")
    (emitLine cg "  %bit = and i64 %m, 1")
    (emitLine cg "  %m1 = lshr i64 %m, 1")
    (emitLine cg "  %i1 = add i64 %i, 1")
    (emitLine cg "  store i64 %m1, ptr %wm")
    (emitLine cg "  store i64 %i1, ptr %wi")
    (emitLine cg "  %isset = icmp ne i64 %bit, 0")
    (emitLine cg "  br i1 %isset, label %relchild, label %walk")
    (emitLine cg "relchild:")
    (emitLine cg "  %woff = shl i64 %i, 3")
    (emitLine cg "  %waddr = add i64 %Dw, %woff")
    (emitLine cg "  %waddrp = inttoptr i64 %waddr to ptr")
    (emitLine cg "  %wval = load i64, ptr %waddrp")
    (emitLine cg "  store i64 %wval, ptr %cur")
    (emitLine cg "  br label %relone")
    (emitLine cg "fileD:")
    (emitLine cg "  %dq = add i64 %Dw, -8")
    (emitLine cg "  %dqp = inttoptr i64 %dq to ptr")
    (emitLine cg "  %dshw = load i64, ptr %dqp")
    (emitLine cg "  %dcnt0 = lshr i64 %dshw, 1")
    (emitLine cg "  %dcnt = and i64 %dcnt0, 32767")
    (emitLine cg "  %dok1 = icmp ne i64 %dcnt, 0")
    (emitLine cg "  %dok2 = icmp ule i64 %dcnt, 8192")
    (emitLine cg "  %dok = and i1 %dok1, %dok2")
    (emitLine cg "  store i64 0, ptr %D")
    (emitLine cg "  br i1 %dok, label %pushD, label %drain")
    (emitLine cg "pushD:")
    (emitLine cg "  %dcls = lshr i64 %dcnt, 1")
    (emitLine cg "  %dslotp = getelementptr [4097 x i64], ptr @__axiom_slabs, i64 0, i64 %dcls")
    (emitLine cg "  %dohead = load i64, ptr %dslotp")
    (emitLine cg "  %dbase = add i64 %Dw, -16")
    (emitLine cg "  %dbasep = inttoptr i64 %dbase to ptr")
    (emitLine cg "  store i64 %dohead, ptr %dbasep")
    (emitLine cg "  store i64 %dbase, ptr %dslotp")
    (emitLine cg "  br label %drain")
    (emitLine cg "drain:")
    (emitLine cg "  %dl = load i64, ptr %dead")
    (emitLine cg "  %empty = icmp eq i64 %dl, 0")
    (emitLine cg "  br i1 %empty, label %done, label %popD")
    (emitLine cg "popD:")
    (emitLine cg "  %lp0 = add i64 %dl, -16")
    (emitLine cg "  %lpp = inttoptr i64 %lp0 to ptr")
    (emitLine cg "  %nxt = load i64, ptr %lpp")
    (emitLine cg "  store i64 %nxt, ptr %dead")
    (emitLine cg "  store i64 %dl, ptr %D")
    (emitLine cg "  store i64 0, ptr %wi")
    (emitLine cg "  %pq = add i64 %dl, -8")
    (emitLine cg "  %pqp = inttoptr i64 %pq to ptr")
    (emitLine cg "  %pshw = load i64, ptr %pqp")
    (emitLine cg "  %pmap = lshr i64 %pshw, 16")
    (emitLine cg "  store i64 %pmap, ptr %wm")
    (emitLine cg "  br label %walk")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    (emitArenaHelpers cg)
    (emitDivTrap cg)
    (emitStrEqHelper cg)
    cg
  })

; ------------------------------------------------------------------
; The two arena primitives, as runtime helpers beside the allocator
; whose globals they move. stage0's `emit_arena_helpers`, block for
; block.
;
; A mark is the WHOLE allocator position, not just the waterline:
; `@__axiom_bump` alone is meaningless once allocation has moved to a
; different chunk, because `@__axiom_bump_end` still describes the
; newer one - restoring the old bump against the new end let the fast
; path succeed on an address in neither chunk, and a mark taken before
; the first chunk existed handed out address 0. So a mark saves bump,
; end AND the chunk bump points into, in a three-word cell so marks
; nest. The cell is allocated BEFORE the position is read, which puts
; it below its own waterline: a reset never reclaims it, so the same
; mark can be reset twice.
;
; A reset restores that position and returns every chunk mapped since
; the mark to the free list. It writes no byte of the memory it
; reclaims, which is what the copy-at-boundary idiom depends on; the
; zeroing `memAlloc` promises happens in `handout` instead, as each
; byte is handed to a caller.
; ------------------------------------------------------------------
(pub :: emitArenaHelpers (-> Int Int))
; String equality, emitted UNCONDITIONALLY beside the division trap and
; for the same reason: `==` on two `String`s lowers to a call to this,
; and a program that compares strings and declares no effects must not
; reach `opt` with a call to a symbol nothing defines.
;
; WHY THIS EXISTS. `==` compiled to `icmp eq` on the two handles, so it
; compared ADDRESSES: `(== "hi" (strDup "hi"))` was false while
; `(strEq ...)` was true, and identical literals within a module intern
; to one header, so `(== "hi" "hi")` was true. A test that compares a
; literal against a literal passes; the same test against a computed
; string fails. That is a silent wrong answer in a language whose
; strings are first class, and its corpus population is zero - all 551
; string comparisons in this repository are spelled `strEq`, which is
; why nothing caught it.
;
; The comparison is over BYTES, which is exactly right for Unicode:
; UTF-8 byte equality is code-point-sequence equality, and UTF-8 orders
; bytes the way Unicode orders code points - the same argument `strCmp`,
; `strEq` and `strStartsWith` already rest on. A `Str` may contain an
; interior NUL, so the length word decides the extent and the NUL
; terminator is never consulted.
;
; Two handles at the same address are equal without a read, which also
; makes `(== s s)` total when `s` is 0.
(pub :: emitStrEqHelper (-> Int Int))
(pub fn (emitStrEqHelper cg)
  {
    (emitLine cg "define internal i64 @__axiom_str_eq(i64 %a, i64 %b) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %same = icmp eq i64 %a, %b")
    (emitLine cg "  br i1 %same, label %yes, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %anull = icmp eq i64 %a, 0")
    (emitLine cg "  %bnull = icmp eq i64 %b, 0")
    (emitLine cg "  %null = or i1 %anull, %bnull")
    (emitLine cg "  br i1 %null, label %no, label %lens")
    (emitLine cg "lens:")
    (emitLine cg "  %ap = inttoptr i64 %a to ptr")
    (emitLine cg "  %la = load i64, ptr %ap")
    (emitLine cg "  %bp = inttoptr i64 %b to ptr")
    (emitLine cg "  %lb = load i64, ptr %bp")
    (emitLine cg "  %lne = icmp ne i64 %la, %lb")
    (emitLine cg "  br i1 %lne, label %no, label %data")
    (emitLine cg "data:")
    (emitLine cg "  %aa = add i64 %a, 8")
    (emitLine cg "  %aap = inttoptr i64 %aa to ptr")
    (emitLine cg "  %da = load i64, ptr %aap")
    (emitLine cg "  %ba = add i64 %b, 8")
    (emitLine cg "  %bap = inttoptr i64 %ba to ptr")
    (emitLine cg "  %db = load i64, ptr %bap")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ 0, %data ], [ %i2, %body ]")
    (emitLine cg "  %more = icmp ult i64 %i, %la")
    (emitLine cg "  br i1 %more, label %body, label %yes")
    (emitLine cg "body:")
    (emitLine cg "  %sa = add i64 %da, %i")
    (emitLine cg "  %sap = inttoptr i64 %sa to ptr")
    (emitLine cg "  %ca = load i8, ptr %sap")
    (emitLine cg "  %sb = add i64 %db, %i")
    (emitLine cg "  %sbp = inttoptr i64 %sb to ptr")
    (emitLine cg "  %cb = load i8, ptr %sbp")
    (emitLine cg "  %cne = icmp ne i8 %ca, %cb")
    (emitLine cg "  %i2 = add i64 %i, 1")
    (emitLine cg "  br i1 %cne, label %no, label %loop")
    (emitLine cg "yes:")
    (emitLine cg "  ret i64 1")
    (emitLine cg "no:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; The division trap, emitted UNCONDITIONALLY beside the arena helpers.
; It first rode along with `emitUnhandledTrap`, which is emitted only
; when the program declares an effect - so every program that divided
; and had no effects reached `opt` with a call to a symbol nothing
; defined. Caught by the first probe after the change.
(pub :: emitDivTrap (-> Int Int))
(pub fn (emitDivTrap cg)
  {
    (emitLine cg "@__axiom_divzero_msg = private unnamed_addr constant [24 x i8] c\"axiom: division by zero\\0A\"")
    (emitLine cg "define internal i64 @__axiom_div_by_zero() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %dzp = ptrtoint ptr @__axiom_divzero_msg to i64")
    (emitLine cg (strConcat
                   (cat4 "  call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetWriteNum (memGetWord cg 26))))
                   ", i64 2, i64 %dzp, i64 24, i64 0, i64 0, i64 0)"))
    (emitLine cg (strConcat
                   (cat4 "  call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetExitNum (memGetWord cg 26))))
                   ", i64 72, i64 0, i64 0, i64 0, i64 0, i64 0)"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

(pub fn (emitArenaHelpers cg)
  {
    (emitLine cg "define internal i64 @__axiom_arena_mark_fn() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %cell = call i64 @axiom_alloc(i64 24)")
    (emitLine cg "  %bump = load i64, ptr @__axiom_bump")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %chunk = load i64, ptr @__axiom_chunk")
    (emitLine cg "  %p0 = inttoptr i64 %cell to ptr")
    (emitLine cg "  store i64 %bump, ptr %p0")
    (emitLine cg "  %a1 = add i64 %cell, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  store i64 %end, ptr %p1")
    (emitLine cg "  %a2 = add i64 %cell, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  store i64 %chunk, ptr %p2")
    (emitLine cg "  ret i64 %cell")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "define internal i64 @__axiom_arena_reset_fn(i64 %cell) #0 {")
    (emitLine cg "entry:")
    ; A release-to-zero FILES its block on @__axiom_slabs; a reset
    ; rewinds the bump beneath those heads, and a dangling head
    ; double-issues storage on the next same-class allocation. The
    ; ownership events made compiler-emitted releases real, so every
    ; reset scrubs the slab heads first - 4097 stores since the pool
    ; ceiling moved to 64 KiB, the price of composing §3.3 with
    ; counting at all (the review's judge found this by composing
    ; three lenses' half-facts; none saw it alone).
    (emitLine cg "  br label %slabclear")
    (emitLine cg "slabclear:")
    (emitLine cg "  %si = phi i64 [ 0, %entry ], [ %si1, %slabclear ]")
    (emitLine cg "  %sp = getelementptr [4097 x i64], ptr @__axiom_slabs, i64 0, i64 %si")
    (emitLine cg "  store i64 0, ptr %sp")
    (emitLine cg "  %si1 = add i64 %si, 1")
    (emitLine cg "  %sdone = icmp eq i64 %si1, 4097")
    (emitLine cg "  br i1 %sdone, label %resetbody, label %slabclear")
    (emitLine cg "resetbody:")
    (emitLine cg "  %p0 = inttoptr i64 %cell to ptr")
    (emitLine cg "  %sbump = load i64, ptr %p0")
    (emitLine cg "  %a1 = add i64 %cell, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %send = load i64, ptr %p1")
    (emitLine cg "  %a2 = add i64 %cell, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  %schunk = load i64, ptr %p2")
    (emitLine cg "  %chead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  %same = icmp eq i64 %chead, %schunk")
    (emitLine cg "  br i1 %same, label %restore, label %unwind")
    ; Every chunk between the head and the marked one is wholly garbage
    ; now, so it goes back on the free list. The marked chunk is then
    ; dirty from the restored waterline to its end - it was abandoned
    ; because it filled up - and saying so is one store.
    (emitLine cg "unwind:")
    (emitLine cg "  %c = phi i64 [ %chead, %resetbody ], [ %cnext, %unwind_body ]")
    (emitLine cg "  %reached = icmp eq i64 %c, %schunk")
    (emitLine cg "  %ranout = icmp eq i64 %c, 0")
    (emitLine cg "  %stop = or i1 %reached, %ranout")
    (emitLine cg "  br i1 %stop, label %tail, label %unwind_body")
    (emitLine cg "unwind_body:")
    (emitLine cg "  %clink = add i64 %c, 8")
    (emitLine cg "  %clinkp = inttoptr i64 %clink to ptr")
    (emitLine cg "  %cnext = load i64, ptr %clinkp")
    (emitLine cg "  %fhead = load i64, ptr @__axiom_free")
    (emitLine cg "  store i64 %fhead, ptr %clinkp")
    (emitLine cg "  store i64 %c, ptr @__axiom_free")
    (emitLine cg "  br label %unwind")
    (emitLine cg "tail:")
    (emitLine cg "  store i64 %send, ptr @__axiom_high")
    (emitLine cg "  br label %restore")
    (emitLine cg "restore:")
    (emitLine cg "  store i64 %sbump, ptr @__axiom_bump")
    (emitLine cg "  store i64 %send, ptr @__axiom_bump_end")
    (emitLine cg "  store i64 %schunk, ptr @__axiom_chunk")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "")
    (emitArenaKeepHelper cg)
    cg
  })

; ------------------------------------------------------------------
; `__axiom_arena_reset_keeping_fn(cell, src, bytes)`: reclaim to the
; mark and carry one contiguous block across the reclaim, answering
; where it landed. stage0's `emit_arena_reset_keeping`.
;
; It exists because a caller CANNOT build it out of the two primitives
; it looks like. Written as a reset followed by allocate-and-copy, the
; destination is handed out by `axiom_alloc`, which scrubs it - and
; when the kept block is bigger than the garbage around it, the scrub
; runs over the source before the copy reads it. Measured on a 40 KB
; block kept across a 64-byte allocation: 39,841 of 40,000 bytes wrong
; on the FIRST round. That is not a corner case, it is a server holding
; a document and answering a short request.
;
; The copy runs forwards, which is safe in both directions it can face.
; Within one chunk the source was allocated after the mark, so
; `dst <= src` and a forward copy reads each byte before overwriting
; it. Across chunks the ranges are separate mappings and cannot overlap
; at all - which matters, because `mmap` hands out chunks in no
; particular address order, so `dst <= src` is exactly what not to
; assume there.
;
; When the block does not fit in what remains of the marked chunk the
; destination comes from a FRESH mapping, never the free list: the free
; list at that moment holds the chunks this call just reclaimed, one of
; which may be the source's.
; ------------------------------------------------------------------
(pub :: emitArenaKeepHelper (-> Int Int))
(pub fn (emitArenaKeepHelper cg)
  {
    (emitLine cg (cat2 "define internal i64 @__axiom_arena_reset_keeping_fn"
                       "(i64 %cell, i64 %src, i64 %bytes) #0 {"))
    (emitLine cg "entry:")
    (emitLine cg "  %r = call i64 @__axiom_arena_reset_fn(i64 %cell)")
    (emitLine cg "  %sz0 = add i64 %bytes, 15")
    (emitLine cg "  %szr = and i64 %sz0, -16")
    ; The kept block is a counted block like any other: its 16-byte
    ; MM-LIFE-2b header travels with it, reserved on BOTH landing
    ; paths - the review of this slice caught that this helper is a
    ; SECOND allocation path (the LSP crosses it every message), and
    ; a header only on axiom_alloc's path would ship a spec-false
    ; SHALL.
    (emitLine cg "  %sz = add i64 %szr, 16")
    (emitLine cg "  %bump = load i64, ptr @__axiom_bump")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %stop = add i64 %bump, %sz")
    (emitLine cg "  %fits = icmp ule i64 %stop, %end")
    (emitLine cg "  br i1 %fits, label %inplace, label %fresh")
    (emitLine cg "inplace:")
    (emitLine cg "  store i64 %stop, ptr @__axiom_bump")
    (emitLine cg "  br label %copy")
    (emitLine cg "fresh:")
    (emitLine cg "  %need = add i64 %sz, 16")
    (emitLine cg "  %rounded0 = add i64 %need, 65535")
    (emitLine cg "  %want = and i64 %rounded0, -65536")
    (emitLine cg (strConcat
                   (cat4 "  %addr = call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetMmapNum (memGetWord cg 26))))
                   (cat3 ", i64 0, i64 %want, i64 3, i64 "
                         (fmtInt (targetMapFlags (memGetWord cg 26)))
                         ", i64 -1, i64 0)")))
    (emitLine cg "  %failed_low = icmp ult i64 %addr, 4096")
    (emitLine cg "  %failed_neg = icmp ugt i64 %addr, -4096")
    (emitLine cg "  %failed = or i1 %failed_low, %failed_neg")
    (emitLine cg "  br i1 %failed, label %oom, label %adopt")
    (emitLine cg "adopt:")
    (emitLine cg "  %basep = inttoptr i64 %addr to ptr")
    (emitLine cg "  store i64 %want, ptr %basep")
    (emitLine cg "  %baselink = add i64 %addr, 8")
    (emitLine cg "  %baselinkp = inttoptr i64 %baselink to ptr")
    (emitLine cg "  %chead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  store i64 %chead, ptr %baselinkp")
    (emitLine cg "  store i64 %addr, ptr @__axiom_chunk")
    (emitLine cg "  %fdata = add i64 %addr, 16")
    (emitLine cg "  %fbump = add i64 %fdata, %sz")
    (emitLine cg "  store i64 %fbump, ptr @__axiom_bump")
    (emitLine cg "  %fend = add i64 %addr, %want")
    (emitLine cg "  store i64 %fend, ptr @__axiom_bump_end")
    (emitLine cg "  store i64 %fbump, ptr @__axiom_high")
    (emitLine cg "  br label %copy")
    ; The destination stays unscrubbed: the copy writes every byte the
    ; caller asked to keep, and the bytes past `%bytes` up to the
    ; 16-byte rounding are padding no caller can name.
    (emitLine cg "copy:")
    (emitLine cg "  %dstbase = phi i64 [ %bump, %inplace ], [ %fdata, %adopt ]")
    ; The destination is deliberately unscrubbed, so BOTH header words
    ; are written here - dirty memory below a restored waterline would
    ; otherwise read as a count.
    (emitLine cg "  %dcp = inttoptr i64 %dstbase to ptr")
    (emitLine cg "  store i64 0, ptr %dcp")
    (emitLine cg "  %dsh = add i64 %dstbase, 8")
    (emitLine cg "  %dshp = inttoptr i64 %dsh to ptr")
    ; the keep helper is the third shape writer, and it stamps the
    ; LEAF of its dynamic size - the kept bytes' declared types are
    ; gone by run time - with the allocator's exact clamp, because a
    ; kept block can be a 262KB read buffer as easily as a cell
    (emitLine cg "  %kcnt = lshr i64 %szr, 3")
    (emitLine cg "  %kbig = icmp ugt i64 %kcnt, 32767")
    (emitLine cg "  %kleaf = select i1 %kbig, i64 0, i64 %kcnt")
    (emitLine cg "  %kshp = shl i64 %kleaf, 1")
    (emitLine cg "  store i64 %kshp, ptr %dshp")
    (emitLine cg "  %dst = add i64 %dstbase, 16")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ 0, %copy ], [ %i2, %loop_body ]")
    (emitLine cg "  %more = icmp ult i64 %i, %bytes")
    (emitLine cg "  br i1 %more, label %loop_body, label %done")
    (emitLine cg "loop_body:")
    (emitLine cg "  %sa = add i64 %src, %i")
    (emitLine cg "  %sp = inttoptr i64 %sa to ptr")
    (emitLine cg "  %b = load i8, ptr %sp")
    (emitLine cg "  %da = add i64 %dst, %i")
    (emitLine cg "  %dp = inttoptr i64 %da to ptr")
    (emitLine cg "  store i8 %b, ptr %dp")
    (emitLine cg "  %i2 = add i64 %i, 1")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  ret i64 %dst")
    (emitLine cg "oom:")
    (emitLine cg (strConcat
                   (cat4 "  call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetExitNum (memGetWord cg 26))))
                   ", i64 70, i64 0, i64 0, i64 0, i64 0, i64 0)"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; ------------------------------------------------------------------
; Module emission.
; ------------------------------------------------------------------
; `target` is a NAME (`darwin-aarch64`, ...), not a triple: the code it
; maps to drives the triple, the syscall asm, the allocator's numbers,
; and which platform module the imports resolved. An unknown name is
; refused with the four that exist, not defaulted - emitting the wrong
; target's syscall convention is a binary that dies at its first write.
; The convenience entry point, for a caller with no path to derive a
; module search directory from; imports resolve against `self_host/`
; and `stdlib/` only, as they always did.
(pub :: emitModule (-> Int String String))
(pub fn (emitModule decls target)
  (let ((tcode (checkedTargetCode target))
        (bares vecNew)
        (fulls vecNew))
    (let ((allDecls (resolveImports decls bares fulls vecNew tcode "" vecNew)))
      {
        ; Expansion, for the same reason every other path runs it: this
        ; one reaches EMISSION, so without it a macro invocation is
        ; emitted as a call to a symbol nothing defines. Its
        ; diagnostics are discarded because this entry point has no
        ; renderer and no units to render against - it is the
        ; convenience form, and a caller that wants diagnostics uses
        ; the pipeline in `main.ax` that has them.
        { (expandProgram allDecls allDecls vecNew vecNew 0 0 0 0) (lowerImpls allDecls vecNew) }
        (emitResolved allDecls bares fulls tcode)
      })))

; The target's numeric code, refusing an unknown name rather than
; defaulting - emitting the wrong target's syscall convention is a
; binary that dies at its first write. Split out so the driver can
; resolve imports itself (the type checker needs the resolved
; declaration list) without duplicating the refusal.
(pub :: checkedTargetCode (-> String Int))
(pub fn (checkedTargetCode target)
  (let ((tcode (targetCode target)))
    (if (< tcode 0)
        (dieImport "error: unknown target (want darwin-aarch64, darwin-x86_64, linux-aarch64, or linux-x86_64): " target)
        tcode)))

; Emission over an ALREADY-resolved declaration list. Separated from
; `emitModule` so import resolution happens exactly once per run: the
; checker needs `allDecls` too, and resolving twice would read every
; module from disk twice.
(pub :: emitResolved (-> Int Int Int Int String))
(pub fn (emitResolved allDecls bares fulls tcode)
    (let ((cg (newCG)))
      (let ((_ (memSetWord cg 12 bares))
            (_2 (memSetWord cg 13 fulls))
            (_2t (memSetWord cg 26 tcode))
            (_3 (memSetWord cg 15 (scanFloatSigs allDecls vecNew 0)))
            (_4 (memSetWord cg 19 vecNew)))
      (let ((cg0 (scanDecls allDecls cg 0)))
        (let ((cg0b (memSetWord cg0 8 allDecls)))
          ; Every signature is known and the type table is built:
          ; index both, then decide who owns what result before a
          ; function is emitted.
          (let ((_idx (buildNameIndexes cg0b)))
          (let ((_own (inferOwnership cg0b allDecls)))
          (let ((_flow (inferFlows cg0b allDecls)))
          (let ((ttHeader (cat3 "target triple = \"" (targetTriple tcode) "\"")))
            (let ((cg1 (emitLine cg0b ttHeader)))
              (let ((cg2 (emitLine cg1 "")))
                (let ((cg3 (emitAllocator cg2)))
                  (let ((cg4 (emitLine cg3 "")))
                    (emitModuleTail allDecls cg4 0))))))))))))))

(pub :: emitModuleTail (-> Int Int Int String))
(pub fn (emitModuleTail decls cg i)
  (let ((nextCg (if (>= i (vecLen decls))
                    cg
                    (emitDecl (vecGet decls i) cg))))
    (if (>= i (vecLen decls))
        ; Globals may follow the functions that mention them; LLVM does
        ; not care about order, and the table is only complete once every
        ; body has been emitted.
        ;
        ; The attribute group every `define` above refers to. Axiom's
        ; contract is that generated code calls no libc function, and the
        ; optimiser does not know that: LLVM's loop-idiom recogniser
        ; rewrites a byte loop into a call to `strlen` or `memset`, which
        ; are libc symbols in a language that has deliberately never
        ; linked libc. Measured on a stage1-built `010-hello.ax` through
        ; `opt -O1`: 17 references to `strlen`, and a linked binary
        ; importing `_strlen` and `_memset`.
        ;
        ; `"no-builtins"` is the string attribute clang emits for
        ; `-fno-builtin`. The enum attribute `nobuiltin` is a different
        ; thing and does NOT work here - measured separately, it left all
        ; 17 in place. Only one of the two is load-bearing and they are
        ; easy to confuse.
        ; The `declare` lines for every `extern` item, ahead of the
        ; attribute group they refer to.
        ;
        ; This is the entire difference between `extern` and the
        ; removed `foreign`. `foreign` emitted `call i64 @putchar(...)`
        ; into a module that declared no `@putchar`; LLVM textual IR
        ; REQUIRES a declare for an undeclared callee, so `check`
        ; passed and `opt` then died with "use of undefined value"
        ; two stages later (docs/self-hosting.md section 9.1).
        (renderCG (emitLine (emitExternDeclares decls
                              (emitEffectGlobals (emitStringGlobals nextCg 0) 0)
                              0 vecNew)
                            "attributes #0 = { \"no-builtins\" }"))
        (emitModuleTail decls nextCg (+ i 1)))))

; ------------------------------------------------------------------
; `declare i64 @sym(i64, ...)` for every `extern` item in the module.
;
; `seen` deduplicates: two Axiom names may bind ONE symbol, and an
; imported binding module reaches this list once per importer. A
; repeated `declare` of the same name is an LLVM parse error, not a
; warning, so the dedup is load-bearing rather than tidy.
;
; The `#0` group goes on the declare as well as the define. Without it
; `opt` is free to reason about a declared name whose signature matches
; a libc function it knows - which is the whole hazard
; `check-freestanding.sh` exists to watch.
; ------------------------------------------------------------------
(pub :: emitExternDeclares (-> Int Int Int Int Int))
(pub fn (emitExternDeclares decls cg i seen)
  (if (>= i (vecLen decls))
      cg
      (let ((d (vecGet decls i)))
        (emitExternDeclares decls
          (if (== (nodeTag d) TAG_D_EXTERN)
              ; the block's library name travels in the IR as a
              ; comment the driver reads beside the declares: it is
              ; what lets `axiom build` link `-l<lib>` without being
              ; told, and name the block in a grounding diagnostic
              (emitExternItems (nodeC d)
                               (emitLine cg (cat2 "; axiom-extern-lib " (nodeA d)))
                               0 seen)
              cg)
          (+ i 1) seen))))

(pub :: emitExternItems (-> Int Int Int Int Int))
(pub fn (emitExternItems items cg i seen)
  (if (== items 0)
      cg
      (if (>= i (vecLen items))
          cg
          (let ((f (vecGet items i)))
            (let ((sym (nodeC f)))
              (emitExternItems items
                (if (|| (== (externSeen seen sym 0) 1)
                        ; only a symbol the module CALLS is declared:
                        ; a binding module imports fifteen items and a
                        ; program calls two, and every declare must
                        ; ground against a linked archive, so a
                        ; program that imports `Ffi` for its handles
                        ; alone links without any archive
                        (== (linesCallSym (memGetWord cg 0) (llvmSym (strDup sym)) 0) 0))
                    cg
                    {
                      (vecPush seen sym)
                      (emitLine cg
                        (cat4 "declare i64 @" (llvmSym (strDup sym))
                              (cat3 "(" (externParams (arrowArity (nodeB f)) 0) ")")
                              " #0"))
                    })
                (+ i 1) seen))))))

; Does any emitted line call `@sym(`? A substring scan over the
; module's lines, once per extern item at the end of emission.
(pub :: linesCallSym (-> Int String Int Int))
(pub fn (linesCallSym lines sym i)
  (if (>= i (vecLen lines))
      0
      (if (== (strHasSub (cast String (vecGet lines i)) (cat3 "@" sym "(")) 1)
          1
          (linesCallSym lines sym (+ i 1)))))

(pub :: strHasSub (-> String String Int))
(pub fn (strHasSub hay needle)
  (let ((n (strLen needle))
        (h (strLen hay)))
    (if (> n h)
        0
        (strHasSubFrom (strData hay) (strData needle) n (- h n) 0))))

(pub :: strHasSubFrom (-> Int Int Int Int Int Int))
(pub fn (strHasSubFrom hp np n last i)
  (if (> i last)
      0
      (if (== (memCmp (+ hp i) np n) 0)
          1
          (strHasSubFrom hp np n last (+ i 1)))))

(pub :: externSeen (-> Int String Int Int))
(pub fn (externSeen seen sym i)
  (if (>= i (vecLen seen))
      0
      (if (strEq (vecGet seen i) sym) 1 (externSeen seen sym (+ i 1)))))

; The declared arrow's depth. `->` right-folds, so `(-> Int Int Int)`
; IS `(-> Int (-> Int Int))` and the depth is 2.
; `i64, i64` for arity 2; the empty string for arity 0, which is the
; shape a nullary extern needs - `@f()` and never `@f(i64 )`.
(pub :: externParams (-> Int Int String))
(pub fn (externParams n i)
  (if (>= i n)
      ""
      (if (== i (- n 1))
          "i64"
          (cat2 "i64, " (externParams n (+ i 1))))))

; ------------------------------------------------------------------
; Declaration emission.
; ------------------------------------------------------------------
(pub :: emitDecl (-> Int Int Int))
(pub fn (emitDecl node cg)
  (if (== (nodeTag node) TAG_D_FN)
      ; Lambdas lifted out of the function's body, and thunks its bare
      ; function references demanded, are written out once the
      ; function's own `}` is down - the line buffer is one flat
      ; stream, so they cannot be emitted at the point of use.
      ;
      ; The module travels across both, because a lifted lambda's body
      ; is still code written in that module and its bare references
      ; resolve the same way the enclosing function's do.
      (let ((_ (memSetWord cg 34 (nodeModule node)))
            (_e (memSetWord cg 36 node)))
        (let ((cgD (drainPending (emitFnDef node cg))))
          {
            (memSetWord cgD 34 0)
            (memSetWord cgD 36 0)
            (memSetWord cgD 41 vecNew)
            cgD
          }))
      cg))


; Does this (lowered) body contain a match? Decides whether the
; function gets the merge scratch: an UNCONDITIONAL alloca grew
; every frame by sixteen bytes, and 320-effect-gc-roots' deep
; non-TCO recursion found the stack guard at raw `llc -O2` - the
; growth mode self-hosting.md calls meeting a distant limit as an
; unrelated-looking failure, this time in frames rather than bytes.
; A missed tag here under-emits and llc refuses the undefined
; register LOUDLY; `cond` answers 1 unconditionally because its
; lowering happens per-declaration and a lambda body may carry one.
(pub :: bodyHasMatch (-> Int Int))
(pub fn (bodyHasMatch e)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== tg TAG_E_MATCH)
            1
        (if (== tg TAG_E_COND)
            1
        (if (== tg TAG_E_APP)
            (if (== (bodyHasMatch (nodeA e)) 1) 1 (bodyHasMatch (nodeB e)))
        (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            (if (== (bodyHasMatch (nodeB e)) 1) 1 (bodyHasMatch (nodeC e)))
        (if (== tg TAG_E_IF)
            (if (== (bodyHasMatch (nodeA e)) 1)
                1
                (if (== (bodyHasMatch (nodeB e)) 1)
                    1
                    (bodyHasMatch (nodeC e))))
        (if (== tg TAG_E_BEGIN)
            (bodyHasMatchVec (nodeA e))
        (if (== tg TAG_E_SET)
            (bodyHasMatch (nodeB e))
        (if (== tg TAG_E_SETF)
            (if (== (bodyHasMatch (nodeA e)) 1) 1 (bodyHasMatch (nodeC e)))
        ; A `while`'s word 2 is its body VECTOR, not a node. Handed to
        ; the node walk it read a Vec header as a tag and answered 0,
        ; so a match inside a loop body got no scratch and `opt`
        ; refused the undefined `%__scr.h` - loudly, as the comment
        ; above promises, and in the program rather than the compiler
        ; (the QA sweep's refutation pass, 2026-08-21).
        (if (== tg TAG_E_WHILE)
            (if (== (bodyHasMatch (nodeA e)) 1) 1 (bodyHasMatchVec (nodeB e)))
        (if (== tg TAG_E_FIELD)
            (bodyHasMatch (nodeA e))
        (if (== tg TAG_E_LAM)
            (bodyHasMatch (nodeC e))
        (if (== tg TAG_E_STRUCTCON)
            (bodyHasMatchVec (nodeB e))
        (if (== tg TAG_E_ALLOC)
            (bodyHasMatch (nodeA e))
        (if (== tg TAG_E_HANDLE)
            ; the body (A) and the handler (C); B is the Vec of effect
            ; names, not a node - walked as one, it read a Vec header
            ; as a tag and the body's `match` got no scratch word
            (if (== (bodyHasMatch (nodeA e)) 1) 1 (bodyHasMatch (nodeC e)))
        0)))))))))))))))))

(pub :: bodyHasMatchVec (-> Int Int))
(pub fn (bodyHasMatchVec xs)
  (if (== xs 0)
      0
      (let ((mut i 0) (mut found 0))
        {
          (while (< i (vecLen xs))
            {
              (if (== (bodyHasMatch (vecGet xs i)) 1) (set found 1) 0)
              (set i (+ i 1))
            })
          found
        })))

; ------------------------------------------------------------------
; Function definition.
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; Lower every TAG_E_COND in an expression tree to the nested-if chain
; the parser used to build at parse time, IN PLACE - parents keep
; their pointers, and the rewrite runs before `tailCallsSelf` so a
; tail self-call inside a cond clause still gets its loop. The fold is
; the old parser desugar verbatim: clauses right to left around the
; else body, `(mkEInt 0)` when there is none, so emission is
; bit-identical to the parse-time desugar this replaces.
; ------------------------------------------------------------------
(pub :: lowerConds (-> Int Int))
(pub fn (lowerConds e)
  (if (== e 0)
      0
      (let ((tag (nodeTag e)))
        (if (== tag TAG_E_COND)
            (let ((chain (condChainAt (nodeA e) (- (vecLen (nodeA e)) 1)
                                      (if (== (nodeB e) 0)
                                          (mkEInt 0)
                                          (lowerConds (nodeB e))))))
              {
                (memSetWord e 0 (nodeTag chain))
                (memSetWord e 1 (nodeA chain))
                (memSetWord e 2 (nodeB chain))
                (memSetWord e 3 (nodeC chain))
                (memSetWord e 4 (nodeSpan chain))
                e
              })
        (if (== tag TAG_E_APP)
            { (lowerConds (nodeA e)) (lowerConds (nodeB e)) e }
        (if (== tag TAG_E_LAM)
            { (lowerConds (nodeB e)) e }
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
            { (lowerConds (nodeB e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_IF)
            { (lowerConds (nodeA e)) (lowerConds (nodeB e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_BEGIN)
            { (lowerCondsVec (nodeA e) 0) e }
        (if (== tag TAG_E_MATCH)
            { (lowerConds (nodeA e)) (lowerCondsArms (nodeB e) 0) e }
        (if (== tag TAG_E_WHILE)
            { (lowerConds (nodeA e)) (lowerCondsVec (nodeB e) 0) e }
        (if (== tag TAG_E_SET)
            { (lowerConds (nodeB e)) e }
        (if (== tag TAG_E_SETF)
            { (lowerConds (nodeA e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_FIELD)
            { (lowerConds (nodeA e)) e }
        (if (== tag TAG_E_HANDLE)
            { (lowerConds (nodeA e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_STRUCTCON)
            { (lowerCondsVec (nodeB e) 0) e }
        (if (== tag TAG_E_ALLOC)
            { (lowerConds (nodeA e)) e }
        e)))))))))))))))))

(pub :: condChainAt (-> Int Int Int Int))
(pub fn (condChainAt clauses i acc)
  (if (< i 0)
      acc
      (let ((cl (vecGet clauses i)))
        (condChainAt clauses (- i 1)
          (mkEIf (lowerConds (nodeA cl)) (lowerConds (nodeB cl)) acc)))))

(pub :: lowerCondsVec (-> Int Int Int))
(pub fn (lowerCondsVec v i)
  (if (>= i (vecLen v))
      0
      { (lowerConds (vecGet v i)) (lowerCondsVec v (+ i 1)) }))

; Arm PATTERNS are left alone: a cond form in pattern position is
; nonsense the emitter has always treated as match-everything, and
; lowering it would only change which nonsense it is.
(pub :: lowerCondsArms (-> Int Int Int))
(pub fn (lowerCondsArms arms i)
  (if (>= i (vecLen arms))
      0
      { (lowerConds (nodeB (vecGet arms i))) (lowerCondsArms arms (+ i 1)) }))

(pub :: emitFnDef (-> Int Int Int))
(pub fn (emitFnDef node cg)
  ; The entry file's `main` is not the linker's `main` - the argv
  ; wrapper in the prelude owns that symbol and calls this one. Same
  ; rename stage0 makes, for the same reason.
  (let ((name (if (strEq (nodeA node) "main")
                  "__axiom_user_main"
                  (nodeA node)))
        (params (nodeB node))
        (body (lowerConds (nodeC node))))
    (let ((paramStr (emitParams params cg 0))
          (_ (memSetWord cg 1 0))      ; reset register counter in-place
          ; The symbol table holds this function's `let` bindings and
          ; nothing else. It used to persist across the whole module, so
          ; a `let`-bound `s` in one function shadowed the *parameter*
          ; `s` of a later one and emitted the earlier function's
          ; register - a name undefined in the function that used it.
          (_2 (memSetWord cg 6 vecNew))
          (_3 (memSetWord cg 7 vecNew))
          (_4 (memSetWord cg 16 vecNew))
          (_4b (memSetWord cg 20 vecNew))
          ; This function's own parameter names and float flags, for
          ; `%name` references in the body.
          (_5 (memSetWord cg 17 params))
          ; event 2: the tail leaves this function must retain
          (_5r (memSetWord cg 41 (borrowedTailLeaves cg name body params)))
          (_5p (memSetWord cg 42 vecNew))
          (_6 (memSetWord cg 18
                (let ((e (findFSig (memGetWord cg 15) name)))
                  (if (== e 0) 0 (memGetWord e 2))))))
      ; MM-LIFE-2d: a polymorphic function's hidden evidence word.
      ; Appended to the RENDERED parameter list only - the AST param
      ; vec is untouched, so every arity computation stays blind to
      ; it by construction. The symbol-table binding under "__evw."
      ; (a name no Axiom identifier can spell) is what the body's
      ; call sites and lambda captures read it through.
      (let ((takesEv (fnTakesEvw cg name)))
      (let ((paramStr2 (if (== takesEv 0)
                           paramStr
                           (if (== (strLen paramStr) 0)
                               "i64 %__evw.h"
                               (cat2 paramStr ", i64 %__evw.h")))))
      (let ((hdr (strConcat (cat4 "define i64 @"
                                  (llvmSym (strDup name))
                                  "("
                                  paramStr2)
                            ") #0 {")))
        (let ((cg0e (if (== takesEv 1)
                        (bindSym cg "__evw." "%__evw.h" 0 0)
                        cg)))
        ; MM-ALLOC-9 as amended: the merge cells (a match's result, a
        ; mixed-representation tag read) are no longer heap
        ; allocations - one scratch alloca per function serves them
        ; all, because a cell's live range is store-as-the-arm's-
        ; last-act to load-at-the-merge with nothing between, and
        ; nested matches complete strictly inside their arm. Emitted
        ; only where a match exists: raw `llc -O2` runs no dead-
        ; alloca elimination, and sixteen bytes on every frame found
        ; a deep recursion's stack guard.
        (let ((cg1 (openAllocaMark
                     (let ((cgH (emitLine cg0e hdr)))
                       (if (== (bodyHasMatch body) 1)
                           (emitLine cgH "  %__scr.h = alloca i64")
                           cgH)))))
          ; NO re-scan here. This used to read
          ;
          ;   ; Re-scan declarations to ensure types Vec is fresh
          ;   (scanDecls (memGetWord cg1 8) cg1 0)
          ;
          ; and the comment was wrong in the one way that mattered: the
          ; types Vec is never made STALE, so it never needed making
          ; fresh. `emitResolved` scans `allDecls` once (see its
          ; `scanDecls` call) and then sets slot 8 to that same
          ; `allDecls`, so this re-scanned an identical list. Nothing
          ; clears slot 3 - the only writes to it are `scanOne`'s own
          ; appends - and `addTypeNamed` is a bare `vecPush` with no
          ; dedup. So each re-scan appended every constructor and every
          ; struct in the program to the table AGAIN, once per function.
          ;
          ; That is quadratic in both directions at once: the table grew
          ; to functions x types entries, and `lookupType` walks it
          ; linearly, so every constructor reference in every body paid
          ; for all the copies. Measured on synthetic programs of N
          ; two-line functions, best of 3, before this change:
          ;
          ;     N      IR lines    emit-llvm     us/line
          ;   250         1,738      0.0583s        33.5
          ;   500         3,238      0.2085s        64.4
          ;  1000         6,238      0.7986s       128.0
          ;  2000        12,238      3.1028s       253.5
          ;  4000        24,238     12.3580s       509.9
          ;
          ; Doubling the input quadrupled the time, and the per-line cost
          ; doubled with it. On the compiler's own source, lowering was
          ; 54.6s of a 76.0s build - 73% - against 5.0s for `opt`, `llc`
          ; and `cc` together. `scripts/bench-compile.sh` is that
          ; measurement.
          ;
          ; This is the second instance of the defect the strConcat fix
          ; already recorded (docs/self-hosting.md 7: "the dominant cost
          ; was not lexing, parsing, checking or lowering - it was the
          ; last line of code generation"). That one was fixed and the
          ; 0.85s it produced was written down; nothing re-measured
          ; afterwards, so this one accumulated behind a stale number.
          (let ((cg1b cg1))
            ; A function that tail-calls itself gets a loop instead of a
            ; recursion: its parameters move into allocas, a header
            ; label is branched to, and the call assigns and jumps back.
            ; A function that does not is emitted exactly as before -
            ; same registers, same blocks, byte for byte - because most
            ; functions are that, and paying an alloca and two memory
            ; operations per parameter for a loop nobody enters is a
            ; cost with no buyer.
            ; The BARE name, because that is what a self call spells.
            ; `mangleDecl` rewrites an imported function's declaration
            ; name in place to `Mod$name`, so comparing against it
            ; matched nothing for every function in every imported
            ; module - which is all of `self_host/` and `stdlib/`, and
            ; therefore all of the code this exists to fix. It passed
            ; its test only because the test was an entry file.
            (let ((selfName (bareOf (nodeA node))))
            (let ((wantsTCO (tailCallsSelf body selfName (vecLen params))))
              ; MM-LIFE-2d + TCO: the hidden word gets a slot beside
              ; the parameters' - NEVER inside tcoSlots, whose length
              ; gates the rewrite - because a self tail call can
              ; re-instantiate (the word is recomputed and stored per
              ; jump, like any argument). Parked BEFORE the loop
              ; header so the alloca sits in the entry block.
              (let ((cg1p (if (&& (== wantsTCO 1) (== takesEv 1))
                              (evwParkSlot cg1b)
                              cg1b)))
              (let ((cg1c (if (== wantsTCO 1)
                              (openTailLoop selfName params cg1p)
                              cg1p)))
                ; tail-aware emission whenever a leaf needs event 2's
                ; retain, not only when a self call is to be rewritten
                (let ((cg2 (if (|| (== wantsTCO 1)
                                   (> (vecLen (memGetWord cg1c 41)) 0))
                               (emitExprTail body cg1c)
                               (emitExpr body cg1c))))
                  {
                    (memSetWord cg2 27 0)
                    (memSetWord cg2 30 0)
                    ; A body that ended by jumping back to the header
                    ; has already terminated its block; a `ret` after it
                    ; is a second terminator and invalid LLVM.
                    (if (== (memGetWord cg2 31) 1)
                        {
                          (memSetWord cg2 31 0)
                          (emitLine (closeAllocaMark cg2) "}")
                        }
                        ; MM-LIFE-2c event 2: a function returns its
                        ; result OWNED. A body whose every tail is
                        ; owned already - a construction, a literal,
                        ; an owned-result call, by `inferOwnership` -
                        ; hands back the share it holds and MOVES it;
                        ; a body that can answer a borrowed value - a
                        ; parameter, a field, a binder - retains
                        ; first. The caller then owns exactly one
                        ; share, which is what lets event 3 release a
                        ; `let` bound to a call and `releaseOwnedArgs`
                        ; release a temporary. Only a REFERENCE result
                        ; is retained: a word is never a share.
                        ;
                        ; The remaining coarseness: a body owned on one
                        ; branch and borrowed on another retains the
                        ; merged register, so the owned branch leaks a
                        ; share - the safe direction, as before.
                        ; MM-LIFE-2c event 4's other end: the entry
                        ; retained every reference parameter into its
                        ; slot (`retainRefParams`), the boundary kept
                        ; the slots balanced per jump, and nothing gave
                        ; the LAST iteration's shares back - one share
                        ; of a reference parameter leaked per call of
                        ; every self-recursive function until
                        ; 2026-08-21. Released here, after the tail
                        ; leaf took its own share (event 2) and before
                        ; the `ret`.
                        (let ((cgP (if (== wantsTCO 1)
                                       (releaseRefParamSlots cg2)
                                       cg2)))
                        (let ((ret (cat3 "  ret i64 " (strDup (memGetWord cgP 2)) "")))
                          (emitLine (emitLine (closeAllocaMark cgP) ret) "}"))))
                  }))))))))))))))

; The tail LEAVES of a function body that answer a borrowed value -
; `emitExpr` retains each as it is emitted (event 2). Empty unless
; the declared result is a reference and `inferOwnership` found some
; path borrowed. Mirrors `tailOwned`'s walk over the LOWERED body, so
; the node identities are the ones emission meets; a self tail call
; is never a leaf (it becomes a jump, and the eventual non-recursive
; leaf is where the value is produced).
(pub :: borrowedTailLeaves (-> Int String Int Int Int))
(pub fn (borrowedTailLeaves cg name body params)
  (let ((e (findFSigCg cg name))
        (acc vecNew))
    (if (== e 0)
        acc
        (if (== (memGetWord e 5) 1)
            acc
            (let ((res (sigResultTy (memGetWord e 3))))
              (if (== res 0)
                  acc
                  (if (!= (fldClass cg res) 2)
                      acc
                      { (collectTails cg body params vecNew name acc) acc })))))))

(pub :: collectTails (-> Int Int Int Int String Int Int))
(pub fn (collectTails cg e params env self acc)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (== tg TAG_E_VAR)
            (if (== (tailOwned cg e params env) 1) 0 { (vecPush acc e) 0 })
        (if (|| (== tg TAG_E_FIELD) (== tg TAG_E_ALLOC))
            { (vecPush acc e) 0 }
        (if (== tg TAG_E_APP)
            (let ((hd (spineHead e)))
              (if (&& (== (nodeTag hd) TAG_E_VAR)
                      (strEq (mangledForCg cg (nodeA hd)) self))
                  0
                  (if (== (tailOwnedApp cg e params env) 1) 0 { (vecPush acc e) 0 })))
        (if (== tg TAG_E_IF)
            { (collectTails cg (nodeB e) params env self acc)
              (collectTails cg (nodeC e) params env self acc) }
        (if (== tg TAG_E_COND)
            { (collectTailsClauses cg (nodeA e) params env self acc 0)
              (collectTails cg (nodeB e) params env self acc) }
        (if (== tg TAG_E_MATCH)
            (collectTailsArms cg (nodeB e) params env self acc 0)
        (if (== tg TAG_E_BEGIN)
            (if (== (vecLen (nodeA e)) 0)
                0
                (collectTails cg (vecGet (nodeA e) (- (vecLen (nodeA e)) 1)) params env self acc))
        (if (== tg TAG_E_LET)
            (collectTails cg (nodeC e) params
                          (envWith env (nodeA e) (tailOwned cg (nodeB e) params env)) self acc)
        (if (== tg TAG_E_LETM)
            (collectTails cg (nodeC e) params (envWith env (nodeA e) 0) self acc)
        (if (== tg TAG_E_SET)
            ; `(set k v)` answers `v`: a leaf when `v` is borrowed
            (if (== (tailOwned cg e params env) 1) 0 { (vecPush acc e) 0 })
        (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR)
            (|| (== tg TAG_E_CHAR)
            (|| (== tg TAG_E_LAM)
            (|| (== tg TAG_E_WHILE)
            (|| (== tg TAG_E_SETF) (== tg TAG_E_STRUCTCON))))))))
            0
            ; a shape the walk does not know answers borrowed
            { (vecPush acc e) 0 }))))))))))))))

(pub :: collectTailsClauses (-> Int Int Int Int String Int Int Int))
(pub fn (collectTailsClauses cg cls params env self acc i)
  (if (>= i (vecLen cls))
      0
      { (collectTails cg (nodeB (vecGet cls i)) params env self acc)
        (collectTailsClauses cg cls params env self acc (+ i 1)) }))

(pub :: collectTailsArms (-> Int Int Int Int String Int Int Int))
(pub fn (collectTailsArms cg arms params env self acc i)
  (if (>= i (vecLen arms))
      0
      (let ((arm (vecGet arms i)))
        (let ((bs (patBindersCg (nodeA arm) vecNew)))
          { (collectTails cg (nodeB arm) params
                          (if (== bs 0) env (envWithAll env bs 0)) self acc)
            (collectTailsArms cg arms params env self acc (+ i 1)) }))))

; Move every parameter into an alloca, bind it as mutable storage so
; body references load it, and open the loop the tail call jumps back
; to. `bindSym ... 1` is the same registration `mut` locals use, which
; is what makes `emitVar` emit a load without knowing about any of
; this.
; Everything after the last `$`: the source-spelled name of a
; declaration whose node `mangleDecl` may have rewritten to
; `Mod$name`.
(pub :: openTailLoop (-> String Int Int Int))
; Park the evidence word in an alloca and rebind its unspellable
; name as mutable storage, exactly the registration `mut` locals
; use - `emitEvwRead` then loads it without knowing about TCO, and
; `emitTailJump` stores the next iteration's word into it.
(pub :: evwParkSlot (-> Int Int))
(pub fn (evwParkSlot cg)
  (let ((an (allocReg cg)))
    (let ((ar (regStr an)))
      {
        (emitLine cg (cat2 (cat2 "  " ar) " = alloca i64"))
        (emitLine cg (cat4 "  store i64 "
                           "%__evw.h"
                           ", ptr "
                           ar))
        (bindSym cg "__evw." ar 0 1)
      })))

; ------------------------------------------------------------------
; MM-LIFE-2c event 4: the self tail call is a release boundary, and
; the function OWNS its reference parameters across it.
;
; Parameter `i` of the declaration being emitted is a reference iff
; its declared type says so - read off the signature's arrow spine and
; classified by `fldClass`, the same function that writes a block's
; reference map, so every ownership decision in this backend agrees by
; construction. An `Int` parameter is never retained and never
; released, which is why the Life probe's board - a `Vec` behind
; `(-> Int Int Int)` - is untouched by any of this.
; ------------------------------------------------------------------
(pub :: arrowParamTy (-> Int Int Int))
(pub fn (arrowParamTy ty i)
  (if (== ty 0)
      0
      (if (!= (nodeTag ty) TAG_T_ARR)
          0
          (if (<= i 0)
              (nodeA ty)
              (arrowParamTy (nodeB ty) (- i 1))))))

(pub :: curParamRefClass (-> Int Int Int))
(pub fn (curParamRefClass cg i)
  (let ((d (memGetWord cg 36)))
    (if (== d 0)
        0
        (let ((e (findFSig (memGetWord cg 15) (nodeA d))))
          (if (== e 0)
              0
              (if (== (fldClass cg (arrowParamTy (memGetWord e 3) i)) 2)
                  1
                  0))))))

; Parameter i's evidence bit when its declared type is one of the
; signature's own type variables and the function takes an evidence
; word; -1 otherwise. The loop's slot for such a parameter is
; retained and released BY EVIDENCE: a typed reference arriving sets
; the bit, a word does not, which is exactly the share the caller's
; side of MM-LIFE-2d counts.
(pub :: curParamEvBit (-> Int Int Int))
(pub fn (curParamEvBit cg i)
  (let ((d (memGetWord cg 36)))
    (if (== d 0)
        (- 0 1)
        (let ((e (findFSig (memGetWord cg 15) (nodeA d))))
          (if (== e 0)
              (- 0 1)
              (if (== (memGetWord e 4) 0)
                  (- 0 1)
                  (let ((tn (arrowParamTy (memGetWord e 3) i)))
                    (if (== tn 0)
                        (- 0 1)
                        (if (!= (tyIsSrcVar tn) 1)
                            (- 0 1)
                            (let ((vars vecNew))
                              {
                                (cgSigVarsInto (memGetWord e 3) vars)
                                (strVecIdx vars (nodeA tn))
                              }))))))))))

; The entry retain, once per reference parameter, before the loop
; header. It converts the caller's BORROW (event 1) into a share this
; frame owns, which is what makes the boundary release below legal:
; the release hands back a count this retain took, never the caller's.
(pub :: retainRefParams (-> Int Int Int Int))
(pub fn (retainRefParams params cg i)
  (if (>= i (vecLen params))
      cg
      (let ((cg1 (if (== (curParamRefClass cg i) 1)
                     (emitRetainOf cg (cat2 "%" (llvmSym (strDup (vecGet params i)))))
                     (let ((k (curParamEvBit cg i)))
                       (if (< k 0)
                           cg
                           ; a type-variable slot: by the word this
                           ; call arrived with
                           (emitRetainIfEvBit cg (cat2 "%" (llvmSym (strDup (vecGet params i)))) k))))))
        (retainRefParams params cg1 (+ i 1)))))

(pub fn (openTailLoop name params cg)
  (let ((slots vecNew)
        (hdrN (allocReg cg)))
    (let ((hdrB (cat2 "label_" (fmtInt hdrN))))
      {
        (allocParamSlots params slots cg 0)
        (retainRefParams params cg 0)
        (memSetWord cg 27 (strDup name))
        (memSetWord cg 28 slots)
        (memSetWord cg 29 hdrB)
        (emitLine cg (cat2 "  br label %" hdrB))
        (emitLabel cg hdrB)
        cg
      })))

(pub :: allocParamSlots (-> Int Int Int Int Int))
(pub fn (allocParamSlots params slots cg i)
  (if (>= i (vecLen params))
      0
      (let ((pname (vecGet params i))
            (an (allocReg cg)))
        ; `%s.N`, not `%aN`: a parameter named `a1` is `%a1` already
        (let ((ar (cat2 "%s." (fmtInt an))))
          {
            (emitLine cg (cat2 (cat2 "  " ar) " = alloca i64"))
            (emitLine cg (cat4 "  store i64 %" (llvmSym (strDup pname)) ", ptr " ar))
            ; Kind 2, not 1: the slot is loadable storage exactly as a
            ; `mut` binding's is, which is what makes `emitVar` emit a
            ; load without knowing about tail calls - but `set` must
            ; still refuse it. stage0 rejects `(set p v)` on a
            ; parameter as AX3012 and pre-TCO stage1 refused it too;
            ; binding parameters at kind 1 quietly made them
            ; assignable, and only inside self-recursive functions,
            ; which is the worst kind of divergence: one that depends
            ; on an unrelated property of the function it appears in.
            (bindSym cg pname ar (paramFloatFlag cg i) 2)
            (vecPush slots ar)
            (allocParamSlots params slots cg (+ i 1))
          }))))

; Whether parameter `i` of the function being emitted is a float, from
; the signature flags the emitter already carries.
(pub :: paramFloatFlag (-> Int Int Int))
(pub fn (paramFloatFlag cg i)
  (let ((flags (memGetWord cg 18)))
    (if (== flags 0)
        0
        (if (>= i (vecLen flags))
            0
            (vecGet flags i)))))

; The tail jump: every argument is evaluated into its own register
; FIRST, and only then are the parameter slots written. Assigning as
; each argument is computed would clobber a parameter a later argument
; still reads - `(go (- n 1) n)` would see the decremented `n` twice.
(pub :: emitTailJump (-> Int Int Int Int))
(pub fn (emitTailJump args stamp cg)
  (let ((vals vecNew)
        (words vecNew))
    {
      (evalTailArgs args vals cg 0)
      ; MM-LIFE-2d: the next iteration's evidence word - computed
      ; from the CURRENT slot value after the arguments evaluate,
      ; stored back before the jump like any reassigned parameter.
      ; The slot exists iff this function is polymorphic (evwParkSlot
      ; bound "__evw." as mutable storage); the tcoSlots vec is
      ; untouched, so the arity gate never sees it.
      ; The type-variable slots' two words: the one this iteration
      ; arrived with (old values are released by it) and the next
      ; iteration's (new values are retained by it), stored back
      ; like any reassigned parameter. Words 0 and 1 of `words`.
      (let ((sreg (lookupSym cg "__evw.")))
        (if (if (== sreg 0) false (>= (lookupSymKind cg "__evw.") 1))
            (let ((cgO (emitEvwRead cg)))
              (let ((oldW (strDup (memGetWord cgO 2))))
                (let ((cgV (emitEvWordVal cgO stamp)))
                  (let ((newW (strDup (memGetWord cgV 2))))
                    {
                      (emitLine cgV (cat4 "  store i64 " newW ", ptr " (strDup (cast String sreg))))
                      (vecPush words (cast Int oldW))
                      (vecPush words (cast Int newW))
                    }))))
            { (vecPush words (cast Int "0")) (vecPush words (cast Int "0")) }))
      ; MM-LIFE-2c event 4, the boundary itself. RETAIN EVERY NEW
      ; VALUE FIRST, then release every old one, then store - the same
      ; order event 5 uses at a field, and for the same reason: an
      ; iteration that passes a parameter through unchanged, which is
      ; the common shape, would otherwise release the block it is
      ; about to keep. With the retains first the two cancel and the
      ; count is unmoved.
      ;
      ; The old value has to be LOADED before the store overwrites it,
      ; so the release walks the slots twice: once to read, once to
      ; hand back. Reading after `evalTailArgs` is deliberate - an
      ; argument expression may still mention the parameter it is
      ; about to replace.
      ;
      ; A parameter passed through AS ITSELF - `(scan v name (+ i 1))`,
      ; the shape of every linear scan - keeps its slot's block and
      ; its slot's share: the retain and the release would cancel,
      ; and cost two header touches per iteration. Skipped, once the
      ; name still resolves to the slot (a `let` shadowing it is a
      ; different value and pays).
      (let ((same (tailArgsUnchanged cg (memGetWord cg 28) args vecNew 0)))
        {
          (retainTailVals (memGetWord cg 28) vals same cg (cast String (vecGet words 1)) 0)
          (let ((olds vecNew))
            {
              (loadTailOlds (memGetWord cg 28) olds cg 0)
              (storeTailSlots (memGetWord cg 28) vals cg 0)
              (releaseTailOlds (memGetWord cg 28) olds same cg (cast String (vecGet words 0)) 0)
            })
        })
      ; and an OWNED temporary among the arguments hands its own share
      ; back, exactly as after an ordinary call (`releaseOwnedArgs`):
      ; the boundary retain above is the slot's share, and
      ; `(grind (wide n) (- n 1))` otherwise kept one per iteration
      (releaseTailTemps (memGetWord cg 28) args vals cg (cast String (vecGet words 1)) 0)
      ; and every releasable `let` (and owned scrutinee) still in scope:
      ; their scope ends are past the jump and will not be reached on
      ; this path; the values the slots keep were retained above
      (releasePending cg (memGetWord cg 42) 0)
      (emitLine cg (cat2 "  br label %" (memGetWord cg 29)))
      (memSetWord cg 31 1)
      (memSetWord cg 2 "0")
      cg
    }))

; The STASH summary of the function being emitted - the self call
; is a call to it, and its exit hands back its own slots.
(pub :: curFnStashMask (-> Int Int))
(pub fn (curFnStashMask cg)
  ; through the declaration being emitted (word 36), not the loop
  ; name (word 27): the exit release runs after the loop name is
  ; cleared, and read through it the mask was 0 at every `ret`
  (let ((d (memGetWord cg 36)))
    (if (== d 0)
        0
        (let ((e (findFSigCg cg (nodeA d))))
          (if (== e 0) 0 (memGetWord e 7))))))

(pub :: curFnRetMask (-> Int Int))
(pub fn (curFnRetMask cg)
  (let ((d (memGetWord cg 36)))
    (if (== d 0)
        0
        (let ((e (findFSigCg cg (nodeA d))))
          (if (== e 0) 0 (memGetWord e 8))))))

(pub :: releasePending (-> Int Int Int Int))
(pub fn (releasePending cg pend i)
  (if (>= i (vecLen pend))
      cg
      (releasePending (emitReleaseOf cg (cast String (vecGet pend i))) pend (+ i 1))))

; The temporary's OWN share, always: the boundary retain above is
; the slot's, and a parameter this function parks keeps the slot's
; share for the stash (`releaseTailOlds` and the exit leave it), not
; the temporary's as well.
(pub :: releaseTailTemps (-> Int Int Int Int String Int Int))
(pub fn (releaseTailTemps slots args vals cg newW i)
  (if (>= i (vecLen slots))
      cg
      (let ((owned (if (== (valueOwnedRef cg (vecGet args i)) 1)
                       1
                       ; a lambda is born at count 1 and the slot (an
                       ; arrow, a reference class) took its own
                       (if (== (nodeTag (vecGet args i)) TAG_E_LAM) 1 0))))
        (let ((cg1 (if (== owned 0)
                       cg
                       (if (== (curParamRefClass cg i) 1)
                           (emitReleaseOf cg (vecGet vals i))
                           (let ((k (curParamEvBit cg i)))
                             (if (< k 0)
                                 cg
                                 ; the slot took a share iff the bit
                                 ; is set, and then the temporary's
                                 ; own share goes back
                                 (emitRcIfBitOf cg (cast String (vecGet vals i)) k newW 0)))))))
          (releaseTailTemps slots args vals cg1 newW (+ i 1))))))

; Load and release the current value of every reference parameter's
; slot - the entry retain's counterpart, on the return path. Word 2
; (the function's result register) survives the loads.
(pub :: releaseRefParamSlots (-> Int Int))
(pub fn (releaseRefParamSlots cg)
  (let ((v (strDup (memGetWord cg 2)))
        (fl (memGetWord cg 14))
        (slots (memGetWord cg 28)))
    (let ((cgR (releaseRefParamSlotsFrom cg slots 0)))
      { (memSetWord cgR 2 v) (memSetWord cgR 14 fl) cgR })))

(pub :: releaseRefParamSlotsFrom (-> Int Int Int Int))
(pub fn (releaseRefParamSlotsFrom cg slots i)
  (if (>= i (vecLen slots))
      cg
      (if (!= (& (| (curFnStashMask cg) (paramsOf (wordParts (curFnRetMask cg)))) (| (paramBit i) (ownerBit i))) 0)
          ; a parameter this very function parks a word of, or
          ; ANSWERS a WORD of (`(cast Int s)` as the tail) - the
          ; slot's share is what keeps that word alive, on the way
          ; out too. A typed answer is the leaf's own retain (event
          ; 2), and the slot's share goes back
          (releaseRefParamSlotsFrom cg slots (+ i 1))
          (if (== (curParamRefClass cg i) 1)
              (let ((cgL (loadFromSlot cg (vecGet slots i))))
                (releaseRefParamSlotsFrom (emitReleaseOf cgL (strDup (memGetWord cgL 2))) slots (+ i 1)))
              (let ((k (curParamEvBit cg i)))
                (if (< k 0)
                    (releaseRefParamSlotsFrom cg slots (+ i 1))
                    ; a type-variable slot: by the word current for it
                    (let ((cgL (loadFromSlot cg (vecGet slots i))))
                      (let ((v (strDup (memGetWord cgL 2))))
                        (let ((cgW (emitEvwRead cgL)))
                          (releaseRefParamSlotsFrom
                            (emitRcIfBitOf cgW v k (strDup (memGetWord cgW 2)) 0)
                            slots (+ i 1)))))))))))

(pub :: retainTailVals (-> Int Int Int Int String Int Int))
(pub fn (retainTailVals slots vals same cg newW i)
  (if (>= i (vecLen slots))
      cg
      (let ((cg1 (if (== (vecGet same i) 1)
                     cg
                     (if (== (curParamRefClass cg i) 1)
                         (emitRetainOf cg (vecGet vals i))
                         (let ((k (curParamEvBit cg i)))
                           (if (< k 0)
                               cg
                               (emitRcIfBitOf cg (cast String (vecGet vals i)) k newW 1)))))))
        (retainTailVals slots vals same cg1 newW (+ i 1)))))

; Flag per slot: 1 when argument i is the VAR of parameter i and the
; name still names the slot.
(pub :: tailArgsUnchanged (-> Int Int Int Int Int Int))
(pub fn (tailArgsUnchanged cg slots args out i)
  (if (>= i (vecLen slots))
      out
      (let ((a (vecGet args i)))
        { (vecPush out
                   (if (!= (nodeTag a) TAG_E_VAR)
                       0
                       (let ((r (lookupSym cg (nodeA a))))
                         (if (== r 0)
                             0
                             (if (strEq (cast String r) (vecGet slots i)) 1 0)))))
          (tailArgsUnchanged cg slots args out (+ i 1)) })))

(pub :: loadTailOlds (-> Int Int Int Int Int))
(pub fn (loadTailOlds slots olds cg i)
  (if (>= i (vecLen slots))
      cg
      {
        (if (|| (== (curParamRefClass cg i) 1) (>= (curParamEvBit cg i) 0))
            {
              (loadFromSlot cg (vecGet slots i))
              (vecPush olds (strDup (memGetWord cg 2)))
            }
            (vecPush olds ""))
        (loadTailOlds slots olds cg (+ i 1))
      }))

; Not a parameter this function parks a word of: the iteration that
; parked it left the slot's share as the stash's keeper, and the
; jump must not take it back.
(pub :: releaseTailOlds (-> Int Int Int Int String Int Int))
(pub fn (releaseTailOlds slots olds same cg oldW i)
  (if (>= i (vecLen olds))
      cg
      (let ((cg1 (if (|| (== (vecGet same i) 1)
                         (!= (& (curFnStashMask cg) (| (paramBit i) (ownerBit i))) 0))
                     cg
                     (if (== (curParamRefClass cg i) 1)
                         (emitReleaseOf cg (vecGet olds i))
                         (let ((k (curParamEvBit cg i)))
                           (if (< k 0)
                               cg
                               (emitRcIfBitOf cg (cast String (vecGet olds i)) k oldW 0)))))))
        (releaseTailOlds slots olds same cg1 oldW (+ i 1)))))

; A parameter slot is an `alloca`; reading it is the same load
; `emitVar` emits for a kind-2 binding, without going through the
; symbol table (the slot is what we hold, not the name).
(pub :: loadFromSlot (-> Int String Int))
(pub fn (loadFromSlot cg slot)
  (let ((rn (allocReg cg)))
    (let ((r (regStr rn)))
      {
        (emitLine cg (cat4 (cat2 "  " r) " = load i64, ptr " slot ""))
        (memSetWord cg 2 r)
        cg
      })))

(pub :: evalTailArgs (-> Int Int Int Int Int))
(pub fn (evalTailArgs args vals cg i)
  (if (>= i (vecLen args))
      0
      {
        (emitExpr (vecGet args i) cg)
        (vecPush vals (strDup (memGetWord cg 2)))
        (evalTailArgs args vals cg (+ i 1))
      }))

(pub :: storeTailSlots (-> Int Int Int Int Int))
(pub fn (storeTailSlots slots vals cg i)
  (if (>= i (vecLen slots))
      0
      {
        (emitLine cg (cat4 "  store i64 " (vecGet vals i)
                           ", ptr " (vecGet slots i)))
        (storeTailSlots slots vals cg (+ i 1))
      }))

; ------------------------------------------------------------------
; Does `e` contain a call to `name` with `arity` arguments in TAIL
; position?
;
; Asked before a function is emitted so that the overwhelming majority
; of functions - which self-recurse nowhere - keep emitting exactly the
; LLVM they emitted before, parameters as SSA values and no loop
; header. Only a function that will actually use the loop pays for it.
;
; TAIL POSITION is the whole correctness question. Rewriting a call
; that is *not* in tail position does not crash; it returns the wrong
; answer, because the work waiting on the call's result never happens.
; So the positions here are exactly stage0's, and no others: the last
; expression of a `{}` block, both arms of an `if`, the body of a
; `let`, and the expression itself.
; ------------------------------------------------------------------
(pub :: tailCallsSelf (-> Int String Int Int))
(pub fn (tailCallsSelf e name arity)
  (let ((tag (nodeTag e)))
    (if (== tag TAG_E_APP)
        (if (&& (strEq (spineHeadName e) name)
                (== (spineArgs e 0) arity))
            1
            0)
    (if (== tag TAG_E_BEGIN)
        (let ((v (nodeA e)))
          (if (== (vecLen v) 0)
              0
              (tailCallsSelf (vecGet v (- (vecLen v) 1)) name arity)))
    (if (== tag TAG_E_IF)
        (if (== (tailCallsSelf (nodeB e) name arity) 1)
            1
            (tailCallsSelf (nodeC e) name arity))
    (if (== tag TAG_E_MATCH)
        (armsCallSelf (nodeB e) name arity 0)
    (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
        (if (strEq (nodeA e) name)
            0
            (tailCallsSelf (nodeC e) name arity))
        0)))))))

; A `let` body IS a tail position, since 2026-08-22. It was not, for
; two defects that following stage0's omission avoided: a `mut`
; binding inside the loop re-executed its `alloca` on every iteration
; and grew the stack without bound - every `alloca` now sits in the
; entry block (`openAllocaMark`), so no binding allocates per
; iteration - and a local shadowing the function's own name
; (`(let ((f (lambda ...))) (f x))`) became a jump to the function
; instead of a call to the local - `dispatchCall` resolves the head
; as a local before it considers the rewrite, and a `let` binding the
; name itself is refused here too. What made it worth taking: event
; 3 releases a `let`'s temporary AFTER the self call it wraps, and
; that release is what stopped LLVM's own sibling-call pass from
; rescuing `(let ((s (strConcat s "x"))) (grow s (- n 1)))` - 200,000
; deep, it overflowed where the leaking compiler had not. A `mut`
; body, a `while` body and `&&`/`||` operands are still not tail
; positions.

(pub :: armsCallSelf (-> Int String Int Int Int))
(pub fn (armsCallSelf arms name arity i)
  (if (>= i (vecLen arms))
      0
      (if (== (tailCallsSelf (nodeB (vecGet arms i)) name arity) 1)
          1
          (armsCallSelf arms name arity (+ i 1)))))

; The head of an application spine, as a name, or "" when the head is
; not a plain name.
(pub :: spineHeadName (-> Int String))
(pub fn (spineHeadName e)
  (if (== (nodeTag e) TAG_E_APP)
      (spineHeadName (nodeA e))
      (if (== (nodeTag e) TAG_E_VAR)
          (nodeA e)
          "")))

; ------------------------------------------------------------------
; Emit `e` knowing it sits in tail position.
;
; Everything here either delegates to `emitExpr` unchanged or hands
; tail position to exactly the sub-expression that inherits it. The
; only thing it does differently is set `tailOK` for an application,
; which is what lets `dispatchCall` recognise the one call it may
; rewrite.
; ------------------------------------------------------------------
(pub :: emitExprTail (-> Int Int Int))
(pub fn (emitExprTail e cg)
  (let ((tag (nodeTag e)))
    (if (== tag TAG_E_APP)
        {
          (memSetWord cg 30 1)
          (let ((cgA (emitExpr e cg)))
            {
              (memSetWord cgA 30 0)
              (retainTailLeaf e cgA)
            })
        }
    (if (== tag TAG_E_BEGIN)
        (emitSeqTail (nodeA e) cg 0)
    (if (== tag TAG_E_IF)
        (emitIfTail e cg)
    (if (== tag TAG_E_MATCH)
        (emitMatchTail e cg)
    ; a `let`'s body inherits tail position: the leaf retain, and
    ; the self call under it is rewritten like any other (its
    ; pending temporary is paid at the jump, `emitTailJump`)
    (if (== tag TAG_E_LET)
        (emitLetAt e cg 1)
    (if (== tag TAG_E_LETM)
        (emitLetMAt e cg 1)
        (retainTailLeaf e (emitExpr e cg))))))))))

; Every expression of a block but the last is ordinary; the last
; inherits tail position.
(pub :: emitSeqTail (-> Int Int Int Int))
(pub fn (emitSeqTail exprs cg i)
  (if (>= i (vecLen exprs))
      cg
      (if (== i (- (vecLen exprs) 1))
          (emitExprTail (vecGet exprs i) cg)
          (let ((e (vecGet exprs i)))
            (let ((cg1 (emitExpr e cg)))
              ; the same discard rule as emitSeq - a TCO loop body is
              ; exactly where a per-iteration build-and-drop lives
              (let ((cg2 (if (== (valueOwnedRef cg1 e) 1)
                             (emitReleaseOf cg1 (strDup (memGetWord cg1 2)))
                             cg1)))
                (emitSeqTail exprs cg2 (+ i 1))))))))

; `match` in tail position: every arm body inherits it. This is the
; shape most recursive Axiom is written in - a walk over a `data`
; value - so leaving it out meant the optimisation missed the case it
; is most wanted for.
;
; Easier than `if`, because a match already routes its result through
; a heap cell rather than a phi: an arm that ends in a jump simply
; does not store and does not branch to the merge. And the merge block
; can never become unreachable, because the no-arm-matched fallback
; always branches to it.
(pub :: emitMatchTail (-> Int Int Int))
(pub fn (emitMatchTail node cg)
  (let ((scrutExpr (nodeA node))
        (arms (nodeB node))
        (ff (memAlloc 8))
        (_0 (memSetWord ff 0 (- 0 1)))
        (cg1 (emitExpr scrutExpr cg))
        (sv (strDup (memGetWord cg1 2)))
        (cn (allocReg cg1))
        (cell (regStr cn))
        (_1 (emitLine cg1 (cat3 (cat2 "  " cell)
                                " = ptrtoint ptr %__scr.h to i64"
                                "")))
        (mn (allocReg cg1))
        (mergeB (cat2 "label_" (fmtInt mn)))
        (rel (scrutineeReleasable node scrutExpr cg1))
        (pmark (vecLen (memGetWord cg1 42)))
        (_p (if (== rel 1) (vecPush (memGetWord cg1 42) (cast Int sv)) 0))
        (cg2 (emitArmsTail arms sv cell mergeB cg1 0 ff))
        (_q (memSetWord (memGetWord cg2 42) 0 pmark))
        (_2 (emitLabel cg2 mergeB))
        (cg3 (loadWordAt cg2 cell 0))
        (armFlag (memGetWord ff 0))
        (_3 (memSetWord cg3 14 (if (== armFlag (- 0 1)) 0 armFlag)))
        (_4 (memSetWord cg3 31 0)))
    (if (== rel 1) (releaseScrutinee sv cg3) cg3)))

(pub :: emitArmsTail (-> Int String String String Int Int Int Int))
(pub fn (emitArmsTail arms sv cell mergeB cg i ff)
  (if (>= i (vecLen arms))
      {
        ; the explicit fall-through zero - see emitArms' comment
        (storeWordAt cg cell 0 "0")
        (emitLine cg (cat2 "  br label %" mergeB))
        cg
      }
      (let ((arm (vecGet arms i))
            (pat (nodeA arm))
            (body (nodeB arm))
            (nn (allocReg cg))
            (nextB (cat2 "label_" (fmtInt nn)))
            (mark (symMark cg)))
        (let ((cgP (emitPatMatch pat (strDup sv) nextB cg 0)))
          (let ((cgB (emitExprTail body cgP))
                (_ff (if (== i 0) (memSetWord ff 0 (memGetWord cgB 14)) 0)))
            (let ((termd (memGetWord cgB 31)))
              {
                ; An arm that jumped back to the loop header has
                ; nothing to store and nowhere to fall through to.
                (if (== termd 1)
                    0
                    {
                      (storeWordAt cgB cell 0 (strDup (memGetWord cgB 2)))
                      (emitLine cgB (cat2 "  br label %" mergeB))
                      0
                    })
                (memSetWord cgB 31 0)
                (emitLabel cgB nextB)
                (symRestore cgB mark)
                (emitArmsTail arms sv cell mergeB cgB (+ i 1) ff)
              }))))))

; `if` in tail position. Both arms inherit, and either may end with a
; branch back to the loop header instead of a value - so the merge
; block and its phi have to be built from whichever arms actually
; reach them. A phi naming a predecessor that jumped elsewhere is
; invalid LLVM, and a second terminator in a block is too.
(pub :: emitIfTail (-> Int Int Int))
(pub fn (emitIfTail node cg)
  (let ((testExpr (nodeA node))
        (thenExpr (nodeB node))
        (elseExpr (nodeC node))
        (cg1 (emitExpr testExpr cg))
        (testReg (strDup (memGetWord cg1 2)))
        (cmpN (allocReg cg1))
        (thenLbl (allocReg cg1))
        (elseLbl (allocReg cg1))
        (mergeLbl (allocReg cg1))
        (cmpR (regStr cmpN))
        (thenB (cat2 "label_" (fmtInt thenLbl)))
        (elseB (cat2 "label_" (fmtInt elseLbl)))
        (mergeB (cat2 "label_" (fmtInt mergeLbl)))
        (_1 (emitLine cg1 (cat4 (cat2 "  " cmpR)
                                " = icmp ne i64 "
                                testReg
                                ", 0")))
        (_2 (emitLine cg1 (cat4 (cat3 "  br i1 " cmpR ", label %")
                                thenB
                                (cat2 ", label %" elseB)
                                "")))
        (_3 (emitLabel cg1 thenB))
        (cg2 (emitExprTail thenExpr cg1))
        (thenTerm (memGetWord cg2 31))
        (thenVal (strDup (memGetWord cg2 2)))
        (thenFlag (memGetWord cg2 14))
        (thenPred (strDup (memGetWord cg2 11)))
        (_4 (if (== thenTerm 1) 0 (emitLine cg2 (cat2 "  br label %" mergeB))))
        (_4b (memSetWord cg2 31 0))
        (_5 (emitLabel cg2 elseB))
        (cg3 (emitExprTail elseExpr cg2))
        (elseTerm (memGetWord cg3 31))
        (elseVal (strDup (memGetWord cg3 2)))
        (elsePred (strDup (memGetWord cg3 11)))
        (_6 (if (== elseTerm 1) 0 (emitLine cg3 (cat2 "  br label %" mergeB)))))
    (if (&& (== thenTerm 1) (== elseTerm 1))
        ; Neither arm falls through: the whole `if` is a jump, there is
        ; nothing to merge, and the caller must not emit a `ret`.
        {
          (memSetWord cg3 31 1)
          cg3
        }
        (if (== thenTerm 1)
            ; Only the else arm reaches the merge, so its value is the
            ; result outright - a phi with one incoming edge would be
            ; legal but pointless.
            {
              (emitLabel cg3 mergeB)
              (memSetWord cg3 2 elseVal)
              (memSetWord cg3 14 (memGetWord cg3 14))
              (memSetWord cg3 31 0)
              cg3
            }
            (if (== elseTerm 1)
                {
                  (emitLabel cg3 mergeB)
                  (memSetWord cg3 2 thenVal)
                  (memSetWord cg3 14 thenFlag)
                  (memSetWord cg3 31 0)
                  cg3
                }
                (let ((_7 (emitLabel cg3 mergeB))
                      (phiN (allocReg cg3)))
                  (let ((phiR (regStr phiN)))
                    {
                      (emitLine cg3
                        (cat4 (cat3 (cat2 "  " phiR)
                                    " = phi i64 [ " thenVal)
                              (cat3 ", %" thenPred " ], [ ")
                              (cat3 elseVal ", %" elsePred)
                              " ]"))
                      (memSetWord cg3 2 phiR)
                      (memSetWord cg3 14 thenFlag)
                      (memSetWord cg3 31 0)
                      cg3
                    })))))))

(pub :: emitParams (-> Int Int Int String))
(pub fn (emitParams params cg i)
  (if (>= i (vecLen params))
      ""
      (let ((pname (vecGet params i))
            (rest (emitParams params cg (+ i 1))))
        (if (== (strLen rest) 0)
            (cat3 "i64 %" (llvmSym (strDup pname)) "")
            (cat3 (cat3 "i64 %" (llvmSym (strDup pname)) ", ") rest "")))))

; ------------------------------------------------------------------
; Lambda expressions: capture, lifting, and the record convention.
;
; A lambda is lifted to a fresh top-level function `_lam_N` whose
; hidden first parameter `%_env` is the closure record: word 0 the
; code pointer, words 1.. the captured values. `emitIndirectCall`
; passes the record itself as that first argument on every call
; through a value, so a record built from a *bare top-level function*
; cannot point at the function directly - its parameters would shift
; by one. It points at a forwarding thunk (`_thunk_N`) that ignores
; the record and calls the function with the arguments unshifted.
; stage0 solves the same problem the other way, by giving every
; function the hidden parameter; either convention is sound alone,
; and the conformance suite observes exit codes, not symbol tables.
;
; Capture is by value, and captures *everything in scope* - every
; parameter of, and every binding in, the enclosing function that the
; lambda does not shadow with a parameter of its own - rather than
; walking the body for its free variables. The extra record words are
; unobservable, and the free-variable walker they replace is the kind
; of code whose one missed case (a pattern binder, a nested arm's
; variable) is a silent wrong capture. Each name is captured once,
; at its current resolution - `emitVar` does the resolving, so a
; `mut` binding is captured as the value it holds when the record is
; built, which is stage0's snapshot semantics too.
; ------------------------------------------------------------------

; The names a lambda captures: every parameter and local in scope
; that its body MENTIONS (a nested lambda's mentions included), and
; the evidence word, which a polymorphic construction inside the
; body reads without naming. Until 2026-08-22 every name in scope
; was captured, mentioned or not, and a loop building a closure per
; iteration chained each to the one before it through a parameter
; the body never used.
(pub :: collectCapNames (-> Int Int Int Int))
(pub fn (collectCapNames cg lparams body)
  (let ((out vecNew))
    {
      (capFromVec (memGetWord cg 17) lparams body out 0)
      (capFromVec (memGetWord cg 6) lparams body out 0)
      out
    }))

(pub :: capFromVec (-> Int Int Int Int Int Int))
(pub fn (capFromVec src lparams body out i)
  (if (== src 0)
      0
      (if (>= i (vecLen src))
          0
          {
            (let ((name (vecGet src i)))
              (if (>= (strIndexIn lparams name) 0)
                  0
                  (if (>= (strIndexIn out name) 0)
                      0
                      (if (|| (strEq name "__evw.") (== (mentions name body) 1))
                          (vecPush out name)
                          0))))
            (capFromVec src lparams body out (+ i 1))
          })))

(pub :: strIndexIn (-> Int String Int))
(pub fn (strIndexIn v name)
  (if (== v 0)
      (- 0 1)
      (strIndexFrom v name 0)))

(pub :: strIndexFrom (-> Int String Int Int))
(pub fn (strIndexFrom v name i)
  (if (>= i (vecLen v))
      (- 0 1)
      (if (strEq (vecGet v i) name)
          i
          (strIndexFrom v name (+ i 1)))))

; Evaluate each captured name in the enclosing scope, recording the
; value register and its float-ness. Goes through `emitVar` so a
; mutable binding is loaded, not aliased.
(pub :: capValues (-> Int Int Int Int Int Int))
(pub fn (capValues cg capNames capRegs capFloats i)
  (if (>= i (vecLen capNames))
      cg
      (let ((cg1 (emitVar (mkEVar (vecGet capNames i)) cg)))
        {
          (vecPush capRegs (strDup (memGetWord cg1 2)))
          (vecPush capFloats (memGetWord cg1 14))
          (capValues cg1 capNames capRegs capFloats (+ i 1))
        })))

; A lifted lambda, waiting for the enclosing function to close:
; word 0 name, word 1 params, word 2 body, word 3 capture names,
; word 4 capture float flags.
(pub :: mkLamDesc (-> String Int Int Int Int Int))
(pub fn (mkLamDesc lname lparams body capNames capFloats)
  (let ((d (memAlloc 40)))
    {
      (memSetWord d 0 lname)
      (memSetWord d 1 lparams)
      (memSetWord d 2 body)
      (memSetWord d 3 capNames)
      (memSetWord d 4 capFloats)
      d
    }))

(pub :: emitLambda (-> Int Int Int))
(pub fn (emitLambda node cg)
  (let ((lparams (nodeA node))
        (body (nodeB node))
        (n (memGetWord cg 22)))
    (let ((lname (cat2 "_lam_" (fmtInt n)))
          (capNames (collectCapNames cg lparams body))
          (capRegs vecNew)
          (capFloats vecNew))
      {
        (memSetWord cg 22 (+ n 1))
        (capValues cg capNames capRegs capFloats 0)
        (let ((k (vecLen capNames))
              (pn (allocReg cg))
              (fn2 (allocReg cg)))
          (let ((pr (regStr pn))
                (fr (cat2 "%f" (fmtInt fn2))))
            {
              (emitLine cg (strConcat (cat3 (cat2 "  " pr)
                                            " = call i64 @axiom_alloc(i64 "
                                            (fmtInt (* (+ k 1) 8)))
                                      ")"))
              (emitLine cg (cat4 (cat2 "  " fr)
                                 " = ptrtoint ptr @"
                                 (llvmSym (strDup lname))
                                 " to i64"))
              (storeWordAt cg pr 0 fr)
              ; A1: the record births owned.
              (storeCountOneAt cg pr)
              ; and its reference map names every capture that takes
              ; a share below (`retainParamCaps`: the reference-class
              ; parameters), so the record's death hands them back -
              ; a closure per iteration of a loop chained a million
              ; captured closures that nothing ever released
              (storeShapeAt cg pr (lamShapeConst cg capNames k))
              ; A capture that is a REFERENCE PARAMETER of the
              ; enclosing function takes a share, and this is the one
              ; hole that would make event 4's boundary release
              ; unsound rather than merely incomplete: a lambda
              ; captures everything in scope, so a closure escaping
              ; the loop would otherwise hold a parameter the next
              ; boundary releases. The share is unbalanced - a
              ; closure record still carries no map - so it leaks,
              ; which is the safe direction and no worse than the
              ; unretained store it replaces.
              ;
              ; Captures that are `let` bindings stay unretained on
              ; purpose: nothing releases a binding, so nothing can
              ; free one out from under a closure. The rule is not
              ; "retain every capture", it is "retain what something
              ; else may hand back", and today that is exactly the
              ; reference parameters.
              (retainParamCaps cg capNames capRegs 0)
              (storeCaps cg pr capRegs 0)
              (memSetWord cg 21 (vecPush (memGetWord cg 21)
                                         (mkLamDesc lname lparams body
                                                    capNames capFloats)))
              (memSetWord cg 2 pr)
              (memSetWord cg 14 0)
              cg
            }))
      })))

; The index of `name` in the enclosing function's parameter list, or
; -1. `cg 17` is that list, set by `emitFnDef` before the body runs.
; A lambda record's shape word: `k + 1` words, and a map bit for
; capture i (payload word 1 + i) iff it is a reference-class
; parameter, the captures `retainParamCaps` retains. Past the map's
; 47 words the record is a leaf, as a constructor's would be.
(pub :: lamShapeConst (-> Int Int Int Int))
(pub fn (lamShapeConst cg capNames k)
  (let ((cnt (paddedWords (+ k 1))))
    (+ (* cnt 2)
       (if (> (+ k 1) 47) 0 (lamShapeBits cg capNames 0)))))

(pub :: lamShapeBits (-> Int Int Int Int))
(pub fn (lamShapeBits cg capNames i)
  (if (>= i (vecLen capNames))
      0
      (let ((pi (curParamIndex cg (vecGet capNames i))))
        (+ (if (if (< pi 0) false (== (curParamRefClass cg pi) 1))
               (pow2 (+ 16 (+ 1 i)))
               0)
           (lamShapeBits cg capNames (+ i 1))))))

(pub :: curParamIndex (-> Int String Int))
(pub fn (curParamIndex cg name)
  (let ((ps (memGetWord cg 17)))
    (if (== ps 0)
        (- 0 1)
        (strIndexIn ps name))))

(pub :: retainParamCaps (-> Int Int Int Int Int))
(pub fn (retainParamCaps cg capNames capRegs i)
  (if (>= i (vecLen capNames))
      cg
      (let ((pi (curParamIndex cg (vecGet capNames i))))
        (let ((cg1 (if (if (< pi 0) false (== (curParamRefClass cg pi) 1))
                       (emitRetainOf cg (vecGet capRegs i))
                       cg)))
          (retainParamCaps cg1 capNames capRegs (+ i 1))))))

(pub :: storeCaps (-> Int String Int Int Int))
(pub fn (storeCaps cg base capRegs i)
  (if (>= i (vecLen capRegs))
      cg
      (storeCaps (storeWordAt cg base (+ 1 i) (vecGet capRegs i))
                 base capRegs (+ i 1))))

; Write out every lifted lambda the last function created - a lambda
; body may itself contain lambdas, which land on the same list and
; are drained by the same loop - then any new forwarding thunks.
(pub :: drainPending (-> Int Int))
(pub fn (drainPending cg)
  (let ((pend (memGetWord cg 21)))
    (if (== (vecLen pend) 0)
        (drainThunks cg)
        (drainPending (emitLamDef (vecPop pend) cg)))))

; The lifted function itself: `emitFnDef`'s shape with `%_env` in
; front, and the captures bound as symbols before the body - loaded
; from the record at the offsets `emitLambda` stored them to.
(pub :: emitLamDef (-> Int Int Int))
(pub fn (emitLamDef d cg)
  (let ((lname (memGetWord d 0))
        (lparams (memGetWord d 1))
        (body (memGetWord d 2))
        (capNames (memGetWord d 3))
        (capFloats (memGetWord d 4)))
    (let ((paramStr (emitParams lparams cg 0))
          (_ (memSetWord cg 1 0))
          (_2 (memSetWord cg 6 vecNew))
          (_3 (memSetWord cg 7 vecNew))
          (_4 (memSetWord cg 16 vecNew))
          (_4b (memSetWord cg 20 vecNew))
          (_5 (memSetWord cg 17 lparams))
          (_6 (memSetWord cg 18 0)))
      (let ((hdr (strConcat (cat4 "define i64 @"
                                  (strDup lname)
                                  "(i64 %_env"
                                  (if (== (strLen paramStr) 0)
                                      ""
                                      (cat2 ", " paramStr)))
                            ") #0 {")))
        (let ((cg1 (openAllocaMark
                     (let ((cgH (emitLine cg hdr)))
                       (if (== (bodyHasMatch body) 1)
                           (emitLine cgH "  %__scr.h = alloca i64")
                           cgH)))))
          ; The lifted-lambda twin of the re-scan deleted in `emitFnDef`,
          ; and redundant for the same reason: slot 8 is `allDecls`,
          ; already scanned once by `emitResolved`, and nothing clears
          ; the types table between bodies.
          (let ((cg1b cg1))
            (let ((cg1c (bindCaps cg1b capNames capFloats 0)))
              (let ((cg2 (emitExpr body cg1c)))
                (let ((ret (cat3 "  ret i64 " (strDup (memGetWord cg2 2)) "")))
                  (emitLine (emitLine (closeAllocaMark cg2) ret) "}"))))))))))

(pub :: bindCaps (-> Int Int Int Int Int))
(pub fn (bindCaps cg capNames capFloats i)
  (if (>= i (vecLen capNames))
      cg
      (let ((cg1 (loadWordAt cg "%_env" (+ 1 i))))
        {
          (bindSym cg1 (vecGet capNames i)
                   (strDup (memGetWord cg1 2))
                   (vecGet capFloats i)
                   0)
          (bindCaps cg1 capNames capFloats (+ i 1))
        })))

; A forwarding thunk for a bare top-level function used as a value:
; takes the record it ignores, forwards the declared parameters.
(pub :: thunkIndexFor (-> Int String Int Int))
(pub fn (thunkIndexFor cg full ar)
  (let ((idx (strIndexIn (memGetWord cg 23) full)))
    (if (>= idx 0)
        idx
        (let ((n (vecLen (memGetWord cg 23))))
          {
            (vecPush (memGetWord cg 23) (strDup full))
            (vecPush (memGetWord cg 24) ar)
            n
          }))))

(pub :: fnArityOf (-> Int String Int))
(pub fn (fnArityOf decls full)
  (fnArityIn decls (declSpellingOf full) 0))

(pub :: fnArityIn (-> Int String Int Int))
(pub fn (fnArityIn decls full i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeA d) full))
            (vecLen (nodeB d))
            (fnArityIn decls full (+ i 1))))))

(pub :: drainThunks (-> Int Int))
(pub fn (drainThunks cg)
  (let ((i (memGetWord cg 25)))
    (if (>= i (vecLen (memGetWord cg 23)))
        cg
        {
          (memSetWord cg 25 (+ i 1))
          (drainThunks (emitThunkDef i cg))
        })))

(pub :: emitThunkDef (-> Int Int Int))
(pub fn (emitThunkDef i cg)
  (let ((full (vecGet (memGetWord cg 23) i))
        (ar (vecGet (memGetWord cg 24) i)))
    (let ((cg1 (emitLine cg (strConcat (cat4 "define i64 @_thunk_"
                                             (fmtInt i)
                                             "(i64 %_env"
                                             (thunkParamStr ar 0))
                                       ") #0 {"))))
      ; MM-LIFE-2d: a thunk over a polymorphic function forwards the
      ; constant 0 as its evidence - a bare reference instantiates
      ; fresh never-solved placeholders (MAC-INT-2), so every bit is
      ; unknowable BY CONSTRUCTION and 0 is the honest word, not a
      ; fallback. The record stays one word; the spec's baking
      ; sentence is unreachable under this type system, and
      ; memory-model.md now says so.
      (let ((evTail (if (== (fnTakesEvw cg1 full) 1)
                        (if (== (cast Int ar) 0) "i64 0" ", i64 0")
                        "")))
      (let ((cg2 (emitLine cg1 (strConcat (cat3 (cat4 "  %r = call i64 @"
                                                (llvmSym (strDup full))
                                                "("
                                                (thunkArgStr ar 0))
                                                evTail "")
                                          ")"))))
        (emitLine (emitLine cg2 "  ret i64 %r") "}"))))))

(pub :: thunkParamStr (-> Int Int String))
(pub fn (thunkParamStr ar j)
  (if (>= j ar)
      ""
      (cat3 (cat2 ", i64 %a" (fmtInt j)) (thunkParamStr ar (+ j 1)) "")))

(pub :: thunkArgStr (-> Int Int String))
(pub fn (thunkArgStr ar j)
  (if (>= j ar)
      ""
      (let ((rest (thunkArgStr ar (+ j 1))))
        (cat3 (cat2 "i64 %a" (fmtInt j))
              (if (== (strLen rest) 0) "" (cat2 ", " rest))
              ""))))


; ------------------------------------------------------------------
; `match`.
;
; A constructor with fields is a heap block whose word 0 is the tag; a
; nullary constructor of a `data` type is emitted as the tag itself. So
; where to look for the tag is decided by the constructor named in the
; *pattern*, which is static, and not by inspecting the value, which
; cannot say.
;
; The result goes through a one-word heap cell rather than a phi. A phi
; would need one incoming edge per arm, and building that incrementally
; while the arms are still being emitted is harder to get right than a
; store per arm and a single load at the end.
; ------------------------------------------------------------------
(pub :: patHead (-> Int Int))
(pub fn (patHead pat)
  (if (== (nodeTag pat) TAG_E_VAR)
      (nodeA pat)
      (if (== (nodeTag pat) TAG_E_APP)
          (patHead (nodeA pat))
          0)))

(pub :: loadWordAt (-> Int String Int Int))
(pub fn (loadWordAt cg base idx)
  (let ((pn (allocReg cg))
        (pr (regStr pn))
        (_1 (emitLine cg (cat4 (cat2 "  " pr)
                               " = inttoptr i64 "
                               base
                               " to ptr")))
        (an (allocReg cg))
        (ar (regStr an))
        (_2 (emitLine cg (cat4 (cat3 (cat2 "  " ar)
                                     " = getelementptr i64, ptr "
                                     pr)
                               ", i64 "
                               (fmtInt idx)
                               "")))
        (vn (allocReg cg))
        (vr (regStr vn))
        (_3 (emitLine cg (cat4 (cat2 "  " vr)
                               " = load i64, ptr "
                               ar
                               "")))
        (_4 (memSetWord cg 2 vr)))
    cg))

; The four symbol vectors stay parallel by construction: this is the
; only place that pushes them. `kind` 0 binds a value register, 1 an
; alloca whose reads load.
(pub :: bindSym (-> Int String String Int Int Int))
(pub fn (bindSym cg name reg isFloat kind)
  {
    (memSetWord cg 6 (vecPush (memGetWord cg 6) name))
    (memSetWord cg 7 (vecPush (memGetWord cg 7) reg))
    (memSetWord cg 16 (vecPush (memGetWord cg 16) isFloat))
    (memSetWord cg 20 (vecPush (memGetWord cg 20) kind))
    cg
  })

; Truncate the three parallel symbol vectors back to `mark`, undoing
; every binding made since. An arm's binders must not survive into the
; next arm's emission: a later arm mentioning a name only an *earlier*
; arm bound would otherwise resolve to the earlier arm's register - a
; value that does not exist on the path that reaches it.
(pub :: symMark (-> Int Int))
(pub fn (symMark cg)
  (vecLen (memGetWord cg 6)))

(pub :: symRestore (-> Int Int Int))
(pub fn (symRestore cg mark)
  {
    (memSetWord (memGetWord cg 6) 0 mark)
    (memSetWord (memGetWord cg 7) 0 mark)
    (memSetWord (memGetWord cg 16) 0 mark)
    (memSetWord (memGetWord cg 20) 0 mark)
    cg
  })

(pub :: emitMatch (-> Int Int Int))
(pub fn (emitMatch node cg)
  (let ((scrutExpr (nodeA node))
        (arms (nodeB node))
        ; A compile-time cell for the first arm's float flag - a local
        ; rather than a CG field, so a nested match cannot clobber the
        ; outer one's. A well-typed match yields one type from every
        ; arm, so the first arm speaks for the form.
        (ff (memAlloc 8))
        (_0 (memSetWord ff 0 (- 0 1)))
        (cg1 (emitExpr scrutExpr cg))
        (sv (strDup (memGetWord cg1 2)))
        (cn (allocReg cg1))
        (cell (regStr cn))
        (_1 (emitLine cg1 (cat3 (cat2 "  " cell)
                                " = ptrtoint ptr %__scr.h to i64"
                                "")))
        (mn (allocReg cg1))
        (mergeB (cat2 "label_" (fmtInt mn)))
        (rel (scrutineeReleasable node scrutExpr cg1))
        (pmark (vecLen (memGetWord cg1 42)))
        (_p (if (== rel 1) (vecPush (memGetWord cg1 42) (cast Int sv)) 0))
        (cg2 (emitArms arms sv cell mergeB cg1 0 ff))
        (_q (memSetWord (memGetWord cg2 42) 0 pmark))
        (_2 (emitLabel cg2 mergeB))
        (cg3 (loadWordAt cg2 cell 0))
        (armFlag (memGetWord ff 0))
        (_3 (memSetWord cg3 14 (if (== armFlag (- 0 1)) 0 armFlag))))
    (if (== rel 1) (releaseScrutinee sv cg3) cg3)))

; An OWNED scrutinee - `(match (Some (fmtInt i)) ...)` - is a
; temporary the match consumed: released after the merge, unless some
; arm's binder escapes through its body (the binders are the block's
; fields, and the walk that decides this for a `let` decides it
; here). The match's own value in word 2 is kept.
(pub :: scrutineeReleasable (-> Int Int Int Int))
(pub fn (scrutineeReleasable node scrutExpr cg)
  (if (== (valueOwnedRef cg scrutExpr) 0)
      0
      (if (== (escapesViaBinders cg (nodeB node) 1 0 node) 1) 0 1)))

(pub :: releaseScrutinee (-> String Int Int))
(pub fn (releaseScrutinee sv cg)
  (let ((v (strDup (memGetWord cg 2)))
        (fl (memGetWord cg 14)))
    (let ((cgR (emitReleaseOf cg sv)))
      { (memSetWord cgR 2 v) (memSetWord cgR 14 fl) cgR })))

(pub :: emitArms (-> Int String String String Int Int Int Int))
(pub fn (emitArms arms sv cell mergeB cg i ff)
  (if (>= i (vecLen arms))
      ; No arm matched. The scratch is an alloca now, not an
      ; allocator-zeroed cell, so the zero a fall-through answers is
      ; stored EXPLICITLY here. The checker refuses non-exhaustive
      ; matches as AX3005 (MM-VAL-9b, amended 2026-08-14), so this
      ; path is hygiene for the emission surfaces that skip the
      ; checker, not a semantics anyone reaches from a checked
      ; program.
      {
        (storeWordAt cg cell 0 "0")
        (emitLine cg (cat2 "  br label %" mergeB))
        cg
      }
      (let ((arm (vecGet arms i))
            (pat (nodeA arm))
            (body (nodeB arm))
            (nn (allocReg cg))
            (nextB (cat2 "label_" (fmtInt nn)))
            (mark (symMark cg)))
        ; The pattern compiles to a chain of tests that each branch to
        ; `nextB` on mismatch and fall through on success, binding as
        ; they go; the body is then emitted in whatever block the last
        ; test left current.
        (let ((cgP (emitPatMatch pat (strDup sv) nextB cg 0)))
          (let ((cgB (emitExpr body cgP))
                (_ff (if (== i 0) (memSetWord ff 0 (memGetWord cgB 14)) 0))
                (bv (strDup (memGetWord cgB 2)))
                (_d (storeWordAt cgB cell 0 bv))
                (_e (emitLine cgB (cat2 "  br label %" mergeB)))
                (_f (emitLabel cgB nextB))
                (_g (symRestore cgB mark)))
            (emitArms arms sv cell mergeB cgB (+ i 1) ff))))))

; ------------------------------------------------------------------
; Pattern compilation, recursive over the pattern's structure.
;
; `emitPatMatch` emits the tests for `pat` against the value held in
; `vr`: every failing comparison branches to `failB`, success falls
; through into a fresh block with the pattern's binders bound. Three
; shapes existed before this and two of them were wrong. A literal
; pattern was indistinguishable from a binder (`patHead` answered 0 for
; both), so `(1 body)` matched *everything*. And a nested constructor
; pattern collected only its binder names - `(Cons h (Cons h2 t))`
; walked the outer application, took `(Cons h2 t)` as if it were a
; name, and bound nothing inside it, so the emitted body referred to
; registers no instruction defines.
;
; `isFloat` is the binder flag when `pat` is a bare name: 0 at the top
; of an arm (the scrutinee's own float-ness is not tracked), the
; field's declared flag when descending into a constructor.
; ------------------------------------------------------------------
(pub :: emitPatMatch (-> Int String String Int Int Int))
(pub fn (emitPatMatch pat vr failB cg isFloat)
  (let ((tag (nodeTag pat)))
    (if (== tag TAG_E_INT)
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
    ; A char-literal pattern tests its codepoint word, exactly as an
    ; integer literal does - `(match c ('a' 7) (x 9))` is pinned by
    ; tests/selfhost/470-char-literals.ax, and an unknown tag here
    ; would silently match everything.
    (if (== tag TAG_E_CHAR)
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
    (if (== tag TAG_E_FLT)
        ; Bit-pattern equality, which is what stage0's literal float
        ; pattern also compiles to (one word against one word).
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
    (if (== tag TAG_E_STR)
        ; A string literal pattern compares CONTENTS, through the same
        ; `@__axiom_str_eq` that `==` on two Strings lowers to.
        ;
        ; It compared the interned literal's header ADDRESS until
        ; 2026-08-21, on the ground that literals of equal text share
        ; one global - true, and beside the point: a string built at
        ; run time is never that global. Measured (the QA sweep):
        ;
        ;   (let ((built (strConcat "hel" "lo")))
        ;     (== built "hello")                        -> 1
        ;     (match built (("hello") 1) (_ 0)))        -> 0
        ;
        ; so `==` and `match` disagreed on one value, and any dispatch
        ; on a string tag - a command table, a parser - silently took
        ; the wrong arm for every string that was not itself a
        ; literal. The checker makes the header read safe: a string
        ; literal pattern on a scrutinee known not to be a String is
        ; AX3004 (`checkPatternTyped`). tests/selfhost/996 pins the
        ; agreement of the two.
        (let ((cgS (emitStrExpr pat cg)))
          (emitPatStrTest (strDup (memGetWord cgS 2)) vr failB cgS))
    (if (== tag TAG_E_VAR)
        ; `true`/`false` are literal tests. Every OTHER bare name - a
        ; constructor's included - is a binder: stage0 parses a bare
        ; identifier in pattern position as a variable pattern, and
        ; only the parenthesised `(Nil)` (TAG_P_CON0 below) tests a
        ; tag. `_` is just a name nobody references.
        (if (strEq (nodeA pat) "true")
            (emitPatTest (constStr 1) vr failB cg)
        (if (strEq (nodeA pat) "false")
            (emitPatTest (constStr 0) vr failB cg)
            (bindSym cg (nodeA pat) (strDup vr) isFloat 0)))
    (if (== tag TAG_P_CON0)
        ; A nullary constructor of a type that unboxes (rep 1 or 2) IS
        ; its tag: compare the value directly. Correct even when the
        ; scrutinee is a boxed sibling - a heap pointer never equals a
        ; small immediate tag, so the arm just fails. Only a nullary
        ; constructor of a non-unboxing type is still a one-word block
        ; whose tag loads from word 0.
        (let ((entry (lookupType (memGetWord cg 3) (nodeA pat))))
          (if (== entry 0)
              (bindSym cg (nodeA pat) (strDup vr) isFloat 0)
              (if (!= (eRep entry) 0)
                  (emitPatTest (constStr (eTag entry)) vr failB cg)
                  (let ((cgL (loadWordAt cg vr 0)))
                    (emitPatTest (constStr (eTag entry))
                                 (strDup (memGetWord cgL 2))
                                 failB cgL)))))
    ; A NAMED constructor pattern is reordered into the positional
    ; spine and re-dispatched, so every mechanism below - the mixed-rep
    ; guard, the tag test, the word-i+1 field loads with their float
    ; flags - runs unchanged. A constructor with no recorded field
    ; names cannot be matched this way; the pattern binds nothing
    ; rather than binding by position, which would be a silent wrong
    ; answer.
    (if (== tag TAG_P_CONNAMED)
        (let ((ent (lookupType (memGetWord cg 3) (nodeA pat))))
          (if (|| (== ent 0) (== (eFieldNames ent) 0))
              cg
              (emitPatMatch (namedPatSpine (nodeA pat) (eFieldNames ent)
                                           (nodeB pat) (nodeC pat)
                                           (nodeSpan pat))
                            vr failB cg isFloat)))
    (if (== tag TAG_E_APP)
        (let ((cname (patHead pat)))
          (let ((entry (if (== cname 0) 0 (lookupType (memGetWord cg 3) (cast String cname)))))
            (if (== entry 0)
                ; An application whose head is no constructor - nothing
                ; well-typed produces this; match everything, bind
                ; nothing, as before.
                cg
                ; A fieldful pattern in a MIXED type must not load word
                ; 0 unguarded: the scrutinee may be an immediate
                ; nullary sibling, and word 0 of a small integer is a
                ; crash. `emitCondTagRead` tests `< 4096` first. In an
                ; all-boxed type the plain load stays.
                (let ((cgL (if (== (eRep entry) 2)
                               (emitCondTagRead vr cg)
                               (loadWordAt cg vr 0))))
                  (let ((cgT (emitPatTest (constStr (eTag entry))
                                          (strDup (memGetWord cgL 2))
                                          failB cgL)))
                    (emitPatFields (patArgs pat vecNew)
                                   (eFieldFlags entry)
                                   vr failB cgT 0))))))
    cg))))))))))

; The tag of a value whose type mixes representations, decided at
; runtime: below 4096 the value IS the tag (no immediate reaches the
; limit, every mmap-page heap address exceeds it), at or above it the
; tag is word 0. Globally-unique tags make the one read correct
; against any constructor's compare. The result travels through a
; one-word heap cell rather than a phi, the same idiom `match` uses
; for its own result.
(pub :: emitCondTagRead (-> String Int Int))
(pub fn (emitCondTagRead vr cg)
  (let ((cellN (allocReg cg))
        (cn (allocReg cg))
        (immN (allocReg cg))
        (boxN (allocReg cg))
        (mergeN (allocReg cg)))
    (let ((cell (regStr cellN))
          (cr (cat2 "%c" (fmtInt cn)))
          (immB (cat2 "label_" (fmtInt immN)))
          (boxB (cat2 "label_" (fmtInt boxN)))
          (mergeB (cat2 "label_" (fmtInt mergeN))))
      (let ((cg1 (emitLine cg (cat3 (cat2 "  " cell)
                                    " = ptrtoint ptr %__scr.h to i64"
                                    ""))))
        (let ((cg2 (emitLine cg1 (cat4 (cat2 "  " cr)
                                       " = icmp slt i64 "
                                       (strDup vr)
                                       ", 4096"))))
          (let ((cg3 (emitLine cg2 (cat4 (cat3 "  br i1 " cr ", label %")
                                         immB
                                         (cat2 ", label %" boxB)
                                         ""))))
            (let ((cg4 (emitLabel cg3 immB)))
              (let ((cg5 (storeWordAt cg4 cell 0 (strDup vr))))
                (let ((cg6 (emitLine cg5 (cat2 "  br label %" mergeB))))
                  (let ((cg7 (emitLabel cg6 boxB)))
                    (let ((cg8 (loadWordAt cg7 vr 0)))
                      (let ((cg9 (storeWordAt cg8 cell 0 (strDup (memGetWord cg8 2)))))
                        (let ((cg10 (emitLine cg9 (cat2 "  br label %" mergeB))))
                          (let ((cg11 (emitLabel cg10 mergeB)))
                            (loadWordAt cg11 cell 0)))))))))))))))

; One `icmp eq` against `want`, branching to `failB` on mismatch and
; into a fresh block on success.
(pub :: emitPatTest (-> String String String Int Int))
(pub fn (emitPatTest want vr failB cg)
  (let ((tn (allocReg cg))
        (cn (allocReg cg)))
    (let ((tr (regStr tn))
          (contB (cat2 "label_" (fmtInt cn))))
      {
        (emitLine cg (cat4 (cat2 "  " tr)
                           " = icmp eq i64 "
                           (strDup vr)
                           (cat2 ", " want)))
        (emitLine cg (cat4 (cat3 "  br i1 " tr ", label %")
                           contB
                           (cat2 ", label %" failB)
                           ""))
        (emitLabel cg contB)
        cg
      })))

; `emitPatTest`'s shape over string contents: one call into
; `@__axiom_str_eq`, which answers exactly 0 or 1, then the same
; branch. `want` is the literal's header register.
(pub :: emitPatStrTest (-> String String String Int Int))
(pub fn (emitPatStrTest want vr failB cg)
  (let ((r (regStr (allocReg cg))))
    (let ((cg1 (emitLine cg
                 (cat4 (cat2 "  " r)
                       " = call i64 @__axiom_str_eq(i64 "
                       (strDup vr)
                       (cat3 ", i64 " want ")")))))
      (emitPatTest (constStr 1) r failB cg1))))

; Load each field of the block in `vr` (fields start at word 1, past
; the tag) and recurse into the subpattern, carrying the field's
; declared float flag to whatever binder it bottoms out in.
(pub :: emitPatFields (-> Int Int String String Int Int Int))
(pub fn (emitPatFields subs flags vr failB cg i)
  (if (>= i (vecLen subs))
      cg
      (let ((cgL (loadWordAt cg vr (+ i 1))))
        (let ((fr (strDup (memGetWord cgL 2)))
              (fl (if (== flags 0)
                      0
                      (if (< i (vecLen flags)) (vecGet flags i) 0))))
          (emitPatFields subs flags vr failB
                         (emitPatMatch (vecGet subs i) fr failB cgL fl)
                         (+ i 1))))))

; Subpattern nodes of a constructor pattern, in field order -
; `(Cons h t)` yields the node for `h` then the node for `t`.
(pub :: patArgs (-> Int Int Int))
(pub fn (patArgs pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
      {
        (patArgs (nodeA pat) acc)
        (vecPush acc (nodeB pat))
        acc
      }
      acc))

; ------------------------------------------------------------------
; Expression dispatch.
; ------------------------------------------------------------------
; Event 2's retain lives HERE, on the leaf: a node `emitFnDef` listed
; in `tailRetain` - a borrowed value in tail position of a
; reference-returning function - is retained the moment its register
; exists. Per leaf rather than at `ret`, because a function owned on
; one branch and borrowed on another must retain the borrowed branch
; only; retaining the merged register leaked a share of the owned one
; on every call (`fmtInt`, measured: 16 MB over 200,000 calls).
(pub :: emitExpr (-> Int Int Int))
(pub fn (emitExpr node cg)
  (emitExprDispatch node cg))

; The retain itself, for a leaf `emitExprTail` has just emitted in
; tail position: listed in `tailRetain`, and not a block a jump has
; already terminated. Keyed on the POSITION as well as the node,
; because a macro substitutes one node for every occurrence of a
; parameter, and retaining every occurrence leaked a share per call.
(pub :: retainTailLeaf (-> Int Int Int))
(pub fn (retainTailLeaf node cg)
  (let ((tr (memGetWord cg 41)))
    (if (== (vecLen tr) 0)
        cg
        (if (== (memGetWord cg 31) 1)
            cg
            (if (== (nodeInVec tr node 0) 1)
                (let ((v (strDup (memGetWord cg 2)))
                      (fl (memGetWord cg 14)))
                  (let ((cgR (emitRetainOf cg v)))
                    { (memSetWord cgR 2 v) (memSetWord cgR 14 fl) cgR }))
                cg)))))

(pub :: nodeInVec (-> Int Int Int Int))
(pub fn (nodeInVec v node i)
  (if (>= i (vecLen v))
      0
      (if (== (cast Int (vecGet v i)) node)
          1
          (nodeInVec v node (+ i 1)))))

(pub :: emitExprDispatch (-> Int Int Int))
(pub fn (emitExprDispatch node cg)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_E_INT)   (emitInt node cg)
    ; A char literal is its codepoint word; emission is an integer's.
    (if (== tag TAG_E_CHAR)  (emitInt node cg)
    ; A cond that reached emission without passing the emitFnDef
    ; pre-pass - a macro template is the one road here - lowers on the
    ; fly to the same if-chain and re-dispatches.
    (if (== tag TAG_E_COND)  (emitExpr (lowerConds node) cg)
    (if (== tag TAG_E_FLT)   (emitFlt node cg)
    (if (== tag TAG_E_VAR)   (emitVar node cg)
    (if (== tag TAG_E_APP)   (emitApp node cg)
    (if (== tag TAG_E_LET)   (emitLet node cg)
    (if (== tag TAG_E_IF)    (emitIf node cg)
    (if (== tag TAG_E_BEGIN) (emitBegin node cg)
    (if (== tag TAG_E_STR)   (emitStrExpr node cg)
    (if (== tag TAG_E_MATCH) (emitMatch node cg)
    (if (== tag TAG_E_LETM)  (emitLetM node cg)
    (if (== tag TAG_E_SET)   (emitSet node cg)
    (if (== tag TAG_E_WHILE) (emitWhile node cg)
    (if (== tag TAG_E_FIELD) (emitField node cg)
    (if (== tag TAG_E_SETF)  (emitSetF node cg)
    (if (== tag TAG_E_LAM)   (emitLambda node cg)
    (if (== tag TAG_E_STRUCTCON) (emitStructConExpr node cg)
    (if (== tag TAG_E_HANDLE)
        (emitHandle node cg)
    ; `(alloc Type [count])` allocates nothing. stage0's IR generator
    ; has no EAlloc case, so the form falls to its catch-all constant
    ; 0; emitting a real allocation here would be stage1 doing more
    ; than the compiler it must agree with.
    (if (== tag TAG_E_ALLOC)
        {
          (memSetWord cg 2 (constStr 0))
          (memSetWord cg 14 0)
          cg
        }
    (emitDefault cg)))))))))))))))))))))))

; ------------------------------------------------------------------
; The effect system: dynamic handlers by evidence passing.
;
; `(handle body (E ...) h)` installs `h` as E's evidence for the
; body's dynamic extent, and an operation of E called anywhere inside
; that extent - however many frames down, and mentioning no handler
; itself - dispatches through it. The evidence is a heap-allocated
; two-word record `{handler, previous}`; the effect's slot, a mutable
; global, holds the innermost, and entry and exit are a push and a
; pop.
;
; Shallow and tail-resumptive: the handler's return value IS the
; operation's result, and there is no continuation to resume. That is
; the whole of what stage0 implements, and reproducing more of it here
; would be stage1 doing something the compiler it must agree with
; cannot.
; ------------------------------------------------------------------

; The first effect in a handle's list that resolves to a DECLARED
; effect, or 0 when none does. A list naming only built-in effects
; (`IO`, `Alloc`, ...) declares no evidence and installs nothing.
(pub :: handleEffectEnt (-> Int Int Int))
(pub fn (handleEffectEnt node cg)
  (handleEffectEntFrom (nodeB node) cg 0))

(pub :: handleEffectEntFrom (-> Int Int Int Int))
(pub fn (handleEffectEntFrom effs cg i)
  (if (>= i (vecLen effs))
      0
      (let ((e (lookupEffFor cg (memGetWord cg 32) (nodeA (vecGet effs i)))))
        (if (!= e 0)
            e
            (handleEffectEntFrom effs cg (+ i 1))))))

(pub :: emitHandle (-> Int Int Int))
(pub fn (emitHandle node cg)
  (let ((ent (handleEffectEnt node cg)))
    (if (== ent 0)
        ; A builtin-only list is a static effect scope, not a dynamic
        ; handler: it lowers to its body and the handler expression is
        ; never evaluated at all. stage0's rule, and the reason a
        ; `(handle e (IO) h)` costs nothing.
        (emitExpr (nodeA node) cg)
        ; Quoted once, here, rather than at the four `ptr @` sites
        ; below: `slot` reaches `emitHandleDyn` for emission only, and
        ; the unquoted spelling stays the registry's key.
        (emitHandleDyn node (llvmSym (effSlot ent)) cg))))

(pub :: emitHandleDyn (-> Int String Int Int))
(pub fn (emitHandleDyn node slot cg)
  ; The body is deliberately NOT emitted in tail position: the restore
  ; below has to run after it, and a self tail call rewritten to a
  ; jump would skip it and leave the handler installed forever.
  (let ((_0 (memSetWord cg 30 0)))
    (let ((cgH (emitExpr (nodeC node) cg)))
      (let ((hval (strDup (memGetWord cgH 2)))
            (recN (allocReg cgH))
            (oldN (allocReg cgH)))
        (let ((rec (regStr recN))
              (old (regStr oldN)))
          (let ((_1 (emitLine cgH (cat2 (cat2 "  " rec)
                                        " = call i64 @axiom_alloc(i64 16)")))
                ; MM-LIFE-2d, the evidence record's own map: two
                ; payload words and both of them references - word 0
                ; the handler value, word 1 the record this entry
                ; displaced. Spelled through the same helpers every
                ; other writer uses rather than as a constant,
                ; because the encoding is a rule and not a number.
                (_1a (storeShapeAt cgH rec
                       (+ (* (paddedWords 2) 2)
                          (+ (pow2 16) (pow2 17)))))
                ; A1: the evidence record births owned; event 7's
                ; release at the pop is what spends it
                (_1b (storeCountOneAt cgH rec))
                ; MM-LIFE-2c event 6, the half this record was
                ; missing: both words are stored OWNED. The handler
                ; is retained unless it was built right here - a
                ; directly-built lambda MOVES, its birth count IS the
                ; field's share - and the displaced record is
                ; retained because the slot refers to it again after
                ; the restore. Both shares come back at the pop, when
                ; the release below walks the map above; this is the
                ; balance the standing rule demands, that a retain
                ; must be one an existing map can return.
                (_1c (if (== (argIsDirectCon cgH (nodeC node)) 1)
                         cgH
                         (emitRetainOf cgH hval)))
                (_2 (storeWordAt cgH rec 0 hval))
                (_3 (emitLine cgH (cat4 (cat2 "  " old) " = load i64, ptr @" slot "")))
                (_3b (emitRetainOf cgH old))
                (_4 (storeWordAt cgH rec 1 old))
                (_5 (emitLine cgH (cat4 "  store i64 " rec ", ptr @" slot)))
                (_6 (memSetWord cgH 30 0)))
            (let ((cgB (emitExpr (nodeA node) cgH)))
              (let ((res (strDup (memGetWord cgB 2)))
                    (flag (memGetWord cgB 14)))
                {
                  {
                    (emitLine cgB (cat4 "  store i64 " old ", ptr @" slot))
                    ; MM-LIFE-2c event 7: the evidence record dies at
                    ; the pop, closing sixteen of MM-ALLOC-9a's
                    ; sixteen bytes per loop entry; the block files
                    ; and the next entry reuses it. Since the map
                    ; above it is no longer header-deep: the walk
                    ; hands back the handler's share and the
                    ; displaced record's, so a handler built AT the
                    ; handle - the common `(handle e (Eff) (lambda
                    ; ...))` - is reclaimed with its record instead
                    ; of accumulating one closure per entry.
                    (emitReleaseOf cgB (strDup rec))
                  }
                  (memSetWord cgB 2 res)
                  (memSetWord cgB 14 flag)
                  cgB
                }))))))))

; One effect-operation call.
;
; The handler runs under the evidence in scope at its INSTALLATION:
; the previous record is installed for the duration of the call and
; this one restored after, so an operation the handler itself performs
; dispatches OUTWARD to the next handler instead of re-entering the
; same one - which the naive lowering does forever. It is also what
; the static attribution already committed to, since a handler's own
; effects propagate past its own `handle`.
;
; No handler installed is a TRAP, not a zero: the operation has no
; result to produce, and continuing on a garbage one turns a missing
; handler into a wrong answer somewhere else entirely. Exit 71, which
; the allocators' out-of-memory 70 deliberately does not collide with.
;
; Arguments are evaluated BEFORE the slot is read, which is stage0's
; order and matters at exactly one observable point: an argument that
; prints must print even when the dispatch below traps.
(pub :: emitEffectOp (-> Int Int Int Int))
(pub fn (emitEffectOp ent args cg)
  ; Emission only, as in `emitHandle`: the registry is keyed on the
  ; unquoted name.
  (let ((slot (llvmSym (effSlot ent)))
        (regs vecNew))
    (let ((cgA (emitArgRegs args cg regs 0)))
      (let ((recN (allocReg cgA))
            (cmpN (allocReg cgA))
            (trapN (allocReg cgA))
            (goN (allocReg cgA)))
        (let ((rec (regStr recN))
              (cmpR (regStr cmpN))
              (trapB (cat2 "label_" (fmtInt trapN)))
              (goB (cat2 "label_" (fmtInt goN))))
          (let ((_1 (emitLine cgA (cat4 (cat2 "  " rec) " = load i64, ptr @" slot "")))
                (_2 (emitLine cgA (cat4 (cat2 "  " cmpR) " = icmp eq i64 " rec ", 0")))
                (_3 (emitLine cgA (cat4 (cat3 "  br i1 " cmpR ", label %")
                                        trapB
                                        (cat2 ", label %" goB)
                                        "")))
                (_4 (emitLabel cgA trapB))
                (_5 (emitLine cgA "  call i64 @__axiom_unhandled_effect()"))
                (_6 (emitLine cgA "  unreachable"))
                (_7 (emitLabel cgA goB)))
            (let ((cgL (loadWordAt cgA rec 0)))
              (let ((handler (strDup (memGetWord cgL 2))))
                (let ((cgP (loadWordAt cgL rec 1)))
                  (let ((prev (strDup (memGetWord cgP 2))))
                    (let ((_8 (emitLine cgP (cat4 "  store i64 " prev ", ptr @" slot))))
                      (let ((cgR (emitApplyRegs regs cgP handler 0)))
                        (let ((res (strDup (memGetWord cgR 2))))
                          {
                            (emitLine cgR (cat4 "  store i64 " rec ", ptr @" slot))
                            (memSetWord cgR 2 res)
                            (memSetWord cgR 14 0)
                            cgR
                          })))))))))))))

; Every argument evaluated, left to right, into its own register -
; collected before anything that consumes them is emitted.
(pub :: emitArgRegs (-> Int Int Int Int Int))
(pub fn (emitArgRegs args cg out i)
  (if (>= i (vecLen args))
      cg
      (let ((cgA (emitExpr (vecGet args i) cg)))
        {
          (vecPush out (strDup (memGetWord cgA 2)))
          (emitArgRegs args cgA out (+ i 1))
        })))

; `emitApplyChain` over registers that are already evaluated. One
; argument per indirect call, for the same reason: every function
; value absorbs exactly one, so a two-argument operation takes a
; curried handler chain and applying both at once would answer with
; the inner closure's address.
(pub :: emitApplyRegs (-> Int Int String Int Int))
(pub fn (emitApplyRegs regs cg rec i)
  (if (>= i (vecLen regs))
      {
        (memSetWord cg 2 rec)
        (memSetWord cg 14 0)
        cg
      }
      (let ((cgR (applyOneArg cg rec (vecGet regs i))))
        (emitApplyRegs regs cgR (strDup (memGetWord cgR 2)) (+ i 1)))))

; One mutable global per declared effect - the evidence slot, zero for
; "no handler installed" - and the trap an unhandled operation exits
; through. Emitted after every body, beside the string globals, since
; LLVM does not care about order.
;
; stage0 emits a slot only for an effect the program actually touches;
; this emits one per DECLARED effect. The difference is one internal,
; unreferenced global for an effect nothing performs or handles.
(pub :: emitEffectGlobals (-> Int Int Int))
(pub fn (emitEffectGlobals cg i)
  (let ((tbl (memGetWord cg 32)))
    (if (>= i (vecLen tbl))
        (if (== (vecLen tbl) 0) cg (emitUnhandledTrap cg))
        {
          ; One global per SLOT, not per registry entry: an imported
          ; effect is registered twice - bare, and under `Mod$name` so
          ; a reference inside its own module finds it - and both
          ; entries name the same slot. Emitting per entry produced two
          ; definitions of one global, which llc refuses outright.
          ; The dedup above compares the UNQUOTED slot, because that is
          ; the registry's key; only the definition emitted from it is
          ; quoted, and it has to agree with the loads and stores
          ; `emitHandle`/`emitEffectOp` quote the same way.
          (if (== (slotFirstIndex tbl (effSlot (vecGet tbl i)) 0) i)
              (emitLine cg (cat3 "@" (llvmSym (effSlot (vecGet tbl i)))
                                 " = internal global i64 0"))
              0)
          (emitEffectGlobals cg (+ i 1))
        })))

; The index of the first entry carrying `slot`, or -1. Two entries may
; share one slot; only the first of them emits its global.
(pub :: slotFirstIndex (-> Int String Int Int))
(pub fn (slotFirstIndex tbl slot i)
  (if (>= i (vecLen tbl))
      (- 0 1)
      (if (strEq (effSlot (vecGet tbl i)) slot)
          i
          (slotFirstIndex tbl slot (+ i 1)))))

(pub :: emitUnhandledTrap (-> Int Int))
(pub fn (emitUnhandledTrap cg)
  {
    (emitLine cg "")
    (emitLine cg "define internal i64 @__axiom_unhandled_effect() #0 {")
    (emitLine cg "entry:")
    (emitLine cg (strConcat
                   (cat4 "  call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetExitNum (memGetWord cg 26))))
                   ", i64 71, i64 0, i64 0, i64 0, i64 0, i64 0)"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; `(struct Name field...)` - the keyword construction form. It builds
; the identical block the application spelling `(Name field...)`
; builds, through the same emitConstructor, because stage0 lowers
; both to a heap block of `fields * 8` bytes with argument i at word
; i. A name with no registry entry cannot reach here on a checked
; program - it is AX3002 - but emission must not segfault on one, so
; an unknown name answers the constant 0, the same shape stage0's
; generator falls back to.
(pub :: emitStructConExpr (-> Int Int Int))
(pub fn (emitStructConExpr node cg)
  (let ((types (memGetWord cg 3))
        (args (nodeB node)))
    (let ((entry (lookupType types (nodeA node))))
      (if (== entry 0)
          {
            (memSetWord cg 2 (constStr 0))
            (memSetWord cg 14 0)
            cg
          }
          (zeroFloat (emitConstructor args entry 0 cg))))))

; `(set base.field v)`: the base evaluates once, the field resolves as
; a read does, and the value is stored at its offset. The whole form
; evaluates to 0 - stage0's rule, and NOT plain `set`'s, which answers
; the stored value.
; MM-LIFE-2c event 5, in full: a store into a REFERENCE field
; retains the new value and releases the one it overwrites. The order
; is load-old, evaluate-new, retain-new, store, release-old, and the
; retain-before-release half of it is what makes `(set e.f e.f)`
; survive rather than free what it just stored.
;
; This is the one event whose balance is LOCAL and provable without
; escape analysis: a mapped field's old value is owned by the block,
; because the store that put it there took a share - either
; `emitFieldStores` at construction or this function on a previous
; pass - so handing that share back here is arithmetic, not a
; judgement about who else might be holding it. The classification is
; `fldClass`'s, the same one that decided the block's map, so the
; release set and the walk set cannot disagree.
;
; A directly-built value MOVES, exactly as it does at construction: a
; retain would double-count its birth.
(pub :: emitSetF (-> Int Int Int))
(pub fn (emitSetF node cg)
  (let ((cgB (emitExpr (nodeA node) cg)))
    (let ((base (strDup (memGetWord cgB 2)))
          (fi (resolveStructField (memGetWord cgB 3) node)))
      (if (== fi 0)
          (dieCodegenDiag "unknown struct field: " (nodeB node))
          (let ((owns (== (fldClass cgB (nodeC fi)) 2)))
            (let ((cgL (if owns (loadWordAt cgB base (nodeA fi)) cgB)))
              (let ((old (if owns (strDup (memGetWord cgL 2)) "")))
                (let ((cgV (emitExpr (nodeC node) cgL)))
                  (let ((v (strDup (memGetWord cgV 2))))
                    (let ((cgR (if (&& owns (!= (argIsDirectCon cgV (nodeC node)) 1))
                                   (emitRetainOf cgV v)
                                   cgV)))
                      (let ((cgS (storeWordAt cgR base (nodeA fi) v)))
                        (let ((cgD (if owns (emitReleaseOf cgS old) cgS)))
                          ; and the temporary's own share, if the value
                          ; was an owned temporary that the retain above
                          ; (not a MOVE) has just copied into the field
                          (let ((cgT (if (&& owns
                                             (&& (!= (argIsDirectCon cgD (nodeC node)) 1)
                                                 (== (valueOwnedRef cgD (nodeC node)) 1)))
                                         (emitReleaseOf cgD v)
                                         cgD)))
                          {
                            (memSetWord cgT 2 (constStr 0))
                            (memSetWord cgT 14 0)
                            cgT
                          })))))))))))))

; `base.field`: the field resolves through the struct the CHECKER
; stamped on the node (`resolveStructField`), and a struct carries no
; tag word, so field i is word i.
;
; It resolved by name across the whole struct registry until
; 2026-08-21 - first declaring struct wins, "the same simplification
; stage0 makes for float-ness" - and that simplification cost type
; safety rather than precision: two structs sharing a field name at
; different offsets read and wrote each other's slots, `check` said
; OK, and the QA sweep's four-line repro died of SIGSEGV
; (typecheck.ax's `checkField` carries the measurement). The
; receiver's static type is the checker's to know, so the checker
; decides and this reads its answer.
(pub :: emitField (-> Int Int Int))
(pub fn (emitField node cg)
  (let ((cgB (emitExpr (nodeA node) cg)))
    (let ((base (strDup (memGetWord cgB 2)))
          (fi (resolveStructField (memGetWord cgB 3) node)))
      (if (== fi 0)
          ; Not a struct field: it may be a DATA constructor's named
          ; field. Those live PAST THE TAG WORD, so the offset is
          ; index + 1 where a struct's is index - a struct carries no
          ; tag. stage0 searches every data type, first match winning.
          (let ((di (findDataField (memGetWord cgB 3) (nodeB node))))
            (if (== di 0)
                (dieCodegenDiag "unknown struct field: " (nodeB node))
                (let ((cgL (loadWordAt cgB base (+ (nodeA di) 1))))
                  {
                    (memSetWord cgL 14 (nodeB di))
                    cgL
                  })))
          (let ((cgL (loadWordAt cgB base (nodeA fi))))
            {
              (memSetWord cgL 14 (nodeB fi))
              cgL
            })))))

; A data constructor's named field as an inert (index, floatFlag)
; node, or 0. Searched in registry order, first match winning.
(pub :: findDataField (-> Int String Int))
(pub fn (findDataField types fname) (findDataFieldFrom types fname 0))

(pub :: findDataFieldFrom (-> Int String Int Int))
(pub fn (findDataFieldFrom types fname i)
  (if (>= i (vecLen types))
      0
      (let ((e (vecGet types i)))
        (if (|| (!= (eKind e) TF_DATA) (== (eFieldNames e) 0))
            (findDataFieldFrom types fname (+ i 1))
            (let ((j (dataFieldIndexIn (eFieldNames e) fname 0)))
              (if (< j 0)
                  (findDataFieldFrom types fname (+ i 1))
                  (mkNode TAG_FIELD j
                          (if (< j (vecLen (eFieldFlags e)))
                              (vecGet (eFieldFlags e) j) 0)
                          0)))))))

(pub :: dataFieldIndexIn (-> Int String Int Int))
(pub fn (dataFieldIndexIn names fname i)
  (if (>= i (vecLen names))
      (- 0 1)
      (if (strEq (vecGet names i) fname) i
          (dataFieldIndexIn names fname (+ i 1)))))

; The field of a TAG_E_FIELD / TAG_E_SETF node, as the inert
; (index, floatFlag, type) node `findStructFieldIn` builds, or 0.
;
; Word 6 of the node is the struct the checker resolved the field
; through - `stampFieldStruct`, keyed exactly as `lookupType` is - and
; when it is there the field is looked up IN THAT STRUCT and nowhere
; else. The program-wide scan below is reached only for a node the
; checker did not stamp: a base whose type it could not know (the
; silent wildcard - a macro head, an unparseable type), or a field
; that resolved as a DATA constructor's named field rather than a
; struct's, which `emitField` goes on to try next. A stamped struct
; that the table cannot find, or that lacks the field, answers 0
; rather than falling back: both are checker/emitter disagreements,
; and a wrong slot is the failure this exists to refuse.
(pub :: resolveStructField (-> Int Int Int))
(pub fn (resolveStructField types node)
  (if (== (nodeTy node) 0)
      (findStructField types (nodeB node))
      (let ((key (cast String (nodeTy node))))
        ; The empty stamp: the checker resolved the field as a DATA
        ; constructor's named field, and `emitField` must go straight
        ; to `findDataField` - the struct scan it used to try first
        ; answered an unrelated struct's slot of the same name, which
        ; for `(data Shape () (Rect { name : String ... }))` beside
        ; `(struct P (w : Int) (tag : Int) (name : String))` read
        ; `r.name` at word 2 and died of SIGSEGV
        (if (== (strLen key) 0)
            0
            (let ((e (lookupType types key)))
              (if (== e 0)
                  0
                  (if (!= (eKind e) TF_STRUCT)
                      0
                      (structFieldOf e (nodeB node)))))))))

; The named field of ONE struct entry, as `findStructFieldIn` shapes
; it, or 0 when the struct does not declare the name.
(pub :: structFieldOf (-> Int String Int))
(pub fn (structFieldOf e name)
  (let ((idx (fieldIndexIn (eFieldFlags e) name 0)))
    (if (< idx 0)
        0
        (mkNode TAG_NIL idx
                (nodeB (vecGet (eFieldFlags e) idx))
                (nodeTy (vecGet (eFieldFlags e) idx))))))

; The field's (index, floatFlag) as an inert node, 0 when no struct
; declares the name.
(pub :: findStructField (-> Int String Int))
(pub fn (findStructField types name)
  (findStructFieldIn types name 0))

(pub :: findStructFieldIn (-> Int String Int Int))
(pub fn (findStructFieldIn types name i)
  (if (>= i (vecLen types))
      0
      (let ((e (vecGet types i)))
        (if (== (eKind e) TF_STRUCT)
            ; Word 3 of the answer is the field's declared TYPE node,
            ; which `emitSetF` classifies to decide whether the store
            ; is an ownership transfer (MM-LIFE-2c event 5). The read
            ; side ignores it, as it always has.
            (let ((fi (structFieldOf e name)))
              (if (== fi 0)
                  (findStructFieldIn types name (+ i 1))
                  fi))
            (findStructFieldIn types name (+ i 1))))))

(pub :: fieldIndexIn (-> Int String Int Int))
(pub fn (fieldIndexIn fields name i)
  (if (>= i (vecLen fields))
      (- 0 1)
      (if (strEq (nodeA (vecGet fields i)) name)
          i
          (fieldIndexIn fields name (+ i 1)))))

; E_Int
(pub :: emitInt (-> Int Int Int))
(pub fn (emitInt node cg)
  (let ((v (nodeA node)))
    {
      (memSetWord cg 2 (constStr v))
      (memSetWord cg 14 0)
      cg
    }))

; E_Flt: the node already holds the IEEE-754 bits, and the bits *are*
; the value, so a float literal is the same immediate an integer is -
; only the flag differs, and the flag is what routes `(+ x 1.5)` to
; `fadd`.
(pub :: emitFlt (-> Int Int Int))
(pub fn (emitFlt node cg)
  (let ((bits (nodeA node)))
    {
      (memSetWord cg 2 (constStr bits))
      (memSetWord cg 14 1)
      cg
    }))

; E_Var: emit register reference (%name) or nullary constructor tag constant.
; Checks symbol table first (let-bound variables), then type registry (constructors).
(pub :: emitVar (-> Int Int Int))
(pub fn (emitVar node cg)
  (let ((name (nodeA node)))
    ; A macro used to be expanded HERE, ahead of the symbol table, so a
    ; macro name outranked every binder in the program: `(macro (v) 9)`
    ; made a parameter named `v` evaluate to 9. Expansion now happens in
    ; `self_host/expand.ax`, before the checker, and that pass knows
    ; which names are bound - so by the time emission runs there is no
    ; macro left to expand and a local is a local.
    ; A zero-argument primitive is spelled `(__argc)`, which is a bare
    ; variable reference by the time it gets here. Without this it fell
    ; through to the undefined-name emission `%__argc`.
    ;
    ; `__axiom_arena_mark` is the other one, and it was NOT handled -
    ; the comment here named it while the code did not, so
    ; `tests/stdlib/160-arena.ax` emitted `%__axiom_arena_mark`, a
    ; value nothing defines, and llc rejected the module. stage0
    ; carries a comment about hitting exactly this, for exactly this
    ; primitive, and calls it "the only one that could go wrong".
    ; Both are nullary and neither is polymorphic, so the stamp a
    ; bare reference cannot carry is the constant 0 here.
    (if (|| (strEq name "__argc") (strEq name "__axiom_arena_mark"))
        (zeroFloat (emitPrim name vecNew cg 0))
    ; Same rule as `checkVar`: a reference a macro template produced
    ; is resolved at the scope the template was written in, and the
    ; two resolvers have to agree or the checker types one binding
    ; while the emitter reads another.
    (let ((symReg (if (== (nodeDefScope node) 1) 0 (lookupSym cg name))))
      (if (!= symReg 0)
          (if (>= (lookupSymKind cg name) 1)
              ; A mutable binding: the register is its storage, and the
              ; value is a fresh load - which is what makes a `set` in
              ; a loop body visible on the next trip's read.
              (let ((rn (allocReg cg)))
                (let ((r (regStr rn)))
                  {
                    (emitLine cg (cat4 (cat2 "  " r)
                                       " = load i64, ptr "
                                       (strDup (cast String symReg))
                                       ""))
                    (memSetWord cg 2 r)
                    (memSetWord cg 14 (lookupSymFloat cg name))
                    cg
                  }))
              {
                (memSetWord cg 2 (strDup (cast String symReg)))
                (memSetWord cg 14 (lookupSymFloat cg name))
                cg
              })
          (if (strEq name "true")
              {
                (memSetWord cg 2 (constStr 1))
                (memSetWord cg 14 0)
                cg
              }
          (if (strEq name "false")
              {
                (memSetWord cg 2 (constStr 0))
                (memSetWord cg 14 0)
                cg
              }
          ; The constructor table is consulted before the nullary
          ; function table: stage0's EVar lowering tries
          ; find_constructor first, so a name that is both - a nullary
          ; constructor and a nullary function - yields the constructor
          ; value, and parity means agreeing on that order.
          (let ((entry (lookupType (memGetWord cg 3) name)))
            (if (!= entry 0)
                (if (== (eArity entry) 0)
                    ; A bare nullary constructor: an immediate tag for
                    ; an all-nullary type, a fresh one-word block
                    ; otherwise - the same split construction makes.
                    (zeroFloat (emitConstructor vecNew entry 0 cg))
                    (let ((z 0))
                      {
                        (memSetWord cg 2 (constStr z))
                        (memSetWord cg 14 0)
                        cg
                      }))
                ; A nullary function referenced bare is a call, not a
                ; register. Emitting `%answer` names a value nothing
                ; defines. The decl list carries mangled names, so the
                ; reference is resolved through the map before it is
                ; compared or emitted.
                (let ((full (mangledFor cg name)))
                  (if (isNullaryFn (memGetWord cg 8) full)
                      (let ((rn (allocReg cg)))
                        (let ((r (regStr rn)))
                          {
                            (emitLine cg (cat4 (cat2 "  " r)
                                               " = call i64 @"
                                               (llvmSym (strDup full))
                                               "()"))
                            (memSetWord cg 2 r)
                            (memSetWord cg 14 (fnRetIsFloat cg full))
                            cg
                          }))
                      ; A bare reference to a *defined multi-parameter
                      ; function* is a function value: a one-word
                      ; closure record holding a code pointer.
                      ; `emitIndirectCall` passes the record as the
                      ; callee's hidden first argument, so the record
                      ; points at a forwarding thunk rather than at
                      ; the function itself - see the lambda section.
                      ; A parameter of the function being emitted wins
                      ; first, though: a param named `lex` is the
                      ; param, not the lexer entry point it shadows.
                      (if (&& (isDefinedFn (memGetWord cg 8) full)
                              (< (paramIndexOf cg name) 0))
                          (let ((ti (thunkIndexFor cg full
                                      (fnArityOf (memGetWord cg 8) full)))
                                (pn (allocReg cg))
                                (fn2 (allocReg cg)))
                            (let ((pr (regStr pn))
                                  (fr (cat2 "%f" (fmtInt fn2))))
                              {
                                (emitLine cg (cat2 (cat2 "  " pr)
                                                   " = call i64 @axiom_alloc(i64 8)"))
                                (emitLine cg (cat4 (cat2 "  " fr)
                                                   " = ptrtoint ptr @_thunk_"
                                                   (fmtInt ti)
                                                   " to i64"))
                                (storeWordAt cg pr 0 fr)
                                ; born at 1, as a lambda is (A1): the
                                ; frame that built it holds it, and a
                                ; record it is stored into takes its own
                                ; share. Born at 0 the store ADOPTED it,
                                ; and the record's death freed the
                                ; value under the frame still calling it
                                (storeCountOneAt cg pr)
                                (memSetWord cg 2 pr)
                                (memSetWord cg 14 0)
                                cg
                              }))
                      ; A parameter reference: `%name` was emitted in
                      ; the function header, and the signature says
                      ; whether it is a float.
                      (let ((x (cat2 "%" (llvmSym (strDup name)))))
                        {
                          (memSetWord cg 2 x)
                          (memSetWord cg 14 (paramFloatByName cg name))
                          cg
                        })))))))))))))

; Index of `name` in the current function's parameter list, -1 when it
; is no parameter.
(pub :: paramIndexOf (-> Int String Int))
(pub fn (paramIndexOf cg name)
  (let ((params (memGetWord cg 17)))
    (if (== params 0)
        (- 0 1)
        (paramIndexIn params name 0))))

(pub :: paramIndexIn (-> Int String Int Int))
(pub fn (paramIndexIn params name i)
  (if (>= i (vecLen params))
      (- 0 1)
      (if (strEq (vecGet params i) name)
          i
          (paramIndexIn params name (+ i 1)))))

(pub :: isDefinedFn (-> Int String Bool))
(pub fn (isDefinedFn decls name)
  (if (== decls 0)
      false
      (isDefinedFnIn decls (declSpellingOf name) 0)))

(pub :: isDefinedFnIn (-> Int String Int Bool))
(pub fn (isDefinedFnIn decls name i)
  (if (>= i (vecLen decls))
      false
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN)
                (&& (strEq (nodeA d) name) (> (vecLen (nodeB d)) 0)))
            true
            (isDefinedFnIn decls name (+ i 1))))))

(pub :: lookupSymKind (-> Int String Int))
(pub fn (lookupSymKind cg name)
  (lookupSymFloatIn (memGetWord cg 6) (memGetWord cg 20) name
                    (- (vecLen (memGetWord cg 6)) 1)))

(pub :: lookupSymFloat (-> Int String Int))
(pub fn (lookupSymFloat cg name)
  (lookupSymFloatIn (memGetWord cg 6) (memGetWord cg 16) name
                    (- (vecLen (memGetWord cg 6)) 1)))

(pub :: lookupSymFloatIn (-> Int Int String Int Int))
(pub fn (lookupSymFloatIn syms flags name i)
  (if (< i 0)
      0
      (if (strEq (vecGet syms i) name)
          (if (< i (vecLen flags)) (vecGet flags i) 0)
          (lookupSymFloatIn syms flags name (- i 1)))))

(pub :: lookupSym (-> Int String Int))
(pub fn (lookupSym cg name)
  (let ((syms (memGetWord cg 6))
        (regs (memGetWord cg 7)))
    (lookupSymIn syms regs name (- (vecLen syms) 1))))

(pub :: lookupSymIn (-> Int Int String Int Int))
(pub fn (lookupSymIn syms regs name i)
  (if (< i 0)
      0
      (if (strEq (vecGet syms i) name)
          (vecGet regs i)
          (lookupSymIn syms regs name (- i 1)))))

; ------------------------------------------------------------------
; E_App: flatten chain, dispatch.
; ------------------------------------------------------------------
(pub :: emitApp (-> Int Int Int))
(pub fn (emitApp node cg)
  {
    (memSetWord cg 5 vecNew)
    (walkAppChain node cg)
  })

(pub :: walkAppChain (-> Int Int Int))
(pub fn (walkAppChain node cg)
  (let ((fnNode (nodeA node))
        (argNode (nodeB node)))
    {
      (vecPush (memGetWord cg 5) argNode)
    }
    (if (== (nodeTag fnNode) TAG_E_VAR)
        ; the stamp is snapshotted HERE, validated against the
        ; declaration being emitted, and threaded as a parameter - a
        ; CG-stash read later would be clobbered by any nested
        ; polymorphic call in an argument (MM-LIFE-2d)
        (dispatchCall (nodeA fnNode)
                      (evStampOk cg (memGetWord fnNode 6)) cg
                      (nodeDefScope fnNode))
    (if (== (nodeTag fnNode) TAG_E_APP)
        (walkAppChain fnNode cg)
        ; A head that is neither a name nor another application - a
        ; lambda, an `if`, a `match`, a block. This branch used to
        ; write the constant 0 and return, which does not emit a
        ; wrong call: it DELETES the application, so
        ; `((lambda (x) x) 7)` evaluated to 0
        ; (tests/stdlib/280-function-application.ax). stage0 reached
        ; the same shape once from the other side, lowering a non-name
        ; head to a call to the undefined symbol `@unknown`.
        ;
        ; The rule both compilers settled on is that a non-name head
        ; is EVALUATED AS A VALUE and then applied one argument at a
        ; time, since each application may yield another closure. The
        ; arguments are snapshotted and reversed BEFORE the head is
        ; lowered, because lowering it re-enters `emitApp` and would
        ; otherwise overwrite the accumulator they live in; and the
        ; tail flag is cleared, because a call through a computed head
        ; is never the self tail call the optimiser rewrites.
        (let ((args (reverseVec (memGetWord cg 5))))
          {
            (memSetWord cg 30 0)
            (let ((cgH (emitExpr fnNode cg)))
              (emitApplyChain args cgH (strDup (memGetWord cgH 2)) 0))
          })))))

; Dispatch after flattening.
; `defscope` is the head node's word 10: 1 when this reference came
; out of a macro template and therefore resolves where the template
; was written - top level - rather than in the scope the call landed
; in. It has to reach `isLocalValue`, because the head of a call is
; the one reference that never passes through `emitVar`, and the two
; resolvers disagreeing is a checker typing one binding while the
; emitter reads another.
(pub :: dispatchCall (-> String Int Int Int Int))
(pub fn (dispatchCall fnName stamp cg defscope)
  (let ((revArgs (memGetWord cg 5))
        (args (reverseVec revArgs))
        ; Read and clear in one step: tail position belongs to this
        ; call alone, and the arguments emitted below must not inherit
        ; it - a self call in argument position is an ordinary call.
        (isTail (memGetWord cg 30))
        (_clr (memSetWord cg 30 0)))
    (
    ; The macro branch that used to lead here is gone with the rest of
    ; the emit-time expander; see `self_host/expand.ax`.
    ; cast is a no-op at the i64 level — just evaluate and return the
    ; cast expression's value directly, avoiding an undefined @cast call.
    ; It *does* change float-ness: `(cast Float bits)` is how a bit
    ; pattern held as an Int re-enters float arithmetic, so the flag
    ; follows the named type rather than the operand.
    ;
    ; `cast` takes TWO arguments and any beyond them are applied to its
    ; RESULT, which is the whole point of casting a closure to `Int`:
    ; `((cast Int f) 41)` is one application spine, and `walkAppChain`
    ; flattens a spine into one accumulator before dispatching on its
    ; head, so this branch is handed `[Int, f, 41]` rather than
    ; `[Int, f]`. It used to take the LAST argument, which is the right
    ; answer only when there is no surplus: `((cast Int f) 41)` emitted
    ; `41` and returned it, `check`-clean, at exit 0, for a
    ; one-parameter `f`. Every other head in this dispatch consumes a
    ; fixed count too, and this is the one whose result is routinely a
    ; function value.
    (if (isCastName fnName)
        (let ((n (vecLen args)))
          (let ((valIdx (if (>= n 2) 1 (- n 1))))
            (let ((cgc (emitExpr (vecGet args valIdx) cg)))
              {
                (memSetWord cgc 14
                  (if (>= n 2)
                      (let ((tyNode (vecGet args 0)))
                        (if (&& (== (nodeTag tyNode) TAG_E_VAR)
                                (strEq (nodeA tyNode) "Float"))
                            1
                            0))
                      0))
                (if (> n 2)
                    ; `emitApplyChain` already takes a start index, so
                    ; the surplus applies one argument at a time from
                    ; position 2 - each application may yield another
                    ; closure, which is exactly the curried case.
                    (emitApplyChain args cgc (strDup (memGetWord cgc 2)) 2)
                    cgc)
              })))
    ; `sizeof`/`alignof` are compile-time constants: every Axiom value
    ; is one machine word, so both are 8 for every type - probed
    ; against stage0, which answers 8 for `Int` and for a three-field
    ; struct alike (the handle is the value).
    (if (strEq fnName "sizeof")
        {
          (memSetWord cg 2 (constStr 8))
          (memSetWord cg 14 0)
          cg
        }
    (if (strEq fnName "alignof")
        {
          (memSetWord cg 2 (constStr 8))
          (memSetWord cg 14 0)
          cg
        }
    ; Primitives have no definition to call: they *are* the instruction.
    ; Emitting `call @__load64` produces a symbol nothing defines, which
    ; fails at link time rather than as a diagnostic.
    (if (isAndOr fnName)
        (zeroFloat (emitAndOr fnName args cg))
    (if (isPrimName fnName)
        (emitPrim fnName args cg stamp)
    ; A head that names a local or a parameter is a function VALUE -
    ; a closure record - so the call goes indirect through its code
    ; pointer. Checked before the constructor table: locals shadow.
    (if (&& (!= defscope 1) (isLocalValue cg fnName))
        (emitIndirectCall fnName args cg)
    ; An effect operation is dispatch, not a call: there is no symbol
    ; to reach, only the handler the innermost `handle` installed.
    ; Checked AFTER the local test, because a local shadowing an
    ; operation name binds the local - which is how sema resolves it,
    ; and a generator that disagreed would dispatch a name the checker
    ; had already bound to a lambda.
    (if (!= (lookupEffFor cg (memGetWord cg 33) fnName) 0)
        (emitEffectOp (lookupEffFor cg (memGetWord cg 33) fnName) args cg)
        (let ((types (memGetWord cg 3))
              (entry (lookupType types fnName)))
          (if (== entry 0)
              ; The self tail call is recognised HERE, not on the way
              ; in: a macro, a local, a lambda parameter or a match
              ; binder that shadows the function's name has already
              ; claimed the call above, and rewriting it as a jump to
              ; the function would be an infinite loop where the
              ; correct answer is a value.
              (if (&& (== isTail 1)
                      (&& (!= (memGetWord cg 27) 0)
                          (&& (strEq fnName (memGetWord cg 27))
                              (== (vecLen args) (vecLen (memGetWord cg 28))))))
                  (emitTailJump args stamp cg)
                  (emitOverApplied fnName args stamp cg))
              (zeroFloat (emitConstructor args entry stamp cg))))))))))))))

(pub :: isLocalValue (-> Int String Bool))
(pub fn (isLocalValue cg name)
  (if (!= (lookupSym cg name) 0)
      true
      (>= (paramIndexOf cg name) 0)))

; Call through a function value: one argument per call. The head
; evaluates to a closure record; each step loads word 0 of the current
; record as the code pointer and calls it with (record, argument), and
; the result is the record for the next step - a lifted lambda reads
; its captures from the record, a forwarding thunk ignores it. One at
; a time rather than all at once, because every function value that
; can legally exist absorbs exactly one argument - a 1-parameter
; function's thunk record, or one link of a curried lambda chain - so
; a flat spine `(h 3 4)` over a curried `h` means "apply, then apply
; the result"; passing both in one call answered with the inner
; closure's address, the same bug stage0's local-head path had. The
; result's float-ness is unknown (no signature to ask), so it reads
; as integer.
(pub :: emitIndirectCall (-> String Int Int Int))
(pub fn (emitIndirectCall fnName args cg)
  (let ((cgH (emitVar (mkEVar fnName) cg)))
    (emitApplyChain args cgH (strDup (memGetWord cgH 2)) 0)))

(pub :: emitApplyChain (-> Int Int String Int Int))
(pub fn (emitApplyChain args cg rec i)
  (if (>= i (vecLen args))
      {
        (memSetWord cg 2 rec)
        (memSetWord cg 14 0)
        cg
      }
      (let ((cgA (emitExpr (vecGet args i) cg)))
        (let ((a (strDup (memGetWord cgA 2))))
          (let ((cgR (applyOneArg cgA rec a)))
            (emitApplyChain args cgR (strDup (memGetWord cgR 2)) (+ i 1)))))))

; One step of an application through a closure record: load word 0 as
; the code pointer and call it with (record, argument). The result is
; the record for the next step, and lands in field 2.
;
; Shared by the two chain walkers, which differ only in WHEN the
; argument is evaluated - `emitApplyChain` evaluates each one just
; before applying it, `emitApplyRegs` takes registers already
; evaluated, which is what an effect operation needs so that an
; argument's side effects happen before a missing handler traps.
(pub :: applyOneArg (-> Int String String Int))
(pub fn (applyOneArg cg rec a)
  (let ((cgL (loadWordAt cg rec 0)))
    (let ((cp (strDup (memGetWord cgL 2)))
          (fpn (allocReg cgL))
          (rn (allocReg cgL)))
      (let ((fp (cat2 "%f" (fmtInt fpn)))
            (r (regStr rn)))
        {
          (emitLine cgL (cat4 (cat2 "  " fp)
                              " = inttoptr i64 "
                              cp
                              " to ptr"))
          (emitLine cgL (strConcat
                          (cat4 (cat3 (cat2 "  " r)
                                      " = call i64 "
                                      fp)
                                "(i64 "
                                (strDup rec)
                                (cat2 ", i64 " a))
                          ")"))
          (memSetWord cgL 2 r)
          cgL
        }))))

; ------------------------------------------------------------------
; Freestanding primitives.
; ------------------------------------------------------------------
(pub :: isPrimName (-> String Bool))
(pub fn (isPrimName nm)
  (if (strEq nm "__alloc") true
  (if (strEq nm "__retain") true
  (if (strEq nm "__retainref") true
  (if (strEq nm "__release") true
  (if (strEq nm "__load64") true
  (if (strEq nm "__store64") true
  (if (strEq nm "__load8") true
  (if (strEq nm "__store8") true
  (if (strEq nm "__addr") true
  (if (strEq nm "__intToFloat") true
  (if (strEq nm "__floatToInt") true
  (if (strEq nm "__argc") true
  (if (strEq nm "__argv") true
  ; The arena watermark pair. Their absence here was not a missing
  ; feature but a miscompile: `(__axiom_arena_mark)` is a bare
  ; reference, so it fell through to the ordinary variable path and
  ; emitted `%__axiom_arena_mark`, a value nothing defines, which llc
  ; rejects. stage0 carries a comment about hitting the identical bug.
  (if (strEq nm "__axiom_arena_mark") true
  (if (strEq nm "__axiom_arena_reset") true
  (if (strEq nm "__axiom_arena_reset_keeping") true
  ; Not spellable in source: `checkNumeric` rewrites `==`/`!=` into
  ; these when it can see that BOTH operands are `String`. They are
  ; primitives rather than a `Str` call because the rewrite must work
  ; in a program that never imported `Str`.
  (if (strEq nm "__streq") true
  (if (strEq nm "__strne") true
  (if (strEq nm "__call_word") true
  (if (isSyscallName nm) true
  false)))))))))))))))))))))

; `__syscall0` through `__syscall6`, distinguished only by how many
; arguments follow the syscall number.
(pub :: isSyscallName (-> String Bool))
(pub fn (isSyscallName nm)
  (&& (== (strLen nm) 10)
      (strStartsWith nm "__syscall")))

(pub :: emitPrim (-> String Int Int Int Int))
(pub fn (emitPrim fnName args cg stamp)
  (if (strEq fnName "__intToFloat") (emitPrimIntToFloat args cg)
  (if (strEq fnName "__floatToInt") (emitPrimFloatToInt args cg)
  (zeroFloat
    (if (strEq fnName "__alloc")   (emitPrimAlloc args cg)
    (if (strEq fnName "__retain")  (emitPrimRetRel args cg "@axiom_retain")
    (if (strEq fnName "__retainref") (emitPrimRetainRef args cg stamp)
    (if (strEq fnName "__release") (emitPrimRetRel args cg "@axiom_release")
    (if (strEq fnName "__load64")  (emitPrimLoad args cg 8)
    (if (strEq fnName "__store64") (emitPrimStore args cg 8)
    (if (strEq fnName "__load8")   (emitPrimLoad args cg 1)
    (if (strEq fnName "__store8")  (emitPrimStore args cg 1)
    (if (strEq fnName "__addr")    (emitPrimAddr args cg)
    (if (strEq fnName "__argc")    (emitPrimArgc cg)
    (if (strEq fnName "__argv")    (emitPrimArgv args cg)
    (if (strEq fnName "__axiom_arena_mark")  (emitPrimArenaMark cg)
    (if (strEq fnName "__axiom_arena_reset") (emitPrimArenaReset args cg)
    (if (strEq fnName "__axiom_arena_reset_keeping") (emitPrimArenaResetKeeping args cg)
    (if (strEq fnName "__streq") (emitPrimStrEq args cg 1)
    (if (strEq fnName "__strne") (emitPrimStrEq args cg 0)
    (if (strEq fnName "__call_word") (emitPrimCallWord args cg)
    (emitPrimSyscall args cg))))))))))))))))))))))

; `(__call_word fn arg)`: `fn` is the ADDRESS of a C function
; `i64 (i64)` - a Rust destructor shim `axffi_<type>_drop` - and the
; call is an indirect `call i64 %fp(i64 %arg)`. Axiom has no other
; way to reach a function it holds only as a word, and the foreign
; form's own release path (`@axiom_release`) makes exactly this call.
(pub :: emitPrimCallWord (-> Int Int Int))
(pub fn (emitPrimCallWord args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((fnv (strDup (memGetWord cg1 2))))
      (let ((cg2 (emitExpr (vecGet args 1) cg1)))
        (let ((av (strDup (memGetWord cg2 2)))
              (pn (allocReg cg2))
              (rn (allocReg cg2)))
          (let ((pr (regStr pn))
                (rr (regStr rn)))
            {
              (emitLine cg2 (cat4 (cat2 "  " pr) " = inttoptr i64 " fnv " to ptr"))
              (emitLine cg2 (cat4 (cat3 (cat2 "  " rr) " = call i64 " pr) "(i64 " av ")"))
              (memSetWord cg2 2 rr)
              (memSetWord cg2 14 0)
              cg2
            }))))))

; `(__retain h)` / `(__release h)`: one call into the emitted
; ownership primitive of MM-LIFE-2b. The result is 0 - retain and
; release are effects on the header, not values - and in this slice
; the ONLY callers are fixtures: the compiler does not insert
; ownership events until MM-LIFE-2c.
(pub :: emitPrimRetRel (-> Int Int String Int))
(pub fn (emitPrimRetRel args cg sym)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((h (strDup (memGetWord cg1 2))))
      {
        (emitLine cg1 (cat4 "  call void " sym "(i64 " (cat2 h ")")))
        (memSetWord cg1 2 "0")
        (memSetWord cg1 14 0)
        cg1
      })))

; `(__retainref v)`: a share of `v`, taken exactly when `v` is a
; reference. The answer comes from the CALL's evidence stamp, whose
; single witness covers `__retainref`'s single type variable:
;
;   0     `v` is not a reference here - NOTHING is emitted, which is
;         why this is affordable on `memSetWord`, whose arguments are
;         overwhelmingly integers
;   1     `v` is a reference at this call site - an unconditional
;         retain
;   2+k   `v` is the caller's own type variable k - the retain runs
;         under bit k of the caller's evidence word, at run time
;
; A missing or foreign stamp answers 0, which under-retains: the same
; conservative direction `evStampOk` takes everywhere else, and the
; one that leaks rather than frees early.
;
; The result is 0. A share is an effect on a header, not a value.
(pub :: emitPrimRetainRef (-> Int Int Int Int))
(pub fn (emitPrimRetainRef args cg stamp)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((v (strDup (memGetWord cg1 2)))
          (wv (if (== stamp 0)
                  0
                  (if (== (vecLen (nodeB stamp)) 0)
                      0
                      (cast Int (vecGet (nodeB stamp) 0))))))
      (let ((cgR (if (== wv 1)
                     (emitRetainOf cg1 v)
                     (if (>= wv 2)
                         (emitRetainIfEvBit cg1 v (- wv 2))
                         cg1))))
        {
          (memSetWord cgR 2 "0")
          (memSetWord cgR 14 0)
          cgR
        }))))

; `(__streq a b)` / `(__strne a b)`: one call into `@__axiom_str_eq`,
; with `__strne` inverting the answer. `want` is 1 for equality and 0
; for inequality, and the inversion is `xor 1` rather than a compare
; because the helper answers exactly 0 or 1.
;
; Both operands are emitted before the call, left then right, which is
; the evaluation order every other two-operand form here uses.
(pub :: emitPrimStrEq (-> Int Int Int Int))
(pub fn (emitPrimStrEq args cg want)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((a (strDup (memGetWord cg1 2))))
      (let ((cg2 (emitExpr (vecGet args 1) cg1)))
        (let ((b (strDup (memGetWord cg2 2)))
              (r (regStr (allocReg cg2))))
          (let ((cg3 (emitLine cg2
                       (cat4 (cat2 "  " r)
                             " = call i64 @__axiom_str_eq(i64 "
                             a
                             (cat3 ", i64 " b ")")))))
            (if (== want 1)
                { (memSetWord cg3 2 r) cg3 }
                (let ((n (regStr (allocReg cg3))))
                  (let ((cg4 (emitLine cg3
                               (cat4 (cat2 "  " n) " = xor i64 " r ", 1"))))
                    { (memSetWord cg4 2 n) cg4 })))))))))

; Both primitives are ONE CALL into the helpers `emitArenaHelpers`
; emitted beside the allocator - see there for what a mark saves and
; why a reset writes no byte of what it reclaims. They were inline
; once, and stopped fitting: a reset now walks the chunk list, which
; needs loops, which need blocks of their own.
(pub :: emitPrimArenaMark (-> Int Int))
(pub fn (emitPrimArenaMark cg)
  (let ((r (regStr (allocReg cg))))
    (let ((cg1 (emitLine cg (cat2 (cat2 "  " r)
                                  " = call i64 @__axiom_arena_mark_fn()"))))
      {
        (memSetWord cg1 2 r)
        cg1
      })))

(pub :: emitPrimArenaReset (-> Int Int Int))
(pub fn (emitPrimArenaReset args cg)
  (let ((cg0 (emitExpr (vecGet args 0) cg)))
    (let ((cell (strDup (memGetWord cg0 2))))
      (let ((r (regStr (allocReg cg0))))
        (let ((cg1 (emitLine cg0 (cat4 (cat2 "  " r)
                                       " = call i64 @__axiom_arena_reset_fn(i64 "
                                       cell ")"))))
          {
            (memSetWord cg1 2 (constStr 0))
            cg1
          })))))

; `(__axiom_arena_reset_keeping mark addr bytes)` -> where the kept
; block landed. Unlike the other two this one ANSWERS a value, so its
; result register goes in field 2.
(pub :: emitPrimArenaResetKeeping (-> Int Int Int))
(pub fn (emitPrimArenaResetKeeping args cg)
  (let ((cg0 (emitExpr (vecGet args 0) cg)))
    (let ((cell (strDup (memGetWord cg0 2))))
      (let ((cg1 (emitExpr (vecGet args 1) cg0)))
        (let ((src (strDup (memGetWord cg1 2))))
          (let ((cg2 (emitExpr (vecGet args 2) cg1)))
            (let ((n (strDup (memGetWord cg2 2))))
              (let ((r (regStr (allocReg cg2))))
                (let ((cg3 (emitLine cg2
                             (strConcat
                               (cat4 (cat2 "  " r)
                                     " = call i64 @__axiom_arena_reset_keeping_fn(i64 "
                                     cell ", i64 ")
                               (cat4 src ", i64 " n ")")))))
                  {
                    (memSetWord cg3 2 r)
                    cg3
                  })))))))))

; `(__argc)`: the count the entry wrapper captured before main ran.
(pub :: emitPrimArgc (-> Int Int))
(pub fn (emitPrimArgc cg)
  (let ((rn (allocReg cg)))
    (let ((r (regStr rn)))
      {
        (emitLine cg (cat2 (cat2 "  " r)
                           " = load i64, ptr @__axiom_argc"))
        (memSetWord cg 2 r)
        cg
      })))

; `(__argv i)`: the i-th argument's NUL-terminated bytes - the vector
; base the wrapper captured, then an ordinary indexed word load. No
; bounds check at this layer; `Sys.sysArg` owns that.
(pub :: emitPrimArgv (-> Int Int Int))
(pub fn (emitPrimArgv args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((i (strDup (memGetWord cg1 2)))
          (bn (allocReg cg1))
          (pn (allocReg cg1))
          (gn (allocReg cg1))
          (rn (allocReg cg1)))
      (let ((b (regStr bn))
            (p (cat2 "%p" (fmtInt pn)))
            (g (cat2 "%g" (fmtInt gn)))
            (r (regStr rn)))
        {
          (emitLine cg1 (cat2 (cat2 "  " b)
                              " = load i64, ptr @__axiom_argv"))
          (emitLine cg1 (cat4 (cat2 "  " p)
                              " = inttoptr i64 "
                              b
                              " to ptr"))
          (emitLine cg1 (strConcat (cat4 (cat2 "  " g)
                                         " = getelementptr i64, ptr "
                                         p
                                         ", i64 ")
                                   i))
          (emitLine cg1 (cat4 (cat2 "  " r)
                              " = load i64, ptr "
                              g
                              ""))
          (memSetWord cg1 2 r)
          cg1
        }))))

; `__intToFloat` is a numeric conversion (`sitofp`), not a
; reinterpretation - that is `cast`'s job - and the result travels as
; the i64 of its bits like every other float.
(pub :: emitPrimIntToFloat (-> Int Int Int))
(pub fn (emitPrimIntToFloat args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((v (strDup (memGetWord cg1 2)))
          (dn (allocReg cg1))
          (rn (allocReg cg1)))
      (let ((dr (cat2 "%d" (fmtInt dn)))
            (r (regStr rn)))
        {
          (emitLine cg1 (cat4 (cat2 "  " dr)
                              " = sitofp i64 "
                              v
                              " to double"))
          (emitLine cg1 (cat4 (cat2 "  " r)
                              " = bitcast double "
                              dr
                              " to i64"))
          (memSetWord cg1 2 r)
          (memSetWord cg1 14 1)
          cg1
        }))))

(pub :: emitPrimFloatToInt (-> Int Int Int))
(pub fn (emitPrimFloatToInt args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((v (strDup (memGetWord cg1 2)))
          (dn (allocReg cg1))
          (rn (allocReg cg1)))
      (let ((dr (cat2 "%d" (fmtInt dn)))
            (r (regStr rn)))
        {
          (emitLine cg1 (cat4 (cat2 "  " dr)
                              " = bitcast i64 "
                              v
                              " to double"))
          (emitLine cg1 (cat4 (cat2 "  " r)
                              " = fptosi double "
                              dr
                              " to i64"))
          (memSetWord cg1 2 r)
          (memSetWord cg1 14 0)
          cg1
        }))))

; The inline-assembly sequence takes the syscall number and six argument
; registers, so a call with fewer arguments is padded with zeros.
(pub :: emitPrimSyscall (-> Int Int Int))
(pub fn (emitPrimSyscall args cg)
  (let ((cg1 (emitArgsList args cg 0))
        (at (memGetWord cg1 9))
        (pad (padZeros (- 7 (vecLen args)) ""))
        (rn (allocReg cg1)))
    (let ((r (regStr rn)))
      {
        (emitLine cg1
          (cat4 (cat3 (cat2 "  " r)
                      (cat4 " = call i64 asm sideeffect "
                            (targetSyscallAsm (memGetWord cg1 26))
                            "(i64 "
                            "")
                      at)
                pad
                ")"
                ""))
        (memSetWord cg1 2 r)
        cg1
      })))

(pub :: padZeros (-> Int String String))
(pub fn (padZeros n acc)
  (if (<= n 0)
      acc
      (padZeros (- n 1) (cat2 acc ", i64 0"))))

(pub :: emitPrimAlloc (-> Int Int Int))
(pub fn (emitPrimAlloc args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg))
        (n (strDup (memGetWord cg1 2)))
        (rn (allocReg cg1)))
    (let ((r (regStr rn)))
      {
        (emitLine cg1 (cat4 (cat2 "  " r)
                            " = call i64 @axiom_alloc(i64 "
                            n
                            ")"))
        (memSetWord cg1 2 r)
        cg1
      })))

; The element type is what makes `__load8` and `__load64` differ: both
; index from a base, but one steps a byte and the other a word, and the
; byte form has to widen to a machine word on the way out.
(pub :: elemTy (-> Int String))
(pub fn (elemTy width)
  (if (== width 8) "i64" "i8"))

(pub :: emitPrimLoad (-> Int Int Int Int))
(pub fn (emitPrimLoad args cg width)
  (let ((cg1 (emitExpr (vecGet args 0) cg))
        (base (strDup (memGetWord cg1 2)))
        (cg2 (emitExpr (vecGet args 1) cg1))
        (idx (strDup (memGetWord cg2 2)))
        (ty (elemTy width))
        (pn (allocReg cg2)))
    (let ((pr (regStr pn)))
      (let ((cg3 (emitLine cg2 (cat4 (cat2 "  " pr)
                                     " = inttoptr i64 "
                                     base
                                     " to ptr"))))
        (let ((gn (allocReg cg3)))
          (let ((gr (regStr gn)))
            (let ((cg4 (emitLine cg3 (cat4 (cat3 (cat2 "  " gr)
                                                 " = getelementptr "
                                                 ty)
                                           (cat3 ", ptr " pr ", i64 ")
                                           idx
                                           ""))))
              (let ((vn (allocReg cg4)))
                (let ((vr (regStr vn)))
                  (let ((cg5 (emitLine cg4 (cat4 (cat3 (cat2 "  " vr)
                                                       " = load "
                                                       ty)
                                                 ", ptr "
                                                 gr
                                                 ""))))
                    (if (== width 8)
                        {
                          (memSetWord cg5 2 vr)
                          cg5
                        }
                        (let ((wn (allocReg cg5)))
                          (let ((wr (regStr wn)))
                            {
                              (emitLine cg5 (cat4 (cat2 "  " wr)
                                                  " = zext i8 "
                                                  vr
                                                  " to i64"))
                              (memSetWord cg5 2 wr)
                              cg5
                            })))))))))))))

(pub :: emitPrimStore (-> Int Int Int Int))
(pub fn (emitPrimStore args cg width)
  (let ((cg1 (emitExpr (vecGet args 0) cg))
        (base (strDup (memGetWord cg1 2)))
        (cg2 (emitExpr (vecGet args 1) cg1))
        (idx (strDup (memGetWord cg2 2)))
        (cg3 (emitExpr (vecGet args 2) cg2))
        (val (strDup (memGetWord cg3 2)))
        (ty (elemTy width))
        (pn (allocReg cg3)))
    (let ((pr (regStr pn)))
      (let ((cg4 (emitLine cg3 (cat4 (cat2 "  " pr)
                                     " = inttoptr i64 "
                                     base
                                     " to ptr"))))
        (let ((gn (allocReg cg4)))
          (let ((gr (regStr gn)))
            (let ((cg5 (emitLine cg4 (cat4 (cat3 (cat2 "  " gr)
                                                 " = getelementptr "
                                                 ty)
                                           (cat3 ", ptr " pr ", i64 ")
                                           idx
                                           ""))))
              ; A byte store needs the value narrowed first; a word store
              ; takes it as it stands.
              (let ((sv (if (== width 8) val (narrowByte cg5 val))))
                {
                  (emitLine cg5 (cat4 (cat3 "  store " ty " ")
                                      sv
                                      (cat2 ", ptr " gr)
                                      ""))
                  (memSetWord cg5 2 (constStr 0))
                  cg5
                }))))))))

(pub :: narrowByte (-> Int String String))
(pub fn (narrowByte cg val)
  (let ((tn (allocReg cg)))
    (let ((tr (regStr tn)))
      {
        (emitLine cg (cat4 (cat2 "  " tr)
                           " = trunc i64 "
                           val
                           " to i8"))
        tr
      })))

; `(__addr "text")` is the only way a literal's bytes reach the program.
; The literal is interned into the module's string table and referenced
; by the global the table will emit.
(pub :: emitPrimAddr (-> Int Int Int))
(pub fn (emitPrimAddr args cg)
  (let ((node (vecGet args 0)))
    (if (!= (nodeTag node) TAG_E_STR)
        (emitExpr node cg)
        (let ((id (internString cg (nodeA node)))
              (rn (allocReg cg)))
          (let ((r (regStr rn)))
            {
              (emitLine cg (cat4 (cat2 "  " r)
                                 " = ptrtoint ptr @str_"
                                 (fmtInt id)
                                 " to i64"))
              (memSetWord cg 2 r)
              cg
            })))))

(pub :: isCastName (-> String Bool))
(pub fn (isCastName nm)
  (strEq nm "cast"))


(pub :: reverseVec (-> Int Int))
(pub fn (reverseVec v)
  (reverseInto v (- (vecLen v) 1) vecNew))

(pub :: reverseInto (-> Int Int Int Int))
(pub fn (reverseInto v i acc)
  (if (< i 0) acc
      (reverseInto v (- i 1) (vecPush acc (vecGet v i)))))

; A spine may supply MORE arguments than the callee declares, and
; `((adder 10) 5)` is the shape: `adder` takes one parameter and
; returns a closure, so the surplus argument belongs to that closure,
; not to `adder`. Flattening the whole spine into one direct call
; passed both to `adder` - which read the second from a register it
; never declared - and answered with the returned closure's ADDRESS
; (tests/stdlib/140-function-values.ax). Every function value absorbs
; exactly one argument per call, which is the rule stage0 settled on
; for the identical bug on its own side.
;
; The arity gate is `isDefinedFn`, not `fnArityOf` alone: an unknown
; name answers arity 0, and treating every builtin and binary operator
; as over-applied would route `(+ a b)` through a closure record that
; does not exist.
(pub :: emitOverApplied (-> String Int Int Int Int))
(pub fn (emitOverApplied fnName args stamp cg)
  (let ((decls (memGetWord cg 8)))
    (if (isDefinedFn decls fnName)
        (let ((ar (fnArityOf decls fnName)))
          (if (|| (<= (vecLen args) ar) (== ar 0))
              (emitCall fnName args stamp cg)
              (let ((cgD (emitCall fnName (takeVec args ar) stamp cg)))
                (emitApplyChain (dropVec args ar) cgD
                                (strDup (memGetWord cgD 2)) 0))))
        (emitCall fnName args stamp cg))))

(pub :: takeVec (-> Int Int Int))
(pub fn (takeVec v n) (takeInto v n 0 vecNew))

(pub :: takeInto (-> Int Int Int Int Int))
(pub fn (takeInto v n i acc)
  (if (>= i n) acc (takeInto v n (+ i 1) (vecPush acc (vecGet v i)))))

(pub :: dropVec (-> Int Int Int))
(pub fn (dropVec v n) (dropInto v n vecNew))

(pub :: dropInto (-> Int Int Int Int))
(pub fn (dropInto v i acc)
  (if (>= i (vecLen v)) acc (dropInto v (+ i 1) (vecPush acc (vecGet v i)))))

; Emit regular call: check binops/comparisons first.
(pub :: emitCall (-> String Int Int Int Int))
(pub fn (emitCall fnName args stamp cg)
  (if (&& (== (vecLen args) 2) (isBinop fnName))
      (emitBinop2 fnName args cg)
  (if (&& (== (vecLen args) 2) (isCmpOp fnName))
      (emitCmp2 fnName args cg)
  ; `(- x)` used to be rewritten to `0 - x` here, which is what stage0
  ; does at PARSE time - and that is where stage1 does it now
  ; (`unaryMinusToBinary`). Doing it in the emitter meant the type
  ; checker still met a two-parameter builtin supplied with one
  ; argument, and reported AX3013 partial-application on a program
  ; stage0 compiles: the form was handled at the end of the pipeline and
  ; absent at the front, so nothing that reached here ever got here.
  (emitPlainCall fnName args stamp cg))))

; An operator's spelling depends on its operands - `fadd` against
; `add` - so the two are evaluated one at a time and their float flags
; captured, where a plain call can take the whole argument list at
; once. Either operand being a float makes the operation a float
; operation; a program mixing the two would be a type error under
; stage0, and this compiler compiles what it is given.
(pub :: emitBinop2 (-> String Int Int Int))
(pub fn (emitBinop2 fnName args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((a (strDup (memGetWord cg1 2)))
          (af (memGetWord cg1 14)))
      (let ((cg2 (emitExpr (vecGet args 1) cg1)))
        (let ((b (strDup (memGetWord cg2 2)))
              (bf (memGetWord cg2 14)))
          (if (|| (== af 1) (== bf 1))
              (emitFBinop fnName a b cg2)
              (emitIBinop fnName a b cg2)))))))

; `sdiv`/`srem` by zero is UNDEFINED in LLVM, and the two targets
; disagree about what undefined looks like: on darwin-aarch64
; `(/ 10 0)` printed 1 at exit 0, and the same IR on linux-x86_64
; lowers to `idiv`, which raises SIGFPE. Same source, two behaviours,
; and `check` had nothing to say about either.
;
; Guarded now: a compare and a branch to a shared trap that names the
; fault on fd 2 and exits 72. One predictable branch, paid only by
; `/` and `%`.
(pub :: emitIBinop (-> String String String Int Int))
(pub fn (emitIBinop fnName a b cg)
  (let ((cgG (if (isDivOp fnName) (emitDivGuard b cg) cg)))
    (let ((rn (allocReg cgG)))
      (let ((r (regStr rn)))
        {
          (emitLine cgG (cat4 (cat3 (cat2 "  " r) " = " (binopToLLVM fnName))
                              " i64 "
                              (cat3 a ", " b)
                              ""))
          (memSetWord cgG 2 r)
          (memSetWord cgG 14 0)
          cgG
        }))))

(pub :: isDivOp (-> String Bool))
(pub fn (isDivOp nm) (|| (strEq nm "/") (strEq nm "%")))

; `if divisor == 0 then trap`. The trap block ends `unreachable`, so
; nothing downstream has to know it is there.
(pub :: emitDivGuard (-> String Int Int))
(pub fn (emitDivGuard b cg)
  (let ((cn (allocReg cg)))
    (let ((zn (allocReg cg))
          (kn (allocReg cg)))
      (let ((c (regStr cn))
            (zb (cat2 "divzero_" (fmtInt zn)))
            (kb (cat2 "divok_" (fmtInt kn))))
        {
          (emitLine cg (cat4 (cat2 "  " c) " = icmp eq i64 " b ", 0"))
          (emitLine cg (cat4 (cat3 "  br i1 " c ", label %")
                             zb (cat2 ", label %" kb) ""))
          (emitLabel cg zb)
          (emitLine cg "  call i64 @__axiom_div_by_zero()")
          (emitLine cg "  unreachable")
          (emitLabel cg kb)
          cg
        }))))

; The operands hold bits; the arithmetic wants a double. `bitcast` in,
; one float instruction, `bitcast` back out - free at runtime, and the
; register allocator keeps a chain of them in FP registers.
(pub :: emitFBinop (-> String String String Int Int))
(pub fn (emitFBinop fnName a b cg)
  (let ((an (allocReg cg))
        (bn (allocReg cg))
        (mn (allocReg cg))
        (rn (allocReg cg)))
    (let ((ar (cat2 "%d" (fmtInt an)))
          (br (cat2 "%d" (fmtInt bn)))
          (fr (cat2 "%d" (fmtInt mn)))
          (r (regStr rn)))
      {
        (emitLine cg (cat4 (cat2 "  " ar) " = bitcast i64 " a " to double"))
        (emitLine cg (cat4 (cat2 "  " br) " = bitcast i64 " b " to double"))
        (emitLine cg (cat4 (cat3 (cat2 "  " fr) " = " (fbinopToLLVM fnName))
                           " double "
                           (cat3 ar ", " br)
                           ""))
        (emitLine cg (cat4 (cat2 "  " r) " = bitcast double " fr " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 1)
        cg
      })))

(pub :: emitCmp2 (-> String Int Int Int))
(pub fn (emitCmp2 fnName args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((a (strDup (memGetWord cg1 2)))
          (af (memGetWord cg1 14)))
      (let ((cg2 (emitExpr (vecGet args 1) cg1)))
        (let ((b (strDup (memGetWord cg2 2)))
              (bf (memGetWord cg2 14)))
          (if (|| (== af 1) (== bf 1))
              (emitFCmp fnName a b cg2)
              (emitICmp fnName a b cg2)))))))

(pub :: emitICmp (-> String String String Int Int))
(pub fn (emitICmp fnName a b cg)
  (let ((cn (allocReg cg))
        (rn (allocReg cg)))
    (let ((cr (cat2 "%c" (fmtInt cn)))
          (r (regStr rn)))
      {
        (emitLine cg (cat4 (cat3 (cat2 "  " cr) " = icmp " (cmpToLLVM fnName))
                           " i64 "
                           (cat3 a ", " b)
                           ""))
        (emitLine cg (cat4 (cat2 "  " r) " = zext i1 " cr " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

; Ordered comparisons, so a NaN operand compares false - the same
; choice stage0 makes.
(pub :: emitFCmp (-> String String String Int Int))
(pub fn (emitFCmp fnName a b cg)
  (let ((an (allocReg cg))
        (bn (allocReg cg))
        (cn (allocReg cg))
        (rn (allocReg cg)))
    (let ((ar (cat2 "%d" (fmtInt an)))
          (br (cat2 "%d" (fmtInt bn)))
          (cr (cat2 "%c" (fmtInt cn)))
          (r (regStr rn)))
      {
        (emitLine cg (cat4 (cat2 "  " ar) " = bitcast i64 " a " to double"))
        (emitLine cg (cat4 (cat2 "  " br) " = bitcast i64 " b " to double"))
        (emitLine cg (cat4 (cat3 (cat2 "  " cr) " = fcmp " (fcmpToLLVM fnName))
                           " double "
                           (cat3 ar ", " br)
                           ""))
        (emitLine cg (cat4 (cat2 "  " r) " = zext i1 " cr " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

(pub :: emitPlainCall (-> String Int Int Int Int))
(pub fn (emitPlainCall fnName args stamp cg)
  (let ((argRegs vecNew))
  (let ((argStrCg (emitArgsRegs args cg argRegs 0)))
    (let ((argStrT (strDup (memGetWord argStrCg 9)))
          ; The callee's defining module may have renamed it - a bare
          ; reference reaches whatever symbol the map says (entry file
          ; first, then first import). Operators and primitives never
          ; enter the map, so `full` is `fnName` for them.
          (full (mangledFor argStrCg fnName)))
      ; MM-LIFE-2d: presence of the hidden argument is SIG-driven -
      ; every call to a polymorphic callee passes a word even when no
      ; stamp survived (the unchecked emitModule path, a demoted
      ; shared-node stamp) - and only the VALUE is stamp-driven, so a
      ; missing stamp means constant 0, never a missing argument.
      (let ((takesEv (fnTakesEvw argStrCg full)))
      (let ((cgE (if (== takesEv 1)
                     (emitEvWordVal argStrCg stamp)
                     argStrCg)))
      (let ((evStr (if (== takesEv 1)
                       (cat2 ", i64 " (strDup (memGetWord cgE 2)))
                       "")))
      (let ((rn (allocReg cgE)))
      (let ((r (regStr rn)))
        (let ((callInst (cat3 (cat3 (cat2 "  " r)
                                    " = call i64 @"
                                    (llvmSym (strDup full)))
                              "(i64 "
                              (cat3 argStrT evStr ")"))))
          {
            (emitLine cgE callInst)
            ; the temporaries this call consumed, released now that
            ; the callee has taken whatever share it keeps
            (releaseOwnedArgs cgE fnName args argRegs 0)
            (memSetWord cgE 2 r)
            (memSetWord cgE 14 (fnRetIsFloat cgE full))
            cgE
          }))))))))))

; `emitArgsList` that also records each argument's register, in
; order, into `regs`.
(pub :: emitArgsRegs (-> Int Int Int Int Int))
(pub fn (emitArgsRegs args cg regs i)
  (if (>= i (vecLen args))
      {
        (memSetWord cg 2 "")
        (memSetWord cg 9 "")
        cg
      }
      (let ((node (vecGet args i)))
        (let ((cg1 (emitExpr node cg)))
          (let ((reg (strDup (memGetWord cg1 2))))
            {
              (vecPush regs (cast Int reg))
              (let ((restCg (emitArgsRegs args cg1 regs (+ i 1))))
                (let ((rest (memGetWord restCg 2))
                      (restT (memGetWord restCg 9)))
                  (if (== (strLen rest) 0)
                      {
                        (memSetWord restCg 2 reg)
                        (memSetWord restCg 9 (strDup reg))
                        restCg
                      }
                      {
                        (memSetWord restCg 2 (cat3 reg ", " rest))
                        (memSetWord restCg 9 (cat3 (strDup reg) ", i64 " restT))
                        restCg
                      })))
            })))))

; An OWNED temporary handed to a call is released once the call has
; returned: the callee borrowed it (event 1), every store it could
; make took a share (events 5/6, MM-LIFE-2g), and a callee that
; answers it answers a retained share (event 2). Only a callee whose
; declared result class is known - a word or a reference - gets this;
; a function answering a type variable retains nothing on the way
; out, and keeps today's leak. The head reaching here is a global
; with a signature (`emitPlainCall` is past the primitive, local and
; constructor dispatch), or an unsigned one, which answers -1.
(pub :: releaseOwnedArgs (-> Int String Int Int Int Int))
(pub fn (releaseOwnedArgs cg fnName args regs i)
  (if (>= i (vecLen args))
      cg
      (let ((cls (fnResultClass cg fnName)))
        (if (|| (== cls 0) (== cls 2))
            (if (&& (== (valueOwnedRef cg (vecGet args i)) 1)
                    ; the callee parks nothing of a typed arrival
                    ; there, and answers no part of it that the caller
                    ; now holds instead - and an immediate (`Nil`)
                    ; has nothing to give back
                    (&& (== (isNullaryConNode cg (vecGet args i)) 0)
                    (&& (== (& (fnStashMask cg fnName) (| (paramBit i) (ownerBit i))) 0)
                        (|| (== cls 2)
                            (== (& (fnRetMask cg fnName) (anyBit i)) 0)))))
                (releaseOwnedArgs (emitReleaseOf cg (cast String (vecGet regs i)))
                                  fnName args regs (+ i 1))
                (releaseOwnedArgs cg fnName args regs (+ i 1)))
            cg))))

(pub :: isNullaryConNode (-> Int Int Int))
(pub fn (isNullaryConNode cg e)
  (if (== e 0)
      0
      (if (== (nodeTag e) TAG_E_VAR)
          (if (!= (lookupType (memGetWord cg 3) (nodeA e)) 0) 1 0)
          (if (&& (== (nodeTag e) TAG_E_APP) (== (spineArity e) 0))
              (isNullaryConNode cg (spineHead e))
              0))))


; ------------------------------------------------------------------
; `&&` and `||` short-circuit.
;
; Lowering them to `and`/`or` over two already-evaluated operands gives
; the right answer for 0/1 values and the wrong behaviour for everything
; else: the right-hand side runs even when the left has already decided.
; That is what a guard exists to prevent. `isNullaryFnIn` in this very
; file reads `(vecLen (nodeB d))` only after checking the declaration is
; a function - a signature declaration has 0 there, and evaluating it
; anyway dereferences address zero.
;
; So they become branches, like `if`.
; ------------------------------------------------------------------
(pub :: isAndOr (-> String Bool))
(pub fn (isAndOr nm)
  (if (strEq nm "&&")
      true
      (strEq nm "||")))

(pub :: emitAndOr (-> String Int Int Int))
(pub fn (emitAndOr op args cg)
  (let ((isAnd (strEq op "&&"))
        (cg1 (emitExpr (vecGet args 0) cg))
        (ra (strDup (memGetWord cg1 2)))
        (cn (allocReg cg1))
        (rhsL (allocReg cg1))
        (shortL (allocReg cg1))
        (mergeL (allocReg cg1))
        (cr (regStr cn))
        (rhsB (cat2 "label_" (fmtInt rhsL)))
        (shortB (cat2 "label_" (fmtInt shortL)))
        (mergeB (cat2 "label_" (fmtInt mergeL)))
        (_1 (emitLine cg1 (cat4 (cat2 "  " cr)
                                " = icmp ne i64 "
                                ra
                                ", 0")))
        ; `&&` takes the right-hand side when the left is true; `||`
        ; when it is false.
        (tgtT (if isAnd rhsB shortB))
        (tgtF (if isAnd shortB rhsB))
        (_2 (emitLine cg1 (cat4 (cat3 "  br i1 " cr ", label %")
                                tgtT
                                (cat2 ", label %" tgtF)
                                "")))
        (_3 (emitLabel cg1 rhsB))
        (cg2 (emitExpr (vecGet args 1) cg1))
        (rb (strDup (memGetWord cg2 2)))
        (bn (allocReg cg2))
        (bcr (regStr bn))
        (_4 (emitLine cg2 (cat4 (cat2 "  " bcr)
                                " = icmp ne i64 "
                                rb
                                ", 0")))
        (zn (allocReg cg2))
        (zr (regStr zn))
        (_5 (emitLine cg2 (cat4 (cat2 "  " zr)
                                " = zext i1 "
                                bcr
                                " to i64")))
        (rhsPred (strDup (memGetWord cg2 11)))
        (_6 (emitLine cg2 (cat2 "  br label %" mergeB)))
        (_7 (emitLabel cg2 shortB))
        (_8 (emitLine cg2 (cat2 "  br label %" mergeB)))
        (_9 (emitLabel cg2 mergeB))
        (pn (allocReg cg2))
        (pr (regStr pn))
        (shortVal (if isAnd (constStr 0) (constStr 1)))
        (_10 (emitLine cg2
               (cat4 (cat3 (cat2 "  " pr)
                           " = phi i64 [ " zr)
                     (cat3 ", %" rhsPred " ], [ ")
                     (cat3 shortVal ", %" shortB)
                     " ]")))
        (_11 (memSetWord cg2 2 pr)))
    cg2))

; `&&`/`||` never reach this table - `dispatchCall` routes them to the
; short-circuit branches first - so a single `&` or `|` here is
; unambiguously the bitwise operator.
(pub :: isBinop (-> String Bool))
(pub fn (isBinop nm)
  (if (strEq nm "+") true
  (if (strEq nm "-") true
  (if (strEq nm "*") true
  (if (strEq nm "/") true
  (if (strEq nm "%") true
  (if (strEq nm "&") true
  (if (strEq nm "|") true
  (if (strEq nm "^") true
  (if (strEq nm "<<") true
  (if (strEq nm ">>") true
  false)))))))))))

(pub :: binopToLLVM (-> String String))
(pub fn (binopToLLVM nm)
  (if (strEq nm "+") "add"
  (if (strEq nm "-") "sub"
  (if (strEq nm "*") "mul"
  (if (strEq nm "/") "sdiv"
  (if (strEq nm "%") "srem"
  (if (strEq nm "&") "and"
  (if (strEq nm "|") "or"
  (if (strEq nm "^") "xor"
  (if (strEq nm "<<") "shl"
  (if (strEq nm ">>") "ashr"     ; arithmetic, matching stage0
  "add")))))))))))

(pub :: isCmpOp (-> String Bool))
(pub fn (isCmpOp nm)
  (if (strEq nm "==") true
  (if (strEq nm "!=") true
  (if (strEq nm "<")  true
  (if (strEq nm ">")  true
  (if (strEq nm "<=") true
  (if (strEq nm ">=") true
  false)))))))

(pub :: cmpToLLVM (-> String String))
(pub fn (cmpToLLVM nm)
  (if (strEq nm "==") "eq"
  (if (strEq nm "!=") "ne"
  (if (strEq nm "<")  "slt"
  (if (strEq nm ">")  "sgt"
  (if (strEq nm "<=") "sle"
  (if (strEq nm ">=") "sge"
  "eq")))))))

(pub :: fbinopToLLVM (-> String String))
(pub fn (fbinopToLLVM nm)
  (if (strEq nm "+") "fadd"
  (if (strEq nm "-") "fsub"
  (if (strEq nm "*") "fmul"
  (if (strEq nm "/") "fdiv"
  (if (strEq nm "%") "frem"
  "fadd"))))))

; Ordered variants throughout: `o` requires neither operand be NaN, so
; a NaN compares false under every operator, matching stage0.
(pub :: fcmpToLLVM (-> String String))
(pub fn (fcmpToLLVM nm)
  (if (strEq nm "==") "oeq"
  (if (strEq nm "!=") "one"
  (if (strEq nm "<")  "olt"
  (if (strEq nm ">")  "ogt"
  (if (strEq nm "<=") "ole"
  (if (strEq nm ">=") "oge"
  "oeq")))))))

; Emit argument expressions from a Vec, building comma-separated reg string.
(pub :: emitArgsList (-> Int Int Int Int))
(pub fn (emitArgsList args cg i)
  (if (>= i (vecLen args))
      {
        (memSetWord cg 2 "")
        (memSetWord cg 9 "")
        cg
      }
      (let ((node (vecGet args i)))
        (let ((cg1 (emitExpr node cg)))
          (let ((reg (strDup (memGetWord cg1 2))))
            (let ((restCg (emitArgsList args cg1 (+ i 1))))
              (let ((rest (memGetWord restCg 2))
                    (restT (memGetWord restCg 9)))
                (if (== (strLen rest) 0)
                    {
                      (memSetWord restCg 2 reg)
                      (memSetWord restCg 9 (strDup reg))
                      restCg
                    }
                    {
                      (memSetWord restCg 2 (cat3 reg ", " rest))
                      (memSetWord restCg 9 (cat3 (strDup reg) ", i64 " restT))
                      restCg
                    }))))))))

; ------------------------------------------------------------------
; MM-LIFE-2d, monomorphic half: the reference map is computed at
; COMPILE time from the declared field types and stored into the
; shape word at each construction site. A field is a REFERENCE iff
; its declared type guarantees the word at run time is an immediate,
; a static, or a pointer to a counted block - String, a declared
; data or struct type, a tuple, an arrow. Scalars (Int, Float, Bool,
; Char, the fixed-width family) never enter the map: an Int can hold
; any bit pattern, and @axiom_release dereferencing one past the
; immediates guard is the wild read this classification exists to
; make impossible. Anything UNCLASSIFIABLE - a type variable, a Ptr,
; an alias, a qualified spelling - forces the whole block to the
; LEAF (empty map): under-reclaiming leaks, a wrong bit
; use-after-frees, and only one of those is survivable.
; ------------------------------------------------------------------
(pub :: scalarTyName (-> String Int))
(pub fn (scalarTyName n)
  (if (|| (strEq n "Int")
      (|| (strEq n "Bool")
      (|| (strEq n "Char")
      (|| (strEq n "Float")
      (|| (strEq n "I8")
      (|| (strEq n "I16")
      (|| (strEq n "I32")
      (|| (strEq n "I64")
      (|| (strEq n "U8")
      (|| (strEq n "U16")
      (|| (strEq n "U32")
      (|| (strEq n "U64")
      (|| (strEq n "F32")
      (|| (strEq n "F64")
      ; `Foreign` - a raw pointer into memory Axiom did not allocate
      ; and does not own (MM-FFI-3). It is class 0 for the same reason
      ; `Int` is, and more urgently: a set bit here would make
      ; @axiom_release subtract 16 from a Rust allocation and read the
      ; result as a block header. That is the wild read this whole
      ; classification exists to make impossible, and it is MM-FFI-5
      ; requirement 2 - "no arena primitive applies to it" - discharged
      ; where it is actually decided.
      ;
      ; Being classified at all is also what keeps the ENCLOSING record
      ; mapped. An unknown name answers 1 (unclassifiable), which forces
      ; the whole block to LEAF, so before this every struct holding a
      ; foreign handle silently lost the reference map for all its
      ; OTHER fields and leaked them.
      (strEq n "Foreign")))))))))))))))
      1 0))

(pub :: dataTyKnown (-> Int String Int Int))
(pub fn (dataTyKnown names n i)
  (if (>= i (vecLen names))
      0
      (if (strEq (cast String (vecGet names i)) n)
          1
          (dataTyKnown names n (+ i 1)))))

; 0 = machine scalar, 2 = reference, 1 = unclassifiable (forces leaf)
(pub :: fldClass (-> Int Int Int))
(pub fn (fldClass cg tn)
  (if (== tn 0)
      1
      (let ((tg (nodeTag tn)))
        (if (== tg TAG_T_ARR)
            2
        (if (== tg TAG_T_TUP)
            (if (== (vecLen (nodeA tn)) 0) 0 2)
        (if (== tg TAG_T_CON)
            (let ((n (cast String (nodeA tn))))
              (if (== (scalarTyName n) 1)
                  0
              ; `Handle` is a counted block of the foreign form
              ; (stdlib/Ffi.ax): a reference, walked and released
              (if (|| (strEq n "String") (|| (strEq n "Option") (strEq n "Handle")))
                  ; the builtin `Option` is seeded by the checker and
                  ; never enters the module's data list
                  2
              (if (== (dataTyKnown (memGetWord cg 35) n 0) 1)
                  2
                  (let ((e (lookupType (memGetWord cg 3) n)))
                    (if (if (== e 0) false (== (eKind e) TF_STRUCT)) 2 1))))))
            1))))))

; The PADDED payload word count - THE one count convention
; (docs/memory-model.md MM-LIFE-2d): ((words*8)+15 & -16)/8, always
; even; the size class is count >> 1, exactly the allocator's
; `lshr %sz0, 4`; a dead block files iff 0 < count <= 8192.
(pub :: paddedWords (-> Int Int))
(pub fn (paddedWords w) (* (/ (+ (* w 8) 15) 16) 2))

(pub :: pow2 (-> Int Int))
(pub fn (pow2 k) (if (<= k 0) 1 (* 2 (pow2 (- k 1)))))

; The reference bitmap already shifted to bits 16.., or -1 when any
; field is unclassifiable. Bit 16+i covers BLOCK word i, so a data
; cell's fields sit at base 1 (word 0 is the tag, never mapped) and
; a struct's at base 0. Word 47 would be bit 63 - the sign bit - so
; the map's capacity is 47 words and AX3029 refuses wider blocks
; before emission; every shape constant stays non-negative, which is
; what keeps `fmtInt` honest about it.
(pub :: shapeBits (-> Int Int Int Int Int Int))
(pub fn (shapeBits cg ftys isStruct base i)
  (if (>= i (vecLen ftys))
      0
      (let ((tn (if (== isStruct 1) (nodeTy (vecGet ftys i)) (vecGet ftys i))))
        (let ((c (fldClass cg tn))
              (rest (shapeBits cg ftys isStruct base (+ i 1))))
          (if (|| (== c 1) (== rest (- 0 1)))
              (- 0 1)
              (+ rest (if (== c 2) (pow2 (+ 16 (+ base i))) 0)))))))

(pub :: ctorShapeConst (-> Int Int Int))
(pub fn (ctorShapeConst cg entry)
  (let ((kind (eKind entry))
        (arity (eArity entry)))
    (let ((words (if (== kind TF_DATA) (+ arity 1) arity)))
      (let ((cnt (paddedWords words))
            (ftys (if (== kind TF_DATA) (eFieldTys entry) (eFieldFlags entry)))
            (base (if (== kind TF_DATA) 1 0))
            (isStruct (if (== kind TF_DATA) 0 1)))
        (let ((bits (if (> words 47)
                        (- 0 1)
                        (if (== ftys 0)
                            (if (== arity 0) 0 (- 0 1))
                            (shapeBits cg ftys isStruct base 0)))))
          (+ (* cnt 2) (if (== bits (- 0 1)) 0 bits)))))))

; The site's shape store - the third writer beside the allocator's
; leaf and the keep helper's re-stamp. The -8 is a literal in the
; instruction text: a GEP index of -1 would pass through `fmtInt`,
; which renders negatives wrong (the tag counter's `/` lesson).
(pub :: storeShapeValAt (-> Int String String Int))
(pub fn (storeShapeValAt cg base val)
  (let ((sn (allocReg cg)))
    (let ((sr (regStr sn)))
      (let ((cg1 (emitLine cg (cat4 (cat2 "  " sr)
                                    " = add i64 "
                                    base
                                    ", -8"))))
        (let ((pn (allocReg cg1)))
          (let ((pr (regStr pn)))
            (let ((cg2 (emitLine cg1 (cat4 (cat2 "  " pr)
                                           " = inttoptr i64 "
                                           sr
                                           " to ptr"))))
              (emitLine cg2 (cat4 "  store i64 "
                                  val
                                  ", ptr "
                                  pr)))))))))

(pub :: storeShapeAt (-> Int String Int Int))
(pub fn (storeShapeAt cg base shape)
  (storeShapeValAt cg base (constStr shape)))

; MM-LIFE-2c, A1: a compiler-emitted OWNERSHIP-CREATING site births
; its block at count 1 - the constructing expression's own share.
; Raw __alloc/memAlloc and strWrap stay birth-0: the type-gated
; machinery supplies their +1 elsewhere, and a second birth would
; double-count every String.
(pub :: storeCountOneAt (-> Int String Int))
(pub fn (storeCountOneAt cg base)
  (let ((sn (allocReg cg)))
    (let ((sr (regStr sn)))
      (let ((cg1 (emitLine cg (cat4 (cat2 "  " sr)
                                    " = add i64 "
                                    base
                                    ", -16"))))
        (let ((pn (allocReg cg1)))
          (let ((pr (regStr pn)))
            (let ((cg2 (emitLine cg1 (cat4 (cat2 "  " pr)
                                           " = inttoptr i64 "
                                           sr
                                           " to ptr"))))
              (emitLine cg2 (cat3 "  store i64 1, ptr "
                                  pr
                                  "")))))))))

(pub :: emitRetainOf (-> Int String Int))
(pub fn (emitRetainOf cg v)
  (emitLine cg (cat3 "  call void @axiom_retain(i64 "
                     v
                     ")")))

(pub :: emitReleaseOf (-> Int String Int))
(pub fn (emitReleaseOf cg v)
  (emitLine cg (cat3 "  call void @axiom_release(i64 "
                     v
                     ")")))

; retain V only when bit k of the enclosing evidence word is set -
; the conditional twin every symbolic witness needs (a retain on a
; non-reference word is a wild count, so the guard is soundness).
(pub :: emitRetainIfEvBit (-> Int String Int Int))
(pub fn (emitRetainIfEvBit cg v k)
  (let ((cgR (emitEvwRead cg)))
    (emitRcIfBitOf cgR v k (strDup (memGetWord cgR 2)) 1)))

; `v` retained (op 1) or released (op 0) when bit k of the evidence
; WORD `src` is set: the boundary of a self-tail-call loop retains a
; type-variable slot's new value by the next iteration's word and
; releases the old value by the word that was current for it.
(pub :: emitRcIfBitOf (-> Int String Int String Int Int))
(pub fn (emitRcIfBitOf cgR v k src op)
  (let ((_unused 0)
          (an (allocReg cgR)))
      (let ((ar (regStr an)))
        (let ((cgA (emitLine cgR (cat4 (cat3 (cat2 "  " ar)
                                            " = lshr i64 "
                                            src)
                                      ", "
                                      (constStr k) ""))))
          (let ((bn (allocReg cgA)))
            (let ((br (regStr bn)))
              (let ((cgB (emitLine cgA (cat3 (cat2 "  " br)
                                            " = and i64 "
                                            (cat2 ar ", 1")))))
                (let ((cn (allocReg cgB)))
                  (let ((cr (regStr cn)))
                    (let ((cgC (emitLine cgB (cat4 (cat3 (cat2 "  " cr)
                                                        " = icmp ne i64 "
                                                        br)
                                                  ", "
                                                  "0" ""))))
                      (let ((dn (allocReg cgC))
                            (kn (allocReg cgC)))
                        (let ((doB (cat2 "label_" (fmtInt dn)))
                              (skB (cat2 "label_" (fmtInt kn))))
                          (let ((cgD (emitLine cgC (cat4 (cat3 "  br i1 "
                                                              cr
                                                              ", label %")
                                                        doB
                                                        (cat2 ", label %" skB) ""))))
                            (let ((cgE (emitLabel cgD doB)))
                              (let ((cgF (if (== op 1) (emitRetainOf cgE v) (emitReleaseOf cgE v))))
                                (let ((cgG (emitLine cgF (cat2 "  br label %" skB))))
                                  (emitLabel cgG skB)))))))))))))))))

; MM-LIFE-2d, the evidence consumer: a data cell whose declared
; field type is a TYPE VARIABLE takes its map bit from the call's
; stamp instead of falling to the leaf - constant bits fold into
; the stored constant, and a symbolic witness reads its bit out of
; the enclosing function's word at run time. A field the types
; cannot classify AND is not a variable (a Ptr, an alias) still
; forces the whole block to the leaf; a variable with no stamp, or
; a witness of 0, contributes no bit - which IS the leaf answer for
; that field, with every classifiable neighbour's bit kept.
(pub :: ctorShapeEmit (-> Int String Int Int Int))
(pub fn (ctorShapeEmit cg ptr entry stamp)
  (let ((kind (eKind entry))
        (arity (eArity entry)))
    (let ((words (if (== kind TF_DATA) (+ arity 1) arity)))
      (if (|| (!= kind TF_DATA)
              (|| (> words 47)
                  (== (eFieldTys entry) 0)))
          (storeShapeAt cg ptr (ctorShapeConst cg entry))
          (let ((ftys0 (eFieldTys entry))
                (mut anyVar 0))
          {
            (let ((mut j0 0))
              (while (< j0 (vecLen ftys0))
                {
                  (if (== (tyIsSrcVar (vecGet ftys0 j0)) 1) (set anyVar 1) 0)
                  (set j0 (+ j0 1))
                }))
            (if (== anyVar 0)
                ; no variable field: the static path allocates nothing
                (storeShapeAt cg ptr (ctorShapeConst cg entry))
          (let ((cnt (paddedWords words))
                (ftys (eFieldTys entry))
                (vars vecNew)
                (symPos vecNew)
                (symK vecNew)
                (mut stat 0)
                (mut leaf 0))
            {
              ; the ctor arrow's variable ordering = the fields walk,
              ; in order - the checker's stamp walked fields-then-
              ; result, and result-only variables sit past every
              ; field index, so the prefix agrees by construction
              (cgSigVarsVec ftys vars)
              (let ((mut j 0))
                (while (< j (vecLen ftys))
                  {
                    (let ((tn (vecGet ftys j)))
                      (if (== (tyIsSrcVar tn) 1)
                          (if (!= stamp 0)
                              (let ((vi (strVecIdx vars (nodeA tn))))
                                (if (if (< vi 0)
                                        true
                                        (>= vi (vecLen (nodeB stamp))))
                                    0
                                    (let ((wv (cast Int (vecGet (nodeB stamp) vi))))
                                      (if (== wv 1)
                                          (set stat (+ stat (pow2 (+ 17 j))))
                                          (if (>= wv 2)
                                              {
                                                (vecPush symPos (+ 17 j))
                                                (vecPush symK (- wv 2))
                                              }
                                              0)))))
                              0)
                          (let ((c (fldClass cg tn)))
                            (if (== c 1)
                                (set leaf 1)
                                (if (== c 2)
                                    (set stat (+ stat (pow2 (+ 17 j))))
                                    0)))))
                    (set j (+ j 1))
                  }))
              (if (== leaf 1)
                  (storeShapeAt cg ptr (* cnt 2))
                  (if (== (vecLen symPos) 0)
                      (storeShapeAt cg ptr (+ (* cnt 2) stat))
                      (let ((cgR (emitEvwRead cg)))
                        (let ((src (strDup (memGetWord cgR 2)))
                              (mut acc (constStr (+ (* cnt 2) stat)))
                              (mut cgX cgR)
                              (mut q 0))
                          {
                            (while (< q (vecLen symPos))
                              {
                                (let ((an (allocReg cgX)))
                                  (let ((ar (regStr an)))
                                    (let ((cgA (emitLine cgX (cat4 (cat3 (cat2 "  " ar)
                                                                        " = lshr i64 "
                                                                        src)
                                                                  ", "
                                                                  (constStr (cast Int (vecGet symK q))) ""))))
                                      (let ((bn (allocReg cgA)))
                                        (let ((br (regStr bn)))
                                          (let ((cgB (emitLine cgA (cat3 (cat2 "  " br)
                                                                        " = and i64 "
                                                                        (cat2 ar ", 1")))))
                                            (let ((sn2 (allocReg cgB)))
                                              (let ((sr2 (regStr sn2)))
                                                (let ((cgS (emitLine cgB (cat4 (cat3 (cat2 "  " sr2)
                                                                                    " = shl i64 "
                                                                                    br)
                                                                              ", "
                                                                              (constStr (cast Int (vecGet symPos q))) ""))))
                                                  (let ((on (allocReg cgS)))
                                                    (let ((orr (regStr on)))
                                                      {
                                                        (set cgX (emitLine cgS (cat4 (cat3 (cat2 "  " orr)
                                                                                          " = or i64 "
                                                                                          acc)
                                                                                    ", "
                                                                                    sr2 "")))
                                                        (set acc orr)
                                                      })))))))))))
                                (set q (+ q 1))
                              })
                            (storeShapeValAt cgX ptr acc)
                          }))))
            }))
          })))))

; ------------------------------------------------------------------
; Constructor emission: alloc + shape + field stores.
; ------------------------------------------------------------------
(pub :: emitConstructor (-> Int Int Int Int Int))
(pub fn (emitConstructor args entry stamp cg)
  (let ((kind (eKind entry))
        (arity (eArity entry))
        (ctorTag (eTag entry))
        (rep (eRep entry)))
  ; A nullary constructor of any type that unboxes (all-nullary OR
  ; mixed) is its immediate tag - stage0's S1 representation. The
  ; match sites carry the matching discipline: direct compare when
  ; the pattern names an unboxed constructor, a guarded tag read when
  ; a fieldful pattern's scrutinee might be an immediate sibling.
  (if (&& (== kind TF_DATA) (&& (== arity 0) (!= rep 0)))
      {
        (memSetWord cg 2 (constStr ctorTag))
        cg
      }
      (if (&& (== kind TF_STRUCT) (== arity 0))
          {
            (memSetWord cg 2 (constStr 0))
            cg
          }
          (let ((size (if (== kind TF_DATA) (* (+ arity 1) 8) (* arity 8))))
            (let ((ptrN (allocReg cg)))
              (let ((ptr (regStr ptrN)))
                ; `axiom_alloc` answers a machine word like everything
                ; else, so the block address stays an `i64` and only
                ; becomes a `ptr` at the point of each store.
                (let ((allocInst (cat3 (cat2 "  " ptr)
                                       " = call i64 @axiom_alloc(i64 "
                                       (cat2 (constStr size) ")"))))
                  (let ((cg1 (emitLine cg allocInst)))
                    ; the allocator stamped the LEAF inside the call;
                    ; this store overwrites it with the site's record
                    ; shape - one redundant word store per
                    ; construction, the price of a site-agnostic
                    ; allocator
                    (let ((cgS (ctorShapeEmit cg1 ptr entry stamp)))
                      (let ((cg2 (if (== kind TF_DATA)
                                     (storeWordAt cgS ptr 0 (constStr ctorTag))
                                     cgS)))
                        (let ((base (if (== kind TF_DATA) 1 0)))
                          ; A1: the constructing expression's own share
                          (let ((cgC (storeCountOneAt cg2 ptr)))
                          (let ((cg3 (emitFieldStores cgC ptr args 0 base entry stamp)))
                            {
                              (memSetWord cg3 2 ptr)
                              cg3
                            }))))))))))))))

; Store `val` at word `idx` of the block whose address is in `base`.
; An `inttoptr` folded into the `getelementptr` operand would be a
; constant expression, and a constant expression cannot name a register.
; It gets its own instruction.
(pub :: storeWordAt (-> Int String Int String Int))
(pub fn (storeWordAt cg base idx val)
  (let ((pn (allocReg cg)))
    (let ((pr (regStr pn)))
      (let ((cg1 (emitLine cg (cat4 (cat2 "  " pr)
                                    " = inttoptr i64 "
                                    base
                                    " to ptr"))))
        (let ((an (allocReg cg1)))
          (let ((ar (regStr an)))
            (let ((cg2 (emitLine cg1 (cat4 (cat3 (cat2 "  " ar)
                                                 " = getelementptr i64, ptr "
                                                 pr)
                                           ", i64 "
                                           (fmtInt idx)
                                           ""))))
              (emitLine cg2 (cat4 "  store i64 "
                                  val
                                  ", ptr "
                                  ar)))))))))

; MM-LIFE-2c event 6: a block's REFERENCE fields are stored owned -
; a borrowed value is retained on the way in, a directly-built
; construction MOVES (its birth count IS the field's share; a retain
; would double-count). The classification mirrors ctorShapeEmit
; exactly: the retain set and the shape word's map must agree, or
; the walk at death returns counts the stores never took. Retains
; here are BALANCED by construction: the cell's own map walks these
; fields when it dies. tyvar fields with a symbolic witness retain
; under the same evidence-bit guard the shape store uses.
(pub :: argIsDirectCon (-> Int Int Int))
(pub fn (argIsDirectCon cg an)
  (let ((tg (nodeTag an)))
    (if (== tg TAG_E_STRUCTCON)
        1
    (if (== tg TAG_E_LAM)
        1
    (if (== tg TAG_E_APP)
        (let ((h (spineHead an)))
          (if (!= (nodeTag h) TAG_E_VAR)
              0
              (if (!= (lookupType (memGetWord cg 3) (nodeA h)) 0) 1 0)))
        0)))))

; the innermost head of an application spine (codegen's own walk;
; the checker's spineHead lives in another module)
; -1 = no retain, 1 = unconditional, k>=0 encoded as 2+k = evidence
; bit k - the same per-field answer ctorShapeEmit derives
(pub :: fieldRetainCode (-> Int Int Int Int Int))
(pub fn (fieldRetainCode cg entry stamp j)
  (let ((kind (eKind entry)))
    (let ((tn (if (== kind TF_DATA)
                  (let ((ftys (eFieldTys entry)))
                    (if (== ftys 0)
                        0
                        (if (< j (vecLen ftys)) (vecGet ftys j) 0)))
                  (let ((fs (eFieldFlags entry)))
                    (if (< j (vecLen fs)) (nodeTy (vecGet fs j)) 0)))))
      (if (== tn 0)
          (- 0 1)
          (if (== (tyIsSrcVar tn) 1)
              (if (== stamp 0)
                  (- 0 1)
                  (let ((vars vecNew))
                    {
                      (if (== kind TF_DATA)
                          (cgSigVarsVec (eFieldTys entry) vars)
                          0)
                      (let ((vi (strVecIdx vars (nodeA tn))))
                        (if (if (< vi 0)
                                true
                                (>= vi (vecLen (nodeB stamp))))
                            (- 0 1)
                            (let ((wv (cast Int (vecGet (nodeB stamp) vi))))
                              (if (== wv 1)
                                  1
                                  (if (>= wv 2) wv (- 0 1))))))
                    }))
              (if (== (fldClass cg tn) 2) 1 (- 0 1)))))))

(pub :: emitFieldStores (-> Int String Int Int Int Int Int Int))
(pub fn (emitFieldStores cg ptr args i base entry stamp)
  (if (>= i (vecLen args)) cg
      (let ((argNode (vecGet args i)))
        (let ((cg1 (emitExpr argNode cg)))
          (let ((reg (strDup (memGetWord cg1 2))))
            (let ((rc (if (== (argIsDirectCon cg1 argNode) 1)
                          (- 0 1)
                          (fieldRetainCode cg1 entry stamp i))))
              (let ((cgR (if (== rc 1)
                             (emitRetainOf cg1 reg)
                             (if (>= rc 2)
                                 (emitRetainIfEvBit cg1 reg (- rc 2))
                                 cg1))))
                (let ((cgS (storeWordAt cgR ptr (+ base i) reg)))
                  ; an owned temporary stored with an unconditional
                  ; retain has handed its share to the field: release
                  ; the one it arrived with (a direct construction
                  ; MOVED, and answered rc -1 above)
                  (let ((cgT (if (&& (== rc 1) (== (valueOwnedRef cgS argNode) 1))
                                 (emitReleaseOf cgS reg)
                                 cgS)))
                    (emitFieldStores cgT ptr args (+ i 1) base entry stamp))))))))))

; ------------------------------------------------------------------
; E_Let / E_If / E_Begin.
; ------------------------------------------------------------------
(pub :: emitLet (-> Int Int Int))
(pub fn (emitLet node cg)
  (emitLetAt node cg 0))

; `tail` is 1 when the let itself sits in tail position, so its body
; does too and a borrowed leaf there gets event 2's retain.
(pub :: emitLetAt (-> Int Int Int Int))
(pub fn (emitLetAt node cg tail)
  (let ((name (nodeA node))
        (valExpr (nodeB node))
        (body (nodeC node)))
    (let ((cg1 (emitExpr valExpr cg)))
      ; The binding remembers whether its initialiser was a float, so a
      ; later `(+ x ...)` on the bound name picks the right instruction.
      ; And it ends with its body: without the restore, a shadowing
      ; binding's register - possibly defined in a branch block that
      ; does not dominate later uses - kept resolving the name after
      ; the `let` was over.
      (let ((valReg (strDup (memGetWord cg1 2)))
            (valFlag (memGetWord cg1 14))
            (mark (symMark cg1)))
        (bindSym cg1 name valReg valFlag 0)
        ; a `let` of a REFERENCE FIELD read takes its own share, when
        ; the walk says the binding does not escape: the field's share
        ; is the block's, and a store to the field (event 5) releases
        ; the old value under a borrowed alias - `(let ((t r.name))
        ; { (set r.name new) (println t) })` read freed bytes. The
        ; share is handed back at scope end like an owned value's.
        (let ((fieldAlias (if (&& (== (nodeTag valExpr) TAG_E_FIELD)
                                  (&& (== (fieldReadIsScalar cg1 valExpr) 0)
                                      (== (escapes cg1 name body 1 body) 0)))
                              1
                              0)))
        (let ((cg1 (if (== fieldAlias 1) (emitRetainOf cg1 valReg) cg1)))
        (let ((releasable (if (== fieldAlias 1) 1 (letReleasable cg1 valExpr name body))))
        (let ((pmark (vecLen (memGetWord cg1 42))))
        {
          ; a releasable binding is PENDING while its body emits: a
          ; self tail call inside the body jumps back to the loop
          ; header and never reaches the scope end, so `emitTailJump`
          ; pays every pending share before the jump
          (if (== releasable 1) (vecPush (memGetWord cg1 42) (cast Int valReg)) 0)
          (let ((cgB (if (== tail 1) (emitExprTail body cg1) (emitExpr body cg1))))
            {
              (memSetWord (memGetWord cgB 42) 0 pmark)
              (symRestore cgB mark)
              ; MM-LIFE-2c event 3. The release goes HERE - at the
              ; binding's scope end, in the block that defines its
              ; register - rather than before the function's `ret`,
              ; because a `let` inside a branch defines a register that
              ; does not dominate the return. Not when the body ended
              ; in a jump: that block is terminated, the jump path has
              ; already paid, and an instruction after a terminator is
              ; not LLVM.
              (if (&& (== releasable 1) (!= (memGetWord cgB 31) 1))
                  (let ((res (strDup (memGetWord cgB 2)))
                        (cgR (emitReleaseOf cgB valReg)))
                    {
                      (memSetWord cgR 2 res)
                      cgR
                    })
                  cgB)
            })
        }))))))))

; Is this `let` binding one the frame may release when its scope ends?
;
; Two conditions, and both are syntactic on purpose - MM-LIFE-2c's
; events 2 and 3 are stated over an escape analysis this compiler does
; not have, and what it does have is a shape whose answer needs none.
;
;   the INITIALISER is a direct construction, so the binding holds the
;   block's birth share and no one else's - the same predicate the
;   statement-position release already spends (`argIsDirectCon`);
;
;   the NAME does not reach the let's VALUE - not bare, and not
;   through a field of the block either. A field that is itself a
;   reference took its own share at construction (event 6), but that
;   share belongs to the BLOCK: the block's death walks its map and
;   hands every one of them back, so a field read in value position
;   aliases memory the release is about to free. This condition used
;   to admit field reads on the ground that "a read answers a field,
;   never the block", and the QA sweep measured what that admitted:
;
;     (fn (mk tag) (let ((b (Mk (strConcat "id-" tag)))) (match b ((Mk s) s))))
;     (println (mk "one"))      -> six NUL bytes, not `id-one`
;
;   The destructured `s` was returned, the block was released first,
;   its map released the string, and the caller read the allocator's
;   scrub through a dangling reference. `b.f` in value position and
;   `(let ((t b.f)) t)` were the same defect in two more spellings.
;   `escapes` now treats a field read whose base mentions the name,
;   and a match binder destructured from it, as the name itself.
;
; The second condition is decided by a walker that defaults to ESCAPES:
; a tag it does not recognise answers 1, so widening the surface is a
; deliberate edit rather than an omission. That is the direction that
; leaks rather than the one that frees early, which is the asymmetry
; this whole strategy turns on.
(pub :: letReleasable (-> Int Int String Int Int))
(pub fn (letReleasable cg valExpr name body)
  (if (!= (letOwned cg valExpr) 1)
      0
      (if (== (escapes cg name body 1 body) 1) 0 1)))

; Does this frame OWN the binding's value - hold a share nobody else
; handed it?
;
; Two ways, and they are the two ways a share is created. A DIRECT
; CONSTRUCTION is born at count 1 and that birth is the binding's. A
; CALL to a function whose declared result is a reference hands back a
; share, because MM-LIFE-2c's event 2 retains a reference result
; before returning it - which is why the two events are one commit:
; each is unsound without the other, event 2 leaking on every call and
; event 3 freeing the caller's value.
;
; Anything else - a parameter, a bare name, a field read - is BORROWED,
; and a borrowed value is never released here. That is the leak side of
; the asymmetry, taken deliberately.
(pub :: letOwned (-> Int Int Int))
(pub fn (letOwned cg valExpr)
  (valueOwnedRef cg valExpr))



; Could the binding OUTLIVE this frame through `e`?
;
; Positional, because the answer depends on where the name stands. In
; VALUE position - the expression whose value the `let` answers - a
; bare mention escapes, because that value flows to the caller with no
; share taken. In STATEMENT position, and in ARGUMENT position of a
; call that is not itself the value, it does not: a callee borrows
; (event 1), and every store a callee can make takes a share (a field
; store by event 5, a constructor field by event 6, a container or any
; other word store through `memSetWord`, which retains by MM-LIFE-2g).
;
; What a callee KEEPS or ANSWERS is decided by the callee's own flow
; masks (`inferFlows`, `callEscapesArg`): an argument mentioning the
; binding escapes when the callee stashes that parameter - parks it
; uncounted through a `cast` into a word field, a slot, a raw store,
; a capture, or a stashing callee - and, in VALUE position, when the
; callee's result is a word that may be part of it. A callee whose
; result is a counted reference answers a share of its own (event 2,
; `borrowedTailLeaves`), so `(fn (ident s) s)` hands back a retained
; `s` and the argument's share is untouched. Only a GLOBAL with a
; signature has masks: a parameter or local named like one, bound
; outside the let (the symbol table still holds it) or inside its
; body (`boundWithin`), is a function value nothing signed, as is the
; binding itself applied, and every argument it is given escapes. A
; field of the block that is itself a reference, in value position,
; and a `match` binder - a field under another name - are the block
; too (`letReleasable` carries the measurement).
;
; Three shapes escape whatever their position, and each is a place the
; invariant above does not reach:
;
;   a LAMBDA that mentions it - a capture takes no share, deliberately
;     (MM-VAL-15: nothing releases a binding, so nothing may free one
;     out from under a closure);
;   a `set` RHS - a slot store takes no share;
;   `cast`, `__addr` and `strData` - the three ways to get a WORD out
;     of a reference. A word stashed anywhere is invisible to counting
;     by construction (MM-LIFE-2g's own stated limit), so a binding
;     that reaches one of them is the program's to keep alive.
;
; Every tag this walk does not know answers ESCAPE, so the surface
; widens by deliberate edit and never by omission.
(pub :: escapes (-> Int String Int Int Int Int))
(pub fn (escapes cg name e vp root)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR) (== tg TAG_E_CHAR))))
            0
        (if (== tg TAG_E_VAR)
            (if (strEq (nodeA e) name) vp 0)
        (if (== tg TAG_E_FIELD)
            ; a field READ answers the field - which the block owns, so
            ; in VALUE position reading a REFERENCE field of the
            ; binding is the binding escaping (see `letReleasable`); a
            ; machine-scalar field cannot alias the block and its read
            ; still releases; in argument position the callee borrows
            ; the field as it would the block
            (if (== (escapes cg name (nodeA e) 0 root) 1)
                1
                (if (&& (== vp 1) (== (mentions name (nodeA e)) 1))
                    (if (== (fieldReadIsScalar cg e) 1) 0 1)
                    0))
        (if (== tg TAG_E_APP)
            (if (== (wordTakingHead (spineHead e)) 1)
                ; `cast`/`__addr`/`strData` of the binding hands out a
                ; word, and a word takes no share: in VALUE position
                ; the word is the let's value and the binding escapes;
                ; in argument position its consumer decides - a call
                ; by its masks in the word's form, a raw store, a
                ; constructor's word field, a `set` - and the operands
                ; are walked for what they contain
                (if (== vp 1)
                    (mentions name e)
                    (if (== (escapes cg name (nodeA e) 0 root) 1)
                        1
                        (escapes cg name (nodeB e) 0 root)))
                ; a CALL keeps or answers an argument only as its
                ; flow masks say (`callEscapesArg`); otherwise a
                ; callee borrows, and the arguments are walked in
                ; argument position
                (if (== (callEscapesArg cg e name vp root) 1)
                    1
                    ; arithmetic and `&&`/`||` answer an operand's
                    ; word: `(+ (asWord s) 0)` in value position is
                    ; `(asWord s)` in value position
                    (let ((vp2 (if (== (passesValueHead (spineHead e)) 1) vp 0)))
                      (if (== (escapes cg name (nodeA e) vp2 root) 1)
                          1
                          (escapes cg name (nodeB e) vp2 root)))))
        (if (== tg TAG_E_IF)
            (if (== (escapes cg name (nodeA e) 0 root) 1)
                1
                (if (== (escapes cg name (nodeB e) vp root) 1)
                    1
                    (escapes cg name (nodeC e) vp root)))
        (if (== tg TAG_E_BEGIN)
            (escapesSeq cg name (nodeA e) vp 0 root)
        (if (== tg TAG_E_MATCH)
            ; the arms' binders are the scrutinee's fields, owned by
            ; the block exactly as a field read's answer is: when the
            ; scrutinee mentions the binding, a binder reaching the
            ; match's value is the binding reaching it
            (if (== (escapes cg name (nodeA e) 0 root) 1)
                1
                (if (== (escapesArms cg name (nodeB e) vp 0 root) 1)
                    1
                    (if (== (mentions name (nodeA e)) 1)
                        (escapesViaBinders cg (nodeB e) vp 0 root)
                        0)))
        (if (== tg TAG_E_COND)
            (if (== (escapesCondTests cg name (nodeA e) root 0) 1)
                1
                (if (== (escapesArms cg name (nodeA e) vp 0 root) 1)
                    1
                    (escapes cg name (nodeB e) vp root)))
        (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            ; the initialiser inherits the position: `(let ((t s)) t)`
            ; makes the binding the let's value through an alias - and
            ; an alias that may hold (part of) the block is then asked
            ; the same question under its own name, in the same
            ; position, so `(let ((t s)) (set r t))` in a statement is
            ; seen for the stash it is. An initialiser that can only
            ; be a machine word - an operator's answer, a scalar
            ; field - aliases nothing and is exempt.
            ; The initialiser is walked in ARGUMENT position: it is
            ; not the let's value, its binder is, and the alias step
            ; below carries whatever reaches the binder on to the
            ; body - `(let ((t b.f)) t)` escapes through `t`, while
            ; `(let ((t b.f)) (strLen t))` no longer does.
            (if (== (escapes cg name (nodeB e) 0 root) 1)
                1
                (if (== (escapes cg name (nodeC e) vp root) 1)
                    1
                    (if (== (mayAlias cg name (nodeB e) root) 1)
                        (escapes cg (nodeA e) (nodeC e) vp root)
                        0)))
        (if (== tg TAG_E_WHILE)
            (if (== (escapes cg name (nodeA e) 0 root) 1)
                1
                (escapesSeq cg name (nodeB e) 0 0 root))
        (if (== tg TAG_E_SET)
            ; a slot store takes no share - of what REACHES the slot:
            ; the binding itself, a word of it, not a length or a sum
            ; computed from it (`(set k (strLen s))` beside a self
            ; tail call kept every iteration's string). And the value
            ; is walked in argument position for what it PARKS on the
            ; way: a lambda capturing the binding, a constructor's
            ; word field, a callee that stashes it
            (if (!= (bindingFlow cg name (nodeB e)) 0)
                1
                (escapes cg name (nodeB e) 0 root))
        (if (== tg TAG_E_SETF)
            ; `(set b.f v)` retains v into a REFERENCE field (event 5),
            ; so the base is a borrow and the value walks in argument
            ; position; a WORD field takes a `cast`, which parks the
            ; value uncounted - that mention escapes
            (if (== (escapes cg name (nodeA e) 0 root) 1)
                1
                (if (== (fieldReadIsScalar cg e) 1)
                    (mentions name (nodeC e))
                    (escapes cg name (nodeC e) 0 root)))
            (mentions name e))))))))))))))))

(pub :: escapesSeq (-> Int String Int Int Int Int Int))
(pub fn (escapesSeq cg name v vp i root)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (if (== (escapes cg name (vecGet v i)
                           (if (== i (- (vecLen v) 1)) vp 0) root) 1)
              1
              (escapesSeq cg name v vp (+ i 1) root)))))

; A match arm or cond clause: word 2 is the body, and it inherits the
; position. An arm PATTERN cannot mention an outer binding as a value.
(pub :: escapesArms (-> Int String Int Int Int Int Int))
(pub fn (escapesArms cg name v vp i root)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (if (== (escapes cg name (nodeB (vecGet v i)) vp root) 1)
              1
              (escapesArms cg name v vp (+ i 1) root)))))

; Does any arm's PATTERN BINDER escape through that arm's body? Each
; binder is a field of the scrutinee's block, so the question is the
; one `escapes` asks of the binding itself, asked of the binder in the
; match's own position: bare in value position, a field of it in
; value position, destructured again by an inner match, handed to a
; call whose answer is the match's value - and, in ANY position, a
; `set` RHS or a lambda capture, which is why this runs for a match in
; statement position too (`(match b ((Mk s) (set r s)))` stashed a
; reference the walker never looked at). A pattern shape this walk
; cannot enumerate binders for answers ESCAPE, the walker's rule.
(pub :: escapesViaBinders (-> Int Int Int Int Int Int))
(pub fn (escapesViaBinders cg arms vp i root)
  (if (== arms 0)
      0
      (if (>= i (vecLen arms))
          0
          (let ((arm (vecGet arms i)))
            (let ((bs (patBindersCg (nodeA arm) vecNew)))
              (if (== bs 0)
                  1
                  (if (== (escapesAny cg bs (nodeB arm) vp 0 root) 1)
                      1
                      (escapesViaBinders cg arms vp (+ i 1) root))))))))

(pub :: escapesAny (-> Int Int Int Int Int Int Int))
(pub fn (escapesAny cg names body vp i root)
  (if (>= i (vecLen names))
      0
      (if (== (escapes cg (vecGet names i) body vp root) 1)
          1
          (escapesAny cg names body vp (+ i 1) root))))

; Could a `let` initialiser that mentions `name` hand the new binder
; a reference into the block? Anything that mentions it may, except
; the shapes that can only answer a word: a literal, an operator or
; primitive applied to anything, and a read of a scalar field.
(pub :: mayAlias (-> Int String Int Int Int))
(pub fn (mayAlias cg name init root)
  (if (== (mentions name init) 0)
      0
      (let ((tg (nodeTag init)))
        (if (== tg TAG_E_APP)
            (if (== (passesValueHead (spineHead init)) 1)
                ; `(+ (asWord s) 0)` aliases what `(asWord s)` does
                (mayAliasArgs cg name init (spineArity init) root 0)
                (callEscapesArg cg init name 1 root))
            (if (== tg TAG_E_FIELD)
                (if (== (fieldReadIsScalar cg init) 1) 0 1)
                1)))))

(pub :: escapesCondTests (-> Int String Int Int Int Int))
(pub fn (escapesCondTests cg name cls root i)
  (if (== cls 0)
      0
      (if (>= i (vecLen cls))
          0
          (if (== (escapes cg name (nodeA (vecGet cls i)) 0 root) 1)
              1
              (escapesCondTests cg name cls root (+ i 1))))))

(pub :: mayAliasArgs (-> Int String Int Int Int Int Int))
(pub fn (mayAliasArgs cg name e n_ root i)
  (if (>= i n_)
      0
      (if (== (mayAlias cg name (spineArgAt e i) root) 1)
          1
          (mayAliasArgs cg name e n_ root (+ i 1)))))

; Does this call let `name` out of the frame? By the callee's own
; flow masks (`inferFlows`): an argument mentioning `name` escapes
; when the callee STASHES that parameter, and, in value position,
; when the callee's result is a word that may be (part of) it. A
; callee whose result is a counted reference answers a share of its
; own (event 2), so the argument's is untouched. Only a GLOBAL with a
; signature has masks: a parameter or local named like one - bound
; outside the let, where the symbol table still holds it, or inside
; its body, where only the text does (`boundWithin`) - is a function
; value nothing signed, as is the binding itself applied, and every
; argument it is given escapes. A raw store's value escapes; a
; constructor's arguments are judged below, field by field, by the
; walk (a word field takes a `cast`, which escapes on its own).
(pub :: callEscapesArg (-> Int Int String Int Int Int))
(pub fn (callEscapesArg cg e name vp root)
  (let ((hd (spineHead e))
        (n_ (spineArity e)))
    (if (!= (nodeTag hd) TAG_E_VAR)
        (mentionsArgs name e n_ 0)
        (let ((n (nodeA hd)))
          (if (strEq n name)
              (mentions name e)
          (if (|| (isBinop n) (|| (isCmpOp n) (isAndOr n)))
              0
          (if (isPrimName n)
              (if (&& (|| (strEq n "__store64") (strEq n "__store8")) (>= n_ 3))
                  (mentions name (spineArgAt e 2))
                  ; a function reached by address may keep what it is
                  ; handed
                  (if (strEq n "__call_word") (mentionsArgs name e n_ 0) 0))
          (if (|| (!= (lookupSym cg n) 0)
              (|| (>= (paramIndexOf cg n) 0) (== (boundWithin n root) 1)))
              (mentionsArgs name e n_ 0)
          (if (!= (findFSigCg cg (mangledForCg cg n)) 0)
              ; the STASH mask pairs by form - a word-form park counts
              ; a typed arrival (`__retainref`), a typed park does not
              ; catch a word - but the RET mask names what the RESULT
              ; aliases, and a word the callee answers of a parameter
              ; it cast aliases the typed argument just the same:
              ; `(fn (asWord s) (cast Int s))` handed back a pointer
              ; into a `let` this walk then released
              (argsEscapeByMask cg name e n_
                                (| (fnStashMask cg n)
                                   (if (&& (== vp 1) (!= (fnResultClass cg n) 2))
                                       (bothForms (fnRetMask cg n))
                                       0))
                                0)
              (let ((entry (lookupType (memGetWord cg 3) n)))
                (if (!= entry 0)
                    ; a constructor: a reference field retains what it
                    ; is given (event 6) and is walked in argument
                    ; position by the caller; a WORD field parks it,
                    ; and a word of the binding can arrive there
                    ; through any function, not only a visible `cast`
                    (ctorWordFieldsMention cg entry name e n_ 0)
                    ; an effect operation, or a name nothing signed
                    (mentionsArgs name e n_ 0))))))))))))

(pub :: passesValueHead (-> Int Int))
(pub fn (passesValueHead h)
  (if (!= (nodeTag h) TAG_E_VAR)
      0
      (if (|| (isBinop (nodeA h))
          (|| (isAndOr (nodeA h))
          (|| (strEq (nodeA h) "__load64") (strEq (nodeA h) "memGetWord"))))
          ; a 64-bit load answers a word of what its address aliases
          1
          0)))

(pub :: ctorWordFieldsMention (-> Int Int String Int Int Int Int))
(pub fn (ctorWordFieldsMention cg entry name e n_ i)
  (if (>= i n_)
      0
      (let ((tn (fieldTypeNode entry i)))
        (if (&& (== (ctorFieldParks cg entry e tn i) 1)
                (== (mentions name (spineArgAt e i)) 1))
            1
            (ctorWordFieldsMention cg entry name e n_ (+ i 1))))))

; Does field i of this construction PARK what it is given - take no
; share? A word field does; so does a type-variable field at a site
; whose witness collapsed to "no retain" (`fieldRetainCode` -1): the
; emitter stores the value uncounted there, whatever the field's
; declaration says. The stamp sits on the constructor's name node.
(pub :: ctorFieldParks (-> Int Int Int Int Int Int))
(pub fn (ctorFieldParks cg entry e tn i)
  (if (== tn 0)
      1
      (if (== (fldClass cg tn) 0)
          1
          (if (== (fldClass cg tn) 1)
              (if (== (fieldRetainCode cg entry (memGetWord (spineHead e) 6) i) (- 0 1)) 1 0)
              0))))

(pub :: mentionsArgs (-> String Int Int Int Int))
(pub fn (mentionsArgs name e n_ i)
  (if (>= i n_)
      0
      (if (== (mentions name (spineArgAt e i)) 1)
          1
          (mentionsArgs name e n_ (+ i 1)))))

; An argument carrying the binding escapes by the half of the mask
; that matches the FORM it carries it in: typed by the arrival half,
; laundered to a word by the word half (`bindingFlow`).
(pub :: argsEscapeByMask (-> Int String Int Int Int Int Int))
(pub fn (argsEscapeByMask cg name e n_ mask i)
  (if (>= i n_)
      0
      (let ((f (bindingFlow cg name (spineArgAt e i))))
        (if (|| (&& (!= (& mask (| (paramBit i) (ownerBit i))) 0) (!= f 0))
                (&& (!= (& mask (wordBit i)) 0) (!= (wordParts f) 0)))
            1
            (argsEscapeByMask cg name e n_ mask (+ i 1))))))

; How the binding's reference may reach the VALUE of `e`, in either
; form - `flowMask` with the binding as the one "parameter", so a
; scalar computed from it (`(strLen a)`, `(+ acc (strLen x))`)
; carries nothing and a word of it (`(cast Int a)`, `(strData a)`)
; carries it laundered. A bare `mentions` made `(fmtInt (strLen a))`
; an escape of `a`.
(pub :: bindingFlow (-> Int String Int Int))
(pub fn (bindingFlow cg name e)
  (let ((ps vecNew))
    { (vecPush ps (cast Int name))
      (flowMask cg e ps vecNew) }))

; Does anything under `e` BIND `name` - a `let`, a lambda parameter,
; a match binder? Mirrors `mentions`, for binders instead of
; references; an unknown tag answers 1, the direction that trusts no
; signature.
(pub :: boundWithin (-> String Int Int))
(pub fn (boundWithin name e)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR)
            (|| (== tg TAG_E_CHAR) (== tg TAG_E_VAR)))))
            0
        (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            (if (strEq (nodeA e) name)
                1
                (if (== (boundWithin name (nodeB e)) 1)
                    1
                    (boundWithin name (nodeC e))))
        (if (== tg TAG_E_LAM)
            (if (== (strInVecCg (nodeA e) name 0) 1)
                1
                (boundWithin name (nodeB e)))
        (if (== tg TAG_E_MATCH)
            (if (== (boundWithin name (nodeA e)) 1)
                1
                (boundWithinArms name (nodeB e) 0))
        (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
            (if (== (boundWithin name (nodeA e)) 1)
                1
                (if (== (boundWithin name (nodeB e)) 1)
                    1
                    (boundWithin name (nodeC e))))
        (if (== tg TAG_E_SETF)
            (if (== (boundWithin name (nodeA e)) 1) 1 (boundWithin name (nodeC e)))
        (if (== tg TAG_E_FIELD)
            (boundWithin name (nodeA e))
        (if (== tg TAG_E_SET)
            (boundWithin name (nodeB e))
        (if (|| (== tg TAG_E_BEGIN) (== tg TAG_E_COND))
            (boundWithinVec name (nodeA e) 0)
        (if (== tg TAG_E_WHILE)
            (if (== (boundWithin name (nodeA e)) 1)
                1
                (boundWithinVec name (nodeB e) 0))
            1)))))))))))))

(pub :: boundWithinVec (-> String Int Int Int))
(pub fn (boundWithinVec name v i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (if (== (boundWithin name (vecGet v i)) 1)
              1
              (boundWithinVec name v (+ i 1))))))

; An arm binds its pattern's names; a cond clause binds nothing, and
; its word 1 is a condition `boundWithin` walks like any expression.
(pub :: boundWithinArms (-> String Int Int Int))
(pub fn (boundWithinArms name v i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (let ((arm (vecGet v i)))
            (let ((bs (patBindersCg (nodeA arm) vecNew)))
              (if (== bs 0)
                  1
                  (if (== (strInVecCg bs name 0) 1)
                      1
                      (if (== (boundWithin name (nodeB arm)) 1)
                          1
                          (boundWithinArms name v (+ i 1))))))))))

(pub :: strInVecCg (-> Int String Int Int))
(pub fn (strInVecCg v name i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (if (strEq (cast String (vecGet v i)) name)
              1
              (strInVecCg v name (+ i 1))))))

; The result type at the end of a signature's arrow spine, or 0.
(pub :: sigResultTy (-> Int Int))
(pub fn (sigResultTy ty)
  (if (== ty 0)
      0
      (if (== (nodeTag ty) TAG_T_ARR)
          (sigResultTy (nodeB ty))
          ty)))

; Is this field read's declared type a machine scalar - `fldClass` 0?
; Resolved exactly as `emitField` will resolve it, through the
; checker's stamp; a data constructor's named field, an unstamped
; node, or an unclassifiable type answers 0, which the walker reads
; as "may be a reference" - the leak direction.
(pub :: fieldReadIsScalar (-> Int Int Int))
(pub fn (fieldReadIsScalar cg e)
  (let ((fi (resolveStructField (memGetWord cg 3) e)))
    (if (== fi 0)
        0
        (if (== (nodeC fi) 0)
            0
            (if (== (fldClass cg (nodeC fi)) 0) 1 0)))))


; The names a pattern binds, or 0 for a pattern shape this does not
; know - the checker's `patBinders`, with the refusal added, plus the
; two shapes the emitter's own `emitPatMatch` dispatches that the
; checker's walk predates: `(Nil)` binds nothing, and a NAMED
; constructor pattern binds whatever its reordered spine would. `_`
; and `true`/`false` are names nobody references, so listing them
; costs nothing.
(pub :: patBindersCg (-> Int Int Int))
(pub fn (patBindersCg pat acc)
  (if (== pat 0)
      acc
      (let ((tag (nodeTag pat)))
        (if (|| (== tag TAG_E_INT)
            (|| (== tag TAG_E_FLT)
            (|| (== tag TAG_E_STR)
            (|| (== tag TAG_E_CHAR) (== tag TAG_P_CON0)))))
            acc
        (if (== tag TAG_E_VAR)
            { (vecPush acc (nodeA pat)) acc }
        (if (== tag TAG_E_APP)
            (if (== (patBindersCg (nodeB pat) acc) 0)
                0
                (patBindersCgHead (nodeA pat) acc))
        (if (== tag TAG_P_CONNAMED)
            (patBindersCgVec (nodeC pat) acc 0)
        0)))))))

(pub :: patBindersCgHead (-> Int Int Int))
(pub fn (patBindersCgHead pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
      (if (== (patBindersCg (nodeB pat) acc) 0)
          0
          (patBindersCgHead (nodeA pat) acc))
      acc))

(pub :: patBindersCgVec (-> Int Int Int Int))
(pub fn (patBindersCgVec subs acc i)
  (if (== subs 0)
      acc
      (if (>= i (vecLen subs))
          acc
          (if (== (patBindersCg (vecGet subs i) acc) 0)
              0
              (patBindersCgVec subs acc (+ i 1))))))

; Does `name` appear anywhere below `e` at all? The answer for the
; shapes that take no share, where position stops mattering. Unknown
; tags answer 1: not knowing a node's children is not knowing whether
; the name is under it.
(pub :: mentions (-> String Int Int))
(pub fn (mentions name e)
  (if (== e 0)
      0
      (let ((tg (nodeTag e)))
        (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR) (== tg TAG_E_CHAR))))
            0
        (if (== tg TAG_E_VAR)
            (if (strEq (nodeA e) name) 1 0)
        (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
            (if (== (mentions name (nodeA e)) 1)
                1
                (if (== (mentions name (nodeB e)) 1)
                    1
                    (mentions name (nodeC e))))
        ; a binding's word 1 is its NAME, a String, not a node: walked
        ; as one, a name whose length matched a tag followed its data
        ; pointer into the bytes
        (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            (if (== (mentions name (nodeB e)) 1)
                1
                (mentions name (nodeC e)))
        ; a field store's word 2 is the field NAME, a String - walking
        ; it as a node read its length as a tag and followed its data
        ; pointer (a 5- or 8-byte name dressed as a lambda or a block),
        ; which is how `(set r.label ...)` beside a mention of the
        ; binding took the compiler down with SIGSEGV
        (if (== tg TAG_E_SETF)
            (if (== (mentions name (nodeA e)) 1) 1 (mentions name (nodeC e)))
        (if (== tg TAG_E_FIELD)
            (mentions name (nodeA e))
        (if (== tg TAG_E_SET)
            (mentions name (nodeB e))
        (if (== tg TAG_E_BEGIN)
            (mentionsVec name (nodeA e) 0)
        (if (== tg TAG_E_COND)
            (if (== (mentionsVec name (nodeA e) 0) 1) 1 (mentions name (nodeB e)))
        (if (== tg TAG_E_MATCH)
            (if (== (mentions name (nodeA e)) 1)
                1
                (mentionsArms name (nodeB e) 0))
        (if (== tg TAG_E_WHILE)
            (if (== (mentions name (nodeA e)) 1)
                1
                (mentionsVec name (nodeB e) 0))
        (if (== tg TAG_E_LAM)
            ; a capture takes no share, so any mention counts
            (mentions name (nodeB e))
            1)))))))))))))))

(pub :: mentionsVec (-> String Int Int Int))
(pub fn (mentionsVec name v i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (if (== (mentions name (vecGet v i)) 1)
              1
              (mentionsVec name v (+ i 1))))))

(pub :: mentionsArms (-> String Int Int Int))
(pub fn (mentionsArms name v i)
  (if (== v 0)
      0
      (if (>= i (vecLen v))
          0
          (if (== (mentions name (nodeB (vecGet v i))) 1)
              1
              (mentionsArms name v (+ i 1))))))

; The three heads that hand a WORD out of a reference. A word takes no
; share and nothing can give it one, so a binding that reaches any of
; them is the program's to keep alive (MM-LIFE-2g states the same limit
; for the store side).
(pub :: wordTakingHead (-> Int Int))
(pub fn (wordTakingHead h)
  (if (!= (nodeTag h) TAG_E_VAR)
      0
      (if (|| (strEq (nodeA h) "cast")
          (|| (strEq (nodeA h) "__addr")
          (|| (strEq (nodeA h) "strData")
              (strEq (nodeA h) "strOwner"))))
          1
          0)))
; Every `alloca` of a function sits in its ENTRY block. An alloca in
; a body block is legal LLVM and allocates each time the block runs:
; a `mut` binding inside a self-tail-call loop grew the frame by a
; word per iteration and overflowed the stack at `--opt 0` (mem2reg
; hid it above that), and was the reason a `let` body was not a tail
; position. The function emitter leaves a blank line after its header
; (`openAllocaMark`), `emitAlloca` collects, and `closeAllocaMark`
; splices the collected allocas into that line before the `ret`.
(pub :: openAllocaMark (-> Int Int))
(pub fn (openAllocaMark cg)
  (let ((cgM (emitLine cg "")))
    {
      (memSetWord cgM 43 (- (vecLen (memGetWord cgM 0)) 1))
      (memSetWord cgM 44 vecNew)
      cgM
    }))

(pub :: emitAlloca (-> Int String Int))
(pub fn (emitAlloca cg ar)
  (if (< (memGetWord cg 43) 0)
      (emitLine cg (cat2 (cat2 "  " ar) " = alloca i64"))
      { (vecPush (memGetWord cg 44) (cast Int (cat2 (cat2 "  " ar) " = alloca i64"))) cg }))

(pub :: closeAllocaMark (-> Int Int))
(pub fn (closeAllocaMark cg)
  (let ((mark (memGetWord cg 43)))
    (if (< mark 0)
        cg
        (let ((hoisted (memGetWord cg 44)))
          {
            (if (> (vecLen hoisted) 0)
                (vecSet (memGetWord cg 0) mark (cast Int (joinAllocas hoisted)))
                0)
            (memSetWord cg 43 (- 0 1))
            (memSetWord cg 44 vecNew)
            cg
          }))))

; One buffer of the exact size, not a recursive concatenation: 40,000
; `mut` bindings in one function joined in 11.6 s by the suffix-
; copying form (quadratic, and one frame per binding)
(pub :: joinAllocas (-> Int String))
(pub fn (joinAllocas v)
  (let ((n (vecLen v)))
    (if (== n 0)
        ""
        (let ((out (strAlloc (joinAllocasSize v 0 0)))
              (mut j 0)
              (mut off 0))
          {
            (while (< j n)
              (let ((line (cast String (vecGet v j))))
                {
                  (if (> j 0) { (__store8 (strData out) off 10) (set off (+ off 1)) } 0)
                  (memCopy (+ (strData out) off) (strData line) (strLen line))
                  (set off (+ off (strLen line)))
                  (set j (+ j 1))
                }))
            out
          }))))

(pub :: joinAllocasSize (-> Int Int Int Int))
(pub fn (joinAllocasSize v i acc)
  (if (>= i (vecLen v))
      (+ acc (if (> (vecLen v) 1) (- (vecLen v) 1) 0))
      (joinAllocasSize v (+ i 1) (+ acc (strLen (cast String (vecGet v i)))))))

; A mutable binding: the initialiser's value goes into an alloca, the
; name binds the alloca (kind 1), and reads load.
(pub :: emitLetM (-> Int Int Int))
(pub fn (emitLetM node cg) (emitLetMAt node cg 0))

(pub :: emitLetMAt (-> Int Int Int Int))
(pub fn (emitLetMAt node cg tail)
  (let ((name (nodeA node))
        (valExpr (nodeB node))
        (body (nodeC node)))
    (let ((cg1 (emitExpr valExpr cg)))
      (let ((valReg (strDup (memGetWord cg1 2)))
            (valFlag (memGetWord cg1 14))
            (mark (symMark cg1))
            (an (allocReg cg1)))
        (let ((ar (cat2 "%s." (fmtInt an))))
          {
            (emitAlloca cg1 ar)
            (emitLine cg1 (cat4 "  store i64 " valReg ", ptr " ar))
            (bindSym cg1 name ar valFlag 1)
            (let ((cgB (if (== tail 1) (emitExprTail body cg1) (emitExpr body cg1))))
              {
                (symRestore cgB mark)
                cgB
              })
          })))))

; `(set name v)` stores into the binding's alloca and evaluates to `v`,
; matching stage0. A target with no storage - unbound, immutable, or a
; parameter - is refused loudly; stage0 rejects it as AX3012 and this
; compiler has no diagnostic channel subtler than dying.
(pub :: emitSet (-> Int Int Int))
(pub fn (emitSet node cg)
  (let ((name (nodeA node))
        (valExpr (nodeB node)))
    (let ((storage (lookupSym cg name)))
      (if (== storage 0)
          (dieCodegenDiag "set target is not a mut binding: " name)
          (if (!= (lookupSymKind cg name) 1)
              (dieCodegenDiag "set target is not a mut binding: " name)
              (let ((cg1 (emitExpr valExpr cg)))
                (let ((v (strDup (memGetWord cg1 2))))
                  {
                    (emitLine cg1 (cat4 "  store i64 " v ", ptr " (strDup (cast String storage))))
                    (memSetWord cg1 2 v)
                    cg1
                  })))))))

; `while` is a real loop - a branch back to a condition block - and the
; whole form evaluates to 0: a loop that ran zero times has no last
; iteration to take a value from.
(pub :: emitWhile (-> Int Int Int))
(pub fn (emitWhile node cg)
  (let ((cnd (nodeA node))
        (body (nodeB node))
        (hn (allocReg cg))
        (bn (allocReg cg))
        (xn (allocReg cg)))
    (let ((hdrB (cat2 "label_" (fmtInt hn)))
          (bodyB (cat2 "label_" (fmtInt bn)))
          (exitB (cat2 "label_" (fmtInt xn))))
      (let ((_1 (emitLine cg (cat2 "  br label %" hdrB)))
            (_2 (emitLabel cg hdrB))
            (cgC (emitExpr cnd cg))
            (cr (strDup (memGetWord cgC 2)))
            (tn (allocReg cgC)))
        (let ((tr (regStr tn)))
          (let ((_3 (emitLine cgC (cat4 (cat2 "  " tr)
                                        " = icmp ne i64 "
                                        cr
                                        ", 0")))
                (_4 (emitLine cgC (cat4 (cat3 "  br i1 " tr ", label %")
                                        bodyB
                                        (cat2 ", label %" exitB)
                                        "")))
                (_5 (emitLabel cgC bodyB))
                (cgB (emitSeq body cgC 0))
                (_6 (emitLine cgB (cat2 "  br label %" hdrB)))
                (_7 (emitLabel cgB exitB)))
            {
              (memSetWord cgB 2 (constStr 0))
              (memSetWord cgB 14 0)
              cgB
            }))))))

(pub :: emitIf (-> Int Int Int))
(pub fn (emitIf node cg)
  (let ((testExpr (nodeA node))
        (thenExpr (nodeB node))
        (elseExpr (nodeC node))
        (cg1 (emitExpr testExpr cg))
        (testReg (strDup (memGetWord cg1 2)))
        (cmpN (allocReg cg1))
        (thenLbl (allocReg cg1))
        (elseLbl (allocReg cg1))
        (mergeLbl (allocReg cg1))
        (cmpR (regStr cmpN))
        (thenB (cat2 "label_" (fmtInt thenLbl)))
        (elseB (cat2 "label_" (fmtInt elseLbl)))
        (mergeB (cat2 "label_" (fmtInt mergeLbl)))
        (_1 (emitLine cg1 (cat4 (cat2 "  " cmpR)
                                " = icmp ne i64 "
                                testReg
                                ", 0")))
        (_2 (emitLine cg1 (cat4 (cat3 "  br i1 " cmpR ", label %")
                                thenB
                                (cat2 ", label %" elseB)
                                "")))
        (_3 (emitLabel cg1 thenB))
        (cg2 (emitExpr thenExpr cg1))
        (thenVal (strDup (memGetWord cg2 2)))
        ; A well-typed `if` yields the same type from both branches, so
        ; the then-branch's float-ness stands for the whole form.
        (thenFlag (memGetWord cg2 14))
        ; The block that actually reaches the merge, which is the last
        ; one this branch emitted - not the one it started in. A nested
        ; `if` leaves its own merge block current, and naming the outer
        ; label here made the phi list a predecessor that no longer
        ; branches to it.
        (thenPred (strDup (memGetWord cg2 11)))
        (_4 (emitLine cg2 (cat2 "  br label %" mergeB)))
        (_5 (emitLabel cg2 elseB))
        (cg3 (emitExpr elseExpr cg2))
        (elseVal (strDup (memGetWord cg3 2)))
        (elsePred (strDup (memGetWord cg3 11)))
        (_6 (emitLine cg3 (cat2 "  br label %" mergeB)))
        (_7 (emitLabel cg3 mergeB))
        (phiN (allocReg cg3))
        (phiR (regStr phiN))
        (_8 (emitLine cg3
              (cat4 (cat3 (cat2 "  " phiR)
                          " = phi i64 [ " thenVal)
                    (cat3 ", %" thenPred " ], [ ")
                    (cat3 elseVal ", %" elsePred)
                    " ]")))
        (_9 (memSetWord cg3 2 phiR))
        (_10 (memSetWord cg3 14 thenFlag)))
    cg3))

; Emit a block label and record it as the block now being written into.
(pub :: emitLabel (-> Int String Int))
(pub fn (emitLabel cg name)
  {
    (emitLine cg (cat2 name ":"))
    (memSetWord cg 11 (strDup name))
    cg
  })

(pub :: emitBegin (-> Int Int Int))
(pub fn (emitBegin node cg)
  (let ((exprs (nodeA node)))
    (emitSeq exprs cg 0)))

(pub :: emitSeq (-> Int Int Int Int))
; MM-LIFE-2c event 2, the sound subset: a DIRECTLY-BUILT construction
; discarded in statement position is released on the spot - its birth
; count is the only share (the stash audit proved co-owners exist for
; call results and locals, so only the syntactic direct-build shape
; releases in this slice; its fields were retained by event 6, so the
; walk hands their shares back correctly).
(pub fn (emitSeq exprs cg i)
  (if (>= i (vecLen exprs)) cg
      (let ((e (vecGet exprs i)))
        (let ((cg1 (emitExpr e cg)))
          ; Since 2026-08-21 the share handed back is any OWNED
          ; reference (`valueOwnedRef`) - a call to a
          ; reference-returning global included, now that event 2
          ; makes every such call answer one share - not only the
          ; syntactic direct construction.
          (let ((cg2 (if (if (>= (+ i 1) (vecLen exprs))
                             false
                             (== (valueOwnedRef cg1 e) 1))
                         (emitReleaseOf cg1 (strDup (memGetWord cg1 2)))
                         cg1)))
            (emitSeq exprs cg2 (+ i 1)))))))

; A bare string *is* a `Str`: it evaluates to the address of the static
; `{ len, bytes }` header emitted alongside its bytes, so the length is
; a compile-time constant and no `cstrLen` scan is needed. `__addr` is
; the way to reach the bytes underneath (see `emitPrimAddr`), and the
; two must not be confused - a header describing a header reads back
; the wrong length and the wrong bytes, silently.
(pub :: emitStrExpr (-> Int Int Int))
(pub fn (emitStrExpr node cg)
  (let ((id (internString cg (nodeA node)))
        (rn (allocReg cg)))
    (let ((r (regStr rn)))
      {
        ; Element 2 of the headered static (MM-LIFE-2b): the handle
        ; the program holds points AT the {len, bytes} pair, with the
        ; count/shape words physically at handle-16 like every heap
        ; block's.
        (emitLine cg (cat4 (cat2 "  " r)
                           " = ptrtoint ptr getelementptr inbounds ({ i64, i64, i64, ptr, i64 }, ptr @strhdr_"
                           (fmtInt id)
                           ", i64 0, i32 2) to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

(pub :: emitDefault (-> Int Int))
(pub fn (emitDefault cg)
  {
    (memSetWord cg 2 "0")
    (memSetWord cg 14 0)
    cg
  })
