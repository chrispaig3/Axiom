; codegen.ax — LLVM IR text emitter.
; Dependencies: core.ax, parser.ax, Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Vec)
(import Sys)
(import parser)

; ------------------------------------------------------------------
; Type registry: constructor/struct name -> arity, kind, tag.
; ------------------------------------------------------------------
; `rep` records the data type's representation, matching stage0's S1
; rule: 0 = boxed, 1 = all-nullary (every value is its immediate tag),
; 2 = mixed - nullary constructors are immediate tags while fieldful
; siblings are heap blocks, so a fieldful arm's tag read must first
; test `value < 4096` (no immediate reaches it, every heap address
; exceeds it) before loading word 0. An unconditional load there
; dereferences a small integer; treating every value as immediate
; makes a pointer fail every tag compare. The tag lives where the
; *constructor named at the site* says, plus that one runtime test
; for the fieldful-in-mixed case.
;
; `fieldFlags` is one 0/1 per field: is it declared `Float`. A pattern
; binder for that field carries the flag into the symbol table.
(pub struct TypeEntry (name : Int) (nameLen : Int) (nameHash : Int) (kind : Int) (arity : Int) (tag : Int) (rep : Int) (fieldFlags : Int))
(pub :: TF_DATA   Int) (pub fn (TF_DATA)   0)
(pub :: TF_STRUCT Int) (pub fn (TF_STRUCT) 1)
(pub :: eNameLen (-> Int Int)) (pub fn (eNameLen e) (memGetWord e 1))
(pub :: eNameHash (-> Int Int)) (pub fn (eNameHash e) (memGetWord e 2))
(pub :: eKind  (-> Int Int)) (pub fn (eKind  e) (memGetWord e 3))
(pub :: eArity (-> Int Int)) (pub fn (eArity e) (memGetWord e 4))
(pub :: eTag   (-> Int Int)) (pub fn (eTag   e) (memGetWord e 5))
(pub :: eRep     (-> Int Int)) (pub fn (eRep e)     (memGetWord e 6))
(pub :: eFieldFlags (-> Int Int)) (pub fn (eFieldFlags e) (memGetWord e 7))

; A length is not a name. This used to hash to `strLen` and match on
; (length, hash) alone, so every name of the same length was the same
; name: with a `(struct P ...)` in scope, `(+ a b)` found `P` in the type
; registry and was emitted as a struct construction. The length is kept
; as a cheap pre-filter, but equality is decided by comparing the bytes.
(pub :: nameHash (-> Int Int))
(pub fn (nameHash s)
  (strLen s))

(pub :: eName (-> Int Int)) (pub fn (eName e) (memGetWord e 0))

(pub :: addType (-> Int Int Int Int Int Int Int Int))
(pub fn (addType types name kind arity tag rep fieldFlags)
  (let ((nl (strLen name))
        (nh (nameHash name)))
    (vecPush types (cast Int (TypeEntry name nl nh kind arity tag rep fieldFlags)))))

(pub :: lookupType (-> Int Int Int))
(pub fn (lookupType types name)
  (lookupByIdx types name (strLen name) 0))

(pub :: lookupByIdx (-> Int Int Int Int Int))
(pub fn (lookupByIdx types name nLen i)
  (if (>= i (vecLen types))
      0
      (let ((e (vecGet types i)))
        (if (&& (== (eNameLen e) nLen) (strEq (eName e) name))
            e
            (lookupByIdx types name nLen (+ i 1))))))

(pub :: lookupTypeIn (-> Int Int Int Int))
(pub fn (lookupTypeIn types name i)
  (lookupType types name))

; ------------------------------------------------------------------
; CG state: output buffer + temp counter + last result + type registry.
; Field 0 = lines (Vec of Str)
; Field 1 = tmp (Int, register counter)
; Field 2 = result (Str, current result value)
; Field 3 = types (Vec of TypeEntry, constructor/struct registry)
; Field 4 = tagN (Int, next data constructor tag)
; Field 5 = argVec (Vec of Int, temp storage during EApp flattening)
; Field 6 = symnames (Vec of Int, symbol table — bound variable names)
; Field 7 = symregs (Vec of Int, symbol table — bound variable register strings)
; Field 8 = decls (Int, module declarations for re-scanning before emit)
; Field 9 = argsTyped (Str, argument list with a type before each entry)
;
; Two argument spellings are needed because LLVM writes the type once for
; a binary operator and once per operand for a call:
;
;     add i64 %a, %b          <- field 2, bare
;     call i64 @f(i64 %a, i64 %b)   <- field 9, typed
;
; Emitting the bare form into a call produced `call i64 @add(i64 40, 2)`,
; which `llc` rejects.
; ------------------------------------------------------------------
; Field 10 = strings (Vec of Str, the module's interned literals)
; Field 11 = curBlock (Str, the label currently being emitted into)
; Field 12 = mangleBares (Vec of Str, bare function names, see mangledFor)
; Field 13 = mangleFulls (Vec of Str, the symbol each bare name reaches)
;
; Floats are carried as the i64 of their IEEE-754 bits, so nothing about
; a *value* says it is a float - only the signatures do, and by emission
; time there is no type checker left to ask. Fields 14-18 are the
; reconstruction (the same one stage0's IR generator performs): what the
; signatures said, and the float-ness of the result currently in field 2,
; which is what decides `add` against `fadd` at each operator.
;
; Field 14 = resultIsFloat (Int 0/1, float-ness of field 2's value)
; Field 15 = floatSigs (Vec of FSig, per-function arrow-position flags)
; Field 16 = symfloats (Vec of 0/1, parallel to fields 6/7)
; Field 17 = curParams (Vec of Str, parameter names of the function being emitted)
; Field 18 = curFlags (Vec of 0/1 from this function's own signature, 0 if it has none)
; Field 19 = macros (Vec of D_MACRO nodes: name, param names, template)
; Field 20 = symkinds (Vec of 0/1 parallel to fields 6/7/16: 0 = the
;            register IS the value, 1 = the register is an alloca and
;            every read is a load - which is what lets `set` store and
;            `while` observe the store on the next trip)
; Field 21 = pendingLams (Vec of lifted-lambda descriptors, emitted as
;            top-level functions after the function that created them
;            closes - a lambda body cannot be emitted mid-function into
;            a line buffer that is one flat stream)
; Field 22 = lamN (Int, fresh `_lam_N` name counter)
; Field 23 = thunkFulls (Vec of Str, mangled names needing a forwarding
;            thunk; index in this Vec is the thunk's number)
; Field 24 = thunkArities (Vec of Int, parallel to 23)
; Field 25 = thunksEmitted (Int, how many of field 23's thunks have
;            been written out, so a later drain does not define one
;            twice)
; Field 26 = target (Int code, see `targetCode`; what the syscall asm,
;            allocator numbers, and triple are emitted for)
(pub struct CG (lines : Int) (tmp : Int) (result : Int) (types : Int) (tagN : Int) (argVec : Int) (symnames : Int) (symregs : Int) (decls : Int) (argsTyped : Int) (strings : Int) (curBlock : Int) (mangleBares : Int) (mangleFulls : Int) (resultIsFloat : Int) (floatSigs : Int) (symfloats : Int) (curParams : Int) (curFlags : Int) (macros : Int) (symkinds : Int) (pendingLams : Int) (lamN : Int) (thunkFulls : Int) (thunkArities : Int) (thunksEmitted : Int) (target : Int) (tcoName : Int) (tcoSlots : Int) (tcoLabel : Int) (tailOK : Int) (terminated : Int))

; ------------------------------------------------------------------
; Tail-call optimisation, fields 27-31.
;
; A self tail call becomes parameter reassignment plus a branch back to
; the function's loop header - stage0's rule, and without it a
; self-recursive Axiom function compiled by stage1 is a real call chain
; that overflows the stack where the same source compiled by stage0
; loops forever in constant space. `stdlib/Mem.ax` met that ceiling for
; real: its byte loops were self tail calls, and a `memCopy` of a few
; hundred kilobytes segfaulted a stage1-built compiler.
;
;   tcoName   the symbol this function is being emitted as, or 0 when
;             the body contains no self tail call and none of this
;             applies - which is most functions, and they emit exactly
;             the LLVM they did before.
;   tcoSlots  one alloca register per parameter, in parameter order.
;   tcoLabel  the loop header to branch back to.
;   tailOK    set only for the instant between `emitExprTail` deciding
;             an application sits in tail position and `dispatchCall`
;             reading it. Anything else that emits a call clears it, so
;             a call in argument position can never be rewritten.
;   terminated  the current block already ended with a terminator, so
;             no `br` or `ret` may follow and a phi must not name it as
;             a predecessor.
; ------------------------------------------------------------------

; The constructor tag counter starts at 2, not 0: stage0's tag is the
; ordinal position in a flat walk of every data type the type checker
; collected, and the builtin `Option` walks first, so the first
; user-declared constructor is 2. Tags only ever meet tags from the
; same scheme, but the two stages must still agree whenever a program
; lets one escape (probed: stage0 gives the first user constructor 2).
;
; `Some` is 0 and `None` is 1, not the other way round - this comment
; used to say the reverse. Probed directly against stage0:
; `(cast Int (None))` exits 1, and `(__load64 (cast Int (Some 7)) 0)`
; - the tag word of the heap block - is 0.
;
; The registry is SEEDED with both, because `Option` is builtin and so
; has no declaration for `scanCtors` to walk. Without the seed a match
; on `(Some x)` found no entry, bound nothing, and emitted
; `store i64 %x` naming a register that does not exist - invalid IR
; that llc refused (tests/stdlib/270-nullary-unboxed.ax). Its
; representation is 2, mixed: `None` is an immediate tag and `Some` a
; heap block, which is exactly the case the `< 4096` runtime test
; exists for.
(pub :: newCG Int)
(pub fn (newCG)
  (let ((ts vecNew))
    {
      (addType ts "Some" TF_DATA 1 0 2 (let ((f vecNew)) { (vecPush f 0) f }))
      (addType ts "None" TF_DATA 0 1 2 vecNew)
      (CG vecNew 0 "" ts 2 vecNew vecNew vecNew 0 "" vecNew "entry" vecNew vecNew 0 vecNew vecNew 0 0 vecNew vecNew vecNew 0 vecNew vecNew 0 0 0 vecNew "" 0 0)
    }))

(pub :: zeroFloat (-> Int Int))
(pub fn (zeroFloat cg)
  {
    (memSetWord cg 14 0)
    cg
  })

; ------------------------------------------------------------------
; Per-function float signatures, keyed by the (mangled) defined name.
; `flags` is one 0/1 per arrow position, return type last - the shape
; `sigFloatFlags` in the parser produces.
; ------------------------------------------------------------------
(pub struct FSig (name : Int) (nameLen : Int) (flags : Int))

(pub :: scanFloatSigs (-> Int Int Int Int))
(pub fn (scanFloatSigs decls sigs i)
  (if (>= i (vecLen decls))
      sigs
      {
        (let ((d (vecGet decls i)))
          (if (== (nodeTag d) TAG_D_SIG)
              (vecPush sigs (cast Int (FSig (nodeA d) (strLen (nodeA d)) (nodeB d))))
              0))
        (scanFloatSigs decls sigs (+ i 1))
      }))

(pub :: findFSig (-> Int Int Int))
(pub fn (findFSig sigs name)
  (findFSigIn sigs name (strLen name) 0))

(pub :: findFSigIn (-> Int Int Int Int Int))
(pub fn (findFSigIn sigs name nl i)
  (if (>= i (vecLen sigs))
      0
      (let ((e (vecGet sigs i)))
        (if (&& (== (memGetWord e 1) nl) (strEq (memGetWord e 0) name))
            e
            (findFSigIn sigs name nl (+ i 1))))))

; Whether function `name` (already mangled) returns a float. Unknown
; names answer 0: a function with no signature cannot traffic in floats,
; because nothing could have told the emitter which of its words are
; bit patterns.
(pub :: fnRetIsFloat (-> Int Int Int))
(pub fn (fnRetIsFloat cg name)
  (let ((e (findFSig (memGetWord cg 15) name)))
    (if (== e 0)
        0
        (let ((flags (memGetWord e 2)))
          (if (== flags 0)
              0
              (if (== (vecLen flags) 0)
                  0
                  (vecGet flags (- (vecLen flags) 1))))))))

; Whether parameter `idx` of the function being emitted is a float. The
; last flag is the return type, so a bare-type signature has no
; parameter flags at all.
(pub :: paramIsFloat (-> Int Int Int))
(pub fn (paramIsFloat cg idx)
  (let ((flags (memGetWord cg 18)))
    (if (== flags 0)
        0
        (if (>= idx (- (vecLen flags) 1))
            0
            (vecGet flags idx)))))

(pub :: paramFloatByName (-> Int Int Int))
(pub fn (paramFloatByName cg name)
  (let ((params (memGetWord cg 17)))
    (if (== params 0)
        0
        (paramFloatIdx cg params name 0))))

(pub :: paramFloatIdx (-> Int Int Int Int Int))
(pub fn (paramFloatIdx cg params name i)
  (if (>= i (vecLen params))
      0
      (if (strEq (vecGet params i) name)
          (paramIsFloat cg i)
          (paramFloatIdx cg params name (+ i 1)))))

; ------------------------------------------------------------------
; Macros.
;
; A macro is a rewrite, applied where a call would otherwise be
; emitted: a head that names a macro whose parameter count matches the
; argument count has its template instantiated - each parameter name
; replaced by the corresponding argument's syntax tree - and the
; instantiation is emitted in the call's place. Emitting it re-enters
; this same dispatch, so a template that itself invokes a macro
; expands, exactly as stage0's expander recurses after substituting.
;
; Two deliberate simplifications against stage0. Substitution is
; unhygienic - no gensym, no scope sets - which is observably identical
; for every macro in the corpus, since none introduces a binder; a
; template `let` whose name collides with a call-site name would
; capture here and not under stage0. And an argument used twice in the
; template shares one tree rather than two clones, which cannot be
; told apart either: emission walks the tree twice and emits the
; expression twice, the same double evaluation textual substitution
; has always meant. Nothing in emission mutates expression nodes, so
; the sharing is safe.
; ------------------------------------------------------------------
(pub :: scanMacros (-> Int Int Int Int))
(pub fn (scanMacros decls acc i)
  (if (>= i (vecLen decls))
      acc
      {
        (let ((d (vecGet decls i)))
          (if (== (nodeTag d) TAG_D_MACRO)
              (vecPush acc d)
              0))
        (scanMacros decls acc (+ i 1))
      }))

; The scan runs backward: stage0 collects macros into a map keyed by
; name, so a later definition of the same name overwrites an earlier
; one - and since import resolution puts dependencies ahead of the
; importing file, that is also what makes an entry-file macro shadow an
; imported one.
(pub :: findMacro (-> Int Int Int))
(pub fn (findMacro cg name)
  (findMacroIn (memGetWord cg 19) name (- (vecLen (memGetWord cg 19)) 1)))

(pub :: findMacroIn (-> Int Int Int Int))
(pub fn (findMacroIn ms name i)
  (if (< i 0)
      0
      (let ((m (vecGet ms i)))
        (if (strEq (nodeA m) name)
            m
            (findMacroIn ms name (- i 1))))))

; Backward for the same reason: stage0 binds parameters left to right
; into a map, so a duplicated parameter name ends up bound to its LAST
; occurrence's argument.
(pub :: identIndexLast (-> Int Int Int Int))
(pub fn (identIndexLast names name i)
  (if (< i 0)
      (- 0 1)
      (if (strEq (vecGet names i) name)
          i
          (identIndexLast names name (- i 1)))))

; stage0 expands *every* invocation of a macro, whatever the arity.
; Its pattern matcher never fails on macro parameters: a single
; parameter binds the lone argument, a begin-block of several, or the
; literal 0 of none; a parameter list binds positionally, extra
; arguments are dropped, and a parameter beyond the arguments stays
; unbound - its name survives in the template verbatim. This builds the
; argument vector `macroSubst` indexes so those rules hold.
(pub :: macroEffArgs (-> Int Int Int))
(pub fn (macroEffArgs params args)
  (if (== (vecLen params) 1)
      (let ((v vecNew))
        {
          (vecPush v
            (if (== (vecLen args) 0)
                (mkEInt 0)
            (if (== (vecLen args) 1)
                (vecGet args 0)
            (mkEBegin args))))
          v
        })
      args))

(pub :: emitMacroCall (-> Int Int Int Int))
(pub fn (emitMacroCall mac args cg)
  (emitExpr (macroSubst (nodeC mac)
                        (nodeB mac)
                        (macroEffArgs (nodeB mac) args))
            cg))

; The template with every parameter reference replaced by its
; argument. Nodes that hold no parameter reference - literals,
; strings - pass through unrebuilt; so does a `match` arm's pattern,
; which stage0's substitution also leaves alone. A parameter with no
; argument to bind stays as itself, matching stage0.
(pub :: macroSubst (-> Int Int Int Int))
(pub fn (macroSubst tpl params args)
  (let ((tag (nodeTag tpl)))
    (if (== tag TAG_E_VAR)
        (let ((idx (identIndexLast params (nodeA tpl) (- (vecLen params) 1))))
          (if (< idx 0)
              tpl
              (if (>= idx (vecLen args))
                  tpl
                  (vecGet args idx))))
    (if (== tag TAG_E_APP)
        (mkEApp (macroSubst (nodeA tpl) params args)
                (macroSubst (nodeB tpl) params args))
    (if (== tag TAG_E_IF)
        (mkEIf (macroSubst (nodeA tpl) params args)
               (macroSubst (nodeB tpl) params args)
               (macroSubst (nodeC tpl) params args))
    (if (== tag TAG_E_LET)
        (mkELet (nodeA tpl)
                (macroSubst (nodeB tpl) params args)
                (macroSubst (nodeC tpl) params args))
    (if (== tag TAG_E_LAM)
        (mkELam (nodeA tpl)
                (macroSubst (nodeB tpl) params args))
    (if (== tag TAG_E_BEGIN)
        (mkEBegin (macroSubstVec (nodeA tpl) params args))
    (if (== tag TAG_E_MATCH)
        (mkNode TAG_E_MATCH
                (macroSubst (nodeA tpl) params args)
                (macroSubstArms (nodeB tpl) params args)
                0)
    ; A structural cond in a template: substitute inside every
    ; clause's test and body, and the else. Before cond was kept
    ; structural it arrived here pre-desugared as TAG_E_IF; without
    ; this case a template cond would emit with its parameter
    ; references unsubstituted.
    (if (== tag TAG_E_COND)
        (mkNode TAG_E_COND
                (macroSubstCondClauses (nodeA tpl) params args)
                (if (== (nodeB tpl) 0)
                    0
                    (macroSubst (nodeB tpl) params args))
                0)
    tpl))))))))))

(pub :: macroSubstCondClauses (-> Int Int Int Int))
(pub fn (macroSubstCondClauses clauses params args)
  (macroSubstCondClausesIn clauses params args vecNew 0))

(pub :: macroSubstCondClausesIn (-> Int Int Int Int Int Int))
(pub fn (macroSubstCondClausesIn clauses params args acc i)
  (if (>= i (vecLen clauses))
      acc
      (let ((cl (vecGet clauses i)))
        (macroSubstCondClausesIn clauses params args
          (vecPush acc (mkNode TAG_M_ARM
                               (macroSubst (nodeA cl) params args)
                               (macroSubst (nodeB cl) params args)
                               0))
          (+ i 1)))))

(pub :: macroSubstVec (-> Int Int Int Int))
(pub fn (macroSubstVec exprs params args)
  (macroSubstVecIn exprs params args vecNew 0))

(pub :: macroSubstVecIn (-> Int Int Int Int Int Int))
(pub fn (macroSubstVecIn exprs params args acc i)
  (if (>= i (vecLen exprs))
      acc
      (macroSubstVecIn exprs params args
                       (vecPush acc (macroSubst (vecGet exprs i) params args))
                       (+ i 1))))

(pub :: macroSubstArms (-> Int Int Int Int))
(pub fn (macroSubstArms arms params args)
  (macroSubstArmsIn arms params args vecNew 0))

(pub :: macroSubstArmsIn (-> Int Int Int Int Int Int))
(pub fn (macroSubstArmsIn arms params args acc i)
  (if (>= i (vecLen arms))
      acc
      (let ((arm (vecGet arms i)))
        (macroSubstArmsIn arms params args
                          (vecPush acc (mkNode TAG_M_ARM
                                               (nodeA arm)
                                               (macroSubst (nodeB arm) params args)
                                               0))
                          (+ i 1)))))

(pub :: emitLine (-> Int Int Int))
(pub fn (emitLine cg line)
  (let ((updated (vecPush (memGetWord cg 0) (strDup line))))
    {
      (memSetWord cg 0 updated)
      cg
    }))

(pub :: allocReg (-> Int Int))
(pub fn (allocReg cg)
  (let ((n (memGetWord cg 1)))
    {
      (memSetWord cg 1 (+ n 1))
      n
    }))

; ------------------------------------------------------------------
; Integer formatting.
; ------------------------------------------------------------------
(pub :: fmtInt (-> Int Int))
(pub fn (fmtInt n)
  (if (< n 0)
      (cat2 "-" (fmtInt (- 0 n)))
  (if (< n 10)
      (let ((ch (strAlloc 1)))
        {
          (__store8 (strData ch) 0 (+ n 48))
          ch
        })
      (let ((prefix (fmtInt (/ n 10))))
        (let ((suffix (strAlloc 1)))
          {
            (__store8 (strData suffix) 0 (+ (% n 10) 48))
            (strConcat prefix suffix)
          })))))

; ------------------------------------------------------------------
; Render accumulated lines into one string.
; ------------------------------------------------------------------
(pub :: renderCG (-> Int Int))
(pub fn (renderCG cg)
  (let ((lines (memGetWord cg 0)))
    (renderFrom lines 0 "")))
(pub :: renderFrom (-> Int Int Int Int))
(pub fn (renderFrom lines i acc)
  (if (>= i (vecLen lines))
      acc
      (let ((line (vecGet lines i)))
        (renderFrom lines (+ i 1)
          (strConcat acc (strConcat line "\n"))))))

; ------------------------------------------------------------------
; String helpers.
; ------------------------------------------------------------------
(pub :: cat2 (-> Int Int Int))
(pub fn (cat2 a b) (strConcat a b))

(pub :: cat3 (-> Int Int Int Int))
(pub fn (cat3 a b c) (strConcat (strConcat a b) c))

(pub :: cat4 (-> Int Int Int Int Int))
(pub fn (cat4 a b c d)
  (strConcat (strConcat a (strConcat b c)) d))

(pub :: regStr (-> Int Int))
(pub fn (regStr n) (cat2 "%t" (fmtInt n)))

(pub :: constStr (-> Int Int))
(pub fn (constStr n) (fmtInt n))


; ------------------------------------------------------------------
; String literals.
;
; A literal is interned once per module and emitted as a private global.
; Every byte is written as a hex escape rather than passed through
; literally: the body then contains no quote or backslash that could
; close the constant early, and no judgement is needed about which bytes
; LLVM considers printable.
; ------------------------------------------------------------------
(pub :: internString (-> Int Int Int))
(pub fn (internString cg lexeme)
  (let ((tbl (memGetWord cg 10))
        (found (findString tbl lexeme 0)))
    (if (>= found 0)
        found
        (let ((id (vecLen tbl)))
          {
            (vecPush tbl lexeme)
            id
          }))))

(pub :: findString (-> Int Int Int Int))
(pub fn (findString tbl s i)
  (if (>= i (vecLen tbl))
      (- 0 1)
      (if (strEq (vecGet tbl i) s)
          i
          (findString tbl s (+ i 1)))))

(pub :: hexDigit (-> Int Int))
(pub fn (hexDigit n)
  (if (< n 10) (+ 48 n) (+ 55 n)))

(pub :: hex2 (-> Int Int))
(pub fn (hex2 n)
  (let ((s (strAlloc 2)))
    {
      (__store8 (strData s) 0 (hexDigit (/ n 16)))
      (__store8 (strData s) 1 (hexDigit (% n 16)))
      s
    }))

; The byte a source escape denotes. Anything unrecognised stands for
; itself, which is what `\"` and `\\` need.
(pub :: unescByte (-> Int Int))
(pub fn (unescByte c)
  (if (== c 110) 10
  (if (== c 116) 9
  (if (== c 114) 13
  (if (== c 48) 0
  c)))))

; `lexeme` still carries its surrounding quotes, so the body runs from
; index 1 to len-1.
(pub :: escBody (-> Int Int Int Int Int))
(pub fn (escBody s i limit acc)
  (if (>= i limit)
      acc
      (let ((c (strByte s i)))
        (if (&& (== c 92) (< (+ i 1) limit))
            (escBody s (+ i 2) limit
                     (cat3 acc "\\" (hex2 (unescByte (strByte s (+ i 1))))))
            (escBody s (+ i 1) limit
                     (cat3 acc "\\" (hex2 c)))))))

; Every byte became exactly three characters, so the byte count is the
; escaped length over three; the array is one longer for the terminator.
(pub :: emitStringGlobals (-> Int Int Int))
(pub fn (emitStringGlobals cg i)
  (let ((tbl (memGetWord cg 10)))
    (if (>= i (vecLen tbl))
        cg
        (let ((lex (vecGet tbl i)))
          (let ((body (escBody lex 1 (- (strLen lex) 1) ""))) 
            (let ((n (+ (/ (strLen body) 3) 1)))
              {
                (emitLine cg
                  (cat4 (cat3 "@str_" (fmtInt i) " = private unnamed_addr constant [")
                        (cat3 (fmtInt n) " x i8]  c\"" body)
                        "\\00\""
                        ""))
                ; The `Str` header the literal itself evaluates to, over
                ; the bytes just emitted. `n` counts the NUL, the length
                ; word does not.
                (emitLine cg
                  (cat4 (cat3 "@strhdr_" (fmtInt i)
                              " = private unnamed_addr constant { i64, ptr } { i64 ")
                        (cat3 (fmtInt (- n 1)) ", ptr @str_" (fmtInt i))
                        " }, align 8"
                        ""))
                (emitStringGlobals cg (+ i 1))
              }))))))

; ------------------------------------------------------------------
; Nullary top-level functions read like variables but lower to calls.
; ------------------------------------------------------------------
(pub :: isNullaryFn (-> Int Int Bool))
(pub fn (isNullaryFn decls name)
  (if (== decls 0) false (isNullaryFnIn decls name 0)))

(pub :: isNullaryFnIn (-> Int Int Int Bool))
(pub fn (isNullaryFnIn decls name i)
  (if (>= i (vecLen decls))
      false
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN)
                (&& (strEq (nodeA d) name) (== (vecLen (nodeB d)) 0)))
            true
            (isNullaryFnIn decls name (+ i 1))))))

; ------------------------------------------------------------------
; Pre-scan declarations: build the type registry.
; ------------------------------------------------------------------
(pub :: scanDecls (-> Int Int Int Int))
(pub fn (scanDecls decls cg i)
  (if (>= i (vecLen decls)) cg
      (scanDecls decls (scanOne (vecGet decls i) cg) (+ i 1))))

(pub :: scanOne (-> Int Int Int))
(pub fn (scanOne node cg)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_D_DATA)
        (let ((name (nodeA node))
              (ctors (nodeB node)))
          (scanCtors ctors cg 0 (ctorsRep ctors (memGetWord cg 4))))
    (if (== tag TAG_D_STRUCT)
        (let ((name (nodeA node))
              (fields (nodeB node))
              (types (memGetWord cg 3)))
          {
            ; A struct's slot 7 holds its FIELD list (mkField nodes:
            ; name and float flag) where a data constructor's holds
            ; float flags alone - the kind decides the reading.
            (memSetWord cg 3 (addType types name TF_STRUCT (vecLen fields) 0 0 fields))
            cg
          })
    cg))))

(pub :: ctorsHasNullary (-> Int Int Int))
(pub fn (ctorsHasNullary ctors i)
  (if (>= i (vecLen ctors))
      0
      (if (== (nodeB (vecGet ctors i)) 0)
          1
          (ctorsHasNullary ctors (+ i 1)))))

(pub :: ctorsHasBoxed (-> Int Int Int))
(pub fn (ctorsHasBoxed ctors i)
  (if (>= i (vecLen ctors))
      0
      (if (> (nodeB (vecGet ctors i)) 0)
          1
          (ctorsHasBoxed ctors (+ i 1)))))

; The representation code every constructor of one `data` type
; carries: 0 = boxed (no nullary constructor unboxes - the type has
; none, or a tag would reach the 4096 immediate limit), 1 =
; all-nullary (every value IS its tag), 2 = mixed (nullary
; constructors are immediate tags, fieldful ones are heap blocks, and
; a match site telling them apart needs the runtime `< 4096` test -
; every heap address is mmap-page memory at or above it). Mirrors
; stage0's S1 rule exactly; `firstTag` is the counter before this
; type's constructors are assigned.
(pub :: ctorsRep (-> Int Int Int))
(pub fn (ctorsRep ctors firstTag)
  (if (== (ctorsHasNullary ctors 0) 0)
      0
      (if (>= (+ firstTag (vecLen ctors)) 4096)
          0
          (if (== (ctorsHasBoxed ctors 0) 1) 2 1))))

(pub :: scanCtors (-> Int Int Int Int Int))
(pub fn (scanCtors ctors cg i rep)
  (if (>= i (vecLen ctors)) cg
      (let ((node (vecGet ctors i)))
        (let ((n (nodeA node))
              (a (nodeB node))
              (t (memGetWord cg 4))
              (types (memGetWord cg 3)))
          {
            ; `t` is this constructor's tag; the counter is bumped for
            ; the next one. Storing `t - 1` gave the first constructor
            ; of the module tag -1, and `fmtInt` rendered that as `/` -
            ; a stray character in the middle of an argument list.
            (memSetWord cg 4 (+ t 1))
            (memSetWord cg 3 (addType types n TF_DATA a t rep (nodeC node)))
            (scanCtors ctors cg (+ i 1) rep)
          }))))

; ------------------------------------------------------------------
; Import resolution: recursively collect declarations from all modules.
;
; Two contracts drive the shape of this code.
;
; `Sys.sysReadFile` takes a raw NUL-terminated char*, not a `Str`
; handle,
; because it hands the pointer straight to `sysOpenPath`. Every path
; therefore crosses the boundary via `strCStr`. Paths built by
; `strConcat` are already NUL-terminated (`strAlloc` reserves len+1 and
; the allocator zeroes), so no extra terminator work is needed. Passing
; a `Str` handle here silently opens garbage and reports every module
; as missing.
;
; `sysReadFile` reports failure as an empty `Str`, never as 0, so
; `strLen == 0` is the "not found" test.
;
; Resolution is diamond-safe: a `seen` Vec of module names ensures each
; module contributes its declarations exactly once. The import graph is
; a DAG with heavily shared nodes -- core, Mem, Str and Vec are each
; reached by several paths -- and emitting a module twice would produce
; duplicate LLVM symbol definitions. Marking a module seen *before*
; recursing into it also makes an import cycle terminate.
; ------------------------------------------------------------------

; An owned copy of `s` with every '.' turned into '/', mapping a dotted
; module path onto a relative file path: Sys.Platform -> Sys/Platform.
; `strDup` gives an owned, NUL-terminated buffer, so rewriting the bytes
; in place cannot disturb the original.
(pub :: modPathToFile (-> Int Int))
(pub fn (modPathToFile s)
  (let ((out (strDup s)))
    {
      (dotsToSlashes (strData out) 0 (strLen out))
      out
    }))

(pub :: dotsToSlashes (-> Int Int Int Int))
(pub fn (dotsToSlashes p i n)
  (if (>= i n)
      0
      {
        (if (== (__load8 p i) 46) (__store8 p i 47) 0)
        (dotsToSlashes p (+ i 1) n)
      }))

; Source text of module `name`, searching self_host/ then stdlib/.
; Returns 0 when the module resolves to no readable file.
; Source of module `name`, preferring a target-specific file.
;
; `Sys.Platform` resolves to `Sys/Platform.darwin.ax` before
; `Sys/Platform.ax`, the same order stage0 uses, so the syscall tables
; live in Axiom source rather than in a table inside the compiler.
; Without it the platform module resolves to nothing and every constant
; it defines - `sysWrite`, `oRdonly` - is an undefined symbol.
(pub :: readModuleSrc (-> Int Int Int Int))
(pub fn (readModuleSrc name tcode entryDir)
  (let ((stem (modPathToFile name)))
    (let ((osArch (tryModuleFile stem (targetOsArchSuffix tcode) entryDir)))
      (if (!= osArch 0)
          osArch
          (let ((os (tryModuleFile stem (targetOsSuffix tcode) entryDir)))
            (if (!= os 0)
                os
                (tryModuleFile stem ".ax" entryDir)))))))

(pub :: tryModuleFile (-> Int Int Int Int))
; Answers the PATH that was read, or "" - the unit table needs the
; filename a diagnostic will be rendered against, and only the search
; knows which candidate won.
(pub :: tryModulePath (-> Int Int Int Int))
(pub fn (tryModulePath stem suffix entryDir)
  (let ((base (cat2 stem suffix)))
    (let ((near (if (== (strLen entryDir) 0) base (cat2 entryDir base))))
      (if (!= (strLen (sysReadFile (strCStr near))) 0)
          near
          (let ((sh (cat2 "self_host/" base)))
            (if (!= (strLen (sysReadFile (strCStr sh))) 0)
                sh
                (let ((sl (cat2 "stdlib/" base)))
                  (if (!= (strLen (sysReadFile (strCStr sl))) 0) sl ""))))))))

(pub :: modulePathOf (-> Int Int Int Int))
(pub fn (modulePathOf name tcode entryDir)
  (let ((stem (modPathToFile name)))
    (let ((a (tryModulePath stem (targetOsArchSuffix tcode) entryDir)))
      (if (!= (strLen a) 0)
          a
          (let ((b (tryModulePath stem (targetOsSuffix tcode) entryDir)))
            (if (!= (strLen b) 0) b (tryModulePath stem ".ax" entryDir)))))))

(pub fn (tryModuleFile stem suffix entryDir)
  (let ((base (cat2 stem suffix)))
    ; The ENTRY FILE'S DIRECTORY first, which is stage0's rule and was
    ; missing entirely: stage1 searched only `self_host/` and
    ; `stdlib/` relative to its working directory, so a module sitting
    ; next to the program that imports it could not be found at all -
    ; `(import MA)` beside `main.ax` was "cannot read module: MA"
    ; where stage0 resolves it. The bootstrap never noticed because it
    ; runs from the repo root with its entry in `self_host/`, which
    ; the hardcoded path already covered.
    (let ((nearSrc (if (== (strLen entryDir) 0)
                       (sysReadFile (strCStr base))
                       (sysReadFile (strCStr (cat2 entryDir base))))))
      (if (!= (strLen nearSrc) 0)
          nearSrc
          (let ((selfSrc (sysReadFile (strCStr (cat2 "self_host/" base)))))
            (if (!= (strLen selfSrc) 0)
                selfSrc
                (let ((stdSrc (sysReadFile (strCStr (cat2 "stdlib/" base)))))
                  (if (!= (strLen stdSrc) 0)
                      stdSrc
                      0))))))))

; Everything up to and including the last `/` of a path, or "" when
; the path names a file in the working directory.
(pub :: dirOfPath (-> Int Int))
(pub fn (dirOfPath p) (dirOfPathFrom p (- (strLen p) 1)))

(pub :: dirOfPathFrom (-> Int Int Int))
(pub fn (dirOfPathFrom p i)
  (if (< i 0)
      ""
      (if (== (strByte p i) 47)
          (strSlice p 0 (+ i 1))
          (dirOfPathFrom p (- i 1)))))

; A module that cannot be read or parsed used to be *skipped*, so every
; function it defined surfaced later as `use of undefined value` out of
; llc - a codegen-shaped report for an import-shaped failure, with the
; module's name nowhere in it. That is how `stdlib/Fmt.ax` failing to
; parse presented as `@fmtInt` being undefined in a module that had
; visibly imported it. Refusing at the point of failure names the
; module, and matches the rule held everywhere else: a malformed input
; produces a diagnostic, not something worse further away.
(pub :: dieImport (-> Int Int Int))
(pub fn (dieImport msg name)
  {
    (sysWriteFd 2 (strData msg) (strLen msg))
    (sysWriteFd 2 (strData name) (strLen name))
    (sysWriteFd 2 (strData "\n") (strLen "\n"))
    (sysExitWith 3)
    0
  })

; Declaration Vec for module `name`; a module that cannot be read or
; parsed is a fatal diagnostic, never a 0 this returns.
(pub :: parseModuleOrDie (-> Int Int Int Int))
; As `parseModuleOrDie`, and additionally records the module in the
; UNIT TABLE - the path a diagnostic about this module renders
; against, its text, and its name so the checker can find the index
; from a declaration's `module` stamp.
(pub :: parseModuleOrDieUnit (-> Int Int Int Int Int))
(pub fn (parseModuleOrDieUnit name tcode entryDir units)
  {
    (if (== (unitIndexOf units name 0) (- 0 1))
        (vecPush units (cast Int (CUnit2 (modulePathOf name tcode entryDir)
                                         (readModuleSrc name tcode entryDir)
                                         name)))
        0)
    (parseModuleOrDie name tcode entryDir)
  })

(pub :: unitIndexOf (-> Int Int Int Int))
(pub fn (unitIndexOf units name i)
  (if (>= i (vecLen units))
      (- 0 1)
      (if (== (memGetWord (vecGet units i) 2) 0)
          (unitIndexOf units name (+ i 1))
          (if (strEq (memGetWord (vecGet units i) 2) name)
              i
              (unitIndexOf units name (+ i 1))))))

(pub fn (parseModuleOrDie name tcode entryDir)
  (let ((src (readModuleSrc name tcode entryDir)))
    (if (== src 0)
        (dieImport "error: cannot read module: " name)
        (let ((pr (parseModule (lex src))))
          (if (== (memGetWord pr 0) 0)
              (dieImport "error: cannot parse module: " name)
              (memGetWord pr 1))))))

(pub :: seenHas (-> Int Int Bool))
(pub fn (seenHas seen name)
  (seenHasIn seen name 0))

(pub :: seenHasIn (-> Int Int Int Bool))
(pub fn (seenHasIn seen name i)
  (if (>= i (vecLen seen))
      false
      (if (strEq (vecGet seen i) name)
          true
          (seenHasIn seen name (+ i 1)))))

; ------------------------------------------------------------------
; Name mangling.
;
; Two modules may export the same name - `IO.ax` and `Sys.ax` once
; both defined `readFile`, since renamed - and emitting both bare
; produced two `define i64 @readFile` in one LLVM module, which `llc`
; rejects. The scheme is stage0's: a declaration imported from module
; `M` defines the symbol `M$name`, a declaration in the entry file
; keeps its bare name - `@main` must stay `@main` for the linker - and
; a bare *reference* resolves through one flat map, entry file first,
; then imports in resolution order. (stage0's checker now refuses a
; bare reference that two imports define and the entry does not -
; AX3014 - so the imports-in-order tail of that rule only decides
; programs stage0 would no longer accept.) `$` and `.` are both legal
; in an unquoted LLVM identifier, so `Sys.Platform$sysWrite` needs no
; quoting.
;
; The map is two Vecs pushed in lockstep rather than a Map, because it
; is small (one entry per top-level function) and built once.
; ------------------------------------------------------------------

; Record how a bare reference reaches `full`, unless the bare name is
; already claimed. First-writer-wins is what makes the entry file win:
; `resolveImports` records every entry-file function before any import
; is read.
(pub :: mangleRecord (-> Int Int Int Int Int))
(pub fn (mangleRecord bares fulls bare full)
  (if (mangleHasIn bares bare 0)
      0
      {
        (vecPush bares bare)
        (vecPush fulls full)
        0
      }))

(pub :: mangleHasIn (-> Int Int Int Bool))
(pub fn (mangleHasIn bares bare i)
  (if (>= i (vecLen bares))
      false
      (if (strEq (vecGet bares i) bare)
          true
          (mangleHasIn bares bare (+ i 1)))))

; The symbol a bare reference reaches: the entry file's definition if it
; has one, the first-resolved import's otherwise, and the name unchanged
; when nothing claims it - parameters, locals and primitives never enter
; the map.
(pub :: mangledFor (-> Int Int Int))
(pub fn (mangledFor cg name)
  ; A reference to `main` - a recursive call, or main as a value -
  ; must reach the renamed user function, never the argv wrapper,
  ; which would re-store whatever its two parameters happened to be.
  (if (strEq name "main")
      "__axiom_user_main"
      (mangledForIn (memGetWord cg 12) (memGetWord cg 13) name 0)))

(pub :: mangledForIn (-> Int Int Int Int Int))
(pub fn (mangledForIn bares fulls name i)
  (if (>= i (vecLen bares))
      name
      (if (strEq (vecGet bares i) name)
          (vecGet fulls i)
          (mangledForIn bares fulls name (+ i 1)))))

; Rewrite an imported function's definition to its mangled name, in
; place - `emitFnDef` reads the same node later, so the header and the
; map cannot disagree. Entry-file declarations (modName 0) are left
; bare; they were already recorded by `recordEntryFns`. A signature is
; renamed the same way, so the float-signature registry and the
; definitions it describes stay keyed identically.
(pub :: mangleDecl (-> Int Int Int Int Int))
(pub fn (mangleDecl node modName bares fulls)
  (if (== modName 0)
      0
      (if (== (nodeTag node) TAG_D_FN)
          (let ((bare (nodeA node)))
            (let ((full (cat3 (strDup modName) "$" (strDup bare))))
              {
                (memSetWord node 1 full)
                (mangleRecord bares fulls bare full)
              }))
          (if (== (nodeTag node) TAG_D_SIG)
              {
                (memSetWord node 1 (cat3 (strDup modName) "$" (strDup (nodeA node))))
                0
              }
              0))))

; Every entry-file function maps to itself, recorded ahead of every
; import so that a collision resolves to the file being compiled.
(pub :: recordEntryFns (-> Int Int Int Int Int))
(pub fn (recordEntryFns decls bares fulls i)
  (if (>= i (vecLen decls))
      0
      {
        (let ((d (vecGet decls i)))
          (if (== (nodeTag d) TAG_D_FN)
              (mangleRecord bares fulls (nodeA d) (nodeA d))
              0))
        (recordEntryFns decls bares fulls (+ i 1))
      }))

(pub :: resolveImports (-> Int Int Int Int Int Int Int))
(pub fn (resolveImports decls bares fulls tcode entryDir units)
  {
    (recordEntryFns decls bares fulls 0)
    (resolveDecls decls vecNew vecNew 0 0 bares fulls 0 tcode entryDir units)
  })

; Append every non-import declaration reachable from `decls` onto `acc`,
; depth-first so that a module's dependencies land ahead of it.
; `modName` is the module the list came from, 0 for the entry file; an
; imported function is renamed to `modName$name` as it lands.
;
; `filter` is the import's name list, 0 when the import named none:
; `(import M (a b))` splices only M's declarations named `a` or `b`,
; exactly as stage0 filters through its `wanted` set - including the
; harsh part, where a kept function's un-named private helpers vanish
; with it. M's own nested imports are processed regardless: in stage0
; they live outside the filtered declaration list, so a name list never
; suppresses a dependency.
;
; `acc` and `seen` are threaded rather than rebuilt: `vecPush` mutates in
; place and returns the same handle, so both stay stable across the whole
; traversal and siblings observe each other's additions.
(pub :: resolveDecls (-> Int Int Int Int Int Int Int Int Int Int Int Int))
(pub fn (resolveDecls decls acc seen i modName bares fulls filter tcode entryDir units)
  (if (>= i (vecLen decls)) acc
      (let ((first (vecGet decls i)))
        (if (== (nodeTag first) TAG_D_IMPORT)
            (let ((name (memGetWord first 1)))
              (if (seenHas seen name)
                  (resolveDecls decls acc seen (+ i 1) modName bares fulls filter tcode entryDir units)
                  {
                    (vecPush seen name)
                    (let ((modDecls (parseModuleOrDieUnit name tcode entryDir units))
                          (subFilter (let ((ns (nodeB first)))
                                       (if (== ns 0)
                                           0
                                           (if (== (vecLen ns) 0) 0 ns)))))
                      (resolveDecls decls
                                    (resolveDecls modDecls acc seen 0 name bares fulls subFilter tcode entryDir units)
                                    seen
                                    (+ i 1)
                                    modName bares fulls filter tcode entryDir units))
                  }))
            ; A private declaration of an IMPORTED module is not part
            ; of the program: stage0 splices only `pub` ones, so a
            ; reference to a private imported name is undefined there
            ; and was silently callable here. The entry file
            ; (`modName == 0`) keeps everything, public or not.
            (if (&& (filterKeeps filter (nodeA first))
                    (|| (== modName 0) (== (nodeVis first) 1)))
                {
                  ; Provenance, recorded before mangling rewrites the
                  ; name: this is the only point in the pipeline that
                  ; knows which module a declaration came from.
                  (memSetWord first 8 modName)
                  (mangleDecl first modName bares fulls)
                  (resolveDecls decls (vecPush acc first) seen (+ i 1) modName bares fulls filter tcode entryDir units)
                }
                (resolveDecls decls acc seen (+ i 1) modName bares fulls filter tcode entryDir units))))))

(pub :: filterKeeps (-> Int Int Bool))
(pub fn (filterKeeps filter name)
  (if (== filter 0)
      true
      (seenHasIn filter name 0)))


; ------------------------------------------------------------------
; Targets.
;
; Everything per-target in one place, mirroring stage0's
; `axiom-codegen/src/target.rs` value for value: the triple, the
; syscall inline-assembly (register conventions differ per arch, and
; Darwin returns a positive errno with the carry flag set where Linux
; returns -errno, so the Darwin templates branch on carry and negate -
; `result < 0` is then a complete failure test on all four targets),
; the mmap/exit syscall numbers (Darwin's carry the 0x2000000 Unix
; class bit), the MAP_PRIVATE|MAP_ANON flag value, and the platform
; module suffixes. Codes: 0 darwin-aarch64, 1 darwin-x86_64,
; 2 linux-aarch64, 3 linux-x86_64; -1 is "unknown", refused loudly.
; ------------------------------------------------------------------

(pub :: targetCode (-> Int Int))
(pub fn (targetCode name)
  (if (strEq name "darwin-aarch64") 0
  (if (strEq name "darwin-x86_64") 1
  (if (strEq name "linux-aarch64") 2
  (if (strEq name "linux-x86_64") 3
  (- 0 1))))))

(pub :: targetTriple (-> Int Int))
(pub fn (targetTriple t)
  (if (== t 0) "arm64-apple-macosx14.0.0"
  (if (== t 1) "x86_64-apple-macosx14.0.0"
  (if (== t 2) "aarch64-unknown-linux-gnu"
  "x86_64-unknown-linux-gnu"))))

; The `"body", "constraints"` middle of a syscall call instruction,
; escaped and quoted ready to sit between `asm sideeffect ` and the
; argument list. One fragment per target, byte-for-byte the strings
; stage0 emits.
(pub :: targetSyscallAsm (-> Int Int))
(pub fn (targetSyscallAsm t)
  (if (== t 0) "\"svc #0x80\\0Ab.cc 1f\\0Aneg x0, x0\\0A1:\", \"={x0},{x16},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}\""
  (if (== t 1) "\"syscall\\0Ajnc 1f\\0Anegq %rax\\0A1:\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\""
  (if (== t 2) "\"svc #0\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{memory}\""
  "\"syscall\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\""))))

(pub :: targetMmapNum (-> Int Int))
(pub fn (targetMmapNum t)
  (if (== t 0) 33554629
  (if (== t 1) 33554629
  (if (== t 2) 222
  9))))

(pub :: targetExitNum (-> Int Int))
(pub fn (targetExitNum t)
  (if (== t 0) 33554433
  (if (== t 1) 33554433
  (if (== t 2) 93
  60))))

(pub :: targetMapFlags (-> Int Int))
(pub fn (targetMapFlags t)
  (if (|| (== t 0) (== t 1)) 4098 34))

; Platform module suffixes, most specific first: `.{os}-{arch}.ax`,
; then `.{os}.ax`, then `.ax` - the same order stage0 searches.
(pub :: targetOsArchSuffix (-> Int Int))
(pub fn (targetOsArchSuffix t)
  (if (== t 0) ".darwin-aarch64.ax"
  (if (== t 1) ".darwin-x86_64.ax"
  (if (== t 2) ".linux-aarch64.ax"
  ".linux-x86_64.ax"))))

(pub :: targetOsSuffix (-> Int Int))
(pub fn (targetOsSuffix t)
  (if (|| (== t 0) (== t 1)) ".darwin.ax" ".linux.ax"))

; ------------------------------------------------------------------
; The allocator, emitted rather than linked.
;
; A program stage1 compiles has to stand on its own: `axiom_alloc` is
; what every constructor and every `Str` goes through, and nothing else
; in the output defines it. This is the same `mmap`-backed bump
; allocator the Rust backend emits, parameterized by the target the
; driver named.
; ------------------------------------------------------------------
(pub :: emitAllocator (-> Int Int))
(pub fn (emitAllocator cg)
  {
    ; The process's arguments, captured by the `@main` wrapper below
    ; before the user's (renamed) main runs; `__argc`/`__argv` read
    ; them back. Matches stage0's convention exactly - the C runtime
    ; calls main(argc, argv), and before the wrapper existed those
    ; two values arrived silently in whatever register the first
    ; parameter happened to occupy.
    (emitLine cg "@__axiom_argc = internal global i64 0")
    (emitLine cg "@__axiom_argv = internal global i64 0")
    (emitLine cg "")
    (emitLine cg "define i64 @main(i64 %argc, i64 %argv) {")
    (emitLine cg "entry:")
    (emitLine cg "  store i64 %argc, ptr @__axiom_argc")
    (emitLine cg "  store i64 %argv, ptr @__axiom_argv")
    (emitLine cg "  %r = call i64 @__axiom_user_main()")
    (emitLine cg "  ret i64 %r")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "@__axiom_bump = internal global i64 0")
    (emitLine cg "@__axiom_bump_end = internal global i64 0")
    (emitLine cg "")
    (emitLine cg "define i64 @axiom_alloc(i64 %size) {")
    (emitLine cg "entry:")
    (emitLine cg "  %padded = add i64 %size, 15")
    (emitLine cg "  %sz = and i64 %padded, -16")
    (emitLine cg "  %cur = load i64, ptr @__axiom_bump")
    (emitLine cg "  %next = add i64 %cur, %sz")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %fits = icmp ule i64 %next, %end")
    (emitLine cg "  br i1 %fits, label %fast, label %refill")
    (emitLine cg "fast:")
    (emitLine cg "  store i64 %next, ptr @__axiom_bump")
    (emitLine cg "  ret i64 %cur")
    (emitLine cg "refill:")
    (emitLine cg "  %big = icmp ugt i64 %sz, 1048576")
    (emitLine cg "  %rounded0 = add i64 %sz, 65535")
    (emitLine cg "  %rounded = and i64 %rounded0, -65536")
    (emitLine cg "  %chunk = select i1 %big, i64 %rounded, i64 1048576")
    (emitLine cg (strConcat
                   (cat4 "  %addr = call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetMmapNum (memGetWord cg 26))))
                   (cat3 ", i64 0, i64 %chunk, i64 3, i64 "
                         (fmtInt (targetMapFlags (memGetWord cg 26)))
                         ", i64 -1, i64 0)")))
    (emitLine cg "  %failed_low = icmp ult i64 %addr, 4096")
    (emitLine cg "  %failed_neg = icmp ugt i64 %addr, -4096")
    (emitLine cg "  %failed = or i1 %failed_low, %failed_neg")
    (emitLine cg "  br i1 %failed, label %oom, label %mapped")
    (emitLine cg "mapped:")
    (emitLine cg "  %new_bump = add i64 %addr, %sz")
    (emitLine cg "  store i64 %new_bump, ptr @__axiom_bump")
    (emitLine cg "  %new_end = add i64 %addr, %chunk")
    (emitLine cg "  store i64 %new_end, ptr @__axiom_bump_end")
    (emitLine cg "  ret i64 %addr")
    (emitLine cg "oom:")
    (emitLine cg (strConcat
                   (cat4 "  call i64 asm sideeffect "
                         (targetSyscallAsm (memGetWord cg 26))
                         "(i64 "
                         (fmtInt (targetExitNum (memGetWord cg 26))))
                   ", i64 70, i64 0, i64 0, i64 0, i64 0, i64 0)"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; ------------------------------------------------------------------
; Module emission.
; ------------------------------------------------------------------
; `target` is a NAME (`darwin-aarch64`, ...), not a triple: the code it
; maps to drives the triple, the syscall asm, the allocator's numbers,
; and which platform module the imports resolved. An unknown name is
; refused with the four that exist, not defaulted - emitting the wrong
; target's syscall convention is a binary that dies at its first write.
; The convenience entry point, for a caller with no path to derive a
; module search directory from; imports resolve against `self_host/`
; and `stdlib/` only, as they always did.
(pub :: emitModule (-> Int Int Int))
(pub fn (emitModule decls target)
  (let ((tcode (checkedTargetCode target))
        (bares vecNew)
        (fulls vecNew))
    (emitResolved (resolveImports decls bares fulls tcode "" vecNew) bares fulls tcode)))

; The target's numeric code, refusing an unknown name rather than
; defaulting - emitting the wrong target's syscall convention is a
; binary that dies at its first write. Split out so the driver can
; resolve imports itself (the type checker needs the resolved
; declaration list) without duplicating the refusal.
(pub :: checkedTargetCode (-> Int Int))
(pub fn (checkedTargetCode target)
  (let ((tcode (targetCode target)))
    (if (< tcode 0)
        (dieImport "error: unknown target (want darwin-aarch64, darwin-x86_64, linux-aarch64, or linux-x86_64): " target)
        tcode)))

; Emission over an ALREADY-resolved declaration list. Separated from
; `emitModule` so import resolution happens exactly once per run: the
; checker needs `allDecls` too, and resolving twice would read every
; module from disk twice.
(pub :: emitResolved (-> Int Int Int Int Int))
(pub fn (emitResolved allDecls bares fulls tcode)
    (let ((cg (newCG)))
      (let ((_ (memSetWord cg 12 bares))
            (_2 (memSetWord cg 13 fulls))
            (_2t (memSetWord cg 26 tcode))
            (_3 (memSetWord cg 15 (scanFloatSigs allDecls vecNew 0)))
            (_4 (memSetWord cg 19 (scanMacros allDecls vecNew 0))))
      (let ((cg0 (scanDecls allDecls cg 0)))
        (let ((cg0b (memSetWord cg0 8 allDecls)))
          (let ((ttHeader (cat3 "target triple = \"" (targetTriple tcode) "\"")))
            (let ((cg1 (emitLine cg0b ttHeader)))
              (let ((cg2 (emitLine cg1 "")))
                (let ((cg3 (emitAllocator cg2)))
                  (let ((cg4 (emitLine cg3 "")))
                    (emitModuleTail allDecls cg4 0)))))))))))

(pub :: emitModuleTail (-> Int Int Int Int))
(pub fn (emitModuleTail decls cg i)
  (let ((nextCg (if (>= i (vecLen decls))
                    cg
                    (emitDecl (vecGet decls i) cg))))
    (if (>= i (vecLen decls))
        ; Globals may follow the functions that mention them; LLVM does
        ; not care about order, and the table is only complete once every
        ; body has been emitted.
        (renderCG (emitStringGlobals nextCg 0))
        (emitModuleTail decls nextCg (+ i 1)))))

; ------------------------------------------------------------------
; Declaration emission.
; ------------------------------------------------------------------
(pub :: emitDecls (-> Int Int Int Int))
(pub fn (emitDecls decls cg i)
  (if (>= i (vecLen decls)) cg
      (emitDecls decls (emitDecl (vecGet decls i) cg) (+ i 1))))

(pub :: emitDecl (-> Int Int Int))
(pub fn (emitDecl node cg)
  (if (== (nodeTag node) TAG_D_FN)
      ; Lambdas lifted out of the function's body, and thunks its bare
      ; function references demanded, are written out once the
      ; function's own `}` is down - the line buffer is one flat
      ; stream, so they cannot be emitted at the point of use.
      (drainPending (emitFnDef node cg))
      cg))

; ------------------------------------------------------------------
; Function definition.
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; Lower every TAG_E_COND in an expression tree to the nested-if chain
; the parser used to build at parse time, IN PLACE - parents keep
; their pointers, and the rewrite runs before `tailCallsSelf` so a
; tail self-call inside a cond clause still gets its loop. The fold is
; the old parser desugar verbatim: clauses right to left around the
; else body, `(mkEInt 0)` when there is none, so emission is
; bit-identical to the parse-time desugar this replaces.
; ------------------------------------------------------------------
(pub :: lowerConds (-> Int Int))
(pub fn (lowerConds e)
  (if (== e 0)
      0
      (let ((tag (nodeTag e)))
        (if (== tag TAG_E_COND)
            (let ((chain (condChainAt (nodeA e) (- (vecLen (nodeA e)) 1)
                                      (if (== (nodeB e) 0)
                                          (mkEInt 0)
                                          (lowerConds (nodeB e))))))
              {
                (memSetWord e 0 (nodeTag chain))
                (memSetWord e 1 (nodeA chain))
                (memSetWord e 2 (nodeB chain))
                (memSetWord e 3 (nodeC chain))
                (memSetWord e 4 (nodeSpan chain))
                e
              })
        (if (== tag TAG_E_APP)
            { (lowerConds (nodeA e)) (lowerConds (nodeB e)) e }
        (if (== tag TAG_E_LAM)
            { (lowerConds (nodeB e)) e }
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
            { (lowerConds (nodeB e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_IF)
            { (lowerConds (nodeA e)) (lowerConds (nodeB e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_BEGIN)
            { (lowerCondsVec (nodeA e) 0) e }
        (if (== tag TAG_E_MATCH)
            { (lowerConds (nodeA e)) (lowerCondsArms (nodeB e) 0) e }
        (if (== tag TAG_E_WHILE)
            { (lowerConds (nodeA e)) (lowerCondsVec (nodeB e) 0) e }
        (if (== tag TAG_E_SET)
            { (lowerConds (nodeB e)) e }
        (if (== tag TAG_E_SETF)
            { (lowerConds (nodeA e)) (lowerConds (nodeC e)) e }
        (if (== tag TAG_E_FIELD)
            { (lowerConds (nodeA e)) e }
        e))))))))))))))

(pub :: condChainAt (-> Int Int Int Int))
(pub fn (condChainAt clauses i acc)
  (if (< i 0)
      acc
      (let ((cl (vecGet clauses i)))
        (condChainAt clauses (- i 1)
          (mkEIf (lowerConds (nodeA cl)) (lowerConds (nodeB cl)) acc)))))

(pub :: lowerCondsVec (-> Int Int Int))
(pub fn (lowerCondsVec v i)
  (if (>= i (vecLen v))
      0
      { (lowerConds (vecGet v i)) (lowerCondsVec v (+ i 1)) }))

; Arm PATTERNS are left alone: a cond form in pattern position is
; nonsense the emitter has always treated as match-everything, and
; lowering it would only change which nonsense it is.
(pub :: lowerCondsArms (-> Int Int Int))
(pub fn (lowerCondsArms arms i)
  (if (>= i (vecLen arms))
      0
      { (lowerConds (nodeB (vecGet arms i))) (lowerCondsArms arms (+ i 1)) }))

(pub :: emitFnDef (-> Int Int Int))
(pub fn (emitFnDef node cg)
  ; The entry file's `main` is not the linker's `main` - the argv
  ; wrapper in the prelude owns that symbol and calls this one. Same
  ; rename stage0 makes, for the same reason.
  (let ((name (if (strEq (nodeA node) "main")
                  "__axiom_user_main"
                  (nodeA node)))
        (params (nodeB node))
        (body (lowerConds (nodeC node))))
    (let ((paramStr (emitParams params cg 0))
          (_ (memSetWord cg 1 0))      ; reset register counter in-place
          ; The symbol table holds this function's `let` bindings and
          ; nothing else. It used to persist across the whole module, so
          ; a `let`-bound `s` in one function shadowed the *parameter*
          ; `s` of a later one and emitted the earlier function's
          ; register - a name undefined in the function that used it.
          (_2 (memSetWord cg 6 vecNew))
          (_3 (memSetWord cg 7 vecNew))
          (_4 (memSetWord cg 16 vecNew))
          (_4b (memSetWord cg 20 vecNew))
          ; This function's own parameter names and float flags, for
          ; `%name` references in the body.
          (_5 (memSetWord cg 17 params))
          (_6 (memSetWord cg 18
                (let ((e (findFSig (memGetWord cg 15) name)))
                  (if (== e 0) 0 (memGetWord e 2))))))
      (let ((hdr (strConcat (cat4 "define i64 @"
                                  (strDup name)
                                  "("
                                  paramStr)
                            ") {")))
        (let ((cg1 (emitLine cg hdr)))
          ; Re-scan declarations to ensure types Vec is fresh before emitting body
          (let ((cg1b (scanDecls (memGetWord cg1 8) cg1 0)))
            ; A function that tail-calls itself gets a loop instead of a
            ; recursion: its parameters move into allocas, a header
            ; label is branched to, and the call assigns and jumps back.
            ; A function that does not is emitted exactly as before -
            ; same registers, same blocks, byte for byte - because most
            ; functions are that, and paying an alloca and two memory
            ; operations per parameter for a loop nobody enters is a
            ; cost with no buyer.
            ; The BARE name, because that is what a self call spells.
            ; `mangleDecl` rewrites an imported function's declaration
            ; name in place to `Mod$name`, so comparing against it
            ; matched nothing for every function in every imported
            ; module - which is all of `self_host/` and `stdlib/`, and
            ; therefore all of the code this exists to fix. It passed
            ; its test only because the test was an entry file.
            (let ((selfName (bareName (nodeA node))))
            (let ((wantsTCO (tailCallsSelf body selfName (vecLen params))))
              (let ((cg1c (if (== wantsTCO 1)
                              (openTailLoop selfName params cg1b)
                              cg1b)))
                (let ((cg2 (if (== wantsTCO 1)
                               (emitExprTail body cg1c)
                               (emitExpr body cg1c))))
                  {
                    (memSetWord cg2 27 0)
                    (memSetWord cg2 30 0)
                    ; A body that ended by jumping back to the header
                    ; has already terminated its block; a `ret` after it
                    ; is a second terminator and invalid LLVM.
                    (if (== (memGetWord cg2 31) 1)
                        {
                          (memSetWord cg2 31 0)
                          (emitLine cg2 "}")
                        }
                        (let ((ret (cat3 "  ret i64 " (strDup (memGetWord cg2 2)) "")))
                          (emitLine (emitLine cg2 ret) "}")))
                  }))))))))))

; Move every parameter into an alloca, bind it as mutable storage so
; body references load it, and open the loop the tail call jumps back
; to. `bindSym ... 1` is the same registration `mut` locals use, which
; is what makes `emitVar` emit a load without knowing about any of
; this.
; Everything after the last `$`: the source-spelled name of a
; declaration whose node `mangleDecl` may have rewritten to
; `Mod$name`.
(pub :: bareName (-> Int Int))
(pub fn (bareName s)
  (bareNameFrom s (- (strLen s) 1)))

(pub :: bareNameFrom (-> Int Int Int))
(pub fn (bareNameFrom s i)
  (if (< i 0)
      s
      (if (== (strByte s i) 36)
          (strSlice s (+ i 1) (- (strLen s) (+ i 1)))
          (bareNameFrom s (- i 1)))))

(pub :: openTailLoop (-> Int Int Int Int))
(pub fn (openTailLoop name params cg)
  (let ((slots vecNew)
        (hdrN (allocReg cg)))
    (let ((hdrB (cat2 "label_" (fmtInt hdrN))))
      {
        (allocParamSlots params slots cg 0)
        (memSetWord cg 27 (strDup name))
        (memSetWord cg 28 slots)
        (memSetWord cg 29 hdrB)
        (emitLine cg (cat2 "  br label %" hdrB))
        (emitLabel cg hdrB)
        cg
      })))

(pub :: allocParamSlots (-> Int Int Int Int Int))
(pub fn (allocParamSlots params slots cg i)
  (if (>= i (vecLen params))
      0
      (let ((pname (vecGet params i))
            (an (allocReg cg)))
        (let ((ar (cat2 "%a" (fmtInt an))))
          {
            (emitLine cg (cat2 (cat2 "  " ar) " = alloca i64"))
            (emitLine cg (cat4 "  store i64 %" (strDup pname) ", ptr " ar))
            ; Kind 2, not 1: the slot is loadable storage exactly as a
            ; `mut` binding's is, which is what makes `emitVar` emit a
            ; load without knowing about tail calls - but `set` must
            ; still refuse it. stage0 rejects `(set p v)` on a
            ; parameter as AX3012 and pre-TCO stage1 refused it too;
            ; binding parameters at kind 1 quietly made them
            ; assignable, and only inside self-recursive functions,
            ; which is the worst kind of divergence: one that depends
            ; on an unrelated property of the function it appears in.
            (bindSym cg pname ar (paramFloatFlag cg i) 2)
            (vecPush slots ar)
            (allocParamSlots params slots cg (+ i 1))
          }))))

; Whether parameter `i` of the function being emitted is a float, from
; the signature flags the emitter already carries.
(pub :: paramFloatFlag (-> Int Int Int))
(pub fn (paramFloatFlag cg i)
  (let ((flags (memGetWord cg 18)))
    (if (== flags 0)
        0
        (if (>= i (vecLen flags))
            0
            (vecGet flags i)))))

; The tail jump: every argument is evaluated into its own register
; FIRST, and only then are the parameter slots written. Assigning as
; each argument is computed would clobber a parameter a later argument
; still reads - `(go (- n 1) n)` would see the decremented `n` twice.
(pub :: emitTailJump (-> Int Int Int))
(pub fn (emitTailJump args cg)
  (let ((vals vecNew))
    {
      (evalTailArgs args vals cg 0)
      (storeTailSlots (memGetWord cg 28) vals cg 0)
      (emitLine cg (cat2 "  br label %" (memGetWord cg 29)))
      (memSetWord cg 31 1)
      (memSetWord cg 2 "0")
      cg
    }))

(pub :: evalTailArgs (-> Int Int Int Int Int))
(pub fn (evalTailArgs args vals cg i)
  (if (>= i (vecLen args))
      0
      {
        (emitExpr (vecGet args i) cg)
        (vecPush vals (strDup (memGetWord cg 2)))
        (evalTailArgs args vals cg (+ i 1))
      }))

(pub :: storeTailSlots (-> Int Int Int Int Int))
(pub fn (storeTailSlots slots vals cg i)
  (if (>= i (vecLen slots))
      0
      {
        (emitLine cg (cat4 "  store i64 " (vecGet vals i)
                           ", ptr " (vecGet slots i)))
        (storeTailSlots slots vals cg (+ i 1))
      }))

; ------------------------------------------------------------------
; Does `e` contain a call to `name` with `arity` arguments in TAIL
; position?
;
; Asked before a function is emitted so that the overwhelming majority
; of functions - which self-recurse nowhere - keep emitting exactly the
; LLVM they emitted before, parameters as SSA values and no loop
; header. Only a function that will actually use the loop pays for it.
;
; TAIL POSITION is the whole correctness question. Rewriting a call
; that is *not* in tail position does not crash; it returns the wrong
; answer, because the work waiting on the call's result never happens.
; So the positions here are exactly stage0's, and no others: the last
; expression of a `{}` block, both arms of an `if`, the body of a
; `let`, and the expression itself.
; ------------------------------------------------------------------
(pub :: tailCallsSelf (-> Int Int Int Int))
(pub fn (tailCallsSelf e name arity)
  (let ((tag (nodeTag e)))
    (if (== tag TAG_E_APP)
        (if (&& (strEq (spineHeadName e) name)
                (== (spineArgCount e 0) arity))
            1
            0)
    (if (== tag TAG_E_BEGIN)
        (let ((v (nodeA e)))
          (if (== (vecLen v) 0)
              0
              (tailCallsSelf (vecGet v (- (vecLen v) 1)) name arity)))
    (if (== tag TAG_E_IF)
        (if (== (tailCallsSelf (nodeB e) name arity) 1)
            1
            (tailCallsSelf (nodeC e) name arity))
    (if (== tag TAG_E_MATCH)
        (armsCallSelf (nodeB e) name arity 0)
        0))))))

; NOT a tail position: a `let` body. stage0 passes no tail context
; into one, and following it here cost two defects at once. A `mut`
; binding inside the loop re-executed its `alloca` on every iteration
; and grew the stack without bound - re-creating the exact overflow
; this feature removes, while emitting LLVM that looks optimised. And
; a local shadowing the function's own name (`(let ((f (lambda ...)))
; (f x))`) became a jump to the function instead of a call to the
; local: an infinite loop where the correct answer was a number.
; `while` bodies and `&&`/`||` operands are not tail positions either,
; for the same reason stage0 excludes them.

(pub :: armsCallSelf (-> Int Int Int Int Int))
(pub fn (armsCallSelf arms name arity i)
  (if (>= i (vecLen arms))
      0
      (if (== (tailCallsSelf (nodeB (vecGet arms i)) name arity) 1)
          1
          (armsCallSelf arms name arity (+ i 1)))))

; The head of an application spine, as a name, or "" when the head is
; not a plain name.
(pub :: spineHeadName (-> Int Int))
(pub fn (spineHeadName e)
  (if (== (nodeTag e) TAG_E_APP)
      (spineHeadName (nodeA e))
      (if (== (nodeTag e) TAG_E_VAR)
          (nodeA e)
          "")))

(pub :: spineArgCount (-> Int Int Int))
(pub fn (spineArgCount e acc)
  (if (== (nodeTag e) TAG_E_APP)
      (spineArgCount (nodeA e) (+ acc 1))
      acc))

; ------------------------------------------------------------------
; Emit `e` knowing it sits in tail position.
;
; Everything here either delegates to `emitExpr` unchanged or hands
; tail position to exactly the sub-expression that inherits it. The
; only thing it does differently is set `tailOK` for an application,
; which is what lets `dispatchCall` recognise the one call it may
; rewrite.
; ------------------------------------------------------------------
(pub :: emitExprTail (-> Int Int Int))
(pub fn (emitExprTail e cg)
  (let ((tag (nodeTag e)))
    (if (== tag TAG_E_APP)
        {
          (memSetWord cg 30 1)
          (let ((cgA (emitExpr e cg)))
            {
              (memSetWord cgA 30 0)
              cgA
            })
        }
    (if (== tag TAG_E_BEGIN)
        (emitSeqTail (nodeA e) cg 0)
    (if (== tag TAG_E_IF)
        (emitIfTail e cg)
    (if (== tag TAG_E_MATCH)
        (emitMatchTail e cg)
        (emitExpr e cg)))))))

; Every expression of a block but the last is ordinary; the last
; inherits tail position.
(pub :: emitSeqTail (-> Int Int Int Int))
(pub fn (emitSeqTail exprs cg i)
  (if (>= i (vecLen exprs))
      cg
      (if (== i (- (vecLen exprs) 1))
          (emitExprTail (vecGet exprs i) cg)
          (emitSeqTail exprs (emitExpr (vecGet exprs i) cg) (+ i 1)))))

; `match` in tail position: every arm body inherits it. This is the
; shape most recursive Axiom is written in - a walk over a `data`
; value - so leaving it out meant the optimisation missed the case it
; is most wanted for.
;
; Easier than `if`, because a match already routes its result through
; a heap cell rather than a phi: an arm that ends in a jump simply
; does not store and does not branch to the merge. And the merge block
; can never become unreachable, because the no-arm-matched fallback
; always branches to it.
(pub :: emitMatchTail (-> Int Int Int))
(pub fn (emitMatchTail node cg)
  (let ((scrutExpr (nodeA node))
        (arms (nodeB node))
        (ff (memAlloc 8))
        (_0 (memSetWord ff 0 (- 0 1)))
        (cg1 (emitExpr scrutExpr cg))
        (sv (strDup (memGetWord cg1 2)))
        (cn (allocReg cg1))
        (cell (regStr cn))
        (_1 (emitLine cg1 (cat3 (cat2 "  " cell)
                                " = call i64 @axiom_alloc(i64 8)"
                                "")))
        (mn (allocReg cg1))
        (mergeB (cat2 "label_" (fmtInt mn)))
        (cg2 (emitArmsTail arms sv cell mergeB cg1 0 ff))
        (_2 (emitLabel cg2 mergeB))
        (cg3 (loadWordAt cg2 cell 0))
        (armFlag (memGetWord ff 0))
        (_3 (memSetWord cg3 14 (if (== armFlag (- 0 1)) 0 armFlag)))
        (_4 (memSetWord cg3 31 0)))
    cg3))

(pub :: emitArmsTail (-> Int Int Int Int Int Int Int Int))
(pub fn (emitArmsTail arms sv cell mergeB cg i ff)
  (if (>= i (vecLen arms))
      {
        (emitLine cg (cat2 "  br label %" mergeB))
        cg
      }
      (let ((arm (vecGet arms i))
            (pat (nodeA arm))
            (body (nodeB arm))
            (nn (allocReg cg))
            (nextB (cat2 "label_" (fmtInt nn)))
            (mark (symMark cg)))
        (let ((cgP (emitPatMatch pat (strDup sv) nextB cg 0)))
          (let ((cgB (emitExprTail body cgP))
                (_ff (if (== i 0) (memSetWord ff 0 (memGetWord cgB 14)) 0)))
            (let ((termd (memGetWord cgB 31)))
              {
                ; An arm that jumped back to the loop header has
                ; nothing to store and nowhere to fall through to.
                (if (== termd 1)
                    0
                    {
                      (storeWordAt cgB cell 0 (strDup (memGetWord cgB 2)))
                      (emitLine cgB (cat2 "  br label %" mergeB))
                      0
                    })
                (memSetWord cgB 31 0)
                (emitLabel cgB nextB)
                (symRestore cgB mark)
                (emitArmsTail arms sv cell mergeB cgB (+ i 1) ff)
              }))))))

; `if` in tail position. Both arms inherit, and either may end with a
; branch back to the loop header instead of a value - so the merge
; block and its phi have to be built from whichever arms actually
; reach them. A phi naming a predecessor that jumped elsewhere is
; invalid LLVM, and a second terminator in a block is too.
(pub :: emitIfTail (-> Int Int Int))
(pub fn (emitIfTail node cg)
  (let ((testExpr (nodeA node))
        (thenExpr (nodeB node))
        (elseExpr (nodeC node))
        (cg1 (emitExpr testExpr cg))
        (testReg (strDup (memGetWord cg1 2)))
        (cmpN (allocReg cg1))
        (thenLbl (allocReg cg1))
        (elseLbl (allocReg cg1))
        (mergeLbl (allocReg cg1))
        (cmpR (regStr cmpN))
        (thenB (cat2 "label_" (fmtInt thenLbl)))
        (elseB (cat2 "label_" (fmtInt elseLbl)))
        (mergeB (cat2 "label_" (fmtInt mergeLbl)))
        (_1 (emitLine cg1 (cat4 (cat2 "  " cmpR)
                                " = icmp ne i64 "
                                testReg
                                ", 0")))
        (_2 (emitLine cg1 (cat4 (cat3 "  br i1 " cmpR ", label %")
                                thenB
                                (cat2 ", label %" elseB)
                                "")))
        (_3 (emitLabel cg1 thenB))
        (cg2 (emitExprTail thenExpr cg1))
        (thenTerm (memGetWord cg2 31))
        (thenVal (strDup (memGetWord cg2 2)))
        (thenFlag (memGetWord cg2 14))
        (thenPred (strDup (memGetWord cg2 11)))
        (_4 (if (== thenTerm 1) 0 (emitLine cg2 (cat2 "  br label %" mergeB))))
        (_4b (memSetWord cg2 31 0))
        (_5 (emitLabel cg2 elseB))
        (cg3 (emitExprTail elseExpr cg2))
        (elseTerm (memGetWord cg3 31))
        (elseVal (strDup (memGetWord cg3 2)))
        (elsePred (strDup (memGetWord cg3 11)))
        (_6 (if (== elseTerm 1) 0 (emitLine cg3 (cat2 "  br label %" mergeB)))))
    (if (&& (== thenTerm 1) (== elseTerm 1))
        ; Neither arm falls through: the whole `if` is a jump, there is
        ; nothing to merge, and the caller must not emit a `ret`.
        {
          (memSetWord cg3 31 1)
          cg3
        }
        (if (== thenTerm 1)
            ; Only the else arm reaches the merge, so its value is the
            ; result outright - a phi with one incoming edge would be
            ; legal but pointless.
            {
              (emitLabel cg3 mergeB)
              (memSetWord cg3 2 elseVal)
              (memSetWord cg3 14 (memGetWord cg3 14))
              (memSetWord cg3 31 0)
              cg3
            }
            (if (== elseTerm 1)
                {
                  (emitLabel cg3 mergeB)
                  (memSetWord cg3 2 thenVal)
                  (memSetWord cg3 14 thenFlag)
                  (memSetWord cg3 31 0)
                  cg3
                }
                (let ((_7 (emitLabel cg3 mergeB))
                      (phiN (allocReg cg3)))
                  (let ((phiR (regStr phiN)))
                    {
                      (emitLine cg3
                        (cat4 (cat3 (cat2 "  " phiR)
                                    " = phi i64 [ " thenVal)
                              (cat3 ", %" thenPred " ], [ ")
                              (cat3 elseVal ", %" elsePred)
                              " ]"))
                      (memSetWord cg3 2 phiR)
                      (memSetWord cg3 14 thenFlag)
                      (memSetWord cg3 31 0)
                      cg3
                    })))))))

(pub :: emitParams (-> Int Int Int Int))
(pub fn (emitParams params cg i)
  (if (>= i (vecLen params))
      ""
      (let ((pname (vecGet params i))
            (rest (emitParams params cg (+ i 1))))
        (if (== (strLen rest) 0)
            (cat3 "i64 %" (strDup pname) "")
            (cat3 (cat3 "i64 %" (strDup pname) ", ") rest "")))))

; ------------------------------------------------------------------
; Lambda expressions: capture, lifting, and the record convention.
;
; A lambda is lifted to a fresh top-level function `_lam_N` whose
; hidden first parameter `%_env` is the closure record: word 0 the
; code pointer, words 1.. the captured values. `emitIndirectCall`
; passes the record itself as that first argument on every call
; through a value, so a record built from a *bare top-level function*
; cannot point at the function directly - its parameters would shift
; by one. It points at a forwarding thunk (`_thunk_N`) that ignores
; the record and calls the function with the arguments unshifted.
; stage0 solves the same problem the other way, by giving every
; function the hidden parameter; either convention is sound alone,
; and the conformance suite observes exit codes, not symbol tables.
;
; Capture is by value, and captures *everything in scope* - every
; parameter of, and every binding in, the enclosing function that the
; lambda does not shadow with a parameter of its own - rather than
; walking the body for its free variables. The extra record words are
; unobservable, and the free-variable walker they replace is the kind
; of code whose one missed case (a pattern binder, a nested arm's
; variable) is a silent wrong capture. Each name is captured once,
; at its current resolution - `emitVar` does the resolving, so a
; `mut` binding is captured as the value it holds when the record is
; built, which is stage0's snapshot semantics too.
; ------------------------------------------------------------------

; The unique names the lambda captures: enclosing parameters first,
; then bindings in table order. A name the lambda's own parameter
; list shadows is skipped - inside the lifted body the capture would
; be bound as a symbol, and symbols resolve ahead of parameters.
(pub :: collectCapNames (-> Int Int Int))
(pub fn (collectCapNames cg lparams)
  (let ((out vecNew))
    {
      (capFromVec (memGetWord cg 17) lparams out 0)
      (capFromVec (memGetWord cg 6) lparams out 0)
      out
    }))

(pub :: capFromVec (-> Int Int Int Int Int))
(pub fn (capFromVec src lparams out i)
  (if (== src 0)
      0
      (if (>= i (vecLen src))
          0
          {
            (let ((name (vecGet src i)))
              (if (>= (strIndexIn lparams name) 0)
                  0
                  (if (>= (strIndexIn out name) 0)
                      0
                      (vecPush out name))))
            (capFromVec src lparams out (+ i 1))
          })))

(pub :: strIndexIn (-> Int Int Int))
(pub fn (strIndexIn v name)
  (if (== v 0)
      (- 0 1)
      (strIndexFrom v name 0)))

(pub :: strIndexFrom (-> Int Int Int Int))
(pub fn (strIndexFrom v name i)
  (if (>= i (vecLen v))
      (- 0 1)
      (if (strEq (vecGet v i) name)
          i
          (strIndexFrom v name (+ i 1)))))

; Evaluate each captured name in the enclosing scope, recording the
; value register and its float-ness. Goes through `emitVar` so a
; mutable binding is loaded, not aliased.
(pub :: capValues (-> Int Int Int Int Int Int))
(pub fn (capValues cg capNames capRegs capFloats i)
  (if (>= i (vecLen capNames))
      cg
      (let ((cg1 (emitVar (mkEVar (vecGet capNames i)) cg)))
        {
          (vecPush capRegs (strDup (memGetWord cg1 2)))
          (vecPush capFloats (memGetWord cg1 14))
          (capValues cg1 capNames capRegs capFloats (+ i 1))
        })))

; A lifted lambda, waiting for the enclosing function to close:
; word 0 name, word 1 params, word 2 body, word 3 capture names,
; word 4 capture float flags.
(pub :: mkLamDesc (-> Int Int Int Int Int Int))
(pub fn (mkLamDesc lname lparams body capNames capFloats)
  (let ((d (memAlloc 40)))
    {
      (memSetWord d 0 lname)
      (memSetWord d 1 lparams)
      (memSetWord d 2 body)
      (memSetWord d 3 capNames)
      (memSetWord d 4 capFloats)
      d
    }))

(pub :: emitLambda (-> Int Int Int))
(pub fn (emitLambda node cg)
  (let ((lparams (nodeA node))
        (body (nodeB node))
        (n (memGetWord cg 22)))
    (let ((lname (cat2 "_lam_" (fmtInt n)))
          (capNames (collectCapNames cg lparams))
          (capRegs vecNew)
          (capFloats vecNew))
      {
        (memSetWord cg 22 (+ n 1))
        (capValues cg capNames capRegs capFloats 0)
        (let ((k (vecLen capNames))
              (pn (allocReg cg))
              (fn2 (allocReg cg)))
          (let ((pr (regStr pn))
                (fr (cat2 "%f" (fmtInt fn2))))
            {
              (emitLine cg (strConcat (cat3 (cat2 "  " pr)
                                            " = call i64 @axiom_alloc(i64 "
                                            (fmtInt (* (+ k 1) 8)))
                                      ")"))
              (emitLine cg (cat4 (cat2 "  " fr)
                                 " = ptrtoint ptr @"
                                 (strDup lname)
                                 " to i64"))
              (storeWordAt cg pr 0 fr)
              (storeCaps cg pr capRegs 0)
              (memSetWord cg 21 (vecPush (memGetWord cg 21)
                                         (mkLamDesc lname lparams body
                                                    capNames capFloats)))
              (memSetWord cg 2 pr)
              (memSetWord cg 14 0)
              cg
            }))
      })))

(pub :: storeCaps (-> Int Int Int Int Int))
(pub fn (storeCaps cg base capRegs i)
  (if (>= i (vecLen capRegs))
      cg
      (storeCaps (storeWordAt cg base (+ 1 i) (vecGet capRegs i))
                 base capRegs (+ i 1))))

; Write out every lifted lambda the last function created - a lambda
; body may itself contain lambdas, which land on the same list and
; are drained by the same loop - then any new forwarding thunks.
(pub :: drainPending (-> Int Int))
(pub fn (drainPending cg)
  (let ((pend (memGetWord cg 21)))
    (if (== (vecLen pend) 0)
        (drainThunks cg)
        (drainPending (emitLamDef (vecPop pend) cg)))))

; The lifted function itself: `emitFnDef`'s shape with `%_env` in
; front, and the captures bound as symbols before the body - loaded
; from the record at the offsets `emitLambda` stored them to.
(pub :: emitLamDef (-> Int Int Int))
(pub fn (emitLamDef d cg)
  (let ((lname (memGetWord d 0))
        (lparams (memGetWord d 1))
        (body (memGetWord d 2))
        (capNames (memGetWord d 3))
        (capFloats (memGetWord d 4)))
    (let ((paramStr (emitParams lparams cg 0))
          (_ (memSetWord cg 1 0))
          (_2 (memSetWord cg 6 vecNew))
          (_3 (memSetWord cg 7 vecNew))
          (_4 (memSetWord cg 16 vecNew))
          (_4b (memSetWord cg 20 vecNew))
          (_5 (memSetWord cg 17 lparams))
          (_6 (memSetWord cg 18 0)))
      (let ((hdr (strConcat (cat4 "define i64 @"
                                  (strDup lname)
                                  "(i64 %_env"
                                  (if (== (strLen paramStr) 0)
                                      ""
                                      (cat2 ", " paramStr)))
                            ") {")))
        (let ((cg1 (emitLine cg hdr)))
          (let ((cg1b (scanDecls (memGetWord cg1 8) cg1 0)))
            (let ((cg1c (bindCaps cg1b capNames capFloats 0)))
              (let ((cg2 (emitExpr body cg1c)))
                (let ((ret (cat3 "  ret i64 " (strDup (memGetWord cg2 2)) "")))
                  (emitLine (emitLine cg2 ret) "}"))))))))))

(pub :: bindCaps (-> Int Int Int Int Int))
(pub fn (bindCaps cg capNames capFloats i)
  (if (>= i (vecLen capNames))
      cg
      (let ((cg1 (loadWordAt cg "%_env" (+ 1 i))))
        {
          (bindSym cg1 (vecGet capNames i)
                   (strDup (memGetWord cg1 2))
                   (vecGet capFloats i)
                   0)
          (bindCaps cg1 capNames capFloats (+ i 1))
        })))

; A forwarding thunk for a bare top-level function used as a value:
; takes the record it ignores, forwards the declared parameters.
(pub :: thunkIndexFor (-> Int Int Int Int))
(pub fn (thunkIndexFor cg full ar)
  (let ((idx (strIndexIn (memGetWord cg 23) full)))
    (if (>= idx 0)
        idx
        (let ((n (vecLen (memGetWord cg 23))))
          {
            (vecPush (memGetWord cg 23) (strDup full))
            (vecPush (memGetWord cg 24) ar)
            n
          }))))

(pub :: fnArityOf (-> Int Int Int))
(pub fn (fnArityOf decls full)
  (fnArityIn decls full 0))

(pub :: fnArityIn (-> Int Int Int Int))
(pub fn (fnArityIn decls full i)
  (if (>= i (vecLen decls))
      0
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeA d) full))
            (vecLen (nodeB d))
            (fnArityIn decls full (+ i 1))))))

(pub :: drainThunks (-> Int Int))
(pub fn (drainThunks cg)
  (let ((i (memGetWord cg 25)))
    (if (>= i (vecLen (memGetWord cg 23)))
        cg
        {
          (memSetWord cg 25 (+ i 1))
          (drainThunks (emitThunkDef i cg))
        })))

(pub :: emitThunkDef (-> Int Int Int))
(pub fn (emitThunkDef i cg)
  (let ((full (vecGet (memGetWord cg 23) i))
        (ar (vecGet (memGetWord cg 24) i)))
    (let ((cg1 (emitLine cg (strConcat (cat4 "define i64 @_thunk_"
                                             (fmtInt i)
                                             "(i64 %_env"
                                             (thunkParamStr ar 0))
                                       ") {"))))
      (let ((cg2 (emitLine cg1 (strConcat (cat4 "  %r = call i64 @"
                                                (strDup full)
                                                "("
                                                (thunkArgStr ar 0))
                                          ")"))))
        (emitLine (emitLine cg2 "  ret i64 %r") "}")))))

(pub :: thunkParamStr (-> Int Int Int))
(pub fn (thunkParamStr ar j)
  (if (>= j ar)
      ""
      (cat3 (cat2 ", i64 %a" (fmtInt j)) (thunkParamStr ar (+ j 1)) "")))

(pub :: thunkArgStr (-> Int Int Int))
(pub fn (thunkArgStr ar j)
  (if (>= j ar)
      ""
      (let ((rest (thunkArgStr ar (+ j 1))))
        (cat3 (cat2 "i64 %a" (fmtInt j))
              (if (== (strLen rest) 0) "" (cat2 ", " rest))
              ""))))


; ------------------------------------------------------------------
; `match`.
;
; A constructor with fields is a heap block whose word 0 is the tag; a
; nullary constructor of a `data` type is emitted as the tag itself. So
; where to look for the tag is decided by the constructor named in the
; *pattern*, which is static, and not by inspecting the value, which
; cannot say.
;
; The result goes through a one-word heap cell rather than a phi. A phi
; would need one incoming edge per arm, and building that incrementally
; while the arms are still being emitted is harder to get right than a
; store per arm and a single load at the end.
; ------------------------------------------------------------------
(pub :: patHead (-> Int Int))
(pub fn (patHead pat)
  (if (== (nodeTag pat) TAG_E_VAR)
      (nodeA pat)
      (if (== (nodeTag pat) TAG_E_APP)
          (patHead (nodeA pat))
          0)))

(pub :: loadWordAt (-> Int Int Int Int))
(pub fn (loadWordAt cg base idx)
  (let ((pn (allocReg cg))
        (pr (regStr pn))
        (_1 (emitLine cg (cat4 (cat2 "  " pr)
                               " = inttoptr i64 "
                               base
                               " to ptr")))
        (an (allocReg cg))
        (ar (regStr an))
        (_2 (emitLine cg (cat4 (cat3 (cat2 "  " ar)
                                     " = getelementptr i64, ptr "
                                     pr)
                               ", i64 "
                               (fmtInt idx)
                               "")))
        (vn (allocReg cg))
        (vr (regStr vn))
        (_3 (emitLine cg (cat4 (cat2 "  " vr)
                               " = load i64, ptr "
                               ar
                               "")))
        (_4 (memSetWord cg 2 vr)))
    cg))

; The four symbol vectors stay parallel by construction: this is the
; only place that pushes them. `kind` 0 binds a value register, 1 an
; alloca whose reads load.
(pub :: bindSym (-> Int Int Int Int Int Int))
(pub fn (bindSym cg name reg isFloat kind)
  {
    (memSetWord cg 6 (vecPush (memGetWord cg 6) name))
    (memSetWord cg 7 (vecPush (memGetWord cg 7) reg))
    (memSetWord cg 16 (vecPush (memGetWord cg 16) isFloat))
    (memSetWord cg 20 (vecPush (memGetWord cg 20) kind))
    cg
  })

; Truncate the three parallel symbol vectors back to `mark`, undoing
; every binding made since. An arm's binders must not survive into the
; next arm's emission: a later arm mentioning a name only an *earlier*
; arm bound would otherwise resolve to the earlier arm's register - a
; value that does not exist on the path that reaches it.
(pub :: symMark (-> Int Int))
(pub fn (symMark cg)
  (vecLen (memGetWord cg 6)))

(pub :: symRestore (-> Int Int Int))
(pub fn (symRestore cg mark)
  {
    (memSetWord (memGetWord cg 6) 0 mark)
    (memSetWord (memGetWord cg 7) 0 mark)
    (memSetWord (memGetWord cg 16) 0 mark)
    (memSetWord (memGetWord cg 20) 0 mark)
    cg
  })

(pub :: emitMatch (-> Int Int Int))
(pub fn (emitMatch node cg)
  (let ((scrutExpr (nodeA node))
        (arms (nodeB node))
        ; A compile-time cell for the first arm's float flag - a local
        ; rather than a CG field, so a nested match cannot clobber the
        ; outer one's. A well-typed match yields one type from every
        ; arm, so the first arm speaks for the form.
        (ff (memAlloc 8))
        (_0 (memSetWord ff 0 (- 0 1)))
        (cg1 (emitExpr scrutExpr cg))
        (sv (strDup (memGetWord cg1 2)))
        (cn (allocReg cg1))
        (cell (regStr cn))
        (_1 (emitLine cg1 (cat3 (cat2 "  " cell)
                                " = call i64 @axiom_alloc(i64 8)"
                                "")))
        (mn (allocReg cg1))
        (mergeB (cat2 "label_" (fmtInt mn)))
        (cg2 (emitArms arms sv cell mergeB cg1 0 ff))
        (_2 (emitLabel cg2 mergeB))
        (cg3 (loadWordAt cg2 cell 0))
        (armFlag (memGetWord ff 0))
        (_3 (memSetWord cg3 14 (if (== armFlag (- 0 1)) 0 armFlag))))
    cg3))

(pub :: emitArms (-> Int Int Int Int Int Int Int Int))
(pub fn (emitArms arms sv cell mergeB cg i ff)
  (if (>= i (vecLen arms))
      ; No arm matched. The cell still holds zero, which is what a
      ; non-exhaustive match answers here; stage0 reports that as a
      ; diagnostic, and this compiler has no checker yet.
      {
        (emitLine cg (cat2 "  br label %" mergeB))
        cg
      }
      (let ((arm (vecGet arms i))
            (pat (nodeA arm))
            (body (nodeB arm))
            (nn (allocReg cg))
            (nextB (cat2 "label_" (fmtInt nn)))
            (mark (symMark cg)))
        ; The pattern compiles to a chain of tests that each branch to
        ; `nextB` on mismatch and fall through on success, binding as
        ; they go; the body is then emitted in whatever block the last
        ; test left current.
        (let ((cgP (emitPatMatch pat (strDup sv) nextB cg 0)))
          (let ((cgB (emitExpr body cgP))
                (_ff (if (== i 0) (memSetWord ff 0 (memGetWord cgB 14)) 0))
                (bv (strDup (memGetWord cgB 2)))
                (_d (storeWordAt cgB cell 0 bv))
                (_e (emitLine cgB (cat2 "  br label %" mergeB)))
                (_f (emitLabel cgB nextB))
                (_g (symRestore cgB mark)))
            (emitArms arms sv cell mergeB cgB (+ i 1) ff))))))

; ------------------------------------------------------------------
; Pattern compilation, recursive over the pattern's structure.
;
; `emitPatMatch` emits the tests for `pat` against the value held in
; `vr`: every failing comparison branches to `failB`, success falls
; through into a fresh block with the pattern's binders bound. Three
; shapes existed before this and two of them were wrong. A literal
; pattern was indistinguishable from a binder (`patHead` answered 0 for
; both), so `(1 body)` matched *everything*. And a nested constructor
; pattern collected only its binder names - `(Cons h (Cons h2 t))`
; walked the outer application, took `(Cons h2 t)` as if it were a
; name, and bound nothing inside it, so the emitted body referred to
; registers no instruction defines.
;
; `isFloat` is the binder flag when `pat` is a bare name: 0 at the top
; of an arm (the scrutinee's own float-ness is not tracked), the
; field's declared flag when descending into a constructor.
; ------------------------------------------------------------------
(pub :: emitPatMatch (-> Int Int Int Int Int Int))
(pub fn (emitPatMatch pat vr failB cg isFloat)
  (let ((tag (nodeTag pat)))
    (if (== tag TAG_E_INT)
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
    ; A char-literal pattern tests its codepoint word, exactly as an
    ; integer literal does - `(match c ('a' 7) (x 9))` is pinned by
    ; tests/selfhost/470-char-literals.ax, and an unknown tag here
    ; would silently match everything.
    (if (== tag TAG_E_CHAR)
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
    (if (== tag TAG_E_FLT)
        ; Bit-pattern equality, which is what stage0's literal float
        ; pattern also compiles to (one word against one word).
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
    (if (== tag TAG_E_STR)
        ; A string literal pattern compares against the interned
        ; literal's header address - string literals of equal text
        ; share one global (`internString` dedups by content), which is
        ; also how stage0's comparison against its interned constant
        ; behaves.
        (let ((cgS (emitStrExpr pat cg)))
          (emitPatTest (strDup (memGetWord cgS 2)) vr failB cgS))
    (if (== tag TAG_E_VAR)
        ; `true`/`false` are literal tests. Every OTHER bare name - a
        ; constructor's included - is a binder: stage0 parses a bare
        ; identifier in pattern position as a variable pattern, and
        ; only the parenthesised `(Nil)` (TAG_P_CON0 below) tests a
        ; tag. `_` is just a name nobody references.
        (if (strEq (nodeA pat) "true")
            (emitPatTest (constStr 1) vr failB cg)
        (if (strEq (nodeA pat) "false")
            (emitPatTest (constStr 0) vr failB cg)
            (bindSym cg (nodeA pat) (strDup vr) isFloat 0)))
    (if (== tag TAG_P_CON0)
        ; A nullary constructor of a type that unboxes (rep 1 or 2) IS
        ; its tag: compare the value directly. Correct even when the
        ; scrutinee is a boxed sibling - a heap pointer never equals a
        ; small immediate tag, so the arm just fails. Only a nullary
        ; constructor of a non-unboxing type is still a one-word block
        ; whose tag loads from word 0.
        (let ((entry (lookupType (memGetWord cg 3) (nodeA pat))))
          (if (== entry 0)
              (bindSym cg (nodeA pat) (strDup vr) isFloat 0)
              (if (!= (eRep entry) 0)
                  (emitPatTest (constStr (eTag entry)) vr failB cg)
                  (let ((cgL (loadWordAt cg vr 0)))
                    (emitPatTest (constStr (eTag entry))
                                 (strDup (memGetWord cgL 2))
                                 failB cgL)))))
    (if (== tag TAG_E_APP)
        (let ((cname (patHead pat)))
          (let ((entry (if (== cname 0) 0 (lookupType (memGetWord cg 3) cname))))
            (if (== entry 0)
                ; An application whose head is no constructor - nothing
                ; well-typed produces this; match everything, bind
                ; nothing, as before.
                cg
                ; A fieldful pattern in a MIXED type must not load word
                ; 0 unguarded: the scrutinee may be an immediate
                ; nullary sibling, and word 0 of a small integer is a
                ; crash. `emitCondTagRead` tests `< 4096` first. In an
                ; all-boxed type the plain load stays.
                (let ((cgL (if (== (eRep entry) 2)
                               (emitCondTagRead vr cg)
                               (loadWordAt cg vr 0))))
                  (let ((cgT (emitPatTest (constStr (eTag entry))
                                          (strDup (memGetWord cgL 2))
                                          failB cgL)))
                    (emitPatFields (patArgs pat vecNew)
                                   (eFieldFlags entry)
                                   vr failB cgT 0))))))
    cg)))))))))

; The tag of a value whose type mixes representations, decided at
; runtime: below 4096 the value IS the tag (no immediate reaches the
; limit, every mmap-page heap address exceeds it), at or above it the
; tag is word 0. Globally-unique tags make the one read correct
; against any constructor's compare. The result travels through a
; one-word heap cell rather than a phi, the same idiom `match` uses
; for its own result.
(pub :: emitCondTagRead (-> Int Int Int))
(pub fn (emitCondTagRead vr cg)
  (let ((cellN (allocReg cg))
        (cn (allocReg cg))
        (immN (allocReg cg))
        (boxN (allocReg cg))
        (mergeN (allocReg cg)))
    (let ((cell (regStr cellN))
          (cr (cat2 "%c" (fmtInt cn)))
          (immB (cat2 "label_" (fmtInt immN)))
          (boxB (cat2 "label_" (fmtInt boxN)))
          (mergeB (cat2 "label_" (fmtInt mergeN))))
      (let ((cg1 (emitLine cg (cat3 (cat2 "  " cell)
                                    " = call i64 @axiom_alloc(i64 8)"
                                    ""))))
        (let ((cg2 (emitLine cg1 (cat4 (cat2 "  " cr)
                                       " = icmp slt i64 "
                                       (strDup vr)
                                       ", 4096"))))
          (let ((cg3 (emitLine cg2 (cat4 (cat3 "  br i1 " cr ", label %")
                                         immB
                                         (cat2 ", label %" boxB)
                                         ""))))
            (let ((cg4 (emitLabel cg3 immB)))
              (let ((cg5 (storeWordAt cg4 cell 0 (strDup vr))))
                (let ((cg6 (emitLine cg5 (cat2 "  br label %" mergeB))))
                  (let ((cg7 (emitLabel cg6 boxB)))
                    (let ((cg8 (loadWordAt cg7 vr 0)))
                      (let ((cg9 (storeWordAt cg8 cell 0 (strDup (memGetWord cg8 2)))))
                        (let ((cg10 (emitLine cg9 (cat2 "  br label %" mergeB))))
                          (let ((cg11 (emitLabel cg10 mergeB)))
                            (loadWordAt cg11 cell 0)))))))))))))))

; One `icmp eq` against `want`, branching to `failB` on mismatch and
; into a fresh block on success.
(pub :: emitPatTest (-> Int Int Int Int Int))
(pub fn (emitPatTest want vr failB cg)
  (let ((tn (allocReg cg))
        (cn (allocReg cg)))
    (let ((tr (regStr tn))
          (contB (cat2 "label_" (fmtInt cn))))
      {
        (emitLine cg (cat4 (cat2 "  " tr)
                           " = icmp eq i64 "
                           (strDup vr)
                           (cat2 ", " want)))
        (emitLine cg (cat4 (cat3 "  br i1 " tr ", label %")
                           contB
                           (cat2 ", label %" failB)
                           ""))
        (emitLabel cg contB)
        cg
      })))

; Load each field of the block in `vr` (fields start at word 1, past
; the tag) and recurse into the subpattern, carrying the field's
; declared float flag to whatever binder it bottoms out in.
(pub :: emitPatFields (-> Int Int Int Int Int Int Int))
(pub fn (emitPatFields subs flags vr failB cg i)
  (if (>= i (vecLen subs))
      cg
      (let ((cgL (loadWordAt cg vr (+ i 1))))
        (let ((fr (strDup (memGetWord cgL 2)))
              (fl (if (== flags 0)
                      0
                      (if (< i (vecLen flags)) (vecGet flags i) 0))))
          (emitPatFields subs flags vr failB
                         (emitPatMatch (vecGet subs i) fr failB cgL fl)
                         (+ i 1))))))

; Subpattern nodes of a constructor pattern, in field order -
; `(Cons h t)` yields the node for `h` then the node for `t`.
(pub :: patArgs (-> Int Int Int))
(pub fn (patArgs pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
      {
        (patArgs (nodeA pat) acc)
        (vecPush acc (nodeB pat))
        acc
      }
      acc))

; ------------------------------------------------------------------
; Expression dispatch.
; ------------------------------------------------------------------
(pub :: emitExpr (-> Int Int Int))
(pub fn (emitExpr node cg)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_E_INT)   (emitInt node cg)
    ; A char literal is its codepoint word; emission is an integer's.
    (if (== tag TAG_E_CHAR)  (emitInt node cg)
    ; A cond that reached emission without passing the emitFnDef
    ; pre-pass - a macro template is the one road here - lowers on the
    ; fly to the same if-chain and re-dispatches.
    (if (== tag TAG_E_COND)  (emitExpr (lowerConds node) cg)
    (if (== tag TAG_E_FLT)   (emitFlt node cg)
    (if (== tag TAG_E_VAR)   (emitVar node cg)
    (if (== tag TAG_E_APP)   (emitApp node cg)
    (if (== tag TAG_E_LET)   (emitLet node cg)
    (if (== tag TAG_E_IF)    (emitIf node cg)
    (if (== tag TAG_E_BEGIN) (emitBegin node cg)
    (if (== tag TAG_E_STR)   (emitStrExpr node cg)
    (if (== tag TAG_E_MATCH) (emitMatch node cg)
    (if (== tag TAG_E_LETM)  (emitLetM node cg)
    (if (== tag TAG_E_SET)   (emitSet node cg)
    (if (== tag TAG_E_WHILE) (emitWhile node cg)
    (if (== tag TAG_E_FIELD) (emitField node cg)
    (if (== tag TAG_E_SETF)  (emitSetF node cg)
    (if (== tag TAG_E_LAM)   (emitLambda node cg)
    (if (== tag TAG_E_STRUCTCON) (emitStructConExpr node cg)
    ; stage1 does not lower the effect system - evidence globals,
    ; outward dispatch and the unhandled trap are all stage0-only. It
    ; refuses here rather than emitting something. The form used to
    ; parse as an application, which emitted
    ; `call i64 @Console(i64 %IO, i64 %Alloc)` - a call to a symbol
    ; nothing defines, plus references to `%IO` and `%Alloc` that are
    ; not values at all - so the failure surfaced out of llc as a
    ; complaint about generated code rather than as an unsupported
    ; feature. Exit 3 is the driver's "cannot compile this" status.
    (if (== tag TAG_E_HANDLE)
        (dieImport "error: stage1 cannot lower the effect system: handle of "
                   (handleEffectNames node))
    ; `(alloc Type [count])` allocates nothing. stage0's IR generator
    ; has no EAlloc case, so the form falls to its catch-all constant
    ; 0; emitting a real allocation here would be stage1 doing more
    ; than the compiler it must agree with.
    (if (== tag TAG_E_ALLOC)
        {
          (memSetWord cg 2 (constStr 0))
          (memSetWord cg 14 0)
          cg
        }
    (emitDefault node cg)))))))))))))))))))))))

; The handled effects, comma-separated, for the refusal message - so
; the report names what it could not compile rather than only that it
; could not.
(pub :: handleEffectNames (-> Int Int))
(pub fn (handleEffectNames node)
  (handleEffectNamesFrom (nodeB node) 0 ""))

(pub :: handleEffectNamesFrom (-> Int Int Int Int))
(pub fn (handleEffectNamesFrom effs i acc)
  (if (>= i (vecLen effs))
      (if (== (strLen acc) 0) "(no effects)" acc)
      (handleEffectNamesFrom effs (+ i 1)
        (if (== i 0)
            (nodeA (vecGet effs i))
            (strConcat (strConcat acc ", ") (nodeA (vecGet effs i)))))))

; `(struct Name field...)` - the keyword construction form. It builds
; the identical block the application spelling `(Name field...)`
; builds, through the same emitConstructor, because stage0 lowers
; both to a heap block of `fields * 8` bytes with argument i at word
; i. A name with no registry entry cannot reach here on a checked
; program - it is AX3002 - but emission must not segfault on one, so
; an unknown name answers the constant 0, the same shape stage0's
; generator falls back to.
(pub :: emitStructConExpr (-> Int Int Int))
(pub fn (emitStructConExpr node cg)
  (let ((types (memGetWord cg 3))
        (args (nodeB node)))
    (let ((entry (lookupType types (nodeA node))))
      (if (== entry 0)
          {
            (memSetWord cg 2 (constStr 0))
            (memSetWord cg 14 0)
            cg
          }
          (zeroFloat (emitConstructor (nodeA node) args (eKind entry)
                                      (eArity entry) (eTag entry)
                                      (eRep entry) cg))))))

; `(set base.field v)`: the base evaluates once, the field resolves as
; a read does, and the value is stored at its offset. The whole form
; evaluates to 0 - stage0's rule, and NOT plain `set`'s, which answers
; the stored value.
(pub :: emitSetF (-> Int Int Int))
(pub fn (emitSetF node cg)
  (let ((cgB (emitExpr (nodeA node) cg)))
    (let ((base (strDup (memGetWord cgB 2)))
          (fi (findStructField (memGetWord cgB 3) (nodeB node))))
      (if (== fi 0)
          (dieImport "error: unknown struct field: " (nodeB node))
          (let ((cgV (emitExpr (nodeC node) cgB)))
            (let ((v (strDup (memGetWord cgV 2))))
              (let ((cgS (storeWordAt cgV base (nodeA fi) v)))
                {
                  (memSetWord cgS 2 (constStr 0))
                  (memSetWord cgS 14 0)
                  cgS
                })))))))

; `base.field`: the field resolves by name across the struct registry -
; first declaring struct wins, the same simplification stage0 makes for
; float-ness - and a struct carries no tag word, so field i is word i.
(pub :: emitField (-> Int Int Int))
(pub fn (emitField node cg)
  (let ((cgB (emitExpr (nodeA node) cg)))
    (let ((base (strDup (memGetWord cgB 2)))
          (fi (findStructField (memGetWord cgB 3) (nodeB node))))
      (if (== fi 0)
          (dieImport "error: unknown struct field: " (nodeB node))
          (let ((cgL (loadWordAt cgB base (nodeA fi))))
            {
              (memSetWord cgL 14 (nodeB fi))
              cgL
            })))))

; The field's (index, floatFlag) as an inert node, 0 when no struct
; declares the name.
(pub :: findStructField (-> Int Int Int))
(pub fn (findStructField types name)
  (findStructFieldIn types name 0))

(pub :: findStructFieldIn (-> Int Int Int Int))
(pub fn (findStructFieldIn types name i)
  (if (>= i (vecLen types))
      0
      (let ((e (vecGet types i)))
        (if (== (eKind e) TF_STRUCT)
            (let ((idx (fieldIndexIn (eFieldFlags e) name 0)))
              (if (< idx 0)
                  (findStructFieldIn types name (+ i 1))
                  (mkNode TAG_NIL idx
                          (nodeB (vecGet (eFieldFlags e) idx)) 0)))
            (findStructFieldIn types name (+ i 1))))))

(pub :: fieldIndexIn (-> Int Int Int Int))
(pub fn (fieldIndexIn fields name i)
  (if (>= i (vecLen fields))
      (- 0 1)
      (if (strEq (nodeA (vecGet fields i)) name)
          i
          (fieldIndexIn fields name (+ i 1)))))

; E_Int
(pub :: emitInt (-> Int Int Int))
(pub fn (emitInt node cg)
  (let ((v (nodeA node)))
    {
      (memSetWord cg 2 (constStr v))
      (memSetWord cg 14 0)
      cg
    }))

; E_Flt: the node already holds the IEEE-754 bits, and the bits *are*
; the value, so a float literal is the same immediate an integer is -
; only the flag differs, and the flag is what routes `(+ x 1.5)` to
; `fadd`.
(pub :: emitFlt (-> Int Int Int))
(pub fn (emitFlt node cg)
  (let ((bits (nodeA node)))
    {
      (memSetWord cg 2 (constStr bits))
      (memSetWord cg 14 1)
      cg
    }))

; E_Var: emit register reference (%name) or nullary constructor tag constant.
; Checks symbol table first (let-bound variables), then type registry (constructors).
(pub :: emitVar (-> Int Int Int))
(pub fn (emitVar node cg)
  (let ((name (nodeA node)))
    ; A bare reference to a macro expands with zero arguments - stage0
    ; rewrites every expression whose head (or self) names a macro,
    ; before any scoping exists, so a macro shadows even a local of the
    ; same name. Parity requires checking here ahead of the symbol
    ; table.
    (let ((mac (findMacro cg name)))
    (if (!= mac 0)
        (emitMacroCall mac vecNew cg)
    ; A zero-argument primitive is spelled `(__argc)`, which is a bare
    ; variable reference by the time it gets here. Without this it fell
    ; through to the undefined-name emission `%__argc`.
    ;
    ; `__axiom_arena_mark` is the other one, and it was NOT handled -
    ; the comment here named it while the code did not, so
    ; `tests/stdlib/160-arena.ax` emitted `%__axiom_arena_mark`, a
    ; value nothing defines, and llc rejected the module. stage0
    ; carries a comment about hitting exactly this, for exactly this
    ; primitive, and calls it "the only one that could go wrong".
    (if (|| (strEq name "__argc") (strEq name "__axiom_arena_mark"))
        (zeroFloat (emitPrim name vecNew cg))
    (let ((symReg (lookupSym cg name)))
      (if (!= symReg 0)
          (if (>= (lookupSymKind cg name) 1)
              ; A mutable binding: the register is its storage, and the
              ; value is a fresh load - which is what makes a `set` in
              ; a loop body visible on the next trip's read.
              (let ((rn (allocReg cg)))
                (let ((r (regStr rn)))
                  {
                    (emitLine cg (cat4 (cat2 "  " r)
                                       " = load i64, ptr "
                                       (strDup symReg)
                                       ""))
                    (memSetWord cg 2 r)
                    (memSetWord cg 14 (lookupSymFloat cg name))
                    cg
                  }))
              {
                (memSetWord cg 2 (strDup symReg))
                (memSetWord cg 14 (lookupSymFloat cg name))
                cg
              })
          (if (strEq name "true")
              {
                (memSetWord cg 2 (constStr 1))
                (memSetWord cg 14 0)
                cg
              }
          (if (strEq name "false")
              {
                (memSetWord cg 2 (constStr 0))
                (memSetWord cg 14 0)
                cg
              }
          ; The constructor table is consulted before the nullary
          ; function table: stage0's EVar lowering tries
          ; find_constructor first, so a name that is both - a nullary
          ; constructor and a nullary function - yields the constructor
          ; value, and parity means agreeing on that order.
          (let ((entry (lookupType (memGetWord cg 3) name)))
            (if (!= entry 0)
                (if (== (eArity entry) 0)
                    ; A bare nullary constructor: an immediate tag for
                    ; an all-nullary type, a fresh one-word block
                    ; otherwise - the same split construction makes.
                    (zeroFloat (emitConstructor name vecNew (eKind entry) 0 (eTag entry) (eRep entry) cg))
                    (let ((z 0))
                      {
                        (memSetWord cg 2 (constStr z))
                        (memSetWord cg 14 0)
                        cg
                      }))
                ; A nullary function referenced bare is a call, not a
                ; register. Emitting `%answer` names a value nothing
                ; defines. The decl list carries mangled names, so the
                ; reference is resolved through the map before it is
                ; compared or emitted.
                (let ((full (mangledFor cg name)))
                  (if (isNullaryFn (memGetWord cg 8) full)
                      (let ((rn (allocReg cg)))
                        (let ((r (regStr rn)))
                          {
                            (emitLine cg (cat4 (cat2 "  " r)
                                               " = call i64 @"
                                               (strDup full)
                                               "()"))
                            (memSetWord cg 2 r)
                            (memSetWord cg 14 (fnRetIsFloat cg full))
                            cg
                          }))
                      ; A bare reference to a *defined multi-parameter
                      ; function* is a function value: a one-word
                      ; closure record holding a code pointer.
                      ; `emitIndirectCall` passes the record as the
                      ; callee's hidden first argument, so the record
                      ; points at a forwarding thunk rather than at
                      ; the function itself - see the lambda section.
                      ; A parameter of the function being emitted wins
                      ; first, though: a param named `lex` is the
                      ; param, not the lexer entry point it shadows.
                      (if (&& (isDefinedFn (memGetWord cg 8) full)
                              (< (paramIndexOf cg name) 0))
                          (let ((ti (thunkIndexFor cg full
                                      (fnArityOf (memGetWord cg 8) full)))
                                (pn (allocReg cg))
                                (fn2 (allocReg cg)))
                            (let ((pr (regStr pn))
                                  (fr (cat2 "%f" (fmtInt fn2))))
                              {
                                (emitLine cg (cat2 (cat2 "  " pr)
                                                   " = call i64 @axiom_alloc(i64 8)"))
                                (emitLine cg (cat4 (cat2 "  " fr)
                                                   " = ptrtoint ptr @_thunk_"
                                                   (fmtInt ti)
                                                   " to i64"))
                                (storeWordAt cg pr 0 fr)
                                (memSetWord cg 2 pr)
                                (memSetWord cg 14 0)
                                cg
                              }))
                      ; A parameter reference: `%name` was emitted in
                      ; the function header, and the signature says
                      ; whether it is a float.
                      (let ((x (cat2 "%" (strDup name))))
                        {
                          (memSetWord cg 2 x)
                          (memSetWord cg 14 (paramFloatByName cg name))
                          cg
                        })))))))))))))))

; Index of `name` in the current function's parameter list, -1 when it
; is no parameter.
(pub :: paramIndexOf (-> Int Int Int))
(pub fn (paramIndexOf cg name)
  (let ((params (memGetWord cg 17)))
    (if (== params 0)
        (- 0 1)
        (paramIndexIn params name 0))))

(pub :: paramIndexIn (-> Int Int Int Int))
(pub fn (paramIndexIn params name i)
  (if (>= i (vecLen params))
      (- 0 1)
      (if (strEq (vecGet params i) name)
          i
          (paramIndexIn params name (+ i 1)))))

(pub :: isDefinedFn (-> Int Int Bool))
(pub fn (isDefinedFn decls name)
  (if (== decls 0)
      false
      (isDefinedFnIn decls name 0)))

(pub :: isDefinedFnIn (-> Int Int Int Bool))
(pub fn (isDefinedFnIn decls name i)
  (if (>= i (vecLen decls))
      false
      (let ((d (vecGet decls i)))
        (if (&& (== (nodeTag d) TAG_D_FN)
                (&& (strEq (nodeA d) name) (> (vecLen (nodeB d)) 0)))
            true
            (isDefinedFnIn decls name (+ i 1))))))

(pub :: lookupSymKind (-> Int Int Int))
(pub fn (lookupSymKind cg name)
  (lookupSymFloatIn (memGetWord cg 6) (memGetWord cg 20) name
                    (- (vecLen (memGetWord cg 6)) 1)))

(pub :: lookupSymFloat (-> Int Int Int))
(pub fn (lookupSymFloat cg name)
  (lookupSymFloatIn (memGetWord cg 6) (memGetWord cg 16) name
                    (- (vecLen (memGetWord cg 6)) 1)))

(pub :: lookupSymFloatIn (-> Int Int Int Int Int))
(pub fn (lookupSymFloatIn syms flags name i)
  (if (< i 0)
      0
      (if (strEq (vecGet syms i) name)
          (if (< i (vecLen flags)) (vecGet flags i) 0)
          (lookupSymFloatIn syms flags name (- i 1)))))

(pub :: lookupSym (-> Int Int Int))
(pub fn (lookupSym cg name)
  (let ((syms (memGetWord cg 6))
        (regs (memGetWord cg 7)))
    (lookupSymIn syms regs name (- (vecLen syms) 1))))

(pub :: lookupSymIn (-> Int Int Int Int Int))
(pub fn (lookupSymIn syms regs name i)
  (if (< i 0)
      0
      (if (strEq (vecGet syms i) name)
          (vecGet regs i)
          (lookupSymIn syms regs name (- i 1)))))

; ------------------------------------------------------------------
; E_App: flatten chain, dispatch.
; ------------------------------------------------------------------
(pub :: emitApp (-> Int Int Int))
(pub fn (emitApp node cg)
  {
    (memSetWord cg 5 vecNew)
    (walkAppChain node cg)
  })

(pub :: walkAppChain (-> Int Int Int))
(pub fn (walkAppChain node cg)
  (let ((fnNode (nodeA node))
        (argNode (nodeB node)))
    {
      (vecPush (memGetWord cg 5) argNode)
    }
    (if (== (nodeTag fnNode) TAG_E_VAR)
        (dispatchCall (nodeA fnNode) cg)
    (if (== (nodeTag fnNode) TAG_E_APP)
        (walkAppChain fnNode cg)
        ; A head that is neither a name nor another application - a
        ; lambda, an `if`, a `match`, a block. This branch used to
        ; write the constant 0 and return, which does not emit a
        ; wrong call: it DELETES the application, so
        ; `((lambda (x) x) 7)` evaluated to 0
        ; (tests/stdlib/280-function-application.ax). stage0 reached
        ; the same shape once from the other side, lowering a non-name
        ; head to a call to the undefined symbol `@unknown`.
        ;
        ; The rule both compilers settled on is that a non-name head
        ; is EVALUATED AS A VALUE and then applied one argument at a
        ; time, since each application may yield another closure. The
        ; arguments are snapshotted and reversed BEFORE the head is
        ; lowered, because lowering it re-enters `emitApp` and would
        ; otherwise overwrite the accumulator they live in; and the
        ; tail flag is cleared, because a call through a computed head
        ; is never the self tail call the optimiser rewrites.
        (let ((args (reverseVec (memGetWord cg 5))))
          {
            (memSetWord cg 30 0)
            (let ((cgH (emitExpr fnNode cg)))
              (emitApplyChain args cgH (strDup (memGetWord cgH 2)) 0))
          })))))

; Dispatch after flattening.
(pub :: dispatchCall (-> Int Int Int))
(pub fn (dispatchCall fnName cg)
  (let ((revArgs (memGetWord cg 5))
        (args (reverseVec revArgs))
        ; Read and clear in one step: tail position belongs to this
        ; call alone, and the arguments emitted below must not inherit
        ; it - a self call in argument position is an ordinary call.
        (isTail (memGetWord cg 30))
        (_clr (memSetWord cg 30 0)))
    (
    ; A macro wins over every other reading of the head, because
    ; stage0 expands before any analysis runs - a macro shadowing a
    ; function name rewrites the call there too, whatever the arity
    ; (see macroEffArgs for the mismatch rules).
    (let ((mac (findMacro cg fnName)))
    (if (!= mac 0)
        (emitMacroCall mac args cg)
    ; cast is a no-op at the i64 level — just evaluate and return the
    ; last argument's value directly, avoiding an undefined @cast call.
    ; It *does* change float-ness: `(cast Float bits)` is how a bit
    ; pattern held as an Int re-enters float arithmetic, so the flag
    ; follows the named type rather than the operand.
    (if (isCastName fnName)
        (let ((lastArg (vecGet args (- (vecLen args) 1))))
          (let ((cgc (emitExpr lastArg cg)))
            {
              (memSetWord cgc 14
                (if (>= (vecLen args) 2)
                    (let ((tyNode (vecGet args 0)))
                      (if (&& (== (nodeTag tyNode) TAG_E_VAR)
                              (strEq (nodeA tyNode) "Float"))
                          1
                          0))
                    0))
              cgc
            }))
    ; `sizeof`/`alignof` are compile-time constants: every Axiom value
    ; is one machine word, so both are 8 for every type - probed
    ; against stage0, which answers 8 for `Int` and for a three-field
    ; struct alike (the handle is the value).
    (if (strEq fnName "sizeof")
        {
          (memSetWord cg 2 (constStr 8))
          (memSetWord cg 14 0)
          cg
        }
    (if (strEq fnName "alignof")
        {
          (memSetWord cg 2 (constStr 8))
          (memSetWord cg 14 0)
          cg
        }
    ; Primitives have no definition to call: they *are* the instruction.
    ; Emitting `call @__load64` produces a symbol nothing defines, which
    ; fails at link time rather than as a diagnostic.
    (if (isAndOr fnName)
        (zeroFloat (emitAndOr fnName args cg))
    (if (isPrimName fnName)
        (emitPrim fnName args cg)
    ; A head that names a local or a parameter is a function VALUE -
    ; a closure record - so the call goes indirect through its code
    ; pointer. Checked before the constructor table: locals shadow.
    (if (isLocalValue cg fnName)
        (emitIndirectCall fnName args cg)
        (let ((types (memGetWord cg 3))
              (entry (lookupType types fnName)))
          (if (== entry 0)
              ; The self tail call is recognised HERE, not on the way
              ; in: a macro, a local, a lambda parameter or a match
              ; binder that shadows the function's name has already
              ; claimed the call above, and rewriting it as a jump to
              ; the function would be an infinite loop where the
              ; correct answer is a value.
              (if (&& (== isTail 1)
                      (&& (!= (memGetWord cg 27) 0)
                          (&& (strEq fnName (memGetWord cg 27))
                              (== (vecLen args) (vecLen (memGetWord cg 28))))))
                  (emitTailJump args cg)
                  (emitOverApplied fnName args cg))
              (zeroFloat (emitConstructor fnName args (eKind entry) (eArity entry) (eTag entry) (eRep entry) cg)))))))))))))))

(pub :: isLocalValue (-> Int Int Bool))
(pub fn (isLocalValue cg name)
  (if (!= (lookupSym cg name) 0)
      true
      (>= (paramIndexOf cg name) 0)))

; Call through a function value: one argument per call. The head
; evaluates to a closure record; each step loads word 0 of the current
; record as the code pointer and calls it with (record, argument), and
; the result is the record for the next step - a lifted lambda reads
; its captures from the record, a forwarding thunk ignores it. One at
; a time rather than all at once, because every function value that
; can legally exist absorbs exactly one argument - a 1-parameter
; function's thunk record, or one link of a curried lambda chain - so
; a flat spine `(h 3 4)` over a curried `h` means "apply, then apply
; the result"; passing both in one call answered with the inner
; closure's address, the same bug stage0's local-head path had. The
; result's float-ness is unknown (no signature to ask), so it reads
; as integer.
(pub :: emitIndirectCall (-> Int Int Int Int))
(pub fn (emitIndirectCall fnName args cg)
  (let ((cgH (emitVar (mkEVar fnName) cg)))
    (emitApplyChain args cgH (strDup (memGetWord cgH 2)) 0)))

(pub :: emitApplyChain (-> Int Int Int Int Int))
(pub fn (emitApplyChain args cg rec i)
  (if (>= i (vecLen args))
      {
        (memSetWord cg 2 rec)
        (memSetWord cg 14 0)
        cg
      }
      (let ((cgA (emitExpr (vecGet args i) cg)))
        (let ((a (strDup (memGetWord cgA 2))))
          (let ((cgL (loadWordAt cgA rec 0)))
            (let ((cp (strDup (memGetWord cgL 2)))
                  (fpn (allocReg cgL))
                  (rn (allocReg cgL)))
              (let ((fp (cat2 "%f" (fmtInt fpn)))
                    (r (regStr rn)))
                {
                  (emitLine cgL (cat4 (cat2 "  " fp)
                                      " = inttoptr i64 "
                                      cp
                                      " to ptr"))
                  (emitLine cgL (strConcat
                                  (cat4 (cat3 (cat2 "  " r)
                                              " = call i64 "
                                              fp)
                                        "(i64 "
                                        (strDup rec)
                                        (cat2 ", i64 " a))
                                  ")"))
                  (emitApplyChain args cgL (strDup r) (+ i 1))
                })))))))

; ------------------------------------------------------------------
; Freestanding primitives.
; ------------------------------------------------------------------
(pub :: isPrimName (-> Int Bool))
(pub fn (isPrimName nm)
  (if (strEq nm "__alloc") true
  (if (strEq nm "__load64") true
  (if (strEq nm "__store64") true
  (if (strEq nm "__load8") true
  (if (strEq nm "__store8") true
  (if (strEq nm "__addr") true
  (if (strEq nm "__intToFloat") true
  (if (strEq nm "__floatToInt") true
  (if (strEq nm "__argc") true
  (if (strEq nm "__argv") true
  ; The arena watermark pair. Their absence here was not a missing
  ; feature but a miscompile: `(__axiom_arena_mark)` is a bare
  ; reference, so it fell through to the ordinary variable path and
  ; emitted `%__axiom_arena_mark`, a value nothing defines, which llc
  ; rejects. stage0 carries a comment about hitting the identical bug.
  (if (strEq nm "__axiom_arena_mark") true
  (if (strEq nm "__axiom_arena_reset") true
  (if (isSyscallName nm) true
  false))))))))))))))

; `__syscall0` through `__syscall6`, distinguished only by how many
; arguments follow the syscall number.
(pub :: isSyscallName (-> Int Bool))
(pub fn (isSyscallName nm)
  (&& (== (strLen nm) 10)
      (strStartsWith nm "__syscall")))

(pub :: emitPrim (-> Int Int Int Int))
(pub fn (emitPrim fnName args cg)
  (if (strEq fnName "__intToFloat") (emitPrimIntToFloat args cg)
  (if (strEq fnName "__floatToInt") (emitPrimFloatToInt args cg)
  (zeroFloat
    (if (strEq fnName "__alloc")   (emitPrimAlloc args cg)
    (if (strEq fnName "__load64")  (emitPrimLoad args cg 8)
    (if (strEq fnName "__store64") (emitPrimStore args cg 8)
    (if (strEq fnName "__load8")   (emitPrimLoad args cg 1)
    (if (strEq fnName "__store8")  (emitPrimStore args cg 1)
    (if (strEq fnName "__addr")    (emitPrimAddr args cg)
    (if (strEq fnName "__argc")    (emitPrimArgc cg)
    (if (strEq fnName "__argv")    (emitPrimArgv args cg)
    (if (strEq fnName "__axiom_arena_mark")  (emitPrimArenaMark cg)
    (if (strEq fnName "__axiom_arena_reset") (emitPrimArenaReset args cg)
    (emitPrimSyscall args cg)))))))))))))))

; A mark is the WHOLE allocator position, not just the waterline:
; `@__axiom_bump` alone is meaningless once allocation has moved to a
; different chunk, because `@__axiom_bump_end` still describes the
; newer one. The pair lives in a two-word cell so marks nest, and the
; cell is allocated BEFORE the position is read so that it sits below
; the mark and survives the reset. stage0's `IrInst::ArenaMark`,
; instruction for instruction.
(pub :: emitPrimArenaMark (-> Int Int))
(pub fn (emitPrimArenaMark cg)
  (let ((cell (regStr (allocReg cg))))
    (let ((cg1 (emitLine cg (cat2 (cat2 "  " cell)
                                  " = call i64 @axiom_alloc(i64 16)"))))
      (let ((bump (regStr (allocReg cg1))))
        (let ((cg2 (emitLine cg1 (cat2 (cat2 "  " bump)
                                       " = load i64, ptr @__axiom_bump"))))
          (let ((end (regStr (allocReg cg2))))
            (let ((cg3 (emitLine cg2 (cat2 (cat2 "  " end)
                                           " = load i64, ptr @__axiom_bump_end"))))
              (let ((cg4 (storeWordAt cg3 cell 0 bump)))
                (let ((cg5 (storeWordAt cg4 cell 1 end)))
                  {
                    (memSetWord cg5 2 cell)
                    cg5
                  })))))))))

; Restore both halves. A chunk newer than the mark is abandoned rather
; than reused - a leak, which is what an arena does anyway, and the
; alternative hands out addresses belonging to no mapping.
(pub :: emitPrimArenaReset (-> Int Int Int))
(pub fn (emitPrimArenaReset args cg)
  (let ((cg0 (emitExpr (vecGet args 0) cg)))
    (let ((cell (strDup (memGetWord cg0 2))))
      (let ((bump (regStr (allocReg cg0))))
        (let ((cg1 (emitLoadWordAt cg0 cell 0 bump)))
          (let ((end (regStr (allocReg cg1))))
            (let ((cg2 (emitLoadWordAt cg1 cell 1 end)))
              (let ((cg3 (emitLine cg2 (cat3 "  store i64 " bump
                                             ", ptr @__axiom_bump"))))
                (let ((cg4 (emitLine cg3 (cat3 "  store i64 " end
                                               ", ptr @__axiom_bump_end"))))
                  {
                    (memSetWord cg4 2 (constStr 0))
                    cg4
                  })))))))))

; Load word `idx` of the block at `base` into register `dest`.
(pub :: emitLoadWordAt (-> Int Int Int Int Int))
(pub fn (emitLoadWordAt cg base idx dest)
  (let ((pn (regStr (allocReg cg))))
    (let ((cg1 (emitLine cg (cat4 (cat2 "  " pn) " = inttoptr i64 " base " to ptr"))))
      (let ((an (regStr (allocReg cg1))))
        (let ((cg2 (emitLine cg1 (cat3 (cat3 (cat2 "  " an)
                                             " = getelementptr i64, ptr " pn)
                                       ", i64 " (constStr idx)))))
          (emitLine cg2 (cat3 (cat2 "  " dest) " = load i64, ptr " an)))))))

; `(__argc)`: the count the entry wrapper captured before main ran.
(pub :: emitPrimArgc (-> Int Int))
(pub fn (emitPrimArgc cg)
  (let ((rn (allocReg cg)))
    (let ((r (regStr rn)))
      {
        (emitLine cg (cat2 (cat2 "  " r)
                           " = load i64, ptr @__axiom_argc"))
        (memSetWord cg 2 r)
        cg
      })))

; `(__argv i)`: the i-th argument's NUL-terminated bytes - the vector
; base the wrapper captured, then an ordinary indexed word load. No
; bounds check at this layer; `Sys.sysArg` owns that.
(pub :: emitPrimArgv (-> Int Int Int))
(pub fn (emitPrimArgv args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((i (strDup (memGetWord cg1 2)))
          (bn (allocReg cg1))
          (pn (allocReg cg1))
          (gn (allocReg cg1))
          (rn (allocReg cg1)))
      (let ((b (regStr bn))
            (p (cat2 "%p" (fmtInt pn)))
            (g (cat2 "%g" (fmtInt gn)))
            (r (regStr rn)))
        {
          (emitLine cg1 (cat2 (cat2 "  " b)
                              " = load i64, ptr @__axiom_argv"))
          (emitLine cg1 (cat4 (cat2 "  " p)
                              " = inttoptr i64 "
                              b
                              " to ptr"))
          (emitLine cg1 (strConcat (cat4 (cat2 "  " g)
                                         " = getelementptr i64, ptr "
                                         p
                                         ", i64 ")
                                   i))
          (emitLine cg1 (cat4 (cat2 "  " r)
                              " = load i64, ptr "
                              g
                              ""))
          (memSetWord cg1 2 r)
          cg1
        }))))

; `__intToFloat` is a numeric conversion (`sitofp`), not a
; reinterpretation - that is `cast`'s job - and the result travels as
; the i64 of its bits like every other float.
(pub :: emitPrimIntToFloat (-> Int Int Int))
(pub fn (emitPrimIntToFloat args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((v (strDup (memGetWord cg1 2)))
          (dn (allocReg cg1))
          (rn (allocReg cg1)))
      (let ((dr (cat2 "%d" (fmtInt dn)))
            (r (regStr rn)))
        {
          (emitLine cg1 (cat4 (cat2 "  " dr)
                              " = sitofp i64 "
                              v
                              " to double"))
          (emitLine cg1 (cat4 (cat2 "  " r)
                              " = bitcast double "
                              dr
                              " to i64"))
          (memSetWord cg1 2 r)
          (memSetWord cg1 14 1)
          cg1
        }))))

(pub :: emitPrimFloatToInt (-> Int Int Int))
(pub fn (emitPrimFloatToInt args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((v (strDup (memGetWord cg1 2)))
          (dn (allocReg cg1))
          (rn (allocReg cg1)))
      (let ((dr (cat2 "%d" (fmtInt dn)))
            (r (regStr rn)))
        {
          (emitLine cg1 (cat4 (cat2 "  " dr)
                              " = bitcast i64 "
                              v
                              " to double"))
          (emitLine cg1 (cat4 (cat2 "  " r)
                              " = fptosi double "
                              dr
                              " to i64"))
          (memSetWord cg1 2 r)
          (memSetWord cg1 14 0)
          cg1
        }))))

; The inline-assembly sequence takes the syscall number and six argument
; registers, so a call with fewer arguments is padded with zeros.
(pub :: emitPrimSyscall (-> Int Int Int))
(pub fn (emitPrimSyscall args cg)
  (let ((cg1 (emitArgsList args cg 0))
        (at (memGetWord cg1 9))
        (pad (padZeros (- 7 (vecLen args)) ""))
        (rn (allocReg cg1)))
    (let ((r (regStr rn)))
      {
        (emitLine cg1
          (cat4 (cat3 (cat2 "  " r)
                      (cat4 " = call i64 asm sideeffect "
                            (targetSyscallAsm (memGetWord cg1 26))
                            "(i64 "
                            "")
                      at)
                pad
                ")"
                ""))
        (memSetWord cg1 2 r)
        cg1
      })))

(pub :: padZeros (-> Int Int Int))
(pub fn (padZeros n acc)
  (if (<= n 0)
      acc
      (padZeros (- n 1) (cat2 acc ", i64 0"))))

(pub :: emitPrimAlloc (-> Int Int Int))
(pub fn (emitPrimAlloc args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg))
        (n (strDup (memGetWord cg1 2)))
        (rn (allocReg cg1)))
    (let ((r (regStr rn)))
      {
        (emitLine cg1 (cat4 (cat2 "  " r)
                            " = call i64 @axiom_alloc(i64 "
                            n
                            ")"))
        (memSetWord cg1 2 r)
        cg1
      })))

; The element type is what makes `__load8` and `__load64` differ: both
; index from a base, but one steps a byte and the other a word, and the
; byte form has to widen to a machine word on the way out.
(pub :: elemTy (-> Int Int))
(pub fn (elemTy width)
  (if (== width 8) "i64" "i8"))

(pub :: emitPrimLoad (-> Int Int Int Int))
(pub fn (emitPrimLoad args cg width)
  (let ((cg1 (emitExpr (vecGet args 0) cg))
        (base (strDup (memGetWord cg1 2)))
        (cg2 (emitExpr (vecGet args 1) cg1))
        (idx (strDup (memGetWord cg2 2)))
        (ty (elemTy width))
        (pn (allocReg cg2)))
    (let ((pr (regStr pn)))
      (let ((cg3 (emitLine cg2 (cat4 (cat2 "  " pr)
                                     " = inttoptr i64 "
                                     base
                                     " to ptr"))))
        (let ((gn (allocReg cg3)))
          (let ((gr (regStr gn)))
            (let ((cg4 (emitLine cg3 (cat4 (cat3 (cat2 "  " gr)
                                                 " = getelementptr "
                                                 ty)
                                           (cat3 ", ptr " pr ", i64 ")
                                           idx
                                           ""))))
              (let ((vn (allocReg cg4)))
                (let ((vr (regStr vn)))
                  (let ((cg5 (emitLine cg4 (cat4 (cat3 (cat2 "  " vr)
                                                       " = load "
                                                       ty)
                                                 ", ptr "
                                                 gr
                                                 ""))))
                    (if (== width 8)
                        {
                          (memSetWord cg5 2 vr)
                          cg5
                        }
                        (let ((wn (allocReg cg5)))
                          (let ((wr (regStr wn)))
                            {
                              (emitLine cg5 (cat4 (cat2 "  " wr)
                                                  " = zext i8 "
                                                  vr
                                                  " to i64"))
                              (memSetWord cg5 2 wr)
                              cg5
                            })))))))))))))

(pub :: emitPrimStore (-> Int Int Int Int))
(pub fn (emitPrimStore args cg width)
  (let ((cg1 (emitExpr (vecGet args 0) cg))
        (base (strDup (memGetWord cg1 2)))
        (cg2 (emitExpr (vecGet args 1) cg1))
        (idx (strDup (memGetWord cg2 2)))
        (cg3 (emitExpr (vecGet args 2) cg2))
        (val (strDup (memGetWord cg3 2)))
        (ty (elemTy width))
        (pn (allocReg cg3)))
    (let ((pr (regStr pn)))
      (let ((cg4 (emitLine cg3 (cat4 (cat2 "  " pr)
                                     " = inttoptr i64 "
                                     base
                                     " to ptr"))))
        (let ((gn (allocReg cg4)))
          (let ((gr (regStr gn)))
            (let ((cg5 (emitLine cg4 (cat4 (cat3 (cat2 "  " gr)
                                                 " = getelementptr "
                                                 ty)
                                           (cat3 ", ptr " pr ", i64 ")
                                           idx
                                           ""))))
              ; A byte store needs the value narrowed first; a word store
              ; takes it as it stands.
              (let ((sv (if (== width 8) val (narrowByte cg5 val))))
                {
                  (emitLine cg5 (cat4 (cat3 "  store " ty " ")
                                      sv
                                      (cat2 ", ptr " gr)
                                      ""))
                  (memSetWord cg5 2 (constStr 0))
                  cg5
                }))))))))

(pub :: narrowByte (-> Int Int Int))
(pub fn (narrowByte cg val)
  (let ((tn (allocReg cg)))
    (let ((tr (regStr tn)))
      {
        (emitLine cg (cat4 (cat2 "  " tr)
                           " = trunc i64 "
                           val
                           " to i8"))
        tr
      })))

; `(__addr "text")` is the only way a literal's bytes reach the program.
; The literal is interned into the module's string table and referenced
; by the global the table will emit.
(pub :: emitPrimAddr (-> Int Int Int))
(pub fn (emitPrimAddr args cg)
  (let ((node (vecGet args 0)))
    (if (!= (nodeTag node) TAG_E_STR)
        (emitExpr node cg)
        (let ((id (internString cg (nodeA node)))
              (rn (allocReg cg)))
          (let ((r (regStr rn)))
            {
              (emitLine cg (cat4 (cat2 "  " r)
                                 " = ptrtoint ptr @str_"
                                 (fmtInt id)
                                 " to i64"))
              (memSetWord cg 2 r)
              cg
            })))))

(pub :: isCastName (-> Int Bool))
(pub fn (isCastName nm)
  (strEq nm "cast"))


(pub :: reverseVec (-> Int Int))
(pub fn (reverseVec v)
  (reverseInto v (- (vecLen v) 1) vecNew))

(pub :: reverseInto (-> Int Int Int Int))
(pub fn (reverseInto v i acc)
  (if (< i 0) acc
      (reverseInto v (- i 1) (vecPush acc (vecGet v i)))))

; A spine may supply MORE arguments than the callee declares, and
; `((adder 10) 5)` is the shape: `adder` takes one parameter and
; returns a closure, so the surplus argument belongs to that closure,
; not to `adder`. Flattening the whole spine into one direct call
; passed both to `adder` - which read the second from a register it
; never declared - and answered with the returned closure's ADDRESS
; (tests/stdlib/140-function-values.ax). Every function value absorbs
; exactly one argument per call, which is the rule stage0 settled on
; for the identical bug on its own side.
;
; The arity gate is `isDefinedFn`, not `fnArityOf` alone: an unknown
; name answers arity 0, and treating every builtin and binary operator
; as over-applied would route `(+ a b)` through a closure record that
; does not exist.
(pub :: emitOverApplied (-> Int Int Int Int))
(pub fn (emitOverApplied fnName args cg)
  (let ((decls (memGetWord cg 8)))
    (if (isDefinedFn decls fnName)
        (let ((ar (fnArityOf decls fnName)))
          (if (|| (<= (vecLen args) ar) (== ar 0))
              (emitCall fnName args cg)
              (let ((cgD (emitCall fnName (takeVec args ar) cg)))
                (emitApplyChain (dropVec args ar) cgD
                                (strDup (memGetWord cgD 2)) 0))))
        (emitCall fnName args cg))))

(pub :: takeVec (-> Int Int Int))
(pub fn (takeVec v n) (takeInto v n 0 vecNew))

(pub :: takeInto (-> Int Int Int Int Int))
(pub fn (takeInto v n i acc)
  (if (>= i n) acc (takeInto v n (+ i 1) (vecPush acc (vecGet v i)))))

(pub :: dropVec (-> Int Int Int))
(pub fn (dropVec v n) (dropInto v n vecNew))

(pub :: dropInto (-> Int Int Int Int))
(pub fn (dropInto v i acc)
  (if (>= i (vecLen v)) acc (dropInto v (+ i 1) (vecPush acc (vecGet v i)))))

; Emit regular call: check binops/comparisons first.
(pub :: emitCall (-> Int Int Int Int))
(pub fn (emitCall fnName args cg)
  (if (&& (== (vecLen args) 2) (isBinop fnName))
      (emitBinop2 fnName args cg)
  (if (&& (== (vecLen args) 2) (isCmpOp fnName))
      (emitCmp2 fnName args cg)
  ; `(- x)` is unary negation - stage0 desugars it to `0 - x` at parse
  ; time, so it is subtraction here too, not a one-argument call to a
  ; function named `-`.
  (if (&& (strEq fnName "-") (== (vecLen args) 1))
      (let ((two vecNew))
        {
          (vecPush two (mkEInt 0))
          (vecPush two (vecGet args 0))
          (emitBinop2 "-" two cg)
        })
      (emitPlainCall fnName args cg)))))

; An operator's spelling depends on its operands - `fadd` against
; `add` - so the two are evaluated one at a time and their float flags
; captured, where a plain call can take the whole argument list at
; once. Either operand being a float makes the operation a float
; operation; a program mixing the two would be a type error under
; stage0, and this compiler compiles what it is given.
(pub :: emitBinop2 (-> Int Int Int Int))
(pub fn (emitBinop2 fnName args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((a (strDup (memGetWord cg1 2)))
          (af (memGetWord cg1 14)))
      (let ((cg2 (emitExpr (vecGet args 1) cg1)))
        (let ((b (strDup (memGetWord cg2 2)))
              (bf (memGetWord cg2 14)))
          (if (|| (== af 1) (== bf 1))
              (emitFBinop fnName a b cg2)
              (emitIBinop fnName a b cg2)))))))

(pub :: emitIBinop (-> Int Int Int Int Int))
(pub fn (emitIBinop fnName a b cg)
  (let ((rn (allocReg cg)))
    (let ((r (regStr rn)))
      {
        (emitLine cg (cat4 (cat3 (cat2 "  " r) " = " (binopToLLVM fnName))
                           " i64 "
                           (cat3 a ", " b)
                           ""))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

; The operands hold bits; the arithmetic wants a double. `bitcast` in,
; one float instruction, `bitcast` back out - free at runtime, and the
; register allocator keeps a chain of them in FP registers.
(pub :: emitFBinop (-> Int Int Int Int Int))
(pub fn (emitFBinop fnName a b cg)
  (let ((an (allocReg cg))
        (bn (allocReg cg))
        (mn (allocReg cg))
        (rn (allocReg cg)))
    (let ((ar (cat2 "%d" (fmtInt an)))
          (br (cat2 "%d" (fmtInt bn)))
          (fr (cat2 "%d" (fmtInt mn)))
          (r (regStr rn)))
      {
        (emitLine cg (cat4 (cat2 "  " ar) " = bitcast i64 " a " to double"))
        (emitLine cg (cat4 (cat2 "  " br) " = bitcast i64 " b " to double"))
        (emitLine cg (cat4 (cat3 (cat2 "  " fr) " = " (fbinopToLLVM fnName))
                           " double "
                           (cat3 ar ", " br)
                           ""))
        (emitLine cg (cat4 (cat2 "  " r) " = bitcast double " fr " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 1)
        cg
      })))

(pub :: emitCmp2 (-> Int Int Int Int))
(pub fn (emitCmp2 fnName args cg)
  (let ((cg1 (emitExpr (vecGet args 0) cg)))
    (let ((a (strDup (memGetWord cg1 2)))
          (af (memGetWord cg1 14)))
      (let ((cg2 (emitExpr (vecGet args 1) cg1)))
        (let ((b (strDup (memGetWord cg2 2)))
              (bf (memGetWord cg2 14)))
          (if (|| (== af 1) (== bf 1))
              (emitFCmp fnName a b cg2)
              (emitICmp fnName a b cg2)))))))

(pub :: emitICmp (-> Int Int Int Int Int))
(pub fn (emitICmp fnName a b cg)
  (let ((cn (allocReg cg))
        (rn (allocReg cg)))
    (let ((cr (cat2 "%c" (fmtInt cn)))
          (r (regStr rn)))
      {
        (emitLine cg (cat4 (cat3 (cat2 "  " cr) " = icmp " (cmpToLLVM fnName))
                           " i64 "
                           (cat3 a ", " b)
                           ""))
        (emitLine cg (cat4 (cat2 "  " r) " = zext i1 " cr " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

; Ordered comparisons, so a NaN operand compares false - the same
; choice stage0 makes.
(pub :: emitFCmp (-> Int Int Int Int Int))
(pub fn (emitFCmp fnName a b cg)
  (let ((an (allocReg cg))
        (bn (allocReg cg))
        (cn (allocReg cg))
        (rn (allocReg cg)))
    (let ((ar (cat2 "%d" (fmtInt an)))
          (br (cat2 "%d" (fmtInt bn)))
          (cr (cat2 "%c" (fmtInt cn)))
          (r (regStr rn)))
      {
        (emitLine cg (cat4 (cat2 "  " ar) " = bitcast i64 " a " to double"))
        (emitLine cg (cat4 (cat2 "  " br) " = bitcast i64 " b " to double"))
        (emitLine cg (cat4 (cat3 (cat2 "  " cr) " = fcmp " (fcmpToLLVM fnName))
                           " double "
                           (cat3 ar ", " br)
                           ""))
        (emitLine cg (cat4 (cat2 "  " r) " = zext i1 " cr " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

(pub :: emitPlainCall (-> Int Int Int Int))
(pub fn (emitPlainCall fnName args cg)
  (let ((argStrCg (emitArgsList args cg 0)))
    (let ((argStrT (memGetWord argStrCg 9))
          ; The callee's defining module may have renamed it - a bare
          ; reference reaches whatever symbol the map says (entry file
          ; first, then first import). Operators and primitives never
          ; enter the map, so `full` is `fnName` for them.
          (full (mangledFor argStrCg fnName))
          (rn (allocReg argStrCg)))
      (let ((r (regStr rn)))
        (let ((callInst (cat3 (cat3 (cat2 "  " r)
                                    " = call i64 @"
                                    (strDup full))
                              "(i64 "
                              (cat2 argStrT ")"))))
          {
            (emitLine argStrCg callInst)
            (memSetWord argStrCg 2 r)
            (memSetWord argStrCg 14 (fnRetIsFloat argStrCg full))
            argStrCg
          })))))


; ------------------------------------------------------------------
; `&&` and `||` short-circuit.
;
; Lowering them to `and`/`or` over two already-evaluated operands gives
; the right answer for 0/1 values and the wrong behaviour for everything
; else: the right-hand side runs even when the left has already decided.
; That is what a guard exists to prevent. `isNullaryFnIn` in this very
; file reads `(vecLen (nodeB d))` only after checking the declaration is
; a function - a signature declaration has 0 there, and evaluating it
; anyway dereferences address zero.
;
; So they become branches, like `if`.
; ------------------------------------------------------------------
(pub :: isAndOr (-> Int Bool))
(pub fn (isAndOr nm)
  (if (strEq nm "&&")
      true
      (strEq nm "||")))

(pub :: emitAndOr (-> Int Int Int Int))
(pub fn (emitAndOr op args cg)
  (let ((isAnd (strEq op "&&"))
        (cg1 (emitExpr (vecGet args 0) cg))
        (ra (strDup (memGetWord cg1 2)))
        (cn (allocReg cg1))
        (rhsL (allocReg cg1))
        (shortL (allocReg cg1))
        (mergeL (allocReg cg1))
        (cr (regStr cn))
        (rhsB (cat2 "label_" (fmtInt rhsL)))
        (shortB (cat2 "label_" (fmtInt shortL)))
        (mergeB (cat2 "label_" (fmtInt mergeL)))
        (_1 (emitLine cg1 (cat4 (cat2 "  " cr)
                                " = icmp ne i64 "
                                ra
                                ", 0")))
        ; `&&` takes the right-hand side when the left is true; `||`
        ; when it is false.
        (tgtT (if isAnd rhsB shortB))
        (tgtF (if isAnd shortB rhsB))
        (_2 (emitLine cg1 (cat4 (cat3 "  br i1 " cr ", label %")
                                tgtT
                                (cat2 ", label %" tgtF)
                                "")))
        (_3 (emitLabel cg1 rhsB))
        (cg2 (emitExpr (vecGet args 1) cg1))
        (rb (strDup (memGetWord cg2 2)))
        (bn (allocReg cg2))
        (bcr (regStr bn))
        (_4 (emitLine cg2 (cat4 (cat2 "  " bcr)
                                " = icmp ne i64 "
                                rb
                                ", 0")))
        (zn (allocReg cg2))
        (zr (regStr zn))
        (_5 (emitLine cg2 (cat4 (cat2 "  " zr)
                                " = zext i1 "
                                bcr
                                " to i64")))
        (rhsPred (strDup (memGetWord cg2 11)))
        (_6 (emitLine cg2 (cat2 "  br label %" mergeB)))
        (_7 (emitLabel cg2 shortB))
        (_8 (emitLine cg2 (cat2 "  br label %" mergeB)))
        (_9 (emitLabel cg2 mergeB))
        (pn (allocReg cg2))
        (pr (regStr pn))
        (shortVal (if isAnd (constStr 0) (constStr 1)))
        (_10 (emitLine cg2
               (cat4 (cat3 (cat2 "  " pr)
                           " = phi i64 [ " zr)
                     (cat3 ", %" rhsPred " ], [ ")
                     (cat3 shortVal ", %" shortB)
                     " ]")))
        (_11 (memSetWord cg2 2 pr)))
    cg2))

; `&&`/`||` never reach this table - `dispatchCall` routes them to the
; short-circuit branches first - so a single `&` or `|` here is
; unambiguously the bitwise operator.
(pub :: isBinop (-> Int Bool))
(pub fn (isBinop nm)
  (if (strEq nm "+") true
  (if (strEq nm "-") true
  (if (strEq nm "*") true
  (if (strEq nm "/") true
  (if (strEq nm "%") true
  (if (strEq nm "&") true
  (if (strEq nm "|") true
  (if (strEq nm "^") true
  (if (strEq nm "<<") true
  (if (strEq nm ">>") true
  false)))))))))))

(pub :: binopToLLVM (-> Int Int))
(pub fn (binopToLLVM nm)
  (if (strEq nm "+") "add"
  (if (strEq nm "-") "sub"
  (if (strEq nm "*") "mul"
  (if (strEq nm "/") "sdiv"
  (if (strEq nm "%") "srem"
  (if (strEq nm "&") "and"
  (if (strEq nm "|") "or"
  (if (strEq nm "^") "xor"
  (if (strEq nm "<<") "shl"
  (if (strEq nm ">>") "ashr"     ; arithmetic, matching stage0
  "add")))))))))))

(pub :: isCmpOp (-> Int Bool))
(pub fn (isCmpOp nm)
  (if (strEq nm "==") true
  (if (strEq nm "!=") true
  (if (strEq nm "<")  true
  (if (strEq nm ">")  true
  (if (strEq nm "<=") true
  (if (strEq nm ">=") true
  false)))))))

(pub :: cmpToLLVM (-> Int Int))
(pub fn (cmpToLLVM nm)
  (if (strEq nm "==") "eq"
  (if (strEq nm "!=") "ne"
  (if (strEq nm "<")  "slt"
  (if (strEq nm ">")  "sgt"
  (if (strEq nm "<=") "sle"
  (if (strEq nm ">=") "sge"
  "eq")))))))

(pub :: fbinopToLLVM (-> Int Int))
(pub fn (fbinopToLLVM nm)
  (if (strEq nm "+") "fadd"
  (if (strEq nm "-") "fsub"
  (if (strEq nm "*") "fmul"
  (if (strEq nm "/") "fdiv"
  (if (strEq nm "%") "frem"
  "fadd"))))))

; Ordered variants throughout: `o` requires neither operand be NaN, so
; a NaN compares false under every operator, matching stage0.
(pub :: fcmpToLLVM (-> Int Int))
(pub fn (fcmpToLLVM nm)
  (if (strEq nm "==") "oeq"
  (if (strEq nm "!=") "one"
  (if (strEq nm "<")  "olt"
  (if (strEq nm ">")  "ogt"
  (if (strEq nm "<=") "ole"
  (if (strEq nm ">=") "oge"
  "oeq")))))))

; Emit argument expressions from a Vec, building comma-separated reg string.
(pub :: emitArgsList (-> Int Int Int Int))
(pub fn (emitArgsList args cg i)
  (if (>= i (vecLen args))
      {
        (memSetWord cg 2 "")
        (memSetWord cg 9 "")
        cg
      }
      (let ((node (vecGet args i)))
        (let ((cg1 (emitExpr node cg)))
          (let ((reg (strDup (memGetWord cg1 2))))
            (let ((restCg (emitArgsList args cg1 (+ i 1))))
              (let ((rest (memGetWord restCg 2))
                    (restT (memGetWord restCg 9)))
                (if (== (strLen rest) 0)
                    {
                      (memSetWord restCg 2 reg)
                      (memSetWord restCg 9 (strDup reg))
                      restCg
                    }
                    {
                      (memSetWord restCg 2 (cat3 reg ", " rest))
                      (memSetWord restCg 9 (cat3 (strDup reg) ", i64 " restT))
                      restCg
                    }))))))))

; ------------------------------------------------------------------
; Constructor emission: alloc + field stores.
; ------------------------------------------------------------------
(pub :: emitConstructor (-> Int Int Int Int Int Int Int Int))
(pub fn (emitConstructor fnName args kind arity ctorTag rep cg)
  ; A nullary constructor of any type that unboxes (all-nullary OR
  ; mixed) is its immediate tag - stage0's S1 representation. The
  ; match sites carry the matching discipline: direct compare when
  ; the pattern names an unboxed constructor, a guarded tag read when
  ; a fieldful pattern's scrutinee might be an immediate sibling.
  (if (&& (== kind TF_DATA) (&& (== arity 0) (!= rep 0)))
      {
        (memSetWord cg 2 (constStr ctorTag))
        cg
      }
      (if (&& (== kind TF_STRUCT) (== arity 0))
          {
            (memSetWord cg 2 (constStr 0))
            cg
          }
          (let ((size (if (== kind TF_DATA) (* (+ arity 1) 8) (* arity 8))))
            (let ((ptrN (allocReg cg)))
              (let ((ptr (regStr ptrN)))
                ; `axiom_alloc` answers a machine word like everything
                ; else, so the block address stays an `i64` and only
                ; becomes a `ptr` at the point of each store.
                (let ((allocInst (cat3 (cat2 "  " ptr)
                                       " = call i64 @axiom_alloc(i64 "
                                       (cat2 (constStr size) ")"))))
                  (let ((cg1 (emitLine cg allocInst)))
                    (let ((cg2 (if (== kind TF_DATA)
                                   (storeWordAt cg1 ptr 0 (constStr ctorTag))
                                   cg1)))
                      (let ((base (if (== kind TF_DATA) 1 0)))
                        (let ((cg3 (emitFieldStores cg2 ptr args 0 base)))
                          {
                            (memSetWord cg3 2 ptr)
                            cg3
                          })))))))))))

; Store `val` at word `idx` of the block whose address is in `base`.
; An `inttoptr` folded into the `getelementptr` operand would be a
; constant expression, and a constant expression cannot name a register.
; It gets its own instruction.
(pub :: storeWordAt (-> Int Int Int Int Int))
(pub fn (storeWordAt cg base idx val)
  (let ((pn (allocReg cg)))
    (let ((pr (regStr pn)))
      (let ((cg1 (emitLine cg (cat4 (cat2 "  " pr)
                                    " = inttoptr i64 "
                                    base
                                    " to ptr"))))
        (let ((an (allocReg cg1)))
          (let ((ar (regStr an)))
            (let ((cg2 (emitLine cg1 (cat4 (cat3 (cat2 "  " ar)
                                                 " = getelementptr i64, ptr "
                                                 pr)
                                           ", i64 "
                                           (fmtInt idx)
                                           ""))))
              (emitLine cg2 (cat4 "  store i64 "
                                  val
                                  ", ptr "
                                  ar)))))))))

(pub :: emitFieldStores (-> Int Int Int Int Int Int))
(pub fn (emitFieldStores cg ptr args i base)
  (if (>= i (vecLen args)) cg
      (let ((argNode (vecGet args i)))
        (let ((cg1 (emitExpr argNode cg)))
          (let ((reg (strDup (memGetWord cg1 2))))
            (emitFieldStores (storeWordAt cg1 ptr (+ base i) reg) ptr args (+ i 1) base))))))

; ------------------------------------------------------------------
; E_Let / E_If / E_Begin.
; ------------------------------------------------------------------
(pub :: emitLet (-> Int Int Int))
(pub fn (emitLet node cg)
  (let ((name (nodeA node))
        (valExpr (nodeB node))
        (body (nodeC node)))
    (let ((cg1 (emitExpr valExpr cg)))
      ; The binding remembers whether its initialiser was a float, so a
      ; later `(+ x ...)` on the bound name picks the right instruction.
      ; And it ends with its body: without the restore, a shadowing
      ; binding's register - possibly defined in a branch block that
      ; does not dominate later uses - kept resolving the name after
      ; the `let` was over.
      (let ((valReg (strDup (memGetWord cg1 2)))
            (valFlag (memGetWord cg1 14))
            (mark (symMark cg1)))
        (bindSym cg1 name valReg valFlag 0)
        (let ((cgB (emitExpr body cg1)))
          (symRestore cgB mark)
          cgB)))))

; A mutable binding: the initialiser's value goes into an alloca, the
; name binds the alloca (kind 1), and reads load. `alloca` in a body
; block rather than the entry block is legal LLVM; at -O0 nothing cares,
; and a `while` body cannot re-execute a `let` header, so each binding
; allocates once per activation.
(pub :: emitLetM (-> Int Int Int))
(pub fn (emitLetM node cg)
  (let ((name (nodeA node))
        (valExpr (nodeB node))
        (body (nodeC node)))
    (let ((cg1 (emitExpr valExpr cg)))
      (let ((valReg (strDup (memGetWord cg1 2)))
            (valFlag (memGetWord cg1 14))
            (mark (symMark cg1))
            (an (allocReg cg1)))
        (let ((ar (cat2 "%a" (fmtInt an))))
          {
            (emitLine cg1 (cat2 (cat2 "  " ar) " = alloca i64"))
            (emitLine cg1 (cat4 "  store i64 " valReg ", ptr " ar))
            (bindSym cg1 name ar valFlag 1)
            (let ((cgB (emitExpr body cg1)))
              {
                (symRestore cgB mark)
                cgB
              })
          })))))

; `(set name v)` stores into the binding's alloca and evaluates to `v`,
; matching stage0. A target with no storage - unbound, immutable, or a
; parameter - is refused loudly; stage0 rejects it as AX3012 and this
; compiler has no diagnostic channel subtler than dying.
(pub :: emitSet (-> Int Int Int))
(pub fn (emitSet node cg)
  (let ((name (nodeA node))
        (valExpr (nodeB node)))
    (let ((storage (lookupSym cg name)))
      (if (== storage 0)
          (dieImport "error: set target is not a mut binding: " name)
          (if (!= (lookupSymKind cg name) 1)
              (dieImport "error: set target is not a mut binding: " name)
              (let ((cg1 (emitExpr valExpr cg)))
                (let ((v (strDup (memGetWord cg1 2))))
                  {
                    (emitLine cg1 (cat4 "  store i64 " v ", ptr " (strDup storage)))
                    (memSetWord cg1 2 v)
                    cg1
                  })))))))

; `while` is a real loop - a branch back to a condition block - and the
; whole form evaluates to 0: a loop that ran zero times has no last
; iteration to take a value from.
(pub :: emitWhile (-> Int Int Int))
(pub fn (emitWhile node cg)
  (let ((cnd (nodeA node))
        (body (nodeB node))
        (hn (allocReg cg))
        (bn (allocReg cg))
        (xn (allocReg cg)))
    (let ((hdrB (cat2 "label_" (fmtInt hn)))
          (bodyB (cat2 "label_" (fmtInt bn)))
          (exitB (cat2 "label_" (fmtInt xn))))
      (let ((_1 (emitLine cg (cat2 "  br label %" hdrB)))
            (_2 (emitLabel cg hdrB))
            (cgC (emitExpr cnd cg))
            (cr (strDup (memGetWord cgC 2)))
            (tn (allocReg cgC)))
        (let ((tr (regStr tn)))
          (let ((_3 (emitLine cgC (cat4 (cat2 "  " tr)
                                        " = icmp ne i64 "
                                        cr
                                        ", 0")))
                (_4 (emitLine cgC (cat4 (cat3 "  br i1 " tr ", label %")
                                        bodyB
                                        (cat2 ", label %" exitB)
                                        "")))
                (_5 (emitLabel cgC bodyB))
                (cgB (emitSeq body cgC 0))
                (_6 (emitLine cgB (cat2 "  br label %" hdrB)))
                (_7 (emitLabel cgB exitB)))
            {
              (memSetWord cgB 2 (constStr 0))
              (memSetWord cgB 14 0)
              cgB
            }))))))

(pub :: emitIf (-> Int Int Int))
(pub fn (emitIf node cg)
  (let ((testExpr (nodeA node))
        (thenExpr (nodeB node))
        (elseExpr (nodeC node))
        (cg1 (emitExpr testExpr cg))
        (testReg (strDup (memGetWord cg1 2)))
        (cmpN (allocReg cg1))
        (thenLbl (allocReg cg1))
        (elseLbl (allocReg cg1))
        (mergeLbl (allocReg cg1))
        (cmpR (regStr cmpN))
        (thenB (cat2 "label_" (fmtInt thenLbl)))
        (elseB (cat2 "label_" (fmtInt elseLbl)))
        (mergeB (cat2 "label_" (fmtInt mergeLbl)))
        (_1 (emitLine cg1 (cat4 (cat2 "  " cmpR)
                                " = icmp ne i64 "
                                testReg
                                ", 0")))
        (_2 (emitLine cg1 (cat4 (cat3 "  br i1 " cmpR ", label %")
                                thenB
                                (cat2 ", label %" elseB)
                                "")))
        (_3 (emitLabel cg1 thenB))
        (cg2 (emitExpr thenExpr cg1))
        (thenVal (strDup (memGetWord cg2 2)))
        ; A well-typed `if` yields the same type from both branches, so
        ; the then-branch's float-ness stands for the whole form.
        (thenFlag (memGetWord cg2 14))
        ; The block that actually reaches the merge, which is the last
        ; one this branch emitted - not the one it started in. A nested
        ; `if` leaves its own merge block current, and naming the outer
        ; label here made the phi list a predecessor that no longer
        ; branches to it.
        (thenPred (strDup (memGetWord cg2 11)))
        (_4 (emitLine cg2 (cat2 "  br label %" mergeB)))
        (_5 (emitLabel cg2 elseB))
        (cg3 (emitExpr elseExpr cg2))
        (elseVal (strDup (memGetWord cg3 2)))
        (elsePred (strDup (memGetWord cg3 11)))
        (_6 (emitLine cg3 (cat2 "  br label %" mergeB)))
        (_7 (emitLabel cg3 mergeB))
        (phiN (allocReg cg3))
        (phiR (regStr phiN))
        (_8 (emitLine cg3
              (cat4 (cat3 (cat2 "  " phiR)
                          " = phi i64 [ " thenVal)
                    (cat3 ", %" thenPred " ], [ ")
                    (cat3 elseVal ", %" elsePred)
                    " ]")))
        (_9 (memSetWord cg3 2 phiR))
        (_10 (memSetWord cg3 14 thenFlag)))
    cg3))

; Emit a block label and record it as the block now being written into.
(pub :: emitLabel (-> Int Int Int))
(pub fn (emitLabel cg name)
  {
    (emitLine cg (cat2 name ":"))
    (memSetWord cg 11 (strDup name))
    cg
  })

(pub :: emitBegin (-> Int Int Int))
(pub fn (emitBegin node cg)
  (let ((exprs (nodeA node)))
    (emitSeq exprs cg 0)))

(pub :: emitSeq (-> Int Int Int Int))
(pub fn (emitSeq exprs cg i)
  (if (>= i (vecLen exprs)) cg
      (emitSeq exprs (emitExpr (vecGet exprs i) cg) (+ i 1))))

; A bare string *is* a `Str`: it evaluates to the address of the static
; `{ len, bytes }` header emitted alongside its bytes, so the length is
; a compile-time constant and no `cstrLen` scan is needed. `__addr` is
; the way to reach the bytes underneath (see `emitPrimAddr`), and the
; two must not be confused - a header describing a header reads back
; the wrong length and the wrong bytes, silently.
(pub :: emitStrExpr (-> Int Int Int))
(pub fn (emitStrExpr node cg)
  (let ((id (internString cg (nodeA node)))
        (rn (allocReg cg)))
    (let ((r (regStr rn)))
      {
        (emitLine cg (cat4 (cat2 "  " r)
                           " = ptrtoint ptr @strhdr_"
                           (fmtInt id)
                           " to i64"))
        (memSetWord cg 2 r)
        (memSetWord cg 14 0)
        cg
      })))

(pub :: emitDefault (-> Int Int Int))
(pub fn (emitDefault node cg)
  {
    (memSetWord cg 2 "0")
    (memSetWord cg 14 0)
    cg
  })
