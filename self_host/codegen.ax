; codegen.ax — LLVM IR text emitter.
;
; Dependencies: core.ax, parser.ax, Mem, Str, Vec.

(import core)
(import Mem)
(import Str)
(import Vec)
(import parser)

; ------------------------------------------------------------------
; CG state: output buffer + temp counter + last result.
; ------------------------------------------------------------------
(pub struct CG (lines : Int) (tmp : Int) (result : Int))

(pub :: newCG Int)
(pub fn (newCG)
  (CG vecNew 0 (strFromLit (__addr ""))))

(pub :: emitLine (-> Int Int Int))
(pub fn (emitLine cg line)
  {
    (vecPush (memGetWord cg 0) (strDup line))
    cg
  })

(pub :: allocReg (-> Int Int))
(pub fn (allocReg cg)
  (let ((n (memGetWord cg 1)))
    {
      (memSetWord cg 1 (+ n 1))
      n
    }))

(pub :: setResult (-> Int Int Int))
(pub fn (setResult cg reg)
  {
    (memSetWord cg 2 reg)
    cg
  })

; ------------------------------------------------------------------
; Integer formatting (minimal).
; ------------------------------------------------------------------
(pub :: fmtInt (-> Int Int))
(pub fn (fmtInt n)
  (if (< n 10)
      (let ((ch (strAlloc 1)))
        {
          (__store8 (strData ch) 0 (+ n 48))
          ch
        })
      (let ((prefix (fmtInt (/ n 10))))
        (let ((suffix (strAlloc 1)))
          {
            (__store8 (strData suffix) 0 (+ (% n 10) 48))
            (strConcat prefix suffix)
          }))))

; ------------------------------------------------------------------
; Render accumulated lines into one string.
; ------------------------------------------------------------------
(pub :: renderCG (-> Int Int))
(pub fn (renderCG cg)
  (let ((lines (memGetWord cg 0)))
    (renderFrom lines 0 (strFromLit (__addr "")))))

(pub :: renderFrom (-> Int Int Int Int))
(pub fn (renderFrom lines i acc)
  (if (>= i (vecLen lines))
      acc
      (renderFrom lines (+ i 1)
        (strConcat (strConcat acc (vecGet lines i))
                   (strFromLit (__addr "\n"))))))

; ------------------------------------------------------------------
; Helper: concatenate two strings.
; ------------------------------------------------------------------
(pub :: cat2 (-> Int Int Int))
(pub fn (cat2 a b)
  (strConcat a b))

(pub :: cat3 (-> Int Int Int Int))
(pub fn (cat3 a b c)
  (strConcat (strConcat a b) c))

(pub :: cat4 (-> Int Int Int Int Int))
(pub fn (cat4 a b c d)
  (let ((ab (strConcat a b)))
    (strConcat (strConcat ab c) d)))

; ------------------------------------------------------------------
; Helpers: make LLVM values. reg argument is an Int (fmtInt result).
; ------------------------------------------------------------------
(pub :: regStr (-> Int Int))
(pub fn (regStr n)
  (cat2 (strFromLit (__addr "%t")) (fmtInt n)))

(pub :: constStr (-> Int Int))
(pub fn (constStr n)
  (fmtInt n))

; ------------------------------------------------------------------
; Module emission.
; ------------------------------------------------------------------
(pub :: emitModule (-> Int Int Int))
(pub fn (emitModule decls target)
  (let ((cg (newCG)))
    (let ((cg1 (emitLine cg (strFromLit (__addr "target triple = \"x86_64-unknown-linux-gnu\"")))))
      (let ((cg2 (emitLine cg1 (strFromLit (__addr "")))))
        (let ((cg3 (emitDecls decls cg2 0)))
          (renderCG cg3))))))

(pub :: emitDecls (-> Int Int Int Int))
(pub fn (emitDecls decls cg i)
  (if (>= i (vecLen decls))
      cg
      (let ((node (vecGet decls i))
            (next (emitDecl decls cg i node)))
        (emitDecls decls next (+ i 1)))))

(pub :: emitDecl (-> Int Int Int Int Int))
(pub fn (emitDecl decls cg i node)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_D_FN)
        (emitFnDef decls cg i node)
    cg)))

; ------------------------------------------------------------------
; Emit a function definition.
; ------------------------------------------------------------------
(pub :: emitFnDef (-> Int Int Int Int Int))
(pub fn (emitFnDef decls cg i node)
  (let ((name (nodeA node))
        (body (nodeB node)))
    (let ((headerTmp (cat3
           (strFromLit (__addr "define i64 @"))
           (strDup name)
           (strFromLit (__addr "() {")))))
      (let ((cg1 (emitLine cg headerTmp)))
        (let ((cg2 (emitExpr body cg1)))
          (let ((resultReg (memGetWord cg2 2)))
            (let ((retTmp (cat3
                   (strFromLit (__addr "  ret i64 "))
                   (strDup resultReg)
                   (strFromLit (__addr "")))))
              (let ((cg3 (emitLine cg2 retTmp)))
                (emitLine cg3 (strFromLit (__addr "}")))))))))))

; ------------------------------------------------------------------
; Expression lowering.
; ------------------------------------------------------------------
(pub :: emitExpr (-> Int Int Int))
(pub fn (emitExpr node cg)
  (let ((tag (nodeTag node)))
    (if (== tag TAG_E_INT)
        (emitInt node cg)
    (if (== tag TAG_E_VAR)
        (emitVar node cg)
    (if (== tag TAG_E_APP)
        (emitApp node cg)
    (if (== tag TAG_E_LET)
        (emitLet node cg)
    (if (== tag TAG_E_IF)
        (emitIf node cg)
    (if (== tag TAG_E_BEGIN)
        (emitBegin node cg)
    (if (== tag TAG_E_LAM)
        (emitLam node cg)
    (emitDefault node cg))))))))))

; ------------------------------------------------------------------
; E_Int.
; ------------------------------------------------------------------
(pub :: emitInt (-> Int Int Int))
(pub fn (emitInt node cg)
  (let ((val (nodeA node)))
    {
      (memSetWord cg 2 (constStr val))
      cg
    }))

; ------------------------------------------------------------------
; E_Var: reference to global function → emit call later.
; For now, return the name as result.
; ------------------------------------------------------------------
(pub :: emitVar (-> Int Int Int))
(pub fn (emitVar node cg)
  (let ((name (nodeA node)))
    {
      (memSetWord cg 2 name)
      cg
    }))

; ------------------------------------------------------------------
; E_App: function application.
; For binary ops like (+ a b), emit LLVM instruction.
; For general calls, emit call instruction.
; ------------------------------------------------------------------
(pub :: emitApp (-> Int Int Int))
(pub fn (emitApp node cg)
  (let ((fnNode (nodeA node))
        (argNode (nodeB node)))
    (if (== (nodeTag fnNode) TAG_E_VAR)
        (let ((fnName (nodeA fnNode)))
          (emitKnownCall fnName argNode cg))
        (emitDefault node cg))))

; Dispatch on known function names.
(pub :: emitKnownCall (-> Int Int Int Int))
(pub fn (emitKnownCall fnName argNode cg)
  (if (strEq fnName (strFromLit (__addr "+")))
      (emitBinOpAdd argNode cg)
  (if (strEq fnName (strFromLit (__addr "-")))
      (emitBinOpSub argNode cg)
  (if (strEq fnName (strFromLit (__addr "*")))
      (emitBinOpMul argNode cg)
  (if (strEq fnName (strFromLit (__addr "/")))
      (emitBinOpDiv argNode cg)
  (if (strEq fnName (strFromLit (__addr "==")))
      (emitCmpOp (strFromLit (__addr "eq")) argNode cg)
  (if (strEq fnName (strFromLit (__addr "!=")))
      (emitCmpOp (strFromLit (__addr "ne")) argNode cg)
  (if (strEq fnName (strFromLit (__addr "<")))
      (emitCmpOp (strFromLit (__addr "slt")) argNode cg)
  (if (strEq fnName (strFromLit (__addr ">")))
      (emitCmpOp (strFromLit (__addr "sgt")) argNode cg)
  (if (strEq fnName (strFromLit (__addr "<=")))
      (emitCmpOp (strFromLit (__addr "sle")) argNode cg)
  (if (strEq fnName (strFromLit (__addr ">=")))
      (emitCmpOp (strFromLit (__addr "sge")) argNode cg)
  (if (strEq fnName (strFromLit (__addr "%")))
      (emitBinOpRem argNode cg)
  (emitUserCall fnName argNode cg)))))))))))))

; ------------------------------------------------------------------
; Binary ops.
; ------------------------------------------------------------------
(pub :: emitBinOpAdd (-> Int Int Int))
(pub fn (emitBinOpAdd argNode cg)
  (emitBinOp (strFromLit (__addr "add")) argNode cg))

(pub :: emitBinOpSub (-> Int Int Int))
(pub fn (emitBinOpSub argNode cg)
  (emitBinOp (strFromLit (__addr "sub")) argNode cg))

(pub :: emitBinOpMul (-> Int Int Int))
(pub fn (emitBinOpMul argNode cg)
  (emitBinOp (strFromLit (__addr "mul")) argNode cg))

(pub :: emitBinOpDiv (-> Int Int Int))
(pub fn (emitBinOpDiv argNode cg)
  (emitBinOp (strFromLit (__addr "sdiv")) argNode cg))

(pub :: emitBinOpRem (-> Int Int Int))
(pub fn (emitBinOpRem argNode cg)
  (emitBinOp (strFromLit (__addr "srem")) argNode cg))

(pub :: emitBinOp (-> Int Int Int Int))
(pub fn (emitBinOp opName argNode cg)
  (let ((lhsNode (nodeA argNode))
        (rhsNode (nodeB argNode)))
    (let ((cg1 (emitExpr lhsNode cg)))
      (let ((lhsReg (memGetWord cg1 2)))
        (let ((cg2 (emitExpr rhsNode cg1)))
          (let ((rhsReg (memGetWord cg2 2)))
            (let ((resultN (allocReg cg2)))
              (let ((result (regStr resultN)))
                (let ((inst (cat3 (cat2 (strFromLit (__addr "  ")) result)
                                  (cat2 (strFromLit (__addr " = "))
                                        (cat4 opName
                                              (strFromLit (__addr " i64 "))
                                              (strDup lhsReg)
                                              (strFromLit (__addr ", "))))
                                  (strDup rhsReg))))
                  {
                    (emitLine cg2 inst)
                    (memSetWord cg2 2 result)
                    cg2
                  })))))))))

; ------------------------------------------------------------------
; Comparison ops: emit icmp + zext to i64.
; %tmp = icmp eq i64 %lhs, %rhs
; %result = zext i1 %tmp to i64
; ------------------------------------------------------------------
(pub :: emitCmpOp (-> Int Int Int Int))
(pub fn (emitCmpOp cmpKind argNode cg)
  (let ((lhsNode (nodeA argNode))
        (rhsNode (nodeB argNode)))
    (let ((cg1 (emitExpr lhsNode cg)))
      (let ((lhsReg (memGetWord cg1 2)))
        (let ((cg2 (emitExpr rhsNode cg1)))
          (let ((rhsReg (memGetWord cg2 2)))
            (let ((cmpN (allocReg cg2)))
              (let ((cmpReg (regStr cmpN)))
                (let ((cmpInst (cat3 (cat2 (strFromLit (__addr "  ")) cmpReg)
                                     (strFromLit (__addr " = icmp "))
                                     (cat4 cmpKind
                                           (strFromLit (__addr " i64 "))
                                           (strDup lhsReg)
                                           (cat2 (strFromLit (__addr ", "))
                                                 (strDup rhsReg))))))
                  (let ((cg3 (emitLine cg2 cmpInst)))
                    (let ((zN (allocReg cg3)))
                      (let ((zReg (regStr zN)))
                        (let ((zInst (cat4 (cat2 (strFromLit (__addr "  ")) zReg)
                                           (strFromLit (__addr " = zext i1 "))
                                           (strDup cmpReg)
                                           (strFromLit (__addr " to i64")))))
                          {
                            (emitLine cg3 zInst)
                            (memSetWord cg3 2 zReg)
                            cg3
                          })))))))))))))

; ------------------------------------------------------------------
; User function call: call i64 @func(i64 %a, ...)
; ------------------------------------------------------------------
(pub :: emitUserCall (-> Int Int Int Int))
(pub fn (emitUserCall fnName argNode cg)
  (let ((argsCg (emitArgs argNode cg)))
    (let ((allArgs (memGetWord argsCg 2)))
      (let ((resultN (allocReg argsCg)))
        (let ((result (regStr resultN)))
          (let ((callPart (cat3 (cat2 (strFromLit (__addr "  ")) result)
                                (strFromLit (__addr " = call i64 @"))
                                (strDup fnName))))
            (let ((inst (cat3 callPart (strFromLit (__addr "(i64 "))
                              (cat2 (strDup allArgs) (strFromLit (__addr ")"))))))
              {
                (emitLine argsCg inst)
                (memSetWord argsCg 2 result)
                argsCg
              })))))))

; Collect arguments: recursively walk E_App chain, emit each, concat reg names.
(pub :: emitArgs (-> Int Int Int))
(pub fn (emitArgs argNode cg)
  (if (== (nodeTag argNode) TAG_E_APP)
      (let ((lhs (nodeA argNode))
            (rhs (nodeB argNode)))
        (let ((cg1 (emitExpr lhs cg)))
          (let ((lhsReg (memGetWord cg1 2)))
            (let ((restCg (emitArgs rhs cg1)))
              (let ((restRegs (memGetWord restCg 2)))
                {
                  (memSetWord restCg 2
                    (cat3 (strDup lhsReg) (strFromLit (__addr ", "))
                          (strDup restRegs)))
                  restCg
                })))))
      (let ((cg1 (emitExpr argNode cg)))
        {
          (memSetWord cg1 2 (strDup (memGetWord cg1 2)))
          cg1
        })))

; ------------------------------------------------------------------
; E_Let: just evaluate body for now.
; ------------------------------------------------------------------
(pub :: emitLet (-> Int Int Int))
(pub fn (emitLet node cg)
  (let ((body (nodeB node)))
    (emitExpr body cg)))

; ------------------------------------------------------------------
; E_If: simplified — evaluate then-branch.
; ------------------------------------------------------------------
(pub :: emitIf (-> Int Int Int))
(pub fn (emitIf node cg)
  (let ((thenNode (nodeB node)))
    (emitExpr thenNode cg)))

; ------------------------------------------------------------------
; E_Begin: sequence — last value is result.
; ------------------------------------------------------------------
(pub :: emitBegin (-> Int Int Int))
(pub fn (emitBegin node cg)
  (let ((exprs (nodeA node)))
    (emitSeq exprs cg 0)))

(pub :: emitSeq (-> Int Int Int Int))
(pub fn (emitSeq exprs cg i)
  (if (>= i (vecLen exprs))
      cg
      (emitSeq exprs (emitExpr (vecGet exprs i) cg) (+ i 1))))

; ------------------------------------------------------------------
; E_Lam: placeholder.
; ------------------------------------------------------------------
(pub :: emitLam (-> Int Int Int))
(pub fn (emitLam node cg)
  {
    (memSetWord cg 2 (strFromLit (__addr "0")))
    cg
  })

; ------------------------------------------------------------------
; Default: emit nothing, result = 0.
; ------------------------------------------------------------------
(pub :: emitDefault (-> Int Int Int))
(pub fn (emitDefault node cg)
  {
    (memSetWord cg 2 (strFromLit (__addr "0")))
    cg
  })
