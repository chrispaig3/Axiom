; lsp.ax — a Language Server Protocol server, in Axiom, over the
; self-hosted frontend.
;
; The architectural argument for self-hosting first (v1-roadmap §4.6) is
; that the language server should REUSE the compiler's frontend rather
; than reimplement parsing. This module is that reuse: it owns the
; protocol and nothing else. Every diagnostic it publishes comes from
; the same `parseModuleWith`/`checkModule` pair that `check` runs.
;
; WHAT IT SPEAKS. The lifecycle (`initialize`, `initialized`,
; `shutdown`, `exit`), full-text document sync (`didOpen`, `didChange`,
; `didClose`) and `publishDiagnostics`; and four questions about a
; position or a document - `documentSymbol`, `definition`, `hover` and
; `completion`. Sync is FULL rather than incremental -
; `textDocumentSync: 1` - because the checker takes a whole source
; string anyway, so an incremental store would exist only to be
; re-flattened before every check.
;
; THE FOUR QUESTIONS ALL READ THE RAW PARSE TREE and expand nothing,
; which is MAC-TOOL-3's rule: expansion is bounded but not free (41.4 s
; on a measured fan-out probe) and none of them needs it. `hover` and
; `completion` additionally read the source BYTES - the declaration's
; own text, the paragraph above it, the half-typed word under the
; cursor - because what a reader wants is what is written, and the
; document already holds it.
;
; THE FRONTEND IS LIBRARY-SHAPED, WITH ONE EXCEPTION, and that
; exception is why `lspPreflight` exists. `parseModuleWith` and
; `checkModule` both take a source string and answer values - the REPL
; already drives them that way. But `resolveImports` reaches
; `parseModuleOrDie`, which on a module it cannot find renders AX5001
; and calls `sysExitWith`. That is correct for a compiler, whose next
; action would be to fail anyway, and fatal for a server: a user
; halfway through typing `(import Fo` would kill the session, and the
; editor would report the crash rather than the typo. So the imports
; are walked non-fatally FIRST, and resolution runs only once every
; module is known to be readable.
;
; POSITIONS ARE UTF-16 CODE UNITS, which is the protocol's default and
; is a third unit alongside the two the compilers already disagree
; about (stage0 counts characters, stage1 counts bytes - see diag.ax).
; `lspChar` converts from a byte offset directly, so nothing downstream
; has to know.
;
; STATE IS THREADED, not global: Axiom has no module-level mutable
; binding. The document store is two parallel `Vec`s created in
; `lspMain` and mutated in place through ONE writer, `docPut` - the
; lockstep rule this project learned the hard way, where two separate
; single-value puts desynchronise the moment one takes the overwrite
; path and the other appends.
(import core)

(import Host)

(import Mem)

(import Str)

(import Vec)

(import Utf8)

(import Sys)

(import Err)

(import Path)

(import Json)

(import Rpc)

(import lexer)

(import parser)

(import diag)

(import typecheck)

(import expand)

(import codegen)

(import format)

; ------------------------------------------------------------------
; Positions
; ------------------------------------------------------------------
; 0-based line of a byte offset. `diag.lineOf` is 1-based, because AXDL
; is; LSP is not.
(pub :: lspLine (-> String Int Int))

(pub fn (lspLine src off) (- (lineOf src off) 1))

; The UTF-16 code unit offset of `off` within its line.
;
; A code point below U+10000 is one unit; one at or above is a
; surrogate pair, so two. A byte that decodes to nothing - a truncated
; or invalid sequence - counts as one unit and advances one byte, so a
; malformed buffer still yields monotonic positions rather than
; hanging.
(pub :: lspChar (-> String Int Int))

(pub fn (lspChar src off) (lspCharFrom src (lineStartOf src off) off))

; The same count, from a line start the caller already knows - which is
; what the line index makes free, and what `lineStartOf` was scanning
; the whole document to rediscover.
(pub :: lspCharFrom (-> String Int Int Int))

(pub fn (lspCharFrom src start off)
  (let (
    (mut i start)
    (mut acc 0)
  )
    {
      (while (< i off)
        (match (utf8DecodeAt src i)
          ((None)
            {
              (set acc (+ acc 1))
              (set i (+ i 1))
            })
          ((Some cp)
            {
              (set acc (+
                acc                (if (>= cp 65536)
                  2
                  1
                )
              ))
              (set i (+ i (utf8SeqLen (strByte src i))))
            })
        ))
      acc
    }
  )
)

(pub :: lspPos (-> String Int Int))

(pub fn (lspPos src off) (jsonObjPut (jsonObjPut jsonObj "line" (jsonNum (lspLine src off))) "character" (jsonNum (lspChar src off))))

; The range of a span. A span of 0 is the spanless diagnostic - AX5001
; is one - and renders at the top of the file rather than dereferencing
; address zero, which is what reading `spanStart` of 0 would do.
(pub :: lspRange (-> String Int Int))

(pub fn (lspRange src span)
  (if (== span 0)
    (jsonObjPut (jsonObjPut jsonObj "start" (lspPos src 0)) "end" (lspPos src 0))
    (let (
      (s (spanStart span))
      (e0 (spanEnd span))
    )
      (let ((e 
        (if (< e0 s)
          s
          e0
        )
      ))
        (jsonObjPut (jsonObjPut jsonObj "start" (lspPos src s)) "end" (lspPos src e))
      )
    )
  )
)

; ------------------------------------------------------------------
; The line index.
;
; `lspPos` answered both halves of a position by scanning the document
; from byte 0: `lineOf` counts newlines from 0 (`diag.ax`), and
; `lspChar`'s `lineStartOf` scans from 0 to rediscover the line start.
; `lspRange` calls `lspPos` twice, and `lspDocumentSymbols` calls
; `lspRange` twice per symbol - so an outline cost four whole-document
; scans per symbol, and publishing N diagnostics cost 4N.
;
; Measured over a real JSON-RPC pipe, `textDocument/documentSymbol`
; alone: 0.03 s at 1,002 symbols, 0.13 at 2,002, 0.54 at 4,002, 2.22 at
; 8,002 - against 0.20 s for the ENTIRE `didOpen` (parse, check and
; publish) on the same document. The outline cost eleven times the whole
; frontend. On this repository's own files: `parser.ax` 0.082 s,
; `typecheck.ax` 0.166 s, `codegen.ax` 0.185 s. The shape is
; symbols x document length, at about 8.0M line-steps a second.
;
; One pass records the offset at which every line begins; a position is
; then a binary search and no scan. Built per REQUEST and deliberately
; not cached: the server reclaims the arena at every message boundary
; (`lspSnapshot`), so an index kept across messages would point into
; storage the reset has handed back.
; ------------------------------------------------------------------
; Element 0 is 0; element k is the offset just past the k-th newline.
; A `while`, not a recursion: its depth would be the line count, and
; this backend eliminates only self tail calls.
(pub :: lspLineIndex (-> String (Vec Int)))

(pub fn (lspLineIndex src)
  (let (
    (out vecNew)
    (n (strLen src))
    (mut i 0)
  )
    {
      (vecPush out 0)
      (while (< i n)
        {
          (if (== (strByte src i) 10)
            (vecPush out (+ i 1))
            (cast (Vec Int) 0)
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

; The 0-based line of `off`: the largest k with `ix[k] <= off`. An
; offset past the end answers the last line rather than failing, because
; a span may name the byte after the final character - `lspRange`
; clamps its end but the end itself is legitimately one past.
(pub :: lspLineOfIx (-> (Vec Int) Int Int))

(pub fn (lspLineOfIx ix off)
  (let (
    (mut lo 0)
    (mut hi (- (vecLen ix) 1))
  )
    {
      (while (< lo hi)
        (let ((mid (+ lo (/ (+ (- hi lo) 1) 2))))
          (if (<= (vecGet ix mid) off)
            (set lo mid)
            (set hi (- mid 1))
          )
        ))
      lo
    }
  )
)

(pub :: lspPosIx (-> String (Vec Int) Int Int))

(pub fn (lspPosIx src ix off)
  (let ((ln (lspLineOfIx ix off)))
    (jsonObjPut (jsonObjPut jsonObj "line" (jsonNum ln)) "character" (jsonNum (lspCharFrom src (vecGet ix ln) off)))
  )
)

(pub :: lspRangeIx (-> String (Vec Int) Int Int))

(pub fn (lspRangeIx src ix span)
  (if (== span 0)
    (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix 0)) "end" (lspPosIx src ix 0))
    (let (
      (s (spanStart span))
      (e0 (spanEnd span))
    )
      (let ((e 
        (if (< e0 s)
          s
          e0
        )
      ))
        (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix s)) "end" (lspPosIx src ix e))
      )
    )
  )
)

; ------------------------------------------------------------------
; Diagnostics
; ------------------------------------------------------------------
; LSP severity: 1 Error, 2 Warning. Axiom's are 0 and 1.
(pub :: lspSeverity (-> Int Int))

(pub fn (lspSeverity sev)
  (if (== sev SEV_ERROR)
    1
    2
  )
)

; One Axiom diagnostic as an LSP `Diagnostic`.
;
; The notes and help texts are appended to the message rather than
; dropped: LSP has no field for either, and a help is often the whole
; value of an Axiom diagnostic - `AX3001`'s "did you mean" is the reason
; the fix-help form exists at all.
;
; A SECONDARY SPAN DOES carry a location, and that is what
; `relatedInformation` is for. Until 2026-09-03 this function dropped
; both halves of what the terminal shows at the caret: the primary
; LABEL, which 215 of the corpus's 422 diagnostics carry, and the
; SECONDARY spans, which 32 do. `axiom check` on a duplicate `main`
; points at the first definition; VS Code said "duplicate definition
; `main`" and pointed at nothing. The editor now sees what the terminal
; sees - that is the whole of the change, and tests/lsp/drive.py holds
; it as a differential between the two surfaces rather than as a list
; written down twice.
;
; WHICH FILE A SECONDARY SPAN INDEXES is the one thing this rests on,
; and it is the OPEN DOCUMENT: `struct DLabel` carries a span and a
; message and no unit, the publish loop already reports only
; diagnostics whose unit is 0, and both emitters that produce a
; secondary take their two spans from one unit - `checkDuplicates`
; examines the entry file's declarations alone (its own header says
; so), and `emitAX3012` goes through `emitDiag`, which stamps the unit
; the spans came from. So one uri and one line index serve every
; secondary, and there is no unit table to consult.
;
; Read through diag.ax's accessors. This function used to carry a second
; copy of the twelve-word field list as a comment and index it by hand,
; which is the shape a layout drifts out of - and it did drift in one
; direction already: it appended word 7 and nothing else, so a
; diagnostic carrying two helps showed one of them in the editor. All of
; them show now.
(pub :: lspDiagText (-> Int String))

(pub fn (lspDiagText d)
  (let (
    (parts vecNew)
    (mut i 0)
  )
    {
      (vecPush parts (diagMsg d))
      ; THE LABEL IS WHAT THE CARET SAYS, and it goes directly under
      ; the message because that is where the terminal puts it. It is
      ; often not a restatement: `AX3012`'s is "`x` is a parameter",
      ; `AX3048`'s names the `;@axiom:deprecated(...)` that was
      ; declared, and `AX2004`'s carries the whole reason a construct
      ; was removed. The message's FIRST line is unchanged by this,
      ; which is what tests/lsp/expected-diagnostics.txt pins.
      ; A DIAGNOSTIC WITH NO LABEL CARRIES 0, NOT "" - the trap
      ; render.ax's own header records, where walking one read
      ; `strLen` off a null handle and took the renderer down with
      ; SIGSEGV. `renderDiagJson` tests for it at the same read; so
      ; does this. Found again here the same way, by the gate: 070 and
      ; 080 both carry an AX3039 with no label, and the server exited
      ; -11 on both.
      (let ((lab
        (if (== (cast Int (diagLabel d)) 0)
          ""
          (diagLabel d)
        )
      ))
        (if (== (strLen lab) 0)
          0
          {
            (vecPush parts "\n\n")
            (vecPush parts lab)
            0
          }
        )
      )
      (while (< i (diagNoteCount d))
        {
          (vecPush parts "\n\nnote: ")
          (vecPush parts (diagNote d i))
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (diagTraceCount d))
        {
          ; Name only: this function has no unit table in reach, and
          ; the editor's cursor is already AT the invocation the
          ; frame explains.
          (vecPush parts "\n\nnote: in this expansion of `")
          (vecPush parts (diagTraceName d i))
          (vecPush parts "`")
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (diagHelpCount d))
        {
          (vecPush parts "\n\nhelp: ")
          (vecPush parts (diagHelpMsg d i))
          (set i (+ i 1))
        })
      (catStrs parts)
    }
  )
)

; Takes the line index rather than building one: its caller at the
; publish loop reports every diagnostic in the file, and building the
; index per diagnostic would keep the whole cost it exists to remove.
(pub :: lspDiagJson (-> Int String (Vec Int) String Int))

(pub fn (lspDiagJson d src ix uri)
  (let ((base (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (diagSpan d))) "severity" (jsonNum (lspSeverity (diagSev d)))) "code" (jsonStr (diagCode d))) "source" (jsonStr "axiom")) "message" (jsonStr (lspDiagText d)))))
    ; The key is OMITTED rather than sent empty when there is nothing
    ; to relate. An empty array is legal and would have rewritten every
    ; golden in tests/lsp/ for no information; a client reads the
    ; absent key and the empty array the same way.
    (if (== (diagSecCount d) 0)
      base
      (jsonObjPut base "relatedInformation" (lspDiagRelated d src ix uri))
    )
  )
)

; The secondary spans, as `DiagnosticRelatedInformation[]`. One uri and
; one line index for all of them, for the reason the header gives.
(pub :: lspDiagRelated (-> Int String (Vec Int) String Int))

(pub fn (lspDiagRelated d src ix uri)
  (let (
    (out jsonArr)
    (mut i 0)
  )
    {
      (while (< i (diagSecCount d))
        {
          (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "location" (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRangeIx src ix (diagSecSpan d i)))) "message" (jsonStr (diagSecMsg d i))))
          (set i (+ i 1))
        })
      out
    }
  )
)

; A one-diagnostic array, for the failures that happen before the
; checker runs and therefore have no span to report. `lspRange` already
; answers the top-of-file range for a span of 0 - that is the spanless
; case it exists to handle - so it is reused rather than rebuilt here.
(pub :: lspOneDiag (-> String String String Int))

(pub fn (lspOneDiag src code msg) (jsonArrPush jsonArr (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "range" (lspRange src 0)) "severity" (jsonNum 1)) "code" (jsonStr code)) "source" (jsonStr "axiom")) "message" (jsonStr msg))))

; ------------------------------------------------------------------
; Import pre-flight
;
; Walks the import graph exactly as `resolveDeclsPhase` does - by
; `TAG_D_IMPORT` node, name in word 1 - but answers the name of the
; first module that cannot be read instead of exiting. "" means every
; import resolves and `resolveImports` is safe to call.
; ------------------------------------------------------------------
(pub :: lspSeenHas (-> (Vec String) String Bool))

(pub fn (lspSeenHas seen name) (lspSeenFrom seen name 0))

(pub :: lspSeenFrom (-> (Vec String) String Int Bool))

(pub fn (lspSeenFrom seen name i)
  (if (>= i (vecLen seen))
    false
    (if (strEq (vecGetStr seen i) name)
      true
      (lspSeenFrom seen name (+ i 1))
    )
  )
)

(pub :: lspPreflight (-> (Vec Int) Int String (Vec String) String))

;@axiom:effect(io)
(pub fn (lspPreflight decls tcode entryDir seen)
  (let (
    (mut i 0)
    (mut missing "")
  )
    {
      (while (&& (< i (vecLen decls)) (== (strLen missing) 0))
        (let ((n (vecGet decls i)))
          {
            (if (== (nodeTag n) TAG_D_IMPORT)
              (let ((name (memGetWordStr n 1)))
                (if (lspSeenHas seen name)
                  0
                  {
                    (vecPush seen name)
                    (let ((srcOpt (readModuleSrc name tcode entryDir)))
                      (match srcOpt
                        ((None)
                          {
                            (set missing name)
                            0
                          }
                        )
                        ; The module reads. Its own imports are
                        ; the same question one level down; a
                        ; module that does not parse is not a
                        ; missing-import failure and is left for
                        ; the checker to report.
                        ((Some src)
                          (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
                            (if (== (memGetWord pr 0) 0)
                              0
                              {
                                (set missing (lspPreflight (memGetWordVec pr 1) tcode entryDir seen))
                                0
                              }
                            )
                          )
                        )
                      )
                    )
                  }
                )
              )
              0
            )
            (set i (+ i 1))
          }
        ))
      missing
    }
  )
)

; ------------------------------------------------------------------
; Checking one document
;
; Answers a JSON array of LSP diagnostics for `src`, named `path`.
;
; Only diagnostics whose unit is 0 - the document itself - are
; published. A diagnostic about an imported module indexes that
; module's bytes, so rendering it against this file's text would put a
; caret at an unrelated position; publishing it under this file's URI
; would put it in the wrong editor tab. Reporting those under their own
; URIs is a later slice.
; ------------------------------------------------------------------
(pub :: lspCheckDoc (-> String String Int))

;@axiom:effect(io)
(pub fn (lspCheckDoc path src)
  ; A lexical error is reported before a parse one, as it is in the
  ; compiler: an editor should point at the bad escape rather than at
  ; whatever the parser tripped over afterwards.
  (let ((toks (lex src)))
    (let ((lexD (lexErrDiag toks src)))
      (let ((pr 
        (if (== lexD 0)
          (parseModuleWith toks (scanAxtags src))
          (pErr 0)
        )
      ))
        (if (|| (> lexD 0) (== (memGetWord pr 0) 0))
          ; A parse failure now carries a code and a span, so the editor
          ; gets a squiggle ON the offending token instead of one
          ; spanless note at the top of the file. That was this port's
          ; first consumer: before it, every typo anywhere in a file
          ; reported identically, at line 1.
          (jsonArrPush
            jsonArr            (lspDiagJson
              (if (== lexD 0)
                (parseErrDiag toks pr src)
                lexD
              )              src              (lspLineIndex src)              (lspPathToUri path)
            )
          )
          (let (
            (decls (memGetWordVec pr 1))
            (tcode (checkedTargetCode hostTarget))
            (entryDir (pathDir path))
          )
            (let ((missing (lspPreflight decls tcode entryDir vecNew)))
              (if (> (strLen missing) 0)
                (lspOneDiag src "AX5001" (strConcat (strConcat "cannot resolve import `" missing) "`"))
                ; Same order as `compileFile`: expansion, then the
                ; checker. An editor that reported a different set
                ; of diagnostics from `axiom check` on the same file
                ; would be worse than one that reported none.
                ; Expansion's refusals are published ALONE when it
                ; refused. Running the checker over a tree
                ; expansion gave up on is how `check` used to
                ; SIGSEGV on a 3.5 KB file, and a server that dies
                ; is a server that stops answering the editor.
                (let (
                  (bares vecNew)
                  (fulls vecNew)
                  (mods vecNew)
                  (units (let ((v vecNew))
                    {
                      (vecPush
                        v                        (cast Int (CUnit2
                          path                          src                          (cast String 0)
                        ))
                      )
                      v
                    }
                  ))
                )
                  (let ((allDecls (resolveImports
                    decls                    bares                    fulls                    mods                    tcode                    entryDir                    units
                  )))
                    (let (
                      (ftbl vecNew)
                      (eds (let ((v vecNew))
                        {
                          (expandProgram
                            decls                            allDecls                            v                            ftbl                            units                            bares                            fulls                            mods
                          )
                          v
                        }
                      ))
                    )
                      (let ((ds 
                        (if (> (countErrorDiags eds) 0)
                          (orderDiags eds)
                          (orderDiags
                            (expMergeInto
                              eds                              (let ((cds (checkModule decls allDecls units)))
                                {
                                  (expAttachFrames cds ftbl units)
                                  cds
                                }
                              )
                            )
                          )
                        )
                      ))
                        (let (
                          (out jsonArr)
                          (ix (lspLineIndex src))
                          ; Once, not per diagnostic: `lspPathToUri`
                          ; is IO, and a related location names the
                          ; document being published.
                          (uri (lspPathToUri path))
                          (mut i 0)
                        )
                          {
                            (while (< i (vecLen ds))
                              (let ((d (vecGet ds i)))
                                {
                                  (if (== (diagUnit d) 0)
                                    (jsonArrPush out (lspDiagJson d src ix uri))
                                    0
                                  )
                                  (set i (+ i 1))
                                }
                              ))
                            out
                          }
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; Document symbols
;
; Every top-level declaration node carries its NAME's span in word 4 -
; `mkDFnAt` and its siblings put it there precisely because a
; diagnostic about a declaration points at its name - so the outline
; comes straight off the parse tree without the checker running. That
; matters for an editor: a file with a type error still has an outline,
; and a file that does not parse simply has none.
;
; A `(:: f T)` signature is deliberately NOT listed. It shares its name
; with the `(fn (f) ...)` beside it, and an outline that shows every
; name twice is worse than one that shows it once.
;
; `range` IS THE WHOLE FORM and `selectionRange` is the name inside it.
; This comment used to say that both were the name's span and that
; "recovering the declaration's full extent would mean spans this
; parser does not record" - which stopped being true when hover learnt
; to quote a declaration: `lspFormStart` and `lspFormEnd` recover the
; extent from the BYTES, and hover has been reading it since
; 2026-08-26. The protocol's containment requirement was satisfied by
; identity until then - measured 2026-09-03, `range` equalled
; `selectionRange` on 543 of 543 symbols over ten documents - which is
; a check that cannot fail on extent. What it costs a reader: an editor
; uses `range` for the breadcrumb it highlights, for sticky scroll, and
; for "expand selection to the enclosing symbol", and a range four
; characters wide makes all three useless.
;
; AND THE OUTLINE NESTS. A `data`'s constructors and a `struct`'s
; fields are children - `workspace/symbol` has listed constructors at
; their own spans all along, so the two views of one file disagreed,
; and a struct's fields were invisible to both. Both live in slot b
; (`mkDDataAt` and `mkDStructAt` put them there) and both carry their
; name's span from the parser, so this needs nothing the frontend does
; not already record.
;
; THE FALLBACK IS THE NAME SPAN, AND IT TAKES THE CHILDREN WITH IT.
; `lspFormStart`'s rule is COLUMN ZERO, and a document mid-edit that
; indents a declaration falls back to the nearest opener - which for a
; `fn` is its parameter list, a form that does NOT contain the
; declaration's name span. Publishing that as `range` would put a
; parent's range inside its own child's, which the protocol forbids and
; a client renders as a scrambled tree. So the extent is CHECKED to
; contain the name before it is used, and when it does not this answers
; exactly what it answered before 2026-09-03: the name span, with no
; children.
; ------------------------------------------------------------------
; LSP SymbolKind. Function 12, Enum 10, Struct 23.
(pub :: lspSymKind (-> Int Int))

(pub fn (lspSymKind tag)
  (if (== tag TAG_D_DATA)
    10
    (if (== tag TAG_D_STRUCT)
      23
      12
    )
  )
)

(pub :: lspWantsSymbol (-> Int Bool))

(pub fn (lspWantsSymbol tag) (|| (== tag TAG_D_FN) (|| (== tag TAG_D_DATA) (|| (== tag TAG_D_STRUCT) (== tag TAG_D_MACRO)))))

; LSP SymbolKind for what a declaration holds INSIDE it: EnumMember 22
; for a `data`'s constructors - the kind `workspace/symbol` already
; publishes them under - and Field 8 for a `struct`'s fields. 0 for a
; declaration with no members to list, which is a `fn` (slot b is its
; parameter NAMES, strings rather than nodes) and a macro.
(pub :: lspMemberKind (-> Int Int))

(pub fn (lspMemberKind tag)
  (if (== tag TAG_D_DATA)
    22
    (if (== tag TAG_D_STRUCT)
      8
      0
    )
  )
)

; The whole top-level form a declaration's name sits in, or 0 when the
; recovered extent does not contain that name - see the header. 0 is
; the caller's signal to answer the name span and publish no children.
(pub :: lspSymbolExtent (-> String Int Int))

(pub fn (lspSymbolExtent src nameSpan)
  (let ((o (lspFormStart src (spanStart nameSpan))))
    (let ((e (lspFormEnd src o)))
      ; TWO CONDITIONS, and each rules out a different wrong answer
      ; from the same fallback. `lspFormStart`'s rule is COLUMN ZERO
      ; and it falls back to the nearest opener when nothing is there,
      ; so for an INDENTED declaration it answers one of two things.
      ; The PRECEDING top-level form, when the document has one: a
      ; range that ends before this declaration begins, which the
      ; containment test refuses. Or, when it does not, the nearest
      ; `(` - and for a `fn` that is its own PARAMETER LIST, the trap
      ; `lspFormStart`'s header spells out, which contains the name and
      ; would pass containment on its own. `lspHeaderOpen` answers
      ; exactly that paren, so the extent is refused when the two are
      ; the same byte.
      ;
      ; An indented `data` or `struct` keeps its extent under both
      ; tests, and should: its name is not inside a parameter list, so
      ; the nearest opener IS its own form. The guard is aimed at the
      ; one shape that goes wrong, not at indentation.
      (if (&& (!= o (lspHeaderOpen src (spanStart nameSpan))) (&& (<= o (spanStart nameSpan)) (<= (spanEnd nameSpan) e)))
        (mkSpan o e)
        0
      )
    )
  )
)

; One DocumentSymbol. `children` is omitted rather than sent empty:
; a client draws an expander arrow for `children: []` and gives the
; reader an empty drawer to open.
(pub :: lspSymbolJson (-> String (Vec Int) Int Int))

(pub fn (lspSymbolJson src ix d)
  (let ((form (lspSymbolExtent src (nodeSpan d))))
    (let ((base (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (nodeAName d))) "kind" (jsonNum (lspSymKind (nodeTag d)))) "range" (lspRangeIx src ix (if (== form 0)
      (nodeSpan d)
      form
    ))) "selectionRange" (lspRangeIx src ix (nodeSpan d)))))
      (if (== form 0)
        base
        (let ((kids (lspSymbolChildren src ix d)))
          (if (== (jsonArrLen kids) 0)
            base
            (jsonObjPut base "children" kids)
          )
        )
      )
    )
  )
)

; The members, in the order they are written. Each is its own name and
; nothing more: a constructor node's span is its name's, and widening
; it to `(Circle Int)` would mean a second extent rule for a form that
; is not at column zero. Contained in the parent's form either way,
; which is what the protocol asks and what the gate now requires
; STRICTLY of every parent that has children.
(pub :: lspSymbolChildren (-> String (Vec Int) Int Int))

(pub fn (lspSymbolChildren src ix d)
  (let (
    (out jsonArr)
    (kind (lspMemberKind (nodeTag d)))
  )
    (if (== kind 0)
      out
      (let (
        (ms (nodeBVec d))
        (mut i 0)
      )
        {
          (while (< i (vecLen ms))
            (let ((m (vecGet ms i)))
              {
                (if (!= (nodeSpan m) 0)
                  (jsonArrPush out (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (nodeAName m))) "kind" (jsonNum kind)) "range" (lspRangeIx src ix (nodeSpan m))) "selectionRange" (lspRangeIx src ix (nodeSpan m))))
                  0
                )
                (set i (+ i 1))
              }
            ))
          out
        }
      )
    )
  )
)

; ------------------------------------------------------------------
; Navigation: a macro invocation is a REFERENCE to its declaration
; (MAC-TOOL-2).
;
; Both requests read the RAW parse tree and expand NOTHING, which is
; MAC-TOOL-3's rule: expansion is bounded but not free (41.4 s on a
; measured fan-out probe), and neither question needs it - the macro's
; declaration is in the document's own text, and hover shows what is
; written there rather than what it produces.
;
; The identifier under a position, by the lexer's own rule for what an
; identifier byte is, so `deriveEq` and `+` and `syntax/join` all
; answer the same way the compiler would read them.
(pub :: lspWordSpan (-> String Int Int))

(pub fn (lspWordSpan src off)
  (let ((n (strLen src)))
    (if (if (>= off n)
      true
      (if (isIdentChar (strByte src off))
        false
        true
      )
    )
      0
      (let (
        (mut s off)
        (mut e off)
      )
        {
          (while (if (> s 0)
            (isIdentChar (strByte src (- s 1)))
            false
          )
            (set s (- s 1)))
          (while (if (< e n)
            (isIdentChar (strByte src e))
            false
          )
            (set e (+ e 1)))
          (mkSpan s e)
        }
      )
    )
  )
)

; The same word as text. Written over the span rather than beside it,
; because two walks of the same rule are two chances to disagree about
; what an identifier byte is.
(pub :: lspWordAt (-> String Int String))

(pub fn (lspWordAt src off)
  (let ((sp (lspWordSpan src off)))
    (if (== sp 0)
      ""
      (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp)))
    )
  )
)

; The byte offset a `{line, character}` names. The inverse of `lspPos`,
; and the same UTF-16 rule read backwards: `character` counts code
; UNITS, so a surrogate pair costs two and every other code point one.
(pub :: lspOffsetOf (-> String (Vec Int) Int Int))

(pub fn (lspOffsetOf src ix pos)
  (let (
    (ln (jsonGetInt pos "line"))
    (ch (jsonGetInt pos "character"))
  )
    (if (|| (< ln 0) (>= ln (vecLen ix)))
      (strLen src)
      (let (
        (start (vecGet ix ln))
        (n (strLen src))
      )
        (let (
          (mut i start)
          (mut u 0)
        )
          {
            (while (if (< i n)
              (if (< u ch)
                (!= (strByte src i) 10)
                false
              )
              false
            )
              (match (utf8DecodeAt src i)
                ((None)
                  {
                    (set u (+ u 1))
                    (set i (+ i 1))
                  })
                ((Some cp)
                  {
                    (set u (+
                      u                      (if (>= cp 65536)
                        2
                        1
                      )
                    ))
                    (set i (+ i (utf8SeqLen (strByte src i))))
                  })
              ))
            i
          }
        )
      )
    )
  )
)

; The macro declaration this document makes under `name`, or 0. The
; LAST one wins, which is `MAC-LANG-11`'s rule - the same answer the
; expander would give a reference at that name.
(pub :: lspFindMacroDecl (-> (Vec Int) String Int Int))

(pub fn (lspFindMacroDecl decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_MACRO) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        d
        (lspFindMacroDecl decls name (- i 1))
      )
    )
  )
)

; The same walk over every declaration KIND the outline already lists -
; a function, a `data`, a `struct` or a macro - rather than over macros
; alone.
;
; `lspWantsSymbol` is reused deliberately: `documentSymbol` and
; `definition` answering different sets of names is the drift this
; repository reports most often, and there is no reason for a name the
; outline shows to be a name navigation cannot reach.
;
; A `(:: f T)` signature is still not a target, for the reason it is
; not in the outline: it shares its name with the `(fn (f) ...)` beside
; it, and jumping to the signature when the body is one line below is
; the wrong of the two answers.
;
; LAST WINS, which is the existing scan's rule and worth keeping: a
; file that declares a name twice is already ill-formed, and the last
; one is what the expander would have used.
(pub :: lspFindDecl (-> (Vec Int) String Int Int))

(pub fn (lspFindDecl decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (lspWantsSymbol (nodeTag d)) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        d
        (lspFindDecl decls name (- i 1))
      )
    )
  )
)

; The same, over the MERGED declaration list `resolveImports` answers -
; so a name this document imported is found in the module that declares
; it.
;
; Two differences from the walk above, and both are about what an
; imported declaration looks like. Its name is MANGLED (`Vec$vecPush`),
; so the comparison is against `bareOf`; and it is not in this
; document, so a declaration whose module is 0 - the entry file - is
; skipped here, having already been offered by `lspFindDecl`.
(pub :: lspFindImported (-> (Vec Int) String Int Int))

(pub fn (lspFindImported decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (lspWantsSymbol (nodeTag d)) (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        d
        (lspFindImported decls name (- i 1))
      )
    )
  )
)

; The unit a declaration's spans index, by module name.
;
; `symbols.ax` has `saUnitOf`, which is this, and it is not imported
; here: `lsp.ax` reaches for `parser`, `typecheck`, `expand` and
; `codegen` and not for the symbol renderer, and a module dependency
; taken for fifteen lines is a dependency the next reader has to
; explain. Answers -1 when no unit carries that name, which is what a
; declaration the resolver did not attribute looks like.
(pub :: lspUnitOf (-> (Vec Int) Int Int))

(pub fn (lspUnitOf units module)
  ; FROM 1, and that is not an optimisation. Unit 0 is the entry file
  ; and its module NAME is `(cast String 0)` - a null handle, because
  ; the entry file has no module name - so asking `strEq` about it
  ; dereferences null. Measured: the server answered the same-file
  ; lookup correctly and then died of SIGSEGV on the first imported
  ; one. `saUnitOf` in `symbols.ax` skips it for the same reason and
  ; is where this rule comes from.
  (let (
    (n (vecLen units))
    (mut i 1)
    (mut at (- 0 1))
  )
    {
      (while (< i n)
        {
          (if (strEq
            (memGetWordStr (vecGet units i) 2)            (cast String module)
          )
            {
              (set at i)
              (set i n)
            }
            0
          )
          (set i (+ i 1))
        })
      at
    }
  )
)

; `/a/b.ax` -> `file:///a/b.ax`, the inverse of `lspUriToPath`.
;
; PERCENT-ENCODING is the whole of it. A path may hold a space, a `%`,
; a `#` or any non-ASCII byte, and an editor asked to open
; `file:///Some Project/a.ax` opens nothing at all - silently, because
; a Location it cannot parse is a Location it ignores. The unreserved
; set is RFC 3986's, plus `/` because it separates the path, plus `.`,
; `-`, `_` and `~`.
;
; A RELATIVE path is made absolute first, against the working
; directory, because `moduleSrcPath` answers `Helper.ax` for a sibling
; module and a Location must name a file the editor can open from
; anywhere.
(pub :: lspPathToUri (-> String String))

;@axiom:effect(io)
(pub fn (lspPathToUri path)
  (let ((abs 
    (if (pathIsAbsolute path)
      path
      ; An unavailable working directory joins as `""`, which is what
      ; this did when `sysGetCwd` answered `""` itself. A language
      ; server that refused to name a document because `getcwd` failed
      ; would be worse than one that names it relatively.
      (pathJoin (unwrapOr sysGetCwd "") path)
    )
  ))
    (let (
      (n (strLen abs))
      (mut i 0)
      (mut out "file://")
    )
      {
        (while (< i n)
          {
            (set out (strConcat
              out              (if (lspUriSafe (strByte abs i))
                (strSlice abs i 1)
                (lspPercent (strByte abs i))
              )
            ))
            (set i (+ i 1))
          })
        out
      }
    )
  )
)

(pub :: lspUriSafe (-> Int Bool))

(pub fn (lspUriSafe b) (|| (&& (>= b 97) (<= b 122)) (|| (&& (>= b 65) (<= b 90)) (|| (&& (>= b 48) (<= b 57)) (|| (== b 47) (|| (== b 46) (|| (== b 45) (|| (== b 95) (== b 126)))))))))

(pub :: lspPercent (-> Int String))

(pub fn (lspPercent b) (strConcat "%" (strConcat (lspHexDigit (/ b 16)) (lspHexDigit (% b 16)))))

(pub :: lspHexDigit (-> Int String))

(pub fn (lspHexDigit v) (strSlice "0123456789ABCDEF" v 1))

; ------------------------------------------------------------------
; The import preamble, once.
;
; Every request that reaches into an imported module needs the same
; nine lines - the four scratch vectors, the entry unit carrying the
; document's REAL text (a unit whose source is empty reports every span
; at offset 0), the preflight, the resolver - and until 2026-08-28 the
; file carried them inline in `lspDefinitionImported`,
; `lspHoverImported` and `lspComplImported`, then in three more places
; the sections added. Six copies of a preamble that must agree with
; `lspCheckDoc` about which files a document imports is six places for
; it to stop agreeing. It is stated here once.
;
; Answers 0 when the preflight found a module it could not read - the
; half-typed-import case, which every caller answers as "this document
; alone" rather than as an error - and otherwise a five-word block:
; word 0 the merged declaration list, 1 the unit table, 2 `bares`,
; 3 `fulls`, 4 `mods` - the last three for the one caller that goes on
; to expand, since `expandProgram` takes the resolver's tables.
;
; A resolver failure is silent by design: a half-typed import is the
; normal state of a file being edited, and a request that answered an
; error while the user was mid-word would make navigation feel broken
; exactly when the file is.
; ------------------------------------------------------------------
(pub :: lspResolveFor (-> String String (Vec Int) Int))

;@axiom:effect(io)
(pub fn (lspResolveFor path src decls)
  (let (
    (bares vecNew)
    (fulls vecNew)
    (mods vecNew)
    (tcode (checkedTargetCode hostTarget))
    (entryDir (pathDir path))
  )
    (let ((units 
      (let ((v vecNew))
        {
          (vecPush
            v            (cast Int (CUnit2
              path              src              (cast String 0)
            ))
          )
          v
        }
      )
    ))
      (let ((missing (lspPreflight decls tcode entryDir vecNew)))
        (if (> (strLen missing) 0)
          0
          (let ((allDecls (resolveImports
            decls            bares            fulls            mods            tcode            entryDir            units
          )))
            (let ((r (memAlloc 40)))
              {
                (memSetWord r 0 allDecls)
                (memSetWord r 1 units)
                (memSetWord r 2 bares)
                (memSetWord r 3 fulls)
                (memSetWord r 4 mods)
                r
              }
            )
          )
        )
      )
    )
  )
)

; `textDocument/definition`: the declaration's own span, as a Location.
;
; TWO LOOKUPS, IN THIS ORDER, and the order is the language's scoping
; rule rather than a preference: a module's own declaration shadows an
; imported one, so this document is asked first and the merged list
; only when it has no answer.
;
;   1. THIS DOCUMENT, over every declaration kind the outline lists -
;      a function, a `data`, a `struct` or a macro. It used to be
;      macros alone, so a call to a function three lines up answered
;      null, which reads to an editor as "there is nothing here"
;      rather than as "this server does not do that".
;   2. EVERY IMPORTED MODULE, by resolving the imports the way
;      `lspCheckDoc` does and searching the merged list. An imported
;      declaration's name is mangled (`Vec$vecPush`) and its spans
;      index its OWN file, so the answer is a Location in that file:
;      the unit table `resolveImports` filled says which, and
;      `lspPathToUri` spells it.
;
; WHAT THE SECOND ONE COSTS, said out loud because `MAC-TOOL-3` is
; about exactly this: it reads and parses every transitively imported
; module, which is what `axiom check` does on every keystroke already
; through `lspCheckDoc`. It runs only when the first lookup misses, so
; a definition request inside the file being edited pays one parse, and
; nothing here expands a macro - the raw tree carries every declaration
; either lookup needs.
;
; A position that is not a name still answers null, which is the
; protocol's way of saying "nothing here" and what an editor expects
; for every other word in the file.
(pub :: lspDefinition (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspDefinition src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonNull
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
      )
        (let ((off (lspOffsetOf src ix (jsonGet params "position"))))
          (let ((w (lspWordAt src off)))
            (if (== (strLen w) 0)
              jsonNull
              ; A LOCAL BINDING FIRST - a `let`, a parameter, a
              ; pattern variable - because a local shadows a
              ; declaration of the same name, which is the
              ; language's rule and SECTION NAV's. 0 means the word
              ; is not one, and the two lookups below then answer
              ; exactly as they did before.
              (let ((loc (lspNavLocalDefinition src uri ix decls off)))
                (if (!= loc 0)
                  loc
                  (let ((d (lspFindDecl decls w (- (vecLen decls) 1))))
                    (if (!= d 0)
                      (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRange src (nodeSpan d)))
                      ; A CONSTRUCTOR THIS DOCUMENT DECLARES, before
                      ; any import is resolved. `lspFindDecl` matches
                      ; whole declarations and never looks inside a
                      ; `data`'s constructor list, which is the only
                      ; place `Circle` is written.
                      (let ((c (lspCtorDefinition src uri decls w)))
                        (if (!= c 0)
                          c
                          (lspDefinitionImported (lspUriToPath uri) src decls w)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The second lookup: resolve this document's imports through
; `lspResolveFor` - the same preamble `lspCheckDoc` runs, so the two
; cannot disagree about what this document imports - and answer a
; Location in whichever module declares `w`. A resolver failure is
; null rather than a diagnostic, for the reason `lspResolveFor` gives.
(pub :: lspDefinitionImported (-> String String (Vec Int) String Int))

;@axiom:effect(io)
(pub fn (lspDefinitionImported path src decls w)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      jsonNull
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
      )
        (let ((d (lspFindImported allDecls w (- (vecLen allDecls) 1))))
          (if (== d 0)
            (lspCtorDefinitionImported allDecls units w)
            (let ((u (lspUnitOf units (nodeModule d))))
              (if (< u 0)
                jsonNull
                (let ((unit (vecGet units u)))
                  (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr (lspPathToUri (memGetWordStr unit 0)))) "range" (lspRange (memGetWordStr unit 1) (nodeSpan d)))
                )
              )
            )
          )
        )
      )
    )
  )
)

; `textDocument/hover`: what the declaration under the cursor says
; about itself, in the words the document uses.
;
; WHAT IT ANSWERS, and each part is left out when the document has not
; got it:
;
;   * a CODE FENCE holding the declaration. For a `fn` that is its
;     SIGNATURE - `(:: bump (-> Int Int))` - because a body is
;     arbitrarily long and "where is this written" is the question
;     `definition` answers; a `fn` with no signature falls back to its
;     own first line. For a macro, a `data` or a `struct` it is the
;     WHOLE form, which is the part a reader wants: the rules, the
;     constructors, the fields.
;   * the MODULE, when the name came from an import.
;   * the COMMENT BLOCK above the declaration, as prose.
;
; IT USED TO ANSWER FOR MACROS ALONE, and null for every other name -
; which reads to an editor as "there is nothing here" rather than as
; "this server does not do that". That is the wrong of the two answers
; `definition` was fixed of on 2026-08-15, and this is the same fix on
; the other request: the lookup order is now `lspDefinition`'s, for the
; reason it has it, which is the language's scoping rule. A module's
; own declaration shadows an imported one, so this document is asked
; first and the merged list only when it has no answer.
;
; `range` IS THE WORD, NOT THE DECLARATION. The protocol's range is the
; part of THIS document the tooltip covers, and sending the
; declaration's span made an editor highlight a line three above the
; word being read - or, for an imported name, a span into a file the
; editor does not have open.
(pub :: lspHover (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspHover src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonNull
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
      )
        (let ((wsp (lspWordSpan src (lspOffsetOf src ix (jsonGet params "position")))))
          (if (== wsp 0)
            jsonNull
            (let (
              (w (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp))))
              (range (lspRangeIx src ix wsp))
            )
              ; A local binding first, for the reason `definition`
              ; asks it first: a local shadows a declaration of the
              ; same name. 0 means the word is not one.
              (let ((local (lspNavLocalHover src decls ix wsp)))
                (if (!= local 0)
                  local
                  (let ((d (lspFindDecl decls w (- (vecLen decls) 1))))
                    (if (!= d 0)
                      (lspHoverAt src decls d range "")
                      ; A CONSTRUCTOR is read at the `data` that
                      ; declares it - the whole form, so its siblings
                      ; and its field types are in the tooltip - with
                      ; one line naming which of them is under the
                      ; cursor. The `range` stays the WORD, which is
                      ; what the rest of this function's header says.
                      (let ((dat (lspFindCtorData decls w (- (vecLen decls) 1))))
                        (if (== (lspCtorNodeOf dat w) 0)
                          (lspHoverImported (lspUriToPath uri) src decls w range)
                          (lspHoverAtNote src decls dat range "" (lspCtorNote dat w))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The hover object for declaration `d`, whose spans index `dsrc` and
; whose signature - if it has one - is in `ddecls`. `range` names the
; word in the document being edited, which is a different document
; whenever `origin` is non-empty.
;
; A `fn` IS READ AT ITS SIGNATURE, not at itself, and that decides two
; answers at once. The fence gets the type rather than a body of
; unbounded length; and the comment block comes from above the `::`,
; which is where this language puts it - `(pub :: bump (-> Int Int))`
; sits between the paragraph and `(pub fn (bump x) ...)`, so a block
; read above the definition is the blank line, every time. A `fn` with
; no signature is read at itself, and then the fence is its first line:
; the header names the parameters, and the body is what `definition`
; is for.
(pub :: lspHoverAt (-> String (Vec Int) Int Int String Int))

(pub fn (lspHoverAt dsrc ddecls d range origin) (lspHoverAtNote dsrc ddecls d range origin ""))

; The same, plus one line of prose between the fence and the `from`
; line. It exists for the constructor hover: the fence quotes the
; whole `data`, which is the right thing to read, and without a note
; the tooltip would not say which of its constructors the cursor is
; actually on. "" is the ordinary case and costs nothing.
(pub :: lspHoverAtNote (-> String (Vec Int) Int Int String String Int))

(pub fn (lspHoverAtNote dsrc ddecls d range origin note)
  (let ((sig 
    (if (== (nodeTag d) TAG_D_FN)
      (lspFindSig ddecls (nodeAName d) (- (vecLen ddecls) 1))
      0
    )
  ))
    (let ((at 
      (if (== sig 0)
        d
        sig
      )
    ))
      (let ((o (lspFormStart dsrc (spanStart (nodeSpan at)))))
        (let (
          (code (lspClampLines (lspHoverCode dsrc d sig o) 40))
          (doc (lspDocComment dsrc o))
        )
          (let ((fence (strConcat (strConcat "```axiom\n" code) "\n```\n")))
            (let ((body
              (if (== (strLen note) 0)
                fence
                (strConcat fence (strConcat (strConcat "\n" note) "\n"))
              )
            ))
            (let ((withMod 
              (if (== (strLen origin) 0)
                body
                (strConcat body (strConcat (strConcat "\nfrom `" origin) "`\n"))
              )
            ))
              (let ((value 
                (if (== (strLen doc) 0)
                  withMod
                  (strConcat withMod (strConcat "\n" doc))
                )
              ))
                (jsonObjPut (jsonObjPut jsonObj "contents" (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value" (jsonStr value))) "range" range)
              )
            )
            )
          )
        )
      )
    )
  )
)

; The fenced half. Everything read at its own form is quoted whole; a
; `fn` with no signature to be read at instead gives up its body.
(pub :: lspHoverCode (-> String Int Int Int String))

(pub fn (lspHoverCode dsrc d sig o)
  (if (&& (== sig 0) (== (nodeTag d) TAG_D_FN))
    (lspFirstLine (lspFormText dsrc o))
    (lspFormText dsrc o)
  )
)

; The second lookup, and it is `lspDefinitionImported` with a different
; answer at the end: the same preflight, the same four scratch vectors,
; the same entry directory, so hover and navigation cannot disagree
; about which module declares a name. What differs is that hover reads
; the OTHER unit's text - `memGetWordStr unit 1` - because the
; declaration's span indexes that file, and names the module it found
; it in, because "where did this come from" is most of what a reader
; hovering an imported name is asking.
(pub :: lspHoverImported (-> String String (Vec Int) String Int Int))

;@axiom:effect(io)
(pub fn (lspHoverImported path src decls w range)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      jsonNull
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
      )
        (let ((d (lspFindImported allDecls w (- (vecLen allDecls) 1))))
          (if (== d 0)
            (lspHoverCtorImported allDecls units w range)
            (let ((u (lspUnitOf units (nodeModule d))))
              (if (< u 0)
                jsonNull
                (let ((unit (vecGet units u)))
                  (lspHoverAt (memGetWordStr unit 1) allDecls d range (memGetWordStr unit 2))
                )
              )
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; Reading a declaration back out of the document
;
; Hover quotes the source rather than rendering the tree, which is the
; same decision `definition` made and for the same reason: what a
; reader wants is what is WRITTEN, comments and spacing and all, and
; the document already holds it. Three questions have to be answered
; from bytes to do that - where the form starts, where it ends, and
; what was said above it.
; ------------------------------------------------------------------
; The `(` that opens the top-level form containing `off`.
;
; WALKING BACK TO THE NEAREST `(` IS A DIFFERENT QUESTION, and a `fn`
; is where the two answers part. A declaration's span names its NAME. A
; macro's name sits directly after its keyword - `(pub macro deriveTag`
; - so the nearest opener behind it is the form's own, which is why the
; nearest-opener rule was right for as long as hover answered macros
; and nothing else. A function's name sits INSIDE its parameter list -
; `(pub fn (bump x) (+ x 1))` - so the nearest opener is `(bump x)`'s,
; and a hover built on it would quote the parameter list and call it
; the declaration.
;
; The rule is COLUMN ZERO: a top-level form begins a line. That is what
; `axiom fmt` writes and what every file this compiler reads is in. A
; document mid-edit that indents a declaration falls back to the
; nearest opener, which is the answer this had before and no worse.
(pub :: lspFormStart (-> String Int Int))

(pub fn (lspFormStart src off)
  (let ((n (strLen src)))
    (if (== n 0)
      0
      (let ((from 
        (if (< off n)
          off
          (- n 1)
        )
      ))
        (let (
          (mut o from)
          (mut best (- 0 1))
          (mut go 1)
        )
          {
            (while (== go 1)
              (if (&& (== (strByte src o) 40) (|| (== o 0) (== (strByte src (- o 1)) 10)))
                {
                  (set best o)
                  (set go 0)
                }
                (if (== o 0)
                  (set go 0)
                  (set o (- o 1))
                )
              ))
            (if (>= best 0)
              best
              (lspNearestOpen src from)
            )
          }
        )
      )
    )
  )
)

; The fallback: the nearest `(` at or before `off`, wherever it sits.
(pub :: lspNearestOpen (-> String Int Int))

(pub fn (lspNearestOpen src off)
  (let ((mut o off))
    {
      (while (if (> o 0)
        (!= (strByte src o) 40)
        false
      )
        (set o (- o 1)))
      o
    }
  )
)

; The offset one past the `)` that closes the form opening at `o`, or
; the document length when nothing closes it - a form half-typed at the
; end of the file runs to EOF, which is what a reader expects of it.
;
; A DEPTH COUNT ALONE IS NOT ENOUGH, and that is the half this used to
; be missing: a `)` inside a string, a char literal, a `;` comment or a
; `#| |#` block is not a closer. A `data` declaration with a comment
; between two constructors ended at the comment's paren and hover
; quoted half a type. Rather than restate the rule this asks the four
; functions `scanAxtags` asks - `skipStringBody`, `skipCharBody`,
; `skipBlockComment`, `findNewline` - in `scanAxtags`'s own order, and
; consumes an identifier whole through `skipIdent` FIRST, because `'`
; is an identifier byte and `f'` must not open a char literal. What
; that costs when it is got wrong is written out at length in
; lexer.ax: one apostrophe silently deleted every AXTAG after it.
;
; Factored out of `lspFormText` so that a section asking where a form
; ENDS - folding, selection ranges, the argument count under a cursor
; - asks the same scanner rather than a second copy of the rule.
(pub :: lspFormEnd (-> String Int Int))

(pub fn (lspFormEnd src o)
  (let (
    (n (strLen src))
    (mut i o)
    (mut depth 0)
    (mut stop (- 0 1))
  )
    {
      (while (if (< i n)
        (< stop 0)
        false
      )
        (let ((ch (strByte src i)))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (set i (skipIdent src (+ i 1) n))
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    {
                      (if (== ch 40)
                        (set depth (+ depth 1))
                        0
                      )
                      (if (== ch 41)
                        {
                          (set depth (- depth 1))
                          (if (<= depth 0)
                            (set stop (+ i 1))
                            0
                          )
                        }
                        0
                      )
                      (set i (+ i 1))
                    }
                  )
                )
              )
            )
          )
        ))
      (if (< stop 0)
        n
        stop
      )
    }
  )
)

; The form at `o`, from its `(` to its matching `)`.
(pub :: lspFormText (-> String Int String))

(pub fn (lspFormText src o) (strSlice src o (- (lspFormEnd src o) o)))

; Every `(` whose form CONTAINS `off`, outermost first, as a Vec of
; byte offsets. A form contains `off` when it opens before `off` and
; has not closed by `off`; a form opening exactly AT `off` is not in
; the list, and a caller that wants it tests `(strByte src off)` for
; `(` itself.
;
; One forward pass from the top-level form's own opener - the
; column-zero rule of `lspFormStart` - so the cost is the length of ONE
; top-level form and not of the document. The scanner is the one
; `lspFormEnd` uses, for the reason it exists: a `(` inside a string or
; a comment is not an opener.
;
; What this is for: the enclosing call under a cursor asking for
; signature help, the chain of ranges a selection expands through, and
; the forms a folding request lists - three questions with one answer,
; which is why it sits here and not in any one section.
(pub :: lspEnclosingOpens (-> String Int (Vec Int)))

(pub fn (lspEnclosingOpens src off)
  (let (
    (n (strLen src))
    (stack vecNew)
  )
    (if (|| (== n 0) (> off n))
      stack
      (let ((mut i (lspFormStart src off)))
        {
          (while (< i off)
            (let ((ch (strByte src i)))
              (if (== ch 34)
                (set i (skipStringBody src (+ i 1) n))
                (if (isIdentStart ch)
                  (set i (skipIdent src (+ i 1) n))
                  (if (== ch 39)
                    (set i (skipCharBody src (+ i 1) n))
                    (if (&& (== ch 35) (isBlockOpen src i n))
                      (set i (skipBlockComment src (+ i 2) n))
                      (if (== ch 59)
                        (set i (findNewline src i n))
                        {
                          (if (== ch 40)
                            (vecPush stack i)
                            (cast (Vec Int) 0)
                          )
                          (if (&& (== ch 41) (> (vecLen stack) 0))
                            (vecPop stack)
                            0
                          )
                          (set i (+ i 1))
                        }
                      )
                    )
                  )
                )
              )
            ))
          stack
        }
      )
    )
  )
)

; Whether a non-zero span covers `off` - the byte at `off` is inside
; `[start, end)`. A span of 0 covers nothing.
(pub :: lspSpanHas (-> Int Int Bool))

(pub fn (lspSpanHas sp off)
  (if (== sp 0)
    false
    (&& (>= off (spanStart sp)) (< off (spanEnd sp)))
  )
)

; The declaration's own source text. The span names the NAME; the form
; around it is what a reader asked for.
(pub :: lspDeclText (-> String Int String))

(pub fn (lspDeclText src sp) (lspFormText src (lspFormStart src (spanStart sp))))

; The comment block written directly above the form at `o`, as prose.
;
; This is the half of hover a signature cannot give. Every file this
; compiler reads documents a declaration in the lines above it - this
; one included - and an editor that shows the type and not the
; paragraph shows the less useful half.
;
; THE BLOCK STOPS AT A BANNER. A comment whose body is nothing but `-`
; or `=` is a section separator: it belongs to the FILE, and what sits
; above it documents the section rather than this declaration. Without
; that rule, hover on the first declaration after a banner quoted the
; banner, the section header and every line of prose introducing it.
; A blank line ends the block too, which is what a paragraph break
; between two declarations means.
;
; Only a form that begins a line has a block above it; the indented
; fallback in `lspFormStart` answers "" rather than reading whatever
; text happens to precede it on the same line.
(pub :: lspDocComment (-> String Int String))

(pub fn (lspDocComment src o)
  (if (if (== o 0)
    true
    (!= (strByte src (- o 1)) 10)
  )
    ""
    (let (
      (mut e o)
      (mut out "")
      (mut go 1)
    )
      {
        (while (== go 1)
          (if (<= e 0)
            (set go 0)
            (let ((ls (lspPrevLineStart src e)))
              (let ((line (strSlice src ls (- (- e 1) ls))))
                (if (lspIsDocLine line)
                  {
                    (set out (strConcat (strConcat (lspDocStrip line) "\n") out))
                    (set e ls)
                  }
                  (set go 0)
                )
              )
            )
          ))
        out
      }
    )
  )
)

; The start of the line whose newline sits at `e - 1`.
(pub :: lspPrevLineStart (-> String Int Int))

(pub fn (lspPrevLineStart src e)
  (let ((mut i (- e 1)))
    {
      (while (if (> i 0)
        (!= (strByte src (- i 1)) 10)
        false
      )
        (set i (- i 1)))
      i
    }
  )
)

; A line that is entirely a comment, and is not a banner.
(pub :: lspIsDocLine (-> String Bool))

(pub fn (lspIsDocLine line)
  (let (
    (n (strLen line))
    (mut i 0)
  )
    {
      (while (if (< i n)
        (lspIsBlank (strByte line i))
        false
      )
        (set i (+ i 1)))
      (if (>= i n)
        false
        (if (!= (strByte line i) 59)
          false
          (lspNotBanner line (+ i 1))
        )
      )
    }
  )
)

; A comment body of nothing but `-` or `=` is a rule across the page,
; not a sentence about the declaration below it.
;
; AN EMPTY BODY IS NOT ONE. A bare `;` is the paragraph break inside a
; doc block and is how nearly every multi-paragraph comment in this
; repository is written, so a banner test that fired on "no text" cut
; every such block down to its last paragraph - measured on `bump`,
; whose first sentence disappeared. A banner needs a rule character
; PRESENT and nothing else beside it.
(pub :: lspNotBanner (-> String Int Bool))

(pub fn (lspNotBanner line i)
  (let (
    (n (strLen line))
    (mut k i)
    (mut rule 0)
    (mut other 0)
  )
    {
      (while (< k n)
        {
          (let ((b (strByte line k)))
            (if (|| (== b 45) (== b 61))
              (set rule 1)
              (if (lspIsBlank b)
                0
                (set other 1)
              )
            ))
          (set k (+ k 1))
        })
      (|| (== other 1) (== rule 0))
    }
  )
)

(pub :: lspIsBlank (-> Int Bool))

(pub fn (lspIsBlank b) (|| (== b 32) (== b 9)))

(pub :: lspIsSpace (-> Int Bool))

(pub fn (lspIsSpace b) (|| (lspIsBlank b) (|| (== b 10) (== b 13))))

; One comment line as prose: the leading blanks, the `;`, and one space
; after it. `;@axiom:effect(io)` keeps its `@`, because an AXTAG is
; part of what the declaration claims about itself and a reader hovering
; it wants to see the claim.
(pub :: lspDocStrip (-> String String))

(pub fn (lspDocStrip line)
  (let (
    (n (strLen line))
    (mut i 0)
  )
    {
      (while (if (< i n)
        (lspIsBlank (strByte line i))
        false
      )
        (set i (+ i 1)))
      (if (< i n)
        (set i (+ i 1))
        0
      )
      (if (if (< i n)
        (== (strByte line i) 32)
        false
      )
        (set i (+ i 1))
        0
      )
      (strSlice line i (- n i))
    }
  )
)

; At most `max` lines of `s`, with the cut said out loud in the fence's
; own comment syntax. Hover is a tooltip: a two-hundred-constructor
; `data` quoted whole is a wall the editor draws over the code being
; read.
(pub :: lspClampLines (-> String Int String))

(pub fn (lspClampLines s max)
  (let (
    (n (strLen s))
    (mut i 0)
    (mut lines 0)
    (mut cut (- 0 1))
  )
    {
      (while (if (< i n)
        (< cut 0)
        false
      )
        {
          (if (== (strByte s i) 10)
            {
              (set lines (+ lines 1))
              (if (>= lines max)
                (set cut i)
                0
              )
            }
            0
          )
          (set i (+ i 1))
        })
      (if (< cut 0)
        s
        (strConcat (strSlice s 0 cut) "\n  ; ...")
      )
    }
  )
)

(pub :: lspFirstLine (-> String String))

(pub fn (lspFirstLine s)
  (match (strFindByte s 10 0)
    ((None) s)
    ((Some nl) (strSlice s 0 nl))
  )
)

; The last `(:: name T)` this declaration list carries for `name`.
;
; The comparison is EXACT, and it is exact for imported names too:
; `resolveImports` mangles a signature and its definition the same way,
; so `NavHelper$bump`'s type is found under `NavHelper$bump`. Type
; names are not mangled, which is why this is asked about functions
; and nothing else.
(pub :: lspFindSig (-> (Vec Int) String Int Int))

(pub fn (lspFindSig decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_SIG) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        d
        (lspFindSig decls name (- i 1))
      )
    )
  )
)

; The TYPE a signature declares, as its own bytes: `(pub :: bump (-> Int
; Int))` answers `(-> Int Int)`. A completion list has room for the
; type and not for the form around it.
;
; The name is skipped by walking identifier bytes from the span rather
; than by its length, because an imported declaration's `nodeAName` is
; `NavHelper$bump` and the source spells `bump`.
(pub :: lspSigType (-> String Int String))

(pub fn (lspSigType src sig)
  (let ((o (lspFormStart src (spanStart (nodeSpan sig)))))
    (let ((t (lspFormText src o)))
      (let (
        (n (strLen t))
        (mut i (- (spanStart (nodeSpan sig)) o))
      )
        {
          (if (|| (< i 0) (>= i n))
            (set i n)
            0
          )
          (while (if (< i n)
            (isIdentChar (strByte t i))
            false
          )
            (set i (+ i 1)))
          (while (if (< i n)
            (lspIsSpace (strByte t i))
            false
          )
            (set i (+ i 1)))
          (let ((mut e (- n 1)))
            {
              (while (if (> e i)
                (lspIsSpace (strByte t (- e 1)))
                false
              )
                (set e (- e 1)))
              (if (> e i)
                (strSlice t i (- e i))
                ""
              )
            }
          )
        }
      )
    )
  )
)

(pub :: lspDocumentSymbols (-> String Int))

(pub fn (lspDocumentSymbols src)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonArr
      (let (
        (decls (memGetWordVec pr 1))
        (out jsonArr)
        (ix (lspLineIndex src))
        (mut i 0)
      )
        {
          (while (< i (vecLen decls))
            (let ((n (vecGet decls i)))
              {
                ; A `(syntax/join a b)` name parses to the marker
                ; string "syntax/join a b" (space-joined). The
                ; outline reads the RAW parse tree - deliberately,
                ; see the header - so a half-written derive macro's
                ; marker would otherwise publish its space-bearing
                ; spelling to the editor. Skipped: the expander is
                ; what resolves or refuses it, and either way the
                ; marker is not a name anyone can navigate to.
                (if (&& (lspWantsSymbol (nodeTag n)) (&& (!= (nodeSpan n) 0) (== (expIsJoinMarker (nodeAName n)) 0)))
                  (jsonArrPush out (lspSymbolJson src ix n))
                  0
                )
                (set i (+ i 1))
              }
            ))
          out
        }
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/completion`: the names that could go where the cursor
; is.
;
; WHAT IS OFFERED, in the order a client receives it:
;
;   1. THE HEAD KEYWORDS the parser dispatches on - `let`, `if`,
;      `match`, `fn`, `data` and the rest. No declaration list carries
;      them, and a half-typed form is usually reaching for one.
;   2. THIS DOCUMENT'S declarations, over the kinds the outline lists,
;      plus the CONSTRUCTORS a `data` declares: `Red` is a name that
;      gets written and it is not a declaration of its own.
;   3. EVERY IMPORTED MODULE'S declarations, under their bare names,
;      with the module in `detail`.
;
; A LOCAL NAME SHADOWS AN IMPORTED ONE and both shadow a keyword, which
; is the language's own rule and the reason for that order; a name
; already offered is not offered twice.
;
; THE PREFIX IS APPLIED HERE, and `isIncomplete` is what makes that
; correct rather than a shortcut. A client is entitled to filter a
; COMPLETE list itself and stop asking. This server answers only the
; names starting with what has been typed, so it must say the list is
; partial and be asked again on the next keystroke - answering
; `isIncomplete: false` to a filtered list is how a completion menu
; ends up frozen on the first letter. The `LSP_COMPL_MAX` cap rides on
; the same field: a menu is not a directory listing, and a truncation
; a client has been told about is not a silent one.
;
; A DOCUMENT THAT DOES NOT PARSE STILL COMPLETES, with the keywords.
; That is not a degraded case to apologise for - it is the normal one.
; A file is unparseable exactly while a form is half written, which is
; exactly when the question is being asked.
;
; WHAT IT COSTS: the parse and the import resolution `didOpen` already
; runs on every keystroke, and no expansion - MAC-TOOL-3's rule, the
; one `definition` and `hover` keep. `check-lsp-selfhost.sh` holds the
; whole request under the cost of that `didOpen` as a ratio, and holds
; the menu under `LSP_COMPL_MAX` items. It does NOT hold the guard
; below: both requests are dominated by the one parse every request in
; this server pays, so no wall-clock ceiling separates a build that
; asks the cheap question first from one that does not. That gate's
; header says so rather than implying otherwise.
; ------------------------------------------------------------------
; A menu, not a directory. 200 is far past what any client shows and
; far short of the six thousand names a stdlib-wide empty prefix would
; otherwise serialise on every keystroke.
(pub :: LSP_COMPL_MAX Int)

(pub fn (LSP_COMPL_MAX) 200)

; The head keywords, spelled once.
;
; This list is a COPY of a set the parser owns, and it is a checked
; copy: `check-lsp-selfhost.sh` derives that set from the `kwEq name`
; call sites in `self_host/parser.ax` and requires this to equal it. So
; a keyword the parser learns and this forgets is a red gate rather
; than a menu quietly behind the language - which is the drift a
; hand-kept list of another module's vocabulary otherwise guarantees.
;
; The four the parser names only in order to REFUSE them - `union`,
; `foreign` and, since 0.6.0, `trait` and `impl`, whose whole effect
; is AX2004 - are not offered. Suggesting a word that cannot be used
; is worse than suggesting nothing. `tests/lsp/drive.py` carries the
; same four as the exclusion set it subtracts from the parser's
; `kwEq` sites, and the equality between the two is what
; `check-lsp-selfhost.sh` asserts. `region` was the fifth until
; 2026-09-03; it is a keyword again (`parseRegionExpr`) and is offered
; like `while`.
(pub :: lspKeywords (Vec String))

(pub fn (lspKeywords)
  (let ((v vecNew))
    {
      (vecPush v "alloc")
      (vecPush v "begin")
      (vecPush v "cond")
      (vecPush v "consume")
      (vecPush v "data")
      (vecPush v "define")
      (vecPush v "effect")
      (vecPush v "extern")
      (vecPush v "fn")
      (vecPush v "for")
      (vecPush v "handle")
      (vecPush v "if")
      (vecPush v "import")
      (vecPush v "lambda")
      (vecPush v "let")
      (vecPush v "macro")
      (vecPush v "match")
      (vecPush v "parallel")
      (vecPush v "pub")
      (vecPush v "region")
      (vecPush v "set")
      (vecPush v "struct")
      (vecPush v "syntax/for")
      (vecPush v "type")
      (vecPush v "while")
      v
    }
  )
)

; LSP CompletionItemKind. Function 3, Keyword 14, Enum 13, EnumMember
; 20, Struct 22. A macro is a Function: the protocol has no kind for
; one, and `lspSymKind` collapses it the same way for the outline.
(pub :: lspComplKind (-> Int Int))

(pub fn (lspComplKind tag)
  (if (== tag TAG_D_DATA)
    13
    (if (== tag TAG_D_STRUCT)
      22
      3
    )
  )
)

(pub :: lspComplItem (-> String Int String Int))

(pub fn (lspComplItem label kind detail)
  (let ((base (jsonObjPut (jsonObjPut jsonObj "label" (jsonStr label)) "kind" (jsonNum kind))))
    (if (== (strLen detail) 0)
      base
      (jsonObjPut base "detail" (jsonStr detail))
    )
  )
)

; Whether `label` would be offered.
;
; Asked BEFORE a detail is built, and that is the whole point of its
; existing separately: `lspComplDetail` scans the declaration list for
; a signature, so building one for every declaration and then
; discarding it on the prefix is n-squared paid per keystroke -
; measured at 25 ms on a 2,050-declaration document, 65 ms at 6,000.
; Axiom is strict; the only way not to compute an argument is not to
; reach the call.
;
; Nothing but this comment holds it. The cost gate bounds the request
; against a `didOpen` that is itself dominated by a parse, and both
; builds sit inside that ceiling - so the guard is held by review, and
; deleting it is a change to make on purpose.
(pub :: lspComplWants (-> (Vec String) String String Bool))

(pub fn (lspComplWants seen label prefix)
  (if (>= (vecLen seen) LSP_COMPL_MAX)
    false
    (if (== (strLen label) 0)
      false
      (if (== (expIsJoinMarker label) 0)
        (if (strStartsWith label prefix)
          (if (lspSeenHas seen label)
            false
            true
          )
          false
        )
        false
      )
    )
  )
)

(pub :: lspComplOffer (-> Int (Vec String) String Int String String Int))

(pub fn (lspComplOffer out seen label kind detail prefix)
  (if (lspComplWants seen label prefix)
    {
      (vecPush seen label)
      (jsonArrPush out (lspComplItem label kind detail))
      0
    }
    0
  )
)

; The identifier bytes immediately BEFORE the cursor.
;
; `lspWordAt` will not do, and the difference is the whole request: it
; requires the offset to be ON an identifier byte, and a cursor that
; has just typed `vecP` sits one past the `P`, on whatever comes next
; or on nothing at all.
(pub :: lspPrefixAt (-> String Int String))

(pub fn (lspPrefixAt src off)
  (let (
    (n (strLen src))
    (e 
      (if (> off n)
        n
        off
      )
    )
  )
    (let ((mut s e))
      {
        (while (if (> s 0)
          (isIdentChar (strByte src (- s 1)))
          false
        )
          (set s (- s 1)))
        (strSlice src s (- e s))
      }
    )
  )
)

(pub :: lspComplList (-> Int Int))

(pub fn (lspComplList items) (jsonObjPut (jsonObjPut jsonObj "isIncomplete" (jsonBool 1)) "items" items))

(pub :: lspCompletion (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspCompletion src uri params)
  (let (
    (ix (lspLineIndex src))
    (out jsonArr)
    (seen vecNew)
  )
    (let ((prefix (lspPrefixAt src (lspOffsetOf src ix (jsonGet params "position")))))
      (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
        {
          (lspComplKeywords out seen prefix)
          (if (== (memGetWord pr 0) 0)
            0
            (let ((decls (memGetWordVec pr 1)))
              {
                (lspComplLocal out seen src decls prefix)
                (lspComplImported out seen (lspUriToPath uri) src decls prefix)
              }
            )
          )
          (lspComplList out)
        }
      )
    )
  )
)

(pub :: lspComplKeywords (-> Int (Vec String) String Int))

(pub fn (lspComplKeywords out seen prefix)
  (let (
    (kws lspKeywords)
    (n (vecLen kws))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (lspComplOffer out seen (vecGetStr kws i) 14 "keyword" prefix)
          (set i (+ i 1))
        })
      0
    }
  )
)

; This document's own names. The same set the outline publishes - so a
; name an editor can list, jump to and hover is a name it can also
; complete - plus the constructors, which the outline leaves out
; because they are not declarations and completion wants because they
; are names.
(pub :: lspComplLocal (-> Int (Vec String) String (Vec Int) String Int))

(pub fn (lspComplLocal out seen src decls prefix)
  (let (
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((d (vecGet decls i)))
          {
            (if (&& (lspWantsSymbol (nodeTag d)) (!= (nodeSpan d) 0))
              {
                (if (lspComplWants seen (nodeAName d) prefix)
                  (lspComplOffer
                    out                    seen                    (nodeAName d)                    (lspComplKind (nodeTag d))                    (lspComplDetail src decls d)                    prefix
                  )
                  0
                )
                (if (== (nodeTag d) TAG_D_DATA)
                  (lspComplCtors out seen (nodeBVec d) prefix)
                  0
                )
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; A local function's type, as written. Only a `fn` has one to show, and
; only the document's own declarations are asked: over the merged list
; this scan is the length of every module imported, per accepted item,
; per keystroke. An imported name shows its MODULE instead, which is
; the question being asked about it anyway and costs one walk of the
; mangled name.
(pub :: lspComplDetail (-> String (Vec Int) Int String))

(pub fn (lspComplDetail src decls d)
  (if (== (nodeTag d) TAG_D_FN)
    (let ((sig (lspFindSig decls (nodeAName d) (- (vecLen decls) 1))))
      (if (== sig 0)
        ""
        (lspSigType src sig)
      )
    )
    ""
  )
)

(pub :: lspComplCtors (-> Int (Vec String) (Vec Int) String Int))

(pub fn (lspComplCtors out seen ctors prefix)
  (let (
    (n (vecLen ctors))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (lspComplOffer out seen (nodeAName (vecGet ctors i)) 20 "" prefix)
          (set i (+ i 1))
        })
      0
    }
  )
)

; Everything the imports bring in, by the bare name a reference spells.
;
; The resolver is given what `lspCheckDoc` and `lspDefinitionImported`
; give it, for the reason they agree on it: a different entry directory
; resolves a different set of files, and a completion list that does
; not match the names the checker will accept is worse than no list.
; A resolver failure is an empty addition rather than a diagnostic -
; half-typed imports are the normal state of a file being edited.
(pub :: lspComplImported (-> Int (Vec String) String String (Vec Int) String Int))

;@axiom:effect(io)
(pub fn (lspComplImported out seen path src decls prefix)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      0
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWord r 1))
      )
        (let (
          (n (vecLen allDecls))
          (mut i 0)
        )
          {
            (while (< i n)
              (let ((d (vecGet allDecls i)))
                {
                  (if (&& (lspWantsSymbol (nodeTag d)) (&& (!= (nodeModule d) 0) (!= (nodeSpan d) 0)))
                    {
                      (lspComplOffer
                        out                            seen                            (bareOf (nodeAName d))                            (lspComplKind (nodeTag d))                            (lspModOf (nodeAName d))                            prefix
                      )
                      (if (== (nodeTag d) TAG_D_DATA)
                        (lspComplCtors out seen (nodeBVec d) prefix)
                        0
                      )
                    }
                    0
                  )
                  (set i (+ i 1))
                }
              ))
            0
          }
        )
      )
    )
  )
)

; The module half of a mangled name: `Vec$vecPush` answers `Vec`. The
; other half of `bareOf`, and "" for a name nothing mangled - a type
; name, which `resolveImports` does not rewrite.
(pub :: lspModOf (-> String String))

(pub fn (lspModOf s) (lspModOfFrom s (- (strLen s) 1)))

(pub :: lspModOfFrom (-> String Int String))

(pub fn (lspModOfFrom s i)
  (if (< i 0)
    ""
    (if (== (strByte s i) 36)
      (strSlice s 0 i)
      (lspModOfFrom s (- i 1))
    )
  )
)

;; The byte two hex digits at `i` and `i+1` spell, or `None` when either
;; is not a digit. `strHexVal` answers `(Option Int)` and both reads are
;; matched directly, so no block is built; the combined value is what
;; the percent-decoder below stores.
(:: lspHexPair (-> String Int (Option Int)))

(fn (lspHexPair s i)
  (match (strHexVal (strByte s i))
    ((None) None)
    ((Some h)
      (match (strHexVal (strByte s (+ i 1)))
        ((None) None)
        ((Some l) (Some (+ (* h 16) l)))
      ))
  )
)

; ------------------------------------------------------------------
; URIs
;
; `file:///a/b.ax` -> `/a/b.ax`, percent-decoding as it goes. Anything
; that is not a `file:` URI is passed through unchanged: the checker
; only ever uses the path to find sibling modules, so a URI it cannot
; interpret degrades to "no import directory" rather than to a refusal.
; ------------------------------------------------------------------
(pub :: lspUriToPath (-> String String))

(pub fn (lspUriToPath uri)
  (let ((body 
    (if (strStartsWith uri "file://")
      (strSlice uri 7 (- (strLen uri) 7))
      uri
    )
  ))
    (let (
      (out (strAlloc (strLen body)))
      (mut i 0)
      (mut o 0)
    )
      {
        (while (< i (strLen body))
          (if (&& (== (strByte body i) 37) (<= (+ i 3) (strLen body)))
            (match (lspHexPair body (+ i 1))
              ((None)
                {
                  (__store8 (strData out) o (strByte body i))
                  (set o (+ o 1))
                  (set i (+ i 1))
                })
              ((Some hl)
                {
                  (__store8 (strData out) o hl)
                  (set o (+ o 1))
                  (set i (+ i 3))
                })
            )
            {
              (__store8 (strData out) o (strByte body i))
              (set o (+ o 1))
              (set i (+ i 1))
            }
          ))
        (strSlice out 0 o)
      }
    )
  )
)

; ------------------------------------------------------------------
; The document store: two parallel Vecs, one writer.
; ------------------------------------------------------------------
(pub :: docFind (-> (Vec String) String Int))

(pub fn (docFind uris uri) (docFindFrom uris uri 0))

(pub :: docFindFrom (-> (Vec String) String Int Int))

(pub fn (docFindFrom uris uri i)
  (if (>= i (vecLen uris))
    (- 0 1)
    (if (strEq (vecGetStr uris i) uri)
      i
      (docFindFrom uris uri (+ i 1))
    )
  )
)

; The ONLY writer of the pair. Both vecs are appended together or
; neither is, so their indices cannot drift apart.
(pub :: docPut (-> (Vec String) (Vec String) String String Int))

(pub fn (docPut uris texts uri text)
  (let ((i (docFind uris uri)))
    (if (< i 0)
      {
        (vecPush uris uri)
        (vecPush texts text)
        (vecLen uris)
      }
      {
        (vecSet texts i text)
        (vecLen uris)
      }
    )
  )
)

(pub :: docText (-> (Vec String) (Vec a) String String))

(pub fn (docText uris texts uri)
  (let ((i (docFind uris uri)))
    (if (< i 0)
      ""
      (vecGetStr texts i)
    )
  )
)

; ------------------------------------------------------------------
; The request boundary
; ------------------------------------------------------------------
;
; A request's working set is dead the moment its response is written:
; the parse tree, every diagnostic, the JSON on the way out. What
; survives is the document store, and whatever bytes of the *next*
; message this read already pulled into the reader. Nothing else.
;
; Nothing reclaimed it. Measured on `didChange` of a 16 KB file:
; 8.3 MB after one edit, 693.7 MB after two hundred - 3.4 MB retained
; per keystroke-sized edit, for the lifetime of the session. That is
; the roadmap's §1 dependency edge with a number on it: an editor is a
; long-running program, and a bump allocator that never frees is a
; leak with a language server attached.
;
; So the loop marks the arena once, and reclaims to that mark after
; every message - carrying the live state across the reclaim as ONE
; block. That is `__axiom_arena_reset_keeping`, and it has to be one
; operation rather than a reset followed by a copy: the copy's
; destination would be handed out by the allocator, which scrubs
; re-used memory, and the scrub runs over the source whenever the live
; set is bigger than the garbage - which is precisely a server holding
; a document and answering a short request. See
; tests/stdlib/165-arena-keep.ax, where the naive spelling loses 39,841
; of 40,000 bytes on its first round.
;
; The block is laid out so that restoring it needs no allocation it
; cannot make afterwards:
;
;   word 0   total bytes (what the reclaim is told to keep)
;   word 1   document count N
;   word 2   unconsumed reader bytes U
;   word 3.. N pairs of (uri length, text length)
;   then     U bytes of reader input, then each uri and text in order
(pub :: lspSnapshot (-> (Vec String) (Vec String) Int Int))

(pub fn (lspSnapshot uris texts r)
  (let (
    (n (vecLen uris))
    (u (- (rdFilled r) (rdConsumed r)))
  )
    (let (
      (head (* 8 (+ 3 (* 2 n))))
      (mut total 0)
      (mut i 0)
    )
      {
        (set total (+ head u))
        (while (< i n)
          {
            (set total (+ total (+ (strLen (vecGetStr uris i)) (strLen (vecGetStr texts i)))))
            (set i (+ i 1))
          })
        (let (
          (b (memAlloc total))
          (mut j 0)
          (mut at head)
        )
          {
            (memSetWord b 0 total)
            (memSetWord b 1 n)
            (memSetWord b 2 u)
            (while (< j n)
              {
                (memSetWord b (+ 3 (* 2 j)) (strLen (vecGetStr uris j)))
                (memSetWord b (+ 4 (* 2 j)) (strLen (vecGetStr texts j)))
                (set j (+ j 1))
              })
            (memCopy (+ b at) (+ (strData (rdBuf r)) (rdConsumed r)) u)
            (set at (+ at u))
            (set j 0)
            (while (< j n)
              (let (
                (uu (vecGetStr uris j))
                (tt (vecGetStr texts j))
              )
                {
                  (memCopy (+ b at) (strData uu) (strLen uu))
                  (set at (+ at (strLen uu)))
                  (memCopy (+ b at) (strData tt) (strLen tt))
                  (set at (+ at (strLen tt)))
                  (set j (+ j 1))
                }
              ))
            b
          }
        )
      }
    )
  )
)

; Rebuild the store and the reader out of a snapshot the reclaim has
; already moved down to the waterline, and answer the three handles in
; a block, since a function answers one value.
;
; The strings are `strDup`ped out of the block rather than pointed into
; it: a `Str` inside the block has no NUL terminator after it, and
; `strCStr` is what hands a uri to anything outside this module.
(pub :: lspRestore (-> Int Int))

(pub fn (lspRestore b)
  (let (
    (n (memGetWord b 1))
    (u (memGetWord b 2))
    (fu vecNew)
    (ft vecNew)
    (r (rdNew 0))
  )
    (let (
      (mut j 0)
      (mut at (* 8 (+ 3 (* 2 n))))
    )
      {
        (rdReseat r (+ b at) u)
        (set at (+ at u))
        (while (< j n)
          (let (
            (ul (memGetWord b (+ 3 (* 2 j))))
            (tl (memGetWord b (+ 4 (* 2 j))))
          )
            {
              (vecPush fu (strDup (strWrap (+ b at) ul)))
              (set at (+ at ul))
              (vecPush ft (strDup (strWrap (+ b at) tl)))
              (set at (+ at tl))
              (set j (+ j 1))
            }
          ))
        (let ((h (memAlloc 24)))
          {
            (memSetWord h 0 fu)
            (memSetWord h 1 ft)
            (memSetWord h 2 r)
            h
          }
        )
      }
    )
  )
)

; ------------------------------------------------------------------
; Protocol
; ------------------------------------------------------------------
(pub :: lspSend (-> Int Int))

;@axiom:effect(io)
(pub fn (lspSend obj) (rpcWrite 1 (jsonWrite obj)))

; A response carries back the request's `id` NODE, not its integer: LSP
; ids may be strings, and echoing a number where a string was sent is a
; protocol violation the client is entitled to drop the connection over.
(pub :: lspReply (-> Int Int Int))

;@axiom:effect(io)
(pub fn (lspReply id result) (lspSend (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "id" id) "result" result)))

(pub :: lspError (-> Int Int String Int))

;@axiom:effect(io)
(pub fn (lspError id code msg) (lspSend (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "id" id) "error" (jsonObjPut (jsonObjPut jsonObj "code" (jsonNum code)) "message" (jsonStr msg)))))

(pub :: lspNotify (-> String Int Int))

;@axiom:effect(io)
(pub fn (lspNotify method params) (lspSend (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "method" (jsonStr method)) "params" params)))

(pub :: lspPublish (-> String Int Int))

;@axiom:effect(io)
(pub fn (lspPublish uri diags) (lspNotify "textDocument/publishDiagnostics" (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "diagnostics" diags)))

; What this server can do. `textDocumentSync: 1` is full-text sync.
;
; `documentSymbolProvider` has to be here, and was not. A conforming
; client reads this object and sends only what it names, so the outline
; - the one feature this server has that is not a diagnostic - was
; answered correctly by `lspDocumentSymbol` and requested by nobody. The
; gate could not see it either: the fixture sends the request
; unconditionally, the way no editor does, so both sides agreed on a
; conversation that cannot happen. A capability is a promise the client
; reads, and an implementation nothing advertises is an implementation
; nothing calls.
(pub :: lspCapabilities Int)

(pub fn (lspCapabilities) (jsonObjPut (jsonObjPut jsonObj "capabilities" (lspFixCaps (lspViewCaps (lspNavCaps (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "textDocumentSync" (jsonNum 1)) "documentSymbolProvider" (jsonBool 1)) "definitionProvider" (jsonBool 1)) "hoverProvider" (jsonBool 1)) "completionProvider" lspCompletionOptions))))) "serverInfo" (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr "axiom")) "version" (jsonStr "0.7.5"))))

; `definitionProvider` and `hoverProvider` joined on 2026-08-15
; with the macro navigation they describe (MAC-TOOL-2). Both are
; answered from the raw parse tree, so a client that sends them
; per keystroke costs a parse and no expansion (MAC-TOOL-3).
; `completionProvider` joined on 2026-08-26, under the same rule.

; `completionProvider` is an OBJECT where the three beside it are
; booleans, and both of its fields are load-bearing.
;
; `resolveProvider: false` says every item is complete as sent. There
; is no `completionItem/resolve` here, and a client that believed
; otherwise would show a menu of labels and wait for a second round
; trip that never comes.
;
; `triggerCharacters: ["("]` is the language's own shape. A client
; sends an UNPROMPTED completion request only at a character this list
; names, and in a language where every call opens a paren, `(` is the
; moment a name is being reached for. Typing into a word asks anyway.
(pub :: lspCompletionOptions Int)

(pub fn (lspCompletionOptions) (jsonObjPut (jsonObjPut jsonObj "resolveProvider" (jsonBool 0)) "triggerCharacters" (jsonArrPush jsonArr (jsonStr "("))))

; Check the document behind `uri` and publish the result.
(pub :: lspRecheck (-> (Vec String) (Vec String) String Int))

;@axiom:effect(io)
(pub fn (lspRecheck uris texts uri) (lspPublish uri (lspCheckDoc (lspUriToPath uri) (docText uris texts uri))))

; The URI a `textDocument`-shaped params object names.
(pub :: lspParamsUri (-> Int String))

(pub fn (lspParamsUri params) (jsonGetStr (jsonGet params "textDocument") "uri"))

; The whole new text of a full-sync `didChange`: the LAST content
; change wins, because a full-sync server receives exactly one and a
; client that sent several would mean the last to be the final state.
(pub :: lspChangeText (-> Int String))

(pub fn (lspChangeText params)
  (let ((cs (jsonGet params "contentChanges")))
    (if (== (jsonArrLen cs) 0)
      ""
      (jsonGetStr (jsonArrGet cs (- (jsonArrLen cs) 1)) "text")
    )
  )
)

; ------------------------------------------------------------------
; The extension door
;
; Four sections follow, each owning a set of requests and nothing
; else: NAVIGATION (references, rename, highlights, the local-binding
; half of definition), VIEWS (signature help, inlay hints, folding,
; selection ranges, document links, workspace symbols), FIXES
; (formatting, code actions, macro expansion, code lenses, type
; definition, diagnostics for imported modules) and HIGHLIGHTING
; (semantic tokens). Each section answers
; three questions in the same shape - does it handle `method`, what
; does it reply, and what does it advertise - and `lspExtHandles` /
; `lspExtDispatch` / `lspCapabilities` ask all three in a fixed order.
; A method two sections both claimed would be answered by the first;
; none does, and the gate's per-method checks would say so.
; ------------------------------------------------------------------
(pub :: lspExtHandles (-> String Bool))

(pub fn (lspExtHandles method) (|| (lspNavHandles method) (|| (lspViewHandles method) (lspFixHandles method))))

(pub :: lspExtDispatch (-> String Int Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspExtDispatch method id params uris texts)
  (if (lspNavHandles method)
    (lspNavDispatch method id params uris texts)
    (if (lspViewHandles method)
      (lspViewDispatch method id params uris texts)
      (lspFixDispatch method id params uris texts)
    )
  )
)

; ==================================================================
; SECTION NAV: references, rename, document highlights, local
; bindings, declarations, call hierarchy
; ==================================================================
; WHAT THIS SECTION KNOWS that the four original questions do not: what
; a NAME REFERS TO. `definition` and `hover` answered from the
; declaration list alone, so a `let` binder, a `fn` parameter, a
; `lambda` parameter and a pattern variable were "nothing here", and
; two functions that each bind an `i` were one name. Everything below
; is a projection of ONE walk over the raw parse tree - expanding
; nothing, MAC-TOOL-3's rule - that records every OCCURRENCE of a name
; together with the KEY of the binding it resolves to, following the
; language's own scoping: the innermost local scope first, then this
; document's top-level declarations, then "not this document's".
;
; A KEY names a binding uniquely within one document:
;
;   @<offset>       a local binder anchored at that byte - a `let`
;                   name, a recovered parameter, a pattern variable
;   ~<node>:<name>  a local binder with NO anchor (see
;                   `lspHeaderParamSpans` for how one arises); it still
;                   resolves references, and is not renamable
;   <name>          a top-level declaration of this document; a `fn`
;                   and its `::` signature share one
;   <data>#<ctor>   a constructor, keyed by the `data` that declares it
;   ?<bare>         a name this document does not declare - imported,
;                   or a builtin
;   !<name>         an effect named by `handle`
;
; Two occurrences are the same name iff their keys are equal, which is
; the whole of what `references`, `documentHighlight`, `prepareRename`
; and `rename` ask.
;
; TWO MORE QUESTIONS ARE PROJECTIONS OF THE SAME WALK, and they sit at
; the end of this section rather than beside `definition` because they
; need what it knows. `textDocument/declaration` answers the `(:: f
; T)` where `definition` answers the `(fn (f x) ...)` - a distinction
; this language HAS and most do not - and asks the walk first, because
; a local is declared by being bound. The three call-hierarchy
; requests intersect this walk's occurrences with the head positions
; `lspChHeads` finds in the bytes: an occurrence that resolved to a
; top-level name AND stands first inside a `(` is a call, which is why
; `(fn (apply k v) (k v))` reports no edge to a top-level `k` and
; `(fn (handoff z) helper)` is not one of `helper`'s callers.
;
; WHAT IT COSTS: one parse, one line index, one walk that is linear in
; the tree. Resolution is a scope STACK - a Vec of (name, key) pairs
; pushed and popped as the walk descends - so a reference costs its
; depth, and the top-level table is a bucket index keyed by
; `fnIdxHash` rather than `lspFindDecl`'s scan, so it costs one bucket
; and not the declaration list. The cross-file half of `references`
; and `rename` parses every OTHER open document once, which is the
; only way to know whether it imports this one; nothing is read from
; disk for a reference search - the store is the workspace.
;
; TYPE POSITIONS ARE READ FROM THE BYTES. A type node carries no span
; (`parseType` builds them spanless), so the `Shape` in `(:: area (->
; Shape Int))`, in a constructor's fields, in a struct field, an alias
; or an impl head is not a place in the tree - and the first version
; of this walk left them out, so `rename` on a `data` rewrote its
; declaration and nothing else and the program stopped checking
; (measured: AX3002 at every signature that named it). The identifiers
; of a declaration's form are read back from the document instead,
; and every one that is not the declaration's own name, a
; constructor, a field name, a type variable or the arrow is a TYPE
; reference - resolved against the TYPE table alone (word 6), because
; types and values are different namespaces and a `fn` spelled like a
; `data` must not be renamed with it.
;
; NOT WALKED, and why: a macro's TEMPLATE, whose identifiers are
; pattern variables and gensym-renamed binders rather than scoped
; code; a `syntax/for` declaration and an `extern` block, for the same
; reason the outline leaves them out (an extern names builtin types
; alone); and the type inside an `alloc` or a `cast` expression, whose
; form the tree does not anchor. A reference to a top-level name from
; inside a macro template is therefore not renamed with the rest - a
; rename of such a name still answers, and the template keeps the old
; spelling, which the expander then reports as an undefined name.
; ------------------------------------------------------------------
; `==` compares Ints, so a Bool is negated by naming it.
(pub :: lspNavNot (-> Bool Bool))

(pub fn (lspNavNot b)
  (if b
    false
    true
  )
)

; The roles an occurrence can play.
(pub :: NAV_READ Int)

(pub fn (NAV_READ) 0)

(pub :: NAV_WRITE Int)

(pub fn (NAV_WRITE) 1)

(pub :: NAV_BINDER Int)

(pub fn (NAV_BINDER) 2)

(pub :: NAV_DECL Int)

(pub fn (NAV_DECL) 3)

(pub :: NAV_DECL_SIG Int)

(pub fn (NAV_DECL_SIG) 4)

; What kind of binder a BINDER occurrence is, which is what hover
; says about it.
(pub :: NAV_B_PARAM Int)

(pub fn (NAV_B_PARAM) 1)

(pub :: NAV_B_LET Int)

(pub fn (NAV_B_LET) 2)

(pub :: NAV_B_LAMBDA Int)

(pub fn (NAV_B_LAMBDA) 3)

(pub :: NAV_B_PATTERN Int)

(pub fn (NAV_B_PATTERN) 4)

; ------------------------------------------------------------------
; An occurrence is a seven-word block:
;
;   word 0  name, as the reference spells it - the BARE name for a
;           qualified `Mod::name`
;   word 1  the identifier's own byte span; 0 for none
;   word 2  role (NAV_READ .. NAV_DECL_SIG)
;   word 3  key (see the section header)
;   word 4  binder kind (NAV_B_*), 0 for anything but a binder
;   word 5  owner - the top-level declaration the occurrence sits in
;   word 6  parameter index, for a `fn` parameter
;
; The walk's context is a seven-word block:
;
;   word 0  the document's text
;   word 1  the occurrence Vec being filled, in source order
;   word 2  the scope stack: (name, key) pairs pushed FLAT, so the
;           innermost binding is the last pair
;   word 3  the top-level table (`lspNavTopBuild`)
;   word 4  0, or a rename collision probe (`lspNavProbe`)
;   word 5  the name of the declaration being walked
;   word 6  the type table (`lspNavTypeBuild`): the names a type
;           position can resolve to
; ------------------------------------------------------------------
(pub :: lspNavOccurrences (-> String (Vec Int) (Vec Int)))

(pub fn (lspNavOccurrences src decls) (lspNavOccurrencesProbe src decls 0))

(pub :: lspNavOccurrencesProbe (-> String (Vec Int) Int (Vec a)))

(pub fn (lspNavOccurrencesProbe src decls probe)
  (let (
    (nv (lspNavContext src decls probe))
    (mut i 0)
  )
    {
      (while (< i (vecLen decls))
        {
          (lspNavWalkDecl nv (vecGet decls i))
          (set i (+ i 1))
        })
      (memGetWord nv 1)
    }
  )
)

(pub :: lspNavContext (-> String (Vec Int) Int Int))

(pub fn (lspNavContext src decls probe)
  (let ((nv (memAlloc 56)))
    {
      (memSetWord nv 0 src)
      (memSetWord nv 1 vecNew)
      (memSetWord nv 2 vecNew)
      (memSetWord nv 3 (lspNavTopBuild decls))
      (memSetWord nv 4 probe)
      (memSetWord nv 5 "")
      (memSetWord nv 6 (lspNavTypeBuild decls))
      nv
    }
  )
)

; ------------------------------------------------------------------
; The local-binding index, for the sections that ask one question of
; the walk: does the name at this byte resolve to a LOCAL? Signature
; help and parameter hints look a call's head up by its bare spelling,
; and a head that is a parameter or a `let` spelled like a declared
; `fn` - `(fn (apply k v) (k v))` beside a top-level `k` - must answer
; nothing, since the call is not to that `fn`. Measured before this
; existed: `(fn (t7 f) (f 1 2))` answered the top-level `f`'s signature
; and labelled its arguments with `f`'s parameters.
;
; Only the declarations whose EXTENT meets [rs, re) are walked - the
; extent being the name's start to the next declaration's, the same
; bound the hint request uses - so a request for the visible window
; pays for the window and not for the file. Answers a bucket table of
; byte offsets: every occurrence in those declarations whose key is
; local, keyed by its start.
; ------------------------------------------------------------------
(pub :: lspNavLocalIndex (-> String (Vec Int) Int Int (Vec Int)))

(pub fn (lspNavLocalIndex src decls rs re)
  (let (
    (nv (lspNavContext src decls 0))
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (if (lspNavDeclMeets decls i (strLen src) rs re)
            (lspNavWalkDecl nv (vecGet decls i))
            0
          )
          (set i (+ i 1))
        })
      (lspNavLocalStarts (memGetWordVec nv 1))
    }
  )
)

; Whether declaration `i`'s extent - its name's start to the next
; spanned declaration's start, or EOF - meets [rs, re). A declaration
; with no span has no extent and is walked regardless, which costs
; nothing: it is an empty form or a marker.
(pub :: lspNavDeclMeets (-> (Vec Int) Int Int Int Int Bool))

(pub fn (lspNavDeclMeets decls i n rs re)
  (let ((d (vecGet decls i)))
    (if (== (nodeSpan d) 0)
      true
      (let (
        (lo (spanStart (nodeSpan d)))
        (mut j (+ i 1))
        (mut hi n)
      )
        {
          (while (if (< j (vecLen decls))
            (== hi n)
            false
          )
            {
              (if (!= (nodeSpan (vecGet decls j)) 0)
                (set hi (spanStart (nodeSpan (vecGet decls j))))
                0
              )
              (set j (+ j 1))
            })
          (&& (< lo re) (> hi rs))
        }
      )
    )
  )
)

; The bucket table: `fnIdxBuckets` slots, each 0 or a Vec of the byte
; offsets that hash there.
(pub :: lspNavLocalStarts (-> (Vec Int) (Vec Int)))

(pub fn (lspNavLocalStarts occs)
  (let (
    (nb (fnIdxBuckets (vecLen occs)))
    (bs vecNew)
    (mut i 0)
  )
    {
      (while (< i nb)
        {
          (vecPush bs 0)
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (vecLen occs))
        (let ((o (vecGet occs i)))
          {
            (if (&& (!= (memGetWord o 1) 0) (lspNavIsLocal (memGetWordStr o 3)))
              (lspNavIntPut bs (spanStart (memGetWord o 1)))
              0
            )
            (set i (+ i 1))
          }
        ))
      bs
    }
  )
)

(pub :: lspNavIntPut (-> (Vec Int) Int Int))

(pub fn (lspNavIntPut bs v)
  (let ((b (% v (vecLen bs))))
    {
      (if (== (vecGet bs b) 0)
        { (vecSet bs b (cast Int vecNew)) 0 }
        0
      )
      (vecPush (vecGetVec bs b) v)
      0
    }
  )
)

(pub :: lspNavLocalIndexHas (-> (Vec Int) Int Bool))

(pub fn (lspNavLocalIndexHas bs off)
  (if (== (vecLen bs) 0)
    false
    (let ((b (% off (vecLen bs))))
      (if (== (vecGet bs b) 0)
        false
        (let (
          (v (vecGetVec bs b))
          (mut i 0)
          (mut found false)
        )
          {
            (while (< i (vecLen v))
              {
                (if (== (vecGet v i) off)
                  {
                    (set found true)
                    0
                  }
                  0
                )
                (set i (+ i 1))
              })
            found
          }
        )
      )
    )
  )
)

(pub :: lspNavEmit (-> Int String Int Int String Int Int Int))

(pub fn (lspNavEmit nv name span role key bkind idx)
  (let ((o (memAlloc 56)))
    {
      (memSetWord o 0 name)
      (memSetWord o 1 span)
      (memSetWord o 2 role)
      (memSetWord o 3 key)
      (memSetWord o 4 bkind)
      (memSetWord o 5 (memGetWordStr nv 5))
      (memSetWord o 6 idx)
      (vecPush (memGetWordVec nv 1) o)
      (lspNavProbeAt nv name key)
      0
    }
  )
)

; ------------------------------------------------------------------
; The top-level table: this document's declared names, each mapped to
; its key, LAST WINS - `lspFindDecl`'s rule, over `lspFindDecl`'s
; kinds plus `type` aliases and the constructors a `data` declares,
; because a constructor is a name that gets written and resolved.
;
; A bucket index rather than a scan: the walk asks this question once
; per reference, and `lspFindDecl` per reference is the declaration
; list squared, which on this repository's own `typecheck.ax` is
; twenty thousand references against two thousand declarations.
; ------------------------------------------------------------------
(pub :: lspNavDeclares (-> Int Bool))

(pub fn (lspNavDeclares tag) (|| (lspWantsSymbol tag) (== tag TAG_D_ALIAS)))

(pub :: lspNavTopBuild (-> (Vec Int) (Vec Int)))

(pub fn (lspNavTopBuild decls)
  (let (
    (nb (fnIdxBuckets (vecLen decls)))
    (bs vecNew)
    (mut i 0)
  )
    {
      (while (< i nb)
        {
          (vecPush bs 0)
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (vecLen decls))
        (let ((d (vecGet decls i)))
          {
            (if (lspNavIsNamedDecl d)
              {
                (lspNavTopPut bs (nodeAName d) (nodeAName d))
                (if (== (nodeTag d) TAG_D_DATA)
                  (lspNavTopPutCtors bs (nodeAName d) (nodeBVec d) 0)
                  0
                )
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      bs
    }
  )
)

; A declaration the outline would list under its own name: one of the
; kinds, with a span, and not a `(syntax/join ...)` marker - a marker
; is a spelling no reference can write.
(pub :: lspNavIsNamedDecl (-> Int Bool))

(pub fn (lspNavIsNamedDecl d) (&& (lspNavDeclares (nodeTag d)) (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0))))

(pub :: lspNavTopPutCtors (-> (Vec Int) String (Vec Int) Int Int))

(pub fn (lspNavTopPutCtors bs dat ctors i)
  (if (>= i (vecLen ctors))
    0
    (let ((c (vecGet ctors i)))
      {
        (if (!= (nodeSpan c) 0)
          (lspNavTopPut bs (nodeAName c) (lspNavCtorKey dat (nodeAName c)))
          0
        )
        (lspNavTopPutCtors bs dat ctors (+ i 1))
      }
    )
  )
)

(pub :: lspNavCtorKey (-> String String String))

(pub fn (lspNavCtorKey dat ctor) (strConcat dat (strConcat "#" ctor)))

; The TYPE table: the `data`, `struct` and `type` names this document
; declares, each keyed by itself - the same key the declaration's own
; occurrence carries, so a type position and the declaration it names
; are one name. Kept apart from the table above because a type
; position must never resolve to a `fn`.
(pub :: lspNavTypeBuild (-> (Vec Int) (Vec Int)))

(pub fn (lspNavTypeBuild decls)
  (let (
    (nb (fnIdxBuckets (vecLen decls)))
    (bs vecNew)
    (mut i 0)
  )
    {
      (while (< i nb)
        {
          (vecPush bs 0)
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (vecLen decls))
        (let ((d (vecGet decls i)))
          {
            (if (&& (lspNavIsTypeTag (nodeTag d)) (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0)))
              (lspNavTopPut bs (nodeAName d) (nodeAName d))
              0
            )
            (set i (+ i 1))
          }
        ))
      bs
    }
  )
)

(pub :: lspNavIsTypeTag (-> Int Bool))

(pub fn (lspNavIsTypeTag tag) (|| (== tag TAG_D_DATA) (|| (== tag TAG_D_STRUCT) (== tag TAG_D_ALIAS))))

; An entry is (name, key); a bucket is a Vec of entries or 0.
(pub :: lspNavTopPut (-> (Vec Int) String String Int))

(pub fn (lspNavTopPut bs name key)
  (let ((b (% (fnIdxHash name) (vecLen bs))))
    (let ((v
      (if (== (vecGet bs b) 0)
        (let ((fresh vecNew))
          {
            (vecSet bs b (cast Int fresh))
            fresh
          }
        )
        (vecGetVec bs b)
      )
    ))
      (let ((at (lspNavTopSlot v name 0)))
        (if (< at 0)
          (let ((e (memAlloc 16)))
            {
              (memSetWord e 0 name)
              (memSetWord e 1 key)
              (vecPush v e)
              0
            }
          )
          {
            (memSetWord (vecGet v at) 1 key)
            0
          }
        )
      )
    )
  )
)

(pub :: lspNavTopSlot (-> (Vec Int) String Int Int))

(pub fn (lspNavTopSlot v name k)
  (if (>= k (vecLen v))
    (- 0 1)
    (if (strEq (memGetWordStr (vecGet v k) 0) name)
      k
      (lspNavTopSlot v name (+ k 1))
    )
  )
)

; The key `name` is declared under, or "" when this document does not
; declare it.
(pub :: lspNavTopGet (-> (Vec Int) String String))

(pub fn (lspNavTopGet bs name)
  (if (== (vecLen bs) 0)
    ""
    (let ((b (% (fnIdxHash name) (vecLen bs))))
      (if (== (vecGet bs b) 0)
        ""
        (let ((v (vecGetVec bs b)))
          (let ((at (lspNavTopSlot v name 0)))
            (if (< at 0)
              ""
              (memGetWordStr (vecGet v at) 1)
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The scope stack.
; ------------------------------------------------------------------
(pub :: lspNavPush (-> Int String String Int))

(pub fn (lspNavPush nv name key)
  (let ((scope (memGetWordVec nv 2)))
    {
      (vecPush scope name)
      (vecPush scope key)
      0
    }
  )
)

(pub :: lspNavPopN (-> Int Int Int))

(pub fn (lspNavPopN nv k)
  (let (
    (scope (memGetWordVec nv 2))
    (mut i 0)
  )
    {
      (while (< i k)
        {
          (vecPop scope)
          (vecPop scope)
          (set i (+ i 1))
        })
      0
    }
  )
)

; The key the innermost binding of `name` carries, or "".
(pub :: lspNavScopeFind (-> (Vec Int) String String))

(pub fn (lspNavScopeFind scope name)
  (let (
    (mut i (- (vecLen scope) 2))
    (mut k "")
  )
    {
      (while (>= i 0)
        (if (strEq (vecGetStr scope i) name)
          {
            (set k (vecGetStr scope (+ i 1)))
            (set i (- 0 2))
          }
          (set i (- i 2))
        ))
      k
    }
  )
)

(pub :: lspNavScopeHasKey (-> (Vec Int) String Bool))

(pub fn (lspNavScopeHasKey scope key)
  (let (
    (mut i (- (vecLen scope) 1))
    (mut found false)
  )
    {
      (while (>= i 1)
        (if (strEq (vecGetStr scope i) key)
          {
            (set found true)
            (set i (- 0 2))
          }
          (set i (- i 2))
        ))
      found
    }
  )
)

; What `name` refers to where the walk currently stands: the innermost
; local, else this document's declaration, else nothing this document
; declares. A qualified `Mod::name` arrives as `Mod$name` and can be
; neither a local nor a declaration here, so it falls through to the
; last case under its bare name - which is also where an unqualified
; reference to the same imported name lands, so the two are the same
; name, as they are to the compiler.
(pub :: lspNavResolve (-> Int String String))

(pub fn (lspNavResolve nv name)
  (let ((k (lspNavScopeFind (memGetWordVec nv 2) name)))
    (if (!= (strLen k) 0)
      k
      (let ((t (lspNavTopGet (memGetWordVec nv 3) name)))
        (if (!= (strLen t) 0)
          t
          (strConcat "?" (bareOf name))
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The rename collision probe.
;
; A rename of a LOCAL is refused when the new spelling would change
; what any name in the binding's scope refers to, and the only place
; that can be decided is inside the walk, where the scope stack is
; live. So `rename` walks a second time with a probe - (new name, the
; key being renamed, hit) - and every emission asks two questions:
;
;   * this occurrence IS the binding being renamed, and the new name
;     is already bound around it - by an enclosing local, or by a
;     top-level declaration the renamed local would then shadow;
;   * this occurrence SPELLS the new name and sits inside the renamed
;     binding's scope, so the rename would capture it.
;
; Either is a hit, and a hit is a null answer. The declaration-level
; half of the same question needs no probe: `lspNavNamed` scans the
; occurrences once.
; ------------------------------------------------------------------
(pub :: lspNavProbe (-> String String Int))

(pub fn (lspNavProbe newName key)
  (let ((p (memAlloc 24)))
    {
      (memSetWord p 0 newName)
      (memSetWord p 1 key)
      (memSetWord p 2 0)
      p
    }
  )
)

(pub :: lspNavProbeAt (-> Int String String Int))

(pub fn (lspNavProbeAt nv name key)
  (let ((p (memGetWord nv 4)))
    (if (== p 0)
      0
      (let (
        (newName (memGetWordStr p 0))
        (k (memGetWordStr p 1))
        (scope (memGetWordVec nv 2))
      )
        (if (strEq key k)
          (if (|| (!= (strLen (lspNavScopeFind scope newName)) 0) (!= (strLen (lspNavTopGet (memGetWordVec nv 3) newName)) 0))
            (memSetWord p 2 1)
            0
          )
          (if (&& (strEq name newName) (lspNavScopeHasKey scope k))
            (memSetWord p 2 1)
            0
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; Binders.
;
; A binder with a span is keyed by it - the byte a name is bound at is
; unique in the document - and emitted as an occurrence, so it can be
; found under a cursor, highlighted and renamed. A binder without one
; is keyed by its node and its name, which is unique too, and is not
; emitted: it resolves the references beneath it, and there is nothing
; for an editor to point at.
; ------------------------------------------------------------------
(pub :: lspNavBinderKey (-> String Int Int String))

(pub fn (lspNavBinderKey name span node)
  (if (!= span 0)
    (strConcat "@" (decStr (spanStart span)))
    (strConcat "~" (strConcat (decStr node) (strConcat ":" name)))
  )
)

(pub :: lspNavEmitBinder (-> Int String Int String Int Int Int))

(pub fn (lspNavEmitBinder nv name span key bkind idx)
  (if (|| (== span 0) (|| (strEq name "_") (match (strFindByte name 36 0) ((None) false) ((Some _) true))))
    0
    (lspNavEmit nv name span NAV_BINDER key bkind idx)
  )
)

; A name the user CANNOT have written is a desugaring's, and it has no
; occurrence: `$` is AX1001 inside an identifier, so a binder holding
; one - `for$v`, `for$i`, `for$n`, `for$lo`, which `parseForExpr`
; binds around a loop with the KEYWORD's span - was never in the
; document. Emitted, it sat on the word `for`: measured before this
; guard, `prepareRename` at the keyword answered the placeholder
; `for$v`, and applying it would have rewritten the keyword's bytes.
; The binder is still PUSHED on the scope stack by its walker, so the
; desugaring's own reads resolve as they did; those reads are dropped
; by `lspNavRef` under the rule below.
;
; The same question for a REFERENCE cannot be asked of the name alone,
; because a user's `Vec::vecLen` reaches here as `Vec$vecLen` too. It
; is asked of the BYTES: a qualified reference the user wrote has its
; last segment in the document at the span `lspNavQualSpan` finds, and
; a reference the parser made up does not - `Vec$vecLen` and `for$v`
; sit on `for`, or on the container expression `(for x XS body)` reads
; its length from. A macro template's free identifier rewritten to
; `Html$hAttr` (MAC-HYG-7) keeps its own span, which spells `hAttr`,
; so it stays.
(pub :: lspNavSpells (-> String Int String Bool))

(pub fn (lspNavSpells src sp name)
  (if (== sp 0)
    true
    (strEq (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))) name)
  )
)

; ------------------------------------------------------------------
; Parameter spans, recovered from the BYTES.
;
; The parser records a `fn`'s parameters and a `lambda`'s as bare
; Strings - `nodeB` of TAG_D_FN, `nodeA` of TAG_E_LAM - with no span,
; because nothing in the compiler ever reports a diagnostic AT a
; parameter name. The document still has them: a `fn` header is
; `(name p1 p2 ...)` and the node's span is the name's token, so the
; parameters are the identifiers between the name and the header's
; `)`; a `lambda`'s span is its keyword, and the parameter list `(p1
; p2)` is the form after it. This reads them, in order, skipping
; whitespace and comments, and stops at the first byte that is neither
; an identifier nor blank.
;
; The count is CHECKED against the tree by every caller: a header the
; scan reads differently from the parser - a `(syntax/join ...)` name,
; a form mid-edit - yields the wrong number of spans, and the
; parameters are then treated as having none rather than being
; anchored at bytes that belong to something else. A parameter with no
; anchor still resolves its references; it is not renamable and not
; highlightable, which is the honest answer to "where is it bound".
; ------------------------------------------------------------------
(pub :: lspHeaderParamSpans (-> String Int (Vec Int)))

(pub fn (lspHeaderParamSpans src from)
  (let (
    (n (strLen src))
    (out vecNew)
    (mut i (lspNavSkipBlank src from n))
    (mut go 1)
  )
    {
      (if (&& (< i n) (== (strByte src i) 40))
        (set i (lspNavSkipBlank src (+ i 1) n))
        0
      )
      (while (== go 1)
        (if (>= i n)
          (set go 0)
          (if (isIdentStart (strByte src i))
            (let ((e (skipIdent src (+ i 1) n)))
              {
                (vecPush out (mkSpan i e))
                (set i (lspNavSkipBlank src e n))
              }
            )
            (set go 0)
          )
        ))
      out
    }
  )
)

; Past whitespace, `;` comments and `#| |#` blocks - the same three
; the lexer skips between tokens, asked of the lexer's own helpers.
(pub :: lspNavSkipBlank (-> String Int Int Int))

(pub fn (lspNavSkipBlank src i n)
  (let (
    (mut k i)
    (mut go 1)
  )
    {
      (while (== go 1)
        (if (>= k n)
          (set go 0)
          (let ((b (strByte src k)))
            (if (lspIsSpace b)
              (set k (+ k 1))
              (if (== b 59)
                (set k (findNewline src k n))
                (if (&& (== b 35) (isBlockOpen src k n))
                  (set k (skipBlockComment src (+ k 2) n))
                  (set go 0)
                )
              )
            )
          )
        ))
      k
    }
  )
)

; The span of the LAST segment of a qualified reference. The parser
; gives `Mod::name` - and `Sys.Platform::sysRead` - the span of its
; first token, which is the module; the name a reader is looking at is
; the segment after the last `::`, and that is what an occurrence
; should cover. Read forward from the first segment through `.` and
; `::` runs; anything else ends the chain, and a chain with no `::`
; keeps the span it was given.
(pub :: lspNavQualSpan (-> String Int Int))

(pub fn (lspNavQualSpan src sp)
  (let (
    (n (strLen src))
    (mut i (spanEnd sp))
    (mut last sp)
    (mut go 1)
  )
    {
      (while (== go 1)
        (if (>= (+ i 2) n)
          (set go 0)
          (if (&& (== (strByte src i) 58) (&& (== (strByte src (+ i 1)) 58) (isIdentStart (strByte src (+ i 2)))))
            (let ((e (skipIdent src (+ i 3) n)))
              {
                (set last (mkSpan (+ i 2) e))
                (set i e)
              }
            )
            (if (&& (== (strByte src i) 46) (isIdentStart (strByte src (+ i 1))))
              (set i (skipIdent src (+ i 2) n))
              (set go 0)
            )
          )
        ))
      last
    }
  )
)

; ------------------------------------------------------------------
; The walk: declarations.
; ------------------------------------------------------------------
(pub :: lspNavWalkDecl (-> Int Int Int))

(pub fn (lspNavWalkDecl nv d)
  (let ((tag (nodeTag d)))
    {
      ; Every top-level tag keeps a String in word 1 - a name, a
      ; module path, a binder - so the owner is readable whatever
      ; the declaration is.
      (memSetWord nv 5 (nodeAName d))
      (if (== tag TAG_D_FN)
        (lspNavWalkFn nv d)
        (if (== tag TAG_D_SIG)
          {
            (lspNavDeclName nv d NAV_DECL_SIG)
            (lspNavTypesSig nv d)
          }
          (if (== tag TAG_D_DATA)
            {
              (lspNavDeclName nv d NAV_DECL)
              (lspNavTypesData nv d)
            }
            (if (== tag TAG_D_STRUCT)
              {
                (lspNavDeclName nv d NAV_DECL)
                (lspNavTypesStruct nv d)
              }
              (if (== tag TAG_D_ALIAS)
                {
                  (lspNavDeclName nv d NAV_DECL)
                  (lspNavTypesAlias nv d)
                }
                (if (== tag TAG_D_MACRO)
                  (lspNavDeclName nv d NAV_DECL)
                  (if (== tag TAG_D_MACROCALL)
                    ; An invocation is a REFERENCE to the macro
                    ; (MAC-TOOL-2), and its arguments are read as
                    ; expressions at top level: `(deriveTag Colour)`
                    ; names the `data` it derives for.
                    {
                      (lspNavRef nv (nodeAName d) (nodeSpan d) NAV_READ)
                      (lspNavWalkVec nv (nodeBVec d))
                    }
                    0
                  )
                )
              )
            )
          )
        )
      )
    }
  )
)

; ------------------------------------------------------------------
; Type positions, from the bytes.
;
; The identifiers of a declaration's form after its name, each one
; asked what the PARSER would have read it as: a constructor (its
; span is the constructor node's), a field name (the next byte is a
; single `:`), a method name (`::`), a type variable (spelled in the
; declaration's own list), the `mut` marker of a struct field, the
; `=` and the `where` the alias and trait forms dispatch on - and
; everything else is a type reference. `->`, `*`, `*mut` and `_`
; are the type grammar's own punctuation and name nothing.
; ------------------------------------------------------------------
; Every identifier in [from, to) as a Vec of spans, stepping over
; strings, char literals and comments with the lexer's own skips -
; `lspFormEnd`'s scanner, collecting instead of counting.
(pub :: lspNavIdents (-> String Int Int (Vec Int)))

(pub fn (lspNavIdents src from to)
  (let (
    (n (strLen src))
    (out vecNew)
    (mut i from)
  )
    {
      (while (< i to)
        (let ((ch (strByte src i)))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (let ((e (skipIdent src (+ i 1) n)))
                {
                  (vecPush out (mkSpan i e))
                  (set i e)
                }
              )
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    (set i (+ i 1))
                  )
                )
              )
            )
          )
        ))
      out
    }
  )
)

; One past the `)` closing the declaration's own form.
(pub :: lspNavDeclEnd (-> String Int Int))

(pub fn (lspNavDeclEnd src d) (lspFormEnd src (lspFormStart src (spanStart (nodeSpan d)))))

(pub :: lspNavSpanText (-> String Int String))

(pub fn (lspNavSpanText src sp) (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))

; Whether the first non-blank byte after `sp` is a single `:` - what
; makes the identifier before it a field name - or (`dbl` 1) a `::`,
; which makes it a trait method's name.
(pub :: lspNavColonAfter (-> String Int Int Bool))

(pub fn (lspNavColonAfter src sp dbl)
  (let (
    (n (strLen src))
    (k (lspNavSkipBlank src (spanEnd sp) (strLen src)))
  )
    (if (>= k n)
      false
      (if (!= (strByte src k) 58)
        false
        (let ((second
          (if (< (+ k 1) n)
            (== (strByte src (+ k 1)) 58)
            false
          )
        ))
          (if (== dbl 1)
            second
            (lspNavNot second)
          )
        )
      )
    )
  )
)

; The type grammar's punctuation: the arrow, the pointer markers and
; the wildcard spell no type.
(pub :: lspNavIsTypeWord (-> String Bool))

(pub fn (lspNavIsTypeWord name)
  (if (== (strLen name) 0)
    false
    (if (|| (== (strByte name 0) 42) (== (strByte name 0) 45))
      false
      (lspNavNot (strEq name "_"))
    )
  )
)

; A type reference, under the type table's key or `?name` for a type
; this document does not declare - `Int`, an imported `data`.
(pub :: lspNavTypeRef (-> Int String Int Int))

(pub fn (lspNavTypeRef nv name sp)
  (if (lspNavIsTypeWord name)
    (let ((t (lspNavTopGet (memGetWordVec nv 6) name)))
      (lspNavEmit
        nv        name        sp        NAV_READ        (if (!= (strLen t) 0)
          t
          (strConcat "?" name)
        )        0        0
      )
    )
    0
  )
)

; Every span from `i` on as a type reference, except the spellings in
; `tvs` (0 for none).
(pub :: lspNavTypeRefs (-> Int (Vec Int) (Vec Int) Int Int))

(pub fn (lspNavTypeRefs nv spans tvs i)
  (if (>= i (vecLen spans))
    0
    (let ((sp (vecGet spans i)))
      (let ((name (lspNavSpanText (memGetWordStr nv 0) sp)))
        {
          (if (lspNavIsTyvar tvs name)
            0
            (lspNavTypeRef nv name sp)
          )
          (lspNavTypeRefs nv spans tvs (+ i 1))
        }
      )
    )
  )
)

(pub :: lspNavIsTyvar (-> (Vec Int) String Bool))

(pub fn (lspNavIsTyvar tvs name)
  (if (== (cast Int tvs) 0)
    false
    (!= (strVecHas tvs name) 0)
  )
)

; `(:: name TYPE)`: everything after the name is the type.
(pub :: lspNavTypesSig (-> Int Int Int))

(pub fn (lspNavTypesSig nv d)
  (if (== (nodeSpan d) 0)
    0
    (let ((src (memGetWordStr nv 0)))
      (lspNavTypeRefs nv (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d)) (cast (Vec Int) 0) 0)
    )
  )
)

; `(data Name (a) (Ctor T...) (Ctor { f : T }))`: the constructors are
; matched to their nodes by span and emitted as declarations in the
; order the source has them - which keeps the occurrence list in
; offset order - a field name is skipped, a type variable is skipped,
; and the rest name types.
(pub :: lspNavTypesData (-> Int Int Int))

(pub fn (lspNavTypesData nv d)
  (if (== (nodeSpan d) 0)
    0
    (let (
      (src (memGetWordStr nv 0))
      (ctors (nodeBVec d))
      (tvs (nodeTyVec d))
      (mut ci 0)
      (mut i 0)
    )
      (let ((spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d))))
        {
          (while (< i (vecLen spans))
            (let ((sp (vecGet spans i)))
              {
                ; A constructor whose span is 0 or already behind
                ; this identifier cannot be matched; step past it.
                (while (if (< ci (vecLen ctors))
                  (if (== (nodeSpan (vecGet ctors ci)) 0)
                    true
                    (< (spanStart (nodeSpan (vecGet ctors ci))) (spanStart sp))
                  )
                  false
                )
                  (set ci (+ ci 1)))
                (if (if (< ci (vecLen ctors))
                  (== (spanStart (nodeSpan (vecGet ctors ci))) (spanStart sp))
                  false
                )
                  (let ((c (vecGet ctors ci)))
                    {
                      (lspNavEmit nv (nodeAName c) (nodeSpan c) NAV_DECL (lspNavCtorKey (nodeAName d) (nodeAName c)) 0 0)
                      (set ci (+ ci 1))
                    }
                  )
                  (if (lspNavColonAfter src sp 0)
                    0
                    (let ((name (lspNavSpanText src sp)))
                      (if (lspNavIsTyvar tvs name)
                        0
                        (lspNavTypeRef nv name sp)
                      )
                    )
                  )
                )
                (set i (+ i 1))
              }
            ))
          0
        }
      )
    )
  )
)

; `(struct Name (f : T) (mut g : U))`: a field name is followed by a
; `:`, and the `mut` marker is the identifier before one - the
; parser's own test (`parseOneField`), made on bytes.
(pub :: lspNavTypesStruct (-> Int Int Int))

(pub fn (lspNavTypesStruct nv d)
  (if (== (nodeSpan d) 0)
    0
    (let (
      (src (memGetWordStr nv 0))
      (mut i 0)
    )
      (let ((spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d))))
        {
          (while (< i (vecLen spans))
            (let ((sp (vecGet spans i)))
              {
                (if (lspNavColonAfter src sp 0)
                  0
                  (if (&& (strEq (lspNavSpanText src sp) "mut") (if (< (+ i 1) (vecLen spans))
                    (lspNavColonAfter src (vecGet spans (+ i 1)) 0)
                    false
                  ))
                    0
                    (lspNavTypeRef nv (lspNavSpanText src sp) sp)
                  )
                )
                (set i (+ i 1))
              }
            ))
          0
        }
      )
    )
  )
)

; `(type Name a = T)`: the identifiers up to and including the `=`
; are the alias's own parameters, which `parseAliasDecl` reads the
; same way; what follows is the type.
(pub :: lspNavTypesAlias (-> Int Int Int))

(pub fn (lspNavTypesAlias nv d)
  (if (== (nodeSpan d) 0)
    0
    (let (
      (src (memGetWordStr nv 0))
      (mut i 0)
      (mut seenEq 0)
    )
      (let ((spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d))))
        {
          (while (< i (vecLen spans))
            (let ((sp (vecGet spans i)))
              {
                (if (== seenEq 1)
                  (lspNavTypeRef nv (lspNavSpanText src sp) sp)
                  (if (strEq (lspNavSpanText src sp) "=")
                    (set seenEq 1)
                    0
                  )
                )
                (set i (+ i 1))
              }
            ))
          0
        }
      )
    )
  )
)

; The declaration's own name, keyed by itself. A `fn` and its `::`
; signature both land here under the same key, which is what makes a
; rename touch both.
(pub :: lspNavDeclName (-> Int Int Int Int))

(pub fn (lspNavDeclName nv d role)
  (if (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0))
    (lspNavEmit nv (nodeAName d) (nodeSpan d) role (nodeAName d) 0 0)
    0
  )
)

; A `fn`: its name, its parameters bound over its body. The parameter
; spans come from the header's bytes and are used only when their
; count agrees with the tree - see `lspHeaderParamSpans`. Each
; parameter is pushed as soon as it is emitted, so a second parameter
; spelling the first is seen by the rename probe as a collision.
(pub :: lspNavWalkFn (-> Int Int Int))

(pub fn (lspNavWalkFn nv d)
  (let (
    (params (nodeBVec d))
    (np (vecLen params))
  )
    (let ((spans
      (if (&& (> np 0) (!= (nodeSpan d) 0))
        (lspHeaderParamSpans (memGetWordStr nv 0) (spanEnd (nodeSpan d)))
        vecNew
      )
    ))
      (let (
        (ok (== (vecLen spans) np))
        (mut i 0)
      )
        {
          (lspNavDeclName nv d NAV_DECL)
          (while (< i np)
            (let (
              (p (vecGetStr params i))
              (sp
                (if ok
                  (vecGet spans i)
                  0
                )
              )
            )
              (let ((key (lspNavBinderKey p sp d)))
                {
                  (lspNavEmitBinder nv p sp key NAV_B_PARAM i)
                  (lspNavPush nv p key)
                  (set i (+ i 1))
                }
              )
            ))
          (lspNavWalk nv (nodeC d))
          (lspNavPopN nv np)
        }
      )
    )
  )
)

; ------------------------------------------------------------------
; The walk: expressions.
;
; Every arm reads exactly the children the API map names for its tag
; and nothing else, and a tag with no arm is a leaf: a literal, a type
; node an `alloc` carries, a shape this walk does not know. A handle
; of 0 is a leaf too.
; ------------------------------------------------------------------
(pub :: lspNavWalk (-> Int Int Int))

(pub fn (lspNavWalk nv e)
  (if (== e 0)
    0
    (let ((tag (nodeTag e)))
      (if (== tag TAG_E_VAR)
        (lspNavRef nv (nodeAName e) (nodeSpan e) NAV_READ)
        (if (== tag TAG_E_APP)
          {
            (lspNavWalk nv (nodeA e))
            (lspNavWalk nv (nodeB e))
          }
          (if (== tag TAG_E_LAM)
            (lspNavWalkLam nv e)
            (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
              (lspNavWalkLet nv e)
              (if (== tag TAG_E_IF)
                {
                  (lspNavWalk nv (nodeA e))
                  (lspNavWalk nv (nodeB e))
                  (lspNavWalk nv (nodeC e))
                }
                (if (== tag TAG_E_BEGIN)
                  (lspNavWalkVec nv (nodeAVec e))
                  (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
                    (if (== tag TAG_E_REGION)
                      ; the name binds no value and nothing can refer
                      ; to it yet (S3's `@r` will): only the body
                      (lspNavWalk nv (nodeB e))
                    {
                      (lspNavWalk nv (nodeA e))
                      (lspNavWalkVec nv (nodeBVec e))
                    }
                    )
                    (if (== tag TAG_E_MATCH)
                      {
                        (lspNavWalk nv (nodeA e))
                        (lspNavWalkArms nv (nodeBVec e) 0)
                      }
                      (if (== tag TAG_E_COND)
                        {
                          (lspNavWalkClauses nv (nodeAVec e) 0)
                          (lspNavWalk nv (nodeB e))
                        }
                        (if (== tag TAG_E_SET)
                          ; The target is a WRITE, resolved as a
                          ; read would be; the value follows it in
                          ; the source and in this list.
                          {
                            (lspNavRef nv (nodeAName e) (nodeSpan e) NAV_WRITE)
                            (lspNavWalk nv (nodeB e))
                          }
                          (if (== tag TAG_E_FIELD)
                            ; A field name is not a variable; the
                            ; base is.
                            (lspNavWalk nv (nodeA e))
                            (if (== tag TAG_E_SETF)
                              {
                                (lspNavWalk nv (nodeA e))
                                (lspNavWalk nv (nodeC e))
                              }
                              (if (== tag TAG_E_STRUCTCON)
                                {
                                  (lspNavRef nv (nodeAName e) (nodeSpan e) NAV_READ)
                                  (lspNavWalkVec nv (nodeBVec e))
                                }
                                (if (== tag TAG_E_ALLOC)
                                  (lspNavWalk nv (nodeB e))
                                  (if (== tag TAG_E_HANDLE)
                                    {
                                      (lspNavWalk nv (nodeA e))
                                      (lspNavWalkEffects nv (nodeBVec e) 0)
                                      (lspNavWalk nv (nodeC e))
                                    }
                                    0
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(pub :: lspNavWalkVec (-> Int (Vec Int) Int))

(pub fn (lspNavWalkVec nv xs)
  (let ((mut i 0))
    {
      (while (< i (vecLen xs))
        {
          (lspNavWalk nv (vecGet xs i))
          (set i (+ i 1))
        })
      0
    }
  )
)

; A reference, under the key it resolves to. `_` is a wildcard and
; never a name.
(pub :: lspNavRef (-> Int String Int Int Int))

(pub fn (lspNavRef nv name span role)
  (if (strEq name "_")
    0
    (if (match (strFindByte name 36 0) ((None) true) ((Some _) false))
      ; The bytes decide here too. `parseForExpr` builds `(< for$i
      ; for$n)` and `(+ for$i 1)` with the KEYWORD's span on `<` and
      ; `+`, so that a type error in a bound reports at the loop;
      ; emitted, those two sat on the word `for` and `documentHighlight`
      ; there answered every `for` in the document (measured: two
      ; loops, two highlights, while `while` answered null).
      (if (lspNavSpells (memGetWordStr nv 0) span name)
        (lspNavEmit nv name span role (lspNavResolve nv name) 0 0)
        0
      )
      ; Qualified, or made up by the parser: the bytes decide, see
      ; `lspNavSpells`.
      (let ((qs (lspNavQualSpan (memGetWordStr nv 0) span)))
        (if (lspNavSpells (memGetWordStr nv 0) qs (bareOf name))
          (lspNavEmit nv (bareOf name) qs role (lspNavResolve nv name) 0 0)
          0
        )
      )
    )
  )
)

; A `let` binder scopes its BODY and not its value - a `let` is not
; recursive - so the value is walked before the name is pushed. The
; occurrence is emitted first because the name precedes the value in
; the source, and the list is kept in source order.
(pub :: lspNavWalkLet (-> Int Int Int))

(pub fn (lspNavWalkLet nv e)
  (let (
    (name (nodeAName e))
    (key (lspNavBinderKey (nodeAName e) (nodeSpan e) e))
  )
    {
      (lspNavEmitBinder nv name (nodeSpan e) key NAV_B_LET 0)
      (lspNavWalk nv (nodeB e))
      (lspNavPush nv name key)
      (lspNavWalk nv (nodeC e))
      (lspNavPopN nv 1)
    }
  )
)

; A `lambda` of several parameters is several nested TAG_E_LAM nodes
; carrying the SAME keyword span (`curryLam`), and the byte scan reads
; the whole `(p1 p2)` list once; the nodes take the spans in order.
; The chain is walked here rather than through `lspNavWalk`, so the
; nested nodes are not each scanned again as if they were lambdas of
; their own. A lambda written INSIDE another has its own keyword and
; its own span, so it is not part of the chain.
(pub :: lspNavWalkLam (-> Int Int Int))

(pub fn (lspNavWalkLam nv e)
  (let (
    (sp (nodeSpan e))
    (total (lspNavLamArity e (nodeSpan e) 0))
  )
    (let ((spans
      (if (&& (> total 0) (!= sp 0))
        (lspHeaderParamSpans (memGetWordStr nv 0) (spanEnd sp))
        vecNew
      )
    ))
      (let (
        (ok (== (vecLen spans) total))
        (mut n e)
        (mut k 0)
      )
        {
          (while (lspNavInChain n sp)
            {
              (if (> (vecLen (nodeAVec n)) 0)
                (let (
                  (p (vecGetStr (nodeAVec n) 0))
                  (psp
                    (if ok
                      (vecGet spans k)
                      0
                    )
                  )
                )
                  (let ((key (lspNavBinderKey p psp n)))
                    {
                      (lspNavEmitBinder nv p psp key NAV_B_LAMBDA k)
                      (lspNavPush nv p key)
                      (set k (+ k 1))
                    }
                  )
                )
                0
              )
              (set n (nodeB n))
            })
          (lspNavWalk nv n)
          (lspNavPopN nv k)
        }
      )
    )
  )
)

(pub :: lspNavInChain (-> Int Int Bool))

(pub fn (lspNavInChain n sp)
  (if (== n 0)
    false
    (&& (== (nodeTag n) TAG_E_LAM) (== (nodeSpan n) sp))
  )
)

(pub :: lspNavLamArity (-> Int Int Int Int))

(pub fn (lspNavLamArity n sp acc)
  (if (lspNavInChain n sp)
    (lspNavLamArity
      (nodeB n)      sp      (if (> (vecLen (nodeAVec n)) 0)
        (+ acc 1)
        acc
      )
    )
    acc
  )
)

; `match` arms: the pattern's binders scope the arm's body. A
; `syntax/for` arm binds its iteration variable - spanless, it is a
; template construct - over its own arms.
(pub :: lspNavWalkArms (-> Int (Vec Int) Int Int))

(pub fn (lspNavWalkArms nv arms i)
  (if (>= i (vecLen arms))
    0
    (let ((arm (vecGet arms i)))
      {
        (if (== (nodeTag arm) TAG_M_ARM)
          (let ((bound (lspNavWalkPat nv (nodeA arm))))
            {
              (lspNavWalk nv (nodeB arm))
              (lspNavPopN nv bound)
            }
          )
          (if (== (nodeTag arm) TAG_M_FOR)
            {
              (lspNavWalk nv (nodeB arm))
              (lspNavPush nv (nodeAName arm) (lspNavBinderKey (nodeAName arm) 0 arm))
              (lspNavWalkArms nv (nodeCVec arm) 0)
              (lspNavPopN nv 1)
            }
            0
          )
        )
        (lspNavWalkArms nv arms (+ i 1))
      }
    )
  )
)

; `cond` clauses are (test, body) pairs in TAG_M_ARM nodes and bind
; nothing.
(pub :: lspNavWalkClauses (-> Int (Vec Int) Int Int))

(pub fn (lspNavWalkClauses nv clauses i)
  (if (>= i (vecLen clauses))
    0
    (let ((c (vecGet clauses i)))
      {
        (lspNavWalk nv (nodeA c))
        (lspNavWalk nv (nodeB c))
        (lspNavWalkClauses nv clauses (+ i 1))
      }
    )
  )
)

; The effects a `handle` names, as references to effects - a namespace
; this document's declarations are not searched for.
(pub :: lspNavWalkEffects (-> Int (Vec Int) Int Int))

(pub fn (lspNavWalkEffects nv effs i)
  (if (>= i (vecLen effs))
    0
    (let ((v (vecGet effs i)))
      {
        (if (&& (== (nodeTag v) TAG_E_VAR) (!= (nodeSpan v) 0))
          (lspNavEmit nv (nodeAName v) (nodeSpan v) NAV_READ (strConcat "!" (nodeAName v)) 0 0)
          0
        )
        (lspNavWalkEffects nv effs (+ i 1))
      }
    )
  )
)

; ------------------------------------------------------------------
; The walk: patterns. Answers how many binders it pushed, which the
; arm pops after its body.
;
; The head of an application spine and a `TAG_P_CON0` /
; `TAG_P_CONNAMED` name are CONSTRUCTOR references, resolved against
; the top-level table alone - a local can never be a constructor.
; Every other variable in pattern position is a binder, except `_`.
; ------------------------------------------------------------------
(pub :: lspNavWalkPat (-> Int Int Int))

(pub fn (lspNavWalkPat nv p)
  (if (== p 0)
    0
    (let ((tag (nodeTag p)))
      (if (== tag TAG_E_VAR)
        (if (|| (strEq (nodeAName p) "_") (== (nodeSpan p) 0))
          0
          (let ((key (lspNavBinderKey (nodeAName p) (nodeSpan p) p)))
            {
              (lspNavEmitBinder nv (nodeAName p) (nodeSpan p) key NAV_B_PATTERN 0)
              (lspNavPush nv (nodeAName p) key)
              1
            }
          )
        )
        (if (== tag TAG_E_APP)
          (lspNavWalkPatSpine nv p)
          (if (== tag TAG_P_CON0)
            {
              (lspNavCtorRef nv (nodeAName p) (nodeSpan p))
              0
            }
            (if (== tag TAG_P_CONNAMED)
              {
                (lspNavCtorRef nv (nodeAName p) (nodeSpan p))
                (lspNavWalkPatVec nv (nodeCVec p) 0)
              }
              0
            )
          )
        )
      )
    )
  )
)

; `(Just x)` is App(Var Just, Var x): the spine's innermost head is the
; constructor and every argument along it is a sub-pattern.
(pub :: lspNavWalkPatSpine (-> Int Int Int))

(pub fn (lspNavWalkPatSpine nv m)
  (if (== (nodeTag m) TAG_E_APP)
    (let ((a (lspNavWalkPatSpine nv (nodeA m))))
      (+ a (lspNavWalkPat nv (nodeB m)))
    )
    (if (== (nodeTag m) TAG_E_VAR)
      {
        (lspNavCtorRef nv (nodeAName m) (nodeSpan m))
        0
      }
      (lspNavWalkPat nv m)
    )
  )
)

(pub :: lspNavWalkPatVec (-> Int (Vec Int) Int Int))

(pub fn (lspNavWalkPatVec nv pats i)
  (if (>= i (vecLen pats))
    0
    (let ((a (lspNavWalkPat nv (vecGet pats i))))
      (+ a (lspNavWalkPatVec nv pats (+ i 1)))
    )
  )
)

(pub :: lspNavCtorRef (-> Int String Int Int))

(pub fn (lspNavCtorRef nv name span)
  (if (|| (== span 0) (strEq name "_"))
    0
    (let ((t (lspNavTopGet (memGetWordVec nv 3) name)))
      (lspNavEmit
        nv        (bareOf name)        span        NAV_READ        (if (!= (strLen t) 0)
          t
          (strConcat "?" (bareOf name))
        )        0        0
      )
    )
  )
)

; ------------------------------------------------------------------
; Reading the occurrence list.
; ------------------------------------------------------------------
; The occurrence under byte `off`, or 0. Spans do not overlap, so the
; first hit is the only one.
(pub :: lspNavAt (-> (Vec Int) Int Int))

(pub fn (lspNavAt occs off)
  (let (
    (n (vecLen occs))
    (mut i 0)
    (mut found 0)
  )
    {
      (while (< i n)
        (let ((o (vecGet occs i)))
          {
            (if (lspSpanHas (memGetWord o 1) off)
              {
                (set found o)
                (set i n)
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

; The BINDER occurrence a local key was made from, or 0.
(pub :: lspNavBinderOf (-> (Vec Int) String Int))

(pub fn (lspNavBinderOf occs key)
  (let (
    (n (vecLen occs))
    (mut i 0)
    (mut found 0)
  )
    {
      (while (< i n)
        (let ((o (vecGet occs i)))
          {
            (if (&& (== (memGetWord o 2) NAV_BINDER) (strEq (memGetWordStr o 3) key))
              {
                (set found o)
                (set i n)
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

(pub :: lspNavIsDeclRole (-> Int Bool))

(pub fn (lspNavIsDeclRole role) (|| (== role NAV_BINDER) (|| (== role NAV_DECL) (== role NAV_DECL_SIG))))

; Every occurrence carrying `key`, in source order; declarations,
; signatures and binders only when `incl` is 1.
(pub :: lspNavSameKey (-> (Vec Int) String Int (Vec Int)))

(pub fn (lspNavSameKey occs key incl)
  (let (
    (n (vecLen occs))
    (out vecNew)
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((o (vecGet occs i)))
          {
            (if (strEq (memGetWordStr o 3) key)
              (if (|| (== incl 1) (lspNavNot (lspNavIsDeclRole (memGetWord o 2))))
                (vecPush out o)
                (cast (Vec Int) 0)
              )
              (cast (Vec Int) 0)
            )
            (set i (+ i 1))
          }
        ))
      out
    }
  )
)

; Whether any occurrence spells `name`.
(pub :: lspNavNamed (-> (Vec Int) String Bool))

(pub fn (lspNavNamed occs name)
  (let (
    (n (vecLen occs))
    (mut i 0)
    (mut found false)
  )
    {
      (while (< i n)
        {
          (if (strEq (memGetWordStr (vecGet occs i) 0) name)
            {
              (set found true)
              (set i n)
            }
            0
          )
          (set i (+ i 1))
        })
      found
    }
  )
)

; The key's first byte says what kind of binding it names.
(pub :: lspNavIsLocal (-> String Bool))

(pub fn (lspNavIsLocal key) (&& (> (strLen key) 0) (|| (== (strByte key 0) 64) (== (strByte key 0) 126))))

(pub :: lspNavIsTop (-> String Bool))

(pub fn (lspNavIsTop key)
  (if (== (strLen key) 0)
    false
    (let ((b (strByte key 0)))
      (if (|| (== b 64) (|| (== b 126) (|| (== b 63) (== b 33))))
        false
        true
      )
    )
  )
)

; The bare name a top-level key is spelled by outside this document:
; a constructor's key carries its `data`, and an importing file writes
; the constructor alone.
(pub :: lspNavBareOfKey (-> String String))

(pub fn (lspNavBareOfKey key)
  (match (strFindByte key 35 0)
    ((None) key)
    ((Some h) (strSlice key (+ h 1) (- (strLen key) (+ h 1))))
  )
)

; Renamable: a local with an anchor, or a name this document declares.
; NOT renamable, and null is the answer: a name declared in another
; module, even an open one - renaming across files this server did not
; open would leave a broken workspace, and a standard-library name
; must never be renamed from a client; a builtin; an effect; a keyword
; or `_`, which are never occurrences; and a parameter whose span
; could not be recovered.
(pub :: lspNavRenamable (-> Int Bool))

(pub fn (lspNavRenamable o)
  (let ((key (memGetWordStr o 3)))
    (|| (lspNavIsTop key) (&& (> (strLen key) 0) (== (strByte key 0) 64)))
  )
)

; LSP DocumentHighlightKind: Read 2, Write 3. A binding site is a write.
(pub :: lspNavHighlightKind (-> Int Int))

(pub fn (lspNavHighlightKind role)
  (if (== role NAV_READ)
    2
    3
  )
)

; `context.includeDeclaration`, defaulting to true when the client
; sent no context at all.
(pub :: lspNavInclDecl (-> Int Int))

(pub fn (lspNavInclDecl params)
  (let ((ctx (jsonGet params "context")))
    (if (== ctx 0)
      1
      (let ((b (jsonGet ctx "includeDeclaration")))
        (if (== b 0)
          1
          (jsonBoolVal b)
        )
      )
    )
  )
)

; A new name the lexer would read as one identifier, and that is not
; a keyword, and not the wildcard.
(pub :: lspNavValidName (-> String Bool))

(pub fn (lspNavValidName s)
  (let (
    (n (strLen s))
    (mut i 1)
    (mut ok
      (if (== n 0)
        false
        (isIdentStart (strByte s 0))
      )
    )
  )
    {
      (while (&& ok (< i n))
        {
          (if (isIdentChar (strByte s i))
            0
            {
              (set ok false)
              0
            }
          )
          (set i (+ i 1))
        })
      (if ok
        (if (|| (strEq s "_") (lspSeenHas lspKeywords s))
          false
          true
        )
        false
      )
    }
  )
)

; The parsed declarations of `src`, or 0 when it does not parse - the
; one answer every request in this section gives null for.
(pub :: lspNavParse (-> String (Vec Int)))

(pub fn (lspNavParse src)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      (cast (Vec Int) 0)
      (memGetWordVec pr 1)
    )
  )
)

; ------------------------------------------------------------------
; JSON shapes.
; ------------------------------------------------------------------
(pub :: lspNavLocations (-> Int String String (Vec Int) (Vec Int) Int))

(pub fn (lspNavLocations out uri src ix sel)
  (let ((mut i 0))
    {
      (while (< i (vecLen sel))
        {
          (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRangeIx src ix (memGetWord (vecGet sel i) 1))))
          (set i (+ i 1))
        })
      0
    }
  )
)

; TextEdits, one per occurrence, in source order - which is offset
; order, and the spans of two occurrences never overlap.
(pub :: lspNavEdits (-> String (Vec Int) (Vec Int) String Int))

(pub fn (lspNavEdits src ix sel newName)
  (let (
    (out jsonArr)
    (mut i 0)
  )
    {
      (while (< i (vecLen sel))
        {
          (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (memGetWord (vecGet sel i) 1))) "newText" (jsonStr newName)))
          (set i (+ i 1))
        })
      out
    }
  )
)

; ------------------------------------------------------------------
; The other open documents.
;
; A document IMPORTS this one when one of its `(import M)` lines
; resolves - by `moduleSrcPath`, the compiler's own search - to this
; document's path. Both paths are made absolute against the working
; directory before they are compared, because `moduleSrcPath` answers
; whatever the entry directory was spelled as, and a `file:` URI is
; always absolute.
;
; Answers a Vec of (store index, parsed declarations) pairs, so a
; caller that goes on to walk the importer does not parse it twice.
; The current document and any document that is empty or does not
; parse are skipped.
; ------------------------------------------------------------------
(pub :: lspNavAbs (-> String String))

;@axiom:effect(io)
(pub fn (lspNavAbs p)
  (if (pathIsAbsolute p)
    p
    (pathJoin (unwrapOr sysGetCwd "") p)
  )
)

(pub :: lspNavImportsPath (-> (Vec Int) Int String String Bool))

;@axiom:effect(io)
(pub fn (lspNavImportsPath decls tcode entryDir target)
  (let (
    (n (vecLen decls))
    (mut i 0)
    (mut found false)
  )
    {
      (while (&& (< i n) (lspNavNot found))
        (let ((d (vecGet decls i)))
          {
            (if (== (nodeTag d) TAG_D_IMPORT)
              (let ((p (moduleSrcPath (nodeAName d) tcode entryDir)))
                (if (&& (> (strLen p) 0) (strEq (lspNavAbs p) target))
                  {
                    (set found true)
                    0
                  }
                  0
                )
              )
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

(pub :: lspNavImporters (-> String (Vec String) (Vec a) (Vec Int)))

;@axiom:effect(io)
(pub fn (lspNavImporters uri uris texts)
  (let (
    (target (lspNavAbs (lspUriToPath uri)))
    (tcode (checkedTargetCode hostTarget))
    (out vecNew)
    (n (vecLen uris))
    (mut i 0)
  )
    {
      (while (< i n)
        (let (
          (ouri (vecGetStr uris i))
          (otext (vecGetStr texts i))
        )
          {
            (if (|| (strEq ouri uri) (== (strLen otext) 0))
              0
              (let ((odecls (lspNavParse otext)))
                (if (== (cast Int odecls) 0)
                  0
                  (if (lspNavImportsPath odecls tcode (pathDir (lspUriToPath ouri)) target)
                    (let ((pair (memAlloc 16)))
                      {
                        (memSetWord pair 0 i)
                        (memSetWord pair 1 odecls)
                        (vecPush out pair)
                        0
                      }
                    )
                    0
                  )
                )
              )
            )
            (set i (+ i 1))
          }
        ))
      out
    }
  )
)

; The occurrences in importer `pair` that spell `bare` and resolve to
; nothing that document declares - a local or a declaration of its
; own would shadow the import, and is a different name.
(pub :: lspNavForeignSel (-> (Vec a) Int String (Vec Int)))

(pub fn (lspNavForeignSel texts pair bare) (lspNavSameKey (lspNavOccurrences (vecGetStr texts (memGetWord pair 0)) (memGetWordVec pair 1)) (strConcat "?" bare) 1))

; The reverse direction: the cursor is on a name this document
; imports. The module that declares it is found the way `definition`
; finds it - preflight, then the resolver, then `lspFindImported` - and
; if THAT file is open in the store, its URI is answered, so its own
; occurrences can be listed. "" when the name is not an import, or
; the declaring file is not open.
(pub :: lspNavHomeUri (-> String String (Vec Int) String (Vec String) String))

;@axiom:effect(io)
(pub fn (lspNavHomeUri path src decls w uris)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      ""
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
      )
        (let ((d (lspFindImported allDecls w (- (vecLen allDecls) 1))))
          (if (== d 0)
            ""
            (let ((u (lspUnitOf units (nodeModule d))))
              (if (< u 0)
                ""
                (let ((huri (lspPathToUri (memGetWordStr (vecGet units u) 0))))
                  (if (< (docFind uris huri) 0)
                    ""
                    huri
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/references`: every occurrence of the name under the
; cursor, as Locations - this document's first, then each importing
; document's, each in offset order. Null when nothing is under the
; cursor, which is what a keyword, a literal and a comment are.
; ------------------------------------------------------------------
(pub :: lspReferences (-> String String Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspReferences src uri params uris texts)
  (let ((decls (lspNavParse src)))
    (if (== (cast Int decls) 0)
      jsonNull
      (let (
        (ix (lspLineIndex src))
        (occs (lspNavOccurrences src decls))
        (incl (lspNavInclDecl params))
      )
        (let ((o (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position")))))
          (if (== o 0)
            jsonNull
            (let (
              (key (memGetWordStr o 3))
              (out jsonArr)
            )
              {
                (lspNavLocations out uri src ix (lspNavSameKey occs key incl))
                (if (lspNavIsTop key)
                  (lspNavForeignLocations out uri (lspNavBareOfKey key) uris texts)
                  (if (== (strByte key 0) 63)
                    (lspNavHomeLocations out (lspUriToPath uri) src decls (memGetWordStr o 0) incl uris texts)
                    0
                  )
                )
                out
              }
            )
          )
        )
      )
    )
  )
)

(pub :: lspNavForeignLocations (-> Int String String (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspNavForeignLocations out uri bare uris texts)
  (let (
    (imps (lspNavImporters uri uris texts))
    (mut i 0)
  )
    {
      (while (< i (vecLen imps))
        (let ((pair (vecGet imps i)))
          (let (
            (otext (vecGetStr texts (memGetWord pair 0)))
            (ouri (vecGetStr uris (memGetWord pair 0)))
          )
            {
              (lspNavLocations out ouri otext (lspLineIndex otext) (lspNavForeignSel texts pair bare))
              (set i (+ i 1))
            }
          )
        ))
      0
    }
  )
)

(pub :: lspNavHomeLocations (-> Int String String (Vec Int) String Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspNavHomeLocations out path src decls bare incl uris texts)
  (let ((huri (lspNavHomeUri path src decls bare uris)))
    (if (== (strLen huri) 0)
      0
      (let ((htext (docText uris texts huri)))
        (let ((hdecls (lspNavParse htext)))
          (if (== (cast Int hdecls) 0)
            0
            (lspNavLocations out huri htext (lspLineIndex htext) (lspNavSameKey (lspNavOccurrences htext hdecls) bare incl))
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/documentHighlight`: the same name in THIS document,
; each occurrence with the kind of use it is.
; ------------------------------------------------------------------
(pub :: lspDocumentHighlight (-> String Int Int))

(pub fn (lspDocumentHighlight src params)
  (let ((decls (lspNavParse src)))
    (if (== (cast Int decls) 0)
      jsonNull
      (let (
        (ix (lspLineIndex src))
        (occs (lspNavOccurrences src decls))
      )
        (let ((o (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position")))))
          (if (== o 0)
            jsonNull
            (let (
              (sel (lspNavSameKey occs (memGetWordStr o 3) 1))
              (out jsonArr)
              (mut i 0)
            )
              {
                (while (< i (vecLen sel))
                  (let ((s (vecGet sel i)))
                    {
                      (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (memGetWord s 1))) "kind" (jsonNum (lspNavHighlightKind (memGetWord s 2)))))
                      (set i (+ i 1))
                    }
                  ))
                out
              }
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/prepareRename`: the range and current spelling of a
; renamable identifier, else null - see `lspNavRenamable` for the
; refusals.
; ------------------------------------------------------------------
(pub :: lspPrepareRename (-> String Int Int))

(pub fn (lspPrepareRename src params)
  (let ((decls (lspNavParse src)))
    (if (== (cast Int decls) 0)
      jsonNull
      (let (
        (ix (lspLineIndex src))
        (occs (lspNavOccurrences src decls))
      )
        (let ((o (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position")))))
          (if (== o 0)
            jsonNull
            (if (lspNavRenamable o)
              (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (memGetWord o 1))) "placeholder" (jsonStr (memGetWordStr o 0)))
              jsonNull
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/rename`: a WorkspaceEdit over every occurrence of the
; name - its declaration, its signature, every binder and reference in
; this document, and for a declared name the references in every open
; document that imports this one, under their own URIs.
;
; REFUSED WITH NULL, beyond what `prepareRename` refuses: a new name
; the lexer would not read as one identifier, a keyword, `_`; the old
; name itself; and a collision - for a local, a name already bound in
; an enclosing or the same scope or a name the renamed binding would
; capture (`lspNavProbe`); for a declaration, a name this document or
; any importing document already spells anywhere, because a rename
; that makes a call resolve somewhere else is a change of meaning
; disguised as a change of spelling.
; ------------------------------------------------------------------
(pub :: lspRename (-> String String Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspRename src uri params uris texts)
  (let ((decls (lspNavParse src)))
    (if (== (cast Int decls) 0)
      jsonNull
      (let (
        (ix (lspLineIndex src))
        (occs (lspNavOccurrences src decls))
        (newName (jsonGetStr params "newName"))
      )
        (let ((o (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position")))))
          (if (|| (== o 0) (|| (lspNavNot (lspNavRenamable o)) (|| (lspNavNot (lspNavValidName newName)) (strEq newName (memGetWordStr o 0)))))
            jsonNull
            (let ((key (memGetWordStr o 3)))
              (if (lspNavIsTop key)
                (lspRenameTop src uri ix occs key newName uris texts)
                (lspRenameLocal src uri ix decls occs key newName)
              )
            )
          )
        )
      )
    )
  )
)

(pub :: lspRenameLocal (-> String String (Vec Int) (Vec Int) (Vec Int) String String Int))

(pub fn (lspRenameLocal src uri ix decls occs key newName)
  (let ((probe (lspNavProbe newName key)))
    {
      (lspNavOccurrencesProbe src decls probe)
      (if (== (memGetWord probe 2) 1)
        jsonNull
        (lspNavWorkspaceEdit (jsonObjPut jsonObj uri (lspNavEdits src ix (lspNavSameKey occs key 1) newName)))
      )
    }
  )
)

(pub :: lspRenameTop (-> String String (Vec Int) (Vec Int) String String (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspRenameTop src uri ix occs key newName uris texts)
  (if (lspNavNamed occs newName)
    jsonNull
    (let (
      (bare (lspNavBareOfKey key))
      (imps (lspNavImporters uri uris texts))
      (changes (jsonObjPut jsonObj uri (lspNavEdits src ix (lspNavSameKey occs key 1) newName)))
      (mut i 0)
      (mut clash false)
    )
      {
        (while (&& (< i (vecLen imps)) (lspNavNot clash))
          (let ((pair (vecGet imps i)))
            (let (
              (otext (vecGetStr texts (memGetWord pair 0)))
              (ouri (vecGetStr uris (memGetWord pair 0)))
              (oocc (lspNavOccurrences (vecGetStr texts (memGetWord pair 0)) (memGetWordVec pair 1)))
            )
              {
                (if (lspNavNamed oocc newName)
                  {
                    (set clash true)
                    0
                  }
                  (let ((sel (lspNavSameKey oocc (strConcat "?" bare) 1)))
                    (if (> (vecLen sel) 0)
                      (jsonObjPut changes ouri (lspNavEdits otext (lspLineIndex otext) sel newName))
                      0
                    )
                  )
                )
                (set i (+ i 1))
              }
            )
          ))
        (if clash
          jsonNull
          (lspNavWorkspaceEdit changes)
        )
      }
    )
  )
)

(pub :: lspNavWorkspaceEdit (-> Int Int))

(pub fn (lspNavWorkspaceEdit changes) (jsonObjPut jsonObj "changes" changes))

; ------------------------------------------------------------------
; The local-binding half of `definition` and `hover`.
;
; Both are asked FIRST by their callers, before the declaration
; lookups, because a local shadows a declaration of the same name -
; the language's rule, and the order `lspNavResolve` follows. Each
; answers 0 when the word under the cursor is not a local, and the
; caller then proceeds exactly as it did before, so every answer that
; is not about a local is unchanged.
; ------------------------------------------------------------------
; The binder's Location for a local reference or binder; null for a
; local whose binder has no anchor - jumping to a declaration of the
; same name would be the wrong of the two answers.
(pub :: lspNavLocalDefinition (-> String String (Vec Int) (Vec Int) Int Int))

(pub fn (lspNavLocalDefinition src uri ix decls off)
  (let ((occs (lspNavOccurrences src decls)))
    (let ((o (lspNavAt occs off)))
      (if (== o 0)
        0
        (let ((key (memGetWordStr o 3)))
          (if (lspNavIsLocal key)
            (let ((b (lspNavBinderOf occs key)))
              (if (== b 0)
                jsonNull
                (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRangeIx src ix (memGetWord b 1)))
              )
            )
            0
          )
        )
      )
    )
  )
)

; A hover for a local: the binding AS WRITTEN, and a line saying what
; kind of binding it is, so a reader knows whether the fence is a
; `let` pair, a parameter, or a pattern.
;
;   let       the binding pair, `(x (+ a 1))` or `(mut i 0)`, cut from
;             the pair's own `(` to its `)` and clamped like every
;             other fence
;   fn param  `x : Int` when the `fn` has a `::` signature with an
;             arrow at that position, else `x`
;   lambda param, pattern variable
;             the name, then the line it is bound on
(pub :: lspNavLocalHover (-> String (Vec Int) (Vec Int) Int Int))

(pub fn (lspNavLocalHover src decls ix wsp)
  (let ((occs (lspNavOccurrences src decls)))
    (let ((o (lspNavAt occs (spanStart wsp))))
      (if (== o 0)
        0
        (let ((key (memGetWordStr o 3)))
          (if (lspNavIsLocal key)
            (let ((b (lspNavBinderOf occs key)))
              (if (== b 0)
                0
                (let (
                  (bkind (memGetWord b 4))
                  (owner (memGetWordStr b 5))
                  (name (memGetWordStr b 0))
                  (at (spanStart (memGetWord b 1)))
                )
                  (let (
                    (code
                      (if (== bkind NAV_B_LET)
                        (lspClampLines (lspFormText src (lspNearestOpen src at)) 40)
                        (if (== bkind NAV_B_PARAM)
                          (lspNavParamCode decls owner name (memGetWord b 6))
                          (strConcat name (strConcat "\n" (lspNavLineText src at)))
                        )
                      )
                    )
                    (prose
                      (if (== bkind NAV_B_LET)
                        "bound by `let` in `"
                        (if (== bkind NAV_B_PARAM)
                          "parameter of `"
                          (if (== bkind NAV_B_LAMBDA)
                            "parameter of a `lambda` in `"
                            "bound by a pattern in `"
                          )
                        )
                      )
                    )
                  )
                    (let ((value (strConcat "```axiom\n" (strConcat code (strConcat "\n```\n\n" (strConcat prose (strConcat owner "`\n")))))))
                      (jsonObjPut (jsonObjPut jsonObj "contents" (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value" (jsonStr value))) "range" (lspRangeIx src ix wsp))
                    )
                  )
                )
              )
            )
            0
          )
        )
      )
    )
  )
)

; `name : T` from the owning function's signature, when it has one and
; the arrow reaches position `k`; the bare name otherwise. The type is
; rendered from the tree rather than sliced, because a signature's
; type nodes carry no spans.
(pub :: lspNavParamCode (-> (Vec Int) String String Int String))

(pub fn (lspNavParamCode decls owner name k)
  (let ((sig (lspFindSig decls owner (- (vecLen decls) 1))))
    (if (== sig 0)
      name
      (let ((t (nthParamTy (nodeTy sig) k 0)))
        (if (== t 0)
          name
          (strConcat name (strConcat " : " (tyRender t)))
        )
      )
    )
  )
)

; The line `off` sits on, without its indentation.
(pub :: lspNavLineText (-> String Int String))

(pub fn (lspNavLineText src off)
  (let (
    (n (strLen src))
    (mut s (lineStartOf src off))
    (e (lineEndFrom src off))
  )
    {
      (while (&& (< s e) (lspIsBlank (strByte src s)))
        (set s (+ s 1)))
      (if (>= s e)
        ""
        (strSlice src s (- e s))
      )
    }
  )
)

; ------------------------------------------------------------------
; `textDocument/declaration`: the SIGNATURE, where the language has
; one to point at.
;
; This is not a synonym for `definition` in Axiom, and that is the
; whole reason it exists. A function is written twice - `(:: f (-> Int
; Int))` declares it and `(fn (f x) ...)` defines it - and the parser
; keeps both, as TAG_D_SIG and TAG_D_FN nodes carrying their own name
; spans. So `definition` lands on the `fn` (`lspFindDecl` skips
; TAG_D_SIG deliberately, and its comment says why) and `declaration`
; lands on the `::` above it. In C that distinction is a header and a
; translation unit; here it is two lines of one file, and no other
; request in this server answers it.
;
; THE LOOKUP ORDER IS `definition`'S, with one step inserted, because
; the order is the language's scoping rule and not a preference:
;
;   1. A LOCAL BINDING - a `let`, a parameter, a pattern variable.
;      A local is declared by being bound, so its declaration IS its
;      definition and this answers exactly what `definition` does.
;   2. THIS DOCUMENT'S `(:: name T)`, last one winning, which is
;      `lspFindSig`'s rule and `lspFindDecl`'s.
;   3. THIS DOCUMENT'S declaration of that name - a `fn` with no
;      signature, a `data`, a `struct`, a macro. None of those is
;      written twice, so the declaration is the definition and this
;      answers what `definition` answers. Step 3 must come before any
;      imported lookup: a module's own declaration shadows an imported
;      one.
;   4. THE IMPORTED MODULES, signature first and declaration second,
;      resolved the way `lspDefinitionImported` resolves them.
;
; WHAT THAT MAKES TRUE, and it is the property the gate checks: this
; request answers null exactly where `definition` answers null, and
; differs from it exactly on the names that carry a `(:: ...)`.
;
; ONE CASE WHERE IT ANSWERS AND `definition` DOES NOT: a signature
; with no `fn` under it - a half-written declaration, or one whose
; body is still to come. There IS a declaration there, so saying where
; it is beats saying nothing.
(pub :: lspDeclaration (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspDeclaration src uri params)
  (let ((decls (lspNavParse src)))
    (if (== (cast Int decls) 0)
      jsonNull
      (let ((ix (lspLineIndex src)))
        (let ((off (lspOffsetOf src ix (jsonGet params "position"))))
          (let ((w (lspWordAt src off)))
            (if (== (strLen w) 0)
              jsonNull
              (let ((loc (lspNavLocalDefinition src uri ix decls off)))
                (if (!= loc 0)
                  loc
                  (let ((s (lspFindSig decls w (- (vecLen decls) 1))))
                    (if (!= s 0)
                      (lspNavLocOf uri src (nodeSpan s))
                      (let ((d (lspFindDecl decls w (- (vecLen decls) 1))))
                        (if (!= d 0)
                          (lspNavLocOf uri src (nodeSpan d))
                          ; Step 3a: a constructor. It is not written
                          ; twice, so there is no `(:: ...)` step 2
                          ; could have preferred and this answers what
                          ; `definition` answers - the rule step 3
                          ; already states for a `data` or a macro.
                          (let ((c (lspCtorDefinition src uri decls w)))
                            (if (!= c 0)
                              c
                              (lspDeclarationImported (lspUriToPath uri) src decls w)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; A Location, from a uri and a span into that uri's own text.
(pub :: lspNavLocOf (-> String String Int Int))

(pub fn (lspNavLocOf uri src span) (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRange src span)))

; Steps 4 and 5, over the merged list `resolveImports` answers: the
; signature the declaring module wrote, else its declaration. The
; comparison is against `bareOf`, because an imported name is mangled
; (`Vec$vecPush`) and `resolveImports` mangles a signature and its
; definition the same way.
(pub :: lspDeclarationImported (-> String String (Vec Int) String Int))

;@axiom:effect(io)
(pub fn (lspDeclarationImported path src decls w)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      jsonNull
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
      )
        (let ((s (lspFindImportedSig allDecls w (- (vecLen allDecls) 1))))
          (if (!= s 0)
            (lspUnitLocation units s)
            (let ((d (lspFindImported allDecls w (- (vecLen allDecls) 1))))
              (if (!= d 0)
                (lspUnitLocation units d)
                (lspCtorDefinitionImported allDecls units w)
              )
            )
          )
        )
      )
    )
  )
)

; The Location of an imported declaration, in the file that declares
; it: the unit table says which file, and the span indexes that file's
; bytes rather than this document's. 0 for "no declaration", and a
; declaration the resolver did not attribute to a unit, which is what
; `lspUnitOf`'s -1 means.
(pub :: lspUnitLocation (-> (Vec Int) Int Int))

;@axiom:effect(io)
(pub fn (lspUnitLocation units d)
  (if (== d 0)
    jsonNull
    (let ((u (lspUnitOf units (nodeModule d))))
      (if (< u 0)
        jsonNull
        (let ((unit (vecGet units u)))
          (lspNavLocOf (lspPathToUri (memGetWordStr unit 0)) (memGetWordStr unit 1) (nodeSpan d))
        )
      )
    )
  )
)

; The last `(:: name T)` the MERGED list carries for `name`, under a
; bare comparison - `lspFindSig` with `lspFindImported`'s two rules.
(pub :: lspFindImportedSig (-> (Vec Int) String Int Int))

(pub fn (lspFindImportedSig decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_SIG) (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        d
        (lspFindImportedSig decls name (- i 1))
      )
    )
  )
)

; The last top-level `fn` this list declares under `name`. Call
; hierarchy asks about functions and nothing else - a `data`, a
; `struct` and a macro have no body to call out of - so this is
; `lspFindDecl` narrowed to TAG_D_FN.
(pub :: lspFindFn (-> (Vec Int) String Int Int))

(pub fn (lspFindFn decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_FN) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        d
        (lspFindFn decls name (- i 1))
      )
    )
  )
)

(pub :: lspFindImportedFn (-> (Vec Int) String Int Int))

(pub fn (lspFindImportedFn decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_FN) (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        d
        (lspFindImportedFn decls name (- i 1))
      )
    )
  )
)

; ------------------------------------------------------------------
; CALL HIERARCHY: `textDocument/prepareCallHierarchy`,
; `callHierarchy/incomingCalls` and `callHierarchy/outgoingCalls`.
;
; WHAT A CALL SITE IS HERE, and it is the whole of the design: an
; occurrence that this section's walk already resolved to a top-level
; name, standing in the HEAD position of a form. Two questions, two
; existing answers, intersected by byte offset:
;
;   * WHAT DOES THIS NAME MEAN - `lspNavOccurrences`, the walk
;     `references` and `rename` are projections of. It follows the
;     language's scoping, so `(fn (apply k v) (k v))` does not report
;     a call to a top-level `k`: the head's key is `@<offset>`, a
;     local binder, and locals are dropped. It also gives the OWNER of
;     every occurrence - the top-level declaration it sits in - which
;     is the caller side of every edge below, for free.
;   * IS IT A HEAD - `lspChHeads`, one linear scan of the bytes
;     recording the first identifier after each `(`, with the scanner
;     `lspFormEnd` uses so that a `(` inside a string, a char literal
;     or a comment opens nothing. `(cons f g)` therefore names `f` and
;     `g` and calls neither, which is what `#effects=` on a naming
;     function had to learn separately (`effIsPossible`).
;
; WHY NOT `symbols --calls`. That key exists and this does not use it.
; It is the CHECKER's edge set, harvested from the effect walk's
; `FnEnt` word 7, so it costs a full typecheck and - the part that
; settles it - it is a set of NAMES with no positions in it at all.
; `CallHierarchyIncomingCall.fromRanges` is required by the protocol
; and is a list of ranges, so the tree would have had to be walked for
; them anyway; and a request an editor makes while someone reads code
; should not run the checker (MAC-TOOL-3). The two answers agree on
; what an edge is where they overlap, and this one is a strict subset:
; naming a function without applying it is an edge to the effect walk
; and is not a call here.
;
; WHAT IS DELIBERATELY NOT ANSWERED, because answering it would mean
; guessing:
;
;   * PREPARE OVER AN IMPORTED NAME is null. The two requests that
;     follow carry the ITEM and nothing else, so the server must be
;     able to reach the item's document from the item's uri alone -
;     true for a document the editor has open, and not true for a
;     module it resolved once from a document it is no longer told
;     about. Go to the definition first and ask there.
;   * AN ITEM WHOSE DOCUMENT IS NOT OPEN is null, and null rather
;     than `[]`: `[]` says "this function has no callers", which is a
;     claim, and a server that cannot read the file has not earned it.
;   * A CALLEE THAT IS NOT A `fn` this server can point at - a
;     builtin, an operator, a constructor - is left out of the
;     outgoing list rather than given an item with nowhere to jump.
;
; INCOMING CALLS READ THE OPEN DOCUMENTS AND NOTHING ELSE, which is
; `references`'s rule and for its reason: the store is the workspace.
; `lspNavImporters` says which of them import the item's file, and a
; document that declares the name itself shadows the import, so its
; sites are not the item's - the key is `?name` in an importer and
; `name` in the item's own document, and that difference is the test.
; ------------------------------------------------------------------
; Every offset at which an identifier stands FIRST inside a `(`, as
; the bucket table `lspNavLocalIndexHas` reads.
;
; One pass, the scanner `lspFormEnd` uses. `pending` survives a
; comment, because `(  ; why\n  f x)` still has `f` as its head, and
; survives blank space for the same reason; every other byte clears
; it, so the `1` of `(1 2)` and the `(` of `((g 1) 2)` are not heads.
(pub :: lspChHeads (-> String (Vec Int)))

(pub fn (lspChHeads src)
  (let ((offs (lspChHeadOffsets src)))
    (let (
      (nb (fnIdxBuckets (vecLen offs)))
      (bs vecNew)
      (mut i 0)
    )
      {
        (while (< i nb)
          {
            (vecPush bs 0)
            (set i (+ i 1))
          })
        (set i 0)
        (while (< i (vecLen offs))
          {
            (lspNavIntPut bs (vecGet offs i))
            (set i (+ i 1))
          })
        bs
      }
    )
  )
)

(pub :: lspChHeadOffsets (-> String (Vec Int)))

(pub fn (lspChHeadOffsets src)
  (let (
    (n (strLen src))
    (out vecNew)
    (mut i 0)
    (mut pending 0)
  )
    {
      (while (< i n)
        (let ((ch (strByte src i)))
          (if (== ch 34)
            {
              (set pending 0)
              (set i (skipStringBody src (+ i 1) n))
            }
            (if (isIdentStart ch)
              {
                (if (== pending 1)
                  (vecPush out i)
                  (cast (Vec Int) 0)
                )
                (set pending 0)
                (set i (skipIdent src (+ i 1) n))
              }
              (if (== ch 39)
                {
                  (set pending 0)
                  (set i (skipCharBody src (+ i 1) n))
                }
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    {
                      (if (== ch 40)
                        (set pending 1)
                        (if (lspIsSpace ch)
                          0
                          (set pending 0)
                        )
                      )
                      (set i (+ i 1))
                    }
                  )
                )
              )
            )
          )
        ))
      out
    }
  )
)

; Whether a key names something a call can reach: a top-level
; declaration of this document, or a name this document does not
; declare (imported, or a builtin). A constructor key carries `#` and
; is not one - `(Just x)` in a pattern is a head and destructures
; rather than calls - and a local key is not one either.
(pub :: lspChCallable (-> String Bool))

(pub fn (lspChCallable key)
  (if (== (strLen key) 0)
    false
    (if (== (strByte key 0) 63)
      true
      (if (lspNavIsTop key)
        (match (strFindByte key 35 0) ((None) true) ((Some _) false))
        false
      )
    )
  )
)

; Every call site in one document, as the occurrence records
; themselves - word 0 the callee's bare name, word 1 its span, word 5
; the caller.
(pub :: lspChSites (-> String (Vec Int) (Vec Int)))

(pub fn (lspChSites src decls)
  (let (
    (occs (lspNavOccurrences src decls))
    (heads (lspChHeads src))
    (out vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen occs))
        (let ((o (vecGet occs i)))
          {
            (if (&& (== (memGetWord o 2) NAV_READ) (&& (!= (memGetWord o 1) 0) (&& (lspNavLocalIndexHas heads (spanStart (memGetWord o 1))) (lspChCallable (memGetWordStr o 3)))))
              (vecPush out o)
              (cast (Vec Int) 0)
            )
            (set i (+ i 1))
          }
        ))
      out
    }
  )
)

; A CallHierarchyItem for declaration `d` of `src`, at `uri`.
;
; `selectionRange` is the name, exactly as the outline publishes it,
; and `range` is the whole form - from the `(` that opens it to its
; matching `)`, both found by the scanner every other bracket question
; here uses. The protocol requires the second to contain the first,
; and a form contains its own name.
(pub :: lspChItem (-> String (Vec Int) String Int Int))

(pub fn (lspChItem src ix uri d)
  (let ((fs (lspFormStart src (spanStart (nodeSpan d)))))
    (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (bareOf (nodeAName d)))) "kind" (jsonNum 12)) "uri" (jsonStr uri)) "range" (lspRangeIx src ix (mkSpan fs (lspFormEnd src fs)))) "selectionRange" (lspRangeIx src ix (nodeSpan d)))
  )
)

; `textDocument/prepareCallHierarchy`: the one item a hierarchy can be
; rooted at here - the top-level `fn` the cursor names, in THIS
; document. A local, a `data`, a `struct`, a macro, an imported name
; and a document that does not parse are all null, which is the
; protocol's "nothing here".
(pub :: lspPrepareCallHierarchy (-> String String Int Int))

(pub fn (lspPrepareCallHierarchy src uri params)
  (let ((decls (lspNavParse src)))
    (if (== (cast Int decls) 0)
      jsonNull
      (let ((ix (lspLineIndex src)))
        (let ((off (lspOffsetOf src ix (jsonGet params "position"))))
          (let ((w (lspWordAt src off)))
            (if (== (strLen w) 0)
              jsonNull
              (if (!= (lspNavLocalDefinition src uri ix decls off) 0)
                jsonNull
                (let ((d (lspFindFn decls w (- (vecLen decls) 1))))
                  (if (== d 0)
                    jsonNull
                    (jsonArrPush jsonArr (lspChItem src ix uri d))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The item a hierarchy request carries, as (uri, name), and the checks
; both requests share: the document must be open, must parse, and must
; declare `name` as a `fn`. Answers 0 when any of those fails, and
; every caller turns that into null.
(pub :: lspChSubject (-> Int (Vec String) (Vec a) Int))

(pub fn (lspChSubject params uris texts)
  (let ((item (jsonGet params "item")))
    (let (
      (uri (jsonGetStr item "uri"))
      (name (jsonGetStr item "name"))
    )
      (let ((src (docText uris texts uri)))
        (if (|| (== (strLen src) 0) (== (strLen name) 0))
          0
          (let ((decls (lspNavParse src)))
            (if (== (cast Int decls) 0)
              0
              (let ((d (lspFindFn decls name (- (vecLen decls) 1))))
                (if (== d 0)
                  0
                  (let ((r (memAlloc 40)))
                    {
                      (memSetWord r 0 uri)
                      (memSetWord r 1 name)
                      (memSetWord r 2 src)
                      (memSetWord r 3 decls)
                      (memSetWord r 4 d)
                      r
                    }
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; `callHierarchy/incomingCalls`: who calls this function.
(pub :: lspIncomingCalls (-> Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspIncomingCalls params uris texts)
  (let ((s (lspChSubject params uris texts)))
    (if (== s 0)
      jsonNull
      (let (
        (uri (memGetWordStr s 0))
        (name (memGetWordStr s 1))
        (out jsonArr)
      )
        {
          (lspChIncomingIn out uri (memGetWordStr s 2) (memGetWordVec s 3) name 0)
          (lspChIncomingImporters out uri name uris texts)
          out
        }
      )
    )
  )
)

; The callers inside ONE document. `foreign` is 0 for the item's own
; document, where a call to it resolves to the key `name`, and 1 for a
; document that imports it, where it resolves to `?name` - a document
; that declares its own `name` shadows the import and its sites belong
; to that declaration instead, which is exactly what the key says.
(pub :: lspChIncomingIn (-> Int String String (Vec Int) String Int Int))

(pub fn (lspChIncomingIn out ouri osrc odecls name foreign)
  (let (
    (want
      (if (== foreign 1)
        (strConcat "?" name)
        name
      )
    )
    (oix (lspLineIndex osrc))
    (sites (lspChSites osrc odecls))
    (owners vecNew)
    (mut i 0)
  )
    {
      (while (< i (vecLen sites))
        (let ((o (vecGet sites i)))
          {
            (if (&& (strEq (memGetWordStr o 0) name) (strEq (memGetWordStr o 3) want))
              (lspChGroupPush owners (memGetWordStr o 5) (memGetWord o 1))
              0
            )
            (set i (+ i 1))
          }
        ))
      (set i 0)
      (while (< i (vecLen owners))
        (let ((g (vecGet owners i)))
          {
            (let ((d (lspFindFn odecls (memGetWordStr g 0) (- (vecLen odecls) 1))))
              (if (== d 0)
                0
                (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "from" (lspChItem osrc oix ouri d)) "fromRanges" (lspChRanges osrc oix (memGetWordVec g 1))))
              )
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; The same, over every OPEN document that imports the item's file.
(pub :: lspChIncomingImporters (-> Int String String (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspChIncomingImporters out uri name uris texts)
  (let (
    (imps (lspNavImporters uri uris texts))
    (mut i 0)
  )
    {
      (while (< i (vecLen imps))
        (let ((pair (vecGet imps i)))
          {
            (lspChIncomingIn out (vecGetStr uris (memGetWord pair 0)) (vecGetStr texts (memGetWord pair 0)) (memGetWordVec pair 1) name 1)
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; A grouping table: a Vec of (key, Vec of spans) pairs, in first-seen
; order. The protocol's shape is one entry per caller (or callee) with
; every range under it, and a client that received the same function
; twice would draw it twice.
(pub :: lspChGroupPush (-> (Vec Int) String Int Int))

(pub fn (lspChGroupPush groups key span)
  (let (
    (n (vecLen groups))
    (mut i 0)
    (mut at (- 0 1))
  )
    {
      (while (< i n)
        {
          (if (strEq (memGetWordStr (vecGet groups i) 0) key)
            {
              (set at i)
              (set i n)
            }
            (set i (+ i 1))
          )
        })
      (if (>= at 0)
        { (vecPush (memGetWordVec (vecGet groups at) 1) span) 0 }
        (let ((g (memAlloc 16)))
          {
            (memSetWord g 0 key)
            (memSetWord g 1 vecNew)
            (vecPush (memGetWordVec g 1) span)
            (vecPush groups g)
            0
          }
        )
      )
      0
    }
  )
)

; A Vec of spans as a JSON array of Ranges into `src`.
(pub :: lspChRanges (-> String (Vec Int) (Vec Int) Int))

(pub fn (lspChRanges src ix spans)
  (let (
    (out jsonArr)
    (mut i 0)
  )
    {
      (while (< i (vecLen spans))
        {
          (jsonArrPush out (lspRangeIx src ix (vecGet spans i)))
          (set i (+ i 1))
        })
      out
    }
  )
)

; `callHierarchy/outgoingCalls`: what this function calls.
;
; A callee this document declares is answered from this document; one
; it imports is answered from the module that declares it, resolved
; the way `lspDefinitionImported` resolves it - and paid for ONCE, on
; the first callee that needs it, rather than per callee.
(pub :: lspOutgoingCalls (-> Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspOutgoingCalls params uris texts)
  (let ((s (lspChSubject params uris texts)))
    (if (== s 0)
      jsonNull
      (let (
        (uri (memGetWordStr s 0))
        (name (memGetWordStr s 1))
        (src (memGetWordStr s 2))
        (decls (memGetWordVec s 3))
      )
        (let (
          (ix (lspLineIndex src))
          (sites (lspChSites src decls))
          (groups vecNew)
          (out jsonArr)
          (mut i 0)
          (mut r (- 0 1))
        )
          {
            (while (< i (vecLen sites))
              (let ((o (vecGet sites i)))
                {
                  (if (strEq (memGetWordStr o 5) name)
                    (lspChGroupPush groups (memGetWordStr o 0) (memGetWord o 1))
                    0
                  )
                  (set i (+ i 1))
                }
              ))
            (set i 0)
            (while (< i (vecLen groups))
              (let ((g (vecGet groups i)))
                {
                  (let ((d (lspFindFn decls (memGetWordStr g 0) (- (vecLen decls) 1))))
                    (if (!= d 0)
                      (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "to" (lspChItem src ix uri d)) "fromRanges" (lspChRanges src ix (memGetWordVec g 1))))
                      {
                        (if (< r 0)
                          (set r (lspResolveFor (lspUriToPath uri) src decls))
                          0
                        )
                        (if (<= r 0)
                          0
                          (let ((item (lspChImportedItem r (memGetWordStr g 0))))
                            (if (== item 0)
                              0
                              (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "to" item) "fromRanges" (lspChRanges src ix (memGetWordVec g 1))))
                            )
                          )
                        )
                      }
                    )
                  )
                  (set i (+ i 1))
                }
              ))
            out
          }
        )
      )
    )
  )
)

; The item for a callee an imported module declares, out of a resolved
; `lspResolveFor` result: 0 when no module declares it as a `fn`, or
; when the resolver did not attribute the declaration to a unit.
(pub :: lspChImportedItem (-> Int String Int))

;@axiom:effect(io)
(pub fn (lspChImportedItem r name)
  (let (
    (allDecls (memGetWordVec r 0))
    (units (memGetWordVec r 1))
  )
    (let ((d (lspFindImportedFn allDecls name (- (vecLen allDecls) 1))))
      (if (== d 0)
        0
        (let ((u (lspUnitOf units (nodeModule d))))
          (if (< u 0)
            0
            (let ((unit (vecGet units u)))
              (lspChItem (memGetWordStr unit 1) (lspLineIndex (memGetWordStr unit 1)) (lspPathToUri (memGetWordStr unit 0)) d)
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The section's three answers to the extension door.
; ------------------------------------------------------------------
(pub :: lspNavHandles (-> String Bool))

(pub fn (lspNavHandles method) (|| (strEq method "textDocument/references") (|| (strEq method "textDocument/documentHighlight") (|| (strEq method "textDocument/prepareRename") (|| (strEq method "textDocument/rename") (|| (strEq method "textDocument/declaration") (|| (strEq method "textDocument/prepareCallHierarchy") (|| (strEq method "callHierarchy/incomingCalls") (strEq method "callHierarchy/outgoingCalls")))))))))

(pub :: lspNavDispatch (-> String Int Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspNavDispatch method id params uris texts)
  (let (
    (uri (lspParamsUri params))
    (src (docText uris texts (lspParamsUri params)))
  )
    (if (strEq method "textDocument/references")
      (lspReply id (lspReferences src uri params uris texts))
      (if (strEq method "textDocument/documentHighlight")
        (lspReply id (lspDocumentHighlight src params))
        (if (strEq method "textDocument/prepareRename")
          (lspReply id (lspPrepareRename src params))
          (if (strEq method "textDocument/rename")
            (lspReply id (lspRename src uri params uris texts))
            (if (strEq method "textDocument/declaration")
              (lspReply id (lspDeclaration src uri params))
              (if (strEq method "textDocument/prepareCallHierarchy")
                (lspReply id (lspPrepareCallHierarchy src uri params))
                ; The two hierarchy requests carry an ITEM and no
                ; `textDocument`, so `uri` and `src` above are empty
                ; for them and neither is read: the document is the
                ; one the item names.
                (if (strEq method "callHierarchy/incomingCalls")
                  (lspReply id (lspIncomingCalls params uris texts))
                  (if (strEq method "callHierarchy/outgoingCalls")
                    (lspReply id (lspOutgoingCalls params uris texts))
                    (lspError id (- 0 32601) (strConcat "method not found: " method))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; `renameProvider` is an OBJECT: `prepareProvider: true` tells the
; client to ask `prepareRename` first, so an editor never opens a
; rename box on a name this server will refuse to rename.
(pub :: lspNavCaps (-> Int Int))

(pub fn (lspNavCaps caps) (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut caps "referencesProvider" (jsonBool 1)) "documentHighlightProvider" (jsonBool 1)) "renameProvider" (jsonObjPut jsonObj "prepareProvider" (jsonBool 1))) "declarationProvider" (jsonBool 1)) "callHierarchyProvider" (jsonBool 1)))

; ==================================================================
; END SECTION NAV
; ==================================================================

; ==================================================================
; SECTION VIEW: signature help, inlay hints, folding, selection
; ranges, document links, workspace symbols
; ==================================================================
; Six requests that show a reader MORE about the code without changing
; it, in the shape rust-analyzer gives them: signature help, inlay
; hints, folding ranges, selection ranges, document links and the
; workspace symbol list. All six read the raw parse tree and the
; document's bytes and expand nothing (MAC-TOOL-3); each parses once
; and builds one line index; the three that reach into imported
; modules - signature help on an imported name, the parameter names
; of an imported call, the workspace list - resolve the imports
; exactly as `lspDefinitionImported` does, preflight first, so a
; half-typed import degrades to "this document alone" and never to a
; dead server.
;
; WHAT THE BYTES ANSWER THAT THE TREE CANNOT. The parser records a
; span for a declaration's NAME and for every atom, and none for a
; parameter name in a `fn` header (`parseIdentList` keeps the lexeme
; alone), for the `(` of a form, or for the `)` that closes it. So a
; parameter's type hint sits at a position recovered by scanning the
; header's identifiers after the name's span; an argument's hint at
; the start of the i-th item after the call's head, found by the same
; item scanner signature help counts arguments with; and every fold
; and selection range at a bracket the scanner found. The scanner is
; `lspFormEnd`'s - strings, char literals, `;` and `#| |#` comments
; are stepped over by the lexer's own functions - so no two of these
; requests can disagree about where a form ends.
(pub :: lspViewHandles (-> String Bool))

(pub fn (lspViewHandles method) (|| (strEq method "textDocument/signatureHelp") (|| (strEq method "textDocument/inlayHint") (|| (strEq method "textDocument/foldingRange") (|| (strEq method "textDocument/selectionRange") (|| (strEq method "textDocument/documentLink") (strEq method "workspace/symbol")))))))

(pub :: lspViewDispatch (-> String Int Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspViewDispatch method id params uris texts)
  (if (strEq method "workspace/symbol")
    (lspReply id (lspWorkspaceSymbols uris texts params))
    (let ((uri (lspParamsUri params)))
      (let ((src (docText uris texts uri)))
        (if (strEq method "textDocument/signatureHelp")
          (lspReply id (lspSignatureHelp src uri params))
          (if (strEq method "textDocument/inlayHint")
            (lspReply id (lspInlayHints src uri params))
            (if (strEq method "textDocument/foldingRange")
              (lspReply id (lspFoldingRanges src))
              (if (strEq method "textDocument/selectionRange")
                (lspReply id (lspSelectionRanges src params))
                (if (strEq method "textDocument/documentLink")
                  (lspReply id (lspDocumentLinks src uri))
                  (lspError id (- 0 32601) (strConcat "method not found: " method))
                )
              )
            )
          )
        )
      )
    )
  )
)

; `signatureHelpProvider` and `documentLinkProvider` are objects, the
; other four booleans. `(` and a space are where a call's argument
; changes hands in this language, so both trigger and a space
; retriggers; `resolveProvider: false` says every link is complete
; as sent, since there is no `documentLink/resolve` here.
(pub :: lspViewCaps (-> Int Int))

(pub fn (lspViewCaps caps) (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut caps "signatureHelpProvider" lspSignatureHelpOptions) "inlayHintProvider" (jsonBool 1)) "foldingRangeProvider" (jsonBool 1)) "selectionRangeProvider" (jsonBool 1)) "documentLinkProvider" (jsonObjPut jsonObj "resolveProvider" (jsonBool 0))) "workspaceSymbolProvider" (jsonBool 1)))

(pub :: lspSignatureHelpOptions Int)

(pub fn (lspSignatureHelpOptions) (jsonObjPut (jsonObjPut jsonObj "triggerCharacters" (jsonArrPush (jsonArrPush jsonArr (jsonStr "(")) (jsonStr " "))) "retriggerCharacters" (jsonArrPush jsonArr (jsonStr " "))))

; ------------------------------------------------------------------
; Items: the byte-level view of a form's arguments.
;
; Signature help asks "which argument is the cursor on" and parameter
; hints ask "where does the i-th argument begin", and both are
; questions about the ITEMS after a form's head: nested forms, brace
; blocks, string and char literals, identifiers, numbers. One scanner
; answers both, so what one request calls the second argument the
; other cannot label first.
; ------------------------------------------------------------------
; One past the identifier starting at `i`, absorbing a `::name`
; qualifier: `Vec::vecPush` is ONE var to the parser - named
; `Vec$vecPush`, spanning its first segment - and must be one item
; here, or every argument after a qualified head is counted one early.
(pub :: lspViewIdentEnd (-> String Int Int Int))

(pub fn (lspViewIdentEnd src i n)
  (let ((mut e (skipIdent src i n)))
    {
      (while (if (< (+ e 2) n)
        (if (== (strByte src e) 58)
          (if (== (strByte src (+ e 1)) 58)
            (isIdentStart (strByte src (+ e 2)))
            false
          )
          false
        )
        false
      )
        (set e (skipIdent src (+ e 2) n)))
      e
    }
  )
)

; One past the item starting at `i`: a form to its closer, a brace
; block to its `}`, a string or char literal to its quote, an
; identifier through `lspViewIdentEnd`, and any other atom - a
; number, mostly - to the next delimiter. Always past `i`, so a scan
; that steps by it terminates.
(pub :: lspViewItemEnd (-> String Int Int Int))

(pub fn (lspViewItemEnd src i n)
  (let ((ch (strByte src i)))
    (if (== ch 40)
      (lspFormEnd src i)
      (if (== ch 123)
        (lspViewBraceEnd src i)
        (if (== ch 34)
          (skipStringBody src (+ i 1) n)
          (if (isIdentStart ch)
            (lspViewIdentEnd src i n)
            (if (== ch 39)
              (skipCharBody src (+ i 1) n)
              (let ((mut j (+ i 1)))
                {
                  (while (if (< j n)
                    (lspViewIsAtomByte (strByte src j))
                    false
                  )
                    (set j (+ j 1)))
                  j
                }
              )
            )
          )
        )
      )
    )
  )
)

; A byte that continues an atom: anything but whitespace, a bracket,
; a quote or a comment start.
(pub :: lspViewIsAtomByte (-> Int Bool))

(pub fn (lspViewIsAtomByte b)
  (if (lspIsSpace b)
    false
    (if (|| (== b 40) (|| (== b 41) (|| (== b 123) (|| (== b 125) (|| (== b 34) (== b 59))))))
      false
      true
    )
  )
)

; One past the `}` closing the brace block at `o`, or the document
; length. A brace block is a sequence, not a form, and `lspFormEnd`
; counts parens alone; an argument written `{ ... }` is met wherever
; a body sequences its steps. The four skips are `lspFormEnd`'s, in
; its order, for the reason it gives.
(pub :: lspViewBraceEnd (-> String Int Int))

(pub fn (lspViewBraceEnd src o)
  (let (
    (n (strLen src))
    (mut i (+ o 1))
    (mut depth 1)
    (mut stop (- 0 1))
  )
    {
      (while (if (< i n)
        (< stop 0)
        false
      )
        (let ((ch (strByte src i)))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (set i (skipIdent src (+ i 1) n))
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    {
                      (if (== ch 123)
                        (set depth (+ depth 1))
                        0
                      )
                      (if (== ch 125)
                        {
                          (set depth (- depth 1))
                          (if (<= depth 0)
                            (set stop (+ i 1))
                            0
                          )
                        }
                        0
                      )
                      (set i (+ i 1))
                    }
                  )
                )
              )
            )
          )
        ))
      (if (< stop 0)
        n
        stop
      )
    }
  )
)

; The identifier the form at `o` opens with, or "" when what follows
; its `(` is not one - a nested form, a brace block, a literal.
(pub :: lspViewHeadAt (-> String Int String))

(pub fn (lspViewHeadAt src o)
  (let (
    (n (strLen src))
    (mut i (+ o 1))
  )
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false
      )
        (set i (+ i 1)))
      (if (if (< i n)
        (isIdentStart (strByte src i))
        false
      )
        (strSlice src i (- (lspViewIdentEnd src i n) i))
        ""
      )
    }
  )
)

; One past the head of the form at `o` - where its arguments begin.
(pub :: lspViewHeadEnd (-> String Int Int))

(pub fn (lspViewHeadEnd src o)
  (let (
    (n (strLen src))
    (mut i (+ o 1))
  )
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false
      )
        (set i (+ i 1)))
      (if (if (< i n)
        (isIdentStart (strByte src i))
        false
      )
        (lspViewIdentEnd src i n)
        i
      )
    }
  )
)

; The index of the argument the cursor at `off` is on, in the form
; opening at `o`: the number of COMPLETE items between the head and
; the cursor, where an item the cursor is inside or touching is the
; one being typed rather than a finished one. `(add 1 |` is 1;
; `(add 1|` is 0, because the `1` is still being written; `(add |`
; is 0. Comments between arguments are not items.
(pub :: lspViewActiveArg (-> String Int Int Int))

(pub fn (lspViewActiveArg src o off)
  (let (
    (n (strLen src))
    (mut i (lspViewHeadEnd src o))
    (mut count 0)
    (mut active (- 0 1))
    (mut go 1)
  )
    {
      (while (if (== go 1)
        (< i off)
        false
      )
        (let ((ch (strByte src i)))
          (if (lspIsSpace ch)
            (set i (+ i 1))
            (if (== ch 59)
              (set i (findNewline src i n))
              (if (&& (== ch 35) (isBlockOpen src i n))
                (set i (skipBlockComment src (+ i 2) n))
                (if (== ch 41)
                  (set go 0)
                  (let ((e (lspViewItemEnd src i n)))
                    (if (<= off e)
                      {
                        (set active count)
                        (set go 0)
                      }
                      {
                        (set count (+ count 1))
                        (set i e)
                      }
                    )
                  )
                )
              )
            )
          )
        ))
      (if (< active 0)
        count
        active
      )
    }
  )
)

; ------------------------------------------------------------------
; `textDocument/signatureHelp`: the declaration of the call the cursor
; is inside, with the argument being typed marked.
;
; The innermost form containing the cursor is the call - a cursor
; sitting exactly ON a `(` is inside the form it opens, because that
; is the character the client sends the trigger at - and its head is
; read from the bytes after the `(`. A `fn` of this document answers
; first, then one of its `data` constructors, then an imported `fn`
; read in its own unit's text with the module named in the label,
; then an imported constructor: `lspDefinition`'s order, for the
; language's scoping reason. A keyword head (`let`, `if`) is null: the
; parser dispatches on it and no declaration describes it. So is an
; operator, which has no declaration to read.
;
; The label is what a reader would write: `(add x y) : (-> Int Int
; Int)`, the type cut from the `::` beside the `fn` exactly as
; completion's `detail` is, and omitted when there is none. Each
; parameter is the [start, end) UTF-16 offsets of its name INSIDE the
; label - the protocol's array form, so the client bolds the active
; one without searching the string.
; ------------------------------------------------------------------
(pub :: lspSignatureHelp (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspSignatureHelp src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonNull
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
      )
        (let ((o (lspViewCallAt src (lspOffsetOf src ix (jsonGet params "position")))))
          (if (< o 0)
            jsonNull
            (let (
              (head (lspViewHeadAt src o))
              (hs (lspViewHeadStart src o))
            )
              ; Three forms that open with a declared name and are not
              ; calls to it, cheapest question first: a keyword head; a
              ; `fn` HEADER, `(fn (add x y) ...)`, whose first identifier
              ; is the name being declared (measured: it answered its own
              ; signature with the second parameter active); and a head
              ; that resolves to a LOCAL spelled like a declared `fn`,
              ; which the scope-aware walk decides (`lspNavLocalIndex`).
              (if (|| (== (strLen head) 0) (|| (== (strVecHas lspKeywords head) 1) (|| (lspViewIsFnHeader decls hs) (lspNavLocalIndexHas (lspNavLocalIndex src decls o (+ o 1)) hs))))
                jsonNull
                (let ((local (lspViewSigLocal src decls head)))
                  (let ((found
                    (if (== local 0)
                      (lspViewSigImported (lspUriToPath uri) src decls head)
                      local
                    )
                  ))
                    (if (== found 0)
                      jsonNull
                      (lspViewSigHelp found (lspViewActiveArg src o (lspOffsetOf src ix (jsonGet params "position"))))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The offset of the head identifier of the form at `o` - the byte
; after its `(` and the blanks.
(pub :: lspViewHeadStart (-> String Int Int))

(pub fn (lspViewHeadStart src o)
  (let (
    (n (strLen src))
    (mut i (+ o 1))
  )
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false
      )
        (set i (+ i 1)))
      i
    }
  )
)

; Whether a `fn` of this document declares its name at byte `off` -
; the header `(add x y)` of `(fn (add x y) ...)` opens with the name
; whose span the declaration carries.
(pub :: lspViewIsFnHeader (-> (Vec Int) Int Bool))

(pub fn (lspViewIsFnHeader decls off)
  (let (
    (n (vecLen decls))
    (mut i 0)
    (mut found false)
  )
    {
      (while (if (< i n)
        (lspNavNot found)
        false
      )
        (let ((d (vecGet decls i)))
          {
            (if (&& (== (nodeTag d) TAG_D_FN) (&& (!= (nodeSpan d) 0) (== (spanStart (nodeSpan d)) off)))
              {
                (set found true)
                0
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

; The `(` of the innermost form containing `off`, or -1 when nothing
; does. `lspEnclosingOpens` leaves a form opening exactly AT `off` to
; its caller; here it counts.
(pub :: lspViewCallAt (-> String Int Int))

(pub fn (lspViewCallAt src off)
  (if (if (< off (strLen src))
    (== (strByte src off) 40)
    false
  )
    off
    (let ((opens (lspEnclosingOpens src off)))
      (if (== (vecLen opens) 0)
        (- 0 1)
        (vecGet opens (- (vecLen opens) 1))
      )
    )
  )
)

; The SignatureHelp object: one signature, active, with the argument
; index clamped to the last parameter once the cursor is past them
; all - a client given an index off the end highlights nothing.
(pub :: lspViewSigHelp (-> Int Int Int))

(pub fn (lspViewSigHelp sig arg)
  (let ((np (jsonArrLen (jsonGet sig "parameters"))))
    (let ((active
      (if (>= arg np)
        (if (> np 0)
          (- np 1)
          0
        )
        arg
      )
    ))
      (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "signatures" (jsonArrPush jsonArr sig)) "activeSignature" (jsonNum 0)) "activeParameter" (jsonNum active))
    )
  )
)

; This document's answer for `head`: its `fn` of that name, else a
; constructor of one of its `data` declarations, else 0.
(pub :: lspViewSigLocal (-> String (Vec Int) String Int))

(pub fn (lspViewSigLocal src decls head)
  (let ((d (lspFindDecl decls head (- (vecLen decls) 1))))
    (if (if (!= d 0)
      (== (nodeTag d) TAG_D_FN)
      false
    )
      (lspViewSigFn src decls d "")
      (let ((c (lspViewFindCtor decls head 0)))
        (if (== c 0)
          0
          (lspViewSigCtor c)
        )
      )
    )
  )
)

; The second lookup, over the merged list: an imported `fn`, read in
; the unit that declares it so the type and the paragraph are its
; own text; else an imported constructor.
(pub :: lspViewSigImported (-> String String (Vec Int) String Int))

;@axiom:effect(io)
(pub fn (lspViewSigImported path src decls head)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      0
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
      )
        (let ((d (lspFindImported allDecls head (- (vecLen allDecls) 1))))
          (if (if (!= d 0)
            (== (nodeTag d) TAG_D_FN)
            false
          )
            (let ((u (lspUnitOf units (nodeModule d))))
              (if (< u 0)
                0
                (let ((unit (vecGet units u)))
                  (lspViewSigFn (memGetWordStr unit 1) allDecls d (memGetWordStr unit 2))
                )
              )
            )
            (let ((c (lspViewFindCtor allDecls head 1)))
              (if (== c 0)
                0
                (lspViewSigCtor c)
              )
            )
          )
        )
      )
    )
  )
)

; The constructor named `name` among the `data` declarations of
; `decls`: this document's own when `imported` is 0, the imported
; ones alone when it is 1 - the merged list carries both, and the
; local ones were asked first.
(pub :: lspViewFindCtor (-> (Vec Int) String Int Int))

(pub fn (lspViewFindCtor decls name imported)
  (let (
    (n (vecLen decls))
    (mut i 0)
    (mut found 0)
  )
    {
      (while (if (< i n)
        (== found 0)
        false
      )
        (let ((d (vecGet decls i)))
          {
            (if (if (== (nodeTag d) TAG_D_DATA)
              (if (== imported 1)
                (!= (nodeModule d) 0)
                (== (nodeModule d) 0)
              )
              false
            )
              (set found (lspViewCtorIn (nodeBVec d) name))
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

(pub :: lspViewCtorIn (-> (Vec Int) String Int))

(pub fn (lspViewCtorIn ctors name)
  (let (
    (n (vecLen ctors))
    (mut i 0)
    (mut found 0)
  )
    {
      (while (if (< i n)
        (== found 0)
        false
      )
        {
          (if (strEq (nodeAName (vecGet ctors i)) name)
            (set found (vecGet ctors i))
            0
          )
          (set i (+ i 1))
        })
      found
    }
  )
)

; A `fn` as a SignatureInformation, read in the document that declares
; it (`dsrc`, `ddecls`). The name is the bare one - an imported
; declaration's `nodeAName` is `ViewHelper$twice` and the reader
; wrote `twice` - and the signature is found under the mangled one,
; because `resolveImports` mangles a `::` and its `fn` alike. `origin`
; names the module of an imported one, after the type, so the label
; still reads as the call.
(pub :: lspViewSigFn (-> String (Vec Int) Int String Int))

(pub fn (lspViewSigFn dsrc ddecls d origin)
  (let (
    (sig (lspFindSig ddecls (nodeAName d) (- (vecLen ddecls) 1)))
    (ps (nodeBVec d))
    (starts vecNew)
    (ends vecNew)
    (mut label (strConcat "(" (bareOf (nodeAName d))))
    (mut i 0)
  )
    {
      (while (< i (vecLen ps))
        {
          (set label (strConcat label " "))
          (vecPush starts (strLen label))
          (set label (strConcat label (vecGetStr ps i)))
          (vecPush ends (strLen label))
          (set i (+ i 1))
        })
      (set label (strConcat label ")"))
      (if (!= sig 0)
        (set label (strConcat (strConcat label " : ") (lspSigType dsrc sig)))
        label
      )
      (if (> (strLen origin) 0)
        (set label (strConcat (strConcat label " from ") origin))
        label
      )
      (lspViewSigInfo label starts ends (lspViewSigDoc dsrc d sig))
    }
  )
)

; The paragraph above the declaration, read where hover reads it: at
; the `::` when the `fn` has one, because that is where this language
; puts the comment, and at the `fn` itself otherwise.
(pub :: lspViewSigDoc (-> String Int Int String))

(pub fn (lspViewSigDoc dsrc d sig)
  (let ((at
    (if (== sig 0)
      d
      sig
    )
  ))
    (if (== (nodeSpan at) 0)
      ""
      (lspDocComment dsrc (lspFormStart dsrc (spanStart (nodeSpan at))))
    )
  )
)

; A constructor: `(Circle Int)`, each field type rendered by the
; checker's own printer and labelled as a parameter, so the client
; bolds the field being written.
(pub :: lspViewSigCtor (-> Int Int))

(pub fn (lspViewSigCtor c)
  (let (
    (tys (nodeTyVec c))
    (starts vecNew)
    (ends vecNew)
    (mut label (strConcat "(" (nodeAName c)))
    (mut i 0)
  )
    {
      (while (if (!= (cast Int tys) 0)
        (< i (vecLen tys))
        false
      )
        {
          (set label (strConcat label " "))
          (vecPush starts (strLen label))
          (set label (strConcat label (tyRender (vecGet tys i))))
          (vecPush ends (strLen label))
          (set i (+ i 1))
        })
      (set label (strConcat label ")"))
      (lspViewSigInfo label starts ends "")
    }
  )
)

; The SignatureInformation object. The byte offsets into `label`
; become UTF-16 units through `lspCharFrom` from 0, which a label
; with no newline in it makes exact; `documentation` is carried as
; markdown when the declaration has a paragraph and left out when it
; has not.
(pub :: lspViewSigInfo (-> String (Vec Int) (Vec Int) String Int))

(pub fn (lspViewSigInfo label starts ends doc)
  (let (
    (params jsonArr)
    (mut i 0)
  )
    {
      (while (< i (vecLen starts))
        {
          (jsonArrPush params (jsonObjPut jsonObj "label" (jsonArrPush (jsonArrPush jsonArr (jsonNum (lspCharFrom label 0 (vecGet starts i)))) (jsonNum (lspCharFrom label 0 (vecGet ends i))))))
          (set i (+ i 1))
        })
      (let ((base (jsonObjPut (jsonObjPut jsonObj "label" (jsonStr label)) "parameters" params)))
        (if (== (strLen doc) 0)
          base
          (jsonObjPut base "documentation" (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value" (jsonStr doc)))
        )
      )
    }
  )
)

; ------------------------------------------------------------------
; A name index over a declaration list, built once per request.
;
; Parameter-name hints ask "which `fn` is this" once per CALL SITE,
; and a document has many more call sites than declarations - so a
; walk of the declaration list per site is the n-squared
; `lspComplWants` exists to avoid, and over the MERGED list it is that
; times every module imported. No hash map is in reach of this file
; (`Map` is imported by `Intern` alone), so this is a bucket table:
; `LSP_VIEW_IDX_SLOTS` slots keyed by a hash of EVERY byte of the
; name, each a Vec of (bare name, node) pairs, empty ones left as 0.
;
; THE FIRST BYTE ALONE WAS TRIED FIRST and was a mistake this
; repository's naming makes certain: every function in this file
; begins `lsp`, and on the gate's document of 2,050 functions named
; `f0`..`f2049` a first-byte key put all of them in one slot - the
; n-squared walk again, wearing an index. Measured on that document
; against a 0.031 s `didOpen`, a whole-document hint request: 0.050 s
; with the first-byte key and 0.012 s with the hash below over the
; 4,100 header hints; 0.074 s and 0.026 s over 6,150 hints when every
; function also calls one. A 60-line window, which is what an editor
; asks for, is 0.016 s either way.
;
; Two entries under one name resolve the language's way: the
; document's own declaration (module 0) shadows an imported one, and
; among the document's own the LAST wins, which is `lspFindDecl`'s
; rule.
; ------------------------------------------------------------------
(pub :: LSP_VIEW_IDX_SLOTS Int)

(pub fn (LSP_VIEW_IDX_SLOTS) 1024)

(pub :: lspViewIdxNew (Vec Int))

(pub fn (lspViewIdxNew)
  (let (
    (v vecNew)
    (mut i 0)
  )
    {
      (while (< i LSP_VIEW_IDX_SLOTS)
        {
          (vecPush v 0)
          (set i (+ i 1))
        })
      v
    }
  )
)

; djb2 over the bytes, reduced modulo 2^24 at every step: `h * 33 + b`
; then stays under 2^30, so the arithmetic never wraps and the slot is
; a remainder of the same number on every run.
(pub :: lspViewIdxSlot (-> String Int))

(pub fn (lspViewIdxSlot name)
  (let (
    (n (strLen name))
    (mut i 0)
    (mut h 5381)
  )
    {
      (while (< i n)
        {
          (set h (% (+ (* h 33) (strByte name i)) 16777216))
          (set i (+ i 1))
        })
      (% h LSP_VIEW_IDX_SLOTS)
    }
  )
)

(pub :: lspViewIdxAdd (-> (Vec Int) String Int Int))

(pub fn (lspViewIdxAdd idx name node)
  (let ((slot (lspViewIdxSlot name)))
    (let ((bucket
      (if (== (vecGet idx slot) 0)
        (let ((b vecNew))
          {
            (vecSet idx slot (cast Int b))
            b
          }
        )
        (vecGetVec idx slot)
      )
    ))
      {
        (vecPushStr bucket name)
        (vecPush bucket node)
        0
      }
    )
  )
)

(pub :: lspViewIdxFind (-> (Vec Int) String Int))

(pub fn (lspViewIdxFind idx name)
  (let ((bucket (vecGetVec idx (lspViewIdxSlot name))))
    (if (== (cast Int bucket) 0)
      0
      (let (
        (n (vecLen bucket))
        (mut i 0)
        (mut local 0)
        (mut other 0)
      )
        {
          (while (< i n)
            {
              (if (strEq (vecGetStr bucket i) name)
                (if (== (nodeModule (vecGet bucket (+ i 1))) 0)
                  (set local (vecGet bucket (+ i 1)))
                  (set other (vecGet bucket (+ i 1)))
                )
                0
              )
              (set i (+ i 2))
            })
          (if (!= local 0)
            local
            other
          )
        }
      )
    )
  )
)

; The `fn` declarations a call can name, by bare name: this document's
; and, when its imports resolve, every module's. A failed preflight -
; a half-typed import - is this document alone.
(pub :: lspViewFnIndexFor (-> String String (Vec Int) (Vec a)))

;@axiom:effect(io)
(pub fn (lspViewFnIndexFor path src decls)
  (let ((r (lspResolveFor path src decls)))
    (lspViewFnIndex
      (if (== r 0)
        decls
        (memGetWordVec r 0)
      )
    )
  )
)

(pub :: lspViewFnIndex (-> (Vec Int) (Vec Int)))

(pub fn (lspViewFnIndex list)
  (let (
    (idx lspViewIdxNew)
    (n (vecLen list))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((d (vecGet list i)))
          {
            (if (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0))
              (lspViewIdxAdd idx (bareOf (nodeAName d)) d)
              0
            )
            (set i (+ i 1))
          }
        ))
      idx
    }
  )
)

; The `::` signatures of this document, by name, for the header hints
; - the same question `lspFindSig` answers, asked once per `fn` rather
; than by a walk per `fn`.
(pub :: lspViewSigIndex (-> (Vec Int) (Vec a)))

(pub fn (lspViewSigIndex decls)
  (let (
    (idx lspViewIdxNew)
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((d (vecGet decls i)))
          {
            (if (&& (== (nodeTag d) TAG_D_SIG) (!= (nodeSpan d) 0))
              (lspViewIdxAdd idx (nodeAName d) d)
              0
            )
            (set i (+ i 1))
          }
        ))
      idx
    }
  )
)

; ------------------------------------------------------------------
; `textDocument/inlayHint`: three kinds of hint, inside the requested
; range, on every `fn` whose extent meets it.
;
;   (a) PARAMETER NAMES at call sites - `x:` before the `1` of
;       `(add 1 2)` - for every application whose head names a `fn`
;       this document declares or imports. An argument that IS a
;       variable spelled like the parameter shows nothing, which is
;       rust-analyzer's rule: `(bump x)` where the parameter is `x`
;       says nothing a reader does not see. Operators and
;       constructors have no `fn` declaration and fall out of the
;       same lookup; nothing is special-cased by spelling.
;   (b) PARAMETER TYPES in the header, `: Int` after each name, from
;       the `::` signature's arrow, one parameter per arrow position.
;   (c) THE RETURN TYPE, ` -> Int` after the header's `)`, when the
;       signature has at least one arrow - a nullary `(:: main Int)`
;       has nothing to say there.
;
; A `fn`'s EXTENT is the span from its name to the next declaration's
; name (or EOF): the tree records no form extent, and the next name
; is a bound that costs nothing, where `lspFormEnd` per `fn` would
; rescan the document. A `fn` outside the range is skipped before its
; body is walked, which is what keeps a request for the visible
; window from paying for the whole file.
; ------------------------------------------------------------------
(pub :: lspInlayHints (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspInlayHints src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonArr
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
        (n (strLen src))
        (range (jsonGet params "range"))
      )
        (let (
          (rs
            (if (== range 0)
              0
              (lspOffsetOf src ix (jsonGet range "start"))
            )
          )
          (re
            (if (== range 0)
              n
              (lspOffsetOf src ix (jsonGet range "end"))
            )
          )
          (fns (lspViewFnIndexFor (lspUriToPath uri) src decls))
          (sigs (lspViewSigIndex decls))
          ; The heads that are locals - a parameter or a `let`
          ; spelled like a declared `fn` - over the same
          ; declarations the range meets, so `(fn (apply k v) (k
          ; v))` beside a top-level `k` labels nothing.
          (locals (lspNavLocalIndex src decls rs re))
          (out jsonArr)
          (mut i 0)
        )
          {
            (while (< i (vecLen decls))
              (let ((d (vecGet decls i)))
                {
                  (if (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0))
                    (let (
                      (lo (spanStart (nodeSpan d)))
                      (hi (lspViewNextDeclStart decls i n))
                    )
                      (if (&& (< lo re) (> hi rs))
                        {
                          (lspViewHintsHeader out src ix d (lspViewIdxFind sigs (nodeAName d)) rs re)
                          (lspViewHintsExpr out src ix fns locals (nodeC d) rs re)
                        }
                        0
                      )
                    )
                    0
                  )
                  (set i (+ i 1))
                }
              ))
            out
          }
        )
      )
    )
  )
)

; Where the declaration after `i` begins, or the document length.
(pub :: lspViewNextDeclStart (-> (Vec Int) Int Int Int))

(pub fn (lspViewNextDeclStart decls i n)
  (let (
    (mut j (+ i 1))
    (mut at n)
  )
    {
      (while (if (< j (vecLen decls))
        (== at n)
        false
      )
        {
          (if (!= (nodeSpan (vecGet decls j)) 0)
            (set at (spanStart (nodeSpan (vecGet decls j))))
            0
          )
          (set j (+ j 1))
        })
      at
    }
  )
)

; The header hints, (b) and (c). The positions are recovered from the
; header's bytes: identifiers after the name's span up to the `)`,
; which is exactly the token sequence `parseIdentList` accepted -
; anything else there and the document would not have parsed. The
; byte before the name must be the header's own `(`: the bare nullary
; form `(fn answer 42)` has no parameter list, and its `42` is not a
; parameter however identifier-shaped its digits are.
(pub :: lspViewHintsHeader (-> Int String (Vec Int) Int Int Int Int Int))

(pub fn (lspViewHintsHeader out src ix d sig rs re)
  (if (if (== sig 0)
    true
    (if (== (nodeTy sig) 0)
      true
      (if (lspViewHeaderOpen src (spanStart (nodeSpan d)))
        false
        true
      )
    )
  )
    0
    (let (
      (ty (nodeTy sig))
      (n (strLen src))
      (mut i (spanEnd (nodeSpan d)))
      (mut k 0)
      (mut close (- 0 1))
      (mut go 1)
    )
      {
        (while (if (== go 1)
          (< i n)
          false
        )
          (let ((ch (strByte src i)))
            (if (lspIsSpace ch)
              (set i (+ i 1))
              (if (== ch 41)
                {
                  (set close i)
                  (set go 0)
                }
                (if (isIdentChar ch)
                  (let ((e (skipIdent src i n)))
                    {
                      (let ((pt (nthParamTy ty k 0)))
                        (if (if (!= pt 0)
                          (!= (nodeTag pt) TAG_T_ERR)
                          false
                        )
                          (lspViewHint out src ix e (strConcat ": " (tyRender pt)) 1 0 rs re)
                          0
                        ))
                      (set k (+ k 1))
                      (set i e)
                    }
                  )
                  (set go 0)
                )
              )
            )
          ))
        (if (if (>= close 0)
          (== (nodeTag ty) TAG_T_ARR)
          false
        )
          (lspViewHint out src ix (+ close 1) (strConcat " -> " (tyRender (lspViewResultTy ty))) 1 0 rs re)
          0
        )
      }
    )
  )
)

; Whether the byte before `s`, past any blanks, is a `(`.
(pub :: lspViewHeaderOpen (-> String Int Bool))

(pub fn (lspViewHeaderOpen src s)
  (let ((mut i (- s 1)))
    {
      (while (if (> i 0)
        (lspIsBlank (strByte src i))
        false
      )
        (set i (- i 1)))
      (if (< i 0)
        false
        (== (strByte src i) 40)
      )
    }
  )
)

; The final result of an arrow type: `(-> Int Int Bool)` folds to
; `Int -> (Int -> Bool)`, so the result is the last `nodeB`.
(pub :: lspViewResultTy (-> Int Int))

(pub fn (lspViewResultTy ty)
  (if (if (!= ty 0)
    (== (nodeTag ty) TAG_T_ARR)
    false
  )
    (lspViewResultTy (nodeB ty))
    ty
  )
)

; One InlayHint at byte `off`, appended only when `off` is inside the
; requested range. `kind` is the protocol's: 1 Type, 2 Parameter.
; `padRight` puts a space after a parameter-name label, so `x:` does
; not touch the `1` it names.
(pub :: lspViewHint (-> Int String (Vec Int) Int String Int Int Int Int Int))

(pub fn (lspViewHint out src ix off label kind padRight rs re)
  (if (&& (>= off rs) (< off re))
    (let ((base (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "position" (lspPosIx src ix off)) "label" (jsonStr label)) "kind" (jsonNum kind))))
      {
        (jsonArrPush
          out          (if (== padRight 1)
            (jsonObjPut base "paddingRight" (jsonBool 1))
            base
          )
        )
        0
      }
    )
    0
  )
)

; ------------------------------------------------------------------
; The body walk for (a).
;
; Every expression tag the parser builds, by its children: nodes are
; walked, Vecs of nodes are walked element by element, and Strings -
; a binder, a field name, a `set` target - are not touched. A tag
; not named here is a leaf. Patterns are not walked: `(Just x)` in
; arm position is a constructor and a binder, and neither is a call.
;
; POSITIONS COME FROM THE BYTES, not the tree. An application's span
; is its head's, a `let` argument's is its binder's, an `if`'s is its
; test's: none of them is where the argument BEGINS, which is the `(`
; the parser does not record. So the head's span - exact, and the one
; thing the tree does place - anchors a scan of the items after it,
; and the i-th item's start is where the i-th argument's hint goes.
; Literals, too, are found this way rather than through their spans,
; so every argument shape takes one path.
; ------------------------------------------------------------------
(pub :: lspViewHintsExpr (-> Int String (Vec Int) (Vec Int) (Vec Int) Int Int Int Int))

(pub fn (lspViewHintsExpr out src ix fns locals e rs re)
  (if (== e 0)
    0
    (let ((tag (nodeTag e)))
      (if (== tag TAG_E_APP)
        (lspViewHintsApp out src ix fns locals e rs re)
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
          {
            (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
            (lspViewHintsExpr out src ix fns locals (nodeC e) rs re)
          }
          (if (== tag TAG_E_IF)
            {
              (lspViewHintsExpr out src ix fns locals (nodeA e) rs re)
              (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
              (lspViewHintsExpr out src ix fns locals (nodeC e) rs re)
            }
            (if (== tag TAG_E_LAM)
              (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
              (if (== tag TAG_E_BEGIN)
                (lspViewHintsVec out src ix fns locals (nodeAVec e) rs re)
                (if (== tag TAG_E_STRUCTCON)
                  (lspViewHintsVec out src ix fns locals (nodeBVec e) rs re)
                  (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
                    (if (== tag TAG_E_REGION)
                      (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
                    {
                      (lspViewHintsExpr out src ix fns locals (nodeA e) rs re)
                      (lspViewHintsVec out src ix fns locals (nodeBVec e) rs re)
                    }
                    )
                    (if (== tag TAG_E_MATCH)
                      {
                        (lspViewHintsExpr out src ix fns locals (nodeA e) rs re)
                        (lspViewHintsArms out src ix fns locals (nodeBVec e) 0 rs re)
                      }
                      (if (== tag TAG_E_COND)
                        {
                          (lspViewHintsArms out src ix fns locals (nodeAVec e) 1 rs re)
                          (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
                        }
                        (if (== tag TAG_E_SET)
                          (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
                          (if (== tag TAG_E_FIELD)
                            (lspViewHintsExpr out src ix fns locals (nodeA e) rs re)
                            (if (== tag TAG_E_SETF)
                              {
                                (lspViewHintsExpr out src ix fns locals (nodeA e) rs re)
                                (lspViewHintsExpr out src ix fns locals (nodeC e) rs re)
                              }
                              (if (== tag TAG_E_ALLOC)
                                (lspViewHintsExpr out src ix fns locals (nodeB e) rs re)
                                (if (== tag TAG_E_HANDLE)
                                  {
                                    (lspViewHintsExpr out src ix fns locals (nodeA e) rs re)
                                    (lspViewHintsExpr out src ix fns locals (nodeC e) rs re)
                                  }
                                  0
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(pub :: lspViewHintsVec (-> Int String (Vec Int) (Vec Int) (Vec Int) (Vec Int) Int Int Int))

(pub fn (lspViewHintsVec out src ix fns locals xs rs re)
  (if (== (cast Int xs) 0)
    0
    (let ((mut i 0))
      {
        (while (< i (vecLen xs))
          {
            (lspViewHintsExpr out src ix fns locals (vecGet xs i) rs re)
            (set i (+ i 1))
          })
        0
      }
    )
  )
)

; The arms of a `match` (bodies alone - the pattern is not a call) or
; of a `cond` (`withTest` 1: the test is an expression too).
(pub :: lspViewHintsArms (-> Int String (Vec Int) (Vec Int) (Vec Int) (Vec Int) Int Int Int Int))

(pub fn (lspViewHintsArms out src ix fns locals arms withTest rs re)
  (if (== (cast Int arms) 0)
    0
    (let ((mut i 0))
      {
        (while (< i (vecLen arms))
          (let ((arm (vecGet arms i)))
            {
              (if (== (nodeTag arm) TAG_M_ARM)
                {
                  (if (== withTest 1)
                    (lspViewHintsExpr out src ix fns locals (nodeA arm) rs re)
                    0
                  )
                  (lspViewHintsExpr out src ix fns locals (nodeB arm) rs re)
                }
                0
              )
              (set i (+ i 1))
            }
          ))
        0
      }
    )
  )
)

; An application: `(f a b)` is App(App(f, a), b), so the arguments
; come off the spine last-first and are reversed. A head that is a
; variable is a call; any other head - a lambda, a nested form - is
; walked as an expression. Every argument is walked afterwards, since
; each may hold calls of its own.
(pub :: lspViewHintsApp (-> Int String (Vec Int) (Vec Int) (Vec Int) Int Int Int Int))

(pub fn (lspViewHintsApp out src ix fns locals e rs re)
  (let (
    (args vecNew)
    (mut h e)
  )
    {
      (while (== (nodeTag h) TAG_E_APP)
        {
          (vecPush args (nodeB h))
          (set h (nodeA h))
        })
      (lspViewReverse args)
      (if (== (nodeTag h) TAG_E_VAR)
        (lspViewHintsCall out src ix fns locals h args rs re)
        (lspViewHintsExpr out src ix fns locals h rs re)
      )
      (lspViewHintsVec out src ix fns locals args rs re)
    }
  )
)

(pub :: lspViewReverse (-> (Vec Int) Int))

(pub fn (lspViewReverse v)
  (let (
    (mut i 0)
    (mut j (- (vecLen v) 1))
  )
    {
      (while (< i j)
        (let ((t (vecGet v i)))
          {
            (vecSet v i (vecGet v j))
            (vecSet v j t)
            (set i (+ i 1))
            (set j (- j 1))
          }
        ))
      0
    }
  )
)

; The hints for one call: the declaration's parameter names, each at
; the start of the item the bytes hold at that position, for as many
; arguments as the call has and the declaration names.
(pub :: lspViewHintsCall (-> Int String (Vec Int) (Vec Int) (Vec Int) Int (Vec Int) Int Int Int))

(pub fn (lspViewHintsCall out src ix fns locals head args rs re)
  (let ((d
    (if (== (nodeSpan head) 0)
      0
      ; A head that is a local is not a call to the `fn` it is
      ; spelled like; the walk that knows the scopes says which.
      (if (lspNavLocalIndexHas locals (spanStart (nodeSpan head)))
        0
        (lspViewIdxFind fns (bareOf (nodeAName head)))
      )
    )
  ))
    (if (== d 0)
      0
      (let (
        (ps (nodeBVec d))
        (n (strLen src))
        (mut i (lspViewIdentEnd src (spanStart (nodeSpan head)) n))
        (mut a 0)
        (mut go 1)
      )
        {
          (while (if (== go 1)
            (if (< i n)
              (&& (< a (vecLen ps)) (< a (vecLen args)))
              false
            )
            false
          )
            (let ((ch (strByte src i)))
              (if (lspIsSpace ch)
                (set i (+ i 1))
                (if (== ch 59)
                  (set i (findNewline src i n))
                  (if (&& (== ch 35) (isBlockOpen src i n))
                    (set i (skipBlockComment src (+ i 2) n))
                    (if (== ch 41)
                      (set go 0)
                      {
                        (if (lspViewSameName (vecGet args a) (vecGetStr ps a))
                          0
                          (lspViewHint out src ix i (strConcat (vecGetStr ps a) ":") 2 1 rs re)
                        )
                        (set a (+ a 1))
                        (set i (lspViewItemEnd src i n))
                      }
                    )
                  )
                )
              )
            ))
          0
        }
      )
    )
  )
)

(pub :: lspViewSameName (-> Int String Bool))

(pub fn (lspViewSameName arg name)
  (if (== arg 0)
    false
    (if (== (nodeTag arg) TAG_E_VAR)
      (strEq (nodeAName arg) name)
      false
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/foldingRange`: every form whose `(` and `)` sit on
; different lines, every `{ }` block likewise, a run of two or more
; whole-line `;` comments as "comment", and a run of two or more
; top-level `(import ...)` forms as "imports".
;
; A BYTE SCAN, NOT A PARSE, and that is the point: a half-typed file
; is unparseable exactly while its author is looking at it, and its
; balanced forms still fold. The scanner is `lspFormEnd`'s, with a
; stack of open brackets in place of a depth count so each closer
; knows its own opener; an unbalanced closer is ignored and an
; unclosed opener folds nothing. A `;` is a whole-line comment when
; nothing but blanks precedes it on its line - a `;` inside a string
; is never seen, because the string was stepped over.
; ------------------------------------------------------------------
(pub :: lspFoldingRanges (-> String Int))

(pub fn (lspFoldingRanges src)
  (let (
    (n (strLen src))
    (ix (lspLineIndex src))
    (out jsonArr)
    (stack vecNew)
    (comments vecNew)
    (mut i 0)
    (mut impStart (- 0 1))
    (mut impEnd (- 0 1))
    (mut impCount 0)
    (mut topImport 0)
  )
    {
      (while (< i n)
        (let ((ch (strByte src i)))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (set i (skipIdent src (+ i 1) n))
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    {
                      (if (lspViewLineBlankBefore src ix i)
                        (vecPush comments (lspLineOfIx ix i))
                        (cast (Vec Int) 0)
                      )
                      (set i (findNewline src i n))
                    }
                    {
                      (if (|| (== ch 40) (== ch 123))
                        {
                          ; A top-level `(` opens or breaks an import
                          ; run; the run is flushed at the first form
                          ; that is not an import.
                          (if (&& (== ch 40) (== (vecLen stack) 0))
                            (if (lspViewIsImportAt src i n)
                              {
                                (if (< impStart 0)
                                  (set impStart i)
                                  0
                                )
                                (set topImport 1)
                              }
                              {
                                (lspViewFlushImports out ix impStart impEnd impCount)
                                (set impStart (- 0 1))
                                (set impCount 0)
                                (set topImport 0)
                              }
                            )
                            0
                          )
                          (vecPush stack i)
                        }
                        (cast (Vec Int) 0)
                      )
                      (if (|| (== ch 41) (== ch 125))
                        (if (> (vecLen stack) 0)
                          (let ((o (vecPop stack)))
                            {
                              (lspViewFold out (lspLineOfIx ix o) (lspLineOfIx ix i) "")
                              (if (&& (== (vecLen stack) 0) (== topImport 1))
                                {
                                  (set impEnd i)
                                  (set impCount (+ impCount 1))
                                }
                                0
                              )
                            }
                          )
                          0
                        )
                        0
                      )
                      (set i (+ i 1))
                    }
                  )
                )
              )
            )
          )
        ))
      (lspViewFlushImports out ix impStart impEnd impCount)
      (lspViewFoldComments out comments)
      out
    }
  )
)

; One FoldingRange, when the lines differ - a region of one line is
; nothing to fold. `kind` is added when non-empty.
(pub :: lspViewFold (-> Int Int Int String Int))

(pub fn (lspViewFold out sl el kind)
  (if (>= sl el)
    0
    (let ((base (jsonObjPut (jsonObjPut jsonObj "startLine" (jsonNum sl)) "endLine" (jsonNum el))))
      {
        (jsonArrPush
          out          (if (== (strLen kind) 0)
            base
            (jsonObjPut base "kind" (jsonStr kind))
          )
        )
        0
      }
    )
  )
)

; The import run so far, as an "imports" fold when it holds two or
; more CLOSED imports - `impCount` is counted at the closer, so a
; half-typed import at the end of the run does not extend it.
(pub :: lspViewFlushImports (-> Int (Vec Int) Int Int Int Int))

(pub fn (lspViewFlushImports out ix impStart impEnd impCount)
  (if (if (>= impStart 0)
    (>= impCount 2)
    false
  )
    (lspViewFold out (lspLineOfIx ix impStart) (lspLineOfIx ix impEnd) "imports")
    0
  )
)

; Whether the form opening at `o` is `(import ...)`: the keyword, then
; a byte that is not part of an identifier, so `(imports` is not one.
; This is the parser's own `kwEq` test made on bytes, since no tree
; exists for a document that does not parse.
(pub :: lspViewIsImportAt (-> String Int Int Bool))

(pub fn (lspViewIsImportAt src o n)
  (let ((mut i (+ o 1)))
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false
      )
        (set i (+ i 1)))
      (if (> (+ i 6) n)
        false
        (if (strEq (strSlice src i 6) "import")
          (if (< (+ i 6) n)
            (if (isIdentChar (strByte src (+ i 6)))
              false
              true
            )
            true
          )
          false
        )
      )
    }
  )
)

; Whether nothing but blanks sits between the start of `off`'s line
; and `off` - what makes a `;` at `off` a whole-line comment rather
; than one trailing code.
(pub :: lspViewLineBlankBefore (-> String (Vec Int) Int Bool))

(pub fn (lspViewLineBlankBefore src ix off)
  (let (
    (mut i (vecGet ix (lspLineOfIx ix off)))
    (mut blank 1)
  )
    {
      (while (if (< i off)
        (== blank 1)
        false
      )
        {
          (if (lspIsBlank (strByte src i))
            0
            (set blank 0)
          )
          (set i (+ i 1))
        })
      (== blank 1)
    }
  )
)

; Runs of two or more consecutive whole-line comments, as "comment"
; folds. `lines` is ascending, because the scan that filled it was;
; a blank line between two comments ends a run, since consecutive
; means consecutive.
(pub :: lspViewFoldComments (-> Int (Vec Int) Int))

(pub fn (lspViewFoldComments out lines)
  (let (
    (n (vecLen lines))
    (mut i 0)
    (mut runStart (- 0 1))
    (mut runEnd (- 0 1))
  )
    {
      (while (< i n)
        (let ((ln (vecGet lines i)))
          {
            (if (if (>= runStart 0)
              (== ln (+ runEnd 1))
              false
            )
              (set runEnd ln)
              {
                (lspViewFold out runStart runEnd "comment")
                (set runStart ln)
                (set runEnd ln)
              }
            )
            (set i (+ i 1))
          }
        ))
      (lspViewFold out runStart runEnd "comment")
      0
    }
  )
)

; ------------------------------------------------------------------
; `textDocument/selectionRange`: for each position, the chain of
; ranges a selection expands through - the identifier under the
; cursor, then each enclosing form innermost-out, then the whole
; document.
;
; Built from the document INWARD so that each link's `parent` exists
; before the link does, and answered from the innermost, which is how
; the protocol nests it. A link whose range equals the one before it
; is dropped - a word that is the whole of a form, say - so the client
; sees each range once. Nothing is parsed: a chain of brackets is a
; byte question, and a document that does not parse still has one.
; ------------------------------------------------------------------
(pub :: lspSelectionRanges (-> String Int Int))

(pub fn (lspSelectionRanges src params)
  (let (
    (ix (lspLineIndex src))
    (positions (jsonGet params "positions"))
    (out jsonArr)
    (mut i 0)
  )
    {
      (while (< i (jsonArrLen positions))
        {
          (jsonArrPush out (lspViewSelChain src ix (lspOffsetOf src ix (jsonArrGet positions i))))
          (set i (+ i 1))
        })
      out
    }
  )
)

(pub :: lspViewSelChain (-> String (Vec Int) Int Int))

(pub fn (lspViewSelChain src ix off)
  (let (
    (n (strLen src))
    (opens (lspEnclosingOpens src off))
    (mut cur (jsonObjPut jsonObj "range" (lspRangeIx src ix (mkSpan 0 n))))
    (mut ps 0)
    (mut pe n)
    (mut i 0)
  )
    {
      ; A cursor ON a `(` is inside the form it opens, which
      ; `lspEnclosingOpens` leaves to its caller.
      (if (if (< off n)
        (== (strByte src off) 40)
        false
      )
        (vecPush opens off)
        (cast (Vec Int) 0)
      )
      (while (< i (vecLen opens))
        (let ((o (vecGet opens i)))
          (let ((e (lspFormEnd src o)))
            {
              (if (|| (!= o ps) (!= e pe))
                {
                  (set cur (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (mkSpan o e))) "parent" cur))
                  (set ps o)
                  (set pe e)
                }
                0
              )
              (set i (+ i 1))
            }
          )
        ))
      (let ((w (lspWordSpan src off)))
        (if (if (!= w 0)
          (|| (!= (spanStart w) ps) (!= (spanEnd w) pe))
          false
        )
          (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix w)) "parent" cur)
          cur
        )
      )
    }
  )
)

; ------------------------------------------------------------------
; `textDocument/documentLink`: every `(import M)` whose module the
; resolver's own search finds, as a link over the dotted name to the
; file's URI. The range is the name AS WRITTEN: the parser's span
; names the path's first segment alone, so the range extends over
; identifier bytes and the `.` between segments - `.` is not an
; identifier byte, which is why this is a scan and not `lspWordSpan`.
; An import the search cannot resolve gets no link, and the diagnostic
; the checker publishes for it already says why.
; ------------------------------------------------------------------
(pub :: lspDocumentLinks (-> String String Int))

;@axiom:effect(io)
(pub fn (lspDocumentLinks src uri)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonArr
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
        (n (strLen src))
        (tcode (checkedTargetCode hostTarget))
        (entryDir (pathDir (lspUriToPath uri)))
        (out jsonArr)
        (mut i 0)
      )
        {
          (while (< i (vecLen decls))
            (let ((d (vecGet decls i)))
              {
                (if (&& (== (nodeTag d) TAG_D_IMPORT) (!= (nodeSpan d) 0))
                  (let ((p (moduleSrcPath (nodeAName d) tcode entryDir)))
                    (if (== (strLen p) 0)
                      0
                      (let (
                        (s (spanStart (nodeSpan d)))
                        (mut e (spanStart (nodeSpan d)))
                      )
                        {
                          (while (if (< e n)
                            (|| (isIdentChar (strByte src e)) (== (strByte src e) 46))
                            false
                          )
                            (set e (+ e 1)))
                          (jsonArrPush out (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (mkSpan s e))) "target" (jsonStr (lspPathToUri p))))
                          0
                        }
                      )
                    )
                  )
                  0
                )
                (set i (+ i 1))
              }
            ))
          out
        }
      )
    )
  )
)

; ------------------------------------------------------------------
; `workspace/symbol`: every declaration the open documents can see -
; their own, and every module each imports - whose bare name holds
; the query, case-folded.
;
; The workspace this server knows is the document store: the editor
; sends it the files that are open and nothing else, and the imports
; of those files are what a reader of them can reach. Each open
; document is parsed and its imports resolved as `lspComplImported`
; resolves them; an imported declaration is placed in ITS file
; through the unit table, with the module as `containerName`. The
; kinds are the outline's, plus EnumMember for a constructor, which
; the outline omits and a search wants. The list stops at
; `LSP_COMPL_MAX`, for the reason completion's does: a search result
; is not a directory listing. A declaration reached twice - a module
; two open documents both import - is listed once, by URI and offset.
; ------------------------------------------------------------------
(pub :: lspWorkspaceSymbols (-> (Vec String) (Vec a) Int Int))

;@axiom:effect(io)
(pub fn (lspWorkspaceSymbols uris texts params)
  (let (
    (query (jsonGetStr params "query"))
    (out jsonArr)
    (seen vecNew)
    (mut j 0)
  )
    {
      (while (if (< j (vecLen uris))
        (< (jsonArrLen out) LSP_COMPL_MAX)
        false
      )
        (let (
          (uri (vecGetStr uris j))
          (src (vecGetStr texts j))
        )
          {
            (if (> (strLen src) 0)
              (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
                (if (== (memGetWord pr 0) 0)
                  0
                  (let ((decls (memGetWordVec pr 1)))
                    {
                      (lspViewSymsLocal out seen query uri src decls)
                      (lspViewSymsImported out seen query (lspUriToPath uri) src decls)
                    }
                  )
                )
              )
              0
            )
            (set j (+ j 1))
          }
        ))
      out
    }
  )
)

(pub :: lspViewSymsLocal (-> Int (Vec String) String String String (Vec Int) Int))

(pub fn (lspViewSymsLocal out seen query uri src decls)
  (let (
    (ix (lspLineIndex src))
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (if (< i n)
        (< (jsonArrLen out) LSP_COMPL_MAX)
        false
      )
        (let ((d (vecGet decls i)))
          {
            (if (&& (lspWantsSymbol (nodeTag d)) (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0)))
              {
                (lspViewSymOffer out seen query uri src ix (nodeAName d) (lspSymKind (nodeTag d)) (nodeSpan d) "")
                (if (== (nodeTag d) TAG_D_DATA)
                  (lspViewSymCtors out seen query uri src ix (nodeBVec d) "")
                  0
                )
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; The imported half. The name test is asked BEFORE the unit is looked
; up and before its URI and line index are built - the cheap question
; first, as `lspComplWants` asks it - and a unit's URI and index are
; made once, when it first has a symbol to place.
(pub :: lspViewSymsImported (-> Int (Vec String) String String String (Vec Int) Int))

;@axiom:effect(io)
(pub fn (lspViewSymsImported out seen query path src decls)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      0
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
        (n (vecLen allDecls))
        (uuris vecNew)
        (uixs vecNew)
        (mut i 0)
      )
        {
          (while (< i (vecLen units))
            {
              (vecPush uuris "")
              (vecPush uixs 0)
              (set i (+ i 1))
            })
          (set i 0)
          (while (if (< i n)
            (< (jsonArrLen out) LSP_COMPL_MAX)
            false
          )
            (let ((d (vecGet allDecls i)))
              {
                (if (&& (lspWantsSymbol (nodeTag d)) (&& (!= (nodeModule d) 0) (!= (nodeSpan d) 0)))
                  (let ((bare (bareOf (nodeAName d))))
                    (if (lspViewDeclWants d bare query)
                      (let ((u (lspUnitOf units (nodeModule d))))
                        (if (< u 0)
                          0
                          (let ((unit (vecGet units u)))
                            {
                              (lspViewUnitPrep uuris uixs unit u)
                              (lspViewSymOffer out seen query (vecGetStr uuris u) (memGetWordStr unit 1) (vecGetVec uixs u) bare (lspSymKind (nodeTag d)) (nodeSpan d) (memGetWordStr unit 2))
                              (if (== (nodeTag d) TAG_D_DATA)
                                (lspViewSymCtors out seen query (vecGetStr uuris u) (memGetWordStr unit 1) (vecGetVec uixs u) (nodeBVec d) (memGetWordStr unit 2))
                                0
                              )
                            }
                          )
                        )
                      )
                      0
                    )
                  )
                  0
                )
                (set i (+ i 1))
              }
            ))
          0
        }
      )
    )
  )
)

; Whether a declaration has anything to list for `query`: its own
; name, or - for a `data` - one of its constructors' names.
(pub :: lspViewDeclWants (-> Int String String Bool))

(pub fn (lspViewDeclWants d bare query)
  (if (lspStrHasFold bare query)
    true
    (if (== (nodeTag d) TAG_D_DATA)
      (lspViewCtorsWant (nodeBVec d) query)
      false
    )
  )
)

(pub :: lspViewCtorsWant (-> (Vec Int) String Bool))

(pub fn (lspViewCtorsWant ctors query)
  (let (
    (mut i 0)
    (mut found 0)
  )
    {
      (while (if (< i (vecLen ctors))
        (== found 0)
        false
      )
        {
          (if (lspStrHasFold (nodeAName (vecGet ctors i)) query)
            (set found 1)
            0
          )
          (set i (+ i 1))
        })
      (== found 1)
    }
  )
)

; The URI and line index of unit `u`, made on first use.
(pub :: lspViewUnitPrep (-> (Vec String) (Vec Int) Int Int Int))

;@axiom:effect(io)
(pub fn (lspViewUnitPrep uuris uixs unit u)
  (if (== (vecGet uixs u) 0)
    {
      (vecSet uuris u (lspPathToUri (memGetWordStr unit 0)))
      (vecSet uixs u (cast Int (lspLineIndex (memGetWordStr unit 1))))
      0
    }
    0
  )
)

(pub :: lspViewSymCtors (-> Int (Vec String) String String String (Vec Int) (Vec Int) String Int))

(pub fn (lspViewSymCtors out seen query uri src ix ctors container)
  (let ((mut i 0))
    {
      (while (if (< i (vecLen ctors))
        (< (jsonArrLen out) LSP_COMPL_MAX)
        false
      )
        (let ((c (vecGet ctors i)))
          {
            (if (!= (nodeSpan c) 0)
              (lspViewSymOffer out seen query uri src ix (nodeAName c) 22 (nodeSpan c) container)
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; One SymbolInformation, when `name` holds the query and the
; declaration at `uri`:`span` has not been listed already.
(pub :: lspViewSymOffer (-> Int (Vec String) String String String (Vec Int) String Int Int String Int))

(pub fn (lspViewSymOffer out seen query uri src ix name kind span container)
  (if (>= (jsonArrLen out) LSP_COMPL_MAX)
    0
    (if (lspStrHasFold name query)
      (let ((key (strConcat uri (strConcat "#" (decStr (spanStart span))))))
        (if (lspSeenHas seen key)
          0
          (let ((base (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr name)) "kind" (jsonNum kind)) "location" (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRangeIx src ix span)))))
            {
              (vecPush seen key)
              (jsonArrPush
                out                (if (== (strLen container) 0)
                  base
                  (jsonObjPut base "containerName" (jsonStr container))
                )
              )
              0
            }
          )
        )
      )
      0
    )
  )
)

; Case-insensitive substring, ASCII-folded: `TWI` is in `twice`. An
; empty needle is in everything, which is what an empty query means.
(pub :: lspStrHasFold (-> String String Bool))

(pub fn (lspStrHasFold hay needle)
  (let (
    (hn (strLen hay))
    (nn (strLen needle))
    (mut i 0)
    (mut found 0)
  )
    {
      (while (if (== found 0)
        (<= (+ i nn) hn)
        false
      )
        {
          (if (lspViewFoldEqAt hay i needle nn)
            (set found 1)
            0
          )
          (set i (+ i 1))
        })
      (== found 1)
    }
  )
)

(pub :: lspViewFoldEqAt (-> String Int String Int Bool))

(pub fn (lspViewFoldEqAt hay at needle nn)
  (let (
    (mut k 0)
    (mut same 1)
  )
    {
      (while (if (== same 1)
        (< k nn)
        false
      )
        {
          (if (== (lspViewFoldByte (strByte hay (+ at k))) (lspViewFoldByte (strByte needle k)))
            0
            (set same 0)
          )
          (set k (+ k 1))
        })
      (== same 1)
    }
  )
)

(pub :: lspViewFoldByte (-> Int Int))

(pub fn (lspViewFoldByte b)
  (if (&& (>= b 65) (<= b 90))
    (+ b 32)
    b
  )
)

; ==================================================================
; END SECTION VIEW
; ==================================================================

; ==================================================================
; SECTION FIX: formatting, code actions, macro expansion, code
; lenses, type definition, diagnostics for imported modules
; ==================================================================
; The requests that CHANGE or RUN code from the editor: the formatter
; as one whole-document edit, the compiler's machine-applicable fixes
; as quickfixes beside a signature assist, a `Run` lens on `main`, type
; definition, and `axiom/expandMacro` - the analogue of
; `rust-analyzer/expandMacro`, and the reason the AST printer at the
; end of this section exists: nothing else in the compiler turns a
; node back into source.
;
; TWO OF THESE EXPAND, and MAC-TOOL-3 is why that is said first.
; `codeAction` and `expandMacro` run the pipeline `lspCheckDoc` runs -
; preflight, `resolveImports`, `expandProgram`, `lowerImpls`, and for
; code actions the checker - because a quickfix IS a checker
; diagnostic and an expansion IS the expander's output; neither can be
; read off the raw tree. Neither is a per-keystroke request either: a
; client asks for code actions when the cursor rests and for an
; expansion on demand, and each costs about one `didOpen` of the same
; document, which the editor paid on the last keystroke anyway.
; `formatting`, `codeLens` and `typeDefinition` read the raw tree and
; expand nothing.
;
; `textDocument/rangeFormatting` is deliberately NOT offered: the
; formatter is whole-document - `fmtFormat` proves its output a fixed
; point of the whole file - and a range cut out of that output would
; be a different formatter with a weaker proof.
;
(pub :: lspFixHandles (-> String Bool))

(pub fn (lspFixHandles method) (|| (strEq method "textDocument/formatting") (|| (strEq method "textDocument/codeAction") (|| (strEq method "textDocument/typeDefinition") (|| (strEq method "textDocument/codeLens") (strEq method "axiom/expandMacro"))))))

(pub :: lspFixDispatch (-> String Int Int (Vec String) (Vec a) Int))

;@axiom:effect(io)
(pub fn (lspFixDispatch method id params uris texts)
  (let ((uri (lspParamsUri params)))
    (let ((src (docText uris texts uri)))
      (if (strEq method "textDocument/formatting")
        (lspReply id (lspFormatting src))
        (if (strEq method "textDocument/codeAction")
          (lspReply id (lspCodeAction src uri params))
          (if (strEq method "textDocument/typeDefinition")
            (lspReply id (lspTypeDefinition src uri params))
            (if (strEq method "textDocument/codeLens")
              (lspReply id (lspCodeLens src uri))
              (lspReply id (lspExpandMacro src uri params))
            )
          )
        )
      )
    )
  )
)

; `codeActionProvider` is an object rather than a boolean so a client
; can see which kinds are on offer before it asks; `codeLensProvider`
; says every lens is complete as sent, for the reason
; `completionProvider` says the same of its items; `expandMacro` rides
; under `experimental` because it is not a protocol method, which is
; where rust-analyzer advertises its own.
(pub :: lspFixCaps (-> Int Int))

(pub fn (lspFixCaps caps) (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut caps "documentFormattingProvider" (jsonBool 1)) "codeActionProvider" (jsonObjPut jsonObj "codeActionKinds" (jsonArrPush (jsonArrPush (jsonArrPush jsonArr (jsonStr "quickfix")) (jsonStr "refactor.rewrite")) (jsonStr "refactor.extract")))) "typeDefinitionProvider" (jsonBool 1)) "codeLensProvider" (jsonObjPut jsonObj "resolveProvider" (jsonBool 0))) "experimental" (jsonObjPut jsonObj "expandMacro" (jsonBool 1))))

; ------------------------------------------------------------------
; `textDocument/formatting`: the formatter's output as ONE edit over
; the whole document.
;
; `fmtFormat` is the function `axiom fmt` runs, so what the editor
; writes is byte for byte what the command would have written - the
; gate formats a copy of its document with the command and holds the
; edit's text equal to the file. A refusal - a document that does not
; parse, or an output the formatter could not prove a fixed point - is
; null, the protocol's "nothing to do here" and what a half-typed file
; gets; an already-formatted document is an empty list, so the client
; writes nothing. Pure: the formatter takes a string and answers one.
; ------------------------------------------------------------------
(pub :: lspFormatting (-> String Int))

(pub fn (lspFormatting src)
  (let ((r (fmtFormat src)))
    (if (== (fzOk r) 0)
      jsonNull
      (let ((text (fzText r)))
        (if (strEq text src)
          jsonArr
          (let ((ix (lspLineIndex src)))
            (jsonArrPush jsonArr (jsonObjPut (jsonObjPut jsonObj "range" (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix 0)) "end" (lspPosIx src ix (strLen src)))) "newText" (jsonStr text)))
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The expansion pipeline, once, for the two requests that need it.
;
; This is `lspCheckDoc`'s call order - preflight, `resolveImports`,
; `expandProgram`, `lowerImpls` - with the DIAGNOSTIC HANDLES kept
; rather than rendered, and `expandProgram`'s answer kept too: the
; (name, macro) pairs of every declaration phase D generated, which is
; what `expandMacro` attributes its output by and what `axiom symbols`
; reads for `#generated=`. Answers 0 when an import cannot be read -
; the resolver would exit the process on one, see `lspPreflight` - and
; otherwise a five-word block: 0 the merged declaration list, 1 the
; unit table, 2 the expansion diagnostics, 3 `gens`, 4 the frame table
; `expAttachFrames` wants. The checker is NOT run here: one caller
; refuses to run it and the other decides after reading word 2.
; ------------------------------------------------------------------
(pub :: lspFixExpand (-> String String (Vec Int) Int))

;@axiom:effect(io)
(pub fn (lspFixExpand path src decls)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      0
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
        (ftbl vecNew)
        (eds vecNew)
      )
        (let ((gens (expandProgram
          decls          allDecls          eds          ftbl          units          (memGetWordVec r 2)          (memGetWordVec r 3)          (memGetWordVec r 4)
        )))
          (let ((b (memAlloc 40)))
            {
              (memSetWord b 0 allDecls)
              (memSetWord b 1 units)
              (memSetWord b 2 eds)
              (memSetWord b 3 gens)
              (memSetWord b 4 ftbl)
              b
            }
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/codeAction`: the fixes the compiler already knows how
; to make, and one assist it can make from what the checker inferred.
;
; QUICKFIXES ARE THE DIAGNOSTICS' OWN. A help whose fix span is not 0
; is a machine-applicable fix - what AXDL prints after `~>` - and it is
; offered exactly as the diagnostic carries it: the title is the help's
; text, the edit replaces the FIX span with the fix text, and the fix
; span is not always the diagnostic's anchor. AX3012 anchors on the
; `set` and fixes the BINDER three lines up with `mut x`; the gate
; derives that binder's range from the document and holds the edit to
; it. AX3001's typo suggestion and AX3003's constructor suggestion fix
; the reference itself. Nothing here decides what a fix is: a code that
; gains one in `typecheck.ax` gains a quickfix here without a line
; changing.
;
; THE ASSIST is "Add type signature for `f`", for a `fn` in this
; document with no `::` of its name, and the type it writes is the one
; the checker inferred - `tcFns` word 1, the same entry `axiom symbols`
; prints, so `symbols` is the reference an implementer checks this
; against. Written in the PARSER's spelling, `(-> Int Int)`, not the
; checker's `(Int -> Int)`: `tyRender` writes the latter and
; `parseTypeParens` refuses it (probed: AX2001 at the arrow), and an
; assist that inserts a line the compiler then rejects is worse than
; none. It is refused when the inferred type has an unknown part; a
; type variable the checker could not generalise is offered as
; `symbols` would print it, and is that function's business.
;
; Both halves need the pipeline `lspCheckDoc` runs. Expansion's
; refusals keep the checker from running, for the reason that function
; gives: the tree it gave up on is one the checker has died on.
;
; THREE MORE, added 2026-08-29 and described at their own banner
; below: an import for an AX3001 name another module declares, `pub`
; for an AX3023 name, and an extraction to a `let`. The first two
; hang off the same diagnostic list the quickfixes read; the third
; reads the WRITTEN tree and is asked BEFORE the pipeline runs,
; because phase D rewrites the declaration list in place - an
; invocation becomes its first product - and NAV's occurrence walk
; over a rewritten list would anchor binders at bytes a product
; copied from its template. It is pushed last so a client that shows
; actions in the order sent keeps the compiler's fixes first.
; ------------------------------------------------------------------
(pub :: lspCodeAction (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspCodeAction src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonArr
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
      )
        (let (
          (want (lspRangeSpan src ix (jsonGet params "range")))
          (rawVis (lspWrittenVis decls))
        )
          (let (
            (extract (lspExtractAction src uri decls ix want))
            (path (lspUriToPath uri))
            (out jsonArr)
          )
            (let ((ex (lspFixExpand path src decls)))
              {
                (if (== ex 0)
                  0
                  (let ((eds (memGetWordVec ex 2)))
                    (let ((tc
                      (if (> (countErrorDiags eds) 0)
                        0
                        (checkModuleTc decls (memGetWordVec ex 0) (memGetWordVec ex 1))
                      )
                    ))
                      (let ((ds
                        (if (== tc 0)
                          (orderDiags eds)
                          (orderDiags
                            (expMergeInto
                              eds                              (let ((cds (tcOutVec tc)))
                                {
                                  (expAttachFrames cds (memGetWordVec ex 4) (memGetWordVec ex 1))
                                  cds
                                }
                              )
                            )
                          )
                        )
                      ))
                        {
                          (lspQuickfixes out ds src uri ix want)
                          (if (== tc 0)
                            0
                            (lspSigAssists out decls rawVis (lspViewSigIndex decls) (lspFixEntryIndex (tcFnsVec tc)) src uri ix want)
                          )
                          (lspNameAssists out ds src uri ix want decls path (memGetWordVec ex 0) (memGetWordVec ex 1))
                          0
                        }
                      )
                    )
                  )
                )
                (if (== extract 0)
                  0
                  (jsonArrPush out extract)
                )
                out
              }
            )
          )
        )
      )
    )
  )
)

; The bytes a `range` parameter covers, as a span. A request with no
; range - which a client may send - means the whole document.
(pub :: lspRangeSpan (-> String (Vec Int) Int Int))

(pub fn (lspRangeSpan src ix range)
  (if (== range 0)
    (mkSpan 0 (strLen src))
    (let (
      (s (jsonGet range "start"))
      (e (jsonGet range "end"))
    )
      (mkSpan
        (if (== s 0)
          0
          (lspOffsetOf src ix s)
        )        (if (== e 0)
          (strLen src)
          (lspOffsetOf src ix e)
        )
      )
    )
  )
)

; Whether a non-zero span touches the requested bytes. INCLUSIVE at
; both ends, because a code action request is usually an empty range
; at the caret, and a caret resting just after a name is asking about
; that name.
(pub :: lspSpanMeets (-> Int Int Bool))

(pub fn (lspSpanMeets sp want)
  (if (== sp 0)
    false
    (&& (<= (spanStart sp) (spanEnd want)) (>= (spanEnd sp) (spanStart want)))
  )
)

; Only this document's diagnostics - `diagUnit` 0 - are asked, for the
; reason `lspCheckDoc` publishes only those: a fix into an imported
; module's bytes is an edit to a file the request did not name.
(pub :: lspQuickfixes (-> Int (Vec Int) String String (Vec Int) Int Int))

(pub fn (lspQuickfixes out ds src uri ix want)
  (let (
    (n (vecLen ds))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((d (vecGet ds i)))
          {
            (if (== (diagUnit d) 0)
              (lspQuickfixesOf out d src uri ix want)
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

(pub :: lspQuickfixesOf (-> Int Int String String (Vec Int) Int Int))

(pub fn (lspQuickfixesOf out d src uri ix want)
  (let (
    (n (diagHelpCount d))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((fsp (diagHelpFixSpan d i)))
          {
            (if (&& (!= fsp 0) (|| (lspSpanMeets (diagSpan d) want) (lspSpanMeets fsp want)))
              (jsonArrPush out (lspQuickfixJson d i fsp src uri ix))
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; `isPreferred` because a fix the compiler wrote is the fix; an editor
; binds its "apply preferred fix" key to exactly this flag.
(pub :: lspQuickfixJson (-> Int Int Int String String (Vec Int) Int))

(pub fn (lspQuickfixJson d i fsp src uri ix) (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr (diagHelpMsg d i))) "kind" (jsonStr "quickfix")) "diagnostics" (jsonArrPush jsonArr (lspDiagJson d src ix uri))) "isPreferred" (jsonBool 1)) "edit" (lspEditJson uri (lspRangeIx src ix fsp) (diagHelpFixText d i))))

; A `WorkspaceEdit` of one `TextEdit` in one document.
(pub :: lspEditJson (-> String Int String Int))

(pub fn (lspEditJson uri range text) (jsonObjPut jsonObj "changes" (jsonObjPut jsonObj uri (jsonArrPush jsonArr (jsonObjPut (jsonObjPut jsonObj "range" range) "newText" (jsonStr text))))))

; The visibility each declaration was WRITTEN with - `nodeVis` for a
; spanned `fn`, -1 for everything else - taken BEFORE the pipeline
; runs, because it does not survive it: `resolveImports` stamps every
; written entry declaration `pub` in place (expand.ax records that
; in its phase D header, and a probe of the assist on `(fn (twice x)
; ...)` wrote `(pub :: twice ...)`). The list is positional, and stays
; aligned with `decls` because phase D overwrites in place and appends
; after; a product that overwrote an invocation is at an index this
; list marks -1, so no assist is offered for a generated fn - its
; "form" would be the invocation's.
(pub :: lspWrittenVis (-> (Vec Int) (Vec Int)))

(pub fn (lspWrittenVis decls)
  (let (
    (out vecNew)
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((d (vecGet decls i)))
          {
            (vecPush
              out              (if (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0))
                (nodeVis d)
                (- 0 1)
              )
            )
            (set i (+ i 1))
          }
        ))
      out
    }
  )
)

; The cheap question first, in the order the questions cost: was it a
; written `fn` (one word), does its form open at or before the range's
; end (a scan back over `(pub fn (` to the column-zero paren - the
; FORM's start and not the name's, because a caret at column 0 of the
; fn's own line is inside the form and five bytes before the name),
; does the form reach the range (a scan of that form), has it a
; signature, what did the checker infer. The last two are INDEX
; lookups - `sigs` over this document's `::` declarations, `entries`
; over `tcFns` - and were walks: a whole-document range on the
; gate's 2,000-declaration document measured 1.34x the `didOpen` with
; every signature grouped at the top (2,000 walks of 4,000
; declarations) and 1.87x with no signatures at all (2,000 walks of
; the checker's table), against 0.72x for a one-line range.
(pub :: lspSigAssists (-> Int (Vec Int) (Vec Int) (Vec Int) (Vec Int) String String (Vec Int) Int Int))

(pub fn (lspSigAssists out decls rawVis sigs entries src uri ix want)
  (let (
    (n (vecLen rawVis))
    (mut i 0)
  )
    {
      (while (< i n)
        (let (
          (d (vecGet decls i))
          (vis (vecGet rawVis i))
        )
          {
            (if (&& (>= vis 0) (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0)))
              (let ((o (lspFormStart src (spanStart (nodeSpan d)))))
                (if (&& (<= o (spanEnd want)) (>= (lspFormEnd src o) (spanStart want)))
                  (if (!= (lspViewIdxFind sigs (nodeAName d)) 0)
                    0
                    (let ((e (lspFixEntryFind entries (nodeAName d))))
                      (if (== e 0)
                        0
                        (let ((ty (memGetWord e 1)))
                          (if (lspTyKnown ty)
                            (jsonArrPush out (lspSigAssistJson d vis ty src uri ix o))
                            0
                          )
                        )
                      )
                    )
                  )
                  0
                )
              )
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; The checker's entries by name: word 0 the name, word 1 the type
; node - inferred when the function has no signature, which is the
; only case this is asked about. The same bucket table the hint
; request keys its `fn` index by, and its own find, because an entry
; is not a node and has no module word to prefer by.
(pub :: lspFixEntryIndex (-> (Vec Int) (Vec a)))

(pub fn (lspFixEntryIndex fns)
  (let (
    (idx lspViewIdxNew)
    (n (vecLen fns))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (lspViewIdxAdd idx (memGetWordStr (vecGet fns i) 0) (vecGet fns i))
          (set i (+ i 1))
        })
      idx
    }
  )
)

(pub :: lspFixEntryFind (-> (Vec Int) String Int))

(pub fn (lspFixEntryFind idx name)
  (let ((bucket (vecGetVec idx (lspViewIdxSlot name))))
    (if (== (cast Int bucket) 0)
      0
      (let (
        (n (vecLen bucket))
        (mut i 0)
        (mut found 0)
      )
        {
          (while (if (< i n)
            (== found 0)
            false
          )
            {
              (if (strEq (vecGetStr bucket i) name)
                (set found (vecGet bucket (+ i 1)))
                0
              )
              (set i (+ i 2))
            })
          found
        }
      )
    )
  )
)

; The signature goes on its own line directly above the form, at the
; form's own column - which is 0 for every declaration `lspFormStart`
; found by its column-zero rule, and is where this language writes a
; `::`: between the paragraph and the `fn`, so hover's paragraph rule
; keeps working on the result.
(pub :: lspSigAssistJson (-> Int Int Int String String (Vec Int) Int Int))

(pub fn (lspSigAssistJson d vis ty src uri ix o)
  (let ((name (nodeAName d)))
    (let ((text (strConcat
      (strConcat
        (strConcat
          (if (== vis 1)
            "(pub :: "
            "(:: "
          )          name
        )        " "
      )      (strConcat (lspRenderTypeR ty (lspFreshRenames ty)) ")\n")
    )))
      (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr (strConcat (strConcat "Add type signature for `" name) "`"))) "kind" (jsonStr "refactor.rewrite")) "edit" (lspEditJson uri (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix o)) "end" (lspPosIx src ix o)) text))
    )
  )
)

; ------------------------------------------------------------------
; Three assists the compiler does not write, and what each one reads.
;
; IMPORT A NAME - `quickfix`, on an AX3001 whose reference is a bare
; name. The name is looked for as a `pub` declaration in every module
; the resolver could reach: the directories `moduleSearchDirs`
; answers, in its order - the entry file's own, the manifest's
; `depend` dirs, `AXIOM_PATH`, `AXIOM_STDLIB` - each walked three
; levels down, because a nested `Sys/Platform.darwin.ax` is a module
; too. A file is a candidate under the name the resolver would give
; it (`Sys.Platform`, the platform suffix folded through
; `targetOsSuffix`), and it counts only when `moduleSrcPath` resolves
; that name to THIS file - which is the ladder's own shadowing rule,
; asked rather than restated: a `Str.ax` beside the entry file hides
; the stdlib's. The cheap question first: the file's bytes must spell
; the name as a whole word before it is lexed and parsed, because a
; parse is the expensive step and a file that never writes the name
; cannot declare it. One action per module found, titled
; ``Import `name` from `Mod` ``; its edit adds the name to an existing
; `(import Mod (...))` list, else writes `(import Mod (name))` on its
; own line after the last import, else at the top of the file. Nothing
; is kept across requests - the arena rule. Measured with the stdlib on
; `AXIOM_STDLIB` and a five-file entry directory: 0.035 s for the
; whole request against 0.004 s without the search, on a document too
; small to time `didOpen` on; the walk is one `sysReadDir` per
; directory, one read per `.ax` file, and a parse per file that
; spells the name.
;
; MAKE A NAME PUBLIC - `quickfix`, on AX3023. The diagnostic names
; the module and the name in backticks, in either order (the checker
; has two sites: the import's name list, and the reference itself),
; so both readings are tried against the merged declaration list and
; the one that finds a declaration in that module wins. The
; declaration's WRITTEN visibility is read from its own file's bytes -
; `resolveImports` overwrites `nodeVis` with "exported", which says
; whether the import's list admits the name, not whether `pub` was
; written. Measured: `check` needs BOTH the `fn` and its `::` to be
; `pub` (either alone still reports AX3023), so the edit inserts
; `pub ` after the opening paren of each, in the module's own file -
; a `WorkspaceEdit` keyed by that file's URI. A name written `pub`
; that AX3023 still reports is one the document's import list left
; out - measured: `(import M (a))` beside a call of the exported `b`
; reports `` `b` is private to module `M` `` - and the honest edit is
; then the import list's, offered under the import title.
;
; EXTRACT TO `let` - `refactor.extract`, on a range and no diagnostic.
; The range, trimmed of whitespace, must be EXACTLY one item of the
; document - a form to its closer, a brace block, a literal or an
; identifier, by VIEW's item scanner - inside the body of a `fn` of
; this document. The item is found by descending from the body
; through the item that holds it at each level; the STATEMENT it is
; hoisted above is the innermost item on that path that is a direct
; child of a `{ }` block, else the body itself. What is hoisted must
; be evaluated exactly once, unconditionally, whenever the statement
; is, so every form strictly between the statement and the item must
; be one whose argument at that position is: any call; the test of an
; `if`, the scrutinee of a `match`, the first operand of `&&` or
; `||`; the body of a `let`, the value of a `set`, the operand of a
; `cast` or `alloc`; a field of a `struct` construction. A `lambda`,
; `while`, `cond` or `handle` between them, a head position, or a
; binding list refuses. Then NAV's occurrence walk: every local
; reference inside the item must be bound OUTSIDE the statement (or
; inside the item), or the binding would be out of scope at the new
; site - `(let ((y 1)) (+ y 2))` does not extract `(+ y 2)`. The
; binder is `extracted`, or `extracted2`, `extracted3` ... past every
; name the document spells. The statement is replaced by `(let ((x
; E)) S')` with `x` for `E` in `S'`. What this changes on purpose: the
; item now runs before whatever the statement evaluated ahead of it.
; ------------------------------------------------------------------
(pub :: lspNameAssists (-> Int (Vec Int) String String (Vec Int) Int (Vec Int) String (Vec Int) (Vec Int) Int))

;@axiom:effect(io)
(pub fn (lspNameAssists out ds src uri ix want decls path allDecls units)
  (let (
    (n (vecLen ds))
    (seen vecNew)
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((d (vecGet ds i)))
          {
            (if (&& (== (diagUnit d) 0) (lspSpanMeets (diagSpan d) want))
              (if (strEq (diagCode d) "AX3001")
                (lspImportAssists out d src uri ix decls path seen)
                (if (strEq (diagCode d) "AX3023")
                  (lspPublicAssist out d src uri ix decls allDecls units seen)
                  0
                )
              )
              0
            )
            (set i (+ i 1))
          }
        ))
      0
    }
  )
)

; A CodeAction carrying one diagnostic and one WorkspaceEdit.
(pub :: lspFixActionJson (-> String String Int String String (Vec Int) Int Int))

(pub fn (lspFixActionJson title kind d src uri ix edit) (jsonObjPut (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr title)) "kind" (jsonStr kind)) "diagnostics" (jsonArrPush jsonArr (lspDiagJson d src ix uri))) "edit" edit))

; One zero-width TextEdit at byte `at` of the text `ix` indexes.
(pub :: lspFixTextEdit (-> String (Vec Int) Int String Int))

(pub fn (lspFixTextEdit text ix at s) (jsonObjPut (jsonObjPut jsonObj "range" (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx text ix at)) "end" (lspPosIx text ix at))) "newText" (jsonStr s)))

; The same, as a whole WorkspaceEdit in `uri`.
(pub :: lspFixInsert (-> String String (Vec Int) Int String Int))

(pub fn (lspFixInsert uri src ix at s) (jsonObjPut jsonObj "changes" (jsonObjPut jsonObj uri (jsonArrPush jsonArr (lspFixTextEdit src ix at s)))))

(pub :: lspFixImportTitle (-> String String String))

(pub fn (lspFixImportTitle mod name) (strConcat (strConcat (strConcat "Import `" name) "` from `") (strConcat mod "`")))

; The name AX3001 reports is the reference's own bytes; a qualified
; `Mod::name` spans its first segment alone, and names its module
; already, so it is not this assist's question.
(pub :: lspImportAssists (-> Int Int String String (Vec Int) (Vec Int) String (Vec String) Int))

;@axiom:effect(io)
(pub fn (lspImportAssists out d src uri ix decls path seen)
  (let ((sp (diagSpan d)))
    (if (== sp 0)
      0
      (let ((name (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp)))))
        (if (|| (== (strLen name) 0) (lspFixIsQualified src (spanEnd sp)))
          0
          (let (
            (mods (lspFixSearch name path))
            (mut i 0)
          )
            {
              (while (< i (vecLen mods))
                {
                  (lspImportOffer out d src uri ix decls (vecGetStr mods i) name seen)
                  (set i (+ i 1))
                })
              0
            }
          )
        )
      )
    )
  )
)

(pub :: lspFixIsQualified (-> String Int Bool))

(pub fn (lspFixIsQualified src e) (&& (< (+ e 1) (strLen src)) (&& (== (strByte src e) 58) (== (strByte src (+ e 1)) 58))))

; One action per (module, name), whatever the number of diagnostics
; that asked for it - a whole-document range meets every one.
(pub :: lspImportOffer (-> Int Int String String (Vec Int) (Vec Int) String String (Vec String) Int))

(pub fn (lspImportOffer out d src uri ix decls mod name seen)
  (let ((key (strConcat mod (strConcat "$" name))))
    (if (>= (strVecIdx seen key) 0)
      0
      (let ((edit (lspImportEdit src uri ix decls mod name)))
        (if (== edit 0)
          0
          {
            (vecPush seen key)
            (jsonArrPush out (lspFixActionJson (lspFixImportTitle mod name) "quickfix" d src uri ix edit))
            0
          }
        )
      )
    )
  )
)

; The import edit, in this document: the name added to `Mod`'s
; existing list, else a new import line after the last one, else the
; first line of the file. A module imported WITHOUT a list already
; exports everything it can, so there is nothing to write - 0.
(pub :: lspImportEdit (-> String String (Vec Int) (Vec Int) String String Int))

(pub fn (lspImportEdit src uri ix decls mod name)
  (let ((imp (lspFixFindImport decls mod (- (vecLen decls) 1))))
    (if (!= imp 0)
      (if (== (vecLen (nodeBVec imp)) 0)
        0
        (let ((o (lspFormStart src (spanStart (nodeSpan imp)))))
          (let ((e (lspFormEnd src o)))
            (match (strFindByte src 40 (+ o 1))
              ((None) 0)
              ((Some lo)
                (if (>= lo e)
                  0
                  (lspFixInsert uri src ix (- (lspFormEnd src lo) 1) (strConcat " " name))
                ))
            )
          )
        )
      )
      (let ((last (lspFixLastImport decls (- (vecLen decls) 1))))
        (if (== last 0)
          (lspFixInsert uri src ix 0 (strConcat (lspFixImportLine mod name) "\n"))
          (lspFixInsert uri src ix (lspFormEnd src (lspFormStart src (spanStart (nodeSpan last)))) (strConcat "\n" (lspFixImportLine mod name)))
        )
      )
    )
  )
)

(pub :: lspFixImportLine (-> String String String))

(pub fn (lspFixImportLine mod name) (strConcat (strConcat "(import " mod) (strConcat (strConcat " (" name) "))")))

; This document's import of `mod`, last wins, or 0.
(pub :: lspFixFindImport (-> (Vec Int) String Int Int))

(pub fn (lspFixFindImport decls mod i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_IMPORT) (&& (!= (nodeSpan d) 0) (strEq (nodeAName d) mod)))
        d
        (lspFixFindImport decls mod (- i 1))
      )
    )
  )
)

(pub :: lspFixLastImport (-> (Vec Int) Int Int))

(pub fn (lspFixLastImport decls i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_IMPORT) (!= (nodeSpan d) 0))
        d
        (lspFixLastImport decls (- i 1))
      )
    )
  )
)

; ------------------------------------------------------------------
; The search: every module the resolver could reach that declares
; `name` `pub`, as a Vec of module names in the resolver's order.
; ------------------------------------------------------------------
(pub :: lspFixSearch (-> String String (Vec String)))

;@axiom:effect(io)
(pub fn (lspFixSearch name path)
  (let (
    (tcode (checkedTargetCode hostTarget))
    (entryDir (pathDir path))
    (found vecNew)
    (seen vecNew)
  )
    (let (
      (dirs (moduleSearchDirs entryDir))
      (mut i 0)
    )
      {
        (while (< i (vecLen dirs))
          {
            (lspFixScanDir (vecGetStr dirs i) "" "" 0 name path tcode entryDir found seen)
            (set i (+ i 1))
          })
        found
      }
    )
  )
)

; One directory, `rel` below the search root `dir`: every `.ax` entry
; is a candidate module `modPrefix` + its stem; every other entry that
; is a directory with a module-segment name is walked, three levels
; deep at most. Dot-files and dot-directories are skipped. A root of
; "" is the working directory - `moduleSearchDirs` pushes it for an
; entry file named with no directory - and is listed as `./`.
(pub :: lspFixScanDir (-> String String String Int String String Int String (Vec String) (Vec String) Int))

;@axiom:effect(io)
(pub fn (lspFixScanDir dir rel modPrefix depth name path tcode entryDir found seen)
  (let ((names (sysReadDir (strCStr (if (== (strLen dir) 0)
    (strConcat "./" rel)
    (strConcat dir rel)
  )))))
    (let (
      (n (vecLen names))
      (mut i 0)
    )
      {
        (while (< i n)
          (let ((nm (vecGetStr names i)))
            {
              (if (|| (== (strLen nm) 0) (== (strByte nm 0) 46))
                0
                (let ((full (strConcat dir (strConcat rel nm))))
                  (if (lspFixEndsWith nm ".ax")
                    (let ((stem (lspFixStemOf nm tcode)))
                      (if (== (strLen stem) 0)
                        0
                        (lspFixConsider full (strConcat modPrefix stem) name path tcode entryDir found seen)
                      )
                    )
                    (if (&& (< depth 3) (&& (lspFixIsSegment nm) (sysIsDir (strCStr full))))
                      (lspFixScanDir dir (strConcat rel (strConcat nm "/")) (strConcat modPrefix (strConcat nm ".")) (+ depth 1) name path tcode entryDir found seen)
                      0
                    )
                  )
                )
              )
              (set i (+ i 1))
            }
          ))
        0
      }
    )
  )
)

; The module stem of a file name, under this target's suffix ladder -
; `Platform.darwin.ax` is `Platform` on darwin and nothing on linux -
; or "" for a name the resolver could not be asked for.
(pub :: lspFixStemOf (-> String Int String))

(pub fn (lspFixStemOf nm tcode)
  (let ((stem
    (if (lspFixEndsWith nm (targetOsArchSuffix tcode))
      (lspFixDropEnd nm (strLen (targetOsArchSuffix tcode)))
      (if (lspFixEndsWith nm (targetOsSuffix tcode))
        (lspFixDropEnd nm (strLen (targetOsSuffix tcode)))
        (if (lspFixEndsWith nm ".ax")
          (lspFixDropEnd nm 3)
          ""
        )
      )
    )
  ))
    (if (lspFixIsSegment stem)
      stem
      ""
    )
  )
)

; A module-path segment: what `parseModPath` reads between the dots,
