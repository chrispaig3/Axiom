            ; plain expressions; the body from element 3 on is.
            (if (strEq head "parallel")
              (>= k 3)
            (if (|| (strEq head "fn") (|| (strEq head "lambda") (|| (strEq head "while") (|| (strEq head "cond") (|| (strEq head "handle") (|| (strEq head "quote") (|| (strEq head "pub") (strStartsWith head "syntax/"))))))))
              false
              true
