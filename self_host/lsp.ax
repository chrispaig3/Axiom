; ==================================================================
; SECTION FIX: formatting, code actions, macro expansion, code
; lenses, type definition, diagnostics for imported modules
; ==================================================================
(pub :: lspFixHandles (-> String Bool))

(pub fn (lspFixHandles method) false)

(pub :: lspFixDispatch (-> String Int Int Int Int Int))

;@axiom:effect(io)
(pub fn (lspFixDispatch method id params uris texts) (lspError id (- 0 32601) (strConcat "method not found: " method)))

(pub :: lspFixCaps (-> Int Int))

(pub fn (lspFixCaps caps) caps)

