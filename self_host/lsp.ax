        ))
      ok
    }
  )
)

(pub :: lspFixFreshName (-> (Vec Int) String))

(pub fn (lspFixFreshName occs)
  (let (
    (mut name "extracted")
    (mut k 2)
  )
    {
      (while (lspNavNamed occs name)
        {
          (set name (strConcat "extracted" (decStr k)))
          (set k (+ k 1))
        })
      name
    }
  )
)

(pub :: lspExtractJson (-> String String (Vec Int) Int Int Int Int String Int))

(pub fn (lspExtractJson src uri ix ws we fs fe name)
  (let ((parts vecNew))
    {
      (vecPush parts "(let ((")
      (vecPush parts name)
      (vecPush parts " ")
      (vecPush parts (strSlice src ws (- we ws)))
      (vecPush parts ")) ")
      (vecPush parts (strSlice src fs (- ws fs)))
      (vecPush parts name)
      (vecPush parts (strSlice src we (- fe we)))
      (vecPush parts ")")
      (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr "Extract to `let`")) "kind" (jsonStr "refactor.extract")) "edit" (lspEditJson uri (lspRangeIx src ix (mkSpan fs fe)) (catStrs parts)))
    }
  )
)

; ------------------------------------------------------------------
; `textDocument/typeDefinition`: the declaration of the TYPE of the
; name under the cursor.
;
; WHAT HAS A TYPE TO ASK ABOUT, from the raw tree, which records none
; per expression:
;
;   * a `fn` PARAMETER, when the cursor is inside the fn's header -
;     `(fn (area s) ...)` on `s` - is the k-th arrow position of the
;     fn's signature, `nthParamTy`. The header is recovered from
;     bytes: the parameter names carry no spans.
;   * a `fn` with a `::` signature - this document first, then the
;     imported modules, `definition`'s order - is the arrow's RESULT.
;   * a CONSTRUCTOR is its `data`, directly.
;
; A `let` binding has no answer: nothing in the frontend records what
; a local was inferred to be (typecheck.ax's scope entries die with the
; walk), and guessing is not this server's habit. Then the type: only
; a named constructor - `TAG_T_CON` - names a declaration, and only a
; `data`, `struct` or `type` alias of that name with a span is one.
; `Int`, a type variable, a tuple, a list, the prelude's spanless
; `Option`: null, which the protocol reads as "nothing here".
; ------------------------------------------------------------------
(pub :: lspTypeDefinition (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspTypeDefinition src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonNull
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
      )
        (let ((off (lspOffsetOf src ix (jsonGet params "position"))))
          (let ((wsp (lspWordSpan src off)))
            (if (== wsp 0)
              jsonNull
              (let ((w (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp)))))
                (let ((t (lspLocalTypeOf src decls off w)))
                  (if (!= t 0)
                    (lspTypeLocation (lspUriToPath uri) src uri decls "" t)
                    (let ((dat (lspFindCtorData decls w (- (vecLen decls) 1))))
                      (if (!= dat 0)
                        (lspLocationJson uri src (nodeSpan dat))
                        (lspTypeLocation (lspUriToPath uri) src uri decls w 0)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The type node this document alone can answer for the word at `off`:
; a parameter in the header the cursor is in, else a signed `fn`'s
; result. 0 when neither.
(pub :: lspLocalTypeOf (-> String (Vec Int) Int String Int))

(pub fn (lspLocalTypeOf src decls off w)
  (let ((p (lspParamTypeAt src decls off w)))
    (if (!= p 0)
      p
      (let ((d (lspFindDecl decls w (- (vecLen decls) 1))))
        (if (&& (!= d 0) (== (nodeTag d) TAG_D_FN))
          (let ((sig (lspFindSig decls w (- (vecLen decls) 1))))
            (if (== sig 0)
              0
              (lspArrowResult (nodeTy sig))
            )
          )
          0
        )
      )
    )
  )
)

; The fn whose HEADER holds `off`, and the type of the parameter `w`
; names in it. The header is the form opened by the `(` before the
; fn's name - `(fn (area s) ...)` puts the name's span on `area`, and
; the parameter list is that paren's form - so a cursor inside it is
; on a parameter and nowhere else. Its index is the parameter's
; position in the fn's own list, which is what `nthParamTy` counts.
(pub :: lspParamTypeAt (-> String (Vec Int) Int String Int))

(pub fn (lspParamTypeAt src decls off w)
  (let (
    (n (vecLen decls))
    (mut i 0)
    (mut found 0)
  )
    {
      (while (&& (< i n) (== found 0))
        (let ((d (vecGet decls i)))
          {
            (if (&& (== (nodeTag d) TAG_D_FN) (&& (!= (nodeSpan d) 0) (<= (spanStart (nodeSpan d)) off)))
              (let ((hs (lspHeaderOpen src (spanStart (nodeSpan d)))))
                (if (&& (>= hs 0) (< off (lspFormEnd src hs)))
                  (let ((k (strVecIdx (nodeBVec d) w)))
                    (if (< k 0)
                      0
                      (let ((sig (lspFindSig decls (nodeAName d) (- (vecLen decls) 1))))
                        (if (== sig 0)
                          0
                          {
                            (set found (nthParamTy (nodeTy sig) k 0))
                            0
                          }
                        )
                      )
                    )
                  )
                  0
                )
              )
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

; The `(` that opens the header whose first identifier starts at
; `nameStart`, skipping the blanks a hand-written header may carry
; between them; -1 when that byte is not a paren, which is the bare
; nullary form `(fn answer 42)` - it has no parameter list to be in.
(pub :: lspHeaderOpen (-> String Int Int))

(pub fn (lspHeaderOpen src nameStart)
  (let ((mut o (- nameStart 1)))
    {
      (while (if (> o 0)
        (lspIsBlank (strByte src o))
        false
      )
        (set o (- o 1)))
      (if (&& (>= o 0) (== (strByte src o) 40))
        o
        (- 0 1)
      )
    }
  )
)

; The RESULT of an arrow chain: `(-> A B C)` answers `C`, and a type
; that is not an arrow answers itself - `(:: main Int)`'s `Int`.
(pub :: lspArrowResult (-> Int Int))

(pub fn (lspArrowResult t)
  (if (== t 0)
    0
    (if (== (nodeTag t) TAG_T_ARR)
      (lspArrowResult (nodeB t))
      t
    )
  )
)

; The `data` declaring constructor `name` in this document, or 0.
(pub :: lspFindCtorData (-> (Vec Int) String Int Int))

(pub fn (lspFindCtorData decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_DATA) (&& (!= (nodeSpan d) 0) (!= (lspCtorIndex (nodeBVec d) name 0) (- 0 1))))
        d
        (lspFindCtorData decls name (- i 1))
      )
    )
  )
)

(pub :: lspCtorIndex (-> (Vec Int) String Int Int))

(pub fn (lspCtorIndex ctors name i)
  (if (>= i (vecLen ctors))
    (- 0 1)
    (if (strEq (nodeAName (vecGet ctors i)) name)
      i
      (lspCtorIndex ctors name (+ i 1))
    )
  )
)

; ------------------------------------------------------------------
; A CONSTRUCTOR IS A DECLARATION, and until 2026-09-03 three requests
; disagreed about that. `completion` offered `Circle`, `references`
; found every occurrence of it, `signatureHelp` rendered
; `(Circle Int)` for one an import brought in, `workspace/symbol`
; listed it at its own span and `typeDefinition` jumped to the `data`
; it belongs to - while `definition`, `declaration` and `hover`
; answered null on the same character. Measured 2026-09-03 over four
; files that declare ADTs (stdlib/Err.ax, tests/selfhost/745, /140,
; tests/lsp/060-outline.ax): 116 occurrences where `typeDefinition`
; found the `data` and `definition` said nothing.
;
; THE ANSWER IS THE CONSTRUCTOR'S OWN SPAN, not the `data`'s name.
; `(pub data Shape (Dot) (Circle Int))` puts both on one line, so an
; answer that landed on `Shape` would look right in an editor and be
; wrong. The ctor node carries its name's span from the parser, which
; is where `workspace/symbol` already publishes it.
;
; `typeDefinition` keeps answering the `data`, and that is not an
; inconsistency: the TYPE of `Circle` is `Shape`. The gate asks both
; requests at one position and requires the two answers to DIFFER.
;
; DECLARATION EQUALS DEFINITION HERE, which is step 3's rule already:
; a constructor is not written twice, so there is no `(:: ...)` for
; step 2 to have preferred.
;
; The lookups below are `lspFindCtorData`'s, split on which half of
; the merged declaration list they read - this document's own
; declarations (module 0) or the ones an import brought in. The ctor
; node inside is found by `lspViewCtorIn`, which SECTION VIEW wrote
; for `signatureHelp`: a constructor is NOT mangled by
; `resolveImports` even when its `data` is, so one comparison serves
; both halves.
;
; THE TWO HALVES ANSWER DIFFERENT KINDS OF NOTHING, because they sit
; at different places in a chain. The local one is a STEP - 0 means
; "not a constructor, carry on to the imports" - and the imported one
; is the LAST step, so it answers `jsonNull`, which is the protocol's
; "nothing here". Neither may answer a Location built on a span of 0:
; `lspRange` reads that as line one, and an editor would jump there.
; ------------------------------------------------------------------

; The imported `data` declaring constructor `name`, or 0. The module
; filter is on the DATA, which is the node `resolveImports`
; attributes; the constructors inside it carry no module of their own.
(pub :: lspFindCtorDataImported (-> (Vec Int) String Int Int))

(pub fn (lspFindCtorDataImported decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (== (nodeTag d) TAG_D_DATA) (&& (!= (nodeModule d) 0) (&& (!= (nodeSpan d) 0) (!= (lspCtorIndex (nodeBVec d) name 0) (- 0 1)))))
        d
        (lspFindCtorDataImported decls name (- i 1))
      )
    )
  )
)

; The constructor node `name` names inside `dat`, or 0 - and 0 also
; for one whose name carries no span, which is what the parser
; recovers from a half-written form.
(pub :: lspCtorNodeOf (-> Int String Int))

(pub fn (lspCtorNodeOf dat name)
  (if (== dat 0)
    0
    (let ((c (lspViewCtorIn (nodeBVec dat) name)))
      (if (== c 0)
        0
        (if (== (nodeSpan c) 0)
          0
          c
        )
      )
    )
  )
)

; A Location on the constructor `name` this document declares, or 0
; for "the word is not one of ours".
(pub :: lspCtorDefinition (-> String String (Vec Int) String Int))

(pub fn (lspCtorDefinition src uri decls name)
  (let ((c (lspCtorNodeOf (lspFindCtorData decls name (- (vecLen decls) 1)) name)))
    (if (== c 0)
      0
      (lspNavLocOf uri src (nodeSpan c))
    )
  )
)

; The same for an imported one, and the difference is which bytes the
; span indexes: the DECLARING file's, not the open document's. The
; unit table decides both the uri and the text `lspRange` counts lines
; in - `lspViewSymCtors` publishes constructors through exactly this
; pair. `jsonNull` on a miss, and on a `data` the resolver did not
; attribute to a unit, because this is the end of the chain.
(pub :: lspCtorDefinitionImported (-> (Vec Int) (Vec Int) String Int))

;@axiom:effect(io)
(pub fn (lspCtorDefinitionImported allDecls units name)
  (let ((dat (lspFindCtorDataImported allDecls name (- (vecLen allDecls) 1))))
    (let ((c (lspCtorNodeOf dat name)))
      (if (== c 0)
        jsonNull
        (let ((u (lspUnitOf units (nodeModule dat))))
          (if (< u 0)
            jsonNull
            (let ((unit (vecGet units u)))
              (lspNavLocOf (lspPathToUri (memGetWordStr unit 0)) (memGetWordStr unit 1) (nodeSpan c))
            )
          )
        )
      )
    )
  )
)

; The line hover puts under the fence. The `data`'s name is BARE, for
; the reason `lspViewSigCtor` reads a bare one: an imported `data` is
; `Shapes$Shape` in the merged list and nobody writes it that way.
(pub :: lspCtorNote (-> Int String String))

(pub fn (lspCtorNote dat name) (strConcat (strConcat (strConcat "constructor `" name) "` of `") (strConcat (bareOf (nodeAName dat)) "`")))

; Hover on a constructor an import brought in: the `data` quoted out
; of the DECLARING file, the module named, and the note saying which
; constructor. `range` is still the word in the document being edited,
; which is a different file - the same split `lspHoverImported` makes.
(pub :: lspHoverCtorImported (-> (Vec Int) (Vec Int) String Int Int))

(pub fn (lspHoverCtorImported allDecls units name range)
  (let ((dat (lspFindCtorDataImported allDecls name (- (vecLen allDecls) 1))))
    (if (== (lspCtorNodeOf dat name) 0)
      jsonNull
      (let ((u (lspUnitOf units (nodeModule dat))))
        (if (< u 0)
          jsonNull
          (let ((unit (vecGet units u)))
            (lspHoverAtNote (memGetWordStr unit 1) allDecls dat range (memGetWordStr unit 2) (lspCtorNote dat name))
          )
        )
      )
    )
  )
)

; `typeDefinition` on an imported constructor: the `data`'s own name
; span, in the file that declares it. This is the ONE request whose
; answer is the declaration rather than the constructor, because the
; type of `Circle` is `Shape`.
(pub :: lspTypeCtorImported (-> (Vec Int) (Vec Int) String Int))

;@axiom:effect(io)
(pub fn (lspTypeCtorImported allDecls units name)
  (let ((dat (lspFindCtorDataImported allDecls name (- (vecLen allDecls) 1))))
    (if (== (lspCtorNodeOf dat name) 0)
      jsonNull
      (let ((u (lspUnitOf units (nodeModule dat))))
        (if (< u 0)
          jsonNull
          (let ((unit (vecGet units u)))
            (lspLocationJson (lspPathToUri (memGetWordStr unit 0)) (memGetWordStr unit 1) (nodeSpan dat))
          )
        )
      )
    )
  )
)

; A declaration a TYPE name can land on: `data`, `struct` or `type`.
(pub :: lspIsTypeDecl (-> Int Bool))

(pub fn (lspIsTypeDecl tag) (|| (== tag TAG_D_DATA) (|| (== tag TAG_D_STRUCT) (== tag TAG_D_ALIAS))))

(pub :: lspFindTypeDecl (-> (Vec Int) String Int Int))

(pub fn (lspFindTypeDecl decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (lspIsTypeDecl (nodeTag d)) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        d
        (lspFindTypeDecl decls name (- i 1))
      )
    )
  )
)

; The same over the merged list, restricted to what an import brought
; in. Type names are NOT mangled by `resolveImports` - a `data` keeps
; its bare name in every module - so the comparison is exact rather
; than through `bareOf`.
(pub :: lspFindTypeImported (-> (Vec Int) String Int Int))

(pub fn (lspFindTypeImported decls name i)
  (if (< i 0)
    0
    (let ((d (vecGet decls i)))
      (if (&& (lspIsTypeDecl (nodeTag d)) (&& (!= (nodeModule d) 0) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0))))
        d
        (lspFindTypeImported decls name (- i 1))
      )
    )
  )
)

(pub :: lspLocationJson (-> String String Int Int))

(pub fn (lspLocationJson uri src span) (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRange src span)))

; The Location of type `t`'s declaration - or, when `t` is 0, of the
; result type of the imported fn `w` names. This document's own
; declarations are asked first, which is the language's shadowing rule
; and `lspDefinition`'s order; the imports are resolved only when they
; have to be, and once, whichever of the two questions is being asked.
(pub :: lspTypeLocation (-> String String String (Vec Int) String Int Int))

;@axiom:effect(io)
(pub fn (lspTypeLocation path src uri decls w t)
  (let ((local
    (if (== t 0)
      0
      (lspTypeLocalOf src uri decls t)
    )
  ))
    (if (!= local 0)
      local
      (lspTypeLocationImported path src uri decls w t)
    )
  )
)

; A `TAG_T_CON` naming a declaration in this document, or 0.
(pub :: lspTypeLocalOf (-> String String (Vec Int) Int Int))

(pub fn (lspTypeLocalOf src uri decls t)
  (if (!= (nodeTag t) TAG_T_CON)
    0
    (let ((d (lspFindTypeDecl decls (nodeAName t) (- (vecLen decls) 1))))
      (if (== d 0)
        0
        (lspLocationJson uri src (nodeSpan d))
      )
    )
  )
)

; The import preamble of `lspDefinitionImported`, verbatim, and then
; the two lookups it can answer: the result type of an imported signed
; `fn` when `t` is 0, and the module declaring a type name.
(pub :: lspTypeLocationImported (-> String String String (Vec Int) String Int Int))

;@axiom:effect(io)
(pub fn (lspTypeLocationImported path src uri decls w given)
  (let ((r (lspResolveFor path src decls)))
    (if (== r 0)
      jsonNull
      (let (
        (allDecls (memGetWordVec r 0))
        (units (memGetWordVec r 1))
      )
        (let ((t
          (if (!= given 0)
            given
            (let ((d (lspFindImported allDecls w (- (vecLen allDecls) 1))))
              (if (&& (!= d 0) (== (nodeTag d) TAG_D_FN))
                (let ((sig (lspFindSig allDecls (nodeAName d) (- (vecLen allDecls) 1))))
                  (if (== sig 0)
                    0
                    (lspArrowResult (nodeTy sig))
                  )
                )
                0
              )
            )
          )
        ))
          (if (== t 0)
            ; The last thing `w` can be: a constructor an import
            ; brought in, whose TYPE is the `data` that declares it.
            ; `lspTypeDefinition` asks the same question of this
            ; document before any import is resolved; this is the half
            ; that was missing, and it is why `signatureHelp` could
            ; render `(Circle Int)` at a position where this request
            ; answered null.
            (lspTypeCtorImported allDecls units w)
            (if (!= (nodeTag t) TAG_T_CON)
              jsonNull
              (let ((local (lspTypeLocalOf src uri decls t)))
                (if (!= local 0)
                  local
                  (let ((d (lspFindTypeImported allDecls (nodeAName t) (- (vecLen allDecls) 1))))
                    (if (== d 0)
                      jsonNull
                      (let ((u (lspUnitOf units (nodeModule d))))
                        (if (< u 0)
                          jsonNull
                          (let ((unit (vecGet units u)))
                            (lspLocationJson (lspPathToUri (memGetWordStr unit 0)) (memGetWordStr unit 1) (nodeSpan d))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; `textDocument/codeLens`: a `▶ Run` over `main`, and `Expand macro`
; over every `pub macro`.
;
; THE COMMANDS ARE THE CLIENT'S. A lens carries a command NAME and its
; arguments, and the server never runs one: a VS Code extension binds
; `axiom.run` to `axiom run <path>` in a terminal and
; `axiom.expandMacro` to an `axiom/expandMacro` request at the
; position given, which is exactly how rust-analyzer's `Run` lens
; works - the server says where, the editor does it. `Run` is offered
; for `(fn (main) ...)` alone, because that is what `axiom run` runs.
; The macro lens names the DECLARATION's position, and
; `lspExpandMacro` reads that position as "everything this macro
; generated in this document"; on an invocation it answers that
; invocation's own products. Raw tree, no expansion, no IO: the path
; is decoded from the URI the request named.
; ------------------------------------------------------------------
(pub :: lspCodeLens (-> String String Int))

(pub fn (lspCodeLens src uri)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonArr
      (let (
        (decls (memGetWordVec pr 1))
        (out jsonArr)
        (ix (lspLineIndex src))
        (n (vecLen (memGetWordVec pr 1)))
        (mut i 0)
      )
        {
          (while (< i n)
            (let ((d (vecGet decls i)))
              {
                (if (== (nodeSpan d) 0)
                  0
                  (if (&& (== (nodeTag d) TAG_D_FN) (&& (strEq (nodeAName d) "main") (== (vecLen (nodeBVec d)) 0)))
                    (jsonArrPush out (lspLensJson (lspRangeIx src ix (nodeSpan d)) "▶ Run" "axiom.run" (jsonArrPush jsonArr (jsonStr (lspUriToPath uri)))))
                    (if (&& (== (nodeTag d) TAG_D_MACRO) (== (nodeVis d) 1))
                      (jsonArrPush out (lspLensJson (lspRangeIx src ix (nodeSpan d)) "Expand macro" "axiom.expandMacro" (jsonArrPush (jsonArrPush jsonArr (jsonStr uri)) (lspPosIx src ix (spanStart (nodeSpan d))))))
                      0
                    )
                  )
                )
                (set i (+ i 1))
              }
            ))
          out
        }
      )
    )
  )
)

(pub :: lspLensJson (-> Int String String Int Int))

(pub fn (lspLensJson range title command args) (jsonObjPut (jsonObjPut jsonObj "range" range) "command" (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr title)) "command" (jsonStr command)) "arguments" args)))

; ------------------------------------------------------------------
; `axiom/expandMacro`: what a macro generated, as source.
;
; WHERE IT ANSWERS. On a TOP-LEVEL invocation - a `TAG_D_MACROCALL`,
; by its head's span or anywhere inside the form's bytes - it renders
; that invocation's own products; on a macro DECLARATION, by its name
; or its form, everything that macro generated in this document. An
; expression-position invocation inside a body is not answered: phase
; E rewrites the expression in place and records no product list, so
; there is nothing to attribute, and a position elsewhere is null.
;
; HOW A PRODUCT IS KNOWN. `expandProgram` rewrites the declaration
; list in place - the first product is copied INTO the invocation node
; (`expCopyDeclInto`, the same handle with a new tag), the rest are
; appended - and answers `gens`, the (name, macro) pairs of every
; declaration phase D made. So the expansion runs on a FRESH parse,
; leaving the first parse as the record of what was WRITTEN, and a
; declaration is a product by IDENTITY: a handle the list did not
; hold before expansion, or the invocation's own handle now carrying
; another tag. The first version asked by NAME - "not a name the
; written list has" - and a generated `impl` is named after its
; TRAIT, which the written list declares, so `(deriveEq Inner)`
; answered an empty expansion (measured on tests/selfhost/378).
;
; WHICH INVOCATION made it is NOT a question a span can answer. A
; product whose name was joined - `tagShape` from `(syntax/join tag
; T)` - has no token to point at and carries span 0, which is why
; `axiom symbols` prints `-` for its position; and `gens` is one flat
; list in generation order with no count per invocation. Measured:
; attributing by the invocation's own span, then by its form's byte
; extent, both answered an empty expansion for `(deriveTag Shape)`
; while the declaration answered its two products. So the fresh parse
; is expanded with every OTHER top-level invocation removed from the
; entry list first, and then everything phase D made is this
; invocation's - nested invocations it generated included, which is
; what "expand" means. What that leaves out is a macro whose template
; QUERIES declarations another invocation would have generated
; (`syntax/for` over the declaration list); that expansion is shown
; without them.
;
; An expansion the expander refused is null: the tree it gave up on
; is not one to show, and the refusal is already on screen as a
; diagnostic.
; ------------------------------------------------------------------
(pub :: lspExpandMacro (-> String String Int Int))

;@axiom:effect(io)
(pub fn (lspExpandMacro src uri params)
  (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
    (if (== (memGetWord pr 0) 0)
      jsonNull
      (let (
        (decls (memGetWordVec pr 1))
        (ix (lspLineIndex src))
      )
        (let ((site (lspMacroSiteAt src decls (lspOffsetOf src ix (jsonGet params "position")))))
          (if (< site 0)
            jsonNull
            (lspExpandAt (lspUriToPath uri) src decls site)
          )
        )
      )
    )
  )
)

; The INDEX of the invocation or macro declaration whose name or form
; holds `off`, or -1. The name is asked first because it is one
; comparison; the form is scanned only for a name the cursor is not
; on. An index rather than the node, because the same position in the
; fresh parse is how the invocation is found again.
(pub :: lspMacroSiteAt (-> String (Vec Int) Int Int))

(pub fn (lspMacroSiteAt src decls off)
  (let (
    (n (vecLen decls))
    (mut i 0)
    (mut found (- 0 1))
  )
    {
      (while (&& (< i n) (< found 0))
        (let ((d (vecGet decls i)))
          {
            (if (&& (|| (== (nodeTag d) TAG_D_MACROCALL) (== (nodeTag d) TAG_D_MACRO)) (!= (nodeSpan d) 0))
              (if (lspSpanHas (nodeSpan d) off)
                (set found i)
                (let ((o (lspFormStart src (spanStart (nodeSpan d)))))
                  (if (&& (>= off o) (< off (lspFormEnd src o)))
                    (set found i)
                    0
                  )
                )
              )
              0
            )
            (set i (+ i 1))
          }
        ))
      found
    }
  )
)

; The fresh parse's entry list with every top-level invocation but the
; one at `idx` left out, so what phase D makes of it is one
; invocation's expansion.
(pub :: lspKeepOneCall (-> (Vec Int) Int (Vec Int)))

(pub fn (lspKeepOneCall decls2 idx)
  (let (
    (out vecNew)
    (n (vecLen decls2))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (if (|| (== i idx) (!= (nodeTag (vecGet decls2 i)) TAG_D_MACROCALL))
            (vecPush out (vecGet decls2 i))
            (cast (Vec Int) 0)
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

(pub :: lspExpandAt (-> String String (Vec Int) Int Int))

;@axiom:effect(io)
(pub fn (lspExpandAt path src decls idx)
  (let (
    (site (vecGet decls idx))
    (pr2 (parseModuleWith (lex src) (scanAxtags src)))
  )
    (let (
      (byCall (== (nodeTag site) TAG_D_MACROCALL))
      (macName (nodeAName site))
    )
    (if (== (memGetWord pr2 0) 0)
      jsonNull
      (let ((decls2
        (if byCall
          (lspKeepOneCall (memGetWordVec pr2 1) idx)
          (memGetWordVec pr2 1)
        )
      ))
        (let (
          (before (lspDeclHandles decls2))
          (wasCall (lspDeclIsCall decls2))
        )
          (let ((ex (lspFixExpand path src decls2)))
            (if (== ex 0)
              jsonNull
              (if (> (countErrorDiags (memGetWordVec ex 2)) 0)
                jsonNull
                (let (
                  (gens (memGetWordVec ex 3))
                  (parts vecNew)
                  (n (vecLen decls2))
                  (mut i 0)
                )
                  {
                    (while (< i n)
                      (let ((g (vecGet decls2 i)))
                        {
                          (if (lspIsProductOf g i before wasCall gens macName byCall)
                            {
                              (if (> (vecLen parts) 0)
                                (vecPush parts "\n\n")
                                (cast (Vec String) 0)
                              )
                              (vecPush parts (lspRenderDecl g 0))
                              0
                            }
                            0
                          )
                          (set i (+ i 1))
                        }
                      ))
                    (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr macName)) "expansion" (jsonStr (catStrs parts)))
                  }
                )
              )
            )
          )
        )
      )
    )
    )
  )
)

; The handles the list holds before expansion, in order, and which of
; them are invocations - the two facts identity is judged against
; afterwards.
(pub :: lspDeclHandles (-> (Vec Int) (Vec Int)))

(pub fn (lspDeclHandles decls)
  (let (
    (out vecNew)
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (vecPush out (vecGet decls i))
          (set i (+ i 1))
        })
      out
    }
  )
)

(pub :: lspDeclIsCall (-> (Vec Int) (Vec Int)))

(pub fn (lspDeclIsCall decls)
  (let (
    (out vecNew)
    (n (vecLen decls))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (vecPush
            out            (if (== (nodeTag (vecGet decls i)) TAG_D_MACROCALL)
              1
              0
            )
          )
          (set i (+ i 1))
        })
      out
    }
  )
)

; A product: a declaration at index `i` that is NEW - appended past
; the original length, a handle the list did not hold there, or the
; invocation's own node rewritten to another tag - and not an empty
; form or an invocation still waiting. Under an invocation everything
; generated is its own (the list was cut down to it); under a
; declaration, what `gens` attributes to that macro.
(pub :: lspIsProductOf (-> Int Int (Vec Int) (Vec Int) (Vec Int) String Bool Bool))

(pub fn (lspIsProductOf g i before wasCall gens macName byCall)
  (if (|| (== (nodeTag g) TAG_NIL) (== (nodeTag g) TAG_D_MACROCALL))
    false
    (let ((fresh
      (if (>= i (vecLen before))
        true
        (if (!= (vecGet before i) g)
          true
          (== (vecGet wasCall i) 1)
        )
      )
    ))
      (if (lspNavNot fresh)
        false
        (if byCall
          true
          (let ((gm (expGenOf gens (nodeAName g))))
            (if (==
              (cast Int gm)              0
            )
              false
              (strEq gm macName)
            )
          )
        )
      )
    )
  )
)

; ------------------------------------------------------------------
; The printer: an ASTNode back to Axiom source.
;
; Nothing else in the compiler does this. `lspFormText` re-slices the
; document, and `tyRender` writes the CHECKER's notation - `(Int ->
; Bool)`, which `parseTypeParens` refuses (probed: AX2001 at the
; arrow) - so an expansion, which exists only as nodes, needs its own
; writer, and so does the signature the assist inserts.
;
; WHAT IT PROMISES is that its output PARSES and means what the node
; meant: the gate sends an expansion back to the server as a document
; and requires a clean parse and exactly the generated names in its
; outline. What it does not promise is anyone's layout. It has one
; shape per form: a `let`, a `match`, a `fn`, a `lambda`, a `while`, a
; `cond` and a `{ }` block put their bodies one form per line, two
; spaces deeper; every other form is written inline unless a child
; already spans lines, in which case each child takes a line. Nested
; single-binding `let`s - which is what the parser makes of every
; multi-binding one - are re-merged into one binding list when the
; body is directly another `let`; curried single-parameter lambdas are
; re-merged the same way. Both are the inverse of the parser's own
; desugaring, and a `let` the author nested by hand merges too, which
; means the same thing.
;
; TWO SPELLINGS ARE NOT THE NODE'S OWN, and both are said here rather
; than discovered. A hygiene-renamed binder is `x.3` in the tree
; (expand.ax, MAC-HYG) and `.` is the field-access token, so it is
; written `x_3`: the rename stays visible and the text lexes. A
; qualified reference is `Mod$name` in the tree (`mangledFromChain`)
; and is written back as `Mod::name`, which is what the parser reads.
;
; WHAT IT CANNOT WRITE FAITHFULLY, said once: a float, whose node
; holds IEEE-754 bits and no lexeme, is written to nine places and
; trimmed - a literal that parses and is within a billionth of the
; value; an `effect` declaration, whose operation signatures the
; parser drops, is written as a comment naming it; an `impl` head
; keeps only its type's NAME, as the parser kept it; a rule-form
; macro's non-binder patterns are written as the `syntax/pat` marker
; the parser stores; a generated struct's fields are written with
; their types now that the expander carries them (they were untyped
; until `expBuildStructFieldsIn` was fixed - `lspRenderFields` still
; writes a bare `(name)` for a field whose type is 0). A node with a
; tag this printer does not know is written as
; `(syntax/unrenderable N)`, which parses and says what it is.
;
; MEASURED on a template holding a `let` with a `mut`, a block, `set`,
; `while`, `if`, `match` on a literal and a wildcard, `cond` with
; `else`, a two-parameter lambda, a struct construction, field access,
; a string with escapes, a char, a float, a negative literal, a
; `match` over constructors, and a generated `data`, `type` and
; `struct`: the rendering re-parsed clean, and `check` on it reported
; exactly the diagnostics `check` reported on the template - which is
; the printer meaning what the tree meant.
; ------------------------------------------------------------------
(pub :: lspPad (-> Int String))

(pub fn (lspPad n)
  (if (<= n 0)
    ""
    (strConcat " " (lspPad (- n 1)))
  )
)

(pub :: lspHasNl (-> String Bool))

(pub fn (lspHasNl s)
  (match (strFindByte s 10 0)
    ((None) false)
    ((Some _) true)
  )
)

; `(head a b)` inline, or one child per line at `ind + 2` when any
; child already spans lines. `parts` holds the head first. Children
; are rendered at `ind + 2` by every caller, so their continuation
; lines are right in both layouts.
(pub :: lspRenderForm (-> (Vec a) Int String))

(pub fn (lspRenderForm parts ind)
  (let (
    (n (vecLen parts))
    (out vecNew)
    (broken (lspAnyNl parts 0))
    (mut i 0)
  )
    {
      (vecPush out "(")
      (while (< i n)
        {
          (if (> i 0)
            (vecPush
              out              (if broken
                (strConcat "\n" (lspPad (+ ind 2)))
                " "
              )
            )
            (cast (Vec String) 0)
          )
          (vecPush out (vecGetStr parts i))
          (set i (+ i 1))
        })
      (vecPush out ")")
      (catStrs out)
    }
  )
)

(pub :: lspAnyNl (-> (Vec a) Int Bool))

(pub fn (lspAnyNl parts i)
  (if (>= i (vecLen parts))
    false
    (if (lspHasNl (vecGetStr parts i))
      true
      (lspAnyNl parts (+ i 1))
    )
  )
)

; The two spellings above: `$` to `::` once, at the module boundary,
; and every byte the lexer would not read as part of a name to `_` in
; the name half only - a module path keeps its dots.
(pub :: lspRenderName (-> String String))

(pub fn (lspRenderName s)
  (let ((m (lspModOf s)))
    (if (== (strLen m) 0)
      (lspDeHygiene s)
      (strConcat (strConcat m "::") (lspDeHygiene (bareOf s)))
    )
  )
)

; The expander's own names carry two bytes no identifier may: the `.`
; of a hygiene rename (`x.3`, MAC-HYG) and the `#` of a `syntax/binders`
; field variable (`x#0`, expand.ax `expBindersOf`) - and the first
; version of this mapped the dot alone, so a fieldful derive rendered
; `x#0_0` and the text stopped at AX1001 (measured on
; tests/selfhost/377). The rule is the lexer's: any byte
; `isIdentChar` refuses becomes `_`, so the rename stays visible and
; the text lexes.
(pub :: lspDeHygiene (-> String String))

(pub fn (lspDeHygiene s)
  (if (lspAllIdentBytes s 0)
    s
    (let (
      (n (strLen s))
      (out (strAlloc (strLen s)))
      (mut i 0)
    )
      {
        (while (< i n)
          {
            (__store8
              (strData out)              i              (if (isIdentChar (strByte s i))
                (strByte s i)
                95
              )
            )
            (set i (+ i 1))
          })
        (strSlice out 0 n)
      }
    )
  )
)

(pub :: lspAllIdentBytes (-> String Int Bool))

(pub fn (lspAllIdentBytes s i)
  (if (>= i (strLen s))
    true
    (if (isIdentChar (strByte s i))
      (lspAllIdentBytes s (+ i 1))
      false
    )
  )
)

; A declaration's name position: a join marker - the space-joined
; `syntax/join tag T` a template stores - is written back as the form
; it was.
(pub :: lspRenderDeclName (-> String String))

(pub fn (lspRenderDeclName s)
  (if (!= (expIsJoinMarker s) 0)
    (strConcat (strConcat "(" s) ")")
    (lspRenderName s)
  )
)

(pub :: lspRenderInt (-> Int String))

(pub fn (lspRenderInt v)
  (if (< v 0)
    (strConcat "-" (decStr (- 0 v)))
    (decStr v)
  )
)

; A string node holds its LEXEME - quotes and escapes as written - so
; it is written back as it was. One a macro built without quotes is
; quoted and escaped with the seven escapes the lexer reads
; (`isEscapeChar`), and no others.
(pub :: lspRenderStr (-> String String))

(pub fn (lspRenderStr s)
  (if (&& (> (strLen s) 0) (== (strByte s 0) 34))
    s
    (let (
      (n (strLen s))
      (parts vecNew)
      (mut i 0)
    )
      {
        (vecPush parts "\"")
        (while (< i n)
          {
            (vecPush parts (lspEscByte (strByte s i) 34 (strSlice s i 1)))
            (set i (+ i 1))
          })
        (vecPush parts "\"")
        (catStrs parts)
      }
    )
  )
)

; One byte inside a literal delimited by `q`: the escape when the lexer
; needs one, else `raw`, which the caller cut from the source.
(pub :: lspEscByte (-> Int Int String String))

(pub fn (lspEscByte b q raw)
  (if (== b 92)
    "\\\\"
    (if (== b q)
      (strConcat "\\" (strSlice "\"'" (if (== q 34)
        0
        1
      ) 1))
      (if (== b 10)
        "\\n"
        (if (== b 9)
          "\\t"
          (if (== b 13)
            "\\r"
            (if (== b 0)
              "\\0"
              raw
            )
          )
        )
      )
    )
  )
)

(pub :: lspRenderChar (-> Int String))

(pub fn (lspRenderChar cp) (strConcat (strConcat "'" (lspEscByte cp 39 (utf8FromChar cp))) "'"))

; The bits reinterpreted, written to nine places and trimmed to the
; last non-zero one. `__floatToInt` truncates, so the fraction is
; taken from what remains and rounded half up; a carry into the next
; whole number is folded back rather than left to print as `.1000000000`.
(pub :: lspRenderFloat (-> Int String))

(pub fn (lspRenderFloat bits)
  (let ((x (cast Float bits)))
    (if (< x 0.0)
      (strConcat "-" (lspRenderFloatAbs (- 0.0 x)))
      (lspRenderFloatAbs x)
    )
  )
)

(pub :: lspRenderFloatAbs (-> Float String))

(pub fn (lspRenderFloatAbs x)
  (let (
    (whole (__floatToInt x))
    (scale 1000000000)
  )
    (let ((scaled (__floatToInt (+ (* (- x (__intToFloat whole)) (__intToFloat scale)) 0.5))))
      (let (
        (carry
          (if (>= scaled scale)
            1
            0
          )
        )
      )
        (strConcat (strConcat (decStr (+ whole carry)) ".") (lspTrimZeros (lspZeroPad (decStr (- scaled (* carry scale))) 9)))
      )
    )
  )
)

(pub :: lspZeroPad (-> String Int String))

(pub fn (lspZeroPad s width)
  (if (>= (strLen s) width)
    s
    (lspZeroPad (strConcat "0" s) width)
  )
)

(pub :: lspTrimZeros (-> String String))

(pub fn (lspTrimZeros s)
  (let ((mut e (strLen s)))
    {
      (while (if (> e 1)
        (== (strByte s (- e 1)) 48)
        false
      )
        (set e (- e 1)))
      (strSlice s 0 e)
    }
  )
)

; Types in the PARSER's spelling - `parseTypeParens`'s grammar read
; backwards: `(-> A B C)` with the right-nested arrows flattened, `(Con
; a b)` for an application and `Con` alone for none, `[T]`, `(* T)`,
; `()` for the empty tuple and `(A B)` otherwise. A type variable with
; no name is the parser's wildcard for a field type it could not read
; (`typeNodeOrWildcard`) and is written `_`.
;
; `ren` is 0, or a flat Vec of (old, new) variable spellings the
; writer substitutes - what the assist needs, see `lspFreshRenames`.
(pub :: lspRenderType (-> Int String))

(pub fn (lspRenderType t) (lspRenderTypeR t (cast (Vec Int) 0)))

(pub :: lspRenderTypeR (-> Int (Vec a) String))

(pub fn (lspRenderTypeR t ren)
  (if (== t 0)
    "{unknown}"
    (let ((tag (nodeTag t)))
      (if (== tag TAG_T_VAR)
        (if (== (strLen (nodeAName t)) 0)
          "_"
          (lspRenamed ren (nodeAName t))
        )
        (if (== tag TAG_T_CON)
          (if (== (vecLen (nodeBVec t)) 0)
            (nodeAName t)
            (strConcat (strConcat (strConcat "(" (nodeAName t)) (lspRenderTypes (nodeBVec t) 0 " " ren)) ")")
          )
          (if (== tag TAG_T_ARR)
            (strConcat (strConcat "(->" (lspRenderArrow t ren)) ")")
            (if (== tag TAG_T_TUP)
              (strConcat (strConcat "(" (lspRenderTypes (nodeAVec t) 0 "" ren)) ")")
              (if (== tag TAG_T_LIST)
                (strConcat (strConcat "[" (lspRenderTypeR (nodeA t) ren)) "]")
                (if (== tag TAG_T_PTR)
                  (strConcat (strConcat "(* " (lspRenderTypeR (nodeA t) ren)) ")")
                  "{unknown}"
                )
              )
            )
          )
        )
      )
    )
  )
)

; The parameters and result of an arrow chain, each preceded by a
; space; the first element of a tuple gets none.
(pub :: lspRenderTypes (-> (Vec Int) Int String (Vec a) String))

(pub fn (lspRenderTypes tys i lead ren)
  (if (>= i (vecLen tys))
    ""
    (strConcat (strConcat lead (lspRenderTypeR (vecGet tys i) ren)) (lspRenderTypes tys (+ i 1) " " ren))
  )
)

(pub :: lspRenderArrow (-> Int (Vec a) String))

(pub fn (lspRenderArrow t ren)
  (if (== t 0)
    " {unknown}"
    (if (== (nodeTag t) TAG_T_ARR)
      (strConcat (strConcat " " (lspRenderTypeR (nodeA t) ren)) (lspRenderArrow (nodeB t) ren))
      (strConcat " " (lspRenderTypeR t ren))
    )
  )
)

(pub :: lspRenamed (-> (Vec a) String String))

(pub fn (lspRenamed ren name)
  (if (== (cast Int ren) 0)
    name
    (let ((at (strVecIdx ren name)))
      (if (|| (< at 0) (!= (% at 2) 0))
        name
        (vecGetStr ren (+ at 1))
      )
    )
  )
)

; The checker names a type variable it could not resolve `_tN`
; (typecheck.ax, `tcCounter`), and `symbols` prints it that way -
; but the parser reads a type variable as a name starting with a
; lowercase LETTER (`aliasTyvarsEnd`), so a signature spelling `_t3`
; is AX3002 `undefined type`. Measured on tests/selfhost/770: the
; assist wrote `(:: adder (-> Int _t3 _t3))` and the checker refused
; it, where `(:: adder (-> Int a a))` checks clean and `symbols` then
; prints `(Int -> (a -> a))`. So each such variable is written as the
; first letter no variable of the type already uses, in order of
; appearance. Answers 0 when there is nothing to rename.
(pub :: lspFreshRenames (-> Int (Vec String)))

(pub fn (lspFreshRenames ty)
  (let (
    (names vecNew)
    (ren vecNew)
    (mut i 0)
    (mut b 97)
  )
    {
      (lspTyVarNames ty names)
      (while (< i (vecLen names))
        (let ((nm (vecGetStr names i)))
          {
            (if (&& (== (strByte nm 0) 95) (< (strVecIdx ren nm) 0))
              {
                (while (if (<= b 122)
                  (>= (strVecIdx names (strFromByte b)) 0)
                  false
                )
                  (set b (+ b 1)))
                (if (<= b 122)
                  {
                    (vecPush ren nm)
                    (vecPush ren (strFromByte b))
                    (vecPush names (strFromByte b))
                    (set b (+ b 1))
                    0
                  }
                  0
                )
              }
              0
            )
            (set i (+ i 1))
          }
        ))
      (if (== (vecLen ren) 0)
        (cast (Vec String) 0)
        ren
      )
    }
  )
)

; Every named type variable of `ty`, in order of appearance.
(pub :: lspTyVarNames (-> Int (Vec String) Int))

(pub fn (lspTyVarNames t out)
  (if (== t 0)
    0
    (let ((tag (nodeTag t)))
      (if (== tag TAG_T_VAR)
        (if (> (strLen (nodeAName t)) 0)
          {
            (vecPush out (nodeAName t))
            0
          }
          0
        )
        (if (|| (== tag TAG_T_CON) (== tag TAG_T_TUP))
          (lspTyVarNamesIn
            (if (== tag TAG_T_CON)
              (nodeBVec t)
              (nodeAVec t)
            )            out            0
          )
          (if (== tag TAG_T_ARR)
            {
              (lspTyVarNames (nodeA t) out)
              (lspTyVarNames (nodeB t) out)
            }
            (if (|| (== tag TAG_T_LIST) (== tag TAG_T_PTR))
              (lspTyVarNames (nodeA t) out)
              0
            )
          )
        )
      )
    )
  )
)

(pub :: lspTyVarNamesIn (-> (Vec Int) (Vec String) Int Int))

(pub fn (lspTyVarNamesIn tys out i)
  (if (>= i (vecLen tys))
    0
    {
      (lspTyVarNames (vecGet tys i) out)
      (lspTyVarNamesIn tys out (+ i 1))
    }
  )
)

; Whether every part of a type is known: no 0, no poison, no nameless
; variable. What the assist refuses to write.
(pub :: lspTyKnown (-> Int Bool))

(pub fn (lspTyKnown t)
  (if (== t 0)
    false
    (let ((tag (nodeTag t)))
      (if (== tag TAG_T_VAR)
        (> (strLen (nodeAName t)) 0)
        (if (== tag TAG_T_CON)
          (lspTysKnown (nodeBVec t) 0)
          (if (== tag TAG_T_ARR)
            (&& (lspTyKnown (nodeA t)) (lspTyKnown (nodeB t)))
            (if (== tag TAG_T_TUP)
              (lspTysKnown (nodeAVec t) 0)
              (if (|| (== tag TAG_T_LIST) (== tag TAG_T_PTR))
                (lspTyKnown (nodeA t))
                false
              )
            )
          )
        )
      )
    )
  )
)

(pub :: lspTysKnown (-> (Vec Int) Int Bool))

(pub fn (lspTysKnown tys i)
  (if (>= i (vecLen tys))
    true
    (if (lspTyKnown (vecGet tys i))
      (lspTysKnown tys (+ i 1))
      false
    )
  )
)

; An expression, at column `ind`; its continuation lines are indented
; from there and its children are rendered at `ind + 2`.
(pub :: lspRenderExpr (-> Int Int String))

(pub fn (lspRenderExpr e ind)
  (if (== e 0)
    "(syntax/unrenderable 0)"
    (let ((tag (nodeTag e)))
      (if (== tag TAG_E_INT)
        (lspRenderInt (nodeA e))
        (if (== tag TAG_E_STR)
          (lspRenderStr (nodeAName e))
          (if (== tag TAG_E_CHAR)
            (lspRenderChar (nodeA e))
            (if (== tag TAG_E_FLT)
              (lspRenderFloat (nodeA e))
              (if (== tag TAG_E_VAR)
                (lspRenderName (nodeAName e))
                (if (== tag TAG_E_APP)
                  (lspRenderApp e ind)
                  (if (== tag TAG_E_LAM)
                    (lspRenderLam e ind)
                    (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
                      (lspRenderLet e ind)
                      (if (== tag TAG_E_IF)
                        (lspRenderForm (lspParts4 "if" (lspRenderExpr (nodeA e) (+ ind 2)) (lspRenderExpr (nodeB e) (+ ind 2)) (lspRenderExpr (nodeC e) (+ ind 2))) ind)
                        (if (== tag TAG_E_BEGIN)
                          (lspRenderBlock (nodeAVec e) ind)
                          (if (== tag TAG_E_MATCH)
                            (lspRenderMatch e ind)
                            (lspRenderExprMore e tag ind)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

; The second half of the dispatch: the forms a body meets less often.
(pub :: lspRenderExprMore (-> Int Int Int String))

(pub fn (lspRenderExprMore e tag ind)
  (if (== tag TAG_E_COND)
    (lspRenderCond e ind)
    (if (== tag TAG_E_SET)
      (lspRenderForm (lspParts3 "set" (lspRenderName (nodeAName e)) (lspRenderExpr (nodeB e) (+ ind 2))) ind)
      (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
        (if (== tag TAG_E_REGION)
          (lspRenderForm (lspParts3 "region" (lspRenderName (nodeAName e)) (lspRenderExpr (nodeB e) (+ ind 2))) ind)
          (strConcat (strConcat (strConcat "(while " (lspRenderExpr (nodeA e) (+ ind 2))) (lspRenderLines (nodeBVec e) (+ ind 2))) ")")
        )
        (if (== tag TAG_E_FIELD)
          (strConcat (strConcat (lspRenderExpr (nodeA e) ind) ".") (nodeBName e))
          (if (== tag TAG_E_SETF)
            (lspRenderForm (lspParts3 "set" (strConcat (strConcat (lspRenderExpr (nodeA e) (+ ind 2)) ".") (nodeBName e)) (lspRenderExpr (nodeC e) (+ ind 2))) ind)
            (if (== tag TAG_E_STRUCTCON)
              (lspRenderForm (lspPartsExprs (lspParts2 "struct" (lspRenderName (nodeAName e))) (nodeBVec e) 0 (+ ind 2)) ind)
              (if (== tag TAG_E_ALLOC)
                (if (== (nodeB e) 0)
                  (lspRenderForm (lspParts2 "alloc" (lspRenderType (nodeA e))) ind)
                  (lspRenderForm (lspParts3 "alloc" (lspRenderType (nodeA e)) (lspRenderExpr (nodeB e) (+ ind 2))) ind)
                )
                (if (== tag TAG_E_HANDLE)
                  (lspRenderHandle e ind)
                  (if (== tag TAG_E_QUOTE)
                    (lspRenderForm (lspParts2 "quote" (lspRenderExpr (nodeA e) (+ ind 2))) ind)
                    (if (== tag TAG_P_CON0)
                      (strConcat (strConcat "(" (lspRenderName (nodeAName e))) ")")
                      (if (== tag TAG_P_CONNAMED)
                        (lspRenderConNamed e ind)
                        (if (== tag TAG_M_FOR)
                          (lspRenderSynFor e ind)
                          (if (== tag TAG_M_ARM)
                            (lspRenderArm e ind)
                            (strConcat (strConcat "(syntax/unrenderable " (decStr tag)) ")")
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(pub :: lspParts2 (-> String String (Vec String)))

(pub fn (lspParts2 a b)
  (let ((v vecNew))
    {
      (vecPush v a)
      (vecPush v b)
      v
    }
  )
)

(pub :: lspParts3 (-> String String String (Vec String)))

(pub fn (lspParts3 a b c)
  (let ((v (lspParts2 a b)))
    {
      (vecPush v c)
      v
    }
  )
)

(pub :: lspParts4 (-> String String String String (Vec String)))

(pub fn (lspParts4 a b c d)
  (let ((v (lspParts3 a b c)))
    {
      (vecPushStr v d)
      v
    }
  )
)

; Every expression of `es` rendered onto `parts`, at `ind`.
(pub :: lspPartsExprs (-> (Vec String) (Vec Int) Int Int (Vec String)))

(pub fn (lspPartsExprs parts es i ind)
  (if (>= i (vecLen es))
    parts
    {
      (vecPush parts (lspRenderExpr (vecGet es i) ind))
      (lspPartsExprs parts es (+ i 1) ind)
    }
  )
)

; An application spine, flattened back to `(f a b)`: `(f x y)` parses
; to App(App(f, x), y), so the arguments come off the spine in reverse
; and the head is what is left when the tags run out.
(pub :: lspRenderApp (-> Int Int String))

(pub fn (lspRenderApp e ind)
  (let (
    (rev vecNew)
    (mut h e)
  )
    {
      (while (== (nodeTag h) TAG_E_APP)
        {
          (vecPush rev (nodeB h))
          (set h (nodeA h))
        })
      (let (
        (parts vecNew)
        (mut i (- (vecLen rev) 1))
      )
        {
          (vecPush parts (lspRenderExpr h (+ ind 2)))
          (while (>= i 0)
            {
              (vecPush parts (lspRenderExpr (vecGet rev i) (+ ind 2)))
              (set i (- i 1))
            })
          (lspRenderForm parts ind)
        }
      )
    }
  )
)

; `(lambda (x y) body)`: the curried chain of one-parameter lambdas
; re-merged, and a zero-parameter one written `()`.
(pub :: lspRenderLam (-> Int Int String))

(pub fn (lspRenderLam e ind)
  (let (
    (names vecNew)
    (mut body e)
  )
    {
      (while (&& (== (nodeTag body) TAG_E_LAM) (== (vecLen (nodeAVec body)) 1))
        {
          (vecPush names (vecGetStr (nodeAVec body) 0))
          (set body (nodeB body))
        })
      (if (== (vecLen names) 0)
        (set body (nodeB e))
        0
      )
      (strConcat (strConcat (strConcat (strConcat "(lambda (" (lspJoinNames names 0)) ")\n") (lspPad (+ ind 2))) (strConcat (lspRenderExpr body (+ ind 2)) ")"))
    }
  )
)

(pub :: lspJoinNames (-> (Vec a) Int String))

(pub fn (lspJoinNames names i)
  (if (>= i (vecLen names))
    ""
    (strConcat
      (if (== i 0)
        ""
        " "
      )      (strConcat (lspRenderName (vecGetStr names i)) (lspJoinNames names (+ i 1)))
    )
  )
)

; `(let ((x 1) (mut y 2))` and the body on its own line: the nested
; single-binding lets re-merged while the body is directly another.
(pub :: lspRenderLet (-> Int Int String))

(pub fn (lspRenderLet e ind)
  (let (
    (binds vecNew)
    (mut body e)
  )
    {
      (while (|| (== (nodeTag body) TAG_E_LET) (== (nodeTag body) TAG_E_LETM))
        {
          (vecPush binds (strConcat (strConcat (strConcat (strConcat "(" (if (== (nodeTag body) TAG_E_LETM)
            "mut "
            ""
          )) (lspRenderName (nodeAName body))) " ") (strConcat (lspRenderExpr (nodeB body) (+ ind 6)) ")")))
          (set body (nodeC body))
        })
      (strConcat (strConcat (strConcat (strConcat "(let (" (lspJoinStrs binds 0 " ")) ")\n") (lspPad (+ ind 2))) (strConcat (lspRenderExpr body (+ ind 2)) ")"))
    }
  )
)

(pub :: lspJoinStrs (-> (Vec a) Int String String))

(pub fn (lspJoinStrs xs i sep)
  (if (>= i (vecLen xs))
    ""
    (strConcat
      (if (== i 0)
        ""
        sep
      )      (strConcat (vecGetStr xs i) (lspJoinStrs xs (+ i 1) sep))
    )
  )
)

; `{ }`: one expression per line.
(pub :: lspRenderBlock (-> (Vec Int) Int String))

(pub fn (lspRenderBlock es ind) (strConcat (strConcat "{" (lspRenderLines es (+ ind 2))) (strConcat "\n" (strConcat (lspPad ind) "}"))))

; Each of `es` on a line of its own at `ind`, every line led by its
; newline so the caller's opener stays on the caller's line.
(pub :: lspRenderLines (-> (Vec Int) Int String))

(pub fn (lspRenderLines es ind)
  (let (
    (parts vecNew)
    (n (vecLen es))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (vecPush parts (strConcat (strConcat "\n" (lspPad ind)) (lspRenderExpr (vecGet es i) ind)))
          (set i (+ i 1))
        })
      (catStrs parts)
    }
  )
)

(pub :: lspRenderMatch (-> Int Int String))

(pub fn (lspRenderMatch e ind) (strConcat (strConcat (strConcat "(match " (lspRenderExpr (nodeA e) (+ ind 2))) (lspRenderLines (nodeBVec e) (+ ind 2))) ")"))

; One arm, `(pattern body)` - a `match` arm or a `cond` clause - with
; the body on its own line when it spans lines.
(pub :: lspRenderArm (-> Int Int String))

(pub fn (lspRenderArm arm ind)
  (let (
    (pat (lspRenderExpr (nodeA arm) (+ ind 2)))
    (body (lspRenderExpr (nodeB arm) (+ ind 2)))
  )
    (strConcat
      (strConcat (strConcat "(" pat) (if (lspHasNl body)
        (strConcat "\n" (lspPad (+ ind 2)))
        " "
      ))      (strConcat body ")")
    )
  )
)

; `(cond (test body) ... (else body))`; `(else ...)` only when the
; node has one, as `parseCondClauses` stores it.
(pub :: lspRenderCond (-> Int Int String))

(pub fn (lspRenderCond e ind)
  (strConcat
    (strConcat "(cond" (lspRenderLines (nodeAVec e) (+ ind 2)))
    (strConcat
      (if (== (nodeB e) 0)
        ""
        (strConcat (strConcat (strConcat "\n" (lspPad (+ ind 2))) "(else ") (strConcat (lspRenderExpr (nodeB e) (+ ind 4)) ")"))
      )      ")"
    )
  )
)

; `(handle body (Effect...) handler)`, the effect list left out when
; it is empty - the parser reads it as optional.
(pub :: lspRenderHandle (-> Int Int String))

(pub fn (lspRenderHandle e ind)
  (let ((parts (lspParts2 "handle" (lspRenderExpr (nodeA e) (+ ind 2)))))
    {
      (if (> (vecLen (nodeBVec e)) 0)
        (vecPush parts (strConcat (strConcat "(" (lspJoinExprs (nodeBVec e) 0 ind)) ")"))
        (cast (Vec String) 0)
      )
      (vecPush parts (lspRenderExpr (nodeC e) (+ ind 2)))
      (lspRenderForm parts ind)
    }
  )
)

(pub :: lspJoinExprs (-> (Vec Int) Int Int String))

(pub fn (lspJoinExprs es i ind)
  (if (>= i (vecLen es))
    ""
    (strConcat
      (if (== i 0)
        ""
        " "
      )      (strConcat (lspRenderExpr (vecGet es i) ind) (lspJoinExprs es (+ i 1) ind))
    )
  )
)

; `(Rect { w = p, h = q })`: field names in `b`, sub-patterns aligned
; in `c`.
(pub :: lspRenderConNamed (-> Int Int String))

(pub fn (lspRenderConNamed e ind)
  (let (
    (names (nodeBVec e))
    (pats (nodeCVec e))
    (parts vecNew)
    (mut i 0)
  )
    {
      (vecPush parts (strConcat (strConcat "(" (lspRenderName (nodeAName e))) " {"))
      (while (< i (vecLen names))
        {
          (vecPush
            parts            (if (== i 0)
              " "
              ", "
            )
          )
          (vecPush parts (lspRenderName (nodeAName (vecGet names i))))
          (vecPush parts " = ")
          (vecPush parts (lspRenderExpr (vecGet pats i) (+ ind 2)))
          (set i (+ i 1))
        })
      (vecPush parts " })")
      (catStrs parts)
    }
  )
)

; `(syntax/for (x xs) ...)` in either position: the binding form is
; the expression the parser stored, the elements are arms or
; declarations by the node's tag.
(pub :: lspRenderSynFor (-> Int Int String))

(pub fn (lspRenderSynFor e ind)
  (strConcat
    (strConcat "(syntax/for " (lspRenderExpr (nodeB e) (+ ind 2)))
    (strConcat
      (if (== (nodeTag e) TAG_M_FOR)
        (lspRenderLines (nodeCVec e) (+ ind 2))
        (lspRenderDeclLines (nodeCVec e) (+ ind 2))
      )      ")"
    )
  )
)

(pub :: lspRenderDeclLines (-> (Vec Int) Int String))

(pub fn (lspRenderDeclLines ds ind)
  (let (
    (parts vecNew)
    (n (vecLen ds))
    (mut i 0)
  )
    {
      (while (< i n)
        {
          (vecPush parts (strConcat (strConcat "\n" (lspPad ind)) (lspRenderDecl (vecGet ds i) ind)))
          (set i (+ i 1))
        })
      (catStrs parts)
    }
  )
)

; A declaration at column `ind` - 0 at the top level, deeper inside a
; rule-form macro's template - with its `;@axiom:` lines above it,
; each as the scanner stored it (`AxtagEnt`, word 1 the text after
; the prefix), and `pub` from `nodeVis`.
(pub :: lspRenderDecl (-> Int Int String))

(pub fn (lspRenderDecl d ind)
  (if (== d 0)
    "; unrenderable declaration (no node)"
    (strConcat (lspRenderAxtags (nodeAxtagsVec d) ind) (lspRenderDeclBody d ind))
  )
)

(pub :: lspRenderAxtags (-> (Vec Int) Int String))

(pub fn (lspRenderAxtags tags ind)
  (if (== (cast Int tags) 0)
    ""
    (let (
      (parts vecNew)
      (n (vecLen tags))
      (mut i 0)
    )
      {
        (while (< i n)
          {
            (vecPush parts (strConcat (strConcat ";@axiom:" (memGetWordStr (vecGet tags i) 1)) (strConcat "\n" (lspPad ind))))
            (set i (+ i 1))
          })
        (catStrs parts)
      }
    )
  )
)

(pub :: lspPubOf (-> Int String))

(pub fn (lspPubOf d)
  (if (== (nodeVis d) 1)
    "(pub "
    "("
  )
)

(pub :: lspRenderDeclBody (-> Int Int String))

(pub fn (lspRenderDeclBody d ind)
  (let ((tag (nodeTag d)))
    (if (== tag TAG_D_FN)
      (strConcat (strConcat (strConcat (strConcat (lspPubOf d) "fn (") (lspRenderDeclName (nodeAName d))) (strConcat (lspParamsOf (nodeBVec d)) ")\n")) (strConcat (lspPad (+ ind 2)) (strConcat (lspRenderExpr (nodeC d) (+ ind 2)) ")")))
      (if (== tag TAG_D_SIG)
        (strConcat (strConcat (strConcat (lspPubOf d) ":: ") (lspRenderDeclName (nodeAName d))) (strConcat (strConcat " " (lspRenderType (nodeTy d))) ")"))
        (if (== tag TAG_D_DATA)
          (lspRenderData d ind)
          (if (== tag TAG_D_STRUCT)
            (strConcat (strConcat (strConcat (lspPubOf d) "struct ") (lspRenderDeclName (nodeAName d))) (strConcat (lspRenderFields (nodeBVec d) (+ ind 2)) ")"))
            (if (== tag TAG_D_MACRO)
              (lspRenderMacro d ind)
              (if (== tag TAG_D_IMPORT)
                (strConcat
                  (strConcat "(import " (nodeAName d))
                  (strConcat
                    (if (== (vecLen (nodeBVec d)) 0)
                      ""
                      (strConcat (strConcat " (" (lspJoinNames (nodeBVec d) 0)) ")")
                    )                    ")"
                  )
                )
                (if (== tag TAG_D_ALIAS)
                  (strConcat (strConcat (strConcat (lspPubOf d) "type ") (lspRenderDeclName (nodeAName d))) (strConcat (strConcat (lspTyvarsOf (nodeCVec d)) " = ") (strConcat (lspRenderType (nodeB d)) ")")))
                  (lspRenderDeclMore d tag ind)
                )
              )
            )
          )
        )
      )
    )
  )
)

(pub :: lspRenderDeclMore (-> Int Int Int String))

(pub fn (lspRenderDeclMore d tag ind)
  (if (== tag TAG_D_EXTERN)
    (strConcat (strConcat (strConcat (lspPubOf d) "extern \"") (strConcat (nodeAName d) "\"")) (strConcat (lspRenderExternItems (nodeCVec d) (+ ind 2)) ")"))
    (if (== tag TAG_D_MACROCALL)
      (lspRenderForm (lspPartsExprs (lspParts1 (lspRenderName (nodeAName d))) (nodeBVec d) 0 (+ ind 2)) ind)
      (if (== tag TAG_D_SYNFOR)
        (lspRenderSynFor d ind)
        (if (== tag TAG_D_EFFECT)
          (strConcat (strConcat "; (effect " (nodeAName d)) " ...) - the parser keeps its operation names and not their signatures, so it is not rendered")
          (strConcat (strConcat "; unrenderable declaration (tag " (decStr tag)) ")")
        )
      )
    )
  )
)

(pub :: lspParts1 (-> String (Vec String)))

(pub fn (lspParts1 a)
  (let ((v vecNew))
    {
      (vecPush v a)
      v
    }
  )
)

; ` x y` for a parameter list, "" for none.
(pub :: lspParamsOf (-> (Vec Int) String))

(pub fn (lspParamsOf names)
  (if (== (vecLen names) 0)
    ""
    (strConcat " " (lspJoinNames names 0))
  )
)

; ` (a b)` for a `data`'s type parameters; ` a b` bare for a `type`
; or `trait`, which is what their parsers read; "" for none.
(pub :: lspTyvarsOf (-> (Vec Int) String))

(pub fn (lspTyvarsOf tvs)
  (if (== (cast Int tvs) 0)
    ""
    (if (== (vecLen tvs) 0)
      ""
      (strConcat " " (lspJoinStrs tvs 0 " "))
    )
  )
)

; `(data Name (a) ctor...)`: each constructor on its own line, a struct
; variant with its named fields, a positional one with its field
; types.
(pub :: lspRenderData (-> Int Int String))

(pub fn (lspRenderData d ind)
  (let (
    (ctors (nodeBVec d))
    (parts vecNew)
    (mut i 0)
  )
    {
      (vecPush parts (strConcat (strConcat (lspPubOf d) "data ") (lspRenderDeclName (nodeAName d))))
      (if (== (nodeTy d) 0)
        0
        (if (== (vecLen (nodeTyVec d)) 0)
          0
          { (vecPush parts (strConcat (strConcat " (" (lspJoinStrs (nodeTyVec d) 0 " ")) ")")) 0 }
        )
      )
      (while (< i (vecLen ctors))
        {
          (vecPush parts (strConcat (strConcat "\n" (lspPad (+ ind 2))) (lspRenderCtor (vecGet ctors i))))
          (set i (+ i 1))
        })
      (vecPush parts ")")
      (catStrs parts)
    }
  )
)

(pub :: lspRenderCtor (-> Int String))

(pub fn (lspRenderCtor c)
  (let (
    (tys
      (if (== (nodeTy c) 0)
        vecNew
        (nodeTyVec c)
      )
    )
    (names (nodeFieldNamesVec c))
  )
    (if (&& (!= (cast Int names) 0) (> (vecLen names) 0))
      (strConcat (strConcat (strConcat "(" (lspRenderDeclName (nodeAName c))) " {") (strConcat (lspRenderNamedFields names tys 0) " })"))
      (strConcat (strConcat "(" (lspRenderDeclName (nodeAName c))) (strConcat (lspRenderTypes tys 0 " " (cast (Vec Int) 0)) ")"))
    )
  )
)

(pub :: lspRenderNamedFields (-> (Vec Int) (Vec Int) Int String))

(pub fn (lspRenderNamedFields names tys i)
  (if (>= i (vecLen names))
    ""
    (strConcat
      (strConcat
        (if (== i 0)
          " "
          ", "
        )        (strConcat (vecGetStr names i) " : ")
      )      (strConcat
        (if (< i (vecLen tys))
          (lspRenderType (vecGet tys i))
          "_"
        )        (lspRenderNamedFields names tys (+ i 1))
      )
    )
  )
)

; A struct's `(name : Type)` fields, one per line - or `(name)`, the
; parser's own spelling of a field with no type, when the tree holds
; none.
;
; THE SECOND ARM IS NO LONGER WHAT A GENERATED STRUCT LOOKS LIKE, and
; this paragraph said it was until 2026-08-31, which is the opposite
; of what the code below has done since the expander was fixed: it
; branches on `lspTyKnown (nodeTy f)`, and a generated field now has
; a type to know. `expBuildStructFieldsIn` used to substitute the
; parsed field's slot `b` as the type, where the parser keeps the
; float FLAG and not the type, so every generated field carried 0 and
; printed bare; that was an expander defect and it was fixed - the
; section header above records it among what this printer cannot
; write, correctly.
;
; MEASURED over a real JSON-RPC pipe, 2026-08-31: `axiom/expandMacro`
; at an invocation of a macro whose template is `(pub struct
; (syntax/join Pair T) (left : Int) (right : Int))` answers
;
;     (pub struct PairColour
;       (left : Int)
;       (right : Int))
;
; The bare arm survives for a field whose type really is 0. The
; checker reads a 0 as the wildcard, and `(name)` parses back to the
; same wildcard where `{unknown}` parses to nothing.
(pub :: lspRenderFields (-> (Vec Int) Int String))

(pub fn (lspRenderFields fields ind)
  (let (
    (parts vecNew)
    (n (vecLen fields))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((f (vecGet fields i)))
          {
            (vecPush
              parts              (strConcat
                (strConcat (strConcat "\n" (lspPad ind)) (strConcat "(" (nodeAName f)))
                (if (lspTyKnown (nodeTy f))
                  (strConcat (strConcat " : " (lspRenderType (nodeTy f))) ")")
                  ")"
                )
              )
            )
            (set i (+ i 1))
          }
        ))
      (catStrs parts)
    }
  )
)

; `(name :: Type (symbol "s"))` per extern item, one per line.
(pub :: lspRenderExternItems (-> (Vec Int) Int String))

(pub fn (lspRenderExternItems items ind)
  (let (
    (parts vecNew)
    (n (vecLen items))
    (mut i 0)
  )
    {
      (while (< i n)
        (let ((it (vecGet items i)))
          {
            (vecPush parts (strConcat (strConcat (strConcat "\n" (lspPad ind)) (strConcat "(" (nodeAName it))) (strConcat (strConcat " :: " (lspRenderType (nodeB it))) (strConcat (strConcat " (symbol \"" (nodeCName it)) "\"))"))))
            (set i (+ i 1))
          }
        ))
      (catStrs parts)
    }
  )
)

; A macro in either of its two spellings: the head-list form `(macro
; (name p...) body)` when word 3 holds a template expression, else the
; rule form, one rule per line, read from word 9 as `parseDeclMacro`
; stored it - each rule's slot 0 its parameter names and slot 1 its
; template declarations.
(pub :: lspRenderMacro (-> Int Int String))

(pub fn (lspRenderMacro d ind)
  (if (!= (nodeC d) 0)
    (strConcat (strConcat (strConcat (strConcat (lspPubOf d) "macro (") (lspRenderName (nodeAName d))) (strConcat (lspParamsOf (nodeBVec d)) ")\n")) (strConcat (lspPad (+ ind 2)) (strConcat (lspRenderExpr (nodeC d) (+ ind 2)) ")")))
    (let (
      (rules (memGetWordVec d 9))
      (parts vecNew)
      (mut i 0)
    )
      {
        (vecPush parts (strConcat (strConcat (lspPubOf d) "macro ") (lspRenderName (nodeAName d))))
        (while (if (== (cast Int rules) 0)
          false
          (< i (vecLen rules))
        )
          (let ((rule (vecGet rules i)))
            {
              (vecPush parts (strConcat (strConcat (strConcat "\n" (lspPad (+ ind 2))) (strConcat "((" (lspRenderName (nodeAName d)))) (strConcat (lspParamsOf (vecGet rule 0)) ")")))
              (vecPush parts (strConcat (lspRenderDeclLines (vecGet rule 1) (+ ind 4)) ")"))
              (set i (+ i 1))
            }
          ))
        (vecPush parts ")")
        (catStrs parts)
      }
    )
  )
)

; ==================================================================
; END SECTION FIX
; ==================================================================


; ------------------------------------------------------------------
; The loop
; ------------------------------------------------------------------
(pub :: lspMain Int)

;@axiom:effect(io)
(pub fn (lspMain)
  ; Taken after the store and the reader exist, so their handles
  ; sit below it; everything a message allocates sits above it and
  ; is reclaimed at the end of the message.
  (let (
    (mut r (rdNew 0))
    (mut uris vecNew)
    (mut texts vecNew)
    (mut running 1)
    (mut status 1)
    (m __axiom_arena_mark)
  )
    {
      (while (== running 1)
        {
          (let ((body (rpcRead r)))
            (if (== (strLen body) 0)
              ; The client went away without saying `exit`. Stopping is
              ; the only option; the status is the one `exit` would have
              ; given for a session that never had `shutdown`.
              (set running 0)
              (let ((msg (jsonParse body)))
                (if (== msg 0)
                  ; Unparseable JSON. There is no id to answer with,
                  ; so the message is dropped, which is what the spec
                  ; requires of a notification and the only thing
                  ; possible for a request whose id could not be read.
                  0
                  (let (
                    (method (jsonGetStr msg "method"))
                    (id (jsonGet msg "id"))
                    (params (jsonGet msg "params"))
                  )
                    (if (strEq method "initialize")
                      (lspReply id lspCapabilities)
                      (if (strEq method "initialized")
                        0
                        (if (strEq method "shutdown")
                          {
                            (set status 0)
                            (lspReply id jsonNull)
                          }
                          (if (strEq method "exit")
                            (set running 0)
                            (if (strEq method "textDocument/didOpen")
                              (let ((uri (lspParamsUri params)))
                                {
                                  (docPut uris texts uri (jsonGetStr (jsonGet params "textDocument") "text"))
                                  (lspRecheck uris texts uri)
                                }
                              )
                              (if (strEq method "textDocument/didChange")
                                (let ((uri (lspParamsUri params)))
                                  {
                                    (docPut uris texts uri (lspChangeText params))
                                    (lspRecheck uris texts uri)
                                  }
                                )
                                (if (strEq method "textDocument/documentSymbol")
                                  (lspReply id (lspDocumentSymbols (docText uris texts (lspParamsUri params))))
                                  (if (strEq method "textDocument/definition")
                                    (lspReply id (lspDefinition (docText uris texts (lspParamsUri params)) (lspParamsUri params) params))
                                    (if (strEq method "textDocument/hover")
                                      (lspReply id (lspHover (docText uris texts (lspParamsUri params)) (lspParamsUri params) params))
                                      (if (strEq method "textDocument/completion")
                                        (lspReply id (lspCompletion (docText uris texts (lspParamsUri params)) (lspParamsUri params) params))
                                      (if (strEq method "textDocument/didClose")
                                        (let ((uri (lspParamsUri params)))
                                          {
                                            (docPut uris texts uri "")
                                            ; An empty list is how a server retracts
                                            ; the squiggles for a file the editor has
                                            ; closed; saying nothing leaves them on
                                            ; screen forever.
                                            (lspPublish uri jsonArr)
                                          }
                                        )
                                        ; Everything the three extension sections
                                        ; answer - navigation, views, fixes - is
                                        ; dispatched through one door, so the chain
                                        ; above stays the lifecycle and the four
                                        ; original questions.
                                        (if (lspExtHandles method)
                                          (lspExtDispatch method id params uris texts)
                                          ; Anything else: a request must be answered,
                                          ; a notification must not be.
                                          (if (== id 0)
                                            0
                                            (lspError id (- 0 32601) (strConcat "method not found: " method))
                                          )
                                        )
                                      ))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          ; The boundary. Everything this message touched goes back,
          ; except the store and the reader's unconsumed bytes, which
          ; travel down to the waterline in one block.
          (let ((snap (lspSnapshot uris texts r)))
            (let ((kept (__axiom_arena_reset_keeping m snap (memGetWord snap 0))))
              (let ((h (lspRestore kept)))
                {
                  (set uris (memGetWordVec h 0))
                  (set texts (memGetWordVec h 1))
                  (set r (memGetWord h 2))
                }
              )
            )
          )
        })
      (sysExitWith status)
      status
    }
  )
)
