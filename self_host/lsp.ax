    (n (/ (vecLen chain) 4))
    (mut j from)
    (mut ok true)
  )
    {
      (while (if ok
        (< j n)
        false
      )
        (let ((p (vecGet chain (* j 4))))
          {
            (if (== (strByte src p) 40)
              (if (lspFixArgIsPlain (lspViewHeadAt src p) (vecGet chain (+ (* j 4) 1)))
