(pub fn (lspFixIsSegment s) (&& (> (strLen s) 0) (&& (isIdentStart (strByte s 0)) (lspAllIdentBytes s 0))))

(pub :: lspFixEndsWith (-> String String Bool))

(pub fn (lspFixEndsWith s suf) (&& (>= (strLen s) (strLen suf)) (strEq (strSlice s (- (strLen s) (strLen suf)) (strLen suf)) suf)))

(pub :: lspFixDropEnd (-> String Int String))

(pub fn (lspFixDropEnd s k) (strSlice s 0 (- (strLen s) k)))

