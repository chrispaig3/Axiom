; explain.ax - `axiom explain`, self-hosted.
;
; The AX1xxx-AX5001 texts were GENERATED from the stage0 binary's own
; output, one cached run per code, so they could not drift by
; transcription. That compiler is gone and `axiom-errors/src/code.rs`
; with it, so codes added after it - AX3018 through AX3022, the macro
; expansion refusals, AX3023, AX3024 and AX3025 - are written HERE
; and are the origin. The rule
; that replaces the regeneration loop: a new code needs a row in
; `explainListText`, an arm in `explainText`, and a re-run of
; `scripts/check-tools-selfhost.sh`'s golden, which is what catches
; either one being forgotten.
;
; The lookup normalises the way stage0's `lookup` does: trim ASCII
; whitespace, uppercase, strip a leading `AX`, strip leading dashes -
; so `ax3001`, `3001` and `AX-3001` all answer AX3001.
(import Str)

; The `--list` text, byte-for-byte stage0's.
(pub :: explainListText String)

(pub fn (explainListText) "Known Axiom diagnostic codes:\n  AX1001  unexpected character  (unexpected-char)\n  AX1002  unterminated string literal  (unterminated-string)\n  AX1003  unterminated character literal  (unterminated-char)\n  AX1004  invalid number literal  (invalid-number-literal)\n  AX1005  invalid escape sequence  (invalid-escape-sequence)\n  AX2001  unexpected token  (unexpected-token)\n  AX2002  unexpected end of file  (unexpected-eof)\n  AX2003  syntax error  (syntax-error)\n  AX2004  removed language construct  (removed-construct)\n  AX2005  nesting too deep  (recursion-limit)\n  AX2006  a module-path segment that is a file path  (module-path-segment)\n  AX3001  undefined variable  (undefined-variable)\n  AX3002  undefined type  (undefined-type)\n  AX3003  undefined constructor  (undefined-constructor)\n  AX3004  type mismatch  (type-mismatch)\n  AX3005  non-exhaustive pattern match  (non-exhaustive-match)\n  AX3006  duplicate definition  (duplicate-definition)\n  AX3007  field not found  (field-not-found)\n  AX3008  semantic error  (semantic-error)\n  AX3009  constructor arity mismatch  (constructor-arity-mismatch)\n  AX3010  agent metadata mismatch  (axtag-mismatch)\n  AX3011  effect mismatch  (effect-mismatch)\n  AX3012  cannot assign to an immutable binding  (assign-to-immutable)\n  AX3014  a bare name is defined in more than one imported module  (ambiguous-name)\n  AX3015  a signature with no definition behind it  (missing-definition)\n  AX3013  partial application is not supported  (partial-application)\n  AX3016  a handle list names an effect that is not declared  (unknown-effect)\n  AX3017  an effect-handler shape the compiler does not support yet  (effect-handler-unsupported)\n  AX3018  an invocation no macro rule accepts  (macro-arity)\n  AX3019  macro expansion did not terminate  (macro-recursion-limit)\n  AX3020  a macro declares the same parameter twice  (macro-duplicate-parameter)\n  AX3021  a macro template contains a form the expander cannot substitute into  (macro-template-unsupported)\n  AX3022  a macro parameter used as a `set` target was given an expression  (macro-set-target)\n  AX3023  a name its module does not export  (private-name)\n  AX3024  macro expansion produced more than the limit  (macro-expansion-limit)\n  AX3025  a trait implementation the compiler cannot use  (trait-impl)\n  AX3026  a name the emitted runtime owns  (reserved-runtime-name)\n  AX3027  a declaration-macro invocation the expander cannot resolve  (declaration-macro)\n  AX3028  a syntax/* query with no answer  (syntax-query)\n  AX3029  a declaration too wide for the reference map  (record-bitmap-capacity)\n  AX3030  too many type variables for one evidence word  (evidence-word-capacity)\n  AX3031  malformed format string  (malformed-format-string)\n  AX3033  a macro rule that can never match  (macro-unreachable-rule)\n  AX3034  an ellipsis used at the wrong depth  (macro-ellipsis)\n  AX3035  a macro parameter used as a binder was given something that is not a variable  (macro-binder-target)\n  AX3036  an `extern` item's type cannot cross the boundary  (extern-type)\n  AX3037  an AXTAG claim the effect walk is not in a position to check  (axtag-unverifiable)\n  AX3038  a handled-effects list the effect walk is not in a position to check  (effect-unverifiable)\n  AX3039  an AXTAG key one slip from a key the compiler checks  (axtag-key-typo)\n  AX3040  a type variable returned that no parameter mentions  (result-only-tyvar)\n  AX3041  an `extern` block's library name that is not one  (extern-library-name)\n  AX3044  a bare TYPE name is declared in more than one imported module  (ambiguous-type)\n  AX4001  no `main` function  (missing-main)\n  AX4002  code generation failed  (codegen-failure)\n  AX4003  external toolchain command failed  (toolchain-failure)\n  AX4004  an `extern` names a symbol no archive defines  (ungrounded-symbol)\n  AX4005  an `extern` item's shape disagrees with the crate's shim  (extern-shape)\n  AX5001  cannot resolve import  (module-not-found)\n")

; The explanation for a NORMALISED code (digits only), or "" when
; the code is unknown.
(pub :: explainText (-> String String))

(pub fn (explainText c)
  (if (strEq c "1001")
    "AX1001 - unexpected character\n\nThe lexer found a character that cannot start any valid Axiom token.\nAn identifier is letters, digits, `_`, `'` and the operator characters\n`+ - * / % < > = ! & | ^`, and cannot begin with a digit or `'`.\nOperators are not a separate lexical class - `+` is an identifier - so\n`set!`, `foo'` and `empty-list` are ordinary names. `?`, `~` and `@` are\nnot identifier characters at all, and `#` is one only as the `#|` that\nopens a block comment. Check for typos, stray punctuation copied from\nanother language, or an unsupported Unicode character.\n\n"
    (if (strEq c "1002")
      "AX1002 - unterminated string literal\n\nA `\"` was opened but never closed before the end of input (or end of\nline). Add a matching closing `\"`, or escape an embedded `\"` as `\\\"`.\n\n"
      (if (strEq c "1003")
        "AX1003 - unterminated character literal\n\nA `'` character literal must contain exactly one character (or escape)\nfollowed by a closing `'`, e.g. `'a'` or `'\\n'`.\n\n"
        (if (strEq c "1004")
          "AX1004 - invalid number literal\n\nThe digits form a number literal that doesn't fit the expected numeric\nformat (e.g. it overflows i64/f64, or has a malformed exponent).\n\n"
          (if (strEq c "1005")
            "AX1005 - invalid escape sequence\n\nOnly `\\n`, `\\t`, `\\r`, `\\\\`, `\\\"`, `\\'` and `\\0` are recognized escape\nsequences inside string and character literals.\n\n"
            (if (strEq c "2001")
              "AX2001 - unexpected token\n\nThe parser expected one kind of token (based on the surrounding\ngrammar) but found something else. This is usually a missing/extra\nparenthesis, a misspelled keyword, or a declaration in the wrong\nposition.\n\n"
              (if (strEq c "2002")
                "AX2002 - unexpected end of file\n\nThe file ended while a form was still open, most commonly an\nunbalanced `(`, `[` or `{`. Count opening vs. closing delimiters\nworking backward from the end of the file.\n\n"
                (if (strEq c "2003")
                  "AX2003 - syntax error\n\nA syntax rule was violated in a way that doesn't fit a more specific\ndiagnostic code; see the message for details.\n\n"
                  (if (strEq c "2004")
                    "AX2004 - removed language construct\n\nThis form was part of an earlier version of Axiom and no longer exists.\nThe keyword is still reserved so that old source gets this explanation\ninstead of being silently reinterpreted as an ordinary identifier.\n\n`union` is gone because C interoperability is no longer a goal of the\nlanguage. An untagged union cannot be pattern-matched safely and has no\nmeaning under linear typing, where every value has exactly one owner and\none type. Use `data` for a tagged sum, whose variants the compiler can\ncheck for exhaustiveness, or `struct` for a product.\n\n`foreign` is gone because it never worked: a binding emitted a call to\na symbol the module never declared, so a program that used one passed\n`check` and then died inside `opt` or the linker.\n\nIt is NOT the FFI under a new name, and the FFI is not a revival of it.\nAxiom binds Rust through an `extern` BLOCK:\n\n  (pub extern \"axiom_demo\"\n    (add :: (-> Int Int Int) (symbol \"axffi_add\")))\n\nbuilt with `--link-lib` and `--link-search`. The emitter writes a\n`declare` for each item, which is the entire difference. See\n`docs/ffi.md`.\n\nA program that declares no `extern` still links no C library at all,\nand so does one bound to a `no_std` Rust crate - measured, `nm -u` on\nboth is empty. Reaching the kernel needs no FFI either: the standard\nlibrary is written in Axiom over `__syscall0`-`__syscall6`.\n\n`region` is gone because memory is no longer scoped by an explicit\nsource-level block. Allocation lifetime is inferred: a value's arena is\ndetermined by where it is created and how far it escapes, and it is\ndropped deterministically at the end of that arena. Delete the `region`\nwrapper; the body is the program.\n\n`deriving` is refused rather than removed: the clause parsed and was\nsilently DISCARDED from the day it was written - its names never\nreached the AST, no instance was ever derived, and a program carrying\none checked OK. A clause that does nothing is worse than one that does\nnot parse. Derive instances explicitly, where you want them:\n`(deriveEq T)` is an ordinary declaration macro, and the instance it\ngenerates is checked, compiled, and dispatched like a written one\n(docs/macro-system.md MAC-CAP-9).\n\n"
                    (if (strEq c "2005")
                      "AX2005 - nesting too deep\n\nA form nests more deeply than the parser's fixed limit. Every stage\nafter the parser walks the syntax tree recursively, so an unbounded\nnesting depth is an unbounded native stack depth; the limit converts\nwhat would otherwise be a stack overflow - a crash with no span and no\nmessage - into this diagnostic, pointing at the token where the limit\nwas reached.\n\nHand-written code effectively never reaches the limit. Generated code\ncan: a long chain built by folding a binary operator over a list nests\nonce per element. Emit a `let` chain, a `{}` block, or a balanced tree\ninstead of one deeply nested form.\n\n"
                      (if (strEq c "2006")
                        "AX2006 - a module-path segment that is a file path\n\nAn `(import M)` names a MODULE, and the compiler resolves that name\nagainst its search directories: the entry file's own directory first,\nthen each `AXIOM_PATH` entry, then the standard library. A dot\nseparates the parts of a nested name - `Sys.Platform` is the module in\n`Sys/Platform.ax` - and rewriting that `.` into a `/` is the\nresolver's job, not the author's.\n\nA `/` inside a segment is refused because it defeats that resolution\nentirely. A candidate file is formed by concatenating a search\ndirectory onto the name, and a name that is already a path simply\nre-anchors it: `(import /etc/x)` reads `/etc/x.ax` and\n`(import ../../x)` climbs out of the project. Neither is an import of\na module, and both used to be accepted with `check` printing `OK`.\n\nWrite the dotted name, and put the directory that holds the module on\n`AXIOM_PATH` or beside the entry file.\n\n`/` remains an ordinary identifier character everywhere else, because\nthe compiler's own `syntax/format` and `syntax/join` are spelled with\none. Only a module path is constrained, and only a module path is\nturned into a filename.\n\n"
                        (if (strEq c "3001")
                          "AX3001 - undefined variable\n\nNo binding with this name is in scope: not a local `let`/`lambda`\nparameter, not a top-level `define`/`fn`, and not a data constructor.\nCheck for typos, missing imports, or a definition that appears later\nin the file (Axiom does not forward-reference local bindings).\n\n"
                          (if (strEq c "3002")
                            "AX3002 - undefined type\n\nThis type name does not refer to any built-in type, `data`, `struct`,\nor `type` alias visible in this module.\n\n"
                            (if (strEq c "3003")
                              "AX3003 - undefined constructor\n\nThis name was used as a data constructor (applied like `(Foo x y)` or\nmatched in a pattern) but no `data` declaration defines a constructor\nwith this name.\n\n"
                              (if (strEq c "3004")
                                "AX3004 - type mismatch\n\nAn expression's inferred type doesn't match the type required by its\ncontext (a function parameter, `if` branch, `let` binding, etc.).\n\n"
                                (if (strEq c "3005")
                                  "AX3005 - non-exhaustive pattern match\n\nA `match` expression does not cover every possible constructor/value of\nthe scrutinee's type. Add the missing arms or a wildcard `_` arm.\n\n"
                                  (if (strEq c "3006")
                                    "AX3006 - duplicate definition\n\nThe same name is defined more than once at the same scope. Rename one\nof the definitions or remove the duplicate.\n\n"
                                    (if (strEq c "3007")
                                      "AX3007 - field not found\n\nThe named field does not exist on the given `struct` type. Check the\nfield name for typos or that you're accessing the right type.\n\n"
                                      (if (strEq c "3008")
                                        "AX3008 - semantic error\n\nA semantic rule was violated in a way that doesn't fit a more specific\ndiagnostic code; see the message for details.\n\n"
                                        (if (strEq c "3009")
                                          "AX3009 - constructor arity mismatch\n\nA data constructor was applied (or matched in a pattern) with the wrong\nnumber of arguments. Check the constructor's `data` declaration for how\nmany fields it actually has.\n\n"
                                          (if (strEq c "3010")
                                            "AX3010 - agent metadata mismatch\n\nA `;@axiom:<key>(<value>)` tag on this declaration makes a claim\n(e.g. `effect(io)`, `pure`) that the body does not support. The\ncompiler validates tags it can and reports mismatches so an agent\ncan correct the annotation instead of silently trusting it.\n\n"
                                            (if (strEq c "3011")
                                              "AX3011 - effect mismatch\n\nThe body of a `handle` expression performs effects that its\nhandled-effects list does not name. List every effect the body\ncan perform, or move the unhandled operation outside the\n`handle`.\n\n(Effects do not appear in function signatures; a function's\neffect claims are made with `;@axiom:effect(...)` tags and\nvalidated as AX3010.)\n\n"
                                              (if (strEq c "3012")
                                                "AX3012 - cannot assign to an immutable binding\n\n`set` stores into a local, and a local is assignable only if it was\nintroduced as `(let ((mut x ...)) ...)`. Immutable is the default, so\na binding that is never reassigned needs no annotation and cannot be\nchanged by accident.\n\nAdd `mut` at the declaration, or - usually better - compute the value\nyou want with a `let` rather than mutating one you already have.\n\nOnly a whole local can be assigned. Function parameters, pattern\nbindings and top-level declarations are never mutable, and structure\nfields are written with `memSetWord` instead.\n\n"
                                                (if (strEq c "3013")
                                                  "AX3013 - partial application is not supported\n\nA top-level function was applied to fewer arguments than its\ndefinition declares, or a function of two or more parameters was\nused as a bare value. Both are well-typed under currying, but the\ncompiled representation has no way to hold the missing arguments:\na call site would simply omit them, and the callee would read\nwhatever happened to be in the argument registers - which is how\nthis used to run and crash instead of being reported.\n\nBind the missing arguments with a lambda instead: where `(f x)`\nwas meant, write `(lambda (y) (f x y))`. A lambda captures `x` in\na closure record, which is the representation partial application\nwould need and lambdas already have. Saturated calls, calls with\n*extra* arguments applied to a returned function value, and\none-parameter functions used as values are all unaffected.\n\n"
                                                  (if (strEq c "3014")
                                                    "AX3014 - a bare name is defined in more than one imported module\n\nTwo or more imported modules define this name and the entry file\ndoes not, so a bare reference has no principled winner - and before\nthis diagnostic the compiler's stages genuinely disagreed about\nwhich definition it meant, so a program could type-check against\none module's signature and run the other module's code.\n\nQualify the reference as `Module::name` to pick explicitly, or\nimport only the names you want with `(import Module (name ...))`.\nA name the entry file defines itself always resolves to the entry\nfile's definition and needs no qualification.\n\n"
                                                    (if (strEq c "3015")
                                                      "AX3015 - a signature with no definition behind it\n\nA `(:: name Type)` signature declares a name; only a `(fn ...)`\ngives it something to run. This name has a signature and no `fn` -\neither the entry file declares the signature and never defines the\nfunction, or an import delivered a `pub` signature whose definition\nstayed private in its module.\nCalling it used to pass `check` and then fail in the native\ntoolchain with an undefined-symbol error about generated code.\n\nAdd the definition, or mark the defining `fn` `pub` alongside its\nsignature so the import carries both.\n\n"
                                                      (if (strEq c "3016")
                                                        "AX3016 - a handle list names an effect that is not declared\n\nThe effects a `handle` expression may name are the built-ins\n(`IO`, `Alloc`, `Mut`, `Div`) and effects introduced by an\n`(effect Name (op :: sig) ...)` declaration in scope. This name\nis neither, so the handle could never intercept or scope\nanything - before this diagnostic it was accepted silently and\ndid nothing.\n\nDeclare the effect, import the module that declares it, or fix\nthe spelling.\n\n"
                                                        (if (strEq c "3017")
                                                          "AX3017 - an effect-handler shape the compiler does not support yet\n\nDynamic handlers currently support exactly one custom effect per\n`handle` expression, and only effects that declare exactly one\noperation; an effect operation is callable but cannot be used as\na bare value (there is no closure representation for dynamic\ndispatch). Nest `handle` expressions to install handlers for\nseveral effects at once, and split multi-operation effects into\none effect per operation until per-operation handler syntax\nexists.\n\n"
                                                          (if (strEq c "3018")
                                                            "AX3018 - wrong number of arguments to a macro\n\nA macro is applied to exactly as many arguments as its head declares\nparameters. It is not a function and does not curry: an invocation is a\nREWRITE, and the rewrite has nowhere to put an argument it was given no\nparameter for.\n\nBoth mismatches used to be accepted. A missing argument left the\nparameter's own name standing in the generated code, so\n`(macro (two p q) (+ p q))` invoked as `(two 40)` emitted\n`add i64 40, %q` and the native toolchain rejected it with an undefined\nvalue - an error about generated code, carrying no span into the\nsource. A surplus argument was dropped WITHOUT being evaluated, so its\nside effects silently did not happen.\n\nCount the parameters and pass that many.\n\nTHE RULE FORM IS NOT ONLY ABOUT COUNTING, since MAC-LANG-15 made a\nrule's parameters PATTERNS and MAC-LANG-18 made selection a match.\nThere the message reads\n\n    no rule of macro `defN` matches this invocation;\n    it accepts (defN (a b)) or (defN T 7)\n\nand the invocation may well have passed a count some rule\ndeclares - what failed is the SHAPE of an argument, or the value of\na literal the pattern spells out. The shapes listed are the rules'\nown patterns as their author wrote them; a plain identifier in one\nmatches anything, and everything else has to be written as it\nstands.\n\nThe code and its `macro-arity` slug are shared deliberately rather\nthan split, because MAC-LANG-18 specifies this generalisation by\nname - \"the arity diagnostic AX3018 generalised. Today's AX3018\nbecomes the one-rule case of it\". The slug is narrower than the\ncondition it now carries, and that is the cost of keeping a stable\ncode the specification names. (The unreachable-RULE refusal went\nthe other way and took a new code, AX3033, because nothing\nspecified it sharing AX3020 - see that entry.)\n\n"
                                                            (if (strEq c "3019")
                                                              "AX3019 - macro expansion did not terminate\n\nExpanding this macro reached the depth limit of 128. Expansion repeats\nuntil no invocation is left, so a macro that always rewrites to an\ninvocation of itself - directly, or through a second macro that\nrewrites back - never finishes.\n\nBefore the limit existed this crashed the compiler: `(macro (loopy x)\n(loopy x))` segfaulted with no diagnostic and no output, in about 10 ms\nof CPU time.\n\nA macro cannot recurse on its arguments the way a function can, because\nthere is no test the expander can evaluate to stop. Write the recursion\nas a function and let the macro expand to a call.\n\n"
                                                              (if (strEq c "3020")
                                                                "AX3020 - a macro declares the same parameter twice\n\nTwo parameters of this macro share a name, so a reference to that name\nin the template has no single meaning. The expander resolves it to the\nLAST argument, which means the earlier ones are accepted, evaluated in\nsource order, and then discarded - measured: `(macro (dup a a) (+ a a))`\ninvoked as `(dup 10 20)` answered 40.\n\nSince MAC-LANG-15 a rule-form macro's parameters are PATTERNS, so\nthe binders this counts are every binder the patterns introduce,\nnested ones included: `((m a (f a)) ...)` binds `a` twice and is\nthis code. `_` is exempt - it binds nothing, so several of them in\none rule are legal.\n\nA rule that can never MATCH is a different thing and a different\ncode (AX3033). This one used to cover both.\n\nGive each parameter a distinct name.\n\n"
                                                                (if (strEq c "3021")
                                                                  "AX3021 - a macro template contains a form the expander cannot substitute into\n\nThe expander rebuilds a template node by node, replacing parameter\nreferences with the arguments' syntax. This template contains a form it\nhas no case for, so it refused rather than emit the template's own\nidentifiers into the generated code.\n\nThis is a compiler limitation, not a mistake in the program, and it\nexists to be loud. The eight silent miscompiles it replaced were all\nthe same bug: a form was added to the language and not to the expander,\nwhose default was to return the node unchanged - which compiled, and\nproduced code referring to names that existed only inside the macro.\n\nRewrite the template without the form, or add a case for it to\n`substTpl` in `self_host/expand.ax`.\n\nA DECLARATION template has the same code with a fixed list: it may\ngenerate `fn`, `::`, `data`, `struct`, `type`, `effect` and `impl`\ndeclarations, further macro invocations, and a `syntax/for` over\nthem. An `import` template and a nested `macro` refuse, at the\nMACRO's own line rather than at an invocation, because a template\nkind is a property of the macro. Both are refusals by DECISION\nrather than by schedule: an `import` inside a template would reopen\nmodule resolution, which has already run when declaration expansion\nstarts, and a nested `macro` would reopen the fixpoint that expands\nit. A `trait` template does not reach this code at all - a trait\ndeclaration inside a template is AX2003, from the parser.\n\nThis paragraph named `type`, `trait`, `effect` and `import` as the\nfour refusals until 2026-08-16. `type` and `effect` became template\nkinds on 2026-08-15 and this list was not swept - which the sentence\nafter it gave away, naming a nested `macro` as one of \"those four\".\n\n"
                                                                  (if (strEq c "3022")
                                                                    "AX3022 - a macro parameter used as a `set` target was given an expression\n\n`set` assigns to a binding, so its target has to be a name. Where a\ntemplate writes `(set p v)` and `p` is a macro parameter, the argument\npassed for `p` has to be a plain identifier; this call passed an\nexpression, which names no binding to assign to.\n\nPass a variable for that parameter, or rewrite the template so the\nparameter is not a `set` target.\n\n"
                                                                    (if (strEq c "3023")
                                                                      "AX3023 - a name its module does not export\n\nThe name exists. It is declared in another module, and that module\ndoes not make it visible: either its declaration is not written `pub`,\nor the `(import M (a b))` that brought the module in does not list it.\n\nA module's declarations are all carried into the program - its own\nbodies have to be able to call its own helpers - and `pub` decides\nonly which of them anything ELSE may name. Before that split the two\nwere one decision, and a private declaration was simply deleted: the\nmodule's own calls to it became `AX3001 undefined variable` reported\nat the library's own lines, in a file that merely imported it, and if\nthe importing program happened to define that name, the module's call\nlanded on the importer's definition instead - silently, at exit 0.\n\nWrite `pub` on the declaration, add the name to the import's list, or\ncall something the module does export.\n\n"
                                                                      (if (strEq c "3024")
                                                                        "AX3024 - macro expansion produced more than the limit\n\nExpansion is a rewrite, so the program the compiler sees is the\nexpanded one, and this expansion produced a tree too deep or too large\nto process. Three limits apply and the message says which was reached.\n\nDEPTH is 1024 forms, the same number the parser refuses source at\n(AX2005). It has to be checked separately because the parser measures\nthe SOURCE: a 500-deep template invoked 120 times nests 620 in the file\nand 60,000 in the tree, and only the second number overflows the stack.\nBefore this limit that input crashed `check`, `run`, `symbols` and the\nlanguage server with no output at all.\n\nSIZE is 2,000,000 forms, and no depth limit can see what it catches:\n`(macro (m x) (+ x x))` doubles per level, so 26 nested invocations are\n154 bytes of source and 2**26 forms. That took 41 seconds and the\nlanguage server never answered.\n\nDECLARATIONS is 10,000, and it is a separate axis because the other\ntwo are counted inside expression expansion while the DECLARATION\nphase runs first: a template that generates declarations reaches\nneither counter. Depth was covered there anyway - a declaration macro\nthat regenerates its own invocation is AX3019 after 128 rounds - so\nwhat was missing was width. A template generating three invocations\nof itself per round reached 3.4 GB in one second and was killed by\nthe operating system, with no diagnostic and no output at all.\n\nAll three are far above any real macro - the whole of `stdlib/Pre.ax`\nexpands to depth 1, and the largest generated declaration count in\nthis repository is 80. Make the macro produce less, or write the\nrepeated part as a function and let the macro expand to a call: a\nfunction is compiled once however many times it is called, which is\nthe whole difference.\n\n"
                                                                        (if (strEq c "3025")
                                                                          "AX3025 - a trait implementation the compiler cannot use\n\nA trait is a set of method signatures written against one type\nparameter; an `impl` gives those methods a body for one concrete type.\nThe pair (trait, type) is what a call is dispatched on, so both halves\nhave to be there and have to agree. This code covers every way they do\nnot:\n\n  - the `impl` names a trait that is not in scope\n  - it defines a method the trait does not declare\n  - it does not define one the trait does declare and the trait\n    supplies no default body for it\n  - the trait has no type parameter, so there is nothing to key an\n    implementation on\n  - a call has no implementation for the type of its dispatch argument\n  - a method mentions the trait's parameter in no parameter position,\n    so no argument can select an implementation - there is no\n    return-type-directed dispatch\n\nDispatch is by the STATIC type of the argument at the call site, and it\nis resolved at compile time: the call becomes a direct call to that\nimplementation, with no table and no indirection. A type variable is\nnot a type, so a function that is generic over the trait cannot yet\ncall its methods.\n\n"
                                                                          (if (strEq c "3026")
                                                                            "AX3026 - a name the emitted runtime owns\n\nA compiled Axiom program contains its own runtime - the allocator, the\ntraps, the arena primitives, and since 2026-08-15 the reference-count\nprimitives - emitted into the module it is built from. `axiom_alloc`\nis the allocator's symbol, and `axiom_retain`/`axiom_release` are the\nownership primitives' (docs/memory-model.md MM-LIFE-2b). The backend\nemits all three definitions unconditionally, so a program defining\nany of the names is two definitions of one symbol.\n\nBefore this refusal that program passed `check` and died in `opt`\nwith `invalid redefinition of function 'axiom_alloc'` - the\ndocumented \"override seam\" that never worked. The seam does not\nexist; whether it should is re-decided with the reclamation work.\nSee docs/memory-model.md MM-ALLOC-8.\n\nOnly an entry-file definition collides: a module's declaration is\nmangled to `Mod$axiom_alloc`, a different symbol.\n\n"
                                                                            (if (strEq c "3027")
                                                                              "AX3027 - a declaration-macro invocation the expander cannot resolve\n\nA top-level form whose head is not a declaration keyword is a\nDECLARATION MACRO INVOCATION: the head must name a visible rule-form\nmacro - `(macro name ((name args ...) (fn ...) ...))` - whose\ntemplate declarations are instantiated in its place. This code covers\nevery way that fails:\n\n  - the head names no visible macro (a typo'd keyword lands here too,\n    where it used to be a bare `syntax error`)\n  - the head names an EXPRESSION macro, whose template is one\n    expression and cannot stand in declaration position\n  - a declaration macro is referenced in EXPRESSION position - the\n    two template kinds are disjoint\n  - the invocation sits in a pipeline carrying no mangling records -\n    a re-expansion of an already-resolved program - so a module-side\n    invocation there could generate a declaration nothing can name\n  - an argument bound to a NAME position of the template - a\n    declaration head or a parameter list - is not a bare identifier\n\nSee docs/macro-system.md MAC-CAP-8.\n\n"
                                                                              (if (strEq c "3028")
                                                                                "AX3028 - a syntax/* query with no answer\n\nThe `syntax/` spellings are the compile-time QUERY VOCABULARY: a\nclosed, compiler-implemented set of questions a macro template asks\nabout the declaration list, answered at expansion time with no user\ncode running. The vocabulary answers `(syntax/join a b)` in a\ndeclaration NAME position and, applied, as a REFERENCE to what such\na name declares - `((syntax/join show T) x)`; `(syntax/constructors\nT)`, `(syntax/fields S)` and `(syntax/binders C p)` as iteration\nsequences; `(syntax/for (x seq) ...)` where a match ARM, a template\nDECLARATION, or a call ARGUMENT stands, over one sequence or\nseveral zipped in lockstep as `((x xs) (y ys))`; `(syntax/fold f z binds tpl)`\nas the right-fold over one sequence or several zipped in lockstep;\n`(syntax/same f g)` over two iteration variables; and the three\nSCALAR queries `(syntax/name x)`, `(syntax/arity C)` and\n`(syntax/defined n)`, which answer one node where one value is\nneeded. This code covers every way a query has no answer:\n\n  - a `syntax/` head the vocabulary does not implement, or one\n    standing in a position it does not own - the vocabulary is\n    CLOSED, so unknowns refuse by name instead of dying later as\n    undefined variables; a sequence in a one-value position and a\n    syntax/for at expression root land here too\n  - a subject with nothing to answer: constructors of a struct,\n    fields of a data type, binders or an arity of a name that is not\n    a constructor, any of them of a name that declares nothing or of\n    a type its module keeps private\n  - a query ARGUMENT that is neither a bare identifier nor a\n    `(syntax/join a b)` - the one query whose answer is itself a\n    name, and therefore the only one that can feed another's\n    argument\n  - parallel sequences of different lengths, in a syntax/for or a\n    syntax/fold alike - the zip rule is a diagnostic, never a\n    truncation to the shorter\n  - a parallel binding that is not a `(y ys)` pair\n  - syntax/same over variables ranging over DIFFERENT sequences - a\n    false there would be a wrong answer, not a comparison - or over\n    a name no enclosing syntax/for binds\n  - a query written OUTSIDE a macro template - a (syntax/join ...)\n    name, a syntax/for arm, or a top-level syntax/for in ordinary\n    code has no instantiation to resolve it\n  - a declaration NAMED into the reserved `syntax/` prefix, including\n    the near-miss `(fn (syntax/join a b) ...)` - one paren short of a\n    joined name, which would otherwise silently declare a function\n    called syntax/join\n\nSee docs/macro-system.md MAC-CAP-5 and MAC-CAP-6.\n\n"
                                                                                (if (strEq c "3029")
                                                                                  "AX3029 - a declaration too wide for the reference map\n\nEvery heap block born of `axiom_alloc` carries a 16-byte header,\nand the header's shape word packs three fields: the form bit, the\nblock's padded payload word count, and - for the record form - one\nbit per payload word saying whether that word is a REFERENCE the\nrelease path must follow (docs/memory-model.md MM-LIFE-2d). Bits\n16..62 carry the map; bit 63 is the i64 sign bit, reserved so every\nshape constant the compiler emits is non-negative. That gives 47\nmappable payload words: a struct may declare 47 fields, and a data\nconstructor 46 beside its tag word.\n\nA declaration past the cliff is REFUSED at check time rather than\ntruncated at run time - a map that silently dropped its widest\nfield would free everything it named and leak the one it could\nnot. The largest declaration in this repository, the 37-field CG\nrecord in the compiler's own code generator, fits with a quarter\nof the map to spare; the cliff is far from real programs.\n\nThe escape hatch is structural: split the declaration. A nested\nstruct or constructor cell is ONE word of the outer block - the\nwalk follows the pointer, and the inner block carries its own map -\nso any record too wide for one map becomes two that fit.\n\nSee docs/memory-model.md MM-LIFE-2d.\n\n"
                                                                                  (if (strEq c "3030")
                                                                                    "AX3030 - too many type variables for one evidence word\n\nA polymorphic function receives one hidden machine word beside its\narguments: bit i says whether type parameter i is instantiated at a\nREFERENCE type, and the reference maps of MM-LIFE-2d read those\nbits where a declared type is a variable (docs/memory-model.md).\nOne word carries 64 bits, so a declaration may introduce at most 64\ntype variables.\n\nThe cap is soundness, not tidiness: a variable's bit is read with a\nshift by its index, and a shift of 64 or more is poison in the\nemitted LLVM - an arbitrary answer at run time, which under\nreference maps becomes a wrong free. A sixty-fifth variable is\ntherefore refused at the declaration, on the merged declaration\nlist, imported modules included. The widest signature in this\nrepository declares 4.\n\nSignatures whose every variable appears only in RETURN position\ntake no evidence word at all - no argument can ever witness one -\nso the hottest accessors are exempt from the hidden argument\nentirely; the cap still applies to the declaration's spelling.\n\nSee docs/memory-model.md MM-LIFE-2d.\n\n"
                                                                                    (if (strEq c "3031")
                                                                                      "AX3031 - malformed format string\n\nA format string is parsed at EXPANSION time, by the compiler,\nbefore the program is type-checked - so a hole that names nothing,\na brace that never closes, and a stray `}` are all compile errors\nrather than runtime surprises. This is the whole reason the\nprinting macros exist: `(println \"x = {x}\")` is a rewrite into\n`strConcat` and `show` calls, and there is no runtime format\nparser to fail in.\n\nThe grammar is small on purpose:\n\n  {name}   interpolate the binding `name`, in scope AT THE CALL\n  {{       a literal `{`\n  }}       a literal `}`\n\nA hole holds a bare name and nothing else. There are no positional\nholes (`{}`, `{0}`) and no argument list: capture is the form the\nlanguage has. A variadic `println` is buildable since a rule may\nrepeat (docs/macro-system.md MAC-LANG-16, 2026-08-16) and is\nunbuilt; this paragraph said repetition did not exist until then.\n\nA hole MAY carry a specifier, and the compiler picks the `Fmt` call\nat expansion time rather than leaving it to you:\n\n  {n:x}      (fmtHex n)\n  {x:.2}     (fmtFloatPrec x 2)\n  {n:>8}     (fmtPadLeft (show n) 8)\n  {s:<12}    (fmtPadRight (show s) 12)\n  {s:^12}    (fmtPadCenter (show s) 12)\n  {n:04}     (fmtPadZerosLeft (show n) 4)\n  {x:>10.2}  (fmtPadLeft (fmtFloatPrec x 2) 10)\n\nThis paragraph said there were no specifiers and told you to build\nthe padded or rounded string by hand with `fmtPadLeft`,\n`fmtFloatPrec` or `fmtHex` - the calls the specifier now emits for\nyou. It said so until 2026-08-16, a day after they shipped.\n\nA hole whose name is not in scope is AX3001, and one whose type\nhas no `Show` instance is AX3025; neither is this code. This code\nis only for a string the parser could not make holes out of at\nall.\n\nSee docs/macro-system.md MAC-CAP-10.\n\n"
                                                                                      (if (strEq c "3033")
                                                                                        "AX3033 - a macro rule that can never match\n\nA rule-form macro's rules are tried IN ORDER and the first whose\npattern matches wins (docs/macro-system.md MAC-LANG-18). A rule\nnothing can reach is therefore a program someone wrote expecting it\nto run, and this code refuses it at the macro's own line rather than\nletting it sit there looking live.\n\nA rule is unreachable when an EARLIER rule of the same arity is\nIRREFUTABLE - every one of its elements is a plain binder, so it\nmatches every invocation of that arity and consumes them all.\n\n    (macro defU ((defU T)      ; matches any one argument\n                 ...)\n                ((defU (a b))  ; AX3033: nothing reaches it\n                 ...))\n\nSwap them and both are reachable: `(defU (a b))` fails on an\nargument that is not a two-element form, and `(defU T)` then takes\neverything else. Ordering a pattern table from most specific to most\ngeneral is the shape this diagnostic is steering toward.\n\nTwo rules of one arity are NOT refused by themselves. That was the\nolder rule, when arity was the whole selector and this condition\nshared AX3020 with a repeated parameter; patterns made the two\ndifferent claims, so they became different codes. A macro whose\nrules all take one argument and are told apart by shape is exactly\nwhat the pattern language is for.\n\n"
                                                                                        (if (strEq c "3034")
                                                                                          "AX3034 - an ellipsis used at the wrong depth\n\nA rule's last element may REPEAT: `(m T v ...)` takes one argument\nand then any number, and `v` is bound to all of them at once\n(docs/macro-system.md MAC-LANG-16). A name bound that way is many\nforms, not one, and the template has to say where they go.\n\n    (macro mk ((mk T v ...)\n       (:: (syntax/join make T) T)\n       (fn ((syntax/join make T)) (T v ...))))\n\n    (mk Pair 1 2)      ; (Pair 1 2)\n    (mk Trip 3 4 5)    ; (Trip 3 4 5)\n\nFour ways to get the depth wrong, and this code is all of them:\n\n  - the template names a repeating element with no `...` after it.\n    That position takes ONE form and the name is many, so there is\n    nothing to put there. Add `...`, or stop the element repeating.\n  - `...` follows something that does not repeat - a fixed element,\n    or nothing at all. There is no sequence to splice.\n  - a rule declares more than one `...`. A repeating element absorbs\n    every argument left after the fixed ones, so a second has nothing\n    defined to take, and where the split fell would be the expander\n    guessing.\n  - a rule repeats a PATTERN rather than a bare name. v1 binds ONE\n    name to the forms a repeat absorbs; repeating `(a b) ...` would\n    bind `a` and `b` to a sequence each, in lockstep, which is a\n    second feature and is not built.\n\nThe first two are reported at the invocation, the last two at the\nmacro's own line - the place each author can act on.\n\n`...` is an ordinary identifier to the lexer, spelled with three\ndots. That is why it stands beside the name it repeats rather than\ngluing to it, and why a single `.` still means field access.\n\n"
                                                                                          (if (strEq c "3035")
                                                                                            "AX3035 - a macro parameter used as a binder was given something that is not a variable\n\nA template may put a macro parameter in a BINDER position - a `let`\nbinding, a `lambda` parameter, or a pattern binder in a match arm:\n\n    (macro (try! x e body)\n      (match e\n        ((Err er) (Err er))\n        ((Ok x) body)))\n\n    (try! v (parse s) (use v))\n\nThe parameter names the binding the CALLER wants, so the expansion\nbinds `v` and the caller's body reads `v`. That only works if the\nargument is a name: handed `(try! (f 1) ...)` there is nothing to\nbind, and the invocation is refused here rather than expanded into an\narm that binds an application.\n\nThis is the same rule `set` targets follow (AX3022), for the same\nreason - a position that takes a NAME cannot take an expression, and\na macro parameter is the one way an expression can arrive in one.\n\nA binder the TEMPLATE introduces is unaffected. It is renamed at every\nexpansion so it cannot capture a name the caller passed in, which is\nthe forward half of hygiene; a parameter in binder position is the\nopposite case, where the caller named the binding and must be able to\nread it (docs/macro-system.md MAC-HYG-10).\n\n"
                                                                                            (if (strEq c "3036")
                                                                                              "AX3036 - an `extern` item's type cannot cross the boundary\n\nThe Rust boundary is one machine word per argument and one word back:\nevery Rust shim `#[axiom_export]` generates is `extern \"C\" fn(i64, ...) -> i64`,\nand the emitted call is the same `call i64` an Axiom function gets. So an\n`extern` item's signature may name only the types that ARE one word with a\nmeaning both sides agree on: `Int`, `Float` (its IEEE-754 bits), `Bool`,\n`Char`, `String` (a handle Rust reads zero-copy) and `Foreign` (a word\nRust owns).\n\nA type variable, a tuple, a list, a function-typed argument whose leaves\nare not all words (a callback is an arrow over `Int`, `Float`, `Bool` and\n`Char`, arity one to three - `(-> Int Float)` - and crosses as the closure\nrecord Rust calls through `AxFn1`..`AxFn3`), or a declared type -\n`(Option Int)`, `(Result a e)`, `Handle`, a user `data` or `struct` - has no\ncrossing the emitter could write. Until 2026-08-22 such a signature\nwas accepted as written, and every caller then trusted a description the\nboundary could not honour.\n\nWhat to do instead: a Rust value of any other shape crosses as a `Foreign`\nhandle, and the ergonomic surface is the wrapper `axiom-bindgen` generates\n(docs/ffi.md): a `String` result is copied into an Axiom `String`, a\n`Result` or `Option` comes back through a status word and an out-cell, and\nan opaque Rust type becomes a `Handle` inside a generated `data` type whose\ndeath runs the Rust destructor.\n\n"
                                                                                              (if (strEq c "3037")
                                                                                                "AX3037 - an AXTAG claim the effect walk is not in a position to check\n\nA `;@axiom:pure` or `;@axiom:effect(pure)` claim on a function whose\nbody CALLS A VALUE the walk could not resolve. Three shapes reach it:\na head that is not a name (`((b.f) x)`, an `if` or `match` in head\nposition); a `let` bound to anything but a name or a lambda literal;\nand a pattern binder (`(match h ((Wrap f) (f 7)))`). They are one\nroute wearing three spellings - a function value goes into memory in\none place and is called in another, with no call edge in between for\nthe walk to follow.\n\nA lambda's own parameter is marked the same way and is currently\nunreachable: a called lambda parameter does not type-check\n(`AX3004`, `expected function type, found _tN`), because inference\nnever gives one a function type. The marker is set regardless, since\nthe alternative spelling would CLAIM the binder was attributed\nsomewhere, and it is not.\n\nThis is not the claim being wrong. It is the claim being unCHECKABLE\nhere, and the two need different answers - correct the tag, or resolve\nthe call - which is why this is not AX3010.\n\nThe silence it replaced was the worse half of a real hole. The effect\nwalk answers a lower bound; a claim of ABSENCE cannot be validated\nagainst a lower bound, and `pure` is exactly that claim. So\n\n    (struct Box (f : (-> Int Int)))\n\n    ;@axiom:pure\n    (fn (runner b) ((b.f) 7))\n\ncompiled clean, ran, and wrote to stdout, while `symbols` printed\n`#pure` with no `#effects=` beside it - the analysis asserting\nprecisely what it had failed to look at. The sentinel that records an\nunresolved call (`effIncomplete`) had been in the source since the\neffect walk was written, skipped by two consumers and produced by\nnobody: `git log -S` puts its last producer's removal in f6ddc2e,\nwhere effect polymorphism replaced it and the completeness gate its\nown comment describes went with it.\n\nWhat to do: name the function at the call site so the walk can\nfollow it, or drop the claim. A claim that cannot be checked is worth\nless than no claim, because a reader spends trust on it.\n\nThe REVERSE direction is deliberately silent. `;@axiom:effect(io)`\nover an unresolved call is a claim of PRESENCE, and an unresolved\ncall may well be where the IO comes from - reporting `missing IO`\nthere is a mis-report rather than an omission, and this check is\ndocumented as not permitted to make one.\n\n"
                                                                                                (if (strEq c "3038")
                                                                                                  "AX3038 - a handled-effects list the effect walk is not in a position to check\n\nThe body of a `handle` reaches a call the walk could not resolve - a\nfunction loaded from a struct field or a container, or a `let` bound\nto one - so the set of effects it performs is a LOWER BOUND, and a\nhandled-effects list cannot be checked against a lower bound.\n\nAX3011 is the same question answered: it refuses a body KNOWN to\nperform an effect the list does not name. This one cannot know, so it\ninforms instead of refusing - refusing here would make dispatch\nthrough a stored function unwriteable rather than unverified.\n\nIt matters more than the AXTAG case it mirrors. An effect operation\nreached with no handler installed does not fail softly: the process is\naborted with status 71 and no message. Before this diagnostic existed,\na `handle` whose body reached an effect through a field got no AX3011\nand nothing else either - the compile-time refusal became a runtime\ntrap.\n\nWhat to do: name the function at the call so the walk can follow it,\nor widen the handled list to cover what the unresolved call might\nperform.\n\n"
                                                                                                  (if (strEq c "3039")
                                                                                                    "AX3039 - an AXTAG key one slip from a key the compiler checks\n\nThe AXTAG key namespace is OPEN on purpose: a key the compiler does\nnot know is metadata, it is recorded, and nothing checks it. That is\nnot what this reports.\n\nThis reports a key one edit - or one change of case - away from `pure`\nor `effect`, the two keys that ARE checked. `;@axiom:pur` is not a\npurity claim. Nothing validates it, so a body performing IO under it\ndraws no AX3010 at all: the tag reads like a guarantee and buys\nsilence, which is worse than writing no tag, because a reader spends\ntrust on it.\n\nA key containing `:` is never reported. `agent:readonly` is namespaced\nand deliberate, and its distance from `pure` is not evidence about\nanything.\n\nFix the spelling - or, if the key really is your own metadata,\nnamespace it so it cannot be mistaken for a claim.\n\n"
                                                                                                    (if (strEq c "3040")
                                                                                                      "AX3040 - a type variable returned that no parameter mentions\n\n    (:: conjure (-> Int a))\n\nThis is not parametric polymorphism. `a` appears in the RESULT and in\nno parameter, so the CALLER chooses what it is, nothing witnesses the\nchoice, and the callee cannot have produced a value of it. The\nsignature promises `forall a. Int -> a`, which in a sound system is\ninhabited only by non-termination. Here it is inhabited by a machine\nword, and the promise is an unchecked coercion wearing a polymorphic\nspelling.\n\nIt reaches memory unsafety, measured rather than argued:\n\n    (fn (conjure n) (cast a n))\n    (strWrap (conjure 42) 8)\n\n`check` answers OK and the binary exits 139 - 42 dereferenced as a\nString pointer. The same shape through `vecGet` is how a `Vec` holding\nan Int reads back as a String, because a `Vec` carries no element type.\n\nWHAT TO DO. Return a concrete word type and let callers write `cast`,\nwhich is the language's one documented reinterpretation and is visible\nwhere it happens. Or, if the declaration really is part of the unsafe\nlayer - a raw word read whose meaning the type system does not model -\ntag it `;@axiom:raw`.\n\nThe tag is not permission and it does not make the read safe. What it\nbuys is that the unsafe layer becomes FINITE and enumerable:\n\n    axiom symbols FILE --diagnostic-format ai | grep '#raw'\n\nNo declaration in this repository carries it any more. Fourteen did\nwhen the tag was introduced on 2026-08-23 - `memGetWord`, `vecGet`,\n`nodeA` and the rest of the raw word reads - and all fourteen were\nmigrated the same day to accessors whose declared result says what the\nword is, so the enumerable unsafe layer is currently empty. Before the\ntag there was no way to ask the question at all.\n\n"
                                                                                                      (if (strEq c "3041")
                                                                                                        "AX3041 - an `extern` block's library name that is not one\n\nThe string an `extern` block opens with is a LINKER LIBRARY NAME: the\nstem of `lib<name>.a`, which is what `-l` takes. It may hold only\n`A-Z`, `a-z`, `0-9`, `.`, `_`, `+` and `-`, and it may not be empty.\n`axiom_demo`, `m` and `c++abi` are names; a path, a flag, or anything\ncarrying whitespace is not.\n\nThe limit exists because that one string reaches two consumers\nverbatim. The driver passes it to the linker as `-l<name>`, and the\nemitter writes it into the module beside the block's `declare` lines\nas `; axiom-extern-lib <name>`, which is how `axiom build` knows what\nto link without being told.\n\nAn LLVM `;` comment ends at the newline. So a library name carrying\none used to end that comment and turn every following line into live\nmodule-level IR - a global, or a `define` with a body, or a\n`@llvm.global_ctors` entry, which runs before `main`. It landed after\nthe type checker, the effect system and the freestanding gate had all\nrun, and the grounding pass that checks external symbols reads\n`declare` lines only, so nothing downstream looked at it.\n\nName only the library here. A directory belongs in `--link-search DIR`\nor `AXIOM_LINK_SEARCH`, and the symbol on the other side of the\nboundary belongs in the item's own `(symbol \"...\")` clause.\n\n"
                                                                                                        (if (strEq c "3044")
                                                                                                          "AX3044 - a bare type name is declared in more than one imported module\n\nTwo modules the program imports each declare a type of this name, no\nmodule-less declaration outranks them, and the reference is not inside\neither of them - so nothing decides which one it means.\n\nUntil 2026-08-24 it was decided by ACCIDENT. Type names are not\nrewritten to `Mod$Name` the way `fn` and `::` declarations are, and\nthe lookup returned the first match in the merged declaration list,\nwhich is import order:\n\n    TeamA.ax  (pub struct Config (port : Int) (retries : Int))\n    TeamB.ax  (pub struct Config (retries : Int) (port : Int))\n              (pub fn (bPort) (let ((c (Config 3 99))) c.port))\n    app.ax    (import TeamA) (import TeamB) (fn (main) (bPort))\n\n`check` said OK and the program answered 3 - TeamA's slot 0 - where\nTeamB's own declaration says 99. Swapping the two imports answered 99.\nA module's own correct code was reading another module's field\noffsets, with no diagnostic from any pass.\n\nThat half is fixed and is not what this reports: a reference INSIDE\nthe module that declares the type now reaches its own declaration,\nand so does a reference in the entry file to a type the entry file\ndeclares. This reports the case that is left, where the compiler\ngenuinely cannot tell.\n\nWHAT TO DO. Qualification is NOT the answer here, and this is why the\ncode is not AX3014: `Mod::Name` is an expression spelling and does not\nparse in type position at all. What works is either\n\n  * narrowing the import so only one of the two types is carried:\n    an import name list decides what a module exports to this\n    program, so `(import TeamA (fromA))` leaves TeamA's `Config`\n    invisible outside TeamA and the reference resolves; or\n  * renaming one of the declarations.\n\nA struct in one module and a `data` or `type` of the same name in\nanother are the same collision and are reported the same way: they\nshare one namespace, which is what `(data Foo ...)` beside\n`(type Foo = Int)` in one file has always been refused for.\n\n"
                                                                                                          (if (strEq c "4001")
                                                                                                            "AX4001 - no `main` function\n\nAn executable Axiom program needs exactly one top-level function named\n`main` to serve as the entry point. Add `(:: main Int)` and\n`(define main ...)`, or use `axiom check`/`emit-llvm` if you only want\nto analyze a library-style module.\n\n"
                                                                                                            (if (strEq c "4002")
                                                                                                              "AX4002 - code generation failed\n\nThe IR-to-LLVM lowering stage hit a case it doesn't yet support or an\ninternal invariant was violated. This generally indicates a compiler\nlimitation rather than a mistake in your source; please file a bug\nwith a minimal reproduction.\n\n"
                                                                                                              (if (strEq c "4003")
                                                                                                                "AX4003 - external toolchain command failed\n\nAxiom shells out to `llc` and `cc` to turn LLVM IR into a native\nexecutable. This error means one of those external commands could not\nbe run or exited unsuccessfully; check that LLVM (`llc`) and a C\ncompiler (`cc`) are installed and on your `PATH`.\n\n"
                                                                                                                (if (strEq c "4004")
                                                                                                                  "AX4004 - an `extern` names a symbol no archive defines\n\nAn `extern` item binds a linker symbol, and the build checks - before\nwriting a byte or spawning a tool - that some archive on the link line\ncould define it. This error means none can.\n\nUsually the `(symbol \"...\")` clause is a typo, or the archive that\ndefines it is not on the line: pass it with `--link-lib NAME` and\n`--link-search DIR`, where DIR holds `libNAME.a`.\n\nThis is refused HERE, and that is the whole point. The removed\n`foreign` construct emitted a call to a symbol its module never\ndeclared, so a program using one passed `check` and then died inside\n`opt` or the linker, with a message about generated code and no span\ninto the source. An `extern` naming a symbol that does not exist is the\nsame defect, and refusing it at the compiler rather than at the\ntoolchain is the difference between a diagnostic and a link error about\na file you never wrote.\n\nWhat the check proves is one-directional: the name appears nowhere in\nany archive on the link line, so nothing there can define it. It does\nnot claim the converse - a name that does appear might be a string\nconstant rather than a definition - because a false rejection would\nbreak a correct build, while the case that actually happens is a typo.\n\nIt is a `build` diagnostic and cannot fire under `check`, which has no\nlink line to consult.\n\n"
                                                                                                                  (if (strEq c "4005")
                                                                                                                    "AX4005 - an `extern` item's shape disagrees with the crate's shim\n\nEvery shim `#[axiom_export]` writes also exports a DESCRIPTOR beside it: a\nno-op function whose name spells the shim's shape, `<symbol>__sig_<params>_<result>`\nwith one tag per parameter - `i` a plain word (Int, Bool, Char, a Foreign\nhandle, the out-cell), `f` a Float (its IEEE-754 bits), `s` a String, `c` a\ncallback - and the result after the underscore. `axffi_add__sig_ii_i` says\n`(-> Int Int Int)`.\n\nThe build derives the same string from the `extern` item's declared type and\nreads the archive's symbol table for the crate's. A difference is this error,\nat the item: a two-argument declaration over a three-argument shim used to\nbuild, link, and answer whatever was in the third register.\n\nA symbol with no descriptor at all - a hand-written `extern \"C\"` shim - is not\nchecked; it is trusted as written, which is the old contract and the reason\nto let the macro write the shim.\n\nRegenerate the binding module with `axiom-bindgen` when the Rust signature\nchanged, or correct the hand-written item.\n\n"
                                                                                                                    (if (strEq c "5001")
                                                                                                                      "AX5001 - cannot resolve import\n\nAn `(import Mod.Sub ...)` declaration names a module path that doesn't\ncorrespond to any file on disk. Module paths are resolved relative to\nthe entry file's own directory (the file passed to `check`/`build`/\n`run`/`emit-llvm`), not the directory of whichever file wrote the\n`(import ...)`: `Mod.Sub` looks for `Mod/Sub.ax` next to (or below)\nthe entry file, from every file in the program alike.\n\n"
                                                                                                                      ""
                                                                                                                    )
                                                                                                                  )
                                                                                                                )
                                                                                                              )
                                                                                                            )
                                                                                                          )
                                                                                                        )
                                                                                                      )
                                                                                                    )
                                                                                                  )
                                                                                                )
                                                                                              )
                                                                                            )
