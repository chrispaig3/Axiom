; explain.ax - `axiom explain`, self-hosted.
;
; The AX1xxx-AX5001 texts were GENERATED from the stage0 binary's own
; output, one cached run per code, so they could not drift by
; transcription. That compiler is gone and `axiom-errors/src/code.rs`
; with it, so codes added after it - AX3018 through AX3022, the macro
; expansion refusals, AX3023, AX3024 and AX3025 - are written HERE
; and are the origin. The rule
; that replaces the regeneration loop: a new code needs a row in
; `explainListText`, an arm in `explainText`, and a re-run of
; `scripts/check-tools-selfhost.sh`'s golden, which is what catches
; either one being forgotten.
;
; The lookup normalises the way stage0's `lookup` does: trim ASCII
; whitespace, uppercase, strip a leading `AX`, strip leading dashes -
; so `ax3001`, `3001` and `AX-3001` all answer AX3001.
(import Str)

; The `--list` text, byte-for-byte stage0's.
(pub :: explainListText String)

(pub fn (explainListText) "Known Axiom diagnostic codes:\n  AX1001  unexpected character  (unexpected-char)\n  AX1002  unterminated string literal  (unterminated-string)\n  AX1003  unterminated character literal  (unterminated-char)\n  AX1004  invalid number literal  (invalid-number-literal)\n  AX1005  invalid escape sequence  (invalid-escape-sequence)\n  AX2001  unexpected token  (unexpected-token)\n  AX2002  unexpected end of file  (unexpected-eof)\n  AX2003  syntax error  (syntax-error)\n  AX2004  removed language construct  (removed-construct)\n  AX2005  nesting too deep  (recursion-limit)\n  AX2006  a module-path segment that is a file path  (module-path-segment)\n  AX3001  undefined variable  (undefined-variable)\n  AX3002  undefined type  (undefined-type)\n  AX3003  undefined constructor  (undefined-constructor)\n  AX3004  type mismatch  (type-mismatch)\n  AX3005  non-exhaustive pattern match  (non-exhaustive-match)\n  AX3006  duplicate definition  (duplicate-definition)\n  AX3007  field not found  (field-not-found)\n  AX3008  semantic error  (semantic-error)\n  AX3009  constructor arity mismatch  (constructor-arity-mismatch)\n  AX3010  agent metadata mismatch  (axtag-mismatch)\n  AX3011  effect mismatch  (effect-mismatch)\n  AX3012  cannot assign to an immutable binding  (assign-to-immutable)\n  AX3014  a bare name is defined in more than one imported module  (ambiguous-name)\n  AX3015  a signature with no definition behind it  (missing-definition)\n  AX3013  partial application is not supported  (partial-application)\n  AX3016  a handle list names an effect that is not declared  (unknown-effect)\n  AX3017  an effect-handler shape the compiler does not support yet  (effect-handler-unsupported)\n  AX3018  an invocation no macro rule accepts  (macro-arity)\n  AX3019  macro expansion did not terminate  (macro-recursion-limit)\n  AX3020  a macro declares the same parameter twice  (macro-duplicate-parameter)\n  AX3021  a macro template contains a form the expander cannot substitute into  (macro-template-unsupported)\n  AX3022  a macro parameter used as a `set` target was given an expression  (macro-set-target)\n  AX3023  a name its module does not export  (private-name)\n  AX3024  macro expansion produced more than the limit  (macro-expansion-limit)\n  AX3025  a format hole's argument has no rendering  (no-rendering)\n  AX3026  a name the emitted runtime owns  (reserved-runtime-name)\n  AX3027  a declaration-macro invocation the expander cannot resolve  (declaration-macro)\n  AX3028  a syntax/* query with no answer  (syntax-query)\n  AX3029  a declaration too wide for the reference map  (record-bitmap-capacity)\n  AX3030  too many type variables for one evidence word  (evidence-word-capacity)\n  AX3031  malformed format string  (malformed-format-string)\n  AX3033  a macro rule that can never match  (macro-unreachable-rule)\n  AX3034  an ellipsis used at the wrong depth  (macro-ellipsis)\n  AX3035  a macro parameter used as a binder was given something that is not a variable  (macro-binder-target)\n  AX3036  an `extern` item's type cannot cross the boundary  (extern-type)\n  AX3037  an AXTAG claim the effect walk is not in a position to check  (axtag-unverifiable)\n  AX3038  a handled-effects list the effect walk is not in a position to check  (effect-unverifiable)\n  AX3039  an AXTAG key one slip from a key the compiler checks  (axtag-key-typo)\n  AX3040  a type variable the caller chooses and the callee produces  (result-only-tyvar)\n  AX3041  an `extern` block's library name that is not one  (extern-library-name)\n  AX3042  a function performs IO and does not declare it  (undeclared-effect)\n  AX3044  a bare TYPE name is declared in more than one imported module  (ambiguous-type)\n  AX3047  a C or Rust primitive type name in type position  (sized-integer-type)\n  AX3048  a reference to a deprecated name  (deprecated-name)\n  AX3049  a restriction this declaration claimed, violated  (restriction-violated)\n  AX3050  a `;@axiom:pre(...)`/`post(...)` the compiler cannot compile into a check  (contract-malformed)\n  AX3051  a restriction claim the effect walk is not in a position to check  (restriction-unverifiable)\n  AX3052  a name inside `restrict(...)` that is not a restriction  (restriction-unknown)\n  AX3053  an operation the program reaches with no handler  (unhandled-operation)\n  AX3054  an effect declared with a built-in effect's name  (effect-name-reserved)\n  AX3055  an effect operation that declares no type  (effect-op-untyped)\n  AX3056  a struct field that declares no type  (struct-field-untyped)\n  AX3057  a `strict` restriction the effect walk cannot prove  (restriction-unproven)\n  AX3058  a nested region reusing an enclosing region's name  (region-name-shadowed)\n  AX3059  a value leaving the region it was allocated in  (region-escape)\n  AX3060  a value stored where its region has already ended  (region-escape)\n  AX3061  a result that does not live in the region its signature names  (region-return)\n  AX3062  a closure escaping the region of something it captures  (region-capture)\n  AX3063  a region the callee's signature names and the arguments do not agree on  (region-argument)\n  AX3064  a concurrent binding capturing a reference its parent also holds  (parallel-capture)\n  AX3065  an AXTAG key the compiler derives and writes itself  (axtag-key-reserved)\n  AX4001  no `main` function  (missing-main)\n  AX4002  code generation failed  (codegen-failure)\n  AX4003  external toolchain command failed  (toolchain-failure)\n  AX4004  an `extern` names a symbol no archive defines  (ungrounded-symbol)\n  AX4005  an `extern` item's shape disagrees with the crate's shim  (extern-shape)\n  AX4006  a thread lowering the target does not have  (threads-unsupported)\n  AX4007  a `parallel` lowering the target has neither of  (parallel-unsupported)\n  AX5001  cannot resolve import  (module-not-found)\n")

; The explanation for a NORMALISED code (digits only), or "" when
; the code is unknown.
(pub :: explainText (-> String String))

(pub fn (explainText c)
  (if (strEq c "3065")
    "AX3065 - an AXTAG key the compiler derives and writes itself\n\nThe AXTAG key namespace is OPEN: a key the compiler does not know is\nmetadata, it is recorded, and nothing checks it. AX3039 says so, and\nthis does not narrow it. What it refuses is the one part of that\nnamespace that was never the author's - the keys `axiom symbols`\nWRITES, from the checker's own answers:\n\n    effects  effect-params  effects-incomplete  effects-overapprox\n    effects-possible  ctors  of  fields  tyvars  methods  generated\n    calls  mir-params  mir-escapes  mir-result-fresh\n    mir-result-from  mir-incomplete  mir-truncated\n\nA reader of that stream cannot tell an author's copy of one from the\ncompiler's. Before this refusal, `;@axiom:effects(Pure)` on a body\nwith effects, and `;@axiom:mir-result-fresh(1)` on any body at all,\nrendered rows byte-identical to derived ones - the second silently,\nbecause it is not one slip from a key the compiler checks and the\nnear-miss rule was all that had ever looked at a key.\n\nThe ordering rule does not cover it. Compiler keys are pushed after\nthe author's so a reader taking the LAST `#key` gets the compiler's -\nbut only where the compiler emits that key on that row. It emits no\n`#effects=` for a body with no effects and no `#mir-*` for a program\nthat names no region, which is exactly where a forged guarantee is\nworth forging.\n\nAn ERROR, like AX3052 and AX3054 and unlike AX3039, for AX3052's\nreason: accepting it would let a tag read like a guarantee and buy\nsilence. `pure`, `effect(...)`, `restrict(...)`, `pre(...)`,\n`post(...)`, `unhandled(trap)` and `raw` are yours to write - they\nare CHECKED, which is the difference.\n\nNamespace it - `;@axiom:my:effects(...)`, which a `:` exempts - or\ndrop it.\n\n"
  (if (strEq c "3060")
    "AX3060 - a value stored where its region has already ended\n\nA signature may name the REGION a reference lives in:\n\n    (:: intern (-> (Str @s) (Table @r) (Sym @r)))\n\n`@s` and `@r` are region parameters, chosen by the caller through\nthe arguments, as type variables are. A region named in a signature\noutlives the function's own region (its caller's current one), and\ntwo named regions are UNORDERED - neither is known to outlive the\nother. A region opened by `(region r ...)` is inside the region it\nwas opened in.\n\nThe escape rule (docs/memory-model-v2-design.md, MM-RGN-3): a value\nmay be stored only into a place its own region OUTLIVES, because the\nplace is still readable after the value's region has been reclaimed.\nThis code is that rule refusing a store - a `set` on a binding, a\nfield write, a raw `__store64`, or a store a CALLEE makes through its\nparameter, which the compiler reads off the callee's body: `vecPush`\nstores its second parameter into its first, so `(vecPush v x)` is\nrefused when `x`'s region does not outlive `v`'s.\n\nA function that names no region is region-monomorphic in its\ncaller's region (MM-RGN-4): everything it allocates lives there, so\nstoring what it allocates into a `@r`-annotated parameter is refused\ntoo - the caller's region does not outlive `@r`. Allocating INTO a\nnamed region is stage S4's work and is not available yet.\n\nKeep the value in the region of the place: allocate or copy it there,\nor widen the place's annotation to the value's region. A call the\ncompiler cannot resolve - through a parameter, a closure or a field -\nis assumed to store every argument into every argument, which is the\nconservative reading; name the function at the call to lift it.\n\n"
    (if (strEq c "3061")
      "AX3061 - a result that does not live in the region its signature names\n\n`(:: pick (-> (Str @s) (Str @r) (Str @r)))` promises a value in\n`@r`. A body answering its `@s` parameter, or a value it allocated\nitself, breaks that promise: the caller reads the result in `@r`\nafter every shorter region has been reclaimed (MM-RGN-3 at the\nreturn, docs/memory-model-v2-design.md).\n\nA value derived from a parameter annotated `@r` - the parameter\nitself, a field or an element read out of it - is what the signature\nasks for. A value the body allocates lives in the function's own\nregion, which is its caller's current region and does not outlive a\nnamed one; allocating into `@r` is stage S4's work.\n\nAnswer such a value, or drop the result's annotation: an unannotated\nresult lives in the caller's current region, and the caller's own\nsignature decides from there.\n\n"
      (if (strEq c "3062")
        "AX3062 - a closure escaping the region of something it captures\n\nA lambda's record holds a reference to every value it captures, so\nthe closure lives in the region it was created in AND in the region\nof each capture: it may be stored, or answered, only where every\ncapture outlives the place (MM-RGN-3 for closures,\ndocs/memory-model-v2-design.md §2.3).\n\nThis is AX3060 or AX3061 with the escaping value a closure, reported\nagainst the capture that makes it short-lived - the message names it.\nCapture a copy made in the place's region, or stop capturing the\nshort-lived value; a closure that captures nothing shorter than the\nplace is stored like any other value.\n\n"
        (if (strEq c "3064")
          "AX3064 - a concurrent binding capturing a reference its parent also holds\n\n`(parallel p ((a e1) (b e2)) body)` runs each binding BESIDE the\ncaller. A binding's expression is a thunk, and a name it reads from\nthe enclosing function is CAPTURED: the same block is then reachable\nfrom two places that run at the same time.\n\nThat is safe for a word and unsafe for a reference. `axiom_retain`\nand `axiom_release` are a plain load-add-store rather than an\n`atomicrmw` - by design, and everywhere - so two of them on one\nblock's count lose an increment, and the block is freed while a live\nreference still names it. Corruption, not a leak (MM-PAR-6,\ndocs/memory-model-v2-design.md section 3.2b).\n\nWhat a binding may share with its parent is a WORD. Pass the value\nthrough the thunk's word argument, or build a copy inside the\nbinding; a `Vec` is not refused, because it takes no share of a\ncount (`evScalarName`), and neither is anything the compiler can see\nis a scalar.\n\nThe rule is the LANGUAGE's, not a lowering's, so it does not depend\non `--threads`: the process lowering is merely permitted to be laxer\nthan the rule. `__proc_spawn` names that lowering by itself - a\nseparate address space, so no count is shared - and is exempt.\n\n"
        (if (strEq c "3063")
          "AX3063 - a region the callee's signature names and the arguments do not agree on\n\nA region parameter is instantiated ONCE per call, like a type\nvariable. `(:: pair (-> (Str @r) (Str @r) Int))` asks for two values\nfrom one region, and `(pair x y)` with `x` in `@s` and `y` in `@t` -\ntwo regions the callee's body may not tell apart - is refused, because\nthe body was checked on the promise that they are one.\n\nThe same code refuses a signature whose RESULT names a region no\nparameter supplies, `(:: orphan (-> Int (Str @q)))`: a region is chosen\nby the caller through an argument, and a region named only in the\nresult is one the callee would have to invent - the shape AX3040\nrefuses for a type variable.\n\nPass values from one region, give the parameters different region\nnames, or name the result's region on a parameter.\n\n"
          (if (strEq c "1001")
    "AX1001 - unexpected character\n\nThe lexer found a character that cannot start any valid Axiom token.\nAn identifier is letters, digits, `_`, `'` and the operator characters\n`+ - * / % < > = ! & | ^`, and cannot begin with a digit or `'`.\nOperators are not a separate lexical class - `+` is an identifier - so\n`set!`, `foo'` and `empty-list` are ordinary names. `?`, `~` and `@` are\nnot identifier characters at all, and `#` is one only as the `#|` that\nopens a block comment. Check for typos, stray punctuation copied from\nanother language, or an unsupported Unicode character.\n\n"
    (if (strEq c "1002")
      "AX1002 - unterminated string literal\n\nA `\"` opened a string and no `\"` closed it. The lexer does not stop\nat the end of the line - a string may span lines - so it keeps\nreading to the next quote or to the end of the file, and the span it\nreports runs from the opening quote to wherever that was. The line\nnamed is the one the string STARTS on, which may be far from where\nthe program stopped making sense:\n\n    (:: greeting String)\n\n    (fn (greeting) \"hello)\n\nThe usual causes are a quote that was never typed, and a `\\\"`\nwritten where a plain closing `\"` was meant: the escape keeps the\nstring open and swallows the quote that would have closed it, so a\nstring that looks closed on its line is drawn as this code with a\nspan reaching the end of the file.\n\nClose the string. To put a quote inside one, escape it as `\\\"`; to\nput a backslash before the closing quote, write `\\\\`.\n\nAX1005 is the neighbour: an escape the lexer does not know, inside a\nstring that IS closed. AX1003 is the same failure for a character\nliteral, and AX2002 is what an unbalanced form draws once every\nstring in the file is closed.\n\n"
      (if (strEq c "1003")
        "AX1003 - unterminated character literal\n\nA `'` at the start of a token opens a character literal, and a\ncharacter literal is exactly one character - or one escape - between\ntwo quotes: `'a'`, `'e'`, `'\\n'`. The lexer read the opening quote\nand did not find the closing one where the rule puts it:\n\n    (:: main Int)\n\n    (fn (main) (let ((c 'ab)) 0))\n\nTwo characters between the quotes, a quote with nothing after it, and\na quote followed by the end of the line all land here; the span is\nthe opening quote and what the lexer read after it.\n\nA `'` INSIDE a name is not a literal at all. `foo'` and `x''` are\nordinary identifiers, because `'` is an identifier character in every\nposition but the first (AX1001 lists the alphabet), so a name meant\nto begin with a prime is drawn as this code too.\n\nWrite one character, or one of the seven escapes `\\n \\t \\r \\\\ \\\"\n\\' \\0` - any other escape is AX1005. A `Char` is a Unicode code\npoint, so `'e'` with an accent is one character. Several characters\nwant a `\"...\"` string, and a string left open is AX1002.\n\n"
        (if (strEq c "1004")
          "AX1004 - invalid number literal\n\nThe token is shaped like a number and is not one the compiler can\nhold. `Int` is a 64-bit signed integer and `Float` a 64-bit IEEE\nvalue, so a literal outside those ranges, or a float whose exponent\nis malformed, has no value to become:\n\n    (:: main Int)\n\n    (fn (main) 99999999999999999999999)\n\nThe message quotes the literal and the help names the two ways it\nfails: overflow of i64 or f64, or a bad exponent. A literal that\nreads as neither an `Int` nor a `Float` is this code; a literal that\nreads fine but sits where another type was expected is AX3004.\n\nWrite a value the type can hold - the largest `Int` is\n9223372036854775807. Anything wider needs a representation the\nprogram builds for itself; `u64` written as a TYPE does not buy a\nwider integer, it draws AX3047.\n\n"
          (if (strEq c "1005")
            "AX1005 - invalid escape sequence\n\nInside a string or character literal a backslash starts an escape,\nand the lexer knows exactly seven: `\\n`, `\\t`, `\\r`, `\\\\`, `\\\"`,\n`\\'` and `\\0`. A backslash followed by anything else is this code,\nreported on the two characters of the escape:\n\n    (:: path String)\n\n    (fn (path) \"C:\\qwerty\")\n\nThere is no hexadecimal, Unicode or octal escape. Source is UTF-8 and\na `Char` is a code point, so a character outside ASCII is written as\nitself rather than escaped.\n\nDouble the backslash to keep it - `\"C:\\\\qwerty\"` - or remove it.\n\nThe neighbours are the other two lexer codes for literals: AX1002\nfor a string with no closing quote, which is what a `\\\"` written in\nplace of the closing `\"` produces, and AX1003 for a character literal\nthat does not close.\n\n"
            (if (strEq c "2001")
              "AX2001 - unexpected token\n\nThe parser knew what the grammar allows next and found something\nelse. The message states both halves - `expected identifier, found\n`)`` - and the span is the token that was found, so the form to read\nis the one that token closes or opens:\n\n    (:: main Int)\n\n    (fn (main) 0)\n\n    (fn)\n\nThe shapes that draw it in the diagnostics corpus: a keyword with\nnothing after it, as above; an empty `()` or `{}` where an expression\nwas due; a `set` with no target; a signature whose arrow has no\nparameter type (`(-> Int)`), or a type trailing the result; a `for`\nwith more than one body or a `parallel` binding marked `mut`; an\n`extern` item with no `:: type`, or with a clause the block does not\ntake; and a file whose top level opens with something other than `(`.\nSeveral of those messages say what the right shape is in the\nexpectation itself, so read it in full.\n\nGive the parser the token it names, or close the form it is inside.\n\nThe neighbours: the file ending while a form is still open is\nAX2002; a form that is well delimited and still breaks a rule with no\nexpectation to name is AX2003; a keyword from an earlier version of\nthe language - `begin`, `union` - is AX2004, deliberately, so that\nold source gets an explanation rather than an unexpected token; and a\nform nested past the parser's limit is AX2005.\n\n"
              (if (strEq c "2002")
                "AX2002 - unexpected end of file\n\nThe file ended with a form still open. The span is the end of the\nfile, because that is where the parser learned it, and the fault is\nwherever the delimiter count stopped balancing:\n\n    (:: main Int)\n\n    (fn (main)\n      (+ 1 2)\n\nCount `(`, `[` and `{` against `)`, `]` and `}` working backward from\nthe end: the first form whose count comes up short is the one missing\nits close. An editor that shows matching delimiters finds it in one\nkeystroke.\n\nTwo things hide the real culprit. A string opened and never closed\nswallows everything to the next quote or the end of the file, and is\nAX1002 first. A `#|` block comment with no `|#` swallows the rest of\nthe file with no diagnostic of its own, so what is left draws\nwhatever it draws - a signature whose `fn` was inside the comment is\nAX3015.\n\nClose the form. If the file was cut short by a tool - a truncated\npaste, a partial write - the fix is the tool's.\n\nAX2001 is the neighbour: a delimiter that arrives, but is the wrong\none.\n\n"
                (if (strEq c "2003")
                  "AX2003 - syntax error\n\nThe parser refused a token and had nothing more specific to say\nabout it. AX2001 is the same refusal with an EXPECTATION attached -\n`expected identifier` - and this code is what the refusal becomes\nwhen the grammar at that point has no single expected token to name.\nThere is one construction site for it in the parser, and the\ndiagnostics corpus draws it with one shape, a `type` alias written\nwithout its `=`:\n\n    (type Count Int)\n\n    (:: main Int)\n\n    (fn (main) 42)\n\nThe alias form is `(type Count = Int)`. The span is the keyword the\nform opened with, which is the parser's way of saying that the whole\nform is what it could not read.\n\nCompare the form against the reference for the keyword it starts\nwith; each shape has one spelling. If a form you believe is valid\nlands here, the defect is in the parser's expectation text rather\nthan in your program, and is worth reporting with the form.\n\nThe neighbours are AX2001 (the parser can say what it wanted), AX2002\n(it wanted anything and found the end of the file), and AX3008, this\ncode's twin one stage later - a rule the CHECKER enforces with no\ncode of its own.\n\n"
                  (if (strEq c "2004")
                    "AX2004 - removed language construct\n\nThis form was part of an earlier version of Axiom and no longer exists.\nThe keyword is still reserved so that old source gets this explanation\ninstead of being silently reinterpreted as an ordinary identifier.\n\n`union` is gone because C interoperability is no longer a goal of the\nlanguage, and an untagged union cannot be pattern-matched safely - its\nvariants are not distinguishable at run time. Use `data` for a tagged\nsum, whose variants the compiler can check for exhaustiveness, or\n`struct` for a product.\n\n(That paragraph used to end \"and has no meaning under linear typing,\nwhere every value has exactly one owner and one type\". Linear typing\nwas removed on 2026-08-25 for enforcing exactly none of that, so the\njustification was resting on a feature the language does not have.)\n\n`linear` and `consume` are refused rather than removed, the way\n`deriving` is: they parsed and did nothing. `linear T` built the\nnominal type `Linear T` - a real barrier against `T` and nothing more -\nand counted no uses, so a value could be consumed twice or never.\n`(consume e)` was a parse-time identity that kept the wrapper: the\nchecker typed it as its operand, the IR lowered it to its operand, and\nthe form reclaimed nothing. A marker that reads as an ownership\nguarantee and supplies none is worse than no marker, because a reader\nspends trust on it.\n\nDelete them. Reclamation is the reference counting every heap block\ncarries, and `__axiom_arena_mark`/`__axiom_arena_reset_keeping` is the\nexplicit fallback for a program that wants to choose the point.\n\n`foreign` is gone because it never worked: a binding emitted a call to\na symbol the module never declared, so a program that used one passed\n`check` and then died inside `opt` or the linker.\n\nIt is NOT the FFI under a new name, and the FFI is not a revival of it.\nAxiom binds Rust through an `extern` BLOCK:\n\n  (pub extern \"axiom_demo\"\n    (add :: (-> Int Int Int) (symbol \"axffi_add\")))\n\nbuilt with `--link-lib` and `--link-search`. The emitter writes a\n`declare` for each item, which is the entire difference. See\n`docs/ffi.md`.\n\nA program that declares no `extern` still links no C library at all,\nand so does one bound to a `no_std` Rust crate - measured, `nm -u` on\nboth is empty. Reaching the kernel needs no FFI either: the standard\nlibrary is written in Axiom over `__syscall0`-`__syscall6`.\n\n`begin` is gone because `{ }` brace blocks and implicit sequencing\nreplaced it: `{ a b c }` sequences and answers the last expression,\nwhich is exactly what `(begin a b c)` meant, and a `fn` body already\nsequences - so the wrapper is usually just deletable. It is reserved\nrather than left as an ordinary name because an ordinary name draws\n`AX3001 undefined variable begin`, which names no replacement.\n\n`region` was on this list until 2026-09-03 and is a keyword again:\n`(region r body)` brackets an allocation scope whose memory is\nreclaimed when the body ends (docs/reference.md, Regions). The advice\nthis paragraph used to give - that allocation lifetime is INFERRED\nfrom where a value is created and how far it escapes - described a\nmodel the language withdrew (docs/memory-model-v2-design.md section\n1.4), which is the one thing a reserved word's advice must not do.\nA `region` at the top level is not a declaration and reports AX3027\nlike any other expression head.\n\n`deriving` is refused rather than removed: the clause parsed and was\nsilently DISCARDED from the day it was written - its names never\nreached the AST, no instance was ever derived, and a program carrying\none checked OK. A clause that does nothing is worse than one that does\nnot parse. Derive instances explicitly, where you want them:\n`(deriveEq T)` is an ordinary declaration macro, and the instance it\ngenerates is checked, compiled, and dispatched like a written one\n(docs/macro-system.md MAC-CAP-9).\n\n"
                    (if (strEq c "2005")
                      "AX2005 - nesting too deep\n\nA form nests more deeply than the parser's fixed limit. Every stage\nafter the parser walks the syntax tree recursively, so an unbounded\nnesting depth is an unbounded native stack depth; the limit converts\nwhat would otherwise be a stack overflow - a crash with no span and no\nmessage - into this diagnostic, pointing at the token where the limit\nwas reached.\n\nHand-written code effectively never reaches the limit. Generated code\ncan: a long chain built by folding a binary operator over a list nests\nonce per element. Emit a `let` chain, a `{}` block, or a balanced tree\ninstead of one deeply nested form.\n\n"
                      (if (strEq c "2006")
                        "AX2006 - a module-path segment that is a file path\n\nAn `(import M)` names a MODULE, and the compiler resolves that name\nagainst its search directories: the entry file's own directory first,\nthen each `AXIOM_PATH` entry, then the standard library. A dot\nseparates the parts of a nested name - `Sys.Platform` is the module in\n`Sys/Platform.ax` - and rewriting that `.` into a `/` is the\nresolver's job, not the author's.\n\nA `/` inside a segment is refused because it defeats that resolution\nentirely. A candidate file is formed by concatenating a search\ndirectory onto the name, and a name that is already a path simply\nre-anchors it: `(import /etc/x)` reads `/etc/x.ax` and\n`(import ../../x)` climbs out of the project. Neither is an import of\na module, and both used to be accepted with `check` printing `OK`.\n\nWrite the dotted name, and put the directory that holds the module on\n`AXIOM_PATH` or beside the entry file.\n\n`/` remains an ordinary identifier character everywhere else, because\nthe compiler's own `syntax/format` and `syntax/join` are spelled with\none. Only a module path is constrained, and only a module path is\nturned into a filename.\n\n"
                        (if (strEq c "3001")
                          "AX3001 - undefined variable\n\nNo binding with this name is in scope. A name in expression position\nresolves to one of: a `let` binding or a `lambda`/`fn` parameter\nenclosing the use, a top-level `fn` in this module, a `pub` name of\nan imported module, or a constructor of a `data` type. This name is\nnone of them at this point in the program:\n\n    (:: helper Int)\n\n    (fn (helper) 1)\n\n    (:: main Int)\n\n    (fn (main) (+ helpr 1))\n\nWhen a name one edit away IS in scope, the diagnostic names it and\ncarries a machine-applicable fix - `~>\"helper\"` on the AXDL line -\nwhich an editor or an agent applies without reading the prose. The\nsuggestion is offered for bindings and constructors alike.\n\n`let` is sequential: a binding is visible in the bindings and body\nafter it and never before, so Axiom does not forward-reference local\nbindings. Top-level `fn`s see each other in any order.\n\nFix the spelling, bind the name, or import the module that exports\nit. A capitalised name in expression position that no `data` declares\nis this code too; the same name in a PATTERN is AX3003.\n\nThree neighbours look like this one and are not. AX3023 is a name\nthat EXISTS in an imported module and is not exported - not written\n`pub`, or left out of an `(import M (a b))` list. AX3014 is a name\nthat exists in TWO imported modules with nothing to choose between\nthem. AX3015 is a signature with no definition behind it: the name\nresolves, and there is nothing to run.\n\n"
                          (if (strEq c "3002")
                            "AX3002 - undefined type\n\nA name in TYPE position - a signature, a field's type, a `cast`\ntarget, the head of a `(struct Name ...)` construction - names no\nbuilt-in type, no `data`, no `struct` and no `type` alias visible in\nthis module:\n\n    (:: origin (-> Int Piont))\n\n    (fn (origin n) n)\n\n    (:: main Int)\n\n    (fn (main) 0)\n\nThe built-ins are `Int`, `Float`, `Bool`, `Char`, `String` and\n`Unit`, with `Vec`, `Option` and the arrow `(-> a b)` over them.\nEverything else is declared by a `data`, a `struct` or a `type`\nalias, in this module or in one it imports.\n\nOnly a name beginning with a capital letter is looked up. A lowercase\nname in type position is a TYPE VARIABLE and binds fresh, so `int`\ndoes not draw this code - it draws AX3047, which exists because a\nvariable that accepts anything is the opposite of what that spelling\nlooks like.\n\nDeclare the type, import the module that declares it, or fix the\nspelling. Two codes are near: AX3044 is a type name declared in MORE\nthan one imported module, and AX3003 is a type's name written where\na CONSTRUCTOR belongs - `(Color)` in a pattern where `(Red)` was\nmeant.\n\n"
                            (if (strEq c "3003")
                              "AX3003 - undefined constructor\n\nA pattern names a constructor - `(Grean n)`, `(Purple)` - and no\n`data` declaration visible here defines one by that name:\n\n    (data Color\n      (Red)\n      (Green Int))\n\n    (:: main Int)\n\n    (fn (main)\n      (match Red\n        ((Grean n) n)\n        (_ 0)))\n\nWhen a constructor one edit away is visible, the diagnostic names it\nand carries the fix - `~>\"Green\"` - so the misspelling is corrected\nby whatever reads the line.\n\nThis code is drawn in PATTERN position. The same unknown name in\nexpression position is AX3001, an undefined variable, because an\nexpression resolves through the value namespace and a constructor is\none kind of value in it; the pattern compiler asks the narrower\nquestion and answers with the narrower code. A type's own name in a\npattern - `(Color)` for a `data Color` - is this code as well, since\na type is not one of its constructors.\n\nFix the spelling, declare the constructor on its `data` type, or\nimport the module that declares it. A name that IS a constructor but\nis written with the wrong number of fields is AX3009; a constructor\nof a different type than the scrutinee is AX3004; and a `match` that\nspells every constructor correctly and still misses one is AX3005.\n\n"
                              (if (strEq c "3004")
                                "AX3004 - type mismatch\n\nAn expression has one type and the place it sits demands another.\nThe message states both - `expected Int, found Bool` - and the span\nis the expression that has the FOUND type, so the fix is either to\nchange that expression or to change what its context asks of it.\n\nThe shape worth knowing about is a signature's type variable used\ntwice:\n\n    (:: same (-> a a Int))\n\n    (fn (same x y) 0)\n\n    (:: main Int)\n\n    (fn (main) (same 1 true))\n\nA type variable is instantiated once per call, so the first argument\nPINS `a` to `Int` and the second is checked against that: the report\nis `expected Int, found Bool` at `true`, not a report about `a`. A\ncaller may choose any one type for `a`; it may not choose two.\n\nThe other shapes it is drawn for most, each pinned in the diagnostics\ncorpus: an `if` whose condition is not `Bool` (`(if 1 2 3)`); an\nargument against its parameter (`(twice true)` on `(-> Int Int)`); a\nbody against its declared result (`(:: name String)` over `42`); a\nvalue stored in a struct field of another type (`(Point 1 true)`); a\n`String` where an `Int` is due, which are both one machine word and\nare distinct types all the same; and a pattern whose constructor\nbelongs to a different `data` type than the scrutinee.\n\nThere is no second report for an expression that already drew a\ndiagnostic: its type is poisoned, and a poisoned type matches\nanything, so one misspelled name does not become three type errors.\n\nRead the expected type and decide which side is wrong. When the\ncontext is a signature you wrote, the signature is often the side\nthat is wrong - the body knows what it computes.\n\nThe neighbours: AX3007 and AX3008 for a struct's fields; AX3009 for a\nconstructor's arity; AX3040 for a signature whose type variable\nappears only in the result, which is not a mismatch but a type the\ncallee cannot have produced; AX3047 for `u64` and its relatives in\ntype position; and AX3036 for a type that cannot cross an `extern`\nboundary.\n\n"
                                (if (strEq c "3005")
                                  "AX3005 - non-exhaustive pattern match\n\nA `match` must have an arm for every value its scrutinee can take,\nand this one does not. The message lists what is missing - `missing\nRect, Dot` - and the span is the scrutinee:\n\n    (data Shape\n      (Circle Int)\n      (Rect Int Int)\n      (Dot))\n\n    (:: area (-> Shape Int))\n\n    (fn (area s)\n      (match s\n        ((Circle r) (* r r))))\n\n    (:: main Int)\n\n    (fn (main) (area Dot))\n\nThe diagnostic carries two machine-applicable fixes. The first\nappends one arm per missing constructor, each answering\n`(todo \"Name\")`:\n\n    ~>\"\\n    ((Rect _ _) (todo \\\"Rect\\\"))\\n    ((Dot) (todo \\\"Dot\\\"))\"\n\nand the second inserts `(import IO (todo))` at the top of the file\nwhen `todo` is not already in scope. Applied together they compile\nand run, and the first unwritten arm that is reached writes\n`todo: Rect` to standard error and exits 70 - the program says where\nits own work stopped instead of computing on a value it never\nconsidered.\n\nWrite the arms, or a final `_` arm when the remaining cases really do\nshare one answer. A `Bool` scrutinee needs both `true` and `false` or\na wildcard. A `match` whose arms are all literals (`(1 11) (2 22)`)\ndraws this code in a second wording - `this match can fall through`\n- because no literal covers its type, and before it did a value no\narm matched answered 0 silently. Nested patterns are checked as deep\nas they are written, so an arm for `(Some (Circle r))` leaves\n`(Some (Rect _ _))` uncovered.\n\nThe neighbours: AX3009 for an arm whose constructor has the wrong\nnumber of fields, AX3003 for one no `data` declares, and AX3004 for\nan arm whose constructor belongs to another type.\n\n"
                                  (if (strEq c "3006")
                                    "AX3006 - duplicate definition\n\nOne name, two definitions, one scope. The report lands on the second\ndefinition and its secondary span - `^` on the AXDL line - points at\nthe first, so both are named however far apart they are:\n\n    (:: main Int)\n\n    (fn (main) 0)\n\n    (fn (main) 1)\n\nFunctions, `struct` and `data` types, the operations of an `effect`,\nthe members of a `namespace` and macros all live where a second\ndeclaration of a name is refused rather than allowed to shadow: the\nprogram would otherwise mean whichever one the compiler read last. A\n`pub` signature delivered by an import collides with a local\ndefinition of the same name in the same way, an `extern` item\ncollides with a `fn`, and a macro that shadows a function is refused\ntoo.\n\nRename one, or delete the one that is a copy.\n\nTwo neighbours are about one name in two PLACES rather than two\ndefinitions in one: AX3014 is a name defined by two imported modules\nthat the entry file must qualify, and AX3044 the same for a type\nname. AX3026 is a definition whose name the emitted runtime already\nowns - a collision with something not written in Axiom.\n\n"
                                    (if (strEq c "3007")
                                      "AX3007 - field not found\n\n`p.z` reads a field of `p`, and `p`'s type has no field of that name:\n\n    (struct Point\n      (x : Int)\n      (y : Int))\n\n    (:: main Int)\n\n    (fn (main)\n      (let ((p (Point 1 2)))\n        p.z))\n\nThe span is the field name after the dot, and the message names the\ntype the compiler resolved for the value - which is the thing to\ncheck when the name is spelled right, because a value of a different\nstruct than the one you meant has different fields.\n\nFix the name, or the value. Two codes sit beside this one: AX3008\nfor a `struct` built with the wrong number of fields, and for a\nfield read on a `data` type that has a nullary constructor beside a\nfielded one (the value may be a bare tag with no fields to read, so\nthe read is refused in favour of a `match`); and AX3012 for a `set`\ninto a field the declaration does not mark `mut`.\n\n"
                                      (if (strEq c "3008")
                                        "AX3008 - semantic error\n\nA rule the checker enforces was broken in a way that has no code of\nits own; the message carries the rule. The diagnostics corpus draws\nit for four shapes, and a program is most likely to meet the first:\n\n    (struct Point\n      (x : Int)\n      (y : Int))\n\n    (:: main Int)\n\n    (fn (main) { (Point 1) 0 })\n\nThe four: a `struct` built with the wrong number of fields (`expects\n2 field(s), found 1`), the shape above; a `lambda` with no\nparameters, which can never be called, because `(f)` and `f` are the\nsame expression; `sizeof` or `alignof` given more than the one type\neach takes; and a field read `.v` on a `data` type with a nullary\nconstructor beside a fielded one, because the value may be an\nimmediate tag with no fields to read - match on it instead, and read\nthe field in the arm that has it.\n\nEach message states its rule; read that rather than the code. AX2003\nis this code's twin one stage earlier, the parser's rule with no\nnumber of its own. The specific codes nearby: AX3007 for a field\nthat does not exist, AX3009 for a `data` constructor's arity (a\n`struct`'s arity is here, a constructor's is there), and AX3004 for\na type that does not fit.\n\n"
                                        (if (strEq c "3009")
                                          "AX3009 - constructor arity mismatch\n\nA `data` constructor was written with a different number of fields\nthan its declaration gives it. In a pattern, both too few and too\nmany are this code; in an expression, too few is this code and too\nmany is AX3004, because `(Green 1)` is already a `Color` and applying\na `Color` to a further argument is a mismatch against a function\ntype:\n\n    (data Color\n      (Red)\n      (Green Int))\n\n    (:: main Int)\n\n    (fn (main)\n      (match Red\n        ((Green) 1)\n        (_ 0)))\n\nThe message states both counts - `expects 1 argument(s), found 0` -\nand the span is the constructor.\n\nCheck the `data` declaration and write one pattern variable or `_`\nper field. A nullary constructor is matched as `(Red)`, WITH its\nparentheses: a bare name in arm position is a variable pattern that\nbinds the scrutinee and matches everything, so `(Red 1)` written\nwhere `((Red) 1)` was meant is not this code - it is accepted, it\nmatches a `Green` too, and every arm after it is dead.\n\nThe neighbours: AX3003 for a constructor no `data` declares, AX3005\nfor a `match` whose arms are all well-formed and still miss a case,\nand AX3008 for a `struct` built with the wrong field count.\n\n"
                                          (if (strEq c "3010")
                                            "AX3010 - agent metadata mismatch\n\nA `;@axiom:<key>(<value>)` tag on this declaration makes a claim\n(e.g. `effect(io)`, `pure`) that the body does not support.\n\nThis is an ERROR, and refuses the build. A tag is a claim you\nWROTE: shipping a false one publishes a guarantee the program does\nnot keep, and every reader that trusted it - a person, an agent, or\n`axiom symbols` - is misled by exactly the amount it was trusted.\n\nThree ways out: make the body match the tag; correct the tag to\nwhat the body does; or delete the tag, which withdraws the claim\nrather than answering it (an untagged function is never checked).\n\nOnly claims the compiler can DECIDE reach this code. A claim it is\nnot in a position to check - because the body calls a value it could\nnot resolve - is AX3037, which is a warning. See `explain AX3037`.\n\n"
                                            (if (strEq c "3011")
                                              "AX3011 - effect mismatch\n\nThe body of a `handle` performs an effect that its handled-effects\nlist does not name. `(handle BODY (E1 E2) HANDLER)` promises to\nintercept `E1` and `E2`; an operation of any other effect inside\nBODY escapes the handler, and the list is then a false statement\nabout what the expression handles:\n\n    (effect Ask\n      (ask :: (-> Int Int)))\n\n    (:: answer (-> Int Int))\n\n    (fn (answer n)\n      (handle (ask n) (IO) (lambda (v) 0)))\n\n    (:: main Int)\n\n    (fn (main) (answer 1))\n\nThe message names the effect that escaped - `unhandled effect\n`Ask`` - at the operation. The built-in effects count: a body that\nreaches a syscall under `(Alloc)` is refused for `IO` exactly as a\ncustom operation is for its effect, and a nested `handle` discharges\nonly what its own list names.\n\nName every effect the body performs, or move the escaping operation\noutside the `handle`.\n\nEffects are NOT part of a function's signature. What a function\nperforms is inferred from its body and checked against its\n`;@axiom:effect(...)` tag - AX3010 when the tag is wrong, AX3042\nwhen IO is performed under no tag at all. The neighbours of this\ncode are the other handle-shaped ones: AX3016 for a list naming an\neffect that does not exist, AX3017 for a handler shape the compiler\ndoes not support, and AX3053 - a warning - for an operation that\nreaches `main` with no handler installed anywhere, which the program\nabove also draws, since nothing in it handles `Ask`.\n\n"
                                              (if (strEq c "3012")
                                                "AX3012 - cannot assign to an immutable binding\n\n`set` stores into a local, and a local is assignable only if it was\nintroduced as `(let ((mut x ...)) ...)`. Immutable is the default, so\na binding that is never reassigned needs no annotation and cannot be\nchanged by accident.\n\nAdd `mut` at the declaration, or - usually better - compute the value\nyou want with a `let` rather than mutating one you already have.\n\nFunction parameters, pattern bindings and top-level declarations are\nnever mutable, and no marker makes them so.\n\nThe same code refuses a store into a STRUCT FIELD whose declaration\ndoes not mark it `mut`. A field is immutable by default, exactly as a\nbinding is: `(set p.x 9)` needs `(mut x : Int)` on the struct, and\n`mut` on the binding that holds `p` has nothing to do with it. Only\nthe last segment of a path is governed - `(set a.b.c v)` needs `c`\ndeclared `mut` and says nothing about `b`, because the store mutates\nthe value `b` points at rather than the `b` slot. `memSetWord` writes\na block by word index and is outside the rule.\n\n"
                                                (if (strEq c "3013")
                                                  "AX3013 - partial application is not supported\n\nA top-level function was applied to fewer arguments than its\ndefinition declares, or a function of two or more parameters was\nused as a bare value. Both are well-typed under currying, but the\ncompiled representation has no way to hold the missing arguments:\na call site would simply omit them, and the callee would read\nwhatever happened to be in the argument registers - which is how\nthis used to run and crash instead of being reported.\n\nBind the missing arguments with a lambda instead: where `(f x)`\nwas meant, write `(lambda (y) (f x y))`. A lambda captures `x` in\na closure record, which is the representation partial application\nwould need and lambdas already have. Saturated calls, calls with\n*extra* arguments applied to a returned function value, and\none-parameter functions used as values are all unaffected.\n\n"
                                                  (if (strEq c "3014")
                                                    "AX3014 - a bare name is defined in more than one imported module\n\nTwo or more imported modules define this name and the entry file\ndoes not, so a bare reference has no principled winner - and before\nthis diagnostic the compiler's stages genuinely disagreed about\nwhich definition it meant, so a program could type-check against\none module's signature and run the other module's code.\n\nQualify the reference as `Module::name` to pick explicitly, or\nimport only the names you want with `(import Module (name ...))`.\nA name the entry file defines itself always resolves to the entry\nfile's definition and needs no qualification.\n\n"
                                                    (if (strEq c "3015")
                                                      "AX3015 - a signature with no definition behind it\n\nA `(:: name Type)` signature declares a name; only a `(fn ...)`\ngives it something to run. This name has a signature and no `fn` -\neither the entry file declares the signature and never defines the\nfunction, or an import delivered a `pub` signature whose definition\nstayed private in its module.\nCalling it used to pass `check` and then fail in the native\ntoolchain with an undefined-symbol error about generated code.\n\nAdd the definition, or mark the defining `fn` `pub` alongside its\nsignature so the import carries both.\n\n"
                                                      (if (strEq c "3016")
                                                        "AX3016 - a handle list names an effect that is not declared\n\nThe effects a `handle` expression may name are the built-ins\n(`IO`, `Alloc`, `Mut`, `Div`) and effects introduced by an\n`(effect Name (op :: sig) ...)` declaration in scope. This name\nis neither, so the handle could never intercept or scope\nanything - before this diagnostic it was accepted silently and\ndid nothing.\n\nDeclare the effect, import the module that declares it, or fix\nthe spelling.\n\n"
                                                        (if (strEq c "3017")
                                                          "AX3017 - an effect-handler shape the compiler does not support yet\n\nDynamic handlers currently support exactly one custom effect per\n`handle` expression, and only effects that declare exactly one\noperation; an effect operation is callable but cannot be used as\na bare value (there is no closure representation for dynamic\ndispatch). Nest `handle` expressions to install handlers for\nseveral effects at once, and split multi-operation effects into\none effect per operation until per-operation handler syntax\nexists.\n\n"
                                                          (if (strEq c "3018")
                                                            "AX3018 - wrong number of arguments to a macro\n\nA macro is applied to exactly as many arguments as its head declares\nparameters. It is not a function and does not curry: an invocation is a\nREWRITE, and the rewrite has nowhere to put an argument it was given no\nparameter for.\n\nBoth mismatches used to be accepted. A missing argument left the\nparameter's own name standing in the generated code, so\n`(macro (two p q) (+ p q))` invoked as `(two 40)` emitted\n`add i64 40, %q` and the native toolchain rejected it with an undefined\nvalue - an error about generated code, carrying no span into the\nsource. A surplus argument was dropped WITHOUT being evaluated, so its\nside effects silently did not happen.\n\nCount the parameters and pass that many.\n\nTHE RULE FORM IS NOT ONLY ABOUT COUNTING, since MAC-LANG-15 made a\nrule's parameters PATTERNS and MAC-LANG-18 made selection a match.\nThere the message reads\n\n    no rule of macro `defN` matches this invocation;\n    it accepts (defN (a b)) or (defN T 7)\n\nand the invocation may well have passed a count some rule\ndeclares - what failed is the SHAPE of an argument, or the value of\na literal the pattern spells out. The shapes listed are the rules'\nown patterns as their author wrote them; a plain identifier in one\nmatches anything, and everything else has to be written as it\nstands.\n\nThe code and its `macro-arity` slug are shared deliberately rather\nthan split, because MAC-LANG-18 specifies this generalisation by\nname - \"the arity diagnostic AX3018 generalised. Today's AX3018\nbecomes the one-rule case of it\". The slug is narrower than the\ncondition it now carries, and that is the cost of keeping a stable\ncode the specification names. (The unreachable-RULE refusal went\nthe other way and took a new code, AX3033, because nothing\nspecified it sharing AX3020 - see that entry.)\n\n"
                                                            (if (strEq c "3019")
                                                              "AX3019 - macro expansion did not terminate\n\nExpanding this macro reached the depth limit of 128. Expansion repeats\nuntil no invocation is left, so a macro that always rewrites to an\ninvocation of itself - directly, or through a second macro that\nrewrites back - never finishes.\n\nBefore the limit existed this crashed the compiler: `(macro (loopy x)\n(loopy x))` segfaulted with no diagnostic and no output, in about 10 ms\nof CPU time.\n\nA macro cannot recurse on its arguments the way a function can, because\nthere is no test the expander can evaluate to stop. Write the recursion\nas a function and let the macro expand to a call.\n\n"
                                                              (if (strEq c "3020")
                                                                "AX3020 - a macro declares the same parameter twice\n\nTwo parameters of this macro share a name, so a reference to that name\nin the template has no single meaning. The expander resolves it to the\nLAST argument, which means the earlier ones are accepted, evaluated in\nsource order, and then discarded - measured: `(macro (dup a a) (+ a a))`\ninvoked as `(dup 10 20)` answered 40.\n\nSince MAC-LANG-15 a rule-form macro's parameters are PATTERNS, so\nthe binders this counts are every binder the patterns introduce,\nnested ones included: `((m a (f a)) ...)` binds `a` twice and is\nthis code. `_` is exempt - it binds nothing, so several of them in\none rule are legal.\n\nA rule that can never MATCH is a different thing and a different\ncode (AX3033). This one used to cover both.\n\nGive each parameter a distinct name.\n\n"
                                                                (if (strEq c "3021")
                                                                  "AX3021 - a macro template contains a form the expander cannot substitute into\n\nThe expander rebuilds a template node by node, replacing parameter\nreferences with the arguments' syntax. This template contains a form it\nhas no case for, so it refused rather than emit the template's own\nidentifiers into the generated code.\n\nThis is a compiler limitation, not a mistake in the program, and it\nexists to be loud. The eight silent miscompiles it replaced were all\nthe same bug: a form was added to the language and not to the expander,\nwhose default was to return the node unchanged - which compiled, and\nproduced code referring to names that existed only inside the macro.\n\nRewrite the template without the form, or add a case for it to\n`substTpl` in `self_host/expand.ax`.\n\nA DECLARATION template has the same code with a fixed list: it may\ngenerate `fn`, `::`, `data`, `struct`, `type`, `effect` and `impl`\ndeclarations, further macro invocations, and a `syntax/for` over\nthem. An `import` template and a nested `macro` refuse, at the\nMACRO's own line rather than at an invocation, because a template\nkind is a property of the macro. Both are refusals by DECISION\nrather than by schedule: an `import` inside a template would reopen\nmodule resolution, which has already run when declaration expansion\nstarts, and a nested `macro` would reopen the fixpoint that expands\nit. A `trait` template does not reach this code at all - a trait\ndeclaration inside a template is AX2003, from the parser.\n\nThis paragraph named `type`, `trait`, `effect` and `import` as the\nfour refusals until 2026-08-16. `type` and `effect` became template\nkinds on 2026-08-15 and this list was not swept - which the sentence\nafter it gave away, naming a nested `macro` as one of \"those four\".\n\n"
                                                                  (if (strEq c "3022")
                                                                    "AX3022 - a macro parameter used as a `set` target was given an expression\n\n`set` assigns to a binding, so its target has to be a name. Where a\ntemplate writes `(set p v)` and `p` is a macro parameter, the argument\npassed for `p` has to be a plain identifier; this call passed an\nexpression, which names no binding to assign to.\n\nPass a variable for that parameter, or rewrite the template so the\nparameter is not a `set` target.\n\n"
                                                                    (if (strEq c "3023")
                                                                      "AX3023 - a name its module does not export\n\nThe name exists. It is declared in another module, and that module\ndoes not make it visible: either its declaration is not written `pub`,\nor the `(import M (a b))` that brought the module in does not list it.\n\nA module's declarations are all carried into the program - its own\nbodies have to be able to call its own helpers - and `pub` decides\nonly which of them anything ELSE may name. Before that split the two\nwere one decision, and a private declaration was simply deleted: the\nmodule's own calls to it became `AX3001 undefined variable` reported\nat the library's own lines, in a file that merely imported it, and if\nthe importing program happened to define that name, the module's call\nlanded on the importer's definition instead - silently, at exit 0.\n\nWrite `pub` on the declaration, add the name to the import's list, or\ncall something the module does export.\n\n"
                                                                      (if (strEq c "3024")
                                                                        "AX3024 - macro expansion produced more than the limit\n\nExpansion is a rewrite, so the program the compiler sees is the\nexpanded one, and this expansion produced a tree too deep or too large\nto process. Three limits apply and the message says which was reached.\n\nDEPTH is 1024 forms, the same number the parser refuses source at\n(AX2005). It has to be checked separately because the parser measures\nthe SOURCE: a 500-deep template invoked 120 times nests 620 in the file\nand 60,000 in the tree, and only the second number overflows the stack.\nBefore this limit that input crashed `check`, `run`, `symbols` and the\nlanguage server with no output at all.\n\nSIZE is 2,000,000 forms, and no depth limit can see what it catches:\n`(macro (m x) (+ x x))` doubles per level, so 26 nested invocations are\n154 bytes of source and 2**26 forms. That took 41 seconds and the\nlanguage server never answered.\n\nDECLARATIONS is 10,000, and it is a separate axis because the other\ntwo are counted inside expression expansion while the DECLARATION\nphase runs first: a template that generates declarations reaches\nneither counter. Depth was covered there anyway - a declaration macro\nthat regenerates its own invocation is AX3019 after 128 rounds - so\nwhat was missing was width. A template generating three invocations\nof itself per round reached 3.4 GB in one second and was killed by\nthe operating system, with no diagnostic and no output at all.\n\nAll three are far above any real macro - the whole of `stdlib/Pre.ax`\nexpands to depth 1, and the largest generated declaration count in\nthis repository is 80. Make the macro produce less, or write the\nrepeated part as a function and let the macro expand to a call: a\nfunction is compiled once however many times it is called, which is\nthe whole difference.\n\n"
                                                                        (if (strEq c "3025")
                                                                          "AX3025 - a format hole's argument has no rendering\n\nA `{hole}`, a `(println x)` and a `(format x)` all render their\nargument from its STATIC type, decided at compile time and generated\nfield by field from the declaration. This code is what they say when\nthere is no such rendering:\n\n  - the argument is a type VARIABLE - a generic function's own `a`.\n    A type variable is not a type, so there is nothing to render\n    from. Bind the value to a `let` with a signature, or write the\n    type at the call.\n  - the argument's type MENTIONS a type variable, such as `Box a`\n    inside a generic function - the same reason, one level in.\n  - the argument is a function value, a `Foreign`, or a `data` or\n    `struct` holding one of those. The message names the field type.\n\nWrite a function that renders the type and interpolate its result.\n\nTHE NUMBER IS OLDER THAN THIS MEANING, AND IS KEPT ANYWAY. Until\n0.6.0 it covered every way a `trait` and an `impl` failed to agree,\nand rendering was one arm of it because `Show` was a trait; traits\nwere removed and the other arms went with them. Retiring the number\nwould cost a reader who already looks for AX3025 when a hole refuses,\nand `scripts/check-doc-drift.sh` compares constructed codes against\nexplained ones in both directions, so a retired number has to leave\nboth lists together. The SLUG did move, in 0.7.4: it read\n`trait-impl`, which was the last trait word on the user-facing\nsurface, and it is `no-rendering` now. `show` moved with it - the\nname a hole lowered to was an ordinary identifier a program could\ndeclare and capture, so it is an unwritable head now and `(format x)`\nis the only spelling.\n\n"
                                                                          (if (strEq c "3026")
                                                                            "AX3026 - a name the emitted runtime owns\n\nA compiled Axiom program contains its own runtime - the allocator, the\ntraps, the arena primitives, and since 2026-08-15 the reference-count\nprimitives - emitted into the module it is built from. `axiom_alloc`\nis the allocator's symbol, and `axiom_retain`/`axiom_release` are the\nownership primitives' (docs/memory-model.md MM-LIFE-2b). The backend\nemits all three definitions unconditionally, so a program defining\nany of the names is two definitions of one symbol.\n\nBefore this refusal that program passed `check` and died in `opt`\nwith `invalid redefinition of function 'axiom_alloc'` - the\ndocumented \"override seam\" that never worked. The seam does not\nexist and is not planned: MM-ALLOC-8 moved from Planned to REFUSED on\n2026-08-31, because a program that wants control over reclamation has\nthe arena primitives (MM-ALLOC-22) and a second allocator identity\nunderneath them is an unspecified feature. See docs/memory-model.md\nMM-ALLOC-8.\n\nOnly an entry-file definition collides: a module's declaration is\nmangled to `Mod$axiom_alloc`, a different symbol.\n\n"
                                                                            (if (strEq c "3027")
                                                                              "AX3027 - a declaration-macro invocation the expander cannot resolve\n\nA top-level form whose head is not a declaration keyword is a\nDECLARATION MACRO INVOCATION: the head must name a visible rule-form\nmacro - `(macro name ((name args ...) (fn ...) ...))` - whose\ntemplate declarations are instantiated in its place. This code covers\nevery way that fails:\n\n  - the head names no visible macro (a typo'd keyword lands here too,\n    where it used to be a bare `syntax error`)\n  - the head names an EXPRESSION macro, whose template is one\n    expression and cannot stand in declaration position\n  - a declaration macro is referenced in EXPRESSION position - the\n    two template kinds are disjoint\n  - the invocation sits in a pipeline carrying no mangling records -\n    a re-expansion of an already-resolved program - so a module-side\n    invocation there could generate a declaration nothing can name\n  - an argument bound to a NAME position of the template - a\n    declaration head or a parameter list - is not a bare identifier\n\nSee docs/macro-system.md MAC-CAP-8.\n\n"
                                                                              (if (strEq c "3028")
                                                                                "AX3028 - a syntax/* query with no answer\n\nThe `syntax/` spellings are the compile-time QUERY VOCABULARY: a\nclosed, compiler-implemented set of questions a macro template asks\nabout the declaration list, answered at expansion time with no user\ncode running. The vocabulary answers `(syntax/join a b)` in a\ndeclaration NAME position and, applied, as a REFERENCE to what such\na name declares - `((syntax/join show T) x)`; `(syntax/constructors\nT)`, `(syntax/fields S)` and `(syntax/binders C p)` as iteration\nsequences; `(syntax/for (x seq) ...)` where a match ARM, a template\nDECLARATION, or a call ARGUMENT stands, over one sequence or\nseveral zipped in lockstep as `((x xs) (y ys))`; `(syntax/fold f z binds tpl)`\nas the right-fold over one sequence or several zipped in lockstep;\n`(syntax/same f g)` over two iteration variables; and the three\nSCALAR queries `(syntax/name x)`, `(syntax/arity C)` and\n`(syntax/defined n)`, which answer one node where one value is\nneeded. This code covers every way a query has no answer:\n\n  - a `syntax/` head the vocabulary does not implement, or one\n    standing in a position it does not own - the vocabulary is\n    CLOSED, so unknowns refuse by name instead of dying later as\n    undefined variables; a sequence in a one-value position and a\n    syntax/for at expression root land here too\n  - a subject with nothing to answer: constructors of a struct,\n    fields of a data type, binders or an arity of a name that is not\n    a constructor, any of them of a name that declares nothing or of\n    a type its module keeps private\n  - a query ARGUMENT that is neither a bare identifier nor a\n    `(syntax/join a b)` - the one query whose answer is itself a\n    name, and therefore the only one that can feed another's\n    argument\n  - parallel sequences of different lengths, in a syntax/for or a\n    syntax/fold alike - the zip rule is a diagnostic, never a\n    truncation to the shorter\n  - a parallel binding that is not a `(y ys)` pair\n  - syntax/same over variables ranging over DIFFERENT sequences - a\n    false there would be a wrong answer, not a comparison - or over\n    a name no enclosing syntax/for binds\n  - a query written OUTSIDE a macro template - a (syntax/join ...)\n    name, a syntax/for arm, or a top-level syntax/for in ordinary\n    code has no instantiation to resolve it\n  - a declaration NAMED into the reserved `syntax/` prefix, including\n    the near-miss `(fn (syntax/join a b) ...)` - one paren short of a\n    joined name, which would otherwise silently declare a function\n    called syntax/join\n\nSee docs/macro-system.md MAC-CAP-5 and MAC-CAP-6.\n\n"
                                                                                (if (strEq c "3029")
                                                                                  "AX3029 - a declaration too wide for the reference map\n\nEvery heap block born of `axiom_alloc` carries a 16-byte header,\nand the header's shape word packs three fields: the form bit, the\nblock's padded payload word count, and - for the record form - one\nbit per payload word saying whether that word is a REFERENCE the\nrelease path must follow (docs/memory-model.md MM-LIFE-2d). Bits\n16..62 carry the map; bit 63 is the i64 sign bit, reserved so every\nshape constant the compiler emits is non-negative. That gives 47\nmappable payload words: a struct may declare 47 fields, and a data\nconstructor 46 beside its tag word.\n\nA declaration past the cliff is REFUSED at check time rather than\ntruncated at run time - a map that silently dropped its widest\nfield would free everything it named and leak the one it could\nnot. The largest declaration in this repository, the 37-field CG\nrecord in the compiler's own code generator, fits with a quarter\nof the map to spare; the cliff is far from real programs.\n\nThe escape hatch is structural: split the declaration. A nested\nstruct or constructor cell is ONE word of the outer block - the\nwalk follows the pointer, and the inner block carries its own map -\nso any record too wide for one map becomes two that fit.\n\nSee docs/memory-model.md MM-LIFE-2d.\n\n"
                                                                                  (if (strEq c "3030")
                                                                                    "AX3030 - too many type variables for one evidence word\n\nA polymorphic function receives one hidden machine word beside its\narguments: bit i says whether type parameter i is instantiated at a\nREFERENCE type, and the reference maps of MM-LIFE-2d read those\nbits where a declared type is a variable (docs/memory-model.md).\nOne word carries 64 bits, so a declaration may introduce at most 64\ntype variables.\n\nThe cap is soundness, not tidiness: a variable's bit is read with a\nshift by its index, and a shift of 64 or more is poison in the\nemitted LLVM - an arbitrary answer at run time, which under\nreference maps becomes a wrong free. A sixty-fifth variable is\ntherefore refused at the declaration, on the merged declaration\nlist, imported modules included. The widest signature in this\nrepository declares 4.\n\nSignatures whose every variable appears only in RETURN position\ntake no evidence word at all - no argument can ever witness one -\nso the hottest accessors are exempt from the hidden argument\nentirely; the cap still applies to the declaration's spelling.\n\nSee docs/memory-model.md MM-LIFE-2d.\n\n"
                                                                                    (if (strEq c "3031")
                                                                                      "AX3031 - malformed format string\n\nA format string is parsed at EXPANSION time, by the compiler,\nbefore the program is type-checked - so a hole that names nothing,\na brace that never closes, and a stray `}` are all compile errors\nrather than runtime surprises. This is the whole reason the\nprinting macros exist: `(println \"x = {x}\")` is a rewrite into\n`strConcat` and rendering calls, and there is no runtime format\nparser to fail in.\n\nThe grammar is small on purpose:\n\n  {name}   interpolate the binding `name`, in scope AT THE CALL\n  {{       a literal `{`\n  }}       a literal `}`\n\nA hole holds a bare name and nothing else. There are no positional\nholes (`{}`, `{0}`) and no argument list: capture is the form the\nlanguage has. A variadic `println` is buildable since a rule may\nrepeat (docs/macro-system.md MAC-LANG-16, 2026-08-16) and is\nunbuilt; this paragraph said repetition did not exist until then.\n\nA hole MAY carry a specifier, and the compiler picks the `Fmt` call\nat expansion time rather than leaving it to you:\n\n  {n:x}      (fmtHex n)\n  {x:.2}     (fmtFloatPrec x 2)\n  {n:>8}     (fmtPadLeft (format n) 8)\n  {s:<12}    (fmtPadRight (format s) 12)\n  {s:^12}    (fmtPadCenter (format s) 12)\n  {n:04}     (fmtPadZerosLeft (format n) 4)\n  {x:>10.2}  (fmtPadLeft (fmtFloatPrec x 2) 10)\n\nThis paragraph said there were no specifiers and told you to build\nthe padded or rounded string by hand with `fmtPadLeft`,\n`fmtFloatPrec` or `fmtHex` - the calls the specifier now emits for\nyou. It said so until 2026-08-16, a day after they shipped.\n\nA hole whose name is not in scope is AX3001, and one whose type\nhas no rendering is AX3025; neither is this code. This code\nis only for a string the parser could not make holes out of at\nall.\n\nSee docs/macro-system.md MAC-CAP-10.\n\n"
                                                                                      (if (strEq c "3033")
                                                                                        "AX3033 - a macro rule that can never match\n\nA rule-form macro's rules are tried IN ORDER and the first whose\npattern matches wins (docs/macro-system.md MAC-LANG-18). A rule\nnothing can reach is therefore a program someone wrote expecting it\nto run, and this code refuses it at the macro's own line rather than\nletting it sit there looking live.\n\nA rule is unreachable when an EARLIER rule of the same arity is\nIRREFUTABLE - every one of its elements is a plain binder, so it\nmatches every invocation of that arity and consumes them all.\n\n    (macro defU ((defU T)      ; matches any one argument\n                 ...)\n                ((defU (a b))  ; AX3033: nothing reaches it\n                 ...))\n\nSwap them and both are reachable: `(defU (a b))` fails on an\nargument that is not a two-element form, and `(defU T)` then takes\neverything else. Ordering a pattern table from most specific to most\ngeneral is the shape this diagnostic is steering toward.\n\nTwo rules of one arity are NOT refused by themselves. That was the\nolder rule, when arity was the whole selector and this condition\nshared AX3020 with a repeated parameter; patterns made the two\ndifferent claims, so they became different codes. A macro whose\nrules all take one argument and are told apart by shape is exactly\nwhat the pattern language is for.\n\n"
                                                                                        (if (strEq c "3034")
                                                                                          "AX3034 - an ellipsis used at the wrong depth\n\nA rule's last element may REPEAT: `(m T v ...)` takes one argument\nand then any number, and `v` is bound to all of them at once\n(docs/macro-system.md MAC-LANG-16). A name bound that way is many\nforms, not one, and the template has to say where they go.\n\n    (macro mk ((mk T v ...)\n       (:: (syntax/join make T) T)\n       (fn ((syntax/join make T)) (T v ...))))\n\n    (mk Pair 1 2)      ; (Pair 1 2)\n    (mk Trip 3 4 5)    ; (Trip 3 4 5)\n\nFour ways to get the depth wrong, and this code is all of them:\n\n  - the template names a repeating element with no `...` after it.\n    That position takes ONE form and the name is many, so there is\n    nothing to put there. Add `...`, or stop the element repeating.\n  - `...` follows something that does not repeat - a fixed element,\n    or nothing at all. There is no sequence to splice.\n  - a rule declares more than one `...`. A repeating element absorbs\n    every argument left after the fixed ones, so a second has nothing\n    defined to take, and where the split fell would be the expander\n    guessing.\n  - a rule repeats a PATTERN rather than a bare name. v1 binds ONE\n    name to the forms a repeat absorbs; repeating `(a b) ...` would\n    bind `a` and `b` to a sequence each, in lockstep, which is a\n    second feature and is not built.\n\nThe first two are reported at the invocation, the last two at the\nmacro's own line - the place each author can act on.\n\n`...` is an ordinary identifier to the lexer, spelled with three\ndots. That is why it stands beside the name it repeats rather than\ngluing to it, and why a single `.` still means field access.\n\n"
                                                                                          (if (strEq c "3035")
                                                                                            "AX3035 - a macro parameter used as a binder was given something that is not a variable\n\nA template may put a macro parameter in a BINDER position - a `let`\nbinding, a `lambda` parameter, or a pattern binder in a match arm:\n\n    (macro (try! x e body)\n      (match e\n        ((Err er) (Err er))\n        ((Ok x) body)))\n\n    (try! v (parse s) (use v))\n\nThe parameter names the binding the CALLER wants, so the expansion\nbinds `v` and the caller's body reads `v`. That only works if the\nargument is a name: handed `(try! (f 1) ...)` there is nothing to\nbind, and the invocation is refused here rather than expanded into an\narm that binds an application.\n\nThis is the same rule `set` targets follow (AX3022), for the same\nreason - a position that takes a NAME cannot take an expression, and\na macro parameter is the one way an expression can arrive in one.\n\nA binder the TEMPLATE introduces is unaffected. It is renamed at every\nexpansion so it cannot capture a name the caller passed in, which is\nthe forward half of hygiene; a parameter in binder position is the\nopposite case, where the caller named the binding and must be able to\nread it (docs/macro-system.md MAC-HYG-10).\n\n"
                                                                                            (if (strEq c "3036")
                                                                                              "AX3036 - an `extern` item's type cannot cross the boundary\n\nThe Rust boundary is one machine word per argument and one word back:\nevery Rust shim `#[axiom_export]` generates is `extern \"C\" fn(i64, ...) -> i64`,\nand the emitted call is the same `call i64` an Axiom function gets. So an\n`extern` item's signature may name only the types that ARE one word with a\nmeaning both sides agree on: `Int`, `Float` (its IEEE-754 bits), `Bool`,\n`Char`, `String` (a handle Rust reads zero-copy) and `Foreign` (a word\nRust owns).\n\nA type variable, a tuple, a list, a function-typed argument whose leaves\nare not all words (a callback is an arrow over `Int`, `Float`, `Bool` and\n`Char`, arity one to three - `(-> Int Float)` - and crosses as the closure\nrecord Rust calls through `AxFn1`..`AxFn3`), or a declared type -\n`(Option Int)`, `(Result a e)`, `Handle`, a user `data` or `struct` - has no\ncrossing the emitter could write. Until 2026-08-22 such a signature\nwas accepted as written, and every caller then trusted a description the\nboundary could not honour.\n\nWhat to do instead: a Rust value of any other shape crosses as a `Foreign`\nhandle, and the ergonomic surface is the wrapper `axiom-bindgen` generates\n(docs/ffi.md): a `String` result is copied into an Axiom `String`, a\n`Result` or `Option` comes back through a status word and an out-cell, and\nan opaque Rust type becomes a `Handle` inside a generated `data` type whose\ndeath runs the Rust destructor.\n\n"
                                                                                              (if (strEq c "3037")
                                                                                                "AX3037 - an AXTAG claim the effect walk is not in a position to check\n\nA `;@axiom:pure` or `;@axiom:effect(pure)` claim on a function whose\nbody CALLS A VALUE the walk could not resolve. Three shapes reach it:\na head that is not a name (`((b.f) x)`, an `if` or `match` in head\nposition); a `let` bound to anything but a name or a lambda literal;\nand a pattern binder (`(match h ((Wrap f) (f 7)))`). They are one\nroute wearing three spellings - a function value goes into memory in\none place and is called in another, with no call edge in between for\nthe walk to follow.\n\nA lambda's own parameter is marked the same way and is currently\nunreachable: a called lambda parameter does not type-check\n(`AX3004`, `expected function type, found _tN`), because inference\nnever gives one a function type. The marker is set regardless, since\nthe alternative spelling would CLAIM the binder was attributed\nsomewhere, and it is not.\n\nThe other route is a row with no DEFINITE effect and some POSSIBLE\none: the body names an arrow-typed function without calling it\n(`(fn (handoff k) shout)`), or calls a trait method with more than\none implementation. Whether such a body performs anything depends on\nwhat a caller does with the value, or which implementation dispatch\nselects, so a claim of absence over it is this too\n(tests/diagnostics/355-tag-over-approximated.ax). A definite effect\nbeside a possible one is AX3010: the body performs it.\n\nThis is not the claim being wrong. It is the claim being unCHECKABLE\nhere, and the two need different answers - correct the tag, or resolve\nthe call - which is why this is not AX3010.\n\nThe silence it replaced was the worse half of a real hole. The effect\nwalk answers a lower bound; a claim of ABSENCE cannot be validated\nagainst a lower bound, and `pure` is exactly that claim. So\n\n    (struct Box (f : (-> Int Int)))\n\n    ;@axiom:pure\n    (fn (runner b) ((b.f) 7))\n\ncompiled clean, ran, and wrote to stdout, while `symbols` printed\n`#pure` with no `#effects=` beside it - the analysis asserting\nprecisely what it had failed to look at. The sentinel that records an\nunresolved call (`effIncomplete`) had been in the source since the\neffect walk was written, skipped by two consumers and produced by\nnobody: `git log -S` puts its last producer's removal in f6ddc2e,\nwhere effect polymorphism replaced it and the completeness gate its\nown comment describes went with it.\n\nWhat to do: name the function at the call site so the walk can\nfollow it, or drop the claim. A claim that cannot be checked is worth\nless than no claim, because a reader spends trust on it.\n\nThe REVERSE direction is deliberately silent. `;@axiom:effect(io)`\nover an unresolved call is a claim of PRESENCE, and an unresolved\ncall may well be where the IO comes from - reporting `missing IO`\nthere is a mis-report rather than an omission, and this check is\ndocumented as not permitted to make one.\n\n"
                                                                                                (if (strEq c "3038")
                                                                                                  "AX3038 - a handled-effects list the effect walk is not in a position to check\n\nThe body of a `handle` reaches a call the walk could not resolve - a\nfunction loaded from a struct field or a container, or a `let` bound\nto one - so the set of effects it performs is a LOWER BOUND, and a\nhandled-effects list cannot be checked against a lower bound.\n\nAX3011 is the same question answered: it refuses a body KNOWN to\nperform an effect the list does not name. This one cannot know, so it\ninforms instead of refusing - refusing here would make dispatch\nthrough a stored function unwriteable rather than unverified.\n\nIt matters more than the AXTAG case it mirrors. An effect operation\nreached with no handler installed does not fail softly: the process is\naborted with status 71 and no message. Before this diagnostic existed,\na `handle` whose body reached an effect through a field got no AX3011\nand nothing else either - the compile-time refusal became a runtime\ntrap.\n\nWhat to do: name the function at the call so the walk can follow it,\nor widen the handled list to cover what the unresolved call might\nperform.\n\n"
                                                                                                  (if (strEq c "3039")
                                                                                                    "AX3039 - an AXTAG key one slip from a key the compiler checks\n\nThe AXTAG key namespace is OPEN on purpose: a key the compiler does\nnot know is metadata, it is recorded, and nothing checks it. That is\nnot what this reports.\n\nThis reports a key one edit - or one change of case - away from one\nthe compiler checks. Six are: `pure`, `effect(...)`, `restrict(...)`,\n`pre(...)`, `post(...)`, and `unhandled(trap)` on an `effect`\ndeclaration. `;@axiom:pur` is not a\npurity claim. Nothing validates it, so a body performing IO under it\ndraws no AX3010 at all: the tag reads like a guarantee and buys\nsilence, which is worse than writing no tag, because a reader spends\ntrust on it.\n\nA key containing `:` is never reported. `agent:readonly` is namespaced\nand deliberate, and its distance from `pure` is not evidence about\nanything.\n\nFix the spelling - or, if the key really is your own metadata,\nnamespace it so it cannot be mistaken for a claim.\n\n"
                                                                                                    (if (strEq c "3040")
                                                                                                      "AX3040 - a type variable the caller chooses and the callee produces\n\n    (:: conjure (-> Int a))\n\nThis is not parametric polymorphism. `a` appears in the RESULT and in\nno parameter, so the CALLER chooses what it is, nothing witnesses the\nchoice, and the callee cannot have produced a value of it. The\nsignature promises `forall a. Int -> a`, which in a sound system is\ninhabited only by non-termination. Here it is inhabited by a machine\nword, and the promise is an unchecked coercion wearing a polymorphic\nspelling.\n\nIt reaches memory unsafety, measured rather than argued:\n\n    (fn (conjure n) (cast a n))\n    (strWrap (conjure 42) 8)\n\n`check` answers OK and the binary exits 139 - 42 dereferenced as a\nString pointer. The same shape through `vecGet` is how a `Vec` holding\nan Int reads back as a String, because a `Vec` carries no element type.\n\nWHY IT IS AN ERROR, AND WHEN IT IS NOT. This was a WARNING until\n2026-08-25, on a stated ground: the rule conflated two signatures and\nonly one of them is unsound.\n\n    (:: conjure (-> Int a))     ; body CASTS a word out\n    (:: panic   (-> String a))  ; body NEVER RETURNS\n\nThe second is a correct program - `forall a. String -> a` is the\nhonest type of a diverging function, which is what the paragraph above\nmeans by \"inhabited only by non-termination\". Both checked clean and\nboth drew this diagnostic; then `conjure` exited 139 and `panic` ran\ncorrectly. A check that says the same thing about a segfault and a\ncorrect program is not yet a check.\n\nSo the compiler now tells them apart, and it can do so exactly. A\nfunction whose result is a type variable no parameter mentions can\nproduce that result only two ways, because the type system admits no\nothers: a `cast`, which fabricates the value, or a call to another\nsuch function, which is the same question one level down. The set of\nthem is solved by a fixpoint over their tail positions - assume they\nall diverge, then strike out any whose tail can produce a value. What\nsurvives never returns and is not reported. What is struck out\nfabricates a value and is this error.\n\nA call that never returns also counts: `sysExitWith` is the base case,\nanything whose every tail reaches it inherits that (which is how\n`IO.exit` and `IO.die` qualify), and a `cast` whose ARGUMENT never\nreturns never returns either - the coercion is unreachable.\n\nTHE SECOND SHAPE, and why the rule is about VARIANCE rather than\nsides. Until 2026-08-25 this check asked whether the variable appears\nin a PARAMETER, counting every left side of the arrow spine as one.\nThat question has a wrong answer as soon as a parameter is itself a\nfunction:\n\n    (:: apply1 (-> (-> a Int) Int))\n    (fn (apply1 f) (f (cast a 42)))\n    (apply1 strLen)\n\n`a` is on a left side, so the old rule filed it under \"witnessed\" and\nsaid nothing at all; `check` answered OK and the binary exited 139 -\n42 handed to `strLen` as a String pointer, the same dereference\n`conjure` reaches by the obvious route.\n\nWhat separates them is who CHOOSES the type and who has to PRODUCE a\nvalue of it. A parameter is a position the caller fills. The left of\nan arrow INSIDE that parameter flips back, and is a position the\nCALLEE fills: to call `f` at all, `apply1` must make an `a`, and\nnothing the caller hands over says what one is. So the spine is now\nsplit by variance - a variable with a position the callee produces and\nnone the caller supplies is unwitnessed, wherever it sits.\n\nThe diverging reading is NOT available on this shape, and that stays\ntrue even for a signature that has one. `panic` is honest because a\nfunction that never returns never produced the `a` it promised.\n`apply1` returns an `Int` perfectly well and fabricates on the way.\nAnd this is both at once:\n\n    (:: divDemand (-> (-> a Int) a))\n    (fn (divDemand f) { (f (cast a 42)) (cast a (exit 70)) })\n\nIts RESULT variable is excused, because it really does never return.\nThe `a` it hands to `f` is fabricated anyway, and a divergence that\nhappens after that call does not unmake it. So the two questions are\ndecided separately rather than one subtracted from the other - and\nthe arm that asks about a callback's own variable never consults the\nfixpoint at all.\n\nWhat it over-approximates, stated rather than left to be found: the\nrule reads the SIGNATURE, so a body that never calls its callback at\nall - `(fn (apply1 f) 0)` - is refused for a value it does not make.\nNo declaration in this repository has that shape; 19 signatures nest\nan arrow and the four with variables in one mention every variable on\nboth sides.\n\nWHAT TO DO. Three ways out, in the order to prefer them. Return a\nconcrete word type and let callers write `cast`, which is the\nlanguage's one documented reinterpretation and is visible where it\nhappens. Or make the function DIVERGE, so every path ends in a call\nthat never returns - that is what makes `forall a` honest, and it is\nreported no more. Or, if the declaration really is part of the unsafe\nlayer - a raw word read whose meaning the type system does not model -\ntag it `;@axiom:raw`, on either the signature or the `fn`.\n\nThe tag is not permission and it does not make the read safe. What it\nbuys is that the unsafe layer becomes FINITE and enumerable:\n\n    axiom symbols FILE --diagnostic-format ai | grep '#raw'\n\nNo declaration in this repository carries it any more. Fourteen did\nwhen the tag was introduced on 2026-08-23 - `memGetWord`, `vecGet`,\n`nodeA` and the rest of the raw word reads - and all fourteen were\nmigrated the same day to accessors whose declared result says what the\nword is, so the enumerable unsafe layer is currently empty. Before the\ntag there was no way to ask the question at all.\n\n"
                                                                                                      (if (strEq c "3041")
                                                                                                        "AX3041 - an `extern` block's library name that is not one\n\nThe string an `extern` block opens with is a LINKER LIBRARY NAME: the\nstem of `lib<name>.a`, which is what `-l` takes. It may hold only\n`A-Z`, `a-z`, `0-9`, `.`, `_`, `+` and `-`, and it may not be empty.\n`axiom_demo`, `m` and `c++abi` are names; a path, a flag, or anything\ncarrying whitespace is not.\n\nThe limit exists because that one string reaches two consumers\nverbatim. The driver passes it to the linker as `-l<name>`, and the\nemitter writes it into the module beside the block's `declare` lines\nas `; axiom-extern-lib <name>`, which is how `axiom build` knows what\nto link without being told.\n\nAn LLVM `;` comment ends at the newline. So a library name carrying\none used to end that comment and turn every following line into live\nmodule-level IR - a global, or a `define` with a body, or a\n`@llvm.global_ctors` entry, which runs before `main`. It landed after\nthe type checker, the effect system and the freestanding gate had all\nrun, and the grounding pass that checks external symbols reads\n`declare` lines only, so nothing downstream looked at it.\n\nName only the library here. A directory belongs in `--link-search DIR`\nor `AXIOM_LINK_SEARCH`, and the symbol on the other side of the\nboundary belongs in the item's own `(symbol \"...\")` clause.\n\n"
                                                                                                        (if (strEq c "3042")
                                                                                                          "AX3042 - a function performs IO and does not declare it\n\nThe body reaches outside the process - a `__syscallN`, a call to\nsomething that does, or an `extern` - and the declaration says\nnothing about it.\n\nSILENCE IS A CLAIM HERE. An untagged function is not an unchecked\none: it is a function claiming to perform no IO, and this is that\nclaim being refuted. Effects were opt-in until 2026-08-25, which\nmeant a body could reach the outside world and nothing in the build\nwould say so.\n\nWrite `;@axiom:effect(io)` above the declaration. Effects are\nINFERRED TRANSITIVELY, so this fires on every function up the call\nchain, not only the one holding the syscall - and each of those is a\nplace a reader would otherwise have to open the callee to learn it.\nIf the effect is not wanted there, the fix is to stop performing it\nrather than to stop saying so.\n\nONLY `IO` IS REQUIRED, and the reason is a measurement. Of 3,421\nfunctions in this compiler and its standard library, 2,095 perform\nsomething and 1,664 of those perform exactly `Alloc,Mut` - every\nfunction that touches a String or a Vec, because allocating is what\nan expression does here and `Mut` is set by writing any struct\nfield. REQUIRED is not DECLARABLE: `;@axiom:effect(mut)` over a body\nthat writes a field is accepted, and over one that does not it is\nAX3010. Alloc, Mut and every custom effect are declarable and\nchecked - what is special about `IO` is that its ABSENCE is a claim.\nA declaration required on those distinguishes nothing from\nnothing. `Alloc` and `Mut` stay ambient and stay inferred: `symbols`\nstill reports them and `handle`/`(Pure)` still measure them.\n\nOne shape does not draw this. IO that reaches the row only as\nPOSSIBLE - the body NAMES an IO-performing function without calling\nit, or calls a trait method with more than one implementation - is\nnot evidence that the body performs IO, and an untagged function\nholding nothing more is silent; `;@axiom:pure` over it is AX3037.\nThe reading is PER EFFECT: IO the body performs is accused whatever\nelse the row carries. Until 2026-08-29 one row-global marker excused\nthe whole row, so every untagged function one hop above a `println`\nwith a `{hole}` - four `show` implementations, all possible - checked\nclean and printed.\n\n"
                                                                                                          (if (strEq c "3044")
                                                                                                          "AX3044 - a bare type name is declared in more than one imported module\n\nTwo modules the program imports each declare a type of this name, no\nmodule-less declaration outranks them, and the reference is not inside\neither of them - so nothing decides which one it means.\n\nUntil 2026-08-24 it was decided by ACCIDENT. Type names are not\nrewritten to `Mod$Name` the way `fn` and `::` declarations are, and\nthe lookup returned the first match in the merged declaration list,\nwhich is import order:\n\n    TeamA.ax  (pub struct Config (port : Int) (retries : Int))\n    TeamB.ax  (pub struct Config (retries : Int) (port : Int))\n              (pub fn (bPort) (let ((c (Config 3 99))) c.port))\n    app.ax    (import TeamA) (import TeamB) (fn (main) (bPort))\n\n`check` said OK and the program answered 3 - TeamA's slot 0 - where\nTeamB's own declaration says 99. Swapping the two imports answered 99.\nA module's own correct code was reading another module's field\noffsets, with no diagnostic from any pass.\n\nThat half is fixed and is not what this reports: a reference INSIDE\nthe module that declares the type now reaches its own declaration,\nand so does a reference in the entry file to a type the entry file\ndeclares. This reports the case that is left, where the compiler\ngenuinely cannot tell.\n\nWHAT TO DO. Qualification is NOT the answer here, and this is why the\ncode is not AX3014: `Mod::Name` is an expression spelling and does not\nparse in type position at all. What works is either\n\n  * narrowing the import so only one of the two types is carried:\n    an import name list decides what a module exports to this\n    program, so `(import TeamA (fromA))` leaves TeamA's `Config`\n    invisible outside TeamA and the reference resolves; or\n  * renaming one of the declarations.\n\nA struct in one module and a `data` or `type` of the same name in\nanother are the same collision and are reported the same way: they\nshare one namespace, which is what `(data Foo ...)` beside\n`(type Foo = Int)` in one file has always been refused for.\n\n"
                                                                                                          (if (strEq c "3047")
                                                                                                            "AX3047 - a C or Rust primitive type name in type position\n\nA lowercase name in type position is a TYPE VARIABLE, and there is no\nsuch thing as an unknown one. So `u64` in a signature does not fail -\nit succeeds, binding a fresh variable, and the signature generalises\nover it:\n\n  (:: f (-> u64 Int))   is   forall n. n -> Int\n\nwhich accepts a String. Measured before this diagnostic existed:\n`check` said OK and the program ran. That is the opposite of the\nconstraint the spelling looks like, which is why this is an error and\nnot a warning.\n\nAxiom has ONE integer type, `Int`, 64 bits wide, and one float type,\n`Float`, also 64 bits. There are no width-carrying spellings and no\nsignedness in the type system; `docs/memory-model.md` MM-VAL-3c\nrecords that `Double` and `I64` were removed for exactly this reason -\nthey had names and no widths.\n\nThe uppercase near-misses are already refused, and by a different\nroute: `Double` and `I64` draw AX3002, because an unknown UPPERCASE\nname is an unknown type CONSTRUCTOR and the checker resolves it. Only\nthe lowercase spellings were silent, and this code closes that.\n\nThe narrow integer spellings are real on the OTHER side of an `extern`\nblock: `docs/ffi.md` maps `i32 i16 i8 u32 u16 u8 usize isize` onto\n`Int` and range-checks them at the boundary. They belong in the Rust\nsignature, never in the Axiom one.\n\nA multi-letter type variable is still perfectly legal - `elem`, `out`,\n`acc` and `xs` all check - because the refusal is a NAMED SET, not a\nrule about length. Refusing every multi-letter variable would reject\n`(-> (Vec elem) (-> elem out) (Vec out))`, a correct program.\n\n"
                                                                                                            (if (strEq c "3048")
                                                                                                              "AX3048 - a reference to a deprecated name\n\nThe declaration this name resolves to carries\n`;@axiom:deprecated(...)`, and the tag's text is quoted in the help.\n\nIt is a WARNING by design, not as a staging step toward an error.\nThe name still works and the program still compiles. Refusing it\nhere would make deprecation and removal the same event, and\nseparating those two is the only thing a deprecation notice is for:\nthe release that ANNOUNCES a removal is the one release in which the\ncallers must still build.\n\nThe other half is a gate. `scripts/check-compat.sh` compares the\npublic surface against the last release's baseline and refuses a\nremoved name unless `compat/BREAKING` declares it - EXCEPT when the\nbaseline row carried `#deprecated=`, in which case the removal is\nreported `RETIRED` and permitted outright. So this warning is what a\ncaller sees, and the baseline is what the gate sees, and the notice\nhas to ship a release before the removal for either to apply\n(docs/compatibility.md, COMPAT-7).\n\nTo silence it, stop calling the name - the help says what to use\ninstead, because the tag's author wrote it there.\n\n"
                                                                                                              (if (strEq c "3049")
                                                                                                                "AX3049 - a restriction this declaration claimed, violated\n\n`;@axiom:restrict(no-io)` is a claim that this function and everything\nit reaches performs no IO. This is the compiler answering it, with the\npath:\n\n    parseConfig -> readSection -> IO$writeStr -> ... -> __syscall3\n\nThe path is the whole diagnostic. A restriction on a leaf is easy to\ncheck by reading; a restriction on a call chain is what a call graph\nis for, and printing the chain is the difference between \"somewhere\nbelow you\" and a place to put the fix. Every hop is the RESOLVED\nspelling the checker recorded - `Mod$name`, `Trait#Type#method` - so\nit cross-checks `symbols --calls` hop for hop; the last hop is where\nthe effect enters (a syscall primitive, an `extern`, `__alloc`), or\nthe function whose own body holds the `alloc` form, said so. The tag\ntakes a comma-separated list: `no-cast`, `no-cast:deep`, `no-io`,\n`no-alloc`, `no-foreign`, `no-recursion`, `no-wrap`.\n\n`no-recursion` is a cycle, which is global by definition - a\ndepth-first walk over the same graph - and the path is the walk from\nthe declaration to the function it met twice:\n\n    ping -> pong -> pang -> ping\n    entry -> countdown -> countdown\n\nthe second when the cycle is below the claim. A `while` loop is not\nrecursion. This is the static half of what scripts/check-stack-depth.sh\nmeasures dynamically: a region under `no-recursion` has a stack need\nbounded by its depth rather than by its input.\n\nTHREE OF THE FIVE ARE TRANSITIVE BY CONSTRUCTION and two are not, and\nthe difference is not arbitrary. `no-io` and `no-alloc` read the\neffect row, which is already a transitive fixpoint (docs/reference.md,\nEffects): a function calling an IO-performing function HAS `IO` in its\nrow, and there is no local reading available. `no-foreign` walks the\ncall graph `symbols --calls` prints, for an edge that lands on an\n`extern` item - through every implementation of a trait method the\nbody calls, because that is what dispatch means. `no-cast` is LEXICAL:\na cast is an act, not a propagated property, so it is checked in this\nbody only and reported at the cast itself. A callee's casts are the\ncallee's claim to make - and 653 of this repository's own expressions\nare casts, against 3,196 functions, so a transitive reading would\nrefuse nearly everything that reaches the standard library. Write\n`restrict(no-cast:deep)` for the closure, and expect that: it reports\nthis body's casts at their spans and the nearest reachable function\nwhose body casts, once, with the path.\n\n`no-cast` is the one that makes the others worth having. `cast` is the\none documented way to fabricate a value, and a cast between two\nconcrete types is unchecked - a `Port` carrying 99999 and an `Int` read\nback as a `String` are the same one-word act. Under `restrict(no-cast)`\na type's guarantee is true; without it, it is true of programs that\ndid not write `cast`.\n\n`no-wrap` is LEXICAL for the same reason `no-cast` is: `+`, `-` and\n`*` lower to plain `add`/`sub`/`mul` with no `nsw`, so overflow wraps\nsilently, and that is an act this body performs by writing the raw\noperator rather than a fact the effect row carries. `stdlib/Err.ax`\nhas the checked alternative for each - `addChecked`, `subChecked`,\n`mulChecked`, every one `(-> Int Int (Result Int Error))` - and\ncalling one pulls `Alloc` into this body's row, because constructing\nthe `Result` allocates. `no-wrap` and `no-alloc`, or `no-wrap` and\n`pure`, are therefore not satisfiable together by a body that needs\narithmetic; that is the price of the guarantee, not a bug in it.\n\nThis is an ERROR with no warning stage, for the argument that made\nAX3010 one: a restriction is a claim the author WROTE, and a build\nshipping a false one publishes a guarantee the program does not keep.\nA claim the walk is not in a position to check is AX3051 and stays a\nwarning; this fires only where the walk has an answer.\n\nA restriction is a claim on ONE declaration - a tag attaches to the\ndeclaration below it, on the `::` or on the `fn`, and both are read.\nA module-wide claim is written on each declaration, and `symbols`\nshows `#restrict=` on each.\n\nDeleting the tag also silences this, and an unrestricted function is\nnever checked - but that WITHDRAWS the claim rather than answering it.\n\n"
                                                                                                                (if (strEq c "3050")
                                                                                                                  "AX3050 - a `;@axiom:pre(...)` or `;@axiom:post(...)` the compiler\ncannot compile into a check\n\nA CONTRACT IS BOTH HALVES, and this code is the static one.\n\n`restrict(...)` is refused statically because the analysis that\nanswers it already exists: the effect row and the call graph are\nfixpoints the checker computes anyway. A contract is not that kind of\nclaim. `(> n 0)` is a statement about a VALUE, and this compiler has\nno value analysis at all - no constant folding, no interval domain,\nnothing that could decide it for a caller it has not seen. So the\nrefusal a `restrict` gets is not available here.\n\nThis project's rule is that a claim nothing checks is a comment, and\nit refuses those. So a contract is COMPILED INTO THE BODY and checked\non every call: `pre` before the body runs, `post` over the result. A\nfailure writes\n\n    axiom: precondition failed in `half`: (> n 0)\n\non fd 2, prints the backtrace, and exits 77, beside 70 out of memory,\n71 unhandled effect, 72 division by zero, 73 the FFI boundary, 74 no\nsyscall ABI, 75 an invalid arena mark and 76 an arena reset past a\nlive handle. 77 is SHARED with the out-of-range index trap: a\nsupervisor tells those two apart by the sentence on fd 2 and not by\nthe status, which is a defect and is recorded in\ndocs/subtypes-design.md rather than left to be rediscovered. There is no\nflag: a check that is off by default is a comment by default.\n\nWHAT THIS CODE REFUSES is everything about the contract that IS\nstatic:\n\n  - it must parse, as exactly one expression. `pre((> n 0) extra)` is\n    two, and `pre` with no `(...)` at all is none;\n  - it must type as `Bool` against this declaration's signature, with\n    the parameters in scope. `pre((+ n 1))` is an `Int`;\n  - `result` must name something. It names the DECLARED result of a\n    `post`, and nothing anywhere else: a `pre` runs before the body,\n    so there is no result yet, and a declaration with no `::`\n    signature declares no result type for it to have;\n  - it must PERFORM nothing. A contract is evaluated on every call,\n    so a contract that allocates or writes changes the program by\n    being stated.\n\nTHE LAST ONE IS NOT A BLANKET REFUSAL, and that is measurable rather\nthan asserted: `vecLen`, `vecGet`, `strLen`, `strEq`, `strByte` and\n`memGetWord` all carry an EMPTY effect row, while `strConcat`,\n`fmtInt` and `vecNew` carry `Alloc,Mut`. A contract may compare,\nindex, measure and test; it may not build. Only a DEFINITE effect is\nrefused - an effect that reaches the row only as possible arrived\nbecause the expression names a function without calling it, and\nnaming one performs nothing.\n\nPARAMETERS ARE IN SCOPE IN BOTH, and there is no `'Old`. Ada needs\none because its parameters can be assigned; Axiom's cannot (AX3012),\nso for a scalar parameter the name means in the `post` exactly what it\nmeant in the `pre`. What a `post` cannot see is a change made THROUGH\na reference parameter, and nothing here pretends otherwise.\n\nA `post` COSTS THE TAIL-CALL REWRITE. The result has to be observed,\nso the call it wraps is not in tail position - measured, a\nself-recursive function emits a loop without a `post` and a real\nrecursive call with one. That is inherent to what a postcondition\nis, not an artefact.\n\nCorrect the expression, or delete the tag - which WITHDRAWS the claim\nrather than answering it.\n\n"
                                                                                                                  (if (strEq c "3051")
                                                                                                                  "AX3051 - a restriction claim the effect walk is not in a position to check\n\n`;@axiom:restrict(no-io)`, `no-alloc`, `no-foreign`, `no-recursion` or\n`no-cast:deep` over a body whose answer this walk cannot settle. THREE\nreadings make a claim unverifiable:\n\n  - the row is a LOWER bound - the body calls a value the walk could\n    not resolve (a struct field holding a function, an opaque local,\n    a call applying a callee's result) - so an effect ABSENT from it\n    is not evidence the body avoids it;\n  - the effect is only POSSIBLE - it arrived by naming an arrow-typed\n    function without calling it, or through a trait method with more\n    than one implementation - so its presence is not evidence the\n    body performs it. `symbols` prints these as `#effects-possible=`;\n  - the body CALLS one of its own parameters. The row is complete\n    about this body and answers the wrong question: what the call\n    performs is decided by the argument each caller passes.\n    `symbols` prints `#effect-params=f`, and this reading is why a\n    restriction is not read the way `;@axiom:pure` is. `pure` on\n    `(fn (apply f x) (f x))` STANDS - \"pure modulo its function\n    parameters\" is what purity means on a higher-order function -\n    because it describes a BODY. `restrict(no-io)` reads to whoever\n    calls it as a guarantee about calling it, and that is the\n    caller's to decide.\n\nAn effect present in a lower bound IS evidence, and is AX3049; so is\nan effect the body performs beside one it may, and so is an effect a\nbody performs concretely while also calling a parameter - the claim is\nrefuted there rather than undecided.\n\nA WARNING, and the difference from AX3049 is the point: this is a\nlimit of the ANALYSIS rather than a defect in the program. It is\nAX3037's argument at one remove - a\n`(handle ((b.f) 7) ...)` over a pure `b.f` is a correct program, and\nrefusing it would make dispatch through a stored function unwriteable\nrather than unverified. `no-cast` and `no-wrap` never draw this: a\ncast or a wrapping operator is lexical and is checked whether or not\na call resolved. `no-cast:deep` draws it\nonly when no cast was found in this body or the closure the walk\ncould enumerate - a cast found refutes the claim whatever else the\nwalk could not close.\n\nName the function at the call, stop calling the parameter, or drop the\nclaim. This code is in\ntests/diagnostics/severity.policy, the list of the unanswerable, and\na code that becomes answerable leaves it.\n\n"
                                                                                                                  (if (strEq c "3052")
                                                                                                                    "AX3052 - a name inside `restrict(...)` that is not a restriction\n\nThe restrictions this compiler checks are `no-cast`, `no-cast:deep`,\n`no-io`, `no-alloc`, `no-foreign`, `no-recursion` and `no-wrap`,\ncomma-separated inside one `restrict(...)`; a `restrict` naming\nnothing draws this too. `no-cast:deep` is a name of its own, not a\nmodifier: `no-cast` is local by design and the closure is opted into\nby spelling it.\n\nAn ERROR, and deliberately unlike AX3039, which warns about a key one\nslip from a known one and leaves the key namespace open. The list of\nrestrictions is CLOSED. `restrict(no-fo)` is not metadata the compiler\nrecords and ignores - it is a claim inside the one key the compiler\nhas said it checks, and accepting it would let a tag read like a\nguarantee and buy silence, which is the failure AX3039 exists to\nname. AX3016 refuses an unknown effect name in a `handle` list for the\nsame reason.\n\nCorrect the name, or remove it from the list.\n\n"
                                                                                                                    (if (strEq c "3054")
                                                                                                                      "AX3054 - an effect declared with a built-in effect's name\n\n`(effect IO (emit :: (-> Int Int)))` declares a custom effect called\n`IO`, and nothing can ever handle it. A handle list resolves a\nbuilt-in name to the BUILT-IN, so `(handle (emit 1) (IO) h)` names one\neffect while the body performs another that happens to share its\nspelling.\n\nMeasured before this code existed, on exactly that program:\n\n  W AX3053  `main` reaches operation `emit` of effect `IO` ...\n  E AX3011  effect mismatch: unhandled effect `IO`\n\nTwo diagnostics, neither of them about the name that caused both.\nWithout the handle it is quieter and worse: an untagged `main`\nperforming the custom `IO` reads `#effects=IO` with no `#effect=io`\nand draws nothing at all, so the symbol row says the program reaches\nthe outside world when it does nothing of the kind.\n\nAn ERROR with no warning stage, and the reason is that there is no\ncorrect program on the other side of it. The usual objection to\npromoting a check - that it refuses a program which works - has no\ninstance here: the declaration is unusable in every direction, and\nthe fix is a rename.\n\nThe reserved names are `IO`, `Pure`, `Alloc`, `Mut` and `Div`, plus\n`alloc`, a second spelling of `Alloc` the checker also answers for.\nThey are read from `isBuiltinEffect`, the same function a handle list\nasks, so the refusal and the resolution cannot drift apart.\n\n`Err` IS NO LONGER ONE OF THEM. It used to be accepted as a sixth\nbuilt-in name - `(handle 5 (Err) 0)` checked clean - and nothing in\nthe compiler ever inferred it, so the name resolved and denoted\nnothing. Its own tag spelling could not even reach it: the AXTAG path\nlowercases the value, so `;@axiom:effect(err)` looked for a CUSTOM\neffect named `err` and answered `AX3010 missing err`. A handle list\nnaming `Err` now draws `AX3016`, which is what a list naming\nsomething undeclared has always drawn - and `(effect Err ...)` is an\nordinary declaration, because `Err` is an ordinary name again.\n\n"
                                                                                                                    (if (strEq c "3053")
                                                                                                                      "AX3053 - an operation the program reaches with no handler\n\n`main`'s effect row still carries a custom effect. A `handle`\nDISCHARGES one - it is the only construct that does - so an effect\nleft in the row at the entry point is one nothing installed a handler\nfor, and the operation's dispatch would find the evidence slot empty:\n`axiom: unhandled effect` on fd 2, a backtrace, exit 71\n(docs/memory-model.md MM-EXEC-16).\n\nInstall one - `(handle BODY (E) HANDLER)` around the call - or, if\nreaching the operation with no handler is the DESIGN rather than an\nomission, say so on the effect:\n\n  ;@axiom:unhandled(trap)\n  (effect Assert (assertFailed :: (-> String Int)))\n\n`stdlib/Test.ax` carries that tag, and it is load-bearing rather than\ndecorative: `axiom test` generates a `main` that runs each test inside\na recovery point, every assertion in the file reaches `main` through a\nlambda, and the trap at 71 is exactly how a failed assertion ends one\ntest without ending the run. `scripts/check-test-runner.sh` removes\nthe tag in a shadow copy and requires this warning to appear, so the\ntag cannot be deleted quietly. The value is exactly `trap`; any other\nword leaves the check on, which is the visible failure rather than the\nsilent one.\n\nTHIS IS A WARNING, AND NOT AS A STAGING STEP TOWARD AN ERROR. The\nevidence is one-sided in both directions at once, measured on the two\nclosure shapes:\n\n  (let ((g (lambda (x) (ask x)))) (handle (g 2) (Ask) h))\n\nruns and answers - the handler is installed when `g` is called - and\nis reported here, because a lambda's operations count where the\nlambda is WRITTEN. Its mirror, a closure built INSIDE the handle and\ncalled after the handler pops, traps 71 and is NOT reported, because\nthe `let` of a `handle` form is an opaque local and the row is a lower\nbound there. An error would refuse the program that runs and accept\nthe one that traps. A warning costs the first a line of output and no\nbuild. The severity is recorded in tests/diagnostics/severity.policy\nwith that reason.\n\nWhat it does not report, each a limit stated elsewhere: an effect\nthat reaches the row only as POSSIBLE (`#effects-possible=`, AX3038's\nterritory - unverified rather than unwriteable); an effect behind a\ncall the walk could not follow (`#effects-incomplete`); and an effect\nwhose declaration carries the tag.\n\nA recovery point is not a handler. `__axiom_recover` CONTAINS a trap\n(docs/error-model.md ERR-REC-6) and does not change dispatch, so a\nprogram relying on one to catch an unhandled capability operation is\nwhat this reports; an effect whose unhandled operation is that class\ndeclares it.\n\n"
                                                                                                                    (if (strEq c "3058")
    "AX3058 - a nested region reusing an enclosing region's name\n\n`(region r (region r ...))`: the inner `region` is named like an\nenclosing one that is still open.\n\nRegions are ORDERED BY NESTING - an inner region's extent is inside\nits enclosing region's, and that order is the whole of what `outlives`\nmeans for them (docs/memory-model-v2-design.md MM-RGN-2). A name that\nnamed two open extents at once could not be placed in that order, so\nthe checker keeps the stack of open regions and refuses the reuse\nwhile the outer one is open. The same name in two SIBLING regions is\nfine: `{ (region r a) (region r b) }` opens and closes each in turn.\n\nNothing can refer to a region by name yet. When a `@r` in type\nposition can (S3 of the same document), it will resolve against the\nstack this rule keeps unambiguous, which is why the rule exists before\nthe reference does.\n\nRename the inner region.\n\n"
    (if (strEq c "3059")
      "AX3059 - a value leaving the region it was allocated in\n\n`(region r body)` reclaims, when `body` ends, everything `body`\nallocated: the allocator's waterline is read on entry and rolled back\non exit. Anything still pointing into that memory afterwards points at\nbytes the next allocation will hand out again - reading it is reading\nfreed memory, and it does not fail loudly, it answers the NEXT value's\nbytes (`scripts/check-region-scope.sh` measures exactly that, with the\nrefusal below ablated).\n\nTwo shapes are refused, and they are the two a scope check can see\nwithout region TYPES:\n\n  - the region's own VALUE, when its type is not a scalar. The value\n    is handed past the reset by value, so an `Int`, `Bool`, `Char`,\n    `Float` or `Unit` survives it and a `String` (a descriptor over a\n    second block), a struct, a `Vec` or a closure does not. Answer a\n    scalar - a count, a status, a hash - and keep the reference's\n    owner outside.\n\n  - a `set` inside the region on a binding that was bound OUTSIDE it,\n    when the stored value is not a scalar: `(let ((mut out \"\")) (region\n    r (set out (strConcat a b))))` would leave `out` pointing into the\nreclaimed extent. `(set i (+ i 1))` on an outer counter is fine, which\n    is what makes a region per loop iteration writable. A field store\n    `(set o.f v)` is a store into `o` and follows the same rule.\n\nWhat this does NOT see, stated rather than implied: a CALL that stores\na region-allocated reference for you - `vecPush` onto an outer vector,\n`memSetWord` into an outer block - and a raw `Int` that is an address.\nThose are the program's obligation under docs/memory-model.md\nMM-ALLOC-16, exactly as they are for a hand-written\n`__axiom_arena_mark`, and typed regions (docs/memory-model-v2-design.md\nsection 4, S3) are what close them.\n\n"
      (if (strEq c "3057")
  "AX3057 - a `strict` restriction the effect walk cannot prove\n\n`;@axiom:restrict(no-io, strict)` asks for a GUARANTEE. Where the\nwalk cannot settle the claim it is refused here, rather than\nwarned.\n\nWithout `strict` the same situation is AX3051, a warning, and why\nthat is the default is worth stating: a body that dispatches\nthrough a stored function is a correct program the walk cannot\nfollow, and refusing it would make that shape unwriteable under any\nrestriction rather than merely unverified.\n\n`strict` is the author saying the opposite for THIS declaration. On\na sensitive operation, an unproven guarantee is not a guarantee,\nand a claim that might not hold is worth less than no claim at all\n- a reader who sees `restrict(no-io)` and assumes it was checked is\nworse off than one who sees nothing.\n\nThe three readings are AX3051's: an effect present only as\nPOSSIBLE, a row the walk marked incomplete, and a body that CALLS\none of its own parameters (`#effect-params=`), whose answer is\nchosen by each caller and cannot be settled in the callee.\n\nName the function at the call site instead of taking it as a\nparameter, stop calling the parameter, or drop `strict` to keep the\nclaim as a checked best effort.\n\n`strict` restricts nothing on its own: it is a MODIFIER inside\n`restrict(...)` and not a restriction, so it is neither checked as\none nor reported as an unknown name (AX3052).\n\n"
  (if (strEq c "3056")
                                                                                                                      "AX3056 - a struct field that declares no type\n\n`(struct Box (msg String))` looks like a field declaration and is\nnot one. The `:` is what makes it a declaration at all - the\ngrammar's own note is that the reading \"only becomes visible at the\n`:`\" - so the parser answers a field named `msg` whose type is the\nempty variable, and the `String` beside it is skipped.\n\nNothing downstream refuses that. `fldClass` cannot classify a type\nvariable, so the field is left OUT of the block's reference map and\nout of MM-LIFE-2c event 5, the retain a store into a reference field\ntakes. A value stored there is held by nobody: its own owner releases\nit, the block is filed by size class, and the field points into the\nfree list.\n\nMeasured before this code existed, with a callee storing its argument\ninto such a field: `check` reported nothing, the field read back NUL\nbytes where the message was, and the program exited 139 - SIGSEGV.\nMemory-unsafe code from a program `check` accepted, which is what an\nerror is for - the same sentence AX3055 was spent on, one form over.\n\nWrite the type after a colon, `(msg : String)`. Three spellings reach\nthe same empty variable and all three draw this: no `:` at all, a `:`\nwhose type is not a type (`(msg : 5)`), and a bare `(msg)`. A\nwildcard `(msg : _)` is a different node, and its use sites already\nrefuse it.\n\n"
                                                                                                                    (if (strEq c "3055")
                                                                                                                      "AX3055 - an effect operation that declares no type\n\n`(effect E (op))` names an operation and says nothing about what it\ntakes or answers. Two checks stand on that arrow and on nothing else:\nthe handler a `handle` installs is held to it - `(handle BODY (E)\nHANDLER)` checks HANDLER against `op`'s type (AX3004 when it does not\nfit) and binds a lambda handler's parameters to its parameter types -\nand a call to `op` is held to its arity. With no arrow, neither check\nhas anything to say.\n\nMeasured before this code existed: the untyped operation registered\nas a silent wildcard with arity -1, so `(op 1 2 3)` on a one-argument\nhandler checked clean, and at run time the dispatch applied the\nhandler's RESULT as a function - exit 139, SIGSEGV. Memory-unsafe\ncode from a program `check` accepted, which is what an error is for.\n\nWrite the type after the name, `(op :: (-> Arg Result))`; a\nmulti-argument operation's type right-folds, so `(-> Int Int Int)` is\na two-argument operation whose handler is a curried chain (or a flat\n`(lambda (a b) ..)`, which the parser curries). The type may not\nmention a type variable (AX3017): the handler is installed through a\nprotocol that carries no evidence word, so every type in it has to be\nconcrete (docs/memory-model.md MM-LIFE-2d).\n\nThe parser leaves the field empty for a type it could not read as\nwell as for a missing `::`, so this also fires on an operation whose\ntype is not a type.\n\n"
                                                                                                                    (if (strEq c "4001")
                                                                                                            "AX4001 - no `main` function\n\n`axiom build` and `axiom run` produce an executable, and an\nexecutable starts somewhere: a top-level function named `main`,\ndeclared `(:: main Int)`, whose answer is the process's exit status.\nThis module has none:\n\n    (:: helper Int)\n\n    (fn (helper) 1)\n\nThe diagnostic has no span, because the fault is an absence.\n\n`axiom check` and `axiom emit-llvm` accept the same module without\ncomplaint - a library has no entry point and is well-formed to every\ntool that does not need one - and so does a build under\n`--emit-staticlib`, which archives a module for a foreign host to\ncall.\n\nAdd the pair:\n\n    (:: main Int)\n\n    (fn (main) 0)\n\nor run the tool you meant. A `main` that is present and misspelled\n(`Main`, `mian`) is this code too, and one defined twice is AX3006.\n\n"
                                                                                                            (if (strEq c "4002")
                                                                                                              "AX4002 - code generation failed\n\nThe checker accepted the program and the LLVM emitter could not\nlower it: a shape reached code generation that the check which\nshould have refused it did not run on, or an invariant of the\nemitter failed. The help says so in as many words - `this is a\ncompiler bug: the check that should have refused this program did\nnot run` - and that is the reading to take. Nothing you wrote is\nwrong in the language's terms; the compiler has a gap, and this code\nis the gap announcing itself rather than emitting IR that would fail\nlater in `llc` or at run time.\n\nThere is no program in this text that draws it, deliberately: any\nprogram that did would be a defect to fix, not an example to keep,\nand the diagnostics corpus contains none.\n\nReport it with the smallest program that reproduces it. Until it is\nfixed, write the same computation another way; the message names\nthe construct the emitter stopped on.\n\nThe neighbours are the other build-stage codes: AX4003 for a\ntoolchain command (`llc`, `cc`) that failed after the IR was\nemitted, AX4004 and AX4005 for an `extern` whose symbol or shape the\nlinked archive does not supply, and AX4006 for a thread lowering the\ntarget does not have.\n\n"
                                                                                                              (if (strEq c "4003")
                                                                                                                "AX4003 - external toolchain command failed\n\nAxiom emits LLVM IR itself and then hands it to two external\nprograms: `llc`, which turns the IR into an object file, and `cc`,\nwhich links the object into the executable. This code means one of\nthem could not be run or exited unsuccessfully. The message names\nwhich - `could not run `llc`` - and the build exits with status 4,\nwhich `axiom build` reserves for a failed tool so that it is\ndistinguishable from a program the compiler refused (status 1) or\ncould not parse (status 2).\n\nIt is a fact about the machine, not the program: a hello world draws\nit on a host with no `llc` on `PATH`. `opt`, the mid-level optimiser,\nis the one tool that is optional - a missing `opt` is a warning and\nthe build continues without it.\n\nInstall LLVM and put `llc` on `PATH`, or a C compiler for `cc`. To\nsee what was handed over, `--emit-llvm` keeps the `.ll` file so the\nstep can be run by hand; `scripts/check-driver.sh` is the gate that\nholds a failing `llc` to this code and a missing `opt` to a warning.\n\nAX4002 is the stage BEFORE this one, the emitter failing to produce\nIR at all. AX4004 is the one link failure the compiler answers\nitself, before `cc` runs: an `extern` naming a symbol no linked\narchive defines.\n\n"
                                                                                                                (if (strEq c "4004")
                                                                                                                  "AX4004 - an `extern` names a symbol no archive defines\n\nAn `extern` item binds a linker symbol, and the build checks - before\nwriting a byte or spawning a tool - that some archive on the link line\ncould define it. This error means none can.\n\nUsually the `(symbol \"...\")` clause is a typo, or the archive that\ndefines it is not on the line: pass it with `--link-lib NAME` and\n`--link-search DIR`, where DIR holds `libNAME.a`.\n\nThis is refused HERE, and that is the whole point. The removed\n`foreign` construct emitted a call to a symbol its module never\ndeclared, so a program using one passed `check` and then died inside\n`opt` or the linker, with a message about generated code and no span\ninto the source. An `extern` naming a symbol that does not exist is the\nsame defect, and refusing it at the compiler rather than at the\ntoolchain is the difference between a diagnostic and a link error about\na file you never wrote.\n\nWhat the check proves is one-directional: the name appears nowhere in\nany archive on the link line, so nothing there can define it. It does\nnot claim the converse - a name that does appear might be a string\nconstant rather than a definition - because a false rejection would\nbreak a correct build, while the case that actually happens is a typo.\n\nIt is a `build` diagnostic and cannot fire under `check`, which has no\nlink line to consult.\n\n"
                                                                                                                  (if (strEq c "4005")
                                                                                                                    "AX4005 - an `extern` item's shape disagrees with the crate's shim\n\nEvery shim `#[axiom_export]` writes also exports a DESCRIPTOR beside it: a\nno-op function whose name spells the shim's shape, `<symbol>__sig_<params>_<result>`\nwith one tag per parameter - `i` a plain word (Int, Bool, Char, a Foreign\nhandle, the out-cell), `f` a Float (its IEEE-754 bits), `s` a String, `c` a\ncallback - and the result after the underscore. `axffi_add__sig_ii_i` says\n`(-> Int Int Int)`.\n\nThe build derives the same string from the `extern` item's declared type and\nreads the archive's symbol table for the crate's. A difference is this error,\nat the item: a two-argument declaration over a three-argument shim used to\nbuild, link, and answer whatever was in the third register.\n\nA symbol with no descriptor at all - a hand-written `extern \"C\"` shim - is not\nchecked; it is trusted as written, which is the old contract and the reason\nto let the macro write the shim.\n\nRegenerate the binding module with `axiom-bindgen` when the Rust signature\nchanged, or correct the hand-written item.\n\n"
                                                                                                                    (if (strEq c "4006")
                                                                                                                      "AX4006 - a thread lowering the target does not have\n\n`--threads` lowers `(parallel ...)` to threads, and `__thread_spawn`\nspells a thread directly. Both need a thread runtime: the platform's\n`pthread_create`, and a local-exec thread-local storage the C\nruntime sets up for each new thread, because the emitted runtime's\neight mutable globals - the allocator's five words, the size-class\nheads, the recovery point and one evidence slot per effect - become\nthread-local the moment a program has a second thread (MM-PAR-6).\n\ndarwin and linux have both, and are measured. freebsd links no\n`libthr` here, so the THREAD lowering is refused there - its\nprocess lowering is measured, and measured by execution: the\n`Tests (freebsd-x86_64)` leg boots FreeBSD 14.4 and runs the\nstdlib corpus, `470-parallel`, `471-parallel-trap` and\n`476-par-pool` among it. windows has no `fork` either, so neither\nlowering exists there, `parallel` compiles to a trap that says so\n(status 79), and a build for it warns AX4007.\n\nDrop `--threads` to lower `parallel` to processes - the default,\nand the lowering whose isolation MM-PAR-3 makes true by\nconstruction - or build for a target that has threads. A program\nthat names `__thread_spawn` itself has asked for a thread and gets\nno process fallback: `__proc_spawn` is the spelling for one.\n\n"
                                                                                                                    (if (strEq c "5001")
                                                                                                                      "AX5001 - cannot resolve import\n\nAn `(import Mod.Sub ...)` declaration names a module path that doesn't\ncorrespond to any file on disk. Module paths are resolved relative to\nthe entry file's own directory (the file passed to `check`/`build`/\n`run`/`emit-llvm`), not the directory of whichever file wrote the\n`(import ...)`: `Mod.Sub` looks for `Mod/Sub.ax` next to (or below)\nthe entry file, from every file in the program alike.\n\n"
                                                                                                                      (if (strEq c "4007")
                                                                                                                        "AX4007 - a `parallel` lowering the target has neither of\n\nA WARNING, not a refusal. `(parallel ...)` has two lowerings -\nprocesses by default (`fork`, one shared page per binding,\n`wait4`) and the platform's pthread under `--threads` - and\nwindows-x86_64 has neither: no `fork`, no pthread. AX4006 already\nrefuses `--threads` there at build time. This is the other half,\nabout the DEFAULT lowering, and it does not refuse.\n\nThe module still emits: every spawn and every join is lowered to\n`@__axiom_par_unsupported`, which prints `axiom: parallel is not\navailable on this target` and exits 79. That is deliberate - it is\nwhat lets every cross-target sweep compile the same fixtures for\nevery target - and it means a program whose `parallel` sits on a\npath it never takes BUILDS AND RUNS on windows. An error would\nbreak such a program for a failure it would never suffer.\n\nWhat this warning changes is when you are told: at build time\nrather than at the first spawn. The program is unchanged.\n\nBuild for a target that can spawn - darwin, linux or freebsd all\nfork - or keep the `parallel` off the path this target takes.\n\n"
                                                                                                                        ""
                                                                                                                      )
                                                                                                                    )
                                                                                                                    )
                                                         )
)
)
)
