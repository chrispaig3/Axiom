(import core)
(import Mem)
(import Str)
(import Vec)
(import lexer)
(:: main Int)
(fn (main)
  (let ((src (strFromLit (__addr ")"))))
    (let ((tokens (lex src)))
      (let ((t (vecGet tokens 0)))
        (let ((k (cast Int (tokenKind t)))
              (l (strLen (tokenLexeme t))))
          (+ (* k 100) l))))))
