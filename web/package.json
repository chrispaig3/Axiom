{
  "name": "axiom-site",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "The official website for the Axiom programming language.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-claims.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "node scripts/check-claims.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
