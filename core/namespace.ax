; The declaration NAMESPACE: how a bare name reaches a definition, and
; which names may leave a module.
;
; This module exists because two passes need the same answers and the
; import graph will not let them share a file. Import resolution
; (codegen.ax) mangles a module's declarations to `<dotted-path>$<bare>`
; (`Math.Ops`' `square` is `@Math.Ops$square` in the emitted LLVM -
; `.` is legal in an LLVM identifier; entry-file declarations stay
; bare and `extern` items are unrenamed) and records which of them
; are exported; declaration-macro expansion
; (expand.ax) generates declarations in a module AFTER that pass has
; run and has to put them in the same namespace by the same rules
; (macro-system.md MAC-EXP-16). `codegen` imports `expand`, so the
; helpers cannot live in either - and duplicating them is the failure
; this repository keeps finding, two implementations of one rule that
; drift.
;
; Everything here is a pure function over the two lockstep Vecs the
; resolver threads (`bares` / `fulls`), the index it keeps beside them
; (`MangleIdx`, below), the import filters it records, and the AST
; nodes it renames.
(import Str)
(import Vec)
(import Intern)
(import parser)

; ------------------------------------------------------------------
; The name index.
;
; Every declaration the resolver records asks `bares` once or twice
; whether a name is already claimed. Answered by scanning `bares`,
; resolving a module of N declarations would be N scans of a vector
; growing to N, quadratic in the declaration count. This index answers
; instead, and `scripts/check-name-scale.sh` asserts the per-doubling
; ratio of a check over generated modules of 2,000 to 8,000
; declarations.
;
; WHY IT IS NOT INSIDE `bares`. `bares` is a plain `Vec` that every
; caller of `resolveImports` (main.ax, repl.ax, lsp.ax) allocates
; with `vecNew`, and a `Vec` header is four words with no spare one;
; Axiom has no global state to keep a side table in. So the index is
; a separate structure, created by `resolveImports` and by
; `expandProgram` and threaded beside `bares` to every writer in this
; module. The callers' entry points - `resolveImports`,
; `expandProgram`, `lspResolveFor` - take no index; the writers
; (`mangleRecord`, `mangleRecordSelf`, `mangleRecordEntry`,
; `mangleExternItems`, `mangleDecl`) take `idx` beside `bares`.
;
; WHY IT CANNOT GO STALE. `bares` is append-only: `vecPush` is the
; only operation any writer applies to it (`mangleRecordEntry`'s
; `vecSet` is on `fulls`). So the index records how much of `bares`
; it has absorbed and catches up on every question, from that mark to
; the end. An index created over a `bares` that already holds entries
; is right from its first question, a push it did not see is absorbed
; by the next one, and no writer carries a "keep the index in step"
; obligation to forget - the failure `typecheck.ax`'s `tcPushFn`
; prevents by routing every push through one door is prevented here
; by there being nothing to keep in step.
;
; The table is a stdlib `Intern`: the structure `codegen.ax`'s
; `buildNameIndexes` already keys `bares` with at emission, growing
; itself (load factor 0.5, doubling) since the declaration count is
; not known when the resolver starts, and carrying its own string
; hash - which matters because the checker's `fnIdxHash` lives in
; typecheck.ax and modules flow one way: this module is imported by
; expand.ax and codegen.ax and cannot import the checker. Ids are
; dense in first-interning order, so `pos` - intern id to the FIRST
; index in `bares` carrying that name, what `mangleRecordEntry`'s
; scan answered - is one push per new name.
;
;   names — Intern over bares[0..done)
;   pos   — Vec, intern id -> first index in `bares`
;   done  — entries of `bares` absorbed so far
; ------------------------------------------------------------------
(pub struct MangleIdx
  (names : InternState)
  (pos : (Vec Int))
  (mut done : Int))

(pub :: mangleIdxNew MangleIdx)
(pub fn (mangleIdxNew)
  (MangleIdx :names internNewTyped :pos vecNew :done 0))

; Absorb every entry of `bares` from `done` to its end. Answers the
; new `done`.
(pub :: mangleIdxSync (-> MangleIdx Strings Int))
(pub fn (mangleIdxSync idx bares)
  {
    (let m idx)
    (let mut i m.done)
    {
      (while (< i (vecLen bares))
        {
          {
            (let id (internIntern m.names (vecGetStr bares i)))
            (if (== id (vecLen m.pos))
              (vecPush m.pos i))
          }
          (set i (+ i 1))
        })
      (set m.done i)
      i
    }
  })

; Is `name` in `bares`? The indexed form of `mangleHasIn`, and the
; one every writer here asks.
(pub :: mangleIdxHas (-> MangleIdx Strings String Bool))
(pub fn (mangleIdxHas idx bares name)
  {
    (let m idx)
    (mangleIdxSync idx bares)
    (if (let (Some _) (internFind m.names name))
      true
      false)
  })

; The first index in `bares` holding `name`, or `None`.
;
; `Option` rather than -1: `mangleRecordEntry` reads the answer as
; `(vecSet fulls i name)`, so a miss that reached the index is a wild
; WRITE - it would store into the word before the vector's first.
(pub :: mangleIdxIndexOf (-> MangleIdx Strings String (Option Int)))
(pub fn (mangleIdxIndexOf idx bares name)
  {
    (let m idx)
    (mangleIdxSync idx bares)
    (if (let (Some id) (internFind m.names name))
      (Some (vecGet m.pos id))
      None)
  })

; Record how a bare reference reaches `full`, unless the bare name is
; already claimed. First-writer-wins is what makes the entry file win:
; `resolveImports` records every entry-file function before any import
; is read.
(pub :: mangleRecord (-> MangleIdx Strings Strings String String Int))
(pub fn (mangleRecord idx bares fulls bare full)
  ; The mangled name maps to itself, recorded whether or not the bare
  ; name was already claimed - which it usually is, by the entry
  ; file. This is how a reference made INSIDE a module asks whether
  ; that module defines the name at all, and the bare slot cannot
  ; answer it: it holds exactly one winner per name.
  ;
  ; It changes no existing lookup. The only name that can match one
  ; of these entries is a qualified reference, `Mod::name`, which
  ; stage1 already spells `Mod$name` and which already resolved to
  ; itself by falling off the end of the map.
  {
    (if (! (|| (strEq bare full) (mangleIdxHas idx bares full)))
      {
        (vecPush bares full)
        (vecPush fulls full)
      })
    (if (mangleIdxHas idx bares bare)
      (mangleRecordModuleView idx bares fulls bare full)
      {
        (vecPush bares bare)
        (vecPush fulls full)
        0
      })
  })

; What a bare reference made inside a MODULE reaches when the entry
; file holds the bare slot (AN-52). A module can't import the entry
; file, so the entry's claim is never in a module's scope, and the
; bare slot's winner is the wrong answer there: `IO`'s `println` calls
; `strLen`, and an entry file declaring its own `strLen` must not
; capture that call, at check time or at run time.
;
; The unspellable `$bare` key holds the first imported definition when
; the entry file owns the bare slot. Ordinary entry functions map their
; name to itself; foreign entries carry a separate `$entry$bare` marker,
; because their linker symbols can differ from their Axiom names.
; Two public imported definitions still require qualification (AX3014).
(pub :: mangleRecordModuleView (-> MangleIdx Strings Strings String String Int))
(pub fn (mangleRecordModuleView idx bares fulls bare full)
  (if (let (Some i) (mangleIdxIndexOf idx bares bare))
    (if (|| (strEq (vecGet fulls i) bare) (mangleIdxHas idx bares (concat "$entry$" bare)))
      {
        (let key (concat "$" bare))
        (if (mangleIdxHas idx bares key)
          0
          {
            (vecPush bares key)
            (vecPush fulls full)
            0
          })
      }
      0)
    0))

; The entry file's claim on a bare name, which OVERRIDES whatever an
; import recorded. `mangleRecord` gives the entry file the bare slot by
; running first (`recordEntryFns`, before any import is read), and that
; is enough for declarations the parser produced. It is not enough for
; declarations phase D GENERATES: expansion runs after import
; resolution, and it walks the merged list, where a module's
; declarations come before the entry file's - so a module-side
; invocation claimed the slot first and a bare call in the entry file
; reached the MODULE's function.
;
; Without it, an entry file generating a `tagShape` that answers 42,
; importing a module that generates its own `tagShape` answering 7,
; would check clean and answer 7.
(pub :: mangleRecordEntry (-> MangleIdx Strings Strings String Int))
(pub fn (mangleRecordEntry idx bares fulls name)
  (if (let (Some i) (mangleIdxIndexOf idx bares name))
    {
      ; The module that held the slot keeps its view (see
      ; `mangleRecordModuleView`): a generated entry declaration
      ; must no more capture a module's calls than a written one.
      {
        (let held (vecGet fulls i))
        (if (! (strEq held name))
          {
            (let key (concat "$" name))
            (if (! (mangleIdxHas idx bares key))
              {
                (vecPush bares key)
                (vecPush fulls (strDup held))
              })
          })
      }
      (vecSet fulls i name)
      0
    }
    {
      (vecPush bares name)
      (vecPush fulls name)
      0
    }))

; Is `bare` in `bares`, by scanning it. The UN-INDEXED form, kept for
; the one caller that holds no index: `mangledFor` in codegen.ax, the
; emitter's fallback on the REPL's and LSP's partial paths before
; `buildNameIndexes` has run. Every writer in this module asks
; `mangleIdxHas` instead - see the note above `MangleIdx`.
(pub :: mangleHasIn (-> Strings String Int Bool))
(pub fn (mangleHasIn bares bare i)
  (if (>= i (vecLen bares))
    false
    (if (strEq (vecGet bares i) bare)
      true
      (mangleHasIn bares bare (+ i 1)))))

; Rewrite an imported function's definition to its mangled name, in
; place - `emitFnDef` reads the same node later, so the header and the
; map cannot disagree. Entry-file declarations (None) are left
; bare; they were already recorded by `recordEntryFns`. A signature is
; renamed the same way, so the float-signature registry and the
; definitions it describes stay keyed identically.
;
; `exported` decides which of `mangleRecord`'s two recordings happens.
; A declaration that is carried but NOT exported records only
; `Mod$name -> Mod$name`, so a reference made inside its own module
; still reaches it and no bare name anywhere else can. That split is
; the whole of module privacy in the emitter; the checker enforces the
; other side (see `findFnEnt`), and it has to, because a bare
; reference that gets past it lands here as a name this map does not
; hold and is emitted unchanged - an undefined symbol reported by
; `opt` against generated code.
(pub :: mangleDecl (-> ASTNode (Option String) MangleIdx Strings Strings Int Int))
(pub fn (mangleDecl node modName idx bares fulls exported)
  (match modName
    ((None) 0)
    ((Some modName)
      (if (== (nodeTag node) TAG_D_FN)
        {
          (let bare (nodeAName node))
          {
            (let full (concat (concat (strDup modName) "$") (strDup bare)))
            {
              (writeNodeText node 1 full)
              (if (== exported 1)
                (mangleRecord idx bares fulls bare full)
                (mangleRecordSelf idx bares fulls full))
            }
          }
        }
        (if (== (nodeTag node) TAG_D_SIG)
          {
            (writeNodeText node 1 (concat (concat (strDup modName) "$") (strDup (nodeAName node))))
            0
          }
          ; An `extern` block from an imported module. Its items are
          ; RECORDED and never RENAMED: `Mod$name` would be a symbol no
          ; archive defines, and the mapping wanted here is the Axiom name
          ; to the LINKER symbol, which is what `mangledFor` then answers
          ; at every call site.
          ;
          ; Without this arm an imported binding module emits its calls
          ; against the Axiom name - `call i64 @ffiFreeBytes(...)` beside
          ; a `declare` for `@axffi_free_bytes` - and dies in `opt` with
          ; "use of undefined value". That is exactly the `foreign` bug,
          ; reached from the one direction the entry-file fixtures could
          ; not see, because `recordEntryFns` covers only the entry file.
          (if (== (nodeTag node) TAG_D_EXTERN)
            (mangleExternItems (nodeCChildren node) 0 idx bares fulls modName)
            0)))
    )))

; Record qualified identities for every item and bare names for the
; exported items. A private binding remains callable within its module.
(pub :: mangleExternItems (-> (Vec ASTNode) Int MangleIdx Strings Strings String Int))
(pub fn (mangleExternItems items i idx bares fulls modName)
  (if (== (as items Int) 0)
    0
    (if (>= i (vecLen items))
      0
      {
        {
          (let f (vecGet items i))
          {
            (if (== (nodeVis f) 1)
              (mangleRecord idx bares fulls (nodeAName f) (nodeCName f)))
            {
              (let q (concat modName (concat "$" (nodeAName f))))
              (if (! (mangleIdxHas idx bares q))
                {
                  (vecPush bares q)
                  (vecPush fulls (nodeCName f))
                })
            }
            0
          }
        }
        (mangleExternItems items (+ i 1) idx bares fulls modName)
      })))

; Apply the import filter to declaration names, or to individual extern
; items. Preserve the written public surface for repeat-import unions.
(pub :: moduleDeclExport (-> ASTNode String ModuleImports (Option Names) Int))
(pub fn (moduleDeclExport d mod mods filter)
  (if (== (nodeTag d) TAG_D_EXTERN)
    (moduleExternExport (nodeCChildren d) mod mods filter
      (if (== (as mod Int) 0)
        1
        (nodeVis d))
      0 0)
    {
      (if (&& (!= (as mod Int) 0) (== (nodeVis d) 1))
        (modPubsAdd mods mod (nodeAName d)))
      (if (&& (filterKeeps filter (nodeAName d)) (|| (== (as mod Int) 0) (== (nodeVis d) 1)))
        1
        0)
    }))

(pub :: moduleExternExport (-> (Vec ASTNode) String ModuleImports (Option Names) Int Int Int Int))
(pub fn (moduleExternExport items mod mods filter writtenPub i visible)
  (if (>= i (vecLen items))
    visible
    {
      (let f (vecGet items i))
      {
        (let exported
          (if (&& (== writtenPub 1) (filterKeeps filter (nodeAName f)))
            1
            0))
        {
          (if (&& (!= (as mod Int) 0) (== writtenPub 1))
            (modPubsAdd mods mod (nodeAName f)))
          (writeNodeWord f 5 exported)
          (moduleExternExport items mod mods filter writtenPub (+ i 1)
            (if (== exported 1)
              1
              visible))
        }
      }
    }))

; The half of `mangleRecord` that a private declaration gets: the
; mangled name maps to itself, and the bare slot is left for whoever
; can legitimately claim it.
(pub :: mangleRecordSelf (-> MangleIdx Strings Strings String Int))
(pub fn (mangleRecordSelf idx bares fulls full)
  (if (mangleIdxHas idx bares full)
    0
    {
      (vecPush bares full)
      (vecPush fulls full)
      0
    }))

; Is `name` in this Vec of names? The set test both the resolver's
; `seen` list and an import's name list are asked. It lives here
; rather than beside its first caller because its SECOND caller is
; the filter test below, which expansion needs.
(pub :: seenHasIn (-> Strings String Int Bool))
(pub fn (seenHasIn seen name i)
  (if (>= i (vecLen seen))
    false
    (if (strEq (vecGet seen i) name)
      true
      (seenHasIn seen name (+ i 1)))))

(pub :: filterKeeps (-> (Option Names) String Bool))
(pub fn (filterKeeps filter name)
  (if (let (Some names) filter)
    (seenHasIn names name 0)
    true))

; One imported module owns its filter and written public names. `None`
; means an unrestricted import; `Some` keeps exactly its named surface.
(pub struct ModuleImport
  (name : String)
  (mut filter : (Option Names))
  (pubs : Names))

(pub type ModuleImports (Vec ModuleImport))

; Record the module once, before its declarations are spliced. Later
; imports widen the filter through the same row.
(pub :: modFilterRecord (-> ModuleImports String (Option Names) Int))
(pub fn (modFilterRecord mods name filter)
  {
    (vecPush mods (ModuleImport :name name :filter filter :pubs vecNew))
    0
  })

(:: modImportFor (-> ModuleImports String Int (Option ModuleImport)))
(fn (modImportFor mods name i)
  (if (>= i (vecLen mods))
    None
    {
      (let entry (vecGet mods i))
      (if (strEq entry.name name)
        (Some entry)
        (modImportFor mods name (+ i 1)))
    }))

; The entry file has no imported row and therefore no restriction.
(pub :: modFilterFor (-> ModuleImports String (Option Names)))
(pub fn (modFilterFor mods name)
  (if (let (Some entry) (modImportFor mods name 0))
    entry.filter
    None))

; Preserve written `pub` names before the resolver replaces nodeVis
; with the import's visibility verdict. Repeat imports use this list.
(pub :: modPubsFor (-> ModuleImports String Names))
(pub fn (modPubsFor mods name)
  (if (let (Some entry) (modImportFor mods name 0))
    entry.pubs
    vecNew))

(pub :: modPubsAdd (-> ModuleImports String String Int))
(pub fn (modPubsAdd mods name pubName)
  {
    (if (let (Some entry) (modImportFor mods name 0))
      (vecPush entry.pubs pubName))
    0
  })

; Phase D applies the union of all import filters to declarations that
; macros generate after import resolution has finished.
(pub :: modFilterWiden (-> ModuleImports String (Option Names) Int))
(pub fn (modFilterWiden mods name widened)
  {
    (if (let (Some entry) (modImportFor mods name 0))
      (set entry.filter widened))
    0
  })

(pub :: repeatExportExtern (-> (Vec ASTNode) Strings Int Int))
(pub fn (repeatExportExtern items delta i)
  (if (>= i (vecLen items))
    0
    {
      (if (seenHasIn delta (nodeAName (vecGet items i)) 0)
        (writeNodeWord (vecGet items i) 5 1))
      (repeatExportExtern items delta (+ i 1))
    }))

(pub :: externAnyVisible (-> (Vec ASTNode) Int Int))
(pub fn (externAnyVisible items i)
  (if (>= i (vecLen items))
    0
    (if (== (nodeVis (vecGet items i)) 1)
      1
      (externAnyVisible items (+ i 1)))))
