; through, the UART helper every trap writes through, and the trap a
; `__syscallN` lowers to on a target that has no syscall ABI. The
; no-syscall def is `emitWinRuntime`'s byte for byte - same message,
; same status 74 - because the only difference between the two is which
; door `emitRuntimeWrite` and `emitRuntimeExit` take, and that is asked
; per target where it is used. The UART loop's store is VOLATILE: the
; address never changes, so a plain store would be dead-store
; elimination's to merge and a trap would report its last byte.
(pub :: emitBaremetalRuntime (-> CG CG))
(pub fn (emitBaremetalRuntime cg)
  {
    (emitLine cg "@__axiom_exit_block = internal global [2 x i64] zeroinitializer")
    (emitLine cg "define internal void @__axiom_uart_write(i64 %ptr, i64 %len) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ 0, %entry ], [ %in, %body ]")
    (emitLine cg "  %more = icmp ult i64 %i, %len")
    (emitLine cg "  br i1 %more, label %body, label %done")
    (emitLine cg "body:")
    (emitLine cg "  %a = add i64 %ptr, %i")
    (emitLine cg "  %p = inttoptr i64 %a to ptr")
    (emitLine cg "  %b = load i8, ptr %p")
    (emitLine cg
      (concat "  store volatile i8 %b, ptr inttoptr (i64 "
        (concat (fmtInt (targetUartBase (cgTarget cg))) " to ptr)")))
    (emitLine cg "  %in = add i64 %i, 1")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg
      "@__axiom_nosys_msg = private unnamed_addr constant [37 x i8] c\"axiom: no syscall ABI on this target\\0A\"")
    (emitLine cg "define internal i64 @__axiom_no_syscall() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 74)")
    (emitLine cg "  %nsp = ptrtoint ptr @__axiom_nosys_msg to i64")
    (emitRuntimeWrite cg "%nsp" "37")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "74")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; The reset vector: QEMU's `-kernel` jumps to the ELF entry with an
; UNDEFINED stack, so the first instruction sets `sp` from the
; linker's `__stack_top` (the top of an 8 KiB stack over an unmapped
; guard: `baremetalLinkScript` in driver.ax) and the last parks in `wfi` if the
; semihosting call ever returns. `naked` comes BEFORE `section` -
; the other order does not parse - and a frame would store through
; the stack before it exists, which is what `naked` refuses. NOT
; `#0`: `frame-pointer="all"` would rebuild the frame `naked`
; refuses. The `hlt` + exit-block shape is `emitBaremetalExit`'s,
; with the reason for a clean return (131110, 0x20026,
; ADP_Stopped_ApplicationExit) and the status `main` answered; the
; trap path writes the same block with its own reason. Emitted only
; beside `@main`, never into an archive: `_start` names `main`, and
; a host linking the archive has its own entry.
(pub :: emitBaremetalStart (-> CG CG))
(pub fn (emitBaremetalStart cg)
  {
    (emitLine cg "@__stack_top = external global i8, align 16")
    (emitLine cg "@__axiom_rx_end = external global i8")
    (emitLine cg "@__axiom_ro_end = external global i8")
    (emitLine cg "@__axiom_rw_end = external global i8")
    (emitLine cg "@__axiom_stack_lo = external global i8")
    (emitLine cg "@__axiom_exc_lo = external global i8")
    (emitLine cg "@__axiom_exc_top = external global i8")
    (emitLine cg "@__axiom_pt = external global i8")
    (emitMmuTables cg)
    (emitLine cg "define void @_start() naked section \".text.boot\" {")
    (emitLine cg "entry:")
    (emitLine cg "  %sp = ptrtoint ptr @__stack_top to i64")
    (emitLine cg "  call void asm sideeffect \"mov sp, $0\", \"r,~{memory}\"(i64 %sp)")
    ; CPACR_EL1.FPEN := 0b11, so an FP or SIMD instruction the compiler
    ; chose does not trap (it resets to 0 at EL1, and a `Float`, or a
    ; vectorised copy, is then an undefined-instruction exception);
    ; then VBAR_EL1 := the vector table, and an ISB so both are in force
    ; before anything else runs - a fault while the tables are built is
    ; reported like any other.
    (emitLine cg
      "  call void asm sideeffect \"mrs x9, cpacr_el1\\0Aorr x9, x9, #0x300000\\0Amsr cpacr_el1, x9\\0Aadrp x9, __axiom_vectors\\0Aadd x9, x9, :lo12:__axiom_vectors\\0Amsr vbar_el1, x9\\0Aisb\", \"~{x9},~{memory}\"()")
    ; The page tables, built with the MMU still off, then the MMU and
    ; both caches on. The enable is here and not in the builder: no
    ; stack data crosses the switch, so nothing written uncached is read
    ; back through a cache that could hold a stale line for it.
    (emitLine cg "  call void @__axiom_mmu_tables()")
    (emitLine cg
      (concat "  call void asm sideeffect \""
        (concat (mmuEnableAsm) "\", \"~{x9},~{x10},~{memory}\"()")))
    (emitLine cg "  %st = call i64 @main(i64 0, i64 0)")
    (emitLine cg "  store i64 131110, ptr @__axiom_exit_block")
    (emitLine cg
      "  store i64 %st, ptr getelementptr ([2 x i64], ptr @__axiom_exit_block, i64 0, i64 1)")
    (emitLine cg
      "  call void asm sideeffect \"hlt 0xf000\", \"{x0},{x1},~{x0},~{x1},~{memory}\"(i64 24, i64 ptrtoint (ptr @__axiom_exit_block to i64))")
    (emitLine cg "  call void asm sideeffect \"1: wfi\\0Ab 1b\", \"\"()")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; ------------------------------------------------------------------
; THE MEMORY MAP (docs/embedded-guide.md section 6): the MMU on, over
; identity-mapped translation tables `_start` builds before `main`.
;
; ONE LEVEL-1 TABLE of 4 GiB (T0SZ 32, 4 KiB granule, so the walk
; starts at level 1 and entry k covers gigabyte k):
;   entry 0  a level-2 table for the peripherals. Two 2 MiB blocks are
;            mapped, Device-nGnRnE and execute-never: 0x08000000 (the
;            GIC's distributor, CPU interface and redistributors) and
;            0x09000000 (the PL011 UART, the RTC, fw_cfg, the GPIO).
;            Everything else below RAM - address 0 included - is not
;            mapped, so a null or wild pointer is a translation fault.
;   entry 1  a level-2 table for RAM, each entry a level-3 table of
;            512 pages, as many as the image needs up to `__axiom_exc_top`.
; Every page of RAM is mapped by the section it holds (the linker
; script in `driver.ax` names the boundaries): code read-only and
; executable, read-only data read-only and execute-never, data, `.bss`
; and both stacks read-write and execute-never, and the guard below
; each stack not mapped at all. Nothing past the image is mapped:
; memory a program uses comes from the arena, which is in `.bss`.
;
; Normal memory is inner and outer write-back, read- and
; write-allocate, inner shareable; MAIR_EL1 attribute 0 is
; Device-nGnRnE and attribute 1 Normal. SCTLR_EL1 gets M (the MMU),
; C and I (both caches), A (a misaligned access faults, on Normal
; memory too, so `+strict-align` still keeps LLVM from writing one and
; `tests/embedded/fault.ax` still faults), SA (a misaligned stack
; pointer faults) and WXN (every writable page is execute-never,
; whatever its descriptor says).
; ------------------------------------------------------------------
; Stage-1 descriptor bits for the 4 KiB granule: bits 1:0 are 0b11 for
; a page or a table and 0b01 for a block; bits 4:2 AttrIndx; bit 7
; AP[2], read-only; bits 9:8 SH, 0b11 inner shareable; bit 10 AF, set
; because nothing else sets the access flag; bit 53 PXN and bit 54 UXN,
; execute-never at EL1 and at EL0.
(pub :: mmuPageNormal Int)
(pub fn (mmuPageNormal)
  (+ 3 (+ 4 (+ 768 1024))))

(pub :: mmuXn Int)
(pub fn (mmuXn)
  (+ (<< 1 53) (<< 1 54)))

; Code: read-only, executable at EL1 and never at EL0.
(pub :: mmuAttrCode Int)
(pub fn (mmuAttrCode)
  (+ mmuPageNormal (+ 128 (<< 1 54))))

; Read-only data: read-only, execute-never.
(pub :: mmuAttrRodata Int)
(pub fn (mmuAttrRodata)
  (+ mmuPageNormal (+ 128 mmuXn)))

; Data, `.bss` and the stacks: read-write, execute-never.
(pub :: mmuAttrData Int)
(pub fn (mmuAttrData)
  (+ mmuPageNormal mmuXn))

; A 2 MiB peripheral block: a block, AttrIndx 0 (Device-nGnRnE), AF,
; read-write, execute-never.
(pub :: mmuAttrDevice Int)
(pub fn (mmuAttrDevice)
  (+ 1 (+ 1024 mmuXn)))

; The enable, run by `_start` once the tables are built: MAIR_EL1
; (0xff00: attribute 0 Device-nGnRnE, attribute 1 Normal write-back),
; TCR_EL1 (0x80a03520: T0SZ 32, TTBR0 walks inner and outer write-back
; and inner shareable, a 4 KiB granule, 32-bit physical addresses,
; TTBR1 walks disabled), TTBR0_EL1, the TLB and the instruction cache
; invalidated, then SCTLR_EL1 |= 0x8100f (M, A, C, SA, I and WXN).
(pub :: mmuEnableAsm String)
(pub fn (mmuEnableAsm)
  "mov x9, #0xff00\\0Amsr mair_el1, x9\\0Amov x9, #0x3520\\0Amovk x9, #0x80a0, lsl #16\\0Amsr tcr_el1, x9\\0Aadrp x9, __axiom_pt\\0Aadd x9, x9, :lo12:__axiom_pt\\0Amsr ttbr0_el1, x9\\0Aisb\\0Atlbi vmalle1\\0Aic iallu\\0Adsb sy\\0Aisb\\0Amrs x9, sctlr_el1\\0Amov x10, #0x100f\\0Amovk x10, #0x8, lsl #16\\0Aorr x9, x9, x10\\0Amsr sctlr_el1, x9\\0Aisb")

; The builder, with the MMU off, so every store below goes straight to
; memory. The stores are volatile, which keeps them as written: no
; merging into wider or unaligned stores the Device memory of an
; MMU-off core would fault on. Then the lines the tables occupy are
; invalidated (`dc ivac`), so a stale cache line can't shadow them
; once the walks are cacheable.
;
; One page's descriptor is a chain of selects on its address against
; the section boundaries, lowest boundary last: code, read-only data,
; data, the guard (0, not mapped), the stack, the second guard, the
; fault stack.
(pub :: emitMmuTables (-> CG CG))
(pub fn (emitMmuTables cg)
  {
    (emitLine cg "define internal void @__axiom_mmu_tables() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %rx = ptrtoint ptr @__axiom_rx_end to i64")
    (emitLine cg "  %ro = ptrtoint ptr @__axiom_ro_end to i64")
    (emitLine cg "  %rw = ptrtoint ptr @__axiom_rw_end to i64")
    (emitLine cg "  %sl = ptrtoint ptr @__axiom_stack_lo to i64")
    (emitLine cg "  %st = ptrtoint ptr @__stack_top to i64")
    (emitLine cg "  %xl = ptrtoint ptr @__axiom_exc_lo to i64")
    (emitLine cg "  %xt = ptrtoint ptr @__axiom_exc_top to i64")
    (emitLine cg "  %pt = ptrtoint ptr @__axiom_pt to i64")
    (emitLine cg "  %span = sub i64 %xt, 1073741824")
    (emitLine cg "  %pages = lshr i64 %span, 12")
    (emitLine cg "  %nl3a = add i64 %pages, 511")
    (emitLine cg "  %nl3 = lshr i64 %nl3a, 9")
    (emitLine cg "  %ntab = add i64 %nl3, 3")
    (emitLine cg "  %nwords = shl i64 %ntab, 9")
    (emitLine cg "  %nlines = shl i64 %ntab, 6")
    (emitLine cg "  %l2d = add i64 %pt, 4096")
    (emitLine cg "  %l2r = add i64 %pt, 8192")
    (emitLine cg "  %l3 = add i64 %pt, 12288")
    (emitLine cg "  br label %zero")
    ; Every word of every table, zero: an entry nothing below writes is
    ; invalid, which is what "not mapped" means.
    (emitLine cg "zero:")
    (emitLine cg "  %zi = phi i64 [ 0, %entry ], [ %zn, %zero ]")
    (emitLine cg "  %zo = shl i64 %zi, 3")
    (emitLine cg "  %za = add i64 %pt, %zo")
    (emitLine cg "  %zp = inttoptr i64 %za to ptr")
    (emitLine cg "  store volatile i64 0, ptr %zp")
    (emitLine cg "  %zn = add i64 %zi, 1")
    (emitLine cg "  %zmore = icmp ult i64 %zn, %nwords")
    (emitLine cg "  br i1 %zmore, label %zero, label %links")
    (emitLine cg "links:")
    (emitLine cg "  %l1p = inttoptr i64 %pt to ptr")
    (emitLine cg "  %l1e0 = or i64 %l2d, 3")
    (emitLine cg "  store volatile i64 %l1e0, ptr %l1p")
    (emitLine cg "  %l1a1 = add i64 %pt, 8")
    (emitLine cg "  %l1p1 = inttoptr i64 %l1a1 to ptr")
    (emitLine cg "  %l1e1 = or i64 %l2r, 3")
    (emitLine cg "  store volatile i64 %l1e1, ptr %l1p1")
    ; The two peripheral blocks: level-2 entries 64 (0x08000000) and 72
    ; (0x09000000), at byte offsets 512 and 576.
    (emitLine cg "  %dga = add i64 %l2d, 512")
    (emitLine cg "  %dgp = inttoptr i64 %dga to ptr")
    (emitLine cg
      (concat "  store volatile i64 " (concat (fmtInt (+ 134217728 mmuAttrDevice)) ", ptr %dgp")))
    (emitLine cg "  %dua = add i64 %l2d, 576")
    (emitLine cg "  %dup = inttoptr i64 %dua to ptr")
    (emitLine cg
      (concat "  store volatile i64 " (concat (fmtInt (+ 150994944 mmuAttrDevice)) ", ptr %dup")))
    (emitLine cg "  br label %tabs")
    (emitLine cg "tabs:")
    (emitLine cg "  %ti = phi i64 [ 0, %links ], [ %tn, %tabs ]")
    (emitLine cg "  %to = shl i64 %ti, 12")
    (emitLine cg "  %tt = add i64 %l3, %to")
    (emitLine cg "  %td = or i64 %tt, 3")
    (emitLine cg "  %tso = shl i64 %ti, 3")
    (emitLine cg "  %tsa = add i64 %l2r, %tso")
    (emitLine cg "  %tsp = inttoptr i64 %tsa to ptr")
    (emitLine cg "  store volatile i64 %td, ptr %tsp")
    (emitLine cg "  %tn = add i64 %ti, 1")
    (emitLine cg "  %tmore = icmp ult i64 %tn, %nl3")
    (emitLine cg "  br i1 %tmore, label %tabs, label %pagel")
    (emitLine cg "pagel:")
    (emitLine cg "  %pi = phi i64 [ 0, %tabs ], [ %pn, %pagel ]")
    (emitLine cg "  %po = shl i64 %pi, 12")
    (emitLine cg "  %pa = add i64 %po, 1073741824")
    (emitLine cg "  %isx = icmp ult i64 %pa, %rx")
    (emitLine cg "  %isr = icmp ult i64 %pa, %ro")
    (emitLine cg "  %isw = icmp ult i64 %pa, %rw")
    (emitLine cg "  %isg = icmp ult i64 %pa, %sl")
    (emitLine cg "  %iss = icmp ult i64 %pa, %st")
    (emitLine cg "  %isg2 = icmp ult i64 %pa, %xl")
    (emitLine cg (concat "  %a5 = select i1 %isg2, i64 0, i64 " (fmtInt mmuAttrData)))
    (emitLine cg (concat "  %a4 = select i1 %iss, i64 " (concat (fmtInt mmuAttrData) ", i64 %a5")))
    ; The guard below the stack: 0, not mapped.
    (emitLine cg "  %a3 = select i1 %isg, i64 0, i64 %a4")
    (emitLine cg (concat "  %a2 = select i1 %isw, i64 " (concat (fmtInt mmuAttrData) ", i64 %a3")))
    (emitLine cg
      (concat "  %a1 = select i1 %isr, i64 " (concat (fmtInt mmuAttrRodata) ", i64 %a2")))
    (emitLine cg (concat "  %a0 = select i1 %isx, i64 " (concat (fmtInt mmuAttrCode) ", i64 %a1")))
    (emitLine cg "  %none = icmp eq i64 %a0, 0")
    (emitLine cg "  %pd0 = or i64 %pa, %a0")
    (emitLine cg "  %pd = select i1 %none, i64 0, i64 %pd0")
    (emitLine cg "  %pso = shl i64 %pi, 3")
    (emitLine cg "  %psa = add i64 %l3, %pso")
    (emitLine cg "  %psp = inttoptr i64 %psa to ptr")
    (emitLine cg "  store volatile i64 %pd, ptr %psp")
    (emitLine cg "  %pn = add i64 %pi, 1")
    (emitLine cg "  %pmore = icmp ult i64 %pn, %pages")
    (emitLine cg "  br i1 %pmore, label %pagel, label %flush")
    ; `dsb ishst`, then `dsb ish` after the invalidates: the forms for
    ; tables the walker of this core reads, and not `__arm_dsb`'s
    ; `dsb sy`, so a count of the primitive's barriers counts only it.
    (emitLine cg "flush:")
    (emitLine cg "  call void asm sideeffect \"dsb ishst\", \"~{memory}\"()")
    (emitLine cg "  br label %inval")
    (emitLine cg "inval:")
    (emitLine cg "  %ii = phi i64 [ 0, %flush ], [ %in, %inval ]")
    (emitLine cg "  %io = shl i64 %ii, 6")
    (emitLine cg "  %ia = add i64 %pt, %io")
    (emitLine cg "  call void asm sideeffect \"dc ivac, $0\", \"r,~{memory}\"(i64 %ia)")
    (emitLine cg "  %in = add i64 %ii, 1")
    (emitLine cg "  %imore = icmp ult i64 %in, %nlines")
    (emitLine cg "  br i1 %imore, label %inval, label %done")
    (emitLine cg "done:")
    (emitLine cg "  call void asm sideeffect \"dsb ish\", \"~{memory}\"()")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
  })

; ------------------------------------------------------------------
; THE EXCEPTION VECTOR TABLE (R-D2, 2026-09-27) - on baremetal-aarch64
; only, in every executable, and the one piece of hand-written assembly
; the port carries beyond `_start`. It is TRUSTED CODE: nothing in the
; checker looks inside a `module asm` string, so what follows is kept
; to what the architecture requires and is written out here in full,
; where a reviewer reads it (docs/embedded-guide.md section 5).
;
; WHY ALWAYS, NOT ONLY WHEN A HANDLER IS BOUND. Before this table a
; synchronous exception - an alignment fault, an undefined instruction,
; a data abort - jumped to whatever VBAR_EL1 held at reset and the
; guest spun until something killed it: a gate saw a TIMEOUT and a
; board would see a hang. Now every vector but a bound IRQ reaches
; `@__axiom_cpu_exception`, which writes the vector offset, ESR_EL1,
; ELR_EL1 and FAR_EL1 to the UART once and exits with status 81
; (MM-EXEC-16) through the semihosting door every other trap uses. It
; is not recoverable and does not pretend to be: a recovery point armed
; in the interrupted code is not jumped to, because the jump would
; leave the core in exception context with interrupts masked.
;
; THE LAYOUT is the architecture's: 16 slots of 128 bytes, 2 KiB
; aligned (VBAR_EL1 ignores bits 10:0), four groups of synchronous /
; IRQ / FIQ / SError. The port runs at EL1 on SP_EL1, so the group that
; fires is "current EL with SPx" at 0x200; the other three groups can
; only fire after something the port never does (switching to SP_EL0,
; dropping to EL0), and reach the same fault exit. Each slot is two
; instructions - the slot offset into x0, a branch - because a slot is
; 32 instructions and the save below is 60.
;
; THE IRQ ENTRY, when one function is bound with `;@axiom:isr(irq)`:
; save every register AAPCS64 lets a callee clobber - x0-x18, x29, x30
; (x18 is allocatable on this triple), ELR_EL1 and SPSR_EL1, FPCR/FPSR
; and q0-q7, q16-q31, since `_start` turns the FP unit on and compiled
; Axiom may use it - call `@__axiom_irq_dispatch`, restore, `eret`.
; 592 bytes of the interrupted stack, a multiple of 16. The core masks
; IRQ on entry and `eret` restores the interrupted mask, so a handler
; is never re-entered: there is no nesting, by construction.
; ------------------------------------------------------------------
; The value of an `isr(...)` tag in one tag set: "" for no tag or a
; plain `isr`, else what is between the parentheses.
(pub :: isrTagValueIn (-> Axtags Int String))
(pub fn (isrTagValueIn tags i)
  (if (>= i (vecLen tags))
    ""
    {
      (let tag (vecGet tags i))
      (let content tag.content)
      (if (&& (strStartsWith content "isr(") (== (strByte content (- (strLen content) 1)) 41))
        (strTrim (strSlice content 4 (- (strLen content) 5)))
        (isrTagValueIn tags (+ i 1)))
    }))

; Every declaration carrying `isr(<vector>)`: name then vector, two
; Strings per binding. A `::` and its `fn` are one declaration and both
; may carry the tag, so a name is recorded once.
(pub :: isrBindings (-> (Vec ASTNode) Strings Int Strings))
(pub fn (isrBindings decls acc i)
  (if (>= i (vecLen decls))
    acc
    {
      (let d (vecGet decls i))
      {
        (if (|| (== (nodeTag d) TAG_D_FN) (== (nodeTag d) TAG_D_SIG))
          {
            (let v
              (match (nodeAxtagsOpt d)
                ((None) "")
                ((Some tags) (isrTagValueIn tags 0))))
            (if (&& (> (strLen v) 0) (== (isrBound acc (nodeAName d) 0) 0))
              {
                (vecPush acc (nodeAName d))
                (vecPush acc v)
              })
          })
        (isrBindings decls acc (+ i 1))
      }
    }))

(pub :: isrBound (-> Strings String Int Int))
(pub fn (isrBound acc name i)
  (if (>= i (vecLen acc))
    0
    (if (strEq (vecGetStr acc i) name)
      1
      (isrBound acc name (+ i 2)))))

; The functions bound to vector `v` ("irq" or "fault"), in declaration
; order.
(pub :: isrVectorNames (-> Strings String Int Strings Strings))
(pub fn (isrVectorNames bs v i acc)
  (if (>= i (vecLen bs))
    acc
    {
      (if (strEq (vecGetStr bs (+ i 1)) v)
        (vecPush acc (vecGetStr bs i)))
      (isrVectorNames bs v (+ i 2) acc)
    }))

; The function `;@axiom:isr(fault)` binds as the fault hook, or "" -
; for a module with none, and for one with two, which AX4008 refuses.
; Every emitter that changes shape for a hook asks here, so one answer
; decides all of them. An archive asks too and gets its trap exits
; routed to `__axiom_trap_entry`, which only an executable's vector
; table defines; the bare-metal link refuses an archive anyway.
(pub :: baremetalFaultHandler (-> CG String))
(pub fn (baremetalFaultHandler cg)
  {
    (let fs (isrVectorNames (isrBindings (cgDecls cg) vecNew 0) "fault" 0 vecNew))
    (if (== (vecLen fs) 1)
      (vecGetStr fs 0)
      "")
  })

; What every module does about `isr(...)` bindings, beside `_start`:
; on baremetal-aarch64 it writes the vector table and wires the bound
; handlers; everywhere, a binding this target cannot honour - any
; vector on a hosted target, a vector name the compiler does not bind,
; two handlers for one vector - leaves an AX4008 marker at top level,
; where `pruneDeadDefs` cannot delete it, and `main.ax` refuses the
; module.
(pub :: emitIsrBinding (-> CG CG))
;@axiom:effect(io)
(pub fn (emitIsrBinding cg)
  {
    (let bs (isrBindings (cgDecls cg) vecNew 0))
    (let t (cgTarget cg))
    {
      (let irqs (isrVectorNames bs "irq" 0 vecNew))
      (let faults (isrVectorNames bs "fault" 0 vecNew))
      {
        (emitIsrMarkers cg bs t 0)
        (if (> (vecLen irqs) 1)
          (emitLine cg
            (concat "; axiom-device-refused `isr(irq)` binds "
              (concat (fmtInt (vecLen irqs))
                (concat " functions to the one IRQ vector (`"
                  (concat (vecGetStr irqs 0)
                    (concat "`, `"
                      (concat (vecGetStr irqs 1)
                        "`) - bind one handler and dispatch on the interrupt id inside it"))))))))
        (if (> (vecLen faults) 1)
          (emitLine cg
            (concat "; axiom-device-refused `isr(fault)` binds "
              (concat (fmtInt (vecLen faults))
                (concat " functions to the one fault hook (`"
                  (concat (vecGetStr faults 0)
                    (concat "`, `"
                      (concat (vecGetStr faults 1) "`) - bind one hook and decide inside it"))))))))
        (if (&& (== t 7) (! cgStaticlib))
          (emitBaremetalVectors cg
            (if (> (vecLen irqs) 0)
              (vecGetStr irqs 0)
              "")
            (baremetalFaultHandler cg))
          cg)
      }
    }
  })

(pub :: emitIsrMarkers (-> CG Strings Int Int CG))
(pub fn (emitIsrMarkers cg bs t i)
  (if (>= i (vecLen bs))
    cg
    {
      (if (strEq (vecGetStr bs (+ i 1)) "irq")
        (if (! (== t 7))
          (emitLine cg
            (concat "; axiom-device-refused `isr(irq)` on `"
              (concat (bareOfSym (vecGetStr bs i))
                (concat "` binds the IRQ exception vector, and "
                  (concat (targetSpelling t)
                    " has no vector table this compiler writes - only baremetal-aarch64 does"))))))
        (if (strEq (vecGetStr bs (+ i 1)) "fault")
          (if (! (== t 7))
            (emitLine cg
              (concat "; axiom-device-refused `isr(fault)` on `"
                (concat (bareOfSym (vecGetStr bs i))
                  (concat "` binds the fault hook every unhandled exception and trap reaches, and "
                    (concat (targetSpelling t)
                      " has no vector table this compiler writes - only baremetal-aarch64 does"))))))
          (emitLine cg
            (concat "; axiom-device-refused `isr("
              (concat (vecGetStr bs (+ i 1))
                (concat
                  (concat ")` on `"
                    (concat (bareOfSym (vecGetStr bs i))
                      "` names no vector this compiler binds - it binds `isr(irq)` and `isr(fault)`, on baremetal-aarch64"))
                  ""))))))
      (emitIsrMarkers cg bs t (+ i 2))
    }))

; `Mod$name` -> `name`, for a sentence.
(pub :: bareOfSym (-> String String))
(pub fn (bareOfSym s)
  (if (let (Some k) (strFindByte s 36 0))
    (strSlice s (+ k 1) (- (strLen s) (+ k 1)))
    s))

(pub :: emitAsmLine (-> CG String CG))
(pub fn (emitAsmLine cg text)
  (emitLine cg (concat "module asm \"" (concat text "\""))))

; THE FAULT EXIT RUNS ON ITS OWN STACK. `__axiom_exc_entry` points sp
; at `__axiom_exc_top` before anything touches memory: a stack overflow
; faults with sp inside the guard, and the report - or the hook - could
; not push a frame there. The switch costs nothing on the way back,
; because the fault exit never goes back.
;
; THE FAULT HOOK, when one function is bound with `;@axiom:isr(fault)`:
; every exit the program did not ask for reaches it once - a CPU
; exception after its report line, and a software trap (70 to 85) after
; its sentence, through `__axiom_trap_entry`, which masks D, A, I and F
; and takes the same stack. It is called with the status the fixed exit
; would answer, the vector offset (-1 for a software trap), ESR_EL1,
; ELR_EL1 and FAR_EL1 (0 for a trap), with no recovery point armed, and
; its answer is the exit status. A second fault while it runs takes the
; fixed exit and never re-enters it (`@__axiom_exc_busy`: 0 idle, 1 the
; fixed exit, 2 the hook).
(pub :: emitBaremetalVectors (-> CG String String CG))
(pub fn (emitBaremetalVectors cg handler hook)
  {
    (let bound (> (strLen handler) 0))
    (let hooked (> (strLen hook) 0))
    {
      (emitAsmLine cg ".pushsection .text.vectors,\\22ax\\22,@progbits")
      (emitAsmLine cg ".balign 2048")
      (emitAsmLine cg ".globl __axiom_vectors")
      (emitAsmLine cg "__axiom_vectors:")
      (emitVectorSlots cg bound 0)
      (emitAsmLine cg "__axiom_exc_entry:")
      (emitAsmLine cg "adrp x9, __axiom_exc_top")
      (emitAsmLine cg "add x9, x9, :lo12:__axiom_exc_top")
      (emitAsmLine cg "mov sp, x9")
      (emitAsmLine cg "mrs x1, esr_el1")
      (emitAsmLine cg "mrs x2, elr_el1")
      (emitAsmLine cg "mrs x3, far_el1")
      (emitAsmLine cg "bl __axiom_cpu_exception")
      (emitAsmLine cg "1: wfi")
      (emitAsmLine cg "b 1b")
      (if hooked
        {
          (emitAsmLine cg ".globl __axiom_trap_entry")
          (emitAsmLine cg "__axiom_trap_entry:")
          (emitAsmLine cg "msr daifset, #0xf")
          (emitAsmLine cg "adrp x9, __axiom_exc_top")
          (emitAsmLine cg "add x9, x9, :lo12:__axiom_exc_top")
          (emitAsmLine cg "mov sp, x9")
          (emitAsmLine cg "bl __axiom_fault_trap")
          (emitAsmLine cg "2: wfi")
          (emitAsmLine cg "b 2b")
        }
        cg)
      (if bound
        (emitIrqEntryAsm cg)
        cg)
      (emitAsmLine cg ".popsection")
      (emitCpuExceptionFn cg hook)
      (if hooked
        (emitFaultHookFns cg hook)
        cg)
      (if bound
        (emitIrqDispatch cg handler)
        cg)
      (emitLine cg
        (if bound
          (if hooked
            "@llvm.used = appending global [3 x ptr] [ptr @__axiom_cpu_exception, ptr @__axiom_irq_dispatch, ptr @__axiom_fault_trap], section \"llvm.metadata\""
            "@llvm.used = appending global [2 x ptr] [ptr @__axiom_cpu_exception, ptr @__axiom_irq_dispatch], section \"llvm.metadata\"")
          (if hooked
            "@llvm.used = appending global [2 x ptr] [ptr @__axiom_cpu_exception, ptr @__axiom_fault_trap], section \"llvm.metadata\""
            "@llvm.used = appending global [1 x ptr] [ptr @__axiom_cpu_exception], section \"llvm.metadata\"")))
      (emitLine cg "")
    }
  })

; Slot `i` of 16: the bound IRQ slot (current EL, SPx: slot 5, 0x280)
; branches to the entry below; every other slot loads its own offset
; into x0 and takes the fault exit.
(pub :: emitVectorSlots (-> CG Bool Int CG))
(pub fn (emitVectorSlots cg bound i)
  (if (>= i 16)
    cg
    {
      (emitAsmLine cg ".balign 128")
      (if (&& bound (== i 5))
        (emitAsmLine cg "b __axiom_irq_entry")
        {
          (emitAsmLine cg (concat "mov x0, #" (fmtInt (* i 128))))
          (emitAsmLine cg "b __axiom_exc_entry")
        })
      (emitVectorSlots cg bound (+ i 1))
    }))

; The save area, from the stack pointer up: x0..x17 in pairs at 0-143,
; x18/x29 at 144, x30/ELR at 160, SPSR/FPCR at 176, FPSR at 192, then
; q0-q7 at 208-335 and q16-q31 at 336-591.
(pub :: emitIrqEntryAsm (-> CG CG))
(pub fn (emitIrqEntryAsm cg)
  {
    (emitAsmLine cg "__axiom_irq_entry:")
    (emitAsmLine cg "sub sp, sp, #592")
    (emitGprPairs cg "stp" 0)
    (emitAsmLine cg "stp x18, x29, [sp, #144]")
    (emitAsmLine cg "mrs x0, elr_el1")
    (emitAsmLine cg "stp x30, x0, [sp, #160]")
    (emitAsmLine cg "mrs x0, spsr_el1")
    (emitAsmLine cg "mrs x1, fpcr")
    (emitAsmLine cg "stp x0, x1, [sp, #176]")
    (emitAsmLine cg "mrs x0, fpsr")
    (emitAsmLine cg "str x0, [sp, #192]")
    (emitQPairs cg "stp" 0)
    (emitAsmLine cg "bl __axiom_irq_dispatch")
    (emitQPairs cg "ldp" 0)
    (emitAsmLine cg "ldr x0, [sp, #192]")
    (emitAsmLine cg "msr fpsr, x0")
    (emitAsmLine cg "ldp x0, x1, [sp, #176]")
    (emitAsmLine cg "msr spsr_el1, x0")
    (emitAsmLine cg "msr fpcr, x1")
    (emitAsmLine cg "ldp x30, x0, [sp, #160]")
    (emitAsmLine cg "msr elr_el1, x0")
    (emitAsmLine cg "ldp x18, x29, [sp, #144]")
    (emitGprPairs cg "ldp" 0)
    (emitAsmLine cg "add sp, sp, #592")
    (emitAsmLine cg "eret")
  })

; x(2k), x(2k+1) at 16k, for k in 0..8.
(pub :: emitGprPairs (-> CG String Int CG))
(pub fn (emitGprPairs cg op k)
  (if (> k 8)
    cg
    {
      (emitAsmLine cg
        (concat (concat op (concat " x" (fmtInt (* 2 k))))
          (concat (concat ", x" (fmtInt (+ (* 2 k) 1)))
            (concat ", [sp, #" (concat (fmtInt (* 16 k)) "]")))))
      (emitGprPairs cg op (+ k 1))
    }))

; q0-q7 and q16-q31, two per instruction, 32 bytes apart from 208.
(pub :: emitQPairs (-> CG String Int CG))
(pub fn (emitQPairs cg op k)
  (if (> k 11)
    cg
    {
      (let r
        (if (< k 4)
          (* 2 k)
          (+ 16 (* 2 (- k 4)))))
      {
        (emitAsmLine cg
          (concat (concat op (concat " q" (fmtInt r)))
            (concat (concat ", q" (fmtInt (+ r 1)))
              (concat ", [sp, #" (concat (fmtInt (+ 208 (* 32 k))) "]")))))
        (emitQPairs cg op (+ k 1))
      }
    }))

; A NUL-free message constant, its length counted here rather than by
; hand - the count is what the UART writer believes.
(pub :: emitMsgGlobal (-> CG String String CG))
(pub fn (emitMsgGlobal cg name text)
  (emitLine cg
    (concat (concat "@" (concat name " = private unnamed_addr constant ["))
      (concat (fmtInt (strLen text)) (concat " x i8] c\"" (concat text "\""))))))

(pub :: emitMsgWrite (-> CG String String CG))
(pub fn (emitMsgWrite cg name text)
  {
    (emitLine cg
      (concat "  %" (concat name (concat "_p = ptrtoint ptr @" (concat name " to i64")))))
    (emitRuntimeWrite cg (concat "%" (concat name "_p")) (fmtInt (strLen text)))
  })

; The fault exit every unbound vector reaches. Its register state is
; the interrupted code's except x0-x3 and x9, which the slot and the
; entry loaded, so ELR_EL1 names the faulting instruction. Written
; ONCE: a second exception while reporting the first - the UART itself
; faulting, say - finds the busy word set and exits without writing.
;
; A data abort whose address is in the guard below a stack gets a
; second line saying so, because a stack overflow is the fault whose
; registers are hardest to read: ELR is some function's prologue and
; FAR an address no program named.
;
; With a fault hook bound, the report is written as before and the
; hook then chooses the exit (`emitFaultHookFns`); a fault while the
; hook runs is reported once more, as a fault in the fault handler,
; and takes the fixed 81.
(pub :: emitCpuExceptionFn (-> CG String CG))
(pub fn (emitCpuExceptionFn cg hook)
  {
    (let m0 "axiom: unhandled CPU exception at vector 0x")
    (let m1 " esr 0x")
    (let m2 " elr 0x")
    (let m3 " far 0x")
    (let mg "axiom: stack overflow: the fault address is in the guard page below a stack")
    (let mh "axiom: CPU exception in the fault handler at vector 0x")
    (let hooked (> (strLen hook) 0))
    {
      (emitLine cg "@__axiom_exc_busy = internal global i64 0")
      (emitMsgGlobal cg "__axiom_exc_m0" m0)
      (emitMsgGlobal cg "__axiom_exc_m1" m1)
      (emitMsgGlobal cg "__axiom_exc_m2" m2)
      (emitMsgGlobal cg "__axiom_exc_m3" m3)
      (emitMsgGlobal cg "__axiom_exc_mg" mg)
      (if hooked
        (emitMsgGlobal cg "__axiom_exc_mh" mh))
      (emitLine cg "@__axiom_exc_nl = private unnamed_addr constant [1 x i8] c\"\\0A\"")
      (emitLine cg "define internal void @__axiom_uart_hex(i64 %v) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  br label %loop")
      (emitLine cg "loop:")
      (emitLine cg "  %sh = phi i64 [ 60, %entry ], [ %next, %loop ]")
      (emitLine cg "  %x = lshr i64 %v, %sh")
      (emitLine cg "  %d = and i64 %x, 15")
      (emitLine cg "  %alpha = icmp ugt i64 %d, 9")
      (emitLine cg "  %base = select i1 %alpha, i64 87, i64 48")
      (emitLine cg "  %c = add i64 %d, %base")
      (emitLine cg "  %b = trunc i64 %c to i8")
      (emitLine cg
        (concat "  store volatile i8 %b, ptr inttoptr (i64 "
          (concat (fmtInt (targetUartBase (cgTarget cg))) " to ptr)")))
      (emitLine cg "  %next = sub i64 %sh, 4")
      (emitLine cg "  %more = icmp sge i64 %sh, 4")
      (emitLine cg "  br i1 %more, label %loop, label %done")
      (emitLine cg "done:")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      ; The registers, after the line's opening words, and the guard
      ; line when the fault is a data abort (EC 0x25) at an address in
      ; either guard.
      (emitLine cg
        "define internal void @__axiom_exc_regs(i64 %vec, i64 %esr, i64 %elr, i64 %far) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  call void @__axiom_uart_hex(i64 %vec)")
      (emitMsgWrite cg "__axiom_exc_m1" m1)
      (emitLine cg "  call void @__axiom_uart_hex(i64 %esr)")
      (emitMsgWrite cg "__axiom_exc_m2" m2)
      (emitLine cg "  call void @__axiom_uart_hex(i64 %elr)")
      (emitMsgWrite cg "__axiom_exc_m3" m3)
      (emitLine cg "  call void @__axiom_uart_hex(i64 %far)")
      (emitMsgWrite cg "__axiom_exc_nl" "\n")
      (emitLine cg "  %ec = lshr i64 %esr, 26")
      (emitLine cg "  %dabt = icmp eq i64 %ec, 37")
      (emitLine cg "  %ga0 = ptrtoint ptr @__axiom_rw_end to i64")
      (emitLine cg "  %ga1 = ptrtoint ptr @__axiom_stack_lo to i64")
      (emitLine cg "  %gb0 = ptrtoint ptr @__stack_top to i64")
      (emitLine cg "  %gb1 = ptrtoint ptr @__axiom_exc_lo to i64")
      (emitLine cg "  %ina0 = icmp uge i64 %far, %ga0")
      (emitLine cg "  %ina1 = icmp ult i64 %far, %ga1")
      (emitLine cg "  %ina = and i1 %ina0, %ina1")
      (emitLine cg "  %inb0 = icmp uge i64 %far, %gb0")
      (emitLine cg "  %inb1 = icmp ult i64 %far, %gb1")
      (emitLine cg "  %inb = and i1 %inb0, %inb1")
      (emitLine cg "  %ing = or i1 %ina, %inb")
      (emitLine cg "  %so = and i1 %dabt, %ing")
      (emitLine cg "  br i1 %so, label %guard, label %done")
      (emitLine cg "guard:")
      (emitMsgWrite cg "__axiom_exc_mg" mg)
      (emitLine cg "  %nlp2 = ptrtoint ptr @__axiom_exc_nl to i64")
      (emitRuntimeWrite cg "%nlp2" "1")
      (emitLine cg "  br label %done")
      (emitLine cg "done:")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg
        "define void @__axiom_cpu_exception(i64 %vec, i64 %esr, i64 %elr, i64 %far) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %busy = load volatile i64, ptr @__axiom_exc_busy")
      (emitLine cg "  store volatile i64 1, ptr @__axiom_exc_busy")
      (emitLine cg "  %again = icmp ne i64 %busy, 0")
      (emitLine cg
        (if hooked
          "  br i1 %again, label %twice, label %say"
          "  br i1 %again, label %out, label %say"))
      (emitLine cg "say:")
      (emitMsgWrite cg "__axiom_exc_m0" m0)
      (emitLine cg "  call void @__axiom_exc_regs(i64 %vec, i64 %esr, i64 %elr, i64 %far)")
      (if hooked
        {
          ; The hook chooses what happens next, and never comes back here.
          (emitLine cg
            "  call void @__axiom_fault_hook(i64 81, i64 %vec, i64 %esr, i64 %elr, i64 %far)")
          (emitLine cg "  unreachable")
          ; A fault inside the hook: reported once, then the fixed exit.
          ; A fault while the report itself is written (busy 1) says
          ; nothing more.
          (emitLine cg "twice:")
          (emitLine cg "  %inhook = icmp eq i64 %busy, 2")
          (emitLine cg "  br i1 %inhook, label %sayh, label %out")
          (emitLine cg "sayh:")
          (emitMsgWrite cg "__axiom_exc_mh" mh)
          (emitLine cg "  call void @__axiom_exc_regs(i64 %vec, i64 %esr, i64 %elr, i64 %far)")
          (emitLine cg "  br label %out")
        }
        (emitLine cg "  br label %out"))
      (emitLine cg "out:")
      (emitBaremetalExit cg "81")
      (emitLine cg "}")
    }
  })

; The fault hook's two doors. `@__axiom_fault_hook` marks the hook
; running, disarms any recovery point (a trap inside the hook exits
; with its own status; it never unwinds into code the fault
; abandoned), calls the bound function and exits with its answer.
; `@__axiom_fault_trap` is where a software trap's exit arrives, on the
; fault stack with D, A, I and F masked (`__axiom_trap_entry`): the
; first one runs the hook, and one raised while the hook runs - or
; while the exit after it runs - exits with its own status, as it would
; with no hook bound.
(pub :: emitFaultHookFns (-> CG String CG))
(pub fn (emitFaultHookFns cg hook)
  {
    (emitLine cg
      "define internal void @__axiom_fault_hook(i64 %st, i64 %vec, i64 %esr, i64 %elr, i64 %far) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  store volatile i64 2, ptr @__axiom_exc_busy")
    (emitLine cg "  store i64 0, ptr @__axiom_recover_top")
    (emitLine cg
      (concat "  %r = call i64 @"
        (concat (llvmSym (strDup hook))
          (if (== (fnTakesEvw cg hook) 1)
            "(i64 %st, i64 %vec, i64 %esr, i64 %elr, i64 %far, i64 0)"
            "(i64 %st, i64 %vec, i64 %esr, i64 %elr, i64 %far)"))))
    (emitLine cg "  store volatile i64 1, ptr @__axiom_exc_busy")
    (emitBaremetalExit cg "%r")
    (emitLine cg "}")
    (emitLine cg "define void @__axiom_fault_trap(i64 %st) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %busy = load volatile i64, ptr @__axiom_exc_busy")
    (emitLine cg "  %first = icmp eq i64 %busy, 0")
    (emitLine cg "  br i1 %first, label %hook, label %fixed")
    (emitLine cg "hook:")
    (emitLine cg "  call void @__axiom_fault_hook(i64 %st, i64 -1, i64 0, i64 0, i64 0)")
    (emitLine cg "  unreachable")
    (emitLine cg "fixed:")
    (emitLine cg "  store volatile i64 1, ptr @__axiom_exc_busy")
    (emitBaremetalExit cg "%st")
    (emitLine cg "}")
  })

; A trap's exit on the bare target: with a fault hook bound, the trap
; entry, so the hook sees the status; otherwise the semihosting exit
; itself. Status 0 - a forked child's clean end, which this target
; never forks - is never a trap and never reaches the hook. The branch
; is assembly, `bl` with the status in x0, because the entry is defined
; in the vector table's assembly and a `declare` would read to the
; link's grounding pass as a foreign symbol; x30 is left naming the
; trap site.
(pub :: emitBaremetalTrapExit (-> CG String CG))
(pub fn (emitBaremetalTrapExit cg status)
  (if (&& (> (strLen (baremetalFaultHandler cg)) 0)
        (if (strEq status "0")
          false
          true))
    {
      (emitLine cg
        (concat
          "  call void asm sideeffect \"bl __axiom_trap_entry\", \"{x0},~{lr},~{memory}\"(i64 "
          (concat status ")")))
      (emitLine cg "  unreachable")
    }
    (emitBaremetalExit cg status)))

; The IRQ vector's call into Axiom: the bound handler, run with no
; recovery point armed - a trap inside a handler ends the program with
; its own status instead of unwinding into whatever the interrupted
; code had armed, which would resume it with interrupts still masked -
; and the slot put back before `eret`. A handler that performs an effect
; operation gets evidence 0, so the operation is the no-handler trap,
; status 71: nothing is in extent inside an interrupt.
(pub :: emitIrqDispatch (-> CG String CG))
(pub fn (emitIrqDispatch cg handler)
  {
    (emitLine cg "define void @__axiom_irq_dispatch() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %rt = load i64, ptr @__axiom_recover_top")
    (emitLine cg "  store i64 0, ptr @__axiom_recover_top")
    (emitLine cg
      (concat "  %r = call i64 @"
        (concat (llvmSym (strDup handler))
          (if (== (fnTakesEvw cg handler) 1)
            "(i64 0)"
            "()"))))
    (emitLine cg "  store i64 %rt, ptr @__axiom_recover_top")
    (emitLine cg "  ret void")
    (emitLine cg "}")
  })

; ------------------------------------------------------------------
; The Windows entry: `mainCRTStartup`, linked with no C runtime.
;
; WHAT IT HAS TO PRODUCE. `Sys.ax` reads the command line through
; `__argc`/`__argv` and the environment as `argv[argc+1+i]` - the
; POSIX process-stack layout,
;
;   argv[0..argc-1], NULL, envp[0..m-1], NULL
;
; contiguous, which every Linux and Darwin kernel lays out and which
; nothing on Windows does. The design note proposed a new global and a
; new `__envp` primitive for Windows; that is not available to this
; tree, because the standard library is compiled by the COMMITTED SEED
; and a primitive the seed does not know cannot appear in `Sys.ax`
; until the seed moves. So the shim builds that exact vector instead,
; and `Sys.ax` needs no change and no Windows arm: every existing
; argv/env test proves the reader, and this is the only writer.
;
; UTF-16 IN, UTF-8 OUT, ONCE. `GetCommandLineW` and
; `GetEnvironmentStringsW` answer UTF-16; everything above `sysArg`
; reads bytes. Converting here, once, is what keeps `Str`, `Path`, `IO`
; and `Sys` byte-oriented and untouched. A lone surrogate becomes
; U+FFFD, the convention `Utf8.utf8Replacement` already sets.
;
; THE SPLIT IS HAND-ROLLED, AND kernel32 IS THE ONLY DLL. The
; alternative was shell32's `CommandLineToArgvW`: one more DLL for
; every Axiom binary to load, one more name on the import allowlist,
; for forty lines of parsing. The rules implemented are the ones that
; function documents, post-2008 msvcrt included: whitespace outside
; quotes delimits; `"` toggles quoting; `2n` backslashes before a `"`
; are `n` backslashes and the quote is a delimiter; `2n+1` are `n` and
; a literal quote; backslashes not before a quote are literal; and a
; `""` inside quotes is one literal quote, still inside. The program
; name is special, as it is there: quotes delimit it and backslashes
; never escape. Phase 4's `CreateProcessW` join must invert exactly
; these rules, and the round-trip fixture that catches a drift is
; named in the design note beside it.
;
; MEMORY comes from `axiom_alloc`, which is emitted in this same
; module and initialises itself on first use through `VirtualAlloc` -
; zeroed, so the two NULL terminators are written explicitly only for
; a reader's sake. The environment block from
; `GetEnvironmentStringsW` is never freed; it lives as long as the
; process, which is exactly as long as `sysEnv` needs it.
;
; `ExitProcess(r)` at the end, because with `/entry:mainCRTStartup`
; there is nothing above this function to return to.
;
; The parsers keep their state in `alloca` cells rather than `phi`
; webs: at `--opt 0` that is a few stack words, at `--opt 1` and above
; mem2reg makes them registers, and a state machine written as loads
; and stores can be read against the rules above line by line.
; ------------------------------------------------------------------
(pub :: emitWinPeek (-> CG String CG))
(pub fn (emitWinPeek cg tag)
  {
    (emitLine cg (concat "  %" (concat tag "_i = load i64, ptr %ii")))
    (emitLine cg (concat (concat "  %" tag) (concat "_o = shl i64 %" (concat tag "_i, 1"))))
    (emitLine cg (concat (concat "  %" tag) (concat "_a = add i64 %cmd, %" (concat tag "_o"))))
    (emitLine cg
      (concat (concat "  %" tag) (concat "_p = inttoptr i64 %" (concat tag "_a to ptr"))))
    (emitLine cg (concat (concat "  %" tag) (concat "_w = load i16, ptr %" (concat tag "_p"))))
    (emitLine cg (concat (concat "  %" tag) (concat " = zext i16 %" (concat tag "_w to i64"))))
    cg
  })

(pub :: emitWinAdvance (-> CG String String CG))
(pub fn (emitWinAdvance cg tag n)
  {
    (emitLine cg (concat "  %" (concat tag "_ai = load i64, ptr %ii")))
    (emitLine cg
      (concat (concat "  %" (concat tag (concat "_an = add i64 %" tag)))
        (concat "_ai, " (concat n ""))))
    (emitLine cg (concat "  store i64 %" (concat tag "_an, ptr %ii")))
    cg
  })

(pub :: emitWinPush (-> CG String String CG))
(pub fn (emitWinPush cg tag unitExpr)
  {
    (emitLine cg (concat "  %" (concat tag "_k = load i64, ptr %kk")))
    (emitLine cg (concat (concat "  %" tag) (concat "_ko = shl i64 %" (concat tag "_k, 1"))))
    (emitLine cg
      (concat (concat "  %" tag) (concat "_ka = add i64 %scratch, %" (concat tag "_ko"))))
    (emitLine cg
      (concat (concat "  %" tag) (concat "_kp = inttoptr i64 %" (concat tag "_ka to ptr"))))
    (emitLine cg
      (concat (concat "  %" (concat tag "_kt = trunc i64 "))
        (concat unitExpr (concat " to i16" ""))))
    (emitLine cg (concat (concat "  store i16 %" tag) (concat "_kt, ptr %" (concat tag "_kp"))))
    (emitLine cg (concat (concat "  %" tag) (concat "_k1 = add i64 %" (concat tag "_k, 1"))))
    (emitLine cg (concat "  store i64 %" (concat tag "_k1, ptr %kk")))
    cg
  })

; Close the argument in `scratch`: narrow it into `strs` and record it
; in `vec` when filling, count it either way. Falls out at the bottom
; in block `<tag>_count`, so the caller writes the branch that follows.
(pub :: emitWinFinish (-> CG String CG))
(pub fn (emitWinFinish cg tag)
  {
    (emitLine cg (concat "  %" (concat tag "_n = load i64, ptr %nn")))
    (emitLine cg (concat "  %" (concat tag "_v0 = icmp eq i64 %vec, 0")))
    (emitLine cg
      (concat (concat "  br i1 %" (concat tag "_v0, label %"))
        (concat tag (concat (concat "_count, label %" (concat tag "_fill")) ""))))
    (emitLine cg (concat "" (concat tag "_fill:")))
    (emitLine cg (concat "  %" (concat tag "_k = load i64, ptr %kk")))
    (emitLine cg (concat "  %" (concat tag "_c = load i64, ptr %cc")))
    (emitLine cg (concat (concat "  %" tag) (concat "_d = add i64 %strs, %" (concat tag "_c"))))
    (emitLine cg
      (concat (concat "  %" (concat tag "_b = call i64 @__axiom_win_narrow(i64 %scratch, i64 %"))
        (concat tag (concat (concat "_k, i64 %" (concat tag "_d)")) ""))))
    (emitLine cg (concat (concat "  %" tag) (concat "_vo = shl i64 %" (concat tag "_n, 3"))))
    (emitLine cg (concat (concat "  %" tag) (concat "_va = add i64 %vec, %" (concat tag "_vo"))))
    (emitLine cg
      (concat (concat "  %" tag) (concat "_vp = inttoptr i64 %" (concat tag "_va to ptr"))))
    (emitLine cg (concat (concat "  store i64 %" tag) (concat "_d, ptr %" (concat tag "_vp"))))
    (emitLine cg (concat (concat "  %" tag) (concat "_b1 = add i64 %" (concat tag "_b, 1"))))
    (emitLine cg
      (concat (concat "  %" (concat tag (concat "_c1 = add i64 %" tag)))
        (concat "_c, %" (concat tag "_b1"))))
    (emitLine cg (concat "  store i64 %" (concat tag "_c1, ptr %cc")))
    (emitLine cg (concat "  br label %" (concat tag "_count")))
    (emitLine cg (concat "" (concat tag "_count:")))
    (emitLine cg (concat (concat "  %" tag) (concat "_n1 = add i64 %" (concat tag "_n, 1"))))
    (emitLine cg (concat "  store i64 %" (concat tag "_n1, ptr %nn")))
    cg
  })

(pub :: emitWinEntry (-> CG CG))
;@axiom:effect(io)
(pub fn (emitWinEntry cg)
  {
    (emitLine cg "declare dllimport i64 @GetCommandLineW() #0")
    (emitLine cg "declare dllimport i64 @GetEnvironmentStringsW() #0")
    (emitLine cg "")
    (if (== (mainReturnsResult cg) 1)
      {
        (emitLine cg "@__axiom_result_prefix = private unnamed_addr constant [7 x i8] c\"axiom: \"")
        (emitLine cg "@__axiom_result_nl = private unnamed_addr constant [1 x i8] c\"\\0A\"")
        (emitLine cg "")
      })
    ; UTF-16 code units before the NUL.
    (emitLine cg "define internal i64 @__axiom_win_wlen(i64 %p) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %ip = alloca i64")
    (emitLine cg "  store i64 %p, ptr %ip")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %cur = load i64, ptr %ip")
    (emitLine cg "  %cp = inttoptr i64 %cur to ptr")
    (emitLine cg "  %u = load i16, ptr %cp")
    (emitLine cg "  %z = icmp eq i16 %u, 0")
    (emitLine cg "  br i1 %z, label %done, label %next")
    (emitLine cg "next:")
    (emitLine cg "  %n = add i64 %cur, 2")
    (emitLine cg "  store i64 %n, ptr %ip")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  %d = sub i64 %cur, %p")
    (emitLine cg "  %len = lshr i64 %d, 1")
    (emitLine cg "  ret i64 %len")
    (emitLine cg "}")
    (emitLine cg "")
    ; One code point as UTF-8 at `dst + o`; answers the new offset.
    (emitLine cg "define internal i64 @__axiom_win_put(i64 %cp, i64 %dst, i64 %o) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %a0 = add i64 %dst, %o")
    (emitLine cg "  %p0 = inttoptr i64 %a0 to ptr")
    (emitLine cg "  %a1 = add i64 %a0, 1")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %a2 = add i64 %a0, 2")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  %a3 = add i64 %a0, 3")
    (emitLine cg "  %p3 = inttoptr i64 %a3 to ptr")
    (emitLine cg "  %one = icmp ult i64 %cp, 128")
    (emitLine cg "  br i1 %one, label %b1, label %t2")
    (emitLine cg "b1:")
    (emitLine cg "  %c1 = trunc i64 %cp to i8")
    (emitLine cg "  store i8 %c1, ptr %p0")
    (emitLine cg "  %o1 = add i64 %o, 1")
    (emitLine cg "  ret i64 %o1")
    (emitLine cg "t2:")
    (emitLine cg "  %two = icmp ult i64 %cp, 2048")
    (emitLine cg "  br i1 %two, label %b2, label %t3")
    (emitLine cg "b2:")
    (emitLine cg "  %h2 = lshr i64 %cp, 6")
    (emitLine cg "  %h2b = or i64 %h2, 192")
    (emitLine cg "  %h2c = trunc i64 %h2b to i8")
    (emitLine cg "  store i8 %h2c, ptr %p0")
    (emitLine cg "  %l2 = and i64 %cp, 63")
    (emitLine cg "  %l2b = or i64 %l2, 128")
    (emitLine cg "  %l2c = trunc i64 %l2b to i8")
    (emitLine cg "  store i8 %l2c, ptr %p1")
    (emitLine cg "  %o2 = add i64 %o, 2")
    (emitLine cg "  ret i64 %o2")
    (emitLine cg "t3:")
    (emitLine cg "  %three = icmp ult i64 %cp, 65536")
    (emitLine cg "  br i1 %three, label %b3, label %b4")
    (emitLine cg "b3:")
    (emitLine cg "  %h3 = lshr i64 %cp, 12")
    (emitLine cg "  %h3b = or i64 %h3, 224")
    (emitLine cg "  %h3c = trunc i64 %h3b to i8")
    (emitLine cg "  store i8 %h3c, ptr %p0")
    (emitLine cg "  %m3 = lshr i64 %cp, 6")
    (emitLine cg "  %m3a = and i64 %m3, 63")
    (emitLine cg "  %m3b = or i64 %m3a, 128")
    (emitLine cg "  %m3c = trunc i64 %m3b to i8")
    (emitLine cg "  store i8 %m3c, ptr %p1")
    (emitLine cg "  %l3 = and i64 %cp, 63")
    (emitLine cg "  %l3b = or i64 %l3, 128")
    (emitLine cg "  %l3c = trunc i64 %l3b to i8")
    (emitLine cg "  store i8 %l3c, ptr %p2")
    (emitLine cg "  %o3 = add i64 %o, 3")
    (emitLine cg "  ret i64 %o3")
    (emitLine cg "b4:")
    (emitLine cg "  %h4 = lshr i64 %cp, 18")
    (emitLine cg "  %h4b = or i64 %h4, 240")
    (emitLine cg "  %h4c = trunc i64 %h4b to i8")
    (emitLine cg "  store i8 %h4c, ptr %p0")
    (emitLine cg "  %m4 = lshr i64 %cp, 12")
    (emitLine cg "  %m4a = and i64 %m4, 63")
    (emitLine cg "  %m4b = or i64 %m4a, 128")
    (emitLine cg "  %m4c = trunc i64 %m4b to i8")
    (emitLine cg "  store i8 %m4c, ptr %p1")
    (emitLine cg "  %n4 = lshr i64 %cp, 6")
    (emitLine cg "  %n4a = and i64 %n4, 63")
    (emitLine cg "  %n4b = or i64 %n4a, 128")
    (emitLine cg "  %n4c = trunc i64 %n4b to i8")
    (emitLine cg "  store i8 %n4c, ptr %p2")
    (emitLine cg "  %l4 = and i64 %cp, 63")
    (emitLine cg "  %l4b = or i64 %l4, 128")
    (emitLine cg "  %l4c = trunc i64 %l4b to i8")
    (emitLine cg "  store i8 %l4c, ptr %p3")
    (emitLine cg "  %o4 = add i64 %o, 4")
    (emitLine cg "  ret i64 %o4")
    (emitLine cg "}")
    (emitLine cg "")
    ; `n` UTF-16 units at `src` to NUL-terminated UTF-8 at `dst`;
    ; answers the byte count, NUL excluded. 0xFC00 = 64512, 0xD800 =
    ; 55296, 0xDC00 = 56320, U+FFFD = 65533.
    (emitLine cg "define internal i64 @__axiom_win_narrow(i64 %src, i64 %n, i64 %dst) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %ii = alloca i64")
    (emitLine cg "  %oo = alloca i64")
    (emitLine cg "  store i64 0, ptr %ii")
    (emitLine cg "  store i64 0, ptr %oo")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = load i64, ptr %ii")
    (emitLine cg "  %more = icmp ult i64 %i, %n")
    (emitLine cg "  br i1 %more, label %unit, label %done")
    (emitLine cg "unit:")
    (emitLine cg "  %off = shl i64 %i, 1")
    (emitLine cg "  %ua = add i64 %src, %off")
    (emitLine cg "  %up = inttoptr i64 %ua to ptr")
    (emitLine cg "  %u16 = load i16, ptr %up")
    (emitLine cg "  %c = zext i16 %u16 to i64")
    (emitLine cg "  %i1 = add i64 %i, 1")
    (emitLine cg "  %hi = and i64 %c, 64512")
    (emitLine cg "  %ishigh = icmp eq i64 %hi, 55296")
    (emitLine cg "  br i1 %ishigh, label %pair, label %single")
    (emitLine cg "pair:")
    (emitLine cg "  %have = icmp ult i64 %i1, %n")
    (emitLine cg "  br i1 %have, label %pair2, label %lone")
    (emitLine cg "pair2:")
    (emitLine cg "  %off2 = shl i64 %i1, 1")
    (emitLine cg "  %ua2 = add i64 %src, %off2")
    (emitLine cg "  %up2 = inttoptr i64 %ua2 to ptr")
    (emitLine cg "  %u2 = load i16, ptr %up2")
    (emitLine cg "  %c2 = zext i16 %u2 to i64")
    (emitLine cg "  %lo2 = and i64 %c2, 64512")
    (emitLine cg "  %islow = icmp eq i64 %lo2, 56320")
    (emitLine cg "  br i1 %islow, label %combine, label %lone")
    (emitLine cg "combine:")
    (emitLine cg "  %hpart = sub i64 %c, 55296")
    (emitLine cg "  %hsh = shl i64 %hpart, 10")
    (emitLine cg "  %lpart = sub i64 %c2, 56320")
    (emitLine cg "  %sum = add i64 %hsh, %lpart")
    (emitLine cg "  %cpp = add i64 %sum, 65536")
    (emitLine cg "  %i2 = add i64 %i, 2")
    (emitLine cg "  store i64 %i2, ptr %ii")
    (emitLine cg "  br label %emit")
    (emitLine cg "lone:")
    (emitLine cg "  store i64 %i1, ptr %ii")
    (emitLine cg "  br label %emit")
    (emitLine cg "single:")
    (emitLine cg "  %islone = icmp eq i64 %hi, 56320")
    (emitLine cg "  br i1 %islone, label %lone, label %ok")
    (emitLine cg "ok:")
    (emitLine cg "  store i64 %i1, ptr %ii")
    (emitLine cg "  br label %emit")
    (emitLine cg "emit:")
    (emitLine cg "  %cp = phi i64 [ %cpp, %combine ], [ 65533, %lone ], [ %c, %ok ]")
    (emitLine cg "  %o = load i64, ptr %oo")
    (emitLine cg "  %o2 = call i64 @__axiom_win_put(i64 %cp, i64 %dst, i64 %o)")
    (emitLine cg "  store i64 %o2, ptr %oo")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  %of = load i64, ptr %oo")
    (emitLine cg "  %ea = add i64 %dst, %of")
    (emitLine cg "  %ep = inttoptr i64 %ea to ptr")
    (emitLine cg "  store i8 0, ptr %ep")
    (emitLine cg "  ret i64 %of")
    (emitLine cg "}")
    (emitLine cg "")
    ; The split. `vec` = 0 counts; otherwise each argument is narrowed
    ; into `strs` and its address stored at `vec[i]`. `scratch` holds
    ; the unescaped units of the argument being built, in both modes.
    (emitLine cg
      "define internal i64 @__axiom_win_args(i64 %cmd, i64 %vec, i64 %strs, i64 %scratch) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %ii = alloca i64")
    (emitLine cg "  %kk = alloca i64")
    (emitLine cg "  %qq = alloca i64")
    (emitLine cg "  %nn = alloca i64")
    (emitLine cg "  %cc = alloca i64")
    (emitLine cg "  %bb = alloca i64")
    (emitLine cg "  %ee = alloca i64")
    (emitLine cg "  %rr = alloca i64")
    (emitLine cg "  store i64 0, ptr %ii")
    (emitLine cg "  store i64 0, ptr %kk")
    (emitLine cg "  store i64 0, ptr %qq")
    (emitLine cg "  store i64 0, ptr %nn")
    (emitLine cg "  store i64 0, ptr %cc")
    (emitLine cg "  store i64 0, ptr %bb")
    (emitLine cg "  store i64 0, ptr %ee")
    (emitLine cg "  store i64 0, ptr %rr")
    (emitWinPeek cg "c0")
    (emitLine cg "  %c0z = icmp eq i64 %c0, 0")
    (emitLine cg "  br i1 %c0z, label %alldone, label %p0")
    ; argv[0]: quotes delimit, backslashes never escape.
    (emitLine cg "p0:")
    (emitLine cg "  %c0q = icmp eq i64 %c0, 34")
    (emitLine cg "  br i1 %c0q, label %p0q, label %p0loop")
    (emitLine cg "p0q:")
    (emitWinAdvance cg "a0" "1")
    (emitLine cg "  br label %p0qloop")
    (emitLine cg "p0qloop:")
    (emitWinPeek cg "cq")
    (emitLine cg "  %cqz = icmp eq i64 %cq, 0")
    (emitLine cg "  %cqq = icmp eq i64 %cq, 34")
    (emitLine cg "  %cqs = or i1 %cqz, %cqq")
    (emitLine cg "  br i1 %cqs, label %p0qend, label %p0qtake")
    (emitLine cg "p0qtake:")
    (emitWinPush cg "pq" "%cq")
    (emitWinAdvance cg "a1" "1")
    (emitLine cg "  br label %p0qloop")
    (emitLine cg "p0qend:")
    (emitLine cg "  br i1 %cqq, label %p0skipq, label %p0done")
    (emitLine cg "p0skipq:")
    (emitWinAdvance cg "a2" "1")
    (emitLine cg "  br label %p0done")
    (emitLine cg "p0loop:")
    (emitWinPeek cg "cb")
    (emitLine cg "  %cbz = icmp eq i64 %cb, 0")
    (emitLine cg "  %cbs = icmp eq i64 %cb, 32")
    (emitLine cg "  %cbt = icmp eq i64 %cb, 9")
    (emitLine cg "  %cbw = or i1 %cbs, %cbt")
    (emitLine cg "  %cbe = or i1 %cbz, %cbw")
    (emitLine cg "  br i1 %cbe, label %p0done, label %p0take")
    (emitLine cg "p0take:")
    (emitWinPush cg "pb" "%cb")
    (emitWinAdvance cg "a3" "1")
    (emitLine cg "  br label %p0loop")
    (emitLine cg "p0done:")
    (emitWinFinish cg "f0")
    (emitLine cg "  br label %skipws")
    ; Every later argument.
    (emitLine cg "skipws:")
    (emitWinPeek cg "cw")
    (emitLine cg "  %cws = icmp eq i64 %cw, 32")
    (emitLine cg "  %cwt = icmp eq i64 %cw, 9")
    (emitLine cg "  %cww = or i1 %cws, %cwt")
    (emitLine cg "  br i1 %cww, label %skipws_adv, label %argstart")
    (emitLine cg "skipws_adv:")
    (emitWinAdvance cg "a4" "1")
    (emitLine cg "  br label %skipws")
    (emitLine cg "argstart:")
    (emitLine cg "  %cse = icmp eq i64 %cw, 0")
    (emitLine cg "  br i1 %cse, label %alldone, label %argbegin")
    (emitLine cg "argbegin:")
    (emitLine cg "  store i64 0, ptr %kk")
    (emitLine cg "  store i64 0, ptr %qq")
    (emitLine cg "  br label %argloop")
    (emitLine cg "argloop:")
    (emitWinPeek cg "c")
    (emitLine cg "  %cz = icmp eq i64 %c, 0")
    (emitLine cg "  br i1 %cz, label %argend, label %notend")
    (emitLine cg "notend:")
    (emitLine cg "  %isbs = icmp eq i64 %c, 92")
    (emitLine cg "  br i1 %isbs, label %bsrun, label %notbs")
    ; A run of backslashes: literal unless a quote follows.
    (emitLine cg "bsrun:")
    (emitLine cg "  store i64 0, ptr %bb")
    (emitLine cg "  br label %bsloop")
    (emitLine cg "bsloop:")
    (emitWinPeek cg "cb2")
    (emitLine cg "  %isbs2 = icmp eq i64 %cb2, 92")
    (emitLine cg "  br i1 %isbs2, label %bsmore, label %bsend")
    (emitLine cg "bsmore:")
    (emitLine cg "  %bbv = load i64, ptr %bb")
    (emitLine cg "  %bbv1 = add i64 %bbv, 1")
    (emitLine cg "  store i64 %bbv1, ptr %bb")
    (emitWinAdvance cg "a5" "1")
    (emitLine cg "  br label %bsloop")
    (emitLine cg "bsend:")
    (emitLine cg "  %nb = load i64, ptr %bb")
    (emitLine cg "  %afterq = icmp eq i64 %cb2, 34")
    (emitLine cg "  br i1 %afterq, label %bsq, label %bsplain")
    (emitLine cg "bsplain:")
    (emitLine cg "  store i64 %nb, ptr %ee")
    (emitLine cg "  store i64 0, ptr %rr")
    (emitLine cg "  br label %bsemit")
    (emitLine cg "bsq:")
    (emitLine cg "  %half = lshr i64 %nb, 1")
    (emitLine cg "  store i64 %half, ptr %ee")
    (emitLine cg "  store i64 1, ptr %rr")
    (emitLine cg "  br label %bsemit")
    (emitLine cg "bsemit:")
    (emitLine cg "  %eev = load i64, ptr %ee")
    (emitLine cg "  %eez = icmp eq i64 %eev, 0")
    (emitLine cg "  br i1 %eez, label %bsemitted, label %bsone")
    (emitLine cg "bsone:")
    (emitWinPush cg "pe" "92")
    (emitLine cg "  %eev1 = sub i64 %eev, 1")
    (emitLine cg "  store i64 %eev1, ptr %ee")
    (emitLine cg "  br label %bsemit")
    (emitLine cg "bsemitted:")
    (emitLine cg "  %rrv = load i64, ptr %rr")
    (emitLine cg "  %rrq = icmp eq i64 %rrv, 1")
    (emitLine cg "  br i1 %rrq, label %bsoddtest, label %argloop")
    ; An odd run before a quote escapes it; an even run leaves the
    ; quote to the quote rule below, unconsumed.
    (emitLine cg "bsoddtest:")
    (emitLine cg "  %nb2 = load i64, ptr %bb")
    (emitLine cg "  %odd = and i64 %nb2, 1")
    (emitLine cg "  %isodd = icmp ne i64 %odd, 0")
    (emitLine cg "  br i1 %isodd, label %bsesc, label %argloop")
    (emitLine cg "bsesc:")
    (emitWinPush cg "pq2" "34")
    (emitWinAdvance cg "a6" "1")
    (emitLine cg "  br label %argloop")
    (emitLine cg "notbs:")
    (emitLine cg "  %isq = icmp eq i64 %c, 34")
    (emitLine cg "  br i1 %isq, label %quote, label %notq")
    (emitLine cg "quote:")
    (emitLine cg "  %inq = load i64, ptr %qq")
    (emitLine cg "  %inq1 = icmp ne i64 %inq, 0")
    (emitLine cg "  br i1 %inq1, label %quote_in, label %quote_toggle")
    ; `""` inside quotes is one literal quote, and quoting stays on.
    (emitLine cg "quote_in:")
    (emitLine cg "  %nx_i = load i64, ptr %ii")
    (emitLine cg "  %nx_i1 = add i64 %nx_i, 1")
    (emitLine cg "  %nx_o = shl i64 %nx_i1, 1")
    (emitLine cg "  %nx_a = add i64 %cmd, %nx_o")
    (emitLine cg "  %nx_p = inttoptr i64 %nx_a to ptr")
    (emitLine cg "  %nx_w = load i16, ptr %nx_p")
    (emitLine cg "  %nxt = zext i16 %nx_w to i64")
    (emitLine cg "  %nxtq = icmp eq i64 %nxt, 34")
    (emitLine cg "  br i1 %nxtq, label %quote_lit, label %quote_toggle")
    (emitLine cg "quote_lit:")
    (emitWinPush cg "pl" "34")
    (emitWinAdvance cg "a7" "2")
    (emitLine cg "  br label %argloop")
    (emitLine cg "quote_toggle:")
    (emitLine cg "  %inq2 = load i64, ptr %qq")
    (emitLine cg "  %inq3 = xor i64 %inq2, 1")
    (emitLine cg "  store i64 %inq3, ptr %qq")
    (emitWinAdvance cg "a8" "1")
    (emitLine cg "  br label %argloop")
    (emitLine cg "notq:")
    (emitLine cg "  %isws = icmp eq i64 %c, 32")
    (emitLine cg "  %istab = icmp eq i64 %c, 9")
    (emitLine cg "  %isw = or i1 %isws, %istab")
    (emitLine cg "  %inq4 = load i64, ptr %qq")
    (emitLine cg "  %inq4z = icmp eq i64 %inq4, 0")
    (emitLine cg "  %delim = and i1 %isw, %inq4z")
    (emitLine cg "  br i1 %delim, label %argend, label %take")
    (emitLine cg "take:")
    (emitWinPush cg "pt" "%c")
    (emitWinAdvance cg "a9" "1")
    (emitLine cg "  br label %argloop")
    (emitLine cg "argend:")
    (emitWinFinish cg "f1")
    (emitLine cg "  br label %skipws")
    (emitLine cg "alldone:")
    (emitLine cg "  %argc = load i64, ptr %nn")
    (emitLine cg "  ret i64 %argc")
    (emitLine cg "}")
    (emitLine cg "")
    ; UTF-16 units in an environment block, its final double NUL
    ; included: what sizing the UTF-8 copy needs.
    (emitLine cg "define internal i64 @__axiom_win_blocklen(i64 %blk) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %pp = alloca i64")
    (emitLine cg "  store i64 %blk, ptr %pp")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %p = load i64, ptr %pp")
    (emitLine cg "  %len = call i64 @__axiom_win_wlen(i64 %p)")
    (emitLine cg "  %z = icmp eq i64 %len, 0")
    (emitLine cg "  br i1 %z, label %done, label %next")
    (emitLine cg "next:")
    (emitLine cg "  %len1 = add i64 %len, 1")
    (emitLine cg "  %bytes = shl i64 %len1, 1")
    (emitLine cg "  %p1 = add i64 %p, %bytes")
    (emitLine cg "  store i64 %p1, ptr %pp")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  %d = sub i64 %p, %blk")
    (emitLine cg "  %units = lshr i64 %d, 1")
    (emitLine cg "  %total = add i64 %units, 1")
    (emitLine cg "  ret i64 %total")
    (emitLine cg "}")
    (emitLine cg "")
    ; The environment: `NAME=value` entries to the double NUL, narrowed
    ; into `strs` and recorded at `vec[i]`; `vec` = 0 counts.
    (emitLine cg "define internal i64 @__axiom_win_env(i64 %blk, i64 %vec, i64 %strs) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %pp = alloca i64")
    (emitLine cg "  %nn = alloca i64")
    (emitLine cg "  %cc = alloca i64")
    (emitLine cg "  store i64 %blk, ptr %pp")
    (emitLine cg "  store i64 0, ptr %nn")
    (emitLine cg "  store i64 0, ptr %cc")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %p = load i64, ptr %pp")
    (emitLine cg "  %len = call i64 @__axiom_win_wlen(i64 %p)")
    (emitLine cg "  %z = icmp eq i64 %len, 0")
    (emitLine cg "  br i1 %z, label %done, label %one")
    (emitLine cg "one:")
    (emitLine cg "  %n = load i64, ptr %nn")
    (emitLine cg "  %v0 = icmp eq i64 %vec, 0")
    (emitLine cg "  br i1 %v0, label %skip, label %fill")
    (emitLine cg "fill:")
    (emitLine cg "  %c = load i64, ptr %cc")
    (emitLine cg "  %dst = add i64 %strs, %c")
    (emitLine cg "  %b = call i64 @__axiom_win_narrow(i64 %p, i64 %len, i64 %dst)")
    (emitLine cg "  %vo = shl i64 %n, 3")
    (emitLine cg "  %va = add i64 %vec, %vo")
    (emitLine cg "  %vp = inttoptr i64 %va to ptr")
    (emitLine cg "  store i64 %dst, ptr %vp")
    (emitLine cg "  %b1 = add i64 %b, 1")
    (emitLine cg "  %c1 = add i64 %c, %b1")
    (emitLine cg "  store i64 %c1, ptr %cc")
    (emitLine cg "  br label %skip")
    (emitLine cg "skip:")
    (emitLine cg "  %n1 = add i64 %n, 1")
    (emitLine cg "  store i64 %n1, ptr %nn")
    (emitLine cg "  %len1 = add i64 %len, 1")
    (emitLine cg "  %bytes = shl i64 %len1, 1")
    (emitLine cg "  %p1 = add i64 %p, %bytes")
    (emitLine cg "  store i64 %p1, ptr %pp")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  %count = load i64, ptr %nn")
    (emitLine cg "  ret i64 %count")
    (emitLine cg "}")
    (emitLine cg "")
    ; The entry itself. Sizes: a UTF-16 unit narrows to at most three
    ; bytes, a pair of units to four, and every argument or entry
    ; costs one NUL, so `4 * units + 16` covers the strings, and the
    ; vector is `argc + 1 + envc + 1` words.
    (emitLine cg "define i64 @mainCRTStartup() #0 {")
    (emitLine cg "entry:")
    ; the stack-overflow trap: 64 KiB of this stack kept for the
    ; handler, and the handler installed first (`emitWinFaultRuntime`)
    (emitLine cg "  %gsz = alloca i32, align 4")
    (emitLine cg "  store i32 65536, ptr %gsz")
    (emitLine cg "  %gszi = ptrtoint ptr %gsz to i64")
    (emitLine cg "  %gok = call i64 @SetThreadStackGuarantee(i64 %gszi)")
    (emitLine cg
      "  %veh = call i64 @AddVectoredExceptionHandler(i64 1, i64 ptrtoint (ptr @__axiom_veh to i64))")
    (emitLine cg "  %cmd = call i64 @GetCommandLineW()")
    (emitLine cg "  %clen = call i64 @__axiom_win_wlen(i64 %cmd)")
    (emitLine cg "  %clen1 = add i64 %clen, 1")
    (emitLine cg "  %scrb = shl i64 %clen1, 1")
    (emitLine cg "  %scratch = call i64 @axiom_alloc(i64 %scrb)")
    (emitLine cg "  %argc = call i64 @__axiom_win_args(i64 %cmd, i64 0, i64 0, i64 %scratch)")
    (emitLine cg "  %env = call i64 @GetEnvironmentStringsW()")
    (emitLine cg "  %envc = call i64 @__axiom_win_env(i64 %env, i64 0, i64 0)")
    (emitLine cg "  %n0 = add i64 %argc, %envc")
    (emitLine cg "  %nwords = add i64 %n0, 2")
    (emitLine cg "  %vbytes = shl i64 %nwords, 3")
    (emitLine cg "  %vec = call i64 @axiom_alloc(i64 %vbytes)")
    (emitLine cg "  %sb0 = shl i64 %clen, 2")
    (emitLine cg "  %sbytes = add i64 %sb0, 16")
    (emitLine cg "  %strs = call i64 @axiom_alloc(i64 %sbytes)")
    (emitLine cg
      "  %argc2 = call i64 @__axiom_win_args(i64 %cmd, i64 %vec, i64 %strs, i64 %scratch)")
    (emitLine cg "  %nullo = shl i64 %argc2, 3")
    (emitLine cg "  %nulla = add i64 %vec, %nullo")
    (emitLine cg "  %nullp = inttoptr i64 %nulla to ptr")
    (emitLine cg "  store i64 0, ptr %nullp")
    (emitLine cg "  %envvec = add i64 %nulla, 8")
    (emitLine cg "  %eunits = call i64 @__axiom_win_blocklen(i64 %env)")
    (emitLine cg "  %eb0 = shl i64 %eunits, 2")
    (emitLine cg "  %ebytes = add i64 %eb0, 16")
    (emitLine cg "  %estrs = call i64 @axiom_alloc(i64 %ebytes)")
    (emitLine cg "  %envc2 = call i64 @__axiom_win_env(i64 %env, i64 %envvec, i64 %estrs)")
    (emitLine cg "  %enullo = shl i64 %envc2, 3")
    (emitLine cg "  %enulla = add i64 %envvec, %enullo")
    (emitLine cg "  %enullp = inttoptr i64 %enulla to ptr")
    (emitLine cg "  store i64 0, ptr %enullp")
    (emitLine cg "  store i64 %argc2, ptr @__axiom_argc")
    (emitLine cg "  store i64 %vec, ptr @__axiom_argv")
    (emitLine cg "  %r = call i64 @__axiom_user_main()")
    (if (== (mainReturnsResult cg) 1)
      (emitMainResultTail cg 1)
      {
        (emitLine cg "  call i64 @ExitProcess(i64 %r)")
        (emitLine cg "  unreachable")
      })
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; ------------------------------------------------------------------
; The allocator, emitted rather than linked.
;
; A program stage1 compiles has to stand on its own: `axiom_alloc` is
; what every constructor and every `Str` goes through, and nothing else
; in the output defines it. This is the same `mmap`-backed bump
; allocator the Rust backend emits, parameterized by the target the
; driver named.
; ------------------------------------------------------------------
; ERR-REC-4: `main` answering `(Result Int Error)`.
;
; `main` dispatches Err's exact Result Int Error protocol. Its own
; qualified constructors and renderer decide the tags and error layout.
; A successful payload becomes the process status; an error prints its
; message and exits 70. Aliases have already expanded to those identities.
; A nullary constructor with the exact checked name.
(pub :: isNamedConTy (-> ASTNode String Int))
(pub fn (isNamedConTy ty name)
  (if (nodeSame ty nilNode)
    0
    (if (!= (nodeTag ty) TAG_T_CON)
      0
      (if (strEq (nodeAName ty) name)
        (if (== (vecLen (nodeBChildren ty)) 0)
          1
          0)
        0))))

; The exact signatures this dispatch understands: `(Result Int Error)`
; and `(Result () Error)`. `(Ok ())` carries the unit word 0, so both
; answer their `Ok` payload as the exit status.
(pub :: isResultIntErrorTy (-> ASTNode Int))
(pub fn (isResultIntErrorTy ty)
  (if (nodeSame ty nilNode)
    0
    (if (!= (nodeTag ty) TAG_T_CON)
      0
      (if (strEq (nodeAName ty) "Err$Result")
        {
          (let args (nodeBChildren ty))
          (if (!= (vecLen args) 2)
            0
            (if (== (isMainStatusTy (vecGet args 0)) 0)
              0
              (isNamedConTy (vecGet args 1) "Err$Error")))
        }
        0))))

; What an `Ok` may carry out of `main`: `Int`, or the unit type `()`.
(pub :: isMainStatusTy (-> ASTNode Int))
(pub fn (isMainStatusTy ty)
  (if (== (isNamedConTy ty "Int") 1)
    1
    (if (nodeSame ty nilNode)
      0
      (if (&& (== (nodeTag ty) TAG_T_TUP) (== (vecLen (nodeAChildren ty)) 0))
        1
        0))))

; Err's renderer belongs to the same Error declaration as the result.
(pub :: mainResultErrorText (-> CG String))
(pub fn (mainResultErrorText cg)
  "Err$errorText")

(pub :: mainReturnsResult (-> CG Int))
(pub fn (mainReturnsResult cg)
  (if (let (Some e) (findFSigCg cg "__axiom_user_main"))
    (if (let (Some ty) (fsigTy e))
      (if (== (isResultIntErrorTy ty) 0)
        0
        (if (let (Some ee) (findFSigCg cg (mainResultErrorText cg)))
          (if (let (Some ety) (fsigTy ee))
            (if (!= (nodeTag ety) TAG_T_ARR)
              0
              (if (|| (== (isNamedConTy (nodeAChild ety) "Err$Error") 0)
                    (== (isNamedConTy (nodeBChild ety) "String") 0))
                0
                (if (let (Some okE) (lookupType (cgTypes cg) "Err$Ok"))
                  (if (let (Some errE) (lookupType (cgTypes cg) "Err$Err"))
                    (if (|| (!= (eArity okE) 1) (!= (eArity errE) 1))
                      0
                      1)
                    0)
                  0)))
            0)
          0))
      0)
    0))

; The `@main` tail for a `Result` answer: `%r` holds the cell. `wind`
; selects the `Ok` tail - `ExitProcess` on Windows, `ret` everywhere
; else (the bare-metal `_start` reads `@main`'s answer the same way);
; the `Err` tail is one sentence on fd 2 and status 70 on every
; target, through the trap family's own doors.
(pub :: emitMainResultTail (-> CG Int CG))
;@axiom:effect(io)
(pub fn (emitMainResultTail cg wind)
  (if (let (Some okEntry) (lookupType (cgTypes cg) "Err$Ok"))
    {
      (let okTag (eTag okEntry))
      (let etext (llvmSym (mainResultErrorText cg)))
      {
        (emitLine cg "  %mres_tp = inttoptr i64 %r to ptr")
        (emitLine cg "  %mres_tag = load i64, ptr %mres_tp")
        (emitLine cg (concat "  %mres_isok = icmp eq i64 %mres_tag, " (concat (constStr okTag) "")))
        (emitLine cg "  br i1 %mres_isok, label %.mres_ok, label %.mres_err")
        (emitLine cg ".mres_ok:")
        (emitLine cg "  %mres_outp = inttoptr i64 %r to ptr")
        (emitLine cg "  %mres_outv = getelementptr i64, ptr %mres_outp, i64 1")
        (emitLine cg "  %mres_out = load i64, ptr %mres_outv")
        (if (== wind 1)
          {
            (emitLine cg "  call i64 @ExitProcess(i64 %mres_out)")
            (emitLine cg "  unreachable")
          }
          (emitLine cg "  ret i64 %mres_out"))
        (emitLine cg ".mres_err:")
        (emitLine cg "  %mres_errp = inttoptr i64 %r to ptr")
        (emitLine cg "  %mres_errv = getelementptr i64, ptr %mres_errp, i64 1")
        (emitLine cg "  %mres_errh = load i64, ptr %mres_errv")
        (emitLine cg
          (concat "  %mres_msg = call i64 @" (concat etext (concat "(i64 " "%mres_errh)"))))
        (emitLine cg "  %mres_slp = inttoptr i64 %mres_msg to ptr")
        (emitLine cg "  %mres_sll = getelementptr i64, ptr %mres_slp, i64 0")
        (emitLine cg "  %mres_len = load i64, ptr %mres_sll")
        (emitLine cg "  %mres_sdp = getelementptr i64, ptr %mres_slp, i64 1")
        (emitLine cg "  %mres_dat = load i64, ptr %mres_sdp")
        (emitLine cg "  %mres_pre = ptrtoint ptr @__axiom_result_prefix to i64")
        (emitRuntimeWrite cg "%mres_pre" "7")
        (emitLine cg "  %mres_nlp = ptrtoint ptr @__axiom_result_nl to i64")
        (emitRuntimeWrite cg "%mres_dat" "%mres_len")
        (emitRuntimeWrite cg "%mres_nlp" "1")
        (emitRuntimeExit cg "70")
        (emitLine cg "  unreachable")
        cg
      }
    }
    (cgFail cg "missing result constructor: " "Err$Ok")))

; ------------------------------------------------------------------
(pub :: emitAllocator (-> CG CG))
;@axiom:effect(io)
(pub fn (emitAllocator cg)
  ; The process's arguments, captured by the `@main` wrapper below
  ; before the user's (renamed) main runs; `__argc`/`__argv` read
  ; them back. Matches stage0's convention exactly - the C runtime
  ; calls main(argc, argv), and before the wrapper existed those
  ; two values arrived silently in whatever register the first
  ; parameter happened to occupy.
  {
    (emitLine cg "declare i8 @llvm.fptosi.sat.i8.f64(double)")
    (emitLine cg "declare i8 @llvm.fptoui.sat.i8.f64(double)")
    (emitLine cg "declare i16 @llvm.fptosi.sat.i16.f64(double)")
    (emitLine cg "declare i16 @llvm.fptoui.sat.i16.f64(double)")
    (emitLine cg "declare i32 @llvm.fptosi.sat.i32.f64(double)")
    (emitLine cg "declare i32 @llvm.fptoui.sat.i32.f64(double)")
    (emitLine cg "declare i64 @llvm.fptosi.sat.i64.f64(double)")
    (emitLine cg "declare i64 @llvm.fptoui.sat.i64.f64(double)")
    (emitLine cg "@__axiom_argc = internal global i64 0")
    (emitLine cg "@__axiom_argv = internal global i64 0")
    (emitLine cg "")
    ; A STATIC ARCHIVE (`--emit-staticlib`) has no `main`: the host that
    ; links it has its own, and the module's `pub fn`s are what it
    ; calls. The runtime below is emitted in full - the allocator
    ; initialises on first use, so the host needs no init call.
    ; The kernel32 declares, the no-syscall trap and the DWORD cell the
    ; trap paths' `WriteFile` writes through - whether or not there is a
    ; `main`, because the allocator below and the three traps need them
    ; in an archive too.
    (if (! (== (targetUsesSyscallAsm (cgTarget cg)) 1))
      (if (== (cgTarget cg) 7)
        (emitBaremetalRuntime cg)
        (emitWinRuntime cg)))
    (if (! cgStaticlib)
      (if (strEq (targetEntryName (cgTarget cg)) "main")
        {
          (if (== (mainReturnsResult cg) 1)
            {
              (emitLine cg
                "@__axiom_result_prefix = private unnamed_addr constant [7 x i8] c\"axiom: \"")
              (emitLine cg "@__axiom_result_nl = private unnamed_addr constant [1 x i8] c\"\\0A\"")
              (emitLine cg "")
            })
          (emitLine cg "define i64 @main(i64 %argc, i64 %argv) #0 {")
          (emitLine cg "entry:")
          (emitLine cg "  store i64 %argc, ptr @__axiom_argc")
          (emitLine cg "  store i64 %argv, ptr @__axiom_argv")
          (if (programStackOn cg)
            (emitLine cg "  %r = call i64 @__axiom_program_run()")
            (emitLine cg "  %r = call i64 @__axiom_user_main()"))
          ; MM-PAR-7: a handle the program never joined does not
          ; outlive `main`.
          (if (== (parRegistryOn cg) 1)
            (emitLine cg "  call void @__axiom_par_sweep(i64 -1)"))
          (if (== (mainReturnsResult cg) 1)
            (emitMainResultTail cg 0)
            (emitLine cg "  ret i64 %r"))
          (emitLine cg "}")
          (emitLine cg "")
        }
        (emitWinEntry cg)))
    ; The reset vector beside `@main`, on the bare target only: an
    ; archive must not carry it (`_start` names `main`, and the host
    ; linking the archive answers that name itself).
    (if (! cgStaticlib)
      (if (== (cgTarget cg) 7)
        (emitBaremetalStart cg)))
    ; `isr(...)` bindings: the vector table on the bare target, an
    ; AX4008 marker for a binding a target cannot honour, and nothing
    ; at all for a program with no binding on a hosted target.
    (emitIsrBinding cg)
    ; 4.2's region, before the bump pointer that will point into it.
    ; Nothing is emitted here on a target whose arena comes from the
    ; kernel, which is every supported one.
    (if (> (arenaStaticBytes (cgTarget cg)) 0)
      (emitArenaRegion cg))
    (emitLine cg (concat "@__axiom_bump = " (concat (cgMutGlobal cg) " i64 0")))
    (emitLine cg (concat "@__axiom_bump_end = " (concat (cgMutGlobal cg) " i64 0")))
    ; Every mapped chunk carries a two-word header - its total size and
    ; the chunk mapped before it - so the chunks form a list in
    ; allocation order. `@__axiom_chunk` is its head; a reset walks it
    ; back to the marked chunk and moves what it passes onto
    ; `@__axiom_free`, where the next refill finds it. Without the list
    ; a reset could only restore a waterline, so every chunk mapped
    ; after the mark was stranded: 576 KiB per iteration measured on a
    ; loop whose body crosses a chunk boundary.
    (emitLine cg (concat "@__axiom_chunk = " (concat (cgMutGlobal cg) " i64 0")))
    (emitLine cg (concat "@__axiom_free = " (concat (cgMutGlobal cg) " i64 0")))
    ; How far into the current chunk memory has ever been handed out.
    ; Above it is still the zeroes `mmap` gave us; below it is whatever
    ; the program wrote, and has to be scrubbed before it is handed out
    ; again - see `handout`.
    (emitLine cg (concat "@__axiom_high = " (concat (cgMutGlobal cg) " i64 0")))
    ; Small payload classes keep their boundary/16 indices: every
    ; 16 bytes to 1 KiB, then eight classes per doubling to 64 KiB.
    ; Larger payloads use powers of two, 2^17 through 2^62, in slots
    ; 4097..4142. Their extra two-word prefix stores capacity and class;
    ; count/shape remain immediately below the user pointer. The
    ; otherwise unused word count 1 identifies that prefix, because
    ; ordinary allocations always contain an even number of words.
    ; Both class families use the same pop, scrub and reset paths.
    ;
    ; SLOT 0 IS NO CLASS, and it holds MM-ALLOC-24's count: the bytes,
    ; headers included, of every block filed on the heads above -
    ; storage the next allocation of its class reuses and nothing else
    ; can. A filing adds, a pop subtracts, and a reset zeroes it with
    ; the same scrub that empties the lists it counts, so the two can
    ; never disagree across a reset. It exists to be READ
    ; (`__axiom_mem_stat 1`): a reset-free service has no other way to
    ; tell reusable storage from storage its live values, or its
    ; unreachable cycles, hold. Living in the array rather than a
    ; global of its own keeps the runtime's mutable globals at the
    ; set `scripts/check-thread-local.sh` enumerates, and under
    ; `--threads` it is per thread exactly as the lists are. No class
    ; can index it: a request of one byte is class 1, and release
    ; refuses a count of zero before it computes one. The bump path
    ; never touches it.
    (emitLine cg
      (concat "@__axiom_slabs = " (concat (cgMutGlobal cg) " [4143 x i64] zeroinitializer")))
    (emitLine cg "")
    (if (reserveSupported cg)
      {
        (emitLine cg (concat "@__axiom_reserved = " (concat (cgMutGlobal cg) " i64 0")))
        (if (== (resRegistryOn cg) 0)
          (emitLine cg (concat "@__axiom_reserve_seq = " (concat (cgMutGlobal cg) " i64 0"))))
      })
    (emitLine cg "define i64 @axiom_alloc(i64 %size) #0 {")
    (emitLine cg "entry:")
    ; A zero-byte request keeps its MM-ALLOC-8b behavior exactly: the
    ; unadvanced bump, no chunk mapped, no header written - a 0-byte
    ; block is not a counted block, and 160-arena's waterline probe
    ; spends that rule.
    (emitLine cg "  %iszero = icmp eq i64 %size, 0")
    (emitLine cg "  br i1 %iszero, label %zero, label %sized")
    (emitLine cg "zero:")
    (emitLine cg "  %zb = load i64, ptr @__axiom_bump")
    (emitLine cg "  ret i64 %zb")
    ; MM-ALLOC-7a: a request no address space can hold is out of
    ; memory, and it is decided HERE, before the size is rounded or
    ; added to anything. Until 2026-09-27 a negative size reached the
    ; arithmetic below: `%sz0` came out negative, the unsigned
    ; small-block test sent it to the bump path, `%next` landed BELOW
    ; `%cur`, and `%fits` passed - so the bump pointer moved backwards
    ; and the next block's header was written over live data (measured:
    ; `(memAlloc -32)` then `(memAlloc 64)` rewrote words 6 and 7 of
    ; the block allocated before them). A size within 15 of 2^63 did
    ; the same through `%padded` wrapping. One unsigned compare against
    ; 2^62 refuses both - every negative Int is above it unsigned - and
    ; routes them to the same trap an `mmap` refusal takes, status 70,
    ; which recovers like any other (`tests/stdlib/520-alloc-size.ax`).
    (emitLine cg "sized:")
    (emitLine cg "  %toobig = icmp ugt i64 %size, 4611686018427387904")
    (emitLine cg "  br i1 %toobig, label %oomsize, label %sizeok")
    (emitLine cg "sizeok:")
    (emitLine cg "  %padded = add i64 %size, 15")
    (emitLine cg "  %sz0e = and i64 %padded, -16")
    ; MM-ALLOC-25: THE SIZE CLASSES. Every 16 bytes up to 1 KiB, then
    ; eight per doubling up to 64 KiB, and a request in that upper band
    ; is rounded UP to its class, so every block is born on the boundary
    ; its release files it at and a freed block serves every request of
    ; its class. Until this rule the classes were exact 16-byte steps
    ; all the way to 64 KiB - 4,096 of them - and a block served only
    ; its own size. A reset-free loop holding 1,000 strings of uniformly
    ; random length up to 60,000 bytes (about 30 MB live) peaked at
    ; 397 MB after a million iterations and 494 MB after ten million,
    ; still climbing: each class kept the most blocks it had ever held.
    ; With these classes it holds 52 MB and 55 MB
    ; (`scripts/check-reclaim.sh` section 4). The rounding costs at most
    ; one eighth of a block between 1 and 64 KiB, and nothing at or
    ; below 1 KiB, where every constructor, closure and header lives.
    ;
    ; The step is 2^(floor(log2(sz0 - 1)) - 3), so a size already on a
    ; boundary stays where it is. The logarithm is five compares rather
    ; than `llvm.ctlz`: an intrinsic is a `declare` in the module, and
    ; a Windows build holds every declaration to a reviewed
    ; list (`scripts/check-freestanding.sh`). A request at or below
    ; 1 KiB takes one subtraction and one branch more than it did.
    (emitLine cg "  %rcoff = sub i64 %sz0e, 1025")
    (emitLine cg "  %rcbig = icmp ult i64 %rcoff, 64512")
    (emitLine cg "  br i1 %rcbig, label %rclass, label %rcdone")
    (emitLine cg "rclass:")
    (emitLine cg "  %rcm1 = sub i64 %sz0e, 1")
    (emitLog2Steps cg "rc" "%rcm1" 5)
    (emitLine cg "  %rcsh = add i64 %rcn5, 7")
    (emitLine cg "  %rcstep = shl i64 1, %rcsh")
    (emitLine cg "  %rcstm1 = sub i64 %rcstep, 1")
    (emitLine cg "  %rcup = add i64 %sz0e, %rcstm1")
    (emitLine cg "  %rcneg = sub i64 0, %rcstep")
    (emitLine cg "  %rcceil = and i64 %rcup, %rcneg")
    (emitLine cg "  br label %rcdone")
    (emitLine cg "rcdone:")
    (emitLine cg "  %smallsize = phi i64 [ %sz0e, %sizeok ], [ %rcceil, %rclass ]")
    (emitLine cg "  %smallcls = lshr i64 %smallsize, 4")
    (emitLine cg "  %large = icmp ugt i64 %smallsize, 65536")
    (emitLine cg "  br i1 %large, label %largeclass, label %classready")
    (emitLine cg "largeclass:")
    (emitLine cg "  %lm0 = sub i64 %smallsize, 1")
    (emitLine cg "  %lc1 = icmp uge i64 %lm0, 4294967296")
    (emitLine cg "  %ls1 = lshr i64 %lm0, 32")
    (emitLine cg "  %lm1 = select i1 %lc1, i64 %ls1, i64 %lm0")
    (emitLine cg "  %la1 = select i1 %lc1, i64 32, i64 0")
    (emitLine cg "  %ln1 = add i64 0, %la1")
    (emitLine cg "  %lc2 = icmp uge i64 %lm1, 65536")
    (emitLine cg "  %ls2 = lshr i64 %lm1, 16")
    (emitLine cg "  %lm2 = select i1 %lc2, i64 %ls2, i64 %lm1")
    (emitLine cg "  %la2 = select i1 %lc2, i64 16, i64 0")
    (emitLine cg "  %ln2 = add i64 %ln1, %la2")
    (emitLine cg "  %lc3 = icmp uge i64 %lm2, 256")
    (emitLine cg "  %ls3 = lshr i64 %lm2, 8")
    (emitLine cg "  %lm3 = select i1 %lc3, i64 %ls3, i64 %lm2")
    (emitLine cg "  %la3 = select i1 %lc3, i64 8, i64 0")
    (emitLine cg "  %ln3 = add i64 %ln2, %la3")
    (emitLine cg "  %lc4 = icmp uge i64 %lm3, 16")
    (emitLine cg "  %ls4 = lshr i64 %lm3, 4")
    (emitLine cg "  %lm4 = select i1 %lc4, i64 %ls4, i64 %lm3")
    (emitLine cg "  %la4 = select i1 %lc4, i64 4, i64 0")
    (emitLine cg "  %ln4 = add i64 %ln3, %la4")
    (emitLine cg "  %lc5 = icmp uge i64 %lm4, 4")
    (emitLine cg "  %ls5 = lshr i64 %lm4, 2")
    (emitLine cg "  %lm5 = select i1 %lc5, i64 %ls5, i64 %lm4")
    (emitLine cg "  %la5 = select i1 %lc5, i64 2, i64 0")
    (emitLine cg "  %ln5 = add i64 %ln4, %la5")
    (emitLine cg "  %lc6 = icmp uge i64 %lm5, 2")
    (emitLine cg "  %ls6 = lshr i64 %lm5, 1")
    (emitLine cg "  %lm6 = select i1 %lc6, i64 %ls6, i64 %lm5")
    (emitLine cg "  %la6 = select i1 %lc6, i64 1, i64 0")
    (emitLine cg "  %ln6 = add i64 %ln5, %la6")
    (emitLine cg "  %lpower = add i64 %ln6, 1")
    (emitLine cg "  %lcap = shl i64 1, %lpower")
    (emitLine cg "  %lcls = add i64 %lpower, 4080")
    (emitLine cg "  br label %classready")
    (emitLine cg "classready:")
    (emitLine cg "  %sz0 = phi i64 [ %smallsize, %rcdone ], [ %lcap, %largeclass ]")
    (emitLine cg "  %cls = phi i64 [ %smallcls, %rcdone ], [ %lcls, %largeclass ]")
    (emitLine cg "  %overhead = select i1 %large, i64 32, i64 16")
    (emitLine cg "  %sz = add i64 %sz0, %overhead")
    ; The pop path re-enters `handout` like any other landing: the
    ; recycled block sits below the high-water mark, so the existing
    ; scrub wipes its old contents - link word included - and
    ; `wiped` rewrites the header. Zeroing (MM-ALLOC-6) is the same
    ; promise on the same path.
    (if (reserveSupported cg)
      {
        ; Bound before multiplying: requests above 128 GiB retain the
        ; ordinary refusal path, without reservation arithmetic overflow.
        (emitLine cg "  %resmin = icmp uge i64 %sz0, 1048576")
        (emitLine cg "  %resmax = icmp ule i64 %sz0, 137438953472")
        (emitLine cg "  %resok = and i1 %resmin, %resmax")
        (emitLine cg "  br i1 %resok, label %reserve, label %try_pop")
        (emitReserveBlock cg)
      }
      (emitLine cg "  br label %try_pop"))
    (emitLine cg "try_pop:")
    (emitLine cg "  %slotp = getelementptr [4143 x i64], ptr @__axiom_slabs, i64 0, i64 %cls")
    (emitLine cg "  %shead = load i64, ptr %slotp")
    (emitLine cg "  %sempty = icmp eq i64 %shead, 0")
    (emitLine cg "  br i1 %sempty, label %bump_path, label %pop")
    (emitLine cg "pop:")
    (emitLine cg "  %pnextp = inttoptr i64 %shead to ptr")
    (emitLine cg "  %pnextenc = load i64, ptr %pnextp")
    (emitLine cg "  %pnext = sub i64 -2, %pnextenc")
    (emitLine cg "  store i64 %pnext, ptr %slotp")
    (emitLine cg "  br i1 %large, label %poplarge, label %popsmall")
    (emitLine cg "poplarge:")
    (emitLine cg "  %plbase = add i64 %shead, -16")
    (emitLine cg "  %plbasep = inttoptr i64 %plbase to ptr")
    (emitLine cg "  %plcap = load i64, ptr %plbasep")
    (emitLine cg "  br label %popready")
    (emitLine cg "popsmall:")
    ; The popped block is handed out at ITS OWN size, read from the
    ; shape word its filing left intact, not at the request's: a block
    ; files at the largest class not above its size (`axiom_release`),
    ; so one that was not born on a boundary - `reset_keeping`'s copy
    ; is stamped at its exact size - is bigger than its class, and the
    ; header written in `wiped` must say how big, or its next release
    ; would file it a class too low and lose the difference for good.
    (emitLine cg "  %pshq = add i64 %shead, 8")
    (emitLine cg "  %pshqp = inttoptr i64 %pshq to ptr")
    (emitLine cg "  %pshw = load i64, ptr %pshqp")
    (emitLine cg "  %pwc0 = lshr i64 %pshw, 1")
    (emitLine cg "  %pwc = and i64 %pwc0, 16383")
    (emitLine cg "  %pscap = shl i64 %pwc, 3")
    (emitLine cg "  br label %popready")
    (emitLine cg "popready:")
    (emitLine cg "  %psz0 = phi i64 [ %plcap, %poplarge ], [ %pscap, %popsmall ]")
    (emitLine cg "  %phb = phi i64 [ %plbase, %poplarge ], [ %shead, %popsmall ]")
    (emitLine cg "  %psz = add i64 %psz0, %overhead")
    (emitLine cg "  %pe = add i64 %phb, %psz")
    (emitLine cg "  %pf0 = load i64, ptr @__axiom_slabs")
    (emitLine cg "  %pf1 = sub i64 %pf0, %psz")
    (emitLine cg "  store i64 %pf1, ptr @__axiom_slabs")
    (emitLine cg "  %ph = load i64, ptr @__axiom_high")
    (emitLine cg "  br label %handout")
    (emitLine cg "bump_path:")
    (emitLine cg "  %cur = load i64, ptr @__axiom_bump")
    (emitLine cg "  %next = add i64 %cur, %sz")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %fits = icmp ule i64 %next, %end")
    (emitLine cg "  br i1 %fits, label %fast, label %refill")
    (emitLine cg "fast:")
    (emitLine cg "  store i64 %next, ptr @__axiom_bump")
    (emitLine cg "  %high = load i64, ptr @__axiom_high")
    (emitLine cg "  br label %handout")
    (emitLine cg "refill:")
    (emitLine cg "  %need = add i64 %sz, 16")
    ; 4.1. Four literals, one target constant and its grain. Every
    ; supported target answers 1 MiB and 64 KiB, so these four lines
    ; are byte for byte what they were. The two chunk lines read the
    ; EFFECTIVE chunk: under `--heap-ceiling` it is capped by the
    ; region, so the growth unit always fits what it grows in.
    (emitLine cg
      (concat "  %big = icmp ugt i64 %need, " (concat (fmtInt (arenaChunkBytes (cgTarget cg))) "")))
    (emitLine cg
      (concat "  %rounded0 = add i64 %need, "
        (concat (fmtInt (- (targetArenaGrainBytes (cgTarget cg)) 1)) "")))
    (emitLine cg
      (concat "  %rounded = and i64 %rounded0, "
        (concat (fmtInt (- 0 (targetArenaGrainBytes (cgTarget cg)))) "")))
    (emitLine cg
      (concat "  %chunk = select i1 %big, i64 %rounded, i64 "
        (concat (fmtInt (arenaChunkBytes (cgTarget cg))) "")))
    ; First fit over the chunks a reset has freed. The list is short -
    ; it holds only what outlived a mark - and a chunk on it is a whole
    ; mapping, so reuse is what keeps a resetting loop's RSS flat
    ; rather than merely its waterline.
    (emitLine cg "  %fhead = load i64, ptr @__axiom_free")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg "  %cand = phi i64 [ %fhead, %refill ], [ %cnext, %scan_next ]")
    (emitLine cg "  %prev = phi i64 [ 0, %refill ], [ %cand, %scan_next ]")
    (emitLine cg "  %exhausted = icmp eq i64 %cand, 0")
    (emitLine cg "  br i1 %exhausted, label %map, label %scan_test")
    (emitLine cg "scan_test:")
    (emitLine cg "  %candp = inttoptr i64 %cand to ptr")
    (emitLine cg "  %candsz = load i64, ptr %candp")
    (emitLine cg "  %candlink = add i64 %cand, 8")
    (emitLine cg "  %candlinkp = inttoptr i64 %candlink to ptr")
    (emitLine cg "  %cnext = load i64, ptr %candlinkp")
    (emitLine cg "  %roomy = icmp uge i64 %candsz, %chunk")
    (emitLine cg "  br i1 %roomy, label %unlink, label %scan_next")
    (emitLine cg "scan_next:")
    (emitLine cg "  br label %scan")
    (emitLine cg "unlink:")
    (emitLine cg "  %cand_end = add i64 %cand, %candsz")
    (emitLine cg "  %at_head = icmp eq i64 %prev, 0")
    (emitLine cg "  br i1 %at_head, label %unlink_head, label %unlink_mid")
    (emitLine cg "unlink_head:")
    (emitLine cg "  store i64 %cnext, ptr @__axiom_free")
    (emitLine cg "  br label %install")
    (emitLine cg "unlink_mid:")
    (emitLine cg "  %prevlink = add i64 %prev, 8")
    (emitLine cg "  %prevlinkp = inttoptr i64 %prevlink to ptr")
    (emitLine cg "  store i64 %cnext, ptr %prevlinkp")
    (emitLine cg "  br label %install")
    (emitLine cg "map:")
    (emitArenaCapCheck cg "%chunk")
    (emitRuntimeMap cg "%chunk")
    (emitLine cg "  %failed_low = icmp ult i64 %addr, 4096")
    (emitLine cg "  %failed_neg = icmp ugt i64 %addr, -4096")
    (emitLine cg "  %failed = or i1 %failed_low, %failed_neg")
    (emitLine cg "  br i1 %failed, label %oom, label %mapped")
    (emitLine cg "mapped:")
    (emitLine cg "  %virgin_high = add i64 %addr, 16")
    (emitLine cg "  br label %install")
    ; Link the chunk - mapped or recycled - onto the active list and
    ; allocate out of it. The header sits at the base, so the address
    ; handed back is base + 16. `%chunk_high` is the chunk's high water
    ; BEFORE this request: a recycled chunk is dirty to its last byte,
    ; a fresh mapping is the kernel's zeroes all the way down.
    (emitLine cg "install:")
    (emitLine cg
      "  %base = phi i64 [ %addr, %mapped ], [ %cand, %unlink_head ], [ %cand, %unlink_mid ]")
    (emitLine cg
      "  %bsize = phi i64 [ %chunk, %mapped ], [ %candsz, %unlink_head ], [ %candsz, %unlink_mid ]")
    (emitLine cg
      "  %chunk_high = phi i64 [ %virgin_high, %mapped ], [ %cand_end, %unlink_head ], [ %cand_end, %unlink_mid ]")
    (emitLine cg "  %basep = inttoptr i64 %base to ptr")
    (emitLine cg "  store i64 %bsize, ptr %basep")
    (emitLine cg "  %baselink = add i64 %base, 8")
    (emitLine cg "  %baselinkp = inttoptr i64 %baselink to ptr")
    (emitLine cg "  %chead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  store i64 %chead, ptr %baselinkp")
    (emitLine cg "  store i64 %base, ptr @__axiom_chunk")
    (emitLine cg "  %data = add i64 %base, 16")
    (emitLine cg "  %new_bump = add i64 %data, %sz")
    (emitLine cg "  store i64 %new_bump, ptr @__axiom_bump")
    (emitLine cg "  %new_end = add i64 %base, %bsize")
    (emitLine cg "  store i64 %new_end, ptr @__axiom_bump_end")
    (emitLine cg "  br label %handout")
    ; Both paths converge here to hand out `[%hb, %he)`. Memory below
    ; the high-water mark has been handed out before, so it holds
    ; whatever the program last wrote and has to be scrubbed:
    ; `memAlloc` promises ZEROED memory and the standard library spends
    ; that promise - `Map` and `Intern` read an all-zero state array as
    ; "every slot empty", `strAlloc` reserves a byte for its NUL
    ; terminator and never writes one. A fresh mapping arrives zeroed
    ; from the kernel, so the promise used to hold for free and
    ; silently stopped the moment a reset handed the same bytes out
    ; twice: `strAlloc 3` after a reset measured a `cstrLen` of 17.
    ;
    ; Scrubbing HERE rather than in the reset is what lets §4.1's
    ; copy-at-boundary work: the value being copied down sits above the
    ; restored waterline, in memory the reset gave back, and must
    ; survive being read until the copy finishes.
    ; A RECYCLED block is dirty to its last byte and belongs to
    ; whichever chunk it was allocated from, so neither of the
    ; watermark's two jobs applies to it.
    ;
    ; `@__axiom_high` describes the CURRENT chunk - `install` resets it
    ; to the new chunk's base and a reset rewinds it - while a block on
    ; a size-class free list may have come from any chunk the program
    ; has ever mapped. Comparing the two is comparing addresses from
    ; different mappings, and mmap does not promise they ascend. Where
    ; the popped block sits above the current chunk's watermark, the
    ; old `%stop` came out BELOW `%hb`, the wipe loop ran zero times,
    ; and the block was handed back with its previous contents -
    ; against MM-ALLOC-6, which `strAlloc` (never writes its NUL) and
    ; `Map`/`Intern` (read all-zero as "empty") both spend. The same
    ; comparison then stored a foreign address into the watermark.
    ;
    ; So the pop path scrubs the whole block and leaves the watermark
    ; alone. It costs nothing in the cases that were already right: for
    ; a popped block below the watermark `%bstop` was `%he` already.
    ; This is a pre-existing hazard - the pop path has always compared
    ; these two - which raising the pool ceiling to 64 KiB widened from
    ; blocks under 1 KiB to blocks under 64 KiB.
    (emitLine cg "handout:")
    (emitLine cg "  %hb = phi i64 [ %cur, %fast ], [ %data, %install ], [ %phb, %popready ]")
    (emitLine cg "  %he = phi i64 [ %next, %fast ], [ %new_bump, %install ], [ %pe, %popready ]")
    (emitLine cg "  %hh = phi i64 [ %high, %fast ], [ %chunk_high, %install ], [ %ph, %popready ]")
    (emitLine cg "  %recyc = phi i1 [ false, %fast ], [ false, %install ], [ true, %popready ]")
    (emitLine cg "  %hsz0 = phi i64 [ %sz0, %fast ], [ %sz0, %install ], [ %psz0, %popready ]")
    (emitLine cg "  %past = icmp ugt i64 %he, %hh")
    (emitLine cg "  %bstop = select i1 %past, i64 %hh, i64 %he")
    (emitLine cg "  %stop = select i1 %recyc, i64 %he, i64 %bstop")
    (emitLine cg "  %nh = select i1 %past, i64 %he, i64 %hh")
    (emitLine cg "  %newhigh = select i1 %recyc, i64 %hh, i64 %nh")
    (emitLine cg "  store i64 %newhigh, ptr @__axiom_high")
    (emitLine cg "  br label %wipe")
    (emitLine cg "wipe:")
    (emitLine cg "  %wi = phi i64 [ %hb, %handout ], [ %wnext, %wipe_body ]")
    (emitLine cg "  %wmore = icmp ult i64 %wi, %stop")
    (emitLine cg "  br i1 %wmore, label %wipe_body, label %wiped")
    (emitLine cg "wipe_body:")
    (emitLine cg "  %wp = inttoptr i64 %wi to ptr")
    (emitLine cg "  store i64 0, ptr %wp")
    (emitLine cg "  %wnext = add i64 %wi, 8")
    (emitLine cg "  br label %wipe")
    (emitLine cg "wiped:")
    ; The count word, explicitly zero, and the LEAF shape:
    ; MM-LIFE-2b says a block that does not record its own size makes
    ; the release path unimplementable, and only the allocator knows
    ; the size of a raw allocation. MM-LIFE-2d's encoding: bit 0 the
    ; form (0 = record), bits 1..14 the padded payload WORD count,
    ; bit 15 the ARRAY FORM, bits 16..62 the reference bitmap - which
    ; the allocator leaves EMPTY, because it cannot know a field from
    ; an int. memAlloc'd memory is therefore a leaf by construction,
    ; the unsafe layer's own rule; monomorphic construction sites
    ; overwrite the word with their record shape, and a container
    ; stamps its element buffer with the array form through
    ; `Mem.memMarkArray`, which writes its LENGTH into bits 16..62.
    ;
    ; Large blocks carry count 1 as a capacity-prefix sentinel; a
    ; small block's padded count is always even. Record maps and array
    ; lengths keep all 47 upper bits regardless of the block's size.
    (emitLine cg "  br i1 %large, label %prefix, label %header")
    (emitLine cg "prefix:")
    (emitLine cg "  %capp = inttoptr i64 %hb to ptr")
    (emitLine cg "  store i64 %hsz0, ptr %capp")
    (emitLine cg "  %claddr = add i64 %hb, 8")
    (emitLine cg "  %clp = inttoptr i64 %claddr to ptr")
    (emitLine cg "  store i64 %cls, ptr %clp")
    (emitLine cg "  %lhb = add i64 %hb, 16")
    (emitLine cg "  br label %header")
    (emitLine cg "header:")
    (emitLine cg "  %chb = phi i64 [ %hb, %wiped ], [ %lhb, %prefix ]")
    (emitLine cg "  %cwp = inttoptr i64 %chb to ptr")
    (emitLine cg "  store i64 0, ptr %cwp")
    (emitLine cg "  %shpw = add i64 %chb, 8")
    (emitLine cg "  %shpwp = inttoptr i64 %shpw to ptr")
    (emitLine cg "  %wcnt = lshr i64 %hsz0, 3")
    (emitLine cg "  %wleaf = select i1 %large, i64 1, i64 %wcnt")
    (emitLine cg "  %wshp = shl i64 %wleaf, 1")
    (emitLine cg "  store i64 %wshp, ptr %shpwp")
    (emitLine cg "  %user = add i64 %chb, 16")
    (emitLine cg "  ret i64 %user")
    (emitLine cg "oom:")
    (emitLine cg "  call i64 @__axiom_out_of_memory()")
    (emitLine cg "  unreachable")
    (emitLine cg "oomsize:")
    (emitLine cg "  call i64 @__axiom_out_of_memory_size()")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    ; MM-LIFE-2b's other two owners of the header. Emitted, exempted,
    ; and - in this slice - called only by the `__retain`/`__release`
    ; primitives a fixture spends; the ownership events of MM-LIFE-2c
    ; are what will make the compiler call them. Three exemptions,
    ; each by a test that already exists: an immediate is skipped with
    ; the SAME signed compare a mixed-representation match emits
    ; (MM-VAL-9's `icmp slt`), a static's all-ones count is read and
    ; never written, and a count of zero is never decremented -
    ; 0 - 1 IS the statics sentinel, so an unbalanced release must
    ; not be able to forge one (the double-release stays a no-op the
    ; fixture can observe, instead of an immortal block it cannot).
    ;
    ; EVERY NEGATIVE COUNT IS LEFT ALONE, NOT ONLY -1 (2026-09-27). A
    ; block that dies has its count word reused as a LINK - the dead
    ; list below while its children are walked, then its size class's
    ; free list - and until this date the link was stored raw. A raw
    ; link is an address, so a second release of a filed block (an
    ; imbalance anywhere: a compiler bug, an unsafe store, a race under
    ; `--threads`) read the address as a count, decremented it, and
    ; left the free list pointing one byte into somebody else's memory;
    ; the next allocation of that class handed it out. The link is now
    ; stored ENCODED as `-2 - link` (MM-LIFE-2k): every filed or dead
    ; block reads as a count of at most -2, both owners skip any
    ; negative count, and a stray retain or release of a dead block
    ; touches nothing. Decoding is the same subtraction, so the pop in
    ; `axiom_alloc`, the dead-list drain and the two filing stores are
    ; the only sites that know (`tests/stdlib/521-release-filed.ax`).
    (emitLine cg "define void @axiom_retain(i64 %h) #1 {")
    (emitLine cg "entry:")
    (emitLine cg "  %imm = icmp slt i64 %h, 4096")
    (emitLine cg "  br i1 %imm, label %done, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %hoff = add i64 %h, -16")
    (emitLine cg "  %cp = inttoptr i64 %hoff to ptr")
    (emitLine cg "  %c = load i64, ptr %cp")
    (emitLine cg "  %stat = icmp slt i64 %c, 0")
    (emitLine cg "  br i1 %stat, label %done, label %bump")
    (emitLine cg "bump:")
    ; The next count must remain nonnegative: negative words belong
    ; to statics and encoded dead-list links (MM-LIFE-2k). Refuse
    ; exhaustion before changing the header, including under recovery.
    (emitLine cg "  %full = icmp eq i64 %c, 9223372036854775807")
    (emitLine cg "  br i1 %full, label %overflow, label %increment")
    (emitLine cg "overflow:")
    (emitLine cg "  call i64 @__axiom_refcount_exhausted()")
    (emitLine cg "  unreachable")
    (emitLine cg "increment:")
    (emitLine cg "  %c1 = add i64 %c, 1")
    (emitLine cg "  store i64 %c1, ptr %cp")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; MM-LIFE-2e + 2d: the release path. A handle below 4096 is an
    ; immediate, a count of -1 a static, a count of -2 or below a dead
    ; block whose count word holds an encoded link (MM-LIFE-2k), a
    ; count of 0 a free-floating block nobody adopted: each is left
    ; alone. Otherwise the count
    ; drops, and at zero the block is dead. A dead RECORD with no
    ; reference map files at once; one of the FOREIGN FORM (form bit 1,
    ; MM-FFI-6) runs its destructor first; a dead RECORD with a map is
    ; DEFERRED: its count word - dead storage from here on, and the
    ; free-list link once it files, both stored as `-2 - link` - links
    ; it into a dead list this
    ; invocation keeps in a local, and nothing else is stored
    ; anywhere. The drain pops a dead record, walks its map releasing
    ; each payload reference through the same `relone` path (a child
    ; that dies joins the dead list, it is never recursed into), then
    ; files the record at the largest class boundary not above its
    ; count * 8 bytes (`emitFloorClass`, MM-ALLOC-25), and a count of
    ; zero (a pre-encoding block, or a payload too large for the field)
    ; or above 8192 (past the 64 KiB pool ceiling) is skipped rather
    ; than misfiled.
    ;
    ; No recursion and no auxiliary stack, so the depth and the
    ; breadth of what dies never matter: the recursive walk took the
    ; process down the first time events 2/3 freed a 400,000-cell
    ; list whole (`tests/selfhost/700-tco.ax`); deferring the LAST
    ; field did the same for a list whose link is not its last field;
    ; and a 4,096-entry worklist with a recursive fallback did the
    ; same for `(Cons String L)` - every level left its string pending
    ; until the chain ended, and 170,000 levels filled the worklist
    ; and then the machine stack. The dead list costs one word the
    ; block already owns.
    (emitLargeFile cg)
    (emitResourceRuntime cg)
    (emitLine cg "define void @axiom_release_full(i64 %h0) #0 {")
    (emitLine cg "start:")
    (emitLine cg "  %dead = alloca i64")
    (emitLine cg "  %cur = alloca i64")
    (emitLine cg "  %D = alloca i64")
    (emitLine cg "  %wi = alloca i64")
    (emitLine cg "  %wm = alloca i64")
    (emitLine cg "  %warr = alloca i64")
    (emitLine cg "  store i64 0, ptr %dead")
    (emitLine cg "  store i64 0, ptr %warr")
    (emitLine cg "  store i64 0, ptr %D")
    (emitLine cg "  store i64 %h0, ptr %cur")
    (emitLine cg "  br label %relone")
    (emitLine cg "relone:")
    (emitLine cg "  %h = load i64, ptr %cur")
    (emitLine cg "  %imm = icmp slt i64 %h, 4096")
    (emitLine cg "  br i1 %imm, label %after, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %hoff = add i64 %h, -16")
    (emitLine cg "  %cp = inttoptr i64 %hoff to ptr")
    (emitLine cg "  %c = load i64, ptr %cp")
    (emitLine cg "  %stat = icmp slt i64 %c, 0")
    (emitLine cg "  br i1 %stat, label %after, label %live")
    (emitLine cg "live:")
    (emitLine cg "  %zero = icmp eq i64 %c, 0")
    (emitLine cg "  br i1 %zero, label %after, label %dec")
    (emitLine cg "dec:")
    (emitLine cg "  %c1 = add i64 %c, -1")
    (emitLine cg "  store i64 %c1, ptr %cp")
    (emitLine cg "  %isdead = icmp eq i64 %c1, 0")
    (emitLine cg "  br i1 %isdead, label %dead0, label %after")
    (emitLine cg "dead0:")
    (emitLine cg "  %shq = add i64 %h, -8")
    (emitLine cg "  %shqp = inttoptr i64 %shq to ptr")
    (emitLine cg "  %shw = load i64, ptr %shqp")
    (emitLine cg "  %formb = and i64 %shw, 1")
    (emitLine cg "  %isrec = icmp eq i64 %formb, 0")
    (emitLine cg "  %map0 = lshr i64 %shw, 16")
    (emitLine cg "  %hasmap = icmp ne i64 %map0, 0")
    (emitLine cg "  %aform = and i64 %shw, 32768")
    (emitLine cg "  %isarr = icmp ne i64 %aform, 0")
    (emitLine cg "  %needw = or i1 %hasmap, %isarr")
    (emitLine cg "  %dowalk = and i1 %isrec, %needw")
    (emitLine cg "  br i1 %dowalk, label %defer, label %notrec")
    ; the FOREIGN FORM (form bit 1, stdlib/Ffi.ax): payload word 0 is
    ; the address of a C destructor `i64 (i64)`, word 1 the Rust value
    ; it takes. A dead handle runs the destructor once - the pointer is
    ; zeroed by an explicit `ffiHandleClose` so a closed handle's death
    ; calls nothing - and then files like any block. The call may
    ; re-enter `@axiom_release` (a Rust `Drop` giving back Axiom
    ; values it retained): every invocation's dead list is its own
    (emitLine cg "notrec:")
    (emitLine cg "  br i1 %isrec, label %filev, label %foreign")
    (emitLine cg "foreign:")
    (emitLine cg "  %fdp = inttoptr i64 %h to ptr")
    (emitLine cg "  %fdrop = load i64, ptr %fdp")
    (emitLine cg "  %fa1 = add i64 %h, 8")
    (emitLine cg "  %fap = inttoptr i64 %fa1 to ptr")
    (emitLine cg "  %farg = load i64, ptr %fap")
    (emitLine cg "  %fhas = icmp ne i64 %fdrop, 0")
    (emitLine cg "  %fliv = icmp ne i64 %farg, 0")
    (emitLine cg "  %fdo = and i1 %fhas, %fliv")
    (emitLine cg "  br i1 %fdo, label %fcall, label %filev")
    (emitLine cg "fcall:")
    (emitLine cg "  store i64 0, ptr %fap")
    (emitLine cg "  %ffp = inttoptr i64 %fdrop to ptr")
    (emitLine cg "  %fres = call i64 %ffp(i64 %farg)")
    (emitLine cg "  br label %filev")
    (emitLine cg "defer:")
    (emitLine cg "  %dh = load i64, ptr %dead")
    (emitLine cg "  %dhenc = sub i64 -2, %dh")
    (emitLine cg "  store i64 %dhenc, ptr %cp")
    (emitLine cg "  store i64 %h, ptr %dead")
    (emitLine cg "  br label %after")
    (emitLine cg "filev:")
    (emitLine cg "  %bcnt0 = lshr i64 %shw, 1")
    (emitLine cg "  %bcnt = and i64 %bcnt0, 16383")
    (emitLine cg "  %blarge = icmp eq i64 %bcnt, 1")
    (emitLine cg "  br i1 %blarge, label %pushlarge, label %checksmall")
    (emitLine cg "pushlarge:")
    (emitLine cg "  call void @__axiom_file_large(i64 %h)")
    (emitLine cg "  br label %after")
    (emitLine cg "checksmall:")
    (emitLine cg "  %ok1 = icmp ne i64 %bcnt, 0")
    (emitLine cg "  %ok2 = icmp ule i64 %bcnt, 8192")
    (emitLine cg "  %ok = and i1 %ok1, %ok2")
    (emitLine cg "  br i1 %ok, label %push, label %after")
    (emitLine cg "push:")
    (if (== (allocPoisonOn) 1)
      (emitPoisonFill cg "pz" "%h" "%bcnt" "push"))
    (emitFloorClass cg "pf" "%bcnt" "%pcls"
      (if (== (allocPoisonOn) 1)
        "pzdone"
        "push"))
    (emitLine cg "  %pslotp = getelementptr [4143 x i64], ptr @__axiom_slabs, i64 0, i64 %pcls")
    (emitLine cg "  %ohead = load i64, ptr %pslotp")
    (emitLine cg "  %oenc = sub i64 -2, %ohead")
    (emitLine cg "  store i64 %oenc, ptr %cp")
    (emitLine cg "  store i64 %hoff, ptr %pslotp")
    (emitLine cg "  br label %after")
    (emitLine cg "after:")
    (emitLine cg "  %D0 = load i64, ptr %D")
    (emitLine cg "  %hasD = icmp ne i64 %D0, 0")
    (emitLine cg "  br i1 %hasD, label %walk, label %drain")
    (emitLine cg "walk:")
    (emitLine cg "  %Dw = load i64, ptr %D")
    (emitLine cg "  %m = load i64, ptr %wm")
    (emitLine cg "  %warrf = load i64, ptr %warr")
    (emitLine cg "  %wisarr = icmp ne i64 %warrf, 0")
    ; One exhaustion test for both forms, and it is not a coincidence:
    ; `%wm` holds the REMAINING bitmap for a record block and the
    ; REMAINING word count for an array block, and both are done at
    ; zero.
    (emitLine cg "  %mzero = icmp eq i64 %m, 0")
    (emitLine cg "  br i1 %mzero, label %fileD, label %stepone")
    (emitLine cg "stepone:")
    (emitLine cg "  br i1 %wisarr, label %arrstep, label %testbit")
    ; The ARRAY FORM (bit 15): every payload word 0..count-1 is a
    ; reference. It is the only shape that can describe a container's
    ; element buffer - `Intern`'s string vector is 64 words at
    ; construction and the record bitmap holds 47 - and it costs one
    ; bit rather than a second header word because the count field had
    ; one to spare: the allocator clamps a payload past 16,383 words to
    ; the unknown-size sentinel, which is the same clamp it always
    ; applied one bit higher up.
    ;
    ; Words past a container's `len` are ZERO, which `relone` skips as
    ; an immediate - that is why `vecPop` zeroes what it vacates rather
    ; than leaving a stale handle above the waterline for this walk to
    ; spend a share of.
    (emitLine cg "arrstep:")
    (emitLine cg "  %ai = load i64, ptr %wi")
    (emitLine cg "  %am1 = add i64 %m, -1")
    (emitLine cg "  %ai1 = add i64 %ai, 1")
    (emitLine cg "  store i64 %am1, ptr %wm")
    (emitLine cg "  store i64 %ai1, ptr %wi")
    (emitLine cg "  br label %relchild")
    (emitLine cg "testbit:")
    (emitLine cg "  %i = load i64, ptr %wi")
    (emitLine cg "  %bit = and i64 %m, 1")
    (emitLine cg "  %m1 = lshr i64 %m, 1")
    (emitLine cg "  %i1 = add i64 %i, 1")
    (emitLine cg "  store i64 %m1, ptr %wm")
    (emitLine cg "  store i64 %i1, ptr %wi")
    (emitLine cg "  %isset = icmp ne i64 %bit, 0")
    (emitLine cg "  br i1 %isset, label %relchild, label %walk")
    (emitLine cg "relchild:")
    (emitLine cg "  %ri = phi i64 [ %i, %testbit ], [ %ai, %arrstep ]")
    (emitLine cg "  %woff = shl i64 %ri, 3")
    (emitLine cg "  %waddr = add i64 %Dw, %woff")
    (emitLine cg "  %waddrp = inttoptr i64 %waddr to ptr")
    (emitLine cg "  %wval = load i64, ptr %waddrp")
    (emitLine cg "  store i64 %wval, ptr %cur")
    (emitLine cg "  br label %relone")
    (emitLine cg "fileD:")
    (emitLine cg "  %dq = add i64 %Dw, -8")
    (emitLine cg "  %dqp = inttoptr i64 %dq to ptr")
    (emitLine cg "  %dshw = load i64, ptr %dqp")
    (emitLine cg "  %dcnt0 = lshr i64 %dshw, 1")
    (emitLine cg "  %dcnt = and i64 %dcnt0, 16383")
    (emitLine cg "  store i64 0, ptr %D")
    (emitLine cg "  %dlarge = icmp eq i64 %dcnt, 1")
    (emitLine cg "  br i1 %dlarge, label %pushDlarge, label %checkDsmall")
    (emitLine cg "pushDlarge:")
    (emitLine cg "  call void @__axiom_file_large(i64 %Dw)")
    (emitLine cg "  br label %drain")
    (emitLine cg "checkDsmall:")
    (emitLine cg "  %dok1 = icmp ne i64 %dcnt, 0")
    (emitLine cg "  %dok2 = icmp ule i64 %dcnt, 8192")
    (emitLine cg "  %dok = and i1 %dok1, %dok2")
    (emitLine cg "  br i1 %dok, label %pushD, label %drain")
    (emitLine cg "pushD:")
    (if (== (allocPoisonOn) 1)
      (emitPoisonFill cg "pzD" "%Dw" "%dcnt" "pushD"))
    (emitFloorClass cg "df" "%dcnt" "%dcls"
      (if (== (allocPoisonOn) 1)
        "pzDdone"
        "pushD"))
    (emitLine cg "  %dslotp = getelementptr [4143 x i64], ptr @__axiom_slabs, i64 0, i64 %dcls")
    (emitLine cg "  %dohead = load i64, ptr %dslotp")
    (emitLine cg "  %dbase = add i64 %Dw, -16")
    (emitLine cg "  %dbasep = inttoptr i64 %dbase to ptr")
    (emitLine cg "  %doenc = sub i64 -2, %dohead")
    (emitLine cg "  store i64 %doenc, ptr %dbasep")
    (emitLine cg "  store i64 %dbase, ptr %dslotp")
    (emitLine cg "  br label %drain")
    (emitLine cg "drain:")
    (emitLine cg "  %dl = load i64, ptr %dead")
    (emitLine cg "  %empty = icmp eq i64 %dl, 0")
    (emitLine cg "  br i1 %empty, label %done, label %popD")
    (emitLine cg "popD:")
    (emitLine cg "  %lp0 = add i64 %dl, -16")
    (emitLine cg "  %lpp = inttoptr i64 %lp0 to ptr")
    (emitLine cg "  %nxtenc = load i64, ptr %lpp")
    (emitLine cg "  %nxt = sub i64 -2, %nxtenc")
    (emitLine cg "  store i64 %nxt, ptr %dead")
    (emitLine cg "  store i64 %dl, ptr %D")
    (emitLine cg "  store i64 0, ptr %wi")
    (emitLine cg "  %pq = add i64 %dl, -8")
    (emitLine cg "  %pqp = inttoptr i64 %pq to ptr")
    (emitLine cg "  %pshw = load i64, ptr %pqp")
    (emitLine cg "  %pmap = lshr i64 %pshw, 16")
    ; A block carrying both forms is walked as an ARRAY - the two are
    ; disjoint by construction (a header has a map, a buffer has the
    ; array bit) and one of them has to win a shape that should not
    ; exist.
    (emitLine cg "  %parr = and i64 %pshw, 32768")
    (emitLine cg "  %pisarr = icmp ne i64 %parr, 0")
    ; THE ARRAY LENGTH SHARES BITS 16..62 WITH THE RECORD BITMAP, and
    ; that is the whole encoding: the two forms are disjoint, so the
    ; field can be a bitmap for one and a count for the other. It used
    ; to read bits 1..14 - the ALLOCATOR's padded word count - which
    ; the allocator clamps to 0 past 16,383 words, so a container's
    ; element buffer of 131,072 bytes or more announced itself as an
    ; array of ZERO handles and the walk below stepped over every
    ; element it held. Measured 2026-09-03: a 16,384-element reference
    ; vector and the same program built with `vecNew` had the same
    ; peak RSS to the kilobyte, which is what a form doing nothing
    ; looks like from outside (`tests/stdlib/406-array-form-large-
    ; block.ax`).
    ;
    ; `Mem.memMarkArray` writes this field from the ELEMENT count its
    ; caller already has, so it never needs a number the allocator
    ; threw away, and `Mem.memMarkLeaf` clears it along with bit 15 -
    ; a leaf that kept it would read back as a record with a bitmap.
    ; The mask is 47 bits (bits 16..62), leaving bit 63 out so the
    ; shape word stays non-negative.
    (emitLine cg "  %pcnt = and i64 %pmap, 140737488355327")
    (emitLine cg "  %pwm = select i1 %pisarr, i64 %pcnt, i64 %pmap")
    (emitLine cg "  %pflg = select i1 %pisarr, i64 1, i64 0")
    (emitLine cg "  store i64 %pwm, ptr %wm")
    (emitLine cg "  store i64 %pflg, ptr %warr")
    (emitLine cg "  br label %walk")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; The fast path every release call site inlines (attributes #1):
    ; an immediate, a static or a block whose count is above one
    ; needs no drain - decrement and return. The last share, and
    ; every other shape, takes the full path above.
    (emitLine cg "define void @axiom_release(i64 %h0) #1 {")
    (emitLine cg "entry:")
    (emitLine cg "  %imm = icmp slt i64 %h0, 4096")
    (emitLine cg "  br i1 %imm, label %done, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %hoff = add i64 %h0, -16")
    (emitLine cg "  %cp = inttoptr i64 %hoff to ptr")
    (emitLine cg "  %c = load i64, ptr %cp")
    (emitLine cg "  %stat = icmp slt i64 %c, 0")
    (emitLine cg "  br i1 %stat, label %done, label %cnt")
    (emitLine cg "cnt:")
    (emitLine cg "  %zero = icmp eq i64 %c, 0")
    (emitLine cg "  br i1 %zero, label %done, label %onechk")
    (emitLine cg "onechk:")
    (emitLine cg "  %one = icmp eq i64 %c, 1")
    (emitLine cg "  br i1 %one, label %full, label %dec")
    (emitLine cg "dec:")
    (emitLine cg "  %c1 = add i64 %c, -1")
    (emitLine cg "  store i64 %c1, ptr %cp")
    (emitLine cg "  br label %done")
    (emitLine cg "full:")
    (emitLine cg "  call void @axiom_release_full(i64 %h0)")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    (if (reserveSupported cg)
      (emitReservedRuntime cg))
    (emitArenaHelpers cg)
    (emitBadMarkTrap cg)
    (emitLiveHandleTrap cg)
    (emitEvCheck cg)
    (emitDivTrap cg)
    (emitOverflowTrap cg)
    (emitShiftTrap cg)
    (emitIndexTrap cg)
    (emitAtomicAlignTrap cg)
    (emitOomTrap cg)
    (emitRecoverRuntime cg)
    (emitStrEqHelper cg)
    (emitContractTrap cg)
    (emitHandleRuntime cg)
    (emitParRuntime cg)
    cg
  })

; How many of 2048, 4096, ... (`n` thresholds, doubling) the value `x`
; reaches, as `%<p>n<n>`: floor(log2 x) - 10 for x in [1024, 2^(10+n+1)).
; The size-class arithmetic of MM-ALLOC-25 needs that logarithm and may
; not declare an intrinsic for it (see `sizeok` in `axiom_alloc`).
(pub :: emitLog2Steps (-> CG String String Int CG))
(pub fn (emitLog2Steps cg p x n)
  (emitLog2StepsFrom cg p x n 1 2048))

; `%<p><s>`: a register in the private family `p` of one emitted helper,
; so two uses of a helper in one function never collide.
(:: famReg (-> String String String))
(fn (famReg p s)
  (concat "%" (concat p s)))

(:: emitLog2StepsFrom (-> CG String String Int Int Int CG))
(fn (emitLog2StepsFrom cg p x n k bound)
  (if (> k n)
    cg
    {
      (let c (famReg p (concat "c" (fmtInt k))))
      (let z (famReg p (concat "z" (fmtInt k))))
      (let nk (famReg p (concat "n" (fmtInt k))))
      (let nprev
        (if (== k 1)
          "0"
          (famReg p (concat "n" (fmtInt (- k 1))))))
      {
        (emitLine cg
          (concat "  "
            (concat c (concat " = icmp uge i64 " (concat x (concat ", " (fmtInt bound)))))))
        (emitLine cg (concat "  " (concat z (concat " = zext i1 " (concat c " to i64")))))
        (emitLine cg
          (concat "  " (concat nk (concat " = add i64 " (concat nprev (concat ", " z))))))
        (emitLog2StepsFrom cg p x n (+ k 1) (* bound 2))
      }
    }))

; MM-ALLOC-25, the release half: the slab a dead block of `words`
; payload words files on, written to `out`, with the filing counted in
; slab slot 0 (MM-ALLOC-24). A block files at the LARGEST class
; boundary not above its size - its size itself at or below 1 KiB,
; where the classes are every 16 bytes, and its size rounded DOWN to the
; step 2^(floor(log2 size) - 3) above - so every block on a list is at
; least as big as the class it serves, whatever path made it. The
; allocator rounds a request UP to the same boundaries, which is what
; makes the two halves meet: a block born for a request of class c is
; exactly c bytes and files back at c. `words` is 1..8192 here; the
; caller has already refused the rest. `from` names the block the
; helper is emitted into, because the rounding sits behind a branch:
; a block at or below 1 KiB - every constructor, closure and header -
; pays one compare for it, not the logarithm.
; Fill a reusable block after its reference walk has finished. The
; allocator header stays intact; allocation still returns zeroed memory.
(pub :: emitPoisonFill (-> CG String String String String CG))
(pub fn (emitPoisonFill cg p base cnt from)
  {
    (emitLine cg (concat "  %" (concat p (concat "bytes = shl i64 " (concat cnt ", 3")))))
    (emitLine cg
      (concat "  %"
        (concat p (concat "end = add i64 " (concat base (concat ", %" (concat p "bytes")))))))
    (emitLine cg (concat "  br label %" (concat p "loop")))
    (emitLine cg (concat p "loop:"))
    (emitLine cg
      (concat "  %"
        (concat p
          (concat "i = phi i64 [ "
            (concat base
              (concat ", %"
                (concat from
                  (concat " ], [ %" (concat p (concat "next, %" (concat p "body ]")))))))))))
    (emitLine cg
      (concat "  %"
        (concat p (concat "more = icmp ult i64 %" (concat p (concat "i, %" (concat p "end")))))))
    (emitLine cg
      (concat "  br i1 %"
        (concat p (concat "more, label %" (concat p (concat "body, label %" (concat p "done")))))))
    (emitLine cg (concat p "body:"))
    (emitLine cg (concat "  %" (concat p (concat "p = inttoptr i64 %" (concat p "i to ptr")))))
    (emitLine cg (concat "  store i64 -6510615555426900571, ptr %" (concat p "p")))
    (emitLine cg (concat "  %" (concat p (concat "next = add i64 %" (concat p "i, 8")))))
    (emitLine cg (concat "  br label %" (concat p "loop")))
    (emitLine cg (concat p "done:"))
    cg
  })

(pub :: emitFloorClass (-> CG String String String String CG))
(pub fn (emitFloorClass cg p words out from)
  {
    (let b (famReg p "b"))
    (let big (famReg p "big"))
    (let sh (famReg p "sh"))
    (let step (famReg p "step"))
    (let neg (famReg p "neg"))
    (let fl (famReg p "fl"))
    (let fsz (famReg p "fsz"))
    (let f0 (famReg p "f0"))
    (let t (famReg p "t"))
    (let f1 (famReg p "f1"))
    (let roundL (concat p "round"))
    (let joinL (concat p "join"))
    {
      (emitLine cg (concat "  " (concat b (concat " = shl i64 " (concat words ", 3")))))
      (emitLine cg (concat "  " (concat big (concat " = icmp ugt i64 " (concat b ", 1024")))))
      (emitLine cg
        (concat "  br i1 "
          (concat big (concat ", label %" (concat roundL (concat ", label %" joinL))))))
      (emitLine cg (concat roundL ":"))
      (emitLog2Steps cg p b 6)
      (emitLine cg (concat "  " (concat sh (concat " = add i64 " (concat (famReg p "n6") ", 7")))))
      (emitLine cg (concat "  " (concat step (concat " = shl i64 1, " sh))))
      (emitLine cg (concat "  " (concat neg (concat " = sub i64 0, " step))))
      (emitLine cg (concat "  " (concat fl (concat " = and i64 " (concat b (concat ", " neg))))))
      (emitLine cg (concat "  br label %" joinL))
      (emitLine cg (concat joinL ":"))
      (emitLine cg
        (concat "  "
          (concat fsz
            (concat " = phi i64 [ "
              (concat b
                (concat ", %"
                  (concat from
                    (concat " ], [ " (concat fl (concat ", %" (concat roundL " ]")))))))))))
      (emitLine cg (concat "  " (concat out (concat " = lshr i64 " (concat fsz ", 4")))))
      (emitLine cg (concat "  " (concat f0 " = load i64, ptr @__axiom_slabs")))
      (emitLine cg (concat "  " (concat t (concat " = add i64 " (concat b ", 16")))))
      (emitLine cg (concat "  " (concat f1 (concat " = add i64 " (concat f0 (concat ", " t))))))
      (emitLine cg (concat "  store i64 " (concat f1 ", ptr @__axiom_slabs")))
      cg
    }
  })

; ------------------------------------------------------------------
; The two arena primitives, as runtime helpers beside the allocator
; whose globals they move. stage0's `emit_arena_helpers`, block for
; block.
;
; A mark is the WHOLE allocator position, not just the waterline:
; `@__axiom_bump` alone is meaningless once allocation has moved to a
; different chunk, because `@__axiom_bump_end` still describes the
; newer one - restoring the old bump against the new end let the fast
; path succeed on an address in neither chunk, and a mark taken before
; the first chunk existed handed out address 0. So a mark saves bump,
; end AND the chunk bump points into, in a three-word cell so marks
; nest. The cell is allocated BEFORE the position is read, which puts
; it below its own waterline: a reset never reclaims it, so the same
; mark can be reset twice.
;
; A reset restores that position and returns every chunk mapped since
; the mark to the free list. It writes no byte of the memory it
; reclaims, which is what the copy-at-boundary idiom depends on; the
; zeroing `memAlloc` promises happens in `handout` instead, as each
; byte is handed to a caller.
; ------------------------------------------------------------------
(pub :: emitArenaHelpers (-> CG CG))

; String equality, emitted UNCONDITIONALLY beside the division trap and
; for the same reason: `==` on two `String`s lowers to a call to this,
; and a program that compares strings and declares no effects must not
; reach `opt` with a call to a symbol nothing defines.
;
; WHY THIS EXISTS. `==` compiled to `icmp eq` on the two handles, so it
; compared ADDRESSES: `(== "hi" (strDup "hi"))` was false while
; `(strEq ...)` was true, and identical literals within a module intern
; to one header, so `(== "hi" "hi")` was true. A test that compares a
; literal against a literal passes; the same test against a computed
; string fails. That is a silent wrong answer in a language whose
; strings are first class, and its corpus population is zero - all 551
; string comparisons in this repository are spelled `strEq`, which is
; why nothing caught it.
;
; The comparison is over BYTES, which is exactly right for Unicode:
; UTF-8 byte equality is code-point-sequence equality, and UTF-8 orders
; bytes the way Unicode orders code points - the same argument `strCmp`,
; `strEq` and `strStartsWith` already rest on. A `Str` may contain an
; interior NUL, so the length word decides the extent and the NUL
; terminator is never consulted.
;
; Two handles at the same address are equal without a read, which also
; makes `(== s s)` total when `s` is 0.
(pub :: emitStrEqHelper (-> CG CG))
(pub fn (emitStrEqHelper cg)
  {
    (emitLine cg "define internal i64 @__axiom_str_eq(i64 %a, i64 %b) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %same = icmp eq i64 %a, %b")
    (emitLine cg "  br i1 %same, label %yes, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %anull = icmp eq i64 %a, 0")
    (emitLine cg "  %bnull = icmp eq i64 %b, 0")
    (emitLine cg "  %null = or i1 %anull, %bnull")
    (emitLine cg "  br i1 %null, label %no, label %lens")
    (emitLine cg "lens:")
    (emitLine cg "  %ap = inttoptr i64 %a to ptr")
    (emitLine cg "  %la = load i64, ptr %ap")
    (emitLine cg "  %bp = inttoptr i64 %b to ptr")
    (emitLine cg "  %lb = load i64, ptr %bp")
    (emitLine cg "  %lne = icmp ne i64 %la, %lb")
    (emitLine cg "  br i1 %lne, label %no, label %data")
    (emitLine cg "data:")
    (emitLine cg "  %aa = add i64 %a, 8")
    (emitLine cg "  %aap = inttoptr i64 %aa to ptr")
    (emitLine cg "  %da = load i64, ptr %aap")
    (emitLine cg "  %ba = add i64 %b, 8")
    (emitLine cg "  %bap = inttoptr i64 %ba to ptr")
    (emitLine cg "  %db = load i64, ptr %bap")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ 0, %data ], [ %i2, %body ]")
    (emitLine cg "  %more = icmp ult i64 %i, %la")
    (emitLine cg "  br i1 %more, label %body, label %yes")
    (emitLine cg "body:")
    (emitLine cg "  %sa = add i64 %da, %i")
    (emitLine cg "  %sap = inttoptr i64 %sa to ptr")
    (emitLine cg "  %ca = load i8, ptr %sap")
    (emitLine cg "  %sb = add i64 %db, %i")
    (emitLine cg "  %sbp = inttoptr i64 %sb to ptr")
    (emitLine cg "  %cb = load i8, ptr %sbp")
    (emitLine cg "  %cne = icmp ne i8 %ca, %cb")
    (emitLine cg "  %i2 = add i64 %i, 1")
    (emitLine cg "  br i1 %cne, label %no, label %loop")
    (emitLine cg "yes:")
    (emitLine cg "  ret i64 1")
    (emitLine cg "no:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; The division trap, emitted UNCONDITIONALLY beside the arena helpers.
; It first rode along with `emitUnhandledTrap`, which is emitted only
; when the program declares an effect - so every program that divided
; and had no effects reached `opt` with a call to a symbol nothing
; defined. Caught by the first probe after the change.
; The allocator's out-of-memory path, as a function rather than two
; copies of an exit.
;
; IT USED TO SAY NOTHING. `axiom_alloc` and `axiom_alloc_mapped` each
; ended their `oom:` label with a bare `exit(70)`, so a program that ran
; out of memory vanished with a status and no output at all. For a
; compiler that is survivable - the operator is watching it run. For the
; long-lived programs this language is now used to write it is not: a
; worker in a pre-forked pool disappears, the supervisor respawns it,
; and nothing anywhere says why. `MM-ALLOC-7` records the status; it did
; not record that the status arrives alone.
;
; This is the shape `emitDivTrap` already had for status 72, and 70 gets
; it for the same reason. It does NOT make the failure recoverable -
; that needs the allocator to answer rather than exit, which needs a way
; for Axiom code to arm it, which needs a primitive, which needs the
; committed seed to move. This is the half that costs nothing: emitted
; text only, so the fixpoint holds with no reseed.
; ------------------------------------------------------------------
; ABORT TO AN ARENA MARK (docs/error-model.md, docs/memory-model.md
; MM-ALLOC-16a/16b).
;
; A recovery point is a record in its arming function's frame and one
; global pointing at the innermost armed one. `emitPrimRecover` writes the arm; this is
; the other end - the function every trap asks before it writes its
; sentence and exits.
;
;   word 0  the arming frame's stack pointer
;   word 1  its frame pointer
;   word 2  the address inside the arm block to resume at
;   word 3  the arena mark to reclaim to
;   word 4  the record this one displaced
;   word 5  the status, written by the abort and read after the arm
;   6..15   the callee-saved registers the arm block preserves
;   16..    one word per evidence slot, snapshotted at the arm
;
; Recovery restores the stack pointer, arena and effect slots. It does
; not unwind frames or run resource cleanup callbacks. Resources that
; cross a recovery extent need explicit cleanup (MM-EXEC-17).
; The N frames of pending `axiom_release` calls the jump abandons are
; harmless because the reset reclaims everything above the mark
; regardless of any count (MM-ALLOC-13, MM-ALLOC-14) and scrubs all
; 4,097 slab heads first, so nothing filed survives to be double-issued
; (MM-LIFE-2e). The residue everyone calls a wart is what makes this
; correct.
;
; THE EVIDENCE SLOTS ARE THE ONE THING THE ARENA DOES NOT COVER. A
; `handle` pushes a record onto `@__axiom_ev_<Effect>` and pops it at
; the end of its body; a jump past that pop leaves the slot pointing at
; a record the reset just reclaimed, and the next operation dispatches
; through it. So the arm snapshots every slot and the abort writes them
; all back - before the reset, so the reset's live-handle check
; (MM-ALLOC-16b) sees every slot at its arm-time value.
;
; AND A PROGRAM THAT NEVER ARMS ONE PAYS NOTHING. This function is the
; only reader of `@__axiom_recover_top` and it never writes it - the
; arm site restores the displaced record itself, on both paths, which
; is what leaves the global store-free. With no arm site anywhere,
; GlobalOpt folds the load to the initialiser, the `armed` test to
; false and the body to `ret i64 0`; the inliner then deletes the three
; calls and GlobalDCE the function, the helpers and the global.
; `scripts/check-recover.sh` asserts exactly that, at `opt -O1`.
(pub :: emitRecoverRuntime (-> CG CG))
(pub fn (emitRecoverRuntime cg)
  {
    (emitLine cg "")
    (emitLine cg (concat "@__axiom_recover_top = " (concat (cgMutGlobal cg) " i64 0")))
    (emitLine cg "define internal i64 @__axiom_recover_abort(i64 %code) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %top = load i64, ptr @__axiom_recover_top")
    (emitLine cg "  %armed = icmp ne i64 %top, 0")
    (emitLine cg "  br i1 %armed, label %jump, label %none")
    (emitLine cg "none:")
    ; MM-PAR-7: every caller exits when this returns, so no child it
    ; spawned may outlive it - swept only in a module that can spawn.
    (if (== (parRegistryOn cg) 1)
      {
        (emitLine cg "  call void @__axiom_par_sweep(i64 -1)")
        ; Under threads, the process children OTHER threads forked are on
        ; no registry this thread can see; the kill list has them all.
        (if (cgThreads cg)
          (emitLine cg "  call void @__axiom_par_gkill()"))
      })
    (emitLine cg "  ret i64 0")
    (emitLine cg "jump:")
    (emitLine cg "  %recp = inttoptr i64 %top to ptr")
    (emitLine cg "  %sp = load i64, ptr %recp")
    (emitLine cg "  %a1 = add i64 %top, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %fp = load i64, ptr %p1")
    (emitLine cg "  %a2 = add i64 %top, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  %pc = load i64, ptr %p2")
    (emitLine cg "  %a3 = add i64 %top, 24")
    (emitLine cg "  %p3 = inttoptr i64 %a3 to ptr")
    (emitLine cg "  %mark = load i64, ptr %p3")
    (emitLine cg "  %a5 = add i64 %top, 40")
    (emitLine cg "  %p5 = inttoptr i64 %a5 to ptr")
    (emitLine cg "  store i64 %code, ptr %p5")
    ; MM-PAR-7: the children spawned inside the extent end BEFORE the
    ; reset reclaims what they may still be reading - a thread's thunk
    ; lives in this arena.
    (if (== (parRegistryOn cg) 1)
      {
        (emitLine cg (concat "  %aseqa = add i64 %top, " (concat (fmtInt (parRecSeqOffset cg)) "")))
        (emitLine cg "  %aseqp = inttoptr i64 %aseqa to ptr")
        (emitLine cg "  %aseq = load i64, ptr %aseqp")
        (emitLine cg "  call void @__axiom_par_sweep(i64 %aseq)")
      })
    (emitLine cg "  call i64 @__axiom_recover_load(i64 %top)")
    ; MM-EXEC-20: the reset runs the cleanup of the owners made inside
    ; the extent, and they can tell a trap ended it.
    (if (== (resRegistryOn cg) 1)
      (emitLine cg "  store i64 1, ptr @__axiom_res_unwinding"))
    (emitLine cg "  call i64 @__axiom_arena_reset_fn(i64 %mark)")
    (if (== (resRegistryOn cg) 1)
      (emitLine cg "  store i64 0, ptr @__axiom_res_unwinding"))
    (emitLine cg
      (concat "  call void asm sideeffect "
        (concat (targetRecoverJumpAsm (cgTarget cg)) "(i64 %top, i64 %sp, i64 %fp, i64 %pc)")))
    ; ON WINDOWS-X86_64 THE JUMP NEEDS A REAL INSTRUCTION AFTER IT.
    ; LLVM's Win64 unwinder pass (X86AvoidTrailingCall) puts an `int3`
    ; after a call that ends a function, and it does not count inline
    ; asm as an instruction. Above -O0 the loads move above the reset
    ; call, so `callq __axiom_arena_reset_fn` sat right before the
    ; block and the `int3` landed BETWEEN them: every abort from an
    ; armed recovery point ended in STATUS_BREAKPOINT (0x80000003)
    ; instead of jumping. `llvm.trap` is a `ud2` that is never reached
    ; and leaves the jump no longer the function's tail. windows-aarch64
    ; has no such pass and emits its `brk` after the block. Tested by
    ; `scripts/check-recover.sh`.
    (if (== (cgTarget cg) 6)
      (emitLine cg "  call void @llvm.trap()"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (if (== (cgTarget cg) 6)
      (emitLine cg "declare void @llvm.trap() cold noreturn nounwind"))
    cg
  })

; How many DISTINCT evidence slots the program has - the same dedup
; `emitEffectGlobals` applies, because an imported effect is registered
; twice and both entries name one slot. It is the record's variable
; part and the two helpers' loop bound.
(pub :: distinctSlotCount (-> (Vec EffEnt) Int Int Int))
(pub fn (distinctSlotCount tbl i acc)
  (if (>= i (vecLen tbl))
    acc
    (if (== (slotFirstIndex tbl (effSlot (vecGet tbl i)) 0) i)
      (distinctSlotCount tbl (+ i 1) (+ acc 1))
      (distinctSlotCount tbl (+ i 1) acc))))

; The slot snapshot, as two functions rather than as a run of stores at
; every arm site: an arm inside a loop is one call instead of one store
; per declared effect per iteration, and both directions then read the
; same walk, so they cannot disagree about the order.
(pub :: emitRecoverSlotHelpers (-> CG CG))
(pub fn (emitRecoverSlotHelpers cg)
  {
    (emitLine cg "")
    (emitLine cg "define internal i64 @__axiom_recover_save(i64 %rec) #0 {")
    (emitLine cg "entry:")
    (emitRecoverSlotMoves cg 0 0 1)
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_recover_load(i64 %rec) #0 {")
    (emitLine cg "entry:")
    (emitRecoverSlotMoves cg 0 0 0)
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    cg
  })

(pub :: emitRecoverSlotMoves (-> CG Int Int Int Int))
(pub fn (emitRecoverSlotMoves cg i k save)
  {
    (let tbl (cgEffDecls cg))
    (if (>= i (vecLen tbl))
      k
      (if (== (slotFirstIndex tbl (effSlot (vecGet tbl i)) 0) i)
        {
          (emitRecoverSlotMove cg (llvmSym (effSlot (vecGet tbl i))) k save)
          (emitRecoverSlotMoves cg (+ i 1) (+ k 1) save)
        }
        (emitRecoverSlotMoves cg (+ i 1) k save)))
  })

(pub :: emitRecoverSlotMove (-> CG String Int Int CG))
(pub fn (emitRecoverSlotMove cg slot k save)
  {
    (let off (fmtInt (+ 128 (* k 8))))
    (let a (concat "%ra" (fmtInt k)))
    (let p (concat "%rp" (fmtInt k)))
    (let v (concat "%rv" (fmtInt k)))
    {
      (emitLine cg (concat (concat "  " a) (concat " = add i64 %rec, " off)))
      (emitLine cg (concat (concat "  " p) (concat " = inttoptr i64 " (concat a " to ptr"))))
      (if (== save 1)
        {
          (emitLine cg (concat (concat "  " v) (concat " = load i64, ptr @" slot)))
          (emitLine cg (concat "  store i64 " (concat v (concat ", ptr " p))))
        }
        {
          (emitLine cg (concat (concat "  " v) (concat " = load i64, ptr " p)))
          (emitLine cg (concat "  store i64 " (concat v (concat ", ptr @" slot))))
        })
      cg
    }
  })

; THE SENTENCE MUST BE TRUE OF THE STRATEGY THAT FAILED. `mmap failed`
; is what a hosted target's arena does when the kernel refuses it, and
; it is a false statement on a target that has no `mmap` - 4.2's static
; arena fails by running out of a region that was reserved at link
; time, which is a different thing for its reader to go and look at.
; The status does not move (70, MM-ALLOC-7) and neither does the shape;
; only the sentence, and only where the strategy differs.
;
; The length is COUNTED rather than typed, because it is written twice -
; the array's declared length and the `write`'s - and llc believes the
; declaration. `+ 1` is the trailing newline, which is one byte and two
; characters of source. A hosted target still gets `[35 x i8]` and a
; write of 35, byte for byte.
(pub :: emitOomTrap (-> CG CG))
;@axiom:effect(io)
(pub fn (emitOomTrap cg)
  {
    (let msg
      (if (> (arenaStaticBytes (cgTarget cg)) 0)
        "axiom: out of memory (arena exhausted)"
        "axiom: out of memory (mmap failed)"))
    {
      (let n (fmtInt (+ (strLen msg) 1)))
      {
        (emitLine cg
          (concat "@__axiom_oom_msg = private unnamed_addr constant ["
            (concat n (concat " x i8] c\"" (concat msg "\\0A\"")))))
        (emitLine cg
          (concat "define internal i64 @__axiom_out_of_memory() " (concat trapFnAttrs " {")))
        (emitLine cg "entry:")
        (emitLine cg "  call i64 @__axiom_recover_abort(i64 70)")
        (emitLine cg "  %oomp = ptrtoint ptr @__axiom_oom_msg to i64")
        (emitRuntimeWrite cg "%oomp" n)
        (emitLine cg "  call void @__axiom_backtrace()")
        (emitRuntimeExit cg "70")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        ; MM-ALLOC-7a's refusal: the same status and the same recovery
        ; as the mapping refusal above, with a sentence that does not
        ; blame `mmap` for a request nothing was asked to map - a
        ; negative size, or one past 2^62 bytes.
        (emitLine cg
          "@__axiom_oom_size_msg = private unnamed_addr constant [52 x i8] c\"axiom: out of memory (allocation size out of range)\\0A\"")
        (emitLine cg
          (concat "define internal i64 @__axiom_out_of_memory_size() " (concat trapFnAttrs " {")))
        (emitLine cg "entry:")
        (emitLine cg "  call i64 @__axiom_recover_abort(i64 70)")
        (emitLine cg "  %oomsp = ptrtoint ptr @__axiom_oom_size_msg to i64")
        (emitRuntimeWrite cg "%oomsp" "52")
        (emitLine cg "  call void @__axiom_backtrace()")
        (emitRuntimeExit cg "70")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        ; The count is a finite runtime resource too. It shares the
        ; exhaustion status, but does not claim that allocation failed.
        (emitLine cg
          "@__axiom_rc_full_msg = private unnamed_addr constant [38 x i8] c\"axiom: reference count limit exceeded\\0A\"")
        (emitLine cg
          (concat "define internal i64 @__axiom_refcount_exhausted() " (concat trapFnAttrs " {")))
        (emitLine cg "entry:")
        (emitLine cg "  call i64 @__axiom_recover_abort(i64 70)")
        (emitLine cg "  %rcp = ptrtoint ptr @__axiom_rc_full_msg to i64")
        (emitRuntimeWrite cg "%rcp" "38")
        (emitLine cg "  call void @__axiom_backtrace()")
        (emitRuntimeExit cg "70")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        (if (== (resRegistryOn cg) 1)
          {
            (emitLine cg
              "@__axiom_res_full_msg = private unnamed_addr constant [40 x i8] c\"axiom: resource sequence limit exceeded\\0A\"")
            (emitLine cg
              (concat "define internal i64 @__axiom_resource_sequence_exhausted() "
                (concat trapFnAttrs " {")))
            (emitLine cg "entry:")
            (emitLine cg "  call i64 @__axiom_recover_abort(i64 70)")
            (emitLine cg "  %seqp = ptrtoint ptr @__axiom_res_full_msg to i64")
            (emitRuntimeWrite cg "%seqp" "40")
            (emitLine cg "  call void @__axiom_backtrace()")
            (emitRuntimeExit cg "70")
            (emitLine cg "  unreachable")
            (emitLine cg "}")
          })
        cg
      }
    }
  })

; An index out of range: status 77, `docs/memory-model.md` MM-EXEC-16.
;
; WHY A TRAP AND NOT AN ANSWER. `vecGet` answered 0, and
; `stdlib/Vec.ax`'s own comment calls that "the worse of the two
; failure modes: not a crash, a wrong answer that keeps going" - 0 is a
; value a caller may have pushed, so a read past the end and a stored
; zero are indistinguishable. The shape here is `emitDivTrap`'s and so
; is the argument: an index out of range is the class of programmer
; error division by zero is, and Axiom already answers that class with
; a trap rather than a value.
;
; RECOVERABLE, which is what makes it acceptable rather than blunt:
; `__axiom_recover_abort` runs first, so a recovery point answers 77
; instead of the process exiting. `vecTry` remains the checked read for
; an index that may legitimately be out of range.
(pub :: emitIndexTrap (-> CG CG))

; ------------------------------------------------------------------
; THE SIX TRAPS ARE `noreturn cold`, and `trapFnAttrs` is the one
; spelling of that. Each of them ends in an exit syscall - or, with a
; recovery point armed, in `__axiom_recover_abort`'s longjmp - and then
; `unreachable`; none has a `ret`. So `noreturn` states a fact, and
; `cold` states the other one: a trap is the path a program takes at
; most once.
;
; WHAT IT IS FOR, measured 2026-09-03 on the compiler's own emitted IR
; (`emit-llvm core/main.ax`, 202,424 lines) through `opt`:
;
;   inlined copies of the index trap (two syscalls and a
;   `@__axiom_backtrace` call each), counted by the uses of
;   `@__axiom_index_msg`:
;       --opt 1   1,685 -> 2      --opt 2   1,518 -> 2
;   loops the vectorizer accepted at --opt 2: 98 -> 101
;   (`lsp$lspChSites`, `lsp$lspSignatureHelp`, `lsp$lspViewHintsCall`)
;
; The source of those copies is `Vec$vecGet` and every accessor like
; it: small, inlined everywhere, and carrying the trap's body with it,
; so the cold path of a bounds check sat inside 1,500 hot functions.
; With the callee cold, the inliner leaves it a call, and with it
; noreturn the block after the call is `unreachable` rather than an
; edge back into the loop - which is what the loop vectorizer's
; "early exit with writes" refusals were about. `nounwind` was
; measured beside it and moved nothing; it is not here.
; `scripts/check-simd.sh` holds the copy count, with an ablation that
; blanks this string and requires the copies back.
; ------------------------------------------------------------------
(pub :: trapFnAttrs String)
(pub fn (trapFnAttrs)
  "noreturn cold #0")

(pub fn (emitIndexTrap cg)
  {
    (emitLine cg
      "@__axiom_index_msg = private unnamed_addr constant [33 x i8] c\"axiom: vector index out of range\\0A\"")
    (emitLine cg
      (concat "define internal i64 @__axiom_index_out_of_range() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 77)")
    (emitLine cg "  %ixp = ptrtoint ptr @__axiom_index_msg to i64")
    (emitRuntimeWrite cg "%ixp" "33")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "77")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; Status 82: an atomic whose address is not 8-byte aligned
; (`emitAtomicAlignGuard`). Recoverable, as the index trap is.
(pub :: emitAtomicAlignTrap (-> CG CG))
(pub fn (emitAtomicAlignTrap cg)
  {
    (emitLine cg
      "@__axiom_misaligned_msg = private unnamed_addr constant [32 x i8] c\"axiom: misaligned atomic access\\0A\"")
    (emitLine cg
      (concat "define internal i64 @__axiom_misaligned_atomic() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 82)")
    (emitLine cg "  %map = ptrtoint ptr @__axiom_misaligned_msg to i64")
    (emitRuntimeWrite cg "%map" "32")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "82")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

(pub :: emitDivTrap (-> CG CG))
(pub fn (emitDivTrap cg)
  {
    (emitLine cg
      "@__axiom_divzero_msg = private unnamed_addr constant [24 x i8] c\"axiom: division by zero\\0A\"")
    (emitLine cg (concat "define internal i64 @__axiom_div_by_zero() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 72)")
    (emitLine cg "  %dzp = ptrtoint ptr @__axiom_divzero_msg to i64")
    (emitRuntimeWrite cg "%dzp" "24")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "72")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; MM-VAL-3b's first corner, trapped: `sdiv`/`srem` overflow on
; `INT_MIN / -1`. Same shape as `emitDivTrap` (recoverable, backtrace,
; exact byte count: 25), its own status - each broken invariant gets
; one (`MM-EXEC-16`).
(pub :: emitOverflowTrap (-> CG CG))
(pub fn (emitOverflowTrap cg)
  {
    (emitLine cg
      "@__axiom_divovf_msg = private unnamed_addr constant [25 x i8] c\"axiom: division overflow\\0A\"")
    (emitLine cg (concat "define internal i64 @__axiom_div_overflow() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 83)")
    (emitLine cg "  %dop = ptrtoint ptr @__axiom_divovf_msg to i64")
    (emitRuntimeWrite cg "%dop" "25")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "83")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; MM-VAL-3b's second corner, trapped: a shift amount below 0 or above
; 63. Same shape, own status, 33 bytes exactly.
(pub :: emitShiftTrap (-> CG CG))
(pub fn (emitShiftTrap cg)
  {
    (emitLine cg
      "@__axiom_shift_msg = private unnamed_addr constant [33 x i8] c\"axiom: shift amount out of range\\0A\"")
    (emitLine cg
      (concat "define internal i64 @__axiom_shift_out_of_range() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 84)")
    (emitLine cg "  %shp = ptrtoint ptr @__axiom_shift_msg to i64")
    (emitRuntimeWrite cg "%shp" "33")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "84")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; ------------------------------------------------------------------
; MM-ALLOC-16a's trap: status 75, `__axiom_arena_reset` handed a mark
; whose chunk is no longer on the active list.
;
; The fourth member of the family `emitDivTrap` opened for 72,
; `emitOomTrap` joined for 70 and `emitUnhandledTrap` for 71, emitted
; the same way: a private constant whose declared length is the
; message's byte count EXACTLY - 38, counting the trailing newline,
; because llc believes the declared length and a wrong one truncates
; the sentence or writes bytes past it.
;
; IT DOES NOT ARM `__axiom_recover_abort`, and that is the one place
; it departs from its three siblings. A recovery point's abort IS an
; arena reset (`emitPrimRecover` calls `@__axiom_arena_reset_fn` on the
; arming mark, `MM-ALLOC-23`), so answering an invalid reset by
; performing another reset asks the corrupted structure the same
; question again. By the time this is reached the unwind walk has
; already pushed every chunk it passed onto the free list looking for
; a chunk that was not there, so the list an abort would reset through
; is exactly the one that just proved untrustworthy. 70, 71 and 72 are
; conditions a program can be written to survive; this one is a
; violation of `I8`, and `docs/error-model.md`'s recovery table names
; three statuses, not four.
; ------------------------------------------------------------------
; MM-ALLOC-16b's trap: status 76, a reset that would reclaim the
; evidence record a live `handle` still dispatches through.
;
; The fifth member of the family `emitDivTrap` opened for 72,
; `emitOomTrap` joined for 70, `emitUnhandledTrap` for 71 and
; `emitBadMarkTrap` for 75, emitted the same way: a private constant
; whose declared length is the message's byte count EXACTLY - 38 again,
; counting the trailing newline, because llc believes the declared
; length and a wrong one truncates the sentence or writes past it.
;
; LIKE 75 IT DOES NOT ARM `__axiom_recover_abort`, and here the reason
; is sharper than it was there. A recovery abort IS an arena reset AND
; its whole job is restoring evidence slots (`emitRecoverSlotHelpers`),
; so answering "a slot points into memory this reset is reclaiming" by
; running the slot-restoring abort asks the corrupted structure the
; same question. 70, 71 and 72 are conditions a program can be written
; to survive; this is a violated implementation invariant, and
; `docs/error-model.md`'s recovery table names three statuses.
(pub :: emitLiveHandleTrap (-> CG CG))
(pub fn (emitLiveHandleTrap cg)
  ; GATED, and the byte-identity check is what caught this. The call
  ; sites were gated on the slot count from the start; the trap and its
  ; message constant were not, so a program with no `(effect ...)` -
  ; `core/main.ax` among them - grew two lines of IR for a
  ; function nothing could reach. Two lines is not a cost worth
  ; arguing about, and that is exactly why it had to go: the rule is
  ; byte-identity, not "small enough".
  (if (== (distinctSlotCount (cgEffDecls cg) 0 0) 0)
    cg
    {
      (emitLine cg "")
      (emitLine cg
        "@__axiom_livehandle_msg = private unnamed_addr constant [38 x i8] c\"axiom: arena reset past a live handle\\0A\"")
      (emitLine cg (concat "define internal i64 @__axiom_live_handle() " (concat trapFnAttrs " {")))
      (emitLine cg "entry:")
      (emitLine cg "  %lhp = ptrtoint ptr @__axiom_livehandle_msg to i64")
      (emitRuntimeWrite cg "%lhp" "38")
      (emitLine cg "  call void @__axiom_backtrace()")
      (emitRuntimeExit cg "76")
      (emitLine cg "  unreachable")
      (emitLine cg "}")
      cg
    }))

; ------------------------------------------------------------------
; `@__axiom_ev_check(lo, hi)` - does any LIVE evidence slot point into
; [lo, hi)? If one does, the reset about to reclaim that range would
; free a record a handler still dispatches through, and this traps.
;
; WHY A NON-NULL SLOT IS ALWAYS A LIVE EXTENT, which is what makes the
; test sound rather than merely plausible. The `handle` pop does not
; null the slot - it stores back the record it displaced - so a
; completed extent leaves the slot exactly as it found it, and the
; outermost pop leaves it 0. A slot that reads non-zero therefore names
; an extent that has not ended. A stale pointer from a finished handle
; cannot be there to false-positive on.
;
; TWO SHAPES THAT LOOK LIKE FALSE POSITIVES AND ARE NOT. A record
; recycled off a size-class free list (`MM-LIFE-2e`) can sit BELOW the
; waterline, where this reset does not reclaim it - the range test is
; silent, correctly. And `emitEffectOp` transiently installs the
; DISPLACED record for the duration of a handler call; that record is
; older than the current one, so the check can only under-report.
;
; THE RECOVERY PATH NEEDS NO EXEMPTION AND GETS NONE.
; `emitRecoverRuntime` calls `@__axiom_recover_load` BEFORE
; `@__axiom_arena_reset_fn`, so by the time this runs every slot has
; already been overwritten with its arm-time value - which was
; installed before the arm, hence below the arm's mark. The abort
; arranges, on its own, for this test to be false. Measured on
; `tests/stdlib/401-recover-effect.ax`, whose entire purpose is
; aborting out of a live `handle`: exit 71, stdout unchanged.
; The call, emitted only when there is a slot to check. At zero slots
; this writes nothing at all, which is the whole zero-cost argument:
; `@__axiom_arena_reset_fn` is in every binary, so a check that cost a
; no-effect program one instruction would cost EVERY program one.
(pub :: emitEvCall (-> CG String String CG))
(pub fn (emitEvCall cg lo hi)
  (if (== (distinctSlotCount (cgEffDecls cg) 0 0) 0)
    cg
    (emitLine cg
      (concat "  call i64 @__axiom_ev_check(i64 " (concat lo (concat ", i64 " (concat hi ")")))))))

(pub :: emitEvChunkCall (-> CG CG))
(pub fn (emitEvChunkCall cg)
  (if (== (distinctSlotCount (cgEffDecls cg) 0 0) 0)
    cg
    {
      (emitLine cg "  %csizep = inttoptr i64 %c to ptr")
      (emitLine cg "  %csize = load i64, ptr %csizep")
      (emitLine cg "  %cend = add i64 %c, %csize")
      (emitLine cg "  call i64 @__axiom_ev_check(i64 %c, i64 %cend)")
      cg
    }))

(pub :: emitEvCheck (-> CG CG))
(pub fn (emitEvCheck cg)
  {
    (let n (distinctSlotCount (cgEffDecls cg) 0 0))
    (if (== n 0)
      cg
      {
        (emitLine cg "")
        (emitLine cg "define internal i64 @__axiom_ev_check(i64 %lo, i64 %hi) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  br label %evs0")
        (emitEvCheckSlots cg 0 0)
        (emitLine cg (concat "evs" (concat (fmtInt n) ":")))
        (emitLine cg "  ret i64 0")
        (emitLine cg "evlive:")
        (emitLine cg "  call i64 @__axiom_live_handle()")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        cg
      })
  })

; One arm per DISTINCT slot, deduplicated exactly the way
; `emitRecoverSlotMoves` does it - an imported effect is registered
; twice under one slot, and checking it twice would be harmless but
; would make the emitted arm count disagree with `distinctSlotCount`,
; which is what closes the block.
(pub :: emitEvCheckSlots (-> CG Int Int Int))
(pub fn (emitEvCheckSlots cg i k)
  {
    (let tbl (cgEffDecls cg))
    (if (>= i (vecLen tbl))
      k
      (if (== (slotFirstIndex tbl (effSlot (vecGet tbl i)) 0) i)
        {
          (emitEvCheckSlot cg (llvmSym (effSlot (vecGet tbl i))) k)
          (emitEvCheckSlots cg (+ i 1) (+ k 1))
        }
        (emitEvCheckSlots cg (+ i 1) k)))
  })

; Unsigned comparisons, because these are addresses.
(pub :: emitEvCheckSlot (-> CG String Int CG))
(pub fn (emitEvCheckSlot cg slot k)
  {
    (let n (fmtInt k))
    (let nx (fmtInt (+ k 1)))
    {
      (emitLine cg (concat "evs" (concat n ":")))
      (emitLine cg (concat "  %evv" (concat n (concat " = load i64, ptr @" slot))))
      (emitLine cg (concat "  %evnz" (concat n (concat " = icmp ne i64 %evv" (concat n ", 0")))))
      (emitLine cg (concat "  %evge" (concat n (concat " = icmp uge i64 %evv" (concat n ", %lo")))))
      (emitLine cg (concat "  %evlt" (concat n (concat " = icmp ult i64 %evv" (concat n ", %hi")))))
      (emitLine cg
        (concat "  %evin"
          (concat n (concat " = and i1 %evge" (concat n (concat ", %evlt" (concat n "")))))))
      (emitLine cg
        (concat "  %evhit"
          (concat n (concat " = and i1 %evnz" (concat n (concat ", %evin" (concat n "")))))))
      (emitLine cg (concat "  br i1 %evhit" (concat n (concat ", label %evlive, label %evs" nx))))
      cg
    }
  })

(pub :: emitBadMarkTrap (-> CG CG))
(pub fn (emitBadMarkTrap cg)
  {
    (emitLine cg "")
    (emitLine cg
      "@__axiom_badmark_msg = private unnamed_addr constant [38 x i8] c\"axiom: arena reset to an invalid mark\\0A\"")
    (emitLine cg (concat "define internal i64 @__axiom_bad_mark() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  %bmp = ptrtoint ptr @__axiom_badmark_msg to i64")
    (emitRuntimeWrite cg "%bmp" "38")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "75")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; ------------------------------------------------------------------
; P1: WHICH FUNCTION DIED.
;
; A dying Axiom program used to yield a status and one line - "axiom:
; division by zero" and 72 - which answers WHAT happened and nothing
; about WHERE. `scripts/check-stack-depth.sh` records three SIGSEGVs
; whose cause was found only by attaching `lldb`, and that is the tool
; a production worker in a pre-forked pool does not have.
;
; The whole mechanism is three pieces, and none of them is debug
; metadata:
;
;   1. `"frame-pointer"="all"` on the module's one attribute group.
;      Measured 2026-08-24 on the prologue of a non-leaf function at
;      `llc -O2`, with the attribute and without it: ALL FOUR targets
;      need it. Both x86_64 targets push a scratch register in place of
;      %rbp without it; linux-aarch64 saves x30 alone; and
;      darwin-aarch64 - whose ABI is usually described as requiring a
;      frame pointer, and where a first reading of this said the
;      attribute was a no-op - emits `stp x29, x30, [sp, #-16]!`
;      WITHOUT the following `mov x29, sp`. It saves the register pair
;      and does not establish the frame pointer, which are different
;      things and only the second is what a walker needs.
;      `__axiom_div_by_zero` at --opt 1 is a function in this very tree
;      that does the first and not the second.
;
;   2. A table of every symbol this module defines, address beside
;      name, emitted as ordinary constant data.
;
;   3. A walker that follows the chain and turns each return address
;      into a name.
;
; WHY THE LAYOUT NEEDS NO TARGET BRANCH. On AArch64 the prologue is
; `stp x29, x30, [sp, #-16]!` then `mov x29, sp`, so [x29] is the saved
; frame pointer and [x29+8] the return address. On x86-64 it is
; `push %rbp` then `mov %rsp, %rbp`, so [rbp] is the saved frame
; pointer and [rbp+8] the return address. The two ABIs agree on the
; only two words this reads, which is why there is one walker here and
; not four.
;
; WHAT IT DELIBERATELY IS NOT. No line numbers, no inlining records, no
; DWARF, no `-g`, and no `!dbg` anywhere - `emitLine` writes text and
; the seed compiles that text, so the self-hosting fixpoint is
; untouched by construction. Function-level answers most of production
; triage; line tables can wait until a real triage fails for want of
; one.
; ------------------------------------------------------------------
; Every symbol this module DEFINES, in emission order, read back out of
; the line buffer rather than out of the declaration list.
;
; Reading the buffer is what makes the table COMPLETE. The declaration
; list holds user functions; it does not hold the lifted lambdas
; (`@_lam_N`), the thunks (`@_thunk_N`), `@main`, or the runtime
; helpers - `@axiom_alloc`, `@axiom_release`, the three traps and the
; arena helpers - and every one of those can be the frame that died. A
; name missing from the table is worse than absent: the lookup below
; takes the greatest entry at or below the return address, so a hole
; makes the walker confidently print the WRONG function.
(pub :: symtabNames (-> Ints Names))
(pub fn (symtabNames lines)
  {
    (let out vecNew)
    {
      (symtabScan lines 0 out)
      out
    }
  })

(pub :: symtabScan (-> Ints Int Names Int))
(pub fn (symtabScan lines i out)
  (if (>= i (vecLen lines))
    0
    {
      {
        (let ln (vecGetStr lines i))
        (if (strStartsWith ln "define ")
          {
            (let at (symtabAtOf ln 0 (strLen ln)))
            (if (! (< at 0))
              {
                (let end (symtabEndOf ln (+ at 1) (strLen ln)))
                (if (! (< end 0))
                  (vecPush out (strSlice ln (+ at 1) (- end (+ at 1)))))
              })
          })
      }
      (symtabScan lines (+ i 1) out)
    }))

; The `@` that opens the defined symbol. It is the first one on the
; line: the return type precedes it and holds none, and the parameter
; list follows it.
(pub :: symtabAtOf (-> String Int Int Int))
(pub fn (symtabAtOf s i n)
  (if (>= i n)
    (- 0 1)
    (if (== (strByte s i) 64)
      i
      (symtabAtOf s (+ i 1) n))))

; Where the symbol ends. A QUOTED symbol ends at its closing quote -
; `llvmSym` quotes any name that is not a plain LLVM identifier, and a
; quoted name may legally contain `(`, so scanning for the parameter
; list first would truncate it. `check-symbol-names.sh` sweeps all 94
; printable bytes through this path, so the quoted arm is exercised
; rather than hypothetical.
(pub :: symtabEndOf (-> String Int Int Int))
(pub fn (symtabEndOf s i n)
  (if (>= i n)
    (- 0 1)
    (if (== (strByte s i) 34)
      (symtabQuoteEnd s (+ i 1) n)
      (symtabParenOf s i n))))

(pub :: symtabQuoteEnd (-> String Int Int Int))
(pub fn (symtabQuoteEnd s i n)
  (if (>= i n)
    (- 0 1)
    ; A `\` inside the quotes opens a two-digit hex escape, so the byte
    ; after it can be a `"` that does not close the name. `llvmSymBody`
    ; is the only writer and it escapes exactly `"` and `\`.
    (if (== (strByte s i) 92)
      (symtabQuoteEnd s (+ i 3) n)
      (if (== (strByte s i) 34)
        (+ i 1)
        (symtabQuoteEnd s (+ i 1) n)))))

(pub :: symtabParenOf (-> String Int Int Int))
(pub fn (symtabParenOf s i n)
  (if (>= i n)
    (- 0 1)
    (if (== (strByte s i) 40)
      i
      (symtabParenOf s (+ i 1) n))))

; ------------------------------------------------------------------
; DEAD-CODE PRUNING: a program contains only what it uses.
; ------------------------------------------------------------------
; A hello world used to be 103,592 bytes and 388 `define`s, of which 13
; were reachable from `main`: `(import IO)` drags in `Err`, `Fmt`, `Sys`
; and the rest transitively, and every one of them was emitted, linked
; and shipped. `nm` on the executable found all 375 dead ones.
;
; WHY THE LINKER COULD NOT DO IT, and why fixing only the linkage would
; not have worked either. Two separate things pinned that code, and
; both had to go:
;
;   1. 375 of the 388 `define`s carried EXTERNAL linkage. LLVM cannot
;      delete an externally-linked function, because another
;      translation unit might call it. Axiom is a whole-program
;      compiler and there is no other translation unit.
;   2. `emitSymbolTable` writes `ptrtoint (ptr @F to i64)` for EVERY
;      function in the module, so the backtrace table is a live global
;      holding the address of all of them. That pin survives any
;      linkage change: measured, marking all 384 non-runtime `define`s
;      `internal` and running `opt -O1` removed exactly ONE of them and
;      left all 397 symbols in the binary - 103,592 bytes down to
;      97,368, a 6% win. Removing the symbol-table pin as well took the
;      same program to 17,224 bytes and 12 symbols, an 83% win. The
;      linkage was the smaller half of the problem.
;
; So the decision is taken HERE, where both halves are answerable at
; once: the module is pruned to the reachable set BEFORE the symbol
; table is built, and the table then describes exactly the functions
; that survived. A stripped function can never appear in a backtrace,
; so nothing is lost by its absence.
;
; WHY THE WALK READS THE EMITTED IR RATHER THAN THE AST. Reachability
; is only as good as the definition of "reachable", and the class that
; sinks a naive answer is the function whose ADDRESS IS TAKEN rather
; than called - a callback, a comparator, a capability-record field.
; `vecSortBy`, `vecSiftDownBy`, `taskFold` and `taskFoldOne` are the
; ones the effect walk already gives up on and marks
; `#effects-incomplete`, and an AST walk would have to rediscover every
; one of them and would still be guessing about the next.
;
; In the emitted IR that entire class disappears, because there is only
; one way to mention a function at all: the token `@name`. A call is
; `call i64 @f(...)`, an address-take is `ptrtoint (ptr @f to i64)`, a
; closure record's code word is the same `ptrtoint`, and a thunk over a
; bare reference is a `define` whose body calls its target. One scan
; for `@` finds all of them, with no per-shape knowledge and nothing to
; keep in step as the emitter grows. That is why this runs on the line
; buffer, which `symtabNames` already reads for the same reason.
;
; AND THE FAILURE MODE IS LOUD. LLVM's textual IR has no implicit
; declaration: a call to an `@f` nothing defines is `error: use of
; undefined value '@f'` out of `opt`, which is exactly the shape the
; retired `foreign` keyword died of. Probed again before this was
; written. So a root this walk gets WRONG cannot ship a binary that
; links and then crashes - it fails the build, in the compiler's own
; pipeline, naming the symbol. Every over-approximation below is
; therefore free and every under-approximation is caught.
;
; THE ROOT SET, in one place, with the reason for each:
;
;   the target's entry symbol  `main`, or `mainCRTStartup` on Windows.
;                              The linker starts here; nothing in the
;                              module calls it.
;   axiom_alloc                the C ABI a linked host calls. All three
;   axiom_retain               are `pub` in `rust/axiom_ffi` and
;   axiom_release              `rust/examples/demo/src/lib.rs` states
;                              their external linkage as a contract, so
;                              they are roots in EVERY build, not only
;                              an archive one - a `--crate` host linked
;                              into an ordinary executable calls
;                              `axiom_release` from Rust, where no IR
;                              of ours mentions it.
;   non-local globals and     externally observable initializers and
;   other top-level statements LLVM retention lists remain roots. Private
;                              and internal globals are graph nodes: a
;                              live reference follows their initializers,
;                              while an unused descriptor pins no callback.
;
; and, transitively, every `@name` in the body of anything reachable.
;
; `--emit-staticlib` PRUNES NOTHING, and needs no flag to say so. An
; archive exists precisely so that another translation unit can call
; into it: every `pub fn` is a C symbol by contract (docs/ffi.md), the
; `axh_*` accessors and `Str$strAlloc` are called from the Rust
; `--emit-rust-binding` writes, and the whole-program assumption this
; pass rests on is false by construction. That is the one named
; consumer, the compiler already knows which mode it is in, and there
; is no opt-out for anyone else to remember.
; ------------------------------------------------------------------
; The four tables the walk carries, bundled so the scanners take one
; parameter instead of four: 0 = the defined symbols, interned;
; 1 = intern id -> index into `defStart`; 2 = index -> 0/1 live;
; 3 = the worklist of definitions marked live and not yet scanned.
(pub :: pruneCtxNew (-> Int Ints Ints Ints Ints))
(pub fn (pruneCtxNew si idToDef live stack)
  {
    (let v vecNew)
    {
      (vecPush v si)
      (vecPushVec v idToDef)
      (vecPushVec v live)
      (vecPushVec v stack)
      v
    }
  })

; Mark the define named `sym` live, and queue it. A name that defines
; nothing in this module - `@putchar` from an `extern` declare, or a
; `@`-shaped run of bytes inside a string constant - is silently no
; symbol of ours, which is what makes the outside-a-define root class
; safe to apply to every line without knowing what is on it.
(pub :: pruneMark (-> Ints String Int))
(pub fn (pruneMark ctx sym)
  (if (let (Some id) (internFind (vecGet ctx 0) sym))
    {
      (let idToDef (vecGetVec ctx 1))
      (if (>= id (vecLen idToDef))
        0
        {
          (let d (vecGet idToDef id))
          (let live (vecGetVec ctx 2))
          (if (== (vecGet live d) 1)
            0
            {
              (vecSet live d 1)
              (vecPush (vecGetVec ctx 3) d)
              0
            })
        })
    }
    0))

; One byte past the end of the `@`-spelling starting at `i`. A QUOTED
; name is delimited by its closing quote and may hold anything;
; `symtabQuoteEnd` already knows about the `\XX` escape `llvmSymBody`
; writes, and is reused rather than re-derived. The slice this bounds
; INCLUDES the quotes, because that is what `symtabScan` records for
; the define line - the two spellings have to match to compare.
(pub :: pruneRefEnd (-> String Int Int Int))
(pub fn (pruneRefEnd s i n)
  (if (>= i n)
    i
    (if (== (strByte s i) 34)
      {
        (let e (symtabQuoteEnd s (+ i 1) n))
        (if (< e 0)
          i
          e)
      }
      (pruneRefPlainEnd s i n))))

(pub :: pruneRefPlainEnd (-> String Int Int Int))
(pub fn (pruneRefPlainEnd s i n)
  (if (>= i n)
    i
    (if (llvmPlainByte (strByte s i))
      (pruneRefPlainEnd s (+ i 1) n)
      i)))

; Every `@name` on one line, marked. A `while` rather than the
; per-byte recursion the neighbouring scanners use, because this one
; is handed the string-constant lines too and those are as long as the
; longest literal in the program.
(pub :: pruneScanLine (-> Ints String Int))
(pub fn (pruneScanLine ctx ln)
  {
    (let n (strLen ln))
    (let mut i 0)
    {
      (while (< i n)
        (if (== (strByte ln i) 64)
          {
            (let e (pruneRefEnd ln (+ i 1) n))
            (if (> e (+ i 1))
              {
                (pruneMark ctx (strSlice ln (+ i 1) (- e (+ i 1))))
                (set i e)
              }
              (set i (+ i 1)))
          }
          (set i (+ i 1))))
      0
    }
  })

; A module-local global is reachable only through a real reference. Other
; globals retain their initializer roots, including LLVM's observable lists.
(:: pruneLocalGlobal (-> String Int Bool))
(fn (pruneLocalGlobal line end)
  (if (< end 0)
    false
    {
      (let rest (strSlice line end (- (strLen line) end)))
      (|| (strStartsWith rest " = private ") (strStartsWith rest " = internal "))
    }))

; Aggregate initializers can span lines. Delimiters inside a quoted name,
; string or comment are data, so they do not change the continuation depth.
(:: pruneGlobalDepth (-> String Int Int))
(fn (pruneGlobalDepth line depth)
  {
    (let mut level depth)
    (let mut i 0)
    (let n (strLen line))
    (while (< i n)
      {
        (let c (strByte line i))
        (if (== c 34)
          {
            (let end (symtabQuoteEnd line (+ i 1) n))
            (set i (if (< end 0)
              n
              end))
          }
          (if (== c 59)
            (set i n)
            {
              (if (|| (== c 40) (|| (== c 91) (|| (== c 123) (== c 60))))
                (set level (+ level 1))
                (if (|| (== c 41) (|| (== c 93) (|| (== c 125) (== c 62))))
                  (set level (- level 1))))
              (set i (+ i 1))
            }))
      })
    level
  })

; A balanced initializer can still continue on the next line: its value
; may follow an aggregate type, or an alignment/metadata suffix may follow
; the value. Close the node at the next module statement instead. A bare
; @reference, named type or metadata attachment on a continuation line
; is not a definition. Driver directive comments stay independent of any
; preceding global: deleting a string must not delete its extern library.
(:: pruneModuleLine (-> String Bool))
(fn (pruneModuleLine line)
  (if (|| (strStartsWith line "@")
        (|| (strStartsWith line "%") (|| (strStartsWith line "$") (strStartsWith line "!"))))
    {
      (let end (pruneRefEnd line 1 (strLen line)))
      (strStartsWith (strSlice line end (- (strLen line) end)) " =")
    }
    (|| (strStartsWith line "define ")
      (|| (strStartsWith line "declare ")
        (|| (strStartsWith line "target ")
          (|| (strStartsWith line "source_filename ")
            (|| (strStartsWith line "module asm ")
              (|| (strStartsWith line "attributes ")
                (|| (strStartsWith line "uselistorder ")
                  (|| (strStartsWith line "uselistorder_bb ")
                    (strStartsWith line "; axiom-")))))))))))

; Index functions and module-local global definitions in the same graph.
; Each line records its node index plus one; zero remains a top-level root.
; Function bodies end at the emitter's bare closing brace. Global nodes
; include all initializer and attribute lines before the next statement.
; A single pass owns this scalar cursor. A line is borrowed only while
; its classification and numeric indexing updates run.
(struct PruneCursor sealed
  (mut current : Int)
  (mut function : Int)
  (mut depth : Int))

(:: pruneIndexLine (-> String Int PruneCursor Int Ints Ints Ints Ints Ints ()))
;@axiom:effect(unsafe)
(fn (pruneIndexLine line i cursor si idToDef defStart defEnd live defOf)
  {
    (if (&& (>= cursor.current 0)
          (&& (== cursor.function 0) (&& (== cursor.depth 0) (pruneModuleLine line))))
      (set cursor.current (- 0 1)))
    (if (>= cursor.current 0)
      {
        (vecPush defOf (+ cursor.current 1))
        (vecSet defEnd cursor.current i)
        (if (== cursor.function 1)
          (if (strEq line "}")
            (set cursor.current (- 0 1)))
          (set cursor.depth (pruneGlobalDepth line cursor.depth)))
      }
      {
        (let isFunction (strStartsWith line "define "))
        (let at
          (if isFunction
            (symtabAtOf line 0 (strLen line))
            (if (strStartsWith line "@")
              0
              (- 0 1))))
        (let end
          (if (< at 0)
            (- 0 1)
            (if isFunction
              (symtabEndOf line (+ at 1) (strLen line))
              (pruneRefEnd line (+ at 1) (strLen line)))))
        (if (if (|| (< at 0) (< end 0))
          false
          (|| isFunction (pruneLocalGlobal line end)))
          {
            (let sym (strSlice line (+ at 1) (- end (+ at 1))))
            (let d (vecLen defStart))
            (vecPush defStart i)
            (vecPush defEnd i)
            (vecPush live 0)
            {
              (let id (internIntern si sym))
              (if (== id (vecLen idToDef))
                (vecPush idToDef d)
                (as 0 (Vec Int)))
            }
            (vecPush defOf (+ d 1))
            (if isFunction
              {
                (set cursor.function 1)
                (set cursor.current d)
              }
              {
                (set cursor.function 0)
                (set cursor.depth (pruneGlobalDepth line 0))
                (set cursor.current d)
              })
          }
          (vecPush defOf 0))
      })
    ()
  })

(pub :: pruneIndexDefs (-> Strings Int Ints Ints Ints Ints Ints Int))
(pub fn (pruneIndexDefs lines si idToDef defStart defEnd live defOf)
  {
    (let cursor (PruneCursor :current (- 0 1) :function 0 :depth 0))
    (let mut i 0)
    (while (< i (vecLen lines))
      {
        (let line (vecGet lines i))
        (pruneIndexLine line i cursor si idToDef defStart defEnd live defOf)
        (set i (+ i 1))
      })
    0
  })

; The transitive closure, as a worklist rather than a fixpoint sweep:
; `stack` only grows, and `sp` is how far it has been read, so every
; define's body is scanned exactly once.
(pub :: pruneWalk (-> Ints Strings Ints Ints Int))
(pub fn (pruneWalk ctx lines defStart defEnd)
  {
    (let stack (vecGetVec ctx 3))
    (let mut sp 0)
    {
      (while (< sp (vecLen stack))
        {
          (let d (vecGet stack sp))
          (let mut k 0)
          {
            (set k (vecGet defStart d))
            (while (<= k (vecGet defEnd d))
              {
                (pruneScanLine ctx (vecGet lines k))
                (set k (+ k 1))
              })
            (set sp (+ sp 1))
          }
        })
      0
    }
  })

; The buffer without unreachable functions and module-local globals.
;
; The lines are read with `vecGetStr` rather than `vecGet`. A typed read
; tells the flow walk that the answer holds parts of `lines`, and
; `pruneDeadDefs` would then keep the displaced buffer alive instead of
; giving its share back (tests/selfhost/emitter-line-buffer.py, cases
; 14 and 15). Each line pushed takes a share of its own either way.
(pub :: pruneRebuild (-> Strings Ints Ints Strings))
;@axiom:effect(unsafe)
(pub fn (pruneRebuild lines defOf live)
  {
    (let out vecNew)
    (let mut i 0)
    {
      (while (< i (vecLen lines))
        {
          {
            (let o (vecGet defOf i))
            (if (== o 0)
              (vecPush out (vecGetStr lines i))
              (if (== (vecGet live (- o 1)) 1)
                (vecPush out (vecGetStr lines i))
                (as 0 (Vec String))))
          }
          (set i (+ i 1))
        })
      out
    }
  })

(pub :: pruneDeadDefs (-> CG CG))
;@axiom:effect(io)
(pub fn (pruneDeadDefs cg)
  (if cgStaticlib
    cg
    {
      (let lines (cgLines cg))
      ; The context borrows this handle through the last scan and rebuild.
      (let siOwner internNewTyped)
      (let si (internWordOf siOwner))
      (let idToDef vecNew)
      (let defStart vecNew)
      (let defEnd vecNew)
      (let live vecNew)
      (let defOf vecNew)
      {
        (let ctx (pruneCtxNew si idToDef live vecNew))
        {
          (pruneIndexDefs lines si idToDef defStart defEnd live defOf)
          ; ------------------------------------------------------------
          ; THE ROOT SET, and it is the whole design: everything below
          ; is reached from here, so a name missing from this list is a
          ; function deleted out from under a live call. Deliberately
          ; generous - see the header for why an over-approximation
          ; here costs nothing and an under-approximation cannot ship.
          ; ------------------------------------------------------------
          ; `main`, or `mainCRTStartup` on Windows. The linker starts
          ; the program here and no IR of ours calls it.
          (pruneMark ctx (targetEntryName (cgTarget cg)))
          ; `_start`, on the bare target only, for the same reason:
          ; the linker script's ENTRY starts the program here and no
          ; IR of ours calls it. Marked only where it is emitted
          ; (see `emitBaremetalStart`); where it was never emitted
          ; there is no define by that name and the mark retains
          ; nothing.
          (if (== (cgTarget cg) 7)
            (pruneMark ctx "_start"))
          ; The C ABI a linked host calls. All three are `pub` in
          ; `rust/axiom_ffi` and `rust/examples/demo/src/lib.rs` states
          ; their external linkage as a contract - so they are roots in
          ; EVERY build, not only an archive one: a `--crate` host
          ; linked into an ordinary executable calls `axiom_release`
          ; from Rust, where nothing in this module mentions it.
          (pruneMark ctx "axiom_alloc")
          (pruneMark ctx "axiom_retain")
          (pruneMark ctx "axiom_release")
          ; Non-local globals and other top-level statements remain
          ; roots, including LLVM retention lists. Private and internal
          ; initializers are traversed only when their graph node is live.
          {
            (let mut i 0)
            (while (< i (vecLen lines))
              {
                (if (== (vecGet defOf i) 0)
                  (pruneScanLine ctx (vecGetStr lines i)))
                (set i (+ i 1))
              })
          }
          ; Everything reachable from those, through calls, through a
          ; `ptrtoint` into a closure record, and through the thunks a
          ; bare function reference synthesises - all one token to this
          ; walk, which is the point of reading the IR.
          (pruneWalk ctx lines defStart defEnd)
          ; Retire the context's displaced share, independently of the
          ; retained getter share in `lines`. Survivors already have a
          ; share in the rebuilt buffer before the old buffer can die.
          (cgReplaceLines cg (pruneRebuild lines defOf live))
        }
      }
    }))

; The printable body of an `@`-spelling: a quoted name without its
; quotes, a plain name unchanged.
(pub :: symtabBody (-> String String))
(pub fn (symtabBody spell)
  {
    (let n (strLen spell))
    (if (&& (> n 1) (== (strByte spell 0) 34))
      (strSlice spell 1 (- n 2))
      (strDup spell))
  })

; How many BYTES a body denotes. `\xx` is three characters and one
; byte, which is why this cannot be `strLen` - and getting it wrong
; would hand `write` a length past the end of the constant.
(pub :: symtabBodyBytes (-> String Int Int Int))
(pub fn (symtabBodyBytes s i n)
  (if (>= i (strLen s))
    n
    (if (== (strByte s i) 92)
      (symtabBodyBytes s (+ i 3) (+ n 1))
      (symtabBodyBytes s (+ i 1) (+ n 1)))))

; Is `name` one of the symbols this module defines? Asked once, about
; `main`, to decide whether the walk has a place to stop.
(pub :: symtabHas (-> Names String Int Bool))
(pub fn (symtabHas names name i)
  (if (>= i (vecLen names))
    false
    (if (strEq (vecGetStr names i) name)
      true
      (symtabHas names name (+ i 1)))))

; The name constants, one per symbol.
(pub :: emitSymNames (-> CG Names Int CG))
(pub fn (emitSymNames cg names i)
  (if (>= i (vecLen names))
    cg
    {
      {
        (let body (symtabBody (vecGetStr names i)))
        (emitLine cg
          (concat
            (concat "@__axiom_symn_" (concat (fmtInt i) " = private unnamed_addr constant ["))
            (concat (fmtInt (symtabBodyBytes body 0 0)) (concat " x i8] c\"" (concat body "\"")))))
      }
      (emitSymNames cg names (+ i 1))
    }))

; The table itself: address, name pointer, name length, flattened into
; one `[3N x i64]` rather than an array of structs, because the walker
; then indexes it with one multiply and no aggregate type to keep in
; step between the two emitters.
;
; The addresses are `ptrtoint` CONSTANT EXPRESSIONS. Nothing here can
; sort them - the linker assigns addresses, long after this text is
; written - so the table is in emission order and the lookup below
; scans it. Sorting it at startup would need an initialiser hook this
; language does not have, and a linear scan on a path that is about to
; call `exit` costs nothing anyone can measure.
(pub :: emitSymRows (-> CG Names Int CG))
(pub fn (emitSymRows cg names i)
  (if (>= i (vecLen names))
    cg
    {
      (let spell (vecGetStr names i))
      (let body (symtabBody spell))
      (emitLine cg
        (concat "  i64 "
          (concat (btStoredAddress cg spell)
            (concat ", i64 "
              (concat (btStoredAddress cg (concat "__axiom_symn_" (fmtInt i)))
                (concat ", i64 "
                  (concat (fmtInt (symtabBodyBytes body 0 0))
                    (if (< (+ i 1) (vecLen names))
                      ","
                      ""))))))))
      (emitSymRows cg names (+ i 1))
    }))

; Mach-O's relative table has no dynamic relocations. Keeping it in
; read-only text avoids a page-sized data segment in small executables.
(:: btRelative (-> CG Bool))
(fn (btRelative cg)
  (|| (== (cgTarget cg) 0) (== (cgTarget cg) 1)))

(:: btStoredAddress (-> CG String String))
(fn (btStoredAddress cg sym)
  {
    (let address (concat "ptrtoint (ptr @" (concat sym " to i64)")))
    (if (btRelative cg)
      (concat "sub (i64 " (concat address ", i64 ptrtoint (ptr @__axiom_symtab to i64))"))
      address)
  })

(:: btTableSection (-> CG String))
(fn (btTableSection cg)
  (if (btRelative cg)
    ", section \"__TEXT,__const\""
    ""))

(pub :: emitSymbolTable (-> CG Names CG))
(pub fn (emitSymbolTable cg names)
  {
    (let n (vecLen names))
    {
      (emitLine cg "")
      (emitSymNames cg names 0)
      ; A zero-length LLVM array is legal but a `getelementptr` into
      ; one is not useful, and a module with no `define` at all is a
      ; shape this refuses to special-case in the walker: the row count
      ; below is what bounds the scan, so a one-element placeholder
      ; costs 8 bytes and removes a branch from the trap path.
      (if (== n 0)
        (emitLine cg "@__axiom_symtab = internal constant [3 x i64] zeroinitializer")
        {
          (emitLine cg
            (concat "@__axiom_symtab = internal constant [" (concat (fmtInt (* 3 n)) " x i64] [")))
          (emitSymRows cg names 0)
          (emitLine cg (concat "]" (btTableSection cg)))
        })
      (emitLine cg (concat "@__axiom_symtab_n = internal constant i64 " (concat (fmtInt n) "")))
      cg
    }
  })

; Line attribution: from `; @@line` markers to the table the walker reads.
;
; The markers went out beside the calls (`emitCallMark`, or first in
; an already-isolated trap block); each pairs with the label on the
; line above it, in the function whose `define` most recently opened.
; This pass runs at module end over the RENDERED buffer - after
; `pruneDeadDefs`, so a stripped function takes its markers with it -
; resolves every marker against its file's text, and emits filename
; globals plus one flat `[5N x i64]` table of
; (block-address, file-pointer, file-length, line, column), with its
; row count beside it the way `@__axiom_symtab_n` sits beside the
; symbol table. The walker extends `bt_name` below to consult it.
;
; Everything the scan accumulates lives in locals threaded through
; the recursion or in vectors mutated in place - no new cg word (the
; record is at AX3029 already) and no global. What is read from disk
; is read here and only here: one read per distinct module, never per
; call site, and a file that cannot be read degrades its rows to bare
; frames rather than inventing lines for them.
;
; Returns the row count: `emitBacktrace` passes it to the walker's
; baked loop bound beside the symbol count.
(struct LineMark
  (label : String)
  (function : String)
  (module : String)
  (offset : Int))

(type LineMarks (Vec LineMark))

(pub :: emitLineTable (-> CG Int))
;@axiom:effect(io)
(pub fn (emitLineTable cg)
  {
    (let lines (cgLines cg))
    {
      (let marks (scanLineMarks lines 0 "" "" vecNew))
      {
        (let rows (vecNew))
        (let files (vecNew))
        (let addrFns (vecNew))
        (let addrLbls (vecNew))
        {
          (let n (resolveLineRows marks rows files addrFns addrLbls cg))
          {
            (emitLineTableGlobals rows files addrFns addrLbls n cg)
            n
          }
        }
      }
    }
  })

; Every byte as `\XX`, so a path with a backslash or a quote cannot
; close the constant early. String literals do this per byte already;
; filenames take the same road rather than a second quoting rule.
(pub :: llvmBytes (-> String String))
(pub fn (llvmBytes s)
  {
    (let b (strBuilderWithCapacity (* 3 (strLen s))))
    {
      (for i in 0..(strLen s)
        {
          (strBuilderPushByte b 92)
          (strBuilderPush b (hex2 (strByte s i)))
        })
      (strBuilderFinish b)
    }
  })

; `; @@line <module> <spanstart>`, or `; @@line <spanstart>` for the
; entry file. A marker whose preceding line is not a label, or that
; appears before any `define`, is a broken invariant of the emitters
; above - not data to skip over. Skipping it would leave its block's
; return addresses resolving to a NEIGHBOURING block's line, which is
; exactly the confident misattribution this table exists to remove;
; the build fails here instead, naming the compiler bug.
(pub :: scanLineMarks (-> Strings Int String String LineMarks LineMarks))
;@axiom:effect(io)
(pub fn (scanLineMarks lines i curfn lastlabel marks)
  (if (>= i (vecLen lines))
    marks
    {
      (let ln (vecGet lines i))
      (if (strStartsWith ln "; @@line ")
        (if (== (strLen lastlabel) 0)
          {
            (dieCodegenDiag "line marker with no label above it: " ln)
            marks
          }
          (scanLineMarks lines (+ i 1) curfn lastlabel (pushLineMark marks lastlabel curfn ln)))
        (if (strStartsWith ln "define ")
          (scanLineMarks lines (+ i 1) (defineFnSpell ln) "" marks)
          (if (isIRLabel ln)
            (scanLineMarks lines (+ i 1) curfn (labelName ln) marks)
            (scanLineMarks lines (+ i 1) curfn "" marks))))
    }))

; A blank line ends a label's reach: without this a marker two blocks
; down would pair with a label it has nothing to do with, and the
; strict arm above would never fire. Labels and markers are always
; adjacent by construction; anything else in between voids the pairing
; rather than bridging it.
(pub :: isIRLabel (-> String Bool))
(pub fn (isIRLabel ln)
  (if (< (strLen ln) 2)
    false
    (if (!= (strByte ln (- (strLen ln) 1)) 58)
      false
      {
        (let c (strByte ln 0))
        (if (|| (== c 32) (|| (== c 9) (== c 59)))
          false
          true)
      })))

(pub :: labelName (-> String String))
(pub fn (labelName ln)
  (strSlice ln 0 (- (strLen ln) 1)))

; The LLVM spelling of a `define`'s symbol - `@name` for plain names,
; `@"name"` for names that need quoting (a `#` or other non-plain byte
; in the typecheck-generated `show#...`). `blockaddress` accepts the
; bare spelling as its first operand, and a plain `@name` next to a
; `@"name"` in the same module is the one mismatch that made
; `blockaddress(Vec$vecNew, ...)` fail to parse under `opt`.
; `symtabEndOf` reads the closing paren of a plain name and the closing
; quote of a quoted one, and is reused - the two emitters have to agree.
(pub :: defineFnSpell (-> String String))
(pub fn (defineFnSpell ln)
  (if (let (Some at) (strFindByte ln 64 0))
    {
      (let end (symtabEndOf ln (+ at 1) (strLen ln)))
      (if (< end 0)
        ""
        (strSlice ln at (- end at)))
    }
    ""))

; One marker row: label, function, module ("" for entry), span start.
(pub :: pushLineMark (-> LineMarks String String String LineMarks))
(pub fn (pushLineMark marks label func ln)
  {
    (let rest (strSlice ln 9 (- (strLen ln) 9)))
    (let marker
      (if (let (Some e) (strFindByte rest 32 0))
        (LineMark
          :label label
          :function func
          :module (strSlice rest 0 e)
          :offset (strToInt (strSlice rest (+ e 1) (- (strLen rest) (+ e 1)))))
        (LineMark :label label :function func :module "" :offset (strToInt rest))))
    (vecPush marks marker)
    marks
  })

; A helper because the walker makes six of these calls and the template
; string is the one thing in the emitter that must not be retyped by
; hand - `targetSyscallAsm`'s own comment records a clobber list that
; was one register short and cost an infinite loop. The door itself is
; `emitRuntimeWrite`, since 2026-08-29 the one place that knows how a
; target writes to fd 2.
; Resolve every marker against its file's text and accumulate one
; row string per resolvable marker into `rows`, returning the count.
; Texts are read once per distinct module no matter how many markers
; name it, and each text's line starts are indexed once: resolving
; per marker re-read and re-scanned whole files, which put a second
; per call site on a 700 KiB module - measured, the shape that took
; self-host emission from two seconds to eight.
(pub :: resolveLineRows (-> LineMarks Strings Strings Strings Strings CG Int))
;@axiom:effect(io)
(pub fn (resolveLineRows marks rows files addrFns addrLbls cg)
  (resolveMods marks (collectMods marks 0 vecNew) 0 rows files addrFns addrLbls cg))

; Distinct modules in first-sight order.
(pub :: collectMods (-> LineMarks Int Strings Strings))
(pub fn (collectMods marks i mods)
  (if (>= i (vecLen marks))
    mods
    {
      (let marker (vecGet marks i))
      (let modname marker.module)
      (if (>= (findString mods modname 0) 0)
        (collectMods marks (+ i 1) mods)
        {
          (vecPush mods (strDup modname))
          (collectMods marks (+ i 1) mods)
        })
    }))

(pub :: resolveMods (-> LineMarks Strings Int Strings Strings Strings Strings CG Int))
;@axiom:effect(io)
(pub fn (resolveMods marks mods j rows files addrFns addrLbls cg)
  (if (>= j (vecLen mods))
    (vecLen rows)
    {
      (let modname (vecGet mods j))
      {
        (let text (markText modname cg))
        (if (== (strLen text) 0)
          (resolveMods marks mods (+ j 1) rows files addrFns addrLbls cg)
          {
            (let path (markPath modname cg))
            {
              (let ix (srcLineIndexTyped text))
              {
                (resolveModMarks marks 0 modname text path ix rows files addrFns addrLbls)
                (resolveMods marks mods (+ j 1) rows files addrFns addrLbls cg)
              }
            }
          })
      }
    }))

(pub :: resolveModMarks
  (-> LineMarks Int String String String SrcIx Strings Strings Strings Strings Int))
(pub fn (resolveModMarks marks i modname text path ix rows files addrFns addrLbls)
  (if (>= i (vecLen marks))
    0
    {
      (let m (vecGet marks i))
      (if (strEq modname m.module)
        {
          (let off m.offset)
          (if (>= off (strLen text))
            (resolveModMarks marks (+ i 1) modname text path ix rows files addrFns addrLbls)
            {
              (let fi (fileIndex files path 0))
              {
                (vecPush rows (lineRowStr fi path (lineOfIx ix off) (colOfIx text ix off)))
                (vecPush addrFns (strDup m.function))
                (vecPush addrLbls (strDup m.label))
                (resolveModMarks marks (+ i 1) modname text path ix rows files addrFns addrLbls)
              }
            })
        }
        (resolveModMarks marks (+ i 1) modname text path ix rows files addrFns addrLbls))
    }))

; The display path of a marker's module: the entry input's basename,
; or the resolved module path's basename. Basename, never the full
; path: argv spells absolute workdirs, and those must not leak into
; binaries (or traces) - the name only locates the file for a human
; holding the source, and the line and column do the pointing. The
; text is still read through the full path, so the name and the
; lines cannot disagree about which file they mean.
(pub :: markPath (-> String CG String))
;@axiom:effect(io)
(pub fn (markPath modname cg)
  (if (== (strLen modname) 0)
    (baseName (entryInputPath))
    (baseName (moduleSrcPath modname (cgTarget cg) (pathDir (entryInputPath))))))

; Everything after the last separator, or the whole string when there
; is none: `pathBase`, which knows `\` where the platform does.
(pub :: baseName (-> String String))
(pub fn (baseName p)
  (pathBase p))

; The text behind a marker: the entry input, or the module search's
; winner. "" when neither can be read.
(pub :: markText (-> String CG String))
;@axiom:effect(io)
(pub fn (markText modname cg)
  (if (== (strLen modname) 0)
    {
      (let p (entryInputPath))
      (if (== (strLen p) 0)
        ""
        (unwrapOr (readFile p) ""))
    }
    (readModuleSrcOr modname (cgTarget cg) (pathDir (entryInputPath)) "")))

; First-sight index of a path in `files`, appending. Linear, like
; `findString` beside it: tables here are tens of rows, and an index
; structure would out-cost what it indexes.
(pub :: fileIndex (-> Strings String Int Int))
(pub fn (fileIndex files path i)
  (if (>= i (vecLen files))
    {
      (let n (vecLen files))
      {
        (vecPush files path)
        n
      }
    }
    (if (strEq (vecGet files i) path)
      i
      (fileIndex files path (+ i 1)))))

(pub :: lineRowStr (-> Int String Int Int String))
(pub fn (lineRowStr fi path line col)
  {
    (let a (concat "  i64 ptrtoint (ptr @__axiom_filen_" (fmtInt fi)))
    {
      (let b (concat a " to i64), i64 "))
      {
        (let c (concat b (fmtInt (strLen path))))
        {
          (let d (concat c ", i64 "))
          {
            (let e (concat d (fmtInt line)))
            {
              (let f (concat e ", i64 "))
              (concat f (fmtInt col))
            }
          }
        }
      }
    }
  })

; Filename globals, the meta table, the address array, the count,
; and the initialiser that resolves the addresses at startup. The
; addresses cannot live in the table as link-time constants: an
; intra-function address has no relocation kind that survives into
; linked data on every target (measured: all zeros in the linked
; binary on darwin-aarch64), while the same `blockaddress` as a code
; operand assembles to PC-relative arithmetic everywhere. So the
; table holds what links (file, line, column) and `@__axiom_lineinit`
; fills what only runs (addresses), called once at the top of the
; backtrace - idempotent stores, so a second trap mid-trace cannot
; corrupt them, and fork inherits them filled. With no rows the
; arrays are the same one-element placeholders the symbol table
; uses, and the initialiser is a bare `ret`.
(pub :: emitLineTableGlobals (-> Strings Strings Strings Strings Int CG CG))
(pub fn (emitLineTableGlobals rows files addrFns addrLbls n cg)
  {
    (emitFilenGlobals files 0 cg)
    (if (== n 0)
      {
        (emitLine cg "@__axiom_linetab = internal constant [4 x i64] zeroinitializer")
        (emitLine cg "@__axiom_lineaddrs = internal global [1 x i64] zeroinitializer")
        (emitLine cg "@__axiom_linetab_n = internal constant i64 0")
        (emitLineInit addrFns addrLbls 0 n cg)
        cg
      }
      {
        (emitLine cg
          (concat "@__axiom_linetab = internal constant [" (concat (fmtInt (* 4 n)) " x i64] [")))
        (emitLineRows rows 0 n cg)
        (emitLine cg "]")
        (emitLine cg
          (concat "@__axiom_lineaddrs = internal global ["
            (concat (fmtInt n) " x i64] zeroinitializer")))
        (emitLine cg (concat "@__axiom_linetab_n = internal constant i64 " (concat (fmtInt n) "")))
        (emitLineInit addrFns addrLbls 0 n cg)
        cg
      })
  })

; One store per row: the link-time address of the row's block into
; the row's slot. Straight-line stores, no loop (a loop would need
; its bound and step in registers the emitter would then have to
; keep alive across nothing - unrolled text is what this emitter
; does everywhere else).
(pub :: emitLineInit (-> Strings Strings Int Int CG CG))
(pub fn (emitLineInit addrFns addrLbls i n cg)
  {
    (if (== i 0)
      {
        (emitLine cg "define internal i64 @__axiom_lineinit() #0 {")
        cg
      }
      cg)
    (if (>= i n)
      {
        (emitLine cg "  ret i64 0")
        (emitLine cg "}")
        (emitLine cg "")
        cg
      }
      {
        (emitLine cg (lineInitStore (vecGet addrFns i) (vecGet addrLbls i) i n))
        (emitLineInit addrFns addrLbls (+ i 1) n cg)
      })
  })

(pub :: lineInitStore (-> String String Int Int String))
(pub fn (lineInitStore func lbl i n)
  {
    (let a (concat "  store i64 ptrtoint (ptr blockaddress(" func))
    {
      (let b (concat a ", %"))
      {
        (let c (concat b lbl))
        {
          (let d (concat c ") to i64), ptr getelementptr (["))
          {
            (let e (concat d (fmtInt n)))
            {
              (let f (concat e " x i64], ptr @__axiom_lineaddrs, i64 0, i64 "))
              {
                (let g (concat f (fmtInt i)))
                (concat g ")")
              }
            }
          }
        }
      }
    }
  })

(pub :: emitFilenGlobals (-> Strings Int CG CG))
(pub fn (emitFilenGlobals files i cg)
  (if (>= i (vecLen files))
    cg
    {
      (let p (vecGet files i))
      {
        (let head (concat "@__axiom_filen_" (fmtInt i)))
        {
          (let sized
            (concat head (concat " = private unnamed_addr constant [" (fmtInt (strLen p)))))
          {
            (let open (concat sized " x i8] c\""))
            {
              (let body (concat open (llvmBytes p)))
              {
                (emitLine cg (concat body "\""))
                (emitFilenGlobals files (+ i 1) cg)
              }
            }
          }
        }
      }
    }))

(pub :: emitLineRows (-> Strings Int Int CG CG))
(pub fn (emitLineRows rows i n cg)
  (if (>= i n)
    cg
    {
      (emitLine cg
        (concat (vecGet rows i)
          (if (< (+ i 1) n)
            ","
            "")))
      (emitLineRows rows (+ i 1) n cg)
    }))

; One `write(2, ptr, len)` through the same door the three traps use.
(pub :: emitBtWrite (-> CG String String CG))
(pub fn (emitBtWrite cg ptrExpr lenExpr)
  (emitRuntimeWrite cg ptrExpr lenExpr))

; The name of one return address: the entry with the greatest address
; at or below it.
;
; WHY "GREATEST AT OR BELOW" IS THE RIGHT LOOKUP, and what it depends
; on. A return address points just PAST the call, so it is an interior
; address of the caller, not its entry. The nearest preceding entry
; therefore names the right function exactly when every function
; between them is in the table - which is why `symtabNames` reads the
; buffer rather than the declaration list. Addresses outside this
; module's functions - a libc start frame above `main` - resolve to
; whichever of ours happens to precede them, so the walker stops at
; `main` rather than trusting the answer past it.
(pub :: emitBtName (-> CG Int Int CG))
(pub fn (emitBtName cg n ln)
  {
    (let sz
      (fmtInt
        (if (== n 0)
          3
          (* 3 n))))
    {
      (let lsz
        (fmtInt
          (if (== ln 0)
            4
            (* 4 ln))))
      {
        (let asz
          (fmtInt
            (if (== ln 0)
              1
              ln)))
        {
          (emitLine cg "define internal i64 @__axiom_bt_name(i64 %ra) #0 {")
          (emitLine cg "entry:")
          ; THE RETURN ADDRESS IS NOT AN ADDRESS IN THE CALLER when the
          ; call is the caller's LAST instruction: it points at the first
          ; byte after it, which is the next function's entry. Measured
          ; 2026-08-24 at `--opt 1` on a five-deep chain, darwin-aarch64 -
          ; `main` ends `bl ___axiom_div_by_zero` at 0x528 and
          ; `_axiom_alloc` begins at 0x52c, so the frame that was `main`
          ; printed as `axiom_alloc`. Confidently wrong is the one output
          ; a backtrace must never produce, and it took a disassembly to
          ; see, because the name printed was a real function.
          ;
          ; Resolving `ra - 1` puts the lookup back inside the call
          ; instruction, which is inside the caller by construction. One
          ; subtraction, and it is why every unwinder does this.
          (emitLine cg "  %pc = sub i64 %ra, 1")
          (emitLine cg "  br label %scan")
          (emitLine cg "scan:")
          (emitLine cg "  %i = phi i64 [ 0, %entry ], [ %i1, %next ]")
          (emitLine cg "  %ba = phi i64 [ 0, %entry ], [ %ba1, %next ]")
          (emitLine cg "  %bn = phi i64 [ 0, %entry ], [ %bn1, %next ]")
          (emitLine cg "  %bl = phi i64 [ 0, %entry ], [ %bl1, %next ]")
          (emitLine cg (concat "  %fin = icmp uge i64 %i, " (concat (fmtInt n) "")))
          (emitLine cg "  br i1 %fin, label %emit, label %body")
          (emitLine cg "body:")
          (emitLine cg "  %i3 = mul i64 %i, 3")
          (emitLine cg
            (concat "  %pa = getelementptr ["
              (concat sz " x i64], ptr @__axiom_symtab, i64 0, i64 %i3")))
          (if (btRelative cg)
            {
              (emitLine cg "  %aoff = load i64, ptr %pa")
              (emitLine cg "  %symbase = ptrtoint ptr @__axiom_symtab to i64")
              (emitLine cg "  %a = add i64 %symbase, %aoff")
            }
            (emitLine cg "  %a = load i64, ptr %pa"))
          (emitLine cg "  %j1 = add i64 %i3, 1")
          (emitLine cg
            (concat "  %pn = getelementptr ["
              (concat sz " x i64], ptr @__axiom_symtab, i64 0, i64 %j1")))
          (if (btRelative cg)
            {
              (emitLine cg "  %nmoff = load i64, ptr %pn")
              (emitLine cg "  %nm = add i64 %symbase, %nmoff")
            }
            (emitLine cg "  %nm = load i64, ptr %pn"))
          (emitLine cg "  %j2 = add i64 %i3, 2")
          (emitLine cg
            (concat "  %pl = getelementptr ["
              (concat sz " x i64], ptr @__axiom_symtab, i64 0, i64 %j2")))
          (emitLine cg "  %ln = load i64, ptr %pl")
          (emitLine cg "  %le = icmp ule i64 %a, %pc")
          (emitLine cg "  %gt = icmp ugt i64 %a, %ba")
          (emitLine cg "  %take = and i1 %le, %gt")
          (emitLine cg "  br label %next")
          (emitLine cg "next:")
          (emitLine cg "  %ba1 = select i1 %take, i64 %a, i64 %ba")
          (emitLine cg "  %bn1 = select i1 %take, i64 %nm, i64 %bn")
          (emitLine cg "  %bl1 = select i1 %take, i64 %ln, i64 %bl")
          (emitLine cg "  %i1 = add i64 %i, 1")
          (emitLine cg "  br label %scan")
          (emitLine cg "emit:")
          ; Above-range stop intentionally absent: the table holds starts,
          ; not extents, so "past every start" also matches an address
          ; inside the last-laid-out function - and stopping there emptied
          ; real traces (measured: three silent frames for a trap in its
          ; last function). Foreign tails are still bounded by the `main`
          ; and thread-entry stops below, and by the walk's own guards; a
          ; sibling-jump edge at `--opt 1` and above can append one bare
          ; runtime frame past the highest genuine one, which the gate
          ; records rather than forbids. What this table never does is
          ; print a wrong line: rows resolve only inside their own
          ; function, and a frame with no row prints its bare name.
          (emitLine cg "  br label %hdr")
          (emitLine cg "hdr:")
          (emitLine cg "  %atp = ptrtoint ptr @__axiom_bt_at to i64")
          (emitBtWrite cg "%atp" "5")
          (emitLine cg "  %found = icmp ne i64 %bn, 0")
          (emitLine cg "  br i1 %found, label %named, label %unknown")
          (emitLine cg "named:")
          (emitBtWrite cg "%bn" "%bl")
          ; A located frame names its line: the linetab row with the
          ; greatest address the function starts at or before and the
          ; return address minus one reaches past - the same greatest-
          ; below rule as the symbol lookup, bounded below by the
          ; function the first scan named so rows of other functions can
          ; never win. Rows are 5 words: address, file pointer, file
          ; length, line, column. No row qualifies for a runtime-helper
          ; frame, an inlined-away call, or a `main` wrapper - those print
          ; the bare name, exactly as before.
          (emitLine cg "  br label %loc")
          (emitLine cg "loc:")
          (emitLine cg "  br label %lscan")
          (emitLine cg "lscan:")
          (emitLine cg "  %li = phi i64 [ 0, %loc ], [ %li1, %lnext ]")
          (emitLine cg "  %lba = phi i64 [ 0, %loc ], [ %lba1, %lnext ]")
          (emitLine cg "  %lfp = phi i64 [ 0, %loc ], [ %lfp1, %lnext ]")
          (emitLine cg "  %lfl = phi i64 [ 0, %loc ], [ %lfl1, %lnext ]")
          (emitLine cg "  %lln = phi i64 [ 0, %loc ], [ %lln1, %lnext ]")
          (emitLine cg "  %lco = phi i64 [ 0, %loc ], [ %lco1, %lnext ]")
          (emitLine cg "  %lok = phi i64 [ 0, %loc ], [ %lok1, %lnext ]")
          (emitLine cg (concat "  %lfin = icmp uge i64 %li, " (concat (fmtInt ln) "")))
          (emitLine cg "  br i1 %lfin, label %locdone, label %lrow")
          (emitLine cg "lrow:")
          (emitLine cg
            (concat "  %lap = getelementptr ["
              (concat asz " x i64], ptr @__axiom_lineaddrs, i64 0, i64 %li")))
          (emitLine cg "  %lra = load i64, ptr %lap")
          (emitLine cg "  %li4 = mul i64 %li, 4")
          (emitLine cg
            (concat "  %lpf = getelementptr ["
              (concat lsz " x i64], ptr @__axiom_linetab, i64 0, i64 %li4")))
          (emitLine cg "  %lfpv = load i64, ptr %lpf")
          (emitLine cg "  %lj1 = add i64 %li4, 1")
          (emitLine cg
            (concat "  %lflp = getelementptr ["
              (concat lsz " x i64], ptr @__axiom_linetab, i64 0, i64 %lj1")))
          (emitLine cg "  %lflv = load i64, ptr %lflp")
          (emitLine cg "  %lj2 = add i64 %li4, 2")
          (emitLine cg
            (concat "  %llnp = getelementptr ["
              (concat lsz " x i64], ptr @__axiom_linetab, i64 0, i64 %lj2")))
          (emitLine cg "  %llnv = load i64, ptr %llnp")
          (emitLine cg "  %lj3 = add i64 %li4, 3")
          (emitLine cg
            (concat "  %lcop = getelementptr ["
              (concat lsz " x i64], ptr @__axiom_linetab, i64 0, i64 %lj3")))
          (emitLine cg "  %lcov = load i64, ptr %lcop")
          (emitLine cg "  %infn = icmp uge i64 %lra, %ba")
          (emitLine cg "  %inpc = icmp ule i64 %lra, %pc")
          (emitLine cg "  %inr = and i1 %infn, %inpc")
          (emitLine cg "  %better = icmp ugt i64 %lra, %lba")
          (emitLine cg "  %ltake = and i1 %inr, %better")
          (emitLine cg "  br label %lnext")
          (emitLine cg "lnext:")
          (emitLine cg "  %lba1 = select i1 %ltake, i64 %lra, i64 %lba")
          (emitLine cg "  %lfp1 = select i1 %ltake, i64 %lfpv, i64 %lfp")
          (emitLine cg "  %lfl1 = select i1 %ltake, i64 %lflv, i64 %lfl")
          (emitLine cg "  %lln1 = select i1 %ltake, i64 %llnv, i64 %lln")
          (emitLine cg "  %lco1 = select i1 %ltake, i64 %lcov, i64 %lco")
          (emitLine cg "  %lok1 = select i1 %ltake, i64 1, i64 %lok")
          (emitLine cg "  %li1 = add i64 %li, 1")
          (emitLine cg "  br label %lscan")
          (emitLine cg "locdone:")
          (emitLine cg "  %lgo = icmp ne i64 %lok, 0")
          (emitLine cg "  br i1 %lgo, label %locprint, label %eol")
          (emitLine cg "locprint:")
          (emitLine cg "  %spp = ptrtoint ptr @__axiom_bt_sp to i64")
          (emitBtWrite cg "%spp" "1")
          (emitBtWrite cg "%lfp" "%lfl")
          (emitLine cg "  %cop1 = ptrtoint ptr @__axiom_bt_colon to i64")
          (emitBtWrite cg "%cop1" "1")
          ; Decimal, twice, through one 24-byte scratch buffer: the first
          ; digit is unconditional so 0 prints "0", then each quotient
          ; prepends while non-zero. Inlined per value rather than called -
          ; a helper would be a new `define`, and the symbol-table
          ; completeness check counts those.
          (emitLine cg "  %ldp0 = ptrtoint ptr @__axiom_decbuf to i64")
          (emitLine cg "  %ldend = add i64 %ldp0, 24")
          (emitLine cg "  %lddq0 = udiv i64 %lln, 10")
          (emitLine cg "  %ldrem0 = urem i64 %lln, 10")
          (emitLine cg "  %lddig0 = add i64 %ldrem0, 48")
          (emitLine cg "  %ldd80 = trunc i64 %lddig0 to i8")
          (emitLine cg "  %ldp1 = sub i64 %ldend, 1")
          (emitLine cg "  %ldpp1 = inttoptr i64 %ldp1 to ptr")
          (emitLine cg "  store i8 %ldd80, ptr %ldpp1")
          (emitLine cg "  br label %ldloop")
          (emitLine cg "ldloop:")
          (emitLine cg "  %ldvv = phi i64 [ %lddq0, %locprint ], [ %lddq, %ldmore ]")
          (emitLine cg "  %ldpp = phi i64 [ %ldp1, %locprint ], [ %ldp2, %ldmore ]")
          (emitLine cg "  %ldgo = icmp ne i64 %ldvv, 0")
          (emitLine cg "  br i1 %ldgo, label %ldmore, label %lddone")
          (emitLine cg "ldmore:")
          (emitLine cg "  %lddq = udiv i64 %ldvv, 10")
          (emitLine cg "  %ldrem = urem i64 %ldvv, 10")
          (emitLine cg "  %lddig = add i64 %ldrem, 48")
          (emitLine cg "  %ldd82 = trunc i64 %lddig to i8")
          (emitLine cg "  %ldp2 = sub i64 %ldpp, 1")
          (emitLine cg "  %ldpp2 = inttoptr i64 %ldp2 to ptr")
          (emitLine cg "  store i8 %ldd82, ptr %ldpp2")
          (emitLine cg "  br label %ldloop")
          (emitLine cg "lddone:")
          (emitLine cg "  %ldlen = sub i64 %ldend, %ldpp")
          (emitBtWrite cg "%ldpp" "%ldlen")
          (emitLine cg "  br label %locprint2")
          (emitLine cg "locprint2:")
          (emitLine cg "  %cop2 = ptrtoint ptr @__axiom_bt_colon to i64")
          (emitBtWrite cg "%cop2" "1")
          (emitLine cg "  %cddq0 = udiv i64 %lco, 10")
          (emitLine cg "  %cdrem0 = urem i64 %lco, 10")
          (emitLine cg "  %cddig0 = add i64 %cdrem0, 48")
          (emitLine cg "  %cdd80 = trunc i64 %cddig0 to i8")
          (emitLine cg "  %cdp1 = sub i64 %ldend, 1")
          (emitLine cg "  %cdpp1 = inttoptr i64 %cdp1 to ptr")
          (emitLine cg "  store i8 %cdd80, ptr %cdpp1")
          (emitLine cg "  br label %cdloop")
          (emitLine cg "cdloop:")
          (emitLine cg "  %cdvv = phi i64 [ %cddq0, %locprint2 ], [ %cddq, %cdmore ]")
          (emitLine cg "  %cdpp = phi i64 [ %cdp1, %locprint2 ], [ %cdp2, %cdmore ]")
          (emitLine cg "  %cdgo = icmp ne i64 %cdvv, 0")
          (emitLine cg "  br i1 %cdgo, label %cdmore, label %cddone")
          (emitLine cg "cdmore:")
          (emitLine cg "  %cddq = udiv i64 %cdvv, 10")
          (emitLine cg "  %cdrem = urem i64 %cdvv, 10")
          (emitLine cg "  %cddig = add i64 %cdrem, 48")
          (emitLine cg "  %cdd82 = trunc i64 %cddig to i8")
          (emitLine cg "  %cdp2 = sub i64 %cdpp, 1")
          (emitLine cg "  %cdpp2 = inttoptr i64 %cdp2 to ptr")
          (emitLine cg "  store i8 %cdd82, ptr %cdpp2")
          (emitLine cg "  br label %cdloop")
          (emitLine cg "cddone:")
          (emitLine cg "  %cdlen = sub i64 %ldend, %cdpp")
          (emitBtWrite cg "%cdpp" "%cdlen")
          (emitLine cg "  br label %eol")
          ; An address no entry precedes. It cannot happen for a frame of
          ; this module's own code, and printing a plausible wrong name
          ; would be worse than printing nothing - the whole value of this
          ; output is that a reader can believe it.
          (emitLine cg "unknown:")
          (emitLine cg "  %unp = ptrtoint ptr @__axiom_bt_unk to i64")
          (emitBtWrite cg "%unp" "9")
          (emitLine cg "  br label %eol")
          (emitLine cg "eol:")
          (emitLine cg "  %nlp = ptrtoint ptr @__axiom_bt_nl to i64")
          (emitBtWrite cg "%nlp" "1")
          (emitLine cg "  ret i64 %ba")
          (emitLine cg "}")
          (emitLine cg "")
          cg
        }
      }
    }
  })

; The walk.
;
; THREE GUARDS, and each one is a way a corrupted stack ends this
; rather than a fault inside the handler for a fault. A null frame
; pointer ends it; a misaligned one ends it, because AArch64 faults on
; an unaligned load and a crash inside the backtracer would replace the
; message with nothing at all; and a next-frame pointer that does not
; move UP ends it, because the stack grows down and a chain that
; stopped ascending is a chain that is no longer a chain. The depth cap
; is the fourth: 64 frames is past anything this compiler's own
; `check-stack-depth.sh` measures, and a runaway loop printing forever
; would bury the message it exists to qualify.
(pub :: emitBtWalk (-> CG Names CG))
(pub fn (emitBtWalk cg names)
  (if (== (cgTarget cg) 6)
    (emitBtWalkCaptured cg names)
    (emitBtWalkFrames cg names)))

; `%ma`, the entry function's address the walk stops at: through the
; symbol table's base when the module is position-independent.
(pub :: emitBtMainAddr (-> CG Names CG))
(pub fn (emitBtMainAddr cg names)
  (if (&& (btRelative cg) (symtabHas names (targetEntryName (cgTarget cg)) 0))
    {
      (emitLine cg "  %maoff = load i64, ptr @__axiom_bt_mainaddr")
      (emitLine cg "  %mbase = ptrtoint ptr @__axiom_symtab to i64")
      (emitLine cg "  %ma = add i64 %mbase, %maoff")
    }
    (emitLine cg "  %ma = load i64, ptr @__axiom_bt_mainaddr")))

; windows-x86_64 keeps no frame-pointer chain to walk: llc sets rbp a
; fixed distance above rsp for SEH, under the registers it pushed, so
; `[rbp]` is a local and `[rbp+8]` a saved register, and the walk below
; read both as a frame and faulted after naming a wrong one
; (`tests/stdlib/314-out-of-memory.ax` exited 139 after its message on
; the Windows runner, run 39414173001). The system unwinder reads the
; `.pdata` llc emits for every function here, so this target asks it:
; `RtlCaptureStackBackTrace` fills up to sixty-four return addresses,
; skipping the frame that asked, and the loop names each with the same
; `__axiom_bt_name` and stops at the same entry function. `%fpi` is the
; array and `%lo` its count; `%hi` and `%pc` are unused, and the
; signature stays so the two walkers are one symbol. windows-aarch64
; keeps the chain (x29 points at the saved pair) and walks it.
(pub :: emitBtWalkCaptured (-> CG Names CG))
(pub fn (emitBtWalkCaptured cg names)
  {
    (emitLine cg "define internal void @__axiom_backtrace() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %buf = alloca [64 x i64], align 16")
    (emitLine cg "  %bufi = ptrtoint ptr %buf to i64")
    (emitLine cg "  %n0 = call i64 @RtlCaptureStackBackTrace(i64 1, i64 64, i64 %bufi, i64 0)")
    (emitLine cg "  %n = and i64 %n0, 65535")
    (emitLine cg "  notail call void @__axiom_backtrace_from(i64 %bufi, i64 %n, i64 0, i64 0)")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg
      "define internal void @__axiom_backtrace_from(i64 %fpi, i64 %lo, i64 %hi, i64 %pc) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %li0 = call i64 @__axiom_lineinit()")
    (emitLine cg "  %hp = ptrtoint ptr @__axiom_bt_hdr to i64")
    (emitBtWrite cg "%hp" "42")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %d = phi i64 [ 0, %entry ], [ %d1, %frame ]")
    (emitLine cg "  %deep = icmp uge i64 %d, %lo")
    (emitLine cg "  br i1 %deep, label %done, label %read")
    (emitLine cg "read:")
    (emitLine cg "  %off = mul i64 %d, 8")
    (emitLine cg "  %raa = add i64 %fpi, %off")
    (emitLine cg "  %rap = inttoptr i64 %raa to ptr")
    (emitLine cg "  %ra = load i64, ptr %rap")
    (emitLine cg "  %raz = icmp eq i64 %ra, 0")
    (emitLine cg "  br i1 %raz, label %done, label %frame")
    (emitLine cg "frame:")
    (emitLine cg "  %at = call i64 @__axiom_bt_name(i64 %ra)")
    (emitBtMainAddr cg names)
    (emitLine cg "  %ismain = icmp eq i64 %at, %ma")
    (emitLine cg "  %ismain0 = xor i1 %ismain, true")
    (emitLine cg "  %d1 = add i64 %d, 1")
    (if (&& (cgThreads cg) (symtabHas names "__axiom_par_entry" 0))
      {
        (emitLine cg "  %pe = ptrtoint ptr @__axiom_par_entry to i64")
        (emitLine cg "  %isentry = icmp eq i64 %at, %pe")
        (emitLine cg "  %isentry0 = xor i1 %isentry, true")
        (emitLine cg "  %go = and i1 %ismain0, %isentry0")
        (emitLine cg "  br i1 %go, label %loop, label %done")
      }
      (emitLine cg "  br i1 %ismain0, label %loop, label %done"))
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

(pub :: emitBtWalkFrames (-> CG Names CG))
(pub fn (emitBtWalkFrames cg names)
  {
    (emitLine cg "define internal void @__axiom_backtrace() #0 {")
    (emitLine cg "entry:")
    (emitLine cg
      (concat "  %fpi = call i64 asm sideeffect " (concat (targetFrameAsm (cgTarget cg)) "()")))
    (emitLine cg "  notail call void @__axiom_backtrace_from(i64 %fpi, i64 0, i64 -1, i64 0)")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg
      "define internal void @__axiom_backtrace_from(i64 %fpi, i64 %lo, i64 %hi, i64 %pc) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %li0 = call i64 @__axiom_lineinit()")
    (emitLine cg "  %hp = ptrtoint ptr @__axiom_bt_hdr to i64")
    (emitBtWrite cg "%hp" "42")
    (emitLine cg "  %havepc = icmp ne i64 %pc, 0")
    (emitLine cg "  br i1 %havepc, label %faultpc, label %walkstart")
    (emitLine cg "faultpc:")
    (emitLine cg "  %faultname = call i64 @__axiom_bt_name(i64 %pc)")
    (emitLine cg "  br label %walkstart")
    (emitLine cg "walkstart:")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %fp = phi i64 [ %fpi, %walkstart ], [ %nx, %frame ]")
    (emitLine cg "  %d = phi i64 [ 0, %walkstart ], [ %d1, %frame ]")
    (emitLine cg "  %deep = icmp uge i64 %d, 64")
    (emitLine cg "  %fpz = icmp eq i64 %fp, 0")
    (emitLine cg "  %mis = and i64 %fp, 7")
    (emitLine cg "  %misb = icmp ne i64 %mis, 0")
    (emitLine cg "  %s0 = or i1 %deep, %fpz")
    (emitLine cg "  %badframe = or i1 %s0, %misb")
    (emitLine cg "  %lastword = sub i64 %hi, 16")
    (emitLine cg "  %below = icmp ult i64 %fp, %lo")
    (emitLine cg "  %above = icmp ugt i64 %fp, %lastword")
    (emitLine cg "  %outside = or i1 %below, %above")
    (emitLine cg "  %stop = or i1 %badframe, %outside")
    (emitLine cg "  br i1 %stop, label %done, label %read")
    (emitLine cg "read:")
    (emitLine cg "  %fpp = inttoptr i64 %fp to ptr")
    (emitLine cg "  %nx = load i64, ptr %fpp")
    (emitLine cg "  %raa = add i64 %fp, 8")
    (emitLine cg "  %rap = inttoptr i64 %raa to ptr")
    (emitLine cg "  %ra = load i64, ptr %rap")
    (emitLine cg "  %raz = icmp eq i64 %ra, 0")
    (emitLine cg "  br i1 %raz, label %done, label %frame")
    (emitLine cg "frame:")
    (emitLine cg "  %at = call i64 @__axiom_bt_name(i64 %ra)")
    ; STOP AT `main`. Above it the frames belong to the C runtime that
    ; called it, and this module's table has no entry for any of them -
    ; so the lookup would answer with whichever of OUR functions
    ; happens to lie below a libc address, which is a wrong name
    ; printed with the same confidence as a right one. Measured at
    ; `--opt 0` before this existed: a trailing `at __axiom_user_main`
    ; under `at main`, naming a frame that is not on the stack.
    (emitBtMainAddr cg names)
    (emitLine cg "  %ismain = icmp eq i64 %at, %ma")
    (emitLine cg "  %ismain0 = xor i1 %ismain, true")
    (emitLine cg "  %d1 = add i64 %d, 1")
    (emitLine cg "  %up = icmp ugt i64 %nx, %fp")
    ; AND STOP AT THE THREAD'S ENTRY, which is the same rule on a stack
    ; that has no `main` on it at all. A trap inside a `parallel`
    ; binding under `--threads` runs on a pthread stack whose oldest
    ; frame of OURS is `@__axiom_par_entry`; above it are libSystem's
    ; `_pthread_start` frames, which this module's table cannot name -
    ; so the `main` guard, the one thing that stops the walk, can never
    ; fire and the walk names libc addresses with our symbols. Measured
    ; on `tests/stdlib/471-parallel-trap.ax` built `--threads`,
    ; 2026-09-04, before this line existed:
    ;
    ;     at __axiom_index_out_of_range
    ;     at _lam_0
    ;     at __axiom_par_entry
    ;     at __axiom_out_of_memory      <- libSystem, named as ours
    ;     at __axiom_out_of_memory      <- libSystem, named as ours
    ;
    ; Two frames that are not on the stack, printed with the same
    ; confidence as the three that are - the one output `emitBtName`'s
    ; header says a backtrace must never produce.
    ;
    ; Stop at a thread entry only when that entry survived pruning.
    ; `cgThreads` also sees unreachable source functions, whose thread
    ; runtime can be removed before this late backtrace emission.
    (if (&& (cgThreads cg) (symtabHas names "__axiom_par_entry" 0))
      {
        (emitLine cg "  %pe = ptrtoint ptr @__axiom_par_entry to i64")
        (emitLine cg "  %isentry = icmp eq i64 %at, %pe")
        (emitLine cg "  %isentry0 = xor i1 %isentry, true")
        (emitLine cg "  %inside = and i1 %ismain0, %isentry0")
        (emitLine cg "  %go = and i1 %up, %inside")
      }
      (emitLine cg "  %go = and i1 %up, %ismain0"))
    (emitLine cg "  br i1 %go, label %loop, label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; The three constants the walker writes, the intrinsic it reads the
; frame pointer with, and both functions - emitted at the module tail,
; where every `define` has already been written and the table can
; therefore be complete.
;
; THE FRAME POINTER IS READ WITH INLINE ASM, NOT `llvm.frameaddress`,
; and the reason is a real refusal rather than a preference. The
; intrinsic version was written first and `axiom build` refused it:
;
;   error[AX4004]: no archive is linked, and `llvm.frameaddress.p0`
;                  needs one
;
; The driver treats every `declare` in the emitted module as a symbol
; some archive must define (`check-ffi.sh` prices exactly that
; boundary), and an LLVM intrinsic is not an archive symbol - so the
; choice was to widen that link policy for a `llvm.`-prefixed name, or
; to not emit a `declare` at all. Widening the one check that says
; which external symbols a program may name, to make a backtrace
; prettier, is the wrong trade. `targetFrameAsm` is one instruction per
; architecture and declares nothing.
(pub :: emitBacktrace (-> CG Names CG))
;@axiom:effect(io)
(pub fn (emitBacktrace cg names)
  (if (== (cgObfuscate cg) 1)
    {
      (emitLine cg "define internal void @__axiom_backtrace() #0 { ret void }")
      cg
    }
    {
      (emitSymbolTable cg names)
      (emitBacktraceTables cg names (vecLen names))
    }))

; The tables' remainder, split out so the skeleton above stays
; readable: constants, the walker with both counts, and the walk.
(pub :: emitBacktraceTables (-> CG Names Int CG))
;@axiom:effect(io)
(pub fn (emitBacktraceTables cg names n)
  {
    (let ln (emitLineTable cg))
    {
      (emitLine cg
        "@__axiom_bt_hdr = private unnamed_addr constant [42 x i8] c\"axiom: backtrace (most recent call first)\\0A\"")
      (emitLine cg "@__axiom_bt_at = private unnamed_addr constant [5 x i8] c\"  at \"")
      (emitLine cg "@__axiom_bt_sp = private unnamed_addr constant [1 x i8] c\" \"")
      (emitLine cg "@__axiom_bt_colon = private unnamed_addr constant [1 x i8] c\":\"")
      (emitLine cg "@__axiom_bt_nl = private unnamed_addr constant [1 x i8] c\"\\0A\"")
      (emitLine cg "@__axiom_bt_unk = private unnamed_addr constant [9 x i8] c\"<unknown>\"")
      (emitLine cg "@__axiom_decbuf = internal global [24 x i8] zeroinitializer")
      ; `-1` when there is no `main` - an archive built with
      ; `--emit-staticlib` has none, and `emitAllocator` skips the
      ; wrapper for exactly that case. No function can be at address -1,
      ; so the comparison simply never matches and the walk ends on its
      ; other guards instead.
      ; `main`, or `mainCRTStartup` on Windows: `targetEntryName` is the
      ; one place the spelling lives.
      (emitLine cg
        (if (symtabHas names (targetEntryName (cgTarget cg)) 0)
          (concat "@__axiom_bt_mainaddr = internal constant i64 "
            (concat (btStoredAddress cg (targetEntryName (cgTarget cg))) (btTableSection cg)))
          "@__axiom_bt_mainaddr = internal constant i64 -1"))
      (emitLine cg "")
      (emitBtName cg n ln)
      (emitBtWalk cg names)
      cg
    }
  })

;@axiom:effect(io)
(pub fn (emitArenaHelpers cg)
  {
    (emitLine cg "define internal i64 @__axiom_arena_mark_fn() #0 {")
    (emitLine cg "entry:")
    ; With the owner registry on, a mark is four words: the fourth is
    ; the registry's counter, so the reset knows which owners are newer
    ; (`emitResourceRegistry`).
    (emitLine cg
      (if (|| (== (resRegistryOn cg) 1) (reserveSupported cg))
        "  %cell = call i64 @axiom_alloc(i64 32)"
        "  %cell = call i64 @axiom_alloc(i64 24)"))
    (emitLine cg "  %mark = call i64 @.axiom.arena.mark.into(i64 %cell)")
    (emitLine cg "  ret i64 %mark")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "define internal i64 @.axiom.arena.mark.into(i64 %cell) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %bump = load i64, ptr @__axiom_bump")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %chunk = load i64, ptr @__axiom_chunk")
    (emitLine cg "  %p0 = inttoptr i64 %cell to ptr")
    (emitLine cg "  store i64 %bump, ptr %p0")
    (emitLine cg "  %a1 = add i64 %cell, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  store i64 %end, ptr %p1")
    (emitLine cg "  %a2 = add i64 %cell, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  store i64 %chunk, ptr %p2")
    (if (== (resRegistryOn cg) 1)
      {
        (emitLine cg "  %rseq = load i64, ptr @__axiom_res_seq")
        (emitLine cg "  %a3 = add i64 %cell, 24")
        (emitLine cg "  %p3 = inttoptr i64 %a3 to ptr")
        (emitLine cg "  store i64 %rseq, ptr %p3")
      })
    (if (reserveSupported cg)
      {
        (emitLine cg (concat "  %vseq = load i64, ptr " (reserveSeqName cg)))
        (emitLine cg "  %va3 = add i64 %cell, 24")
        (emitLine cg "  %vp3 = inttoptr i64 %va3 to ptr")
        (emitLine cg "  store i64 %vseq, ptr %vp3")
      })
    (emitLine cg "  ret i64 %cell")
    (emitLine cg "}")
    (emitLine cg "")
    (if (reserveSupported cg)
      {
        (emitLine cg "define internal i64 @__axiom_arena_reset_fn(i64 %cell) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %r = call i64 @__axiom_arena_reset_impl(i64 %cell, i64 0)")
        (emitLine cg "  ret i64 %r")
        (emitLine cg "}")
        (emitLine cg "define internal i64 @__axiom_arena_reset_impl(i64 %cell, i64 %keep) #0 {")
      }
      (emitLine cg "define internal i64 @__axiom_arena_reset_fn(i64 %cell) #0 {"))
    (emitLine cg "entry:")
    ; Owners made since the mark are cleaned up first, while every byte
    ; their callbacks read is still theirs (`emitResourceRegistry`).
    (if (== (resRegistryOn cg) 1)
      {
        (emitLine cg "  %ra3 = add i64 %cell, 24")
        (emitLine cg "  %rp3 = inttoptr i64 %ra3 to ptr")
        (emitLine cg "  %rfloor = load i64, ptr %rp3")
        (emitLine cg "  call void @__axiom_resource_unwind(i64 %rfloor)")
      })
    ; A release-to-zero FILES its block on @__axiom_slabs; a reset
    ; rewinds the bump beneath those heads, and a dangling head
    ; double-issues storage on the next same-class allocation. The
    ; ownership events made compiler-emitted releases real, so every
    ; reset scrubs the slab heads first - 4143 stores across both class families
    ; ceiling moved to 64 KiB, the price of composing §3.3 with
    ; counting at all (the review's judge found this by composing
    ; three lenses' half-facts; none saw it alone).
    (emitLine cg "  br label %slabclear")
    (emitLine cg "slabclear:")
    (emitLine cg "  %si = phi i64 [ 0, %entry ], [ %si1, %slabclear ]")
    (emitLine cg "  %sp = getelementptr [4143 x i64], ptr @__axiom_slabs, i64 0, i64 %si")
    (emitLine cg "  store i64 0, ptr %sp")
    (emitLine cg "  %si1 = add i64 %si, 1")
    (emitLine cg "  %sdone = icmp eq i64 %si1, 4143")
    (emitLine cg "  br i1 %sdone, label %resetbody, label %slabclear")
    (emitLine cg "resetbody:")
    (emitLine cg "  %p0 = inttoptr i64 %cell to ptr")
    (emitLine cg "  %sbump = load i64, ptr %p0")
    (emitLine cg "  %a1 = add i64 %cell, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %send = load i64, ptr %p1")
    (emitLine cg "  %a2 = add i64 %cell, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  %schunk = load i64, ptr %p2")
    ; MM-ALLOC-16b, ENFORCED. Everything from the restored waterline to
    ; the end of the marked chunk is about to be reclaimed; if a live
    ; handle's evidence record is in there, the next operation would
    ; dispatch through freed memory. This covers the `%same` fast path
    ; and the unwind path alike, because the marked chunk is reclaimed
    ; above `%sbump` either way; the chunks the walk FREES are checked
    ; in `unwind_body` below, where their extents are known.
    ;
    ; EMITTED ONLY WHEN THE PROGRAM DECLARES AN EFFECT. `emitEvCheck`
    ; answers `cg` unchanged at zero slots and these lines are not
    ; written, so a program with no `(effect ...)` - which is every
    ; program in `core/`, measured - emits the reset helper it
    ; emitted before this rule existed, byte for byte.
    (emitEvCall cg "%sbump" "%send")
    (emitLine cg "  %chead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  %same = icmp eq i64 %chead, %schunk")
    (emitLine cg "  br i1 %same, label %restore, label %unwind")
    ; Every chunk between the head and the marked one is wholly garbage
    ; now, so it goes back on the free list. The marked chunk is then
    ; dirty from the restored waterline to its end - it was abandoned
    ; because it filled up - and saying so is one store.
    ;
    ; MM-ALLOC-16a, ENFORCED. The walk has two ways to stop and they
    ; mean opposite things. `%reached` is the marked chunk still being
    ; on the active list, which is the whole point of the walk.
    ; `%ranout` is falling off the end of that list WITHOUT finding it -
    ; the mark's chunk was already returned to the free list by an
    ; outer reset, so the saved bump/end/chunk triple describes memory
    ; the allocator no longer owns.
    ;
    ; Until 2026-08-31 both merged into one `%stop` and both fell
    ; through to `tail`/`restore`, which restored that stale triple
    ; unconditionally. Measured on this build before the split, with
    ; the shape `MM-ALLOC-16a` names - mark outer, allocate past a
    ; chunk boundary, mark inner, reset outer, reset inner:
    ;
    ;     111
    ;     987654321
    ;     exit 0
    ;
    ; - a program that read and wrote a chunk this very call had just
    ; pushed onto the free list, and said nothing. The specification
    ; said "the implementation does not trap, and a conforming
    ; implementation SHOULD". It does now, and the SHOULD is a MUST.
    ;
    ; The two comparisons are the same two; only the merge is gone, so
    ; the loop's per-iteration work does not grow. What this DOES NOT
    ; catch is resetting the same mark twice: after the first reset
    ; `@__axiom_chunk` IS `%schunk`, so `%same` takes the fast path
    ; above and the walk is never entered - which is the documented
    ; design (the mark cell sits below its own waterline precisely so
    ; that a mark can be reset twice), not an escape.
    ; `tests/stdlib/166-arena-bad-mark.ax` pins both halves.
    (emitLine cg "unwind:")
    (emitLine cg "  %c = phi i64 [ %chead, %resetbody ], [ %cnext, %unwind_body ]")
    (emitLine cg "  %reached = icmp eq i64 %c, %schunk")
    (emitLine cg "  br i1 %reached, label %tail, label %unwind_live")
    (emitLine cg "unwind_live:")
    (emitLine cg "  %ranout = icmp eq i64 %c, 0")
    (emitLine cg "  br i1 %ranout, label %badmark, label %unwind_body")
    (emitLine cg "badmark:")
    (emitLine cg "  call i64 @__axiom_bad_mark()")
    (emitLine cg "  unreachable")
    (emitLine cg "unwind_body:")
    ; This chunk is about to go on the free list, so its whole extent is
    ; reclaimed. Word 0 of a chunk is its total size (see the header
    ; comment on `@__axiom_chunk`), so the extent is [%c, %c + size).
    ; The walk already visits exactly the chunks being reclaimed, so
    ; the sound version costs one more load on a path that is already
    ; O(chunks) - no second traversal.
    (emitEvChunkCall cg)
    (emitLine cg "  %clink = add i64 %c, 8")
    (emitLine cg "  %clinkp = inttoptr i64 %clink to ptr")
    (emitLine cg "  %cnext = load i64, ptr %clinkp")
    (emitLine cg "  %fhead = load i64, ptr @__axiom_free")
    (emitLine cg "  store i64 %fhead, ptr %clinkp")
    (emitLine cg "  store i64 %c, ptr @__axiom_free")
    (emitLine cg "  br label %unwind")
    (emitLine cg "tail:")
    (emitLine cg "  store i64 %send, ptr @__axiom_high")
    (emitLine cg "  br label %restore")
    (emitLine cg "restore:")
    (emitLine cg "  store i64 %sbump, ptr @__axiom_bump")
    (emitLine cg "  store i64 %send, ptr @__axiom_bump_end")
    (emitLine cg "  store i64 %schunk, ptr @__axiom_chunk")
    (if (reserveSupported cg)
      {
        (emitLine cg "  %va3 = add i64 %cell, 24")
        (emitLine cg "  %vp3 = inttoptr i64 %va3 to ptr")
        (emitLine cg "  %vfloor = load i64, ptr %vp3")
        (emitLine cg "  call void @__axiom_reserved_reset(i64 %vfloor, i64 %keep)")
      })
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "")
    (emitArenaKeepHelper cg)
    (emitMemStatFn cg)
    (emitArenaCapRuntime cg)
    (emitStackRunRuntime cg)
    cg
  })

; ------------------------------------------------------------------
; THE ARENA CAP (docs/memory-model.md MM-PAR-17). `(__axiom_arena_cap n)`
; sets the most bytes the calling arena may have mapped - MM-ALLOC-24's
; count 2, active and free chunks together - and answers the cap it
; replaces; 0 is no cap. The allocator asks before it maps a FRESH
; chunk, on both of its mapping paths (`refill:`'s `map:` and the keep
; helper's `fresh:`): a mapping that would take the count past the cap
; is refused as an out-of-memory trap, status 70 with a sentence of its
; own, recoverable as the mapping refusal is. A chunk reused from the
; free list maps nothing and is never refused.
;
; ONLY A MODULE THAT NAMES THE PRIMITIVE PAYS FOR IT (slot 22,
; `parScan`): every other module's allocator is byte for byte what it
; was, with no global, no call and no branch. The cap is a mutable
; runtime global (`cgMutGlobal`), so under `--threads` it is per
; thread, as the arena it caps is; a forked child inherits its
; parent's, which `stdlib/Task.ax` sets in the child before the task
; runs. The count is walked, not kept: the walk runs once per fresh
; chunk (a megabyte), only while a cap is set.
(pub :: arenaCapOn (-> CG Bool))
(pub fn (arenaCapOn cg)
  (== (cgArenaCap cg) 1))

(pub :: emitArenaCapCheck (-> CG String CG))
(pub fn (emitArenaCapCheck cg sizeExpr)
  (if (arenaCapOn cg)
    (emitLine cg (concat "  call void @__axiom_arena_cap_check(i64 " (concat sizeExpr ")")))
    cg))

(pub :: emitArenaCapRuntime (-> CG CG))
(pub fn (emitArenaCapRuntime cg)
  (if (arenaCapOn cg)
    {
      (let msg "axiom: out of memory (arena cap reached)")
      {
        (let n (fmtInt (+ (strLen msg) 1)))
        {
          (emitLine cg (concat "@__axiom_arena_cap = " (concat (cgMutGlobal cg) " i64 0")))
          (emitLine cg
            (concat "@__axiom_cap_msg = private unnamed_addr constant ["
              (concat n (concat " x i8] c\"" (concat msg "\\0A\"")))))
          (emitLine cg
            (concat "define internal i64 @__axiom_arena_capped() " (concat trapFnAttrs " {")))
          (emitLine cg "entry:")
          (emitLine cg "  call i64 @__axiom_recover_abort(i64 70)")
          (emitLine cg "  %capp = ptrtoint ptr @__axiom_cap_msg to i64")
          (emitRuntimeWrite cg "%capp" n)
          (emitLine cg "  call void @__axiom_backtrace()")
          (emitRuntimeExit cg "70")
          (emitLine cg "  unreachable")
          (emitLine cg "}")
          (emitLine cg "")
          (emitLine cg "define internal void @__axiom_arena_cap_check(i64 %want) #0 {")
          (emitLine cg "entry:")
          (emitLine cg "  %cap = load i64, ptr @__axiom_arena_cap")
          (emitLine cg "  %on = icmp ne i64 %cap, 0")
          (emitLine cg "  br i1 %on, label %count, label %fits")
          (emitLine cg "count:")
          (emitLine cg "  %mapped = call i64 @__axiom_mem_stat_fn(i64 2)")
          (emitLine cg "  %after = add i64 %mapped, %want")
          (emitLine cg "  %over = icmp ugt i64 %after, %cap")
          (emitLine cg "  br i1 %over, label %refuse, label %fits")
          (emitLine cg "refuse:")
          (emitLine cg "  call i64 @__axiom_arena_capped()")
          (emitLine cg "  unreachable")
          (emitLine cg "fits:")
          (emitLine cg "  ret void")
          (emitLine cg "}")
          (emitLine cg "")
          cg
        }
      }
    }
    cg))

; ------------------------------------------------------------------
; Guarded stacks (docs/memory-model.md MM-PAR-17, MM-EXEC-6d).
; Native POSIX executables enter main on a mapped stack, and each
; worker thread enters its closure on one. The usable size follows a
; finite RLIMIT_STACK, or defaults to 8 MiB, rounded up to 4 KiB.
; `(__axiom_stack_run bytes thunk arg)` uses the same runner with an
; explicit budget rounded up to 64 KiB. Each has a 64 KiB guard below.
;
; A guard fault traps 86. A 64 KiB alternate signal stack lets the
; handler report the interrupted PC and bounded frame chain without
; using the exhausted stack. Other faults retain their signal status.
; The handler never returns. Darwin enters through its signal
; trampoline; Linux x86-64 supplies its required restorer here.
;
; A recovery point belongs to the stack that armed it. The runner
; saves and clears the recovery chain before switching, then restores
; it on return. A stack-overflow trap inside the handler cannot recover.
; Mapping or signal-setup refusal traps 70 before the thunk runs.
;
; Native executable mode (slot 24) or the explicit primitive (slot 23)
; emits this runtime. The four globals are thread-local under threads.
; Worker exit disables and unmaps its alternate stack. Static archives
; borrow their host's stack. Windows calls the thunk on its existing
; stack, and bare metal has its own CPU-exception guard.
(pub :: stackRunOn (-> CG Bool))
(pub fn (stackRunOn cg)
  (|| (== (cgStackRun cg) 1) (programStackOn cg)))

; Native executables use the guarded runtime for their entry stack.
; An archive runs on its host's stack; bare metal has its own guard.
(:: programStackOn (-> CG Bool))
(fn (programStackOn cg)
  (== (cgNativeExe cg) 1))

; `mprotect`, `sigaltstack` and `sigaction` (`rt_sigaction` on Linux):
; darwin BSD 74, 53 and 46 with the class bit; linux-aarch64 226, 132
; and 134; linux-x86_64 10, 131 and 13; FreeBSD 74, 53 and 416. Read
; only where `targetHasSpawn` answers 1.
(pub :: targetMprotectNum (-> Int Int))
(pub fn (targetMprotectNum t)
  (if (|| (== t 0) (== t 1))
    33554506
    (if (== t 2)
      226
      (if (== t 3)
        10
        74))))

(pub :: targetSigAltStackNum (-> Int Int))
(pub fn (targetSigAltStackNum t)
  (if (|| (== t 0) (== t 1))
    33554485
    (if (== t 2)
      132
      (if (== t 3)
        131
        53))))

(pub :: targetSigActionNum (-> Int Int))
(pub fn (targetSigActionNum t)
  (if (|| (== t 0) (== t 1))
    33554478
    (if (== t 2)
      134
      (if (== t 3)
        13
        416))))

; SIGBUS is 7 on Linux and 10 on the BSDs; SIGSEGV is 11 on all three.
(pub :: targetSigBusNum (-> Int Int))
(pub fn (targetSigBusNum t)
  (if (|| (== t 2) (== t 3))
    7
    10))

; Word `k` of the action, with `h` the handler's address. Linux's
; `struct sigaction` is the handler, the flags, the restorer and the
; mask. Darwin's `struct __sigaction` is the handler, the trampoline,
; then the mask and the flags as two 32-bit words. FreeBSD's is the
; handler, then the flags and the first of the mask's four 32-bit
; words. The flags are SA_SIGINFO, SA_ONSTACK, SA_NODEFER and
; SA_RESETHAND, with SA_RESTORER on linux-x86_64: 0xC8000004 and
; 0xCC000004 on Linux, 0x55 on the BSDs, which on Darwin sits in the
; high half of word 2.
(pub :: stackActionWord (-> Int Int String String))
(pub fn (stackActionWord t k h)
  (if (|| (== t 2) (== t 3))
    (if (== k 0)
      h
      (if (== k 1)
        (if (== t 3)
          "3422552068"
          "3355443204")
        (if (&& (== k 2) (== t 3))
          h
          "0")))
    (if (|| (== t 0) (== t 1))
      (if (< k 2)
        h
        (if (== k 2)
          "365072220160"
          "0"))
      (if (== k 0)
        h
        (if (== k 1)
          "85"
          "0")))))

; Word `k` of the alternate stack's `stack_t`, `sp` its base: Linux's is
; the base, the flags and the size; the BSDs' the base, the size and
; the flags.
(pub :: stackAltWord (-> Int Int String String))
(pub fn (stackAltWord t k sp)
  (if (== k 0)
    sp
    (if (== k
          (if (|| (== t 2) (== t 3))
            2
            1))
      "65536"
      "0")))

; The switch. It keeps the stack pointer in a register the callee
; saves (x19, rbx), moves to `top`, calls `@__axiom_stack_call` with the
; thunk and its word in the first two argument registers, which the
; constraints tie to them, and moves back. Every other register a callee
; may overwrite is clobbered, as `targetRecoverArmAsm` accounts for
; them, x18 where it is allocatable; so is the keeping register, which
; the function saves in its prologue. The answer comes back in x0 or
; rax.
(pub :: targetStackSwitchAsm (-> Int String))
(pub fn (targetStackSwitchAsm t)
  (if (targetIsAArch64 t)
    (concat
      "{ i64, i64 } asm sideeffect \"mov x19, sp\\0Amov sp, $2\\0Ablr $3\\0Amov sp, x19\", \"={x0},={x1},r,r,0,1,~{x2},~{x3},~{x4},~{x5},~{x6},~{x7},~{x8},~{x9},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17}"
      (concat
        (if (|| (== t 2) (|| (== t 5) (== t 7)))
          ",~{x18}"
          "")
        ",~{x19},~{lr},~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v8},~{v9},~{v10},~{v11},~{v12},~{v13},~{v14},~{v15},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31},~{memory},~{cc}\""))
    "{ i64, i64, i64 } asm sideeffect \"movq %rsp, %rbx\\0Amovq $3, %rsp\\0Acallq *$4\\0Amovq %rbx, %rsp\", \"={rax},={rdi},={rsi},r,r,1,2,~{rbx},~{rcx},~{rdx},~{r8},~{r9},~{r10},~{r11},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{memory},~{dirflag},~{fpsr},~{flags}\""))

(pub :: emitStackRunRuntime (-> CG CG))
(pub fn (emitStackRunRuntime cg)
  (if (stackRunOn cg)
    {
      (emitLine cg "define internal i64 @__axiom_stack_call(i64 %fn, i64 %arg) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %recp = inttoptr i64 %fn to ptr")
      (emitLine cg "  %cp = load i64, ptr %recp")
      (emitLine cg "  %f = inttoptr i64 %cp to ptr")
      (emitLine cg "  %r = call i64 %f(i64 %fn, i64 %arg, i64 0)")
      (emitLine cg "  ret i64 %r")
      (emitLine cg "}")
      (emitLine cg "")
      (if (== (targetHasSpawn (cgTarget cg)) 1)
        {
          (emitStackRunGuarded cg (cgTarget cg))
          (emitStackDisarm cg (cgTarget cg))
          (if (programStackOn cg)
            (emitProgramStack cg))
          cg
        }
        {
          (emitLine cg "define internal i64 @__axiom_stack_run(i64 %bytes, i64 %fn, i64 %arg) #0 {")
          (emitLine cg "entry:")
          (emitLine cg "  %r = call i64 @__axiom_stack_call(i64 %fn, i64 %arg)")
          (emitLine cg "  ret i64 %r")
          (emitLine cg "}")
          (emitLine cg "")
        })
    }
    cg))

; A syscall line: `%dst = ` the call of `num` with six operands.
(pub :: emitStackSys (-> CG String Int String CG))
(pub fn (emitStackSys cg dst num rest)
  (emitLine cg (concat (concat "  " (concat dst " = ")) (parSys cg (fmtInt num) rest))))

(pub :: emitStackRunGuarded (-> CG Int CG))
(pub fn (emitStackRunGuarded cg t)
  {
    (let msg "axiom: stack overflow: the fault address is in the guard below a mapped stack")
    (let darwin (|| (== t 0) (== t 1)))
    (let flags (fmtInt (targetMapFlags t)))
    {
      (let n (fmtInt (+ (strLen msg) 1)))
      {
        (emitLine cg (concat "@__axiom_stack_lo = " (concat (cgMutGlobal cg) " i64 0")))
        (emitLine cg (concat "@__axiom_stack_hi = " (concat (cgMutGlobal cg) " i64 0")))
        (emitLine cg (concat "@__axiom_stack_alt = " (concat (cgMutGlobal cg) " i64 0")))
        (emitLine cg (concat "@__axiom_stack_top = " (concat (cgMutGlobal cg) " i64 0")))
        (emitLine cg
          (concat "@__axiom_stack_msg = private unnamed_addr constant ["
            (concat n (concat " x i8] c\"" (concat msg "\\0A\"")))))
        ; The handler. `info` is the siginfo, whose fault address is at
        ; byte 16 on Linux and byte 24 on the BSDs.
        (emitLine cg
          (if darwin
            "define internal void @__axiom_stack_fault(i64 %catcher, i64 %style, i64 %sig, i64 %info, i64 %uap) #0 {"
            "define internal void @__axiom_stack_fault(i64 %sig, i64 %info, i64 %uap) #0 {"))
        (emitLine cg "entry:")
        (emitLine cg "  %ip = inttoptr i64 %info to ptr")
        (emitLine cg
          (concat "  %ap = getelementptr i8, ptr %ip, i64 "
            (if (|| (== t 2) (== t 3))
              "16"
              "24")))
        (emitLine cg "  %addr = load i64, ptr %ap")
        (emitLine cg "  %lo = load i64, ptr @__axiom_stack_lo")
        (emitLine cg "  %hi = load i64, ptr @__axiom_stack_hi")
        (emitLine cg "  %ge = icmp uge i64 %addr, %lo")
        (emitLine cg "  %lt = icmp ult i64 %addr, %hi")
        (emitLine cg "  %in = and i1 %ge, %lt")
        (emitLine cg "  br i1 %in, label %over, label %other")
        (emitLine cg "over:")
        (emitLine cg "  %mp = ptrtoint ptr @__axiom_stack_msg to i64")
        (emitRuntimeWrite cg "%mp" n)
        (if (== (cgObfuscate cg) 0)
          (emitStackFaultTrace cg t))
        (emitRuntimeExit cg "86")
        (emitLine cg "  unreachable")
        (emitLine cg "other:")
        (emitStackSys cg "%pid" (targetGetPidNum t) "i64 0, i64 0, i64 0, i64 0, i64 0, i64 0")
        (emitStackSys cg "%k" (targetKillNum t) "i64 %pid, i64 %sig, i64 0, i64 0, i64 0, i64 0")
        (emitLine cg "  %st = add i64 %sig, 128")
        (emitRuntimeExit cg "%st")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        (emitLine cg "")
        ; Reuse the mapping, but re-arm kernel signal state after fork too.
        (emitLine cg "define internal void @__axiom_stack_arm() #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %ss = alloca [3 x i64], align 8")
        (emitLine cg "  %act = alloca [4 x i64], align 8")
        (emitLine cg "  %alt = load i64, ptr @__axiom_stack_alt")
        (emitLine cg "  %have = icmp ne i64 %alt, 0")
        (emitLine cg "  br i1 %have, label %install, label %map")
        (emitLine cg "map:")
        (emitStackSys cg "%mapped_alt" (targetMmapNum t)
          (concat "i64 0, i64 65536, i64 3, i64 " (concat flags ", i64 -1, i64 0")))
        (emitLine cg "  %al = icmp ult i64 %mapped_alt, 4096")
        (emitLine cg "  %an = icmp ugt i64 %mapped_alt, -4096")
        (emitLine cg "  %af = or i1 %al, %an")
        (emitLine cg "  br i1 %af, label %oom, label %install")
        (emitLine cg "oom:")
        (emitLine cg "  %o = call i64 @__axiom_out_of_memory()")
        (emitLine cg "  unreachable")
        (emitLine cg "install:")
        (emitLine cg "  %a = phi i64 [ %alt, %entry ], [ %mapped_alt, %map ]")
        (emitLine cg "  store i64 %a, ptr @__axiom_stack_alt")
        (emitLine cg (concat "  store i64 " (concat (stackAltWord t 0 "%a") ", ptr %ss")))
        (emitLine cg "  %s1 = getelementptr i64, ptr %ss, i64 1")
        (emitLine cg (concat "  store i64 " (concat (stackAltWord t 1 "%a") ", ptr %s1")))
        (emitLine cg "  %s2 = getelementptr i64, ptr %ss, i64 2")
        (emitLine cg (concat "  store i64 " (concat (stackAltWord t 2 "%a") ", ptr %s2")))
        (emitLine cg "  %ssw = ptrtoint ptr %ss to i64")
        (emitStackSys cg "%sa" (targetSigAltStackNum t)
          "i64 %ssw, i64 0, i64 0, i64 0, i64 0, i64 0")
        (emitLine cg "  %h = ptrtoint ptr @__axiom_stack_fault to i64")
        (emitLine cg (concat "  store i64 " (concat (stackActionWord t 0 "%h") ", ptr %act")))
        (emitLine cg "  %c1 = getelementptr i64, ptr %act, i64 1")
        (emitLine cg (concat "  store i64 " (concat (stackActionWord t 1 "%h") ", ptr %c1")))
        (emitLine cg "  %c2 = getelementptr i64, ptr %act, i64 2")
        (emitLine cg (concat "  store i64 " (concat (stackActionWord t 2 "%h") ", ptr %c2")))
        (emitLine cg "  %c3 = getelementptr i64, ptr %act, i64 3")
        (emitLine cg (concat "  store i64 " (concat (stackActionWord t 3 "%h") ", ptr %c3")))
        (emitLine cg "  %actw = ptrtoint ptr %act to i64")
        ; The fourth operand is `rt_sigaction`'s mask size; the BSDs
        ; read three.
        (emitStackSys cg "%segv" (targetSigActionNum t)
          "i64 11, i64 %actw, i64 0, i64 8, i64 0, i64 0")
        (emitStackSys cg "%bus" (targetSigActionNum t)
          (concat "i64 "
            (concat (fmtInt (targetSigBusNum t)) ", i64 %actw, i64 0, i64 8, i64 0, i64 0")))
        (emitLine cg "  %sabad = icmp ne i64 %sa, 0")
        (emitLine cg "  %svbad = icmp ne i64 %segv, 0")
        (emitLine cg "  %bubad = icmp ne i64 %bus, 0")
        (emitLine cg "  %sigbad0 = or i1 %sabad, %svbad")
        (emitLine cg "  %sigbad = or i1 %sigbad0, %bubad")
        (emitLine cg "  br i1 %sigbad, label %oom, label %done")
        (emitLine cg "done:")
        (emitLine cg "  ret void")
        (emitLine cg "}")
        ; The call: map, guard, arm, switch, and give it all back.
        (emitLine cg "define internal i64 @__axiom_stack_run(i64 %bytes, i64 %fn, i64 %arg) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %low = icmp slt i64 %bytes, 1")
        (emitLine cg "  %positive = select i1 %low, i64 1, i64 %bytes")
        (emitLine cg "  %big = icmp sgt i64 %positive, 70368744177664")
        (emitLine cg "  %bounded = select i1 %big, i64 70368744177664, i64 %positive")
        (emitLine cg "  %up = add i64 %bounded, 65535")
        (emitLine cg "  %rounded = and i64 %up, -65536")
        (emitLine cg "  %code = ptrtoint ptr @__axiom_stack_call to i64")
        (emitLine cg
          "  %r = call i64 @__axiom_stack_run_code(i64 %rounded, i64 %code, i64 %fn, i64 %arg)")
        (emitLine cg "  ret i64 %r")
        (emitLine cg "}")
        (emitLine cg
          "define internal i64 @__axiom_stack_run_code(i64 %bytes, i64 %code, i64 %fn, i64 %arg) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %small = icmp slt i64 %bytes, 1")
        (emitLine cg "  %b1 = select i1 %small, i64 1, i64 %bytes")
        (emitLine cg "  %huge = icmp sgt i64 %b1, 70368744177664")
        (emitLine cg "  %b2 = select i1 %huge, i64 70368744177664, i64 %b1")
        (emitLine cg "  %b3 = add i64 %b2, 4095")
        (emitLine cg "  %size = and i64 %b3, -4096")
        (emitLine cg "  %total = add i64 %size, 65536")
        (emitStackSys cg "%base" (targetMmapNum t)
          (concat "i64 0, i64 %total, i64 3, i64 " (concat flags ", i64 -1, i64 0")))
        (emitLine cg "  %bl = icmp ult i64 %base, 4096")
        (emitLine cg "  %bn = icmp ugt i64 %base, -4096")
        (emitLine cg "  %bf = or i1 %bl, %bn")
        (emitLine cg "  br i1 %bf, label %oom, label %mapped")
        (emitLine cg "oom:")
        (emitLine cg "  %o = call i64 @__axiom_out_of_memory()")
        (emitLine cg "  unreachable")
        (emitLine cg "mapped:")
        (emitStackSys cg "%g" (targetMprotectNum t)
          "i64 %base, i64 65536, i64 0, i64 0, i64 0, i64 0")
        (emitLine cg "  %gbad = icmp ne i64 %g, 0")
        (emitLine cg "  br i1 %gbad, label %unguarded, label %guarded")
        (emitLine cg "unguarded:")
        (emitStackSys cg "%u0" (targetMunmapNum t)
          "i64 %base, i64 %total, i64 0, i64 0, i64 0, i64 0")
        (emitLine cg "  %o2 = call i64 @__axiom_out_of_memory()")
        (emitLine cg "  unreachable")
        (emitLine cg "guarded:")
        (emitLine cg "  call void @__axiom_stack_arm()")
        (emitLine cg "  %olo = load i64, ptr @__axiom_stack_lo")
        (emitLine cg "  %ohi = load i64, ptr @__axiom_stack_hi")
        (emitLine cg "  %otop = load i64, ptr @__axiom_stack_top")
        (emitLine cg "  %orec = load i64, ptr @__axiom_recover_top")
        (emitLine cg "  store i64 %base, ptr @__axiom_stack_lo")
        (emitLine cg "  %ghi = add i64 %base, 65536")
        (emitLine cg "  store i64 %ghi, ptr @__axiom_stack_hi")
        (emitLine cg "  store i64 0, ptr @__axiom_recover_top")
        (emitLine cg "  %top = add i64 %base, %total")
        (emitLine cg "  store i64 %top, ptr @__axiom_stack_top")
        (emitLine cg "  %codeptr = inttoptr i64 %code to ptr")
        (emitLine cg
          (concat "  %rr = call "
            (concat (targetStackSwitchAsm t) "(i64 %top, ptr %codeptr, i64 %fn, i64 %arg)")))
        (emitLine cg
          (if (targetIsAArch64 t)
            "  %r = extractvalue { i64, i64 } %rr, 0"
            "  %r = extractvalue { i64, i64, i64 } %rr, 0"))
        (emitLine cg "  store i64 %orec, ptr @__axiom_recover_top")
        (emitLine cg "  store i64 %olo, ptr @__axiom_stack_lo")
        (emitLine cg "  store i64 %ohi, ptr @__axiom_stack_hi")
        (emitLine cg "  store i64 %otop, ptr @__axiom_stack_top")
        (emitStackSys cg "%u" (targetMunmapNum t)
          "i64 %base, i64 %total, i64 0, i64 0, i64 0, i64 0")
        (emitLine cg "  ret i64 %r")
        (emitLine cg "}")
        (emitLine cg "")
      }
    }
  })

; MM-ALLOC-24: `@__axiom_mem_stat_fn(k)`, the allocator's own counts.
;
;   0  HELD: every byte of the active chunks the bump can no longer hand
;      out - live values, dead blocks waiting on a list, dead blocks too
;      large for one, unreachable cycles, and each chunk's header and
;      abandoned tail. The sum of the active chunks' sizes, less what is
;      left between the bump and the current chunk's end.
;   1  FILED: bytes on the size-class lists, which the next allocation
;      of their class reuses. Slab slot 0, one load.
;   2  MAPPED: every chunk byte mapped, active or on the chunk free list.
;      Chunks are never unmapped (MM-ALLOC-4a), so this only grows.
;
; HELD less FILED is the arena's backlog: what a reset would give back
; and counting has not. In a process whose live set is bounded it is
; bounded; a loop that builds a cycle per iteration raises it by the
; cycle's bytes every time (MM-LIFE-2f). 0 and 2 walk the chunk lists,
; which are short - a chunk is a megabyte - and nothing on the
; allocation path pays for any of it but 1's counter, slab slot 0.
(pub :: emitMemStatFn (-> CG CG))
;@axiom:effect(io)
(pub fn (emitMemStatFn cg)
  {
    (emitLine cg "define internal i64 @__axiom_mem_stat_fn(i64 %k) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %isfiled = icmp eq i64 %k, 1")
    (emitLine cg "  br i1 %isfiled, label %filed, label %known")
    (emitLine cg "filed:")
    (emitLine cg "  %fv = load i64, ptr @__axiom_slabs")
    (emitLine cg "  ret i64 %fv")
    (emitLine cg "known:")
    (emitLine cg "  %isknown = icmp ult i64 %k, 3")
    (emitLine cg "  br i1 %isknown, label %active, label %unknown")
    (emitLine cg "unknown:")
    (emitLine cg "  ret i64 -1")
    (emitLine cg "active:")
    (emitLine cg "  %ahead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  br label %aloop")
    (emitLine cg "aloop:")
    (emitLine cg "  %ac = phi i64 [ %ahead, %active ], [ %anext, %abody ]")
    (emitLine cg "  %asum = phi i64 [ 0, %active ], [ %asum1, %abody ]")
    (emitLine cg "  %adone = icmp eq i64 %ac, 0")
    (emitLine cg "  br i1 %adone, label %aout, label %abody")
    (emitLine cg "abody:")
    (emitLine cg "  %acp = inttoptr i64 %ac to ptr")
    (emitLine cg "  %asz = load i64, ptr %acp")
    (emitLine cg "  %asum1 = add i64 %asum, %asz")
    (emitLine cg "  %alink = add i64 %ac, 8")
    (emitLine cg "  %alinkp = inttoptr i64 %alink to ptr")
    (emitLine cg "  %anext = load i64, ptr %alinkp")
    (emitLine cg "  br label %aloop")
    (emitLine cg "aout:")
    (emitLine cg "  %isheld = icmp eq i64 %k, 0")
    (emitLine cg "  br i1 %isheld, label %held, label %fchunks")
    (emitLine cg "held:")
    (emitLine cg "  %hb = load i64, ptr @__axiom_bump")
    (emitLine cg "  %he = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %hleft = sub i64 %he, %hb")
    (emitLine cg "  %hv = sub i64 %asum, %hleft")
    (if (reserveSupported cg)
      {
        (emitLine cg "  %rv = call i64 @__axiom_reserved_bytes()")
        (emitLine cg "  %charged = add i64 %hv, %rv")
        (emitLine cg "  ret i64 %charged")
      }
      (emitLine cg "  ret i64 %hv"))
    (emitLine cg "fchunks:")
    (emitLine cg "  %fhead = load i64, ptr @__axiom_free")
    (emitLine cg "  br label %floop")
    (emitLine cg "floop:")
    (emitLine cg "  %fc = phi i64 [ %fhead, %fchunks ], [ %fnext, %fbody ]")
    (emitLine cg "  %fsum = phi i64 [ %asum, %fchunks ], [ %fsum1, %fbody ]")
    (emitLine cg "  %fdone = icmp eq i64 %fc, 0")
    (emitLine cg "  br i1 %fdone, label %fout, label %fbody")
    (emitLine cg "fbody:")
    (emitLine cg "  %fcp = inttoptr i64 %fc to ptr")
    (emitLine cg "  %fsz = load i64, ptr %fcp")
    (emitLine cg "  %fsum1 = add i64 %fsum, %fsz")
    (emitLine cg "  %flink = add i64 %fc, 8")
    (emitLine cg "  %flinkp = inttoptr i64 %flink to ptr")
    (emitLine cg "  %fnext = load i64, ptr %flinkp")
    (emitLine cg "  br label %floop")
    (emitLine cg "fout:")
    (if (reserveSupported cg)
      {
        (emitLine cg "  %rv2 = call i64 @__axiom_reserved_bytes()")
        (emitLine cg "  %charged2 = add i64 %fsum, %rv2")
        (emitLine cg "  ret i64 %charged2")
      }
      (emitLine cg "  ret i64 %fsum"))
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; ------------------------------------------------------------------
; `__axiom_arena_reset_keeping_fn(cell, src, bytes)`: reclaim to the
; mark and carry one contiguous block across the reclaim, answering
; where it landed. stage0's `emit_arena_reset_keeping`.
;
; It exists because a caller CANNOT build it out of the two primitives
; it looks like. Written as a reset followed by allocate-and-copy, the
; destination is handed out by `axiom_alloc`, which scrubs it - and
; when the kept block is bigger than the garbage around it, the scrub
; runs over the source before the copy reads it. Measured on a 40 KB
; block kept across a 64-byte allocation: 39,841 of 40,000 bytes wrong
; on the FIRST round. That is not a corner case, it is a server holding
; a document and answering a short request.
;
; The copy runs forwards, which is safe in both directions it can face.
; Within one chunk the source was allocated after the mark, so
; `dst <= src` and a forward copy reads each byte before overwriting
; it. Across chunks the ranges are separate mappings and cannot overlap
; at all - which matters, because `mmap` hands out chunks in no
; particular address order, so `dst <= src` is exactly what not to
; assume there.
;
; When the block does not fit in what remains of the marked chunk,
; reuse a free chunk only when its destination allocation, including
; every header, is disjoint from the source bytes. The reset may have
; just filed the source's own chunk, so taking the head unconditionally
; could overwrite those bytes before the copy. Mapping only when no
; safe chunk fits keeps repeated large snapshots bounded.
; ------------------------------------------------------------------
(pub :: emitArenaKeepHelper (-> CG CG))
;@axiom:effect(io)
(pub fn (emitArenaKeepHelper cg)
  {
    (emitLine cg
      (concat "define internal i64 @__axiom_arena_reset_keeping_fn"
        (if (reserveSupported cg)
          "(i64 %cell, i64 %original, i64 %bytes) #0 {"
          "(i64 %cell, i64 %src, i64 %bytes) #0 {")))
    (emitLine cg "entry:")
    (if (reserveSupported cg)
      {
        (emitLine cg "  %sourceflooraddr = add i64 %cell, 24")
        (emitLine cg "  %sourcefloorp = inttoptr i64 %sourceflooraddr to ptr")
        (emitLine cg "  %sourcefloor = load i64, ptr %sourcefloorp")
        (emitLine cg
          "  %src = call i64 @__axiom_reserved_snapshot(i64 %original, i64 %bytes, i64 %sourcefloor)")
        (emitLine cg "  %keep = call i64 @__axiom_reserved_source(i64 %src, i64 %bytes)")
        (emitLine cg "  %r = call i64 @__axiom_arena_reset_impl(i64 %cell, i64 %keep)")
        (emitLine cg "  %have = icmp ne i64 %keep, 0")
        (emitLine cg "  %kp = inttoptr i64 %keep to ptr")
        (emitLine cg "  %kdata = add i64 %keep, 64")
        (emitLine cg "  br i1 %have, label %reserved, label %ordinary")
        (emitLine cg "reserved:")
        (emitLine cg "  %kcp = getelementptr i64, ptr %kp, i64 4")
        (emitLine cg "  %kcap = load i64, ptr %kcp")
        (emitLine cg "  %whole = icmp eq i64 %src, %kdata")
        (emitLine cg "  %full = icmp eq i64 %bytes, %kcap")
        ; A source older than the mark keeps its existing owners and
        ; shape. Copy it as before; only reclaimed storage can move
        ; into the kept block's count-zero leaf contract.
        (emitLine cg "  %kseqp = getelementptr i64, ptr %kp, i64 2")
        (emitLine cg "  %kseq = load i64, ptr %kseqp")
        (emitLine cg "  %kflooraddr = add i64 %cell, 24")
        (emitLine cg "  %kfloorp = inttoptr i64 %kflooraddr to ptr")
        (emitLine cg "  %kfloor = load i64, ptr %kfloorp")
        (emitLine cg "  %knew = icmp ugt i64 %kseq, %kfloor")
        (emitLine cg "  %exactpayload = and i1 %whole, %full")
        (emitLine cg "  %exactkeep = and i1 %exactpayload, %knew")
        (emitLine cg "  br i1 %exactkeep, label %kept, label %ordinary")
        (emitLine cg "kept:")
        (emitLine cg "  %cntp = getelementptr i64, ptr %kp, i64 6")
        (emitLine cg "  store i64 0, ptr %cntp")
        (emitLine cg "  %shp = getelementptr i64, ptr %kp, i64 7")
        (emitLine cg "  store i64 2, ptr %shp")
        (emitLine cg "  ret i64 %src")
        (emitLine cg "ordinary:")
      }
      (emitLine cg "  %r = call i64 @__axiom_arena_reset_fn(i64 %cell)"))
    (emitLine cg "  %sz0 = add i64 %bytes, 15")
    (emitLine cg "  %exact = and i64 %sz0, -16")
    ; The kept block is a counted block like any other: its 16-byte
    ; MM-LIFE-2b header travels with it, reserved on BOTH landing
    ; paths - the review of this slice caught that this helper is a
    ; SECOND allocation path (the LSP crosses it every message), and
    ; a header only on axiom_alloc's path would ship a spec-false
    ; SHALL.
    (emitLine cg "  %large = icmp ugt i64 %exact, 65536")
    (emitLine cg "  br i1 %large, label %largeclass, label %classready")
    (emitLine cg "largeclass:")
    (emitLine cg "  %lm0 = sub i64 %exact, 1")
    (emitLine cg "  %lc1 = icmp uge i64 %lm0, 4294967296")
    (emitLine cg "  %ls1 = lshr i64 %lm0, 32")
    (emitLine cg "  %lm1 = select i1 %lc1, i64 %ls1, i64 %lm0")
    (emitLine cg "  %la1 = select i1 %lc1, i64 32, i64 0")
    (emitLine cg "  %ln1 = add i64 0, %la1")
    (emitLine cg "  %lc2 = icmp uge i64 %lm1, 65536")
    (emitLine cg "  %ls2 = lshr i64 %lm1, 16")
    (emitLine cg "  %lm2 = select i1 %lc2, i64 %ls2, i64 %lm1")
    (emitLine cg "  %la2 = select i1 %lc2, i64 16, i64 0")
    (emitLine cg "  %ln2 = add i64 %ln1, %la2")
    (emitLine cg "  %lc3 = icmp uge i64 %lm2, 256")
    (emitLine cg "  %ls3 = lshr i64 %lm2, 8")
    (emitLine cg "  %lm3 = select i1 %lc3, i64 %ls3, i64 %lm2")
    (emitLine cg "  %la3 = select i1 %lc3, i64 8, i64 0")
    (emitLine cg "  %ln3 = add i64 %ln2, %la3")
    (emitLine cg "  %lc4 = icmp uge i64 %lm3, 16")
    (emitLine cg "  %ls4 = lshr i64 %lm3, 4")
    (emitLine cg "  %lm4 = select i1 %lc4, i64 %ls4, i64 %lm3")
    (emitLine cg "  %la4 = select i1 %lc4, i64 4, i64 0")
    (emitLine cg "  %ln4 = add i64 %ln3, %la4")
    (emitLine cg "  %lc5 = icmp uge i64 %lm4, 4")
    (emitLine cg "  %ls5 = lshr i64 %lm4, 2")
    (emitLine cg "  %lm5 = select i1 %lc5, i64 %ls5, i64 %lm4")
    (emitLine cg "  %la5 = select i1 %lc5, i64 2, i64 0")
    (emitLine cg "  %ln5 = add i64 %ln4, %la5")
    (emitLine cg "  %lc6 = icmp uge i64 %lm5, 2")
    (emitLine cg "  %ls6 = lshr i64 %lm5, 1")
    (emitLine cg "  %lm6 = select i1 %lc6, i64 %ls6, i64 %lm5")
    (emitLine cg "  %la6 = select i1 %lc6, i64 1, i64 0")
    (emitLine cg "  %ln6 = add i64 %ln5, %la6")
    (emitLine cg "  %power = add i64 %ln6, 1")
    (emitLine cg "  %cls = add i64 %power, 4080")
    (emitLine cg "  %capacity = shl i64 1, %power")
    (emitLine cg "  br label %classready")
    (emitLine cg "classready:")
    (emitLine cg
      (if (reserveSupported cg)
        "  %szr = phi i64 [ %exact, %ordinary ], [ %capacity, %largeclass ]"
        "  %szr = phi i64 [ %exact, %entry ], [ %capacity, %largeclass ]"))
    (emitLine cg
      (if (reserveSupported cg)
        "  %keepcls = phi i64 [ 0, %ordinary ], [ %cls, %largeclass ]"
        "  %keepcls = phi i64 [ 0, %entry ], [ %cls, %largeclass ]"))
    (emitLine cg "  %overhead = select i1 %large, i64 32, i64 16")
    (emitLine cg "  %sz = add i64 %szr, %overhead")
    (emitLine cg "  %bump = load i64, ptr @__axiom_bump")
    (emitLine cg "  %end = load i64, ptr @__axiom_bump_end")
    (emitLine cg "  %stop = add i64 %bump, %sz")
    (emitLine cg "  %fits = icmp ule i64 %stop, %end")
    (emitLine cg "  br i1 %fits, label %inplace, label %fresh")
    (emitLine cg "inplace:")
    (emitLine cg "  store i64 %stop, ptr @__axiom_bump")
    (emitLine cg "  br label %copy")
    (emitLine cg "fresh:")
    (emitLine cg "  %need = add i64 %sz, 16")
    ; The same grain `refill:` rounds to, for the same reason: this is
    ; the arena's SECOND allocation path, and a 4 KiB-chunk target that
    ; rounded a kept block up to 64 KiB here would exhaust a small
    ; static region on a keep that fits.
    (emitLine cg
      (concat "  %rounded0 = add i64 %need, "
        (concat (fmtInt (- (targetArenaGrainBytes (cgTarget cg)) 1)) "")))
    (emitLine cg
      (concat "  %want = and i64 %rounded0, "
        (concat (fmtInt (- 0 (targetArenaGrainBytes (cgTarget cg)))) "")))
    (emitLine cg "  %srcend = add i64 %src, %bytes")
    (emitLine cg "  %srcvalid = icmp uge i64 %srcend, %src")
    (emitLine cg "  %fhead = load i64, ptr @__axiom_free")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg "  %cand = phi i64 [ %fhead, %fresh ], [ %cnext, %scan_next ]")
    (emitLine cg "  %prev = phi i64 [ 0, %fresh ], [ %cand, %scan_next ]")
    (emitLine cg "  %exhausted = icmp eq i64 %cand, 0")
    (emitLine cg "  br i1 %exhausted, label %map, label %scan_test")
    (emitLine cg "scan_test:")
    (emitLine cg "  %candp = inttoptr i64 %cand to ptr")
    (emitLine cg "  %candsz = load i64, ptr %candp")
    (emitLine cg "  %candlink = add i64 %cand, 8")
    (emitLine cg "  %candlinkp = inttoptr i64 %candlink to ptr")
    (emitLine cg "  %cnext = load i64, ptr %candlinkp")
    (emitLine cg "  %roomy = icmp uge i64 %candsz, %want")
    (emitLine cg "  %writeend = add i64 %cand, %need")
    (emitLine cg "  %before = icmp ule i64 %writeend, %src")
    (emitLine cg "  %after = icmp ule i64 %srcend, %cand")
    (emitLine cg "  %disjoint = or i1 %before, %after")
    (emitLine cg "  %safe = and i1 %srcvalid, %disjoint")
    (emitLine cg "  %eligible = and i1 %roomy, %safe")
    (emitLine cg "  br i1 %eligible, label %unlink, label %scan_next")
    (emitLine cg "scan_next:")
    (emitLine cg "  br label %scan")
    (emitLine cg "unlink:")
    (emitLine cg "  %at_head = icmp eq i64 %prev, 0")
    (emitLine cg "  br i1 %at_head, label %unlink_head, label %unlink_mid")
    (emitLine cg "unlink_head:")
    (emitLine cg "  store i64 %cnext, ptr @__axiom_free")
    (emitLine cg "  br label %adopt")
    (emitLine cg "unlink_mid:")
    (emitLine cg "  %prevlink = add i64 %prev, 8")
    (emitLine cg "  %prevlinkp = inttoptr i64 %prevlink to ptr")
    (emitLine cg "  store i64 %cnext, ptr %prevlinkp")
    (emitLine cg "  br label %adopt")
    (emitLine cg "map:")
    (emitArenaCapCheck cg "%want")
    (emitRuntimeMap cg "%want")
    (emitLine cg "  %failed_low = icmp ult i64 %addr, 4096")
    (emitLine cg "  %failed_neg = icmp ugt i64 %addr, -4096")
    (emitLine cg "  %failed = or i1 %failed_low, %failed_neg")
    (emitLine cg "  br i1 %failed, label %oom, label %mapped")
    (emitLine cg "mapped:")
    (emitLine cg "  br label %adopt")
    (emitLine cg "adopt:")
    (emitLine cg
      "  %base = phi i64 [ %addr, %mapped ], [ %cand, %unlink_head ], [ %cand, %unlink_mid ]")
    (emitLine cg
      "  %bsize = phi i64 [ %want, %mapped ], [ %candsz, %unlink_head ], [ %candsz, %unlink_mid ]")
    (emitLine cg
      "  %reused = phi i1 [ false, %mapped ], [ true, %unlink_head ], [ true, %unlink_mid ]")
    (emitLine cg "  %basep = inttoptr i64 %base to ptr")
    (emitLine cg "  store i64 %bsize, ptr %basep")
    (emitLine cg "  %baselink = add i64 %base, 8")
    (emitLine cg "  %baselinkp = inttoptr i64 %baselink to ptr")
    (emitLine cg "  %chead = load i64, ptr @__axiom_chunk")
    (emitLine cg "  store i64 %chead, ptr %baselinkp")
    (emitLine cg "  store i64 %base, ptr @__axiom_chunk")
    (emitLine cg "  %fdata = add i64 %base, 16")
    (emitLine cg "  %fbump = add i64 %fdata, %sz")
    (emitLine cg "  store i64 %fbump, ptr @__axiom_bump")
    (emitLine cg "  %fend = add i64 %base, %bsize")
    (emitLine cg "  store i64 %fend, ptr @__axiom_bump_end")
    ; A recycled chunk is dirty beyond the kept block too. Fresh
    ; mappings still contain zeroes there; later allocations may skip
    ; scrubbing only on that path.
    (emitLine cg "  %fhigh = select i1 %reused, i64 %fend, i64 %fbump")
    (emitLine cg "  store i64 %fhigh, ptr @__axiom_high")
    (emitLine cg "  br label %copy")
    ; The destination stays unscrubbed: the copy writes every byte the
    ; caller asked to keep, and the bytes past `%bytes` up to the
    ; 16-byte rounding are padding no caller can name.
    (emitLine cg "copy:")
    (emitLine cg "  %dstbase = phi i64 [ %bump, %inplace ], [ %fdata, %adopt ]")
    ; The destination is deliberately unscrubbed, so BOTH header words
    ; are written here - dirty memory below a restored waterline would
    ; otherwise read as a count.
    (emitLine cg "  br i1 %large, label %prefix, label %header")
    (emitLine cg "prefix:")
    (emitLine cg "  %capp = inttoptr i64 %dstbase to ptr")
    (emitLine cg "  store i64 %szr, ptr %capp")
    (emitLine cg "  %cla = add i64 %dstbase, 8")
    (emitLine cg "  %clp = inttoptr i64 %cla to ptr")
    (emitLine cg "  store i64 %keepcls, ptr %clp")
    (emitLine cg "  %lhb = add i64 %dstbase, 16")
    (emitLine cg "  br label %header")
    (emitLine cg "header:")
    (emitLine cg "  %chb = phi i64 [ %dstbase, %copy ], [ %lhb, %prefix ]")
    (emitLine cg "  %dcp = inttoptr i64 %chb to ptr")
    (emitLine cg "  store i64 0, ptr %dcp")
    (emitLine cg "  %dsh = add i64 %chb, 8")
    (emitLine cg "  %dshp = inttoptr i64 %dsh to ptr")
    ; the keep helper is the third shape writer, and it stamps the
    ; LEAF of its dynamic size - the kept bytes' declared types are
    ; gone by run time - with the allocator's exact clamp, because a
    ; kept block can be a 262KB read buffer as easily as a cell
    (emitLine cg "  %kcnt = lshr i64 %szr, 3")
    (emitLine cg "  %kleaf = select i1 %large, i64 1, i64 %kcnt")
    (emitLine cg "  %kshp = shl i64 %kleaf, 1")
    (emitLine cg "  store i64 %kshp, ptr %dshp")
    (emitLine cg "  %dst = add i64 %chb, 16")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ 0, %header ], [ %i2, %loop_body ]")
    (emitLine cg "  %more = icmp ult i64 %i, %bytes")
    (emitLine cg "  br i1 %more, label %loop_body, label %done")
    (emitLine cg "loop_body:")
    (emitLine cg "  %sa = add i64 %src, %i")
    (emitLine cg "  %sp = inttoptr i64 %sa to ptr")
    (emitLine cg "  %b = load i8, ptr %sp")
    (emitLine cg "  %da = add i64 %dst, %i")
    (emitLine cg "  %dp = inttoptr i64 %da to ptr")
    (emitLine cg "  store i8 %b, ptr %dp")
    (emitLine cg "  %i2 = add i64 %i, 1")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (if (reserveSupported cg)
      {
        (emitLine cg "  br i1 %have, label %sourcecheck, label %return")
        (emitLine cg "sourcecheck:")
        (emitLine cg "  %seqp = getelementptr i64, ptr %kp, i64 2")
        (emitLine cg "  %seq = load i64, ptr %seqp")
        (emitLine cg "  %flooraddr = add i64 %cell, 24")
        (emitLine cg "  %floorp = inttoptr i64 %flooraddr to ptr")
        (emitLine cg "  %floor = load i64, ptr %floorp")
        (emitLine cg "  %newsource = icmp ugt i64 %seq, %floor")
        (emitLine cg "  br i1 %newsource, label %sourcedrop, label %return")
        (emitLine cg "sourcedrop:")
        (emitLine cg "  call void @__axiom_unmap_reserved(i64 %kdata)")
        (emitLine cg "  br label %return")
        (emitLine cg "return:")
      })
    (emitLine cg "  ret i64 %dst")
    (emitLine cg "oom:")
    (emitLine cg "  call i64 @__axiom_out_of_memory()")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

(pub :: checkedTargetCode (-> String Int))
;@axiom:effect(io)
(pub fn (checkedTargetCode target)
  {
    (let tcode (targetCode target))
    (if (< tcode 0)
      (dieImport
        "error: unknown target (want darwin-aarch64, darwin-x86_64, linux-aarch64, linux-x86_64, freebsd-x86_64, freebsd-aarch64, windows-x86_64, windows-aarch64, or baremetal-aarch64): "
        target)
      tcode)
  })

; Emission over an ALREADY-resolved declaration list. Import resolution
; happens once per run, in the caller: the checker needs `allDecls`
; too, and resolving twice would read every module from disk twice.
; The one caller is `checked.ax`'s `emitCheckedProgram`, so what
; arrives here is what the final check accepted; `check-driver.sh`
; holds that to the tree.
; Sub-phase timing for AXIOM_TIME_PHASES=1, matching main's phase
; lines: one `phase emit/<pass> <ms>` line per stage on stderr.
;@axiom:effect(io)
(:: emitPhaseNow Int)
;@axiom:effect(io)
(fn (emitPhaseNow)
  (match (sysNowMonotonic (memAlloc 16))
    ((Ok us) us)
    ((Err e) 0)))

(:: emitPhaseTick (-> String Int Int))
;@axiom:effect(io)
(fn (emitPhaseTick name start)
  {
    (let now (emitPhaseNow))
    {
      (if (strEq (sysEnv "AXIOM_TIME_PHASES") "1")
        (writeStr stderr
          (concat "phase "
            (concat name (concat " " (concat (fmtInt (/ (- now start) 1000)) " ms\n"))))))
      now
    }
  })

; Keep mode selection explicit: program arguments after `run FILE`
; cannot change code generation by resembling compiler flags.
(pub :: emitResolvedMode (-> Nodes FunctionTypes Strings Strings Int Bool String))
;@axiom:effect(io)
(pub fn (emitResolvedMode allDecls functionTypes bares fulls tcode obscure)
  ; Every signature is known and the type table is built:
  ; index both, then decide who owns what result before a
  ; function is emitted.
  {
    (let cg newCG)
    (let emitT0 (emitPhaseNow))
    (cgSetFunctionFloats cg (Some (functionFloatIndex functionTypes)))
    {
      (let _mode
        (cgSetObfuscate cg
          (if obscure
            1
            0)))
      (let _ (cgSetMangleBares cg bares))
      (let _2 (cgSetMangleFulls cg fulls))
      (let _2t (cgSetTarget cg tcode))
      (let _stackMode
        (cgSetNativeExe cg
          (if cgStaticlib
            0
            (targetHasSpawn tcode))))
      (let _2p (parScan cg allDecls))
      (let _3
        (cgSetFloatSigs cg
          {
            (let sigs (scanFloatSigs allDecls vecNew 0))
            {
              (markTransferSigs allDecls sigs 0)
              sigs
            }
          }))
      {
        (let cg0 (scanDecls allDecls cg 0))
        {
          (let cg0b (cgSetDecls cg0 allDecls))
          {
            (let _idx (buildNameIndexes cg0b))
            {
              (let _own (inferOwnership cg0b allDecls))
              (let emitTO (emitPhaseTick "emit/scan+index+ownership" emitT0))
              {
                (let _flow (inferFlows cg0b allDecls))
                (let _writes (inferWrites cg0b allDecls))
                (let emitT1 (emitPhaseTick "emit/flows" emitTO))
                {
                  (let ttHeader (concat "target triple = \"" (concat (targetTriple tcode) "\"")))
                  {
                    (let cg1 (emitLine cg0b ttHeader))
                    {
                      (let cg2 (emitLine cg1 ""))
                      {
                        (let cg3 (emitAllocator cg2))
                        {
                          (let cg4 (emitLine cg3 ""))
                          {
                            (let ir (emitModuleTail allDecls cg4 0))
                            {
                              (emitPhaseTick "emit/bodies" emitT1)
                              ir
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

(pub :: emitModuleTail (-> (Vec ASTNode) CG Int String))
;@axiom:effect(io)
(pub fn (emitModuleTail decls cg i)
  {
    (let nextCg
      (if (>= i (vecLen decls))
        cg
        (emitDecl (vecGet decls i) cg)))
    (if (>= i (vecLen decls))
      ; Globals may follow the functions that mention them; LLVM does
      ; not care about order, and the table is only complete once every
      ; body has been emitted.
      ;
      ; The attribute group every `define` above refers to. Axiom's
      ; contract is that generated code calls no libc function, and the
      ; optimiser does not know that: LLVM's loop-idiom recogniser
      ; rewrites a byte loop into a call to `strlen` or `memset`, which
      ; are libc symbols in a language that has deliberately never
      ; linked libc. Measured on a stage1-built `010-hello.ax` through
      ; `opt -O1`: 17 references to `strlen`, and a linked binary
      ; importing `_strlen` and `_memset`.
      ;
      ; `"no-builtins"` is the string attribute clang emits for
      ; `-fno-builtin`. The enum attribute `nobuiltin` is a different
      ; thing and does NOT work here - measured separately, it left all
      ; 17 in place. Only one of the two is load-bearing and they are
      ; easy to confuse.
      ; The `declare` lines for every `extern` item, ahead of the
      ; attribute group they refer to.
      ;
      ; This is the entire difference between `extern` and the
      ; removed `foreign`. `foreign` emitted `call i64 @putchar(...)`
      ; into a module that declared no `@putchar`; LLVM textual IR
      ; REQUIRES a declare for an undeclared callee, so `check`
      ; passed and `opt` then died with "use of undefined value"
      ; two stages later (the self-hosting record).
      ; The symbol table is read out of the buffer, so it has to be
      ; built HERE - after the last `define` and before the walker
      ; adds its own two. `emitEffectGlobals` above is one of the
      ; emitters that contributes one (`@__axiom_unhandled_effect`),
      ; which is why the scan follows it rather than opening this
      ; branch.
      ; Seeded with the symbols the RUNTIME already declared, so an
      ; `extern "kernel32"` block binding `WriteFile` does not declare
      ; it a second time - a repeated `declare` is an LLVM parse error,
      ; and the Windows platform module binds four of the runtime's six.
      ;
      ; `pruneDeadDefs` LAST, and the order is the whole point: it is
      ; the outermost call here and `symtabNames` reads its result, so
      ; the backtrace table below is built over the functions that
      ; SURVIVED. Run it the other way round and the table would hold
      ; the address of every function in the module, which is a live
      ; global referencing all of them and pins the lot - the reason
      ; `internal` linkage alone removed one `define` of 388 when it
      ; was measured. A stripped function can never appear in a
      ; backtrace, so a table over the survivors is the complete table.
      {
        (let tailCg
          (pruneDeadDefs
            (emitExternDeclares decls
              (emitRecoverSlotHelpers (emitEffectGlobals (emitStringGlobals nextCg 0) 0)) 0
              (runtimeDeclaredSyms (cgTarget nextCg) (cgThreads nextCg)))))
        (renderCG
          (emitAsmFiles
            (emitLine
              (emitLine (emitBacktrace tailCg (symtabNames (cgLineWords tailCg)))
                (attrGroupZero (cgTarget tailCg)))
              "attributes #1 = { alwaysinline }")))
      }
      (emitModuleTail decls nextCg (+ i 1)))
  })

; `attributes #0`, per target. The bare target adds `+strict-align`:
; `_start` sets SCTLR_EL1.A, so a misaligned access is an alignment
; fault on Normal memory as well as on Device memory, and LLVM may not
; merge byte accesses into a wider unaligned one there - which it does
; freely where the target allows unaligned access, and aarch64 does.
;
; `null_pointer_is_valid` on every target, because a word is an
; address and 0 is one of them (docs/memory-model.md MM-VAL-6a). A raw
; access is emitted as a `getelementptr` from its base (`emitPrimLoad`,
; `emitPrimStore`), and without this attribute LLVM reads a base that
; is, or folds to, 0 as the null pointer and an access through it as
; unreachable: `(__load8 0 p)` read the byte at `p` at `--opt 0` and
; died by SIGTRAP at `--opt 1` and above (fuzz mutant m01417 of
; tests/selfhost/690-large-memcopy.ax). Computing the address on words
; instead also cured it, but cost the vectoriser every byte loop -
; `memCopy` and `memCmp` ran 1.8x slower at `--opt 2` - and the
; compiler's own run 9-13%; the attribute measured no cost on either.
(pub :: attrGroupZero (-> Int String))
(pub fn (attrGroupZero t)
  (if (== t 7)
    "attributes #0 = { null_pointer_is_valid \"no-builtins\" \"frame-pointer\"=\"all\" \"target-features\"=\"+strict-align\" }"
    "attributes #0 = { null_pointer_is_valid \"no-builtins\" \"frame-pointer\"=\"all\" }"))

; ------------------------------------------------------------------
; `declare i64 @sym(i64, ...)` for every `extern` item in the module.
;
; `seen` deduplicates: two Axiom names may bind ONE symbol, and an
; imported binding module reaches this list once per importer. A
; repeated `declare` of the same name is an LLVM parse error, not a
; warning, so the dedup is load-bearing rather than tidy.
;
; The `#0` group goes on the declare as well as the define. Without it
; `opt` is free to reason about a declared name whose signature matches
; a libc function it knows - which is the whole hazard
; `check-freestanding.sh` exists to watch.
; ------------------------------------------------------------------
(pub :: emitExternDeclares (-> (Vec ASTNode) CG Int Strings CG))
(pub fn (emitExternDeclares decls cg i seen)
  (if (>= i (vecLen decls))
    cg
    {
      (let d (vecGet decls i))
      (emitExternDeclares
        decls
        (if (== (nodeTag d) TAG_D_EXTERN)
          ; the block's library name travels in the IR as a
          ; comment the driver reads beside the declares: it is
          ; what lets `axiom build` link `-l<lib>` without being
          ; told, and name the block in a grounding diagnostic
          (emitExternItems (nodeCChildren d)
            (emitLine cg (concat "; axiom-extern-lib " (nodeAName d))) 0 seen)
          cg)
        (+ i 1)
        seen)
    }))

(pub :: emitExternItems (-> (Vec ASTNode) CG Int Strings CG))
(pub fn (emitExternItems items cg i seen)
  (if (== (as items Int) 0)
    cg
    (if (>= i (vecLen items))
      cg
      {
        (let f (vecGet items i))
        {
          (let sym (nodeCName f))
          (emitExternItems
            items
            (if (|| (== (externSeen seen sym 0) 1)
                  (== (linesCallSym (cgLineWords cg) (llvmSym (strDup sym)) 0) 0))
              ; only a symbol the module CALLS is declared:
              ; a binding module imports fifteen items and a
              ; program calls two, and every declare must
              ; ground against a linked archive, so a
              ; program that imports `Ffi` for its handles
              ; alone links without any archive
              cg
              {
                (vecPush seen sym)
                (emitLine cg
                  (concat "declare i64 @"
                    (concat (llvmSym (strDup sym))
                      (concat (concat "(" (concat (externParams (arrowArity (nodeBChild f))) ")"))
                        " #0"))))
              })
            (+ i 1)
            seen)
        }
      })))

; Does any emitted line call `@sym(`? A substring scan over the
; module's lines, once per extern item at the end of emission. It reads
; the buffer as words, through `cgLineWords`: a typed line handed to
; `asmLineNamesSym` would count as parked there, and the caller would
; never give its share of the buffer back.
(pub :: linesCallSym (-> Ints String Int Int))
;@axiom:effect(unsafe)
(pub fn (linesCallSym lines sym i)
  (if (>= i (vecLen lines))
    0
    (if (|| (strHasSegments (as (vecGet lines i) String) "@" sym "(")
          (asmLineNamesSym (as (vecGet lines i) String) sym))
      1
      (linesCallSym lines sym (+ i 1)))))

; Does an inline-assembly call on this line pass `@sym` as a `sym`
; operand (`asmInputArgs`), as `ptr @sym` followed by `,` or `)`? That
; is a use of the symbol as much as a call is, and it needs the
; `declare` too.
(pub :: asmLineNamesSym (-> String String Bool))
(pub fn (asmLineNamesSym line sym)
  (if (== (strHasSub line " asm ") 0)
    false
    (|| (strHasSegments line "ptr @" sym ",") (strHasSegments line "ptr @" sym ")"))))

; Match the concatenation without allocating a search string per line.
; The three length checks also bound their sum before any byte is read.
(:: strHasSegments (-> String String String String Bool))
(fn (strHasSegments hay prefix middle suffix)
  {
    (let h (strLen hay))
    (let p (strLen prefix))
    (let m (strLen middle))
    (let s (strLen suffix))
    (if (|| (> p h) (|| (> m (- h p)) (> s (- (- h p) m))))
      false
      {
        (let n (+ (+ p m) s))
        (let mut i 0)
        (let mut found false)
        (while (&& (! found) (<= i (- h n)))
          {
            (let mut j 0)
            (let mut same true)
            (while (&& same (< j n))
              {
                (let expected
                  (if (< j p)
                    (strByte prefix j)
                    (if (< (- j p) m)
                      (strByte middle (- j p))
                      (strByte suffix (- (- j p) m)))))
                (if (!= (strByte hay (+ i j)) expected)
                  (set same false))
                (set j (+ j 1))
              })
            (if same
              (set found true))
            (set i (+ i 1))
          })
        found
      })
  })

(pub :: strHasSub (-> String String Int))
(pub fn (strHasSub hay needle)
  {
    (let n (strLen needle))
    (let h (strLen hay))
    (if (> n h)
      0
      (strHasSubFrom (strData hay) (strData needle) n (- h n) 0))
  })

(pub :: strHasSubFrom (-> Int Int Int Int Int Int))
(pub fn (strHasSubFrom hp np n last i)
  (if (> i last)
    0
    (if (== (memCmp (+ hp i) np n) 0)
      1
      (strHasSubFrom hp np n last (+ i 1)))))

(pub :: externSeen (-> Strings String Int Int))
(pub fn (externSeen seen sym i)
  (if (>= i (vecLen seen))
    0
    (if (strEq (vecGetStr seen i) sym)
      1
      (externSeen seen sym (+ i 1)))))

; The declared arrow's depth. `->` right-folds, so `(-> Int Int Int)`
; IS `(-> Int (-> Int Int))` and the depth is 2.
; `i64, i64` for arity 2; the empty string for arity 0, which is the
; shape a nullary extern needs - `@f()` and never `@f(i64 )`.
(pub :: externParams (-> Int String))
(pub fn (externParams n)
  {
    (let words vecNew)
    {
      (for i in 0..n
        (vecPush words "i64"))
      (strJoin words ", ")
    }
  })

; ------------------------------------------------------------------
; Declaration emission.
; ------------------------------------------------------------------
(pub :: emitDecl (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitDecl node cg)
  (if (== (nodeTag node) TAG_D_FN)
    ; Lambdas lifted out of the function's body, and thunks its bare
    ; function references demanded, are written out once the
    ; function's own `}` is down - the line buffer is one flat
    ; stream, so they cannot be emitted at the point of use.
    ;
    ; The module travels across both, because a lifted lambda's body
    ; is still code written in that module and its bare references
    ; resolve the same way the enclosing function's do.
    ; A function in the pair set is emitted ONCE, as `@F$pair`,
    ; and `@F` is a wrapper that calls it and boxes the answer
    ; (`emitPairWrapper`); every other declaration is emitted, and
    ; called, exactly as before. The set is the one
    ; `buildNameIndexes` computed, and not `pairFnOK` asked again
    ; here: the call sites read the set, so the set is what the
    ; definition must agree with.
    {
      (let _ (cgSetDeclModule cg node))
      (let _e (cgSetCurDecl cg (Some node)))
      {
        (let cgD
          (if (== (pairNamesHas (pairNames cg) (nodeAName node)) 1)
            {
              (cgSetPairResultType cg (pairRetTyOf cg node))
              {
                (let cgQ (drainPending (emitFnDef node cg)))
                {
                  (cgSetPairResultType cgQ (None))
                  (emitPairWrapper node cgQ)
                }
              }
            }
            (drainPending (emitFnDef node cg))))
        {
          (let cgP cgD)
          {
            (cgSetModule cgP (None))
            (cgSetCurDecl cgP None)
            (cgSetTailRetain cgP vecNew)
            cgP
          }
        }
      }
    }
    cg))

; Does this (lowered) body contain a match? Decides whether the
; function gets the merge scratch: an UNCONDITIONAL alloca grew
; every frame by sixteen bytes, and 320-effect-gc-roots' deep
; non-TCO recursion found the stack guard at raw `llc -O2` - the
; growth mode the self-hosting record calls meeting a distant limit as an
; unrelated-looking failure, this time in frames rather than bytes.
; A missed tag here under-emits and llc refuses the undefined
; register LOUDLY. (`cond` used to answer 1 unconditionally because
; its lowering happened per-declaration; it is AX2004 now, so no
; body carries one.)
(pub :: bodyHasMatch (-> ASTNode Int))
(pub fn (bodyHasMatch e)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_MATCH)
        1
        ; `cond` is AX2004: the parser builds none, so no body
        ; hides a match inside one.
        (if (== tg TAG_E_APP)
          (if (== (bodyHasMatch (nodeAChild e)) 1)
            1
            (bodyHasMatch (nodeBChild e)))
          (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            (if (== (bodyHasMatch (nodeBChild e)) 1)
              1
              (bodyHasMatch (nodeCChild e)))
            (if (== tg TAG_E_IF)
              (if (== (bodyHasMatch (nodeAChild e)) 1)
                1
                (if (== (bodyHasMatch (nodeBChild e)) 1)
                  1
                  (bodyHasMatch (nodeCChild e))))
              (if (== tg TAG_E_BEGIN)
                (bodyHasMatchVec (nodeAChildren e))
                (if (== tg TAG_E_SET)
                  (bodyHasMatch (nodeBChild e))
                  (if (== tg TAG_E_SETF)
                    (if (== (bodyHasMatch (nodeAChild e)) 1)
                      1
                      (bodyHasMatch (nodeCChild e)))
                    ; A `while`'s word 2 is its body VECTOR, not a node. Handed to
                    ; the node walk it read a Vec header as a tag and answered 0,
                    ; so a match inside a loop body got no scratch and `opt`
                    ; refused the undefined `%__scr.h` - loudly, as the comment
                    ; above promises, and in the program rather than the compiler
                    ; (the QA sweep's refutation pass, 2026-08-21).
                    (if (|| (== tg TAG_E_WHILE) (== tg TAG_E_REGION))
                      (if (== tg TAG_E_REGION)
                        (bodyHasMatch (nodeBChild e))
                        (if (== (bodyHasMatch (nodeAChild e)) 1)
                          1
                          (bodyHasMatchVec (nodeBChildren e))))
                      (if (== tg TAG_E_FIELD)
                        (bodyHasMatch (nodeAChild e))
                        (if (== tg TAG_E_LAM)
                          (bodyHasMatch (nodeCChild e))
                          (if (== tg TAG_E_STRUCTCON)
                            (bodyHasMatchVec (nodeBChildren e))
                            (if (== tg TAG_E_HANDLE)
                              ; the body (A) and the handler (C); B is the Vec of effect
                              ; names, not a node - walked as one, it read a Vec header
                              ; as a tag and the body's `match` got no scratch word
                              (if (== (bodyHasMatch (nodeAChild e)) 1)
                                1
                                (bodyHasMatch (nodeCChild e)))
                              0))))))))))))
    }))

(pub :: bodyHasMatchVec (-> (Vec ASTNode) Int))
(pub fn (bodyHasMatchVec xs)
  (if (== (as xs Int) 0)
    0
    {
      (let mut i 0)
      (let mut found 0)
      {
        (while (< i (vecLen xs))
          {
            (if (== (bodyHasMatch (vecGet xs i)) 1)
              (set found 1))
            (set i (+ i 1))
          })
        found
      }
    }))

(pub :: emitFnDef (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitFnDef node cg)
  ; The entry file's `main` is not the linker's `main` - the argv
  ; wrapper in the prelude owns that symbol and calls this one. Same
  ; rename stage0 makes, for the same reason.
  ; reset register counter in-place
  ; The symbol table holds this function's `let` bindings and
  ; nothing else. It used to persist across the whole module, so
  ; a `let`-bound `s` in one function shadowed the *parameter*
  ; `s` of a later one and emitted the earlier function's
  ; register - a name undefined in the function that used it.
  ; This function's own parameter names and float flags, for
  ; `%name` references in the body.
  ; event 2: the tail leaves this function must retain
  ; MM-LIFE-2d: a polymorphic function's hidden evidence word.
  ; Appended to the RENDERED parameter list only - the AST param
  ; vec is untouched, so every arity computation stays blind to
  ; it by construction. The symbol-table binding under "__evw."
  ; (a name no Axiom identifier can spell) is what the body's
  ; call sites and lambda captures read it through.
  ; MM-ALLOC-9 as amended: the merge cells (a match's result, a
  ; mixed-representation tag read) are no longer heap
  ; allocations - one scratch alloca per function serves them
  ; all, because a cell's live range is store-as-the-arm's-
  ; last-act to load-at-the-merge with nothing between, and
  ; nested matches complete strictly inside their arm. Emitted
  ; only where a match exists: raw `llc -O2` runs no dead-
  ; alloca elimination, and sixteen bytes on every frame found
  ; a deep recursion's stack guard.
  ; NO re-scan here. This used to read
  ;
  ;   ; Re-scan declarations to ensure types Vec is fresh
  ;   (scanDecls (memGetWord cg1 8) cg1 0)
  ;
  ; and the comment was wrong in the one way that mattered: the
  ; types Vec is never made STALE, so it never needed making
  ; fresh. `emitResolved` scans `allDecls` once (see its
  ; `scanDecls` call) and then sets slot 8 to that same
  ; `allDecls`, so this re-scanned an identical list. Nothing
  ; clears slot 3 - the only writes to it are `scanOne`'s own
  ; appends - and `addTypeNamed` is a bare `vecPush` with no
  ; dedup. So each re-scan appended every constructor and every
  ; struct in the program to the table AGAIN, once per function.
  ;
  ; That is quadratic in both directions at once: the table grew
  ; to functions x types entries, and `lookupType` walks it
  ; linearly, so every constructor reference in every body paid
  ; for all the copies. Measured on synthetic programs of N
  ; two-line functions, best of 3, before this change:
  ;
  ;     N      IR lines    emit-llvm     us/line
  ;   250         1,738      0.0583s        33.5
  ;   500         3,238      0.2085s        64.4
  ;  1000         6,238      0.7986s       128.0
  ;  2000        12,238      3.1028s       253.5
  ;  4000        24,238     12.3580s       509.9
  ;
  ; Doubling the input quadrupled the time, and the per-line cost
  ; doubled with it. On the compiler's own source, lowering was
  ; 54.6s of a 76.0s build - 73% - against 5.0s for `opt`, `llc`
  ; and `cc` together. `scripts/bench-compile.sh` is that
  ; measurement.
  ;
  ; This is the second instance of the defect the concat fix
  ; already recorded (the self-hosting record: "the dominant cost
  ; was not lexing, parsing, checking or lowering - it was the
  ; last line of code generation"). That one was fixed and the
  ; 0.85s it produced was written down; nothing re-measured
  ; afterwards, so this one accumulated behind a stale number.
  ; A function that tail-calls itself gets a loop instead of a
  ; recursion: its parameters move into allocas, a header
  ; label is branched to, and the call assigns and jumps back.
  ; A function that does not is emitted exactly as before -
  ; same registers, same blocks, byte for byte - because most
  ; functions are that, and paying an alloca and two memory
  ; operations per parameter for a loop nobody enters is a
  ; cost with no buyer.
  ; The BARE name, because that is what a self call spells.
  ; `mangleDecl` rewrites an imported function's declaration
  ; name in place to `Mod$name`, so comparing against it
  ; matched nothing for every function in every imported
  ; module - which is all of `core/` and `stdlib/`, and
  ; therefore all of the code this exists to fix. It passed
  ; its test only because the test was an entry file.
  ; MM-LIFE-2d + TCO: the hidden word gets a slot beside
  ; the parameters' - NEVER inside tcoSlots, whose length
  ; gates the rewrite - because a self tail call can
  ; re-instantiate (the word is recomputed and stored per
  ; jump, like any argument). Parked BEFORE the loop
  ; header so the alloca sits in the entry block.
  ; tail-aware emission whenever a leaf needs event 2's
  ; retain, not only when a self call is to be rewritten
  ; The pair variant ALWAYS takes the tail
  ; walk: its leaves are what return, and
  ; `emitExprTail` is where a leaf is
  ; recognised as one a register pair can
  ; carry.
  ; ... and so does a body whose tail is a call
  ; to ANOTHER function: that is where a mutual
  ; tail call becomes `musttail` (`mustTailOK`).
  ; ... and what is left is emitted by the walk.
  ; `cond` is AX2004: the parser builds none, so no pre-pass
  ; lowers one. A variadic `if` arrives as nested `if`s.
  {
    (let name
      (if (strEq (nodeAName node) "main")
        "__axiom_user_main"
        (nodeAName node)))
    (let params (nodeBNames node))
    (let body (nodeCChild node))
    {
      (let paramStr (emitParams params cg 0))
      (let _ (cgSetTmp cg 0))
      (let _2 (vecClear (cgSymNames cg)))
      (let _3 (vecClear (cgSymRegs cg)))
      (let _4 (vecClear (cgSymFloats cg)))
      (let _4b (vecClear (cgSymKinds cg)))
      (let _5 (cgSetParams cg params))
      (let _5r (cgSetTailRetain cg (borrowedTailLeaves cg name body params)))
      (let _5p (cgPendingReset cg))
      (let _5s (vecClear (cgCountedStores cg)))
      (let _6 (cgSetParamFlags cg (functionFlags cg name)))
      {
        (let takesEv (fnTakesEvw cg name))
        {
          (let paramStr2
            (if (== takesEv 0)
              paramStr
              (if (== (strLen paramStr) 0)
                "i64 %__evw.h"
                (concat paramStr ", i64 %__evw.h"))))
          {
            (let hdr
              (if (!= (cgPairMode cg) 0)
                (concat
                  (concat "define { i64, i64 } @"
                    (concat (concat (llvmSym (strDup name)) "$pair") (concat "(" paramStr2)))
                  ") #0 {")
                (concat
                  (concat "define i64 @" (concat (llvmSym (strDup name)) (concat "(" paramStr2)))
                  ") #0 {")))
            {
              (let cg0e
                (cgSetLlvmParams
                  (if (== takesEv 1)
                    (bindSym cg "__evw." "%__evw.h" 0 0)
                    cg)
                  (+ (vecLen params) takesEv)))
              {
                (let cg1
                  (openAllocaMark
                    {
                      (let cgH (emitObfuscationEntry (emitLine cg0e hdr)))
                      (if (== (bodyHasMatch body) 1)
                        (emitLine cgH "  %__scr.h = alloca i64")
                        cgH)
                    }))
                {
                  (let cg1b cg1)
                  {
                    (let selfName (bareOf (nodeAName node)))
                    {
                      (let wantsTCO (tailCallsSelf body selfName (vecLen params)))
                      {
                        (let cg1p
                          (if (&& (== wantsTCO 1) (== takesEv 1))
                            (evwParkSlot cg1b)
                            cg1b))
                        {
                          (let cg1c
                            (if (== wantsTCO 1)
                              (openTailLoop selfName params cg1p)
                              cg1p))
                          {
                            (let cg2
                              (if (|| (!= (cgPairMode cg1c) 0)
                                    (|| (== wantsTCO 1)
                                      (|| (> (vecLen (cgTailRetain cg1c)) 0)
                                        (== (tailCallsKnown cg1c body selfName) 1))))
                                (emitExprTail body cg1c)
                                (emitExpr body cg1c)))
                            {
                              (cgSetTcoName cg2 (None))
                              (cgSetTailOK cg2 0)
                              ; A body that ended by jumping back to the header
                              ; has already terminated its block; a `ret` after it
                              ; is a second terminator and invalid LLVM.
                              (if (== (cgTerminated cg2) 1)
                                {
                                  (cgSetTerminated cg2 0)
                                  (emitLine (closeAllocaMark cg2) "}")
                                }
                                ; MM-LIFE-2c event 2: a function returns its
                                ; result OWNED. A body whose every tail is
                                ; owned already - a construction, a literal,
                                ; an owned-result call, by `inferOwnership` -
                                ; hands back the share it holds and MOVES it;
                                ; a body that can answer a borrowed value - a
                                ; parameter, a field, a binder - retains
                                ; first. The caller then owns exactly one
                                ; share, which is what lets event 3 release a
                                ; `let` bound to a call and `releaseOwnedArgs`
                                ; release a temporary. Only a REFERENCE result
                                ; is retained: a word is never a share.
                                ;
                                ; The remaining coarseness: a body owned on one
                                ; branch and borrowed on another retains the
                                ; merged register, so the owned branch leaks a
                                ; share - the safe direction, as before.
                                ; MM-LIFE-2c event 4's other end: the entry
                                ; retained every reference parameter into its
                                ; slot (`retainRefParams`), the boundary kept
                                ; the slots balanced per jump, and nothing gave
                                ; the LAST iteration's shares back - one share
                                ; of a reference parameter leaked per call of
                                ; every self-recursive function until
                                ; 2026-08-21. Released here, after the tail
                                ; leaf took its own share (event 2) and before
                                ; the `ret`.
                                {
                                  (let cgP
                                    (if (== wantsTCO 1)
                                      (releaseRefParamSlots cg2)
                                      cg2))
                                  {
                                    (let ret
                                      (concat "  ret i64 " (concat (strDup (cgResult cgP)) "")))
                                    (emitLine (emitLine (closeAllocaMark cgP) ret) "}")
                                  }
                                })
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; Both arms enter the same body through distinct noinline helpers.
; Their volatile reads keep the entry opaque at O3. This changes
; neither the value nor the ownership of a parameter.
(pub :: emitObfuscationEntry (-> CG CG))
(pub fn (emitObfuscationEntry cg)
  (if (== (cgObfuscate cg) 0)
    cg
    {
      (emitLine cg "  %obf.a = load volatile i32, ptr @.axiom.obf.a")
      (emitLine cg "  %obf.b = load volatile i32, ptr @.axiom.obf.b")
      (emitLine cg "  %obf.x = xor i32 %obf.a, %obf.b")
      (emitLine cg "  %obf.bit = and i32 %obf.x, 1")
      (emitLine cg "  %obf.test = icmp eq i32 %obf.bit, 0")
      (emitLine cg "  br i1 %obf.test, label %obf.left, label %obf.right")
      (emitLabel cg "obf.left")
      (emitLine cg "  call void @.axiom.obf.left()")
      (emitLine cg "  br label %obf.body")
      (emitLabel cg "obf.right")
      (emitLine cg "  call void @.axiom.obf.right()")
      (emitLine cg "  br label %obf.body")
      (emitLabel cg "obf.body")
      cg
    }))

; The tail LEAVES of a function body that answer a borrowed value -
; `emitExpr` retains each as it is emitted (event 2). Empty unless
; the declared result is a reference and `inferOwnership` found some
; path borrowed. Mirrors `tailOwned`'s walk over the LOWERED body, so
; the node identities are the ones emission meets; a self tail call
; is never a leaf (it becomes a jump, and the eventual non-recursive
; leaf is where the value is produced).
(pub :: borrowedTailLeaves (-> CG String ASTNode Names (Vec ASTNode)))
(pub fn (borrowedTailLeaves cg name body params)
  {
    (let acc vecNew)
    (if (let (Some e) (findFSigCg cg name))
      (if (== (fsigOwned e) 1)
        acc
        (if (let (Some res) (fnDeclaredResultTy (fsigTy e) (fsigArity e)))
          (if (!= (fldClass cg res) 2)
            acc
            {
              (collectTails cg body params vecNew name acc)
              acc
            })
          acc))
      acc)
  })

(pub :: collectTails (-> CG ASTNode Names FlowEnv String (Vec ASTNode) Int))
(pub fn (collectTails cg e params env self acc)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        (if (== (tailOwned cg e params env) 1)
          0
          {
            (vecPush acc e)
            0
          })
        (if (== tg TAG_E_FIELD)
          {
            (vecPush acc e)
            0
          }
          (if (== tg TAG_E_APP)
            {
              (let hd (spineHead e))
              (if (&& (== (nodeTag hd) TAG_E_VAR) (strEq (mangledForCg cg (nodeAName hd)) self))
                0
                (if (== (tailOwnedApp cg e params env) 1)
                  0
                  {
                    (vecPush acc e)
                    0
                  }))
            }
            (if (== tg TAG_E_IF)
              {
                (collectTails cg (nodeBChild e) params env self acc)
                (collectTails cg (nodeCChild e) params env self acc)
              }
              ; `cond` is AX2004: the parser builds none, so no
              ; arm collects one's tails. A variadic `if` arrives
              ; as nested `if`s and walks the arm above.
              (if (== tg TAG_E_MATCH)
                (collectTailsArms cg (nodeBChildren e) params env self acc 0)
                (if (== tg TAG_E_BEGIN)
                  (if (== (vecLen (nodeAChildren e)) 0)
                    0
                    (collectTails cg (vecGet (nodeAChildren e) (- (vecLen (nodeAChildren e)) 1))
                      params env self acc))
                  (if (== tg TAG_E_LET)
                    (collectTails cg (nodeCChild e) params
                      (envWith env (nodeAName e) (tailOwned cg (nodeBChild e) params env)) self acc)
                    (if (== tg TAG_E_LETM)
                      (collectTails cg (nodeCChild e) params (envWith env (nodeAName e) 0) self acc)
                      (if (== tg TAG_E_SET)
                        ; `(set k v)` answers `v`: a leaf when `v` is borrowed
                        (if (== (tailOwned cg e params env) 1)
                          0
                          {
                            (vecPush acc e)
                            0
                          })
                        (if (|| (== tg TAG_E_INT)
                              (|| (== tg TAG_E_FLT)
                                (|| (== tg TAG_E_STR)
                                  (|| (== tg TAG_E_CHAR)
                                    (|| (== tg TAG_E_LAM)
                                      (|| (== tg TAG_E_WHILE)
                                        (|| (== tg TAG_E_SETF)
                                          (|| (== tg TAG_E_STRUCTCON) (== tg TAG_E_REGION)))))))))
                          0
                          ; a shape the walk does not know answers borrowed
                          {
                            (vecPush acc e)
                            0
                          }))))))))))
    }))

(pub :: collectTailsArms (-> CG (Vec ASTNode) Names FlowEnv String (Vec ASTNode) Int Int))
(pub fn (collectTailsArms cg arms params env self acc i)
  (if (>= i (vecLen arms))
    0
    {
      (let arm (vecGet arms i))
      {
        (let bs (patBindersCg (nodeAChild arm) vecNew))
        {
          (collectTails cg (nodeBChild arm) params
            (if (== (as bs Int) 0)
              env
              (envWithAll env bs 0))
            self acc)
          (collectTailsArms cg arms params env self acc (+ i 1))
        }
      }
    }))

; Move every parameter into an alloca, bind it as mutable storage so
; body references load it, and open the loop the tail call jumps back
; to. `bindSym ... 1` is the same registration `mut` locals use, which
; is what makes `emitVar` emit a load without knowing about any of
; this.
; Everything after the last `$`: the source-spelled name of a
; declaration whose node `mangleDecl` may have rewritten to
; `Mod$name`.
(pub :: openTailLoop (-> String Names CG CG))

; Park the evidence word in an alloca and rebind its unspellable
; name as mutable storage, exactly the registration `mut` locals
; use - `emitEvwRead` then loads it without knowing about TCO, and
; `emitTailJump` stores the next iteration's word into it.
(pub :: evwParkSlot (-> CG CG))
(pub fn (evwParkSlot cg)
  {
    (let an (allocReg cg))
    {
      (let ar (regStr an))
      {
        (emitLine cg (concat (concat "  " ar) " = alloca i64"))
        (emitLine cg (concat "  store i64 " (concat "%__evw.h" (concat ", ptr " ar))))
        (bindSym cg "__evw." ar 0 1)
      }
    }
  })

; ------------------------------------------------------------------
; MM-LIFE-2c event 4: the self tail call is a release boundary, and
; the function OWNS its reference parameters across it.
;
; Parameter `i` of the declaration being emitted is a reference iff
; its declared type says so - read off the signature's arrow spine and
; classified by `fldClass`, the same function that writes a block's
; reference map, so every ownership decision in this backend agrees by
; construction. An `Int` parameter is never retained and never
; released, which is why the Life probe's board - a `Vec` behind
; `(-> Int Int Int)` - is untouched by any of this.
; ------------------------------------------------------------------
; `arrowParamTy` lives in `parser.ax` beside `arrowArity`: the effect
; walk needed the same spine read for a different question, and two
; modules that do not import each other had written it twice.
; INSIDE A LIFTED LAMBDA THIS ANSWERS 0, AND THAT IS THE WHOLE OF THE
; FIX FOR A SEGFAULT. `i` indexes word 17, the parameter NAMES being
; emitted; the arrow below comes from word 36, the DECLARATION. Those
; are the same function in a function body and are NOT in a lambda
; body: `emitLamDef` sets 17 to the lambda's own parameters and leaves
; 36 on the enclosing declaration. So parameter `i` of the lambda was
; classified by the type of parameter `i` of the function around it.
;
; The parser curries `(lambda (a b) ...)` into `(lambda (a) (lambda
; (b) ...))`, so the inner record is built while word 17 is the OUTER
; lambda's `(a)` - which is to say every multi-parameter lambda took
; this path. Measured, before this line existed:
;
;   (:: g (-> String Int Int))
;   (fn (g s k) (let ((f (lambda (a b) (+ a b)))) (+ k (f 999999999 2))))
;
; `g`'s parameter 0 is a `String`, so `a` was classified a reference:
; `lamShapeBits` set the closure record's map bit for it and
; `retainParamCaps` emitted `call void @axiom_retain(i64 %a)` on the
; integer 999999999. `axiom_retain` clears its `< 4096` immediate
; guard and loads from `999999983`. Exit 139. Changing only `g`'s
; signature to `(-> Int Int Int)` compiles the same lambda correctly,
; which is the whole diagnosis in one A/B.
;
; Lifted lambdas now carry their checked arrow in pair slot 14. Their
; own parameters are classified from that arrow after resolving type
; placeholders; the enclosing declaration is never used for them.
;
; Three sibling readers of word 36 - `paramFlowBit`, `paramIsHandle`
; and `paramClassOf` - already refuse to trust the pairing, each by
; comparing the params vector it was handed against `(nodeBChildren d)`
; before indexing the arrow. Two did not. A name comparison would not
; have been enough here anyway: a lambda whose parameters happen to
; shadow the function's, same arity and same spelling, passes that
; test and is still a different binding. Word 7 answers the question
; those three approximate.
(pub :: curParamRefClass (-> CG Int Int))
(pub fn (curParamRefClass cg i)
  (if (== (cgLiftedLambda cg) 1)
    (if (let (Some parameter) (signatureParamTy (cgLambdaType cg) i))
      (if (== (fldClass cg (tyResolve parameter)) 2)
        1
        0)
      0)
    {
      (let d (cgCurDecl cg))
      (if (let (Some d) d)
        {
          (let eFound (findFSigCg cg (nodeAName d)))
          (if (let (Some e) eFound)
            (if (== (parameterTypeClass cg (signatureParamTy (fsigTy e) i)) 2)
              1
              0)
            0)
        }
        0)
    }))

; Parameter i's evidence bit when its declared type is one of the
; signature's own type variables and the function takes an evidence
; word; None otherwise. The loop's slot for such a parameter is
; retained and released BY EVIDENCE: a typed reference arriving sets
; the bit, a word does not, which is exactly the share the caller's
; side of MM-LIFE-2d counts.
(pub :: curParamEvBit (-> CG Int (Option Int)))
; The same word-17/word-36 hazard `curParamRefClass` documents, and
; the same answer: None, "not evidence-driven", is this function's
; conservative direction.
(pub fn (curParamEvBit cg i)
  (if (== (cgLiftedLambda cg) 1)
    None
    {
      (let d (cgCurDecl cg))
      (if (let (Some d) d)
        {
          (let eFound (findFSigCg cg (nodeAName d)))
          (if (let (Some e) eFound)
            (if (== (fsigTakesEv e) 0)
              None
              (if (let (Some tn) (signatureParamTy (fsigTy e) i))
                (if (!= (tyIsSrcVar tn) 1)
                  None
                  {
                    (let vars vecNew)
                    {
                      (if (let (Some ty) (fsigTy e))
                        (cgSigVarsInto ty vars)
                        0)
                      (strVecIdx vars (nodeAName tn))
                    }
                  })
                None))
            None)
        }
        None)
    }))

; The entry retain, once per reference parameter, before the loop
; header. It converts the caller's BORROW (event 1) into a share this
; frame owns, which is what makes the boundary release below legal:
; the release hands back a count this retain took, never the caller's.
(pub :: retainRefParams (-> Names CG Int CG))
(pub fn (retainRefParams params cg i)
  (if (>= i (vecLen params))
    cg
    ; a type-variable slot: by the word this
    ; call arrived with
    {
      (let cg1
        (if (== (curParamRefClass cg i) 1)
          (emitRetainOf cg (concat "%" (llvmSym (strDup (vecGetStr params i)))))
          {
            (let k (curParamEvBit cg i))
            (match k
              ((None) cg)
              ((Some k)
                (emitRetainIfEvBit cg (concat "%" (llvmSym (strDup (vecGetStr params i)))) k)
              ))
          }))
      (retainRefParams params cg1 (+ i 1))
    }))

(pub fn (openTailLoop name params cg)
  {
    (let slots vecNew)
    (let hdrN (allocReg cg))
    {
      (let hdrB (labelStr hdrN))
      {
        (allocParamSlots params slots cg 0)
        (retainRefParams params cg 0)
        (cgSetTcoName cg (Some (strDup name)))
        (cgSetTcoSlots cg slots)
        (cgSetTcoLabel cg hdrB)
        (emitLine cg (concat "  br label %" hdrB))
        (emitLabel cg hdrB)
        cg
      }
    }
  })

(pub :: allocParamSlots (-> Names Strings CG Int Int))
(pub fn (allocParamSlots params slots cg i)
  (if (>= i (vecLen params))
    0
    ; `%.sN`: an invented name, so it begins with `.` like every
    ; other one (see `tmpStr`) and no parameter can spell it
    {
      (let pname (vecGetStr params i))
      (let an (allocReg cg))
      {
        (let ar (tmpStr "s" an))
        {
          (emitLine cg (concat (concat "  " ar) " = alloca i64"))
          (emitLine cg
            (concat "  store i64 %" (concat (llvmSym (strDup pname)) (concat ", ptr " ar))))
          ; Kind 2, not 1: the slot is loadable storage exactly as a
          ; `mut` binding's is, which is what makes `emitVar` emit a
          ; load without knowing about tail calls - but `set` must
          ; still refuse it. stage0 rejects `(set p v)` on a
          ; parameter as AX3012 and pre-TCO stage1 refused it too;
          ; binding parameters at kind 1 quietly made them
          ; assignable, and only inside self-recursive functions,
          ; which is the worst kind of divergence: one that depends
          ; on an unrelated property of the function it appears in.
          (bindSym cg pname ar (paramFloatFlag cg i) 2)
          (vecPush slots ar)
          (allocParamSlots params slots cg (+ i 1))
        }
      }
    }))

; Whether parameter `i` of the function being emitted is a float, from
; the signature flags the emitter already carries.
(pub :: paramFloatFlag (-> CG Int Int))
(pub fn (paramFloatFlag cg i)
  (if (let (Some flags) (cgParamFlags cg))
    (if (>= i (vecLen flags))
      0
      (vecGet flags i))
    0))

; The tail jump: every argument is evaluated into its own register
; FIRST, and only then are the parameter slots written. Assigning as
; each argument is computed would clobber a parameter a later argument
; still reads - `(go (- n 1) n)` would see the decremented `n` twice.
(pub :: emitTailJump (-> Nodes ASTNode CG CG))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (emitTailJump args stamp cg)
  {
    (let vals vecNew)
    (let words vecNew)
    {
      (evalTailArgs args vals cg 0)
      ; MM-LIFE-2d: the next iteration's evidence word - computed
      ; from the CURRENT slot value after the arguments evaluate,
      ; stored back before the jump like any reassigned parameter.
      ; The slot exists iff this function is polymorphic (evwParkSlot
      ; bound "__evw." as mutable storage); the tcoSlots vec is
      ; untouched, so the arity gate never sees it.
      ; The type-variable slots' two words: the one this iteration
      ; arrived with (old values are released by it) and the next
      ; iteration's (new values are retained by it), stored back
      ; like any reassigned parameter. Words 0 and 1 of `words`.
      {
        (let slot
          (if (>= (lookupSymKind cg "__evw.") 1)
            (symIndex cg "__evw.")
            None))
        (if (let (Some sidx) slot)
          {
            (let cgO (emitEvwRead cg))
            {
              (let oldW (strDup (cgResult cgO)))
              {
                (let cgV (emitEvWordVal cgO stamp))
                {
                  (let newW (strDup (cgResult cgV)))
                  {
                    (emitLine cgV
                      (concat "  store i64 "
                        (concat newW (concat ", ptr " (strDup (symRegAt cg sidx))))))
                    (vecPush words (as oldW Int))
                    (vecPush words (as newW Int))
                  }
                }
              }
            }
          }
          {
            (vecPush words (as "0" Int))
            (vecPush words (as "0" Int))
          })
      }
      ; MM-LIFE-2c event 4, the boundary itself. RETAIN EVERY NEW
      ; VALUE FIRST, then release every old one, then store - the same
      ; order event 5 uses at a field, and for the same reason: an
      ; iteration that passes a parameter through unchanged, which is
      ; the common shape, would otherwise release the block it is
      ; about to keep. With the retains first the two cancel and the
      ; count is unmoved.
      ;
      ; The old value has to be LOADED before the store overwrites it,
      ; so the release walks the slots twice: once to read, once to
      ; hand back. Reading after `evalTailArgs` is deliberate - an
      ; argument expression may still mention the parameter it is
      ; about to replace.
      ;
      ; A parameter passed through AS ITSELF - `(scan v name (+ i 1))`,
      ; the shape of every linear scan - keeps its slot's block and
      ; its slot's share: the retain and the release would cancel,
      ; and cost two header touches per iteration. Skipped, once the
      ; name still resolves to the slot (a `let` shadowing it is a
      ; different value and pays).
      {
        (let same (tailArgsUnchanged cg (cgTcoSlots cg) args vecNew 0))
        {
          (retainTailVals (cgTcoSlots cg) vals same cg (as (vecGet words 1) String) 0)
          {
            (let olds vecNew)
            {
              (loadTailOlds (cgTcoSlots cg) olds cg 0)
              (storeTailSlots (cgTcoSlots cg) vals cg 0)
              (releaseTailOlds olds same cg (as (vecGet words 0) String) 0)
            }
          }
        }
      }
      ; and an OWNED temporary among the arguments hands its own share
      ; back, exactly as after an ordinary call (`releaseOwnedArgs`):
      ; the boundary retain above is the slot's share, and
      ; `(grind (wide n) (- n 1))` otherwise kept one per iteration
      (releaseTailTemps (cgTcoSlots cg) args vals cg (as (vecGet words 1) String) 0)
      ; and every releasable `let` (and owned scrutinee) still in scope:
      ; their scope ends are past the jump and will not be reached on
      ; this path; the values the slots keep were retained above
      (releasePending cg (cgPendingStrings cg) 0)
      ; and every owning `mut` slot still in scope, by what it holds now
      (releasePendingSlots cg (pairOwningSlots cg) 0)
      (emitLine cg (concat "  br label %" (cgTcoLabel cg)))
      (cgSetTerminated cg 1)
      (cgSetResult cg "0")
      cg
    }
  })

; The STASH summary of the function being emitted - the self call
; is a call to it, and its exit hands back its own slots.
(pub :: curFnStashMask (-> CG Int))
(pub fn (curFnStashMask cg)
  ; through the declaration being emitted (word 36), not the loop
  ; name (word 27): the exit release runs after the loop name is
  ; cleared, and read through it the mask was 0 at every `ret`
  {
    (let d (cgCurDecl cg))
    (if (let (Some d) d)
      {
        (let eFound (findFSigCg cg (nodeAName d)))
        (if (let (Some e) eFound)
          (fsigStash e)
          0)
      }
      0)
  })

(pub :: curFnRetMask (-> CG Int))
(pub fn (curFnRetMask cg)
  {
    (let d (cgCurDecl cg))
    (if (let (Some d) d)
      {
        (let eFound (findFSigCg cg (nodeAName d)))
        (if (let (Some e) eFound)
          (fsigRet e)
          0)
      }
      0)
  })

(pub :: releasePending (-> CG Strings Int CG))
(pub fn (releasePending cg pend i)
  (if (>= i (vecLen pend))
    cg
    (releasePending (emitReleaseOf cg (vecGet pend i)) pend (+ i 1))))

; The owning `mut` slots' half: each entry is a slot record (pair
; slot 17), and what the slot holds is loaded at the jump, since a
; `set` may have replaced the value it was bound to.
(pub struct PendingSlot
  (slot : String)
  (name : String)
  (aliases : Names)
  (unknown : Bool))

(pub :: releasePendingSlots (-> CG (Vec PendingSlot) Int CG))
(pub fn (releasePendingSlots cg pend i)
  (if (>= i (vecLen pend))
    cg
    {
      (let entry (vecGet pend i))
      (releasePendingSlots (releaseSlotValue cg entry.slot) pend (+ i 1))
    }))

; May a mutual tail call's `args` hold the value of an owning slot
; pending from entry i on? A callee borrows its arguments, and the
; caller can't release after a `musttail` call, so such a call stays a
; plain one (MM-EXEC-6c). An argument holds the slot's value when it
; may alias the slot or a binding that may alias it (word 2 of the
; record, `slotAliases`). A slot whose aliases couldn't be listed
; (word 3) answers yes.
(pub :: slotsReachArgs (-> CG (Vec PendingSlot) Nodes Int Int))
(pub fn (slotsReachArgs cg pend args i)
  (if (>= i (vecLen pend))
    0
    {
      (let rec (vecGet pend i))
      (if (if rec.unknown
        true
        (== (namesReachArgs cg rec.aliases args 0) 1))
        1
        (slotsReachArgs cg pend args (+ i 1)))
    }))

(pub :: namesReachArgs (-> CG Names Nodes Int Int))
(pub fn (namesReachArgs cg names args i)
  (if (>= i (vecLen names))
    0
    (if (== (argsMayAlias cg (vecGetStr names i) args 0) 1)
      1
      (namesReachArgs cg names args (+ i 1)))))

; Does any of `args` from i on hold a value that may alias `name`?
(pub :: argsMayAlias (-> CG String Nodes Int Int))
(pub fn (argsMayAlias cg name args i)
  (if (>= i (vecLen args))
    0
    (if (== (mayAlias cg name (vecGet args i) (binderSummary (vecGet args i))) 1)
      1
      (argsMayAlias cg name args (+ i 1)))))

; The temporary's OWN share, always: the boundary retain above is
; the slot's, and a parameter this function parks keeps the slot's
; share for the stash (`releaseTailOlds` and the exit leave it), not
; the temporary's as well.
(pub :: releaseTailTemps (-> Strings Nodes Strings CG String Int CG))
(pub fn (releaseTailTemps slots args vals cg newW i)
  (if (>= i (vecLen slots))
    cg
    ; a lambda is born at count 1 and the slot (an
    ; arrow, a reference class) took its own
    ; the slot took a share iff the bit
    ; is set, and then the temporary's
    ; own share goes back
    ;
    ; A temporary that IS a string literal owns nothing to hand
    ; back: releasing a `-1`-sentinel static is the runtime no-op
    ; `isStaticSentinelNode` already names at the argument, field
    ; and `let` scope-end sites. The boundary retain above is
    ; untouched - retain-without-release on a static is the same
    ; shape the argument path has shipped since 2026-08-31 - and
    ; the conditional arm below is skipped with it, because the
    ; value is a static whatever the evidence bit claims.
    {
      (let owned
        (if (== (isStaticSentinelNode cg (vecGet args i)) 1)
          0
          (if (== (valueOwnedRef cg (vecGet args i)) 1)
            1
            (if (== (nodeTag (vecGet args i)) TAG_E_LAM)
              1
              0))))
      {
        (let cg1
          (if (== owned 0)
            cg
            (if (== (curParamRefClass cg i) 1)
              (emitReleaseOf cg (vecGetStr vals i))
              {
                (let k (curParamEvBit cg i))
                (match k
                  ((None) cg)
                  ((Some k)
                    (emitRcIfBitOf cg (as (vecGet vals i) String) k newW 0)
                  ))
              })))
        (releaseTailTemps slots args vals cg1 newW (+ i 1))
      }
    }))

; Load and release the current value of every reference parameter's
; slot - the entry retain's counterpart, on the return path. Word 2
; (the function's result register) survives the loads.
(pub :: releaseRefParamSlots (-> CG CG))
(pub fn (releaseRefParamSlots cg)
  {
    (let v (strDup (cgResult cg)))
    (let fl (cgResultFloat cg))
    (let slots (cgTcoSlots cg))
    {
      (let cgR (releaseRefParamSlotsFrom cg slots 0))
      {
        (cgSetResult cgR v)
        (cgSetResultFloat cgR fl)
        cgR
      }
    }
  })

(pub :: releaseRefParamSlotsFrom (-> CG Strings Int CG))
(pub fn (releaseRefParamSlotsFrom cg slots i)
  (if (>= i (vecLen slots))
    cg
    (if (!=
          (& (| (curFnStashMask cg) (paramsOf (wordParts (curFnRetMask cg))))
            (| (paramBit i) (ownerBit i)))
          0)
      ; a parameter this very function parks a word of, or
      ; ANSWERS a WORD of (`(cast Int s)` as the tail) - the
      ; slot's share is what keeps that word alive, on the way
      ; out too. A typed answer is the leaf's own retain (event
      ; 2), and the slot's share goes back
      (releaseRefParamSlotsFrom cg slots (+ i 1))
      (if (== (curParamRefClass cg i) 1)
        {
          (let cgL (loadFromSlot cg (vecGet slots i)))
          (releaseRefParamSlotsFrom (emitReleaseOf cgL (strDup (cgResult cgL))) slots (+ i 1))
        }
        {
          (let k (curParamEvBit cg i))
          (match k
            ((None) (releaseRefParamSlotsFrom cg slots (+ i 1)))
            ((Some k)
              {
                (let cgL (loadFromSlot cg (vecGet slots i)))
                {
                  (let v (strDup (cgResult cgL)))
                  {
                    (let cgW (emitEvwRead cgL))
                    (releaseRefParamSlotsFrom (emitRcIfBitOf cgW v k (strDup (cgResult cgW)) 0)
                      slots (+ i 1))
                  }
                }
              }
            ))
        }))))

(pub :: retainTailVals (-> Strings Strings Ints CG String Int CG))
(pub fn (retainTailVals slots vals same cg newW i)
  (if (>= i (vecLen slots))
    cg
    {
      (let cg1
        (if (== (vecGet same i) 1)
          cg
          (if (== (curParamRefClass cg i) 1)
            (emitRetainOf cg (vecGetStr vals i))
            {
              (let k (curParamEvBit cg i))
              (match k
                ((None) cg)
                ((Some k)
                  (emitRcIfBitOf cg (as (vecGet vals i) String) k newW 1)
                ))
            })))
      (retainTailVals slots vals same cg1 newW (+ i 1))
    }))

; Flag per slot: 1 when argument i is the VAR of parameter i and the
; name still names the slot.
(pub :: tailArgsUnchanged (-> CG Strings Nodes Ints Int Ints))
(pub fn (tailArgsUnchanged cg slots args out i)
  (if (>= i (vecLen slots))
    out
    {
      (let a (vecGet args i))
      {
        (vecPush out
          (if (!= (nodeTag a) TAG_E_VAR)
            0
            (match (symIndex cg (nodeAName a))
              ((None) 0)
              ((Some ri)
                (if (strEq (symRegAt cg ri) (vecGet slots i))
                  1
                  0)
              ))))
        (tailArgsUnchanged cg slots args out (+ i 1))
      }
    }))

(pub :: loadTailOlds (-> Strings Strings CG Int CG))
(pub fn (loadTailOlds slots olds cg i)
  (if (>= i (vecLen slots))
    cg
    {
      (if (|| (== (curParamRefClass cg i) 1) (isSome (curParamEvBit cg i)))
        {
          (loadFromSlot cg (vecGet slots i))
          (vecPush olds (strDup (cgResult cg)))
        }
        (vecPush olds ""))
      (loadTailOlds slots olds cg (+ i 1))
    }))

; Not a parameter this function parks a word of: the iteration that
; parked it left the slot's share as the stash's keeper, and the
; jump must not take it back.
(pub :: releaseTailOlds (-> Strings Ints CG String Int CG))
(pub fn (releaseTailOlds olds same cg oldW i)
  (if (>= i (vecLen olds))
    cg
    {
      (let cg1
        (if (|| (== (vecGet same i) 1) (!= (& (curFnStashMask cg) (| (paramBit i) (ownerBit i))) 0))
          cg
          (if (== (curParamRefClass cg i) 1)
            (emitReleaseOf cg (vecGetStr olds i))
            {
              (let k (curParamEvBit cg i))
              (match k
                ((None) cg)
                ((Some k)
                  (emitRcIfBitOf cg (as (vecGet olds i) String) k oldW 0)
                ))
            })))
      (releaseTailOlds olds same cg1 oldW (+ i 1))
    }))

; A parameter slot is an `alloca`; reading it is the same load
; `emitVar` emits for a kind-2 binding, without going through the
; symbol table (the slot is what we hold, not the name).
(pub :: loadFromSlot (-> CG String CG))
(pub fn (loadFromSlot cg slot)
  {
    (let rn (allocReg cg))
    {
      (let r (regStr rn))
      {
        (emitLine cg (concat (concat "  " r) (concat " = load i64, ptr " (concat slot ""))))
        (cgSetResult cg r)
        cg
      }
    }
  })

(pub :: evalTailArgs (-> Nodes Strings CG Int Int))
;@axiom:effect(io)
(pub fn (evalTailArgs args vals cg i)
  (if (>= i (vecLen args))
    0
    {
      (emitExpr (vecGet args i) cg)
      (vecPush vals (strDup (cgResult cg)))
      (evalTailArgs args vals cg (+ i 1))
    }))

(pub :: storeTailSlots (-> Strings (Vec a) CG Int Int))
(pub fn (storeTailSlots slots vals cg i)
  (if (>= i (vecLen slots))
    0
    {
      (emitLine cg
        (concat "  store i64 " (concat (vecGetStr vals i) (concat ", ptr " (vecGet slots i)))))
      (storeTailSlots slots vals cg (+ i 1))
    }))

; ------------------------------------------------------------------
; Does `e` contain a call to `name` with `arity` arguments in TAIL
; position?
;
; Asked before a function is emitted so that the overwhelming majority
; of functions - which self-recurse nowhere - keep emitting exactly the
; LLVM they emitted before, parameters as SSA values and no loop
; header. Only a function that will actually use the loop pays for it.
;
; TAIL POSITION is the whole correctness question. Rewriting a call
; that is *not* in tail position does not crash; it returns the wrong
; answer, because the work waiting on the call's result never happens.
; So the positions here are exactly stage0's, and no others: the last
; expression of a `{}` block, both arms of an `if`, the body of a
; `let`, and the expression itself.
; ------------------------------------------------------------------
(pub :: tailCallsSelf (-> ASTNode String Int Int))
(pub fn (tailCallsSelf e name arity)
  {
    (let tag (nodeTag e))
    (if (== tag TAG_E_APP)
      (if (&& (strEq (spineHeadName e) name) (== (spineArgs e 0) arity))
        1
        0)
      (if (== tag TAG_E_BEGIN)
        {
          (let v (nodeAChildren e))
          (if (== (vecLen v) 0)
            0
            (tailCallsSelf (vecGet v (- (vecLen v) 1)) name arity))
        }
        (if (== tag TAG_E_IF)
          (if (== (tailCallsSelf (nodeBChild e) name arity) 1)
            1
            (tailCallsSelf (nodeCChild e) name arity))
          (if (== tag TAG_E_MATCH)
            (armsCallSelf (nodeBChildren e) name arity 0)
            (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
              (if (strEq (nodeAName e) name)
                0
                (tailCallsSelf (nodeCChild e) name arity))
              0)))))
  })

; A `let` body IS a tail position, since 2026-08-22. It was not, for
; two defects that following stage0's omission avoided: a `mut`
; binding inside the loop re-executed its `alloca` on every iteration
; and grew the stack without bound - every `alloca` now sits in the
; entry block (`openAllocaMark`), so no binding allocates per
; iteration - and a local shadowing the function's own name
; (`(let ((f (lambda ...))) (f x))`) became a jump to the function
; instead of a call to the local - `dispatchCall` resolves the head
; as a local before it considers the rewrite, and a `let` binding the
; name itself is refused here too. What made it worth taking: event
; 3 releases a `let`'s temporary AFTER the self call it wraps, and
; that release is what stopped LLVM's own sibling-call pass from
; rescuing `(let ((s (concat s "x"))) (grow s (- n 1)))` - 200,000
; deep, it overflowed where the leaking compiler had not. A `mut`
; body, a `while` body and `&&`/`||` operands are still not tail
; positions.
(pub :: armsCallSelf (-> (Vec ASTNode) String Int Int Int))
(pub fn (armsCallSelf arms name arity i)
  (if (>= i (vecLen arms))
    0
    (if (== (tailCallsSelf (nodeBChild (vecGet arms i)) name arity) 1)
      1
      (armsCallSelf arms name arity (+ i 1)))))

; Does `e` contain, in TAIL position, a call to a DEFINED function
; other than `self`, applied to exactly its arity? The same positions
; as `tailCallsSelf`, and only a pre-scan: it decides whether a body
; takes the tail walk at all (`emitFnDef`), so that a function with no
; such call keeps emitting exactly the LLVM it emitted before. Whether
; the call is then marked `musttail` is `mustTailOK`'s decision at the
; call, with the facts only emission has.
(pub :: tailCallsKnown (-> CG ASTNode String Int))
(pub fn (tailCallsKnown cg e self)
  {
    (let tag (nodeTag e))
    (if (== tag TAG_E_APP)
      {
        (let h (spineHeadName e))
        (if (== (strLen h) 0)
          0
          (if (strEq h self)
            0
            {
              (let ar (fnDefArityCg cg h))
              (if (&& (>= ar 0) (== (spineArgs e 0) ar))
                1
                0)
            }))
      }
      (if (== tag TAG_E_BEGIN)
        {
          (let v (nodeAChildren e))
          (if (== (vecLen v) 0)
            0
            (tailCallsKnown cg (vecGet v (- (vecLen v) 1)) self))
        }
        (if (== tag TAG_E_IF)
          (if (== (tailCallsKnown cg (nodeBChild e) self) 1)
            1
            (tailCallsKnown cg (nodeCChild e) self))
          (if (== tag TAG_E_MATCH)
            (armsCallKnown cg (nodeBChildren e) self 0)
            (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
              (tailCallsKnown cg (nodeCChild e) self)
              0)))))
  })

(pub :: armsCallKnown (-> CG (Vec ASTNode) String Int Int))
(pub fn (armsCallKnown cg arms self i)
  (if (>= i (vecLen arms))
    0
    (if (== (tailCallsKnown cg (nodeBChild (vecGet arms i)) self) 1)
      1
      (armsCallKnown cg arms self (+ i 1)))))

; The head of an application spine, as a name, or "" when the head is
; not a plain name.
(pub :: spineHeadName (-> ASTNode String))
(pub fn (spineHeadName e)
  (if (== (nodeTag e) TAG_E_APP)
    (spineHeadName (nodeAChild e))
    (if (== (nodeTag e) TAG_E_VAR)
      (nodeAName e)
      "")))

; ------------------------------------------------------------------
; Emit `e` knowing it sits in tail position.
;
; Everything here either delegates to `emitExpr` unchanged or hands
; tail position to exactly the sub-expression that inherits it. The
; only thing it does differently is set `tailOK` for an application,
; which is what lets `dispatchCall` recognise the one call it may
; rewrite.
; ------------------------------------------------------------------
(pub :: emitExprTail (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitExprTail e cg)
  ; While the pair variant is being emitted, a tail leaf that is one of
  ; the two shapes a register pair can carry returns it directly - no
  ; block, and no `ret` for `emitFnDef` to write afterwards. Every
  ; other expression, and every leaf in the ordinary variant, takes the
  ; path below unchanged.
  {
    (let pen
      (if (!= (cgPairMode cg) 0)
        (pairLeafEntry cg e)
        (None)))
    (if (let (Some entry) pen)
      (emitPairRet e entry cg)
      ; A forwarding leaf hands its callee's two registers straight
      ; back. `pairFwdOK` is re-asked here with the names the symbol
      ; table holds, so a head that a `let` has bound is a closure
      ; call and takes the ordinary path below.
      (if (if (!= (cgPairMode cg) 0)
        (== (pairFwdOK cg e (pairBoundNames cg e)) 1)
        false)
        (emitPairFwd e cg)
        {
          (let tag (nodeTag e))
          (if (== tag TAG_E_APP)
            {
              ; A transferred result already fulfils the return's ownership
              ; obligation, whether the callee transfers it or emitPlainCall
              ; protects it before releasing a temporary holder.
              (let protectedResult (!= (transferClass cg e) 0))
              ; 3 when nothing follows the call but the `ret` - no leaf
              ; retain is owed for this node - which is what a `musttail`
              ; needs (`mustTailOK`); 1 when `retainTailLeaf` will retain
              ; after it. Both read as "tail" in `dispatchCall`.
              (cgSetTailOK cg
                (if (== (nodeInVec (cgTailRetain cg) e 0) 1)
                  1
                  3))
              {
                (let cgA (emitExpr e cg))
                {
                  (cgSetTailOK cgA 0)
                  (if protectedResult
                    cgA
                    (retainTailLeaf e cgA))
                }
              }
            }
            (if (== tag TAG_E_BEGIN)
              (emitSeqTail (nodeAChildren e) cg 0)
              (if (== tag TAG_E_IF)
                (emitIfTail e cg)
                (if (== tag TAG_E_MATCH)
                  ; A match the tail emitter could only lower BOXED - a
                  ; reference-carrying pair whose scrutinee is releasable -
                  ; is emitted as the ordinary match instead and its value
                  ; treated as the tail leaf it is. `emitMatch` reads the
                  ; registers and releases per arm; what the arms lose is
                  ; tail position, which `tailCallsSelf` never granted a
                  ; self call under this shape anyway (the arm is emitted
                  ; as a call, not a jump). So EVERY match `pairMatchOK`
                  ; admits is unboxed, and the checker mirrors that rule
                  ; without a tail-position case (`tcPairMatchSite`).
                  (if (== (pairTailDelegates cg e) 1)
                    (retainTailLeaf e (emitMatch e cg))
                    (emitMatchTail e cg))
                  ; a `let`'s body inherits tail position: the leaf retain, and
                  ; the self call under it is rewritten like any other (its
                  ; pending temporary is paid at the jump, `emitTailJump`)
                  (if (== tag TAG_E_LET)
                    (emitLetAt e cg 1)
                    (if (== tag TAG_E_LETM)
                      (emitLetMAt e cg 1)
                      (retainTailLeaf e (emitExpr e cg))))))))
        }))
  })

; Every expression of a block but the last is ordinary; the last
; inherits tail position.
(pub :: emitSeqTail (-> (Vec ASTNode) CG Int CG))
;@axiom:effect(io)
(pub fn (emitSeqTail exprs cg i)
  (if (>= i (vecLen exprs))
    cg
    (if (== i (- (vecLen exprs) 1))
      (emitExprTail (vecGet exprs i) cg)
      ; the same discard rule as emitSeq - a TCO loop body is
      ; exactly where a per-iteration build-and-drop lives
      {
        (let e (vecGet exprs i))
        {
          (let cg1 (emitExpr e cg))
          {
            (let cg2
              (if (== (valueOwnedRef cg1 e) 1)
                (emitReleaseOf cg1 (strDup (cgResult cg1)))
                cg1))
            (emitSeqTail exprs cg2 (+ i 1))
          }
        }
      })))

; `match` in tail position: every arm body inherits it. This is the
; shape most recursive Axiom is written in - a walk over a `data`
; value - so leaving it out meant the optimisation missed the case it
; is most wanted for.
;
; Easier than `if`, because a match already routes its result through
; a heap cell rather than a phi: an arm that ends in a jump simply
; does not store and does not branch to the merge. And the merge block
; can never become unreachable, because the no-arm-matched fallback
; always branches to it.
(pub :: emitMatchTail (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitMatchTail node cg)
  ; The tail hook, armed only where there is nothing to release -
  ; see `emitPairArmsTail`. `scrutineeReleasable` is asked first
  ; because it decides whether the pair path is even open here.
  ; A pair whose every payload is a MACHINE WORD carries no share,
  ; so there is nothing the tail arms could fail to release and the
  ; hook is armed whatever `scrutineeReleasable` says. A pair with a
  ; reference arm - `(Option String)`, `(Result Int Error)` - is
  ; armed here only when the scrutinee is not releasable; when it
  ; is, `emitExprTail` never reaches this emitter (`pairTailDelegates`
  ; routes the match to `emitMatch`), so the arming below is
  ; complete: every match `pairMatchOK` admits is read from
  ; registers, by one emitter or the other.
  {
    (let scrutExpr (nodeAChild node))
    (let arms (nodeBChildren node))
    (let ff (memAlloc 8))
    (let _0 (memSetWord ff 0 (- 0 1)))
    (let _a
      (if (== (pairMatchOK cg scrutExpr arms) 1)
        (if (||
              (==
                (match (pairScrutRetTy cg scrutExpr)
                  ((None) 0)
                  ((Some ty) (pairWordOnly cg ty)))
                1)
              (== (tailScrutineeReleasable node scrutExpr cg) 0))
          (cgSetPairArm cg 1)
          cg)
        cg))
    (let cg1 (emitExpr scrutExpr cg))
    (let gotPair (cgPairArm cg1))
    (let _z (cgSetPairArm cg1 0))
    (let sv (strDup (cgResult cg1)))
    (let tagR
      (if (== gotPair 2)
        (strDup (pairTagReg cg1))
        ""))
    (let cn (allocReg cg1))
    (let cell (regStr cn))
    (let _1
      (emitLine cg1 (concat (concat "  " cell) (concat " = ptrtoint ptr %__scr.h to i64" ""))))
    (let mn (allocReg cg1))
    (let mergeB (labelStr mn))
    (let held
      (if (== gotPair 2)
        0
        (placeScrutHeld node scrutExpr cg1 1)))
    (let _h
      (if (== held 1)
        (emitRetainOf cg1 sv)
        cg1))
    (let rel
      (if (== gotPair 2)
        0
        (if (== held 1)
          1
          (tailScrutineeReleasable node scrutExpr cg1))))
    (let pmark (vecLen (cgPendingStrings cg1)))
    (let _p
      (if (== rel 1)
        (cgPendingPush cg1 sv)
        0))
    (let cg2
      (if (== gotPair 2)
        (emitPairArmsTail arms tagR sv cell mergeB cg1 0 ff)
        (emitArmsTail arms sv cell mergeB cg1 0 ff)))
    (let _q (cgPendingTruncate cg2 pmark))
    (let _2 (emitLabel cg2 mergeB))
    (let cg3 (loadWordAt cg2 cell 0))
    (let armFlag (memGetWord ff 0))
    (let _3
      (cgSetResultFloat cg3
        (if (== armFlag (- 0 1))
          0
          armFlag)))
    (let _4 (cgSetTerminated cg3 0))
    (if (== rel 1)
      (releaseScrutinee sv cg3 scrutExpr)
      cg3)
  })

(pub :: emitArmsTail (-> (Vec ASTNode) String String String CG Int Int CG))
;@axiom:effect(io)
(pub fn (emitArmsTail arms sv cell mergeB cg i ff)
  (if (>= i (vecLen arms))
    ; the explicit fall-through zero - see emitArms' comment
    {
      (storeWordAt cg cell 0 "0")
      (emitLine cg (concat "  br label %" mergeB))
      cg
    }
    ; An arm that jumped back to the loop header has
    ; nothing to store and nowhere to fall through to.
    {
      (let arm (vecGet arms i))
      (let pat (nodeAChild arm))
      (let body (nodeBChild arm))
      (let nn (allocReg cg))
      (let nextB (labelStr nn))
      (let mark (symMark cg))
      {
        (let cgP (emitPatMatch pat (strDup sv) nextB cg 0))
        {
          (let cgB (emitExprTail body cgP))
          (let _ff
            (if (== i 0)
              (memSetWord ff 0 (cgResultFloat cgB))
              0))
          {
            (let termd (cgTerminated cgB))
            {
              (if (! (== termd 1))
                {
                  (storeWordAt cgB cell 0 (strDup (cgResult cgB)))
                  (emitLine cgB (concat "  br label %" mergeB))
                })
              (cgSetTerminated cgB 0)
              (emitLabel cgB nextB)
              (symRestore cgB mark)
              (emitArmsTail arms sv cell mergeB cgB (+ i 1) ff)
            }
          }
        }
      }
    }))

; `if` in tail position. Both arms inherit, and either may end with a
; branch back to the loop header instead of a value - so the merge
; block and its phi have to be built from whichever arms actually
; reach them. A phi naming a predecessor that jumped elsewhere is
; invalid LLVM, and a second terminator in a block is too.
(pub :: emitIfTail (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitIfTail node cg)
  {
    (let testExpr (nodeAChild node))
    (let thenExpr (nodeBChild node))
    (let elseExpr (nodeCChild node))
    (let cg1 (emitExpr testExpr cg))
    (let testReg (strDup (cgResult cg1)))
    (let cmpN (allocReg cg1))
    (let thenLbl (allocReg cg1))
    (let elseLbl (allocReg cg1))
    (let mergeLbl (allocReg cg1))
    (let cmpR (regStr cmpN))
    (let thenB (labelStr thenLbl))
    (let elseB (labelStr elseLbl))
    (let mergeB (labelStr mergeLbl))
    (let _1
      (emitLine cg1 (concat (concat "  " cmpR) (concat " = icmp ne i64 " (concat testReg ", 0")))))
    (let _2
      (emitLine cg1
        (concat (concat "  br i1 " (concat cmpR ", label %"))
          (concat thenB (concat (concat ", label %" elseB) "")))))
    (let _3 (emitLabel cg1 thenB))
    (let cg2 (emitExprTail thenExpr cg1))
    (let thenTerm (cgTerminated cg2))
    (let thenVal (strDup (cgResult cg2)))
    (let thenFlag (cgResultFloat cg2))
    (let thenPred (strDup (cgBlock cg2)))
    (let _4
      (if (== thenTerm 1)
        0
        {
          (emitLine cg2 (concat "  br label %" mergeB))
          0
        }))
    (let _4b (cgSetTerminated cg2 0))
    (let _5 (emitLabel cg2 elseB))
    (let cg3 (emitExprTail elseExpr cg2))
    (let elseTerm (cgTerminated cg3))
    (let elseVal (strDup (cgResult cg3)))
    (let elsePred (strDup (cgBlock cg3)))
    (let _6
      (if (== elseTerm 1)
        0
        {
          (emitLine cg3 (concat "  br label %" mergeB))
          0
        }))
    (if (&& (== thenTerm 1) (== elseTerm 1))
      ; Neither arm falls through: the whole `if` is a jump, there is
      ; nothing to merge, and the caller must not emit a `ret`.
      {
        (cgSetTerminated cg3 1)
        cg3
      }
      (if (== thenTerm 1)
        ; Only the else arm reaches the merge, so its value is the
        ; result outright - a phi with one incoming edge would be
        ; legal but pointless.
        {
          (emitLabel cg3 mergeB)
          (cgSetResult cg3 elseVal)
          (cgSetResultFloat cg3 (cgResultFloat cg3))
          (cgSetTerminated cg3 0)
          cg3
        }
        (if (== elseTerm 1)
          {
            (emitLabel cg3 mergeB)
            (cgSetResult cg3 thenVal)
            (cgSetResultFloat cg3 thenFlag)
            (cgSetTerminated cg3 0)
            cg3
          }
          {
            (let _7 (emitLabel cg3 mergeB))
            (let phiN (allocReg cg3))
            {
              (let phiR (regStr phiN))
              {
                (emitLine cg3
                  (concat (concat (concat "  " phiR) (concat " = phi i64 [ " thenVal))
                    (concat (concat ", %" (concat thenPred " ], [ "))
                      (concat (concat elseVal (concat ", %" elsePred)) " ]"))))
                (cgSetResult cg3 phiR)
                (cgSetResultFloat cg3 thenFlag)
                (cgSetTerminated cg3 0)
                cg3
              }
            }
          })))
  })

(pub :: emitParams (-> Names CG Int String))
(pub fn (emitParams params cg i)
  (if (>= i (vecLen params))
    ""
    {
      (let pname (vecGetStr params i))
      (let rest (emitParams params cg (+ i 1)))
      (if (== (strLen rest) 0)
        (concat "i64 %" (concat (llvmSym (strDup pname)) ""))
        (concat (concat "i64 %" (concat (llvmSym (strDup pname)) ", ")) (concat rest "")))
    }))

; ------------------------------------------------------------------
; Lambda expressions: capture, lifting, and the record convention.
;
; A lambda is lifted to a fresh top-level function `_lam_N` whose
; hidden first parameter `%.env` is the closure record: word 0 the
; code pointer, words 1.. the captured values. `emitIndirectCall`
; passes the record itself as that first argument on every call
; through a value, so a record built from a *bare top-level function*
; cannot point at the function directly - its parameters would shift
; by one. It points at a forwarding thunk (`_thunk_N`) that ignores
; the record and calls the function with the arguments unshifted.
; stage0 solves the same problem the other way, by giving every
; function the hidden parameter; either convention is sound alone,
; and the conformance suite observes exit codes, not symbol tables.
;
; Capture is by value, and captures *everything in scope* - every
; parameter of, and every binding in, the enclosing function that the
; lambda does not shadow with a parameter of its own - rather than
; walking the body for its free variables. The extra record words are
; unobservable, and the free-variable walker they replace is the kind
; of code whose one missed case (a pattern binder, a nested arm's
; variable) is a silent wrong capture. Each name is captured once,
; at its current resolution - `emitVar` does the resolving, so a
; `mut` binding is captured as the value it holds when the record is
; built, which is stage0's snapshot semantics too.
; ------------------------------------------------------------------
; The names a lambda captures: every parameter and local in scope
; that its body MENTIONS (a nested lambda's mentions included), and
; the evidence word, which a polymorphic construction inside the
; body reads without naming. Until 2026-08-22 every name in scope
; was captured, mentioned or not, and a loop building a closure per
; iteration chained each to the one before it through a parameter
; the body never used.
; Is this the unspellable name of a lambda-argument evidence word?
; `"__evwa."` or `"__evwa.<d>"`; no Axiom identifier can spell either.
(pub :: isEvwaName (-> String Int))
(pub fn (isEvwaName n)
  (if (strStartsWith n "__evwa.")
    1
    0))

; The name that word takes ONE LEVEL FURTHER OUT, which is what it
; becomes when a nested lambda captures it: the enclosing lambda's own
; word (`"__evwa."`) is the inner lambda's depth 1, and so on. The
; shift happens at the bind, so each lambda's own parameter always
; owns depth 0 and nothing has to renumber a witness after the fact.
(pub :: evwaDeeper (-> String String))
(pub fn (evwaDeeper n)
  {
    (let suf (strSlice n 7 (- (strLen n) 7)))
    (if (== (strLen suf) 0)
      "__evwa.1"
      (concat "__evwa." (fmtInt (+ 1 (strToInt suf)))))
  })

(pub :: collectCapNames (-> CG Strings ASTNode Strings))
(pub fn (collectCapNames cg lparams body)
  {
    (let out vecNew)
    {
      (if (let (Some params) (cgParams cg))
        (capFromVec params lparams body out 0))
      (capFromVec (cgSymNames cg) lparams body out 0)
      out
    }
  })

; Each name is read with `vecGetStr`, as `pruneRebuild` reads its lines,
; so `out` does not count as holding parts of `src`.
(pub :: capFromVec (-> Strings Strings ASTNode Strings Int Int))
(pub fn (capFromVec src lparams body out i)
  (if (>= i (vecLen src))
    0
    {
      {
        (let name (vecGetStr src i))
        (if (! (>= (strIndexIn lparams name) 0))
          (if (! (>= (strIndexIn out name) 0))
            ; `"__evw."` is the enclosing FUNCTION's word and
            ; `"__evwa."*` are the enclosing LAMBDAS' - a body reads
            ; either without naming it, so `mentions` cannot see
            ; them and they are taken unconditionally. Without the
            ; second, `(lambda (a b) (vecPush box a))` stored `a`
            ; uncounted: by the time the store runs `a` is a capture
            ; in the inner lambda, and the word that classifies it
            ; belonged to the outer one.
            (if (|| (strEq name "__evw.") (|| (== (isEvwaName name) 1) (== (mentions name body) 1)))
              (vecPush out name))))
      }
      (capFromVec src lparams body out (+ i 1))
    }))

(pub :: strIndexIn (-> (Vec a) String Int))
(pub fn (strIndexIn v name)
  (if (== (as v Int) 0)
    (- 0 1)
    (strIndexFrom v name 0)))

(pub :: strIndexFrom (-> (Vec a) String Int Int))
(pub fn (strIndexFrom v name i)
  (if (>= i (vecLen v))
    (- 0 1)
    (if (strEq (vecGetStr v i) name)
      i
      (strIndexFrom v name (+ i 1)))))

; Evaluate each captured name in the enclosing scope, recording the
; value register and its float-ness. Goes through `emitVar` so a
; mutable binding is loaded, not aliased.
(pub :: capValues (-> CG (Vec a) Strings Ints Int CG))
;@axiom:effect(io)
(pub fn (capValues cg capNames capRegs capFloats i)
  (if (>= i (vecLen capNames))
    cg
    {
      (let cg1 (emitVar (mkEVar (vecGetStr capNames i)) cg))
      {
        (vecPush capRegs (strDup (cgResult cg1)))
        (vecPush capFloats
          (+ (cgResultFloat cg1)
            (if (captureCounted cg1 (vecGetStr capNames i))
              2
              0)))
        (capValues cg1 capNames capRegs capFloats (+ i 1))
      }
    }))

; A lifted lambda, waiting for the enclosing function to close:
; word 0 name, word 1 params, word 2 body, word 3 capture names,
; word 4 capture float/count flags, word 5 checked arrow.
(pub struct LamDesc
  (name : String)
  (params : Names)
  (body : ASTNode)
  (captures : Names)
  (flags : Ints)
  (arrow : (Option ASTNode)))

(pub :: mkLamDesc (-> String Strings ASTNode Names Ints (Option ASTNode) LamDesc))
(pub fn (mkLamDesc lname lparams body capNames capFloats resultTy)
  (LamDesc
    :name lname
    :params lparams
    :body body
    :captures capNames
    :flags capFloats
    :arrow resultTy))

(pub :: emitLambda (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitLambda node cg)
  (emitLambdaAt node cg false))

; A recovery call's immediate thunk stays in its arming frame. An
; inner reset can reclaim every arena allocation after the shared
; mark, including a heap closure the compiler made for an outer thunk.
; Releasing that reclaimed closure would file storage still named by
; the bump pointer. A frame cell remains live across the reset, and a
; zero byte count in its shape keeps its later release out of slabs.
; The reference map still gives its captured shares back on return.
(pub :: emitLambdaAt (-> ASTNode CG Bool CG))
;@axiom:effect(io)
(pub fn (emitLambdaAt node cg scoped)
  {
    (let lparams (nodeANames node))
    (let body (nodeBChild node))
    (let n (cgLamN cg))
    {
      (let lname (concat "_lam_" (fmtInt n)))
      (let capNames (collectCapNames cg lparams body))
      (let capRegs vecNew)
      (let capFloats vecNew)
      {
        (cgSetLamN cg (+ n 1))
        (capValues cg capNames capRegs capFloats 0)
        {
          (let k (vecLen capNames))
          (let pn (allocReg cg))
          (let fn2 (allocReg cg))
          {
            (let pr (regStr pn))
            (let fr (tmpStr "f" fn2))
            {
              (if scoped
                {
                  (let cell (regStr (allocReg cg)))
                  (let base (regStr (allocReg cg)))
                  {
                    (emitRecoverCell cg cell (fmtInt (+ k 3)))
                    (emitLine cg
                      (concat "  "
                        (concat base (concat " = ptrtoint ptr " (concat cell " to i64")))))
                    (emitLine cg
                      (concat "  " (concat pr (concat " = add i64 " (concat base ", 16")))))
                  }
                }
                (emitLine cg
                  (concat
                    (concat (concat "  " pr)
                      (concat " = call i64 @axiom_alloc(i64 " (fmtInt (* (+ k 1) 8))))
                    ")")))
              (emitLine cg
                (concat (concat "  " fr)
                  (concat " = ptrtoint ptr @" (concat (llvmSym (strDup lname)) " to i64"))))
              (storeWordAt cg pr 0 fr)
              ; A1: the record births owned.
              (storeCountOneAt cg pr)
              ; and its reference map names every capture that takes
              ; a share below (`retainParamCaps`: the reference-class
              ; parameters), so the record's death hands them back -
              ; a closure per iteration of a loop chained a million
              ; captured closures that nothing ever released
              (storeShapeAt cg pr
                (if scoped
                  (if (> (+ k 1) 47)
                    0
                    (lamShapeBits cg capNames 0))
                  (lamShapeConst cg capNames k)))
              ; A capture that is a REFERENCE PARAMETER of the
              ; enclosing function takes a share, and this is the one
              ; hole that would make event 4's boundary release
              ; unsound rather than merely incomplete: a lambda
              ; captures everything in scope, so a closure escaping
              ; the loop would otherwise hold a parameter the next
              ; boundary releases. The share is BALANCED, by the map
              ; three lines above: `lamShapeBits` sets bit 16+1+i for
              ; exactly the captures `retainParamCaps` retains, so the
              ; record's death gives each of them back. (This comment
              ; used to say the share was unbalanced and leaked "in
              ; the safe direction". It said so from before the map
              ; existed. Probed 2026-09-03: `emit-llvm` of a lambda
              ; capturing one `String` parameter emits
              ; `store i64 131076` for the record's shape word -
              ; 0x20004, two payload words and bit 17, the map naming
              ; word 1.)
              ;
              ; Counted immutable bindings also take a captured share.
              ; Unclassified captures retain the conservative park;
              ; their outer frame cannot prove a release safe.
              (retainParamCaps cg capNames capRegs 0)
              (storeCaps cg pr capRegs 0)
              (vecPush (cgPendingLams cg)
                (mkLamDesc lname lparams body capNames capFloats
                  (cgTypeNodeOpt (nodeBinderTyChild node))))
              (cgSetResult cg pr)
              (cgSetResultFloat cg 0)
              cg
            }
          }
        }
      }
    }
  })

; The index of `name` in the enclosing function's parameter list, or
; -1. `cg 17` is that list, set by `emitFnDef` before the body runs.
; A lambda record's shape word: `k + 1` words, and a map bit for
; capture i (payload word 1 + i) iff the capture takes a share
; (`captureCounted`), the captures `retainParamCaps` retains. Past the
; map's 47 words the record is a leaf, as a constructor's would be.
(pub :: lamShapeConst (-> CG (Vec a) Int Int))
(pub fn (lamShapeConst cg capNames k)
  {
    (let cnt (paddedWords (+ k 1)))
    (+ (* cnt 2)
      (if (> (+ k 1) 47)
        0
        (lamShapeBits cg capNames 0)))
  })

(pub :: lamShapeBits (-> CG (Vec a) Int Int))
(pub fn (lamShapeBits cg capNames i)
  (if (>= i (vecLen capNames))
    0
    (+
      (if (captureCounted cg (vecGetStr capNames i))
        (pow2 (+ 16 (+ 1 i)))
        0)
      (lamShapeBits cg capNames (+ i 1)))))

(pub :: curParamIndex (-> CG String Int))
(pub fn (curParamIndex cg name)
  (if (let (Some ps) (cgParams cg))
    (strIndexIn ps name)
    (- 0 1)))

(pub :: retainParamCaps (-> CG (Vec a) Strings Int CG))
(pub fn (retainParamCaps cg capNames capRegs i)
  (if (>= i (vecLen capNames))
    cg
    {
      (let cg1
        (if (captureCounted cg (vecGetStr capNames i))
          (emitRetainOf cg (vecGetStr capRegs i))
          cg))
      (retainParamCaps cg1 capNames capRegs (+ i 1))
    }))

(pub :: storeCaps (-> CG String Strings Int CG))
(pub fn (storeCaps cg base capRegs i)
  (if (>= i (vecLen capRegs))
    cg
    (storeCaps (storeWordAt cg base (+ 1 i) (vecGetStr capRegs i)) base capRegs (+ i 1))))

; Write out every lifted lambda the last function created - a lambda
; body may itself contain lambdas, which land on the same list and
; are drained by the same loop - then any new forwarding thunks.
(pub :: drainPending (-> CG CG))
;@axiom:effect(io)
(pub fn (drainPending cg)
  {
    (let pend (cgPendingLams cg))
    (if (== (vecLen pend) 0)
      (drainThunks cg)
      (drainPending (emitLamDef (vecPop pend) cg)))
  })

; The lifted function itself: `emitFnDef`'s shape with `%.env` in
; front, and the captures bound as symbols before the body - loaded
; from the record at the offsets `emitLambda` stored them to.
(pub :: emitLamDef (-> LamDesc CG CG))
;@axiom:effect(io)
(pub fn (emitLamDef d cg)
  ; The lifted-lambda twin of the re-scan deleted in `emitFnDef`,
  ; and redundant for the same reason: slot 8 is `allDecls`,
  ; already scanned once by `emitResolved`, and nothing clears
  ; the types table between bodies.
  ; Word 17 now holds the LAMBDA's parameters while word 36 still
  ; holds the enclosing DECLARATION, and the two classifiers that
  ; read an index into the first against the arrow of the second
  ; must not. Cleared again at the `}` below, because
  ; `emitPairWrapper` runs after `drainPending` and would read
  ; whatever the last lambda left here.
  ; S4 slice 1: a lambda body executes when called, which may be
  ; after an enclosing region's reset - so the region-body depth
  ; does not cross this boundary. Saved and restored rather than
  ; just cleared, because a lambda inside a lambda inside a
  ; region must hand the outer lambda its own 0 back.
  ; MM-LIFE-2g: the evidence word for THIS lambda's own argument,
  ; appended to the rendered parameter list only - the AST param
  ; vec is untouched, so every arity computation stays blind to it,
  ; exactly as `emitFnDef` treats `%__evw.h`. It is a DIFFERENT
  ; symbol from `"__evw."`, which a lambda may also have captured
  ; from a polymorphic enclosing function: that one carries the
  ; enclosing function's variables, this one carries the argument
  ; the application is handing over, and a lambda can need both.
  ;
  ; EVERY code pointer a closure record can hold must take it,
  ; whether it reads it or not - `applyOneArg` passes three
  ; operands and cannot know which definition it is reaching. That
  ; is why `emitThunkDef` grows the same parameter.
  ; S4 slice 1: hand the region-body depth back, beside
  ; the slot-7 clear above whose shape this copies.
  ; Captures are borrowed from this closure's environment.
  ; Their names shadow globals during the ownership walk.
  {
    (let lname d.name)
    (let lparams d.params)
    (let body d.body)
    (let capNames d.captures)
    (let capFloats d.flags)
    (let checkedTy d.arrow)
    (let resultTy
      (match (lambdaResultType checkedTy)
        ((None) None)
        ((Some ty) (Some (tyResolve ty)))))
    (let savedSelf (cgTcoName cg))
    (let savedTails (cgTailRetain cg))
    {
      (let paramStr (emitParams lparams cg 0))
      (let _ (cgSetTmp cg 0))
      (let _2 (vecClear (cgSymNames cg)))
      (let _3 (vecClear (cgSymRegs cg)))
      (let _4 (vecClear (cgSymFloats cg)))
      (let _4b (vecClear (cgSymKinds cg)))
      (let _5 (cgSetParams cg lparams))
      (let _6 (cgClearParamFlags cg))
      (let _6b (cgSetLlvmParams cg 0))
      (let _6c (cgSetLiftedLambda cg 1))
      (let _6e (cgSetLambdaType cg checkedTy))
      (let _6f (cgSetTcoName cg (None)))
      (let _6s (vecClear (cgCountedStores cg)))
      (let rgnSaved (cgRegionDepth cg))
      (let _6d (cgSetRegionDepth cg 0))
      {
        (let hdr
          (concat
            (concat "define i64 @"
              (concat (strDup lname)
                (concat "(i64 %.env"
                  (concat
                    (if (== (strLen paramStr) 0)
                      ""
                      (concat ", " paramStr))
                    ", i64 %__evwa.h"))))
            ") #0 {"))
        {
          (let cg1
            (openAllocaMark
              {
                (let cgH (emitLine cg hdr))
                (if (== (bodyHasMatch body) 1)
                  (emitLine cgH "  %__scr.h = alloca i64")
                  cgH)
              }))
          {
            (let cg1b (bindSym cg1 "__evwa." "%__evwa.h" 0 0))
            {
              (let cg1c (bindCaps cg1b capNames capFloats 0))
              {
                (let _t
                  (cgSetTailRetain cg1c
                    (if (!= (parameterTypeClass cg1c resultTy) 0)
                      {
                        (let tails vecNew)
                        {
                          (collectTails cg1c body lparams (envWithAll vecNew capNames 0) "" tails)
                          tails
                        }
                      }
                      vecNew)))
                {
                  (let cg2 (emitExprTail body cg1c))
                  {
                    (let ret (concat "  ret i64 " (concat (strDup (cgResult cg2)) "")))
                    {
                      (cgSetTailRetain cg2 savedTails)
                      (cgSetTcoName cg2 savedSelf)
                      (cgSetLambdaType cg2 None)
                      (cgSetRegionDepth
                        (cgSetLiftedLambda (emitLine (emitLine (closeAllocaMark cg2) ret) "}") 0)
                        rgnSaved)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

(pub :: bindCaps (-> CG (Vec a) Ints Int CG))
(pub fn (bindCaps cg capNames capFloats i)
  (if (>= i (vecLen capNames))
    cg
    {
      (let cg1 (loadWordAt cg "%.env" (+ 1 i)))
      {
        (bindSym cg1
          {
            (let nm (vecGetStr capNames i))
            (if (== (isEvwaName nm) 1)
              (evwaDeeper nm)
              nm)
          }
          (strDup (cgResult cg1)) (% (vecGet capFloats i) 2)
          (if (>= (vecGet capFloats i) 2)
            3
            0))
        (bindCaps cg1 capNames capFloats (+ i 1))
      }
    }))

; A forwarding thunk for a bare top-level function used as a value:
; takes the record it ignores, forwards the declared parameters.
(pub :: thunkIndexFor (-> CG String Int Int))
(pub fn (thunkIndexFor cg full ar)
  {
    (let idx (strIndexIn (cgThunkFulls cg) full))
    (if (>= idx 0)
      idx
      {
        (let n (vecLen (cgThunkFulls cg)))
        {
          (vecPush (cgThunkFulls cg) (strDup full))
          (vecPush (cgThunkArities cg) ar)
          n
        }
      })
  })

(pub :: fnArityOf (-> (Vec ASTNode) String Int))
(pub fn (fnArityOf decls full)
  (fnArityIn decls (declSpellingOf full) 0))

(pub :: fnArityIn (-> (Vec ASTNode) String Int Int))
(pub fn (fnArityIn decls full i)
  (if (>= i (vecLen decls))
    0
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeAName d) full))
        (vecLen (nodeBNames d))
        (fnArityIn decls full (+ i 1)))
    }))

(pub :: drainThunks (-> CG CG))
(pub fn (drainThunks cg)
  {
    (let i (cgThunksEmitted cg))
    (if (>= i (vecLen (cgThunkFulls cg)))
      cg
      {
        (cgSetThunksEmitted cg (+ i 1))
        (drainThunks (emitThunkDef i cg))
      })
  })

(pub :: emitThunkDef (-> Int CG CG))
(pub fn (emitThunkDef i cg)
  ; MM-LIFE-2d: a thunk over a polymorphic function forwards the
  ; constant 0 as its evidence - a bare reference instantiates
  ; fresh never-solved placeholders (MAC-INT-2), so every bit is
  ; unknowable BY CONSTRUCTION and 0 is the honest word, not a
  ; fallback. The record stays one word; the spec's baking
  ; sentence is unreachable under this type system, and
  ; memory-model.md now says so.
  ; The trailing `%__evwa.h` also witnesses the result. A borrowed
  ; polymorphic result takes a share only when its result bit is set. A
  ; thunk is reached through the same code pointer a lambda is, and
  ; `applyOneArg` passes three operands to both. A two-parameter
  ; definition called with three would leave the callee reading a
  ; register nobody set.
  {
    (let full (vecGetStr (cgThunkFulls cg) i))
    (let ar (vecGet (cgThunkArities cg) i))
    {
      ; Payload word zero is the code pointer. The two preceding words
      ; preserve the runtime's count/shape ABI; -1 makes retains and
      ; releases no-ops on every target, without allocator traffic.
      (emitLine cg
        (concat "@.fnval."
          (concat (fmtInt i)
            (concat " = private constant [3 x i64] [i64 -1, i64 2, i64 ptrtoint (ptr @_thunk_"
              (concat (fmtInt i) " to i64)], align 8")))))
      (let cg1
        (emitLine cg
          (concat
            (concat "define i64 @_thunk_"
              (concat (fmtInt i) (concat "(i64 %.env" (thunkParamStr ar))))
            ", i64 %__evwa.h) #0 {")))
      {
        (let evTail
          (if (== (fnTakesEvw cg1 full) 1)
            (if (== (as ar Int) 0)
              "i64 0"
              ", i64 0")
            ""))
        {
          (let cg2
            (emitLine cg1
              (concat
                (concat
                  (concat "  %.r = call i64 @"
                    (concat (llvmSym (strDup full)) (concat "(" (thunkArgStr ar))))
                  (concat evTail ""))
                ")")))
          {
            (let cgR
              (if (&& (== (fnResultClass cg2 full) 1) (== (fnResultOwned cg2 full) 0))
                (emitRcIfBitOf cg2 "%.r" 1 "%__evwa.h" 1)
                cg2))
            (emitLine (emitLine cgR "  ret i64 %.r") "}")
          }
        }
      }
    }
  })

(pub :: thunkParamStr (-> Int String))
(pub fn (thunkParamStr ar)
  {
    (let b strBuilderNew)
    {
      (for j in 0..ar
        (strBuilderPush b (concat ", i64 %.a" (fmtInt j))))
      (strBuilderFinish b)
    }
  })

(pub :: thunkArgStr (-> Int String))
(pub fn (thunkArgStr ar)
  {
    (let args vecNew)
    {
      (for j in 0..ar
        (vecPush args (concat "i64 %.a" (fmtInt j))))
      (strJoin args ", ")
    }
  })

; ------------------------------------------------------------------
; `match`.
;
; A constructor with fields is a heap block whose word 0 is the tag; a
; nullary constructor of a `data` type is emitted as the tag itself. So
; where to look for the tag is decided by the constructor named in the
; *pattern*, which is static, and not by inspecting the value, which
; cannot say.
;
; The result goes through a one-word heap cell rather than a phi. A phi
; would need one incoming edge per arm, and building that incrementally
; while the arms are still being emitted is harder to get right than a
; store per arm and a single load at the end.
; ------------------------------------------------------------------
(pub :: patHead (-> ASTNode Int))
(pub fn (patHead pat)
  (if (== (nodeTag pat) TAG_E_VAR)
    (nodeA pat)
    (if (== (nodeTag pat) TAG_E_APP)
      (patHead (nodeAChild pat))
      0)))

(pub :: loadWordAt (-> CG String Int CG))
(pub fn (loadWordAt cg base idx)
  {
    (let pn (allocReg cg))
    (let pr (regStr pn))
    (let _1
      (emitLine cg (concat (concat "  " pr) (concat " = inttoptr i64 " (concat base " to ptr")))))
    (let an (allocReg cg))
    (let ar (regStr an))
    (let _2
      (emitLine cg
        (concat (concat (concat "  " ar) (concat " = getelementptr i64, ptr " pr))
          (concat ", i64 " (concat (fmtInt idx) "")))))
    (let vn (allocReg cg))
    (let vr (regStr vn))
    (let _3 (emitLine cg (concat (concat "  " vr) (concat " = load i64, ptr " (concat ar "")))))
    (let _4 (cgSetResult cg vr))
    cg
  })

; The four symbol vectors stay parallel by construction: this is the
; only place that pushes them. Kind 0 is a value register, 1 a
; mutable alloca, 2 a TCO alloca, 3 a counted value register and 4 a
; mutable alloca that owns a share of what it holds (`slotOwns`). A
; capture of kind 3 or 4 takes its own share (`captureCounted`).
(pub :: bindSym (-> CG String String Int Int CG))
(pub fn (bindSym cg name reg isFloat kind)
  {
    ; These scratch headers remain stable across growth and scopes.
    (vecPush (cgSymNames cg) name)
    (vecPush (cgSymRegs cg) reg)
    (vecPush (cgSymFloats cg) isFloat)
    (vecPush (cgSymKinds cg) kind)
    cg
  })

; Truncate the three parallel symbol vectors back to `mark`, undoing
; every binding made since. An arm's binders must not survive into the
; next arm's emission: a later arm mentioning a name only an *earlier*
; arm bound would otherwise resolve to the earlier arm's register - a
; value that does not exist on the path that reaches it.
(pub :: symMark (-> CG Int))
(pub fn (symMark cg)
  (vecLen (cgSymNames cg)))

(pub :: symRestore (-> CG Int CG))
(pub fn (symRestore cg mark)
  {
    (let names (cgSymNames cg))
    (let regs (cgSymRegs cg))
    (let floats (cgSymFloats cg))
    (let kinds (cgSymKinds cg))
    (let mut i (vecLen names))
    ; Replacing counted slots gives their shares back before the raw
    ; length change hides them. Static empty strings need no storage.
    (while (> i mark)
      {
        (vecSet names (- i 1) "")
        (vecSet regs (- i 1) "")
        (set i (- i 1))
      })
    (memSetWord (as names Int) 0 mark)
    (memSetWord (as regs Int) 0 mark)
    (memSetWord (as floats Int) 0 mark)
    (memSetWord (as kinds Int) 0 mark)
    cg
  })

; A pattern test against a PAIR rather than a block, for the two
; shapes `pairArmsOK` admits: a nullary constructor (compare the tag)
; and a one-argument constructor whose argument is a plain binder
; (compare the tag, then bind the payload register).
;
; There is no immediate-vs-block guard here and no field load, which
; is the whole point: the tag and the payload are already in registers.
(pub :: emitPairPatMatch (-> CG ASTNode String String String CG))
;@axiom:effect(unsafe)
(pub fn (emitPairPatMatch cg pat tagR payR failB)
  {
    (let tg (nodeTag pat))
    (if (== tg TAG_P_CON0)
      {
        (let enFound (lookupType (cgTypes cg) (nodeAName pat)))
        (if (let (Some en) enFound)
          (emitPatTest (constStr (eTag en)) (strDup tagR) failB cg)
          cg)
      }
      {
        (let h (patHead pat))
        (if (== h 0)
          cg
          {
            (let enFound (lookupType (cgTypes cg) (as h String)))
            (if (let (Some en) enFound)
              {
                (let cgT (emitPatTest (constStr (eTag en)) (strDup tagR) failB cg))
                {
                  (let subs (patArgs pat vecNew))
                  (if (!= (vecLen subs) 1)
                    cgT
                    (bindSym cgT (nodeAName (vecGet subs 0)) (strDup payR)
                      (patFloatFlag (vecGet subs 0) 0) 0))
                }
              }
              cg)
          })
      })
  })

; `emitArms` against a pair. The same chain - test, bind, body, store,
; branch to the merge - with the pattern step reading registers.
(pub :: emitPairArms (-> (Vec ASTNode) String String String String CG Int Int ASTNode Int CG))
;@axiom:effect(io)
(pub fn (emitPairArms arms tagR payR cell mergeB cg i ff rt rel)
  (if (>= i (vecLen arms))
    {
      (storeWordAt cg cell 0 "0")
      (emitLine cg (concat "  br label %" mergeB))
      cg
    }
    ; WORD 31 IS "THE BODY WROTE ITS OWN TERMINATOR", and this
    ; reads it for the reason `emitPairArmsTail` does: the three
    ; steps below - the release, the store and the `br` - all
    ; land in the block the body left current, and a body that
    ; ended that block with a `ret` or a `br` of its own would
    ; put them past a terminator. `emitLine` writes text, so LLVM
    ; would take the instructions after the terminator and the
    ; verifier would reject the module.
    ;
    ; IT CANNOT FIRE TODAY, AND SAYING SO IS THE POINT. Word 31
    ; has exactly six setters, all in this file: `emitTailJump`
    ; (a self tail jump), `emitIfTail` (both arms terminated),
    ; the `musttail` leaf, `emitPairFwd`, and `emitPairRet`
    ; twice. The last three are called only from `emitExprTail`;
    ; the first two are reached only with word 30 - tail position
    ; - already set, and `emitApp` snapshots word 30 and clears
    ; it before it emits a single argument. `emitPairArms` emits
    ; its bodies with `emitExpr`, which is entered with word 30
    ; at 0, so no Axiom source reaches this branch. The guard is
    ; therefore INERT, and it was verified inert the way this
    ; repository verifies inertness: `axiom emit-llvm
    ; core/main.ax` is byte-identical with and without it.
    ;
    ; It is written down rather than left out because the
    ; invariant that made it unnecessary is not local to this
    ; function and not written anywhere it would be read from
    ; here - it is a property of six call sites in two other
    ; emitters. If a match arm ever regains tail position under
    ; the register-pair specialisation, this branch becomes the
    ; difference between a jump and a rejected module.
    ; THE SHARE THE PAIR CARRIED, GIVEN BACK PER ARM. A block was
    ; released once because one release reached every field
    ; through the shape word; a pair has no shape word, so the
    ; release belongs to the arm whose payload is a REFERENCE -
    ; `Err`'s and not `Ok`'s in a `(Result Int Error)`. Releasing
    ; unconditionally would hand `axiom_release` an `Int` that
    ; happens to exceed 4096 and it would read it as a block
    ; header.
    ;
    ; `rel` is `scrutineeReleasable`'s answer, so an arm whose
    ; binder ESCAPES has already turned this off for the whole
    ; match - the same guard the boxed path uses.
    {
      (let arm (vecGet arms i))
      (let pat (nodeAChild arm))
      (let body (nodeBChild arm))
      (let nn (allocReg cg))
      (let nextB (labelStr nn))
      (let mark (symMark cg))
      {
        (let cgP (emitPairPatMatch cg pat tagR payR nextB))
        {
          (let cgB (emitExpr body cgP))
          (let _ff
            (if (== i 0)
              (memSetWord ff 0 (cgResultFloat cgB))
              0))
          (let termd (cgTerminated cgB))
          (let bv (strDup (cgResult cgB)))
          (let _r
            (if (== termd 1)
              cgB
              (if (== rel 1)
                (if (== (pairPayloadClass cgB rt (pairArmCtorName pat)) 2)
                  (emitReleaseOf cgB (strDup payR))
                  cgB)
                cgB)))
          (let _d
            (if (== termd 1)
              0
              {
                (storeWordAt cgB cell 0 bv)
                0
              }))
          (let _e
            (if (== termd 1)
              0
              {
                (emitLine cgB (concat "  br label %" mergeB))
                0
              }))
          (let _z (cgSetTerminated cgB 0))
          (let _f (emitLabel cgB nextB))
          (let _g (symRestore cgB mark))
          (emitPairArms arms tagR payR cell mergeB cgB (+ i 1) ff rt rel)
        }
      }
    }))

; Every arm is a shape `emitPairPatMatch` can test.
; The constructor an arm's pattern names.
(pub :: pairArmCtorName (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (pairArmCtorName pat)
  (if (== (nodeTag pat) TAG_P_CON0)
    (nodeAName pat)
    {
      (let h (patHead pat))
      (if (== h 0)
        ""
        (as h String))
    }))

; `emitArmsTail` against a pair.
;
; NO RELEASE HERE, and the caller is what guarantees that is right: the
; tail hook takes this path only when `scrutineeReleasable` answered 0,
; so there is no share to give back. An arm in TAIL position may emit
; its own `ret` - a pair leaf inside a pair variant does exactly that -
; and a release written after the arms would sit past it, unreachable,
; which is a leak rather than a diagnostic. Refusing the case is
; cheaper than reasoning about which arms fall through.
(pub :: emitPairArmsTail (-> (Vec ASTNode) String String String String CG Int Int CG))
;@axiom:effect(io)
(pub fn (emitPairArmsTail arms tagR payR cell mergeB cg i ff)
  (if (>= i (vecLen arms))
    {
      (storeWordAt cg cell 0 "0")
      (emitLine cg (concat "  br label %" mergeB))
      cg
    }
    {
      (let arm (vecGet arms i))
      (let pat (nodeAChild arm))
      (let body (nodeBChild arm))
      (let nn (allocReg cg))
      (let nextB (labelStr nn))
      (let mark (symMark cg))
      {
        (let cgP (emitPairPatMatch cg pat tagR payR nextB))
        {
          (let cgB (emitExprTail body cgP))
          (let _ff
            (if (== i 0)
              (memSetWord ff 0 (cgResultFloat cgB))
              0))
          {
            (let termd (cgTerminated cgB))
            {
              (if (! (== termd 1))
                {
                  (storeWordAt cgB cell 0 (strDup (cgResult cgB)))
                  (emitLine cgB (concat "  br label %" mergeB))
                })
              (cgSetTerminated cgB 0)
              (emitLabel cgB nextB)
              (symRestore cgB mark)
              (emitPairArmsTail arms tagR payR cell mergeB cgB (+ i 1) ff)
            }
          }
        }
      }
    }))

(pub :: pairArmsOK (-> CG (Vec ASTNode) Int Int))
;@axiom:effect(unsafe)
(pub fn (pairArmsOK cg arms i)
  (if (>= i (vecLen arms))
    1
    {
      (let pat (nodeAChild (vecGet arms i)))
      {
        (let tg (nodeTag pat))
        (if (== tg TAG_P_CON0)
          (if (&& (== (pairCtorNamed (nodeAName pat)) 1)
                (if (let (Some _) (pairEntryOfArity cg (nodeAName pat) 0))
                  true
                  false))
            (pairArmsOK cg arms (+ i 1))
            0)
          (if (== tg TAG_E_APP)
            {
              (let h (patHead pat))
              (if (== h 0)
                0
                (if (|| (== (pairCtorNamed (as h String)) 0)
                      (if (let (Some _) (pairEntryOfArity cg (as h String) 1))
                        false
                        true))
                  0
                  {
                    (let subs (patArgs pat vecNew))
                    (if (!= (vecLen subs) 1)
                      0
                      (if (== (nodeTag (vecGet subs 0)) TAG_E_VAR)
                        (pairArmsOK cg arms (+ i 1))
                        0))
                  }))
            }
            0))
      }
    }))

; Is this match one the call-site rewrite can take? The scrutinee has
; to be a DIRECT call to a function that got a pair variant, and every
; arm a shape the register test can answer. Anything else keeps the
; boxed path.
; The declared result type of the function a match scrutinee calls.
(pub :: pairScrutRetTy (-> CG ASTNode (Option ASTNode)))
(pub fn (pairScrutRetTy cg scrutExpr)
  {
    (let hn (spineHeadName scrutExpr))
    (if (== (strLen hn) 0)
      None
      {
        (let eFound (findFSigCg cg (mangledForCg cg hn)))
        (if (let (Some e) eFound)
          (arrowResultTy (fsigTy e))
          None)
      })
  })

(pub :: pairMatchOK (-> CG ASTNode (Vec ASTNode) Int))
(pub fn (pairMatchOK cg scrutExpr arms)
  (if (!= (nodeTag scrutExpr) TAG_E_APP)
    0
    {
      (let hn (spineHeadName scrutExpr))
      (if (== (strLen hn) 0)
        0
        (if (== (pairNamesHas (pairNames cg) (mangledForCg cg hn)) 0)
          0
          (pairArmsOK cg arms 0)))
    }))

(pub :: emitMatch (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitMatch node cg)
  ; A compile-time cell for the first arm's float flag - a local
  ; rather than a CG field, so a nested match cannot clobber the
  ; outer one's. A well-typed match yields one type from every
  ; arm, so the first arm speaks for the form.
  ; Arm the register-pair path when the scrutinee is a DIRECT call to
  ; a function that has one and every arm can be tested on registers.
  ; The token is consumed by that call and by nothing else; if it is
  ; not consumed the boxed lowering below runs on the value in hand,
  ; and nothing has been emitted that assumed otherwise.
  ; The pair carries the same share the block did, so the same
  ; question is asked - `emitPairArms` gives it back PER ARM instead
  ; of once, because there is no shape word to reach the payload
  ; through.
  {
    (let scrutExpr (nodeAChild node))
    (let arms (nodeBChildren node))
    (let ff (memAlloc 8))
    (let _0 (memSetWord ff 0 (- 0 1)))
    (let _a
      (if (== (pairMatchOK cg scrutExpr arms) 1)
        (cgSetPairArm cg 1)
        cg))
    (let cg1 (emitExpr scrutExpr cg))
    (let gotPair (cgPairArm cg1))
    (let _z (cgSetPairArm cg1 0))
    (let sv (strDup (cgResult cg1)))
    (let tagR
      (if (== gotPair 2)
        (strDup (pairTagReg cg1))
        ""))
    (let cn (allocReg cg1))
    (let cell (regStr cn))
    (let _1
      (emitLine cg1 (concat (concat "  " cell) (concat " = ptrtoint ptr %__scr.h to i64" ""))))
    (let mn (allocReg cg1))
    (let mergeB (labelStr mn))
    (let held
      (if (== gotPair 2)
        0
        (placeScrutHeld node scrutExpr cg1 0)))
    (let _h
      (if (== held 1)
        (emitRetainOf cg1 sv)
        cg1))
    (let rel
      (if (== held 1)
        1
        (scrutineeReleasable node scrutExpr cg1)))
    (let pmark (vecLen (cgPendingStrings cg1)))
    (let _p
      (if (== rel 1)
        (if (== gotPair 2)
          0
          {
            (cgPendingPush cg1 sv)
            0
          })
        0))
    (let cg2
      (if (== gotPair 2)
        (if (let (Some prt) (pairScrutRetTy cg1 scrutExpr))
          (emitPairArms arms tagR sv cell mergeB cg1 0 ff prt rel)
          (cgFail cg1 "pair scrutinee has no result type: " (spineHeadName scrutExpr)))
        (emitArms arms sv cell mergeB cg1 0 ff)))
    (let _q (cgPendingTruncate cg2 pmark))
    (let _2 (emitLabel cg2 mergeB))
    (let cg3 (loadWordAt cg2 cell 0))
    (let armFlag (memGetWord ff 0))
    (let _3
      (cgSetResultFloat cg3
        (if (== armFlag (- 0 1))
          0
          armFlag)))
    (if (== rel 1)
      (if (== gotPair 2)
        ; already given back, per arm, above
        cg3
        (releaseScrutinee sv cg3 scrutExpr))
      cg3)
  })

; An OWNED scrutinee - `(match (Some (fmtInt i)) ...)` - is a
; temporary the match consumed: released after the merge, unless some
; arm's binder escapes through its body (the binders are the block's
; fields, and the walk that decides this for a `let` decides it
; here). The match's own value in word 2 is kept.
(pub :: scrutineeReleasable (-> ASTNode ASTNode CG Int))
(pub fn (scrutineeReleasable node scrutExpr cg)
  (if (== (valueOwnedRef cg scrutExpr) 0)
    0
    (if (== (escapesViaBinders cg (nodeBChildren node) 1 0 (binderSummary node)) 1)
      0
      1)))

; A match over a BORROWED place - `(match o.f ...)`, a counted field
; read, or `(match (vecGet v i) ...)`, an element a call lends - holds
; a share of the scrutinee for its arms when no binder escapes, and
; hands it back where an owned scrutinee is released. The binders are
; the scrutinee block's fields, and an arm can store over the place it
; came from: `(match o.f ((Some x) { (set o.f None) (use x) }))` freed
; the `Some` block, and `x` with it, before `use` read it. Measured,
; `x` printed as the arm's own format buffer.
;
; In tail position, a binder that reaches the match's value is a tail
; leaf, and where every leaf takes its own share on the way out
; (`slotTailCovered`, as an owning slot's last value is judged) the
; scrutinee's share can go back after it. A binder that escapes any
; other way leaves the place as borrowed as before.
(pub :: placeScrutHeld (-> ASTNode ASTNode CG Int Int))
(pub fn (placeScrutHeld node scrutExpr cg tail)
  (if (== (placeScrutClass cg scrutExpr) 0)
    0
    (if (== (escapesViaBinders cg (nodeBChildren node) 1 0 (binderSummary node)) 0)
      1
      (if (== tail 0)
        0
        (if (== (escapesViaBinders cg (nodeBChildren node) 0 0 (binderSummary node)) 1)
          0
          (tailLeavesCovered cg node))))))

; Is every value the tail of `e` answers retained on the way out, or a
; share of its own - with the retain unconditional inside a lambda?
; The tail half of `slotReleasesAtEnd`, asked of any tail form.
(pub :: tailLeavesCovered (-> CG ASTNode Int))
(pub fn (tailLeavesCovered cg e)
  (if (== (cgLiftedLambda cg) 1)
    {
      (let lamTy (cgLambdaType cg))
      (if (== (parameterTypeClass cg (lambdaResultType lamTy)) 2)
        (slotTailCovered cg e)
        0)
    }
    (slotTailCovered cg e)))

; 1 when a match scrutinee is a borrowed place of a counted type: a
; counted field read, or a value a call lends (`lendClass`). An owned
; scrutinee is `scrutineeReleasable`'s, and a type-variable place
; (class `2+k`) cannot be destructured by a constructor pattern.
(pub :: placeScrutClass (-> CG ASTNode Int))
(pub fn (placeScrutClass cg scrutExpr)
  (if (== (valueOwnedRef cg scrutExpr) 1)
    0
    (if (|| (== (lendClass cg scrutExpr) 1) (== (fieldArgClass cg scrutExpr) 1))
      1
      0)))

(pub :: releaseScrutinee (-> String CG ASTNode CG))
(pub fn (releaseScrutinee sv cg scrutExpr)
  ; S4 slice 4: a scrutinee the witness proved fresh is reclaimed
  ; by the region's reset exactly as an argument temporary is, so
  ; its merge-path release is the same binary-only traffic. The
  ; stamp is the join/call stamp slices 2 and 3 record (a fresh
  ; call, or a join whose every arm is one - including a nested
  ; match, whose result register is a scratch-cell load); the
  ; depth gate is the same textual extent, and the pending vector
  ; above still takes the share for the tail-jump path, which
  ; keeps its release. `argOwnedRelease` is not asked here -
  ; `scrutineeReleasable` already decided - so `mustTailOK` cannot
  ; drift. Shared by the tail and non-tail emitters: the rule is
  ; position-independent by construction.
  {
    (let v (strDup (cgResult cg)))
    (let fl (cgResultFloat cg))
    {
      (let cgR
        (if (&& (!= (cgRegionDepth cg) 0)
              (&&
                (|| (== (nodeTag scrutExpr) TAG_E_APP)
                  (|| (== (nodeTag scrutExpr) TAG_E_IF) (== (nodeTag scrutExpr) TAG_E_MATCH)))
                (&& (== (nodeResWord scrutExpr) 2) (dropFreeExpr cg scrutExpr))))
          cg
          (emitReleaseOf cg sv)))
      {
        (cgSetResult cgR v)
        (cgSetResultFloat cgR fl)
        cgR
      }
    }
  })

(pub :: emitArms (-> (Vec ASTNode) String String String CG Int Int CG))
;@axiom:effect(io)
(pub fn (emitArms arms sv cell mergeB cg i ff)
  (if (>= i (vecLen arms))
    ; No arm matched. The scratch is an alloca now, not an
    ; allocator-zeroed cell, so the zero a fall-through answers is
    ; stored EXPLICITLY here. The checker refuses non-exhaustive
    ; matches as AX3005 (MM-VAL-9b, amended 2026-08-14), so this
    ; path is hygiene for the emission surfaces that skip the
    ; checker, not a semantics anyone reaches from a checked
    ; program.
    {
      (storeWordAt cg cell 0 "0")
      (emitLine cg (concat "  br label %" mergeB))
      cg
    }
    ; The pattern compiles to a chain of tests that each branch to
    ; `nextB` on mismatch and fall through on success, binding as
    ; they go; the body is then emitted in whatever block the last
    ; test left current.
    ; The same word-31 guard `emitPairArms` carries, for the same
    ; reason and with the same standing: a body that wrote its
    ; own terminator would leave this store and `br` past it. It
    ; is unreachable from `emitExpr` today - the argument is
    ; written out at `emitPairArms` and applies verbatim here -
    ; and it was proved inert by a byte-identical `emit-llvm` of
    ; `core/main.ax`. `emitArmsTail`, `emitPairArmsTail`,
    ; `emitIfTail`, `emitLet`, `emitRegion` and `retainTailLeaf`
    ; all read word 31 already; these two were the ones that did
    ; not.
    {
      (let arm (vecGet arms i))
      (let pat (nodeAChild arm))
      (let body (nodeBChild arm))
      (let nn (allocReg cg))
      (let nextB (labelStr nn))
      (let mark (symMark cg))
      {
        (let cgP (emitPatMatch pat (strDup sv) nextB cg 0))
        {
          (let cgB (emitExpr body cgP))
          (let _ff
            (if (== i 0)
              (memSetWord ff 0 (cgResultFloat cgB))
              0))
          (let termd (cgTerminated cgB))
          (let bv (strDup (cgResult cgB)))
          (let _d
            (if (== termd 1)
              0
              {
                (storeWordAt cgB cell 0 bv)
                0
              }))
          (let _e
            (if (== termd 1)
              0
              {
                (emitLine cgB (concat "  br label %" mergeB))
                0
              }))
          (let _z (cgSetTerminated cgB 0))
          (let _f (emitLabel cgB nextB))
          (let _g (symRestore cgB mark))
          (emitArms arms sv cell mergeB cgB (+ i 1) ff)
        }
      }
    }))

; ------------------------------------------------------------------
; Pattern compilation, recursive over the pattern's structure.
;
; `emitPatMatch` emits the tests for `pat` against the value held in
; `vr`: every failing comparison branches to `failB`, success falls
; through into a fresh block with the pattern's binders bound. Three
; shapes existed before this and two of them were wrong. A literal
; pattern was indistinguishable from a binder (`patHead` answered 0 for
; both), so `(1 body)` matched *everything*. And a nested constructor
; pattern collected only its binder names - `(Cons h (Cons h2 t))`
; walked the outer application, took `(Cons h2 t)` as if it were a
; name, and bound nothing inside it, so the emitted body referred to
; registers no instruction defines.
;
; A concrete checked binder type takes precedence over the field's
; declaration. A generic field declared `a` can hold Float at this
; instantiation; its declaration alone cannot select numeric lowering.
; An unresolved binder keeps the caller's declared flag.
; ------------------------------------------------------------------
(pub :: patFloatFlag (-> ASTNode Int Int))
;@axiom:effect(unsafe)
(pub fn (patFloatFlag pat declared)
  {
    (let stamp (nodeBinderTy pat))
    (if (== stamp 0)
      declared
      {
        (let name (as stamp String))
        (if (== (strLen name) 0)
          declared
          (if (strEq name "Float")
            1
            0))
      })
  })

(pub :: emitPatMatch (-> ASTNode String String CG Int CG))
;@axiom:effect(unsafe)
(pub fn (emitPatMatch pat vr failB cg isFloat)
  {
    (let tag (nodeTag pat))
    (if (== tag TAG_E_INT)
      (emitPatTest (constStr (nodeA pat)) vr failB cg)
      ; A char-literal pattern tests its codepoint word, exactly as an
      ; integer literal does - `(match c ('a' 7) (x 9))` is pinned by
      ; tests/selfhost/470-char-literals.ax, and an unknown tag here
      ; would silently match everything.
      (if (== tag TAG_E_CHAR)
        (emitPatTest (constStr (nodeA pat)) vr failB cg)
        (if (== tag TAG_E_FLT)
          ; Bit-pattern equality, which is what stage0's literal float
          ; pattern also compiles to (one word against one word).
          (emitPatTest (constStr (nodeA pat)) vr failB cg)
          (if (== tag TAG_E_STR)
            ; A string literal pattern compares CONTENTS, through the same
            ; `@__axiom_str_eq` that `==` on two Strings lowers to.
            ;
            ; It compared the interned literal's header ADDRESS until
            ; 2026-08-21, on the ground that literals of equal text share
            ; one global - true, and beside the point: a string built at
            ; run time is never that global. Measured (the QA sweep):
            ;
            ;   (let ((built (concat "hel" "lo")))
            ;     (== built "hello")                        -> 1
            ;     (match built (("hello") 1) (_ 0)))        -> 0
            ;
            ; so `==` and `match` disagreed on one value, and any dispatch
            ; on a string tag - a command table, a parser - silently took
            ; the wrong arm for every string that was not itself a
            ; literal. The checker makes the header read safe: a string
            ; literal pattern on a scrutinee known not to be a String is
            ; AX3004 (`checkPatternTyped`). tests/selfhost/996 pins the
            ; agreement of the two.
            {
              (let cgS (emitStrExpr pat cg))
              (emitPatStrTest (strDup (cgResult cgS)) vr failB cgS)
            }
            (if (== tag TAG_E_VAR)
              ; `true`/`false` are literal tests. Every OTHER bare name - a
              ; constructor's included - is a binder: stage0 parses a bare
              ; identifier in pattern position as a variable pattern, and
              ; only the parenthesised `(Nil)` (TAG_P_CON0 below) tests a
              ; tag. `_` is just a name nobody references.
              (if (strEq (nodeAName pat) "true")
                (emitPatTest (constStr 1) vr failB cg)
                (if (strEq (nodeAName pat) "false")
                  (emitPatTest (constStr 0) vr failB cg)
                  (bindSym cg (nodeAName pat) (strDup vr) (patFloatFlag pat isFloat) 0)))
              (if (== tag TAG_P_CON0)
                ; A nullary constructor of a type that unboxes (rep 1 or 2) IS
                ; its tag: compare the value directly. Correct even when the
                ; scrutinee is a boxed sibling - a heap pointer never equals a
                ; small immediate tag, so the arm just fails. Only a nullary
                ; constructor of a non-unboxing type is still a one-word block
                ; whose tag loads from word 0.
                {
                  (let entryFound (lookupType (cgTypes cg) (nodeAName pat)))
                  (if (let (Some entry) entryFound)
                    (if (!= (eRep entry) 0)
                      (emitPatTest (constStr (eTag entry)) vr failB cg)
                      {
                        (let cgL (loadWordAt cg vr 0))
                        (emitPatTest (constStr (eTag entry)) (strDup (cgResult cgL)) failB cgL)
                      })
                    (bindSym cg (nodeAName pat) (strDup vr) (patFloatFlag pat isFloat) 0))
                }
                ; A NAMED constructor pattern is reordered into the positional
                ; spine and re-dispatched, so every mechanism below - the mixed-rep
                ; guard, the tag test, the word-i+1 field loads with their float
                ; flags - runs unchanged. A constructor with no recorded field
                ; names cannot be matched this way; the pattern binds nothing
                ; rather than binding by position, which would be a silent wrong
                ; answer.
                (if (== tag TAG_P_CONNAMED)
                  {
                    (let entFound (lookupType (cgTypes cg) (nodeAName pat)))
                    (if (let (Some ent) entFound)
                      (match (eFieldNamesVec ent)
                        ((None) cg)
                        ((Some names)
                          (emitPatMatch
                            (namedPatSpine (nodeAName pat) names (nodeBChildren pat)
                              (nodeCChildren pat) (nodeSpan pat))
                            vr failB cg isFloat)
                        ))
                      cg)
                  }
                  (if (== tag TAG_E_APP)
                    {
                      (let cname (patHead pat))
                      {
                        (let entryFound
                          (if (== cname 0)
                            (None)
                            (lookupType (cgTypes cg) (as cname String))))
                        (if (let (Some entry) entryFound)
                          ; A fieldful pattern in a MIXED type must not load word
                          ; 0 unguarded: the scrutinee may be an immediate
                          ; nullary sibling, and word 0 of a small integer is a
                          ; crash. `emitCondTagRead` tests `< 4096` first. In an
                          ; all-boxed type the plain load stays.
                          {
                            (let cgL
                              (if (== (eRep entry) 2)
                                (emitCondTagRead vr cg)
                                (loadWordAt cg vr 0)))
                            {
                              (let cgT
                                (emitPatTest (constStr (eTag entry)) (strDup (cgResult cgL)) failB
                                  cgL))
                              (emitPatFields (patArgs pat vecNew) (eFieldFlagsVec entry) vr failB
                                cgT 0)
                            }
                          }
                          ; An application whose head is no constructor - nothing
                          ; well-typed produces this; match everything, bind
                          ; nothing, as before.
                          cg)
                      }
                    }
                    cg))))))))
  })

; The tag of a value whose type mixes representations, decided at
; runtime: below 4096 the value IS the tag (no immediate reaches the
; limit, every mmap-page heap address exceeds it), at or above it the
; tag is word 0. Globally-unique tags make the one read correct
; against any constructor's compare. The result travels through a
; one-word heap cell rather than a phi, the same idiom `match` uses
; for its own result.
(pub :: emitCondTagRead (-> String CG CG))
(pub fn (emitCondTagRead vr cg)
  {
    (let cellN (allocReg cg))
    (let cn (allocReg cg))
    (let immN (allocReg cg))
    (let boxN (allocReg cg))
    (let mergeN (allocReg cg))
    {
      (let cell (regStr cellN))
      (let cr (tmpStr "c" cn))
      (let immB (labelStr immN))
      (let boxB (labelStr boxN))
      (let mergeB (labelStr mergeN))
      {
        (let cg1
          (emitLine cg (concat (concat "  " cell) (concat " = ptrtoint ptr %__scr.h to i64" ""))))
        {
          (let cg2
            (emitLine cg1
              (concat (concat "  " cr) (concat " = icmp slt i64 " (concat (strDup vr) ", 4096")))))
          {
            (let cg3
              (emitLine cg2
                (concat (concat "  br i1 " (concat cr ", label %"))
                  (concat immB (concat (concat ", label %" boxB) "")))))
            {
              (let cg4 (emitLabel cg3 immB))
              {
                (let cg5 (storeWordAt cg4 cell 0 (strDup vr)))
                {
                  (let cg6 (emitLine cg5 (concat "  br label %" mergeB)))
                  {
                    (let cg7 (emitLabel cg6 boxB))
                    {
                      (let cg8 (loadWordAt cg7 vr 0))
                      {
                        (let cg9 (storeWordAt cg8 cell 0 (strDup (cgResult cg8))))
                        {
                          (let cg10 (emitLine cg9 (concat "  br label %" mergeB)))
                          {
                            (let cg11 (emitLabel cg10 mergeB))
                            (loadWordAt cg11 cell 0)
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; One `icmp eq` against `want`, branching to `failB` on mismatch and
; into a fresh block on success.
(pub :: emitPatTest (-> String String String CG CG))
(pub fn (emitPatTest want vr failB cg)
  {
    (let tn (allocReg cg))
    (let cn (allocReg cg))
    {
      (let tr (regStr tn))
      (let contB (labelStr cn))
      {
        (emitLine cg
          (concat (concat "  " tr)
            (concat " = icmp eq i64 " (concat (strDup vr) (concat ", " want)))))
        (emitLine cg
          (concat (concat "  br i1 " (concat tr ", label %"))
            (concat contB (concat (concat ", label %" failB) ""))))
        (emitLabel cg contB)
        cg
      }
    }
  })

; `emitPatTest`'s shape over string contents: one call into
; `@__axiom_str_eq`, which answers exactly 0 or 1, then the same
; branch. `want` is the literal's header register.
(pub :: emitPatStrTest (-> String String String CG CG))
(pub fn (emitPatStrTest want vr failB cg)
  {
    (let r (regStr (allocReg cg)))
    {
      (let cg1
        (emitLine cg
          (concat (concat "  " r)
            (concat " = call i64 @__axiom_str_eq(i64 "
              (concat (strDup vr) (concat ", i64 " (concat want ")")))))))
      (emitPatTest (constStr 1) r failB cg1)
    }
  })

; Load each field of the block in `vr` (fields start at word 1, past
; the tag) and recurse into the subpattern, carrying the field's
; declared float flag to whatever binder it bottoms out in.
(pub :: emitPatFields (-> (Vec ASTNode) Ints String String CG Int CG))
(pub fn (emitPatFields subs flags vr failB cg i)
  (if (>= i (vecLen subs))
    cg
    {
      (let cgL (loadWordAt cg vr (+ i 1)))
      {
        (let fr (strDup (cgResult cgL)))
        (let fl
          (if (== (as flags Int) 0)
            0
            (if (< i (vecLen flags))
              (vecGet flags i)
              0)))
        (emitPatFields subs flags vr failB (emitPatMatch (vecGet subs i) fr failB cgL fl) (+ i 1))
      }
    }))

; Subpattern nodes of a constructor pattern, in field order -
; `(Cons h t)` yields the node for `h` then the node for `t`.
(pub :: patArgs (-> ASTNode (Vec ASTNode) (Vec ASTNode)))
(pub fn (patArgs pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
    {
      (patArgs (nodeAChild pat) acc)
      (vecPush acc (nodeBChild pat))
      acc
    }
    acc))

; ------------------------------------------------------------------
; Expression dispatch.
; ------------------------------------------------------------------
; Event 2's retain lives HERE, on the leaf: a node `emitFnDef` listed
; in `tailRetain` - a borrowed value in tail position of a
; reference-returning function - is retained the moment its register
; exists. Per leaf rather than at `ret`, because a function owned on
; one branch and borrowed on another must retain the borrowed branch
; only; retaining the merged register leaked a share of the owned one
; on every call (`fmtInt`, measured: 16 MB over 200,000 calls).
(pub :: emitExpr (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitExpr node cg)
  {
    (let out (emitExprDispatch node cg))
    {
      ; A polymorphic signature cannot say whether its result is Float.
      ; The checked application can, including a call through a closure.
      (if (== (nodeTag node) TAG_E_APP)
        {
          (let stamp (nodeBinderTyChild node))
          (if (if (nodeSame stamp nilNode)
            false
            (&& (== (nodeTag stamp) TAG_EVSTAMP) (cgDeclarationMatches out (nodeCChild stamp))))
            (cgSetResultFloat out (tyIsBareFloat (tyResolve (nodeAChild stamp))))
            out)
        }
        out)
      out
    }
  })

; The retain itself, for a leaf `emitExprTail` has just emitted in
; tail position: listed in `tailRetain`, and not a block a jump has
; already terminated. Keyed on the POSITION as well as the node,
; because a macro substitutes one node for every occurrence of a
; parameter, and retaining every occurrence leaked a share per call.
(pub :: retainTailLeaf (-> ASTNode CG CG))
(pub fn (retainTailLeaf node cg)
  {
    (let tr (cgTailRetain cg))
    (if (== (vecLen tr) 0)
      cg
      (if (== (cgTerminated cg) 1)
        cg
        (if (== (nodeInVec tr node 0) 1)
          {
            (let v (strDup (cgResult cg)))
            (let fl (cgResultFloat cg))
            (let lamTy (cgLambdaType cg))
            {
              (let cgR
                (if (&& (== (cgLiftedLambda cg) 1)
                      (== (parameterTypeClass cg (lambdaResultType lamTy)) 1))
                  (emitRcIfBitOf cg v 1 "%__evwa.h" 1)
                  (emitRetainOf cg v)))
              {
                (cgSetResult cgR v)
                (cgSetResultFloat cgR fl)
                cgR
              }
            }
          }
          cg)))
  })

(pub :: nodeInVec (-> (Vec ASTNode) ASTNode Int Int))
(pub fn (nodeInVec v node i)
  (if (>= i (vecLen v))
    0
    (if (nodeSame (vecGet v i) node)
      1
      (nodeInVec v node (+ i 1)))))

(pub :: emitExprDispatch (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitExprDispatch node cg)
  {
    (let tag (nodeTag node))
    (if (== tag TAG_E_INT)
      (emitInt node cg)
      ; A char literal is its codepoint word; emission is an integer's.
      (if (== tag TAG_E_CHAR)
        (emitInt node cg)
        ; `cond` is AX2004: the parser builds none, so no arm
        ; emits one. A variadic `if` arrives as nested `if`s.
        (if (== tag TAG_E_FLT)
          (emitFlt node cg)
          (if (== tag TAG_E_VAR)
            (emitVar node cg)
            (if (== tag TAG_E_APP)
              (emitApp node cg)
              (if (== tag TAG_E_LET)
                (emitLet node cg)
                (if (== tag TAG_E_IF)
                  (emitIf node cg)
                  (if (== tag TAG_E_BEGIN)
                    (emitBegin node cg)
                    (if (== tag TAG_E_STR)
                      (emitStrExpr node cg)
                      (if (== tag TAG_E_MATCH)
                        (emitMatch node cg)
                        (if (== tag TAG_E_LETM)
                          (emitLetM node cg)
                          (if (== tag TAG_E_SET)
                            (emitSet node cg)
                            (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
                              (if (== tag TAG_E_REGION)
                                (emitRegion node cg)
                                (emitWhile node cg))
                              (if (== tag TAG_E_FIELD)
                                (emitField node cg)
                                (if (== tag TAG_E_SETF)
                                  (emitSetF node cg)
                                  (if (== tag TAG_E_LAM)
                                    (emitLambda node cg)
                                    (if (== tag TAG_E_STRUCTCON)
                                      (emitStructConExpr node cg)
                                      (if (== tag TAG_E_HANDLE)
                                        (emitHandle node cg)
                                        (if (== tag TAG_E_SUBCHECK)
                                          (emitPrimSubtypeCheck node cg)
                                          (emitDefault cg))))))))))))))))))))
  })

; ------------------------------------------------------------------
; The effect system: dynamic handlers by evidence passing.
;
; `(handle body (E ...) h)` installs `h` as E's evidence for the
; body's dynamic extent, and an operation of E called anywhere inside
; that extent - however many frames down, and mentioning no handler
; itself - dispatches through it. The evidence is a heap-allocated
; two-word record `{handler, previous}`; the effect's slot, a mutable
; global, holds the innermost, and entry and exit are a push and a
; pop.
;
; Shallow and tail-resumptive: the handler's return value IS the
; operation's result, and there is no continuation to resume. That is
; the whole of what stage0 implements, and reproducing more of it here
; would be stage1 doing something the compiler it must agree with
; cannot.
; ------------------------------------------------------------------
; The first effect in a handle's list that resolves to a DECLARED
; effect, or `None` when none does. A list naming only built-in effects
; (`IO`, `Alloc`, ...) declares no evidence and installs nothing.
(pub :: handleEffectEnt (-> ASTNode CG (Option EffEnt)))
(pub fn (handleEffectEnt node cg)
  (handleEffectEntFrom (nodeBChildren node) cg 0))

(pub :: handleEffectEntFrom (-> (Vec ASTNode) CG Int (Option EffEnt)))
(pub fn (handleEffectEntFrom effs cg i)
  (if (>= i (vecLen effs))
    (None)
    (if (let (Some e) (lookupEffFor cg (cgEffDecls cg) (nodeAName (vecGet effs i))))
      (Some e)
      (handleEffectEntFrom effs cg (+ i 1)))))

(pub :: emitHandle (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitHandle node cg)
  (if (let (Some ent) (handleEffectEnt node cg))
    ; Quote the slot once before emission; its unquoted spelling stays
    ; the registry's key.
    (emitHandleDyn node (llvmSym (effSlot ent)) cg)
    ; A builtin-only list is a static effect scope. It lowers to the
    ; body without evaluating the handler, matching stage0.
    (emitExpr (nodeAChild node) cg)))

(pub :: emitHandleDyn (-> ASTNode String CG CG))
;@axiom:effect(io)
(pub fn (emitHandleDyn node slot cg)
  ; The body is deliberately NOT emitted in tail position: the restore
  ; below has to run after it, and a self tail call rewritten to a
  ; jump would skip it and leave the handler installed forever.
  ; MM-LIFE-2d, the evidence record's own map: two
  ; payload words and both of them references - word 0
  ; the handler value, word 1 the record this entry
  ; displaced. Spelled through the same helpers every
  ; other writer uses rather than as a constant,
  ; because the encoding is a rule and not a number.
  ; A1: the evidence record births owned; event 7's
  ; release at the pop is what spends it
  ; MM-LIFE-2c event 6, the half this record was
  ; missing: both words are stored OWNED. The handler
  ; is retained unless it was built right here - a
  ; directly-built lambda MOVES, its birth count IS the
  ; field's share - and the displaced record is
  ; retained because the slot refers to it again after
  ; the restore. Both shares come back at the pop, when
  ; the release below walks the map above; this is the
  ; balance the standing rule demands, that a retain
  ; must be one an existing map can return.
  {
    (let _0 (cgSetTailOK cg 0))
    {
      (let cgH (emitExpr (nodeCChild node) cg))
      {
        (let hval (strDup (cgResult cgH)))
        (let recN (allocReg cgH))
        (let oldN (allocReg cgH))
        {
          (let rec (regStr recN))
          (let old (regStr oldN))
          {
            (let _1 (emitLine cgH (concat (concat "  " rec) " = call i64 @axiom_alloc(i64 16)")))
            (let _1a (storeShapeAt cgH rec (+ (* (paddedWords 2) 2) (+ (pow2 16) (pow2 17)))))
            (let _1b (storeCountOneAt cgH rec))
            (let _1c
              (if (== (argIsDirectCon cgH (nodeCChild node)) 1)
                cgH
                (emitRetainOf cgH hval)))
            (let _2 (storeWordAt cgH rec 0 hval))
            (let _3
              (emitLine cgH
                (concat (concat "  " old) (concat " = load i64, ptr @" (concat slot "")))))
            (let _3b (emitRetainOf cgH old))
            (let _4 (storeWordAt cgH rec 1 old))
            (let _5 (emitLine cgH (concat "  store i64 " (concat rec (concat ", ptr @" slot)))))
            (let _6 (cgSetTailOK cgH 0))
            {
              (let cgB (emitExpr (nodeAChild node) cgH))
              {
                (let res (strDup (cgResult cgB)))
                (let flag (cgResultFloat cgB))
                {
                  {
                    (emitLine cgB (concat "  store i64 " (concat old (concat ", ptr @" slot))))
                    ; MM-LIFE-2c event 7: the evidence record dies at
                    ; the pop, closing sixteen of MM-ALLOC-9a's
                    ; sixteen bytes per loop entry; the block files
                    ; and the next entry reuses it. Since the map
                    ; above it is no longer header-deep: the walk
                    ; hands back the handler's share and the
                    ; displaced record's, so a handler built AT the
                    ; handle - the common `(handle e (Eff) (lambda
                    ; ...))` - is reclaimed with its record instead
                    ; of accumulating one closure per entry.
                    (emitReleaseOf cgB (strDup rec))
                  }
                  (cgSetResult cgB res)
                  (cgSetResultFloat cgB flag)
                  cgB
                }
              }
            }
          }
        }
      }
    }
  })

; One effect-operation call.
;
; The handler runs under the evidence in scope at its INSTALLATION:
; the previous record is installed for the duration of the call and
; this one restored after, so an operation the handler itself performs
; dispatches OUTWARD to the next handler instead of re-entering the
; same one - which the naive lowering does forever. It is also what
; the static attribution already committed to, since a handler's own
; effects propagate past its own `handle`.
;
; No handler installed is a TRAP, not a zero: the operation has no
; result to produce, and continuing on a garbage one turns a missing
; handler into a wrong answer somewhere else entirely. Exit 71, which
; the allocators' out-of-memory 70 deliberately does not collide with.
;
; Arguments are evaluated BEFORE the slot is read, which is stage0's
; order and matters at exactly one observable point: an argument that
; prints must print even when the dispatch below traps.
(pub :: emitEffectOp (-> EffEnt Nodes CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitEffectOp ent args cg snode)
  ; Emission only, as in `emitHandle`: the registry is keyed on the
  ; unquoted name.
  {
    (let slot (llvmSym (effSlot ent)))
    (let regs vecNew)
    {
      (let cgA (emitArgRegs args cg regs 0))
      {
        (let recN (allocReg cgA))
        (let cmpN (allocReg cgA))
        (let trapN (allocReg cgA))
        (let goN (allocReg cgA))
        {
          (let rec (regStr recN))
          (let cmpR (regStr cmpN))
          (let trapB (labelStr trapN))
          (let goB (labelStr goN))
          {
            (let _1
              (emitLine cgA
                (concat (concat "  " rec) (concat " = load i64, ptr @" (concat slot "")))))
            (let _2
              (emitLine cgA
                (concat (concat "  " cmpR) (concat " = icmp eq i64 " (concat rec ", 0")))))
            (let _3
              (emitLine cgA
                (concat (concat "  br i1 " (concat cmpR ", label %"))
                  (concat trapB (concat (concat ", label %" goB) "")))))
            (let _4 (emitLabel cgA trapB))
            (let _4b (emitLineMark snode cgA))
            (let _5 (emitLine cgA "  call i64 @__axiom_unhandled_effect()"))
            (let _6 (emitLine cgA "  unreachable"))
            (let _7 (emitLabel cgA goB))
            {
              (let cgL (loadWordAt cgA rec 0))
              {
                (let handler (strDup (cgResult cgL)))
                {
                  (let cgP (loadWordAt cgL rec 1))
                  {
                    (let prev (strDup (cgResult cgP)))
                    {
                      (let _8
                        (emitLine cgP
                          (concat "  store i64 " (concat prev (concat ", ptr @" slot)))))
                      {
                        (let cgR (emitApplyRegs args regs cgP handler 0 snode))
                        {
                          (let res (strDup (cgResult cgR)))
                          {
                            (emitLine cgR
                              (concat "  store i64 " (concat rec (concat ", ptr @" slot))))
                            (cgSetResult cgR res)
                            (cgSetResultFloat cgR 0)
                            cgR
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; Every argument evaluated, left to right, into its own register -
; collected before anything that consumes them is emitted.
(pub :: emitArgRegs (-> Nodes CG Strings Int CG))
;@axiom:effect(io)
(pub fn (emitArgRegs args cg out i)
  (if (>= i (vecLen args))
    cg
    {
      (let cgA (emitExpr (vecGet args i) cg))
      {
        (vecPush out (strDup (cgResult cgA)))
        (emitArgRegs args cgA out (+ i 1))
      }
    }))

; `emitApplyChain` over registers that are already evaluated. One
; argument per indirect call, for the same reason: every function
; value absorbs exactly one, so a two-argument operation takes a
; curried handler chain and applying both at once would answer with
; the inner closure's address.
(pub :: emitApplyRegs (-> Nodes (Vec a) CG String Int ASTNode CG))
(pub fn (emitApplyRegs args regs cg rec i snode)
  (emitApplyRegsOwned args regs cg rec i 0 snode))

; The walk, carrying whether THIS walk produced `rec`. `recOwned` is 0
; for the record the caller handed in - the handler loaded out of the
; evidence record, or a closure value someone else's `let` holds - and
; 1 for every record a previous step of this same walk returned.
;
; MM-LIFE-2c: an intermediate record of a curried chain is born at
; count 1 by the inner `lambda` and nothing else ever holds it, so
; once the next step has loaded its code pointer and called it, its
; share is the caller's to give back. Measured before the rule: the
; count on the intermediate reads 1 after the step that made it and 1
; after the step that consumed it, so the release takes it to 0 and
; the block files. Unreleased it was 31-32 bytes per two-argument
; operation, which is the whole of `Fallible.ax`'s "two arguments
; (message, fallback) 32 bytes per operation" row.
(pub :: emitApplyRegsOwned (-> (Vec ASTNode) (Vec a) CG String Int Int ASTNode CG))
(pub fn (emitApplyRegsOwned args regs cg rec i recOwned snode)
  (if (>= i (vecLen regs))
    {
      (cgSetResult cg rec)
      (cgSetResultFloat cg 0)
      cg
    }
    ; 0, and STATED rather than defaulted: the handler here is a
    ; runtime load out of the effect's evidence slot, so there is no
    ; application node whose class the checker could have recorded.
    ; Under-retaining leaks; the alternative would be to guess.
    ; The argument half, same rule as the chain walker's: the
    ; last step's argument goes with the call when it is owned,
    ; neither static nor nullary, and the stamped answer is a
    ; word. Intermediate arguments stay for the same reason -
    ; the next step loads the answer's word 0 as a code pointer,
    ; so it may alias them. `args` and `regs` are parallel (one
    ; register per node, pushed in order by `emitArgRegs`), which
    ; is what lets this walker classify what it already
    ; evaluated.
    {
      (let cgR
        (applyOneArg cg rec (vecGetStr regs i) (constStr 0) snode
          (if (>= (+ i 1) (vecLen regs))
            1
            0)))
      {
        (let cgD
          (if (== recOwned 1)
            (emitReleaseOf cgR rec)
            cgR))
        {
          (let cgE
            (if (&& (>= (+ i 1) (vecLen regs))
                  (&& (== (valueOwnedRef cgD (vecGet args i)) 1)
                    (&& (== (isStaticSentinelNode cgD (vecGet args i)) 0)
                      (&& (== (isNullaryConNode cgD (vecGet args i)) 0)
                        (== (nodeResWord snode) 1)))))
              (emitReleaseOf cgD (vecGetStr regs i))
              cgD))
          (emitApplyRegsOwned args regs cgE (strDup (cgResult cgE)) (+ i 1) 1 snode)
        }
      }
    }))

; One mutable global per declared effect - the evidence slot, zero for
; "no handler installed" - and the trap an unhandled operation exits
; through. Emitted after every body, beside the string globals, since
; LLVM does not care about order.
;
; stage0 emits a slot only for an effect the program actually touches;
; this emits one per DECLARED effect. The difference is one internal,
; unreferenced global for an effect nothing performs or handles.
(pub :: emitEffectGlobals (-> CG Int CG))
(pub fn (emitEffectGlobals cg i)
  {
    (let tbl (cgEffDecls cg))
    (if (>= i (vecLen tbl))
      (if (== (vecLen tbl) 0)
        cg
        (emitUnhandledTrap cg))
      ; One global per SLOT, not per registry entry: an imported
      ; effect is registered twice - bare, and under `Mod$name` so
      ; a reference inside its own module finds it - and both
      ; entries name the same slot. Emitting per entry produced two
      ; definitions of one global, which llc refuses outright.
      ; The dedup above compares the UNQUOTED slot, because that is
      ; the registry's key; only the definition emitted from it is
      ; quoted, and it has to agree with the loads and stores
      ; `emitHandle`/`emitEffectOp` quote the same way.
      {
        (if (== (slotFirstIndex tbl (effSlot (vecGet tbl i)) 0) i)
          (emitLine cg
            (concat "@"
              (concat (llvmSym (effSlot (vecGet tbl i)))
                (concat " = " (concat (cgMutGlobal cg) " i64 0"))))))
        (emitEffectGlobals cg (+ i 1))
      })
  })

; The index of the first entry carrying `slot`, or -1. Two entries may
; share one slot; only the first of them emits its global.
(pub :: slotFirstIndex (-> (Vec EffEnt) String Int Int))
(pub fn (slotFirstIndex tbl slot i)
  (if (>= i (vecLen tbl))
    (- 0 1)
    (if (strEq (effSlot (vecGet tbl i)) slot)
      i
      (slotFirstIndex tbl slot (+ i 1)))))

; The trap an effect operation falls into when its evidence slot reads
; zero - no handler in dynamic extent - as a function rather than a
; copy of an exit at every operation site.
;
; IT USED TO SAY NOTHING. The body was the exit syscall and
; `unreachable`, so a program that performed an unhandled effect
; vanished with status 71 and no output at all. Status 70 had exactly
; this defect until `emitOomTrap` was given a message, and the argument
; recorded there transfers unchanged: a worker in a pre-forked pool
; disappears, the supervisor respawns it, and nothing anywhere says
; why. Axiom now HAS such a pool - tests/net/echo-server.ax - and an
; operation that escaped its `handle` is precisely the fault a respawn
; hides, because the surviving worker is the one that did not perform
; it.
;
; This is the third member of the family `emitDivTrap` opened for 72
; and `emitOomTrap` joined for 70, emitted the same way: a private
; constant, a write to fd 2, then the exit. The length in the array
; type is the message's byte count EXACTLY - 24, counting the trailing
; newline - because llc believes the declared length, and a wrong one
; truncates the sentence or writes bytes past it.
;
; `tests/stdlib/310-effect-unhandled` pins both halves. Its `.exit` has
; carried 71 since the case was written; the silence was invisible
; because `run-stdlib-tests.sh` discards stderr unless `NAME.err`
; exists, and it did not. It does now, and it holds this sentence.
(pub :: emitUnhandledTrap (-> CG CG))
(pub fn (emitUnhandledTrap cg)
  {
    (emitLine cg "")
    (emitLine cg
      "@__axiom_unhandled_msg = private unnamed_addr constant [24 x i8] c\"axiom: unhandled effect\\0A\"")
    (emitLine cg
      (concat "define internal i64 @__axiom_unhandled_effect() " (concat trapFnAttrs " {")))
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 71)")
    (emitLine cg "  %uep = ptrtoint ptr @__axiom_unhandled_msg to i64")
    (emitRuntimeWrite cg "%uep" "24")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "71")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    cg
  })

; `(struct Name field...)` - the keyword construction form. It builds
; the identical block the application spelling `(Name field...)`
; builds, through the same emitConstructor, because stage0 lowers
; both to a heap block of `fields * 8` bytes with argument i at word
; i. A name with no registry entry cannot reach here on a checked
; program - it is AX3002 - but emission must not segfault on one, so
; an unknown name answers the constant 0, the same shape stage0's
; generator falls back to.
(pub :: emitStructConExpr (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitStructConExpr node cg)
  {
    (let types (cgTypes cg))
    (let args (nodeBChildren node))
    {
      (let entryFound (lookupType types (nodeAName node)))
      (if (let (Some entry) entryFound)
        (zeroFloat (emitConstructor args entry nilNode cg))
        {
          (cgSetResult cg (constStr 0))
          (cgSetResultFloat cg 0)
          cg
        })
    }
  })

; `(set base.field v)`: the base evaluates once, the field resolves as
; a read does, and the value is stored at its offset. The whole form
; evaluates to 0 - stage0's rule, and NOT plain `set`'s, which answers
; the stored value.
; MM-LIFE-2c event 5, in full: a store into a REFERENCE field
; retains the new value and releases the one it overwrites. The order
; is load-old, evaluate-new, retain-new, store, release-old, and the
; retain-before-release half of it is what makes `(set e.f e.f)`
; survive rather than free what it just stored.
;
; This is the one event whose balance is LOCAL and provable without
; escape analysis: a mapped field's old value is owned by the block,
; because the store that put it there took a share - either
; `emitFieldStores` at construction or this function on a previous
; pass - so handing that share back here is arithmetic, not a
; judgement about who else might be holding it. The classification is
; `fldClass`'s, the same one that decided the block's map, so the
; release set and the walk set cannot disagree.
;
; A directly-built value MOVES, exactly as it does at construction: a
; retain would double-count its birth.
(pub :: emitStructFieldRc (-> CG Int String Int String Int CG))
(pub fn (emitStructFieldRc cg cls shape bit value op)
  (if (== cls 2)
    (if (== op 1)
      (emitRetainOf cg value)
      (emitReleaseOf cg value))
    (emitRcIfBitOf cg value bit shape op)))

(pub :: emitSetF (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitSetF node cg)
  {
    (let cgB (emitExpr (nodeAChild node) cg))
    {
      (let base (strDup (cgResult cgB)))
      (let fi (resolveStructField (cgTypes cgB) node))
      (if (nodeSame fi nilNode)
        (cgFail cg "unknown struct field: " (nodeBName node))
        ; A generic field's reference bit was fixed at construction.
        ; Invariant type arguments preserve it across every write.
        {
          (let cls (fldClass cgB (nodeCChild fi)))
          (let owns (!= cls 0))
          (let cgH
            (if (== cls 1)
              (loadWordAt cgB base -1)
              cgB))
          (let shape
            (if (== cls 1)
              (strDup (cgResult cgH))
              ""))
          (let bit (+ 16 (/ (nodeA fi) 8)))
          (let cgL
            (if owns
              (loadStructFieldAt cgH base (nodeA fi) (nodeTyChild fi))
              cgH))
          (let old
            (if owns
              (strDup (cgResult cgL))
              ""))
          (let cgV (emitExpr (nodeCChild node) cgL))
          (let v (strDup (cgResult cgV)))
          (let cgR
            ; A static value needs no share, so storing a literal takes
            ; none and gives none back.
            (if (&& owns
                  (&& (!= (argIsDirectCon cgV (nodeCChild node)) 1)
                    (== (isStaticSentinelNode cgV (nodeCChild node)) 0)))
              (emitStructFieldRc cgV cls shape bit v 1)
              cgV))
          (let cgS (storeStructFieldAt cgR base (nodeA fi) (nodeTyChild fi) v))
          (let cgD
            (if owns
              (emitStructFieldRc cgS cls shape bit old 0)
              cgS))
          (let cgT
            (if (&& owns
                  (&& (!= (argIsDirectCon cgD (nodeCChild node)) 1)
                    (&& (== (valueOwnedRef cgD (nodeCChild node)) 1)
                      (== (isStaticSentinelNode cgD (nodeCChild node)) 0))))
              (emitStructFieldRc cgD cls shape bit v 0)
              cgD))
          {
            (cgSetResult cgT (constStr 0))
            (cgSetResultFloat cgT 0)
            cgT
          }
        })
    }
  })

; `base.field`: the field resolves through the struct the CHECKER
; stamped on the node (`resolveStructField`). Its byte offset follows
; the declaration's naturally aligned field layout; structs carry no tag.
;
; It resolved by name across the whole struct registry until
; 2026-08-21 - first declaring struct wins, "the same simplification
; stage0 makes for float-ness" - and that simplification cost type
; safety rather than precision: two structs sharing a field name at
; different offsets read and wrote each other's slots, `check` said
; OK, and the QA sweep's four-line repro died of SIGSEGV
; (typecheck.ax's `checkField` carries the measurement). The
; receiver's static type is the checker's to know, so the checker
; decides and this reads its answer.
(pub :: emitField (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitField node cg)
  {
    (let cgB (emitExpr (nodeAChild node) cg))
    {
      (let base (strDup (cgResult cgB)))
      (let fi (resolveStructField (cgTypes cgB) node))
      (if (nodeSame fi nilNode)
        ; Not a struct field: it may be a DATA constructor's named
        ; field. Those live PAST THE TAG WORD, so the offset is
        ; index + 1 where a struct's is index - a struct carries no
        ; tag. stage0 searches every data type, first match winning.
        {
          (let diFound (resolveDataField (cgTypes cgB) node))
          (if (let (Some di) diFound)
            {
              (let cgL (loadWordAt cgB base (+ (nodeA di) 1)))
              {
                (cgSetResultFloat cgL (nodeB di))
                cgL
              }
            }
            (cgFail cg "unknown struct field: " (nodeBName node)))
        }
        {
          (let cgL (loadStructFieldAt cgB base (nodeA fi) (nodeTyChild fi)))
          {
            (cgSetResultFloat cgL (nodeB fi))
            cgL
          }
        })
    }
  })

; A data constructor's named field as an inert (index, floatFlag)
; node when found. Searched in registry order, first match winning.
; The checker stamps a resolved constructor on a typed data-field read.
; Its entry supplies the correct slot and Float flag across modules.
(:: resolveDataField (-> (Vec TypeEntry) ASTNode (Option ASTNode)))
;@axiom:effect(unsafe)
(fn (resolveDataField types node)
  (if (== (nodeBinderTy node) 0)
    (findDataField types (nodeBName node))
    {
      (let entryFound (lookupType types (as (nodeBinderTy node) String)))
      (if (let (Some entry) entryFound)
        (dataFieldOfEntry entry (nodeBName node))
        None)
    }))

(:: dataFieldOfEntry (-> TypeEntry String (Option ASTNode)))
(fn (dataFieldOfEntry entry name)
  (match (eFieldNamesVec entry)
    ((None) None)
    ((Some names)
      (match (dataFieldIndexIn names name 0)
        ((None) None)
        ((Some i)
          (Some
            (nodeBuildFieldOffset i
              (if (< i (vecLen (eFieldFlagsVec entry)))
                (vecGet (eFieldFlagsVec entry) i)
                0)))
        ))
    )))

(pub :: findDataField (-> (Vec TypeEntry) String (Option ASTNode)))
(pub fn (findDataField types fname)
  (findDataFieldFrom types fname 0))

(pub :: findDataFieldFrom (-> (Vec TypeEntry) String Int (Option ASTNode)))
(pub fn (findDataFieldFrom types fname i)
  (if (>= i (vecLen types))
    None
    {
      (let e (vecGet types i))
      (if (!= (eKind e) TF_DATA)
        (findDataFieldFrom types fname (+ i 1))
        (match (eFieldNamesVec e)
          ((None) (findDataFieldFrom types fname (+ i 1)))
          ((Some names)
            (match (dataFieldIndexIn names fname 0)
              ((None) (findDataFieldFrom types fname (+ i 1)))
              ((Some j)
                (Some
                  (nodeBuildFieldOffset j
                    (if (< j (vecLen (eFieldFlagsVec e)))
                      (vecGet (eFieldFlagsVec e) j)
                      0)))
              ))
          )))
    }))

(pub :: dataFieldIndexIn (-> Names String Int (Option Int)))
(pub fn (dataFieldIndexIn names fname i)
  (if (>= i (vecLen names))
    None
    (if (strEq (vecGetStr names i) fname)
      (Some i)
      (dataFieldIndexIn names fname (+ i 1)))))

; The field of a TAG_E_FIELD / TAG_E_SETF node, as the inert
; (index, floatFlag, type) node `findStructFieldIn` builds, or 0.
;
; Word 6 of the node is the struct the checker resolved the field
; through - `stampFieldStruct`, keyed exactly as `lookupType` is - and
; when it is there the field is looked up IN THAT STRUCT and nowhere
; else. The program-wide scan below is reached only for a node the
; checker did not stamp: a base whose type it could not know (the
; silent wildcard - a macro head, an unparseable type), or a field
; that resolved as a DATA constructor's named field rather than a
; struct's, which `emitField` goes on to try next. A stamped struct
; that the table cannot find, or that lacks the field, answers 0
; rather than falling back: both are checker/emitter disagreements,
; and a wrong slot is the failure this exists to refuse.
(pub :: resolveStructField (-> (Vec TypeEntry) ASTNode ASTNode))
;@axiom:effect(unsafe)
(pub fn (resolveStructField types node)
  (if (== (nodeTy node) 0)
    (findStructField types (nodeBName node))
    ; The empty stamp: the checker resolved the field as a DATA
    ; constructor's named field, and `emitField` must go straight
    ; to `findDataField` - the struct scan it used to try first
    ; answered an unrelated struct's slot of the same name, which
    ; for `(data Shape () (Rect { name : String ... }))` beside
    ; `(struct P (w : Int) (tag : Int) (name : String))` read
    ; `r.name` at word 2 and died of SIGSEGV
    {
      (let key (as (nodeTy node) String))
      (if (== (strLen key) 0)
        nilNode
        {
          (let eFound (lookupType types key))
          (if (let (Some e) eFound)
            (if (!= (eKind e) TF_STRUCT)
              nilNode
              (structFieldOf e (nodeBName node)))
            nilNode)
        })
    }))

; The named field of one struct entry, or 0 when absent. The inert
; node holds byte offset in A, Float flag in B and ownership type in C.
; Its nodeTy preserves the declared storage type. Generic fields remain
; words even when their instantiated value type is a narrow integer.
; Ordinary structs store explicit integer widths at natural alignment.
; A link with a width is stored as that unsigned integer (MM-VAL-10b).
; Every other field occupies an aligned machine word, including references.
; These are payload offsets, independent of the one-word value/call ABI.
(pub :: fieldIntegerCode (-> ASTNode Int))
(pub fn (fieldIntegerCode ty)
  (if (nodeSame ty nilNode)
    0
    (if (== (nodeTag ty) TAG_T_CON)
      (if (> (linkWidthCode ty) 0)
        (linkWidthCode ty)
        (integerTypeCode (nodeAName ty)))
      0)))

(pub :: fieldStorageBytes (-> ASTNode Int))
(pub fn (fieldStorageBytes ty)
  {
    (let code (fieldIntegerCode ty))
    (if (> code 0)
      (/ (integerBits code) 8)
      8)
  })

(pub :: fieldAligned (-> Int Int Int))
(pub fn (fieldAligned offset bytes)
  (* (/ (+ offset (- bytes 1)) bytes) bytes))

(pub :: structFieldOffsetFrom (-> (Vec ASTNode) Int Int Int Int))
(pub fn (structFieldOffsetFrom fields wanted i offset)
  (if (>= i (vecLen fields))
    offset
    {
      (let bytes (fieldStorageBytes (nodeTyChild (vecGet fields i))))
      (let at (fieldAligned offset bytes))
      (if (== i wanted)
        at
        (structFieldOffsetFrom fields wanted (+ i 1) (+ at bytes)))
    }))

(pub :: structFieldOffset (-> (Vec ASTNode) Int Int))
(pub fn (structFieldOffset fields i)
  (structFieldOffsetFrom fields i 0 0))

(pub :: structPayloadBytes (-> (Vec ASTNode) Int))
(pub fn (structPayloadBytes fields)
  (structFieldOffset fields (vecLen fields)))

; A narrow field load restores the canonical signed/unsigned word.
(pub :: loadStructFieldAt (-> CG String Int ASTNode CG))
(pub fn (loadStructFieldAt cg base offset ty)
  {
    (let bytes (fieldStorageBytes ty))
    (if (== bytes 8)
      (loadWordAt cg base (/ offset 8))
      {
        (let ptr (regStr (allocReg cg)))
        (let at (regStr (allocReg cg)))
        (let value (regStr (allocReg cg)))
        (let llvmTy (concat "i" (fmtInt (* bytes 8))))
        {
          (emitLine cg
            (concat "  " (concat ptr (concat " = inttoptr i64 " (concat base " to ptr")))))
          (emitLine cg
            (concat "  "
              (concat at
                (concat " = getelementptr i8, ptr "
                  (concat ptr (concat ", i64 " (fmtInt offset)))))))
          (emitLine cg
            (concat "  "
              (concat value
                (concat " = load "
                  (concat llvmTy
                    (concat ", ptr " (concat at (concat ", align " (fmtInt bytes)))))))))
          (emitIntegerExtend cg value (fieldIntegerCode ty))
        }
      })
  })

(pub :: storeStructFieldAt (-> CG String Int ASTNode String CG))
(pub fn (storeStructFieldAt cg base offset ty value)
  {
    (let bytes (fieldStorageBytes ty))
    (if (== bytes 8)
      (storeWordAt cg base (/ offset 8) value)
      {
        (if (> (linkWidthCode ty) 0)
          (emitLinkFits cg value bytes))
        (let narrow (emitIntegerNarrow cg value (* bytes 8)))
        (let ptr (regStr (allocReg cg)))
        (let at (regStr (allocReg cg)))
        (let llvmTy (concat "i" (fmtInt (* bytes 8))))
        {
          (emitLine cg
            (concat "  " (concat ptr (concat " = inttoptr i64 " (concat base " to ptr")))))
          (emitLine cg
            (concat "  "
              (concat at
                (concat " = getelementptr i8, ptr "
                  (concat ptr (concat ", i64 " (fmtInt offset)))))))
          (emitLine cg
            (concat "  store "
              (concat llvmTy
                (concat " "
                  (concat narrow
                    (concat ", ptr " (concat at (concat ", align " (fmtInt bytes)))))))))
          cg
        }
      })
  })

; A link is a word everywhere but a field with a width, so the store is
; where it must fit: index + 1 no larger than the width's largest value.
; One that doesn't fails as a violated contract does, status 80, since
; the field's type states a range the way a subtype does (MM-VAL-10b).
(pub :: emitLinkFits (-> CG String Int CG))
(pub fn (emitLinkFits cg value bytes)
  {
    (let most
      (if (== bytes 1)
        "255"
        (if (== bytes 2)
          "65535"
          "4294967295")))
    (let wide (regStr (allocReg cg)))
    (let badL (labelStr (allocReg cg)))
    (let okL (labelStr (allocReg cg)))
    (let msg (regStr (allocReg cg)))
    (let id (internString cg "\"axiom: link does not fit its field\\n\""))
    {
      (emitLine cg
        (concat "  " (concat wide (concat " = icmp ugt i64 " (concat value (concat ", " most))))))
      (emitLine cg
        (concat "  br i1 "
          (concat wide (concat ", label %" (concat badL (concat ", label %" okL))))))
      (emitLabel cg badL)
      (emitLine cg
        (concat "  "
          (concat msg
            (concat
              " = ptrtoint ptr getelementptr inbounds ({ i64, i64, i64, ptr, i64 }, ptr @strhdr_"
              (concat (fmtInt id) ", i64 0, i32 2) to i64")))))
      (emitLine cg (concat "  call i64 @__axiom_contract_fail(i64 " (concat msg ")")))
      (emitLine cg "  unreachable")
      (emitLabel cg okL)
      cg
    }
  })

(pub :: structFieldOf (-> TypeEntry String ASTNode))
(pub fn (structFieldOf e name)
  (match (eStructFields e)
    ((None) nilNode)
    ((Some fields)
      {
        (let idx (fieldIndexIn fields name 0))
        (if (< idx 0)
          nilNode
          {
            (let field (vecGet fields idx))
            (setNodeTyWord
              (nodeBuildNilPlain (structFieldOffset fields idx) (nodeB field) (nodeTy field))
              (nodeTy field))
          })
      }
    )))

; The field's (byte offset, Float flag, type), or 0 when no struct
; declares the name.
(pub :: findStructField (-> (Vec TypeEntry) String ASTNode))
(pub fn (findStructField types name)
  (findStructFieldIn types name 0))

(pub :: findStructFieldIn (-> (Vec TypeEntry) String Int ASTNode))
(pub fn (findStructFieldIn types name i)
  (if (>= i (vecLen types))
    nilNode
    {
      (let e (vecGet types i))
      (if (== (eKind e) TF_STRUCT)
        ; C classifies ownership transfers (MM-LIFE-2c event 5).
        ; Physical reads and writes use the separate declared type
        ; in nodeTy, so instantiation cannot shrink a generic slot.
        {
          (let fi (structFieldOf e name))
          (if (nodeSame fi nilNode)
            (findStructFieldIn types name (+ i 1))
            fi)
        }
        (findStructFieldIn types name (+ i 1)))
    }))

(pub :: fieldIndexIn (-> (Vec ASTNode) String Int Int))
(pub fn (fieldIndexIn fields name i)
  (if (>= i (vecLen fields))
    (- 0 1)
    (if (strEq (nodeAName (vecGet fields i)) name)
      i
      (fieldIndexIn fields name (+ i 1)))))

; E_Int
(pub :: emitInt (-> ASTNode CG CG))
(pub fn (emitInt node cg)
  {
    (let v (nodeA node))
    {
      (cgSetResult cg (constStr v))
      (cgSetResultFloat cg 0)
      cg
    }
  })

; E_Flt: the node already holds the IEEE-754 bits, and the bits *are*
; the value, so a float literal is the same immediate an integer is -
; only the flag differs, and the flag is what routes `(+ x 1.5)` to
; `fadd`.
(pub :: emitFlt (-> ASTNode CG CG))
(pub fn (emitFlt node cg)
  {
    (let bits (nodeA node))
    {
      (cgSetResult cg (constStr bits))
      (cgSetResultFloat cg 1)
      cg
    }
  })

; E_Var: emit register reference (%name) or nullary constructor tag constant.
; Checks symbol table first (let-bound variables), then type registry (constructors).
(pub :: emitVar (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitVar node cg)
  ; A macro used to be expanded HERE, ahead of the symbol table, so a
  ; macro name outranked every binder in the program: `(macro (v) 9)`
  ; made a parameter named `v` evaluate to 9. Expansion now happens in
  ; `core/expand.ax`, before the checker, and that pass knows
  ; which names are bound - so by the time emission runs there is no
  ; macro left to expand and a local is a local.
  ; A zero-argument primitive is spelled `(__argc)`, which is a bare
  ; variable reference by the time it gets here. Without this it fell
  ; through to the undefined-name emission `%__argc`.
  ;
  ; `__axiom_arena_mark` was the second one, and it was NOT handled -
  ; the comment here named it while the code did not, so
  ; `tests/stdlib/160-arena.ax` emitted `%__axiom_arena_mark`, a
  ; value nothing defines, and llc rejected the module. stage0
  ; carries a comment about hitting exactly this, for exactly this
  ; primitive, and calls it "the only one that could go wrong". Then
  ; `__fence` was the third, on 2026-08-29, and did the same thing on
  ; its first day: the set was two spellings written HERE, so the
  ; next member did not know about it. The set is a definition now,
  ; `isNullaryPrimName`, beside the other name tables. None of them
  ; is polymorphic, so the stamp a bare reference cannot carry is
  ; the constant 0 here.
  {
    (let name (nodeAName node))
    (if (isNullaryPrimName name)
      (zeroFloat (emitPrim name vecNew cg nilNode))
      ; Same rule as `checkVar`: a reference a macro template produced
      ; is resolved at the scope the template was written in, and the
      ; two resolvers have to agree or the checker types one binding
      ; while the emitter reads another.
      {
        (let symIdx
          (if (== (nodeDefScope node) 1)
            None
            (symIndex cg name)))
        (if (let (Some symIdx) symIdx)
          (if (if (== (lookupSymKind cg name) 3)
            false
            (>= (lookupSymKind cg name) 1))
            ; A mutable binding: the register is its storage, and the
            ; value is a fresh load - which is what makes a `set` in
            ; a loop body visible on the next trip's read.
            {
              (let rn (allocReg cg))
              {
                (let r (regStr rn))
                {
                  (emitLine cg
                    (concat (concat "  " r)
                      (concat " = load i64, ptr " (concat (strDup (symRegAt cg symIdx)) ""))))
                  (cgSetResult cg r)
                  (cgSetResultFloat cg (lookupSymFloat cg name))
                  cg
                }
              }
            }
            {
              (cgSetResult cg (strDup (symRegAt cg symIdx)))
              (cgSetResultFloat cg (lookupSymFloat cg name))
              cg
            })
          (if (strEq name "true")
            {
              (cgSetResult cg (constStr 1))
              (cgSetResultFloat cg 0)
              cg
            }
            (if (strEq name "false")
              {
                (cgSetResult cg (constStr 0))
                (cgSetResultFloat cg 0)
                cg
              }
              ; The constructor table is consulted before the nullary
              ; function table: stage0's EVar lowering tries
              ; find_constructor first, so a name that is both - a nullary
              ; constructor and a nullary function - yields the constructor
              ; value, and parity means agreeing on that order.
              {
                (let parameter (&& (!= (nodeDefScope node) 1) (>= (paramIndexOf cg name) 0)))
                (let entryFound
                  (if parameter
                    (None)
                    (lookupType (cgTypes cg) name)))
                (if (let (Some entry) entryFound)
                  (if (== (eArity entry) 0)
                    ; A bare nullary constructor: an immediate tag for
                    ; an all-nullary type, a fresh one-word block
                    ; otherwise - the same split construction makes.
                    (zeroFloat (emitConstructor vecNew entry nilNode cg))
                    {
                      (let z 0)
                      {
                        (cgSetResult cg (constStr z))
                        (cgSetResultFloat cg 0)
                        cg
                      }
                    })
                  ; A nullary function referenced bare is a call, not a
                  ; register. Emitting `%answer` names a value nothing
                  ; defines. The decl list carries mangled names, so the
                  ; reference is resolved through the map before it is
                  ; compared or emitted.
                  ;
                  ; Through the INDEX. `buildNameIndexes` exists because
                  ; the linear `mangledFor` cost a self-compile 2.2s on
                  ; the scans alone - and then this call site, one of the
                  ; two hottest it was built for, kept asking the scan.
                  ;
                  ; A parameter of the function being emitted wins, as
                  ; it does in the function-value arm below and in the
                  ; checker, which types it as the parameter. Without
                  ; that, `(fn (k) 100)` beside `(fn (inc k) (+ k 1))`
                  ; made `(inc 10)` answer 101, and an entry file's `e`
                  ; turned `Err$errCode`'s parameter into a call
                  ; (`tests/selfhost/1007-param-shadows-nullary.ax`).
                  {
                    (let full (mangledForCg cg name))
                    (if (&& (isNullaryFnCg cg full) (! parameter))
                      {
                        (let rn (allocReg cg))
                        {
                          (let r (regStr rn))
                          {
                            ; A bare nullary call is still a call, and a
                            ; frame for it still needs its line: the
                            ; reference node carries the span, so it
                            ; marks like every other call site. `node`
                            ; here is the snode `emitCallMark` wants.
                            (emitCallMark node cg rn)
                            (emitLine cg
                              (concat (concat "  " r)
                                (concat " = call i64 @" (concat (llvmSym (strDup full)) "()"))))
                            (cgSetResult cg r)
                            (cgSetResultFloat cg (fnRetIsFloat cg full))
                            cg
                          }
                        }
                      }
                      ; A bare reference to a defined non-nullary function
                      ; is a function value: an immortal descriptor whose
                      ; payload holds its forwarding thunk's code pointer.
                      ; `emitIndirectCall` passes the record as the
                      ; callee's hidden first argument, so the record
                      ; points at a forwarding thunk rather than at
                      ; the function itself - see the lambda section.
                      ; A parameter of the function being emitted wins
                      ; first, though: a param named `lex` is the
                      ; param, not the lexer entry point it shadows.
                      (if (&& (isDefinedFnCg cg full) (! parameter))
                        {
                          (let ti (thunkIndexFor cg full (fnArityOfCg cg full)))
                          ; Capture-free function values share an immutable
                          ; descriptor with an immortal header, like strings.
                          (cgSetResult cg
                            (concat "ptrtoint (ptr getelementptr ([3 x i64], ptr @.fnval."
                              (concat (fmtInt ti) ", i64 0, i64 2) to i64)")))
                          (cgSetResultFloat cg 0)
                          cg
                        }
                        ; A parameter reference: `%name` was emitted in
                        ; the function header, and the signature says
                        ; whether it is a float.
                        {
                          (let x (concat "%" (llvmSym (strDup name))))
                          {
                            (cgSetResult cg x)
                            (cgSetResultFloat cg (paramFloatByName cg name))
                            cg
                          }
                        }))
                  })
              })))
      })
  })

; Index of `name` in the current function's parameter list, -1 when it
; is no parameter.
(pub :: paramIndexOf (-> CG String Int))
(pub fn (paramIndexOf cg name)
  (if (let (Some params) (cgParams cg))
    (paramIndexIn params name 0)
    (- 0 1)))

(pub :: paramIndexIn (-> Names String Int Int))
(pub fn (paramIndexIn params name i)
  (if (>= i (vecLen params))
    (- 0 1)
    (if (strEq (vecGetStr params i) name)
      i
      (paramIndexIn params name (+ i 1)))))

(pub :: isDefinedFn (-> (Vec ASTNode) String Bool))
(pub fn (isDefinedFn decls name)
  (if (== (as decls Int) 0)
    false
    (isDefinedFnIn decls (declSpellingOf name) 0)))

(pub :: isDefinedFnIn (-> (Vec ASTNode) String Int Bool))
(pub fn (isDefinedFnIn decls name i)
  (if (>= i (vecLen decls))
    false
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN)
            (&& (strEq (nodeAName d) name) (> (vecLen (nodeBNames d)) 0)))
        true
        (isDefinedFnIn decls name (+ i 1)))
    }))

(pub :: lookupSymKind (-> CG String Int))
(pub fn (lookupSymKind cg name)
  (lookupSymFloatIn (cgSymNames cg) (cgSymKinds cg) name (- (vecLen (cgSymNames cg)) 1)))

(pub :: lookupSymFloat (-> CG String Int))
(pub fn (lookupSymFloat cg name)
  (lookupSymFloatIn (cgSymNames cg) (cgSymFloats cg) name (- (vecLen (cgSymNames cg)) 1)))

(pub :: lookupSymFloatIn (-> (Vec a) Ints String Int Int))
(pub fn (lookupSymFloatIn syms flags name i)
  (if (< i 0)
    0
    (if (strEq (vecGetStr syms i) name)
      (if (< i (vecLen flags))
        (vecGet flags i)
        0)
      (lookupSymFloatIn syms flags name (- i 1)))))

; Where `name` is bound in the symbol table, or None when it is not.
(pub :: symIndex (-> CG String (Option Int)))
(pub fn (symIndex cg name)
  {
    (let syms (cgSymNames cg))
    (symIndexIn syms name (- (vecLen syms) 1))
  })

; The register of the binding at `i`, an index `symIndex` answered.
(pub :: symRegAt (-> CG Int String))
(pub fn (symRegAt cg i)
  (vecGet (cgSymRegs cg) i))

(pub :: hasSym (-> CG String Bool))
(pub fn (hasSym cg name)
  (isSome (symIndex cg name)))

; The newest binding of `name` in a symbol vector, searching down from
; `i`, or None when no binding matches.
(pub :: symIndexIn (-> Strings String Int (Option Int)))
(pub fn (symIndexIn syms name i)
  (if (< i 0)
    None
    (if (strEq (vecGet syms i) name)
      (Some i)
      (symIndexIn syms name (- i 1)))))

; ------------------------------------------------------------------
; E_App: flatten chain, dispatch.
; ------------------------------------------------------------------
(pub :: emitApp (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitApp node cg)
  ; Nested calls need fresh accumulators.
  {
    (cgResetAppArgs cg)
    (walkAppChain node cg node)
  })

; `snode` is the OUTERMOST application node of the spine being
; lowered - the source location of the call. It is snapshotted at
; entry and threaded unchanged through the recursion below (which
; walks INWARD to the head) and onward to every call the spine
; emits, where it becomes the line marker. Passed as a parameter
; rather than read from a stash for the reason the stamp comment
; below gives: anything re-entrant clobbers shared state.
(pub :: walkAppChain (-> ASTNode CG ASTNode CG))
;@axiom:effect(io)
(pub fn (walkAppChain node cg snode)
  {
    (let fnNode (nodeAChild node))
    (let argNode (nodeBChild node))
    {
      (vecPush (cgArgVec cg) argNode)
      ; In LOCKSTEP with the line above, and reversed with it: the
      ; class the checker recorded for THIS application step, which is
      ; the only thing that can tell a closure call whether the word it
      ; passes is a reference. 0 for every node the checker did not
      ; stamp, which is every application that is not through a closure
      ; - and 0 is "not a reference", the direction that leaks.
      (vecPush (cgArgEv cg) (nodeTy node))
      (if (== (nodeTag fnNode) TAG_E_VAR)
        ; the stamp is snapshotted HERE, validated against the
        ; declaration being emitted, and threaded as a parameter - a
        ; CG-stash read later would be clobbered by any nested
        ; polymorphic call in an argument (MM-LIFE-2d)
        (dispatchCall (nodeAName fnNode) (evStampOk cg (nodeTyChild fnNode)) cg
          (nodeDefScope fnNode) snode)
        (if (== (nodeTag fnNode) TAG_E_APP)
          (walkAppChain fnNode cg snode)
          ; A head that is neither a name nor another application - a
          ; lambda, an `if`, a `match`, a block. This branch used to
          ; write the constant 0 and return, which does not emit a
          ; wrong call: it DELETES the application, so
          ; `((lambda (x) x) 7)` evaluated to 0
          ; (tests/stdlib/280-function-application.ax). stage0 reached
          ; the same shape once from the other side, lowering a non-name
          ; head to a call to the undefined symbol `@unknown`.
          ;
          ; The rule both compilers settled on is that a non-name head
          ; is EVALUATED AS A VALUE and then applied one argument at a
          ; time, since each application may yield another closure. The
          ; arguments are snapshotted and reversed BEFORE the head is
          ; lowered, because lowering it re-enters `emitApp` and would
          ; otherwise overwrite the accumulator they live in; and the
          ; tail flag is cleared, because a call through a computed head
          ; is never the self tail call the optimiser rewrites.
          ; The evidence classes are snapshotted HERE, beside the
          ; arguments and for the identical reason the comment above
          ; gives for them: lowering the head re-enters `emitApp` and
          ; resets `argEv`. `((lambda (m) ..) x)` is this branch, and
          ; it is the shape `tests/stdlib/460-closure-reclaim.ax`
          ; term 64 is written in - a closure applied where it stands,
          ; with no name in between.
          {
            (let args (reverseVec (cgArgVec cg)))
            (let evs (spineEvs cg))
            {
              (cgSetTailOK cg 0)
              {
                (let cgH (emitExpr fnNode cg))
                (emitApplyChainOwned args cgH (strDup (cgResult cgH)) 0 0 evs snode 1)
              }
            }
          }))
    }
  })

; Dispatch after flattening.
; `defscope` is the head node's word 10: 1 when this reference came
; out of a macro template and therefore resolves where the template
; was written - top level - rather than in the scope the call landed
; in. It has to reach `isLocalValue`, because the head of a call is
; the one reference that never passes through `emitVar`, and the two
; resolvers disagreeing is a checker typing one binding while the
; emitter reads another.
(pub :: dispatchCall (-> String ASTNode CG Int ASTNode CG))
;@axiom:effect(io)
(pub fn (dispatchCall fnName stamp cg defscope snode)
  ; Read and clear in one step: tail position belongs to this
  ; call alone, and the arguments emitted below must not inherit
  ; it - a self call in argument position is an ordinary call.
  ; The macro branch that used to lead here is gone with the rest of
  ; the emit-time expander; see `core/expand.ax`.
  ; cast is a no-op at the i64 level — just evaluate and return the
  ; cast expression's value directly, avoiding an undefined @cast call.
  ; It *does* change float-ness: `(cast Float bits)` is how a bit
  ; pattern held as an Int re-enters float arithmetic, so the flag
  ; follows the named type rather than the operand.
  ;
  ; `cast` takes TWO arguments and any beyond them are applied to its
  ; RESULT, which is the whole point of casting a closure to `Int`:
  ; `((cast Int f) 41)` is one application spine, and `walkAppChain`
  ; flattens a spine into one accumulator before dispatching on its
  ; head, so this branch is handed `[Int, f, 41]` rather than
  ; `[Int, f]`. It used to take the LAST argument, which is the right
  ; answer only when there is no surplus: `((cast Int f) 41)` emitted
  ; `41` and returned it, `check`-clean, at exit 0, for a
  ; one-parameter `f`. Every other head in this dispatch consumes a
  ; fixed count too, and this is the one whose result is routinely a
  ; function value.
  ; SNAPSHOTTED HERE, beside the arguments and for the identical
  ; reason: the two branches below that apply a SURPLUS argument
  ; through a closure need the class the checker recorded for it,
  ; and every `emitExpr` between here and there re-enters `emitApp`,
  ; which resets `argEv`. `emitIndirectCall` takes the same snapshot
  ; at the same point; until 2026-08-31 these two took none and
  ; passed `vecNew`, which reads as 0 - "not a reference" - at every
  ; step. See `emitOverApplied`.
  {
    (let revArgs (cgArgVec cg))
    (let args (reverseVec revArgs))
    (let evs (spineEvs cg))
    (let isTail (cgTailOK cg))
    (let _clr (cgSetTailOK cg 0))
    (if (isCastName fnName)
      {
        (let n (vecLen args))
        {
          (let valIdx
            (if (>= n 2)
              1
              (- n 1)))
          {
            (let cgValue (emitExpr (vecGet args valIdx) cg))
            {
              (let cgc
                (if (> (nodeIntegerConversion snode) 0)
                  (emitIntegerConversion cgValue (nodeIntegerConversion snode))
                  cgValue))
              {
                (cgSetResultFloat cgc
                  (if (>= n 2)
                    {
                      (let tyNode (vecGet args 0))
                      (if (&& (== (nodeTag tyNode) TAG_E_VAR) (strEq (nodeAName tyNode) "Float"))
                        1
                        0)
                    }
                    0))
                (if (> n 2)
                  ; `emitApplyChain` already takes a start index, so
                  ; the surplus applies one argument at a time from
                  ; position 2 - each application may yield another
                  ; closure, which is exactly the curried case.
                  (emitApplyChain args cgc (strDup (cgResult cgc)) 2 evs snode)
                  cgc)
              }
            }
          }
        }
      }
      ; `sizeof`/`alignof` are compile-time constants: every Axiom value
      ; is one machine word, so both are 8 for every type - probed
      ; against stage0, which answers 8 for `Int` and for a three-field
      ; struct alike (the handle is the value).
      (if (strEq fnName "sizeof")
        {
          (cgSetResult cg (constStr 8))
          (cgSetResultFloat cg 0)
          cg
        }
        (if (strEq fnName "alignof")
          {
            (cgSetResult cg (constStr 8))
            (cgSetResultFloat cg 0)
            cg
          }
          ; Primitives have no definition to call: they *are* the instruction.
          ; Emitting `call @__load64` produces a symbol nothing defines, which
          ; fails at link time rather than as a diagnostic.
          (if (isAndOr fnName)
            (zeroFloat (emitAndOr fnName args cg))
            (if (isPrimName fnName)
              (emitPrim fnName args cg stamp)
              ; A head that names a local or a parameter is a function VALUE -
              ; a closure record - so the call goes indirect through its code
              ; pointer. Checked before the constructor table: locals shadow.
              (if (&& (!= defscope 1) (isLocalValue cg fnName))
                (emitIndirectCall fnName args cg snode)
                ; An effect operation is dispatch, not a call: there is no symbol
                ; to reach, only the handler the innermost `handle` installed.
                ; Checked AFTER the local test, because a local shadowing an
                ; operation name binds the local - which is how sema resolves it,
                ; and a generator that disagreed would dispatch a name the checker
                ; had already bound to a lambda.
                (if (let (Some operation) (lookupEffFor cg (cgEffOps cg) fnName))
                  (emitEffectOp operation args cg snode)
                  {
                    (let types (cgTypes cg))
                    (let entryFound (lookupType types fnName))
                    (if (let (Some entry) entryFound)
                      (zeroFloat (emitConstructor args entry stamp cg))
                      ; The self tail call is recognised HERE, not on the way
                      ; in: a macro, a local, a lambda parameter or a match
                      ; binder that shadows the function's name has already
                      ; claimed the call above, and rewriting it as a jump to
                      ; the function would be an infinite loop where the
                      ; correct answer is a value.
                      (if (&& (!= isTail 0)
                            (&& (cgSelfNameIs cg fnName)
                              (== (vecLen args) (vecLen (cgTcoSlots cg)))))
                        (emitTailJump args stamp cg)
                        (emitOverApplied fnName args stamp (armMustTail cg isTail fnName args) evs
                          snode)))
                  })))))))
  })

(pub :: isLocalValue (-> CG String Bool))
(pub fn (isLocalValue cg name)
  (if (hasSym cg name)
    true
    (>= (paramIndexOf cg name) 0)))

; Call through a function value: one argument per call. The head
; evaluates to a closure record; each step loads word 0 of the current
; record as the code pointer and calls it with (record, argument), and
; the result is the record for the next step - a lifted lambda reads
; its captures from the record, a forwarding thunk ignores it. One at
; a time rather than all at once, because every function value that
; can legally exist absorbs exactly one argument - a 1-parameter
; function's thunk record, or one link of a curried lambda chain - so
; a flat spine `(h 3 4)` over a curried `h` means "apply, then apply
; the result"; passing both in one call answered with the inner
; closure's address, the same bug stage0's local-head path had. The
; result's float-ness is unknown (no signature to ask), so it reads
; as integer.
(pub :: emitIndirectCall (-> String Nodes CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitIndirectCall fnName args cg snode)
  ; THE SNAPSHOT IS TAKEN HERE, before the head is lowered and before
  ; any argument is emitted. Both of those re-enter `emitApp`, which
  ; resets `argEv`; a read after them is a read of somebody else's
  ; spine. This is the closure path and the only one that has a class
  ; to pass - a direct call reaches a declaration and does not need
  ; one.
  {
    (let evs (spineEvs cg))
    {
      (let cgH (emitVar (mkEVar fnName) cg))
      (emitApplyChainOwned args cgH (strDup (cgResult cgH)) 0 0 evs snode 1)
    }
  })

; `evs` is `spineEvs`' snapshot for the same spine `args` came from,
; and the start index `i` indexes both - the two vectors are pushed in
; lockstep by `walkAppChain` and reversed together. It was `vecNew`
; here until 2026-08-31, which made every argument this walker applies
; read as class 0 at `evOperandAt`; both callers are surplus
; arguments applied through a closure, which is the one place the
; class is the only thing that can tell the callee whether the word it
; was handed is a reference.
(pub :: emitApplyChain (-> Nodes CG String Int Ints ASTNode CG))
;@axiom:effect(io)
(pub fn (emitApplyChain args cg rec i evs snode)
  ; Surplus arguments only: the cast spine and the over-applied tail
  ; enter here, and neither releases its arguments - unmeasured
  ; rather than known safe, so the flag below stays 0 for both.
  (emitApplyChainOwned args cg rec i 0 evs snode 0))

; The evidence classes for a spine, SNAPSHOTTED before the walk begins
; and for the same reason the stamp is: emitting an argument re-enters
; `emitApp`, which resets `argEv`, so a walker that read the stash per
; step would read the innermost nested application's classes instead of
; its own. Reversed here because `walkAppChain` pushes outermost-first,
; exactly as `dispatchCall` reverses `argVec`.
(pub :: spineEvs (-> CG Ints))
(pub fn (spineEvs cg)
  (reverseVec (cgArgEv cg)))

; The operand for step `i`: the class the checker recorded, as an LLVM
; literal. Anything the checker did not classify is 0 - "not a
; reference" - which under-retains and therefore leaks.
(pub :: evOperandAt (-> Ints Int String))
(pub fn (evOperandAt evs i)
  (if (>= i (vecLen evs))
    (constStr 0)
    {
      (let c (as (vecGet evs i) Int))
      (if (== c 1)
        (constStr 1)
        (constStr 0))
    }))

; `emitApplyRegsOwned`'s rule, for the walker that evaluates each
; argument just before applying it. Same `recOwned` convention, and
; the two call sites that start this walk at an index other than 0
; (`emitApp`'s two-argument operator path, and the partial-application
; path that drops the arity prefix) still hand in a record they did
; not make, so they start at 0 like everyone else.
;
; `arel` is whether this walk may release a last-step argument: 1
; for a closure applied where it stands (a computed head, an
; indirect call), 0 through the `emitApplyChain` wrapper below,
; whose only callers are surplus arguments (the cast spine, the
; over-applied tail) - unmeasured rather than known safe, so they
; keep their releases. The flag threads through the recursion
; unchanged.
(pub :: emitApplyChainOwned (-> Nodes CG String Int Int Ints ASTNode Int CG))
;@axiom:effect(io)
(pub fn (emitApplyChainOwned args cg rec i recOwned evs snode arel)
  (if (>= i (vecLen args))
    {
      (cgSetResult cg rec)
      (cgSetResultFloat cg 0)
      cg
    }
    ; The argument half of the closure reclaim: an application
    ; through a closure never released its owned argument at
    ; all, where a direct call has since MM-LIFE-2g
    ; (`releaseOwnedArgs`). The release fires only where all
    ; four hold:
    ;
    ;   * this is the LAST step - an intermediate answer is a
    ;     closure record by construction (the next step loads
    ;     its word 0 as a code pointer), so it may alias the
    ;     argument and keeps it;
    ;   * the stamped answer is a word (`nodeResWord`) - a word
    ;     cannot alias the argument, while a reference answer
    ;     may BE it (identity), which would double-free. The
    ;     zero default keeps: unstamped spines (cast) never
    ;     fire;
    ;   * the argument is owned, neither static nor nullary -
    ;     the same three answers `argOwnedRelease` gives, for
    ;     the same reasons (a static release is a no-op, a
    ;     nullary one loads from an immediate);
    ;   * `arel` allows it - surplus arguments keep theirs.
    ;
    ; No `a == rec` guard: registers are unique per function
    ; (the counter resets only on function entry), and neither
    ; constants nor immediates reach this release, so the two
    ; strings cannot name one value.
    {
      (let ev (evOperandAt evs i))
      {
        (let cgA (emitExpr (vecGet args i) cg))
        {
          (let a (strDup (cgResult cgA)))
          {
            (let cgR
              (applyOneArg cgA rec a ev snode
                (if (>= (+ i 1) (vecLen args))
                  1
                  0)))
            {
              (let cgD
                (if (== recOwned 1)
                  (emitReleaseOf cgR rec)
                  cgR))
              {
                (let cgE
                  (if (&& (== arel 1)
                        (&& (>= (+ i 1) (vecLen args))
                          (&& (== (valueOwnedRef cgD (vecGet args i)) 1)
                            (&& (== (isStaticSentinelNode cgD (vecGet args i)) 0)
                              (&& (== (isNullaryConNode cgD (vecGet args i)) 0)
                                (== (nodeResWord snode) 1))))))
                    (emitReleaseOf cgD a)
                    cgD))
                (emitApplyChainOwned args cgE (strDup (cgResult cgE)) (+ i 1) 1 evs snode arel)
              }
            }
          }
        }
      }
    }))

; One step of an application through a closure record: load word 0 as
; the code pointer and call it with (record, argument). The result is
; the record for the next step, and lands in field 2.
;
; Shared by the two chain walkers, which differ only in WHEN the
; argument is evaluated - `emitApplyChain` evaluates each one just
; before applying it, `emitApplyRegs` takes registers already
; evaluated, which is what an effect operation needs so that an
; argument's side effects happen before a missing handler traps.
(pub :: applyOneArg (-> CG String String String ASTNode Int CG))
(pub fn (applyOneArg cg rec a ev snode final)
  {
    (let cgE (emitClosureResultWord cg snode final))
    {
      (let rw (strDup (cgResult cgE)))
      (let evn (allocReg cgE))
      {
        (let fullEv (regStr evn))
        {
          (emitLine cgE
            (concat (concat "  " fullEv) (concat " = or i64 " (concat ev (concat ", " rw)))))
          {
            (let cgL (loadWordAt cgE rec 0))
            {
              (let cp (strDup (cgResult cgL)))
              (let fpn (allocReg cgL))
              (let rn (allocReg cgL))
              {
                (let fp (tmpStr "f" fpn))
                (let r (regStr rn))
                {
                  (emitLine cgL
                    (concat (concat "  " fp) (concat " = inttoptr i64 " (concat cp " to ptr"))))
                  (emitCallMark snode cgL rn)
                  (emitLine cgL
                    (concat
                      (concat (concat (concat "  " r) (concat " = call i64 " fp))
                        (concat "(i64 " (concat (strDup rec) (concat ", i64 " a))))
                      (concat (concat ", i64 " fullEv) (concat ")" ""))))
                  (cgSetResult cgL r)
                  cgL
                }
              }
            }
          }
        }
      }
    }
  })

; ------------------------------------------------------------------
; Freestanding primitives.
; ------------------------------------------------------------------
(pub :: isPrimName (-> String Bool))
(pub fn (isPrimName nm)
  (if (isIntegerWordName nm)
    true
    (if (|| (strEq nm "__indexTrap")
          (|| (strEq nm "__resource_new")
            (|| (strEq nm "__resource_get")
              (|| (strEq nm "__resource_close")
                (|| (strEq nm "__resource_disarm") (strEq nm "__resource_unwinding"))))))
      true
      (if (strEq nm "__alloc")
        true
        (if (strEq nm "__retain")
          true
          (if (strEq nm "__retainref")
            true
            (if (strEq nm "__release")
              true
              (if (strEq nm "__load64")
                true
                (if (strEq nm "__store64")
                  true
                  (if (strEq nm "__load8")
                    true
                    (if (strEq nm "__store8")
                      true
                      (if (strEq nm "__store8v")
                        true
                        (if (strEq nm "__addr")
                          true
                          (if (|| (strEq nm "__floatToBits")
                                (|| (strEq nm "__floatFromBits") (strEq nm "__intToFloat")))
                            true
                            (if (strEq nm "__floatToInt")
                              true
                              (if (strEq nm "__argc")
                                true
                                (if (strEq nm "__argv")
                                  true
                                  ; The arena watermark pair. Their absence here was not a missing
                                  ; feature but a miscompile: `(__axiom_arena_mark)` is a bare
                                  ; reference, so it fell through to the ordinary variable path and
                                  ; emitted `%__axiom_arena_mark`, a value nothing defines, which llc
                                  ; rejects. stage0 carries a comment about hitting the identical bug.
                                  (if (strEq nm "__axiom_recover")
                                    true
                                    (if (strEq nm "__axiom_arena_mark")
                                      true
                                      (if (|| (strEq nm "__axiom_arena_reset")
                                            (strEq nm "__axiom_arena_mark_into"))
                                        true
                                        (if (strEq nm "__axiom_arena_reset_keeping")
                                          true
                                          (if (|| (strEq nm "__axiom_mem_stat")
                                                (|| (strEq nm "__axiom_arena_cap")
                                                  (strEq nm "__axiom_stack_run")))
                                            true
                                            ; Not spellable in source: `checkNumeric` rewrites `==`/`!=` into
                                            ; these when it can see that BOTH operands are `String`. They are
                                            ; primitives rather than a `Str` call because the rewrite must work
                                            ; in a program that never imported `Str`.
                                            (if (strEq nm "__streq")
                                              true
                                              (if (strEq nm "__strne")
                                                true
                                                (if (strEq nm "__call_word")
                                                  true
                                                  ; `(__contract cond "message")` - the run-time
                                                  ; half of a `;@axiom:pre(...)` / `post(...)`,
                                                  ; written by `expLowerContracts` and by nothing
                                                  ; else. A primitive rather than a call because
                                                  ; there is no function to reach: it is a compare,
                                                  ; a branch and a trap. A name this misses is an
                                                  ; `@__contract` nothing defines - measured, and
                                                  ; exactly what the arena pair's note above
                                                  ; records for its own omission.
                                                  (if (strEq nm "__contract")
                                                    true
                                                    (if (|| (isParPrimName nm)
                                                          (isHandlePrimName nm))
                                                      true
                                                      (if (isAtomicPrimName nm)
                                                        true
                                                        (if (isDevicePrimName nm)
                                                          true
                                                          (|| (isAsmPrimName nm)
                                                            (isSyscallName
                                                              nm)))))))))))))))))))))))))))))))

; `__syscall0` through `__syscall6`, distinguished only by how many
; arguments follow the syscall number.
(pub :: isSyscallName (-> String Bool))
(pub fn (isSyscallName nm)
  (&& (== (strLen nm) 10) (strStartsWith nm "__syscall")))

; The primitives invoked by WRITING THE NAME - registered
; `(mkIntArrow 0)` in typecheck.ax - which reach the emitter as a bare
; variable reference whether spelled `__argc` or `(__argc)`, so
; `emitVar` asks this before it asks the symbol table. Until
; 2026-08-29 the set was two spellings inside `emitVar`, and that is
; how `__axiom_arena_mark` came to be named in the comment there and
; missed by the code, and how `__fence` emitted `%__fence` on its
; first day: a rule whose members are listed at the point of use is a
; rule the next member does not know about. `tests/selfhost/131-
; atomic-prim.ax` USES the fence's value, so a member this misses is
; an llc error rather than a silent no-op in statement position.
(pub :: isNullaryPrimName (-> String Bool))
(pub fn (isNullaryPrimName nm)
  (if (|| (strEq nm "__indexTrap") (strEq nm "__resource_unwinding"))
    true
    (if (strEq nm "__argc")
      true
      (if (strEq nm "__axiom_arena_mark")
        true
        (if (strEq nm "__fence")
          true
          (isNullaryDevicePrimName nm))))))

; The five atomic primitives, and the gate into `emitPrimAtomic`. The
; two must agree: a name here that the dispatch does not know falls
; through to the syscall template, which is `isPrimName`'s own shape
; for everything it does not recognise, and a name the dispatch knows
; that is not here is a bare variable reference - the miscompile the
; arena pair's comment above records.
(pub :: isAtomicPrimName (-> String Bool))
(pub fn (isAtomicPrimName nm)
  (if (strEq nm "__atomic_load")
    true
    (if (strEq nm "__atomic_store")
      true
      (if (strEq nm "__atomic_add")
        true
        (if (strEq nm "__atomic_cas")
          true
          (strEq nm "__fence"))))))

(pub :: emitPrim (-> String Nodes CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitPrim fnName args cg stamp)
  (if (isIntegerWordName fnName)
    (emitPrimFloatBits args cg 0)
    (if (strEq fnName "__floatToBits")
      (emitPrimFloatBits args cg 0)
      (if (strEq fnName "__floatFromBits")
        (emitPrimFloatBits args cg 1)
        (if (strEq fnName "__intToFloat")
          (emitPrimIntToFloat args cg)
          (if (strEq fnName "__floatToInt")
            (emitPrimFloatToInt args cg)
            (zeroFloat
              (if (strEq fnName "__alloc")
                (emitPrimAlloc args cg)
                (if (strEq fnName "__retain")
                  (emitPrimRetRel args cg "@axiom_retain")
                  (if (strEq fnName "__retainref")
                    (emitPrimRetainRef args cg stamp)
                    (if (strEq fnName "__release")
                      (emitPrimRetRel args cg "@axiom_release")
                      (if (strEq fnName "__load64")
                        (emitPrimLoad args cg 8)
                        (if (strEq fnName "__store64")
                          (emitPrimStore args cg 8 0)
                          (if (strEq fnName "__load8")
                            (emitPrimLoad args cg 1)
                            (if (strEq fnName "__store8")
                              (emitPrimStore args cg 1 0)
                              (if (strEq fnName "__store8v")
                                (emitPrimStore args cg 1 1)
                                (if (strEq fnName "__addr")
                                  (emitPrimAddr args cg)
                                  (if (|| (strEq fnName "__indexTrap")
                                        (|| (strEq fnName "__resource_new")
                                          (|| (strEq fnName "__resource_get")
                                            (|| (strEq fnName "__resource_close")
                                              (|| (strEq fnName "__resource_disarm")
                                                (strEq fnName "__resource_unwinding"))))))
                                    (if (strEq fnName "__indexTrap")
                                      (emitPrimIndexTrap cg)
                                      (if (strEq fnName "__resource_unwinding")
                                        (emitPrimResUnwinding cg)
                                        (emitPrimResource fnName args cg)))
                                    (if (strEq fnName "__argc")
                                      (emitPrimArgc cg)
                                      (if (strEq fnName "__argv")
                                        (emitPrimArgv args cg)
                                        (if (strEq fnName "__axiom_recover")
                                          (emitPrimRecover args cg)
                                          (if (strEq fnName "__axiom_arena_mark")
                                            (emitPrimArenaMark cg)
                                            (if (|| (strEq fnName "__axiom_arena_reset")
                                                  (strEq fnName "__axiom_arena_mark_into"))
                                              (if (strEq fnName "__axiom_arena_mark_into")
                                                (emitPrimArenaMarkInto args cg)
                                                (emitPrimArenaReset args cg))
                                              (if (strEq fnName "__axiom_arena_reset_keeping")
                                                (emitPrimArenaResetKeeping args cg)
                                                (if (|| (strEq fnName "__axiom_mem_stat")
                                                      (|| (strEq fnName "__axiom_arena_cap")
                                                        (strEq fnName "__axiom_stack_run")))
                                                  (if (strEq fnName "__axiom_mem_stat")
                                                    (emitPrimMemStat args cg)
                                                    (if (strEq fnName "__axiom_arena_cap")
                                                      (emitPrimArenaCap args cg)
                                                      (emitPrimStackRun args cg)))
                                                  (if (strEq fnName "__streq")
                                                    (emitPrimStrEq args cg 1)
                                                    (if (strEq fnName "__strne")
                                                      (emitPrimStrEq args cg 0)
                                                      (if (strEq fnName "__call_word")
                                                        (emitPrimCallWord args cg)
                                                        (if (strEq fnName "__contract")
                                                          (emitPrimContract args cg)
                                                          (if (isParPrimName fnName)
                                                            (emitPrimPar fnName args cg)
                                                            (if (isHandlePrimName fnName)
                                                              (emitPrimHandle fnName args cg)
                                                              (if (isAtomicPrimName fnName)
                                                                (emitPrimAtomic fnName args cg)
                                                                (if (isDevicePrimName fnName)
                                                                  (emitPrimDevice fnName args cg)
                                                                  (if (isAsmPrimName fnName)
                                                                    (emitPrimAsm args cg)
                                                                    (emitPrimSyscall args
                                                                      cg)))))))))))))))))))))))))))))))))))

; `(__contract cond "message")` - the run-time half of a
; `;@axiom:pre(...)` / `;@axiom:post(...)`, and the only thing that
; makes a contract more than a comment: this compiler has no value
; analysis (measured: `grep -v '^ *;' FILE | grep -c
; 'constFold\|interval\|rangeOf'` over `typecheck.ax` and this file
; answers 0 and 0 - the comment lines are excluded because this
; sentence matches the pattern it quotes), so `(> n 0)` about an
; unseen caller is not a question it can decide statically.
;
; A branch and a trap, in the shape `emitAndOr` uses for its own two
; blocks. The MESSAGE IS EMITTED IN THE FAILING BLOCK, not before the
; branch: a passing contract - which is every contract in a working
; program, on every call - executes the compare, the branch, and
; nothing else.
(pub :: emitPrimContract (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimContract args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let c (strDup (cgResult cg1)))
    (let cn (allocReg cg1))
    (let okL (allocReg cg1))
    (let badL (allocReg cg1))
    (let cr (regStr cn))
    (let okB (labelStr okL))
    (let badB (labelStr badL))
    (let _1 (emitLine cg1 (concat (concat "  " cr) (concat " = icmp ne i64 " (concat c ", 0")))))
    (let _2
      (emitLine cg1
        (concat (concat "  br i1 " (concat cr ", label %"))
          (concat okB (concat (concat ", label %" badB) "")))))
    (let _3 (emitLabel cg1 badB))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let m (strDup (cgResult cg2)))
    (let _4 (emitLine cg2 (concat "  call i64 @__axiom_contract_fail(i64 " (concat m ")"))))
    (let _5 (emitLine cg2 "  unreachable"))
    (let _6 (emitLabel cg2 okB))
    (let _7 (cgSetResult cg2 (constStr 0)))
    cg2
  })

; `TAG_E_SUBCHECK` — the run-time half of a range-constrained subtype
; conversion. a = value expr, b = bounds Vec (1-2 EXPR nodes: lower,
; upper), c = message string. Emits the value ONCE into `v`, the bounds
; once each, compares against `v` (single evaluation, so a
; side-effecting value is never run twice), and returns `v` on success.
; On failure calls `@__axiom_contract_fail` and marks unreachable —
; the same trap contracts use (status 80), so no new runtime is added.
; Lower-only means `>= lo`; two bounds mean `>= lo` and `< hi`.
(pub :: emitPrimSubtypeCheck (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitPrimSubtypeCheck node cg)
  {
    (let bounds (nodeBChildren node))
    (if (== (vecLen bounds) 0)
      (emitExpr (nodeAChild node) cg)
      {
        (let cg0 (emitExpr (nodeAChild node) cg))
        (let v (strDup (cgResult cg0)))
        (let cg1 (emitExpr (vecGet bounds 0) cg0))
        (let lo (strDup (cgResult cg1)))
        (let c1 (allocReg cg1))
        (let okL (allocReg cg1))
        (let badL (allocReg cg1))
        (let c1r (regStr c1))
        (let okB (labelStr okL))
        (let badB (labelStr badL))
        (let _1
          (emitLine cg1
            (concat (concat (concat "  " c1r) (concat " = icmp sge i64 " (concat v ", ")))
              (concat lo ""))))
        (let _2
          (emitLine cg1
            (concat (concat "  br i1 " (concat c1r ", label %"))
              (concat okB (concat (concat ", label %" badB) "")))))
        (if (== (vecLen bounds) 1)
          {
            (emitLabel cg1 badB)
            (emitSubtypeFail node cg1 v okB badB)
          }
          {
            (emitLabel cg1 okB)
            {
              (let cg2 (emitExpr (vecGet bounds 1) cg1))
              (let hi (strDup (cgResult cg2)))
              (let c2 (allocReg cg2))
              (let ok2L (allocReg cg2))
              (let c2r (regStr c2))
              (let ok2B (labelStr ok2L))
              (let _3
                (emitLine cg2
                  (concat (concat (concat "  " c2r) (concat " = icmp slt i64 " (concat v ", ")))
                    (concat hi ""))))
              (let _4
                (emitLine cg2
                  (concat (concat "  br i1 " (concat c2r ", label %"))
                    (concat ok2B (concat (concat ", label %" badB) "")))))
              {
                (emitLabel cg2 badB)
                (emitSubtypeFail node cg2 v ok2B badB)
              }
            }
          })
      })
  })

; The failing block shared by both bound checks: emit the message,
; trap, mark unreachable, then the success label with the saved value.
(pub :: emitSubtypeFail (-> ASTNode CG String String String CG))
;@axiom:effect(io)
(pub fn (emitSubtypeFail node cg v okB badB)
  {
    (let cg2 (emitExpr (nodeCChild node) cg))
    (let m (strDup (cgResult cg2)))
    (let _4 (emitLine cg2 (concat "  call i64 @__axiom_contract_fail(i64 " (concat m ")"))))
    (let _5 (emitLine cg2 "  unreachable"))
    (let _6 (emitLabel cg2 okB))
    (let _7 (cgSetResult cg2 v))
    cg2
  })

; The contract trap, emitted UNCONDITIONALLY beside the division trap
; and the string-equality helper, and for the reason written above
; both of them: a helper emitted only when the program looks like it
; needs one is a call to a symbol nothing defines the first time the
; predicate and the generator disagree. `emitDivTrap`'s own note
; records that exact failure ("every program that divided and had no
; effects reached `opt` with a call to a symbol nothing defined"), and
; a contract's predicate would have to be evaluated in TWO passes -
; `expLowerContracts` writes the call, this module decides whether the
; callee exists - which is one more place for them to disagree than
; the division trap ever had.
;
; AND IT COSTS A PROGRAM THAT STATES NO CONTRACT NOTHING, which is not
; a claim about `opt`. `pruneDeadDefs` walks the rendered line buffer
; and drops every `define` no root reaches, so this helper survives
; exactly where something calls it: measured on `(fn (main) 7)`, the
; emitted module carries zero `@__axiom_contract_fail`, zero
; `@__axiom_div_by_zero` and zero `@__axiom_str_eq` - twelve defines in
; all. Unconditional at the emitter so the two passes cannot disagree,
; absent from the module when nothing calls it. Both halves are section
; 3 of `scripts/check-contracts.sh`, and the second is asserted against
; the other two unconditional helpers so that a 0 there is the pruner
; rather than this function having quietly become conditional.
;
; STATUS 80, DECIDED 2026-09-08 (roadmap item 11, D3). `MM-EXEC-16`
; reserves 70 (out of memory), 71 (unhandled effect) and 72 (division
; by zero); 73 is the FFI boundary's (`docs/ffi.md` 5.1), 74 is a
; `__syscallN` on a target with no syscall ABI (`emitWinRuntime`), 75
; is an arena reset handed an invalid mark (`emitBadMarkTrap`,
; MM-ALLOC-16a), 76 is a reset past a live handle (MM-ALLOC-16b), 77 is
; the out-of-range index (`emitIndexTrap`), 78 a refused `parallel`
; spawn and 79 a `parallel` with no lowering.
;
; This trap was designed as 75, moved to 76 in `4bcd7eb` when a merge
; found MM-ALLOC-16a already spending 75, and moved again to 77 in the
; merge `3f2f39a` - as a CONFLICT RESOLUTION, onto the number `91f33f7`
; had given `emitIndexTrap` on trunk in the meantime. The comment that
; stood here said `STATUS 76` and was two moves out of date, and the
; paragraph under it argued that "two broken invariants sharing one
; status would be that defect again" - which is what 77-shared was.
;
; 80 is the first free number, and the move follows `docs/ffi.md` 5.1's
; own precedent: 73 was taken precisely because a Rust panic and an
; Axiom division were indistinguishable to a supervisor at 72, and a
; violated contract and an out-of-range index differ the same way - the
; sentence on fd 2 told them apart, the status did not. `__indexTrap`
; held 77 on trunk first, so the contract trap is the one that moves.
; The distinct statuses are in `docs/memory-model.md`; what
; was fixed with the move is every party that said 77 about a
; contract: this comment, `explain.ax`'s AX3050 page, the AX3050 help
; text, `MM-EXEC-16`'s table (which gains the 80 row the contract trap
; never had), `docs/error-model.md`, `docs/reference.md`,
; `docs/reference.md` and `CONTRIBUTING.md`.
;
; The message arrives as a `Str` HANDLE, whose word 0 is the length and
; whose word 1 is the byte pointer (`emitStrEqHelper` reads the same
; two words, and `emitStringGlobals` writes them).
(pub :: emitContractTrap (-> CG CG))
(pub fn (emitContractTrap cg)
  {
    (emitLine cg "define internal i64 @__axiom_contract_fail(i64 %s) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 80)")
    (emitLine cg "  %csp = inttoptr i64 %s to ptr")
    (emitLine cg "  %cn = load i64, ptr %csp")
    (emitLine cg "  %cda = add i64 %s, 8")
    (emitLine cg "  %cdap = inttoptr i64 %cda to ptr")
    (emitLine cg "  %cd = load i64, ptr %cdap")
    (emitRuntimeWrite cg "%cd" "%cn")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "80")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; `(__call_word fn arg)`: `fn` is the ADDRESS of a C function
; `i64 (i64)` - a Rust destructor shim `axffi_<type>_drop` - and the
; call is an indirect `call i64 %fp(i64 %arg)`. Axiom has no other
; way to reach a function it holds only as a word, and the foreign
; form's own release path (`@axiom_release`) makes exactly this call.
(pub :: emitPrimCallWord (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimCallWord args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let fnv (strDup (cgResult cg1)))
      {
        (let cg2 (emitExpr (vecGet args 1) cg1))
        {
          (let av (strDup (cgResult cg2)))
          (let pn (allocReg cg2))
          (let rn (allocReg cg2))
          {
            (let pr (regStr pn))
            (let rr (regStr rn))
            {
              (emitLine cg2
                (concat (concat "  " pr) (concat " = inttoptr i64 " (concat fnv " to ptr"))))
              (emitLine cg2
                (concat (concat (concat "  " rr) (concat " = call i64 " pr))
                  (concat "(i64 " (concat av ")"))))
              (cgSetResult cg2 rr)
              (cgSetResultFloat cg2 0)
              cg2
            }
          }
        }
      }
    }
  })

; `(__retain h)` / `(__release h)`: one call into the emitted
; ownership primitive of MM-LIFE-2b. The result is 0 - retain and
; release are effects on the header, not values - and in this slice
; the ONLY callers are fixtures: the compiler does not insert
; ownership events until MM-LIFE-2c.
(pub :: emitPrimRetRel (-> Nodes CG String CG))
;@axiom:effect(io)
(pub fn (emitPrimRetRel args cg sym)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let h (strDup (cgResult cg1)))
      {
        (emitLine cg1 (concat "  call void " (concat sym (concat "(i64 " (concat h ")")))))
        (cgSetResult cg1 "0")
        (cgSetResultFloat cg1 0)
        cg1
      }
    }
  })

; `(__retainref v)`: a share of `v`, taken exactly when `v` is a
; reference. The answer comes from the CALL's evidence stamp, whose
; single witness covers `__retainref`'s single type variable:
;
;   0     `v` is not a reference here - NOTHING is emitted, which is
;         why this is affordable on `memSetWord`, whose arguments are
;         overwhelmingly integers
;   1     `v` is a reference at this call site - an unconditional
;         retain
;   2+k   `v` is the caller's own type variable k - the retain runs
;         under bit k of the caller's evidence word, at run time
;
; A missing or foreign stamp answers 0, which under-retains: the same
; conservative direction `evStampOk` takes everywhere else, and the
; one that leaks rather than frees early.
;
; The result is the class the retain ran under: 1 when the share was
; taken because the argument's type is counted, 0 when it was not.
; It is a fact about the TYPE at this call, so an immediate or a
; static of a counted type still answers 1. A container reads it to
; learn what its elements are (`Vec.vecPush`, `Map.mapInsert`): a
; vector that owns its elements must have taken a share of every one,
; and this is the one place that knows whether it did.
(pub :: emitPrimRetainRef (-> Nodes CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitPrimRetainRef args cg stamp)
  ; -2 is `EV_LAMARG`: the value is this lifted lambda's own
  ; argument, whose class only the APPLICATION knows. The
  ; retain runs under bit 0 of the word the application
  ; passed. A lambda that has no such word - one reached
  ; some way that predates this, or a `-1` "says nothing" -
  ; falls through to `cg1` and emits nothing, which leaks.
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let v (strDup (cgResult cg1)))
      (let wv
        (if (nodeSame stamp nilNode)
          0
          (if (== (vecLen (nodeBWords stamp)) 0)
            0
            (as (vecGet (nodeBWords stamp) 0) Int))))
      (if (== wv 1)
        (retainRefAnswer (emitRetainOf cg1 v) "1")
        (if (>= wv 2)
          {
            (let cgW (emitEvwRead cg1))
            {
              (let src (strDup (cgResult cgW)))
              {
                (let bit (emitEvBitOf cgW src (- wv 2)))
                (retainRefAnswer (emitRcIfBitOf cgW v (- wv 2) src 1) bit)
              }
            }
          }
          (if (<= wv (- 0 2))
            ; `emitEvwaRead` answers the constant 0 for a body with no
            ; such word, which takes no share and answers 0.
            {
              (let cgW (emitEvwaRead cg1 (- (- 0 2) wv)))
              {
                (let src (strDup (cgResult cgW)))
                (if (strEq src "0")
                  (retainRefAnswer cgW "0")
                  {
                    (let bit (emitEvBitOf cgW src 0))
                    (retainRefAnswer (emitRcIfBitOf cgW v 0 src 1) bit)
                  })
              }
            }
            (retainRefAnswer cg1 "0"))))
    }
  })

; The answer `__retainref` leaves in field 2: a constant or the
; register holding the evidence bit, never a float.
(pub :: retainRefAnswer (-> CG String CG))
(pub fn (retainRefAnswer cg r)
  {
    (cgSetResult cg r)
    (cgSetResultFloat cg 0)
    cg
  })

; Bit k of the evidence word `src`, as a 0 or 1 in a fresh register.
(pub :: emitEvBitOf (-> CG String Int String))
(pub fn (emitEvBitOf cg src k)
  {
    (let ar (regStr (allocReg cg)))
    {
      (emitLine cg
        (concat (concat (concat "  " ar) (concat " = lshr i64 " src)) (concat ", " (constStr k))))
      {
        (let br (regStr (allocReg cg)))
        {
          (emitLine cg (concat (concat "  " br) (concat " = and i64 " (concat ar ", 1"))))
          br
        }
      }
    }
  })

; `(__streq a b)` / `(__strne a b)`: one call into `@__axiom_str_eq`,
; with `__strne` inverting the answer. `want` is 1 for equality and 0
; for inequality, and the inversion is `xor 1` rather than a compare
; because the helper answers exactly 0 or 1.
;
; Both operands are emitted before the call, left then right, which is
; the evaluation order every other two-operand form here uses.
(pub :: emitPrimStrEq (-> Nodes CG Int CG))
;@axiom:effect(io)
(pub fn (emitPrimStrEq args cg want)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let a (strDup (cgResult cg1)))
      {
        (let cg2 (emitExpr (vecGet args 1) cg1))
        {
          (let b (strDup (cgResult cg2)))
          (let r (regStr (allocReg cg2)))
          {
            (let cg3
              (emitLine cg2
                (concat (concat "  " r)
                  (concat " = call i64 @__axiom_str_eq(i64 "
                    (concat a (concat ", i64 " (concat b ")")))))))
            (if (== want 1)
              {
                (cgSetResult cg3 r)
                cg3
              }
              {
                (let n (regStr (allocReg cg3)))
                {
                  (let cg4
                    (emitLine cg3 (concat (concat "  " n) (concat " = xor i64 " (concat r ", 1")))))
                  {
                    (cgSetResult cg4 n)
                    cg4
                  }
                }
              })
          }
        }
      }
    }
  })

; Both primitives are ONE CALL into the helpers `emitArenaHelpers`
; emitted beside the allocator - see there for what a mark saves and
; why a reset writes no byte of what it reclaims. They were inline
; once, and stopped fitting: a reset now walks the chunk list, which
; needs loops, which need blocks of their own.
; `(__axiom_recover mark thunk)` - arm a recovery point at `mark`, run
; `thunk`, and answer either what the thunk answered or the status of
; the trap that aborted to here (70 out of memory, 71 unhandled effect,
; 72 division by zero). `emitRecoverRuntime` beside the allocator holds
; the record's layout and the argument for why the jump is sound; this
; is the arm.
;
; The shape is a `setjmp`, and the two things that make it one are the
; asm block (see `targetRecoverArmAsm`) and the fact that EVERY line
; after it runs twice - once going in, once coming back. So the status
; is read from the record rather than from an output register, and
; `@__axiom_recover_top` is restored HERE, after the block, on both
; paths: that leaves the global with no store anywhere in a program
; that never arms one, which is what lets `opt` delete the whole
; mechanism.
;
; The thunk is evaluated INSIDE the run arm. Evaluating it before the
; arm would build a closure the abort path never uses and would put one
; more value across the block for nothing.
(pub :: emitPrimRecover (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimRecover args cg)
  ; The arm opens a block of its own so the phi below has a NAME to
  ; write for its first edge. A function's entry block carries no
  ; label line - it is `%0` to LLVM and nothing here knows that
  ; number - and field 11 answers whatever the last `emitLabel`
  ; left, which for an arm in entry position is a label from the
  ; PREVIOUS function: `use of undefined value '%label_9'`, from
  ; `opt`, measured. `emitIfTail` never meets this because both of
  ; its phi edges come from blocks it labelled itself.
  ; MM-LIFE-2c's rule for a value that arrives and leaves: a
  ; lambda built AT the call moves - its birth count is the
  ; share this release spends - and anything else is retained
  ; so the release below has one of its own to hand back.
  ; `emitHandleDyn` balances its handler the same way.
  ; The pop, in the merge. Putting it straight after the
  ; arm block - where it reads naturally, and where it
  ; was - disarms the point BEFORE the thunk runs, so
  ; every trap inside the extent found nothing armed and
  ; exited: all three fixtures printed their sentence
  ; instead of their first line. Both paths reach here,
  ; and neither reaches it while the point is still
  ; wanted.
  ; After the phi, not before it: a phi must be the first
  ; instruction in its block, and `opt` says so - "PHI
  ; nodes not grouped at top of basic block".
  ; THE RECORD IS A STACK CELL of the arming function, hoisted to
  ; its entry block like a region's cell (`emitRegionCell`), not an
  ; arena block. Its lifetime is exactly the arming call's: the
  ; abort jumps back INTO this frame, so the cell is intact when the
  ; jump lands, and nothing reads it once the merge below has
  ; restored the displaced point. Until 2026-09-28 it was
  ; `axiom_alloc`ed, and a thunk that answered left its record in
  ; the arena - 144 bytes an arm, measured over 10,000 arms of a
  ; reset-free loop, gone only at the next outer reset (MM-ALLOC-23,
  ; `tests/stdlib/560-recover-record.ax`). On the stack it costs no
  ; allocation at all, and no reset - the abort's own, or a raw one
  ; inside the extent - can reclaim it while it is armed.
  {
    (let cg0 (emitExpr (vecGet args 0) cg))
    {
      (let mark (strDup (cgResult cg0)))
      ; windows-x86_64 keeps xmm6-xmm15 past the spawn sequence: twenty
      ; words more, at byte `(* 8 words)` (`targetRecoverArmAsm`).
      (let words (+ (+ 16 (parRegistryOn cg0)) (distinctSlotCount (cgEffDecls cg0) 0 0)))
      (let size
        (fmtInt
          (if (== (cgTarget cg0) 6)
            (+ words 20)
            words)))
      (let cell (regStr (allocReg cg0)))
      (let rec (regStr (allocReg cg0)))
      (let pv (regStr (allocReg cg0)))
      (let a3 (regStr (allocReg cg0)))
      (let p3 (regStr (allocReg cg0)))
      (let a4 (regStr (allocReg cg0)))
      (let p4 (regStr (allocReg cg0)))
      (let a5 (regStr (allocReg cg0)))
      (let p5 (regStr (allocReg cg0)))
      (let st (regStr (allocReg cg0)))
      (let ok (regStr (allocReg cg0)))
      (let res (regStr (allocReg cg0)))
      (let armB (labelStr (allocReg cg0)))
      (let runB (labelStr (allocReg cg0)))
      (let doneB (labelStr (allocReg cg0)))
      (let _0 (emitLine cg0 (concat "  br label %" armB)))
      (let _0b (emitLabel cg0 armB))
      (let _1c (emitRecoverCell cg0 cell size))
      (let _1
        (emitLine cg0
          (concat (concat "  " rec) (concat " = ptrtoint ptr " (concat cell " to i64")))))
      (let _2 (emitLine cg0 (concat (concat "  " pv) " = load i64, ptr @__axiom_recover_top")))
      (let _3 (emitLine cg0 (concat (concat "  " a3) (concat " = add i64 " (concat rec ", 24")))))
      (let _4
        (emitLine cg0 (concat (concat "  " p3) (concat " = inttoptr i64 " (concat a3 " to ptr")))))
      (let _5 (emitLine cg0 (concat "  store i64 " (concat mark (concat ", ptr " p3)))))
      (let _6 (emitLine cg0 (concat (concat "  " a4) (concat " = add i64 " (concat rec ", 32")))))
      (let _7
        (emitLine cg0 (concat (concat "  " p4) (concat " = inttoptr i64 " (concat a4 " to ptr")))))
      (let _8 (emitLine cg0 (concat "  store i64 " (concat pv (concat ", ptr " p4)))))
      (let _9 (emitLine cg0 (concat (concat "  " a5) (concat " = add i64 " (concat rec ", 40")))))
      (let _10
        (emitLine cg0 (concat (concat "  " p5) (concat " = inttoptr i64 " (concat a5 " to ptr")))))
      (let _11 (emitLine cg0 (concat "  store i64 0, ptr " p5)))
      (let _12 (emitLine cg0 (concat "  call i64 @__axiom_recover_save(i64 " (concat rec ")"))))
      (let _12s (emitArmSeq cg0 rec))
      (let _13 (emitLine cg0 (concat "  store i64 " (concat rec ", ptr @__axiom_recover_top"))))
      (let _14
        (emitLine cg0
          (concat "  call void asm sideeffect "
            (concat (targetRecoverArmAsm (cgTarget cg0) (* 8 words))
              (concat "(i64 " (concat rec ")"))))))
      (let _15 (emitLine cg0 (concat (concat "  " st) (concat " = load i64, ptr " p5))))
      (let _17
        (emitLine cg0 (concat (concat "  " ok) (concat " = icmp eq i64 " (concat st ", 0")))))
      (let _18
        (emitLine cg0
          (concat (concat "  br i1 " (concat ok ", label %"))
            (concat runB (concat (concat ", label %" doneB) "")))))
      (let _19 (emitLabel cg0 runB))
      {
        (let thunk (vecGet args 1))
        (let cgT
          (if (== (nodeTag thunk) TAG_E_LAM)
            (emitLambdaAt thunk cg0 true)
            (emitExpr thunk cg0)))
        {
          (let f (strDup (cgResult cgT)))
          {
            (let cgO
              (if (== (argIsDirectCon cgT (vecGet args 1)) 1)
                cgT
                (emitRetainOf cgT f)))
            {
              (let cgA (applyOneArg cgO f (constStr 0) (constStr 0) nilNode 0))
              {
                (let r (strDup (cgResult cgA)))
                (let _20 (emitReleaseOf cgA (strDup f)))
                (let _21 (emitLine cgA (concat "  br label %" doneB)))
                (let runEnd (strDup (cgBlock cgA)))
                (let _22 (emitLabel cgA doneB))
                (let _23
                  (emitLine cgA
                    (concat
                      (concat (concat (concat "  " res) (concat " = phi i64 [ " (concat st ", %")))
                        (concat armB (concat " ], [ " (concat r ", %"))))
                      (concat runEnd " ]"))))
                (let _24
                  (emitLine cgA (concat "  store i64 " (concat pv ", ptr @__axiom_recover_top"))))
                {
                  (cgSetResult cgA res)
                  (cgSetResultFloat cgA 0)
                  cgA
                }
              }
            }
          }
        }
      }
    }
  })

; MM-PAR-7: the spawn sequence number at the arm, in the word after the
; slot snapshot, so an abort to this point sweeps exactly the children
; spawned inside it. Nothing in a module that cannot spawn.
(pub :: emitArmSeq (-> CG String Int))
(pub fn (emitArmSeq cg rec)
  (if (== (parRegistryOn cg) 0)
    0
    {
      (let a (regStr (allocReg cg)))
      (let p (regStr (allocReg cg)))
      (let v (regStr (allocReg cg)))
      {
        (emitLine cg
          (concat (concat "  " a)
            (concat " = add i64 " (concat rec (concat ", " (fmtInt (parRecSeqOffset cg)))))))
        (emitLine cg (concat (concat "  " p) (concat " = inttoptr i64 " (concat a " to ptr"))))
        (emitLine cg (concat (concat "  " v) " = load i64, ptr @__axiom_par_seq"))
        (emitLine cg (concat "  store i64 " (concat v (concat ", ptr " p))))
        0
      }
    }))

(pub :: emitPrimArenaMark (-> CG CG))
(pub fn (emitPrimArenaMark cg)
  {
    (let r (regStr (allocReg cg)))
    {
      (let cg1 (emitLine cg (concat (concat "  " r) " = call i64 @__axiom_arena_mark_fn()")))
      {
        (cgSetResult cg1 r)
        cg1
      }
    }
  })

(pub :: emitPrimArenaMarkInto (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimArenaMarkInto args cg)
  {
    (let cg0 (emitExpr (vecGet args 0) cg))
    {
      (let cell (strDup (cgResult cg0)))
      {
        (let r (regStr (allocReg cg0)))
        {
          (emitLine cg0
            (concat "  "
              (concat r (concat " = call i64 @.axiom.arena.mark.into(i64 " (concat cell ")")))))
          (cgSetResult cg0 r)
          cg0
        }
      }
    }
  })

(pub :: emitPrimArenaReset (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimArenaReset args cg)
  {
    (let cg0 (emitExpr (vecGet args 0) cg))
    {
      (let cell (strDup (cgResult cg0)))
      {
        (let r (regStr (allocReg cg0)))
        {
          (let cg1
            (emitLine cg0
              (concat (concat "  " r)
                (concat " = call i64 @__axiom_arena_reset_fn(i64 " (concat cell ")")))))
          {
            (cgSetResult cg1 (constStr 0))
            cg1
          }
        }
      }
    }
  })

; `(__axiom_mem_stat k)` -> one of the allocator's own counts, in bytes
; (MM-ALLOC-24): 0 held by the arena, 1 filed for reuse, 2 mapped; any
; other `k` answers -1. One call into `@__axiom_mem_stat_fn`, which
; walks the two chunk lists for 0 and 2 and reads one word for 1.
(pub :: emitPrimMemStat (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimMemStat args cg)
  {
    (let cg0 (emitExpr (vecGet args 0) cg))
    {
      (let k (strDup (cgResult cg0)))
      {
        (let r (regStr (allocReg cg0)))
        {
          (let cg1
            (emitLine cg0
              (concat "  "
                (concat r (concat " = call i64 @__axiom_mem_stat_fn(i64 " (concat k ")"))))))
          {
            (cgSetResult cg1 r)
            cg1
          }
        }
      }
    }
  })

; `(__axiom_arena_cap n)` -> the cap it replaces (MM-PAR-17): one load
; and one store of `@__axiom_arena_cap`, which `emitArenaCapRuntime`
; defines in every module that names the primitive.
(pub :: emitPrimArenaCap (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimArenaCap args cg)
  {
    (let cg0 (emitExpr (vecGet args 0) cg))
    {
      (let v (strDup (cgResult cg0)))
      {
        (let r (regStr (allocReg cg0)))
        {
          (let cg1 (emitLine cg0 (concat "  " (concat r " = load i64, ptr @__axiom_arena_cap"))))
          {
            (emitLine cg1 (concat "  store i64 " (concat v ", ptr @__axiom_arena_cap")))
            (cgSetResult cg1 r)
            cg1
          }
        }
      }
    }
  })

; `(__axiom_stack_run bytes thunk arg)` -> what `(thunk arg)` answered,
; run on a stack of its own (MM-PAR-17): one call into the runtime
; `emitStackRunRuntime` defines in every module that names the
; primitive. The thunk is `emitPrimRecover`'s: a lambda built AT the
; call moves its birth share in, anything else is retained first, and
; the release after the call spends that share.
(pub :: emitPrimStackRun (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimStackRun args cg)
  {
    (let cgB (emitExpr (vecGet args 0) cg))
    {
      (let b (strDup (cgResult cgB)))
      {
        (let cgT (emitExpr (vecGet args 1) cgB))
        {
          (let f (strDup (cgResult cgT)))
          {
            (let cgO
              (if (== (argIsDirectCon cgT (vecGet args 1)) 1)
                cgT
                (emitRetainOf cgT f)))
            {
              (let cgA (emitExpr (vecGet args 2) cgO))
              {
                (let a (strDup (cgResult cgA)))
                (let r (regStr (allocReg cgA)))
                {
                  (emitLine cgA
                    (concat (concat "  " r)
                      (concat " = call i64 @__axiom_stack_run(i64 "
                        (concat b (concat ", i64 " (concat f (concat ", i64 " (concat a ")"))))))))
                  (emitReleaseOf cgA (strDup f))
                  (cgSetResult cgA r)
                  (cgSetResultFloat cgA 0)
                  cgA
                }
              }
            }
          }
        }
      }
    }
  })

; `(__axiom_arena_reset_keeping mark addr bytes)` -> where the kept
; block landed. Unlike the other two this one ANSWERS a value, so its
; result register goes in field 2.
(pub :: emitPrimArenaResetKeeping (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimArenaResetKeeping args cg)
  {
    (let cg0 (emitExpr (vecGet args 0) cg))
    {
      (let cell (strDup (cgResult cg0)))
      {
        (let cg1 (emitExpr (vecGet args 1) cg0))
        {
          (let src (strDup (cgResult cg1)))
          {
            (let cg2 (emitExpr (vecGet args 2) cg1))
            {
              (let n (strDup (cgResult cg2)))
              {
                (let r (regStr (allocReg cg2)))
                {
                  (let cg3
                    (emitLine cg2
                      (concat
                        (concat (concat "  " r)
                          (concat " = call i64 @__axiom_arena_reset_keeping_fn(i64 "
                            (concat cell ", i64 ")))
                        (concat src (concat ", i64 " (concat n ")"))))))
                  {
                    (cgSetResult cg3 r)
                    cg3
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; `(__argc)`: the count the entry wrapper captured before main ran.
(pub :: emitPrimArgc (-> CG CG))

; `(__indexTrap)`: the status-77 trap, reached from Axiom source.
;
; Traps are `internal` LLVM functions the runtime block emits, so
; nothing in `stdlib/` could reach one before this. A `Vec` that wants
; to refuse an out-of-range index rather than answer 0 needs exactly
; that, and so will every later container.
(pub :: emitPrimIndexTrap (-> CG CG))
(pub fn (emitPrimIndexTrap cg)
  {
    (let rn (allocReg cg))
    {
      (let r (regStr rn))
      {
        (emitLine cg (concat (concat "  " r) " = call i64 @__axiom_index_out_of_range()"))
        (cgSetResult cg r)
        cg
      }
    }
  })

(pub fn (emitPrimArgc cg)
  {
    (let rn (allocReg cg))
    {
      (let r (regStr rn))
      {
        (emitLine cg (concat (concat "  " r) " = load i64, ptr @__axiom_argc"))
        (cgSetResult cg r)
        cg
      }
    }
  })

; `(__argv i)`: the i-th argument's NUL-terminated bytes - the vector
; base the wrapper captured, then an ordinary indexed word load. No
; bounds check at this layer; `Sys.sysArg` owns that.
(pub :: emitPrimArgv (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimArgv args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let i (strDup (cgResult cg1)))
      (let bn (allocReg cg1))
      (let pn (allocReg cg1))
      (let gn (allocReg cg1))
      (let rn (allocReg cg1))
      {
        (let b (regStr bn))
        (let p (tmpStr "p" pn))
        (let g (tmpStr "g" gn))
        (let r (regStr rn))
        {
          (emitLine cg1 (concat (concat "  " b) " = load i64, ptr @__axiom_argv"))
          (emitLine cg1 (concat (concat "  " p) (concat " = inttoptr i64 " (concat b " to ptr"))))
          (emitLine cg1
            (concat
              (concat (concat "  " g) (concat " = getelementptr i64, ptr " (concat p ", i64 "))) i))
          (emitLine cg1 (concat (concat "  " r) (concat " = load i64, ptr " (concat g ""))))
          (cgSetResult cg1 r)
          cg1
        }
      }
    }
  })

; `__intToFloat` is a numeric conversion (`sitofp`), not a
; reinterpretation - that is `cast`'s job - and the result travels as
; the i64 of its bits like every other float.
(pub :: emitPrimIntToFloat (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimIntToFloat args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let v (strDup (cgResult cg1)))
      (let dn (allocReg cg1))
      (let rn (allocReg cg1))
      {
        (let dr (tmpStr "d" dn))
        (let r (regStr rn))
        {
          (emitLine cg1 (concat (concat "  " dr) (concat " = sitofp i64 " (concat v " to double"))))
          (emitLine cg1
            (concat (concat "  " r) (concat " = bitcast double " (concat dr " to i64"))))
          (cgSetResult cg1 r)
          (cgSetResultFloat cg1 1)
          cg1
        }
      }
    }
  })

; `__floatToInt` truncates toward zero and SATURATES: a NaN answers 0,
; a value at or above 2^63 the largest `Int`, and one below -2^63 the
; smallest. A bare `fptosi` answers poison for all three, and poison
; is whatever the optimiser makes of it: `(__floatToInt (/ 0.0 0.0))`
; answered 0 at `--opt 0`, 2 at 1 and 2, and 21 at 3, one program on
; one machine (docs/memory-model.md MM-PAR-14). The selects make every
; input's answer the same at every level and on every target; the
; `fptosi` feeding them is poison only where a select discards it.
; AArch64's `fcvtzs` already saturates this way, so there the three
; selects fold into the one instruction.
(pub :: emitPrimFloatToInt (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimFloatToInt args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let v (strDup (cgResult cg1)))
      (let dn (allocReg cg1))
      (let rn (allocReg cg1))
      {
        (let dr (tmpStr "d" dn))
        (let tr (tmpStr "fti" dn))
        (let hi (tmpStr "fth" dn))
        (let lo (tmpStr "ftl" dn))
        (let nan (tmpStr "ftn" dn))
        (let sa (tmpStr "fta" dn))
        (let sb (tmpStr "ftb" dn))
        (let r (regStr rn))
        {
          (emitLine cg1
            (concat (concat "  " dr) (concat " = bitcast i64 " (concat v " to double"))))
          (emitLine cg1
            (concat (concat "  " tr) (concat " = fptosi double " (concat dr " to i64"))))
          (emitLine cg1
            (concat (concat "  " hi)
              (concat " = fcmp oge double " (concat dr ", 0x43E0000000000000"))))
          (emitLine cg1
            (concat (concat "  " lo)
              (concat " = fcmp olt double " (concat dr ", 0xC3E0000000000000"))))
          (emitLine cg1
            (concat (concat "  " nan) (concat " = fcmp uno double " (concat dr ", 0.0"))))
          (emitLine cg1
            (concat (concat "  " sa)
              (concat (concat " = select i1 " hi) (concat ", i64 9223372036854775807, i64 " tr))))
          (emitLine cg1
            (concat (concat "  " sb)
              (concat (concat " = select i1 " lo) (concat ", i64 -9223372036854775808, i64 " sa))))
          (emitLine cg1
            (concat (concat "  " r)
              (concat (concat " = select i1 " nan) (concat ", i64 0, i64 " sb))))
          (cgSetResult cg1 r)
          (cgSetResultFloat cg1 0)
          cg1
        }
      }
    }
  })

; ------------------------------------------------------------------
; The atomic primitives - one `emitLine` each, and no target arm.
;
; `(__atomic_load p)`, `(__atomic_store p v)`, `(__atomic_add p v)`,
; `(__atomic_cas p expected new)` and `__fence`, each on the machine
; word at BYTE ADDRESS `p` - the address itself, where `__load64` takes
; a base and a word index - and each sequentially consistent. The
; language has no memory-ordering vocabulary, MM-EXEC-11's determinism
; proviso is already the weakest thing a reader has to hold in their
; head, and a relaxed ordering that is wrong is invisible to every gate
; in this repository; `seq_cst` is the one spelling a gate can be wrong
; about only by being wrong. LLVM lowers all five inline on every
; target here - `lock xadd`/`cmpxchg` on x86-64, a load/store-exclusive
; loop or LSE on AArch64 - so `check-freestanding.sh`'s zero-symbol
; sweep holds over the fixture that spells them
; (tests/stdlib/440-atomics.ax), and `check-cross-targets.sh` assembles
; that fixture at -O0, where `atomicrmw` on a global is the shape that
; once emitted `R_X86_64_32S`.
;
; What each ANSWERS is the LLVM result and nothing friendlier. The add
; and the compare-and-swap answer the word BEFORE the operation - a
; CAS therefore reports success as "the answer equals `expected`" -
; and the store and the fence answer 0, as `__store64` does. There is
; no second thread for any of these to synchronise with yet
; (docs/memory-model.md MM-PAR-1): they are MM-PAR-4's stated escape
; for memory a program mapped itself, given an instruction, and the
; first phase of MM-PAR-6's obligation.
; ------------------------------------------------------------------
(pub :: emitPrimAtomic (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAtomic fnName args cg)
  (if (strEq fnName "__fence")
    (emitPrimFence cg)
    (if (strEq fnName "__atomic_load")
      (emitPrimAtomicLoad args cg)
      (if (strEq fnName "__atomic_store")
        (emitPrimAtomicStore args cg)
        (if (strEq fnName "__atomic_add")
          (emitPrimAtomicAdd args cg)
          (emitPrimAtomicCas args cg))))))

; The address operand, `inttoptr`ed into a register the caller names
; in its own instruction - `narrowByte`'s shape, for an address. The
; volatile device accesses use it as it is: a 16- or 32-bit register at
; an address aligned to its own width is correct there.
(pub :: emitAtomicPtr (-> CG String String))
(pub fn (emitAtomicPtr cg addr)
  {
    (let pr (regStr (allocReg cg)))
    {
      (emitLine cg (concat (concat "  " pr) (concat " = inttoptr i64 " (concat addr " to ptr"))))
      pr
    }
  })

; The four atomics' address: checked to be 8-byte aligned first
; (`emitAtomicAlignGuard`), then `emitAtomicPtr`.
(pub :: emitAtomicCheckedPtr (-> CG String String))
(pub fn (emitAtomicCheckedPtr cg addr)
  {
    (emitAtomicAlignGuard cg addr)
    (emitAtomicPtr cg addr)
  })

; `if address % 8 != 0 then trap 82` - `emitDivGuardWidth`'s shape. A
; misaligned atomic was a different program on each architecture: an
; alignment fault on AArch64 (SIGBUS, exit 138, measured) and, on
; x86-64, a split-lock access that is atomic but slow, or #AC where
; split-lock detection is on. A trap with its own status makes it one
; program everywhere, recoverable like the index trap, and the check is
; an `and`, a compare and a predictable branch beside an instruction
; that costs far more. MM-PAR-9's alignment precondition is checked
; here rather than stated.
(pub :: emitAtomicAlignGuard (-> CG String CG))
(pub fn (emitAtomicAlignGuard cg addr)
  {
    (let an (allocReg cg))
    (let cn (allocReg cg))
    (let zn (allocReg cg))
    (let kn (allocReg cg))
    {
      (let a (regStr an))
      (let c (regStr cn))
      (let zb (concat "atomicmis_" (fmtInt zn)))
      (let kb (concat "atomicok_" (fmtInt kn)))
      {
        (emitLine cg (concat (concat "  " a) (concat " = and i64 " (concat addr ", 7"))))
        (emitLine cg (concat (concat "  " c) (concat " = icmp ne i64 " (concat a ", 0"))))
        (emitLine cg
          (concat (concat "  br i1 " (concat c ", label %"))
            (concat zb (concat (concat ", label %" kb) ""))))
        (emitLabel cg zb)
        (emitLine cg "  call i64 @__axiom_misaligned_atomic()")
        (emitLine cg "  unreachable")
        (emitLabel cg kb)
        cg
      }
    }
  })

(pub :: emitPrimFence (-> CG CG))
(pub fn (emitPrimFence cg)
  {
    (emitLine cg "  fence seq_cst")
    (cgSetResult cg (constStr 0))
    cg
  })

(pub :: emitPrimAtomicLoad (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAtomicLoad args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let pr (emitAtomicCheckedPtr cg1 (strDup (cgResult cg1))))
      {
        (let vr (regStr (allocReg cg1)))
        {
          (emitLine cg1
            (concat (concat "  " vr)
              (concat " = load atomic i64, ptr " (concat pr " seq_cst, align 8"))))
          (cgSetResult cg1 vr)
          cg1
        }
      }
    }
  })

(pub :: emitPrimAtomicStore (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAtomicStore args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let addr (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let val (strDup (cgResult cg2)))
    {
      (let pr (emitAtomicCheckedPtr cg2 addr))
      {
        (emitLine cg2
          (concat (concat "  store atomic i64 " val)
            (concat ", ptr " (concat pr " seq_cst, align 8"))))
        (cgSetResult cg2 (constStr 0))
        cg2
      }
    }
  })

(pub :: emitPrimAtomicAdd (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAtomicAdd args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let addr (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let val (strDup (cgResult cg2)))
    {
      (let pr (emitAtomicCheckedPtr cg2 addr))
      {
        (let vr (regStr (allocReg cg2)))
        {
          (emitLine cg2
            (concat (concat (concat "  " vr) (concat " = atomicrmw add ptr " pr))
              (concat ", i64 " (concat val " seq_cst, align 8"))))
          (cgSetResult cg2 vr)
          cg2
        }
      }
    }
  })

; `cmpxchg` answers a `{ i64, i1 }` pair - the word it found and
; whether it matched - and the primitive answers the word alone: the
; caller already holds `expected`, so the flag is one comparison away
; and a second result would need a second word to travel in.
(pub :: emitPrimAtomicCas (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAtomicCas args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let addr (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let expected (strDup (cgResult cg2)))
    (let cg3 (emitExpr (vecGet args 2) cg2))
    (let fresh (strDup (cgResult cg3)))
    {
      (let pr (emitAtomicCheckedPtr cg3 addr))
      {
        (let pairR (regStr (allocReg cg3)))
        {
          (let vr (regStr (allocReg cg3)))
          {
            (emitLine cg3
              (concat (concat (concat "  " pairR) (concat " = cmpxchg ptr " (concat pr ", i64 ")))
                (concat expected (concat (concat ", i64 " fresh) " seq_cst seq_cst, align 8"))))
            (emitLine cg3
              (concat (concat "  " vr)
                (concat " = extractvalue { i64, i1 } " (concat pairR ", 0"))))
            (cgSetResult cg3 vr)
            cg3
          }
        }
      }
    }
  })

; ------------------------------------------------------------------
; THE DEVICE PRIMITIVES (R-D2, 2026-09-27; `tcRegDevicePrims` in
; typecheck.ax registers them and says what each one's row is).
;
; THE VOLATILE ACCESSES, `__vloadN addr` and `__vstoreN addr v` for N in
; 8/16/32/64, are one `load volatile iN` / `store volatile iN` at the
; byte address `addr` with NATURAL alignment (`align N/8`), and nothing
; else: no index scaling (`__store8v`'s `base + i` is the older shape),
; no fence, no retry. A load zero-extends to the word; a store truncates
; `v` and answers 0. Every target lowers them - `volatile` is portable
; LLVM - and on a hosted target they are an honest way to read memory
; a signal handler or another mapping changes, which is also why the
; periodic fixture reads its interrupt-shared words through them.
;
; WHAT VOLATILE BUYS, stated where the lowering is decided
; (`docs/memory-model.md` MM-FFI-8): the middle end neither deletes,
; merges, splits, widens nor reorders a volatile access against another
; volatile access, and keeps its width, which is what a device register
; needs - a 32-bit register read as two 16-bit halves, or a write
; dropped because nothing reads it back, is a wrong program. What it
; does NOT buy is ordering against ordinary memory or any other core:
; that is `__arm_dmb`/`__arm_dsb` for a device, and the atomics
; (MM-PAR-9) for another thread. The misaligned address is the caller's
; obligation, not checked here - it is UB in the IR and an alignment
; fault on baremetal-aarch64, which sets SCTLR_EL1.A (docs/embedded-guide.md);
; `stdlib/Mmio.ax` checks it once, where a register handle is made.
;
; THE AArch64 SET, `__arm_*`, is one inline-assembly statement each,
; `sideeffect` so none is deleted or merged, and `~{memory}` on every
; one that orders, waits or writes, so the compiler moves no load or
; store across a barrier, a mask or a timestamp. Two tiers: the
; barriers and the two counter reads run at EL0 on an aarch64 HOST
; (Linux and Darwin both let user code read CNTVCT_EL0 and CNTFRQ_EL0),
; and everything else needs EL1, which only `baremetal-aarch64` runs
; programs at. A primitive this target cannot run is not lowered:
; `emitDeviceRefused` writes a marker line where the instruction would
; have been and `main.ax` refuses the module as AX4008 when the marker
; survives `pruneDeadDefs` - so a function nothing calls, which the
; prune deletes, is never refused, and a portable module may carry an
; AArch64 helper that an x86 program never reaches.
; ------------------------------------------------------------------
(pub :: isDevicePrimName (-> String Bool))
(pub fn (isDevicePrimName nm)
  (if (> (devicePrimBits nm) 0)
    true
    (isArmPrimName nm)))

; The access width in bits of a volatile primitive, or 0 for any other
; name - which is also the test `isDevicePrimName` asks.
(pub :: devicePrimBits (-> String Int))
(pub fn (devicePrimBits nm)
  (if (|| (strEq nm "__vload8") (strEq nm "__vstore8"))
    8
    (if (|| (strEq nm "__vload16") (strEq nm "__vstore16"))
      16
      (if (|| (strEq nm "__vload32") (strEq nm "__vstore32"))
        32
        (if (|| (strEq nm "__vload64") (strEq nm "__vstore64"))
          64
          0)))))

(pub :: isArmPrimName (-> String Bool))
(pub fn (isArmPrimName nm)
  (if (isHostedArmPrimName nm)
    true
    (if (|| (strEq nm "__arm_ctr")
          (|| (strEq nm "__arm_tpidr") (|| (strEq nm "__arm_set_tpidr") (strEq nm "__arm_rndr"))))
      true
      (if (|| (strEq nm "__arm_set_cntv_cval") (strEq nm "__arm_set_cntv_ctl"))
        true
        (if (|| (strEq nm "__arm_irq_mask")
              (|| (strEq nm "__arm_irq_unmask") (strEq nm "__arm_wfi")))
          true
          (|| (strEq nm "__arm_dc_cvac") (strEq nm "__arm_dc_civac")))))))

; The EL0 tier: what an aarch64 host lets user code execute.
(pub :: isHostedArmPrimName (-> String Bool))
(pub fn (isHostedArmPrimName nm)
  (if (|| (strEq nm "__arm_dmb") (|| (strEq nm "__arm_dsb") (strEq nm "__arm_isb")))
    true
    (|| (strEq nm "__arm_cntvct") (strEq nm "__arm_cntfrq"))))

; The device primitives written by NAME alone, `isNullaryPrimName`'s
; rule: `(__arm_dmb)` and `__arm_dmb` both reach `emitVar`.
(pub :: isNullaryDevicePrimName (-> String Bool))
(pub fn (isNullaryDevicePrimName nm)
  (if (isHostedArmPrimName nm)
    true
    (if (|| (strEq nm "__arm_ctr") (|| (strEq nm "__arm_tpidr") (strEq nm "__arm_rndr")))
      true
      (|| (strEq nm "__arm_irq_mask") (|| (strEq nm "__arm_irq_unmask") (strEq nm "__arm_wfi"))))))

; Can target `t` execute `nm`? The volatile accesses run everywhere;
; the EL0 tier on any AArch64 target; the rest on baremetal-aarch64.
(pub :: devicePrimTargetOK (-> String Int Int))
(pub fn (devicePrimTargetOK nm t)
  (if (> (devicePrimBits nm) 0)
    1
    (if (== t 7)
      1
      (if (targetIsAArch64 t)
        (if (isHostedArmPrimName nm)
          1
          0)
        0))))

; The assembly each `__arm_*` primitive is. `$0` is the operand: the
; result of a read, the value or address of a one-argument write.
(pub :: armPrimAsm (-> String String))
(pub fn (armPrimAsm nm)
  (if (strEq nm "__arm_dmb")
    "dmb sy"
    (if (strEq nm "__arm_dsb")
      "dsb sy"
      (if (strEq nm "__arm_isb")
        "isb"
        (if (strEq nm "__arm_cntvct")
          "mrs $0, cntvct_el0"
          (if (strEq nm "__arm_cntfrq")
            "mrs $0, cntfrq_el0"
            (if (strEq nm "__arm_ctr")
              "mrs $0, ctr_el0"
              (if (strEq nm "__arm_tpidr")
                "mrs $0, tpidr_el1"
                (if (strEq nm "__arm_set_tpidr")
                  "msr tpidr_el1, $0"
                  (if (strEq nm "__arm_set_cntv_cval")
                    "msr cntv_cval_el0, $0"
                    (if (strEq nm "__arm_set_cntv_ctl")
                      "msr cntv_ctl_el0, $0"
                      (if (strEq nm "__arm_irq_mask")
                        "msr daifset, #2"
                        (if (strEq nm "__arm_irq_unmask")
                          "msr daifclr, #2"
                          (if (strEq nm "__arm_wfi")
                            "wfi"
                            (if (strEq nm "__arm_dc_cvac")
                              "dc cvac, $0"
                              (if (strEq nm "__arm_rndr")
                                ; `RNDR` sets Z when it could not answer and
                                ; leaves 0; `csel` turns every such read
                                ; into 0, so the answer is the whole story
                                "mrs $0, s3_3_c2_c4_0\\0Acsel $0, $0, xzr, ne"
                                "dc civac, $0"))))))))))))))))

; The reads answer a register. The counter read carries `~{memory}`
; because it is a TIMESTAMP: a load or store the compiler moved across
; it would be timed on the wrong side.
(pub :: armPrimReadCons (-> String String))
(pub fn (armPrimReadCons nm)
  (if (strEq nm "__arm_cntvct")
    "\"=r,~{memory}\"()"
    (if (strEq nm "__arm_rndr")
      "\"=r,~{cc}\"()"
      "\"=r\"()")))

(pub :: armPrimReads (-> String Bool))
(pub fn (armPrimReads nm)
  (if (|| (strEq nm "__arm_cntvct") (strEq nm "__arm_cntfrq"))
    true
    (|| (strEq nm "__arm_ctr") (|| (strEq nm "__arm_tpidr") (strEq nm "__arm_rndr")))))

(pub :: armPrimTakesArg (-> String Bool))
(pub fn (armPrimTakesArg nm)
  (if (|| (strEq nm "__arm_set_tpidr")
        (|| (strEq nm "__arm_set_cntv_cval") (strEq nm "__arm_set_cntv_ctl")))
    true
    (|| (strEq nm "__arm_dc_cvac") (strEq nm "__arm_dc_civac"))))

(pub :: emitPrimDevice (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimDevice fnName args cg)
  (if (> (devicePrimBits fnName) 0)
    (if (strStartsWith fnName "__vload")
      (emitPrimVLoad args cg (devicePrimBits fnName))
      (emitPrimVStore args cg (devicePrimBits fnName)))
    (emitPrimArm fnName args cg)))

(pub :: emitPrimVLoad (-> Nodes CG Int CG))
;@axiom:effect(io)
(pub fn (emitPrimVLoad args cg bits)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let pr (emitAtomicPtr cg1 (strDup (cgResult cg1))))
      {
        (let ty (concat "i" (fmtInt bits)))
        (let vr (regStr (allocReg cg1)))
        {
          (emitLine cg1
            (concat (concat "  " vr)
              (concat (concat " = load volatile " (concat ty ", ptr "))
                (concat pr (concat ", align " (fmtInt (/ bits 8)))))))
          (if (== bits 64)
            (cgSetResult cg1 vr)
            {
              (let wr (regStr (allocReg cg1)))
              {
                (emitLine cg1
                  (concat (concat "  " wr)
                    (concat (concat " = zext " (concat ty " ")) (concat vr " to i64"))))
                (cgSetResult cg1 wr)
              }
            })
          cg1
        }
      }
    }
  })

(pub :: emitPrimVStore (-> Nodes CG Int CG))
;@axiom:effect(io)
(pub fn (emitPrimVStore args cg bits)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let addr (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let val (strDup (cgResult cg2)))
    {
      (let pr (emitAtomicPtr cg2 addr))
      (let ty (concat "i" (fmtInt bits)))
      {
        (let sv
          (if (== bits 64)
            val
            {
              (let tr (regStr (allocReg cg2)))
              {
                (emitLine cg2
                  (concat (concat "  " tr)
                    (concat " = trunc i64 " (concat val (concat " to " ty)))))
                tr
              }
            }))
        {
          (emitLine cg2
            (concat (concat "  store volatile " (concat ty (concat " " sv)))
              (concat ", ptr " (concat pr (concat ", align " (fmtInt (/ bits 8)))))))
          (cgSetResult cg2 (constStr 0))
          cg2
        }
      }
    }
  })

(pub :: emitPrimArm (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimArm fnName args cg)
  (if (armPrimTakesArg fnName)
    {
      (let cg1 (emitExpr (vecGet args 0) cg))
      {
        (let a (strDup (cgResult cg1)))
        (if (== (devicePrimTargetOK fnName (cgTarget cg1)) 0)
          (emitDeviceRefused cg1 fnName)
          {
            (emitLine cg1
              (concat "  call void asm sideeffect \""
                (concat (armPrimAsm fnName) (concat "\", \"r,~{memory}\"(i64 " (concat a ")")))))
            (cgSetResult cg1 (constStr 0))
            cg1
          })
      }
    }
    (if (== (devicePrimTargetOK fnName (cgTarget cg)) 0)
      (emitDeviceRefused cg fnName)
      (if (armPrimReads fnName)
        {
          (let r (regStr (allocReg cg)))
          {
            (emitLine cg
              (concat (concat "  " r)
                (concat " = call i64 asm sideeffect \""
                  (concat (armPrimAsm fnName) (concat "\", " (armPrimReadCons fnName))))))
            (cgSetResult cg r)
            cg
          }
        }
        {
          (emitLine cg
            (concat "  call void asm sideeffect \""
              (concat (armPrimAsm fnName) "\", \"~{memory}\"()")))
          (cgSetResult cg (constStr 0))
          cg
        }))))

; The AX4008 marker, where an instruction this target cannot execute
; would have been. The value is 0 and nothing reads it: `main.ax`
; refuses the module before any tool sees the IR, and when the marker
; sits in a function `pruneDeadDefs` deleted there is nothing to refuse.
; The line carries the whole sentence, so the refusal is written once.
(pub :: emitDeviceRefused (-> CG String CG))
(pub fn (emitDeviceRefused cg nm)
  {
    (emitLine cg
      (concat "  ; axiom-device-refused `"
        (concat nm
          (concat
            (if (targetIsAArch64 (cgTarget cg))
              "` needs EL1, the privilege a kernel runs at, and "
              "` is an AArch64 instruction, and ")
            (concat (targetSpelling (cgTarget cg))
              (if (targetIsAArch64 (cgTarget cg))
                " runs programs at EL0 - only baremetal-aarch64 runs one at EL1"
                " is not an AArch64 target"))))))
    (cgSetResult cg (constStr 0))
    cg
  })

; ------------------------------------------------------------------
; INLINE ASSEMBLY (MM-FFI-9). `(__asm.N desc v...)` is what an `asm`
; form expands to (`expandAsm` in expand.ax, which documents the
; description). This emits the arm for the target's architecture as
; one `call asm`. Only that arm's inputs are evaluated, in the order
; the arm writes them. A target with no arm gets AX4008's marker, so a
; portable module may carry an arm for each architecture, and a
; function nothing reaches is never refused.
;
; What the options become, Rust's lowering on the same LLVM:
;
;   every block    `nounwind`; clobbers memory unless `nomem`, and the
;                  flags unless `preserves_flags`
;   not `pure`     `sideeffect`, so the optimiser never deletes,
;                  merges or hoists it
;   `pure`         no `sideeffect`, `willreturn`, and `memory(none)`
;                  with `nomem` or `memory(read)` with `readonly`
;   `nomem` alone  `memory(inaccessiblemem: readwrite)`
;   not `nostack`  `alignstack`: the stack pointer is aligned for a
;                  call, and the function keeps nothing in a red zone
;                  below it - on x86-64 it otherwise would, and a
;                  `call` in the template overwrote it (measured: a
;                  local at -24(%rsp) across the block)
;   `noreturn`     `unreachable` after the call
;   `intel_syntax` `inteldialect`
;   `clobber_abi`  every register the target's C convention lets a
;                  callee overwrite (`asmAbiClobbers`)
;
; Every line of the template carries a `!srcloc` cookie, numbered by
; pair slot 20 across the module. An `; axiom-asm-site FIRST K s-e ...`
; comment before the call maps the cookies to the lines' bytes in
; source file K, and the module ends with one `; axiom-asm-file K
; "path"` line per file (`emitAsmFiles`). llc names the cookie when the
; assembler or the register allocator rejects a line, and
; `asmFailDiags` in driver.ax reads the comments back to report AX3117
; at that line.
; ------------------------------------------------------------------
(pub :: isAsmPrimName (-> String Bool))
(pub fn (isAsmPrimName nm)
  (&& (strStartsWith nm "__asm.")
    (&& (> (strLen nm) 6) (&& (>= (strByte nm 6) 48) (<= (strByte nm 6) 57)))))

(pub :: emitPrimAsm (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAsm args cg)
  {
    (let arch
      (if (targetIsAArch64 (cgTarget cg))
        "aarch64"
        "x86_64"))
    (let d (vecGet args 0))
    {
      (let desc
        (if (== (nodeTag d) TAG_E_STR)
          (strUnquoteLit (nodeAName d))
          ""))
      (match (asmArmAt desc arch 0)
        ((None) (emitAsmRefused cg arch))
        ((Some at)
          (match (asmArmFields desc at)
            ((None) (emitAsmRefused cg arch))
            ((Some fields) (emitAsmArm desc fields args cg)))
        ))
    }
  })

; The next `;` at or after `i`, or None when no delimiter follows.
(pub :: asmSemi (-> String Int (Option Int)))
(pub fn (asmSemi s i)
  (if (|| (< i 0) (>= i (strLen s)))
    None
    (if (== (strByte s i) 59)
      (Some i)
      (asmSemi s (+ i 1)))))

; The decimal between the `;` at `from` and the one at `to`, with an
; optional leading `-`.
(pub :: asmDigits (-> String Int Int Int))
(pub fn (asmDigits s from to)
  {
    (let mut v 0)
    (let neg (&& (< (+ from 1) to) (== (strByte s (+ from 1)) 45)))
    (let mut i (+ from 1))
    {
      (if neg
        (set i (+ i 1)))
      (while (< i to)
        {
          (set v (+ (* v 10) (- (strByte s i) 48)))
          (set i (+ i 1))
        })
      (if neg
        (- 0 v)
        v)
    }
  })

; Where the fields of the arm at `at` lie: the start and end of each of
; its eight `;`-ended fields (words 0 to 15), FILE's start and length
; (16, 17), TEMPLATE's (18, 19), and the offset just past the arm (20).
; None when a field delimiter is missing, which only a hand-made
; description can be.
(pub :: asmArmFields (-> String Int (Option Ints)))
(pub fn (asmArmFields desc at)
  {
    (let v vecNew)
    (let mut p at)
    (let mut k 0)
    (let mut ok true)
    {
      (while (&& ok (< k 8))
        (if (let (Some e) (asmSemi desc p))
          {
            (vecPush v p)
            (vecPush v e)
            (set p (+ e 1))
            (set k (+ k 1))
          }
          (set ok false)))
      (if (! ok)
        None
        (match (asmSemi desc p)
          ((None) None)
          ((Some fe)
            {
              (let flen (asmDigits desc (- p 1) fe))
              (let fs (+ fe 1))
              (match (asmSemi desc (+ fs flen))
                ((None) None)
                ((Some te)
                  {
                    (let tlen (asmDigits desc (- (+ fs flen) 1) te))
                    (let ts (+ te 1))
                    {
                      (vecPush v fs)
                      (vecPush v flen)
                      (vecPush v ts)
                      (vecPush v tlen)
                      (vecPush v (+ ts tlen))
                      (Some v)
                    }
                  }
                ))
            }
          )))
    }
  })

; Field `k` of an arm, as text.
(pub :: asmField (-> String Ints Int String))
(pub fn (asmField desc f k)
  (strSlice desc (vecGet f (* 2 k)) (- (vecGet f (+ (* 2 k) 1)) (vecGet f (* 2 k)))))

; Field `k` of an arm, as a number.
(pub :: asmFieldInt (-> String Ints Int Int))
(pub fn (asmFieldInt desc f k)
  (asmDigits desc (- (vecGet f (* 2 k)) 1) (vecGet f (+ (* 2 k) 1))))

; The offset of `arch`'s arm, or None when no complete arm matches.
(pub :: asmArmAt (-> String String Int (Option Int)))
(pub fn (asmArmAt desc arch pos)
  (if (>= pos (strLen desc))
    None
    (match (asmArmFields desc pos)
      ((None) None)
      ((Some f)
        (if (strEq (asmField desc f 0) arch)
          (Some pos)
          (asmArmAt desc arch (vecGet f 20)))
      ))))

; Does the arm's FLAGS field hold `letter`?
(pub :: asmHasFlag (-> String Int Bool))
(pub fn (asmHasFlag flags letter)
  (if (let (Some _) (strFindByte flags letter 0))
    true
    false))

; The comma-separated items of a field, as a Vec of String.
(pub :: asmSplit (-> String Strings))
(pub fn (asmSplit s)
  {
    (let out vecNew)
    (let mut from 0)
    (let mut i 0)
    {
      (while (<= i (strLen s))
        {
          (if (|| (== i (strLen s)) (== (strByte s i) 44))
            {
              (if (> i from)
                (vecPush out (strSlice s from (- i from))))
              (set from (+ i 1))
            })
          (set i (+ i 1))
        })
      out
    }
  })

; The arm's inputs as the call's argument list, `i64 %a, ptr @f`: each
; value evaluated in constraint order, which is the order written, and
; each `sym` the symbol of the function its `(__asm.sym f)` names.
(pub :: asmInputArgs (-> String Nodes CG String))
;@axiom:effect(io)
(pub fn (asmInputArgs ins args cg)
  {
    (let items (asmSplit ins))
    (let parts vecNew)
    {
      (for it in items
        (vecPush parts
          (if (== (strByte it 0) 115)
            {
              (let node (vecGet args (+ (asmDigits it 0 (strLen it)) 1)))
              (concat "ptr @" (llvmSym (strDup (mangledForCg cg (nodeAName (nodeBChild node))))))
            }
            {
              (let cgV (emitExpr (vecGet args (+ (asmDigits it (- 0 1) (strLen it)) 1)) cg))
              (concat "i64 " (strDup (cgResult cgV)))
            })))
      (strJoin parts ", ")
    }
  })

; The registers the target's C calling convention lets a callee
; overwrite, for `clobber_abi("C")`: AArch64's x0-x17, x30 and the
; vector registers (only the low halves of v8-v15 survive a call), and
; x18 where the platform doesn't reserve it; x86-64's System V set
; with every xmm register, or the Windows set, which keeps rsi, rdi and
; xmm6-xmm15. A register an output or a clobber of the arm already
; names is left out: the output is written after any call returns, and
; a clobber named twice adds nothing. An input's register stays in,
; because the call overwrites it.
(pub :: asmAbiClobbers (-> Int String String))
(pub fn (asmAbiClobbers t cons)
  {
    (let regs
      (if (targetIsAArch64 t)
        (concat (asmRegRun "x" 0 17)
          (concat
            (if (|| (== t 0) (== t 8))
              ""
              " x18")
            (concat " lr " (asmRegRun "v" 0 31))))
        (if (targetIsWindows t)
          (concat "rax rcx rdx r8 r9 r10 r11 " (asmRegRun "xmm" 0 5))
          (concat "rax rcx rdx rsi rdi r8 r9 r10 r11 " (asmRegRun "xmm" 0 15)))))
    (let names (asmSplitSpace regs))
    (let kept vecNew)
    {
      (for r in names
        (if (! (asmConsNames cons r))
          (vecPush kept (concat (concat "~{" r) "}"))))
      (strJoin kept ",")
    }
  })

; `prefix` numbered from `lo` to `hi`, space-separated.
(pub :: asmRegRun (-> String Int Int String))
(pub fn (asmRegRun prefix lo hi)
  {
    (let names vecNew)
    {
      (for r in lo..(+ hi 1)
        (vecPush names (concat prefix (fmtInt r))))
      (strJoin names " ")
    }
  })

(pub :: asmSplitSpace (-> String Strings))
(pub fn (asmSplitSpace s)
  {
    (let out vecNew)
    (let mut from 0)
    (let mut i 0)
    {
      (while (<= i (strLen s))
        {
          (if (|| (== i (strLen s)) (== (strByte s i) 32))
            {
              (if (> i from)
                (vecPush out (strSlice s from (- i from))))
              (set from (+ i 1))
            })
          (set i (+ i 1))
        })
      out
    }
  })

; Do the constraints already write register `r`, as an output
; (`={r}`, `=&{r}`) or a clobber (`~{r}`)? An input in `r` doesn't
; count: the call still overwrites it, so it stays clobbered.
(pub :: asmConsNames (-> String String Bool))
(pub fn (asmConsNames cons r)
  {
    (let braced (concat (concat "{" r) "}"))
    (|| (== (strHasSub cons (concat "=" braced)) 1)
      (|| (== (strHasSub cons (concat "&" braced)) 1) (== (strHasSub cons (concat "~" braced)) 1)))
  })

; The full constraint list: the arm's own, the ABI's clobbers, memory
; unless `nomem`, and the flags unless `preserves_flags`.
(pub :: asmConstraints (-> Int String String String))
(pub fn (asmConstraints t flags cons)
  {
    (let abi
      (if (asmHasFlag flags 97)
        (asmAbiClobbers t cons)
        ""))
    (let mem
      (if (asmHasFlag flags 109)
        ""
        "~{memory}"))
    (let fl
      (if (asmHasFlag flags 102)
        ""
        (if (targetIsAArch64 t)
          "~{cc}"
          "~{dirflag},~{fpsr},~{flags}")))
    (asmJoin (asmJoin (asmJoin cons abi) mem) fl)
  })

(pub :: asmJoin (-> String String String))
(pub fn (asmJoin s t)
  (if (== (strLen t) 0)
    s
    (if (== (strLen s) 0)
      t
      (concat (concat s ",") t))))

; The call's attributes, which tell the optimiser what the options
; promise.
(pub :: asmAttrs (-> String String))
(pub fn (asmAttrs flags)
  (if (asmHasFlag flags 112)
    (if (asmHasFlag flags 109)
      "nounwind willreturn memory(none)"
      "nounwind willreturn memory(read)")
    (if (asmHasFlag flags 109)
      "nounwind memory(inaccessiblemem: readwrite)"
      "nounwind")))

; A file name as it sits between the quotes of an `; axiom-asm-file`
; line: a quote, a backslash and anything outside printable ASCII
; as `\XX`, so the comment stays one line whatever the name holds.
(pub :: asmQuoteName (-> String String))
(pub fn (asmQuoteName s)
  {
    (let out (strBuilderWithCapacity (strLen s)))
    {
      (for i in 0..(strLen s)
        {
          (let c (strByte s i))
          (if (|| (< c 32) (|| (> c 126) (|| (== c 34) (== c 92))))
            {
              (strBuilderPushByte out 92)
              (strBuilderPush out (strSlice "0123456789ABCDEF" (/ c 16) 1))
              (strBuilderPush out (strSlice "0123456789ABCDEF" (% c 16) 1))
            }
            (strBuilderPushByte out c))
        })
      (strBuilderFinish out)
    }
  })

; The number of source file `file` in the module's table (pair slot
; 21), adding it the first time it is asked for.
(pub :: asmFileIndex (-> CG String Int))
(pub fn (asmFileIndex cg file)
  {
    (let files (cgAsmFiles cg))
    (let mut at (- 0 1))
    (let mut i 0)
    {
      (while (&& (< at 0) (< i (vecLen files)))
        {
          (if (strEq (vecGetStr files i) file)
            (set at i))
          (set i (+ i 1))
        })
      (if (>= at 0)
        at
        {
          (vecPush files (strDup file))
          (- (vecLen files) 1)
        })
    }
  })

; `; axiom-asm-file K "path"` for each file an inline-assembly line
; came from, at the end of the module, where no function's body
; carries a file's name.
(pub :: emitAsmFiles (-> CG CG))
;@axiom:effect(io)
(pub fn (emitAsmFiles cg)
  {
    (let files (cgAsmFiles cg))
    (let mut i 0)
    {
      (while (< i (vecLen files))
        {
          (emitLine cg
            (concat (concat (concat "; axiom-asm-file " (fmtInt i)) " \"")
              (concat (asmQuoteName (asmFileRecorded (vecGetStr files i))) "\"")))
          (set i (+ i 1))
        })
      cg
    }
  })

; A file as its `; axiom-asm-file` line records it. A library file is
; written from the library's root, `<stdlib>/Sys.ax`, so the emission
; is the same wherever the library sits: the seed is regenerated in
; another directory and compared byte for byte. The driver resolves it
; back (`asmFileResolve`). Any other file is written as it was read.
(pub :: asmFileRecorded (-> String String))
;@axiom:effect(io)
(pub fn (asmFileRecorded file)
  (asmStdlibRel file stdlibSearchDirs 0))

(pub :: asmStdlibRel (-> String Names Int String))
(pub fn (asmStdlibRel file dirs i)
  (if (>= i (vecLen dirs))
    file
    {
      (let d (vecGetStr dirs i))
      (if (&& (> (strLen d) 0) (strStartsWith file d))
        (concat "<stdlib>/" (strSlice file (strLen d) (- (strLen file) (strLen d))))
        (asmStdlibRel file dirs (+ i 1)))
    }))

; The file a recorded name stands for: `<stdlib>/Sys.ax` in the first
; library root that holds it, and any other name as it is.
(pub :: asmFileResolve (-> String String))
;@axiom:effect(io)
(pub fn (asmFileResolve name)
  (if (strStartsWith name "<stdlib>/")
    (asmStdlibFind (strSlice name 9 (- (strLen name) 9)) stdlibSearchDirs 0)
    name))

(pub :: asmStdlibFind (-> String Names Int String))
;@axiom:effect(io)
(pub fn (asmStdlibFind rel dirs i)
  (if (>= i (vecLen dirs))
    (concat "<stdlib>/" rel)
    {
      (let p (concat (vecGetStr dirs i) rel))
      (if (fileExists p)
        p
        (asmStdlibFind rel dirs (+ i 1)))
    }))

; The `!srcloc` node and the site comment for an arm whose LINES are
; known: one cookie per line, the first taken from pair slot 20 and
; the slot moved past the last. Answers `[comment, node]`, both ""
; when the lines are unknown.
(pub :: asmSrcloc (-> CG String String Strings))
(pub fn (asmSrcloc cg lines file)
  {
    (let items (asmSplit lines))
    (let out vecNew)
    (if (== (vecLen items) 0)
      {
        (vecPush out "")
        (vecPush out "")
        out
      }
      {
        (let first (+ (cgAsmCookie cg) 1))
        (let k (asmFileIndex cg file))
        (let cookies vecNew)
        {
          (cgSetAsmCookie cg (+ (cgAsmCookie cg) (vecLen items)))
          (for i in 0..(vecLen items)
            (vecPush cookies (concat "i64 " (fmtInt (+ first i)))))
          (vecPush out
            (concat (concat (concat "  ; axiom-asm-site " (fmtInt first)) (concat " " (fmtInt k)))
              (concat " " (strJoin items " "))))
          (vecPush out (concat (concat ", !srcloc !{" (strJoin cookies ", ")) "}"))
          out
        }
      })
  })

(pub :: emitAsmArm (-> String Ints Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitAsmArm desc f args cg)
  {
    (let t (cgTarget cg))
    (let flags (asmField desc f 1))
    (let nOut (asmFieldInt desc f 3))
    (let ans (asmFieldInt desc f 4))
    (let outs (asmSplit (asmField desc f 5)))
    (let tmpl (strSlice desc (vecGet f 18) (vecGet f 19)))
    (let argText (asmInputArgs (asmField desc f 6) args cg))
    (let loc (asmSrcloc cg (asmField desc f 7) (strSlice desc (vecGet f 16) (vecGet f 17))))
    {
      (let cons (asmConstraints t flags (asmField desc f 2)))
      (let body (escBody tmpl 0 (strLen tmpl)))
      (let ty (asmResultTy nOut))
      (let kw
        (concat
          (if (asmHasFlag flags 112)
            ""
            "sideeffect ")
          (concat
            (if (asmHasFlag flags 115)
              ""
              "alignstack ")
            (if (asmHasFlag flags 105)
              "inteldialect "
              ""))))
      {
        (let callText
          (concat (concat (concat "call " ty) (concat " asm " kw))
            (concat (concat "\"" body)
              (concat (concat "\", \"" cons)
                (concat (concat "\"(" argText)
                  (concat ") " (concat (asmAttrs flags) (vecGetStr loc 1))))))))
        (let r
          (if (== nOut 0)
            ""
            (regStr (allocReg cg))))
        {
          (if (> (strLen (vecGetStr loc 0)) 0)
            (emitLine cg (vecGetStr loc 0)))
          (emitLine cg
            (if (== nOut 0)
              (concat "  " callText)
              (concat (concat (concat "  " r) " = ") callText)))
          {
            (let res
              (if (< ans 0)
                (constStr 0)
                (asmOutput cg r ty nOut ans)))
            (let mut i 0)
            {
              (while (< i (vecLen outs))
                {
                  (let pair (vecGetStr outs i))
                  {
                    (asmStoreInto cg r ty nOut pair args)
                    (set i (+ i 1))
                  }
                })
              (if (asmHasFlag flags 110)
                {
                  (emitLine cg "  unreachable")
                  (emitLabel cg (concat "asmnr" (fmtInt (allocReg cg))))
                })
              (cgSetResult cg res)
              (cgSetResultFloat cg 0)
              cg
            }
          }
        }
      }
    }
  })

; The call's type: nothing, one word, or a struct of words.
(pub :: asmResultTy (-> Int String))
(pub fn (asmResultTy n)
  (if (== n 0)
    "void"
    (if (== n 1)
      "i64"
      (concat (concat "{ " (asmWords n)) " }"))))

(pub :: asmWords (-> Int String))
(pub fn (asmWords n)
  {
    (let words vecNew)
    (let count
      (if (<= n 1)
        1
        n))
    {
      (for k in 0..count
        (vecPush words "i64"))
      (strJoin words ", ")
    }
  })

; Output `k` of the call whose result is `r`: `r` itself when it is the
; only one, else an `extractvalue`.
(pub :: asmOutput (-> CG String String Int Int String))
(pub fn (asmOutput cg r ty nOut k)
  (if (== nOut 1)
    r
    {
      (let x (regStr (allocReg cg)))
      {
        (emitLine cg
          (concat (concat (concat "  " x) " = extractvalue ")
            (concat (concat ty " ") (concat (concat r ", ") (fmtInt k)))))
        x
      }
    }))

; `k:i`: output k is stored in the `mut` binding the call's argument i
; names, a `(set slot 0)` the checker has held to a `mut` `Int` this
; frame may assign. The `0` is never evaluated.
(pub :: asmStoreInto (-> CG String String Int String Nodes Int))
;@axiom:effect(io)
(pub fn (asmStoreInto cg r ty nOut pair args)
  {
    (let colon
      (if (let (Some c) (strFindByte pair 58 0))
        c
        0))
    (let k (asmDigits pair (- 0 1) colon))
    (let node (vecGet args (+ (asmDigits pair colon (strLen pair)) 1)))
    {
      (let name (nodeAName node))
      (let kind (lookupSymKind cg (nodeAName node)))
      (let storage
        (if (|| (== kind 1) (== kind 4))
          (symIndex cg name)
          None))
      (if (let (Some storageIdx) storage)
        {
          (emitLine cg
            (concat (concat "  store i64 " (asmOutput cg r ty nOut k))
              (concat ", ptr " (symRegAt cg storageIdx))))
          0
        }
        (dieCodegenDiag "an `asm` output's `into` target is not a mut binding: " name))
    }
  })

; AX4008's marker for a form with no arm this target runs.
(pub :: emitAsmRefused (-> CG String CG))
(pub fn (emitAsmRefused cg arch)
  {
    (emitLine cg
      (concat (concat "  ; axiom-device-refused an `asm` form has no `" arch)
        (concat (concat "` arm, and " (targetSpelling (cgTarget cg)))
          (concat " is an " (concat arch " target")))))
    (cgSetResult cg (constStr 0))
    cg
  })

; The inline-assembly sequence takes the syscall number and six argument
; registers, so a call with fewer arguments is padded with zeros.
(pub :: emitPrimSyscall (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimSyscall args cg)
  {
    (let cg1 (emitArgsList args cg 0))
    (let at (cgArgsTyped cg1))
    (let pad (padZeros (- 7 (vecLen args))))
    (let rn (allocReg cg1))
    {
      (let r (regStr rn))
      {
        ; On a target with no syscall ABI the primitive is a TRAP, not
        ; a wrong instruction: `__axiom_no_syscall` writes a sentence to
        ; fd 2 and exits 74 (`emitWinRuntime`). The arguments were
        ; evaluated above for their effects and are dropped. This is
        ; what `Sys.ax`'s syscall arms compile to on both Windows
        ; targets, where `Sys.Platform.usesSyscallAbi` is 0 and keeps them
        ; unreached; a program that calls `__syscallN` itself reaches
        ; it and dies saying why, rather than executing a `syscall`
        ; instruction the OS gives no meaning to.
        (if (== (targetUsesSyscallAsm (cgTarget cg1)) 1)
          (emitLine cg1
            (concat
              (concat (concat "  " r)
                (concat
                  (concat " = call i64 asm sideeffect "
                    (concat (targetSyscallAsm (cgTarget cg1)) (concat "(i64 " "")))
                  at))
              (concat pad (concat ")" ""))))
          (emitLine cg1 (concat (concat "  " r) (concat " = call i64 @__axiom_no_syscall()" ""))))
        (cgSetResult cg1 r)
        cg1
      }
    }
  })

(pub :: padZeros (-> Int String))
(pub fn (padZeros n)
  {
    (let b strBuilderNew)
    {
      (for k in 0..n
        (strBuilderPush b ", i64 0"))
      (strBuilderFinish b)
    }
  })

(pub :: emitPrimAlloc (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAlloc args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let n (strDup (cgResult cg1)))
    (let rn (allocReg cg1))
    {
      (let r (regStr rn))
      {
        (emitLine cg1
          (concat (concat "  " r) (concat " = call i64 @axiom_alloc(i64 " (concat n ")"))))
        (cgSetResult cg1 r)
        cg1
      }
    }
  })

; The element type is what makes `__load8` and `__load64` differ: both
; index from a base, but one steps a byte and the other a word, and the
; byte form has to widen to a machine word on the way out.
(pub :: elemTy (-> Int String))
(pub fn (elemTy width)
  (if (== width 8)
    "i64"
    "i8"))

(pub :: emitPrimLoad (-> Nodes CG Int CG))
;@axiom:effect(io)
(pub fn (emitPrimLoad args cg width)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let base (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let idx (strDup (cgResult cg2)))
    (let ty (elemTy width))
    (let pn (allocReg cg2))
    {
      (let pr (regStr pn))
      {
        (let cg3
          (emitLine cg2
            (concat (concat "  " pr) (concat " = inttoptr i64 " (concat base " to ptr")))))
        {
          (let gn (allocReg cg3))
          {
            (let gr (regStr gn))
            {
              (let cg4
                (emitLine cg3
                  (concat (concat (concat "  " gr) (concat " = getelementptr " ty))
                    (concat (concat ", ptr " (concat pr ", i64 ")) (concat idx "")))))
              {
                (let vn (allocReg cg4))
                {
                  (let vr (regStr vn))
                  {
                    (let cg5
                      (emitLine cg4
                        (concat (concat (concat "  " vr) (concat " = load " ty))
                          (concat ", ptr " (concat gr "")))))
                    (if (== width 8)
                      {
                        (cgSetResult cg5 vr)
                        cg5
                      }
                      {
                        (let wn (allocReg cg5))
                        {
                          (let wr (regStr wn))
                          {
                            (emitLine cg5
                              (concat (concat "  " wr)
                                (concat " = zext i8 " (concat vr " to i64"))))
                            (cgSetResult cg5 wr)
                            cg5
                          }
                        }
                      })
                  }
                }
              }
            }
          }
        }
      }
    }
  })

(pub :: emitPrimStore (-> Nodes CG Int Int CG))
;@axiom:effect(io)
(pub fn (emitPrimStore args cg width vol)
  ; A byte store needs the value narrowed first; a word store
  ; takes it as it stands. `vol` is 1 for `__store8v`, whose
  ; `volatile` keeps every store against a middle end that would
  ; otherwise delete MMIO writes it can prove are never read; it is
  ; 0 for the ordinary stores, which must stay foldable.
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let base (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let idx (strDup (cgResult cg2)))
    (let cg3 (emitExpr (vecGet args 2) cg2))
    (let val (strDup (cgResult cg3)))
    (let ty (elemTy width))
    (let pn (allocReg cg3))
    {
      (let pr (regStr pn))
      {
        (let cg4
          (emitLine cg3
            (concat (concat "  " pr) (concat " = inttoptr i64 " (concat base " to ptr")))))
        {
          (let gn (allocReg cg4))
          {
            (let gr (regStr gn))
            {
              (let cg5
                (emitLine cg4
                  (concat (concat (concat "  " gr) (concat " = getelementptr " ty))
                    (concat (concat ", ptr " (concat pr ", i64 ")) (concat idx "")))))
              {
                (let sv
                  (if (== width 8)
                    val
                    (narrowByte cg5 val)))
                {
                  (emitLine cg5
                    (concat
                      (concat
                        (if (== vol 1)
                          "  store volatile "
                          "  store ")
                        (concat ty " "))
                      (concat sv (concat (concat ", ptr " gr) ""))))
                  (cgSetResult cg5 (constStr 0))
                  cg5
                }
              }
            }
          }
        }
      }
    }
  })

(pub :: narrowByte (-> CG String String))
(pub fn (narrowByte cg val)
  {
    (let tn (allocReg cg))
    {
      (let tr (regStr tn))
      {
        (emitLine cg (concat (concat "  " tr) (concat " = trunc i64 " (concat val " to i8"))))
        tr
      }
    }
  })

; `(__addr "text")` is the only way a literal's bytes reach the program.
; The literal is interned into the module's string table and referenced
; by the global the table will emit. A NON-literal argument is refused
; upstream as AX3072 (`addr-nonliteral`): it would evaluate like any
; expression and answer the value's address, not interned bytes.
; Every use in this repository spells the literal
; (`grep -rn '__addr' stdlib/ tests/`); what follows is what a literal
; takes, and the other arm is now unreachable from checked programs
; rather than a quiet wrong answer.
(pub :: emitPrimAddr (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimAddr args cg)
  {
    (let node (vecGet args 0))
    (if (!= (nodeTag node) TAG_E_STR)
      (emitExpr node cg)
      {
        (let id (internString cg (nodeAName node)))
        (let rn (allocReg cg))
        {
          (let r (regStr rn))
          {
            (emitLine cg
              (concat (concat "  " r)
                (concat " = ptrtoint ptr @str_" (concat (fmtInt id) " to i64"))))
            (cgSetResult cg r)
            cg
          }
        }
      })
  })

(pub :: isCastName (-> String Bool))
(pub fn (isCastName nm)
  (|| (strEq nm "cast") (strEq nm "__ascribe")))

(pub :: reverseVec (-> (Vec a) (Vec a)))
(pub fn (reverseVec v)
  (reverseInto v (- (vecLen v) 1) vecNew))

(pub :: reverseInto (-> (Vec a) Int (Vec a) (Vec a)))
(pub fn (reverseInto v i acc)
  (if (< i 0)
    acc
    (reverseInto v (- i 1) (vecPush acc (vecGet v i)))))

; A spine may supply MORE arguments than the callee declares, and
; `((adder 10) 5)` is the shape: `adder` takes one parameter and
; returns a closure, so the surplus argument belongs to that closure,
; not to `adder`. Flattening the whole spine into one direct call
; passed both to `adder` - which read the second from a register it
; never declared - and answered with the returned closure's ADDRESS
; (tests/stdlib/140-function-values.ax). Every function value absorbs
; exactly one argument per call, which is the rule stage0 settled on
; for the identical bug on its own side.
;
; The arity gate is `isDefinedFn`, not `fnArityOf` alone: an unknown
; name answers arity 0, and treating every builtin and binary operator
; as over-applied would route `(+ a b)` through a closure record that
; does not exist.
;
; Both are asked through `buildNameIndexes` (`…Cg`), because both are
; asked for every call this emitter writes, and both used to walk the
; whole merged declaration list to answer.
(pub :: emitOverApplied (-> String Nodes ASTNode CG Ints ASTNode CG))
;@axiom:effect(io)
(pub fn (emitOverApplied fnName args stamp cg evs snode)
  ; Asked by the MANGLED name: the index holds each declaration under
  ; its own spelling, which for an imported function is `Mod$name`.
  ; Asked by the bare name, an imported callee was never found, so
  ; `((vecGet v 0) 41)` passed the 41 to `vecGet` itself and answered
  ; an address (tests/stdlib/848-over-apply-imported.ax).
  (if (isDefinedFnCg cg (mangledForCg cg fnName))
    {
      (let ar (fnArityOfCg cg (mangledForCg cg fnName)))
      (if (|| (<= (vecLen args) ar) (== ar 0))
        (emitCall fnName args stamp cg snode)
        ; The surplus is applied through a closure, so it needs the
        ; classes `walkAppChain` recorded - dropped by the same
        ; arity the arguments were, because the two vectors are one
        ; reversal of the same spine and must stay aligned.
        {
          (let cgD (emitCall fnName (takeVec args ar) stamp cg snode))
          (emitApplyChain (dropVec args ar) cgD (strDup (cgResult cgD)) 0 (dropVec evs ar) snode)
        })
    }
    (emitCall fnName args stamp cg snode)))

(pub :: takeVec (-> (Vec a) Int (Vec a)))
(pub fn (takeVec v n)
  (takeInto v n 0 vecNew))

(pub :: takeInto (-> (Vec a) Int Int (Vec a) (Vec a)))
(pub fn (takeInto v n i acc)
  (if (>= i n)
    acc
    (takeInto v n (+ i 1) (vecPush acc (vecGet v i)))))

(pub :: dropVec (-> (Vec a) Int (Vec a)))
(pub fn (dropVec v n)
  (dropInto v n vecNew))

(pub :: dropInto (-> (Vec a) Int (Vec a) (Vec a)))
(pub fn (dropInto v i acc)
  (if (>= i (vecLen v))
    acc
    (dropInto v (+ i 1) (vecPush acc (vecGet v i)))))

; Emit regular call: check binops/comparisons first.
(pub :: emitCall (-> String Nodes ASTNode CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitCall fnName args stamp cg snode)
  (if (&& (== (vecLen args) 2) (> (nodeIntegerOp snode) 0))
    (emitIntegerOperation fnName args cg snode (nodeIntegerOp snode))
    (if (&& (== (vecLen args) 2) (isBinop fnName))
      (emitBinop2 fnName args cg snode)
      (if (&& (== (vecLen args) 2) (isCmpOp fnName))
        (emitCmp2 fnName args cg)
        ; `(- x)` used to be rewritten to `0 - x` here, which is what stage0
        ; does at PARSE time - and that is where stage1 does it now
        ; (`unaryMinusToBinary`). Doing it in the emitter meant the type
        ; checker still met a two-parameter builtin supplied with one
        ; argument, and reported AX3013 partial-application on a program
        ; stage0 compiles: the form was handled at the end of the pipeline and
        ; absent at the front, so nothing that reached here ever got here.
        (emitPlainCall fnName args stamp cg snode)))))

; An operator's spelling depends on its operands - `fadd` against
; `add` - so the two are evaluated one at a time and their float flags
; captured, where a plain call can take the whole argument list at
; once. The checker requires both operands to have the same numeric
; type. Refuse a disagreement here too: interpreting integer bits as
; a double would hide a checker or float-metadata bug.
(pub :: emitBinop2 (-> String Nodes CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitBinop2 fnName args cg snode)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let a (strDup (cgResult cg1)))
      (let af (cgResultFloat cg1))
      {
        (let cg2 (emitExpr (vecGet args 1) cg1))
        {
          (let b (strDup (cgResult cg2)))
          (let bf (cgResultFloat cg2))
          (if (!= af bf)
            (cgFail cg "mixed Int/Float operands reached code generation: " fnName)
            (if (== af 1)
              (emitFBinop fnName a b cg2)
              (emitIBinop fnName a b cg2 snode)))
        }
      }
    }
  })

; `sdiv`/`srem` by zero is UNDEFINED in LLVM, and the two targets
; disagree about what undefined looks like: on darwin-aarch64
; `(/ 10 0)` printed 1 at exit 0, and the same IR on linux-x86_64
; lowers to `idiv`, which raises SIGFPE. Same source, two behaviours,
; and `check` had nothing to say about either.
;
; Guarded now: a compare and a branch to a shared trap that names the
; fault on fd 2 and exits 72. One predictable branch, paid only by
; `/` and `%`.
; Narrow arithmetic uses real LLVM integer widths. Canonical words are
; sign-extended for signed types and zero-extended for unsigned types.
(pub :: emitIntegerNarrow (-> CG String Int String))
(pub fn (emitIntegerNarrow cg value bits)
  (if (== bits 64)
    value
    {
      (let r (regStr (allocReg cg)))
      {
        (emitLine cg
          (concat "  "
            (concat r (concat " = trunc i64 " (concat value (concat " to i" (fmtInt bits)))))))
        r
      }
    }))

(pub :: emitIntegerExtend (-> CG String Int CG))
(pub fn (emitIntegerExtend cg value code)
  {
    (let bits (integerBits code))
    {
      (cgSetResultFloat cg 0)
      (if (== bits 64)
        (cgSetResult cg value)
        {
          (let r (regStr (allocReg cg)))
          {
            (emitLine cg
              (concat "  "
                (concat r
                  (concat
                    (if (integerUnsigned code)
                      " = zext i"
                      " = sext i")
                    (concat (fmtInt bits) (concat " " (concat value " to i64")))))))
            (cgSetResult cg r)
          }
        })
      cg
    }
  })

(pub :: emitIntegerConversion (-> CG Int CG))
(pub fn (emitIntegerConversion cg conversion)
  {
    (let from (/ conversion 256))
    (let to (% conversion 256))
    (let value (strDup (cgResult cg)))
    (if (== to 129)
      {
        (let d (regStr (allocReg cg)))
        (let r (regStr (allocReg cg)))
        {
          (emitLine cg
            (concat "  "
              (concat d
                (concat
                  (if (integerUnsigned from)
                    " = uitofp i64 "
                    " = sitofp i64 ")
                  (concat value " to double")))))
          (emitLine cg (concat "  " (concat r (concat " = bitcast double " (concat d " to i64")))))
          (cgSetResult cg r)
          (cgSetResultFloat cg 1)
          cg
        }
      }
      (if (== from 129)
        {
          (let bits (integerBits to))
          (let d (regStr (allocReg cg)))
          (let r (regStr (allocReg cg)))
          (let ty (concat "i" (fmtInt (integerBits to))))
          {
            (emitLine cg
              (concat "  " (concat d (concat " = bitcast i64 " (concat value " to double")))))
            (emitLine cg
              (concat "  "
                (concat r
                  (concat " = call "
                    (concat ty
                      (concat
                        (if (integerUnsigned to)
                          " @llvm.fptoui.sat."
                          " @llvm.fptosi.sat.")
                        (concat ty (concat ".f64(double " (concat d ")")))))))))
            (emitIntegerExtend cg r to)
          }
        }
        (emitIntegerExtend cg (emitIntegerNarrow cg value (integerBits to)) to)))
  })

(pub :: integerMinWord (-> Int Int))
(pub fn (integerMinWord bits)
  (if (== bits 64)
    (- (- 0 9223372036854775807) 1)
    (- 0 (<< 1 (- bits 1)))))

(pub :: integerLLVMOp (-> String Int String))
(pub fn (integerLLVMOp op code)
  (if (integerUnsigned code)
    (if (strEq op "/")
      "udiv"
      (if (strEq op "%")
        "urem"
        (if (strEq op ">>")
          "lshr"
          (binopToLLVM op))))
    (binopToLLVM op)))

(pub :: integerLLVMCmp (-> String Int String))
(pub fn (integerLLVMCmp op code)
  (if (integerUnsigned code)
    (if (strEq op "<")
      "ult"
      (if (strEq op ">")
        "ugt"
        (if (strEq op "<=")
          "ule"
          (if (strEq op ">=")
            "uge"
            (cmpToLLVM op)))))
    (cmpToLLVM op)))

(pub :: emitIntegerOperation (-> String Nodes CG ASTNode Int CG))
;@axiom:effect(io)
(pub fn (emitIntegerOperation op args cg snode code)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let a (strDup (cgResult cg1)))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let b (strDup (cgResult cg2)))
    (let bits (integerBits code))
    (let ty (concat "i" (fmtInt bits)))
    (let cg3
      (if (isDivOp op)
        (emitDivGuardWidth a b cg2 snode bits (integerUnsigned code) (strEq op "%"))
        (if (isShiftOp op)
          (emitShiftGuardWidth b cg2 snode bits)
          cg2)))
    (let an (emitIntegerNarrow cg3 a bits))
    (let bSafe
      (if (&& (strEq op "%") (! (integerUnsigned code)))
        {
          (let cmp (regStr (allocReg cg3)))
          (let sel (regStr (allocReg cg3)))
          {
            (emitLine cg3 (concat (concat "  " cmp) (concat " = icmp eq i64 " (concat b ", -1"))))
            (emitLine cg3
              (concat (concat "  " sel)
                (concat (concat " = select i1 " cmp) (concat ", i64 1, i64 " b))))
            sel
          }
        }
        b))
    (let bn (emitIntegerNarrow cg3 bSafe bits))
    (let r (regStr (allocReg cg3)))
    (if (isCmpOp op)
      {
        (emitLine cg3
          (concat "  "
            (concat r
              (concat " = icmp "
                (concat (integerLLVMCmp op code)
                  (concat " " (concat ty (concat " " (concat an (concat ", " bn))))))))))
        {
          (let word (regStr (allocReg cg3)))
          {
            (emitLine cg3 (concat "  " (concat word (concat " = zext i1 " (concat r " to i64")))))
            (cgSetResult cg3 word)
            (cgSetResultFloat cg3 0)
            cg3
          }
        }
      }
      {
        (emitLine cg3
          (concat "  "
            (concat r
              (concat " = "
                (concat (integerLLVMOp op code)
                  (concat " " (concat ty (concat " " (concat an (concat ", " bn))))))))))
        (emitIntegerExtend cg3 r code)
      })
  })

(pub :: emitIBinop (-> String String String CG ASTNode CG))
(pub fn (emitIBinop fnName a b cg snode)
  ; U4: `binopToLLVM` answers "add" for a name it does not know (pinned
  ; by `check-mir.sh` §7), so a name that is no operator would lower to
  ; an addition in silence. `emitCall` routes here through `isBinop`,
  ; which makes this arm dead - until someone extends one table and not
  ; the other, or a checker hole admits a bad name (H6's worry). Then
  ; it traps instead of adding.
  (if (isBinop fnName)
    {
      (let cgG
        (if (isDivOp fnName)
          (emitDivGuardWidth a b cg snode 64 false (strEq fnName "%"))
          (if (isShiftOp fnName)
            (emitShiftGuard b cg snode)
            cg)))
      {
        (let rn (allocReg cgG))
        {
          (let r (regStr rn))
          (let bSafe
            (if (strEq fnName "%")
              {
                (let cmp (regStr (allocReg cgG)))
                (let sel (regStr (allocReg cgG)))
                {
                  (emitLine cgG
                    (concat (concat "  " cmp) (concat " = icmp eq i64 " (concat b ", -1"))))
                  (emitLine cgG
                    (concat (concat "  " sel)
                      (concat (concat " = select i1 " cmp) (concat ", i64 1, i64 " b))))
                  sel
                }
              }
              b))
          {
            (emitLine cgG
              (concat (concat (concat "  " r) (concat " = " (binopToLLVM fnName)))
                (concat " i64 " (concat (concat a (concat ", " bSafe)) ""))))
            (cgSetResult cgG r)
            (cgSetResultFloat cgG 0)
            cgG
          }
        }
      }
    }
    (emitUnknownBinopTrap cg 0)))

; U4's trap: `unreachable` in its own dead block, then a zero filler so
; the answer register stays defined and the IR stays valid. Reached
; only if the operator tables disagree - which the guards above make
; impossible today - so reaching it crashes loudly rather than adding
; quietly.
(pub :: emitUnknownBinopTrap (-> CG Int CG))
(pub fn (emitUnknownBinopTrap cg floatFlag)
  {
    (let db (concat "dead_" (fmtInt (allocReg cg))))
    {
      (let rn (allocReg cg))
      {
        (let r (regStr rn))
        {
          (emitLine cg "  unreachable")
          (emitLabel cg db)
          (emitLine cg (concat (concat "  " r) " = add i64 0, 0"))
          (cgSetResult cg r)
          (cgSetResultFloat cg floatFlag)
          cg
        }
      }
    }
  })

(pub :: isFloatBinop (-> String Bool))
(pub fn (isFloatBinop nm)
  (|| (strEq nm "+") (|| (strEq nm "-") (|| (strEq nm "*") (|| (strEq nm "/") (strEq nm "%"))))))

(pub :: isDivOp (-> String Bool))
(pub fn (isDivOp nm)
  (|| (strEq nm "/") (strEq nm "%")))

(pub :: isShiftOp (-> String Bool))
(pub fn (isShiftOp nm)
  (|| (strEq nm "<<") (strEq nm ">>")))

; `if divisor == 0 then trap 72; if INT_MIN / -1 then trap 83`. The
; second test is the overflow corner `sdiv`/`srem` share, which has no
; representable answer (MM-VAL-3b): two compares and an `and`, paid
; only by `/` and `%`, which already pay the first branch. Each trap
; block ends `unreachable`, so nothing downstream has to know either
; is there.
;
; `isRem` skips the overflow trap: a remainder by -1 is 0 for every
; dividend, so the caller rewrites that divisor to 1 and `srem` never
; sees its one overflowing pair. `/` keeps the trap (AX83).
(pub :: emitDivGuardWidth (-> String String CG ASTNode Int Bool Bool CG))
(pub fn (emitDivGuardWidth a b cg snode bits unsigned isRem)
  {
    (let c0 (regStr (allocReg cg)))
    (let c1 (regStr (allocReg cg)))
    (let c2 (regStr (allocReg cg)))
    (let c3 (regStr (allocReg cg)))
    (let zb (concat "divzero_" (fmtInt (allocReg cg))))
    (let chk (concat "divovfchk_" (fmtInt (allocReg cg))))
    (let ob (concat "divovf_" (fmtInt (allocReg cg))))
    (let kb (concat "divok_" (fmtInt (allocReg cg))))
    {
      (emitLine cg (concat (concat "  " c0) (concat " = icmp eq i64 " (concat b ", 0"))))
      (emitLine cg
        (concat (concat "  br i1 " (concat c0 ", label %"))
          (concat zb (concat (concat ", label %" chk) ""))))
      (emitLabel cg zb)
      (emitLineMark snode cg)
      (emitLine cg "  call i64 @__axiom_div_by_zero()")
      (emitLine cg "  unreachable")
      (emitLabel cg chk)
      (emitLine cg
        (concat (concat "  " c1)
          (concat " = icmp eq i64 " (concat a (concat ", " (fmtInt (integerMinWord bits)))))))
      (emitLine cg (concat (concat "  " c2) (concat " = icmp eq i64 " (concat b ", -1"))))
      (emitLine cg
        (concat (concat "  " c3)
          (if (|| unsigned isRem)
            " = and i1 false, false"
            (concat " = and i1 " (concat c1 (concat ", " c2))))))
      (emitLine cg
        (concat (concat "  br i1 " (concat c3 ", label %"))
          (concat ob (concat (concat ", label %" kb) ""))))
      (emitLabel cg ob)
      (emitLineMark snode cg)
      (emitLine cg "  call i64 @__axiom_div_overflow()")
      (emitLine cg "  unreachable")
      (emitLabel cg kb)
      cg
    }
  })

; `if amount < 0 or >= 64 then trap 84`. Overshift is poison in LLVM
; (`shl`/`ashr` demand an amount below the bit width, and a negative
; count is a huge unsigned one), and the two targets disagreed about
; it exactly as they once did about division by zero (MM-VAL-3b) - so
; it traps exactly like division by zero does. Paid only by `<<` and
; `>>`.
(pub :: emitShiftGuard (-> String CG ASTNode CG))
(pub fn (emitShiftGuard n cg snode)
  (emitShiftGuardWidth n cg snode 64))

(pub :: emitShiftGuardWidth (-> String CG ASTNode Int CG))
(pub fn (emitShiftGuardWidth n cg snode bits)
  {
    (let c0 (regStr (allocReg cg)))
    (let c1 (regStr (allocReg cg)))
    (let c2 (regStr (allocReg cg)))
    (let sb (concat "shiftbad_" (fmtInt (allocReg cg))))
    (let kb (concat "shiftok_" (fmtInt (allocReg cg))))
    {
      (emitLine cg (concat (concat "  " c0) (concat " = icmp slt i64 " (concat n ", 0"))))
      (emitLine cg
        (concat (concat "  " c1)
          (concat " = icmp sge i64 " (concat n (concat ", " (fmtInt bits))))))
      (emitLine cg (concat (concat "  " c2) (concat " = or i1 " (concat c0 (concat ", " c1)))))
      (emitLine cg
        (concat (concat "  br i1 " (concat c2 ", label %"))
          (concat sb (concat (concat ", label %" kb) ""))))
      (emitLabel cg sb)
      (emitLineMark snode cg)
      (emitLine cg "  call i64 @__axiom_shift_out_of_range()")
      (emitLine cg "  unreachable")
      (emitLabel cg kb)
      cg
    }
  })

; The operands hold bits; the arithmetic wants a double. `bitcast` in,
; one float instruction, `bitcast` back out - free at runtime, and the
; register allocator keeps a chain of them in FP registers.
(pub :: emitFBinop (-> String String String CG CG))
(pub fn (emitFBinop fnName a b cg)
  ; U4: `fbinopToLLVM` answers "fadd" for a name it does not know, so a
  ; bitwise operator over floats would lower to a float addition in
  ; silence. The checker refuses those (`&` demands `Int` operands),
  ; which makes this arm dead - until a checker hole admits one (H6's
  ; worry). Then it traps instead of adding.
  (if (isFloatBinop fnName)
    {
      (let an (allocReg cg))
      (let bn (allocReg cg))
      (let mn (allocReg cg))
      (let rn (allocReg cg))
      {
        (let ar (tmpStr "d" an))
        (let br (tmpStr "d" bn))
        (let fr (tmpStr "d" mn))
        (let r (regStr rn))
        {
          (emitLine cg (concat (concat "  " ar) (concat " = bitcast i64 " (concat a " to double"))))
          (emitLine cg (concat (concat "  " br) (concat " = bitcast i64 " (concat b " to double"))))
          (emitLine cg
            (concat (concat (concat "  " fr) (concat " = " (fbinopToLLVM fnName)))
              (concat " double " (concat (concat ar (concat ", " br)) ""))))
          (emitLine cg (concat (concat "  " r) (concat " = bitcast double " (concat fr " to i64"))))
          (cgSetResult cg r)
          (cgSetResultFloat cg 1)
          cg
        }
      }
    }
    (emitUnknownBinopTrap cg 1)))

(pub :: emitCmp2 (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitCmp2 fnName args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    {
      (let a (strDup (cgResult cg1)))
      (let af (cgResultFloat cg1))
      {
        (let cg2 (emitExpr (vecGet args 1) cg1))
        {
          (let b (strDup (cgResult cg2)))
          (let bf (cgResultFloat cg2))
          (if (!= af bf)
            (cgFail cg "mixed Int/Float operands reached code generation: " fnName)
            (if (== af 1)
              (emitFCmp fnName a b cg2)
              (emitICmp fnName a b cg2)))
        }
      }
    }
  })

(pub :: emitICmp (-> String String String CG CG))
(pub fn (emitICmp fnName a b cg)
  {
    (let cn (allocReg cg))
    (let rn (allocReg cg))
    {
      (let cr (tmpStr "c" cn))
      (let r (regStr rn))
      {
        (emitLine cg
          (concat (concat (concat "  " cr) (concat " = icmp " (cmpToLLVM fnName)))
            (concat " i64 " (concat (concat a (concat ", " b)) ""))))
        (emitLine cg (concat (concat "  " r) (concat " = zext i1 " (concat cr " to i64"))))
        (cgSetResult cg r)
        (cgSetResultFloat cg 0)
        cg
      }
    }
  })

; Ordered comparisons, so a NaN operand compares false - the same
; choice stage0 makes.
(pub :: emitFCmp (-> String String String CG CG))
(pub fn (emitFCmp fnName a b cg)
  {
    (let an (allocReg cg))
    (let bn (allocReg cg))
    (let cn (allocReg cg))
    (let rn (allocReg cg))
    {
      (let ar (tmpStr "d" an))
      (let br (tmpStr "d" bn))
      (let cr (tmpStr "c" cn))
      (let r (regStr rn))
      {
        (emitLine cg (concat (concat "  " ar) (concat " = bitcast i64 " (concat a " to double"))))
        (emitLine cg (concat (concat "  " br) (concat " = bitcast i64 " (concat b " to double"))))
        (emitLine cg
          (concat (concat (concat "  " cr) (concat " = fcmp " (fcmpToLLVM fnName)))
            (concat " double " (concat (concat ar (concat ", " br)) ""))))
        (emitLine cg (concat (concat "  " r) (concat " = zext i1 " (concat cr " to i64"))))
        (cgSetResult cg r)
        (cgSetResultFloat cg 0)
        cg
      }
    }
  })

(pub :: emitPlainCall (-> String Nodes ASTNode CG ASTNode CG))
;@axiom:effect(io)
(pub fn (emitPlainCall fnName args stamp cg snode)
  ; The callee's defining module may have renamed it - a bare
  ; reference reaches whatever symbol the map says (entry file
  ; first, then first import). Operators and primitives never
  ; enter the map, so `full` is `fnName` for them. Asked through
  ; `mangledForCg`, which answers the same question off
  ; `buildNameIndexes`' Intern rather than by walking all 1,600
  ; bare names - this runs once per emitted call.
  ; MM-LIFE-2d: presence of the hidden argument is SIG-driven -
  ; every call to a polymorphic callee passes a word even when no
  ; stamp survived (a demoted shared-node stamp) - and only the
  ; VALUE is stamp-driven, so a
  ; missing stamp means constant 0, never a missing argument.
  ; CAPTURED AND DISARMED BEFORE THE ARGUMENTS. A call inside an
  ; argument reaches this same function, and would otherwise consume
  ; the token the match site armed for the OUTERMOST call. Each
  ; invocation takes its own copy and restores it for its own call
  ; line, so nesting cannot steal it.
  ; The musttail token is taken the same way and for the same reason
  ; (`armMustTail` set it for THIS call; a call inside an argument
  ; must not read it).
  {
    (let argRegs vecNew)
    {
      (let armed (cgPairArm cg))
      (let mt0 (cgTailOK cg))
      {
        (let _dis (cgSetPairArm cg 0))
        (let _mtc (cgSetTailOK cg 0))
        {
          (let bc0 (borrowedFromOwnedClass cg snode))
          (let argStrCg (emitArgsRegs args cg argRegs 0 fnName bc0))
          {
            (let argStrT (strDup (cgArgsTyped argStrCg)))
            (let full (mangledForCg argStrCg fnName))
            {
              (let takesEv (fnTakesEvw argStrCg full))
              {
                (let cgE
                  (if (== takesEv 1)
                    (emitEvWordVal argStrCg stamp)
                    argStrCg))
                {
                  (let evStr
                    (if (== takesEv 1)
                      (concat ", i64 " (strDup (cgResult cgE)))
                      ""))
                  {
                    (let rn (allocReg cgE))
                    {
                      (let r (regStr rn))
                      {
                        (let isPair (pairNamesHas (pairNames cgE) full))
                        (if (&& (== isPair 1) (== armed 1))
                          ; The register-pair form. `releaseOwnedArgs` still
                          ; runs, so the temporaries an argument built are
                          ; handed back exactly as they are for the boxed
                          ; call - which is the whole reason this is a seam
                          ; here rather than a second call emitter.
                          {
                            (let tr (regStr (allocReg cgE)))
                            (let pr (regStr (allocReg cgE)))
                            {
                              (emitCallMark snode cgE rn)
                              (emitLine cgE
                                (concat
                                  (concat (concat "  " r)
                                    (concat " = call { i64, i64 } @"
                                      (concat (llvmSym (strDup full)) "$pair")))
                                  (concat "(i64 " (concat argStrT (concat evStr ")")))))
                              (emitLine cgE
                                (concat (concat "  " tr)
                                  (concat " = extractvalue { i64, i64 } " (concat r ", 0"))))
                              (emitLine cgE
                                (concat (concat "  " pr)
                                  (concat " = extractvalue { i64, i64 } " (concat r ", 1"))))
                              (releaseOwnedArgs cgE fnName args argRegs 0)
                              (cgSetResult cgE pr)
                              (cgSetResultFloat cgE 0)
                              (cgSetPairTagReg cgE tr)
                              (cgSetPairArm cgE 2)
                              cgE
                            }
                          }
                          (if (== isPair 1)
                            ; A pair function called ANYWHERE ELSE - a `let`
                            ; that outlives the match, an argument, a field
                            ; store, a statement - answers its two registers
                            ; and is boxed HERE, in the caller's definition.
                            ; That is where the allocation now sits and where
                            ; the checker charges it (`walkCallHead`'s pair
                            ; clause): the callee's body allocates nothing on
                            ; any path, so its `no-alloc` claim is its own.
                            {
                              (emitCallMark snode cgE rn)
                              (emitLine cgE
                                (concat
                                  (concat (concat "  " r)
                                    (concat " = call { i64, i64 } @"
                                      (concat (llvmSym (strDup full)) "$pair")))
                                  (concat "(i64 " (concat argStrT (concat evStr ")")))))
                              (releaseOwnedArgs cgE fnName args argRegs 0)
                              (if (let (Some signature) (findFSigCg cgE full))
                                (emitPairBox cgE (requireSignatureResult signature) r)
                                (cgFail cg "missing pair function signature: " full))
                            }
                            (if (== (mustTailOK cgE mt0 takesEv fnName args) 1)
                              ; MM-EXEC-6c: a MUTUAL tail call, guaranteed. The
                              ; call and the `ret` are emitted together, the
                              ; block is marked terminated exactly as a self
                              ; jump marks it, and nothing may come between
                              ; them - `mustTailOK` is the list of everything
                              ; that could have.
                              {
                                ; the owning `mut` slots' scope ends are past
                                ; the jump, so they are paid here, as a self
                                ; tail call pays them; `mustTailOK` holds that
                                ; no argument reaches one
                                (releasePendingSlots cgE (pairOwningSlots cgE) 0)
                                (emitLine cgE
                                  (concat
                                    (concat (concat "  " r)
                                      (concat " = musttail call i64 @" (llvmSym (strDup full))))
                                    (concat "(i64 " (concat argStrT (concat evStr ")")))))
                                (emitLine cgE (concat "  ret i64 " r))
                                (cgSetResult cgE r)
                                (cgSetResultFloat cgE (fnRetIsFloat cgE full))
                                (cgSetTerminated cgE 1)
                                cgE
                              }
                              {
                                (let callInst
                                  (concat
                                    (concat (concat "  " r)
                                      (concat " = call i64 @" (llvmSym (strDup full))))
                                    (concat "(i64 " (concat argStrT (concat evStr ")")))))
                                {
                                  (emitCallMark snode cgE rn)
                                  (emitLine cgE callInst)
                                  ; the temporaries this call consumed, released now that
                                  ; the callee has taken whatever share it keeps
                                  (releaseOwnedArgs cgE fnName args argRegs 0)
                                  ; a result borrowed from an owned temporary
                                  ; takes a share of its own, and the
                                  ; temporary is handed back: the result
                                  ; is transferred from here on
                                  ; (`borrowedFromOwnedClass`)
                                  {
                                    (let bc bc0)
                                    (if (== bc 0)
                                      {
                                        (cgSetResult cgE r)
                                        (cgSetResultFloat cgE (fnRetIsFloat cgE full))
                                        cgE
                                      }
                                      {
                                        (let cgR
                                          (if (== bc 1)
                                            (emitRetainOf cgE r)
                                            (emitRetainIfEvBit cgE r (- bc 2))))
                                        {
                                          (let cgF (releaseBorrowedFrom cgR fnName args argRegs 0))
                                          {
                                            (cgSetResult cgF r)
                                            (cgSetResultFloat cgF (fnRetIsFloat cgF full))
                                            cgF
                                          }
                                        }
                                      })
                                  }
                                }
                              })))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; `emitArgsList` that also records each argument's register, in
; order, into `regs`.
; An argument a call LENDS (`lendClass` 1), such as `(vecGet v 0)` at a
; counted type, is borrowed from its container, and the callee may
; store over the slot it came from: `(f v (vecGet v 0))` where `f`
; overwrites slot 0 and then reads its parameter read a freed block. So
; the argument takes a share as soon as it is evaluated, and
; `releaseOwnedArgs` hands it back after the call, exactly as it does an
; owned temporary's; where the callee keeps the argument, the share
; stays with it. At this function's own type variable (`lendClass`
; `2+k`) both are conditional on bit k of the evidence word, as a
; `let`'s are. A callee whose type-variable result may be the argument
; itself (`borrowedFromOwnedArg`) gets the same share, and the result
; keeps it rather than the call handing it back. `bc` is the call's
; `borrowedFromOwnedClass`, asked before its arguments: the share is
; taken only where `releaseBorrowedFrom` will hand it back, so a call
; whose result is a word, or a type variable at an uncounted type,
; takes none.
(pub :: emitArgsRegs (-> Nodes CG Strings Int String Int CG))
;@axiom:effect(io)
(pub fn (emitArgsRegs args cg regs i fnName bc)
  (if (>= i (vecLen args))
    {
      (cgSetResult cg "")
      (cgSetArgsTyped cg "")
      cg
    }
    {
      (let node (vecGet args i))
      {
        (let cg1 (emitExpr node cg))
        {
          (let reg (strDup (cgResult cg1)))
          {
            (vecPush regs reg)
            {
              (let lent
                {
                  (let l (lendClass cg1 node))
                  (if (!= l 0)
                    l
                    (fieldArgClass cg1 node))
                })
              (if (&& (!= lent 0)
                    (|| (== (argOwnedRelease cg1 fnName args i) 1)
                      (&& (!= bc 0) (== (borrowedFromOwnedArg cg1 fnName args i) 1))))
                (if (== lent 1)
                  (emitRetainOf cg1 reg)
                  (emitRetainIfEvBit cg1 reg (- lent 2)))
                cg1)
            }
            {
              (let restCg (emitArgsRegs args cg1 regs (+ i 1) fnName bc))
              {
                (let rest (cgResult restCg))
                (let restT (cgArgsTyped restCg))
                (if (== (strLen rest) 0)
                  {
                    (cgSetResult restCg reg)
                    (cgSetArgsTyped restCg (strDup reg))
                    restCg
                  }
                  {
                    (cgSetResult restCg (concat reg (concat ", " rest)))
                    (cgSetArgsTyped restCg (concat (strDup reg) (concat ", i64 " restT)))
                    restCg
                  })
              }
            }
          }
        }
      }
    }))

; Whether a call to `name` may write memory that a caller holds a
; reference into: a field `set`, a raw store, a release, a syscall or
; another primitive that is not a pure read, a call through a function
; value or an `extern`, or a call to a function that may. A name with no
; signature may. `inferWrites` fills the answer in before emission.
(pub :: fnMayWrite (-> CG String Int))
(pub fn (fnMayWrite cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigWrites e)
      1)
  })

; The least fixed point of "may write" over the call graph: each
; function's own body first, then any function that calls one that may
; write, until nothing changes. A function starts at 0, so recursion
; without a write stays 0. An `extern` starts at 1.
(pub :: inferWrites (-> CG (Vec ASTNode) Int))
(pub fn (inferWrites cg decls)
  {
    (let sigs vecNew)
    (let callees vecNew)
    {
      (for d in decls
        (if (== (nodeTag d) TAG_D_FN)
          {
            (let _m (cgSetDeclModule cg d))
            (let _d (cgSetCurDecl cg (Some d)))
            (let eFound (findFSigCg cg (nodeAName d)))
            (if (let (Some e) eFound)
              {
                (let bound (writesBound (nodeCChild d) (nodeBNames d)))
                (let names vecNew)
                (if (writesIn cg (nodeCChild d) bound names 0)
                  (fsigSetWrites e 1))
                (vecPush sigs e)
                (vecPush callees names)
              })
          }))
      (let mut changed true)
      (while changed
        {
          (set changed false)
          (for (e k) in sigs
            (if (&& (== (fsigWrites e) 0) (writesAnyCallee cg (vecGet callees k)))
              {
                (fsigSetWrites e 1)
                (set changed true)
              }))
        })
      0
    }
  })

; Whether anything in a `let`'s scope may write: its own forms, or a
; function it calls. Asked during emission, after `inferWrites`.
(pub :: scopeMayWrite (-> CG ASTNode Bool))
(pub fn (scopeMayWrite cg body)
  {
    (let names vecNew)
    (|| (writesIn cg body (writesBound body vecNew) names 1) (writesAnyCallee cg names))
  })

(:: writesAnyCallee (-> CG Names Bool))
(fn (writesAnyCallee cg names)
  {
    (let mut hit false)
    {
      (for n in names
        (if (! hit)
          {
            (let eFound (findFSigCg cg n))
            (if (let (Some e) eFound)
              (if (== (fsigWrites e) 1)
                (set hit true))
              (set hit true))
          }))
      hit
    }
  })

; Every name the body binds - parameters, `let` names, lambda
; parameters and pattern binders. A call whose head is one of them
; calls a function value, which may do anything.
(:: writesBound (-> ASTNode Names Names))
(fn (writesBound body params)
  {
    (let out vecNew)
    {
      (for p in params
        (vecPush out p))
      (writesBoundIn body out)
      out
    }
  })

(:: writesBoundIn (-> ASTNode Names ()))
(fn (writesBoundIn e out)
  (if (! (nodeSame e nilNode))
    {
      (let tg (nodeTag e))
      (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
        (vecPush out (nodeAName e)))
      (if (== tg TAG_E_LAM)
        (for p in (nodeANames e)
          (vecPush out p)))
      (if (== tg TAG_E_MATCH)
        (for arm in (nodeBChildren e)
          {
            (let names (patBindersCg (nodeAChild arm) vecNew))
            (if (!= (as names Int) 0)
              (for n in names
                (vecPush out n)))
          }))
      (let n (slotPartCount e))
      (for k in 0..(if (< n 0)
        0
        n)
        (writesBoundIn (slotPart e k) out))
    }))

; Whether `e` writes by itself, adding to `names` the mangled name of
; every function it calls. An unknown shape answers true. `mode` 0 asks
; about a function's body for its summary, where a `set` of a local
; touches only the callee's own slot. `mode` 1 asks about a scope inside
; the function being emitted, where a `set` of a local that holds a
; reference may release the very container a binding borrows from, and
; a call through a local is a call through a function value.
(:: writesIn (-> CG ASTNode Names Names Int Bool))
(fn (writesIn cg e bound names mode)
  (if (nodeSame e nilNode)
    false
    {
      (let tg (nodeTag e))
      (if (|| (== tg TAG_E_SETF) (== tg TAG_E_HANDLE))
        true
        ; a lambda's body runs only where it is called, and a call
        ; through a function value already answers true
        (if (== tg TAG_E_LAM)
          false
          (if (== tg TAG_E_VAR)
            {
              (let n (nodeAName e))
              ; a local is read, not called, even when a nullary global
              ; shares its name; inside the function being emitted the
              ; outer locals are the symbol table's, not `bound`'s
              (if (|| (writesNameIn n bound)
                    (|| (isPrimName n) (&& (== mode 1) (isLocalValue cg n))))
                false
                {
                  (let full (mangledForCg cg n))
                  (if (isNullaryFnCg cg full)
                    (vecPush names full))
                  false
                })
            }
            (if (== tg TAG_E_APP)
              (writesApp cg e bound names mode)
              (if (&& (== mode 1) (&& (== tg TAG_E_SET) (writesSetsReference cg e)))
                true
                (writesParts cg e bound names mode))))))
    }))

; Does this `set` of a local store a reference? A slot holding one
; releases it when overwritten; a scalar's slot holds nothing to release.
(:: writesSetsReference (-> CG ASTNode Bool))
(fn (writesSetsReference cg e)
  {
    (let ty (checkedValueTy (nodeBChild e)))
    (|| (nodeSame ty nilNode) (!= (fldClass cg ty) 0))
  })

(:: writesParts (-> CG ASTNode Names Names Int Bool))
(fn (writesParts cg e bound names mode)
  {
    (let n (slotPartCount e))
    (if (< n 0)
      true
      {
        (let mut hit false)
        {
          (for k in 0..n
            (if (writesIn cg (slotPart e k) bound names mode)
              (set hit true)))
          hit
        }
      })
  })

(:: writesApp (-> CG ASTNode Names Names Int Bool))
(fn (writesApp cg e bound names mode)
  {
    (let head (spineHead e))
    ; A cast or layout query's first operand is a type, represented as
    ; expression syntax. It cannot call a same-named nullary function.
    ; Its value operands still run, and surplus cast operands call the
    ; function value the cast answers.
    (let typeHead
      (&& (== (nodeTag head) TAG_E_VAR)
        (&& (|| (isCastName (nodeAName head)) (sizedTyIn (nodeAName head) "sizeof alignof"))
          (!
            (|| (writesNameIn (nodeAName head) bound)
              (&& (== mode 1) (isLocalValue cg (nodeAName head))))))))
    (let argsWrite
      {
        (let mut hit false)
        {
          (for k in (if typeHead
            2
            1)..(slotPartCount e)
            (if (writesIn cg (slotPart e k) bound names mode)
              (set hit true)))
          hit
        }
      })
    (if (!= (nodeTag head) TAG_E_VAR)
      true
      {
        (let n (nodeAName head))
        (if (|| (writesNameIn n bound) (&& (== mode 1) (isLocalValue cg n)))
          true
          ; a comparison reads its operands as `+` does: without it,
          ; every function that compared counted as writing, and every
          ; scope calling one took a share it never needed
          (if (|| (isBinop n)
                (|| (isCmpOp n)
                  (|| (isAndOr n) (|| (isCastName n) (sizedTyIn n "sizeof alignof")))))
            (|| argsWrite (&& (isCastName n) (> (spineArity e) 2)))
            (if (isPrimName n)
              (|| argsWrite (! (writesReadOnlyPrim n)))
              (if (hasType (cgTypes cg) n)
                argsWrite
                {
                  (let full (mangledForCg cg n))
                  (let sigFound (findFSigCg cg full))
                  ; surplus arguments call the closure the function
                  ; answers, which may do anything
                  (if (let (Some sig) sigFound)
                    (if (> (spineArity e)
                          (match (fsigTy sig)
                            ((None) 0)
                            ((Some ty) (arrowArity ty))))
                      true
                      {
                        (vecPush names full)
                        argsWrite
                      })
                    true)
                }))))
      })
  })

; The primitives that read and never write: arithmetic and comparison
; on words, loads, a fresh allocation, taking a share, an address, the
; float conversions, the arguments, string comparison, and the two
; traps, which stop the program rather than change what it holds.
(:: writesReadOnlyPrim (-> String Bool))
(fn (writesReadOnlyPrim n)
  (|| (isIntegerWordName n)
    (|| (sizedTyIn n "__streq __strne __contract")
      (|| (strEq n "__load64")
        (|| (strEq n "__load8")
          (|| (strEq n "__alloc")
            (|| (strEq n "__retain")
              (|| (strEq n "__retainref")
                (|| (strEq n "__addr")
                  (|| (strEq n "__floatToBits")
                    (|| (strEq n "__floatFromBits")
                      (|| (strEq n "__intToFloat")
                        (|| (strEq n "__floatToInt")
                          (|| (strEq n "__argc")
                            (|| (strEq n "__argv") (strEq n "__indexTrap"))))))))))))))))

(:: writesNameIn (-> String Names Bool))
(fn (writesNameIn n bound)
  {
    (let mut hit false)
    {
      (for b in bound
        (if (strEq b n)
          (set hit true)))
      hit
    }
  })

; An OWNED temporary handed to a call is released once the call has
; returned: the callee borrowed it (event 1), every store it could
; make took a share (events 5/6, MM-LIFE-2g), and a callee that
; answers it answers a retained share (event 2). A type-variable
; result also permits this when its contract transfers an owned
; share. The head reaching here is a global with a signature
; (`emitPlainCall` is past the primitive, local and constructor
; dispatch), or an unsigned one, which answers -1.
(pub :: releaseOwnedArgs (-> CG String Nodes Strings Int CG))
(pub fn (releaseOwnedArgs cg fnName args regs i)
  (if (>= i (vecLen args))
    cg
    (if (== (argOwnedRelease cg fnName args i) 1)
      ; S4 slice 1: a region-covered construction is reclaimed by the
      ; reset, so emitting its release is binary only. The DECISION
      ; predicate above is untouched - `mustTailOK` reads it too, and
      ; stays conservative.
      ;
      ; S4 slice 2, args path: a call whose answer the witness proved
      ; fresh (`nodeResWord` 2, stamped post-fixpoint from the
      ; callee's converged facts - result from CUR0, from no
      ; parameter, from no unresolved call - and never when
      ; truncation made every row a lower bound) is reclaimed by the
      ; same reset, so its release is the same binary-only traffic.
      ; The depth gate is the same textual extent slice 1 owns: the
      ; stamp is context-free (the callee is fresh everywhere) and
      ; only a use inside the body may go without its release. What
      ; is NOT covered here is a fresh call result bound by `let`
      ; and released at scope end rather than passed as an argument
      ; - that walker is slice 2's scope-end path (`emitLetAt`),
      ; built, and this one leaves it exactly alone. Inlined rather
      ; than factored so no new
      ; top-level function moves the effect-distribution pins; the
      ; callee-mediated hole is outcome-identical either way (the
      ; reset frees unconditionally), as slice 1's gate pins.
      ; S4 slice 3, args path: a join whose every arm the witness
      ; proved fresh (`nodeResWord` 2 - an `if` or `match` whose
      ; arm value nodes all carry the stamp) answers whichever
      ; arm it took, so the single join release is the same
      ; binary-only traffic. Same depth gate, same `argOwnedRelease`
      ; still saying 1, same inlining so no new top-level function
      ; moves the effect-distribution pins. What is NOT covered here
      ; is a fresh join bound by `let` - that walker is the sibling
      ; slice, and this one leaves it exactly alone.
      {
        (let a (vecGet args i))
        (if (|| (== (isRegionCoveredCon cg a) 1)
              (&& (!= (cgRegionDepth cg) 0)
                (&&
                  (|| (== (nodeTag a) TAG_E_APP)
                    (|| (== (nodeTag a) TAG_E_IF) (== (nodeTag a) TAG_E_MATCH)))
                  (&& (== (nodeResWord a) 2) (dropFreeExpr cg a)))))
          (releaseOwnedArgs cg fnName args regs (+ i 1))
          {
            (let lent
              {
                (let l (lendClass cg a))
                (if (== l 0)
                  {
                    (let t (transferClass cg a))
                    (if (== t 0)
                      (fieldArgClass cg a)
                      t)
                  }
                  l)
              })
            (let reg (vecGet regs i))
            (releaseOwnedArgs
              (if (>= lent 2)
                {
                  (let cgR (emitEvwRead cg))
                  (emitRcIfBitOf cgR reg (- lent 2) (strDup (cgResult cgR)) 0)
                }
                (emitReleaseOf cg reg))
              fnName args regs (+ i 1))
          })
      }
      (releaseOwnedArgs cg fnName args regs (+ i 1)))))

; Hand back every argument this call borrowed its result from, once
; the result has taken a share of its own (the caller retains it
; first). The share a transferred argument brought is handed back
; under the same class `releaseOwnedArgs` would use.
(pub :: releaseBorrowedFrom (-> CG String Nodes Strings Int CG))
(pub fn (releaseBorrowedFrom cg fnName args regs i)
  (if (>= i (vecLen args))
    cg
    (if (== (borrowedFromOwnedArg cg fnName args i) 1)
      {
        (let a (vecGet args i))
        (let reg (vecGet regs i))
        {
          (let lent
            {
              (let l (lendClass cg a))
              (if (== l 0)
                {
                  (let t (transferClass cg a))
                  (if (== t 0)
                    (fieldArgClass cg a)
                    t)
                }
                l)
            })
          (releaseBorrowedFrom
            (if (>= lent 2)
              {
                (let cgR (emitEvwRead cg))
                (emitRcIfBitOf cgR reg (- lent 2) (strDup (cgResult cgR)) 0)
              }
              (emitReleaseOf cg reg))
            fnName args regs (+ i 1))
        }
      }
      (releaseBorrowedFrom cg fnName args regs (+ i 1)))))

; Would `releaseOwnedArgs` release argument `i` after the call? ONE
; predicate, asked by the release above and by `mustTailOK` below, so
; the two cannot drift: a `musttail` over an argument the caller still
; had to release would be a use after free in the callee, and a plain
; call left where a `musttail` was sound is only a missed guarantee.
;
; The callee parks nothing of a typed arrival there, and answers no
; part of it that the caller now holds instead - and consumes nothing
; of it either (`fnConsumeMask`: a share the callee ends is not the
; caller's to hand back) - and an immediate (`Nil`) or a static
; literal has nothing to give back.
;
; A callee whose result is a type variable may transfer an owned
; share under its trusted transfer contract. Such a result stays live
; after the caller gives back its argument share, including when the
; result came from that argument. A borrowed result still needs
; `borrowedFromOwnedArg`'s protection before its holder is released.
(pub :: argOwnedRelease (-> CG String Nodes Int Int))
(pub fn (argOwnedRelease cg fnName args i)
  {
    (let cls (fnResultClass cg fnName))
    (let transfers (&& (== cls 1) (== (fsigTransfer cg fnName) 1)))
    ; A lent argument's share guards it against the callee writing
    ; over the place it was lent from. A callee that writes nothing
    ; (`fnMayWrite`) cannot, so the argument stays borrowed.
    (let lentShared
      (&& (== (fnMayWrite cg fnName) 1)
        (|| (!= (lendClass cg (vecGet args i)) 0) (!= (fieldArgClass cg (vecGet args i)) 0))))
    (if (|| (== cls 0) (|| (== cls 2) (&& (== cls 1) (|| lentShared transfers))))
      (if (&&
            (|| (== (valueOwnedRef cg (vecGet args i)) 1)
              (|| lentShared (!= (transferClass cg (vecGet args i)) 0)))
            (&& (== (isStaticSentinelNode cg (vecGet args i)) 0)
              (&& (== (isNullaryConNode cg (vecGet args i)) 0)
                (&& (== (& (fnCallStashMask cg fnName args) (| (paramBit i) (ownerBit i))) 0)
                  (&& (== (& (fnConsumeMask cg fnName) (| (paramBit i) (ownerBit i))) 0)
                    (|| (== cls 2) (|| transfers (== (& (fnRetMask cg fnName) (anyBit i)) 0))))))))
        1
        0)
      0)
  })

; How many of `args` the caller releases after the call.
(pub :: ownedArgReleases (-> CG String Nodes Int Int))
(pub fn (ownedArgReleases cg fnName args i)
  (if (>= i (vecLen args))
    0
    (+ (argOwnedRelease cg fnName args i) (ownedArgReleases cg fnName args (+ i 1)))))

; ------------------------------------------------------------------
; MM-EXEC-6c, the mutual tail call. `musttail` is LLVM's GUARANTEED
; tail call: `llc` must emit a jump at every optimisation level or
; refuse the module, so a mutual recursion marked this way runs in
; constant stack at `--opt 0` exactly as a self call does through
; `emitTailJump`. The guarantee comes with LLVM's conditions, and
; every one of them is a line here:
;
;   * the call is in tail position, and nothing is owed after it -
;     `emitExprTail` armed 3 (no leaf retain for this node) and
;     `armMustTail` turned that into the token 2 for a call to a
;     DEFINED function applied to exactly its arity;
;   * the caller is not emitting its register-pair variant (that
;     returns `{ i64, i64 }`) and is not a self-tail-call loop (its
;     retained parameter slots are released after the body,
;     `releaseRefParamSlots`);
;   * no `let` temporary is pending release at the scope end
;     (`pendingOwned`, field 42, paid after the body). An owning `mut`
;     slot in scope (pair slot 17) doesn't stop the mark, unless an
;     argument may hold its value (`slotsReachArgs`): the call releases
;     what each one holds before it jumps (`releasePendingSlots`);
;   * the prototypes are identical - every parameter is `i64` and both
;     return `i64`, so identical means the same COUNT, evidence word
;     included: `cgLlvmParams` for the caller, `args + takesEv` for the
;     callee - and the caller is a plain `fn`, not a lambda or a thunk
;     (slot 6 is 0 there, set by `emitLamDef`);
;   * no argument is an owned temporary the caller would release after
;     the call (`ownedArgReleases`, the same predicate
;     `releaseOwnedArgs` spends).
;
; THE OWNED-TEMPORARY CASE IS REFUSED, NOT TRANSFERRED. A callee
; borrows its arguments (event 1) and the caller releases its temporary
; once the callee has returned; releasing it BEFORE the call would free
; a block the callee is about to read, and skipping the release would
; leak a share per iteration. Moving the release into the callee would
; change the convention for every function in the module for the sake
; of this shape. So `(od (+ i 1) (concat s "x"))` stays a plain call,
; constant-stack only under `opt` and only while the release after it
; is dead, and MM-EXEC-6c keeps its sentence for exactly that case.
;
; A mismatched arity is refused for LLVM's reason, not this compiler's:
; under the C calling convention `musttail` requires the prototypes to
; match, and the convention that lifts that (`tailcc`) would have to be
; adopted by every function in the module, `@main` and every `extern`
; boundary excepted. Measured over the compiler's own IR before this
; was written, the matched-prototype case is the common one; the
; mismatched one is recorded in docs/memory-model.md MM-EXEC-6c as what
; still needs `--opt 1`.
; ------------------------------------------------------------------
(pub :: mustTailOK (-> CG Int Int String Nodes Int))
(pub fn (mustTailOK cg mt takesEv fnName args)
  (if (!= mt 2)
    0
    (if (!= (cgPairMode cg) 0)
      0
      (if (cgInTailLoop cg)
        0
        (if (== (cgLlvmParams cg) 0)
          0
          (if (!= (cgLlvmParams cg) (+ (vecLen args) takesEv))
            0
            (if (> (vecLen (cgPendingStrings cg)) 0)
              0
              (if (> (ownedArgReleases cg fnName args 0) 0)
                0
                (if (&& (== (fnResultClass cg fnName) 1)
                      (== (borrowedFromOwnedAny cg fnName args 0) 1))
                  ; a result borrowed from an owned temporary is
                  ; retained and the temporary released after the
                  ; call (`emitPlainCall`); a musttail has no after
                  0
                  (if (== (slotsReachArgs cg (pairOwningSlots cg) args 0) 1)
                    0
                    1))))))))))

; `dispatchCall` arms the token for the one call it may mark: a tail
; application (3 - no leaf retain owed) whose head is a DEFINED
; function applied to exactly its declared arity. Operators, primitives,
; constructors, locals and effect operations never reach here; a
; partial or an over-application is not a tail call to the function.
(pub :: armMustTail (-> CG Int String Nodes CG))
(pub fn (armMustTail cg isTail fnName args)
  {
    (let ar (fnDefArityCg cg fnName))
    (if (&& (== isTail 3) (&& (>= ar 0) (== (vecLen args) ar)))
      {
        (cgSetTailOK cg 2)
        cg
      }
      cg)
  })

; The parameter count of the `fn` that defines `name`, signed or not:
; its `define` takes exactly those parameters, plus the evidence word
; that only a signature can call for (`fnTakesEvw`, which `mustTailOK`
; adds). The name is mangled first, because the declaration index is
; keyed on the module-qualified spelling and most callees are
; imported. -1 when no `fn` defines the name - an `extern` item, which
; is never marked - and -1 where no index has been built (the REPL's
; and LSP's partial paths), where the call stays plain.
;
; Reading the signature's record instead (`fnArityCg`) answered -1 for
; a function written without a signature, so a mutual tail call INTO
; one stayed a plain call and grew the stack at `--opt 0` while
; `--opt 2`'s sibling-call pass flattened it: a three-way cycle with
; one unsigned member died by SIGSEGV nine million calls deep at one
; level and answered at the other.
(pub :: fnDefArityCg (-> CG String Int))
(pub fn (fnDefArityCg cg name)
  (if (let (Some index) (cgDeclIndex cg))
    (if (let (Some id) (internFind (internWordOf index.names)
                         (declSpellingOf (mangledForCg cg name))))
      (vecGet index.arity id)
      (- 0 1))
    (- 0 1)))

; ------------------------------------------------------------------
; A STATIC SENTINEL: a value whose count word is `-1`, so releasing it
; loads a count, compares it against `-1` and returns having done
; nothing. `emitStrExpr` emits the only one - a bare string literal is
; the address of a `@strhdr_*` constant, and `MM-LIFE-2b`'s header sits
; at handle-16 with `-1` where a heap block has its count.
;
; This is the sibling of `isNullaryConNode` beside it and it is applied
; the same way and for the same reason: that rule already excludes an
; immediate from an argument release because "an immediate (`Nil`) has
; nothing to give back". Neither does a static.
;
; IT IS NOT `valueOwnedRef` ANSWERING 0, and the difference is the whole
; care in this change. That predicate answers 1 for `TAG_E_STR` on
; purpose - its own comment says "a static: immortal, and releasing it
; is a no-op, so a branch answering one does not stop the join being
; owned" - because `(if c "lit" (mkStr))` has to stay owned for the
; OTHER branch's share to be given back. Answering 0 there would silence
; this release and leak that one. So the question is asked here, at the
; emission of a release for a value that IS the literal, and the join
; reasoning is untouched.
;
; Measured before this existed, over the compiler's own emitted IR
; (`emit-llvm core/main.ax`, 197,562 lines, 3,469 functions):
; 5,762 of the 10,849 `axiom_release` call sites released a `@strhdr_*`
; literal - 53.1% of the release traffic in the largest Axiom program
; there is, every one of them a call that cannot free anything.
; Ablating them out of the IR by hand gave byte-identical output from
; the rebuilt compiler, a 5.3% smaller binary, and peak RSS at or below
; baseline, which is the arithmetic: deleting a call that frees nothing
; cannot cost memory.
(pub :: isStaticSentinelNode (-> CG ASTNode Int))
(pub fn (isStaticSentinelNode cg e)
  (if (nodeSame e nilNode)
    0
    (if (== (nodeTag e) TAG_E_STR)
      1
      (if (== (nodeTag e) TAG_E_VAR)
        {
          (let name (nodeAName e))
          (if (|| (isNullaryPrimName name)
                (|| (&& (!= (nodeDefScope e) 1) (isLocalValue cg name))
                  (hasType (cgTypes cg) name)))
            0
            (if (isDefinedFnCg cg (mangledForCg cg name))
              1
              0))
        }
        ; A `set` of a local answers the value it stores, so storing a
        ; literal answers that literal, and a block answers its last
        ; expression: dropping either is a static release too.
        (if (== (nodeTag e) TAG_E_SET)
          (isStaticSentinelNode cg (nodeBChild e))
          (if (== (nodeTag e) TAG_E_BEGIN)
            {
              (let xs (nodeAChildren e))
              (if (> (vecLen xs) 0)
                (isStaticSentinelNode cg (vecGet xs (- (vecLen xs) 1)))
                0)
            }
            0))))))

(pub :: isNullaryConNode (-> CG ASTNode Int))
(pub fn (isNullaryConNode cg e)
  (if (nodeSame e nilNode)
    0
    (if (== (nodeTag e) TAG_E_VAR)
      (if (hasType (cgTypes cg) (nodeAName e))
        1
        0)
      (if (&& (== (nodeTag e) TAG_E_APP) (== (spineArity e) 0))
        (isNullaryConNode cg (spineHead e))
        0))))

; S4 slice 1 (docs/memory-model.md §3.6): a release the
; region's own reset makes redundant.
;
; Inside a `(region r BODY)` every allocation lands after the body's
; mark cell, and the reset at the body's end frees all of it in one
; pointer move - so a value the body itself constructed and drops
; there needs no `axiom_release`: the call cannot free anything the
; reset will not free first. What it CAN do is cost binary size,
; which is the whole of this slice.
;
; The rule fires only where all three hold, each for a soundness
; reason rather than caution:
;
;   * pair slot 9 is nonzero - emission is textually inside a region
;     body. `emitRegion` counts it up around the body and back down
;     after; `emitLamDef` clears it across a lambda body, because a
;     lambda emitted here may run after the reset (an escaping
;     closure), and a release elided on that path would leak where
;     counting would have freed. Plain functions need no clearing:
;     they are only ever emitted at the top level, where the count
;     is 0 by construction. Thunks need none either: a thunk body
;     is fixed shape with no user expression in it, so no release
;     site can read the slot there.
;   * the operand IS the construction the emitter will build - a
;     `TAG_E_APP` spine whose head takes the `emitConstructor` arm
;     of `dispatchCall` (data or struct alike - a struct name in
;     head position builds through the same call), or a
;     `TAG_E_STRUCTCON`, applied to exactly its arity. The block
;     `emitConstructor` builds for it was allocated right here,
;     after the mark, at count 1. A `VAR` operand, however freshly
;     bound, is not answered here: resolving it to its definition is
;     def-tracking this slice does not build, and a fixture pins
;     that the release stays.
;   * full application only: a bare constructor is a curried closure
;     value, allocated by the curry machinery and not by the site
;     being released. The equality costs nothing and keeps a future
;     relaxation from silently widening this.
;
; The head check mirrors `dispatchCall`'s order, because a registry
; hit alone is not the decision: locals shadow (a `let`-bound lambda
; named `MkBox` turns `(MkBox 1)` into a closure call returning an
; alias - measured leaking without this guard), effect operations
; dispatch, and a constructor literally named `cast` takes the cast
; path (an alias - and constructors CAN be so named, probed). The
; `defscope` exemption on the local arm is deliberately NOT mirrored:
; omitting it can only refuse an elision emission would have taken,
; never take one it refused. Every other dispatch arm needs no
; guard: scalar answers (`sizeof`, arithmetic, comparisons) never
; reach a release site, and allocating primops build fresh blocks
; after the mark, where elision is outcome-identical.
;
; What is NOT covered, by design: call results are covered elsewhere
; now (the callee may alias an outer value, and freshness comes from
; the MM-RGN-5 witness as built - the stamp system, slices 2-4, read
; in `releaseOwnedArgs`, `emitLetAt` and `releaseScrutinee` - so this
; syntactic predicate leaves them alone); field stores (their release balances a retain in
; the same step - eliding one half would leak), and `musttail`
; decisions (`argOwnedRelease` still answers 1 for a covered
; temporary, so `mustTailOK` stays conservative and
; `check-tail-calls.sh` does not move; a `musttail` jump also skips
; the reset itself, so eliding on that path would widen S2's own
; skipped-reset leak).
(pub :: isRegionCoveredCon (-> CG ASTNode Int))
(pub fn (isRegionCoveredCon cg e)
  (if (|| (== (cgRegionDepth cg) 0)
        (if (nodeSame e nilNode)
          true
          (! (dropFreeExpr cg e))))
    0
    (if (nodeSame e nilNode)
      0
      (if (== (nodeTag e) TAG_E_STRUCTCON)
        {
          (let entryFound (lookupType (cgTypes cg) (nodeAName e)))
          (if (let (Some entry) entryFound)
            (if (&& (== (eKind entry) (TF_STRUCT))
                  (&& (> (eArity entry) 0) (== (vecLen (nodeBChildren e)) (eArity entry))))
              1
              0)
            0)
        }
        (if (!= (nodeTag e) TAG_E_APP)
          0
          {
            (let hd (spineHead e))
            (if (!= (nodeTag hd) TAG_E_VAR)
              0
              ; `dispatchCall`'s order: a shadowing local, an effect
              ; operation, and the cast path all claim the head
              ; before the constructor table does.
              {
                (let n (nodeAName hd))
                (if (|| (isCastName n) (|| (isLocalValue cg n) (hasEffFor cg (cgEffOps cg) n)))
                  0
                  {
                    (let entryFound (lookupType (cgTypes cg) n))
                    (if (let (Some entry) entryFound)
                      ; Data and struct alike: `dispatchCall` answers
                      ; `emitConstructor` for either hit, and the types
                      ; table holds nothing else, so a function name
                      ; cannot reach the arity check below. The kind
                      ; test is still load-bearing as documentation:
                      ; without it a future table resident would be
                      ; one `lookupType` hit away from an elision.
                      (if (&& (|| (== (eKind entry) (TF_DATA)) (== (eKind entry) (TF_STRUCT)))
                            (&& (> (eArity entry) 0) (== (spineArity e) (eArity entry))))
                        1
                        0)
                      0)
                  })
              })
          })))))

; ------------------------------------------------------------------
; `&&` and `||` short-circuit.
;
; Lowering them to `and`/`or` over two already-evaluated operands gives
; the right answer for 0/1 values and the wrong behaviour for everything
; else: the right-hand side runs even when the left has already decided.
; That is what a guard exists to prevent. `isNullaryFnIn` in this very
; file reads `(vecLen (nodeB d))` only after checking the declaration is
; a function - a signature declaration has 0 there, and evaluating it
; anyway dereferences address zero.
;
; So they become branches, like `if`.
; ------------------------------------------------------------------
(pub :: isAndOr (-> String Bool))
(pub fn (isAndOr nm)
  (if (strEq nm "&&")
    true
    (strEq nm "||")))

(pub :: emitAndOr (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitAndOr op args cg)
  ; `&&` takes the right-hand side when the left is true; `||`
  ; when it is false.
  {
    (let isAnd (strEq op "&&"))
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let ra (strDup (cgResult cg1)))
    (let cn (allocReg cg1))
    (let rhsL (allocReg cg1))
    (let shortL (allocReg cg1))
    (let mergeL (allocReg cg1))
    (let cr (regStr cn))
    (let rhsB (labelStr rhsL))
    (let shortB (labelStr shortL))
    (let mergeB (labelStr mergeL))
    (let _1 (emitLine cg1 (concat (concat "  " cr) (concat " = icmp ne i64 " (concat ra ", 0")))))
    (let tgtT
      (if isAnd
        rhsB
        shortB))
    (let tgtF
      (if isAnd
        shortB
        rhsB))
    (let _2
      (emitLine cg1
        (concat (concat "  br i1 " (concat cr ", label %"))
          (concat tgtT (concat (concat ", label %" tgtF) "")))))
    (let _3 (emitLabel cg1 rhsB))
    (let cg2 (emitExpr (vecGet args 1) cg1))
    (let rb (strDup (cgResult cg2)))
    (let bn (allocReg cg2))
    (let bcr (regStr bn))
    (let _4 (emitLine cg2 (concat (concat "  " bcr) (concat " = icmp ne i64 " (concat rb ", 0")))))
    (let zn (allocReg cg2))
    (let zr (regStr zn))
    (let _5 (emitLine cg2 (concat (concat "  " zr) (concat " = zext i1 " (concat bcr " to i64")))))
    (let rhsPred (strDup (cgBlock cg2)))
    (let _6 (emitLine cg2 (concat "  br label %" mergeB)))
    (let _7 (emitLabel cg2 shortB))
    (let _8 (emitLine cg2 (concat "  br label %" mergeB)))
    (let _9 (emitLabel cg2 mergeB))
    (let pn (allocReg cg2))
    (let pr (regStr pn))
    (let shortVal
      (if isAnd
        (constStr 0)
        (constStr 1)))
    (let _10
      (emitLine cg2
        (concat (concat (concat "  " pr) (concat " = phi i64 [ " zr))
          (concat (concat ", %" (concat rhsPred " ], [ "))
            (concat (concat shortVal (concat ", %" shortB)) " ]")))))
    (let _11 (cgSetResult cg2 pr))
    cg2
  })

; `&&`/`||` never reach this table - `dispatchCall` routes them to the
; short-circuit branches first - so a single `&` or `|` here is
; unambiguously the bitwise operator.
(pub :: isBinop (-> String Bool))
(pub fn (isBinop nm)
  (if (strEq nm "+")
    true
    (if (strEq nm "-")
      true
      (if (strEq nm "*")
        true
        (if (strEq nm "/")
          true
          (if (strEq nm "%")
            true
            (if (strEq nm "&")
              true
              (if (strEq nm "|")
                true
                (if (strEq nm "^")
                  true
                  (if (strEq nm "<<")
                    true
                    (if (strEq nm ">>")
                      true
                      false)))))))))))

(pub :: binopToLLVM (-> String String))
(pub fn (binopToLLVM nm)
  (if (strEq nm "+")
    "add"
    (if (strEq nm "-")
      "sub"
      (if (strEq nm "*")
        "mul"
        (if (strEq nm "/")
          "sdiv"
          (if (strEq nm "%")
            "srem"
            (if (strEq nm "&")
              "and"
              (if (strEq nm "|")
                "or"
                (if (strEq nm "^")
                  "xor"
                  (if (strEq nm "<<")
                    "shl"
                    (if (strEq nm ">>")  ; arithmetic, matching stage0
                      "ashr"
                      "add")))))))))))

(pub :: isCmpOp (-> String Bool))
(pub fn (isCmpOp nm)
  (if (strEq nm "==")
    true
    (if (strEq nm "!=")
      true
      (if (strEq nm "<")
        true
        (if (strEq nm ">")
          true
          (if (strEq nm "<=")
            true
            (if (strEq nm ">=")
              true
              false)))))))

(pub :: cmpToLLVM (-> String String))
(pub fn (cmpToLLVM nm)
  (if (strEq nm "==")
    "eq"
    (if (strEq nm "!=")
      "ne"
      (if (strEq nm "<")
        "slt"
        (if (strEq nm ">")
          "sgt"
          (if (strEq nm "<=")
            "sle"
            (if (strEq nm ">=")
              "sge"
              "eq")))))))

(pub :: fbinopToLLVM (-> String String))
(pub fn (fbinopToLLVM nm)
  (if (strEq nm "+")
    "fadd"
    (if (strEq nm "-")
      "fsub"
      (if (strEq nm "*")
        "fmul"
        (if (strEq nm "/")
          "fdiv"
          (if (strEq nm "%")
            "frem"
            "fadd"))))))

; Ordered variants throughout: `o` requires neither operand be NaN, so
; a NaN compares false under every operator, matching stage0.
(pub :: fcmpToLLVM (-> String String))
(pub fn (fcmpToLLVM nm)
  (if (strEq nm "==")
    "oeq"
    (if (strEq nm "!=")
      "one"
      (if (strEq nm "<")
        "olt"
        (if (strEq nm ">")
          "ogt"
          (if (strEq nm "<=")
            "ole"
            (if (strEq nm ">=")
              "oge"
              "oeq")))))))

; Emit argument expressions from a Vec, building comma-separated reg string.
(pub :: emitArgsList (-> Nodes CG Int CG))
;@axiom:effect(io)
(pub fn (emitArgsList args cg i)
  (if (>= i (vecLen args))
    {
      (cgSetResult cg "")
      (cgSetArgsTyped cg "")
      cg
    }
    {
      (let node (vecGet args i))
      {
        (let cg1 (emitExpr node cg))
        {
          (let reg (strDup (cgResult cg1)))
          {
            (let restCg (emitArgsList args cg1 (+ i 1)))
            {
              (let rest (cgResult restCg))
              (let restT (cgArgsTyped restCg))
              (if (== (strLen rest) 0)
                {
                  (cgSetResult restCg reg)
                  (cgSetArgsTyped restCg (strDup reg))
                  restCg
                }
                {
                  (cgSetResult restCg (concat reg (concat ", " rest)))
                  (cgSetArgsTyped restCg (concat (strDup reg) (concat ", i64 " restT)))
                  restCg
                })
            }
          }
        }
      }
    }))

; ------------------------------------------------------------------
; MM-LIFE-2d, monomorphic half: the reference map is computed at
; COMPILE time from the declared field types and stored into the
; shape word at each construction site. A field is a REFERENCE iff
; its declared type guarantees the word at run time is an immediate,
; a static, or a pointer to a counted block - String, a declared
; data or struct type, a tuple, an arrow. Scalars (Int, Float, Bool,
; Char, the fixed-width family) never enter the map: an Int can hold
; any bit pattern, and @axiom_release dereferencing one past the
; immediates guard is the wild read this classification exists to
; make impossible. Anything UNCLASSIFIABLE - a type variable, a Ptr,
; an alias, a qualified spelling - forces the whole block to the
; LEAF (empty map): under-reclaiming leaks, a wrong bit
; use-after-frees, and only one of those is survivable.
; ------------------------------------------------------------------
(pub :: scalarTyName (-> String Int))
(pub fn (scalarTyName n)
  (if (|| (> (integerTypeCode n) 0)
        (|| (strEq n "Bool")
          (|| (strEq n "Char")
            (|| (strEq n "Float")
              (|| (strEq n "Foreign") (|| (strEq n "Spawn") (strEq n "Link")))))))
    1
    0))

; Canonical names distinguish data references from another module's
; homonymous word struct or subtype. The field map may only follow the
; declaration that the checked field type names.
(:: cgDeclaredTypeName (-> ASTNode String))
(fn (cgDeclaredTypeName decl)
  (if (== (nodeModule decl) 0)
    (nodeAName decl)
    (concat (nodeModuleName decl) (concat "$" (nodeAName decl)))))

(pub :: dataTyKnown (-> Strings String Int Int))
(pub fn (dataTyKnown names name i)
  (if (>= i (vecLen names))
    0
    (if (strEq (vecGet names i) name)
      1
      (dataTyKnown names name (+ i 1)))))

; Argument-position absence keeps the existing unclassifiable class.
; Present types retain the normal field classification without a nil bridge.
(pub :: parameterTypeClass (-> CG (Option ASTNode) Int))
(pub fn (parameterTypeClass cg parameter)
  (match parameter
    ((None) 1)
    ((Some ty) (fldClass cg ty))))

; 0 = machine scalar, 2 = reference, 1 = unclassifiable (forces leaf)
(pub :: fldClass (-> CG ASTNode Int))
;@axiom:effect(unsafe)
(pub fn (fldClass cg tn)
  (if (nodeSame tn nilNode)
    1
    {
      (let tg (nodeTag tn))
      (if (== tg TAG_T_ARR)
        2
        (if (== tg TAG_T_TUP)
          (if (== (vecLen (nodeAChildren tn)) 0)
            0
            2)
          (if (== tg TAG_T_CON)
            {
              (let n (as (nodeA tn) String))
              (if (== (scalarTyName n) 1)
                0
                ; `Handle` is a counted block of the foreign form
                ; (stdlib/Ffi.ax): a reference, walked and released
                (if (|| (strEq n "String")
                      (|| (strEq n "Option") (|| (strEq n "Handle") (strEq n "Vec"))))
                  ; the builtin `Option` is seeded by the checker and
                  ; never enters the module's data list
                  2
                  (if (== (dataTyKnown (cgDataTyNames cg) n 0) 1)
                    2
                    (if (let (Some e) (lookupType (cgTypes cg) n))
                      (if (== (eKind e) TF_STRUCT)
                        2
                        ; Word structs carry no reference bit.
                        (if (== (eKind e) TF_WORD)
                          0
                          1))
                      1))))
            }
            1)))
    }))

; The PADDED payload word count - THE one count convention
; (docs/memory-model.md MM-LIFE-2d): ((words*8)+15 & -16)/8, always
; even; a dead block files iff 0 < count <= 8192. A record's block is
; at most 48 words, below MM-ALLOC-25's 1 KiB band, so its size class
; is count >> 1, exactly the allocator's `lshr %sz0, 4`.
(pub :: paddedWords (-> Int Int))
(pub fn (paddedWords w)
  (* (/ (+ (* w 8) 15) 16) 2))

(pub :: pow2 (-> Int Int))
(pub fn (pow2 k)
  (if (<= k 0)
    1
    (* 2 (pow2 (- k 1)))))

; The reference bitmap already shifted to bits 16.., or -1 when any
; field is unclassifiable. Bit 16+i covers BLOCK word i, so a data
; cell's fields sit at base 1 (word 0 is the tag, never mapped) and
; a struct's at base 0. Word 47 would be bit 63 - the sign bit - so
; the map's capacity is 47 words and AX3029 refuses wider blocks
; before emission; every shape constant stays non-negative, which is
; what keeps `fmtInt` honest about it.
(pub :: shapeBits (-> CG (Vec ASTNode) Int Int Int Int))
(pub fn (shapeBits cg ftys isStruct base i)
  (if (>= i (vecLen ftys))
    0
    {
      (let tn
        (if (== isStruct 1)
          (nodeTyChild (vecGet ftys i))
          (vecGet ftys i)))
      {
        (let c (fldClass cg tn))
        (let rest (shapeBits cg ftys isStruct base (+ i 1)))
        (if (|| (== c 1) (== rest (- 0 1)))
          (- 0 1)
          (+ rest
            (if (== c 2)
              (pow2
                (+ 16
                  (if (== isStruct 1)
                    (/ (structFieldOffset ftys i) 8)
                    (+ base i))))
              0)))
      }
    }))

; A missing struct layout has no shape constant, even when its arity is zero.
(:: ctorPayloadWords (-> TypeEntry (Option Int)))
(fn (ctorPayloadWords entry)
  (if (== (eKind entry) TF_DATA)
    (Some (+ (eArity entry) 1))
    (match (eStructFields entry)
      ((None) None)
      ((Some fields) (Some (/ (+ (structPayloadBytes fields) 7) 8))))))

(:: requireCtorWords (-> TypeEntry Int))
;@axiom:effect(io)
(fn (requireCtorWords entry)
  (match (ctorPayloadWords entry)
    ((Some words) words)
    ((None)
      {
        (dieCodegenDiag "constructor entry has no layout metadata: " (eName entry))
        0
      }
    )))

(pub :: ctorShapeConst (-> CG TypeEntry (Option Int)))
(pub fn (ctorShapeConst cg entry)
  (match (ctorPayloadWords entry)
    ((None) None)
    ((Some words)
      {
        (let kind (eKind entry))
        (let arity (eArity entry))
        (let cnt (paddedWords words))
        (let ftys (eFieldTysVec entry))
        (let base
          (if (== kind TF_DATA)
            1
            0))
        (let isStruct
          (if (== kind TF_DATA)
            0
            1))
        (let bits
          (if (> words 47)
            (- 0 1)
            (match ftys
              ((None)
                (if (== arity 0)
                  0
                  (- 0 1))
              )
              ((Some fields) (shapeBits cg fields isStruct base 0)))))
        (Some
          (+ (* cnt 2)
            (if (== bits (- 0 1))
              0
              bits)))
      }
    )))

(:: requireCtorShapeConst (-> CG TypeEntry Int))
;@axiom:effect(io)
(fn (requireCtorShapeConst cg entry)
  (match (ctorShapeConst cg entry)
    ((Some shape) shape)
    ((None)
      {
        (dieCodegenDiag "constructor entry has no shape metadata: " (eName entry))
        0
      }
    )))

; The site's shape store - the third writer beside the allocator's
; leaf and the keep helper's re-stamp. The -8 is a literal in the
; instruction text: a GEP index of -1 would pass through `fmtInt`,
; which renders negatives wrong (the tag counter's `/` lesson).
(pub :: storeShapeValAt (-> CG String String CG))
(pub fn (storeShapeValAt cg base val)
  {
    (let sn (allocReg cg))
    {
      (let sr (regStr sn))
      {
        (let cg1
          (emitLine cg (concat (concat "  " sr) (concat " = add i64 " (concat base ", -8")))))
        {
          (let pn (allocReg cg1))
          {
            (let pr (regStr pn))
            {
              (let cg2
                (emitLine cg1
                  (concat (concat "  " pr) (concat " = inttoptr i64 " (concat sr " to ptr")))))
              (emitLine cg2 (concat "  store i64 " (concat val (concat ", ptr " pr))))
            }
          }
        }
      }
    }
  })

(pub :: storeShapeAt (-> CG String Int CG))
(pub fn (storeShapeAt cg base shape)
  (storeShapeValAt cg base (constStr shape)))

; MM-LIFE-2c, A1: a compiler-emitted OWNERSHIP-CREATING site births
; its block at count 1 - the constructing expression's own share.
; Raw __alloc/memAlloc and strWrap stay birth-0: the type-gated
; machinery supplies their +1 elsewhere, and a second birth would
; double-count every String.
(pub :: storeCountOneAt (-> CG String CG))
(pub fn (storeCountOneAt cg base)
  {
    (let sn (allocReg cg))
    {
      (let sr (regStr sn))
      {
        (let cg1
          (emitLine cg (concat (concat "  " sr) (concat " = add i64 " (concat base ", -16")))))
        {
          (let pn (allocReg cg1))
          {
            (let pr (regStr pn))
            {
              (let cg2
                (emitLine cg1
                  (concat (concat "  " pr) (concat " = inttoptr i64 " (concat sr " to ptr")))))
              (emitLine cg2 (concat "  store i64 1, ptr " (concat pr "")))
            }
          }
        }
      }
    }
  })

(pub :: emitRetainOf (-> CG String CG))
(pub fn (emitRetainOf cg v)
  (emitLine cg (concat "  call void @axiom_retain(i64 " (concat v ")"))))

(pub :: emitReleaseOf (-> CG String CG))
(pub fn (emitReleaseOf cg v)
  (emitLine cg (concat "  call void @axiom_release(i64 " (concat v ")"))))

; retain V only when bit k of the enclosing evidence word is set -
; the conditional twin every symbolic witness needs (a retain on a
; non-reference word is a wild count, so the guard is soundness).
; Retain `v` when bit 0 of THIS lambda's own evidence word is set -
; the word `applyOneArg` passes and `emitLamDef` declares. Bit 0 and
; only bit 0: a lifted lambda absorbs exactly one argument, because
; the parser curries, so there is one class to carry and no index to
; encode.
;
; A body emitted outside a lambda has no such symbol. That cannot
; happen from `EV_LAMARG`, which `evClassOf` answers only for the
; innermost lambda's own parameter placeholder, but the constant 0 is
; the answer if it ever does - the leaking direction.
(pub :: emitRetainIfLamArg (-> CG String Int CG))
(pub fn (emitRetainIfLamArg cg v d)
  (match (symIndex cg (evwaSym d))
    ((None) cg)
    ((Some symIdx) (emitRcIfBitOf cg v 0 (strDup (symRegAt cg symIdx)) 1))))

(pub :: emitRetainIfEvBit (-> CG String Int CG))
(pub fn (emitRetainIfEvBit cg v k)
  {
    (let cgR (emitEvwRead cg))
    (emitRcIfBitOf cgR v k (strDup (cgResult cgR)) 1)
  })

; `v` retained (op 1) or released (op 0) when bit k of the evidence
; WORD `src` is set: the boundary of a self-tail-call loop retains a
; type-variable slot's new value by the next iteration's word and
; releases the old value by the word that was current for it.
(pub :: emitRcIfBitOf (-> CG String Int String Int CG))
(pub fn (emitRcIfBitOf cgR v k src op)
  {
    (let _unused 0)
    (let an (allocReg cgR))
    {
      (let ar (regStr an))
      {
        (let cgA
          (emitLine cgR
            (concat (concat (concat "  " ar) (concat " = lshr i64 " src))
              (concat ", " (concat (constStr k) "")))))
        {
          (let bn (allocReg cgA))
          {
            (let br (regStr bn))
            {
              (let cgB
                (emitLine cgA (concat (concat "  " br) (concat " = and i64 " (concat ar ", 1")))))
              {
                (let cn (allocReg cgB))
                {
                  (let cr (regStr cn))
                  {
                    (let cgC
                      (emitLine cgB
                        (concat (concat (concat "  " cr) (concat " = icmp ne i64 " br))
                          (concat ", " (concat "0" "")))))
                    {
                      (let dn (allocReg cgC))
                      (let kn (allocReg cgC))
                      {
                        (let doB (labelStr dn))
                        (let skB (labelStr kn))
                        {
                          (let cgD
                            (emitLine cgC
                              (concat (concat "  br i1 " (concat cr ", label %"))
                                (concat doB (concat (concat ", label %" skB) "")))))
                          {
                            (let cgE (emitLabel cgD doB))
                            {
                              (let cgF
                                (if (== op 1)
                                  (emitRetainOf cgE v)
                                  (emitReleaseOf cgE v)))
                              {
                                (let cgG (emitLine cgF (concat "  br label %" skB)))
                                (emitLabel cgG skB)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; MM-LIFE-2d, the evidence consumer: a data cell whose declared
; field type is a TYPE VARIABLE takes its map bit from the call's
; stamp instead of falling to the leaf - constant bits fold into
; the stored constant, and a symbolic witness reads its bit out of
; the enclosing function's word at run time. A field the types
; cannot classify AND is not a variable (a Ptr, an alias) still
; forces the whole block to the leaf; a variable with no stamp, or
; a witness of 0, contributes no bit - which IS the leaf answer for
; that field, with every classifiable neighbour's bit kept.
(:: ctorFieldTypes (-> TypeEntry (Option Nodes)))
(fn (ctorFieldTypes entry)
  (if (== (eKind entry) TF_DATA)
    (eFieldTysVec entry)
    (match (eStructFields entry)
      ((None) None)
      ((Some fields)
        {
          (let types vecNew)
          (for field in fields
            (vecPush types (nodeTyChild field)))
          (Some types)
        }
      ))))

(:: ctorFieldBit (-> TypeEntry Int Int))
;@axiom:effect(io)
(fn (ctorFieldBit entry i)
  (+ 16
    (if (== (eKind entry) TF_DATA)
      (+ 1 i)
      (/ (structFieldOffset (requireStructFields entry) i) 8))))

(pub :: ctorShapeEmit (-> CG String TypeEntry ASTNode CG))
;@axiom:effect(io)
(pub fn (ctorShapeEmit cg ptr entry stamp)
  {
    (let kind (eKind entry))
    (let arity (eArity entry))
    {
      (let words (requireCtorWords entry))
      (if (|| (&& (!= kind TF_DATA) (!= kind TF_STRUCT)) (> words 47))
        (storeShapeAt cg ptr (requireCtorShapeConst cg entry))
        (match (ctorFieldTypes entry)
          ((None) (storeShapeAt cg ptr (requireCtorShapeConst cg entry)))
          ((Some ftys0)
            {
              (let mut anyVar 0)
              {
                {
                  (let mut j0 0)
                  (while (< j0 (vecLen ftys0))
                    {
                      (if (== (tyIsSrcVar (vecGet ftys0 j0)) 1)
                        (set anyVar 1))
                      (set j0 (+ j0 1))
                    })
                }
                (if (== anyVar 0)
                  ; no variable field: the static path allocates nothing
                  (storeShapeAt cg ptr (requireCtorShapeConst cg entry))
                  ; the ctor arrow's variable ordering = the fields walk,
                  ; in order - the checker's stamp walked fields-then-
                  ; result, and result-only variables sit past every
                  ; field index, so the prefix agrees by construction
                  {
                    (let cnt (paddedWords words))
                    (let ftys ftys0)
                    (let vars vecNew)
                    (let symPos vecNew)
                    (let symK vecNew)
                    (let lamPos vecNew)
                    (let lamD vecNew)
                    (let mut stat 0)
                    (let mut leaf 0)
                    {
                      (cgSigVarsVec ftys vars)
                      {
                        (let mut j 0)
                        (while (< j (vecLen ftys))
                          {
                            {
                              (let tn (vecGet ftys j))
                              (if (== (tyIsSrcVar tn) 1)
                                (if (! (nodeSame stamp nilNode))
                                  (match (strVecIdx vars (nodeAName tn))
                                    ((None) 0)
                                    ((Some vi)
                                      (if (< vi (vecLen (nodeBWords stamp)))
                                        {
                                          (let wv (as (vecGet (nodeBWords stamp) vi) Int))
                                          (if (== wv 1)
                                            (set stat (+ stat (pow2 (ctorFieldBit entry j))))
                                            (if (>= wv 2)
                                              {
                                                (vecPush symPos (ctorFieldBit entry j))
                                                (vecPush symK (- wv 2))
                                              }
                                              ; a lam-arg witness is dynamic
                                              ; too, but its bit comes from
                                              ; a DIFFERENT word - not the
                                              ; enclosing function's, the
                                              ; lambda's own argument
                                              ; evidence at depth d, bit 0 -
                                              ; so it cannot join `symPos`
                                              ; and gets its own loop below.
                                              (if (<= wv (- 0 2))
                                                {
                                                  (vecPush lamPos (ctorFieldBit entry j))
                                                  (vecPush lamD (- (- 0 2) wv))
                                                })))
                                        })
                                    )))
                                {
                                  (let c (fldClass cg tn))
                                  (if (== c 1)
                                    (set leaf 1)
                                    (if (== c 2)
                                      (set stat (+ stat (pow2 (ctorFieldBit entry j))))))
                                })
                            }
                            (set j (+ j 1))
                          })
                      }
                      (if (== leaf 1)
                        (storeShapeAt cg ptr (* cnt 2))
                        ; BOTH vectors, or a block whose only dynamic bit
                        ; is a lam-arg one stores the constant and drops
                        ; that bit - the leaf answer the release walk then
                        ; believes.
                        (if (&& (== (vecLen symPos) 0) (== (vecLen lamPos) 0))
                          (storeShapeAt cg ptr (+ (* cnt 2) stat))
                          ; the enclosing function's word is read only if
                          ; something reads a bit OUT of it; a block with
                          ; lam-arg bits alone would otherwise emit a dead
                          ; load.
                          {
                            (let cgR
                              (if (== (vecLen symPos) 0)
                                cg
                                (emitEvwRead cg)))
                            {
                              (let src
                                (if (== (vecLen symPos) 0)
                                  (constStr 0)
                                  (strDup (cgResult cgR))))
                              (let mut acc (constStr (+ (* cnt 2) stat)))
                              (let mut cgX cgR)
                              (let mut q 0)
                              {
                                (while (< q (vecLen symPos))
                                  {
                                    {
                                      (let an (allocReg cgX))
                                      {
                                        (let ar (regStr an))
                                        {
                                          (let cgA
                                            (emitLine cgX
                                              (concat
                                                (concat (concat "  " ar)
                                                  (concat " = lshr i64 " src))
                                                (concat ", "
                                                  (concat (constStr (as (vecGet symK q) Int))
                                                    "")))))
                                          {
                                            (let bn (allocReg cgA))
                                            {
                                              (let br (regStr bn))
                                              {
                                                (let cgB
                                                  (emitLine cgA
                                                    (concat (concat "  " br)
                                                      (concat " = and i64 " (concat ar ", 1")))))
                                                {
                                                  (let sn2 (allocReg cgB))
                                                  {
                                                    (let sr2 (regStr sn2))
                                                    {
                                                      (let cgS
                                                        (emitLine cgB
                                                          (concat
                                                            (concat (concat "  " sr2)
                                                              (concat " = shl i64 " br))
                                                            (concat ", "
                                                              (concat
                                                                (constStr
                                                                  (as (vecGet symPos q) Int))
                                                                "")))))
                                                      {
                                                        (let on (allocReg cgS))
                                                        {
                                                          (let orr (regStr on))
                                                          {
                                                            (set cgX (emitLine cgS
                                                                       (concat
                                                                         (concat (concat "  " orr)
                                                                           (concat " = or i64 "
                                                                             acc))
                                                                         (concat ", "
                                                                           (concat sr2 "")))))
                                                            (set acc orr)
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                    (set q (+ q 1))
                                  })
                                ; THE LAM-ARG BITS. One source register per
                                ; entry, not one for the whole loop: each
                                ; is `evwaSym d` resolved through the
                                ; symbol table, and the class sits at bit 0
                                ; because a lifted lambda absorbs exactly
                                ; one argument. `emitRetainIfLamArg` reads
                                ; it the same way, and the two must agree.
                                ;
                                ; No symbol - a body emitted outside a
                                ; lambda, which `evClassOf` should make
                                ; unreachable - contributes NO bit, so the
                                ; field goes uncounted and leaks. That is
                                ; the safe direction: a bit with no store
                                ; behind it is an over-release.
                                (set q 0)
                                (while (< q (vecLen lamPos))
                                  {
                                    (if (let (Some symIdx) (symIndex cgX
                                                             (evwaSym (as (vecGet lamD q) Int))))
                                      {
                                        (let bn (allocReg cgX))
                                        {
                                          (let br (regStr bn))
                                          {
                                            (let cgB
                                              (emitLine cgX
                                                (concat (concat "  " br)
                                                  (concat " = and i64 "
                                                    (concat (strDup (symRegAt cgX symIdx))
                                                      ", 1")))))
                                            {
                                              (let sn2 (allocReg cgB))
                                              {
                                                (let sr2 (regStr sn2))
                                                {
                                                  (let cgS
                                                    (emitLine cgB
                                                      (concat
                                                        (concat (concat "  " sr2)
                                                          (concat " = shl i64 " br))
                                                        (concat ", "
                                                          (concat
                                                            (constStr (as (vecGet lamPos q) Int))
                                                            "")))))
                                                  {
                                                    (let on (allocReg cgS))
                                                    {
                                                      (let orr (regStr on))
                                                      {
                                                        (set cgX (emitLine cgS
                                                                   (concat
                                                                     (concat (concat "  " orr)
                                                                       (concat " = or i64 " acc))
                                                                     (concat ", "
                                                                       (concat sr2 "")))))
                                                        (set acc orr)
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      })
                                    (set q (+ q 1))
                                  })
                                (storeShapeValAt cgX ptr acc)
                              }
                            }
                          }))
                    }
                  })
              }
            }
          )))
    }
  })

; ------------------------------------------------------------------
; The register-pair representation (docs/error-model.md).
;
; `(Some v)` is a 16-byte block - `axiom_alloc`, a shape word, a tag, a
; refcount and the field - that a matching consumer reads back and
; releases. Measured at 11.86 ns against 0.36 ns for a `{tag, payload}`
; pair returned in two registers, which is what these predicates decide
; the eligibility for.
;
; SPECIALISATION, NOT A GLOBAL REPRESENTATION CHANGE. A second
; definition `@F$pair` is emitted beside an unchanged `@F`, and only a
; `match` on a DIRECT call to `F` reads it. A pair therefore never
; reaches a `let` that outlives the match, a `Vec`, a struct field or
; another function's argument, so there is no storage boundary to
; coerce at and no share to transfer. Anything this does not recognise
; keeps the boxed path, so the failure mode is "no speedup" and not
; "wrong answer".
; ------------------------------------------------------------------
; The result of an arrow spine: the first `nodeB` that is not itself an
; arrow. `(-> Int (Option Int))` answers the `(Option Int)` node.
(pub :: arrowResultTy (-> (Option ASTNode) (Option ASTNode)))
(pub fn (arrowResultTy signature)
  (match signature
    ((None) None)
    ((Some ty)
      (if (== (nodeTag ty) TAG_T_ARR)
        (arrowResultTy (cgTypeNodeOpt (nodeBChild ty)))
        (Some ty))
    )))

; Is `rt` an `(Option T)` whose `T` is a machine word?
;
; DECIDED FROM THE DECLARED RETURN TYPE AND NOT FROM THE CONSTRUCTOR,
; because the constructor cannot answer it. `newCG` seeds `Some` with a
; field type of `(mkTVar "a")` - the builtin `Option` is polymorphic
; and its entry says only "one field, of some type". The concrete
; argument is in the signature, so that is where this looks.
;
; `T` MUST BE A MACHINE WORD. If the payload were a reference the block
; would own a share of it today and `axiom_release` would hand that
; share back; a pair has no refcount, so ownership would have to
; transfer to the consumer, and getting that wrong is a use-after-free
; rather than a slowdown. `fldClass` answering 0 is the same
; classification the reference maps are built from. Every row this
; unblocks - `internFind`, `strHexVal`, `utf8DecodeAt`, `utf8CharAt`,
; `keyStrEnd`, `strFindByte` - is `Option Int`, so the restriction
; costs nothing it was written for.
;
; `Option` BY NAME, as `fldClass` already matches it by name: it is
; seeded by the checker and never enters a module's data list, so there
; is no entry to ask. `Result` has two fieldful arms and is a later
; slice.
(pub :: pairRetOK (-> CG ASTNode Int))
;@axiom:effect(unsafe)
(pub fn (pairRetOK cg rt)
  (if (nodeSame rt nilNode)
    0
    (if (!= (nodeTag rt) TAG_T_CON)
      0
      {
        (let tn (as (nodeA rt) String))
        {
          (let args (nodeBChildren rt))
          (if (== (as args Int) 0)
            0
            (if (strEq tn "Option")
              (if (== (vecLen args) 1)
                (pairArgClassOK cg (vecGet args 0))
                0)
              (if (strEq tn "Err$Result")
                (if (== (vecLen args) 2)
                  (if (== (pairArgClassOK cg (vecGet args 0)) 1)
                    (pairArgClassOK cg (vecGet args 1))
                    0)
                  0)
                0)))
        }
      })))

; A payload type the pair can carry: a machine word (`fldClass` 0) or a
; REFERENCE (2). Unclassifiable (1) is refused, because the retain and
; the release below are decided from this answer and a wrong bit is a
; use-after-free rather than a leak - `scalarTyName`'s own rule.
(pub :: pairArgClassOK (-> CG ASTNode Int))
(pub fn (pairArgClassOK cg t)
  {
    (let c (fldClass cg t))
    (if (== c 0)
      1
      (if (== c 2)
        1
        0))
  })

; The class of the payload constructor `cname` carries, given the
; declared return type `rt`: 0 a machine word, 2 a reference, -1 no
; payload at all.
;
; POSITIONAL, AND BY NAME, for the two types this slice covers.
; `(pub data Result (a e) (Ok a) (Err e))` binds its parameters in
; order, so `Ok` takes argument 0 and `Err` argument 1; `Option`'s
; `Some` takes argument 0. The constructor entry cannot answer this -
; `newCG` seeds `Some` with `(mkTVar "a")` and `Result`'s arms are
; polymorphic too - so the mapping lives here rather than being
; derived from a field type that is a type variable. A third type
; wants its own line, which is why this refuses rather than guesses.
(pub :: pairPayloadClass (-> CG ASTNode String Int))
(pub fn (pairPayloadClass cg rt cname)
  {
    (let args (nodeBChildren rt))
    (if (== (as args Int) 0)
      (- 0 1)
      (if (strEq cname "Err$Err")
        (if (< (vecLen args) 2)
          (- 0 1)
          (fldClass cg (vecGet args 1)))
        (if (strEq cname "Some")
          (fldClass cg (vecGet args 0))
          (if (strEq cname "Err$Ok")
            (fldClass cg (vecGet args 0))
            (- 0 1)))))
  })

; The constructor entry a tail leaf answers, or 0 when the leaf is not
; one of the two shapes a pair can carry: a bare nullary reference
; (`None`) or a one-argument application (`(Some e)`).
; Is `name` one of the mangled names that got a `@F$pair`? The set is
; every `(Option T)`-answering function of the right shape in the
; program - a handful - so a scan is cheaper than an index and cannot
; go stale between `buildNameIndexes` and emission.
(pub :: pairNamesHas (-> Names String Int))
(pub fn (pairNamesHas names name)
  (if (== (as names Int) 0)
    0
    (pairNamesHasFrom names name 0)))

(pub :: pairNamesHasFrom (-> Names String Int Int))
(pub fn (pairNamesHasFrom names name i)
  (if (>= i (vecLen names))
    0
    (if (strEq (vecGetStr names i) name)
      1
      (pairNamesHasFrom names name (+ i 1)))))

(pub :: pairLeafEntry (-> CG ASTNode (Option TypeEntry)))
(pub fn (pairLeafEntry cg e)
  (if (nodeSame e nilNode)
    (None)
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        (if (== (pairCtorNamed (nodeAName e)) 1)
          (pairEntryOfArity cg (nodeAName e) 0)
          (None))
        (if (== tg TAG_E_APP)
          (if (!= (nodeTag (nodeAChild e)) TAG_E_VAR)
            (None)
            (if (== (pairCtorNamed (nodeAName (nodeAChild e))) 1)
              (pairEntryOfArity cg (nodeAName (nodeAChild e)) 1)
              (None)))
          (None)))
    }))

; The four constructor SPELLINGS a pair leaf or a pair arm may name.
; `pairPayloadClass` decides the payload's class from these names
; positionally, and a constructor it does not know answers -1 there -
; which `emitPairRet` reads as "no share to take". A user type whose
; constructor happens to be arity 1 and named otherwise would have been
; admitted by the entry test alone and then handed the consumer a
; share nobody retained. The checker's mirror (`tcPairCtorNamed`,
; core/typecheck.ax) holds the same four names, and the two lists
; must agree or the effect row is wrong about a leaf.
(pub :: pairCtorNamed (-> String Int))
(pub fn (pairCtorNamed n)
  (if (|| (strEq n "None") (|| (strEq n "Some") (|| (strEq n "Err$Ok") (strEq n "Err$Err"))))
    1
    0))

; A tail leaf that FORWARDS another pair function's answer: a
; saturated direct call to a function in the pair set, whose two
; registers are returned as they arrive. `utf8CharAt` ends in
; `(utf8DecodeAt s i)`, and without this the forwarding function would
; have to box what its callee just unboxed.
;
; `bound` is every name a `let` on the path here has bound, plus the
; parameters: a head that is one of those is a LOCAL, and the call
; goes through a closure record rather than to `@F$pair`. At emission
; the same question is asked of the symbol table (`emitPairFwd`), and
; the two answers agree because the names bound on the tail path are
; exactly the names in scope at the leaf.
(pub :: pairFwdOK (-> CG ASTNode Names Int))
(pub fn (pairFwdOK cg e bound)
  (if (!= (nodeTag e) TAG_E_APP)
    0
    {
      (let h (spineHead e))
      (if (!= (nodeTag h) TAG_E_VAR)
        0
        {
          (let n (nodeAName h))
          (if (isSome (strVecIdx bound n))
            0
            {
              (let full (mangledForCg cg n))
              (if (== (pairNamesHas (pairNames cg) full) 0)
                0
                {
                  (let sigFound (findFSigCg cg full))
                  (if (let (Some sig) sigFound)
                    (if (== (spineArgs e 0)
                          (match (fsigTy sig)
                            ((None) 0)
                            ((Some ty) (arrowArity ty))))
                      1
                      0)
                    0)
                })
            })
        })
    }))

; A fresh `(Vec Int)` holding the same string handles, for a walk that
; pushes and pops binders on it without touching the caller's vector.
(pub :: strVecCopy (-> Names Names))
(pub fn (strVecCopy xs)
  (strVecCopyFrom xs 0 vecNew))

(pub :: strVecCopyFrom (-> Names Int Names Names))
(pub fn (strVecCopyFrom xs i acc)
  (if (== (as xs Int) 0)
    acc
    (if (>= i (vecLen xs))
      acc
      (strVecCopyFrom xs (+ i 1) (vecPush acc (vecGet xs i))))))

; The entry `name` denotes when it is a `data` constructor of a type
; that unboxes its nullary arms (`rep` 2) and carries exactly `want`
; fields; `None` otherwise. Nested `if`s with one comparison each, for the
; code generation reasons the probe loops in `Map` record.
(pub :: pairEntryOfArity (-> CG String Int (Option TypeEntry)))
(pub fn (pairEntryOfArity cg name want)
  {
    (let enFound (lookupType (cgTypes cg) name))
    (if (let (Some en) enFound)
      (if (!= (eKind en) TF_DATA)
        (None)
        ; rep 2 mixes immediates with blocks (`Option`); rep 0 is all
        ; blocks (`Result`, whose arms both carry a field). rep 1 is
        ; all-nullary - already immediate, nothing to unbox.
        (if (&& (!= (eRep en) 2) (!= (eRep en) 0))
          (None)
          (if (!= (eArity en) want)
            (None)
            (Some en))))
      (None))
  })

; Is every TAIL leaf of `body` one of those two shapes?
;
; The walk hands tail position to exactly the sub-expression that
; inherits it, mirroring `emitExprTail` - which is what makes the
; answer here and the emission there agree about which leaves will be
; asked to build a pair. A shape this does not recognise - a `match`
; tail, a multi-binding `let`, a call answering an `Option` built
; elsewhere - answers 0, and the function keeps only its boxed
; definition. That is the whole safety argument: an unrecognised shape
; costs a speedup, never an answer.
(pub :: pairTailsOK (-> CG ASTNode Names Int))
(pub fn (pairTailsOK cg e bound)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_BEGIN)
        {
          (let xs (nodeAChildren e))
          (if (== (as xs Int) 0)
            0
            (if (== (vecLen xs) 0)
              0
              (pairTailsOK cg (vecGet xs (- (vecLen xs) 1)) bound)))
        }
        (if (== tg TAG_E_IF)
          (if (== (pairTailsOK cg (nodeBChild e) bound) 1)
            (pairTailsOK cg (nodeCChild e) bound)
            0)
          ; A `let` body inherits tail position (`emitLetAt`,
          ; `emitLetMAt`), and its binder is in scope there - pushed
          ; for the walk under it and popped on the way back, so a
          ; sibling branch does not see it.
          (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            {
              (let _p (vecPush bound (nodeAName e)))
              {
                (let r (pairTailsOK cg (nodeCChild e) bound))
                {
                  (vecPop bound)
                  r
                }
              }
            }
            (if (if (let (Some _) (pairLeafEntry cg e))
              true
              false)
              1
              (pairFwdOK cg e bound)))))
    }))

; Does this declaration get a `@F$pair`, with `@F` reduced to a boxing wrapper?
;
; Every clause is a REFUSAL, and each one is a hazard this slice
; declines rather than handles:
;
;   main            the entry point is named by the runtime
;   no signature    nothing to read a return type from
;   takesEv         an evidence word is a hidden parameter (MM-LIFE-2d)
;   return type     not `(Option T)` with `T` a machine word
;   tails           a leaf that is not `None`, `(Some e)`, `(Ok e)`,
;                   `(Err e)` or a forwarding call (`pairFwdOK`)
;   self tail call  TCO rewrites it into a jump to a loop header, and
;                   the pair variant would need its own
;
; THE BODY IS EMITTED ONCE, as `@F$pair`; `@F` is a wrapper that calls
; it and boxes (`emitPairWrapper`). Until 2026-09-03 the body was
; emitted TWICE, boxed and paired, which is why a lambda in it - lifted
; twice, two `define`s of one name - was a refusal here
; (`pairBodySimple`). Nothing is written twice now, so the shape
; clause is gone and a `while`, a `set` or a lambda in the body no
; longer costs the function its variant.
; The declared result type of `node`, or 0. What `pairPayloadClass`
; reads to decide whether a payload is a share or a word.
(:: requireSignatureResult (-> FSig ASTNode))
;@axiom:effect(io)
(fn (requireSignatureResult signature)
  (match (arrowResultTy (fsigTy signature))
    ((Some ty) ty)
    ((None)
      {
        (dieCodegenDiag "pair function has no result type: " (fsigName signature))
        mkTErr
      }
    )))

(pub :: pairRetTyOf (-> CG ASTNode (Option ASTNode)))
(pub fn (pairRetTyOf cg node)
  (if (let (Some signature) (findFSigCg cg (nodeAName node)))
    (arrowResultTy (fsigTy signature))
    None))

(pub :: pairFnOK (-> CG ASTNode Int))
(pub fn (pairFnOK cg node)
  {
    (let name (nodeAName node))
    (if (strEq name "main")
      0
      {
        (let eFound (findFSigCg cg name))
        (if (let (Some e) eFound)
          (if (!= (fsigTakesEv e) 0)
            0
            (if (==
                  (match (arrowResultTy (fsigTy e))
                    ((None) 0)
                    ((Some ty) (pairRetOK cg ty)))
                  0)
              0
              {
                (let body (nodeCChild node))
                (let bound (strVecCopy (nodeBNames node)))
                (if (== (pairTailsOK cg body bound) 0)
                  0
                  (if (== (tailCallsSelf body (bareOf name) (vecLen (nodeBNames node))) 1)
                    0
                    1))
              }))
          0)
      })
  })

; Does this tail match take the ordinary emitter? Exactly when the
; tail one would have declined the pair: the scrutinee is a pair call,
; the arms are pair shapes, a payload is a share, and the scrutinee is
; releasable - the case `emitPairArmsTail` cannot release in.
(pub :: pairTailDelegates (-> CG ASTNode Int))
(pub fn (pairTailDelegates cg node)
  {
    (let scrutExpr (nodeAChild node))
    (let arms (nodeBChildren node))
    (if (== (pairMatchOK cg scrutExpr arms) 0)
      0
      (if (==
            (match (pairScrutRetTy cg scrutExpr)
              ((None) 0)
              ((Some ty) (pairWordOnly cg ty)))
            1)
        0
        (scrutineeReleasable node scrutExpr cg)))
  })

; Every payload arm of the pair type `rt` a machine word? Then a pair
; of it owns nothing and a consumer has nothing to give back.
(pub :: pairWordOnly (-> CG ASTNode Int))
;@axiom:effect(unsafe)
(pub fn (pairWordOnly cg rt)
  (if (nodeSame rt nilNode)
    0
    (if (!= (nodeTag rt) TAG_T_CON)
      0
      (if (strEq (as (nodeA rt) String) "Option")
        (if (== (pairPayloadClass cg rt "Some") 0)
          1
          0)
        (if (&& (== (pairPayloadClass cg rt "Err$Ok") 0) (== (pairPayloadClass cg rt "Err$Err") 0))
          1
          0)))))

; The names in scope at the tail leaf `e`, as `pairFwdOK` wants them:
; the function's parameters, plus the leaf's head when a `let` has
; bound it here - enough, because the predicate asks only whether the
; HEAD is bound, and a bound local is what `lookupSym` answers for.
(pub :: pairBoundNames (-> CG ASTNode Names))
(pub fn (pairBoundNames cg e)
  {
    (let v
      (if (let (Some params) (cgParams cg))
        (strVecCopy params)
        vecNew))
    (let h (spineHead e))
    (if (!= (nodeTag h) TAG_E_VAR)
      v
      (if (hasSym cg (nodeAName h))
        (vecPush v (nodeAName h))
        v))
  })

; A forwarding tail leaf: the callee's pair, returned as it arrives.
; The arguments and the call are emitted here rather than through
; `emitPlainCall` so that nothing has to be armed and later checked
; for consumption - the walk decided this leaf forwards, and this is
; the emission that decision names.
(pub :: emitPairFwd (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitPairFwd e cg)
  {
    (let name (nodeAName (spineHead e)))
    (let args (spineArgVec e vecNew))
    (let argRegs vecNew)
    {
      (let cgA (emitArgsRegs args cg argRegs 0 name 0))
      {
        (let argStrT (strDup (cgArgsTyped cgA)))
        (let full (mangledForCg cgA name))
        (let r (regStr (allocReg cgA)))
        {
          (emitLine cgA
            (concat
              (concat (concat "  " r)
                (concat " = call { i64, i64 } @" (concat (llvmSym (strDup full)) "$pair")))
              (concat "(i64 " (concat argStrT ")"))))
          (releaseOwnedArgs cgA name args argRegs 0)
          ; the scope ends this `ret` leaves before, paid here as
          ; `emitPairRet` pays them: the callee has returned, and its
          ; pair holds its own share of anything it answers
          (releasePending cgA (cgPendingStrings cgA) 0)
          (releasePendingSlots cgA (pairOwningSlots cgA) 0)
          (emitLine cgA (concat "  ret { i64, i64 } " r))
          (cgSetTerminated cgA 1)
          cgA
        }
      }
    }
  })

; `@F` for a function in the pair set: call `@F$pair`, box what comes
; back, answer the block. It exists for the callers that do not name
; `F` at a call - a bare reference taken as a value goes through a
; thunk to this symbol - and for nothing else: every direct call is
; rewritten to the pair (`emitPlainCall`), and boxes there when it
; must. The body is not here; `emitFnDef` wrote it once, as the pair.
(pub :: emitPairWrapper (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitPairWrapper node cg)
  {
    (let name (nodeAName node))
    (let paramStr (emitParams (nodeBNames node) cg 0))
    (let resultType (pairRetTyOf cg node))
    (let _r (cgSetTmp cg 0))
    {
      (let sym (llvmSym (strDup name)))
      {
        (let cgH
          (emitLine cg
            (concat (concat "define i64 @" (concat sym (concat "(" paramStr))) ") #0 {")))
        {
          (let r (regStr (allocReg cgH)))
          {
            (let cgC
              (emitLine cgH
                (concat
                  (concat (concat "  " r) (concat " = call { i64, i64 } @" (concat sym "$pair")))
                  (concat "(" (concat paramStr ")")))))
            {
              (let cgB
                (if (let (Some rt) resultType)
                  (emitPairBox cgC rt r)
                  (cgFail cgC "AX4002" "pair wrapper has no checked result type")))
              (emitLine (emitLine cgB (concat "  ret i64 " (strDup (cgResult cgB)))) "}")
            }
          }
        }
      }
    }
  })

; Box the pair in register `r` into the block a boxed constructor of
; `rt` would have built - the same shape word, tag, count and field
; store `emitConstructor` writes - leaving the block (or, for `None`,
; the immediate tag) in field 2.
;
; THE PAYLOAD IS MOVED, never retained. A reference payload arrives
; in the pair as an OWNED share (`emitPairRet` takes one when the
; value did not already own one), and the block takes that share as
; its field, exactly as a directly-built construction's field takes
; the share of the temporary it was built from.
(pub :: emitPairBox (-> CG ASTNode String CG))
;@axiom:effect(unsafe)
;@axiom:effect(io)
(pub fn (emitPairBox cg rt r)
  {
    (let tr (regStr (allocReg cg)))
    (let pr (regStr (allocReg cg)))
    (let _1
      (emitLine cg
        (concat (concat "  " tr) (concat " = extractvalue { i64, i64 } " (concat r ", 0")))))
    (let _2
      (emitLine cg
        (concat (concat "  " pr) (concat " = extractvalue { i64, i64 } " (concat r ", 1")))))
    (if (strEq (as (nodeA rt) String) "Option")
      (emitPairBoxOption cg rt tr pr)
      (emitPairBoxResult cg rt tr pr))
  })

; `Option`: the `None` tag is its own immediate; `Some` is a block.
(pub :: emitPairBoxOption (-> CG ASTNode String String CG))
;@axiom:effect(io)
(pub fn (emitPairBoxOption cg rt tr pr)
  (if (let (Some noneE) (pairEntryOfArity cg "None" 0))
    (if (let (Some someE) (pairEntryOfArity cg "Some" 1))
      {
        (let lNone (labelStr (allocReg cg)))
        (let lSome (labelStr (allocReg cg)))
        (let lMerge (labelStr (allocReg cg)))
        (let c (regStr (allocReg cg)))
        (let _1
          (emitLine cg
            (concat (concat "  " c)
              (concat " = icmp eq i64 " (concat tr (concat ", " (constStr (eTag noneE))))))))
        (let _2
          (emitLine cg
            (concat (concat "  br i1 " (concat c ", label %"))
              (concat lNone (concat (concat ", label %" lSome) "")))))
        (let _3 (emitLabel cg lSome))
        (let blk (emitPairBoxBlock cg someE (pairPayloadClass cg rt "Some") pr))
        (let _4 (emitLine cg (concat "  br label %" lMerge)))
        (let _5 (emitLabel cg lNone))
        (let _6 (emitLine cg (concat "  br label %" lMerge)))
        (let _7 (emitLabel cg lMerge))
        (let res (regStr (allocReg cg)))
        (let _8
          (emitLine cg
            (concat (concat (concat "  " res) (concat " = phi i64 [ " blk))
              (concat (concat ", %" (concat lSome " ], [ "))
                (concat (concat (constStr (eTag noneE)) (concat ", %" lNone)) " ]")))))
        {
          (cgSetResult cg res)
          (cgSetResultFloat cg 0)
          cg
        }
      }
      (cgFail cg "missing pair constructor: " "Some"))
    (cgFail cg "missing pair constructor: " "None")))

; `Result`: both arms are blocks, and they differ in the shape word
; when one payload is a share and the other a word.
(pub :: emitPairBoxResult (-> CG ASTNode String String CG))
;@axiom:effect(io)
(pub fn (emitPairBoxResult cg rt tr pr)
  (if (let (Some okE) (pairEntryOfArity cg "Err$Ok" 1))
    (if (let (Some errE) (pairEntryOfArity cg "Err$Err" 1))
      {
        (let lOk (labelStr (allocReg cg)))
        (let lErr (labelStr (allocReg cg)))
        (let lMerge (labelStr (allocReg cg)))
        (let c (regStr (allocReg cg)))
        (let _1
          (emitLine cg
            (concat (concat "  " c)
              (concat " = icmp eq i64 " (concat tr (concat ", " (constStr (eTag okE))))))))
        (let _2
          (emitLine cg
            (concat (concat "  br i1 " (concat c ", label %"))
              (concat lOk (concat (concat ", label %" lErr) "")))))
        (let _3 (emitLabel cg lOk))
        (let b1 (emitPairBoxBlock cg okE (pairPayloadClass cg rt "Err$Ok") pr))
        (let _4 (emitLine cg (concat "  br label %" lMerge)))
        (let _5 (emitLabel cg lErr))
        (let b2 (emitPairBoxBlock cg errE (pairPayloadClass cg rt "Err$Err") pr))
        (let _6 (emitLine cg (concat "  br label %" lMerge)))
        (let _7 (emitLabel cg lMerge))
        (let res (regStr (allocReg cg)))
        (let _8
          (emitLine cg
            (concat (concat (concat "  " res) (concat " = phi i64 [ " b1))
              (concat (concat ", %" (concat lOk " ], [ "))
                (concat (concat b2 (concat ", %" lErr)) " ]")))))
        {
          (cgSetResult cg res)
          (cgSetResultFloat cg 0)
          cg
        }
      }
      (cgFail cg "missing pair constructor: " "Err$Err"))
    (cgFail cg "missing pair constructor: " "Err$Ok")))

; One 16-byte block: tag word and one field, a share or a word by
; `cls`. The shape is what `ctorShapeConst` computes for a two-word
; data cell whose field 0 is a reference (bit 17) or is not - written
; out here because the constructor's own entry cannot answer it (its
; field type is the variable `a`) and the class is already known.
(pub :: emitPairBoxBlock (-> CG TypeEntry Int String String))
(pub fn (emitPairBoxBlock cg entry cls pr)
  {
    (let p (regStr (allocReg cg)))
    {
      (emitLine cg (concat (concat "  " p) (concat " = call i64 @axiom_alloc(i64 16)" "")))
      (storeShapeAt cg p
        (+ (* (paddedWords 2) 2)
          (if (== cls 2)
            (pow2 17)
            0)))
      (storeWordAt cg p 0 (constStr (eTag entry)))
      (storeCountOneAt cg p)
      (storeWordAt cg p 1 pr)
      p
    }
  })

; A tail leaf answering `None` or `(Some e)`, as a two-register return.
;
; No block, no shape word, no refcount, and nothing for the consumer to
; release. `pairRetOK` has already established that the payload is a
; machine word, so there is no share to take and event 2's
; retain-the-tail-leaf does not apply.
;
; The leaf terminates its own block, which is why field 31 is set: the
; tail plumbing above - `emitIfTail`, `emitSeqTail`, `emitLetAt` -
; already knows how to handle an arm that did that, and
; `emitFnDef` already knows not to write a `ret` after one.
;
; So the leaf pays the scope ends it leaves before, as a self tail
; jump does (`emitTailJump`): every releasable `let` on the tail path
; (word 42) and every owning `mut` slot (pair slot 17). `emitLetAt`
; and `emitLetMAt` skip their release after a terminated body, so
; without this a `let` around a pair leaf kept its share for good -
; and a resource owner bound there, such as the `TermGuard` `termRaw`
; answers, never ran its cleanup (MM-EXEC-17). The payload's own share
; is taken first, so a payload that is one of those values survives
; its binding's release, exactly as a boxed field store's does.
; The constructor a pair leaf names: `None` from a bare reference,
; `Some` from the head of an application.
(pub :: pairCtorNameOf (-> ASTNode String))
(pub fn (pairCtorNameOf e)
  (if (== (nodeTag e) TAG_E_VAR)
    (nodeAName e)
    (if (== (nodeTag e) TAG_E_APP)
      (nodeAName (nodeAChild e))
      "")))

(pub :: emitPairRet (-> ASTNode TypeEntry CG CG))
;@axiom:effect(io)
(pub fn (emitPairRet e entry cg)
  (if (== (eArity entry) 0)
    {
      (releasePending cg (cgPendingStrings cg) 0)
      (releasePendingSlots cg (pairOwningSlots cg) 0)
      (emitLine cg
        (concat (concat "  ret { i64, i64 } { i64 " (constStr (eTag entry))) ", i64 0 }"))
      (cgSetTerminated cg 1)
      cg
    }
    ; A REFERENCE payload takes a share, because the block this
    ; replaces took one (`fieldRetainCode`) and the consumer
    ; releases it on the way out of the match. A value that is
    ; already a fresh construction owns its share and is moved,
    ; which is the same exception `emitFieldStores` makes.
    ; A REFERENCE payload takes a share only when the value does
    ; not already own one. `emitFieldStores` reaches the same place
    ; by a longer road - it retains, stores, and then releases the
    ; temporary again when `valueOwnedRef` says the value arrived
    ; owned - which is a MOVE written as +1 -1. Here it is written
    ; as nothing at all.
    ;
    ; Getting this wrong is not a crash, it is a LEAK, and the
    ; first version of this line retained unconditionally:
    ; `(Err (mkError ...))` answered an owned `Error`, took a
    ; second share, and the consumer's single release left one
    ; behind - 13.5 MB against 1.28 MB over 100,000 iterations.
    {
      (let cgA (emitExpr (nodeBChild e) cg))
      {
        (let v (strDup (cgResult cgA)))
        (let _rt
          (if (match (cgPairResultType cg)
            ((None) false)
            ((Some resultType) (== (pairPayloadClass cg resultType (pairCtorNameOf e)) 2)))
            (if (== (valueOwnedRef cgA (nodeBChild e)) 1)
              cgA
              (emitRetainOf cgA v))
            cgA))
        (let r0 (regStr (allocReg cgA)))
        (let r1 (regStr (allocReg cgA)))
        {
          (emitLine cgA
            (concat
              (concat "  "
                (concat r0
                  (concat " = insertvalue { i64, i64 } undef, i64 " (constStr (eTag entry)))))
              ", 0"))
          (emitLine cgA
            (concat (concat "  " (concat r1 (concat " = insertvalue { i64, i64 } " r0)))
              (concat ", i64 " (concat v ", 1"))))
          (releasePending cgA (cgPendingStrings cgA) 0)
          (releasePendingSlots cgA (pairOwningSlots cgA) 0)
          (emitLine cgA (concat "  ret { i64, i64 } " r1))
          (cgSetTerminated cgA 1)
          cgA
        }
      }
    }))

; ------------------------------------------------------------------
; Constructor emission: alloc + shape + field stores.
; ------------------------------------------------------------------
(pub :: emitConstructor (-> Nodes TypeEntry ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitConstructor args entry stamp cg)
  ; A nullary constructor of any type that unboxes (all-nullary OR
  ; mixed) is its immediate tag - stage0's S1 representation. The
  ; match sites carry the matching discipline: direct compare when
  ; the pattern names an unboxed constructor, a guarded tag read when
  ; a fieldful pattern's scrutinee might be an immediate sibling.
  {
    (let kind (eKind entry))
    (let arity (eArity entry))
    (let ctorTag (eTag entry))
    (let rep (eRep entry))
    (if (&& (== kind TF_DATA) (&& (== arity 0) (!= rep 0)))
      {
        (cgSetResult cg (constStr ctorTag))
        cg
      }
      (if (&& (== kind TF_STRUCT) (== arity 0))
        {
          (cgSetResult cg (constStr 0))
          cg
        }
        ; `axiom_alloc` answers a machine word like everything
        ; else, so the block address stays an `i64` and only
        ; becomes a `ptr` at the point of each store.
        ; the allocator stamped the LEAF inside the call;
        ; this store overwrites it with the site's record
        ; shape - one redundant word store per
        ; construction, the price of a site-agnostic
        ; allocator
        ; A1: the constructing expression's own share
        {
          (let size
            (if (== kind TF_DATA)
              (* (+ arity 1) 8)
              (structPayloadBytes (requireStructFields entry))))
          {
            (let ptrN (allocReg cg))
            {
              (let ptr (regStr ptrN))
              {
                (let allocInst
                  (concat (concat "  " ptr)
                    (concat " = call i64 @axiom_alloc(i64 " (concat (constStr size) ")"))))
                {
                  (let cg1 (emitLine cg allocInst))
                  {
                    (let cgS (ctorShapeEmit cg1 ptr entry stamp))
                    {
                      (let cg2
                        (if (== kind TF_DATA)
                          (storeWordAt cgS ptr 0 (constStr ctorTag))
                          cgS))
                      {
                        (let base
                          (if (== kind TF_DATA)
                            1
                            0))
                        {
                          (let cgC (storeCountOneAt cg2 ptr))
                          {
                            (let cg3 (emitFieldStores cgC ptr args 0 base entry stamp))
                            {
                              (cgSetResult cg3 ptr)
                              cg3
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }))
  })

; Store `val` at word `idx` of the block whose address is in `base`.
; An `inttoptr` folded into the `getelementptr` operand would be a
; constant expression, and a constant expression cannot name a register.
; It gets its own instruction.
(pub :: storeWordAt (-> CG String Int String CG))
(pub fn (storeWordAt cg base idx val)
  {
    (let pn (allocReg cg))
    {
      (let pr (regStr pn))
      {
        (let cg1
          (emitLine cg
            (concat (concat "  " pr) (concat " = inttoptr i64 " (concat base " to ptr")))))
        {
          (let an (allocReg cg1))
          {
            (let ar (regStr an))
            {
              (let cg2
                (emitLine cg1
                  (concat (concat (concat "  " ar) (concat " = getelementptr i64, ptr " pr))
                    (concat ", i64 " (concat (fmtInt idx) "")))))
              (emitLine cg2 (concat "  store i64 " (concat val (concat ", ptr " ar))))
            }
          }
        }
      }
    }
  })

; MM-LIFE-2c event 6: a block's REFERENCE fields are stored owned -
; a borrowed value is retained on the way in, a directly-built
; construction MOVES (its birth count IS the field's share; a retain
; would double-count). The classification mirrors ctorShapeEmit
; exactly: the retain set and the shape word's map must agree, or
; the walk at death returns counts the stores never took. Retains
; here are BALANCED by construction: the cell's own map walks these
; fields when it dies. tyvar fields with a symbolic witness retain
; under the same evidence-bit guard the shape store uses.
(pub :: argIsDirectCon (-> CG ASTNode Int))
(pub fn (argIsDirectCon cg an)
  {
    (let tg (nodeTag an))
    (if (== tg TAG_E_STRUCTCON)
      1
      (if (== tg TAG_E_LAM)
        1
        (if (== tg TAG_E_APP)
          {
            (let h (spineHead an))
            (if (!= (nodeTag h) TAG_E_VAR)
              0
              (if (||
                    (&& (|| (== (nodeDefScope h) 1) (! (isLocalValue cg (nodeAName h))))
                      (hasType (cgTypes cg) (nodeAName h)))
                    (&& (strEq (nodeAName h) "__resource_new") (== (spineArity an) 2)))
                1
                0))
          }
          0)))
  })

; the innermost head of an application spine (codegen's own walk;
; the checker's spineHead lives in another module)
; -1 = no retain, 1 = unconditional, k>=0 encoded as 2+k = evidence
; bit k - the same per-field answer ctorShapeEmit derives
(pub :: fieldRetainCode (-> CG TypeEntry ASTNode Int Int))
(pub fn (fieldRetainCode cg entry stamp j)
  (match (fieldTypeNode entry j)
    ((None) (- 0 1))
    ((Some tn)
      (if (== (tyIsSrcVar tn) 1)
        (if (nodeSame stamp nilNode)
          (- 0 1)
          {
            (let vars vecNew)
            {
              (match (ctorFieldTypes entry)
                ((None) 0)
                ((Some fields) (cgSigVarsVec fields vars)))
              (match (strVecIdx vars (nodeAName tn))
                ((None) (- 0 1))
                ((Some vi)
                  (if (>= vi (vecLen (nodeBWords stamp)))
                    (- 0 1)
                    {
                      (let wv (as (vecGet (nodeBWords stamp) vi) Int))
                      (if (== wv 1)
                        1
                        (if (>= wv 2)
                          wv
                          ; `EV_LAMARG - d` (<= -2) is the enclosing
                          ; lifted lambda's own argument, whose class
                          ; only the APPLICATION knows. Pass the
                          ; witness through UNCHANGED: -1 already
                          ; means "no retain" and 1 / >=2 are taken,
                          ; so the negative range is the free one, and
                          ; `emitFieldStores` decodes the depth back
                          ; out of it the way `emitPrimRetainRef`
                          ; does. Answering -1 here is what left the
                          ; store uncounted while the shape word said
                          ; leaf.
                          (if (<= wv (- 0 2))
                            wv
                            (- 0 1))))
                    })
                ))
            }
          })
        (if (== (fldClass cg tn) 2)
          1
          (- 0 1)))
    )))

(pub :: emitFieldStores (-> CG String Nodes Int Int TypeEntry ASTNode CG))
;@axiom:effect(io)
(pub fn (emitFieldStores cg ptr args i base entry stamp)
  (if (>= i (vecLen args))
    cg
    ; an owned temporary stored with an unconditional
    ; retain has handed its share to the field: release
    ; the one it arrived with (a direct construction
    ; MOVED, and answered rc -1 above)
    ; the lam-arg twin of the bit-k guard above, and it
    ; MUST land with `ctorShapeEmit`'s bit: the map the
    ; walk reads at death and the retain set here are
    ; one claim, so a bit without its retain is an
    ; over-release and a retain without its bit a leak.
    {
      (let argNode (vecGet args i))
      {
        (let cg1 (emitExpr argNode cg))
        {
          (let reg (strDup (cgResult cg1)))
          {
            (let rc
              (if (== (argIsDirectCon cg1 argNode) 1)
                (- 0 1)
                (fieldRetainCode cg1 entry stamp i)))
            {
              (let cgR
                (if (== rc 1)
                  (emitRetainOf cg1 reg)
                  (if (>= rc 2)
                    (emitRetainIfEvBit cg1 reg (- rc 2))
                    (if (<= rc (- 0 2))
                      (emitRetainIfLamArg cg1 reg (- (- 0 2) rc))
                      cg1))))
              {
                (let cgS
                  (if (== (eKind entry) TF_STRUCT)
                    {
                      (let fields (requireStructFields entry))
                      (storeStructFieldAt cgR ptr (structFieldOffset fields i)
                        (nodeTyChild (vecGet fields i)) reg)
                    }
                    (storeWordAt cgR ptr (+ base i) reg)))
                {
                  (let cgT
                    (if (&& (== rc 1)
                          (&& (== (isStaticSentinelNode cgS argNode) 0)
                            (== (valueOwnedRef cgS argNode) 1)))
                      (emitReleaseOf cgS reg)
                      (if (&& (>= rc 2) (closureOwnedCall cgS argNode))
                        {
                          (let cgW (emitEvwRead cgS))
                          (emitRcIfBitOf cgW reg (- rc 2) (strDup (cgResult cgW)) 0)
                        }
                        cgS)))
                  (emitFieldStores cgT ptr args (+ i 1) base entry stamp)
                }
              }
            }
          }
        }
      }
    }))

; ------------------------------------------------------------------
; E_Let / E_If / E_Begin.
; ------------------------------------------------------------------
(pub :: emitLet (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitLet node cg)
  (emitLetAt node cg 0))

; `tail` is 1 when the let itself sits in tail position, so its body
; does too and a borrowed leaf there gets event 2's retain.
(pub :: emitLetAt (-> ASTNode CG Int CG))
;@axiom:effect(io)
(pub fn (emitLetAt node cg tail)
  ; The binding remembers whether its initialiser was a float, so a
  ; later `(+ x ...)` on the bound name picks the right instruction.
  ; And it ends with its body: without the restore, a shadowing
  ; binding's register - possibly defined in a branch block that
  ; does not dominate later uses - kept resolving the name after
  ; the `let` was over.
  ; asked before the binder exists: `(let ((x x)) ...)` reads the
  ; slot, and the new `x` must not answer for it
  {
    (let name (nodeAName node))
    (let valExpr (nodeBChild node))
    (let body (nodeCChild node))
    {
      (let cg1 (emitExpr valExpr cg))
      {
        (let valReg (strDup (cgResult cg1)))
        (let valFlag (cgResultFloat cg1))
        (let mark (symMark cg1))
        ; Resolve ownership before this binding can shadow its initialiser.
        (let owned (letOwned cg1 valExpr))
        (let slotAlias (slotReadOf cg1 valExpr))
        {
          (bindSym cg1 name valReg valFlag
            (if (|| (== owned 1)
                  (|| (== slotAlias 1)
                    (&& (== (nodeTag valExpr) TAG_E_VAR)
                      (== (lookupSymKind cg1 (nodeAName valExpr)) 3))))
              3
              0))
          ; a `let` of a REFERENCE FIELD read takes its own share, when
          ; the walk says the binding does not escape: the field's share
          ; is the block's, and a store to the field (event 5) releases
          ; the old value under a borrowed alias - `(let ((t r.name))
          ; { (set r.name new) (println t) })` read freed bytes. The
          ; share is handed back at scope end like an owned value's.
          ; a releasable binding is PENDING while its body emits: a
          ; self tail call inside the body jumps back to the loop
          ; header and never reaches the scope end, so `emitTailJump`
          ; pays every pending share before the jump
          ; In tail position the binding may also be the let's value
          ; when every tail leaf takes a share of its own on the way
          ; out (`tailLeavesCovered`): the leaf's share is taken before
          ; the scope end gives this one back. `(let ((t o.f)) { (set
          ; o.f None) t })` answered a freed block without it.
          ;
          ; A `let` bound to a call that answers a counted value without a
          ; share of its own - a type-variable result such as `vecGet`'s,
          ; instantiated at a counted type - borrows it from whatever holds
          ; it, and a store there can release it under the binding: in
          ; `(let ((t (vecGet v j))) { (vecSet v j x) (vecSet v k t) })` the
          ; first `vecSet` freed the block the second stored. So it takes a
          ; share as a field read does, under `lendCls`: 1, or `2+k` for
          ; bit k of this function's evidence word.
          ; a value a call TRANSFERS is already the binding's share
          ; (MM-LIFE-2n): nothing to take, and the same hand-back at
          ; scope end as a borrowed one - plain for a counted type,
          ; under the evidence bit for a type variable
          ; a `let` of an OWNING `mut` slot's value takes its own share
          ; whatever the walk says: a `set` of the slot releases what it
          ; held, and the slot's scope end releases its last value, so a
          ; borrowed alias would dangle past either. The slot's escape
          ; walk counts on this (`escapes`, the `let` arm). The share
          ; goes back at scope end when the binding doesn't escape, or
          ; when it escapes only as the value of a `let` in tail
          ; position whose every tail leaf is retained on the way out
          ; (`slotReleasesAtEnd`), as an owning slot's last value does.
          {
            (let fieldCand
              (if (&& (== (nodeTag valExpr) TAG_E_FIELD) (== (fieldReadIsScalar cg1 valExpr) 0))
                1
                0))
            (let lendCls (lendClass cg1 valExpr))
            (let held
              (if (&& (== fieldCand 0) (== lendCls 0))
                0
                {
                  (let bnd (binderSummary body))
                  (if (== (escapes cg1 name body 1 bnd) 0)
                    1
                    (if (&& (== tail 1)
                          (&& (== (escapes cg1 name body 0 bnd) 0)
                            (== (tailLeavesCovered cg1 body) 1)))
                      1
                      0))
                }))
            ; Its share guards against a store in the scope releasing the
            ; value under it. A scope that writes nothing cannot, so the
            ; binding borrows, as a parameter does.
            (let guarded
              (if (== held 1)
                (scopeMayWrite cg1 body)
                false))
            (let fieldAlias
              (if (&& (== fieldCand 1) guarded)
                1
                0))
            (let borrowCls
              (if guarded
                lendCls
                0))
            (let ownCls (letTransferClass cg1 valExpr name body))
            {
              (let cg1
                (if (|| (== fieldAlias 1) (|| (== slotAlias 1) (== borrowCls 1)))
                  (emitRetainOf cg1 valReg)
                  (if (>= borrowCls 2)
                    (emitRetainIfEvBit cg1 valReg (- borrowCls 2))
                    cg1)))
              {
                (let releasable
                  (if (|| (== fieldAlias 1) (|| (== borrowCls 1) (== ownCls 1)))
                    1
                    (if (== slotAlias 1)
                      {
                        (let bnd (binderSummary body))
                        (if (== (escapes cg1 name body 0 bnd) 1)
                          0
                          (slotReleasesAtEnd cg1 node tail bnd))
                      }
                      (letReleasable cg1 owned name body))))
                {
                  (let pmark (vecLen (cgPendingStrings cg1)))
                  {
                    ; A binding whose initialiser IS a string literal is
                    ; not pending either: the register holds a
                    ; `-1`-sentinel static, and the tail jump's release
                    ; of it would be the same runtime no-op the scope
                    ; end below skips. `windowsExternLibsFrom` binds its
                    ; marker so and loops by a self tail call
                    ; (check-static-release, the compiler's own IR).
                    (if (&& (== releasable 1) (== (isStaticSentinelNode cg1 valExpr) 0))
                      (cgPendingPush cg1 valReg)
                      0)
                    {
                      (let cgB
                        (if (== tail 1)
                          (emitExprTail body cg1)
                          (emitExpr body cg1)))
                      {
                        (cgPendingTruncate cgB pmark)
                        (symRestore cgB mark)
                        ; MM-LIFE-2c event 3. The release goes HERE - at the
                        ; binding's scope end, in the block that defines its
                        ; register - rather than before the function's `ret`,
                        ; because a `let` inside a branch defines a register that
                        ; does not dominate the return. Not when the body ended
                        ; in a jump: that block is terminated, the jump path has
                        ; already paid, and an instruction after a terminator is
                        ; not LLVM.
                        ;
                        ; S4 slice 2, scope-end path: a `let` initialiser the
                        ; witness proved fresh is reclaimed by the region's
                        ; reset exactly as an argument temporary is, so its
                        ; scope-end release is the same binary-only traffic.
                        ; The depth gate is the same textual extent the
                        ; args path owns, and `releasable` still says 1 -
                        ; the DECISION is untouched, only its spending is
                        ; conditional, and the pending vector above still
                        ; takes the share for the tail-jump path, which
                        ; keeps its release. Inlined rather than factored
                        ; so no new top-level function moves the
                        ; effect-distribution pins. `emitLetMAt` spends
                        ; no stamp: an owning slot's scope-end release
                        ; is of whatever the slot holds by then, which
                        ; no initialiser's witness describes.
                        ; S4 slice 3, scope-end path: a `let` initialiser
                        ; that is a join the witness proved fresh spends
                        ; the same way - same depth gate, same
                        ; `releasable` decision left untouched with only
                        ; its spending conditional, same pending vector
                        ; for the tail-jump path.
                        ; A `let` initialiser that IS a string literal
                        ; spends the same way for a dumber reason: the
                        ; binding is immutable, so the register still
                        ; holds the literal at scope end (SSA - the
                        ; name cannot have been reused for another
                        ; value), and releasing a `-1`-sentinel static
                        ; is the runtime no-op `isStaticSentinelNode`
                        ; already names at the argument and field
                        ; sites. The join caveat there applies here
                        ; too: only a bare literal initialiser spends,
                        ; never a join that merely has a literal arm.
                        ; Same shape as the stamp spends above -
                        ; `releasable` still says 1 - and the pending
                        ; vector asks the same predicate before taking
                        ; the share for the tail-jump path, so an
                        ; ablation of it restores every one of these
                        ; releases, scope end and jump alike, with the
                        ; other sites'.
                        (if (&& (== releasable 1)
                              (&& (!= (cgTerminated cgB) 1)
                                (== (isStaticSentinelNode cgB valExpr) 0)))
                          (if (&& (!= (cgRegionDepth cgB) 0)
                                (&&
                                  (|| (== (nodeTag valExpr) TAG_E_APP)
                                    (|| (== (nodeTag valExpr) TAG_E_IF)
                                      (== (nodeTag valExpr) TAG_E_MATCH)))
                                  (&& (== (nodeResWord valExpr) 2) (dropFreeExpr cgB valExpr))))
                            cgB
                            {
                              (let res (strDup (cgResult cgB)))
                              (let cgR (emitReleaseOf cgB valReg))
                              {
                                (cgSetResult cgR res)
                                cgR
                              }
                            })
                          ; a share taken under an evidence bit goes back
                          ; under the same bit; a jump out of the body
                          ; skips it, which leaks
                          (if (&& (|| (>= borrowCls 2) (>= ownCls 2)) (!= (cgTerminated cgB) 1))
                            {
                              (let res (strDup (cgResult cgB)))
                              (let cgW (emitEvwRead cgB))
                              (let bitCls
                                (if (>= borrowCls 2)
                                  borrowCls
                                  ownCls))
                              {
                                (let cgR
                                  (emitRcIfBitOf cgW valReg (- bitCls 2) (strDup (cgResult cgW)) 0))
                                {
                                  (cgSetResult cgR res)
                                  cgR
                                }
                              }
                            }
                            cgB))
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; The same question for a value a call transfers (`transferClass`): the
; class to hand the binding's own share back under at scope end when
; the binding does not escape, else 0 (the share then leaves with it).
(pub :: letTransferClass (-> CG ASTNode String ASTNode Int))
(pub fn (letTransferClass cg valExpr name body)
  {
    (let cls (transferClass cg valExpr))
    (if (== cls 0)
      0
      (if (== (escapes cg name body 1 (binderSummary body)) 1)
        0
        cls))
  })

; Whether argument `i` of a call to `fnName` is one the result may be
; borrowed from (the callee's return mask names it), is an owned
; temporary, a transferred value or a lent one here, and is neither
; parked nor consumed by the callee - so the caller may hand its share
; back once the result has taken a share of its own.
;
; A LENT argument - `(vecGet v 0)`, or a counted field read - brings no
; share, so `emitArgsRegs` takes one when it is evaluated. Without it,
; `(f v (vecGet v 0))` where `f` overwrites slot 0 and answers its
; type-variable parameter answered the block the overwrite had freed:
; measured, the caller's `println` of the result printed its own format
; buffer, which had been allocated over it. The result keeps the share
; instead, and is transferred from the call on.
;
; Only BESIDE its container (`lentBeside`): a callee can overwrite the
; place a lent argument came from only if it can reach the container,
; and the call that hands it over is the one this compiler can see.
; `(vecGet (vecGet vv i) j)` and `(vecGet r.items k)` stay lent - the
; accessor overwrites nothing - and transferring them cost a share and
; a hand-back at every one of the compiler's own nested reads.
;
; Owned or transferred arguments are asked by `tyvarResultClass`, not
; by `transferClass`: every transferred value is a counted
; type-variable result, so the two answer alike here, and this one
; does not walk the argument's own arguments again.
(pub :: borrowedFromOwnedArg (-> CG String Nodes Int Int))
(pub fn (borrowedFromOwnedArg cg fnName args i)
  ; A string literal is static: it owns nothing to hand back, and
  ; `(unwrapOr cwd "")` released its `""` (check-static-release).
  {
    (let a (vecGet args i))
    (if (&& (== (isStaticSentinelNode cg a) 0)
          (&&
            (&& (!= (& (fnRetMask cg fnName) (anyBit i)) 0)
              (|| (== (valueOwnedRef cg a) 1)
                (if (!= (tyvarResultClass cg a) 0)
                  (|| (== (lendClass cg a) 0) (== (lentBeside args i) 1))
                  (&& (!= (fieldArgClass cg a) 0) (== (lentBeside args i) 1)))))
            (&& (== (& (fnCallStashMask cg fnName args) (| (paramBit i) (ownerBit i))) 0)
              (== (& (fnConsumeMask cg fnName) (| (paramBit i) (ownerBit i))) 0))))
      1
      0)
  })

; Does another argument of the call mention the variable argument `i`
; is lent from - the root of a field read's base, or of a lending
; call's first argument? `(f v (vecGet v 0))` and `(f b b.name)` are
; beside; a root with no name answers 0.
(pub :: lentBeside (-> Nodes Int Int))
(pub fn (lentBeside args i)
  {
    (let root (lentRoot (vecGet args i) 8))
    (if (== (strLen root) 0)
      0
      {
        (let mut j 0)
        (let mut hit 0)
        {
          (while (&& (== hit 0) (< j (vecLen args)))
            {
              (if (&& (!= j i) (== (mentions root (vecGet args j)) 1))
                (set hit 1)
                0)
              (set j (+ j 1))
            })
          hit
        }
      })
  })

; The variable a lent value is read out of: a field read's base, or a
; call's first argument, followed at most `n` levels; "" for anything
; else.
(pub :: lentRoot (-> ASTNode Int String))
(pub fn (lentRoot e n)
  (if (|| (nodeSame e nilNode) (<= n 0))
    ""
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        (nodeAName e)
        (if (== tg TAG_E_FIELD)
          (lentRoot (nodeAChild e) (- n 1))
          (if (&& (== tg TAG_E_APP) (>= (spineArity e) 1))
            (lentRoot (spineArgAt e 0) (- n 1))
            "")))
    }))

; Whether any argument of the call is such a temporary.
(pub :: borrowedFromOwnedAny (-> CG String Nodes Int Int))
(pub fn (borrowedFromOwnedAny cg fnName args i)
  (if (>= i (vecLen args))
    0
    (if (== (borrowedFromOwnedArg cg fnName args i) 1)
      1
      (borrowedFromOwnedAny cg fnName args (+ i 1)))))

; The class of a counted value a call lends from an owned temporary:
; `(vecGet (fresh) 0)`, where the vector the element is borrowed from
; is itself a temporary the caller owns. The call site retains the
; result and releases the temporary (`emitPlainCall`), so the result
; stops being lent and becomes transferred - the caller's share,
; handed back wherever a transferred value's is. 0 when the result
; is not such a value.
(pub :: borrowedFromOwnedClass (-> CG ASTNode Int))
(pub fn (borrowedFromOwnedClass cg valExpr)
  ; `result(owned)` (`vecPop`) already hands the caller a share of
  ; its own; retaining it again here kept every popped element
  {
    (let cls
      (if (== (tyvarResultTransfers cg valExpr) 1)
        0
        (tyvarResultClass cg valExpr)))
    (if (== cls 0)
      0
      {
        (let args (spineArgVec valExpr vecNew))
        (if (== (borrowedFromOwnedAny cg (spineHeadName valExpr) args 0) 1)
          cls
          0)
      })
  })

; The class of a counted value a call LENDS: a signed global applied at
; its arity whose declared result is a type variable, which retains
; nothing on return (`vecGet`), at a counted instantiation. 1 for a
; counted type, `2+k` for this function's type variable k, 0 otherwise.
; A value lent from an owned temporary is not lent: it is transferred
; (`borrowedFromOwnedClass`), because its holder is going away.
(pub :: lendClass (-> CG ASTNode Int))
(pub fn (lendClass cg valExpr)
  (if (== (tyvarResultTransfers cg valExpr) 1)
    0
    (if (!= (borrowedFromOwnedClass cg valExpr) 0)
      0
      (tyvarResultClass cg valExpr))))

; The class of a counted value a call TRANSFERS: the same shape as a
; lent one, from a function that says `;@axiom:result(owned)`
; (MM-LIFE-2n, `vecPop`), so the caller holds the share and must hand
; it back - at a `let`'s scope end, after a call it was an argument
; to, or on the spot when it is discarded. 0 for a lent or unknown
; result.
(pub :: transferClass (-> CG ASTNode Int))
(pub fn (transferClass cg valExpr)
  (if (== (tyvarResultTransfers cg valExpr) 1)
    (tyvarResultClass cg valExpr)
    (borrowedFromOwnedClass cg valExpr)))

; Does the call's callee say `result(owned)`?
(pub :: tyvarResultTransfers (-> CG ASTNode Int))
(pub fn (tyvarResultTransfers cg valExpr)
  (if (!= (nodeTag valExpr) TAG_E_APP)
    0
    {
      (let hd (spineHead valExpr))
      (if (!= (nodeTag hd) TAG_E_VAR)
        0
        (fsigTransfer cg (nodeAName hd)))
    }))

; The class of a counted type-variable result: a signed global applied
; at its arity whose declared result is a type variable, at a counted
; instantiation. 1 for a counted type, `2+k` for this function's type
; variable k, 0 otherwise. Whether the share is lent or transferred is
; the callee's claim, read by `lendClass` and `transferClass`.
(pub :: tyvarResultClass (-> CG ASTNode Int))
(pub fn (tyvarResultClass cg valExpr)
  (if (!= (nodeTag valExpr) TAG_E_APP)
    0
    {
      (let hd (spineHead valExpr))
      (if (!= (nodeTag hd) TAG_E_VAR)
        0
        {
          (let n (nodeAName hd))
          (if (|| (isCastName n) (|| (isPrimName n) (isLocalValue cg n)))
            0
            (if (|| (! (hasFSigCg cg (mangledForCg cg n))) (!= (fnResultClass cg n) 1))
              0
              (if (! (fnArityMatches cg n (spineArity valExpr)))
                0
                {
                  (let st (nodeBinderTyChild valExpr))
                  (if (if (nodeSame st nilNode)
                    true
                    (|| (!= (nodeTag st) TAG_EVSTAMP)
                      (! (cgDeclarationMatches cg (nodeCChild st)))))
                    0
                    ; A class the stamp could not give when the call was
                    ; checked may have been decided by a pin later in the
                    ; body (`evSettle`): read the stamped type through
                    ; its pins, and take a counted one as 1.
                    {
                      (let cls
                        (if (< (nodeB st) 0)
                          (pinnedClass cg (pinnedTy (nodeAChild st) 64))
                          (nodeB st)))
                      (if (|| (== cls 1) (>= cls 2))
                        cls
                        0)
                    })
                })))
        })
    }))

; Is this a call whose declared result is a type variable, at an
; instantiation the checker's stamp, read through its pins, makes a
; machine scalar (`fldClass` 0)? `(vecGet v i)` over a `(Vec Int)` is
; one: what it answers is a number. A call with no stamp of this
; function's, or one whose type is not yet known, answers 0.
(pub :: tyvarResultScalar (-> CG ASTNode Int))
(pub fn (tyvarResultScalar cg valExpr)
  (if (!= (nodeTag valExpr) TAG_E_APP)
    0
    {
      (let hd (spineHead valExpr))
      (if (!= (nodeTag hd) TAG_E_VAR)
        0
        {
          (let n (nodeAName hd))
          (if (|| (isCastName n) (|| (isPrimName n) (isLocalValue cg n)))
            0
            {
              (let eFound (findFSigCg cg (mangledForCg cg n)))
              (if (let (Some e) eFound)
                (if (! (fnArityMatches cg n (spineArity valExpr)))
                  0
                  {
                    (let resFound (fnDeclaredResultTy (fsigTy e) (fnArityCg cg n)))
                    (if (match resFound
                      ((None) true)
                      ((Some res) (!= (nodeTag res) TAG_T_VAR)))
                      0
                      {
                        (let st (nodeBinderTyChild valExpr))
                        (if (if (nodeSame st nilNode)
                          true
                          (|| (!= (nodeTag st) TAG_EVSTAMP)
                            (! (cgDeclarationMatches cg (nodeCChild st)))))
                          0
                          (if (== (fldClass cg (pinnedTy (nodeAChild st) 64)) 0)
                            1
                            0))
                      })
                  })
                0)
            })
        })
    }))

; The class a pinned type answers for a lent `let` (`emitLetAt`): 1 for a counted
; type, `2+k` for this function's own type variable k (bit k of its
; evidence word), and 0 for anything else, a lambda's body included.
(pub :: pinnedClass (-> CG ASTNode Int))
(pub fn (pinnedClass cg t)
  (if (nodeSame t nilNode)
    0
    (if (== (fldClass cg t) 2)
      1
      (if (!= (tyIsSrcVar t) 1)
        0
        {
          (let k (curSigVarBit cg (nodeAName t)))
          (match k
            ((None) 0)
            ((Some k) (+ 2 k)))
        }))))

; Bit index of the current function's type variable `n` in its evidence
; word, or None: inside a lambda, in a function that takes no word, or for
; a name its signature doesn't bind.
(pub :: curSigVarBit (-> CG String (Option Int)))
(pub fn (curSigVarBit cg n)
  (if (== (cgLiftedLambda cg) 1)
    None
    {
      (let d (cgCurDecl cg))
      (if (let (Some d) d)
        {
          (let eFound (findFSigCg cg (nodeAName d)))
          (if (let (Some e) eFound)
            (if (== (fsigTakesEv e) 0)
              None
              {
                (let vars vecNew)
                {
                  (if (let (Some ty) (fsigTy e))
                    (cgSigVarsInto ty vars)
                    0)
                  (strVecIdx vars n)
                }
              })
            None)
        }
        None)
    }))

; `t` followed through its pins: an instantiation placeholder (`_iN`)
; the checker pinned answers what it was pinned to, at most `n` links
; deep. Anything else answers itself.
(pub :: pinnedTy (-> ASTNode Int ASTNode))
(pub fn (pinnedTy t n)
  (if (|| (nodeSame t nilNode) (<= n 0))
    t
    (if (!= (nodeTag t) TAG_T_VAR)
      t
      {
        (let nm (nodeAName t))
        (if (&& (>= (strLen nm) 2)
              (&& (== (strByte nm 0) 95) (&& (== (strByte nm 1) 105) (!= (nodeB t) 0))))
          (pinnedTy (nodeBChild t) (- n 1))
          t)
      })))

; Is this `let` binding one the frame may release when its scope ends?
;
; Two conditions, and both are syntactic on purpose - MM-LIFE-2c's
; events 2 and 3 are stated over an escape analysis this compiler does
; not have, and what it does have is a shape whose answer needs none.
;
;   the INITIALISER is a direct construction, so the binding holds the
;   block's birth share and no one else's - the same predicate the
;   statement-position release already spends (`argIsDirectCon`);
;
;   the NAME does not reach the let's VALUE - not bare, and not
;   through a field of the block either. A field that is itself a
;   reference took its own share at construction (event 6), but that
;   share belongs to the BLOCK: the block's death walks its map and
;   hands every one of them back, so a field read in value position
;   aliases memory the release is about to free. This condition used
;   to admit field reads on the ground that "a read answers a field,
;   never the block", and the QA sweep measured what that admitted:
;
;     (fn (mk tag) (let ((b (Mk (concat "id-" tag)))) (match b ((Mk s) s))))
;     (println (mk "one"))      -> six NUL bytes, not `id-one`
;
;   The destructured `s` was returned, the block was released first,
;   its map released the string, and the caller read the allocator's
;   scrub through a dangling reference. `b.f` in value position and
;   `(let ((t b.f)) t)` were the same defect in two more spellings.
;   `escapes` now treats a field read whose base mentions the name,
;   and a match binder destructured from it, as the name itself.
;
; The second condition is decided by a walker that defaults to ESCAPES:
; a tag it does not recognise answers 1, so widening the surface is a
; deliberate edit rather than an omission. That is the direction that
; leaks rather than the one that frees early, which is the asymmetry
; this whole strategy turns on.
(pub :: letReleasable (-> CG Int String ASTNode Int))
(pub fn (letReleasable cg owned name body)
  (if (!= owned 1)
    0
    (if (== (escapes cg name body 1 (binderSummary body)) 1)
      0
      1)))

; Can the frame release this initialiser? A construction supplies its
; birth share, and a reference-returning call supplies a result share.
; Immortal strings and named-function descriptors also permit release,
; so a join with a fresh branch does not lose that branch's ownership.
; Reads of parameters, local aliases and fields remain borrowed.
(pub :: letOwned (-> CG ASTNode Int))
(pub fn (letOwned cg valExpr)
  (valueOwnedRef cg valExpr))

; Could the binding OUTLIVE this frame through `e`?
;
; Positional, because the answer depends on where the name stands. In
; VALUE position - the expression whose value the `let` answers - a
; bare mention escapes, because that value flows to the caller with no
; share taken. In STATEMENT position, and in ARGUMENT position of a
; call that is not itself the value, it does not: a callee borrows
; (event 1), and every store a callee can make takes a share (a field
; store by event 5, a constructor field by event 6, a container or any
; other word store through `memSetWord`, which retains by MM-LIFE-2g).
;
; What a callee KEEPS or ANSWERS is decided by the callee's own flow
; masks (`inferFlows`, `callEscapesArg`): an argument mentioning the
; binding escapes when the callee stashes that parameter - parks it
; uncounted through a `cast` into a word field, a slot, a raw store,
; a capture, or a stashing callee - or consumes it, a `__release` of
; the parameter ending the caller's share (`mapFree`, `fnConsumeMask`)
; - and, in VALUE position, when the callee's result is a word that
; may be part of it. A callee whose
; result is a counted reference answers a share of its own (event 2,
; `borrowedTailLeaves`), so `(fn (ident s) s)` hands back a retained
; `s` and the argument's share is untouched. Only a GLOBAL with a
; signature has masks: a parameter or local named like one, bound
; outside the let (the symbol table still holds it) or inside its
; body (`binderSummary`), is a function value nothing signed, as is the
; binding itself applied, and every argument it is given escapes. A
; field of the block that is itself a reference, in value position,
; and a `match` binder - a field under another name - are the block
; too (`letReleasable` carries the measurement).
;
; Three shapes escape whatever their position, and each is a place the
; invariant above does not reach:
;
;   a LAMBDA that mentions an unclassified binding. Counted captures
;     take their own share, so their outer binding may release its own;
;   a `set` RHS - a slot store takes no share, unless it stores into
;     a slot of a reference type (`slotStoreCounts`);
;   `cast`, `__addr` and `strData` - the three ways to get a WORD out
;     of a reference. A word stashed anywhere is invisible to counting
;     by construction (MM-LIFE-2g's own stated limit), so a binding
;     that reaches one of them is the program's to keep alive.
;
; Every tag this walk does not know answers ESCAPE, so the surface
; widens by deliberate edit and never by omission.
;
; `bound` is `binderSummary` of the walk's root: every name bound
; anywhere under it, which `callEscapesArg` asks about each call head.
; It used to be the root itself, walked again for every call the walk
; met, so a `let` of n bindings each built by a
; call took time cubic in n (AN-54: 1,000 bindings took 11 s to reach
; LLVM IR).
(pub :: escapes (-> CG String ASTNode Int BinderSummary Int))
(pub fn (escapes cg name e vp bound)
  (if (nodeSame e nilNode)
    0
    (if (== (nodeResWord e) 3)
      (escapes cg name (nodeBChild e) vp bound)
      {
        (let tg (nodeTag e))
        (if (|| (== tg TAG_E_INT) (|| (== tg TAG_E_FLT) (|| (== tg TAG_E_STR) (== tg TAG_E_CHAR))))
          0
          (if (== tg TAG_E_LAM)
            ; a capture takes its own share when the binding the lambda
            ; reads is counted (`captureCounted`). The symbol table names
            ; that binding only when nothing under the root binds the
            ; name again; an alias the walk follows is bound under the
            ; root, so its capture is a plain mention
            (if (&& (>= (lookupSymKind cg name) 3) (== (boundIn name bound) 0))
              0
              (mentions name e))
            (if (== tg TAG_E_VAR)
              (if (strEq (nodeAName e) name)
                vp
                0)
              (if (== tg TAG_E_FIELD)
                ; a field READ answers the field - which the block owns, so
                ; in VALUE position reading a REFERENCE field of the
                ; binding is the binding escaping (see `letReleasable`); a
                ; machine-scalar field cannot alias the block and its read
                ; still releases; in argument position the callee borrows
                ; the field as it would the block
                (if (== (escapes cg name (nodeAChild e) 0 bound) 1)
                  1
                  (if (&& (== vp 1) (== (mentions name (nodeAChild e)) 1))
                    (if (== (fieldReadIsScalar cg e) 1)
                      0
                      1)
                    0))
                (if (== tg TAG_E_APP)
                  (if (== (wordTakingHead (spineHead e)) 1)
                    ; `cast`/`__addr`/`strData` of the binding hands out a
                    ; word, and a word takes no share: in VALUE position
                    ; the word is the let's value and the binding escapes;
                    ; in argument position its consumer decides - a call
                    ; by its masks in the word's form, a raw store, a
                    ; constructor's word field, a `set` - and the operands
                    ; are walked for what they contain
                    (if (== vp 1)
                      (mentions name e)
                      (if (== (escapes cg name (nodeAChild e) 0 bound) 1)
                        1
                        (escapes cg name (nodeBChild e) 0 bound)))
                    ; a CALL keeps or answers an argument only as its
                    ; flow masks say (`callEscapesArg`); otherwise a
                    ; callee borrows, and the arguments are walked in
                    ; argument position
                    (if (== (callEscapesArg cg e name vp bound) 1)
                      1
                      ; arithmetic and `&&`/`||` answer an operand's
                      ; word: `(+ (asWord s) 0)` in value position is
                      ; `(asWord s)` in value position
                      {
                        (let vp2
                          (if (== (passesValueHead (spineHead e)) 1)
                            vp
                            0))
                        (if (== (escapes cg name (spineHead e) vp2 bound) 1)
                          1
                          (escapesSeq cg name (callFlowArgs e) vp2 0 bound))
                      }))
                  (if (== tg TAG_E_IF)
                    (if (== (escapes cg name (nodeAChild e) 0 bound) 1)
                      1
                      (if (== (escapes cg name (nodeBChild e) vp bound) 1)
                        1
                        (escapes cg name (nodeCChild e) vp bound)))
                    (if (== tg TAG_E_BEGIN)
                      (escapesSeq cg name (nodeAChildren e) vp 0 bound)
                      (if (== tg TAG_E_MATCH)
                        ; the arms' binders are the scrutinee's fields, owned by
                        ; the block exactly as a field read's answer is: when the
                        ; scrutinee mentions the binding, a binder reaching the
                        ; match's value is the binding reaching it
                        (if (== (escapes cg name (nodeAChild e) 0 bound) 1)
                          1
                          (if (== (escapesArms cg name (nodeBChildren e) vp 0 bound) 1)
                            1
                            (if (== (mayAlias cg name (nodeAChild e) bound) 1)
                              (escapesViaBinders cg (nodeBChildren e) vp 0 bound)
                              0)))
                        ; `cond` is AX2004: the parser builds none, so no
                        ; arm asks after one's escapes. A variadic `if`
                        ; arrives as nested `if`s.
                        (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
                          ; the initialiser inherits the position: `(let ((t s)) t)`
                          ; makes the binding the let's value through an alias - and
                          ; an alias that may hold (part of) the block is then asked
                          ; the same question under its own name, in the same
                          ; position, so `(let ((t s)) (set r t))` in a statement is
                          ; seen for the stash it is. An initialiser that can only
                          ; be a machine word - an operator's answer, a scalar
                          ; field - aliases nothing and is exempt.
                          ; The initialiser is walked in ARGUMENT position: it is
                          ; not the let's value, its binder is, and the alias step
                          ; below carries whatever reaches the binder on to the
                          ; body - `(let ((t b.f)) t)` escapes through `t`, while
                          ; `(let ((t b.f)) (strLen t))` no longer does.
                          (if (== (escapes cg name (nodeBChild e) 0 bound) 1)
                            1
                            (if (== (escapes cg name (nodeCChild e) vp bound) 1)
                              1
                              ; ... except a `let` of an owning `mut` slot read
                              ; bare, which takes a share of its own
                              ; (`emitLetAt`, `slotAlias`): where that binding
                              ; goes is its own business, not the slot's
                              (if (== (mayAlias cg name (nodeBChild e) bound) 1)
                                (if (&& (== tg TAG_E_LET)
                                      (&& (== (nodeTag (nodeBChild e)) TAG_E_VAR)
                                        (&& (strEq (nodeAName (nodeBChild e)) name)
                                          (&& (== (slotReadOf cg (nodeBChild e)) 1)
                                            (== (boundIn name bound) 0)))))
                                  0
                                  (escapes cg (nodeAName e) (nodeCChild e) vp bound))
                                0)))
                          (if (|| (== tg TAG_E_WHILE) (== tg TAG_E_REGION))
                            (if (== tg TAG_E_REGION)
                              (escapes cg name (nodeBChild e) vp bound)
                              (if (== (escapes cg name (nodeAChild e) 0 bound) 1)
                                1
                                (escapesSeq cg name (nodeBChildren e) 0 0 bound)))
                            (if (== tg TAG_E_SET)
                              ; a slot store takes no share - of what REACHES the slot:
                              ; the binding itself, a word of it, not a length or a sum
                              ; computed from it (`(set k (strLen s))` beside a self
                              ; tail call kept every iteration's string). And the value
                              ; is walked in argument position for what it PARKS on the
                              ; way: a lambda capturing the binding, a constructor's
                              ; word field, a callee that stashes it. A slot of a
                              ; reference type is the exception: its store retains
                              ; what it is given, as a field store does
                              ; (`slotStoreCounts`)
                              (if (&& (!= (bindingFlow cg name (nodeBChild e)) 0)
                                    (== (slotStoreCounts cg e bound) 0))
                                1
                                (escapes cg name (nodeBChild e) 0 bound))
                              (if (== tg TAG_E_SETF)
                                ; `(set b.f v)` retains v into a REFERENCE field (event 5),
                                ; so the base is a borrow and the value walks in argument
                                ; position. A WORD field takes no share of what REACHES
                                ; it, as a slot store takes none: the binding as a word,
                                ; through a `cast` or a callee that answers one, escapes,
                                ; and a number computed from it does not - `(set n.left
                                ; (linkTo nodes i))` kept every node vector alive. The
                                ; value walks in argument position for what it parks
                                (if (== (escapes cg name (nodeAChild e) 0 bound) 1)
                                  1
                                  (if (&& (== (fieldReadIsScalar cg e) 1)
                                        (!= (bindingFlow cg name (nodeCChild e)) 0))
                                    1
                                    (escapes cg name (nodeCChild e) 0 bound)))
                                (mentions name e)))))))))))))
      })))

(pub :: escapesSeq (-> CG String Nodes Int Int BinderSummary Int))
(pub fn (escapesSeq cg name v vp i bound)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (==
            (escapes cg name (vecGet v i)
              (if (== i (- (vecLen v) 1))
                vp
                0)
              bound)
            1)
        1
        (escapesSeq cg name v vp (+ i 1) bound)))))

; A match arm's word 2 is its body, and it inherits the position.
; An arm PATTERN cannot mention an outer binding as a value.
(pub :: escapesArms (-> CG String (Vec ASTNode) Int Int BinderSummary Int))
(pub fn (escapesArms cg name v vp i bound)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (== (escapes cg name (nodeBChild (vecGet v i)) vp bound) 1)
        1
        (escapesArms cg name v vp (+ i 1) bound)))))

; Does any arm's PATTERN BINDER escape through that arm's body? Each
; binder is a field of the scrutinee's block, so the question is the
; one `escapes` asks of the binding itself, asked of the binder in the
; match's own position: bare in value position, a field of it in
; value position, destructured again by an inner match, handed to a
; call whose answer is the match's value - and, in ANY position, a
; `set` RHS or a lambda capture, which is why this runs for a match in
; statement position too (`(match b ((Mk s) (set r s)))` stashed a
; reference the walker never looked at). A pattern shape this walk
; cannot enumerate binders for answers ESCAPE, the walker's rule.
; ERR-MEM-4. A binder is a candidate for carrying a reference out of
; the scrutinee only if it could hold one. `patBindersEsc` drops the
; binders the checker stamped with a machine-scalar type: the same
; argument `escapes` already makes for a field read one line down -
; a word copied out of a block cannot alias it, so releasing the
; block after the match cannot dangle the word.
;
; Measured before it: `(match (step i) ((Ok v) v) ((Err e) 0))` over
; `step : (-> Int (Result Int String))` grew the arena 32 bytes per
; iteration, and so did the `let`-bound spelling; a match whose arms
; bind NOTHING grew 0. The 32 bytes were the `Result` block, and the
; only thing holding it was `v`, an `Int`.
(pub :: escapesViaBinders (-> CG (Vec ASTNode) Int Int BinderSummary Int))
(pub fn (escapesViaBinders cg arms vp i bound)
  (if (== (as arms Int) 0)
    0
    (if (>= i (vecLen arms))
      0
      {
        (let arm (vecGet arms i))
        {
          (let bs (patBindersEsc cg (nodeAChild arm) vecNew))
          (if (== (as bs Int) 0)
            1
            (if (== (escapesAny cg bs (nodeBChild arm) vp 0 bound) 1)
              1
              (escapesViaBinders cg arms vp (+ i 1) bound)))
        }
      })))

(pub :: escapesAny (-> CG Names ASTNode Int Int BinderSummary Int))
(pub fn (escapesAny cg names body vp i bound)
  (if (>= i (vecLen names))
    0
    (if (== (escapes cg (vecGetStr names i) body vp bound) 1)
      1
      (escapesAny cg names body vp (+ i 1) bound))))

; Could a `let` initialiser that mentions `name` hand the new binder
; a reference into the block? Anything that mentions it may, except
; the shapes that can only answer a word: a literal, an operator or
; primitive applied to anything, and a read of a scalar field.
(pub :: mayAlias (-> CG String ASTNode BinderSummary Int))
(pub fn (mayAlias cg name init bound)
  (if (== (mentions name init) 0)
    0
    {
      (let tg (nodeTag init))
      (if (== tg TAG_E_APP)
        (if (== (passesValueHead (spineHead init)) 1)
          ; `(+ (asWord s) 0)` aliases what `(asWord s)` does
          (mayAliasArgs cg name init (spineArity init) bound 0)
          (callEscapesArg cg init name 1 bound))
        (if (== tg TAG_E_FIELD)
          (if (== (fieldReadIsScalar cg init) 1)
            0
            1)
          1))
    }))

(pub :: mayAliasArgs (-> CG String ASTNode Int BinderSummary Int Int))
(pub fn (mayAliasArgs cg name e n_ bound i)
  (if (>= i n_)
    0
    (if (== (mayAlias cg name (spineArgAt e i) bound) 1)
      1
      (mayAliasArgs cg name e n_ bound (+ i 1)))))

; Does this call let `name` out of the frame? By the callee's own
; flow masks (`inferFlows`): an argument mentioning `name` escapes
; when the callee STASHES that parameter, and, in value position,
; when the callee's result is a word that may be (part of) it. A
; callee whose result is a counted reference answers a share of its
; own (event 2), so the argument's is untouched. Only a GLOBAL with a
; signature has masks: a parameter or local named like one - bound
; outside the let, where the symbol table still holds it, or inside
; its body, where only the text does (`binderSummary`) - is a function
; value nothing signed, as is the binding itself applied, and every
; argument it is given escapes. A raw store's value escapes; a
; constructor's arguments are judged below, field by field, by the
; walk (a word field takes a `cast`, which escapes on its own).
(pub :: callEscapesArg (-> CG ASTNode String Int BinderSummary Int))
(pub fn (callEscapesArg cg e name vp bound)
  {
    (let hd (spineHead e))
    (let n_ (spineArity e))
    (if (!= (nodeTag hd) TAG_E_VAR)
      (mentionsArgs name e n_ 0)
      {
        (let n (nodeAName hd))
        (if (strEq n name)
          ; Invoking a typed closure borrows its record. Known reference
          ; results have their own share, and a word cannot own it.
          (if (== (fldClass cg (checkedValueTy e)) 1)
            (mentions name e)
            0)
          (if (|| (isBinop n) (|| (isCmpOp n) (isAndOr n)))
            0
            (if (isPrimName n)
              (if (&& (|| (strEq n "__store64") (strEq n "__store8")) (>= n_ 3))
                (mentions name (spineArgAt e 2))
                ; a function reached by address may keep what it is
                ; handed
                (if (|| (strEq n "__call_word")
                      (|| (strEq n "__axiom_recover") (strEq n "__axiom_stack_run")))
                  (mentionsArgs name e n_ 0)
                  ; a `__release` of the binding ends its share: the
                  ; caller must not hand it back, exactly as if a
                  ; consuming callee had taken it
                  (if (strEq n "__release")
                    (mentionsArgs name e n_ 0)
                    0)))
              (if (== (headIsLocal cg n bound) 1)
                (mentionsArgs name e n_ 0)
                (if (hasFSigCg cg (mangledForCg cg n))
                  ; the STASH mask pairs by form - a word-form park counts
                  ; a typed arrival (`__retainref`), a typed park does not
                  ; catch a word - but the RET mask names what the RESULT
                  ; aliases, and a word the callee answers of a parameter
                  ; it cast aliases the typed argument just the same:
                  ; `(fn (asWord s) (cast Int s))` handed back a pointer
                  ; into a `let` this walk then released. It is read at
                  ; this call's instantiation (`callRetMask`): an `Int`
                  ; read out of a `(Vec Int)` is a number. The CONSUME
                  ; mask rides beside the stash mask: an argument the
                  ; callee ends is gone, so it escapes whatever the
                  ; position, and the scope-end release stays off it.
                  ; A tail-retained result already holds its own share, so the
                  ; argument it was borrowed from can be released with the
                  ; scope. Leaving that ret-mask escape on kept a named
                  ; vector alive after `(vecGet rows 0)` returned.
                  (argsEscapeByMask cg name e n_
                    (| (| (fnCallStashMask cg n (callFlowArgs e)) (fnConsumeMask cg n))
                      (if (&& (== vp 1)
                            (&& (!= (fnResultClass cg n) 2)
                              (== (nodeInVec (cgTailRetain cg) e 0) 0)))
                        (bothForms (callRetMask cg e n))
                        0))
                    0)
                  {
                    (let entryFound (lookupType (cgTypes cg) n))
                    (if (let (Some entry) entryFound)
                      ; a constructor: a reference field retains what it
                      ; is given (event 6) and is walked in argument
                      ; position by the caller; a WORD field parks it,
                      ; and a word of the binding can arrive there
                      ; through any function, not only a visible `cast`
                      (ctorWordFieldsMention cg entry name e n_ 0 bound)
                      ; an effect operation, or a name nothing signed
                      (mentionsArgs name e n_ 0))
                  })))))
      })
  })

(pub :: passesValueHead (-> ASTNode Int))
(pub fn (passesValueHead h)
  (if (!= (nodeTag h) TAG_E_VAR)
    0
    (if (|| (isBinop (nodeAName h)) (|| (isAndOr (nodeAName h)) (isWordLoadName (nodeAName h))))
      ; a 64-bit load answers a word of what its address aliases
      1
      0)))

; A word field parks what it is given, so the binding escapes there
; when the word may be (part of) it (`wordArgAliases`). A mention alone
; is not that: `((Some a) (Some (strLen a)))` parks a length, and
; reading it as the binding kept every scrutinee's payload - 96 to 128
; bytes an iteration, measured over a `match` whose arm built an
; `Option Int` from a `String` binder.
(pub :: ctorWordFieldsMention (-> CG TypeEntry String ASTNode Int Int BinderSummary Int))
(pub fn (ctorWordFieldsMention cg entry name e n_ i bound)
  (if (>= i n_)
    0
    {
      (let tn (fieldTypeNode entry i))
      (if (&& (== (ctorFieldParks cg entry e tn i) 1)
            (== (wordArgAliases cg name (spineArgAt e i) bound) 1))
        1
        (ctorWordFieldsMention cg entry name e n_ (+ i 1) bound))
    }))

; May the word `arg` answers be (part of) `name`? A `cast`, `__addr`,
; `strData` or `strOwner` of it is; arithmetic and loads answer a word
; of what their operands may be; a call answers one only as its flow
; masks say (`callEscapesArg` in value position), so `(strLen a)` is a
; length; a scalar field is a number; any other shape that mentions
; the name may be it.
(pub :: wordArgAliases (-> CG String ASTNode BinderSummary Int))
(pub fn (wordArgAliases cg name arg bound)
  (if (== (mentions name arg) 0)
    0
    (if (== (nodeTag arg) TAG_E_APP)
      {
        (let hd (spineHead arg))
        (if (== (wordTakingHead hd) 1)
          1
          (if (== (passesValueHead hd) 1)
            {
              (let mut i 0)
              (let mut hit 0)
              {
                (while (&& (== hit 0) (< i (spineArity arg)))
                  {
                    (set hit (wordArgAliases cg name (spineArgAt arg i) bound))
                    (set i (+ i 1))
                  })
                hit
              }
            }
            (callEscapesArg cg arg name 1 bound)))
      }
      (if (== (nodeTag arg) TAG_E_FIELD)
        (if (== (fieldReadIsScalar cg arg) 1)
          0
          1)
        1))))

; Does field i of this construction PARK what it is given - take no
; share? A word field does; so does a type-variable field at a site
; whose witness collapsed to "no retain" (`fieldRetainCode` -1): the
; emitter stores the value uncounted there, whatever the field's
; declaration says. The stamp sits on the constructor's name node.
(pub :: ctorFieldParks (-> CG TypeEntry ASTNode (Option ASTNode) Int Int))
(pub fn (ctorFieldParks cg entry e tn i)
  (match tn
    ((None) 1)
    ((Some ty)
      (if (== (fldClass cg ty) 0)
        1
        (if (== (fldClass cg ty) 1)
          (if (== (fieldRetainCode cg entry (nodeTyChild (spineHead e)) i) (- 0 1))
            1
            0)
          0))
    )))

(pub :: mentionsArgs (-> String ASTNode Int Int Int))
(pub fn (mentionsArgs name e n_ i)
  (if (>= i n_)
    0
    (if (== (mentions name (spineArgAt e i)) 1)
      1
      (mentionsArgs name e n_ (+ i 1)))))

; An argument carrying the binding escapes by the half of the mask
; that matches the FORM it carries it in: typed by the arrival half,
; laundered to a word by the word half (`bindingFlow`).
(pub :: argsEscapeByMask (-> CG String ASTNode Int Int Int Int))
(pub fn (argsEscapeByMask cg name e n_ mask i)
  (if (>= i n_)
    0
    {
      (let f (bindingFlow cg name (spineArgAt e i)))
      (if (|| (&& (!= (& mask (| (paramBit i) (ownerBit i))) 0) (!= f 0))
            (&& (!= (& mask (wordBit i)) 0) (!= (argumentWordFlow cg (spineArgAt e i) f) 0)))
        1
        (argsEscapeByMask cg name e n_ mask (+ i 1)))
    }))

; How the binding's reference may reach the VALUE of `e`, in either
; form - `flowMask` with the binding as the one "parameter", so a
; scalar computed from it (`(strLen a)`, `(+ acc (strLen x))`)
; carries nothing and a word of it (`(cast Int a)`, `(strData a)`)
; carries it laundered. A bare `mentions` made `(fmtInt (strLen a))`
; an escape of `a`.
(pub :: bindingFlow (-> CG String ASTNode Int))
(pub fn (bindingFlow cg name e)
  {
    (let ps vecNew)
    {
      (vecPush ps name)
      (flowMask cg e ps vecNew)
    }
  })

; Does anything under `e` BIND a name - a `let`, a lambda parameter,
; a match binder? Answered for every name at once: one walk of `e`
; interns each binder, and notes whether it met a tag it does not
; know, which answers 1 for any name, the direction that trusts no
; signature. `(boundIn name (binderSummary e))` is the question.
; It mirrors `mentions`, for binders instead of references.
;
; The counted summary owns the binder interner, call-head memo and
; answers. The synchronous walks borrow it while the symbol table and
; parameters stay unchanged.
(pub struct BinderSummary sealed
  (unknown : Int)
  (binders : InternState)
  (heads : InternState)
  (answers : Ints))

(pub :: binderSummary (-> ASTNode BinderSummary))
(pub fn (binderSummary e)
  {
    (let set internNewTyped)
    (let unknown (binderCollect (internWordOf set) e))
    (BinderSummary :unknown unknown :binders set :heads internNewTyped :answers vecNew)
  })

; Return only scalar facts across emission: bit 0 owns the slot, and
; bit 1 releases its value at the scope end. The summary stays scoped
; to these two walks and is not carried through the raw pending record.
(:: slotOwnershipFacts (-> CG ASTNode Int Int Int Int))
(fn (slotOwnershipFacts cg node tail cls kept)
  (if (&& (== cls 2) (== kept 0))
    {
      (let bound (binderSummary (nodeCChild node)))
      (let own (slotOwns cg node bound))
      (if (== own 1)
        (+ 1 (* 2 (slotReleasesAtEnd cg node tail bound)))
        0)
    }
    0))

; Alias collection still runs after the initial store. On an accepted
; slot, the intervening emission only appends output lines: lookupSym
; names/registers and current parameters are unchanged. A fresh memo
; therefore sees the same facts; the pending record stores only a Bool.
(:: slotAliasUnknown (-> CG Names ASTNode Bool))
(fn (slotAliasUnknown cg aliases body)
  {
    (let bound (binderSummary body))
    (== (slotAliases cg aliases body bound) 1)
  })

; Is call head `n` a function VALUE rather than a signed global: a
; local, a parameter, or a name bound under the walk's root? Asked of
; every call the escape walk meets, and answered once per name per
; walk. The walk emits nothing, so the symbol table and the parameters
; it reads can't change while one summary is in use, and a `let` of n
; bindings built by one constructor asks `lookupSym`'s linear scan once
; per binding instead of once per call (AN-54).
(pub :: headIsLocal (-> CG String BinderSummary Int))
(pub fn (headIsLocal cg n bound)
  {
    (let memo (internWordOf bound.heads))
    (let answers bound.answers)
    (if (let (Some id) (internFind memo n))
      (vecGet answers id)
      {
        (let a
          (if (|| (hasSym cg n) (|| (>= (paramIndexOf cg n) 0) (== (boundIn n bound) 1)))
            1
            0))
        {
          (internIntern memo n)
          (vecPush answers a)
          a
        }
      })
  })

(pub :: boundIn (-> String BinderSummary Int))
(pub fn (boundIn name sum)
  (if (== sum.unknown 1)
    1
    (if (let (Some _) (internFind (internWordOf sum.binders) name))
      1
      0)))

; Intern every binder under `e`, and answer 1 on a tag this walk
; does not know. An arm binds its pattern's names; a pattern whose
; binders can't be read answers 1 as an unknown tag does.
(pub :: binderCollect (-> Int ASTNode Int))
(pub fn (binderCollect set e)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT) (|| (== tg TAG_E_STR) (|| (== tg TAG_E_CHAR) (== tg TAG_E_VAR)))))
        0
        (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
          {
            (internIntern set (nodeAName e))
            (if (== (binderCollect set (nodeBChild e)) 1)
              1
              (binderCollect set (nodeCChild e)))
          }
          (if (== tg TAG_E_LAM)
            {
              (binderCollectNames set (nodeANames e) 0)
              (binderCollect set (nodeBChild e))
            }
            (if (== tg TAG_E_MATCH)
              (if (== (binderCollect set (nodeAChild e)) 1)
                1
                (binderCollectArms set (nodeBChildren e) 0))
              (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
                (if (== (binderCollect set (nodeAChild e)) 1)
                  1
                  (if (== (binderCollect set (nodeBChild e)) 1)
                    1
                    (binderCollect set (nodeCChild e))))
                (if (== tg TAG_E_SETF)
                  (if (== (binderCollect set (nodeAChild e)) 1)
                    1
                    (binderCollect set (nodeCChild e)))
                  (if (== tg TAG_E_FIELD)
                    (binderCollect set (nodeAChild e))
                    (if (== tg TAG_E_SET)
                      (binderCollect set (nodeBChild e))
                      (if (== tg TAG_E_BEGIN)
                        (binderCollectVec set (nodeAChildren e) 0)
                        (if (|| (== tg TAG_E_WHILE) (== tg TAG_E_REGION))
                          (if (== tg TAG_E_REGION)
                            (binderCollect set (nodeBChild e))
                            (if (== (binderCollect set (nodeAChild e)) 1)
                              1
                              (binderCollectVec set (nodeBChildren e) 0)))
                          1))))))))))
    }))

(pub :: binderCollectVec (-> Int (Vec ASTNode) Int Int))
(pub fn (binderCollectVec set v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (== (binderCollect set (vecGet v i)) 1)
        1
        (binderCollectVec set v (+ i 1))))))

(pub :: binderCollectNames (-> Int Names Int Int))
(pub fn (binderCollectNames set v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      {
        (internIntern set (as (vecGet v i) String))
        (binderCollectNames set v (+ i 1))
      })))

(pub :: binderCollectArms (-> Int (Vec ASTNode) Int Int))
(pub fn (binderCollectArms set v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      {
        (let arm (vecGet v i))
        {
          (let unknown (binderCollectPattern set (nodeAChild arm)))
          (if (== unknown 1)
            1
            (if (== (binderCollect set (nodeBChild arm)) 1)
              1
              (binderCollectArms set v (+ i 1))))
        }
      })))

; Mirror patBindersCg's pattern cases directly into the interner. The
; summary needs membership, so it need not build a temporary name list.
(:: binderCollectPattern (-> Int ASTNode Int))
(fn (binderCollectPattern set pat)
  (if (nodeSame pat nilNode)
    0
    {
      (let tag (nodeTag pat))
      (if (|| (== tag TAG_E_INT)
            (|| (== tag TAG_E_FLT)
              (|| (== tag TAG_E_STR) (|| (== tag TAG_E_CHAR) (== tag TAG_P_CON0)))))
        0
        (if (== tag TAG_E_VAR)
          {
            (internIntern set (nodeAName pat))
            0
          }
          (if (== tag TAG_E_APP)
            (if (== (binderCollectPattern set (nodeBChild pat)) 1)
              1
              (binderCollectPatternHead set (nodeAChild pat)))
            (if (== tag TAG_P_CONNAMED)
              (if (== (nodeC pat) 0)
                0
                (binderCollectPatternVec set (nodeCChildren pat) 0))
              1))))
    }))

(:: binderCollectPatternHead (-> Int ASTNode Int))
(fn (binderCollectPatternHead set pat)
  (if (== (nodeTag pat) TAG_E_APP)
    (if (== (binderCollectPattern set (nodeBChild pat)) 1)
      1
      (binderCollectPatternHead set (nodeAChild pat)))
    0))

; The caller checked the optional raw child-list word before taking
; this typed view, so recursive reads need no nullable vector cast.
(:: binderCollectPatternVec (-> Int Nodes Int Int))
(fn (binderCollectPatternVec set subs i)
  (if (>= i (vecLen subs))
    0
    (if (== (binderCollectPattern set (vecGet subs i)) 1)
      1
      (binderCollectPatternVec set subs (+ i 1)))))

; A function may return an arrow. Peel only its declared parameters,
; so a nullary function returning a closure still has a reference result.
(pub :: fnDeclaredResultTy (-> (Option ASTNode) (Option Int) (Option ASTNode)))
(pub fn (fnDeclaredResultTy signature arity)
  (match arity
    ((None)
      (match signature
        ((None) None)
        ((Some ty) (Some ty)))
    )
    ((Some count) (fnDeclaredResultTyKnown signature count))))

(:: fnDeclaredResultTyKnown (-> (Option ASTNode) Int (Option ASTNode)))
(fn (fnDeclaredResultTyKnown signature arity)
  (match signature
    ((None) None)
    ((Some ty)
      (if (&& (> arity 0) (== (nodeTag ty) TAG_T_ARR))
        (fnDeclaredResultTyKnown (cgTypeNodeOpt (nodeBChild ty)) (- arity 1))
        (Some ty))
    )))

; Is this field read's declared type a machine scalar - `fldClass` 0?
; Resolved exactly as `emitField` will resolve it, through the
; checker's stamp; a data constructor's named field, an unstamped
; node, or an unclassifiable type answers 0, which the walker reads
; as "may be a reference" - the leak direction.
(pub :: fieldReadIsScalar (-> CG ASTNode Int))
(pub fn (fieldReadIsScalar cg e)
  {
    (let fi (resolveStructField (cgTypes cg) e))
    (if (nodeSame fi nilNode)
      0
      (if (== (nodeC fi) 0)
        0
        (if (== (fldClass cg (nodeCChild fi)) 0)
          1
          0)))
  })

; The class of a counted field read, for the share a use of it as a
; call argument takes: 1 for a counted type, `2+k` for this
; function's type variable k, 0 for a scalar or a shape this does
; not know. A field read is lent from its struct, as a `vecGet`
; element is lent from its vector: passed beside its struct to a
; callee that overwrites the field, it dangles unless the argument
; takes a share, which `emitArgsRegs` takes and
; `releaseOwnedArgs` hands back.
(pub :: fieldArgClass (-> CG ASTNode Int))
(pub fn (fieldArgClass cg node)
  (if (== (nodeTag node) TAG_E_FIELD)
    {
      (let fi (resolveStructField (cgTypes cg) node))
      (if (nodeSame fi nilNode)
        0
        {
          (let cls (fldClass cg (nodeCChild fi)))
          (if (== cls 2)
            1
            (if (== cls 1)
              (pinnedClass cg (checkedValueTy node))
              0))
        })
    }
    0))

; The names a pattern binds, or 0 for a pattern shape this does not
; know - the checker's `patBinders`, with the refusal added, plus the
; two shapes the emitter's own `emitPatMatch` dispatches that the
; checker's walk predates: `(Nil)` binds nothing, and a NAMED
; constructor pattern binds whatever its reordered spine would. `_`
; and `true`/`false` are names nobody references, so listing them
; costs nothing.
(pub :: patBindersCg (-> ASTNode Names Names))
(pub fn (patBindersCg pat acc)
  (if (nodeSame pat nilNode)
    acc
    {
      (let tag (nodeTag pat))
      (if (|| (== tag TAG_E_INT)
            (|| (== tag TAG_E_FLT)
              (|| (== tag TAG_E_STR) (|| (== tag TAG_E_CHAR) (== tag TAG_P_CON0)))))
        acc
        (if (== tag TAG_E_VAR)
          {
            (vecPush acc (nodeAName pat))
            acc
          }
          (if (== tag TAG_E_APP)
            (if (== (as (patBindersCg (nodeBChild pat) acc) Int) 0)
              cgNullVec
              (patBindersCgHead (nodeAChild pat) acc))
            (if (== tag TAG_P_CONNAMED)
              (patBindersCgVec (nodeCChildren pat) acc 0)
              cgNullVec))))
    }))

(pub :: patBindersCgHead (-> ASTNode Names Names))
(pub fn (patBindersCgHead pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
    (if (== (as (patBindersCg (nodeBChild pat) acc) Int) 0)
      cgNullVec
      (patBindersCgHead (nodeAChild pat) acc))
    acc))

(pub :: patBindersCgVec (-> (Vec ASTNode) Names Int Names))
(pub fn (patBindersCgVec subs acc i)
  (if (== (as subs Int) 0)
    acc
    (if (>= i (vecLen subs))
      acc
      (if (== (as (patBindersCg (vecGet subs i) acc) Int) 0)
        cgNullVec
        (patBindersCgVec subs acc (+ i 1))))))

; `patBindersCg`, minus the binders that cannot alias what they were
; copied out of. Everything else about it is identical, including the
; 0 for a shape it does not know - not knowing a pattern's binders is
; not knowing that none of them escape.
;
; This is a SEPARATE walk rather than a flag on the shared one because
; the other five callers want the binders as a SCOPE - what names the
; arm body binds, for shadowing (`binderCollectArms`) and for the flow
; environment (`flowMaskArms`, `flowStashesArms`, `tailOwnedArms`,
; `collectTailsArms`). A scalar binder is still a binding; it is only
; the escape question it cannot answer yes to.
(pub :: patBindersEsc (-> CG ASTNode Names Names))
(pub fn (patBindersEsc cg pat acc)
  (if (nodeSame pat nilNode)
    acc
    {
      (let tag (nodeTag pat))
      (if (|| (== tag TAG_E_INT)
            (|| (== tag TAG_E_FLT)
              (|| (== tag TAG_E_STR) (|| (== tag TAG_E_CHAR) (== tag TAG_P_CON0)))))
        acc
        (if (== tag TAG_E_VAR)
          {
            (if (== (binderIsWord cg pat) 0)
              (vecPush acc (nodeAName pat)))
            acc
          }
          (if (== tag TAG_E_APP)
            (if (== (as (patBindersEsc cg (nodeBChild pat) acc) Int) 0)
              cgNullVec
              (patBindersEscHead cg (nodeAChild pat) acc))
            (if (== tag TAG_P_CONNAMED)
              (patBindersEscVec cg (nodeCChildren pat) acc 0)
              cgNullVec))))
    }))

(pub :: patBindersEscHead (-> CG ASTNode Names Names))
(pub fn (patBindersEscHead cg pat acc)
  (if (== (nodeTag pat) TAG_E_APP)
    (if (== (as (patBindersEsc cg (nodeBChild pat) acc) Int) 0)
      cgNullVec
      (patBindersEscHead cg (nodeAChild pat) acc))
    acc))

(pub :: patBindersEscVec (-> CG (Vec ASTNode) Names Int Names))
(pub fn (patBindersEscVec cg subs acc i)
  (if (== (as subs Int) 0)
    acc
    (if (>= i (vecLen subs))
      acc
      (if (== (as (patBindersEsc cg (vecGet subs i) acc) Int) 0)
        cgNullVec
        (patBindersEscVec cg subs acc (+ i 1))))))

; A binder that cannot alias the block it was copied out of: a machine
; scalar (`binderIsScalar`), or a WORD STRUCT - `Date`, `TcpStream`, a
; sealed key - which is one word with no share, declared here or in an
; imported module. `fldClass` already classifies a word-struct FIELD as
; a word through the same `lookupType`; without the same answer here, a
; match that bound one and passed it to a call kept the whole scrutinee
; alive, and a `(Result Date Error)` leaked 32 bytes per call.
(pub :: binderIsWord (-> CG ASTNode Int))
;@axiom:effect(unsafe)
(pub fn (binderIsWord cg n)
  (if (== (binderIsScalar n) 1)
    1
    {
      (let t (nodeBinderTy n))
      (if (== t 0)
        0
        {
          (let eFound (lookupType (cgTypes cg) (as t String)))
          (if (let (Some e) eFound)
            (if (== (eKind e) TF_WORD)
              1
              0)
            0)
        })
    }))

; Did the checker stamp this binder with a MACHINE SCALAR type? An
; unstamped binder answers 0 - a type variable the checker could not
; resolve, a pattern the stamp does not reach - and 0 is the answer
; that keeps the old, conservative behaviour.
;
; `scalarTyName` is the same list `fldClass` classifies a declared
; field by, which is what makes this the binder-path twin of
; `fieldReadIsScalar` rather than a second opinion about what a word
; is. `Foreign` is in that list deliberately: it is a pointer Axiom
; does not own, so nothing here may retain or release it.
(pub :: binderIsScalar (-> ASTNode Int))
;@axiom:effect(unsafe)
(pub fn (binderIsScalar n)
  {
    (let t (nodeBinderTy n))
    (if (== t 0)
      0
      (scalarTyName (as t String)))
  })

; Does `name` appear anywhere below `e` at all? The answer for the
; shapes that take no share, where position stops mattering. Unknown
; tags answer 1: not knowing a node's children is not knowing whether
; the name is under it.
(pub :: mentions (-> String ASTNode Int))
(pub fn (mentions name e)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (|| (== tg TAG_E_INT) (|| (== tg TAG_E_FLT) (|| (== tg TAG_E_STR) (== tg TAG_E_CHAR))))
        0
        (if (== tg TAG_E_VAR)
          (if (strEq (nodeAName e) name)
            1
            0)
          (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
            (if (== (mentions name (nodeAChild e)) 1)
              1
              (if (== (mentions name (nodeBChild e)) 1)
                1
                (mentions name (nodeCChild e))))
            ; a binding's word 1 is its NAME, a String, not a node: walked
            ; as one, a name whose length matched a tag followed its data
            ; pointer into the bytes
            (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
              (if (== (mentions name (nodeBChild e)) 1)
                1
                (mentions name (nodeCChild e)))
              ; a field store's word 2 is the field NAME, a String - walking
              ; it as a node read its length as a tag and followed its data
              ; pointer (a 5- or 8-byte name dressed as a lambda or a block),
              ; which is how `(set r.label ...)` beside a mention of the
              ; binding took the compiler down with SIGSEGV
              (if (== tg TAG_E_SETF)
                (if (== (mentions name (nodeAChild e)) 1)
                  1
                  (mentions name (nodeCChild e)))
                (if (== tg TAG_E_FIELD)
                  (mentions name (nodeAChild e))
                  (if (== tg TAG_E_SET)
                    (mentions name (nodeBChild e))
                    (if (== tg TAG_E_BEGIN)
                      (mentionsVec name (nodeAChildren e) 0)
                      ; `cond` is AX2004: the parser builds none, so
                      ; no arm mentions one.
                      (if (== tg TAG_E_MATCH)
                        (if (== (mentions name (nodeAChild e)) 1)
                          1
                          (mentionsArms name (nodeBChildren e) 0))
                        (if (|| (== tg TAG_E_WHILE) (== tg TAG_E_REGION))
                          (if (== tg TAG_E_REGION)
                            (mentions name (nodeBChild e))
                            (if (== (mentions name (nodeAChild e)) 1)
                              1
                              (mentionsVec name (nodeBChildren e) 0)))
                          (if (== tg TAG_E_LAM)
                            ; a capture takes no share, so any mention counts
                            (mentions name (nodeBChild e))
                            1)))))))))))
    }))

(pub :: mentionsVec (-> String (Vec ASTNode) Int Int))
(pub fn (mentionsVec name v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (== (mentions name (vecGet v i)) 1)
        1
        (mentionsVec name v (+ i 1))))))

(pub :: mentionsArms (-> String (Vec ASTNode) Int Int))
(pub fn (mentionsArms name v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (== (mentions name (nodeBChild (vecGet v i))) 1)
        1
        (mentionsArms name v (+ i 1))))))

; The three heads that hand a WORD out of a reference. A word takes no
; share and nothing can give it one, so a binding that reaches any of
; them is the program's to keep alive (MM-LIFE-2g states the same limit
; for the store side).
(pub :: wordTakingHead (-> ASTNode Int))
(pub fn (wordTakingHead h)
  (if (!= (nodeTag h) TAG_E_VAR)
    0
    (if (|| (strEq (nodeAName h) "cast")
          (|| (strEq (nodeAName h) "__addr")
            (|| (strEq (nodeAName h) "strData") (strEq (nodeAName h) "strOwner"))))
      1
      0)))

; Every `alloca` of a function sits in its ENTRY block. An alloca in
; a body block is legal LLVM and allocates each time the block runs:
; a `mut` binding inside a self-tail-call loop grew the frame by a
; word per iteration and overflowed the stack at `--opt 0` (mem2reg
; hid it above that), and was the reason a `let` body was not a tail
; position. The function emitter leaves a blank line after its header
; (`openAllocaMark`), `emitAlloca` collects, and `closeAllocaMark`
; splices the collected allocas into that line before the `ret`.
(pub :: openAllocaMark (-> CG CG))
(pub fn (openAllocaMark cg)
  {
    (let cgM (emitLine cg ""))
    {
      (cgSetAllocaMark cgM (Some (- (vecLen (cgLines cgM)) 1)))
      (cgSetHoisted cgM vecNew)
      cgM
    }
  })

(pub :: emitAlloca (-> CG String CG))
(pub fn (emitAlloca cg ar)
  (if (isNone (cgAllocaMark cg))
    (emitLine cg (concat (concat "  " ar) " = alloca i64"))
    {
      (vecPush (cgHoisted cg) (concat (concat "  " ar) " = alloca i64"))
      cg
    }))

(pub :: closeAllocaMark (-> CG CG))
;@axiom:effect(unsafe)
(pub fn (closeAllocaMark cg)
  {
    (let markFound (cgAllocaMark cg))
    (if (let (Some mark) markFound)
      {
        (let hoisted (cgHoisted cg))
        {
          (if (> (vecLen hoisted) 0)
            (vecSet (cgLines cg) mark (joinAllocas hoisted))
            (as 0 (Vec String)))
          (cgSetAllocaMark cg None)
          (cgSetHoisted cg vecNew)
          cg
        }
      }
      cg)
  })

; One buffer of the exact size, not a recursive concatenation: 40,000
; `mut` bindings in one function joined in 11.6 s by the suffix-
; copying form (quadratic, and one frame per binding)
(pub :: joinAllocas (-> (Vec String) String))
;@axiom:effect(unsafe)
(pub fn (joinAllocas v)
  {
    (let n (vecLen v))
    (if (== n 0)
      ""
      {
        (let out (strAlloc (joinAllocasSize v 0 0)))
        (let mut j 0)
        (let mut off 0)
        {
          (while (< j n)
            {
              (let line (vecGet v j))
              {
                (if (> j 0)
                  {
                    (__store8 (strData out) off 10)
                    (set off (+ off 1))
                  })
                (memCopy (+ (strData out) off) (strData line) (strLen line))
                (set off (+ off (strLen line)))
                (set j (+ j 1))
              }
            })
          out
        }
      })
  })

(pub :: joinAllocasSize (-> (Vec String) Int Int Int))
;@axiom:effect(pure)
(pub fn (joinAllocasSize v i acc)
  (if (>= i (vecLen v))
    (+ acc
      (if (> (vecLen v) 1)
        (- (vecLen v) 1)
        0))
    (joinAllocasSize v (+ i 1) (+ acc (strLen (vecGet v i))))))

; A mutable binding: the initialiser's value goes into an alloca, the
; name binds the alloca, and reads load. A slot of a reference type
; that `slotOwns` admits holds a share of what it holds (kind 4): the
; initialiser moves in when it arrives owned and is retained when it
; is borrowed, `emitSet` releases what a store overwrites, and the
; scope end releases the last value (MM-LIFE-2c event 3). Any other
; slot is storage only (kind 1).
(pub :: emitLetM (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitLetM node cg)
  (emitLetMAt node cg 0))

(pub :: emitLetMAt (-> ASTNode CG Int CG))
;@axiom:effect(io)
(pub fn (emitLetMAt node cg tail)
  {
    (let name (nodeAName node))
    (let valExpr (nodeBChild node))
    (let body (nodeCChild node))
    {
      (let cg1 (emitExpr valExpr cg))
      {
        (let valReg (strDup (cgResult cg1)))
        (let valFlag (cgResultFloat cg1))
        (let mark (symMark cg1))
        (let an (allocReg cg1))
        (let initOwned (valueOwnedRef cg1 valExpr))
        (let cls (slotClassOf cg1 node))
        (let regMark (vecLen (cgCountedStores cg1)))
        (let kept (slotKeptByCaller cg1 node))
        {
          (let ar (tmpStr "s" an))
          {
            (emitAlloca cg1 ar)
            ; bound as an owning slot while the walks below run, so a
            ; lambda capturing it reads as the counted capture it will
            ; be if they say yes, and set back to kind 1 if they say no
            (bindSym cg1 name ar valFlag
              (if (== cls 2)
                4
                1))
            {
              (let facts (slotOwnershipFacts cg1 node tail cls kept))
              (let own (& facts 1))
              {
                (let relEnd (>> facts 1))
                {
                  ; a refused slot is storage only, and the stores its
                  ; walks registered (`slotStoreCounts`) protected a
                  ; release it won't make
                  (if (&& (== cls 2) (== own 0))
                    {
                      (truncateNodeRegistry (cgCountedStores cg1) regMark)
                      (vecSet (cgSymKinds cg1) (- (vecLen (cgSymKinds cg1)) 1) 1)
                    }
                    (cgSymKinds cg1))
                  {
                    (let cgI
                      (if (&& (== own 1) (!= initOwned 1))
                        (emitRetainOf cg1 valReg)
                        cg1))
                    {
                      (let _s
                        (emitLine cgI (concat "  store i64 " (concat valReg (concat ", ptr " ar)))))
                      (let pend (pairOwningSlots cgI))
                      {
                        (let pmark (vecLen pend))
                        {
                          ; PENDING while the body emits, as a releasable
                          ; `let` is: a tail call jumps past the scope end
                          ; below and pays it before the jump
                          (if (== own 1)
                            {
                              (let aliases (:: vecNew Names))
                              (vecPush aliases name)
                              (vecPush pend
                                (PendingSlot
                                  :slot ar
                                  :name name
                                  :aliases aliases
                                  :unknown (slotAliasUnknown cg1 aliases body)))
                            }
                            pend)
                          {
                            (let cgB
                              (if (== tail 1)
                                (emitExprTail body cgI)
                                (emitExpr body cgI)))
                            {
                              (truncatePendingSlots pend pmark)
                              (symRestore cgB mark)
                              ; The release goes at the scope end, in the block
                              ; the body left current - not when the body ended
                              ; in a jump or a `ret`, which paid or cannot be
                              ; followed.
                              (if (&& (== relEnd 1) (!= (cgTerminated cgB) 1))
                                {
                                  (let res (strDup (cgResult cgB)))
                                  (let fl (cgResultFloat cgB))
                                  (let cgR (releaseSlotValue cgB ar))
                                  {
                                    (cgSetResult cgR res)
                                    (cgSetResultFloat cgR fl)
                                    cgR
                                  }
                                }
                                cgB)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  })

; `(set name v)` stores into the binding's alloca and evaluates to `v`,
; matching stage0. A target with no storage - unbound, immutable, or a
; parameter - is refused loudly; stage0 rejects it as AX3012 and this
; compiler has no diagnostic channel subtler than dying.
;
; An owning slot (kind 4) does what a field store does (event 5): it
; takes a share of `v` - a move when `v` arrives owned - and only then
; releases the value it overwrites, so `(set x x)` keeps its block.
; The old value is loaded after `v` is evaluated, because `v` may read
; the slot, as `(set s (concat s "x"))` does. A store an escape walk
; counted before its slot was emitted (pair slot 18) takes the same
; share in a slot that only stores, and keeps it.
(pub :: emitSet (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitSet node cg)
  {
    (let name (nodeAName node))
    (let valExpr (nodeBChild node))
    {
      (let kind (lookupSymKind cg name))
      (let storage
        (if (|| (== kind 1) (== kind 4))
          (symIndex cg name)
          None))
      (if (let (Some storageIdx) storage)
        {
          (let cg1 (emitExpr valExpr cg))
          {
            (let v (strDup (cgResult cg1)))
            (let ptr (strDup (symRegAt cg storageIdx)))
            {
              (if (== kind 4)
                {
                  (let cgR
                    (if (== (valueOwnedRef cg1 valExpr) 1)
                      cg1
                      (emitRetainOf cg1 v)))
                  {
                    (let old (regStr (allocReg cgR)))
                    {
                      (emitLine cgR (concat "  " (concat old (concat " = load i64, ptr " ptr))))
                      (emitLine cgR (concat "  store i64 " (concat v (concat ", ptr " ptr))))
                      (emitReleaseOf cgR old)
                    }
                  }
                }
                {
                  (let cgR
                    (if (if (== (nodeInVec (cgCountedStores cg1) node 0) 1)
                      (== (valueOwnedRef cg1 valExpr) 0)
                      false)
                      (emitRetainOf cg1 v)
                      cg1))
                  (emitLine cgR (concat "  store i64 " (concat v (concat ", ptr " ptr))))
                })
              (cgSetResult cg1 v)
              cg1
            }
          }
        }
        (cgFail cg "set target is not a mut binding: " name))
    }
  })

; Load what the owning slot `ar` holds now, and release it.
(pub :: releaseSlotValue (-> CG String CG))
(pub fn (releaseSlotValue cg ar)
  {
    (let r (regStr (allocReg cg)))
    (emitReleaseOf (emitLine cg (concat "  " (concat r (concat " = load i64, ptr " ar)))) r)
  })

; ------------------------------------------------------------------
; Which `mut` slots own (MM-LIFE-2c event 3, MM-MUT-1).
;
; A read of a slot is a borrow: no count moves. That is sound for an
; owning slot only while nothing a read produced is still in use when
; a `set` releases the value it came from, or when the scope end
; releases the last one. `slotOwns` admits a slot when all of these
; hold, and each refusal is the leak direction - the slot keeps the
; storage-only behaviour:
;
;   its type is a reference (`fldClass` 2, from the checker's stamp):
;     a scalar and a `Foreign` take no counts at all, and a `Vec` is a reference;
;   no binder under the body reuses its name, so every `x` and every
;     `(set x ...)` the walks meet is this slot (`slotRebinds`);
;   no `(set x v)` hands its value to anything but a statement or the
;     `let`'s own value: a `set` answers the slot's content, borrowed
;     (`slotSetFlow`);
;   the slot does not escape in argument position (`escapes`, with the
;     slot bound as kind 4, so a lambda's capture is a counted one);
;   no value that may alias the slot is held across a `set` of it
;     (`slotScan`).
;
; The last value is released at the scope end when the `let`'s value
; cannot carry it either, or - in tail position - when every tail
; leaf is retained on the way out or is a share of its own
; (`slotReleasesAtEnd`).
; ------------------------------------------------------------------
; The reference class of a `mut` slot's type, which the checker stamps
; on the binding (`checkExprHCore`) and on each `set` of it
; (`checkSet`). A lambda still waiting for its parameter types is a
; closure, so a reference. An unstamped node is unclassifiable.
(pub :: slotClassOf (-> CG ASTNode Int))
(pub fn (slotClassOf cg node)
  {
    (let t (nodeBinderTyChild node))
    (if (nodeSame t nilNode)
      1
      (if (== (nodeTag t) TAG_E_LAM)
        2
        (fldClass cg (tyResolve t))))
  })

; A bare read of an owning slot, as the emitter will resolve it.
(pub :: slotReadOf (-> CG ASTNode Int))
(pub fn (slotReadOf cg e)
  (if (== (nodeTag e) TAG_E_VAR)
    (if (&& (!= (nodeDefScope e) 1) (== (lookupSymKind cg (nodeAName e)) 4))
      1
      0)
    0))

; Does the store `e`, a `(set target v)` under the walk rooted at
; `bound`, take a share of `v`? A store into an owning slot (kind 4)
; does. When a binder under the root reuses the name, the symbol table
; doesn't name the slot the store will meet, and a slot bound under the
; root isn't emitted yet, so whether it will own isn't known. So a store
; into any slot of a reference type (the checker's stamp on `e`) that
; isn't known to own is registered to take a share (`emitSet`, pair
; slot 18), and the answer doesn't depend on which of two sibling
; slots was declared first. A slot that only stores keeps that share:
; the leak direction.
(pub :: slotStoreCounts (-> CG ASTNode BinderSummary Int))
(pub fn (slotStoreCounts cg e bound)
  {
    (let target (nodeAName e))
    (if (if (== (boundIn target bound) 0)
      (== (lookupSymKind cg target) 4)
      false)
      1
      (if (== (slotClassOf cg e) 2)
        {
          (let reg (cgCountedStores cg))
          {
            (if (== (nodeInVec reg e 0) 1)
              reg
              (vecPush reg e))
            1
          }
        }
        0))
  })

; `bound` is `binderSummary` of the body, shared with
; `slotReleasesAtEnd`: nothing is emitted between the two.
(pub :: slotOwns (-> CG ASTNode BinderSummary Int))
(pub fn (slotOwns cg node bound)
  {
    (let name (nodeAName node))
    (let body (nodeCChild node))
    (if (== (slotRebinds name body) 1)
      0
      (if (!= (& (slotSetFlow name body 1) 2) 0)
        0
        (if (== (escapes cg name body 0 bound) 1)
          0
          (if (!= (& (slotScan cg name body bound) 2) 0)
            0
            1))))
  })

; May the scope end release the slot's last value? When the `let`'s
; value cannot carry it - no escape in value position, no `set` there
; - or when the `let` is in tail position and every tail leaf is
; retained before the scope end (event 2's `tailRetain`) or is a
; share of its own. Inside a lambda the leaf retain must be the
; unconditional one.
(pub :: slotReleasesAtEnd (-> CG ASTNode Int BinderSummary Int))
(pub fn (slotReleasesAtEnd cg node tail bound)
  {
    (let name (nodeAName node))
    (let body (nodeCChild node))
    (if (&& (== (escapes cg name body 1 bound) 0) (== (slotSetFlow name body 1) 0))
      1
      (if (== tail 0)
        0
        (if (== (cgLiftedLambda cg) 1)
          {
            (let lamTy (cgLambdaType cg))
            (if (== (parameterTypeClass cg (lambdaResultType lamTy)) 2)
              (slotTailCovered cg body)
              0)
          }
          (slotTailCovered cg body))))
  })

; Every value the tail of `e` can answer, as `emitExprTail` will emit
; it: retained on the way out (it is in word 41), or a share of its own.
(pub :: slotTailCovered (-> CG ASTNode Int))
(pub fn (slotTailCovered cg e)
  (if (nodeSame e nilNode)
    1
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_IF)
        (if (== (slotTailCovered cg (nodeBChild e)) 1)
          (slotTailCovered cg (nodeCChild e))
          0)
        (if (== tg TAG_E_BEGIN)
          {
            (let xs (nodeAChildren e))
            (if (== (vecLen xs) 0)
              1
              (slotTailCovered cg (vecGet xs (- (vecLen xs) 1))))
          }
          (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            (slotTailCovered cg (nodeCChild e))
            (if (== tg TAG_E_MATCH)
              ; a match the tail emitter delegates is emitted as an
              ; ordinary one, and its arms' leaves are not retained
              (if (== (pairTailDelegates cg e) 1)
                0
                {
                  (let arms (nodeBChildren e))
                  (let mut i 0)
                  (let mut ok 1)
                  {
                    (while (&& (== ok 1) (< i (vecLen arms)))
                      {
                        (set ok (slotTailCovered cg (nodeBChild (vecGet arms i))))
                        (set i (+ i 1))
                      })
                    ok
                  }
                })
              (if (== (nodeInVec (cgTailRetain cg) e 0) 1)
                1
                (if (|| (== tg TAG_E_INT)
                      (|| (== tg TAG_E_FLT) (|| (== tg TAG_E_STR) (== tg TAG_E_CHAR))))
                  1
                  ; a `set` answers what the slot now holds
                  (if (== tg TAG_E_SET)
                    0
                    (valueOwnedRef cg e))))))))
    }))

; The child expressions of `e` in evaluation order: how many there
; are, -1 for a tag these walks do not know, and the i-th. They are
; counted and indexed in place rather than collected, because the walks
; below visit every node under each owning slot's scope. A `handle`'s
; effect names and a field store's field name are not expressions.
(pub :: slotPartCount (-> ASTNode Int))
(pub fn (slotPartCount e)
  {
    (let tg (nodeTag e))
    (if (|| (== tg TAG_E_INT)
          (|| (== tg TAG_E_FLT)
            (|| (== tg TAG_E_STR)
              (|| (== tg TAG_E_CHAR) (|| (== tg TAG_E_VAR) (== tg TAG_E_QUOTE))))))
      0
      (if (== tg TAG_E_APP)
        (+ 1 (spineArity e))
        (if (|| (== tg TAG_E_LET)
              (|| (== tg TAG_E_LETM) (|| (== tg TAG_E_SETF) (== tg TAG_E_HANDLE))))
          2
          (if (== tg TAG_E_IF)
            3
            (if (|| (== tg TAG_E_SET)
                  (|| (== tg TAG_E_LAM) (|| (== tg TAG_E_REGION) (== tg TAG_E_FIELD))))
              1
              (if (== tg TAG_E_BEGIN)
                (vecLen (nodeAChildren e))
                (if (== tg TAG_E_STRUCTCON)
                  (vecLen (nodeBChildren e))
                  (if (|| (== tg TAG_E_WHILE) (|| (== tg TAG_E_SUBCHECK) (== tg TAG_E_MATCH)))
                    (+ 1 (vecLen (nodeBChildren e)))
                    (- 0 1)))))))))
  })

(pub :: slotPart (-> ASTNode Int ASTNode))
(pub fn (slotPart e i)
  {
    (let tg (nodeTag e))
    (if (== tg TAG_E_APP)
      (if (== i 0)
        (spineHead e)
        (spineArgAt e (- i 1)))
      (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
        (if (== i 0)
          (nodeBChild e)
          (nodeCChild e))
        (if (|| (== tg TAG_E_SETF) (== tg TAG_E_HANDLE))
          (if (== i 0)
            (nodeAChild e)
            (nodeCChild e))
          (if (== tg TAG_E_IF)
            (if (== i 0)
              (nodeAChild e)
              (if (== i 1)
                (nodeBChild e)
                (nodeCChild e)))
            (if (|| (== tg TAG_E_SET) (|| (== tg TAG_E_LAM) (== tg TAG_E_REGION)))
              (nodeBChild e)
              (if (== tg TAG_E_FIELD)
                (nodeAChild e)
                (if (== tg TAG_E_BEGIN)
                  (vecGet (nodeAChildren e) i)
                  (if (== tg TAG_E_STRUCTCON)
                    (vecGet (nodeBChildren e) i)
                    ; `while`, a range check and `match`: the condition,
                    ; value or scrutinee first
                    (if (== i 0)
                      (nodeAChild e)
                      (if (== tg TAG_E_MATCH)
                        (nodeBChild (vecGet (nodeBChildren e) (- i 1)))
                        (vecGet (nodeBChildren e) (- i 1))))))))))))
  })

; Where the value of a `(set name v)` under `e` goes, given where the
; value of `e` itself goes (`pos`): 0 a statement, which drops it; 1
; the `let`'s own value; 2 anywhere else - an argument, an initialiser,
; a scrutinee, a condition. The answer ORs the positions every `set`
; of the slot reaches; an unknown tag answers 2.
(pub :: slotSetFlow (-> String ASTNode Int Int))
(pub fn (slotSetFlow name e pos)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (let n (slotPartCount e))
      (if (< n 0)
        2
        {
          (let mut r
            (if (== tg TAG_E_SET)
              (if (strEq (nodeAName e) name)
                pos
                0)
              0))
          (let mut i 0)
          {
            (while (< i n)
              {
                (set r (| r (slotSetFlow name (slotPart e i) (slotPartPos tg i n pos))))
                (set i (+ i 1))
              })
            r
          }
        })
    }))

; The position part i of n of a `tg` node is in, when the node's own
; value goes to `pos`: a block's last expression, a branch, a `let`'s
; body, a match arm, a region's body and a `handle`'s body carry the
; node's position; a block's other expressions and a loop's body drop
; their values; everything else is used.
(pub :: slotPartPos (-> Int Int Int Int Int))
(pub fn (slotPartPos tg i n pos)
  (if (== tg TAG_E_BEGIN)
    (if (== i (- n 1))
      pos
      0)
    (if (== tg TAG_E_WHILE)
      (if (== i 0)
        2
        0)
      (if (|| (== tg TAG_E_IF) (|| (== tg TAG_E_LET) (|| (== tg TAG_E_LETM) (== tg TAG_E_MATCH))))
        (if (== i 0)
          2
          pos)
        (if (== tg TAG_E_REGION)
          pos
          (if (== tg TAG_E_HANDLE)
            (if (== i 0)
              pos
              2)
            2))))))

; Bit 0: a `(set name ...)` is under `e`. Bit 1: a value that may alias
; the slot is still held when one runs (`slotHolds`). An unknown tag
; answers both.
(pub :: slotScan (-> CG String ASTNode BinderSummary Int))
(pub fn (slotScan cg name e bound)
  (if (nodeSame e nilNode)
    0
    {
      (let n (slotPartCount e))
      (if (< n 0)
        3
        {
          (let mut acc
            (if (== (nodeTag e) TAG_E_SET)
              (if (strEq (nodeAName e) name)
                1
                0)
              0))
          (let mut mask 0)
          (let mut total 0)
          (let mut i 0)
          {
            (while (< i n)
              {
                {
                  (let r (slotScan cg name (slotPart e i) bound))
                  {
                    (set acc (| acc r))
                    (if (!= (& r 1) 0)
                      {
                        (set total (+ total 1))
                        (if (< i 62)
                          (set mask (| mask (<< 1 i))))
                      })
                  }
                }
                (set i (+ i 1))
              })
            (if (!= (& acc 2) 0)
              acc
              (| acc (slotHolds cg name e n mask total bound)))
          }
        })
    }))

; The hazard `slotScan` looks for at one node: a part whose value may
; alias the slot (`mayAlias`) held while another part runs a `set` of
; it. `mask` names the parts (below 62) that do, and `total` counts
; them. A binding holds its initialiser over its body, and a match
; holds its scrutinee - its binders' block - over its arms. A call, a
; field store, a keyword construction, a `handle` and a range check
; hold every part beside every other, in either order. Anything else
; holds nothing across its parts. A `let` reading the slot bare takes
; a share of its own (`emitLetAt`), and so does a lambda capturing the
; slot (`captureCounted`), so neither holds anything either.
(pub :: slotHolds (-> CG String ASTNode Int Int Int BinderSummary Int))
(pub fn (slotHolds cg name e n mask total bound)
  {
    (let tg (nodeTag e))
    (if (== total 0)
      0
      (if (|| (== tg TAG_E_LET) (|| (== tg TAG_E_LETM) (== tg TAG_E_MATCH)))
        (if (== (- total (& mask 1)) 0)
          0
          (if (if (== tg TAG_E_LET)
            (if (== (slotReadOf cg (nodeBChild e)) 1)
              (strEq (nodeAName (nodeBChild e)) name)
              false)
            false)
            0
            (if (== (slotMayAlias cg name (slotPart e 0) bound) 1)
              2
              0)))
        (if (|| (== tg TAG_E_APP)
              (|| (== tg TAG_E_SETF)
                (|| (== tg TAG_E_STRUCTCON) (|| (== tg TAG_E_HANDLE) (== tg TAG_E_SUBCHECK)))))
          {
            (let mut hz 0)
            (let mut j 0)
            {
              (while (&& (== hz 0) (< j n))
                {
                  ; a part past the mask counts as setting nothing, so
                  ; every other part's `set` is held against it
                  {
                    (let own
                      (if (< j 62)
                        (if (!= (& mask (<< 1 j)) 0)
                          1
                          0)
                        0))
                    (if (> (- total own) 0)
                      (if (== (slotMayAlias cg name (slotPart e j) bound) 1)
                        (set hz 2)))
                  }
                  (set j (+ j 1))
                })
              hz
            }
          }
          0)))
  })

; `mayAlias`, less a lambda written in place: what it captures of the
; slot it holds a share of. A capture of a borrowed alias is that
; alias's binding's hazard, and `slotHolds` meets it there.
(pub :: slotMayAlias (-> CG String ASTNode BinderSummary Int))
(pub fn (slotMayAlias cg name e bound)
  (if (== (nodeTag e) TAG_E_LAM)
    0
    (mayAlias cg name e bound)))

; Is `name` the target of a `set` anywhere under `e`? A tag the walks
; don't know answers yes.
(pub :: slotAssigned (-> String ASTNode Int))
(pub fn (slotAssigned name e)
  (if (nodeSame e nilNode)
    0
    {
      (let n (slotPartCount e))
      (if (< n 0)
        1
        (if (if (== (nodeTag e) TAG_E_SET)
          (strEq (nodeAName e) name)
          false)
          1
          {
            (let mut r 0)
            (let mut i 0)
            {
              (while (&& (== r 0) (< i n))
                {
                  (set r (slotAssigned name (slotPart e i)))
                  (set i (+ i 1))
                })
              r
            }
          }))
    }))

; A slot that is never `set` and starts from a parameter of the
; function, or from a literal, holds a value the caller keeps alive for
; the whole call, exactly as a `let` of the parameter does. It needs no
; share of its own. Taking one would also make it a pending release
; that keeps a mutual tail call passing it on from being a jump
; (MM-EXEC-6c). Asked before the slot's own binder exists.
(pub :: slotKeptByCaller (-> CG ASTNode Int))
(pub fn (slotKeptByCaller cg node)
  {
    (let v (nodeBChild node))
    (if (== (slotAssigned (nodeAName node) (nodeCChild node)) 1)
      0
      (if (== (nodeTag v) TAG_E_STR)
        1
        (if (if (== (nodeTag v) TAG_E_VAR)
          (&& (!= (nodeDefScope v) 1)
            (&& (! (hasSym cg (nodeAName v))) (>= (curParamIndex cg (nodeAName v)) 0)))
          false)
          1
          0)))
  })

; The names under `e` whose binding may hold the value of one of
; `names` (`mayAlias`), appended to `names` in evaluation order, so an
; alias of an alias is found too: a `let` or `mut` binding whose
; initialiser may alias one, and every binder of a `match` whose
; scrutinee may. Answers 1 on a tag the walks don't know, or a pattern
; whose binders can't be listed.
(pub :: slotAliases (-> CG Names ASTNode BinderSummary Int))
(pub fn (slotAliases cg names e bound)
  (if (nodeSame e nilNode)
    0
    {
      (let n (slotPartCount e))
      (if (< n 0)
        1
        {
          (let mut unk 0)
          (let mut i 0)
          {
            (while (&& (== unk 0) (< i n))
              {
                (set unk (slotAliases cg names (slotPart e i) bound))
                ; once the initialiser or scrutinee is walked, before
                ; the body or the arms
                (if (&& (== i 0) (== unk 0))
                  (set unk (slotAliasBinders cg names e bound)))
                (set i (+ i 1))
              })
            unk
          }
        })
    }))

(pub :: slotAliasBinders (-> CG Names ASTNode BinderSummary Int))
(pub fn (slotAliasBinders cg names e bound)
  {
    (let tg (nodeTag e))
    (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
      (if (== (namesMayAlias cg names (nodeBChild e) bound 0) 1)
        {
          (vecPush names (nodeAName e))
          0
        }
        0)
      (if (== tg TAG_E_MATCH)
        (if (== (namesMayAlias cg names (nodeAChild e) bound 0) 1)
          (slotArmAliases names (nodeBChildren e) 0)
          0)
        0))
  })

(pub :: slotArmAliases (-> Names (Vec ASTNode) Int Int))
(pub fn (slotArmAliases names arms i)
  (if (>= i (vecLen arms))
    0
    (if (== (as (patBindersCg (nodeAChild (vecGet arms i)) names) Int) 0)
      1
      (slotArmAliases names arms (+ i 1)))))

(pub :: namesMayAlias (-> CG Names ASTNode BinderSummary Int Int))
(pub fn (namesMayAlias cg names e bound i)
  (if (>= i (vecLen names))
    0
    (if (== (mayAlias cg (vecGetStr names i) e bound) 1)
      1
      (namesMayAlias cg names e bound (+ i 1)))))

; Does a binder under `e` reuse `name` - a `let`, a lambda parameter, a
; match binder? A tag the walk does not know, or a pattern whose
; binders it cannot list, answers yes.
(pub :: slotRebinds (-> String ASTNode Int))
(pub fn (slotRebinds name e)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (let n (slotPartCount e))
      (if (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
        (strEq (nodeAName e) name)
        false)
        1
        (if (if (== tg TAG_E_LAM)
          (== (strVecHas (nodeANames e) name) 1)
          false)
          1
          (if (if (== tg TAG_E_MATCH)
            (== (slotArmsBind name (nodeBChildren e)) 1)
            false)
            1
            (if (< n 0)
              1
              {
                (let mut r 0)
                (let mut i 0)
                {
                  (while (&& (== r 0) (< i n))
                    {
                      (set r (slotRebinds name (slotPart e i)))
                      (set i (+ i 1))
                    })
                  r
                }
              }))))
    }))

(pub :: slotArmsBind (-> String (Vec ASTNode) Int))
(pub fn (slotArmsBind name arms)
  {
    (let mut r 0)
    (let mut i 0)
    {
      (while (&& (== r 0) (< i (vecLen arms)))
        {
          {
            (let bs (patBindersCg (nodeAChild (vecGet arms i)) vecNew))
            (set r (if (== (as bs Int) 0)
              1
              (strVecHas bs name)))
          }
          (set i (+ i 1))
        })
      r
    }
  })

; `while` is a real loop - a branch back to a condition block - and the
; whole form evaluates to 0: a loop that ran zero times has no last
; iteration to take a value from.
(pub :: emitWhile (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitWhile node cg)
  {
    (let cnd (nodeAChild node))
    (let body (nodeBChildren node))
    (let hn (allocReg cg))
    (let bn (allocReg cg))
    (let xn (allocReg cg))
    {
      (let hdrB (labelStr hn))
      (let bodyB (labelStr bn))
      (let exitB (labelStr xn))
      {
        (let _1 (emitLine cg (concat "  br label %" hdrB)))
        (let _2 (emitLabel cg hdrB))
        (let cgC (emitExpr cnd cg))
        (let cr (strDup (cgResult cgC)))
        (let tn (allocReg cgC))
        {
          (let tr (regStr tn))
          {
            (let _3
              (emitLine cgC (concat (concat "  " tr) (concat " = icmp ne i64 " (concat cr ", 0")))))
            (let _4
              (emitLine cgC
                (concat (concat "  br i1 " (concat tr ", label %"))
                  (concat bodyB (concat (concat ", label %" exitB) "")))))
            (let _5 (emitLabel cgC bodyB))
            (let cgB (emitSeq body cgC 0))
            (let _6 (emitLine cgB (concat "  br label %" hdrB)))
            (let _7 (emitLabel cgB exitB))
            {
              (cgSetResult cgB (constStr 0))
              (cgSetResultFloat cgB 0)
              cgB
            }
          }
        }
      }
    }
  })

; ------------------------------------------------------------------
; `(region r EXPR)`: read the allocator's waterline, run the body,
; roll the waterline back, answer the body's value. MM-RGN-1, and
; docs/memory-model.md §3.6 is exact about the runtime: there
; is none to add. `@__axiom_arena_reset_fn` IS the reset, and it takes
; a MARK CELL - three words: the bump, its end and the chunk.
;
; THE CELL IS A STACK SLOT, NOT THE HEAP CELL A MARK ALLOCATES.
; `@__axiom_arena_mark_fn` gets its 24 bytes from `axiom_alloc`, below
; the waterline it then records, so the cell survives its own reset
; and is never freed: a region per loop iteration would leak a cell
; per iteration into the arena it exists to keep flat. So the three
; words are loaded here from the same three globals the mark function
; reads, into one `alloca` per region form hoisted to the function's
; entry block like every other alloca (`openAllocaMark`, and the
; `%__scr.h` scratch is the precedent), and that slot is what the
; reset is handed. Nothing the reset does changes: MM-ALLOC-16a's
; status-75 walk and MM-ALLOC-16b's status-76 evidence check run as
; they run for a hand-written mark, because they read the cell's
; three words and nothing else. `tests/stdlib/168-region.ax` term 8
; is a region inside a live `handle`'s extent, the shape 16b traps
; on when the mark is taken OUTSIDE the extent - the region's mark is
; inside it, and the operation still dispatches after the reset.
;
; THE BODY IS EMITTED IN NON-TAIL POSITION, on purpose. The reset
; must run after it, so a self call inside a region is a call and not
; the jump `emitExprTail` would make of it. A body that terminated its
; own block gets no reset after the terminator, because an instruction
; after one is not LLVM.
;
; WORD 31 IS NOT WHAT THIS USED TO SAY IT WAS. It read "word 31: a
; trap, an abort", and no trap and no abort sets it: the exhaustive
; list, re-grepped 2026-09-03, is `emitTailJump` (a self tail jump),
; `emitIfTail` when both arms terminated, the `musttail` leaf,
; `emitPairFwd`, and `emitPairRet` twice - six sites, all in this file,
; all reachable only under `emitExprTail`. Which makes this guard
; unreachable from a non-tail body exactly as the two in `emitArms`
; and `emitPairArms` are, and worth keeping for the same reason: the
; invariant lives in other functions and can move without warning
; here.
;
; THE VALUE IS THE BODY'S REGISTER, UNCHANGED. The checker refuses a
; body whose type is not a scalar (AX3059, `checkRegion`), so the word
; handed past the reset is a word and not an address into what the
; reset reclaimed. A program that writes no `region` reaches none of
; this and emits exactly what it emitted before, which is the half of
; MM-RGN-4 a gate can hold: `scripts/check-region-scope.sh`.
; ------------------------------------------------------------------
; A recovery point's record, `words` words, 16-byte aligned, in the
; entry block (`emitPrimRecover`): the alloca rule above, for a cell
; whose size is the record's.
(pub :: emitRecoverCell (-> CG String String CG))
(pub fn (emitRecoverCell cg cell words)
  {
    (let line
      (concat "  " (concat cell (concat " = alloca i64, i64 " (concat words ", align 16")))))
    (if (isNone (cgAllocaMark cg))
      (emitLine cg line)
      {
        (vecPush (cgHoisted cg) line)
        cg
      })
  })

(pub :: emitRegionCell (-> CG String CG))
;@axiom:effect(io)
(pub fn (emitRegionCell cg cell)
  {
    (let line
      (concat (concat "  " cell)
        (if (|| (== (resRegistryOn cg) 1) (reserveSupported cg))
          " = alloca i64, i64 4, align 16 ; axiom region mark"
          " = alloca i64, i64 3, align 16 ; axiom region mark")))
    (if (isNone (cgAllocaMark cg))
      (emitLine cg line)
      {
        (vecPush (cgHoisted cg) line)
        cg
      })
  })

; The owner registry's counter in a region's fourth cell word, so the
; region's reset cleans up the owners made inside it.
(pub :: emitRegionSeq (-> CG String Int))
;@axiom:effect(io)
(pub fn (emitRegionSeq cg cell)
  (if (&& (== (resRegistryOn cg) 0) (! (reserveSupported cg)))
    0
    {
      (let p3 (regStr (allocReg cg)))
      (let v (regStr (allocReg cg)))
      {
        (emitLine cg
          (concat (concat "  " p3) (concat " = getelementptr i64, ptr " (concat cell ", i64 3"))))
        (emitLine cg (concat (concat "  " v) (concat " = load i64, ptr " (reserveSeqName cg))))
        (emitLine cg (concat (concat "  store i64 " v) (concat ", ptr " p3)))
        0
      }
    }))

(pub :: emitRegion (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitRegion node cg)
  ; S4 slice 1: count the region-body depth up around the body
  ; and back down after, so `isRegionCoveredCon` can see it. The
  ; restore sits before the divergence check below on purpose:
  ; a body that never returns must not leak the count into the
  ; enclosing extent.
  {
    (let cell (regStr (allocReg cg)))
    (let p1 (regStr (allocReg cg)))
    (let p2 (regStr (allocReg cg)))
    (let br (regStr (allocReg cg)))
    (let er (regStr (allocReg cg)))
    (let kr (regStr (allocReg cg)))
    {
      (let _0 (emitRegionCell cg cell))
      (let _1
        (emitLine cg
          (concat (concat "  " p1) (concat " = getelementptr i64, ptr " (concat cell ", i64 1")))))
      (let _2
        (emitLine cg
          (concat (concat "  " p2) (concat " = getelementptr i64, ptr " (concat cell ", i64 2")))))
      (let _3 (emitLine cg (concat (concat "  " br) " = load i64, ptr @__axiom_bump")))
      (let _4 (emitLine cg (concat (concat "  " er) " = load i64, ptr @__axiom_bump_end")))
      (let _5 (emitLine cg (concat (concat "  " kr) " = load i64, ptr @__axiom_chunk")))
      (let _6 (emitLine cg (concat (concat "  store i64 " br) (concat ", ptr " (concat cell "")))))
      (let _7 (emitLine cg (concat (concat "  store i64 " er) (concat ", ptr " (concat p1 "")))))
      (let _8 (emitLine cg (concat (concat "  store i64 " kr) (concat ", ptr " (concat p2 "")))))
      (let _8r (emitRegionSeq cg cell))
      (let rgnSaved (cgRegionDepth cg))
      (let _rgn (cgSetRegionDepth cg (+ rgnSaved 1)))
      (let cgB (emitExpr (nodeBChild node) cg))
      (let _rgnBack (cgSetRegionDepth cgB rgnSaved))
      (if (== (cgTerminated cgB) 1)
        cgB
        {
          (let val (strDup (cgResult cgB)))
          (let flag (cgResultFloat cgB))
          (let ci (regStr (allocReg cgB)))
          (let rr (regStr (allocReg cgB)))
          {
            (let _9
              (emitLine cgB
                (concat (concat "  " ci) (concat " = ptrtoint ptr " (concat cell " to i64")))))
            (let _10
              (emitLine cgB
                (concat (concat "  " rr)
                  (concat " = call i64 @__axiom_arena_reset_fn(i64 " (concat ci ")")))))
            {
              (cgSetResult cgB val)
              (cgSetResultFloat cgB flag)
              cgB
            }
          }
        })
    }
  })

(pub :: emitIf (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitIf node cg)
  ; A well-typed `if` yields the same type from both branches, so
  ; the then-branch's float-ness stands for the whole form.
  ; The block that actually reaches the merge, which is the last
  ; one this branch emitted - not the one it started in. A nested
  ; `if` leaves its own merge block current, and naming the outer
  ; label here made the phi list a predecessor that no longer
  ; branches to it.
  {
    (let testExpr (nodeAChild node))
    (let thenExpr (nodeBChild node))
    (let elseExpr (nodeCChild node))
    (let cg1 (emitExpr testExpr cg))
    (let testReg (strDup (cgResult cg1)))
    (let cmpN (allocReg cg1))
    (let thenLbl (allocReg cg1))
    (let elseLbl (allocReg cg1))
    (let mergeLbl (allocReg cg1))
    (let cmpR (regStr cmpN))
    (let thenB (labelStr thenLbl))
    (let elseB (labelStr elseLbl))
    (let mergeB (labelStr mergeLbl))
    (let _1
      (emitLine cg1 (concat (concat "  " cmpR) (concat " = icmp ne i64 " (concat testReg ", 0")))))
    (let _2
      (emitLine cg1
        (concat (concat "  br i1 " (concat cmpR ", label %"))
          (concat thenB (concat (concat ", label %" elseB) "")))))
    (let _3 (emitLabel cg1 thenB))
    (let cg2 (emitExpr thenExpr cg1))
    (let thenVal (strDup (cgResult cg2)))
    (let thenFlag (cgResultFloat cg2))
    (let thenPred (strDup (cgBlock cg2)))
    (let _4 (emitLine cg2 (concat "  br label %" mergeB)))
    (let _5 (emitLabel cg2 elseB))
    (let cg3 (emitExpr elseExpr cg2))
    (let elseVal (strDup (cgResult cg3)))
    (let elsePred (strDup (cgBlock cg3)))
    (let _6 (emitLine cg3 (concat "  br label %" mergeB)))
    (let _7 (emitLabel cg3 mergeB))
    (let phiN (allocReg cg3))
    (let phiR (regStr phiN))
    (let _8
      (emitLine cg3
        (concat (concat (concat "  " phiR) (concat " = phi i64 [ " thenVal))
          (concat (concat ", %" (concat thenPred " ], [ "))
            (concat (concat elseVal (concat ", %" elsePred)) " ]")))))
    (let _9 (cgSetResult cg3 phiR))
    (let _10 (cgSetResultFloat cg3 thenFlag))
    cg3
  })

; Emit a block label and record it as the block now being written into.
(pub :: emitLabel (-> CG String CG))
(pub fn (emitLabel cg name)
  {
    (emitLine cg (concat name ":"))
    (cgSetBlock cg (strDup name))
    cg
  })

; A call's line marker and the address anchor that makes it
; resolvable. `emitCallMark snode cg regnum` opens a label for the
; call about to be emitted, then records the call's source location
; as a comment the module-end scan harvests: `; @@line <module>
; <spanstart>`, or `; @@line <spanstart>` for the entry file, whose
; module word is 0. The register number is fresh by construction
; (`allocReg` never reuses one inside a function), so the label is
; unique without a counter - and the marker is always the line after
; its label, which is the invariant the scan asserts.
;
; The label goes BEFORE the call (not after it): a return address
; points past the call, so only an address at or before the call can
; resolve to it - a fallthrough label past the call would sit above
; every such address and match nothing. The closing branch is an
; unconditional `br` to the new label: a basic block must end in a
; terminator, so a bare label mid-sequence is ill-formed IR and `llc`
; rejects it. Straight-line code keeps its order and its values - one
; predictable branch per call, folded away above `--opt 0 - and the
; marker is always the line after its label, which is the invariant
; the scan asserts.
;
; `snode` 0 - a call with no source node behind it - emits nothing
; at all: runtime-helper bodies and prim emitters keep their exact
; bytes, and a frame with no marker resolves the way it always did.
; Spanless nodes (span 0) are likewise silent, which is the
; compiler's standing rule for spanlessness: a node with no span
; suppresses its diagnostic rather than pointing it somewhere wrong.
; musttail calls never reach here at all - the callee reuses the
; frame, so no return address exists to resolve, and a label between
; the call and its `ret` would void the `musttail` marker LLVM
; requires adjacent.
(pub :: emitCallMark (-> ASTNode CG Int CG))
(pub fn (emitCallMark snode cg regnum)
  (if (nodeSame snode nilNode)
    cg
    {
      (let lbl (concat ".LL" (fmtInt regnum)))
      {
        (emitLine cg (concat "  br label %" lbl))
        (emitLabel cg lbl)
        (emitLineMark snode cg)
      }
    }))

; The marker alone, for blocks the emitter already isolates: trap
; guards (`divzero_`, the unhandled-effect trap) end their block with
; the call, so the marker opens nothing and pairs with that block's
; own label.
(pub :: emitLineMark (-> ASTNode CG CG))
(pub fn (emitLineMark snode cg)
  (if (nodeSame snode nilNode)
    cg
    ; A null span word suppresses, which is the compiler's standing
    ; rule for spanlessness; offset 0 itself is a real location (the
    ; file's first byte) and must NOT suppress with it.
    {
      (let sp (nodeSpan snode))
      (if (== sp 0)
        cg
        {
          (let mod (nodeModule snode))
          (if (== mod 0)
            (emitLine cg (concat "; @@line " (fmtInt (spanStart sp))))
            (emitLine cg
              (concat (concat "; @@line " (nodeModuleName snode))
                (concat " " (concat (fmtInt (spanStart sp)) "")))))
        })
    }))

(pub :: emitBegin (-> ASTNode CG CG))
;@axiom:effect(io)
(pub fn (emitBegin node cg)
  {
    (let exprs (nodeAChildren node))
    (emitSeq exprs cg 0)
  })

(pub :: emitSeq (-> (Vec ASTNode) CG Int CG))
; MM-LIFE-2c event 2, the sound subset: a DIRECTLY-BUILT construction
; discarded in statement position is released on the spot - its birth
; count is the only share (the stash audit proved co-owners exist for
; call results and locals, so only the syntactic direct-build shape
; releases in this slice; its fields were retained by event 6, so the
; walk hands their shares back correctly).
;@axiom:effect(io)
(pub fn (emitSeq exprs cg i)
  (if (>= i (vecLen exprs))
    cg
    ; Since 2026-08-21 the share handed back is any OWNED
    ; reference (`valueOwnedRef`) - a call to a
    ; reference-returning global included, now that event 2
    ; makes every such call answer one share - not only the
    ; syntactic direct construction.
    ; a TRANSFERRED type-variable result discarded here is
    ; the caller's share too (MM-LIFE-2n): plain for a
    ; counted type, under the evidence bit for a variable
    {
      (let e (vecGet exprs i))
      {
        (let cg1 (emitExpr e cg))
        {
          (let cg2
            ; A static value's release is a no-op, so a literal - or a
            ; `set` that stores one - dropped here gives nothing back.
            (if (if (>= (+ i 1) (vecLen exprs))
              false
              (&& (== (valueOwnedRef cg1 e) 1) (== (isStaticSentinelNode cg1 e) 0)))
              (emitReleaseOf cg1 (strDup (cgResult cg1)))
              {
                (let tcls
                  (if (>= (+ i 1) (vecLen exprs))
                    0
                    (transferClass cg1 e)))
                (if (== tcls 1)
                  (emitReleaseOf cg1 (strDup (cgResult cg1)))
                  (if (>= tcls 2)
                    {
                      (let res (strDup (cgResult cg1)))
                      (let cgW (emitEvwRead cg1))
                      {
                        (let cgR (emitRcIfBitOf cgW res (- tcls 2) (strDup (cgResult cgW)) 0))
                        {
                          (cgSetResult cgR res)
                          cgR
                        }
                      }
                    }
                    cg1))
              }))
          (emitSeq exprs cg2 (+ i 1))
        }
      }
    }))

; A bare string *is* a `Str`: it evaluates to the address of the static
; `{ len, bytes }` header emitted alongside its bytes, so the length is
; a compile-time constant and no `cstrLen` scan is needed. `__addr` is
; the way to reach the bytes underneath (see `emitPrimAddr`), and the
; two must not be confused - a header describing a header reads back
; the wrong length and the wrong bytes, silently.
(pub :: emitStrExpr (-> ASTNode CG CG))
(pub fn (emitStrExpr node cg)
  ; Element 2 of the headered static (MM-LIFE-2b): the handle
  ; the program holds points AT the {len, bytes} pair, with the
  ; count/shape words physically at handle-16 like every heap
  ; block's.
  {
    (let id (internString cg (nodeAName node)))
    (let rn (allocReg cg))
    {
      (let r (regStr rn))
      {
        (emitLine cg
          (concat (concat "  " r)
            (concat
              " = ptrtoint ptr getelementptr inbounds ({ i64, i64, i64, ptr, i64 }, ptr @strhdr_"
              (concat (fmtInt id) ", i64 0, i32 2) to i64"))))
        (cgSetResult cg r)
        (cgSetResultFloat cg 0)
        cg
      }
    }
  })

(pub :: emitDefault (-> CG CG))
(pub fn (emitDefault cg)
  {
    (cgSetResult cg "0")
    (cgSetResultFloat cg 0)
    cg
  })

; Counted resource owners use the foreign form with a C-ABI trampoline.
; The owner retains its callback; closing retires it before calling the
; callback, then releases the callback and its captured references.
(pub :: emitResourceRuntime (-> CG CG))
(pub fn (emitResourceRuntime cg)
  {
    (emitLine cg
      "@__axiom_resource_dead_msg = private unnamed_addr constant [33 x i8] c\"axiom: use of a closed resource\\0A\\00\"")
    (emitLine cg "define internal i64 @__axiom_resource_dead() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %msg = ptrtoint ptr @__axiom_resource_dead_msg to i64")
    (emitRuntimeWrite cg "%msg" "32")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "85")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_resource_drop(i64 %h) #0 {")
    (emitLine cg "entry:")
    (if (== (resRegistryOn cg) 1)
      (emitLine cg "  call void @__axiom_resource_unlink(i64 %h)"))
    (emitLine cg "  %ca = add i64 %h, 16")
    (emitLine cg "  %cap = inttoptr i64 %ca to ptr")
    (emitLine cg "  %c = atomicrmw xchg ptr %cap, i64 0 seq_cst")
    (emitLine cg "  %has = icmp ne i64 %c, 0")
    (emitLine cg "  br i1 %has, label %run, label %done")
    (emitLine cg "run:")
    (emitLine cg "  %vp = inttoptr i64 %h to ptr")
    (emitLine cg "  %vpp = getelementptr i64, ptr %vp, i64 3")
    (emitLine cg "  %v = load i64, ptr %vpp")
    (emitLine cg "  %record = inttoptr i64 %c to ptr")
    (emitLine cg "  %code = load i64, ptr %record")
    (emitLine cg "  %fn = inttoptr i64 %code to ptr")
    (emitLine cg "  %r = call i64 %fn(i64 %c, i64 %v, i64 0)")
    (emitLine cg "  call void @axiom_release(i64 %c)")
    (emitLine cg "  ret i64 %r")
    (emitLine cg "done:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_resource_new(i64 %closure, i64 %value) #0 {")
    (emitLine cg "entry:")
    ; Refuse before acquiring a callback share or allocating its owner.
    ; The registry and reservations use one bounded, monotonic counter.
    (if (== (resRegistryOn cg) 1)
      {
        (emitLine cg "  %sequence = load i64, ptr @__axiom_res_seq")
        (emitLine cg "  %sequencefull = icmp uge i64 %sequence, 9223372036854775807")
        (emitLine cg "  br i1 %sequencefull, label %sequence_exhausted, label %acquire")
        (emitLine cg "sequence_exhausted:")
        (emitLine cg "  call i64 @__axiom_resource_sequence_exhausted()")
        (emitLine cg "  unreachable")
        (emitLine cg "acquire:")
      })
    (emitLine cg "  call void @axiom_retain(i64 %closure)")
    (emitLine cg
      (if (== (resRegistryOn cg) 1)
        "  %h = call i64 @axiom_alloc(i64 56)"
        "  %h = call i64 @axiom_alloc(i64 32)"))
    (emitLine cg "  %rc = add i64 %h, -16")
    (emitLine cg "  %rcp = inttoptr i64 %rc to ptr")
    (emitLine cg "  store i64 1, ptr %rcp")
    (emitLine cg "  %sh = add i64 %h, -8")
    (emitLine cg "  %shp = inttoptr i64 %sh to ptr")
    (emitLine cg "  %s = load i64, ptr %shp")
    (emitLine cg "  %foreign = or i64 %s, 1")
    (emitLine cg "  store i64 %foreign, ptr %shp")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %fn = ptrtoint ptr @__axiom_resource_drop to i64")
    (emitLine cg "  store i64 %fn, ptr %p")
    (emitLine cg "  %arg = getelementptr i64, ptr %p, i64 1")
    (emitLine cg "  store i64 %h, ptr %arg")
    (emitLine cg "  %cp = getelementptr i64, ptr %p, i64 2")
    (emitLine cg "  store i64 %closure, ptr %cp")
    (emitLine cg "  %vp = getelementptr i64, ptr %p, i64 3")
    (emitLine cg "  store i64 %value, ptr %vp")
    (if (== (resRegistryOn cg) 1)
      (emitLine cg "  call void @__axiom_resource_link(i64 %h)"))
    (emitLine cg "  ret i64 %h")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_resource_check(i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %small = icmp ult i64 %h, 4096")
    (emitLine cg "  br i1 %small, label %bad, label %check")
    (emitLine cg "check:")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %fn = load i64, ptr %p")
    (emitLine cg "  %want = ptrtoint ptr @__axiom_resource_drop to i64")
    (emitLine cg "  %ok = icmp eq i64 %fn, %want")
    (emitLine cg "  br i1 %ok, label %done, label %bad")
    (emitLine cg "bad:")
    (emitLine cg "  %e = call i64 @__axiom_resource_dead()")
    (emitLine cg "  unreachable")
    (emitLine cg "done:")
    (emitLine cg "  ret i64 %h")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_resource_get(i64 %owner) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %h = call i64 @__axiom_resource_check(i64 %owner)")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %ap = getelementptr i64, ptr %p, i64 1")
    (emitLine cg "  %arg = load atomic i64, ptr %ap seq_cst, align 8")
    (emitLine cg "  %live = icmp ne i64 %arg, 0")
    (emitLine cg "  br i1 %live, label %done, label %bad")
    (emitLine cg "bad:")
    (emitLine cg "  %e = call i64 @__axiom_resource_dead()")
    (emitLine cg "  unreachable")
    (emitLine cg "done:")
    (emitLine cg "  %vp = getelementptr i64, ptr %p, i64 3")
    (emitLine cg "  %v = load i64, ptr %vp")
    (emitLine cg "  ret i64 %v")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_resource_close(i64 %owner) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %h = call i64 @__axiom_resource_check(i64 %owner)")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %ap = getelementptr i64, ptr %p, i64 1")
    (emitLine cg "  %arg = atomicrmw xchg ptr %ap, i64 0 seq_cst")
    (emitLine cg "  %live = icmp ne i64 %arg, 0")
    (emitLine cg "  br i1 %live, label %close, label %done")
    (emitLine cg "close:")
    (emitLine cg "  %r = call i64 @__axiom_resource_drop(i64 %arg)")
    (emitLine cg "  ret i64 %r")
    (emitLine cg "done:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_resource_disarm(i64 %owner) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %nil = icmp eq i64 %owner, 0")
    (emitLine cg "  br i1 %nil, label %done, label %check")
    (emitLine cg "check:")
    (emitLine cg "  %h = call i64 @__axiom_resource_check(i64 %owner)")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %ap = getelementptr i64, ptr %p, i64 1")
    (emitLine cg "  %arg = atomicrmw xchg ptr %ap, i64 0 seq_cst")
    (emitLine cg "  %cp = getelementptr i64, ptr %p, i64 2")
    (emitLine cg "  %closure = atomicrmw xchg ptr %cp, i64 0 seq_cst")
    (if (== (resRegistryOn cg) 1)
      (emitLine cg "  call void @__axiom_resource_unlink(i64 %h)"))
    (emitLine cg "  call void @axiom_release(i64 %closure)")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (if (== (resRegistryOn cg) 1)
      (emitResourceRegistry cg)
      cg)
  })

; ------------------------------------------------------------------
; THE OWNER REGISTRY (docs/memory-model.md MM-EXEC-20). An arena reset
; reclaims every block made since its mark, and an owner among them
; would go without its cleanup: a lock guard would leave its lock held
; for ever. So in a module that makes owners AND resets the arena (a
; recovery point, a region, a raw reset; `resRegistryOn`), every owner
; is linked, newest first, on a list that belongs to its thread, and
; numbered from a counter. A mark keeps the counter in its fourth word,
; and the reset first runs the cleanup of every owner on the list
; numbered above it - before a byte is reclaimed, so each callback runs
; on memory that is still its own.
;
; Payload words 4 and 5 are the links (older, newer) and word 6 the
; number, 0 once unlinked. An owner leaves the list when its callback
; is claimed - its death, an early close, a disarm - so a block the
; allocator files is never on it, and an unlink of one already off it
; changes nothing. The three globals are thread-local under threads:
; an owner lives in its thread's arena and dies in that thread (a
; `parallel` binding that borrows one has its count frozen,
; MM-PAR-6b), so each list has one writer.
;
; `@__axiom_res_unwinding` is 1 while a recovery abort's reset runs
; those callbacks, and `__resource_unwinding` reads it: a lock guard's
; cleanup poisons its mutex then, since the critical section it guarded
; did not finish (MM-PAR-15). A region's reset leaves it 0.
; ------------------------------------------------------------------
(pub :: emitResourceRegistry (-> CG CG))
(pub fn (emitResourceRegistry cg)
  {
    (emitLine cg (concat "@__axiom_res_head = " (concat (cgMutGlobal cg) " i64 0")))
    (emitLine cg (concat "@__axiom_res_seq = " (concat (cgMutGlobal cg) " i64 0")))
    (emitLine cg (concat "@__axiom_res_unwinding = " (concat (cgMutGlobal cg) " i64 0")))
    (emitLine cg "define internal void @__axiom_resource_link(i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %n0 = load i64, ptr @__axiom_res_seq")
    (emitLine cg "  %n = add i64 %n0, 1")
    (emitLine cg "  store i64 %n, ptr @__axiom_res_seq")
    (emitLine cg "  %sp = getelementptr i64, ptr %p, i64 6")
    (emitLine cg "  store i64 %n, ptr %sp")
    (emitLine cg "  %head = load i64, ptr @__axiom_res_head")
    (emitLine cg "  %np = getelementptr i64, ptr %p, i64 4")
    (emitLine cg "  store i64 %head, ptr %np")
    (emitLine cg "  %pp = getelementptr i64, ptr %p, i64 5")
    (emitLine cg "  store i64 0, ptr %pp")
    (emitLine cg "  %has = icmp ne i64 %head, 0")
    (emitLine cg "  br i1 %has, label %back, label %done")
    (emitLine cg "back:")
    (emitLine cg "  %hp = inttoptr i64 %head to ptr")
    (emitLine cg "  %hb = getelementptr i64, ptr %hp, i64 5")
    (emitLine cg "  store i64 %h, ptr %hb")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  store i64 %h, ptr @__axiom_res_head")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "define internal void @__axiom_resource_unlink(i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %p = inttoptr i64 %h to ptr")
    (emitLine cg "  %sp = getelementptr i64, ptr %p, i64 6")
    (emitLine cg "  %n = load i64, ptr %sp")
    (emitLine cg "  %on = icmp ne i64 %n, 0")
    (emitLine cg "  br i1 %on, label %cut, label %done")
    (emitLine cg "cut:")
    (emitLine cg "  %np = getelementptr i64, ptr %p, i64 4")
    (emitLine cg "  %nx = load i64, ptr %np")
    (emitLine cg "  %pp = getelementptr i64, ptr %p, i64 5")
    (emitLine cg "  %pv = load i64, ptr %pp")
    (emitLine cg "  %hasp = icmp ne i64 %pv, 0")
    (emitLine cg "  br i1 %hasp, label %mid, label %first")
    (emitLine cg "mid:")
    (emitLine cg "  %pvp = inttoptr i64 %pv to ptr")
    (emitLine cg "  %pv4 = getelementptr i64, ptr %pvp, i64 4")
    (emitLine cg "  store i64 %nx, ptr %pv4")
    (emitLine cg "  br label %fwd")
    (emitLine cg "first:")
    (emitLine cg "  store i64 %nx, ptr @__axiom_res_head")
    (emitLine cg "  br label %fwd")
    (emitLine cg "fwd:")
    (emitLine cg "  %hasn = icmp ne i64 %nx, 0")
    (emitLine cg "  br i1 %hasn, label %back, label %clear")
    (emitLine cg "back:")
    (emitLine cg "  %nxp = inttoptr i64 %nx to ptr")
    (emitLine cg "  %nx5 = getelementptr i64, ptr %nxp, i64 5")
    (emitLine cg "  store i64 %pv, ptr %nx5")
    (emitLine cg "  br label %clear")
    (emitLine cg "clear:")
    (emitLine cg "  store i64 0, ptr %sp")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    ; Every owner numbered above `floor`, newest first: claimed, taken
    ; off the list and cleaned up. A callback that makes an owner makes
    ; a newer one, which this loop then takes too; one that traps
    ; re-enters the abort, which finds this owner already off the list.
    (emitLine cg "define internal void @__axiom_resource_unwind(i64 %floor) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %head = load i64, ptr @__axiom_res_head")
    (emitLine cg "  %empty = icmp eq i64 %head, 0")
    (emitLine cg "  br i1 %empty, label %done, label %test")
    (emitLine cg "test:")
    (emitLine cg "  %hp = inttoptr i64 %head to ptr")
    (emitLine cg "  %sp = getelementptr i64, ptr %hp, i64 6")
    (emitLine cg "  %n = load i64, ptr %sp")
    (emitLine cg "  %inside = icmp sgt i64 %n, %floor")
    (emitLine cg "  br i1 %inside, label %one, label %done")
    (emitLine cg "one:")
    (emitLine cg "  %ap = getelementptr i64, ptr %hp, i64 1")
    (emitLine cg "  %arg = atomicrmw xchg ptr %ap, i64 0 seq_cst")
    (emitLine cg "  call void @__axiom_resource_unlink(i64 %head)")
    (emitLine cg "  %live = icmp ne i64 %arg, 0")
    (emitLine cg "  br i1 %live, label %run, label %loop")
    (emitLine cg "run:")
    (emitLine cg "  %r = call i64 @__axiom_resource_drop(i64 %arg)")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    cg
  })

; Is the owner registry in this module (slot 19, `parScan`)?
(pub :: resRegistryOn (-> CG Int))
(pub fn (resRegistryOn cg)
  (cgRegistry cg))

; `__resource_unwinding`: 1 while a recovery abort runs the cleanup of
; the owners made inside its extent, otherwise 0 - always 0 in a module
; with no owner registry, which has no such abort.
(pub :: emitPrimResUnwinding (-> CG CG))
(pub fn (emitPrimResUnwinding cg)
  (if (== (resRegistryOn cg) 0)
    {
      (cgSetResult cg "0")
      (cgSetResultFloat cg 0)
      cg
    }
    {
      (let r (regStr (allocReg cg)))
      {
        (emitLine cg (concat (concat "  " r) " = load i64, ptr @__axiom_res_unwinding"))
        (cgSetResult cg r)
        (cgSetResultFloat cg 0)
        cg
      }
    }))

(pub :: emitPrimResource (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimResource name args cg)
  {
    (let cg1 (emitExpr (vecGet args 0) cg))
    (let first (strDup (cgResult cg1)))
    (let tail
      (if (strEq name "__resource_new")
        {
          (let cg2 (emitExpr (vecGet args 1) cg1))
          (concat ", i64 " (cgResult cg2))
        }
        ""))
    (let r (regStr (allocReg cg1)))
    {
      (emitLine cg1
        (concat
          (concat
            (concat (concat (concat "  " r) " = call i64 @__axiom") (strSlice name 1 (strLen name)))
            "(i64 ")
          (concat first (concat tail ")"))))
      ; The runtime borrows its operand and takes its own callback
      ; share. Return a temporary's share after the call, including a
      ; global function materialised as a closure record.
      {
        (let a (vecGet args 0))
        (if (&& (== (valueOwnedRef cg1 a) 1) (== (isStaticSentinelNode cg1 a) 0))
          (emitReleaseOf cg1 first)
          cg1)
      }
      (cgSetResult cg1 r)
      (cgSetResultFloat cg1 0)
      cg1
    }
  })

; A region reset reclaims bytes, but must not replace resource cleanup.
; Only values proved to contain no callbacks may omit their releases.
(pub :: dropFreeTy (-> CG ASTNode Int Bool))
(pub fn (dropFreeTy cg ty depth)
  (dropFreeTyIn cg ty depth vecNew))

; `seen` names the types whose check is in progress. One named again
; is assumed free, so the answer is a greatest fixpoint: a recursive
; type such as a tree is drop-free when every field of every
; constructor is, given that it is. A closure or a resource can only
; enter through some field, and every field is still checked; `depth`
; bounds the walk through type arguments.
(:: dropFreeTyIn (-> CG ASTNode Int Names Bool))
(fn (dropFreeTyIn cg ty depth seen)
  (if (|| (nodeSame ty nilNode) (<= depth 0))
    false
    (if (== (fldClass cg ty) 0)
      true
      (if (!= (nodeTag ty) TAG_T_CON)
        false
        {
          (let n (nodeAName ty))
          (if (strEq n "String")
            true
            (if (|| (strEq n "Option") (strEq n "Vec"))
              (dropFreeTypes cg (nodeBChildren ty) (- depth 1) 0 seen)
              (if (dropFreeSeen seen n)
                true
                {
                  (let inner (dropFreeSeenWith seen n))
                  (let entryFound (lookupType (cgTypes cg) n))
                  (if (let (Some entry) entryFound)
                    (if (== (eKind entry) TF_DATA)
                      (dropFreeDataTy cg n depth inner)
                      (dropFreeFields cg entry (- depth 1) 0 inner))
                    (dropFreeDataTy cg n depth inner))
                })))
        }))))

(:: dropFreeDataTy (-> CG String Int Names Bool))
(fn (dropFreeDataTy cg n depth inner)
  {
    (let decls (cgDecls cg))
    (let mut i 0)
    (let mut found false)
    (let mut safe true)
    {
      (while (< i (vecLen decls))
        {
          {
            (let d (vecGet decls i))
            (if (&& (== (nodeTag d) TAG_D_DATA) (strEq (cgDeclaredTypeName d) n))
              {
                (let ctors (nodeBChildren d))
                (let mut j 0)
                {
                  (set found true)
                  (while (< j (vecLen ctors))
                    {
                      (set safe (&& safe
                                  (dropFreeTypes cg (nodeTyChildren (vecGet ctors j)) (- depth 1) 0
                                    inner)))
                      (set j (+ j 1))
                    })
                }
              })
          }
          (set i (+ i 1))
        })
      (&& found safe)
    }
  })

(:: dropFreeSeen (-> Names String Bool))
(fn (dropFreeSeen seen n)
  {
    (let mut hit false)
    {
      (for s in seen
        (if (strEq s n)
          (set hit true)))
      hit
    }
  })

(:: dropFreeSeenWith (-> Names String Names))
(fn (dropFreeSeenWith seen n)
  {
    (let out vecNew)
    {
      (for s in seen
        (vecPush out s))
      (vecPush out n)
    }
  })

(pub :: dropFreeTypes (-> CG (Vec ASTNode) Int Int Names Bool))
(pub fn (dropFreeTypes cg tys depth i seen)
  (if (>= i (vecLen tys))
    true
    (&& (dropFreeTyIn cg (vecGet tys i) depth seen) (dropFreeTypes cg tys depth (+ i 1) seen))))

(pub :: dropFreeFields (-> CG TypeEntry Int Int Names Bool))
(pub fn (dropFreeFields cg entry depth i seen)
  (if (|| (== (eKind entry) TF_WORD) (>= i (eArity entry)))
    true
    (match (fieldTypeNode entry i)
      ((None) false)
      ((Some ty)
        (&& (dropFreeTyIn cg ty depth seen) (dropFreeFields cg entry depth (+ i 1) seen))
      ))))

(pub :: dropFreeExpr (-> CG ASTNode Bool))
(pub fn (dropFreeExpr cg e)
  {
    (let tag (nodeTag e))
    (if (== tag TAG_E_IF)
      (&& (dropFreeExpr cg (nodeBChild e)) (dropFreeExpr cg (nodeCChild e)))
      (if (== tag TAG_E_MATCH)
        (dropFreeArms cg (nodeBChildren e) 0)
        {
          (let hd
            (if (== tag TAG_E_APP)
              (spineHead e)
              e))
          (if (|| (== (nodeTag hd) TAG_E_VAR) (== tag TAG_E_STRUCTCON))
            {
              (let n (nodeAName hd))
              (let entryFound (lookupType (cgTypes cg) n))
              (if (let (Some entry) entryFound)
                (dropFreeFields cg entry 16 0 (vecPush vecNew n))
                {
                  (let sigFound (findFSigCg cg (mangledForCg cg n)))
                  (if (let (Some sig) sigFound)
                    (match (fnDeclaredResultTy (fsigTy sig) (fsigArity sig))
                      ((None) false)
                      ((Some ty) (dropFreeTy cg ty 16)))
                    false)
                })
            }
            false)
        }))
  })

(pub :: dropFreeArms (-> CG (Vec ASTNode) Int Bool))
(pub fn (dropFreeArms cg arms i)
  (if (>= i (vecLen arms))
    true
    (&& (dropFreeExpr cg (nodeBChild (vecGet arms i))) (dropFreeArms cg arms (+ i 1)))))

; A reference-returning tail has already retained each borrowed leaf.
; Returning a field therefore does not keep its consumed Result alive.
(pub :: tailScrutineeReleasable (-> ASTNode ASTNode CG Int))
(pub fn (tailScrutineeReleasable node scrutExpr cg)
  (if (== (scrutineeReleasable node scrutExpr cg) 1)
    1
    {
      (let d (cgCurDecl cg))
      (if (let (Some d) d)
        (if (&& (== (fnResultClass cg (nodeAName d)) 2)
              (&& (== (valueOwnedRef cg scrutExpr) 1)
                (== (escapesViaBinders cg (nodeBChildren node) 0 0 (binderSummary node)) 0)))
          1
          0)
        0)
    }))

; Does a lambda's capture of `name` take a share of its own? The
; capture reads the binding `emitVar` resolves: the innermost symbol,
; or, when there is none, the enclosing function's parameter. A
; parameter's TCO slot (kind 2) is that parameter. So a local that
; shadows a parameter answers for itself: a counted `let` (kind 3) or
; an owning `mut` slot (kind 4) takes a share, and anything else takes
; none, whatever the parameter's type. The escape walk's lambda arm
; asks the same question of the same table (`escapes`), and
; `lamShapeBits` and `retainParamCaps` ask this one, so the share a
; capture is counted for is the share the record holds.
(pub :: captureCounted (-> CG String Bool))
(pub fn (captureCounted cg name)
  (if (if (! (hasSym cg name))
    true
    (== (lookupSymKind cg name) 2))
    {
      (let pi (curParamIndex cg name))
      (if (< pi 0)
        false
        (== (curParamRefClass cg pi) 1))
    }
    (>= (lookupSymKind cg name) 3)))

; Applications remember their checked result type and reference witness.
(pub :: checkedValueTy (-> ASTNode ASTNode))
(pub fn (checkedValueTy e)
  {
    (let t (nodeBinderTyChild e))
    (if (if (nodeSame t nilNode)
      false
      (== (nodeTag t) TAG_EVSTAMP))
      (nodeAChild t)
      t)
  })

; A call's final step may be through a closure even when its head is
; global: surplus arguments invoke the returned value. Match the same
; defined-function and arity gates that emitOverApplied uses. Its final
; result follows the closure return contract, independently of the
; named function's declared or inferred result ownership.
(pub :: closureOwnedCall (-> CG ASTNode Bool))
(pub fn (closureOwnedCall cg e)
  (if (== (nodeTag e) TAG_E_APP)
    {
      (let h (spineHead e))
      (if (== (nodeTag h) TAG_E_VAR)
        {
          (let name (nodeAName h))
          (if (&& (!= (nodeDefScope h) 1) (isLocalValue cg name))
            true
            {
              (let full (mangledForCg cg name))
              (if (isDefinedFnCg cg full)
                {
                  (let arity (fnArityOfCg cg full))
                  (&& (> arity 0) (> (spineArity e) arity))
                }
                false)
            })
        }
        true)
    }
    false))

; Bit 0 describes the argument; bit 1 describes the result. Intermediate
; applications return a closure. Final applications use the checked witness.
(pub :: emitClosureResultWord (-> CG ASTNode Int CG))
(pub fn (emitClosureResultWord cg e final)
  (if (== final 0)
    {
      (cgSetResult cg "2")
      cg
    }
    {
      (let t
        (if (nodeSame e nilNode)
          nilNode
          (nodeBinderTyChild e)))
      {
        (let w
          (if (if (nodeSame t nilNode)
            false
            (&& (== (nodeTag t) TAG_EVSTAMP) (cgDeclarationMatches cg (nodeCChild t))))
            (nodeB t)
            0))
        {
          (let vs vecNew)
          {
            (vecPush vs w)
            {
              (let cgW (emitEvWordVal cg (nodeBuildEvstampCallOptional (cgCurDecl cg) vs vecNew)))
              {
                (let r (regStr (allocReg cgW)))
                {
                  (emitLine cgW
                    (concat (concat "  " r) (concat " = shl i64 " (concat (cgResult cgW) ", 1"))))
                  (cgSetResult cgW r)
                  cgW
                }
              }
            }
          }
        }
      }
    }))

; Refine a conservative higher-order park only for a literal identity
; callback with a concrete reference result. Its lifted body returns an
; owned share and cannot store or consume its argument.
(pub :: flowIdentityCallback (-> CG String Bool))
(pub fn (flowIdentityCallback cg name)
  (if (let (Some identities) (cgFlowIdentities cg))
    (== (strVecHas identities name) 1)
    false))

(pub :: literalRefIdentity (-> CG ASTNode Bool))
(pub fn (literalRefIdentity cg e)
  (if (== (nodeTag e) TAG_E_LAM)
    {
      (let ps (nodeANames e))
      (let b (nodeBChild e))
      (let t (nodeBinderTyChild e))
      (if (&& (== (vecLen ps) 1)
            (&& (== (nodeTag b) TAG_E_VAR)
              (if (nodeSame t nilNode)
                false
                (== (nodeTag t) TAG_T_ARR))))
        (&& (strEq (vecGetStr ps 0) (nodeAName b)) (== (fldClass cg (tyResolve (nodeBChild t))) 2))
        false)
    }
    false))

(pub :: callFlowDecl (-> (Vec ASTNode) String Int ASTNode))
(pub fn (callFlowDecl ds name i)
  (if (>= i (vecLen ds))
    nilNode
    {
      (let d (vecGet ds i))
      (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeAName d) name))
        d
        (callFlowDecl ds name (+ i 1)))
    }))

(pub :: fnCallStashMask (-> CG String Nodes Int))
(pub fn (fnCallStashMask cg name args)
  {
    (let base (fnStashMask cg name))
    (if (== base 0)
      0
      {
        (let d (callFlowDecl (cgDecls cg) (mangledForCg cg name) 0))
        (if (nodeSame d nilNode)
          base
          {
            (let ps (nodeBNames d))
            (let ids vecNew)
            (let mut i 0)
            {
              (while (&& (< i (vecLen ps)) (< i (vecLen args)))
                {
                  (if (literalRefIdentity cg (vecGet args i))
                    (vecPush ids (vecGet ps i))
                    ids)
                  (set i (+ i 1))
                })
              (if (== (vecLen ids) 0)
                base
                {
                  (let saved (cgFlowIdentities cg))
                  (let savedDecl (cgCurDecl cg))
                  (let savedMod (cgModule cg))
                  (let cell regionNew)
                  {
                    (cgSetFlowIdentities cg (Some ids))
                    (cgSetCurDecl cg (Some d))
                    (cgSetDeclModule cg d)
                    (flowStashes cg (nodeCChild d) ps vecNew cell)
                    {
                      (let mask (regionNet cell))
                      {
                        (cgSetFlowIdentities cg saved)
                        (cgSetCurDecl cg savedDecl)
                        (cgSetModule cg savedMod)
                        mask
                      }
                    }
                  }
                })
            }
          })
      })
  })

(pub :: callFlowArgs (-> ASTNode Nodes))
(pub fn (callFlowArgs e)
  {
    (let xs vecNew)
    (let mut i 0)
    {
      (while (< i (spineArity e))
        {
          (vecPush xs (spineArgAt e i))
          (set i (+ i 1))
        })
      xs
    }
  })

(pub :: emitPrimFloatBits (-> Nodes CG Int CG))
;@axiom:effect(io)
(pub fn (emitPrimFloatBits args cg flag)
  {
    (let out (emitExpr (vecGet args 0) cg))
    {
      (cgSetResultFloat out flag)
      out
    }
  })

; File a large block after all of its owned children have been released.
;@axiom:effect(io)
(:: emitLargeFile (-> CG CG))
(fn (emitLargeFile cg)
  {
    (emitLine cg "define internal void @__axiom_file_large(i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %base = add i64 %h, -32")
    (emitLine cg "  %basep = inttoptr i64 %base to ptr")
    (emitLine cg "  %cap = load i64, ptr %basep")
    (emitLine cg "  %cla = add i64 %h, -24")
    (emitLine cg "  %clp = inttoptr i64 %cla to ptr")
    (emitLine cg "  %cls = load i64, ptr %clp")
    (if (reserveSupported cg)
      {
        (emitLine cg "  %reserved = icmp eq i64 %cls, -1")
        (emitLine cg "  br i1 %reserved, label %unmap, label %file")
        (emitLine cg "unmap:")
        (emitLine cg "  call void @__axiom_unmap_reserved(i64 %h)")
        (emitLine cg "  ret void")
        (emitLine cg "file:")
      })
    (emitLine cg "  %words = lshr i64 %cap, 3")
    (if (== (allocPoisonOn) 1)
      (emitPoisonFill cg "pl" "%h" "%words"
        (if (reserveSupported cg)
          "file"
          "entry")))
    (emitLine cg "  %slot = getelementptr [4143 x i64], ptr @__axiom_slabs, i64 0, i64 %cls")
    (emitLine cg "  %old = load i64, ptr %slot")
    (emitLine cg "  %enc = sub i64 -2, %old")
    (emitLine cg "  %hdr = add i64 %h, -16")
    (emitLine cg "  %hdrp = inttoptr i64 %hdr to ptr")
    (emitLine cg "  store i64 %enc, ptr %hdrp")
    (emitLine cg "  store i64 %hdr, ptr %slot")
    (emitLine cg "  %filed = load i64, ptr @__axiom_slabs")
    (emitLine cg "  %total = add i64 %cap, 32")
    (emitLine cg "  %filed1 = add i64 %filed, %total")
    (emitLine cg "  store i64 %filed1, ptr @__axiom_slabs")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    cg
  })

; Reservations and resource owners share a creation counter, so the
; existing fourth mark word snapshots both lists. Capped, static and
; threaded heaps keep the ordinary allocator. No primitive or mark ABI changes.
(:: reserveSupported (-> CG Bool))
;@axiom:effect(io)
(fn (reserveSupported cg)
  (&& (== (arenaStaticBytes (cgTarget cg)) 0)
    (&& (== (targetUsesSyscallAsm (cgTarget cg)) 1)
      (&& (! (arenaCapOn cg)) (== (cgThreadsFlag cg) 0)))))

(:: reserveSeqName (-> CG String))
(fn (reserveSeqName cg)
  (if (== (resRegistryOn cg) 1)
    "@__axiom_res_seq"
    "@__axiom_reserve_seq"))

(:: reserveMapFlags (-> Int Int))
(fn (reserveMapFlags t)
  (if (|| (== t 2) (== t 3))
    (+ (targetMapFlags t) 16384)
    (targetMapFlags t)))

; A reservation has eight prefix words: mapping bytes, next, sequence,
; spare, payload capacity, class -1, count, shape. The payload is aligned
; to 16 bytes. Only its payload and prefix count towards held bytes.
(:: emitReserveBlock (-> CG CG))
(fn (emitReserveBlock cg)
  {
    (emitLine cg "reserve:")
    (emitLine cg "  %rmul = shl i64 %sz0, 3")
    (emitLine cg "  %rsmall = icmp ult i64 %rmul, 67108864")
    (emitLine cg "  %rsz = select i1 %rsmall, i64 67108864, i64 %rmul")
    (emitLine cg (concat "  %rseq = load i64, ptr " (reserveSeqName cg)))
    (emitLine cg "  %rwrapped = icmp uge i64 %rseq, 9223372036854775807")
    (emitLine cg "  br i1 %rwrapped, label %try_pop, label %rmap")
    (emitLine cg "rmap:")
    (emitLine cg
      (concat "  %raddr = "
        (parSys cg (fmtInt (targetMmapNum (cgTarget cg)))
          (concat "i64 0, i64 %rsz, i64 3, i64 "
            (concat (fmtInt (reserveMapFlags (cgTarget cg))) ", i64 -1, i64 0")))))
    (emitLine cg "  %rfl = icmp ult i64 %raddr, 4096")
    (emitLine cg "  %rfn = icmp ugt i64 %raddr, -4096")
    (emitLine cg "  %rfail = or i1 %rfl, %rfn")
    (emitLine cg "  br i1 %rfail, label %try_pop, label %rmapped")
    (emitLine cg "rmapped:")
    (emitLine cg "  %rbp = inttoptr i64 %raddr to ptr")
    (emitLine cg "  store i64 %rsz, ptr %rbp")
    (emitLine cg "  %rlp = getelementptr i64, ptr %rbp, i64 1")
    (emitLine cg "  %rhead = load i64, ptr @__axiom_reserved")
    (emitLine cg "  store i64 %rhead, ptr %rlp")
    (emitLine cg "  %rsp = getelementptr i64, ptr %rbp, i64 2")
    (emitLine cg "  %rsnext = add i64 %rseq, 1")
    (emitLine cg "  store i64 %rsnext, ptr %rsp")
    (emitLine cg (concat "  store i64 %rsnext, ptr " (reserveSeqName cg)))
    (emitLine cg "  %rcp = getelementptr i64, ptr %rbp, i64 4")
    (emitLine cg "  store i64 %sz0, ptr %rcp")
    (emitLine cg "  %rclp = getelementptr i64, ptr %rbp, i64 5")
    (emitLine cg "  store i64 -1, ptr %rclp")
    (emitLine cg "  %rshp = getelementptr i64, ptr %rbp, i64 7")
    (emitLine cg "  store i64 2, ptr %rshp")
    (emitLine cg "  store i64 %raddr, ptr @__axiom_reserved")
    (emitLine cg "  %ruser = add i64 %raddr, 64")
    (emitLine cg "  ret i64 %ruser")
    cg
  })

; Unlink by node identity, never by a mark's saved list head. Releasing
; a node between a mark and reset cannot invalidate the mark.
(:: emitReservedRuntime (-> CG CG))
(fn (emitReservedRuntime cg)
  {
    (emitLine cg "define internal void @__axiom_unmap_reserved(i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %base = add i64 %h, -64")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg "  %link = phi ptr [ @__axiom_reserved, %entry ], [ %nextp, %advance ]")
    (emitLine cg "  %node = load i64, ptr %link")
    (emitLine cg "  %done = icmp eq i64 %node, 0")
    (emitLine cg "  br i1 %done, label %exit, label %test")
    (emitLine cg "test:")
    (emitLine cg "  %np = inttoptr i64 %node to ptr")
    (emitLine cg "  %nextp = getelementptr i64, ptr %np, i64 1")
    (emitLine cg "  %same = icmp eq i64 %node, %base")
    (emitLine cg "  br i1 %same, label %unmap, label %advance")
    (emitLine cg "advance:")
    (emitLine cg "  br label %scan")
    (emitLine cg "unmap:")
    (emitLine cg "  %next = load i64, ptr %nextp")
    (emitLine cg "  store i64 %next, ptr %link")
    (emitLine cg "  %size = load i64, ptr %np")
    (emitStackSys cg "%unmapped" (targetMunmapNum (cgTarget cg))
      "i64 %node, i64 %size, i64 0, i64 0, i64 0, i64 0")
    (emitLine cg "  br label %exit")
    (emitLine cg "exit:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_reserved_source(i64 %src, i64 %bytes) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %head = load i64, ptr @__axiom_reserved")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg "  %node = phi i64 [ %head, %entry ], [ %next, %advance ]")
    (emitLine cg "  %done = icmp eq i64 %node, 0")
    (emitLine cg "  br i1 %done, label %absent, label %test")
    (emitLine cg "test:")
    (emitLine cg "  %np = inttoptr i64 %node to ptr")
    (emitLine cg "  %cp = getelementptr i64, ptr %np, i64 4")
    (emitLine cg "  %cap = load i64, ptr %cp")
    (emitLine cg "  %data = add i64 %node, 64")
    (emitLine cg "  %offset = sub i64 %src, %data")
    (emitLine cg "  %within = icmp ult i64 %offset, %cap")
    (emitLine cg "  %remaining = sub i64 %cap, %offset")
    (emitLine cg "  %fits = icmp ule i64 %bytes, %remaining")
    (emitLine cg "  %found = and i1 %within, %fits")
    (emitLine cg "  br i1 %found, label %hit, label %advance")
    (emitLine cg "advance:")
    (emitLine cg "  %nextp = getelementptr i64, ptr %np, i64 1")
    (emitLine cg "  %next = load i64, ptr %nextp")
    (emitLine cg "  br label %scan")
    (emitLine cg "hit:")
    (emitLine cg "  ret i64 %node")
    (emitLine cg "absent:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    ; Cleanup callbacks may release an owned source before the reset
    ; finishes. Snapshot its bytes first; the unowned copy cannot be
    ; released by those callbacks and needs no recovery-time pin.
    (emitLine cg
      "define internal i64 @__axiom_reserved_snapshot(i64 %src, i64 %bytes, i64 %floor) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %base = call i64 @__axiom_reserved_source(i64 %src, i64 %bytes)")
    (emitLine cg "  %found = icmp ne i64 %base, 0")
    (emitLine cg "  br i1 %found, label %owned, label %unchanged")
    (emitLine cg "owned:")
    (emitLine cg "  %bp = inttoptr i64 %base to ptr")
    (emitLine cg "  %cp = getelementptr i64, ptr %bp, i64 6")
    (emitLine cg "  %count = load i64, ptr %cp")
    (emitLine cg "  %live = icmp sgt i64 %count, 0")
    (if (== (resRegistryOn cg) 1)
      {
        ; A callback can adopt and release even a count-zero source.
        ; The newest owner's sequence bounds every possible callback.
        (emitLine cg "  %rhead = load i64, ptr @__axiom_res_head")
        (emitLine cg "  %rnone = icmp eq i64 %rhead, 0")
        (emitLine cg "  br i1 %rnone, label %counted, label %resource")
        (emitLine cg "resource:")
        (emitLine cg "  %rp = inttoptr i64 %rhead to ptr")
        (emitLine cg "  %rseqp = getelementptr i64, ptr %rp, i64 6")
        (emitLine cg "  %rseq = load i64, ptr %rseqp")
        (emitLine cg "  %cleanup = icmp sgt i64 %rseq, %floor")
        (emitLine cg "  br i1 %cleanup, label %allocate, label %counted")
        (emitLine cg "counted:")
      })
    (emitLine cg "  br i1 %live, label %allocate, label %unchanged")
    (emitLine cg "allocate:")
    (emitLine cg "  %copy = call i64 @axiom_alloc(i64 %bytes)")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ 0, %allocate ], [ %next, %body ]")
    (emitLine cg "  %more = icmp ult i64 %i, %bytes")
    (emitLine cg "  br i1 %more, label %body, label %done")
    (emitLine cg "body:")
    (emitLine cg "  %sa = add i64 %src, %i")
    (emitLine cg "  %sp = inttoptr i64 %sa to ptr")
    (emitLine cg "  %byte = load i8, ptr %sp")
    (emitLine cg "  %da = add i64 %copy, %i")
    (emitLine cg "  %dp = inttoptr i64 %da to ptr")
    (emitLine cg "  store i8 %byte, ptr %dp")
    (emitLine cg "  %next = add i64 %i, 1")
    (emitLine cg "  br label %loop")
    (emitLine cg "done:")
    (emitLine cg "  ret i64 %copy")
    (emitLine cg "unchanged:")
    (emitLine cg "  ret i64 %src")
    (emitLine cg "}")
    (emitLine cg "define internal void @__axiom_reserved_reset(i64 %floor, i64 %keep) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg
      "  %link = phi ptr [ @__axiom_reserved, %entry ], [ %nextp, %advance ], [ %link, %unmap ]")
    (emitLine cg "  %node = load i64, ptr %link")
    (emitLine cg "  %done = icmp eq i64 %node, 0")
    (emitLine cg "  br i1 %done, label %exit, label %test")
    (emitLine cg "test:")
    (emitLine cg "  %np = inttoptr i64 %node to ptr")
    (emitLine cg "  %nextp = getelementptr i64, ptr %np, i64 1")
    (emitLine cg "  %seqp = getelementptr i64, ptr %np, i64 2")
    (emitLine cg "  %seq = load i64, ptr %seqp")
    (emitLine cg "  %new = icmp ugt i64 %seq, %floor")
    (emitLine cg "  %preserved = icmp eq i64 %node, %keep")
    (emitLine cg "  %discard = xor i1 %preserved, true")
    (emitLine cg "  %reclaim = and i1 %new, %discard")
    (emitLine cg "  br i1 %reclaim, label %unmap, label %advance")
    (emitLine cg "advance:")
    (emitLine cg "  br label %scan")
    (emitLine cg "unmap:")
    (emitLine cg "  %next = load i64, ptr %nextp")
    (emitLine cg "  store i64 %next, ptr %link")
    (emitLine cg "  %size = load i64, ptr %np")
    (emitLine cg "  %extent = add i64 %node, %size")
    (emitEvCall cg "%node" "%extent")
    (emitStackSys cg "%unmapped" (targetMunmapNum (cgTarget cg))
      "i64 %node, i64 %size, i64 0, i64 0, i64 0, i64 0")
    (emitLine cg "  br label %scan")
    (emitLine cg "exit:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_reserved_bytes() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %head = load i64, ptr @__axiom_reserved")
    (emitLine cg "  br label %scan")
    (emitLine cg "scan:")
    (emitLine cg "  %node = phi i64 [ %head, %entry ], [ %next, %body ]")
    (emitLine cg "  %sum = phi i64 [ 0, %entry ], [ %total, %body ]")
    (emitLine cg "  %done = icmp eq i64 %node, 0")
    (emitLine cg "  br i1 %done, label %exit, label %body")
    (emitLine cg "body:")
    (emitLine cg "  %np = inttoptr i64 %node to ptr")
    (emitLine cg "  %cp = getelementptr i64, ptr %np, i64 4")
    (emitLine cg "  %cap = load i64, ptr %cp")
    (emitLine cg "  %charged = add i64 %cap, 64")
    (emitLine cg "  %total = add i64 %sum, %charged")
    (emitLine cg "  %nextp = getelementptr i64, ptr %np, i64 1")
    (emitLine cg "  %next = load i64, ptr %nextp")
    (emitLine cg "  br label %scan")
    (emitLine cg "exit:")
    (emitLine cg "  ret i64 %sum")
    (emitLine cg "}")
    cg
  })

; The kernel's ucontext layouts: Darwin points at mcontext (offset 48),
; Linux embeds it, and FreeBSD puts it after its 16-byte signal mask.
; Offsets name the saved frame pointer and instruction pointer.
(:: stackContextOffset (-> Int Bool Int))
(fn (stackContextOffset t pc)
  (if (|| (== t 0) (== t 1))
    (if (targetIsAArch64 t)
      (if pc
        272
        248)
      (if pc
        144
        64))
    (if (== t 2)
      (if pc
        440
        416)
      (if (== t 3)
        (if pc
          168
          120)
        (if (targetIsAArch64 t)
          (if pc
            272
            248)
          (if pc
            176
            88))))))

(:: emitStackFaultTrace (-> CG Int CG))
(fn (emitStackFaultTrace cg t)
  {
    (emitLine cg "  %uc = inttoptr i64 %uap to ptr")
    (if (|| (== t 0) (== t 1))
      {
        (emitLine cg "  %mca = getelementptr i8, ptr %uc, i64 48")
        (emitLine cg "  %mc = load ptr, ptr %mca")
      }
      (emitLine cg "  %mc = getelementptr i8, ptr %uc, i64 0"))
    (emitLine cg
      (concat "  %fpa = getelementptr i8, ptr %mc, i64 " (fmtInt (stackContextOffset t false))))
    (emitLine cg
      (concat "  %pca = getelementptr i8, ptr %mc, i64 " (fmtInt (stackContextOffset t true))))
    (emitLine cg "  %fp = load i64, ptr %fpa")
    (emitLine cg "  %pc = load i64, ptr %pca")
    (emitLine cg "  %ra = add i64 %pc, 1")
    (emitLine cg "  %top = load i64, ptr @__axiom_stack_top")
    (emitLine cg "  call void @__axiom_backtrace_from(i64 %fp, i64 %hi, i64 %top, i64 %ra)")
    cg
  })

(:: targetGetrlimitNum (-> Int Int))
(fn (targetGetrlimitNum t)
  (if (|| (== t 0) (== t 1))
    33554626
    (if (== t 2)
      163
      (if (== t 3)
        97
        194))))

; Preserve the process's finite RLIMIT_STACK as the entry budget.
; An unlimited or unavailable limit selects the runtime's 8 MiB default.
; The entry uses a direct code pointer and borrows no heap share.
(:: emitProgramStack (-> CG CG))
(fn (emitProgramStack cg)
  {
    (emitLine cg "define internal i64 @__axiom_program_main(i64 %self, i64 %arg) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %r = call i64 @__axiom_user_main()")
    (emitLine cg "  ret i64 %r")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_program_stack_bytes() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %limits = alloca [2 x i64], align 16")
    (emitLine cg "  store i64 8388608, ptr %limits")
    (emitLine cg "  %limitaddr = ptrtoint ptr %limits to i64")
    (emitStackSys cg "%rl" (targetGetrlimitNum (cgTarget cg))
      "i64 3, i64 %limitaddr, i64 0, i64 0, i64 0, i64 0")
    (emitLine cg "  %soft = load i64, ptr %limits")
    (emitLine cg "  %rlok = icmp eq i64 %rl, 0")
    (emitLine cg "  %finite = icmp ule i64 %soft, 70368744177664")
    (emitLine cg "  %valid = and i1 %rlok, %finite")
    (emitLine cg "  %budget = select i1 %valid, i64 %soft, i64 8388608")
    (emitLine cg "  ret i64 %budget")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_program_run() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %budget = call i64 @__axiom_program_stack_bytes()")
    (emitLine cg "  %code = ptrtoint ptr @__axiom_program_main to i64")
    (emitLine cg "  %r = call i64 @__axiom_stack_run_code(i64 %budget, i64 %code, i64 0, i64 0)")
    (emitLine cg "  ret i64 %r")
    (emitLine cg "}")
    cg
  })

; An exiting pthread gives its alternate signal stack back after its
; user code and allocator cleanup have returned to the host's stack.
(:: emitStackDisarm (-> CG Int CG))
(fn (emitStackDisarm cg t)
  {
    (emitLine cg "define internal void @__axiom_stack_disarm() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %alt = load i64, ptr @__axiom_stack_alt")
    (emitLine cg "  %have = icmp ne i64 %alt, 0")
    (emitLine cg "  br i1 %have, label %disable, label %done")
    (emitLine cg "disable:")
    (emitLine cg "  %ss = alloca [3 x i64], align 8")
    (emitLine cg "  store i64 0, ptr %ss")
    (emitLine cg "  %s1 = getelementptr i64, ptr %ss, i64 1")
    (emitLine cg "  %s2 = getelementptr i64, ptr %ss, i64 2")
    (emitLine cg
      (concat "  store i64 "
        (concat
          (if (|| (== t 2) (== t 3))
            "2"
            "0")
          ", ptr %s1")))
    (emitLine cg
      (concat "  store i64 "
        (concat
          (if (|| (== t 2) (== t 3))
            "0"
            "4")
          ", ptr %s2")))
    (emitLine cg "  %ssw = ptrtoint ptr %ss to i64")
    (emitStackSys cg "%off" (targetSigAltStackNum t) "i64 %ssw, i64 0, i64 0, i64 0, i64 0, i64 0")
    (emitLine cg "  %ok = icmp eq i64 %off, 0")
    (emitLine cg "  br i1 %ok, label %unmap, label %done")
    (emitLine cg "unmap:")
    (emitLine cg "  store i64 0, ptr @__axiom_stack_alt")
    (emitStackSys cg "%unmapped" (targetMunmapNum t)
      "i64 %alt, i64 65536, i64 0, i64 0, i64 0, i64 0")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    cg
  })
