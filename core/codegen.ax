; Fresh word 5 and word 45 accumulators for a nested call. Both are
; published before the displaced vectors' shares are given back, so a
; reader that took a share of its own keeps a live vector.
(:: cgResetAppArgs (-> CG CG))
(fn (cgResetAppArgs cg)
  {
    (let c cg)
    (set c.argVec nodesNew)
    (set c.argEv vecNew)
    cg
  })

; The LLVM parameter count is zero for lifted lambdas and thunks, whose
; environment prototypes cannot match a plain function's musttail ABI.
; Typed pair and auxiliary state. Reference fields own their payloads;
; absent checked types, callback identities and float indexes use Option.
(pub struct PairState
  (mut returnTy : (Option ASTNode))
  (mut arm : Int)
  (mut names : Names)
  (mut tagReg : String)
  (mut threads : Int)
  (mut parallelUsed : Int)
  (mut llvmParams : Int)
  (mut liftedLambda : Int)
  (mut regionDepth : Int)
  (mut threadLowering : Int)
  (mutMemo : (Vec MutMemoEntry))
  (mut mutMemoDepth : Int)
  (mut handleRuntime : Int)
  (mut lambdaArrow : (Option ASTNode))
  (mut identities : (Option Names))
  (mut obfuscate : Int)
  (owningSlots : (Vec PendingSlot))
  (countedStores : Nodes)
  (mut registry : Int)
  (mut asmCookie : Int)
  (sourceFiles : Strings)
  (mut arenaCap : Int)
  (mut stackRun : Int)
  (mut nativeExe : Int)
  (mut functionFloats : (Option FunctionFloatIndex)))

(:: cgPairArm (-> CG Int))
(fn (cgPairArm cg)
  cg.pairState.arm)

