; A poller retains the marker's String storage. File owner-drop retires
; the cell before closing its HANDLE, so a stale registration can never
; become a different file after Windows reuses the numeric HANDLE.
; The cell is one naturally aligned payload word, initialised to 1
; before it is published. These helpers retain no pointer or Axiom share.
(pub :: emitWinPollerLifetimeRuntime (-> CG CG))
(pub fn (emitWinPollerLifetimeRuntime cg)
  {
    (emitLine cg "define internal i64 @__axiom_win_poller_alive(i64 %addr) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %cell = inttoptr i64 %addr to ptr")
    (emitLine cg "  %alive = load atomic i64, ptr %cell acquire, align 8")
    (emitLine cg "  ret i64 %alive")
    (emitLine cg "}")
    (emitLine cg "define internal i64 @__axiom_win_poller_retire(i64 %addr) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %cell = inttoptr i64 %addr to ptr")
    (emitLine cg "  store atomic i64 0, ptr %cell release, align 8")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    cg
  })

