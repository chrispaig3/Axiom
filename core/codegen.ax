(:: cgNullVec (Vec a))
;@axiom:effect(unsafe)
(fn (cgNullVec)
  (as 0 (Vec a)))

(:: truncatePendingSlots (-> (Vec PendingSlot) Int Int))
(fn (truncatePendingSlots slots size)
  {
    (while (> (vecLen slots) size)
      {
        (let retired (vecPop slots))
        0
      })
    0
  })

(:: truncateNodeRegistry (-> Nodes Int Int))
(fn (truncateNodeRegistry nodes size)
  {
    (while (> (vecLen nodes) size)
      {
        (let retired (vecPop nodes))
        0
      })
    0
  })

(pub :: zeroFloat (-> CG CG))
(pub fn (zeroFloat cg)
  {
    (cgSetResultFloat cg 0)
    cg
  })

; ------------------------------------------------------------------
; Per-function float signatures, keyed by the (mangled) defined name.
; `flags` is one 0/1 per arrow position, return type last - the shape
; `sigFloatFlags` in the parser produces.
; ------------------------------------------------------------------
; `sigTy` is the D_SIG's parsed type tree (node word 6) - the SAME
; object the checker walked, which is what keeps MM-LIFE-2d's
; evidence ordering agreed between the phases without a protocol.
; `owned` is MM-LIFE-2c's ownership of the function's RESULT, inferred
; by `inferOwnership` below: 1 when every value the body can answer
; carries a share of its own (a construction, a static, an allocation,
; the result of another owned-result function), 0 when some path
; answers a share the frame only borrowed (a parameter, a field, a
; match binder, a raw load). Event 2 retains the result of a
; reference-returning function exactly when this is 0.
(pub struct FSig
  (name : String)
  (nameLen : Int)
  (flags : (Option Ints))
  (sigTy : (Option ASTNode))
  (takesEv : Int)
  (mut owned : Int)
  (mut arity : (Option Int))
  (mut stash : Int)
  (mut ret : Int)
  (mut consume : Int)
  (mut transfer : Int)
  (mut callers : Int)
  (mut writes : Int))

; A signature remains typed throughout its registries. The reads are field loads,
; so every later store is a field store too: a raw word store is not
; one, and the load would keep answering the value from construction.
(:: fsigName (-> FSig String))
(fn (fsigName e)
  e.name)

(:: fsigNameLen (-> FSig Int))
(fn (fsigNameLen e)
  e.nameLen)

(:: fsigFlags (-> FSig (Option Ints)))
(fn (fsigFlags e)
  e.flags)

(:: fsigTy (-> FSig (Option ASTNode)))
(fn (fsigTy e)
  e.sigTy)

(:: cgTypeNodeOpt (-> ASTNode (Option ASTNode)))
(fn (cgTypeNodeOpt ty)
  (if (nodeSame ty nilNode)
    None
    (Some ty)))

(:: signatureParamTy (-> (Option ASTNode) Int (Option ASTNode)))
(fn (signatureParamTy signature i)
  (match signature
    ((None) None)
    ((Some ty) (arrowParamTy ty i))))

(:: fsigTakesEv (-> FSig Int))
(fn (fsigTakesEv e)
  e.takesEv)

(:: fsigOwned (-> FSig Int))
(fn (fsigOwned e)
  e.owned)

(:: fsigSetOwned (-> FSig Int FSig))
(fn (fsigSetOwned e v)
  {
    (let s e)
    (set s.owned v)
    e
  })

(:: fsigArity (-> FSig (Option Int)))
(fn (fsigArity e)
  e.arity)

(:: fsigSetArity (-> FSig (Option Int) FSig))
(fn (fsigSetArity e v)
  {
    (let s e)
    (set s.arity v)
    e
  })

(:: fsigStash (-> FSig Int))
(fn (fsigStash e)
  e.stash)

(:: fsigSetStash (-> FSig Int FSig))
(fn (fsigSetStash e v)
  {
    (let s e)
    (set s.stash v)
    e
  })

(:: fsigRet (-> FSig Int))
(fn (fsigRet e)
  e.ret)

(:: fsigSetRet (-> FSig Int FSig))
(fn (fsigSetRet e v)
  {
    (let s e)
    (set s.ret v)
    e
  })

(:: fsigConsume (-> FSig Int))
(fn (fsigConsume e)
  e.consume)

(:: fsigSetConsume (-> FSig Int FSig))
(fn (fsigSetConsume e v)
  {
    (let s e)
    (set s.consume v)
    e
  })

(:: fsigTransferOf (-> FSig Int))
(fn (fsigTransferOf e)
  e.transfer)

(:: fsigSetTransfer (-> FSig Int FSig))
(fn (fsigSetTransfer e v)
  {
    (let s e)
    (set s.transfer v)
    e
  })

(:: fsigCallers (-> FSig Int))
(fn (fsigCallers e)
  e.callers)

(:: fsigSetCallers (-> FSig Int FSig))
(fn (fsigSetCallers e v)
  {
    (let s e)
    (set s.callers v)
    e
  })

(:: fsigWrites (-> FSig Int))
(fn (fsigWrites e)
  e.writes)

(:: fsigSetWrites (-> FSig Int FSig))
(fn (fsigSetWrites e v)
  {
    (let s e)
    (set s.writes v)
    e
  })

; Word 10 of an FSig: 1 when the declaration carries
; `;@axiom:result(owned)` (MM-LIFE-2n), so a call's type-variable
; result is OWNED by the caller rather than lent. Read from the tags
; `attachAxtags` left on either half of the declaration; a signature
; built here before its `fn` is seen is marked when the `fn` arrives.
(pub :: fsigTransfer (-> CG String Int))
(pub fn (fsigTransfer cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigTransferOf e)
      0)
  })

; Word 11 of an FSig: how many distinct declarations the caller
; index (`callersIdxBuildCg`) found naming this function at a call
; head or a tail reference. Written once when the index is built
; for the worklists below; 0 until then, and 0 for a signature the
; index never resolved to. `cgMarkCallers` reads it as the fast
; answer to "nobody calls this" before it touches the index rows.
; Mark every FSig whose `::` or `fn` carries `result(owned)`.
(pub :: markTransferSigs (-> (Vec ASTNode) (Vec FSig) Int Int))
(pub fn (markTransferSigs decls sigs i)
  (if (>= i (vecLen decls))
    0
    {
      (let d (vecGet decls i))
      {
        (if (|| (== (nodeTag d) TAG_D_SIG) (== (nodeTag d) TAG_D_FN))
          (if (== (declHasAxtag d "result(owned)") 1)
            {
              (let eFound (findFSig sigs (nodeAName d)))
              (if (let (Some e) eFound)
                (fsigSetTransfer e 1))
            }))
        (markTransferSigs decls sigs (+ i 1))
      }
    }))

(pub :: scanFloatSigs (-> (Vec ASTNode) (Vec FSig) Int (Vec FSig)))
(pub fn (scanFloatSigs decls sigs i)
  (if (>= i (vecLen decls))
    sigs
    {
      {
        (let d (vecGet decls i))
        (if (== (nodeTag d) TAG_D_SIG)
          (vecPush sigs
            (FSig
              :name (nodeAName d)
              :nameLen (strLen (nodeAName d))
              :flags (Some (nodeBWords d))
              :sigTy (cgTypeNodeOpt (nodeTyChild d))
              :takesEv (cgTakesEvidence (nodeTyChild d))
              :owned 1
              :arity None
              :stash 0
              :ret 0
              :consume 0
              :transfer 0
              :callers 0
              :writes 0))
          ; an `extern` item is a signed global under its LINKER
          ; SYMBOL (what `mangledForCg` answers for its name), with
          ; the masks the boundary contract gives it: a Rust shim
          ; BORROWS every argument for the call (docs/ffi.md, C1 -
          ; a shim that keeps one takes its own share with
          ; `axiom_retain`) and answers a fresh word or a share of
          ; its own, so it parks nothing and answers nothing of
          ; what it was handed. Without an entry every extern
          ; call parked every argument, and a `Counter` cell
          ; handed to `counterValueRaw` never died
          (if (== (nodeTag d) TAG_D_EXTERN)
            (scanExternSigs (nodeCChildren d) sigs 0)))
      }
      (scanFloatSigs decls sigs (+ i 1))
    }))

(pub :: scanExternSigs (-> (Vec ASTNode) (Vec FSig) Int Int))
(pub fn (scanExternSigs items sigs i)
  (if (== (as items Int) 0)
    0
    (if (>= i (vecLen items))
      0
      {
        (let f (vecGet items i))
        {
          (if (! (== (nodeB f) 0))
            (vecPush sigs
              (FSig
                :name (nodeCName f)
                :nameLen (strLen (nodeCName f))
                :flags None
                :sigTy (Some (nodeBChild f))
                :takesEv 0
                :owned 1
                :arity (Some (arrowArity (nodeBChild f)))
                :stash 0
                :ret 0
                :consume 0
                :transfer 0
                :callers 0
                :writes 1)))
          (scanExternSigs items sigs (+ i 1))
        }
      })))

(pub :: findFSig (-> (Vec FSig) String (Option FSig)))
(pub fn (findFSig sigs name)
  {
    (let n (declSpellingOf name))
    (findFSigIn sigs n (strLen n) 0)
  })

(pub :: findFSigIn (-> (Vec FSig) String Int Int (Option FSig)))
(pub fn (findFSigIn sigs name nl i)
  (if (>= i (vecLen sigs))
    (None)
    {
      (let e (vecGet sigs i))
      (if (&& (== (fsigNameLen e) nl) (strEq (fsigName e) name))
        (Some e)
        (findFSigIn sigs name nl (+ i 1)))
    }))

; The signature table, the mangle map and the DECLARATION LIST,
; indexed. `findFSig` and `mangledFor` are linear scans - 1,700
; signatures, 1,600 bares - and were asked a few times per function;
; the ownership questions below ask them at every call site, several
; times, and a self-compile went from 2.8 s to 5.0 s on the scans
; alone. Built once in `emitResolved`, after every `mangleRecord` has
; run and immediately after field 8 is set, which is the only write
; either input ever takes.
;
; THE DECLARATION HALF, added because the mangle half was not the only
; scan at a call site. `emitVar` asks `isNullaryFn` for every variable
; reference it emits and `isDefinedFn` for every one that is not
; nullary; `emitOverApplied` asks `isDefinedFn` and then `fnArityOf`
; for every call. All three walk the WHOLE merged declaration list -
; 4,600 declarations when the compiler compiles itself - so emission
; was quadratic in the program's size, and measurably so.
;
; The three answers share one Intern because they share one key, and
; they are three parallel Vecs rather than three packed bitfields
; because the packing would buy nothing a `vecGet` does not already
; give. A typed DeclIndex owns the five parts without consuming another
; CG payload word: first maps bare intern ids to mangle rows, names owns
; declaration spellings, nullary and defined hold their 0/1 answers, and
; arity holds the first D_FN's parameter count or -1 for extern-only ids.
;
; The two booleans are order-independent - each scan returns true at
; its first match and false at the end, so it is asking "does one
; exist" and the order it asks in cannot change the answer. `fnArityIn`
; is NOT: it answers the first `D_FN` it reaches, whatever that one's
; arity, so the index is built in declaration order and only the first
; writer of a name touches [4].
(pub :: buildNameIndexes (-> CG CG))
(pub fn (buildNameIndexes cg)
  {
    (let sigs (cgFloatSigs cg))
    (let si internNewTyped)
    (let byId vecNew)
    (let bares (cgMangleBares cg))
    (let bi internNewTyped)
    (let first vecNew)
    (let decls (cgDecls cg))
    (let dn internNewTyped)
    (let dnull vecNew)
    (let ddef vecNew)
    (let dar vecNew)
    {
      {
        (let mut i 0)
        (while (< i (vecLen sigs))
          {
            {
              (let e (vecGet sigs i))
              {
                (let id (internIntern (internWordOf si) (fsigName e)))
                (if (== id (vecLen byId))
                  {
                    (vecPush byId e)
                    0
                  }
                  0)
              }
            }
            (set i (+ i 1))
          })
      }
      {
        (let mut j 0)
        (while (< j (vecLen bares))
          {
            {
              (let id (internIntern (internWordOf bi) (vecGetStr bares j)))
              (if (== id (vecLen first))
                {
                  (vecPush first j)
                  0
                }
                0)
            }
            (set j (+ j 1))
          })
      }
      ; In declaration order, because [4] is first-writer-wins. A `CG`
      ; whose field 8 is still 0 - nothing but this function reads the
      ; declaration list through the index - leaves the three Vecs
      ; empty and every reader below falls back to the scan.
      (if (! (== (as decls Int) 0))
        {
          (let mut k 0)
          (while (< k (vecLen decls))
            {
              (declIndexAdd dn dnull ddef dar (vecGet decls k))
              (set k (+ k 1))
            })
        })
      (cgSetNameIndexes cg si byId bi
        (DeclIndex :first first :names dn :nullary dnull :defined ddef :arity dar))
      ; AFTER the four above, because `pairFnOK` reads the signature
      ; through them. Names, not nodes: a match site has a name.
      ;
      ; A FIXPOINT, not one pass, since a forwarding leaf
      ; (`pairFwdOK`) makes one function's eligibility depend on
      ; another's: `utf8CharAt` is eligible only once `utf8DecodeAt`
      ; is, and the declaration order must not decide that. The set
      ; is installed in slot 2 BEFORE the scan so the walk reads it as
      ; it grows, and the scan repeats until a pass adds nothing. A
      ; handful of functions per program, so the cost is nothing.
      ;
      ; Field 34 is set to each declaration's module for its test,
      ; because `pairFwdOK` resolves a callee through `mangledForCg`,
      ; which answers the module-local spelling first - asked with no
      ; module it would answer the first bare record of that name,
      ; which for `utf8DecodeAt` is the right one and for a name two
      ; modules declare is not.
      {
        (let pn vecNew)
        (let savedMod (cgModule cg))
        {
          (cgSetPairNames cg pn)
          (if (! (== (as decls Int) 0))
            {
              (let mut grew 1)
              (while (== grew 1)
                {
                  (set grew 0)
                  {
                    (let mut m 0)
                    (while (< m (vecLen decls))
                      {
                        {
                          (let d (vecGet decls m))
                          (if (== (nodeTag d) TAG_D_FN)
                            (if (== (pairNamesHas pn (nodeAName d)) 0)
                              {
                                (cgSetDeclModule cg d)
                                (if (== (pairFnOK cg d) 1)
                                  {
                                    (vecPush pn (nodeAName d))
                                    (set grew 1)
                                  })
                              }))
                        }
                        (set m (+ m 1))
                      })
                  }
                })
            })
          (cgSetModule cg savedMod)
        }
      }
      cg
    }
  })

; The row for `name`, created on first sight. Intern ids are dense, so
; an id equal to the current length is a name never seen before and
; every parallel Vec gains exactly one entry; anything else already
; has its row. -1 in `dar` is "no `D_FN` has claimed this name", which
; is what makes [4] first-writer-wins without a fourth Vec to say so.
(:: declSlotFor (-> InternState Ints Ints Ints String Int))
;@axiom:effect(unsafe)
(fn (declSlotFor dn dnull ddef dar name)
  {
    (let id (internIntern (internWordOf dn) name))
    {
      (if (== id (vecLen dnull))
        {
          (vecPush dnull 0)
          (vecPush ddef 0)
          (vecPush dar (- 0 1))
        }
        (as 0 (Vec Int)))
      id
    }
  })

; One declaration's contribution to the three answers, in the shape
; `isNullaryFnIn`, `isDefinedFnIn` and `fnArityIn` read it: a `D_FN`
; is nullary or defined by its parameter count and never both, and an
; `extern` block contributes only to nullary.
(:: declIndexAdd (-> InternState Ints Ints Ints ASTNode Int))
(fn (declIndexAdd dn dnull ddef dar d)
  {
    (let tag (nodeTag d))
    (if (== tag TAG_D_FN)
      {
        (let id (declSlotFor dn dnull ddef dar (nodeAName d)))
        (let ar (vecLen (nodeBNames d)))
        {
          (if (== ar 0)
            (vecSet dnull id 1)
            (vecSet ddef id 1))
          (if (< (vecGet dar id) 0)
            {
              (vecSet dar id ar)
              0
            }
            0)
        }
      }
      (if (== tag TAG_D_EXTERN)
        (declIndexExtern dn dnull ddef dar (nodeCChildren d) 0)
        0))
  })

; A ZERO-ARITY `extern` item is a nullary function, and it answers to
; EITHER spelling - `externHasNullary` matches the Axiom name in slot
; a or the linker symbol in slot c, because a lookup arriving from
; `emitVar` has already been through `mangledFor` and is holding the
; symbol. Both are interned, and `internIntern` folds them together
; when an item's two spellings agree.
(:: declIndexExtern (-> InternState Ints Ints Ints (Vec ASTNode) Int Int))
;@axiom:effect(unsafe)
(fn (declIndexExtern dn dnull ddef dar items i)
  (if (== (as items Int) 0)
    0
    (if (>= i (vecLen items))
      0
      {
        {
          (let f (vecGet items i))
          (if (== (arrowArity (nodeBChild f)) 0)
            {
              (vecSet dnull (declSlotFor dn dnull ddef dar (nodeAName f)) 1)
              (vecSet dnull (declSlotFor dn dnull ddef dar (nodeCName f)) 1)
            }
            (as 0 (Vec Int)))
        }
        (declIndexExtern dn dnull ddef dar items (+ i 1))
      })))

; `findFSig` through the index; the linear scan when no index has
; been built (the REPL's and LSP's partial paths).
(pub :: findFSigCg (-> CG String (Option FSig)))
(pub fn (findFSigCg cg name)
  (if (let (Some si) (cgSigIntern cg))
    (if (let (Some id) (internFind (internWordOf si) (declSpellingOf name)))
      (Some (vecGet (cgSigById cg) id))
      (None))
    (findFSig (cgFloatSigs cg) name)))

(:: hasFSigCg (-> CG String Bool))
(fn (hasFSigCg cg name)
  (if (let (Some _) (findFSigCg cg name))
    true
    false))

(:: cgSigIndexBuilt (-> CG Bool))
(fn (cgSigIndexBuilt cg)
  (if (let (Some _) (cgSigIntern cg))
    true
    false))

; `mangledFor` through the index: the same answer, the module-local
; spelling first, then the first bare record, then the name itself.
(pub :: mangledForCg (-> CG String String))
(pub fn (mangledForCg cg name)
  (if (let (Some bi) (cgBareIntern cg))
    (if (let (Some index) (cgDeclIndex cg))
      (if (strEq name "main")
        "__axiom_user_main"
        {
          (let module (cgModule cg))
          (let hit
            (if (let (Some nameOfModule) module)
              (internFind (internWordOf bi) (concat nameOfModule (concat "$" name)))
              (None)))
          (if (let (Some id) hit)
            (vecGetStr (cgMangleFulls cg) (vecGet index.first id))
            (mangledForModCg cg bi index name module))
        })
      (mangledFor cg name))
    (mangledFor cg name)))

; The same, for a reference made inside module `m` (0 in the entry
; file). A module can't import the entry file, so when the bare slot
; answers the name unchanged, which is how the entry file holds it,
; the module view `$name` answers instead if a module recorded one
; (AN-52; namespace.ax's `mangleRecordModuleView`). Only that case
; builds the `$name` probe, so a module's calls to names nobody
; shadows cost what they did.
(:: mangledForModCg (-> CG InternState DeclIndex String (Option String) String))
(fn (mangledForModCg cg bi index name module)
  (if (let (Some id) (internFind (internWordOf bi) name))
    {
      (let full (vecGetStr (cgMangleFulls cg) (vecGet index.first id)))
      (if (let (Some _) module)
        (if (|| (strEq full name)
              (match (internFind (internWordOf bi) (concat "$entry$" name))
                ((Some _) true)
                ((None) false)))
          (match (internFind (internWordOf bi) (concat "$" name))
            ((Some imported) (vecGetStr (cgMangleFulls cg) (vecGet index.first imported)))
            ((None) full))
          full)
        full)
    }
    name))

; The three declaration-list scans, through the index; the linear scan
; when no index has been built (the REPL's and LSP's partial paths,
; where field 40 is None until indexes are built).
;
; Each takes the `CG` rather than the declaration list, which is what
; lets the fallback name both. Every caller passed `(memGetWord cg 8)`
; anyway - there has never been a second declaration list to ask.
(pub :: isNullaryFnCg (-> CG String Bool))
(pub fn (isNullaryFnCg cg name)
  (if (let (Some index) (cgDeclIndex cg))
    (if (let (Some id) (internFind (internWordOf index.names) (declSpellingOf name)))
      (== (vecGet index.nullary id) 1)
      false)
    (isNullaryFn (cgDecls cg) name)))

(pub :: isDefinedFnCg (-> CG String Bool))
(pub fn (isDefinedFnCg cg name)
  (if (let (Some index) (cgDeclIndex cg))
    (if (let (Some id) (internFind (internWordOf index.names) (declSpellingOf name)))
      (== (vecGet index.defined id) 1)
      false)
    (isDefinedFn (cgDecls cg) name)))

; `fnArityIn` answers 0 for a name it never finds, and so does this:
; slot [4] holds -1 for a name only an `extern` item put in the index,
; and there is no id at all for a name no declaration carries.
(pub :: fnArityOfCg (-> CG String Int))
(pub fn (fnArityOfCg cg name)
  (if (let (Some index) (cgDeclIndex cg))
    (if (let (Some id) (internFind (internWordOf index.names) (declSpellingOf name)))
      {
        (let arity (vecGet index.arity id))
        (if (< arity 0)
          0
          arity)
      }
      0)
    (fnArityOf (cgDecls cg) name)))

; Unknown body arity cannot match an actual application count.
(:: fnArityMatches (-> CG String Int Bool))
(fn (fnArityMatches cg name actual)
  (match (fnArityCg cg name)
    ((None) false)
    ((Some expected) (== actual expected))))

; A signed function's parameter count, recorded by `inferOwnership`
; from its definition; None for a name with no signature or no body.
(pub :: fnArityCg (-> CG String (Option Int)))
(pub fn (fnArityCg cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigArity e)
      None)
  })

; ------------------------------------------------------------------
; MM-LIFE-2c events 2 and 3, made exact: WHO OWNS A RESULT.
;
; The memory model records the pair - retain a reference result
; before every return, release a `let` bound to such a call - as
; built, measured at 285 retains for 8 releases, and declined. The
; version measured retained EVERY tail that was not a direct
; construction, and that is where the 285 came from: a string built
; by `concat`, returned through a `let` or a `cast`, is born at
; count 1 and was retained to 2, and the one share a caller could
; ever hand back left it at 1 forever. Retaining what is already owned
; is the leak; not retaining what is borrowed is the dangle. The pair
; is sound and cheap only if the emitter can tell the two apart, and
; it can, by asking the same question of every function in the program
; and iterating to a fixpoint:
;
;   a result is OWNED when every tail the body can answer is a direct
;   construction, a literal (statics are immortal), a lambda, an
;   `__alloc`, a word, or a call to a function whose result is owned;
;   `cast` answers its operand's ownership; a `let`-bound name answers
;   its initialiser's; a `match` binder, a parameter, a field read, a
;   raw load, a local function value's answer, an effect operation's
;   answer are BORROWED.
;
; The fixpoint is the GREATEST one - every function starts owned and
; loses it when a path shows otherwise - so recursion through an
; owned-result function stays owned, which is the truth: a value
; reached through the cycle is produced at its end.
;
; With that, event 2 retains a reference-class result iff the function
; is not owned (`borrowedTailLeaves`), so every reference-returning global
; hands its caller exactly one share; event 3 releases a `let` bound
; to any such call or construction (`valueOwnedRef`), not only to a
; direct construction; an owned value discarded in statement position
; is released on the spot; and an owned value passed to a global whose
; result class is known, or stored into a constructor's or struct's
; reference field, is released once the callee or the store has taken
; its own share (`releaseOwnedArgs`, `emitFieldStores`, `emitSetF`).
; Words are never released - a `release` on an integer that is not a
; handle is a wild read - so everything here is gated on the declared
; result or field class being a reference (`fldClass` 2).
;
; What stays leaked, deliberately: a temporary passed to a primitive,
; a `cast` or a local function value (none of those retains what it
; is handed back); a temporary a type-variable-result call parks,
; consumes, or does not answer from (`borrowedFromOwnedClass` handles
; the one it answers from); a `match` scrutinee built in place; a
; temporary stored through `set` into a slot that only stores
; (`slotOwns` refused it). Each is the leak direction, and each is
; narrower than the old rule's "everything not bound to a direct
; construction".
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; THE CALLER INDEX, AND THE WORKLISTS IT FEEDS. The two fixpoints
; below (`inferOwnership`, `inferFlows`) used to re-walk every
; declaration on every round: a self-compile's flow rounds cost
; seconds of the emit phase walking functions whose summaries the
; previous round could not have moved. Rounds after the first now
; walk only the callers of functions whose summary changed - the
; shape `rgnWork` runs in the checker over `callersIdxBuild`.
;
; The index answers, per signature, which declarations name it at a
; call head or a tail reference: the only two places the walks read
; another function's summary (`fnStashMask`, `fnConsumeMask`,
; `callRetMask`, `fnResultOwned`). It is keyed by the intern id the
; signature index (words 37/38) already assigns each name, so a row
; is found with the same lookup `findFSigCg` makes. Rows hold each
; calling declaration once, however many call sites it carries, and
; the count is recorded on the signature itself (word 11). A call
; through a local, a parameter or a computed head reads no summary -
; the walks park every argument there - so it records no edge, and a
; name shadowed by a local records one anyway: a spare edge costs a
; re-walk, a missing one would cost the fixpoint, and the final
; full pass below is what keeps that trade honest.
; ------------------------------------------------------------------
; Every declaration index, ascending: a worklist's first frontier,
; because round one reported only THAT something moved, not what.
(pub :: cgAllIndexes (-> Int Ints))
(pub fn (cgAllIndexes n)
  {
    (let v vecNew)
    (let mut i 0)
    {
      (while (< i n)
        {
          (vecPush v i)
          (set i (+ i 1))
        })
      v
    }
  })

(pub :: cgFlagsNew (-> Int Ints))
(pub fn (cgFlagsNew n)
  {
    (let v vecNew)
    (let mut i 0)
    {
      (while (< i n)
        {
          (vecPush v 0)
          (set i (+ i 1))
        })
      v
    }
  })

; The marks this round set, put back to 0 so the next round starts
; on an all-zero vector without walking every declaration to find
; the entries to clear.
(pub :: cgClearMarks (-> Ints Ints Int Int))
(pub fn (cgClearMarks marks idxs i)
  (if (>= i (vecLen idxs))
    0
    {
      (vecSet marks (vecGet idxs i) 0)
      (cgClearMarks marks idxs (+ i 1))
    }))

(pub :: cgInVec (-> Ints Int Int Int))
(pub fn (cgInVec v x i)
  (if (>= i (vecLen v))
    0
    (if (== (vecGet v i) x)
      1
      (cgInVec v x (+ i 1)))))

; `x` appended to `v` when it is not already there; answers 1 when
; it appended. A caller is woken once per round however many call
; sites to the changed function its body carries.
(pub :: cgPushUnique (-> Ints Int Int))
(pub fn (cgPushUnique v x)
  (if (== (cgInVec v x 0) 1)
    0
    {
      (vecPush v x)
      1
    }))

; Insert `x` into an ascending list, in place. A round's frontier
; is the callers of what moved in it - small - so an insertion is
; the right shape and a sort at the end would be the wrong one.
(pub :: cgPushSorted (-> Ints Int Int))
(pub fn (cgPushSorted v x)
  {
    (let mut i (vecLen v))
    {
      (vecPush v x)
      (while (if (> i 0)
        (> (vecGet v (- i 1)) x)
        false)
        {
          (vecSet v i (vecGet v (- i 1)))
          (set i (- i 1))
        })
      (vecSet v i x)
      0
    }
  })

(pub :: cgMarkEach (-> Ints Ints Ints Int Int))
(pub fn (cgMarkEach marks next idxs i)
  (if (>= i (vecLen idxs))
    0
    {
      {
        (let x (vecGet idxs i))
        (if (! (== (vecGet marks x) 1))
          {
            (vecSet marks x 1)
            (cgPushSorted next x)
          })
      }
      (cgMarkEach marks next idxs (+ i 1))
    }))

; The intern id the signature for `name` sits under in words 37/38,
; or -1 when no signature carries it: `findFSigCg`'s lookup, keeping
; the id.
(pub :: fsigIdCg (-> CG String Int))
(pub fn (fsigIdCg cg name)
  (if (let (Some si) (cgSigIntern cg))
    (if (let (Some id) (internFind (internWordOf si) (declSpellingOf name)))
      id
      (- 0 1))
    (- 0 1)))

; One edge: declaration `who` names `name`, which the module word
; (set by the caller, as the passes set it) resolves to a signature.
(pub :: callEdgeCg (-> CG String Int Ints Int))
(pub fn (callEdgeCg cg name who rows)
  {
    (let id (fsigIdCg cg (mangledForCg cg name)))
    (if (< id 0)
      0
      (cgPushUnique (vecGetVec rows id) who))
  })

; Every call head and tail reference under `e`, by the child
; enumeration the slot walks already trust (`slotPart`). A tag that
; enumeration does not know is not descended into; the walks read
; no summary under one either, and the worklists' final full pass
; verifies the frontier regardless.
(pub :: collectCallsCg (-> CG ASTNode Int Ints Int))
(pub fn (collectCallsCg cg e who rows)
  (if (nodeSame e nilNode)
    0
    {
      (if (== (nodeTag e) TAG_E_VAR)
        (callEdgeCg cg (nodeAName e) who rows)
        0)
      (let n (slotPartCount e))
      (if (< n 0)
        0
        (collectPartsCg cg e who rows n 0))
    }))

(pub :: collectPartsCg (-> CG ASTNode Int Ints Int Int Int))
(pub fn (collectPartsCg cg e who rows n i)
  (if (>= i n)
    0
    {
      (collectCallsCg cg (slotPart e i) who rows)
      (collectPartsCg cg e who rows n (+ i 1))
    }))

; The index itself: one caller row per signature the name index
; knows, built by one walk of every function body, with each
; declaration's module word set as the passes set it - a bare
; reference resolves in the module that wrote it. Each signature's
; row length is recorded on the signature (word 11) as the count
; is settled.
(pub :: callersIdxBuildCg (-> CG (Vec ASTNode) Ints))
(pub fn (callersIdxBuildCg cg decls)
  {
    (let byId (cgSigById cg))
    (let rows vecNew)
    (let savedMod (cgModule cg))
    {
      {
        (let mut i 0)
        (while (< i (vecLen byId))
          {
            (vecPush rows (as vecNew Int))
            (set i (+ i 1))
          })
      }
      {
        (let mut j 0)
        (while (< j (vecLen decls))
          {
            {
              (let d (vecGet decls j))
              (if (== (nodeTag d) TAG_D_FN)
                {
                  (cgSetDeclModule cg d)
                  (collectCallsCg cg (nodeCChild d) j rows)
                }
                0)
            }
            (set j (+ j 1))
          })
      }
      (cgSetModule cg savedMod)
      {
        (let mut k 0)
        (while (< k (vecLen byId))
          {
            (fsigSetCallers (vecGet byId k) (vecLen (vecGetVec rows k)))
            (set k (+ k 1))
          })
      }
      rows
    }
  })

; The callers of the function declaration `d` declares, added to
; the next frontier. A declaration with no signature, or one the
; index counts no callers for, wakes nobody.
(pub :: cgMarkCallers (-> CG Ints Ints Ints ASTNode Int))
(pub fn (cgMarkCallers cg rows marks next d)
  {
    (let eFound (findFSigCg cg (nodeAName d)))
    (if (let (Some e) eFound)
      (if (== (fsigCallers e) 0)
        0
        {
          (let id (fsigIdCg cg (nodeAName d)))
          (if (< id 0)
            0
            (cgMarkEach marks next (vecGetVec rows id) 0))
        })
      0)
  })

(pub :: inferOwnership (-> CG (Vec ASTNode) CG))
(pub fn (inferOwnership cg decls)
  {
    (inferOwnershipRounds cg decls)
    (cgSetModule cg (None))
    (cgSetCurDecl cg None)
  })

; The rounds: one full pass, then worklist rounds over the caller
; index when the name index exists (the emit path builds it before
; either fixpoint runs). Without one - a partial path - the old
; full-pass rounds run unchanged. The flags only ever move 1 -> 0,
; so both shapes terminate.
(pub :: inferOwnershipRounds (-> CG (Vec ASTNode) Int))
(pub fn (inferOwnershipRounds cg decls)
  (if (== (inferOwnershipPass cg decls 0 0) 0)
    0
    (if (! (cgSigIndexBuilt cg))
      (inferOwnershipRounds cg decls)
      (inferOwnershipWork cg decls (callersIdxBuildCg cg decls) (cgAllIndexes (vecLen decls))
        (cgFlagsNew (vecLen decls))))))

; Worklist rounds: each walks the previous round's frontier. A
; quiet frontier is verified by one full pass before convergence
; is claimed, and a change there restarts with a full frontier
; rather than trusting the index to have seen every edge.
(pub :: inferOwnershipWork (-> CG (Vec ASTNode) Ints Ints Ints Int))
(pub fn (inferOwnershipWork cg decls rows work marks)
  {
    (let next vecNew)
    (if (== (inferOwnershipDirty cg decls rows work marks next) 0)
      (if (== (inferOwnershipPass cg decls 0 0) 0)
        0
        (inferOwnershipWork cg decls rows (cgAllIndexes (vecLen decls)) marks))
      {
        (cgClearMarks marks next 0)
        (inferOwnershipWork cg decls rows next marks)
      })
  })

; One worklist pass over `work`: walk each, and collect the callers
; of every function whose flag fell into `next`. Answers 1 when
; anything fell. The frontier is visited from its last element, for
; the reason `rgnDirtyPass` states.
(pub :: inferOwnershipDirty (-> CG (Vec ASTNode) Ints Ints Ints Ints Int))
(pub fn (inferOwnershipDirty cg decls rows work marks next)
  {
    (let mut j (- (vecLen work) 1))
    (let mut changed 0)
    {
      (while (>= j 0)
        {
          (let d (vecGet decls (vecGet work j)))
          {
            (if (!= (inferOwnershipOne cg d) 0)
              {
                (cgMarkCallers cg rows marks next d)
                (set changed 1)
              })
            (set j (- j 1))
          }
        })
      changed
    }
  })

; One declaration's ownership walk; answers 1 when its flag fell.
; The body's bare references resolve in the module that wrote it -
; a private sibling has no bare-map entry and is reachable only as
; `Mod$name` (`emitModuleTail` sets the same word for the same
; reason).
(pub :: inferOwnershipOne (-> CG ASTNode Int))
(pub fn (inferOwnershipOne cg d)
  (if (!= (nodeTag d) TAG_D_FN)
    0
    {
      (let _m (cgSetDeclModule cg d))
      (let _d (cgSetCurDecl cg (Some d)))
      (let eFound (findFSigCg cg (nodeAName d)))
      (if (let (Some e) eFound)
        (if (== (fsigOwned e) 0)
          0
          (if (==
                {
                  (let _a (fsigSetArity e (Some (vecLen (nodeBNames d)))))
                  (tailOwned cg (nodeCChild d) (nodeBNames d) vecNew)
                }
                1)
            0
            {
              (fsigSetOwned e 0)
              1
            }))
        0)
    }))

; One full pass: recompute every signed function; answer 1 if any
; flag moved (always 1 -> 0, so the loop terminates). Kept whole as
; the worklist's first round and its verification pass.
(pub :: inferOwnershipPass (-> CG (Vec ASTNode) Int Int Int))
(pub fn (inferOwnershipPass cg decls i changed)
  (if (>= i (vecLen decls))
    changed
    (if (== (inferOwnershipOne cg (vecGet decls i)) 1)
      (inferOwnershipPass cg decls (+ i 1) 1)
      (inferOwnershipPass cg decls (+ i 1) changed))))

; The ownership of the named global's result under the current
; assumption: 0 when it has no signature, which is also what a local,
; a constructor-less head and an effect operation answer.
(pub :: fnResultOwned (-> CG String Int))
(pub fn (fnResultOwned cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigOwned e)
      0)
  })

; Is every value `e` can answer owned? `params` are the enclosing
; function's parameters; `env` owns the names and flags of the
; `let` bindings and match binders in scope.
(pub :: tailOwned (-> CG ASTNode Names FlowEnv Int))
(pub fn (tailOwned cg e params env)
  (if (nodeSame e nilNode)
    1
    {
      (let tg (nodeTag e))
      (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT) (|| (== tg TAG_E_STR) (|| (== tg TAG_E_CHAR) (== tg TAG_E_LAM)))))
        1
        (if (== tg TAG_E_VAR)
          {
            (let found
              (:: (if (== (nodeDefScope e) 1)
                None
                (envFlagOf env (nodeAName e))) (Option Int)))
            (if (let (Some flag) found)
              flag
              (if (&& (!= (nodeDefScope e) 1) (>= (paramIndexIn params (nodeAName e) 0) 0))
                0
                ; a nullary constructor is an immediate: owned,
                ; and releasing it is a no-op
                (if (hasType (cgTypes cg) (nodeAName e))
                  1
                  ; A nullary global answers according to its own flag;
                  ; a named function value is an immortal descriptor.
                  (if (isDefinedFnCg cg (mangledForCg cg (nodeAName e)))
                    1
                    (fnResultOwned cg (nodeAName e))))))
          }
          (if (== tg TAG_E_FIELD)
            0
            (if (== tg TAG_E_APP)
              (tailOwnedApp cg e params env)
              (if (== tg TAG_E_IF)
                (if (== (tailOwned cg (nodeBChild e) params env) 1)
                  (tailOwned cg (nodeCChild e) params env)
                  0)
                ; `cond` is AX2004: the parser builds none, so no
                ; arm asks after one's tails. A variadic `if`
                ; arrives as nested `if`s and walks the arm above.
                (if (== tg TAG_E_MATCH)
                  (tailOwnedArms cg (nodeBChildren e) params env 0)
                  (if (== tg TAG_E_BEGIN)
                    (if (== (vecLen (nodeAChildren e)) 0)
                      1
                      (tailOwned cg (vecGet (nodeAChildren e) (- (vecLen (nodeAChildren e)) 1))
                        params env))
                    (if (== tg TAG_E_LET)
                      (tailOwned cg (nodeCChild e) params
                        (envWith env (nodeAName e) (tailOwned cg (nodeBChild e) params env)))
                      (if (== tg TAG_E_LETM)
                        ; a mutable slot may be reassigned to anything
                        (tailOwned cg (nodeCChild e) params (envWith env (nodeAName e) 0))
                        (if (== tg TAG_E_SET)
                          ; `(set k v)` evaluates to `v`, as owned as `v` is
                          (tailOwned cg (nodeBChild e) params env)
                          (if (|| (== tg TAG_E_WHILE)
                                (|| (== tg TAG_E_SETF)
                                  (|| (== tg TAG_E_STRUCTCON) (== tg TAG_E_REGION))))
                            ; words, and a keyword construction born at count 1;
                            ; a `region`'s value is a scalar by the checker's
                            ; rule (AX3059), so it is a word too
                            1
                            0)))))))))))
    }))

; An application's ownership, by its head.
(pub :: tailOwnedApp (-> CG ASTNode Names FlowEnv Int))
(pub fn (tailOwnedApp cg e params env)
  {
    (let hd (spineHead e))
    (if (|| (!= (nodeTag hd) TAG_E_VAR) (closureOwnedCall cg e))
      (if (!= (fldClass cg (checkedValueTy e)) 0)
        1
        0)
      {
        (let n (nodeAName hd))
        (if (isCastName n)
          ; `(cast T v)`: v's ownership, v being the second
          ; argument of the flattened spine
          (if (>= (spineArity e) 2)
            (tailOwned cg (spineArgAt e 1) params env)
            0)
          (if (|| (strEq n "sizeof") (strEq n "alignof"))
            1
            (if (isBinop n)
              ; arithmetic on a word of a borrowed reference is still
              ; that reference, laundered: owned iff every operand is
              (tailOwnedArgsAll cg e (spineArity e) params env 0)
              (if (|| (isCmpOp n) (isAndOr n))
                1
                (if (isPrimName n)
                  ; a static's address and a converted number are words;
                  ; a load answers what some block holds; and a FRESH
                  ; ALLOCATION is born at count 0 - free-floating, owned
                  ; by nobody until a store takes the first share - so a
                  ; reference-class function answering one must ADOPT it
                  ; (event 2's retain takes it to 1), which is why it
                  ; answers 0 here rather than 1. A constructor
                  ; expression is the one birth at count 1 (`A1` in
                  ; `emitConstructor`); every `String` comes through
                  ; `__alloc`.
                  (if (|| (strEq n "__load64")
                        (|| (strEq n "__load8") (|| (strEq n "__argv") (strEq n "__alloc"))))
                    0
                    1)
                  (if (|| (isSome (envFlagOf env n)) (>= (paramIndexIn params n 0) 0))
                    ; Known reference results obey the closure return contract.
                    (if (!= (fldClass cg (checkedValueTy e)) 0)
                      1
                      0)
                    (if (hasFSigCg cg (mangledForCg cg n))
                      ; a reference-returning global answers ONE share by
                      ; construction - it retains a borrowed tail itself - so
                      ; its flag is its own business; a word-returning one or a
                      ; type-variable one answers what its tails answer
                      (if (== (fnResultClass cg n) 2)
                        1
                        (fnResultOwned cg n))
                      (if (hasType (cgTypes cg) n)
                        1
                        0))))))))
      })
  })

(pub :: tailOwnedArgsAll (-> CG ASTNode Int Names FlowEnv Int Int))
(pub fn (tailOwnedArgsAll cg e n_ params env i)
  (if (>= i n_)
    1
    (if (== (tailOwned cg (spineArgAt e i) params env) 1)
      (tailOwnedArgsAll cg e n_ params env (+ i 1))
      0)))

(pub :: tailOwnedArms (-> CG (Vec ASTNode) Names FlowEnv Int Int))
(pub fn (tailOwnedArms cg arms params env i)
  (if (>= i (vecLen arms))
    1
    {
      (let arm (vecGet arms i))
      {
        (let bs (patBindersCg (nodeAChild arm) vecNew))
        (if (== (as bs Int) 0)
          0
          (if (== (tailOwned cg (nodeBChild arm) params (envWithAll env bs 0)) 1)
            (tailOwnedArms cg arms params env (+ i 1))
            0))
      }
    }))

; The spine's argument count and i-th argument, WITHOUT building a
; vector: the flow walks below run over every application several
; times per fixpoint pass, and a vector per visit was 60 MB of a
; self-compile in an arena that never frees.
(pub :: spineArity (-> ASTNode Int))
(pub fn (spineArity e)
  (if (== (nodeTag e) TAG_E_APP)
    (+ 1 (spineArity (nodeAChild e)))
    0))

; One immutable local binding owns its spelling and scalar flow flag.
; Copies and memo snapshots may share these rows; later shadows append.
(pub struct FlowBinding
  (name : String)
  (flag : Int))

(pub type FlowEnv (Vec FlowBinding))

; Innermost binding wins. A present zero or negative flag remains present.
(pub :: envFlagOf (-> FlowEnv String (Option Int)))
(pub fn (envFlagOf env name)
  (envFlagFrom env name (- (vecLen env) 1)))

(pub :: envFlagFrom (-> FlowEnv String Int (Option Int)))
(pub fn (envFlagFrom env name i)
  (if (< i 0)
    None
    {
      (let binding (vecGet env i))
      (if (strEq binding.name name)
        (Some binding.flag)
        (envFlagFrom env name (- i 1)))
    }))

(pub :: envWith (-> FlowEnv String Int FlowEnv))
(pub fn (envWith env name flag)
  {
    (let v (:: (vecAppendFrom env vecNew 0) FlowEnv))
    (vecPush v (FlowBinding :name name :flag flag))
    v
  })

; The arms' binders with their flows: a binder of a REFERENCE field
; carries the scrutinee's flow (the field is storage the block owns);
; a binder of a SCALAR field carries nothing - `(ICons x r)`'s `x` is
; a number, and a function summing it answered "a word of the list",
; so no caller ever released one.
(pub :: envWithPat (-> CG FlowEnv ASTNode Int FlowEnv))
(pub fn (envWithPat cg env pat flag)
  {
    (let v (:: (vecAppendFrom env vecNew 0) FlowEnv))
    {
      (envPushPat cg v pat flag)
      v
    }
  })

(pub :: envPushPat (-> CG FlowEnv ASTNode Int Int))
(pub fn (envPushPat cg v pat flag)
  (if (nodeSame pat nilNode)
    0
    {
      (let tag (nodeTag pat))
      (if (== tag TAG_E_VAR)
        {
          (vecPush v (FlowBinding :name (nodeAName pat) :flag flag))
          0
        }
        (if (== tag TAG_E_APP)
          {
            (let hd (spineHead pat))
            {
              (let entryFound
                (if (== (nodeTag hd) TAG_E_VAR)
                  (lookupType (cgTypes cg) (nodeAName hd))
                  (None)))
              (envPushPatArgs cg v pat (spineArity pat) entryFound flag 0)
            }
          }
          (if (== tag TAG_P_CONNAMED)
            (envPushPatVec cg v (nodeCChildren pat) flag 0)
            0)))
    }))

(pub :: envPushPatArgs (-> CG FlowEnv ASTNode Int (Option TypeEntry) Int Int Int))
(pub fn (envPushPatArgs cg v pat n_ entry flag i)
  (if (>= i n_)
    0
    {
      (let tn
        (if (let (Some found) entry)
          (fieldTypeNode found i)
          None))
      {
        (let f
          (match tn
            ((None) flag)
            ((Some ty)
              (if (== (fldClass cg ty) 0)
                0
                flag)
            )))
        {
          (envPushPat cg v (spineArgAt pat i) f)
          (envPushPatArgs cg v pat n_ entry flag (+ i 1))
        }
      }
    }))

(pub :: envPushPatVec (-> CG FlowEnv (Vec ASTNode) Int Int Int))
(pub fn (envPushPatVec cg v subs flag i)
  (if (== (as subs Int) 0)
    0
    (if (>= i (vecLen subs))
      0
      {
        (envPushPat cg v (vecGet subs i) flag)
        (envPushPatVec cg v subs flag (+ i 1))
      })))

(pub :: envWithAll (-> FlowEnv Names Int FlowEnv))
(pub fn (envWithAll env names flag)
  {
    (let v (:: (vecAppendFrom env vecNew 0) FlowEnv))
    (envPushAll v names flag 0)
  })

(pub :: envPushAll (-> FlowEnv Names Int Int FlowEnv))
(pub fn (envPushAll v names flag i)
  (if (>= i (vecLen names))
    v
    {
      (vecPush v (FlowBinding :name (vecGet names i) :flag flag))
      (envPushAll v names flag (+ i 1))
    }))

; ------------------------------------------------------------------
; WHERE AN ARGUMENT GOES: the parameter-escape half of the model.
;
; A caller may hand back a temporary's share after a call, and a
; `let` may release its block after passing it to a callee, only if
; the callee kept nothing of it that counting did not see. The stores
; counting sees are the reference-typed ones (events 5 and 6,
; `memSetWord`'s `__retainref`). The ones it cannot see are the
; erasures: a value parked in a field declared `Int` through a
; `cast`, in a mutable slot through `set`, in raw memory through
; `__store64`, in a closure's record, or handed on to a callee that
; does one of those - `mkDiag` parks its message through
; `(cast Int msg)` in an `Int`-declared field, and the first draft of
; this released the message right after the call. Retaining at every
; `cast` instead was measured and rejected: `strLen` and `strData` are
; casts, and every string in the compiler grew a share per read.
;
; So each signed function carries two masks over its parameters:
; STASH - the parameters some part of whose reference the body parks
; beyond the frame uncounted; RET - the parameters whose reference
; may be (part of) a WORD the function answers, for a function whose
; result is not itself a counted reference. Both are least fixpoints
; over the call graph: a call to `g` stashes what `g` stashes, and
; answers what `g` answers.
;
; TWO FORMS. A reference reaches a callee either typed - a `String`
; parameter, which `memSetWord`'s `__retainref` will count before
; storing - or already laundered to a WORD by `cast`, `strData`,
; `strOwner`, `__addr` or arithmetic on one of those, which no witness
; retains. `(memSetWord m 0 (cast Int s))` parks `s` uncounted where
; `(memSetWord m 0 s)` does not. So every flow mask, and every
; summary, has two halves: bits 0-29 for "parameter i as it arrived",
; bits 30-59 for "a word of parameter i, laundered here". A summary's
; word half says what happens to a parameter that ARRIVES as a word;
; its arrival half, to one that arrives typed. A `__retainref` of a
; parameter cancels its arrival-half stash only - the witness for a
; word is `Int`, and retains nothing. The refutation pass found both
; holes the single-form draft had: the cancel trusted blindly, and
; `(+ (cast Int s) 0)` dropping `s` at the operator.
; ------------------------------------------------------------------
(pub :: inferFlows (-> CG (Vec ASTNode) CG))
(pub fn (inferFlows cg decls)
  {
    (inferFlowsRounds cg decls)
    (cgSetModule cg (None))
    (cgSetCurDecl cg None)
  })

; The rounds: one full pass, then worklist rounds over the caller
; index when the name index exists. Without one - a partial path -
; the old full-pass rounds run unchanged. The masks only ever gain
; bits, so both shapes terminate at the same fixpoint.
(pub :: inferFlowsRounds (-> CG (Vec ASTNode) Int))
(pub fn (inferFlowsRounds cg decls)
  (if (== (inferFlowsPass cg decls 0 0) 0)
    0
    (if (! (cgSigIndexBuilt cg))
      (inferFlowsRounds cg decls)
      (inferFlowsWork cg decls (callersIdxBuildCg cg decls) (cgAllIndexes (vecLen decls))
        (cgFlagsNew (vecLen decls))))))

; Worklist rounds: each walks the previous round's frontier. A
; quiet frontier is verified by one full pass before convergence
; is claimed, and a change there restarts with a full frontier
; rather than trusting the index to have seen every edge.
(pub :: inferFlowsWork (-> CG (Vec ASTNode) Ints Ints Ints Int))
(pub fn (inferFlowsWork cg decls rows work marks)
  {
    (let next vecNew)
    (if (== (inferFlowsDirty cg decls rows work marks next) 0)
      (if (== (inferFlowsPass cg decls 0 0) 0)
        0
        (inferFlowsWork cg decls rows (cgAllIndexes (vecLen decls)) marks))
      {
        (cgClearMarks marks next 0)
        (inferFlowsWork cg decls rows next marks)
      })
  })

; One worklist pass over `work`: walk each, and collect the callers
; of every function whose masks grew into `next`. Answers 1 when
; anything grew. The frontier is visited from its last element, for
; the reason `rgnDirtyPass` states.
(pub :: inferFlowsDirty (-> CG (Vec ASTNode) Ints Ints Ints Ints Int))
(pub fn (inferFlowsDirty cg decls rows work marks next)
  {
    (let mut j (- (vecLen work) 1))
    (let mut changed 0)
    {
      (while (>= j 0)
        {
          (let d (vecGet decls (vecGet work j)))
          {
            (if (!= (inferFlowsOne cg d) 0)
              {
                (cgMarkCallers cg rows marks next d)
                (set changed 1)
              })
            (set j (- j 1))
          }
        })
      changed
    }
  })

; One declaration's flow walk; answers 1 when any of its masks
; grew. Split out of `inferFlowsPass` so the worklist rounds walk
; single declarations, as `rgnWalkOne` does for the region facts.
(pub :: inferFlowsOne (-> CG ASTNode Int))
(pub fn (inferFlowsOne cg d)
  (if (!= (nodeTag d) TAG_D_FN)
    0
    {
      (let _m (cgSetDeclModule cg d))
      (let _d (cgSetCurDecl cg (Some d)))
      (let eFound (findFSigCg cg (nodeAName d)))
      (if (let (Some e) eFound)
        {
          (let cell regionNew)
          {
            ; the two walks below see one set of summaries - they
            ; are written after both - so `mutFlag` may keep its
            ; answers across them rather than per call
            (mutMemoOpen cg)
            (flowStashes cg (nodeCChild d) (nodeBNames d) vecNew cell)
            ; MM-LIFE-2g's own stores: a parameter the body
            ; handed to `__retainref` is COUNTED before it
            ; is parked - when it arrived typed. `__retain`
            ; counts the word it is given whatever its form.
            ; A summary's word half always contains its
            ; arrival half: what parks a typed reference
            ; uncounted parks a word too. The count pairs
            ; with the stash only on the paths it runs on:
            ; `regionNet` nets each branch's stashes against
            ; the counts of that branch and its enclosing
            ; regions, never a sibling's.
            ; what the open region consumed, net of its counts,
            ; widened to the word half like the stash summary:
            ; a parameter released on any path is consumed on
            ; every path the caller can reason about
            {
              (let st0 (| (regionNet cell) (tyvarSlotsMask cg e d)))
              {
                (let st (| (fsigStash e) (| st0 (arrivalToWord st0))))
                (let rt
                  (if (== (fsigResultIsWord cg e) 1)
                    0
                    (| (fsigRet e) (flowMask cg (nodeCChild d) (nodeBNames d) vecNew))))
                (let _z (mutMemoClose cg))
                (let co0 (& (memGetWord cell 3) (^ (memGetWord cell 1) (- 0 1))))
                (let co (| (fsigConsume e) (| co0 (arrivalToWord co0))))
                (if (&& (== st (fsigStash e)) (&& (== rt (fsigRet e)) (== co (fsigConsume e))))
                  0
                  {
                    (fsigSetStash e st)
                    (fsigSetRet e rt)
                    (fsigSetConsume e co)
                    1
                  })
              }
            }
          }
        }
        0)
    }))

; One full pass: recompute every signed function; answer 1 if any
; mask grew. Kept whole as the worklist's first round and its
; verification pass.
(pub :: inferFlowsPass (-> CG (Vec ASTNode) Int Int Int))
(pub fn (inferFlowsPass cg decls i changed)
  (if (>= i (vecLen decls))
    changed
    (if (== (inferFlowsOne cg (vecGet decls i)) 1)
      (inferFlowsPass cg decls (+ i 1) 1)
      (inferFlowsPass cg decls (+ i 1) changed))))

; A function whose declared result is a WORD STRUCT answers nothing the
; caller must keep alive. A word struct is one word that takes no share
; (MM-VAL-10a), sealed so that only its module reads the word, and no
; module dereferences one: `Chan`, `Mutex` and the keys hold a handle
; table's slot, `Date` and its siblings a value, and `Mem.Addr` an
; address that is only compared and hashed. So its result aliases no
; parameter, whatever the body computed the word from - the same
; reading `binderIsWord` gives a word-struct binder. Without it
; `(addrOf v)` read as a pointer into `v`, and the caller kept `v`
; alive for good: 48 bytes held per call.
(pub :: fsigResultIsWord (-> CG FSig Int))
(pub fn (fsigResultIsWord cg e)
  (if (let (Some res) (fnDeclaredResultTy (fsigTy e) (fsigArity e)))
    (if (!= (nodeTag res) TAG_T_CON)
      0
      (if (let (Some t) (lookupType (cgTypes cg) (nodeAName res)))
        (if (== (eKind t) TF_WORD)
          1
          0)
        0))
    0))

; A self-tail-calling function's TYPE-VARIABLE and `Int` parameters,
; every form: the loop's slot for such a parameter takes no retain
; (a type variable's class is decided by evidence the boundary does
; not consult; a word is a word), so an argument handed to it is
; parked uncounted - a `let`'s temporary paid at the jump was freed
; under the slot, and `(l1 s (asWord t) (- n 1))` handed the slot a
; pointer into `t`. Parked, the walk keeps it; the leak is the safe
; direction until the boundary retains by evidence.
(pub :: tyvarSlotsMask (-> CG FSig ASTNode Int))
(pub fn (tyvarSlotsMask cg e d)
  (if (== (tailCallsSelf (nodeCChild d) (bareOf (nodeAName d)) (vecLen (nodeBNames d))) 1)
    (tyvarSlotsFrom cg (fsigTy e) (vecLen (nodeBNames d)) 0)
    0))

(pub :: tyvarSlotsFrom (-> CG (Option ASTNode) Int Int Int))
(pub fn (tyvarSlotsFrom cg sigTy n i)
  (if (>= i n)
    0
    (|
      {
        (let cls (parameterTypeClass cg (signatureParamTy sigTy i)))
        (if (== cls 0)
          ; an `Int` slot: a word of a binding handed to it is
          ; parked there uncounted, and the binding must outlive the
          ; jump; a type-variable slot is retained by evidence, so
          ; only a WORD arriving there is parked (the weak bits)
          (bothForms (paramBit i))
          (if (== cls 1)
            (wordBit i)
            0))
      }
      (tyvarSlotsFrom cg sigTy n (+ i 1)))))

; The encoding: THREE forms of parameter i, twenty parameters per
; form (i >= 19 share bit 19).
;
;   bit i        ARRIVAL - parameter i as it came: a typed reference,
;                or a type-variable value of whatever kind
;   bit 20 + i   HEADER WORD - the handle laundered into a word by
;                `cast`, `__addr` or arithmetic; an `Int` parameter
;                arrives as one
;   bit 40 + i   OWNER WORD - a pointer into, or to, the block the
;                string's header OWNS: `strData`, `strOwner`, a load
;                of a header word past index 0; an `Int` parameter
;                may be one of these too
;
; A count pairs with a park of the SAME thing: `(__retainref s)` and
; `(__retain (cast Int s))` count the header and license a park of
; the header (bit i, bit 20+i); `(__retain (strOwner s))` counts the
; owner and licenses a park of the owner (bit 40+i) - `strSlice` and
; `sysReadAll` - and nothing of the header, which two forms could
; not say: the owner's count cancelled a park of the header, and
; `(match o ((Full x) { (__retainref x) (__store64 m 0 (cast Int o))
; 0 }))` freed `o` under the store.
(pub :: paramBit (-> Int Int))
(pub fn (paramBit i)
  (if (< i 0)
    0
    (if (>= i 19)
      (<< 1 19)
      (<< 1 i))))

(pub :: wordBit (-> Int Int))
(pub fn (wordBit i)
  (if (< i 0)
    0
    (if (>= i 19)
      (<< 1 39)
      (<< 1 (+ 20 i)))))

(pub :: ownerBit (-> Int Int))
(pub fn (ownerBit i)
  (if (< i 0)
    0
    (if (>= i 19)
      (<< 1 59)
      (<< 1 (+ 40 i)))))

; All three forms of parameter i.
(pub :: anyBit (-> Int Int))
(pub fn (anyBit i)
  (| (paramBit i) (| (wordBit i) (ownerBit i))))

(pub :: arrivalPart (-> Int Int))
(pub fn (arrivalPart m)
  (& m (- (<< 1 20) 1)))

(pub :: wordPart (-> Int Int))
(pub fn (wordPart m)
  (& m (<< (- (<< 1 20) 1) 20)))

(pub :: ownerPart (-> Int Int))
(pub fn (ownerPart m)
  (& m (<< (- (<< 1 20) 1) 40)))

; The two word forms together.
(pub :: wordParts (-> Int Int))
(pub fn (wordParts m)
  (| (wordPart m) (ownerPart m)))

; The arrival third moved to the header-word third.
(pub :: arrivalToWord (-> Int Int))
(pub fn (arrivalToWord m)
  (<< (arrivalPart m) 20))

; The header-word third moved to the arrival third.
(pub :: wordToArrival (-> Int Int))
(pub fn (wordToArrival m)
  (>> (wordPart m) 20))

(pub :: ownerToArrival (-> Int Int))
(pub fn (ownerToArrival m)
  (>> (ownerPart m) 40))

; The parameters `m` mentions in any form, as arrival bits.
(pub :: paramsOf (-> Int Int))
(pub fn (paramsOf m)
  (| (arrivalPart m) (| (wordToArrival m) (ownerToArrival m))))

; Everything in `m` laundered by `cast`, `__addr` or arithmetic: an
; arrival or a header word becomes a header word; an owner word
; under arithmetic is still a pointer into the owner.
(pub :: toWord (-> Int Int))
(pub fn (toWord m)
  (| (arrivalToWord m) (wordParts m)))

; Everything in `m` read through `strData`, `strOwner` or a header
; word past index 0: the owner of whatever it was.
(pub :: toOwner (-> Int Int))
(pub fn (toOwner m)
  (<< (paramsOf m) 40))

; Everything in `m` in every form - what an uncounted park records:
; the parameter is parked however it arrived or was laundered.
(pub :: bothForms (-> Int Int))
(pub fn (bothForms m)
  {
    (let ps (paramsOf m))
    (| ps (| (<< ps 20) (<< ps 40)))
  })

; The forms a value of flow `m` is parked in, or counted in: a
; header - typed, or as a header word - in both header forms, an
; owner word as the owner. What `__retain` counts and what a raw
; store, a word field or a capture parks.
(pub :: parkForms (-> Int Int))
(pub fn (parkForms m)
  {
    (let hp (| (arrivalPart m) (wordToArrival m)))
    (| (| hp (<< hp 20)) (ownerPart m))
  })

(pub :: fnStashMask (-> CG String Int))
(pub fn (fnStashMask cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigStash e)
      0)
  })

(pub :: fnRetMask (-> CG String Int))
(pub fn (fnRetMask cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigRet e)
      0)
  })

; The RET mask of `name` as the call `e` reads it. A type-variable
; result at a machine-scalar instantiation (`tyvarResultScalar`) is a
; number when the callee read it out of a parameter declared a
; reference - the owner half, a `(Vec Int)`'s element. The container
; holds a scalar without a share, so its release frees nothing the
; word points to, just as a scalar field's read is a number
; (`fieldReadIsScalar`). Those owner bits go; the arrival and word
; halves stay, because there the answer IS the argument or a word of
; it, whatever its type. Without this, an `Int` read out of a
; `(Vec Int)` kept the vector alive: `taskLoop`'s state vector, 160
; bytes a pool.
(pub :: callRetMask (-> CG ASTNode String Int))
(pub fn (callRetMask cg e name)
  {
    (let m (fnRetMask cg name))
    (if (== (ownerPart m) 0)
      m
      (if (== (tyvarResultScalar cg e) 1)
        (& m (^ (refParamOwnerBits cg name) (- 0 1)))
        m))
  })

; The owner bit of every parameter of `name` declared a reference
; (`fldClass` 2). Parameters from 19 on share one bit, so they are
; left out: a shared bit is dropped only when all of its parameters
; could be, which this does not ask.
(pub :: refParamOwnerBits (-> CG String Int))
(pub fn (refParamOwnerBits cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (match (fnArityCg cg name)
        ((None) 0)
        ((Some n)
          {
            (let mut i 0)
            (let mut m 0)
            {
              (while (&& (< i n) (< i 19))
                {
                  (if (== (parameterTypeClass cg (signatureParamTy (fsigTy e) i)) 2)
                    (set m (| m (ownerBit i))))
                  (set i (+ i 1))
                })
              m
            }
          }
        ))
      0)
  })

; The parameters this function CONSUMES - releases a share of, so the
; caller must not hand it back. `mapFree`'s `(__release (cast Int m))`
; is the shape: the body's release ends the caller's share exactly as
; a park would, but a park keeps the slot's share alive for the stash
; while a release leaves nothing - so this is its own summary beside
; `stash`, not a bit in it. `releaseRefParamSlotsFrom` reads the
; stash mask to SKIP the slot's return-path release, and skipping it
; for a consumed parameter would leak the entry retain; the consume
; mask is read only where a caller-side release is decided
; (`argOwnedRelease`, `callEscapesArg`), where parked and consumed
; agree. An `extern` item consumes nothing: the boundary contract
; borrows every argument.
(pub :: fnConsumeMask (-> CG String Int))
(pub fn (fnConsumeMask cg name)
  {
    (let eFound (findFSigCg cg (mangledForCg cg name)))
    (if (let (Some e) eFound)
      (fsigConsume e)
      0)
  })

; The mask of parameters whose reference may be (part of) `e`'s
; value, in the form it has here. `env` is an owning name/mask environment
; for `let` bindings and match binders.
(pub :: flowMask (-> CG ASTNode Names FlowEnv Int))
(pub fn (flowMask cg e params env)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        {
          (let found (envFlagOf env (nodeAName e)))
          (if (let (Some flag) found)
            (& flag (- MUST_BIT 1))
            (paramFlowBit cg params (paramIndexIn params (nodeAName e) 0)))
        }
        (if (== tg TAG_E_FIELD)
          ; a reference field is storage the base owns - a word of
          ; it is a word of the base; a scalar field is a number
          (if (== (fieldReadIsScalar cg e) 1)
            0
            (flowMask cg (nodeAChild e) params env))
          (if (== tg TAG_E_APP)
            (flowMaskApp cg e params env)
            (if (== tg TAG_E_IF)
              (| (flowMask cg (nodeBChild e) params env) (flowMask cg (nodeCChild e) params env))
              ; `cond` is AX2004: the parser builds none, so no arm
              ; masks one. A variadic `if` arrives as nested `if`s.
              (if (== tg TAG_E_MATCH)
                (flowMaskArms cg (nodeBChildren e) params env
                  (flowMask cg (nodeAChild e) params env) 0)
                (if (== tg TAG_E_BEGIN)
                  (if (== (vecLen (nodeAChildren e)) 0)
                    0
                    (flowMask cg (vecGet (nodeAChildren e) (- (vecLen (nodeAChildren e)) 1)) params
                      env))
                  (if (== tg TAG_E_LET)
                    (flowMask cg (nodeCChild e) params
                      (envWith env (nodeAName e) (letFlag cg (nodeBChild e) params env)))
                    (if (== tg TAG_E_LETM)
                      (flowMask cg (nodeCChild e) params
                        (envWith env (nodeAName e)
                          (mutFlag cg (nodeAName e) (nodeBChild e) (nodeCChild e) params env)))
                      (if (== tg TAG_E_HANDLE)
                        ; the body's value, or the handler's
                        (| (flowMask cg (nodeAChild e) params env)
                          (flowMask cg (nodeCChild e) params env))
                        (if (== tg TAG_E_SET)
                          ; `(set k v)` evaluates to `v`
                          (flowMask cg (nodeBChild e) params env)
                          0))))))))))
    }))

; A 64-bit load by name: the primitive, the compiler's own `memGetWord`
; and the standard library's `rawGetWord`, each one word at an address.
(pub :: isWordLoadName (-> String Bool))
(pub fn (isWordLoadName n)
  (|| (strEq n "__load64") (|| (strEq n "memGetWord") (strEq n "rawGetWord"))))

; What a raw store of `v` at `(addr, idx)` parks: `v`'s flow, except
; the words `v` reads back from that same slot. A word loaded from a
; slot and stored back into it, through any arithmetic, aliases nothing
; the slot did not already hold, so it parks nothing new. That is the
; read-modify-write of a block's shape word (`Mem.memMarkArray`,
; `Mem.memMarkLeaf`), whose address is an `Int` parameter and whose
; load would otherwise read as an owner word of whatever the caller
; passed - a `Vec`'s data block, which made every `vecPush` look like a
; park of its vector.
(pub :: rmwFlow (-> CG ASTNode ASTNode ASTNode Names FlowEnv Int))
(pub fn (rmwFlow cg v addr idx params env)
  (if (nodeSame v nilNode)
    0
    (if (!= (nodeTag v) TAG_E_APP)
      (flowMask cg v params env)
      {
        (let hd (spineHead v))
        (if (!= (nodeTag hd) TAG_E_VAR)
          (flowMask cg v params env)
          {
            (let n (nodeAName hd))
            (if (&& (isWordLoadName n)
                  (&& (== (spineArity v) 2)
                    (&& (== (sameExpr (spineArgAt v 0) addr) 1)
                      (== (sameExpr (spineArgAt v 1) idx) 1))))
              0
              (if (isBinop n)
                {
                  (let mut i 0)
                  (let mut m 0)
                  {
                    (while (< i (spineArity v))
                      {
                        (set m (| m (rmwFlow cg (spineArgAt v i) addr idx params env)))
                        (set i (+ i 1))
                      })
                    (toWord m)
                  }
                }
                (flowMask cg v params env)))
          })
      })))

; Two expressions that read the same place: the same name, the same
; integer, or the same head over the same arguments. Anything else
; answers 0, which keeps the full flow.
(pub :: sameExpr (-> ASTNode ASTNode Int))
(pub fn (sameExpr a b)
  (if (|| (nodeSame a nilNode) (nodeSame b nilNode))
    0
    (if (!= (nodeTag a) (nodeTag b))
      0
      {
        (let tg (nodeTag a))
        (if (== tg TAG_E_VAR)
          (if (strEq (nodeAName a) (nodeAName b))
            1
            0)
          (if (== tg TAG_E_INT)
            (if (== (nodeA a) (nodeA b))
              1
              0)
            (if (== tg TAG_E_APP)
              (if (!= (spineArity a) (spineArity b))
                0
                (if (== (sameExpr (spineHead a) (spineHead b)) 0)
                  0
                  {
                    (let mut i 0)
                    (let mut ok 1)
                    {
                      (while (&& (== ok 1) (< i (spineArity a)))
                        {
                          (set ok (sameExpr (spineArgAt a i) (spineArgAt b i)))
                          (set i (+ i 1))
                        })
                      ok
                    }
                  }))
              0)))
      })))

; Parameter i as it arrives: a typed reference or a type variable in
; the arrival form; a parameter declared a machine word (`Int`) is a
; word already - a header word or an owner word, the callee cannot
; tell which, so both - and a witness-directed store of it counts
; nothing (`strWrapOwned`'s `(memSetWord s 1 bytes)` parks `bytes`).
(pub :: paramFlowBit (-> CG Names Int Int))
(pub fn (paramFlowBit cg params i)
  (if (< i 0)
    0
    {
      (let d (cgCurDecl cg))
      (if (let (Some d) d)
        (if (|| (!= (vecLen params) (vecLen (nodeBNames d)))
              (if (strEq (as (vecGet params i) String) (as (vecGet (nodeBNames d) i) String))
                false
                true))
          (paramBit i)
          {
            (let eFound (findFSigCg cg (nodeAName d)))
            (if (let (Some e) eFound)
              (if (== (parameterTypeClass cg (signatureParamTy (fsigTy e) i)) 0)
                (| (wordBit i) (ownerBit i))
                (paramBit i))
              (paramBit i))
          })
        (paramBit i))
    }))

(pub :: flowMaskApp (-> CG ASTNode Names FlowEnv Int))
(pub fn (flowMaskApp cg e params env)
  {
    (let hd (spineHead e))
    (let n_ (spineArity e))
    (if (!= (nodeTag hd) TAG_E_VAR)
      (flowMaskAll cg e n_ params env 0)
      ; the named word-taking heads, and arithmetic on what they
      ; answer, hand the reference out as a WORD - `cast` its
      ; second argument, the rest every argument; every OTHER
      ; word, a load included, is a scalar: `strLen` is
      ; `memGetWord s 0` and is a length, and MM-LIFE-2g names
      ; the four heads as the whole of how a reference becomes a
      ; word
      {
        (let n (nodeAName hd))
        (if (isCastName n)
          (if (>= n_ 2)
            (toWord (aliasFlow cg (spineArgAt e 1) params env))
            0)
          (if (strEq n "__addr")
            (toWord (aliasFlowAll cg e n_ params env 0))
            (if (== (wordTakingHead hd) 1)
              ; `strData`, `strOwner`: the OWNER of whatever the
              ; operand aliases - a slice's owner is its parent's
              (toOwner (aliasFlowAll cg e n_ params env 0))
              (if (isBinop n)
                (toWord (flowMaskAll cg e n_ params env 0))
                (if (|| (isCmpOp n) (isAndOr n))
                  0
                  (if (isWordLoadName n)
                    ; a header word: word 0 of a String is its length, a
                    ; scalar; words past it are pointers into what the
                    ; address aliases - `strData` and `strOwner` hand-rolled.
                    ; A byte (`__load8`) is never a pointer
                    (if (&& (>= n_ 2)
                          (== (headerWordRead cg params (spineArgAt e 0) (spineArgAt e 1)) 1))
                      0
                      (if (>= n_ 1)
                        (toOwner (aliasFlow cg (spineArgAt e 0) params env))
                        0))
                    (if (isPrimName n)
                      0
                      (if (|| (isSome (envFlagOf env n)) (>= (paramIndexIn params n 0) 0))
                        ; A proven identity callback returns its own counted share.
                        (if (flowIdentityCallback cg n)
                          0
                          (flowMaskAll cg e n_ params env 0))
                        (if (hasFSigCg cg (mangledForCg cg n))
                          (if (== (fnResultClass cg n) 2)
                            ; a counted reference of its own (event 2)
                            0
                            (flowMaskSel cg e n_ params env (callRetMask cg e n) 0))
                          (if (hasType (cgTypes cg) n)
                            ; a construction is a fresh block
                            0
                            (flowMaskAll cg e n_ params env 0)))))))))))
      })
  })

; `flowMask` that looks THROUGH a reference-returning call or a
; construction to what its arguments carried - what the result may
; share storage with, for the word-taking heads: a slice shares its
; parent's bytes, a constructor holds its arguments.
(pub :: aliasFlow (-> CG ASTNode Names FlowEnv Int))
(pub fn (aliasFlow cg e params env)
  (| (flowMask cg e params env)
    (if (nodeSame e nilNode)
      0
      (if (!= (nodeTag e) TAG_E_APP)
        0
        {
          (let hd (spineHead e))
          (if (!= (nodeTag hd) TAG_E_VAR)
            0
            {
              (let n (nodeAName hd))
              (if (|| (isCastName n)
                    (|| (isPrimName n) (|| (isBinop n) (|| (isCmpOp n) (isAndOr n)))))
                0
                (if (|| (hasType (cgTypes cg) n) (== (fnResultClass cg n) 2))
                  (aliasFlowAll cg e (spineArity e) params env 0)
                  0))
            })
        }))))

(pub :: aliasFlowAll (-> CG ASTNode Int Names FlowEnv Int Int))
(pub fn (aliasFlowAll cg e n_ params env i)
  (if (>= i n_)
    0
    (| (aliasFlow cg (spineArgAt e i) params env) (aliasFlowAll cg e n_ params env (+ i 1)))))

; The address is a HANDLE - a name, a field, or a cast of one - so
; its word 0 is the header's length. An address computed by
; arithmetic (`(+ (cast Int s) 8)`) points anywhere, and its word 0
; is whatever lives there.
; Is `(__load64 addr idx)` a read of a NUMBER: word 0 of a String
; handle (its length), words 0, 1 and 3 of a `Vec` parameter (its
; length, capacity and ownership kind, `stdlib/Vec.ax`), or the count
; or shape word of any handle - `(- h 16)` at index 0 or 1, `(- h 8)`
; at index 0? Every other 64-bit load of a handle-relative address is
; a pointer the handle's block owns: a `Vec`'s word 2 is its data
; block, whose words are the elements.
(pub :: headerWordRead (-> CG Names ASTNode ASTNode Int))
(pub fn (headerWordRead cg params addr idx)
  (if (|| (nodeSame idx nilNode) (!= (nodeTag idx) TAG_E_INT))
    0
    {
      (let k (nodeA idx))
      (if (== (minusLiteral addr) 16)
        (if (&& (>= k 0) (&& (<= k 1) (== (addrIsHandle cg params (spineArgAt addr 0)) 1)))
          1
          0)
        (if (== (minusLiteral addr) 8)
          (if (&& (== k 0) (== (addrIsHandle cg params (spineArgAt addr 0)) 1))
            1
            0)
          (if (&& (== k 0) (== (addrIsHandle cg params addr) 1))
            1
            (if (&& (|| (== k 1) (== k 3)) (== (addrIsVecParam cg params addr) 1))
              1
              0))))
    }))

; A parameter declared `(Vec a)`, bare or under a `cast`.
(pub :: addrIsVecParam (-> CG Names ASTNode Int))
(pub fn (addrIsVecParam cg params e)
  (if (nodeSame e nilNode)
    0
    (if (== (nodeTag e) TAG_E_VAR)
      (if (== (paramIsHandle cg params (paramIndexIn params (nodeAName e) 0)) 2)
        1
        0)
      (if (== (nodeTag e) TAG_E_APP)
        {
          (let hd (spineHead e))
          (if (&& (== (nodeTag hd) TAG_E_VAR)
                (&& (isCastName (nodeAName hd)) (== (spineArity e) 2)))
            (addrIsVecParam cg params (spineArgAt e 1))
            0)
        }
        0))))

; `(- x LIT)`: the literal, or -1 for any other shape.
(pub :: minusLiteral (-> ASTNode Int))
(pub fn (minusLiteral e)
  (if (nodeSame e nilNode)
    (- 0 1)
    (if (!= (nodeTag e) TAG_E_APP)
      (- 0 1)
      {
        (let hd (spineHead e))
        (if (&& (== (nodeTag hd) TAG_E_VAR)
              (&& (strEq (nodeAName hd) "-")
                (&& (== (spineArity e) 2) (== (nodeTag (spineArgAt e 1)) TAG_E_INT))))
          (nodeA (spineArgAt e 1))
          (- 0 1))
      })))

(pub :: addrIsHandle (-> CG Names ASTNode Int))
(pub fn (addrIsHandle cg params e)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        ; a PARAMETER declared `String` or `Vec` - word 0 of either
        ; is its length; word 0 of a struct is its first field, and a
        ; `let` alias, a `mut` slot or an `Int` parameter may hold an
        ; address computed by arithmetic, which points anywhere
        (if (>= (paramIsHandle cg params (paramIndexIn params (nodeAName e) 0)) 1)
          1
          0)
        (if (== tg TAG_E_FIELD)
          (if (== (fieldReadIsScalar cg e) 1)
            0
            1)
          (if (== tg TAG_E_APP)
            {
              (let hd (spineHead e))
              (if (!= (nodeTag hd) TAG_E_VAR)
                0
                (if (&& (isCastName (nodeAName hd)) (== (spineArity e) 2))
                  (if (== (isRefCallNode cg (spineArgAt e 1)) 1)
                    ; a reference-returning call's answer or
                    ; a construction is a handle: its header
                    ; words are numbers
                    1
                    (addrIsHandle cg params (spineArgAt e 1)))
                  ; `(- handle 16)`, `(- handle 8)`: the block's
                  ; own count or shape word, a number; any other
                  ; offset is somewhere else
                  (if (&& (strEq (nodeAName hd) "-")
                        (&& (== (spineArity e) 2)
                          (&& (== (nodeTag (spineArgAt e 1)) TAG_E_INT)
                            (|| (== (nodeA (spineArgAt e 1)) 8) (== (nodeA (spineArgAt e 1)) 16)))))
                    (addrIsHandle cg params (spineArgAt e 0))
                    0)))
            }
            0)))
    }))

; OR over the spine's arguments, `n_` of them.
(pub :: flowMaskAll (-> CG ASTNode Int Names FlowEnv Int Int))
(pub fn (flowMaskAll cg e n_ params env i)
  (if (>= i n_)
    0
    (| (flowMask cg (spineArgAt e i) params env) (flowMaskAll cg e n_ params env (+ i 1)))))

; What a callee's RET mask makes of the arguments: a parameter it
; answers as it arrived keeps the argument's form; one it answers as a
; word launders it.
(pub :: flowMaskSel (-> CG ASTNode Int Names FlowEnv Int Int Int))
(pub fn (flowMaskSel cg e n_ params env mask i)
  (if (>= i n_)
    0
    (|
      {
        (let f (flowMask cg (spineArgAt e i) params env))
        (|
          (if (!= (& mask (paramBit i)) 0)
            f
            0)
          (|
            (if (!= (& mask (wordBit i)) 0)
              (toWord f)
              0)
            (if (!= (& mask (ownerBit i)) 0)
              (toOwner f)
              0)))
      }
      (flowMaskSel cg e n_ params env mask (+ i 1)))))

(pub :: flowMaskArms (-> CG (Vec ASTNode) Names FlowEnv Int Int Int))
(pub fn (flowMaskArms cg arms params env scrut i)
  (if (>= i (vecLen arms))
    0
    {
      (let arm (vecGet arms i))
      {
        (let bs (patBindersCg (nodeAChild arm) vecNew))
        (|
          (flowMask cg (nodeBChild arm) params
            (if (== (as bs Int) 0)
              env
              (envWithPat cg env (nodeAChild arm) scrut)))
          (flowMaskArms cg arms params env scrut (+ i 1)))
      }
    }))

; Walk the whole body and OR into `cell` word 0 the parameters some
; part of whose reference is parked beyond the frame uncounted, and
; into word 1 the ones `__retainref`/`__retain` counted.
(pub :: flowStashes (-> CG ASTNode Names FlowEnv Int Int))
(pub fn (flowStashes cg e params env cell)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_APP)
        (flowStashesApp cg e params env cell)
        (if (== tg TAG_E_FIELD)
          (flowStashes cg (nodeAChild e) params env cell)
          ; every arm is a REGION of its own: a `__retainref` that runs
          ; only on some path counts on that path only, and pairs with
          ; the stashes of that path (`strSlice` retains and parks under
          ; one branch) and never with a sibling's or the unconditional
          ; ones outside it
          (if (== tg TAG_E_IF)
            {
              (flowStashes cg (nodeAChild e) params env cell)
              (branchEnter cell)
              (flowStashes cg (nodeBChild e) params env cell)
              (branchLeave cell)
              (branchEnter cell)
              (flowStashes cg (nodeCChild e) params env cell)
              (branchLeave cell)
            }
            ; `cond` is AX2004: the parser builds none, so no arm
            ; stashes one. A variadic `if` arrives as nested `if`s.
            (if (== tg TAG_E_MATCH)
              {
                (flowStashes cg (nodeAChild e) params env cell)
                (flowStashesArms cg (nodeBChildren e) params env cell
                  (flowMask cg (nodeAChild e) params env) 0)
              }
              (if (== tg TAG_E_BEGIN)
                (flowStashesVec cg (nodeAChildren e) params env cell 0)
                (if (|| (== tg TAG_E_WHILE) (== tg TAG_E_REGION))
                  (if (== tg TAG_E_REGION)
                    ; a `region` body runs exactly once: transparent
                    (flowStashes cg (nodeBChild e) params env cell)
                    ; the condition runs once more than the body, and the
                    ; body may never run: two regions
                    {
                      (branchEnter cell)
                      (flowStashes cg (nodeAChild e) params env cell)
                      (branchLeave cell)
                      (branchEnter cell)
                      (flowStashesVec cg (nodeBChildren e) params env cell 0)
                      (branchLeave cell)
                    })
                  (if (== tg TAG_E_LET)
                    {
                      (flowStashes cg (nodeBChild e) params env cell)
                      (flowStashes cg (nodeCChild e) params
                        (envWith env (nodeAName e) (letFlag cg (nodeBChild e) params env)) cell)
                    }
                    (if (== tg TAG_E_LETM)
                      ; a `mut` slot is frame storage: it dies with the frame,
                      ; so what is put in it is parked only where a lambda
                      ; captures the slot's value (`lamCaptureMask`, through
                      ; the alias recorded here). Counted as a park, every
                      ; `(let ((mut t s)) ...)` marked `s` stashed, and a loop
                      ; never gave the slot's share back
                      {
                        (flowStashes cg (nodeBChild e) params env cell)
                        (flowStashes cg (nodeCChild e) params
                          (envWith env (nodeAName e)
                            (mutFlag cg (nodeAName e) (nodeBChild e) (nodeCChild e) params env))
                          cell)
                      }
                      (if (== tg TAG_E_SET)
                        (flowStashes cg (nodeBChild e) params env cell)
                        (if (== tg TAG_E_SETF)
                          {
                            (flowStashes cg (nodeAChild e) params env cell)
                            (flowStashes cg (nodeCChild e) params env cell)
                            ; a reference field retains (event 5); a word field parks
                            (if (== (fieldReadIsScalar cg e) 1)
                              (stashAdd cell (parkForms (flowMask cg (nodeCChild e) params env)))
                              0)
                          }
                          (if (== tg TAG_E_HANDLE)
                            ; the body in this region; the handler in one of its own -
                            ; a `handle` naming only built-in effects never evaluates
                            ; it (B is the Vec of effect names, not a node)
                            {
                              (flowStashes cg (nodeAChild e) params env cell)
                              (branchEnter cell)
                              (flowStashes cg (nodeCChild e) params env cell)
                              (branchLeave cell)
                            }
                            (if (== tg TAG_E_LAM)
                              ; a capture of a PARAMETER takes a share (event 4's
                              ; exception, `emitLambda`); a capture of a local that
                              ; aliases one takes none, and parks it
                              (stashAdd cell
                                (parkForms (lamCaptureMask cg (nodeBChild e) params env)))
                              (if (== tg TAG_E_STRUCTCON)
                                {
                                  (let entryFound (lookupType (cgTypes cg) (nodeAName e)))
                                  {
                                    (flowStashesVec cg (nodeBChildren e) params env cell 0)
                                    (if (let (Some entry) entryFound)
                                      (flowStashesFieldsVec cg entry (nodeBChildren e) params env
                                        cell 0)
                                      0)
                                  }
                                }
                                0)))))))))))))
    }))

; The region cell: word 0 the stashes pending in the open region
; (a child's, already netted against the child's own counts, joins
; its parent's on leave), word 1 the counts taken in the open region,
; word 2 a stack of the enclosing regions' (stash, count) pairs, and
; word 3 the CONSUMES pending in the open region - the parameters a
; `__release` in the region ends the caller's share of. A count
; cancels a stash when the count's region encloses the stash's: the
; same arm, or any region around it - that is every path the stash
; runs on. A count cancels a consume the same way and for a better
; reason: a retain paired with the release leaves the share intact,
; so the caller still owes its own. Word 3 rides the same
; enter/leave scoping as word 0, and nothing but a release ever
; writes it, so the final net reads it against word 1 exactly as
; `regionNet` reads word 0.
(pub :: regionNew Int)
(pub fn (regionNew)
  {
    (let cell (memAlloc 32))
    {
      (memSetWord cell 0 0)
      (memSetWord cell 1 0)
      (memSetWord cell 2 vecNew)
      (memSetWord cell 3 0)
      cell
    }
  })

(pub :: stashAdd (-> Int Int Int))
(pub fn (stashAdd cell m)
  {
    (memSetWord cell 0 (| (memGetWord cell 0) m))
    0
  })

; A count never lands on a SATURATED bit: parameters past index 18
; share bit 19 in every form, so a count of one would license a park
; of any other; the park stays, the leak direction.
(pub :: countedAdd (-> Int Int Int))
(pub fn (countedAdd cell m)
  {
    (memSetWord cell 1 (| (memGetWord cell 1) (& m unsaturated)))
    0
  })

(pub :: unsaturated Int)
(pub fn (unsaturated)
  (^ (- (<< 1 60) 1) (| (<< 1 19) (| (<< 1 39) (<< 1 59)))))

; The flow a COUNT is credited to: what the retained expression MUST
; be - the parameter itself, a `cast` of it, a `let` alias of one of
; those - and one parameter only. `(__retainref r.name)` retains the
; field, not the record `r` whose park it would otherwise cancel;
; `(__retainref (if c s t))` retains one of two, and cancels neither.
(pub :: countFlow (-> CG ASTNode Names FlowEnv Int))
(pub fn (countFlow cg e params env)
  {
    (let m (mustFlow cg e params env))
    (if (== (popcount (paramsOf m)) 1)
      m
      0)
  })

; The flow of `e` when `e` MUST be that: a parameter, a `let` alias
; recorded as must (`MUST_BIT` on its environment flag - its own
; initialiser was one of these), a `cast` of one; anything else - a
; field, a match binder, a join, a call - 0.
(pub :: mustFlow (-> CG ASTNode Names FlowEnv Int))
(pub fn (mustFlow cg e params env)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        {
          (let found (envFlagOf env (nodeAName e)))
          (if (let (Some flag) found)
            (if (!= (& flag MUST_BIT) 0)
              (& flag (- MUST_BIT 1))
              0)
            (paramFlowBit cg params (paramIndexIn params (nodeAName e) 0)))
        }
        (if (== tg TAG_E_APP)
          {
            (let hd (spineHead e))
            (if (!= (nodeTag hd) TAG_E_VAR)
              0
              {
                (let n (nodeAName hd))
                (if (&& (isCastName n) (== (spineArity e) 2))
                  (toWord (mustFlow cg (spineArgAt e 1) params env))
                  (if (&& (strEq n "__addr") (== (spineArity e) 1))
                    (toWord (mustFlow cg (spineArgAt e 0) params env))
                    ; the owner of one string is one block, and so
                    ; is its data pointer: `sysReadAll` counts
                    ; `(strOwner buf)` through a `let`
                    (if (&& (|| (strEq n "strData") (strEq n "strOwner")) (== (spineArity e) 1))
                      (toOwner (mustFlow cg (spineArgAt e 0) params env))
                      (if (&& (isWordLoadName n)
                            (&& (== (spineArity e) 2)
                              (&& (== (nodeTag (spineArgAt e 1)) TAG_E_INT)
                                (!= (nodeA (spineArgAt e 1)) 0))))
                        (toOwner (mustFlow cg (spineArgAt e 0) params env))
                        0))))
              })
          }
          0))
    }))

(pub :: MUST_BIT Int)
(pub fn (MUST_BIT)
  (<< 1 60))

; A `mut` slot's flow: its initialiser joined with every `(set name
; v)` in its scope - to a fixpoint, since a `set` may read the slot
; (`(set t (concat t "x"))`). The flag of the slot is what a park
; or an answer of it carries: `(let ((mut t 0)) { (set t (cast Int
; s)) (__store64 m 0 t) })` parks a header word of `s`.
;
; MEMOISED, because the walk is otherwise EXPONENTIAL in how many `mut`
; bindings nest. `setFlows`, `flowMask` and `flowStashes` each meet a
; `(let ((mut x i)) body)` by asking this for `x`'s flag - a walk of
; `body` per fixpoint pass - and then walk `body` again for their own
; question, so every enclosing `mut` at least doubles the walks of what
; is under it, and `inferFlows` repeats the lot on every pass. A
; `(let ((mut a ..) .. (mut i 0)) ..)` list is that many nested
; bindings: `pkgShaBlock` in `pkg.ax` (SHA-256, nine `mut` slots under
; a tenth) took one self-compile from 695,600 to 1,098,256 KiB on
; 2026-09-27 with byte-identical IR for everything else, and on
; synthetic nests of 8 / 10 / 12 `mut`s over a trivial loop the peak
; over an empty file was +2.2 / +9.8 / +39.8 MiB - x2 per binding.
;
; A binding's flag is a function of the binding, `params`, the `env` it
; is asked under, and the flow summaries, which `inferFlowsPass` writes
; between walks and never during one. So an answer is kept for as long
; as the summaries cannot move: for one outermost call of this
; function, or for the whole of a `mutMemoOpen` scope, which
; `inferFlowsPass` opens around each function's two walks. The second
; walk of a `body` then asks each binding under it the same question
; under the same `env` the first walk did, and reads the answer the
; first walk paid for. `env` compares name identity and flag values; its names are
; the AST's own strings, so an identical key binds the same names
; to the same flags, and a miss only costs the walk. The answers are
; the unmemoised walk's: the compiler's IR is byte-identical with and
; without it, and the nests above cost +0.3 / +0.4 / +0.4 MiB.
(pub :: mutFlag (-> CG String ASTNode ASTNode Names FlowEnv Int))
(pub fn (mutFlag cg name init body params env)
  {
    (let memo (mutMemoEntries cg))
    (let depth (cgMutMemoDepth cg))
    {
      (let found
        (:: (if (== depth 0)
          {
            (vecClear memo)
            None
          }
          (mutMemoFind memo name init body params env 0)) (Option MutMemoEntry)))
      (if (let (Some item) found)
        item.flag
        {
          (cgSetMutMemoDepth cg (+ depth 1))
          {
            (let f (mutFlagIter cg name body params env (flowMask cg init params env) 0))
            {
              (cgSetMutMemoDepth cg depth)
              (mutMemoAdd memo name init body params env f)
              f
            }
          }
        })
    }
  })

(struct MutMemoEntry
  (body : ASTNode)
  (init : ASTNode)
  (name : String)
  (params : Names)
  (env : FlowEnv)
  (flag : Int))

(:: mutMemoEntries (-> CG (Vec MutMemoEntry)))
(fn (mutMemoEntries cg)
  cg.pairState.mutMemo)

(pub :: mutMemoFind
  (-> (Vec MutMemoEntry) String ASTNode ASTNode Names FlowEnv Int (Option MutMemoEntry)))
(pub fn (mutMemoFind memo name init body params env at)
  (if (>= at (vecLen memo))
    None
    {
      (let item (vecGet memo at))
      (if (&& (nodeSame item.body body)
            (&& (nodeSame item.init init)
              (&& (addrEq (addrOf item.name) (addrOf name))
                (&& (addrEq (addrOf item.params) (addrOf params))
                  (&& (== (vecLen item.env) (vecLen env)) (== (mutMemoEnvEq item.env env 0) 1))))))
        (Some item)
        (mutMemoFind memo name init body params env (+ at 1)))
    }))

(pub :: mutMemoEnvEq (-> FlowEnv FlowEnv Int Int))
(pub fn (mutMemoEnvEq saved env i)
  (if (>= i (vecLen env))
    1
    {
      (let previous (vecGet saved i))
      (let current (vecGet env i))
      (if (&& (addrEq (addrOf previous.name) (addrOf current.name)) (== previous.flag current.flag))
        (mutMemoEnvEq saved env (+ i 1))
        0)
    }))

(pub :: mutMemoAdd (-> (Vec MutMemoEntry) String ASTNode ASTNode Names FlowEnv Int Int))
(pub fn (mutMemoAdd memo name init body params env flag)
  {
    (let snapshot (:: (vecAppendFrom env vecNew 0) FlowEnv))
    (vecPush memo
      (MutMemoEntry :body body :init init :name name :params params :env snapshot :flag flag))
    flag
  })

; A scope whose `mutFlag` answers are all kept: every walk inside it
; must see the same flow summaries and the same current declaration
; (word 36, which `paramFlowBit` reads; `params` is in the key).
; Scopes do not nest - `mutMemoClose` returns to "one outermost call".
(pub :: mutMemoOpen (-> CG Int))
(pub fn (mutMemoOpen cg)
  {
    (vecClear (mutMemoEntries cg))
    (cgSetMutMemoDepth cg 1)
    0
  })

(pub :: mutMemoClose (-> CG CG))
(pub fn (mutMemoClose cg)
  (cgSetMutMemoDepth cg 0))

(pub :: mutFlagIter (-> CG String ASTNode Names FlowEnv Int Int Int))
(pub fn (mutFlagIter cg name body params env f k)
  {
    (let f2 (| f (setFlows cg name body params (envWith env name f))))
    (if (|| (== f2 f) (>= k 6))
      f2
      (mutFlagIter cg name body params env f2 (+ k 1)))
  })

; OR of the flows of every `(set name v)` under `e`; a nested binding
; of the same name is not distinguished (conservative).
(pub :: setFlows (-> CG String ASTNode Names FlowEnv Int))
(pub fn (setFlows cg name e params env)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (|| (== tg TAG_E_INT)
            (|| (== tg TAG_E_FLT)
              (|| (== tg TAG_E_STR)
                (|| (== tg TAG_E_CHAR) (|| (== tg TAG_E_VAR) (== tg TAG_E_QUOTE))))))
        0
        (if (== tg TAG_E_SET)
          (|
            (if (strEq (nodeAName e) name)
              (flowMask cg (nodeBChild e) params env)
              0)
            (setFlows cg name (nodeBChild e) params env))
          (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
            (| (setFlows cg name (nodeAChild e) params env)
              (| (setFlows cg name (nodeBChild e) params env)
                (setFlows cg name (nodeCChild e) params env)))
            ; a binding's word 1 is its NAME, a String, not a node; the
            ; body sees the binding (`(set u t)` with `t` an inner alias
            ; of a word of a parameter)
            (if (== tg TAG_E_LET)
              (| (setFlows cg name (nodeBChild e) params env)
                (setFlows cg name (nodeCChild e) params
                  (envWith env (nodeAName e) (letFlag cg (nodeBChild e) params env))))
              (if (== tg TAG_E_LETM)
                (| (setFlows cg name (nodeBChild e) params env)
                  (setFlows cg name (nodeCChild e) params
                    (envWith env (nodeAName e)
                      (mutFlag cg (nodeAName e) (nodeBChild e) (nodeCChild e) params env))))
                (if (== tg TAG_E_SETF)
                  (| (setFlows cg name (nodeAChild e) params env)
                    (setFlows cg name (nodeCChild e) params env))
                  (if (== tg TAG_E_FIELD)
                    (setFlows cg name (nodeAChild e) params env)
                    (if (== tg TAG_E_BEGIN)
                      (setFlowsVec cg name (nodeAChildren e) params env 0)
                      ; `cond` is AX2004: the parser builds none, so
                      ; no arm flows one. A variadic `if` arrives as
                      ; nested `if`s.
                      (if (== tg TAG_E_MATCH)
                        (| (setFlows cg name (nodeAChild e) params env)
                          (setFlowsArms cg name (nodeBChildren e) params env
                            (flowMask cg (nodeAChild e) params env) 0))
                        (if (|| (== tg TAG_E_WHILE) (== tg TAG_E_REGION))
                          (if (== tg TAG_E_REGION)
                            (setFlows cg name (nodeBChild e) params env)
                            (| (setFlows cg name (nodeAChild e) params env)
                              (setFlowsVec cg name (nodeBChildren e) params env 0)))
                          (if (== tg TAG_E_LAM)
                            (setFlows cg name (nodeBChild e) params env)
                            (if (== tg TAG_E_STRUCTCON)
                              (setFlowsVec cg name (nodeBChildren e) params env 0)
                              (if (== tg TAG_E_HANDLE)
                                (| (setFlows cg name (nodeAChild e) params env)
                                  (setFlows cg name (nodeCChild e) params env))
                                0)))))))))))))
    }))

(pub :: setFlowsVec (-> CG String (Vec ASTNode) Names FlowEnv Int Int))
(pub fn (setFlowsVec cg name v params env i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (| (setFlows cg name (vecGet v i) params env) (setFlowsVec cg name v params env (+ i 1))))))

(pub :: setFlowsArms (-> CG String (Vec ASTNode) Names FlowEnv Int Int Int))
(pub fn (setFlowsArms cg name arms params env scrut i)
  (if (== (as arms Int) 0)
    0
    (if (>= i (vecLen arms))
      0
      {
        (let arm (vecGet arms i))
        (| (setFlows cg name (nodeBChild arm) params (envWithPat cg env (nodeAChild arm) scrut))
          (setFlowsArms cg name arms params env scrut (+ i 1)))
      })))

; A `let`'s environment flag: its flow, marked must when the
; initialiser must be what it flows from.
(pub :: letFlag (-> CG ASTNode Names FlowEnv Int))
(pub fn (letFlag cg init params env)
  {
    (let f (flowMask cg init params env))
    (if (!= (mustFlow cg init params env) 0)
      (| f MUST_BIT)
      f)
  })

(pub :: popcount (-> Int Int))
(pub fn (popcount m)
  (if (== m 0)
    0
    (+ (& m 1) (popcount (>> m 1)))))

; What the open region parks net of its own counts.
(pub :: regionNet (-> Int Int))
(pub fn (regionNet cell)
  (& (memGetWord cell 0) (^ (memGetWord cell 1) (- 0 1))))

(pub :: branchEnter (-> Int Int))
(pub fn (branchEnter cell)
  {
    (let stk (memGetWordVec cell 2))
    {
      (vecPush stk (memGetWord cell 0))
      (vecPush stk (memGetWord cell 1))
      (vecPush stk (memGetWord cell 3))
      (memSetWord cell 0 0)
      (memSetWord cell 1 0)
      (memSetWord cell 3 0)
      0
    }
  })

(pub :: branchLeave (-> Int Int))
(pub fn (branchLeave cell)
  ; read before the overwrites below: the branch's own words,
  ; not the outer region's
  {
    (let stk (memGetWordVec cell 2))
    (let net (regionNet cell))
    {
      (let n (vecLen stk))
      {
        (let outerStash (vecGet stk (- n 3)))
        (let outerCount (vecGet stk (- n 2)))
        (let outerConsume (vecGet stk (- n 1)))
        (let branchConsume (memGetWord cell 3))
        (let branchCount (memGetWord cell 1))
        {
          (vecPop stk)
          (vecPop stk)
          (vecPop stk)
          (memSetWord cell 0 (| outerStash net))
          (memSetWord cell 1 outerCount)
          ; the branch's consumes netted against the branch's counts,
          ; like the stashes: a retain paired with the release leaves
          ; the share intact. A release with no paired retain is a
          ; may-consume on every path through the branch, so it joins
          ; the outer region unconditionally.
          (memSetWord cell 3 (| outerConsume (& branchConsume (^ branchCount (- 0 1)))))
          0
        }
      }
    }
  })

(pub :: flowStashesVec (-> CG (Vec ASTNode) Names FlowEnv Int Int Int))
(pub fn (flowStashesVec cg v params env cell i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      {
        (flowStashes cg (vecGet v i) params env cell)
        (flowStashesVec cg v params env cell (+ i 1))
      })))

(pub :: flowStashesArms (-> CG (Vec ASTNode) Names FlowEnv Int Int Int Int))
(pub fn (flowStashesArms cg arms params env cell scrut i)
  (if (>= i (vecLen arms))
    0
    {
      (let arm (vecGet arms i))
      {
        (let bs (patBindersCg (nodeAChild arm) vecNew))
        {
          (branchEnter cell)
          (flowStashes cg (nodeBChild arm) params
            (if (== (as bs Int) 0)
              env
              (envWithPat cg env (nodeAChild arm) scrut))
            cell)
          (branchLeave cell)
          (flowStashesArms cg arms params env cell scrut (+ i 1))
        }
      }
    }))

; A call: what its arguments park, by the callee's own summary and
; each argument's FORM; a constructor: what its WORD fields park; a
; raw store: its value; a cast: nothing of itself (its consumer
; decides).
(pub :: flowStashesApp (-> CG ASTNode Names FlowEnv Int Int))
(pub fn (flowStashesApp cg e params env cell)
  {
    (let hd (spineHead e))
    (let n_ (spineArity e))
    (if (&& (== (nodeTag hd) TAG_E_VAR) (isAndOr (nodeAName hd)))
      ; `&&`/`||`: the first operand always runs, every later one
      ; only sometimes - each of those is a region of its own, so a
      ; count in one licenses no park outside it
      (flowStashesArgsRegions cg e n_ params env cell 0)
      {
        (flowStashesArgs cg e n_ params env cell 0)
        (selfSlotParks cg e hd n_ params env cell)
        (if (!= (nodeTag hd) TAG_E_VAR)
          ; a lambda applied where it stands, or a call answering a
          ; closure: the HEAD is walked for what it captures, and
          ; every argument is parked (a local function value)
          {
            (flowStashes cg hd params env cell)
            (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0)))
          }
          {
            (let n (nodeAName hd))
            (if (|| (isCastName n) (|| (isBinop n) (|| (isCmpOp n) (isAndOr n))))
              0
              (if (isPrimName n)
                (if (|| (strEq n "__store64") (strEq n "__store8"))
                  (if (>= n_ 3)
                    (stashAdd cell
                      (parkForms
                        (rmwFlow cg (spineArgAt e 2) (spineArgAt e 0) (spineArgAt e 1) params env)))
                    0)
                  (if (strEq n "__retainref")
                    ; counts a typed arrival; a word's witness is
                    ; `Int` and it retains nothing
                    (if (>= n_ 1)
                      (countedAdd cell (arrivalPart (countFlow cg (spineArgAt e 0) params env)))
                      0)
                    (if (strEq n "__retain")
                      ; counts the word it is given, whatever it was
                      (if (>= n_ 1)
                        (countedAdd cell (parkForms (countFlow cg (spineArgAt e 0) params env)))
                        0)
                      ; `__release` ends the caller's share of whatever
                      ; it is given: a release of a parameter is a
                      ; CONSUME, recorded in the cell's word 3 rather
                      ; than its stash word - the return path reads the
                      ; stash word to skip the slot's release, and a
                      ; consumed parameter's slot is still owed
                      ; (`fnConsumeMask`). A header form is widened to
                      ; both header forms, as a park is.
                      ;
                      ; An OWNER word is not the parameter: it is a block
                      ; the parameter's own block holds a share of - a
                      ; `Vec`'s data block or element, a table's old
                      ; array - and releasing it spends that block's
                      ; share, after the callee has replaced or zeroed
                      ; the word that named it (`vecDropAt`,
                      ; `vecReserveExactly`, `mapRehash`). The caller's
                      ; share of the parameter is untouched, so it is
                      ; not a consume, and counting it as one made
                      ; every `vecPush` look like a free of its vector.
                      (if (strEq n "__release")
                        (if (>= n_ 1)
                          {
                            (let m (flowMask cg (spineArgAt e 0) params env))
                            {
                              (let hp (| (arrivalPart m) (wordToArrival m)))
                              {
                                (memSetWord cell 3 (| (memGetWord cell 3) (| hp (<< hp 20))))
                                0
                              }
                            }
                          }
                          0)
                        ; `__axiom_recover` and `__axiom_stack_run` CALL
                        ; the closure they are handed, which is the same
                        ; claim `__call_word` makes about an address, so
                        ; they take the same conservative answer.
                        (if (|| (strEq n "__call_word")
                              (|| (strEq n "__axiom_recover") (strEq n "__axiom_stack_run")))
                          ; a function reached by address may park
                          ; what it is handed
                          (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0)))
                          0)))))
                (if (|| (isSome (envFlagOf env n)) (>= (paramIndexIn params n 0) 0))
                  (if (flowIdentityCallback cg n)
                    0
                    (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0))))
                  (if (hasFSigCg cg (mangledForCg cg n))
                    {
                      (stashAdd cell (stashSel cg e n_ params env (fnStashMask cg n) 0))
                      ; and what the callee CONSUMES, by the same
                      ; selection: a summary's consume bit for a
                      ; parameter ends the share handed there,
                      ; transitively, so the caller's own summary
                      ; inherits it (`fnConsumeMask`)
                      (memSetWord cell 3
                        (| (memGetWord cell 3)
                          (stashSel cg e n_ params env (fnConsumeMask cg n) 0)))
                      0
                    }
                    {
                      (let entryFound (lookupType (cgTypes cg) n))
                      (if (let (Some entry) entryFound)
                        (flowStashesFields cg entry e n_ params env cell 0)
                        ; an effect operation, or a name nothing signed
                        (stashAdd cell (parkForms (flowMaskAll cg e n_ params env 0))))
                    }))))
          })
      })
  })

(pub :: flowStashesArgsRegions (-> CG ASTNode Int Names FlowEnv Int Int Int))
(pub fn (flowStashesArgsRegions cg e n_ params env cell i)
  (if (>= i n_)
    0
    {
      (if (== i 0)
        (flowStashes cg (spineArgAt e i) params env cell)
        {
          (branchEnter cell)
          (flowStashes cg (spineArgAt e i) params env cell)
          (branchLeave cell)
        })
      (flowStashesArgsRegions cg e n_ params env cell (+ i 1))
    }))

; A call to the function being summarised: its `Int` parameters are
; SLOTS of the loop the self tail call becomes, and a word of a
; reference flowing into one is parked there uncounted - the boundary
; would release the old reference under it (`(i1 (concat ..) (cast
; Int s) (- n 1))`). Every self call is treated so; a non-tail one
; parks conservatively.
(pub :: selfSlotParks (-> CG ASTNode ASTNode Int Names FlowEnv Int Int))
(pub fn (selfSlotParks cg e hd n_ params env cell)
  {
    (let d (cgCurDecl cg))
    (if (let (Some d) d)
      (if (!= (nodeTag hd) TAG_E_VAR)
        0
        (if (if (strEq (mangledForCg cg (nodeAName hd)) (nodeAName d))
          false
          true)
          0
          {
            (let enFound (findFSigCg cg (nodeAName d)))
            (if (let (Some en) enFound)
              (selfSlotParksFrom cg e (fsigTy en) n_ params env cell 0)
              0)
          }))
      0)
  })

(pub :: selfSlotParksFrom (-> CG ASTNode (Option ASTNode) Int Names FlowEnv Int Int Int))
(pub fn (selfSlotParksFrom cg e sigTy n_ params env cell i)
  (if (>= i n_)
    0
    {
      (if (== (parameterTypeClass cg (signatureParamTy sigTy i)) 0)
        (stashAdd cell (parkForms (flowMask cg (spineArgAt e i) params env))))
      (selfSlotParksFrom cg e sigTy n_ params env cell (+ i 1))
    }))

; The arguments a callee's STASH summary parks, by position and form:
; an argument's arrival half is parked if the callee parks a typed
; arrival there, its word half if the callee parks a word there; a
; parked word is parked in both forms of what it was a word of.
(pub :: stashSel (-> CG ASTNode Int Names FlowEnv Int Int Int))
(pub fn (stashSel cg e n_ params env mask i)
  (if (>= i n_)
    0
    ; the callee's ARRIVAL bit is a STRONG park - whatever it is
    ; given is parked uncounted: a typed argument as it arrived,
    ; and a word of one of our parameters in every form, since a
    ; word laundered here is parked whatever form that parameter
    ; came in. Its WORD bits are WEAK - parked only when a word
    ; arrives, its typed arrival being counted: nothing of a typed
    ; argument, and a word argument in every form.
    ; The callee's ARRIVAL bit is a STRONG park - whatever it is
    ; given is parked uncounted - and so is its OWNER bit: an owner
    ; word is never what `__retainref` counted. Its HEADER bit is
    ; WEAK - parked only when a header word arrives, the typed
    ; arrival being counted: a word argument parks in its forms,
    ; and an arrival forwarded as itself (`(fn (put m x) (memSetWord
    ; m 0 x))`) inherits the weak bit, so a word handed to `put`
    ; two calls up is still seen.
    (|
      {
        (let f (flowMask cg (spineArgAt e i) params env))
        (|
          (if (!= (& mask (| (paramBit i) (ownerBit i))) 0)
            (parkForms f)
            0)
          (if (!= (& mask (wordBit i)) 0)
            (| (parkForms (argumentWordFlow cg (spineArgAt e i) f)) (arrivalToWord (arrivalPart f)))
            0))
      }
      (stashSel cg e n_ params env mask (+ i 1)))))

(pub :: flowStashesArgs (-> CG ASTNode Int Names FlowEnv Int Int Int))
(pub fn (flowStashesArgs cg e n_ params env cell i)
  (if (>= i n_)
    0
    {
      (flowStashes cg (spineArgAt e i) params env cell)
      (flowStashesArgs cg e n_ params env cell (+ i 1))
    }))

; A constructor's WORD fields (declared a machine scalar) park what
; is stored in them; reference fields retain (event 6), and a
; type-variable field retains under its witness when the value is a
; typed reference - a word laundered into one parks.
(pub :: flowStashesFields (-> CG TypeEntry ASTNode Int Names FlowEnv Int Int Int))
(pub fn (flowStashesFields cg entry e n_ params env cell i)
  (if (>= i n_)
    0
    {
      (let tn (fieldTypeNode entry i))
      (let f (flowMask cg (spineArgAt e i) params env))
      {
        (if (== (ctorFieldParks cg entry e tn i) 1)
          (stashAdd cell (parkForms f))
          (stashAdd cell
            (parkForms
              (retainedFieldWordFlow (fieldRetainCode cg entry (nodeTyChild (spineHead e)) i) f))))
        (flowStashesFields cg entry e n_ params env cell (+ i 1))
      }
    }))

(pub :: flowStashesFieldsVec (-> CG TypeEntry (Vec ASTNode) Names FlowEnv Int Int Int))
(pub fn (flowStashesFieldsVec cg entry args params env cell i)
  (if (>= i (vecLen args))
    0
    {
      (let tn (fieldTypeNode entry i))
      (let f (flowMask cg (vecGet args i) params env))
      {
        (if (match tn
          ((None) true)
          ((Some ty) (== (fldClass cg ty) 0)))
          (stashAdd cell (parkForms f))
          (stashAdd cell
            (parkForms (retainedFieldWordFlow (fieldRetainCode cg entry nilNode i) f))))
        (flowStashesFieldsVec cg entry args params env cell (+ i 1))
      }
    }))

; A counted field takes a share of a typed child reference, including
; a reference borrowed from a container. That share keeps the child
; alive without keeping the container itself. Its owner-flow bit must
; not turn `Some (vecGet entries i)` into an uncounted park of `entries`.
; Use the emitter's unconditional retain decision, including a constructor
; witness when a local variable has no separate expression type stamp.
; Header words and conditional or absent retains remain conservative.
(pub :: retainedFieldWordFlow (-> Int Int Int))
(pub fn (retainedFieldWordFlow retainCode flow)
  (if (== retainCode 1)
    (wordPart flow)
    (wordParts flow)))

; A weak park keeps raw words but counts a typed argument. A checked
; reference read from a container is that typed child, so the callee's
; share protects the child without keeping the source container. A
; missing stamp stays conservative; strong parks still keep all forms.
(pub :: argumentWordFlow (-> CG ASTNode Int Int))
(pub fn (argumentWordFlow cg argument flow)
  (if (== (fldClass cg (checkedValueTy argument)) 2)
    (wordPart flow)
    (wordParts flow)))

; The declared type node of field `j` of a constructor or struct
; entry, or None when the metadata is unavailable.
(pub :: fieldTypeNode (-> TypeEntry Int (Option ASTNode)))
(pub fn (fieldTypeNode entry j)
  (if (< j 0)
    None
    (match (eFieldTysVec entry)
      ((None) None)
      ((Some fields)
        (if (>= j (vecLen fields))
          None
          {
            (let ty
              (if (== (eKind entry) TF_DATA)
                (vecGet fields j)
                (nodeTyChild (vecGet fields j))))
            ; A field's packed type slot may still be unstamped.
            (if (nodeSame ty nilNode)
              None
              (Some ty))
          })
      ))))

; What a lambda body parks by capture: the `let`-bound locals it
; mentions, with their flows - a parameter captured directly takes a
; share (`emitLambda` retains reference parameters it captures).
(pub :: lamCaptureMask (-> CG ASTNode Names FlowEnv Int))
(pub fn (lamCaptureMask cg body params env)
  (| (lamCaptureFrom body env 0) (lamParamCaptures cg body params 0)))

; `emitLambda` retains a captured parameter only when its class is a
; reference (`retainParamCaps`): a type-variable or `Int` parameter
; is captured uncounted - parked.
(pub :: lamParamCaptures (-> CG ASTNode Names Int Int))
(pub fn (lamParamCaptures cg body params i)
  (if (>= i (vecLen params))
    0
    (|
      (if (&& (== (mentions (as (vecGet params i) String) body) 1)
            (!= (paramClassOf cg params i) 2))
        (parkForms (paramFlowBit cg params i))
        0)
      (lamParamCaptures cg body params (+ i 1)))))

; A call to a signed global whose result class is a reference, or a
; constructor application: what it answers is a handle.
(pub :: isRefCallNode (-> CG ASTNode Int))
(pub fn (isRefCallNode cg e)
  (if (nodeSame e nilNode)
    0
    (if (!= (nodeTag e) TAG_E_APP)
      0
      {
        (let hd (spineHead e))
        (if (!= (nodeTag hd) TAG_E_VAR)
          0
          {
            (let n (nodeAName hd))
            (if (|| (isCastName n)
                  (|| (isPrimName n) (|| (isBinop n) (|| (isCmpOp n) (isAndOr n)))))
              0
              (if (hasType (cgTypes cg) n)
                1
                (if (== (fnResultClass cg n) 2)
                  1
                  0)))
          })
      })))

; 1 for a parameter declared `String`, 2 for one declared `(Vec a)`, 0
; for anything else: the two handles whose header words this backend
; knows.
(pub :: paramIsHandle (-> CG Names Int Int))
(pub fn (paramIsHandle cg params i)
  (if (< i 0)
    0
    {
      (let d (cgCurDecl cg))
      (if (let (Some d) d)
        (if (|| (!= (vecLen params) (vecLen (nodeBNames d)))
              (if (strEq (as (vecGet params i) String) (as (vecGet (nodeBNames d) i) String))
                false
                true))
          0
          {
            (let eFound (findFSigCg cg (nodeAName d)))
            (if (let (Some e) eFound)
              (if (let (Some t) (signatureParamTy (fsigTy e) i))
                (if (== (nodeTag t) TAG_T_CON)
                  (if (strEq (nodeAName t) "String")
                    1
                    (if (strEq (nodeAName t) "Vec")
                      2
                      0))
                  0)
                0)
              0)
          })
        0)
    }))

(pub :: paramClassOf (-> CG Names Int Int))
(pub fn (paramClassOf cg params i)
  {
    (let d (cgCurDecl cg))
    (if (let (Some d) d)
      (if (!= (vecLen params) (vecLen (nodeBNames d)))
        2
        {
          (let eFound (findFSigCg cg (nodeAName d)))
          (if (let (Some e) eFound)
            (parameterTypeClass cg (signatureParamTy (fsigTy e) i))
            2)
        })
      2)
  })

(pub :: lamCaptureFrom (-> ASTNode FlowEnv Int Int))
(pub fn (lamCaptureFrom body env i)
  (if (>= i (vecLen env))
    0
    {
      (let binding (vecGet env i))
      (|
        (if (== (mentions binding.name body) 1)
          (& binding.flag (- MUST_BIT 1))
          0)
        (lamCaptureFrom body env (+ i 1)))
    }))

; The declared result class of the named global: `fldClass` of its
; signature's result - 0 a word, 2 a reference, 1 unclassifiable or
; a type variable, and -1 when there is no signature at all.
(pub :: fnResultClass (-> CG String Int))
(pub fn (fnResultClass cg name)
  (if (let (Some e) (findFSigCg cg (mangledForCg cg name)))
    (match (fnDeclaredResultTy (fsigTy e) (fsigArity e))
      ((None) 1)
      ((Some res) (fldClass cg res)))
    (- 0 1)))

; Does this expression's VALUE carry a share of its own that the
; frame holding it may hand back - or is it an immortal reference
; whose release is a no-op? A direct construction; a call to a
; signed global whose result is a reference, applied to exactly its
; arity, or a closure application whose checked result is a reference.
; Surplus arguments invoke the returned closure. A call is spelled with
; arguments OR bare: `(f)` with
; no arguments parses as the head alone, so a nullary call is a `VAR`
; node and is owned on the same terms; and the joins over `if`,
; `match`, `let` and a block. A match here is only as owned as its
; arms, and an arm answering a binder is not.
(pub :: valueOwnedRef (-> CG ASTNode Int))
(pub fn (valueOwnedRef cg e)
  (valueOwnedRefIn cg e vecNew))

; Joins are queried after emission restores their symbol scopes. Keep the
; bindings inside the expression so a local callback still resolves locally.
(:: valueOwnedRefIn (-> CG ASTNode FlowEnv Int))
(fn (valueOwnedRefIn cg e env)
  (if (nodeSame e nilNode)
    0
    (if (== (nodeResWord e) 3)
      (valueOwnedRefIn cg (nodeBChild e) env)
      {
        (let tg (nodeTag e))
        (let head
          (if (== tg TAG_E_APP)
            (spineHead e)
            nilNode))
        (let localHead
          (if (nodeSame head nilNode)
            false
            (&& (== (nodeTag head) TAG_E_VAR)
              (&& (!= (nodeDefScope head) 1) (isSome (envFlagOf env (nodeAName head)))))))
        (if (&& (! localHead) (== (argIsDirectCon cg e) 1))
          1
          (if (== tg TAG_E_STR)
            1
            (if (== tg TAG_E_VAR)
              {
                (let name (nodeAName e))
                (let scoped
                  (:: (if (== (nodeDefScope e) 1)
                    None
                    (envFlagOf env name)) (Option Int)))
                (if (let (Some flag) scoped)
                  flag
                  (if (&& (!= (nodeDefScope e) 1) (isLocalValue cg name))
                    0
                    (if (hasType (cgTypes cg) name)
                      1
                      (if (|| (isCastName name) (isPrimName name))
                        0
                        {
                          (let full (mangledForCg cg name))
                          ; A non-nullary function names an immortal descriptor.
                          ; Like a static string, it permits owned joins; a
                          ; release is a no-op. A nullary name makes a call.
                          (if (isDefinedFnCg cg full)
                            1
                            (if (&& (isNullaryFnCg cg full) (== (fnResultClass cg name) 2))
                              1
                              0))
                        }))))
              }
              (if (== tg TAG_E_APP)
                (if (|| localHead (closureOwnedCall cg e))
                  (if (== (fldClass cg (checkedValueTy e)) 2)
                    1
                    0)
                  (if (!= (nodeTag head) TAG_E_VAR)
                    (if (== (fldClass cg (checkedValueTy e)) 2)
                      1
                      0)
                    {
                      (let name (nodeAName head))
                      (if (!= (fnResultClass cg name) 2)
                        0
                        (if (|| (isCastName name)
                              (|| (isPrimName name)
                                (&& (!= (nodeDefScope head) 1) (isLocalValue cg name))))
                          0
                          (if (hasType (cgTypes cg) name)
                            0
                            (if (fnArityMatches cg name (spineArity e))
                              1
                              0))))
                    }))
                (if (== tg TAG_E_IF)
                  (if (== (valueOwnedRefIn cg (nodeBChild e) env) 1)
                    (valueOwnedRefIn cg (nodeCChild e) env)
                    0)
                  (if (== tg TAG_E_MATCH)
                    (valueOwnedRefArms cg (nodeBChildren e) env 0)
                    (if (== tg TAG_E_LET)
                      (valueOwnedRefIn cg (nodeCChild e)
                        (envWith env (nodeAName e) (valueOwnedRefIn cg (nodeBChild e) env)))
                      (if (== tg TAG_E_LETM)
                        (valueOwnedRefIn cg (nodeCChild e) (envWith env (nodeAName e) 0))
                        (if (== tg TAG_E_BEGIN)
                          (if (== (vecLen (nodeAChildren e)) 0)
                            0
                            (valueOwnedRefIn cg
                              (vecGet (nodeAChildren e) (- (vecLen (nodeAChildren e)) 1)) env))
                          0)))))))))
      })))

(pub :: valueOwnedRefArms (-> CG (Vec ASTNode) FlowEnv Int Int))
(pub fn (valueOwnedRefArms cg arms env i)
  (if (>= i (vecLen arms))
    (if (== i 0)
      0
      1)
    {
      (let arm (vecGet arms i))
      (let binders (patBindersCg (nodeAChild arm) vecNew))
      (if (== (as binders Int) 0)
        0
        (if (== (valueOwnedRefIn cg (nodeBChild arm) (envWithAll env binders 0)) 1)
          (valueOwnedRefArms cg arms env (+ i 1))
          0))
    }))

; ------------------------------------------------------------------
; MM-LIFE-2d evidence, emission side. A polymorphic function - one
; whose signature has a type variable in a PARAM position - takes
; one hidden trailing `i64 %__evw.h`; every direct call to it passes
; the word the checker's stamp describes: constant bits, plus
; `(lshr caller-word, k) & 1` per symbolic entry. The register and
; its symbol-table name both contain a dot, which no Axiom
; identifier can spell - collision with user code is impossible by
; construction, so no reserved-name diagnostic exists for it.
;
; The walk below mirrors typecheck's `sigTyVarsInto` over the SAME
; D_SIG tree (FSig now carries it): one ordering convention, two
; implementations, pinned against each other by the evidence fixture.
; Only the WALK is duplicated on purpose - the leaf predicates it
; needs are shared: `tyIsSrcVar` is `parser.ax`'s, `strVecHas` and
; `strVecIdx` are `core.ax`'s. So what the fixture compares is two
; orderings, not two copies of a list search.
; ------------------------------------------------------------------
(pub :: cgSigVarsInto (-> ASTNode Names Int))
(pub fn (cgSigVarsInto t acc)
  (if (nodeSame t nilNode)
    0
    {
      (let tg (nodeTag t))
      (if (== tg TAG_T_VAR)
        (if (== (tyIsSrcVar t) 1)
          (if (== (strVecHas acc (nodeAName t)) 1)
            0
            {
              (vecPush acc (nodeAName t))
              0
            })
          0)
        (if (== tg TAG_T_CON)
          (cgSigVarsVec (nodeBChildren t) acc)
          (if (== tg TAG_T_ARR)
            {
              (cgSigVarsInto (nodeAChild t) acc)
              (cgSigVarsInto (nodeBChild t) acc)
            }
            (if (== tg TAG_T_TUP)
              (cgSigVarsVec (nodeAChildren t) acc)
              (if (== tg TAG_T_PTR)
                (cgSigVarsInto (nodeAChild t) acc)
                0)))))
    }))

(pub :: cgSigVarsVec (-> Nodes Names Int))
(pub fn (cgSigVarsVec xs acc)
  (if (== (as xs Int) 0)
    0
    {
      (let mut i 0)
      {
        (while (< i (vecLen xs))
          {
            (cgSigVarsInto (vecGet xs i) acc)
            (set i (+ i 1))
          })
        0
      }
    }))

(pub :: cgParamPosVars (-> ASTNode Names Int))
(pub fn (cgParamPosVars t acc)
  (if (&& (! (nodeSame t nilNode)) (== (nodeTag t) TAG_T_ARR))
    {
      (cgSigVarsInto (nodeAChild t) acc)
      (cgParamPosVars (nodeBChild t) acc)
    }
    0))

; A signature whose every variable is return-only takes no word: no
; param position can ever witness one, so the bits would be zeros
; forever - which exempts the hottest accessors (memGetWord, vecGet,
; nodeA/B/C) from the extra argument outright.
(pub :: cgTakesEvidence (-> ASTNode Int))
(pub fn (cgTakesEvidence t)
  (if (nodeSame t nilNode)
    0
    {
      (let acc vecNew)
      {
        (cgParamPosVars t acc)
        (if (> (vecLen acc) 0)
          1
          0)
      }
    }))

; memoized at scan time - a walk and a Vec per CALL was 14 MiB of
; the bootstrap gate's self-compile ceiling
(pub :: fnTakesEvw (-> CG String Int))
(pub fn (fnTakesEvw cg full)
  {
    (let eFound (findFSigCg cg full))
    (if (let (Some e) eFound)
      (fsigTakesEv e)
      0)
  })

; A stamp is a function of the node alone: a macro-spliced argument
; node is a shared object, so a stamp written while checking one
; declaration must not steer emission inside another. The stamp
; carries its author; a mismatch demotes to no-stamp (all zeros -
; the conservative direction).
(pub :: evStampOk (-> CG ASTNode ASTNode))
(pub fn (evStampOk cg stamp)
  (if (nodeSame stamp nilNode)
    nilNode
    (if (!= (nodeTag stamp) TAG_EVSTAMP)
      nilNode
      (if (cgDeclarationMatches cg (nodeAChild stamp))
        stamp
        nilNode))))

; Read the enclosing function's own evidence word into field 2 - the
; direct param register, or a load when TCO parked it in a slot. A
; monomorphic caller answers the constant 0 (unreachable from a
; checked stamp; defensive).
; The LIFTED LAMBDA's own evidence word - what its application passed,
; not what its enclosing function knows. A body with no such symbol
; answers the constant 0, which under-retains and therefore leaks; that
; is the honest answer for a lambda reached without one.
; The symbol holding the lambda-argument evidence word `d` levels out.
; Depth 0 is this lambda's own hidden parameter; above it are the words
; of the enclosing lambdas, captured into this one's record by
; `bindCaps`, which shifts each name one level as it binds.
;
; `(lambda (a b) ..)` is `(lambda (a) (lambda (b) ..))` by the parser,
; so a store of `a` runs inside the INNER lambda and `a` is a capture
; there. Its class is the word the OUTER application passed, one level
; out - and until 2026-08-30 nothing carried it, which was a live
; use-after-free and not the leak this file recorded.
(pub :: evwaSym (-> Int String))
(pub fn (evwaSym d)
  (if (<= d 0)
    "__evwa."
    (concat "__evwa." (fmtInt d))))

(pub :: emitEvwaRead (-> CG Int CG))
(pub fn (emitEvwaRead cg d)
  (match (symIndex cg (evwaSym d))
    ((None)
      {
        (cgSetResult cg (constStr 0))
        cg
      }
    )
    ((Some symIdx)
      {
        (cgSetResult cg (strDup (symRegAt cg symIdx)))
        cg
      }
    )))

(pub :: emitEvwRead (-> CG CG))
(pub fn (emitEvwRead cg)
  (match (symIndex cg "__evw.")
    ((None)
      {
        (cgSetResult cg (constStr 0))
        cg
      }
    )
    ((Some symIdx)
      (if (>= (lookupSymKind cg "__evw.") 1)
        {
          (let rn (allocReg cg))
          {
            (let r (regStr rn))
            {
              (emitLine cg
                (concat (concat "  " r)
                  (concat " = load i64, ptr " (concat (strDup (symRegAt cg symIdx)) ""))))
              (cgSetResult cg r)
              cg
            }
          }
        }
        {
          (cgSetResult cg (strDup (symRegAt cg symIdx)))
          cg
        })
    )))

; The callee's evidence word from a validated stamp: constant bits
; first (bit 63 via `shl 1, 63` - a literal with the sign bit set
; would pass through fmtInt, which renders negatives wrong), then
; one lshr/and/shl/or chain per symbolic entry. Answers cg with the
; value string in field 2. An absent stamp answers "0".
(pub :: emitEvWordVal (-> CG ASTNode CG))
(pub fn (emitEvWordVal cg stamp)
  (if (nodeSame stamp nilNode)
    {
      (cgSetResult cg (constStr 0))
      cg
    }
    ; A witness of `EV_LAMARG` (-2) is the enclosing LIFTED LAMBDA's
    ; own argument: its class is not known here and not known where
    ; the lambda was built, only where the closure was APPLIED. The
    ; word that application passed is `%__evwa.h`, and bit 0 of it is
    ; the answer - one bit, because a lifted lambda absorbs exactly
    ; one argument.
    {
      (let w (nodeBWords stamp))
      (let mut c 0)
      (let mut hasHigh 0)
      (let mut hasSym 0)
      (let mut hasLam 0)
      {
        {
          (let mut i 0)
          (while (< i (vecLen w))
            {
              {
                (let v (vecGet w i))
                (if (== v 1)
                  (if (>= i 63)
                    (set hasHigh 1)
                    (set c (+ c (pow2 i))))
                  (if (>= (as v Int) 2)
                    (set hasSym 1)
                    (if (<= (as v Int) (- 0 2))
                      (set hasLam 1))))
              }
              (set i (+ i 1))
            })
        }
        (if (&& (== hasLam 0) (&& (== hasSym 0) (== hasHigh 0)))
          {
            (cgSetResult cg (constStr c))
            cg
          }
          {
            (let cgR
              (if (== hasSym 1)
                (emitEvwRead cg)
                cg))
            {
              (let src
                (if (== hasSym 1)
                  (strDup (cgResult cgR))
                  ""))
              {
                (let cgL cgR)
                {
                  (let mut acc (constStr c))
                  (let mut cgX cgL)
                  {
                    (if (== hasHigh 1)
                      {
                        (let hn (allocReg cgX))
                        {
                          (let hr (regStr hn))
                          {
                            (let cgH (emitLine cgX (concat (concat "  " hr) " = shl i64 1, 63")))
                            {
                              (let on (allocReg cgH))
                              {
                                (let orr (regStr on))
                                {
                                  (set cgX (emitLine cgH
                                             (concat
                                               (concat (concat "  " orr) (concat " = or i64 " acc))
                                               (concat ", " (concat hr "")))))
                                  (set acc orr)
                                }
                              }
                            }
                          }
                        }
                      })
                    {
                      (let mut i2 0)
                      (while (< i2 (vecLen w))
                        {
                          {
                            (let v2 (as (vecGet w i2) Int))
                            (if (>= v2 2)
                              {
                                (let k (- v2 2))
                                {
                                  (let an (allocReg cgX))
                                  {
                                    (let ar (regStr an))
                                    {
                                      (let cgA
                                        (emitLine cgX
                                          (concat
                                            (concat (concat "  " ar) (concat " = lshr i64 " src))
                                            (concat ", " (concat (constStr k) "")))))
                                      {
                                        (let bn (allocReg cgA))
                                        {
                                          (let br (regStr bn))
                                          {
                                            (let cgB
                                              (emitLine cgA
                                                (concat (concat "  " br)
                                                  (concat " = and i64 " (concat ar ", 1")))))
                                            {
                                              (let sn (allocReg cgB))
                                              {
                                                (let sr (regStr sn))
                                                {
                                                  (let cgS
                                                    (emitLine cgB
                                                      (concat
                                                        (concat (concat "  " sr)
                                                          (concat " = shl i64 " br))
                                                        (concat ", " (concat (constStr i2) "")))))
                                                  {
                                                    (let on2 (allocReg cgS))
                                                    {
                                                      (let or2 (regStr on2))
                                                      {
                                                        (set cgX (emitLine cgS
                                                                   (concat
                                                                     (concat (concat "  " or2)
                                                                       (concat " = or i64 " acc))
                                                                     (concat ", " (concat sr "")))))
                                                        (set acc or2)
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              (if (<= v2 (- 0 2))
                                {
                                  (let cgLr (emitEvwaRead cgX (- (- 0 2) v2)))
                                  {
                                    (let lamSrc (strDup (cgResult cgLr)))
                                    {
                                      (let bn3 (allocReg cgLr))
                                      {
                                        (let br3 (regStr bn3))
                                        {
                                          (let cgB3
                                            (emitLine cgLr
                                              (concat (concat "  " br3)
                                                (concat " = and i64 " (concat lamSrc ", 1")))))
                                          {
                                            (let sn3 (allocReg cgB3))
                                            {
                                              (let sr3 (regStr sn3))
                                              {
                                                (let cgS3
                                                  (emitLine cgB3
                                                    (concat
                                                      (concat (concat "  " sr3)
                                                        (concat " = shl i64 " br3))
                                                      (concat ", " (concat (constStr i2) "")))))
                                                {
                                                  (let on3 (allocReg cgS3))
                                                  {
                                                    (let or3 (regStr on3))
                                                    {
                                                      (set cgX (emitLine cgS3
                                                                 (concat
                                                                   (concat (concat "  " or3)
                                                                     (concat " = or i64 " acc))
                                                                   (concat ", " (concat sr3 "")))))
                                                      (set acc or3)
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }))
                          }
                          (set i2 (+ i2 1))
                        })
                    }
                    (cgSetResult cgX acc)
                    cgX
                  }
                }
              }
            }
          })
      }
    }))

; Numeric representation is a checked type fact, including for functions
; without a written signature. It does not establish ownership or effects.
(struct FunctionFloatIndex
  (names : InternState)
  (flags : (Vec Ints)))

(:: functionFloatIndex (-> FunctionTypes FunctionFloatIndex))
(fn (functionFloatIndex types)
  {
    (let names internNewTyped)
    (let flags vecNew)
    (for entry in types
      {
        (let id (internIntern (internWordOf names) (declSpellingOf entry.name)))
        (if (== id (vecLen flags))
          (vecPush flags (functionFloatFlags entry.ty entry.arity vecNew)))
      })
    (FunctionFloatIndex :names names :flags flags)
  })

; Stop at the definition's arity: a returned function is one word.
; Resolve inference pins at every arrow position before classifying it.
(:: functionFloatFlags (-> ASTNode (Option Int) Ints Ints))
(fn (functionFloatFlags ty arity flags)
  {
    (let resolved (tyResolve ty))
    (if (let (Some count) arity)
      (if (<= count 0)
        (vecPush flags (tyIsBareFloat resolved))
        (if (== (nodeTag resolved) TAG_T_ARR)
          {
            (vecPush flags (tyIsBareFloat (tyResolve (nodeAChild resolved))))
            (functionFloatFlags (nodeBChild resolved) (Some (- count 1)) flags)
          }
          {
            (vecPush flags 0)
            (functionFloatFlags resolved (Some (- count 1)) flags)
          }))
      ; Unknown arity keeps the existing whole-value representation fact.
      (vecPush flags (tyIsBareFloat resolved)))
  })

(:: checkedFloatFlags (-> CG String (Option Ints)))
(fn (checkedFloatFlags cg name)
  (if (let (Some index) (cgFunctionFloats cg))
    (if (let (Some id) (internFind (internWordOf index.names) (declSpellingOf name)))
      (Some (vecGet index.flags id))
      (None))
    (None)))

; Partial compiler clients can still consult the written signature table.
(:: functionFlags (-> CG String (Option Ints)))
(fn (functionFlags cg name)
  (if (let (Some flags) (checkedFloatFlags cg name))
    (Some flags)
    (if (let (Some entry) (findFSigCg cg name))
      (fsigFlags entry)
      (None))))

; Whether function `name` (already mangled) returns a bare float.
(pub :: fnRetIsFloat (-> CG String Int))
(pub fn (fnRetIsFloat cg name)
  (if (let (Some flags) (functionFlags cg name))
    (if (== (vecLen flags) 0)
      0
      (vecGet flags (- (vecLen flags) 1)))
    0))

; Whether parameter `idx` of the function being emitted is a float. The
; last flag is the return type, so a bare-type signature has no
; parameter flags at all.
(pub :: paramIsFloat (-> CG Int Int))
(pub fn (paramIsFloat cg idx)
  (if (let (Some flags) (cgParamFlags cg))
    (if (>= idx (- (vecLen flags) 1))
      0
      (vecGet flags idx))
    (lambdaParamIsFloat (cgLambdaType cg) idx)))

; A lifted lambda has a checked arrow rather than a named function's
; flag vector. Read the parameter through its pins, which may have
; been fixed by a later call before the body reaches emission.
(:: lambdaResultType (-> (Option ASTNode) (Option ASTNode)))
(fn (lambdaResultType signature)
  (match signature
    ((None) None)
    ((Some arrow) (cgTypeNodeOpt (nodeBChild arrow)))))

(pub :: lambdaParamIsFloat (-> (Option ASTNode) Int Int))
(pub fn (lambdaParamIsFloat signature i)
  (match signature
    ((None) 0)
    ((Some arrow)
      {
        (let ty (tyResolve arrow))
        (if (!= (nodeTag ty) TAG_T_ARR)
          0
          (if (<= i 0)
            (tyIsBareFloat (tyResolve (nodeAChild ty)))
            (lambdaParamIsFloat (cgTypeNodeOpt (nodeBChild ty)) (- i 1))))
      }
    )))

(pub :: paramFloatByName (-> CG String Int))
(pub fn (paramFloatByName cg name)
  (if (let (Some params) (cgParams cg))
    (paramFloatIdx cg params name 0)
    0))

(pub :: paramFloatIdx (-> CG Names String Int Int))
(pub fn (paramFloatIdx cg params name i)
  (if (>= i (vecLen params))
    0
    (if (strEq (vecGetStr params i) name)
      (paramIsFloat cg i)
      (paramFloatIdx cg params name (+ i 1)))))

; ------------------------------------------------------------------
; Macros were expanded HERE, at emit time, by a substituter that lived
; in this file. They are expanded in `core/expand.ax` now, as a
; pass between import resolution and the checker, and this file no
; longer knows what a macro is. Its header records what the move was
; worth; the short version is that emitting an expansion is too late
; to type-check it, and everything a macro generated was therefore
; unchecked.
;
; Field 19 of `CG` held the macro table and is left in place rather
; than reclaimed, for the reason the retired TAG_D_FOREIGN tag number
; is left vacant: a retired slot costs a word, and a recycled one
; turns a stale reader into a silent wrong answer.
; ------------------------------------------------------------------
(pub :: emitLine (-> CG String CG))
(pub fn (emitLine cg line)
  {
    ; vecPush keeps its header even when its data grows. The context
    ; already owns that header; storing it again would retain another
    ; share on every line. Keep the byte copy: callers may reuse their
    ; mutable input after this snapshot has been appended.
    (vecPush (cgLines cg) (strDup line))
    cg
  })

(pub :: allocReg (-> CG Int))
(pub fn (allocReg cg)
  {
    (let n (cgTmp cg))
    {
      (cgSetTmp cg (+ n 1))
      n
    }
  })

; Integer formatting is `Fmt.fmtInt`. The copy that used to live here
; negated with `(- 0 n)`, which is a no-op on the most negative Int and
; recursed forever on it - the very bug Fmt.ax records having found and
; fixed. One formatter, one fix.
; ------------------------------------------------------------------
; Render accumulated lines into one string.
;
; MEASURE THE WHOLE OUTPUT FIRST, THEN ALLOCATE ONCE.
;
; This used to left-fold `concat` over the line vector, which is one
; allocation and one full copy of everything emitted so far per line -
; quadratic in the output, and it was the compiler's dominant cost by an
; enormous margin. `concat` allocates from a bump allocator that
; never frees, so nothing is reclaimed between iterations either, and
; the peak is the SUM of every intermediate rather than the largest one.
; Measured on the compiler compiling its own source (1,111,426 bytes of
; IR over 32,593 lines), with `/usr/bin/time -l`:
;
;   fold:  16,973,342,080 bytes peak footprint, 15.63 s
;   join:  see the self-hosting record - two orders of magnitude less
;
; The law is peak ~= (bytes x lines) / 2, so the cost grew with the
; SQUARE of the compiler's own size: every module added to `core/`
; paid for itself twice. That is a bad shape for a self-hosted compiler
; to have, independently of the absolute number.
;
; The replacement is the same walk twice - once to add up the lengths,
; once to copy - so it allocates exactly one buffer of exactly the right
; size. Both walks are `while` loops rather than self tail calls for the
; reason `stdlib/Mem.ax` records at length: their depth is the size of
; the data, and stage1 emits no tail-call elimination, so the recursive
; spelling is a real call chain one frame deep per line.
; ------------------------------------------------------------------
(pub :: renderCG (-> CG String))
(pub fn (renderCG cg)
  (joinLines (cgLines cg)))

; The exact size of the joined result: every line plus its newline.
(pub :: joinSize (-> Strings Int))
(pub fn (joinSize lines)
  {
    (let mut i 0)
    (let mut n 0)
    {
      (while (< i (vecLen lines))
        {
          (set n (+ n (+ (strLen (vecGet lines i)) 1)))
          (set i (+ i 1))
        })
      n
    }
  })

(pub :: joinLines (-> Strings String))
;@axiom:effect(unsafe)
(pub fn (joinLines lines)
  {
    (let out (strAlloc (joinSize lines)))
    (let mut i 0)
    (let mut off 0)
    {
      (while (< i (vecLen lines))
        {
          (let line (vecGet lines i))
          {
            (memCopy (+ (strData out) off) (strData line) (strLen line))
            (set off (+ off (strLen line)))
            (__store8 (strData out) off 10)
            (set off (+ off 1))
            (set i (+ i 1))
          }
        })
      out
    }
  })

; ------------------------------------------------------------------
; Names the emitter invents.
;
; A function body holds two kinds of LLVM local: the ones the SOURCE
; named - every parameter is `%` + `llvmSym name`, in the header, in
; `allocParamSlots`, in `retainRefParams` and in `emitVar` - and the
; ones this file makes up: the temporaries, the block labels, the
; typed intermediates (`d` for a double, `c` for an i1, `f` for a
; function pointer, `p`/`g` for a pointer and its element, `s` for a
; parameter's slot), a lambda's hidden environment word, a thunk's
; forwarded arguments. LLVM keeps ONE namespace per function for all
; of them, so a scheme that can spell a source name is a collision
; waiting for the program that writes it: `(fn (f t0) (+ t0 1))`
; passed `check` and died in `opt` with `multiple definition of local
; value named 't0'`, reported as AX4003 against the toolchain - and a
; parameter named `label_3`, `f1`, `c0`, `d0` or `p1`, or a lambda
; parameter named `_env`, did the same
; (tests/selfhost/955-source-names-vs-emitter-names.ax).
;
; The two are kept apart BY CONSTRUCTION, not by a list of reserved
; spellings: every name made here begins with `.`, which LLVM accepts
; as the first byte of a local or a label and which no Axiom
; identifier can contain - `isIdentStart` and `isIdentChar` in
; lexer.ax both leave byte 46 out, and `llvmSym` quotes a name rather
; than inventing bytes for it, so nothing the source wrote arrives
; with a leading `.` either. Admitting `.` into identifiers is the one
; lexer change that would meet this rule, and it would have to move
; the prefix with it.
;
; The rule covers every `define` this file writes FOR THE PROGRAM:
; top-level functions, lifted lambdas (`%.env`), forwarding thunks
; (`%.aN`, `%.r`). The runtime block - `axiom_alloc`, `axiom_retain`,
; the backtracer and their kin - is hand-written IR in functions of
; its own, in which no source name is ever emitted, and its `%size`
; and `entry:` stay as they are. The hidden `%__evw.h` evidence word
; and the `%__scr.h` scratch cell are unspellable through their `.`
; as well.
(pub :: tmpStr (-> String Int String))
(pub fn (tmpStr kind n)
  (concat "%." (concat kind (fmtInt n))))

(pub :: regStr (-> Int String))
(pub fn (regStr n)
  (tmpStr "t" n))

(pub :: labelStr (-> Int String))
(pub fn (labelStr n)
  (concat ".L" (fmtInt n)))

(pub :: constStr (-> Int String))
(pub fn (constStr n)
  (fmtInt n))

; ------------------------------------------------------------------
; String literals.
;
; A literal is interned once per module and emitted as a private global.
; Every byte is written as a hex escape rather than passed through
; literally: the body then contains no quote or backslash that could
; close the constant early, and no judgement is needed about which bytes
; LLVM considers printable.
; ------------------------------------------------------------------
(pub :: internString (-> CG String Int))
(pub fn (internString cg lexeme)
  {
    (let tbl (cgStrings cg))
    (let found (findString tbl lexeme 0))
    (if (>= found 0)
      found
      {
        (let id (vecLen tbl))
        {
          (vecPush tbl lexeme)
          id
        }
      })
  })

(pub :: findString (-> (Vec a) String Int Int))
(pub fn (findString tbl s i)
  (if (>= i (vecLen tbl))
    (- 0 1)
    (if (strEq (vecGetStr tbl i) s)
      i
      (findString tbl s (+ i 1)))))

(pub :: hexDigit (-> Int Int))
(pub fn (hexDigit n)
  (if (< n 10)
    (+ 48 n)
    (+ 55 n)))

(pub :: hex2 (-> Int String))
;@axiom:effect(unsafe)
(pub fn (hex2 n)
  {
    (let s (strAlloc 2))
    {
      (__store8 (strData s) 0 (hexDigit (/ n 16)))
      (__store8 (strData s) 1 (hexDigit (% n 16)))
      s
    }
  })

; The byte a source escape denotes. Anything unrecognised stands for
; itself, which is what `\"` and `\\` need.
; `lexeme` still carries its surrounding quotes, so the body runs from
; index 1 to len-1.
;
; Two passes over the literal, and the reason is a MEASUREMENT. This
; was one pass that grew an accumulator - `acc`, then `"\\"`, then `(hex2 c)`
; per byte - which allocates a fresh string per byte, each about as
; long as everything escaped so far: quadratic in the literal's
; length, and nothing here is freed yet. `core/explain.ax` holds
; the longest literals in the tree, and lengthening ONE of them by
; about 1.4 KB - `AX3032`'s text, zero new lines - moved the
; self-compile's peak RSS by 5.3 MiB, from 534 to 539 against
; check-bootstrap's 540 MiB ceiling. That gate's failure text guesses
; "suspect an accumulator that copies", and this was the accumulator.
;
; Counting first costs one allocation-free scan and makes the fill
; linear. What that is worth was much larger than the literal that
; exposed it, because the square was being paid on EVERY literal the
; compiler emits: the same self-compile, same input, went 542 -> 393
; MiB, and the two emit BYTE-IDENTICAL IR. 149 MiB, or 27%, was the
; compiler escaping its own strings a character at a time.
;
; (`llvmSymBody` below still folds this way. It escapes a symbol NAME,
; where the corpus's longest is 48 bytes against this literal's 3,300,
; so the square is not worth a second pass there - recorded so the
; asymmetry reads as a decision.)
(pub :: escBody (-> String Int Int String))
(pub fn (escBody s i limit)
  {
    (let out (strAlloc (* 3 (escCount s i limit 0))))
    {
      (escFill s i limit (strData out) 0)
      out
    }
  })

; How many BYTES the literal denotes: a source escape is two bytes and
; denotes one, which is why this cannot be `limit - i`.
(pub :: escCount (-> String Int Int Int Int))
(pub fn (escCount s i limit n)
  (if (>= i limit)
    n
    (if (&& (== (strByte s i) 92) (< (+ i 1) limit))
      (escCount s (+ i 2) limit (+ n 1))
      (escCount s (+ i 1) limit (+ n 1)))))

(pub :: escFill (-> String Int Int Int Int Int))
(pub fn (escFill s i limit p o)
  (if (>= i limit)
    o
    (if (&& (== (strByte s i) 92) (< (+ i 1) limit))
      {
        (escPut p o (unescByte (strByte s (+ i 1))))
        (escFill s (+ i 2) limit p (+ o 3))
      }
      {
        (escPut p o (strByte s i))
        (escFill s (+ i 1) limit p (+ o 3))
      })))

; One byte as LLVM's `\XX`, the three characters `emitStringGlobals`
; divides by to recover the count.
(pub :: escPut (-> Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (escPut p o c)
  {
    (__store8 p o 92)
    (__store8 p (+ o 1) (hexDigit (/ c 16)))
    (__store8 p (+ o 2) (hexDigit (% c 16)))
    0
  })

; ------------------------------------------------------------------
; A user's name, as LLVM has to read it.
;
; LLVM's unquoted identifier is `[-a-zA-Z$._][-a-zA-Z$._0-9]*`. Axiom's
; is deliberately wider: `isIdentChar` (lexer.ax) admits
; `! * + / < > = % & | ' ^` so that `(+ a b)` is a call, `set!` is a
; name and `foo'` is a name. Twelve of those bytes are outside LLVM's
; set, and this file wrote every name out bare, so a program the lexer,
; the parser, the checker, `fmt` and `symbols` all accepted died in
; `opt`:
;
;   define i64 @foo'(i64 %n)
;   opt: error: expected '(' in function argument list
;
; reported as `AX4003 opt failed` against `<toolchain>` - the compiler
; blaming the native tools for its own output, with no span into the
; source, for a program it had just called well typed. Measured one
; probe per shape, as a function name and again as a parameter name:
; `plain` and `x-5` ran and answered 42, and the other twelve exited 4.
; `x-5` survives only because `-` happens to be legal in both sets.
;
; The rule here is LLVM's, written out rather than expressed as "not
; `isIdentChar`". They are two different agreements and each side has
; to be free to move without the other silently following - which is
; the defect this repository keeps finding: the parser and the
; formatter, the lexer and the AXTAG scanner, the server's promises and
; the server's behaviour. Stating LLVM's set here means widening
; Axiom's cannot quietly break the backend.
;
; A name already inside LLVM's set is returned UNCHANGED. Every one of
; the 1,629 top-level names in `stdlib/` and `core/` is, and so is
; every `Mod$name` the module mangle produces, because `$` is in both
; sets - so this cannot move the bootstrap's IR by a byte.
(pub :: llvmPlainByte (-> Int Bool))
(pub fn (llvmPlainByte c)
  (if (&& (>= c 97) (<= c 122))  ; a-z
    true
    (if (&& (>= c 65) (<= c 90))  ; A-Z
      true
      (if (&& (>= c 48) (<= c 57))  ; 0-9
        true
        (if (== c 45)  ; -
          true
          (if (== c 36)  ; $, the module mangle
            true
            (if (== c 46)  ; .
              true
              (if (== c 95)  ; _
                true
                false))))))))

; A leading digit is refused even though a digit is legal further in:
; `@42` is LLVM's NUMBERED global, which is a different thing from a
; global whose name is "42". `isIdentStart` cannot produce one today
; and this does not rely on that staying true.
(pub :: llvmSymIsPlain (-> String Int Int Bool))
(pub fn (llvmSymIsPlain s i n)
  (if (>= i n)
    true
    {
      (let c (strByte s i))
      (if (llvmPlainByte c)
        (if (&& (== i 0) (&& (>= c 48) (<= c 57)))
          false
          (llvmSymIsPlain s (+ i 1) n))
        false)
    }))

; Inside the quotes LLVM reads `\xx` hex escapes, so the two bytes that
; would end the name early have to become them. Neither `"` nor `\` is
; in `isIdentChar`, so neither is reachable from a source name today;
; they are handled because the quoting rule belongs to LLVM and must
; not depend on where Axiom's set happens to stop.
(pub :: llvmSymBody (-> String String))
(pub fn (llvmSymBody s)
  {
    (let b (strBuilderWithCapacity (strLen s)))
    {
      (for i in 0..(strLen s)
        {
          (let c (strByte s i))
          (if (|| (== c 34) (== c 92))
            {
              (strBuilderPushByte b 92)
              (strBuilderPush b (hex2 c))
            }
            (strBuilderPushByte b c))
        })
      (strBuilderFinish b)
    }
  })

; The empty name quotes rather than emitting a bare sigil: `@` alone is
; not an identifier, and `@""` is.
(pub :: llvmSym (-> String String))
(pub fn (llvmSym name)
  {
    (let n (strLen name))
    (if (&& (> n 0) (llvmSymIsPlain name 0 n))
      name
      (concat "\"" (concat (llvmSymBody name) "\"")))
  })

; Every byte became exactly three characters, so the byte count is the
; escaped length over three; the array is one longer for the terminator.
(pub :: emitStringGlobals (-> CG Int CG))
(pub fn (emitStringGlobals cg i)
  {
    (let tbl (cgStrings cg))
    (if (>= i (vecLen tbl))
      cg
      {
        (let lex (vecGetStr tbl i))
        {
          (let body (escBody lex 1 (- (strLen lex) 1)))
          {
            (let n (+ (/ (strLen body) 3) 1))
            {
              (emitLine cg
                (concat (concat "@str_" (concat (fmtInt i) " = private unnamed_addr constant ["))
                  (concat (concat (fmtInt n) (concat " x i8]  c\"" body)) (concat "\\00\"" ""))))
              ; The `Str` header the literal itself evaluates to, over
              ; the bytes just emitted. `n` counts the NUL, the length
              ; word does not.
              ; MM-LIFE-2b statics: the literal's block is laid out
              ; under the same header shape, count all-ones - a
              ; static is never reclaimed and never written, and
              ; retain/release read the sentinel and stop. The
              ; circulating address is element 2, so every consumer
              ; still loads len at +0 and bytes at +8 from the
              ; handle it holds. The fifth word is MM-LIFE-2d's
              ; OWNER (`Str` half): zero, because a literal's bytes
              ; are loader-resident and no block's death may free
              ; them - a slice of a literal inherits that zero and
              ; retains nothing.
              (emitLine cg
                (concat
                  (concat "@strhdr_"
                    (concat (fmtInt i)
                      " = private unnamed_addr constant { i64, i64, i64, ptr, i64 } { i64 -1, i64 0, i64 "))
                  (concat (concat (fmtInt (- n 1)) (concat ", ptr @str_" (fmtInt i)))
                    (concat ", i64 0 }, align 16" ""))))
              (emitStringGlobals cg (+ i 1))
            }
          }
        }
      })
  })

; ------------------------------------------------------------------
; Nullary top-level functions read like variables but lower to calls.
; ------------------------------------------------------------------
; The entry file's `main` is EMITTED as `__axiom_user_main`
; (`emitFnDef`, `mangledFor`), but every table the emitter consults -
; the declaration list, the signature vector - still holds the
; declaration's own spelling. A lookup arriving with the emitted
; symbol must ask under the declared name, or a reference to `main`
; misses every known-function arm and falls through to the parameter
; arm, which leaves the bare register `%main` in the IR: `check` said
; OK and `opt` refused (MM-EXEC-15a) - while `mangledFor`'s own
; comment claimed the rename was handled.
(pub :: declSpellingOf (-> String String))
(pub fn (declSpellingOf full)
  (if (strEq full "__axiom_user_main")
    "main"
    full))

(pub :: isNullaryFn (-> (Vec ASTNode) String Bool))
(pub fn (isNullaryFn decls name)
  (if (== (as decls Int) 0)
    false
    (isNullaryFnIn decls (declSpellingOf name) 0)))

(pub :: isNullaryFnIn (-> (Vec ASTNode) String Int Bool))
(pub fn (isNullaryFnIn decls name i)
  (if (>= i (vecLen decls))
    false
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN)
            (&& (strEq (nodeAName d) name) (== (vecLen (nodeBNames d)) 0)))
        true
        ; A ZERO-ARITY `extern` item is a nullary function too, and
        ; this is the one place that decides so. Without this arm the
        ; reference is emitted as a bare `%name` register that no
        ; instruction defines, and the module dies in `opt` with
        ; "use of undefined value" - the exact failure shape `foreign`
        ; had, arriving through a different door.
        ;
        ; It matters only for arity 0: every other arity reaches
        ; `emitPlainCall` through an application node.
        (if (&& (== (nodeTag d) TAG_D_EXTERN) (externHasNullary (nodeCChildren d) name 0))
          true
          (isNullaryFnIn decls name (+ i 1))))
    }))

; Whether `name` is an item of this block whose declared type is not an
; arrow - i.e. takes no arguments.
(pub :: externHasNullary (-> (Vec ASTNode) String Int Bool))
(pub fn (externHasNullary items name i)
  (if (== (as items Int) 0)
    false
    (if (>= i (vecLen items))
      false
      ; Either spelling: the Axiom name in slot a, or the LINKER
      ; SYMBOL in slot c. `emitVar` resolves a reference through
      ; `mangledFor` BEFORE asking, and for an extern that map
      ; answers the symbol - so a lookup arriving here is holding
      ; the symbol while the declaration list holds the Axiom
      ; name. This is the same shape the comment above
      ; `declSpellingOf` records for `main`, which is why that
      ; helper exists at all.
      {
        (let f (vecGet items i))
        (if (&& (|| (strEq (nodeAName f) name) (strEq (nodeCName f) name))
              (== (arrowArity (nodeBChild f)) 0))
          true
          (externHasNullary items name (+ i 1)))
      })))

; ------------------------------------------------------------------
; Pre-scan declarations: build the type registry.
; ------------------------------------------------------------------
(pub :: scanDecls (-> (Vec ASTNode) CG Int CG))
(pub fn (scanDecls decls cg i)
  (if (>= i (vecLen decls))
    cg
    (scanDecls decls (scanOne (vecGet decls i) cg) (+ i 1))))

; `(effect E (op :: ...))` registers the effect and every one of its
; operations against one evidence slot.
;
; Registered ONCE per slot, because `scanDecls` runs again before
; every function body - the type registry is rebuilt per function, and
; a second registration here would emit a duplicate evidence global,
; which llc refuses outright rather than tolerating.
(pub :: scanEffect (-> ASTNode CG CG))
(pub fn (scanEffect node cg)
  {
    (let tbl (cgEffDecls cg))
    (let slot (effSlotFor (nodeAName node) (nodeModule node)))
    (let isEntry
      (if (== (nodeModule node) 0)
        1
        0))
    (if (effSlotRegistered tbl slot 0)
      cg
      {
        (vecPush tbl (EffEnt :name (nodeAName node) :slot slot :isEntry isEntry))
        ; The effect's own name under its mangled spelling as well,
        ; for the same reason its operations get one: a `handle`
        ; INSIDE the declaring module must install the slot that
        ; module's operations dispatch on. Resolve the two by
        ; different rules and a module that declares its own
        ; `Console` installs the handler in one global while its own
        ; `log` reads another - the operation finds nothing and traps
        ; on valid source.
        (if (! (== (nodeModule node) 0))
          (vecPush tbl
            (EffEnt
              :name (concat (nodeModuleName node) (concat "$" (nodeAName node)))
              :slot slot
              :isEntry isEntry)))
        (scanEffectOps (nodeBNames node) slot isEntry (nodeModule node) (cgEffOps cg) 0)
        cg
      })
  })

; An operation of an imported effect is registered under its bare name
; and under `Mod$op`, because that is what a qualified reference
; resolves to: stage1 spells `EffMod::ask` as the flat name
; `EffMod$ask`, and an `effect` declaration is one of the two kinds
; `mangleDecl` never rewrites. Both spellings dispatch through the one
; slot, which is the only thing that has to be single.
(pub :: scanEffectOps (-> Names String Int a (Vec EffEnt) Int Int))
;@axiom:effect(unsafe)
(pub fn (scanEffectOps ops slot isEntry modName tbl i)
  (if (>= i (vecLen ops))
    0
    {
      (vecPush tbl (EffEnt :name (vecGetStr ops i) :slot slot :isEntry isEntry))
      (if (! (== (as modName Int) 0))
        (vecPush tbl
          (EffEnt
            :name (concat (as modName String) (concat "$" (vecGetStr ops i)))
            :slot slot
            :isEntry isEntry)))
      (scanEffectOps ops slot isEntry modName tbl (+ i 1))
    }))

(pub :: scanOne (-> ASTNode CG CG))
(pub fn (scanOne node cg)
  {
    (let tag (nodeTag node))
    (if (== tag TAG_D_EFFECT)
      (scanEffect node cg)
      (if (== tag TAG_D_DATA)
        {
          (let name (nodeAName node))
          (let ctors (nodeBChildren node))
          {
            (vecPush (cgDataTyNames cg) (cgDeclaredTypeName node))
            (scanCtors ctors cg 0 (ctorsRep ctors (cgTagN cg)) (nodeModuleName node))
          }
        }
        (if (== tag TAG_D_STRUCT)
          ; A struct's slot 7 holds its FIELD list (mkField nodes:
          ; name and float flag) where a data constructor's holds
          ; float flags alone - the kind decides the reading.
          {
            (let name (nodeAName node))
            (let fields (nodeStructFields node))
            (let types (cgTypes cg))
            (let kind
              (if (structIsWord node)
                TF_WORD
                TF_STRUCT))
            {
              (cgSetTypes cg
                (addQualified
                  (addTypeNamed types name kind (vecLen fields) 0 0 vecNew None (Some fields))
                  (nodeModule node) name kind (vecLen fields) 0 0 vecNew None (Some fields)))
              cg
            }
          }
          cg)))
  })

(pub :: ctorsHasNullary (-> (Vec ASTNode) Int Int))
(pub fn (ctorsHasNullary ctors i)
  (if (>= i (vecLen ctors))
    0
    (if (== (nodeB (vecGet ctors i)) 0)
      1
      (ctorsHasNullary ctors (+ i 1)))))

(pub :: ctorsHasBoxed (-> (Vec ASTNode) Int Int))
(pub fn (ctorsHasBoxed ctors i)
  (if (>= i (vecLen ctors))
    0
    (if (> (nodeB (vecGet ctors i)) 0)
      1
      (ctorsHasBoxed ctors (+ i 1)))))

; The representation code every constructor of one `data` type
; carries: 0 = boxed (no nullary constructor unboxes - the type has
; none, or a tag would reach the 4096 immediate limit), 1 =
; all-nullary (every value IS its tag), 2 = mixed (nullary
; constructors are immediate tags, fieldful ones are heap blocks, and
; a match site telling them apart needs the runtime `< 4096` test -
; every heap address is mmap-page memory at or above it). Mirrors
; stage0's S1 rule exactly; `firstTag` is the counter before this
; type's constructors are assigned.
(pub :: ctorsRep (-> (Vec ASTNode) Int Int))
(pub fn (ctorsRep ctors firstTag)
  (if (== (ctorsHasNullary ctors 0) 0)
    0
    (if (>= (+ firstTag (vecLen ctors)) 4096)
      0
      (if (== (ctorsHasBoxed ctors 0) 1)
        2
        1))))

; A SECOND entry for a declaration that arrived through an import,
; under the `Mod$name` spelling a qualified reference is parsed into.
;
; `mangleDecl` renames `fn` and `::` declarations, so `Mod::f` finds a
; declaration whose name already matches. It does not rename `data` or
; `struct`, so `Mod::Ctor` found nothing, and the checker refused a
; program stage0 compiles - measured `AX3001 undefined variable
; Box$Red` against stage0's `OK`. `lookupType` is exact string
; equality over a flat table, so an alias here costs one entry and
; changes no rule: the tag, arity and representation are the SAME
; values, which is what keeps a constructor reached under either
; spelling one constructor rather than two.
(pub :: addQualified
  (-> (Vec TypeEntry) a String Int Int Int Int Ints (Option Names) (Option Nodes) (Vec TypeEntry)))
;@axiom:effect(unsafe)
(pub fn (addQualified types modName name kind arity tag rep fieldFlags fieldNames fieldTys)
  (if (== (as modName Int) 0)
    types
    (addTypeNamed types (concat (strDup (as modName String)) (concat "$" (strDup name))) kind arity
      tag rep fieldFlags fieldNames fieldTys)))

; The constructor's packed type slot alone uses zero for unavailable metadata.
(:: cgCtorFieldTypes (-> ASTNode (Option Nodes)))
(fn (cgCtorFieldTypes node)
  (if (== (nodeTy node) 0)
    None
    (Some (nodeTyChildren node))))

(pub :: scanCtors (-> (Vec ASTNode) CG Int Int String CG))
(pub fn (scanCtors ctors cg i rep modName)
  (if (>= i (vecLen ctors))
    cg
    ; `t` is this constructor's tag; the counter is bumped for
    ; the next one. Storing `t - 1` gave the first constructor
    ; of the module tag -1, and `fmtInt` rendered that as `/` -
    ; a stray character in the middle of an argument list.
    {
      (let node (vecGet ctors i))
      {
        (let n (nodeAName node))
        (let a (nodeB node))
        (let t (cgTagN cg))
        (let types (cgTypes cg))
        {
          (cgSetTagN cg (+ t 1))
          (cgSetTypes cg
            (addQualified
              (addTypeNamed types n TF_DATA a t rep (nodeCWords node) (nodeFieldNamesOpt node)
                (cgCtorFieldTypes node))
              modName n TF_DATA a t rep (nodeCWords node) (nodeFieldNamesOpt node)
              (cgCtorFieldTypes node)))
          (scanCtors ctors cg (+ i 1) rep modName)
        }
      }
    }))

; ------------------------------------------------------------------
; Import resolution: recursively collect declarations from all modules.
;
; Two contracts drive the shape of this code.
;
; `Sys.sysReadFile` takes a raw NUL-terminated char*, not a `Str`
; handle,
; because it hands the pointer straight to `sysOpenPath`. Every path
; therefore crosses the boundary via `strCStr`. Paths built by
; `concat` are already NUL-terminated (`strAlloc` reserves len+1 and
; the allocator zeroes), so no extra terminator work is needed. Passing
; a `Str` handle here silently opens garbage and reports every module
; as missing.
;
; `sysReadFile` reports failure as an empty `Str`, never as 0, so
; `strLen == 0` is the "not found" test.
;
; Resolution is diamond-safe: a `seen` Vec of module names ensures each
; module contributes its declarations exactly once. The import graph is
; a DAG with heavily shared nodes -- core, Mem, Str and Vec are each
; reached by several paths -- and emitting a module twice would produce
; duplicate LLVM symbol definitions. Marking a module seen *before*
; recursing into it also makes an import cycle terminate.
; ------------------------------------------------------------------
; An owned copy of `s` with every '.' turned into '/', mapping a dotted
; module path onto a relative file path: Sys.Platform -> Sys/Platform.
; `strDup` gives an owned, NUL-terminated buffer, so rewriting the bytes
; in place cannot disturb the original.
(pub :: modPathToFile (-> String String))
(pub fn (modPathToFile s)
  {
    (let out (strDup s))
    {
      (dotsToSlashes (strData out) 0 (strLen out))
      out
    }
  })

(pub :: dotsToSlashes (-> Int Int Int Int))
;@axiom:effect(unsafe)
(pub fn (dotsToSlashes p i n)
  (if (>= i n)
    0
    {
      (if (== (__load8 p i) 46)
        (__store8 p i 47))
      (dotsToSlashes p (+ i 1) n)
    }))

; Source text of module `name`, searching core/ then stdlib/.
; Returns 0 when the module resolves to no readable file.
; Source of module `name`, preferring a target-specific file.
;
; `Sys.Platform` resolves to `Sys/Platform.darwin.ax` before
; `Sys/Platform.ax`, the same order stage0 uses, so the syscall tables
; live in Axiom source rather than in a table inside the compiler.
; Without it the platform module resolves to nothing and every constant
; it defines - `sysWriteNum`, `oRdonly` - is an undefined symbol.
; The module's source, or nothing when there is no such file.
;
; `Option` rather than the word-plus-view shape the hot readers took:
; the view would have to RE-READ the file to answer, and casting the
; bound word at the use site - which is what the callers did - drops
; the source string's release (MM-LIFE-2e), a leak per module.
;@axiom:effect(io)
(pub :: readModuleSrc (-> String Int String (Option String)))
(pub fn (readModuleSrc name tcode entryDir)
  {
    (let p (moduleSrcPath name tcode entryDir))
    (if (== (strLen p) 0)
      None
      (Some (unwrapOr (readFile p) "")))
  })

; The same read, defaulted - for a call site that needs a String
; inline. One read, not two.
(pub :: readModuleSrcOr (-> String Int String String String))
;@axiom:effect(io)
(pub fn (readModuleSrcOr name tcode entryDir dflt)
  {
    (let srcOpt (readModuleSrc name tcode entryDir))
    (if (let (Some s) srcOpt)
      s
      dflt)
  })

; The path the suffix ladder resolved, or "". A diagnostic about a
; module has to name the FILE, and only the search knows which
; candidate won - `readModuleSrc` used to answer the bytes and throw
; the path away, so an imported module that failed to parse could not
; be reported against anything. The ladder lives here once and
; `readModuleSrc` reads through it, rather than being stated twice.
(pub :: moduleSrcPath (-> String Int String String))
;@axiom:effect(io)
(pub fn (moduleSrcPath name tcode entryDir)
  {
    (let stem (modPathToFile name))
    {
      (let a (tryModulePath stem (targetOsArchSuffix tcode) entryDir))
      (if (> (strLen a) 0)
        a
        {
          (let b (tryModulePath stem (targetOsSuffix tcode) entryDir))
          (if (> (strLen b) 0)
            b
            (tryModulePath stem ".ax" entryDir))
        })
    }
  })

; Every directory a module is looked up in, in order.
;
; This is stage0's `module_search_dirs` reproduced: the entry file's own
; directory first, so a project can shadow a standard-library module
; with its own file of the same name; then `AXIOM_PATH` entries,
; colon-separated, for vendored or generated code; then the standard
; library, located by `AXIOM_STDLIB` or, failing that, relative to the
; compiler binary - `<exe>/../stdlib` for an installed layout and
; `<exe>/../../stdlib` for a build tree.
;
; Before this, stage1 searched the entry directory and then the literal
; strings `core/` and `stdlib/` RELATIVE TO ITS WORKING DIRECTORY,
; which is why every gate script salts its work directory with
; `ln -s "$repo_root/stdlib"`. A user compiling a hello-world that
; imports `IO` from any other directory got `cannot read module: IO`
; and exit 3. Probed before the change, from a scratch directory.
;
; `sysArg 0` is argv[0] rather than a real `current_exe`. When the
; shell finds the compiler on `PATH` it passes the BARE NAME, so
; `(pathDir (sysArg 0))` is `""` and the exe-relative entries below
; would resolve against the working directory. `pushExeRelStdlib`
; handles that case rather than degrading into it; see its comment.
(pub :: moduleSearchDirs (-> String Names))
;@axiom:effect(io)
(pub fn (moduleSearchDirs entryDir)
  ; The entry directory is pushed WITH ITS SLASH, the way every
  ; other root here already is (`pushPathList` and the `AXIOM_STDLIB`
  ; arm both run through `pathWithSlash`). `searchDirsFor` forms its
  ; candidate as a bare `(concat dir base)`, so a root that does not
  ; end in a separator would fuse with the module name; the caller
  ; passes `(pathDir path)`, which already ends in one or is empty,
  ; so this is a no-op today and a guard against a future caller
  ; that hands over `src` instead of `src/`.
  ;
  ; The EMPTY case is not normalised here, and that is deliberate.
  ; `""` is the honest answer for a file named with no directory
  ; (`axiom check trav.ax`), and `Path.ax` maps `""` to `""` on
  ; purpose so that `(concat (pathDir p) (pathBase p))` is `p`.
  ; Prefixing `./` instead would confine the concatenation, but it
  ; also lands in every diagnostic about a same-directory imported
  ; module - `./TagPure.ax` where five goldens say `TagPure.ax` -
  ; which is a worse report for no gain over refusing the escaping
  ; stem outright. That refusal is in `searchDirsFor`.
  {
    (let v vecNew)
    {
      (vecPush v (pathWithSlash entryDir))
      ; `axiom.pkg`'s `depend` directories, between the entry file's
      ; own directory and `$AXIOM_PATH`. That position is the whole
      ; policy: a project still shadows a dependency with its own file
      ; of the same name, and a dependency the project DECLARED
      ; outranks one an environment variable happened to be carrying -
      ; because the manifest travels with the source and the variable
      ; travels with the shell.
      ;
      ; Costs one `sysFileExists` per directory level, per lookup, to a
      ; tree with no manifest. That is the same shape as the `sysEnv`
      ; call below it, and `pkg.ax` bounds the walk at eight levels.
      ;
      ; ...and its `crate` directories, in the SAME slot and for the
      ; same reason - a crate is a dependency that happens to carry an
      ; archive, and the module it contributes is the one in
      ; `DIR/axiom/`. `pkgSearchDirs` answers both from ONE manifest
      ; walk, because this function runs per module lookup and asking
      ; twice would double the cost the paragraph above bounds. The
      ; command-line `--crate` below keeps its place after
      ; `$AXIOM_PATH`: the manifest travels with the source, and a flag
      ; someone typed is not a thing the project said.
      (pushDirs v (pkgSearchDirs entryDir) 0)
      (pushPathList v (sysEnv "AXIOM_PATH"))
      ; `--crate DIR`: the crate's generated binding module lives in
      ; `DIR/axiom/`, and the driver searches `DIR/target/release` for
      ; its archive - one flag where `AXIOM_PATH`, `--link-search` and
      ; `--link-lib` were three
      (pushCrateDirs v 1)
      (pushDirs v stdlibSearchDirs 0)
      v
    }
  })

; The tail of the search order: the standard library, wherever it is.
;
; SPLIT OUT so that `pkgCheckStdlibShadow` can ask "does the library
; provide this module?" with the very list the resolver would have
; searched, rather than a second copy of it that drifts. A refusal
; about a search order has to be built from the search order.
(pub :: stdlibSearchDirs Names)
;@axiom:effect(io)
(pub fn (stdlibSearchDirs)
  {
    (let v vecNew)
    {
      {
        (let sl (sysEnv "AXIOM_STDLIB"))
        (if (> (strLen sl) 0)
          (vecPush v (pathWithSlash sl))
          (pushExeRelStdlib v (pathDir (sysArg 0))))
      }
      v
    }
  })

; A DEPENDENCY MAY NOT PROVIDE A STANDARD-LIBRARY MODULE.
;
; `depend` and `crate` sit ABOVE the library in the order above, so a
; dependency carrying a `Fmt.ax` replaced the real one for the whole
; program - every module that imported `Fmt`, not only the one that
; asked for the dependency. Measured on 0.7.3: a vendored copy of
; `stdlib/Fmt.ax` whose `fmtInt` answered `"HIJACKED"` made the program
; print HIJACKED, at exit 0, with no diagnostic anywhere. That is the
; same wrong-answer-at-exit-0 shape `pkgVerify`'s two-dependency
; refusal closes, and it is also the only place in this compiler where
; a file that arrived with somebody else's package silently displaces
; one this repository ships.
;
; THE ENTRY FILE'S OWN DIRECTORY IS NOT TOUCHED. `docs/reference.md`
; documents a project shadowing a library module with its own file, and
; `check-packages.sh` pins it; a refusal that caught both would be a
; refusal that broke a feature. The rule is about who WROTE the file:
; the author's own directory, yes; a directory a manifest line pulled
; in, no.
;
; Answers 0, so a caller can bind it. Every failure exits 3, the same
; way and for the same reason as every other manifest refusal.
(pub :: pkgCheckStdlibShadow (-> String Int))
;@axiom:effect(io)
(pub fn (pkgCheckStdlibShadow entryDir)
  {
    (let mf (pkgFindManifest entryDir))
    (match mf
      ((None) 0)
      ((Some mf)
        (shadowCheckDirs (pkgConcatDirs (pkgDependDirs entryDir) (pkgCrateAxiomDirs entryDir)) mf 0)
      ))
  })

(pub :: shadowCheckDirs (-> Names String Int Int))
;@axiom:effect(io)
(pub fn (shadowCheckDirs dirs mf i)
  (if (>= i (vecLen dirs))
    0
    {
      (shadowCheckOne (vecGet dirs i) (pkgModules (vecGet dirs i)) mf 0)
      (shadowCheckDirs dirs mf (+ i 1))
    }))

(pub :: shadowCheckOne (-> String Names String Int Int))
;@axiom:effect(io)
(pub fn (shadowCheckOne dir mods mf i)
  (if (>= i (vecLen mods))
    0
    {
      {
        (let rel (vecGet mods i))
        {
          (let lib (searchDirsFor stdlibSearchDirs rel 0))
          (if (! (== (strLen lib) 0))
            (pkgDie
              (concat
                (concat "error: a dependency in "
                  (concat mf " provides the standard library's module `"))
                (concat (concat (pkgModuleName rel) (concat "`:\n" ""))
                  (concat (concat "       " (concat (concat dir rel) "\n"))
                    (concat (concat "       " (concat lib "   (the standard library's)\n"))
                      (concat
                        "       The dependency's copy sits ABOVE the library in the search order,\n       so it would replace it for the WHOLE program - every module that\n"
                        (concat
                          "       imports it, not only the one that wanted the dependency. Rename\n       the module, or drop the dependency. A module in the ENTRY FILE's\n"
                          "       own directory still shadows a library one; that is a file you\n       wrote, and it is unchanged.\n"))))))))
        }
      }
      (shadowCheckOne dir mods mf (+ i 1))
    }))

; The standard library, located relative to the compiler binary.
;
; `<exe>/../stdlib` is the installed layout and `<exe>/../../stdlib`
; the build tree, both formed from `exe` = `(pathDir (sysArg 0))`.
;
; When `exe` is EMPTY the shell found the compiler on `PATH` and handed
; it a bare name, and those two entries read against the WORKING
; DIRECTORY instead. That is not a corner: it is exactly what
; `scripts/install.sh` and the README tell a new user to set up -
; `export PATH="$HOME/.axiom/bin:$PATH"`, then type `axiom` - so the
; first program they write that imports anything answered `AX5001
; cannot resolve import IO` on a completely correct installation.
; Measured from a real release archive before this existed: the same
; compiler, same program, built by absolute path and refused by bare
; name.
;
; So resolve the bare name the way the shell just did: walk `PATH` and
; take the FIRST entry holding a file of that name. That is one
; directory, not every directory - and the difference is not
; cosmetic. The first version of this pushed `<entry>/../stdlib/` for
; every `PATH` entry, and its own negative probe caught what that
; means: on a machine with a second Axiom checkout on `PATH`, an
; installed `axiom` whose `stdlib/` had been deleted kept working,
; silently compiling against the OTHER installation's standard
; library. A compiler that answers with a stdlib the user did not
; install is worse than one that refuses.
;
; The two working-directory entries are still pushed afterwards, so
; nothing that resolved before this resolves differently now - the
; resolved root is added AHEAD of them, never in place of them.
(pub :: pushExeRelStdlib (-> Names String Names))
;@axiom:effect(io)
(pub fn (pushExeRelStdlib v exe)
  {
    (if (! (> (strLen exe) 0))
      {
        (let found (pathOfCommand (sysArg 0)))
        (if (> (strLen found) 0)
          {
            (vecPush v (concat found "../stdlib/"))
            (vecPush v (concat found "../../stdlib/"))
          })
      })
    (vecPush v (concat exe "../stdlib/"))
    (vecPush v (concat exe "../../stdlib/"))
  })

; The first `PATH` entry holding a file named `name`, slash-terminated,
; or `""` when no entry does.
;
; `sysFileExists` rather than an executable-bit test, which is the same
; choice `Sys.sysRunSearch` makes for its own `PATH` walk: the question
; here is which directory the name came from, and a candidate that
; cannot be opened is one this has no business selecting.
; `PATH` splits on `pathListSep`, `;` on Windows, and where
; `exeSuffixTried` says so a name with no extension is looked for as
; `NAME.exe`, the file a Windows shell ran for `axiom`.
(pub :: pathOfCommand (-> String String))
;@axiom:effect(io)
(pub fn (pathOfCommand name)
  {
    (let parts (strSplit (sysEnv "PATH") pathListSep))
    (let file
      (if (&& (== exeSuffixTried 1) (== (strLen (pathExt name)) 0))
        (concat name ".exe")
        name))
    (let mut i 0)
    (let mut found "")
    {
      (while (&& (< i (vecLen parts)) (== (strLen found) 0))
        {
          {
            (let d (vecGet parts i))
            (if (> (strLen d) 0)
              {
                (let dir (pathWithSlash d))
                (if (fileExists (concat dir file))
                  (set found dir))
              })
          }
          (set i (+ i 1))
        })
      found
    }
  })

; Append each non-empty `:`-separated entry of `list`, slash-terminated.
(pub :: pushPathList (-> Names String Int))
(pub fn (pushPathList v list)
  ; `strSplit` owns the colon scan now. This was one of two open-coded
  ; copies of it - the other is `Sys.sysRunSearch`, which keeps its
  ; own because it stops at the first candidate that runs and building
  ; the whole vector first would open files it never needs.
  ;
  ; Empty entries are dropped HERE rather than by the split, because
  ; the two callers disagree about them: an empty `PATH` entry means
  ; the working directory to `sysRunSearch` and means nothing to a
  ; module search path.
  {
    (let parts (strSplit list 58))
    (pushPathParts v parts 0)
  })

; Append one already-built list of search directories to another. It
; was `pushDependDirs` while `depend` was the only caller; there are
; three now - `depend`, the manifest's crates, and the standard-library
; tail - and a name that says which one it was for is a name that lies
; to two of them.
(pub :: pushDirs (-> Names Names Int Int))
(pub fn (pushDirs v dirs i)
  (if (>= i (vecLen dirs))
    0
    {
      (vecPush v (vecGet dirs i))
      (pushDirs v dirs (+ i 1))
    }))

(pub :: pushPathParts (-> Names Strings Int Int))
(pub fn (pushPathParts v parts i)
  (if (>= i (vecLen parts))
    0
    {
      {
        (let d (vecGet parts i))
        (if (> (strLen d) 0)
          (vecPush v (pathWithSlash d)))
      }
      (pushPathParts v parts (+ i 1))
    }))

(pub :: tryModulePath (-> String String String String))
;@axiom:effect(io)
(pub fn (tryModulePath stem suffix entryDir)
  (searchDirsFor (moduleSearchDirs entryDir) (concat stem suffix) 0))

; The first search directory in which `base` is a readable, non-empty
; file, or "".
;
; An existing but EMPTY module reads as absent here, which is what the
; predecessor did too - `sysReadFile` answers "" for both - and is
; recorded rather than fixed, because an empty module contributes no
; declarations and so fails identically one step later.
; A module stem that would leave whatever directory it is prefixed onto,
; and so cannot be looked up in a search directory at all.
;
; Two shapes, both of which `(concat dir base)` silently accepts. An
; ABSOLUTE stem re-anchors the concatenation outright - `"" + /etc/x.ax`
; and `stdlib/` + `/etc/x.ax` name the same file, and neither is in
; `stdlib/`. A `..` COMPONENT climbs out of it. An empty stem is refused
; with them because a directory is not a module.
;
; This is the second half of the 2026-08-23 import-traversal fix and not
; the load-bearing one: `AX2006` in `parser.ax` refuses a `/` inside a
; module-path segment, so no name the grammar admits can reach here
; absolute, and no segment can be `.` or `..` either, because a `.` lexes
; as `TK_DOT` and `parseIdentName` demands a `TK_IDENT` after it. Both
; shapes are unreachable through the parser TODAY. The check is here
; because this is the line that decides which file gets opened, and
; because `modPathToFile` rewrites `.` into `/` on the way - so what
; arrives is a path-shaped string whichever grammar produced it, and
; every future caller of this function inherits the confinement instead
; of having to re-derive it.
(pub :: stemEscapes (-> String Bool))
(pub fn (stemEscapes s)
  (if (== (strLen s) 0)
    true
    (if (== (strByte s 0) 47)
      true
      (stemDotDotAt s 0))))

; A `..` standing as a whole component of `s`: it begins the string or
; follows a `/`, and it ends the string or is followed by a `/`.
; `..ax`, `a..b` and `x/foo..` are all ordinary names and stay legal.
(pub :: stemDotDotAt (-> String Int Bool))
(pub fn (stemDotDotAt s i)
  (if (> (+ i 2) (strLen s))
    false
    (if (&& (|| (== i 0) (== (strByte s (- i 1)) 47))
          (&& (&& (== (strByte s i) 46) (== (strByte s (+ i 1)) 46))
            (|| (== (+ i 2) (strLen s)) (== (strByte s (+ i 2)) 47))))
      true
      (stemDotDotAt s (+ i 1)))))

(pub :: searchDirsFor (-> Names String Int String))
;@axiom:effect(io)
(pub fn (searchDirsFor dirs base i)
  (if (|| (stemEscapes base) (>= i (vecLen dirs)))
    ""
    {
      (let cand (concat (vecGet dirs i) base))
      (if (!= (strLen (unwrapOr (readFile cand) "")) 0)
        cand
        (searchDirsFor dirs base (+ i 1)))
    }))

; A module that cannot be read or parsed used to be *skipped*, so every
; function it defined surfaced later as `use of undefined value` out of
; llc - a codegen-shaped report for an import-shaped failure, with the
; module's name nowhere in it. That is how `stdlib/Fmt.ax` failing to
; parse presented as `@fmtInt` being undefined in a module that had
; visibly imported it. Refusing at the point of failure names the
; module, and matches the rule held everywhere else: a malformed input
; produces a diagnostic, not something worse further away.
(pub :: dieImport (-> String String Int))
;@axiom:effect(io)
(pub fn (dieImport msg name)
  {
    (writeStr stderr msg)
    (writeStr stderr name)
    (writeStr stderr "\n")
    ; Exit 3 is this compiler's import-failure code - except under
    ; `symbols`, where stage0 folds EVERY failure into exit 1 and the
    ; parity gate compares statuses. The subcommand is re-derived from
    ; argv here because driver.ax owns `argvSubcommand` and importing
    ; it from codegen would be a cycle: the first argument not opening
    ; with `-` is the subcommand, the same rule the driver applies.
    (sysExitWith
      (if (strEq (firstOperandArg 1) "symbols")
        1
        3))
    0
  })

; An internal invariant, violated, as AX4002.
;
; Reaching codegen with an unknown struct field or a `set` whose target
; is not a `mut` binding means the checker did not fire the diagnostic
; that was supposed to stop it - AX3007 and AX3012 respectively. That is
; literally what AX4002 is for, and it was the other code in the
; registry that neither compiler ever constructed.
;
; The exit status is `dieImport`'s, unchanged, because it is the one
; every gate already expects for a codegen bail-out and this commit is
; about the diagnostic rather than the status.
(pub :: dieCodegenDiag (-> String String Int))
;@axiom:effect(io)
(pub fn (dieCodegenDiag msg name)
  {
    (let d
      (mkDiag SEV_ERROR "AX4002" "codegen-failure" 0 (concat msg name) None
        (Some
          "this is a compiler bug: the check that should have refused this program did not run")))
    (let ds vecNew)
    (let units vecNew)
    {
      (vecPush ds d)
      (vecPush units (CUnit2 :file "<codegen>" :src "" :name None :imports vecNew :library false))
      {
        (let out (as (renderDiagsFormat diagFormatFromArgv ds units) String))
        (writeStr stderr out)
      }
      (sysExitWith
        (if (strEq (firstOperandArg 1) "symbols")
          1
          3))
      0
    }
  })

; Every `--crate DIR` (or `--crate=DIR`) on the command line, as a
; module search directory `DIR/axiom/`.
(pub :: pushCrateDirs (-> Names Int Int))
;@axiom:effect(io)
(pub fn (pushCrateDirs v i)
  (if (>= i sysArgc)
    0
    {
      (let a (sysArg i))
      (if (strEq a "--crate")
        {
          (if (< (+ i 1) sysArgc)
            (vecPush v (concat (pathWithSlash (sysArg (+ i 1))) "axiom/")))
          (pushCrateDirs v (+ i 2))
        }
        (if (strStartsWith a "--crate=")
          {
            (vecPush v (concat (pathWithSlash (strSlice a 8 (- (strLen a) 8))) "axiom/"))
            (pushCrateDirs v (+ i 1))
          }
          (pushCrateDirs v (+ i 1))))
    }))

; `--emit-staticlib` on the command line: the module is an archive
; for a host, not a program.
(pub :: cgStaticlib Bool)
;@axiom:effect(io)
(pub fn (cgStaticlib)
  (argHas "--emit-staticlib" 1))

; `cgThreads` - does the module being emitted spawn a thread? This is
; the one predicate the emitted runtime's storage classes will consult
; (docs/memory-model.md MM-PAR-6): true, and the six allocator words,
; `@__axiom_recover_top` and every `@__axiom_ev_<Effect>` slot are
; emitted `thread_local(localexec) global` with the thread runtime
; beside them; false, and every one of them is the `internal global`
; it is today and no thread primitive is emitted at all. The second
; half is the property worth more than the first: a program that
; spawns no thread must stay byte-identical on every target, Darwin
; included, where a thread-local global is an indirect call through
; libSystem's `__tlv_bootstrap` and would move MM-FFI-1's tier-1 count
; off zero for every program in the tree.
;
; IT IS A SCAN NOW, and the scan is the body this comment used to say
; was owed. `parScan` runs once in `emitResolved`, before
; `emitAllocator`, over every resolved declaration, and the answer is
; word 47 of the record: 1 when the module names `__thread_spawn`, or
; names `__par_spawn` - the primitive `(parallel ...)` desugars to
; (`core/parser.ax`, `parseParallelExpr`) - while `--threads`
; selects the thread lowering for it. It is computed BEFORE the
; allocator because the runtime globals precede every body in the
; module, so the answer cannot come from lowering the call, and it is
; kept in slot 4 of the pair-state vector because the record itself
; has no word to spare (`newCG`). A program
; that names neither is emitted byte for byte as before, on every
; target - `scripts/check-thread-local.sh` measures the OFF path first
; and the ON path second, on a program that really spawns.
;
; `cgMutGlobal` below is what the eight global sites consult - the five
; allocator words and the slab array in `emitAllocator`,
; `@__axiom_recover_top` in `emitRecoverRuntime`, and every
; `@__axiom_ev_<Effect>` in `emitEffectGlobals`.
;
; STILL NOT A COMMAND-LINE FLAG ON ITS OWN, and `--threads` is not one
; either in the sense this paragraph refuses: `--threads` chooses HOW
; `parallel` is lowered, and this predicate follows the program - a
; module that spawns a thread under either spelling gets thread-local
; globals whether or not anyone asked, and a module that spawns none
; gets shared ones whatever the flag says. What a flag must never do is
; emit a SPAWNING program with shared allocator words, the corruption
; MM-PAR-3's negative probe exists to demonstrate, and no flag here can.
(pub :: cgThreads (-> CG Bool))
(pub fn (cgThreads cg)
  (== (cgThreadsFlag cg) 1))

; The storage class of a mutable runtime global, which is the ONE thing
; `cgThreads` decides. Eight globals read it: the five allocator words,
; the slab array, `@__axiom_recover_top`, and one evidence slot per
; declared effect. `@__axiom_argc`/`@__axiom_argv` deliberately do not -
; they are written once in `@main`'s prologue, before any thread can
; exist, and never again - and neither does any constant, which is
; shareable by construction.
;
; `internal thread_local(localexec) global`, in that order, because
; that is the order LLVM's grammar takes: linkage, then the
; thread-local specifier, then the kind.
;
; LOCAL-EXEC IS MANDATORY AND NOT A PREFERENCE. A bare `thread_local`
; takes the general-dynamic model, which imports `__tls_get_addr@PLT`
; on both Linux targets - and `scripts/check-freestanding.sh` requires
; ZERO undefined symbols, so the default model would fail the gate that
; defines what this language means by freestanding. Local-exec is the
; only model a statically linked executable can use, and it is what a
; program with no dynamic loader has always been able to use.
;
; What it costs, measured on `llc` with `-O2 -relocation-model=pic`
; against a plain global with a load:
;
;   linux-x86_64    movq g(%rip)  ->  movq %fs:g@TPOFF      +0 insns
;   linux-aarch64   adrp + ldr    ->  mrs TPIDR_EL0 + 2 add + ldr  +2
;   freebsd-x86_64  movq g(%rip)  ->  movq %fs:0 + TPOFF    +1
;   darwin, both    adrp + ldr    ->  an INDIRECT CALL through
;                                     libSystem's __tlv_bootstrap
;
; Darwin is why the OFF path matters more than the ON one. A thread-
; local access there is a call, `axiom_alloc` touches four of these on
; its fast path, and every program in the tree would leave MM-FFI-1's
; tier 1 - zero undefined symbols - for a feature it never asked for.
; So the rule is the one `ERR-REC-6` already established for recovery
; points: a program that does not use the mechanism pays nothing for
; it, byte for byte, and that is measured rather than argued.
(pub :: cgMutGlobal (-> CG String))
(pub fn (cgMutGlobal cg)
  (if (cgThreads cg)
    "internal thread_local(localexec) global"
    "internal global"))

; ------------------------------------------------------------------
; Threads and `parallel` - S5 and S6 of docs/memory-model.md.
;
; Six primitives, two runtimes, one predicate. A program spells
;
;   (__thread_spawn thunk word)   (__thread_join handle)     threads
;   (__proc_spawn thunk word)     (__proc_join handle)       processes
;   (__par_spawn thunk word)      (__par_join handle)        whichever
;                                                            `--threads` says
;
; and `(parallel p ((a e1) (b e2)) body)` is the third pair, written by
; the parser (`parseParallelExpr`): spawn every binding, then join
; every binding IN ARGUMENT ORDER, then the body. Each join has a
; non-raising twin, `__par_join_nr`/`__thread_join_nr`/`__proc_join_nr`
; (`(-> Int Int Int)`, handle and out-cell), which stores the decoded
; wait status instead of re-raising it; the parser never writes one -
; `(parallel ...)` keeps the raising join - and `stdlib/Task.ax`'s
; checked pool is the caller they exist for. The two runtimes are
; the two lowerings of docs/memory-model.md §6 - PROCESSES
; by default, because MM-PAR-3 makes their isolation true by
; construction and costs nothing (fork, wait4, one shared page per
; binding); THREADS under `--threads`, because a thread is what a
; program that shares its address space actually wants, and the price
; of one is stated rather than hidden: the eight runtime globals move
; to `thread_local(localexec)` (`cgMutGlobal`), and thread creation
; names the platform's `pthread_create`, which is MM-FFI-1's tier 3 on
; every target that has one. The process lowering names nothing.
;
; WHAT CROSSES, AND WHAT DOES NOT. A thunk is `(-> Int Int)` and its
; answer is a WORD. That is the whole of what a join hands back under
; either lowering, and it is deliberate: under processes the answer
; crosses an address space through a `MAP_SHARED` page, and a word is
; what a page can carry without a serialiser; under threads the answer
; would have to be promoted out of the child's arena into the parent's
; (MM-PAR-6, "results moved into the parent's arena at join"), and a
; typed promotion is S3/S4's work, not this slice's. A `parallel`
; binding that answers a `String` is refused by the checker as a type
; mismatch at the binding's expression - `expected Int` - which is
; where the limit belongs.
;
; THE HANDLE is one mmap'd page, word for word the same under both
; lowerings, so a join is one function in two spellings:
;
;   word 0   the pid, or the pthread_t
;   word 1   the thunk - a closure record; the join releases it
;   word 2   the word handed to the thunk
;   word 3   the thunk's answer, written by the child
;   word 4   the wait status cell `wait4` fills (processes only)
;
; Mapped rather than allocated because the child WRITES word 3, and
; under threads the parent's arena is the parent's: a thread that
; allocated in it would be exactly the shared bump pointer MM-PAR-6
; says this allocator cannot absorb. Each thread starts from the
; zeroed thread-local image of the eight globals, so its first
; `axiom_alloc` maps a chunk of its own - one arena per thread, with
; no code written for it. The page is unmapped at the join.
;
; A TRAP IN A BINDING IS THE PROGRAM'S TRAP. Under threads the traps
; already exit the whole process (`targetExitNum` is `exit_group` on
; Linux, and its own comment records why that mattered before there
; was a second thread). Under processes the child dies alone, so the
; RAISING join reads its wait status and exits with the same number -
; the child already wrote the message. `tests/stdlib/471-parallel-trap.ax`
; pins status 77 out of both, which is what "the same determinism
; guarantee under both" costs to keep. The NON-RAISING join stores that
; same status to its out-cell and carries on; a caller that wants
; per-slot failure under processes names one, and a caller under
; threads gets the same spelling with the process still ending first.
;
; The checker enforces capture safety before this lowering. Lexical
; region inference handles stores and reset extents; concurrent captures
; have their own rules because thread arenas and non-atomic reference
; counts do not synchronise mutable payloads.
;
; WHERE IT IS NOT AVAILABLE. Threads need a way to start one and a
; local-exec TLS set up for each new thread: darwin and linux have a
; pthread and a C runtime's TLS, measured; windows has `CreateThread`
; and a static TLS the loader sets up from the TLS directory the
; module emits for itself (`emitWinRuntime`), so it has threads with no
; C runtime at all; freebsd links against no `libthr` here and is not
; measured. So `--threads` on freebsd, and `__thread_spawn` there, are
; refused at build time (AX4006, `parThreadsRefused` below, reported
; by `main.ax` before any IR is written). Windows has no `fork`, so
; `parallel` takes the thread lowering there without the flag
; (`parThreadsByDefault`), and `__proc_spawn` compiles there to
; `@__axiom_par_unsupported`, a trap that says so and exits 79 - the
; program EMITS, which is what keeps every cross-target sweep green,
; and dies at the first process spawn with a sentence, which is what
; keeps the answer honest.
; ------------------------------------------------------------------
(pub :: isParPrimName (-> String Bool))
(pub fn (isParPrimName nm)
  (if (strEq nm "__par_spawn")
    true
    (if (strEq nm "__par_join")
      true
      (if (strEq nm "__par_join_nr")
        true
        (if (strEq nm "__thread_spawn")
          true
          (if (strEq nm "__thread_join")
            true
            (if (strEq nm "__thread_join_nr")
              true
              (if (strEq nm "__proc_spawn")
                true
                (if (strEq nm "__proc_join")
                  true
                  (|| (strEq nm "__proc_join_nr") (isParBorrowName nm)))))))))))

; `parallel`'s borrow scope (MM-PAR-6b): only the desugaring names
; these, since a `$` is no identifier a program can write.
(pub :: isParBorrowName (-> String Bool))
(pub fn (isParBorrowName nm)
  (|| (strEq nm "parallel$borrow") (|| (strEq nm "parallel$return") (strEq nm "parallel$lends"))))

(pub :: isParSpawnName (-> String Bool))
(pub fn (isParSpawnName nm)
  (|| (strEq nm "__par_spawn") (|| (strEq nm "__thread_spawn") (strEq nm "__proc_spawn"))))

; The non-raising joins: same handle, plus an out-cell for the decoded
; wait status. They lower beside their raising twins - `emitPrimParJoin`
; branches on this - so `isParSpawnName` above stays exactly three.
(pub :: isParJoinNrName (-> String Bool))
(pub fn (isParJoinNrName nm)
  (|| (strEq nm "__par_join_nr") (|| (strEq nm "__thread_join_nr") (strEq nm "__proc_join_nr"))))

; Which targets can create a thread through the platform's pthread, and
; which can fork. `targetCode`'s numbering: darwin 0/1, linux 2/3,
; freebsd 4/5, windows 6/8, baremetal-aarch64 7.
;
; darwin and linux have a pthread AND the local-exec TLS a C runtime
; sets up for each new thread, and both are MEASURED - `Tests
; (darwin-aarch64)`, `Tests (linux-x86_64)` and `Tests (linux-aarch64)`
; all run `scripts/check-parallel.sh`, which executes both lowerings.
; freebsd links no `libthr` here, so its thread lowering is REFUSED
; rather than untried (AX4006); its PROCESS lowering is measured, and
; measured by execution on a real kernel - `Tests (freebsd-x86_64)`
; boots FreeBSD 14.4 and runs `run-stdlib-tests.sh`, whose 109 cases
; include `470-parallel`, `471-parallel-trap` and `476-par-pool`.
(pub :: targetHasThreads (-> Int Int))
;@axiom:effect(io)
(pub fn (targetHasThreads t)
  ; A STATICALLY-CARVED ARENA HAS ONE CURSOR AND NO SECOND REGION.
  ; Under `--threads` the runtime's mutable globals become
  ; `thread_local` (`cgMutGlobal`), so every thread would start its own
  ; bump pointer from a cursor initialised to the same base and carve
  ; the same bytes twice; leaving the cursor shared instead makes it a
  ; data race on the one word the whole heap is built from. Neither is
  ; a lowering worth emitting, and docs/embedded-guide.md §5 puts
  ; threads out of scope for bare metal for the same reason. So a
  ; static target answers "no threads" here and `main.ax` refuses
  ;   `--threads` on it as AX4006, which already means exactly this.
  (if (> (arenaStaticBytes t) 0)
    0
    (if (<= t 3)
      1
      (if (|| (== t 6) (== t 8))
        1
        0))))

; Which targets can spawn AT ALL, which is the question `targetHasThreads`
; does not answer. The process lowering IS the syscall template - `fork`,
; `mmap` and `wait4` through `targetSyscallAsm` - so "can this target
; fork?" is exactly "does this target have a syscall ABI", and the ones
; that do not are the two Windows targets and baremetal-aarch64.
;
; It is its own name rather than three copies of `targetUsesSyscallAsm`
; because the QUESTION here is about `parallel` and the answer merely
; happens to be the syscall ABI's: a windows spawn is missing because
; there is no `fork`, not because there is no `__syscallN`. One
; definition, so a target that grew a fork by another route would move
; both the lowering and the diagnostic together.
(pub :: targetHasSpawn (-> Int Int))
(pub fn (targetHasSpawn t)
  (targetUsesSyscallAsm t))

(pub :: targetSpelling (-> Int String))
(pub fn (targetSpelling t)
  (if (== t 0)
    "darwin-aarch64"
    (if (== t 1)
      "darwin-x86_64"
      (if (== t 2)
        "linux-aarch64"
        (if (== t 3)
          "linux-x86_64"
          (if (== t 4)
            "freebsd-x86_64"
            (if (== t 5)
              "freebsd-aarch64"
              (if (== t 7)
                "baremetal-aarch64"
                (if (== t 8)
                  "windows-aarch64"
                  "windows-x86_64")))))))))

; The per-target numbers the process lowering needs beside
; `targetMmapNum`/`targetExitNum`/`targetWriteNum`, each the one
; `stdlib/Sys/Platform.*.ax` carries for the standard library
; (`scripts/check-platform-constants.sh` is the gate that holds the
; existing pairs together, and these are written to be read by it).
;
; `fork`: darwin BSD 2 with the class bit; linux-x86_64 57; linux-
; aarch64 has no `fork` and spells it `clone(SIGCHLD, 0, 0, 0, 0)` -
; 220 with 17 as the first argument, which `targetForkArg` answers;
; FreeBSD 2. Darwin's `fork` answers the child's pid to BOTH processes
; and tells them apart in a register the syscall template does not
; read, so the runtime does what `sysForkProcess` does: one `getpid`,
; and the child is the one whose answer equals its own pid
; (`targetForkChildIsZero`).
(pub :: targetForkNum (-> Int Int))
(pub fn (targetForkNum t)
  (if (|| (== t 0) (== t 1))
    33554434
    (if (== t 2)
      220
      (if (== t 3)
        57
        2))))

(pub :: targetForkArg (-> Int Int))
(pub fn (targetForkArg t)
  (if (== t 2)
    17
    0))

(pub :: targetForkChildIsZero (-> Int Int))
(pub fn (targetForkChildIsZero t)
  (if (|| (== t 0) (== t 1))
    0
    1))

(pub :: targetGetPidNum (-> Int Int))
(pub fn (targetGetPidNum t)
  (if (|| (== t 0) (== t 1))
    33554452
    (if (== t 2)
      172
      (if (== t 3)
        39
        20))))

; `waitid`, for the thread lowering's joins (`emitParProc`): darwin BSD
; 173 with the class bit, linux-aarch64 95, linux-x86_64 247. Only the
; targets with threads need it - FreeBSD's `--threads` is AX4006 - so
; the rest answer 0, which no emitted line reads.
(pub :: targetWaitIdNum (-> Int Int))
(pub fn (targetWaitIdNum t)
  (if (|| (== t 0) (== t 1))
    33554605
    (if (== t 2)
      95
      (if (== t 3)
        247
        0))))

; `WEXITED | WNOWAIT`: wait for an exit without reaping it. Darwin
; spells WNOWAIT 0x20, Linux 0x01000000; WEXITED is 4 on both.
(pub :: targetWaitExitedNoWait (-> Int Int))
(pub fn (targetWaitExitedNoWait t)
  (if (|| (== t 0) (== t 1))
    36
    16777220))

; Whether the process lowering forks through libSystem's `fork` rather
; than the system call: on Darwin, and only in a module that already
; links pthreads. A raw `fork` leaves the child's libSystem holding the
; PARENT's Mach task port, so the first `pthread_create` the child makes
; faults (SIGSEGV, 139); `fork` runs libSystem's child handlers, which
; reset it. Linux's raw `fork`/`clone` leaves the child's pthreads
; working, and a module with no thread keeps its zero imports.
(pub :: parLibcFork (-> CG Int))
(pub fn (parLibcFork cg)
  (if (cgThreads cg)
    {
      (let t (cgTarget cg))
      (if (|| (== t 0) (== t 1))
        1
        0)
    }
    0))

(pub :: targetWait4Num (-> Int Int))
(pub fn (targetWait4Num t)
  (if (|| (== t 0) (== t 1))
    33554439
    (if (== t 2)
      260
      (if (== t 3)
        61
        7))))

(pub :: targetMunmapNum (-> Int Int))
(pub fn (targetMunmapNum t)
  (if (|| (== t 0) (== t 1))
    33554505
    (if (== t 2)
      215
      (if (== t 3)
        11
        73))))

; `kill`, for the registry sweep (MM-PAR-7): the numbers
; `stdlib/Sys/Platform.*.ax` carries as `sysKillNum`.
(pub :: targetKillNum (-> Int Int))
(pub fn (targetKillNum t)
  (if (|| (== t 0) (== t 1))
    33554469
    (if (== t 2)
      129
      (if (== t 3)
        62
        37))))

; MAP_SHARED|MAP_ANON: `targetMapFlags` with bit 1 (MAP_SHARED, 0x1)
; in place of bit 2 (MAP_PRIVATE, 0x2). The page a child writes its
; answer into must be the parent's page after a fork.
(pub :: targetMapSharedFlags (-> Int Int))
(pub fn (targetMapSharedFlags t)
  (if (|| (== t 0) (|| (== t 1) (|| (== t 4) (== t 5))))
    4097
    33))

; Does any function body in the module name `nm`? EXACT, unlike
; `mentions`, which answers 1 for a tag it does not know because that
; is the safe answer for the ownership questions it serves. Here the
; safe answer is the other one: a `handle` form read as "might name
; `__thread_spawn`" would put thread-local globals into every program
; that handles an effect, and the OFF path is the half this predicate
; exists to keep byte-identical. So every expression tag the parser
; produces is walked by its own layout, and a leaf answers 0.
(pub :: declsNamePrim (-> (Vec ASTNode) String Int Int))
(pub fn (declsNamePrim decls nm i)
  (if (>= i (vecLen decls))
    0
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN) (== (exprNamesPrim nm (nodeCChild d)) 1))
        1
        (declsNamePrim decls nm (+ i 1)))
    }))

(pub :: exprNamesPrim (-> String ASTNode Int))
(pub fn (exprNamesPrim nm e)
  (if (nodeSame e nilNode)
    0
    {
      (let tg (nodeTag e))
      (if (== tg TAG_E_VAR)
        (if (strEq (nodeAName e) nm)
          1
          0)
        (if (|| (== tg TAG_E_APP) (== tg TAG_E_IF))
          (if (== (exprNamesPrim nm (nodeAChild e)) 1)
            1
            (if (== (exprNamesPrim nm (nodeBChild e)) 1)
              1
              (exprNamesPrim nm (nodeCChild e))))
          (if (|| (== tg TAG_E_LET) (== tg TAG_E_LETM))
            (if (== (exprNamesPrim nm (nodeBChild e)) 1)
              1
              (exprNamesPrim nm (nodeCChild e)))
            (if (== tg TAG_E_LAM)
              (exprNamesPrim nm (nodeBChild e))
              (if (|| (== tg TAG_E_BEGIN) (== tg TAG_E_STRUCTCON))
                (exprsNamePrim nm
                  (if (== tg TAG_E_BEGIN)
                    (nodeAChildren e)
                    (nodeBChildren e))
                  0)
                (if (== tg TAG_E_WHILE)
                  (if (== (exprNamesPrim nm (nodeAChild e)) 1)
                    1
                    (exprsNamePrim nm (nodeBChildren e) 0))
                  ; A region's body is code like any other, and the
                  ; form itself answers to `region$`, a name no source
                  ; can spell (`resRegistryWanted`).
                  (if (== tg TAG_E_REGION)
                    (if (strEq nm "region$")
                      1
                      (exprNamesPrim nm (nodeBChild e)))
                    (if (== tg TAG_E_SET)
                      (exprNamesPrim nm (nodeBChild e))
                      (if (== tg TAG_E_FIELD)
                        (exprNamesPrim nm (nodeAChild e))
                        (if (== tg TAG_E_SETF)
                          (if (== (exprNamesPrim nm (nodeAChild e)) 1)
                            1
                            (exprNamesPrim nm (nodeCChild e)))
                          (if (== tg TAG_E_HANDLE)
                            (if (== (exprNamesPrim nm (nodeAChild e)) 1)
                              1
                              (exprNamesPrim nm (nodeCChild e)))
                            (if (== tg TAG_E_MATCH)
                              (if (== (exprNamesPrim nm (nodeAChild e)) 1)
                                1
                                (armsNamePrim nm (nodeBChildren e) 0))
                              ; `cond` is AX2004: the parser builds
                              ; none, so no arm names one.
                              ; INT, STR, FLT, CHAR, QUOTE: leaves
                              0))))))))))))
    }))

(pub :: exprsNamePrim (-> String (Vec ASTNode) Int Int))
(pub fn (exprsNamePrim nm v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (== (exprNamesPrim nm (vecGet v i)) 1)
        1
        (exprsNamePrim nm v (+ i 1))))))

; A match arm's word b is its body.
(pub :: armsNamePrim (-> String (Vec ASTNode) Int Int))
(pub fn (armsNamePrim nm v i)
  (if (== (as v Int) 0)
    0
    (if (>= i (vecLen v))
      0
      (if (== (exprNamesPrim nm (nodeBChild (vecGet v i))) 1)
        1
        (armsNamePrim nm v (+ i 1))))))

; Does the program want the THREAD lowering: `__thread_spawn` by name,
; or `__par_spawn` (every `parallel`) under `--threads`.
; A target with threads and no `fork` lowers `parallel` to threads
; without being asked: there is nothing else it could do with one.
(pub :: parThreadsByDefault (-> Int Bool))
;@axiom:effect(io)
(pub fn (parThreadsByDefault t)
  (&& (== (targetHasSpawn t) 0) (== (targetHasThreads t) 1)))

(pub :: parThreadsWanted (-> (Vec ASTNode) Int Bool))
;@axiom:effect(io)
(pub fn (parThreadsWanted decls t)
  (if (== (declsNamePrim decls "__thread_spawn" 0) 1)
    true
    (if (== (declsNamePrim decls "__par_spawn" 0) 1)
      (if (argHas "--threads" 1)
        true
        (parThreadsByDefault t))
      false)))

; Wanted, on a target that has no thread runtime - the build refusal
; `main.ax` reports as AX4006 before `emitResolved` runs.
(pub :: parThreadsRefused (-> (Vec ASTNode) Int Bool))
;@axiom:effect(io)
(pub fn (parThreadsRefused decls t)
  (if (== (targetHasThreads t) 1)
    false
    (parThreadsWanted decls t)))

(pub :: parAnyNamed (-> (Vec ASTNode) Int))
(pub fn (parAnyNamed decls)
  (if (== (declsNamePrim decls "__par_spawn" 0) 1)
    1
    (if (== (declsNamePrim decls "__par_join" 0) 1)
      1
      (if (== (declsNamePrim decls "__par_join_nr" 0) 1)
        1
        (if (== (declsNamePrim decls "__thread_spawn" 0) 1)
          1
          (if (== (declsNamePrim decls "__thread_join" 0) 1)
            1
            (if (== (declsNamePrim decls "__thread_join_nr" 0) 1)
              1
              (if (== (declsNamePrim decls "__proc_spawn" 0) 1)
                1
                (if (== (declsNamePrim decls "__proc_join" 0) 1)
                  1
                  (declsNamePrim decls "__proc_join_nr" 0))))))))))

; A program that names a spawn, on a target with NEITHER lowering -
; Windows, either architecture, which has no `fork` and no pthread.
; This is the build-time WARNING `main.ax` reports as AX4007, and warning rather
; than refusal is the whole of the decision:
;
;   * the module still EMITS, with every spawn and join lowered to
;     `@__axiom_par_unsupported` (`emitPrimParSpawn`). That is what
;     keeps `check-freestanding.sh`'s windows sweep and
;     `check-cross-targets.sh` able to compile the fixtures at all,
;     and it is the design `emitPrimPar`'s header states;
;   * a program whose `parallel` sits on a path it never takes builds
;     AND RUNS on windows today, and an error would break it for a
;     failure it would never have suffered;
;   * but "you will die at your first spawn, with status 79" is known
;     at BUILD time, and saying it then rather than at the first spawn
;     is free. AX4006 already moves the thread lowering's refusal to
;     build time; this moves the process lowering's SURPRISE there,
;     without moving the refusal with it.
(pub :: parSpawnUnsupported (-> (Vec ASTNode) Int Bool))
;@axiom:effect(io)
(pub fn (parSpawnUnsupported decls t)
  (if (== (targetHasSpawn t) 1)
    false
    (if (== (targetHasThreads t) 1)
      (== (procAnyNamed decls) 1)
      (== (parAnyNamed decls) 1))))

; The three process primitives by name: what a target with threads and
; no `fork` still cannot lower.
(pub :: procAnyNamed (-> (Vec ASTNode) Int))
(pub fn (procAnyNamed decls)
  (if (== (declsNamePrim decls "__proc_spawn" 0) 1)
    1
    (if (== (declsNamePrim decls "__proc_join" 0) 1)
      1
      (declsNamePrim decls "__proc_join_nr" 0))))

; The scan, once, before the allocator: slots 4 and 5 beside the pair
; state (`newCG` says why not two words of the record).
(pub :: parScan (-> CG (Vec ASTNode) CG))
;@axiom:effect(io)
(pub fn (parScan cg decls)
  {
    (cgSetParallelUsed cg (parAnyNamed decls))
    (cgSetHandleRuntime cg
      (if (== (parAnyNamed decls) 1)
        1
        (handleAnyNamed decls)))
    (cgSetThreadLowering cg
      (if (&& (== (targetHasThreads (cgTarget cg)) 1)
            (&& (== (declsNamePrim decls "__par_spawn" 0) 1)
              (|| (argHas "--threads" 1) (parThreadsByDefault (cgTarget cg)))))
        1
        0))
    (cgSetThreadsFlag cg
      (if (&& (== (targetHasThreads (cgTarget cg)) 1) (parThreadsWanted decls (cgTarget cg)))
        1
        0))
    (cgSetRegistry cg (resRegistryWanted decls))
    (cgSetArenaCap cg (declsNamePrim decls "__axiom_arena_cap" 0))
    (cgSetStackRun cg (declsNamePrim decls "__axiom_stack_run" 0))
    cg
  })

; The owner registry (`emitResourceRegistry`) is for a module that both
; makes resource owners and resets the arena: a recovery point, a
; region, or a raw reset. Any other module emits the runtime it did.
(pub :: resRegistryWanted (-> (Vec ASTNode) Int))
(pub fn (resRegistryWanted decls)
  (if (== (declsNamePrim decls "__resource_new" 0) 0)
    0
    (if (== (declsNamePrim decls "__axiom_recover" 0) 1)
      1
      (if (== (declsNamePrim decls "__axiom_arena_reset" 0) 1)
        1
        (if (== (declsNamePrim decls "__axiom_arena_reset_keeping" 0) 1)
          1
          (declsNamePrim decls "region$" 0))))))

; The runtime symbol a primitive lowers to: `__thread_*` and `__proc_*`
; say which, `__par_*` follows `--threads` (slot 10) - never the mere
; presence of a `__thread_spawn` elsewhere in the program, which is
; what slot 4 answers and what this read until 2026-09-27.
(pub :: parRuntimeSym (-> String String CG String))
(pub fn (parRuntimeSym fnName half cg)
  (concat "@__axiom_par_"
    (concat half
      (if (strStartsWith fnName "__thread_")
        "_thread"
        (if (strStartsWith fnName "__proc_")
          "_proc"
          (if (== (cgThreadLowering cg) 1)
            "_thread"
            "_proc"))))))

(pub :: emitPrimPar (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimPar fnName args cg)
  (if (isParBorrowName fnName)
    (emitPrimParBorrow fnName args cg)
    (if (isParSpawnName fnName)
      (emitPrimParSpawn fnName args cg)
      (emitPrimParJoin fnName args cg))))

; `(parallel$borrow 0)` answers a fresh borrow record,
; `(parallel$lends b {s ...})` lends it each `String` the checker put in
; the block (`capBorrowLend`), and `(parallel$return b)` restores every
; count lent to it, then frees it.
(pub :: emitPrimParBorrow (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimParBorrow fnName args cg)
  (if (strEq fnName "parallel$lends")
    (emitParLends args cg)
    (emitPrimParBorrowOne fnName args cg)))

(pub :: emitParLends (-> Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitParLends args cg)
  {
    (let cgB (emitExpr (vecGet args 0) cg))
    {
      (let b (strDup (cgResult cgB)))
      (let xs (nodeAChildren (vecGet args 1)))
      (let mut c cgB)
      (let mut i 0)
      {
        (while (< i (vecLen xs))
          {
            (set c (emitVar (vecGet xs i) c))
            (emitLine c
              (concat "  call void @__axiom_par_lend(i64 "
                (concat b (concat ", i64 " (concat (cgResult c) ")")))))
            (set i (+ i 1))
          })
        (cgSetResult c "0")
        (cgSetResultFloat c 0)
        c
      }
    }
  })

(pub :: emitPrimParBorrowOne (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimParBorrowOne fnName args cg)
  {
    (let cgA (emitExpr (vecGet args 0) cg))
    {
      (let a (strDup (cgResult cgA)))
      (let r (regStr (allocReg cgA)))
      {
        (if (strEq fnName "parallel$borrow")
          (emitLine cgA (concat (concat "  " r) " = call i64 @__axiom_par_borrow()"))
          (emitLine cgA
            (concat (concat "  " r)
              (concat " = call i64 @__axiom_par_return(i64 " (concat a ")")))))
        (cgSetResult cgA r)
        (cgSetResultFloat cgA 0)
        cgA
      }
    }
  })

; `(spawn thunk word)`. The thunk is owned by the handle from here to
; the join, which releases it: a lambda built AT the call moves its
; birth share in, anything else is retained first - `emitPrimRecover`'s
; rule for its thunk, for the same reason.
; Is this primitive lowered on this target, or is it the status-79
; trap: everything where there is a `fork`; on a target with threads
; and no `fork`, everything but the three process primitives.
(pub :: parPrimLowered (-> CG String Int))
(pub fn (parPrimLowered cg fnName)
  (if (== (targetHasSpawn (cgTarget cg)) 1)
    1
    (if (&& (cgThreads cg) (! (strStartsWith fnName "__proc_")))
      1
      0)))

(pub :: emitPrimParSpawn (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimParSpawn fnName args cg)
  {
    (let cgF (emitExpr (vecGet args 0) cg))
    {
      (let f (strDup (cgResult cgF)))
      {
        (let cgR
          (if (== (argIsDirectCon cgF (vecGet args 0)) 1)
            cgF
            (emitRetainOf cgF f)))
        {
          (let cgA (emitExpr (vecGet args 1) cgR))
          {
            (let a (strDup (cgResult cgA)))
            (let r (regStr (allocReg cgA)))
            {
              (if (== (parPrimLowered cgA fnName) 1)
                (emitLine cgA
                  (concat (concat "  " r)
                    (concat
                      (concat " = call i64 " (concat (parRuntimeSym fnName "spawn" cgA) "(i64 "))
                      (concat f (concat ", i64 " (concat a ")"))))))
                (emitLine cgA (concat (concat "  " r) " = call i64 @__axiom_par_unsupported()")))
              (cgSetResult cgA r)
              (cgSetResultFloat cgA 0)
              cgA
            }
          }
        }
      }
    }
  })

(pub :: emitPrimParJoin (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimParJoin fnName args cg)
  (if (isParJoinNrName fnName)
    (emitPrimParJoinNr fnName args cg)
    {
      (let cgH (emitExpr (vecGet args 0) cg))
      {
        (let h (strDup (cgResult cgH)))
        (let r (regStr (allocReg cgH)))
        {
          (if (== (parPrimLowered cgH fnName) 1)
            (emitLine cgH
              (concat (concat "  " r)
                (concat (concat " = call i64 " (concat (parRuntimeSym fnName "join" cgH) "(i64 "))
                  (concat h ")"))))
            (emitLine cgH (concat (concat "  " r) " = call i64 @__axiom_par_unsupported()")))
          (cgSetResult cgH r)
          (cgSetResultFloat cgH 0)
          cgH
        }
      }
    }))

; `(join_nr handle cell)`. Same call shape as a spawn's two arguments -
; the half is `join_nr`, so `parRuntimeSym` answers
; `@__axiom_par_join_nr_proc` or `@__axiom_par_join_nr_thread` by the
; same rule the raising join follows - and the same unsupported rule on
; a target with neither lowering: the trap, which never returns, so the
; cell it never writes is moot.
(pub :: emitPrimParJoinNr (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimParJoinNr fnName args cg)
  {
    (let cgH (emitExpr (vecGet args 0) cg))
    {
      (let h (strDup (cgResult cgH)))
      {
        (let cgC (emitExpr (vecGet args 1) cgH))
        {
          (let c (strDup (cgResult cgC)))
          (let r (regStr (allocReg cgC)))
          {
            (if (== (parPrimLowered cgC fnName) 1)
              (emitLine cgC
                (concat (concat "  " r)
                  (concat
                    (concat " = call i64 " (concat (parRuntimeSym fnName "join_nr" cgC) "(i64 "))
                    (concat h (concat ", i64 " (concat c ")"))))))
              (emitLine cgC (concat (concat "  " r) " = call i64 @__axiom_par_unsupported()")))
            (cgSetResult cgC r)
            (cgSetResultFloat cgC 0)
            cgC
          }
        }
      }
    }
  })

; A syscall call line for the runtime below: number and six operands.
(pub :: parSys (-> CG String String String))
(pub fn (parSys cg num rest)
  (concat "call i64 asm sideeffect "
    (concat (targetSyscallAsm (cgTarget cg))
      (concat (concat "(i64 " (concat num ", ")) (concat rest ")")))))

; The runtime, beside the allocator, and ONLY for a module that names
; a primitive (slot 5). The process half declares nothing; the thread
; half declares the two pthread entry points and is emitted only under
; `cgThreads`, so a module lowered to processes stays at zero imports.
; ------------------------------------------------------------------
; MM-PAR-6b: `parallel`'s borrow scope, in six functions.
;
; A borrow record is three words, `[entries, len, cap]`; an entry is
; two, `(block, saved count)`. `__axiom_par_lend` takes one immutable value a
; binding borrows, before any binding's closure is built: that block
; and every block it reaches through reference maps whose count is not
; negative has the count saved and replaced by -1, the static sentinel
; `axiom_retain` and `axiom_release` both leave alone (MM-LIFE-2k). So
; nothing a binding does changes a count the parent relies on, in
; either lowering. `__axiom_par_return` puts every count back, last lent
; first, before the form's body runs.
;
; EVERY RETAIN AND RELEASE BETWEEN THE LENDS AND THE RETURN IS A NO-OP
; on a lent block, the closures' own included: they are built after the
; lends and released at the joins, before the return. So the saved
; count is exactly the count to restore, with nothing to adjust.
;
; SOUND BECAUSE THE PARENT RUNS NOTHING BETWEEN THE LENDS AND THE
; RETURN but closure construction, spawns and joins. That is why only
; the desugaring of `parallel` names these, and why the checker lets
; only its thunks capture an immutable graph, and only one it lent
; (`capBorrowLend`). A trap that unwinds past the return leaves the lent
; blocks frozen, which leaks them and nothing else.
; ------------------------------------------------------------------
(pub :: emitParBorrowRuntime (-> CG CG))
(pub fn (emitParBorrowRuntime cg)
  {
    (emitLine cg "define internal i64 @__axiom_par_borrow() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %r = call i64 @axiom_alloc(i64 24)")
    (emitLine cg "  %hc = add i64 %r, -16")
    (emitLine cg "  %hcp = inttoptr i64 %hc to ptr")
    (emitLine cg "  store i64 1, ptr %hcp")
    (emitLine cg "  %p0 = inttoptr i64 %r to ptr")
    (emitLine cg "  store i64 0, ptr %p0")
    (emitLine cg "  %a1 = add i64 %r, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  store i64 0, ptr %p1")
    (emitLine cg "  %a2 = add i64 %r, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  store i64 0, ptr %p2")
    (emitLine cg "  ret i64 %r")
    (emitLine cg "}")
    (emitLine cg "")
    ; One entry appended, the entry array doubled when full. The copy
    ; is a loop: generated code calls no libc, and `llvm.memcpy` may
    ; lower to `memcpy`.
    (emitLine cg "define internal void @__axiom_par_push(i64 %rec, i64 %h, i64 %saved) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %p0 = inttoptr i64 %rec to ptr")
    (emitLine cg "  %a1 = add i64 %rec, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %a2 = add i64 %rec, 16")
    (emitLine cg "  %p2 = inttoptr i64 %a2 to ptr")
    (emitLine cg "  %buf = load i64, ptr %p0")
    (emitLine cg "  %len = load i64, ptr %p1")
    (emitLine cg "  %cap = load i64, ptr %p2")
    (emitLine cg "  %full = icmp eq i64 %len, %cap")
    (emitLine cg "  br i1 %full, label %grow, label %put")
    (emitLine cg "grow:")
    (emitLine cg "  %cap2 = shl i64 %cap, 1")
    (emitLine cg "  %none = icmp eq i64 %cap, 0")
    (emitLine cg "  %ncap = select i1 %none, i64 8, i64 %cap2")
    (emitLine cg "  %nbytes = mul i64 %ncap, 16")
    (emitLine cg "  %nb = call i64 @axiom_alloc(i64 %nbytes)")
    (emitLine cg "  %nbc = add i64 %nb, -16")
    (emitLine cg "  %nbcp = inttoptr i64 %nbc to ptr")
    (emitLine cg "  store i64 1, ptr %nbcp")
    (emitLine cg "  %words = mul i64 %len, 2")
    (emitLine cg "  br label %copy")
    (emitLine cg "copy:")
    (emitLine cg "  %ci = phi i64 [ 0, %grow ], [ %ci1, %copyone ]")
    (emitLine cg "  %cdone = icmp uge i64 %ci, %words")
    (emitLine cg "  br i1 %cdone, label %copied, label %copyone")
    (emitLine cg "copyone:")
    (emitLine cg "  %coff = shl i64 %ci, 3")
    (emitLine cg "  %csrc = add i64 %buf, %coff")
    (emitLine cg "  %csrcp = inttoptr i64 %csrc to ptr")
    (emitLine cg "  %cw = load i64, ptr %csrcp")
    (emitLine cg "  %cdst = add i64 %nb, %coff")
    (emitLine cg "  %cdstp = inttoptr i64 %cdst to ptr")
    (emitLine cg "  store i64 %cw, ptr %cdstp")
    (emitLine cg "  %ci1 = add i64 %ci, 1")
    (emitLine cg "  br label %copy")
    (emitLine cg "copied:")
    (emitLine cg "  %hadbuf = icmp ne i64 %buf, 0")
    (emitLine cg "  br i1 %hadbuf, label %freeold, label %setnew")
    (emitLine cg "freeold:")
    (emitLine cg "  call void @axiom_release(i64 %buf)")
    (emitLine cg "  br label %setnew")
    (emitLine cg "setnew:")
    (emitLine cg "  store i64 %nb, ptr %p0")
    (emitLine cg "  store i64 %ncap, ptr %p2")
    (emitLine cg "  br label %put")
    (emitLine cg "put:")
    (emitLine cg "  %b = load i64, ptr %p0")
    (emitLine cg "  %eoff = mul i64 %len, 16")
    (emitLine cg "  %e0 = add i64 %b, %eoff")
    (emitLine cg "  %e0p = inttoptr i64 %e0 to ptr")
    (emitLine cg "  store i64 %h, ptr %e0p")
    (emitLine cg "  %e1 = add i64 %e0, 8")
    (emitLine cg "  %e1p = inttoptr i64 %e1 to ptr")
    (emitLine cg "  store i64 %saved, ptr %e1p")
    (emitLine cg "  %len1 = add i64 %len, 1")
    (emitLine cg "  store i64 %len1, ptr %p1")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; One block: frozen and recorded when its count is live; a static,
    ; a block already lent and an immediate are left alone.
    (emitLine cg "define internal void @__axiom_par_visit(i64 %rec, i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %imm = icmp slt i64 %h, 4096")
    (emitLine cg "  br i1 %imm, label %done, label %chk")
    (emitLine cg "chk:")
    (emitLine cg "  %hc = add i64 %h, -16")
    (emitLine cg "  %hcp = inttoptr i64 %hc to ptr")
    (emitLine cg "  %c = load i64, ptr %hcp")
    (emitLine cg "  %neg = icmp slt i64 %c, 0")
    (emitLine cg "  br i1 %neg, label %done, label %freeze")
    (emitLine cg "freeze:")
    (emitLine cg "  call void @__axiom_par_push(i64 %rec, i64 %h, i64 %c)")
    (emitLine cg "  store i64 -1, ptr %hcp")
    (emitLine cg "  br label %done")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; Every reference word of block `b`, by its shape (MM-LIFE-2d): the
    ; bitmap of a record, or all `n` words of an array block, whose
    ; length sits where a record keeps its bitmap. A foreign block's
    ; payload is not Axiom's to walk.
    (emitLine cg "define internal void @__axiom_par_kids(i64 %rec, i64 %b) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %imm = icmp slt i64 %b, 4096")
    (emitLine cg "  br i1 %imm, label %done, label %shape")
    (emitLine cg "shape:")
    (emitLine cg "  %sq = add i64 %b, -8")
    (emitLine cg "  %sqp = inttoptr i64 %sq to ptr")
    (emitLine cg "  %shw = load i64, ptr %sqp")
    (emitLine cg "  %form = and i64 %shw, 1")
    (emitLine cg "  %foreign = icmp ne i64 %form, 0")
    (emitLine cg "  br i1 %foreign, label %done, label %kind")
    (emitLine cg "kind:")
    (emitLine cg "  %map = lshr i64 %shw, 16")
    (emitLine cg "  %aform = and i64 %shw, 32768")
    (emitLine cg "  %isarr = icmp ne i64 %aform, 0")
    (emitLine cg "  br i1 %isarr, label %arr, label %bits")
    (emitLine cg "arr:")
    (emitLine cg "  %ai = phi i64 [ 0, %kind ], [ %ai1, %arrone ]")
    (emitLine cg "  %aend = icmp uge i64 %ai, %map")
    (emitLine cg "  br i1 %aend, label %done, label %arrone")
    (emitLine cg "arrone:")
    (emitLine cg "  %aoff = shl i64 %ai, 3")
    (emitLine cg "  %aw = add i64 %b, %aoff")
    (emitLine cg "  %awp = inttoptr i64 %aw to ptr")
    (emitLine cg "  %av = load i64, ptr %awp")
    (emitLine cg "  call void @__axiom_par_visit(i64 %rec, i64 %av)")
    (emitLine cg "  %ai1 = add i64 %ai, 1")
    (emitLine cg "  br label %arr")
    (emitLine cg "bits:")
    (emitLine cg "  %m = phi i64 [ %map, %kind ], [ %m1, %bitnext ]")
    (emitLine cg "  %bi = phi i64 [ 0, %kind ], [ %bi1, %bitnext ]")
    (emitLine cg "  %mzero = icmp eq i64 %m, 0")
    (emitLine cg "  br i1 %mzero, label %done, label %bittest")
    (emitLine cg "bittest:")
    (emitLine cg "  %bit = and i64 %m, 1")
    (emitLine cg "  %isref = icmp ne i64 %bit, 0")
    (emitLine cg "  br i1 %isref, label %bitref, label %bitnext")
    (emitLine cg "bitref:")
    (emitLine cg "  %boff = shl i64 %bi, 3")
    (emitLine cg "  %bw = add i64 %b, %boff")
    (emitLine cg "  %bwp = inttoptr i64 %bw to ptr")
    (emitLine cg "  %bv = load i64, ptr %bwp")
    (emitLine cg "  call void @__axiom_par_visit(i64 %rec, i64 %bv)")
    (emitLine cg "  br label %bitnext")
    (emitLine cg "bitnext:")
    (emitLine cg "  %m1 = lshr i64 %m, 1")
    (emitLine cg "  %bi1 = add i64 %bi, 1")
    (emitLine cg "  br label %bits")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; The block itself, then every entry this lend added, walked in
    ; turn for what it reaches: the entry list is the work queue, so
    ; there is no recursion and no depth limit.
    (emitLine cg "define internal void @__axiom_par_lend(i64 %rec, i64 %h) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %a1 = add i64 %rec, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %start = load i64, ptr %p1")
    (emitLine cg "  call void @__axiom_par_visit(i64 %rec, i64 %h)")
    (emitLine cg "  br label %deep")
    (emitLine cg "deep:")
    (emitLine cg "  %i = phi i64 [ %start, %entry ], [ %i1, %deepone ]")
    (emitLine cg "  %len = load i64, ptr %p1")
    (emitLine cg "  %end = icmp uge i64 %i, %len")
    (emitLine cg "  br i1 %end, label %done, label %deepone")
    (emitLine cg "deepone:")
    (emitLine cg "  %p0 = inttoptr i64 %rec to ptr")
    (emitLine cg "  %buf = load i64, ptr %p0")
    (emitLine cg "  %eoff = mul i64 %i, 16")
    (emitLine cg "  %e0 = add i64 %buf, %eoff")
    (emitLine cg "  %e0p = inttoptr i64 %e0 to ptr")
    (emitLine cg "  %eh = load i64, ptr %e0p")
    (emitLine cg "  call void @__axiom_par_kids(i64 %rec, i64 %eh)")
    (emitLine cg "  %i1 = add i64 %i, 1")
    (emitLine cg "  br label %deep")
    (emitLine cg "done:")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    ; Last lent, first restored. Then the entry array and the record go
    ; back.
    (emitLine cg "define internal i64 @__axiom_par_return(i64 %rec) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %p0 = inttoptr i64 %rec to ptr")
    (emitLine cg "  %buf = load i64, ptr %p0")
    (emitLine cg "  %a1 = add i64 %rec, 8")
    (emitLine cg "  %p1 = inttoptr i64 %a1 to ptr")
    (emitLine cg "  %len = load i64, ptr %p1")
    (emitLine cg "  br label %loop")
    (emitLine cg "loop:")
    (emitLine cg "  %i = phi i64 [ %len, %entry ], [ %i1, %one ]")
    (emitLine cg "  %end = icmp eq i64 %i, 0")
    (emitLine cg "  br i1 %end, label %free, label %one")
    (emitLine cg "one:")
    (emitLine cg "  %i1 = add i64 %i, -1")
    (emitLine cg "  %eoff = mul i64 %i1, 16")
    (emitLine cg "  %e0 = add i64 %buf, %eoff")
    (emitLine cg "  %e0p = inttoptr i64 %e0 to ptr")
    (emitLine cg "  %eh = load i64, ptr %e0p")
    (emitLine cg "  %e1 = add i64 %e0, 8")
    (emitLine cg "  %e1p = inttoptr i64 %e1 to ptr")
    (emitLine cg "  %es = load i64, ptr %e1p")
    (emitLine cg "  %hc = add i64 %eh, -16")
    (emitLine cg "  %hcp = inttoptr i64 %hc to ptr")
    (emitLine cg "  store i64 %es, ptr %hcp")
    (emitLine cg "  br label %loop")
    (emitLine cg "free:")
    (emitLine cg "  %hadbuf = icmp ne i64 %buf, 0")
    (emitLine cg "  br i1 %hadbuf, label %freebuf, label %freerec")
    (emitLine cg "freebuf:")
    (emitLine cg "  call void @axiom_release(i64 %buf)")
    (emitLine cg "  br label %freerec")
    (emitLine cg "freerec:")
    (emitLine cg "  call void @axiom_release(i64 %rec)")
    (emitLine cg "  ret i64 0")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

(pub :: emitParRuntime (-> CG CG))
(pub fn (emitParRuntime cg)
  (if (== (cgParallelUsed cg) 0)
    cg
    (if (== (targetHasSpawn (cgTarget cg)) 1)
      {
        (emitParTrap cg)
        (emitParCommon cg)
        (emitParProc cg)
        (emitParBorrowRuntime cg)
        (if (cgThreads cg)
          (emitParThread cg))
        cg
      }
      (if (cgThreads cg)
        ; threads and no `fork`, which is Windows: the common half, the
        ; thread half over kernel32, and the trap for the process
        ; primitives, which have nothing to fork with.
        {
          (emitParTrap cg)
          (emitParCommon cg)
          (emitParBorrowRuntime cg)
          (emitParThreadWin cg)
          (emitParUnsupported cg)
          cg
        }
        {
          (emitParUnsupported cg)
          (emitParBorrowRuntime cg)
          cg
        }))))

; A spawn's page gets its handle (MM-PAR-8), after the thunk and its
; word are on it and before any child exists: a table with no slot
; left fails the spawn as a refused fork does (78), through
; `@__axiom_par_finish`, which returns the thunk's share and the page.
; The handle goes in word 13 and its kind in word 14, where `finish`
; retires it. A forked binding's handle is kind 1 and a thread's kind
; 5, so a join of one lowering's handle by the other's join traps 85
; instead of reading a pid as a `pthread_t`, and `__spawn_pid` answers
; only a process's pid.
(pub :: emitParNameHandle (-> CG Int CG))
(pub fn (emitParNameHandle cg kind)
  {
    (emitLine cg
      (concat "  %hw = call i64 @__axiom_handle_new(i64 " (concat (fmtInt kind) ", i64 %page)")))
    (emitLine cg "  %hnone = icmp eq i64 %hw, 0")
    (emitLine cg "  br i1 %hnone, label %nohandle, label %named")
    (emitLine cg "nohandle:")
    (emitLine cg "  %dnh = call i64 @__axiom_par_finish(i64 %page)")
    (emitLine cg "  call i64 @__axiom_par_spawn_failed()")
    (emitLine cg "  unreachable")
    (emitLine cg "named:")
    (emitLine cg "  %p13 = getelementptr i64, ptr %hp, i64 13")
    (emitLine cg "  store i64 %hw, ptr %p13")
    (emitLine cg "  %p14 = getelementptr i64, ptr %hp, i64 14")
    (emitLine cg (concat "  store i64 " (concat (fmtInt kind) ", ptr %p14")))
    cg
  })

; A join's first line: the page the handle `%hw` names, as `%h`, or the
; 85 trap for a handle that is not a live spawn handle of `kind`.
(pub :: emitParJoinPage (-> CG Int CG))
(pub fn (emitParJoinPage cg kind)
  {
    (emitLine cg
      (concat "  %h = call i64 @__axiom_handle_get(i64 " (concat (fmtInt kind) ", i64 %hw)")))
    cg
  })

; ------------------------------------------------------------------
; THE HANDLE TABLE (docs/memory-model.md MM-PAR-8), and status 85.
;
; A typed handle - a spawn's, a channel, a mutex, a cancellation token -
; is a WORD naming a slot in one table, and the table says whether the
; slot is live. That is where a handle's liveness has to live: not in the object,
; whose mapping a free unmaps (a check that read it would be the fault
; it exists to prevent), and not in the word, which is copied freely.
;
;   handle word   (generation << 16) | index        generation >= 1
;   slot state    (generation << 9) | (live << 8) | kind
;   slot payload  the address it names; while free, the next free
;                 index + 1
;
; `@__axiom_handle_get kind h` answers the payload when the slot's
; state is exactly what `h` and `kind` say a live slot's is, and traps
; 85 otherwise: freed (the generation moved on, or the live bit is
; clear), forged, or another kind's. It reads the state on both sides
; of the payload, so a free that lands between never hands back the
; free-list link as an address. It reads nothing the handle's object
; owns, so a freed object's unmapped pages are never touched.
; `@__axiom_handle_free` retires the slot with ONE compare-and-swap on
; the state, so of two frees of one handle exactly one succeeds and the
; other traps 85, and then pushes the slot on a free list whose head
; carries a 47-bit tag against ABA. Nothing here takes a lock or
; allocates: a get is four atomic loads, which is what a channel
; operation pays for its check.
;
; ONE TABLE PER ADDRESS SPACE. The root, `@__axiom_htab`, is a plain
; global even under `--threads`: every thread must ask the same table,
; as every thread sees the same mappings. The table is `MAP_PRIVATE`
; and mapped on first use, so a forked binding inherits a COPY - its
; handles are the parent's as they were at the fork and its frees are
; its own, exactly as its mappings are: a child's `munmap` leaves the
; parent's mapping in place, and the child's table says so. 65,536
; slots of 16 bytes, one megabyte of address space touched a page at a
; time; `__handle_new` answers 0 when all are live, which a library
; answers as an error and a spawn as 78.
;
; A MODULE THAT NAMES NO HANDLE OR SPAWN PRIMITIVE EMITS NONE OF THIS
; (slot 13), so its IR is byte for byte what it was.
; ------------------------------------------------------------------
(pub :: handleAnyNamed (-> (Vec ASTNode) Int))
(pub fn (handleAnyNamed decls)
  (if (== (declsNamePrim decls "__handle_new" 0) 1)
    1
    (if (== (declsNamePrim decls "__handle_get" 0) 1)
      1
      (if (== (declsNamePrim decls "__handle_free" 0) 1)
        1
        (declsNamePrim decls "__spawn_pid" 0)))))

(pub :: isHandlePrimName (-> String Bool))
(pub fn (isHandlePrimName nm)
  (if (strEq nm "__handle_new")
    true
    (if (strEq nm "__handle_get")
      true
      (if (strEq nm "__handle_free")
        true
        (strEq nm "__spawn_pid")))))

; The table's slot count and its mapping's length: a 64-byte header
; (free-list head, bump index, the salt `emitHandleFirstGen` reads) and
; 65,536 slots of 16 bytes, rounded up to pages. An index is the
; handle's low 16 bits, so every index a word can spell is inside the
; mapping.
(pub :: handleSlots Int)
(pub fn (handleSlots)
  65536)

(pub :: handleTableBytes Int)
(pub fn (handleTableBytes)
  1052672)

; `(__handle_new kind addr)`, `(__handle_get kind h)` and
; `(__handle_free kind h)`: two words in, one word out, each a call to
; the runtime below. `(__spawn_pid h)`: the pid in word 0 of the page a
; live process spawn's handle names, asked of the table first.
(pub :: emitPrimHandle (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimHandle fnName args cg)
  (if (strEq fnName "__spawn_pid")
    {
      (let cgH (emitExpr (vecGet args 0) cg))
      {
        (let h (strDup (cgResult cgH)))
        (let pg (regStr (allocReg cgH)))
        (let pp (regStr (allocReg cgH)))
        (let r (regStr (allocReg cgH)))
        {
          (emitLine cgH
            (concat "  "
              (concat pg (concat " = call i64 @__axiom_handle_get(i64 1, i64 " (concat h ")")))))
          (emitLine cgH (concat "  " (concat pp (concat " = inttoptr i64 " (concat pg " to ptr")))))
          (emitLine cgH (concat "  " (concat r (concat " = load i64, ptr " pp))))
          (cgSetResult cgH r)
          (cgSetResultFloat cgH 0)
          cgH
        }
      }
    }
    (emitPrimHandleCall fnName args cg)))

(pub :: emitPrimHandleCall (-> String Nodes CG CG))
;@axiom:effect(io)
(pub fn (emitPrimHandleCall fnName args cg)
  {
    (let cgK (emitExpr (vecGet args 0) cg))
    {
      (let k (strDup (cgResult cgK)))
      {
        (let cgV (emitExpr (vecGet args 1) cgK))
        {
          (let v (strDup (cgResult cgV)))
          (let r (regStr (allocReg cgV)))
          (let fn
            (if (strEq fnName "__handle_new")
              "@__axiom_handle_new"
              (if (strEq fnName "__handle_get")
                "@__axiom_handle_get"
                "@__axiom_handle_free")))
          {
            (emitLine cgV
              (concat "  "
                (concat r
                  (concat " = call i64 "
                    (concat fn (concat "(i64 " (concat k (concat ", i64 " (concat v ")")))))))))
            (cgSetResult cgV r)
            (cgSetResultFloat cgV 0)
            cgV
          }
        }
      }
    }
  })

; A SLOT'S FIRST GENERATION IS NOT 1. With every slot starting at 1,
; the first handle a program made was always the word 65,536, the next
; 65,537, and a trusted declaration that cast a guessed word to `Spawn`
; joined a live child it never spawned: a scan of words from 0 joined
; the first child and took its answer, and its owner's own join then
; trapped 85. So a slot used for the first time starts at a generation
; drawn from a salt - the table's own address, which the kernel
; places, mixed with the counter read when the table is made - spread
; per slot by SplitMix64's finalizer. A generation is 1 to 2^40, so a
; word no spawn answered names a live slot with a chance near 2^-40,
; and traps 85 instead. A reused slot still moves to the next
; generation, and a word keeps its shape, `(generation << 16) | index`:
; positive, and at least 65,536. This defends against a word that is
; wrong, not one read out of memory: the unsafe layer can read the
; table, and the salt is no secret from it (MM-PAR-8).
;
; The salt is word 2 of the table's header, stored before the install's
; compare-and-swap publishes the table.
(pub :: emitHandleSalt (-> CG Int CG))
(pub fn (emitHandleSalt cg t)
  {
    (if (targetIsAArch64 t)
      (emitLine cg "  %ctr = call i64 asm sideeffect \"mrs $0, cntvct_el0\", \"=r,~{memory}\"()")
      (emitLine cg
        "  %ctr = call i64 asm sideeffect \"rdtsc\\0Ashlq $$32, %rdx\\0Aorq %rdx, %rax\", \"={ax},~{dx},~{dirflag},~{fpsr},~{flags},~{memory}\"()"))
    (emitLine cg "  %salt = xor i64 %ctr, %m")
    (emitLine cg "  %saltp0 = add i64 %m, 16")
    (emitLine cg "  %saltp = inttoptr i64 %saltp0 to ptr")
    (emitLine cg "  store atomic i64 %salt, ptr %saltp seq_cst, align 8")
    cg
  })

; `@__axiom_handle_first_gen(t, idx)`: SplitMix64's finalizer over the
; salt plus the index, cut to 40 bits, plus one: 1 to 2^40.
(pub :: emitHandleFirstGen (-> CG CG))
(pub fn (emitHandleFirstGen cg)
  {
    (emitLine cg "define internal i64 @__axiom_handle_first_gen(i64 %t, i64 %idx) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %saltp0 = add i64 %t, 16")
    (emitLine cg "  %saltp = inttoptr i64 %saltp0 to ptr")
    (emitLine cg "  %salt = load atomic i64, ptr %saltp seq_cst, align 8")
    (emitLine cg "  %x = add i64 %salt, %idx")
    (emitLine cg "  %z0 = add i64 %x, -7046029254386353131")
    (emitLine cg "  %z1s = lshr i64 %z0, 30")
    (emitLine cg "  %z1x = xor i64 %z0, %z1s")
    (emitLine cg "  %z1 = mul i64 %z1x, -4658895280553007687")
    (emitLine cg "  %z2s = lshr i64 %z1, 27")
    (emitLine cg "  %z2x = xor i64 %z1, %z2s")
    (emitLine cg "  %z2 = mul i64 %z2x, -7723592293110705685")
    (emitLine cg "  %z3s = lshr i64 %z2, 31")
    (emitLine cg "  %z3 = xor i64 %z2, %z3s")
    (emitLine cg "  %g40 = lshr i64 %z3, 24")
    (emitLine cg "  %g = add i64 %g40, 1")
    (emitLine cg "  ret i64 %g")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

(pub :: emitHandleRuntime (-> CG CG))
(pub fn (emitHandleRuntime cg)
  (if (== (cgHandleRuntime cg) 0)
    cg
    {
      (let t (cgTarget cg))
      {
        (emitLine cg "")
        (emitLine cg "@__axiom_htab = internal global i64 0")
        ; Status 85, recoverable as the index trap is: a use of a word
        ; that is not a live handle of the kind asked for - a freed
        ; one, a second free of one, a forged one. The declared length
        ; is the message's byte count exactly, newline included.
        (emitLine cg
          "@__axiom_handle_msg = private unnamed_addr constant [48 x i8] c\"axiom: not a live handle (freed, or never made)\\0A\"")
        (emitLine cg
          (concat "define internal i64 @__axiom_handle_dead() " (concat trapFnAttrs " {")))
        (emitLine cg "entry:")
        (emitLine cg "  call i64 @__axiom_recover_abort(i64 85)")
        (emitLine cg "  %hmp = ptrtoint ptr @__axiom_handle_msg to i64")
        (emitRuntimeWrite cg "%hmp" "48")
        (emitLine cg "  call void @__axiom_backtrace()")
        (emitRuntimeExit cg "85")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        (emitLine cg "")
        ; The table, mapped on first use and installed with one
        ; compare-and-swap: of two threads racing to make it, the loser
        ; unmaps its own and uses the winner's. 0 where no table can be
        ; mapped - a target with no syscall ABI, or `mmap` refused.
        (emitLine cg "define internal i64 @__axiom_handle_tab() #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %t = load atomic i64, ptr @__axiom_htab seq_cst, align 8")
        (emitLine cg "  %have = icmp ne i64 %t, 0")
        (emitLine cg "  br i1 %have, label %done, label %make")
        (emitLine cg "make:")
        (if (== (targetUsesSyscallAsm t) 1)
          {
            (emitLine cg
              (concat "  %m = "
                (parSys cg (fmtInt (targetMmapNum t))
                  (concat "i64 0, i64 "
                    (concat (fmtInt handleTableBytes)
                      (concat ", i64 3, i64 "
                        (concat (fmtInt (targetMapFlags t)) ", i64 -1, i64 0")))))))
            (emitLine cg "  %low = icmp ult i64 %m, 4096")
            (emitLine cg "  %neg = icmp slt i64 %m, 0")
            (emitLine cg "  %bad = or i1 %low, %neg")
            (emitLine cg "  br i1 %bad, label %none, label %install")
            (emitLine cg "install:")
            ; The salt goes in before the table is published, so every
            ; thread that can find the table finds it salted.
            (emitHandleSalt cg t)
            (emitLine cg "  %cx = cmpxchg ptr @__axiom_htab, i64 0, i64 %m seq_cst seq_cst")
            (emitLine cg "  %won = extractvalue { i64, i1 } %cx, 1")
            (emitLine cg "  br i1 %won, label %mine, label %lost")
            (emitLine cg "mine:")
            (emitLine cg "  ret i64 %m")
            (emitLine cg "lost:")
            (emitLine cg "  %old = extractvalue { i64, i1 } %cx, 0")
            (emitLine cg
              (concat "  %un = "
                (parSys cg (fmtInt (targetMunmapNum t))
                  (concat "i64 %m, i64 "
                    (concat (fmtInt handleTableBytes) ", i64 0, i64 0, i64 0, i64 0")))))
            (emitLine cg "  ret i64 %old")
          }
          (if (|| (== t 6) (== t 8))
            ; Windows: the same table from `VirtualAlloc`
            ; (MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE), published by the
            ; same compare-and-swap, the loser's released with
            ; `VirtualFree(MEM_RELEASE)`. Bare metal keeps no table.
            {
              (emitLine cg
                (concat "  %m = call i64 @VirtualAlloc(i64 0, i64 "
                  (concat (fmtInt handleTableBytes) ", i64 12288, i64 4)")))
              (emitLine cg "  %bad = icmp eq i64 %m, 0")
              (emitLine cg "  br i1 %bad, label %none, label %install")
              (emitLine cg "install:")
              (emitHandleSalt cg t)
              (emitLine cg "  %cx = cmpxchg ptr @__axiom_htab, i64 0, i64 %m seq_cst seq_cst")
              (emitLine cg "  %won = extractvalue { i64, i1 } %cx, 1")
              (emitLine cg "  br i1 %won, label %mine, label %lost")
              (emitLine cg "mine:")
              (emitLine cg "  ret i64 %m")
              (emitLine cg "lost:")
              (emitLine cg "  %old = extractvalue { i64, i1 } %cx, 0")
              (emitLine cg "  %un = call i64 @VirtualFree(i64 %m, i64 0, i64 32768)")
              (emitLine cg "  ret i64 %old")
            }
            (emitLine cg "  br label %none")))
        (emitLine cg "none:")
        (emitLine cg "  ret i64 0")
        (emitLine cg "done:")
        (emitLine cg "  ret i64 %t")
        (emitLine cg "}")
        (emitLine cg "")
        ; A slot's address: the table, its 64-byte header, 16 bytes a slot.
        (emitLine cg "define internal i64 @__axiom_handle_slot(i64 %t, i64 %idx) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %off = shl i64 %idx, 4")
        (emitLine cg "  %base = add i64 %t, 64")
        (emitLine cg "  %e = add i64 %base, %off")
        (emitLine cg "  ret i64 %e")
        (emitLine cg "}")
        (emitLine cg "")
        ; A fresh handle naming `%addr`: a slot off the free list, else
        ; the next never-used one, else 0.
        (emitLine cg "define internal i64 @__axiom_handle_new(i64 %kind, i64 %addr) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %t = call i64 @__axiom_handle_tab()")
        (emitLine cg "  %no = icmp eq i64 %t, 0")
        (emitLine cg "  br i1 %no, label %full, label %pop")
        (emitLine cg "pop:")
        (emitLine cg "  %hp = inttoptr i64 %t to ptr")
        (emitLine cg "  %head = load atomic i64, ptr %hp seq_cst, align 8")
        (emitLine cg "  %hidx1 = and i64 %head, 131071")
        (emitLine cg "  %empty = icmp eq i64 %hidx1, 0")
        (emitLine cg "  br i1 %empty, label %bump, label %take")
        (emitLine cg "take:")
        (emitLine cg "  %tidx = sub i64 %hidx1, 1")
        (emitLine cg "  %te = call i64 @__axiom_handle_slot(i64 %t, i64 %tidx)")
        (emitLine cg "  %tl = add i64 %te, 8")
        (emitLine cg "  %tlp = inttoptr i64 %tl to ptr")
        (emitLine cg "  %next = load atomic i64, ptr %tlp seq_cst, align 8")
        (emitLine cg "  %nextm = and i64 %next, 131071")
        (emitLine cg "  %tag = lshr i64 %head, 17")
        (emitLine cg "  %tag1 = add i64 %tag, 1")
        (emitLine cg "  %nh0 = shl i64 %tag1, 17")
        (emitLine cg "  %nh = or i64 %nh0, %nextm")
        (emitLine cg "  %cx = cmpxchg ptr %hp, i64 %head, i64 %nh seq_cst seq_cst")
        (emitLine cg "  %popped = extractvalue { i64, i1 } %cx, 1")
        (emitLine cg "  br i1 %popped, label %fill, label %pop")
        (emitLine cg "bump:")
        (emitLine cg "  %bp = getelementptr i64, ptr %hp, i64 1")
        (emitLine cg "  %bidx = atomicrmw add ptr %bp, i64 1 seq_cst")
        (emitLine cg (concat "  %over = icmp uge i64 %bidx, " (fmtInt handleSlots)))
        (emitLine cg "  br i1 %over, label %full, label %fill")
        (emitLine cg "fill:")
        (emitLine cg "  %idx = phi i64 [ %tidx, %take ], [ %bidx, %bump ]")
        (emitLine cg "  %e = call i64 @__axiom_handle_slot(i64 %t, i64 %idx)")
        (emitLine cg "  %sp = inttoptr i64 %e to ptr")
        (emitLine cg "  %st = load atomic i64, ptr %sp seq_cst, align 8")
        ; A slot never used before starts at the generation its salt
        ; and index give it; a reused one moves to the next.
        (emitLine cg "  %unused = icmp eq i64 %st, 0")
        (emitLine cg "  %g0 = lshr i64 %st, 9")
        (emitLine cg "  %gnext = add i64 %g0, 1")
        (emitLine cg "  %gfirst = call i64 @__axiom_handle_first_gen(i64 %t, i64 %idx)")
        (emitLine cg "  %g = select i1 %unused, i64 %gfirst, i64 %gnext")
        (emitLine cg "  %pa = add i64 %e, 8")
        (emitLine cg "  %pp = inttoptr i64 %pa to ptr")
        (emitLine cg "  store atomic i64 %addr, ptr %pp seq_cst, align 8")
        (emitLine cg "  %km = and i64 %kind, 255")
        (emitLine cg "  %gs = shl i64 %g, 9")
        (emitLine cg "  %gl = or i64 %gs, 256")
        (emitLine cg "  %ns = or i64 %gl, %km")
        (emitLine cg "  store atomic i64 %ns, ptr %sp seq_cst, align 8")
        (emitLine cg "  %hg = shl i64 %g, 16")
        (emitLine cg "  %h = or i64 %hg, %idx")
        (emitLine cg "  ret i64 %h")
        (emitLine cg "full:")
        (emitLine cg "  ret i64 0")
        (emitLine cg "}")
        (emitLine cg "")
        (emitHandleFirstGen cg)
        ; The state a live handle `%h` of `%kind` must find in its slot.
        (emitLine cg "define internal i64 @__axiom_handle_want(i64 %kind, i64 %h) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %gen = lshr i64 %h, 16")
        (emitLine cg "  %gs = shl i64 %gen, 9")
        (emitLine cg "  %gl = or i64 %gs, 256")
        (emitLine cg "  %km = and i64 %kind, 255")
        (emitLine cg "  %w = or i64 %gl, %km")
        (emitLine cg "  ret i64 %w")
        (emitLine cg "}")
        (emitLine cg "")
        (emitLine cg "define internal i64 @__axiom_handle_get(i64 %kind, i64 %h) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %t = load atomic i64, ptr @__axiom_htab seq_cst, align 8")
        (emitLine cg "  %no = icmp eq i64 %t, 0")
        (emitLine cg "  br i1 %no, label %dead, label %look")
        (emitLine cg "look:")
        (emitLine cg "  %idx = and i64 %h, 65535")
        (emitLine cg "  %e = call i64 @__axiom_handle_slot(i64 %t, i64 %idx)")
        (emitLine cg "  %sp = inttoptr i64 %e to ptr")
        (emitLine cg "  %want = call i64 @__axiom_handle_want(i64 %kind, i64 %h)")
        (emitLine cg "  %s1 = load atomic i64, ptr %sp seq_cst, align 8")
        (emitLine cg "  %ok1 = icmp eq i64 %s1, %want")
        (emitLine cg "  br i1 %ok1, label %read, label %dead")
        (emitLine cg "read:")
        (emitLine cg "  %pa = add i64 %e, 8")
        (emitLine cg "  %pp = inttoptr i64 %pa to ptr")
        (emitLine cg "  %v = load atomic i64, ptr %pp seq_cst, align 8")
        (emitLine cg "  %s2 = load atomic i64, ptr %sp seq_cst, align 8")
        (emitLine cg "  %ok2 = icmp eq i64 %s2, %want")
        (emitLine cg "  br i1 %ok2, label %good, label %dead")
        (emitLine cg "good:")
        (emitLine cg "  ret i64 %v")
        (emitLine cg "dead:")
        (emitLine cg "  %x = call i64 @__axiom_handle_dead()")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        (emitLine cg "")
        (emitLine cg "define internal i64 @__axiom_handle_free(i64 %kind, i64 %h) #0 {")
        (emitLine cg "entry:")
        (emitLine cg "  %t = load atomic i64, ptr @__axiom_htab seq_cst, align 8")
        (emitLine cg "  %no = icmp eq i64 %t, 0")
        (emitLine cg "  br i1 %no, label %dead, label %look")
        (emitLine cg "look:")
        (emitLine cg "  %idx = and i64 %h, 65535")
        (emitLine cg "  %e = call i64 @__axiom_handle_slot(i64 %t, i64 %idx)")
        (emitLine cg "  %sp = inttoptr i64 %e to ptr")
        (emitLine cg "  %want = call i64 @__axiom_handle_want(i64 %kind, i64 %h)")
        (emitLine cg "  %freed = and i64 %want, -257")
        (emitLine cg "  %cx = cmpxchg ptr %sp, i64 %want, i64 %freed seq_cst seq_cst")
        (emitLine cg "  %mine = extractvalue { i64, i1 } %cx, 1")
        (emitLine cg "  br i1 %mine, label %retired, label %dead")
        (emitLine cg "retired:")
        (emitLine cg "  %pa = add i64 %e, 8")
        (emitLine cg "  %pp = inttoptr i64 %pa to ptr")
        (emitLine cg "  %v = load atomic i64, ptr %pp seq_cst, align 8")
        (emitLine cg "  %hp = inttoptr i64 %t to ptr")
        (emitLine cg "  %me = add i64 %idx, 1")
        (emitLine cg "  br label %push")
        (emitLine cg "push:")
        (emitLine cg "  %head = load atomic i64, ptr %hp seq_cst, align 8")
        (emitLine cg "  %hl = and i64 %head, 131071")
        (emitLine cg "  store atomic i64 %hl, ptr %pp seq_cst, align 8")
        (emitLine cg "  %tag = lshr i64 %head, 17")
        (emitLine cg "  %tag1 = add i64 %tag, 1")
        (emitLine cg "  %nh0 = shl i64 %tag1, 17")
        (emitLine cg "  %nh = or i64 %nh0, %me")
        (emitLine cg "  %cx2 = cmpxchg ptr %hp, i64 %head, i64 %nh seq_cst seq_cst")
        (emitLine cg "  %pushed = extractvalue { i64, i1 } %cx2, 1")
        (emitLine cg "  br i1 %pushed, label %done, label %push")
        (emitLine cg "done:")
        (emitLine cg "  ret i64 %v")
        (emitLine cg "dead:")
        (emitLine cg "  %x = call i64 @__axiom_handle_dead()")
        (emitLine cg "  unreachable")
        (emitLine cg "}")
        (emitLine cg "")
        cg
      }
    }))

; Status 78: the kernel refused the fork or the pthread. Recoverable,
; as the index trap is.
;
; And status 78 again, with its own sentence, when a JOIN cannot reach
; its child: `wait4` failing with anything but EINTR (the child was
; reaped by someone else - a `sysWaitPid` for any pid - or the handle
; was joined twice), `pthread_join` failing, or a handle joined by a
; thread that did not spawn it. Until 2026-09-27 the process join read
; a failed `wait4` as exit status 0 - the status word the kernel never
; wrote - and answered the binding's result slot as if the child had
; succeeded; the thread join ignored `pthread_join`'s answer outright.
(pub :: emitParTrap (-> CG CG))
(pub fn (emitParTrap cg)
  {
    (emitLine cg
      "@__axiom_par_fail_msg = private unnamed_addr constant [45 x i8] c\"axiom: parallel: could not spawn the binding\\0A\"")
    (emitLine cg "define internal i64 @__axiom_par_spawn_failed() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 78)")
    (emitLine cg "  %pfp = ptrtoint ptr @__axiom_par_fail_msg to i64")
    (emitRuntimeWrite cg "%pfp" "45")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "78")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg
      "@__axiom_par_lost_msg = private unnamed_addr constant [44 x i8] c\"axiom: parallel: could not join the binding\\0A\"")
    (emitLine cg "define internal i64 @__axiom_par_join_lost() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 78)")
    (emitLine cg "  %plp = ptrtoint ptr @__axiom_par_lost_msg to i64")
    (emitRuntimeWrite cg "%plp" "44")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "78")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; Status 79: a target with neither `fork` nor a pthread - windows-x86_64
; and windows-aarch64 today. The program emits and links; the first
; spawn says this.
(pub :: emitParUnsupported (-> CG CG))
(pub fn (emitParUnsupported cg)
  {
    (emitLine cg
      "@__axiom_par_unsup_msg = private unnamed_addr constant [48 x i8] c\"axiom: parallel is not available on this target\\0A\"")
    (emitLine cg "define internal i64 @__axiom_par_unsupported() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 79)")
    (emitLine cg "  %pup = ptrtoint ptr @__axiom_par_unsup_msg to i64")
    (emitRuntimeWrite cg "%pup" "48")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "79")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; The handle page, the thunk call, the join's shared tail, and the
; REGISTRY of children still outstanding.
;
; THE PAGE. Word 0 the pid or `pthread_t`, 1 the thunk, 2 its word
; argument, 3 the answer, 4 the wait status; and, since 2026-09-27,
; 5 and 6 the registry links, 7 the kind (1 process, 2 thread), 8 the
; spawn's sequence number, 9 the address of the registry head it was
; linked on - which is the spawning THREAD's, because the head is a
; mutable runtime global and so thread-local exactly when the rest are.
; Under threads a process child also uses 10 and 11, its links on the
; process-wide kill list, and 12, set while it is linked there; words 16
; to 31 are the siginfo buffer its join's `waitid` writes
; (`emitParKillList`, `emitParJoinUnlist`). Words 13 and 14 are the
; handle the spawn answered and the handle's kind (`emitParNameHandle`,
; MM-PAR-8): what a program holds is the handle, never the page.
;
; WHY A REGISTRY (MM-PAR-7). A child was reachable only through the
; handle word its parent held, so every path that dropped the handle
; without joining it abandoned the child: a join re-raising a sibling's
; trap exited with later siblings still running, a spawn failure under
; a recovery point jumped away from children already started, and a
; recovery abort reset the arena under a THREAD still reading its
; closure out of it. Measured before this: a trapping forked binding
; inside `__axiom_recover` ran the parent's continuation in the child
; (the arming call answered twice, once per process), and nothing ever
; killed or reaped the siblings of a failed join. So every spawn links
; its page onto the spawning thread's registry and every join unlinks
; it, and three places SWEEP what is still linked - kill and reap a
; process, join a thread, release its thunk, unmap its page:
;
;   * `@__axiom_recover_abort`, before it resets the arena: every child
;     spawned since the recovery point was armed (sequence number above
;     the one the arm recorded), and EVERY child when nothing is armed,
;     because every caller of the abort exits when it returns;
;   * `@main`'s wrapper, after the program's `main` returns;
;   * the end of a forked child and of a thread's entry, for children
;     the binding itself spawned and did not join.
;
; A THREAD IS JOINED, NOT KILLED: there is no sound way to stop one
; mid-flight, so a sweep waits for it to finish. A process is sent
; SIGKILL and reaped. A killed child cannot sweep its own children, so
; grandchildren of a killed binding are reparented rather than killed;
; `docs/memory-model.md` MM-PAR-7 states that limit.
;
; A PROGRAM THAT SPAWNS NOTHING PAYS NOTHING: this whole block is
; emitted only for a module that names a spawn primitive (slot 5), so
; every other module is byte-identical to what it was.
(pub :: emitParCommon (-> CG CG))
(pub fn (emitParCommon cg)
  {
    (let t (cgTarget cg))
    {
      (emitLine cg (concat "@__axiom_par_live = " (concat (cgMutGlobal cg) " i64 0")))
      (emitLine cg (concat "@__axiom_par_seq = " (concat (cgMutGlobal cg) " i64 0")))
      (emitLine cg "")
      (emitLine cg "define internal i64 @__axiom_par_page() #0 {")
      (emitLine cg "entry:")
      ; MEM_COMMIT|MEM_RESERVE = 0x3000 = 12288, PAGE_READWRITE = 4,
      ; where there is no syscall ABI; a failed `VirtualAlloc` answers 0,
      ; which the test below reads as the mmap failure it stands for.
      (if (== (targetHasSpawn t) 1)
        (emitLine cg
          (concat "  %addr = "
            (parSys cg (fmtInt (targetMmapNum t))
              (concat "i64 0, i64 4096, i64 3, i64 "
                (concat (fmtInt (targetMapSharedFlags t)) ", i64 -1, i64 0")))))
        (emitLine cg "  %addr = call i64 @VirtualAlloc(i64 0, i64 4096, i64 12288, i64 4)"))
      (emitLine cg "  %low = icmp ult i64 %addr, 4096")
      (emitLine cg "  %neg = icmp slt i64 %addr, 0")
      (emitLine cg "  %bad = or i1 %low, %neg")
      (emitLine cg "  br i1 %bad, label %fail, label %ok")
      (emitLine cg "fail:")
      (emitLine cg "  call i64 @__axiom_out_of_memory()")
      (emitLine cg "  unreachable")
      (emitLine cg "ok:")
      (emitLine cg "  ret i64 %addr")
      (emitLine cg "}")
      (emitLine cg "")
      ; `applyOneArg`'s convention, in the runtime: word 0 of the
      ; closure record is the code pointer, called with (record,
      ; argument, evidence 0).
      (emitLine cg "define internal i64 @__axiom_par_call(i64 %fn, i64 %arg) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %recp = inttoptr i64 %fn to ptr")
      (emitLine cg "  %cp = load i64, ptr %recp")
      (emitLine cg "  %f = inttoptr i64 %cp to ptr")
      (emitLine cg "  %r = call i64 %f(i64 %fn, i64 %arg, i64 0)")
      (emitLine cg "  ret i64 %r")
      (emitLine cg "}")
      (emitLine cg "")
      ; The page's word 13 is the HANDLE the spawn answered and word 14
      ; its kind (MM-PAR-8), retired here before the page goes: every
      ; path that ends a child - a join, a sweep, a failed spawn - comes
      ; through this function, so a handle outlives its page on none of
      ; them, and a second join of it finds a retired slot and traps 85
      ; instead of reading the page this unmaps. 0 is a page that never
      ; got a handle (the table was full, and the spawn is failing).
      (emitLine cg "define internal i64 @__axiom_par_finish(i64 %h) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %p1 = getelementptr i64, ptr %hp, i64 1")
      (emitLine cg "  %fn = load i64, ptr %p1")
      (emitLine cg "  %p3 = getelementptr i64, ptr %hp, i64 3")
      (emitLine cg "  %res = load i64, ptr %p3")
      (emitLine cg "  %p13 = getelementptr i64, ptr %hp, i64 13")
      (emitLine cg "  %hw = load i64, ptr %p13")
      (emitLine cg "  %named = icmp ne i64 %hw, 0")
      (emitLine cg "  br i1 %named, label %retire, label %drop")
      (emitLine cg "retire:")
      (emitLine cg "  %p14 = getelementptr i64, ptr %hp, i64 14")
      (emitLine cg "  %hk = load i64, ptr %p14")
      (emitLine cg "  %was = call i64 @__axiom_handle_free(i64 %hk, i64 %hw)")
      (emitLine cg "  br label %drop")
      (emitLine cg "drop:")
      (emitLine cg "  call void @axiom_release(i64 %fn)")
      ; MEM_RELEASE = 0x8000 = 32768 where there is no syscall ABI.
      (if (== (targetHasSpawn t) 1)
        (emitLine cg
          (concat "  "
            (parSys cg (fmtInt (targetMunmapNum t))
              "i64 %h, i64 4096, i64 0, i64 0, i64 0, i64 0")))
        (emitLine cg "  %fr = call i64 @VirtualFree(i64 %h, i64 0, i64 32768)"))
      (emitLine cg "  ret i64 %res")
      (emitLine cg "}")
      (emitLine cg "")
      ; Link a spawned page onto this thread's registry, newest first.
      (emitLine cg "define internal void @__axiom_par_link(i64 %h, i64 %kind) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %p7 = getelementptr i64, ptr %hp, i64 7")
      (emitLine cg "  store i64 %kind, ptr %p7")
      (emitLine cg "  %s0 = load i64, ptr @__axiom_par_seq")
      (emitLine cg "  %s1 = add i64 %s0, 1")
      (emitLine cg "  store i64 %s1, ptr @__axiom_par_seq")
      (emitLine cg "  %p8 = getelementptr i64, ptr %hp, i64 8")
      (emitLine cg "  store i64 %s1, ptr %p8")
      (emitLine cg "  %own = ptrtoint ptr @__axiom_par_live to i64")
      (emitLine cg "  %p9 = getelementptr i64, ptr %hp, i64 9")
      (emitLine cg "  store i64 %own, ptr %p9")
      (emitLine cg "  %head = load i64, ptr @__axiom_par_live")
      (emitLine cg "  %p5 = getelementptr i64, ptr %hp, i64 5")
      (emitLine cg "  store i64 %head, ptr %p5")
      (emitLine cg "  %p6 = getelementptr i64, ptr %hp, i64 6")
      (emitLine cg "  store i64 0, ptr %p6")
      (emitLine cg "  %has = icmp ne i64 %head, 0")
      (emitLine cg "  br i1 %has, label %back, label %done")
      (emitLine cg "back:")
      (emitLine cg "  %headp = inttoptr i64 %head to ptr")
      (emitLine cg "  %hb6 = getelementptr i64, ptr %headp, i64 6")
      (emitLine cg "  store i64 %h, ptr %hb6")
      (emitLine cg "  br label %done")
      (emitLine cg "done:")
      (emitLine cg "  store i64 %h, ptr @__axiom_par_live")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      ; Check ownership BEFORE waiting: a foreign pthread_join can
      ; consume the child's result before unlink rejects its registry.
      ; If that rejection recovers, the rightful owner's later join
      ; then fails. The process wait can steal its child's status too.
      ; Every join calls this before the kernel or pthread entry point;
      ; unlink also checks it before changing either registry link.
      (emitLine cg "define internal void @__axiom_par_check_owner(i64 %h) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %p9 = getelementptr i64, ptr %hp, i64 9")
      (emitLine cg "  %owner = load i64, ptr %p9")
      (emitLine cg "  %own = ptrtoint ptr @__axiom_par_live to i64")
      (emitLine cg "  %mine = icmp eq i64 %owner, %own")
      (emitLine cg "  br i1 %mine, label %owned, label %foreign")
      (emitLine cg "foreign:")
      (emitLine cg "  call i64 @__axiom_par_join_lost()")
      (emitLine cg "  unreachable")
      (emitLine cg "owned:")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      (emitLine cg "define internal void @__axiom_par_unlink(i64 %h) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %p9 = getelementptr i64, ptr %hp, i64 9")
      (emitLine cg "  %p5 = getelementptr i64, ptr %hp, i64 5")
      (emitLine cg "  %nx = load i64, ptr %p5")
      (emitLine cg "  %p6 = getelementptr i64, ptr %hp, i64 6")
      (emitLine cg "  %pv = load i64, ptr %p6")
      (emitLine cg "  %hasp = icmp ne i64 %pv, 0")
      (emitLine cg "  br i1 %hasp, label %mid, label %first")
      (emitLine cg "mid:")
      (emitLine cg "  %pvp = inttoptr i64 %pv to ptr")
      (emitLine cg "  %pv5 = getelementptr i64, ptr %pvp, i64 5")
      (emitLine cg "  store i64 %nx, ptr %pv5")
      (emitLine cg "  br label %fwd")
      (emitLine cg "first:")
      (emitLine cg "  store i64 %nx, ptr @__axiom_par_live")
      (emitLine cg "  br label %fwd")
      (emitLine cg "fwd:")
      (emitLine cg "  %hasn = icmp ne i64 %nx, 0")
      (emitLine cg "  br i1 %hasn, label %fix, label %done")
      (emitLine cg "fix:")
      (emitLine cg "  %nxp = inttoptr i64 %nx to ptr")
      (emitLine cg "  %nx6 = getelementptr i64, ptr %nxp, i64 6")
      (emitLine cg "  store i64 %pv, ptr %nx6")
      (emitLine cg "  br label %done")
      (emitLine cg "done:")
      (emitLine cg "  store i64 0, ptr %p9")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      ; End one unlinked child: a process is killed and reaped, a thread
      ; joined; then its thunk is released and its page unmapped.
      (emitLine cg "define internal void @__axiom_par_reap(i64 %h) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %p7 = getelementptr i64, ptr %hp, i64 7")
      (emitLine cg "  %kind = load i64, ptr %p7")
      (emitLine cg "  %who = load i64, ptr %hp")
      (emitLine cg "  %isthr = icmp eq i64 %kind, 2")
      (emitLine cg "  br i1 %isthr, label %thr, label %proc")
      (emitLine cg "proc:")
      (if (== (targetHasSpawn t) 1)
        {
          (emitLine cg
            (concat "  %kr = "
              (parSys cg (fmtInt (targetKillNum t)) "i64 %who, i64 9, i64 0, i64 0, i64 0, i64 0")))
          (if (cgThreads cg)
            (emitLine cg "  call void @__axiom_par_gunlink(i64 %h)"))
          (emitLine cg "  %p4 = getelementptr i64, ptr %hp, i64 4")
          (emitLine cg "  %st4 = ptrtoint ptr %p4 to i64")
          (emitLine cg "  br label %wait")
          (emitLine cg "wait:")
          (emitLine cg
            (concat "  %w = "
              (parSys cg (fmtInt (targetWait4Num t))
                "i64 %who, i64 %st4, i64 0, i64 0, i64 0, i64 0")))
          (emitLine cg "  %intr = icmp eq i64 %w, -4")
          (emitLine cg "  br i1 %intr, label %wait, label %fin")
        }
        ; no `fork` here, so no process child was ever linked
        (emitLine cg "  unreachable"))
      (emitLine cg "thr:")
      (if (cgThreads cg)
        (if (== (targetHasSpawn t) 1)
          {
            (emitLine cg "  %tp = inttoptr i64 %who to ptr")
            (emitLine cg "  %jr = call i32 @pthread_join(ptr %tp, ptr null)")
          }
          {
            (emitLine cg "  %jw = call i64 @WaitForSingleObject(i64 %who, i64 4294967295)")
            (emitLine cg "  %jc = call i64 @CloseHandle(i64 %who)")
          }))
      (emitLine cg "  br label %fin")
      (emitLine cg "fin:")
      (emitLine cg "  %r = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      ; Sweep every child on this thread's registry whose sequence number
      ; is above `floor`: -1 sweeps them all. The list is newest first,
      ; so the children spawned since a point are a prefix of it.
      (emitLine cg "define internal void @__axiom_par_sweep(i64 %floor) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  br label %loop")
      (emitLine cg "loop:")
      (emitLine cg "  %head = load i64, ptr @__axiom_par_live")
      (emitLine cg "  %empty = icmp eq i64 %head, 0")
      (emitLine cg "  br i1 %empty, label %done, label %test")
      (emitLine cg "test:")
      (emitLine cg "  %hp = inttoptr i64 %head to ptr")
      (emitLine cg "  %p8 = getelementptr i64, ptr %hp, i64 8")
      (emitLine cg "  %seq = load i64, ptr %p8")
      (emitLine cg "  %inside = icmp sgt i64 %seq, %floor")
      (emitLine cg "  br i1 %inside, label %end1, label %done")
      (emitLine cg "end1:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %head)")
      (emitLine cg "  call void @__axiom_par_reap(i64 %head)")
      (emitLine cg "  br label %loop")
      (emitLine cg "done:")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      cg
    }
  })

; Is the registry in this module: a spawn primitive is named, on a
; target that can spawn. The recovery point's arm and abort and
; `@main`'s wrapper ask this before they touch it.
(pub :: parRegistryOn (-> CG Int))
(pub fn (parRegistryOn cg)
  (if (== (cgParallelUsed cg) 0)
    0
    (targetHasSpawn (cgTarget cg))))

; Where a recovery record keeps the spawn sequence number its arm saw:
; the word after the evidence-slot snapshot, which starts at 128.
(pub :: parRecSeqOffset (-> CG Int))
(pub fn (parRecSeqOffset cg)
  (+ 128 (* 8 (distinctSlotCount (cgEffDecls cg) 0 0))))

; The process lowering: fork, run the thunk in the child, write the
; answer through the shared page, exit; the parent's join is a `wait4`
; that retries on EINTR, then the status decode `Sys.ax` documents for
; `sysRun` - exit code, or 128 plus the signal - re-raised as the
; parent's own exit when it is not 0.
;
; RE-RAISED THROUGH THE RECOVERY POINT, since 2026-09-27. The raising
; join unlinks and releases the failed child, then calls
; `@__axiom_recover_abort` with the child's status before it exits, so
; a recovery point armed around the `parallel` answers that status like
; any other trap and the siblings spawned inside it are swept first.
; And the CHILD is disarmed: it starts with no recovery point and an
; empty registry. It inherited the parent's copy of both, so a binding
; that trapped inside the parent's recovery extent used to jump to the
; PARENT's arm site in the child and run the parent's continuation
; there, while the parent read the child's exit 0 as success
; (`tests/stdlib/522-parallel-recover.ax`).
; Under threads, a process join's first half: wait for the child's
; EXIT without reaping it (`waitid` with WNOWAIT, retried on EINTR,
; into a siginfo buffer at word 16 of the page), then take the page off
; the process-wide kill list, and only then let the `wait4` below reap.
; A pid on the list is always one the kernel has not freed - running,
; or a zombie - so a trap's sweep that SIGKILLs every listed pid can
; never hit a pid the kernel has handed to someone else. While the
; child runs it stays listed, so a trap in any thread takes it down.
; A `waitid` that fails for any other reason falls through: the `wait4`
; after it fails the same way and takes the lost-join path.
(pub :: emitParJoinUnlist (-> CG CG))
(pub fn (emitParJoinUnlist cg)
  (if (cgThreads cg)
    {
      (let t (cgTarget cg))
      {
        (emitLine cg "  %sib = getelementptr i64, ptr %hp, i64 16")
        (emitLine cg "  %sibw = ptrtoint ptr %sib to i64")
        (emitLine cg "  br label %exitwait")
        (emitLine cg "exitwait:")
        (emitLine cg
          (concat "  %wx = "
            (parSys cg (fmtInt (targetWaitIdNum t))
              (concat "i64 1, i64 %pid, i64 %sibw, i64 "
                (concat (fmtInt (targetWaitExitedNoWait t)) ", i64 0, i64 0")))))
        (emitLine cg "  %wxintr = icmp eq i64 %wx, -4")
        (emitLine cg "  br i1 %wxintr, label %exitwait, label %unlist")
        (emitLine cg "unlist:")
        (emitLine cg "  call void @__axiom_par_gunlink(i64 %h)")
        cg
      }
    }
    cg))

(pub :: emitParProc (-> CG CG))
(pub fn (emitParProc cg)
  {
    (let t (cgTarget cg))
    {
      (emitLine cg "define internal i64 @__axiom_par_spawn_proc(i64 %fn, i64 %arg) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %page = call i64 @__axiom_par_page()")
      (emitLine cg "  %hp = inttoptr i64 %page to ptr")
      (emitLine cg "  %p1 = getelementptr i64, ptr %hp, i64 1")
      (emitLine cg "  store i64 %fn, ptr %p1")
      (emitLine cg "  %p2 = getelementptr i64, ptr %hp, i64 2")
      (emitLine cg "  store i64 %arg, ptr %p2")
      (emitParNameHandle cg 1)
      ; Under threads the fork and the kill list's link happen inside the
      ; list's lock, so a trap's sweep (`@__axiom_par_gkill`) never runs
      ; between them: a child either is on the list when the sweep walks
      ; it, or is forked after the process has already ended.
      (if (cgThreads cg)
        (emitLine cg "  call void @__axiom_par_glock()"))
      (if (== (parLibcFork cg) 1)
        {
          (emitLine cg "  %pid32 = call i32 @fork()")
          (emitLine cg "  %pid = sext i32 %pid32 to i64")
        }
        (emitLine cg
          (concat "  %pid = "
            (parSys cg (fmtInt (targetForkNum t))
              (concat "i64 "
                (concat (fmtInt (targetForkArg t)) ", i64 0, i64 0, i64 0, i64 0, i64 0"))))))
      (emitLine cg "  %failed = icmp slt i64 %pid, 0")
      (emitLine cg "  br i1 %failed, label %fail, label %forked")
      ; The page and the thunk's share go back before the trap: it may
      ; recover, and a recovered spawn failure used to leak both.
      (emitLine cg "fail:")
      (if (cgThreads cg)
        (emitLine cg "  call void @__axiom_par_gunlock()"))
      (emitLine cg "  %dis = call i64 @__axiom_par_finish(i64 %page)")
      (emitLine cg "  call i64 @__axiom_par_spawn_failed()")
      (emitLine cg "  unreachable")
      (emitLine cg "forked:")
      (if (|| (== (targetForkChildIsZero t) 1) (== (parLibcFork cg) 1))
        (emitLine cg "  %ischild = icmp eq i64 %pid, 0")
        {
          (emitLine cg
            (concat "  %me = "
              (parSys cg (fmtInt (targetGetPidNum t)) "i64 0, i64 0, i64 0, i64 0, i64 0, i64 0")))
          (emitLine cg "  %ischild = icmp eq i64 %pid, %me")
        })
      (emitLine cg "  br i1 %ischild, label %child, label %parent")
      (emitLine cg "child:")
      (emitLine cg "  store i64 0, ptr @__axiom_recover_top")
      (emitLine cg "  store i64 0, ptr @__axiom_par_live")
      ; The child's copy of the kill list names its SIBLINGS, and its lock
      ; is held - by the thread that forked, which the child does not
      ; have. Both start empty, or the child's own unrecovered trap would
      ; SIGKILL its siblings and a spawn of its own would spin for ever.
      (if (cgThreads cg)
        {
          (emitLine cg "  store i64 0, ptr @__axiom_par_procs")
          (emitLine cg "  store i64 0, ptr @__axiom_par_procs_lock")
        })
      (emitLine cg "  %r = call i64 @__axiom_par_call(i64 %fn, i64 %arg)")
      (emitLine cg "  %p3 = getelementptr i64, ptr %hp, i64 3")
      (emitLine cg "  store i64 %r, ptr %p3")
      (emitLine cg "  call void @__axiom_par_sweep(i64 -1)")
      (emitRuntimeExit cg "0")
      (emitLine cg "  unreachable")
      (emitLine cg "parent:")
      (emitLine cg "  store i64 %pid, ptr %hp")
      (emitLine cg "  call void @__axiom_par_link(i64 %page, i64 1)")
      (if (cgThreads cg)
        {
          (emitLine cg "  call void @__axiom_par_glink(i64 %page)")
          (emitLine cg "  call void @__axiom_par_gunlock()")
        })
      (emitLine cg "  ret i64 %hw")
      (emitLine cg "}")
      (emitLine cg "")
      ; Every join takes the HANDLE and asks the table for the page it
      ; names before anything else (`emitParJoinPage`): a handle already
      ; joined, or a word no spawn answered, traps 85 there, and the
      ; page below is only ever one that is still mapped.
      (emitLine cg "define internal i64 @__axiom_par_join_proc(i64 %hw) #0 {")
      (emitLine cg "entry:")
      (emitParJoinPage cg 1)
      (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %pid = load i64, ptr %hp")
      (emitLine cg "  %p4 = getelementptr i64, ptr %hp, i64 4")
      (emitLine cg "  %st4 = ptrtoint ptr %p4 to i64")
      (emitParJoinUnlist cg)
      (emitLine cg "  br label %wait")
      (emitLine cg "wait:")
      (emitLine cg
        (concat "  %w = "
          (parSys cg (fmtInt (targetWait4Num t)) "i64 %pid, i64 %st4, i64 0, i64 0, i64 0, i64 0")))
      (emitLine cg "  %intr = icmp eq i64 %w, -4")
      (emitLine cg "  br i1 %intr, label %wait, label %waited")
      (emitLine cg "waited:")
      (emitLine cg "  %lost = icmp slt i64 %w, 0")
      (emitLine cg "  br i1 %lost, label %gone, label %decode")
      (emitLine cg "gone:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  %gf = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  call i64 @__axiom_par_join_lost()")
      (emitLine cg "  unreachable")
      (emitLine cg "decode:")
      (emitLine cg "  %st = load i64, ptr %p4")
      (emitLine cg "  %sig = and i64 %st, 127")
      (emitLine cg "  %sigz = icmp eq i64 %sig, 0")
      (emitLine cg "  %hi = lshr i64 %st, 8")
      (emitLine cg "  %code = and i64 %hi, 255")
      (emitLine cg "  %sigst = add i64 %sig, 128")
      (emitLine cg "  %status = select i1 %sigz, i64 %code, i64 %sigst")
      (emitLine cg "  %ok = icmp eq i64 %status, 0")
      (emitLine cg "  br i1 %ok, label %fine, label %propagate")
      (emitLine cg "propagate:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  %pf = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  call i64 @__axiom_recover_abort(i64 %status)")
      (emitRuntimeExit cg "%status")
      (emitLine cg "  unreachable")
      (emitLine cg "fine:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  %res = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  ret i64 %res")
      (emitLine cg "}")
      (emitLine cg "")
      ; The non-raising join: the same `wait4` and the same decode, but
      ; the status is STORED to the out-cell and the join always
      ; finishes. A failed child never stored word 3, so the failure
      ; arm settles the answer slot to 0 itself rather than trusting
      ; the page's zero-fill - the page IS zero-filled fresh mmap, but
      ; no line of this runtime relies on that anywhere else, and this
      ; one will not be the first. A `wait4` that cannot reach the child
      ; at all stores 78, the lost-join status, rather than the 0 the
      ; kernel never wrote.
      (emitLine cg "define internal i64 @__axiom_par_join_nr_proc(i64 %hw, i64 %cell) #0 {")
      (emitLine cg "entry:")
      (emitParJoinPage cg 1)
      (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %pid = load i64, ptr %hp")
      (emitLine cg "  %p4 = getelementptr i64, ptr %hp, i64 4")
      (emitLine cg "  %st4 = ptrtoint ptr %p4 to i64")
      (emitParJoinUnlist cg)
      (emitLine cg "  br label %wait")
      (emitLine cg "wait:")
      (emitLine cg
        (concat "  %w = "
          (parSys cg (fmtInt (targetWait4Num t)) "i64 %pid, i64 %st4, i64 0, i64 0, i64 0, i64 0")))
      (emitLine cg "  %intr = icmp eq i64 %w, -4")
      (emitLine cg "  br i1 %intr, label %wait, label %waited")
      (emitLine cg "waited:")
      (emitLine cg "  %lost = icmp slt i64 %w, 0")
      (emitLine cg "  %st = load i64, ptr %p4")
      (emitLine cg "  %sig = and i64 %st, 127")
      (emitLine cg "  %sigz = icmp eq i64 %sig, 0")
      (emitLine cg "  %hi = lshr i64 %st, 8")
      (emitLine cg "  %code = and i64 %hi, 255")
      (emitLine cg "  %sigst = add i64 %sig, 128")
      (emitLine cg "  %status0 = select i1 %sigz, i64 %code, i64 %sigst")
      (emitLine cg "  %status = select i1 %lost, i64 78, i64 %status0")
      (emitLine cg "  %cellp = inttoptr i64 %cell to ptr")
      (emitLine cg "  store i64 %status, ptr %cellp")
      (emitLine cg "  %ok = icmp eq i64 %status, 0")
      (emitLine cg "  br i1 %ok, label %fine, label %failed")
      (emitLine cg "failed:")
      (emitLine cg "  %p3 = getelementptr i64, ptr %hp, i64 3")
      (emitLine cg "  store i64 0, ptr %p3")
      (emitLine cg "  br label %fine")
      (emitLine cg "fine:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  %res = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  ret i64 %res")
      (emitLine cg "}")
      (emitLine cg "")
      cg
    }
  })

; The thread lowering: the platform's pthread, entered at
; `@__axiom_par_entry` with the page, which runs the thunk and writes
; word 3. The two `declare`s are the whole import surface of a thread-
; lowered program, and `scripts/check-parallel.sh` measures them.
;
; THE ENTRY RETURNS ITS ARENA (MM-PAR-6a), since 2026-09-27. Every
; mutable runtime global is thread-local here, so a thread's first
; allocation maps a chunk of its own - and nothing ever unmapped one:
; 6,000 bindings left 6.16 GB of address space mapped against 3.6 MB
; for the same program forked (`VmSize`, measured). After the thunk
; answers and the thread's own children are swept, the entry walks its
; chunk list and its free list and unmaps every chunk. That is sound
; because nothing allocated in a thread can be reached from outside it
; once it ends: what crosses the join is a word, `AX3064` refuses every
; captured reference and every captured `Vec` (whose buffer a push
; would otherwise reallocate out of THIS arena), and the unsafe layer's
; obligation is the rest - a word that is the address of thread-arena
; memory, laundered through `cast`, dangles after the join
; (`scripts/check-parallel.sh` section 12a).
; THE PROCESS-WIDE KILL LIST (MM-PAR-7), under threads only. Each
; thread's registry is thread-local, so an unrecovered trap swept only
; the trapping thread's children and then ended the process: a process
; child that ANOTHER thread forked - a task in a pool that thread ran -
; was reparented and ran on. So every process child is also linked on
; one list shared by all threads (page words 10 and 11, word 12 set
; while linked), under a spinlock whose critical sections are a few
; stores - and the fork itself, so a sweep never runs between a fork
; and its link. `@__axiom_par_gkill` takes the lock and never gives it
; back: it SIGKILLs every listed pid and returns to a caller that ends
; the process, so nothing can fork after the walk. The three words are
; plain globals, not thread-local, which is the point of them; a
; forked child resets them (`emitParProc`). A module lowered to
; processes has one thread, whose registry already is the whole list.
(pub :: emitParKillList (-> CG CG))
(pub fn (emitParKillList cg)
  {
    (let t (cgTarget cg))
    {
      (emitLine cg "@__axiom_par_procs = internal global i64 0")
      (emitLine cg "@__axiom_par_procs_lock = internal global i64 0")
      (emitLine cg "")
      (emitLine cg "define internal void @__axiom_par_glock() #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  br label %spin")
      (emitLine cg "spin:")
      (emitLine cg "  %old = cmpxchg ptr @__axiom_par_procs_lock, i64 0, i64 1 seq_cst seq_cst")
      (emitLine cg "  %got = extractvalue { i64, i1 } %old, 1")
      (emitLine cg "  br i1 %got, label %done, label %spin")
      (emitLine cg "done:")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      (emitLine cg "define internal void @__axiom_par_gunlock() #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  store atomic i64 0, ptr @__axiom_par_procs_lock seq_cst, align 8")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      ; Link page `h` at the head. The caller holds the lock.
      (emitLine cg "define internal void @__axiom_par_glink(i64 %h) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %head = load i64, ptr @__axiom_par_procs")
      (emitLine cg "  %p10 = getelementptr i64, ptr %hp, i64 10")
      (emitLine cg "  store i64 %head, ptr %p10")
      (emitLine cg "  %p11 = getelementptr i64, ptr %hp, i64 11")
      (emitLine cg "  store i64 0, ptr %p11")
      (emitLine cg "  %p12 = getelementptr i64, ptr %hp, i64 12")
      (emitLine cg "  store i64 1, ptr %p12")
      (emitLine cg "  %has = icmp ne i64 %head, 0")
      (emitLine cg "  br i1 %has, label %back, label %done")
      (emitLine cg "back:")
      (emitLine cg "  %headp = inttoptr i64 %head to ptr")
      (emitLine cg "  %hb11 = getelementptr i64, ptr %headp, i64 11")
      (emitLine cg "  store i64 %h, ptr %hb11")
      (emitLine cg "  br label %done")
      (emitLine cg "done:")
      (emitLine cg "  store i64 %h, ptr @__axiom_par_procs")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      ; Take page `h` off the list if it is on it. Takes the lock.
      (emitLine cg "define internal void @__axiom_par_gunlink(i64 %h) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  call void @__axiom_par_glock()")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %p12 = getelementptr i64, ptr %hp, i64 12")
      (emitLine cg "  %on = load i64, ptr %p12")
      (emitLine cg "  %listed = icmp ne i64 %on, 0")
      (emitLine cg "  br i1 %listed, label %cut, label %out")
      (emitLine cg "cut:")
      (emitLine cg "  %p10 = getelementptr i64, ptr %hp, i64 10")
      (emitLine cg "  %nx = load i64, ptr %p10")
      (emitLine cg "  %p11 = getelementptr i64, ptr %hp, i64 11")
      (emitLine cg "  %pv = load i64, ptr %p11")
      (emitLine cg "  %hasp = icmp ne i64 %pv, 0")
      (emitLine cg "  br i1 %hasp, label %mid, label %first")
      (emitLine cg "mid:")
      (emitLine cg "  %pvp = inttoptr i64 %pv to ptr")
      (emitLine cg "  %pv10 = getelementptr i64, ptr %pvp, i64 10")
      (emitLine cg "  store i64 %nx, ptr %pv10")
      (emitLine cg "  br label %fwd")
      (emitLine cg "first:")
      (emitLine cg "  store i64 %nx, ptr @__axiom_par_procs")
      (emitLine cg "  br label %fwd")
      (emitLine cg "fwd:")
      (emitLine cg "  %hasn = icmp ne i64 %nx, 0")
      (emitLine cg "  br i1 %hasn, label %fix, label %clear")
      (emitLine cg "fix:")
      (emitLine cg "  %nxp = inttoptr i64 %nx to ptr")
      (emitLine cg "  %nx11 = getelementptr i64, ptr %nxp, i64 11")
      (emitLine cg "  store i64 %pv, ptr %nx11")
      (emitLine cg "  br label %clear")
      (emitLine cg "clear:")
      (emitLine cg "  store i64 0, ptr %p12")
      (emitLine cg "  br label %out")
      (emitLine cg "out:")
      (emitLine cg "  call void @__axiom_par_gunlock()")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      ; SIGKILL every listed pid, keeping the lock: the caller ends the
      ; process. No reap: a listed pid is unreaped by construction, and
      ; what is left becomes init's.
      (emitLine cg "define internal void @__axiom_par_gkill() #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  call void @__axiom_par_glock()")
      (emitLine cg "  %first = load i64, ptr @__axiom_par_procs")
      (emitLine cg "  br label %walk")
      (emitLine cg "walk:")
      (emitLine cg "  %cur = phi i64 [ %first, %entry ], [ %next, %one ]")
      (emitLine cg "  %end = icmp eq i64 %cur, 0")
      (emitLine cg "  br i1 %end, label %done, label %one")
      (emitLine cg "one:")
      (emitLine cg "  %cp = inttoptr i64 %cur to ptr")
      (emitLine cg "  %who = load i64, ptr %cp")
      (emitLine cg
        (concat "  %kr = "
          (parSys cg (fmtInt (targetKillNum t)) "i64 %who, i64 9, i64 0, i64 0, i64 0, i64 0")))
      (emitLine cg "  %c10 = getelementptr i64, ptr %cp, i64 10")
      (emitLine cg "  %next = load i64, ptr %c10")
      (emitLine cg "  br label %walk")
      (emitLine cg "done:")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      cg
    }
  })

(pub :: emitParThread (-> CG CG))
(pub fn (emitParThread cg)
  {
    (let t (cgTarget cg))
    {
      (emitLine cg "declare i32 @pthread_create(ptr, ptr, ptr, ptr) #0")
      (emitLine cg "declare i32 @pthread_join(ptr, ptr) #0")
      (if (== (parLibcFork cg) 1)
        (emitLine cg "declare i32 @fork() #0"))
      (emitLine cg "")
      (emitParKillList cg)
      (emitLine cg "define internal void @__axiom_arena_unmap_thread() #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %a0 = load i64, ptr @__axiom_chunk")
      (emitLine cg "  br label %act")
      (emitLine cg "act:")
      (emitLine cg "  %c = phi i64 [ %a0, %entry ], [ %cn, %actstep ]")
      (emitLine cg "  %cz = icmp eq i64 %c, 0")
      (emitLine cg "  br i1 %cz, label %freel, label %actstep")
      (emitLine cg "actstep:")
      (emitLine cg "  %cp = inttoptr i64 %c to ptr")
      (emitLine cg "  %csz = load i64, ptr %cp")
      (emitLine cg "  %cl = add i64 %c, 8")
      (emitLine cg "  %clp = inttoptr i64 %cl to ptr")
      (emitLine cg "  %cn = load i64, ptr %clp")
      (emitLine cg
        (concat "  %cu = "
          (parSys cg (fmtInt (targetMunmapNum t)) "i64 %c, i64 %csz, i64 0, i64 0, i64 0, i64 0")))
      (emitLine cg "  br label %act")
      (emitLine cg "freel:")
      (emitLine cg "  %f0 = load i64, ptr @__axiom_free")
      (emitLine cg "  br label %fre")
      (emitLine cg "fre:")
      (emitLine cg "  %f = phi i64 [ %f0, %freel ], [ %fnx, %frestep ]")
      (emitLine cg "  %fz = icmp eq i64 %f, 0")
      (emitLine cg "  br i1 %fz, label %done, label %frestep")
      (emitLine cg "frestep:")
      (emitLine cg "  %fp = inttoptr i64 %f to ptr")
      (emitLine cg "  %fsz = load i64, ptr %fp")
      (emitLine cg "  %fl = add i64 %f, 8")
      (emitLine cg "  %flp = inttoptr i64 %fl to ptr")
      (emitLine cg "  %fnx = load i64, ptr %flp")
      (emitLine cg
        (concat "  %fu = "
          (parSys cg (fmtInt (targetMunmapNum t)) "i64 %f, i64 %fsz, i64 0, i64 0, i64 0, i64 0")))
      (emitLine cg "  br label %fre")
      (emitLine cg "done:")
      (emitLine cg "  store i64 0, ptr @__axiom_chunk")
      (emitLine cg "  store i64 0, ptr @__axiom_free")
      (emitLine cg "  store i64 0, ptr @__axiom_bump")
      (emitLine cg "  store i64 0, ptr @__axiom_bump_end")
      (emitLine cg "  store i64 0, ptr @__axiom_high")
      (emitLine cg "  ret void")
      (emitLine cg "}")
      (emitLine cg "")
      (emitLine cg "define internal ptr @__axiom_par_entry(ptr %pg) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %p1 = getelementptr i64, ptr %pg, i64 1")
      (emitLine cg "  %fn = load i64, ptr %p1")
      (emitLine cg "  %p2 = getelementptr i64, ptr %pg, i64 2")
      (emitLine cg "  %arg = load i64, ptr %p2")
      (if (programStackOn cg)
        {
          (emitLine cg "  %budget = call i64 @__axiom_program_stack_bytes()")
          (emitLine cg "  %code = ptrtoint ptr @__axiom_stack_call to i64")
          (emitLine cg
            "  %r = call i64 @__axiom_stack_run_code(i64 %budget, i64 %code, i64 %fn, i64 %arg)")
        }
        (emitLine cg "  %r = call i64 @__axiom_par_call(i64 %fn, i64 %arg)"))
      (emitLine cg "  %p3 = getelementptr i64, ptr %pg, i64 3")
      (emitLine cg "  store i64 %r, ptr %p3")
      (emitLine cg "  call void @__axiom_par_sweep(i64 -1)")
      (emitLine cg "  call void @__axiom_arena_unmap_thread()")
      (if (stackRunOn cg)
        (emitLine cg "  call void @__axiom_stack_disarm()"))
      (emitLine cg "  ret ptr null")
      (emitLine cg "}")
      (emitLine cg "")
      (emitLine cg "define internal i64 @__axiom_par_spawn_thread(i64 %fn, i64 %arg) #0 {")
      (emitLine cg "entry:")
      (emitLine cg "  %page = call i64 @__axiom_par_page()")
      (emitLine cg "  %hp = inttoptr i64 %page to ptr")
      (emitLine cg "  %p1 = getelementptr i64, ptr %hp, i64 1")
      (emitLine cg "  store i64 %fn, ptr %p1")
      (emitLine cg "  %p2 = getelementptr i64, ptr %hp, i64 2")
      (emitLine cg "  store i64 %arg, ptr %p2")
      (emitParNameHandle cg 5)
      (emitLine cg
        "  %rc = call i32 @pthread_create(ptr %hp, ptr null, ptr @__axiom_par_entry, ptr %hp)")
      (emitLine cg "  %bad = icmp ne i32 %rc, 0")
      (emitLine cg "  br i1 %bad, label %fail, label %ok")
      (emitLine cg "fail:")
      (emitLine cg "  %dis = call i64 @__axiom_par_finish(i64 %page)")
      (emitLine cg "  call i64 @__axiom_par_spawn_failed()")
      (emitLine cg "  unreachable")
      (emitLine cg "ok:")
      (emitLine cg "  call void @__axiom_par_link(i64 %page, i64 2)")
      (emitLine cg "  ret i64 %hw")
      (emitLine cg "}")
      (emitLine cg "")
      ; A `pthread_join` that fails did not wait for the thread, which
      ; may still be running on the page and on its thunk - so the lost
      ; path unlinks and traps and deliberately does NOT finish: an
      ; unmapped page under a live thread is a write into whatever maps
      ; there next, and a leaked page is not.
      (emitLine cg "define internal i64 @__axiom_par_join_thread(i64 %hw) #0 {")
      (emitLine cg "entry:")
      (emitParJoinPage cg 5)
      (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %t = load i64, ptr %hp")
      (emitLine cg "  %tp = inttoptr i64 %t to ptr")
      (emitLine cg "  %rc = call i32 @pthread_join(ptr %tp, ptr null)")
      (emitLine cg "  %bad = icmp ne i32 %rc, 0")
      (emitLine cg "  br i1 %bad, label %gone, label %fine")
      (emitLine cg "gone:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  call i64 @__axiom_par_join_lost()")
      (emitLine cg "  unreachable")
      (emitLine cg "fine:")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  %res = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  ret i64 %res")
      (emitLine cg "}")
      (emitLine cg "")
      ; The non-raising thread join. The cell takes `pthread_join`'s own
      ; return - 0, or the errno it failed with - which is the only
      ; failure this join can ever REPORT: a trapping thread ends the
      ; whole process (`exit_group`) before any join runs, so a returned
      ; non-raising thread join is a joined thread. Same API as the proc
      ; half, honestly narrower, and `scripts/check-parallel.sh` section
      ; 6f pins both halves of that sentence. A failed join answers 0
      ; and leaves the page mapped, for the reason the raising join
      ; gives.
      (emitLine cg "define internal i64 @__axiom_par_join_nr_thread(i64 %hw, i64 %cell) #0 {")
      (emitLine cg "entry:")
      (emitParJoinPage cg 5)
      (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
      (emitLine cg "  %hp = inttoptr i64 %h to ptr")
      (emitLine cg "  %t = load i64, ptr %hp")
      (emitLine cg "  %tp = inttoptr i64 %t to ptr")
      (emitLine cg "  %rc = call i32 @pthread_join(ptr %tp, ptr null)")
      (emitLine cg "  %rc64 = sext i32 %rc to i64")
      (emitLine cg "  %cellp = inttoptr i64 %cell to ptr")
      (emitLine cg "  store i64 %rc64, ptr %cellp")
      (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
      (emitLine cg "  %bad = icmp ne i32 %rc, 0")
      (emitLine cg "  br i1 %bad, label %gone, label %fine")
      (emitLine cg "gone:")
      (emitLine cg "  ret i64 0")
      (emitLine cg "fine:")
      (emitLine cg "  %res = call i64 @__axiom_par_finish(i64 %h)")
      (emitLine cg "  ret i64 %res")
      (emitLine cg "}")
      (emitLine cg "")
      cg
    }
  })

; The thread half over kernel32, for a target with threads and no
; `fork`: `CreateThread` where the POSIX half names `pthread_create`,
; `WaitForSingleObject` and `CloseHandle` where it names
; `pthread_join`, and the runtime's own `VirtualFree` where it unmaps.
; The entry routine is
; the POSIX one's shape: a thread start routine answers a DWORD in the
; result register, and `__axiom_par_entry`'s null is that. No kill list
; here, since no process child can exist. The thread takes the image's
; own stack reservation (`dwStackSize` 0), the one `--link-stack` set
; for the main thread, and a failed `WaitForSingleObject` leaves the
; page mapped for the reason the POSIX half's lost join gives.
(pub :: emitParThreadWin (-> CG CG))
(pub fn (emitParThreadWin cg)
  {
    (emitLine cg "")
    (emitLine cg "define internal void @__axiom_arena_unmap_thread() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %a0 = load i64, ptr @__axiom_chunk")
    (emitLine cg "  br label %act")
    (emitLine cg "act:")
    (emitLine cg "  %c = phi i64 [ %a0, %entry ], [ %cn, %actstep ]")
    (emitLine cg "  %cz = icmp eq i64 %c, 0")
    (emitLine cg "  br i1 %cz, label %freel, label %actstep")
    (emitLine cg "actstep:")
    (emitLine cg "  %cp = inttoptr i64 %c to ptr")
    (emitLine cg "  %cl = add i64 %c, 8")
    (emitLine cg "  %clp = inttoptr i64 %cl to ptr")
    (emitLine cg "  %cn = load i64, ptr %clp")
    (emitLine cg "  %cu = call i64 @VirtualFree(i64 %c, i64 0, i64 32768)")
    (emitLine cg "  br label %act")
    (emitLine cg "freel:")
    (emitLine cg "  %f0 = load i64, ptr @__axiom_free")
    (emitLine cg "  br label %fre")
    (emitLine cg "fre:")
    (emitLine cg "  %f = phi i64 [ %f0, %freel ], [ %fnx, %frestep ]")
    (emitLine cg "  %fz = icmp eq i64 %f, 0")
    (emitLine cg "  br i1 %fz, label %done, label %frestep")
    (emitLine cg "frestep:")
    (emitLine cg "  %fp = inttoptr i64 %f to ptr")
    (emitLine cg "  %fl = add i64 %f, 8")
    (emitLine cg "  %flp = inttoptr i64 %fl to ptr")
    (emitLine cg "  %fnx = load i64, ptr %flp")
    (emitLine cg "  %fu = call i64 @VirtualFree(i64 %f, i64 0, i64 32768)")
    (emitLine cg "  br label %fre")
    (emitLine cg "done:")
    (emitLine cg "  store i64 0, ptr @__axiom_chunk")
    (emitLine cg "  store i64 0, ptr @__axiom_free")
    (emitLine cg "  store i64 0, ptr @__axiom_bump")
    (emitLine cg "  store i64 0, ptr @__axiom_bump_end")
    (emitLine cg "  store i64 0, ptr @__axiom_high")
    (emitLine cg "  ret void")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "define internal ptr @__axiom_par_entry(ptr %pg) #0 {")
    (emitLine cg "entry:")
    ; the thread keeps 64 KiB of its stack for the stack-overflow
    ; handler, as the entry thread does (`emitWinFaultRuntime`)
    (emitLine cg "  %gsz = alloca i32, align 4")
    (emitLine cg "  store i32 65536, ptr %gsz")
    (emitLine cg "  %gszi = ptrtoint ptr %gsz to i64")
    (emitLine cg "  %gok = call i64 @SetThreadStackGuarantee(i64 %gszi)")
    (emitLine cg "  %p1 = getelementptr i64, ptr %pg, i64 1")
    (emitLine cg "  %fn = load i64, ptr %p1")
    (emitLine cg "  %p2 = getelementptr i64, ptr %pg, i64 2")
    (emitLine cg "  %arg = load i64, ptr %p2")
    ; The thunk runs on the thread's own stack: the guarded stack
    ; runtime (`emitStackRunGuarded`) is the syscall targets', and
    ; Windows has no `__axiom_stack_disarm` to call either.
    (emitLine cg "  %r = call i64 @__axiom_par_call(i64 %fn, i64 %arg)")
    (emitLine cg "  %p3 = getelementptr i64, ptr %pg, i64 3")
    (emitLine cg "  store i64 %r, ptr %p3")
    (emitLine cg "  call void @__axiom_par_sweep(i64 -1)")
    (emitLine cg "  call void @__axiom_arena_unmap_thread()")
    (emitLine cg "  ret ptr null")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "define internal i64 @__axiom_par_spawn_thread(i64 %fn, i64 %arg) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %page = call i64 @__axiom_par_page()")
    (emitLine cg "  %hp = inttoptr i64 %page to ptr")
    (emitLine cg "  %p1 = getelementptr i64, ptr %hp, i64 1")
    (emitLine cg "  store i64 %fn, ptr %p1")
    (emitLine cg "  %p2 = getelementptr i64, ptr %hp, i64 2")
    (emitLine cg "  store i64 %arg, ptr %p2")
    (emitParNameHandle cg 5)
    (emitLine cg
      "  %th = call i64 @CreateThread(i64 0, i64 0, i64 ptrtoint (ptr @__axiom_par_entry to i64), i64 %page, i64 0, i64 0)")
    (emitLine cg "  store i64 %th, ptr %hp")
    (emitLine cg "  %bad = icmp eq i64 %th, 0")
    (emitLine cg "  br i1 %bad, label %fail, label %ok")
    (emitLine cg "fail:")
    (emitLine cg "  %dis = call i64 @__axiom_par_finish(i64 %page)")
    (emitLine cg "  call i64 @__axiom_par_spawn_failed()")
    (emitLine cg "  unreachable")
    (emitLine cg "ok:")
    (emitLine cg "  call void @__axiom_par_link(i64 %page, i64 2)")
    (emitLine cg "  ret i64 %hw")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "define internal i64 @__axiom_par_join_thread(i64 %hw) #0 {")
    (emitLine cg "entry:")
    (emitParJoinPage cg 5)
    (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
    (emitLine cg "  %hp = inttoptr i64 %h to ptr")
    (emitLine cg "  %t = load i64, ptr %hp")
    (emitLine cg "  %w = call i64 @WaitForSingleObject(i64 %t, i64 4294967295)")
    (emitLine cg "  %w32 = and i64 %w, 4294967295")
    (emitLine cg "  %bad = icmp ne i64 %w32, 0")
    (emitLine cg "  br i1 %bad, label %gone, label %fine")
    (emitLine cg "gone:")
    (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
    (emitLine cg "  call i64 @__axiom_par_join_lost()")
    (emitLine cg "  unreachable")
    (emitLine cg "fine:")
    (emitLine cg "  %cl = call i64 @CloseHandle(i64 %t)")
    (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
    (emitLine cg "  %res = call i64 @__axiom_par_finish(i64 %h)")
    (emitLine cg "  ret i64 %res")
    (emitLine cg "}")
    (emitLine cg "")
    ; The non-raising join: the cell takes 0, or `GetLastError` after a
    ; failed wait, which is the only failure it can report, as the POSIX
    ; half says of `pthread_join`'s.
    (emitLine cg "define internal i64 @__axiom_par_join_nr_thread(i64 %hw, i64 %cell) #0 {")
    (emitLine cg "entry:")
    (emitParJoinPage cg 5)
    (emitLine cg "  call void @__axiom_par_check_owner(i64 %h)")
    (emitLine cg "  %hp = inttoptr i64 %h to ptr")
    (emitLine cg "  %t = load i64, ptr %hp")
    (emitLine cg "  %w = call i64 @WaitForSingleObject(i64 %t, i64 4294967295)")
    (emitLine cg "  %w32 = and i64 %w, 4294967295")
    (emitLine cg "  %bad = icmp ne i64 %w32, 0")
    (emitLine cg "  %le = call i64 @GetLastError()")
    (emitLine cg "  %le32 = and i64 %le, 4294967295")
    (emitLine cg "  %rc64 = select i1 %bad, i64 %le32, i64 0")
    (emitLine cg "  %cellp = inttoptr i64 %cell to ptr")
    (emitLine cg "  store i64 %rc64, ptr %cellp")
    (emitLine cg "  call void @__axiom_par_unlink(i64 %h)")
    (emitLine cg "  br i1 %bad, label %gone, label %fine")
    (emitLine cg "gone:")
    (emitLine cg "  ret i64 0")
    (emitLine cg "fine:")
    (emitLine cg "  %cl = call i64 @CloseHandle(i64 %t)")
    (emitLine cg "  %res = call i64 @__axiom_par_finish(i64 %h)")
    (emitLine cg "  ret i64 %res")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

(pub :: argHas (-> String Int Bool))
;@axiom:effect(io)
(pub fn (argHas flag i)
  (if (>= i sysArgc)
    false
    (if (strEq (sysArg i) flag)
      true
      (argHas flag (+ i 1)))))

; The build's heap ceiling in bytes. `--heap-ceiling N` carves the heap
; from a static region of N bytes instead of the kernel's pages, reusing
; the embedded track's second strategy (4.2) on a hosted target. Zero -
; absent, or unparsable - means the target table decides, which is
; `mmap` on every supported target.
;
; Both spellings are read, because the validator accepts both and
; honouring one while validating the other would be a flag that
; silently does nothing. The validator (`checkFlagValue` in driver.ax)
; refuses anything but digits before any subcommand acts, so the strict
; parse below is defence in depth for the paths that reach the emitter
; another way.
(pub :: heapCeilingBytes Int)
;@axiom:effect(io)
(pub fn (heapCeilingBytes)
  (ceilingScan 1))

; Whether this build's allocator poisons a block as it files it:
; `--alloc-poison` on the command line. A filed block's payload is
; overwritten with a pattern before it can be handed out again, so a
; read or write of freed memory in the program being built sees the
; pattern rather than the bytes it left there. The handout still
; promises zeroed memory (MM-ALLOC-6): only the filing changes.
; Nothing in a default build changes - the flag is read here, from
; the emitter's own arguments, as `--heap-ceiling` is.
(pub :: allocPoisonOn Int)
;@axiom:effect(io)
(pub fn (allocPoisonOn)
  (poisonScan 1))

(pub :: poisonScan (-> Int Int))
;@axiom:effect(io)
(pub fn (poisonScan i)
  (if (>= i sysArgc)
    0
    (if (strEq (sysArg i) "--")
      0
      (if (strEq (sysArg i) "--alloc-poison")
        1
        (poisonScan (+ i 1))))))

(pub :: ceilingScan (-> Int Int))
;@axiom:effect(io)
(pub fn (ceilingScan i)
  (if (>= i sysArgc)
    0
    {
      (let a (sysArg i))
      (if (strEq a "--heap-ceiling")
        (if (< (+ i 1) sysArgc)
          (parseCeiling (sysArg (+ i 1)))
          0)
        (if (&& (>= (strLen a) 15) (strEq (strSlice a 0 15) "--heap-ceiling="))
          (parseCeiling (strSlice a 15 (- (strLen a) 15)))
          (ceilingScan (+ i 1))))
    }))

; Strict decimal parse with saturation: empty and non-digit answers 0,
; and anything past 18 digits answers 2^62 rather than wrapping the
; word. `strToInt` will not do: it takes a leading `-`, skips `_`, and
; stops at the first non-digit, so three spellings of one flag would
; parse three ways.
(pub :: parseCeiling (-> String Int))
(pub fn (parseCeiling s)
  (if (> (strLen s) 18)
    4611686018427387904
    (parseCeilingAcc s 0 0)))

(pub :: parseCeilingAcc (-> String Int Int Int))
(pub fn (parseCeilingAcc s i acc)
  (if (>= i (strLen s))
    acc
    {
      (let ch (strByte s i))
      (if (&& (>= ch 48) (<= ch 57))
        (parseCeilingAcc s (+ i 1) (+ (* acc 10) (- ch 48)))
        0)
    }))

(pub :: crateDirsOf Names)
;@axiom:effect(io)
(pub fn (crateDirsOf)
  {
    (let v vecNew)
    {
      (collectCrateDirs v 1)
      v
    }
  })

(pub :: collectCrateDirs (-> Names Int Int))
;@axiom:effect(io)
(pub fn (collectCrateDirs v i)
  (if (>= i sysArgc)
    0
    {
      (let a (sysArg i))
      (if (strEq a "--crate")
        {
          (if (< (+ i 1) sysArgc)
            (vecPush v (sysArg (+ i 1))))
          (collectCrateDirs v (+ i 2))
        }
        (if (strStartsWith a "--crate=")
          {
            (vecPush v (strSlice a 8 (- (strLen a) 8)))
            (collectCrateDirs v (+ i 1))
          }
          (collectCrateDirs v (+ i 1))))
    }))

(pub :: firstOperandArg (-> Int String))
;@axiom:effect(io)
(pub fn (firstOperandArg i)
  (if (>= i sysArgc)
    ""
    {
      (let a (sysArg i))
      (if (strStartsWith a "-")
        (firstOperandArg (+ i 1))
        a)
    }))

; Flags that take a value, mirrored from `flagArity` in driver.ax.
; `entryInputPath` below must skip their values when hunting the input
; file; driver cannot be imported here (it imports this module), so the
; list lives twice and `check-driver.sh` holds the two to each other -
; a value flag added to one and not the other misreads the command
; line here while validating it there.
(pub :: valueFlag (-> String Bool))
(pub fn (valueFlag a)
  (|| (strEq a "--input")
    (|| (strEq a "--output")
      (|| (strEq a "-o")
        (|| (strEq a "--target")
          (|| (strEq a "--opt")
            (|| (strEq a "--heap-ceiling")
              (|| (strEq a "--link-lib")
                (|| (strEq a "--link-search")
                  (|| (strEq a "--crate")
                    (|| (strEq a "--emit-rust-binding")
                      (|| (strEq a "--filter")
                        (|| (strEq a "--jobs")
                          (|| (strEq a "--diagnostic-format")
                            (|| (strEq a "--out") (strEq a "--emit"))))))))))))))))

; The input file as argv spelled it. `dieImport` above records why
; argv is re-derived here rather than imported; the rule below is the
; one `main.ax` resolves it with (`inputOperand` for every subcommand
; but `run`, `runInputOperand` there), so both answers agree on every
; invocation the validator accepts. "" when no file is named (the
; REPL, `test` on a directory) - resolution treats "" as "no entry
; text", and frames from such runs stay bare rather than pointing
; nowhere.
(pub :: entryInputPath String)
;@axiom:effect(io)
(pub fn (entryInputPath)
  (if (strEq (cgSubcommandAt) "run")
    {
      (let p (cgPositionalAt))
      (if (> (strLen p) 0)
        p
        (cgFlagInputValue))
    }
    {
      (let v (cgFlagInputValue))
      (if (> (strLen v) 0)
        v
        (cgPositionalAt))
    }))

; The subcommand this invocation names, mirrored from `isSubcommand`
; in driver.ax and held to it by `check-driver.sh`: the first argv
; word that is one, or "" - `subcommandIndex`'s rule, which consults
; argv[1] directly first for the same `--version` reason its comment
; gives.
(pub :: cgSubcommand (-> String Bool))
(pub fn (cgSubcommand a)
  (match a
    ("build" true)
    ("lsp" true)
    ("check" true)
    ("run" true)
    ("test" true)
    ("emit-llvm" true)
    ("fmt" true)
    ("explain" true)
    ("symbols" true)
    ("doc" true)
    ("repl" true)
    ("new" true)
    ("fetch" true)
    ("version" true)
    ("--version" true)
    ("-V" true)
    ("help" true)
    ("--help" true)
    ("-h" true)
    (_ false)))

(pub :: cgSubcommandIndex Int)
;@axiom:effect(io)
(pub fn (cgSubcommandIndex)
  {
    (let a1
      (if (> sysArgc 1)
        (sysArg 1)
        ""))
    (if (cgSubcommand a1)
      1
      (cgPositionalIndex 1))
  })

(pub :: cgSubcommandAt String)
;@axiom:effect(io)
(pub fn (cgSubcommandAt)
  {
    (let i (cgSubcommandIndex))
    (if (< i 0)
      ""
      {
        (let a (sysArg i))
        (if (cgSubcommand a)
          a
          "")
      })
  })

(pub :: cgPositionalIndex (-> Int Int))
;@axiom:effect(io)
(pub fn (cgPositionalIndex from)
  (if (>= from sysArgc)
    (- 0 1)
    {
      (let a (sysArg from))
      (if (strEq a "--")
        (if (< (+ from 1) sysArgc)
          (+ from 1)
          (- 0 1))
        (if (strStartsWith a "-")
          (if (cgFlagHasValuePart a)
            (cgPositionalIndex (+ from 1))
            (if (valueFlag a)
              (cgPositionalIndex (+ from 2))
              (cgPositionalIndex (+ from 1))))
          from))
    }))

(pub :: cgOperandStart Int)
;@axiom:effect(io)
(pub fn (cgOperandStart)
  {
    (let i (cgSubcommandIndex))
    (if (< i 0)
      1
      (if (cgSubcommand (sysArg i))
        (+ i 1)
        i))
  })

(pub :: cgPositionalAt String)
;@axiom:effect(io)
(pub fn (cgPositionalAt)
  {
    (let i (cgPositionalIndex (cgOperandStart)))
    (if (< i 0)
      ""
      (sysArg i))
  })

(pub :: cgFlagHasValuePart (-> String Bool))
(pub fn (cgFlagHasValuePart a)
  (isSome (strFindByte a 61 0)))

; `--input`, either spelling. `flagValue` lives in driver.ax, which
; cannot be imported here, so the one flag this needs is read
; directly; anything more general would re-derive that whole walker.
(pub :: cgFlagInputValue String)
;@axiom:effect(io)
(pub fn (cgFlagInputValue)
  (cgFlagInputScan 1))

(pub :: cgFlagInputScan (-> Int String))
;@axiom:effect(io)
(pub fn (cgFlagInputScan i)
  (if (>= i sysArgc)
    ""
    {
      (let a (sysArg i))
      (if (&& (>= (strLen a) 8) (strEq (strSlice a 0 8) "--input="))
        (strSlice a 8 (- (strLen a) 8))
        (if (strEq a "--input")
          (if (< (+ i 1) sysArgc)
            (sysArg (+ i 1))
            "")
          (cgFlagInputScan (+ i 1))))
    }))

; One resolution owns its speculative parse cache. Workers never mutate
; namespace tables, source units or declarations the resolver has used.
(pub struct FrontModule
  (name : String)
  (path : String)
  (parsed : FrontParsed))

(pub struct FrontCache
  (mut width : Int)
  (modules : (Vec FrontModule)))

; `AXIOM_FRONTEND_JOBS=1` forces the serial path, `2` to `8` sets the
; worker width, and an invalid value also uses the serial path. When
; the variable is unset, the answer is 0: the caller runs workers by
; default once a frontier is large, and stays serial below that.
; Forking one module on its own costs more than parsing it, which is
; why a small frontier never forks. Cap process and shared-packet
; memory together.
(pub :: frontJobs Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
(pub fn (frontJobs)
  {
    (let text (sysEnv "AXIOM_FRONTEND_JOBS"))
    (let width (strToInt text))
    (if (== sysForkNum 0)
      1
      (if (== (strLen text) 0)
        0
        (if (&& (&& (>= width 2) (<= width 8)) (strEq text (fmtInt width)))
          width
          1)))
  })

(pub :: frontCached (-> FrontCache String (Option FrontModule)))
(pub fn (frontCached cache name)
  {
    (let mut i 0)
    (let mut found None)
    (while (< i (vecLen cache.modules))
      {
        (let candidate (vecGet cache.modules i))
        (if (strEq candidate.name name)
          {
            (set found (Some candidate))
            (set i (vecLen cache.modules))
          }
          (set i (+ i 1)))
      })
    found
  })

(pub :: frontReadPacket (-> String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (frontReadPacket path)
  {
    ; Runs only in the speculative child. Resource traps there must
    ; not print ahead of the parent's deterministic diagnostic pass.
    (__syscall1 sysCloseNum 2)
    (match (readFile path)
      ((Err e) "")
      ((Ok source)
        (if (let (Some parsed) (frontParse source))
          (frontEncode parsed)
          "")
      ))
  })

; Prefetch only siblings, then let the existing depth-first traversal
; consume them. Failures stay silent until that traversal reaches the
; import, so a faster failing sibling cannot change the first diagnostic.
; Source overlays already in `units` always win over files on disk.
(pub :: frontPrefetchImports (-> (Vec ASTNode) Names Int String Units FrontCache Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (frontPrefetchImports decls seen tcode entryDir units cache)
  {
    (if (&& (> cache.width 1) (!= sysForkNum 0))
      {
        (let names vecNew)
        (let paths vecNew)
        (let mut i 0)
        (while (< i (vecLen decls))
          {
            (let decl (vecGet decls i))
            (if (== (nodeTag decl) TAG_D_IMPORT)
              {
                (let name (nodeAName decl))
                (if (&& (! (seenHas seen name))
                      (&& (! (seenHas names name))
                        (&& (isNone (unitIndexOf units name 0)) (isNone (frontCached cache name)))))
                  {
                    (let path (moduleSrcPath name tcode entryDir))
                    (if (> (strLen path) 0)
                      {
                        (vecPush names name)
                        (vecPush paths path)
                      })
                  })
              })
            (set i (+ i 1))
          })
        ; A one-module frontier still discovers its independent imports.
        (if (> (vecLen names) 0)
          {
            (let results (frontParseFiles paths (frontFileSizes paths) cache.width))
            (set i 0)
            (while (< i (vecLen results))
              {
                (if (let (Some parsed) (vecGet results i))
                  {
                    (vecPush cache.modules
                      (FrontModule
                        :name (vecGetStr names i)
                        :path (vecGetStr paths i)
                        :parsed parsed))
                    0
                  }
                  0)
                (set i (+ i 1))
              })
          })
      })
    0
  })

; Declaration Vec for module `name`; a module that cannot be read or
; parsed is a fatal diagnostic, never a 0 this returns. It also records
; the module in the UNIT TABLE - the path a diagnostic about this module
; renders against, its text, and its name so the checker can find the
; index from a declaration's `module` stamp.
(pub :: parseModuleOrDieUnit (-> String Int String Units String ASTNode FrontCache (Vec ASTNode)))
;@axiom:effect(io)
(pub fn (parseModuleOrDieUnit name tcode entryDir units parentName site cache)
  (if (let (Some module) (frontCached cache name))
    (if (|| (isSome (unitIndexOf units name 0))
          (cachedModuleWrongOrigin module units parentName tcode))
      (parseModuleOrDieUnitSerial name tcode entryDir units parentName site)
      {
        (let parsed module.parsed)
        (vecPush units
          (CUnit2
            :file module.path
            :src parsed.source
            :name (Some name)
            :imports vecNew
            :library (pathInStdlib module.path)))
        parsed.decls
      })
    (parseModuleOrDieUnitSerial name tcode entryDir units parentName site)))

; Prefetching has no parent context. A cached local module cannot
; satisfy a library import that resolves to the library's own file.
(pub :: cachedModuleWrongOrigin (-> FrontModule Units String Int Bool))
;@axiom:effect(io)
(pub fn (cachedModuleWrongOrigin module units parentName tcode)
  {
    (let parent
      (vecGet units
        (if (== (as parentName Int) 0)
          0
          (match (unitIndexOf units parentName 0)
            ((Some index) index)
            ((None) __indexTrap)))))
    (if (== (unitInStdlib parent) 1)
      {
        (let library (stdlibModulePath module.name tcode))
        (&& (> (strLen library) 0) (! (strEq library module.path)))
      }
      false)
  })

; Whether a unit's file lives in the standard library, so its own
; imports resolve against the library first: a file beside the entry
; program named like a library module must not replace the library's
; own copy for the library itself. The entry file's imports keep the
; documented entry-first order.
(pub :: unitInStdlib (-> core::CUnit2 Int))
;@axiom:effect(io)
(pub fn (unitInStdlib unit)
  (unitInDirs (unitFile unit) stdlibSearchDirs 0))

; Whether `path` names a file inside the standard library's own
; directories, which is what makes a unit part of the library for the
; checker (AX5002). Both sides are compared as clean absolute paths, so
; `stdlib/IO.ax` named from the repository and a search directory
; spelled `.axiom-bin/../stdlib/` agree. A symlink is an ordinary name
; here, as it is to `pathClean`.
(pub :: pathInStdlib (-> String Bool))
;@axiom:effect(io)
(pub fn (pathInStdlib path)
  (dirsHoldPath (pathAbsClean path) stdlibSearchDirs 0))

(pub :: dirsHoldPath (-> String Names Int Bool))
;@axiom:effect(io)
(pub fn (dirsHoldPath file dirs i)
  (if (>= i (vecLen dirs))
    false
    (if (strStartsWith file (pathWithSlash (pathAbsClean (vecGetStr dirs i))))
      true
      (dirsHoldPath file dirs (+ i 1)))))

; `p` made absolute against the working directory, then cleaned.
(pub :: pathAbsClean (-> String String))
;@axiom:effect(io)
(pub fn (pathAbsClean p)
  (pathClean
    (if (pathIsAbsolute p)
      p
      (match cwd
        ((Ok dir) (concat (pathWithSlash dir) p))
        ((Err _) p)))))

(pub :: unitInDirs (-> String Names Int Int))
(pub fn (unitInDirs file dirs i)
  (if (>= i (vecLen dirs))
    0
    (if (strStartsWith file (vecGetStr dirs i))
      1
      (unitInDirs file dirs (+ i 1)))))

; `name` resolved against the standard library only, or "".
(pub :: stdlibModulePath (-> String Int String))
;@axiom:effect(io)
(pub fn (stdlibModulePath name tcode)
  {
    (let stem (modPathToFile name))
    {
      (let a (searchDirsFor stdlibSearchDirs (concat stem (targetOsArchSuffix tcode)) 0))
      (if (> (strLen a) 0)
        a
        {
          (let b (searchDirsFor stdlibSearchDirs (concat stem (targetOsSuffix tcode)) 0))
          (if (> (strLen b) 0)
            b
            (searchDirsFor stdlibSearchDirs (concat stem ".ax") 0))
        })
    }
  })

(pub :: parseModuleOrDieUnitSerial (-> String Int String Units String ASTNode (Vec ASTNode)))
;@axiom:effect(io)
(pub fn (parseModuleOrDieUnitSerial name tcode entryDir units parentName site)
  {
    (let parent
      (vecGet units
        (if (== (as parentName Int) 0)
          0
          (match (unitIndexOf units parentName 0)
            ((Some index) index)
            ((None) __indexTrap)))))
    {
      (if (isNone (unitIndexOf units name 0))
        {
          (let path
            (if (== (unitInStdlib parent) 1)
              {
                (let lib (stdlibModulePath name tcode))
                (if (> (strLen lib) 0)
                  lib
                  (moduleSrcPath name tcode entryDir))
              }
              (moduleSrcPath name tcode entryDir)))
          (if (== (strLen path) 0)
            (dieImportDiag name tcode entryDir parent (nodeSpan site))
            {
              (let unit
                (CUnit2
                  :file path
                  :src (unwrapOr (readFile path) "")
                  :name (Some name)
                  :imports vecNew
                  :library (pathInStdlib path)))
              {
                (vecPush units unit)
                0
              }
            })
        })
      (match (unitIndexOf units name 0)
        ((Some index)
          (parseModuleSourceOrDie name tcode entryDir parent (nodeSpan site)
            (unitSrc (vecGet units index)))
        )
        ((None) __indexTrap))
    }
  })

; The first named unit at or after i. Entry units have no module name.
(pub :: unitIndexOf (-> Units String Int (Option Int)))
(pub fn (unitIndexOf units name i)
  (if (>= i (vecLen units))
    None
    (if (unitIsEntry (vecGet units i))
      (unitIndexOf units name (+ i 1))
      (if (unitNameIs (vecGet units i) name)
        (Some i)
        (unitIndexOf units name (+ i 1))))))

; An unresolved import reports AX5001 at the import form in its
; parent's source unit, including imports nested inside other modules.
; The help lists each candidate filename and search directory. These
; depend on the compiler's location, so check-driver.sh pins the source
; span and search structure rather than a complete golden.
;
; The format flag is re-derived from argv here for the same reason
; dieImport re-derives the subcommand: driver.ax owns flagValue and
; importing it from codegen would be a cycle. An unknown value never
; reaches here: `checkArgs` refuses it before any subcommand runs.
(pub :: diagFormatFromArgv Int)
;@axiom:effect(io)
(pub fn (diagFormatFromArgv)
  (diagFormatScan 1))

(pub :: diagFormatScan (-> Int Int))
;@axiom:effect(io)
(pub fn (diagFormatScan i)
  (if (>= i sysArgc)
    FMT_HUMAN
    {
      (let a (sysArg i))
      (if (strEq a "--diagnostic-format")
        (if (< (+ i 1) sysArgc)
          {
            (let c (parseDiagFormatName (sysArg (+ i 1))))
            (if (>= c 0)
              c
              FMT_HUMAN)
          }
          FMT_HUMAN)
        (if (strStartsWith a "--diagnostic-format=")
          {
            (let c (parseDiagFormatName (strSlice a 20 (- (strLen a) 20))))
            (if (>= c 0)
              c
              FMT_HUMAN)
          }
          (diagFormatScan (+ i 1))))
    }))

; `looked for 'A' or 'B' or 'C' in 'd1', 'd2', ...` - the same
; candidates and directories readModuleSrc searched, in the same
; order, so the help never claims a search that did not happen.
; Answers the `String` its body always built; the signature said
; `Int` until the checker compared the two (2026-08-21).
(pub :: importHelpText (-> String Int String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (importHelpText name tcode entryDir)
  {
    (let stem (modPathToFile name))
    (let dirs (moduleSearchDirs entryDir))
    {
      (let parts vecNew)
      {
        (vecPush parts "looked for '")
        (vecPush parts (concat stem (targetOsArchSuffix tcode)))
        (vecPush parts "' or '")
        (vecPush parts (concat stem (targetOsSuffix tcode)))
        (vecPush parts "' or '")
        (vecPush parts (concat stem ".ax"))
        (vecPush parts "' in ")
        {
          (let mut i 0)
          (while (< i (vecLen dirs))
            {
              (if (> i 0)
                (vecPush parts ", ")
                (as 0 (Vec String)))
              (vecPush parts "'")
              (vecPush parts (vecGetStr dirs i))
              (vecPush parts "'")
              (set i (+ i 1))
            })
        }
        (catStrs parts)
      }
    }
  })

(pub :: dieImportDiag (-> String Int String core::CUnit2 Int Int))
;@axiom:effect(io)
(pub fn (dieImportDiag name tcode entryDir parent span)
  {
    (let d
      (mkDiag SEV_ERROR "AX5001" "module-not-found" span
        (concat "cannot resolve import `" (concat name "`")) None
        (Some (importHelpText name tcode entryDir))))
    (let ds vecNew)
    (let units vecNew)
    {
      (vecPush ds d)
      (vecPush units parent)
      {
        (let out (as (renderDiagsFormat diagFormatFromArgv ds units) String))
        (writeStr stderr out)
      }
      ; Exit 1, stage0's code for this failure. The old 3 had exactly
      ; two consumers, both gates, both updated in this commit; the
      ; `symbols` fold to 1 is now the rule rather than the exception.
      (sysExitWith 1)
      0
    }
  })

; An IMPORTED module that does not lex or parse, reported the way the
; entry file's failure is reported.
;
; It used to be `dieImport`: `error: cannot parse module: Broken` on fd
; 2, exit 3, no code, no span, no snippet, and byte-identical under
; `--diagnostic-format=json` - while checking that same file DIRECTLY
; gave a complete `AX2001`/`AX2002` with file, line, column, caret and
; help at exit 1. The information was held by the caller and thrown
; away; `dieImportDiag`, three definitions above, already had the right
; shape for the module that could not be FOUND.
;
; This was the last surface untouched by the parse-error port, and it
; is the one a person compiling a multi-module program meets first: it
; is what a compiler prints when a file it was told to read is broken.
(pub :: dieModuleParse (-> String String Tokens (PResult Nodes) (Option Diag) Int String Int))
;@axiom:effect(io)
(pub fn (dieModuleParse name src toks pr lexD tcode entryDir)
  {
    (let path (moduleSrcPath name tcode entryDir))
    (let ds vecNew)
    (let units vecNew)
    {
      (vecPush ds
        (if (let (Some ld) lexD)
          ld
          (parseErrDiag toks pr src)))
      ; The unit carries the RESOLVED path, not the module name, so the
      ; `-->` line names a file the reader can open.
      (vecPush units (CUnit2 :file path :src src :name None :imports vecNew :library false))
      {
        (let out (as (renderDiagsFormat diagFormatFromArgv ds units) String))
        (writeStr stderr out)
      }
      {
        (let tr (renderFailTrailer 1))
        (writeStr stderr tr)
      }
      ; Exit 1, the status every other diagnostic exits with and the
      ; one `dieImportDiag` moved to when AX5001 became a real
      ; diagnostic. The old 3 said "import machinery" about what is
      ; simply a syntax error in a file.
      (sysExitWith 1)
      0
    }
  })

; Parse the source already recorded in the unit table. Editor clients
; can seed that table with unsaved sources without changing resolution.
(pub :: parseModuleSourceOrDie (-> String Int String core::CUnit2 Int String Nodes))
;@axiom:effect(io)
(pub fn (parseModuleSourceOrDie name tcode entryDir parent span src)
  {
    (let toks (lex src))
    {
      (let lexD (lexErrDiag toks src))
      {
        (let pr
          (if (isNone lexD)
            (parseModuleWith toks (scanAxtags src))
            (pErr 0)))
        (match pr
          ((ParseFailed error)
            {
              (dieModuleParse name src toks pr lexD tcode entryDir)
              vecNew
            }
          )
          ((ParseSuccess declarations after) declarations))
      }
    }
  })

(pub :: seenHas (-> Strings String Bool))
(pub fn (seenHas seen name)
  (seenHasIn seen name 0))

; ------------------------------------------------------------------
; Name mangling.
;
; Two modules may export the same name - `IO.ax` and `Sys.ax` once
; both defined `readFile`, since renamed - and emitting both bare
; produced two `define i64 @readFile` in one LLVM module, which `llc`
; rejects. The scheme is stage0's: a declaration imported from module
; `M` defines the symbol `M$name`, a declaration in the entry file
; keeps its bare name - `@main` must stay `@main` for the linker - and
; a bare *reference* resolves through one flat map, entry file first,
; then imports in resolution order. (stage0's checker now refuses a
; bare reference that two imports define and the entry does not -
; AX3014 - so the imports-in-order tail of that rule only decides
; programs stage0 would no longer accept.) `$` and `.` are both legal
; in an unquoted LLVM identifier, so `Sys.Platform$sysWriteNum` needs no
; quoting.
;
; The map is two Vecs pushed in lockstep rather than a Map, because it
; is small (one entry per top-level function) and built once.
; ------------------------------------------------------------------
; The symbol a bare reference reaches: the DEFINING MODULE'S OWN
; definition when the reference is made inside a module that has one,
; then the entry file's, then the first-resolved import's, and the name
; unchanged when nothing claims it - parameters, locals and primitives
; never enter the map.
;
; The module-local step is what stops an import from changing an
; imported module's behaviour. `Lib.libCall` calling its own `helper`
; reached the ENTRY FILE's `helper` when the entry defined one, in a
; program both compilers accepted and neither diagnosed - so importing
; a module could silently rewrite what that module does. stage0 applies
; the same rule in `mangled_name_for`, and the two have to agree
; symbol for symbol or the fixpoint is comparing different programs.
(pub :: mangledFor (-> CG String String))
(pub fn (mangledFor cg name)
  ; A reference to `main` - a recursive call, or main as a value -
  ; must reach the renamed user function, never the argv wrapper,
  ; which would re-store whatever its two parameters happened to be.
  (if (strEq name "main")
    "__axiom_user_main"
    (if (let (Some m) (cgModule cg))
      {
        (let local (concat m (concat "$" name)))
        (if (mangleHasIn (cgMangleBares cg) local 0)
          (mangledForIn (cgMangleBares cg) (cgMangleFulls cg) local 0)
          (mangledForModIn (cgMangleBares cg) (cgMangleFulls cg) name))
      }
      (mangledForIn (cgMangleBares cg) (cgMangleFulls cg) name 0))))

; `mangledForModCg`'s answer by scanning, for the paths with no index.
(pub :: mangledForModIn (-> Strings Strings String String))
(pub fn (mangledForModIn bares fulls name)
  {
    (let full (mangledForIn bares fulls name 0))
    (if (|| (strEq full name) (mangleHasIn bares (concat "$entry$" name) 0))
      (if (mangleHasIn bares name 0)
        {
          (let key (concat "$" name))
          (if (mangleHasIn bares key 0)
            (mangledForIn bares fulls key 0)
            full)
        }
        full)
      full)
  })

(pub :: mangledForIn (-> Strings Strings String Int String))
(pub fn (mangledForIn bares fulls name i)
  (if (>= i (vecLen bares))
    name
    (if (strEq (vecGet bares i) name)
      (vecGet fulls i)
      (mangledForIn bares fulls name (+ i 1)))))

; Every entry-file function maps to itself, recorded ahead of every
; import so that a collision resolves to the file being compiled.
(pub :: recordEntryFns (-> (Vec ASTNode) MangleIdx Strings Strings Int Int))
(pub fn (recordEntryFns decls idx bares fulls i)
  (if (>= i (vecLen decls))
    0
    {
      {
        (let d (vecGet decls i))
        (if (== (nodeTag d) TAG_D_FN)
          (mangleRecord idx bares fulls (nodeAName d) (nodeAName d))
          ; An `extern` item maps its AXIOM name to its LINKER SYMBOL,
          ; which is what makes the call site need no new code at all:
          ; `mangledFor` already resolves through these two vectors, so
          ; `emitPlainCall` emits its usual `call i64 @<sym>(...)` and
          ; the symbol it names is the Rust one.
          (if (== (nodeTag d) TAG_D_EXTERN)
            (recordExternSyms idx bares fulls (nodeCChildren d) 0)))
      }
      (recordEntryFns decls idx bares fulls (+ i 1))
    }))

(pub :: recordExternSyms (-> MangleIdx Strings Strings (Vec ASTNode) Int Int))
(pub fn (recordExternSyms idx bares fulls items i)
  (if (== (as items Int) 0)
    0
    (if (>= i (vecLen items))
      0
      ; a = the Axiom name, c = the `(symbol "s")` clause the
      ; parser resolved (defaulting to the Axiom name).
      {
        {
          (let f (vecGet items i))
          {
            (mangleRecord idx bares fulls (nodeAName f) (nodeCName f))
            (vecPush bares (concat "$entry$" (nodeAName f)))
            (vecPush fulls (nodeCName f))
          }
        }
        (recordExternSyms idx bares fulls items (+ i 1))
      })))

(pub :: resolveImports (-> (Vec ASTNode) Names Names ModuleImports Int String Units (Vec ASTNode)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (resolveImports decls bares fulls mods tcode entryDir units)
  ; The index over `bares` lives exactly as long as this pass: it is
  ; created here, over whatever `bares` already holds, and threaded
  ; beside `bares` to every record the pass makes (namespace.ax,
  ; `MangleIdx`). The callers' `bares` stays the plain Vec they
  ; allocated, so nothing they do with it afterwards changes.
  {
    (let idx mangleIdxNew)
    (let cache (FrontCache :width 1 :modules vecNew))
    {
      (recordEntryFns decls idx bares fulls 0)
      (let merged
        (resolveDecls decls vecNew vecNew 0 (as 0 String) idx bares fulls mods (None) tcode
          entryDir units cache))
      (entryFnsOffExternSyms decls merged bares fulls)
      merged
    }
  })

; An entry-file function is emitted under its own name, and an extern
; item under the linker symbol its `(symbol ...)` clause names; the two
; can coincide - a program's `send` beside Winsock's `send`, which
; `Sys/Platform.windows.ax` binds - and the module would then define and
; declare one symbol (`check-cross-targets.sh`, `843-net-stream` for
; windows). Once every import is resolved the extern symbols are all
; known, so such an entry function moves to `axiom$entry$name`, a
; spelling no module produces (a module's name carries no `$`): its
; declaration and signature are renamed as `mangleDecl` renames a
; module's, and its bare record follows, so every call site reaches it
; unchanged. A program with no such name is untouched, byte for byte.
(pub :: entryFnsOffExternSyms (-> (Vec ASTNode) (Vec ASTNode) Names Names Int))
(pub fn (entryFnsOffExternSyms decls merged bares fulls)
  {
    (let syms (externSymsOf merged (externSymsOf decls vecNew 0) 0))
    (if (== (vecLen syms) 0)
      0
      (entryFnsOffExternSymsAt decls syms bares fulls 0))
  })

; The linker symbols of every extern item among `ds`, appended to `acc`.
(pub :: externSymsOf (-> (Vec ASTNode) Names Int Names))
(pub fn (externSymsOf ds acc i)
  (if (>= i (vecLen ds))
    acc
    {
      (let d (vecGet ds i))
      (if (== (nodeTag d) TAG_D_EXTERN)
        (externItemSyms (nodeCChildren d) acc 0)
        0)
      (externSymsOf ds acc (+ i 1))
    }))

(pub :: externItemSyms (-> (Vec ASTNode) Names Int Int))
(pub fn (externItemSyms items acc i)
  (if (|| (== (as items Int) 0) (>= i (vecLen items)))
    0
    {
      (vecPush acc (nodeCName (vecGet items i)))
      (externItemSyms items acc (+ i 1))
    }))

(pub :: entryFnsOffExternSymsAt (-> (Vec ASTNode) Names Names Names Int Int))
(pub fn (entryFnsOffExternSymsAt decls syms bares fulls i)
  (if (>= i (vecLen decls))
    0
    {
      (let d (vecGet decls i))
      (if (&& (|| (== (nodeTag d) TAG_D_FN) (== (nodeTag d) TAG_D_SIG))
            (mangleHasIn syms (nodeAName d) 0))
        {
          (let name (strDup (nodeAName d)))
          (let full (concat "axiom$entry$" name))
          (writeNodeText d 1 full)
          (if (== (nodeTag d) TAG_D_FN)
            (entryRecordRename bares fulls name full 0)
            0)
        }
        0)
      (entryFnsOffExternSymsAt decls syms bares fulls (+ i 1))
    }))

; The entry's own record of `name` - bare and full both the name - now
; answers `full`. One record: the entry file records first and the bare
; slot holds one winner per name.
(pub :: entryRecordRename (-> Names Names String String Int Int))
(pub fn (entryRecordRename bares fulls name full i)
  (if (>= i (vecLen bares))
    0
    (if (&& (strEq (vecGet bares i) name) (strEq (vecGet fulls i) name))
      {
        (vecSet fulls i full)
        0
      }
      (entryRecordRename bares fulls name full (+ i 1)))))

; Parse the discovered import graph in bounded frontiers, then use
; the same resolver. Namespace and diagnostic order stay serial.
; With no explicit width, a frontier of eight or more imports runs on
; four workers and a smaller one stays serial: forking one module on
; its own costs more than parsing it, so a hello-world program never
; forks, while a self-compile frontier of dozens does.
(pub :: resolveImportsParallel
  (-> (Vec ASTNode) Names Names ModuleImports Int String Units (Vec ASTNode)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(unsafe)
(pub fn (resolveImportsParallel decls bares fulls mods tcode entryDir units)
  {
    (let width frontJobs)
    (if (== width 1)
      (resolveImports decls bares fulls mods tcode entryDir units)
      {
        (let cap
          (if (>= width 2)
            width
            4))
        (let idx mangleIdxNew)
        (let cache (FrontCache :width cap :modules vecNew))
        (let scheduled vecNew)
        (let mut pending decls)
        (while (> (vecLen pending) 0)
          {
            (let before (vecLen cache.modules))
            {
              (if (== width 0)
                {
                  (let mut k 0)
                  (let mut frontier 0)
                  {
                    (while (< k (vecLen pending))
                      {
                        (if (== (nodeTag (vecGet pending k)) TAG_D_IMPORT)
                          (set frontier (+ frontier 1)))
                        (set k (+ k 1))
                      })
                    (set cache.width (if (>= frontier 8)
                      cap
                      1))
                  }
                })
              (frontPrefetchImports pending scheduled tcode entryDir units cache)
            }
            (let mut i 0)
            (while (< i (vecLen pending))
              {
                (let node (vecGet pending i))
                (if (== (nodeTag node) TAG_D_IMPORT)
                  (vecPush scheduled (nodeAName node)))
                (set i (+ i 1))
              })
            (let next vecNew)
            (set i before)
            (while (< i (vecLen cache.modules))
              {
                (let module (vecGet cache.modules i))
                (let parsed module.parsed)
                (let mut j 0)
                (while (< j (vecLen parsed.decls))
                  {
                    (let node (vecGet parsed.decls j))
                    (if (== (nodeTag node) TAG_D_IMPORT)
                      (vecPush next node))
                    (set j (+ j 1))
                  })
                (set i (+ i 1))
              })
            (set pending next)
          })
        (recordEntryFns decls idx bares fulls 0)
        (let merged
          (resolveDecls decls vecNew vecNew 0 (as 0 String) idx bares fulls mods (None) tcode
            entryDir units cache))
        (entryFnsOffExternSyms decls merged bares fulls)
        merged
      })
  })

; Append every non-import declaration reachable from `decls` onto `acc`,
; depth-first so that a module's dependencies land ahead of it.
; `modName` is the module the list came from, 0 for the entry file; an
; imported function is renamed to `modName$name` as it lands.
;
; `filter` is the optional import name list; `None` keeps the module's
; entire public surface. `Some (a b)` exports only those bare names.
; All declarations and nested imports are still merged, so a public
; body can call its own private helpers regardless of the import list.
;
; `acc` and `seen` are threaded rather than rebuilt: `vecPush` mutates in
; place and returns the same handle, so both stay stable across the whole
; traversal and siblings observe each other's additions.
(pub :: resolveDecls
  (-> (Vec ASTNode) (Vec ASTNode) Strings Int String MangleIdx Strings Strings ModuleImports
    (Option Names) Int String (Vec core::CUnit2) FrontCache (Vec ASTNode)))
;@axiom:effect(io)
(pub fn (resolveDecls decls acc seen i modName idx bares fulls mods filter tcode entryDir units
          cache)
  (resolveDeclsPhase decls
    (resolveDeclsPhase decls acc seen i modName idx bares fulls mods filter tcode entryDir units 0
      cache)
    seen i modName idx bares fulls mods filter tcode entryDir units 1 cache))

; Two passes: stage0 partitions a module's imports into
; `Module::imports` and resolves ALL of them before any of the
; module's own declarations, at every level. Splicing an import at
; its source position agreed with stage0 on every file whose imports
; sit at the top - which is nearly all of them - and diverged the
; program's declaration order on the ones with a mid-file import,
; found when Sys.ax (a late `(import Mem)`) met the `symbols`
; differential: stage0 listed Mem's functions before Sys's own, this
; resolver the other way round.
; One pass: phase 0 consumes only the `(import ...)` entries (each
; imported module resolving BOTH its phases depth-first), phase 1 only
; the module's own declarations.
(pub :: resolveDeclsPhase
  (-> (Vec ASTNode) (Vec ASTNode) Strings Int String MangleIdx Strings Strings ModuleImports
    (Option Names) Int String (Vec core::CUnit2) Int FrontCache (Vec ASTNode)))
;@axiom:effect(io)
(pub fn (resolveDeclsPhase decls acc seen i modName idx bares fulls mods filter tcode entryDir
          units phase cache)
  (if (>= i (vecLen decls))
    acc
    {
      (let first (vecGet decls i))
      (if (== (nodeTag first) TAG_D_IMPORT)
        (if (== phase 1)
          (resolveDeclsPhase decls acc seen (+ i 1) modName idx bares fulls mods filter tcode
            entryDir units phase cache)
          {
            (if (!= (as modName Int) 0)
              (match (unitIndexOf units modName 0)
                ((None) __indexTrap)
                ((Some index)
                  {
                    (let unit (vecGet units index))
                    (vecPush unit.imports first)
                  }
                )))
            (let name (nodeAText first))
            (if (seenHas seen name)
              ; A repeat import of an already-merged module. The
              ; declarations are in `acc` and are NOT spliced again
              ; (diamond-safe, merged exactly once) - but the
              ; import's name list still widens what the module
              ; exports, or the second list is dead text and the
              ; checker's remedy ("add the name to the import's
              ; list", AX3023) is a lie the author already obeyed.
              (resolveDeclsPhase decls (resolveRepeatImport name first idx bares fulls mods acc)
                seen (+ i 1) modName idx bares fulls mods filter tcode entryDir units phase cache)
              {
                (vecPush seen name)
                ; The import's name list, recorded against
                ; the module it filtered. A module is merged
                ; exactly once (the `seen` test above), so
                ; there is exactly one merge per module - but
                ; the recorded filter is the UNION of every
                ; import's list (see `resolveRepeatImport`),
                ; because phase D needs it: a declaration a
                ; macro generates INSIDE this module does not
                ; exist yet when the filter is applied here
                ; (MAC-EXP-16).
                {
                  (let modDecls
                    (parseModuleOrDieUnit name tcode entryDir units modName first cache))
                  (let subFilter
                    {
                      (let ns (nodeBNames first))
                      (if (== (as ns Int) 0)
                        (None)
                        (if (== (vecLen ns) 0)
                          (None)
                          (Some ns)))
                    })
                  {
                    (modFilterRecord mods name subFilter)
                    (resolveDeclsPhase decls
                      (resolveDecls modDecls acc seen 0 name idx bares fulls mods subFilter tcode
                        entryDir units cache)
                      seen (+ i 1) modName idx bares fulls mods filter tcode entryDir units phase
                      cache)
                  }
                }
              })
          })
        (if (== phase 0)
          (resolveDeclsPhase decls acc seen (+ i 1) modName idx bares fulls mods filter tcode
            entryDir units phase cache)
          ; `pub` and the import's name list decide which BARE
          ; NAMES are visible, not which declarations exist. They
          ; used to decide both, through this one `if`, and the
          ; two are different things: the module's public bodies
          ; were spliced and the declarations they call were
          ; dropped, so a module with a private helper was a
          ; module nobody could import - it failed with AX3001 at
          ; ITS OWN lines, in a file that merely read it.
          ;
          ; Worse where the importing program happened to define
          ; the same name: the dropped declaration left the bare
          ; slot free, the importer's definition claimed it, and
          ; the imported module's own call landed on it. Measured
          ; on `(import IO (println))` beside an entry-file
          ; `writeStr`: the standard library printed the entry
          ; file's bytes, twice, at exit 0, with no diagnostic
          ; from any pass. Importing a module could rewrite what
          ; that module does.
          ;
          ; So every declaration is carried, and `exported` -
          ; recorded on the node, where the checker reads it -
          ; says whether anything outside may name it.
          ; Provenance, recorded before mangling rewrites the
          ; name: this is the only point in the pipeline that
          ; knows which module a declaration came from.
          {
            (let exported (moduleDeclExport first modName mods filter))
            {
              (writeNodeText first 8 modName)
              ; moduleDeclExport preserves the original public names,
              ; including individual items of foreign blocks.
              ; From here on word 5 answers "may a reference from
              ; outside this module name it", not "was it written
              ; `pub`". The entry file's own declarations are all
              ; visible; nothing imports them.
              (writeNodeWord first 5 exported)
              (mangleDecl first (nodeModuleOpt first) idx bares fulls exported)
              (resolveDeclsPhase decls (vecPush acc first) seen (+ i 1) modName idx bares fulls
                mods filter tcode entryDir units phase cache)
            }
          }))
    }))

; A repeat import of an already-merged module: widen what the module
; exports by the names THIS import's list adds, and answer `acc`.
; The declarations stay exactly where the first import put them -
; merged exactly once - so this walk only flips verdicts, from "left
; out" to "exported", for declarations the module itself made public.
; A name the module never declared, or one it declared private, is
; left alone: the checker's `checkImportNames` still reports those
; against this import's own span, with the module's `pub` names as
; its witness (namespace.ax, `modPubsFor`).
;
; The recorded filter widens too (same union), because phase D
; applies it to macro-made declarations that did not exist while
; either import ran (MAC-EXP-16) - the recorded answer has to cover
; every list, not the first one.
(pub :: resolveRepeatImport
  (-> String ASTNode MangleIdx Strings Strings ModuleImports (Vec ASTNode) (Vec ASTNode)))
(pub fn (resolveRepeatImport mod imp idx bares fulls mods acc)
  {
    (let sub (nodeBNames imp))
    (if (|| (== (as sub Int) 0) (== (vecLen sub) 0))
      ; A bare repeat import names everything, so the union is the
      ; module's whole public surface and the recorded filter goes
      ; back to `None`, the unrestricted public surface.
      {
        (modFilterWiden mods mod (None))
        (repeatExportNew acc mod (modPubsFor mods mod) idx bares fulls 0)
      }
      (if (let (Some old) (modFilterFor mods mod))
        {
          (let delta (repeatDelta old sub (modPubsFor mods mod) vecNew 0))
          (if (== (vecLen delta) 0)
            acc
            {
              (modFilterWiden mods mod (Some (repeatUnion old delta)))
              (repeatExportNew acc mod delta idx bares fulls 0)
            })
        }
        ; The first import was already unrestricted. Name validation
        ; still checks every import node, whether or not it merged one.
        acc))
  })

; The names in `sub` the recorded filter does not already keep,
; intersected with the module's `pub` names: exactly the verdicts a
; repeat import may flip. A private name, or one the module never
; declared, never reaches `delta`, so it can never be exported here.
(pub :: repeatDelta (-> Strings Strings Strings Strings Int Strings))
(pub fn (repeatDelta old sub pubs delta i)
  (if (>= i (vecLen sub))
    delta
    {
      (let n (vecGetStr sub i))
      {
        (if (seenHasIn pubs n 0)
          (if (! (seenHasIn old n 0))
            (vecPush delta n)))
        (repeatDelta old sub pubs delta (+ i 1))
      }
    }))

; A fresh Vec holding `old` plus every name in `delta`: the recorded
; filter's widening. Fresh rather than pushed onto `old`, because
; `old` may BE the first import node's own list (`resolveDeclsPhase`
; records it unwidened) and widening must not rewrite that node.
(pub :: repeatUnion (-> Strings Strings Strings))
(pub fn (repeatUnion old delta)
  (repeatUnionIn old delta vecNew 0 0))

(pub :: repeatUnionIn (-> Strings Strings Strings Int Int Strings))
(pub fn (repeatUnionIn old delta acc i j)
  (if (>= i (vecLen old))
    (if (>= j (vecLen delta))
      acc
      {
        (vecPush acc (vecGetStr delta j))
        (repeatUnionIn old delta acc i (+ j 1))
      })
    {
      (vecPush acc (vecGetStr old i))
      (repeatUnionIn old delta acc (+ i 1) j)
    }))

; Flip the verdicts in `acc` for the module's declarations named in
; `delta`: word 5 goes from "left out" to "exported", and an `fn`
; records its bare name the way the first import's splice did
; (`mangleDecl`'s exported arm). First-writer-wins still holds -
; `mangleRecord` no-ops on a claimed bare slot, so the entry file
; keeps a name it defined itself. Every other declaration kind needs
; only the flip. Foreign items widen individually and acquire a bare
; mapping only when the module exports that item.
(pub :: repeatExportNew
  (-> (Vec ASTNode) String Strings MangleIdx Strings Strings Int (Vec ASTNode)))
(pub fn (repeatExportNew acc mod delta idx bares fulls i)
  (if (>= i (vecLen acc))
    acc
    {
      {
        (let d (vecGet acc i))
        (if (&& (!= (nodeModule d) 0) (strEq (nodeModuleName d) mod))
          (if (== (nodeTag d) TAG_D_EXTERN)
            {
              (repeatExportExtern (nodeCChildren d) delta 0)
              (if (== (externAnyVisible (nodeCChildren d) 0) 1)
                (writeNodeWord d 5 1))
              (mangleExternItems (nodeCChildren d) 0 idx bares fulls mod)
            }
            {
              (let bare (bareOf (nodeAName d)))
              (if (seenHasIn delta bare 0)
                (if (== (nodeVis d) 0)
                  {
                    (writeNodeWord d 5 1)
                    (if (== (nodeTag d) TAG_D_FN)
                      (mangleRecord idx bares fulls bare (nodeAName d)))
                  }))
            }))
      }
      (repeatExportNew acc mod delta idx bares fulls (+ i 1))
    }))

(:: cgFail (-> CG String String CG))
;@axiom:effect(io)
(fn (cgFail cg message name)
  {
    (dieCodegenDiag message name)
    cg
  })

; ------------------------------------------------------------------
; Targets.
;
; Everything per-target in one place, mirroring stage0's
; `axiom-codegen/src/target.rs` value for value: the triple, the
; syscall inline-assembly (register conventions differ per arch, and
; the BSD kernels - Darwin and FreeBSD - return a positive errno with
; the carry flag set where Linux returns -errno, so the BSD templates
; branch on carry and negate - `result < 0` is then a complete failure
; test on every target), the mmap/exit syscall numbers (Darwin's carry
; the 0x2000000 Unix class bit), the MAP_PRIVATE|MAP_ANON flag value,
; and the platform module suffixes. Codes: 0 darwin-aarch64,
; 1 darwin-x86_64, 2 linux-aarch64, 3 linux-x86_64, 4 freebsd-x86_64,
; 5 freebsd-aarch64, 6 windows-x86_64, 7 baremetal-aarch64,
; 8 windows-aarch64; -1 is "unknown", refused
; loudly. A code is an index into nothing, only a name for these
; chains of `if`; 4-6 were assigned across two concurrent branches so
; that both landed without renumbering the other, and 8 went to the
; second Windows architecture because 7 was taken by then.
;
; The two FreeBSD codes were added 2026-08-29 from a macOS host with
; no FreeBSD to run on. Every FreeBSD number below was read from
; stable/14's `sys/kern/syscalls.master` and headers rather than
; measured, and `stdlib/Sys/Platform.freebsd.ax` says the same of its
; own; the CI leg that executes them is what turns either into a fact.
;
; The two Windows targets are the ones in this block that are not "the
; same runtime with different numbers". There is no syscall ABI on
; Windows to put numbers in a table for, so where the others carry a
; syscall template and three syscall numbers they carry
; `targetUsesSyscallAsm` = 0, and the emitted runtime reaches the kernel
; through kernel32.dll instead - see `emitRuntimeMap`,
; `emitRuntimeWrite`, `emitRuntimeExit` and `emitWinEntry` below, which
; are the whole of that difference. Those four emit plain LLVM IR - no
; inline assembly, no calling-convention attribute - so windows-aarch64
; shares every one of them with windows-x86_64, and the two differ only
; where an architecture does: the triple, `targetIsAArch64`, and the
; platform-register clause of `targetRecoverArmAsm`.
; ------------------------------------------------------------------
(pub :: targetCode (-> String Int))
(pub fn (targetCode name)
  (if (strEq name "darwin-aarch64")
    0
    (if (strEq name "darwin-x86_64")
      1
      (if (strEq name "linux-aarch64")
        2
        (if (strEq name "linux-x86_64")
          3
          (if (strEq name "freebsd-x86_64")
            4
            (if (strEq name "freebsd-aarch64")
              5
              (if (strEq name "windows-x86_64")
                6
                (if (strEq name "baremetal-aarch64")
                  7
                  (if (strEq name "windows-aarch64")
                    8
                    (- 0 1)))))))))))

; Either Windows architecture. Every question below that is about the
; OPERATING SYSTEM - no syscall ABI, `mainCRTStartup`, the `.windows.ax`
; platform module - asks this, so the two codes cannot answer one of
; those questions differently by being forgotten in a chain of `if`.
(pub :: targetIsWindows (-> Int Bool))
(pub fn (targetIsWindows t)
  (|| (== t 6) (== t 8)))

(pub :: targetTriple (-> Int String))
(pub fn (targetTriple t)
  ; The MSVC triple, not `-gnu`: under `x86_64-pc-windows-gnu` LLVM
  ; emits references to `__main` and `___chkstk_ms`, both libgcc, which
  ; is a SECOND C runtime the freestanding gate would have to permit.
  ; Under MSVC the only compiler-runtime symbol that can appear is
  ; `__chkstk`, for a frame past 4 KiB, and the linker is `lld-link`,
  ; which ships beside the `llc` the driver already shells out to. No
  ; `target datalayout` line is emitted for it, as none is for the
  ; others: llc derives the layout from the triple.
  ;
  ; windows-aarch64 is the same choice on the other architecture, and
  ; what the triple hands to LLVM is the part of the arm64 Windows ABI
  ; this compiler never spells: x18 reserved as the TEB pointer (the
  ; register allocator never touches it), `__chkstk` for a frame past
  ; 4 KiB, and the `.pdata`/`.xdata` unwind records.
  (if (== t 6)
    "x86_64-pc-windows-msvc"
    (if (== t 8)
      "aarch64-pc-windows-msvc"
      (if (== t 0)
        "arm64-apple-macosx14.0.0"
        (if (== t 1)
          "x86_64-apple-macosx14.0.0"
          (if (== t 2)
            "aarch64-unknown-linux-gnu"
            (if (== t 3)
              "x86_64-unknown-linux-gnu"
              ; A major version is pinned, as `arm64-apple-macosx14.0.0`
              ; above pins one: an unversioned `x86_64-unknown-freebsd`
              ; lets LLVM choose per-release defaults that move under the
              ; committed seed. 14 is the pin; 12 is the floor the numbers
              ; need (`kevent` 560 with the 64-byte record, `getrandom`
              ; 563 and the current `struct dirent` are all 12+), and
              ; `Platform.freebsd.ax` records that beside each.
              (if (== t 4)
                "x86_64-unknown-freebsd14.0"
                (if (== t 7)
                  "aarch64-unknown-none-elf"
                  "aarch64-unknown-freebsd14.0")))))))))

; Does this target reach the kernel through an inline-asm syscall
; template? Every POSIX target does, and `targetSyscallAsm`,
; `targetMmapNum`, `targetExitNum`, `targetWriteNum` and
; `targetMapFlags` are consulted only where this answers 1. Windows has
; no syscall ABI a program may use - the numbers move between builds
; of one release and Microsoft documents none of them - so the emitted
; runtime goes through kernel32.dll instead: `VirtualAlloc` where the
; others `mmap`, `GetStdHandle`+`WriteFile` where they `write(2, ...)`,
; `ExitProcess` where they `exit_group`.
;
; A capability rather than an OS test, in the spirit of
; `Sys.Platform.openNeedsDirFd`; its standard-library twin is
; `Sys.Platform.usesSyscallAbi`, and `check-platform-constants.sh`
; holds the two answers to each other for every target.
(pub :: targetUsesSyscallAsm (-> Int Int))
(pub fn (targetUsesSyscallAsm t)
  (if (|| (targetIsWindows t) (== t 7))
    0
    1))

; The symbol the linker starts the program at. `main` wherever a C
; runtime calls it with argc and argv; `mainCRTStartup` on Windows,
; where the program is linked with no C runtime at all
; (`/entry:mainCRTStartup` - the name the MSVC CRT gives its own
; console startup, kept so a Windows reader recognises it) and the
; emitted entry shim reads the command line and the environment
; itself. The backtracer stops its walk at this name, so it is asked
; here rather than spelled in two places.
(pub :: targetEntryName (-> Int String))
(pub fn (targetEntryName t)
  (if (targetIsWindows t)
    "mainCRTStartup"
    "main"))

; The `"body", "constraints"` middle of a syscall call instruction,
; escaped and quoted ready to sit between `asm sideeffect ` and the
; argument list. One fragment per target, byte-for-byte the strings
; stage0 emits.
(pub :: targetSyscallAsm (-> Int String))
(pub fn (targetSyscallAsm t)
  ; The argument registers are CLOBBERS as well as inputs on arm64,
  ; because Darwin's `svc` destroys them - probed, x1 comes back 0.
  ; Without this LLVM keeps a value in an argument register across the
  ; syscall at -O1 and above, which set `@__axiom_bump_end` to
  ; `addr + 0` and made every allocation map a fresh megabyte. stage0
  ; carries the same clobbers and the same explanation.
  ;
  ; `~{cc}` is on every template for the same reason one register
  ; short of it already shipped a bug: the Darwin kernel answers
  ; through the CARRY FLAG (the templates' own `b.cc`/`jnc` read it),
  ; and with no flags clobber declared, a countdown loop with a
  ; syscall in its body compiled to an `adds` before the `svc` and
  ; its `b.lo` after - an infinite loop, measured 2026-08-07 at every
  ; opt level. Linux preserves the flags; the clobber is kept anyway,
  ; because an ABI assumption is exactly what failed here.
  ;
  ; linux-x86_64 also declares its argument registers clobbered now,
  ; matching stage0's STRING (stage0's comment claimed the narrow
  ; list while its string had been widened; the two compilers must
  ; match the string, because the string is what compiles).
  ;
  ; NO TEMPLATE on a target with no syscall ABI. Every emitter that
  ; writes one asks `targetUsesSyscallAsm` first and takes the kernel32
  ; door instead; an empty template reaching llc is a parse error,
  ; which is the loud failure wanted from a caller that forgot to ask.
  ; Asked as the OS, not as code 6: an arm64 Windows target that fell
  ; through this chain would land on freebsd-aarch64's `svc #0` string.
  (if (targetIsWindows t)
    ""
    (if (== t 0)
      "\"svc #0x80\\0Ab.cc 1f\\0Aneg x0, x0\\0A1:\", \"={x0},{x16},{x0},{x1},{x2},{x3},{x4},{x5},~{x1},~{x2},~{x3},~{x4},~{x5},~{x16},~{cc},~{memory}\""
      ; Darwin/x86-64 declares its argument registers clobbered, as
      ; Darwin/arm64 does and as Linux deliberately does not: Linux
      ; documents that it preserves everything but rax/rcx/r11, Darwin
      ; documents nothing and on arm64 demonstrably destroys them. `rdx`
      ; is Darwin's second return register, so the kernel writes it while
      ; `{dx}` is listed here as a live input.
      (if (== t 1)
        "\"syscall\\0Ajnc 1f\\0Anegq %rax\\0A1:\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rdi},~{rsi},~{rdx},~{r10},~{r8},~{r9},~{rcx},~{r11},~{cc},~{memory}\""
        (if (== t 2)
          "\"svc #0\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{x1},~{x2},~{x3},~{x4},~{x5},~{x8},~{cc},~{memory}\""
          (if (== t 3)
            "\"syscall\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rdi},~{rsi},~{rdx},~{r10},~{r8},~{r9},~{rcx},~{r11},~{cc},~{memory}\""
            ; FreeBSD is BSD on both architectures: the kernel answers
            ; through the carry flag with a positive errno, as Darwin
            ; does, so both of its templates carry the branch-and-negate
            ; epilogue that keeps `Sys.ax`'s `result < 0` contract. On
            ; x86-64 that makes the template darwin-x86_64's BYTE FOR
            ; BYTE - same registers, same instruction, same epilogue.
            ; The two targets' modules still differ, because the triple
            ; and the numbers do (mmap 477 against 33554629, write 4
            ; against 33554436, exit 1 against 33554433), and
            ; `check-self-host.sh`'s pairwise-distinctness rule now rests
            ; on THAT rather than on the syscall string; a later
            ; "simplification" that merged the triples or the numbers
            ; would collapse two targets into one module and that gate
            ; would report the target argument being ignored.
            (if (== t 4)
              "\"syscall\\0Ajnc 1f\\0Anegq %rax\\0A1:\", \"={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rdi},~{rsi},~{rdx},~{r10},~{r8},~{r9},~{rcx},~{r11},~{cc},~{memory}\""
              ; freebsd-aarch64 is the one genuinely new string: the
              ; Linux register set - the number in x8, `svc #0` - under
              ; Darwin's epilogue. Neither existing template can serve
              ; it: the Linux one reads a -errno the kernel never
              ; produces, and the Darwin one puts the number in x16,
              ; which FreeBSD does not read.
              (if (== t 7)
                ""
                "\"svc #0\\0Ab.cc 1f\\0Aneg x0, x0\\0A1:\", \"={x0},{x8},{x0},{x1},{x2},{x3},{x4},{x5},~{x1},~{x2},~{x3},~{x4},~{x5},~{x8},~{cc},~{memory}\""))))))))

; Whether a target code is an AArch64 one. The frame read, the
; recovery arm and the recovery jump are architecture questions, and
; each spelled the membership for itself - `(|| (== t 0) (== t 2))` -
; so a new AArch64 target had three places to be forgotten in. It is
; stated once.
(pub :: targetIsAArch64 (-> Int Bool))
(pub fn (targetIsAArch64 t)
  (|| (== t 0) (|| (== t 2) (|| (== t 5) (|| (== t 7) (== t 8))))))

; Read the frame pointer. One instruction, and only two distinct
; strings for every target, because this is an architecture question
; rather than an OS one: AArch64 keeps it in x29 and x86-64 in %rbp on
; Darwin, Linux, FreeBSD and Windows alike - Win64 establishes rbp the
; same way when `"frame-pointer"="all"` forces one, and the arm64
; Windows ABI keeps the AAPCS64 frame record `[x29, x30]` chain.
;
; `sideeffect` so the read is neither duplicated nor hoisted. It has no
; clobbers to declare - unlike `targetSyscallAsm` above, whose comment
; records what one missing clobber cost - because it writes one output
; register and touches nothing else.
;
; This is only meaningful because `attributes #0` carries
; `"frame-pointer"="all"`. Measured 2026-08-24 without it, on the
; prologue of a non-leaf function at `llc -O2`: linux-aarch64 saved x30
; alone and never wrote x29, and both x86_64 targets pushed a scratch
; register in place of %rbp - so this would have read a general-purpose
; register holding an unrelated value. Only darwin-aarch64, whose ABI
; requires the frame pointer, was correct by accident.
(pub :: targetFrameAsm (-> Int String))
(pub fn (targetFrameAsm t)
  (if (targetIsAArch64 t)
    "\"mov $0, x29\", \"=r\""
    "\"movq %rbp, $0\", \"=r\""))

; The Win64 arm block: `targetRecoverArmAsm` says why it saves more
; than the SysV one. `xmmOff` is the byte offset of the xmm6-xmm15 area
; in the record, twenty words the arm site adds past the spawn sequence.
(:: win64RecoverArmAsm (-> Int String))
(fn (win64RecoverArmAsm xmmOff)
  (concat
    (concat
      "\"movq %rbx, 48($0)\\0Amovq %r12, 56($0)\\0Amovq %r13, 64($0)\\0Amovq %r14, 72($0)\\0Amovq %r15, 80($0)\\0Amovq %rdi, 88($0)\\0Amovq %rsi, 96($0)\\0A"
      (win64XmmMoves xmmOff 6 true))
    (concat
      "movq %rsp, ($0)\\0Amovq %rbp, 8($0)\\0Aleaq 1f(%rip), %rax\\0Amovq %rax, 16($0)\\0Ajmp 2f\\0A1:\\0Amovq 48(%rax), %rbx\\0Amovq 56(%rax), %r12\\0Amovq 64(%rax), %r13\\0Amovq 72(%rax), %r14\\0Amovq 80(%rax), %r15\\0Amovq 88(%rax), %rdi\\0Amovq 96(%rax), %rsi\\0A"
      (concat (win64XmmMoves xmmOff 6 false)
        "2:\", \"r,~{rax},~{rcx},~{rdx},~{r8},~{r9},~{r10},~{r11},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{memory},~{cc}\""))))

; `movups %xmmN, off($0)` for xmm6 to xmm15 when `saving`, sixteen bytes
; apart from `off`; the landing's `movups off(%rax), %xmmN` otherwise.
(:: win64XmmMoves (-> Int Int Bool String))
(fn (win64XmmMoves off first saving)
  {
    (let b strBuilderNew)
    {
      (for n in first..16
        {
          (let at (+ off (* 16 (- n first))))
          (strBuilderPush b
            (if saving
              (concat "movups %xmm"
                (concat (fmtInt n) (concat ", " (concat (fmtInt at) "($0)\\0A"))))
              (concat "movups "
                (concat (fmtInt at) (concat "(%rax), %xmm" (concat (fmtInt n) "\\0A"))))))
        })
      (strBuilderFinish b)
    }
  })

; The setjmp half of `__axiom_recover`, per architecture, in the shape
; `targetSyscallAsm` uses: the `"body", "constraints"` middle of an
; `asm sideeffect` call, escaped and ready to sit between it and the
; argument list.
;
; WHAT THE BLOCK DOES. It saves the stack pointer, the frame pointer
; and the address of its OWN label `1:` into the record `$0` points
; at, then jumps over that label. `__axiom_recover_abort` restores sp
; and the frame pointer and branches to the saved address, which lands
; INSIDE this block at `1:`, and control then falls out of the bottom
; on both paths. Every instruction the emitter writes after the block
; therefore runs twice - once on the way in and once on the way back -
; which is the whole trick, and the reason the status is passed in the
; record rather than in an output register: an output would have to be
; a register LLVM allocated, and every register that could hold one is
; either clobbered here or restored below.
;
; WHY THE CLOBBER LIST IS NOT THE WHOLE ARGUMENT. A block like this is
; sound exactly when it behaves like a CALL - caller-saved registers
; destroyed, callee-saved registers preserved - because that is the
; discipline the register allocator already reasons about. So the
; caller-saved half is declared (x0-x17 and every vector register on
; AArch64; the SysV scratch set and xmm0-15 on x86-64) and the
; callee-saved half is SAVED AND RESTORED by the block itself, into
; words 6..15 of the record. Nothing is left for a value to hide in.
;
; Both halves were measured, on a hand-written LLVM prototype of this
; block, on a function holding five values across the arm and aborting
; from 200 frames down, at all four optimisation levels. With the
; save/restore pair deleted and the clobber list untouched:
;
;     === -O0 ===   28   (correct)
;     === -O1 ===   Segmentation fault: 11
;     === -O2 ===   Segmentation fault: 11
;     === -O3 ===   Segmentation fault: 11
;
; identically on darwin-aarch64 and on darwin-x86_64 under Rosetta.
; The -O0 column is why a gate that built at one level would have
; shipped it: at -O0 nothing lives in a register across anything.
;
; The frame pointer is restored rather than clobbered because it
; cannot be clobbered - `"frame-pointer"="all"` makes it a reserved
; register, and LLVM refuses a reserved name in a clobber list. `x30`
; is spelled `lr` for the reason this file's syscall templates record
; about `~{cc}`: LLVM silently IGNORES an unrecognised AArch64 clobber
; name, and `~{x30}` is one - measured, with `_top@PAGE` parked in x30
; across the block and a SIGSEGV at every level above -O0.
(pub :: targetRecoverArmAsm (-> Int Int String))
(pub fn (targetRecoverArmAsm t xmmOff)
  (if (targetIsAArch64 t)
    ; ONE BODY, TWO CLOBBER LISTS, and the difference is a single
    ; register whose ABI role is not the same across the AArch64
    ; targets. `x18` is the PLATFORM REGISTER: reserved on Darwin, where
    ; LLVM never allocates it and naming it in a clobber list is a false
    ; statement llc warns about ("clobber list contains reserved
    ; registers: X18"), and an ordinary allocatable caller-saved
    ; temporary on Linux AND ON FREEBSD. LLVM reserves x18 for Darwin,
    ; Android, Fuchsia, Windows and OHOS, and `aarch64-unknown-freebsd`
    ; is in none of those - so freebsd-aarch64 takes the Linux list
    ; below, and `check-recover.sh` asks llc whether the register is
    ; reserved under each triple rather than trusting this sentence.
    ;
    ; The invariant this list keeps is "the clobber half IS the
    ; caller-saved set", so a register that is caller-saved on one
    ; target and reserved on the other has to be named on one and not
    ; the other - exactly as `targetSyscallAsm` above names x16 for
    ; Darwin and x8 for Linux rather than pretending one string serves
    ; both.
    ;
    ; THE REGISTER FILE IS NOW ACCOUNTED FOR EXHAUSTIVELY, which is the
    ; check that would have caught this by reading. On AArch64: x0-x17
    ; and lr clobbered, x18 clobbered where it is allocatable, x19-x28
    ; saved and restored by the block, x29 and sp restored explicitly,
    ; v0-v31 clobbered. On x86-64: rax/rcx/rdx/rsi/rdi/r8-r11 and
    ; xmm0-15 clobbered, rbx/r12-r15 saved and restored, rbp and rsp
    ; restored explicitly. Every register is in exactly one of those
    ; three sets, on every target. A register in NONE of them is a
    ; register a value can hide in across the block, which is what this
    ; was.
    ;
    ; MEASURED, and it is the same defect as the `~{x30}`-vs-`~{lr}`
    ; one this file already records, one register over. With x18 in
    ; neither the clobber half nor the block's own save/restore half,
    ; LLVM on linux-aarch64 PREFERS it for the record pointer -
    ; precisely because the block does not clobber it, so it needs no
    ; prologue spill. Through the driver's real pipeline
    ; (`emit-llvm | opt -O1 | llc -O1 -relocation-model=pic`) on
    ; `tests/stdlib/402-recover-oom.ax`:
    ;
    ;     stp x19, x20, [x18, #48]      <- $0 is x18
    ;     ...
    ;     ldr x19, [x18, #40]           <- the status, read through it
    ;
    ; The landing path restores x19-x28 and nothing else, and the
    ; aborted extent runs through `axiom_alloc`, which uses x18 itself
    ; (`mov x18, x0`, `adrp x18, __axiom_chunk`). So the status was read
    ; through a pointer the trap had destroyed. `402-recover-oom`
    ; produced NO stderr on ubuntu-24.04-arm in CI runs 32811091535 and
    ; 32811530545 while passing on linux-x86_64 and darwin-aarch64 -
    ; the signature of a register that exists only on AArch64 and is
    ; allocatable only off Darwin. With `~{x18}` the pointer moves to
    ; x20, which the block already saves and restores. The predicate
    ; below is "AArch64 and x18 allocatable", which today is
    ; linux-aarch64, freebsd-aarch64 and baremetal-aarch64 - LLVM
    ; reserves x18 on Darwin, Android, Fuchsia, Windows and OHOS, and
    ; `aarch64-unknown-none-elf` is in none of those either; a `(== t 2)`
    ; here would ship
    ; freebsd-aarch64 with exactly this bug, silently. windows-aarch64
    ; takes Darwin's list: x18 is reserved as the TEB pointer there, so
    ; no value can live in it and nothing in the block writes it.
    (concat
      "\"stp x19, x20, [$0, #48]\\0Astp x21, x22, [$0, #64]\\0Astp x23, x24, [$0, #80]\\0Astp x25, x26, [$0, #96]\\0Astp x27, x28, [$0, #112]\\0Amov x9, sp\\0Astr x9, [$0]\\0Astr x29, [$0, #8]\\0Aadr x9, 1f\\0Astr x9, [$0, #16]\\0Ab 2f\\0A1:\\0Aldp x19, x20, [x9, #48]\\0Aldp x21, x22, [x9, #64]\\0Aldp x23, x24, [x9, #80]\\0Aldp x25, x26, [x9, #96]\\0Aldp x27, x28, [x9, #112]\\0A2:\", \"r,~{x0},~{x1},~{x2},~{x3},~{x4},~{x5},~{x6},~{x7},~{x8},~{x9},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{lr}"
      (concat
        (if (|| (== t 2) (|| (== t 5) (== t 7)))
          ",~{x18}"
          "")
        ",~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v8},~{v9},~{v10},~{v11},~{v12},~{v13},~{v14},~{v15},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31},~{memory},~{cc}\""))
    (if (== t 6)
      (win64RecoverArmAsm xmmOff)
      "\"movq %rbx, 48($0)\\0Amovq %r12, 56($0)\\0Amovq %r13, 64($0)\\0Amovq %r14, 72($0)\\0Amovq %r15, 80($0)\\0Amovq %rsp, ($0)\\0Amovq %rbp, 8($0)\\0Aleaq 1f(%rip), %rax\\0Amovq %rax, 16($0)\\0Ajmp 2f\\0A1:\\0Amovq 48(%rax), %rbx\\0Amovq 56(%rax), %r12\\0Amovq 64(%rax), %r13\\0Amovq 72(%rax), %r14\\0Amovq 80(%rax), %r15\\0A2:\", \"r,~{rax},~{rcx},~{rdx},~{rsi},~{rdi},~{r8},~{r9},~{r10},~{r11},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{memory},~{cc}\"")))

; TWO x86-64 ARMS. SysV (linux, freebsd) and Win64 (windows) share the
; register file and not the callee-saved set: Win64's is rbx, rbp, rdi,
; rsi, r12-r15 AND xmm6-xmm15. The landing has to put back EVERY
; register the ABI lets a function keep across a call, because the
; abandoned callees' epilogues never run: the arming function's caller
; may hold a value in rdi, rsi or xmm6 across its call; the trapping
; callee may have saved and used that register; after the jump the
; arming function returns to its caller with the callee's value still
; in it. Declaring such a register clobbered at the block protects the
; arming function's own values and nothing above it. The first Windows
; arm did exactly that, and `tests/stdlib/560-recover-record.ax`, whose
; `nested` arms a point inside a thunk, faulted on the Windows runner
; (run 39414173001) where the flat cases passed. So the Win64 block
; keeps rdi and rsi at 88 and 96, two words the x86-64 layout left
; empty, and xmm6-xmm15 in twenty words past the spawn sequence, at the
; byte offset the arm site passes as `xmmOff`, through `movups` because
; that offset is a multiple of 8 and not always of 16; and its clobber
; half is exactly the caller-saved set, rax, rcx, rdx, r8-r11 and
; xmm0-xmm5. What is NOT the same on Windows is the stack: it is
; committed lazily behind a guard page, and restoring rsp to a
; SHALLOWER address - which is all `targetRecoverJumpAsm` ever does -
; is safe; the hazard would be the reverse, and the mechanism never
; goes deeper. Stated here so the day someone adds a deeper restore
; they find the sentence.
;
; The longjmp half. `$0` is the record (landing in the scratch register
; the block above reads its restores through), `$1` the saved stack
; pointer, `$2` the saved frame pointer, `$3` the address to branch to.
; No `~{cc}`, and deliberately: this is not a syscall template, sets no
; flags, and `check-cross-targets.sh` tells the two apart by the
; instruction - `svc`, `syscall` - rather than by the mechanism.
(pub :: targetRecoverJumpAsm (-> Int String))
(pub fn (targetRecoverJumpAsm t)
  (if (targetIsAArch64 t)
    "\"mov x9, $0\\0Amov sp, $1\\0Amov x29, $2\\0Abr $3\", \"r,r,r,r,~{x9},~{memory}\""
    "\"movq $0, %rax\\0Amovq $1, %rsp\\0Amovq $2, %rbp\\0Ajmpq *$3\", \"r,r,r,r,~{rax},~{memory}\""))

; The three syscall numbers below and `targetMapFlags` are read only
; where `targetUsesSyscallAsm` answers 1; windows-x86_64 (6) and
; windows-aarch64 (8) fall through their chains to an answer they
; never spend.
(pub :: targetMmapNum (-> Int Int))
(pub fn (targetMmapNum t)
  (if (== t 0)
    33554629
    (if (== t 1)
      33554629
      (if (== t 2)
        222
        (if (== t 3)
          9
          ; FreeBSD's `mmap` is 477 on every architecture - its table
          ; is generated once from `syscalls.master` - and NOT 197,
          ; which is `freebsd6_mmap`, a COMPAT6 entry with a padded
          ; argument list that assembles, runs, and reads its
          ; arguments from the wrong registers.
          477)))))

; The number the emitted abort paths - allocator OOM, arena OOM, and an
; unhandled effect - exit through. It must be the one `Sys.Platform`
; picks, and on Linux it was not: this returned 93 and 60, which are
; `exit`, while `Platform.linux-aarch64.ax` returns 94 and
; `Platform.linux-x86_64.ax` returns 231, which are `exit_group`. The
; aarch64 module states the rule in as many words - "exit_group (94),
; not exit (93)" - and the compiler emitted 93 anyway, so the two
; implementations of "how this platform exits" disagreed with each
; other while agreeing on darwin, where 33554433 is the only spelling.
;
; Latent rather than live: `exit` ends the calling thread, and nothing
; Axiom emits has a second one, so the process dies either way. It stops
; being latent the moment one of these programs has two threads, and
; the failure then is a process that aborts and stays alive.
(pub :: targetExitNum (-> Int Int))
(pub fn (targetExitNum t)
  (if (== t 0)
    33554433
    (if (== t 1)
      33554433
      (if (== t 2)
        94
        (if (== t 3)
          231
          ; FreeBSD's `exit` (1) ends the PROCESS: there is no
          ; `exit_group`, and the thread-only call is `thr_exit`
          ; (431). So 1 keeps the property the Linux arms above were
          ; corrected for, and `Platform.freebsd.ax` carries the same
          ; 1 for `check-platform-constants.sh` to compare.
          1)))))

; `write`, per target, for the runtime traps. Darwin BSD 4 is
; 0x2000004; linux-x86_64 is 1 and linux-aarch64 is 64; FreeBSD is
; the bare BSD 4 on both architectures, with no class bit.
(pub :: targetWriteNum (-> Int Int))
(pub fn (targetWriteNum t)
  (if (== t 0)
    33554436
    (if (== t 1)
      33554436
      (if (== t 2)
        64
        (if (== t 3)
          1
          4)))))

; MAP_PRIVATE|MAP_ANON. The value is the kernel family's, not the
; architecture's: MAP_ANON is 0x1000 on both BSDs and 0x20 on Linux,
; so Darwin and FreeBSD share 4098 and the two Linux targets share 34.
(pub :: targetMapFlags (-> Int Int))
(pub fn (targetMapFlags t)
  (if (|| (== t 0) (|| (== t 1) (|| (== t 4) (== t 5))))
    4098
    34))

; ------------------------------------------------------------------
; THE ARENA'S SIZE AND ITS SOURCE OF PAGES, per target.
; docs/embedded-guide.md §§1–2.
;
; Until 2026-09-04 the chunk size was the literal `1048576` written
; twice into `emitAllocator`'s `refill:` block, and `mmap` was the only
; way a chunk could ever arrive. Both are assumptions about a hosted
; operating system, and both are wrong on a part with 256 KiB of SRAM
; and no MMU: the FIRST allocation asks the kernel for a megabyte, and
; there is no kernel.
;
; WHY THESE LIVE HERE AND NOT IN `Host.<target>.ax`, which is where
; the proposal put them. `Host.<target>.ax` answers `hostTarget` - the
; target this COMPILER BINARY was itself compiled for, selected by
; module resolution when the compiler is built, and used only as the
; default when no `--target` is given. It is not the target a program
; is being compiled FOR. Putting `arenaChunkBytes` there would give a
; darwin-hosted compiler cross-compiling to a bare-metal part darwin's
; megabyte, silently, which is the exact failure 4.1 exists to remove.
; The syscall numbers are keyed by the target CODE for the same reason
; ("the way the syscall numbers already are" is what 4.1 asked for, and
; this is where they are).
;
; Every supported target answers 1 MiB, and the emitted bytes are
; therefore what they have always been - asserted per target by
; `scripts/check-embedded.sh`, which also drills the other direction:
; give ONE target a different chunk and the only lines of its IR that
; move are the four in `refill:` and the one in the keep helper that
; carry the value, while the targets it did not name do not move a
; byte.
;
; A bare-metal target's row is `(if (== t <its code>) 4096 1048576)`.
; That edit is the whole of 4.1, and it is literally the edit the gate
; makes.
(pub :: targetArenaChunkBytes (-> Int Int))
(pub fn (targetArenaChunkBytes t)
  (if (== t 7)
    4096
    1048576))

; What a request LARGER than one chunk is rounded up to. The refill
; path serves an oversized request with a chunk of its own, rounded to
; this; 64 KiB is what every hosted target has always used and is a
; page multiple everywhere.
;
; It is DERIVED rather than a second row, because the two are not
; independent: a 4 KiB-chunk target that rounded a 5 KiB request to
; 64 KiB would ask for sixteen chunks' worth to serve one, and against
; a 32 KiB static region that is an out-of-memory trap for a request
; the arena has room for. So the grain is the chunk where the chunk is
; the smaller. Both are powers of two, which is what the `and` mask
; below needs.
(pub :: targetArenaGrainBytes (-> Int Int))
(pub fn (targetArenaGrainBytes t)
  (if (< (targetArenaChunkBytes t) 65536)
    (targetArenaChunkBytes t)
    65536))

; 4.2, THE SECOND BACKING STRATEGY. Zero means `mmap` (or, on Windows,
; `VirtualAlloc`): the arena asks the operating system for each chunk,
; which is what every supported target does and will keep doing.
; Non-zero is the STATIC strategy - a single region of exactly this
; many bytes, reserved once at link time, out of which `emitRuntimeMap`
; carves chunks with a cursor. There is no third state and no runtime
; test: `emitRuntimeMap` reads this at EMISSION time, so the emitted
; program contains exactly one of the two and the other costs it
; nothing, not even a branch.
;
; The failure path is unchanged and that is the point of the shape.
; `emitArenaCarve` answers 0 when the region is exhausted, which is
; below the `%failed_low = icmp ult i64 %addr, 4096` that already
; catches a failed `mmap`, so exhaustion reaches `__axiom_out_of_memory`
; and traps with status 70 exactly as it does on a host.
;
; ONE OTHER SITE MAPS, AND IT IS DELIBERATELY NOT CONVERTED. The
; concurrency lowering asks for a 4 KiB MAP_SHARED page per binding
; (`parSys`, above `emitParSpawn`), which is how a forked child hands
; its result back. A statically reserved region cannot stand in for it:
; the whole property wanted there is that the page survives `fork` and
; is visible in BOTH processes, and a `.bss` array is copied. So a
; program that spells `parallel` still names `mmap` on a static target.
; That is not a hole this item can close - it is
; docs/embedded-guide.md §1's "threads are out of scope",
; which a bare-metal port will have to answer for processes as well,
; the way windows-x86_64 already does by compiling both primitives to a
; trap. `targetHasThreads` below refuses the THREAD half here because
; that half is about the allocator's globals and is this item's
; business; the process half is not.
(pub :: targetArenaStaticBytes (-> Int Int))
(pub fn (targetArenaStaticBytes t)
  (if (== t 7)
    32768
    0))

; Where that region begins, and it means two different things by
; design. ZERO: the emitter reserves the region as a zero-initialised
; global and the LINKER chooses the address - which is what a part with
; a normal `.bss` wants, and what makes the region's base "fixed at
; link time" without a linker script naming an address. NON-ZERO: an
; absolute address, for a board whose SRAM window the target knows
; (`0x20000000` on a Cortex-M, say) and which no `.bss` covers. Read
; only where `targetArenaStaticBytes` is non-zero.
;
; AN ABSOLUTE BASE MUST ITSELF BE 16-BYTE ALIGNED, and nothing can
; check that for the target author: the reserved-global case gets
; `align 16` from the emitter and the linker honours it, while an
; address a board hands over is whatever the board says. Every chunk
; carved out of the region inherits the base's alignment, and
; MM-ALLOC-3 is what spends it - so an odd base is a misaligned heap,
; not a misaligned first block. Stated here because it is the one thing
; about this row a reader cannot derive from the emitted text.
(pub :: targetArenaStaticBase (-> Int Int))
(pub fn (targetArenaStaticBase t)
  0)

; 4.3, THE TRAP'S WRITE STRATEGY. Zero means today's `write(2, ...)`
; (or `WriteFile` on the handle `GetStdHandle(-12)` answers, where
; there is no syscall ABI): every trap reports its sentence before it
; exits, which is what every supported target does and will keep
; doing. Non-zero is the SILENT strategy - no write at all, while the
; recovery abort, the backtrace walk and the exit with the trap's own
; status all still run. That is the proposal's no-op door: on a part
; with a UART the board supplies its own writer instead, and where
; there is nothing to write to the status codes are the whole report -
; `tests/stdlib/465-pop-empty-trap.exit` and its siblings pin them,
; and they are the only thing an automated test on-device can observe.
;
; Read at EMISSION time, like 4.2's strategy, so a silent program
; contains no write and no branch for one. `emitRuntimeWrite` is the
; single reader - the backtrace writer delegates to it - so every trap
; moves together and none can be half-silent.
;
; A bare-metal target's row would be `(if (== t <its code>) 1 0)` -
; that edit is the whole of 4.3, and it is literally the edit the gate
; makes - but the reference port does not take it: a part with a UART
; reports its traps through `targetUartBase` below instead, and silence
; stays the row of no target. The statuses are the whole report only
; where there is nothing to write to.
(pub :: targetTrapSilent (-> Int Int))
(pub fn (targetTrapSilent t)
  0)

; 4.3's SECOND door: the trap's write strategy where silence is not the
; answer and there is no fd 2. Zero means "no UART", which is every
; hosted target; non-zero is the PL011 data register's physical
; address, and `emitRuntimeWrite` calls `@__axiom_uart_write` - emitted
; once by `emitBaremetalRuntime`, volatile stores, one byte per store -
; instead of writing fd 2. 150994944 is 0x09000000, the `virt`
; machine's UART0; QEMU drains it to stdio faster than a trap writes,
; so no flag wait is emitted - a real board's wait belongs in the
; helper beside the store, not at the call sites. Read at EMISSION
; time, like the silent row: a UART program carries the call and no
; branch, and a hosted program carries neither.
(pub :: targetUartBase (-> Int Int))
(pub fn (targetUartBase t)
  (if (== t 7)
    150994944
    0))

; The EFFECTIVE static-arena size: the build's ceiling when one was
; given, else the target table's row. One reader, so the table keeps
; the single spelling of the default (4.1's rule, held by A2) and the
; flag keeps the single spelling of the override. Every site that used
; to ask the table asks here instead - including `targetHasThreads`,
; which is what refuses `--threads` on a ceiling build as AX4006 with
; no new diagnostic: a carved region has one cursor wherever it lives.
(pub :: arenaStaticBytes (-> Int Int))
;@axiom:effect(io)
(pub fn (arenaStaticBytes t)
  {
    (let c (heapCeilingBytes))
    (if (> c 0)
      c
      (targetArenaStaticBytes t))
  })

; The EFFECTIVE chunk: under a ceiling it is capped by the region,
; because a growth unit larger than the region can never fit - the
; first carve would trap a program that fits. The cap keeps the
; accounting exact: below one chunk the first carve takes the whole
; region and every later request bumps inside it or traps past it;
; at or above it the chunks are the table's and each is checked in
; turn. The grain is deliberately NOT capped: it only rounds a request
; that already exceeds the chunk, and such a request exceeds a small
; ceiling on its own, so capping it would change nothing it decides.
(pub :: arenaChunkBytes (-> Int Int))
;@axiom:effect(io)
(pub fn (arenaChunkBytes t)
  {
    (let c (heapCeilingBytes))
    (if (> c 0)
      (if (< c (targetArenaChunkBytes t))
        c
        (targetArenaChunkBytes t))
      (targetArenaChunkBytes t))
  })

; Platform module suffixes, most specific first: `.{os}-{arch}.ax`,
; then `.{os}.ax`, then `.ax` - the same order stage0 searches.
(pub :: targetOsArchSuffix (-> Int String))
(pub fn (targetOsArchSuffix t)
  (if (== t 6)
    ".windows-x86_64.ax"
    (if (== t 8)
      ".windows-aarch64.ax"
      (if (== t 0)
        ".darwin-aarch64.ax"
        (if (== t 1)
          ".darwin-x86_64.ax"
          (if (== t 2)
            ".linux-aarch64.ax"
            (if (== t 3)
              ".linux-x86_64.ax"
              ; No `Platform.freebsd-*.ax` exists, and that is correct:
              ; FreeBSD's syscall table is generated once for every
              ; architecture, so the ladder falls through to
              ; `.freebsd.ax`, the arrangement Darwin already has.
              (if (== t 4)
                ".freebsd-x86_64.ax"
                (if (== t 7)
                  ".baremetal-aarch64.ax"
                  ".freebsd-aarch64.ax")))))))))

; `.windows.ax` and not `.windows-x86_64.ax` for the platform module,
; for the reason `Platform.darwin.ax` serves both Darwin targets: the
; module is a set of kernel32 bindings and those are the same on
; windows-aarch64, so the second Windows architecture is a triple and
; a recover-block clobber list, not a second platform module. Both
; codes resolve `Sys/Platform.windows.ax` here.
(pub :: targetOsSuffix (-> Int String))
(pub fn (targetOsSuffix t)
  (if (targetIsWindows t)
    ".windows.ax"
    (if (|| (== t 0) (== t 1))
      ".darwin.ax"
      (if (|| (== t 4) (== t 5))
        ".freebsd.ax"
        (if (== t 7)
          ".baremetal.ax"
          ".linux.ax")))))

; ------------------------------------------------------------------
; The three things the emitted runtime asks the kernel for - a mapping,
; a write to fd 2, an exit - behind one door each, so that the ten
; sites which used to spell a syscall template by hand call a function
; instead, and the one OS whose kernel has no syscall ABI lives in
; exactly three places.
;
; ON A SYSCALL TARGET EACH DOOR EMITS THE BYTES ITS SITE ALWAYS DID.
; That is a hard constraint, not tidiness: `check-seed-provenance.sh`
; regenerates the four POSIX seeds from source and byte-compares them,
; and `bootstrap-from-seed.sh`'s ladder compares stage2 against stage3
; the same way. Nothing on the POSIX path may move a byte, so the
; strings below are the old sites' strings reassembled, and the
; measurement that they are is a byte-compare of a stdlib case emitted
; before and after (recorded in the commit that introduced them).
;
; ON WINDOWS each is a kernel32 call. `VirtualAlloc(NULL, size,
; MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE)` answers NULL on failure,
; which `emitAllocator`'s existing `%failed_low = icmp ult %addr, 4096`
; already catches, so the control flow under `map:` is untouched; the
; pages arrive zeroed, which the `%virgin_high` path assumes of `mmap`.
; The write is `WriteFile(GetStdHandle(STD_ERROR_HANDLE), ptr, len,
; &written, NULL)`: `lpNumberOfBytesWritten` may be NULL only when
; `lpOverlapped` is NOT NULL (the design note had that backwards), so a
; real DWORD cell, `@__axiom_win_written`, is passed on every call. The
; exit is `ExitProcess`, which ends every thread - the analogue of
; `exit_group`, and the distinction `targetExitNum`'s comment records
; getting wrong once on Linux.
;
; Every kernel32 declare is `dllimport`, so the call goes through the
; import address table directly and the name is visible in the IR text
; - which is what lets `check-freestanding.sh` read the import surface
; before anything links. Every one carries `#0`, for the reason
; `emitExternDeclares` gives: without it `opt` may reason about a
; declared name as a libc function it knows.
; ------------------------------------------------------------------
; THE STATIC STRATEGY'S SOURCE OF PAGES (4.2), and the whole of it.
; Ten instructions, no branch and no call: a cursor through one
; reserved region, bumped by whatever `emitRuntimeMap`'s caller asked
; for. It is straight-line on purpose - the two call sites read `%addr`
; and then branch on `%failed_low`/`%failed_neg` themselves, so a door
; that introduced a basic block would rewrite control flow that
; MM-ALLOC-14's overlap rules and the reset protocol both stand on.
;
; ANSWERS 0 ON EXHAUSTION, which is what makes the failure path free:
; 0 is below 4096, `%failed_low` catches it, and the caller reaches
; `__axiom_out_of_memory` and exits 70 - the same trap, with the same
; status, that a refused `mmap` reaches on a host.
;
; The wrap test is not decoration. `%ar_next` is `cursor + size` in
; 64-bit wrapping arithmetic, and a request near 2^64 would land BELOW
; the cursor and compare `ule` against the end - handing back a pointer
; inside the region for an allocation that does not fit in the address
; space. The kernel refuses that request on a hosted target; here
; nothing would.
;
; The registers are `%ar_`-prefixed because this is inlined into two
; different functions - `@axiom_alloc` and the arena-keep helper - each
; of which already names a `%cur`, a `%next` and an `%end` of its own.
(pub :: emitArenaCarve (-> CG String CG))
(pub fn (emitArenaCarve cg sizeExpr)
  {
    (emitLine cg "  %ar_cur = load i64, ptr @__axiom_arena_cursor")
    (emitLine cg (concat "  %ar_next = add i64 %ar_cur, " (concat sizeExpr "")))
    (emitLine cg "  %ar_end = load i64, ptr @__axiom_arena_end")
    (emitLine cg "  %ar_room = icmp ule i64 %ar_next, %ar_end")
    (emitLine cg "  %ar_wrap = icmp ult i64 %ar_next, %ar_cur")
    (emitLine cg "  %ar_ok = xor i1 %ar_wrap, true")
    (emitLine cg "  %ar_fit = and i1 %ar_room, %ar_ok")
    (emitLine cg "  %ar_keep = select i1 %ar_fit, i64 %ar_next, i64 %ar_cur")
    (emitLine cg "  store i64 %ar_keep, ptr @__axiom_arena_cursor")
    (emitLine cg "  %addr = select i1 %ar_fit, i64 %ar_cur, i64 0")
  })

; The region itself, emitted once by `emitAllocator` and only on a
; static target. `internal`, so it is the program's own bytes and no
; linker script has to know its name; `align 16`, because MM-ALLOC-3's
; alignment is the arena's promise and every chunk carved out of this
; inherits the base's.
;
; NOT `cgMutGlobal`: the cursor is deliberately not thread-local. A
; static target answers 0 to `targetHasThreads`, so `--threads` on one
; is refused as AX4006 before any of this is written - see the comment
; there.
;
; A fresh carve is memory NOTHING HAS EVER BEEN HANDED, which is the
; invariant `mapped:` spends when it sets `%virgin_high` and the reason
; MM-ALLOC-6's zeroing promise survives the change: `.bss` arrives
; zeroed exactly as `mmap`'s pages do, the cursor never rewinds (a
; reset moves chunks to `@__axiom_free`, it does not give bytes back to
; the region), so no byte is carved twice.
(pub :: emitArenaRegion (-> CG CG))
;@axiom:effect(io)
(pub fn (emitArenaRegion cg)
  {
    (let n (arenaStaticBytes (cgTarget cg)))
    (let b (targetArenaStaticBase (cgTarget cg)))
    {
      (if (== b 0)
        {
          (emitLine cg
            (concat "@__axiom_arena = internal global ["
              (concat (fmtInt n) " x i8] zeroinitializer, align 16")))
          (emitLine cg
            "@__axiom_arena_cursor = internal global i64 ptrtoint (ptr @__axiom_arena to i64)")
          ; A one-past-the-end `getelementptr` constant, and not
          ; `add (i64 ptrtoint ..., i64 N)`: LLVM removed the
          ; arithmetic constant expressions and kept this one.
          (emitLine cg
            (concat
              (concat
                "@__axiom_arena_end = internal constant i64 ptrtoint (ptr getelementptr inbounds (["
                (concat (fmtInt n) " x i8], ptr @__axiom_arena, i64 0, i64 "))
              (concat (fmtInt n) ") to i64)")))
        }
        {
          (emitLine cg
            (concat "@__axiom_arena_cursor = internal global i64 " (concat (fmtInt b) "")))
          (emitLine cg
            (concat "@__axiom_arena_end = internal constant i64 " (concat (fmtInt (+ b n)) "")))
        })
      (emitLine cg "")
    }
  })

(pub :: emitRuntimeMap (-> CG String CG))
;@axiom:effect(io)
(pub fn (emitRuntimeMap cg sizeExpr)
  ; 4.2's ONE branch, taken at emission time. A program built for a
  ; static target contains the carve and no `mmap`; a program built for
  ; any supported target contains what it always did.
  (if (> (arenaStaticBytes (cgTarget cg)) 0)
    (emitArenaCarve cg sizeExpr)
    (if (== (targetUsesSyscallAsm (cgTarget cg)) 1)
      (emitLine cg
        (concat
          (concat "  %addr = call i64 asm sideeffect "
            (concat (targetSyscallAsm (cgTarget cg))
              (concat "(i64 " (fmtInt (targetMmapNum (cgTarget cg))))))
          (concat (concat ", i64 0, i64 " (concat sizeExpr ", i64 3, i64 "))
            (concat (fmtInt (targetMapFlags (cgTarget cg))) (concat ", i64 -1, i64 0)" "")))))
      ; MEM_COMMIT|MEM_RESERVE = 0x3000 = 12288, PAGE_READWRITE = 4.
      (emitLine cg
        (concat "  %addr = call i64 @VirtualAlloc(i64 0, i64 "
          (concat sizeExpr ", i64 12288, i64 4)"))))))

; `ptrExpr` is a `%name` register; on Windows its name (less the `%`)
; tags the two registers the call needs, so six writes in one function
; stay distinct. `lenExpr` is a literal or a register.
(pub :: emitRuntimeWrite (-> CG String String CG))
(pub fn (emitRuntimeWrite cg ptrExpr lenExpr)
  (if (== (targetTrapSilent (cgTarget cg)) 1)
    (emitLine cg "  ; trap message suppressed: the target asked for silent traps")
    (if (> (targetUartBase (cgTarget cg)) 0)
      (emitLine cg
        (concat "  call void @__axiom_uart_write(i64 "
          (concat ptrExpr (concat ", i64 " (concat lenExpr ")")))))
      (if (== (targetUsesSyscallAsm (cgTarget cg)) 1)
        (emitLine cg
          (concat
            (concat "  call i64 asm sideeffect " (concat (targetSyscallAsm (cgTarget cg)) "(i64 "))
            (concat (fmtInt (targetWriteNum (cgTarget cg)))
              (concat ", i64 2, i64 "
                (concat ptrExpr (concat ", i64 " (concat lenExpr ", i64 0, i64 0, i64 0)")))))))
        {
          (let tag (strSlice ptrExpr 1 (- (strLen ptrExpr) 1)))
          {
            ; STD_ERROR_HANDLE is -12.
            (emitLine cg (concat "  %" (concat tag "_h = call i64 @GetStdHandle(i64 -12)")))
            (emitLine cg
              (concat (concat "  call i64 @WriteFile(i64 %" (concat tag "_h, i64 "))
                (concat ptrExpr
                  (concat
                    (concat ", i64 "
                      (concat lenExpr ", i64 ptrtoint (ptr @__axiom_win_written to i64), i64 0)"))
                    ""))))
          }
        }))))

(pub :: emitRuntimeExit (-> CG String CG))
(pub fn (emitRuntimeExit cg status)
  (if (== (targetUsesSyscallAsm (cgTarget cg)) 1)
    (emitLine cg
      (concat
        (concat "  call i64 asm sideeffect "
          (concat (targetSyscallAsm (cgTarget cg))
            (concat "(i64 " (fmtInt (targetExitNum (cgTarget cg))))))
        (concat ", i64 " (concat status ", i64 0, i64 0, i64 0, i64 0, i64 0)"))))
    (if (> (targetUartBase (cgTarget cg)) 0)
      (emitBaremetalTrapExit cg status)
      (emitLine cg (concat "  call i64 @ExitProcess(i64 " (concat status ")"))))))

; A trap's exit where there is no kernel to exit to: ARM semihosting
; SYS_EXIT (0x18), reason ADP_Stopped_ApplicationExit (0x20026), with
; the trap's own status in the block's second word. Under QEMU with
; semihosting enabled the machine stops and answers that status, which
; is what keeps the trap statuses - 70, 71, 72, 74, 79 - the whole
; report on-device exactly as they are on a host. The `hlt` takes its
; operands in x0/x1 by constraint, so no move is emitted; the `wfi`
; loop after it is the backstop for a machine with semihosting off,
; where the `hlt` faults instead of returning.
;
; No registers are allocated: both addresses are constant expressions,
; so any number of exit sites may share one function. `status` is a
; literal or a register, as at every other door.
(pub :: emitBaremetalExit (-> CG String CG))
(pub fn (emitBaremetalExit cg status)
  {
    (emitLine cg "  store i64 131110, ptr @__axiom_exit_block")
    (emitLine cg
      (concat "  store i64 "
        (concat status ", ptr getelementptr ([2 x i64], ptr @__axiom_exit_block, i64 0, i64 1)")))
    (emitLine cg
      "  call void asm sideeffect \"hlt 0xf000\", \"{x0},{x1},~{x0},~{x1},~{memory}\"(i64 24, i64 ptrtoint (ptr @__axiom_exit_block to i64))")
    (emitLine cg "  call void asm sideeffect \"1: wfi\\0Ab 1b\", \"\"()")
    (emitLine cg "  unreachable")
    cg
  })

; The symbols the runtime itself declares on a target, so that
; `emitExternDeclares` does not declare one of them a second time when
; a platform module's `extern "kernel32"` block binds it too. Empty on
; a syscall target, whose runtime declares nothing. `GetCommandLineW`
; and `GetEnvironmentStringsW` belong to the entry shim, which an
; archive (`--emit-staticlib`) does not carry - so the list must say
; exactly what was written, or a program's own binding of one of them
; would be skipped and go undefined at the link.
(pub :: runtimeDeclaredSyms (-> Int Bool Strings))
;@axiom:effect(io)
(pub fn (runtimeDeclaredSyms t threads)
  {
    (let v vecNew)
    (if (== (targetUsesSyscallAsm t) 1)
      v
      (if (== t 7)
        v
        {
          (vecPush v "__chkstk")
          (vecPush v "__axiom_console_block")
          (vecPush v "__axiom_console_take")
          (vecPush v "__axiom_win_poller_alive")
          (vecPush v "__axiom_win_poller_retire")
          (vecPush v "__axiom_win_reader_read")
          (vecPush v "__axiom_win_reader_ready")
          (vecPush v "__axiom_win_reader_mode")
          (vecPush v "__axiom_win_reader_close")
          (vecPush v "CreateThread")
          (vecPush v "WaitForSingleObject")
          (vecPush v "CloseHandle")
          (vecPush v "CancelSynchronousIo")
          (vecPush v "Sleep")
          (vecPush v "GetFileType")
          (vecPush v "ReadFile")
          (vecPush v "CreateFileW")
          (vecPush v "GetNumberOfConsoleInputEvents")
          (vecPush v "SetConsoleMode")
          (vecPush v "GetConsoleMode")
          (vecPush v "SetConsoleCtrlHandler")
          (vecPush v "GetLastError")
          (vecPush v "VirtualAlloc")
          (vecPush v "VirtualFree")
          (if (== t 6)
            (vecPush v "RtlCaptureStackBackTrace"))
          (vecPush v "AddVectoredExceptionHandler")
          (vecPush v "SetThreadStackGuarantee")
          (vecPush v "GetStdHandle")
          (vecPush v "WriteFile")
          (vecPush v "ExitProcess")
          (if (! cgStaticlib)
            {
              (vecPush v "GetCommandLineW")
              (vecPush v "GetEnvironmentStringsW")
            })
          v
        }))
  })

; The stack-overflow trap on Windows. The POSIX targets map their own
; guarded stacks and take SIGSEGV on an alternate stack
; (`emitStackRunGuarded`); Windows gives every thread a guard page and
; raises STATUS_STACK_OVERFLOW when the last one is hit, so the runtime
; installs one vectored exception handler at entry and, on each thread,
; `SetThreadStackGuarantee` keeps 64 KiB of the stack for the handler
; to run on. The handler reports the same line as the POSIX trap and
; the backtrace from the faulting frame, then exits 86; any other
; exception passes to the system (EXCEPTION_CONTINUE_SEARCH), as a
; fault outside the guard keeps its signal status there. On
; windows-x86_64 the backtrace is the captured one (`emitBtWalkCaptured`)
; with the handler's own frame skipped and the dispatcher's frames
; above it dropped by the image's address range, read from the PE
; header through the linker's `__ImageBase`: those frames lie above
; every address in the symbol table and would otherwise take its last
; name. On windows-aarch64 the chain is walked from the context's frame
; pointer, naming the faulting address first, as the POSIX trace does.
; The exception record's code is its first word; the context is the
; second word of the EXCEPTION_POINTERS the handler is given, with Fp
; at 240 and Pc at 264 in the ARM64 CONTEXT.
(pub :: emitWinFaultRuntime (-> CG CG))
(pub fn (emitWinFaultRuntime cg)
  {
    (let msg "axiom: stack overflow: the fault address is in the guard below a mapped stack")
    (let n (fmtInt (+ (strLen msg) 1)))
    (let t (cgTarget cg))
    {
      (emitLine cg
        (concat "@__axiom_win_stack_msg = private unnamed_addr constant ["
          (concat n (concat " x i8] c\"" (concat msg "\\0A\"")))))
      (if (== t 6)
        (emitLine cg "@__ImageBase = external global i8"))
      (emitLine cg "define internal i64 @__axiom_veh(i64 %info) #0 {")
      (emitLine cg "entry:")
      ; Keep the capture buffer in the fixed entry frame: a dynamic
      ; alloca would need another probe while this handler is already
      ; reporting an exhausted stack.
      (if (== t 6)
        (emitLine cg "  %buf = alloca [64 x i64], align 16"))
      (emitLine cg "  %ip = inttoptr i64 %info to ptr")
      (emitLine cg "  %recw = load i64, ptr %ip")
      (emitLine cg "  %recp = inttoptr i64 %recw to ptr")
      (emitLine cg "  %code32 = load i32, ptr %recp")
      (emitLine cg "  %code = zext i32 %code32 to i64")
      (emitLine cg "  %isover = icmp eq i64 %code, 3221225725")
      (emitLine cg "  br i1 %isover, label %over, label %pass")
      (emitLine cg "over:")
      (emitLine cg "  %mp = ptrtoint ptr @__axiom_win_stack_msg to i64")
      (emitRuntimeWrite cg "%mp" n)
      (if (== (cgObfuscate cg) 0)
        (if (== t 6)
          (emitWinFaultCaptured cg)
          (emitWinFaultChain cg)))
      (emitLine cg "  call i64 @ExitProcess(i64 86)")
      (emitLine cg "  unreachable")
      (emitLine cg "pass:")
      (emitLine cg "  ret i64 0")
      (emitLine cg "}")
      (emitLine cg "")
      cg
    }
  })

; windows-x86_64: the captured return addresses from the handler's
; caller up, the first inside the image starting the trace.
(pub :: emitWinFaultCaptured (-> CG CG))
(pub fn (emitWinFaultCaptured cg)
  {
    (emitLine cg "  %bufi = ptrtoint ptr %buf to i64")
    (emitLine cg "  %n0 = call i64 @RtlCaptureStackBackTrace(i64 1, i64 64, i64 %bufi, i64 0)")
    (emitLine cg "  %n = and i64 %n0, 65535")
    (emitLine cg "  %base = ptrtoint ptr @__ImageBase to i64")
    (emitLine cg "  %lfa = add i64 %base, 60")
    (emitLine cg "  %lfp = inttoptr i64 %lfa to ptr")
    (emitLine cg "  %lfanew32 = load i32, ptr %lfp")
    (emitLine cg "  %lfanew = zext i32 %lfanew32 to i64")
    (emitLine cg "  %sza = add i64 %base, %lfanew")
    (emitLine cg "  %szb = add i64 %sza, 80")
    (emitLine cg "  %szp = inttoptr i64 %szb to ptr")
    (emitLine cg "  %sz32 = load i32, ptr %szp")
    (emitLine cg "  %sz = zext i32 %sz32 to i64")
    (emitLine cg "  %end = add i64 %base, %sz")
    (emitLine cg "  br label %skip")
    (emitLine cg "skip:")
    (emitLine cg "  %i = phi i64 [ 0, %over ], [ %i1, %outside ]")
    (emitLine cg "  %more = icmp ult i64 %i, %n")
    (emitLine cg "  br i1 %more, label %look, label %trace")
    (emitLine cg "look:")
    (emitLine cg "  %ao = mul i64 %i, 8")
    (emitLine cg "  %aa = add i64 %bufi, %ao")
    (emitLine cg "  %ap = inttoptr i64 %aa to ptr")
    (emitLine cg "  %a = load i64, ptr %ap")
    (emitLine cg "  %ge = icmp uge i64 %a, %base")
    (emitLine cg "  %lt = icmp ult i64 %a, %end")
    (emitLine cg "  %in = and i1 %ge, %lt")
    (emitLine cg "  br i1 %in, label %trace, label %outside")
    (emitLine cg "outside:")
    (emitLine cg "  %i1 = add i64 %i, 1")
    (emitLine cg "  br label %skip")
    (emitLine cg "trace:")
    (emitLine cg "  %fo = mul i64 %i, 8")
    (emitLine cg "  %fa = add i64 %bufi, %fo")
    (emitLine cg "  %left = sub i64 %n, %i")
    (emitLine cg "  call void @__axiom_backtrace_from(i64 %fa, i64 %left, i64 0, i64 0)")
    cg
  })

; windows-aarch64: the chain from the context's frame pointer, the
; faulting address named first.
(pub :: emitWinFaultChain (-> CG CG))
(pub fn (emitWinFaultChain cg)
  {
    (emitLine cg "  %ctxa = add i64 %info, 8")
    (emitLine cg "  %ctxp = inttoptr i64 %ctxa to ptr")
    (emitLine cg "  %ctx = load i64, ptr %ctxp")
    (emitLine cg "  %fpa = add i64 %ctx, 240")
    (emitLine cg "  %fpp = inttoptr i64 %fpa to ptr")
    (emitLine cg "  %fp = load i64, ptr %fpp")
    (emitLine cg "  %pca = add i64 %ctx, 264")
    (emitLine cg "  %pcp = inttoptr i64 %pca to ptr")
    (emitLine cg "  %pc = load i64, ptr %pcp")
    (emitLine cg "  %ra = add i64 %pc, 1")
    (emitLine cg "  call void @__axiom_backtrace_from(i64 %fp, i64 0, i64 -1, i64 %ra)")
    cg
  })

; What a Windows module carries whether or not it has an entry: the
; four kernel32 declares the allocator, the arena and the three traps
; call, the DWORD cell `WriteFile` writes its count through, and the
; trap `__syscallN` lowers to on a target that has no syscall ABI
; (`emitPrimSyscall`). Status 74 is the fourth reserved status after
; `MM-EXEC-16`'s 70, 71 and 72 - 73 is the FFI's - and its sentence is
; 37 bytes, counted the way `emitUnhandledTrap` counts its own: llc
; believes the array length.
;
; `; axiom-extern-lib kernel32` is the same line an `extern
; "kernel32"` block writes, and it is what lets the driver link
; `kernel32.lib` the way it links any other block's archive - the
; runtime is, in effect, one more extern block.
(pub :: emitWinRuntime (-> CG CG))
(pub fn (emitWinRuntime cg)
  {
    (emitLine cg "; axiom-extern-lib kernel32")
    (emitLine cg "declare dllimport i64 @VirtualAlloc(i64, i64, i64, i64) #0")
    (emitLine cg "declare dllimport i64 @VirtualFree(i64, i64, i64) #0")
    (if (== (cgTarget cg) 6)
      (emitLine cg "declare dllimport i64 @RtlCaptureStackBackTrace(i64, i64, i64, i64) #0"))
    (emitLine cg "declare dllimport i64 @AddVectoredExceptionHandler(i64, i64) #0")
    (emitLine cg "declare dllimport i64 @SetThreadStackGuarantee(i64) #0")
    (emitLine cg "declare dllimport i64 @SetConsoleCtrlHandler(i64, i64) #0")
    (emitLine cg "declare dllimport i64 @GetLastError() #0")
    (emitLine cg "declare dllimport i64 @CreateThread(i64, i64, i64, i64, i64, i64) #0")
    (emitLine cg "declare dllimport i64 @WaitForSingleObject(i64, i64) #0")
    (emitLine cg "declare dllimport i64 @CloseHandle(i64) #0")
    (emitLine cg "declare dllimport i64 @CancelSynchronousIo(i64) #0")
    (emitLine cg "declare dllimport i64 @Sleep(i64) #0")
    (emitLine cg "declare dllimport i64 @GetFileType(i64) #0")
    (emitLine cg "declare dllimport i64 @ReadFile(i64, i64, i64, i64, i64) #0")
    (emitLine cg "declare dllimport i64 @CreateFileW(i64, i64, i64, i64, i64, i64, i64) #0")
    (emitLine cg "declare dllimport i64 @GetNumberOfConsoleInputEvents(i64, i64) #0")
    (emitLine cg "declare dllimport i64 @SetConsoleMode(i64, i64) #0")
    (emitLine cg "declare dllimport i64 @GetConsoleMode(i64, i64) #0")
    (emitLine cg "declare dllimport i64 @GetStdHandle(i64) #0")
    (emitLine cg "declare dllimport i64 @WriteFile(i64, i64, i64, i64, i64) #0")
    (emitLine cg "declare dllimport i64 @ExitProcess(i64) #0")
    ; `_fltused` is the MSVC CRT's "this program uses floating point"
    ; marker: LLVM references it from any COFF/MSVC object holding a
    ; floating-point instruction, and the CRT would define it. There is
    ; no CRT here, so the module defines it - a word of data, value
    ; unread - and the link has one fewer unresolved name that is not
    ; a real import. Measured 2026-08-29 on `010-hello`: `U _fltused`
    ; in the object without this line, `D _fltused` with it.
    (emitLine cg "@_fltused = global i32 1")
    (emitWinStackProbe cg)
    (emitWinFaultRuntime cg)
    (emitWinConsoleRuntime cg)
    (emitWinReaderRuntime cg)
    (emitWinPollerLifetimeRuntime cg)
    ; Static TLS without a C runtime, for the `thread_local(localexec)`
    ; runtime globals of a module that spawns (MM-PAR-6): lld-link fills
    ; the PE's TLS data directory from `_tls_used`; the loader gives
    ; every thread, `CreateThread`'s included, a block the size of the
    ; `.tls$` sections `_tls_start` and `_tls_end` bracket, and writes
    ; the module's TLS index to `_tls_index`, which each access LLVM
    ; emits reads beside the TEB's ThreadLocalStoragePointer. A module
    ; that spawns no thread emits none of this, so its IR is what it was.
    (if (cgThreads cg)
      {
        (emitLine cg "@_tls_start = global i8 0, section \".tls\"")
        (emitLine cg "@_tls_end = global i8 0, section \".tls$ZZZ\"")
        (emitLine cg "@_tls_index = global i32 0")
        (emitLine cg
          "@_tls_used = global { i64, i64, i64, i64, i32, i32 } { i64 ptrtoint (ptr @_tls_start to i64), i64 ptrtoint (ptr @_tls_end to i64), i64 ptrtoint (ptr @_tls_index to i64), i64 0, i32 0, i32 0 }, section \".rdata$T\"")
      })
    (emitLine cg "@__axiom_win_written = internal global i64 0")
    (emitLine cg
      "@__axiom_nosys_msg = private unnamed_addr constant [37 x i8] c\"axiom: no syscall ABI on this target\\0A\"")
    (emitLine cg "define internal i64 @__axiom_no_syscall() #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  call i64 @__axiom_recover_abort(i64 74)")
    (emitLine cg "  %nsp = ptrtoint ptr @__axiom_nosys_msg to i64")
    (emitRuntimeWrite cg "%nsp" "37")
    (emitLine cg "  call void @__axiom_backtrace()")
    (emitRuntimeExit cg "74")
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; Probe every page before LLVM subtracts a large Windows frame. The
; backend calls `__chkstk` from a prologue without an ordinary argument
; list: x86-64 passes bytes in rax, arm64 passes sixteen-byte units in
; x15. Both helpers keep sp and the size register unchanged. Only
; r10/r11 or x16/x17 and flags may change, so the probe has no frame
; or register spills of its own. Its weak definition also lets a host
; provide the same ABI helper. The last read reaches the exact end
; of the requested range; the reads before it cannot skip a guard.
;
; Keeping the probe in the emitted runtime lets a large frame link
; without a C runtime, and lets Windows grow its guarded stack before
; any store to that frame. `scripts/check-recover.sh` executes the
; host-architecture helper against an intervening protected page and
; assembles a large call frame for both Windows architectures.
(pub :: emitWinStackProbe (-> CG CG))
(pub fn (emitWinStackProbe cg)
  {
    ; Its calls appear during llc, after IR pruning and optimisation.
    ; The retention list exposes that dependency to both passes.
    (emitLine cg
      "@llvm.compiler.used = appending global [1 x ptr] [ptr @__chkstk], section \"llvm.metadata\"")
    (emitLine cg "define weak_odr void @__chkstk() naked {")
    (emitLine cg "entry:")
    (emitLine cg
      (if (== (cgTarget cg) 6)
        "  call void asm sideeffect \"movq %rax, %r10\\0Aleaq 8(%rsp), %r11\\0Atestq %r10, %r10\\0Ajz 3f\\0Acmpq $$4096, %r10\\0Ajbe 2f\\0A1:\\0Asubq $$4096, %r11\\0Atestb $$0, (%r11)\\0Asubq $$4096, %r10\\0Acmpq $$4096, %r10\\0Aja 1b\\0A2:\\0Asubq %r10, %r11\\0Atestb $$0, (%r11)\\0A3:\\0Aretq\", \"~{r10},~{r11},~{memory},~{cc}\"()"
        "  call void asm sideeffect \"lsl x16, x15, #4\\0Amov x17, sp\\0Acbz x16, 3f\\0Acmp x16, #4096\\0Ab.ls 2f\\0A1:\\0Asub x17, x17, #4096\\0Aldr xzr, [x17]\\0Asub x16, x16, #4096\\0Acmp x16, #4096\\0Ab.hi 1b\\0A2:\\0Asub x17, x17, x16\\0Aldr xzr, [x17]\\0A3:\\0Aret\", \"~{x16},~{x17},~{memory},~{cc}\"()"))
    (emitLine cg "  unreachable")
    (emitLine cg "}")
    (emitLine cg "")
    cg
  })

; Console control notifications are delivered on a Windows-owned thread.
; This bridge keeps only process-owned atomics: no arena, TLS, captured
; Axiom value or user code is touched by the callback. SIG_BLOCK has no
; matching unblock operation in this API, so the mask and registration
; last for the process, independently of any poller's lifetime.
;
; CTRL_C and CTRL_BREAK map to signal 2 and 21. Close, logoff and
; shutdown continue through the system's handler chain: Windows ends
; the process when a handler for those events returns, so a pending
; notification could not let an event loop finish cleanup safely.
(pub :: emitWinConsoleRuntime (-> CG CG))
(pub fn (emitWinConsoleRuntime cg)
  {
    (emitLine cg "@__axiom_console_mask = internal global i64 0, align 8")
    (emitLine cg "@__axiom_console_pending = internal global i64 0, align 8")
    (emitLine cg "@__axiom_console_registered = internal global i32 0, align 4")
    (emitLine cg "@__axiom_console_lock = internal global i32 0, align 4")
    (emitLine cg "")
    (emitLine cg "define internal i32 @__axiom_console_handler(i32 %event) #0 {")
    (emitLine cg "entry:")
    (emitLine cg
      "  switch i32 %event, label %unhandled [ i32 0, label %interrupt i32 1, label %break ]")
    (emitLine cg "interrupt:")
    (emitLine cg "  br label %check")
    (emitLine cg "break:")
    (emitLine cg "  br label %check")
    (emitLine cg "check:")
    (emitLine cg
      (concat "  %bit = phi i64 [ 2, %interrupt ], [ " (concat (fmtInt (<< 1 20)) ", %break ]")))
    (emitLine cg "  %blocked = load atomic i64, ptr @__axiom_console_mask acquire, align 8")
    (emitLine cg "  %wanted = and i64 %blocked, %bit")
    (emitLine cg "  %handles = icmp ne i64 %wanted, 0")
    (emitLine cg "  br i1 %handles, label %queue, label %unhandled")
    (emitLine cg "queue:")
    (emitLine cg "  %old = atomicrmw or ptr @__axiom_console_pending, i64 %bit acq_rel")
    (emitLine cg "  ret i32 1")
    (emitLine cg "unhandled:")
    (emitLine cg "  ret i32 0")
    (emitLine cg "}")
    (emitLine cg "")
    (emitLine cg "define internal i64 @__axiom_console_block(i64 %mask) #0 {")
    (emitLine cg "entry:")
    (emitLine cg "  %unsupported = and i64 %mask, -1048579")
    (emitLine cg "  %bad = icmp ne i64 %unsupported, 0")
    (emitLine cg "  br i1 %bad, label %invalid, label %nonempty")
    (emitLine cg "invalid:")
    (emitLine cg "  ret i64 -87")
    (emitLine cg "nonempty:")
