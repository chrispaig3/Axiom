(:: emitBinaryIr (-> CheckedProgram Names Names Int String))
;@axiom:effect(io)
;@axiom:effect(entropy)
(fn (emitBinaryIr program bares fulls target)
  {
    (let obscure (hasFlagAnywhere subcommandName "--obfuscate"))
    {
      (let phaseT (phaseNow))
      (let ir (emitCheckedProgram program bares fulls target obscure))
      (phaseLog "emit" phaseT)
      (if obscure
        (match (obfuscateIr ir)
          ((Ok masked) masked)
          ((Err e)
            {
              (sysExitWith
                (toolFailDiag (concat "obfuscation entropy failed: " (errorText e))
                  "check the operating system's entropy source"))
              ""
            }
          ))
        ir)
    }
  })

; Which diagnostic renderer this invocation wants: the one the flag
; names, and `human` when there is no flag. `checkArgs` has already
; refused any value other than `human`, `ai` or `json`, so a typo never
; reaches the default.
(pub :: diagFormatArg Int)
;@axiom:effect(io)
(pub fn (diagFormatArg)
  (match (flagValue "--diagnostic-format" 1)
    ((None) FMT_HUMAN)
    ((Some value)
      {
        (let c (parseDiagFormatName value))
        (if (>= c 0)
          c
          FMT_HUMAN)
      }
    )))

; `symbols` emits AXSYM and nothing else, and this says so out loud
; when asked for something else.
;
; The Rust compiler had three renderers for it - an aligned human
; table (its DEFAULT), one JSON object per line, and AXSYM. This
; compiler has the first and the third: the table under `human`, which
; is the default, and AXSYM under `ai`. The table is DERIVED from the
; AXSYM text, so the two cannot disagree about what the symbols are -
; it only drops the nid and the metadata columns.
;
; This paragraph said "only the third, which is also its default" until
; 2026-08-22, and `axiom help symbols` said "AXSYM is the only
; rendering" beside it. Both were false, and the code twelve lines
; below - "`human` and `ai` both render symbols now" - had said so
; since the table was added. The user-visible cost of the stale help
; was specific: `#effects=` is metadata, the table has no metadata
; column, so a reader following the help saw no effect sets at all and
; had no reason to look for a flag the help said did not apply.
;
; What was NOT acceptable is how it diverged. `--diagnostic-format`
; was read, used for diagnostics, and then ignored for the symbol
; output, so `symbols --diagnostic-format=json` printed AXSYM and
; claimed success - a request silently answered with something else.
; A notice, rather than a refusal, because the flag is global: a
; script that sets it once for a run of mixed subcommands should not
; fail on this one.
; The AXSYM table for `tc`, rendered and written to stdout.
;
; ONE renderer, called from both arms of the symbols command, because
; the arms differ in what they say about the file and not in what the
; symbols are. It was written out in the success arm only, which is how
; the failure arm came to print nothing at all.
;
; AXSYM under `ai`, the aligned table under `human`, which is the
; default - stage0's split, and the last of the three divergences the
; self-hosting record kept OPEN. The table is derived from the AXSYM
; text, so the two cannot disagree about what the symbols are.
; `--axir` REPLACES the stream rather than adding to it: the `.axir`
; record file is the second half of one design, holding per function
; exactly what an AXSYM line has no room for - the arity, the
; parameter names, the region-facts words, and, under `--mir`, the
; block and instruction lines of the function as `mir.ax`'s `mLowerFn`
; lowered it. The two join on the whole `F` header tuple, which is why
; the record repeats it verbatim.
; It is not affected by `--diagnostic-format`: there is one rendering
; of a record file, and the human table is a rendering of AXSYM.
;
; `--mir` is orthogonal to both, and it is the slow one. It FORCES the
; region-facts fixpoint - measured 0.72s to 21.7s on this compiler,
; 30x - so it is never implied by anything.
(pub :: symbolsEmit (-> TC GeneratedOrigins String Int Int))
;@axiom:effect(io)
(pub fn (symbolsEmit tc gens cmd dfmt)
  {
    {
      (let bi
        (if (hasFlagAnywhere (Some cmd) "--builtins")
          1
          0))
      (let mir
        (if (hasFlagAnywhere (Some cmd) "--mir")
          1
          0))
      (if (hasFlagAnywhere (Some cmd) "--axir")
        (replOut (axirRender tc bi mir (targetArg hostTarget)))
        {
          (let axsym
            (symbolsRenderGens tc bi gens
              (if (hasFlagAnywhere (Some cmd) "--calls")
                1
                0)
              mir))
          (replOut
            (if (== dfmt FMT_HUMAN)
              (symbolsHumanTable axsym)
              axsym))
        })
    }
    0
  })

; `axiom symbols --axir` on a file that IS an AXIR record file reads it
; back and re-emits it, rather than trying to compile it.
;
; THE MAGIC LINE IS THE DISCRIMINATOR, not the extension. That is the
; whole reason `axir 1 <target> <version>` is the first line of every
; record file: a tool holding one never has to guess, and the guess
; that would otherwise be on offer - the file name - is exactly the one
; that fails, because LLVM's Machine IR is also written by this
; toolchain and also carries an IR in a text file.
;
; This is what `scripts/check-mir-roundtrip.sh` drives: emit, read
; back, emit again, and the two emissions must be identical byte for
; byte. A GOLDEN was deliberately not used. check-tools-selfhost.sh's
; own header records the run where both AXSYM goldens were re-blessed
; clean against a compiler emitting a start column shifted by one, and
; only `verify-axsym.py` - which re-derives the claim - caught it.
; Round-trip identity is a property a re-bless cannot satisfy.
;
; A parse refusal is exit 1 with the reader's own message on stderr,
; not a silent short file.
(pub :: symbolsAxirReadBack (-> String Int))
;@axiom:effect(io)
(pub fn (symbolsAxirReadBack src)
  (if (axirLooksLikeFile src)
    {
      (let msg vecNew)
      (let out (axirReemit src msg))
      (if (> (vecLen msg) 0)
        (die (concat "error: " (concat (vecGetStr msg 0) "\n")) 1)
        {
          (replOut out)
          (sysExitWith 0)
          0
        })
    }
    0))

(pub :: symbolsCheckFormat Int)
;@axiom:effect(io)
(pub fn (symbolsCheckFormat)
  (if (let (Some value) (flagValue "--diagnostic-format" 1))
    (if (strEq value "json")
      (usageError
        "error: `symbols` has no JSON renderer; use --diagnostic-format=ai for AXSYM or --diagnostic-format=human for a table\n")
      0)
    0))

; Exit status is the driver's answer, not a byte count: 0 on success and
; 1 when the source could not be read, could not be parsed, has no entry
; point, or does not type-check. The previous version returned whatever
; `replOut` did, so a successful run exited with the length of its
; own output.
;
; The input path is the first command-line argument. It used to default
; to `in.ax` when there was none, which is why a bare `axiom` answered
; `cannot read input: in.ax` - naming a file the user had never typed.
; The five harnesses that relied on that default all `cp` their case to
; `in.ax` first, so each now passes the name explicitly and a bare
; invocation is free to print the usage instead.
;
; `sysArg`'s Str wraps the process's own NUL-terminated argv bytes
; without copying, so its `strData` is exactly the C string
; `sysReadFile` wants.
;
; Import resolution happens HERE, before the check, because the type
; checker needs the resolved declaration list too - a signature in the
; entry file may be satisfied by a definition that arrives through an
; import - and resolving twice would read every module from disk
; twice. The emitter then takes what the check accepted, through
; `checked.ax`.
;
; Diagnostics go to stderr and the LLVM to stdout, the same split
; stage0 uses, so a differential gate can compare the two streams
; separately. An error refuses to emit: a program that does not check
; has no business producing an object file.
; ------------------------------------------------------------------
; Reading the input, and saying what went wrong when it cannot be read.
; ------------------------------------------------------------------
; The C library's own wording for the three errnos a source path
; realistically produces. Anything else is reported by number rather
; than guessed at, because a wrong reason is worse than a bare one.
; A parse failure is a DIAGNOSTIC, through the same renderer and the
; same exit status as every other one - the shape `compileFile` uses
; inline, for the subcommands that parse a second time. `test`
; re-parses after `compileFile` has already refused any error it
; found, and `symbols` parses its own input; both used to die with a
; bare `compilation failed due to a syntax error` naming no code, no
; span and no count, against the coded, spanned report and exit 1 the
; compile path gives the same file.
;
; The tokens are re-lexed here rather than threaded in: this runs only
; on the failure path, where one more lex costs nothing, and the call
; sites keep their shape. Lex errors are checked first for the same
; reason they are in `compileFile` - a file with a bad escape has no
; token stream worth parsing.
(pub :: dieParseErr (-> String String (PResult a) Int Int))
;@axiom:effect(io)
(pub fn (dieParseErr file src pr dfmt)
  {
    (let toks (lex src))
    {
      (let lexD (lexErrDiag toks src))
      {
        (let ds
          {
            (let v vecNew)
            {
              (vecPush v
                (if (let (Some ld) lexD)
                  ld
                  (parseErrDiag toks pr src)))
              v
            }
          })
        (let units
          {
            (let v vecNew)
            {
              (vecPush v (CUnit2 :file file :src src :name None :imports vecNew :library false))
              v
            }
          })
        {
          (writeStderrStr (renderDiagsFormat dfmt ds units))
          (writeStderrStr (renderFailTrailer 1))
          (sysExitWith 1)
          1
        }
      }
    }
  })

; Does this declaration list define a `main` function?
;
; The entry point is what turns a module into a program, and until this
; existed nothing checked for it: `emitFnDef` renames the entry file's
; `main` to `__axiom_user_main` and the prelude's argv wrapper calls
; that symbol, so a file with no `main` emitted a call to a function
; nobody defined. The failure surfaced from `opt`, as `use of undefined
; value '@__axiom_user_main'` against a temporary `.ll` that had already
; been deleted, blaming a native tool for the program's own omission.
; AX4001 has been in the code table and in `axiom explain` the whole
; time, with no site constructing it.
(pub :: declsHaveMain (-> (Vec ASTNode) Bool))
(pub fn (declsHaveMain ds)
  (declsHaveMainFrom ds 0))

; Run the checker and join the expansion frames onto its diagnostics -
; a diagnostic anchored at a recorded macro invocation gains the
; frame(s) naming the macro, with the declaration's span and unit
; (macro-system.md MAC-DIAG-4). One expression, so the two call shapes
; below swap in without moving any parentheses around them.
(:: checkWithFrames (-> (Vec ASTNode) (Vec ASTNode) Units Frames CheckedResult))
(fn (checkWithFrames decls allDecls units ftbl)
  ; A warning a `;@axiom:nolint(...)` tag quiets is dropped here, for
  ; `check`, `build` and `run` alike (`nolintQuietDiags`); the
  ; language server drops the same ones, so the two agree.
  {
    (let checked (checkExpandedProgram decls allDecls units))
    (let cds (nolintQuietDiags decls checked.diagnostics))
    {
      (expAttachFrames cds ftbl units)
      (CheckedResult :diagnostics cds :program checked.program)
    }
  })

; Binding accessors are generated from checked nominal types, then
; checked with the module. This preserves aliases and module identities
; across both the archive and the Rust file.
(:: checkWithBindingShims (-> (Vec ASTNode) (Vec ASTNode) Units Frames Names CheckedResult))
;@axiom:effect(io)
(fn (checkWithBindingShims decls allDecls units ftbl pubNames)
  (match (flagValue "--emit-rust-binding" 1)
    ((None) (checkWithFrames decls allDecls units ftbl))
    ((Some bindingPath)
      (if (== (strLen bindingPath) 0)
        (checkWithFrames decls allDecls units ftbl)
        {
          (let tc (checkModuleTcTyped decls allDecls units))
          {
            (let ds (nolintQuietDiags decls (tcOutVec tc)))
            {
              (expAttachFrames ds ftbl units)
              (if (> (countErrorDiags ds) 0)
                (CheckedResult :diagnostics ds :program None)
                {
                  (let collision (rbCollisionName decls pubNames))
                  (if (> (strLen collision) 0)
                    {
                      (vecPush ds
                        (mkDiag SEV_ERROR "AX3006" "duplicate-definition" 0
                          (concat "generated Rust accessor names collide for `"
                            (concat collision "`"))
                          None
                          (Some
                            "rename one of the source types so its generated accessor names are distinct")))
                      (CheckedResult :diagnostics ds :program None)
                    }
                    {
                      (let first (vecLen decls))
                      {
                        (rbAppendShims decls pubNames)
                        {
                          (let mut i first)
                          (while (< i (vecLen decls))
                            {
                              {
                                (let d (vecGet decls i))
                                (if (!= (nodeTag d) TAG_D_IMPORT)
                                  (vecPush allDecls d))
                              }
                              (set i (+ i 1))
                            })
                        }
                        (checkWithFrames decls allDecls units ftbl)
                      }
                    })
                })
            }
          }
        })
    )))

(:: attachTcFrames (-> (Vec ASTNode) TC Frames Units Diags))
(fn (attachTcFrames decls tc ftbl units)
  {
    (expAttachFrames (tcOutVec tc) ftbl units)
    (nolintQuietDiags decls (tcOutVec tc))
  })

(pub :: declsHaveMainFrom (-> (Vec ASTNode) Int Bool))
(pub fn (declsHaveMainFrom ds i)
  (if (>= i (vecLen ds))
    false
    {
      (let d (vecGet ds i))
      (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeAName d) "main"))
        true
        (declsHaveMainFrom ds (+ i 1)))
    }))

; AX4008: a device primitive, or an interrupt-vector binding, that the
; target cannot execute. Codegen does not lower one - it writes a
; `; axiom-device-refused <sentence>` line where the instruction would
; have been (`emitDeviceRefused`, `emitIsrBinding`) - and this refuses
; the module when such a line SURVIVED `pruneDeadDefs`, so a function
; nothing calls is never refused. Asked of the finished IR because the
; emitter cannot report a diagnostic and the driver can: AX4006's
; arrangement, from the other end of emission. Spanless, like AX4006 -
; the IR line no longer knows which call wrote it - and the sentence
; names the primitive, which is the thing to search for.
(pub :: refuseDeviceIr (-> String Int Units String))
;@axiom:effect(io)
(pub fn (refuseDeviceIr ir dfmt units)
  {
    (let mds (deviceRefusals ir vecNew vecNew 0))
    (if (== (vecLen mds) 0)
      ir
      {
        (writeStderrStr (renderDiagsFormat dfmt mds units))
        (writeStderrStr (renderFailTrailer (vecLen mds)))
        (sysExitWith 1)
        ""
      })
  })

; Every marker from `from` on, one diagnostic per DISTINCT sentence: a
; primitive called in three places is one refusal, not three.
(pub :: deviceRefusals (-> String (Vec diag::Diag) Strings Int (Vec diag::Diag)))
(pub fn (deviceRefusals ir mds seen from)
  {
    (let k (strFindSub ir "; axiom-device-refused " from))
    (if (< k 0)
      mds
      {
        (let s (+ k 23))
        (let mut e (+ k 23))
        {
          (while (&& (< e (strLen ir)) (!= (strByte ir e) 10))
            (set e (+ e 1)))
          {
            (let msg (strSlice ir s (- e s)))
            (if (! (strInVecStr seen msg 0))
              {
                (vecPush seen msg)
                (vecPush mds
                  (mkDiag SEV_ERROR "AX4008" "target-device-unsupported" 0 msg None
                    (Some
                      "the volatile accesses (`__vload8`..`__vstore64`) lower on every target; the barriers and the two counter reads (`__arm_dmb`, `__arm_dsb`, `__arm_isb`, `__arm_cntvct`, `__arm_cntfrq`) on any AArch64 target; everything else in the `__arm_` family, an `isr(irq)` binding to the IRQ vector and an `isr(fault)` binding to the fault hook, only on baremetal-aarch64. Build for a target that has it, or keep the call off every path `main` reaches - a function nothing calls is pruned before this check")))
              })
          }
          (deviceRefusals ir mds seen e)
        }
      })
  })

(pub :: strInVecStr (-> Strings String Int Bool))
(pub fn (strInVecStr v s i)
  (if (>= i (vecLen v))
    false
    (if (strEq (vecGetStr v i) s)
      true
      (strInVecStr v s (+ i 1)))))

; Opt-in phase timing, in the spirit of rustc's `-Ztime-passes`:
; AXIOM_TIME_PHASES=1 writes one `phase <name> <ms>` line per pipeline
; stage to stderr. Stdout, diagnostics and IR are unchanged, and the
; clock is read either way so the disabled path costs eight syscalls.
(:: phaseNow Int)
;@axiom:effect(io)
(fn (phaseNow)
  (match (sysNowMonotonic (memAlloc 16))
    ((Ok us) us)
    ((Err e) 0)))

(:: phaseLog (-> String Int Int))
;@axiom:effect(io)
(fn (phaseLog name start)
  {
    (if (strEq (sysEnv "AXIOM_TIME_PHASES") "1")
      (writeStderrStr
        (concat "phase "
          (concat name (concat " " (concat (fmtInt (/ (- (phaseNow) start) 1000)) " ms\n"))))))
    0
  })

(:: timedResolve (-> (Vec ASTNode) Names Names ModuleImports Int String Units Int (Vec ASTNode)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (timedResolve decls bares fulls mods tcode dir units start)
  {
    (let r (resolveImportsParallel decls bares fulls mods tcode dir units))
    {
      (phaseLog "frontend (read, lex, parse, resolve)" start)
      r
    }
  })

(:: timedExpand (-> Nodes Nodes Diags Frames Units Names Names ModuleImports GeneratedOrigins))
;@axiom:effect(io)
(fn (timedExpand entryDecls decls out frames units bares fulls mods)
  {
    (let t (phaseNow))
    (let r (expandProgram entryDecls decls out frames units bares fulls mods))
    {
      (phaseLog "expand" t)
      r
    }
  })

(:: timedCheck (-> Nodes Nodes Units Frames Names CheckedResult))
;@axiom:effect(io)
(fn (timedCheck decls allDecls units ftbl pubNames)
  {
    (let t (phaseNow))
    (let r (checkWithBindingShims decls allDecls units ftbl pubNames))
    {
      (phaseLog "check" t)
      r
    }
  })

; Compile `fileName` for `tname`, answering its LLVM text - or the empty
; string when `doEmit` is 0, which is what `check` wants.
;
; `needMain` is 1 for the subcommands that produce an executable -
; `build` and `run` - and 0 for `check` and `emit-llvm`. That split is
; stage0's: its `build` tested the
; generated module for an entry point and its `emit_llvm` did not, so a
; library module can still be checked and can still have its IR read.
;
; Every failure exits from inside here rather than being returned,
; because each has its own status and each has already said what went
; wrong: 1 an unreadable input, a parse error, a missing entry point, or
; a module that does not type-check. Threading the codes back through a
; language with no sum type at this layer would buy nothing - no caller
; has a second thing to try.
(pub :: compileFile (-> String String Int Int String))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(entropy)
(pub fn (compileFile fileName tname doEmit needMain)
  (compileFileFrom fileName tname doEmit needMain 0))

; The same, for an input that is a generated temporary (`transient` 1):
; it is removed as soon as it has been read, so a refusal - which exits
; from inside - leaves nothing behind. `axiom test`'s driver is one: a
; `main` it generates can be refused where the test file itself checks
; clean, such as an operation that reaches it with no handler (AX3053).
(pub :: compileFileFrom (-> String String Int Int Int String))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(entropy)
(pub fn (compileFileFrom fileName tname doEmit needMain transient)
  ; `--crate DIR` first: a stale or missing binding module is
  ; regenerated and a missing archive built, before the module
  ; search that would otherwise report them missing
  ; The project manifest is verified BEFORE anything is read, so a
  ; dependency directory that is not there, or two of them providing
  ; one module, is reported once and against `axiom.pkg` - rather
  ; than as a run of missing-module diagnostics that never name the
  ; file that caused them. A tree with no manifest pays one
  ; `sysFileExists` per directory level and gets nothing else.
  ; ...and then that no dependency the manifest pulled in provides a
  ; module the STANDARD LIBRARY provides. Separate from `pkgVerify`
  ; because it needs the library's search directories, which only
  ; `codegen` knows - and running here, in the same `let`, keeps it
  ; before any module is read, which is the property every refusal
  ; in this group shares.
  {
    (let phaseT0 (phaseNow))
    (let got (readFile fileName))
    (let src (unwrapOr got ""))
    (let rerr (sourceReadErrno got))
    (let _gone
      (if (== transient 1)
        (unwrapOr (removeFile fileName) 0)
        0))
    (let dfmt diagFormatArg)
    (let _crates prepareCrates)
    (let _pkg (pkgVerify (pathDir fileName)))
    (let _shadow (pkgCheckStdlibShadow (pathDir fileName)))
    (if (!= rerr 0)
      {
        (die (readFailMsg fileName rerr) 1)
        ""
      }
      ; An empty file is READ, not refused: it lexes to no tokens and
      ; parses to a module with no declarations, which `check` accepts
      ; and `build` rejects for having no `main` - the same answers
      ; stage0 gave. It used to be refused as unreadable.
      ; Lexical errors come first, because lexing does - and because
      ; a file with a bad escape in it has not got a token stream
      ; worth parsing. stage0 reports them the same way round.
      {
        (let toks (lex src))
        {
          (let lexD (lexErrDiag toks src))
          {
            (let pr
              (if (isNone lexD)
                (parseModuleWith toks (scanAxtags src))
                (pErr 0)))
            (match pr
              ((ParseFailed parseError1)
                ; A parse failure is a DIAGNOSTIC, through the same
                ; renderer and the same exit status as every other one.
                ; It used to be a bare `parse failed` on stderr with exit
                ; 2, against stage0's coded, spanned report and exit 1.
                {
                  (let ds
                    {
                      (let v vecNew)
                      {
                        (vecPush v
                          (if (let (Some ld) lexD)
                            ld
                            (parseErrDiag toks (ParseFailed parseError1) src)))
                        v
                      }
                    })
                  (let units
                    {
                      (let v vecNew)
                      {
                        (vecPush v
                          (CUnit2
                            :file fileName
                            :src src
                            :name None
                            :imports vecNew
                            :library (pathInStdlib fileName)))
                        v
                      }
                    })
                  {
                    (writeStderrStr (renderDiagsFormat dfmt ds units))
                    (writeStderrStr (renderFailTrailer 1))
                    (sysExitWith 1)
                    ""
                  }
                }
              )
              ((ParseSuccess parsedValue1 parsedPos1)
                ; The target is the second argument, by the same names
                ; stage0's --target takes; this compiler's OWN host when
                ; absent.
                ;
                ; It used to default to the literal "darwin-aarch64",
                ; which made every compiler built anywhere else emit
                ; Mach-O-targeted IR unless told otherwise - including in
                ; `check-bootstrap.sh`, which passes no target and runs on
                ; `ubuntu-latest`. `Host` is a per-target module selected
                ; when this compiler was compiled, so the answer is
                ; whatever it was built for.
                ; what the entry file wrote `pub`, before import
                ; resolution rewrites visibility (rustbind.ax)
                ; and, for a binding, the accessor shims the
                ; binding calls, synthesised into this module
                ; before it is resolved, checked and compiled
                ; Unit 0 is the entry file; `resolveImports` appends
                ; one per module it reads, and every diagnostic names
                ; the unit its spans index.
                ; Macros expand HERE, between import resolution and
                ; the checker, so the checker sees what a macro
                ; generated and reports about it like any other
                ; code. Expansion used to happen inside codegen, so
                ; `check` never saw an expansion at all and accepted
                ; programs `build` could not compile - see the header
                ; of `core/expand.ax` for what that cost.
                {
                  (let decls parsedValue1)
                  {
                    (let tcode (checkedTargetCode tname))
                    (let pubFns (rbPubNames parsedValue1))
                    (if (let (Some bindingPath) (flagValue "--emit-rust-binding" 1))
                      (if (> (strLen bindingPath) 0)
                        (vecPush decls (mkDImportAt "Vec" vecNew 0))))
                    (let bares vecNew)
                    (let fulls vecNew)
                    (let mods vecNew)
                    {
                      (let units
                        {
                          (let v vecNew)
                          {
                            (vecPush v
                              (CUnit2
                                :file fileName
                                :src src
                                :name None
                                :imports vecNew
                                :library (pathInStdlib fileName)))
                            v
                          }
                        })
                      {
                        (let allDecls
                          (timedResolve decls bares fulls mods tcode (pathDir fileName) units
                            phaseT0))
                        {
                          (let eds vecNew)
                          (let ftbl vecNew)
                          {
                            (timedExpand decls allDecls eds ftbl units bares fulls mods)
                            ; The expander's OWN refusals get the frames too.
                            ; They are diagnostics from inside an expansion by
                            ; construction - AX3021, AX3027, AX3028 - and the
                            ; join is the same one MAC-DIAG-4 computes for the
                            ; checker's: a diagnostic anchored at a recorded
                            ; invocation names the macro that was being
                            ; instantiated. Without it a reader of `AX3028
                            ; parallel sequences have different lengths` got a
                            ; span and no macro name, and the two iteration
                            ; constructs disagreed about which span to give.
                            (expAttachFrames eds ftbl units)
                            ; A pass that REFUSED does not hand its output to
                            ; the next one. Expansion's errors used to be
                            ; merged with the checker's, which meant the
                            ; checker ran over a tree expansion had already
                            ; given up on - and on the input that blows the
                            ; expansion budget that tree is deep enough to
                            ; overflow the stack inside `spineArgVec`, so a
                            ; clean AX3024 became a SIGSEGV with no output at
                            ; all (`lldb` put it there; the guard had fired
                            ; correctly and the crash was one pass later).
                            (if (> (countErrorDiags eds) 0)
                              {
                                (writeStderrStr (renderDiagsFormat dfmt (orderDiags eds) units))
                                (writeStderrStr (renderFailTrailer (countErrorDiags eds)))
                                (sysExitWith 1)
                              })
                            ; Diagnostics render in the chosen format; only
                            ; ERRORS refuse to continue. It used to be any
                            ; diagnostic at all, which made a warnings-only
                            ; file exit 1 where stage0 exits 0 - invisible to
                            ; the AXDL gate, which compares bytes, not status
                            ; (probed on 330-axtag-mismatch, 2026-08-07). The
                            ; trailer prints in every format because stage0's
                            ; does; the AXDL gate never saw it because its
                            ; grep keeps only `^[EWNH] ` lines.
                            {
                              (let checked (timedCheck decls allDecls units ftbl pubFns))
                              (let ds (orderDiags (expMergeInto eds checked.diagnostics)))
                              {
                                (if (> (vecLen ds) 0)
                                  (writeStderrStr (renderDiagsFormat dfmt ds units)))
                                (if (> (countErrorDiags ds) 0)
                                  {
                                    (writeStderrStr (renderFailTrailer (countErrorDiags ds)))
                                    (sysExitWith 1)
                                    ""
                                  }
                                  (if (== doEmit 0)
                                    ""
                                    ; The entry point is checked HERE, after
                                    ; the module type-checks and before a
                                    ; byte of IR exists, because the wrapper
                                    ; that calls `__axiom_user_main` is
                                    ; emitted unconditionally: without this,
                                    ; the omission surfaced from `opt` as
                                    ; `use of undefined value`, against a
                                    ; temporary file already deleted, with
                                    ; exit 4 blaming the toolchain.
                                    ;
                                    ; Spanless, because the diagnostic is
                                    ; about the module rather than about any
                                    ; position in it - there is no `main` to
                                    ; point at. The renderer's `--> <file>`
                                    ; form still names the file.
                                    (if (&&
                                          (|| (== needMain 1)
                                            (&& (== doEmit 1)
                                              (hasFlagAnywhere subcommandName "--obfuscate")))
                                          (if (declsHaveMain allDecls)
                                            false
                                            true))
                                      {
                                        (let mds
                                          {
                                            (let v vecNew)
                                            {
                                              (vecPush v
                                                (mkDiag SEV_ERROR "AX4001" "missing-main" 0
                                                  "no `main` function found" None
                                                  (Some
                                                    "add `(:: main ())` and `(fn (main) ...)` as the program entry point")))
                                              v
                                            }
                                          })
                                        {
                                          (writeStderrStr (renderDiagsFormat dfmt mds units))
                                          (writeStderrStr (renderFailTrailer 1))
                                          (sysExitWith 1)
                                          ""
                                        }
                                      }
                                      ; the IR, and - for a build - every
                                      ; `extern` symbol it calls grounded
                                      ; against the link line, reported at
                                      ; the item that declared it
                                      ; `--emit-rust-binding PATH` beside an
                                      ; archive: the Rust view of this file's
                                      ; `pub` surface, written from the same
                                      ; declarations the IR came from
                                      ; `--threads`, or a `__thread_spawn`, on a target with no thread
                                      ; runtime: refused here, before any IR is written, as
                                      ; AX4006. `parThreadsRefused` is codegen's own
                                      ; predicate (`emitPrimPar`'s header says which targets
                                      ; have threads and why), asked here because the
                                      ; emitter cannot report a diagnostic and the driver
                                      ; can.
                                      (if (parThreadsRefused allDecls tcode)
                                        {
                                          (let mds
                                            {
                                              (let v vecNew)
                                              {
                                                (vecPush v
                                                  (mkDiag SEV_ERROR "AX4006" "threads-unsupported"
                                                    0
                                                    (concat
                                                      (if (==
                                                            (declsNamePrim allDecls
                                                              "__thread_spawn" 0)
                                                            1)
                                                        "`__thread_spawn` is named"
                                                        "`--threads` asks for the thread lowering")
                                                      (concat ", and "
                                                        (concat (targetSpelling tcode)
                                                          " has no thread runtime")))
                                                    None
                                                    (Some
                                                      "threads exist on darwin and linux, where a thread is the platform's `pthread_create` and the runtime's globals go thread-local; freebsd links no `libthr` here and windows has no `fork` either. Drop `--threads` to lower `parallel` to processes - which freebsd runs and CI executes there - or build for a target that has threads")))
                                                v
                                              }
                                            })
                                          {
                                            (writeStderrStr (renderDiagsFormat dfmt mds units))
                                            (writeStderrStr (renderFailTrailer 1))
                                            (sysExitWith 1)
                                            ""
                                          }
                                        }
                                        ; AX4007 follows the finished IR. Imported Task
                                        ; declarations may name process primitives even when
                                        ; this program uses only a native command pool. The
                                        ; pruner removes the unsupported trap when no live
                                        ; call reaches it, just as it removes device markers
                                        ; before AX4008 is reported.
                                        {
                                          (let ir
                                            {
                                              (let emitted
                                                (refuseDeviceIr
                                                  (emitBinaryIr (checkedProgramOf checked) bares
                                                    fulls tcode)
                                                  dfmt units))
                                              (if (&& (parSpawnUnsupported allDecls tcode)
                                                    (>=
                                                      (strFindSub emitted
                                                        "\ndefine internal i64 @__axiom_par_unsupported()"
                                                        0)
                                                      0))
                                                (writeStderrStr
                                                  (renderDiagsFormat dfmt
                                                    {
                                                      (let wv vecNew)
                                                      {
                                                        (vecPush wv
                                                          (mkDiag SEV_WARNING "AX4007"
                                                            "parallel-unsupported" 0
                                                            (concat (targetSpelling tcode)
                                                              (if (== (targetHasThreads tcode) 1)
                                                                " has no process lowering: no `fork`, so `__proc_spawn` and its joins trap there"
                                                                " has neither `parallel` lowering: no `fork` and no pthread"))
                                                            None
                                                            (Some
                                                              "the program still builds, with every spawn and join lowered to a trap that prints `axiom: parallel is not available on this target` and exits 79 - so this matters only if the program actually reaches one. Build for a target that can spawn, or keep the `parallel` off the path this target takes")))
                                                        wv
                                                      }
                                                    }
                                                    units)))
                                              emitted
                                            })
                                          {
                                            (if (== needMain 0)
                                              (if (let (Some bp) (flagValue "--emit-rust-binding" 1))
                                                (if (> (strLen bp) 0)
                                                  (if (isErr
                                                        (writeFile bp
                                                          (rustBindingOf decls pubFns fileName)))
                                                    (die
                                                      (concat "error: could not write "
                                                        (concat bp "\n"))
                                                      1)
                                                    ; laid out by `rustfmt` when one is on
                                                    ; PATH, so a checked-in copy is the
                                                    ; formatted one; without it the file is
                                                    ; as generated, and still compiles
                                                    {
                                                      (let _
                                                        (runToolQuiet "rustfmt"
                                                          {
                                                            (let v vecNew)
                                                            {
                                                              (vecPush v "--edition")
                                                              (vecPush v "2021")
                                                              (vecPush v "--quiet")
                                                              (vecPush v bp)
                                                              v
                                                            }
                                                          }))
                                                      (replOut
                                                        (concat "Rust binding written to "
                                                          (concat bp "\n")))
                                                    }))))
                                            (if (== needMain 1)
                                              {
                                                (let grc
                                                  (groundExternsSpanned ir allDecls units dfmt
                                                    (effectiveLinkArgs ir (pathDir fileName)
                                                      linkArgsOf)))
                                                (if (!= grc 0)
                                                  {
                                                    (sysExitWith grc)
                                                    ""
                                                  }
                                                  ir)
                                              }
                                              ir)
                                          }
                                        }))))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ))
          }
        }
      })
  })

; The entry point: the subcommand the first operand names. A first
; operand that names none is an unknown command (`rejectUnknownCommand`),
; and no operand at all prints the usage.
(pub :: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(entropy)
(pub fn (main)
  ; Refuse a malformed invocation BEFORE anything acts on it. This
  ; is what stops `axiom fmt --check=true FILE` and
  ; `axiom fmt FILE --help` from rewriting the file: both used to
  ; reach fmt's write path, because `hasFlag` matched exactly and
  ; `--help` was recognised only at argv[1].
  {
    (let first subcommandName)
    {
      (checkArgs first)
      ; Help the user ASKED for: stdout, exit 0, from anywhere in argv.
      ; `--version`/`-V` is deliberately NOT accepted after a
      ; subcommand - the retired compiler did not propagate it either -
      ; so `axiom run prog.ax -V` forwards `-V` to the program.
      (if (hasFlagAnywhere first "--help")
        {
          (replOut
            (match first
              ((None) usageText)
              ((Some name) (helpForCommand name))))
          (sysExitWith 0)
        }
        (if (hasFlagAnywhere first "-h")
          {
            (replOut
              (match first
                ((None) usageText)
                ((Some name) (helpForCommand name))))
            (sysExitWith 0)
          }))
      (match first
        ((Some command)
          {
            (if (strEq command "symbols")
              symbolsCheckFormat)
            (runSubcommand command)
          }
        )
        ((None)
          (if (isNone (positionalIndex 1))
            (die usageText 1)
            rejectUnknownCommand)
        ))
    }
  })

; ------------------------------------------------------------------
; `axiom test`
; ------------------------------------------------------------------
; WHAT A TEST IS. A top-level function whose name begins with `test`
; and which takes no parameters. Nothing else - no attribute, no
; registration call, no manifest.
;
; THE AXTAG SPELLING WAS TRIED FIRST AND REFUSED, and the reason is
; measured rather than argued. `;@axiom:test` is already a valid,
; silent, `fmt`-stable annotation that `axiom symbols` renders as
; `#test`, so it looked like the mechanism this repository would
; reach for. But an AXTAG attaches to the declaration group, and a
; test is normally two of them - a `::` signature and a `fn` - each
; with its own tag set. `symbols.ax`'s `smTags` kept the LAST
; NON-EMPTY set when this was decided, so
;
;     ;@axiom:test
;     (:: testOne Int)
;
;     ;@axiom:effect(io)
;     (fn (testOne) ...)
;
; reported `#effect=io` and no `#test` at all - probed on 2026-08-25,
; both spellings, and the tag was present only when the two were
; stacked above the `fn`. A test that vanishes because its tag sits
; one declaration too high is a silently skipped test, which reads
; exactly like a passing one. A name cannot be attached to the wrong
; half of anything. (`smTags` unions the two sets since 2026-08-29,
; which closes that loss; the name rule stands as decided - it reads
; no tag, so it has nothing to lose.)
;
; SO NOTHING IS SKIPPED IN SILENCE. The one way the name rule could
; skip something is a `test`-named function that takes parameters -
; a fixture builder called `testData`, say - and that is REFUSED,
; naming the function and its arity, rather than passed over. The
; runner's other half of the same rule is that a file with no tests
; is a failure, not an empty success.
;
; HOW A TEST IS ISOLATED. `axiom test` appends a `main` to the file's
; own bytes and compiles the result. That `main` arms one recovery
; point per test (`docs/error-model.md` ERR-REC-6), so every way an
; Axiom program can stop without returning - a failed assertion,
; which is an unhandled `Assert` operation; an unhandled effect of
; the program's own; an allocation that failed; a division by zero -
; ends ONE test and answers the runner with a status. Measured while
; this was written: a test whose body is `(/ 1 (- 1 1))` reports
; `FAIL ... (status 72)` and the tests on either side of it still
; run.
;
; The generated text is APPENDED, never inserted, so every line and
; column in the file keeps its number and a diagnostic from the build
; points where it would have pointed. What appending cannot keep is
; the file NAME, so the file is CHECKED first, under its own path,
; and the generated driver is built only for a file that has already
; checked clean. The cost is that a file carrying a warning reports
; it twice - once from the check that gives it the right path, once
; from the build - and that is the trade taken deliberately: a
; warning printed twice is a nuisance, an error pointing at a file
; the author never wrote is a bug report.
; Does `hay` contain `needle`? `Str` has no `strContains` and this is
; the only caller in the tree, so it lives here rather than widening
; a standard-library surface three documents would have to describe.
(pub :: testContains (-> String String Bool))
(pub fn (testContains hay needle)
  {
    (let n (strLen hay))
    (let m (strLen needle))
    (if (== m 0)
      true
      ; The match ends the loop by moving the index past its own
      ; bound rather than by negating `found`: Axiom has no `!`,
      ; and `(== found false)` is a comparison of `Bool` against
      ; `Bool` where `==` wants `Int`.
      {
        (let mut i 0)
        (let mut found false)
        {
          (while (<= (+ i m) n)
            {
              (if (strEq (strSlice hay i m) needle)
                {
                  (set found true)
                  (set i n)
                })
              (set i (+ i 1))
            })
          found
        }
      })
  })

; How many parameters a declaration takes, where a `fn` with none has
; an empty list and a node that is not a `fn` has no list at all.
(pub :: testArity (-> ASTNode Int))
(pub fn (testArity d)
  {
    (let p (nodeBChildren d))
    (if (== (as p Int) 0)
      0
      (vecLen p))
  })

; Does the `::` signature declared alongside `d` carry `;@axiom:expect`?
; A linear scan over `decls` by name, the same shape `findFnDecl` scans
; the other direction - this repository has a single digit of tests
; per file, so an index would be machinery for a list that fits on one
; screen.
(pub :: testExpectFailSig (-> (Vec ASTNode) String Int Int))
(pub fn (testExpectFailSig decls name i)
  (if (>= i (vecLen decls))
    0
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_SIG) (strEq (bareOf (nodeAName d)) name))
        (declHasAxtag d "expect")
        (testExpectFailSig decls name (+ i 1)))
    }))

; Is this test tagged `;@axiom:expect`, on either half of its
; declaration? Every fixture in this tree writes the tag directly
; above the `fn`, exactly where `;@axiom:effect(io)` already goes on
; every test that performs one - so the `fn` is checked first. The
; `::` signature is checked too, for the reason `rawTagged` above
; gives for doing the same with `raw`: an AXTAG attaches to one
; declaration group, and a tag one half out of place must not be a
; silently ignored one - this runner's whole discipline is that
; nothing about a test is skipped without saying so.
(pub :: testExpectFail (-> (Vec ASTNode) ASTNode Int))
(pub fn (testExpectFail decls d)
  (if (== (declHasAxtag d "expect") 1)
    1
    (testExpectFailSig decls (bareOf (nodeAName d)) 0)))

; One test record: word 0 is its name, word 1 is 1 when it is tagged
; `;@axiom:expect` and 0 otherwise. A raw two-word block rather
; than a second `Vec`, the same shape `testArgv` below packs an argv
; entry into - one allocation per test, never freed, in a process that
; is about to exec or exit.
(pub :: testMkRec (-> String Int Int))
(pub fn (testMkRec name xfail)
  {
    (let v (memAlloc (* 2 8)))
    {
      (memSetWord v 0 (as name Int))
      (memSetWord v 1 xfail)
      v
    }
  })

; The tests in `decls`, in declaration order, refusing a `test`-named
; function that takes parameters. Each answer is a `testMkRec` block,
; not a bare name, so `testCallLines` below knows which report
; function a test wants without re-scanning `decls` itself.
;
; Declaration order rather than sorted, because a file is read top to
; bottom and a report that reorders makes the reader find each test
; twice.
(pub :: testCollect (-> (Vec ASTNode) String String Ints))
;@axiom:effect(io)
(pub fn (testCollect decls file filter)
  {
    (let out vecNew)
    (let n (vecLen decls))
    {
      (for i in 0..n
        {
          (let d (vecGet decls i))
          (if (&& (== (nodeTag d) TAG_D_FN) (strStartsWith (nodeAName d) "test"))
            (if (> (testArity d) 0)
              (die
                (concat (concat "error: " (concat file " declares `"))
                  (concat (nodeAName d)
                    (concat
                      (concat "`, which begins with `test` and takes "
                        (concat (fmtInt (testArity d)) " parameter(s).\n"))
                      "       A test takes none, so this one would never be run. Rename it,\n       or give it no parameters.\n")))
                1)
              (if (testContains (nodeAName d) filter)
                (vecPush out (testMkRec (nodeAName d) (testExpectFail decls d))))))
        })
      out
    }
  })

; A `setup`/`teardown` hook in `decls`, by exact name. Answers 0
; when no `fn` of that name exists, 1 when one exists and takes no
; parameters, and the arity + 1 otherwise - so the caller refuses a
; hook that takes parameters naming its arity, exactly as
; `testCollect` refuses a `test` that takes parameters. A hook that
; took parameters would never be run correctly, and silently ignoring
; it is the defect this runner exists to prevent.
(pub :: testHookKind (-> (Vec ASTNode) String Int Int))
(pub fn (testHookKind decls want i)
  (if (>= i (vecLen decls))
    0
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN) (strEq (nodeAName d) want))
        (if (> (testArity d) 0)
          (+ (testArity d) 1)
          1)
        (testHookKind decls want (+ i 1)))
    }))

; One `set failed ...` line per test: the report of running it inside
; its own recovery point. A test tagged `expect` calls the
; generated `axiomTestReportXFail` instead of `axiomTestReport`, which
; is the whole of the flipped verdict - which function counts a status
; as a failure is decided once, here, rather than duplicated per call
; site.
;
; When the file declares a `setup` and/or `teardown` hook (zero-argument
; `fn`s of exactly those names, found by `testHookKind`), each test
; runs with the hooks around it inside the same recovery point -
; whichever halves exist. A hook that traps therefore fails
; the test it opened or closed rather than ending the run, and a file
; declaring neither emits exactly what it always emitted.
;
; EACH HOOK IS A BARE NAME, and that is load-bearing rather than
; style: a zero-argument function is invoked bare (`MAC-LANG-3`'s rule
; for macros holds for functions here - `{ side 0 }` calls `side`
; and answers `0`), while juxtaposition inside a brace block IS
; application, so `{ setup 0 testFoo 0 }` reads as one spine and not
; a sequence - measured as AX3004 the first time this was written
; with the hooks applied. `{ setup testFoo teardown 0 }` is three
; calls and the literal answer the recovery point reports.
;
; THE BRACES ARE NOT ESCAPED HERE, and that is worth stating because
; the first version of this escaped them all. A `{` is a HOLE only in
; a string that reaches `println` or `format`; these literals reach
; `concat`, so their bytes are data and a brace is a brace.
; Doubling them compiled, ran, and printed `ok   {name}` five times -
; the generated program was emitting the hole syntax instead of
; interpolating it.
(pub :: testCallLines (-> Ints Int Int String))
(pub fn (testCallLines names hasSetup hasTeardown)
  {
    (let n (vecLen names))
    (let mut out "")
    {
      (for i in 0..n
        {
          (let rec (vecGet names i))
          (let name (memGetWordStr rec 0))
          (let reporter
            (if (== (memGetWord rec 1) 1)
              "axiomTestReportXFail"
              "axiomTestReport"))
          (let head (concat "    (set failed (+ failed (" (concat reporter "\"")))
          (let body
            (if (== hasSetup 1)
              (if (== hasTeardown 1)
                (concat "{ setup " (concat name (concat " " "teardown 0 }")))
                (concat "{ setup " (concat name " 0 }")))
              (if (== hasTeardown 1)
                (concat "{ " (concat name " teardown 0 }"))
                (concat "{ " (concat name " 0 }")))))
          (set out (concat out
                     (concat head
                       (concat name
                         (concat "\" (__axiom_recover __axiom_arena_mark (lambda (__axiomTestArg) "
                           (concat body ")))))\n"))))))
        })
      out
    }
  })

; The source `axiom test` compiles: an IO import, the original source, then a
; `main` that runs each test inside its own recovery point, with the
; file's `setup`/`teardown` hooks around each when `testHookKind`
; found them.
;
; `axiomTestWhy` translates the status the recovery point answers
; with. The three numbers are ERR-REC-6's, spelled out here rather
; than imported, because the generated module must import nothing the
; file under test does not already have - `IO` is the one exception,
; and importing a module twice is not an error.
;
; `axiomTestReportXFail` is `axiomTestReport` with the verdict flipped,
; for a test `testCallLines` found tagged `;@axiom:expect`: status
; 0 is now the failure - the test was expected to fail and did not -
; and every other status is `xfail`, counted as a pass. Both functions
; are generated into every driver, used or not, because which one a
; given call needs is `testCallLines`'s decision and this text has no
; way to omit half of itself conditionally.
(pub :: testDriverText (-> String Ints Int Int String))
(pub fn (testDriverText src names hasSetup hasTeardown)
  (concat (concat "(import IO)\n" (strSlice src (pastBom src 0) (- (strLen src) (pastBom src 0))))
    (concat
      "\n; -----------------------------------------------------------------\n; Generated by `axiom test`. The source above follows the generated import header.\n; -----------------------------------------------------------------\n(:: axiomTestWhy (-> Int String))\n\n(fn (axiomTestWhy status)\n  (if (== status 70)\n    \"out of memory\"\n    (== status 71)\n    \"a failed assertion, or an unhandled effect\"\n    (== status 72)\n    \"division by zero\"\n    \"an abort\"\n  )\n)\n\n(:: axiomTestReport (-> String Int Int))\n\n;@axiom:effect(io)\n(fn (axiomTestReport name status)\n  (if (== status 0)\n    {\n      (println \"ok   {name}\")\n      0\n    }\n    {\n      (let why (axiomTestWhy status))\n      (println \"FAIL {name} - {why} (status {status})\")\n      1\n    }\n  )\n)\n\n(:: axiomTestReportXFail (-> String Int Int))\n\n;@axiom:effect(io)\n(fn (axiomTestReportXFail name status)\n  (if (== status 0)\n    {\n      (println \"FAIL {name} - expected to fail, but passed\")\n      1\n    }\n    {\n      (let why (axiomTestWhy status))\n      (println \"xfail {name} - {why} (status {status}), as expected\")\n      0\n    }\n  )\n)\n\n(:: main Int)\n\n;@axiom:effect(io)\n(fn (main)\n  {\n    (let mut failed 0)\n"
      (concat (testCallLines names hasSetup hasTeardown)
        (concat "    (println \"\")\n    (println \""
          (concat (fmtInt (vecLen names))
            " test(s), {failed} failed\")\n    (if (> failed 0)\n      1\n      0\n    )\n  }\n)\n"))))))

; argv for the test program: its own name and nothing else. `test`
; forwards nothing, because its operand may be a DIRECTORY and there
; would be no one program to forward to.
;
; A RAW BLOCK, not a `Vec`, because that is what `sysRunPath` passes
; to `execve`: a NUL-terminated array of C string addresses. Built as
; a `Vec` of `Str` handles first, this compiled, type-checked and ran
; - and `execve` read the vector header as its first argument
; pointer, failed, and `test` exited 4 with nothing on either stream.
; `runArgv` beside it has the shape this must have.
(pub :: testArgv (-> String Int))
(pub fn (testArgv name)
  {
    (let v (memAlloc (* 2 8)))
    {
      (memSetWord v 0 (strCStr (strDup name)))
      (memSetWord v 1 0)
      v
    }
  })

; Run one file's tests, answering the number of failures - or 1 for a
; file that declares none, which is a failure and not an empty pass.
;
; The generated driver is written BESIDE the file under test, because
; an `(import M)` in it resolves against the entry file's own
; directory first (README, Modules): a driver compiled from a scratch
; directory could not find a module the file next to it imports. The
; name carries this process's pid for the reason `run` and `replEval`
; carry theirs - so two concurrent runs cannot collide - and it is
; unlinked on every path out, including the one where the build
; fails.
(pub :: testRunFile (-> String String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(entropy)
(pub fn (testRunFile file filter)
  {
    (let got (readFile file))
    (let src (unwrapOr got ""))
    (let rerr (sourceReadErrno got))
    (if (!= rerr 0)
      {
        (die (readFailMsg file rerr) 1)
        1
      }
      ; The check comes first so a diagnostic names the file the
      ; author wrote. It exits on any error, exactly as `check` does.
      {
        (let _chk (compileFile file (targetArg hostTarget) 0 0))
        {
          (let pr (parseModuleWith (lex src) (scanAxtags src)))
          (match pr
            ((ParseFailed parseError1)
              {
                (dieParseErr file src (ParseFailed parseError1) diagFormatArg)
                1
              }
            )
            ((ParseSuccess parsedValue1 parsedPos1)
              {
                (let decls parsedValue1)
                {
                  (let names (testCollect decls file filter))
                  (if (== (vecLen names) 0)
                    {
                      (writeStderrStr (concat "axiom test: " (concat file " declares no test\n")))
                      1
                    }
                    ; A `setup`/`teardown` hook that takes parameters is
                    ; refused by name, exactly as a `test` that takes
                    ; parameters is: it would never be run correctly, so
                    ; running the suite without it would be a silent skip.
                    {
                      (let setupKind (testHookKind decls "setup" 0))
                      {
                        (let teardownKind (testHookKind decls "teardown" 0))
                        (if (> setupKind 1)
                          {
                            (die
                              (concat
                                (concat "error: "
                                  (concat file
                                    " declares `setup`, which is the per-test setup hook and takes "))
                                (concat (fmtInt (- setupKind 1))
                                  (concat " parameter(s).\n"
                                    "       A hook takes none, so this one would never be run correctly. Rename it,\n       or give it no parameters.\n")))
                              1)
                            1
                          }
                          (if (> teardownKind 1)
                            {
                              (die
                                (concat
                                  (concat "error: "
                                    (concat file
                                      " declares `teardown`, which is the per-test teardown hook and takes "))
                                  (concat (fmtInt (- teardownKind 1))
                                    (concat " parameter(s).\n"
                                      "       A hook takes none, so this one would never be run correctly. Rename it,\n       or give it no parameters.\n")))
                                1)
                              1
                            }
                            {
                              (let gen
                                (pathJoin (pathDir file)
                                  (concat ".axiom-test." (concat (fmtInt sysPid) ".ax"))))
                              (let text (testDriverText src names setupKind teardownKind))
                              (if (isErr (writeFile gen text))
                                {
                                  (die
                                    (concat "error: could not write the generated test driver to '"
                                      (concat gen "'\n"))
                                    4)
                                  1
                                }
                                {
                                  (let ir (compileFileFrom gen hostTarget 1 1 1))
                                  {
                                    (let base (concat "axiom_test_output." (fmtInt sysPid)))
                                    {
                                      (let exe (concat "./" (concat base (hostExeSuffix))))
                                      {
                                        (let rc
                                          (buildToExecutable ir base (optLevelArg (pathDir file)) 0
                                            (effectiveLinkArgs ir (pathDir file) linkArgsOf)))
                                        (if (!= rc 0)
                                          {
                                            (die "" rc)
                                            1
                                          }
                                          {
                                            (let code (sysRunPath exe (testArgv exe) sysEnvp))
                                            {
                                              (unwrapOr (removeFile exe) 0)
                                              ; `Err` is the spawn failing - the
                                              ; child never ran - which is exit 4,
                                              ; the toolchain code. `Ok` carries
                                              ; whatever the child answered.
                                              (unwrapOr code 4)
                                            }
                                          })
                                      }
                                    }
                                  }
                                })
                            }))
                      }
                    })
                }
              }
            ))
        }
      })
  })

; The value of `--jobs`: how many files a directory run may test at
; once. 1, the sequential run, when the flag is absent.
(pub :: testJobs Int)
;@axiom:effect(io)
(pub fn (testJobs)
  (match (flagValue "--jobs" 1)
    ((None) 1)
    ((Some v)
      (if (== (strLen v) 0)
        1
        (if (let (Some n) (strParseInt v))
          (if (< n 1)
            {
              (die "error: --jobs needs a positive number\n" 2)
              1
            }
            n)
          {
            (die "error: --jobs needs a positive number\n" 2)
            1
          }))
    )))

; Where one file's captured output waits while a parallel run finishes
; the others: beside the file, named with this process's pid, so two
; concurrent runs cannot collide, and unlinked once it is printed.
(pub :: testCapName (-> String String Int String))
;@axiom:effect(io)
(pub fn (testCapName file kind i)
  {
    (let base
      (concat ".axiom-test-cap."
        (concat (fmtInt sysPid) (concat "." (concat (fmtInt i) (concat "." kind))))))
    (pathJoin (pathDir file) base)
  })

; argv for one child of a parallel run: this executable, `test`, the
; file, and the flags that change what a file's run means. `--jobs`
; is not forwarded: the child's target is a file, which runs in
; process either way.
(pub :: testChildArgv (-> String String String Int))
;@axiom:effect(io)
(pub fn (testChildArgv self file filter)
  {
    (let words vecNew)
    {
      (vecPushStr words self)
      (vecPushStr words "test")
      (vecPushStr words file)
      (if (> (strLen filter) 0)
        {
          (vecPushStr words "--filter")
          (vecPushStr words filter)
        })
      (if (let (Some opt) (flagValue "--opt" 1))
        (if (> (strLen opt) 0)
          {
            (vecPushStr words "--opt")
            (vecPushStr words opt)
          }))
      (if (let (Some fmt) (flagValue "--diagnostic-format" 1))
        (if (> (strLen fmt) 0)
          {
            (vecPushStr words "--diagnostic-format")
            (vecPushStr words fmt)
          }))
      {
        (let v (memAlloc (* (+ (vecLen words) 1) 8)))
        {
          (for i in 0..(vecLen words)
            (memSetWord v i (strCStr (strDup (vecGetStr words i)))))
          (memSetWord v (vecLen words) 0)
          v
        }
      }
    }
  })

; Wait for `pid` and answer 0 when it exited 0, 1 otherwise, as
; `sysRun` reads a status.
(pub :: testWaitOne (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (testWaitOne pid)
  (match (sysWaitPid pid)
    ((Err _) 1)
    ((Ok st)
      (if (!= (sysTermSignal st) 0)
        1
        (if (== (sysExitCode st) 0)
          0
          1))
    )))

; This executable's own path, for spawning a child of it: argv[0]
; as written when it contains a slash, and found on `PATH`
; otherwise - `pathOfCommand` answers the directory a name came
; from, not the path itself.
(pub :: testSelfPath String)
;@axiom:effect(io)
(pub fn (testSelfPath)
  {
    (let a0 (sysArg 0))
    (if (let (Some _) (strFindByte a0 47 0))
      a0
      {
        (let dir (pathOfCommand a0))
        (if (> (strLen dir) 0)
          (concat dir a0)
          a0)
      })
  })

; Run every file in `files` with at most `jobs` children at once, and
; answer how many files failed. Each file is run by a child of this
; executable, because compiling a file is this process's own work and
; two compilations cannot share it. The children's output is
; captured per file and printed in name order once all have
; finished, so a parallel run reports exactly what a sequential one
; does, in the same order.
(pub :: testRunFilesParallel (-> Ints String Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (testRunFilesParallel files filter jobs)
  {
    (let n (vecLen files))
    (let self (testSelfPath))
    (let results vecNew)
    (let pids vecNew)
    (let idxs vecNew)
    (let mut next 0)
    (let mut head 0)
    (let mut done 0)
    {
      (while (< (vecLen results) n)
        (vecPush results 1))
      (while (< done n)
        {
          (while (&& (< next n) (< (- next head) jobs))
            {
              (let f (vecGetStr files next))
              {
                (match (sysSpawnOutErrTo (strCStr (strDup self)) (testChildArgv self f filter)
                         sysEnvp (testCapName f "out" next) (testCapName f "err" next))
                  ((Ok pid)
                    {
                      (vecPush pids pid)
                      (vecPush idxs next)
                    }
                  )
                  ((Err _)
                    (set done (+ done 1))
                  ))
                (set next (+ next 1))
              }
            })
          (if (< head (vecLen pids))
            {
              (vecSet results (vecGet idxs head) (testWaitOne (vecGet pids head)))
              (set head (+ head 1))
              (set done (+ done 1))
            })
        })
      {
        (let mut bad 0)
        {
          (for i in 0..n
            {
              (let f (vecGetStr files i))
              {
                (replOut (concat "== " (concat f " ==\n")))
                (replOut (unwrapOr (readFile (testCapName f "out" i)) ""))
                (writeStr stderr (unwrapOr (readFile (testCapName f "err" i)) ""))
                (unwrapOr (removeFile (testCapName f "out" i)) 0)
                (unwrapOr (removeFile (testCapName f "err" i)) 0)
                (if (!= (vecGet results i) 0)
                  (set bad (+ bad 1)))
              }
            })
          bad
        }
      }
    }
  })

; Every `.ax` file directly inside `dir`, in `listDir`'s order, which
; is sorted - so a directory run reports the same order everywhere,
; and the generated drivers a previous run left behind are skipped by
; name rather than compiled as tests of their own.
(pub :: testFilesIn (-> String Ints))
;@axiom:effect(io)
(pub fn (testFilesIn dir)
  {
    (let entries (unwrapOr (listDir dir) vecNew))
    (let out vecNew)
    (let n (vecLen entries))
    {
      (for i in 0..n
        {
          (let name (vecGetStr entries i))
          (if (&& (strEq (pathExt name) ".ax")
                (if (strStartsWith name ".axiom-test.")
                  false
                  true))
            (vecPush out (as (pathJoin dir name) Int)))
        })
      out
    }
  })

; The subcommand: one file, or every `.ax` file directly inside one
; directory.
(pub :: testMain Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(entropy)
(pub fn (testMain)
  {
    (let target (positionalFrom operandStart))
    ; The empty pattern matches every test name, including when no filter is supplied.
    (let filter
      (match (flagValue "--filter" 1)
        ((None) "")
        ((Some value) value)))
    (match target
      ((None) (die "error: test needs a file or a directory\n" 1))
      ((Some target)
        (if (== (strLen target) 0)
          (die "error: test needs a file or a directory\n" 1)
          (if (isDir target)
            {
              (let files (testFilesIn target))
              (if (== (vecLen files) 0)
                (die (concat "error: no `.ax` file in " (concat target "\n")) 1)
                {
                  (let n (vecLen files))
                  (let jobs (testJobs))
                  (let mut bad 0)
                  {
                    (if (|| (<= jobs 1) (== n 1))
                      (for i in 0..n
                        {
                          (let f (vecGetStr files i))
                          {
                            (replOut (concat "== " (concat f " ==\n")))
                            (if (!= (testRunFile f filter) 0)
                              (set bad (+ bad 1)))
                          }
                        })
                      (set bad (testRunFilesParallel files filter jobs)))
                    (replOut
                      (concat "\n"
                        (concat (fmtInt n)
                          (concat " file(s), "
                            (concat (fmtInt bad) (concat " with a failing test" "\n"))))))
                    (if (> bad 0)
                      1
                      0)
                  }
                })
            }
            (testRunFile target filter)))
      ))
  })

; A first operand that is no subcommand is an unknown command: exit 2,
; named, whether or not it names a file. The refusal suggests the
; nearest command when one is within two edits, and otherwise says how
; a file is compiled.
(pub :: rejectUnknownCommand Int)
;@axiom:effect(io)
(pub fn (rejectUnknownCommand)
  {
    (let i (positionalIndex 1))
    (match i
      ((None) 0)
      ((Some i)
        {
          (let w (sysArg i))
          (let near (nearestSubcommand (sysArg i)))
          (usageError
            (concat (concat "error: unknown command `" (concat w "`\n"))
              (if (== (strLen near) 0)
                "       to compile a file, use `axiom emit-llvm FILE [--target TARGET]`, `axiom run FILE` or `axiom build FILE`\n"
                (concat "       did you mean `" (concat near "`?\n")))))
        }
      ))
  })

; `axiom new NAME`: start a project.
;
; NAME/ is made - or reused when it exists and is empty - holding
; Main.ax, the hello-world program, and axiom.pkg carrying
; `name NAME` and `version 0.1.0`. Every refusal names what is
; wrong: no name, a second operand, a NAME no package may carry, a
; project already there, a directory that is not empty, or a write
; that failed.
(pub :: newProjectCmd Int)
;@axiom:effect(io)
(pub fn (newProjectCmd)
  {
    (let p1 (positionalIndex operandStart))
    (match p1
      ((None) (usageError "error: `axiom new` needs a project name\n"))
      ((Some p1)
        {
          (let p2 (positionalIndex (+ p1 1)))
          (match p2
            ((None)
              {
                (let name (sysArg p1))
                (if (pkgNameOk name)
                  (newProject name)
                  (usageError
                    (concat "error: `"
                      (concat name
                        "` is not a package name\n       A package name is letters, digits, `.`, `-` and `_`, and is neither `.` nor `..`.\n"))))
              }
            )
            ((Some p2)
              (usageError
                (concat "error: `axiom new` takes one project name, but `"
                  (concat (sysArg p2) "` was also given\n")))
            ))
        }
      ))
  })

(pub :: newProject (-> String Int))
;@axiom:effect(io)
(pub fn (newProject name)
  {
    (let mf (pathJoin name "axiom.pkg"))
    {
      (let mainf (pathJoin name "Main.ax"))
      (if (fileExists mf)
        (die
          (concat (concat "error: `" name)
            "` already holds an Axiom project (`axiom.pkg` exists)\n")
          1)
        (if (isDir name)
          (if (> (vecLen (unwrapOr (listDir name) vecNew)) 0)
            (die (concat (concat "error: `" name) "` exists and is not empty\n") 1)
            (newProjectWrite name mf mainf))
          (if (isErr (makeDir name))
            (die (concat (concat "error: could not create directory `" name) "`\n") 4)
            (newProjectWrite name mf mainf))))
    }
  })

(pub :: newProjectWrite (-> String String String Int))
;@axiom:effect(io)
(pub fn (newProjectWrite name mf mainf)
  (if (isErr (writeFile mainf newProjectMain))
    (die (concat (concat "error: could not write `" mainf) "`\n") 4)
    (if (isErr (writeFile mf (newProjectManifest name)))
      (die (concat (concat "error: could not write `" mf) "`\n") 4)
      {
        (replOut (concat "Created new Axiom project in `" (concat name "` (Main.ax, axiom.pkg)\n")))
        0
      })))

(pub :: newProjectMain String)
(pub fn (newProjectMain)
  "(import IO)\n\n(:: main ())\n;@axiom:effect(io)\n(fn (main)\n  (println \"Hello from Axiom! 🚀\"))\n")

(pub :: newProjectManifest (-> String String))
(pub fn (newProjectManifest name)
  (concat (concat "name     " (concat name "\nversion  0.1.0\n"))
    "# `depend` names a directory of modules (or a git URL to check out\n# under `.axiom/deps/`), `crate` a native crate directory, `opt` the\n# default optimisation level (0-3) and `main` the entry file.\n# depend  vendor/lib\n# opt     1\n"))

; The manifest-mode entry file for `build` and `run`: the manifest's
; `main` resolved against the manifest's own directory, else `Main.ax`
; beside the nearest manifest at or above the working directory.
; Answers None only when no manifest is around at all - the caller then
; reports its own "needs an input file", so a tree that never had a
; project reads exactly as before. A manifest whose entry is missing
; dies naming the manifest and the file it wants.
(pub :: manifestEntry (Option String))
;@axiom:effect(io)
(pub fn (manifestEntry)
  {
    (let mf (pkgFindManifest ""))
    (match mf
      ((None) None)
      ((Some mf)
        {
          (let f (pkgEntryFile ""))
          (match f
            ((None)
              {
                (die
                  (concat
                    (concat "error: the project manifest `"
                      (concat mf (concat "` names no entry file that exists (want `" "")))
                    (concat "`)"
                      "\n       Set `main` to move it, or write `Main.ax` beside the manifest.\n"))
                  1)
                None
              }
            )
            ((Some f)
              (if (fileExists f)
                (Some f)
                ; `die` answers `Int` and the entry answers `Option String`: an
                ; `if` whose arms disagree is a type error, so the refusal
                ; sequences before None, which it never reaches.
                {
                  (die
                    (concat
                      (concat "error: the project manifest `"
                        (concat mf (concat "` names no entry file that exists (want `" f)))
                      (concat "`)"
                        "\n       Set `main` to move it, or write `Main.ax` beside the manifest.\n"))
                    1)
                  None
                })
            ))
        }
      ))
  })

; `axiom fetch`: check out the manifest's registry dependencies.
;
; For every `depend` URL without a checkout, `git clone`s it and moves
; the finished clone to `.axiom/deps/<key>/` beside the manifest; a
; checkout already there is reported `present` and left alone - but
; only when git records it as cloned from that URL (`pkgOrigin`), and
; anything else there is refused rather than reported. Local `depend`
; directories are not its business - `build` verifies those - and a
; manifest with no URLs answers that there is nothing to fetch. `git`
; missing or a clone failing dies naming both, exit 4, the native-tool
; code.
(pub :: fetchCmd Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (fetchCmd)
  {
    (let p (positionalIndex operandStart))
    (match p
      ((None)
        {
          (let mf (pkgFindManifest ""))
          (match mf
            ((None) (die "error: no axiom.pkg at or above the working directory\n" 1))
            ((Some mf)
              {
                (let text (pkgReadManifest mf))
                {
                  (pkgCheckLines text mf)
                  (fetchUrls (pkgFetchUrls text) (pathDir mf) 0)
                }
              }
            ))
        }
      )
      ((Some p)
        (usageError
          (concat "error: `axiom fetch` takes no operands, but `"
            (concat (sysArg p) "` was given\n")))
      ))
  })

; THE CLONE IS TRANSACTIONAL. This created the checkout directory
; first and cloned into it, so a clone that failed left the directory
; behind - and the next `fetch`, which asked only whether the directory
; existed, printed `present` and exited 0 with nothing checked out
; (measured by an audit: exit 4, then exit 0, on a URL that did not
; exist). Now the clone goes to a sibling named for this process,
; `.axiom/deps/.fetch-<key>-<pid>`, which git creates itself and
; removes itself when the clone fails; only a clone that finished is
; renamed to the key, one rename on one filesystem, so the key's path
; either holds a complete checkout or does not exist. A clone killed
; outright leaves its `.fetch-` directory, which nothing reads as a
; checkout and which names the process that owned it.
(pub :: fetchUrls (-> Names String Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (fetchUrls urls base i)
  (if (>= i (vecLen urls))
    (if (== i 0)
      {
        (replOut "nothing to fetch: no registry dependencies\n")
        0
      }
      0)
    {
      (let url (vecGetStr urls i))
      {
        (let dest (pkgDepCheckout base url))
        (if (isDir dest)
          {
            (let origin (pkgOrigin dest))
            (if (match origin
              ((None) false)
              ((Some recorded) (strEq recorded url)))
              {
                (replOut (concat "present " (concat dest "\n")))
                (fetchUrls urls base (+ i 1))
              }
              (die
                (concat (concat "error: `" (concat dest "` is not a checkout of `"))
                  (concat url
                    (concat (concat "`: " (concat (pkgOriginWhy origin url) ".\n"))
                      "       Remove it and run `axiom fetch` again.\n")))
                4))
          }
          {
            (let deps (concat (pathWithSlash base) ".axiom/deps"))
            (let tmp
              (concat (concat (pathWithSlash base) ".axiom/deps/.fetch-")
                (concat (pkgDepKey url) (concat "-" (fmtInt sysPid)))))
            {
              (replOut (concat "fetching " (concat dest "\n")))
              (if (!= (mkdirParents deps) 0)
                (die (concat (concat "error: could not create directory `" deps) "`\n") 4)
                {
                  (let rc (fetchClone url tmp))
                  (match rc
                    ((Err _)
                      (die "error: `git` was not found on PATH; install git and try again\n" 4)
                    )
                    ((Ok rc)
                      (if (!= rc 0)
                        {
                          (match (fetchDiscard tmp)
                            ((Ok _) ())
                            ((Err _) ()))
                          (die
                            (concat (concat "error: cloning `" url)
                              (concat "` failed (git exited "
                                (concat (fmtInt rc) "); nothing was checked out\n")))
                            4)
                        }
                        (if (isErr (renamePath tmp (pkgStripSlash dest)))
                          {
                            (match (fetchDiscard tmp)
                              ((Ok _) ())
                              ((Err _) ()))
                            (die
                              (concat "error: the clone finished but could not be moved to `"
                                (concat dest "`\n"))
                              4)
                          }
                          (fetchUrls urls base (+ i 1))))
                    ))
                })
            }
          })
      }
    }))

; Remove this fetch's own temporary clone, if git left one. Only ever
; called with the `.fetch-<key>-<pid>` path this process chose, so it
; cannot reach a checkout or anything else under the manifest.
(pub :: fetchDiscard (-> String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (fetchDiscard tmp)
  (if (isDir tmp)
    {
      (let args vecNew)
      {
        (vecPush args "-rf")
        (vecPush args tmp)
        (runTool "rm" args)
      }
    }
    (Ok 0)))

; `git clone URL DEST`, keeping the child exit code in Ok and an
; OS launch or wait failure in Err, as runTool does.
(pub :: fetchClone (-> String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (fetchClone url dest)
  {
    (let args vecNew)
    {
      (vecPush args "clone")
      (vecPush args url)
      (vecPush args dest)
      (runTool "git" args)
    }
  })

; Every directory on the way to `path`, itself included: `git clone`
; needs the parent to exist and the manifest's `.axiom/deps/` rarely
; does on a fresh checkout. Answers 0; an intermediate that exists
; is not an error, anything else is.
(pub :: mkdirParents (-> String Int))
;@axiom:effect(io)
(pub fn (mkdirParents path)
  (mkdirPrefixes (pkgStripSlash path) 0))

(pub :: mkdirPrefixes (-> String Int Int))
;@axiom:effect(io)
(pub fn (mkdirPrefixes path i)
  (if (>= i (strLen path))
    (mkdirOne path)
    (if (== (strByte path i) 47)
      {
        (let rc (mkdirOne (strSlice path 0 i)))
        (if (!= rc 0)
          rc
          (mkdirPrefixes path (+ i 1)))
      }
      (mkdirPrefixes path (+ i 1)))))

(pub :: mkdirOne (-> String Int))
;@axiom:effect(io)
(pub fn (mkdirOne dir)
  ; `strDup` before `strCStr`: a prefix is a SLICE sharing its bytes
  ; with the whole path and stopping at no NUL, so the raw pointer
  ; would name garbage past the slice - `fillArgv` in driver.ax
  ; copies for the same reason.
  (if (== (strLen dir) 0)
    0
    (if (isDir dir)
      0
      (if (isErr (makeDir dir))
        (if (isDir dir)
          0
          1)
        0))))

(pub :: runSubcommand (-> String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(entropy)
(pub fn (runSubcommand cmd)
  ; `doc` lives in doc.ax and takes the whole command line itself.
  (if (strEq cmd "doc")
    docMain
    (if (|| (strEq cmd "help") (|| (strEq cmd "--help") (strEq cmd "-h")))
      ; `axiom help build` answers for `build`. The operand used to be
      ; read and discarded, so it printed the general usage - while the
      ; COMMANDS block promised `help <COMMAND>` would do this. A usage
      ; text that documents behaviour the binary does not have is the
      ; same defect as a diagnostic code nothing constructs.
      ;
      ; An operand that names no command falls back to the general
      ; usage rather than failing: `help` is where someone goes when
      ; they are already lost, and refusing them there is unkind.
      {
        (let topic (positionalFrom operandStart))
        {
          (replOut
            (match topic
              ((None) usageText)
              ((Some name)
                (if (isSubcommand name)
                  (helpForCommand name)
                  usageText)
              )))
          0
        }
      }
      (if (|| (strEq cmd "version") (|| (strEq cmd "--version") (strEq cmd "-V")))
        ; The version says what was PROMISED; the build id says what
        ; was built. Two builds of two different trees at one version
        ; were indistinguishable here until 2026-08-25 - see
        ; `core/build.ax` for why the id is a literal, and
        ; `scripts/build-stamped.sh` for what rewrites it.
        {
          (replOut
            (concat (concat "Axiom " axiomVersion) (concat (concat " (build " axiomBuildId) ")\n")))
          0
        }
        (if (strEq cmd "check")
          {
            (let f inputOperand)
            (match f
              ((None) (die "error: check needs an input file\n" 1))
              ((Some f)
                (if (== (strLen f) 0)
                  (die "error: check needs an input file\n" 1)
                  {
                    (compileFile f (targetArg hostTarget) 0 0)
                    ; stage0's check prints `OK` on stdout whenever it does
                    ; not fail - success and warnings-only alike, in every
                    ; diagnostic format (probed 2026-08-07). compileFile
                    ; exits on errors, so reaching here IS the OK path.
                    (replOut "OK\n")
                    0
                  })
              ))
          }
          (if (strEq cmd "emit-llvm")
            {
              (let f inputOperand)
              (match f
                ((None) (die "error: emit-llvm needs an input file\n" 1))
                ((Some f)
                  (if (== (strLen f) 0)
                    (die "error: emit-llvm needs an input file\n" 1)
                    ; `--output` is read as well as `-o`. Only `-o` used to be,
                    ; so `axiom emit-llvm f.ax --output out.ll` silently ignored
                    ; the flag, put 57 KB of IR on the terminal, and exited 0 -
                    ; a build script cannot detect that, because nothing failed.
                    {
                      (let ir (compileFile f (targetArg hostTarget) 1 0))
                      (let out
                        (match (flagValue "-o" 1)
                          ((None) (flagValue "--output" 1))
                          ((Some value)
                            (if (> (strLen value) 0)
                              (Some value)
                              (flagValue "--output" 1))
                          )))
                      (match out
                        ((None)
                          {
                            (replOut ir)
                            0
                          }
                        )
                        ((Some out)
                          (if (== (strLen out) 0)
                            {
                              (replOut ir)
                              0
                            }
                            (if (isErr (writeFile out ir))
                              (die
                                (concat "error: could not write LLVM IR to '" (concat out "'\n")) 4)
                              {
                                (replOut (concat "LLVM IR written to " (concat out "\n")))
                                0
                              }))
                        ))
                    })
                ))
            }
            (if (strEq cmd "build")
              ; `--input`/`--output` are stage0's spelling. A bare positional is
              ; accepted for `--input` too, because a compiler that insists on a
              ; flag for the one argument it always needs is a compiler people
              ; wrap in a shell script.
              ; With no FILE the project's entry builds instead: the
              ; manifest's `main`, else `Main.ax` beside the nearest
              ; `axiom.pkg` - and the executable takes the manifest's
              ; `name` through the default below, so `axiom build` with
              ; nothing else writes `<name>` in the working directory.
              {
                (let inp
                  (match inputOperand
                    ((None) manifestEntry)
                    ((Some value)
                      (if (> (strLen value) 0)
                        (Some value)
                        manifestEntry)
                    )))
                (match inp
                  ((None) (die "error: build needs an input file\n" 1))
                  ((Some inp)
                    (if (== (strLen inp) 0)
                      (die "error: build needs an input file\n" 1)
                      ; `-o` is the short form of `--output` here as well as under
                      ; `emit-llvm`. It used to be read only by `emit-llvm`, so
                      ; `axiom build -o prog f.ax` consumed `prog` as a flag value
                      ; and wrote the default `output` instead - while the usage
                      ; text listed `-o <PATH>` with no qualification. A flag the
                      ; help documents and the binary ignores is the same defect
                      ; as a diagnostic code nothing constructs.
                      ;
                      ; The retired compiler made `-o` the short form of `--opt`
                      ; under `build` and of `--output` under `emit-llvm`. That is
                      ; a wart rather than a contract, and it is not reproduced:
                      ; one letter meaning two unrelated things across sibling
                      ; subcommands is how a build script writes its executable to
                      ; a file named `3`.
                      ; a static archive needs no `main` and links nothing: its
                      ; externs, if any, are grounded when the HOST links
                      ; THE DEFAULT IS THE PACKAGE'S NAME, since 2026-08-31.
                      ; `axiom.pkg`'s `name` was parsed, recorded, and read by
                      ; nothing - which made it indistinguishable from a typo
                      ; and made every project on the machine build to a file
                      ; called `output`. It is now what `build` writes when
                      ; neither `--output` nor `-o` says otherwise, and the
                      ; literal `output` is what a tree with no manifest
                      ; still gets, so nothing that never had one changes.
                      ;
                      ; The name is a FILE name, in the working directory,
                      ; exactly where `output` was written - not a path
                      ; beside the manifest. Two things hold that: `pkgVerify`
                      ; exits 3 on a `name` that is not one, from inside
                      ; `compileFile` below and therefore before any write;
                      ; and `pkgNameOk` admits no `/` and no `..`, so the
                      ; string bound here could not name another directory
                      ; even if the verification were removed.
                      {
                        (let outp
                          (match (match (flagValue "--output" 1)
                            ((None) (flagValue "-o" 1))
                            ((Some value)
                              (if (> (strLen value) 0)
                                (Some value)
                                (flagValue "-o" 1))
                            ))
                            ((None)
                              {
                                (let nm (pkgName (pathDir inp)))
                                (match nm
                                  ((None) "output")
                                  ((Some nm)
                                    (if (> (strLen nm) 0)
                                      nm
                                      "output")
                                  ))
                              }
                            )
                            ((Some value)
                              (if (> (strLen value) 0)
                                value
                                {
                                  (let nm (pkgName (pathDir inp)))
                                  (match nm
                                    ((None) "output")
                                    ((Some nm)
                                      (if (> (strLen nm) 0)
                                        nm
                                        "output")
                                    ))
                                })
                            )))
                        {
                          (let ir
                            (compileFile inp (targetArg hostTarget) 1
                              (if (hasFlagAnywhere (Some cmd) "--emit-staticlib")
                                0
                                1)))
                          {
                            (let rc
                              (buildToExecutable ir outp (optLevelArg (pathDir inp))
                                (if (hasFlagAnywhere (Some cmd) "--emit-llvm")
                                  1
                                  0)
                                (effectiveLinkArgs ir (pathDir inp) linkArgsOf)))
                            (if (!= rc 0)
                              (die "" rc)
                              ; A successful build used to print NOTHING, so a
                              ; user could not tell it from a no-op, and had to
                              ; go looking for the file to find out. The retired
                              ; compiler also printed `[1/5] Lexing...` and four
                              ; more phase labels; those are not reproduced -
                              ; they are content-free, they numbered one step
                              ; twice whenever the entry file had imports, and
                              ; `run` inherited them onto stdout in front of the
                              ; program's own output.
                              {
                                (if (hasFlagAnywhere (Some cmd) "--emit-llvm")
                                  (replOut (concat "LLVM IR written to " (concat outp ".ll\n"))))
                                (replOut (concat "Build successful: " (concat outp "\n")))
                                0
                              })
                          }
                        }
                      })
                  ))
              }
              (if (strEq cmd "fmt")
                runFormatter
                (if (strEq cmd "symbols")
                  ; `symbols [--builtins] FILE`: one AXSYM line per fact on
                  ; stdout, diagnostics on stderr - and EVERY failure is exit 1,
                  ; stage0's rule for this subcommand, where `check` distinguishes
                  ; parse (2) from semantic (1) failures. `dieImport` applies the
                  ; same folding for unresolvable imports by inspecting argv.
                  {
                    (let f inputOperand)
                    (let dfmt diagFormatArg)
                    (match f
                      ((None) (die "error: symbols needs an input file\n" 1))
                      ((Some f)
                        (if (== (strLen f) 0)
                          (die "error: symbols needs an input file\n" 1)
                          {
                            (let got (readFile f))
                            {
                              (let src (unwrapOr got ""))
                              (let rerr (sourceReadErrno got))
                              (if (!= rerr 0)
                                (die (readFailMsg f rerr) 1)
                                ; An AXIR record file re-emits and exits here;
                                ; anything else is a source to compile. The
                                ; binding is in the same list rather than a
                                ; wrapping `let` so that this arm's paren
                                ; depth does not move.
                                {
                                  (let _ax (symbolsAxirReadBack src))
                                  (let pr (parseModuleWith (lex src) (scanAxtags src)))
                                  (match pr
                                    ((ParseFailed parseError2)
                                      (dieParseErr f src (ParseFailed parseError2) dfmt)
                                    )
                                    ((ParseSuccess parsedValue2 parsedPos2)
                                      ; `symbols` type-checks to get the types it
                                      ; prints, so it expands first for the same
                                      ; reason `check` does. A listing tool that
                                      ; disagreed with `check` about whether a
                                      ; file is well-formed is the drift this
                                      ; repository names most often.
                                      ; `expandProgram` ANSWERS the generated-
                                      ; declaration table, which `symbols` spends
                                      ; on `#generated=` (MAC-TOOL-4).
                                      ; Expansion refused: do not type-check what
                                      ; it gave up on. `compileFile` says why.
                                      ; Warnings do not gate: stage0 prints
                                      ; them to stderr and emits the full
                                      ; list with exit 0. Only an E line
                                      ; empties stdout and fails.
                                      {
                                        (let decls parsedValue2)
                                        (let tcode (checkedTargetCode (targetArg hostTarget)))
                                        (let bares vecNew)
                                        (let fulls vecNew)
                                        (let mods vecNew)
                                        {
                                          (let units
                                            {
                                              (let v vecNew)
                                              {
                                                (vecPush v
                                                  (CUnit2
                                                    :file f
                                                    :src src
                                                    :name None
                                                    :imports vecNew
                                                    :library (pathInStdlib f)))
                                                v
                                              }
                                            })
                                          {
                                            (let allDecls
                                              (resolveImportsParallel decls bares fulls mods tcode
                                                (pathDir f) units))
                                            {
                                              (let ftbl vecNew)
                                              (let eds vecNew)
                                              {
                                                (let gens
                                                  (expandProgram decls allDecls eds ftbl units
                                                    bares fulls mods))
                                                {
                                                  (let _stop
                                                    (if (> (countErrorDiags eds) 0)
                                                      {
                                                        (writeStderrStr
                                                          (renderDiagsFormat dfmt (orderDiags eds)
                                                            units))
                                                        (sysExitWith 1)
                                                        0
                                                      }
                                                      0))
                                                  {
                                                    (let tc (checkModuleTc decls allDecls units))
                                                    {
                                                      (let ds
                                                        (orderDiags
                                                          (expMergeInto eds
                                                            (attachTcFrames decls tc ftbl units))))
                                                      (if (> (countErrorDiags ds) 0)
                                                        ; A SYMBOL TABLE IS A FACT ABOUT THE
                                                        ; SOURCE, so it is printed here too.
                                                        ;
                                                        ; This used to print the diagnostics
                                                        ; and exit with stdout EMPTY, which is
                                                        ; the moment a reader most needs to see
                                                        ; what the declarations are: the file is
                                                        ; wrong and they are working out why.
                                                        ; Every language server answers
                                                        ; `documentSymbol` for a file that does
                                                        ; not compile, and `tc` is already built
                                                        ; by the line above - the table was
                                                        ; being thrown away, not spared.
                                                        ;
                                                        ; `docs/agent-harness.md` §6 names this
                                                        ; as the second of two reasons `AX3010`
                                                        ; cannot be promoted to an error:
                                                        ; making a wrong tag fatal would delete
                                                        ; the AXSYM surface for exactly the
                                                        ; files carrying one. It does not any
                                                        ; more.
                                                        ;
                                                        ; THE EXIT STATUS DOES NOT MOVE. It is
                                                        ; still 1, so
                                                        ; `check-tools-selfhost.sh`'s
                                                        ; equivalence - symbols exits 0 for
                                                        ; exactly the files check exits 0 for -
                                                        ; is untouched. What changed is stdout,
                                                        ; which that check reads separately.
                                                        {
                                                          (symbolsEmit tc gens cmd dfmt)
                                                          (writeStderrStr
                                                            (renderDiagsFormat dfmt ds units))
                                                          (sysExitWith 1)
                                                          1
                                                        }
                                                        {
                                                          (if (> (vecLen ds) 0)
                                                            (writeStderrStr
                                                              (renderDiagsFormat dfmt ds units)))
                                                          (symbolsEmit tc gens cmd dfmt)
                                                          0
                                                        })
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    ))
                                })
                            }
                          })
                      ))
                  }
                  (if (strEq cmd "explain")
                    ; `explain [CODE] [--list]`: the texts live in explain.ax,
                    ; generated byte-for-byte from stage0's own output. `--list`
                    ; wins over a code; a bare `explain` adds the usage trailer;
                    ; an unknown code is two stderr lines and exit 1, echoing the
                    ; code AS TYPED, before normalisation.
                    {
                      (let code (positionalFrom operandStart))
                      (match code
                        ((None)
                          {
                            (replOut explainListColored)
                            (if (&& true
                                  (if (hasFlagAnywhere (Some cmd) "--list")
                                    false
                                    true))
                              (replOut "\nUsage: axiom explain <CODE>\n"))
                            0
                          }
                        )
                        ((Some code)
                          (if (|| (hasFlagAnywhere (Some cmd) "--list") (== (strLen code) 0))
                            {
                              (replOut explainListColored)
                              (if (&& (== (strLen code) 0)
                                    (if (hasFlagAnywhere (Some cmd) "--list")
                                      false
                                      true))
                                (replOut "\nUsage: axiom explain <CODE>\n"))
                              0
                            }
                            ; A word of the language answers from the
                            ; lexicon when no diagnostic code matches:
                            ; `axiom explain let`, and `axiom explain
                            ; @restrict` for an AXTAG key.
                            {
                              (let text (explainText (explainNormalize code)))
                              (if (== (strLen text) 0)
                                {
                                  (let lex (explainLexicon code))
                                  (if (== (strLen lex) 0)
                                    {
                                      (writeStderrStr
                                        (concat "error: unknown diagnostic code or word '"
                                          (concat code "'\n")))
                                      (writeStderrStr
                                        "run `axiom explain --list` to see all known codes, or name a keyword, type, effect or `@tag`\n")
                                      (sysExitWith 1)
                                      1
                                    }
                                    {
                                      (replOut lex)
                                      0
                                    })
                                }
                                {
                                  (replOut text)
                                  0
                                })
                            })
                        ))
                    }
                    (if (strEq cmd "repl")
                      (replMain
                        (if (hasFlagAnywhere (Some cmd) "--no-banner")
                          1
                          0))
                      (if (strEq cmd "lsp")
                        ; The language server speaks JSON-RPC over stdin/stdout, so it
                        ; takes no operand and prints nothing else to stdout - anything
                        ; else written there would be read by the client as a frame.
                        lspMain
                        (if (strEq cmd "run")
                          ; With no FILE the project's entry runs instead -
                          ; and a bare operand is always a FILE, never an
                          ; argument, so program arguments follow `--` in
                          ; manifest mode (`axiom run -- --port 8080`).
                          {
                            (let f runInputOperand)
                            (match f
                              ((None) (die "error: run needs an input file\n" 1))
                              ((Some f)
                                (if (== (strLen f) 0)
                                  (die "error: run needs an input file\n" 1)
                                  ; Unlike stage0, `run` optimises. stage0 pins its `run` at
                                  ; --opt 0, which is survivable for a small program and is
                                  ; not for this compiler: without `opt`'s tail-call pass a
                                  ; stage2 compiling its own source overflows its stack. A
                                  ; `run` that cannot run the compiler is a `run` that fails
                                  ; on the largest Axiom program there is.
                                  ; The scratch name carries this process's pid, the way
                                  ; `replEval` names its own (repl.ax) and for the reason
                                  ; `sysPid` is documented with in `Sys.ax`: "so two
                                  ; concurrent processes cannot collide".
                                  ;
                                  ; It used to be the fixed literal `axiom_temp_output` in
                                  ; the working directory, and `buildToExecutable` derives
                                  ; `<name>.ll`, `<name>.o` and `<name>.opt.ll` from it - so
                                  ; two `axiom run`s in one directory wrote over each
                                  ; other's intermediates and each unlinked the other's.
                                  ; That does not present as a collision; it presents as a
                                  ; miscompile, because what fails is a later stage reading
                                  ; a file some other process already replaced or removed.
                                  ;
                                  ; Measured the hard way rather than reasoned about: probe
                                  ; programs run from the repository root while a gate
                                  ; battery was running there returned uniformly wrong exit
                                  ; codes, and running them from a scratch directory fixed
                                  ; it with no other change.
                                  ;
                                  ; `buildToExecutable` needs no such change: its
                                  ; intermediates already track `--output`, so two builds
                                  ; collide only when they were asked for the same output,
                                  ; which collides on the executable regardless.
                                  ;
                                  ; The optimisation level is `optLevelArg`, the same one
                                  ; `build` passes. It was the literal `1` until 2026-08-24,
                                  ; so `--opt` was accepted here, validated here, and then
                                  ; discarded - `axiom run --opt 0 p.ax` and `--opt 3` both
                                  ; built at `-O1`. Two documents said otherwise: OPTIONS
                                  ; lists `--opt <0-3>` against "build, run", and `axiom
                                  ; help run` prints it as a flag of this command.
                                  ;
                                  ; Measured on the one shape the level is known to move,
                                  ; MM-EXEC-6c's mutual tail call, which is flattened only
                                  ; at `--opt 1` and above: two functions calling each other
                                  ; 2,000,000 deep. Before, `--opt 0` and `--opt 3` both
                                  ; exited 1 - the answer - because both were `-O1`. After,
                                  ; `--opt 0` exits 139 on a stack it really did overflow
                                  ; and `--opt 3` still exits 1. The flag now selects
                                  ; something rather than being validated and dropped.
                                  ;
                                  ; `--target` is deliberately NOT threaded through: the
                                  ; next thing this command does is execute what it built,
                                  ; and a foreign binary does not run here. `build` is where
                                  ; a cross-target artefact is asked for.
                                  {
                                    (let ir (compileFile f hostTarget 1 1))
                                    {
                                      (let base (concat "axiom_temp_output." (fmtInt sysPid)))
                                      {
                                        (let exe (concat "./" (concat base (hostExeSuffix))))
                                        {
                                          (let rc
                                            (buildToExecutable ir base (optLevelArg (pathDir f)) 0
                                              (effectiveLinkArgs ir (pathDir f) linkArgsOf)))
                                          (if (!= rc 0)
                                            (die "" rc)
                                            {
                                              (let code (sysRunPath exe (runArgv exe) sysEnvp))
                                              {
                                                (unwrapOr (removeFile exe) 0)
                                                ; `Err` means the child never
                                                ; ran: exit 4, the toolchain
                                                ; code. `Ok` is its answer.
                                                (sysExitWith (unwrapOr code 4))
                                                0
                                              }
                                            })
                                        }
                                      }
                                    }
                                  })
                              ))
                          }
                          (if (strEq cmd "test")
                            ; `test` sits beside `run` because it is one:
                            ; it compiles a program and executes it. What
                            ; it does not share is `run`'s argument
                            ; forwarding - see `testArgv`.
                            testMain
                            (if (strEq cmd "new")
                              newProjectCmd
                              (if (strEq cmd "fetch")
                                fetchCmd
                                (die "error: unknown subcommand\n" 1)))))))))))))))))

; `axiom explain --list`, coloured the way stage0's did it: the heading
; bold bright cyan, every `AXnnnn` bright yellow, the title and slug
; plain. stage0 used the `colored` crate for this and ariadne for the
; diagnostics themselves.
;
; Applied as a PASS OVER `explainListText` rather than baked into
; explain.ax, because that file is GENERATED - one cached run of stage0
; per code - and its header says to regenerate it whenever a code is
; added or reworded. Escapes written into it could not survive that.
;
; The code token is found by position, not by search: every listed line
; is two spaces then six characters of code. A line that is not shaped
; that way is passed through untouched, which is what the heading and
; any future blank line are.
(pub :: explainListColored String)
(pub fn (explainListColored)
  {
    (let n (strLen explainListText))
    (let parts vecNew)
    (let mut i 0)
    (let mut first true)
    {
      (while (< i n)
        {
          (let e (lineEndFrom explainListText i))
          {
            (let line (strSlice explainListText i (- e i)))
            {
              (if first
                (vecPush parts (paint SGR_LIST line))
                (if (&& (> (strLen line) 8)
                      (&& (== (strByte line 0) 32)
                        (&& (== (strByte line 1) 32) (== (strByte line 2) 65))))
                  {
                    (vecPush parts "  ")
                    (vecPush parts (paint SGR_CODE (strSlice line 2 6)))
                    (vecPush parts (strSlice line 8 (- (strLen line) 8)))
                  }
                  (vecPush parts line)))
              (set first false)
              (if (< e n)
                (vecPush parts "\n"))
              (set i (+ e 1))
            }
          }
        })
      (catStrs parts)
    }
  })

; The input file: `--input`, or a bare positional.
;
; `build` accepted both from the start; `check`, `emit-llvm` and `run`
; accepted only the positional - while the global validator pairs
; `--input` with the argument after it for EVERY subcommand, because
; `flagArity` is one table. So `axiom emit-llvm --input f.ax` consumed
; the filename as a flag value, found no positional, and reported
; "emit-llvm needs an input file" at exit 1: the same data-loss shape as
; `build -o PATH` writing to `output` did.
;
; The usage text called `--input` build-only, and that is a distinction
; nothing in the validator can enforce - per-subcommand flag OWNERSHIP
; was measured and dropped, because it would have flipped five
; check-driver assertions while fixing nothing a user can see. Accepting
; the flag wherever a file is expected is the weaker rule that kills the
; class, and it is what the usage text now says.
;
; These subcommands read one file. A second operand, or an operand
; beside `--input`, is a usage error with status 2: answering for the
; first file alone would read to a script as every named file passing.
; The operand walk skips each flag's value by `flagArity`, so
; `symbols --target linux-aarch64 f.ax` reads `f.ax`, not the target.
(pub :: inputOperand (Option String))
;@axiom:effect(io)
(pub fn (inputOperand)
  {
    (let supplied (flagValue "--input" 1))
    (let selected
      (match supplied
        ((None) None)
        ((Some value)
          (if (> (strLen value) 0)
            (Some value)
            None)
        )))
    (let p (positionalIndex operandStart))
    (let extra
      (if (isSome selected)
        p
        (match p
          ((None) None)
          ((Some index) (positionalIndex (+ index 1))))))
    (if (let (Some index) extra)
      (usageError
        (concat "error: unexpected operand `"
          (concat (sysArg index) "`: this command reads one input file\n"))))
    (match selected
      ((Some value) (Some value))
      ((None)
        (match p
          ((None) None)
          ((Some index) (Some (sysArg index))))
      ))
  })

; `run`'s input file, which is deliberately NOT `inputOperand`.
;
; `run` is the one subcommand whose argv has a SECOND owner: everything
; from the script name onward belongs to the program, and `runArgv`
; already forwards exactly that range. `inputOperand` did not agree with
; it, because `flagValue` scans the whole of argv for `--input` with no
; idea where the compiler's own arguments stop. So
;
;   axiom run prog.ax --input other.ax
;
; compiled and ran `other.ax` while handing `prog.ax` nothing - a
; silently different program, at exit 0 - and `--` did not stop it,
; since that scan never looked for one. Found 2026-08-16.
;
; A program that forwards its own arguments cannot be asked to avoid
; this compiler's flag spellings, so the rule is positional: if a bare
; operand is present it IS the file, and nothing after it is read as a
; compiler flag. `--input` still names the file when no operand does,
; which is the `axiom run --input prog.ax` spelling and leaves nothing
; after it that could have been a program argument.
; `scripts/check-driver.sh` pins both, numerically: the two probe
; programs answer different numbers, so the exit status IS which file
; the compiler chose.
;
; With neither spelling naming a file, the project's entry runs
; instead (`runManifestMode`): the manifest's `main`, else `Main.ax`
; beside the nearest manifest - and a bare operand after `--` is a
; PROGRAM argument there, never a file, so `axiom run -- --port`
; runs the project with `--port` rather than reading a file of
; that name.
(pub :: runInputOperand (Option String))
;@axiom:effect(io)
(pub fn (runInputOperand)
  (if runManifestMode
    manifestEntry
    (match (positionalIndex operandStart)
      ((None) (flagValue "--input" 1))
      ((Some index) (Some (sysArg index))))))

; Manifest mode: no `--input`, and no bare operand outside `--`'s
; reach. A bare operand anywhere before `--` - or with no `--` at
; all - is a FILE, exactly as it always was; only its absence hands
; the choice to the manifest.
(pub :: runManifestMode Bool)
;@axiom:effect(io)
(pub fn (runManifestMode)
  {
    (let explicit
      (match (flagValue "--input" 1)
        ((None) false)
        ((Some value) (> (strLen value) 0))))
    (if explicit
      false
      (match (positionalIndex operandStart)
        ((None) true)
        ((Some p)
          (match (dashDashIndex operandStart)
            ((None) false)
            ((Some dd) (> p dd)))
        )))
  })

; argv for the program `run` spawns: its own name, then every argument
; that followed the source file.
;
; It used to be the name and nothing else, so `axiom run prog.ax a b`
; started prog.ax with argc 1 and the arguments silently dropped - a
; program that reads argv could not be run with any at all. The
; retired compiler forwarded them, and its `Run { input, args }` is
; where the shape comes from.
;
; Everything after the file operand belongs to the PROGRAM, which is
; also why `checkArgs` stops validating there: `axiom run prog.ax
; --verbose` passes `--verbose` on rather than refusing it as a flag
; this compiler does not know. A leading-dash argument that would
; otherwise be ambiguous can be forced across with `--`.
(pub :: runArgv (-> String Int))
;@axiom:effect(io)
(pub fn (runArgv name)
  ; In manifest mode the operands after `--` are PROGRAM arguments -
  ; `runInputOperand` read the first of them as nothing, so starting
  ; past the file operand would drop it. Everything from `--` onward
  ; is forwarded instead (`fillRunArgv` drops the marker itself).
  {
    (let dd (dashDashIndex operandStart))
    (let p (positionalIndex operandStart))
    (let n sysArgc)
    {
      (let extra
        (match p
          ((None) n)
          ((Some index)
            (match dd
              ((None) (+ index 1))
              ((Some separator)
                (if (> index separator)
                  (+ separator 1)
                  (+ index 1))
              ))
          )))
      {
        (let v (memAlloc (* (+ (- n extra) 2) 8)))
        {
          (memSetWord v 0 (strCStr (strDup name)))
          (fillRunArgv v extra n 1)
          v
        }
      }
    }
  })

; Copy argv[from..to) into `v` starting at slot `slot`, NUL-terminated.
;
; `--` is dropped as it passes: it is this compiler's end-of-options
; marker, not an argument the program asked for.
(pub :: fillRunArgv (-> Int Int Int Int Int))
;@axiom:effect(io)
(pub fn (fillRunArgv v from to slot)
  (if (>= from to)
    {
      (memSetWord v slot 0)
      0
    }
    {
      (let a (sysArg from))
      (if (strEq a "--")
        (fillRunArgv v (+ from 1) to slot)
        {
          (memSetWord v slot (strCStr (strDup a)))
          (fillRunArgv v (+ from 1) to (+ slot 1))
        })
    }))

(pub :: die (-> String Int Int))
;@axiom:effect(io)
(pub fn (die msg code)
  {
    (writeStr stderr msg)
    (sysExitWith code)
    code
  })
