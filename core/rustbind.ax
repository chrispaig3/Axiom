; rustbind - the Rust binding of an Axiom archive, generated.
;
; `axiom build --input lib.ax --output libaxiom_lib.a --emit-staticlib
; --emit-rust-binding lib.rs` archives the module (driver.ax) and
; writes, from the entry file's `pub` surface, a Rust source file a
; host includes as a module: one `extern "C"` declaration per function
; under its own symbol, and one safe wrapper per function in Rust's
; own types - `Int` is `i64`, `Float` is `f64` carried as its bits,
; `Bool` is `bool` over 0/1, `Char` is `char` over the code point,
; `String` is `&str` in and `AxString` out (the facade's `host`
; module, which builds the argument with the archive's own
; `Str$strAlloc` and adopts the result), `Handle` and `Foreign` are
; the bare word.
;
; A `data` or `struct` value crosses too. The archive cannot be read
; from outside - only the emitter knows a block's layout - so when the
; binding is requested the compiler SYNTHESISES accessor shims into
; the module after its types are checked (`rbShimSource`, parsed and
; appended by `rbAppendShims`), then checks the combined module: for
; every `pub data`/`pub struct` of the file and every instantiation a
; `pub` signature mentions (`(Option Int)`, `(Result Int String)`,
; `(List Int)` of the file's own `List`),
;
;   axh_<T>_tag v            the constructor's index, declaration order
;   axh_<T>_<Ctor> f0 f1 ..  a fresh value (an owned share)
;   axh_<T>_<Ctor>_<i> v     field i (a reference field: an owned share)
;
; plus `axh_vec_new`/`axh_vec_push`/`axh_vec_len`/`axh_vec_get` for a
; `Vec`, whose ELEMENT type stays on the Axiom side: the handle crosses
; as the `AxWord` it is and the host builds and reads one through
; `AxVecBuf`. The Rust side gets a
; `struct` (one constructor) or `enum` (several, tuple variants) per
; type with `from_axiom`/`to_axiom`, `Option<T>` and `Result<T, E>`
; for the two builtin sums, and wrappers that convert at the boundary.
;
; Ownership across the call is the convention the emitter itself
; follows, read from its IR: an ARGUMENT is borrowed (a callee that
; keeps one retains it - a constructor does), a RESULT is an owned
; share (MM-LIFE-2c event 2: `(pub fn (same s) s)` retains before it
; returns). So the binding passes borrowed words, releases the owned
; words it built, and adopts every result.
;
; What it does not carry it SAYS it does not carry: a function whose
; signature names a type variable, a tuple, an arrow, a list type, or
; a `data` whose fields reach one of those, or a `pub fn` with no
; `(pub :: name Type)` signature, is a `//` comment at the end of the
; file naming the function and the type.
;
; A NAME the Rust side cannot spell goes the same way. Axiom names are
; much wider than Rust's - `isIdentChar` (lexer.ax) admits
; `- ! * + / < > = % & | ' ^` - and written verbatim, `/*` and `*/`
; would let a module comment out a span of this generator's own output.
; `rbIsRustIdent` is the one place that is decided, and a function,
; parameter, type, constructor or field whose name is not
; `[A-Za-z_][A-Za-z0-9_]*` is a note rather than a declaration. The
; generated file is laid
; out as `rustfmt` would lay it out, so a checked-in copy stays
; byte-identical to a fresh generation (`scripts/check-ffi.sh`
; regenerates rust/examples/host/src/hostlib.rs and diffs).
(import Mem)
(import Str)
(import Vec)
(import Path)
(import Sys)
(import lexer)
(import parser)
(import codegen)
(import driver)
(import typecheck (srcSpelling))
(import raw)

; ------------------------------------------------------------------
; The entry's `pub` names, before import resolution rewrites visibility
; ------------------------------------------------------------------
; The names written `pub fn` in the entry file, taken BEFORE import
; resolution: from then on a declaration's visibility word answers
; "may another module name it", which is 1 for everything in the
; entry file (codegen.ax, `resolveDeclsPhase`).
(pub :: rbPubNames (-> Nodes Names))
(pub fn (rbPubNames decls)
  {
    (let out vecNew)
    (let mut i 0)
    {
      (while (< i (vecLen decls))
        {
          {
            (let d (vecGet decls i))
            (if (&& (== (nodeTag d) TAG_D_FN) (== (nodeVis d) 1))
              (vecPush out (nodeAName d))
              out)
          }
          (set i (+ i 1))
        })
      out
    }
  })

(:: rbNamed (-> Names String Bool))
(fn (rbNamed names n)
  {
    (let mut i 0)
    (let mut found false)
    {
      (while (< i (vecLen names))
        {
          (if (strEq (vecGet names i) n)
            (set found true))
          (set i (+ i 1))
        })
      found
    }
  })

; ------------------------------------------------------------------
; Types: what the binding carries, and how each side spells it
; ------------------------------------------------------------------
; The last entry-file data/struct declaration named `name`, when present.
(:: rbDataDecl (-> Nodes String (Option ASTNode)))
(fn (rbDataDecl decls name)
  {
    (let mut i 0)
    (let mut found (:: None (Option ASTNode)))
    {
      (while (< i (vecLen decls))
        {
          {
            (let d (vecGet decls i))
            (if (&& (|| (== (nodeTag d) TAG_D_DATA) (== (nodeTag d) TAG_D_STRUCT))
                  (&& (== (nodeModule d) 0) (strEq (nodeAName d) name)))
              (set found (Some d)))
          }
          (set i (+ i 1))
        })
      found
    }
  })

; The standard Result keeps its public Rust spelling while the checked
; type names the declaration in Err. An entry's own Result is an
; ordinary data type with its own constructors.
(:: rbCarrierName (-> String String))
(fn (rbCarrierName name)
  (if (strEq name "Err$Result")
    "Err_Result"
    name))

(:: rbSourceName (-> String String))
(fn (rbSourceName name)
  (srcSpelling name))

; 1 when `t` is a word leaf: Int, Float, Bool, Char, Handle, Foreign.
(:: rbIsWordLeaf (-> ASTNode Int))
(fn (rbIsWordLeaf t)
  (if (&& (! (nodeSame t nilNode))
        (&& (== (nodeTag t) TAG_T_CON) (== (vecLen (nodeBChildren t)) 0)))
    {
      (let n (nodeAName t))
      (if (|| (strEq n "Int")
            (|| (strEq n "Float")
              (|| (strEq n "Bool")
                (|| (strEq n "Char") (|| (strEq n "Handle") (strEq n "Foreign"))))))
        1
        0)
    }
    0))

(:: rbIsString (-> ASTNode Int))
(fn (rbIsString t)
  (if (&& (! (nodeSame t nilNode))
        (&& (== (nodeTag t) TAG_T_CON)
          (&& (== (vecLen (nodeBChildren t)) 0) (strEq (nodeAName t) "String"))))
    1
    0))

; 1 when `t` is a `Vec`: `(Vec Int)`, `Names`, `(Vec (Vec Int))`.
;
; A `Vec` crosses as its HANDLE WORD and nothing else, whatever it
; holds - the element type is Axiom's business, and the host builds and
; reads one through `AxVecBuf`, which calls the archive's own
; `axh_vec_*` shims. So the binding spells every `Vec` `AxWord` and
; converts in neither direction, exactly as it did while a `Vec` WAS an
; `Int` and this predicate was not needed.
(:: rbIsVec (-> ASTNode Int))
(fn (rbIsVec t)
  (if (&& (! (nodeSame t nilNode)) (&& (== (nodeTag t) TAG_T_CON) (strEq (nodeAName t) "Vec")))
    1
    0))

; 1 when `t` is exactly `(Vec Int)`: the one `Vec` the binding types.
; Its elements are words and every word is a valid `Int`, so a host can
; build one from any slice of `i64` without being able to break it -
; which is not true of a `Names`, whose every element Axiom will
; dereference. Every other `Vec` crosses as the raw word it was.
(:: rbIsIntVec (-> ASTNode Int))
(fn (rbIsIntVec t)
  (if (&& (== (rbIsVec t) 1) (== (vecLen (nodeBChildren t)) 1))
    {
      (let e (vecGet (nodeBChildren t) 0))
      (if (&& (! (nodeSame e nilNode))
            (&& (== (nodeTag e) TAG_T_CON)
              (&& (== (vecLen (nodeBChildren e)) 0) (strEq (nodeAName e) "Int"))))
        1
        0)
    }
    0))

; 1 when handing Axiom a value of type `t` means handing it a RAW WORD
; somewhere - a `Handle`, a `Foreign`, a `Vec` that is not `(Vec Int)`,
; or a data type with a field that reaches one (coinductively, as
; `rbCarried` treats recursion). The binding spells those `AxWord`, and
; an `AxWord` is any `i64` the caller cares to write, so an operation
; that passes one to Axiom is `unsafe` in the generated file: the
; caller has to promise what the type cannot.
(:: rbRawIn (-> (Vec ASTNode) ASTNode Names Int))
(fn (rbRawIn decls t visiting)
  (if (nodeSame t nilNode)
    0
    (if (== (rbIsWordLeaf t) 1)
      {
        (let n (nodeAName t))
        (if (|| (strEq n "Handle") (strEq n "Foreign"))
          1
          0)
      }
      (if (== (rbIsVec t) 1)
        (if (== (rbIsIntVec t) 1)
          0
          1)
        (if (== (rbIsData decls t) 1)
          {
            (let m (rbSpellType t))
            (if (rbNamed visiting m)
              0
              {
                (let cs (rbCtorsOf decls t))
                (let mut raw 0)
                (let mut i 0)
                {
                  (vecPush visiting m)
                  (while (< i (vecLen cs))
                    {
                      {
                        (let tys (rbCtorTys (vecGet cs i)))
                        (let mut k 0)
                        (while (< k (vecLen tys))
                          {
                            (if (== (rbRawIn decls (vecGet tys k) visiting) 1)
                              (set raw 1))
                            (set k (+ k 1))
                          })
                      }
                      (set i (+ i 1))
                    })
                  (vecPop visiting)
                  raw
                }
              })
          }
          0)))))

; 1 when any of `params` passes a raw word to Axiom.
(:: rbAnyRaw (-> (Vec ASTNode) (Vec ASTNode) Int))
(fn (rbAnyRaw decls params)
  {
    (let mut i 0)
    (let mut raw 0)
    {
      (while (< i (vecLen params))
        {
          (if (== (rbRawIn decls (vecGet params i) vecNew) 1)
            (set raw 1))
          (set i (+ i 1))
        })
      raw
    }
  })

; 1 when `t` is a sum or product the binding carries as a value: the
; builtin `Option`/`Result`, or a declaration of the entry file.
(:: rbIsData (-> (Vec ASTNode) ASTNode Int))
(fn (rbIsData decls t)
  (if (&& (! (nodeSame t nilNode)) (== (nodeTag t) TAG_T_CON))
    {
      (let n (nodeAName t))
      (if (|| (strEq n "Option") (strEq n "Err$Result"))
        1
        (if (isSome (rbDataDecl decls n))
          1
          0))
    }
    0))

; One constructor of a data type: its name, its field types
; (instantiated) and, when its fields are named, their names.
(struct RbCtor
  (name : String)
  (tys : (Vec ASTNode))
  (fields : (Option Names)))

; The constructors of the data type `t` (an instantiation): `Option`,
; `Result` and the entry's declarations.
(:: rbCtorsOf (-> (Vec ASTNode) ASTNode (Vec RbCtor)))
(fn (rbCtorsOf decls t)
  {
    (let n (nodeAName t))
    (let args (nodeBChildren t))
    (let out vecNew)
    {
      (if (strEq n "Option")
        {
          (vecPush out (rbCtor "None" vecNew None))
          (vecPush out (rbCtor "Some" (rbVec1 (vecGet args 0)) None))
        }
        (if (strEq n "Err$Result")
          {
            (vecPush out (rbCtor "Ok" (rbVec1 (vecGet args 0)) None))
            (vecPush out (rbCtor "Err" (rbVec1 (vecGet args 1)) None))
          }
          {
            (let d (rbDataDecl decls n))
            (match d
              ((None) ())
              ((Some d)
                (if (== (nodeTag d) TAG_D_STRUCT)
                  ; one constructor, the struct's name, named fields
                  {
                    (let fs (nodeBChildren d))
                    (let tys vecNew)
                    (let names vecNew)
                    (let mut i 0)
                    {
                      (while (< i (vecLen fs))
                        {
                          (vecPush tys (nodeTyChild (vecGet fs i)))
                          (vecPush names (nodeAName (vecGet fs i)))
                          (set i (+ i 1))
                        })
                      (vecPush out (rbCtor n tys (Some names)))
                    }
                  }
                  {
                    (let cs (nodeBChildren d))
                    (let vars (nodeTyNames d))
                    (let mut i 0)
                    (while (< i (vecLen cs))
                      {
                        {
                          (let c (vecGet cs i))
                          (vecPush out
                            (rbCtor (nodeAName c) (rbSubstAll (nodeTyChildren c) vars args)
                              (rbFieldNames c)))
                        }
                        (set i (+ i 1))
                      })
                  })
              ))
          }))
      out
    }
  })

(:: rbCtor (-> String (Vec ASTNode) (Option Names) RbCtor))
(fn (rbCtor name tys fields)
  (RbCtor :name name :tys tys :fields fields))

; A declared constructor's field names, or `None` when its fields are
; positional, which the parser answers as a null vector.
(:: rbFieldNames (-> ASTNode (Option Names)))
(fn (rbFieldNames c)
  {
    (let names (nodeFieldNamesNames c))
    (if (== (as names Int) 0)
      None
      (Some names))
  })

(:: rbCtorName (-> RbCtor String))
(fn (rbCtorName c)
  c.name)

(:: rbCtorTys (-> RbCtor (Vec ASTNode)))
(fn (rbCtorTys c)
  c.tys)

(:: rbCtorNames (-> RbCtor (Option Names)))
(fn (rbCtorNames c)
  c.fields)

(:: rbVec1 (-> ASTNode (Vec ASTNode)))
(fn (rbVec1 x)
  {
    (let v vecNew)
    {
      (vecPush v x)
      v
    }
  })

; A type with the declaration's variables replaced by the
; instantiation's arguments: `(Cons a (List a))` at `(List Int)` is
; `(Cons Int (List Int))`.
(:: rbSubst (-> ASTNode Names (Vec ASTNode) ASTNode))
(fn (rbSubst t vars args)
  (if (nodeSame t nilNode)
    nilNode
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_VAR)
        (match (rbIndexOfName vars (nodeAName t))
          ((None) t)
          ((Some k)
            (if (< k (vecLen args))
              (vecGet args k)
              t)
          ))
        (if (== tag TAG_T_CON)
          (if (== (vecLen (nodeBChildren t)) 0)
            t
            (nodeBuildTConPlain (nodeAText t) (rbSubstAll (nodeBChildren t) vars args) 0))
          (if (== tag TAG_T_ARR)
            (nodeBuildTArrPlain (rbSubst (nodeAChild t) vars args)
              (rbSubst (nodeBChild t) vars args) 0)
            (if (== tag TAG_T_TUP)
              (nodeBuildTTupPlain (rbSubstAll (nodeAChildren t) vars args) 0 0)
              t))))
    }))

(:: rbSubstAll (-> (Vec ASTNode) Names (Vec ASTNode) (Vec ASTNode)))
(fn (rbSubstAll ts vars args)
  {
    (let out vecNew)
    (let mut i 0)
    {
      (if (! (== (as ts Int) 0))
        (while (< i (vecLen ts))
          {
            (vecPush out (rbSubst (vecGet ts i) vars args))
            (set i (+ i 1))
          }))
      out
    }
  })

(:: rbIndexOfName (-> Names String (Option Int)))
(fn (rbIndexOfName names n)
  (if (== (as names Int) 0)
    None
    {
      (let mut i 0)
      (let mut at (:: None (Option Int)))
      {
        (while (&& (< i (vecLen names)) (isNone at))
          {
            (if (strEq (vecGet names i) n)
              (set at (Some i)))
            (set i (+ i 1))
          })
        at
      }
    }))

; ------------------------------------------------------------------
; What the Rust side can spell
; ------------------------------------------------------------------
; A Rust identifier and nothing else: `[A-Za-z_][A-Za-z0-9_]*`.
;
; This is the same line the RUST side of the boundary already draws.
; `is_c_ident` (rust/axiom-ffi-classify/src/lib.rs) gates
; `#[axiom_export(symbol = "...")]` with exactly this predicate, and it
; refuses for exactly this reason: a name that is not an identifier is
; not a name a linker or a Rust parser can be handed.
;
; It is far narrower than `isIdentChar` (lexer.ax), which admits
; `- ! * + / < > = % & | ' ^` in an Axiom name, and that gap is what
; this predicate exists to close. Measured on a stage1 of this tree: a
; module declaring
;
;   (pub :: xy/* (-> Int Int))
;   (pub :: mid (-> String Int))
;   (pub :: */ (-> Int Int))
;
; built with `--emit-staticlib --emit-rust-binding` exited 0, said
; "Rust binding written", and wrote an `extern "C"` block reading
;
;   pub fn xy/*(a0: i64) -> i64;
;   pub fn mid(a0: i64) -> i64;
;   pub fn */(a0: i64) -> i64;
;
; where `/*` OPENS a Rust block comment and the next name's `*/` closes
; it. rustc reads that block as the single declaration `pub fn xy(a0:
; i64) -> i64;` - `mid` is gone, from a file that still parses. The
; span an attacker chooses that way is not inert text: the
; `axiom_release` calls `rbArgRels` emits and the `// SAFETY:` lines
; that justify every `unsafe` block live inside it. The mundane case is
; as bad for availability - `safe-one` produced `pub fn safe-one`,
; which is not a Rust identifier either and which rustc rejects
; outright, so a hyphen in an exported name has never once produced a
; binding that compiles.
;
; Refusing here rather than mangling is deliberate. `rbSnake` is not a
; mangling that could be made total without either colliding (`a-b`,
; `aB` and `a_b` already all become `a_b`) or becoming unreadable, and
; the archive symbol stays the RAW Axiom name in either case - so
; `safe-one` would still not be a name a C host could write, and
; `--emit-staticlib` promises exactly that it is. The corpus agrees:
; of the 2649 `pub fn` names in this tree, zero are not already Rust
; identifiers.
(:: rbIsRustIdent (-> String Bool))
(fn (rbIsRustIdent s)
  (if (== (strLen s) 0)
    false
    {
      (let b0 (strByte s 0))
      (if (|| (isAlpha b0) (== b0 95))
        {
          (let mut i 1)
          (let mut ok true)
          {
            (while (< i (strLen s))
              {
                {
                  (let b (strByte s i))
                  (if (! (|| (isAlpha b) (|| (isDigit b) (== b 95))))
                    (set ok false))
                }
                (set i (+ i 1))
              })
            ok
          }
        }
        false)
    }))

; 1 when every name the Rust side would have to WRITE for the data
; type `t` is a Rust identifier: the type's own name (it becomes a
; `struct` or an `enum`, and half of every `axh_*` symbol), each
; constructor's name (a variant, and the other half of those symbols),
; and each named field of a `struct`. Nothing else about `t` is asked
; here - whether the binding carries its FIELDS is `rbCarried`'s
; question.
;
; The `pub fn` name is not the only opener. Measured on the same
; stage1: `(pub data P*/q (C/*d Int Int))` and
; `(pub struct S/*t (f/*g : Int) (h : Int))` reached the generated file
; as `pub struct P*/q { .. }`, `raw::axh_P*/q_C/*d_0(word)`,
; `S/*t { f/*g: __f0, h: __f1 }` and `fn __to_S/*t(v: &S/*t)` - four
; more sites, none of them the one the audit started from. Answering 0
; here takes all of them out at once: `rbCollectInst` will not collect
; the instance, so no `axh_*` shim is synthesised for it and
; `rbTypesBlock` writes no `struct`/`enum`; `rbRustType` answers "",
; so every `pub fn` mentioning the type becomes a `//` note instead of
; a wrapper.
(:: rbTypeNamesSpellable (-> (Vec ASTNode) ASTNode Int))
(fn (rbTypeNamesSpellable decls t)
  (if (rbIsRustIdent (rbCarrierName (nodeAName t)))
    {
      (let cs (rbCtorsOf decls t))
      (let mut ok 1)
      (let mut i 0)
      {
        (while (< i (vecLen cs))
          {
            {
              (let c (vecGet cs i))
              {
                (if (! (rbIsRustIdent (rbCtorName c)))
                  (set ok 0))
                (if (let (Some fnames) (rbCtorNames c))
                  (for n in fnames
                    (if (! (rbIsRustIdent n))
                      (set ok 0)))
                  ())
              }
            }
            (set i (+ i 1))
          })
        ok
      }
    }
    0))

; The first name in `names` (a Vec of String) that is not a Rust
; identifier, or None when every one of them is. Some preserves an
; invalid empty name instead of confusing it with absence.
(:: rbFirstUnspellable (-> Names (Option String)))
(fn (rbFirstUnspellable names)
  {
    (let mut i 0)
    (let mut bad (:: None (Option String)))
    {
      (while (&& (< i (vecLen names)) (isNone bad))
        {
          {
            (let n (vecGet names i))
            (if (! (rbIsRustIdent n))
              (set bad (Some n)))
          }
          (set i (+ i 1))
        })
      bad
    }
  })

; Does the binding carry `t`? Words, String, and a data type whose
; every field it carries. A recursive type is carried coinductively:
; a name already being examined is assumed carried (`visiting`).
(:: rbCarried (-> (Vec ASTNode) ASTNode Names Int))
(fn (rbCarried decls t visiting)
  (if (nodeSame t nilNode)
    0
    (if (== (rbIsWordLeaf t) 1)
      1
      (if (== (rbIsString t) 1)
        1
        (if (== (rbIsVec t) 1)
          1
          (if (== (rbIsData decls t) 1)
            ; A type the Rust side cannot NAME is not carried, whatever
            ; its fields are, and the test comes before the `visiting`
            ; one so a recursive type is not waved through by its own
            ; coinductive assumption.
            (if (== (rbTypeNamesSpellable decls t) 0)
              0
              {
                (let m (rbSpellType t))
                (if (rbNamed visiting m)
                  1
                  {
                    (let cs (rbCtorsOf decls t))
                    (let mut ok 1)
                    (let mut i 0)
                    {
                      (vecPush visiting m)
                      (while (< i (vecLen cs))
                        {
                          {
                            (let tys (rbCtorTys (vecGet cs i)))
                            (let mut k 0)
                            (while (< k (vecLen tys))
                              {
                                (if (== (rbCarried decls (vecGet tys k) visiting) 0)
                                  (set ok 0))
                                (set k (+ k 1))
                              })
                          }
                          (set i (+ i 1))
                        })
                      (vecPop visiting)
                      ok
                    }
                  })
              })
            0))))))

; A type's name in a shim symbol and a Rust identifier: `Int`,
; `Pair`, `Option_Int`, `Result_Int_String`, `List_Option_Int`.
(:: rbMangle (-> ASTNode String))
(fn (rbMangle t)
  (if (nodeSame t nilNode)
    "_"
    (if (== (nodeTag t) TAG_T_CON)
      {
        (let s (strBuilderPush strBuilderNew (rbCarrierName (nodeAName t))))
        (let args (nodeBChildren t))
        (let mut i 0)
        {
          (while (< i (vecLen args))
            {
              (strBuilderPush s (concat "_" (rbMangle (vecGet args i))))
              (set i (+ i 1))
            })
          (strBuilderFinish s)
        }
      }
      "_")))

; Every data instantiation the `pub` signatures reach, including
; through fields, each once, in first-seen order.
(:: rbInstances (-> (Vec ASTNode) Names (Vec ASTNode)))
(fn (rbInstances decls pubNames)
  {
    (let insts vecNew)
    (let seen vecNew)
    (let mut i 0)
    {
      (while (< i (vecLen decls))
        {
          {
            (let d (vecGet decls i))
            (if (&& (== (nodeTag d) TAG_D_FN) (rbNamed pubNames (nodeAName d)))
              {
                (let sigd (rbFindSig decls (nodeAName d) 0))
                (match sigd
                  ((None) 0)
                  ((Some sigd) (rbCollectInst decls (nodeTyChild sigd) insts seen)))
              })
          }
          (set i (+ i 1))
        })
      insts
    }
  })

(:: rbCollectInst (-> (Vec ASTNode) ASTNode (Vec ASTNode) Names Int))
(fn (rbCollectInst decls t insts seen)
  (if (nodeSame t nilNode)
    0
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_ARR)
        {
          (rbCollectInst decls (nodeAChild t) insts seen)
          (rbCollectInst decls (nodeBChild t) insts seen)
        }
        (if (&& (== tag TAG_T_CON) (== (rbIsData decls t) 1))
          (if (== (rbCarried decls t vecNew) 0)
            0
            {
              (let m (rbSpellType t))
              (if (rbNamed seen m)
                0
                {
                  (let cs (rbCtorsOf decls t))
                  (let mut i 0)
                  {
                    (vecPush seen m)
                    (vecPush insts t)
                    (while (< i (vecLen cs))
                      {
                        {
                          (let tys (rbCtorTys (vecGet cs i)))
                          (let mut k 0)
                          (while (< k (vecLen tys))
                            {
                              (rbCollectInst decls (vecGet tys k) insts seen)
                              (set k (+ k 1))
                            })
                        }
                        (set i (+ i 1))
                      })
                    0
                  }
                })
            })
          0))
    }))

; A source identity and an exported symbol are separate keys. Refuse a
; collision before synthesising declarations, with a module diagnostic
; rather than a span in generated text presented as the user's source.
(pub :: rbCollisionName (-> Nodes Names String))
(pub fn (rbCollisionName decls pubNames)
  {
    (let insts (rbInstances decls pubNames))
    (let names vecNew)
    (let mut collision "")
    (let mut i 0)
    {
      (while (&& (< i (vecLen insts)) (== (strLen collision) 0))
        {
          {
            (let name (rbMangle (vecGet insts i)))
            (if (isSome (strVecIdx names name))
              (set collision name)
              (vecPush names name))
          }
          (set i (+ i 1))
        })
      collision
    }
  })

; ------------------------------------------------------------------
; The synthesised Axiom shims
; ------------------------------------------------------------------
; Axiom source for every accessor shim the binding calls.
(:: rbShimSource (-> Nodes Names String))
(fn (rbShimSource decls pubNames)
  {
    (let insts (rbInstances decls pubNames))
    (let out strBuilderNew)
    (let mut i 0)
    {
      (strBuilderPush out
        "(import Vec)\n(pub :: axh_vec_new (Vec Int))\n(pub fn (axh_vec_new) vecNew)\n(pub :: axh_vec_push (-> (Vec Int) Int (Vec Int)))\n(pub fn (axh_vec_push v w) (vecPush v w))\n(pub :: axh_vec_len (-> (Vec Int) Int))\n(pub fn (axh_vec_len v) (vecLen v))\n(pub :: axh_vec_get (-> (Vec Int) Int Int))\n(pub fn (axh_vec_get v i) (vecGet v i))\n")
      (while (< i (vecLen insts))
        {
          (strBuilderPush out (rbShimsFor decls (vecGet insts i)))
          (set i (+ i 1))
        })
      (strBuilderFinish out)
    }
  })

; Source generated for standard Result must name Err's constructors
; even when the entry declares its own Ok or Err. Rust keeps the short
; constructor names in its own Result type.
(:: rbShimCtorName (-> ASTNode String String))
(fn (rbShimCtorName t name)
  (if (strEq (nodeAName t) "Err$Result")
    (concat "Err::" name)
    name))

(:: rbShimsFor (-> (Vec ASTNode) ASTNode String))
(fn (rbShimsFor decls t)
  ; the tag
  {
    (let m (rbMangle t))
    (let ts (rbSpellType t))
    (let cs (rbCtorsOf decls t))
    (let isStruct (rbIsStructType decls t))
    (let out strBuilderNew)
    (let mut j 0)
    {
      (strBuilderPush out
        (concat "(pub :: axh_" (concat m (concat "_tag (-> " (concat ts " Int))\n")))))
      (if (== isStruct 1)
        (strBuilderPush out (concat "(pub fn (axh_" (concat m "_tag v) 0)\n")))
        {
          (strBuilderPush out (concat "(pub fn (axh_" (concat m "_tag v) (match v")))
          (while (< j (vecLen cs))
            {
              (strBuilderPush out
                (concat " (("
                  (concat (rbShimCtorName t (rbCtorName (vecGet cs j)))
                    (concat (rbBinders (vecLen (rbCtorTys (vecGet cs j))))
                      (concat ") " (concat (fmtInt j) ")"))))))
              (set j (+ j 1))
            })
          (strBuilderPush out "))\n")
        })
      ; constructors and accessors
      (for j in 0..(vecLen cs)
        {
          (let c (vecGet cs j))
          {
            (let cn (rbCtorName c))
            (let srcCn (rbShimCtorName t (rbCtorName c)))
            (let tys (rbCtorTys c))
            (let mut k 0)
            {
              (if (== (vecLen tys) 0)
                (strBuilderPush out
                  (concat "(pub :: axh_"
                    (concat m
                      (concat (concat "_" cn)
                        (concat " "
                          (concat ts
                            (concat ")\n(pub fn (axh_"
                              (concat m
                                (concat "_" (concat cn (concat ") " (concat srcCn ")\n"))))))))))))
                (strBuilderPush out
                  (concat "(pub :: axh_"
                    (concat m
                      (concat (concat "_" cn)
                        (concat " (-> "
                          (concat (rbSpellEachSp tys 0)
                            (concat ts
                              (concat "))\n(pub fn (axh_"
                                (concat m
                                  (concat (concat "_" cn)
                                    (concat (rbBinders (vecLen tys))
                                      (concat ") ("
                                        (concat srcCn
                                          (concat (rbBinders (vecLen tys)) "))\n")))))))))))))))
              (while (< k (vecLen tys))
                {
                  {
                    (let fty (rbSpellType (vecGet tys k)))
                    {
                      (strBuilderPush out
                        (concat "(pub :: axh_"
                          (concat m
                            (concat (concat "_" (concat cn (concat "_" (fmtInt k))))
                              (concat " (-> " (concat ts (concat " " (concat fty "))\n"))))))))
                      ; A field of a `data` value is read only after its
                      ; tag, so a value of another constructor has no
                      ; field to answer: the arm traps (status 77), as
                      ; `vecGet` does past the end, rather than answering
                      ; a forged null reference (R-B6).
                      (if (== isStruct 1)
                        (strBuilderPush out
                          (concat "(pub fn (axh_"
                            (concat m
                              (concat (concat "_" (concat cn (concat "_" (fmtInt k))))
                                (concat " v) v."
                                  (concat
                                    (if (let (Some names) (rbCtorNames c))
                                      (vecGet names k)
                                      "")
                                    ")\n"))))))
                        (strBuilderPush out
                          (concat "(pub fn (axh_"
                            (concat m
                              (concat (concat "_" (concat cn (concat "_" (fmtInt k))))
                                (concat " v) (match v (("
                                  (concat srcCn
                                    (concat (rbBinders (vecLen tys))
                                      (concat ") a"
                                        (concat (fmtInt k) ") (_ __indexTrap)))\n"))))))))))
                    }
                  }
                  (set k (+ k 1))
                })
            }
          }
        })
      (strBuilderFinish out)
    }
  })

(:: rbIsStructType (-> (Vec ASTNode) ASTNode Int))
(fn (rbIsStructType decls t)
  {
    (let d (rbDataDecl decls (nodeAName t)))
    (match d
      ((None) 0)
      ((Some d)
        (if (== (nodeTag d) TAG_D_STRUCT)
          1
          0)
      ))
  })

; ` a0 a1 ..`
(:: rbBinders (-> Int String))
(fn (rbBinders n)
  {
    (let s strBuilderNew)
    (let mut i 0)
    {
      (while (< i n)
        {
          (strBuilderPush s (concat " a" (fmtInt i)))
          (set i (+ i 1))
        })
      (strBuilderFinish s)
    }
  })

(:: rbSpellEachSp (-> (Vec ASTNode) Int String))
(fn (rbSpellEachSp v i)
  (if (>= i (vecLen v))
    ""
    (concat (rbSpellType (vecGet v i)) (concat " " (rbSpellEachSp v (+ i 1))))))

; Parse the shims and append them to the entry's declarations. Called
; after the module's first check, so every type has its declaration's
; identity. The combined module is checked again. A parse
; failure here is a compiler bug and says so.
(pub :: rbAppendShims (-> (Vec ASTNode) Names Int))
;@axiom:effect(io)
(pub fn (rbAppendShims decls pubNames)
  {
    (let src (rbShimSource decls pubNames))
    {
      (let toks (lex src))
      {
        (let pr (parseModuleWith toks (scanAxtags src)))
        (match pr
          ((ParseFailed parseError1)
            {
              (writeStderrStr
                (concat "error: the synthesised binding shims did not parse (a compiler bug):\n"
                  (concat src "\n")))
              (sysExitWith 1)
              0
            }
          )
          ((ParseSuccess parsedValue1 parsedPos1)
            {
              (let ds parsedValue1)
              (let mut i 0)
              {
                (while (< i (vecLen ds))
                  {
                    (vecPush decls (vecGet ds i))
                    (set i (+ i 1))
                  })
                (vecLen ds)
              }
            }
          ))
      }
    }
  })

; ------------------------------------------------------------------
; The Rust file
; ------------------------------------------------------------------
; The whole file, from the entry unit's declarations (shims included)
; and the names that were `pub` when parsed.
(pub :: rustBindingOf (-> (Vec ASTNode) Names String String))
(pub fn (rustBindingOf decls pubNames fileName)
  {
    (let raws vecNew)
    (let wraps vecNew)
    (let notes vecNew)
    (let mut i 0)
    (let insts (rbInstances decls pubNames))
    {
      (while (< i (vecLen decls))
        {
          {
            (let d (vecGet decls i))
            (if (&& (== (nodeTag d) TAG_D_FN)
                  (|| (rbNamed pubNames (nodeAName d)) (strStartsWith (nodeAName d) "axh_")))
              (rbOneFn decls d raws wraps notes))
          }
          (set i (+ i 1))
        })
      (concat (concat (rbHeader fileName) (rbRawBlock raws))
        (concat rbVecBuf
          (concat (concat (rbTypesBlock decls insts) (rbJoin wraps)) (rbNotes notes))))
    }
  })

; `s` with every control byte replaced by `?`, so it cannot end the
; `//!` line it is written on.
;
; The header is the one place the binding interpolates something that
; is NOT an Axiom identifier: the input file's base name. `//!` is a
; line comment, so `/*` and `*/` are inert in it and `pathBase` has
; already cut everything up to the last `/` - a byte 10 or 13 is the
; only way out. Measured on a stage1 of this tree, building a file
; whose name was `nl<LF>use std::process;<LF>.ax`:
;
;   //! GENERATED by `axiom build --emit-rust-binding` from nl
;   use std::process;
;   .ax. Do not edit.
;
; - the second line is not a comment, and a repo that ships such a
; file and a build script that globs `*.ax` chooses that line. Bytes
; at or above 128 are left alone: a UTF-8 file name is legal in a Rust
; comment and is not an escape.
(:: rbCommentSafe (-> String String))
(fn (rbCommentSafe s)
  {
    (let out (strBuilderWithCapacity (strLen s)))
    {
      (for i in 0..(strLen s)
        {
          (let b (strByte s i))
          (strBuilderPushByte out
            (if (|| (< b 32) (== b 127))
              63
              b))
        })
      (strBuilderFinish out)
    }
  })

(:: rbHeader (-> String String))
(fn (rbHeader fileName)
  (concat
    (concat "//! GENERATED by `axiom build --emit-rust-binding` from "
      (concat (rbCommentSafe (pathBase fileName)) ". Do not edit.\n"))
    (concat
      "//!\n//! Link the archive `--emit-staticlib` wrote beside this file; every\n//! function below is a `pub fn` of that module, a C symbol under its own\n//! name. Arguments are borrowed for the call (a callee that keeps one\n//! retains it); every result is an owned share the wrapper adopts or\n//! releases. `String` arguments are built with the archive's own\n//! `Str$strAlloc`; a `data` value is built and read through the `axh_*`\n//! accessors the same build synthesised into the archive.\n//!\n//! Every call takes an `AxRuntime`: the archive's allocator and its\n//! reference counts are unsynchronised, so exactly one thread may touch\n//! them, and `AxRuntime::claim` is how a thread becomes that one. A call\n//! that takes a raw `AxWord` is `unsafe`: the word must be a live value\n//! of the Axiom type its signature names.\n"
      (concat
        "#![allow(non_snake_case, non_camel_case_types, dead_code, unused_imports, unused_unsafe, unused_variables, clippy::all)]\n\n"
        "use axiom_ffi::host::{AxRuntime, AxString};\nuse axiom_ffi::{axiom_release, AxWord};\n\n"))))

; `unsafe extern "C"`, not `extern "C"`. Edition 2024
; makes an un-`unsafe` extern block a hard error - "extern blocks must
; be unsafe" - and this file is generated INTO somebody else's crate,
; so it has to compile in the edition that crate chose. The `unsafe`
; spelling is accepted in every edition from Rust 1.82, which is below
; `rust/Cargo.toml`'s declared MSRV, so writing it costs nothing on an
; older edition and is required on the current one.
;
; `scripts/check-ffi.sh` diffs the checked-in
; `rust/examples/host/src/hostlib.rs` against a fresh generation byte
; for byte, so that file is regenerated in the same commit as this
; line; the gate is what makes the pair a pair.
(:: rbRawBlock (-> Names String))
(fn (rbRawBlock raws)
  (concat "mod raw {\n    unsafe extern \"C\" {\n" (concat (rbJoin raws) "    }\n}\n\n")))

; `AxVecBuf`: an Axiom `(Vec Int)` the host builds and reads through
; the synthesised shims; its share is released on drop.
;
; TYPED, AND BOUND TO THE RUNTIME'S THREAD. Spelled `AxWord`, a vector
; would let a safe wrapper accept any integer as one, and
; `vec_sum(12345)` would hand Axiom a pointer to nothing. A
; `(Vec Int)` parameter is `&AxVecBuf` and a result is an owned
; `AxVecBuf`; its elements are words and any word is a valid `Int`, so
; `from_words` is safe. A `Vec` of anything else stays a raw word, and
; the wrapper taking one is `unsafe` (`rbRawIn`). It carries a
; `!Send`/`!Sync` marker, as `AxString` and every ABI view do: its drop
; calls `axiom_release`, and the counts are unsynchronised.
(:: rbVecBuf String)
(fn (rbVecBuf)
  "/// An Axiom `(Vec Int)`, built and read through the archive's own `Vec`.\n/// A `(Vec Int)` parameter borrows one and a `(Vec Int)` result is one.\n#[derive(Debug)]\npub struct AxVecBuf {\n    word: AxWord,\n    _thread: core::marker::PhantomData<*const ()>,\n}\n\nimpl AxVecBuf {\n    /// A fresh Axiom `(Vec Int)` holding `words`.\n    pub fn from_words(rt: AxRuntime, words: &[i64]) -> AxVecBuf {\n        // SAFETY: the archive's `vecNew`/`vecPush`, answering an owned share; `rt`\n        // proves this is the thread the runtime belongs to.\n        let v = unsafe { raw::axh_vec_new() };\n        for w in words {\n            unsafe { raw::axh_vec_push(v, *w) };\n        }\n        AxVecBuf {\n            word: v,\n            _thread: core::marker::PhantomData,\n        }\n    }\n\n    /// Adopt a `(Vec Int)` word a function answered.\n    ///\n    /// # Safety\n    /// `word` must be a live Axiom `(Vec Int)` the caller owns one share of,\n    /// and this must run on the thread that holds the `AxRuntime`.\n    pub unsafe fn from_owned(word: AxWord) -> AxVecBuf {\n        AxVecBuf {\n            word,\n            _thread: core::marker::PhantomData,\n        }\n    }\n\n    /// The word, for an `extern` call made by hand.\n    pub fn as_word(&self) -> AxWord {\n        self.word\n    }\n\n    pub fn len(&self) -> usize {\n        unsafe { raw::axh_vec_len(self.word) as usize }\n    }\n\n    pub fn words(&self) -> Vec<i64> {\n        (0..self.len()).map(|i| unsafe { raw::axh_vec_get(self.word, i as AxWord) }).collect()\n    }\n}\n\nimpl Drop for AxVecBuf {\n    fn drop(&mut self) {\n        unsafe { axiom_release(self.word) }\n    }\n}\n\n")

; A note names the Axiom function and, often, an Axiom type - raw, as
; the source spelled them, which is the whole point of a note. That is
; safe ONLY because every line here is a `//` line comment: Rust's `//`
; runs to the end of the line and a `/*` inside one does not open
; anything, and `isIdentChar` (lexer.ax) admits no byte 10 or 13, so a
; name cannot end the line early. Do not turn these into `/* */`
; comments, and do not wrap a group of them in one: that would hand
; back exactly the opener `rbIsRustIdent` was added to take away.
(:: rbNotes (-> Names String))
(fn (rbNotes notes)
  (if (== (vecLen notes) 0)
    ""
    (concat "// Not bound - call these through the archive by hand, or change the type:\n"
      (rbJoin notes))))

(:: rbJoin (-> Names String))
(fn (rbJoin v)
  {
    (let out strBuilderNew)
    (let mut i 0)
    {
      (while (< i (vecLen v))
        {
          (strBuilderPush out (vecGet v i))
          (set i (+ i 1))
        })
      (strBuilderFinish out)
    }
  })

; One `pub fn`: the raw declaration and the wrapper, or a note. A
; synthesised `axh_*` shim gets the raw declaration only.
;
; The name is checked FIRST, before the signature is even looked for.
; It is interpolated into three Rust CODE positions and one doc line -
; `rbRawDecl` writes `pub fn <name>` inside `extern "C"`, `rbWrapper`
; writes `raw::<name>(..)` and, through `rbSnake`, the wrapper's own
; `pub fn <name>` - and `rbSnake` mangles only the third of those. A
; name that is not a Rust identifier therefore has to be refused here,
; once, rather than repaired at each site: see `rbIsRustIdent` for the
; module that opened a block comment across the generated file's
; `axiom_release` calls by being called `xy/*`.
;
; This also covers the synthesised `axh_*` shims below, whose names
; embed a type's and a constructor's, though `rbTypeNamesSpellable`
; has already stopped a poisoned type reaching `rbShimSource` at all.
(:: rbOneFn (-> (Vec ASTNode) ASTNode Names Names Names Int))
(fn (rbOneFn decls f raws wraps notes)
  {
    (let name (nodeAName f))
    (let sigd (rbFindSig decls (nodeAName f) 0))
    {
      (let ty
        (match sigd
          ((None) None)
          ((Some signature)
            {
              (let ty (nodeTyChild signature))
              (if (nodeSame ty nilNode)
                None
                (Some ty))
            }
          )))
      (if (rbIsRustIdent name)
        (match ty
          ((None)
            {
              (vecPush notes
                (concat "// `"
                  (concat name "`: no `(pub :: name Type)` signature to bind it by\n")))
              0
            }
          )
          ((Some ty)
            {
              (let params (rbParamTypes ty vecNew))
              (let res (sigResultOf ty))
              (let names (nodeBNames f))
              (if (strStartsWith name "axh_")
                {
                  (vecPush raws (rbRawDecl name params))
                  0
                }
                {
                  (let bad (rbFirstUnsupported decls params res))
                  (if (> (strLen bad) 0)
                    {
                      (vecPush notes
                        (concat "// `"
                          (concat name
                            (concat "`: `"
                              (concat (rbSpellType ty) (concat "` names " (concat bad "\n")))))))
                      0
                    }
                    (if (!= (vecLen params) (vecLen names))
                      {
                        (vecPush notes
                          (concat "// `"
                            (concat name
                              "`: the signature and the definition disagree on arity\n")))
                        0
                      }
                      ; The BINDERS are interpolated too, and by the same
                      ; `rbSnake` that let the function's own name through:
                      ; `(pub fn (badParam n/*z) ..)` reached the generated
                      ; file as `pub fn bad_param(n/*z: i64)` and
                      ; `raw::badParam(n/*z)`. `rbSigLine`, `rbArgLets`,
                      ; `rbArgRels` and `rbArgList` all spell them, so the
                      ; check is here, where the wrapper is decided on.
                      (if (let (Some badParam) (rbFirstUnspellable names))
                        {
                          (vecPush notes
                            (concat "// `"
                              (concat name
                                (concat "`: its parameter `"
                                  (concat badParam "` is not a Rust identifier\n")))))
                          0
                        }
                        {
                          (vecPush raws (rbRawDecl name params))
                          (match res
                            ((None) __indexTrap)
                            ((Some result)
                              (vecPush wraps (rbWrapper decls name ty params result names))
                            ))
                          0
                        })))
                })
            }
          ))
        {
          (vecPush notes
            (concat "// `"
              (concat name
                "`: not a Rust identifier, so no `extern \"C\"` declaration can name it\n")))
          0
        })
    }
  })

(:: rbFindSig (-> Nodes String Int (Option ASTNode)))
(fn (rbFindSig decls name i)
  (if (>= i (vecLen decls))
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_SIG) (strEq (nodeAName d) name))
        (Some d)
        (rbFindSig decls name (+ i 1)))
    }))

; The parameter types along the arrow spine, and the result past it.
(:: rbParamTypes (-> ASTNode (Vec ASTNode) (Vec ASTNode)))
(fn (rbParamTypes ty acc)
  (if (&& (! (nodeSame ty nilNode)) (== (nodeTag ty) TAG_T_ARR))
    {
      (vecPush acc (nodeAChild ty))
      (rbParamTypes (nodeBChild ty) acc)
    }
    acc))

; The Rust type of `t` in a wrapper's signature, or "" when the
; binding does not carry it. `pos` is 0 for a parameter, 1 for a
; result, 2 for a field of a data type (owned everywhere).
(:: rbRustType (-> (Vec ASTNode) ASTNode Int String))
(fn (rbRustType decls t pos)
  (if (nodeSame t nilNode)
    ""
    (if (== (rbIsWordLeaf t) 1)
      {
        (let n (nodeAName t))
        (if (strEq n "Int")
          "i64"
          (if (strEq n "Float")
            "f64"
            (if (strEq n "Bool")
              "bool"
              (if (strEq n "Char")
                "char"
                "AxWord"))))
      }
      (if (== (rbIsString t) 1)
        (if (== pos 0)
          "&str"
          "AxString")
        (if (== (rbIsIntVec t) 1)
          (if (== pos 0)
            "&AxVecBuf"
            "AxVecBuf")
          (if (== (rbIsVec t) 1)
            "AxWord"
            (if (== (rbIsData decls t) 1)
              (if (== (rbCarried decls t vecNew) 0)
                ""
                {
                  (let own (rbRustDataName decls t))
                  (if (== pos 0)
                    (concat "&" own)
                    own)
                })
              (if (&& (== (nodeTag t) TAG_T_TUP) (&& (== pos 1) (== (vecLen (nodeAChildren t)) 0)))
                "()"
                ""))))))))

; The Rust spelling of a carried data type as a value: `Pair`,
; `Option<i64>`, `Result<i64, AxString>`, `List_Int`.
(:: rbRustDataName (-> (Vec ASTNode) ASTNode String))
(fn (rbRustDataName decls t)
  {
    (let n (nodeAName t))
    (if (strEq n "Option")
      (concat "Option<" (concat (rbRustType decls (vecGet (nodeBChildren t) 0) 2) ">"))
      (if (strEq n "Err$Result")
        (concat "Result<"
          (concat (rbRustType decls (vecGet (nodeBChildren t) 0) 2)
            (concat ", " (concat (rbRustType decls (vecGet (nodeBChildren t) 1) 2) ">"))))
        (rbMangle t)))
  })

; The first type the binding cannot carry, spelled for the note; ""
; when every leaf is carried.
(:: rbFirstUnsupported (-> (Vec ASTNode) (Vec ASTNode) (Option ASTNode) String))
(fn (rbFirstUnsupported decls params res)
  {
    (let mut i 0)
    (let mut bad "")
    {
      (while (&& (< i (vecLen params)) (== (strLen bad) 0))
        {
          (if (== (strLen (rbRustType decls (vecGet params i) 0)) 0)
            (set bad (rbUncarriedPhrase decls (vecGet params i))))
          (set i (+ i 1))
        })
      (if (> (strLen bad) 0)
        bad
        (match res
          ((None) "`?`, which the binding does not carry")
          ((Some result)
            (if (== (strLen (rbRustType decls result 1)) 0)
              (rbUncarriedPhrase decls result)
              "")
          )))
    }
  })

; Why `t` did not reach the binding, spelled for the note. The two
; reasons read very differently to whoever has to act on them: "does
; not carry" is about the SHAPE and is answered by changing the type,
; while a name `rbTypeNamesSpellable` refused is about the SPELLING and
; is answered by renaming. Without the split, `(pub data P*/q (C/*d Int
; Int))` was reported as a type the binding does not carry, which is
; false - it carries a two-field product perfectly well.
(:: rbUncarriedPhrase (-> (Vec ASTNode) ASTNode String))
(fn (rbUncarriedPhrase decls t)
  (concat "`"
    (concat (rbSpellType t)
      (if (&& (== (rbIsData decls t) 1) (== (rbTypeNamesSpellable decls t) 0))
        "`, whose name is not a Rust identifier"
        "`, which the binding does not carry"))))

; `extern "C"` line: every word is `i64` on the wire.
(:: rbRawDecl (-> String (Vec ASTNode) String))
(fn (rbRawDecl name params)
  (concat "        pub fn "
    (concat name (concat (concat "(" (concat (rbRawParams (vecLen params) 0) ")")) " -> i64;\n"))))

(:: rbRawParams (-> Int Int String))
(fn (rbRawParams n i)
  (if (>= i n)
    ""
    (concat (concat "a" (fmtInt i))
      (concat ": i64"
        (if (< (+ i 1) n)
          (concat ", " (rbRawParams n (+ i 1)))
          "")))))

; ------------------------------------------------------------------
; Conversions between a Rust value and the word on the wire
; ------------------------------------------------------------------
; A Rust expression for the word of `e`, a value of type `t`. `isRef`
; is 1 when `e` is a reference (a match binder, a `&T` parameter), 0
; when it is the value itself. A data-typed value becomes an OWNED
; word the caller releases after the call (`rbIsOwnedWord`).
(:: rbToWord (-> ASTNode String Int String))
(fn (rbToWord t e isRef)
  {
    (let deref
      (if (== isRef 1)
        "*"
        ""))
    (if (== (rbIsWordLeaf t) 1)
      {
        (let n (nodeAName t))
        (if (strEq n "Float")
          (concat "(" (concat (concat deref e) ").to_bits() as i64"))
          (if (|| (strEq n "Bool") (strEq n "Char"))
            (concat "(" (concat (concat deref e) ") as i64"))
            (concat deref e)))
      }
      (if (|| (== (rbIsString t) 1) (== (rbIsIntVec t) 1))
        (concat e ".as_word()")
        (if (== (rbIsVec t) 1)
          (concat deref e)
          (concat "__to_"
            (concat (rbMangle t)
              (concat "("
                (concat
                  (if (== isRef 1)
                    e
                    (concat "&" e))
                  ")")))))))
  })

(:: rbIsOwnedWord (-> (Vec ASTNode) ASTNode Int))
(fn (rbIsOwnedWord decls t)
  (if (== (rbIsData decls t) 1)
    1
    0))

; A Rust expression for the value of type `t` held in the OWNED word
; `w` (a result, or an accessor's answer): adopted or consumed.
(:: rbFromWord (-> ASTNode String String))
(fn (rbFromWord t w)
  (if (== (rbIsWordLeaf t) 1)
    {
      (let n (nodeAName t))
      (if (strEq n "Float")
        (concat "f64::from_bits(" (concat w " as u64)"))
        (if (strEq n "Bool")
          (concat w " != 0")
          (if (strEq n "Char")
            (concat "char::from_u32(" (concat w " as u32).unwrap_or('\\u{FFFD}')"))
            w)))
    }
    (if (== (rbIsString t) 1)
      (concat "unsafe { AxString::from_owned(" (concat w ") }"))
      (if (== (rbIsIntVec t) 1)
        (concat "unsafe { AxVecBuf::from_owned(" (concat w ") }"))
        (if (== (rbIsVec t) 1)
          w
          (concat "unsafe { __from_" (concat (rbMangle t) (concat "(" (concat w ") }")))))))))

; ------------------------------------------------------------------
; The Rust types and their conversion functions
; ------------------------------------------------------------------
(:: rbTypesBlock (-> (Vec ASTNode) (Vec ASTNode) String))
(fn (rbTypesBlock decls insts)
  {
    (let out strBuilderNew)
    (let mut i 0)
    {
      (while (< i (vecLen insts))
        {
          (strBuilderPush out (rbTypeFor decls (vecGet insts i)))
          (set i (+ i 1))
        })
      (strBuilderFinish out)
    }
  })

; The Rust side of one data instantiation: the type (unless it is
; `Option`/`Result`, which Rust has), `__from_<M>` consuming an owned
; word, `__to_<M>` answering one.
(:: rbTypeFor (-> (Vec ASTNode) ASTNode String))
(fn (rbTypeFor decls t)
  {
    (let m (rbMangle t))
    (let n (nodeAName t))
    (let cs (rbCtorsOf decls t))
    (let rn (rbRustDataName decls t))
    (concat
      (if (|| (strEq n "Option") (strEq n "Err$Result"))
        ""
        (rbTypeDecl decls t cs))
      (concat (rbFromFn decls t cs rn)
        (concat (rbToFn decls t cs rn)
          (if (|| (strEq n "Option") (strEq n "Err$Result"))
            ""
            (concat "impl "
              (concat rn
                (concat
                  (concat
                    " {\n    /// Adopt an Axiom value of this type, consuming the share `word` carries.\n    ///\n    /// # Safety\n    /// `word` must be a live Axiom `"
                    (concat (rbSpellType t)
                      (concat
                        "` the caller owns one share of - the answer\n    /// of an Axiom call, or of `to_axiom` - and that share is released here, so the same\n    /// word must not be adopted twice.\n    pub unsafe fn from_axiom(rt: AxRuntime, word: AxWord) -> "
                        (concat rn
                          (concat " {\n        unsafe { __from_"
                            (concat m "(word) }\n    }\n\n"))))))
                  (if (== (rbRawIn decls t vecNew) 1)
                    (concat
                      "    /// This value as an Axiom one, an owned share the caller releases.\n    ///\n    /// # Safety\n    /// Every `AxWord` field reachable from `self` must be a live Axiom value of the\n    /// type its Axiom declaration names.\n    pub unsafe fn to_axiom(&self, rt: AxRuntime) -> AxWord {\n        __to_"
                      (concat m "(self)\n    }\n}\n\n"))
                    (concat
                      "    /// This value as an Axiom one, an owned share the caller releases.\n    pub fn to_axiom(&self, rt: AxRuntime) -> AxWord {\n        __to_"
                      (concat m "(self)\n    }\n}\n\n"))))))))))
  })

; `pub struct T { pub f0: .. }` or `pub enum T { C0(..), C1 }`.
(:: rbTypeDecl (-> (Vec ASTNode) ASTNode (Vec RbCtor) String))
(fn (rbTypeDecl decls t cs)
  {
    (let rn (rbRustDataName decls t))
    (let m (rbMangle t))
    (if (== (vecLen cs) 1)
      {
        (let c (vecGet cs 0))
        (let out strBuilderNew)
        (let mut k 0)
        {
          (strBuilderPush out
            (concat "/// `"
              (concat (rbSpellType t)
                (concat "`, one constructor\n#[derive(Debug)]\npub struct " (concat rn " {\n")))))
          (while (< k (vecLen (rbCtorTys c)))
            {
              (strBuilderPush out
                (concat "    pub "
                  (concat (rbFieldName c k)
                    (concat ": "
                      (concat (rbFieldRustType decls m (vecGet (rbCtorTys c) k)) ",\n")))))
              (set k (+ k 1))
            })
          (concat (strBuilderFinish out) "}\n\n")
        }
      }
      {
        (let out strBuilderNew)
        (let mut j 0)
        {
          (strBuilderPush out
            (concat "/// `"
              (concat (rbSpellType t)
                (concat "`, one variant per constructor\n#[derive(Debug)]\npub enum "
                  (concat rn " {\n")))))
          (while (< j (vecLen cs))
            {
              {
                (let c (vecGet cs j))
                (if (== (vecLen (rbCtorTys c)) 0)
                  (strBuilderPush out (concat "    " (concat (rbCtorName c) ",\n")))
                  (strBuilderPush out
                    (concat "    "
                      (concat (rbCtorName c)
                        (concat "(" (concat (rbFieldRustTypes decls m (rbCtorTys c) 0) "),\n"))))))
              }
              (set j (+ j 1))
            })
          (concat (strBuilderFinish out) "}\n\n")
        }
      })
  })

; A field's Rust type: owned, and boxed when it reaches the type
; being declared (a recursive `List`'s tail).
(:: rbFieldRustType (-> (Vec ASTNode) String ASTNode String))
(fn (rbFieldRustType decls m ft)
  {
    (let rt (rbRustType decls ft 2))
    (if (rbReaches decls ft m vecNew)
      (concat "Box<" (concat rt ">"))
      rt)
  })

(:: rbFieldRustTypes (-> (Vec ASTNode) String (Vec ASTNode) Int String))
(fn (rbFieldRustTypes decls m tys i)
  (if (>= i (vecLen tys))
    ""
    (concat (rbFieldRustType decls m (vecGet tys i))
      (concat
        (if (< (+ i 1) (vecLen tys))
          ", "
          "")
        (rbFieldRustTypes decls m tys (+ i 1))))))

; Does type `t` reach the data type mangled `m` through its fields?
(:: rbReaches (-> (Vec ASTNode) ASTNode String Names Bool))
(fn (rbReaches decls t m visiting)
  (if (== (rbIsData decls t) 0)
    false
    {
      (let tm (rbMangle t))
      (if (strEq tm m)
        true
        (if (rbNamed visiting tm)
          false
          {
            (let cs (rbCtorsOf decls t))
            (let mut found false)
            (let mut j 0)
            {
              (vecPush visiting tm)
              (while (< j (vecLen cs))
                {
                  {
                    (let tys (rbCtorTys (vecGet cs j)))
                    (let mut k 0)
                    (while (< k (vecLen tys))
                      {
                        (if (rbReaches decls (vecGet tys k) m visiting)
                          (set found true))
                        (set k (+ k 1))
                      })
                  }
                  (set j (+ j 1))
                })
              found
            }
          }))
    }))

(:: rbFieldName (-> RbCtor Int String))
(fn (rbFieldName c k)
  (if (let (Some names) c.fields)
    (if (< k (vecLen names))
      (rbSnake (vecGet names k))
      (concat "f" (fmtInt k)))
    (concat "f" (fmtInt k))))

; `fn __from_M(word: AxWord) -> T`: read the tag, read each field of
; the live constructor (an owned word each) into a local, build the
; value, release the word.
(:: rbFromFn (-> (Vec ASTNode) ASTNode (Vec RbCtor) String String))
(fn (rbFromFn decls t cs rn)
  {
    (let m (rbMangle t))
    (let n (nodeAName t))
    (let out strBuilderNew)
    (let mut j 0)
    {
      (strBuilderPush out
        (concat "unsafe fn __from_"
          (concat m
            (concat "(word: AxWord) -> "
              (concat rn
                " {\n    // SAFETY: the caller promises `word` is a live value of this type it owns;\n    // every accessor answers an owned share, released here or adopted by the value.\n    let __tag = unsafe { raw::axh_")))))
      (strBuilderPush out (concat m "_tag(word) };\n    let __v = match __tag {\n"))
      (while (< j (vecLen cs))
        {
          {
            (let c (vecGet cs j))
            {
              (let tys (rbCtorTys c))
              (let mut k 0)
              (let args strBuilderNew)
              (let lets strBuilderNew)
              {
                (while (< k (vecLen tys))
                  {
                    {
                      (let fw (concat "__f" (fmtInt k)))
                      {
                        (let val (rbFromWord (vecGet tys k) fw))
                        {
                          (let boxed
                            (if (rbReaches decls (vecGet tys k) m vecNew)
                              (concat "Box::new(" (concat val ")"))
                              val))
                          {
                            (strBuilderPush lets
                              (concat "            let "
                                (concat fw
                                  (concat " = unsafe { raw::axh_"
                                    (concat m
                                      (concat
                                        (concat "_" (concat (rbCtorName c) (concat "_" (fmtInt k))))
                                        (concat "(word) };\n" "")))))))
                            (strBuilderPush args
                              (concat
                                (if (== (vecLen cs) 1)
                                  (concat (rbFieldName c k) ": ")
                                  "")
                                (concat boxed
                                  (if (< (+ k 1) (vecLen tys))
                                    ", "
                                    ""))))
                          }
                        }
                      }
                    }
                    (set k (+ k 1))
                  })
                (if (== (vecLen tys) 0)
                  (strBuilderPush out
                    (concat "        "
                      (concat (fmtInt j)
                        (concat " => "
                          (concat (rbCtorExpr decls t c rn (strBuilderFinish args)) ",\n")))))
                  (strBuilderPush out
                    (concat "        "
                      (concat (fmtInt j)
                        (concat " => {\n"
                          (concat (strBuilderFinish lets)
                            (concat "            "
                              (concat (rbCtorExpr decls t c rn (strBuilderFinish args))
                                "\n        }\n"))))))))
              }
            }
          }
          (set j (+ j 1))
        })
      (strBuilderPush out
        "        _ => unreachable!(\"a constructor index the type does not have\"),\n    };\n    unsafe { axiom_release(word) };\n    __v\n}\n\n")
      (strBuilderFinish out)
    }
  })

; How a constructor is written in Rust: `Pair { a: .., b: .. }`,
; `Shape::Rect(..)`, `Some(..)`, `Err(..)`, `None`.
(:: rbCtorExpr (-> (Vec ASTNode) ASTNode RbCtor String String String))
(fn (rbCtorExpr decls t c rn args)
  {
    (let n (nodeAName t))
    (let cn (rbCtorName c))
    (let cs (rbCtorsOf decls t))
    (if (|| (strEq n "Option") (strEq n "Err$Result"))
      (if (== (vecLen (rbCtorTys c)) 0)
        cn
        (concat cn (concat "(" (concat args ")"))))
      (if (== (vecLen cs) 1)
        (concat rn (concat " { " (concat args " }")))
        (if (== (vecLen (rbCtorTys c)) 0)
          (concat rn (concat "::" cn))
          (concat rn (concat "::" (concat cn (concat "(" (concat args ")"))))))))
  })

; `fn __to_M(v: &T) -> AxWord`: build the word through the
; constructor shim, releasing the owned words of data-typed fields
; afterwards (the constructor retained what it kept).
(:: rbToFn (-> (Vec ASTNode) ASTNode (Vec RbCtor) String String))
(fn (rbToFn decls t cs rn)
  {
    (let m (rbMangle t))
    (let n (nodeAName t))
    (let mut out "")
    (let mut j 0)
    {
      (set out (concat "fn __to_"
                 (concat m (concat "(v: &" (concat rn ") -> AxWord {\n    match v {\n")))))
      (while (< j (vecLen cs))
        {
          ; the pattern binds each field by reference
          {
            (let c (vecGet cs j))
            {
              (let tys (rbCtorTys c))
              (let mut k 0)
              (let mut pat "")
              (let mut lets "")
              (let mut args "")
              (let mut rels "")
              {
                (while (< k (vecLen tys))
                  {
                    (set pat (concat pat
                               (concat
                                 (if (== (vecLen cs) 1)
                                   (concat (rbFieldName c k) ": ")
                                   "")
                                 (concat (concat "a" (fmtInt k))
                                   (if (< (+ k 1) (vecLen tys))
                                     ", "
                                     "")))))
                    {
                      (let ft (vecGet tys k))
                      {
                        (let src
                          (if (rbReaches decls ft m vecNew)
                            (concat "&**a" (concat (fmtInt k) ""))
                            (concat "a" (fmtInt k))))
                        (if (== (rbIsOwnedWord decls ft) 1)
                          {
                            (set lets (concat lets
                                        (concat "            let __w"
                                          (concat (fmtInt k)
                                            (concat " = " (concat (rbToWord ft src 1) ";\n"))))))
                            (set rels (concat rels
                                        (concat "            unsafe { axiom_release(__w"
                                          (concat (fmtInt k) ") };\n"))))
                            (set args (concat args
                                        (concat "__w"
                                          (concat (fmtInt k)
                                            (if (< (+ k 1) (vecLen tys))
                                              ", "
                                              "")))))
                          }
                          (set args (concat args
                                      (concat (rbToWord ft src 1)
                                        (if (< (+ k 1) (vecLen tys))
                                          ", "
                                          "")))))
                      }
                    }
                    (set k (+ k 1))
                  })
                {
                  (let head (rbCtorPat decls t c rn pat))
                  (set out (concat out
                             (concat "        "
                               (concat head
                                 (concat " => {\n"
                                   (concat lets
                                     (concat
                                       (concat "            let __w = unsafe { raw::axh_"
                                         (concat m
                                           (concat
                                             (concat "_"
                                               (concat (rbCtorName c)
                                                 (concat "(" (concat args ")"))))
                                             " };\n")))
                                       (concat rels "            __w\n        }\n"))))))))
                }
              }
            }
          }
          (set j (+ j 1))
        })
      (concat out "    }\n}\n\n")
    }
  })

(:: rbCtorPat (-> (Vec ASTNode) ASTNode RbCtor String String String))
(fn (rbCtorPat decls t c rn pat)
  {
    (let n (nodeAName t))
    (let cn (rbCtorName c))
    (let cs (rbCtorsOf decls t))
    (if (|| (strEq n "Option") (strEq n "Err$Result"))
      (if (== (vecLen (rbCtorTys c)) 0)
        cn
        (concat cn (concat "(" (concat pat ")"))))
      (if (== (vecLen cs) 1)
        (concat rn (concat " { " (concat pat " }")))
        (if (== (vecLen (rbCtorTys c)) 0)
          (concat rn (concat "::" cn))
          (concat rn (concat "::" (concat cn (concat "(" (concat pat ")"))))))))
  })

; ------------------------------------------------------------------
; Wrappers
; ------------------------------------------------------------------
(:: rbWrapper (-> (Vec ASTNode) String ASTNode (Vec ASTNode) ASTNode Names String))
(fn (rbWrapper decls name ty params res names)
  {
    (let rname (rbSnake name))
    (let rty (rbRustType decls res 1))
    (let sig (rbSigLine decls params names 0))
    (let lets (rbArgLets decls params names 0))
    (let rels (rbArgRels decls params 0))
    (let call
      (concat "raw::" (concat name (concat "(" (concat (rbArgList decls params names 0) ")")))))
    (let raw (rbAnyRaw decls params))
    (concat
      (concat "/// `(pub :: "
        (concat name
          (concat " "
            (concat (rbSpellType ty)
              (if (== raw 1)
                ")`\n///\n/// # Safety\n/// Every `AxWord` this call is handed - an argument, or a field of a value passed\n/// by reference - must be a live Axiom value of the type its Axiom signature names,\n/// borrowed for the call.\n"
                ")`\n")))))
      (concat
        (concat
          (if (== raw 1)
            "pub unsafe fn "
            "pub fn ")
          (concat rname
            (concat
              (concat "(rt: AxRuntime"
                (concat
                  (if (> (strLen sig) 0)
                    (concat ", " sig)
                    "")
                  ")"))
              (if (strEq rty "()")
                " {\n"
                (concat " -> " (concat rty " {\n"))))))
        (concat
          (concat lets
            (concat
              "    // SAFETY: the archive defines the symbol with exactly this shape (one word each way).\n    let __r = unsafe { "
              (concat call " };\n")))
          (concat rels (concat (rbResultExpr res rty) "}\n\n")))))
  })

(:: rbSigLine (-> (Vec ASTNode) (Vec ASTNode) Names Int String))
(fn (rbSigLine decls params names i)
  (if (>= i (vecLen params))
    ""
    (concat
      (concat (rbParamName (vecGet names i)) (concat ": " (rbRustType decls (vecGet params i) 0)))
      (concat
        (if (< (+ i 1) (vecLen params))
          ", "
          "")
        (rbSigLine decls params names (+ i 1))))))

; A `&str` argument becomes an `AxString` for the call's duration; a
; data argument becomes an owned word released after it.
(:: rbArgLets (-> (Vec ASTNode) (Vec ASTNode) Names Int String))
(fn (rbArgLets decls params names i)
  (if (>= i (vecLen params))
    ""
    {
      (let t (vecGet params i))
      (let pn (rbParamName (vecGet names i)))
      (concat
        (if (== (rbIsString t) 1)
          (concat "    let __a"
            (concat (fmtInt i) (concat " = AxString::from_str(rt, " (concat pn ");\n"))))
          (if (== (rbIsOwnedWord decls t) 1)
            (concat "    let __a"
              (concat (fmtInt i) (concat " = " (concat (rbToWord t pn 1) ";\n"))))
            ""))
        (rbArgLets decls params names (+ i 1)))
    }))

(:: rbArgRels (-> (Vec ASTNode) (Vec ASTNode) Int String))
(fn (rbArgRels decls params i)
  (if (>= i (vecLen params))
    ""
    (concat
      (if (== (rbIsOwnedWord decls (vecGet params i)) 1)
        (concat "    unsafe { axiom_release(__a" (concat (fmtInt i) ") };\n"))
        "")
      (rbArgRels decls params (+ i 1)))))

(:: rbArgList (-> (Vec ASTNode) (Vec ASTNode) Names Int String))
(fn (rbArgList decls params names i)
  (if (>= i (vecLen params))
    ""
    {
      (let t (vecGet params i))
      (let pn (rbParamName (vecGet names i)))
      (concat
        (if (== (rbIsString t) 1)
          (concat "__a" (concat (fmtInt i) ".as_word()"))
          (if (== (rbIsOwnedWord decls t) 1)
            (concat "__a" (fmtInt i))
            (rbToWord t pn 0)))
        (concat
          (if (< (+ i 1) (vecLen params))
            ", "
            "")
          (rbArgList decls params names (+ i 1))))
    }))

; The result: the owned word `__r`, converted.
(:: rbResultExpr (-> ASTNode String String))
(fn (rbResultExpr res rty)
  (if (strEq rty "()")
    "    let _ = __r;\n"
    (if (== (rbIsString res) 1)
      "    // SAFETY: a String a function answers is an owned share (MM-LIFE-2c event 2).\n    unsafe { AxString::from_owned(__r) }\n"
      (concat "    " (concat (rbFromWord res "__r") "\n")))))

; `addTwo` -> `add_two`; `a-b` -> `a_b`; a Rust keyword gets a trailing
; underscore (`type_`).
;
; PRECONDITION: `s` is already a Rust identifier (`rbIsRustIdent`), so
; the `-` arm is unreachable today and the else arm is the identity.
; This is NOT a sanitiser and must not be used as one: every byte it
; does not recognise falls through that arm VERBATIM, which is how
; `a/*evil` became `pub fn a/*evil` in a generated file. All three call
; sites are gated instead - `rbOneFn` refuses a function name and a
; binder name that is not an identifier, `rbTypeNamesSpellable` refuses
; a struct field name that is not - and a fourth call site needs the
; same gate in front of it.
;
; Widening it to admit the rest of `isIdentChar` is not the repair it
; looks like. It is already non-injective on the bytes it DOES handle:
; `addTwo`, `add-two` and `add_two` all answer `add_two`, so three
; distinct exports would become one `pub fn`. Carrying `-` through
; needs `#[link_name = "<raw>"]` on the `extern "C"` declaration (the
; archive symbol stays the raw Axiom name) AND a collision check across
; the emitted set, neither of which exists yet; the `-` arm is left
; here as the start of that work, not as a licence to open the gate.
(:: rbSnake (-> String String))
(fn (rbSnake s)
  {
    (let out (strBuilderWithCapacity (* 2 (strLen s))))
    {
      (for i in 0..(strLen s)
        {
          (let b (strByte s i))
          (if (&& (>= b 65) (<= b 90))
            {
              (if (> i 0)
                (strBuilderPushByte out 95))
              (strBuilderPushByte out (+ b 32))
            }
            (strBuilderPushByte out
              (if (== b 45)
                95
                b)))
        })
      {
        (let r (strBuilderFinish out))
        (if (rbIsKeyword r)
          (concat r "_")
          r)
      }
    }
  })

; `rt` is the runtime token every wrapper takes first, so a binder that
; snake-cases to `rt` is written `rt_`, the way a keyword is.
(:: rbParamName (-> String String))
(fn (rbParamName s)
  {
    (let r (rbSnake s))
    (if (strEq r "rt")
      "rt_"
      r)
  })

(:: rbIsKeyword (-> String Bool))
(fn (rbIsKeyword s)
  (|| (strEq s "as")
    (|| (strEq s "box")
      (|| (strEq s "fn")
        (|| (strEq s "impl")
          (|| (strEq s "in")
            (|| (strEq s "loop")
              (|| (strEq s "match")
                (|| (strEq s "mod")
                  (|| (strEq s "move")
                    (|| (strEq s "mut")
                      (|| (strEq s "ref")
                        (|| (strEq s "self")
                          (|| (strEq s "type")
                            (|| (strEq s "use")
                              (|| (strEq s "where")
                                (|| (strEq s "let")
                                  (|| (strEq s "if")
                                    (|| (strEq s "else")
                                      (|| (strEq s "for")
                                        (|| (strEq s "while")
                                          (|| (strEq s "return")
                                            (|| (strEq s "struct")
                                              (|| (strEq s "enum")
                                                (|| (strEq s "trait")
                                                  (|| (strEq s "pub")
                                                    (|| (strEq s "crate")
                                                      (|| (strEq s "super")
                                                        (|| (strEq s "static")
                                                          (|| (strEq s "const")
                                                            (|| (strEq s "true")
                                                              (|| (strEq s "false")
                                                                (|| (strEq s "unsafe")
                                                                  (|| (strEq s "extern")
                                                                    (|| (strEq s "dyn")
                                                                      (|| (strEq s "async")
                                                                        (|| (strEq s "await")
                                                                          (|| (strEq s "break")
                                                                            (||
                                                                              (strEq s "continue")
                                                                              (strEq s
                                                                                "yield"))))))))))))))))))))))))))))))))))))))))

; A type spelled as the source spells it, for signatures, the doc
; line and the notes.
(:: rbSpellType (-> ASTNode String))
(fn (rbSpellType t)
  (if (nodeSame t nilNode)
    "?"
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_CON)
        (if (== (vecLen (nodeBChildren t)) 0)
          (rbSourceName (nodeAName t))
          (concat "("
            (concat (concat (rbSourceName (nodeAName t)) (rbSpellEach (nodeBChildren t) 0)) ")")))
        (if (== tag TAG_T_VAR)
          (rbSourceName (nodeAName t))
          (if (== tag TAG_T_ARR)
            (concat "(->" (concat (rbSpellSpine t) ")"))
            (if (== tag TAG_T_TUP)
              (if (== (vecLen (nodeAChildren t)) 0)
                "()"
                (concat "(Tuple" (concat (rbSpellEach (nodeAChildren t) 0) ")")))
              "?"))))
    }))

(:: rbSpellEach (-> (Vec ASTNode) Int String))
(fn (rbSpellEach v i)
  (if (>= i (vecLen v))
    ""
    (concat " " (concat (rbSpellType (vecGet v i)) (rbSpellEach v (+ i 1))))))

(:: rbSpellSpine (-> ASTNode String))
(fn (rbSpellSpine t)
  (if (&& (! (nodeSame t nilNode)) (== (nodeTag t) TAG_T_ARR))
    (concat " " (concat (rbSpellType (nodeAChild t)) (rbSpellSpine (nodeBChild t))))
    (concat " " (rbSpellType t))))
