; symbols.ax - `axiom symbols` (AXSYM), self-hosted: the foundation.
;
; AXSYM's grammar is one line per fact:
;
;   <KIND> <NAME> <FILE>:<LOC> "<TYPE>" @<nid> [#<meta>]*
;
; with `-` in place of the location for builtins. The type string is
; the type CHECKER's rendering - curried infix arrows, bare
; application arguments - not the source syntax the formatter prints:
; `(-> Int Int Int)` in source is `"(Int -> (Int -> Int))"` here,
; because that is what stage0's `TypeId::Display` emits and the
; criterion is its bytes.
;
; The `@nid` is FNV-1a 64 over `DKind:name`, in both compilers: a
; stable node ID needs a hash whose algorithm is specified, which Rust's
; `DefaultHasher` is not, and FNV-1a 64 is four lines in either
; language.
;
; Fact collection walks the checker's tables and lives beside them,
; so this module imports `typecheck.ax` (and `expand.ax` for
; `expGenOf`); this file is the rendering half, testable against
; cached stage0 output alone.
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Utf8)
(import core)
(import parser)
(import typecheck)
; for `expGenOf`: the (name, macro) pairs phase D answers, which is
; what marks a row `#generated` (MAC-TOOL-4).
(import expand)
(import diag)
(import raw)

; Decimal rendering is `Fmt.fmtInt`, which also covers the negative
; integers the local `symsDigits` it replaces could not spell.
; ------------------------------------------------------------------
; FNV-1a 64.
;
; offset basis 0xcbf29ce484222325 exceeds 2^63, so it is spelled as
; the negative decimal of the same bit pattern - hex literals do not
; exist and `*`/`^` wrap mod 2^64, which is exactly what FNV wants.
; ------------------------------------------------------------------
(pub :: fnv1a64 (-> String Int))
(pub fn (fnv1a64 s)
  {
    (let mut h (- 0 3750763034362895579))
    (let n (strLen s))
    {
      (for i in 0..n
        (set h (* (^ h (strByte s i)) 1099511628211)))
      h
    }
  })

; The 16-digit zero-padded lowercase hex of a 64-bit value, treated
; as unsigned. `fmtHexDigits` divides, and division is signed, so a
; hash with the top bit set needs its nibbles extracted by shift and
; mask instead: an arithmetic shift sign-fills only ABOVE bit 3, and
; `& 15` keeps bits 0-3, so every nibble comes out true.
(pub :: symHex16 (-> Int String))
;@axiom:effect(unsafe)
(pub fn (symHex16 h)
  {
    (let out (strAlloc 16))
    {
      (for k in 0..16
        {
          (let nib (& (>> h (* 4 (- 15 k))) 15))
          (__store8 (strData out) k
            (if (< nib 10)
              (+ 48 nib)
              (+ 87 nib)))
        })
      out
    }
  })

(:: symNid (-> String String String))
(fn (symNid kindKey name)
  (symHex16 (fnv1a64 (concat kindKey name))))

; ------------------------------------------------------------------
; The type checker's type rendering: `TypeId::Display`, over the
; TAG_T_* nodes of parser.ax.
;
;   TError        {unknown}
;   TVar          name
;   TCon          name, or `name arg arg` with each arg rendered
;                 recursively and NO wrapping parens of its own
;   TArr          (a -> b), fully parenthesised, right-nested
;   TTuple        (a, b); the empty tuple is `()`
;   TList         [a]
;   TPtr          *a
; ------------------------------------------------------------------
(pub :: symTy (-> ASTNode String))
(pub fn (symTy t)
  (if (nodeSame t nilNode)
    "{unknown}"
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_ERR)
        "{unknown}"
        (if (== tag TAG_T_VAR)
          (nodeAName t)
          (if (== tag TAG_T_CON)
            {
              (let args (nodeBChildren t))
              (if (|| (== (as args Int) 0) (== (vecLen args) 0))
                (srcSpelling (nodeAName t))
                {
                  (let s (strBuilderPush strBuilderNew (srcSpelling (nodeAName t))))
                  {
                    ; The keyword's range shape mirrors `range` binding
                    ; for binding, so this is a spelling change and
                    ; nothing else. First `for` in the compiler's own
                    ; sources: the seed learned the keyword at ea78e37,
                    ; and this site is what proves a seeded compiler
                    ; builds a tree that uses it.
                    (for i in 0..(vecLen args)
                      (strBuilderPush s (concat " " (symTy (vecGet args i)))))
                    (strBuilderFinish s)
                  }
                })
            }
            (if (== tag TAG_T_ARR)
              (concat "("
                (concat (symTy (nodeAChild t)) (concat " -> " (concat (symTy (nodeBChild t)) ")"))))
              (if (== tag TAG_T_TUP)
                {
                  (let xs (nodeAChildren t))
                  (let s (strBuilderPush strBuilderNew "("))
                  {
                    (if (! (== (as xs Int) 0))
                      (for i in 0..(vecLen xs)
                        {
                          (if (> i 0)
                            (strBuilderPush s ", "))
                          (strBuilderPush s (symTy (vecGet xs i)))
                        }))
                    (concat (strBuilderFinish s) ")")
                  }
                }
                (if (== tag TAG_T_PTR)
                  (concat "*" (symTy (nodeAChild t)))
                  "{unknown}"))))))
    }))

; ------------------------------------------------------------------
; A row's fresh type variables, numbered from that row (AN-37).
;
; The checker names a fresh variable from one counter that runs over
; the whole module (`freshTVar`, `freshInstVar`), so an unsigned
; function's printed type moved when unrelated declarations were added:
; `adder` in `tests/selfhost/770-over-application.ax` read
; `(Int -> (_t3 -> _t3))`, and `(Int -> (_t13 -> _t13))` with ten
; functions appended. The number told a reader nothing. Each function's
; type is generalised on its own, so two rows never share a fresh
; variable. Each row now numbers its own from 0 in order of first
; appearance, `_t` and `_i` separately. A signature can't spell `_t5`
; (`AX3002`: no type of that name), so every such name is the
; checker's. Renumbering a renumbered row changes nothing, which lets
; the `.axir` read-back pass its headers through the same function.
; ------------------------------------------------------------------
(:: symNameByte (-> Int Bool))
(fn (symNameByte c)
  (|| (strIsDigit c) (|| (strIsAlpha c) (== c 95))))

; The bytes a type's printer writes before a name: a space, `(`, `[`,
; `{`, `,` and the `*` of a pointer.
(:: symFreshOpens (-> Int Bool))
(fn (symFreshOpens c)
  (|| (== c 32) (|| (== c 40) (|| (== c 91) (|| (== c 123) (|| (== c 44) (== c 42)))))))

; The end of a fresh variable's name starting at `i`, or `i` when none
; starts there: `_t` or `_i`, then digits, with no name byte on either
; side.
(:: symFreshEnd (-> String Int Int Int))
(fn (symFreshEnd ty i n)
  (if (&& (< (+ i 2) n)
        (&& (== (strByte ty i) 95)
          (&& (|| (== (strByte ty (+ i 1)) 116) (== (strByte ty (+ i 1)) 105))
            (&& (strIsDigit (strByte ty (+ i 2)))
              (|| (== i 0) (symFreshOpens (strByte ty (- i 1))))))))
    {
      (let mut j (+ i 2))
      {
        (while (&& (< j n) (strIsDigit (strByte ty j)))
          (set j (+ j 1)))
        (if (&& (< j n) (symNameByte (strByte ty j)))
          i
          j)
      }
    }
    i))

(pub :: symDigitsValue (-> String Int Int Int))
(pub fn (symDigitsValue s i j)
  {
    (let mut v 0)
    {
      (for k in i..j
        (set v (+ (* v 10) (- (strByte s k) 48))))
      v
    }
  })

; The position of `v` in `seen`, appending it when absent.
(:: symFreshIndex (-> Ints Int Int))
(fn (symFreshIndex seen v)
  {
    (let mut i 0)
    (let mut at (- 0 1))
    {
      (while (&& (< i (vecLen seen)) (< at 0))
        {
          (if (== (vecGet seen i) v)
            (set at i))
          (set i (+ i 1))
        })
      (if (< at 0)
        {
          (vecPush seen v)
          (- (vecLen seen) 1)
        }
        at)
    }
  })

(pub :: symFreshNames (-> String String))
(pub fn (symFreshNames ty)
  {
    (let n (strLen ty))
    (let tvars (:: vecNew Ints))
    (let ivars (:: vecNew Ints))
    (let out strBuilderNew)
    (let mut from 0)
    (let mut i 0)
    {
      (while (< i n)
        {
          (let j (symFreshEnd ty i n))
          (if (== j i)
            (set i (+ i 1))
            {
              (let tee (== (strByte ty (+ i 1)) 116))
              {
                (strBuilderPush out (strSlice ty from (- i from)))
                (strBuilderPush out
                  (concat
                    (if tee
                      "_t"
                      "_i")
                    (fmtInt
                      (symFreshIndex
                        (if tee
                          tvars
                          ivars)
                        (symDigitsValue ty (+ i 2) j)))))
                (set from j)
                (set i j)
              }
            })
        })
      (if (== from 0)
        ty
        (concat (strBuilderFinish out) (strSlice ty from (- n from))))
    }
  })

; ------------------------------------------------------------------
; One AXSYM line. The location string is the caller's - it owns the
; file registry and the char-column conversion - and `-` means
; builtin. An empty `nid` is OMITTED, not printed empty: constructor
; facts carry none (measured: `C Some - "(a -> Option a)" #of=Option`
; has no `@`). Metas arrive as a Vec of ready `key=value` strings and
; print in order, each as ` #meta`.
; ------------------------------------------------------------------
(pub :: symLine (-> String String String String String Strings String))
(pub fn (symLine kind name loc ty nid metas)
  {
    (let s (strBuilderPush strBuilderNew kind))
    {
      (strBuilderPush s (concat " " name))
      (strBuilderPush s (concat " " loc))
      (strBuilderPush s (concat " \"" (concat (symFreshNames ty) "\"")))
      (if (> (strLen nid) 0)
        (strBuilderPush s (concat " @" nid)))
      {
        (let mut i 0)
        (if (! (== (as metas Int) 0))
          (while (< i (vecLen metas))
            {
              (strBuilderPush s (concat " #" (vecGetStr metas i)))
              (set i (+ i 1))
            }))
      }
      (concat (strBuilderFinish s) "\n")
    }
  })

; ------------------------------------------------------------------
; Fact collection.
;
; stage0 walks its checker tables for the facts and its AST for the
; spans; this walks stage1's TC tables and the resolved declaration
; list the same way. Keys are the REGISTERED names - imported
; declarations arrive pre-mangled to `Mod$name`, which is stage0's
; (name, module) pair spelled as one string - and the printed name is
; the bare half. Maps are parallel Vecs with linear lookup: a module
; has tens of declarations, not thousands.
; ------------------------------------------------------------------
(pub :: saIdx (-> Strings String (Option Int)))
(pub fn (saIdx names key)
  {
    (let mut i 0)
    (let mut hit (:: None (Option Int)))
    {
      (while (< i (vecLen names))
        {
          (if (&& (isNone hit) (strEq (vecGetStr names i) key))
            (set hit (Some i)))
          (set i (+ i 1))
        })
      hit
    }
  })

; Insert-or-overwrite (stage0's `insert`).
(:: saPut (-> Strings (Vec a) String a Int))
(fn (saPut names vals key val)
  (match (saIdx names key)
    ((None)
      {
        (vecPush names key)
        (vecPush vals val)
        0
      }
    )
    ((Some i)
      {
        (vecSet vals i val)
        0
      }
    )))

; Insert only when absent, with the one lookup `saPut` makes. The NID
; variants use it for a signature, which names a function only when no
; `fn` does (AN-41).
(pub :: saPutIfAbsent (-> Strings (Vec a) String a Int))
(pub fn (saPutIfAbsent names vals key val)
  (if (isNone (saIdx names key))
    {
      (vecPush names key)
      (vecPush vals val)
      0
    }
    0))

; Insert-if-absent (stage0's `or_insert`).
(:: saPutSoft (-> Strings (Vec a) String a Int))
(fn (saPutSoft names vals key val)
  (if (isNone (saIdx names key))
    {
      (vecPush names key)
      (vecPush vals val)
      0
    }
    0))

; The two-value variants, for one names Vec shared by TWO value Vecs
; (a span AND a unit). The single-value put breaks lockstep there: the
; first put pushes the name, the second then finds it present and
; `vecSet`s into a value Vec that has no such slot yet.
(pub :: saPut2 (-> Strings (Vec a) (Vec b) String a b Int))
(pub fn (saPut2 names v1 v2 key a b)
  (match (saIdx names key)
    ((None)
      {
        (vecPush names key)
        (vecPush v1 a)
        (vecPush v2 b)
        0
      }
    )
    ((Some i)
      {
        (vecSet v1 i a)
        (vecSet v2 i b)
        0
      }
    )))

(:: saPutSoft2 (-> Strings (Vec a) (Vec b) String a b Int))
(fn (saPutSoft2 names v1 v2 key a b)
  (if (isNone (saIdx names key))
    {
      (vecPush names key)
      (vecPush v1 a)
      (vecPush v2 b)
      0
    }
    0))

; Missing keys are None. Some retains the stored vector, including an
; empty one; lookup does not copy or mutate the parser's collections.
(:: saGetVec (-> Strings (Vec (Vec a)) String (Option (Vec a))))
(fn (saGetVec names vals key)
  (match (saIdx names key)
    ((None) None)
    ((Some i) (Some (vecGet vals i)))))

(pub :: saGetNames (-> Strings (Vec Names) String (Option Names)))
(pub fn (saGetNames names vals key)
  (match (saIdx names key)
    ((None) None)
    ((Some i) (Some (vecGet vals i)))))

(pub :: saGetNode (-> Strings Nodes String (Option ASTNode)))
(pub fn (saGetNode names vals key)
  (match (saIdx names key)
    ((None) None)
    ((Some i)
      {
        (let node (vecGet vals i))
        (if (nodeSame node nilNode)
          None
          (Some node))
      }
    )))

; Byte-wise ascending insertion sort, in place: stage0's effect list
; arrives sorted (probed: `Beta,zeta`), and byte order is what Rust's
; string ordering is.
; Whether `v` holds `x`, from index `i` on.
(:: smHasIndex (-> Ints Int Int Bool))
(fn (smHasIndex v x i)
  (if (>= i (vecLen v))
    false
    (if (== (vecGet v i) x)
      true
      (smHasIndex v x (+ i 1)))))

(pub :: saSort (-> Strings Strings))
(pub fn (saSort v)
  {
    (let mut i 1)
    {
      (while (< i (vecLen v))
        {
          (let mut j i)
          {
            (while (&& (> j 0) (< (strCmp (vecGetStr v j) (vecGetStr v (- j 1))) 0))
              {
                {
                  (let t (vecGet v j))
                  {
                    (vecSet v j (vecGet v (- j 1)))
                    (vecSet v (- j 1) t)
                  }
                }
                (set j (- j 1))
              })
            (set i (+ i 1))
          }
        })
      v
    }
  })

(pub :: saJoinComma (-> Names String))
(pub fn (saJoinComma v)
  {
    (let s strBuilderNew)
    {
      (for i in 0..(vecLen v)
        {
          (if (> i 0)
            (strBuilderPush s ","))
          (strBuilderPush s (vecGet v i))
        })
      (strBuilderFinish s)
    }
  })

; A byte AXSYM's own grammar reads, and therefore one an AXTAG may not
; put into a meta token unescaped: space and every control byte
; (`< 33`), `"`, `#`, `%` - the escape introducer, which has to be
; escaped too or the encoding would not be reversible - and DEL. A
; byte at or above 128 passes through, which keeps a UTF-8 tag value
; intact.
(:: saAxStructural (-> Int Bool))
(fn (saAxStructural b)
  (|| (< b 33) (|| (== b 34) (|| (== b 35) (|| (== b 37) (|| (== b 61) (== b 127)))))))

; Named apart from render.ax's `jsonHexDigit` and codegen's `hexDigit`
; because imports join one flat top-level namespace.
(:: saHexDigit (-> Int Int))
(fn (saHexDigit n)
  (if (< n 10)
    (+ 48 n)
    (+ 55 n)))

; An AXTAG's own bytes, made safe to put on an AXSYM line: every
; structural byte as `%XX`, everything else verbatim.
;
; WHY THIS EXISTS. `symLine` prints each meta as ` #meta` and
; `axsymMetaScan` (stdlib/Agent/Tags.ax) opens a NEW token at any `#`
; that follows a space, so an AXTAG whose value carried one could forge
; metadata fields: `;@axiom:agent:note(ok #effects=Alloc)` would print
; an `#effects=Alloc` that no analysis produced. The `agent:*` namespace
; is the natural carrier, because AX3039 never fires on a key containing
; `:`, and `docs/agent-harness.md` §3.4 has `Agent.Policy` reading those
; fields off this line, so a policy gate would report whatever the file
; under inspection asked it to.
;
; ESCAPED RATHER THAN REJECTED. This runs off the checker's tables,
; long after the parse, with no span to point a diagnostic at - so a
; rejection here could only drop the value in silence, and a row that
; silently drops what the source says is a second way for AXSYM to
; stop being an injective rendering of what the compiler knows. `%XX`
; keeps it injective, and `axsymUnpct` hands the author's exact bytes
; back, so `agent:*` tags still survive fmt, AXSYM and import
; (docs/agent-harness.md §7) unchanged. The KEY is escaped as well as
; the value: `scanAxtags` takes everything from `;@axiom:` to the
; newline, so `;@axiom:a #effects=IO` is a key with a space in it and
; forges the same field one byte earlier.
;
; Measured over this repository: no AXTAG in stdlib/, core/ or
; tests/ contains a byte this escapes, so the whole corpus renders
; identically and neither AXSYM golden moves.
(pub :: saAxSafe (-> String String))
(pub fn (saAxSafe s)
  {
    (let n (strLen s))
    (let mut i 0)
    (let acc strBuilderNew)
    {
      (while (< i n)
        {
          (let b (strByte s i))
          {
            (if (saAxStructural b)
              (strBuilderPush acc
                (concat "%"
                  (concat (strFromByte (saHexDigit (/ b 16))) (strFromByte (saHexDigit (% b 16))))))
              (strBuilderPush acc (strSlice s i 1)))
            (set i (+ i 1))
          }
        })
      (strBuilderFinish acc)
    }
  })

; An AXTAG's content as its AXSYM meta: `effect(io)` is `effect=io`,
; a bare or empty-parens tag is its key alone - the value runs from
; the first `(` to the LAST `)`, exactly stage0's parse. Both halves
; go through `saAxSafe`; the `=` between them is the compiler's, not
; the author's.
;
; `=` IS A STRUCTURAL BYTE. A PARENLESS tag has no halves to join, so
; its whole content is the key, and unescaped, `;@axiom:restrict=no-io`
; would render `#restrict=no-io`, byte for byte what a VERIFIED
; `restrict(no-io)` renders, on a body the compiler refused to make that
; claim about. A value could carry one too: `;@axiom:pre(== n 0)`.
;
; Escaping it makes the separator the compiler writes the only
; unescaped `=` on the line. It does not close the whole hole - a key is still forgeable
; through the PARENTHESISED form - and `axtagReservedKey`
; (core/typecheck.ax) is that half.
(pub :: saAxMeta (-> String String))
(pub fn (saAxMeta content)
  {
    (let n (strLen content))
    (let mut paren (- 0 1))
    (let mut i 0)
    {
      (while (< i n)
        {
          (if (&& (< paren 0) (== (strByte content i) 40))
            (set paren i))
          (set i (+ i 1))
        })
      (if (< paren 0)
        (saAxSafe content)
        {
          (let mut close (- n 1))
          {
            (while (&& (> close paren) (!= (strByte content close) 41))
              (set close (- close 1)))
            (if (<= (- close paren) 1)
              (saAxSafe (strSlice content 0 paren))
              (concat (saAxSafe (strSlice content 0 paren))
                (concat "=" (saAxSafe (strSlice content (+ paren 1) (- close (+ paren 1)))))))
          }
        })
    }
  })

; The unit index a module's declarations render against: unit 0 is
; the entry file; an import's unit carries its module name. None means
; no row exists, including an empty table. Some 0 is the real entry row.
(pub :: saUnitOf (-> Units (Option String) (Option Int)))
(pub fn (saUnitOf units module)
  (if (== (vecLen units) 0)
    None
    (match module
      ((None) (Some 0))
      ((Some name)
        {
          (let mut i 1)
          (let mut hit (:: None (Option Int)))
          (while (< i (vecLen units))
            {
              (if (&& (isNone hit) (unitNameIs (vecGet units i) name))
                (set hit (Some i)))
              (set i (+ i 1))
            })
          hit
        }
      ))))

; The whole collection state, one handle: parallel-vec maps for the
; three span namespaces, ctor spans, nid variants, axtags, and fn
; parameter names.
(pub struct SymMaps
  (fnN : Names)
  (fnS : (Vec Int))
  (fnU : Ints)
  (tyN : Names)
  (tyS : (Vec Int))
  (tyU : Ints)
  (ctN : Names)
  (ctS : (Vec Int))
  (ctU : Ints)
  (nidN : Names)
  (nidV : Names)
  (tagN : Names)
  (tagV : (Vec Axtags))
  (prmN : Names)
  (prmV : (Vec Names))
  (opN : Names)
  (opV : Nodes)
  (mcN : Names)
  (mcS : (Vec Int))
  (mcU : Ints)
  (efN : Names)
  (efS : (Vec Int))
  (efU : Ints)
  (fnD : (Vec ASTNode)))

; Macros have rows, so public macros such as `println` and `format` are
; API this stream can see.
; The effect DECLARATION itself. Its operations were already keyed
; (slots 18/19), which is what a handler needs; the effect's own name
; had no row, so `Assert` was public API outside the stream.
; The `fn` DECLARATION NODE, on slot 16's key, so that a reader who
; has the parameter names can also reach the body they belong to.
; `axir.ax` lowers it to the mid-level IR for the `blk`/`op`/`term`
; lines under `--mir`.
;
; A SECOND VALUE ON ONE KEY, not a second map. `saIdx` is a linear
; scan and this map is one entry per declared function - 4,098 of
; them for `core/main.ax` - so a parallel map keyed the same way
; would have cost a second scan per put AND per get, quadratically,
; to answer the question this one is already standing next to.
; `saPut2` is what the span maps already do for exactly this shape.
(pub :: smNew SymMaps)
(pub fn (smNew)
  (SymMaps
    :fnN vecNew
    :fnS vecNew
    :fnU vecNew
    :tyN vecNew
    :tyS vecNew
    :tyU vecNew
    :ctN vecNew
    :ctS vecNew
    :ctU vecNew
    :nidN vecNew
    :nidV vecNew
    :tagN vecNew
    :tagV vecNew
    :prmN vecNew
    :prmV vecNew
    :opN vecNew
    :opV vecNew
    :mcN vecNew
    :mcS vecNew
    :mcU vecNew
    :efN vecNew
    :efS vecNew
    :efU vecNew
    :fnD vecNew))

; One declaration into the maps. The rules are stage0's exactly:
; DSig overwrites a function span, DFn only fills an absent one;
; the nid variant is the `fn` when there is one, whichever comes
; last, and the signature only when there is no `fn` (AN-41);
; the axtag set is the last NON-EMPTY one.
; A GENERATED declaration is not a symbol. `show` derives a structural
; renderer named `show#Point` or `show#(Option Int)`, and the trait
; lowering appended `Trait#Type#method` before 0.6.0; both are the
; compiler's business: `symbols` reports what the file declares, and
; the position verifier is right to refuse a claim the source does not
; spell. `#` is not an identifier byte, so a name that contains one
; cannot have been written.
(pub :: smGenerated (-> String Bool))
(pub fn (smGenerated name)
  (if (let (Some _) (strFindByte name 35 0))
    true
    false))

(pub :: smCollect (-> SymMaps ASTNode Units Int))
(pub fn (smCollect sm d units)
  (if (smGenerated (nodeAName d))
    0
    {
      (let tag (nodeTag d))
      (let name (nodeAName d))
      ; Unknown provenance renders against the entry source when it exists.
      ; Keep that output policy at the consumer, rather than making the
      ; lookup report a successful row for a missing module.
      (let u
        (match (saUnitOf units (nodeModuleOpt d))
          ((None) 0)
          ((Some index) index)))
      {
        (if (== tag TAG_D_SIG)
          {
            (saPut2 sm.fnN sm.fnS sm.fnU name (nodeSpan d) u)
            ; A signature names the function's NID only when no `fn`
            ; does: otherwise moving a `::` below its definition would
            ; give the function a new identity, which the compatibility
            ; check reads as one function removed and another added
            ; (AN-41). The `fn` arm below always writes `DFn:`.
            (saPutIfAbsent sm.nidN sm.nidV name "DSig:")
            (smTags sm d name)
          }
          (if (== tag TAG_D_FN)
            {
              (saPutSoft2 sm.fnN sm.fnS sm.fnU name (nodeSpan d) u)
              (smNid sm name "DFn:")
              (smTags sm d name)
              (saPut2 sm.prmN sm.prmV sm.fnD name (nodeBNames d) d)
            }
            (if (== tag TAG_D_DATA)
              {
                (saPut2 sm.tyN sm.tyS sm.tyU name (nodeSpan d) u)
                (smNid sm name "DData:")
                (smTags sm d name)
                {
                  (let ctors (nodeBChildren d))
                  (let mut i 0)
                  (while (< i (vecLen ctors))
                    {
                      (let c (vecGet ctors i))
                      {
                        (saPut2 sm.ctN sm.ctS sm.ctU (nodeAName c) (nodeSpan c) u)
                        (set i (+ i 1))
                      }
                    })
                }
              }
              (if (== tag TAG_D_STRUCT)
                {
                  (saPut2 sm.tyN sm.tyS sm.tyU name (nodeSpan d) u)
                  (smNid sm name "DStruct:")
                  (smTags sm d name)
                }
                (if (== tag TAG_D_ALIAS)
                  {
                    (saPut2 sm.tyN sm.tyS sm.tyU name (nodeSpan d) u)
                    (smNid sm name "DType:")
                    (smTags sm d name)
                  }
                  (if (== tag TAG_D_MACRO)
                    {
                      (saPut2 sm.mcN sm.mcS sm.mcU name (nodeSpan d) u)
                      (smNid sm name "DMacro:")
                      (smTags sm d name)
                    }
                    (if (== tag TAG_D_EXTERN)
                      ; An `extern` item has a LOCATION: the item in its block,
                      ; keyed like a signature so `symbols` and the LSP point at
                      ; it rather than answering `builtin` (the checker registers
                      ; it as a function with no span of its own)
                      {
                        (let items (nodeCChildren d))
                        (let mut i 0)
                        (if (! (== (as items Int) 0))
                          (while (< i (vecLen items))
                            {
                              (let f (vecGet items i))
                              {
                                (let key
                                  (if (== (nodeModule d) 0)
                                    (nodeAName f)
                                    (concat (concat (nodeModuleName d) "$") (nodeAName f))))
                                {
                                  (saPut2 sm.fnN sm.fnS sm.fnU key (nodeSpan f) u)
                                  (smNid sm key "DExtern:")
                                  (set i (+ i 1))
                                }
                              }
                            }))
                      }
                      (if (== tag TAG_D_EFFECT)
                        ; Operation types, keyed under both spellings the checker
                        ; registers ops with - AND the effect's own name.
                        ;
                        ; `smTags` renders an `effect`'s AXTAGs on its `E` row:
                        ; `;@axiom:unhandled(trap)` is a claim the compiler acts
                        ; on, and a policy gate reading AXSYM lists which effects
                        ; may abort from `#unhandled=trap` here.
                        {
                          (let fields (nodeCChildren d))
                          (let mut i 0)
                          (let _t (smTags sm d name))
                          (let _e (saPut2 sm.efN sm.efS sm.efU name (nodeSpan d) u))
                          (let _n (smNid sm name "DEffect:"))
                          (if (! (== (as fields Int) 0))
                            (while (< i (vecLen fields))
                              {
                                (let f (vecGet fields i))
                                {
                                  (saPut sm.opN sm.opV (nodeAName f) (nodeBChild f))
                                  (if (! (== (nodeModule d) 0))
                                    (saPut sm.opN sm.opV
                                      (concat (concat (nodeModuleName d) "$") (nodeAName f))
                                      (nodeBChild f)))
                                  (set i (+ i 1))
                                }
                              }))
                        }))))))))
        0
      }
    }))

(pub :: smNid (-> SymMaps String String Int))
(pub fn (smNid sm name variant)
  (saPut sm.nidN sm.nidV name variant))

; The AXTAGs of one NAME are the UNION of the sets on every declaration
; carrying it - a function has two, its `::` and its `fn`, and an author
; may write a tag above either.
;
; Keeping only one set would lose a tag in the report: an
; `effect(pure)` above the `::` and a `no_refactor` above the `fn` would
; render one of the two. The checker reads the two sets separately, but
; a policy gate reading a `#restrict=` manifest off AXSYM must see a
; restriction written above a signature.
;
; The union is built into a NEW Vec. The stored sets are the parser's
; own declaration words, and a renderer that appended to one would be
; mutating the AST to print it - the same rule `#calls=` follows below
; when it sorts a copy.
(pub :: smTags (-> SymMaps ASTNode String Int))
(pub fn (smTags sm d name)
  (match (nodeAxtagsOpt d)
    ((None)
      (saPutSoft sm.tagN sm.tagV name (:: vecNew Axtags))
    )
    ((Some tags)
      (if (== (vecLen tags) 0)
        (saPutSoft sm.tagN sm.tagV name tags)
        (match (saGetVec sm.tagN sm.tagV name)
          ((None) (saPut sm.tagN sm.tagV name tags))
          ((Some have)
            (if (== (vecLen have) 0)
              (saPut sm.tagN sm.tagV name tags)
              (saPut sm.tagN sm.tagV name (smTagsUnion have tags)))
          )))
    )))

; `have` first, in its own order, then every tag of `more` whose text
; is not already present - so the row reads in source order, the
; signature's tags before the function's, and a tag written on both
; renders once.
(:: smTagsUnion (-> Axtags Axtags Axtags))
(fn (smTagsUnion have more)
  {
    (let out vecNew)
    (let mut i 0)
    {
      (while (< i (vecLen have))
        {
          (vecPush out (vecGet have i))
          (set i (+ i 1))
        })
      (set i 0)
      (while (< i (vecLen more))
        {
          (let tag (vecGet more i))
          (if (! (== (smTagsHas out tag.content) 1))
            (vecPush out (vecGet more i)))
          (set i (+ i 1))
        })
      out
    }
  })

(:: smTagsHas (-> Axtags String Int))
(fn (smTagsHas tags txt)
  {
    (let mut i 0)
    (let mut hit 0)
    {
      (while (< i (vecLen tags))
        {
          (let tag (vecGet tags i))
          (if (strEq tag.content txt)
            (set hit 1))
          (set i (+ i 1))
        })
      hit
    }
  })

(pub :: smBuild (-> (Vec ASTNode) Units SymMaps))
(pub fn (smBuild decls units)
  {
    (let sm smNew)
    (let mut i 0)
    {
      (while (< i (vecLen decls))
        {
          (smCollect sm (vecGet decls i) units)
          (set i (+ i 1))
        })
      sm
    }
  })

; ------------------------------------------------------------------
; Emission: fn facts, then each data with its constructors, then
; structs, aliases, traits - stage0's table order.
; ------------------------------------------------------------------
; The three parallel maps of a span namespace, selected by the slot
; numbers callers name them by: functions 0/1/2, types 3/4/5,
; constructors 9/10/11, macros 20/21/22 and effects 23/24/25.
(:: smNameMap (-> SymMaps Int Names))
(fn (smNameMap sm k)
  (if (== k 3)
      sm.tyN
    (== k 9)
      sm.ctN
    (== k 20)
      sm.mcN
    (== k 23)
      sm.efN
    sm.fnN))

(:: smSpanMap (-> SymMaps Int (Vec Int)))
(fn (smSpanMap sm k)
  (if (== k 4)
      sm.tyS
    (== k 10)
      sm.ctS
    (== k 21)
      sm.mcS
    (== k 24)
      sm.efS
    sm.fnS))

(:: smUnitMap (-> SymMaps Int Ints))
(fn (smUnitMap sm k)
  (if (== k 5)
      sm.tyU
    (== k 11)
      sm.ctU
    (== k 22)
      sm.mcU
    (== k 25)
      sm.efU
    sm.fnU))

; The location string for `key` in the span namespace held at map
; slots (nIx, sIx, uIx), or None when the name has no recorded span.
(pub :: smLocReal (-> SymMaps Int Int Int String Units (Option String)))
(pub fn (smLocReal sm nIx sIx uIx key units)
  (match (saIdx (smNameMap sm nIx) key)
    ((None) None)
    ((Some i)
      {
        (let sp (vecGet (smSpanMap sm sIx) i))
        (if (== sp 0)
          None
          {
            (let index (vecGet (smUnitMap sm uIx) i))
            (if (|| (< index 0) (>= index (vecLen units)))
              None
              {
                (let unit (vecGet units index))
                (Some (concat (unitFile unit) (concat ":" (fmtSpan (unitSrc unit) sp))))
              })
          })
      }
    )))

; The nid for `key`, or None for a name with no recorded declaration
; (builtins, effect operations).
(pub :: smNidFor (-> SymMaps String (Option String)))
(pub fn (smNidFor sm key)
  (match (saIdx sm.nidN key)
    ((None) None)
    ((Some i) (Some (symNid (vecGetStr sm.nidV i) (bareOf key))))))

; AXSYM and AXIR spell an absent location as `-` and omit an absent NID.
; Keep those wire encodings at the rendering boundary.
(pub :: smLocWire (-> (Option String) String))
(pub fn (smLocWire loc)
  (match loc
    ((None) "-")
    ((Some value) value)))

(pub :: smNidWire (-> (Option String) String))
(pub fn (smNidWire nid)
  (match nid
    ((None) "")
    ((Some value) value)))

; The AXTAG metas for `key`, pushed in source order.
;
; EVERY CALLER PUSHES THESE FIRST, and the compiler's own derived keys
; - `effects=`, `effect-params=`, `generated=`, `ctors=`, `fields=`,
; `tyvars=`, `methods=` - after them. That ordering is the second half
; of the forgery fix `saAxSafe` opens, and it is the half that still
; holds if a future escape misses a byte: `symTagFrom`
; (stdlib/Agent/Tags.ax) answers the LAST `#key` on the line, so a
; compiler-owned key can no longer be shadowed by anything a file
; contains, whether the collision arrives through a value (` #effects=`
; inside an AXTAG value) or through the key itself.
;
; The key collision is real and is NOT what `saAxSafe` closes:
;
;   ;@axiom:effects(Alloc)
;   (fn (leak n) { (println "io") n })
;
; is a well-formed AXTAG. It draws AX3065 - a reserved key, an error -
; and with the author's tags after the derived keys it would render
; `#effects=Alloc #effects=IO`, first match `Alloc`, on a function that
; writes to stdout. That is why the ordering is stated here rather than
; left to whichever site is read first.
(pub :: smTagMetas (-> SymMaps String Strings Int))
(pub fn (smTagMetas sm key metas)
  {
    (if (let (Some tags) (saGetVec sm.tagN sm.tagV key))
      {
        (let mut i 0)
        (while (< i (vecLen tags))
          {
            (let tag (vecGet tags i))
            (vecPush metas (saAxMeta tag.content))
            (set i (+ i 1))
          })
      })
    0
  })

; ------------------------------------------------------------------
; The human table.
;
; `symbols` prints AXSYM by default and printed it under every format,
; which was the last of the three divergences the self-hosting record
; recorded OPEN: stage0's bare `symbols` printed an aligned table and
; only `--diagnostic-format=ai` gave AXSYM. The flag surface matched;
; the default did not.
;
; Derived from the AXSYM text by re-reading it, not by threading a mode
; through fact collection. Two reasons. The fact walk is four hundred
; lines with a dozen `symLine` call sites, and a second renderer
; interleaved through it is a second place for a fact to go missing.
; And a table derived from AXSYM cannot disagree with AXSYM about what
; the symbols are - which is a property the gate would otherwise have
; had to check, and now gets for free.
;
; stage0's format, verbatim: `{:<8} {:<20} {:<40} [{}]`, with the kind
; as its Rust variant name and a spanless fact reading `builtin` where
; AXSYM writes `-`. Columns are padded in CHARACTERS, so a non-ASCII
; name pads to the width a reader sees.
; ------------------------------------------------------------------
(pub :: symKindWord (-> String String))
(pub fn (symKindWord k)
  (if (strEq k "F")
    "Fn"
    (if (strEq k "D")
      "Data"
      (if (strEq k "C")
        "Ctor"
        (if (strEq k "S")
          "Struct"
          (if (strEq k "A")
            "Alias"
            (if (strEq k "E")
              "Effect"
              (if (strEq k "M")
                "Macro"
                k))))))))

; Characters, not bytes - the same rule every column in this compiler
; counts by.
(:: symCharLen (-> String Int))
(fn (symCharLen s)
  {
    (let n (strLen s))
    (let mut i 0)
    (let mut c 0)
    {
      (while (< i n)
        {
          (if (! (utf8IsCont (strByte s i)))
            (set c (+ c 1)))
          (set i (+ i 1))
        })
      c
    }
  })

(:: symPad (-> String Int String))
(fn (symPad s w)
  {
    (let have (symCharLen s))
    (if (>= have w)
      s
      {
        (let out (strAlloc (- w have)))
        (let mut i 0)
        {
          (while (< i (- w have))
            {
              (memPutByte (strData out) i 32)
              (set i (+ i 1))
            })
          (concat s out)
        }
      })
  })

; One past the last byte of the line starting at `i`.
; The byte after the next space at or after `i`, and the field before
; it. Fields one to three of an AXSYM line are space-delimited and
; contain no spaces; the type that follows them is quoted and may.
(:: symField (-> String Int Int Int))
(fn (symField s i e)
  {
    (let mut j i)
    {
      (while (&& (< j e) (!= (strByte s j) 32))
        (set j (+ j 1)))
      j
    }
  })

(pub :: symbolsHumanTable (-> String String))
(pub fn (symbolsHumanTable axsym)
  {
    (let n (strLen axsym))
    (let parts vecNew)
    (let mut i 0)
    {
      (while (< i n)
        {
          (let e (lineEndFrom axsym i))
          {
            (if (> e i)
              ; the type is quoted; take what is between
              ; the first `"` after the location and the
              ; last one on the line
              {
                (let k1 (symField axsym i e))
                {
                  (let k2 (symField axsym (+ k1 1) e))
                  {
                    (let k3 (symField axsym (+ k2 1) e))
                    {
                      (let kind (strSlice axsym i (- k1 i)))
                      (let name (strSlice axsym (+ k1 1) (- k2 (+ k1 1))))
                      (let loc (strSlice axsym (+ k2 1) (- k3 (+ k2 1))))
                      (let ty
                        {
                          (let a (+ k3 2))
                          (let mut b (- e 1))
                          {
                            (while (&& (> b a) (!= (strByte axsym b) 34))
                              (set b (- b 1)))
                            (if (> b a)
                              (strSlice axsym a (- b a))
                              "")
                          }
                        })
                      {
                        (vecPush parts (symPad (symKindWord kind) 8))
                        (vecPush parts " ")
                        (vecPush parts (symPad name 20))
                        (vecPush parts " ")
                        (vecPush parts (symPad ty 40))
                        (vecPush parts " [")
                        (vecPush parts
                          (if (strEq loc "-")
                            "builtin"
                            loc))
                        (vecPush parts "]\n")
                      }
                    }
                  }
                }
              })
            (set i (+ e 1))
          }
        })
      (catStrs parts)
    }
  })

; ------------------------------------------------------------------
; Whether a `FnEnt` gets no row.
;
; ONE PREDICATE, not two that agree today. `symbolsRenderGens` below
; and `axirRender` (core/axir.ax) walk `tcFnsVec` in the same
; order and must skip the same entries, because an `.axir` record
; joins to an AXSYM row by its whole header tuple and a walk that
; kept one row more would shift every join after it. The three arms
; are stage0's, and the reasons are its:
;
;   - a GENERATED name is not a symbol. `show` derives a structural
;     renderer named `show#Point`, and the trait lowering appended
;     `Trait#Type#method` before 0.6.0. `#` is not an identifier
;     byte, so a name containing one cannot have been written.
;   - a builtin has no row unless `--builtins` asked for one.
;   - an effect OPERATION has a row under its bare name only; the
;     mangled spelling is the compiler's.
; ------------------------------------------------------------------
(pub :: symFnRowSkipped (-> String Int Int Int Int))
(pub fn (symFnRowSkipped name isB isOp builtins)
  (if (|| (smGenerated name)
        (|| (&& (== isB 1) (== builtins 0))
          (&& (== isOp 1) (!= (strLen (bareOf name)) (strLen name)))))
    1
    0))

; ------------------------------------------------------------------
; THE MIR PROJECTION.
;
; `FnEnt` word 8 is the region-facts record `rgnFactsNew` builds
; (core/typecheck.ax, stage S3): a full interprocedural dataflow
; summary of one function - which parameters its body stores a FRESH
; value into, which parameters flow into which, where its result comes
; from, and whether the walk hit a call it could not resolve. It is
; computed, spent on AX3049 and AX3060-63, and then thrown away. This
; is the only reader outside typecheck.ax.
;
; THE BIT ENCODINGS ARE typecheck.ax's, restated here because a
; renderer that guessed them would print confident nonsense:
;
;   word 1 flowsCUR   bit i: a value allocated in this body flows
;                     into parameter i (0-based)
;   word 3 resultFrom bit j: parameter j's value reaches the result
;   word 4 resultCUR  the result is allocated in this body
;   word 5 unknown    the walk hit a call head it could not resolve
;   word 7 nparams
;
; An origin MASK inside typecheck.ax uses bit 0 for "current region"
; and bits 1..n for the parameters; words 1 and 3 are already shifted
; down to 0-based parameter indices by `rgnNoteFlow`, which is why
; nothing here shifts again.
;
; WHY THE KEYS ARE OPT-IN AND SLOW. `rgnEnsureFacts` runs on DEMAND -
; for a program that names a region or claims `restrict(no-escape)`,
; and otherwise never. Asking for these keys forces it over every
; declaration: on `core/main.ax` that is about 30 times the cost
; of a plain `check`, all of it `rgnEnsureFacts`. That is a flag, never
; a default.
;
; WHY `#mir-truncated` IS NOT OPTIONAL. A chain deeper than the round
; cap stops propagating before the fixpoint converges, and the facts
; that come out are an UNDER-approximation. The bound is the program's
; own size, so the truncation is a net no program reaches - but the key
; stays, because a net removed is a silence
; reintroduced the day a walk stops converging for a new reason. `#mir-escapes=` is
; therefore a lower bound in exactly the sense `#effects=` is, and it
; gets the same treatment `#effects-incomplete` gets: its own meta,
; saying something about the LIST rather than naming a member of it.
; Publishing the list without it would hand `Agent.Policy` a guarantee
; the compiler does not have - the AXTAG forgery hole's shape,
; arriving through the compiler's own front door.
;
; `#mir-incomplete` is the per-row half of the same admission: this
; body called something the walk could not resolve, so its own facts
; are a lower bound whatever the fixpoint did.
; A declared name at this position, or the stable numeric spelling when
; the declaration or that parameter is unavailable.
(:: smParamName (-> (Option Names) Int String))
(fn (smParamName params index)
  (match params
    ((None) (fmtInt index))
    ((Some names)
      (if (&& (>= index 0) (< index (vecLen names)))
        (vecGetStr names index)
        (fmtInt index))
    )))

(:: symMirParams (-> (Option Names) Int Int Strings))
(fn (symMirParams params np mask)
  {
    (let out vecNew)
    (let mut i 0)
    {
      (while (< i np)
        {
          (if (!= (& mask (<< 1 i)) 0)
            (vecPush out (smParamName params i)))
          (set i (+ i 1))
        })
      out
    }
  })

; Push this function's `#mir-*` keys onto `metas`. `ent` is the
; `FnEnt`, `params` its optional parameter names, `truncated` whether
; the module's fixpoint stopped at its round cap.
;
; A function with None in its region facts has no answer - the fixpoint did not
; reach it - and gets NO keys at all rather than keys reading zero.
; "No answer" and "the answer is none" are different claims and this
; stream has to keep them apart.
(pub :: symMirMetas (-> FnEnt (Option Names) Int Strings Int))
(pub fn (symMirMetas ent params truncated metas)
  {
    (let facts (fnEntRgn ent))
    (if (let (Some f) facts)
      {
        (let np (rgnNparams f))
        (let esc (symMirParams params np (rgnFlowsCUR f)))
        (let rfr (symMirParams params np (rgnResultFrom f)))
        {
          (vecPush metas (concat "mir-params=" (fmtInt np)))
          (if (> (vecLen esc) 0)
            (vecPush metas (concat "mir-escapes=" (saJoinComma esc)))
            metas)
          (if (!= (rgnResultCUR f) 0)
            (vecPush metas "mir-result-fresh")
            metas)
          (if (> (vecLen rfr) 0)
            (vecPush metas (concat "mir-result-from=" (saJoinComma rfr)))
            metas)
          (if (!= (rgnUnknown f) 0)
            (vecPush metas "mir-incomplete")
            metas)
          (if (== truncated 1)
            (vecPush metas "mir-truncated")
            metas)
          0
        }
      }
      0)
  })

; `gens` is `expandProgram`'s answer - the (name, macro) pairs of every
; declaration phase D generated. A row it names carries `#generated=`
; and the macro's own name, which is what tells a reader why a symbol
; has no visible definition (MAC-TOOL-4). A caller that did not expand
; supplies an empty table.
; `mir` is `--mir`: FORCE the region-facts fixpoint and project it.
; It is a separate parameter from `calls` rather than a bit in one
; because the two differ in cost by two orders of magnitude - `--calls`
; prints edges the effect walk already resolved, `--mir` runs a walk
; that would otherwise never run at all (see `symMirMetas`).
(pub :: symbolsRenderGens (-> TC Int GeneratedOrigins Int Int String))
(pub fn (symbolsRenderGens tc builtins gens calls mir)
  ; --- functions --------------------------------------------
  ; Demanded HERE, before the row walk, because the fixpoint is a
  ; whole-module computation and `rgnFactsTruncated` is a
  ; whole-module answer: every row has to be told the same thing
  ; about it.
  {
    (let units (tcUnits tc))
    (let decls (tcAllDeclsVec tc))
    (let lines vecNew)
    (let _rgn
      (if (== mir 1)
        (rgnEnsureFacts tc)
        0))
    (let trunc
      (if (== mir 1)
        (rgnFactsTruncated tc)
        0))
    {
      (let sm (smBuild decls units))
      {
        {
          (let fns (tcFnsVec tc))
          (let mut i 0)
          (while (< i (vecLen fns))
            {
              (let e (vecGet fns i))
              {
                (let name (fnEntName e))
                (let isB (fnEntIsBuiltin e))
                (let isOp (fnEntIsEffectOp e))
                {
                  ; The skip predicate is `symFnRowSkipped` above, and
                  ; it is a named function because `axirRender` walks
                  ; this same list and has to skip the same rows.
                  (if (! (== (symFnRowSkipped name isB isOp builtins) 1))
                    {
                      (let metas vecNew)
                      (let loc (smLocReal sm 0 1 2 name units))
                      {
                        (smTagMetas sm name metas)
                        {
                          (let gm (expGenOf gens name))
                          (if (let (Some gm) gm)
                            (vecPush metas (concat "generated=" gm)))
                        }
                        ; The incompleteness sentinel rides in the same
                        ; Vec and is NOT an effect: rendering it put
                        ; `incomplete` in the middle of `#effects=IO,
                        ; incomplete`, where it reads like an effect
                        ; named "incomplete". It gets its own meta,
                        ; because what it says is about the LIST rather
                        ; than a member of it - `#effects=` is a lower
                        ; bound, not the set. A function with nothing but
                        ; the sentinel prints `#effects-incomplete` and no
                        ; `#effects=` at all, which is the honest
                        ; rendering of "the walk did not resolve a call
                        ; and found nothing else".
                        ;
                        ; `#effects=` is the UNION - every effect the
                        ; body performs or may perform - so no reader
                        ; of it moved when the possible spelling
                        ; arrived (`typecheck.ax`, `effIsPossible`):
                        ; `check-compat.sh` compares this key, and a
                        ; widening in the possible half is a declared
                        ; widening exactly as before. A row may carry
                        ; both spellings of one effect and it prints
                        ; once.
                        {
                          (let effs (fnEntEffects e))
                          (if (== isB 0)
                            {
                              (let disp vecNew)
                              (let poss vecNew)
                              (let mut k 0)
                              (let mut partial 0)
                              {
                                (while (< k (vecLen effs))
                                  {
                                    (let ef (vecGetStr effs k))
                                    {
                                      ; A hole in the call graph
                                      ; alone (`effGraphOpen`) leaves
                                      ; the row exact.
                                      (if (== (effIsMarker ef) 1)
                                        (if (! (strEq ef effGraphOpen))
                                          (set partial 1))
                                        {
                                          (if (! (== (strInVec disp (effRender ef) 0) 1))
                                            (vecPush disp (effRender ef)))
                                          (if (&& (== (effIsPossible ef) 1)
                                                (== (effIn effs (effDefiniteOf ef)) 0))
                                            (if (! (== (strInVec poss (effRender ef) 0) 1))
                                              (vecPush poss (effRender ef))))
                                        })
                                      (set k (+ k 1))
                                    }
                                  })
                                (if (> (vecLen disp) 0)
                                  (vecPush metas (concat "effects=" (saJoinComma (saSort disp)))))
                                (if (== partial 1)
                                  (vecPush metas "effects-incomplete"))
                                ; The opposite admission. `-incomplete`
                                ; says the row is a LOWER bound; this
                                ; says some member of it is only
                                ; POSSIBLE - contributed by NAMING a
                                ; function rather than calling one, or
                                ; by a trait method with more than one
                                ; implementation - and `-possible=`
                                ; names which. Without it a reader sees
                                ; `#effects=IO` on `(fn (handoff k)
                                ; shout)` and believes a body that does
                                ; no IO performs some. A member that is
                                ; ALSO definite is not listed: the body
                                ; performs it whatever else it names.
                                (if (> (vecLen poss) 0)
                                  {
                                    (vecPush metas "effects-overapprox")
                                    (vecPush metas
                                      (concat "effects-possible=" (saJoinComma (saSort poss))))
                                  })
                              }
                            })
                        }
                        ; The edges the effect walk resolved to build
                        ; the row above, opt-in behind `--calls`.
                        ;
                        ; OFF BY DEFAULT, and that is the whole reason
                        ; it is a flag. `tests/tools/symbols-zoo.golden`
                        ; pins 147 rows and `check-tools-selfhost`
                        ; compares them byte for byte, so a key on every
                        ; row would put an edge list into the diff of
                        ; every future stdlib edit - the noise that made
                        ; `ac95e2b` a separate commit. `--builtins` is
                        ; the precedent: content selection on this
                        ; subcommand, not a new axis on the build.
                        ;
                        ; UNFILTERED, deliberately. An operator is a
                        ; `FnEnt` in this language, so `+` and `==` are
                        ; call edges and hiding them would make this key
                        ; disagree with what the checker calls a call.
                        ; `__alloc` is the load-bearing case: it is a
                        ; builtin AND it is what puts `Alloc` in the row
                        ; beside this one, so a graph that dropped
                        ; builtins could not explain its own effect set.
                        ;
                        ; Sorted into a COPY. `saSort` sorts in place,
                        ; and the vec here is the checker's live entry
                        ; word - a renderer that reordered it would be
                        ; mutating analysis state to print it.
                        {
                          (let cls (fnEntCalls e))
                          (if (&& (== calls 1) (== isB 0))
                            {
                              (let cv vecNew)
                              (let mut k 0)
                              {
                                (while (< k (vecLen cls))
                                  {
                                    (vecPush cv (vecGetStr cls k))
                                    (set k (+ k 1))
                                  })
                                (if (> (vecLen cv) 0)
                                  (vecPush metas (concat "calls=" (saJoinComma (saSort cv)))))
                              }
                            })
                        }
                        {
                          (let eps (fnEntEparams e))
                          (if (&& (> (vecLen eps) 0) (== isB 0))
                            ; In parameter order, whatever order the checker met
                            ; them in: the row names a set, and a set printed in
                            ; walk order moves whenever the walk does.
                            {
                              (let params (saGetNames sm.prmN sm.prmV name))
                              (let pnames vecNew)
                              (let mut top 0)
                              (let mut pi 0)
                              (let mut k 0)
                              {
                                (while (< k (vecLen eps))
                                  {
                                    (if (> (vecGet eps k) top)
                                      (set top (vecGet eps k))
                                      0)
                                    (set k (+ k 1))
                                  })
                                (while (<= pi top)
                                  {
                                    (if (smHasIndex eps pi 0)
                                      (vecPush pnames (smParamName params pi))
                                      0)
                                    (set pi (+ pi 1))
                                  })
                                (vecPush metas (concat "effect-params=" (saJoinComma pnames)))
                              }
                            })
                        }
                        ; AFTER the author's AXTAGs, like every other derived key,
                        ; and for the reason spelled out at `smTagMetas`:
                        ; `symTagFrom` answers the LAST `#key` on the line,
                        ; so a compiler-owned key placed after the tags
                        ; cannot be shadowed by a forged one.
                        ; `#extern`: word 4 is 2 for an `extern` item
                        ; (`tcAddExtern`). Without it the row is a function
                        ; with no calls and `#effects=IO` - the same row a
                        ; body writing one syscall gets - and a reader of
                        ; the stream (`scripts/axiom-report.py`) could only
                        ; guess which rows leave the program.
                        (if (== isOp 2)
                          (vecPush metas "extern"))
                        ; `#unsafe=`: the declaration's place in the unsafe
                        ; boundary (R-B6, FnEnt word 9). `trusted` is
                        ; `;@axiom:effect(unsafe)` - its author vouches
                        ; for every well-typed call, and callers inherit
                        ; nothing. So `grep '#unsafe=trusted'` over this
                        ; stream is the program's trusted set, the list
                        ; `docs/assurance.md` asks a reviewer to read. A
                        ; derived key, so an author may not spell it
                        ; (`axtagReservedKey`).
                        (if (== (fnEntUnsafe e) 1)
                          (vecPush metas "unsafe=trusted"))
                        ; `#erasures=n`: how many casts in the body turn a
                        ; reference into a word (`eraseSettle`). A derived
                        ; key, so an author may not spell it.
                        {
                          (let ne (tcErasuresOf tc e))
                          (if (> ne 0)
                            (vecPush metas (concat "erasures=" (fmtInt ne))))
                        }
                        (if (&& (== mir 1) (== isB 0))
                          (symMirMetas e (saGetNames sm.prmN sm.prmV name) trunc metas))
                        {
                          (let opTy (saGetNode sm.opN sm.opV name))
                          (vecPush
                            lines
                            (symLine
                              "F"
                              (if (== isB 1)
                                ; A builtin is never module-qualified, so its whole
                                ; name is its row's: `parallel$borrow` (MM-PAR-6b)
                                ; would print as `borrow`, a name nothing can call
                                ; and no `#calls=` edge spells.
                                name
                                (bareOf name))
                              (smLocWire loc)
                              (if (== isOp 1)
                                (match opTy
                                  ((None) (symTy (fnEntTy e)))
                                  ((Some ty) (symTy ty)))
                                (symTy (fnEntTy e)))
                              (smNidWire (smNidFor sm name))
                              metas))
                        }
                      }
                    })
                  (set i (+ i 1))
                }
              }
            })
        }
        ; --- data types and their constructors --------------------
        {
          (let datas (tcDatasVec tc))
          (let mut i 0)
          (while (< i (vecLen datas))
            {
              (let d (vecGet datas i))
              {
                (let name (dataEntName d))
                (let ctors (dataEntCtors d))
                {
                  {
                    (let metas vecNew)
                    (let cnames vecNew)
                    (let mut k 0)
                    {
                      (while (< k (vecLen ctors))
                        {
                          (vecPush cnames (bareOf (ctorEntName (vecGet ctors k))))
                          (set k (+ k 1))
                        })
                      ; Author tags first, derived keys after: see
                      ; `smTagMetas`.
                      (smTagMetas sm name metas)
                      (if (> (vecLen cnames) 0)
                        (vecPush metas (concat "ctors=" (saJoinComma cnames))))
                      (vecPush lines
                        (symLine "D" (bareOf name)
                          {
                            (let loc (smLocReal sm 3 4 5 name units))
                            (smLocWire loc)
                          }
                          (concat "data " (bareOf name)) (smNidWire (smNidFor sm name)) metas))
                    }
                  }
                  {
                    (let mut k 0)
                    (while (< k (vecLen ctors))
                      {
                        (let c (vecGet ctors k))
                        {
                          (vecPush lines
                            (symLine "C" (bareOf (ctorEntName c))
                              {
                                (let loc (smLocReal sm 9 10 11 (ctorEntName c) units))
                                (smLocWire loc)
                              }
                              (symTy (ctorEntTy c)) ""
                              {
                                (let m vecNew)
                                {
                                  (vecPush m (concat "of=" (bareOf name)))
                                  m
                                }
                              }))
                          (set k (+ k 1))
                        }
                      })
                  }
                  (set i (+ i 1))
                }
              }
            })
        }
        ; --- structs ----------------------------------------------
        {
          (let sts (tcStructsVec tc))
          (let mut i 0)
          (while (< i (vecLen sts))
            {
              (let s (vecGet sts i))
              {
                (let name (structEntName s))
                (let fields (structEntFields s))
                {
                  {
                    (let metas vecNew)
                    (let fparts vecNew)
                    (let mut k 0)
                    {
                      (while (< k (vecLen fields))
                        {
                          (let f (vecGet fields k))
                          {
                            (vecPush fparts
                              (concat (nodeAName f) (concat ":" (symTy (nodeTyChild f)))))
                            (set k (+ k 1))
                          }
                        })
                      ; Author tags first, derived keys after: see
                      ; `smTagMetas`.
                      (smTagMetas sm name metas)
                      (vecPush metas (concat "fields=" (saJoinComma fparts)))
                      ; What a call through each field that declares its
                      ; effects is charged (`fieldEffectsMeta`).
                      {
                        (let fe (fieldEffectsMeta tc s))
                        (if (> (strLen fe) 0)
                          (vecPush metas fe)
                          metas)
                      }
                      ; A word struct's representation (MM-VAL-10a): one
                      ; sealed machine word, and whether a `parallel`
                      ; binding may capture it. A `sealed shared` heap
                      ; struct says so (MM-PAR-16); any other heap
                      ; struct has no key.
                      (if (== (structEntIsWord (Some s)) 1)
                        (vecPush metas
                          (if (== (structEntIsShared (Some s)) 1)
                            "repr=word,shared"
                            "repr=word"))
                        (if (== (structEntIsSharedHeap (Some s)) 1)
                          (vecPush metas "repr=sealed,shared")
                          metas))
                      (vecPush lines
                        (symLine "S" (bareOf name)
                          {
                            (let loc (smLocReal sm 3 4 5 name units))
                            (smLocWire loc)
                          }
                          (concat "struct " (bareOf name)) (smNidWire (smNidFor sm name)) metas))
                    }
                  }
                  (set i (+ i 1))
                }
              }
            })
        }
        ; --- type aliases -----------------------------------------
        {
          (let als (tcAliasesVec tc))
          (let mut i 0)
          (while (< i (vecLen als))
            {
              (let d (vecGet als i))
              {
                (let name (nodeAName d))
                {
                  ; Author tags first, derived keys after: see
                  ; `smTagMetas`.
                  {
                    (let metas vecNew)
                    (let tvs (nodeCNames d))
                    {
                      (smTagMetas sm name metas)
                      (if (&& (!= (as tvs Int) 0) (> (vecLen tvs) 0))
                        (vecPush metas (concat "tyvars=" (saJoinComma tvs))))
                      (vecPush lines
                        (symLine "A" (bareOf name)
                          {
                            (let loc (smLocReal sm 3 4 5 name units))
                            (smLocWire loc)
                          }
                          (symTy (nodeBChild d)) (smNidWire (smNidFor sm name)) metas))
                    }
                  }
                  (set i (+ i 1))
                }
              }
            })
        }
        ; --- macros -----------------------------------------------
        ; The name vector collected above IS the list. Every other walk
        ; here iterates a `tc` list and uses `sm` only for the span and
        ; the nid, but the checker keeps no macro list - macros are
        ; consumed by the expander before it runs - so the collection
        ; is the only place they survive.
        ;
        ; A macro has no TYPE. The row says `macro <name>`, the shape
        ; `trait <name>` already uses, and carries its parameter names
        ; as `#params=` so a reader can see the arity a call must
        ; satisfy. Without this row `println` and `format` were
        ; public API no gate over this stream could see
        ; (`compat/UNCOVERED`).
        {
          (let mcs sm.mcN)
          (let mut i 0)
          (while (< i (vecLen mcs))
            {
              (let name (vecGetStr mcs i))
              {
                {
                  (let metas vecNew)
                  {
                    (smTagMetas sm name metas)
                    (vecPush lines
                      (symLine "M" (bareOf name)
                        {
                          (let loc (smLocReal sm 20 21 22 name units))
                          (smLocWire loc)
                        }
                        (concat "macro " (bareOf name)) (smNidWire (smNidFor sm name)) metas))
                  }
                }
                (set i (+ i 1))
              }
            })
        }
        ; --- effects ----------------------------------------------
        ; The effect's own name. Its OPERATIONS were always keyed - a
        ; handler needs those - but the declaration had no row, so
        ; `Assert` was the last public name outside this stream.
        {
          (let efs sm.efN)
          (let mut i 0)
          (while (< i (vecLen efs))
            {
              (let name (vecGetStr efs i))
              {
                {
                  (let metas vecNew)
                  {
                    (smTagMetas sm name metas)
                    (vecPush lines
                      (symLine "E" (bareOf name)
                        {
                          (let loc (smLocReal sm 23 24 25 name units))
                          (smLocWire loc)
                        }
                        (concat "effect " (bareOf name)) (smNidWire (smNidFor sm name)) metas))
                  }
                }
                (set i (+ i 1))
              }
            })
        }
        ; --- join -------------------------------------------------
        {
          (let mut total 0)
          (let mut i 0)
          {
            (while (< i (vecLen lines))
              {
                (set total (+ total (strLen (vecGetStr lines i))))
                (set i (+ i 1))
              })
            {
              (let out (strAlloc total))
              (let mut j 0)
              (let mut off 0)
              {
                (while (< j (vecLen lines))
                  {
                    (let f (vecGetStr lines j))
                    {
                      (memCopy (+ (strData out) off) (strData f) (strLen f))
                      (set off (+ off (strLen f)))
                      (set j (+ j 1))
                    }
                  })
                out
              }
            }
          }
        }
      }
    }
  })
