; repl.ax — interactive evaluation, editing and session commands.
;
; Declarations accumulate as source. Each expression is checked against
; the session, compiled through the normal pipeline, and run in a private
; scratch directory. Type and result lines use the checked result type.
;
; Editing, history, completion and colour require both stdin and stdout
; to be terminals. Piped sessions have no prompt or escape sequences;
; results, diagnostics and command output all go to stdout.
; Tui modules own terminal editing; compiler modules supply syntax and
; completion. See scripts/check-repl-selfhost.sh and check-repl-tui.sh.
(import core)
(import Host)
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Sys)
(import IO
  (isTerminal makeDirMode readFile readLine removeDir removeFile stdin stdout writeFile writeStr))
(import Path)
(import lexer)
(import parser)
(import diag)
(import render)
(import typecheck)
(import expand)
(import codegen)
(import checked)
(import driver)
(import style)
(import explain)
(import lexicon)
(import Tui.Keys)
(import Tui.Edit)
(import Tui.Term)
(import replhl)
(import replhist)
(import replcomp)
(import raw)

; All REPL output is stdout - stage0's rule, measured: stderr stayed
; empty in every probed session, errors included.
(pub :: replOut (-> String Int))
;@axiom:effect(io)
(pub fn (replOut s)
  (writeStr stdout s))

; ------------------------------------------------------------------
; Reading a line from standard input: `IO.readLine`, one byte per
; read(2). A REPL line is short and arrives at human or pipe speed, so
; the syscall count is irrelevant. Answers the line WITHOUT its newline,
; or None at end of input; a final unterminated line comes back as
; itself, and a read that fails ends the session as end of input does.
; ------------------------------------------------------------------
; A line, or nothing at end of input.
;
; This one gets `Option` rather than the word-plus-view shape the other
; raw readers took, and the reason is that it READS. A String view that
; re-derives its value would consume a second line, and casting the
; bound word at the use site would classify its evidence 0 and drop the
; line's release (MM-LIFE-2e) - a leak per line, for the lifetime of a
; REPL session. `Option` costs one allocation per line read, which at
; the rate a human types is nothing, and it is the honest type.
;
; The hot readers - `nodeModule`, `modOf`, `expMacMod` - keep the word
; form deliberately: they are called per declaration and per name, and
; boxing there would be a real cost for a type the caller immediately
; discriminates anyway.
(pub :: replReadLine (-> Int (Option String)))
;@axiom:effect(io)
(pub fn (replReadLine _u)
  (match (readLine stdin)
    ((Ok line) line)
    ((Err _) None)))

; ------------------------------------------------------------------
; THE ONE PREDICATE. Everything interactive hangs off it, and it is
; here in ONE place so that a gate has exactly one thing to prove.
;
; BOTH DESCRIPTORS, not either. A session whose stdin is a pipe and
; whose stdout is a terminal must still write no prompt, or the byte
; goldens in check-repl-selfhost.sh would depend on HOW the gate was
; invoked rather than on what the REPL does - and a `2>&1` in some
; future runner would silently move them. A session whose stdin is a
; terminal and whose stdout is a file must not paint either: the
; escapes would land in the file.
; ------------------------------------------------------------------
(pub :: replInteractive Int)
;@axiom:effect(io)
(pub fn (replInteractive)
  (if (&& (isTerminal stdin) (isTerminal stdout))
    1
    0))

; Paint structured output only on a terminal. Whole messages retain
; their plain text, including diagnostic codes and result markers.
(pub :: replStyled (-> String String Int))
;@axiom:effect(io)
(pub fn (replStyled sgr text)
  (replOut
    (if (== replInteractive 1)
      (paint sgr text)
      text)))

; Main and continuation prompts both occupy seven columns, so entered
; forms stay aligned. The editor measures their width with `visLen`.
(pub :: replPromptMain String)
(pub fn (replPromptMain)
  (paint REPL_ACCENT "axiom> "))

(pub :: replPromptCont String)
(pub fn (replPromptCont)
  (paint REPL_MUTED "  ...> "))

; ------------------------------------------------------------------
; THE BRANCH. One conditional, one call site, and both sides answer
; the same `(Option String)`: a line without its newline, or None at
; end of input.
;
; The raw-mode bracket is here rather than inside `term.ax` for two
; reasons. It keeps `termRawEnter` and `termRawLeave` LEXICALLY
; ADJACENT on the one return path this function has, so there is no
; path out of raw mode to forget; and it lets the fallback - a
; terminal that refuses raw mode, which is what a target with no
; termios answers - be the ordinary reader, which `term.ax` cannot
; call without an import cycle.
;
; Everything below this line in `replMain` - `replTrim`, the `;`/`:`
; classification, `replParenDepth`, the pending join, `replDispatch`,
; output dispatch - is shared by both
; surfaces.
;
; `pending` is the multi-line entry so far, "" when the next line
; starts fresh. It is only ever READ here, to give the highlighter
; the context a closing bracket needs: a `)` on this line can only
; match a `(` two lines up, so the paint lexes the joined buffer and
; renders only this line's tail past it.
;
; `hist` is the session's history handle (`histOpen` in `replMain`).
; It travels with the editor because Up and Down are answered inside
; the keystroke loop, not after it: a recall replaces the buffer and
; repaints in the same step, the way an edit does.
;
; `cenv` is the session's completion handle (`replComplEnvNew` in
; `replMain`, re-synced to `declsSrc`/`pending` every iteration). Tab
; is answered inside the loop for the same reason: the splice, the
; cursor seek and the menu all land in one step.
; ------------------------------------------------------------------
(pub :: replReadPrompted (-> Int KeyIn LineEd String String Hist ReplComplEnv (Option String)))
;@axiom:effect(io)
(pub fn (replReadPrompted interactive kin ed prompt pending hist cenv)
  (if (== interactive 0)
    (replReadLine 0)
    (if (< (termRawEnter kin) 0)
      (replReadLine 0)
      {
        (let r (replTermLoop kin ed prompt pending hist cenv))
        {
          (termRawLeave kin)
          r
        }
      })))

; The editor's cursor as a BYTE offset into its snapshot. `ledCursor`
; answers code points and `replHlPaint` takes bytes; for ASCII they
; agree, and for anything else the snapshot's own first-`k`-points
; prefix measures the difference.
(pub :: replCursorBytes (-> LineEd Int))
(pub fn (replCursorBytes ed)
  (strLen (ledRangeStr ed 0 (ledCursor ed))))

; The current editor buffer, painted for display. `full` is what the
; lexer sees - the pending entry above plus this line - and `from` is
; where this line starts in it, so only the tail is rendered while
; brackets match across the whole entry. With no entry open the whole
; line is painted from 0.
(pub :: replPaintCurrent (-> LineEd String String))
(pub fn (replPaintCurrent ed pending)
  {
    (let snap (ledSnapshot ed))
    (if (== (strLen pending) 0)
      (replHlPaint snap (replCursorBytes ed) 0)
      {
        (let from (+ (strLen pending) 1))
        (replHlPaint (concat (concat pending "\n") snap) (+ from (replCursorBytes ed)) from)
      })
  })

; ------------------------------------------------------------------
; History inside the keystroke loop.
;
; Up and Down (with Ctrl-P / Ctrl-N as the aliases every terminal can
; produce, where some terminals send no distinct arrow sequence at
; all) are answered here rather than in `Tui.Edit`, because recall
; needs `replhist.ax` and `stdlib/Tui` may not import the compiler -
; the same reason highlighting lives on this side. The recalled text
; is a whole recorded entry flattened to one row: a multi-line `fn`
; comes back with its newlines as spaces, which still balances and
; still evaluates the same everywhere except inside a string literal
; or a comment - the one loss this keeps, stated rather than
; discovered. Leaving browse mode is `histBrowseReset`'s contract and
; is kept here twice: on submit, and on any key that changed the
; buffer, measured by comparing snapshots rather than by naming keys
; (a motion compares equal and keeps browsing; Alt-d does not).
; ------------------------------------------------------------------
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: replIsHistUp (-> KeyEv Bool))
(pub fn (replIsHistUp ev)
  (if (== ev.kind KEY_UP)
    true
    (if (== ev.kind KEY_CTRL)
      (&& (== ev.cp 80) (== ev.mods 0))
      false)))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: replIsHistDown (-> KeyEv Bool))
(pub fn (replIsHistDown ev)
  (if (== ev.kind KEY_DOWN)
    true
    (if (== ev.kind KEY_CTRL)
      (&& (== ev.cp 78) (== ev.mods 0))
      false)))

; What a recall puts in the buffer: the browse cursor's entry - or the
; saved draft coming back down past the newest - on one row.
;@axiom:restrict(no-io,no-foreign)
(pub :: replHistText (-> Hist (Option String)))
(pub fn (replHistText hist)
  (match (histCurrent hist)
    ((None) None)
    ((Some entry) (Some (histFlatten entry " ")))))

; Recall one step older. Answers 1 when the buffer moved and was
; repainted, 0 at the oldest entry, where the editor does nothing -
; the same "did it move" shape `histBrowseUp` itself answers. A public
; invalid cursor with no entry leaves the editor untouched and answers 0.
;@axiom:restrict(no-io,no-foreign)
(pub :: replHistUp (-> Hist LineEd String Strings Int))
(pub fn (replHistUp hist ed pending out)
  (if (== (histBrowseUp hist (ledSnapshot ed)) 0)
    0
    (match (replHistText hist)
      ((None) 0)
      ((Some text)
        {
          (ledSetStr ed text)
          (ledRefreshPainted ed out (replPaintCurrent ed pending))
          1
        }
      ))))

; Recall one step newer, back toward the saved draft.
;@axiom:restrict(no-io,no-foreign)
(pub :: replHistDown (-> Hist LineEd String Strings Int))
(pub fn (replHistDown hist ed pending out)
  (if (== (histBrowseDown hist) 0)
    0
    (match (replHistText hist)
      ((None) 0)
      ((Some text)
        {
          (ledSetStr ed text)
          (ledRefreshPainted ed out (replPaintCurrent ed pending))
          1
        }
      ))))

; Whether `raw` is the Ctrl-C abort sentinel: the single byte 3 (ETX).
; `ledInsert` refuses every byte below 32, so no TTY buffer can ever
; hold it, and no piped line but a pathological one contains it alone;
; `replTermLoop` answers it for LED_ABORT so that `replMain` can tell
; "the user cancelled" apart from "the user submitted an empty line".
; Without the distinction a blank line inside a multi-line entry could
; not be preserved - it is also what the abort key produces.
(pub :: replIsAbort (-> String Bool))
(pub fn (replIsAbort raw)
  (if (== (strLen raw) 1)
    (== (strByte raw 0) 3)
    false))

; Tab, and the Ctrl-R search key. Shift-Tab decodes as KEY_NONE today
; (`keyFinalKind` names no `Z` final), so completion cycles forward
; only; teaching the decoder that final is the way back, not a change
; here.
(pub :: replIsComplTab (-> KeyEv Bool))
(pub fn (replIsComplTab ev)
  (== ev.kind KEY_TAB))

(pub :: replIsSearch (-> KeyEv Bool))
(pub fn (replIsSearch ev)
  (if (== ev.kind KEY_CTRL)
    (&& (== ev.cp 82) (== ev.mods 0))
    false))

(pub :: replIsEscKey (-> KeyEv Bool))
(pub fn (replIsEscKey ev)
  (== ev.kind KEY_ESCAPE))

; The nesting depth of `#| ... |#` block comments left open at the end
; of `src`, counted outside strings, character literals and line
; comments. `lex` skips an unterminated block comment to end of source
; with no error token, so `replParenDepth` alone measures 0 inside one
; and the REPL would dispatch half a form; this is the third arm of
; `replEntryIncomplete`. Kept BESIDE `replParenDepth` rather than
; inside it, because that answer is piped-surface behaviour the
; highlighter reconciles against (`replHlDepth`), and neither may move
; for the other's reason.
(pub :: replBlockDepth (-> String Int))
(pub fn (replBlockDepth src)
  {
    (let n (strLen src))
    (let mut i 0)
    (let mut depth 0)
    {
      (while (< i n)
        (if (> depth 0)
          ; Inside a block comment only the delimiters read: `#|`
          ; nests, `|#` closes, and everything else - quotes and
          ; semicolons included - is comment text.
          (if (&& (== (strByte src i) 35) (&& (< (+ i 1) n) (== (strByte src (+ i 1)) 124)))
            {
              (set depth (+ depth 1))
              (set i (+ i 2))
            }
            (if (&& (== (strByte src i) 124) (&& (< (+ i 1) n) (== (strByte src (+ i 1)) 35)))
              {
                (set depth (- depth 1))
                (set i (+ i 2))
              }
              (set i (+ i 1))))
          {
            (let b (strByte src i))
            (if (== b 34)
              ; A string: skipped whole, honouring `\` escapes. An
              ; unterminated one runs to the end - the `replStrOpen`
              ; case - and contributes no delimiters either way.
              {
                (set i (+ i 1))
                {
                  (let mut closed 0)
                  (while (&& (< i n) (== closed 0))
                    (if (== (strByte src i) 92)
                      (set i (+ i 2))
                      (if (== (strByte src i) 34)
                        {
                          (set closed 1)
                          (set i (+ i 1))
                        }
                        (set i (+ i 1)))))
                }
              }
              (if (== b 39)
                ; A character literal: one byte, or two past a `\`,
                ; then its closer when the line has one. A lone `'`
                ; (quote) only skips its neighbour, so misreading one
                ; cannot swallow a delimiter further down the line.
                {
                  (set i (+ i 1))
                  (if (&& (< i n) (== (strByte src i) 92))
                    (set i (+ i 2))
                    (set i (+ i 1)))
                  (if (&& (< i n) (== (strByte src i) 39))
                    (set i (+ i 1)))
                }
                (if (== b 59)
                  {
                    (set i (+ i 1))
                    (while (&& (< i n) (!= (strByte src i) 10))
                      (set i (+ i 1)))
                  }
                  (if (&& (== b 35) (&& (< (+ i 1) n) (== (strByte src (+ i 1)) 124)))
                    {
                      (set depth (+ depth 1))
                      (set i (+ i 2))
                    }
                    (set i (+ i 1))))))
          }))
      depth
    }
  })

; True when `src` closes more than it opens. `replParenDepth`'s single
; mixed counter goes negative for `( ]` and `())`; dispatching those
; drew the generic parse error, which names nothing about the extra
; closer. The dispatch sites name it instead, before any parser runs.
(pub :: replDepthNegative (-> String Bool))
(pub fn (replDepthNegative src)
  (< (replParenDepth src) 0))

; Spaces a continuation line starts with on a TTY: two per open
; bracket, capped at four levels, two when the entry waits on a string
; or a comment rather than a bracket. Cosmetic only - `replMain`
; trims every physical line before joining - so the piped surface,
; which never calls this, is byte-identical with or without it.
(pub :: replIndentFor (-> String String))
(pub fn (replIndentFor pending)
  {
    (let d (replParenDepth pending))
    (if (<= d 0)
      "  "
      (if (> d 4)
        "        "
        (if (== d 1)
          "  "
          (if (== d 2)
            "    "
            (if (== d 3)
              "      "
              "        ")))))
  })

; Move the editor's cursor to byte offset `to` (a `replCursorBytes`
; reading). `ledSetStr` parks at the end and completion splices before
; it, so the cursor walks back; lines are short and Tab is rare, and
; the quadratic string-building is nothing at that rate.
(pub :: replSeekByte (-> LineEd Int Int))
(pub fn (replSeekByte ed to)
  {
    (ledHome ed)
    {
      (let mut moved 1)
      (while (&& (< (replCursorBytes ed) to) (== moved 1))
        (set moved (ledRight ed)))
    }
    (ledCursor ed)
  })

; One Tab inside `replTermLoop`: the menu the last Tab printed erased,
; the state machine stepped, its buffer installed with the cursor where
; it says. Answers the machine's own answer; the caller repaints,
; prints `tabMenu` and carries `tabState`. Browsing ends here: a
; completed line is an edit, and the next Up starts from the newest.
; `cancel` 1 is Escape: the answer's menu already carries its erase,
; so the old one is not erased twice.
(pub :: replComplKey (-> (Option ComplSt) LineEd Hist ReplComplEnv Int Strings Int TabAnswer))
;@axiom:effect(io)
(pub fn (replComplKey cst ed hist cenv width out cancel)
  {
    (if (== cancel 0)
      (replComplDrop out cst))
    {
      (let buf (ledSnapshot ed))
      (let cur (replCursorBytes ed))
      {
        (let r
          (if (== cancel 0)
            (replComplTab cst buf cur 1 width cenv)
            (replComplCancel cst buf cur)))
        {
          (ledSetStr ed (tabBuf r))
          (replSeekByte ed (tabCur r))
          (histBrowseReset hist)
          r
        }
      }
    }
  })

; Erase the menu a completion state printed, if it printed one, and
; answer the idle state.
(:: replComplDrop (-> Strings (Option ComplSt) (Option ComplSt)))
(fn (replComplDrop out cst)
  {
    (if (let (Some s) cst)
      (vecPush out (replComplErase (stRows s)))
      ())
    None
  })

; Whether a colon line opens a multi-line entry: one of the four
; expression commands with an argument that does not yet balance.
; Everything else dispatches at once - including `:type` with no
; argument, which is a usage error, and `:load`, whose argument is a
; filename and never a form.
(pub :: replColonBuffers (-> String String Bool))
(pub fn (replColonBuffers w rest)
  (if (== (strLen rest) 0)
    false
    (if (|| (strEq w ":type") (|| (strEq w ":t") (|| (strEq w ":llvm") (strEq w ":time"))))
      (replEntryIncomplete rest)
      false)))

; `termEditLoop`'s twin, with live highlighting, history, completion
; and reverse search. Every step - the initial draw, the
; paste-coalesced skip, the per-key repaint - mirrors `Tui.Term`'s
; loop exactly except that the refresh draws `replPaintCurrent`
; instead of the plain snapshot; Up/Down (Ctrl-P/Ctrl-N) recall
; history instead of doing nothing; Tab steps `replComplKey` (Escape
; cancels it and puts the typed prefix back); and Ctrl-R steps back
; through history matching the buffer. The DONE, EOF and ABORT
; answers are byte for byte `term.ax`'s answers (`"\r\n"`, None, and
; `"^C"` plus a sentinel line), so `replMain` cannot tell which loop
; ran except for the sentinel, which is what lets a blank line inside
; a multi-line entry be preserved rather than read as a cancel. Kept
; beside `term.ax` rather than inside it because painting calls `lex`,
; recall needs `replhist` and completion needs `replcomp`, and
; `term.ax` may import none of them.
;
; A continuation line starts indented (`replIndentFor`); the indent is
; cosmetic - `replMain` trims before joining - so it aligns the form
; without ever entering it.
(pub :: replTermLoop (-> KeyIn LineEd String String Hist ReplComplEnv (Option String)))
;@axiom:effect(io)
(pub fn (replTermLoop kin ed prompt pending hist cenv)
  ; Tab completion state, `None` when idle (`tabState`).
  ; Ctrl-R search state: the needle kept across repeats, where the
  ; next repeat continues from, and whether a search is open.
  {
    (let out vecNew)
    (let mut state 0)
    (let mut got "")
    (let mut cst None)
    (let mut sNeedle "")
    (let mut sAt (:: None (Option Int)))
    (let mut sActive 0)
    {
      (termReadSize kin)
      (ledReset ed prompt (termWsCols kin) (termWsRows kin))
      (if (> (strLen pending) 0)
        (ledInsertStr ed (replIndentFor pending)))
      (ledRefreshPainted ed out (replPaintCurrent ed pending))
      (termFlush out)
      (while (== state 0)
        {
          (let ev (keyNext kin))
          (if (== ev.kind KEY_EOF)
            {
              (set state 2)
              (histBrowseReset hist)
            }
            (if (! (== ev.kind KEY_NONE))
              (if (replIsHistUp ev)
                {
                  (set cst (replComplDrop out cst))
                  (set sActive 0)
                  (replHistUp hist ed pending out)
                  (termFlush out)
                }
                (if (replIsHistDown ev)
                  {
                    (set cst (replComplDrop out cst))
                    (set sActive 0)
                    (replHistDown hist ed pending out)
                    (termFlush out)
                  }
                  (if (replIsComplTab ev)
                    {
                      (set sActive 0)
                      (termReadSize kin)
                      {
                        (let r (replComplKey cst ed hist cenv (termWsCols kin) out 0))
                        {
                          (ledResize ed (termWsCols kin) (termWsRows kin))
                          (ledRefreshPainted ed out (replPaintCurrent ed pending))
                          (vecPush out (tabMenu r))
                          (termFlush out)
                          (set cst (tabState r))
                        }
                      }
                    }
                    (if (replIsSearch ev)
                      ; Reverse search, readline's lite form: the buffer
                      ; is the needle on the first press and is kept
                      ; across repeats, each press steps older, and the
                      ; match replaces the buffer as the flattened row
                      ; Up would offer - so accepting is Enter and
                      ; leaving is any edit. A press with no (older)
                      ; match leaves the line as it is.
                      {
                        (set cst (replComplDrop out cst))
                        (if (== sActive 0)
                          {
                            (set sNeedle (ledSnapshot ed))
                            (set sAt (histSearchTop hist))
                            (set sActive 1)
                          })
                        {
                          (let ix (histFindBack hist sNeedle sAt))
                          (match ix
                            ((None) ())
                            ((Some index)
                              (match (histAt hist index)
                                ((None) ())
                                ((Some entry)
                                  {
                                    (ledSetStr ed (histFlatten entry " "))
                                    (set sAt (if (== index 0)
                                      None
                                      (Some (- index 1))))
                                  }
                                ))
                            ))
                        }
                        (histBrowseReset hist)
                        (termReadSize kin)
                        (ledResize ed (termWsCols kin) (termWsRows kin))
                        (ledRefreshPainted ed out (replPaintCurrent ed pending))
                        (termFlush out)
                      }
                      (if (&& (replIsEscKey ev)
                            (if (let (Some _) cst)
                              true
                              false))
                        {
                          (set sActive 0)
                          (termReadSize kin)
                          {
                            (let r (replComplKey cst ed hist cenv (termWsCols kin) out 1))
                            {
                              (ledResize ed (termWsCols kin) (termWsRows kin))
                              (ledRefreshPainted ed out (replPaintCurrent ed pending))
                              (vecPush out (tabMenu r))
                              (termFlush out)
                              (set cst (tabState r))
                            }
                          }
                        }
                        {
                          (set cst (replComplDrop out cst))
                          (set sActive 0)
                          {
                            (let before (ledSnapshot ed))
                            {
                              (let d (ledApply ed ev out))
                              (if (== d LED_DONE)
                                {
                                  (vecPush out "\r\n")
                                  (termFlush out)
                                  (set got (ledSnapshot ed))
                                  (histBrowseReset hist)
                                  (set state 1)
                                }
                                (if (== d LED_EOF)
                                  {
                                    (histBrowseReset hist)
                                    (set state 2)
                                  }
                                  (if (== d LED_ABORT)
                                    {
                                      (vecPush out "^C")
                                      (vecPush out "\r\n")
                                      (termFlush out)
                                      ; The sentinel, not "": an empty
                                      ; line is preserved inside a
                                      ; multi-line entry now (see
                                      ; `replIsAbort`), so a cancel
                                      ; must not look like one. No
                                      ; buffer can hold byte 3 -
                                      ; `ledInsert` refuses it - so
                                      ; this spelling is unambiguous.
                                      (set got (byteAsStr 3))
                                      (histBrowseReset hist)
                                      (set state 1)
                                    }
                                    {
                                      ; An edit that changed the buffer leaves
                                      ; browse mode; a motion compares equal and
                                      ; keeps it. See the history section above.
                                      (if (! (strEq before (ledSnapshot ed)))
                                        (histBrowseReset hist))
                                      (if (! (> (keyInPending kin) 0))
                                        {
                                          (termReadSize kin)
                                          (ledResize ed (termWsCols kin) (termWsRows kin))
                                          (ledRefreshPainted ed out (replPaintCurrent ed pending))
                                        })
                                      (termFlush out)
                                    })))
                            }
                          }
                        })))))))
        })
      (if (== state 1)
        (Some got)
        None)
    }
  })

; A one-byte Str. strAlloc zeroes, so the NUL is already in place.
(pub :: byteAsStr (-> Int String))
(pub fn (byteAsStr b)
  {
    (let s (strAlloc 1))
    {
      (memPutByte (strData s) 0 b)
      s
    }
  })

; ASCII whitespace trim, both ends - stage0 trims every line before
; classifying it.
(pub :: replTrim (-> String String))
(pub fn (replTrim s)
  {
    (let mut a 0)
    (let mut b (strLen s))
    {
      (while (&& (< a b) (replIsWs (strByte s a)))
        (set a (+ a 1)))
      (while (&& (> b a) (replIsWs (strByte s (- b 1))))
        (set b (- b 1)))
      (strSlice s a (- b a))
    }
  })

(pub :: replIsWs (-> Int Bool))
(pub fn (replIsWs c)
  (|| (== c 32) (|| (== c 9) (|| (== c 10) (== c 13)))))

; First `:word` of a command line, and the rest after it (trimmed).
(pub :: cmdWordEnd (-> String Int))
(pub fn (cmdWordEnd line)
  {
    (let n (strLen line))
    (let mut i 0)
    {
      (while (&& (< i n)
               (if (replIsWs (strByte line i))
                 false
                 true))
        (set i (+ i 1)))
      i
    }
  })

(pub :: cmdWord (-> String String))
(pub fn (cmdWord line)
  (strSlice line 0 (cmdWordEnd line)))

(pub :: cmdRest (-> String String))
(pub fn (cmdRest line)
  (replTrim (strSlice line (cmdWordEnd line) (- (strLen line) (cmdWordEnd line)))))

; ------------------------------------------------------------------
; Declaration-or-expression, decided the way stage0's
; parse_decl_or_expr decides: by whether the form's head is a
; declaration keyword. stage1's module parser cannot decide for us -
; it refuses everything else now (the tolerance that accepted
; `(+ 1 2)` as a module is gone) - so the head is inspected before
; choosing a parser.
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; AXTAGs AT THE PROMPT.
;
; Every `;`-led line was discarded by the loop, and an AXTAG is a
; `;`-led line, so a claim typed at the prompt reached nothing: it was
; never appended to `declsSrc`, never seen by `scanAxtags`, and never
; answered. Measured before this changed:
;
;   ;@axiom:restrict(no-io) above a function that calls `println`
;     -> AX3042 for the undeclared effect and NOTHING for the
;        restriction, where the same three lines in a FILE draw both
;   ;@axiom:effect(io) above the same function
;     -> AX3042 anyway, so an IO-performing function could not be
;        DEFINED at the prompt at all, with no workaround at the
;        prompt: `(println "hi")` typed as an expression works
;        (`replWrapper`'s `needsIo` retry), a function that prints
;        does not.
;
; The second is the one that decides this. A silently dropped claim is
; this project's most-refused defect; a claim that cannot be written
; is a language surface missing from a tool, and effect enforcement
; (2026-08-25) is what created it.
;
; So a `;@axiom:` line is now APPENDED to `declsSrc` like a
; declaration, where `parseModuleWith (lex wrapper) (scanAxtags
; wrapper)` reads it. Two things follow, and both are handled here
; rather than discovered later:
;
;   * A REDEFINITION must drop the old declaration's tags with it.
;     `replDropMatching` slices out the declaration's own span, so a
;     withdrawn function's `restrict(no-io)` would have been left
;     sitting above whatever declaration came next in the accumulated
;     source. `replTagRunStart` extends the removed range back over
;     the contiguous `;@axiom:` lines immediately above it - which are
;     exactly the tags that belong to it.
;
;   * A TRAILING tag - one typed with no declaration after it yet -
;     must not attach to the wrapper's own `(:: __repl_result ...)`,
;     which `replWrapper` splices in directly after `declsSrc`. It is
;     stripped from the copy the wrapper compiles and KEPT in
;     `declsSrc`, so it still attaches to the declaration the user
;     types next, however many expressions come in between - which is
;     what it would do in a file.
;
; `replTopLevelSpans` counts parens over the TOKEN stream, and the
; lexer drops comments, so `;@axiom:pre((> n 0))` cannot be mistaken
; for a top-level form however many parens it carries. That is why
; this is safe to put in `declsSrc` at all.
; ------------------------------------------------------------------
; Does a `;@axiom:` tag begin at `p`?
(pub :: replIsAxtagAt (-> String Int Int))
(pub fn (replIsAxtagAt src p)
  (if (> (+ p 8) (strLen src))
    0
    (if (strEq (strSlice src p 8) ";@axiom:")
      1
      0)))

(pub :: replIsAxtagLine (-> String Int))
(pub fn (replIsAxtagLine line)
  (replIsAxtagAt line 0))

; The offset of the first byte of the line containing `i`.
(pub :: replLineStartAt (-> String Int Int))
(pub fn (replLineStartAt src i)
  (if (<= i 0)
    0
    (if (== (strByte src (- i 1)) 10)
      i
      (replLineStartAt src (- i 1)))))

; The start of the line immediately above the one beginning at `s`, or
; None when `s` does not begin a line or there is nothing above it.
(pub :: replPrevLineStart (-> String Int (Option Int)))
(pub fn (replPrevLineStart src s)
  (if (<= s 1)
    None
    (if (== (strByte src (- s 1)) 10)
      (Some (replLineStartAt src (- s 2)))
      None)))

; `s`, moved back over the run of `;@axiom:` lines immediately above
; it. A tag belongs to the declaration below it, so this is the start
; of everything that declaration owns.
(pub :: replTagRunStart (-> String Int Int))
(pub fn (replTagRunStart src s)
  (match (replPrevLineStart src s)
    ((None) s)
    ((Some p)
      (if (== (replIsAxtagAt src p) 1)
        (replTagRunStart src p)
        s)
    )))

; `src` without its trailing run of `;@axiom:` lines - the tags that
; have no declaration under them yet.
(pub :: replStripTrailingTags (-> String String))
(pub fn (replStripTrailingTags src)
  {
    (let k (replTagRunStart src (strLen src)))
    (if (>= k (strLen src))
      src
      (strSlice src 0 k))
  })

(pub :: isDeclLine (-> String Bool))
(pub fn (isDeclLine line)
  (if (< (strLen line) 2)
    false
    (if (!= (strByte line 0) 40)
      false
      {
        (let w (declHeadWord line))
        (|| (strEq w "fn")
          (|| (strEq w "::")
            (|| (strEq w "pub")
              (|| (strEq w "data")
                (|| (strEq w "struct")
                  (|| (strEq w "import")
                    (|| (strEq w "macro")
                      (|| (strEq w "effect")
                        (|| (strEq w "type")
                          (|| (strEq w "trait")
                            (|| (strEq w "impl")
                              (|| (strEq w "subtype") (strEq w "extern")))))))))))))
      })))

; `impl` was missing while `trait` and `type` were
; here, so a trait implementation typed at the prompt
; went down the EXPRESSION path and was read as an
; application: `undefined variable `impl``, then
; `Sz`, `Int`, `where`, and a later `(sz 5)` answering
; `no implementation of `Sz` for `Int`` because the
; implementation had never been recorded.
; The identifier (or `::`) immediately after the opening paren.
(pub :: declHeadWord (-> String String))
(pub fn (declHeadWord line)
  {
    (let n (strLen line))
    (let mut i 1)
    {
      (while (&& (< i n) (replIsWs (strByte line i)))
        (set i (+ i 1)))
      {
        (let start i)
        {
          (while (&& (< i n)
                   {
                     (let c (strByte line i))
                     (if (== c 40)
                       false
                       (if (== c 41)
                         false
                         (if (replIsWs c)
                           false
                           true)))
                   })
            (set i (+ i 1)))
          (strSlice line start (- i start))
        }
      }
    }
  })

; ------------------------------------------------------------------
; Typing an expression against the accumulated declarations -
; stage0's check_single_expr re-expressed. The declaration text is
; parsed and checked FRESH (stage0 re-registers per line; the cost
; and the semantics both clone).
;
; IMPORTS ARE RESOLVED AND MACROS ARE EXPANDED HERE, and until
; 2026-08-15 neither was. This paragraph used to end "imports
; deliberately unresolved: stage0's REPL type-checks with a bare
; TypeChecker, which is why `(println "x")` is an undefined-variable
; error at the prompt even though the eval wrapper imports IO.
; Bug-for-bug." Three things retired that:
;
;   - stage0 is deleted, so bug-for-bug parity with it is no longer a
;     property anything can check. The roadmap set this precedent when
;     it replaced phase 4's byte-identity criterion: a criterion that
;     asks stage1 to keep the retiring compiler's design choices is
;     the wrong criterion (the roadmap's phase 4).
;   - The EVAL path already resolves and expands - `replCompile`
;     below - so the two halves of one prompt line disagreed about
;     what was in scope. The typing half ran first and rejected the
;     line, so the eval half's correctness was unobservable.
;   - `println` is a MACRO now (macro-system.md MAC-CAP-10). An
;     unexpanded prompt cannot print at all, and `(when true 5)` was
;     already `undefined variable `when`` for the same reason - the
;     defect was never about `IO`, it was about every imported macro
;     in the language.
;
; The blast radius is zero for the checked-in sessions: not one of the
; twelve imports anything, so resolution and expansion are both no-ops
; over them and `check-repl-selfhost.sh`'s goldens do not move. What
; changes is only what was impossible before.
;
; The frame table is discarded, exactly as `replCompile` discards it
; and for the same reason: the REPL's error line joins bare messages
; and the prompt IS the invocation site a frame would point back at.
;
; The rendered type, or None after reporting a parse or type error.
; ------------------------------------------------------------------
(pub :: typeExprAgainst (-> String String (Option String)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (typeExprAgainst declsSrc exprLine)
  {
    (let toks (lex exprLine))
    {
      (let er (parseExpr toks 0))
      (match er
        ((ParseFailed parseError1)
          {
            (replStyled REPL_ERROR "Parse error: the line does not parse as an expression\n")
            None
          }
        )
        ((ParseSuccess parsedValue1 parsedPos1)
          {
            (let dtoks (lex declsSrc))
            {
              (let dr (parseDecls dtoks 0 vecNew))
              (match dr
                ((ParseFailed parseError2)
                  {
                    (replStyled REPL_ERROR "Error: the accumulated declarations no longer parse\n")
                    None
                  }
                )
                ((ParseSuccess parsedValue2 parsedPos2)
                  ; `impl`s are LOWERED before the expression is
                  ; typed. `replCompile` has always done this on the
                  ; way to emission, so an implementation typed at
                  ; the prompt ran correctly and was rejected before
                  ; it got the chance: `(sz 5)` answered `no
                  ; implementation of `Sz` for `Int`` about one
                  ; sitting two lines above it.
                  ;
                  ; Imports and expansion now run here too, in the
                  ; order the file path uses: resolve, expand, lower,
                  ; check. The expression itself is expanded with the
                  ; same call, because a macro invocation at the
                  ; prompt - `(println "n={n}")` - is an EXPRESSION,
                  ; and typing it unexpanded asks about a name no
                  ; program ever contains.
                  ;
                  ; The expression rides into expansion as a
                  ; synthetic declaration and rides back out as its
                  ; body. There is no expression-level entry point
                  ; into the expander and there should not be one:
                  ; `expandProgram` is what the file path calls, so
                  ; routing the prompt through it is what keeps the
                  ; two agreeing about hygiene, budgets and
                  ; refusals. `expandDeclsIn` rewrites a body in
                  ; place, which is why the handle taken before the
                  ; call still answers after it.
                  ; The mangling records and the module filters are
                  ; kept and handed to expansion, rather than thrown
                  ; away as three `vecNew`s were: `:type` and the
                  ; eval half must agree about the program, and a
                  ; loaded module carrying a declaration-macro
                  ; invocation (MAC-EXP-16) is exactly a program the
                  ; one would refuse and the other compile.
                  ; Expansion's diagnostics are COLLECTED, not
                  ; discarded into a fresh Vec. Discarded, a line
                  ; whose macro refused still printed a type -
                  ; `(println "unclosed {x")` answered `type : Int`
                  ; and only then failed in the eval half, which
                  ; reads as the prompt contradicting itself.
                  {
                    (let decls parsedValue2)
                    (let units
                      {
                        (let v vecNew)
                        {
                          (vecPush v
                            (CUnit2
                              :file "<repl>"
                              :src declsSrc
                              :name None
                              :imports vecNew
                              :library false))
                          v
                        }
                      })
                    {
                      (let probe (mkDFnAt "__repl_type_probe" vecNew parsedValue1 0))
                      {
                        (let _pp (vecPush decls probe))
                        {
                          (let tbares vecNew)
                          (let tfulls vecNew)
                          (let tmods vecNew)
                          {
                            (let allDecls
                              (resolveImports decls tbares tfulls tmods
                                (checkedTargetCode hostTarget) "." units))
                            {
                              (let exDiags vecNew)
                              {
                                (let _ex
                                  (expandProgram decls allDecls exDiags vecNew (as 0 Units) tbares
                                    tfulls tmods))
                                (if (> (countErrorDiags exDiags) 0)
                                  {
                                    (printTypeErrors exDiags 0)
                                    None
                                  }
                                  ; `before` is taken AFTER the module walk, so the
                                  ; probe's own pass over the expression is not
                                  ; counted twice - only what `checkExpr` adds is
                                  ; printed.
                                  {
                                    (let tc (checkModuleTc allDecls allDecls units))
                                    {
                                      (let before (vecLen (tcOutVec tc)))
                                      {
                                        (let ty (checkExpr tc (nodeCChild probe)))
                                        {
                                          (let after (tcOutVec tc))
                                          (if (> (vecLen after) before)
                                            {
                                              (printTypeErrors after before)
                                              None
                                            }
                                            (Some (tyRender ty)))
                                        }
                                      }
                                    }
                                  })
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ))
            }
          }
        ))
    }
  })

(pub :: printTypeErrors (-> (Vec diag::Diag) Int Int))
;@axiom:effect(io)
(pub fn (printTypeErrors ds from)
  {
    (for i in from..(vecLen ds)
      {
        (let d (vecGet ds i))
        (let code (diagCode d))
        {
          (replStyled REPL_ERROR
            (concat (concat (concat (concat "Type error: [" code) "] ") (diagMsg d)) "\n"))
          (replStyled REPL_MUTED (concat (concat "  help: :explain " code) "\n"))
        }
      })
    0
  })

; ------------------------------------------------------------------
; The wrapper module - stage0's generate_repl_wrapper in intent: how
; a value prints is decided by the RENDERED type string, the result
; carrier is declared `(-> Int <carrier>)`, and Bool is converted at
; the source because nothing prints one. One divergence from stage0,
; forced 2026-08-15: a String result declares a String carrier -
; stage0 declared Int and leaned on the String/Int fiat, and the
; wrapper is a compiled program like any other, so the fiat's
; deletion reached it too.
;
; `needsIo`, added 2026-08-31. `__repl_result` carried no AXTAG at
; all, so effect enforcement (2026-08-25, see the effect-enforcement
; record) refused every wrapper whose body performs IO:
; `(println "hi")` typed `type : Int` and then answered `Error:
; \`__repl_result\` performs IO and its declaration does not say so`
; (AX3042) - measured on this tree before this parameter existed,
; with `(import IO)` already in scope. `main` already carries
; `;@axiom:effect(io)` two lines below for the same reason `println`
; inside `printExpr` needs it; `__repl_result` needed the identical
; tag whenever the EXPRESSION does, and had never been given one.
; The caller (`replCompileExpr`) does not know in advance whether an
; expression performs IO - answering that ahead of time is the
; effect walk's job, not the wrapper's - so it compiles once without
; the tag and, on exactly this AX3042, once more with it
; (`replIoRetryNeeded`/`replTryCompile`). `needsIo 0` reproduces the
; PRE-2026-08-31 bytes exactly: the empty string this pushes in place
; of the tag line is the whole of the diff.
; ------------------------------------------------------------------
; The imports every session starts with, ahead of the user's own
; declarations: what the wrapper compiles against, and so what a
; declaration is checked against as it is typed.
(pub :: replPrelude String)
(pub fn (replPrelude)
  "(import IO)\n(import Str)\n(import Mem) (import Utf8 (utf8FromChar))\n")

(pub :: replWrapper (-> String String String Int String))
(pub fn (replWrapper declsSrc exprLine tyStr needsIo)
  {
    (let printExpr
      (if (strEq tyStr "()")
        "{ (__repl_result 0) (println \"()\") }"
        (if (strEq tyStr "Bool")
          "(if (== (__repl_result 0) 1) (println \"true\") (println \"false\"))"
          (if (|| (strEq tyStr "String") (strEq tyStr "Str"))
            "(println (__repl_result 0))"
            (if (strEq tyStr "Char")
              "(println (utf8FromChar (as (__repl_result 0) Int)))"
              "(println (__repl_result 0))")))))
    (let carrier
      (if (|| (> (integerTypeCode tyStr) 0) (|| (strEq tyStr "Float") (strEq tyStr "()")))
        tyStr
        (if (strEq tyStr "Char")
          "Char"
          (if (|| (strEq tyStr "String") (strEq tyStr "Str"))
            "String"
            "Int"))))
    (let body
      (if (strEq tyStr "Bool")
        (concat (concat "(if " exprLine) " 1 0)")
        exprLine))
    (catStrs
      {
        (let v vecNew)
        {
          (vecPush v replPrelude)
          ; The TRAILING tags stripped: a `;@axiom:` line typed with no
          ; declaration under it yet would otherwise attach to the
          ; `(:: __repl_result ...)` spliced in three lines below, and
          ; a `restrict(no-io)` meant for the user's next function
          ; would be answered against the REPL's own carrier. It stays
          ; in `declsSrc` and attaches to whatever the user declares
          ; next - see `replStripTrailingTags`.
          (vecPush v (replStripTrailingTags declsSrc))
          (vecPush v "\n(:: __repl_result (-> Int ")
          (vecPush v carrier)
          (vecPush v "))\n")
          (vecPush v
            (if (== needsIo 1)
              ";@axiom:effect(io)\n"
              ""))
          (vecPush v "(fn (__repl_result _dummy) ")
          (vecPush v body)
          (vecPush v ")\n(:: main ())\n;@axiom:effect(io)\n(fn (main) { ")
          (vecPush v printExpr)
          (vecPush v " })")
          v
        }
      })
  })

; ------------------------------------------------------------------
; Compile a complete wrapper module to IR through this compiler's
; own pipeline, WITHOUT compileFile - the REPL must survive a bad
; line, and compileFile exits. Import resolution still dies if the
; stdlib itself is unreachable, which is an environment failure, not
; a line failure; recorded.
; Compile without exiting on a source failure.
; ------------------------------------------------------------------
; A compile result owns emitted IR or its diagnostics. A wrapper that
; cannot be parsed carries an empty diagnostic vector. Callers can inspect
; a missing IO declaration before printing a failure and choosing a retry.
(pub data ReplCompileResult
  (ReplCompiled String)
  (ReplCompileFailed (Vec diag::Diag)))

(pub :: replTryCompile (-> String ReplCompileResult))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (replTryCompile wrapper)
  {
    (let pr (parseModuleWith (lex wrapper) (scanAxtags wrapper)))
    (match pr
      ((ParseFailed parseError3)
        ; The wrapper did not parse, so there are no checker diagnostics.
        (ReplCompileFailed vecNew)
      )
      ((ParseSuccess parsedValue3 parsedPos3)
        ; The REPL compiles and RUNS, so it needs the same expansion
        ; the file path gets. When expansion lived in codegen this
        ; came for free; now it does not, and without this line a
        ; macro defined at the prompt emitted a call to a symbol
        ; nothing defines - `use of undefined value '@twice'`.
        ; The frame table is discarded here on purpose: the REPL's
        ; error line joins bare MESSAGES (`joinDiagMsgs`), its
        ; goldens pin those bytes, and the prompt IS the invocation
        ; site the frame would point back at.
        {
          (let decls parsedValue3)
          (let tcode (checkedTargetCode hostTarget))
          (let bares vecNew)
          (let fulls vecNew)
          (let mods vecNew)
          (let units
            {
              (let v vecNew)
              {
                (vecPush v
                  (CUnit2 :file "<repl>" :src wrapper :name None :imports vecNew :library false))
                v
              }
            })
          {
            (let allDecls (resolveImports decls bares fulls mods tcode "." units))
            {
              (let eds
                {
                  (let v vecNew)
                  {
                    (expandProgram decls allDecls v vecNew (as 0 Units) bares fulls mods)
                    v
                  }
                })
              {
                ; The same sealed handoff `build` uses: the emitter sees the
                ; declarations the final check accepted, and only those.
                (let checked (checkExpandedProgram decls allDecls units))
                (let ds (expMergeInto eds checked.diagnostics))
                (if (> (countErrorDiags ds) 0)
                  (ReplCompileFailed ds)
                  (ReplCompiled
                    (emitCheckedProgram (checkedProgramOf checked) bares fulls tcode false)))
              }
            }
          }
        }
      ))
  })

(pub :: replCompile (-> String (Option String)))
;@axiom:effect(io)
(pub fn (replCompile wrapper)
  (match (replTryCompile wrapper)
    ((ReplCompiled ir) (Some ir))
    ((ReplCompileFailed diagnostics)
      {
        (if (== (vecLen diagnostics) 0)
          (replStyled REPL_ERROR "Error: parsing failed\n")
          (replStyled REPL_ERROR (concat "Error: " (joinDiagMsgs diagnostics))))
        None
      }
    )))

; Is `ds` EXACTLY the one AX3042 `replWrapper`'s missing IO tag draws
; on `__repl_result`? Checked by code AND by name, not by code alone:
; AX3042 fires on any undeclared-effect body, and retrying with the
; tag only helps when the undeclared body IS `__repl_result` - a
; user's own function drawing its own AX3042 (a real bug in what they
; typed) must be reported, not silently retried into a second,
; unrelated failure.
(pub :: replIoRetryNeeded (-> (Vec diag::Diag) Bool))
(pub fn (replIoRetryNeeded ds)
  (if (!= (vecLen ds) 1)
    false
    {
      (let d (vecGet ds 0))
      (if (strEq (diagCode d) "AX3042")
        (if (let (Some _) (strFind (diagMsg d) "__repl_result" 0))
          true
          false)
        false)
    }))

; One expression, wrapped and compiled - the retry that closes
; AX3042 lives here once, so `replExpr` and `:llvm` (`replCmdLlvm`)
; both get it rather than one growing a second copy. First attempt
; carries no IO tag, which is right for the overwhelming majority of
; REPL expressions and costs them nothing extra: `replTryCompile`
; fails at the type-check stage, before `emitResolved` and before any
; `llc`/`cc` invocation, so the untagged attempt is a second parse and
; typecheck, not a second link. Only an IO-performing expression pays
; for both.
(pub :: replCompileExpr (-> String String String (Option String)))
;@axiom:effect(io)
(pub fn (replCompileExpr declsSrc exprLine tyStr)
  (match (replTryCompile (replWrapper declsSrc exprLine tyStr 0))
    ((ReplCompiled ir) (Some ir))
    ((ReplCompileFailed diagnostics)
      (if (replIoRetryNeeded diagnostics)
        (replCompile (replWrapper declsSrc exprLine tyStr 1))
        {
          (if (== (vecLen diagnostics) 0)
            (replStyled REPL_ERROR "Error: parsing failed\n")
            (replStyled REPL_ERROR (concat "Error: " (joinDiagMsgs diagnostics))))
          None
        })
    )))

(pub :: joinDiagMsgs (-> (Vec diag::Diag) String))
(pub fn (joinDiagMsgs ds)
  {
    (let parts vecNew)
    {
      (for i in 0..(vecLen ds)
        {
          (if (> i 0)
            (vecPush parts "; "))
          (vecPush parts (diagMsg (vecGet ds i)))
        })
      (vecPush parts "\n")
      (catStrs parts)
    }
  })

; ------------------------------------------------------------------
; Where the session's scratch files go: `$TMPDIR` when the environment
; names one that is safe to use here, `/tmp` otherwise.
;
; Reading the environment at all is what makes this shared temp
; directory not hard-coded, which is the point on a machine where
; every user can write `/tmp`. It also lets a hostile environment
; choose bytes this file later hands to `/bin/sh`, so TMPDIR is
; checked, not trusted, and two cases fall back:
;
;   * a RELATIVE TMPDIR. `pathJoin` answers `name` alone when `dir` is
;     empty, so an unset or relative TMPDIR would put the scratch
;     directory in the working directory - somewhere the caller did
;     not choose and the REPL then writes an executable into.
;   * a TMPDIR containing `'` (byte 39). The capture below is
;     `sh -c "exec '<exe>' > '<out>'"`, single-quoted; a quote in the
;     path closes the quoting, so `TMPDIR=/tmp/x'; id #` would run
;     `id`. Nothing else in this file reaches a shell.
;
; Darwin's per-user TMPDIR (`/var/folders/.../T/`) passes both, its
; trailing slash included - `pathJoin` collapses it.
; ------------------------------------------------------------------
(:: replTmpRoot String)
;@axiom:effect(io)
(fn (replTmpRoot)
  {
    (let t (sysEnv "TMPDIR"))
    (if (&& (pathIsAbsolute t)
          (if (let (Some _) (strFindByte t 39 0))
            false
            true))
      t
      "/tmp")
  })

; ------------------------------------------------------------------
; Assemble, link, run, capture. The four scratch files live INSIDE a
; directory this process creates and owns - `<tmp>/axiom-repl-<pid>.d`
; with mode 0700 - not as four sibling names in a directory everyone
; can write.
;
; Two different bugs have been closed here and they are easy to mix
; up, so both are written down.
;
; DISTINCTNESS, fixed 2026-08-08. The pid suffix was a lie: it used
; `driver$fmtIntStr`, which renders 0, 1, 2, 3 and answers "1" for
; everything else - its own comment says so, because it exists to
; spell the `n` in `-O<n>` and nothing else. Every REPL on the machine
; therefore wrote `/tmp/axiom-repl-1.{ll,o,out}`, and two sessions
; collided on exactly the files the suffix promised they would not.
; `Fmt$fmtInt` renders any integer and is already
; imported here.
;
; PREDICTABILITY, fixed 2026-08-23, and NOT the same property.
; `decStr` made the names distinct between processes and left them
; derivable by anyone who can read the process table. `sysWriteFile`
; opens with `oWronlyCreateTrunc` - no `O_EXCL`, no `O_NOFOLLOW` - so
; a symlink already sitting at the name is followed and its target
; truncated and rewritten. Measured on this tree before the fix: with
; `/tmp/axiom-repl-<pid>.ll` and `.out` symlinked at a 29-byte file,
; one `(+ 1 2)` left that file 2 bytes long holding the evaluated `3`,
; having passed through the generated IR on the way. The `.o` and the
; bare executable name are the same shape, and the executable is the
; one this function then RUNS.
;
; One private directory closes all four at once: nothing can be
; planted inside a directory that does not exist until this process
; makes it. `sysMkdir` answers `-17` (EEXIST) rather than opening what
; is already there, so the create is exclusive and this is not a
; check-then-use race - anything already at that name, whether a
; directory someone else made, a symlink or a file, makes this refuse
; and evaluate nothing. Adding `O_EXCL`/`O_NOFOLLOW` to the write
; instead would need a flag `Sys` does not export and would still
; leave `cc -o <exe>` and the shell's `> <out>` uncovered; neither of
; those goes through `sysWriteFile`, so neither would ever see it.
;
; 448 is 0700: this process, and nothing else, may put a name in the
; directory or read what is in it. Any non-zero answer from `sysMkdir`
; is a refusal to evaluate, not a warning.
;
; The directory is made and removed per EVALUATION - the same lifetime
; the four flat files already had - so a session accumulates nothing,
; and a later REPL that draws a recycled pid is not blocked by a
; corpse left by an earlier one.
;
; The child's stdout is captured by running it through
; `sh -c "exec PROG > OUT"` - the one place a shell is borrowed,
; because the spawn primitive inherits stdio and Darwin's
; posix_spawn file_actions descriptor is not a documented shape (the
; self-hosting record, phase-5 notes).
; ------------------------------------------------------------------
(pub :: replEval (-> String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (replEval ir)
  {
    (let pid sysPid)
    {
      (let leaf (concat (concat "axiom-repl-" (fmtInt pid)) ".d"))
      {
        (let dir (pathJoin replTmpRoot leaf))
        (if (isErr (makeDirMode dir 448))
          (replStyled REPL_ERROR "Error: could not create a private scratch directory\n")
          {
            (let base (pathJoin dir "expr"))
            {
              (let ll (concat base ".ll"))
              (let obj (concat base ".o"))
              (let exe base)
              (let outf (concat base ".out"))
              {
                (if (isErr (writeFile ll ir))
                  (replStyled REPL_ERROR "Error: could not write the generated IR\n")
                  {
                    (let lrc
                      (runTool "llc"
                        {
                          (let v vecNew)
                          {
                            (vecPush v ll)
                            (vecPush v "-relocation-model=pic")
                            (vecPush v "-filetype=obj")
                            (vecPush v "-o")
                            (vecPush v obj)
                            v
                          }
                        }))
                    (if (! (toolSucceeded lrc))
                      (replStyled REPL_ERROR "Error: llc rejected the generated code\n")
                      {
                        (let crc
                          (runTool "cc"
                            {
                              (let v vecNew)
                              {
                                (vecPush v obj)
                                (vecPush v "-o")
                                (vecPush v exe)
                                v
                              }
                            }))
                        (if (! (toolSucceeded crc))
                          (replStyled REPL_ERROR "Error: linking failed\n")
                          {
                            (let cmd
                              (catStrs
                                {
                                  (let v vecNew)
                                  {
                                    (vecPush v "exec '")
                                    (vecPush v exe)
                                    (vecPush v "' > '")
                                    (vecPush v outf)
                                    (vecPush v "'")
                                    v
                                  }
                                }))
                            {
                              (let rc (runTool "/bin/sh" (argsOf3 "-c" cmd "")))
                              {
                                (let printed (replTrim (unwrapOr (readFile outf) "")))
                                (if (> (strLen printed) 0)
                                  (replStyled REPL_VALUE (concat (concat "result " printed) "\n"))
                                  (match rc
                                    ((Err _)
                                      (replStyled REPL_ERROR
                                        "Error: the program was terminated by a signal\n")
                                    )
                                    ((Ok code)
                                      ; Exit status is a byte, including values above 3.
                                      (replStyled REPL_VALUE
                                        (concat (concat "result " (fmtInt code)) "\n"))
                                    )))
                              }
                            }
                          })
                      })
                  })
                (unwrapOr (removeFile ll) 0)
                (unwrapOr (removeFile obj) 0)
                (unwrapOr (removeFile exe) 0)
                (unwrapOr (removeFile outf) 0)
                ; The directory goes with the files it held. `sysRmdir`
                ; only removes an EMPTY one, so a name this function did
                ; not create and did not empty survives, and the four
                ; unlinks above are what earn the removal.
                (unwrapOr (removeDir dir) 0)
                0
              }
            }
          })
      }
    }
  })

; One expression, end to end: type, announce, wrap, compile, run.
(pub :: replExpr (-> String String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (replExpr declsSrc line)
  {
    (let tr (typeExprAgainst declsSrc line))
    (match tr
      ((None) 0)
      ((Some parsedValue6)
        {
          (let tyStr parsedValue6)
          {
            (replStyled REPL_MUTED (concat (concat "type : " tyStr) "\n"))
            {
              (let cr (replCompileExpr declsSrc line tyStr))
              (match cr
                ((None) 0)
                ((Some parsedValue8) (replEval parsedValue8)))
            }
          }
        }
      ))
  })

; If `src` ends in a newline right at `pos`, the position past it;
; `pos` itself otherwise. `replDecl` always appends `line "\n"`, so a
; decl dropped by `replDropMatching` leaves exactly one newline behind
; it unless this also consumes the one that belonged to it - checked:
; without this, three redefinitions of `f` left two blank lines where
; the first two used to be, growing without bound over a long session.
(pub :: replSkipNl (-> String Int Int))
(pub fn (replSkipNl src pos)
  (if (&& (< pos (strLen src)) (== (strByte src pos) 10))
    (+ pos 1)
    pos))

; The byte span of every top-level `(...)` form in `src`, in source
; order, found by counting parens over the TOKEN stream rather than by
; reading `nodeSpan` off a parsed decl. Measured why that distinction
; matters: `mkDFnAt`'s callers (parser.ax:4259 among them) pass
; `nodeSpan` a single TOKEN's span - sized for pointing a `duplicate
; definition` diagnostic at a name, per `PResult`'s own comment above
; about `exp`/`pos` - not for bounding the form that contains it.
; `replDropMatching`'s first version spliced out a few bytes from the
; middle of `(fn (f) 1)` instead of the whole form and left `(fn ()
; 1)` behind, which does not parse; measured, `Error: the accumulated
; declarations no longer parse` on the very next line typed.
(pub :: replTopLevelSpans (-> String Ints))
(pub fn (replTopLevelSpans src)
  {
    (let toks (lex src))
    (let out vecNew)
    {
      (let n (vecLen toks))
      (let mut i 0)
      {
        (while (< i n)
          {
            (let k (kindInt (tokenKind (vecGet toks i))))
            (if (== k (kindInt TK_LPAREN))
              {
                (let start (spanStart (tokenSpan (vecGet toks i))))
                {
                  (let mut depth 1)
                  (let mut j (+ i 1))
                  (let mut endTok i)
                  {
                    (while (&& (> depth 0) (< j n))
                      {
                        {
                          (let k2 (kindInt (tokenKind (vecGet toks j))))
                          (if (== k2 (kindInt TK_LPAREN))
                            (set depth (+ depth 1))
                            (if (== k2 (kindInt TK_RPAREN))
                              {
                                (set depth (- depth 1))
                                (set endTok j)
                              }))
                        }
                        (set j (+ j 1))
                      })
                    (vecPush out (mkSpan start (spanEnd (tokenSpan (vecGet toks endTok)))))
                    ; `j` already sits one past the RPAREN that closed
                    ; depth to 0 (the loop's own `(set j (+ j 1))` ran
                    ; on that same iteration) - `i` continues FROM
                    ; there, not past it a second time.
                    (set i j)
                  }
                }
              }
              (set i (+ i 1)))
          })
        out
      }
    }
  })

; `src` with the top-level declaration named `name` of tag `tag`
; removed, or `src` unchanged if none matches (including: `src` does
; not parse, which should not happen to an accumulated `declsSrc` but
; is handled by leaving it alone rather than losing it). One matching
; decl is expected per call; `src` is walked once and every match
; dropped, in case an earlier bug (or a hand-edited `:load`ed file)
; left more than one. `decls[i]` and `replTopLevelSpans(src)[i]`
; are the same top-level form by construction: every decl this
; language has IS one `(...)` form (`isDeclLine` refuses anything
; that does not open with `(`), so parsing and paren-counting see the
; same forms in the same order and agree on the count.
(pub :: replDropMatching (-> String Int String String))
(pub fn (replDropMatching src tag name)
  {
    (let dr (parseDecls (lex src) 0 vecNew))
    (match dr
      ((ParseFailed parseError9) src)
      ((ParseSuccess parsedValue9 parsedPos9)
        {
          (let decls parsedValue9)
          (let spans (replTopLevelSpans src))
          (let mut out "")
          (let mut cursor 0)
          (let mut i 0)
          {
            (while (&& (< i (vecLen decls)) (< i (vecLen spans)))
              {
                {
                  (let d (vecGet decls i))
                  (if (&& (== (nodeTag d) tag) (strEq (nodeAName d) name))
                    ; The declaration's own span, extended back over the
                    ; `;@axiom:` lines above it: a redefinition
                    ; withdraws the claims written about the definition
                    ; it replaces, exactly as rewriting the function in
                    ; a file would. Without this the old function's
                    ; `restrict(no-io)` was left above whatever
                    ; declaration came next in `declsSrc`.
                    {
                      (let sp (vecGet spans i))
                      {
                        (let s (replTagRunStart src (spanStart sp)))
                        (let e (spanEnd sp))
                        {
                          (set out (concat out (strSlice src cursor (- s cursor))))
                          (set cursor (replSkipNl src e))
                        }
                      }
                    })
                }
                (set i (+ i 1))
              })
            (concat out (strSlice src cursor (- (strLen src) cursor)))
          }
        }
      ))
  })

; `declsSrc` with every earlier top-level decl that `newDecls` is
; about to shadow removed first - one call per parsed decl, in the
; rare case one prompt line held more than one (`parseDecls` allows
; it even though the REPL only ever hands it one line at a time).
;
; Matched by (tag, name) TOGETHER, not by name alone: a `::`
; signature and the `fn` implementing it legitimately share a name
; (the help text recommends writing both), and dropping the
; signature the moment its body arrived would silently discard a
; type annotation the user asked for. Only `fn`, `::`, `data` and
; `struct` are tracked - the four kinds `replDecl`'s own OK line
; already names below - so an `import`, `macro`, `effect`, `type`,
; `trait` or `impl` re-declaration still accumulates as it always
; did; recorded, not fixed here.
(pub :: replDeclsSrcDropping (-> String (Vec ASTNode) String))
(pub fn (replDeclsSrcDropping declsSrc newDecls)
  {
    (let mut out declsSrc)
    {
      (for nd in newDecls
        {
          (let tag (nodeTag nd))
          (if (|| (== tag TAG_D_FN)
                (|| (== tag TAG_D_SIG) (|| (== tag TAG_D_DATA) (== tag TAG_D_STRUCT))))
            (set out (replDropMatching out tag (nodeAName nd))))
        })
      out
    }
  })

; A declaration line: appended to the source store unconditionally
; once it PARSES (stage0 gates on parse alone - a decl with a type
; error is still appended, and the error surfaces when something
; uses it). The OK line names fn and sig declarations; data-shaped
; ones say so; anything else is a bare OK.
;
; REDEFINITION, closed 2026-08-31. `declsSrc` is everything the
; session ever typed, concatenated - so `(fn (f) 1)` then `(fn (f)
; 2)` used to leave BOTH copies in the source the wrapper module
; compiles, and codegen answered `Error: duplicate definition \`f\``.
; Measured on this tree before the fix: not just `(f)` broke - every
; LATER expression did too, because `replCompileExpr` recompiles the
; whole of `declsSrc` on every call, so the stale duplicate poisoned
; expressions that never mentioned `f`, recoverable only by `:reset`
; (which discards everything else in the session along with it). The
; fix is `replDeclsSrcDropping`: before appending, drop whatever this
; line is about to shadow, so the redefinition REPLACES rather than
; accumulates - exactly what typing the same name twice in one file
; would mean if the second definition simply overwrote the first.
; The accumulated declarations, checked the way `check` checks the file
; they will become: resolved, expanded, and handed to the final check.
; Every error is printed as an expression's would be, and 1 answers
; "refused". One code is deferred rather than refused: AX3015, a
; signature with no definition behind it, because a session types the
; signature on one line and the definition on the next, and the
; expression path reports the gap when a call reaches it.
(pub :: replCheckDecls (-> String Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (replCheckDecls src)
  {
    ; The program the wrapper would compile, less its result carrier:
    ; the prelude's imports, then the declarations with their AXTAGs
    ; attached as `check` attaches a file's, so a claim such as
    ; `effect(pure)` is checked here and not read as a comment. A
    ; trailing tag is left for the declaration typed next, as the
    ; wrapper leaves it.
    (let program (concat replPrelude (replStripTrailingTags src)))
    (let dr (parseModuleWith (lex program) (scanAxtags program)))
    (match dr
      ((ParseFailed parseError10) 0)
      ((ParseSuccess parsedValue10 parsedPos10)
        {
          (let decls parsedValue10)
          (let units
            {
              (let v vecNew)
              {
                (vecPush v
                  (CUnit2 :file "<repl>" :src program :name None :imports vecNew :library false))
                v
              }
            })
          (let tbares vecNew)
          (let tfulls vecNew)
          (let tmods vecNew)
          (let allDecls
            (resolveImports decls tbares tfulls tmods (checkedTargetCode hostTarget) "." units))
          (let exDiags vecNew)
          (let _ex (expandProgram decls allDecls exDiags vecNew (as 0 Units) tbares tfulls tmods))
          (if (> (countErrorDiags exDiags) 0)
            {
              (printTypeErrors exDiags 0)
              1
            }
            {
              (let checked (checkExpandedProgram decls allDecls units))
              (let kept (replDiagsButDeferred checked.diagnostics vecNew 0))
              (if (> (countErrorDiags kept) 0)
                {
                  (printTypeErrors kept 0)
                  1
                }
                0)
            })
        }
      ))
  })

; `ds` without the deferred code, in order.
(pub :: replDiagsButDeferred (-> (Vec diag::Diag) (Vec diag::Diag) Int (Vec diag::Diag)))
(pub fn (replDiagsButDeferred ds acc i)
  (if (>= i (vecLen ds))
    acc
    {
      (if (! (strEq (diagCode (vecGet ds i)) "AX3015"))
        (vecPush acc (vecGet ds i)))
      (replDiagsButDeferred ds acc (+ i 1))
    }))

(pub :: replDecl (-> String String String))
;@axiom:effect(io)
(pub fn (replDecl declsSrc line)
  {
    (let dr (parseDecls (lex line) 0 vecNew))
    (match dr
      ((ParseFailed parseError11)
        {
          (replStyled REPL_ERROR "Parse error: the declaration does not parse\n")
          declsSrc
        }
      )
      ((ParseSuccess parsedValue11 parsedPos11)
        {
          (let decls parsedValue11)
          {
            (let candidate (concat (concat (replDeclsSrcDropping declsSrc decls) line) "\n"))
            (match (parseDecls (lex candidate) 0 vecNew)
              ((ParseFailed parseError12)
                {
                  (replStyled REPL_ERROR
                    "Parse error: imports must precede all definitions; use :reset before starting a new import header\n")
                  declsSrc
                }
              )
              ((ParseSuccess parsedValue12 parsedPos12)
                ; A declaration is checked as it is typed, as `check`
                ; would check the file it will become: one the compiler
                ; refuses is reported and not kept, so the session never
                ; holds what a program could not.
                (if (!= (replCheckDecls candidate) 0)
                  ; the tags typed above it would otherwise sit above
                  ; whatever is declared next (`replTagRunStart`)
                  (replStripTrailingTags declsSrc)
                  {
                    (if (== (vecLen decls) 0)
                      (replStyled REPL_ACCENT "OK\n")
                      {
                        (let d (vecGet decls 0))
                        {
                          (let tag (nodeTag d))
                          (if (|| (== tag TAG_D_FN) (== tag TAG_D_SIG))
                            (replStyled REPL_ACCENT
                              (concat (concat "OK: " (nodeAName d)) " defined\n"))
                            (if (|| (== tag TAG_D_DATA) (== tag TAG_D_STRUCT))
                              (replStyled REPL_ACCENT
                                (concat (concat "OK: data " (nodeAName d)) " defined\n"))
                              (replStyled REPL_ACCENT "OK\n")))
                        }
                      })
                    candidate
                  })
              ))
          }
        }
      ))
  })

; ------------------------------------------------------------------
; Colon commands - stage0's surface exactly, minus what is recorded
; divergent. `?` was advertised by stage0's help and DEAD in its
; dispatch (only `:`-prefixed lines reach handle_command), and this
; file reproduced both halves until 2026-09-21: the help line keeps
; `?` so the dispatch `replColon` answers it with `replHelp` like
; `:help` and `:h`.
; ------------------------------------------------------------------
(pub :: replHelp Int)
;@axiom:effect(io)
(pub fn (replHelp)
  {
    (replStyled REPL_ACCENT "\nCommands:\n")
    (replStyled REPL_TEXT "  :help, :h, ?       Show help\n")
    (replStyled REPL_TEXT "  :quit, :q, :exit   Exit the REPL\n")
    (replStyled REPL_TEXT "  :type, :t <expr>   Show an expression's type\n")
    (replStyled REPL_TEXT "  :load, :l <file>   Load declarations from a file\n")
    (replStyled REPL_TEXT "  :reset, :r         Clear session definitions\n")
    (replStyled REPL_TEXT "  :defs, :d          List session definitions\n")
    (replStyled REPL_TEXT "  :llvm <expr>       Show generated LLVM IR\n")
    (replStyled REPL_TEXT "  :time <expr>       Time expression evaluation\n")
    (replStyled REPL_TEXT "  :explain <topic>   Explain a diagnostic, keyword or @tag\n")
    (replStyled REPL_ACCENT "\nTips:\n")
    (replOut "  • Define functions: (fn (add x y) (+ x y))\n")
    (replOut "  • Type signatures: (:: add (-> Int Int Int))\n")
    (replOut "  • Data types: (data Maybe (a) (Nothing) (Just a))\n")
    (replOut "  • Expressions are evaluated and results shown\n")
    (replOut "  • Use ; for line comments\n")
    (replOut "  • Unbalanced input continues on the next line; two blank lines abort the entry\n")
    ; Advertise the editing commands available on this surface.
    (if (== replInteractive 0)
      (replOut "  • No history or line editing; Ctrl+D ends the session, Ctrl+C kills it\n")
      {
        (replOut
          "  • Arrows, Ctrl-A/E/B/F/K/U/W/Y and Alt-b/f/d edit the line; Ctrl+D ends the session, Ctrl+C cancels the line\n")
        (replOut "  • Up/Down (Ctrl-P/Ctrl-N) recall history across lines and sessions\n")
        (replOut
          "  • Ctrl-R steps back through history matching the line; Tab completes names and commands (Escape cancels the menu)\n")
        (replOut
          "  • Syntax highlighting follows the cursor, brackets included; an unclosed string keeps reading like an open paren\n")
        (replOut
          "  • An unclosed form keeps reading, indented; Ctrl+C or two blank lines abort it\n")
      })
    (replOut "\n")
    0
  })

(pub :: replBanner Int)
;@axiom:effect(io)
(pub fn (replBanner)
  {
    (replStyled REPL_ACCENT (concat "Axiom " (concat axiomVersion " - REPL\n")))
    (if (== replInteractive 1)
      (replStyled REPL_MUTED "Tab completes · Ctrl-R searches history · :help lists commands\n\n")
      (replOut "Type :help for commands, :quit to exit\n\n"))
    0
  })

; :explain uses the same diagnostic registry and language lexicon as
; `axiom explain`. Looking up help never evaluates a session expression.
(pub :: replCmdExplain (-> String Int))
;@axiom:effect(io)
(pub fn (replCmdExplain topic)
  (if (== (strLen topic) 0)
    (replStyled REPL_ERROR
      "Error: Usage: :explain <code, keyword or @tag>; :explain --list lists diagnostics\n")
    (if (strEq topic "--list")
      (replStyled REPL_TEXT explainListText)
      {
        (let diagnostic (explainText (explainNormalize topic)))
        {
          (let text
            (if (> (strLen diagnostic) 0)
              diagnostic
              (explainLexicon topic)))
          (if (> (strLen text) 0)
            (replStyled REPL_TEXT text)
            (replStyled REPL_ERROR
              (concat (concat "Error: Unknown diagnostic code or word '" topic)
                "'. Use :explain --list or :help.\n")))
        }
      })))

; :type - the argument as typed, colon, its type. Does not evaluate.
(pub :: replCmdType (-> String String Int))
;@axiom:effect(io)
(pub fn (replCmdType declsSrc arg)
  (if (== (strLen arg) 0)
    {
      (replStyled REPL_ERROR "Error: Usage: :type <expression>\n")
      0
    }
    {
      (let tr (typeExprAgainst declsSrc arg))
      (match tr
        ((None) 0)
        ((Some parsedValue13)
          {
            (replStyled REPL_TEXT
              (catStrs
                {
                  (let v vecNew)
                  {
                    (vecPush v arg)
                    (vecPush v " : ")
                    (vecPush v parsedValue13)
                    (vecPush v "\n")
                    v
                  }
                }))
            0
          }
        ))
    }))

; :load - the whole file must parse; type errors refuse the load;
; warnings load and are said out loud (stage0's rule).
(:: replLoadFileError (-> String String String))
;@axiom:effect(io)
(fn (replLoadFileError declsSrc arg)
  {
    (replStyled REPL_ERROR (concat (concat "File error: cannot read '" arg) "'\n"))
    declsSrc
  })

(pub :: replCmdLoad (-> String String String))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (replCmdLoad declsSrc arg)
  (if (== (strLen arg) 0)
    {
      (replStyled REPL_ERROR "Error: Usage: :load <filename>\n")
      declsSrc
    }
    (match (readFile arg)
      ((Err _) (replLoadFileError declsSrc arg))
      ((Ok src)
        (if (== (strLen src) 0)
          (replLoadFileError declsSrc arg)
          {
            (let pr (parseModuleWith (lex src) (scanAxtags src)))
            (match pr
              ((ParseFailed parseError14)
                {
                  (replStyled REPL_ERROR "Parse error: the file does not parse\n")
                  declsSrc
                }
              )
              ((ParseSuccess parsedValue14 parsedPos14)
                (match (parseDecls (lex (concat (concat declsSrc src) "\n")) 0 vecNew)
                  ((ParseFailed parseError15)
                    {
                      (replStyled REPL_ERROR
                        "Parse error: loaded imports must precede session definitions; use :reset before loading this module\n")
                      declsSrc
                    }
                  )
                  ((ParseSuccess parsedValue15 parsedPos15)
                    ; `:load` used to hand `decls` to `checkModule`
                    ; TWICE - as the entry file and as the whole
                    ; program - so a file's imports were never
                    ; resolved and every name they provide was
                    ; undefined. Measured before this line: 196 of the
                    ; 219 corpus files `check` accepts were refused by
                    ; `:load`, which is nearly all of them, because
                    ; almost every file imports something.
                    ;
                    ; The entry directory is the LOADED FILE's, not
                    ; the process's: `:load tests/selfhost/x.ax` has
                    ; to find the modules sitting beside it, the same
                    ; way `check` does. `replCompile` passes "." for
                    ; the opposite reason - its wrapper has no file.
                    ;
                    ; Expansion comes with it. A loaded file may
                    ; define macros and `impl`s, and checking the
                    ; unexpanded list reports an implementation's body
                    ; as undefined names.
                    {
                      (let decls parsedValue14)
                      (let tcode (checkedTargetCode hostTarget))
                      (let bares vecNew)
                      (let fulls vecNew)
                      (let mods vecNew)
                      (let units
                        {
                          (let v vecNew)
                          {
                            (vecPush v
                              (CUnit2
                                :file arg
                                :src src
                                :name None
                                :imports vecNew
                                :library (pathInStdlib arg)))
                            v
                          }
                        })
                      {
                        (let allDecls
                          (resolveImports decls bares fulls mods tcode (pathDir arg) units))
                        {
                          (let eds
                            {
                              (let v vecNew)
                              {
                                (expandProgram decls allDecls v vecNew (as 0 Units) bares fulls
                                  mods)
                                v
                              }
                            })
                          {
                            (let ds
                              (orderDiags (expMergeInto eds (checkModule decls allDecls units))))
                            (if (> (countErrorDiags ds) 0)
                              {
                                (printTypeErrors ds 0)
                                declsSrc
                              }
                              {
                                (if (> (vecLen ds) 0)
                                  (printTypeErrors ds 0))
                                (replStyled REPL_ACCENT (concat (concat "OK: Loaded '" arg) "'\n"))
                                (concat (concat declsSrc src) "\n")
                              })
                          }
                        }
                      }
                    }
                  ))
              ))
          })
      ))))

(pub :: replCmdLlvm (-> String String Int))
;@axiom:effect(io)
(pub fn (replCmdLlvm declsSrc arg)
  (if (== (strLen arg) 0)
    {
      (replStyled REPL_ERROR "Error: Usage: :llvm <expression>\n")
      0
    }
    {
      (let tr (typeExprAgainst declsSrc arg))
      (match tr
        ((None) 0)
        ((Some parsedValue16)
          {
            (let cr (replCompileExpr declsSrc arg parsedValue16))
            (match cr
              ((None) 0)
              ((Some parsedValue18)
                {
                  (replOut "Generated LLVM IR:\n")
                  (replOut parsedValue18)
                  0
                }
              ))
          }
        ))
    }))

; ------------------------------------------------------------------
; Multi-line input, closed 2026-08-31. Every entry used to be exactly
; one `readLine`: a `fn` split across two lines lexed and typechecked
; each physical line SEPARATELY, so
;
;   (fn (add x y)
;     (+ x y))
;
; parsed line 1 as `(fn (add x y)` - an incomplete form - and answered
; `Parse error: the declaration does not parse`, then typed line 2,
; `(+ x y))`, as an EXPRESSION and answered three `Type error:
; undefined variable` lines for `x`, `y` and `add` (measured on this
; tree before this section existed). One line was the only unit the
; REPL had; every multi-line form in the language was unusable at the
; prompt, `fn` included.
;
; The fix is a running paren/brace/bracket balance, not a grammar
; entry point: `replParenDepth` lexes the buffer and sums +1 per
; opener and -1 per closer. Depth > 0 after a physical line means the
; buffer is not yet a complete form, so `replMain` folds the next line
; in and re-measures rather than dispatching. Depth <= 0 dispatches
; immediately - which for every EXISTING single-line entry (all 12
; checked-in sessions) is true on the very first line, so this changes
; no byte of any of them; the balance check is additional work on the
; already-open path, not a new one.
;
; Two decisions this leaves deliberately narrow:
;   * an empty line WHILE continuing is preserved, not an abort: a
;     blank line between clauses is ordinary formatting, and pasted
;     code is full of them. The escape hatch for a paren the user
;     cannot close is the SECOND blank line in a row - `pending`
;     ends in `\n` exactly when its last line was blank, because only
;     blanks join as empty tails - and on a TTY also Ctrl-C, which
;     `replTermLoop` answers as the byte-3 sentinel (`replIsAbort`)
;     so that it cannot look like a preserved blank. EOF abandons
;     the entry on both surfaces and says so.
;
;   `replParenDepth` itself stays a pure bracket count: `replHlDepth`
;   (replhl.ax) recovers the same number from its own walk, and
;   scripts/check-repl-highlight.sh requires the two to agree on every
;   mid-edit prefix of three compiler modules. What decides whether
;   the REPL waits is the predicate below it, which adds the one case
;   brackets cannot see.
;
;   * A STRING OR CHARACTER LITERAL spanning lines keeps the entry
;   open. `lex` does not stop an unterminated literal at a newline,
;   so a string opened on one line and closed two lines later inside
;   an otherwise-balanced form lexes correctly once the whole buffer
;   is handed to the parser - but only if the REPL waits for those
;   lines instead of dispatching the balanced prefix and failing to
;   parse. The sign is the lexer's own: the last token is a TK_ERROR
;   beginning with `"` or `'` whose span reaches the buffer end, which
;   is exactly `hlClassOf`'s pending rule (replhl.ax) for a literal in
;   progress. A digit-led TK_ERROR - an integer past i64 - is settled
;   and dispatches at once, for the same reason it paints red at once.
;   A bad escape is TK_ERROR_ESC, not TK_ERROR, and likewise never
;   waits.
(pub :: replParenDepth (-> String Int))
(pub fn (replParenDepth src)
  {
    (let toks (lex src))
    {
      (let n (vecLen toks))
      (let mut depth 0)
      {
        (for i in 0..n
          {
            (let k (kindInt (tokenKind (vecGet toks i))))
            (if (|| (== k (kindInt TK_LPAREN))
                  (|| (== k (kindInt TK_LBRACE)) (== k (kindInt TK_LBRACKET))))
              (set depth (+ depth 1))
              (if (|| (== k (kindInt TK_RPAREN))
                    (|| (== k (kindInt TK_RBRACE)) (== k (kindInt TK_RBRACKET))))
                (set depth (- depth 1))))
          })
        depth
      }
    }
  })

; The last token that is not EOF, or -1 when there is none.
(pub :: replLastTok (-> Tokens Int))
(pub fn (replLastTok toks)
  {
    (let mut i (- (vecLen toks) 1))
    {
      (while (&& (>= i 0) (== (kindInt (tokenKind (vecGet toks i))) (kindInt TK_EOF)))
        (set i (- i 1)))
      i
    }
  })

; True when `src` ends inside an unclosed string or character
; literal. See the multi-line section above for why the sign is the
; lexer's own last token rather than a second scanner.
(pub :: replStrOpen (-> String Bool))
(pub fn (replStrOpen src)
  {
    (let toks (lex src))
    {
      (let li (replLastTok toks))
      (if (< li 0)
        false
        {
          (let t (vecGet toks li))
          (if (!= (kindInt (tokenKind t)) (kindInt TK_ERROR))
            false
            (if (!= (spanEnd (tokenSpan t)) (strLen src))
              false
              (if (== (strLen (tokenLexeme t)) 0)
                false
                {
                  (let b0 (strByte (tokenLexeme t) 0))
                  (|| (== b0 34) (== b0 39))
                })))
        })
    }
  })

; Whether an entry is not yet complete: its brackets do not balance,
; it ends inside a string or character literal that a later line may
; still close, or it ends inside a block comment. This - not the bare
; depth - is what `replMain` waits on, on both surfaces. The four
; expression colon commands (`:type`, `:t`, `:llvm`, `:time`) buffer
; through this too (`replColonBuffers`); every other colon line
; dispatches at once.
(pub :: replEntryIncomplete (-> String Bool))
(pub fn (replEntryIncomplete src)
  (if (> (replParenDepth src) 0)
    true
    (if (replStrOpen src)
      true
      (> (replBlockDepth src) 0))))

; A complete entry (one line, or several a paren balance joined):
; declaration or expression, exactly `replMain`'s old inline dispatch,
; factored out so both the single-line path and the multi-line join
; call the one copy. An entry that closes more than it opens is
; refused here with its own line, before any parser runs.
(pub :: replDispatch (-> String String String))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (replDispatch declsSrc entry)
  (if (replDepthNegative entry)
    {
      (replStyled REPL_ERROR "Parse error: too many closing parens\n")
      declsSrc
    }
    (if (isDeclLine entry)
      (replDecl declsSrc entry)
      {
        (replExpr declsSrc entry)
        declsSrc
      })))

; A buffered expression colon command whose argument now balances -
; the completion of a line `replColonBuffers` held back. Only the four
; expression commands can arrive here, so only they are dispatched;
; the `:time` arm is `replMain`'s own order (the eval lines, then the
; duration) over the joined rest.
(pub :: replDispatchColonMulti (-> String String String String))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (replDispatchColonMulti declsSrc w rest)
  (if (|| (strEq w ":type") (strEq w ":t"))
    {
      (replCmdType declsSrc rest)
      declsSrc
    }
    (if (strEq w ":llvm")
      {
        (replCmdLlvm declsSrc rest)
        declsSrc
      }
      {
        (let tbuf (memAlloc 16))
        {
          (let t0
            (match (sysNowMicros tbuf)
              ((Ok t) t)
              ((Err e) 0)))
          {
            (replExpr declsSrc rest)
            (replStyled REPL_AMBER
              (fmtMicrosMs
                (-
                  (match (sysNowMicros tbuf)
                    ((Ok t) t)
                    ((Err e) 0))
                  t0)))
            declsSrc
          }
        }
      })))

; ------------------------------------------------------------------
; One colon-command line: recorded whole exactly as typed (except the
; quit commands, which are never entries), then dispatched. Answers
; the session's declaration source, updated by `:load` and `:reset`.
; Split out of `replMain` so the buffering check
; (`replColonBuffers`) stays a shallow branch at the call site rather
; than a new level around the whole dispatch.
; ------------------------------------------------------------------
(pub :: replColon (-> String String Hist String))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (replColon declsSrc line hist)
  {
    (let mut src declsSrc)
    {
      ; A colon command is recorded whole, exactly
      ; as typed, before it runs - except the quit
      ; commands. A recalled `:quit` submitted with
      ; a stray Enter ends the session it just
      ; started, so quitting is the one line that
      ; is never an entry; measured live, where
      ; the first Up of a fresh session offered
      ; nothing but the previous session's quit.
      (if (!
            (|| (strEq (cmdWord line) ":quit")
              (|| (strEq (cmdWord line) ":q") (strEq (cmdWord line) ":exit"))))
        (histRecord hist line))
      {
        (let w (cmdWord line))
        (let rest (cmdRest line))
        (if (|| (strEq w ":help") (|| (strEq w ":h") (strEq w "?")))
          replHelp
          (if (|| (strEq w ":quit") (|| (strEq w ":q") (strEq w ":exit")))
            {
              ; Compaction, if the file earned it,
              ; before the process goes away: the
              ; EOF arm closes for the same reason.
              (histClose hist)
              (sysExitWith 0)
            }
            (if (strEq w ":explain")
              (replCmdExplain rest)
              (if (|| (strEq w ":type") (strEq w ":t"))
                (replCmdType src rest)
                (if (|| (strEq w ":load") (strEq w ":l"))
                  (set src (replCmdLoad src rest))
                  (if (|| (strEq w ":reset") (strEq w ":r"))
                    {
                      (set src "")
                      (replStyled REPL_ACCENT "REPL state reset.\n")
                    }
                    (if (|| (strEq w ":defs") (strEq w ":d"))
                      (replCmdDefs src)
                      (if (strEq w ":llvm")
                        (replCmdLlvm src rest)
                        (if (strEq w ":time")
                          ; stage0 prints the two eval lines, then
                          ; the duration (probed: type, result,
                          ; Time). The duration is real now -
                          ; sysNowMicros bracketing the eval - in
                          ; stage1's own format: stage0 prints
                          ; Rust's Duration debug, which is
                          ; internals, and the gate's marker pins
                          ; only the `Time: ` prefix.
                          {
                            (let tbuf (memAlloc 16))
                            {
                              (let t0
                                (match (sysNowMicros tbuf)
                                  ((Ok t) t)
                                  ((Err e) 0)))
                              {
                                (replExpr src rest)
                                (replStyled REPL_AMBER
                                  (fmtMicrosMs
                                    (-
                                      (match (sysNowMicros tbuf)
                                        ((Ok t) t)
                                        ((Err e) 0))
                                      t0)))
                              }
                            }
                          }
                          (replStyled REPL_ERROR
                            (catStrs
                              {
                                (let v vecNew)
                                {
                                  (vecPush v "Error: Unknown command '")
                                  (vecPush v w)
                                  (vecPush v "'. Type :help for available commands.\n")
                                  v
                                }
                              })))))))))))
      }
      src
    }
  })

; ------------------------------------------------------------------
; The loop.
; ------------------------------------------------------------------
(pub :: replMain (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (replMain noBanner)
  {
    (if (== noBanner 0)
      replBanner)
    ; Computed ONCE. `mkKeyIn`'s second argument is the same value:
    ; off a TTY it builds the inert shape - no poll descriptor, a
    ; one-byte buffer, nothing ever read - so the piped surface pays
    ; for none of this. One LineEd and one kill ring per SESSION, not
    ; per line: a Vec handle is an `Int`, so an `Int`-typed struct
    ; field is outside the block's reference map and a per-line editor
    ; would leak both gap vectors every line typed.
    ; Axiom's own identifier bytes beyond letters, digits and `_`,
    ; so Alt-b over `vec-push!` crosses the whole name rather than
    ; stopping at the hyphen. `Tui.Edit` cannot know this and does
    ; not try to; `tests/selfhost/978-line-editor.ax` sweeps all 256
    ; bytes and requires this string to make `ledIsWord` agree with
    ; `lexer.isIdentChar` exactly, so the two cannot drift.
    ; The session's history: an in-memory ring always, a file that
    ; survives the session when one resolves (`replhist.ax` decides
    ; where). Opened on `interactive` - off a TTY the ring still
    ; records, into memory nobody reads, and nothing is written, so
    ; both surfaces run this same code. Recorded are complete
    ; decl/expr entries and colon-command lines except the quit
    ; commands, exactly as trimmed before dispatch; blanks, comments
    ; and tag-only lines are not entries and are skipped. What is NOT recorded with an entry
    ; are the `;@axiom:` lines typed above it: recalling the entry
    ; later redefines it bare, and an IO effect that needs its tag
    ; will say so (AX3042) rather than silently change meaning.
    ; The session's completion handle: the two strings Tab completes
    ; against (`replcomp.ax`). Re-synced every iteration below,
    ; because every dispatch and every continuation line moves one
    ; of them; the sync is two stores, and the parse it invalidates
    ; is repaid on the next Tab rather than here.
    ; The buffer of a decl-or-expr entry whose parens have not
    ; balanced yet. Empty whenever the next physical line starts a
    ; fresh entry, which is every line until a form spans more than
    ; one - the common case, and the one this changes nothing for.
    {
      (let interactive replInteractive)
      {
        (let kin (mkKeyIn stdin interactive))
        (let ed (ledNew ledRingNew "-!*+/<>=%&|'^"))
        (let hist (histOpen interactive))
        (let cenv (replComplEnvNew "" ""))
        (let mut declsSrc "")
        (let mut running 1)
        (let mut pending "")
        {
          (while (== running 1)
            {
              (replComplEnvSet cenv declsSrc pending)
              {
                (let lineOpt
                  (replReadPrompted interactive kin ed
                    (if (> (strLen pending) 0)
                      replPromptCont
                      replPromptMain)
                    pending hist cenv))
                (if (let (Some raw) lineOpt)
                  (if (> (strLen pending) 0)
                    ; Continuing an entry the completeness check has not
                    ; closed. Anything typed joins and re-measures the
                    ; WHOLE buffer, because a closer - or a closing quote
                    ; - on THIS line can only be judged against everything
                    ; opened before it. A blank line joins as an empty
                    ; line (formatting and pastes survive); the SECOND
                    ; blank in a row aborts - `pending` ends in `\n`
                    ; exactly when its last line was blank, because only
                    ; blanks join as empty tails - and so does the Ctrl-C
                    ; sentinel (`replIsAbort`), which is why a cancel
                    ; must not look like a blank.
                    (if (replIsAbort raw)
                      {
                        (set pending "")
                        (replStyled REPL_AMBER "Aborted: unbalanced input discarded.\n")
                      }
                      {
                        (let next (replTrim raw))
                        (if (== (strLen next) 0)
                          (if (== (strByte pending (- (strLen pending) 1)) 10)
                            {
                              (set pending "")
                              (replStyled REPL_AMBER "Aborted: unbalanced input discarded.\n")
                            }
                            (set pending (concat pending "\n")))
                          {
                            (let joined (concat (concat pending "\n") next))
                            (if (replEntryIncomplete joined)
                              (set pending joined)
                              {
                                (set pending "")
                                (if (replDepthNegative joined)
                                  {
                                    (replStyled REPL_ERROR "Parse error: too many closing parens\n")
                                    (histRecord hist joined)
                                  }
                                  (if (== (strByte joined 0) 58)
                                    ; A buffered `:type`/`:llvm`/`:time`
                                    ; whose argument now balances: the
                                    ; fresh path only ever buffers those,
                                    ; so this is one of them.
                                    {
                                      (let w (cmdWord joined))
                                      (let rest (cmdRest joined))
                                      {
                                        (set declsSrc (replDispatchColonMulti declsSrc w rest))
                                        (histRecord hist joined)
                                      }
                                    }
                                    {
                                      (set declsSrc (replDispatch declsSrc joined))
                                      (histRecord hist joined)
                                    }))
                              })
                          })
                      })
                    ; A blank line is a no-op - and so is the Ctrl-C
                    ; sentinel, whose `^C` echo is the whole answer on
                    ; a fresh line; it aborts a pending entry and never
                    ; an empty one.
                    {
                      (let line (replTrim raw))
                      (if (! (|| (== (strLen line) 0) (replIsAbort raw)))
                        (if (== (strByte line 0) 59)
                          ; A comment is discarded; an AXTAG looks like a
                          ; comment and is a CLAIM, so it is kept and
                          ; attaches to the declaration typed next. See
                          ; `replIsAxtagAt` for what that costs and why
                          ; the two edges - redefinition and a trailing
                          ; tag - are handled where they are.
                          (if (== (replIsAxtagLine line) 1)
                            (set declsSrc (concat (concat declsSrc line) "\n")))
                          ; A `:` line is a colon command; a bare `?`
                          ; is `:help` by its own advertisement (58 is
                          ; `:`, 63 is `?`). Anything else starting
                          ; with `?` cannot be an expression - `?` is
                          ; no identifier byte - so routing the whole
                          ; line to `replColon` mistakes nothing.
                          (if (|| (== (strByte line 0) 58) (== (strByte line 0) 63))
                            (if (replColonBuffers (cmdWord line) (cmdRest line))
                              ; An expression command whose argument does
                              ; not yet balance (`:type (fn ...`): later
                              ; lines join `pending` until it does, and
                              ; the whole entry is recorded then.
                              (set pending line)
                              (set declsSrc (replColon declsSrc line hist)))
                            ; A decl-or-expr candidate: dispatch now if it is
                            ; already complete (every existing single-line
                            ; entry is), otherwise start buffering.
                            (if (replEntryIncomplete line)
                              (set pending line)
                              {
                                (set declsSrc (replDispatch declsSrc line))
                                (histRecord hist line)
                              }))))
                    })
                  {
                    (set running 0)
                    ; The file is compacted, if it needs it, on every
                    ; exit path - including this one. `:quit` below
                    ; closes before it exits for the same reason.
                    (histClose hist)
                    ; End of input with an entry still open discards it,
                    ; and says so: otherwise a piped session whose last
                    ; form never balanced ends with the same farewell as
                    ; a clean one, and nothing names the missing lines.
                    (if (> (strLen pending) 0)
                      {
                        (set pending "")
                        (replStyled REPL_AMBER "Aborted: unbalanced input discarded.\n")
                      })
                    (replOut "\nGoodbye!\n")
                  })
              }
            })
          0
        }
      }
    }
  })

; :defs - what THIS session defined, one line per parsed declaration
; name. stage0 renders its whole builtin table here; reproducing
; that render is recorded divergent until someone needs it.
(pub :: replCmdDefs (-> String Int))
;@axiom:effect(io)
(pub fn (replCmdDefs declsSrc)
  {
    (replOut "Definitions in scope:\n")
    {
      (let dr (parseDecls (lex declsSrc) 0 vecNew))
      (match dr
        ((ParseFailed parseError19) ())
        ((ParseSuccess parsedValue19 parsedPos19)
          {
            (let decls parsedValue19)
            (for d in decls
              (if (|| (== (nodeTag d) TAG_D_FN)
                    (|| (== (nodeTag d) TAG_D_SIG)
                      (|| (== (nodeTag d) TAG_D_DATA) (== (nodeTag d) TAG_D_STRUCT))))
                (replOut (concat (concat "  " (nodeAName d)) "\n"))))
          }
        ))
    }
    0
  })

; `Time: 12.345ms` from a microsecond count - millis, a dot, the
; microsecond remainder zero-padded to three digits. stage1's own
; spelling of a duration; the shape gate pins only the prefix.
(pub :: fmtMicrosMs (-> Int String))
(pub fn (fmtMicrosMs us)
  {
    (let u
      (if (< us 0)
        0
        us))
    {
      (let ms (/ u 1000))
      (let rem (% u 1000))
      (catStrs
        {
          (let v vecNew)
          {
            (vecPush v "Time: ")
            (vecPush v (fmtInt ms))
            (vecPush v ".")
            (vecPush v
              (if (< rem 10)
                "00"
                (if (< rem 100)
                  "0"
                  "")))
            (vecPush v (fmtInt rem))
            (vecPush v "ms\n")
            v
          }
        })
    }
  })
