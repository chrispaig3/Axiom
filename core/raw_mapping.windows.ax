;;! raw_mapping - the compiler's trusted Windows shared-page boundary.
(import Err)

(extern "kernel32"
  (compilerGetLastError :: Int (symbol "GetLastError"))
  (compilerVirtualAlloc :: (-> Int Int Int Int Int) (symbol "VirtualAlloc"))
  (compilerVirtualFree :: (-> Int Int Int Int) (symbol "VirtualFree")))

; Win32 errors in the errno convention used by the mapping layer.
(:: compilerMappingErrnoOf (-> Int Int))
(fn (compilerMappingErrnoOf code)
  ; ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND: ENOENT.
  (if (|| (== code 2) (== code 3))
      (- 0 2)
    ; ERROR_ACCESS_DENIED: EACCES.
    (== code 5)
      (- 0 13)
    ; ERROR_INVALID_HANDLE: EBADF.
    (== code 6)
      (- 0 9)
    ; ERROR_NOT_ENOUGH_MEMORY: ENOMEM.
    (== code 8)
      (- 0 12)
    ; ERROR_SHARING_VIOLATION, ERROR_LOCK_VIOLATION: EBUSY.
    (|| (== code 32) (== code 33))
      (- 0 16)
    ; ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS: EEXIST.
    (|| (== code 80) (== code 183))
      (- 0 17)
    ; ERROR_INVALID_PARAMETER, ERROR_INVALID_NAME: EINVAL.
    (|| (== code 87) (== code 123))
      (- 0 22)
    ; ERROR_DISK_FULL: ENOSPC.
    (== code 112)
      (- 0 28)
    ; ERROR_BROKEN_PIPE, ERROR_NO_DATA: EPIPE.
    (|| (== code 109) (== code 232))
      (- 0 32)
    ; ERROR_DIR_NOT_EMPTY: ENOTEMPTY.
    (== code 145)
      (- 0 39)
    ; ERROR_FILENAME_EXCED_RANGE: ENAMETOOLONG.
    (== code 206)
      (- 0 36)
    ; ERROR_DIRECTORY: ENOTDIR.
    (== code 267)
      (- 0 20)
    ; ERROR_BAD_EXE_FORMAT: ENOEXEC.
    (== code 193)
      (- 0 8)
    (- 0 5)))

; Shared with threads of this process; the caller keeps every reader alive.
(pub :: compilerMapShared (-> Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (compilerMapShared len)
  {
    (let address (compilerVirtualAlloc 0 len 12288 4))
    (if (== address 0)
      (Err
        (mkError (- 0 (compilerMappingErrnoOf (& compilerGetLastError 4294967295)))
          "compilerMapShared"))
      (Ok address))
  })

; Release the whole reservation only after all readers have finished.
(pub :: compilerUnmapShared (-> Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (compilerUnmapShared address len)
  (if (== (& (compilerVirtualFree address 0 32768) 4294967295) 0)
    (Err
      (mkError (- 0 (compilerMappingErrnoOf (& compilerGetLastError 4294967295)))
        "compilerUnmapShared"))
    (Ok 0)))
