; driver.ax - the command-line surface, and the native toolchain.
;
; Until this module existed, the self-hosted compiler was
; `stage1 FILE [TARGET] > out.ll`: it emitted LLVM text on stdout and
; could do nothing else. Producing an executable meant a human running
; `llc` and `cc` afterwards, which is what every gate script in this
; repository does. A compiler that cannot finish the job is a component,
; not a compiler, and this is the difference.
;
; ------------------------------------------------------------------
; The first operand is always a subcommand. One that names no command
; is refused by `rejectUnknownCommand` (main.ax) at exit 2, with the
; nearest command name suggested when there is one within two edits;
; a file is compiled with `emit-llvm`, `build` or `run`, never as a
; bare first operand. `--` ends option parsing, which is how a file
; whose name begins with a dash is named.
; ------------------------------------------------------------------
(import core)
(import Host)
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Sys)
(import IO (fileExists listDir readFile removeFile stderr writeFile writeStr))
(import Err)
(import Path)
(import parser)
(import codegen)
; `effectiveLinkArgs` reads `axiom.pkg`'s `crate` lines. It arrived
; here transitively through `codegen` already; naming it is what stops
; a future tidy-up of `codegen`'s imports from breaking this file for
; a reason nobody would look for here.
(import pkg)
(import build)
(import diag)
(import render)
(import raw)

; ------------------------------------------------------------------
; Exit codes.
;
;   0  success
;   1  the PROGRAM is wrong: an unreadable input, a syntax error, a
;      failing check, no entry point (AX4001), or an unresolvable import
;      (AX5001 - stage0's code for it)
;   2  the COMMAND LINE is wrong: an unknown command or flag, or a flag
;      given the wrong number of values
;   3  a module could not be read or parsed, or a target name is unknown
;      - `dieImport`'s status, which the rest of the compiler reaches
;      through codegen rather than through this file
;   4  a native tool failed or is missing
;
; A syntax error in the entry file is 1, not 2: 2 belongs to the
; command line alone. 3 is live: `dieImport` exits 3 from four sites,
; and an entry file importing an unparsable module does too.
;
; 4 is deliberately distinct from 1 and is this compiler's own choice,
; NOT the retired compiler's - that one exited 1 for a failing llc or
; cc. The distinction is kept because "your program is wrong" and "llc
; is not installed" are not the same news, and a driver that reports
; them identically sends the reader to the wrong place.
; ------------------------------------------------------------------
(pub :: exitToolFailed Int)
(pub fn (exitToolFailed)
  4)

; ------------------------------------------------------------------
; Running a native tool.
; ------------------------------------------------------------------
; Run `tool` with the arguments in `args`, a Vec of Str, answering the
; child's exit code in Ok, or the operating-system failure in Err.
;
; `argv[0]` is the tool's own name, which the kernel does not supply and
; which several tools read back out of their own argv.
(pub :: runTool (-> String Strings (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (runTool tool args)
  {
    (let n (vecLen args))
    {
      (let v (memAlloc (* (+ n 2) 8)))
      {
        (memSetWord v 0 (strCStr (strDup tool)))
        (fillArgv v args 0 n)
        (memSetWord v (+ n 1) 0)
        ; Preserve the Sys boundary: Ok carries the numeric child status,
        ; including 128+signal; Err carries launch or wait failure.
        (sysRunPath tool v sysEnvp)
      }
    }
  })

; A completed tool succeeds only when its numeric exit status is zero.
(pub :: toolSucceeded (-> (Result Int Error) Bool))
(pub fn (toolSucceeded outcome)
  (match outcome
    ((Ok code) (== code 0))
    ((Err _) false)))

(:: toolFailureMessage (-> (Result Int Error) String String String))
(fn (toolFailureMessage outcome unavailable failed)
  (match outcome
    ((Ok _) failed)
    ((Err _) unavailable)))

(pub :: fillArgv (-> Int Strings Int Int Int))
(pub fn (fillArgv v args i n)
  (if (>= i n)
    0
    ; Every element is copied, because a Str produced by slicing
    ; shares its bytes with a larger string and stops at no NUL.
    {
      (memSetWord v (+ i 1) (strCStr (strDup (vecGet args i))))
      (fillArgv v args (+ i 1) n)
    }))

(pub :: argsOf3 (-> String String String Strings))
(pub fn (argsOf3 a b c)
  {
    (let v vecNew)
    {
      (vecPush v a)
      (vecPush v b)
      (vecPush v c)
      v
    }
  })

; ------------------------------------------------------------------
; The build pipeline: IR -> opt -> llc -> cc.
;
; The order, the argument vectors and the failure rules are stage0's,
; because two compilers that drive the toolchain differently are two
; compilers that produce different binaries from the same source - and
; the bootstrap fixpoint cannot see that, since both stages would carry
; the same driver. Copying stage0 is what keeps the comparison honest
; while stage0 is still around to compare against.
; ------------------------------------------------------------------
; `-relocation-model=pic` is required of EVERY llc invocation in this
; project. llc's default relocation model for ELF is `static`, every
; current Linux distribution links PIE by default, and Axiom always has
; a `.bss` global - the bump allocator's cursor - so the link fails with
; `R_X86_64_32S against .bss`. It is masked at -O2, where the x86
; backend picks PC-relative addressing anyway, and cannot be reproduced
; on macOS at all.
(pub :: llcRelocArg String)
(pub fn (llcRelocArg)
  "-relocation-model=pic")

; Optimise `llPath` into `<base>.opt.ll`, answering the path llc should
; read in Ok, or the failing optimiser exit status in Err.
;
; A MISSING `opt` is a warning and the unoptimised IR is used; a PRESENT
; `opt` that fails is fatal. That distinction is stage0's and it is
; load-bearing in both directions. It has to be a warning because `opt`
; is not always installed - and it has to be survivable, because
; without its tail-call pass a stage2 compiling its own source
; overflows its stack.
(pub :: runOpt (-> String Int String (Result String Int)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (runOpt llPath optLevel outPath)
  (if (<= optLevel 0)
    (Ok llPath)
    {
      (let lvl
        (if (> optLevel 3)
          3
          optLevel))
      {
        (let args
          {
            (let v vecNew)
            {
              (vecPush v (concat "-O" (fmtIntStr lvl)))
              (vecPush v llPath)
              (vecPush v "-S")
              (vecPush v "-o")
              (vecPush v outPath)
              v
            }
          })
        {
          (let rc (runTool "opt" args))
          (match rc
            ((Err _)
              {
                (writeStderrStr
                  "warning: `opt` not found on PATH; building without mid-level optimisation (deeply recursive code may exhaust the stack)\n")
                (Ok llPath)
              }
            )
            ((Ok code)
              (if (!= code 0)
                (Err code)
                (Ok outPath))
            ))
        }
      }
    }))

; ------------------------------------------------------------------
; A toolchain failure as AX4003.
;
; `error: llc failed` was a bare stderr write: no code, no span, no
; format, invisible to anything reading AXDL or JSON, and unexplainable
; even though `axiom explain AX4003` has had an answer for it since the
; registry existed. stage0 had the same gap from the other side - it
; defined TOOLCHAIN_FAILURE and returned bare `String`s - so this is one
; of the two codes neither compiler ever constructed.
;
; The MESSAGE keeps the wording the driver has always used. That is not
; only because check-driver.sh greps it: naming the tool that failed is
; the whole content of the diagnostic, and the reason the gate greps it
; is that a build blamed on the wrong tool is the failure mode here -
; `cc` complaining about an object llc never wrote.
;
; Spanless, like AX4001 and AX5001: there is no source position for "the
; assembler exited 1". Returns `exitToolFailed` so the call sites read
; the way they did.
(pub :: toolFailDiag (-> String String Int))
;@axiom:effect(io)
(pub fn (toolFailDiag msg help)
  {
    (let d (mkDiag SEV_ERROR "AX4003" "toolchain-failure" 0 msg None (Some help)))
    (let ds vecNew)
    (let units vecNew)
    {
      (vecPush ds d)
      (vecPush units (CUnit2 :file "<toolchain>" :src "" :name None :imports vecNew :library false))
      {
        (let out (renderDiagsFormat diagFormatFromArgv ds units))
        (writeStr stderr out)
      }
      exitToolFailed
    }
  })

; ------------------------------------------------------------------
; Which linker, which archive spelling, which suffix: the MODULE
; decides, by the `target triple` line the emitter wrote first, not the
; host. A Windows executable is linked on macOS and Linux (cross) long
; before any Windows runner exists, and `uname` on those hosts would
; answer for the wrong machine. The four POSIX targets share one
; answer - `cc`, `lib<name>.a`, no suffix - and both Windows targets
; have the other: `lld-link`, `<name>.lib`, `.exe`.
; ------------------------------------------------------------------
(pub :: irTargetIsWindows (-> String Bool))
(pub fn (irTargetIsWindows ir)
  (> (strLen (irWindowsTarget ir)) 0))

; Which Windows target the module was emitted for, by its triple, or ""
; for any other. The link spells the machine and names the target in
; its refusals from this, so an arm64 object is never linked or
; reported as an x86-64 one. The module's own `target triple` line is
; the one read - the emitter writes it first - so a string literal
; spelling another triple further down cannot answer for it.
(pub :: irWindowsTarget (-> String String))
(pub fn (irWindowsTarget ir)
  (if (let (Some at) (strFindSub ir "target triple = \"" 0))
    (if (subMatchesAt ir "x86_64-pc-windows-msvc\"" (+ at 17) 0)
      "windows-x86_64"
      (if (subMatchesAt ir "aarch64-pc-windows-msvc\"" (+ at 17) 0)
        "windows-aarch64"
        ""))
    ""))

; `aarch64-unknown-none-elf`: the bare target's triple, read off the
; IR the way `irTargetIsWindows` reads its own. The link below is
; `ld.lld`'s for exactly this triple and `cc`'s for everything else,
; so the two cannot disagree about which linker a target takes.
(pub :: irTargetIsBaremetal (-> String Bool))
(pub fn (irTargetIsBaremetal ir)
  (isSome (strFindSub ir "target triple = \"aarch64-unknown-none-elf\"" 0)))

; `<dir>/lib<name>.a`, or `<dir>/<name>.lib` where the link is
; lld-link's: both the auto-link probe and the grounding pass spell an
; archive's path through here, so the two cannot disagree about what a
; library is called.
(pub :: archivePathIn (-> String String Bool String))
(pub fn (archivePathIn dir lib isWin)
  (if isWin
    (concat (concat dir "/") (concat lib ".lib"))
    (concat (concat dir (concat "/lib" lib)) ".a")))

; Copy the caller's already-formatted link arguments (`-L<dir>`,
; `-l<name>`) onto the `cc` argument vector.
(pub :: appendLinkArgs (-> Strings Strings ()))
(pub fn (appendLinkArgs v linkArgs)
  (for a in linkArgs
    (vecPush v a)))

; The same arguments in lld-link's spelling: `-L<dir>` is
; `/libpath:<dir>` and `-l<name>` is `<name>.lib`. Anything else is
; copied as it came, which is what `cc` would have done with it too.
(pub :: appendLinkArgsWindows (-> Strings Strings ()))
(pub fn (appendLinkArgsWindows v linkArgs)
  (for a in linkArgs
    (if (strStartsWith a "-L")
      (vecPush v (concat "/libpath:" (strSlice a 2 (- (strLen a) 2))))
      (if (strStartsWith a "-l")
        (vecPush v (concat (strSlice a 2 (- (strLen a) 2)) ".lib"))
        (vecPush v a)))))

; Some lld-link versions accept an x64 short-import archive while
; producing an arm64 PE. Walk the COFF archive's member boundaries and
; check short-import headers there. Data inside an ordinary object and
; the archive's symbol tables cannot be mistaken for an import header.
; Other object formats and malformed archives remain the linker's
; responsibility.
(pub :: winImportMachineMismatch (-> String Int Bool))
(pub fn (winImportMachineMismatch bytes wantHigh)
  (if (! (strStartsWith bytes "!<arch>\n"))
    false
    {
      (let mut i 8)
      (let mut bad false)
      (let len (strLen bytes))
      {
        (while (&& (&& (>= i 0) (<= (+ i 60) len)) (! bad))
          (if (&& (== (strByte bytes (+ i 58)) 96) (== (strByte bytes (+ i 59)) 10))
            (if (let (Some n) (strParseInt (strTrim (strSlice bytes (+ i 48) 10))))
              (if (&& (>= n 0) (<= n (- len (+ i 60))))
                {
                  (let p (+ i 60))
                  (let table
                    (&& (== (strByte bytes i) 47)
                      (|| (== (strByte bytes (+ i 1)) 32) (== (strByte bytes (+ i 1)) 47))))
                  {
                    (if (&& (! table)
                          (&& (>= n 20)
                            (&& (== (strByte bytes p) 0)
                              (&& (== (strByte bytes (+ p 1)) 0)
                                (&& (== (strByte bytes (+ p 2)) 255)
                                  (&& (== (strByte bytes (+ p 3)) 255)
                                    (&& (== (strByte bytes (+ p 4)) 0)
                                      (== (strByte bytes (+ p 5)) 0))))))))
                      (if (!= (+ (strByte bytes (+ p 6)) (* 256 (strByte bytes (+ p 7))))
                            (+ 100 (* 256 wantHigh)))
                        (set bad true)))
                    (set i (+ (+ p n) (% n 2)))
                  }
                }
                (set i (- 0 1)))
              (set i (- 0 1)))
            (set i (- 0 1))))
        bad
      }
    }))

; Resolve each library in directory order, as lld-link does. A later
; directory's archive with the same name is not part of the link.
(pub :: windowsArchivePathsOf (-> Strings Strings))
;@axiom:effect(io)
(pub fn (windowsArchivePathsOf linkArgs)
  {
    (let dirs vecNew)
    (let libs vecNew)
    (let out vecNew)
    {
      (for a in linkArgs
        (if (strStartsWith a "-L")
          (vecPush dirs (strSlice a 2 (- (strLen a) 2)))
          (if (strStartsWith a "-l")
            (vecPush libs (strSlice a 2 (- (strLen a) 2))))))
      (for lib in libs
        {
          (let mut d 0)
          (let mut found false)
          (while (&& (< d (vecLen dirs)) (! found))
            {
              (let path (archivePathIn (vecGet dirs d) lib true))
              {
                (if (fileExists path)
                  {
                    (vecPush out path)
                    (set found true)
                  })
                (set d (+ d 1))
              }
            })
        })
      out
    }
  })

(pub :: windowsArchivesWrongMachine (-> Strings String Bool))
;@axiom:effect(io)
(pub fn (windowsArchivesWrongMachine linkArgs winTarget)
  {
    (let paths (windowsArchivePathsOf linkArgs))
    (let wantHigh
      (if (strEq winTarget "windows-aarch64")
        170
        134))
    (let mut i 0)
    (let mut bad false)
    {
      (while (&& (< i (vecLen paths)) (! bad))
        {
          {
            (let path (vecGet paths i))
            (if (fileExists path)
              (if (winImportMachineMismatch (unwrapOr (readFile path) "") wantHigh)
                (set bad true)))
          }
          (set i (+ i 1))
        })
      bad
    }
  })

; Assemble `llPath` to `objPath`, then link it to `outPath`.
; Answers 0, or `exitToolFailed`.
;
; `winTarget` selects the linker: "" is `cc` for the four POSIX targets,
; and a Windows target's name is `lld-link /subsystem:console
; /entry:mainCRTStartup /out:<out> <obj> <libs>` - no C compiler
; anywhere on that path, by decision (the design's Q2), which is one
; tool fewer than the status quo rather than one more. windows-aarch64
; adds `/machine:arm64`, so an x64 `kernel32.lib` on the search path is
; a refused link rather than a guess. `--emit-staticlib` is refused
; there for now: `ar` has no place in a Windows link and `llvm-lib` is
; a later phase, and saying so beats half-supporting it (Q11).
; The port's linker script, written beside the object at link time.
; QEMU's `-kernel` loads the ELF's segments at their physical
; addresses, so `.text.boot` - and with it `_start`, the ENTRY -
; must sit in RAM: `virt` maps it at 0x40000000. `KEEP` because
; nothing calls `_start` and a `--gc-sections` future must not eat
; the entry. A generated file rather than a checked-in one: the
; installed compiler carries its port with it, and
; `check-embedded.sh` boots what this writes.
;
; THE LAYOUT IS THE MEMORY MAP (docs/embedded-guide.md section 6).
; `_start` turns the MMU on over identity-mapped page tables that
; `emitMmuTables` builds from the symbols defined here, one 4 KiB
; page at a time, so every boundary below is page aligned:
;
;   0x40000000       code: `.text.boot`, `.text` (the vector table
;                    is `.text.vectors`)          read-only, executable
;   __axiom_rx_end   `.rodata`, `.eh_frame`, `.got` (a static link
;                    fills the GOT, nothing writes it at run time)
;                                                 read-only, execute-never
;   __axiom_ro_end   `.data`, `.bss` (the arena)  read-write, execute-never
;   __axiom_rw_end   64 KiB GUARD                 not mapped
;   __axiom_stack_lo the stack, 8 KiB, growing down from __stack_top
;                                                 read-write, execute-never
;   __stack_top      4 KiB guard                  not mapped
;   __axiom_exc_lo   the fault stack, 8 KiB: the fault exit switches
;                    to it, so a stack that overflowed into its guard
;                    can still be reported     read-write, execute-never
;   __axiom_exc_top  the page tables (`__axiom_pt`), built by `_start`
;                    before the MMU is on, and not mapped after it
;
; The guard below the stack is 64 KiB, not one page, so a frame
; that moves the stack pointer by more than a page before touching
; it still lands in the guard; the compiler emits no frame that large.
(pub :: baremetalLinkScript String)
(pub fn (baremetalLinkScript)
  "ENTRY(_start)\nSECTIONS {\n  . = 0x40000000;\n  .text.boot : { KEEP(*(.text.boot)) }\n  .text : { *(.text*) }\n  . = ALIGN(4096);\n  __axiom_rx_end = .;\n  .rodata : { *(.rodata*) }\n  .eh_frame : { *(.eh_frame*) }\n  .got : { *(.got) *(.got.plt) }\n  . = ALIGN(4096);\n  __axiom_ro_end = .;\n  .data : { *(.data*) }\n  .bss : { *(.bss*) *(COMMON) }\n  . = ALIGN(4096);\n  __axiom_rw_end = .;\n  . = . + 0x10000;\n  __axiom_stack_lo = .;\n  . = . + 0x2000;\n  __stack_top = .;\n  . = . + 0x1000;\n  __axiom_exc_lo = .;\n  . = . + 0x2000;\n  __axiom_exc_top = .;\n  __axiom_pt = .;\n}\n")

; ------------------------------------------------------------------
; AX3117: llc rejected a line of an `asm` template, reported at that
; line (MM-FFI-9).
;
; `check` runs no assembler, so a template's instructions are first
; assembled here, by `llc`. Every inline-assembly line codegen emits
; carries a `!srcloc` cookie, and an `; axiom-asm-site FIRST K s-e ...`
; comment before its call maps cookies FIRST, FIRST+1, ... to the
; lines' bytes in source file K, which an `; axiom-asm-file K "path"`
; line at the end of the module names (`asmSrcloc` in codegen.ax). llc
; names the cookie in one of two shapes:
;
;   <inline asm>:2:1: error: unrecognized instruction mnemonic
;   frobnicate x8, x0
;   ^
;   note: !srcloc = 7002
;
;   error: inline assembly requires more registers than available at line 33
;
; The first is the assembler's, and the line after it is the
; instruction as the assembler read it, registers filled in. The second
; is the register allocator's. Each becomes an AX3117 at the template
; line, and the build fails with status 1, a program error, as every
; diagnostic at a source position does. When any error carries no
; cookie - llc refusing something that is not a template - the report
; is llc's own text and AX4003, as before.
; ------------------------------------------------------------------
; `runTool` with the tool's standard error written to `errPath`.
(pub :: runToolErrTo (-> String Strings String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (runToolErrTo tool args errPath)
  {
    (let n (vecLen args))
    {
      (let v (memAlloc (* (+ n 2) 8)))
      {
        (memSetWord v 0 (strCStr (strDup tool)))
        (fillArgv v args 0 n)
        (memSetWord v (+ n 1) 0)
        (sysRunPathErrTo tool v sysEnvp errPath)
      }
    }
  })

; The lines of `s`, without their newlines.
(pub :: asmTextLines (-> String Strings))
(pub fn (asmTextLines s)
  {
    (let out vecNew)
    (let mut from 0)
    (let mut i 0)
    {
      (while (<= i (strLen s))
        {
          (if (|| (== i (strLen s)) (== (strByte s i) 10))
            {
              (if (|| (> i from) (< i (strLen s)))
                (vecPush out (strSlice s from (- i from))))
              (set from (+ i 1))
            })
          (set i (+ i 1))
        })
      out
    }
  })

; A non-negative signed-64 decimal at `at`, or None for missing digits
; or overflow. Check before multiplying so wrapped offsets stay absent.
(pub :: asmNumAt (-> String Int (Option Int)))
(pub fn (asmNumAt s at)
  {
    (let mut v 0)
    (let mut any false)
    (let mut overflow false)
    (let mut i at)
    {
      (while (&& (! overflow)
               (&& (>= i 0) (&& (< i (strLen s)) (&& (>= (strByte s i) 48) (<= (strByte s i) 57)))))
        {
          (let digit (- (strByte s i) 48))
          (if (|| (> v 922337203685477580) (&& (== v 922337203685477580) (> digit 7)))
            (set overflow true)
            (set v (+ (* v 10) digit)))
          (set any true)
          (set i (+ i 1))
        })
      (if (&& any (! overflow))
        (Some v)
        None)
    }
  })

; `s` without the blanks at either end.
(pub :: asmTrim (-> String String))
(pub fn (asmTrim s)
  {
    (let mut a 0)
    (let mut b (strLen s))
    {
      (while (&& (< a b) (|| (== (strByte s a) 32) (== (strByte s a) 9)))
        (set a (+ a 1)))
      (while (&& (> b a)
               (|| (== (strByte s (- b 1)) 32)
                 (|| (== (strByte s (- b 1)) 9) (== (strByte s (- b 1)) 13))))
        (set b (- b 1)))
      (strSlice s a (- b a))
    }
  })

; A file name between the quotes of an `; axiom-asm-file` line, with
; codegen's `\XX` escapes (`asmQuoteName`) undone.
(pub :: asmUnquoteName (-> String String))
(pub fn (asmUnquoteName s)
  {
    (let out (strBuilderNew))
    (let mut i 0)
    {
      (while (< i (strLen s))
        (if (&& (== (strByte s i) 92) (< (+ i 2) (strLen s)))
          {
            (strBuilderPushByte out
              (asmLowByte
                (+ (* 16 (asmHexVal (strByte s (+ i 1)))) (asmHexVal (strByte s (+ i 2))))))
            (set i (+ i 3))
          }
          {
            (strBuilderPushByte out (strByte s i))
            (set i (+ i 1))
          }))
      (strBuilderFinish out)
    }
  })

; The low byte of `v`, which is what a malformed escape decodes to.
(:: asmLowByte (-> Int Int))
(fn (asmLowByte v)
  (% (+ (% v 256) 256) 256))

(pub :: asmHexVal (-> Int Int))
(pub fn (asmHexVal c)
  (if (&& (>= c 48) (<= c 57))
    (- c 48)
    (if (&& (>= c 65) (<= c 70))
      (- c 55)
      (- c 87))))

; A site's source offsets are optional because malformed metadata still
; receives a spanless diagnostic. Keep its spelling for duplicate keys.
(pub struct AsmSite
  (file : String)
  (start : (Option Int))
  (end : (Option Int))
  (key : String))

; The first site comment whose cookies cover `n`, or None.
(pub :: asmSiteOf (-> String Int (Option AsmSite)))
(pub fn (asmSiteOf ir n)
  {
    (let mut out (:: None (Option AsmSite)))
    (let mut from 0)
    (let mut done false)
    {
      (while (&& (isNone out) (! done))
        (match (strFindSub ir "; axiom-asm-site " from)
          ((None)
            (set done true)
          )
          ((Some k)
            {
              (let eol
                (if (let (Some e) (strFindByte ir 10 k))
                  e
                  (strLen ir)))
              (set out (asmSiteLine ir (strSlice ir (+ k 17) (- eol (+ k 17))) n))
              (set from eol)
            }
          )))
      out
    }
  })

; One site comment's body, `FIRST K s-e s-e ...`.
(pub :: asmSiteLine (-> String String Int (Option AsmSite)))
(pub fn (asmSiteLine ir body n)
  {
    (let parts (asmSplitBlank body))
    (if (let (Some first) (asmNumAt body 0))
      (if (|| (< n first) (< (vecLen parts) 3))
        None
        {
          (let k (- n first))
          (if (>= k (- (vecLen parts) 2))
            None
            (if (let (Some file) (asmFileName ir (vecGet parts 1)))
              (if (== (strLen file) 0)
                None
                {
                  (let r (vecGet parts (+ k 2)))
                  (if (let (Some dash) (strFindByte r 45 0))
                    {
                      (let start (strSlice r 0 dash))
                      (let end (strSlice r (+ dash 1) (- (strLen r) (+ dash 1))))
                      (Some
                        (AsmSite
                          :file file
                          :start (asmNumAt start 0)
                          :end (asmNumAt end 0)
                          :key
                            (concat file (concat ":" (concat start (concat ":" (concat end ":")))))))
                    }
                    None)
                })
              None))
        })
      None)
  })

; The quoted name file K records, including a present empty name.
(pub :: asmFileName (-> String String (Option String)))
(pub fn (asmFileName ir k)
  (if (let (Some at) (strFind ir (concat (concat "; axiom-asm-file " k) " \"") 0))
    {
      (let start (+ (+ at 19) (strLen k)))
      (if (let (Some end) (strFindByte ir 34 start))
        (Some (asmUnquoteName (strSlice ir start (- end start))))
        None)
    }
    None))

(pub :: asmSplitBlank (-> String Strings))
(pub fn (asmSplitBlank s)
  {
    (let out vecNew)
    (let mut from 0)
    (let mut i 0)
    {
      (while (<= i (strLen s))
        {
          (if (|| (== i (strLen s)) (== (strByte s i) 32))
            {
              (if (> i from)
                (vecPush out (strSlice s from (- i from))))
              (set from (+ i 1))
            })
          (set i (+ i 1))
        })
      out
    }
  })

; The unit index of the file a recorded name stands for
; (`asmFileResolve`: a library file is recorded from the library's
; root) in `units`, adding it, with its text, the first time it is
; asked for.
(pub :: asmUnitFor (-> Units String Int))
;@axiom:effect(io)
(pub fn (asmUnitFor units recorded)
  {
    (let file (asmFileResolve recorded))
    (let mut i 0)
    (let mut at (:: None (Option Int)))
    {
      (while (&& (isNone at) (< i (vecLen units)))
        {
          (if (strEq (unitFile (vecGet units i)) file)
            (set at (Some i)))
          (set i (+ i 1))
        })
      (if (let (Some index) at)
        index
        {
          (vecPush units
            (CUnit2
              :file file
              :src (unwrapOr (readFile file) "")
              :name None
              :imports vecNew
              :library false))
          (- (vecLen units) 1)
        })
    }
  })

; One AX3117, at the template line cookie `n` names, pushed onto `ds`;
; 1 when the cookie found its line, else 0. A line the optimiser copied
; - a function inlined into its caller, a loop unrolled - fails once per
; copy, with the same message and other registers; `seen` keeps the
; report to one per line and message.
(pub :: asmRejectDiag (-> String Int String String (Vec diag::Diag) Units Strings Int))
;@axiom:effect(io)
(pub fn (asmRejectDiag ir n msg read ds units seen)
  (if (let (Some site) (asmSiteOf ir n))
    {
      (let u (asmUnitFor units site.file))
      (let key (concat site.key msg))
      {
        (let src (unitSrc (vecGet units u)))
        (if (isSome (asmSeenAt seen key 0))
          1
          {
            (vecPush seen key)
            (vecPush ds
              (diagSetUnitD
                (mkDiagNote SEV_ERROR "AX3117" "inline-asm-rejected"
                  (match site.start
                    ((None) 0)
                    ((Some start)
                      (match site.end
                        ((None) 0)
                        ((Some end)
                          (if (&& (> end start) (<= end (strLen src)))
                            (mkSpan start end)
                            0)
                        ))
                    ))
                  (concat "llc rejected this line of an `asm` template: " msg) None
                  (Some
                    "`check` runs no assembler, so an `asm` template is first assembled when the program is built; fix the instruction, or keep the IR with `--emit-llvm` and run `llc` on it to see the whole report")
                  (if (> (strLen read) 0)
                    (concat (concat "the assembler read `" read)
                      "`, with the operands in their registers")
                    "the register allocator found no registers for the operands this line asks for; name fewer operands, or fewer clobbers"))
                u))
            1
          })
      }
    }
    0))

(pub :: asmSeenAt (-> Strings String Int (Option Int)))
(pub fn (asmSeenAt v k i)
  (if (>= i (vecLen v))
    None
    (if (strEq (vecGet v i) k)
      (Some i)
      (asmSeenAt v k (+ i 1)))))

; `diagSetUnit`, answering the diagnostic so it can wrap a constructor.
(pub :: diagSetUnitD (-> diag::Diag Int diag::Diag))
(pub fn (diagSetUnitD d u)
  {
    (diagSetUnit d u)
    d
  })

; Read llc's report: an AX3117 onto `ds` for each error that names a
; cookie a site comment in `ir` covers. Answers how many errors did not.
(pub :: asmFailDiags (-> String String Diags Units Int))
;@axiom:effect(io)
(pub fn (asmFailDiags text ir ds units)
  {
    (let ls (asmTextLines text))
    (let seen vecNew)
    (let mut unmapped 0)
    (let mut i 0)
    {
      (while (< i (vecLen ls))
        {
          (let l (vecGet ls i))
          {
            (if (let (Some at) (strFindSub l "error: " 0))
              {
                (let msg (strSlice l (+ at 7) (- (strLen l) (+ at 7))))
                (let inline (strStartsWith l "<inline asm>:"))
                {
                  (let cookie
                    (if inline
                      (asmNoteCookie ls (+ i 1))
                      (asmAtLine msg)))
                  (let shown
                    (if inline
                      msg
                      (asmBeforeAtLine msg)))
                  (let read
                    (if (&& inline (< (+ i 1) (vecLen ls)))
                      (asmTrim (vecGet ls (+ i 1)))
                      ""))
                  (match cookie
                    ((None)
                      (set unmapped (+ unmapped 1))
                    )
                    ((Some cookie)
                      (if (!= (asmRejectDiag ir cookie shown read ds units seen) 1)
                        (set unmapped (+ unmapped 1)))
                    ))
                }
              })
            (set i (+ i 1))
          }
        })
      unmapped
    }
  })

; The cookie of a `note: !srcloc = N` within the three lines after an
; assembler error, or None.
(pub :: asmNoteCookie (-> Strings Int (Option Int)))
(pub fn (asmNoteCookie ls from)
  {
    (let mut i from)
    (let mut c (:: None (Option Int)))
    {
      (while (&& (isNone c) (&& (< i (vecLen ls)) (< (- i from) 3)))
        {
          (if (let (Some at) (strFindSub (vecGet ls i) "note: !srcloc = " 0))
            (set c (asmNumAt (vecGet ls i) (+ at 16))))
          (set i (+ i 1))
        })
      c
    }
  })

; `... at line N`: N, or None.
(pub :: asmAtLine (-> String (Option Int)))
(pub fn (asmAtLine msg)
  (if (let (Some at) (strFindSub msg " at line " 0))
    (asmNumAt msg (+ at 9))
    None))

(pub :: asmBeforeAtLine (-> String String))
(pub fn (asmBeforeAtLine msg)
  (if (let (Some at) (strFindSub msg " at line " 0))
    (strSlice msg 0 at)
    msg))

; A failed llc: AX3117 at each template line it names when every error
; names one, else its own report and AX4003.
(pub :: llcFailed (-> String String (Result Int Error) Int))
;@axiom:effect(io)
(pub fn (llcFailed ir errPath rc)
  (if (isErr rc)
    (toolFailDiag "could not run `llc`"
      "install LLVM and put `llc` on PATH; `--emit-llvm` keeps the IR so the step can be run by hand")
    {
      (let text (unwrapOr (readFile errPath) ""))
      (let ds vecNew)
      (let units vecNew)
      {
        (unwrapOr (removeFile errPath) 0)
        {
          (let unmapped (asmFailDiags text ir ds units))
          (if (&& (== unmapped 0) (> (vecLen ds) 0))
            {
              (writeStr stderr (renderDiagsFormat diagFormatFromArgv ds units))
              (writeStr stderr (renderFailTrailer (vecLen ds)))
              1
            }
            {
              (writeStr stderr text)
              (toolFailDiag "llc failed"
                "install LLVM and put `llc` on PATH; `--emit-llvm` keeps the IR so the step can be run by hand")
            })
        }
      }
    }))

; What a successful llc printed, passed on to standard error, and the
; file removed.
(pub :: llcPassOn (-> String Int))
;@axiom:effect(io)
(pub fn (llcPassOn errPath)
  {
    (let text (unwrapOr (readFile errPath) ""))
    {
      (unwrapOr (removeFile errPath) 0)
      (if (> (strLen text) 0)
        {
          (writeStr stderr text)
          0
        }
        0)
    }
  })

(pub :: assembleAndLink (-> String String String String Int Strings String Bool Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (assembleAndLink ir llPath objPath outPath optLevel linkArgs winTarget isBaremetal)
  ; llc's standard error goes to a file beside the object, so a
  ; rejected `asm` template line is reported where it is written
  ; (`llcFailed`, AX3117). A run that succeeds passes on what llc
  ; printed, its warnings, unchanged.
  {
    (let lvl
      (if (> optLevel 3)
        3
        (if (< optLevel 0)
          0
          optLevel)))
    {
      (let llcArgs
        {
          (let v vecNew)
          {
            (vecPush v llPath)
            (vecPush v "-filetype=obj")
            (vecPush v "-o")
            (vecPush v objPath)
            (vecPush v (concat "-O" (fmtIntStr lvl)))
            (vecPush v llcRelocArg)
            v
          }
        })
      {
        (let rc (runToolErrTo "llc" llcArgs (concat objPath ".llc-err")))
        (if (! (toolSucceeded rc))
          (llcFailed ir (concat objPath ".llc-err") rc)
          {
            (llcPassOn (concat objPath ".llc-err"))
            (if (> (strLen winTarget) 0)
              (if cgStaticlib
                (toolFailDiag
                  (concat "`--emit-staticlib` is not supported for " (concat winTarget " yet"))
                  "the Windows link is lld-link's and `ar` has no place in it; an archive for a Windows host is a later phase of the Windows track")
                (if (windowsArchivesWrongMachine linkArgs winTarget)
                  (toolFailDiag "lld-link failed"
                    (concat "the import archive has the wrong machine; put a `kernel32.lib` for "
                      (concat
                        (if (strEq winTarget "windows-aarch64")
                          "arm64"
                          "x64")
                        " on a `--link-search` directory")))
                  (match (windowsImportLibs ir objPath winTarget linkArgs)
                    ((Err msg) (toolFailDiag "could not make an import library" msg))
                    ((Ok implibs)
                      {
                        (let linkArgsW
                          {
                            (let v vecNew)
                            {
                              (vecPush v "/subsystem:console")
                              (vecPush v "/entry:mainCRTStartup")
                              ; 8 MB, the main-thread stack Linux and Darwin
                              ; give by default. Windows' default is 1 MB,
                              ; which the compiler overflows compiling
                              ; itself (0xC00000FD).
                              (vecPush v "/stack:8388608")
                              (if (strEq winTarget "windows-aarch64")
                                (vecPush v "/machine:arm64"))
                              (vecPush v (concat "/out:" outPath))
                              (vecPush v objPath)
                              (windowsPushLibs v implibs 0)
                              (appendLinkArgsWindows v linkArgs)
                              v
                            }
                          })
                        {
                          (let rcw (runTool "lld-link" linkArgsW))
                          (windowsRemoveLibs implibs 0)
                          (if (! (toolSucceeded rcw))
                            (toolFailDiag
                              (toolFailureMessage rcw "could not run `lld-link`" "lld-link failed")
                              (concat (concat "lld-link links a " winTarget)
                                " executable; it ships with LLVM's lld (`brew install lld`, `apt-get install lld`, choco's llvm) - put it on PATH"))
                            0)
                        }
                      }
                    ))))
              (if isBaremetal
                ; The bare target links an ELF for QEMU's `-kernel`, not
                ; a hosted executable: `ld.lld` with the port's linker
                ; script, no C runtime and nothing dynamic. A bare
                ; archive is refused the way a Windows one is: the host
                ; that would link it does not exist yet.
                (if cgStaticlib
                  (toolFailDiag "`--emit-staticlib` is not supported for baremetal-aarch64 yet"
                    "the baremetal link is ld.lld's and `ar` has no place in it; an archive for a device host is a later phase of the baremetal track")
                  {
                    (let ldPath (concat outPath ".ld"))
                    (if (isErr (writeFile ldPath (baremetalLinkScript)))
                      (toolFailDiag "could not write linker script"
                        "check that the output directory exists and is writable")
                      {
                        (let ldArgs
                          {
                            (let v vecNew)
                            {
                              (vecPush v "-T")
                              (vecPush v ldPath)
                              (vecPush v objPath)
                              (appendLinkArgs v linkArgs)
                              (vecPush v "-o")
                              (vecPush v outPath)
                              v
                            }
                          })
                        {
                          (let rcl (runTool "ld.lld" ldArgs))
                          {
                            (unwrapOr (removeFile ldPath) 0)
                            (if (! (toolSucceeded rcl))
                              (toolFailDiag
                                (toolFailureMessage rcl "could not run `ld.lld`" "ld.lld failed")
                                "ld.lld links a baremetal-aarch64 executable; it ships with LLVM's lld (`brew install llvm`, `apt-get install lld`) - put it on PATH")
                              0)
                          }
                        }
                      })
                  })
                (if cgStaticlib
                  ; `--emit-staticlib`: the object is ARCHIVED, not linked -
                  ; a Rust (or C) host links it, and its `pub fn`s are the
                  ; host's `extern "C"` symbols (docs/ffi.md, the other
                  ; direction). The module was emitted without the `@main`
                  ; wrapper, so the host's own `main` is the only one.
                  {
                    (let arArgs
                      {
                        (let v vecNew)
                        {
                          (vecPush v "rcs")
                          (vecPush v outPath)
                          (vecPush v objPath)
                          v
                        }
                      })
                    {
                      (unwrapOr (removeFile outPath) 0)
                      {
                        (let rc3 (runTool "ar" arArgs))
                        (if (! (toolSucceeded rc3))
                          (toolFailDiag (toolFailureMessage rc3 "could not run `ar`" "ar failed")
                            "`ar` writes the static archive; put it on PATH (it ships with every C toolchain)")
                          0)
                      }
                    }
                  }
                  ; The FFI's link inputs, in DECLARATION
                  ; ORDER. `check-reproducible.sh` compares
                  ; bytes, and an unordered link line would
                  ; flip them run to run.
                  ;
                  ; Before `--link-lib`, this vector was
                  ; three entries and the language could not
                  ; name an external symbol, so there was
                  ; nothing for a `-l` to resolve.
                  {
                    (let ccArgs
                      {
                        (let v vecNew)
                        {
                          (vecPush v objPath)
                          (if (hasFlagAnywhere subcommandName "--obfuscate")
                            (vecPush v
                              (if (isSome (strFind (unwrapOr (readFile llPath) "") "apple-" 0))
                                "-Wl,-S,-x"
                                "-Wl,--strip-all")))
                          (appendLinkArgs v linkArgs)
                          (vecPush v "-o")
                          (vecPush v outPath)
                          v
                        }
                      })
                    {
                      (let rc2 (runTool "cc" ccArgs))
                      (if (! (toolSucceeded rc2))
                        (toolFailDiag (toolFailureMessage rc2 "could not run `cc`" "cc failed")
                          "a C compiler drives the link step; put `cc` on PATH")
                        0)
                    }
                  })))
          })
      }
    }
  })

; ------------------------------------------------------------------
; `--crate DIR`, the whole of it: before the program is compiled, each
; crate's binding module is brought up to date with its source when
; `axiom-bindgen` is on PATH (`cargo install --path rust/axiom-bindgen`
; puts it there), and its archive is built when `cargo` is and the
; archive is missing. Each step says what it ran on stderr. Neither
; tool present, nothing happens and the ordinary diagnostics apply -
; AX5001 for a missing module, AX4004 for a missing archive.
;
; The package name comes from `DIR/Cargo.toml`; the archive stem is
; the name with `-` as `_`; the module is the stem of the one `.ax`
; file in `DIR/axiom/`, or, for a fresh crate, the package name in
; CamelCase with a leading `axiom-` dropped (`axiom-demo` -> `Demo`,
; `greeter` -> `Greeter`).
; ------------------------------------------------------------------
(pub :: prepareCrates Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (prepareCrates)
  {
    (let crates crateDirsOf)
    {
      (for i in 0..(vecLen crates)
        (prepareCrate (vecGetStr crates i)))
      0
    }
  })

(pub :: prepareCrate (-> String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (prepareCrate dirIn)
  {
    (let dir (pathWithSlash dirIn))
    (let manifest (concat dir "Cargo.toml"))
    (match (cargoPackageName manifest)
      ((Err e)
        {
          (writeStderrStr (readFailMsg manifest (errCode e)))
          (sysExitWith 1)
        }
      )
      ((Ok None) 0)
      ((Ok (Some pkg))
        (if (== (strLen pkg) 0)
          0
          {
            (let stem (dashesToUnderscores pkg))
            (let module (crateModuleName dir pkg))
            {
              (if (fileExists (concat dir "src"))
                {
                  (let _ (refreshBindings dir stem module))
                  ()
                })
              ; A cargo staticlib is `lib<stem>.a` on every host this
              ; driver runs on - the `.lib` spelling belongs to the import
              ; libraries a WINDOWS LINK consumes, and `--crate` for a
              ; Windows target is not a thing yet (docs/ffi.md has no
              ; Windows story) - so the archive is looked for as `.a`.
              (if (! (libExistsIn (crateTargetDirs dir) stem 0 false))
                {
                  (let _ (buildCrate dir pkg))
                  ()
                })
              0
            }
          })
      ))
  })

(pub :: crateTargetDirs (-> String Strings))
(pub fn (crateTargetDirs dir)
  {
    (let v vecNew)
    {
      (vecPush v (concat dir "target/release"))
      (vecPush v (concat dir "../target/release"))
      (vecPush v (concat dir "../../target/release"))
      v
    }
  })

; Regenerate the module when `axiom-bindgen --check` finds it stale or
; absent. Exit 2 from `--check` is "no such file" as well as a usage
; error, so a missing module regenerates; a bindgen that is not on
; PATH answers Err and nothing is written.
(pub :: refreshBindings (-> String String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (refreshBindings dir stem module)
  {
    (let modPath (concat (concat dir "axiom/") (concat module ".ax")))
    {
      (let checkArgs
        {
          (let v vecNew)
          {
            (vecPush v "--src")
            (vecPush v (concat dir "src"))
            (vecPush v "--lib")
            (vecPush v stem)
            (vecPush v "--module")
            (vecPush v module)
            (vecPush v "--check")
            (vecPush v modPath)
            (vecPush v "--quiet")
            v
          }
        })
      {
        (let rc (runToolQuiet "axiom-bindgen" checkArgs))
        (if (|| (isErr rc) (toolSucceeded rc))
          (Ok 0)
          {
            (let genArgs
              {
                (let v vecNew)
                {
                  (vecPush v "--src")
                  (vecPush v (concat dir "src"))
                  (vecPush v "--lib")
                  (vecPush v stem)
                  (vecPush v "--module")
                  (vecPush v module)
                  (vecPush v "-o")
                  (vecPush v (concat dir "axiom"))
                  v
                }
              })
            {
              (writeStderrStr
                (concat "axiom: regenerating " (concat modPath " with axiom-bindgen\n")))
              (runTool "axiom-bindgen" genArgs)
            }
          })
      }
    }
  })

(pub :: buildCrate (-> String String (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (buildCrate dir pkg)
  {
    (let args
      {
        (let v vecNew)
        {
          (vecPush v "build")
          (vecPush v "--release")
          (vecPush v "--manifest-path")
          (vecPush v (concat dir "Cargo.toml"))
          v
        }
      })
    {
      (writeStderrStr
        (concat "axiom: building crate `" (concat pkg "` with cargo (no archive found)\n")))
      (runTool "cargo" args)
    }
  })

; `runTool` for a probe whose exit status is the whole answer. The
; tool is asked to be quiet by flag (`--quiet` rides in `args`): the
; driver redirects no descriptor, so a tool that talks anyway is heard.
(pub :: runToolQuiet (-> String Strings (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (runToolQuiet tool args)
  (runTool tool args))

; `name = "..."` under `[package]` in a Cargo manifest. A missing file
; answers Ok None; a failed read keeps its operating-system error.
(pub :: cargoPackageName (-> String (Result (Option String) Error)))
;@axiom:effect(io)
(pub fn (cargoPackageName path)
  (match (readFile path)
    ((Err e)
      (if (== (errCode e) 2)
        (Ok None)
        (Err e))
    )
    ((Ok text) (Ok (cargoPackageNameIn text)))))

(pub :: cargoPackageNameIn (-> String (Option String)))
(pub fn (cargoPackageNameIn text)
  (if (let (Some at) (strFindSub text "[package]" 0))
    (if (let (Some nm) (strFindSub text "name" at))
      (if (let (Some q1) (strFindByte text 34 nm))
        (if (let (Some q2) (strFindByte text 34 (+ q1 1)))
          (Some (strSlice text (+ q1 1) (- q2 (+ q1 1))))
          None)
        None)
      None)
    None))

(pub :: dashesToUnderscores (-> String String))
;@axiom:effect(unsafe)
(pub fn (dashesToUnderscores s)
  {
    (let out (strDup s))
    (let mut i 0)
    {
      (while (< i (strLen out))
        {
          (if (== (strByte out i) 45)
            (__store8 (strData out) i 95))
          (set i (+ i 1))
        })
      out
    }
  })

; The module name: the one `.ax` in `DIR/axiom/`, else CamelCase of
; the package name without a leading `axiom-`.
(pub :: crateModuleName (-> String String String))
;@axiom:effect(io)
(pub fn (crateModuleName dir pkg)
  {
    (let entries (unwrapOr (listDir (concat dir "axiom")) vecNew))
    (let mut found "")
    (let mut n 0)
    {
      (for i in 0..(vecLen entries)
        {
          ; `Name.ax` and nothing else: the first `.` is the
          ; extension's, so a crate whose module is `Hash.ax` gets no
          ; second module named for the package.
          (let e (vecGet entries i))
          (if (&& (> (strLen e) 3)
                (&& (strEq (strSlice e (- (strLen e) 3) 3) ".ax")
                  (if (let (Some d) (strFindByte e 46 0))
                    (== d (- (strLen e) 3))
                    false)))
            {
              (if (== (strLen found) 0)
                ; The guard above has just established that the ONLY
                ; `.` is at `strLen - 3`, so this is that index
                ; rather than a second scan for it.
                (set found (strSlice e 0 (- (strLen e) 3))))
              (set n (+ n 1))
            })
        })
      ; EXACTLY one, not the first of several. With two `.ax` files
      ; under `axiom/`, picking one - even the first in `listDir`'s
      ; sorted order - would still overwrite the other, so a
      ; hand-written module beside a generated one gets clobbered. At
      ; one candidate there is nothing to choose between; above one the
      ; answer does not read the listing at all, because the
      ; package-derived name below does not.
      (if (== n 1)
        found
        (camelOf
          (if (strStartsWith pkg "axiom-")
            (strSlice pkg 6 (- (strLen pkg) 6))
            pkg)))
    }
  })

; `my-crate_name` -> `MyCrateName`.
(pub :: camelOf (-> String String))
;@axiom:effect(unsafe)
(pub fn (camelOf s)
  {
    (let out (strAlloc (strLen s)))
    (let mut i 0)
    (let mut o 0)
    (let mut up 1)
    {
      (while (< i (strLen s))
        {
          {
            (let b (strByte s i))
            (if (|| (== b 45) (== b 95))
              (set up 1)
              {
                (__store8 (strData out) o
                  (if (&& (== up 1) (&& (>= b 97) (<= b 122)))
                    (- b 32)
                    b))
                (set o (+ o 1))
                (set up 0)
              })
          }
          (set i (+ i 1))
        })
      (strSlice out 0 o)
    }
  })

; `--emit-staticlib` anywhere on the command line.
; ------------------------------------------------------------------
; GROUNDING: every `declare` the module writes must name a symbol that
; some archive on the link line could define.
;
; This is the FFI's central claim, made mechanical. `foreign` emitted
; `call i64 @putchar(...)` into a module that declared no `@putchar`;
; `check` answered OK and the program died two stages later inside
; `opt`, with a message about generated code and no span into the
; source (the self-hosting record). An `extern` naming a symbol that
; does not exist is the same defect, and this refuses it BEFORE the
; toolchain runs - which is the whole difference between a compiler
; diagnostic and a linker error about a file the user never wrote.
;
; What it proves, precisely: the name appears nowhere in any archive on
; the link line, so nothing there can define it. The converse is
; weaker - a name that DOES appear might be a string constant rather
; than a definition - so this refuses ABSENCE and never manufactures
; presence. That asymmetry is the right one: a false rejection would
; break a correct build, and the case that actually happens is a typo,
; which is absence.
;
; The declares are read out of the IR the driver already holds, not
; passed down from codegen. That is deliberate: it checks exactly the
; text that is about to be assembled, so a declare the emitter writes
; by some path this file does not know about is still covered.
; ------------------------------------------------------------------
(pub :: buildFailDiag (-> String String String String Int))
;@axiom:effect(io)
(pub fn (buildFailDiag code slug msg help)
  {
    (let d (mkDiag SEV_ERROR code slug 0 msg None (Some help)))
    (let ds vecNew)
    (let units vecNew)
    {
      (vecPush ds d)
      (vecPush units (CUnit2 :file "<link>" :src "" :name None :imports vecNew :library false))
      {
        (let out (renderDiagsFormat diagFormatFromArgv ds units))
        (writeStr stderr out)
      }
      exitToolFailed
    }
  })

; The first index at or after `from` where `needle` occurs in `hay`.
; Anchored on the first byte so the common case is one scan.
(pub :: strFindSub (-> String String Int (Option Int)))
(pub fn (strFindSub hay needle from)
  (if (|| (< from 0) (> from (strLen hay)))
    None
    (if (== (strLen needle) 0)
      (Some from)
      (if (let (Some i) (strFindByte hay (strByte needle 0) from))
        (if (subMatchesAt hay needle i 0)
          (Some i)
          (strFindSub hay needle (+ i 1)))
        None))))

(pub :: subMatchesAt (-> String String Int Int Bool))
(pub fn (subMatchesAt hay needle at k)
  (if (>= k (strLen needle))
    true
    (if (>= (+ at k) (strLen hay))
      false
      (if (== (strByte hay (+ at k)) (strByte needle k))
        (subMatchesAt hay needle at (+ k 1))
        false))))

; `-L<dir>` and `-l<name>` back into `<dir>/lib<name>.a` paths - or
; `<dir>/<name>.lib` for a Windows link - every directory crossed with
; every library, because the link line does not say which archive
; lives where and neither does this.
(pub :: archivePathsOf (-> Strings Bool Strings))
(pub fn (archivePathsOf linkArgs isWin)
  {
    (let dirs vecNew)
    (let libs vecNew)
    (let out vecNew)
    {
      (for a in linkArgs
        (if (strStartsWith a "-L")
          (vecPush dirs (strSlice a 2 (- (strLen a) 2)))
          (if (strStartsWith a "-l")
            (vecPush libs (strSlice a 2 (- (strLen a) 2))))))
      (for dir in dirs
        (for lib in libs
          (vecPush out (archivePathIn dir lib isWin))))
      out
    }
  })

; The `; axiom-extern-lib NAME` lines codegen writes beside the
; declares: one per `extern` block the program or its imports
; declare.
(pub :: externLibsOf (-> String Strings))
(pub fn (externLibsOf ir)
  {
    (let out vecNew)
    (let mut at 0)
    (let mut done false)
    {
      (while (! done)
        (match (strFindSub ir "\n; axiom-extern-lib " at)
          ((None)
            (set done true)
          )
          ((Some d)
            {
              (let start (+ d 20))
              (if (let (Some end) (strFindByte ir 10 start))
                {
                  {
                    (let nm (strSlice ir start (- end start)))
                    (if (== (strIndexIn out nm) (- 0 1))
                      (vecPush out nm))
                  }
                  (set at end)
                }
                (set done true))
            }
          )))
      out
    }
  })

; The link line a build actually uses: the explicit `--link-search`
; and `--link-lib` arguments first, then every directory of
; `$AXIOM_LINK_SEARCH`, then `<dir>/../target/release` and
; `<dir>/../../target/release` beside each `$AXIOM_PATH` entry (a
; crate's `axiom/` binding directory sits next to its `target/`),
; and then `-l<lib>` for every `extern` block whose `lib<lib>.a` some
; search directory holds and no explicit flag already names, so a
; build need not repeat a block's library as `--link-lib`.
;
; `entryDir` is here for one reason: `axiom.pkg`'s `crate` lines.
; Every other source of a search directory is a flag or an environment
; variable, both of which this function could read for itself; a
; manifest is found by walking up from the file being compiled, so the
; file has to be handed in. Without it, `AXIOM_PATH=vendor/greeter/axiom`
; would link while `depend vendor/greeter/axiom` in the manifest exited
; 4 with `AX4004`.
(pub :: effectiveLinkArgs (-> String String Strings Strings))
;@axiom:effect(io)
(pub fn (effectiveLinkArgs ir entryDir explicit)
  {
    (let v vecNew)
    (let dirs vecNew)
    (let libs vecNew)
    {
      (for a in explicit
        {
          (vecPush v a)
          (if (strStartsWith a "-L")
            (vecPush dirs (strSlice a 2 (- (strLen a) 2)))
            (if (strStartsWith a "-l")
              (vecPush libs (strSlice a 2 (- (strLen a) 2)))))
        })
      (addSearchDir v dirs (sysEnv "AXIOM_LINK_SEARCH"))
      (addAxiomPathDirs v dirs (sysEnv "AXIOM_PATH"))
      ; a crate's own `target/release`, or its workspace's one or two
      ; levels up (`rust/examples/demo` builds into `rust/target`) -
      ; for every `--crate DIR` the command line names, and then for
      ; every `crate DIR` the manifest declares. Both lists, one rule;
      ; `addOneDir` drops a directory that is already on the line and
      ; one that does not exist, so the two overlapping is free.
      (addCrateDirs v dirs crateDirsOf)
      (addCrateDirs v dirs (pkgCrateDirs entryDir))
      {
        (let wanted (externLibsOf ir))
        (for lib in wanted
          (if (== (strIndexIn libs lib) (- 0 1))
            (if (libExistsIn dirs lib 0 (irTargetIsWindows ir))
              {
                (vecPush v (concat "-l" lib))
                (vecPush libs lib)
              })))
      }
      v
    }
  })

; `crateTargetDirs` for each crate directory in `crates`, added the
; way every other search directory here is. `crateTargetDirs` is
; `prepareCrate`'s - the same three suffixes it looks for the archive
; in - rather than a second copy, because a driver that BUILDS into a
; directory it does not then SEARCH is the shape of an AX4004 nobody
; can explain.
(pub :: addCrateDirs (-> Strings Strings Names Int))
;@axiom:effect(io)
(pub fn (addCrateDirs v dirs crates)
  {
    (for c in 0..(vecLen crates)
      (addTargetDirs v dirs (crateTargetDirs (pathWithSlash (vecGetStr crates c))) 0))
    0
  })

(pub :: addTargetDirs (-> Strings Strings Strings Int Int))
;@axiom:effect(io)
(pub fn (addTargetDirs v dirs td i)
  (if (>= i (vecLen td))
    0
    {
      (addOneDir v dirs (vecGet td i))
      (addTargetDirs v dirs td (+ i 1))
    }))

(pub :: addSearchDir (-> Strings Strings String Int))
;@axiom:effect(io)
(pub fn (addSearchDir v dirs list)
  {
    (let parts (strSplit list 58))
    (let mut i 0)
    {
      (while (< i (vecLen parts))
        {
          {
            (let d (vecGet parts i))
            (if (&& (> (strLen d) 0) (== (strIndexIn dirs d) (- 0 1)))
              (if (fileExists d)
                {
                  (vecPush v (concat "-L" d))
                  (vecPush dirs d)
                }))
          }
          (set i (+ i 1))
        })
      0
    }
  })

(pub :: addAxiomPathDirs (-> Strings Strings String Int))
;@axiom:effect(io)
(pub fn (addAxiomPathDirs v dirs list)
  {
    (let parts (strSplit list 58))
    {
      (for p in parts
        (if (> (strLen p) 0)
          {
            (addOneDir v dirs (concat (pathWithSlash p) "../target/release"))
            (addOneDir v dirs (concat (pathWithSlash p) "../../target/release"))
          }))
      0
    }
  })

(pub :: addOneDir (-> Strings Strings String Int))
;@axiom:effect(io)
(pub fn (addOneDir v dirs d)
  (if (== (strIndexIn dirs d) (- 0 1))
    (if (fileExists d)
      {
        (vecPush v (concat "-L" d))
        (vecPush dirs d)
        0
      }
      0)
    0))

(pub :: libExistsIn (-> Strings String Int Bool Bool))
;@axiom:effect(io)
(pub fn (libExistsIn dirs lib i isWin)
  (if (>= i (vecLen dirs))
    false
    (if (fileExists (archivePathIn (vecGet dirs i) lib isWin))
      true
      (libExistsIn dirs lib (+ i 1) isWin))))

; Read every archive once. A path that does not exist reads empty and
; simply grounds nothing, which lets `cc` produce its own error about
; the missing file rather than this pass inventing one.
(pub :: readArchives (-> Strings Strings))
;@axiom:effect(io)
(pub fn (readArchives paths)
  {
    (let out vecNew)
    {
      (for i in 0..(vecLen paths)
        (vecPush out (unwrapOr (readFile (vecGet paths i)) "")))
      out
    }
  })

; A symbol is grounded by an archive when the archive's symbol tables
; hold the WHOLE name: `\0_name\0` (Mach-O, a leading underscore),
; `\0name\0` (ELF), or `\0__imp_name\0` (a COFF import library, whose
; members are import descriptors rather than code: the linker resolves
; a call to `name` through `__imp_name`, and an import library made by
; `llvm-dlltool` from a `.def` lists ONLY that spelling). The whole
; name matters: a bare substring scan would let `axffi_trip` ground
; against `axffi_triple` and die in the linker with a message about
; `cc`.
(pub :: symbolGrounded (-> Strings String Int Bool))
(pub fn (symbolGrounded blobs name i)
  (if (>= i (vecLen blobs))
    false
    (if (blobDefines (vecGet blobs i) name)
      true
      (symbolGrounded blobs name (+ i 1)))))

(pub :: blobDefines (-> String String Bool))
(pub fn (blobDefines blob name)
  (if (nulAfter blob (concat "_" name) 0)
    true
    (if (nulAfter blob (concat "__imp_" name) 0)
      true
      (nulAfter blob name 0))))

; Some occurrence of `needle` that ENDS the string it sits in and does
; not continue an identifier to its left.
;
; The left test does not demand a NUL: that is a Mach-O fact rather
; than a fact about archives. On linux-x86_64, every occurrence of
; `axffi_abi_probe` in `libaxiom_demo.a` reads:
;
;   off=10608   before=0xbe  after=0x00
;   off=10624   before=0x00  after='_'
;   off=277958  before='.'   after='_'
;   off=278570  before='.'   after=0x00
;
; Not one is `\0name\0`. The first is the archive symbol index, where
; the earliest name follows the binary offset table rather than a NUL -
; and `axffi_abi_probe` sorts first among the crate's symbols, so it is
; that name. The last is `.text.axffi_abi_probe`: with
; `-ffunction-sections` the symbol's own `.strtab` entry is TAIL-SHARED
; with the section name, which is exactly what tail merging is for and
; means the standalone spelling never appears. `axffi_fnv1a` in the
; nostd archive is the same story.
;
; A NUL on the left would refuse a defined symbol with AX4004 on Linux
; only, since Mach-O writes `\0_name\0`.
;
; The trailing NUL is what carries the real check: it is what keeps
; `axffi_trip` from grounding against `axffi_triple`. To its left, a
; byte that cannot continue an identifier says the same thing portably -
; a NUL, a `.`, or the last byte of an offset table all qualify, and
; `e` in `axffi_triple` does not.
;
; `blobDefines` tries the underscore spelling and the bare one; seeing
; `\0_name` somewhere does not commit it to the first.
(pub :: nulAfter (-> String String Int Bool))
(pub fn (nulAfter blob needle from)
  (if (let (Some at) (strFindSub blob needle from))
    {
      (let end (+ at (strLen needle)))
      (if (&& (&& (< end (strLen blob)) (== (strByte blob end) 0))
            (== (identByteAt blob (- at 1)) 0))
        true
        (nulAfter blob needle (+ at 1)))
    }
    false))

; Is the byte at `i` one an identifier can be made of? Off the front of
; the blob is not, which is what makes a name at offset 0 groundable.
(pub :: identByteAt (-> String Int Int))
(pub fn (identByteAt blob i)
  (if (< i 0)
    0
    {
      (let b (strByte blob i))
      (if (|| (|| (&& (>= b 65) (<= b 90)) (&& (>= b 97) (<= b 122)))
            (|| (&& (>= b 48) (<= b 57)) (== b 95)))
        1
        0)
    }))

; Every `axffi_` name an archive's tables hold, for a did-you-mean.
(pub :: archiveFfiNames (-> Strings Strings))
(pub fn (archiveFfiNames blobs)
  {
    (let out vecNew)
    {
      (for i in 0..(vecLen blobs)
        (collectFfiNames (vecGet blobs i) out 0))
      out
    }
  })

(pub :: collectFfiNames (-> String Strings Int Int))
(pub fn (collectFfiNames blob out from)
  (if (let (Some at) (strFindSub blob "axffi_" from))
    (if (let (Some end) (strFindByte blob 0 at))
      {
        {
          (let nm (strSlice blob at (- end at)))
          (if (&& (< (strLen nm) 200) (== (strIndexIn out nm) (- 0 1)))
            (vecPush out nm))
        }
        (collectFfiNames blob out end)
      }
      0)
    0))

; The candidate sharing the longest prefix with `name`, when that
; prefix reaches past `axffi_`; "" otherwise.
(pub :: closestFfiName (-> Strings String String))
(pub fn (closestFfiName names name)
  {
    (let mut best "")
    (let mut bestLen 6)
    {
      (for c in names
        {
          (let k (commonPrefixLen c name 0))
          (if (> k bestLen)
            {
              (set best c)
              (set bestLen k)
            })
        })
      best
    }
  })

(pub :: commonPrefixLen (-> String String Int Int))
(pub fn (commonPrefixLen a b i)
  (if (|| (>= i (strLen a)) (>= i (strLen b)))
    i
    (if (== (strByte a i) (strByte b i))
      (commonPrefixLen a b (+ i 1))
      i)))

; The two symbols a `--threads` build declares that no archive on the
; link line defines, because the PLATFORM defines them: `pthread_create`
; and `pthread_join`, from libSystem on Darwin and libc on Linux, the
; libraries `cc` links whether or not it is asked to. The emitter
; writes their `declare`s only when `cgThreads` is on
; (`emitParThread`), and only for a target `targetHasThreads` admits,
; so grounding them against the link line would refuse every
; thread-lowered program for a library it cannot name. `fork` is the
; third, on Darwin only: a thread-lowered module forks through
; libSystem there (`parLibcFork`), because a raw `fork` leaves the
; child unable to start a thread. They are the thread lowering's whole
; import surface, and `scripts/check-parallel.sh` measures exactly that.
(pub :: platformGroundedSym (-> String Bool))
(pub fn (platformGroundedSym n)
  (|| (strEq n "pthread_create") (|| (strEq n "pthread_join") (strEq n "fork"))))

; These saturating conversions, and the `llvm.trap` that ends the
; recovery abort on windows-x86_64 (`emitRecoverRuntime`), are LLVM
; instructions. Their exact names are grounded by the backend, and
; never by a linked archive.
(pub :: backendGroundedSym (-> String Bool))
(pub fn (backendGroundedSym n)
  (sizedTyIn n
    "llvm.fptosi.sat.i8.f64 llvm.fptoui.sat.i8.f64 llvm.fptosi.sat.i16.f64 llvm.fptoui.sat.i16.f64 llvm.fptosi.sat.i32.f64 llvm.fptoui.sat.i32.f64 llvm.fptosi.sat.i64.f64 llvm.fptoui.sat.i64.f64 llvm.trap"))

; Every name a Windows module imports from `dll`. For kernel32 that is
; the runtime's own `declare dllimport` lines and each `declare` in the
; run that follows a `; axiom-extern-lib kernel32` line, which codegen
; writes above the declares of an `extern "kernel32"` block; for any
; other DLL it is the runs after that DLL's own marker. These are the
; names an import library for the DLL has to carry.
(pub :: windowsImportNamesOf (-> String String Strings))
(pub fn (windowsImportNamesOf ir dll)
  {
    (let out vecNew)
    (if (strEq dll "kernel32")
      (windowsDllimportFrom ir 0 out))
    (windowsLibRunsFrom ir 0 (concat (concat "\n; axiom-extern-lib " dll) "\n") out)
    out
  })

; The DLLs a Windows module imports from: kernel32, which the runtime
; always needs, then each `extern` block's library in order of first
; appearance, read from the markers codegen writes.
(pub :: windowsExternLibsOf (-> String Strings))
(pub fn (windowsExternLibsOf ir)
  {
    (let out vecNew)
    (pushNameOnce out "kernel32")
    (windowsExternLibsFrom ir 0 out)
    out
  })

(pub :: windowsExternLibsFrom (-> String Int Strings Int))
(pub fn (windowsExternLibsFrom ir at out)
  {
    (let marker "\n; axiom-extern-lib ")
    (if (let (Some m) (strFindSub ir marker at))
      {
        (let start (+ m (strLen marker)))
        (if (let (Some nl) (strFindByte ir 10 start))
          {
            (pushNameOnce out (strDup (strSlice ir start (- nl start))))
            (windowsExternLibsFrom ir nl out)
          }
          0)
      }
      0)
  })

; The name in the `declare` line starting at `d`, or "".
(pub :: declareNameAt (-> String Int String))
(pub fn (declareNameAt ir d)
  (if (let (Some sym) (strFindByte ir 64 d))
    (match (strFindByte ir 40 sym)
      ((None) "")
      ((Some open) (strDup (strSlice ir (+ sym 1) (- open (+ sym 1))))))
    ""))

(pub :: pushNameOnce (-> Strings String Int))
(pub fn (pushNameOnce out n)
  (if (|| (== (strLen n) 0) (>= (strIndexIn out n) 0))
    0
    {
      (vecPush out n)
      0
    }))

(pub :: windowsDllimportFrom (-> String Int Strings Int))
(pub fn (windowsDllimportFrom ir at out)
  (if (let (Some d) (strFindSub ir "\ndeclare dllimport " at))
    {
      (pushNameOnce out (declareNameAt ir (+ d 1)))
      (windowsDllimportFrom ir (+ d 1) out)
    }
    0))

(pub :: windowsLibRunsFrom (-> String Int String Strings Int))
(pub fn (windowsLibRunsFrom ir at marker out)
  (if (let (Some m) (strFindSub ir marker at))
    {
      (let next (windowsDeclareRun ir (+ m (strLen marker)) out))
      ; The next extern block may start immediately after this run.
      ; Include its preceding newline in the next marker search.
      (windowsLibRunsFrom ir (- next 1) marker out)
    }
    0))

; Push the name of each consecutive `declare` line from `at`, a line
; start, answering where the run ended.
(pub :: windowsDeclareRun (-> String Int Strings Int))
(pub fn (windowsDeclareRun ir at out)
  (if (strStartsWith (strSlice ir at (- (strLen ir) at)) "declare ")
    {
      (pushNameOnce out (declareNameAt ir at))
      (if (let (Some nl) (strFindByte ir 10 at))
        (windowsDeclareRun ir (+ nl 1) out)
        (strLen ir))
    }
    at))

; The import libraries a Windows link uses, one per DLL the module
; imports (`windowsExternLibsOf`). A DLL whose `<dll>.lib` the link
; arguments already name, and which exists, keeps that hand-made one in
; charge; every other one is written beside the object with
; `llvm-dlltool` from the module's own imports of that DLL, the way
; `scripts/check-windows-hello.sh` makes them from the allowlist.
; `(Err msg)` when `llvm-dlltool` can't make one.
(pub :: windowsImportLibs (-> String String String Strings (Result Strings String)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (windowsImportLibs ir objPath winTarget linkArgs)
  (windowsImportLibsFrom ir objPath winTarget linkArgs (windowsExternLibsOf ir) 0 vecNew))

(pub :: windowsImportLibsFrom
  (-> String String String Strings Strings Int Strings (Result Strings String)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (windowsImportLibsFrom ir objPath winTarget linkArgs dlls i out)
  (if (>= i (vecLen dlls))
    (Ok out)
    {
      (let dll (vecGet dlls i))
      (let names (windowsImportNamesOf ir dll))
      ; A block the module calls nothing from leaves no declare, and
      ; needs no library: a program that never draws entropy links
      ; with a hand-made kernel32.lib and no llvm-dlltool, as before.
      (if (|| (== (vecLen names) 0) (windowsHasLib (windowsArchivePathsOf linkArgs) dll 0))
        (windowsImportLibsFrom ir objPath winTarget linkArgs dlls (+ i 1) out)
        (match (windowsImportLibFor objPath winTarget dll names)
          ((Err msg) (Err msg))
          ((Ok lib)
            {
              (vecPush out lib)
              (windowsImportLibsFrom ir objPath winTarget linkArgs dlls (+ i 1) out)
            }
          )))
    }))

; One DLL's import library for `names`, written beside the object:
; `<obj>.<dll>.lib`.
(pub :: windowsImportLibFor (-> String String String Strings (Result String String)))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (windowsImportLibFor objPath winTarget dll names)
  {
    (let defPath (concat objPath (concat "." (concat dll ".def"))))
    (let libPath (concat objPath (concat "." (concat dll ".lib"))))
    (let def
      (concat (concat "LIBRARY " dll)
        (concat ".dll\nEXPORTS\n" (concat (strJoin names "\n") "\n"))))
    (if (isErr (writeFile defPath def))
      (Err (concat (concat "could not write the " dll) " import definitions beside the object"))
      {
        (let args vecNew)
        (vecPush args "-m")
        (vecPush args
          (if (strEq winTarget "windows-aarch64")
            "arm64"
            "i386:x86-64"))
        (vecPush args "-d")
        (vecPush args defPath)
        (vecPush args "-l")
        (vecPush args libPath)
        (let rc (runTool "llvm-dlltool" args))
        (unwrapOr (removeFile defPath) 0)
        (if (toolSucceeded rc)
          (Ok libPath)
          (Err
            (if (isErr rc)
              (concat
                "could not run `llvm-dlltool`, which makes the import libraries; it ships with LLVM - put it on PATH, or put a `"
                (concat dll ".lib` on a `--link-search` directory"))
              (concat (concat "llvm-dlltool failed to make the " dll) " import library"))))
      })
  })

(pub :: windowsHasLib (-> Strings String Int Bool))
;@axiom:effect(io)
(pub fn (windowsHasLib paths dll i)
  (if (>= i (vecLen paths))
    false
    {
      (let p (vecGet paths i))
      (if (&& (strEq (pathBase p) (concat dll ".lib")) (fileExists p))
        true
        (windowsHasLib paths dll (+ i 1)))
    }))

; The import libraries, pushed onto the link line; and removed again
; after it, so a build leaves only its output behind.
(pub :: windowsPushLibs (-> Strings Strings Int Int))
(pub fn (windowsPushLibs v libs i)
  (if (>= i (vecLen libs))
    0
    {
      (vecPush v (vecGet libs i))
      (windowsPushLibs v libs (+ i 1))
    }))

(pub :: windowsRemoveLibs (-> Strings Int Int))
;@axiom:effect(io)
(pub fn (windowsRemoveLibs libs i)
  (if (>= i (vecLen libs))
    0
    {
      (unwrapOr (removeFile (vecGet libs i)) 0)
      (windowsRemoveLibs libs (+ i 1))
    }))

; Every name a Windows module imports, from every DLL
; (`windowsExternLibsOf`): what the link grounds with import libraries.
(pub :: windowsAllImportNamesOf (-> String Strings))
(pub fn (windowsAllImportNamesOf ir)
  (windowsAllImportNamesFrom ir (windowsExternLibsOf ir) 0 vecNew))

(pub :: windowsAllImportNamesFrom (-> String Strings Int Strings Strings))
(pub fn (windowsAllImportNamesFrom ir dlls i out)
  (if (>= i (vecLen dlls))
    out
    {
      (let names (windowsImportNamesOf ir (vecGet dlls i)))
      (for k in 0..(vecLen names)
        (pushNameOnce out (vecGet names k)))
      (windowsAllImportNamesFrom ir dlls (+ i 1) out)
    }))

; The name in each `declare i64 @NAME(` line of the IR - less the two
; the platform grounds (`platformGroundedSym`), and on a Windows target
; less the DLL imports (`windowsAllImportNamesOf`), which the link
; grounds with import libraries (`windowsImportLibs`).
(pub :: declareNamesOf (-> String Strings))
(pub fn (declareNamesOf ir)
  {
    (let out vecNew)
    (let mut at 0)
    (let mut done false)
    (let k32
      (if (irTargetIsWindows ir)
        (windowsAllImportNamesOf ir)
        vecNew))
    {
      (while (! done)
        (match (strFindSub ir "\ndeclare " at)
          ((None)
            (set done true)
          )
          ((Some d)
            (if (let (Some sym) (strFindByte ir 64 d))
              (match (strFindByte ir 40 sym)
                ((None)
                  (set done true)
                )
                ((Some open)
                  {
                    (if (!
                          (|| (platformGroundedSym (strSlice ir (+ sym 1) (- open (+ sym 1))))
                            (|| (backendGroundedSym (strSlice ir (+ sym 1) (- open (+ sym 1))))
                              (>= (strIndexIn k32 (strSlice ir (+ sym 1) (- open (+ sym 1)))) 0))))
                      (vecPush out (strSlice ir (+ sym 1) (- open (+ sym 1)))))
                    (set at open)
                  }
                ))
              (set done true))
          )))
      out
    }
  })

; The grounding check WITH a source span: the extern item that bound
; the ungrounded symbol is found among the resolved declarations, and
; the diagnostic points at it, distinguishing three mistakes - nothing
; linked at all, an archive linked that does not define the name, and a
; name close to one an archive does define. `compileFile` runs this before the toolchain;
; `groundDeclares` below stays as the span-less fallback for IR built
; by another path.
(pub :: groundExternsSpanned (-> String (Vec ASTNode) Units Int Strings Int))
;@axiom:effect(io)
(pub fn (groundExternsSpanned ir decls units dfmt linkArgs)
  {
    (let names (declareNamesOf ir))
    (if (== (vecLen names) 0)
      0
      {
        (let paths (existingPaths (archivePathsOf linkArgs (irTargetIsWindows ir))))
        {
          (let blobs (readArchives paths))
          (groundEachSpanned names blobs paths decls units dfmt 0)
        }
      })
  })

(pub :: existingPaths (-> Strings Strings))
;@axiom:effect(io)
(pub fn (existingPaths paths)
  {
    (let out vecNew)
    {
      (for i in 0..(vecLen paths)
        (if (fileExists (vecGet paths i))
          (vecPush out (vecGet paths i))))
      out
    }
  })

(pub :: groundEachSpanned (-> Strings Strings Strings (Vec ASTNode) Units Int Int Int))
;@axiom:effect(io)
(pub fn (groundEachSpanned names blobs paths decls units dfmt i)
  (if (>= i (vecLen names))
    0
    {
      (let n (vecGet names i))
      (if (symbolGrounded blobs n 0)
        ; grounded: now the SHAPE. A shim `#[axiom_export]` writes
        ; also exports `<sym>__sig_<params>_<ret>`, a no-op whose
        ; name spells the shim's arity and word kinds (i: a word,
        ; f: Float bits, s: a String, c: a callback), and the item's
        ; declared type spells the same string here; a difference
        ; is AX4005 at the item - a two-argument declaration over a
        ; three-argument shim would build, link and answer garbage
        {
          (let want
            (match (findExternItem decls n 0)
              ((None) None)
              ((Some item) (externSigTag (nodeBChild item)))))
          (let have (descriptorsOf blobs n))
          (match want
            ((None) (groundEachSpanned names blobs paths decls units dfmt (+ i 1)))
            ((Some want)
              (if (|| (== (vecLen have) 0) (>= (strIndexIn have want) 0))
                (groundEachSpanned names blobs paths decls units dfmt (+ i 1))
                {
                  (let item (findExternItem decls n 0))
                  {
                    (let d
                      (mkDiag SEV_ERROR "AX4005" "extern-shape"
                        (match item
                          ((None) 0)
                          ((Some item) (nodeSpan item)))
                        (concat (concat "`" (concat n "` is exported by the crate for "))
                          (concat
                            (concat (sigTagSpelled (vecGet have 0))
                              (concat "; the `extern` item declares " (sigTagSpelled want)))
                            ""))
                        None
                        (Some
                          "the Rust shim and the `extern` item must agree on every parameter and the result (docs/ffi.md, the type table); regenerate the binding module with `axiom-bindgen`, or fix the hand-written item")))
                    (let ds vecNew)
                    {
                      (if (let (Some u) (findExternUnit decls n units))
                        (diagSetUnit d u)
                        ())
                      (vecPush ds d)
                      {
                        (let out
                          (renderDiagsFormat dfmt ds
                            (if (isNone item)
                              {
                                (let uv vecNew)
                                {
                                  (vecPush uv
                                    (CUnit2
                                      :file "<link>"
                                      :src ""
                                      :name None
                                      :imports vecNew
                                      :library false))
                                  uv
                                }
                              }
                              units)))
                        (writeStr stderr out)
                      }
                      exitToolFailed
                    }
                  }
                })
            ))
        }
        ; the item's span is in ITS module's unit - an
        ; imported binding module, usually
        {
          (let item (findExternItem decls n 0))
          (let lib
            (match (findExternLib decls n 0)
              ((None) "")
              ((Some library) library)))
          {
            (let msg
              (if (== (vecLen paths) 0)
                (concat "no archive is linked, and `" (concat n "` needs one"))
                (concat "no linked archive defines `" (concat n "`"))))
            (let help
              (if (== (vecLen paths) 0)
                (concat
                  "pass `--link-lib NAME --link-search DIR` where DIR holds `libNAME.a`, or set `AXIOM_LINK_SEARCH` to the directory; the `extern` block names library \""
                  (concat lib
                    "\", and `axiom build` links `lib<name>.a` by itself when a search directory holds it (an `AXIOM_PATH` entry's `../target/release` is searched too)"))
                {
                  (let near (closestFfiName (archiveFfiNames blobs) n))
                  (concat (concat "searched: " (concat (strJoin paths ", ") "; "))
                    (concat
                      (if (== (strLen near) 0)
                        "check the `(symbol \"...\")` clause against the crate's `#[axiom_export]` names"
                        (concat "did you mean `" (concat near "`?")))
                      ""))
                }))
            {
              (let d
                (mkDiag SEV_ERROR "AX4004" "ungrounded-symbol"
                  (match item
                    ((None) 0)
                    ((Some item) (nodeSpan item)))
                  msg None (Some help)))
              (let ds vecNew)
              {
                (if (let (Some u) (findExternUnit decls n units))
                  (diagSetUnit d u)
                  ())
                (vecPush ds d)
                {
                  (let out
                    (renderDiagsFormat dfmt ds
                      (if (isNone item)
                        {
                          (let u vecNew)
                          {
                            (vecPush u
                              (CUnit2
                                :file "<link>"
                                :src ""
                                :name None
                                :imports vecNew
                                :library false))
                            u
                          }
                        }
                        units)))
                  (writeStr stderr out)
                }
                exitToolFailed
              }
            }
          }
        })
    }))

; The index in `units` of the module that declares `sym`, or `None`.
; The entry file's declarations have no module (0) and sit at unit 0.
;
; The recursive lookup preserves absence and the valid entry index 0.
(pub :: findExternUnit (-> (Vec ASTNode) String Units (Option Int)))
(pub fn (findExternUnit decls sym units)
  (findExternUnitFrom decls sym units 0))

(:: findExternUnitFrom (-> (Vec ASTNode) String Units Int (Option Int)))
(fn (findExternUnitFrom decls sym units i)
  (if (>= i (vecLen decls))
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_EXTERN) (isSome (findExternItemIn (nodeCChildren d) sym 0)))
        (match (nodeModuleOpt d)
          ((None) (Some 0))
          ((Some name) (unitIndexOf units name 0)))
        (findExternUnitFrom decls sym units (+ i 1)))
    }))

; The descriptor string an extern item's declared type spells:
; `<params>_<ret>`, one tag per parameter, the result after the
; underscore. Mirrors rust/axiom-ffi-classify.
(pub :: externSigTag (-> ASTNode (Option String)))
(pub fn (externSigTag ty)
  (if (nodeSame ty nilNode)
    None
    (Some
      (concat
        (sigParamTags ty)
        (concat
          "_"
          (match (sigResultOf ty)
            ; A malformed arrow's missing result keeps the legacy word tag.
            ((None) "i")
            ((Some result) (sigTagOf result))))))))

(pub :: sigParamTags (-> ASTNode String))
(pub fn (sigParamTags ty)
  (if (&& (! (nodeSame ty nilNode)) (== (nodeTag ty) TAG_T_ARR))
    (concat (sigTagOf (nodeAChild ty)) (sigParamTags (nodeBChild ty)))
    ""))

(pub :: sigResultOf (-> ASTNode (Option ASTNode)))
(pub fn (sigResultOf ty)
  (if (nodeSame ty nilNode)
    None
    (if (== (nodeTag ty) TAG_T_ARR)
      (sigResultOf (nodeBChild ty))
      (Some ty))))

(pub :: sigTagOf (-> ASTNode String))
(pub fn (sigTagOf t)
  (if (nodeSame t nilNode)
    "i"
    (if (== (nodeTag t) TAG_T_ARR)
      "c"
      (if (== (nodeTag t) TAG_T_CON)
        {
          (let n (nodeAName t))
          (if (strEq n "Float")
            "f"
            (if (strEq n "String")
              "s"
              "i"))
        }
        "i"))))

; Every `<sym>__sig_...` name an archive holds, as the part after
; `__sig_`.
(pub :: descriptorsOf (-> Strings String Strings))
(pub fn (descriptorsOf blobs sym)
  {
    (let out vecNew)
    (let prefix (concat sym "__sig_"))
    {
      (for i in 0..(vecLen blobs)
        (collectPrefixed (vecGet blobs i) prefix out 0))
      out
    }
  })

(pub :: collectPrefixed (-> String String Strings Int Int))
(pub fn (collectPrefixed blob prefix out from)
  (if (let (Some at) (strFindSub blob prefix from))
    (if (let (Some end) (strFindByte blob 0 at))
      {
        {
          (let tail (strSlice blob (+ at (strLen prefix)) (- end (+ at (strLen prefix)))))
          (if (&& (< (strLen tail) 80) (== (strIndexIn out tail) (- 0 1)))
            (vecPush out tail))
        }
        (collectPrefixed blob prefix out end)
      }
      0)
    0))

; `ii_i` spelled as a developer reads it: `(-> Int Int Int)`.
(pub :: sigTagSpelled (-> String String))
(pub fn (sigTagSpelled tag)
  (if (let (Some us) (strFindByte tag 95 0))
    {
      (let ps (strSlice tag 0 us))
      (let r (strSlice tag (+ us 1) (- (strLen tag) (+ us 1))))
      (if (== (strLen ps) 0)
        (concat "`" (concat (tagWord r) "` (nullary)"))
        (concat "`(-> " (concat (concat (tagWords ps 0) (tagWord r)) ")`")))
    }
    (concat "`" (concat tag "`"))))

(pub :: tagWords (-> String Int String))
(pub fn (tagWords ps i)
  {
    (let out (strBuilderNew))
    {
      (for k in i..(strLen ps)
        {
          (strBuilderPush out (tagWord (strSlice ps k 1)))
          (strBuilderPush out " ")
        })
      (strBuilderFinish out)
    }
  })

(pub :: tagWord (-> String String))
(pub fn (tagWord t)
  (if (strEq t "f")
    "Float"
    (if (strEq t "s")
      "String"
      (if (strEq t "c")
        "(-> Int ...)"
        "Int"))))

; The extern item binding linker symbol `sym`, or None.
(pub :: findExternItem (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (findExternItem decls sym i)
  (if (>= i (vecLen decls))
    None
    {
      (let d (vecGet decls i))
      (if (== (nodeTag d) TAG_D_EXTERN)
        (match (findExternItemIn (nodeCChildren d) sym 0)
          ((None) (findExternItem decls sym (+ i 1)))
          ((Some item) (Some item)))
        (findExternItem decls sym (+ i 1)))
    }))

(pub :: findExternItemIn (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (findExternItemIn items sym i)
  (if (== (as items Int) 0)
    None
    (if (>= i (vecLen items))
      None
      (if (strEq (nodeCName (vecGet items i)) sym)
        (Some (vecGet items i))
        (findExternItemIn items sym (+ i 1))))))

(pub :: findExternLib (-> (Vec ASTNode) String Int (Option String)))
(pub fn (findExternLib decls sym i)
  (if (>= i (vecLen decls))
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_EXTERN) (isSome (findExternItemIn (nodeCChildren d) sym 0)))
        (Some (nodeAName d))
        (findExternLib decls sym (+ i 1)))
    }))

; 0 when every declare is grounded; otherwise the build's exit code,
; having reported the FIRST ungrounded symbol.
(pub :: groundDeclares (-> String Strings Int))
;@axiom:effect(io)
(pub fn (groundDeclares ir linkArgs)
  {
    (let names (declareNamesOf ir))
    (if (== (vecLen names) 0)
      0
      {
        (let blobs (readArchives (archivePathsOf linkArgs (irTargetIsWindows ir))))
        (groundEach names blobs 0)
      })
  })

(pub :: groundEach (-> Strings Strings Int Int))
;@axiom:effect(io)
(pub fn (groundEach names blobs i)
  (if (>= i (vecLen names))
    0
    {
      (let n (vecGet names i))
      (if (symbolGrounded blobs n 0)
        (groundEach names blobs (+ i 1))
        (buildFailDiag "AX4004" "ungrounded-symbol"
          (concat "no archive on the link line defines `" (concat n "`"))
          "check the `(symbol \"...\")` clause against the crate, and check that `--link-lib`/`--link-search` name the archive defining it; this is refused here rather than in `opt` or `cc` because a linker error about generated code cannot point at the declaration that caused it"))
    }))

; ------------------------------------------------------------------
; Codegen units: for a large module, the IR is optimised whole,
; then `llvm-split` partitions it and `llc` assembles the parts
; concurrently, and a single `cc` links the objects - the shape of
; rustc's codegen units, at the toolchain level. Optimising first
; keeps inlining whole-module (measured: splitting first made the
; built compiler 85% slower at checking its own source).
; AXIOM_CODEGEN_JOBS names
; the part count: unset means 4, 1 or 0 means the serial path, and
; anything unparsable means 4. Only the plain hosted link is
; eligible; Windows, baremetal, staticlib and obfuscated builds keep
; the serial path, as does any module of 4 MiB or less. A missing
; `llvm-split` also falls back, silently: the serial path is always
; available and always correct.
; ------------------------------------------------------------------
(:: cgJobsParse (-> String Int Int Int))
(fn (cgJobsParse s i acc)
  (if (>= i (strLen s))
    acc
    {
      (let c (strByte s i))
      (if (|| (< c 48) (> c 57))
        -1
        (cgJobsParse s (+ i 1) (+ (* acc 10) (- c 48))))
    }))

(:: cgJobs Int)
;@axiom:effect(io)
(fn (cgJobs)
  {
    (let text (sysEnv "AXIOM_CODEGEN_JOBS"))
    (if (== (strLen text) 0)
      4
      {
        (let n (cgJobsParse text 0 0))
        (if (< n 0)
          4
          n)
      })
  })

(:: splitPartPath (-> String Int String))
(fn (splitPartPath stem i)
  (concat stem (concat ".part" (fmtIntStr i))))

; Resolve `tool` on PATH, answering None when it is not there: the
; spawn primitives take a path, and the search is `sysRunPath`'s.
(:: resolveTool (-> String (Option String)))
;@axiom:effect(io)
(fn (resolveTool name)
  (if (isSome (strFind name "/" 0))
    (Some name)
    (resolveToolIn name (sysEnv "PATH") 0)))

(:: resolveToolIn (-> String String Int (Option String)))
;@axiom:effect(io)
(fn (resolveToolIn name path from)
  (if (>= from (strLen path))
    None
    {
      (let colon (strFind path ":" from))
      (let end
        (if (let (Some c) colon)
          c
          (strLen path)))
      {
        (let dir (strSlice path from (- end from)))
        (let cand
          (if (== (strLen dir) 0)
            name
            (concat dir (concat "/" name))))
        (if (fileExists cand)
          (Some cand)
          (resolveToolIn name path (+ end 1)))
      }
    }))

(data ToolLaunchError
  (ToolMissing)
  (ToolSpawnError Error))

(data ToolExit
  (ToolExited Int)
  (ToolSignalled Int))

(data PhaseFailureReason
  (PhaseLaunchFailure ToolLaunchError)
  (PhaseWaitFailure Error)
  (PhaseExitFailure Int)
  (PhaseSignalFailure Int))

(struct PhaseFailure
  (part : Int)
  (reason : PhaseFailureReason))

; Spawn `tool` with `args`, preserving a missing path or spawn error.
; The argv buffer is `runTool`'s shape.
(:: spawnTool (-> String Strings (Result Int ToolLaunchError)))
;@axiom:effect(io)
;@axiom:effect(spawn)
(fn (spawnTool tool args)
  (if (let (Some path) (resolveTool tool))
    {
      (let n (vecLen args))
      {
        (let v (memAlloc (* (+ n 2) 8)))
        {
          (memSetWord v 0 (strCStr (strDup path)))
          (fillArgv v args 0 n)
          (memSetWord v (+ n 1) 0)
          (match (sysSpawn (strCStr (strDup path)) v sysEnvp)
            ((Err e) (Err (ToolSpawnError e)))
            ((Ok pid) (Ok pid)))
        }
      }
    }
    (Err ToolMissing)))

; Keep normal exit, signal termination and a failed wait distinct.
; An interrupted wait is retried before the child can be cleaned up.
(:: waitTool (-> Int (Result ToolExit Error)))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (waitTool pid)
  (match (sysWaitPid pid)
    ((Err e)
      (if (== (errCode e) 4)
        (waitTool pid)
        (Err e))
    )
    ((Ok st)
      (Ok
        (if (!= (sysTermSignal st) 0)
          (ToolSignalled (sysTermSignal st))
          (ToolExited (sysExitCode st))))
    )))

; Launch in part order and retain each result, including failed starts.
; The module was optimised whole before splitting.
(:: spawnPhase (-> String Int Int Int (Vec (Result Int ToolLaunchError)) ()))
;@axiom:effect(io)
;@axiom:effect(spawn)
(fn (spawnPhase stem lvl i jobs launches)
  (if (< i jobs)
    {
      (let part (splitPartPath stem i))
      (vecPush launches
        (spawnTool "llc"
          (vecOf6 part "-filetype=obj" "-o" (concat part ".o") (concat "-O" (fmtIntStr lvl))
            llcRelocArg)))
      (spawnPhase stem lvl (+ i 1) jobs launches)
    }))

; Wait every launched child before returning the earliest failing part.
; A launch failure prevents linking but cannot skip later child waits.
(:: waitPhase (-> (Vec (Result Int ToolLaunchError)) Int Int (Option PhaseFailure)))
;@axiom:effect(io)
;@axiom:effect(block)
(fn (waitPhase launches i jobs)
  {
    (let mut first (:: None (Option PhaseFailure)))
    (for part in i..jobs
      {
        (let failure
          (match (vecGet launches part)
            ((Err e) (Some (PhaseFailure :part part :reason (PhaseLaunchFailure e))))
            ((Ok pid)
              (match (waitTool pid)
                ((Err e) (Some (PhaseFailure :part part :reason (PhaseWaitFailure e))))
                ((Ok result)
                  (match result
                    ((ToolExited code)
                      (if (== code 0)
                        None
                        (Some (PhaseFailure :part part :reason (PhaseExitFailure code))))
                    )
                    ((ToolSignalled signal)
                      (Some (PhaseFailure :part part :reason (PhaseSignalFailure signal)))
                    ))
                ))
            )))
        (if (isNone first)
          (set first failure))
      })
    first
  })

(:: vecOf6 (-> String String String String String String Strings))
(fn (vecOf6 a b c d e f)
  {
    (let v vecNew)
    {
      (vecPush v a)
      (vecPush v b)
      (vecPush v c)
      (vecPush v d)
      (vecPush v e)
      (vecPush v f)
      v
    }
  })

(:: splitCleanup (-> String Int Int Int))
;@axiom:effect(io)
(fn (splitCleanup stem jobs i)
  (if (>= i jobs)
    0
    {
      (let part (splitPartPath stem i))
      {
        (unwrapOr (removeFile part) 0)
        (unwrapOr (removeFile (concat part ".opt")) 0)
        (unwrapOr (removeFile (concat part ".o")) 0)
        (unwrapOr (removeFile (concat part ".llc-err")) 0)
        (splitCleanup stem jobs (+ i 1))
      }
    }))

(:: splitLinkArgs (-> String Int Int Strings Strings))
(fn (splitLinkArgs stem jobs i acc)
  (if (>= i jobs)
    acc
    {
      (vecPush acc (concat (splitPartPath stem i) ".o"))
      (splitLinkArgs stem jobs (+ i 1) acc)
    }))

(pub data SplitBuildResult
  (SplitUnavailable)
  (SplitFinished (Result () Int)))

; Split the already-optimised module, assemble the parts in
; parallel, then link. SplitUnavailable selects the serial fallback;
; SplitFinished holds success or the reported CLI failure status. Optimising before the split keeps every
; inlining decision whole-module: the objects answer what the
; serial path's optimiser produced, only assembled concurrently.
(pub :: buildSplit (-> String String String String Int Strings SplitBuildResult))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (buildSplit ir llPath stem outPath optLevel linkArgs)
  {
    (let jobs (cgJobs))
    (let lvl
      (if (> optLevel 3)
        3
        (if (< optLevel 0)
          0
          optLevel)))
    {
      (let sargs
        {
          (let v vecNew)
          {
            (vecPush v (concat "-j=" (fmtInt jobs)))
            (vecPush v "-o")
            (vecPush v (concat stem ".part"))
            (vecPush v llPath)
            v
          }
        })
      {
        (let splitRc (runTool "llvm-split" sargs))
        (if (isErr splitRc)
          SplitUnavailable
          (if (! (toolSucceeded splitRc))
            {
              (splitCleanup stem jobs 0)
              (SplitFinished
                (Err
                  (toolFailDiag "llvm-split failed"
                    "`llvm-split` partitions the module for parallel code generation; it ships with LLVM - or set AXIOM_CODEGEN_JOBS=1 for the serial path")))
            }
            {
              (let launches vecNew)
              {
                (spawnPhase stem lvl 0 jobs launches)
                (if (let (Some failure) (waitPhase launches 0 jobs))
                  {
                    (let report
                      (toolFailDiag "llc failed"
                        "one of the split parts was rejected by `llc`; set AXIOM_CODEGEN_JOBS=1 for the serial path"))
                    {
                      (splitCleanup stem jobs 0)
                      (SplitFinished (Err report))
                    }
                  }
                  {
                    (let ccArgs
                      {
                        (let v (splitLinkArgs stem jobs 0 vecNew))
                        {
                          (appendLinkArgs v linkArgs)
                          (vecPush v "-o")
                          (vecPush v outPath)
                          v
                        }
                      })
                    {
                      (let rc2 (runTool "cc" ccArgs))
                      {
                        (splitCleanup stem jobs 0)
                        (if (! (toolSucceeded rc2))
                          (SplitFinished
                            (Err
                              (toolFailDiag
                                (toolFailureMessage rc2 "could not run `cc`" "cc failed")
                                "a C compiler drives the link step; put `cc` on PATH")))
                          (SplitFinished (Ok ())))
                      }
                    }
                  })
              }
            }))
      }
    }
  })

; Write `ir` beside `outPath`, drive the toolchain, and clean up.
;
; Intermediates are removed on the FAILURE paths too, which is stage0's
; behaviour and the reason its cleanup runs before the error is
; propagated: a failed build that leaves a `.o` behind makes the next
; one ambiguous. `keepLl` is `--emit-llvm`, and preserves the
; PRE-`opt` IR - also stage0's choice, and worth knowing before writing
; a gate that greps it, since it is the optimiser's input rather than
; what llc consumed.
(pub :: buildToExecutable (-> String String Int Int Strings Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (buildToExecutable ir outPath optLevel keepLl linkArgs)
  ; Grounding FIRST, before a byte is written or a tool is spawned: an
  ; ungrounded symbol is a defect in the program, and reporting it after
  ; `opt` has already refused the module reports the wrong thing.
  {
    (let ug (groundDeclares ir linkArgs))
    (if (!= ug 0)
      ug
      ; `.exe` for a Windows module, appended HERE and nowhere else -
      ; unless the caller already spelled it. The intermediates keep
      ; `outPath`'s stem either way, so `--emit-llvm` leaves `<out>.ll`
      ; beside `<out>.exe` rather than `<out>.exe.ll`.
      {
        (let winTarget (irWindowsTarget ir))
        (let isWin (irTargetIsWindows ir))
        (let isBaremetal (irTargetIsBaremetal ir))
        (let llPath (concat outPath ".ll"))
        (let objPath (concat outPath ".o"))
        (let optPath (concat outPath ".opt.ll"))
        {
          (let exePath
            (if (&& isWin (!= (endsWithExe outPath) 1))
              (concat outPath ".exe")
              outPath))
          (if (isErr (writeFile llPath ir))
            (toolFailDiag "could not write LLVM IR"
              "check that the output directory exists and is writable")
            (match (runOpt llPath optLevel optPath)
              ((Err status)
                {
                  (unwrapOr (removeFile llPath) 0)
                  (toolFailDiag "opt failed"
                    "`opt` is optional - a PATH without it warns and builds - so this is a failure of the one that is installed")
                }
              )
              ((Ok toAssemble)
                {
                  (let splitResult
                    (if (&& (> (cgJobs) 1)
                          (&& (> (strLen ir) 4194304)
                            (&& (== (strLen winTarget) 0)
                              (&& (! isBaremetal)
                                (&& (! cgStaticlib)
                                  (! (hasFlagAnywhere subcommandName "--obfuscate")))))))
                      (buildSplit ir toAssemble (concat outPath ".split") exePath optLevel linkArgs)
                      SplitUnavailable))
                  (match splitResult
                    ((SplitFinished result)
                      {
                        (if (!= (strCmp toAssemble llPath) 0)
                          (unwrapOr (removeFile optPath) 0))
                        (if (== keepLl 0)
                          (unwrapOr (removeFile llPath) 0))
                        (match result
                          ((Ok _) 0)
                          ((Err status) status))
                      }
                    )
                    ((SplitUnavailable)
                      {
                        (let rc
                          (assembleAndLink ir toAssemble objPath exePath optLevel linkArgs
                            winTarget isBaremetal))
                        {
                          (unwrapOr (removeFile objPath) 0)
                          (if (!= (strCmp toAssemble llPath) 0)
                            (unwrapOr (removeFile optPath) 0))
                          (if (== keepLl 0)
                            (unwrapOr (removeFile llPath) 0))
                          rc
                        }
                      }
                    ))
                }
              )))
        }
      })
  })

; Does `p` already end in `.exe`? 1 or 0, so the test above reads as
; the others in this file do.
(pub :: endsWithExe (-> String Int))
(pub fn (endsWithExe p)
  (if (< (strLen p) 4)
    0
    (if (strEq (strSlice p (- (strLen p) 4) 4) ".exe")
      1
      0)))

; What a build for this compiler's own host appends to an output name:
; `.exe` on Windows, where `buildToExecutable` adds it, and nothing
; elsewhere. `run` and `test` launch the file they built by this name.
(pub :: hostExeSuffix String)
(pub fn (hostExeSuffix)
  (if (strStartsWith hostTarget "windows-")
    ".exe"
    ""))

(pub :: writeStderrStr (-> String Int))
; Every byte, not the first `write`'s worth: a diagnostic cut short by a
; full pipe is the silent truncation `IO`'s write loop exists to stop.
;@axiom:effect(io)
(pub fn (writeStderrStr s)
  (writeStr stderr s))

; Decimal rendering of a small non-negative int, for `-O<n>`.
;
; `Fmt` is not imported here: the compiler's own modules keep their
; import surface small, and the only numbers this module renders are 0
; through 3.
(pub :: fmtIntStr (-> Int String))
(pub fn (fmtIntStr n)
  (if (== n 0)
      "0"
    (== n 1)
      "1"
    (== n 2)
      "2"
    (== n 3)
      "3"
    "1"))

; ------------------------------------------------------------------
; Argument parsing.
; ------------------------------------------------------------------
(pub :: isSubcommand (-> String Bool))
(pub fn (isSubcommand a)
  (match a
    ("build" true)
    ("lsp" true)
    ("check" true)
    ("run" true)
    ("test" true)
    ("emit-llvm" true)
    ("fmt" true)
    ("explain" true)
    ("symbols" true)
    ("doc" true)
    ("repl" true)
    ("new" true)
    ("fetch" true)
    ("version" true)
    ("--version" true)
    ("-V" true)
    ("help" true)
    ("--help" true)
    ("-h" true)
    (_ false)))

; `--help` has to be recognised as a subcommand rather than parsed as a
; flag: the scan that lets global options precede a subcommand skips
; anything beginning with `-`, so `--help` was skipped, no positional
; remained, and the compiler fell back to reading `in.ax` and reported
; `cannot read input`. A compiler whose --help is an obscure file error
; is a compiler nobody gets past.
(pub :: usageText String)
(pub fn (usageText)
  (concat (concat "Axiom " axiomVersion)
    "\n\nUSAGE:\n  axiom [OPTIONS] <COMMAND> [ARGS]\n\nCOMMANDS:\n  build      compile a source file to an executable\n  check      check syntax and types, emitting no code\n  run        compile and run, forwarding further arguments\n  new        start a project with Main.ax and axiom.pkg\n  fetch      check out the project's registry dependencies\n  test       run every test-named function in a file or directory\n  emit-llvm  print the generated LLVM IR\n  fmt        format source files in place\n  explain    describe a diagnostic code\n  symbols    list top-level symbols in AXSYM\n  doc        render the docs and the library reference in your browser\n  repl       start the interactive read-eval-print loop\n  lsp        run the language server on stdin/stdout\n  version    print the version\n  help       print help, or help <COMMAND> for one command\n\nOPTIONS:\n  --obfuscate        mask literals, scramble symbols and obscure entries\n  --input <PATH>     input file (build, check, run, emit-llvm)\n  --output <PATH>    output file (build, emit-llvm)\n  -o <PATH>          short for --output\n  --target <NAME>    target platform; see the list below (default: host)\n  --opt <0-3>        optimisation (build, run, test; default: manifest opt, else 1)\n  --heap-ceiling <BYTES>  fixed heap size (build, run, test)\n  --alloc-poison    overwrite reusable freed payloads for memory debugging\n  --filter <TEXT>    run tests whose names contain TEXT (test)\n  --crate <DIR>      generate bindings and link a Rust crate; repeatable\n  --link-lib <NAME>  link an FFI archive; repeatable (build, run)\n  --link-search <DIR>  archive search directory; repeatable (build, run)\n  --emit-llvm        keep generated .ll beside the executable (build)\n  --emit-staticlib   write a static archive (build)\n  --threads          use platform threads for parallel (build, run, test)\n  --emit-rust-binding <PATH>  write host bindings with --emit-staticlib\n  --check            report formatting without writing (fmt)\n  --diff             print a unified formatting diff without writing (fmt)\n  --emit <files|stdout>  choose formatted output (fmt; default files)\n  --builtins         include built-in operators (symbols)\n  --calls            include resolved call edges (symbols)\n  --mir              include region facts (symbols)\n  --axir             read or write .axir records instead of AXSYM (symbols)\n  --list             list diagnostic codes (explain)\n  --no-banner        skip the startup banner (repl)\n  --out <DIR>        where doc writes its pages (doc)\n  --no-open          render without opening a browser (doc)\n  --missing          list public names with no doc comment (doc)\n  --diagnostic-format <human|ai|json>  diagnostic renderer (default: human)\n  -h, --help         print help; accepted before or after the file\n  -V, --version      print the version; before the command\n  --                 end compiler options\n\nTARGETS:\n  Supported: darwin-aarch64, linux-aarch64.\n  Source-only: darwin-x86_64, freebsd-aarch64, freebsd-x86_64,\n               linux-x86_64, windows-aarch64, windows-x86_64,\n               baremetal-aarch64.\n\nNOTES:\n  A bare input path works wherever --input is accepted. Build output\n  defaults to the manifest's name, else output. Windows adds .exe once.\n\n  --crate searches DIR/axiom for modules and DIR/target/release for\n  archives. Archives also use AXIOM_LINK_SEARCH and each AXIOM_PATH\n  entry's ../target/release. An extern library links when found there.\n\n  Static archives need no main; pub functions become C symbols.\n  --mir forces a slower facts fixpoint; --axir --mir includes lowered\n  bodies. Use --diagnostic-format=ai for AXSYM; JSON symbols are refused.\n\n  Threads work on darwin and linux. FreeBSD uses processes and refuses\n  --threads (AX4006). Windows warns AX4007 and spawning exits with 79.\n  Heap exhaustion exits with 70; threaded spawning with a fixed heap\n  is refused (AX4006). Source-only targets are emitted and assembled,\n  executed by no runner; see README, Targets.\n\n  Human diagnostics always include colour, even in redirected output.\n  AI and JSON diagnostics have no colour escapes.\n\nEXIT CODES:\n  0  success\n  1  the program is wrong: unreadable input, syntax or checking failure,\n     a failed test, a missing entry point, or an unresolvable import\n  2  the command line is wrong: unknown command or flag, or flag arity\n  3  a module could not be read or parsed, or the target is unknown\n  4  a native tool failed or is missing (llc, cc; lld-link for Windows)\n"))

; One command's help: its synopsis and the flags it actually reads.
;
; `--help` is recognised in any position (`helpFlagPresent`), so
; `axiom build --help` answers this rather than `build needs an input
; file`, `axiom fmt FILE --help` does not rewrite FILE, and
; `axiom repl --help` does not start the REPL.
;
; A synopsis and a flag list rather than a page of prose: the flags are
; the part a reader cannot guess, and check-driver.sh asserts that every
; flag the table accepts appears in `axiom --help`, so the two cannot
; drift apart silently.
(pub :: helpForCommand (-> String String))
(pub fn (helpForCommand c)
  (if (strEq c "build")
    "axiom build - compile a source file to an executable\n\nUSAGE:\n  axiom build [--input] <FILE> [--output <PATH>] [--opt <0-3>] [--emit-llvm] [--obfuscate]\n  axiom build                                  (in a project directory)\n\n  With no FILE, the project's entry is built: the manifest's `main`,\n  else `Main.ax` beside the nearest `axiom.pkg` at or above the\n  working directory - and the executable takes the manifest's `name`.\n\n  --input <PATH>   the source file; a bare path works too\n  --output <PATH>  where to write the executable (default: the `name` in\n                   the project's `axiom.pkg`, else `output`)\n  -o <PATH>        short for --output\n  --opt <0-3>      optimisation level (default 1, or the manifest's `opt`)\n  --emit-llvm      keep the generated .ll beside the executable\n  --alloc-poison   overwrite reusable freed payloads for memory debugging\n"
    (if (strEq c "check")
      "axiom check - check syntax and types, emitting no code\n\nUSAGE:\n  axiom check <FILE>\n\nPrints `OK` and exits 0 when the module checks. Warnings are reported\nand do not fail. A module with no `main` checks clean: only `build`\nand `run` need an entry point.\n"
      (if (strEq c "run")
        "axiom run - compile a source file and run it\n\nUSAGE:\n  axiom run <FILE> [ARGS...]\n  axiom run [-- ARGS...]                       (in a project directory)\n\nWith no FILE, the project's entry runs: the manifest's `main`, else\n`Main.ax` beside the nearest `axiom.pkg` at or above the working\ndirectory. Program arguments follow `--`; without it nothing is\nforwarded. A bare operand is always a FILE, never an argument.\n\nEverything after FILE is passed to the program, not read by the\ncompiler. Use `--` before an argument that begins with a dash. The\nprogram's own exit status becomes this command's.\n\n  --opt <0-3>      optimisation level (default 1, or the manifest's `opt`)\n"
        (if (strEq c "test")
          "axiom test - run every `test`-named function in a file or directory\n\nUSAGE:\n  axiom test <FILE|DIR> [--filter <TEXT>] [--jobs <N>] [--opt <0-3>]\n\nA test is a top-level function whose name begins with `test` and which\ntakes no parameters. Nothing else is discovered, and a `test`-named\nfunction that takes parameters is refused rather than skipped.\n\nEach test runs inside its own recovery point, so a failing assertion,\nan unhandled effect, an allocation failure or a division by zero ends\nthat test and no other. Assertions are `stdlib/Test.ax`.\n\nDIR runs every `.ax` file directly inside it, in name order.\n\n  --filter <TEXT>  run only the tests whose name contains TEXT\n  --jobs <N>       with DIR, run up to N files at once, in child\n                   processes, and report them in name order (default 1)\n  --opt <0-3>      optimisation level (default 1, or the manifest's `opt`)\n\nExit 0 when every test passed, 1 when any failed or none was found.\n"
          (if (strEq c "emit-llvm")
            "axiom emit-llvm - print the generated LLVM IR\n\nUSAGE:\n  axiom emit-llvm <FILE> [-o <PATH>]\n\n  --output <PATH>  write the IR to PATH instead of stdout\n  -o <PATH>        short for --output\n\nA module with no `main` is fine here: no executable is produced.\n"
            (if (strEq c "fmt")
              "axiom fmt - format source files with one canonical layout\n\nUSAGE:\n  axiom fmt <FILE>... [--check | --diff]\n  axiom fmt --emit stdout <FILE>\n  axiom fmt -\n\n  --check   report formatting without writing; exit 1 if files would change\n  --diff    print a unified diff without writing; exit 1 if files would change\n  --emit <files|stdout>  write files or print one formatted source (default files)\n  -         read stdin and print formatted source\n\nEvery batch input is verified before any file is written. Comments and\nliteral values are preserved, and output is a fixed point. A formatting\nrefusal leaves the batch untouched. Unchanged files are not rewritten.\nMissing closing parens are completed when the result remains unambiguous.\n"
              (if (strEq c "explain")
                "axiom explain - describe a diagnostic code\n\nUSAGE:\n  axiom explain <CODE>\n  axiom explain --list\n\nCODE may be written `AX3001`, `3001` or `ax-3001`.\n\n  --list    list every known code instead\n"
                (if (strEq c "symbols")
                  "axiom symbols - list every top-level symbol, in AXSYM\n\nUSAGE:\n  axiom symbols <FILE> [--builtins] [--calls] [--mir]\n  axiom symbols --axir <FILE>\n  axiom symbols --axir <FILE.axir>\n\n  --builtins   also list the always-in-scope operators\n  --calls      also print each function's resolved call edges, `#calls=`\n  --mir        also print each function's region-facts summary:\n               `#mir-params=`, `#mir-escapes=`, `#mir-result-fresh`,\n               `#mir-result-from=`, and the two honesty sentinels\n               `#mir-incomplete` (this body called something the walk\n               could not resolve) and `#mir-truncated` (the module's\n               facts fixpoint stopped at its round cap, so every row\n               is a lower bound). THIS FLAG IS SLOW: it forces a walk\n               that otherwise never runs at all, measured 0.72s to\n               21.7s on the compiler's own sources.\n  --axir       emit the `.axir` record file instead of AXSYM. One\n               record per function - the AXSYM `F` header tuple\n               verbatim, then `sig`, `param` and, under --mir, the\n               raw `region` words followed by the function's `blk`,\n               `op` and `term` lines: the mid-level IR of\n               `core/mir.ax`, one line per block, instruction\n               and terminator. A function whose body is outside that\n               lowering's subset carries no body rather than a\n               partial one. Given a file whose first line is\n               `axir 1 ...` it reads that back and re-emits it, which\n               is the round trip the gate measures.\n\nTwo renderings, chosen by --diagnostic-format: `human` (the default)\nprints an aligned table of kind, name, type and location; `ai` prints\nAXSYM itself, which is the same facts plus each symbol's nid and its\nmetadata - `#effects=`, `#effect-params=`, `#effects-incomplete` and\nany AXTAG. `json` is refused; use --diagnostic-format=ai for AXSYM.\n`--axir` has one rendering, with `human` or `ai`.\n"
                  (if (strEq c "doc")
                    "axiom doc - render the documentation and the library reference, and open them\n\nUSAGE:\n  axiom doc [FILE.ax ...] [FILE.md ...] [--out <DIR>] [--no-open]\n  axiom doc [FILE.ax ...] --missing\n\nRenders every page under docs/, README.md, CONTRIBUTING.md,\nCHANGELOG.md and examples/README.md, one page per standard library\nmodule, and the language index, as HTML with one stylesheet, then\nopens index.html in your browser. A FILE.ax operand is rendered as a\nmodule page beside the library's; a FILE.md operand as a page beside\nthe docs.\n\nThe documentation set is found through AXIOM_DOC, a directory holding\ndocs/, else beside the compiler: an install's prefix or a source\ncheckout. A release archive carries docs/, README.md and\nCHANGELOG.md; a checkout has the whole set.\n\n  --out <DIR>   write the pages to DIR (default: $XDG_CACHE_HOME/axiom/doc,\n                else ~/.cache/axiom/doc, else $TMPDIR/axiom-doc)\n  --no-open     render, print the index's path and do not open it\n  --missing     render nothing; list every public declaration of the\n                library (or of the FILE.ax operands) with no `;;` doc\n                comment as `path:line: name`, and exit 1 when there are any\n\nExit 1 when no documentation set is found or the output directory\ncannot be written.\n"
                    (if (strEq c "repl")
                      "axiom repl - the interactive read-eval-print loop\n\nUSAGE:\n  axiom repl [--no-banner]\n\n  --no-banner   skip the startup banner\n\nType :help at the prompt for the meta-commands.\n"
                      (if (strEq c "new")
                        "axiom new - start a new Axiom project\n\nUSAGE:\n  axiom new <NAME>\n\nCreates NAME/ holding Main.ax, a hello-world program, and\naxiom.pkg carrying `name NAME` and `version 0.1.0`. Refuses when\nNAME is not a package name (letters, digits, `.`, `-`, `_`) or\nthe directory already holds a project or is not empty.\n"
                        (if (strEq c "fetch")
                          "axiom fetch - check out the project's registry dependencies\n\nUSAGE:\n  axiom fetch\n\nFor every `depend` URL in the nearest `axiom.pkg`, clones it\ninto `.axiom/deps/<slug>/` beside the manifest when no checkout\nis there yet; a checkout already there is left alone. Takes no\noperands. Needs `git` on PATH; the compiler never fetches on its\nown - `build` refuses a missing checkout naming the clone.\n"
                          (if (strEq c "lsp")
                            "axiom lsp - run the language server\n\nUSAGE:\n  axiom lsp\n\nSpeaks JSON-RPC over stdin and stdout, so it takes no operand and\nwrites nothing else to stdout.\n"
                            (if (strEq c "version")
                              "axiom version - print the version\n\nUSAGE:\n  axiom version\n  axiom --version\n"
                              usageText)))))))))))))))

; Every `--link-search DIR` and `--link-lib NAME` on the command line,
; rendered as the `cc` arguments they become.
;
; Search paths first as a group, then libraries: `-L` before `-l`
; matters to some linkers and costs nothing here. Within each group the
; order is COMMAND-LINE order, because `check-reproducible.sh` compares
; bytes and an unordered link line would flip them run to run.
;
; This is the FFI's only reach into the driver. Before it, `cc` was
; invoked with exactly three arguments and the language had no way to
; name an external symbol, so there was nothing for a `-l` to resolve.
(pub :: linkArgsOf Strings)
;@axiom:effect(io)
(pub fn (linkArgsOf)
  {
    (let v vecNew)
    {
      (collectFlagInto v "--link-search" "-L" 1 sysArgc)
      (collectFlagInto v "--link-lib" "-l" 1 sysArgc)
      v
    }
  })

; Both `--flag VALUE` and `--flag=VALUE`, the two spellings
; `flagValueAt` already accepts, but collecting EVERY occurrence rather
; than the first: a program may bind more than one library.
(pub :: collectFlagInto (-> Strings String String Int Int Int))
;@axiom:effect(io)
(pub fn (collectFlagInto v name prefix i n)
  (if (>= i n)
    0
    {
      (let a (sysArg i))
      (if (strEq a name)
        (if (< (+ i 1) n)
          {
            (vecPush v (concat prefix (sysArg (+ i 1))))
            (collectFlagInto v name prefix (+ i 2) n)
          }
          0)
        {
          (let eq (concat name "="))
          (if (strStartsWith a eq)
            {
              (vecPush v (concat prefix (strSlice a (strLen eq) (- (strLen a) (strLen eq)))))
              (collectFlagInto v name prefix (+ i 1) n)
            }
            (collectFlagInto v name prefix (+ i 1) n))
        })
    }))

; First supplied value, including empty; None when missing or not found.
(pub :: flagValue (-> String Int (Option String)))
;@axiom:effect(io)
(pub fn (flagValue name from)
  (flagValueAt name from sysArgc))

(pub :: flagValueAt (-> String Int Int (Option String)))
;@axiom:effect(io)
(pub fn (flagValueAt name i n)
  (if (>= i n)
    None
    {
      (let a (sysArg i))
      (if (strEq a name)
        (if (< (+ i 1) n)
          (Some (sysArg (+ i 1)))
          None)
        {
          (let eq (concat name "="))
          (if (strStartsWith a eq)
            (Some (strSlice a (strLen eq) (- (strLen a) (strLen eq))))
            (flagValueAt name (+ i 1) n))
        })
    }))

; The INDEX of the first argument at or after `from` that is not a flag
; and is not the value of one, or None.
;
; Global flags may precede the subcommand, because stage0's are accepted
; anywhere and the gates rely on it: `check-cross-targets.sh` invokes
; `axiom --target=<t> emit-llvm <file> -o <out>`. Dispatching on argv[1]
; alone read `--target=linux-x86_64` as an input filename and answered
; `cannot read input`.
; How many SEPARATE arguments this flag consumes after itself: 1 for a
; value flag, 0 for a boolean, None when the name is not a flag at all.
;
; Kept as a table rather than inferred: there is no way to tell a
; boolean from a value-taking flag by looking at the flag. A scan that
; assumed every flag without an `=` takes a value would read `prog.ax`
; in
;
;     axiom --emit-llvm prog.ax
;
; as the VALUE of `--emit-llvm` and find no positional after it.
;
; The None arm makes an unrecognised flag an ERROR rather than something
; silently stepped over. Skipping is indistinguishable from accepting:
; `axiom check --bogus f.ax` would print OK and exit 0, and a mistyped
; `--diagnostic-formt=json` would quietly produce human output.
(pub :: flagArity (-> String (Option Int)))
(pub fn (flagArity a)
  (if (|| (strEq a "--input")
        (|| (strEq a "--output")
          (|| (strEq a "-o")
            (|| (strEq a "--target")
              (|| (strEq a "--opt")
                (|| (strEq a "--heap-ceiling")
                  (|| (strEq a "--link-lib")
                    (|| (strEq a "--link-search")
                      (|| (strEq a "--crate")
                        (|| (strEq a "--emit-rust-binding")
                          (|| (strEq a "--filter")
                            (|| (strEq a "--jobs")
                              (|| (strEq a "--diagnostic-format")
                                (|| (strEq a "--out") (strEq a "--emit")))))))))))))))
    (Some 1)
    (if (|| (|| (strEq a "--obfuscate") (strEq a "--alloc-poison"))
          (|| (strEq a "--emit-llvm")
            (|| (strEq a "--emit-staticlib")
              (|| (strEq a "--threads")
                (|| (|| (strEq a "--check") (strEq a "--diff"))
                  (||
                    (|| (strEq a "--builtins")
                      (|| (strEq a "--calls") (|| (strEq a "--mir") (strEq a "--axir"))))
                    (|| (strEq a "--list")
                      (|| (strEq a "--no-banner")
                        (|| (strEq a "--help")
                          (|| (strEq a "-h")
                            (|| (strEq a "--version")
                              (|| (strEq a "-V")
                                (|| (strEq a "--no-open") (strEq a "--missing"))))))))))))))
      (Some 0)
      None)))

; `--name=value` split into its two halves.
(pub :: flagNamePart (-> String String))
(pub fn (flagNamePart a)
  (if (let (Some e) (strFindByte a 61 0))
    (strSlice a 0 e)
    a))

(pub :: flagHasValuePart (-> String Bool))
(pub fn (flagHasValuePart a)
  (isSome (strFindByte a 61 0)))

; No equals sign is None; an equals sign with no suffix is Some "".
(pub :: flagValuePart (-> String (Option String)))
(pub fn (flagValuePart a)
  (if (let (Some e) (strFindByte a 61 0))
    (Some (strSlice a (+ e 1) (- (strLen a) (+ e 1))))
    None))

; Is this argument written as a flag at all? A bare `-` is not: it names
; standard input by convention, and refusing it here would be a worse
; answer than the read error a caller gives it.
(pub :: looksLikeFlag (-> String Bool))
(pub fn (looksLikeFlag a)
  (&& (strStartsWith a "-") (> (strLen a) 1)))

(pub :: positionalIndex (-> Int (Option Int)))
;@axiom:effect(io)
(pub fn (positionalIndex from)
  (if (|| (< from 0) (>= from sysArgc))
    None
    {
      (let a (sysArg from))
      (if (strEq a "--")
        ; `--` ends option parsing, so what follows is an operand
        ; even when it begins with a dash. Without this the marker
        ; was accepted by `checkArgs` and then ignored here, and
        ; `axiom check -- -weird.ax` answered `check needs an input
        ; file` - a separator the usage text documents and the
        ; operand scan did not implement.
        (if (< (+ from 1) sysArgc)
          (Some (+ from 1))
          None)
        (if (strStartsWith a "-")
          ; A flag carries its value with `=`, or takes the next
          ; argument, or takes none at all - and only the flag's name
          ; can decide which. An unknown flag is stepped over here
          ; rather than diagnosed, because `checkArgs` has already
          ; refused the invocation before any of this runs; reaching
          ; this point means every flag in argv is in the table.
          (if (flagHasValuePart a)
            (positionalIndex (+ from 1))
            (match (flagArity a)
              ((None) (positionalIndex (+ from 1)))
              ((Some arity)
                (positionalIndex
                  (+ from
                    (if (== arity 1)
                      2
                      1)))
              )))
          (Some from)))
    }))

(pub :: positionalFrom (-> Int (Option String)))
;@axiom:effect(io)
(pub fn (positionalFrom from)
  (match (positionalIndex from)
    ((None) None)
    ((Some i) (Some (sysArg i)))))

; The candidate command index, or None when no operand is present.
;
; argv[1] is consulted directly first so that `--version` - a flag by
; spelling and a subcommand by meaning - is not skipped as a flag by the
; scan below it.
(pub :: subcommandIndex (Option Int))
;@axiom:effect(io)
(pub fn (subcommandIndex)
  (if (> sysArgc 1)
    (if (isSubcommand (sysArg 1))
      (Some 1)
      (positionalIndex 1))
    None))

(pub :: subcommandName (Option String))
;@axiom:effect(io)
(pub fn (subcommandName)
  (match subcommandIndex
    ((None) None)
    ((Some i)
      {
        (let a (sysArg i))
        (if (isSubcommand a)
          (Some a)
          None)
      }
    )))

; The index of `--` at or after `from`, or None. The end-of-options
; marker is what lets `run` in manifest mode tell program arguments
; from compiler operands: everything after it belongs to the program
; whether it begins with a dash or not.
(pub :: dashDashIndex (-> Int (Option Int)))
;@axiom:effect(io)
(pub fn (dashDashIndex from)
  (if (|| (< from 0) (>= from sysArgc))
    None
    (if (strEq (sysArg from) "--")
      (Some from)
      (dashDashIndex (+ from 1)))))

; Where a subcommand's own operands begin - one past the subcommand,
; which is NOT always index 2: a global flag in front of it shifts
; everything right, and reading from a fixed 2 hands the subcommand's
; own name back as the input filename.
(pub :: operandStart Int)
;@axiom:effect(io)
(pub fn (operandStart)
  (match subcommandIndex
    ; The no-command argv scan starts at index zero, as before.
    ((None) 0)
    ((Some index) (+ index 1))))

; The optimisation level, refusing a value it cannot honour.
;
; A fallback to 1 would build `--opt banana` and `--opt 9` at -O1 in
; silence, and a clamp would build `--opt 200` at -O3: each a silent
; answer to a question the user got wrong, so anything outside 0-3 is
; refused.
;
; The command line wins wherever it speaks; where it is silent the
; project's manifest answers through `pkgOpt`, or 1 when the project
; has no `opt`. `entryDir` is the directory the manifest is found
; from - the entry file's, or the manifest's own in manifest mode.
(pub :: optLevelArg (-> String Int))
;@axiom:effect(io)
(pub fn (optLevelArg entryDir)
  ; `checkArgs` has already refused every `--opt` value this cannot
  ; honour, and `pkgVerify` every manifest one, so the fallbacks here
  ; are unreachable rather than silent substitutions. They are kept
  ; because the alternative is a partial function, and a compiler that
  ; trusts an earlier pass to have run is one bad refactor from
  ; building at the wrong level in silence.
  (match (flagValue "--opt" 1)
    ((None)
      {
        (let m (pkgOpt entryDir))
        (match m
          ((None) 1)
          ((Some m)
            (if (>= m 0)
              m
              1)
          ))
      }
    )
    ((Some v)
      (if (> (strLen v) 0)
        (if (&& (== (strLen v) 1)
              {
                (let c (strByte v 0))
                (&& (>= c 48) (<= c 51))
              })
          (- (strByte v 0) 48)
          1)
        {
          (let m (pkgOpt entryDir))
          (match m
            ((None) 1)
            ((Some m)
              (if (>= m 0)
                m
                1)
            ))
        })
    )))

(pub :: targetArg (-> String String))
;@axiom:effect(io)
(pub fn (targetArg fallback)
  (match (flagValue "--target" 1)
    ((None) fallback)
    ((Some v)
      (if (== (strLen v) 0)
        fallback
        v)
    )))

; ------------------------------------------------------------------
; Validating the invocation, once, before any subcommand acts.
;
; Until this existed there was no such pass: `flagValue`, `hasFlag` and
; `positionalIndex` each walked argv with its own idea of what a flag
; was, and none could say that a flag was not one. Two of the results
; destroyed a user's file:
;
;   axiom fmt --check=true FILE   REWROTE FILE and printed `OK: FILE
;                                 formatted`. `hasFlag` matches exactly,
;                                 so `--check=true` was not `--check`
;                                 and the arm fell through to the write.
;   axiom fmt FILE --help         REWROTE FILE, because `--help` was
;                                 only ever recognised at argv[1].
;
; The rule is the weakest one that kills the class: a flag must EXIST
; and must be given the right number of values. It does not police
; which subcommand owns which flag.
; ------------------------------------------------------------------
; A usage error: the message, a pointer at `--help`, and exit 2.
;
; 2 is the status the retired compiler used for every usage error (clap
; 4.6.4's default), and it is free here: the parse-error port moved
; syntax errors to 1, so nothing has produced 2 since. The split that
; matters is stream and status together - help the user ASKED for goes
; to stdout with 0, an invocation they got wrong goes to stderr with 2.
(pub :: usageError (-> String Int))
;@axiom:effect(io)
(pub fn (usageError msg)
  {
    (writeStderrStr msg)
    (writeStderrStr "\nFor more information, try `axiom --help`.\n")
    (sysExitWith 2)
    2
  })

; Edit distance between `a` and `b`, two rows of the DP table.
;
; Only the SUBCOMMAND suggestion earns this. `axiom buidl f.ax` gave a
; user no clue at all - it was read as a FILENAME, so the answer was
; `cannot read input: buidl` and their real filename was discarded -
; whereas `unrecognised flag `--diagnostic-formt`` already names the
; thing that is wrong.
(pub :: editDistance (-> String String Int))
(pub fn (editDistance a b)
  {
    (let n (strLen a))
    (let m (strLen b))
    (let mut prev vecNew)
    {
      {
        (let mut j 0)
        (while (<= j m)
          {
            (vecPush prev j)
            (set j (+ j 1))
          })
      }
      {
        (let mut i 1)
        (while (<= i n)
          {
            (let cur vecNew)
            {
              (vecPush cur i)
              {
                (let mut j 1)
                (while (<= j m)
                  {
                    {
                      (let cost
                        (if (== (strByte a (- i 1)) (strByte b (- j 1)))
                          0
                          1))
                      {
                        (let d1 (+ (vecGet prev j) 1))
                        (let d2 (+ (vecGet cur (- j 1)) 1))
                        (let d3 (+ (vecGet prev (- j 1)) cost))
                        (vecPush cur
                          (if (&& (<= d1 d2) (<= d1 d3))
                            d1
                            (if (<= d2 d3)
                              d2
                              d3)))
                      }
                    }
                    (set j (+ j 1))
                  })
              }
              (set prev cur)
              (set i (+ i 1))
            }
          })
      }
      (vecGet prev m)
    }
  })

(pub :: subcommandNames Strings)
(pub fn (subcommandNames)
  {
    (let v vecNew)
    {
      (vecPush v "build")
      (vecPush v "check")
      (vecPush v "run")
      (vecPush v "test")
      (vecPush v "emit-llvm")
      (vecPush v "fmt")
      (vecPush v "explain")
      (vecPush v "symbols")
      (vecPush v "doc")
      (vecPush v "repl")
      (vecPush v "lsp")
      (vecPush v "version")
      (vecPush v "help")
      v
    }
  })

; The known subcommand within two edits of `w`, or "".
;
; Two, not one, because the commonest typo of all is a transposition -
; `buidl` for `build` - and plain Levenshtein scores a swap as two
; edits, not one. A threshold of 1 therefore misses the exact case this
; exists to catch, which is how it was first measured.
;
; A wrong suggestion costs nothing here: the caller only asks once the
; operand is already refused, so the distance only chooses whether the
; refusal carries a `did you mean`.
(pub :: nearestSubcommand (-> String String))
(pub fn (nearestSubcommand w)
  (nearestSubcommandFrom w subcommandNames 0))

(pub :: nearestSubcommandFrom (-> String Strings Int String))
(pub fn (nearestSubcommandFrom w v i)
  (if (>= i (vecLen v))
    ""
    {
      (let c (vecGet v i))
      (if (<= (editDistance w c) 2)
        c
        (nearestSubcommandFrom w v (+ i 1)))
    }))

; Is `want` present as a FLAG - anywhere in argv, not as another flag's
; value, and not after `--`?
;
; Anywhere is the whole point. Recognised only at argv[1], `axiom fmt
; FILE --help` would fall through to fmt's write path and rewrite the
; file it had been asked to explain.
;
; After `run`'s own file operand every argument belongs to the PROGRAM,
; so the scan stops there: `axiom run prog.ax --help` asks prog.ax for
; its help, not this compiler for its own.
(pub :: hasFlagAnywhere (-> (Option String) String Bool))
;@axiom:effect(io)
(pub fn (hasFlagAnywhere cmd want)
  (hasFlagAnywhereFrom cmd want 1 0))

(pub :: hasFlagAnywhereFrom (-> (Option String) String Int Int Bool))
;@axiom:effect(io)
(pub fn (hasFlagAnywhereFrom cmd want i endOpts)
  (if (>= i sysArgc)
    false
    {
      (let a (sysArg i))
      (if (&& (== endOpts 0) (strEq a "--"))
        false
        (if (|| (== endOpts 1)
              (if (looksLikeFlag a)
                false
                true))
          (hasFlagAnywhereFrom cmd want (+ i 1)
            (if (&&
                  (match cmd
                    ((None) false)
                    ((Some name) (strEq name "run")))
                  (match subcommandIndex
                    ((None) (>= i 0))
                    ((Some command) (> i command))))
              1
              endOpts))
          {
            (let name (flagNamePart a))
            (if (strEq name want)
              true
              (match (flagArity name)
                ((None) (hasFlagAnywhereFrom cmd want (+ i 1) endOpts))
                ((Some arity)
                  (hasFlagAnywhereFrom cmd want
                    (+ i
                      (if (&& (== arity 1) (! (flagHasValuePart a)))
                        2
                        1))
                    endOpts)
                )))
          }))
    }))

; Walk argv once and refuse anything the table does not describe.
;
; Answers 0 for a well-formed invocation; a bad one never returns,
; because there is nothing a caller could do with the news.
(pub :: checkArgs (-> (Option String) Int))
;@axiom:effect(io)
(pub fn (checkArgs cmd)
  {
    (checkArgsFrom cmd 1 0)
    (if (hasFlagAnywhere cmd "--obfuscate")
      (if (!
            (match cmd
              ((None) false)
              ((Some name)
                (|| (strEq name "build") (|| (strEq name "run") (strEq name "emit-llvm")))
              )))
        (usageError "error: --obfuscate is supported by build, run and emit-llvm\n")
        (if (hasFlagAnywhere cmd "--emit-staticlib")
          (usageError
            "error: --obfuscate requires an executable entry point; static archives are not supported yet\n"))))
    0
  })

(pub :: checkArgsFrom (-> (Option String) Int Int Int))
;@axiom:effect(io)
(pub fn (checkArgsFrom cmd i endOpts)
  (if (>= i sysArgc)
    0
    {
      (let a (sysArg i))
      (if (&& (== endOpts 0) (strEq a "--"))
        ; Everything after `--` is an operand, so a file whose name
        ; begins with `-` can be named at all. driver.ax has carried
        ; a note since the subcommand CLI landed that this was the
        ; fix if it ever mattered; validation is what makes it
        ; matter, since a leading dash is now an error rather than a
        ; silent skip.
        (checkArgsFrom cmd (+ i 1) 1)
        (if (|| (== endOpts 1)
              (if (looksLikeFlag a)
                false
                true))
          (checkArgsFrom cmd (+ i 1)
            (if (&&
                  (match cmd
                    ((None) false)
                    ((Some name) (strEq name "run")))
                  (match subcommandIndex
                    ((None) (>= i 0))
                    ((Some command) (> i command))))
              1
              endOpts))
          {
            (let name (flagNamePart a))
            (match (flagArity name)
              ((None) (usageError (concat "error: unrecognised flag `" (concat name "`\n"))))
              ((Some arity)
                (match (flagValuePart a)
                  ((Some value)
                    (if (== arity 0)
                      (usageError
                        (concat (concat "error: `" (concat name "` takes no value, but `"))
                          (concat value "` was given\n")))
                      {
                        (checkFlagValue name value)
                        (checkArgsFrom cmd (+ i 1) endOpts)
                      })
                  )
                  ((None)
                    (if (== arity 1)
                      (if (>= (+ i 1) sysArgc)
                        (usageError
                          (concat "error: a value is required for `"
                            (concat name "` but none was given\n")))
                        {
                          (checkFlagValue name (sysArg (+ i 1)))
                          (checkArgsFrom cmd (+ i 2) endOpts)
                        })
                      (checkArgsFrom cmd (+ i 1) endOpts))
                  ))
              ))
          }))
    }))

; The values that have exactly one right shape are checked HERE, in the
; same walk as the names, so a wrong command line is refused before any
; subcommand acts on it.
;
; Parsed only where it is USED, `--opt` would be read in `build` after
; `compileFile` has run, so `axiom build --input bad.ax --opt banana`
; would report the type error first and the bad optimisation level only
; on the next run. A command line that cannot be honoured is refused
; before the compiler does a minute of work on it.
;
; `--diagnostic-format` takes exactly `human`, `ai` or `json`, the
; names `--help` lists. `--target` is not here, because
; `checkedTargetCode` already refuses it by name with the list of valid
; targets.
(pub :: checkFlagValue (-> String String Int))
;@axiom:effect(io)
(pub fn (checkFlagValue name v)
  (if (strEq name "--opt")
    (if (&& (== (strLen v) 1)
          {
            (let c (strByte v 0))
            (&& (>= c 48) (<= c 51))
          })
      0
      (usageError (concat "error: `--opt` takes 0, 1, 2 or 3, but was given `" (concat v "`\n"))))
    (if (strEq name "--heap-ceiling")
      (if (allDigits v 0)
        (if (&& (> (strLen v) 0) (ceilingPositive v))
          0
          (usageError
            (concat "error: `--heap-ceiling` takes a positive number of bytes, but was given `"
              (concat v "`\n"))))
        (usageError
          (concat "error: `--heap-ceiling` takes a positive number of bytes, but was given `"
            (concat v "`\n"))))
      (if (strEq name "--diagnostic-format")
        (if (>= (parseDiagFormatName v) 0)
          0
          (usageError
            (concat "error: `--diagnostic-format` takes human, ai or json, but was given `"
              (concat v "`\n"))))
        0))))

; Every byte a digit, and at least one byte: the empty string and
; anything with a sign, a space or a suffix answers false, so the
; ceiling the emitter parses is the digits the validator accepted.
(pub :: allDigits (-> String Int Bool))
(pub fn (allDigits v i)
  (if (>= i (strLen v))
    (> (strLen v) 0)
    {
      (let c (strByte v i))
      (if (&& (>= c 48) (<= c 57))
        (allDigits v (+ i 1))
        false)
    }))

; Non-zero without parsing the value: any length past one is positive,
; and a single byte is positive unless it is `0`.
(pub :: ceilingPositive (-> String Bool))
(pub fn (ceilingPositive v)
  (if (> (strLen v) 1)
    true
    (!= (strByte v 0) 48)))

(pub :: errnoReason (-> Int String))
(pub fn (errnoReason e)
  (if (== e 2)
    "No such file or directory"
    (if (== e 13)
      "Permission denied"
      (if (== e 21)
        "Is a directory"
        (concat "errno " (fmtInt e))))))

; The errno behind a failed read of a source file, or 0 when it read.
; An empty file reads, as `(Ok "")`, and lexes to no tokens; a
; directory fails at its first `read` with EISDIR. The read is the
; only one, so a pipe such as `/dev/stdin` loses no byte to a probe
; (`check-driver.sh` pins a pipe and a file reporting the same
; diagnostic at the same column).
(pub :: sourceReadErrno (-> (Result String Error) Int))
(pub fn (sourceReadErrno r)
  (match r
    ((Ok _) 0)
    ((Err e) (errCode e))))

; One spelling of the read failure, everywhere: `error: could not
; read file 'F': <reason>`, lowercase with the `error:` prefix every
; other CLI failure carries, and the reason naming whether the file
; was missing, unreadable, or a directory.
;
; There were three. `fmt` and `symbols` said `Failed to read file 'F'`,
; the compile path said `cannot read input: F`, and neither gave the
; reason - so which wording a user saw depended on which subcommand they
; had typed, and no wording ever said whether the file was missing,
; unreadable, or a directory.
(pub :: readFailMsg (-> String Int String))
(pub fn (readFailMsg fileName e)
  (concat (concat "error: could not read file '" (concat fileName "': "))
    (concat (errnoReason e) "\n")))
