; core.ax — compiler data structures shared by every phase.
;
; Pipeline values retain their logical types even though native values
; occupy machine words. AST handles and homogeneous syntax vectors are
; distinct from scalar words; packed storage is read through parser's
; typed arena views.
(import Err (isNone))
(import Mem)
(import Str)
(import Vec)
(import raw)

; ------------------------------------------------------------------
; Span: a half-open [start, end) range of byte offsets into a source
; file. End may equal start for a zero-width span (e.g. EOF token).
; ------------------------------------------------------------------
(pub struct Span
  (mut start : Int)
  (mut end : Int))

; The claim has no `no-alloc`: the whole body is a struct construction,
; and a construction allocates (`MM-EXEC-9a`).
;@axiom:restrict(no-io,no-foreign)
(pub :: mkSpan (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (mkSpan start end)
  (as (Span :start start :end end) Int))

; ------------------------------------------------------------------
; Composite types for the pipeline boundaries. Every phase consumes
; and answers these same shapes, so their signatures name them once
; here instead of repeating the vector spelling at every call site.
; Aliases are transparent: `Decls` is `(Vec ASTNode)` wherever it stands.
; ------------------------------------------------------------------
; The parser owns this packed layout and its dynamic reference map.
; Other phases use typed handles and payload views rather than constructing
; the record or interpreting an AST address as a scalar.
(pub struct ASTNode sealed
  (tag : Int)
  (a : Int)
  (b : Int)
  (c : Int)
  (span : Int)
  (vis : Int)
  (ty : Int)
  (axtags : Int)
  (module : Int)
  (fieldNames : Int)
  (defscope : Int)
  (binderTy : Int)
  (syntaxIdentity : Int))

; The tag is a scalar at every AST shape. Keep this read typed so the
; node never escapes through a raw word-reader argument.
(pub :: astNodeTag (-> ASTNode Int))
(pub fn (astNodeTag node)
  (if (addrEq (addrOf node) (addrOf 0))
    0
    node.tag))

(pub type Nodes (Vec ASTNode))

(pub type NodesRows (Vec Nodes))

; A declaration list has one syntax handle per top-level form.
(pub type Decls Nodes)

; A substitution owns each source name and its instantiated type together.
(pub struct TypeBinding
  (name : String)
  (ty : ASTNode))

(pub type TypeEnv (Vec TypeBinding))

; Function types retained by the final check, at each definition's arity.
; An unresolved type variable remains unresolved in this view.
(pub struct FunctionType
  (name : String)
  (ty : ASTNode)
  (arity : (Option Int)))

(pub type FunctionTypes (Vec FunctionType))

(pub :: typeBindingName (-> TypeBinding String))
(pub fn (typeBindingName binding)
  binding.name)

(pub :: typeBindingTy (-> TypeBinding ASTNode))
(pub fn (typeBindingTy binding)
  binding.ty)

; A module's compilation units, parallel to the merged `Decls`.
(pub type Units (Vec CUnit2))

; Bare and qualified name lists carried through import resolution.
(pub type Names (Vec String))

; A macro expansion retains the invocation and definition module names.
; Span words are handles into the parser's sealed source arena.
(pub struct ExpFrame
  (site : (Option String))
  (span : Int)
  (name : String)
  (defSpan : Int)
  (defMod : (Option String)))

; Macro expansion frames, parallel to the diagnostics they annotate.
(pub type Frames (Vec ExpFrame))

; Structural composites for long signatures: word vectors, string
; vectors and their rows, spelled once instead of at every position.
(pub type Ints (Vec Int))

(pub type Strings (Vec String))

(pub type IntRows (Vec (Vec Int)))

(pub type StringRows (Vec (Vec String)))

; Each annotation owns its text and absolute source offset. Empty text and
; offset zero are present values; the optional collection lives at the node.
(pub struct AxtagEnt
  (off : Int)
  (content : String))

(pub type Axtags (Vec AxtagEnt))

; Macro syntax owns its pattern, template and literal metadata throughout
; parsing and expansion. Only the parser's sealed node slot is packed.
(pub struct MacroPatternParts
  (patterns : Nodes)
  (names : Names)
  (spellings : Names)
  (repeats : Ints))

(pub struct RuleTemplates
  (declarations : Nodes)
  (expression : (Option ASTNode)))

(pub struct MacroLiterals
  (declared : Names)
  (used : Names))

(pub struct MacroRule
  (params : Names)
  (declarations : Nodes)
  (patterns : Nodes)
  (spellings : Names)
  (repeats : Ints)
  (literals : MacroLiterals)
  (expression : (Option ASTNode)))

(pub type MacroRules (Vec MacroRule))

(pub struct MacroPatternRewrite
  (patterns : Nodes)
  (names : Names)
  (used : Names))

; ------------------------------------------------------------------
; TokenKind: one nullary constructor per token shape. A value is only a
; tag; the lexeme lives in the `Token`. A new kind is appended, so no
; existing tag moves.
;
;   TK_LPAREN `(`  TK_RPAREN `)`  TK_IDENT an identifier or keyword
;   TK_INT, TK_FLOAT, TK_STRING, TK_CHARLIT  literals; a character
;     literal keeps its quotes and escape
;   TK_COLON `:`  TK_DOUBLE_COLON `::`  TK_RARROW `->`  TK_DOT `.`
;   TK_QUOTE `'`  TK_LBRACE `{`  TK_RBRACE `}`  TK_EOF  TK_ERROR
;   TK_LBRACKET `[`  TK_RBRACKET `]`  TK_COMMA `,`  TK_QUESTION `?`
;   TK_ERROR_ESC an invalid escape `\x`, x not one of the seven
;
; Brackets are tokens, never skipped: a skipped delimiter makes a
; different program, `[(Box Int)]` read as `(Box Int)`. The comma
; separates a struct variant's fields; a byte the lexer does not know is
; AX1001, never silently dropped. TK_ERROR_ESC is its own kind because
; `lexErrDiag` reads a TK_ERROR's code off the span's first byte, and a
; bare `\` (AX1001) and an escape (AX1005) both start with `\`.
; ------------------------------------------------------------------
(pub data TokenKind
  (TK_LPAREN)
  (TK_RPAREN)
  (TK_IDENT)
  (TK_INT)
  (TK_STRING)
  (TK_COLON)
  (TK_DOUBLE_COLON)
  (TK_RARROW)
  (TK_DOT)
  (TK_QUOTE)
  (TK_LBRACE)
  (TK_RBRACE)
  (TK_EOF)
  (TK_ERROR)
  (TK_FLOAT)
  (TK_CHARLIT)
  (TK_LBRACKET)
  (TK_RBRACKET)
  (TK_COMMA)
  (TK_ERROR_ESC)
  (TK_QUESTION))

; ------------------------------------------------------------------
; Token: the product of lexing a single lexical item.
;   kind   — TokenKind tag
;   lexeme — Str (shared with source wherever possible)
;   span   — Span (byte range in source)
; ------------------------------------------------------------------
(pub struct Token
  (kind : TokenKind)
  (lexeme : String)
  (span : Int))

(pub type Tokens (Vec Token))

; No `no-alloc`, for `mkSpan`'s reason: the body is one `Token`
; construction, which allocates.
;@axiom:restrict(no-io,no-foreign)
(pub :: mkToken (-> TokenKind String Int Token))
(pub fn (mkToken kind lexeme span)
  (Token :kind kind :lexeme lexeme :span span))

; Tokens own their lexemes directly. Spans keep the shared parser
; arena-handle ABI and are read through their declaration.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: tokenKind (-> Token TokenKind))
(pub fn (tokenKind t)
  t.kind)

;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: tokenLexeme (-> Token String))
(pub fn (tokenLexeme t)
  t.lexeme)

;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: tokenSpan (-> Token Int))
(pub fn (tokenSpan t)
  t.span)

;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: spanStart (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (spanStart s)
  {
    (let v (as s Span))
    v.start
  })

;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: spanEnd (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (spanEnd s)
  {
    (let v (as s Span))
    v.end
  })

; ------------------------------------------------------------------
; Decode a lexer-validated decimal Int. Stop at the first non-digit;
; separators are ignored. Accumulate negatively so Int minimum stays exact.
; ------------------------------------------------------------------
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strToInt (-> String Int))
(pub fn (strToInt s)
  (if (&& (> (strLen s) 0) (== (strByte s 0) 45))
    (strToIntNegativeFrom s 1 0)
    (- 0 (strToIntNegativeFrom s 0 0))))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strToIntNegativeFrom (-> String Int Int Int))
(pub fn (strToIntNegativeFrom s i acc)
  (if (>= i (strLen s))
    acc
    {
      (let ch (strByte s i))
      (if (&& (>= ch 48) (<= ch 57))
        (strToIntNegativeFrom s (+ i 1) (- (* acc 10) (- ch 48)))
        ; `_` is a digit separator: part of the token, no part of
        ; the value.
        (if (== ch 95)
          (strToIntNegativeFrom s (+ i 1) acc)
          acc))
    }))

; ------------------------------------------------------------------
; A compilation UNIT: one source file that contributed declarations.
; `name` is Some module name, or None for the entry file. Built by
; `resolveDecls` (the only place that reads a module), consulted by
; the checker to stamp each diagnostic with the file its spans index,
; and by the renderer to pick that file's text. It lives here because
; all three of codegen, typecheck and diag need it. `library` is true
; for a file inside the standard library's own directories; the checker
; lets only those reach an `Internal` module (AX5002).
; ------------------------------------------------------------------
(pub struct CUnit2
  (file : String)
  (src : String)
  (name : (Option String))
  (imports : Decls)
  (library : Bool))

(pub :: unitFile (-> CUnit2 String))
(pub fn (unitFile u)
  u.file)

(pub :: unitSrc (-> CUnit2 String))
(pub fn (unitSrc u)
  u.src)

; The module the unit declares. Some empty text remains a named unit.
(pub :: unitName (-> CUnit2 (Option String)))
(pub fn (unitName u)
  u.name)

; Whether this unit declares the requested name.
(pub :: unitNameIs (-> CUnit2 String Bool))
(pub fn (unitNameIs u name)
  (if (let (Some declared) (unitName u))
    (strEq declared name)
    false))

; Whether this is the entry file, the one unit with no module name.
(pub :: unitIsEntry (-> CUnit2 Bool))
(pub fn (unitIsEntry u)
  (match (unitName u)
    ((None) true)
    ((Some _) false)))

(pub :: unitImports (-> CUnit2 Decls))
(pub fn (unitImports u)
  u.imports)

(pub :: unitLibrary (-> CUnit2 Bool))
(pub fn (unitLibrary u)
  u.library)

; ------------------------------------------------------------------
; A UTF-8 byte order mark. Three bytes, EF BB BF, that a BOM-emitting
; editor puts before the first character of a file and that no reader
; of the file is meant to see; read as text, it would fail the whole
; file as `AX1001` at an invisible 1:1. It is skipped where a file's
; text is entered - the lexer's entry, and the two column counters in
; `diag` and `render` - and nowhere else: spans stay byte offsets into
; the text as read, so the mark costs three bytes of offset and zero
; columns, which is the position an editor that hides it reports too.
; Asked of a LINE START rather than of the text, so a column on any
; later line is untouched.
; `fmt` reads through its own scanner (`fscan`) and lifts the mark off
; before it, restoring it on the result (`fmtFormat`); `check`,
; `build`, `run`, `symbols` and the language server all come through
; `lex`.
; ------------------------------------------------------------------
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: pastBom (-> String Int Int))
(pub fn (pastBom src lineStart)
  (if (!= lineStart 0)
    lineStart
    (if (&& (>= (strLen src) 3)
          (&& (== (strByte src 0) 239) (&& (== (strByte src 1) 187) (== (strByte src 2) 191))))
      3
      0)))

; ------------------------------------------------------------------
; Name and byte helpers every phase needs.
;
; A qualified reference `Mod::name` is parsed into the flat `Mod$name`
; spelling the declarations use, so the bare name is the tail after the
; last `$` (36). Three passes had a private copy of this walk under
; three names; a fourth had the escape table below.
; ------------------------------------------------------------------
;@axiom:restrict(no-io,no-foreign)
(pub :: bareOfFrom (-> String Int String))
(pub fn (bareOfFrom s i)
  (if (< i 0)
    s
    (if (== (strByte s i) 36)
      (strSlice s (+ i 1) (- (strLen s) (+ i 1)))
      (bareOfFrom s (- i 1)))))

;@axiom:restrict(no-io,no-foreign)
(pub :: bareOf (-> String String))
(pub fn (bareOf s)
  (bareOfFrom s (- (strLen s) 1)))

; The byte an escape sequence stands for; anything else stands for
; itself, which is what makes `\\` and `\"` fall through correctly.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: unescByte (-> Int Int))
(pub fn (unescByte c)
  (if (== c 110)
    10
    (if (== c 116)
      9
      (if (== c 114)
        13
        (if (== c 48)
          0
          c)))))

; Owning String vectors, searched by value. Membership returns 0 or 1;
; the optional index keeps None distinct from a match at slot zero.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: strVecHas (-> Names String Int))
(pub fn (strVecHas xs n)
  {
    (let mut found 0)
    (for name in xs
      (if (strEq name n)
        (set found 1)))
    found
  })

; `(Some i)` allocates, so this cannot claim `no-alloc`.
;@axiom:restrict(no-io,no-foreign)
(pub :: strVecIdx (-> Names String (Option Int)))
(pub fn (strVecIdx xs n)
  {
    (let mut found (:: None (Option Int)))
    (for (name index) in xs
      (match found
        ((None)
          (if (strEq name n)
            (set found (Some index)))
        )
        ((Some previous) ())))
    found
  })

; Append every element of `src` to `acc`, answering `acc`.
;@axiom:restrict(no-io,no-foreign)
(pub :: vecAppendFrom (-> (Vec a) (Vec a) Int (Vec a)))
(pub fn (vecAppendFrom src acc i)
  (if (>= i (vecLen src))
    acc
    {
      (vecPush acc (vecGet src i))
      (vecAppendFrom src acc (+ i 1))
    }))

; The index of the newline at or after `i`, or the end of `s`. The
; `explain` renderer and the symbol lister each walked this loop.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: lineEndFrom (-> String Int Int))
(pub fn (lineEndFrom s i)
  {
    (let n (strLen s))
    (let mut j i)
    {
      (while (&& (< j n) (!= (strByte s j) 10))
        (set j (+ j 1)))
      j
    }
  })

(pub :: nilNodes Nodes)
;@axiom:effect(unsafe)
(pub fn (nilNodes)
  (as 0 Nodes))

(pub :: vecIsNull (-> (Vec a) Bool))
(pub fn (vecIsNull v)
  (addrEq (addrOf v) (addrOf 0)))

(pub :: nilWords Ints)
;@axiom:effect(unsafe)
(pub fn (nilWords)
  (as 0 Ints))

(pub :: nilNames Names)
;@axiom:effect(unsafe)
(pub fn (nilNames)
  (as 0 Names))

(pub :: nodesNew Nodes)
(pub fn (nodesNew)
  vecNew)

(pub :: namesNew Names)
(pub fn (namesNew)
  vecNew)

; A replacement payload keeps its ownership type through syntax cloning.
(pub data AstPayload
  (AstWord Int)
  (AstText String)
  (AstChild ASTNode)
  (AstChildren Nodes)
  (AstNames Names)
  (AstWords Ints))
