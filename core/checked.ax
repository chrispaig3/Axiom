; The synchronous compilation handoff. Only a successful final check
; constructs this sealed value; emission consumes it once. The driver
; keeps AST payloads private and makes no edits after this check. The
; declaration list and nested syntax are snapshotted before emission.
; This retains existing checker facts, including their incompleteness;
; it does not turn the word-based backend into a typed semantic IR.
(import core)
(import parser)
(import typecheck)
(import codegen)
(import diag)
(import Vec)
(import Mem)
(import Str)

(pub struct CheckedProgram sealed
  (declarations : Nodes)
  (inputDeclarations : Nodes)
  (functions : (Vec FnEnt))
  (syntax : (Vec CheckedSyntax))
  (mut available : Bool))

(pub struct CheckedResult
  (diagnostics : Diags)
  (program : (Option CheckedProgram)))

; Called after import resolution, expansion and any generated bindings.
; Neither errors nor their poisoned syntax receive an emission value.
(pub :: checkExpandedProgram (-> Nodes Nodes Units CheckedResult))
(pub fn (checkExpandedProgram entry declarations units)
  {
    (let tc (checkModuleTcTyped entry declarations units))
    (let diagnostics (tcOutVec tc))
    (let program
      (if (> (countErrorDiags diagnostics) 0)
        None
        {
          (wordLowerApply tc)
          (Some
            (CheckedProgram
              :declarations (checkedCopyDeclarations declarations)
              :inputDeclarations declarations
              :functions (tcFnsVec tc)
              :syntax (checkedSnapshot declarations)
              :available true))
        }))
    (CheckedResult :diagnostics diagnostics :program program)
  })

; Keep the accepted roots alive independently of the caller's vector.
; This copies handles, not AST payloads or their checked stamps.
(:: checkedCopyDeclarations (-> Nodes Nodes))
(fn (checkedCopyDeclarations declarations)
  {
    (let accepted (vecWithCapacity (vecLen declarations)))
    (for declaration in declarations
      (vecPush accepted declaration))
    accepted
  })

;; Whether the merged declaration list still has its checked members
;; in their checked order. Nested AST edits are outside this predicate.
(pub :: checkedDeclarationsUnchanged (-> CheckedProgram Bool))
(pub fn (checkedDeclarationsUnchanged program)
  (if (!= (vecLen program.declarations) (vecLen program.inputDeclarations))
    false
    {
      (let mut unchanged true)
      (let mut i 0)
      (while (&& unchanged (< i (vecLen program.declarations)))
        {
          (set unchanged (nodeSame (vecGet program.declarations i)
                           (vecGet program.inputDeclarations i)))
          (set i (+ i 1))
        })
      unchanged
    }))

; Exact retained copies, rather than hashes. The node copy owns its old
; payloads, and typed vector copies retain any members a caller replaces.
; This covers structural syntax and replacement of node metadata slots.
; Packed auxiliary metadata and raw writes through string aliases remain
; outside the snapshot; this is not a fully immutable semantic IR.
(data CheckedSyntax
  (CheckedNodeBatch Nodes Nodes)
  (CheckedNodesBatch (Vec Nodes) (Vec Nodes))
  (CheckedNamesBatch (Vec Names) (Vec Names)))

; The three payload slots: n is a node, N a node vector, S a name vector.
; Other slots are compared as words but their contents are not traversed.
; Checker-only stamps are not parsed syntax: in particular tag 53 also
; names extern declarations, so following every ty slot as syntax is wrong.
(:: checkedSyntaxShape (-> Int String))
(fn (checkedSyntaxShape tag)
  (match tag
    (0 "wnw")
    (1 "www")
    (2 "www")
    (3 "www")
    (4 "nnw")
    (5 "Snw")
    (6 "wnn")
    (7 "nnn")
    (8 "Nww")
    (9 "nww")
    (10 "wSn")
    (11 "www")
    (12 "wNw")
    (13 "wNN")
    (14 "wSw")
    (15 "wSn")
    (16 "nNw")
    (17 "nnw")
    (20 "www")
    (21 "www")
    (22 "www")
    (23 "www")
    (24 "wnn")
    (25 "wnw")
    (26 "nNw")
    (27 "nww")
    (28 "nwn")
    (30 "wSN")
    (32 "www")
    (33 "wNw")
    (34 "nnw")
    (35 "Nww")
    (37 "nww")
    (38 "www")
    (39 "www")
    (40 "wNw")
    (42 "nNn")
    (43 "wNN")
    (47 "wnS")
    (50 "wNw")
    (51 "wnN")
    (52 "wnN")
    (53 "wSN")
    (54 "wnw")
    (55 "wnN")
    (56 "nNn")
    (57 "nww")
    (_ "www")))

; nilNode is never visited, so its address marks an empty slot.
; The append-only pending queue keeps every visited node live.
; Addr keeps exact identity without retaining a second graph of nodes.
(struct CheckedSeen
  (mut slots : (Vec Addr))
  (mut count : Int))

(:: checkedSeenTable (-> Int (Vec Addr)))
(fn (checkedSeenTable capacity)
  {
    (let slots (vecWithCapacity capacity))
    (for i in 0..capacity
      (vecPush slots (addrOf nilNode)))
    slots
  })

(:: checkedSeenNew CheckedSeen)
(fn (checkedSeenNew)
  (CheckedSeen :slots (checkedSeenTable 16) :count 0))

(:: checkedSeenIndex (-> Addr Int Int))
(fn (checkedSeenIndex node capacity)
  (& (addrHash node) (- capacity 1)))

; Every table has an empty slot at the three-quarter load bound.
; Bound the scan as well, so a broken internal table fails closed.
(:: checkedSeenFind (-> Addr (Vec Addr) Int))
(fn (checkedSeenFind node slots)
  {
    (let capacity (vecLen slots))
    (let mut index (checkedSeenIndex node capacity))
    (let mut steps 0)
    (let mut found false)
    (while (&& (! found) (< steps capacity))
      {
        (let other (vecGet slots index))
        (if (|| (addrEq other (addrOf nilNode)) (addrEq node other))
          (set found true)
          (set index (& (+ index 1) (- capacity 1))))
        (set steps (+ steps 1))
      })
    (if found
      index
      __indexTrap)
  })

(:: checkedSeenGrow (-> CheckedSeen Int))
(fn (checkedSeenGrow seen)
  {
    (let old seen.slots)
    (let capacity (vecLen old))
    ; Keep doubling within Vec's byte-count range before arithmetic.
    (if (> capacity 288230376151711744)
      __indexTrap)
    (let slots (checkedSeenTable (* capacity 2)))
    (for i in 0..capacity
      {
        (let node (vecGet old i))
        (if (! (addrEq node (addrOf nilNode)))
          (vecSet slots (checkedSeenFind node slots) node))
      })
    (set seen.slots slots)
    0
  })

; Each node is visited once even when syntax shares a subtree or cycles.
(:: checkedVisit (-> ASTNode CheckedSeen Bool))
(fn (checkedVisit node seen)
  (if (nodeSame node nilNode)
    false
    {
      (let address (addrOf node))
      (let slots seen.slots)
      (let index (checkedSeenFind address slots))
      (if (addrEq address (vecGet slots index))
        false
        {
          ; A duplicate does not grow the table. Recompute its slot only
          ; after growth, because the larger mask changes probe chains.
          (if (>= seen.count (- (vecLen slots) (/ (vecLen slots) 4)))
            (checkedSeenGrow seen))
          (vecSet seen.slots (checkedSeenFind address seen.slots) address)
          (set seen.count (+ seen.count 1))
          true
        })
    }))

(:: checkedSnapshotNodes (-> Nodes Nodes (Vec Nodes) (Vec Nodes) Int))
(fn (checkedSnapshotNodes nodes pending originals copies)
  (if (vecIsNull nodes)
    0
    {
      (let accepted (checkedCopyDeclarations nodes))
      (vecPush originals nodes)
      (vecPush copies accepted)
      (for node in accepted
        (vecPush pending node))
      0
    }))

(:: checkedSnapshotNames (-> Names (Vec Names) (Vec Names) Int))
(fn (checkedSnapshotNames names originals copies)
  (if (vecIsNull names)
    0
    {
      (let accepted (vecWithCapacity (vecLen names)))
      (for name in names
        (vecPush accepted name))
      (vecPush originals names)
      (vecPush copies accepted)
      0
    }))

(:: checkedSnapshot (-> Nodes (Vec CheckedSyntax)))
(fn (checkedSnapshot declarations)
  {
    ; Keep each kind's exact original/copy pairs in typed vectors.
    ; The wrappers are built once, after the synchronous walk.
    (let originalNodes vecNew)
    (let copiedNodes vecNew)
    (let originalChildren vecNew)
    (let copiedChildren vecNew)
    (let originalNames vecNew)
    (let copiedNames vecNew)
    (let pending (checkedCopyDeclarations declarations))
    (let seen checkedSeenNew)
    (let mut i 0)
    (while (< i (vecLen pending))
      {
        (let node (vecGet pending i))
        (set i (+ i 1))
        (if (checkedVisit node seen)
          {
            (vecPush originalNodes node)
            (vecPush copiedNodes (nodeClone node))
            (let tag (nodeTag node))
            (let shape (checkedSyntaxShape tag))
            (let mut slot 1)
            (while (<= slot 3)
              {
                (let kind (strByte shape (- slot 1)))
                (if (== kind 110)
                    (vecPush pending (nodeChildAt node slot))
                  (== kind 78)
                    (checkedSnapshotNodes (nodeChildrenAt node slot) pending originalChildren
                      copiedChildren)
                  (== kind 83)
                    (checkedSnapshotNames (nodeNamesAt node slot) originalNames copiedNames)
                  0)
                (set slot (+ slot 1))
              })
            ; Type syntax on declarations has a fixed payload view.
            (if (|| (== tag TAG_D_SIG) (== tag TAG_FIELD))
                (vecPush pending (nodeTyChild node))
              (== tag TAG_CTOR)
                (checkedSnapshotNodes (nodeTyChildren node) pending originalChildren copiedChildren)
              (|| (== tag TAG_D_DATA) (== tag TAG_D_STRUCT))
                (checkedSnapshotNames (nodeTyNames node) originalNames copiedNames)
              0)
            ; Effect and extern members put their type in b. Struct
            ; fields put a 0/1 flag there and keep their type in ty.
            (if (&& (== tag TAG_FIELD) (> (nodeB node) 1))
              (vecPush pending (nodeBChild node)))
            (if (|| (== tag TAG_CTOR) (== tag TAG_E_APP))
              (checkedSnapshotNames (nodeFieldNamesNames node) originalNames copiedNames))
          })
      })
    (let snapshots (vecWithCapacity 3))
    (if (> (vecLen originalNodes) 0)
      (vecPush snapshots (CheckedNodeBatch originalNodes copiedNodes)))
    (if (> (vecLen originalChildren) 0)
      (vecPush snapshots (CheckedNodesBatch originalChildren copiedChildren)))
    (if (> (vecLen originalNames) 0)
      (vecPush snapshots (CheckedNamesBatch originalNames copiedNames)))
    snapshots
  })

(:: checkedNodesSame (-> Nodes Nodes Bool))
(fn (checkedNodesSame actual accepted)
  {
    (let mut same (== (vecLen actual) (vecLen accepted)))
    (let mut i 0)
    (while (&& same (< i (vecLen accepted)))
      {
        (set same (nodeSame (vecGet actual i) (vecGet accepted i)))
        (set i (+ i 1))
      })
    same
  })

(:: checkedNodeSame (-> ASTNode ASTNode Bool))
(fn (checkedNodeSame actual accepted)
  {
    (let mut same true)
    (let mut slot 0)
    (while (&& same (< slot 13))
      {
        (set same (== (nodeWireWord actual slot) (nodeWireWord accepted slot)))
        (set slot (+ slot 1))
      })
    same
  })

(:: checkedNamesSame (-> Names Names Bool))
(fn (checkedNamesSame actual accepted)
  {
    (let mut same (== (vecLen actual) (vecLen accepted)))
    (let mut i 0)
    (while (&& same (< i (vecLen accepted)))
      {
        (set same (addrEq (addrOf (vecGet actual i)) (addrOf (vecGet accepted i))))
        (set i (+ i 1))
      })
    same
  })

(:: checkedSyntaxSame (-> CheckedSyntax Bool))
(fn (checkedSyntaxSame snapshot)
  (match snapshot
    ((CheckedNodeBatch actual accepted)
      {
        (let mut same (== (vecLen actual) (vecLen accepted)))
        (let mut i 0)
        (while (&& same (< i (vecLen accepted)))
          {
            (set same (checkedNodeSame (vecGet actual i) (vecGet accepted i)))
            (set i (+ i 1))
          })
        same
      }
    )
    ((CheckedNodesBatch actual accepted)
      {
        (let mut same (== (vecLen actual) (vecLen accepted)))
        (let mut i 0)
        (while (&& same (< i (vecLen accepted)))
          {
            (set same (checkedNodesSame (vecGet actual i) (vecGet accepted i)))
            (set i (+ i 1))
          })
        same
      }
    )
    ((CheckedNamesBatch actual accepted)
      {
        (let mut same (== (vecLen actual) (vecLen accepted)))
        (let mut i 0)
        (while (&& same (< i (vecLen accepted)))
          {
            (set same (checkedNamesSame (vecGet actual i) (vecGet accepted i)))
            (set i (+ i 1))
          })
        same
      }
    )))

;; Whether an available handoff's snapshotted syntax nodes, child lists
;; and name lists still have their accepted contents. Consumed handoffs
;; answer false. Packed auxiliary metadata is not covered.
(pub :: checkedSyntaxUnchanged (-> CheckedProgram Bool))
(pub fn (checkedSyntaxUnchanged program)
  (if (! program.available)
    false
    {
      (let mut same true)
      (let mut i 0)
      (while (&& same (< i (vecLen program.syntax)))
        {
          (set same (checkedSyntaxSame (vecGet program.syntax i)))
          (set i (+ i 1))
        })
      same
    }))

(pub :: checkedProgramOf (-> CheckedResult CheckedProgram))
;@axiom:pre((isSome result.program))
(pub fn (checkedProgramOf result)
  (if (let (Some program) result.program)
    program
    __indexTrap))

; Pass semantic types without exposing the checker's packed context to
; emission. The complete entries stay owned by the checked handoff.
(:: checkedFunctionTypes (-> (Vec FnEnt) FunctionTypes))
(fn (checkedFunctionTypes functions)
  {
    (let types (vecWithCapacity (vecLen functions)))
    (for entry in functions
      (if (&& (== entry.isBuiltin 0) (== entry.isEffectOp 0))
        ; Keep unresolved arity distinct from a real nullary definition.
        (vecPush types (FunctionType :name entry.name :ty entry.ty :arity entry.paramCount))))
    types
  })

; The type, effect and region records stay owned by the handoff while
; the emitter uses the checked AST stamps for representation decisions.
; Unknown effects and absent region facts retain their original status.
(pub :: emitCheckedProgram (-> CheckedProgram Names Names Int Bool String))
;@axiom:effect(io)
;@axiom:pre(program.available)
;@axiom:pre((checkedDeclarationsUnchanged program))
;@axiom:pre((checkedSyntaxUnchanged program))
(pub fn (emitCheckedProgram program bares fulls target obscure)
  {
    (set program.available false)
    ; All entry guards have accepted this one-shot handoff. Its exact
    ; structural copies no longer serve a check; retire them before the
    ; emitter builds its line buffer, while keeping accepted roots and
    ; checked function facts alive.
    (vecClear program.syntax)
    (emitResolvedMode program.declarations (checkedFunctionTypes program.functions) bares fulls
      target obscure)
  })
