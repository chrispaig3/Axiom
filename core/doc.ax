;;! `axiom doc`: the documentation ds and the standard library
;;! reference as HTML on this machine, opened in the browser. The
;;! pages come from `docs/`, the root prose files and the library
;;! sources; the language index comes from `lexicon.ax`; every page is
;;! rendered by `markdown.ax` and every doc comment is read by
;;! `doccomment.ax`. `--missing` is the documentation gap report.
;
; WHERE THE PAGES COME FROM. `AXIOM_DOC` names the directory holding
; `docs/`, `README.md`, `CONTRIBUTING.md`, `CHANGELOG.md` and
; `examples/README.md`; without it the set is looked for beside the
; executable, `<exe>/../` for an installed prefix and `<exe>/../../`
; for a build tree, the way `codegen.ax`'s `pushExeRelStdlib` finds
; the library. A release archive carries `docs/`, `README.md` and
; `CHANGELOG.md`, so an installed compiler renders those; a source
; checkout renders everything.
;
; WHERE THEY GO. `--out DIR`, else `$XDG_CACHE_HOME/axiom/doc`, else
; `$HOME/.cache/axiom/doc`, else `$TMPDIR/axiom-doc`. Every page is a
; file, one shared `style.css`, and a sidebar listing every page by
; its first heading, so the set reads offline with no server.
;
; LINKS. A link to a page in the set becomes a link to its HTML; a
; link to any other file in the tree (a gate script, a fixture, a
; source file) becomes a `file://` link to that file, so it still
; opens from a source checkout and visibly dangles from an install.
(import core)
(import Host)
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Sys)
(import Path)
(import IO
  (copyFile cwd die fileExists isDir listDir makeDirAll readFile stdout writeFile writeStr))
(import lexer)
(import parser)
(import lexicon)
(import markdown)
(import doccomment)
(import lsp (lspFormStart lspFormText lspLineIndex lspLineOfIx))
(import codegen (pathOfCommand stdlibSearchDirs))
(import driver (flagValue hasFlagAnywhere operandStart positionalIndex writeStderrStr))
(import diag (catStrs))
(import raw)

; The whole set, once found: where it is, where it goes, and the
; pages and modules it holds. `srcs` are root-relative sources
; (`docs/reference.md`) and `outs` their output paths
; (`reference.html`); `modFiles` are library and named sources, with
; `modOuts` their output paths (`stdlib/Fmt.html`, `modules/X.html`)
; and `modNames` the module names.
(pub struct DocSet
  (root : String)
  (out : String)
  (srcs : (Vec String))
  (outs : (Vec String))
  (titles : (Vec String))
  (modFiles : (Vec String))
  (modOuts : (Vec String))
  (modNames : (Vec String))
  (modNamed : (Vec Int)))

; What a page's link mapper needs: the set, the directory the page's
; source sits in (root-relative, "" for the root), and the prefix
; that takes an `href` from the page's output directory back to the
; output root ("", "../", "../../").
(pub struct DocCtx
  (pages : DocSet)
  (srcDir : String)
  (prefix : String))

; ------------------------------------------------------------------
; Paths
; ------------------------------------------------------------------
(pub :: docEndsWith (-> String String Bool))
(pub fn (docEndsWith s suffix)
  {
    (let n (strLen s))
    (let m (strLen suffix))
    (if (> m n)
      false
      (strEq (strSlice s (- n m) m) suffix))
  })

; `p` as an absolute path, resolved against the working directory
; when it is relative, with `.` and `..` folded.
(pub :: docAbsolute (-> String String))
;@axiom:effect(io)
(pub fn (docAbsolute p)
  (if (pathIsAbsolute p)
    (pathClean p)
    {
      (let here
        (match cwd
          ((Ok d) d)
          ((Err _) ".")))
      (pathClean (concat (pathWithSlash here) p))
    }))

; How many `/` separate `out` from the output root: `stdlib/Fmt.html`
; is one level down, `stdlib/Sys/Platform.darwin.html` two.
(pub :: docDepthPrefix (-> String String))
(pub fn (docDepthPrefix out)
  {
    (let p (strBuilderNew))
    {
      (for i in 0..(strLen out)
        (if (== (strByte out i) 47)
          (strBuilderPush p "../")))
      (strBuilderFinish p)
    }
  })

; The directory part of a root-relative path, without its slash:
; `docs/reference.md` answers `docs`, `README.md` answers "".
(pub :: docDirOf (-> String String))
(pub fn (docDirOf rel)
  {
    (let d (pathDir rel))
    (if (== (strLen d) 0)
      ""
      (strSlice d 0 (- (strLen d) 1)))
  })

; ------------------------------------------------------------------
; Links
; ------------------------------------------------------------------
; The first matching index, including zero, or None.
(pub :: docIndexOf (-> Strings String (Option Int)))
(pub fn (docIndexOf v s)
  {
    (let n (vecLen v))
    (let mut i 0)
    (let mut at (:: None (Option Int)))
    {
      (while (&& (< i n) (isNone at))
        {
          (if (strEq (vecGet v i) s)
            (set at (Some i)))
          (set i (+ i 1))
        })
      at
    }
  })

; A link target as written on the page to the `href` the HTML
; carries, for the page `c` describes.
(pub :: docLink (-> DocCtx String String))
(pub fn (docLink c target)
  (if (|| (strStartsWith target "#")
        (|| (strStartsWith target "http://")
          (|| (strStartsWith target "https://")
            (|| (strStartsWith target "mailto:") (strStartsWith target "file:")))))
    target
    {
      (let path
        (if (let (Some k) (strFindByte target 35 0))
          (strSlice target 0 k)
          target))
      (let frag
        (if (let (Some k) (strFindByte target 35 0))
          (strSlice target k (- (strLen target) k))
          ""))
      {
        (let resolved
          (pathClean
            (if (== (strLen c.srcDir) 0)
              path
              (concat (concat c.srcDir "/") path))))
        {
          (let ds c.pages)
          (if (let (Some at) (docIndexOf ds.srcs resolved))
            (concat (concat c.prefix (vecGet ds.outs at)) frag)
            (concat (concat "file://" (concat ds.root resolved)) frag))
        }
      }
    }))

; ------------------------------------------------------------------
; The page shell
; ------------------------------------------------------------------
(pub :: docStyle String)
(pub fn (docStyle)
  ":root{--bg:#0b0d0c;--fg:#f1f3ea;--muted:#8b9788;--line:#29312a;--side:#101311;--link:#c3f36b;--code:#131714;--k:#ff79c6;--t:#5ce1e6;--e:#ffb638;--o:#b3bbae;--l:#c3f36b;--n:#ff9f5a;--s:#6bffab;--c:#8b9e8d;--d:#8b9e8d;--a:#c49bff;--x:#ff6b6b}\n@media(prefers-color-scheme:light){:root{--bg:#f6f5ef;--fg:#0f1f16;--muted:#5b695f;--line:#d4dacb;--side:#eeeee5;--link:#3c6514;--code:#fdfdf8;--k:#a626a4;--t:#0b6e6e;--e:#945700;--o:#33463a;--l:#3c6514;--n:#b35c00;--s:#1f7a3a;--c:#5b695f;--d:#5b695f;--a:#7a3fa8;--x:#b3261e}}\n*{box-sizing:border-box}\nhtml{font-size:17px}\nbody{margin:0;background:var(--bg);color:var(--fg);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;line-height:1.55}\na{color:var(--link);text-decoration:none}\na:hover{text-decoration:underline}\nnav.side{position:fixed;top:0;left:0;bottom:0;width:17rem;overflow-y:auto;padding:1.25rem 1rem;background:var(--side);border-right:1px solid var(--line);font-size:.92rem}\nnav.side .brand{font-weight:700;font-size:1.1rem;margin:0 0 1rem}nav.side .brand-logo{width:2.2rem;height:2.2rem;fill:var(--link);display:block}\nnav.side h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:1.2rem 0 .35rem}\nnav.side ul{list-style:none;margin:0;padding:0}\nnav.side li{margin:.15rem 0}\nnav.side a{color:var(--fg)}\nnav.side a.here{font-weight:700;color:var(--link)}\nmain{max-width:46rem;margin:0 auto;padding:2rem 1.25rem 4rem;margin-left:19rem}\n@media(max-width:62rem){nav.side{position:static;width:auto;border-right:0;border-bottom:1px solid var(--line);padding:1rem}main{margin-left:auto;padding:1.5rem 1rem 3rem}}\nh1,h2,h3,h4{line-height:1.25;margin:1.6em 0 .5em}\nh1{font-size:1.9rem;margin-top:.2em}\nh2{font-size:1.4rem;border-bottom:1px solid var(--line);padding-bottom:.2em}\nh3{font-size:1.12rem}\np,ul,ol,blockquote,table,pre{margin:0 0 1em}\nli{margin:.2em 0}\nli>ul,li>ol{margin-bottom:0}\ncode{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.92em;background:var(--code);padding:.08em .3em;border-radius:3px}\npre{background:var(--code);padding:.8em 1em;border-radius:6px;overflow-x:auto;line-height:1.45}\npre code{background:none;padding:0;font-size:.88em}\nblockquote{border-left:3px solid var(--line);margin-left:0;padding-left:1em;color:var(--muted)}\ntable{border-collapse:collapse;width:100%;font-size:.94em;display:block;overflow-x:auto}\nth,td{border:1px solid var(--line);padding:.35em .6em;text-align:left;vertical-align:top}\nth{background:var(--side)}\nhr{border:0;border-top:1px solid var(--line);margin:2em 0}\nimg{max-width:100%}\n.path{color:var(--muted);margin-top:-.6em}\n.decl{margin:1.5em 0;padding-top:.4em;border-top:1px solid var(--line)}\n.decl h3{margin:.4em 0 .5em}\n.decl h3 a{color:var(--fg)}\n.kind{font-size:.75rem;font-weight:400;color:var(--muted);margin-left:.6em;text-transform:uppercase;letter-spacing:.05em}\n.nodoc{color:var(--x);font-style:italic}\n.k{color:var(--k);font-weight:600}\n.t{color:var(--t)}\n.e{color:var(--e)}\n.o{color:var(--o)}\n.l{color:var(--l)}\n.n{color:var(--n)}\n.s{color:var(--s)}\n.c{color:var(--c);font-style:italic}\n.d{color:var(--d);font-style:italic}\n.a{color:var(--a)}\n.x{color:var(--x);text-decoration:underline wavy}\n")

; One sidebar entry; the page being rendered is marked.
(pub :: docNavItem (-> String String String String String))
(pub fn (docNavItem prefix out title here)
  (concat
    (concat (concat "<li><a href=\"" (mdEscape (concat prefix out)))
      (if (strEq out here)
        "\" class=\"here\">"
        "\">"))
    (concat (mdEscape title) "</a></li>\n")))

; The group a source page belongs to: 0 Start, 1 Guides, 2
; Specifications.
(pub :: docGroupOf (-> String Int))
(pub fn (docGroupOf src)
  (if (|| (strEq src "docs/README.md")
        (|| (strEq src "README.md")
          (|| (strEq src "docs/reference.md")
            (|| (strEq src "docs/stdlib.md")
              (|| (strEq src "docs/stdlib-api.md")
                (|| (strEq src "examples/README.md")
                  (|| (strEq src "docs/status.md")
                    (|| (strEq src "docs/roadmap.md")
                      (|| (strEq src "CHANGELOG.md") (strEq src "CONTRIBUTING.md"))))))))))
    0
    (if (|| (strEq src "docs/memory-model.md")
          (|| (strEq src "docs/macro-system.md")
            (|| (strEq src "docs/error-model.md") (strEq src "docs/axqlite-format.md"))))
      2
      1)))

; The Start group in reading order rather than file order.
(pub :: docStartOrder Strings)
(pub fn (docStartOrder)
  {
    (let v vecNew)
    {
      (vecPush v "docs/README.md")
      (vecPush v "README.md")
      (vecPush v "docs/reference.md")
      (vecPush v "docs/stdlib.md")
      (vecPush v "docs/stdlib-api.md")
      (vecPush v "examples/README.md")
      (vecPush v "docs/status.md")
      (vecPush v "docs/roadmap.md")
      (vecPush v "CHANGELOG.md")
      (vecPush v "CONTRIBUTING.md")
      v
    }
  })

(pub :: docNavGroup (-> DocSet String String Int String String))
(pub fn (docNavGroup ds prefix here group heading)
  {
    (let frags vecNew)
    (let mut i 0)
    {
      (vecPush frags (concat (concat "<h2>" heading) "</h2>\n<ul>\n"))
      (if (== group 0)
        {
          (let order docStartOrder)
          (while (< i (vecLen order))
            {
              (if (let (Some at) (docIndexOf ds.srcs (vecGet order i)))
                (vecPush frags (docNavItem prefix (vecGet ds.outs at) (vecGet ds.titles at) here)))
              (set i (+ i 1))
            })
        }
        (while (< i (vecLen ds.srcs))
          {
            (if (== (docGroupOf (vecGet ds.srcs i)) group)
              (vecPush frags (docNavItem prefix (vecGet ds.outs i) (vecGet ds.titles i) here)))
            (set i (+ i 1))
          }))
      (vecPush frags "</ul>\n")
      (catStrs frags)
    }
  })

(pub :: docNavModules (-> DocSet String String Int String String))
(pub fn (docNavModules ds prefix here named heading)
  {
    (let frags vecNew)
    (let mut any 0)
    {
      (for i in 0..(vecLen ds.modFiles)
        (if (== (vecGet ds.modNamed i) named)
          {
            (if (== any 0)
              (vecPush frags (concat (concat "<h2>" heading) "</h2>\n<ul>\n")))
            (set any 1)
            (vecPush frags (docNavItem prefix (vecGet ds.modOuts i) (vecGet ds.modNames i) here))
          }))
      (if (== any 1)
        (vecPush frags "</ul>\n"))
      (catStrs frags)
    }
  })

(pub :: docSidebar (-> DocSet String String String))
(pub fn (docSidebar ds prefix here)
  (concat
    (concat
      (concat
        (concat "<nav class=\"side\">\n<p class=\"brand\"><a href=\""
          (mdEscape (concat prefix "index.html")))
        "\"><svg class=\"brand-logo\" viewBox=\"0 0 64 64\" role=\"img\" aria-label=\"Axiom\"><path d=\"M32 4 62 60H48L32 28 25.5 41H33L38.5 52H20L16 60H2Z\"/></svg></a></p>\n")
      (concat (docNavGroup ds prefix here 0 "Start") (docNavGroup ds prefix here 1 "Guides")))
    (concat
      (concat (docNavGroup ds prefix here 2 "Specifications")
        (docNavModules ds prefix here 0 "Standard library"))
      (concat (docNavModules ds prefix here 1 "Modules")
        (concat
          (concat "<h2>Language index</h2>\n<ul>\n"
            (docNavItem prefix "language.html" "Language index" here))
          "</ul>\n</nav>\n")))))

; A whole page around a rendered body.
(pub :: docPage (-> DocSet String String String String))
(pub fn (docPage ds out title body)
  {
    (let prefix (docDepthPrefix out))
    (concat
      (concat
        (concat
          "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>"
          (mdEscape
            (if (== (strLen title) 0)
              "Axiom"
              (concat title " - Axiom"))))
        (concat
          (concat "</title>\n<link rel=\"stylesheet\" href=\""
            (mdEscape (concat prefix "style.css")))
          "\">\n</head>\n<body>\n"))
      (concat (docSidebar ds prefix out)
        (concat (concat "<main>\n" body) "</main>\n</body>\n</html>\n")))
  })

; ------------------------------------------------------------------
; Writing
; ------------------------------------------------------------------
; Write `text` at `out/rel`, making the directories above it.
(pub :: docWrite (-> DocSet String String Int))
;@axiom:effect(io)
(pub fn (docWrite ds rel text)
  {
    (let path (concat ds.out rel))
    {
      (match (makeDirAll (pathDir path))
        ((Ok _) ())
        ((Err _) (die (concat (concat "error: cannot create " (pathDir path)) "\n") 1)))
      (match (writeFile path text)
        ((Ok _) 0)
        ((Err _) (die (concat (concat "error: cannot write " path) "\n") 1)))
    }
  })

; Copy every image a page named beside its output. `fromDir` is the
; slash-terminated directory the page's source sits in.
(pub :: docCopyImages (-> DocSet String String Strings Int))
;@axiom:effect(io)
(pub fn (docCopyImages ds fromDir out images)
  {
    (for img in images
      {
        (let from (pathClean (concat fromDir img)))
        (let to (concat ds.out (pathClean (concat (pathDir out) img))))
        (if (fileExists from)
          {
            (match (makeDirAll (pathDir to))
              ((Ok _) ())
              ((Err _) ()))
            (match (copyFile from to)
              ((Ok _) ())
              ((Err _) (writeStderrStr (concat (concat "warning: could not copy " from) "\n"))))
          }
          (writeStderrStr (concat (concat "warning: image not found: " from) "\n")))
      })
    0
  })

; Render one Markdown source of the set to its page.
;
; A source named on the command line is held as an absolute path. It
; is read from there, and its links resolve as a `docs/` page's do, so
; a page written beside the documentation links into it the same way.
(pub :: docRenderPage (-> DocSet Int Int))
;@axiom:effect(io)
(pub fn (docRenderPage ds i)
  {
    (let src (vecGet ds.srcs i))
    (let out (vecGet ds.outs i))
    (let images vecNew)
    {
      (let named (pathIsAbsolute src))
      {
        (let srcDir
          (if named
            "docs"
            (docDirOf src)))
        (let fromDir
          (if named
            (pathDir src)
            (concat ds.root (pathWithSlash (docDirOf src)))))
        (let text
          (unwrapOr
            (readFile
              (if named
                src
                (concat ds.root src)))
            ""))
        {
          (let ctx (DocCtx :pages ds :srcDir srcDir :prefix (docDepthPrefix out)))
          {
            (let body (mdRender text (lambda (t) (docLink ctx t)) images))
            {
              (docWrite ds out (docPage ds out (vecGet ds.titles i) body))
              (docCopyImages ds fromDir out images)
            }
          }
        }
      }
    }
  })

; ------------------------------------------------------------------
; Modules
; ------------------------------------------------------------------
; The kind a public declaration is listed under, or None for one the
; reference leaves out. The same set `examples/axdoc/axdoc.ax`
; reads: a `(pub :: …)` signature, a public `macro`, `data`, `struct`
; or `type`, and every `effect`, which is exported whether or not it
; says `pub`.
(pub :: docDeclKind (-> ASTNode (Option String)))
(pub fn (docDeclKind d)
  {
    (let tag (nodeTag d))
    (if (== tag TAG_D_EFFECT)
      (Some "effect")
      (if (!= (nodeVis d) 1)
        None
        (if (== tag TAG_D_SIG)
          (Some "value")
          (if (== tag TAG_D_MACRO)
            (Some "macro")
            (if (== tag TAG_D_DATA)
              (Some "data")
              (if (== tag TAG_D_STRUCT)
                (Some "struct")
                (if (== tag TAG_D_ALIAS)
                  (Some "type")
                  None)))))))
  })

; The parsed declarations of `path`, or an empty vector with a line
; on stderr when the file does not parse.
(pub :: docDecls (-> String String (Vec ASTNode)))
;@axiom:effect(io)
(pub fn (docDecls path src)
  {
    (let pr (parseModuleWith (lex src) (scanAxtags src)))
    (match pr
      ((ParseFailed parseError1)
        {
          (writeStderrStr
            (concat (concat "warning: " path) " does not parse; run `axiom check` on it\n"))
          vecNew
        }
      )
      ((ParseSuccess parsedValue1 parsedPos1) parsedValue1))
  })

; One public declaration as a section: its anchor, its signature or
; whole form in a fence, and its `;;` doc - or the line that says
; there is none.
(pub :: docDeclSection (-> DocSet DocCtx String (Vec ASTNode) String ASTNode String))
(pub fn (docDeclSection ds prefixCtx src decls kind d)
  {
    (let name (nodeAName d))
    (let o (lspFormStart src (spanStart (nodeSpan d))))
    {
      (let form (concat (contractSourceFor decls d) (lspFormText src o)))
      (let doc (docCommentMarked src o))
      (concat
        (concat
          (concat (concat "<section class=\"decl\" id=\"" (mdEscape name))
            (concat "\">\n<h3><a href=\"#" (mdEscape name)))
          (concat (concat "\">" (mdEscape name))
            (concat (concat "</a><span class=\"kind\">" kind) "</span></h3>\n")))
        (concat
          (concat (concat "<pre><code class=\"language-axiom\">" (mdHighlight form))
            "</code></pre>\n")
          (concat
            (if (== (strLen doc) 0)
              "<p class=\"nodoc\">No doc comment yet.</p>\n"
              (mdRender doc (lambda (t) (docLink prefixCtx t)) vecNew))
            "</section>\n")))
    }
  })

; The module page for `ds.modFiles[i]`.
(pub :: docRenderModule (-> DocSet Int Int))
;@axiom:effect(io)
(pub fn (docRenderModule ds i)
  {
    (let path (vecGet ds.modFiles i))
    (let out (vecGet ds.modOuts i))
    (let name (vecGet ds.modNames i))
    (let frags vecNew)
    {
      (let src (unwrapOr (readFile path) ""))
      (let ctx (DocCtx :pages ds :srcDir "" :prefix (docDepthPrefix out)))
      {
        (let decls (docDecls path src))
        (let mut j 0)
        (let mut count 0)
        {
          (vecPush frags (concat (concat "<h1 id=\"module\">" (mdEscape name)) "</h1>\n"))
          (vecPush frags
            (concat (concat "<p class=\"path\"><code>" (mdEscape (pathBase path))) "</code></p>\n"))
          {
            (let intro (docModuleDoc src))
            (if (== (strLen intro) 0)
              frags
              (vecPush frags (mdRender intro (lambda (t) (docLink ctx t)) vecNew)))
          }
          (while (< j (vecLen decls))
            {
              (let d (vecGet decls j))
              {
                (if (let (Some kind) (docDeclKind d))
                  (if (!= (nodeSpan d) 0)
                    {
                      (if (== count 0)
                        (vecPush frags "<h2 id=\"public-names\">Public names</h2>\n"))
                      (set count (+ count 1))
                      (vecPush frags (docDeclSection ds ctx src decls kind d))
                    }))
                (set j (+ j 1))
              }
            })
          (if (== count 0)
            (vecPush frags "<p class=\"nodoc\">No public names.</p>\n"))
          (docWrite ds out (docPage ds out name (catStrs frags)))
        }
      }
    }
  })

; `--missing`: every public declaration of `path` with no `;;` line,
; as `path:line: name` on stdout. Answers how many.
(pub :: docMissingIn (-> String Int))
;@axiom:effect(io)
(pub fn (docMissingIn path)
  {
    (let src (unwrapOr (readFile path) ""))
    {
      (let decls (docDecls path src))
      (let ix (lspLineIndex src))
      (let mut n 0)
      {
        (for d in decls
          (if (let (Some _) (docDeclKind d))
            (if (!= (nodeSpan d) 0)
              {
                (let o (lspFormStart src (spanStart (nodeSpan d))))
                (if (== (strLen (docCommentMarked src o)) 0)
                  {
                    (writeStr stdout
                      (concat (concat (concat path ":") (fmtInt (+ (lspLineOfIx ix o) 1)))
                        (concat (concat ": " (nodeAName d)) "\n")))
                    (set n (+ n 1))
                  })
              })))
        n
      }
    }
  })

; ------------------------------------------------------------------
; The language index
; ------------------------------------------------------------------
; The lexicon's entries end with a line naming their reference
; section in a code span; on this page that line is a link.
(pub :: docRefLink (-> String String))
(pub fn (docRefLink md)
  (if (let (Some at) (strFind md "Reference: `docs/" 0))
    {
      (let from (+ at 17))
      (match (strFindByte md 96 from)
        ((None) md)
        ((Some e)
          {
            (let target (strSlice md from (- e from)))
            (concat (strSlice md 0 at)
              (concat (concat (concat "Reference: [" target) (concat "](" target))
                (concat ")" (strSlice md (+ e 1) (- (strLen md) (+ e 1))))))
          }
        ))
    }
    md))

(pub :: docRenderLanguage (-> DocSet Int))
;@axiom:effect(io)
(pub fn (docRenderLanguage ds)
  {
    (let frags vecNew)
    (let words lexWords)
    (let keys lexTagKeys)
    (let ctx (DocCtx :pages ds :srcDir "docs" :prefix ""))
    {
      (vecPush frags
        "<h1 id=\"language-index\">Language index</h1>\n<p>Every word of the language: keywords, the words that are special inside a form, builtin types, effects, operators and literals, then the AXTAG keys. <code>axiom explain WORD</code> prints the same entry, and hover in your editor shows it.</p>\n<h2 id=\"words\">Words</h2>\n")
      (for (w i) in words
        {
          (vecPush frags
            (concat
              (concat (concat "<section class=\"decl\" id=\"word-" (fmtInt (+ i 1)))
                "\">\n<h3><code>")
              (concat (mdEscape w) "</code></h3>\n")))
          (vecPush frags
            (mdRender (docRefLink (lexEntryMarkdown w)) (lambda (t) (docLink ctx t)) vecNew))
          (vecPush frags "</section>\n")
        })
      (vecPush frags "<h2 id=\"axtag-keys\">AXTAG keys</h2>\n")
      (for k in keys
        {
          (vecPush frags
            (concat
              (concat (concat "<section class=\"decl\" id=\"tag-" (mdEscape k))
                "\">\n<h3><code>;@axiom:")
              (concat (mdEscape k) "</code></h3>\n")))
          (vecPush frags
            (mdRender (docRefLink (lexTagMarkdown k "")) (lambda (t) (docLink ctx t)) vecNew))
          (vecPush frags "</section>\n")
        })
      (docWrite ds "language.html" (docPage ds "language.html" "Language index" (catStrs frags)))
    }
  })

; ------------------------------------------------------------------
; Finding the set
; ------------------------------------------------------------------
(pub :: docRootOk (-> String Bool))
;@axiom:effect(io)
(pub fn (docRootOk root)
  (fileExists (concat root "docs/README.md")))

; The directory holding the set, slash-terminated, or None. `AXIOM_DOC`
; when it is set; otherwise beside the executable, resolved through
; `PATH` when the shell handed over a bare name, the way the library
; is found.
(pub :: docFindRoot (Option String))
;@axiom:effect(io)
(pub fn (docFindRoot)
  {
    (let env (sysEnv "AXIOM_DOC"))
    (if (> (strLen env) 0)
      (if (docRootOk (pathWithSlash env))
        (Some (pathWithSlash env))
        None)
      {
        (let exe (pathDir (sysArg 0)))
        (let cands vecNew)
        (let mut i 0)
        (let mut found (:: None (Option String)))
        {
          (if (== (strLen exe) 0)
            {
              (let on (pathOfCommand (sysArg 0)))
              (if (> (strLen on) 0)
                {
                  (vecPush cands (concat on "../"))
                  (vecPush cands (concat on "../../"))
                })
            })
          (vecPush cands (concat exe "../"))
          (vecPush cands (concat exe "../../"))
          (while (&& (< i (vecLen cands)) (isNone found))
            {
              (if (docRootOk (vecGet cands i))
                (set found (Some (vecGet cands i))))
              (set i (+ i 1))
            })
          found
        }
      })
  })

; The output directory: `--out`, else the cache.
(pub :: docOutDir String)
;@axiom:effect(io)
(pub fn (docOutDir)
  (match (flagValue "--out" 1)
    ((None) docDefaultOutDir)
    ((Some flag)
      (if (> (strLen flag) 0)
        flag
        docDefaultOutDir)
    )))

; An absent or empty --out selects the same cache directory policy.
(:: docDefaultOutDir String)
;@axiom:effect(io)
(fn (docDefaultOutDir)
  {
    (let xdg (sysEnv "XDG_CACHE_HOME"))
    (if (> (strLen xdg) 0)
      (concat (pathWithSlash xdg) "axiom/doc")
      {
        (let home (sysEnv "HOME"))
        (if (> (strLen home) 0)
          (concat (pathWithSlash home) ".cache/axiom/doc")
          {
            (let tmp (sysEnv "TMPDIR"))
            (if (> (strLen tmp) 0)
              (concat (pathWithSlash tmp) "axiom-doc")
              "/tmp/axiom-doc")
          })
      })
  })

; The library's directory, slash-terminated, or None.
(pub :: docStdlibDir (Option String))
;@axiom:effect(io)
(pub fn (docStdlibDir)
  {
    (let dirs stdlibSearchDirs)
    (let mut i 0)
    (let mut found (:: None (Option String)))
    {
      (while (&& (< i (vecLen dirs)) (isNone found))
        {
          (if (isDir (vecGetStr dirs i))
            (set found (Some (vecGetStr dirs i))))
          (set i (+ i 1))
        })
      found
    }
  })

; Every `.ax` under `dir`, as paths relative to it, in listing order.
(pub :: docWalk (-> String String Strings Strings))
;@axiom:effect(io)
(pub fn (docWalk dir rel acc)
  {
    (let names (unwrapOr (listDir (concat dir rel)) vecNew))
    (let mut i 0)
    {
      (while (< i (vecLen names))
        {
          (let name (vecGet names i))
          {
            (if (isDir (concat (concat dir rel) name))
              (docWalk dir (concat (concat rel name) "/") acc)
              (if (docEndsWith name ".ax")
                (vecPush acc (concat rel name))))
            (set i (+ i 1))
          }
        })
      acc
    }
  })

; `Sys/Platform.darwin.ax` is the module `Sys.Platform`, built for
; darwin; the page says both.
(pub :: docModuleName (-> String String))
(pub fn (docModuleName rel)
  {
    (let stem (strSlice rel 0 (- (strLen rel) 3)))
    (let out (strAlloc (strLen rel)))
    (let mut i 0)
    (let mut k 0)
    (let mut dots 0)
    {
      (while (< i (strLen stem))
        {
          (let c (strByte stem i))
          {
            (if (== c 47)
              (memPutByte (strData out) k 46)
              (if (== c 46)
                {
                  (set dots (+ dots 1))
                  (memPutByte (strData out) k
                    (if (== dots 1)
                      32
                      46))
                }
                (memPutByte (strData out) k c)))
            (set k (+ k 1))
            (set i (+ i 1))
          }
        })
      (if (== dots 0)
        (strSlice out 0 k)
        {
          (let s (strSlice out 0 k))
          (if (let (Some sp) (strFindByte s 32 0))
            (concat (concat (strSlice s 0 sp) " (")
              (concat (strSlice s (+ sp 1) (- (strLen s) (+ sp 1))) ")"))
            s)
        })
    }
  })

; Every operand after the subcommand: the modules and pages to add.
(pub :: docOperands Strings)
;@axiom:effect(io)
(pub fn (docOperands)
  {
    (let v vecNew)
    (let mut i operandStart)
    (let mut go true)
    {
      (while go
        {
          (let p (positionalIndex i))
          (match p
            ((None)
              (set go false)
            )
            ((Some p)
              {
                (vecPush v (sysArg p))
                (set i (+ p 1))
              }
            ))
        })
      v
    }
  })

; A root prose file, when the set has it.
(pub :: docAddRoot (-> String Strings Strings Strings String String Int))
;@axiom:effect(io)
(pub fn (docAddRoot root srcs outs titles rel out)
  (if (fileExists (concat root rel))
    {
      (vecPush srcs rel)
      (vecPush outs out)
      (vecPush titles (mdTitle (unwrapOr (readFile (concat root rel)) "")))
      0
    }
    0))

; The set: pages first, then library modules, then the operands.
(pub :: docBuildSet (-> String String DocSet))
;@axiom:effect(io)
(pub fn (docBuildSet root out)
  ; `modNamed` is a `(Vec Int)`, bound on its own so the checker
  ; does not unify it with the vectors of strings above it.
  {
    (let srcs vecNew)
    (let outs vecNew)
    (let titles vecNew)
    (let modFiles vecNew)
    (let modOuts vecNew)
    (let modNames vecNew)
    (let names (unwrapOr (listDir (concat root "docs/")) vecNew))
    {
      (let modNamed vecNew)
      {
        ; `docs/*.md`, `docs/README.md` as the index.
        (for name in names
          (if (docEndsWith name ".md")
            {
              (vecPush srcs (concat "docs/" name))
              (vecPush outs
                (if (strEq name "README.md")
                  "index.html"
                  (concat (strSlice name 0 (- (strLen name) 3)) ".html")))
              (vecPush titles
                (mdTitle (unwrapOr (readFile (concat (concat root "docs/") name)) "")))
            }))
        (docAddRoot root srcs outs titles "README.md" "readme.html")
        (docAddRoot root srcs outs titles "CONTRIBUTING.md" "contributing.html")
        (docAddRoot root srcs outs titles "CHANGELOG.md" "changelog.html")
        (docAddRoot root srcs outs titles "examples/README.md" "examples.html")
        ; The library.
        (if (let (Some lib) docStdlibDir)
          {
            (let acc vecNew)
            {
              (let rels (docWalk lib "" acc))
              (for rel in rels
                {
                  (vecPush modFiles (concat lib rel))
                  (vecPush modOuts
                    (concat (concat "stdlib/" (strSlice rel 0 (- (strLen rel) 3))) ".html"))
                  (vecPush modNames (docModuleName rel))
                  (vecPush modNamed 0)
                })
            }
          }
          (writeStderrStr "warning: no standard library found; set AXIOM_STDLIB to render it\n"))
        ; The operands: `.ax` modules under `modules/`, `.md` pages at
        ; the root, rendered as a `docs/` page would be.
        {
          (let ops docOperands)
          (for op in ops
            (if (docEndsWith op ".md")
              {
                (vecPush srcs (docAbsolute op))
                (vecPush outs (concat (pathStem op) ".html"))
                (vecPush titles (mdTitle (unwrapOr (readFile op) "")))
              }
              {
                (vecPush modFiles op)
                (vecPush modOuts (concat (concat "modules/" (pathStem op)) ".html"))
                (vecPush modNames (pathStem op))
                (vecPush modNamed 1)
              }))
        }
        (DocSet
          :root root
          :out out
          :srcs srcs
          :outs outs
          :titles titles
          :modFiles modFiles
          :modOuts modOuts
          :modNames modNames
          :modNamed modNamed)
      }
    }
  })

; ------------------------------------------------------------------
; Opening the result
; ------------------------------------------------------------------
; `open` on darwin, `xdg-open` elsewhere, found on `PATH`; without
; one the path is printed and that is the answer.
(pub :: docOpen (-> String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (docOpen index)
  {
    (let opener
      (if (strStartsWith hostTarget "darwin")
        "open"
        "xdg-open"))
    (if (== (strLen (pathOfCommand opener)) 0)
      0
      {
        (let v vecNew)
        {
          (vecPush v opener)
          (vecPush v index)
          (match (sysRunPath opener v)
            ((Ok _) 0)
            ((Err _) (writeStderrStr (concat (concat "warning: could not run " opener) "\n"))))
        }
      })
  })

; ------------------------------------------------------------------
; The command
; ------------------------------------------------------------------
(pub :: docMain Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (docMain)
  (if (let (Some root) docFindRoot)
    {
      (let ds
        (docBuildSet (pathWithSlash (docAbsolute root)) (pathWithSlash (docAbsolute docOutDir))))
      (if (hasFlagAnywhere (Some "doc") "--missing")
        {
          (let mut n 0)
          {
            (for i in 0..(vecLen ds.modFiles)
              (set n (+ n (docMissingIn (vecGet ds.modFiles i)))))
            (if (> n 0)
              (sysExitWith 1)
              0)
          }
        }
        {
          (match (makeDirAll ds.out)
            ((Ok _) ())
            ((Err _) (die (concat (concat "error: cannot create " ds.out) "\n") 1)))
          (docWrite ds "style.css" docStyle)
          (for i in 0..(vecLen ds.srcs)
            (docRenderPage ds i))
          (for i in 0..(vecLen ds.modFiles)
            (docRenderModule ds i))
          (docRenderLanguage ds)
          {
            (let index (concat ds.out "index.html"))
            {
              (writeStr stdout (concat index "\n"))
              (if (hasFlagAnywhere (Some "doc") "--no-open")
                0
                (docOpen index))
            }
          }
        })
    }
    (die
      "error: no documentation set found: set AXIOM_DOC to a directory holding docs/, or run the compiler from an install or a source checkout\n"
      1)))
