  })

; The result stamp carries the same optional declaration at word 3.
(pub :: nodeBuildEvstampResultOptional (-> ASTNode Int (Option ASTNode) ASTNode))
(pub fn (nodeBuildEvstampResultOptional ty evidence declaration)
  (nodeBuildEvstampResultPlain ty evidence
    (match declaration
      ((None) nilNode)
      ((Some node) node))))

