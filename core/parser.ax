(pub :: nodeBuildMArmPlain (-> ASTNode ASTNode Int ASTNode))
(pub fn (nodeBuildMArmPlain a b c)
  {
    (let n (nodeWireEmpty TAG_M_ARM))
    (writeNodeChild n 1 a)
    (writeNodeChild n 2 b)
    (writeNodeWord n 3 c)
    n
  })

(pub :: nodeBuildEWhile (-> ASTNode Nodes Int Int ASTNode))
(pub fn (nodeBuildEWhile a b c sp)
  {
    (let n (nodeWireEmpty TAG_E_WHILE))
    (writeNodeChild n 1 a)
    (writeNodeChildren n 2 b)
    (writeNodeWord n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

(pub :: nodeBuildEHandle (-> ASTNode Nodes ASTNode Int ASTNode))
(pub fn (nodeBuildEHandle a b c sp)
  {
    (let n (nodeWireEmpty TAG_E_HANDLE))
    (writeNodeChild n 1 a)
    (writeNodeChildren n 2 b)
    (writeNodeChild n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

(pub :: nodeBuildFieldType (-> String ASTNode Int Int ASTNode))
(pub fn (nodeBuildFieldType a b c sp)
  {
    (let n (nodeWireEmpty TAG_FIELD))
    (writeNodeText n 1 a)
    (writeNodeChild n 2 b)
    (writeNodeWord n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

(pub :: nodeBuildCtor (-> String Int Ints Int ASTNode))
(pub fn (nodeBuildCtor a b c sp)
  {
    (let n (nodeWireEmpty TAG_CTOR))
    (writeNodeText n 1 a)
    (writeNodeWord n 2 b)
    (writeNodeWords n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

(pub :: nodeBuildNilPlain (-> Int Int Int ASTNode))
(pub fn (nodeBuildNilPlain a b c)
  {
    (let n (nodeWireEmpty TAG_NIL))
    (writeNodeWord n 1 a)
    (writeNodeWord n 2 b)
    (writeNodeWord n 3 c)
    n
  })

; Macro rules alone retain a heterogeneous wire-shaped packet.
(pub :: packedNodeAt (-> Ints Int ASTNode))
;@axiom:effect(unsafe)
(pub fn (packedNodeAt words index)
  (as (vecGet words index) ASTNode))

; ------------------------------------------------------------------
; AST node: tagged union. tag + a,b,c fields. Unused = 0.
; ------------------------------------------------------------------
; `axtags` is the Vec of `;@axiom:key(value)` tags written directly
; above a DECLARATION, and 0 everywhere else. It is the eighth word so
; that `ty` keeps index 6 and every existing `memGetWord` reader is
; untouched.
; `module` is the module a declaration was SPLICED FROM - 0 for the
; entry file, the module's name otherwise. Stamped by `resolveDecls`,
; which is the only place that knows it, and the ninth word for the
; same reason `axtags` was the eighth: every existing reader indexes
; by position. Without it the merged declaration list cannot say
; which module defined what, which is what AX3014 has to answer.
; `fieldNames` is a constructor's declared field names when it was
; written as a STRUCT VARIANT - `(Rect { w : Int, h : Int })` - and 0
; for a positional one. Tenth word for the same reason `axtags` was
; eighth and `module` ninth: every existing reader indexes by
; position, so appending is the only change that is free.
; A declaration's visibility: 1 when it was written `pub`, 0 otherwise.
; stage0 splices only the PUBLIC declarations of an imported module
; into the program; stage1 spliced all of them, so a reference to a
; private imported name compiled here and was AX3001 there.
(pub :: nodeVis (-> ASTNode Int))
(pub fn (nodeVis n)
  (nodeWord n 5))

(pub :: nodeAxtags (-> ASTNode Int))
(pub fn (nodeAxtags n)
  (nodeWord n 7))

(pub :: setNodeSpan (-> ASTNode Int ASTNode))
(pub fn (setNodeSpan n sp)
  {
    (writeNodeWord n 4 sp)
    n
  })

(pub :: markPub (-> ASTNode ASTNode))
(pub fn (markPub n)
  {
    (if (! (nodeSame n nilNode))
      (writeNodeWord n 5 1))
    n
  })

; A declaration's parsed TYPE, or 0 when none was kept. Word 6 is new
; and additive: every existing consumer reads words 0-5 by index, so
; nothing moves. What lives here varies by tag - a type node for
; TAG_D_SIG/TAG_FIELD, a Vec of field type nodes for TAG_CTOR, a Vec
; of tyvar name Strs for TAG_D_DATA.
(pub :: nodeTy (-> ASTNode Int))
(pub fn (nodeTy n)
  (nodeWord n 6))

; Node tags.
(pub :: TAG_NIL Int)
(pub fn (TAG_NIL)
  0)

(pub :: TAG_E_INT Int)
(pub fn (TAG_E_INT)
  1)

(pub :: TAG_E_STR Int)
(pub fn (TAG_E_STR)
  2)

(pub :: TAG_E_VAR Int)
(pub fn (TAG_E_VAR)
  3)

(pub :: TAG_E_APP Int)
(pub fn (TAG_E_APP)
  4)

(pub :: TAG_E_LAM Int)
(pub fn (TAG_E_LAM)
  5)

(pub :: TAG_E_LET Int)
(pub fn (TAG_E_LET)
  6)

(pub :: TAG_E_IF Int)
(pub fn (TAG_E_IF)
  7)

(pub :: TAG_E_BEGIN Int)
(pub fn (TAG_E_BEGIN)
  8)

(pub :: TAG_E_QUOTE Int)
(pub fn (TAG_E_QUOTE)
  9)

(pub :: TAG_E_MATCH Int)
(pub fn (TAG_E_MATCH)
  16)

; One arm of a `match`: word 1 is the pattern, word 2 the body.
(pub :: TAG_M_ARM Int)
(pub fn (TAG_M_ARM)
  17)

(pub :: TAG_D_FN Int)
(pub fn (TAG_D_FN)
  10)

(pub :: TAG_D_SIG Int)
(pub fn (TAG_D_SIG)
  11)

(pub :: TAG_D_DATA Int)
(pub fn (TAG_D_DATA)
  12)

(pub :: TAG_D_STRUCT Int)
(pub fn (TAG_D_STRUCT)
  13)

(pub :: TAG_D_IMPORT Int)
(pub fn (TAG_D_IMPORT)
  14)

(pub :: TAG_D_MACRO Int)
(pub fn (TAG_D_MACRO)
  15)

(pub :: TAG_CTOR Int)
(pub fn (TAG_CTOR)
  20)

(pub :: TAG_FIELD Int)
(pub fn (TAG_FIELD)
  21)

; A float literal: word 1 holds the IEEE-754 bit pattern of the value,
; which *is* the value - a float is carried as the i64 of its bits
; everywhere, so the emitter prints word 1 as a plain integer constant.
(pub :: TAG_E_FLT Int)
(pub fn (TAG_E_FLT)
  22)

; A parenthesised nullary-constructor pattern, `(Nil)`. The parens are
; what distinguish it from a binder - stage0 parses a BARE identifier
; in pattern position as a binder even when it names a constructor -
; and expression parsing erases parens, so the shape is marked before
; the erasure. Word 1 is the constructor's name.
(pub :: TAG_P_CON0 Int)
(pub fn (TAG_P_CON0)
  23)

; A mutable binding: like TAG_E_LET, but the name gets storage - an
; alloca written by `set` and read by a load at every use - rather
; than a value register.
(pub :: TAG_E_LETM Int)
(pub fn (TAG_E_LETM)
  24)

; (set name value): word 1 the name, word 2 the value expression.
(pub :: TAG_E_SET Int)
(pub fn (TAG_E_SET)
  25)

; (while cond body...): word 1 the condition, word 2 the body Vec.
(pub :: TAG_E_WHILE Int)
(pub fn (TAG_E_WHILE)
  26)

; Field access `base.field`: word 1 the base expression, word 2 the
; field's name. Chains fold left: `a.b.c` is ((a.b).c).
(pub :: TAG_E_FIELD Int)
(pub fn (TAG_E_FIELD)
  27)

; Field store `(set base.field v)`: word 1 the base expression, word 2
; the field's name, word 3 the value. Evaluates to 0, stage0's rule.
(pub :: TAG_E_SETF Int)
(pub fn (TAG_E_SETF)
  28)

; 29 was TAG_D_FOREIGN, the `foreign` binding, and is not reused: the
; tag numbers are the AST's wire format between this file and its four
; readers, and a retired one left vacant costs nothing while a recycled
; one turns a stale reader into a silent misparse rather than a crash.
; An `(effect Name (op :: sig) ...)` declaration. stage1 lowers no
; part of the effect system, but the NAMES have to survive parsing:
; the effect's own name appears in a `handle` list and each operation
; is a callable, so a checker that never saw them reports every one as
; an undefined variable - which it did, on programs stage0 compiles
; without a word. Word 1 is the effect's name, word 2 a Vec of its
; operation names.
(pub :: TAG_D_EFFECT Int)
(pub fn (TAG_D_EFFECT)
  30)

; A `type` declaration, retained for `symbols`. Until the port it was
; consumed by skipUnknownDecl into TAG_NIL - stage1 emits no code for
; it, and every downstream tag dispatch else-skips, so carrying it is
; free. a=name, b=target type node, c=tyvars (Vec of Str), span=name
; token. A malformed spelling falls back to skipUnknownDecl, which is
; byte-for-byte the old behaviour.
(pub :: TAG_D_ALIAS Int)
(pub fn (TAG_D_ALIAS)
  47)

; 48 was TAG_D_TRAIT and 49 was TAG_D_IMPL, and neither is reused, for
; the reason 29 is not: the tag numbers are the AST's wire format
; between this file and its four readers, and a retired one left
; vacant costs nothing while a recycled one turns a stale reader into
; a silent misparse rather than a crash. `trait` and `impl` are AX2004
; at the top of `parseTopForm` now, so no node carries either.
; A top-level form whose head is an identifier that names no
; declaration keyword: a DECLARATION MACRO INVOCATION, resolved by the
; expander's phase D (macro-system.md MAC-CAP-8/MAC-EXP-16). a=head
; name, b=Vec of argument expression nodes, span=the head token. Until
; 2026-08-14 this was a FATAL bare AX2003 "syntax error" that also
; stopped the parse at the first such form; phase D refuses an
; unresolvable head with a diagnostic that names it, and reports every
; one in a run. The removed-construct arms (union/foreign, and until
; 2026-09-03 region) stay AHEAD of this in parseTopForm, so their
; migration advice survives.
(pub :: TAG_D_MACROCALL Int)
(pub fn (TAG_D_MACROCALL)
  50)

; `(syntax/for (C seq) arm...)` standing where a match ARM stands
; (macro-system.md MAC-CAP-5): one template arm per element of the
; sequence, spliced in place by the expander during template
; instantiation. a=the binder name (Str), b=the sequence expression
; node, c=Vec of template TAG_M_ARM nodes, span=the `syntax/for`
; token. The checker and the emitter never see this tag: inside a
; template the expander splices it away, and outside one the
; expander's phase E refuses it (AX3028) and replaces it with a
; well-formed poison arm, because the REPL runs the checker even
; after expansion errors.
(pub :: TAG_M_FOR Int)
(pub fn (TAG_M_FOR)
  51)

; `(syntax/for (f seq) decl...)` standing where a DECLARATION stands -
; the same iteration form one position up (MAC-CAP-5): the template
; declarations instantiated once per element, spliced into the
; generated-declaration list by phase D. a=the binder name (Str),
; b=the sequence expression node, c=Vec of declaration nodes,
; span=the `syntax/for` token. Meaningful only inside a rule-form
; macro's template; one written at top level in ordinary code parses
; here too - the hook sits in parseTopForm, so the template parser
; inherits it - and phase D refuses it (AX3028) and re-tags it inert,
; because the checker walks whatever the parse produced.
(pub :: TAG_D_SYNFOR Int)
(pub fn (TAG_D_SYNFOR)
  52)

; An `(extern "lib" (name :: Type (symbol "s")) ...)` binding block -
; the Rust FFI's declaration form (docs/ffi.md). 53 because 29 was
; TAG_D_FOREIGN and stays retired: the tag numbers are the AST's wire
; format between this file and its four readers, and a recycled one
; turns a stale reader into a silent misparse rather than a crash.
;
; `foreign` itself is untouched and still reports AX2004. The two are
; not the same construct wearing different names - `foreign` named one
; symbol and emitted a call the module never declared, which is why it
; never linked; `extern` names a block and emits a `declare` for each
; item in it.
;
; a = library name, b = Vec of item NAME strings (the shape existing
; readers index, exactly as TAG_D_EFFECT's ops vector is), c = Vec of
; TAG_FIELD nodes carrying name + declared type + linker symbol,
; span = the library-name token.
(pub :: TAG_D_EXTERN Int)
(pub fn (TAG_D_EXTERN)
  53)

; `(region r EXPR)` - an allocation scope with a lexical extent,
; MM-RGN-1 of docs/memory-model.md. a = the region's NAME as
; a String, b = the one body expression, c = the NAME token's span
; (the anchor for a diagnostic about the name itself - AX3058 - and
; what S3's hover and rename will land on), span = the keyword's.
;
; A NODE and not a parse-time desugaring, deliberately: S3's escape
; rule (MM-RGN-3) has to FIND region extents to check anything, and a
; checker that met only `__axiom_arena_mark` beside a `let` would have
; nothing to attach a name to. So the tag is real and every consumer
; carries an arm - `expand.ax` (substTpl, expandExpr), `typecheck.ax`,
; `codegen.ax`, `lsp.ax` - and `format.ax` prints it on its own
; grammar. 54 is the next free number; 53 is shared by `TAG_D_EXTERN`
; and the type-node stamp `TAG_EVSTAMP`, which never meet.
(pub :: TAG_E_REGION Int)
(pub fn (TAG_E_REGION)
  54)

; A `subtype` declaration: `(subtype Name is Type range Expr..Expr)`.
; a = name, b = base TYPE node, c = Vec of bound EXPR nodes (1-2:
; lower only, or lower and upper). 55 is the next free number.
(pub :: TAG_D_SUBTYPE Int)
(pub fn (TAG_D_SUBTYPE)
  55)

; A subtype conversion check node. a = value expression, b = bounds
; Vec (1-2 EXPR nodes), c = message string. Created by the type
; checker when a cast or argument requires a runtime range check.
; Not parseable in source. The ty slot carries the target subtype.
; 56 is the next free number.
(pub :: TAG_E_SUBCHECK Int)
(pub fn (TAG_E_SUBCHECK)
  56)

; 31 was TAG_E_COND, the `cond` form, and is not reused: the tag
; numbers are the AST's wire format between this file and its four
; readers, and a retired one left vacant costs nothing while a recycled
; one turns a stale reader into a silent misparse rather than a crash.
; `cond` is AX2004 in `parseInner` now, so no node carries it. Its
; place is the variadic `if` - `(if t1 b1 t2 b2 ... els)`, desugared
; to the nested chain right in `parseIfExpr` - and `match`.
; Type expression nodes, produced by parseType. The type checker is
; the only consumer; codegen never reads them.
(pub :: TAG_T_VAR Int)  ; a=name
(pub fn (TAG_T_VAR)
  32)

(pub :: TAG_T_CON Int)  ; a=name, b=Vec args
(pub fn (TAG_T_CON)
  33)

(pub :: TAG_T_ARR Int)  ; a=param, b=result
(pub fn (TAG_T_ARR)
  34)

(pub :: TAG_T_TUP Int)  ; a=Vec; empty = unit
(pub fn (TAG_T_TUP)
  35)

; 36 was TAG_T_LIST, the `[T]` list type, and is not reused, for the
; reason 31 is not. `[T]` is AX2004 in `parseType`, so no node carries
; it; `(Vec T)` is the spelling.
(pub :: TAG_T_PTR Int)  ; a=inner
(pub fn (TAG_T_PTR)
  37)

(pub :: TAG_T_ERR Int)  ; poison, no payload
(pub fn (TAG_T_ERR)
  38)

; The checker's evidence stamp on a call head (MM-LIFE-2d): a=the
; enclosing declaration node, b=witness-code Vec (-1 unset, 0 const
; zero, 1 const one, 2+k bit k of the caller's own word), c=the
; instantiation env; ty slot = the callee's ordered tyvar names.
; Never produced by the parser; lives here so the tag space has one
; owner.
(pub :: TAG_EVSTAMP Int)
(pub fn (TAG_EVSTAMP)
  53)

; A character literal. It used to collapse into TAG_E_INT, but stage0
; types a char literal `Char`, not `Int`, and `Char` has no
; compatibility fiat with `Int` - `(charToStr 'q')` against
; `(-> Char Int)` is silent under stage0 and would be a false AX3004
; if the literal arrived typed `Int`. Codegen emits it exactly as an
; integer (word 1 is the codepoint), so representation is unchanged.
(pub :: TAG_E_CHAR Int)
(pub fn (TAG_E_CHAR)
  39)

; `(struct Name field...)` in expression position, the keyword
; spelling of `(Name field...)`. `parseInner` refuses that spelling
; (AX2004) and builds a struct from the application, so no parser path
; makes this node. a=name, b=Vec of argument nodes, spanned at the
; name.
(pub :: TAG_E_STRUCTCON Int)
(pub fn (TAG_E_STRUCTCON)
  40)

; `(handle body (Effect...) handler)`. Parsed as an application until
; now, which had two costs: an unknown effect name drew AX3001
; `undefined variable` where stage0 says AX3016 `unknown effect`, and
; emission produced `call i64 @Console(i64 %IO, i64 %Alloc)` - a call
; to a symbol nothing defines, which llc rejects. a=body, b=Vec of
; TAG_E_VAR nodes naming the handled effects (each carrying its own
; span, which is where AX3016 and AX3017 anchor), c=handler.
(pub :: TAG_E_HANDLE Int)
(pub fn (TAG_E_HANDLE)
  42)

; `E?`: propagate the error of `E`. a = E. The expander rewrites every
; one into a `match` before the checker runs (`expTryRewrite`), so no
; later pass sees it; the span covers `E` and the `?`.
(pub :: TAG_E_TRY Int)
(pub fn (TAG_E_TRY)
  57)

; A NAMED constructor pattern: `(Rect { h = h, w = w })`. a=constructor
; name, b=Vec of field-name nodes (TAG_E_VAR, so each carries its own
; span - AX3007 anchors at the field name), c=Vec of sub-patterns,
; positionally aligned with b. The span is the constructor's.
;
; It is NOT desugared at parse time, because the declaration that says
; what order the fields are in may not have been seen yet. Both the
; checker and the emitter reorder it against the constructor's
; recorded field names, which is where stage0 does it too.
(pub :: TAG_P_CONNAMED Int)
(pub fn (TAG_P_CONNAMED)
  43)

(pub :: nodeTag (-> ASTNode Int))
(pub fn (nodeTag n)
  (if (nodeSame n nilNode)
    0
    (astNodeTag n)))

; Word 1 of an ASTNode. What it MEANS is fixed by the node's tag, which
; the type system does not model - so this answers the word, and
; `nodeAName` answers the reading almost every tag gives it.
(pub :: nodeA (-> ASTNode Int))
(pub fn (nodeA n)
  (nodeWord n 1))

; The name in word 1: a declaration's name, a variable's spelling, a
; constructor's. The cast is here, at a return inside a signature that
; carries the type - see `nodeCName`.
(pub :: nodeAName (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (nodeAName n)
  (as (nodeA n) String))

(pub :: nodeB (-> ASTNode Int))
(pub fn (nodeB n)
  (nodeWord n 2))

; The String view of word 2. See `nodeCName` for why the cast lives
; here and not at the call sites.
(pub :: nodeBName (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (nodeBName n)
  (as (nodeB n) String))

(pub :: nodeC (-> ASTNode Int))
(pub fn (nodeC n)
  (nodeWord n 3))

; The String view of word 3, for the node tags whose third field is a
; name. The cast is HERE, at a return inside a signature that carries
; the type, and not at the call sites - a cast at an argument root
; classifies that value's evidence 0 and drops its retain or its
; release (docs/memory-model.md MM-LIFE-2e, measured).
(pub :: nodeCName (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (nodeCName n)
  (as (nodeC n) String))

; The AST's three payload words are the compiler's own instance of
; `Mem.memSetWord`'s problem, and they carry it at scale: `ASTNode`
; declares all ten of its fields `Int`, so the three `cast Int`s below
; hide every lexeme, every child handle and every Vec this compiler
; stores in a node. `fldClass` sees `Int`, no field retain is emitted,
; and the node holds a reference nothing counts.
;
; `__retainref` on each is type-directed, so a tag or a span - which
; is what most of these words are - emits nothing at all, and a
; `String` or a node handle takes a share. As at the `Mem` layer the
; share is unbalanced and therefore a leak: an AST node is never
; released, so what it holds was already immortal. What changes is
; that it is no longer invisible, which is what lets an owner
; elsewhere release its own share safely (docs/memory-model.md
; MM-LIFE-2c).
(pub :: nodeSpan (-> ASTNode Int))
(pub fn (nodeSpan n)
  (nodeWord n 4))

; The module word: a String when the declaration carries one, and 0
; when it does not - which is why the word and its String view are
; separate here. `(!= (nodeModule d) 0)` asks the first question,
; `nodeModuleName` answers the second. The honest type is an option in
; a machine word, and this split is as close as the language gets
; until one exists.
(pub :: nodeModule (-> ASTNode Int))
(pub fn (nodeModule n)
  (nodeWord n 8))

; The String view. Only ask it where the word is known non-zero. The
; cast is here, at a return inside a signature that carries the type -
; see `nodeCName`.
(pub :: nodeModuleName (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (nodeModuleName n)
  (as (nodeModule n) String))

; The module slot is the parser's packed optional reference boundary.
; Preserve an explicitly stored empty name as Some rather than guessing
; which caller's entry-module convention applies.
(pub :: nodeModuleOpt (-> ASTNode (Option String)))
(pub fn (nodeModuleOpt n)
  (if (== (nodeModule n) 0)
    None
    (Some (nodeModuleName n))))

(pub :: nodeFieldNames (-> ASTNode Int))
(pub fn (nodeFieldNames n)
  (nodeWord n 9))

; A template-owned VAR keeps its definition module in word 8. It
; survives subsequent expansion by another macro, whose site differs.
; WORD 10 records that this reference resolves
; where the MACRO TEMPLATE that produced it was written, which is
; always top level, and never in the scope it happens to land in.
;
; It is the operational content of MAC-HYG-9's scope sets for the one
; case renaming could not reach. A macro is a top-level declaration,
; so a template's free identifier had no enclosing local scope where
; its author wrote it; a caller's `let` of that name is therefore not
; a rebinding of it but a different variable that happens to agree on
; spelling. Both resolvers - `checkVar` and `emitVar` - ask locals
; first, and this is the bit that tells them not to.
;
; A template's own binders never carry it: they are gensym-renamed
; (MAC-HYG-3) and resolve through their scope records long before the
; free-identifier arm is reached.
(pub :: nodeDefScope (-> ASTNode Int))
(pub fn (nodeDefScope n)
  (nodeWord n 10))

(pub :: setNodeDefScope (-> ASTNode ASTNode))
(pub fn (setNodeDefScope n)
  {
    (writeNodeWord n 10 1)
    n
  })

; The type a PATTERN BINDER stands for, as the checker resolved it,
; spelled as the constructor name of that type and 0 for every node
; that is not such a binder.
;
; It is here because codegen has to answer a question it cannot see
; the input to. `escapesViaBinders` asks whether a match arm's binder
; can carry a reference OUT of the block being matched, and by the
; time it walks the arm the field has become a bare variable with no
; type on it - so the answer was "yes, whatever it is", and the
; scrutinee of every `Result`-shaped match went unreleased
; (docs/error-model.md ERR-MEM-4, 32 bytes per fallible call). The
; equivalent question on the FIELD-READ path is `fieldReadIsScalar`,
; which can ask it because a field read still names its field.
;
; Word 11 rather than word 6: word 6 already carries an evidence
; stamp for a call's spine head, which is a TAG_E_VAR node too, and
; a type name landing there would be read as a node.
;
; The checker is the only phase that can supply it, because the
; useful type is the INSTANTIATED one: `Ok`'s field is declared `a`
; and a scrutinee of `(Result Int String)` makes it `Int`, which is
; the difference between a word that cannot alias the block and a
; reference that can.
(pub :: nodeBinderTy (-> ASTNode Int))
(pub fn (nodeBinderTy n)
  (nodeWord n 11))

; Expansion retains an identifier's binding when another macro receives
; it as syntax. On a variable this holds an expander-owned
; SyntaxIdentity; on a captured binding form, its lexical records.
; It is zero on parsed nodes. Later phases read renamed names.
(pub :: nodeSyntaxIdentity (-> ASTNode Int))
(pub fn (nodeSyntaxIdentity n)
  (nodeWord n 12))

; Whether an application's answer is a machine word, as the checker
; proved it - 1 for `Int`, `Float`, `Bool`, `Char` and the empty
; tuple, 0 for everything else INCLUDING the unknowns (a type
; variable, an unexpanded alias, no type at all) - and, since S4
; slice 2, 2 for a freshly allocated reference the region facts
; proved fresh-only (its callee's result derives from CUR0, from no
; parameter, and from no call the walk could not resolve). 2 is a
; third answer class, not a second true: every existing reader asks
; `== 1`, so a fresh reference reads as "not a word" everywhere the
; old domain ran, and only codegen's region elision asks `== 2`.
; Word 7, which no AST consumer reads on any node: words 8/9/10 are module,
; field-names and def-scope, word 6 is the evidence stamp, and word
; 11 is the binder type above (an application is never a binder, so
; reusing that word would still be wrong - 1 would read as a type).
;
; It is here for the same reason `nodeBinderTy` is: codegen has to
; answer a question it cannot see the input to. A closure
; application that answers a word cannot alias its argument into
; its answer, so the argument's share can go with the call - but
; the walker holding the argument never sees the application's
; type, only the checker's word for it. The zero default is the
; safe direction: an unstamped node (a macro head the LSP checks
; without emitting, a spine the cast form claims whole) keeps its
; release, and a 2 the facts never proved is a 0 the fixpoint never
; reached. `setNodeResWord`'s writers are the checker's stamp
; beside `evStampFill` (0 and 1, during checking) and the region
; pass's witness stamp (0 to 2 only, post-fixpoint, never while
; facts are still moving and never when truncation made every row
; a lower bound); its readers are the chain walker (`== 1`) and
; the region elision (`== 2`). A type-preserving cast carries 3:
; checking proved its operand and result have the same type, so its
; ownership and evidence follow the operand. This proof never claims
; that the value is a word or fresh in a region.
(pub :: nodeResWord (-> ASTNode Int))
(pub fn (nodeResWord n)
  (nodeWord n 7))

(pub :: setNodeResWord (-> ASTNode Int ASTNode))
(pub fn (setNodeResWord n w)
  {
    (writeNodeWord n 7 w)
    n
  })

(pub :: mkEInt (-> Int ASTNode))
(pub fn (mkEInt v)
  (nodeBuildEIntPlain v 0 0))

(pub :: mkEVar (-> String ASTNode))
(pub fn (mkEVar n)
  (nodeBuildEVarPlain n 0 0))

; `()`, the unit value: the one value of the unit type `()`, the empty
; tuple. It is an integer literal 0 marked with 2 in word 2, so every
; pass that treats a literal as a constant word with no ownership -
; which is all of them - already handles it; only the checker reads
; the mark, to give it the unit type. (Word 2 is 1 on the zero that
; unary `-` inserts, `unaryMinusToBinary`.)
(pub :: mkEUnitAt (-> Int ASTNode))
(pub fn (mkEUnitAt sp)
  (nodeBuildEInt 0 2 0 sp))

(pub :: isUnitLit (-> ASTNode Bool))
(pub fn (isUnitLit e)
  (if (nodeSame e nilNode)
    false
    (&& (== (nodeTag e) TAG_E_INT) (== (nodeB e) 2))))

; Type-node constructors. parseType builds these; only the checker
; reads them.
(pub :: mkTVar (-> String ASTNode))
(pub fn (mkTVar n)
  (nodeBuildTVarPlain n 0 0))

(pub :: mkTCon (-> String Nodes ASTNode))
(pub fn (mkTCon n args)
  (nodeBuildTConPlain n args 0))

(pub :: mkTArr (-> ASTNode ASTNode ASTNode))
(pub fn (mkTArr p r)
  (nodeBuildTArrPlain p r 0))

(pub :: mkTTup (-> Nodes ASTNode))
(pub fn (mkTTup xs)
  (nodeBuildTTupPlain xs 0 0))

; A pointer holds its referent only. The `mut` flag is gone: no
; spelling ever set it, `(* mut T)` is refused as a tuple, and the
; renderers' `*mut` arms printed nothing anywhere.
(pub :: mkTPtr (-> ASTNode ASTNode))
(pub fn (mkTPtr inner)
  (nodeBuildTPtrPlain inner 0 0))

(pub :: mkTErr ASTNode)
(pub fn (mkTErr)
  (nodeBuildTErrPlain 0 0 0))

; An application's span is its FUNCTION's span, not the open paren's -
; stage0's `Expr::span()` recurses to the head for `EApp`, so a
; diagnostic about `(f 1)` points at `f`. Copying the child's span at
; construction is exactly equivalent to that recursion and costs one
; word instead of a walk.
(pub :: mkEApp (-> ASTNode ASTNode ASTNode))
(pub fn (mkEApp f x)
  (nodeBuildEApp f x nilWords (nodeSpan f)))

(pub :: mkEVarAt (-> String Int ASTNode))
(pub fn (mkEVarAt n sp)
  (nodeBuildEVar n 0 0 sp))

; A `let` node's span is its BINDER's - the token the name came from.
; stage0's `Expr::span()` answers the body's span for a `let`, but
; nothing in stage1 asks that question; what its diagnostics need is
; where the binding was introduced, which is where AX3012's secondary
; and its `mut` fix point.
(pub :: mkELetAt (-> String ASTNode ASTNode Int ASTNode))
(pub fn (mkELetAt n v b sp)
  (nodeBuildELet n v b sp))

(pub :: mkEIf (-> ASTNode ASTNode ASTNode ASTNode))
(pub fn (mkEIf t c a)
  (nodeBuildEIfPlain t c a))

(pub :: mkEBegin (-> (Vec ASTNode) ASTNode))
(pub fn (mkEBegin xs)
  (nodeBuildEBeginPlain xs 0 0))

; Span-carrying variants. A diagnostic about a declaration points at
; its *name*, so the name token's span is the one worth keeping - and
; the only one this slice's checks ever report. Everything else keeps
; span 0, which no consumer reads.
(pub :: mkDFnAt (-> String Names ASTNode Int ASTNode))
(pub fn (mkDFnAt n p b sp)
  (nodeBuildDFn n p b sp))

(pub :: mkDSigAt (-> String Ints Int ASTNode))
(pub fn (mkDSigAt n t sp)
  (nodeBuildDSig n t 0 sp))

; With the module path's span, so a diagnostic about the import - an
; unexported name in its list - has somewhere to point.
(pub :: mkDImportAt (-> String Names Int ASTNode))
(pub fn (mkDImportAt m ns sp)
  (nodeBuildDImport m ns 0 sp))

(pub :: mkDDataAt (-> String (Vec ASTNode) Int ASTNode))
(pub fn (mkDDataAt n cs sp)
  (nodeBuildDData n cs 0 sp))

(pub :: mkDStructAt (-> String (Vec ASTNode) Int ASTNode))
(pub fn (mkDStructAt n fs sp)
  (nodeBuildDStruct n fs nilNodes sp))

(pub :: mkDMacroAt (-> String Names ASTNode Int ASTNode))
(pub fn (mkDMacroAt n ps b sp)
  (nodeBuildDMacro n ps b sp))

; A subtype declaration: name, base TYPE node, bounds Vec of EXPR
; nodes (1-2: lower only, or lower and upper), name span.
(pub :: mkDSubtypeAt (-> String ASTNode (Vec ASTNode) Int ASTNode))
(pub fn (mkDSubtypeAt n base range sp)
  (nodeBuildDSubtype n base range sp))

(pub :: mkCtor (-> String Int Ints ASTNode))
(pub fn (mkCtor n a fl)
  (nodeBuildCtorPlain n a fl))

(pub :: mkField (-> String Int ASTNode))
(pub fn (mkField n t)
  (nodeBuildFieldFlagsPlain n t 0))

; ------------------------------------------------------------------
; Parse result.
; ------------------------------------------------------------------
; `exp` is what the parser WANTED at `pos`, as the noun stage0 puts in
; its message - "identifier", "expression", "pattern". It is the whole
; diagnostic payload, because stage0's AX2001 is mechanically derived
; from that one string:
;
;   E AX2001 f.ax:3:4-5 unexpected-token "expected identifier, found `)`"
;                                        ?"Axiom expected identifier at this position"
;
; and the code and span are derivable from `pos` alone - past the last
; token is AX2002, otherwise the found token's own span. So a site
; teaches the diagnostic everything it needs by naming its expectation,
; and a site that has not been taught yet answers `""`, which reports
; AX2003 rather than inventing an expectation it does not have.
;
; Every successful result owns its value at the type its parser produces.
; A failure owns only its position and diagnostic context.
(pub struct ParseError
  (pos : Int)
  (exp : String)
  (code : String))

(pub data PResult a
  (ParseSuccess a Int)
  (ParseFailed ParseError))

(pub :: pOk (-> a Int (PResult a)))
(pub fn (pOk value pos)
  (ParseSuccess value pos))

(pub :: pErr (-> Int (PResult a)))
(pub fn (pErr pos)
  (ParseFailed (ParseError :pos pos :exp "" :code "")))

(pub :: pErrExp (-> Int String (PResult a)))
(pub fn (pErrExp pos exp)
  (ParseFailed (ParseError :pos pos :exp exp :code "")))

(pub :: pResFailed (-> (PResult a) Bool))
(pub fn (pResFailed result)
  (match result
    ((ParseSuccess value pos) false)
    ((ParseFailed error) true)))

(pub :: pResOk (-> (PResult a) Bool))
(pub fn (pResOk result)
  (match result
    ((ParseSuccess value pos) true)
    ((ParseFailed error) false)))

; Position is meaningful for both success and failure, including recovery.
(pub :: pResPos (-> (PResult a) Int))
(pub fn (pResPos result)
  (match result
    ((ParseSuccess value pos) pos)
    ((ParseFailed error) error.pos)))

; Querying a payload keeps failure explicit. Production parsing uses matches
; when it must also propagate the failure's diagnostic context.
(pub :: pResValue (-> (PResult a) (Option a)))
(pub fn (pResValue result)
  (match result
    ((ParseSuccess value pos) (Some value))
    ((ParseFailed error) None)))

(pub :: pResNode (-> (PResult ASTNode) (Option ASTNode)))
(pub fn (pResNode result)
  (pResValue result))

(pub :: pResNodes (-> (PResult Nodes) (Option Nodes)))
(pub fn (pResNodes result)
  (pResValue result))

(pub :: pResText (-> (PResult String) (Option String)))
(pub fn (pResText result)
  (pResValue result))

(pub :: pResVec (-> (PResult (Vec a)) (Option (Vec a))))
(pub fn (pResVec result)
  (pResValue result))

(pub :: pResExp (-> (PResult a) String))
(pub fn (pResExp result)
  (match result
    ((ParseSuccess value pos) "")
    ((ParseFailed error) error.exp)))

(pub :: pResCode (-> (PResult a) String))
(pub fn (pResCode result)
  (match result
    ((ParseSuccess value pos) "")
    ((ParseFailed error) error.code)))

; A keyword that USED to be Axiom. The point of keeping `union` and
; `foreign` reserved is that old source gets an explanation instead of
; being silently reinterpreted as an ordinary identifier, so the
; explanation is the diagnostic and `exp` carries the keyword.
; `region` was on this list until 2026-09-03 and is a keyword again
; (`parseRegionExpr`); its old advice described an inference that was
; withdrawn, which is the one thing a reserved word must not do.
(pub :: pErrRemoved (-> Int String (PResult a)))
(pub fn (pErrRemoved p kw)
  (ParseFailed (ParseError :pos p :exp kw :code "AX2004")))

; A failure that names its own code and expects nothing - AX2005 is the
; one, refused before any expectation exists to record. A constructor
; rather than a bare `(PResult ...)` at the call site for the reason the
; three above are: every failure carries its diagnostic context.
(pub :: pErrCode (-> Int String (PResult a)))
(pub fn (pErrCode p c)
  (ParseFailed (ParseError :pos p :exp "" :code c)))

; A module-path segment carrying `/`. `exp` carries the SEGMENT, the way
; `pErrRemoved` carries the keyword, because the diagnostic quotes what
; was written: the whole point of AX2006 is that the reader sees the
; path they typed and not a noun.
(pub :: pErrModSeg (-> Int String (PResult a)))
(pub fn (pErrModSeg p seg)
  (ParseFailed (ParseError :pos p :exp seg :code "AX2006")))

; A C or Rust primitive type name in type position. `exp` carries the
; NAME as written, the way `pErrModSeg` carries the segment, because
; the whole point of AX3047 is that the reader sees the spelling they
; typed beside the Axiom type it should have been.
(pub :: pErrSizedTy (-> Int String (PResult a)))
(pub fn (pErrSizedTy p n)
  (ParseFailed (ParseError :pos p :exp n :code "AX3047")))

; A macro rule whose pattern does not open with the macro's own name.
; `exp` carries the MACRO's name, the way `pErrModSeg` carries the
; segment, because the diagnostic names both names: the one a rule
; must open with and the one it opened with.
(pub :: pErrMacroHead (-> Int String (PResult a)))
(pub fn (pErrMacroHead p mac)
  (ParseFailed (ParseError :pos p :exp mac :code "AX3133")))

; A `'` that opens no character literal. The code is the bare word,
; the way `for-in` is: the diagnostic keeps its AX2001 code and slug,
; and only the message and help are quote-specific.
(pub :: pErrQuote (-> Int (PResult a)))
(pub fn (pErrQuote p)
  (ParseFailed (ParseError :pos p :exp "" :code "quote")))

; An `extern` block's library name that is not one. `exp` carries the
; ONE offending byte as a one-byte string, and `""` means the name was
; empty - the two shapes AX3041 has. The offending byte rather than the
; whole name because the name is attacker-controlled and arbitrarily
; long: a message that quoted it would put the payload in the report,
; and the caret already shows the literal.
(pub :: pErrExternLib (-> Int String (PResult a)))
(pub fn (pErrExternLib p ch)
  (ParseFailed (ParseError :pos p :exp ch :code "AX3041")))

; The diagnostic for a failed parse, from the failure's token position.
;
; Before this, a parse failure was a bare `parse failed` on stderr and
; exit 2, against stage0's coded, spanned diagnostic and exit 1 - so
; every tool built on this frontend inherited it, and the language
; server published one spanless error at the top of the file for a
; typo anywhere in it.
;
; Three codes, chosen the way stage0 chooses them:
;
;   AX2002  the position is past the last token - the file ended while
;           a form was still open. Zero-width span at end of source,
;           which is what stage0's caret sits on.
;   AX2001  a token is there and the site said what it wanted. The
;           message and the help both come from that one noun.
;   AX2003  a token is there and the site has not been taught its
;           expectation yet. Reported as a plain syntax error rather
;           than as an AX2001 with an empty noun in it: an honest
;           weaker code beats a well-formed lie, and it shrinks as
;           sites are taught.
; AX2005, whose message, label and help are stage0's own wording. The
; limit renders from `parseMaxDepth` rather than being spelled out, so
; the constant and the sentence about it cannot drift.
(pub :: ax2005Diag (-> Tokens Int Diag))
(pub fn (ax2005Diag tokens pos)
  {
    (let tok (vecGet tokens pos))
    (let lim (fmtInt parseMaxDepth))
    {
      (let d
        (mkDiag SEV_ERROR "AX2005" "recursion-limit" (tokenSpan tok)
          (concat (concat "nesting is too deep (limit is " lim) ")") None
          (Some
            (concat "rewrite the form as a `let` chain, a `{}` block, or a balanced tree; "
              "hand-written code does not reach this limit, generated code can"))))
      {
        (diagSetLabel d (concat (concat "nesting reaches " lim) " levels here"))
        ; Why the limit exists at all, which the help does not say: the
        ; parser walks the form tree recursively, so nesting depth IS
        ; native stack depth, and the alternative to refusing here is
        ; the SIGSEGV this check was added to prevent.
        (diagAddNote d
          (concat "the parser walks the form tree recursively, so nesting depth is "
            "native stack depth"))
        d
      }
    }
  })

; AX3047, at the offending type name's own token.
;
; The message says what the name IS rather than what it is not,
; because "not a type" is the reader's own belief and the surprise is
; the other half: it is a type VARIABLE, and a signature carrying one
; accepts anything at all. The help names the Axiom type so the fix is
; a substitution rather than a search.
(pub :: ax3047Diag (-> Tokens Int String diag::Diag))
(pub fn (ax3047Diag tokens pos n)
  {
    (let d
      (mkDiag SEV_ERROR "AX3047" "sized-integer-type" (tokenSpan (vecGet tokens pos))
        (concat "`" (concat n "` is a type variable spelling, not an Axiom primitive")) None
        (Some
          (concat "Write `"
            (concat (sizedTyMeant n)
              "`. Primitive type names begin with a capital letter. Int is signed 64-bit; Int8, Int16, Int32, UInt8, UInt16, UInt32 and UInt64 carry distinct precision and signedness. Convert explicitly with `(as value Type)`; lowercase primitive spellings cannot stand in for these types.")))))
    (diagSetLabel d "use the Axiom primitive type name")
  })

; AX3133, at the rule pattern's head token: the one name a rule's
; pattern may not open with is any name but the macro's own, because
; the head is how a rule is matched to its macro (MAC-LANG-14).
(pub :: ax3133Diag (-> Tokens Int String diag::Diag))
(pub fn (ax3133Diag tokens pos mac)
  {
    (let tok (vecGet tokens pos))
    (diagSetLabel
      (mkDiag SEV_ERROR "AX3133" "macro-pattern-head" (tokenSpan tok)
        (concat "a rule of macro `"
          (concat mac
            (concat "` must open with `"
              (concat mac (concat "`, found `" (concat (tokenLexeme tok) "`"))))))
        None
        (Some
          "write every rule pattern as `(macroName pattern...) template`, repeating the name the `macro` form declares"))
      "this rule does not open with the macro's name")
  })

; A `'` that opens no character literal: AX2001 with a
; quote-specific message and help. The shape this catches is a
; Scheme habit, `'x` or `'(a b)` - the char-literal rule sends a
; quote followed by space, `(` or `[` here - and Axiom has no
; quote form, so the help says what the quote mark does open
; rather than naming a replacement that does not exist.
(pub :: quoteDiag (-> Tokens Int diag::Diag))
(pub fn (quoteDiag tokens pos)
  {
    (let tok (vecGet tokens pos))
    (diagSetLabel
      (mkDiag SEV_ERROR "AX2001" "unexpected-token" (tokenSpan tok)
        "expected expression, found `'`" None
        (Some "a `'` opens a character literal such as `'a'`; Axiom has no quote form"))
      "stray `'` here")
  })

; AX2006, at the offending SEGMENT's own token.
;
; The help names the two legal shapes rather than restating the ban,
; because the mistake this catches has two different causes: a path
; typed where a module name belongs (`(import /tmp/x/secret)`), and a
; directory-shaped module reached with the wrong separator
; (`(import Sys/Platform)` for `Sys.Platform`). The note records what
; the acceptance used to cost, which is the fact that decides whether
; anyone may relax this later.
(pub :: ax2006Diag (-> Tokens Int String Diag))
(pub fn (ax2006Diag tokens pos seg)
  {
    (let tok (vecGet tokens pos))
    {
      (let d
        (mkDiag SEV_ERROR "AX2006" "module-path-segment" (tokenSpan tok)
          (concat (concat "`" seg) "` is a file path, not a module-path segment") None
          (Some
            (concat
              "write the module's dotted name - `Sys.Platform`, not `Sys/Platform` - and put the directory holding it on "
              "`AXIOM_PATH` or beside the entry file; a module name is resolved against the search directories, never used as a path of its own"))))
      {
        (diagSetLabel d "a module-path segment is a name: `/` is not part of one")
        ; Why the ban is here and not in the resolver: `modPathToFile`
        ; rewrites `.` to `/` and leaves an existing `/` alone, and
        ; `searchDirsFor` prefixes a search directory with a bare
        ; `concat`, which an already-absolute name re-anchors. So the
        ; search root confines nothing once a segment carries a slash -
        ; measured 2026-08-23, `(import /tmp/axtrav/secret)` compiled a
        ; file outside the project and `check` printed OK.
        (diagAddNote d
          (concat
            "a segment carrying `/` re-anchors the search directory it is concatenated onto, so the import "
            "resolves outside the project"))
        d
      }
    }
  })

; AX3041, at the library literal's own span.
;
; The code is in the AX3xxx band although the refusal happens in the
; parser, and that is deliberate: nothing about the TOKEN is malformed -
; it is a well-formed string literal - what is wrong is what the string
; MEANS to the linker and to the emitted module. The same reading is why
; the check is not in the lexer: `scanStringEnd` treats a line break
; inside a literal as an ordinary character on purpose, and banning it
; there would be a change to every string in the language.
(pub :: ax3041Diag (-> Tokens Int String Diag))
(pub fn (ax3041Diag tokens pos ch)
  {
    (let tok (vecGet tokens pos))
    {
      (let d
        (mkDiag SEV_ERROR "AX3041" "extern-library-name" (tokenSpan tok)
          (if (== (strLen ch) 0)
            "an `extern` block's library name is empty"
            (concat (concat "`" ch) "` cannot appear in an `extern` block's library name"))
          None
          (Some
            (concat
              "a library name is the stem of `lib<name>.a`, so it is `[A-Za-z0-9._+-]` and nothing else - `axiom_demo`, `m`, `c++abi`; "
              "pass a directory with `--link-search DIR` rather than encoding one here, and name the boundary symbol in the item's own `(symbol \"...\")` clause"))))
      {
        (diagSetLabel d
          "this name is written into the emitted module and passed to the linker as `-l<name>`")
        ; The byte set is not tidiness. The name is emitted verbatim as
        ; `; axiom-extern-lib <name>` beside the declares, and a `;`
        ; comment ends at the newline - so until 2026-08-23 a library
        ; name holding one made every following line LIVE module-level
        ; IR. Measured: `(extern "m<LF>@AX_INJECTED_GLOBAL = global i64
        ; 4242<LF>define i64 @axiom_injected_fn() { ret i64 99 }<LF>"
        ; ...)` put both lines into the module, `axiom build` succeeded,
        ; and `nm` on the executable showed `_AX_INJECTED_GLOBAL` and
        ; `_axiom_injected_fn`. That lands AFTER the type checker, the
        ; effect system and the freestanding gate, and the driver's
        ; grounding pass reads `declare` lines only, so a `define` with
        ; a body or a `@llvm.global_ctors` entry - code that runs before
        ; `main` - passed every check the compiler has.
        ; `tests/diagnostics/945-extern-lib-newline.axbad` pins it.
        (diagAddNote d
          (concat
            "the name is emitted verbatim into the module beside the block's declares, where a `;` comment "
            "ends at the first newline"))
        d
      }
    }
  })

; AX2001 for a `for` whose binder is not followed by `in`, at the
; token where `in` belongs. The help inserts it, unless the form ends
; there: then the loop is missing more than one word, and an insertion
; would only move the error along.
(pub :: forInDiag (-> Tokens Int Diag))
(pub fn (forInDiag tokens pos)
  {
    (let tok (vecGet tokens pos))
    {
      (let d
        (mkDiag SEV_ERROR "AX2001" "unexpected-token" (tokenSpan tok)
          (concat (concat "expected `in` after the loop's binder, found `" (foundText tok)) "`")
          None None))
      {
        (diagSetLabel d "`in` goes here")
        (if (|| (peekIs tokens pos TK_RPAREN) (peekIs tokens pos TK_EOF))
          (diagAddHelp d
            "`for` takes `(for x in xs body)`, `(for (x i) in xs body)`, `(for i in lo..hi body)` or `(for i in lo..hi by step body)`")
          {
            (let at (spanStart (tokenSpan tok)))
            (diagAddFixHelp d "write `in` after the binder" (mkSpan at at) "in ")
          })
        d
      }
    }
  })

; Imports form the module header. Both late and nested imports keep
; AX2001, with placement advice at the import keyword.
(pub :: importPositionDiag (-> Tokens Int String diag::Diag))
(pub fn (importPositionDiag tokens pos code)
  (diagSetLabel
    (mkDiag SEV_ERROR "AX2001" "unexpected-token" (tokenSpan (vecGet tokens pos))
      (if (strEq code "import-order")
        "`import` must precede every other module declaration"
        "`import` is only allowed in the module header")
      None
      (Some
        "move this import before the module's signatures, functions and other declarations, outside any function, block or lambda"))
    "imports belong at the start of the module"))

(pub :: parseErrDiag (-> Tokens (PResult a) String Diag))
(pub fn (parseErrDiag tokens r src)
  ; Tested on the CODE rather than inferred from the position: the
  ; overflow token is always a real `(`, so every test below would step
  ; over it and report AX2003. An explicit code beats an inference that
  ; happens to be unreachable.
  {
    (let pos (pResPos r))
    (let exp (pResExp r))
    (if (strEq (pResCode r) "unmatched-paren")
      (diagSetLabel
        (mkDiag SEV_ERROR "AX2001" "unexpected-token" (tokenSpan (vecGet tokens pos))
          "unmatched `)`" None (Some "remove this `)`, or add the `(` it was meant to close"))
        "this `)` closes nothing")
      (if (strEq (pResCode r) "AX3133")
        (ax3133Diag tokens pos exp)
        (if (|| (strEq (pResCode r) "import-order") (strEq (pResCode r) "import-position"))
          (importPositionDiag tokens pos (pResCode r))
          (if (strEq (pResCode r) "AX2005")
            (ax2005Diag tokens pos)
            (if (strEq (pResCode r) "for-in")
              (forInDiag tokens pos)
              ; AX2006 is tested before the EOF branch for the same reason
              ; AX2005 is: the refusal happens at a real identifier token, so
              ; every test below would step over it and report AX2001 with an
              ; expectation the site never made.
              (if (strEq (pResCode r) "AX2006")
                (ax2006Diag tokens pos exp)
                (if (strEq (pResCode r) "AX3047")
                  (ax3047Diag tokens pos exp)
                  (if (strEq (pResCode r) "AX3041")
                    (ax3041Diag tokens pos exp)
                    ; A stray `'`, refused where the token kind is still
                    ; known: the generic arms below read only the
                    ; expectation, which a quote never states, so without
                    ; this the reader gets a bare syntax error.
                    (if (strEq (pResCode r) "quote")
                      (quoteDiag tokens pos)
                      ; AX2002 is NOT "the position is at EOF" - stage0 emits it from
                      ; exactly one routine, the one that demands a SPECIFIC token kind
                      ; (`expect(RParen)` and friends), and reports AX2001 with a found
                      ; text of `EOF` from every site that wanted a CATEGORY. So the
                      ; distinction is already carried here: a site that named its
                      ; expectation gets AX2001 wherever it failed, and a site that did
                      ; not is the specific-token case, which at EOF is AX2002.
                      (if (&& (== (strLen exp) 0)
                            (|| (>= pos (vecLen tokens))
                              (== (kindInt (tokenKind (vecGet tokens pos))) (kindInt TK_EOF))))
                        (diagSetLabel
                          (mkDiag SEV_ERROR "AX2002" "unexpected-eof"
                            (mkSpan (strLen src) (strLen src)) "unexpected end of file" None
                            (Some
                              (concat "count `(`/`[`/`{` against `)`/`]`/`}` "
                                "working backward from the end of the file")))
                          "file ends here while a form is still open")
                        {
                          (let tok (vecGet tokens pos))
                          (if (strEq (pResCode r) "AX2004")
                            (diagSetLabel
                              (mkDiag
                                SEV_ERROR
                                "AX2004"
                                "removed-construct"
                                (tokenSpan tok)
                                (if (strEq exp "fn")
                                  ; `fn` and `struct` are still Axiom - they
                                  ; declare - so only their expression spelling is
                                  ; refused, and the heading says which.
                                  "`fn` in expression position is refused: an anonymous function is `lambda`"
                                  (if (strEq exp "struct")
                                    "`struct` in expression position is refused: a struct is built by calling its name"
                                    (if (strEq exp "deriving")
                                      ; Five of the eight get their own verb:
                                      ; union/foreign (and region, until it returned)
                                      ; once WORKED and were
                                      ; removed, but `deriving` never derived anything,
                                      ; `linear` never counted a use, `consume` never
                                      ; reclaimed a byte, and the list and tuple types
                                      ; never inhabited a value. Saying "no longer part of
                                      ; Axiom" about those five would claim a history
                                      ; they do not have, and the difference is the
                                      ; whole reason a reader is being told anything.
                                      "`deriving` parsed and derived nothing, and is now refused"
                                      (if (strEq exp "linear")
                                        "`linear` parsed and enforced nothing, and is now refused"
                                        (if (strEq exp "consume")
                                          "`consume` parsed and reclaimed nothing, and is now refused"
                                          (if (strEq exp "list")
                                            "`[T]` checked as a type no value could inhabit, and is now refused"
                                            (if (strEq exp "tuple")
                                              "`(A B)` checked as a type no value could inhabit, and is now refused"
                                              (concat (concat "`" exp)
                                                "` is no longer part of Axiom"))))))))
                                None
                                (Some (removedHelp exp)))
                              (removedRationale exp))
                            ; NO LABEL, deliberately, and the same for AX3067-AX3070, AX3011,
                            ; AX3017 and AX3010. stage0 set a primary label on all
                            ; twenty-seven of its diagnostics, but for these five the
                            ; label WAS the heading - `message.clone()` at the call site -
                            ; and ariadne fell back to the heading anyway when a label was
                            ; empty, so its output always printed something under the
                            ; caret, sometimes the same sentence twice. Printing nothing
                            ; when there is nothing further to say is the better half of
                            ; that behaviour, and it keeps `#` out of the AXDL line rather
                            ; than putting a redundant field in it.
                            (if (== (strLen exp) 0)
                              (mkDiag SEV_ERROR "AX2003" "syntax-error" (tokenSpan tok)
                                "syntax error" None None)
                              (diagSetLabel
                                (mkDiag SEV_ERROR "AX2001" "unexpected-token" (tokenSpan tok)
                                  (concat (concat "expected " exp)
                                    (concat ", found `" (concat (foundText tok) "`")))
                                  None
                                  (Some
                                    (concat (concat "Axiom expected " exp) " at this position")))
                                (concat (concat "found `" (foundText tok)) "` here"))))
                        }))))))))))
  })

; The diagnostic for a LEXICAL error, or None when the token stream has
; none. Lexing happens before parsing, so this is asked first and a
; file with both kinds of error reports this one - which is also
; stage0's order.
;
; The code comes from the first byte of the offending span, because
; most `TK_ERROR` conditions can only begin one way: `"` a string, `'`
; an unterminated char, a digit a number, anything else an unexpected
; character. Invalid UTF-8 inside a closed char literal starts at the
; bad byte; the preceding quote identifies that case. The lexer records
; the span, which determines the diagnostic without a token payload.
;
; A bad escape starts with `\`, and so does a bare `\` outside any literal,
; which is an unexpected character. Keying off the byte gave the bare
; one AX1005 where stage0 says AX1001 - found by sweeping all 94
; printable bytes through both compilers, not by reading.
(pub :: lexErrDiag (-> Tokens String (Option Diag)))
(pub fn (lexErrDiag tokens src)
  {
    (let mut i 0)
    (let mut found (:: None (Option Token)))
    (let mut isEsc false)
    {
      (while (&& (< i (vecLen tokens)) (isNone found))
        {
          {
            (let k (kindInt (tokenKind (vecGet tokens i))))
            (if (== k (kindInt TK_ERROR))
              (set found (Some (vecGet tokens i)))
              (if (== k (kindInt TK_ERROR_ESC))
                {
                  (set found (Some (vecGet tokens i)))
                  (set isEsc true)
                }))
          }
          (set i (+ i 1))
        })
      (if (let (Some token) found)
        (Some
          {
            (let sp (tokenSpan token))
            {
              (let b (strByte src (spanStart sp)))
              (if isEsc
                (diagSetLabel
                  (mkDiag SEV_ERROR "AX1005" "invalid-escape-sequence" sp
                    (concat (concat "invalid escape sequence `" (strSlice src (spanStart sp) 2))
                      "`")
                    None (Some "valid escapes are \\n \\t \\r \\\\ \\\" \\' \\0"))
                  "unrecognized escape sequence")
                (if (== b 34)
                  (diagSetLabel
                    (mkDiag SEV_ERROR "AX1002" "unterminated-string" sp
                      "unterminated string literal" None
                      (Some "add a closing `\"`, or escape an embedded quote as `\\\"`"))
                    "string literal starts here but is never closed")
                  (if (== b 39)
                    (diagSetLabel
                      (mkDiag SEV_ERROR "AX1003" "unterminated-char" sp "unterminated char literal"
                        None
                        (Some
                          "character literals must contain exactly one character, e.g. `'a'` or `'\\n'`"))
                      "character literal starts here but is never closed")
                    (if (|| (isDigit b)
                          (&& (== b 45)
                            (&& (< (+ (spanStart sp) 1) (spanEnd sp))
                              (isDigit (strByte src (+ (spanStart sp) 1))))))
                      (diagSetLabel
                        (mkDiag SEV_ERROR "AX1004" "invalid-number-literal" sp
                          (concat
                            (concat "invalid number literal `"
                              (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))
                            "`")
                          None
                          (Some "check for a value that overflows i64/f64 or a malformed exponent"))
                        (concat
                          (concat "`" (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))
                          "` cannot be parsed as Int or Float"))
                      ; A malformed char literal's error token starts
                      ; at its lead byte, so the diagnostic never puts
                      ; ill-formed source bytes into its text.
                      ; The lexer's other error tokens cover the whole
                      ; character (`lexErrCharLen`), so the quote does
                      ; too; a byte that begins no UTF-8 character is
                      ; NAMED rather than quoted, since quoting it
                      ; would put a byte that is not text into every
                      ; renderer's output.
                      {
                        (let ch (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))
                        (if (&& (>= b 128) (== (strLen ch) 1))
                          (if (&& (> (spanStart sp) 0) (== (strByte src (- (spanStart sp) 1)) 39))
                            (diagSetLabel
                              (mkDiag SEV_ERROR "AX1001" "unexpected-char" sp
                                (concat "invalid UTF-8 character literal at byte 0x"
                                  (hexByteUpper b))
                                None
                                (Some
                                  "a character literal must contain one well-formed UTF-8 character"))
                              "invalid UTF-8 here")
                            (diagSetLabel
                              (mkDiag SEV_ERROR "AX1001" "unexpected-char" sp
                                (concat (concat "unexpected byte 0x" (hexByteUpper b))
                                  ", which begins no UTF-8 character")
                                None
                                (Some
                                  "Axiom source is UTF-8; this byte is not part of a well-formed character - the file may be in another encoding, or damaged"))
                              "not UTF-8"))
                          (diagSetLabel
                            (mkDiag SEV_ERROR "AX1001" "unexpected-char" sp
                              (concat (concat "unexpected character `" ch) "`") None
                              (Some
                                "an identifier is letters, digits, `_`, `'` and `+ - * / % < > = ! & | ^`, and cannot begin with a digit or `'`; operators are not a separate class - `+` is simply an identifier - and `?`, `~` and `@` are not identifier characters at all"))
                            (concat (concat "`" ch) "` is not valid here")))
                      }))))
            }
          })
        None)
    }
  })

; Two upper-case hex digits for byte `b`.
(pub :: hexByteUpper (-> Int String))
(pub fn (hexByteUpper b)
  (concat (strSlice "0123456789ABCDEF" (/ b 16) 1) (strSlice "0123456789ABCDEF" (% b 16) 1)))

; The EOF token has no lexeme; stage0 spells it `EOF` in the message.
(pub :: foundText (-> Token String))
(pub fn (foundText tok)
  (if (== (kindInt (tokenKind tok)) (kindInt TK_EOF))
    "EOF"
    (tokenLexeme tok)))

; The advice for each removed keyword. `union` carries stage0's
; wording verbatim, from when there were two compilers whose text had
; to agree; `foreign` is stage1's own, written when the FFI went. The
; whole construct exists to be read by a person porting old source,
; which is why the text is here and not a generic refusal. `region`'s
; arm is DELETED rather than kept: the word is a keyword again
; (`parseRegionExpr`, 2026-09-03), and the advice it carried -
; "allocation lifetime is inferred" - described a model the language
; withdrew (docs/memory-model.md §3.4). The final arm of
; each function is a generic sentence no caller reaches today.
(pub :: removedHelp (-> String String))

; WHY the construct is gone, phrased as a statement about the language
; rather than about the parser's expectations - stage0's `rationale()`,
; which is what its primary label carried while `removedHelp` here is
; its `replacement()`. Two halves of one explanation that stage1 had
; only one of.
(pub :: removedRationale (-> String String))
(pub fn (removedRationale kw)
  (if (strEq kw "cast")
    "`as` converts numeric values explicitly; bit reinterpretation uses `floatToBits` or `floatFromBits`"
    (if (strEq kw "alloc")
      "`alloc` was refused rather than implemented: the form typed as a pointer and evaluated to the constant 0, so a program holding one held no memory"
      (if (strEq kw "define")
        "`define` was the old spelling of `fn`, read as the same declaration; a language with two spellings of one thing makes every reader learn both"
        (if (strEq kw "fn")
          "an anonymous function had two spellings, `(fn (x) ...)` and `(lambda (x) ...)`; `lambda` is the one, and `fn` only declares"
          (if (strEq kw "struct")
            "a struct value had two spellings, `(struct Pt 3 4)` and `(Pt 3 4)`; the call is the one, and `struct` only declares"
            (if (strEq kw "begin")
              (concat "`begin` was replaced by `{ }` brace blocks and implicit "
                "sequencing; it was an ordinary name to the parser afterwards, so using one drew `AX3001 undefined variable begin`, which named no replacement")
              (if (strEq kw "union")
                (concat "`union` was removed: C interoperability is no longer a goal, "
                  "and an untagged union cannot be pattern-matched safely - its variants are not distinguishable at run time")
                (if (strEq kw "linear")
                  (concat
                    (concat "`linear` was refused rather than implemented: it built the nominal "
                      "type `Linear T` and enforced nothing else - no use was counted, so a ")
                    "value could be consumed twice or never, and the marker read as an ownership guarantee it did not supply")
                  (if (strEq kw "consume")
                    (concat
                      (concat "`consume` was refused rather than implemented: it was a parse-time "
                        "IDENTITY that kept the `Linear` wrapper, so consuming twice was ")
                      "accepted and the form reclaimed nothing")
                    (if (strEq kw "foreign")
                      (concat
                        (concat "`foreign` was removed because it never worked: it emitted a call "
                          "to a symbol the module never declared, so a program using one ")
                        "passed `check` and died in `opt`. The FFI is the `extern` block")
                      (if (strEq kw "deriving")
                        (concat
                          "`deriving` was refused rather than implemented: the clause parsed and was silently discarded - "
                          "no instance was ever derived from it, and a clause that does nothing is worse than one that does not parse")
                        (if (strEq kw "trait")
                          (concat
                            (concat
                              "`trait` was removed: an interface is a CAPABILITY RECORD now - a "
                              "parameterised struct holding the functions, passed as a value. ")
                            "`(struct ShowOf (a) (render : (-> a String)))`, and `(ShowOf fmtInt)` is the instance")
                          (if (strEq kw "impl")
                            (concat
                              (concat
                                "`impl` was removed with `trait`: an instance is a VALUE now, not a "
                                "declaration - bind one with `fn` and pass it where it is needed. ")
                              "`show` needs none: the compiler renders every type from its static type without one")
                            (if (strEq kw "list")
                              (concat
                                (concat
                                  "`[T]` was refused rather than implemented: the form checked in "
                                  "signatures while no literal, no pattern and no runtime representation existed behind it - ")
                                "a reader met the syntax in the reference, wrote it, and got a parse error. Sequences are `(Vec T)`")
                              (if (strEq kw "tuple")
                                (concat
                                  (concat
                                    "`(A B)` was refused rather than implemented: the form checked in "
                                    "signatures while no literal, no pattern and no runtime representation existed behind it. ")
                                  "Products are `struct`, sums are `data`")
                                (if (strEq kw "emacro")
                                  "`emacro` was a second spelling of a rule-form macro, for rules whose template is one expression; `macro` reads each rule's template as declarations or as an expression, and where the macro is invoked picks"
                                  (concat (concat "`" kw) "` was removed"))))))))))))))))))

(pub fn (removedHelp kw)
  (if (strEq kw "cast")
    "write `(as value Type)`; replace numeric conversion primitives with `as`, and bit reinterpretation with `Float.floatToBits` or `Float.floatFromBits`"
    (if (strEq kw "alloc")
      "allocate with `__alloc`, or use `vecNew`, `strAlloc` or a struct: `(alloc T n)` typed `*mut T` and evaluated to 0, so it never allocated anything"
      (if (strEq kw "define")
        "write `fn`: `(fn (add x y) (+ x y))`, and `(fn (answer) 42)` for a function with no parameters"
        (if (strEq kw "fn")
          "write `lambda` for an anonymous function: `(lambda (x) (+ x 1))`"
          (if (strEq kw "struct")
            "call the struct's name with its fields in declaration order: `(Pt 3 4)`"
            (if (strEq kw "begin")
              (concat "use a brace block: `{ a b c }` sequences expressions and answers "
                "the last one, which is what `(begin a b c)` meant - and a `fn` body already sequences, so the wrapper is usually just deletable")
              (if (strEq kw "union")
                (concat "use `data` for a tagged sum whose variants the compiler can check "
                  "for exhaustiveness, or `struct` for a product of fields")
                (if (strEq kw "linear")
                  (concat
                    (concat "delete the marker and use the type itself: reclamation is the "
                      "reference counting every heap block carries, and ")
                    "`__axiom_arena_mark`/`__axiom_arena_reset_keeping` is the explicit fallback for a program that wants to choose the point")
                  (if (strEq kw "consume")
                    (concat "delete the wrapper and keep its argument - `(consume e)` always "
                      "meant `e`, and a block is freed when its count reaches zero")
                    (if (strEq kw "foreign")
                      (concat
                        (concat "write an `extern` block instead - `(extern \"lib\" (name :: "
                          "(-> Int Int) (symbol \"sym\")))` - and build with ")
                        (concat "`--link-lib`/`--link-search`; or reach the kernel through the "
                          "standard library's `__syscall0`-`__syscall6`, which needs no FFI"))
                      (if (strEq kw "deriving")
                        (concat "derive instances explicitly, where you want them: "
                          "`(deriveEq T)` is an ordinary declaration macro (docs/macro-system.md MAC-CAP-9)")
                        (if (strEq kw "trait")
                          (concat
                            (concat
                              "declare a capability record instead: `(struct ShowOf (a) (render : "
                              "(-> a String)))`, and bind an instance with `fn` - ")
                            "`(fn (showInt) (ShowOf fmtInt))`. Call through the field: `(c.render x)`")
                          (if (strEq kw "impl")
                            (concat
                              (concat
                                "bind the instance as a VALUE - `(fn (showColor) (ShowOf renderColor))` "
                                "- and pass it where it is needed. If this was an `impl` of `Show`, ")
                              "delete it: `show` and `{}` interpolation render every type from its static type without one")
                            (if (strEq kw "list")
                              (concat
                                "write `(Vec T)` for a sequence: `vecNew`, `vecGet`, `vecPush` and "
                                "`(for x in xs body)` are its surface")
                              (if (strEq kw "tuple")
                                (concat
                                  "write a `struct` for a product of named fields, or `data` for a "
                                  "tagged sum - both are inhabited, matched and reclaimed")
                                (if (strEq kw "emacro")
                                  "write `macro`: `(macro total ((total x) x) ((total x rest ...) (+ x (total rest ...))))` is an expression macro, because each rule's template is one expression"
                                  "run `axiom explain AX2004`")))))))))))))))))

; ------------------------------------------------------------------
; Token helpers.
; ------------------------------------------------------------------
(pub :: kindInt (-> TokenKind Int))
(pub fn (kindInt k)
  (as k Int))

; Missing lookahead is separate from the EOF token the lexer supplies.
(pub :: peekToken (-> Tokens Int (Option Token)))
(pub fn (peekToken tokens pos)
  (if (>= pos (vecLen tokens))
    None
    (Some (vecGet tokens pos))))

(pub :: peekIs (-> Tokens Int TokenKind Bool))
(pub fn (peekIs tokens pos kind)
  (if (let (Some token) (peekToken tokens pos))
    (== (kindInt (tokenKind token)) (kindInt kind))
    (== (kindInt TK_EOF) (kindInt kind))))

(pub :: advance (-> Int Int))
(pub fn (advance p)
  (+ p 1))

; ------------------------------------------------------------------
; Skip to matching close-paren. depth starts at 1.
; ------------------------------------------------------------------
(pub :: skipParens (-> Tokens Int Int (PResult ())))
(pub fn (skipParens tokens pos depth)
  (if (>= pos (vecLen tokens))
    (pErr pos)
    (if (peekIs tokens pos TK_RPAREN)
      (if (== depth 1)
        (pOk () (advance pos))
        (skipParens tokens (advance pos) (- depth 1)))
      (if (peekIs tokens pos TK_LPAREN)
        (skipParens tokens (advance pos) (+ depth 1))
        (skipParens tokens (advance pos) depth)))))

; ------------------------------------------------------------------
; Parse literals.
; ------------------------------------------------------------------
(pub :: parseLit (-> Tokens Int (PResult ASTNode)))
(pub fn (parseLit tokens pos)
  ; Literals carry their token's span now: an AX3004 about an argument
  ; or an if-join anchors at the literal in stage0, and a span the
  ; checker does not have is a diagnostic it must suppress.
  (if (peekIs tokens pos TK_INT)
    {
      (let t (vecGet tokens pos))
      (pOk (nodeBuildEInt (strToInt (tokenLexeme t)) 0 0 (tokenSpan t)) (advance pos))
    }
    (if (peekIs tokens pos TK_FLOAT)
      {
        (let t (vecGet tokens pos))
        (pOk (nodeBuildEFlt (floatLexemeBits (tokenLexeme t)) 0 0 (tokenSpan t)) (advance pos))
      }
      (if (peekIs tokens pos TK_CHARLIT)
        ; A char is its codepoint word at runtime, but its TYPE is Char,
        ; so it keeps its own tag; codegen emits it as the integer it is.
        {
          (let t (vecGet tokens pos))
          (match (charLexemeCode (tokenLexeme t))
            ((None) (pErr pos))
            ((Some code) (pOk (nodeBuildEChar code 0 0 (tokenSpan t)) (advance pos))))
        }
        (if (peekIs tokens pos TK_STRING)
          {
            (let t (vecGet tokens pos))
            (pOk (nodeBuildEStr (tokenLexeme t) 0 0 (tokenSpan t)) (advance pos))
          }
          (pErr pos))))))

; The code point a char lexeme denotes; the lexeme includes its
; quotes. A code point, not a byte: `'é'` is 233 and `'世'` 19990 in
; stage0, and reading one byte answered 195 and 228 - the lead bytes
; of their encodings.
; Escapes are stage0's set: \n \t \r \0, and \\ \' \" denote
; themselves. The lexer rejects any other escaped byte.
;
; The lexer rejects a malformed character before producing TK_CHARLIT.
; Keep that absence explicit here too, including for a constructed token.
(pub :: charLexemeCode (-> String (Option Int)))
(pub fn (charLexemeCode lex)
  {
    (let n (strLen lex))
    (if (|| (< n 3) (|| (!= (strByte lex 0) 39) (!= (strByte lex (- n 1)) 39)))
      None
      (if (== (strByte lex 1) 92)
        {
          (let e (strByte lex 2))
          (if (&& (== n 4) (isEscapeChar e))
            (Some
              (if (== e 110)
                10
                (if (== e 116)
                  9
                  (if (== e 114)
                    13
                    (if (== e 48)
                      0
                      e)))))
            None)
        }
        (if (== (utf8WellFormedAt lex 1 (- n 1)) (- n 2))
          (utf8DecodeAt lex 1)
          None)))
  })

; The IEEE-754 bits of the value a float lexeme denotes: the binary64
; nearest to the decimal it spells, ties to even, which is what
; `Float.floatParse` answers for any number of digits. So `0.1` and
; `3.14159265358979323846` land on the nearest double, a literal with
; more integer or fraction digits than an `Int` holds is still exact,
; and `-0.0` keeps its sign. The lexer has already checked the shape
; (an optional `-`, digits, one `.`, digits, with `_` separators among
; the digits), so once the separators are gone the parse can't fail; a
; failure would answer the bits of 0.0.
(pub :: floatLexemeBits (-> String Int))
(pub fn (floatLexemeBits lex)
  (match (floatParse (dropUnderscores lex))
    ((Ok x) (floatToBits x))
    ((Err _) 0)))

; `lex` without its `_` digit separators: `1_000.5` reads as `1000.5`.
(pub :: dropUnderscores (-> String String))
(pub fn (dropUnderscores lex)
  {
    (let out strBuilderNew)
    (let mut from 0)
    (let n (strLen lex))
    {
      (for i in 0..n
        (if (== (strByte lex i) 95)
          {
            (strBuilderPush out (strSlice lex from (- i from)))
            (set from (+ i 1))
          }))
      (strBuilderFinish (strBuilderPush out (strSlice lex from (- n from))))
    }
  })

(pub :: parseIdentRef (-> Tokens Int (PResult ASTNode)))
; A dotted chain of identifiers is either FIELD ACCESS (`p.x.y`) or a
; MODULE PATH (`Sys.Platform::sysReadNum`), and which one is only known at
; the end: `::` makes it a module path. So the chain is collected
; first and the decision taken after - stage0's rule, and it records
; having got this wrong in the other order, where committing to a
; field access as each dot was consumed left the `::` unconsumed and
; reported "expected expression, found `::`" for exactly the dotted
; module names `import Sys.Platform` creates.
;
; A qualified reference needs no node of its own. The path joined by
; `.`, then `$`, then the name IS the mangled symbol every imported
; declaration already carries - `Mem::memAlloc` is `Mem$memAlloc`,
; which is what `mangleDecl` wrote and what the checker and emitter
; both look up. So it resolves to an ordinary variable reference with
; the mangled name, and nothing downstream needs to know.
(pub fn (parseIdentRef tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let t (vecGet tokens pos))
      {
        (let chain
          {
            (let v vecNew)
            {
              (vecPush v (tokenLexeme t))
              v
            }
          })
        {
          (let afterChain (parseDottedChain tokens (advance pos) chain))
          (if (peekIs tokens afterChain TK_DOUBLE_COLON)
            (parseQualifiedTail tokens afterChain chain (tokenSpan t))
            (parseFieldChain tokens (advance pos) (mkEVarAt (tokenLexeme t) (tokenSpan t))))
        }
      }
    }
    (pErrExp pos "expression")))

; Consume `.ident` runs, recording the segments, and answer the
; position after them. Used only to LOOK AHEAD for a `::`; when there
; is none the caller re-parses from the start as a field chain, which
; costs one extra pass over a handful of tokens and keeps the field
; path exactly as it was.
(pub :: parseDottedChain (-> Tokens Int Strings Int))
(pub fn (parseDottedChain tokens pos acc)
  (if (&& (peekIs tokens pos TK_DOT) (peekIs tokens (advance pos) TK_IDENT))
    {
      (vecPush acc (tokenLexeme (vecGet tokens (advance pos))))
      (parseDottedChain tokens (advance (advance pos)) acc)
    }
    pos))

; At the `::`. Every further `::ident` extends the path; the LAST
; segment is the name and the rest are the module.
(pub :: parseQualifiedTail (-> Tokens Int Strings Int (PResult ASTNode)))
(pub fn (parseQualifiedTail tokens pos chain sp)
  (if (peekIs tokens pos TK_DOUBLE_COLON)
    (if (peekIs tokens (advance pos) TK_IDENT)
      {
        (vecPush chain (tokenLexeme (vecGet tokens (advance pos))))
        (parseQualifiedTail tokens (advance (advance pos)) chain sp)
      }
      (pErr pos))
    (pOk (mkEVarAt (mangledFromChain chain) sp) pos)))

; `[A B name]` -> `A.B$name`: the module segments joined by `.`, then
; `$`, then the name. That is the spelling `mangleDecl` gives an
; imported declaration, so the reference and the definition meet.
(pub :: mangledFromChain (-> Strings String))
(pub fn (mangledFromChain chain)
  (concat (concat (joinDotted chain 0 "") "$") (vecGetStr chain (- (vecLen chain) 1))))

(pub :: joinDotted (-> Strings Int String String))
(pub fn (joinDotted chain i acc)
  (if (>= i (- (vecLen chain) 1))
    acc
    (joinDotted chain (+ i 1)
      (if (== i 0)
        (vecGetStr chain 0)
        (concat (concat acc ".") (vecGetStr chain i))))))

; `.field` suffixes make field accesses, folded left so `a.b.c` reads
; the `c` of the value at `a.b`. Dotted module paths never reach here -
; imports parse through parseModPath.
(pub :: parseFieldChain (-> Tokens Int ASTNode (PResult ASTNode)))
(pub fn (parseFieldChain tokens pos base)
  ; The node's span is the FIELD NAME token's - AX3007's anchor. An
  ; expression-position anchor for the whole access is the BASE's span
  ; (stage0's EField.span() recurses to the base), which the checker
  ; computes by walking, not by reading this slot.
  (if (&& (peekIs tokens pos TK_DOT) (peekIs tokens (advance pos) TK_IDENT))
    (parseFieldChain tokens (advance (advance pos))
      (nodeBuildEField base (tokenLexeme (vecGet tokens (advance pos))) 0
        (tokenSpan (vecGet tokens (advance pos)))))
    (pOk base pos)))

; ------------------------------------------------------------------
; Parse an identifier token, returning the lexeme Str handle.
; ------------------------------------------------------------------
(pub :: parseIdentName (-> Tokens Int (PResult String)))
(pub fn (parseIdentName tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let t (vecGet tokens pos))
      (pOk (tokenLexeme t) (advance pos))
    }
    (pErrExp pos "identifier")))

; A declaration NAME position: a bare identifier, or the query form
; `(syntax/join a b)` (macro-system.md MAC-CAP-5) standing in for the
; identifier phase D computes at instantiation. The parsed spelling is
; the MARKER STRING "syntax/join a b" - the three parts space-joined,
; and a space can never appear in a lexed identifier, so no real name
; collides with it and the node layout is untouched. `expSubstName`
; resolves the marker inside a template; one that reaches any other
; consumer - written outside a macro - is refused there (AX3028), the
; same shape as the unknown-declaration-head refusal.
; Either side may be a join of its own, so a generated name can carry
; more than two parts: `(syntax/join (syntax/join get S) f)` is
; `getPointX`, which is what a lens set over two structs sharing a
; field name needs - `getX` twice is one program with two definitions
; of one symbol. The marker stays the same space-joined string,
; PREFIX-encoded, and `expMarkerPart` reads it back.
(pub :: parseDeclName (-> Tokens Int (PResult String)))
(pub fn (parseDeclName tokens pos)
  (if (&& (peekIs tokens pos TK_LPAREN)
        (&& (peekIs tokens (advance pos) TK_IDENT)
          (strEq (tokenLexeme (vecGet tokens (advance pos))) "syntax/join")))
    {
      (let p1 (advance (advance pos)))
      {
        (let lr (parseJoinOperand tokens p1))
        (match lr
          ((ParseFailed parseError1) (ParseFailed parseError1))
          ((ParseSuccess parsedValue1 parsedPos1)
            {
              (let rr (parseJoinOperand tokens parsedPos1))
              (match rr
                ((ParseFailed parseError2) (ParseFailed parseError2))
                ((ParseSuccess parsedValue2 parsedPos2)
                  (if (peekIs tokens parsedPos2 TK_RPAREN)
                    (pOk (concat (concat (concat "syntax/join " parsedValue1) " ") parsedValue2)
                      (advance parsedPos2))
                    (pErrExp parsedPos2 ")"))
                ))
            }
          ))
      }
    }
    ; A declared name is a name, not an operator. Every use of `-`
    ; or `*` reaches the built-in, so a function, constructor or type
    ; spelled like one could never be reached.
    (if (&& (peekIs tokens pos TK_IDENT) (nameIsOperator (tokenLexeme (vecGet tokens pos))))
      (pErrExp pos "a declaration name - an operator is built in")
      (parseIdentName tokens pos))))

; A join's operand: a bare identifier, or a nested join. Answers the
; operand's own marker text, which the caller splices into its own.
(pub :: parseJoinOperand (-> Tokens Int (PResult String)))
(pub fn (parseJoinOperand tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
    (parseDeclName tokens pos)
    (if (peekIs tokens pos TK_IDENT)
      (pOk (tokenLexeme (vecGet tokens pos)) (advance pos))
      (pErrExp pos "identifier"))))

; ------------------------------------------------------------------
; Parse a list of identifiers until ), returning a Vec of Str handles.
; ------------------------------------------------------------------
(pub :: parseIdentList (-> Tokens Int Strings (PResult Names)))
(pub fn (parseIdentList tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_IDENT)
      {
        (let t (vecGet tokens pos))
        (parseIdentList tokens (advance pos) (vecPush acc (tokenLexeme t)))
      }
      (pErrExp pos "identifier"))))

; Does this name start with an operator character? A top-level
; function spelled like one is refused: every call of `*` reaches the
; built-in, and an operator can't be passed as a value, so the
; definition could never run. A parameter or local spelled like one is
; fine, and shadows the operator in its scope.
(pub :: nameIsOperator (-> String Bool))
(pub fn (nameIsOperator s)
  (if (== (strLen s) 0)
    false
    {
      (let c (strByte s 0))
      (|| (|| (|| (== c 43) (== c 45)) (|| (== c 42) (== c 47)))
        (|| (|| (|| (== c 37) (== c 94)) (|| (== c 61) (== c 60)))
          (|| (|| (|| (== c 62) (== c 33)) (|| (== c 38) (== c 124)))
            (|| (== c 63) (|| (== c 126) (== c 36))))))
    }))

; ------------------------------------------------------------------
; A MACRO RULE's pattern (macro-system.md MAC-LANG-15).
;
; Deliberately NOT `parseArmPattern`. That one reads an UPPERCASE head
; as a constructor - `TAG_P_CON0`, named fields - and a macro pattern
; has no notion of a constructor: MAC-LANG-15's table has four
; implementable rows (identifier, `_`, a literal, `(p1 ... pn)`) and
; none of them is one. Here every parenthesised form is a form of n
; elements whatever its head spells, which is also what the ARGUMENT
; side is - `parseExprList` builds the invocation's arguments - and
; the two must be shaped alike for matching to be a comparison rather
; than a translation.
;
; The nesting is `mkEApp`'s left spine, the same one an application
; gets, which is what makes `(f x y)` the same tree on both sides. It
; also makes `((f x) y)` the same tree as `(f x y)`: an ambiguity
; inherited from the AST rather than introduced here, and symmetric,
; so a pattern and an argument that spell alike still match.
; ------------------------------------------------------------------
(pub :: parseMacroPat (-> Tokens Int (PResult ASTNode)))
(pub fn (parseMacroPat tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let t (vecGet tokens pos))
      (pOk (mkEVarAt (tokenLexeme t) (tokenSpan t)) (advance pos))
    }
    (if (peekIs tokens pos TK_LPAREN)
      (parseMacroPatArgs tokens (advance pos) nilNode)
      (if (|| (peekIs tokens pos TK_INT)
            (|| (peekIs tokens pos TK_FLOAT)
              (|| (peekIs tokens pos TK_CHARLIT) (peekIs tokens pos TK_STRING))))
        (parseLit tokens pos)
        (pErrExp pos "a pattern")))))

; The elements of a parenthesised pattern, folded into a spine. An
; EMPTY one is refused: `()` would match a form of zero elements, and
; no argument is one, so it is a rule that could never fire.
(pub :: parseMacroPatArgs (-> Tokens Int ASTNode (PResult ASTNode)))
(pub fn (parseMacroPatArgs tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (if (nodeSame acc nilNode)
      (pErrExp pos "a pattern")
      (pOk acc (advance pos)))
    (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      {
        (let r (parseMacroPat tokens pos))
        (match r
          ((ParseFailed parseError3) (ParseFailed parseError3))
          ((ParseSuccess parsedValue3 parsedPos3)
            (parseMacroPatArgs tokens parsedPos3
              (if (nodeSame acc nilNode)
                parsedValue3
                (mkEApp acc parsedValue3)))
          ))
      })))

; A rule head's argument list. Answers three parallel vectors, one
; entry per TOP-LEVEL element: the pattern nodes, the names slot the
; rule record has always carried, and each element's source spelling
; for the shape list MAC-LANG-18's refusal prints.
;
; The names slot keeps its old meaning exactly - one entry per
; top-level element, so its length is still the rule's ARITY and
; everything that reads it as one is untouched. A bare binder
; contributes its own name, as it always did; anything else
; contributes the marker `syntax/pat`. A space cannot occur in a lexed
; identifier, so no template name can resolve to the marker - the same
; trick `(syntax/join a b)` uses one screen up, and for the same
; reason.
(pub :: parseMacroPatList (-> Tokens Int Nodes Strings Strings Ints (PResult MacroPatternParts)))
(pub fn (parseMacroPatList tokens pos pats names spells reps)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk (MacroPatternParts :patterns pats :names names :spellings spells :repeats reps)
      (advance pos))
    {
      (let r (parseMacroPat tokens pos))
      (match r
        ((ParseFailed parseError4) (ParseFailed parseError4))
        ((ParseSuccess parsedValue4 parsedPos4)
          ; An element followed by `...` REPEATS (MAC-LANG-16). The
          ; ellipsis lexes as an ordinary identifier, so this is a
          ; spelling test and not a token kind - see `lexer.ax` for
          ; why that was the cheap way in.
          {
            (let afterPat parsedPos4)
            {
              (let rep
                (if (patIsEllipsis tokens afterPat)
                  1
                  0))
              {
                (vecPush pats parsedValue4)
                (vecPush names (patSlotName parsedValue4))
                (vecPush spells
                  (concat (patTokensSpelling tokens pos afterPat "")
                    (if (== rep 1)
                      " ..."
                      "")))
                (vecPush reps rep)
                (parseMacroPatList tokens
                  (if (== rep 1)
                    (advance afterPat)
                    afterPat)
                  pats names spells reps)
              }
            }
          }
        ))
    }))

(pub :: patIsEllipsis (-> Tokens Int Bool))
(pub fn (patIsEllipsis tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    (strEq (tokenLexeme (vecGet tokens pos)) "...")
    false))

; Whether a rule PATTERN contains `...` anywhere inside it - for the
; refusal a repeat beneath a repeat draws (MAC-LANG-16). The
; top-level `...` never reaches here: `parseMacroPatList` consumes
; it into the `reps` vector before this is asked. What is left is a
; `VAR` spelling `...` nested in a form, which matching would
; otherwise bind as an ordinary name, one silent wrong answer per
; element. Pure readers, so untagged.
(pub :: patHasEllipsis (-> ASTNode Int))
(pub fn (patHasEllipsis p)
  (if (nodeSame p nilNode)
    0
    {
      (let tg (nodeTag p))
      (if (== tg TAG_E_VAR)
        (if (strEq (nodeAName p) "...")
          1
          0)
        (if (== tg TAG_E_APP)
          (if (== (patHasEllipsis (nodeAChild p)) 1)
            1
            (patHasEllipsis (nodeBChild p)))
          0))
    }))

; The names-slot entry for one top-level pattern element.
(pub :: patSlotName (-> ASTNode String))
(pub fn (patSlotName p)
  (if (== (nodeTag p) TAG_E_VAR)
    (if (strEq (nodeAName p) "_")
      "syntax/pat"
      (nodeAName p))
    "syntax/pat"))

; One pattern element as source, joined from the TOKENS it consumed
; rather than reconstructed from the tree. The tree cannot answer it:
; a float pattern holds its bits and a char its codepoint, so printing
; either back would need a formatter the parser does not import, and
; would print a spelling the author did not write. The tokens are what
; the author wrote.
(pub :: patTokensSpelling (-> Tokens Int Int String String))
(pub fn (patTokensSpelling tokens from to acc)
  (if (>= from to)
    acc
    {
      (let lx (tokenLexeme (vecGet tokens from)))
      (patTokensSpelling tokens (+ from 1) to
        (if (== (strLen acc) 0)
          lx
          (if (|| (strEq lx ")") (strEq (patLastByte acc) "("))
            (concat acc lx)
            (concat (concat acc " ") lx))))
    }))

(pub :: patLastByte (-> String String))
(pub fn (patLastByte s)
  (if (== (strLen s) 0)
    ""
    (strSlice s (- (strLen s) 1) 1)))

; ------------------------------------------------------------------
; Parse an expression list until ), returning a Vec of Expr handles.
; ------------------------------------------------------------------
(pub :: parseExprList (-> Tokens Int Nodes (PResult Nodes)))
(pub fn (parseExprList tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_EOF)
      ; At EOF the two compilers want different things, and stage0 is
      ; right about which: with nothing parsed yet the list is still
      ; waiting for its first EXPRESSION (AX2001, found `EOF`), but
      ; once one has been parsed the only thing that can legally come
      ; next is the closing paren - a specific token, which is the one
      ; routine stage0 reports AX2002 from. Probed both ways:
      ; `(fn (main)` gives "expected expression, found `EOF`" and
      ; `(fn (main) (+ 1 2)` gives "unexpected end of file".
      (if (== (vecLen acc) 0)
        (pErrExp pos "expression")
        (pErr pos))
      {
        (let r (parseExpr tokens pos))
        (match r
          ((ParseFailed parseError5) (ParseFailed parseError5))
          ((ParseSuccess parsedValue5 parsedPos5)
            (parseExprList tokens parsedPos5 (vecPush acc parsedValue5))
          ))
      })))

; ------------------------------------------------------------------
; Keyword string literals for comparison.
; ------------------------------------------------------------------
(pub :: kwFn String)
(pub fn (kwFn)
  "fn")

; `define` is a removed keyword: `fn` is the one way to declare a function.
(pub :: kwDefine String)
(pub fn (kwDefine)
  "define")

(pub :: kwEffect String)
(pub fn (kwEffect)
  "effect")

(pub :: kwData String)
(pub fn (kwData)
  "data")

(pub :: kwStruct String)
(pub fn (kwStruct)
  "struct")

(pub :: kwLet String)
(pub fn (kwLet)
  "let")

(pub :: kwIf String)
(pub fn (kwIf)
  "if")

(pub :: kwMatch String)
(pub fn (kwMatch)
  "match")

(pub :: kwImport String)
(pub fn (kwImport)
  "import")

(pub :: kwMacro String)
(pub fn (kwMacro)
  "macro")

(pub :: kwPub String)
(pub fn (kwPub)
  "pub")

(pub :: kwEq (-> String String Bool))
(pub fn (kwEq name lit)
  (strEq name lit))

; ------------------------------------------------------------------
; Top-level declaration parse: (keyword ...)
; ------------------------------------------------------------------
(pub :: parseDecl (-> Tokens Int (PResult (Option ASTNode))))
(pub fn (parseDecl tokens pos)
  (if (peekIs tokens pos TK_EOF)
    (pOk None pos)
    (if (peekIs tokens pos TK_RPAREN)
      (pErrCode pos "unmatched-paren")
      (if (peekIs tokens pos TK_LPAREN)
        (match (parseTopForm tokens (advance pos))
          ((ParseFailed error) (ParseFailed error))
          ((ParseSuccess declaration after) (pOk (Some declaration) after)))
        (pErrExp pos "(")))))

; Is the token at `pos` a second `pub`?
(pub :: pubFollows (-> Tokens Int Bool))
(pub fn (pubFollows tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    (kwEq (tokenLexeme (vecGet tokens pos)) kwPub)
    false))

(pub :: parseTopForm (-> Tokens Int (PResult ASTNode)))
(pub fn (parseTopForm tokens pos)
  (if (peekIs tokens pos TK_DOUBLE_COLON)
    (parseSigDecl tokens (advance pos))
    (if (peekIs tokens pos TK_IDENT)
      {
        (let kw (vecGet tokens pos))
        {
          (let name (tokenLexeme kw))
          (if (|| (kwEq name "union")
                (|| (kwEq name "foreign")
                  (|| (kwEq name "trait")
                    (|| (kwEq name "impl")
                      (|| (kwEq name "cond") (|| (kwEq name "emacro") (kwEq name kwDefine)))))))
            ; Reserved, not unknown. Falling through to the
            ; unknown-declaration refusal below would report a
            ; generic syntax error and lose the migration advice
            ; that is the entire reason these keywords are still
            ; reserved.
            ;
            ; `trait` and `impl` joined them on 2026-08-31. They are
            ; reserved rather than freed for the sharper of the two
            ; reasons in AX2004's explanation: an ordinary identifier
            ; named `impl` would make `(impl (Show Color) where ..)` a
            ; DECLARATION-MACRO INVOCATION, which is the fallthrough
            ; below, and the reader would be told that no macro named
            ; `impl` exists - a true sentence that names neither the
            ; construct they wrote nor what replaced it.
            (pErrRemoved pos name)
            (if (kwEq name kwPub)
              ; One `pub` per declaration. A second one used to be
              ; skipped here and kept by `fmt`'s own grammar, which
              ; refused the file with no code (tests/fuzz/MANIFEST).
              (if (pubFollows tokens (advance pos))
                (pErrExp (advance pos) "a declaration after `pub`")
                {
                  (let r (parseTopForm tokens (advance pos)))
                  (match r
                    ((ParseFailed parseError6) (ParseFailed parseError6))
                    ((ParseSuccess parsedValue6 parsedPos6)
                      {
                        (markPub parsedValue6)
                        r
                      }
                    ))
                })
              (if (kwEq name kwFn)
                (parseFnDecl tokens (advance pos))
                (if (kwEq name kwData)
                  (parseDataDecl tokens (advance pos))
                  (if (kwEq name kwStruct)
                    (parseStructDecl tokens (advance pos))
                    (if (kwEq name "cast")
                      (pErrRemoved pos "cast")
                      (if (kwEq name kwImport)
                        (parseImportDecl tokens (advance pos))
                        (if (kwEq name kwMacro)
                          (parseMacroDecl tokens (advance pos))
                          (if (kwEq name kwEffect)
                            (parseEffectDecl tokens (advance pos))
                            (if (kwEq name "type")
                              (parseAliasDecl tokens (advance pos) pos)
                              (if (kwEq name "subtype")
                                (parseSubtypeDecl tokens (advance pos) pos)
                                ; `syntax/for` in declaration position (MAC-CAP-5). The hook lives
                                ; HERE, ahead of the macrocall fallthrough, so one arm covers a
                                ; rule-form template (parseTplDecls delegates to this function), a
                                ; nested iteration's interior, the `pub` recursion above, and a
                                ; stray top-level occurrence - which phase D refuses rather than
                                ; resolving as a macro named syntax/for.
                                ; `extern` - the Rust FFI binding block (docs/ffi.md). The hook sits
                                ; here for the same reason `syntax/for` does: an identifier head
                                ; that reaches the fallthrough below becomes a declaration-macro
                                ; invocation, and the refusal then stops naming the construct.
                                ;
                                ; `trait` and `impl` had arms here too, immediately above these,
                                ; until 0.6.0. They are now caught by the reserved-word refusal at
                                ; the top of this function and never reach the chain.
                                ;
                                ; Cost, stated: a program that today defines a declaration MACRO
                                ; named `extern` changes meaning. None exists in this tree.
                                (if (kwEq name "extern")
                                  (parseExternDecl tokens (advance pos))
                                  (if (kwEq name "syntax/for")
                                    (parseDeclFor tokens pos)
                                    ; Any OTHER identifier head is a DECLARATION MACRO INVOCATION
                                    ; (TAG_D_MACROCALL), resolved - or refused with a diagnostic that
                                    ; names the head - by the expander's phase D. This is NOT the old
                                    ; skipUnknownDecl tolerance returning: that skip produced silence
                                    ; and this produces a node that phase D must account for, so a
                                    ; typo'd keyword now draws "neither a declaration nor a visible
                                    ; macro" where it used to draw a fatal bare "syntax error" that
                                    ; also hid every later diagnostic in the file (the old refusal
                                    ; stopped the parse at the first unknown head; probed 2026-08-14).
                                    ; Operator-charactered heads (`+` is a lexical identifier here)
                                    ; take this path too and refuse in phase D, since none can name a
                                    ; macro a declaration position accepts.
                                    (parseMacroCall tokens pos))))))))))))))
        }
      }
      (pErr pos))))

; An iteration's BINDING FORM, parsed as one expression: `(x xs)` is
; the application APP(VAR x, xs), and the parallel form
; `((x xs) (y ys))` is an application whose head is that application,
; which is exactly the shape `syntax/fold`'s binding form has always
; had (MAC-CAP-5). Storing the whole form means one grammar for both
; arities, and the expander's `expIterPairs` normalises it in one
; place for `for` and `fold` alike.
;
; The FIRST binder is the spine head, in both forms - `spineHead`
; walks nodeA, and nodeA of `((x xs) (y ys))` is `(x xs)`. It is kept
; in the node's name slot because a diagnostic wants a name to quote,
; not because the expander reads it.
(pub :: parseIterBinder (-> ASTNode String))
(pub fn (parseIterBinder e)
  (if (== (nodeTag e) TAG_E_VAR)
    (nodeAName e)
    (if (== (nodeTag e) TAG_E_APP)
      (parseIterBinder (nodeAChild e))
      "")))

; Parse `syntax/for BINDS DECL...` with the form's `(` already
; consumed and `pos` at the `syntax/for` token; consumes the closing
; paren. The declarations are parsed by the REAL declaration parsers -
; the same delegation the rule-form template uses - so a nested
; syntax/for parses through the parseTopForm hook above. At least one
; declaration is required.
(pub :: parseDeclFor (-> Tokens Int (PResult ASTNode)))
(pub fn (parseDeclFor tokens pos)
  {
    (let sp (tokenSpan (vecGet tokens pos)))
    (let p1 (advance pos))
    (if (peekIs tokens p1 TK_LPAREN)
      {
        (let bindR (parseExpr tokens p1))
        (match bindR
          ((ParseFailed parseError7) (ParseFailed parseError7))
          ((ParseSuccess parsedValue7 parsedPos7)
            {
              (let binds parsedValue7)
              (let afterSeq parsedPos7)
              {
                (let var (parseIterBinder binds))
                (if (strEq var "")
                  (pErrExp (advance p1) "identifier")
                  (parseDeclForBody tokens afterSeq var binds sp vecNew))
              }
            }
          ))
      }
      (pErrExp p1 "("))
  })

(pub :: parseDeclForBody (-> Tokens Int String ASTNode Int (Vec ASTNode) (PResult ASTNode)))
(pub fn (parseDeclForBody tokens pos var seq sp acc)
  (if (peekIs tokens pos TK_RPAREN)
    (if (== (vecLen acc) 0)
      (pErr pos)
      (pOk (nodeBuildDSynfor var seq acc sp) (advance pos)))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let r (parseTopForm tokens (advance pos)))
        (match r
          ((ParseFailed parseError8) (ParseFailed parseError8))
          ((ParseSuccess parsedValue8 parsedPos8)
            (parseDeclForBody tokens parsedPos8 var seq sp (vecPush acc parsedValue8))
          ))
      }
      (pErrExp pos "("))))

; A form this parser does not know - `type`, `trait` - is consumed and
; stands in the declaration list as an inert TAG_NIL node.
; It used to be skipped with bare `skipParens`, whose success value is
; 0 - and `parseDecls` reads value 0 as the clean end of the module, so
; one unknown declaration silently dropped every declaration after it,
; with no diagnostic and exit 0. Truncation that looks like success is
; the worst spelling of unsupported.
; Parse `(effect Name (op :: Type) ...)`, keeping the effect's name
; and its operations' names. Nothing else survives: stage1 emits no
; effect code, and a type it cannot lower is a type it need not
; record.
(pub :: parseEffectDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseEffectDecl tokens pos)
  ; `parseDeclName` for the same reason `data` uses it: an `effect`
  ; template may join its name.
  {
    (let nr (parseDeclName tokens pos))
    (match nr
      ((ParseFailed parseError9) (ParseFailed parseError9))
      ((ParseSuccess parsedValue9 parsedPos9)
        ; Two parallel vectors: `ops` keeps the bare NAME strings
        ; every existing reader indexes (codegen's evidence slots,
        ; the ambiguity table, AX3017's count), and `opFields` keeps
        ; TAG_FIELD nodes with the declared TYPES beside them, in
        ; the c slot nothing read before - `symbols` prints an
        ; operation's real arrow where the checker deliberately
        ; keeps a silent wildcard.
        {
          (let name parsedValue9)
          (let nameSpan (tokenSpan (vecGet tokens pos)))
          {
            (let ops vecNew)
            (let opFields vecNew)
            {
              (let r (parseEffectOps tokens parsedPos9 ops opFields))
              (match r
                ((ParseFailed parseError10) (ParseFailed parseError10))
                ((ParseSuccess parsedValue10 parsedPos10)
                  (pOk (nodeBuildDEffect name ops opFields nameSpan) parsedPos10)
                ))
            }
          }
        }
      ))
  })

; The type is parsed opportunistically and `skipParens` still owns
; the end position, so acceptance is unchanged; a type the parser
; cannot read leaves 0 in the field and only `symbols` is the poorer
; for it.
(pub :: parseEffectOps (-> Tokens Int Names Nodes (PResult ())))
(pub fn (parseEffectOps tokens pos ops opFields)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk () (advance pos))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let nr (parseIdentName tokens (advance pos)))
        (match nr
          ((ParseFailed parseError11) (ParseFailed parseError11))
          ((ParseSuccess parsedValue11 parsedPos11)
            {
              (let tyNode
                (if (peekIs tokens parsedPos11 TK_DOUBLE_COLON)
                  {
                    (let tr (parseType tokens (advance parsedPos11)))
                    (match tr
                      ((ParseFailed parseError12) nilNode)
                      ((ParseSuccess parsedValue12 parsedPos12) parsedValue12))
                  }
                  nilNode))
              {
                (vecPush ops parsedValue11)
                ; With the NAME's span, the way a trait's methods
                ; have carried one since they were parsed: an
                ; operation is a definition, so a duplicate of it
                ; has to be reportable at the line that declares
                ; it. `mkField` leaves span 0 and a spanless
                ; diagnostic is a suppressed one.
                (vecPush opFields
                  (nodeBuildFieldExtern parsedValue11 tyNode ""
                    (tokenSpan (vecGet tokens (advance pos)))))
                {
                  (let r (skipParens tokens parsedPos11 1))
                  (match r
                    ((ParseFailed parseError13) (ParseFailed parseError13))
                    ((ParseSuccess parsedValue13 parsedPos13)
                      (parseEffectOps tokens parsedPos13 ops opFields)
                    ))
                }
              }
            }
          ))
      }
      (pErr pos))))

; ------------------------------------------------------------------
; `(extern "lib" (name :: Type (symbol "s")) ...)`
;
; The item shape is deliberately byte-for-byte `parseEffectOps`':
; `(` ident, `::` and a type, then a clause tail `skipParens` owns.
; `(effect Console (log :: (-> String Int)))` is the only other
; declaration in the language whose body is A LIST OF TYPED CALLABLES,
; and an extern block is the same thing with a linker behind it
; instead of a handler.
;
; The BLOCK is the unit rather than the individual binding, for two
; reasons that are not style. MM-FFI-5's fourth requirement is a gate
; that ENUMERATES permitted external symbols, and the block is what it
; enumerates. And carrying the type INLINE avoids a measured trap: a
; detached `(:: name Type)` beside the binding would draw a false
; AX3015 on every single item, because `defIdxBuild` indexes only
; TAG_D_FN nodes with `nodeVis == 1`.
; ------------------------------------------------------------------
; A byte a library name may hold: `[A-Za-z0-9._+-]`, which is the set a
; `lib<name>.a` stem is drawn from and nothing wider.
;
; Deliberately NOT `isIdentChar`: that set admits `/` (so that
; `syntax/format` lexes) and the operator bytes, and a library name is
; not an Axiom identifier - it is an argv element and a linker input.
; `+` and `-` are in because real archives are named with them
; (`libc++abi`, `libgcc_s`); `/` is out because a name is a name and a
; directory is `--link-search`'s business.
(pub :: externLibByte (-> Int Bool))
(pub fn (externLibByte c)
  (if (&& (>= c 97) (<= c 122))
    true
    (if (&& (>= c 65) (<= c 90))
      true
      (if (&& (>= c 48) (<= c 57))
        true
        (if (== c 46)
          true
          (if (== c 95)
            true
            (if (== c 43)
              true
              (if (== c 45)
                true
                false))))))))

; The index of the first byte `externLibByte` refuses, or `None`.
;
; `Option` rather than -1: the caller reads the answer as
; `(strSlice lib bad 1)`, so a miss that reached the index would slice
; from a negative offset. The recursive scan preserves that typed result.
(pub :: externLibBadAt (-> String (Option Int)))
(pub fn (externLibBadAt s)
  (externLibBadAtFrom s 0))

(:: externLibBadAtFrom (-> String Int (Option Int)))
(fn (externLibBadAtFrom s i)
  (if (>= i (strLen s))
    None
    (if (externLibByte (strByte s i))
      (externLibBadAtFrom s (+ i 1))
      (Some i))))

(pub :: parseExternDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseExternDecl tokens pos)
  (if (peekIs tokens pos TK_STRING)
    ; The library name is validated HERE, at the front end, and not
    ; at the emitter that used to trust it. Two consumers read this
    ; one string - `emitExternDeclares` writes it into the module as
    ; a `;` comment, and the driver's `effectiveLinkArgs` hands it
    ; to the linker as `-l<name>` - so one constraint at the parse
    ; is worth two escapes downstream, and the emitter's comment is
    ; the only place a `-l` argv element can be recovered from.
    ; `strUnquoteLit` strips the quotes and leaves every interior
    ; byte alone, including a line break, which the lexer admits on
    ; purpose; see `ax3041Diag` for what that used to buy.
    {
      (let libTok (vecGet tokens pos))
      {
        (let lib (strUnquoteLit (tokenLexeme libTok)))
        (let names vecNew)
        (let items vecNew)
        (if (let (Some bad) (externLibBadAt lib))
          (pErrExternLib pos (strSlice lib bad 1))
          (if (== (strLen lib) 0)
            (pErrExternLib pos "")
            {
              (let r (parseExternItems tokens (advance pos) names items))
              (match r
                ((ParseFailed parseError14) (ParseFailed parseError14))
                ((ParseSuccess parsedValue14 parsedPos14)
                  (pOk (nodeBuildDExtern lib names items (tokenSpan libTok)) parsedPos14)
                ))
            }))
      }
    }
    (pErrExp pos "a library name in quotes")))

; One item per `(`; the closing paren of the BLOCK ends the list.
;
; STRICT since 2026-08-22. An item is `(name :: type clause*)`: the
; type is required - an extern item's type is the only description of
; the boundary the compiler has, and an untyped item used to become an
; any-arity wildcard that linked and returned garbage - and the only
; clause is `(symbol "...")`: a misspelled clause head, an unquoted
; symbol, or a clause the design document once proposed (`effects`,
; `opaque`, `drop`) used to be skipped without a word, and `(opaque
; Thing ...)` bound an item called `opaque`.
(pub :: parseExternItems (-> Tokens Int Names Nodes (PResult ())))
(pub fn (parseExternItems tokens pos names items)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk () (advance pos))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let nr (parseIdentName tokens (advance pos)))
        (match nr
          ((ParseFailed parseError15) (ParseFailed parseError15))
          ((ParseSuccess parsedValue15 parsedPos15)
            (if (peekIs tokens parsedPos15 TK_DOUBLE_COLON)
              {
                (let tr (parseType tokens (advance parsedPos15)))
                (match tr
                  ((ParseFailed parseError16) (ParseFailed parseError16))
                  ((ParseSuccess parsedValue16 parsedPos16)
                    {
                      (let cr (parseExternClauses tokens parsedPos16 parsedValue15))
                      (match cr
                        ((ParseFailed parseError17) (ParseFailed parseError17))
                        ((ParseSuccess parsedValue17 parsedPos17)
                          {
                            (vecPush names parsedValue15)
                            (vecPush items
                              (nodeBuildFieldExtern parsedValue15 parsedValue16 parsedValue17
                                (tokenSpan (vecGet tokens (advance pos)))))
                            (parseExternItems tokens parsedPos17 names items)
                          }
                        ))
                    }
                  ))
              }
              (pErrExp parsedPos15
                (concat (concat "`:: type` after extern item `" parsedValue15)
                  "` (an extern item declares its type: `(name :: (-> Int Int) (symbol \"c_name\"))`)")))
          ))
      }
      (pErrExp pos "an extern item `(name :: type (symbol \"...\"))`"))))

; The clauses after an item's type, up to and past the item's closing
; paren: `(symbol "s")` at most once, nothing else. Answers the linker
; symbol - the clause's, or the item's own name when the clause is
; absent (a documented footgun: a static link is one flat namespace,
; and two blocks binding a `parse` without the clause dedup to one
; `declare`; `axiom-bindgen` always writes it).
(pub :: parseExternClauses (-> Tokens Int String (PResult String)))
(pub fn (parseExternClauses tokens pos dflt)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk dflt (advance pos))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let p1 (advance pos))
        (if (peekIs tokens p1 TK_IDENT)
          (if (kwEq (tokenLexeme (vecGet tokens p1)) "symbol")
            {
              (let p2 (advance p1))
              (if (peekIs tokens p2 TK_STRING)
                {
                  (let p3 (advance p2))
                  (if (peekIs tokens p3 TK_RPAREN)
                    {
                      (let sym (strUnquoteLit (tokenLexeme (vecGet tokens p2))))
                      (let p4 (advance p3))
                      (if (peekIs tokens p4 TK_RPAREN)
                        (pOk sym (advance p4))
                        (pErrExp p4 "the item's closing paren after its `(symbol ...)` clause"))
                    }
                    (pErrExp p3 "`)` closing the `(symbol ...)` clause"))
                }
                (pErrExp p2 "a quoted linker symbol after `symbol`"))
            }
            (pErrExp p1
              (concat (concat "`symbol` (unknown extern clause `" (tokenLexeme (vecGet tokens p1)))
                "`; the clauses an extern item takes are: symbol)")))
          (pErrExp p1 "`symbol`, the one clause an extern item takes"))
      }
      (pErrExp pos "`(symbol \"...\")` or the item's closing paren"))))

; A string literal's lexeme keeps its quotes: `emitToken` slices from
; the opening quote inclusive (lexer.ax:143-145). A library or linker
; symbol name has no use for escapes, so this strips the quotes and
; nothing else - a backslash inside one survives and simply fails to
; resolve at link time, which is a better failure than a symbol that
; was silently rewritten.
(pub :: strUnquoteLit (-> String String))
(pub fn (strUnquoteLit s)
  (if (< (strLen s) 2)
    s
    (if (== (strByte s 0) 34)
      (strSlice s 1 (- (strLen s) 2))
      s)))

; `(type Name [tyvars] Type)`, uniform with every other declaration:
; no assignment operator stands between a name and what it names.
; The `=` spelling is refused here, and the formatter refuses it too:
; `(type Name Target)` is the one alias form every surface accepts.
; The name span, the tyvars, and the
; target's STRUCTURE all survive - `symbols` renders the target in
; the checker's notation. Any shape this does not recognise falls
; back to the old skip, so acceptance is unchanged: only
; well-formed aliases gain a node.
(pub :: parseAliasDecl (-> Tokens Int Int (PResult ASTNode)))
(pub fn (parseAliasDecl tokens pos origPos)
  ; `(` as well as an identifier, because the name may be a
  ; `(syntax/join ...)` inside a template. The old guard tested for an
  ; identifier only, so a joined alias name fell through to the
  ; skip-unknown fallback and read as `AX2003 syntax error`.
  (if (|| (peekIs tokens pos TK_IDENT) (peekIs tokens pos TK_LPAREN))
    ; `parseDeclName`, not `parseIdentName`: a `type` template may
    ; name its alias with `(syntax/join Ref T)`, exactly as a `data`
    ; template names its type. Outside a macro the marker reaches
    ; `expCheckDeclNames` and refuses there.
    {
      (let nr (parseDeclName tokens pos))
      (match nr
        ((ParseFailed parseError18) (pErr origPos))
        ((ParseSuccess parsedValue18 parsedPos18)
          ; NOT `collectTyParams`: its bare-run test is merely
          ; "does not start uppercase", so a stray `=` lexes as an
          ; ident here and would be swallowed as a tyvar. A tyvar
          ; must start with a lowercase LETTER.
          {
            (let name parsedValue18)
            (let nameSpan (tokenSpan (vecGet tokens pos)))
            (let tvs vecNew)
            {
              (let afterTvs (aliasTyvarsEnd tokens parsedPos18 tvs))
              (if (&& (peekIs tokens afterTvs TK_IDENT)
                    (strEq (tokenLexeme (vecGet tokens afterTvs)) "="))
                (pErr origPos)
                {
                  (let tr (parseType tokens afterTvs))
                  (match tr
                    ((ParseFailed parseError19) (pErr origPos))
                    ((ParseSuccess parsedValue19 parsedPos19)
                      (if (peekIs tokens parsedPos19 TK_RPAREN)
                        (pOk (nodeBuildDAlias name parsedValue19 tvs nameSpan)
                          (advance parsedPos19))
                        (pErr origPos))
                    ))
                })
            }
          }
        ))
    }
    (pErr origPos)))

; ------------------------------------------------------------------
; `(subtype Name is Base range LO..HI)` — Ada-style range-constrained
; subtype. `Name` goes through `parseDeclName` so a macro template may
; join it, exactly as `type`/`data` do. `is` and `range` are ordinary
; IDENTs. `Base` is a TYPE via `parseType`; bounds are EXPRESSIONs via
; `parseExpr` (usually Int literals). `..` lexes as two TK_DOT — the
; lexer has no DOTDOT — so the upper bound is present exactly when two
; consecutive DOTs follow the lower bound. A single bound means
; lower-only (`>= lo`); two bounds mean closed-below, open-above
; (`>= lo` and `< hi`). The bounds live as a Vec of expr nodes in the
; declaration's c slot.
; ------------------------------------------------------------------
(pub :: parseSubtypeDecl (-> Tokens Int Int (PResult ASTNode)))
(pub fn (parseSubtypeDecl tokens pos origPos)
  {
    (let nr (parseDeclName tokens pos))
    (match nr
      ((ParseFailed parseError20) (pErr origPos))
      ((ParseSuccess parsedValue20 parsedPos20)
        {
          (let name parsedValue20)
          (let p1 parsedPos20)
          (if (&& (peekIs tokens p1 TK_IDENT) (strEq (tokenLexeme (vecGet tokens p1)) "is"))
            {
              (let tr (parseType tokens (advance p1)))
              (match tr
                ((ParseFailed parseError21) (pErr origPos))
                ((ParseSuccess parsedValue21 parsedPos21)
                  {
                    (let base parsedValue21)
                    (let p2 parsedPos21)
                    (if (&& (peekIs tokens p2 TK_IDENT)
                          (strEq (tokenLexeme (vecGet tokens p2)) "range"))
                      {
                        (let lr (parseExpr tokens (advance p2)))
                        (match lr
                          ((ParseFailed parseError22) (pErr origPos))
                          ((ParseSuccess parsedValue22 parsedPos22)
                            {
                              (let lower parsedValue22)
                              (let p3 parsedPos22)
                              (if (&& (peekIs tokens p3 TK_DOT) (peekIs tokens (advance p3) TK_DOT))
                                {
                                  (let ur (parseExpr tokens (advance (advance p3))))
                                  (match ur
                                    ((ParseFailed parseError23) (pErr origPos))
                                    ((ParseSuccess parsedValue23 parsedPos23)
                                      (if (peekIs tokens parsedPos23 TK_RPAREN)
                                        {
                                          (let bounds vecNew)
                                          {
                                            (vecPush bounds lower)
                                            (vecPush bounds parsedValue23)
                                            (pOk
                                              (mkDSubtypeAt name base bounds
                                                (tokenSpan (vecGet tokens pos)))
                                              (advance parsedPos23))
                                          }
                                        }
                                        (pErr origPos))
                                    ))
                                }
                                (if (peekIs tokens p3 TK_RPAREN)
                                  {
                                    (let bounds vecNew)
                                    {
                                      (vecPush bounds lower)
                                      (pOk
                                        (mkDSubtypeAt name base bounds
                                          (tokenSpan (vecGet tokens pos)))
                                        (advance p3))
                                    }
                                  }
                                  (pErr origPos)))
                            }
                          ))
                      }
                      (pErr origPos))
                  }
                ))
            }
            (pErr origPos))
        }
      ))
  })

; Type parameters between an alias's name and its target: a paren
; list, or a bare run of idents that start with a lowercase LETTER.
(pub :: aliasTyvarsEnd (-> Tokens Int Strings Int))
(pub fn (aliasTyvarsEnd tokens pos tvs)
  (if (peekIs tokens pos TK_LPAREN)
    (collectTyParams tokens pos tvs)
    (if (&& (peekIs tokens pos TK_IDENT)
          (&& (! (peekIs tokens (advance pos) TK_RPAREN))
            (&& (! (peekIs tokens (advance pos) TK_DOT))
              (&& (! (peekIs tokens (advance pos) TK_DOUBLE_COLON))
                {
                  (let b (strByte (tokenLexeme (vecGet tokens pos)) 0))
                  (&& (>= b 97) (<= b 122))
                }))))
      {
        (vecPush tvs (tokenLexeme (vecGet tokens pos)))
        (aliasTyvarsEnd tokens (advance pos) tvs)
      }
      pos)))

; ------------------------------------------------------------------
; Type expressions, kept structurally. The grammar mirrors stage0's
; parse_type exactly, because the checker's rendered types must match
; stage0's byte-for-byte:
;
;   ATOM  := '*' ATOM | 'linear' ATOM | KEYWORD | lowercase-IDENT
;          | IDENT | '(' TYPE... ')'
;   TYPE  := '(' '->' ATOM+ ')'         right-folded, binary, curried
;          | '(' ')'                    unit, an empty tuple
;          | '(' Upper-nonkeyword ATOM* ')'   type application
;          | '(' ATOM+ ')'              tuple; one element unwraps
;          | ATOM
;
; The keyword distinction is load-bearing: stage0 lexes `Int` as its
; own token kind, so `(Int Bool)` is a TUPLE while `(Foo Bar)` is an
; application - probed via `axiom symbols` rendering `(Int, Bool)`.
; stage1 lexes both as plain idents, so the keyword set is spelled out
; here. Every name in it canonicalises to itself.
; ------------------------------------------------------------------
; Double, F32, F64 and the sized integers (I8..I128, U8..U128, Isize,
; Usize) were in this table until 2026-08-14, and every one was a name
; with no representational effect: the sized types all lowered to a
; full-width i64 with no truncation, no extension and no width-specific
; arithmetic while being INCOMPATIBLE with Int, and the float spellings
; were worse - the checker's tyIsFloatTy called them floats while the
; emitter keyed float arithmetic on the name `Float` alone, so `Double`
; arithmetic emitted integer `add` on double bit patterns, silently
; (docs/memory-model.md MM-VAL-3c, MM-VAL-4b: "a conforming
; implementation MUST either give them widths or remove them"). They
; are removed: each now parses as an ordinary unknown type constructor
; and draws AX3002 where a signature names it. Their corpus population
; was zero. `I64` is gone from here too - the checker still constructs
; it internally as the `set` form's type (mkI64Ty), which is a leaked
; internal, not a surface type a program may claim.
; A C or Rust primitive type name written in TYPE position, and the
; Axiom type that was meant - or "" when the name is an ordinary type
; variable.
;
; WHY THIS IS NOT THE `Double` CASE ABOVE. `Double` and `I64` were
; removed and now draw `AX3002` where a signature names them, which
; works because they are CAPITALISED: an unknown uppercase name is an
; unknown type CONSTRUCTOR and the checker refuses it. A lowercase name
; in type position is a type VARIABLE, and there is no such thing as an
; unknown one - so `(:: f (-> u64 Int))` does not fail, it succeeds as
; `forall a. a -> Int`, and then accepts a String. Measured on 0.3.1:
; `check` says OK and the program runs.
;
; WHY A NAMED SET AND NOT A RULE. The tempting general rule - refuse a
; MULTI-LETTER type variable - is too wide. It refuses
; `(-> (Vec elem) (-> elem out) (Vec out))`, a correct and readable
; program, and a check whose suggested fix makes the program less
; correct is the wrong check (the AX3005 backstop, 2026-08-17).
;
; The corpus licenses the set rather than the rule. Across the
; compiler's 2,859 AXSYM rows and the standard library's 597, the whole
; type-variable vocabulary is six SINGLE LETTERS - `a` 71, `e` 16,
; `b` 14, `c` 5, `f` 2, `d` 1. Not one multi-character type variable
; exists, so no spelling below can be taking a name this tree uses.
;
; VALUE POSITION IS UNTOUCHED, and that is why this is asked here and
; not in the lexer: `byte`, `from`, `str` and `char` are ordinary
; identifiers, and the corpus uses several as parameter names -
; `(strFindByte s byte from)` is three of them in one signature.
(pub :: sizedTyMeant (-> String String))
(pub fn (sizedTyMeant n)
  (if (strEq n "i8")
    "Int8"
    (if (strEq n "i16")
      "Int16"
      (if (strEq n "i32")
        "Int32"
        (if (strEq n "u8")
          "UInt8"
          (if (strEq n "u16")
            "UInt16"
            (if (strEq n "u32")
              "UInt32"
              (if (strEq n "u64")
                "UInt64"
                (if (sizedTyIn n "i64 i128 isize u128 usize size_t int uint long short")
                  "Int"
                  (if (sizedTyIn n "f32 f64 float double")
                    "Float"
                    (if (strEq n "bool")
                      "Bool"
                      (if (strEq n "char")
                        "Char"
                        (if (sizedTyIn n "str string")
                          "String"
                          (if (strEq n "void")
                            "()"
                            ""))))))))))))))

; Is `n` one of the space-separated words in `words`?
;
; A word list rather than a chain of `(|| (strEq ...) ...)`, because the
; chain for seventeen spellings is seventeen nested `||`s and its
; closing run is seventeen parens deep - which is a shape this
; repository has already paid for twice. The list is also the thing a
; reader wants to see.
;
; The walk compares word by word against the source string rather than
; splitting it, so it allocates nothing per call and runs at parse time
; over every type atom.
;
(pub :: sizedTyIn (-> String String Bool))
(pub fn (sizedTyIn n words)
  (sizedTyInFrom n words 0))

(pub :: sizedTyInFrom (-> String String Int Bool))
(pub fn (sizedTyInFrom n words i)
  (if (> i (- (strLen words) (strLen n)))
    false
    (if (sizedTyWordAt n words i)
      true
      (sizedTyInFrom n words (sizedTyNextWord words (+ i 1))))))

; Does `words` hold `n` as a whole word starting at `i`?
(pub :: sizedTyWordAt (-> String String Int Bool))
(pub fn (sizedTyWordAt n words i)
  ; `strSlice` takes a START and a COUNT, not two indices - and passing
  ; `i + len` as the count matched only at i = 0, so the walk silently
  ; found nothing for every word after the first.
  (if (== (strCmp (strSlice words i (strLen n)) n) 0)
    (if (== (+ i (strLen n)) (strLen words))
      true
      (== (strByte words (+ i (strLen n))) 32))
    false))

; The index just past the next space at or after `i`, or `strLen words`.
(pub :: sizedTyNextWord (-> String Int Int))
(pub fn (sizedTyNextWord words i)
  (if (let (Some sp) (strFindByte words 32 i))
    (+ sp 1)
    (strLen words)))

; Integer descriptors are precision plus signedness, independent of their
; canonical i64 storage word: 8/16/32/64 signed, 72/80/96/128 unsigned.
(pub :: integerTypeCode (-> String Int))
(pub fn (integerTypeCode n)
  (if (strEq n "Int")
    64
    (if (strEq n "Int8")
      8
      (if (strEq n "Int16")
        16
        (if (strEq n "Int32")
          32
          (if (strEq n "UInt8")
            72
            (if (strEq n "UInt16")
              80
              (if (strEq n "UInt32")
                96
                (if (strEq n "UInt64")
                  128
                  0)))))))))

; A representation view used by generated numeric renderers. The dot
; keeps it out of source identifiers; each registered variant has an exact
; integer parameter type and returns its unchanged canonical storage word.
(pub :: isIntegerWordName (-> String Bool))
(pub fn (isIntegerWordName n)
  (&& (strStartsWith n "__integer.word.")
    (> (integerTypeCode (strSlice n 15 (- (strLen n) 15))) 0)))

; `(Link T W)`, an index into a `(Vec T)` (docs/memory-model.md
; MM-VAL-10b): the integer code of `W` when it is one of the three
; widths a link takes, and 0 for anything else, including a width
; that is still a type variable. A struct field whose link has a width
; stores it in that many bytes; every other link is a word.
(pub :: linkWidthCode (-> ASTNode Int))
(pub fn (linkWidthCode ty)
  (if (nodeSame ty nilNode)
    0
    (if (|| (!= (nodeTag ty) TAG_T_CON) (! (strEq (nodeAName ty) "Link")))
      0
      (if (!= (vecLen (nodeBChildren ty)) 2)
        0
        {
          (let w (vecGet (nodeBChildren ty) 1))
          (if (&& (== (nodeTag w) TAG_T_CON) (sizedTyIn (nodeAName w) "UInt8 UInt16 UInt32"))
            (integerTypeCode (nodeAName w))
            0)
        }))))

(pub :: integerBits (-> Int Int))
(pub fn (integerBits code)
  (if (> code 64)
    (- code 64)
    code))

(pub :: integerUnsigned (-> Int Bool))
(pub fn (integerUnsigned code)
  (> code 64))

; Word 3 is unused on variable nodes. A checked operator carries its
; integer descriptor here; a numeric conversion carries source * 256 +
; target. Application payload words remain children for generic walkers.
(pub :: nodeIntegerCode (-> ASTNode Int))
(pub fn (nodeIntegerCode e)
  (if (nodeSame e nilNode)
    0
    {
      (let head (spineHead e))
      (if (== (nodeTag head) TAG_E_VAR)
        (nodeC head)
        0)
    }))

(pub :: nodeIntegerOp (-> ASTNode Int))
(pub fn (nodeIntegerOp e)
  {
    (let code (nodeIntegerCode e))
    (if (<= code 128)
      code
      0)
  })

(pub :: nodeIntegerConversion (-> ASTNode Int))
(pub fn (nodeIntegerConversion e)
  {
    (let code (nodeIntegerCode e))
    (if (> code 256)
      code
      0)
  })

(pub :: typeKeywordKnown (-> String Bool))
; Recognition preserves the spelling; it never constructs or canonicalises a name.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub fn (typeKeywordKnown n)
  (if (> (integerTypeCode n) 0)
    true
    (if (strEq n "Float")
      true
      (if (strEq n "Bool")
        true
        (if (strEq n "Char")
          true
          (if (strEq n "String")
            true
            ; `Foreign` - an opaque foreign pointer (docs/ffi.md, MM-FFI-5
            ; requirement 1: "foreign memory be a DISTINCT TYPE from Int").
            ; A builtin rather than a declared type because the two readers that
            ; must agree about it are the checker and the EMITTER, and a
            ; user-declarable name could be shadowed by a `data Foreign` that
            ; the emitter would then treat as a counted block.
            (if (strEq n "Foreign")
              true
              ; `Handle` - an Axiom block of the FOREIGN FORM holding a Rust
              ; value and its destructor (docs/ffi.md): a counted REFERENCE,
              ; unlike `Foreign`, so the Rust value dies when its last Axiom
              ; holder does. A builtin for the reason `Foreign` is.
              (if (strEq n "Handle")
                true
                ; `Spawn` - what a spawn primitive answers and a
                ; join takes (docs/memory-model.md MM-PAR-8): one
                ; machine word, a slot in the runtime's handle
                ; table, never shared between bindings. A builtin
                ; for `Foreign`'s reason: the checker, which
                ; types the primitives, and the emitter, which
                ; must never count one, have to agree about it.
                (if (strEq n "Spawn")
                  true
                  false)))))))))

(pub :: lexStartsLower (-> String Int))
(pub fn (lexStartsLower s)
  (if (== (strLen s) 0)
    0
    (if (&& (>= (strByte s 0) 97) (<= (strByte s 0) 122))
      1
      0)))

; At the `::`. Every further `::ident` extends the path; the LAST
; segment is the name and the rest are the module. The type-side twin
; of `parseQualifiedTail`: it answers the mangled spelling rather
; than a node, so the bare atom below and the application head in
; `parseTypeParens` share it.
(pub :: parseTyQualChain (-> Tokens Int Strings (PResult String)))
(pub fn (parseTyQualChain tokens pos chain)
  (if (peekIs tokens pos TK_DOUBLE_COLON)
    (if (peekIs tokens (advance pos) TK_IDENT)
      {
        (vecPush chain (tokenLexeme (vecGet tokens (advance pos))))
        (parseTyQualChain tokens (advance (advance pos)) chain)
      }
      (pErr pos))
    (pOk (mangledFromChain chain) pos)))

; `Mod::Name`, and `Mod.Sub::Name`, where a TYPE stands. Only called
; when the `::` is already confirmed ahead, so the tail always
; consumes it; a missing name after the colons is a parse error, the
; same answer the expression side gives.
(pub :: parseQualifiedTyAtom (-> Tokens Int (PResult ASTNode)))
(pub fn (parseQualifiedTyAtom tokens pos)
  {
    (let chain
      {
        (let v vecNew)
        {
          (vecPush v (tokenLexeme (vecGet tokens pos)))
          v
        }
      })
    {
      (let afterDots (parseDottedChain tokens (advance pos) chain))
      {
        (let qr (parseTyQualChain tokens afterDots chain))
        (match qr
          ((ParseFailed parseError24) (ParseFailed parseError24))
          ((ParseSuccess parsedValue24 parsedPos24)
            (pOk (mkTCon parsedValue24 vecNew) parsedPos24)
          ))
      }
    }
  })

(pub :: parseTypeAtom (-> Tokens Int (PResult ASTNode)))
(pub fn (parseTypeAtom tokens pos)
  ; `[T]` is REFUSED, not parsed. The list type checked in signatures
  ; while no literal, no pattern and no runtime representation existed
  ; behind it: a reader met the syntax in the reference, wrote it, and
  ; got a parse error. Sequences are `(Vec T)`, so the brackets carry
  ; the explanation rather than a shape. `()` is untouched - it is the
  ; empty tuple below, and unit is widely used.
  (if (peekIs tokens pos TK_LBRACKET)
    (pErrRemoved pos "list")
    (if (peekIs tokens pos TK_IDENT)
      ; `* T` and `linear T` prefix the NEXT atom. `*Int` without the
      ; space lexes as one identifier here (stage1's `*` is an ident
      ; character) and lands in the TCon fallback - a recorded lexer
      ; gap; spell pointers `(* T)`.
      ; `Mod::Name`, and `Mod.Sub::Name`: a qualified reference where
      ; a type stands takes this branch, not the bare dispatch below.
      ; The dotted lookahead spends nothing observable when the colons
      ; do not follow - it walks a throwaway vector - so every other
      ; spelling reaches that dispatch exactly as before.
      (if (peekIs tokens (parseDottedChain tokens (advance pos) vecNew) TK_DOUBLE_COLON)
        (parseQualifiedTyAtom tokens pos)
        {
          (let s (tokenLexeme (vecGet tokens pos)))
          (if (strEq s "*")
            {
              (let r (parseTypeAtom tokens (advance pos)))
              (match r
                ((ParseFailed parseError25) (ParseFailed parseError25))
                ((ParseSuccess parsedValue25 parsedPos25) (pOk (mkTPtr parsedValue25) parsedPos25)))
            }
            ; `linear` is RESERVED, not parsed. It used to build the
            ; nominal type constructor `Linear T`, which was a real
            ; barrier - `AX3004` against `T` - and enforced nothing else:
            ; no use was counted, and a value could be consumed twice or
            ; never. A marker that reads as an ownership guarantee and
            ; supplies none is worse than no marker, because a reader
            ; spends trust on it; that is the same ground `deriving` was
            ; refused on. The keyword stays reserved so old source gets
            ; the explanation rather than an `AX3002` about an unknown
            ; type named `linear`.
            (if (strEq s "linear")
              (pErrRemoved pos "linear")
              {
                (let known (typeKeywordKnown s))
                (if known
                  (pOk (mkTCon s vecNew) (advance pos))
                  (if (== (lexStartsLower s) 1)
                    ; A lowercase name in type position is a type
                    ; VARIABLE, and there is no such thing as an unknown
                    ; one - so a C or Rust primitive spelling does not
                    ; fail here, it succeeds as `forall n. ...` and then
                    ; accepts anything. AX3047 is the refusal; see
                    ; `sizedTyMeant` for why the set is named rather than
                    ; derived from a rule about length.
                    (if (== (strLen (sizedTyMeant s)) 0)
                      (pOk (mkTVar s) (advance pos))
                      (pErrSizedTy pos s))
                    (pOk (mkTCon s vecNew) (advance pos))))
              }))
        })
      (if (peekIs tokens pos TK_LPAREN)
        (parseTypeParens tokens (advance pos))
        (pErrExp pos "type")))))

(pub :: parseType (-> Tokens Int (PResult ASTNode)))
(pub fn (parseType tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
    (parseTypeParens tokens (advance pos))
    (parseTypeAtom tokens pos)))

; A run of atoms up to the closing paren, which is consumed.
(pub :: parseTypeAtoms (-> Tokens Int Nodes (PResult Nodes)))
(pub fn (parseTypeAtoms tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_EOF)
      (pErrExp pos "type")
      {
        (let r (parseTypeAtom tokens pos))
        (match r
          ((ParseFailed parseError26) (ParseFailed parseError26))
          ((ParseSuccess parsedValue26 parsedPos26)
            (parseTypeAtoms tokens parsedPos26 (vecPush acc parsedValue26))
          ))
      })))

; `pos` is just past the opening paren.
(pub :: parseTypeParens (-> Tokens Int (PResult ASTNode)))
(pub fn (parseTypeParens tokens pos)
  (if (peekIs tokens pos TK_RARROW)
    {
      (let r (parseTypeAtoms tokens (advance pos) vecNew))
      (match r
        ((ParseFailed parseError27) (ParseFailed parseError27))
        ((ParseSuccess parsedValue27 parsedPos27)
          {
            (let tys parsedValue27)
            (if (< (vecLen tys) 2)
              (pErrExp pos "type")
              (pOk (foldArrows tys (- (vecLen tys) 2) (vecGet tys (- (vecLen tys) 1))) parsedPos27))
          }
        ))
    }
    (if (peekIs tokens pos TK_RPAREN)
      (pOk (mkTTup vecNew) (advance pos))
      (if (&& (peekIs tokens pos TK_IDENT) (strEq (tokenLexeme (vecGet tokens pos)) "syntax/join"))
        ; `(syntax/join a b)` where a TYPE stands: the same marker string
        ; a declaration NAME position writes, carried as a constructor
        ; with no arguments, so `expSubstTy`'s existing name resolution
        ; decodes it. A `type` template names an alias with a join and
        ; the signature beside it has to be able to write that name;
        ; without this the form fell into the tuple branch below - the
        ; head is lowercase, so it is not a type application - and a
        ; generated signature took a THREE-TUPLE where its alias should
        ; have been, reported as `expected Int, found (_t321, {unknown},
        ; {unknown})` at the call site.
        {
          (let mr (parseDeclName tokens (- pos 1)))
          (match mr
            ((ParseFailed parseError28) (ParseFailed parseError28))
            ((ParseSuccess parsedValue28 parsedPos28)
              (pOk (mkTCon parsedValue28 vecNew) parsedPos28)
            ))
        }
        (if (&& (peekIs tokens pos TK_IDENT)
              (|| (peekIs tokens (parseDottedChain tokens (advance pos) vecNew) TK_DOUBLE_COLON)
                (&& (identStartsUpper tokens pos)
                  (! (typeKeywordKnown (tokenLexeme (vecGet tokens pos)))))))
          ; Type application: (Maybe Int), (Vec Float). A keyword head -
          ; (Int Bool) - is NOT an application; it falls through to the
          ; tuple loop, stage0's rule. A qualified head - (Mod::T U) -
          ; mangles the same way a bare atom does, then takes its
          ; arguments through the same path.
          {
            (let head (tokenLexeme (vecGet tokens pos)))
            {
              (let chain
                {
                  (let v vecNew)
                  {
                    (vecPush v head)
                    v
                  }
                })
              {
                (let hq
                  (if (peekIs tokens (parseDottedChain tokens (advance pos) vecNew) TK_DOUBLE_COLON)
                    {
                      (let qr
                        (parseTyQualChain tokens (parseDottedChain tokens (advance pos) chain)
                          chain))
                      (match qr
                        ((ParseFailed parseError29) (ParseFailed parseError29))
                        ((ParseSuccess parsedValue29 parsedPos29) (pOk parsedValue29 parsedPos29)))
                    }
                    (pOk head (advance pos))))
                (match hq
                  ((ParseFailed parseError30) (ParseFailed parseError30))
                  ((ParseSuccess parsedValue30 parsedPos30)
                    {
                      (let r (parseTypeAtoms tokens parsedPos30 vecNew))
                      (match r
                        ((ParseFailed parseError31) (ParseFailed parseError31))
                        ((ParseSuccess parsedValue31 parsedPos31)
                          (pOk (mkTCon parsedValue30 parsedValue31) parsedPos31)
                        ))
                    }
                  ))
              }
            }
          }
          {
            (let r (parseTypeAtoms tokens pos vecNew))
            (match r
              ((ParseFailed parseError32) (ParseFailed parseError32))
              ((ParseSuccess parsedValue32 parsedPos32)
                ; One parenthesised type is grouping. Products use `struct`
                ; and sums use `data`; tuple types have no value syntax.
                {
                  (let tys parsedValue32)
                  (if (== (vecLen tys) 1)
                    (pOk (vecGet tys 0) parsedPos32)
                    (pErrRemoved pos "tuple"))
                }
              ))
          })))))

; `(-> A B C)` folds right: A -> (B -> C). `i` walks from the second-
; to-last element down to 0, wrapping `acc` each step.
(pub :: foldArrows (-> Nodes Int ASTNode ASTNode))
(pub fn (foldArrows tys i acc)
  (if (< i 0)
    acc
    (foldArrows tys (- i 1) (mkTArr (vecGet tys i) acc))))

; ------------------------------------------------------------------
; Parse (:: name (-> ...))
; ------------------------------------------------------------------
(pub :: parseSigDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseSigDecl tokens pos)
  {
    (let nr (parseDeclName tokens pos))
    (match nr
      ((ParseFailed parseError33) (ParseFailed parseError33))
      ((ParseSuccess parsedValue33 parsedPos33)
        ; The emitter needs one bit per arrow position - is it `Float`
        ; - because float-ness of a value is not observable at
        ; runtime: every value is an i64 word, and by emission time
        ; there is no type checker left to ask. This is the same
        ; reconstruction stage0's IR generator performs. The FULL type
        ; structure survives beside it, in the ty slot, for the
        ; checker; the float flags stay in `b` untouched, because
        ; codegen keys on that exact shape.
        ;
        ; A TYPE THIS PARSER CANNOT READ IS A PARSE ERROR, which is
        ; stage0's shape: `parse_sig` was `expect(::)`, `parse_ident`,
        ; `parse_type()?` - the `?` propagating - and its caller then
        ; ran `expect(RParen)` on what was left. Both halves are here.
        ;
        ; It used to be neither. `skipParens` owned the end position
        ; and the type was parsed opportunistically, so a failure left
        ; 0 in the ty slot, which the checker reads as a silent
        ; wildcard - "under-reported, never mis-typed", said the note
        ; that used to be here. The first half was true and the second
        ; was not, in two directions:
        ;
        ;   (:: f (-> Int))     a nullary arrow. stage0 refused it
        ;                       ("-> requires at least two types") and
        ;                       so does `parseTypeParens`; the refusal
        ;                       was then discarded here, so `f` simply
        ;                       had no signature and nothing said so.
        ;                       Every gate missed it. `check-fmt.sh`
        ;                       caught the one instance that reached
        ;                       the tree, as a formatter refusal on
        ;                       `main.ax`, which is a strange way to
        ;                       hear that a type was ignored.
        ;
        ;   (:: h Int Bool)     the run-of-atoms spelling of an arrow.
        ;                       `parseType` reads `Int`, `skipParens`
        ;                       skips to the declaration's `)`, and
        ;                       `Bool` is gone - so `h` is TYPED, and
        ;                       typed wrongly. The only report was an
        ;                       AX3004 at the call site blaming the
        ;                       caller ("expected function type, found
        ;                       Int") for a defect in the signature.
        ;
        ; The tree-sitter grammar has always agreed with stage0 here -
        ; `type_signature` is `'(' [pub] '::' subject type ')'`, and
        ; both shapes above are ERROR nodes under it - and so has the
        ; formatter, which refuses to rewrite either. This parser was
        ; the one implementation of the three that accepted them.
        {
          (let name parsedValue33)
          (let typePos parsedPos33)
          {
            (let tr (parseType tokens typePos))
            (match tr
              ((ParseFailed parseError34) (ParseFailed parseError34))
              ((ParseSuccess parsedValue34 parsedPos34)
                (if (peekIs tokens parsedPos34 TK_RPAREN)
                  (pOk
                    (setNodeTyChild
                      (mkDSigAt name (sigFloatFlags tokens typePos) (tokenSpan (vecGet tokens pos)))
                      parsedValue34)
                    (advance parsedPos34))
                  ; stage0's `expect(RParen)` renders its expectation as
                  ; `)`, so this is its message verbatim: `expected ),
                  ; found \`Bool\``.
                  (pErrExp parsedPos34 ")"))
              ))
          }
        }
      ))
  })

; One flag per arrow position, return type last: `(-> Float Int Float)`
; is [1, 0, 1], and a bare type - `(:: pi Float)` - is a one-entry
; spine. A parenthesised position (a nested arrow, a type application
; like `(Vec Float)`) is a closure or a pointer, carried as a word,
; never a bare float.
(pub :: sigFloatFlags (-> Tokens Int Ints))
(pub fn (sigFloatFlags tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let v vecNew)
      {
        (vecPush v (identIsFloat tokens pos))
        v
      }
    }
    (if (&& (peekIs tokens pos TK_LPAREN) (peekIs tokens (advance pos) TK_RARROW))
      (spineFlags tokens (advance (advance pos)) vecNew)
      {
        (let v vecNew)
        {
          (vecPush v 0)
          v
        }
      })))

(pub :: identIsFloat (-> Tokens Int Int))
(pub fn (identIsFloat tokens pos)
  (if (strEq (tokenLexeme (vecGet tokens pos)) "Float")
    1
    0))

(pub :: spineFlags (-> Tokens Int Ints Ints))
(pub fn (spineFlags tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    acc
    (if (peekIs tokens pos TK_IDENT)
      {
        (vecPush acc (identIsFloat tokens pos))
        (spineFlags tokens (advance pos) acc)
      }
      (if (peekIs tokens pos TK_LPAREN)
        {
          (let r (skipParens tokens (advance pos) 1))
          (match r
            ((ParseFailed parseError35) acc)
            ((ParseSuccess parsedValue35 parsedPos35)
              {
                (vecPush acc 0)
                (spineFlags tokens parsedPos35 acc)
              }
            ))
        }
        acc))))

; ------------------------------------------------------------------
; Parse a dotted module path: Ident ('.' Ident)*
;
; The dotted form is preserved verbatim in the returned Str (`Sys.Platform`
; stays `Sys.Platform`); translating it to a file path is the resolver's
; job, not the parser's.
;
; A SEGMENT MAY NOT CONTAIN `/`, and that is AX2006. `/` is byte 47 and
; `isIdentStart`/`isIdentChar` admit it, because the compiler's own
; `syntax/format` and `syntax/join` are ordinary identifiers with a
; slash in them - so `/tmp/x/secret` lexes as ONE identifier and used to
; reach `modPathToFile`, which rewrites `.` to `/` and leaves an
; existing `/` alone, and then `searchDirsFor`, which forms its
; candidate with a bare `concat` that an already-absolute name simply
; re-anchors. Measured 2026-08-23: with `/tmp/axtrav/secret.ax` written
; outside the project and `(import /tmp/axtrav/secret)` in the entry
; file, `axiom check` printed `OK` and compiled that file's
; declarations into the program. An import is not a filesystem path.
;
; Refused HERE rather than in the resolver because the resolver is
; reached by two spellings of the same string and the parser by one:
; this is also what stops `(import ../../etc/x)` and a name whose only
; slash is trailing, neither of which a search-directory prefix can
; confine once the concatenation has happened. `syntax/format` and its
; siblings are unaffected - they stand in EXPRESSION position and never
; reach a module path - and `tests/selfhost/380-syntax-scalar-queries.ax`
; is the fixture that says so.
; `tests/diagnostics/955-import-absolute-path.axbad` pins the refusal.
; ------------------------------------------------------------------
(pub :: parseModPath (-> Tokens Int (PResult String)))
(pub fn (parseModPath tokens pos)
  {
    (let nr (parseIdentName tokens pos))
    (match nr
      ((ParseFailed parseError36) (ParseFailed parseError36))
      ((ParseSuccess parsedValue36 parsedPos36)
        (if (if (let (Some _) (strFindByte parsedValue36 47 0))
          true
          false)
          (pErrModSeg pos parsedValue36)
          (parseModPathRest tokens parsedPos36 parsedValue36))
      ))
  })

(pub :: parseModPathRest (-> Tokens Int String (PResult String)))
(pub fn (parseModPathRest tokens pos acc)
  (if (peekIs tokens pos TK_DOT)
    {
      (let nr (parseIdentName tokens (advance pos)))
      (match nr
        ((ParseFailed parseError37) (ParseFailed parseError37))
        ((ParseSuccess parsedValue37 parsedPos37)
          ; The dotted tail is checked too, not only the head: `Sys./etc/x`
          ; is one `.` away from the head case and reaches the same
          ; `concat`.
          (if (if (let (Some _) (strFindByte parsedValue37 47 0))
            true
            false)
            (pErrModSeg (advance pos) parsedValue37)
            (parseModPathRest tokens parsedPos37 (concat (concat acc ".") parsedValue37)))
        ))
    }
    (pOk acc pos)))

; ------------------------------------------------------------------
; Parse (import Module (names...)) / (import Mod.Sub)
; ------------------------------------------------------------------
(pub :: parseImportDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseImportDecl tokens pos)
  {
    (let mr (parseModPath tokens pos))
    (match mr
      ((ParseFailed parseError38) (ParseFailed parseError38))
      ((ParseSuccess parsedValue38 parsedPos38)
        {
          (let modName parsedValue38)
          (let impSpan
            (if (< pos (vecLen tokens))
              (tokenSpan (vecGet tokens pos))
              0))
          (let nextPos parsedPos38)
          (if (peekIs tokens nextPos TK_LPAREN)
            {
              (let namesR (parseIdentList tokens (advance nextPos) vecNew))
              (match namesR
                ((ParseFailed parseError39) (ParseFailed parseError39))
                ((ParseSuccess parsedValue39 parsedPos39)
                  {
                    (let names parsedValue39)
                    (let afterNames parsedPos39)
                    (if (peekIs tokens afterNames TK_RPAREN)
                      (pOk (mkDImportAt modName names impSpan) (advance afterNames))
                      (pErr afterNames))
                  }
                ))
            }
            (if (peekIs tokens nextPos TK_RPAREN)
              (pOk (mkDImportAt modName vecNew impSpan) (advance nextPos))
              (pErr nextPos)))
        }
      ))
  })

; ------------------------------------------------------------------
; Parse (data Name (Ctor1 ...) (Ctor2) ...)
; ------------------------------------------------------------------
(pub :: parseDataDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseDataDecl tokens pos)
  ; `parseDeclName`, not `parseIdentName`: a `data` template may name
  ; its type with `(syntax/join Box T)`, exactly as a `fn` template
  ; names its function. Outside a macro template the marker reaches
  ; `expCheckDeclNames` and is refused there (AX3028), which is the
  ; same route the fn and sig spellings take.
  {
    (let nr (parseDeclName tokens pos))
    (match nr
      ((ParseFailed parseError40) (ParseFailed parseError40))
      ((ParseSuccess parsedValue40 parsedPos40)
        ; Type parameters are COLLECTED now, not merely skipped: a
        ; constructor's result type is `TCon(name, tyvars)` - `Nil`
        ; is `List a`, never bare `List` - and tyCompat compares TCon
        ; argument COUNTS, so losing the tyvars would make the
        ; checker call `Tree` and `Tree a` different types.
        {
          (let name parsedValue40)
          (let nextPos parsedPos40)
          {
            (let tvs vecNew)
            (parseConstructors tokens (collectTyParams tokens nextPos tvs) name
              (tokenSpan (vecGet tokens pos)) vecNew tvs)
          }
        }
      ))
  })

; `(data Tree (a) (Leaf) (Node a))` - the first parenthesised group is
; the type-parameter list when it is empty or opens with a lowercase
; name; constructors are uppercase. Registering `(a)` as a nullary
; constructor turned every binder named `a` anywhere in the module into
; a tag test that bound nothing, and the arm bodies dereferenced values
; that were never bound. The names are recorded into `tvs` as the
; position advances, so deciding the shape and capturing it are one
; walk - they were two, and a shape one declined and the other did not
; drifted the parse position.
(pub :: collectTyParams (-> Tokens Int Strings Int))
(pub fn (collectTyParams tokens pos tvs)
  (if (peekIs tokens pos TK_LPAREN)
    {
      (let inPos (advance pos))
      (if (peekIs tokens inPos TK_RPAREN)
        (advance inPos)
        (if (peekIs tokens inPos TK_IDENT)
          ; A type-parameter list is a parenthesised run of
          ; LOWERCASE names, and `syntax/join` is lowercase - so
          ; a constructor named `((syntax/join Mk N) ...)` read
          ; as one and collected `syntax/join`, `Mk` and `N` as
          ; three type variables. The prefix is reserved
          ; (MAC-CAP-6), so declining it here costs nothing and
          ; is the same test the other positions make.
          ; And only names: `(let ((x ...)) x)` opens with a lowercase
          ; name too, and was taken as the parameter list `let` with the
          ; rest skipped.
          (if (|| (identStartsUpper tokens inPos)
                (|| (strStartsWith (tokenLexeme (vecGet tokens inPos)) "syntax/")
                  (== (namesReachRParen tokens inPos) 0)))
            pos
            {
              (let r (skipParens tokens inPos 1))
              (match r
                ((ParseFailed parseError41) pos)
                ((ParseSuccess parsedValue41 parsedPos41)
                  {
                    (collectIdentsUntilRParen tokens inPos tvs)
                    parsedPos41
                  }
                ))
            })
          pos))
    }
    (collectBareTyParams tokens pos tvs)))

; Bare type parameters, `(data Tree a (Leaf) (Node a))`: a run of
; lowercase names, and only names. A parenthesised list after them
; used to be taken as a second parameter list, so `a ()` declared the
; empty list as parameters where the formatter refused it.
(pub :: collectBareTyParams (-> Tokens Int Strings Int))
(pub fn (collectBareTyParams tokens pos tvs)
  (if (peekIs tokens pos TK_IDENT)
    (if (identStartsUpper tokens pos)
      pos
      {
        (vecPush tvs (tokenLexeme (vecGet tokens pos)))
        (collectBareTyParams tokens (advance pos) tvs)
      })
    pos))

; 1 when the tokens from `pos` are names up to a `)`.
(pub :: namesReachRParen (-> Tokens Int Int))
(pub fn (namesReachRParen tokens pos)
  (if (peekIs tokens pos TK_RPAREN)
    1
    (if (peekIs tokens pos TK_IDENT)
      (namesReachRParen tokens (advance pos))
      0)))

(pub :: collectIdentsUntilRParen (-> Tokens Int Strings Int))
(pub fn (collectIdentsUntilRParen tokens pos tvs)
  (if (peekIs tokens pos TK_IDENT)
    {
      (vecPush tvs (tokenLexeme (vecGet tokens pos)))
      (collectIdentsUntilRParen tokens (advance pos) tvs)
    }
    0))

(pub :: parseConstructors (-> Tokens Int String Int (Vec ASTNode) Names (PResult ASTNode)))
(pub fn (parseConstructors tokens pos dataName nameSpan acc tvs)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk (setNodeTyNames (mkDDataAt dataName acc nameSpan) tvs) (advance pos))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let r (parseOneCtor tokens (advance pos)))
        (match r
          ((ParseFailed parseError42) (ParseFailed parseError42))
          ((ParseSuccess parsedValue42 parsedPos42)
            {
              (let ctor parsedValue42)
              (let nextPos parsedPos42)
              (parseConstructors tokens nextPos dataName nameSpan (vecPush acc ctor) tvs)
            }
          ))
      }
      ; A bare `...` among constructors is the splice marker a rule
      ; template leaves for instantiation (`(s) ...` rebuilding one
      ; constructor per absorbed element, MAC-LANG-16). It parses as
      ; exactly what `(...)` already parsed as - a nullary
      ; constructor named `...` - so no wire format changes and no
      ; new refusal: outside a template splice the marker is the same
      ; curiosity a parenthesised `...` has always been, and inside
      ; one it is consumed before checking ever runs.
      (if (&& (peekIs tokens pos TK_IDENT) (strEq (tokenLexeme (vecGet tokens pos)) "..."))
        {
          (let mkr (setNodeTyChildren (mkCtor "..." 0 vecNew) vecNew))
          {
            (setNodeSpan mkr (tokenSpan (vecGet tokens pos)))
            (parseConstructors tokens (advance pos) dataName nameSpan (vecPush acc mkr) tvs)
          }
        }
        ; `deriving (Eq Show)` after the last constructor - REFUSED
        ; (AX2004), the settled MAC-CAP-9 decision. The clause parsed and
        ; was silently DISCARDED from the day it was written: its names
        ; never reached the AST, no instance was ever derived, and a
        ; program carrying one checked OK - the documented-but-inert
        ; failure class this repository keeps finding. `derive` is explicit
        ; declaration macros - `(deriveEq T)` at the point of use - and
        ; the diagnostic points there. Corpus population when the refusal
        ; landed: exactly one file pair, the fmt syntax zoo, written
        ; deliberately to pin the formatter's spelling of a clause the
        ; compiler ignored (macro-system.md MAC-CAP-9 counted it before
        ; the commit).
        (if (&& (peekIs tokens pos TK_IDENT) (strEq (tokenLexeme (vecGet tokens pos)) "deriving"))
          (pErrRemoved pos "deriving")
          (pErrExp pos "identifier"))))))

(pub :: parseOneCtor (-> Tokens Int (PResult ASTNode)))
(pub fn (parseOneCtor tokens pos)
  {
    (let r0 (parseOneCtorInner tokens pos))
    (match r0
      ((ParseFailed parseError43) (ParseFailed parseError43))
      ((ParseSuccess parsedValue43 parsedPos43)
        ; Stamp the constructor's NAME span onto the node: `symbols`
        ; reports each constructor at its own name, and until it the
        ; ctor nodes carried none.
        {
          (setNodeSpan parsedValue43 (tokenSpan (vecGet tokens pos)))
          r0
        }
      ))
  })

(pub :: parseOneCtorInner (-> Tokens Int (PResult ASTNode)))
(pub fn (parseOneCtorInner tokens pos)
  {
    (let nr (parseDeclName tokens pos))
    (match nr
      ((ParseFailed parseError44) (ParseFailed parseError44))
      ((ParseSuccess parsedValue44 parsedPos44)
        {
          (let ctorName parsedValue44)
          (let nextPos parsedPos44)
          (if (peekIs tokens nextPos TK_RPAREN)
            (pOk (setNodeTyChildren (mkCtor ctorName 0 vecNew) vecNew) (advance nextPos))
            ; A STRUCT VARIANT: `(Rect { w : Int, h : Int })`. The field
            ; names are recorded, and everything else about the
            ; constructor - arity, per-field float flags, per-field type
            ; nodes - is built exactly as the positional spelling builds
            ; it. A named constructor IS a positional one that also
            ; knows what its fields are called, which is why every
            ; consumer downstream needs no change: a positional pattern
            ; over a named declaration already works once this parses.
            (if (peekIs tokens nextPos TK_LBRACE)
              (parseNamedFieldTypes tokens (advance nextPos) vecNew ctorName vecNew vecNew)
              (parseFieldTypes tokens nextPos vecNew ctorName vecNew)))
        }
      ))
  })

; `name : Type` pairs to the closing brace, commas optional - stage0
; treats a comma as separator-or-not, so `{ w : Int h : Int }` parses
; the same as `{ w : Int, h : Int }`.
(pub :: parseNamedFieldTypes (-> Tokens Int Ints String Nodes Names (PResult ASTNode)))
(pub fn (parseNamedFieldTypes tokens pos flags ctorName tys names)
  (if (peekIs tokens pos TK_RBRACE)
    (if (peekIs tokens (advance pos) TK_RPAREN)
      (pOk (setCtorFieldNames (setNodeTyChildren (mkCtor ctorName (vecLen flags) flags) tys) names)
        (advance (advance pos)))
      (pErr (advance pos)))
    (if (peekIs tokens pos TK_IDENT)
      {
        (let fname (tokenLexeme (vecGet tokens pos)))
        (if (peekIs tokens (advance pos) TK_COLON)
          {
            (let tr (parseType tokens (advance (advance pos))))
            (match tr
              ((ParseFailed parseError45) (ParseFailed parseError45))
              ((ParseSuccess parsedValue45 parsedPos45)
                {
                  (vecPush names fname)
                  ; The float flag follows the positional rule
                  ; exactly: a BARE `Float` is 1, anything else
                  ; including a parenthesised type is 0.
                  (vecPush flags
                    (if (peekIs tokens (advance (advance pos)) TK_IDENT)
                      (identIsFloat tokens (advance (advance pos)))
                      0))
                  (vecPush tys parsedValue45)
                  (parseNamedFieldTypes tokens (skipFieldComma tokens parsedPos45) flags ctorName
                    tys names)
                }
              ))
          }
          (pErr (advance pos)))
      }
      (pErr pos))))

; stage0 consumes at most ONE comma, and only immediately after a
; completed field (axiom-parser/src/lib.rs:508 for declarations, :909
; for patterns). So `{ w : Int,, h : Int }` and a leading `{ , w ... }`
; are parse errors there, and skipping commas wherever they appear
; would accept programs it refuses.
(pub :: skipFieldComma (-> Tokens Int Int))
(pub fn (skipFieldComma tokens pos)
  (if (peekIs tokens pos TK_COMMA)
    (advance pos)
    pos))

(pub :: setCtorFieldNames (-> ASTNode Strings ASTNode))
(pub fn (setCtorFieldNames n names)
  {
    (writeNodeNames n 9 names)
    n
  })

; Field types are retained as one float flag per field - a bare `Float`
; is 1, anything else (including any parenthesised type) is 0 - so a
; pattern that binds a constructor's field knows whether the word it
; binds is IEEE-754 bits. The arity is the flag count.
;
; The STRUCTURE of each field type also survives now, as a Vec of type
; nodes in the ctor's ty slot - the checker binds pattern variables at
; these types and checks construction arguments against them. The flag
; rule above is deliberately unchanged (`(Float)` parenthesised is
; still flag 0), so codegen behaves bit-identically.
(pub :: parseFieldTypes (-> Tokens Int Ints String Nodes (PResult ASTNode)))
(pub fn (parseFieldTypes tokens pos flags ctorName tys)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk (setNodeTyChildren (mkCtor ctorName (vecLen flags) flags) tys) (advance pos))
    ; A field type that does not parse is refused where it stands. It
    ; used to become the silent wildcard, which matches every type, so
    ; `(Lo (Vec 1))` declared a field of any type at all.
    (if (|| (peekIs tokens pos TK_IDENT) (peekIs tokens pos TK_LPAREN))
      {
        (let tr (parseType tokens pos))
        (match tr
          ((ParseFailed parseError46) (ParseFailed parseError46))
          ((ParseSuccess parsedValue46 parsedPos46)
            {
              (vecPush flags
                (if (peekIs tokens pos TK_IDENT)
                  (identIsFloat tokens pos)
                  0))
              (vecPush tys parsedValue46)
              (parseFieldTypes tokens parsedPos46 flags ctorName tys)
            }
          ))
      }
      (pErr pos))))

; A parsed type, or the silent wildcard for one the grammar cannot
; represent - the checker treats a nameless TVar as matching anything
; and never renders it, so failure here can only under-report.
(pub :: typeNodeOrWildcard (-> (PResult ASTNode) ASTNode))
(pub fn (typeNodeOrWildcard r)
  (match r
    ((ParseFailed parseError47) (mkTVar ""))
    ((ParseSuccess parsedValue47 parsedPos47) parsedValue47)))

; ------------------------------------------------------------------
; Parse (struct Name (field1 : Type1) (field2 : Type2) ...)
; ------------------------------------------------------------------
(pub :: parseStructDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseStructDecl tokens pos)
  {
    (let nr (parseDeclName tokens pos))
    (match nr
      ((ParseFailed parseError48) (ParseFailed parseError48))
      ((ParseSuccess parsedValue48 parsedPos48)
        ; TYPE PARAMETERS, collected exactly as `parseDataDecl` collects
        ; them and in the same PARENTHESISED spelling - `(struct Box (a)
        ; (v : a))`, never a bare `a`. One convention for both
        ; declarations rather than two that a reader has to keep
        ; straight, and `collectTyParams` already declines an uppercase
        ; name and the `syntax/` prefix, so a struct named by a macro
        ; template reads the same here as a `data` does.
        ;
        ; A struct with no parameters collects an empty vector and is
        ; byte-for-byte the declaration it was before: `collectTyParams`
        ; answers `pos` unchanged when the next token is not a
        ; parenthesised lowercase list, which is every struct in this
        ; repository today.
        ; A STRUCT'S FIRST GROUP IS AMBIGUOUS WHERE A `data`'s IS NOT,
        ; and this is the whole difficulty of the feature. `(data Tree
        ; (a) ...)` can only mean type parameters, because a data
        ; declaration's other groups are constructors and those start
        ; with an UPPERCASE name. A struct's groups are FIELDS, and a
        ; field starts with a lowercase identifier too:
        ;
        ;     (struct Span (start : Int) (end : Int))
        ;              ^^^^^^^^^^^^^^^^ a field, not a parameter list
        ;
        ; Handing that to `collectTyParams` unguarded swallowed
        ; `Span`'s first field as a type parameter and every struct in
        ; the tree stopped parsing - caught by the seed refusing to
        ; compile `core/main.ax`, which is the right place for it
        ; to be caught and the reason the bootstrap runs first.
        ;
        ; The discriminator is the `:`. A type-parameter list is names
        ; and nothing else; a field is `name : type`. So the group is
        ; read as parameters only when its second token is not a
        ; colon.
        ;
        ; REPRESENTATION MARKERS come first, as bare words between the
        ; name and everything else: `(struct Chan word shared (slot :
        ; Int))`. Every identifier there is recorded, known or not, and
        ; the CHECKER decides what each one means (`checkStructMarkers`,
        ; AX3084) - so this grammar, the formatter's and tree-sitter's
        ; stay one rule, "names after the struct's name", and a
        ; misspelled marker is refused by `check` with a message that
        ; names it rather than by the parser with a bare expectation. A
        ; bare word there was a syntax error before (`parseFields`
        ; wanted a `(`), so no program that parsed changes meaning.
        ; ONLY when there are markers, for `parseFieldsTv`'s
        ; reason: a D_STRUCT's word c has been 0 on every struct
        ; ever written, and an empty vector there would be a
        ; handle where every copier expects nothing.
        {
          (let name parsedValue48)
          (let markers vecNew)
          {
            (let nextPos (collectStructMarkers tokens parsedPos48 markers))
            {
              (let tvs vecNew)
              {
                (let r
                  (parseFieldsTv tokens
                    (if (== (structGroupIsTyParams tokens nextPos) 1)
                      (collectTyParams tokens nextPos tvs)
                      nextPos)
                    name (tokenSpan (vecGet tokens pos)) vecNew tvs))
                (match r
                  ((ParseFailed error) (ParseFailed error))
                  ((ParseSuccess declaration after)
                    {
                      (if (> (vecLen markers) 0)
                        (writeNodeChildren declaration 3 markers))
                      (pOk declaration after)
                    }
                  ))
              }
            }
          }
        }
      ))
  })

; The bare words after a struct's name, each as a TAG_E_VAR node that
; keeps its span for the checker's diagnostic. Answers the position of
; the first token that is not one.
(pub :: collectStructMarkers (-> Tokens Int (Vec ASTNode) Int))
(pub fn (collectStructMarkers tokens pos markers)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let tok (vecGet tokens pos))
      {
        (vecPush markers (mkEVarAt (tokenLexeme tok) (tokenSpan tok)))
        (collectStructMarkers tokens (advance pos) markers)
      }
    }
    pos))

; A struct declaration's markers - the Vec `collectStructMarkers`
; built - or an empty vector when it has none.
(pub :: structMarkers (-> ASTNode (Vec ASTNode)))
(pub fn (structMarkers d)
  (if (== (nodeC d) 0)
    vecNew
    (nodeCChildren d)))

; Does the declaration carry the marker spelled `m`?
(pub :: structHasMarker (-> ASTNode String Bool))
(pub fn (structHasMarker d m)
  {
    (let ms (structMarkers d))
    (let mut i 0)
    (let mut found false)
    {
      (while (< i (vecLen ms))
        {
          (if (strEq (nodeAName (vecGet ms i)) m)
            (set found true))
          (set i (+ i 1))
        })
      found
    }
  })

; A WORD STRUCT (docs/memory-model.md MM-VAL-10a): one machine word,
; not a heap block. The checker holds the declaration to one `Int`
; field; codegen classifies the type as a scalar. Every phase asks this
; one predicate, so the three cannot disagree about which structs are
; words.
(pub :: structIsWord (-> ASTNode Bool))
(pub fn (structIsWord d)
  (structHasMarker d "word"))

; A word struct a `parallel` binding may capture (MM-PAR-6, AX3064).
(pub :: structIsShared (-> ASTNode Bool))
(pub fn (structIsShared d)
  (structHasMarker d "shared"))

; `parseFields` with the type parameters carried alongside, so the
; node they land on is the one `parseFields` was already building. The
; old entry point stays for callers that have no parameters to pass.
; Is the parenthesised group at `pos` a type-PARAMETER list rather
; than a field? Only when it opens, holds an identifier, and that
; identifier is NOT followed by a colon. `(a)` and `(a b)` are
; parameters; `(start : Int)` is a field; `()` is neither and is left
; to `parseFields` to refuse as it always has.
(pub :: structGroupIsTyParams (-> Tokens Int Int))
(pub fn (structGroupIsTyParams tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
    (if (peekIs tokens (advance pos) TK_IDENT)
      (structTyParamRun tokens (advance pos))
      0)
    0))

; Every token to the closing paren is a LOWERCASE identifier, or this
; is not a parameter list.
;
; The colon alone was not enough, and the case that proves it is
; `tests/diagnostics/388-struct-field-untyped.ax`:
;
;     (struct NoColon (msg String))
;
; A field whose `:` the author forgot - AX3056, and one of the three
; refusals that fixture pins. `(msg String)` has no colon, so a
; colon-only test read it as the parameters `msg` and `String` and the
; diagnostic vanished: a malformed field silently became a type
; parameter list, which is the AX3056 hole reopening under a new name.
;
; Requiring every name to be lowercase is the same rule
; `collectTyParams` applies for `data`, and it separates the two
; shapes exactly: `String` is uppercase, so `(msg String)` is a field
; the checker still refuses.
(pub :: structTyParamRun (-> Tokens Int Int))
(pub fn (structTyParamRun tokens pos)
  (if (peekIs tokens pos TK_RPAREN)
    1
    (if (peekIs tokens pos TK_IDENT)
      (if (identStartsUpper tokens pos)
        0
        (structTyParamRun tokens (advance pos)))
      0)))

(pub :: parseFieldsTv (-> Tokens Int String Int (Vec ASTNode) Strings (PResult ASTNode)))
(pub fn (parseFieldsTv tokens pos structName nameSpan acc tvs)
  {
    (let r (parseFields tokens pos structName nameSpan acc))
    (match r
      ((ParseFailed parseError49) (ParseFailed parseError49))
      ((ParseSuccess parsedValue49 parsedPos49)
        ; ONLY when there are parameters, and this is not an
        ; optimisation. A `D_STRUCT`'s `ty` slot was 0 for every struct
        ; ever written, and the macro expander copies declaration nodes
        ; on the understanding that the slot holds a TYPE NODE or
        ; nothing. Writing an empty VECTOR there gave it a handle it
        ; walked as a node: `381-macro-type-templates` and
        ; `396-macro-struct-field-types` both died of SIGSEGV, exit 139,
        ; and every other struct in the tree was one macro away from the
        ; same. An unparameterised struct now leaves the slot exactly as
        ; it found it.
        (if (== (vecLen tvs) 0)
          r
          {
            (setNodeTyNames parsedValue49 tvs)
            r
          })
      ))
  })

(pub :: parseFields (-> Tokens Int String Int (Vec ASTNode) (PResult ASTNode)))
(pub fn (parseFields tokens pos structName nameSpan acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk (mkDStructAt structName acc nameSpan) (advance pos))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let r (parseOneField tokens (advance pos)))
        (match r
          ((ParseFailed parseError50) (ParseFailed parseError50))
          ((ParseSuccess parsedValue50 parsedPos50)
            {
              (let field parsedValue50)
              (let nextPos parsedPos50)
              (parseFields tokens nextPos structName nameSpan (vecPush acc field))
            }
          ))
      }
      (pErrExp pos "identifier"))))

; `(mut name : Type)` - the marker sits INSIDE the parens, before the
; name. Reading it as the field's name gave the zoo's `Rec` a field
; called `mut` with a wildcard type, so it is skipped rather than
; parsed as the name - and it is now RECORDED, in word c of the
; TAG_FIELD node, which `mkField` leaves 0 and nothing else on a
; struct field reads (codegen takes only a, b and ty from these
; nodes; the c slot is spoken for on an `extern` item's TAG_FIELD and
; on an effect operation's, and neither reaches `structFieldMut`).
;
; Until 2026-08-31 the marker was parsed and dropped, and the checker
; had nothing to read: `(struct P (x : Int))` with no `mut` at all
; took `(set p.x 9)` in silence. That is the shape AX2004's own
; explain text calls worse than no marker - "a marker that reads as an
; ownership guarantee and supplies none" - and it is why `linear`,
; `consume` and `deriving` were removed rather than left parsing.
; `checkSetField` reads this word now; see AX3012 there.
(pub :: parseOneField (-> Tokens Int (PResult ASTNode)))
(pub fn (parseOneField tokens pos)
  (if (&& (peekIs tokens pos TK_IDENT)
        (&& (strEq (tokenLexeme (vecGet tokens pos)) "mut") (peekIs tokens (advance pos) TK_IDENT)))
    (markFieldMut (parseOneFieldNamed tokens (advance pos)))
    (parseOneFieldNamed tokens pos)))

; Stamp `mut` on the field a successful `parseOneFieldNamed` produced.
; A failure preserves its diagnostic context.
(pub :: markFieldMut (-> (PResult ASTNode) (PResult ASTNode)))
(pub fn (markFieldMut r)
  (match r
    ((ParseFailed parseError51) (ParseFailed parseError51))
    ((ParseSuccess parsedValue51 parsedPos51)
      {
        (writeNodeWord parsedValue51 3 1)
        r
      }
    )))

; Was this struct field declared `mut`? Word c, 0 on every field the
; parser did not mark and on every TAG_FIELD a macro template rebuilt
; before `expBuildStructFieldsIn` learned to carry it.
(pub :: fieldIsMut (-> ASTNode Int))
(pub fn (fieldIsMut f)
  (if (== (nodeCWord f) 0)
    0
    1))

; Did a field's type parse, and something other than `)` follow it?
(pub :: fieldTyOverruns (-> Tokens (PResult ASTNode) Bool))
(pub fn (fieldTyOverruns tokens tr)
  (match tr
    ((ParseFailed parseError52) false)
    ((ParseSuccess parsedValue52 parsedPos52)
      (if (peekIs tokens parsedPos52 TK_RPAREN)
        false
        true)
    )))

(pub :: parseOneFieldNamed (-> Tokens Int (PResult ASTNode)))
(pub fn (parseOneFieldNamed tokens pos)
  {
    (let nr (parseIdentName tokens pos))
    (match nr
      ((ParseFailed parseError53) (ParseFailed parseError53))
      ((ParseSuccess parsedValue53 parsedPos53)
        ; `(name : Type)` - the type used to be skipped whole; the
        ; field's float flag survives (a bare `Float` is 1), so
        ; `p.f` arithmetic picks float instructions - and the full
        ; structure now rides in the ty slot for the checker. The
        ; flag rule and every token position are unchanged.
        ;
        ; WITH THE NAME'S SPAN, for the reason `parseEffectOps` gives
        ; for an operation's: `mkField` leaves span 0 and a spanless
        ; diagnostic is a suppressed one, so AX3056 - a field whose
        ; type the parser could not read - had nowhere to point and
        ; said nothing at all.
        {
          (let fieldName parsedValue53)
          (let nextPos parsedPos53)
          {
            (let fieldTy
              (if (peekIs tokens nextPos TK_COLON)
                (typeNodeOrWildcard (parseType tokens (advance nextPos)))
                (mkTVar "")))
            (if (&& (peekIs tokens nextPos TK_COLON) (peekIs tokens (advance nextPos) TK_IDENT))
              {
                (let fl (identIsFloat tokens (advance nextPos)))
                (if (peekIs tokens (advance (advance nextPos)) TK_RPAREN)
                  (pOk
                    (setNodeSpan (setNodeTyChild (mkField fieldName fl) fieldTy)
                      (tokenSpan (vecGet tokens pos)))
                    (advance (advance (advance nextPos))))
                  ; A field has one type. What followed it used to be
                  ; skipped, so `(y : Int Int)` declared an `Int`.
                  {
                    (let tr (parseType tokens (advance nextPos)))
                    (if (fieldTyOverruns tokens tr)
                      (pErrExp (pResPos tr) "`)` - a field has one type")
                      {
                        (let r (skipParens tokens (advance (advance nextPos)) 1))
                        (match r
                          ((ParseFailed parseError54) (ParseFailed parseError54))
                          ((ParseSuccess parsedValue54 parsedPos54)
                            (pOk
                              (setNodeSpan (setNodeTyChild (mkField fieldName fl) fieldTy)
                                (tokenSpan (vecGet tokens pos)))
                              parsedPos54)
                          ))
                      })
                  })
              }
              {
                (let afterSkip (skipParens tokens nextPos 1))
                (let overrun
                  (if (peekIs tokens nextPos TK_COLON)
                    {
                      (let tr (parseType tokens (advance nextPos)))
                      (if (fieldTyOverruns tokens tr)
                        (Some (pResPos tr))
                        None)
                    }
                    None))
                (if (let (Some at) overrun)
                  (pErrExp at "`)` - a field has one type")
                  (match afterSkip
                    ((ParseFailed parseError55) (ParseFailed parseError55))
                    ((ParseSuccess parsedValue55 parsedPos55)
                      (pOk
                        (setNodeSpan (setNodeTyChild (mkField fieldName 0) fieldTy)
                          (tokenSpan (vecGet tokens pos)))
                        parsedPos55)
                    )))
              })
          }
        }
      ))
  })

; ------------------------------------------------------------------
; Parse (macro (name params...) template)
;
; The name lives *inside* the head parens, exactly as a function's
; does: `(pub macro (clamp lo hi x) (if (< x lo) lo (> x hi) hi x))`.
; ------------------------------------------------------------------
; A top-level declaration-macro invocation: the head token, then zero
; or more argument expressions; `parseExprList` consumes the form's
; closing paren. The node must be a REAL handle (`parseDecls` reads a
; parse value of 0 as the clean end of the module - the historical
; skipParens trap), and `mkNodeAt` provides one.
(pub :: parseMacroCall (-> Tokens Int (PResult ASTNode)))
(pub fn (parseMacroCall tokens pos)
  ; A QUALIFIED head - `Pre::when` - is three tokens here, exactly
  ; as it is in expression position, and joins to the same flat
  ; `Mod$name` spelling the whole pipeline resolves.
  {
    (let head (vecGet tokens pos))
    {
      (let chain vecNew)
      {
        (vecPush chain (tokenLexeme head))
        {
          (let afterHead (parseQualChainTail tokens (advance pos) chain))
          {
            (let name
              (if (== (vecLen chain) 1)
                (tokenLexeme head)
                (mangledFromChain chain)))
            {
              (let argsR (parseExprList tokens afterHead vecNew))
              (match argsR
                ((ParseFailed parseError56) (ParseFailed parseError56))
                ((ParseSuccess parsedValue56 parsedPos56)
                  (pOk (nodeBuildDMacrocall name parsedValue56 0 (tokenSpan head)) parsedPos56)
                ))
            }
          }
        }
      }
    }
  })

; `:: IDENT` pairs after a head identifier, pushed onto the chain;
; answers the position after the last one consumed.
(pub :: parseQualChainTail (-> Tokens Int Strings Int))
(pub fn (parseQualChainTail tokens pos chain)
  (if (&& (peekIs tokens pos TK_DOUBLE_COLON) (peekIs tokens (advance pos) TK_IDENT))
    {
      (vecPush chain (tokenLexeme (vecGet tokens (advance pos))))
      (parseQualChainTail tokens (advance (advance pos)) chain)
    }
    pos))

; Whether `pos` opens a `(literals ...)` header: a paren followed
; by the identifier `literals`. Single-paren, so it never collides
; with a rule, whose head is doubly parenthesised.
(pub :: parseLiteralsHead (-> Tokens Int Bool))
(pub fn (parseLiteralsHead tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
    (if (peekIs tokens (advance pos) TK_IDENT)
      (strEq (tokenLexeme (vecGet tokens (advance pos))) "literals")
      false)
    false))

; A `(literals ...)` header (MAC-LANG-17): the identifiers whose
; occurrences in this rule list's patterns match literally - one
; binding, never a binder - rather than binding. Only in leading
; position: anywhere else the form reads as a rule whose head is
; not the macro's name, which stops the list. Members are bare
; identifiers; anything else is `pErrExp`'s AX2001 where it stands.
; `_` and `...` may be listed but never reserve: the rewrite skips
; both (a wildcard stays a wildcard, the repeat marker stays the
; repeat marker), and the expansion-time unused check names them.
(pub :: parseLiteralsDecl (-> Tokens Int (PResult Names)))
(pub fn (parseLiteralsDecl tokens pos)
  {
    (let acc vecNew)
    (parseLiteralsDeclIn tokens (advance (advance pos)) acc)
  })

(pub :: parseLiteralsDeclIn (-> Tokens Int Strings (PResult Names)))
(pub fn (parseLiteralsDeclIn tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_IDENT)
      {
        (vecPush acc (tokenLexeme (vecGet tokens pos)))
        (parseLiteralsDeclIn tokens (advance pos) acc)
      }
      (pErrExp pos "identifier"))))

; Reserve the declared literals across one rule's patterns: every
; `E_VAR` spelling a member (besides `_` and `...`, which are never
; reserved) becomes `syntax/literal ` plus the spelling - note the
; SPACE, which no lexed identifier contains. Answers the rewritten
; pattern and name vectors with the used set beside them; the rule
; record retains all three, with the used names beside the declared
; literals for the unused-literal check.
(pub :: rewriteRuleLits (-> Nodes Names Names MacroPatternRewrite))
(pub fn (rewriteRuleLits pats names lits)
  {
    (let used vecNew)
    (let pats2 nodesNew)
    (let names2 vecNew)
    (rewriteRuleLitsIn pats names lits used pats2 names2 0)
    (MacroPatternRewrite :patterns pats2 :names names2 :used used)
  })

(pub :: rewriteRuleLitsIn (-> Nodes Names Names Names Nodes Names Int Int))
(pub fn (rewriteRuleLitsIn pats names lits used pats2 names2 i)
  (if (>= i (vecLen pats))
    0
    {
      (let p2 (rewritePatLits (vecGet pats i) lits used))
      {
        (vecPush pats2 p2)
        (vecPush names2
          (if (== (patIsReserved p2) 1)
            "syntax/pat"
            (vecGetStr names i)))
        (rewriteRuleLitsIn pats names lits used pats2 names2 (+ i 1))
      }
    }))

; Whether this pattern node is a reserved literal spelling (top
; level or nested - the recursive use): exactly what the names
; slot must not carry as a binder.
(pub :: patIsReserved (-> ASTNode Int))
(pub fn (patIsReserved p)
  (if (== (nodeTag p) TAG_E_VAR)
    (if (strStartsWith (nodeAName p) "syntax/literal ")
      1
      0)
    0))

(pub :: rewritePatLits (-> ASTNode Strings Strings ASTNode))
(pub fn (rewritePatLits p lits used)
  (if (== (nodeTag p) TAG_E_VAR)
    {
      (let nm (nodeAName p))
      (if (|| (strEq nm "_") (strEq nm "..."))
        p
        (if (== (strVecHas lits nm) 0)
          p
          {
            (if (== (strVecHas used nm) 0)
              (vecPush used nm)
              used)
            (mkEVarAt (concat "syntax/literal " nm) (nodeSpan p))
          }))
    }
    (if (== (nodeTag p) TAG_E_APP)
      (mkEApp (rewritePatLits (nodeAChild p) lits used) (rewritePatLits (nodeBChild p) lits used))
      p)))

; Zero or more parenthesized DECLARATIONS - a rule-form macro's
; template - up to the rule's closing paren (consumed). Parsed by
; `parseTopForm`, the real declaration grammar, which is what makes
; `pub`, signature float flags and every refusal behave at the macro's
; OWN line rather than at expansion time; an unknown head inside a
; template becomes a nested TAG_D_MACROCALL for phase D's next round.
; An EMPTY template is refused here: MAC-CAP-8 permits "zero or more"
; in principle, but in-place instantiation needs a first declaration
; to stand where the invocation stood, so v1 demands at least one.
; `((name p ...) template ...)` repeated. Each rule owns its parameters,
; declarations, patterns, spellings, repeats, literals and optional
; expression template. A declaration vector is empty when the template
; is only an expression;
; `parseRuleTemplates` decides which of the two a rule has. At least
; one rule is required; a rule whose pattern head is not the macro's
; own name stops the list, which is what makes a malformed second rule
; a refusal rather than a silent truncation - the caller then demands
; the closing paren and fails there.
(pub :: parseMacroRules (-> Tokens Int String MacroRules Names (PResult MacroRules)))
(pub fn (parseMacroRules tokens pos macName acc lits)
  (if (if (peekIs tokens pos TK_LPAREN)
    (peekIs tokens (advance pos) TK_LPAREN)
    false)
    (match (parseIdentName tokens (advance (advance pos)))
      ((ParseFailed error) (ParseFailed error))
      ((ParseSuccess name afterName)
        (if (strEq name macName)
          (match (parseMacroPatList tokens afterName vecNew vecNew vecNew vecNew)
            ((ParseFailed error) (ParseFailed error))
            ((ParseSuccess parts afterPattern)
              (match (parseRuleTemplates tokens afterPattern)
                ((ParseFailed error) (ParseFailed error))
                ((ParseSuccess templates afterTemplate)
                  {
                    (let rewritten (rewriteRuleLits parts.patterns parts.names lits))
                    (let rule
                      (MacroRule
                        :params rewritten.names
                        :declarations templates.declarations
                        :patterns rewritten.patterns
                        :spellings parts.spellings
                        :repeats parts.repeats
                        :literals (MacroLiterals :declared lits :used rewritten.used)
                        :expression templates.expression))
                    (vecPush acc rule)
                    (parseMacroRules tokens afterTemplate macName acc lits)
                  }
                ))
            ))
          (pErrMacroHead (advance (advance pos)) macName))
      ))
    (if (== (vecLen acc) 0)
      (pErr pos)
      (pOk acc pos))))

; A rule's template, read both ways (MAC-LANG-14). As declarations,
; the way a declaration macro's template has always been read; and, when
; the rule holds one form that does not open with a declaration keyword,
; as one expression too. Answers declarations, empty when there are none,
; and an optional expression, followed by the position past
; the rule's closing paren. An empty vector is unambiguous: a template
; with no declarations is refused (`parseTplDecls`).
;
; The kind can't be read from the template alone: `(defPair a b)` is a
; declaration-macro invocation in one position and a call in the other.
; So a rule whose one form is headed by a name keeps both readings when
; both parse, and the invocation's position chooses (`expandRuleApp`,
; `expandDeclRound`). A form headed by an expression keyword or an
; operator, such as `(if ...)` or `(+ ...)`, is only an expression. A
; rule that parses neither way reports the reading its shape asks for:
; the declaration error for several forms or a declaration head, else
; the expression error.
(pub :: parseRuleTemplates (-> Tokens Int (PResult RuleTemplates)))
(pub fn (parseRuleTemplates tokens pos)
  {
    (let declR (parseTplDecls tokens pos vecNew))
    (let exprR
      (if (tplDeclHead tokens pos)
        (pErr pos)
        (parseExpr tokens pos)))
    (match declR
      ((ParseSuccess declarations afterDecls)
        (match exprR
          ((ParseSuccess expression afterExpr)
            (if (peekIs tokens afterExpr TK_RPAREN)
              (if (tplNamesMacro tokens pos)
                (pOk (RuleTemplates :declarations declarations :expression (Some expression))
                  afterDecls)
                (pOk (RuleTemplates :declarations vecNew :expression (Some expression))
                  (advance afterExpr)))
              (pOk (RuleTemplates :declarations declarations :expression None) afterDecls))
          )
          ((ParseFailed error)
            (pOk (RuleTemplates :declarations declarations :expression None) afterDecls)
          ))
      )
      ((ParseFailed declarationError)
        (match exprR
          ((ParseSuccess expression afterExpr)
            (if (peekIs tokens afterExpr TK_RPAREN)
              (pOk (RuleTemplates :declarations vecNew :expression (Some expression))
                (advance afterExpr))
              (ParseFailed declarationError))
          )
          ((ParseFailed expressionError)
            (if (tplDeclHead tokens pos)
              (ParseFailed declarationError)
              (ParseFailed expressionError))
          ))
      ))
  })

; Whether the template at `pos` opens with a declaration head - a
; declaration keyword or `syntax/for` - which no expression starts with.
(pub :: tplDeclHead (-> Tokens Int Bool))
(pub fn (tplDeclHead tokens pos)
  (if (&& (peekIs tokens pos TK_LPAREN) (peekIs tokens (advance pos) TK_DOUBLE_COLON))
    true
    (if (&& (peekIs tokens pos TK_LPAREN) (peekIs tokens (advance pos) TK_IDENT))
      {
        (let h (tokenLexeme (vecGet tokens (advance pos))))
        (|| (kwEq h kwFn)
          (|| (kwEq h kwData)
            (|| (kwEq h kwStruct)
              (|| (kwEq h kwPub)
                (|| (kwEq h kwEffect)
                  (|| (kwEq h kwImport)
                    (|| (kwEq h kwMacro)
                      (|| (kwEq h "type")
                        (|| (kwEq h "subtype") (|| (kwEq h "extern") (kwEq h "syntax/for")))))))))))
      }
      false)))

; Whether the one form at `pos` could invoke a declaration macro: its
; head is a name, not an operator or an expression keyword, so at the
; top level it reads as a macro invocation.
(pub :: tplNamesMacro (-> Tokens Int Bool))
(pub fn (tplNamesMacro tokens pos)
  (if (&& (peekIs tokens pos TK_LPAREN) (peekIs tokens (advance pos) TK_IDENT))
    {
      (let h (tokenLexeme (vecGet tokens (advance pos))))
      (&& (strIsAlpha (strByte h 0)) (! (tplExprKeyword h)))
    }
    false))

(pub :: tplExprKeyword (-> String Bool))
(pub fn (tplExprKeyword h)
  (|| (kwEq h "|>")
    (|| (kwEq h kwLet)
      (|| (kwEq h kwIf)
        (|| (kwEq h kwMatch)
          (|| (kwEq h "lambda")
            (|| (kwEq h "for")
              (|| (kwEq h "while")
                (|| (kwEq h "set")
                  (|| (kwEq h "handle")
                    (|| (kwEq h "region")
                      (|| (kwEq h "parallel") (|| (kwEq h "asm") (kwEq h "as"))))))))))))))

; A declaration-only rule has no expression template.
(pub :: ruleExprAt (-> MacroRules Int (Option ASTNode)))
(pub fn (ruleExprAt rules i)
  {
    (let rule (vecGet rules i))
    rule.expression
  })

(pub :: parseTplDecls (-> Tokens Int (Vec ASTNode) (PResult Nodes)))
(pub fn (parseTplDecls tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (if (== (vecLen acc) 0)
      (pErr pos)
      (pOk acc (advance pos)))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let r (parseTopForm tokens (advance pos)))
        (match r
          ((ParseFailed parseError60) (ParseFailed parseError60))
          ((ParseSuccess parsedValue60 parsedPos60)
            {
              (vecPush acc parsedValue60)
              (parseTplDecls tokens parsedPos60 acc)
            }
          ))
      }
      ; A bare `...` among template declarations is the splice marker
      ; a rule template leaves for instantiation (`decl ...`
      ; rebuilding one declaration per absorbed element, MAC-LANG-16).
      ; It parses as a declaration-macro invocation of `...` with no
      ; arguments - the shape the expander's splice consumes before
      ; phase D ever resolves it, and the shape phase D refuses as
      ; AX3027 anywhere the splice does not consume it. Ordinary
      ; declaration lists (parseDecls) do NOT take this arm: a bare
      ; `...` outside a template stays AX2001 where it stands.
      (if (&& (peekIs tokens pos TK_IDENT) (strEq (tokenLexeme (vecGet tokens pos)) "..."))
        {
          (vecPush acc (nodeBuildDMacrocall "..." vecNew 0 (tokenSpan (vecGet tokens pos))))
          (parseTplDecls tokens (advance pos) acc)
        }
        (pErr pos)))))

; The RULE form of a macro declaration (MAC-LANG-14's spelling). One
; rule only until 2026-08-15; a LIST of rules since, and since
; 2026-08-16 each rule's parameters are PATTERNS tried in rule order
; rather than counted:
;
;   (macro name ((name p1 .. pn) decl1 decl2 ...)
;               ((name q1 .. qm) decl1 ...))
;
; One token of lookahead splits the two forms: `(macro (` is the
; head-list (expression) form, `(macro <ident>` a rule. The pattern
; repeats the macro's name in head position, as syntax-rules does, and
; everything after it is the template - each form ONE generated
; declaration. The template vec rides in the macro node's word 9
; (unused for macros); word 3, an expression macro's template, stays
; 0, and that pairing is the discriminator everywhere else.
(pub :: parseDeclMacro (-> Tokens Int (PResult ASTNode)))
(pub fn (parseDeclMacro tokens pos)
  {
    (let macName (tokenLexeme (vecGet tokens pos)))
    (let macSpan (tokenSpan (vecGet tokens pos)))
    (let p1 (advance pos))
    (if (peekIs tokens p1 TK_LPAREN)
      ; A `(literals ...)` header (MAC-LANG-17) between the name and
      ; the rules: single-paren, so it never collides with a rule,
      ; whose head is doubly parenthesised.
      (if (parseLiteralsHead tokens p1)
        {
          (let lr (parseLiteralsDecl tokens p1))
          (match lr
            ((ParseFailed parseError61) (ParseFailed parseError61))
            ((ParseSuccess parsedValue61 parsedPos61)
              (parseDeclMacroRules tokens parsedPos61 macName macSpan parsedValue61)
            ))
        }
        (if (peekIs tokens (advance p1) TK_LPAREN)
          ; One or more RULES (MAC-LANG-14). Word 9 holds them all,
          ; each a two-slot record of (parameters, template); node B
          ; keeps the FIRST rule's parameters, which is what every
          ; reader that wants "the" parameters already indexes and
          ; what a single-rule macro has always meant.
          (parseDeclMacroRules tokens p1 macName macSpan vecNew)
          (pErr (advance p1))))
      (pErr p1))
  })

; One or more RULES after the optional `(literals ...)` header:
; shared by the plain and headered shapes so the two spell one
; list, one node and one refusal.
(pub :: parseDeclMacroRules (-> Tokens Int String Int Strings (PResult ASTNode)))
(pub fn (parseDeclMacroRules tokens pos macName macSpan lits)
  (if (peekIs tokens (advance pos) TK_LPAREN)
    {
      (let rulesR (parseMacroRules tokens pos macName vecNew lits))
      (match rulesR
        ((ParseFailed parseError62) (ParseFailed parseError62))
        ((ParseSuccess parsedValue62 parsedPos62)
          {
            (let rules parsedValue62)
            (let after parsedPos62)
            (if (peekIs tokens after TK_RPAREN)
              {
                (let node (mkDMacroAt macName (ruleParamsAt rules 0) nilNode macSpan))
                {
                  (writeNodeMacroRules node rules)
                  (pOk node (advance after))
                }
              }
              (pErr after))
          }
        ))
    }
    (pErr (advance pos))))

(pub :: parseMacroDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseMacroDecl tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    (parseDeclMacro tokens pos)
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let nr (parseIdentName tokens (advance pos)))
        (match nr
          ((ParseFailed parseError63) (ParseFailed parseError63))
          ((ParseSuccess parsedValue63 parsedPos63)
            ; The NAME token's span, kept for the same reason a
            ; `fn`'s is: a diagnostic about a declaration points
            ; at its name. A macro node used to carry span 0,
            ; which cost two things silently - AX3020 could name
            ; the offending macro but not point at it, and
            ; `lsp.ax`'s documentSymbol arm for TAG_D_MACRO
            ; (which gates on a non-zero span) had been dead
            ; since it was written, so the server listed macros
            ; in its capabilities and published none.
            ; Consumes the head's closing paren too.
            {
              (let macName parsedValue63)
              (let macSpan (tokenSpan (vecGet tokens (advance pos))))
              (let paramsR (parseIdentList tokens parsedPos63 vecNew))
              (match paramsR
                ((ParseFailed parseError64) (ParseFailed parseError64))
                ((ParseSuccess parsedValue64 parsedPos64)
                  {
                    (let params parsedValue64)
                    (let bodyR (parseExpr tokens parsedPos64))
                    (match bodyR
                      ((ParseFailed parseError65) (ParseFailed parseError65))
                      ((ParseSuccess parsedValue65 parsedPos65)
                        {
                          (let body parsedValue65)
                          (let afterBody parsedPos65)
                          (if (peekIs tokens afterBody TK_RPAREN)
                            (pOk (mkDMacroAt macName params body macSpan) (advance afterBody))
                            (pErr afterBody))
                        }
                      ))
                  }
                ))
            }
          ))
      }
      (pErr pos))))

; ------------------------------------------------------------------
; Parse (fn (name args...) body) at top level.
; ------------------------------------------------------------------
(pub :: parseFnDecl (-> Tokens Int (PResult ASTNode)))
(pub fn (parseFnDecl tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
    {
      (let headerStart (advance pos))
      {
        (let nr (parseDeclName tokens headerStart))
        (match nr
          ((ParseFailed parseError66) (ParseFailed parseError66))
          ((ParseSuccess parsedValue66 parsedPos66)
            {
              (let fnName parsedValue66)
              (let afterName parsedPos66)
              {
                (let paramsR (parseIdentList tokens afterName vecNew))
                (match paramsR
                  ((ParseFailed parseError67) (ParseFailed parseError67))
                  ((ParseSuccess parsedValue67 parsedPos67)
                    ; A body of SEVERAL expressions sequences them,
                    ; exactly as `let` bodies do - stage0's
                    ; parse_body_exprs wraps two or more in a
                    ; begin - and this parser demanded exactly one
                    ; until the zoo's `(fn (manyBody n) 1 n)` met
                    ; it. parseExprList consumes the closing paren.
                    {
                      (let params parsedValue67)
                      (let afterParams parsedPos67)
                      {
                        (let bodyR (parseExprList tokens afterParams vecNew))
                        (match bodyR
                          ((ParseFailed parseError68) (ParseFailed parseError68))
                          ((ParseSuccess parsedValue68 parsedPos68)
                            {
                              (let exprs parsedValue68)
                              (let afterBody parsedPos68)
                              (if (== (vecLen exprs) 0)
                                (pErr afterParams)
                                (pOk
                                  (mkDFnAt fnName params
                                    (if (== (vecLen exprs) 1)
                                      (vecGet exprs 0)
                                      (mkEBegin exprs))
                                    (tokenSpan (vecGet tokens headerStart)))
                                  afterBody))
                            }
                          ))
                      }
                    }
                  ))
              }
            }
          ))
      }
    }
    ; A name with no parentheses around it, `(fn answer 42)` or
    ; `(fn answer = 42)`, is refused: a function is `(fn (name params)
    ; body)`, and `(fn (answer) 42)` when it takes none.
    (if (peekIs tokens pos TK_IDENT)
      (pErrExp pos
        "the function's name and parameters in parentheses: `(fn (name params) body)`, or `(fn (name) body)` when it takes none")
      (pErrExp pos "identifier"))))

; ------------------------------------------------------------------
; Expression parsing.
; ------------------------------------------------------------------
(pub :: parseExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseExpr tokens pos)
  {
    (let r (parseExprCore tokens pos))
    (match r
      ((ParseFailed parseError69) (ParseFailed parseError69))
      ((ParseSuccess parsedValue69 parsedPos69) (parsePostfix tokens r)))
  })

; A `?` directly after an expression wraps it: `(f x)?`, `v?`. It binds
; tighter than application, so `(g (f x)?)` passes the propagated value
; to `g`. Several in a row stack, `(f x)??`, which the expander then
; propagates twice.
(pub :: parsePostfix (-> Tokens (PResult ASTNode) (PResult ASTNode)))
(pub fn (parsePostfix tokens r)
  (match r
    ((ParseFailed error) (ParseFailed error))
    ((ParseSuccess value after)
      {
        (let pos after)
        (if (peekIs tokens pos TK_QUESTION)
          ; An `if` or a block carries no span of its own (`mkEIf`,
          ; `mkEBegin`), so the `?` starts its own span there; reading
          ; the operand's null span was a crash on `(if ...)?`
          ; (tests/stdlib/891-propagate-on-forms.ax).
          {
            (let inner value)
            (let qsp (tokenSpan (vecGet tokens pos)))
            (parsePostfix tokens
              (pOk
                (nodeBuildETry inner 0 0
                  (mkSpan
                    (if (== (nodeSpan inner) 0)
                      (spanStart qsp)
                      (spanStart (nodeSpan inner)))
                    (spanEnd qsp)))
                (advance pos)))
          }
          r)
      }
    )))

(pub :: parseExprCore (-> Tokens Int (PResult ASTNode)))
(pub fn (parseExprCore tokens pos)
  (if (peekIs tokens pos TK_INT)
    (parseLit tokens pos)
    (if (peekIs tokens pos TK_FLOAT)
      (parseLit tokens pos)
      (if (peekIs tokens pos TK_CHARLIT)
        (parseLit tokens pos)
        (if (peekIs tokens pos TK_STRING)
          (parseLit tokens pos)
          (if (peekIs tokens pos TK_IDENT)
            (parseIdentRef tokens pos)
            (if (peekIs tokens pos TK_LPAREN)
              (parseSExpr tokens pos)
              (if (peekIs tokens pos TK_LBRACE)
                (parseBlock tokens (advance pos))
                ; A `'` the lexer could not read as a character
                ; literal: refused here, where the token kind is
                ; still known, rather than as a bare syntax error.
                (if (peekIs tokens pos TK_QUOTE)
                  (pErrQuote pos)
                  (pErrExp pos "expression"))))))))))

; ------------------------------------------------------------------
; Parse an S-expression: dispatch on first token.
; ------------------------------------------------------------------
(pub :: parseSExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseSExpr tokens pos)
  (if (peekIs tokens pos TK_LPAREN)
    (parseInner tokens (advance pos))
    (pErrExp pos "expression")))

(pub :: parseInner (-> Tokens Int (PResult ASTNode)))
(pub fn (parseInner tokens pos)
  (if (peekIs tokens pos TK_RPAREN)
    ; `()`, the unit value.
    (pOk (mkEUnitAt (tokenSpan (vecGet tokens (- pos 1)))) (advance pos))
    (if (peekIs tokens pos TK_IDENT)
      {
        (let kw (vecGet tokens pos))
        {
          (let name (tokenLexeme kw))
          (if (kwEq name "|>")
            (parseAppForm tokens pos)
            (if (kwEq name "as")
              (parseAsExpr tokens (advance pos))
              (if (kwEq name "cast")
                (pErrRemoved pos "cast")
                (if (kwEq name kwImport)
                  (pErrCode pos "import-position")
                  (if (kwEq name kwPub)
                    ; `pub` marks a top-level declaration. In an expression it
                    ; used to be skipped, so `(pub "x")` read as `("x")`.
                    (pErrExp pos "an expression")
                    ; An anonymous function is spelled `lambda`. `fn` declares a
                    ; named function at the top level, and in expression position
                    ; it is refused with that advice (AX2004).
                    (if (kwEq name kwFn)
                      (pErrRemoved pos "fn")
                      (if (kwEq name "lambda")
                        (parseLamExpr tokens (advance pos))
                        (if (kwEq name kwLet)
                          (pErrExp pos
                            "a local declaration directly inside a brace block: `{ (let value 42) value }`")
                          (if (kwEq name kwIf)
                            (parseIfExpr tokens (advance pos))
                            (if (kwEq name kwMatch)
                              (parseMatchExpr tokens (advance pos))
                              ; `cond` is REMOVED, not parsed. A variadic `if`
                              ; takes its place - `(if t1 b1 t2 b2 ... els)` -
                              ; and `match` takes the rest. The keyword stays
                              ; reserved so old source gets `AX2004` with that
                              ; advice instead of an application of an undefined
                              ; variable, the way `begin` and `consume` do below.
                              (if (kwEq name "cond")
                                (pErrRemoved pos "cond")
                                (if (kwEq name "while")
                                  (parseWhileExpr tokens (advance pos))
                                  ; `for` is a KEYWORD and not a macro, and `stdlib/Pre.ax`'s `range`
                                  ; header records why: an expression macro has exactly ONE shape
                                  ; (MAC-LANG-14 - the rule form's templates are DECLARATIONS), and
                                  ; `for` has four, counted with its step and its element-index
                                  ; pair. Measured, range and container cannot even
                                  ; coexist as two macros: `stdlib/Html.ax` exported its own
                                  ; `(for x in xs body)` and a program importing it beside a range `for`
                                  ; resolved to Html's and answered `AX3001: undefined variable i`
                                  ; in the body rather than an ambiguity at the import. The container
                                  ; half additionally needs an ELEMENT type, which arrived with the
                                  ; parameterised `Vec`; this is the container loop in `docs/reference.md`. The typed element
                                  ; accessor makes the desugaring possible.
                                  ;
                                  ; The keyword span is passed through rather than recovered, exactly
                                  ; as the `alloc` arm below does: `advance pos` loses the token.
                                  (if (kwEq name "for")
                                    (parseForExpr tokens (advance pos) (tokenSpan kw))
                                    ; The keyword span is passed through, as the
                                    ; `alloc` arm below does: `advance pos` loses
                                    ; the token.
                                    (if (kwEq name "region")
                                      (parseRegionExpr tokens (advance pos) (tokenSpan kw))
                                      ; `parallel` is a KEYWORD for the reason `for` and `while` are:
                                      ; it binds names, and its binding list is not an
                                      ; expression. Desugared by `parseParallelExpr` into
                                      ; `let`s over the `__par_spawn`/`__par_join`
                                      ; primitives, so no AST tag was added and no consumer
                                      ; of one moves. The keyword span is passed through,
                                      ; as the `alloc` arm below does.
                                      (if (kwEq name "parallel")
                                        (parseParallelExpr tokens (advance pos) (tokenSpan kw))
                                        (if (kwEq name "set")
                                          (parseSetExpr tokens (advance pos))
                                          ; `struct` declares a type. A struct is built by
                                          ; calling its name, `(Pt 3 4)`, so the keyword in
                                          ; expression position is refused with that advice
                                          ; (AX2004) rather than read as an application.
                                          (if (kwEq name kwStruct)
                                            (pErrRemoved pos "struct")
                                            ; `consume` is RESERVED, not parsed. It was a
                                            ; parse-time IDENTITY that kept the `Linear`
                                            ; wrapper: consuming twice was accepted and the
                                            ; form reclaimed nothing. What reclaims is the
                                            ; reference counting every heap block carries.
                                            (if (kwEq name "consume")
                                              (pErrRemoved pos "consume")
                                              ; `begin` is RESERVED here for the same
                                              ; reason the other five are: it was the
                                              ; sequencing form, `{ }` replaced it, and
                                              ; until now it fell through to an
                                              ; application of a bare name and drew
                                              ; `AX3001 undefined variable begin` - a
                                              ; diagnostic that names no replacement and
                                              ; reads like a typo. `CHANGELOG.md`'s 0.2.0
                                              ; Compatibility section recorded exactly
                                              ; that gap.
                                              (if (kwEq name "begin")
                                                (pErrRemoved pos "begin")
                                                (if (kwEq name "alloc")
                                                  (pErrRemoved pos "alloc")
                                                  ; `define` is RESERVED in expression
                                                  ; position too: it was the old
                                                  ; spelling of `fn`, so old source
                                                  ; nests it, and falling through
                                                  ; would report `AX3001 undefined
                                                  ; variable define` - a typo read
                                                  ; on a keyword with a known
                                                  ; replacement.
                                                  (if (kwEq name kwDefine)
                                                    (pErrRemoved pos "define")
                                                    (if (kwEq name "handle")
                                                      (parseHandleExpr tokens (advance pos))
                                                      (parseAppForm tokens
                                                        pos)))))))))))))))))))))))
        }
      }
      (if (peekIs tokens pos TK_DOUBLE_COLON)
        (parseTypeSigExpr tokens (advance pos))
        (if (peekIs tokens pos TK_RPAREN)
          ; `()` in EXPRESSION position. This used to answer `(pOk 0 ...)` -
          ; a SUCCESSFUL parse whose node handle is 0, which is the handle
          ; every other producer in this file uses to mean "there is no node
          ; here". Nothing downstream guards it, because a successful parse
          ; is not supposed to be able to hand one over: `checkExpr` and
          ; `emitExpr` both dereference it, and the compiler died by signal
          ; with no diagnostic in twenty-three measured positions - seven of
          ; them inside `check`, which is what `axiom lsp` runs, so a
          ; document containing the two characters a user types before they
          ; type anything else killed the language server.
          ;
          ; A refusal, not a node: `()` is a TYPE (the empty tuple, see
          ; `parseTypeParens`) and there is no unit VALUE in the language -
          ; no literal produces one and nothing consumes one. Every sibling
          ; empty form already refuses exactly this way: `[]`, `(-> )`,
          ; `(* )`, `(set)`, `(alloc)`, `(consume)` are all AX2001 "expected
          ; expression". A bare `()` at the TOP level is a different form
          ; and stays skipped - `parse_module` dropped it, `parseDecls`
          ; drops it, and the formatter deletes it
          ; (`tests/fmt/parity/100-empty-form-dropped`).
          (pErrExp pos "expression")
          (parseAppForm tokens pos))))))

; `(:: expr Type)` - a type ascription in EXPRESSION position, which is
; not the same form as the top-level `(:: name Type)` declaration even
; though it is spelled with the same token. Only the declaration was
; parsed, so an ascribed expression reached `parseAppForm`, which asked
; for an expression, found `::`, and answered a bare `parse failed` with
; no span - a program stage0 compiles, refused by stage1 with nothing in
; the message to act on.
;
; It lowers to the `cast` spine rather than to a node of its own,
; because in stage0 the two forms are the same function: `check_expr`
; checks the inner expression and answers the written type for both
; (`axiom-sema/src/lib.rs:2825-2832`), and the IR generator is
; transparent for both (`axiom-ir/src/generator.rs:303-307`). Sharing
; the shape means no new case in the checker and none in the emitter,
; which is the pairing this compiler has already been bitten by: a
; checker taught a node the emitter does not know is a segfault, not a
; diagnostic.
;
; The synthetic head carries the *inner expression's* span, because
; stage0's `Expr::span()` for `ETypeSig` delegates to it, and `mkEApp`
; copies the head's span to the application.
; The source order is value, then type. The checking spine keeps its
; type slot first so type operands never enter the expression walk.
; A parsed type is lowered to the canonical type-operand spine used by
; explicit conversions. Type slots stay out of the value/ownership walk.
(pub :: typeExprAt (-> ASTNode Int ASTNode))
(pub fn (typeExprAt ty sp)
  {
    (let tag (nodeTag ty))
    (if (|| (== tag TAG_T_VAR) (== tag TAG_T_CON))
      (if (== tag TAG_T_VAR)
        (mkEVarAt (nodeAName ty) sp)
        (typeExprArgs (mkEVarAt (nodeAName ty) sp) (nodeBChildren ty) 0 sp))
      (if (== tag TAG_T_ARR)
        (typeExprArrow ty (mkEVarAt "->" sp) sp)
        (if (== tag TAG_T_PTR)
          (mkEApp (mkEVarAt "*" sp) (typeExprAt (nodeAChild ty) sp))
          (mkEUnitAt sp))))
  })

(pub :: typeExprArgs (-> ASTNode (Vec ASTNode) Int Int ASTNode))
(pub fn (typeExprArgs head args i sp)
  (if (>= i (vecLen args))
    head
    (typeExprArgs (mkEApp head (typeExprAt (vecGet args i) sp)) args (+ i 1) sp)))

(pub :: typeExprArrow (-> ASTNode ASTNode Int ASTNode))
(pub fn (typeExprArrow ty head sp)
  (if (== (nodeTag ty) TAG_T_ARR)
    (typeExprArrow (nodeBChild ty) (mkEApp head (typeExprAt (nodeAChild ty) sp)) sp)
    (mkEApp head (typeExprAt ty sp))))

(pub :: parseAsExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseAsExpr tokens pos)
  {
    (let value (parseExpr tokens pos))
    (match value
      ((ParseFailed parseError70) (ParseFailed parseError70))
      ((ParseSuccess parsedValue70 parsedPos70)
        {
          (let target (parseType tokens parsedPos70))
          (match target
            ((ParseFailed parseError71) (ParseFailed parseError71))
            ((ParseSuccess parsedValue71 parsedPos71)
              {
                (let after parsedPos71)
                (if (peekIs tokens after TK_RPAREN)
                  (pOk
                    (mkEApp
                      (mkEApp (mkEVarAt "__as_numeric" (tokenSpan (vecGet tokens (- pos 1))))
                        (typeExprAt parsedValue71 (tokenSpan (vecGet tokens parsedPos70))))
                      parsedValue70)
                    (advance after))
                  (pErrExp after "the end of an as expression"))
              }
            ))
        }
      ))
  })

(pub :: parseTypeSigExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseTypeSigExpr tokens pos)
  {
    (let er (parseExpr tokens pos))
    (match er
      ((ParseFailed parseError72) (ParseFailed parseError72))
      ((ParseSuccess parsedValue72 parsedPos72)
        {
          (let inner parsedValue72)
          (let tr (parseType tokens parsedPos72))
          (match tr
            ((ParseFailed parseError73) (ParseFailed parseError73))
            ((ParseSuccess parsedValue73 parsedPos73)
              {
                (let tyExpr (typeExprAt parsedValue73 (tokenSpan (vecGet tokens parsedPos72))))
                (let after parsedPos73)
                (if (peekIs tokens after TK_RPAREN)
                  (pOk (mkEApp (mkEApp (mkEVarAt "__ascribe" (nodeSpan inner)) tyExpr) inner)
                    (advance after))
                  (pErr after))
              }
            ))
        }
      ))
  })

; ------------------------------------------------------------------
; (while cond body...) - body takes any number of expressions.
; ------------------------------------------------------------------
(pub :: parseWhileExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseWhileExpr tokens pos)
  {
    (let condR (parseExpr tokens pos))
    (match condR
      ((ParseFailed parseError74) (ParseFailed parseError74))
      ((ParseSuccess parsedValue74 parsedPos74)
        ; Consumes the while form's closing paren.
        {
          (let cnd parsedValue74)
          (let bodyR (parseExprList tokens parsedPos74 vecNew))
          (match bodyR
            ((ParseFailed parseError75) (ParseFailed parseError75))
            ((ParseSuccess parsedValue75 parsedPos75)
              (pOk (nodeBuildEWhilePlain cnd parsedValue75 0) parsedPos75)
            ))
        }
      ))
  })

; ------------------------------------------------------------------
; (for i in lo..hi body) - the counted loop - and (for x in xs body) - the
; container loop. ONE keyword, FOUR shapes, and `in` always follows the
; binder.
;
; A parser knows no types, so the shapes are told apart by marks: `..`
; after the first operand makes a range, and `by` after a range's end
; gives its step. The binder is a name, or an element-index pair `(x i)`
; for the container shape only - a range counts its own index. Exactly
; ONE body expression in all four, and that is forced rather than
; chosen: a variadic body would make `(for x in xs a b)` ambiguous.
; `{ ... }` sequences several.
;
; DESUGARED HERE, into nodes that already exist. A new AST tag would
; cost edits in `expand.ax` (substTpl and expandExpr), `typecheck.ax`,
; `codegen.ax` and `lsp.ax`; `let`/`while`/`set` cost none of them, and
; the IR a `for` emits is by construction the IR the hand-written loop
; already emitted.
;
;   (for i in LO..HI BODY)
;     => (let ((for$lo LO))
;          (let ((for$n HI))
;            (let ((mut for$i for$lo))
;              { (while (< for$i for$n)
;                  { (let ((i for$i)) BODY)
;                    (set for$i (+ for$i 1)) })
;                0 })))
;
;   (for i in LO..HI by STEP BODY)
;     => (let ((for$lo LO))
;          (let ((for$hi HI))
;            (let ((for$step STEP))
;              (let ((mut for$i for$lo))
;                { (while (if (> for$step 0) (< for$i for$hi) (> for$i for$hi))
;                    { (let ((i for$i)) BODY)
;                      (set for$i (+ for$i for$step)) })
;                  0 }))))
;
; A positive step counts up to `hi`, a negative one down to it; the
; direction is read off the bound step's sign once per iteration,
; which is one comparison against the counter the loop already pays.
; The three-operand range is unchanged by this: `(for c in 7..3 ...)`
; still runs zero times (466 term 3), and counting down spells the
; step. A literal step of `0` is refused where it stands - it never
; advances the counter - while a computed zero is the author's own
; `while`-shaped footgun, exactly as a `while` whose condition never
; changes is.
;
;   (for x in XS BODY)
;     => (let ((for$v XS))
;          (let ((mut for$i 0))
;            (let ((for$n (Vec$vecLen for$v)))
;              { (while (< for$i for$n)
;                  { (let ((x (Vec$vecGet for$v for$i))) BODY)
;                    (set for$i (+ for$i 1)) })
;                0 })))
;
;   (for (x k) in XS BODY)
;     => the container, with `(let ((k for$i)) BODY)` inside the
;        element `let`, so the index reads like any other binding -
;        hover, rename and capture all follow the `let` they land on.
;
; The range shape mirrors `range`'s template binding for binding, so
; the macro and the keyword provably agree. All four answer 0.
;
; BOTH ENDS ARE READ ONCE, before the loop. That is a CORRECTNESS
; property and not a speed one: the shape this replaces,
;
;   (let ((mut i 0)) (while (< i (vecLen xs)) { BODY (set i (+ i 1)) }))
;
; re-reads `(vecLen xs)` every iteration, so a body that pushes onto
; `xs` is a loop whose length moves under it. `tests/stdlib/466-for-loop.ax`
; terms 4 and 5 pin it for both shapes, and reading the bound inside the
; `while` condition instead turns them red.
;
; HYGIENE WITHOUT A RENAMER. The parser has no gensym and does not need
; one: `$` is `AX1001 unexpected character` inside an identifier
; (measured), so `for$lo`, `for$hi`, `for$step`, `for$v`, `for$i` and
; `for$n` are names a user cannot write and therefore cannot capture. This is the
; same trick `Mod$name` already uses for a qualified reference. Nesting
; is safe with fixed names because an inner `for`'s bindings are
; visible only inside the inner body, where nothing refers to the
; outer's. `tests/stdlib/466-for-loop.ax` term 6 is the live test: it
; binds a caller's own `i`, `n` and `v` around a loop and prints them
; after (the `Html` fixture that held the same check left with it).
;
; THE ELEMENT READ IS QUALIFIED, NOT BARE. `Vec$vecLen`/`Vec$vecGet` is
; the mangled spelling `mangledFromChain` gives `Vec::vecLen`, and it is
; what a generated body must use for the same reason the `show` rewrite
; does: a bare `vecLen` is CAPTURED by an entry file's own function of
; that name (measured - it drew AX3004 against the user's), and the
; qualified one is not. It resolves transitively, so a file that imports
; only `IO` still gets `Vec`'s; a program with no path to `Vec` at all
; gets `AX3001 undefined variable Vec::vecLen` at the `for`'s span,
; which is a diagnostic rather than a silence.
;
; Every generated node carries the KEYWORD's span except the user's own
; binder `let`, which carries the binder token's, so hover and rename
; land on the text the user wrote.
; ------------------------------------------------------------------
(pub :: parseForExpr (-> Tokens Int Int (PResult ASTNode)))
(pub fn (parseForExpr tokens pos kwSpan)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let at (advance pos))
      (if (forHasIn tokens at)
        (parseForOperands tokens (advance at) 0 (tokenLexeme (vecGet tokens pos))
          (tokenSpan (vecGet tokens pos)) "" 0 kwSpan)
        (pErrForIn at))
    }
    (if (peekIs tokens pos TK_LPAREN)
      ; An element-index pair `(x i)`: two identifiers and the close.
      ; Parsed inline - five values do not fit `pOk`'s two slots - so
      ; every misspelling below still knows the shape it was reaching
      ; for.
      {
        (let xPos (advance pos))
        (if (peekIs tokens xPos TK_IDENT)
          {
            (let iPos (advance xPos))
            (if (peekIs tokens iPos TK_IDENT)
              {
                (let endPos (advance iPos))
                (if (peekIs tokens endPos TK_RPAREN)
                  {
                    (let at (advance endPos))
                    (if (forHasIn tokens at)
                      (parseForOperands tokens (advance at) 1 (tokenLexeme (vecGet tokens xPos))
                        (tokenSpan (vecGet tokens xPos)) (tokenLexeme (vecGet tokens iPos))
                        (tokenSpan (vecGet tokens iPos)) kwSpan)
                      (pErrForIn at))
                  }
                  (pErrExp endPos
                    "`)` to close the binder pair: `(for (x i) in xs body)` binds the element to `x` and its index to `i`"))
              }
              (pErrExp iPos
                "the index name: `(for (x i) in xs body)` binds the element to `x` and its index to `i`"))
          }
          (pErrExp xPos
            "the element name: `(for (x i) in xs body)` binds the element to `x` and its index to `i`"))
      }
      (pErrExp pos "the name to bind, or an element-index pair `(x i)`"))))

; `in` follows the binder in every shape: `(for x in xs body)`,
; `(for (x i) in xs body)`, `(for i in lo..hi body)`. It is a word only
; there, so `in` stays an ordinary name everywhere else (an `asm`
; operand is `(in name value)`). Right after a binder it is always
; this word, so a variable named `in` can't be the first operand.
(pub :: forHasIn (-> Tokens Int Bool))
(pub fn (forHasIn tokens pos)
  (&& (peekIs tokens pos TK_IDENT) (strEq (tokenLexeme (vecGet tokens pos)) "in")))

; A `for` whose binder is not followed by `in`. The diagnostic is
; `forInDiag`'s, which offers the insertion.
(pub :: pErrForIn (-> Int (PResult a)))
(pub fn (pErrForIn p)
  (pErrCode p "for-in"))

; The operands after the binder, in every arity. A shortfall AT the
; closing paren draws the shape - the operand that is not there is the
; shape's question to answer - while a genuinely broken operand keeps
; the generic refusal, which is about the operand rather than the
; loop. `isPair` is 1 for an `(x i)` binder, which takes the container
; shape only: a range counts its own index.
(pub :: parseForOperands (-> Tokens Int Int String Int String Int Int (PResult ASTNode)))
(pub fn (parseForOperands tokens pos isPair xName xSpan iName iSpan kwSpan)
  {
    (let aR (parseExpr tokens pos))
    (match aR
      ((ParseFailed parseError76)
        (if (peekIs tokens pos TK_RPAREN)
          (pErrExp pos
            "the rest of the `for` shape: `(for x in xs body)`, `(for (x i) in xs body)`, `(for i in lo..hi body)` or `(for i in lo..hi by step body)`, and `{ ... }` sequences several")
          (ParseFailed parseError76))
      )
      ((ParseSuccess parsedValue76 parsedPos76)
        (if (forAtDotDot tokens parsedPos76)
          (if (== isPair 1)
            (pErrExp parsedPos76
              "the container: an element-index binder `(x i)` takes the container shape only, `(for (x i) in xs body)`, because a range counts its own index")
            (parseForRange tokens (advance (advance parsedPos76)) xName xSpan parsedValue76 kwSpan))
          {
            (let bR (parseForBody tokens parsedPos76))
            (match bR
              ((ParseFailed parseError77) (ParseFailed parseError77))
              ((ParseSuccess parsedValue77 parsedPos77)
                (pOk
                  (if (== isPair 1)
                    (mkForContainerIndexed xName xSpan iName iSpan parsedValue76 parsedValue77
                      kwSpan)
                    (mkForContainer xName xSpan parsedValue76 parsedValue77 kwSpan))
                  parsedPos77)
              ))
          })
      ))
  })

; Two dots between operands: `lo..hi`. The lexer makes each a `.`,
; and a field access needs a name after its dot, so `lo..hi`,
; `0..(strLen s)` and `p.x..p.y` all reach here with both dots
; unconsumed.
(pub :: forAtDotDot (-> Tokens Int Bool))
(pub fn (forAtDotDot tokens pos)
  (&& (peekIs tokens pos TK_DOT) (peekIs tokens (advance pos) TK_DOT)))

; The range shapes, from just after `..`: `hi`, then either the body or
; `by step` and the body. `lo` is already parsed.
(pub :: parseForRange (-> Tokens Int String Int ASTNode Int (PResult ASTNode)))
(pub fn (parseForRange tokens pos xName xSpan lo kwSpan)
  {
    (let hR (parseExpr tokens pos))
    (match hR
      ((ParseFailed parseError78)
        (if (peekIs tokens pos TK_RPAREN)
          (pErrExp pos
            "the end of the range: `(for i in lo..hi body)` counts from `lo` up to, but not including, `hi`")
          (ParseFailed parseError78))
      )
      ((ParseSuccess parsedValue78 parsedPos78)
        {
          (let afterHi parsedPos78)
          (if (&& (peekIs tokens afterHi TK_IDENT)
                (strEq (tokenLexeme (vecGet tokens afterHi)) "by"))
            {
              (let sR (parseExpr tokens (advance afterHi)))
              (match sR
                ((ParseFailed parseError79)
                  (if (peekIs tokens (advance afterHi) TK_RPAREN)
                    (pErrExp (advance afterHi)
                      "the step after `by`: `(for i in lo..hi by step body)`")
                    (ParseFailed parseError79))
                )
                ((ParseSuccess parsedValue79 parsedPos79)
                  {
                    (let step parsedValue79)
                    (if (&& (== (nodeTag step) TAG_E_INT) (== (nodeA step) 0))
                      (pErrExp (advance afterHi)
                        "a nonzero step: a step of `0` never advances the counter")
                      {
                        (let bR (parseForBody tokens parsedPos79))
                        (match bR
                          ((ParseFailed parseError80) (ParseFailed parseError80))
                          ((ParseSuccess parsedValue80 parsedPos80)
                            (pOk
                              (mkForRangeStep xName xSpan lo parsedValue78 step parsedValue80
                                kwSpan)
                              parsedPos80)
                          ))
                      })
                  }
                ))
            }
            {
              (let bR (parseForBody tokens afterHi))
              (match bR
                ((ParseFailed parseError81) (ParseFailed parseError81))
                ((ParseSuccess parsedValue81 parsedPos81)
                  (pOk (mkForRange xName xSpan lo parsedValue78 parsedValue81 kwSpan) parsedPos81)
                ))
            })
        }
      ))
  })

; The body of a `for` and its closing paren: the body node, and the
; position after the paren.
(pub :: parseForBody (-> Tokens Int (PResult ASTNode)))
(pub fn (parseForBody tokens pos)
  {
    (let bR (parseExpr tokens pos))
    (match bR
      ((ParseFailed parseError82)
        (if (peekIs tokens pos TK_RPAREN)
          (pErrExp pos "the loop's body: `{ ... }` sequences several expressions")
          (ParseFailed parseError82))
      )
      ((ParseSuccess parsedValue82 parsedPos82)
        (if (peekIs tokens parsedPos82 TK_RPAREN)
          (pOk parsedValue82 (advance parsedPos82))
          (pErrExp parsedPos82
            "`)`: a `for` has exactly one body expression, and `{ ... }` sequences several"))
      ))
  })

; A two-argument call, `(f a b)`, as the left spine an application
; already is. `mkEApp` copies the head's span, so the whole call
; reports at `sp`.
(pub :: mkForCall2 (-> String ASTNode ASTNode Int ASTNode))
(pub fn (mkForCall2 f a b sp)
  (mkEApp (mkEApp (mkEVarAt f sp) a) b))

; A two-element `(Vec Int)` of node handles. Written as a declared
; function rather than `(vecPush (vecPush vecNew a) b)` inline so the
; element type is pinned by the SIGNATURE: a let-bound container is
; pinned by its first use (`scripts/check-type-pinning.sh`), and a
; generated one that is never used at a second type has nothing to pin
; it.
(pub :: forSeq2 (-> ASTNode ASTNode (Vec ASTNode)))
(pub fn (forSeq2 a b)
  {
    (let v vecNew)
    {
      (vecPush v a)
      (vecPush v b)
      v
    }
  })

; The shared tail of all four shapes: the `while` whose body binds
; the user's name to the element and then bumps the counter, followed
; by the `0` that is a `for`'s value.
;
; `cond` and `bump` are parameters rather than fixed comparisons for
; the same reason `bound` was one: this file must be able to get the
; loop's control wrong in a reviewable way. Every caller builds them
; from references to bindings made BEFORE the loop - `for$n` for the
; plain shapes, `for$hi` and `for$step` for the stepped range - never
; from the un-hoisted expressions, which is the hand-written loop this
; keyword replaces, and the ablation `tests/stdlib/466-for-loop.ax`
; terms 4 and 5 are written to catch.
(pub :: forWhileBody (-> String Int ASTNode ASTNode ASTNode ASTNode Int (Vec ASTNode)))
(pub fn (forWhileBody bindName bindSpan elem cond bump body kwSpan)
  (forSeq2
    (nodeBuildEWhilePlain cond
      (forSeq2 (mkELetAt bindName elem body bindSpan) (nodeBuildESet "for$i" bump 0 kwSpan)) 0)
    (mkEInt 0)))

; The plain loop control both old shapes share: against `for$n`, up by
; one. Built by the caller so the stepped range, whose control reads
; two hoisted bindings instead of one, shares the tail below.
(pub :: forUpByOne (-> Int (Vec ASTNode)))
(pub fn (forUpByOne kwSpan)
  (forSeq2 (mkForCall2 "<" (mkEVarAt "for$i" kwSpan) (mkEVarAt "for$n" kwSpan) kwSpan)
    (mkForCall2 "+" (mkEVarAt "for$i" kwSpan) (mkEInt 1) kwSpan)))

; (for i in LO..HI BODY). `for$lo` and `for$n` are bound in source order and
; before the loop, so each end is computed ONCE.
(pub :: mkForRange (-> String Int ASTNode ASTNode ASTNode Int ASTNode))
(pub fn (mkForRange bindName bindSpan lo hi body kwSpan)
  {
    (let ctl (forUpByOne kwSpan))
    (mkELetAt "for$lo" lo
      (mkELetAt "for$n" hi
        (nodeBuildELetm "for$i" (mkEVarAt "for$lo" kwSpan)
          (mkEBegin
            (forWhileBody bindName bindSpan (mkEVarAt "for$i" kwSpan) (vecGet ctl 0) (vecGet ctl 1)
              body kwSpan))
          kwSpan)
        kwSpan)
      kwSpan)
  })

; (for i in LO..HI by STEP BODY). `for$step` joins the hoisted bindings, bound
; beside the ends in source order. The condition reads its sign: up
; while below `hi`, down while above it.
(pub :: mkForRangeStep (-> String Int ASTNode ASTNode ASTNode ASTNode Int ASTNode))
(pub fn (mkForRangeStep bindName bindSpan lo hi step body kwSpan)
  (mkELetAt "for$lo" lo
    (mkELetAt "for$hi" hi
      (mkELetAt "for$step" step
        (nodeBuildELetm "for$i" (mkEVarAt "for$lo" kwSpan)
          (mkEBegin
            (forWhileBody bindName bindSpan (mkEVarAt "for$i" kwSpan)
              (mkEIf (mkForCall2 ">" (mkEVarAt "for$step" kwSpan) (mkEInt 0) kwSpan)
                (mkForCall2 "<" (mkEVarAt "for$i" kwSpan) (mkEVarAt "for$hi" kwSpan) kwSpan)
                (mkForCall2 ">" (mkEVarAt "for$i" kwSpan) (mkEVarAt "for$hi" kwSpan) kwSpan))
              (mkForCall2 "+" (mkEVarAt "for$i" kwSpan) (mkEVarAt "for$step" kwSpan) kwSpan) body
              kwSpan))
          kwSpan)
        kwSpan)
      kwSpan)
    kwSpan))

; (for x in XS BODY). `for$v` holds the container so `XS` is evaluated once
; even when it is a call, and `for$n` its length so the bound is read
; once - the property `tests/stdlib/466-for-loop.ax` term 5 pins.
;
; The `for$v` reference inside the LENGTH call carries `XS`'s own span
; rather than the keyword's, because that is the node AX3004 anchors on
; when the thing being iterated is not a container: `(for x in n body)`
; over an `Int` underlines `n`, not the word `for`. The element read's
; reference keeps the keyword's span deliberately. The checker does not
; poison a binding after one bad use, so both references report, and two
; rows carrying the SAME message at the SAME span read as a compiler bug
; rather than as two uses; measured, that is exactly what giving both
; `XS`'s span produced. `tests/diagnostics/626-for-not-a-container`
; holds the eight rows: two per site over an `Int`, a `String` and a
; `Map`, each pair naming what fits.
(pub :: mkForContainer (-> String Int ASTNode ASTNode Int ASTNode))
(pub fn (mkForContainer bindName bindSpan xs body kwSpan)
  {
    (let ctl (forUpByOne kwSpan))
    (mkELetAt "for$v" xs
      (nodeBuildELetm "for$i" (mkEInt 0)
        (mkELetAt "for$n" (mkEApp (mkEVarAt "Vec$vecLen" kwSpan) (mkEVarAt "for$v" (nodeSpan xs)))
          (mkEBegin
            (forWhileBody bindName bindSpan
              (mkForCall2 "Vec$vecGet" (mkEVarAt "for$v" kwSpan) (mkEVarAt "for$i" kwSpan) kwSpan)
              (vecGet ctl 0) (vecGet ctl 1) body kwSpan))
          kwSpan)
        kwSpan)
      kwSpan)
  })

; (for (x k) in XS BODY). The container with its index: the element `let`
; outside, the index `let` inside, each carrying its own binder
; token's span, so hover and rename land on the text the user wrote.
(pub :: mkForContainerIndexed (-> String Int String Int ASTNode ASTNode Int ASTNode))
(pub fn (mkForContainerIndexed bindName bindSpan idxName idxSpan xs body kwSpan)
  {
    (let ctl (forUpByOne kwSpan))
    (mkELetAt "for$v" xs
      (nodeBuildELetm "for$i" (mkEInt 0)
        (mkELetAt "for$n" (mkEApp (mkEVarAt "Vec$vecLen" kwSpan) (mkEVarAt "for$v" (nodeSpan xs)))
          (mkEBegin
            (forWhileBody bindName bindSpan
              (mkForCall2 "Vec$vecGet" (mkEVarAt "for$v" kwSpan) (mkEVarAt "for$i" kwSpan) kwSpan)
              (vecGet ctl 0) (vecGet ctl 1)
              (mkELetAt idxName (mkEVarAt "for$i" kwSpan) body idxSpan) kwSpan))
          kwSpan)
        kwSpan)
      kwSpan)
  })

; ------------------------------------------------------------------
; (region r EXPR) - an allocation scope with a lexical extent, MM-RGN-1
; of docs/memory-model.md §3.6. The runtime it runs on is the
; arena the compiler already emits: the allocator's waterline is read
; at entry and rolled back at exit (`emitRegion`), so everything the
; body allocated is reclaimed in one pointer move, and the body's
; VALUE is what the form answers.
;
; ONE body expression, as `let` has one: `{ ... }` sequences several,
; and the name is what the form is for. The name is bound over the
; body's dynamic extent. Its name identifies the scope in diagnostics.
; in TYPE position is S3's - but the checker keeps the stack of open
; regions that S3 will resolve against, and a nested region reusing an
; enclosing one's name is refused there (AX3058) rather than left to
; shadow it.
;
; `region` was REMOVED on the strength of an inference that was then
; withdrawn (docs/memory-model.md §3.4). Measured before this
; arm existed: `(region r 0)` in expression position drew `AX3001
; undefined variable region` and a second AX3001 for `r` - the AX2004
; arm with its "lifetimes are inferred" advice fired only at the TOP
; level, where a region never belonged. Both are gone: `parseTopForm`
; no longer names the word, and the expression is this.
; ------------------------------------------------------------------
(pub :: parseRegionExpr (-> Tokens Int Int (PResult ASTNode)))
(pub fn (parseRegionExpr tokens pos kwSpan)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let nameTok (vecGet tokens pos))
      (let bodyR (parseExpr tokens (advance pos)))
      (match bodyR
        ((ParseFailed parseError83) (ParseFailed parseError83))
        ((ParseSuccess parsedValue83 parsedPos83)
          (if (peekIs tokens parsedPos83 TK_RPAREN)
            (pOk (nodeBuildERegion (tokenLexeme nameTok) parsedValue83 (tokenSpan nameTok) kwSpan)
              (advance parsedPos83))
            (pErrExp parsedPos83
              "`)` - `region` takes ONE body: `(region r body)`, and `{ ... }` sequences several"))
        ))
    }
    (pErrExp pos "the region's name")))

; ------------------------------------------------------------------
; (parallel p ((a e1) (b e2) ...) body...) - MM-RGN-7 of
; docs/memory-model.md: every binding's expression runs
; BESIDE the caller, each in a region of its own; the results are
; bound, in ARGUMENT ORDER, and the body runs with them.
;
; DESUGARED HERE, into nodes that already exist, the way `for` is:
;
;   (parallel p ((a E1) (b E2)) BODY)
;     => (let ((p 0))
;          (let ((parallel$h0 (__par_spawn (lambda (parallel$_) E1) 0)))
;            (let ((parallel$h1 (__par_spawn (lambda (parallel$_) E2) 0)))
;              (let ((a (__par_join parallel$h0)))
;                (let ((b (__par_join parallel$h1)))
;                  BODY)))))
;
; EVERY SPAWN BEFORE ANY JOIN, so the bindings overlap; then EVERY JOIN
; IN THE ORDER WRITTEN, so `a` is bound before `b` whichever finished
; first - MM-PAR-5's rule, the one every byte-comparing gate in this
; repository rests on. Completion order is not observable through this
; form at all, which is the point.
;
; `p` NAMES THE FORM, and is bound to the word 0. It will be the
; witness §2.5 of the design says a region carries, once S2 and S3 give
; the form a region (MM-RGN-7). It was bound to `__axiom_arena_mark`,
; which allocates a 24-byte cell nothing ever freed: every form leaked
; 48 bytes of arena, 960,000 over 20,000 forms in either lowering, and a
; server that ran one per request grew without bound
; (`scripts/check-parallel.sh` section 13 holds it flat). No program
; read the mark, and a reset to it inside the body would have freed the
; form's own borrow record.
;
; WHAT A BINDING MAY ANSWER is a word: the thunk is `(-> Int Int)` and
; `__par_join` answers `Int`, so a binding whose expression is a
; `String` draws `AX3004: expected Int` AT THAT EXPRESSION. Codegen's
; header (`emitPrimPar`) says why the limit is there and what lifts it.
;
; The lambda's parameter and the handle names carry a `$`, which is
; `AX1001 unexpected character` inside an identifier, so a user cannot
; write them and the desugaring captures nothing of theirs -
; `parseForExpr`'s hygiene, for the same reason. The handle names are
; numbered so two bindings never share one; the parameter is never
; referenced and one name serves.
;
; ONE OR MORE BODY EXPRESSIONS, sequenced, as `let` takes them.
; ------------------------------------------------------------------
(pub :: parseParallelExpr (-> Tokens Int Int (PResult ASTNode)))
(pub fn (parseParallelExpr tokens pos kwSpan)
  (if (peekIs tokens pos TK_IDENT)
    {
      (let nameTok (vecGet tokens pos))
      (let rname (tokenLexeme (vecGet tokens pos)))
      (if (peekIs tokens (advance pos) TK_LPAREN)
        {
          (let br (parseParBindings tokens (advance (advance pos)) vecNew))
          (match br
            ((ParseFailed parseError84) (ParseFailed parseError84))
            ((ParseSuccess parsedValue84 parsedPos84)
              {
                (let binds parsedValue84)
                (let afterBinds parsedPos84)
                (if (== (vecLen binds) 0)
                  (pErrExp (- afterBinds 1)
                    "at least one binding - `(parallel p ((x e)) body)` runs `e` beside the caller")
                  {
                    (let bodyR (parseExprList tokens afterBinds vecNew))
                    (match bodyR
                      ((ParseFailed parseError85) (ParseFailed parseError85))
                      ((ParseSuccess parsedValue85 parsedPos85)
                        {
                          (let exprs parsedValue85)
                          (let afterBody parsedPos85)
                          (if (== (vecLen exprs) 0)
                            (pErrExp afterBinds "a body expression after the binding list")
                            (pOk
                              (mkParallel rname (tokenSpan nameTok) binds
                                (if (== (vecLen exprs) 1)
                                  (vecGet exprs 0)
                                  (mkEBegin exprs))
                                kwSpan pos)
                              afterBody))
                        }
                      ))
                  })
              }
            ))
        }
        (pErrExp (advance pos) "`(` opening the binding list - `(parallel p ((x e) ...) body)`"))
    }
    (pErrExp pos "the name of the join region - `(parallel p ((x e) ...) body)`")))

; The binding list `((x e) ...)`, each pair carried as a TAG_NIL node
; with a=name and b=expression, the NAME token's span, as
; a local declaration does. Parallel bindings are immutable at their join.
(pub :: parseParBindings (-> Tokens Int (Vec ASTNode) (PResult Nodes)))
(pub fn (parseParBindings tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_LPAREN)
      (if (peekIs tokens (advance pos) TK_IDENT)
        {
          (let nt (vecGet tokens (advance pos)))
          (let nm (tokenLexeme (vecGet tokens (advance pos))))
          (if (strEq nm "mut")
            (pErrExp (advance pos)
              "a binding name - a `parallel` binding is bound once, at its join, so `mut` has nothing to mean here")
            {
              (let valR (parseExpr tokens (advance (advance pos))))
              (match valR
                ((ParseFailed parseError86) (ParseFailed parseError86))
                ((ParseSuccess parsedValue86 parsedPos86)
                  (if (peekIs tokens parsedPos86 TK_RPAREN)
                    (parseParBindings tokens (advance parsedPos86)
                      (vecPush acc (nodeBuildParallelBinding nm parsedValue86 (tokenSpan nt))))
                    (pErrExp parsedPos86
                      "`)` - a `parallel` binding is one name and one expression"))
                ))
            })
        }
        (pErrExp (advance pos) "a binding name"))
      (pErrExp pos "`(name expr)` or `)` closing the binding list"))))

; THE BORROW SCOPE (MM-PAR-6b). Around the spawns and the joins sits
; one borrow record, named for this form (`parallel$b` and the form's
; number, as its thunks' parameter is `parallel$_` and the same number).
; The number is the index of the form's first token after `parallel`,
; which the same source always gives: a span would do as well within a
; file, but the span word carries more than a position, and the first
; version built from it named the same lambda's parameter differently
; on two compiles (check-reproducible). An index is unique within a
; file, and the checker only matches a form's thunks to it while that
; file's forms are being checked.
; Before any thunk is built, `(parallel$lends b {})` lends it the
; strings the bindings borrow: the checker fills the block with each
; `String` a thunk of this form captures (`capBorrowLend`), and codegen
; freezes each one's count and every count it reaches. After the last
; join, `parallel$return` puts every count back, before BODY runs. So a
; binding may read a `String` its parent holds, and no retain or
; release a binding makes reaches the parent's counts. The parent runs
; nothing between the lends and the return but spawns and joins, which
; is what makes the scope sound, and why a hand-written `__par_spawn`
; gets no such record.
(pub :: mkParallel (-> String Int (Vec ASTNode) ASTNode Int Int ASTNode))
(pub fn (mkParallel rname rspan binds body kwSpan formPos)
  {
    (let id (parIndexName formPos))
    {
      (let bname (concat "parallel$b" id))
      (mkELetAt rname (mkEInt 0)
        (mkELetAt bname (mkEApp (mkEVarAt "parallel$borrow" kwSpan) (mkEInt 0))
          (mkELetAt "parallel$l"
            (mkEApp (mkEApp (mkEVarAt "parallel$lends" kwSpan) (mkEVarAt bname kwSpan))
              (mkEBegin vecNew))
            (parSpawnLets binds 0
              (parJoinLets binds 0
                (mkELetAt "parallel$r"
                  (mkEApp (mkEVarAt "parallel$return" kwSpan) (mkEVarAt bname kwSpan)) body kwSpan)
                kwSpan)
              kwSpan id)
            kwSpan)
          kwSpan)
        rspan)
    }
  })

; The spawns, outermost first, so the first binding starts first.
(pub :: parSpawnLets (-> (Vec ASTNode) Int ASTNode Int String ASTNode))
(pub fn (parSpawnLets binds i inner kwSpan id)
  (if (>= i (vecLen binds))
    inner
    (mkELetAt (parHandleName i) (parSpawnCall (nodeBChild (vecGet binds i)) kwSpan id)
      (parSpawnLets binds (+ i 1) inner kwSpan id) kwSpan)))

; The joins, outermost first, so `a` is bound before `b`. Each carries
; its binder token's span, so hover and rename land on what was written.
(pub :: parJoinLets (-> (Vec ASTNode) Int ASTNode Int ASTNode))
(pub fn (parJoinLets binds i body kwSpan)
  (if (>= i (vecLen binds))
    body
    {
      (let b (vecGet binds i))
      (mkELetAt (nodeAName b)
        (mkEApp (mkEVarAt "__par_join" kwSpan) (mkEVarAt (parHandleName i) kwSpan))
        (parJoinLets binds (+ i 1) body kwSpan) (nodeSpan b))
    }))

; `(__par_spawn (lambda (parallel$_) E) 0)`. The lambda carries E's OWN
; span, because that is the node the checker anchors a mismatch on: a
; binding that answers a `String` is `AX3004: expected (Int -> Int),
; found (_a -> String)` underlining the expression the author wrote,
; not the word `parallel` (`tests/diagnostics/641-parallel-word`).
(pub :: parSpawnCall (-> ASTNode Int String ASTNode))
(pub fn (parSpawnCall e kwSpan id)
  {
    (let ps vecNew)
    {
      (vecPush ps (concat "parallel$_" id))
      (mkEApp (mkEApp (mkEVarAt "__par_spawn" kwSpan) (mkLamCurried ps e (nodeSpan e))) (mkEInt 0))
    }
  })

; `parallel$h0`, `parallel$h1`, ... `parallel$hz`, `parallel$h10`: the
; index in base 36 with the digits and the lowercase letters, which is
; what LLVM admits in a name and what this file has to hand without an
; import - `Str` has no decimal renderer, `Fmt` is not imported here.
; Only names this module imports: a bare name resolves through the
; entry file's imports, and `tests/selfhost/280-parse.ax` imports this
; module without codegen (`check-diagnostics.sh` compiles the
; compiler's own sources one module at a time and found the capture).
(pub :: parHandleName (-> Int String))
(pub fn (parHandleName i)
  (concat "parallel$h" (parIndexName i)))

(pub :: parIndexName (-> Int String))
(pub fn (parIndexName i)
  (if (< i 36)
    (strFromByte
      (if (< i 10)
        (+ 48 i)
        (+ 87 i)))
    (concat (parIndexName (/ i 36)) (parIndexName (% i 36)))))

; ------------------------------------------------------------------
; (handle body (Effect...) handler) - stage0's parse_handle. The
; effect list is OPTIONAL: stage0 only reads one when the next token
; opens a paren, and otherwise goes straight to the handler.
;
; Each effect name is kept as a TAG_E_VAR node so it carries its own
; span; AX3016 and AX3017 both anchor at the name, not at the form.
; ------------------------------------------------------------------
(pub :: parseHandleExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseHandleExpr tokens pos)
  {
    (let bodyR (parseExpr tokens pos))
    (match bodyR
      ((ParseFailed parseError87) (ParseFailed parseError87))
      ((ParseSuccess parsedValue87 parsedPos87)
        {
          (let effsR
            (if (peekIs tokens parsedPos87 TK_LPAREN)
              (parseEffectNames tokens (advance parsedPos87) vecNew)
              (pOk vecNew parsedPos87)))
          (match effsR
            ((ParseFailed parseError88) (ParseFailed parseError88))
            ((ParseSuccess parsedValue88 parsedPos88)
              {
                (let hR (parseExpr tokens parsedPos88))
                (match hR
                  ((ParseFailed parseError89) (ParseFailed parseError89))
                  ((ParseSuccess parsedValue89 parsedPos89)
                    (if (peekIs tokens parsedPos89 TK_RPAREN)
                      (pOk (nodeBuildEHandlePlain parsedValue87 parsedValue88 parsedValue89)
                        (advance parsedPos89))
                      (pErr parsedPos89))
                  ))
              }
            ))
        }
      ))
  })

; The names inside a handle's effect list, each as a spanned var node.
(pub :: parseEffectNames (-> Tokens Int (Vec ASTNode) (PResult Nodes)))
(pub fn (parseEffectNames tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_IDENT)
      {
        (let t (vecGet tokens pos))
        {
          (vecPush acc (mkEVarAt (tokenLexeme t) (tokenSpan t)))
          (parseEffectNames tokens (advance pos) acc)
        }
      }
      (pErr pos))))

; ------------------------------------------------------------------
; (set name value) - a store into a `mut` binding. The field form
; `(set r.field v)` needs storage stage1 does not model; the dot after
; the name makes this a parse error rather than a miscompile.
; ------------------------------------------------------------------
(pub :: parseSetExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseSetExpr tokens pos)
  ; stage0 names what a `set` target IS here rather than inheriting
  ; the generic "identifier" its own ident parser would give.
  {
    (let nr (parseIdentName tokens pos))
    (match nr
      ((ParseFailed parseError90)
        (pErrExp (pResPos (ParseFailed parseError90))
          "the name of a `mut` binding, or a field path")
      )
      ((ParseSuccess parsedValue90 parsedPos90)
        (if (peekIs tokens parsedPos90 TK_DOT)
          ; A dotted target is a field store: the chain builds the
          ; base the same way expression-position access does, and
          ; the LAST segment names the field written.
          (parseSetField tokens parsedPos90
            (mkEVarAt parsedValue90 (tokenSpan (vecGet tokens pos))))
          {
            (let valR (parseExpr tokens parsedPos90))
            (match valR
              ((ParseFailed parseError91) (ParseFailed parseError91))
              ((ParseSuccess parsedValue91 parsedPos91)
                {
                  (let val parsedValue91)
                  (let afterVal parsedPos91)
                  (if (peekIs tokens afterVal TK_RPAREN)
                    ; The node's span is its TARGET's - stage0
                    ; points both AX3001 and AX3012 about a `set`
                    ; at the name being assigned, not at the form.
                    (pOk (nodeBuildESet parsedValue90 val 0 (tokenSpan (vecGet tokens pos)))
                      (advance afterVal))
                    (pErr afterVal))
                }
              ))
          })
      ))
  })

; At a `.`: if another `.` follows the field, the field folds into the
; base; otherwise it is the store target and the value follows.
(pub :: parseSetField (-> Tokens Int ASTNode (PResult ASTNode)))
(pub fn (parseSetField tokens pos base)
  (if (&& (peekIs tokens pos TK_DOT) (peekIs tokens (advance pos) TK_IDENT))
    {
      (let fname (tokenLexeme (vecGet tokens (advance pos))))
      (let after (advance (advance pos)))
      (if (peekIs tokens after TK_DOT)
        (parseSetField tokens after
          (nodeBuildEField base fname 0 (tokenSpan (vecGet tokens (advance pos)))))
        {
          (let valR (parseExpr tokens after))
          (match valR
            ((ParseFailed parseError92) (ParseFailed parseError92))
            ((ParseSuccess parsedValue92 parsedPos92)
              {
                (let val parsedValue92)
                (let afterVal parsedPos92)
                (if (peekIs tokens afterVal TK_RPAREN)
                  ; Span = the stored field's name token, AX3007's
                  ; anchor, as on TAG_E_FIELD.
                  (pOk (nodeBuildESetf base fname val (tokenSpan (vecGet tokens (advance pos))))
                    (advance afterVal))
                  (pErr afterVal))
              }
            ))
        })
    }
    (pErrExp pos "the name of a `mut` binding, or a field path")))

; ------------------------------------------------------------------
; Parse (fn (args...) body) as lambda expression.
;
; A lambda of SEVERAL parameters is several lambdas, built here, the
; way multi-binding `let` is built as nested single-binding lets a few
; lines below. `(lambda (x y) b)` is `(lambda (x) (lambda (y) b))`,
; which is what the language's curried types already say it means and
; what the closure representation already implements: one hidden
; `%.env` per lifted body, capture by value of everything in scope, so
; the inner lambda captures `x` exactly as it captures any other
; enclosing binding.
;
; Before this, a multi-parameter lambda had NO representation at all.
; `checkLam` typed it as taking a TUPLE, so most uses were refused with
; a type error naming a type nobody wrote (`expected (_t0, _t1), found
; Int`); and any use that laundered it through `cast Int` - which the
; uniform-representation rule makes an ordinary thing to write - passed
; `check` and was silently DISCARDED by the emitter:
;
;   (fn (main) ((cast Int (lambda (x y) (+ x y))) 20 22))
;   check: OK
;   the emitted `__axiom_user_main` body: `ret i64 22`
;
; No `_lam_` function, no call, the whole application folded to its
; last argument, exit 0. README called lambdas Complete and
; `tests/stdlib/140-function-values.ax` passed, because every lambda in
; the repository takes one parameter.
; ------------------------------------------------------------------
; Each lambda carries the `lambda`/`fn` keyword's span. A node with no
; span is a diagnostic with no snippet - `check-render-selfhost.sh`
; refuses to bless one, which is how the missing span here was found.
(pub :: curryLam (-> Names ASTNode Int Int ASTNode))
(pub fn (curryLam params body sp i)
  (if (>= i (vecLen params))
    body
    {
      (let one
        {
          (let v vecNew)
          {
            (vecPush v (vecGet params i))
            v
          }
        })
      (nodeBuildELam one (curryLam params body sp (+ i 1)) 0 sp)
    }))

; Zero parameters still builds one lambda, so the CHECKER can refuse it
; with a span rather than the parser refusing it without one: a lambda
; of no parameters can never be called, because `(f)` and `f` are the
; same expression.
(pub :: mkLamCurried (-> Names ASTNode Int ASTNode))
(pub fn (mkLamCurried params body sp)
  (if (== (vecLen params) 0)
    (nodeBuildELam params body 0 sp)
    (curryLam params body sp 0)))

(pub :: parseLamExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseLamExpr tokens pos)
  {
    (let kwSp
      (if (> pos 0)
        (tokenSpan (vecGet tokens (- pos 1)))
        0))
    (if (peekIs tokens pos TK_LPAREN)
      {
        (let paramsR (parseIdentList tokens (advance pos) vecNew))
        (match paramsR
          ((ParseFailed parseError93) (ParseFailed parseError93))
          ((ParseSuccess parsedValue93 parsedPos93)
            {
              (let params parsedValue93)
              (let afterParams parsedPos93)
              {
                (let bodyR (parseExpr tokens afterParams))
                (match bodyR
                  ((ParseFailed parseError94) (ParseFailed parseError94))
                  ((ParseSuccess parsedValue94 parsedPos94)
                    {
                      (let body parsedValue94)
                      (let afterBody parsedPos94)
                      (if (peekIs tokens afterBody TK_RPAREN)
                        (pOk (mkLamCurried params body kwSp) (advance afterBody))
                        (pErr afterBody))
                    }
                  ))
              }
            }
          ))
      }
      (pErr pos))
  })

; Fold binding pairs [0..i] around `body`, innermost binding first.
(pub :: foldLets (-> (Vec ASTNode) ASTNode Int ASTNode))
(pub fn (foldLets binds body i)
  (if (< i 0)
    body
    {
      (let b (vecGet binds i))
      (foldLets binds
        (if (== (nodeC b) 1)
          (nodeBuildELetm (nodeAText b) (nodeBChild b) body (nodeSpan b))
          (mkELetAt (nodeAName b) (nodeBChild b) body (nodeSpan b)))
        (- i 1))
    }))

; ------------------------------------------------------------------
; Parse (if test then else), variadically: (if t1 b1 t2 b2 ... els)
; is the right-nested chain (if t1 b1 (if t2 b2 ... els)), built here
; the way a multi-parameter lambda is curried a few forms down - one
; tag, no new keyword, no new type rule. The checker and the emitter
; meet only the nested chain, so a variadic `if` checks and emits
; exactly as the nested `if`s it desugars to; `cond`'s laxer join
; (clause bodies never compared) goes with `cond`.
;
; The arity falls out of the grammar rather than a count: after each
; pair the next expression is either the final else (a `)` follows)
; or the next test. A chain that ends on a complete pair has no else,
; and the `if` supplies `()`: `(if t b)` and `(if t1 b1 t2 b2)` answer
; the unit value, and the checker drops their branches' values
; (`checkIf`). A missing test or branch still fails NAMED: `(if)` and
; `(if t)` draw the `if` shape rather than the generic "expected
; expression". A genuinely broken operand anywhere else keeps the
; generic refusal, which is about the operand rather than the chain.
; ------------------------------------------------------------------
(pub :: parseIfExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseIfExpr tokens pos)
  {
    (let testR (parseIfTest tokens pos))
    (match testR
      ((ParseFailed parseError95)
        (if (peekIs tokens pos TK_RPAREN)
          (pErrExp pos
            "the test operand: `if` takes `(if test then else)`, or `(if test then)` to answer `()`, variadically `(if t1 b1 t2 b2 ... els)`")
          (ParseFailed parseError95))
      )
      ((ParseSuccess parsedValue95 parsedPos95)
        {
          (let test parsedValue95)
          (let afterTest parsedPos95)
          {
            (let thenR (parseExpr tokens afterTest))
            (match thenR
              ((ParseFailed parseError96)
                (if (peekIs tokens afterTest TK_RPAREN)
                  (pErrExp afterTest
                    "the `then` branch: `if` takes `(if test then else)`, or `(if test then)` to answer `()`, variadically `(if t1 b1 t2 b2 ... els)`")
                  (ParseFailed parseError96))
              )
              ((ParseSuccess parsedValue96 parsedPos96)
                (parseIfTail tokens parsedPos96 test parsedValue96)
              ))
          }
        }
      ))
  })

; The tail of an `if` after one test and its branch: the next
; expression is the final else when the closing paren follows it, and
; the next test otherwise, whose own branch is parsed and the tail
; recursed. One `TAG_E_IF` per pair, right-nested - the fold is the
; desugar, so there is no second representation for any later pass
; to learn. A `)` where an else could stand ends the chain with the
; unit value as its else: `(if t b)` and `(if t1 b1 t2 b2)`.
(pub :: parseIfTail (-> Tokens Int ASTNode ASTNode (PResult ASTNode)))
(pub fn (parseIfTail tokens pos test thenEx)
  {
    (let eR (parseIfTest tokens pos))
    (match eR
      ((ParseFailed parseError97)
        (if (peekIs tokens pos TK_RPAREN)
          ; No else: the `if` supplies `()`, so `(if t b)` runs `b` when
          ; `t` holds and answers the unit value either way (the checker
          ; drops `b`'s value, `checkIf`).
          (pOk (mkIfOrLet test thenEx (mkEUnitAt (tokenSpan (vecGet tokens pos)))) (advance pos))
          (ParseFailed parseError97))
      )
      ((ParseSuccess parsedValue97 parsedPos97)
        {
          (let e parsedValue97)
          (let afterE parsedPos97)
          (if (peekIs tokens afterE TK_RPAREN)
            (if (isLetTest e)
              (pErrExp afterE
                "the branch a `(let ...)` test chooses: `(if (let (Some x) value) then else)`")
              (pOk (mkIfOrLet test thenEx e) (advance afterE)))
            {
              (let thenR (parseExpr tokens afterE))
              (match thenR
                ((ParseFailed parseError98) (ParseFailed parseError98))
                ((ParseSuccess parsedValue98 parsedPos98)
                  {
                    (let tailR (parseIfTail tokens parsedPos98 e parsedValue98))
                    (match tailR
                      ((ParseFailed parseError99) (ParseFailed parseError99))
                      ((ParseSuccess parsedValue99 parsedPos99)
                        (pOk (mkIfOrLet test thenEx parsedValue99) parsedPos99)
                      ))
                  }
                ))
            })
        }
      ))
  })

; A test of an `if`: an expression, or `(let PATTERN value)`, which
; holds when `value` matches `PATTERN` and binds the pattern's names
; for the branch it chooses. `(if (let (Some x) o) x 0)` is
; `(match o ((Some x) x) (_ 0))`: `mkIfOrLet` builds that match where
; the chain would build an `if`, so every later pass reads an ordinary
; `match`, with its exhaustiveness, binder and type rules. A `let` test
; can stand at any test position of a variadic chain, and the else
; branches see none of its names.
(pub :: parseIfTest (-> Tokens Int (PResult ASTNode)))
(pub fn (parseIfTest tokens pos)
  (if (&& (peekIs tokens pos TK_LPAREN)
        (&& (peekIs tokens (advance pos) TK_IDENT)
          (kwEq (tokenLexeme (vecGet tokens (advance pos))) kwLet)))
    (parseLetTest tokens (advance (advance pos)))
    (parseExpr tokens pos)))

; `(let PATTERN value)` after the `let`, as a TAG_M_ARM whose pattern
; is the test and whose body is the value tested. Only the `if`
; builders read it. A pattern that cannot fail, a lowercase name or
; `_`, is refused: its else branch could never run, and the binding
; it makes is a block's `(let x value)`.
(pub :: parseLetTest (-> Tokens Int (PResult ASTNode)))
(pub fn (parseLetTest tokens pos)
  (if (&& (peekIs tokens pos TK_IDENT) (kwEq (tokenLexeme (vecGet tokens pos)) "mut"))
    (pErrExp pos
      "a pattern: a `(let ...)` test binds its names for one branch, and they cannot be `mut`")
    {
      (let patR (parseArmPattern tokens pos))
      (match patR
        ((ParseFailed parseError100) (ParseFailed parseError100))
        ((ParseSuccess parsedValue100 parsedPos100)
          {
            (let pat parsedValue100)
            (if (== (letTestCannotFail pat) 1)
              (pErrExp pos
                "a pattern that can fail to match: `(if (let (Some x) value) then else)` tests a constructor or a literal, and a lowercase name or `_` matches everything, so bind it in a block with `(let x value)`")
              {
                (let valR (parseExpr tokens parsedPos100))
                (match valR
                  ((ParseFailed parseError101) (ParseFailed parseError101))
                  ((ParseSuccess parsedValue101 parsedPos101)
                    {
                      (let afterVal parsedPos101)
                      (if (peekIs tokens afterVal TK_RPAREN)
                        (pOk (nodeBuildMArmPlain pat parsedValue101 0) (advance afterVal))
                        (pErrExp afterVal "`)` closing the `(let PATTERN value)` test"))
                    }
                  ))
              })
          }
        ))
    }))

; A bare lowercase name or `_`. A bare capitalised name is a
; constructor test, or AX3137 when it names no constructor, so it is
; left to the checker; `true` and `false` are literal tests.
(pub :: letTestCannotFail (-> ASTNode Int))
(pub fn (letTestCannotFail pat)
  (if (!= (nodeTag pat) TAG_E_VAR)
    0
    {
      (let name (nodeAName pat))
      (if (|| (strEq name "true") (strEq name "false"))
        0
        (if (strEq name "_")
          1
          (if (&& (> (strLen name) 0) (&& (>= (strByte name 0) 97) (<= (strByte name 0) 122)))
            1
            0)))
    }))

(pub :: isLetTest (-> ASTNode Bool))
(pub fn (isLetTest n)
  (== (nodeTag n) TAG_M_ARM))

; One link of an `if` chain: an `if` for an expression test, and for a
; `(let PATTERN value)` test the two-arm match it means. The wildcard
; arm has no span, so no diagnostic can point at code nobody wrote.
(pub :: mkIfOrLet (-> ASTNode ASTNode ASTNode ASTNode))
(pub fn (mkIfOrLet test thenEx elseEx)
  (if (isLetTest test)
    {
      (let arms vecNew)
      (vecPush arms (nodeBuildMArmPlain (nodeAChild test) thenEx 0))
      (vecPush arms (nodeBuildMArmPlain (mkEVarAt "_" 0) elseEx 0))
      (nodeBuildEMatchPlain (nodeBChild test) arms 0)
    }
    (mkEIf test thenEx elseEx)))

; ------------------------------------------------------------------
; Parse (match scrutinee (pat body) ...)
; ------------------------------------------------------------------
(pub :: parseMatchExpr (-> Tokens Int (PResult ASTNode)))
(pub fn (parseMatchExpr tokens pos)
  {
    (let scrutR (parseExpr tokens pos))
    (match scrutR
      ((ParseFailed parseError102) (ParseFailed parseError102))
      ((ParseSuccess parsedValue102 parsedPos102)
        {
          (let scrut parsedValue102)
          (let afterScrut parsedPos102)
          {
            (let armsR (parseMatchArms tokens afterScrut vecNew))
            (match armsR
              ((ParseFailed parseError103) (ParseFailed parseError103))
              ((ParseSuccess parsedValue103 parsedPos103)
                {
                  (let arms parsedValue103)
                  (let afterArms parsedPos103)
                  (if (peekIs tokens afterArms TK_RPAREN)
                    (pOk (nodeBuildEMatchPlain scrut arms 0) (advance afterArms))
                    (pErr afterArms))
                }
              ))
          }
        }
      ))
  })

; Stops *at* the closing paren without consuming it: `parseMatchExpr`
; expects to find it and consume it itself. Consuming it here made every
; `match` a parse error, since the caller then demanded a second one.
(pub :: parseMatchArms (-> Tokens Int (Vec ASTNode) (PResult Nodes)))
(pub fn (parseMatchArms tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc pos)
    (if (peekIs tokens pos TK_LPAREN)
      ; `(syntax/for ...)` where an arm stands is the iteration form
      ; (MAC-CAP-5), not an arm whose pattern is a variable named
      ; syntax/for - the head spelling is reserved in this position,
      ; and the corpus population of `syntax/`-prefixed identifiers
      ; was zero when the reservation landed (measured 2026-08-14).
      (if (&& (peekIs tokens (advance pos) TK_IDENT)
            (strEq (tokenLexeme (vecGet tokens (advance pos))) "syntax/for"))
        {
          (let forR (parseMatchForArm tokens (advance pos)))
          (match forR
            ((ParseFailed parseError104) (ParseFailed parseError104))
            ((ParseSuccess parsedValue104 parsedPos104)
              (parseMatchArms tokens parsedPos104 (vecPush acc parsedValue104))
            ))
        }
        {
          (let armR (parseMatchArm tokens (advance pos)))
          (match armR
            ((ParseFailed parseError105) (ParseFailed parseError105))
            ((ParseSuccess parsedValue105 parsedPos105)
              {
                (let arm parsedValue105)
                (let afterArm parsedPos105)
                (parseMatchArms tokens afterArm (vecPush acc arm))
              }
            ))
        })
      ; A bare `...` where an arm stands is the splice marker a rule
      ; template leaves for instantiation (`((s) 1) ...` rebuilding
      ; one arm per absorbed element, MAC-LANG-16). It parses as an
      ; arm whose pattern is the variable `...` with no body - the
      ; shape the expander's splice consumes and every other consumer
      ; refuses: ordinary code meets it in `expandArmsIn` (a diagnostic
      ; plus a poison arm, beside the `syntax/for` refusal above), and
      ; a template arm without a preceding repeat meets it in the
      ; splice loop the same way. No wire format changes: it is a
      ; TAG_M_ARM like any other.
      (if (&& (peekIs tokens pos TK_IDENT) (strEq (tokenLexeme (vecGet tokens pos)) "..."))
        {
          (let mkr
            (nodeBuildMArm (mkEVarAt "..." (tokenSpan (vecGet tokens pos))) nilNode 0
              (tokenSpan (vecGet tokens pos))))
          (parseMatchArms tokens (advance pos) (vecPush acc mkr))
        }
        (pErr pos)))))

; Parse `syntax/for BINDS ARM...` with the form's own `(` already
; consumed and `pos` at the `syntax/for` token; consumes the closing
; paren. At least one template arm is required - an empty iteration
; body generates nothing and means nothing. BINDS is `parseIterBinder`'s
; form: one pair, or several zipped in lockstep.
(pub :: parseMatchForArm (-> Tokens Int (PResult ASTNode)))
(pub fn (parseMatchForArm tokens pos)
  {
    (let sp (tokenSpan (vecGet tokens pos)))
    (let p1 (advance pos))
    (if (peekIs tokens p1 TK_LPAREN)
      {
        (let bindR (parseExpr tokens p1))
        (match bindR
          ((ParseFailed parseError106) (ParseFailed parseError106))
          ((ParseSuccess parsedValue106 parsedPos106)
            {
              (let binds parsedValue106)
              (let afterSeq parsedPos106)
              {
                (let var (parseIterBinder binds))
                (if (strEq var "")
                  (pErrExp (advance p1) "identifier")
                  {
                    (let armsR (parseMatchArms tokens afterSeq vecNew))
                    (match armsR
                      ((ParseFailed parseError107) (ParseFailed parseError107))
                      ((ParseSuccess parsedValue107 parsedPos107)
                        {
                          (let arms parsedValue107)
                          (let afterArms parsedPos107)
                          (if (== (vecLen arms) 0)
                            (pErr afterArms)
                            (if (peekIs tokens afterArms TK_RPAREN)
                              (pOk (nodeBuildMFor var binds arms sp) (advance afterArms))
                              (pErr afterArms)))
                        }
                      ))
                  })
              }
            }
          ))
      }
      (pErrExp p1 "("))
  })

; Parse `(pat body)`.
;
; The pattern is kept. It used to be parsed and thrown away, which left
; codegen with a list of bodies and no way to tell which one applied.
(pub :: identStartsUpper (-> Tokens Int Bool))
(pub fn (identStartsUpper tokens pos)
  {
    (let s (tokenLexeme (vecGet tokens pos)))
    (if (== (strLen s) 0)
      false
      (&& (>= (strByte s 0) 65) (<= (strByte s 0) 90)))
  })

; Pattern position: `( UpperIdent )` is a nullary-constructor test;
; everything else parses as an expression does. A bare identifier -
; constructor-named or not - is a binder, which is stage0's rule.
; RECURSIVE, because a nullary constructor nested inside a fieldful
; pattern is still a constructor. `(Wrap (Red))` used to parse its
; argument with `parseExpr`, which has no pattern context and made
; `(Red)` an ordinary variable reference - a BINDER, matching anything,
; so the first arm swallowed every scrutinee and
; `tests/stdlib/120-pattern-representation.ax` answered from the wrong
; arm. The same erasure was already recorded as an under-reporting gap
; in the checker; in the emitter it is a miscompile.
;
; A fieldful pattern still builds the application spine `parseExpr`
; would have built, so every consumer downstream is unchanged - only
; the ARGUMENTS are parsed as patterns rather than as expressions.
(pub :: parseArmPattern (-> Tokens Int (PResult ASTNode)))
(pub fn (parseArmPattern tokens pos)
  (if (&& (peekIs tokens pos TK_LPAREN)
        (&& (peekIs tokens (advance pos) TK_IDENT)
          (|| (identStartsUpper tokens (advance pos))
            (peekIs tokens (parseDottedChain tokens (advance (advance pos)) vecNew)
              TK_DOUBLE_COLON))))
    {
      (let head (parseIdentRef tokens (advance pos)))
      (match head
        ((ParseFailed parseError108) (ParseFailed parseError108))
        ((ParseSuccess parsedValue108 parsedPos108)
          {
            (let node parsedValue108)
            (let after parsedPos108)
            (if (!= (nodeTag node) TAG_E_VAR)
              (pErrExp (advance pos) "constructor")
              (if (peekIs tokens after TK_RPAREN)
                (pOk (nodeBuildPCon0 (nodeAName node) 0 0 (nodeSpan node)) (advance after))
                (if (peekIs tokens after TK_LBRACE)
                  (parseNamedPatFields tokens (advance after) (nodeAName node) (nodeSpan node)
                    vecNew vecNew)
                  (parseArmPatternArgs tokens after node))))
          }
        ))
    }
    ; `()` is the unit value in an expression and no pattern: read as
    ; one it would be the literal 0 and match a zero.
    (if (&& (peekIs tokens pos TK_LPAREN) (peekIs tokens (advance pos) TK_RPAREN))
      (pErrExp (advance pos) "expression")
      (if (&& (peekIs tokens pos TK_LPAREN) (peekIs tokens (advance pos) TK_LPAREN))
        (parseGroupedArmPattern tokens pos)
        (parseExpr tokens pos)))))

; Grouping keeps pattern context: parsing its contents as expressions
; would turn a nested `(Red)` test back into a catch-all binder.
; A grouped constructor head can still take arguments, as `(Wrap)` in
; `((Wrap) (Red))`; flatten that head into the ordinary pattern spine.
(pub :: parseGroupedArmPattern (-> Tokens Int (PResult ASTNode)))
(pub fn (parseGroupedArmPattern tokens pos)
  {
    (let inner (parseArmPattern tokens (advance pos)))
    (match inner
      ((ParseFailed parseError109) (ParseFailed parseError109))
      ((ParseSuccess parsedValue109 parsedPos109)
        {
          (let pat parsedValue109)
          (let after parsedPos109)
          (if (peekIs tokens after TK_RPAREN)
            (pOk pat (advance after))
            {
              (let head
                (if (== (nodeTag pat) TAG_P_CON0)
                  (mkEVarAt (nodeAName pat) (nodeSpan pat))
                  pat))
              (if (== (nodeTag (spineHead head)) TAG_E_VAR)
                (parseArmPatternArgs tokens after head)
                (pErrExp (advance pos) "constructor"))
            })
        }
      ))
  })

; Reorder a named constructor pattern into the positional spine the
; rest of both compilers already understands. `declared` is the
; constructor's field names in declaration order; `names` and `pats`
; are what the pattern wrote, positionally aligned with each other.
;
; A field the pattern omits becomes `_`, which binds nothing - stage0
; fills the same hole with a wildcard, so a partial named pattern is
; legal by construction and needs no arity check.
(pub :: namedPatSpine (-> String Names Nodes Nodes Int ASTNode))
(pub fn (namedPatSpine cname declared names pats sp)
  (namedPatSpineFrom declared names pats 0 (mkEVarAt cname sp)))

(pub :: namedPatSpineFrom (-> Names Nodes Nodes Int ASTNode ASTNode))
(pub fn (namedPatSpineFrom declared names pats i acc)
  (if (>= i (vecLen declared))
    acc
    (namedPatSpineFrom declared names pats (+ i 1)
      (mkEApp acc
        (if (let (Some j) (namedFieldIndex names (vecGetStr declared i)))
          (vecGet pats j)
          (mkEVar "_"))))))

; Where the pattern mentions field `n`, or `None`. `names` holds spanned
; TAG_E_VAR nodes so a miss can be reported at the field name.
;
; `Option` RATHER THAN -1, and this one is why the absence column is
; worth closing rather than documenting: the only caller uses the
; answer as `(vecGet pats j)`, so a miss that reached the index would
; be a WILD READ and not a wrong answer. The type is what stops it
; now, in place of a `(< j 0)` the caller had to remember to write.
;
; The recursive scan carries the optional index without a sentinel.
(pub :: namedFieldIndex (-> (Vec ASTNode) String (Option Int)))
(pub fn (namedFieldIndex names n)
  (namedFieldIndexFrom names n 0))

(:: namedFieldIndexFrom (-> (Vec ASTNode) String Int (Option Int)))
(fn (namedFieldIndexFrom names n i)
  (if (>= i (vecLen names))
    None
    (if (strEq (nodeAName (vecGet names i)) n)
      (Some i)
      (namedFieldIndexFrom names n (+ i 1)))))

; Is `n` one of the constructor's declared fields?
(pub :: declaredHasField (-> Names String Int))
(pub fn (declaredHasField declared n)
  (if (== (as declared Int) 0)
    0
    (declaredHasFieldFrom declared n 0)))

(pub :: declaredHasFieldFrom (-> Names String Int Int))
(pub fn (declaredHasFieldFrom declared n i)
  (if (>= i (vecLen declared))
    0
    (if (strEq (vecGetStr declared i) n)
      1
      (declaredHasFieldFrom declared n (+ i 1)))))

(pub :: peekIsEq (-> Tokens Int Bool))
(pub fn (peekIsEq tokens pos)
  (if (peekIs tokens pos TK_IDENT)
    (strEq (tokenLexeme (vecGet tokens pos)) "=")
    false))

; `{ f = pat, g }` to the closing brace. A bare name PUNS: `{ w, h }`
; means `{ w = w, h = h }`, which is stage0's rule and is resolved
; here at parse time, since it needs no knowledge of the declaration.
(pub :: parseNamedPatFields
  (-> Tokens Int String Int (Vec ASTNode) (Vec ASTNode) (PResult ASTNode)))
(pub fn (parseNamedPatFields tokens pos cname csp names pats)
  (if (peekIs tokens pos TK_RBRACE)
    (if (peekIs tokens (advance pos) TK_RPAREN)
      (pOk (nodeBuildPConnamed cname names pats csp) (advance (advance pos)))
      (pErr (advance pos)))
    (if (peekIs tokens pos TK_IDENT)
      {
        (let fTok (vecGet tokens pos))
        {
          (vecPush names (mkEVarAt (tokenLexeme fTok) (tokenSpan fTok)))
          ; `=` has no token of its own: it is an operator character,
          ; so the lexer hands it back as an identifier whose lexeme
          ; is "=".
          (if (peekIsEq tokens (advance pos))
            {
              (let pr (parseArmPattern tokens (advance (advance pos))))
              (match pr
                ((ParseFailed parseError110) (ParseFailed parseError110))
                ((ParseSuccess parsedValue110 parsedPos110)
                  {
                    (vecPush pats parsedValue110)
                    (parseNamedPatFields tokens (skipFieldComma tokens parsedPos110) cname csp
                      names pats)
                  }
                ))
            }
            {
              (vecPush pats (mkEVarAt (tokenLexeme fTok) (tokenSpan fTok)))
              (parseNamedPatFields tokens (skipFieldComma tokens (advance pos)) cname csp names
                pats)
            })
        }
      }
      (pErr pos))))

(pub :: parseArmPatternArgs (-> Tokens Int ASTNode (PResult ASTNode)))
(pub fn (parseArmPatternArgs tokens pos acc)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk acc (advance pos))
    (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      {
        (let r (parseArmPattern tokens pos))
        (match r
          ((ParseFailed parseError111) (ParseFailed parseError111))
          ((ParseSuccess parsedValue111 parsedPos111)
            (parseArmPatternArgs tokens parsedPos111 (mkEApp acc parsedValue111))
          ))
      })))

(pub :: parseMatchArm (-> Tokens Int (PResult ASTNode)))
(pub fn (parseMatchArm tokens pos)
  {
    (let patR (parseArmPattern tokens pos))
    (match patR
      ((ParseFailed parseError112) (ParseFailed parseError112))
      ((ParseSuccess parsedValue112 parsedPos112)
        {
          (let pat parsedValue112)
          (let afterPat parsedPos112)
          {
            (let bodyR (parseExpr tokens afterPat))
            (match bodyR
              ((ParseFailed parseError113) (ParseFailed parseError113))
              ((ParseSuccess parsedValue113 parsedPos113)
                {
                  (let body parsedValue113)
                  (let afterBody parsedPos113)
                  (if (peekIs tokens afterBody TK_RPAREN)
                    (pOk (nodeBuildMArmPlain pat body 0) (advance afterBody))
                    (pErr afterBody))
                }
              ))
          }
        }
      ))
  })

; ------------------------------------------------------------------
; Parse { expr1 expr2 ... }
; ------------------------------------------------------------------
(pub :: parseBlock (-> Tokens Int (PResult ASTNode)))
(pub fn (parseBlock tokens pos)
  (parseBlockBody tokens pos vecNew))

(pub :: parseBlockBody (-> Tokens Int (Vec ASTNode) (PResult ASTNode)))
(pub fn (parseBlockBody tokens pos acc)
  (if (peekIs tokens pos TK_RBRACE)
    ; An empty `{}` is the same defect one node along. It parsed as a
    ; real `EBegin` over an empty vector, so it survived the checker -
    ; and then codegen emitted a block that assigns no register and
    ; the function returned a value that was never computed. In value
    ; position that is invalid IR, which `opt` rejects and the driver
    ; reports as `AX4003 opt failed` against `<toolchain>`: the
    ; compiler blaming the toolchain for its own output, with no span
    ; into the source. A block's value is its last expression, so a
    ; block with no expressions has no value and cannot be one.
    (if (== (vecLen acc) 0)
      (pErrExp pos "expression")
      (pOk (mkEBegin acc) (advance pos)))
    (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (if (isBlockLocalLet tokens pos)
        (parseBlockLocalLet tokens (advance (advance pos)) acc)
        {
          (let r (parseExpr tokens pos))
          (match r
            ((ParseFailed parseError114) (ParseFailed parseError114))
            ((ParseSuccess parsedValue114 parsedPos114)
              (parseBlockBody tokens parsedPos114 (vecPush acc parsedValue114))
            ))
        }))))

; A local declaration belongs to the block that contains it. Lower
; its remainder to an ordinary lexical let, preserving scope ends and
; evaluation order for every existing consumer of the expression tree.
(pub :: isBlockLocalLet (-> Tokens Int Bool))
(pub fn (isBlockLocalLet tokens pos)
  (&& (peekIs tokens pos TK_LPAREN)
    (&& (peekIs tokens (advance pos) TK_IDENT)
      (&& (strEq (tokenLexeme (vecGet tokens (advance pos))) kwLet)
        (! (peekIs tokens (advance (advance pos)) TK_LPAREN))))))

(pub :: parseBlockLocalLet (-> Tokens Int (Vec ASTNode) (PResult ASTNode)))
(pub fn (parseBlockLocalLet tokens pos acc)
  {
    (let nr (parseIdentName tokens pos))
    (match nr
      ((ParseFailed parseError115) (ParseFailed parseError115))
      ((ParseSuccess parsedValue115 parsedPos115)
        {
          (let mutable (strEq parsedValue115 "mut"))
          (let nameR
            (if mutable
              (parseIdentName tokens parsedPos115)
              nr))
          (match nameR
            ((ParseFailed parseError116) (ParseFailed parseError116))
            ((ParseSuccess parsedValue116 parsedPos116)
              {
                (let valueR (parseExpr tokens parsedPos116))
                (match valueR
                  ((ParseFailed parseError117) (ParseFailed parseError117))
                  ((ParseSuccess parsedValue117 parsedPos117)
                    {
                      (let afterValue parsedPos117)
                      (if (! (peekIs tokens afterValue TK_RPAREN))
                        (pErrExp afterValue "`)` after the local binding's value")
                        {
                          (let after (advance afterValue))
                          (let bodyR
                            (if (peekIs tokens after TK_RBRACE)
                              (pOk (mkEUnitAt (tokenSpan (vecGet tokens after))) (advance after))
                              (parseBlockBody tokens after vecNew)))
                          (match bodyR
                            ((ParseFailed parseError118) (ParseFailed parseError118))
                            ((ParseSuccess parsedValue118 parsedPos118)
                              {
                                (let name parsedValue116)
                                (let sp (tokenSpan (vecGet tokens (- parsedPos116 1))))
                                (let local
                                  (if mutable
                                    (nodeBuildELetm name parsedValue117 parsedValue118 sp)
                                    (mkELetAt name parsedValue117 parsedValue118 sp)))
                                (pOk (mkEBegin (vecPush acc local)) parsedPos118)
                              }
                            ))
                        })
                    }
                  ))
              }
            ))
        }
      ))
  })

; ------------------------------------------------------------------
; Function application: (f args...)
; ------------------------------------------------------------------
(pub :: parseAppForm (-> Tokens Int (PResult ASTNode)))
(pub fn (parseAppForm tokens pos)
  {
    (let r (parseExpr tokens pos))
    (match r
      ((ParseFailed parseError119) (ParseFailed parseError119))
      ((ParseSuccess parsedValue119 parsedPos119)
        {
          (let fnExpr parsedValue119)
          (let nextPos parsedPos119)
          {
            (let ar (parseArgs tokens nextPos fnExpr))
            (match ar
              ((ParseFailed parseError120) (ParseFailed parseError120))
              ((ParseSuccess parsedValue120 parsedPos120)
                (pOk (unaryMinusToBinary parsedValue120) parsedPos120)
              ))
          }
        }
      ))
  })

; `(- x)` is negation, not a one-argument call to a function named `-`.
;
; stage0 desugars it in the parser - `parse_expr_inner` turns a `-` head
; with exactly one argument into `EInfix(0, "-", x)` - and stage1 did
; not, so its type checker met a two-parameter builtin supplied with one
; argument and reported **AX3013 partial-application on a valid
; program**. `codegen.ax:emitCall` had the special case, which is what
; makes this the `cond` shape from the roadmap: the form was implemented
; at one end of the pipeline and absent at the other, so the stage that
; runs first refused what the stage that runs last was ready for. The
; codegen case is gone with this, since nothing can now reach it.
;
; Rewriting to the two-argument application rather than adding a node
; keeps the ordinary binary path. Word 2 marks the inserted zero, so
; the checker can give it the operand's numeric type. A source-written
; `(- 0 x)` still requires x to be Int.
(pub :: unaryMinusToBinary (-> ASTNode ASTNode))
(pub fn (unaryMinusToBinary e)
  (if (== (nodeTag e) TAG_E_APP)
    {
      (let head (nodeAChild e))
      (if (&& (== (nodeTag head) TAG_E_VAR) (strEq (nodeAName head) "-"))
        (mkEApp (mkEApp head (nodeBuildEIntPlain 0 1 0)) (nodeBChild e))
        e)
    }
    e))

(pub :: parseArgs (-> Tokens Int ASTNode (PResult ASTNode)))
(pub fn (parseArgs tokens pos fnExpr)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk fnExpr (advance pos))
    (if (peekIs tokens pos TK_EOF)
      (pErr pos)
      (if (peekIs tokens pos TK_COLON)
        (if (== (nodeTag fnExpr) TAG_E_VAR)
          (parseNamedArgs tokens pos fnExpr vecNew vecNew)
          (pErrExp pos "a positional argument; labelled fields cannot follow positional arguments"))
        {
          (let r (parseExpr tokens pos))
          (match r
            ((ParseFailed parseError121) (ParseFailed parseError121))
            ((ParseSuccess parsedValue121 parsedPos121)
              {
                (let arg parsedValue121)
                (let nextPos parsedPos121)
                (parseArgs tokens nextPos (mkEApp fnExpr arg))
              }
            ))
        }))))

; Labels belong to the complete application, in source order. Values
; remain ordinary arguments, so expression visitors see every value.
; Expansion resolves the struct and lowers its checked field order.
(pub :: parseNamedArgs (-> Tokens Int ASTNode Strings Ints (PResult ASTNode)))
(pub fn (parseNamedArgs tokens pos call labels spans)
  (if (peekIs tokens pos TK_RPAREN)
    (pOk (setNamedCall call labels spans) (advance pos))
    (if (! (peekIs tokens pos TK_COLON))
      (pErrExp pos "a `:field` label or `)`")
      {
        (let nameR (parseIdentName tokens (advance pos)))
        (match nameR
          ((ParseFailed parseError122) (ParseFailed parseError122))
          ((ParseSuccess parsedValue122 parsedPos122)
            {
              (let valueR (parseExpr tokens parsedPos122))
              (match valueR
                ((ParseFailed parseError123) (ParseFailed parseError123))
                ((ParseSuccess parsedValue123 parsedPos123)
                  (parseNamedArgs tokens parsedPos123 (mkEApp call parsedValue123)
                    (vecPush labels parsedValue122)
                    (vecPush spans (tokenSpan (vecGet tokens (advance pos)))))
                ))
            }
          ))
      })))

; Application word c is otherwise unused. Keep label spans there until
; expansion so field diagnostics point at the label the reader wrote.
(pub :: setNamedCall (-> ASTNode Strings Ints ASTNode))
(pub fn (setNamedCall call labels spans)
  {
    (setCtorFieldNames call labels)
    (writeNodeWords call 3 spans)
    call
  })

; ------------------------------------------------------------------
; Parse declarations until EOF.
; ------------------------------------------------------------------
(pub :: parseDecls (-> Tokens Int (Vec ASTNode) (PResult Nodes)))
(pub fn (parseDecls tokens pos acc)
  (match (parseDecl tokens pos)
    ((ParseFailed error) (ParseFailed error))
    ((ParseSuccess found nextPos)
      (match found
        ((None) (pOk acc nextPos))
        ((Some declaration)
          (if (&& (== (nodeTag declaration) TAG_D_IMPORT)
                (&& (> (vecLen acc) 0) (!= (nodeTag (vecGet acc (- (vecLen acc) 1))) TAG_D_IMPORT)))
            (pErrCode
              (if (kwEq (tokenLexeme (vecGet tokens (+ pos 1))) kwPub)
                (+ pos 2)
                (+ pos 1))
              "import-order")
            (parseDecls tokens nextPos (vecPush acc declaration)))
        ))
    )))

; ------------------------------------------------------------------
; Top-level: parse a module.
; ------------------------------------------------------------------
(pub :: parseModule (-> Tokens (PResult Nodes)))
(pub fn (parseModule tokens)
  {
    (let r (parseDecls tokens 0 vecNew))
    r
  })

; As `parseModule`, then attaching AXTAGs. Declarations arrive in
; source order and every one carries its NAME's span, so the tags
; belonging to a declaration are exactly those whose offset precedes
; its name and follows the previous declaration's - the partition
; stage0's `collect_axtags` performs by consuming a contiguous run of
; Axtag tokens at each declaration boundary.
; ------------------------------------------------------------------
; The nesting limit.
;
; stage0 refuses past 1024 with AX2005 (`nesting is too deep (limit is
; 1024)`). stage1 had no limit and no depth counter anywhere, and the
; consequence was worse than a missing diagnostic: measured 2026-08-08,
; a 20,000-deep expression that stage0 REJECTS was ACCEPTED by stage1
; and checked clean, and at 100,000 stage1 died of SIGSEGV (signal 11)
; where stage0 still answered in the ordinary way. Accepting a program
; the other compiler refuses is the worse half of that: a crash is at
; least loud.
;
; Counted over the TOKEN STREAM rather than threaded through the parse
; functions. Every `parse*` function would need a depth parameter
; otherwise - sixty-odd of them - and this measures the same thing for
; the shape that matters, since a nesting level in this syntax is a
; delimiter. Braces and brackets are counted with parens because each
; one is a recursive descent in the parser too.
;
; It is deliberately NOT exact agreement with stage0's counter, which
; counts parse recursion rather than delimiters; the two coincide on
; every nesting form the grammar has, and where they might not, both
; compilers still refuse.
;
; It used to be a BARE refusal - `pErr 0`, reported by main.ax as
; `parse failed` with exit 2 against stage0's coded, spanned AX2005 and
; exit 1 - on the grounds that the parser carried no diagnostic payload.
; It carries one now (`PResult`'s `code` slot, added by the parse-error
; port), so the refusal says which token it is refusing and why.
;
; The number is shared with expansion's `expMaxWalk`
; (`core/expand.ax`), deliberately the same: expansion must not
; produce a program this limit would have refused.
; `scripts/check-diagnostics.sh` holds the equality.
; ------------------------------------------------------------------
(pub :: parseMaxDepth Int)
(pub fn (parseMaxDepth)
  1024)

; The index of the opening delimiter that first takes nesting past
; `limit`, or None when nothing does. One walk answers both questions the
; depth guard asks - whether the limit is passed, and where - so the
; maximum is never computed separately.
;
; A closer at depth 0 is unbalanced input, which the parser reports on
; its own terms; it is floored here rather than allowed to go negative,
; so a stray `)` early in a file cannot mask real depth after it.
(pub :: nestOverflowTok (-> Tokens Int (Option Int)))
(pub fn (nestOverflowTok tokens limit)
  {
    (let mut i 0)
    (let mut d 0)
    (let mut hit (None))
    (let n (vecLen tokens))
    {
      (while (&& (< i n) (! (isSome hit)))
        {
          (if (|| (peekIs tokens i TK_LPAREN)
                (|| (peekIs tokens i TK_LBRACE) (peekIs tokens i TK_LBRACKET)))
            {
              (set d (+ d 1))
              (if (> d limit)
                (set hit (Some i)))
            }
            (if (|| (peekIs tokens i TK_RPAREN)
                  (|| (peekIs tokens i TK_RBRACE) (peekIs tokens i TK_RBRACKET)))
              (if (> d 0)
                (set d (- d 1)))))
          (set i (+ i 1))
        })
      hit
    }
  })

(pub :: parseModuleWith (-> Tokens Axtags (PResult Nodes)))
(pub fn (parseModuleWith tokens axtags)
  ; The depth check runs BEFORE `parseDecls`, because the failure it
  ; prevents is that call exhausting the stack.
  {
    (let overFound (nestOverflowTok tokens parseMaxDepth))
    (if (let (Some over) overFound)
      (pErrCode over "AX2005")
      {
        (let r (parseDecls tokens 0 vecNew))
        (match r
          ((ParseFailed parseError125) (ParseFailed parseError125))
          ((ParseSuccess parsedValue125 parsedPos125)
            ; A tag belongs to the declaration after it, so one with none
            ; after it is refused, as the formatter refuses it. It used to
            ; be dropped with no word, and a claim such as
            ; `restrict(no-alloc)` then applied to nothing.
            (if (< (attachAxtags parsedValue125 0 axtags 0) (vecLen axtags))
              (pErrExp (- (vecLen tokens) 1) "a declaration after the `;@axiom:` tag")
              r)
          ))
      })
  })

(pub :: attachAxtags (-> (Vec ASTNode) Int Axtags Int Int))
(pub fn (attachAxtags decls i axtags next)
  (if (>= i (vecLen decls))
    next
    {
      (let d (vecGet decls i))
      {
        (let limit
          (if (== (nodeSpan d) 0)
            next
            (spanStart (nodeSpan d))))
        {
          (let upto (axtagsUpto axtags next limit))
          {
            (if (> upto next)
              (writeNodeAxtags d (axtagSlice axtags next upto)))
            (attachAxtags decls (+ i 1) axtags (attachAxtagsNested d axtags upto))
          }
        }
      }
    }))

; A macro's RULES are DECLARATIONS that live inside another
; declaration's node instead of in the top-level vector, which made
; them a place in the language with nowhere to write a `;@axiom:` tag.
; A tag above a `(fn ...)` inside them sat between the macro's span
; and the next top-level declaration's, so this walk either handed it
; to that NEXT declaration or dropped it. Measured before the fix on
; the same shape one level over - a tag above `(emit ...)` inside an
; `(impl ...)` - the tag was silently ignored and `AX3042` fired on a
; method no edit could satisfy.
;
; The cursor threads THROUGH the members rather than around them, so
; the positional rule is the one the top level already used - a tag
; belongs to the next declaration whose span follows it - and it holds
; at both depths. That is also why this function returns the cursor
; and `attachAxtags` returns it too: the top-level walk must resume
; after the tags a nested member consumed, or it would give them out a
; second time.
;
; An `impl`'s methods and a `trait`'s defaults were the other two
; nested positions, and were the ones this was written for. Traits
; went in 0.6.0 and the macro rules are what is left.
;
; A struct's FIELDS are the other nested position. A function-typed
; field declares the effects of what it holds with the same
; `;@axiom:effect(...)` line a function uses, written above the field
; (`fieldDeclsBuild` in the checker reads it). Before fields took tags,
; one written there went to the next top-level declaration, so a claim
; about a field landed on whatever function followed the struct.
(pub :: attachAxtagsNested (-> ASTNode Axtags Int Int))
(pub fn (attachAxtagsNested d axtags cur)
  ; A rule whose template is only an expression has an empty declaration
  ; list, with nothing to thread tags through, and head-list
  ; macros hold no rules at all (word 9 == 0, which the callee returns
  ; at once).
  (if (== (nodeTag d) TAG_D_MACRO)
    (match (nodeMacroRules d)
      ((None) cur)
      ((Some rules) (attachAxtagsRules rules 0 axtags cur)))
    (if (&& (== (nodeTag d) TAG_D_STRUCT) (!= (nodeB d) 0))
      (attachAxtagsFields (nodeBChildren d) 0 axtags cur)
      cur)))

; Each field takes the tags that precede its name and follow the
; previous field's, by the positional rule `attachAxtags` applies at the
; top level. A field's span is its name's.
(pub :: attachAxtagsFields (-> (Vec ASTNode) Int Axtags Int Int))
(pub fn (attachAxtagsFields fields i axtags cur)
  (if (>= i (vecLen fields))
    cur
    {
      (let f (vecGet fields i))
      (if (== (nodeSpan f) 0)
        (attachAxtagsFields fields (+ i 1) axtags cur)
        {
          (let upto (axtagsUpto axtags cur (spanStart (nodeSpan f))))
          (if (> upto cur)
            (writeNodeAxtags f (axtagSlice axtags cur upto)))
          (attachAxtagsFields fields (+ i 1) axtags upto)
        })
    }))

; A declaration macro's TEMPLATES, which are declarations the author
; wrote and can therefore tag.
;
; Without this a `;@axiom:effect(io)` written above a `(fn ...)` INSIDE
; a template had an offset past the macro's own span, so this walk gave
; it to the next TOP-LEVEL declaration - the invocation - and
; `expGiveTags` then handed it to the FIRST function the macro
; generated. Measured on a two-function template whose SECOND function
; performs IO: the first drew a false AX3010 for a claim its body does
; not support, and the second drew AX3042 with no edit anywhere that
; could satisfy it.
;
; Each owning rule retains the declaration templates that receive tags.
(pub :: attachAxtagsRules (-> MacroRules Int Axtags Int Int))
(pub fn (attachAxtagsRules rules i axtags cur)
  (if (>= i (vecLen rules))
    cur
    (attachAxtagsRules rules (+ i 1) axtags (attachAxtags (ruleDeclsAt rules i) 0 axtags cur))))

; The index one past the last tag whose offset precedes `limit`.
(pub :: axtagsUpto (-> Axtags Int Int Int))
(pub fn (axtagsUpto axtags i limit)
  (if (>= i (vecLen axtags))
    i
    {
      (let tag (vecGet axtags i))
      (if (< tag.off limit)
        (axtagsUpto axtags (+ i 1) limit)
        i)
    }))

; Copy an annotation range while retaining each entry and its text.
(pub :: axtagSlice (-> Axtags Int Int Axtags))
(pub fn (axtagSlice axtags from upto)
  {
    (let v vecNew)
    {
      (axtagSliceInto v axtags from upto)
      v
    }
  })

(pub :: axtagSliceInto (-> Axtags Axtags Int Int Int))
(pub fn (axtagSliceInto v axtags from upto)
  (if (>= from upto)
    0
    {
      (vecPush v (vecGet axtags from))
      (axtagSliceInto v axtags (+ from 1) upto)
    }))

; ------------------------------------------------------------------
; `;@axiom:pre(...)` and `;@axiom:post(...)`: the contract expression.
;
; Parsed ONCE, here, because three passes need the same node -
; `expLowerContracts` lowers the run-time check into the body,
; `checkContracts` types it against the signature, and both must agree
; about which tags are contracts and which text is the expression. It
; lives in `parser.ax` for `findFieldNamed`'s reason above: this is the
; module `expand.ax`, `typecheck.ax` and `codegen.ax` all import, and a
; helper in any of those three is an undefined name in the other two.
;
; SPANS ARE ABSOLUTE, AND THAT IS THE WHOLE REASON THIS IS NOT A
; ONE-LINER. Each `AxtagEnt` owns its source offset and the text from
; `@axiom:` to the newline. `scanAxtags` in `lexer.ax` builds it, so the
; expression's first byte
; sits at `off + 8 + op + 1` - the `;`, the seven bytes of `@axiom:`,
; the key, and the `(`. The tokens come from lexing the SLICED text,
; whose offsets start at zero, and every token's span is shifted by that
; base before the parse, so a diagnostic about a contract underlines the
; contract where the author wrote it. Lexing a space-padded copy of the
; whole prefix would give the same spans and allocate the file per tag.
;
; A contract is a per-declaration claim written above EITHER half of a
; function - its `::` or its `fn` - and both are read as one list, in
; source order, exactly as `checkRestricts` reads `restrict(...)`.
; ------------------------------------------------------------------
; The last `)` in a tag's text, or its length when there is none. The
; rule `axtagCloseAt` applies in `typecheck.ax` and `fpAxtag` in
; `format.ax`; it is restated rather than shared because both of those
; modules import this one and not the other way round.
(pub :: ctCloseAt (-> String Int))
(pub fn (ctCloseAt s)
  (ctCloseFrom s (- (strLen s) 1)))

(pub :: ctCloseFrom (-> String Int Int))
(pub fn (ctCloseFrom s i)
  (if (< i 0)
    (strLen s)
    (if (== (strByte s i) 41)
      i
      (ctCloseFrom s (- i 1)))))

; `pre` or `post` for a contract tag, `""` for every other key. The KEY
; only - the bytes before the first `(` - so a bare `;@axiom:pre` with
; no value is still a contract tag, and is reported as a malformed one
; rather than silently ignored.
(pub :: contractKeyOf (-> AxtagEnt String))
(pub fn (contractKeyOf t)
  {
    (let tag t)
    (let txt tag.content)
    {
      (let k
        (if (let (Some op) (strFindByte txt 40 0))
          (strSlice txt 0 op)
          txt))
      (if (strEq k "pre")
        "pre"
        (if (strEq k "post")
          "post"
          ""))
    }
  })

; The expression TEXT of a contract tag, exactly as written, or `""`
; when the tag carries no `(...)` at all.
(pub :: contractTextOf (-> AxtagEnt String))
(pub fn (contractTextOf t)
  {
    (let tag t)
    (let txt tag.content)
    (if (let (Some op) (strFindByte txt 40 0))
      {
        (let cl (ctCloseAt txt))
        (if (|| (>= cl (strLen txt)) (<= cl op))
          ""
          (strSlice txt (+ op 1) (- cl (+ op 1))))
      }
      "")
  })

; Where that text starts in the source file.
(pub :: contractBaseOf (-> AxtagEnt Int))
(pub fn (contractBaseOf t)
  {
    (let tag t)
    (let txt tag.content)
    (if (let (Some op) (strFindByte txt 40 0))
      (+ tag.off (+ 9 op))
      tag.off)
  })

; Shift every token's span by `base`, in place. A `Span` is
; `(start, end)` (core.ax), so this is two words per token.
(pub :: contractShift (-> Tokens Int Int Int))
;@axiom:effect(unsafe)
(pub fn (contractShift toks i base)
  (if (>= i (vecLen toks))
    0
    {
      (let sp (as (tokenSpan (vecGet toks i)) Span))
      {
        (set sp.start (+ sp.start base))
        (set sp.end (+ sp.end base))
        (contractShift toks (+ i 1) base)
      }
    }))

; The contract's expression as an AST node, or None when the tag does not
; hold EXACTLY ONE well-formed expression: no value, a parse failure,
; or text left over after the expression ends. `(> n 0) and more` is a
; refusal and not a silent truncation, which is why the EOF test is
; here and not left to whoever reads the node.
(pub :: contractExprOf (-> AxtagEnt (Option ASTNode)))
(pub fn (contractExprOf t)
  {
    (let txt (contractTextOf t))
    (if (== (strLen txt) 0)
      None
      {
        (let toks (lex txt))
        {
          (contractShift toks 0 (contractBaseOf t))
          {
            (let r (parseExpr toks 0))
            (match r
              ((ParseFailed parseError126) None)
              ((ParseSuccess parsedValue126 parsedPos126)
                (if (peekIs toks parsedPos126 TK_EOF)
                  (Some parsedValue126)
                  None)
              ))
          }
        }
      })
  })

; Every contract tag belonging to one function, in SOURCE ORDER: the
; signature's first, because it is written first. `sigs` is the index
; `contractSigIndex` built - the signatures that carry a contract tag,
; which is EMPTY in every program in this repository today, so the
; common path is one `vecLen`. That is `deprecatedTable`'s argument in
; `typecheck.ax`, and the reason this is not a scan of the whole
; declaration list per function.
(pub :: contractTagsFor (-> Nodes ASTNode Axtags))
(pub fn (contractTagsFor sigs d)
  {
    (let tags (:: vecNew Axtags))
    (if (let (Some signature) (contractSigTags sigs (nodeAName d) 0))
      (contractTagsInto tags signature))
    (contractTagsInto tags (nodeAxtagsOf d))
    tags
  })

(pub :: contractTagsInto (-> Axtags Axtags Int))
(pub fn (contractTagsInto v tags)
  (contractTagsFrom v tags 0))

(pub :: contractTagsFrom (-> Axtags Axtags Int Int))
(pub fn (contractTagsFrom v tags i)
  (if (>= i (vecLen tags))
    0
    {
      (if (> (strLen (contractKeyOf (vecGet tags i))) 0)
        (vecPush v (vecGet tags i)))
      (contractTagsFrom v tags (+ i 1))
    }))

; The signatures in `decls` that carry a contract tag, as a Vec of
; declaration nodes. One pass, kept, so the lookup above is a scan of
; the contracts rather than of the program.
(pub :: contractSigIndex (-> (Vec ASTNode) (Vec ASTNode)))
(pub fn (contractSigIndex decls)
  (contractSigIndexFrom decls vecNew 0))

(pub :: contractSigIndexFrom (-> (Vec ASTNode) (Vec ASTNode) Int (Vec ASTNode)))
(pub fn (contractSigIndexFrom decls acc i)
  (if (>= i (vecLen decls))
    acc
    {
      (let d (vecGet decls i))
      {
        (if (&& (== (nodeTag d) TAG_D_SIG) (== (contractTagCount (nodeAxtagsOf d) 0) 1))
          (vecPush acc d))
        (contractSigIndexFrom decls acc (+ i 1))
      }
    }))

; 1 when this tag list holds at least one contract tag.
(pub :: contractTagCount (-> Axtags Int Int))
(pub fn (contractTagCount tags i)
  (if (>= i (vecLen tags))
    0
    (if (> (strLen (contractKeyOf (vecGet tags i))) 0)
      1
      (contractTagCount tags (+ i 1)))))

(pub :: contractSigTags (-> Nodes String Int (Option Axtags)))
(pub fn (contractSigTags sigs name i)
  (if (>= i (vecLen sigs))
    None
    (if (strEq (nodeAName (vecGet sigs i)) name)
      (nodeAxtagsOpt (vecGet sigs i))
      (contractSigTags sigs name (+ i 1)))))

; The clauses on either half of a function declaration, in source order.
; Tools read the raw tag text so the contract they show is the one checked.
(pub :: contractSourceFor (-> (Vec ASTNode) ASTNode String))
(pub fn (contractSourceFor decls d)
  (if (|| (== (nodeTag d) TAG_D_FN) (== (nodeTag d) TAG_D_SIG))
    {
      (let mut subject d)
      (let mut i 0)
      {
        (while (< i (vecLen decls))
          {
            (let other (vecGet decls i))
            {
              (if (&& (== (nodeTag other) TAG_D_FN) (strEq (nodeAName other) (nodeAName d)))
                (set subject other))
              (set i (+ i 1))
            }
          })
        {
          (let tags
            (if (== (nodeTag subject) TAG_D_FN)
              (contractTagsFor (contractSigIndex decls) subject)
              {
                (let v vecNew)
                {
                  (contractTagsInto v (nodeAxtagsOf subject))
                  v
                }
              }))
          (let mut j 0)
          (let mut out "")
          {
            (while (< j (vecLen tags))
              {
                (let tag (vecGet tags j))
                (set out (concat out (concat ";@axiom:" (concat tag.content "\n"))))
                (set j (+ j 1))
              })
            out
          }
        }
      }
    }
    ""))

; The first TAG_FIELD named `name`, or None.
;
; It lives HERE rather than beside its caller because it used to have
; two, in `expand.ax` and `typecheck.ax`, and `parser.ax` is the module
; both already import - putting a shared helper in `typecheck.ax` and
; calling it from `codegen.ax` compiles fine in `main.ax`, where the
; flat namespace merges every module, and leaves `codegen` with an
; undefined name for anything that imports it alone
; (`tests/selfhost/290-emit.ax` said so). The trait lowering was one of
; those two callers and went in 0.6.0; the survivor is the
; duplicate-definition check, which asks this of an `effect`'s
; operations.
(pub :: findFieldNamed (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (findFieldNamed fields name i)
  (if (>= i (vecLen fields))
    None
    (if (strEq (nodeAName (vecGet fields i)) name)
      (Some (vecGet fields i))
      (findFieldNamed fields name (+ i 1)))))

; Is this type node a type variable the PROGRAMMER wrote? A `_`-prefixed
; name is one this checker minted, and an empty name is the silent
; wildcard; neither is rigid. Both the checker and the emitter ask this
; of the same D_SIG tree, so it is asked in one place.
(pub :: tyIsSrcVar (-> ASTNode Int))
(pub fn (tyIsSrcVar t)
  (if (!= (nodeTag t) TAG_T_VAR)
    0
    {
      (let n (nodeAName t))
      (if (== (strLen n) 0)
        0
        (if (== (strByte n 0) 95)
          0
          1))
    }))

; An application spine, which the parser builds left-nested: the head
; it bottoms out at, its arguments in SOURCE order, and how many there
; are. Every pass that looks through a call asks one of these three.
(pub :: spineHead (-> ASTNode ASTNode))
(pub fn (spineHead e)
  (if (== (nodeTag e) TAG_E_APP)
    (spineHead (nodeAChild e))
    e))

(pub :: spineArgVec (-> ASTNode Nodes Nodes))
(pub fn (spineArgVec e acc)
  (if (== (nodeTag e) TAG_E_APP)
    {
      (spineArgVec (nodeAChild e) acc)
      (vecPush acc (nodeBChild e))
      acc
    }
    acc))

(pub :: spineArgs (-> ASTNode Int Int))
(pub fn (spineArgs e acc)
  (if (== (nodeTag e) TAG_E_APP)
    (spineArgs (nodeAChild e) (+ acc 1))
    acc))

(pub :: arrowArity (-> ASTNode Int))
(pub fn (arrowArity t)
  (if (nodeSame t nilNode)
    0
    (if (== (nodeTag t) TAG_T_ARR)
      (+ 1 (arrowArity (nodeBChild t)))
      0)))

; The type declared for argument position `i` of the arrow `t`, or None
; when no type is available: the input is absent, the spine ran out, or
; the packed argument slot has no type. Poison and inference variables
; remain present. Non-positive positions retain the first-position rule.
;
; Readers choose their conservative classification explicitly: the checker
; treats a missing parameter type as callable; the emitter treats it as
; unclassifiable, preserving the existing unknown-type class.
(pub :: arrowParamTy (-> ASTNode Int (Option ASTNode)))
(pub fn (arrowParamTy t i)
  (if (nodeSame t nilNode)
    None
    (if (!= (nodeTag t) TAG_T_ARR)
      None
      (if (<= i 0)
        {
          (let parameter (nodeAChild t))
          (if (nodeSame parameter nilNode)
            None
            (Some parameter))
        }
        (arrowParamTy (nodeBChild t) (- i 1))))))

; Allocation-free access to one argument of the canonical application spine.
(pub :: spineArgAt (-> ASTNode Int ASTNode))
(pub fn (spineArgAt e i)
  (spineArgFromEnd e (- (- (spineArgs e 0) 1) i)))

(pub :: spineArgFromEnd (-> ASTNode Int ASTNode))
(pub fn (spineArgFromEnd e k)
  (if (<= k 0)
    (nodeBChild e)
    (spineArgFromEnd (nodeAChild e) (- k 1))))

; On an APP, word 10 records that its head came from a macro name
; parameter or an expansion-time name query. The expander can then
; resolve a generated struct call without accepting positional source
; construction. On a VAR the same slot remains the definition scope.
(pub :: nodeGeneratedCall (-> ASTNode Bool))
(pub fn (nodeGeneratedCall call)
  (&& (== (nodeTag call) TAG_E_APP) (== (nodeDefScopeWord call) 1)))

(pub :: markGeneratedCall (-> ASTNode ASTNode))
(pub fn (markGeneratedCall call)
  {
    (if (== (nodeTag call) TAG_E_APP)
      (writeNodeWord call 10 1))
    call
  })

; Packet encoding is the sole public reader of an unclassified syntax word.
(pub :: nodeWireWord (-> ASTNode Int Int))
(pub fn (nodeWireWord node index)
  (nodeWord node index))

; Copy the word and its ownership role together; raw copies would lose a
; reference or release an integer when the destination changes shape.
(pub :: nodeCopyWord (-> ASTNode ASTNode Int Int))
;@axiom:effect(unsafe)
(pub fn (nodeCopyWord dst src index)
  {
    (let from (as src Int))
    (let bit (<< 1 (+ index 16)))
    (let word (__load64 from index))
    (let reference (!= (& (__load64 (- from 8) 0) bit) 0))
    (if reference
      (__retain word))
    (nodeStore dst index word reference)
  })

(pub :: nodeClone (-> ASTNode ASTNode))
(pub fn (nodeClone src)
  (if (nodeSame src nilNode)
    nilNode
    {
      (let dst (nodeWireEmpty (nodeTag src)))
      (for index in 1..13
        (nodeCopyWord dst src index))
      dst
    }))

(pub :: writeNodeMacroRules (-> ASTNode MacroRules Int))
(pub fn (writeNodeMacroRules node rules)
  (nodeStore node 9 rules true))

; A head-list macro has no rules. A present empty rule vector remains
; present so packet and tool consumers can distinguish the two states.
(pub :: nodeMacroRules (-> ASTNode (Option MacroRules)))
;@axiom:effect(unsafe)
(pub fn (nodeMacroRules node)
  (if (== (nodeWord node 9) 0)
    None
    (Some (as (nodeWord node 9) MacroRules))))

(pub :: nodeBuildFieldOffset (-> Int Int ASTNode))
(pub fn (nodeBuildFieldOffset index floating)
  {
    (let n (nodeWireEmpty TAG_FIELD))
    (writeNodeWord n 1 index)
    (writeNodeWord n 2 floating)
    n
  })

(pub :: nodeBuildFieldExtern (-> String ASTNode String Int ASTNode))
(pub fn (nodeBuildFieldExtern name ty symbol span)
  {
    (let n (nodeWireEmpty TAG_FIELD))
    (writeNodeText n 1 name)
    (writeNodeChild n 2 ty)
    (writeNodeText n 3 symbol)
    (writeNodeWord n 4 span)
    n
  })

(pub :: nodeBuildParallelBinding (-> String ASTNode Int ASTNode))
(pub fn (nodeBuildParallelBinding name value span)
  {
    (let n (nodeWireEmpty TAG_NIL))
    (writeNodeText n 1 name)
    (writeNodeChild n 2 value)
    (writeNodeWord n 4 span)
    n
  })

(pub :: setNodeTyWord (-> ASTNode Int ASTNode))
(pub fn (setNodeTyWord node value)
  {
    (writeNodeWord node 6 value)
    node
  })

(pub :: setNodeTyChild (-> ASTNode ASTNode ASTNode))
(pub fn (setNodeTyChild node value)
  {
    (writeNodeChild node 6 value)
    node
  })

(pub :: setNodeTyText (-> ASTNode String ASTNode))
(pub fn (setNodeTyText node value)
  {
    (writeNodeText node 6 value)
    node
  })

(pub :: setNodeTyChildren (-> ASTNode Nodes ASTNode))
(pub fn (setNodeTyChildren node value)
  {
    (writeNodeChildren node 6 value)
    node
  })

(pub :: setNodeTyNames (-> ASTNode Names ASTNode))
(pub fn (setNodeTyNames node value)
  {
    (writeNodeNames node 6 value)
    node
  })

(pub :: setNodeBinderTyChild (-> ASTNode ASTNode ASTNode))
(pub fn (setNodeBinderTyChild node value)
  {
    (writeNodeChild node 11 value)
    node
  })

(pub :: setNodeBinderTyText (-> ASTNode String ASTNode))
(pub fn (setNodeBinderTyText node value)
  {
    (writeNodeText node 11 value)
    node
  })

(pub :: nodeIdentityKey (-> ASTNode String))
(pub fn (nodeIdentityKey node)
  (fmtInt (as node Int)))

; The packet decoder has already taken the payload's owned share.
(pub :: nodeWireStore (-> ASTNode Int Int Bool Int))
(pub fn (nodeWireStore node index ownedWord reference)
  (nodeStore node index ownedWord reference))

(pub :: ruleParamsAt (-> MacroRules Int Names))
(pub fn (ruleParamsAt rules index)
  {
    (let rule (vecGet rules index))
    rule.params
  })

(pub :: ruleDeclsAt (-> MacroRules Int Nodes))
(pub fn (ruleDeclsAt rules index)
  {
    (let rule (vecGet rules index))
    rule.declarations
  })

(pub :: nodeSetPayload (-> ASTNode Int AstPayload Int))
(pub fn (nodeSetPayload node index payload)
  (match payload
    ((AstWord value) (writeNodeWord node index value))
    ((AstText value) (writeNodeText node index value))
    ((AstChild value) (writeNodeChild node index value))
    ((AstChildren value) (writeNodeChildren node index value))
    ((AstNames value) (writeNodeNames node index value))
    ((AstWords value) (writeNodeWords node index value))))

(pub :: nodeChildAt (-> ASTNode Int ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeChildAt node index)
  (as (nodeWord node index) ASTNode))

(pub :: nodeChildrenAt (-> ASTNode Int Nodes))
;@axiom:effect(unsafe)
(pub fn (nodeChildrenAt node index)
  (as (nodeWord node index) Nodes))

(pub :: nodeNamesAt (-> ASTNode Int Names))
;@axiom:effect(unsafe)
(pub fn (nodeNamesAt node index)
  (as (nodeWord node index) Names))

(pub :: nodeTextAt (-> ASTNode Int String))
;@axiom:effect(unsafe)
(pub fn (nodeTextAt node index)
  (as (nodeWord node index) String))

; The checker-only call stamp stores a typed substitution environment.
(pub :: nodeCTypeEnv (-> ASTNode TypeEnv))
;@axiom:effect(unsafe)
(pub fn (nodeCTypeEnv node)
  (as (nodeWord node 3) TypeEnv))

; A pending lambda owns the copied scope that supplies its captured types.
(pub :: nodeBuildPartial (-> (Vec a) Int Int ASTNode))
(pub fn (nodeBuildPartial entries own span)
  {
    (let node (nodeWireEmpty TAG_NIL))
    (nodeStore node 1 entries true)
    (writeNodeWord node 2 own)
    (writeNodeWord node 4 span)
    node
  })

(pub :: nodeAWords (-> ASTNode Ints))
;@axiom:effect(unsafe)
(pub fn (nodeAWords node)
  (as (nodeWord node 1) Ints))
