; parser.ax — recursive-descent S-expression parser.
;
; Consumes owning Tokens and produces ASTNodes.
; Dependencies: core.ax, Mem, Str, Fmt, Vec, lexer.ax.
(import Err (isSome isNone))
(import core)
(import Mem)
(import Str)
(import Fmt)
(import Utf8)
(import Vec)
(import lexer)
(import diag)
(import Float)
(import raw)

; Typed syntax handles use one packed arena boundary. The reference map
; follows the declared payload view at each write, including replacements.
(pub :: nilNode ASTNode)
;@axiom:effect(unsafe)
(pub fn (nilNode)
  (as 0 ASTNode))

(pub :: nodeSame (-> ASTNode ASTNode Bool))
(pub fn (nodeSame a b)
  (addrEq (addrOf a) (addrOf b)))

(:: nodeWord (-> ASTNode Int Int))
(fn (nodeWord n index)
  (if (nodeSame n nilNode)
    0
    (memGetWord (as n Int) index)))

(:: nodeStore (-> ASTNode Int a Bool Int))
;@axiom:effect(unsafe)
(fn (nodeStore n index value reference)
  {
    (let h (as n Int))
    (let sw (__load64 (- h 8) 0))
    (let bit (<< 1 (+ index 16)))
    (let old (__load64 h index))
    (__retainref value)
    (__store64 h index (as value Int))
    (__store64 (- h 8) 0
      (if reference
        (| sw bit)
        (& sw (^ bit (- 0 1)))))
    (if (!= (& sw bit) 0)
      (__release old))
    0
  })

(pub :: nodeWireEmpty (-> Int ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeWireEmpty tag)
  {
    (let n (as (memAllocMapped 104 0) ASTNode))
    (nodeStore n 0 tag false)
    n
  })

(pub :: readAstNode (-> Int Int ASTNode))
;@axiom:effect(unsafe)
(pub fn (readAstNode base index)
  (as (memGetWord base index) ASTNode))

(pub :: readAstNodes (-> Int Int Nodes))
;@axiom:effect(unsafe)
(pub fn (readAstNodes base index)
  (as (memGetWord base index) Nodes))

(pub :: writeNodeWord (-> ASTNode Int Int Int))
(pub fn (writeNodeWord n index value)
  (nodeStore n index value false))

(pub :: writeNodeChild (-> ASTNode Int ASTNode Int))
(pub fn (writeNodeChild n index value)
  (nodeStore n index value true))

(pub :: writeNodeChildren (-> ASTNode Int Nodes Int))
(pub fn (writeNodeChildren n index value)
  (nodeStore n index value true))

(pub :: writeNodeText (-> ASTNode Int String Int))
(pub fn (writeNodeText n index value)
  (nodeStore n index value true))

(pub :: writeNodeNames (-> ASTNode Int Names Int))
(pub fn (writeNodeNames n index value)
  (nodeStore n index value true))

(pub :: writeNodeWords (-> ASTNode Int Ints Int))
(pub fn (writeNodeWords n index value)
  (nodeStore n index value true))

(pub :: nodeAChild (-> ASTNode ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeAChild n)
  (as (nodeWord n 1) ASTNode))

(pub :: nodeAChildren (-> ASTNode Nodes))
;@axiom:effect(unsafe)
(pub fn (nodeAChildren n)
  (as (nodeWord n 1) Nodes))

(pub :: nodeAText (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (nodeAText n)
  (as (nodeWord n 1) String))

(pub :: nodeANames (-> ASTNode Names))
;@axiom:effect(unsafe)
(pub fn (nodeANames n)
  (as (nodeWord n 1) Names))

(pub :: nodeBWord (-> ASTNode Int))
(pub fn (nodeBWord n)
  (nodeWord n 2))

(pub :: nodeBChild (-> ASTNode ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeBChild n)
  (as (nodeWord n 2) ASTNode))

(pub :: nodeBChildren (-> ASTNode Nodes))
;@axiom:effect(unsafe)
(pub fn (nodeBChildren n)
  (as (nodeWord n 2) Nodes))

(pub :: nodeBNames (-> ASTNode Names))
;@axiom:effect(unsafe)
(pub fn (nodeBNames n)
  (as (nodeWord n 2) Names))

(pub :: nodeBWords (-> ASTNode Ints))
;@axiom:effect(unsafe)
(pub fn (nodeBWords n)
  (as (nodeWord n 2) Ints))

(pub :: nodeCWord (-> ASTNode Int))
(pub fn (nodeCWord n)
  (nodeWord n 3))

(pub :: nodeCChild (-> ASTNode ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeCChild n)
  (as (nodeWord n 3) ASTNode))

(pub :: nodeCChildren (-> ASTNode Nodes))
;@axiom:effect(unsafe)
(pub fn (nodeCChildren n)
  (as (nodeWord n 3) Nodes))

(pub :: nodeCNames (-> ASTNode Names))
;@axiom:effect(unsafe)
(pub fn (nodeCNames n)
  (as (nodeWord n 3) Names))

(pub :: nodeCWords (-> ASTNode Ints))
;@axiom:effect(unsafe)
(pub fn (nodeCWords n)
  (as (nodeWord n 3) Ints))

(pub :: nodeTyChild (-> ASTNode ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeTyChild n)
  (as (nodeWord n 6) ASTNode))

(pub :: nodeTyChildren (-> ASTNode Nodes))
;@axiom:effect(unsafe)
(pub fn (nodeTyChildren n)
  (as (nodeWord n 6) Nodes))

(pub :: nodeTyNames (-> ASTNode Names))
;@axiom:effect(unsafe)
(pub fn (nodeTyNames n)
  (as (nodeWord n 6) Names))

; Word 6 as text: the struct name the checker stamps on a field read or
; store (`stampFieldStruct`).
(pub :: nodeTyText (-> ASTNode String))
;@axiom:effect(unsafe)
(pub fn (nodeTyText n)
  (as (nodeWord n 6) String))

; A struct's fields are a required collection, including zero fields.
; Normalize only the packed parser's absent payload at this wire boundary.
(pub :: nodeStructFields (-> ASTNode Nodes))
(pub fn (nodeStructFields node)
  (if (== (nodeB node) 0)
    vecNew
    (nodeBChildren node)))

(pub :: nodeAxtagsWord (-> ASTNode Int))
(pub fn (nodeAxtagsWord n)
  (nodeWord n 7))

; The packed tag slot uses zero for absence; a real empty vector is present.
(pub :: nodeAxtagsOpt (-> ASTNode (Option Axtags)))
;@axiom:effect(unsafe)
(pub fn (nodeAxtagsOpt node)
  (if (== (nodeAxtagsWord node) 0)
    None
    (Some (as (nodeWord node 7) Axtags))))

; Collection queries treat absent annotations as an empty owning list.
; Presence-sensitive consumers use nodeAxtagsOpt instead.
(pub :: nodeAxtagsOf (-> ASTNode Axtags))
(pub fn (nodeAxtagsOf node)
  (match (nodeAxtagsOpt node)
    ((None) vecNew)
    ((Some tags) tags)))

(pub :: writeNodeAxtags (-> ASTNode Axtags Int))
(pub fn (writeNodeAxtags node tags)
  (nodeStore node 7 tags true))

(pub :: nodeFieldNamesWord (-> ASTNode Int))
(pub fn (nodeFieldNamesWord n)
  (nodeWord n 9))

(pub :: nodeFieldNamesNames (-> ASTNode Names))
;@axiom:effect(unsafe)
(pub fn (nodeFieldNamesNames n)
  (as (nodeWord n 9) Names))

; Preserve named-empty metadata separately from a positional constructor.
; The packed parser slot alone uses zero for missing names.
(pub :: nodeFieldNamesOpt (-> ASTNode (Option Names)))
(pub fn (nodeFieldNamesOpt node)
  (if (== (nodeFieldNamesWord node) 0)
    None
    (Some (nodeFieldNamesNames node))))

(pub :: nodeFieldNamesWords (-> ASTNode Ints))
;@axiom:effect(unsafe)
(pub fn (nodeFieldNamesWords n)
  (as (nodeWord n 9) Ints))

(pub :: nodeDefScopeWord (-> ASTNode Int))
(pub fn (nodeDefScopeWord n)
  (nodeWord n 10))

(pub :: nodeBinderTyChild (-> ASTNode ASTNode))
;@axiom:effect(unsafe)
(pub fn (nodeBinderTyChild n)
  (as (nodeWord n 11) ASTNode))

(pub :: nodeSyntaxIdentityWords (-> ASTNode Ints))
;@axiom:effect(unsafe)
(pub fn (nodeSyntaxIdentityWords n)
  (as (nodeWord n 12) Ints))

(pub :: nodeBuildTErrPlain (-> Int Int Int ASTNode))
(pub fn (nodeBuildTErrPlain a b c)
  {
    (let n (nodeWireEmpty TAG_T_ERR))
    (writeNodeWord n 1 a)
    (writeNodeWord n 2 b)
    (writeNodeWord n 3 c)
    n
  })

(pub :: nodeBuildEStr (-> String Int Int Int ASTNode))
(pub fn (nodeBuildEStr a b c sp)
  {
    (let n (nodeWireEmpty TAG_E_STR))
    (writeNodeText n 1 a)
    (writeNodeWord n 2 b)
    (writeNodeWord n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

(pub :: nodeBuildESubcheck (-> ASTNode Nodes ASTNode Int ASTNode))
(pub fn (nodeBuildESubcheck a b c sp)
  {
    (let n (nodeWireEmpty TAG_E_SUBCHECK))
    (writeNodeChild n 1 a)
    (writeNodeChildren n 2 b)
    (writeNodeChild n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

(pub :: nodeBuildEvstampCallPlain (-> ASTNode Ints TypeEnv ASTNode))
(pub fn (nodeBuildEvstampCallPlain a b c)
  {
    (let n (nodeWireEmpty TAG_EVSTAMP))
    (writeNodeChild n 1 a)
    (writeNodeWords n 2 b)
    (nodeStore n 3 c true)
    n
  })

; The checker's current declaration is optional. Only this packed AST
; boundary encodes None as nilNode; the call-stamp layout stays unchanged.
(pub :: nodeBuildEvstampCallOptional (-> (Option ASTNode) Ints TypeEnv ASTNode))
(pub fn (nodeBuildEvstampCallOptional declaration words env)
  (nodeBuildEvstampCallPlain
    (match declaration
      ((None) nilNode)
      ((Some node) node))
    words env))

(pub :: nodeBuildBinding (-> Int String ASTNode ASTNode Int ASTNode))
(pub fn (nodeBuildBinding tag a b c sp)
  {
    (let n (nodeWireEmpty tag))
    (writeNodeText n 1 a)
    (writeNodeChild n 2 b)
    (writeNodeChild n 3 c)
    (writeNodeWord n 4 sp)
    n
  })

