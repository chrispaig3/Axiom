;;! What every word of the language means: keywords, builtin types,
;;! builtin effects, operators, literals and AXTAG keys and values,
;;! each with the form it takes, a short explanation and the section of
;;! `docs/reference.md` that covers it.
;;!
;;! Hover reads it for a word no declaration explains, `axiom explain`
;;! answers a keyword from it, and `axiom doc` renders it as the
;;! language index. `scripts/check-lexicon.sh` holds it to the parser's
;;! keyword set, the checker's AXTAG keys and the reference's anchors.
;
; Every entry answers three strings: the FORM (what goes in the code
; fence), the DOC (Markdown prose) and the ANCHOR (a `reference.md#...`
; target). "" from `lexForm` means the word is not in the lexicon.
;
; The tables are `if` chains on the word, the shape every other table
; in this compiler takes (`isBuiltinName`, `explainText`), so that a
; row is one place to read and one place to edit.
(import Str)
(import nolint)

; ------------------------------------------------------------------
; Kinds
; ------------------------------------------------------------------
; Whether `w` is one of the space-separated words in `set`. The tables
; below are sets of words, and a set written as one string reads as
; one.
(:: lexIn (-> String String Bool))
(fn (lexIn w set)
  {
    (let parts (strSplit set 32))
    (let mut i 0)
    (let mut hit false)
    {
      (while (< i (vecLen parts))
        {
          (if (strEq (vecGet parts i) w)
            (set hit true))
          (set i (+ i 1))
        })
      hit
    }
  })

;; The kind of a lexicon word: `keyword`, `type`, `effect`, `operator`,
;; `literal`, `form` (a word that is special inside a form) or "" when
;; the word is not in the lexicon.
(pub :: lexKind (-> String String))
(pub fn (lexKind w)
  (if (lexIn w
        "fn lambda let set if match while for data struct type subtype effect handle region parallel macro import pub extern syntax/for alloc begin cond consume define union foreign trait impl emacro cast")
    "keyword"
    (if (lexIn w
          "mut in by is range :: -> .. ? _ |> as sizeof alignof asm syntax/join syntax/binders syntax/constructors syntax/arity syntax/fields decl")
      "form"
      (if (lexIn w
            "Int Int8 Int16 Int32 UInt8 UInt16 UInt32 UInt64 Float Bool Char String Foreign Handle Vec Link Option Result Addr ()")
        "type"
        (if (lexIn w "IO Alloc Mut Unsafe Spawn Block Entropy Div Pure")
          "effect"
          (if (lexIn w "+ - * / % & | ^ << >> == != < > <= >= && || !")
            "operator"
            (if (lexIn w "true false Some None Ok Err")
              "literal"
              "")))))))

; ------------------------------------------------------------------
; Forms: what goes in the code fence
; ------------------------------------------------------------------
;; The form a word takes, as the line a hover quotes in its fence, or
;; "" when the word is not in the lexicon.
(:: lexForm (-> String String))
(fn (lexForm w)
  (if (strEq w "|>")
    "(|> value (f args...) (g args...))"
    (if (strEq w "fn")
      "(fn (name param ...) body)"
      (if (strEq w "lambda")
        "(lambda (param ...) body)"
        (if (strEq w "let")
          "(let name value)"
          (if (strEq w "set")
            "(set slot value)"
            (if (strEq w "if")
              "(if test then else)\n(if test then)\n(if t1 b1 t2 b2 ... else)"
              (if (strEq w "match")
                "(match value (pattern body) ... (_ body))"
                (if (strEq w "while")
                  "(while test body)"
                  (if (strEq w "for")
                    "(for i in lo..hi body)\n(for i in lo..hi by step body)\n(for x in vec body)\n(for (x i) in vec body)"
                    (if (strEq w "data")
                      "(data Name (Ctor Type ...) ...)\n(data Name (a) (Ctor a) ...)"
                      (if (strEq w "struct")
                        "(struct Name (field : Type) ...)"
                        (if (strEq w "type")
                          "(type Name Type)"
                          (if (strEq w "subtype")
                            "(subtype Name is Int range lo..hi)"
                            (if (strEq w "effect")
                              "(effect Name (op :: Type) ...)"
                              (if (strEq w "handle")
                                "(handle body (Effect ...) handler)"
                                (if (strEq w "region")
                                  "(region r body)"
                                  (if (strEq w "parallel")
                                    "(parallel ((name expr) ...) body)"
                                    (if (strEq w "macro")
                                      "(macro (name param ...) template)\n(macro name ((name pattern ...) template) ...)"
                                      (if (lexIn w "emacro cast")
                                        (if (strEq w "emacro")
                                          "(emacro name rule ...)  ; removed: write (macro name rule ...)"
                                          "(cast Type value)  ; removed: write (as value Type)")
                                        (if (strEq w "import")
                                          "(import Module)\n(import Module (name ...))"
                                          (if (strEq w "pub")
                                            "(pub :: name Type)\n(pub fn (name ...) body)"
                                            (if (strEq w "extern")
                                              "(extern \"crate\" (name :: Type (symbol \"sym\")) ...)"
                                              (if (strEq w "syntax/for")
                                                "(syntax/for (C (syntax/constructors T)) template)"
                                                (lexFormMore w)))))))))))))))))))))))))

(:: lexFormMore (-> String String))
(fn (lexFormMore w)
  (if (strEq w "alloc")
    "(alloc Type)          ; removed"
    (if (strEq w "begin")
      "(begin a b c)         ; removed: write { a b c }"
      (if (strEq w "cond")
        "(cond (t1 b1) (t2 b2) else)   ; removed: write (if t1 b1 t2 b2 else)"
        (if (strEq w "consume")
          "(consume x)           ; removed"
          (if (strEq w "define")
            "(define (name ...) body)     ; removed: write (fn (name ...) body)"
            (if (strEq w "union")
              "(union Name ...)      ; removed: write (data Name ...)"
              (if (strEq w "foreign")
                "(foreign ...)         ; removed: write (extern ...)"
                (if (|| (strEq w "trait") (strEq w "impl"))
                  "(trait Name ...)  (impl Name for Type ...)   ; removed"
                  (lexFormWords w))))))))))

(:: lexFormWords (-> String String))
(fn (lexFormWords w)
  (if (strEq w "mut")
    "(let mut name value)"
    (if (strEq w "in")
      "(for x in xs body)"
      (if (strEq w "by")
        "(for i in lo..hi by step body)"
        (if (strEq w "is")
          "(subtype Name is Int range lo..hi)"
          (if (strEq w "range")
            "(subtype Name is Int range lo..hi)"
            (if (strEq w "::")
              "(:: name Type)"
              (if (strEq w "->")
                "(-> Arg ... Result)"
                (if (strEq w "?")
                  "(f x)?"
                  (if (strEq w "..")
                    "lo..hi"
                    (if (strEq w "_")
                      "(match v (_ body))\n(f _ 2)"
                      (if (strEq w "as")
                        "(as value Type)"
                        (if (strEq w "sizeof")
                          "(sizeof Type)"
                          (if (strEq w "alignof")
                            "(alignof Type)"
                            (if (strEq w "asm")
                              "(asm (ARCH \"template\" operand...) ...)"
                              (if (strEq w "syntax/join")
                                "(syntax/join prefix Name)"
                                (if (strEq w "syntax/binders")
                                  "(syntax/binders Ctor x)"
                                  (if (strEq w "syntax/constructors")
                                    "(syntax/constructors Type)"
                                    (if (strEq w "syntax/arity")
                                      "(syntax/arity Ctor)"
                                      (if (strEq w "syntax/fields")
                                        "(syntax/fields Struct)"
                                        (if (strEq w "decl")
                                          "(decl declaration ...)"
                                          (lexFormType w))))))))))))))))))))))

(:: lexFormType (-> String String))
(fn (lexFormType w)
  (if (lexIn w "Int Int8 Int16 Int32 UInt8 UInt16 UInt32 UInt64")
    w
    (if (strEq w "Float")
      "Float"
      (if (strEq w "Bool")
        "Bool"
        (if (strEq w "Char")
          "Char"
          (if (strEq w "String")
            "String"
            (if (strEq w "Foreign")
              "Foreign"
              (if (strEq w "Handle")
                "Handle"
                (if (strEq w "Vec")
                  "(Vec a)"
                  (if (strEq w "Link")
                    "(Link a w)\n(linkTo v i)  linkNone"
                    (if (strEq w "Option")
                      "(Option a)\n(Some x)  None"
                      (if (strEq w "Result")
                        "(Result a e)\n(Ok x)  (Err e)"
                        (if (strEq w "Addr")
                          "Addr"
                          (if (strEq w "()")
                            "()\n(:: log (-> String ()))"
                            (lexFormEffect w)))))))))))))))

(:: lexFormEffect (-> String String))
(fn (lexFormEffect w)
  (if (lexIn w "IO Alloc Mut Unsafe Spawn Block Entropy Div Pure")
    (concat ";@axiom:effect(" (concat (strLower w) ")"))
    (lexFormOperator w)))

(:: lexFormOperator (-> String String))
(fn (lexFormOperator w)
  (if (lexIn w "+ - * / % & | ^ << >>")
    (concat "(:: " (concat w " (-> Int Int Int))"))
    (if (lexIn w "== != < > <= >=")
      (concat "(:: " (concat w " (-> Int Int Bool))"))
      (if (lexIn w "&& ||")
        (concat "(:: " (concat w " (-> Bool Bool Bool))"))
        (if (strEq w "!")
          "(:: ! (-> Bool Bool))"
          (lexFormLiteral w))))))

(:: lexFormLiteral (-> String String))
(fn (lexFormLiteral w)
  (if (lexIn w "true false")
    (concat "(:: " (concat w " Bool)"))
    (if (strEq w "Some")
      "(Some value) : (Option a)"
      (if (strEq w "None")
        "None : (Option a)"
        (if (strEq w "Ok")
          "(Ok value) : (Result a e)"
          (if (strEq w "Err")
            "(Err error) : (Result a e)"
            ""))))))

; ------------------------------------------------------------------
; Prose
; ------------------------------------------------------------------
;; The explanation of a word, as Markdown, or "" when the word is not
;; in the lexicon.
(:: lexDoc (-> String String))
(fn (lexDoc w)
  (if (strEq w "|>")
    "Passes a value through calls from left to right. Each stage receives the preceding result as its first argument; one direct `_` places it elsewhere. Every intermediate result is evaluated once. Types, effects and region checks are the same as for ordinary calls."
    (if (strEq w "fn")
      "Declares a named function at the top level. Its type comes from the `(:: name Type)` signature above it, and AXTAGs such as `;@axiom:effect(io)` go between the two. A function value inside an expression is a `lambda`; `(fn (x) ...)` there is refused with `AX2004`."
      (if (strEq w "lambda")
        "An anonymous function. It captures the bindings it uses, can be passed as a value and may be applied to fewer arguments than it takes, answering another lambda. A `lambda` with no parameters is refused with `AX3068`."
        (if (strEq w "let")
          "Declares a local inside a `{ ... }` block. The value is evaluated before the name enters scope; later statements can read it, and a later declaration can shadow it. Use `(let mut name value)` for a local that `set` can change. Destructure values with `match`. The block answers its last expression."
          (if (strEq w "set")
            "Overwrites a `mut` slot. The slot owns what it holds, so the previous value is released (`MM-MUT-1`). Writing to a binding that is not `mut` is `AX3012`."
            (if (strEq w "if")
              "Branches on a `Bool`. Both branches must have the same type, unless one is `()`: then the `if` answers `()` and the other branch's value is dropped. Leave out the else and the `if` supplies `()`, so `(if done (println \"ok\"))` needs no filler. With more operands it is a chain: `(if t1 b1 t2 b2 else)` is `(if t1 b1 (if t2 b2 else))`. Use braces for a branch of several expressions."
              (if (strEq w "match")
                "Compares a value against patterns in order and runs the first body that fits. A pattern is a constructor with binders, a literal, a name or `_`. A `match` that misses a constructor is `AX3005`; a bare capitalised name such as `None` binds a variable rather than testing a tag, so write `(None)`."
                (if (strEq w "while")
                  "Repeats the body while the `Bool` test is true. There is no `break` or `continue`: put the stopping condition in the test. The form answers 0."
                  (if (strEq w "for")
                    "Counts over a range, `lo` included and `hi` excluded, with an optional `by step`, or walks a `Vec` by element or by `(x i)` element and index. The sequence is evaluated once. A `for` body is for effects, and the form answers 0."
                    (if (strEq w "data")
                      "Declares a sum type: a set of constructors, each with zero or more field types. Constructors start with a capital, build values when applied and take values apart in `match`. Type parameters go in a list after the name."
                      (if (strEq w "struct")
                        "Declares a product type with named, typed fields. Build one with named values, `(Point :x 1 :y 2)`, and read a field with a dot, `p.x`. Supply each field exactly once. Values are evaluated in written order. A field declaration without its `:` is refused with `AX3056`."
                        (if (strEq w "type")
                          "Gives an existing type a second name. Declare parameters between the name and the target, `(type Items a (Vec a))`, and apply them in type position, `(Items Int)`. Aliases expand transparently and must be finite."
                          (if (strEq w "subtype")
                            "Declares a range-constrained `Int`, `(subtype Port is Int range 1..65536)`. A value is checked against the range when it enters the subtype, and a failed check stops the program with its own message."
                            (if (strEq w "effect")
                              "Declares an effect: a name and the operations it provides, each with a signature. A call to an operation runs the innermost `handle` for its effect. A declared effect cannot take a built-in effect's name (`AX3054`), and an operation needs a type (`AX3055`)."
                              (if (strEq w "handle")
                                "Runs a body with a handler installed for an effect's operations. The list names every effect the body performs: a declared effect is intercepted and a built-in one is acknowledged and still reaches the caller. The handler's return value is the operation's result."
                                (if (strEq w "region")
                                  "Opens a named arena scope. Values allocated inside it are released together when the body ends, and a value that would leave it is refused (`AX3059`). The compiler infers reference origins through calls and refuses stores into older objects."
                                  (if (strEq w "parallel")
                                    "Evaluates its bindings at the same time, each on its own task, and runs the body once all of them have answered. A binding may capture a parent value only by borrowing it for the extent of the form (`AX3064`)."
                                    (if (strEq w "macro")
                                      "Declares a macro: a template substituted at its invocation before the type checker runs. The one-rule form names the parameters in the head; the multi-rule form lists patterns and a template for each, which is declarations or one expression, and where the macro is invoked picks which. Hygiene renames the binders a template introduces."
                                      (if (lexIn w "emacro cast")
                                        (if (strEq w "emacro")
                                          "Removed. It was the multi-rule form for expression templates; `macro` takes the same rules, `(macro total ((total x) x) ((total x rest ...) (+ x (total rest ...))))`. The compiler refuses the word with `AX2004`."
                                          "Removed. Write `(as value Type)`, with the value before its target type. Numeric conversions change the number; reference conversions retain their checked ownership and unsafe obligations. The compiler refuses `cast` with `AX2004`.")
                                        (if (strEq w "import")
                                          "Brings a module's public names into scope, all of them or the ones listed. A module is a file in the standard library, on `AXIOM_PATH` or in a dependency. A name declared in two imported modules is `AX3014` when used bare."
                                          (if (strEq w "pub")
                                            "Marks a declaration as public, so other modules can import it. A signature and its function are each marked. A name used from a module that does not export it is `AX3023`."
                                            (if (strEq w "extern")
                                              "Binds functions from a Rust crate built by `axiom fetch`. Each item gives the Axiom type and the symbol it binds; a type that cannot cross the boundary is `AX3036`. Calling one is an `Unsafe` operation."
                                              (if (strEq w "syntax/for")
                                                "Inside a macro template, repeats the template once for each element of a syntax query such as `(syntax/constructors T)`, binding the pattern variable to each."
                                                (lexDocRemoved w)))))))))))))))))))))))))

(:: lexDocRemoved (-> String String))
(fn (lexDocRemoved w)
  (if (strEq w "alloc")
    "Removed. The form typed as a pointer and evaluated to 0, so a program holding one held no memory. Allocate with a constructor, a `struct` or a library function; the compiler refuses the word with `AX2004`."
    (if (strEq w "begin")
      "Removed. Sequence expressions with a brace block, `{ a b c }`, which answers its last expression. The compiler refuses the word with `AX2004`."
      (if (strEq w "cond")
        "Removed. Write the chain with `if`: `(if t1 b1 t2 b2 else)` nests as `(if t1 b1 (if t2 b2 else))`. The compiler refuses the word with `AX2004`."
        (if (strEq w "consume")
          "Removed. It was a parse-time marker that enforced nothing. Ownership follows the memory model's rules without it; the compiler refuses the word with `AX2004`."
          (if (strEq w "define")
            "Removed. It was the old spelling of `fn`, and a language with two spellings of one thing makes every reader learn both. The compiler refuses the word with `AX2004`."
            (if (strEq w "union")
              "Removed. An untagged union cannot be pattern-matched safely, since its variants are not distinguishable at run time. Use `data`; the compiler refuses the word with `AX2004`."
              (if (strEq w "foreign")
                "Removed. Bind native code with `extern`, which names the crate and checks each item's type. The compiler refuses the word with `AX2004`."
                (if (lexIn w "trait impl")
                  "Removed. Traits and impls are not part of the language; write the function you want, or derive one with a macro such as `deriveEq`. The compiler refuses the word with `AX2004`."
                  (lexDocForm w))))))))))

(:: lexDocForm (-> String String))
(fn (lexDocForm w)
  (if (strEq w "mut")
    "Marks a `let` binding as a slot that `set` can overwrite. The slot owns what it holds and releases what `set` replaces (`MM-MUT-1`)."
    (if (strEq w "in")
      "Separates the loop variable of a `for` from the range or `Vec` it walks."
      (if (strEq w "by")
        "Gives a `for` over a range its stride. A negative stride counts down; a literal zero stride is refused."
        (if (strEq w "is")
          "In a `subtype`, names the base type the new type refines."
          (if (strEq w "range")
            "In a `subtype`, gives the inclusive bounds a value must satisfy."
            (if (strEq w "::")
              "A type signature. At the top level it declares the type of the function or constant below it, `(:: bump (-> Int Int))`. Inside an `effect`, it types an operation. Two signatures for one name are refused with `AX3006`."
              (if (strEq w "->")
                "A function type: the argument types, then the result. `(-> Int String)` takes an `Int` and answers a `String`; `(-> a a)` answers the type it takes."
                (if (strEq w "?")
                  "Propagates a `Result` or an `Option`. In a function that answers a `Result`, `(f x)?` answers the `Ok` payload and an `Err` returns from the function. In a function that answers an `Option`, it answers the `Some` payload and `None` returns from the function. Nothing after the `?` runs. This includes a branch, a `let` body, a loop, a region or a handler. A `Result` leaves a region only when its payload and its error are both scalars."
                  (if (strEq w "..")
                    "A range, `lo` included and `hi` excluded in `for`, both included in a `subtype`'s `range`."
                    (if (strEq w "_")
                      "The wildcard. In a pattern it matches anything and binds nothing. In a call, `(f _ 2)` builds a lambda over the missing arguments from left to right."
                      (if (strEq w "as")
                        "Converts a value to the written type. Int and Float conversions operate on numeric values; floatToBits and floatFromBits reinterpret bits. A reference converted to a word, such as `Int` or `Foreign`, keeps no ownership share: keep the owner alive while using the word. Outside the compiler and the standard library that cast requires `effect(unsafe)`. For identity comparisons and hashing, use `addrOf`. Converting a word to a reference requires `effect(unsafe)`, a valid representation and a live backing owner. A conversion never extends a region's scope."
                        (if (strEq w "sizeof")
                          "The size in bytes of a type's representation. Takes exactly one type (`AX3069`)."
                          (if (strEq w "alignof")
                            "The alignment in bytes of a type's representation. Takes exactly one type (`AX3069`)."
                            (if (strEq w "asm")
                              "Inline assembly: one arm per architecture, each a template and its operands. A form the compiler cannot lower is `AX3091`, and a template line the assembler rejects is `AX3117`, reported at that line when the program is built. See the reference's inline assembly section for the operands and options."
                              (if (strEq w "syntax/join")
                                "Inside a macro template, builds a name from parts: `(syntax/join eq T)` with `T` bound to `Colour` is `eqColour`."
                                (if (strEq w "syntax/binders")
                                  "Inside a macro template, the binder list for a constructor's fields, so a pattern can take any constructor apart without knowing its arity."
                                  (if (strEq w "syntax/constructors")
                                    "Inside a macro template, the constructors of a `data` type, answered from the declaration list at expansion time."
                                    (if (strEq w "syntax/arity")
                                      "Inside a macro template, how many fields a constructor carries, folded to a literal."
                                      (if (strEq w "syntax/fields")
                                        "Inside a macro template, the fields of a `struct`, each as a name and a type."
                                        (if (strEq w "decl")
                                          "Inside a declaration macro, splices the declarations it holds into the module."
                                          (lexDocType w))))))))))))))))))))))

(:: lexDocType (-> String String))
(fn (lexDocType w)
  (if (strEq w "Int")
    "A signed 64-bit integer. Arithmetic wraps. It is also the word a handle or an address is carried in at the raw-memory level, which is why a heap value returned where a signature says `Int` is refused (`AX3004`)."
    (if (lexIn w "Int8 Int16 Int32 UInt8 UInt16 UInt32 UInt64")
      "A distinct fixed-width integer. Use `(as value Type)` to convert explicitly. Arithmetic wraps at its width; division by zero, signed division overflow and out-of-range shifts trap. Literals remain Int."
      (if (strEq w "Float")
        "An IEEE 754 binary64 number. Convert explicitly with `(as value Float)` and `(as value Int)`. Numeric types never widen or narrow implicitly. Use `floatToBits` and `floatFromBits` to reinterpret bits."
        (if (strEq w "Bool")
          "`true` or `false`. The test of `if` and `while`, and the result of the comparison and logical operators."
          (if (strEq w "Char")
            "A Unicode code point. `Utf8` and `Str` convert between characters and byte strings."
            (if (strEq w "String")
              "A byte string. Literals support `{name}` holes that interpolate a binding in scope. The `Str` module reads and builds them."
              (if (strEq w "Foreign")
                "An externally owned pointer. The compiler never follows or releases it; the code that received it is responsible for it."
                (if (strEq w "Handle")
                  "A counted owner with an external destructor, which runs when the last share is released."
                  (if (strEq w "Vec")
                    "A growable vector of `a`. It owns its elements and is released at the end of its scope (`MM-LIFE-2m`). Build one with `vecNew`; `Vec` has the accessors."
                    (if (strEq w "Link")
                      "An index into a `(Vec a)` that takes no share, stored in a struct field as `w`: `UInt8`, `UInt16` or `UInt32` (`MM-VAL-10b`). Make one with `linkTo`; `Link` has the accessors."
                      (if (strEq w "Option")
                        "A value that may be absent: `(Some x)` or `None`. Take it apart with `match`, writing the arms `((Some x) ...)` and `((None) ...)`. Library functions answer it instead of a sentinel."
                        (if (strEq w "Result")
                          "Success or failure: `(Ok x)` or `(Err e)`. The `Err` module declares it with `Error`, and a postfix `?` unwraps one inside a function that answers a `Result`. A `Result` left unused in statement position is `AX3046`."
                          (if (strEq w "Addr")
                            "The identity of a heap value, from `addrOf`, for comparing values by identity and hashing them without a cast."
                            (if (strEq w "()")
                              "The unit type, and its one value. A function declared to answer `()` drops its body's value, an `if` without an else answers `()`, and a `()` branch or `match` arm makes the whole form answer `()`. Using a `()` where a value is wanted is a type error, so a dropped value can't be read by mistake."
                              (lexDocEffect w))))))))))))))))

(:: lexDocEffect (-> String String))
(fn (lexDocEffect w)
  (if (strEq w "IO")
    "Reaches the outside world: a syscall, an `extern` call or the command line. It propagates through calls, so a function that performs IO without declaring `;@axiom:effect(io)` is `AX3042`."
    (if (strEq w "Alloc")
      "Allocates, resets the arena or installs a handler. Inferred through calls; `effect(alloc)` checks a claim and `restrict(no-alloc)` forbids it. Ordinary functions need not declare it. Generated retains and releases carry no separate reclamation effect."
      (if (strEq w "Mut")
        "Changes heap state that something else can see. Inferred through calls; `effect(mut)` checks a claim. Ordinary functions need not declare it. Reference-count bookkeeping does not add `Mut`."
        (if (strEq w "Unsafe")
          "Uses a raw-memory primitive, calls an `extern`, forges a reference or erases one. A function that does so must declare `;@axiom:effect(unsafe)` (`AX3073`), which makes it a trusted wrapper; the effect does not propagate to callers. Its author must uphold address, layout and lifetime obligations for every well-typed call. Type, effect and restriction checks still apply."
          (if (strEq w "Spawn")
            "Creates a task, thread or process."
            (if (strEq w "Block")
              "Waits: a join, a lock, a read that may not return at once."
              (if (strEq w "Entropy")
                "Draws randomness from the system or the hardware."
                (if (strEq w "Div")
                  "Possible divergence. Nothing infers it, so an `effect(div)` claim is refused with `AX3110`."
                  (if (strEq w "Pure")
                    "Performs no effect at all. Claim it with `;@axiom:effect(pure)`; a body that performs one is `AX3010`."
                    (lexDocOperator w)))))))))))

(:: lexDocOperator (-> String String))
(fn (lexDocOperator w)
  (if (lexIn w "+ - *")
    "Arithmetic over two `Int`s or two `Float`s. Integer arithmetic wraps on overflow; floating-point arithmetic uses IEEE 754 binary64. Mixed numeric types require explicit conversion."
    (if (lexIn w "/ %")
      "Integer division and remainder, truncating toward zero. Division by zero stops the program."
      (if (lexIn w "& | ^")
        "Bitwise and, or and exclusive or over two `Int`s."
        (if (lexIn w "<< >>")
          "Shifts an `Int` left or right by a number of bits; the right shift is arithmetic."
          (if (lexIn w "== !=")
            "Equality of two `Int`s. Strings compare with `strEq`, and heap values by identity with `addrOf`."
            (if (lexIn w "< > <= >=")
              "Compares two `Int`s and answers a `Bool`."
              (if (lexIn w "&& ||")
                "Logical and, or over two `Bool`s. Both operands are evaluated."
                (if (strEq w "!")
                  "Logical not."
                  (lexDocLiteral w))))))))))

(:: lexDocLiteral (-> String String))
(fn (lexDocLiteral w)
  (if (lexIn w "true false")
    "A `Bool` literal. The two names are reserved: a binding or declaration called `true` or `false` is refused (`AX3094`)."
    (if (strEq w "Some")
      "The present case of `Option`. In a pattern, `((Some x) ...)` binds the value."
      (if (strEq w "None")
        "The absent case of `Option`. In a pattern write `((None) ...)`: a bare `None` arm is a variable pattern that matches anything."
        (if (strEq w "Ok")
          "The success case of `Result`."
          (if (strEq w "Err")
            "The failure case of `Result`, carrying an error value."
            ""))))))

; ------------------------------------------------------------------
; Anchors into the reference
; ------------------------------------------------------------------
;; The `reference.md#anchor` that covers a word, or "" when the word is
;; not in the lexicon.
(:: lexAnchor (-> String String))
(fn (lexAnchor w)
  (concat "reference.md#" (lexAnchorSlug w)))

(:: lexAnchorSlug (-> String String))
(fn (lexAnchorSlug w)
  (if (strEq w "?")
    "propagate-an-error-with-"
    (if (lexIn w "fn :: -> |>")
      "functions"
      (if (strEq w "lambda")
        "lambdas"
        (if (strEq w "_")
          "partial-application"
          (if (lexIn w "let set")
            "let-bindings"
            (if (strEq w "mut")
              "mutable-bindings"
              (if (strEq w "if")
                "if"
                (if (strEq w "while")
                  "while-loops"
                  (if (lexIn w "for in by ..")
                    "for-loops"
                    (if (strEq w "data")
                      "algebraic-data-types"
                      (if (strEq w "match")
                        "pattern-matching"
                        (if (strEq w "struct")
                          "structs"
                          (if (strEq w "type")
                            "type-aliases"
                            (if (lexIn w "subtype is range")
                              "range-constrained-subtypes"
                              (if (lexIn w "effect handle")
                                "effects"
                                (if (strEq w "region")
                                  "regions"
                                  (if (strEq w "parallel")
                                    "concurrency"
                                    (if (lexIn w
                                          "macro syntax/for syntax/join syntax/binders syntax/constructors syntax/arity syntax/fields decl")
                                      "macros"
                                      (if (lexIn w "import pub")
                                        "modules-and-imports"
                                        (if (strEq w "extern")
                                          "calling-rust"
                                          (if (strEq w "asm")
                                            "inline-assembly"
                                            (if (lexIn w
                                                  "alloc begin cond consume define union foreign trait impl emacro cast")
                                              "removed-features"
                                              (if (lexIn w "as sizeof alignof")
                                                "types"
                                                (if (lexIn w
                                                      "Addr Vec Option Result Some None Ok Err")
                                                  "standard-library"
                                                  (if (strEq (lexKind w) "type")
                                                    "primitive-types"
                                                    (if (strEq (lexKind w) "effect")
                                                      "effects"
                                                      (if (strEq (lexKind w) "operator")
                                                        "operators"
                                                        (if (lexIn w "true false")
                                                          "literals"
                                                          "")))))))))))))))))))))))))))))

; ------------------------------------------------------------------
; AXTAG keys and values
; ------------------------------------------------------------------
;; What a checked or recorded AXTAG key means, as Markdown, or "" for
;; a key the compiler does not know. A key with a namespace of your
;; own, `;@axiom:my:owner(...)`, is recorded without being checked.
(:: lexTagKeyDoc (-> String String))
(fn (lexTagKeyDoc k)
  (if (strEq k "compute")
      "Requires the named Int-to-Int callback to be a checked numeric computation (`AX3131`). It accepts canonical primitive captures, explicit conversions, numeric helpers and local accumulators. It rejects references, heap/raw stores, runtime observers, allocation, foreign/opaque calls and assembly, transitively. Forward only the exact parameter with the same contract. Local mutation retains its Mut effect; normal type and effect checks apply."
    (strEq k "scoped")
      "Requires the named callback to return a scalar and retain none of each invocation's reference arguments or fresh allocations in captured state. Pass a lambda directly, a non-nullary function declaration, or a parameter carrying the same contract. Call the tagged function directly with all declared arguments (`AX3130`). Escaping stores are `AX3060`; ordinary type and effect checks still apply. Raw reclamation remains the callee's unsafe obligation."
    (strEq k "effect")
      "Claims the one effect the function performs: `io`, `unsafe` or `pure`. The checker compares the claim with what the body does and refuses a mismatch (`AX3010`); a required effect left undeclared is `AX3042`. One effect per tag (`AX3076`), and purity is spelled `effect(pure)` (`AX3078`)."
    (if (strEq k "restrict")
      "Claims what the function never does, transitively: `no-alloc`, `no-io`, `no-unsafe`, `no-block`, `no-spawn`, `no-recursion`, `no-trap` and the others. A violated claim is `AX3049`; add `strict` to refuse a claim the walk cannot prove instead of receiving `AX3051`."
      (if (strEq k "pre")
        "A precondition over the arguments, checked on every call. A failed check traps with status 80. A condition the compiler cannot compile into a check is `AX3050`."
        (if (strEq k "post")
          "A postcondition over `result`, checked on every return. A failed check traps with status 80."
          (if (strEq k "isr")
            "Marks an interrupt entry point: a no-argument function checked for allocation, recursion and waiting. On `baremetal-aarch64`, `isr(irq)` binds the interrupt handler and `isr(fault)` the fault policy."
            (if (strEq k "nolint")
              "Quiets hints and warnings, like Rust's `#[allow]`: a hint by name (`lint-dead-branch`, `lint-bool-if`, `lint-unused-let`, `lint-axql`), a warning by its code (`AX3037`), or a group (`hints`, `warnings`, `all`). On a declaration it covers that declaration; above an `import` it covers the whole file. It never quiets an error, and a name nothing answers to draws `lint-unknown-nolint` at the tag."
              (if (strEq k "ct")
                "Claims the function runs in constant time with respect to the named parameters, for code that handles secrets. A body that branches or indexes on one is refused (`AX3092`); a claim naming no parameter is `AX3093`."
                (if (strEq k "deprecated")
                  "Marks a name as deprecated with a message. Each use draws `AX3048` quoting it, and a release may retire the name under the compatibility rules."
                  (if (strEq k "unhandled")
                    "`unhandled(trap)` on an `effect` declaration says that an operation reaching `main` with no handler is intended to stop the program, which turns `AX3053` off for it."
                    (if (strEq k "syscall")
                      "Names the effects a raw syscall number performs, so every function that names the number owes them. The value is a comma list of effect names."
                      (if (strEq k "result")
                        "`result(owned)` says the function's type-variable result carries a share the caller owns, so the caller releases it at scope end, after a call or when it is discarded, as `vecPop`'s is. Accepted only beside `effect(unsafe)`, since the checker cannot see a share transferred through a raw load (`AX3116`)."
                        ""))))))))))))

;; What a value of an AXTAG key means, or "" when the pair is not one
;; the lexicon knows.
(pub :: lexTagValueDoc (-> String String String))
(pub fn (lexTagValueDoc k v)
  (if (strEq k "effect")
    (if (strEq v "io")
      "The function reaches the outside world: a syscall, an `extern` call or the command line."
      (if (strEq v "unsafe")
        "The function uses a raw-memory primitive, calls an `extern`, forges a reference or erases one. The claim makes it a trusted wrapper, and callers inherit nothing."
        (if (strEq v "pure")
          "The function performs no effect. A body that performs one is `AX3010`."
          (if (strEq v "div")
            "Refused: nothing infers divergence, so the claim can never be checked (`AX3110`)."
            (if (lexIn v "alloc mut spawn block entropy")
              "An effect the compiler infers and reports. Only `io`, `unsafe` and `pure` are declared; this one is read from the body."
              "")))))
    (if (strEq k "restrict")
      (lexRestrictionDoc v)
      (if (strEq k "isr")
        (if (strEq v "irq")
          "The interrupt handler. On `baremetal-aarch64` the image binds it to the interrupt vector."
          (if (strEq v "fault")
            "The fault policy: what runs when an exception is taken instead of the default register dump and exit 81."
            ""))
        (if (strEq k "unhandled")
          (if (strEq v "trap")
            "An operation of this effect that reaches `main` unhandled stops the program, by design."
            "")
          (if (strEq k "result")
            (if (strEq v "owned")
              "The caller owns the result's share and hands it back; the one value this key takes."
              "")
            (if (strEq k "nolint")
              (if (strEq v "lint-dead-branch")
                "The hint that an `if` test is constant, so one branch never runs."
                (if (strEq v "lint-bool-if")
                  "The hint that an `if` answers `true` and `false`, which the test already is."
                  (if (strEq v "lint-unused-let")
                    "The hint that a `let` binding is never read."
                    (if (strEq v "lint-axql")
                      "The hint that a query literal does not parse as AXQL."
                      (if (strEq v "hints")
                        "Every editor hint."
                        (if (strEq v "warnings")
                          "Every checker warning, such as `AX3037`. Errors stay."
                          (if (strEq v "all")
                            "Every editor hint and every checker warning. Errors stay."
                            (if (nolintIsCode v)
                              "This warning code, where the checker draws it on this declaration. An error code quiets nothing."
                              ""))))))))
              "")))))))

(:: lexRestrictionDoc (-> String String))
(fn (lexRestrictionDoc v)
  (if (strEq v "no-alloc")
    "Nothing reachable from here allocates, resets the arena or installs a handler."
    (if (strEq v "no-io")
      "Nothing reachable from here performs IO."
      (if (strEq v "no-unsafe")
        "Nothing reachable from here uses a raw-memory primitive or calls an `extern`."
        (if (strEq v "no-block")
          "Nothing reachable from here waits."
          (if (strEq v "no-spawn")
            "Nothing reachable from here creates a task, thread or process."
            (if (strEq v "no-entropy")
              "Nothing reachable from here draws randomness."
              (if (strEq v "no-recursion")
                "No call cycle passes through here, so the stack depth is bounded."
                (if (strEq v "no-trap")
                  "Nothing reachable from here can stop the program with a trap: no failed contract, no out-of-range index, no division by zero."
                  (if (strEq v "no-cast")
                    "Nothing reachable from here uses `as`."
                    (if (strEq v "no-escape")
                      "No value allocated here leaves the function."
                      (if (strEq v "no-foreign")
                        "Nothing reachable from here calls an `extern`."
                        (if (strEq v "no-rendering")
                          "Nothing reachable from here renders a value into a format string."
                          (if (strEq v "no-wrap")
                            "No integer arithmetic reachable from here can wrap."
                            (if (strEq v "strict")
                              "Refuse the claim when the walk cannot prove it (`AX3057`), instead of warning with `AX3051`."
                              "")))))))))))))))

; ------------------------------------------------------------------
; The index
; ------------------------------------------------------------------
;; Every word the lexicon documents, in the order the language index
;; lists them: keywords, forms, types, effects, operators, literals.
(pub :: lexWords Strings)
(pub fn (lexWords)
  {
    (let v vecNew)
    {
      (vecPush v "|>")
      (vecPush v "fn")
      (vecPush v "lambda")
      (vecPush v "let")
      (vecPush v "set")
      (vecPush v "if")
      (vecPush v "match")
      (vecPush v "while")
      (vecPush v "for")
      (vecPush v "data")
      (vecPush v "struct")
      (vecPush v "type")
      (vecPush v "subtype")
      (vecPush v "effect")
      (vecPush v "handle")
      (vecPush v "region")
      (vecPush v "parallel")
      (vecPush v "macro")
      (vecPush v "import")
      (vecPush v "pub")
      (vecPush v "extern")
      (vecPush v "syntax/for")
      (vecPush v "alloc")
      (vecPush v "begin")
      (vecPush v "cond")
      (vecPush v "consume")
      (vecPush v "define")
      (vecPush v "union")
      (vecPush v "foreign")
      (vecPush v "trait")
      (vecPush v "impl")
      (vecPush v "emacro")
      (vecPush v "cast")
      (vecPush v "mut")
      (vecPush v "in")
      (vecPush v "by")
      (vecPush v "is")
      (vecPush v "range")
      (vecPush v "::")
      (vecPush v "->")
      (vecPush v "..")
      (vecPush v "?")
      (vecPush v "_")
      (vecPush v "as")
      (vecPush v "sizeof")
      (vecPush v "alignof")
      (vecPush v "asm")
      (vecPush v "syntax/join")
      (vecPush v "syntax/binders")
      (vecPush v "syntax/constructors")
      (vecPush v "syntax/arity")
      (vecPush v "syntax/fields")
      (vecPush v "decl")
      (vecPush v "Int")
      (vecPush v "Int8")
      (vecPush v "Int16")
      (vecPush v "Int32")
      (vecPush v "UInt8")
      (vecPush v "UInt16")
      (vecPush v "UInt32")
      (vecPush v "UInt64")
      (vecPush v "Float")
      (vecPush v "Bool")
      (vecPush v "Char")
      (vecPush v "String")
      (vecPush v "Foreign")
      (vecPush v "Handle")
      (vecPush v "Vec")
      (vecPush v "Link")
      (vecPush v "Option")
      (vecPush v "Result")
      (vecPush v "Addr")
      (vecPush v "()")
      (vecPush v "IO")
      (vecPush v "Alloc")
      (vecPush v "Mut")
      (vecPush v "Unsafe")
      (vecPush v "Spawn")
      (vecPush v "Block")
      (vecPush v "Entropy")
      (vecPush v "Div")
      (vecPush v "Pure")
      (vecPush v "+")
      (vecPush v "-")
      (vecPush v "*")
      (vecPush v "/")
      (vecPush v "%")
      (vecPush v "&")
      (vecPush v "|")
      (vecPush v "^")
      (vecPush v "<<")
      (vecPush v ">>")
      (vecPush v "==")
      (vecPush v "!=")
      (vecPush v "<")
      (vecPush v ">")
      (vecPush v "<=")
      (vecPush v ">=")
      (vecPush v "&&")
      (vecPush v "||")
      (vecPush v "!")
      (vecPush v "true")
      (vecPush v "false")
      (vecPush v "Some")
      (vecPush v "None")
      (vecPush v "Ok")
      (vecPush v "Err")
      v
    }
  })

;; Every AXTAG key the lexicon documents, checked keys first.
(pub :: lexTagKeys Strings)
(pub fn (lexTagKeys)
  {
    (let v vecNew)
    {
      (vecPush v "effect")
      (vecPush v "restrict")
      (vecPush v "pre")
      (vecPush v "post")
      (vecPush v "isr")
      (vecPush v "ct")
      (vecPush v "deprecated")
      (vecPush v "unhandled")
      (vecPush v "syscall")
      (vecPush v "nolint")
      (vecPush v "result")
      (vecPush v "scoped")
      (vecPush v "compute")
      v
    }
  })

;; One word's entry as Markdown: the form in an `axiom` fence, its
;; kind, the prose and the reference section. "" for an unknown word.
(pub :: lexEntryMarkdown (-> String String))
(pub fn (lexEntryMarkdown w)
  {
    (let form (lexForm w))
    (if (== (strLen form) 0)
      ""
      (concat (concat (concat "```axiom\n" form) "\n```\n\n")
        (concat (concat (concat "*" (lexKind w)) "*\n\n")
          (concat (concat (lexDoc w) "\n\n")
            (concat (concat "Reference: `docs/" (lexAnchor w)) "`\n")))))
  })

;; An AXTAG's entry as Markdown: the tag in a fence, the key's prose
;; and, when `v` is a value the lexicon knows, the value's prose. "" for
;; an unknown key.
(pub :: lexTagMarkdown (-> String String String))
(pub fn (lexTagMarkdown k v)
  {
    (let kd (lexTagKeyDoc k))
    (if (== (strLen kd) 0)
      ""
      {
        (let vd
          (if (== (strLen v) 0)
            ""
            (lexTagValueDoc k v)))
        (concat
          (concat (concat "```axiom\n;@axiom:" k)
            (if (== (strLen v) 0)
              "\n```\n\n"
              (concat (concat "(" v) ")\n```\n\n")))
          (concat (concat "*AXTAG*\n\n" (concat kd "\n"))
            (concat
              (if (== (strLen vd) 0)
                ""
                (concat (concat (concat "\n`" v) "`: ") (concat vd "\n")))
              "\nReference: `docs/reference.md#axtag-metadata`\n")))
      })
  })

; `axiom explain WORD`: the lexicon's entry for a keyword, a builtin
; type, an effect, an operator or a literal, or for an AXTAG key
; written as `@key` (`@restrict`), as Markdown. "" when the lexicon
; has no entry, so the caller reports the unknown code.
(pub :: explainLexicon (-> String String))
(pub fn (explainLexicon word)
  {
    (let w (strTrim word))
    (if (strStartsWith w "@")
      (lexTagMarkdown (strSlice w 1 (- (strLen w) 1)) "")
      (lexEntryMarkdown w))
  })

; ------------------------------------------------------------------
; AXQL, for a hover inside a query literal (`lspAxqlHover`). The
; reserved and contextual words in upper case, and the functions in
; their own case, each with one sentence; "" for a word that is not
; one. docs/axql.md is the page these sentences summarise.
; ------------------------------------------------------------------
;; One sentence on an AXQL keyword, written in upper case, or "".
(pub :: lexAxqlDoc (-> String String))
(pub fn (lexAxqlDoc w)
  (if (strEq w "AND")
    "Joins two conditions; both must hold."
    (if (strEq w "AS")
      "Names a result column or a table in a query: `name AS n`."
      (if (strEq w "BEGIN")
        "Opens a transaction; `COMMIT` keeps its changes and `ROLLBACK` discards them."
        (if (strEq w "BY")
          "Follows `ORDER` and `GROUP`: `ORDER BY age DESC`, `GROUP BY team`."
          (if (strEq w "COMMIT")
            "Ends a transaction and keeps its changes."
            (if (strEq w "CREATE")
              "Makes a table or an index: `CREATE TABLE users (...)`, `CREATE INDEX i ON users (name)`."
              (if (strEq w "DELETE")
                "Removes rows: `DELETE FROM users WHERE age < ?`."
                (if (strEq w "DROP")
                  "Removes a table or an index: `DROP TABLE users`, `DROP INDEX i`."
                  (if (strEq w "EXISTS")
                    "With `IF`, makes `CREATE` quiet when the table or index is already there, and `DROP` quiet when it is already gone."
                    (if (strEq w "FALSE")
                      "The false value."
                      (if (strEq w "FROM")
                        "Names the table a `SELECT` reads or a `DELETE` removes from."
                        (if (strEq w "IF")
                          "`IF NOT EXISTS` on `CREATE`, `IF EXISTS` on `DROP`."
                          (if (strEq w "INDEX")
                            "An index over one or more columns, for `CREATE INDEX` and `DROP INDEX`."
                            (if (strEq w "INSERT")
                              "Adds a row: `INSERT INTO users (name, age) VALUES (?, ?)`."
                              (if (strEq w "INTO")
                                "Follows `INSERT`: the table the row goes into."
                                (if (strEq w "IS")
                                  "Tests for the absent value: `x IS NULL`, `x IS NOT NULL`."
                                  (if (strEq w "LIMIT")
                                    "Caps the rows a query answers; `OFFSET` after it skips some first."
                                    (if (strEq w "NOT")
                                      "Negates a condition or a test: `NOT (a AND b)`, `IS NOT NULL`, `NOT IN`, `NOT LIKE`."
                                      (if (strEq w "NULL")
                                        "The absent value. Nothing compares equal to it; test it with `IS NULL`."
                                        (if (strEq w "OFFSET")
                                          "Skips rows before the ones a query answers; written after `LIMIT`."
                                          (if (strEq w "ON")
                                            "Names the table an index is built on: `CREATE INDEX i ON users (name)`."
                                            (if (strEq w "OR")
                                              "Joins two conditions; either may hold."
                                              (if (strEq w "ORDER")
                                                "With `BY`, sorts a query's rows: `ORDER BY age DESC, name`."
                                                (if (strEq w "PRIMARY")
                                                  "With `KEY`, marks the column that identifies each row."
                                                  (if (strEq w "ROLLBACK")
                                                    "Ends a transaction and discards its changes."
                                                    (if (strEq w "SELECT")
                                                      "Reads rows: `SELECT id, name FROM users WHERE age > ? ORDER BY age LIMIT 10`."
                                                      (if (strEq w "SET")
                                                        "Follows `UPDATE`: the columns to change and their new values."
                                                        (if (strEq w "TABLE")
                                                          "A table, for `CREATE TABLE`, `ALTER TABLE` and `DROP TABLE`."
                                                          (if (strEq w "TRUE")
                                                            "The true value."
                                                            (if (strEq w "UNIQUE")
                                                              "An index that refuses two rows with the same values in its columns: `CREATE UNIQUE INDEX`."
                                                              (if (strEq w "UPDATE")
                                                                "Changes rows: `UPDATE users SET age = ? WHERE id = ?`."
                                                                (if (strEq w "VALUES")
                                                                  "Follows `INSERT INTO table (columns)`: the new row's values, one per column."
                                                                  (if (strEq w "WHERE")
                                                                    "Keeps the rows a condition holds for."
                                                                    (if (strEq w "INTEGER")
                                                                      "A column type: a 64-bit signed integer."
                                                                      (if (strEq w "REAL")
                                                                        "A column type: an IEEE 754 binary64 number, never NaN; an INTEGER stored in one becomes the nearest REAL."
                                                                        (if (strEq w "TEXT")
                                                                          "A column type: bytes, conventionally UTF-8."
                                                                          (if (strEq w "BLOB")
                                                                            "A column type: bytes."
                                                                            (if (strEq w "LINK")
                                                                              "A column type: the rowid of a row in another table, held as an INTEGER."
                                                                              (if (strEq w "KEY")
                                                                                "With `PRIMARY`: the column that identifies each row."
                                                                                (if (strEq w
                                                                                      "DEFAULT")
                                                                                  "The constant a column takes when an `INSERT` or `UPSERT` leaves it out."
                                                                                  (if (strEq w
                                                                                        "CHECK")
                                                                                    "A condition every row must satisfy, written after the column: `age INTEGER CHECK (age >= 0)`."
                                                                                    (if (strEq w
                                                                                          "ASC")
                                                                                      "Sorts an `ORDER BY` term ascending, which is the default."
                                                                                      (if (strEq w
                                                                                            "DESC")
                                                                                        "Sorts an `ORDER BY` term descending."
                                                                                        (if (strEq
                                                                                              w
                                                                                              "TRANSACTION")
                                                                                          "May follow `BEGIN`: `BEGIN TRANSACTION`."
                                                                                          (if (strEq
                                                                                                w
                                                                                                "LIKE")
                                                                                            "Matches text against a pattern, `%` standing for any run of characters and `_` for one."
                                                                                            (if (strEq
                                                                                                  w
                                                                                                  "IN")
                                                                                              "Tests membership in a list: `x IN (1, 2, 3)`."
                                                                                              (if (strEq
                                                                                                    w
                                                                                                    "BETWEEN")
                                                                                                "Tests a range, both ends included: `x BETWEEN 1 AND 10`."
                                                                                                (if (strEq
                                                                                                      w
                                                                                                      "GROUP")
                                                                                                  "With `BY`, folds the rows that share the listed values into one, for `count`, `sum`, `avg`, `min` and `max`."
                                                                                                  (if (strEq
                                                                                                        w
                                                                                                        "HAVING")
                                                                                                    "Keeps the groups a condition holds for, after `GROUP BY`."
                                                                                                    (if (strEq
                                                                                                          w
                                                                                                          "UPSERT")
                                                                                                      "Inserts a row, or updates the row it would clash with."
                                                                                                      (if (strEq
                                                                                                            w
                                                                                                            "ALTER")
                                                                                                        "Changes a table: `ALTER TABLE users ADD COLUMN email TEXT`."
                                                                                                        (if (strEq
                                                                                                              w
                                                                                                              "ADD")
                                                                                                          "With `ALTER TABLE`: adds a column."
                                                                                                          (if (strEq
                                                                                                                w
                                                                                                                "COLUMN")
                                                                                                            "Follows `ADD` and `RENAME` in `ALTER TABLE`."
                                                                                                            (if (strEq
                                                                                                                  w
                                                                                                                  "RENAME")
                                                                                                              "With `ALTER TABLE`: renames the table, or `RENAME COLUMN old TO new`."
                                                                                                              (if (strEq
                                                                                                                    w
                                                                                                                    "TO")
                                                                                                                "The new name in `RENAME ... TO`."
                                                                                                                ""))))))))))))))))))))))))))))))))))))))))))))))))))))))))

;; One sentence on an AXQL function, by its name, or "".
(pub :: lexAxqlFunctionDoc (-> String String))
(pub fn (lexAxqlFunctionDoc f)
  (if (strEq f "length")
    "The bytes in TEXT or BLOB `s`, as an INTEGER."
    (if (strEq f "lower")
      "TEXT `s` with its ASCII letters lowered."
      (if (strEq f "upper")
        "TEXT `s` with its ASCII letters raised."
        (if (strEq f "trim")
          "TEXT `s` without the spaces, tabs and newlines at either end."
          (if (strEq f "substr")
            "The bytes of TEXT or BLOB `s` from `start`, counting from 1, to the end or for `len` bytes."
            (if (strEq f "replace")
              "TEXT `s` with every `from` replaced by `to`."
              (if (strEq f "instr")
                "Where `part` first starts in `s`, counting from 1, or 0 when it does not."
                (if (strEq f "abs")
                  "The magnitude of a number."
                  (if (strEq f "round")
                    "The INTEGER nearest a number, halves away from zero."
                    (if (strEq f "coalesce")
                      "Its first argument that is not NULL, or NULL."
                      (if (strEq f "nullif")
                        "NULL when `a` equals `b`, else `a`."
                        (if (strEq f "min")
                          "The least of two or more values; with one argument, the least over a group."
                          (if (strEq f "max")
                            "The greatest of two or more values; with one argument, the greatest over a group."
                            (if (strEq f "typeof")
                              "`'integer'`, `'real'`, `'text'`, `'blob'` or `'null'`."
                              (if (strEq f "asint")
                                "An INTEGER from a number, truncating, or from TEXT that spells one."
                                (if (strEq f "asreal")
                                  "A REAL from a number or from TEXT that spells one."
                                  (if (strEq f "astext")
                                    "A number written in decimal, or a BLOB's bytes as TEXT."
                                    (if (strEq f "count")
                                      "Over a group, the rows, or the values of a column that are not NULL: `count(*)`, `count(name)`."
                                      (if (strEq f "sum")
                                        "Over a group, the sum of a column's values."
                                        (if (strEq f "avg")
                                          "Over a group, the mean of a column's values, as a REAL."
                                          "")))))))))))))))))))))
