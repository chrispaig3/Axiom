; Parsed syntax packets for process workers. Only pre-expansion trees
; cross this boundary: no address, scope identity or checker stamp does.
; Nodes omit zero fields; spans pack two offsets into one word.
; Words are little-endian and strings are padded to a word boundary.
; Decoded strings share the parent-owned packet buffer.
; Unsupported shapes and malformed packets answer None, allowing the
; caller to parse normally at the import's deterministic visit point.
(import core)
(import parser)
(import lexer)
(import Mem)
(import Str)
(import Vec)
(import raw)
(import Err (isSome isNone))

(pub struct FrontParsed
  (source : String)
  (decls : (Vec ASTNode)))

(struct FrontWriter
  (mut bytes : String)
  (mut pos : Int)
  (mut good : Bool))

(struct FrontReader
  (bytes : String)
  (mut pos : Int)
  (mut good : Bool)
  (mut sourceBytes : Int))

; The private packet version. Changing a parsed field requires a new
; schema here and corpus round trips before workers can use that field.
(:: frontMagic Int)
(fn (frontMagic)
  1096306738)

(pub :: frontPacketLimit Int)
(pub fn (frontPacketLimit)
  16777216)

(:: frontString (-> Int String))
;@axiom:effect(unsafe)
(fn (frontString word)
  (as word String))

(:: frontVector (-> Int Ints))
;@axiom:effect(unsafe)
(fn (frontVector word)
  (as word (Vec Int)))

(:: frontNode (-> Int ASTNode))
;@axiom:effect(unsafe)
(fn (frontNode word)
  (as word ASTNode))

; w = word, s = string, n = node, N/S/W/P = vector of nodes/strings/
; words/spans, p = span, R = macro rules, A = annotations, L = literal pair.
; The three letters describe a, b and c. A field declaration's b is
; discriminated separately: a type node for effect/extern members,
; a float flag for struct fields (whose type is in word 6). Its c is
; a linker name for extern members, a mutable marker for struct fields.
(:: frontShape (-> Int String))
(fn (frontShape tag)
  (match tag
    (0 "www")
    (1 "www")
    (2 "sww")
    (3 "sww")
    (4 "nnP")
    (5 "Snw")
    (6 "snn")
    (7 "nnn")
    (8 "Nww")
    (10 "sSn")
    (11 "sWw")
    (12 "sNw")
    (13 "sNN")
    (14 "sSw")
    (15 "sSn")
    (16 "nNw")
    (17 "nnw")
    (20 "swW")
    (21 "sws")
    (22 "www")
    (23 "sww")
    (24 "snn")
    (25 "snw")
    (26 "nNw")
    (27 "nsw")
    (28 "nsn")
    (30 "sSN")
    (32 "sww")
    (33 "sNw")
    (34 "nnw")
    (35 "Nww")
    (37 "nww")
    (38 "www")
    (39 "www")
    (42 "nNn")
    (43 "sNN")
    (47 "snS")
    (50 "sNw")
    (51 "snN")
    (52 "snN")
    (53 "sSN")
    (54 "snp")
    (55 "snN")
    (57 "nww")
    (_ "!")))

(:: frontKind (-> Int Int Int))
(fn (frontKind tag field)
  (if (<= field 3)
    (strByte (frontShape tag) (- field 1))
    (match field
      (4 112)
      (5 119)
      (6
        (if (|| (== tag TAG_D_DATA) (== tag TAG_D_STRUCT))
          83
          (if (== tag TAG_CTOR)
            78
            (if (|| (== tag TAG_D_SIG) (== tag TAG_FIELD))
              110
              119)))
      )
      (7 65)
      (9
        (if (== tag TAG_D_MACRO)
          82
          (if (|| (== tag TAG_CTOR) (== tag TAG_E_APP))
            83
            119))
      )
      (_ 119))))

; An unused scalar must stay zero. Accepting an arbitrary word there
; could smuggle an address into a slot a later phase uses for metadata.
(:: frontRawValid (-> Int Int Int Bool))
(fn (frontRawValid tag field value)
  (if (== field 5)
    (|| (== value 0) (== value 1))
    (if (&& (== field 1) (|| (== tag TAG_E_INT) (|| (== tag TAG_E_FLT) (== tag TAG_E_CHAR))))
      true
      (if (&& (== tag TAG_E_INT) (== field 2))
        (&& (>= value 0) (<= value 2))
        (if (&& (== tag TAG_CTOR) (== field 2))
          (>= value 0)
          (if (&& (== tag TAG_FIELD) (|| (== field 2) (== field 3)))
            (|| (== value 0) (== value 1))
            (== value 0)))))))

(:: frontPad (-> Int Int))
(fn (frontPad bytes)
  (* (/ (+ bytes 7) 8) 8))

; Grow only when a write needs more room. Large modules start with a
; source-sized estimate; growth copies bytes, never walks syntax again.
(:: frontWriter (-> Int FrontWriter))
(fn (frontWriter sourceBytes)
  (FrontWriter
    :bytes
      (strAlloc
        (if (> sourceBytes (/ frontPacketLimit 4))
          frontPacketLimit
          (if (< sourceBytes 64)
            256
            (* sourceBytes 4))))
    :pos 0
    :good true))

(:: frontReserve (-> FrontWriter Int Bool))
(fn (frontReserve out bytes)
  {
    (if (&& out.good (&& (>= bytes 0) (<= bytes (- frontPacketLimit out.pos))))
      {
        (let need (+ out.pos bytes))
        (if (> need (strLen out.bytes))
          {
            (let mut capacity (strLen out.bytes))
            (while (< capacity need)
              (set capacity (if (> capacity (/ frontPacketLimit 2))
                frontPacketLimit
                (* capacity 2))))
            (let grown (strAlloc capacity))
            (memCopy (strData grown) (strData out.bytes) out.pos)
            (set out.bytes grown)
          })
      }
      (set out.good false))
    out.good
  })

(:: frontPutWord (-> FrontWriter Int Int))
;@axiom:effect(unsafe)
(fn (frontPutWord out value)
  {
    (if (frontReserve out 8)
      {
        (__store64 (strData out.bytes) (/ out.pos 8) value)
        (set out.pos (+ out.pos 8))
      })
    0
  })

(:: frontPutString (-> FrontWriter Int Int))
;@axiom:effect(unsafe)
(fn (frontPutString out value)
  (if (== value 0)
    (frontPutWord out (- 0 1))
    {
      (let text (frontString value))
      (let size (strLen text))
      (frontPutWord out size)
      (let padded (frontPad size))
      (if (frontReserve out padded)
        {
          (memCopy (+ (strData out.bytes) out.pos) (strData text) size)
          (for i in size..padded
            (__store8 (strData out.bytes) (+ out.pos i) 0))
          (set out.pos (+ out.pos padded))
        })
      0
    }))

(:: frontPutVector (-> FrontWriter Int Int Int Int))
(fn (frontPutVector out value kind depth)
  (if (== value 0)
    (frontPutWord out (- 0 1))
    {
      (let values (frontVector value))
      (frontPutWord out (vecLen values))
      (let mut i 0)
      (while (&& out.good (< i (vecLen values)))
        {
          (frontPutValue out (vecGet values i) kind (+ depth 1))
          (set i (+ i 1))
        })
      0
    }))

; R and L retain their existing packet field order. No in-memory mixed
; word record is constructed or inspected to encode these owning products.
; A records own their annotation entries and text. Offset zero and an
; allocated empty string remain ordinary present values in the packet.
(:: frontPutAxtags (-> FrontWriter Axtags Int Int))
;@axiom:effect(unsafe)
(fn (frontPutAxtags out tags depth)
  {
    (if (> depth 512)
      (set out.good false)
      {
        (frontPutWord out (vecLen tags))
        (for tag in tags
          (if (> (+ depth 1) 512)
            (set out.good false)
            {
              (frontPutWord out tag.off)
              (frontPutString out (as tag.content Int))
            }))
      })
    0
  })

(:: frontPutMacroRules (-> FrontWriter MacroRules Int Int))
(fn (frontPutMacroRules out rules depth)
  {
    (if (> depth 512)
      (set out.good false)
      {
        (frontPutWord out (vecLen rules))
        (for i in 0..(vecLen rules)
          (frontPutMacroRule out (vecGet rules i) (+ depth 1)))
        0
      })
    0
  })

(:: frontPutMacroRule (-> FrontWriter MacroRule Int Int))
;@axiom:effect(unsafe)
(fn (frontPutMacroRule out rule depth)
  {
    (if (> depth 512)
      (set out.good false)
      {
        (frontPutValue out (as rule.params Int) 83 (+ depth 1))
        (frontPutValue out (as rule.declarations Int) 78 (+ depth 1))
        (frontPutValue out (as rule.patterns Int) 78 (+ depth 1))
        (frontPutValue out (as rule.spellings Int) 83 (+ depth 1))
        (frontPutValue out (as rule.repeats Int) 87 (+ depth 1))
        (frontPutMacroLiterals out rule.literals (+ depth 1))
        (match rule.expression
          ((None) (frontPutWord out (- 0 1)))
          ((Some expression)
            (frontPutValue out (as expression Int) 110 (+ depth 1))
          ))
      })
    0
  })

(:: frontPutMacroLiterals (-> FrontWriter MacroLiterals Int Int))
;@axiom:effect(unsafe)
(fn (frontPutMacroLiterals out literals depth)
  {
    (if (> depth 512)
      (set out.good false)
      {
        (frontPutValue out (as literals.declared Int) 83 (+ depth 1))
        (frontPutValue out (as literals.used Int) 83 (+ depth 1))
      })
    0
  })

; The header holds a seven-bit node tag and nine presence bits. Zero
; fields are reconstructed from mkNode's defaults, preserving null versus
; an allocated empty vector without copying unused metadata words.
(:: frontNodeMask (-> ASTNode Int))
(fn (frontNodeMask node)
  {
    (let mut mask 0)
    (for field in 1..10
      (if (!= (nodeWireWord node field) 0)
        (set mask (| mask (<< 1 (- field 1))))))
    mask
  })

(:: frontPutNode (-> FrontWriter ASTNode Int Int))
(fn (frontPutNode out value depth)
  (if (nodeSame value nilNode)
    (frontPutWord out (- 0 1))
    {
      (let tag (nodeTag value))
      (if (|| (strEq (frontShape tag) "!")
            (|| (!= (nodeModule value) 0)
              (|| (!= (nodeDefScope value) 0)
                (|| (!= (nodeBinderTy value) 0) (!= (nodeSyntaxIdentity value) 0)))))
        (set out.good false)
        {
          (let mask (frontNodeMask value))
          (frontPutWord out (| tag (<< mask 7)))
          (let mut field 1)
          (while (&& out.good (< field 10))
            {
              (if (!= (& mask (<< 1 (- field 1))) 0)
                {
                  (let kind
                    (if (&& (== tag TAG_FIELD) (|| (== field 2) (== field 3)))
                      (if (== (nodeTy value) 0)
                        (if (== field 2)
                          110
                          115)
                        119)
                      (frontKind tag field)))
                  (if (&& (== tag TAG_FIELD) (|| (== field 2) (== field 3)))
                    (frontPutWord out kind))
                  (let payload (nodeWireWord value field))
                  (if (&& (== kind 119) (! (frontRawValid tag field payload)))
                    (set out.good false))
                  (if (== kind 82)
                    (match (nodeMacroRules value)
                      ((None)
                        (set out.good false)
                      )
                      ((Some rules) (frontPutMacroRules out rules (+ depth 1))))
                    (if (== kind 65)
                      (match (nodeAxtagsOpt value)
                        ((None)
                          (set out.good false)
                        )
                        ((Some tags) (frontPutAxtags out tags (+ depth 1))))
                      (frontPutValue out payload kind (+ depth 1))))
                })
              (set field (+ field 1))
            })
        })
      0
    }))

(:: frontPutValue (-> FrontWriter Int Int Int Int))
(fn (frontPutValue out value kind depth)
  {
    (if (> depth 512)
      (set out.good false)
      (match kind
        (119 (frontPutWord out value))
        (115 (frontPutString out value))
        (110 (frontPutNode out (frontNode value) depth))
        (78 (frontPutVector out value 110 depth))
        (83 (frontPutVector out value 115 depth))
        (87 (frontPutVector out value 119 depth))
        (80 (frontPutVector out value 112 depth))
        (112
          (if (== value 0)
            (frontPutWord out (- 0 1))
            {
              (let start (spanStart value))
              (let end (spanEnd value))
              (if (|| (< start 0) (|| (< end start) (> end 2147483647)))
                (set out.good false)
                (frontPutWord out (| (<< start 32) end)))
            })
        )
        (_
          (set out.good false)
        )))
    0
  })

(:: frontGetWord (-> FrontReader Int))
;@axiom:effect(unsafe)
(fn (frontGetWord input)
  (if (&& input.good (<= input.pos (- (strLen input.bytes) 8)))
    {
      (let value (__load64 (strData input.bytes) (/ input.pos 8)))
      (set input.pos (+ input.pos 8))
      value
    }
    {
      (set input.good false)
      0
    }))

(:: frontGetString (-> FrontReader String))
(fn (frontGetString input)
  {
    (let size (frontGetWord input))
    (if (== size (- 0 1))
      (frontString 0)
      (if (&& input.good (&& (>= size 0) (<= size (- (strLen input.bytes) input.pos))))
        {
          (let text (strSlice input.bytes input.pos size))
          (set input.pos (+ input.pos (frontPad size)))
          text
        }
        {
          (set input.good false)
          (frontString 0)
        }))
  })

(struct FrontReadPosition
  (input : FrontReader)
  (depth : Int))

(:: frontGetText (-> FrontReadPosition String))
(fn (frontGetText position)
  (frontGetString position.input))

(:: frontGetChild (-> FrontReadPosition ASTNode))
(fn (frontGetChild position)
  (frontGetNode position.input position.depth))

; Homogeneous packets use owning vectors of their decoded element type.
(:: frontGetItems (-> FrontReader Int (-> FrontReadPosition a) (Vec a)))
;@axiom:effect(unsafe)
(fn (frontGetItems input depth decode)
  {
    (let count (frontGetWord input))
    (if (== count (- 0 1))
      (as 0 (Vec a))
      (if (&& input.good (&& (>= count 0) (<= count (/ (- (strLen input.bytes) input.pos) 8))))
        {
          (let values (vecWithCapacity count))
          (let position (FrontReadPosition :input input :depth (+ depth 1)))
          (let mut i 0)
          (while (&& input.good (< i count))
            {
              (vecPush values (decode position))
              (set i (+ i 1))
            })
          values
        }
        {
          (set input.good false)
          (as 0 (Vec a))
        }))
  })

(:: frontGetVector (-> FrontReader Int Int Int))
;@axiom:effect(unsafe)
(fn (frontGetVector input kind depth)
  (if (== kind 110)
    {
      (let values (frontGetItems input depth frontGetChild))
      (__retainref values)
      (as values Int)
    }
    (if (== kind 115)
      {
        (let values (frontGetItems input depth frontGetText))
        (__retainref values)
        (as values Int)
      }
      (frontGetRawVector input kind depth))))

(:: frontGetRawVector (-> FrontReader Int Int Int))
;@axiom:effect(unsafe)
(fn (frontGetRawVector input kind depth)
  {
    (let count (frontGetWord input))
    (if (== count (- 0 1))
      0
      (if (&& input.good (&& (>= count 0) (<= count (/ (- (strLen input.bytes) input.pos) 8))))
        {
          (let values (vecWithCapacity count))
          (let mut i 0)
          (while (&& input.good (< i count))
            {
              (vecPush values (frontGetValue input kind (+ depth 1)))
              (set i (+ i 1))
            })
          (__retainref values)
          (as values Int)
        }
        {
          (set input.good false)
          0
        }))
  })

; An annotation entry requires owned text and a valid source offset.
; A real empty list or empty text is still present.
(:: frontGetAxtags (-> FrontReader Int (Option Axtags)))
;@axiom:effect(unsafe)
(fn (frontGetAxtags input depth)
  {
    (let count (frontGetWord input))
    (if (&& (<= depth 512)
          (&& input.good (&& (>= count 0) (<= count (/ (- (strLen input.bytes) input.pos) 16)))))
      {
        (let tags (:: (vecWithCapacity count) Axtags))
        (let mut i 0)
        (while (&& input.good (< i count))
          {
            (if (> (+ depth 1) 512)
              (set input.good false)
              {
                (let off (frontGetWord input))
                (let content (frontGetString input))
                (if (&& input.good
                      (&& (>= off 0) (&& (<= off input.sourceBytes) (!= (as content Int) 0))))
                  (vecPush tags (AxtagEnt :off off :content content))
                  (set input.good false))
              })
            (set i (+ i 1))
          })
        (if input.good
          (Some tags)
          None)
      }
      None)
  })

; Every field of an R/L record is required except its expression.
; Null or malformed required vectors refuse the packet before expansion.
(:: frontGetMacroNames (-> FrontReader Int (Option Names)))
;@axiom:effect(unsafe)
(fn (frontGetMacroNames input depth)
  (if (> depth 512)
    None
    {
      (let names (frontGetItems input depth frontGetText))
      (if (|| (! input.good) (== (as names Int) 0))
        None
        {
          (let mut good true)
          (for i in 0..(vecLen names)
            (if (== (as (vecGet names i) Int) 0)
              (set good false)))
          (if good
            (Some names)
            None)
        })
    }))

(:: frontGetMacroNodes (-> FrontReader Int (Option Nodes)))
;@axiom:effect(unsafe)
(fn (frontGetMacroNodes input depth)
  (if (> depth 512)
    None
    {
      (let nodes (frontGetItems input depth frontGetChild))
      (if (|| (! input.good) (== (as nodes Int) 0))
        None
        {
          (let mut good true)
          (for i in 0..(vecLen nodes)
            (if (nodeSame (vecGet nodes i) nilNode)
              (set good false)))
          (if good
            (Some nodes)
            None)
        })
    }))

(:: frontGetMacroWords (-> FrontReader (Option Ints)))
(fn (frontGetMacroWords input)
  {
    (let count (frontGetWord input))
    (if (&& input.good (&& (>= count 0) (<= count (/ (- (strLen input.bytes) input.pos) 8))))
      {
        (let values (:: (vecWithCapacity count) Ints))
        (for i in 0..count
          (vecPush values (frontGetWord input)))
        (Some values)
      }
      None)
  })

(:: frontGetMacroLiterals (-> FrontReader Int (Option MacroLiterals)))
(fn (frontGetMacroLiterals input depth)
  (if (> depth 512)
    None
    (if (let (Some declared) (frontGetMacroNames input (+ depth 1)))
      (if (let (Some used) (frontGetMacroNames input (+ depth 1)))
        (Some (MacroLiterals :declared declared :used used))
        None)
      None)))

(:: frontGetMacroRule (-> FrontReader Int (Option MacroRule)))
(fn (frontGetMacroRule input depth)
  (if (> depth 512)
    None
    (if (let (Some params) (frontGetMacroNames input (+ depth 1)))
      (if (let (Some declarations) (frontGetMacroNodes input (+ depth 1)))
        (if (let (Some patterns) (frontGetMacroNodes input (+ depth 1)))
          (if (let (Some spellings) (frontGetMacroNames input (+ depth 1)))
            (if (let (Some repeats) (frontGetMacroWords input))
              (if (let (Some literals) (frontGetMacroLiterals input (+ depth 1)))
                {
                  (let expression (frontGetNode input (+ depth 1)))
                  (let count (vecLen patterns))
                  (let mut good
                    (&& input.good
                      (&& (== (vecLen params) count)
                        (&& (== (vecLen spellings) count) (== (vecLen repeats) count)))))
                  (for i in 0..(vecLen repeats)
                    (if (! (|| (== (vecGet repeats i) 0) (== (vecGet repeats i) 1)))
                      (set good false)))
                  (if good
                    (Some
                      (MacroRule
                        :params params
                        :declarations declarations
                        :patterns patterns
                        :spellings spellings
                        :repeats repeats
                        :literals literals
                        :expression
                          (if (nodeSame expression nilNode)
                            None
                            (Some expression))))
                    None)
                }
                None)
              None)
            None)
          None)
        None)
      None)))

(:: frontGetMacroRules (-> FrontReader Int (Option MacroRules)))
(fn (frontGetMacroRules input depth)
  {
    (let count (frontGetWord input))
    (if (&& (<= depth 512)
          (&& input.good (&& (>= count 0) (<= count (/ (- (strLen input.bytes) input.pos) 64)))))
      {
        (let rules (:: (vecWithCapacity count) MacroRules))
        (let mut i 0)
        (while (&& input.good (< i count))
          {
            (match (frontGetMacroRule input (+ depth 1))
              ((None)
                (set input.good false)
              )
              ((Some rule) (vecPush rules rule)))
            (set i (+ i 1))
          })
        (if input.good
          (Some rules)
          None)
      }
      None)
  })

(:: frontGetNode (-> FrontReader Int ASTNode))
(fn (frontGetNode input depth)
  (if (> depth 512)
    {
      (set input.good false)
      nilNode
    }
    {
      (let header (frontGetWord input))
      (let tag (& header 127))
      (let mask (>> header 7))
      (if (== header (- 0 1))
        nilNode
        (if (|| (< header 0) (|| (> mask 511) (strEq (frontShape tag) "!")))
          {
            (set input.good false)
            nilNode
          }
          {
            (let node (nodeWireEmpty tag))
            (let mut field 1)
            (let mut fieldKind 0)
            (let mut symbolKind 0)
            (while (&& input.good (< field 10))
              {
                (if (!= (& mask (<< 1 (- field 1))) 0)
                  {
                    (let kind
                      (if (&& (== tag TAG_FIELD) (|| (== field 2) (== field 3)))
                        (frontGetWord input)
                        (frontKind tag field)))
                    (if (&& (== tag TAG_FIELD) (|| (== field 2) (== field 3)))
                      {
                        (if (== field 2)
                          (set fieldKind kind)
                          (set symbolKind kind))
                        (if (!
                              (|| (== kind 119)
                                (== kind
                                  (if (== field 2)
                                    110
                                    115))))
                          (set input.good false))
                      })
                    (if (== kind 82)
                      (match (frontGetMacroRules input (+ depth 1))
                        ((None)
                          (set input.good false)
                        )
                        ((Some rules) (writeNodeMacroRules node rules)))
                      (if (== kind 65)
                        (match (frontGetAxtags input (+ depth 1))
                          ((None)
                            (set input.good false)
                          )
                          ((Some tags) (writeNodeAxtags node tags)))
                        {
                          (let payload (frontGetValue input kind (+ depth 1)))
                          (if (|| (== payload 0)
                                (&& (== kind 119) (! (frontRawValid tag field payload))))
                            (set input.good false))
                          (nodeWireStore node field payload (!= kind 119))
                        }))
                  })
                (set field (+ field 1))
              })
            (if (|| (!= (nodeModule node) 0)
                  (&& (== tag TAG_FIELD)
                    (||
                      (&& (!= fieldKind 0)
                        (!= fieldKind
                          (if (== (nodeTy node) 0)
                            110
                            119)))
                      (&& (!= symbolKind 0)
                        (!= symbolKind
                          (if (== (nodeTy node) 0)
                            115
                            119))))))
              (set input.good false))
            node
          }))
    }))

(:: frontGetValue (-> FrontReader Int Int Int))
;@axiom:effect(unsafe)
(fn (frontGetValue input kind depth)
  (if (|| (! input.good) (> depth 512))
    {
      (set input.good false)
      0
    }
    (match kind
      (119 (frontGetWord input))
      (115
        {
          (let text (frontGetString input))
          (__retainref text)
          (as text Int)
        }
      )
      (110
        {
          (let node (frontGetNode input depth))
          (__retainref node)
          (as node Int)
        }
      )
      (78 (frontGetVector input 110 depth))
      (83 (frontGetVector input 115 depth))
      (87 (frontGetVector input 119 depth))
      (80 (frontGetVector input 112 depth))
      (112
        {
          (let packed (frontGetWord input))
          (if (== packed (- 0 1))
            0
            {
              (let start (>> packed 32))
              (let end (& packed 4294967295))
              (if (|| (< start 0) (|| (< end start) (> end input.sourceBytes)))
                (set input.good false))
              (mkSpan start end)
            })
        }
      )
      (_
        {
          (set input.good false)
          0
        }
      ))))

(:: frontPutParsed (-> FrontWriter FrontParsed Int))
;@axiom:effect(unsafe)
(fn (frontPutParsed out parsed)
  {
    (frontPutWord out frontMagic)
    (frontPutString out (as parsed.source Int))
    (frontPutVector out (as parsed.decls Int) 110 0)
    0
  })

; A zero-length packet means that the ordinary parser must handle this
; module. Each tree is walked once, directly into its growing byte buffer.
(pub :: frontEncode (-> FrontParsed String))
(pub fn (frontEncode parsed)
  {
    (let out (frontWriter (strLen parsed.source)))
    (frontPutParsed out parsed)
    (if out.good
      (strSlice out.bytes 0 out.pos)
      "")
  })

; A batch writes each parsed tree directly into one buffer. A zero frame
; preserves a file that must fall back to serial parsing. Length prefixes
; let the parent check each frame before its ordinary decoder sees it.
(pub :: frontEncodeMany (-> (Vec (Option FrontParsed)) String))
;@axiom:effect(unsafe)
(pub fn (frontEncodeMany files)
  {
    (let mut estimate 0)
    (let mut i 0)
    (while (< i (vecLen files))
      {
        (if (let (Some parsed) (vecGet files i))
          (set estimate (+ estimate (strLen parsed.source)))
          0)
        (set i (+ i 1))
      })
    (let out (frontWriter estimate))
    (frontPutWord out 1096306740)
    (frontPutWord out (vecLen files))
    (set i 0)
    (while (&& out.good (< i (vecLen files)))
      {
        (let prefix out.pos)
        (frontPutWord out 0)
        (let start out.pos)
        (if (let (Some parsed) (vecGet files i))
          {
            (frontPutParsed out parsed)
            (if out.good
              (__store64 (strData out.bytes) (/ prefix 8) (- out.pos start)))
            0
          }
          0)
        (set i (+ i 1))
      })
    (if out.good
      (strSlice out.bytes 0 out.pos)
      "")
  })

(pub :: frontDecodeMany (-> String (Option (Vec (Option FrontParsed)))))
(pub fn (frontDecodeMany bytes)
  (if (|| (> (strLen bytes) frontPacketLimit) (!= (% (strLen bytes) 8) 0))
    None
    {
      (let input (FrontReader :bytes bytes :pos 0 :good true :sourceBytes 0))
      (let magic (frontGetWord input))
      (let count (frontGetWord input))
      (if (|| (!= magic 1096306740) (|| (< count 0) (> count (/ (- (strLen bytes) input.pos) 8))))
        None
        {
          (let files (vecWithCapacity count))
          (let mut i 0)
          (while (&& input.good (< i count))
            {
              (let size (frontGetWord input))
              (if (|| (< size 0) (|| (!= (% size 8) 0) (> size (- (strLen bytes) input.pos))))
                (set input.good false)
                (if (== size 0)
                  (vecPush files None)
                  {
                    (let parsed (frontDecode (strSlice bytes input.pos size)))
                    (if (isNone parsed)
                      (set input.good false))
                    (vecPush files parsed)
                  }))
              (set input.pos (+ input.pos
                               (if (< size 0)
                                 0
                                 size)))
              (set i (+ i 1))
            })
          (if (&& input.good (== input.pos (strLen bytes)))
            (Some files)
            None)
        })
    }))

(pub :: frontDecode (-> String (Option FrontParsed)))
;@axiom:effect(unsafe)
(pub fn (frontDecode bytes)
  (if (|| (> (strLen bytes) frontPacketLimit) (!= (% (strLen bytes) 8) 0))
    None
    {
      (let input (FrontReader :bytes bytes :pos 0 :good true :sourceBytes 0))
      (if (!= (frontGetWord input) frontMagic)
        None
        {
          (let source (frontGetString input))
          (set input.sourceBytes (if (== (as source Int) 0)
            0
            (strLen source)))
          (let decls (frontGetItems input 0 frontGetChild))
          (if (&& input.good
                (&& (== input.pos (strLen bytes))
                  (&& (!= (as source Int) 0) (!= (as decls Int) 0))))
            (Some (FrontParsed :source source :decls decls))
            None)
        })
    }))

(pub :: frontParse (-> String (Option FrontParsed)))
(pub fn (frontParse source)
  {
    (let tokens (lex source))
    (if (isSome (lexErrDiag tokens source))
      None
      (match (parseModuleWith tokens (scanAxtags source))
        ((ParseFailed _) None)
        ((ParseSuccess declarations _) (Some (FrontParsed :source source :decls declarations)))))
  })
