; lsp.ax — a Language Server Protocol server, in Axiom, over the
; self-hosted frontend.
;
; The architectural argument for self-hosting first (v1-roadmap §4.6) is
; that the language server should REUSE the compiler's frontend rather
; than reimplement parsing. This module is that reuse: it owns the
; protocol and nothing else. Every diagnostic it publishes comes from
; the same `parseModuleWith`/`checkModule` pair that `check` runs -
; plus the editor-only lint Hints the LINT section walks the raw tree
; for, which `axiom check` never emits anywhere.
;
; Document changes are applied in order to the last accepted version.
; Ranged edits use UTF-16 positions; full replacements remain accepted.
; A notification commits its text and version together after every edit
; validates, so a malformed later edit cannot leave a partial document.
;
; THE FOUR QUESTIONS ALL READ THE RAW PARSE TREE and expand nothing,
; which is MAC-TOOL-3's rule: expansion is bounded but not free (41.4 s
; on a measured fan-out probe) and none of them needs it. `hover` and
; `completion` additionally read the source BYTES - the declaration's
; own text, the paragraph above it, the half-typed word under the
; cursor - because what a reader wants is what is written, and the
; document already holds it.
;
; THE FRONTEND IS LIBRARY-SHAPED, WITH ONE EXCEPTION, and that
; exception is why `lspPreflight` exists. `parseModuleWith` and
; `checkModule` both take a source string and answer values - the REPL
; already drives them that way. But `resolveImports` reaches
; `parseModuleOrDie`, which on a module it cannot find renders AX5001
; and calls `sysExitWith`. That is correct for a compiler, whose next
; action would be to fail anyway, and fatal for a server: a user
; halfway through typing `(import Fo` would kill the session, and the
; editor would report the crash rather than the typo. So the imports
; are walked non-fatally FIRST, and resolution runs only once every
; module is known to be readable.
;
; POSITIONS ARE UTF-16 CODE UNITS, which is the protocol's default and
; is a third unit alongside the two the compilers already disagree
; about (stage0 counts characters, stage1 counts bytes - see diag.ax).
; `lspChar` converts from a byte offset directly, so nothing downstream
; has to know.
;
; STATE IS THREADED, not global: Axiom has no module-level mutable
; binding. The document store is two parallel `Vec`s created in
; `lspMain` and mutated in place through ONE writer, `docPut` - the
; lockstep rule this project learned the hard way, where two separate
; single-value puts desynchronise the moment one takes the overwrite
; path and the other appends.
(import core)
(import Host)
(import Mem)
(import Str)
(import Fmt)
(import Vec)
(import Utf8)
(import Sys)
(import Sys.Platform (sigChild))
(import IO
  (cwd isDir listDir readFile stdin stdout Poller pollerNew pollerAdd pollerWait pollerRemove
    pollerAddSignals pollerToken pollerSignal))
(import Err)
(import Path)
(import Cereal)
(import Rpc)
(import lexer)
(import parser)
(import diag)
(import typecheck)
(import expand)
(import codegen)
(import format)
(import lexicon)
(import doccomment)
(import nolint)
(import raw)
(import Axqlite.AxqlParse)
(import Axqlite.AxqlAst)

; Each index owns its bucket vectors; an empty slot has no bucket yet.
(type LspBuckets (Vec (Option (Vec Int))))

(struct LspNamedNode
  (name : String)
  (node : ASTNode))

(struct LspImportChunk
  (name : String)
  (start : Int)
  (end : Int))

(type LspNodeBuckets (Vec (Option (Vec LspNamedNode))))

(type LspOccBuckets (Vec (Option (Vec LspOcc))))

; One top-level table entry: a declared name and the key it resolves to.
(struct LspTopEntry
  (name : String)
  (mut key : String))

(type LspTopBuckets (Vec (Option (Vec LspTopEntry))))

(type LspFnBuckets (Vec (Option (Vec FnEnt))))

; Buckets are allocated on their first insertion. Absence remains an
; Option rather than a forged vector reference.
(pub :: lspBucketsNew (-> Int (Vec (Option (Vec a)))))
(pub fn (lspBucketsNew slots)
  {
    (let buckets vecNew)
    (for i in 0..slots
      (vecPush buckets None))
    buckets
  })

(pub :: lspBucketFor (-> (Vec (Option (Vec a))) Int (Vec a)))
(pub fn (lspBucketFor buckets slot)
  (if (let (Some bucket) (vecGet buckets slot))
    bucket
    {
      (let fresh vecNew)
      (vecSet buckets slot (Some fresh))
      fresh
    }))

; ------------------------------------------------------------------
; Positions
; ------------------------------------------------------------------
; 0-based line of a byte offset, including CR, LF and CRLF endings.
(pub :: lspLine (-> String Int Int))
(pub fn (lspLine src off)
  (lspLineOfIx (lspLineIndex src) off))

; The UTF-16 code unit offset of `off` within its line.
;
; A code point below U+10000 is one unit; one at or above is a
; surrogate pair, so two. A byte that decodes to nothing - a truncated
; or invalid sequence - counts as one unit and advances one byte, so a
; malformed buffer still yields monotonic positions rather than
; hanging.
(pub :: lspChar (-> String Int Int))
(pub fn (lspChar src off)
  {
    (let ix (lspLineIndex src))
    (lspCharFrom src (vecGet ix (lspLineOfIx ix off)) off)
  })

; The same count, from a line start the caller already knows - which is
; what the line index makes free, and what `lineStartOf` was scanning
; the whole document to rediscover.
(pub :: lspCharFrom (-> String Int Int Int))
(pub fn (lspCharFrom src start off)
  {
    (let mut i start)
    (let mut acc 0)
    {
      (while (< i off)
        (if (let (Some cp) (utf8DecodeAt src i))
          {
            (set acc (+ acc
                       (if (>= cp 65536)
                         2
                         1)))
            (set i (+ i (utf8SeqLen (strByte src i))))
          }
          {
            (set acc (+ acc 1))
            (set i (+ i 1))
          }))
      acc
    }
  })

(pub :: lspPos (-> String Int Int))
(pub fn (lspPos src off)
  (jsonObjPut (jsonObjPut jsonObj "line" (jsonNum (lspLine src off))) "character"
    (jsonNum (lspChar src off))))

; The range of a span. A span of 0 is the spanless diagnostic - AX5001
; is one - and renders at the top of the file rather than dereferencing
; address zero, which is what reading `spanStart` of 0 would do.
(pub :: lspRange (-> String Int Int))
(pub fn (lspRange src span)
  (if (== span 0)
    (jsonObjPut (jsonObjPut jsonObj "start" (lspPos src 0)) "end" (lspPos src 0))
    {
      (let s (spanStart span))
      (let e0 (spanEnd span))
      {
        (let e
          (if (< e0 s)
            s
            e0))
        (jsonObjPut (jsonObjPut jsonObj "start" (lspPos src s)) "end" (lspPos src e))
      }
    }))

; ------------------------------------------------------------------
; The line index.
;
; `lspPos` answered both halves of a position by scanning the document
; from byte 0: `lineOf` counts newlines from 0 (`diag.ax`), and
; `lspChar`'s `lineStartOf` scans from 0 to rediscover the line start.
; `lspRange` calls `lspPos` twice, and `lspDocumentSymbols` calls
; `lspRange` twice per symbol - so an outline cost four whole-document
; scans per symbol, and publishing N diagnostics cost 4N.
;
; Measured over a real JSON-RPC pipe, `textDocument/documentSymbol`
; alone: 0.03 s at 1,002 symbols, 0.13 at 2,002, 0.54 at 4,002, 2.22 at
; 8,002 - against 0.20 s for the ENTIRE `didOpen` (parse, check and
; publish) on the same document. The outline cost eleven times the whole
; frontend. On this repository's own files: `parser.ax` 0.082 s,
; `typecheck.ax` 0.166 s, `codegen.ax` 0.185 s. The shape is
; symbols x document length, at about 8.0M line-steps a second.
;
; One pass records the offset at which every line begins; a position is
; then a binary search and no scan. Built per REQUEST and deliberately
; not cached: the server reclaims the arena at every message boundary
; (`lspSnapshot`), so an index kept across messages would point into
; storage the reset has handed back.
; ------------------------------------------------------------------
; Element 0 is 0; element k is the offset just past the k-th newline.
; A `while`, not a recursion: its depth would be the line count, and
; this backend eliminates only self tail calls.
(pub :: lspLineIndex (-> String Ints))
(pub fn (lspLineIndex src)
  {
    (let out vecNew)
    (let n (strLen src))
    (let mut i 0)
    {
      (vecPush out 0)
      (while (< i n)
        {
          (if (== (strByte src i) 13)
            {
              (if (&& (< (+ i 1) n) (== (strByte src (+ i 1)) 10))
                (set i (+ i 1)))
              (vecPush out (+ i 1))
            }
            (if (== (strByte src i) 10)
              (vecPush out (+ i 1))))
          (set i (+ i 1))
        })
      out
    }
  })

; The 0-based line of `off`: the largest k with `ix[k] <= off`. An
; offset past the end answers the last line rather than failing, because
; a span may name the byte after the final character - `lspRange`
; clamps its end but the end itself is legitimately one past.
(pub :: lspLineOfIx (-> Ints Int Int))
(pub fn (lspLineOfIx ix off)
  {
    (let mut lo 0)
    (let mut hi (- (vecLen ix) 1))
    {
      (while (< lo hi)
        {
          (let mid (+ lo (/ (+ (- hi lo) 1) 2)))
          (if (<= (vecGet ix mid) off)
            (set lo mid)
            (set hi (- mid 1)))
        })
      lo
    }
  })

(pub :: lspPosIx (-> String Ints Int Int))
(pub fn (lspPosIx src ix off)
  {
    (let ln (lspLineOfIx ix off))
    (jsonObjPut (jsonObjPut jsonObj "line" (jsonNum ln)) "character"
      (jsonNum (lspCharFrom src (vecGet ix ln) off)))
  })

(pub :: lspRangeIx (-> String Ints Int Int))
(pub fn (lspRangeIx src ix span)
  (if (== span 0)
    (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix 0)) "end" (lspPosIx src ix 0))
    {
      (let s (spanStart span))
      (let e0 (spanEnd span))
      {
        (let e
          (if (< e0 s)
            s
            e0))
        (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix s)) "end" (lspPosIx src ix e))
      }
    }))

; ------------------------------------------------------------------
; Diagnostics
; ------------------------------------------------------------------
; LSP severity: 1 Error, 2 Warning. Axiom's are 0 and 1.
(pub :: lspSeverity (-> Int Int))
(pub fn (lspSeverity sev)
  (if (== sev SEV_ERROR)
    1
    2))

; One Axiom diagnostic as an LSP `Diagnostic`.
;
; The notes and help texts are appended to the message rather than
; dropped: LSP has no field for either, and a help is often the whole
; value of an Axiom diagnostic - `AX3001`'s "did you mean" is the reason
; the fix-help form exists at all.
;
; A SECONDARY SPAN DOES carry a location, and that is what
; `relatedInformation` is for. The editor sees both halves of what the
; terminal shows at the caret: the primary LABEL and the SECONDARY
; spans. `axiom check` on a duplicate `main` points at the first
; definition, and so does the editor. tests/lsp/drive.py holds this as
; a differential between the two surfaces rather than as a list written
; down twice.
;
; WHICH FILE A SECONDARY SPAN INDEXES is the one thing this rests on,
; and it is the OPEN DOCUMENT - for the secondaries this server
; publishes. `struct DLabel` carries a unit, and `AX3049`'s call-graph
; hops name other units. The publish loop reports only
; diagnostics whose unit is 0, and the emitters that produce a
; SAME-FILE secondary take their two spans from one unit -
; `checkDuplicates` examines the entry file's declarations alone (its
; own header says so), and `emitAX3012` goes through `emitDiag`, which
; stamps the unit the spans came from. So one uri and one line index
; still serve every secondary this server can place.
;
; A secondary that names ANOTHER unit, or no location at all, is
; SKIPPED here rather than published against this document's uri. The
; server holds one source and no unit table, so it cannot turn that
; unit index into a path, and `lspRangeIx` against the open document
; would put the hop's line number on the wrong file - a location that
; looks right and opens the wrong place, which is worse than the
; absence. The chain is in the message either way; `axiom check`'s
; AXDL and JSON surfaces carry the resolved locations.
;
; Read through diag.ax's accessors rather than a second copy of the
; field list, so every note and every help reaches the editor.
(pub :: lspDiagText (-> diag::Diag String))
(pub fn (lspDiagText d)
  {
    (let parts vecNew)
    {
      (vecPush parts (diagMsg d))
      ; THE LABEL IS WHAT THE CARET SAYS, and it goes directly under
      ; the message because that is where the terminal puts it. It is
      ; often not a restatement: `AX3012`'s is "`x` is a parameter",
      ; `AX3048`'s names the `;@axiom:deprecated(...)` that was
      ; declared, and `AX2004`'s carries the whole reason a construct
      ; was removed. The message's FIRST line is unchanged by this,
      ; which is what tests/lsp/expected-diagnostics.txt pins.
      (if (let (Some lab) (diagLabel d))
        (if (! (== (strLen lab) 0))
          {
            (vecPush parts "\n\n")
            (vecPush parts lab)
          }))
      (for i in 0..(diagNoteCount d)
        {
          (vecPush parts "\n\nnote: ")
          (vecPush parts (diagNote d i))
        })
      (for i in 0..(diagTraceCount d)
        {
          ; Name only: this function has no unit table in reach, and
          ; the editor's cursor is already AT the invocation the
          ; frame explains.
          (vecPush parts "\n\nnote: in this expansion of `")
          (vecPush parts (diagTraceName d i))
          (vecPush parts "`")
        })
      (for i in 0..(diagHelpCount d)
        {
          (vecPush parts "\n\nhelp: ")
          (vecPush parts (diagHelpMsg d i))
        })
      (catStrs parts)
    }
  })

; Takes the line index rather than building one: its caller at the
; publish loop reports every diagnostic in the file, and building the
; index per diagnostic would keep the whole cost it exists to remove.
(pub :: lspDiagJson (-> diag::Diag String Ints String Int))
(pub fn (lspDiagJson d src ix uri)
  ; The key is OMITTED rather than sent empty when there is nothing
  ; to relate. An empty array is legal and would have rewritten every
  ; golden in tests/lsp/ for no information; a client reads the
  ; absent key and the empty array the same way.
  {
    (let base
      (jsonObjPut
        (jsonObjPut
          (jsonObjPut
            (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (diagSpan d))) "severity"
              (jsonNum (lspSeverity (diagSev d))))
            "code" (jsonStr (diagCode d)))
          "source" (jsonStr "axiom"))
        "message" (jsonStr (lspDiagText d))))
    (if (== (lspSecPublishable d 0 0) 0)
      base
      (jsonObjPut base "relatedInformation" (lspDiagRelated d src ix uri)))
  })

; The secondary spans, as `DiagnosticRelatedInformation[]`. One uri and
; one line index for all of them, for the reason the header gives.
(pub :: lspDiagRelated (-> diag::Diag String Ints String Int))
(pub fn (lspDiagRelated d src ix uri)
  {
    (let out jsonArr)
    {
      (for i in 0..(diagSecCount d)
        (if (== (lspSecHere d i) 1)
          (jsonArrPush out
            (jsonObjPut
              (jsonObjPut jsonObj "location"
                (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range"
                  (lspRangeIx src ix (diagSecSpan d i))))
              "message" (jsonStr (diagSecMsg d i))))))
      out
    }
  })

; Is secondary `i` one this server can place - a real span, in the
; document it is publishing against? See the header above for why the
; other two kinds are dropped rather than aimed at this uri.
(pub :: lspSecHere (-> diag::Diag Int Int))
(pub fn (lspSecHere d i)
  (if (== (diagSecSpan d i) 0)
    0
    (diagSecOwn d i)))

; How many of them there are, counted from `i` with `n` accumulated -
; the key is omitted when this is 0, and a diagnostic whose secondaries
; are ALL elsewhere must omit it too rather than publish an empty
; array, which is the distinction `diagSecCount` alone stopped making.
(pub :: lspSecPublishable (-> diag::Diag Int Int Int))
(pub fn (lspSecPublishable d i n)
  (if (>= i (diagSecCount d))
    n
    (lspSecPublishable d (+ i 1) (+ n (lspSecHere d i)))))

; ------------------------------------------------------------------
; Import pre-flight
;
; Walks the import graph exactly as `resolveDeclsPhase` does - by
; `TAG_D_IMPORT` node, name in word 1 - but answers the name of the
; first module that cannot be read instead of exiting. `None` means every
; import resolves and `resolveImports` is safe to call.
; ------------------------------------------------------------------
(pub :: lspSeenHas (-> Strings String Bool))
(pub fn (lspSeenHas seen name)
  (lspSeenFrom seen name 0))

(pub :: lspSeenFrom (-> Strings String Int Bool))
(pub fn (lspSeenFrom seen name i)
  (if (>= i (vecLen seen))
    false
    (if (strEq (vecGet seen i) name)
      true
      (lspSeenFrom seen name (+ i 1)))))

(pub :: lspPreflight (-> (Vec ASTNode) Int String Strings (Option String)))
;@axiom:effect(io)
(pub fn (lspPreflight decls tcode entryDir seen)
  {
    (let mut i 0)
    (let mut missing (:: None (Option String)))
    {
      (while (&& (< i (vecLen decls)) (isNone missing))
        {
          (let n (vecGet decls i))
          {
            (if (== (nodeTag n) TAG_D_IMPORT)
              {
                (let name (nodeAText n))
                (if (! (lspSeenHas seen name))
                  {
                    (vecPush seen name)
                    {
                      (let srcOpt (readModuleSrc name tcode entryDir))
                      (if (let (Some src) srcOpt)
                        {
                          (let pr (parseModuleWith (lex src) (scanAxtags src)))
                          (match pr
                            ((ParseFailed parseError1) ())
                            ((ParseSuccess parsedValue1 parsedPos1)
                              (set missing (lspPreflight parsedValue1 tcode entryDir seen))
                            ))
                        }
                        (set missing (Some name)))
                    }
                  })
              })
            (set i (+ i 1))
          }
        })
      missing
    }
  })

(struct LspWorkspace
  (open : Units)
  (files : (Vec LspFileObservation))
  (searches : (Vec LspSearchInput)))

(struct LspFileObservation
  (file : String)
  (text : (Option String)))

(struct LspSearchInput
  (directory : String)
  (roots : Names))

; Open documents are immutable source overlays for one request. A closed
; document is omitted, so its imports return to the on-disk source.
(pub :: lspWorkspaceNew (-> Strings Strings Ints LspWorkspace))
(pub fn (lspWorkspaceNew uris texts meta)
  {
    (let out vecNew)
    {
      (for i in 0..(vecLen uris)
        (if (lspDocIsOpen meta i)
          (vecPush out
            (CUnit2
              :file (lspUriToPath (vecGet uris i))
              :src (vecGet texts i)
              :name None
              :imports vecNew
              :library false))))
      (LspWorkspace :open out :files vecNew :searches vecNew)
    }
  })

(pub :: lspWorkspacePath (-> LspWorkspace String (Option CUnit2)))
;@axiom:effect(io)
(pub fn (lspWorkspacePath workspace path)
  {
    (let absolute
      (pathClean
        (if (pathIsAbsolute path)
          path
          (pathJoin (unwrapOr cwd ".") path))))
    (let mut i 0)
    (let mut found (:: None (Option CUnit2)))
    {
      (while (&& (isNone found) (< i (vecLen workspace.open)))
        {
          {
            (let unit (vecGet workspace.open i))
            (if (strEq absolute (pathClean (unitFile unit)))
              (set found (Some unit)))
          }
          (set i (+ i 1))
        })
      found
    }
  })

; Record unsuccessful reads too: a missing candidate becoming an empty
; file must invalidate a cached answer and become a valid module.
(pub :: lspWorkspaceFile (-> LspWorkspace String (Option String)))
;@axiom:effect(io)
(pub fn (lspWorkspaceFile workspace path)
  {
    (let key (pathClean (lspNavAbs path)))
    (let mut i 0)
    (let mut found (:: None (Option LspFileObservation)))
    {
      (while (&& (isNone found) (< i (vecLen workspace.files)))
        {
          {
            (let observed (vecGet workspace.files i))
            (if (strEq key observed.file)
              (set found (Some observed)))
          }
          (set i (+ i 1))
        })
      (if (let (Some hit) found)
        hit.text
        {
          (let text
            (match (readFile key)
              ((Err _) None)
              ((Ok src) (Some src))))
          {
            (vecPush workspace.files (LspFileObservation :file key :text text))
            text
          }
        })
    }
  })

(pub :: lspWorkspaceSearch (-> LspWorkspace String Names))
;@axiom:effect(io)
(pub fn (lspWorkspaceSearch workspace entryDir)
  {
    (let mut i 0)
    (let mut hit (- 0 1))
    {
      (while (&& (< hit 0) (< i (vecLen workspace.searches)))
        {
          (let item (vecGet workspace.searches i))
          (if (strEq entryDir item.directory)
            (set hit i))
          (set i (+ i 1))
        })
      (if (>= hit 0)
        {
          (let item (vecGet workspace.searches hit))
          item.roots
        }
        {
          (let dirs (moduleSearchDirs entryDir))
          {
            (vecPush workspace.searches (LspSearchInput :directory entryDir :roots dirs))
            dirs
          }
        })
    }
  })

; Preserve the compiler's suffix and directory precedence, including an
; open file that has not been saved yet and a valid empty module.
(pub :: lspWorkspaceModulePath (-> LspWorkspace String Int String (Option String)))
;@axiom:effect(io)
(pub fn (lspWorkspaceModulePath workspace name tcode entryDir)
  {
    (let stem (modPathToFile name))
    (let dirs (lspWorkspaceSearch workspace entryDir))
    (let suffixes vecNew)
    (let mut si 0)
    (let mut found (:: None (Option String)))
    {
      (vecPush suffixes (targetOsArchSuffix tcode))
      (vecPush suffixes (targetOsSuffix tcode))
      (vecPush suffixes ".ax")
      (while (&& (< si (vecLen suffixes)) (isNone found))
        {
          {
            (let base (concat stem (vecGet suffixes si)))
            (let mut di 0)
            (while (&& (! (stemEscapes base)) (&& (< di (vecLen dirs)) (isNone found)))
              {
                {
                  (let candidate (concat (vecGetStr dirs di) base))
                  (if (|| (isSome (lspWorkspacePath workspace candidate))
                        (isSome (lspWorkspaceFile workspace candidate)))
                    (set found (Some candidate)))
                }
                (set di (+ di 1))
              })
          }
          (set si (+ si 1))
        })
      found
    }
  })

; Read and validate each dependency once, before the shared resolver can
; take a fatal CLI path. The table is also the resolver's source input.
; The first failure carries its own unit; callers never index it using
; the entry document's bytes.
(:: lspWorkspaceMissing (-> ASTNode String Int String Int Diag))
;@axiom:effect(io)
(fn (lspWorkspaceMissing site name tcode entryDir owner)
  {
    (let d
      (mkDiag SEV_ERROR "AX5001" "module-not-found" (nodeSpan site)
        (concat (concat "cannot resolve import `" name) "`") None
        (Some (importHelpText name tcode entryDir))))
    {
      (diagSetUnit d owner)
      d
    }
  })

(:: lspWorkspaceRead (-> LspWorkspace String (Option String)))
;@axiom:effect(io)
(fn (lspWorkspaceRead workspace path)
  (if (let (Some overlay) (lspWorkspacePath workspace path))
    (Some (unitSrc overlay))
    (lspWorkspaceFile workspace path)))

(pub :: lspWorkspacePreflight
  (-> LspWorkspace (Vec ASTNode) Int String (Vec core::CUnit2) Int (Option diag::Diag)))
;@axiom:effect(io)
(pub fn (lspWorkspacePreflight workspace decls tcode entryDir units owner)
  {
    (let mut i 0)
    (let mut failure (:: None (Option Diag)))
    {
      (while (&& (isNone failure) (< i (vecLen decls)))
        {
          {
            (let site (vecGet decls i))
            (if (== (nodeTag site) TAG_D_IMPORT)
              {
                (let name (nodeAName site))
                (if (isNone (unitIndexOf units name 0))
                  {
                    (let pathResult (lspWorkspaceModulePath workspace name tcode entryDir))
                    (match pathResult
                      ((None)
                        (set failure (Some (lspWorkspaceMissing site name tcode entryDir owner)))
                      )
                      ((Some path)
                        (if (let (Some src) (lspWorkspaceRead workspace path))
                          {
                            (let unit (vecLen units))
                            {
                              (vecPush units
                                (CUnit2
                                  :file path
                                  :src src
                                  :name (Some name)
                                  :imports vecNew
                                  :library (pathInStdlib path)))
                              {
                                (let toks (lex src))
                                {
                                  (let lexD (lexErrDiag toks src))
                                  {
                                    (let pr
                                      (if (isNone lexD)
                                        (parseModuleWith toks (scanAxtags src))
                                        (pErr 0)))
                                    (match pr
                                      ((ParseFailed parseError1)
                                        {
                                          (let d
                                            (if (let (Some ld) lexD)
                                              ld
                                              (parseErrDiag toks (ParseFailed parseError1) src)))
                                          {
                                            (diagSetUnit d unit)
                                            (set failure (Some d))
                                          }
                                        }
                                      )
                                      ((ParseSuccess parsedValue1 parsedPos1)
                                        (set failure (lspWorkspacePreflight workspace parsedValue1
                                                       tcode entryDir units unit))
                                      ))
                                  }
                                }
                              }
                            }
                          }
                          (set failure (Some (lspWorkspaceMissing site name tcode entryDir owner))))
                      ))
                  })
              })
          }
          (set i (+ i 1))
        })
      failure
    }
  })

; ------------------------------------------------------------------
; Checking one document
;
; Answers a JSON array of LSP diagnostics for `src`, named `path`.
;
; Only diagnostics whose unit is 0 - the document itself - are
; published. A diagnostic about an imported module indexes that
; module's bytes, so rendering it against this file's text would put a
; caret at an unrelated position; publishing it under this file's URI
; would put it in the wrong editor tab. Reporting those under their own
; URIs is a later slice.
; ------------------------------------------------------------------
(pub :: lspCheckDoc (-> LspWorkspace String String Int))
;@axiom:effect(io)
(pub fn (lspCheckDoc workspace path src)
  ; A lexical error is reported before a parse one, as it is in the
  ; compiler: an editor should point at the bad escape rather than at
  ; whatever the parser tripped over afterwards.
  {
    (let toks (lex src))
    {
      (let lexD (lexErrDiag toks src))
      {
        (let pr
          (if (isNone lexD)
            (parseModuleWith toks (scanAxtags src))
            (pErr 0)))
        (match pr
          ((ParseFailed parseError2)
            ; A parse failure now carries a code and a span, so the editor
            ; gets a squiggle ON the offending token instead of one
            ; spanless note at the top of the file. That was this port's
            ; first consumer: before it, every typo anywhere in a file
            ; reported identically, at line 1.
            (jsonArrPush jsonArr
              (lspDiagJson
                (if (let (Some ld) lexD)
                  ld
                  (parseErrDiag toks (ParseFailed parseError2) src))
                src (lspLineIndex src) (lspPathToUri path)))
          )
          ((ParseSuccess parsedValue2 parsedPos2)
            {
              (let decls parsedValue2)
              (let tcode (checkedTargetCode hostTarget))
              (let entryDir (pathDir path))
              (let units
                {
                  (let v vecNew)
                  {
                    (vecPush v
                      (CUnit2
                        :file path
                        :src src
                        :name None
                        :imports vecNew
                        :library (pathInStdlib path)))
                    v
                  }
                })
              {
                (let failure (lspWorkspacePreflight workspace decls tcode entryDir units 0))
                (if (isSome failure)
                  (if (let (Some fd) failure)
                    (if (== (diagUnit fd) 0)
                      (jsonArrPush jsonArr
                        (lspDiagJson fd src (lspLineIndex src) (lspPathToUri path)))
                      jsonArr)
                    jsonArr)
                  ; Same order as `compileFile`: expansion, then the
                  ; checker. An editor that reported a different set
                  ; of diagnostics from `axiom check` on the same file
                  ; would be worse than one that reported none.
                  ; Expansion's refusals are published ALONE when it
                  ; refused. Running the checker over a tree
                  ; expansion gave up on can crash it, and a server
                  ; that dies is a server that stops answering the
                  ; editor.
                  ; Once, not per diagnostic: `lspPathToUri`
                  ; is IO, and a related location names the
                  ; document being published.
                  ;
                  ; The lints are taken FIRST, while `decls` is
                  ; still the tree the author wrote:
                  ; `expandProgram` rewrites it in place, and a
                  ; lint over the rewritten tree broke both of
                  ; `lspLintDoc`'s promises - it saw what macros
                  ; expand to, and it walked their output, which
                  ; is a DAG. A macro that uses its parameter
                  ; twice, nested 115 deep, is 2^115 paths through
                  ; a few thousand nodes; `axiom check` answered in
                  ; a second and the server never answered again
                  ; (found by `scripts/lib/lspfuzz.py`).
                  ; Warnings a `nolint` tag quiets go
                  ; here, where `axiom check` drops them
                  ; too (`nolintQuietDiags`), so the
                  ; editor and the terminal agree.
                  {
                    (let lints (lspLintRaw src decls))
                    (let bares vecNew)
                    (let fulls vecNew)
                    (let mods vecNew)
                    {
                      (let allDecls (resolveImports decls bares fulls mods tcode entryDir units))
                      {
                        (let ftbl vecNew)
                        (let eds
                          {
                            (let v vecNew)
                            {
                              (expandProgram decls allDecls v ftbl units bares fulls mods)
                              v
                            }
                          })
                        {
                          (let ds
                            (if (> (countErrorDiags eds) 0)
                              (orderDiags eds)
                              (orderDiags
                                (expMergeInto eds
                                  {
                                    (let cds
                                      (nolintQuietDiags decls (checkModule decls allDecls units)))
                                    {
                                      (expAttachFrames cds ftbl units)
                                      cds
                                    }
                                  }))))
                          {
                            (let out jsonArr)
                            (let ix (lspLineIndex src))
                            (let uri (lspPathToUri path))
                            {
                              (for d in ds
                                (if (== (diagUnit d) 0)
                                  (jsonArrPush out (lspDiagJson d src ix uri))))
                              (lspJsonAppend out lints 0)
                              out
                            }
                          }
                        }
                      }
                    }
                  })
              }
            }
          ))
      }
    }
  })

; The editor-only lints of a document's raw parse tree, as a JSON
; array: `lspLintDoc` into an array of their own, so `lspCheckDoc` can
; take them before expansion rewrites the tree and publish them after
; the checker's diagnostics.
(pub :: lspLintRaw (-> String (Vec ASTNode) Int))
(pub fn (lspLintRaw src decls)
  {
    (let out jsonArr)
    {
      (lspLintDoc out src (lspLineIndex src) decls)
      out
    }
  })

; Push every element of the JSON array `from`, from index `i`, onto
; `out`.
(pub :: lspJsonAppend (-> Int Int Int Int))
(pub fn (lspJsonAppend out from i)
  (if (>= i (jsonArrLen from))
    0
    {
      (jsonArrPush out (jsonArrGet from i))
      (lspJsonAppend out from (+ i 1))
    }))

; ------------------------------------------------------------------
; Editor-only lints.
;
; Three Hints the server publishes beneath the checker's diagnostics,
; and that `axiom check` never emits anywhere: a condition written as
; a boolean literal, an `if` that hands its condition straight back,
; and a `let` binding nothing reads. They are Hints (LSP severity 4),
; on for every document, and they never refuse a build - a lint is
; the editor thinking out loud, and a thought is not a verdict. That
; is also why they live here and not in the checker: the checker's
; warnings are the ones the project promises about every build
; (tests/diagnostics/severity.policy), and a style of writing no
; build depends on must not appear in that channel at all.
;
; WHAT EACH ONE SAYS, and what it pointedly does not:
;
;   `lint-dead-branch`  `(if true A B)` or `(if false A B)`. One
;                       branch can never run, which is a fact about
;                       the program rather than a taste in spelling -
;                       the usual cause is a condition left literal
;                       while debugging, or a copy-pasted arm. The
;                       squiggle sits on the literal. A `while` with
;                       a literal condition is NOT linted: an
;                       infinite loop is an idiom, and flagging one
;                       would be the dogma this section refuses.
;
;   `lint-bool-if`      `(if c true false)` where `c` is a bare name.
;                       The `if` answers its condition unchanged, so
;                       the shorter spelling says the same thing.
;                       The other order is deliberately NOT linted:
;                       `(! c)` is this language's boolean negation
;                       and the `if` form still parses, so flagging
;                       it would invent a rule against a spelling
;                       the language accepts.
;
;   `lint-unused-let`   a `let` (or `mut`) binding nothing in its
;                       scope reads. Computing a value and dropping
;                       it is usually a mistake - a forgotten use, a
;                       leftover from an edit - rather than a style.
;                       Only reads keep a binding alive: a `set!`
;                       does not mark it used, so a binding that is
;                       written and never read still draws the Hint.
;                       Its value reaches nothing, and the message
;                       says exactly that. What is NOT linted is
;                       almost as deliberate: `_` is the explicit
;                       discard and flagging it would punish the
;                       remedy; pattern binders only document a shape;
;                       parameters are interface; and macro bodies are
;                       staging code, not runtime code, so the walk
;                       does not enter them.
;
; PRECISION OVER COVERAGE, in three rules the code below keeps:
;
;   * A lint that cannot point precisely does not fire. Every rule
;     needs a non-zero span that spells exactly what its message
;     quotes in backticks - which is what
;     `tests/lsp/drive.py:check_range` holds every published
;     diagnostic to, lints included. Parser-made names (the `$` in
;     a desugared `for` binder) wear the keyword's span, so any
;     name containing one is ineligible: the squiggle would sit on
;     `for` while the message names `for$i`.
;
;   * A name the author rebound is not the name the rule means.
;     `true` and `false` are ordinary names a `let` can shadow, so
;     an `if` whose literal - or whose boolean branches - sit under
;     such a binding stays silent. The scope walk that decides this
;     is the same one that decides use.
;
;   * The walk over-approximates descent and under-approximates
;     binding: every expression form `lspNavWalk` knows is recursed
;     into, while only `let`, `mut`, `lambda` parameters, `fn`
;     parameters and match patterns introduce scope - and of those,
;     only plain `let`/`mut` bindings are ever reported. Missing a
;     use would be a false positive, so any form the walk does not
;     know is a leaf it still descends nowhere from; missing a
;     binder is only ever a missed lint.
;
; OPTING OUT is one tag, on either half of the declaration, read the
; way every other AXTAG is: `;@axiom:nolint(lint-unused-let)` quiets
; that rule for the whole declaration, `nolint(hints)` quiets all
; three and `nolint(all)` the checker's warnings as well. A tag above
; an `import` is the FILE's: Rust's `#![allow]`, in the one position
; a tag already has. The reading is `core/nolint.ax`'s, shared
; with `axiom check`, which honours the warning half. A name the tag
; lists that nothing answers to - `nolint(lint-unused-lte)` - draws
; the fourth hint, `lint-unknown-nolint`, at the tag, where the mistake
; is, rather than only as the lint it failed to quiet.
; ------------------------------------------------------------------
; The three codes. Strings, so a client that has never heard of one
; still shows the message; the `lint-` prefix is what keeps them out
; of the terminal/editor fidelity comparison in
; `tests/lsp/drive.py`, which holds `axiom check` to the compiler's
; diagnostics alone.
(pub :: lintDeadBranch String)
(pub fn (lintDeadBranch)
  "lint-dead-branch")

(pub :: lintBoolIf String)
(pub fn (lintBoolIf)
  "lint-bool-if")

(pub :: lintUnusedLet String)
(pub fn (lintUnusedLet)
  "lint-unused-let")

(pub :: lintUnknownNolint String)
(pub fn (lintUnknownNolint)
  "lint-unknown-nolint")

(pub :: lintAxql String)
(pub fn (lintAxql)
  "lint-axql")

; One binder the walk has pushed. `used` is set when a reference
; resolves to it; `eligible` is 0 for parameters and pattern binders,
; which resolve references but are never reported.
(pub struct LspLintBinder
  (name : String)
  (span : Int)
  (mut used : Int)
  (owner : String)
  (eligible : Int))

; One lint, as `lspLintRecord` keeps it until the flush.
(pub struct LspLintRec
  (span : Int)
  (code : String)
  (msg : String)
  (owner : String))

; The walk's context:
;
;   src       the document's text
;   scope     the scope's names, innermost last - reset to a fresh
;             vector at every declaration
;   binders   every binder pushed, in order
;   records   the lint records, in pop order
;   owners    the suppression map's owners, parallel to `codevecs`
;   owner     the declaration being walked, whose name every record
;             carries for the suppression check
;   idxs      the scope's binder indices, parallel to `scope`
;   codevecs  the suppression map's code vectors, parallel to `owners`
(pub struct LspLint
  (src : String)
  (mut scope : Strings)
  (binders : (Vec LspLintBinder))
  (records : (Vec LspLintRec))
  (owners : Strings)
  (mut owner : String)
  (mut idxs : Ints)
  (codevecs : StringRows))

(pub :: lspLintContext (-> String LspLint))
(pub fn (lspLintContext src)
  (LspLint
    :src src
    :scope vecNew
    :binders vecNew
    :records vecNew
    :owners vecNew
    :owner ""
    :idxs vecNew
    :codevecs vecNew))

; A name that may be linted about: `_` is the explicit discard, and
; anything containing `$` is made up by the parser (a desugared `for`
; binder) and wears a span that does not spell it.
(pub :: lspLintPlainName (-> String Bool))
(pub fn (lspLintPlainName name)
  (if (strEq name "_")
    false
    (if (let (Some _) (strFindByte name 36 0))
      false
      true)))

; A `let`/`mut` binding worth reporting when it goes unread: it needs
; a span to point at, besides a plain name.
(pub :: lspLintLetOk (-> String Int Bool))
(pub fn (lspLintLetOk name span)
  (if (== span 0)
    false
    (lspLintPlainName name)))

; Push a binder and open its scope. Parameters and pattern binders
; arrive with eligible 0: they resolve references but are never
; reported, for the reasons the header gives.
(pub :: lspLintPush (-> LspLint String Int Int Int))
(pub fn (lspLintPush lx name span eligible)
  {
    (let idx (vecLen lx.binders))
    {
      (vecPush lx.binders
        (LspLintBinder :name name :span span :used 0 :owner lx.owner :eligible eligible))
      (vecPush lx.scope name)
      (vecPush lx.idxs idx)
      0
    }
  })

; Mark the innermost binding of `name` used. A name resolving to
; nothing - a top-level declaration, an unbound variable the checker
; will report - marks nothing, which is exactly right: the checker
; owns that verdict and this walk must not invent a second one about
; the same bytes.
(pub :: lspLintUse (-> LspLint String Int))
(pub fn (lspLintUse lx name)
  {
    (let scope lx.scope)
    (let idxs lx.idxs)
    (let mut i (- (vecLen scope) 1))
    {
      (while (>= i 0)
        (if (strEq (vecGet scope i) name)
          {
            (let b (vecGet lx.binders (vecGet idxs i)))
            (set b.used 1)
            (set i (- 0 1))
          }
          (set i (- i 1))))
      0
    }
  })

; Whether any binding of `name` is in scope: what keeps a rebased
; `true` from reading as the boolean.
(pub :: lspLintScopeHas (-> LspLint String Bool))
(pub fn (lspLintScopeHas lx name)
  {
    (let scope lx.scope)
    (let mut i (- (vecLen scope) 1))
    (let mut found false)
    {
      (while (>= i 0)
        (if (strEq (vecGet scope i) name)
          {
            (set found true)
            (set i (- 0 1))
          }
          (set i (- i 1))))
      found
    }
  })

; Close `n` scopes. A binder that was eligible and never marked is a
; `lint-unused-let` at its own span - which spells its name, the one
; invariant `check_range` asks of every diagnostic this server
; publishes.
(pub :: lspLintPop (-> LspLint Int Int))
(pub fn (lspLintPop lx n)
  {
    (let scope lx.scope)
    (let idxs lx.idxs)
    (let binders lx.binders)
    {
      (for i in 0..n
        {
          (let idx (vecGet idxs (- (vecLen idxs) 1)))
          {
            (vecPop scope)
            (vecPop idxs)
            {
              (let b (vecGet binders idx))
              (if (&& (== b.eligible 1) (== b.used 0))
                (lspLintRecord lx b.span (lintUnusedLet)
                  (concat (concat "`" b.name) "` is bound here and never read")))
            }
          }
        })
      0
    }
  })

; One lint record: span, code, message, owner. Suppression is checked
; once, at flush, so recording never needs the map.
(pub :: lspLintRecord (-> LspLint Int String String Int))
(pub fn (lspLintRecord lx span code msg)
  {
    (vecPush lx.records (LspLintRec :span span :code code :msg msg :owner lx.owner))
    0
  })

; `true` or `false` as a bare variable with a span worth pointing at.
(pub :: lspLintBoolName (-> ASTNode String Bool))
(pub fn (lspLintBoolName e want)
  (if (== (nodeTag e) TAG_E_VAR)
    (if (strEq (nodeAName e) want)
      (!= (nodeSpan e) 0)
      false)
    false))

; The `if` rules. The dead branch is checked first: `(if true true
; false)` is dead code before it is anything else, and one Hint per
; site is the whole allowance - two squiggles on one form would read
; as stuttering.
(pub :: lspLintIf (-> LspLint ASTNode Int))
(pub fn (lspLintIf lx e)
  {
    (let t (nodeAChild e))
    (if (== (nodeTag t) TAG_E_VAR)
      {
        (let cn (nodeAName t))
        (let sp (nodeSpan t))
        (if (== sp 0)
          0
          (if (lspLintPlainName cn)
            (if (strEq cn "true")
              (if (lspLintScopeHas lx "true")
                0
                (lspLintRecord lx sp (lintDeadBranch)
                  "`true` is always true; the second branch never runs"))
              (if (strEq cn "false")
                (if (lspLintScopeHas lx "false")
                  0
                  (lspLintRecord lx sp (lintDeadBranch)
                    "`false` is always false; the first branch never runs"))
                (lspLintBoolIf lx e cn sp)))
            0))
      }
      0)
  })

; `(if c true false)` answers `c` unchanged. The branches must be the
; booleans themselves - rebound under a shadowing `let`, they are
; just names, which is why the scope is asked and not only the tree.
; The condition stays a bare name for the reason the header gives:
; the squiggle must spell what the message quotes.
(pub :: lspLintBoolIf (-> LspLint ASTNode String Int Int))
(pub fn (lspLintBoolIf lx e cn sp)
  (if (lspLintBoolName (nodeBChild e) "true")
    (if (lspLintBoolName (nodeCChild e) "false")
      (if (lspLintScopeHas lx "true")
        0
        (if (lspLintScopeHas lx "false")
          0
          (lspLintRecord lx sp (lintBoolIf)
            (concat (concat "`" cn) "` is handed straight back; the `if` adds nothing"))))
      0)
    0))

; Match arms: pattern binders scope the arm body, then pop. The count
; answers how many, exactly as `lspNavWalkArms` counts for its own
; pop.
(pub :: lspLintArms (-> LspLint (Vec ASTNode) Int Int))
(pub fn (lspLintArms lx arms i)
  (if (>= i (vecLen arms))
    0
    {
      (let arm (vecGet arms i))
      {
        (if (== (nodeTag arm) TAG_M_ARM)
          {
            (let bound (lspLintPat lx (nodeAChild arm)))
            {
              (lspLintWalk lx (nodeBChild arm))
              (lspLintPop lx bound)
            }
          }
          (if (== (nodeTag arm) TAG_M_FOR)
            {
              (lspLintWalk lx (nodeBChild arm))
              (lspLintPush lx (nodeAName arm) 0 0)
              (lspLintArms lx (nodeCChildren arm) 0)
              (lspLintPop lx 1)
            }))
        (lspLintArms lx arms (+ i 1))
      }
    }))

; Pattern binders resolve references but are never reported: a field
; ignored by name documents the shape it came in, and `_` says so
; out loud. `lspNavWalkPat`'s shape, without the occurrences.
(pub :: lspLintPat (-> LspLint ASTNode Int))
(pub fn (lspLintPat lx p)
  (if (nodeSame p nilNode)
    0
    {
      (let tag (nodeTag p))
      (if (== tag TAG_E_VAR)
        (if (|| (strEq (nodeAName p) "_") (== (nodeSpan p) 0))
          0
          {
            (lspLintPush lx (nodeAName p) (nodeSpan p) 0)
            1
          })
        (if (== tag TAG_E_APP)
          (lspLintPatSpine lx p)
          (if (== tag TAG_P_CONNAMED)
            (lspLintPatVec lx (nodeCChildren p) 0)
            0)))
    }))

; `(Just x)` is App(Var Just, Var x): the spine's head names the
; constructor and every argument along it is a sub-pattern.
(pub :: lspLintPatSpine (-> LspLint ASTNode Int))
(pub fn (lspLintPatSpine lx m)
  (if (== (nodeTag m) TAG_E_APP)
    {
      (let a (lspLintPatSpine lx (nodeAChild m)))
      (+ a (lspLintPat lx (nodeBChild m)))
    }
    (if (== (nodeTag m) TAG_E_VAR)
      0
      (lspLintPat lx m))))

(pub :: lspLintPatVec (-> LspLint (Vec ASTNode) Int Int))
(pub fn (lspLintPatVec lx pats i)
  (if (>= i (vecLen pats))
    0
    {
      (let a (lspLintPat lx (vecGet pats i)))
      (+ a (lspLintPatVec lx pats (+ i 1)))
    }))

(pub :: lspLintWalkVec (-> LspLint (Vec ASTNode) Int Int))
(pub fn (lspLintWalkVec lx xs i)
  (if (>= i (vecLen xs))
    0
    {
      (lspLintWalk lx (vecGet xs i))
      (lspLintWalkVec lx xs (+ i 1))
    }))

; The walk: expressions. Every arm reads exactly the children
; `lspNavWalk` reads for its tag and nothing else, and a tag with no
; arm is a leaf it descends nowhere from - missing a use would be a
; false positive, so coverage here is the correctness property, and
; it is held by construction against that walk's case list.
(pub :: lspLintWalk (-> LspLint ASTNode Int))
(pub fn (lspLintWalk lx e)
  (if (nodeSame e nilNode)
    0
    {
      (let tag (nodeTag e))
      (if (== tag TAG_E_VAR)
        (lspLintUse lx (nodeAName e))
        (if (== tag TAG_E_APP)
          {
            (lspLintAxql lx e)
            (lspLintWalk lx (nodeAChild e))
            (lspLintWalk lx (nodeBChild e))
          }
          (if (== tag TAG_E_LAM)
            {
              (let ps (nodeANames e))
              (if (== (vecLen ps) 0)
                (lspLintWalk lx (nodeBChild e))
                {
                  (lspLintPush lx (vecGet ps 0) 0 0)
                  (lspLintWalk lx (nodeBChild e))
                  (lspLintPop lx 1)
                })
            }
            (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
              {
                (lspLintWalk lx (nodeBChild e))
                (lspLintPush lx (nodeAName e) (nodeSpan e)
                  (if (lspLintLetOk (nodeAName e) (nodeSpan e))
                    1
                    0))
                (lspLintWalk lx (nodeCChild e))
                (lspLintPop lx 1)
              }
              (if (== tag TAG_E_IF)
                {
                  (lspLintIf lx e)
                  (lspLintWalk lx (nodeAChild e))
                  (lspLintWalk lx (nodeBChild e))
                  (lspLintWalk lx (nodeCChild e))
                }
                (if (== tag TAG_E_BEGIN)
                  (lspLintWalkVec lx (nodeAChildren e) 0)
                  (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
                    (if (== tag TAG_E_REGION)
                      (lspLintWalk lx (nodeBChild e))
                      {
                        (lspLintWalk lx (nodeAChild e))
                        (lspLintWalkVec lx (nodeBChildren e) 0)
                      })
                    (if (== tag TAG_E_MATCH)
                      {
                        (lspLintWalk lx (nodeAChild e))
                        (lspLintArms lx (nodeBChildren e) 0)
                      }
                      ; `cond` is AX2004: the parser builds none, so
                      ; no arm lints one. A variadic `if` arrives as
                      ; nested `if`s and walks the `if` arm.
                      (if (== tag TAG_E_SET)
                        ; The target is not marked: only reads keep
                        ; a binding alive, so a `set!` with no read
                        ; anywhere is still a dead binding. The
                        ; value follows the target in the source
                        ; and in this list.
                        (lspLintWalk lx (nodeBChild e))
                        (if (|| (== tag TAG_E_FIELD) (== tag TAG_E_TRY))
                          (lspLintWalk lx (nodeAChild e))
                          (if (== tag TAG_E_SETF)
                            {
                              (lspLintWalk lx (nodeAChild e))
                              (lspLintWalk lx (nodeCChild e))
                            }
                            (if (== tag TAG_E_HANDLE)
                              {
                                (lspLintWalk lx (nodeAChild e))
                                (lspLintWalk lx (nodeCChild e))
                              }
                              0))))))))))))
    }))

; One declaration: a fresh scope under its own name, its parameters
; bound over its body. Macro bodies are not entered - templates are
; staging code, and a use inside one is a different question from a
; use at runtime - and neither are signatures, data, structs or
; imports, which hold no expressions. A top-level macro invocation's
; arguments are ordinary expressions and are walked.
(pub :: lspLintWalkDecl (-> LspLint ASTNode Int))
(pub fn (lspLintWalkDecl lx d)
  {
    (let tag (nodeTag d))
    {
      (set lx.scope vecNew)
      (set lx.idxs vecNew)
      (set lx.owner (nodeAName d))
      (if (== tag TAG_D_FN)
        {
          (let params (nodeBNames d))
          {
            (for i in 0..(vecLen params)
              (lspLintPush lx (vecGet params i) 0 0))
            (lspLintWalk lx (nodeCChild d))
            (lspLintPop lx (vecLen params))
          }
        }
        (if (== tag TAG_D_MACROCALL)
          (lspLintWalkVec lx (nodeBChildren d) 0)
          0))
    }
  })

; The suppression map: owner names to the lint codes their AXTAGs
; name, read off the declarations' own word-7 tags - the same
; attachment `attachAxtags` gives every other per-declaration claim,
; so a tag above either half of a `::`/`fn` pair lands on the one
; owner both halves share. Two parallel vectors, owners beside code
; vectors, because a vector holds one type and a name is not a Vec.
(pub :: lspLintSuppBuild (-> LspLint (Vec ASTNode) Int))
(pub fn (lspLintSuppBuild lx decls)
  {
    (for d in decls
      (match (nodeAxtagsOpt d)
        ((None) 0)
        ((Some tags)
          ; An import's tag is the file's, under the owner "" that
          ; `lspLintSuppressed` asks about for every record.
          (lspLintSuppDecl lx
            (if (== (nodeTag d) TAG_D_IMPORT)
              ""
              (nodeAName d))
            tags 0)
        )))
    0
  })

; One declaration's tags into the map. Only the `nolint` key is
; read; every other key belongs to the checker or to someone else's
; metadata and is left where it lay.
(pub :: lspLintSuppDecl (-> LspLint String Axtags Int Int))
(pub fn (lspLintSuppDecl lx owner tags i)
  (if (>= i (vecLen tags))
    0
    {
      (let tag (vecGet tags i))
      (lspLintTagCodes lx owner tag.off tag.content)
      (lspLintSuppDecl lx owner tags (+ i 1))
    }))

; The names one tag lists, read by `nolintNames` (the same reading
; `axiom check` uses for warnings), entered under the owner. A name
; nothing answers to draws `lint-unknown-nolint` at the tag itself:
; `off` is the tag's byte offset and the span runs over `;@axiom:`
; and the content.
(pub :: lspLintTagCodes (-> LspLint String Int String Int))
(pub fn (lspLintTagCodes lx owner off content)
  {
    (let codes (nolintNames content))
    (if (== (vecLen codes) 0)
      0
      {
        (for i in 0..(vecLen codes)
          (if (! (nolintKnownName (vecGet codes i)))
            ; The squiggle sits on the name itself: `off` is the
            ; tag's byte offset and the content starts 8 bytes in,
            ; after `;@axiom:`.
            {
              (let at
                (if (let (Some k) (strFind content (vecGet codes i) 0))
                  k
                  0))
              {
                (set lx.owner owner)
                (lspLintRecord lx
                  (mkSpan (+ off (+ 8 at)) (+ off (+ 8 (+ at (strLen (vecGet codes i))))))
                  lintUnknownNolint
                  (concat (concat "no lint or warning named `" (vecGet codes i))
                    "`; `nolint` takes lint-dead-branch, lint-bool-if, lint-unused-let, lint-axql, hints, warnings, all, or a warning code such as AX3037"))
              }
            }))
        (lspLintSuppAdd lx owner codes 0)
      })
  })

; Merge one declaration's codes under its owner: an entry already
; there gains the codes (a tag above each half is two entries for
; one declaration), else the owner is entered with them.
(pub :: lspLintSuppAdd (-> LspLint String Strings Int Int))
(pub fn (lspLintSuppAdd lx owner codes i)
  (if (>= i (vecLen codes))
    0
    {
      (let code (vecGet codes i))
      (let owners lx.owners)
      (let codevecs lx.codevecs)
      (let mut at (- 0 1))
      {
        (for j in 0..(vecLen owners)
          (if (strEq (vecGet owners j) owner)
            (set at j)))
        (if (< at 0)
          {
            (let v vecNew)
            {
              (vecPush v code)
              (vecPush owners owner)
              (vecPush codevecs v)
            }
          }
          (vecPush (vecGetVec codevecs at) code))
        (lspLintSuppAdd lx owner codes (+ i 1))
      }
    }))

; Whether `code` is quieted for `owner`: named, or the `all` that
; names everything. An unknown name matches nothing and is ignored,
; which is what makes a misspelled suppression visible as the lint
; it failed to quiet rather than as a verdict about the tag.
(pub :: lspLintSuppressed (-> LspLint String String Bool))
(pub fn (lspLintSuppressed lx owner code)
  {
    (let owners lx.owners)
    (let codevecs lx.codevecs)
    (let mut out false)
    {
      (for j in 0..(vecLen owners)
        (if (|| (strEq (vecGet owners j) owner) (== (strLen (vecGet owners j)) 0))
          ; The owner's own names, and the file's under "".
          (if (nolintCovers (vecGetVec codevecs j) code 1)
            (set out true))))
      out
    }
  })

; ==================================================================
; AXQL in a query literal.
;
; A string literal in the query position of one of the library's
; text-taking entry points - the second argument of `axqExec`,
; `axqExecBatch` and `axqPrepare`, the first of `axqSql` - is an AXQL
; statement the program hands to the library when it runs. The server
; reads it as one. A statement the parser refuses draws the
; `lint-axql` hint, at the word the parser stopped on; completion inside
; the literal offers AXQL's words and the tables and columns the
; document itself creates; hover answers for a keyword, a function or
; one of those names; and highlighting colours the statement's tokens
; (`lspHlScan`). Everything is answered by the library's own parser,
; `Axqlite.AxqlParse`, so the server keeps no second grammar for the
; language. The literal is found from the tokens, not the tree, so
; completion and hover work while the form around it is still being
; typed; the lint reads the tree, so it never fires on a document that
; does not parse.
; ==================================================================
; The index of the statement argument of a text-taking entry point, or
; -1 for any other head.
(pub :: lspAxqlArgIndex (-> String (Option Int)))
(pub fn (lspAxqlArgIndex head)
  (if (|| (strEq head "axqExec") (|| (strEq head "axqExecBatch") (strEq head "axqPrepare")))
    (Some 1)
    (if (strEq head "axqSql")
      (Some 0)
      None)))

; Whether token kind `k` opens a form, and whether it closes one.
(pub :: lspAxqlOpens (-> Int Bool))
(pub fn (lspAxqlOpens k)
  (|| (== k (kindInt TK_LPAREN)) (|| (== k (kindInt TK_LBRACE)) (== k (kindInt TK_LBRACKET)))))

(pub :: lspAxqlCloses (-> Int Bool))
(pub fn (lspAxqlCloses k)
  (|| (== k (kindInt TK_RPAREN)) (|| (== k (kindInt TK_RBRACE)) (== k (kindInt TK_RBRACKET)))))

; A query literal: its start and end in the bytes, quotes included, its
; head's name, and whether the head takes a script.
(pub struct LspAxqlLit
  (start : Int)
  (end : Int)
  (head : String)
  (script : Bool))

; The query literal `off` sits in, from the document's tokens, or
; `None` when `off` is not inside a string literal in a query position.
(pub :: lspAxqlLitAt (-> String Int (Option LspAxqlLit)))
(pub fn (lspAxqlLitAt src off)
  {
    (let toks (lex src))
    (let n (vecLen toks))
    (let mut hit (:: None (Option Int)))
    (let mut i 0)
    {
      (while (&& (< i n) (isNone hit))
        {
          (let t (vecGet toks i))
          (if (== (kindInt (tokenKind t)) (kindInt TK_STRING))
            (if (&& (> off (spanStart (tokenSpan t))) (< off (spanEnd (tokenSpan t))))
              (set hit (Some i))))
          (set i (+ i 1))
        })
      (match hit
        ((None) None)
        ((Some hit) (lspAxqlLitOf toks hit)))
    }
  })

; The same for the string token at index `hit` of `toks`, or `None`:
; the form it is an argument of is found by walking back to the first
; unmatched opener, its head is read past a `Module::` qualifier, and
; the literal's position among the arguments is counted forward, a
; nested form counting as one argument.
(pub :: lspAxqlLitOf (-> Tokens Int (Option LspAxqlLit)))
(pub fn (lspAxqlLitOf toks hit)
  {
    (let mut depth 0)
    (let mut j (- hit 1))
    (let mut open (:: None (Option Int)))
    {
      (while (&& (>= j 0) (isNone open))
        {
          (let k (kindInt (tokenKind (vecGet toks j))))
          (if (lspAxqlCloses k)
            (set depth (+ depth 1))
            (if (lspAxqlOpens k)
              (if (== depth 0)
                (set open (Some j))
                (set depth (- depth 1)))))
          (set j (- j 1))
        })
      (match open
        ((None) None)
        ((Some open)
          (if (!= (kindInt (tokenKind (vecGet toks open))) (kindInt TK_LPAREN))
            None
            (lspAxqlLitHead toks hit (+ open 1)))
        ))
    }
  })

; The block, given the index `h` of the form's head token.
(pub :: lspAxqlLitHead (-> Tokens Int Int (Option LspAxqlLit)))
(pub fn (lspAxqlLitHead toks hit h)
  (if (>= h hit)
    None
    (if (!= (kindInt (tokenKind (vecGet toks h))) (kindInt TK_IDENT))
      None
      {
        (let last (lspAxqlHeadLast toks h hit))
        (let head (tokenLexeme (vecGet toks last)))
        (let want (lspAxqlArgIndex head))
        (match want
          ((None) None)
          ((Some want)
            {
              (let mut args 0)
              (let mut d 0)
              {
                (for k in (+ last 1)..hit
                  {
                    (let kk (kindInt (tokenKind (vecGet toks k))))
                    (if (lspAxqlOpens kk)
                      {
                        (if (== d 0)
                          (set args (+ args 1)))
                        (set d (+ d 1))
                      }
                      (if (lspAxqlCloses kk)
                        (set d (- d 1))
                        (if (== d 0)
                          (set args (+ args 1)))))
                  })
                (if (!= args want)
                  None
                  {
                    (let sp (tokenSpan (vecGet toks hit)))
                    (Some
                      (LspAxqlLit
                        :start (spanStart sp)
                        :end (spanEnd sp)
                        :head head
                        :script (strEq head "axqExecBatch")))
                  })
              }
            }
          ))
      })))

; The last identifier of a qualified head, including a dotted
; module path such as `Store.Queries::axqSql`.
(:: lspAxqlHeadLast (-> Tokens Int Int Int))
(fn (lspAxqlHeadLast toks first stop)
  {
    (let mut last first)
    (let mut scan (+ first 1))
    (let mut qualified false)
    (let mut go true)
    (while (&& go (< (+ scan 1) stop))
      {
        (let kind (kindInt (tokenKind (vecGet toks scan))))
        (if (&& (|| (== kind (kindInt TK_DOT)) (== kind (kindInt TK_DOUBLE_COLON)))
              (== (kindInt (tokenKind (vecGet toks (+ scan 1)))) (kindInt TK_IDENT)))
          {
            (if (== kind (kindInt TK_DOUBLE_COLON))
              (set qualified true))
            (set last (+ scan 1))
            (set scan (+ scan 2))
          }
          (set go false))
      })
    (if qualified
      last
      first)
  })

; The value of the string literal whose bytes, quotes included, are
; `src[start .. end)`: the language's escapes undone, or "" when the
; literal carries an escape this reading does not know, so nothing is
; said about a text the server cannot be sure of.
(pub :: lspAxqlLitValue (-> String Int Int String))
(pub fn (lspAxqlLitValue src start end)
  {
    (let out (strBuilderNew))
    (let mut i (+ start 1))
    (let stop (- end 1))
    (let mut ok true)
    {
      (while (&& ok (< i stop))
        {
          (let c (strByte src i))
          (if (!= c 92)
            {
              (strBuilderPushByte out c)
              (set i (+ i 1))
            }
            {
              (let d (strByte src (+ i 1)))
              (if (isEscapeChar d)
                (strBuilderPushByte out (unescByte d))
                (set ok false))
              (set i (+ i 2))
            })
        })
      (if ok
        (strBuilderFinish out)
        "")
    }
  })

; Whether `src[start .. end)` - a literal with its quotes - spells a
; byte that `lspAxqlLitValue` would undo, so a position inside the
; value is not a position inside the bytes.
(pub :: lspAxqlLitEscaped (-> String Int Int Bool))
(pub fn (lspAxqlLitEscaped src start end)
  {
    (let mut i (+ start 1))
    (let mut found false)
    {
      (while (&& (! found) (< i (- end 1)))
        {
          (if (== (strByte src i) 92)
            (set found true))
          (set i (+ i 1))
        })
      found
    }
  })

; The parser's refusal of `text`, or None when it reads. Error keeps
; its context separate from the message, including quoted user text.
(pub :: lspAxqlRefusal (-> String Bool (Option String)))
(pub fn (lspAxqlRefusal text script)
  (if script
    (match (axqlParseScript text)
      ((Ok _) None)
      ((Err e) (Some (errMessage e))))
    (match (axqlParse text)
      ((Ok _) None)
      ((Err e) (Some (errMessage e))))))

; The byte offset in `text` of "line L, column C" as the parser spells
; a position at the head of its message, or None when the message does
; not open with one.
(pub :: lspAxqlErrOffset (-> String String (Option Int)))
(pub fn (lspAxqlErrOffset text msg)
  (if (! (strStartsWith msg "line "))
    None
    (match (lspAxqlDigitsAt msg 5)
      ((None) None)
      ((Some line)
        (match (strFind msg "column " 0)
          ((None) None)
          ((Some c)
            (match (lspAxqlDigitsAt msg (+ c 7))
              ((None) None)
              ((Some col)
                (if (|| (< line 1) (< col 1))
                  None
                  {
                    (let mut i 0)
                    (let mut l 1)
                    (let n (strLen text))
                    (while (&& (< l line) (< i n))
                      {
                        (if (== (strByte text i) 10)
                          (set l (+ l 1)))
                        (set i (+ i 1))
                      })
                    (Some
                      (if (> (+ i (- col 1)) n)
                        n
                        (+ i (- col 1))))
                  })
              ))
          ))
      ))))

; The decimal number at `at` in `s`, or -1 when no digit is there.
(pub :: lspAxqlDigitsAt (-> String Int (Option Int)))
(pub fn (lspAxqlDigitsAt s at)
  (if (< at 0)
    None
    {
      (let mut i at)
      (let mut v 0)
      (let mut any false)
      {
        (while (&& (< i (strLen s)) (&& (>= (strByte s i) 48) (<= (strByte s i) 57)))
          {
            (set v (+ (* v 10) (- (strByte s i) 48)))
            (set any true)
            (set i (+ i 1))
          })
        (if any
          (Some v)
          None)
      }
    }))

; The end of the AXQL word starting at `at` in `s`: letters, digits
; and `_`, or `at` itself when no word starts there.
(pub :: lspAxqlWordEnd (-> String Int Int))
(pub fn (lspAxqlWordEnd s at)
  {
    (let mut i at)
    {
      (while (&& (< i (strLen s)) (lspAxqlWordByte (strByte s i)))
        (set i (+ i 1)))
      i
    }
  })

(pub :: lspAxqlWordByte (-> Int Bool))
(pub fn (lspAxqlWordByte c)
  (|| (&& (>= c 97) (<= c 122))
    (|| (&& (>= c 65) (<= c 90)) (|| (&& (>= c 48) (<= c 57)) (== c 95)))))

; The lint for the application `e` when its last argument is a string
; literal in a query position: the parser's refusal, at the word it
; stopped on when the literal's bytes let the position through, and
; over the whole text otherwise.
(pub :: lspLintAxql (-> LspLint ASTNode Int))
(pub fn (lspLintAxql lx e)
  {
    (let b (nodeBChild e))
    (if (!= (nodeTag b) TAG_E_STR)
      0
      {
        (let mut h (nodeAChild e))
        (let mut idx 0)
        {
          (while (== (nodeTag h) TAG_E_APP)
            {
              (set idx (+ idx 1))
              (set h (nodeAChild h))
            })
          (if (!= (nodeTag h) TAG_E_VAR)
            0
            {
              (let head (bareOf (nodeAName h)))
              (match (lspAxqlArgIndex head)
                ((None) 0)
                ((Some wanted)
                  (if (!= wanted idx)
                    0
                    (if (== (nodeSpan b) 0)
                      0
                      (lspLintAxqlText lx b (strEq head "axqExecBatch"))))
                ))
            })
        }
      })
  })

(pub :: lspLintAxqlText (-> LspLint ASTNode Bool Int))
(pub fn (lspLintAxqlText lx node script)
  {
    ; The raw parse stores a string's quoted spelling. Read its value
    ; from the document, as schema discovery and hover do.
    (let src lx.src)
    (let sp (nodeSpan node))
    (let text (lspAxqlLitValue src (spanStart sp) (spanEnd sp)))
    (let msg (lspAxqlRefusal text script))
    (match msg
      ((None) 0)
      ((Some msg)
        {
          (let start (spanStart sp))
          (let end (spanEnd sp))
          (let at (lspAxqlErrOffset text msg))
          (let inner (- (- end start) 2))
          ; the word at the parser's position, when the bytes are the
          ; value and a word is there; else the whole text
          (let narrow
            (match at
              ((None) None)
              ((Some at)
                (if (|| (lspAxqlLitEscaped src start end) (> at inner))
                  None
                  (if (< at (lspAxqlWordEnd text at))
                    (Some at)
                    None))
              )))
          (let ws
            (match narrow
              ((None) (+ start 1))
              ((Some at) (+ (+ start 1) at))))
          (let we
            (match narrow
              ((None) (- end 1))
              ((Some at) (+ (+ start 1) (lspAxqlWordEnd text at)))))
          (let quoted (strSlice src ws (- we ws)))
          (if (> (- we ws) 0)
            (lspLintRecord lx (mkSpan ws we) lintAxql
              (concat (concat "`" quoted) (concat "` is not a statement AXQL reads: " msg)))
            0)
        }
      ))
  })

; ------------------------------------------------------------------
; The document's own schema: the tables and columns its CREATE TABLE
; statements and `axqlCreateTable`/`axqlTable` forms declare, read
; from the tokens: the table names, and the columns as `table.column`.
; ------------------------------------------------------------------
(pub struct LspAxqlSchema
  (tables : Strings)
  (columns : Strings))

(pub :: lspAxqlSchema (-> String LspAxqlSchema))
(pub fn (lspAxqlSchema src)
  {
    (let toks (lex src))
    (let n (vecLen toks))
    (let tables vecNew)
    (let columns vecNew)
    {
      (for i in 0..n
        {
          (let t (vecGet toks i))
          (let k (kindInt (tokenKind t)))
          (if (== k (kindInt TK_STRING))
            (if (let (Some q) (lspAxqlLitOf toks i))
              (lspAxqlSchemaFromText tables columns (lspAxqlLitValue src q.start q.end) q.script)
              0)
            (if (&& (== k (kindInt TK_IDENT)) (> i 0))
              (if (== (kindInt (tokenKind (vecGet toks (- i 1)))) (kindInt TK_LPAREN))
                (lspAxqlSchemaFromForm tables columns toks i))))
        })
      (LspAxqlSchema :tables tables :columns columns)
    }
  })

; CREATE TABLE statements in a text, parsed by the library.
(pub :: lspAxqlSchemaFromText (-> Strings Strings String Bool Int))
(pub fn (lspAxqlSchemaFromText tables columns text script)
  (if (== (strLen text) 0)
    0
    (if script
      (match (axqlParseScript text)
        ((Ok ps)
          {
            (for p in ps
              (lspAxqlSchemaFromStmt tables columns p.stmt))
            0
          }
        )
        ((Err _) 0))
      (match (axqlParse text)
        ((Ok p) (lspAxqlSchemaFromStmt tables columns p.stmt))
        ((Err _) 0)))))

(pub :: lspAxqlSchemaFromStmt (-> Strings Strings Stmt Int))
(pub fn (lspAxqlSchemaFromStmt tables columns stmt)
  (match stmt
    ((SCreateTable _ name cols)
      {
        (lspAxqlSchemaTable tables name)
        (for c in cols
          (vecPush columns (concat name (concat "." c.name))))
        0
      }
    )
    (_ 0)))

(pub :: lspAxqlSchemaTable (-> Strings String Int))
(pub fn (lspAxqlSchemaTable tables name)
  {
    (let mut seen false)
    (for t in tables
      (if (strEq t name)
        (set seen true)))
    (if seen
      0
      {
        (vecPush tables name)
        0
      })
  })

; `(axqlCreateTable [IF NOT EXISTS] table (column ...) ...)` and
; `(axqlTable Type table (field Type) ...)`, from the head token at
; `h`: the table is the first identifier past the leading words, and
; each parenthesised item names a column first.
(pub :: lspAxqlSchemaFromForm (-> Strings Strings Tokens Int Int))
(pub fn (lspAxqlSchemaFromForm tables columns toks h)
  {
    (let head (tokenLexeme (vecGet toks h)))
    (let create (strEq head "axqlCreateTable"))
    (if (! (|| create (strEq head "axqlTable")))
      0
      {
        (let n (vecLen toks))
        (let mut k (+ h 1))
        ; past IF NOT EXISTS, or past the Axiom type name
        {
          (if create
            (while (&& (< k n) (lspAxqlLeadingWord (vecGet toks k)))
              (set k (+ k 1)))
            (set k (+ k 1)))
          (if (|| (>= k n) (!= (kindInt (tokenKind (vecGet toks k))) (kindInt TK_IDENT)))
            0
            {
              (let table (tokenLexeme (vecGet toks k)))
              (lspAxqlSchemaTable tables table)
              (set k (+ k 1))
              (while (&& (< k n) (== (kindInt (tokenKind (vecGet toks k))) (kindInt TK_LPAREN)))
                {
                  (if (&& (< (+ k 1) n)
                        (== (kindInt (tokenKind (vecGet toks (+ k 1)))) (kindInt TK_IDENT)))
                    (vecPush columns
                      (concat table (concat "." (tokenLexeme (vecGet toks (+ k 1)))))))
                  ; to the item's own `)`
                  (let mut d 0)
                  (let mut go true)
                  (while (&& go (< k n))
                    {
                      (let kk (kindInt (tokenKind (vecGet toks k))))
                      (if (== kk (kindInt TK_LPAREN))
                        (set d (+ d 1))
                        (if (== kk (kindInt TK_RPAREN))
                          (set d (- d 1))))
                      (set k (+ k 1))
                      (if (== d 0)
                        (set go false))
                    })
                })
              0
            })
        }
      })
  })

; IF, NOT and EXISTS in any case, which `axqlCreateTable` takes before
; the table.
(pub :: lspAxqlLeadingWord (-> Token Bool))
(pub fn (lspAxqlLeadingWord t)
  (if (!= (kindInt (tokenKind t)) (kindInt TK_IDENT))
    false
    {
      (let w (strLower (tokenLexeme t)))
      (|| (strEq w "if") (|| (strEq w "not") (strEq w "exists")))
    }))

; ------------------------------------------------------------------
; Completion inside a query literal: the reserved and contextual
; words, the functions, and the document's tables and columns. Words
; are offered in the case the prefix is typed in, so `sel` and `SEL`
; both complete.
; ------------------------------------------------------------------
(pub :: lspComplAxql (-> Int Strings String String Int))
(pub fn (lspComplAxql out seen src prefix)
  {
    (let lower (lspAxqlPrefixIsLower prefix))
    (let schema (lspAxqlSchema src))
    {
      (lspComplAxqlWords out seen axqlKeywords 14 "AXQL keyword" prefix lower)
      (lspComplAxqlWords out seen axqlContextWords 14 "AXQL keyword" prefix lower)
      (for f in (strSplit axqlFunctions 32)
        (lspComplOffer out seen f 3 "AXQL function" prefix))
      (for t in schema.tables
        (lspComplOffer out seen t 7 "table" prefix))
      (for c in schema.columns
        (if (let (Some dot) (strFind c "." 0))
          (lspComplOffer out seen (strSlice c (+ dot 1) (- (strLen c) (+ dot 1))) 5
            (concat "column of " (strSlice c 0 dot)) prefix)
          0))
      0
    }
  })

(pub :: lspComplAxqlWords (-> Int Strings String Int String String Bool Int))
(pub fn (lspComplAxqlWords out seen words kind detail prefix lower)
  {
    (for w in (strSplit words 32)
      (lspComplOffer out seen
        (if lower
          (strLower w)
          w)
        kind detail prefix))
    0
  })

; `w` with its ASCII letters raised.
(pub :: lspAxqlUpper (-> String String))
(pub fn (lspAxqlUpper w)
  {
    (let out (strBuilderWithCapacity (strLen w)))
    (for i in 0..(strLen w)
      {
        (let c (strByte w i))
        (strBuilderPushByte out
          (if (&& (>= c 97) (<= c 122))
            (- c 32)
            c))
      })
    (strBuilderFinish out)
  })

; Whether the first byte of `prefix` is a lower-case letter.
(pub :: lspAxqlPrefixIsLower (-> String Bool))
(pub fn (lspAxqlPrefixIsLower prefix)
  (if (== (strLen prefix) 0)
    false
    (&& (>= (strByte prefix 0) 97) (<= (strByte prefix 0) 122))))

; ------------------------------------------------------------------
; Hover inside a query literal: a keyword or a function from the
; lexicon, a table or a column from the document's own schema.
; ------------------------------------------------------------------
(pub :: lspAxqlHover (-> String Ints Int Int))
(pub fn (lspAxqlHover src ix off)
  {
    (let mut ws off)
    {
      (while (&& (> ws 0) (lspAxqlWordByte (strByte src (- ws 1))))
        (set ws (- ws 1)))
      {
        (let we (lspAxqlWordEnd src ws))
        (if (>= ws we)
          jsonNull
          {
            (let w (strSlice src ws (- we ws)))
            (let range (lspRangeIx src ix (mkSpan ws we)))
            (let md (lspAxqlHoverMarkdown src w))
            (if (== (strLen md) 0)
              jsonNull
              (lspMarkdownHover md range))
          })
      }
    }
  })

(pub :: lspAxqlHoverMarkdown (-> String String String))
(pub fn (lspAxqlHoverMarkdown src w)
  {
    (let upper (lspAxqlUpper w))
    (let kw (lexAxqlDoc upper))
    (if (> (strLen kw) 0)
      (concat (concat "**`" upper) (concat "`** AXQL keyword\n\n" kw))
      {
        (let fnDoc (lexAxqlFunctionDoc (strLower w)))
        (if (> (strLen fnDoc) 0)
          (concat (concat "**`" (strLower w)) (concat "()`** AXQL function\n\n" fnDoc))
          (lspAxqlHoverSchema src w))
      })
  })

(pub :: lspAxqlHoverSchema (-> String String String))
(pub fn (lspAxqlHoverSchema src w)
  {
    (let schema (lspAxqlSchema src))
    (let tables schema.tables)
    (let columns schema.columns)
    (let lw (strLower w))
    (let mut out "")
    {
      (for t in tables
        (if (strEq (strLower t) lw)
          {
            (let cols vecNew)
            (for c in columns
              (if (strStartsWith (strLower c) (concat lw "."))
                (vecPush cols (strSlice c (+ (strLen t) 1) (- (strLen c) (+ (strLen t) 1))))))
            (set out (concat (concat "**`" t)
                       (concat "`** a table this document creates\n\nColumns: "
                         (strJoin cols ", "))))
          }))
      (if (> (strLen out) 0)
        out
        {
          (for c in columns
            (if (let (Some dot) (strFind c "." 0))
              (if (strEq (strLower (strSlice c (+ dot 1) (- (strLen c) (+ dot 1)))) lw)
                (set out (concat (concat "**`" (strSlice c (+ dot 1) (- (strLen c) (+ dot 1))))
                           (concat "`** a column of `" (concat (strSlice c 0 dot) "`")))))
              0))
          out
        })
    }
  })

; One lint as an LSP Diagnostic: Hint severity, this server as the
; source, no related information - a Hint with a link would read as
; stronger than it is. Severity 4 is also what keeps these out of
; the terminal/editor fidelity comparison, which holds `axiom
; check` to the compiler's diagnostics alone.
(pub :: lspLintJson (-> String Ints Int String String Int))
(pub fn (lspLintJson src ix span code msg)
  (jsonObjPut
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix span)) "severity" (jsonNum 4))
        "code" (jsonStr code))
      "source" (jsonStr "axiom"))
    "message" (jsonStr msg)))

; Publish every unsuppressed record into `out`.
(pub :: lspLintFlush (-> LspLint Int String Ints Int))
(pub fn (lspLintFlush lx out src ix)
  {
    (let recs lx.records)
    {
      (for r in recs
        (if (! (lspLintSuppressed lx r.owner r.code))
          (jsonArrPush out (lspLintJson src ix r.span r.code r.msg))))
      0
    }
  })

; Walk every declaration, then publish. The walk is over the raw
; parse tree and expands nothing - MAC-TOOL-3's rule, which is also
; why a lint can never disagree with the checker about what the code
; means: it never sees what the code expands to, only what the
; author wrote.
(pub :: lspLintDoc (-> Int String Ints (Vec ASTNode) Int))
(pub fn (lspLintDoc out src ix decls)
  {
    (let lx (lspLintContext src))
    {
      (lspLintSuppBuild lx decls)
      (for i in 0..(vecLen decls)
        (lspLintWalkDecl lx (vecGet decls i)))
      (lspLintFlush lx out src ix)
    }
  })

; ------------------------------------------------------------------
; Reading a document that does not parse
;
; Most of an editing session is spent in a file that does not parse:
; a form is half typed, a paren is missing, a string is still open.
; The parser stops at the first error, and a request that read only
; its answer would answer `null` until the file parsed again: hover,
; definition, completion, the outline, references and the semantic
; tokens would go blank exactly while somebody was typing.
;
; `lspParse` is the parse those requests read. A document that parses
; gets its own parse, unchanged. One that does not is read again at
; the token level, the way a Lisp editor reads it:
;
;   1. An unterminated string is closed at the end of its line.
;   2. The brackets are balanced. A `(` at column zero while a form is
;      still open starts a new top-level form, and the open one is
;      closed before it, at its last token. A closer nothing opened is
;      dropped, and so is a lexical error.
;   3. Each top-level form is parsed on its own. One that fails is
;      repaired where the parser stopped: a missing operand before a
;      closer gets a `()`, a stray atom is dropped, and otherwise the
;      innermost form around the error becomes `()`, then goes, then
;      its parent is tried. A form that cannot be repaired is dropped.
;
; Every token keeps its own span, and a token the repair adds is given
; an empty span beside a real one, so every node of the result indexes
; the document as it is. `(fn (f x)` half typed at the end of a file
; still binds `x`, and every declaration after a broken one is still
; there.
;
; Word 2 of the answer says how it was got: a clean parse leaves the
; parser's own position there, which is never negative. `-1` means the
; repair added tokens and dropped none, and `-2` that it dropped some,
; so a reference in the dropped text is missing from the tree. Rename
; refuses a `-2` tree, since its edit would miss that reference.
;
; The diagnostics are untouched: `lspCheckDoc` still reports the
; parser's own error, and nothing here reaches `axiom check`.
; ------------------------------------------------------------------
;; The declarations of `src` for a request to read: its parse, or the
;; declarations that still parse around its errors. Word 0 is always
;; 1 and word 1 the declarations.
(pub :: lspParse (-> String (PResult Nodes)))
(pub fn (lspParse src)
  {
    (let toks (lex src))
    (let tags (scanAxtags src))
    {
      (let pr (parseModuleWith toks tags))
      (match pr
        ((ParseFailed parseError2) (lspRecover src toks tags))
        ((ParseSuccess parsedValue2 parsedPos2) pr))
    }
  })

;; Whether `lspParse` had to drop tokens to answer.
(pub :: lspParseLossy (-> (PResult Nodes) Bool))
(pub fn (lspParseLossy pr)
  (== (pResPos pr) (- 0 2)))

;; The recovered parse of a document whose own parse failed.
(pub :: lspRecover (-> String Tokens Axtags (PResult Nodes)))
(pub fn (lspRecover src toks tags)
  {
    (let fixed (lspRecoverStrings src toks 0))
    (let flat vecNew)
    (let bounds vecNew)
    (let decls vecNew)
    {
      (let lossy (lspRecoverBalance src fixed flat bounds))
      (let mut drop 0)
      (let mut i 0)
      {
        ; A string closed at its line's end may have taken in code
        ; that followed the quote on that line.
        (set drop (if (isSome (lspRecOpenString src toks))
          1
          lossy))
        (while (< (+ i 1) (vecLen bounds))
          {
            (let r (lspRepairForm (lspRecSlice flat (vecGet bounds i) (vecGet bounds (+ i 1)))))
            {
              (match r
                ((ParseFailed parseError3)
                  (set drop 1)
                )
                ((ParseSuccess parsedValue3 parsedPos3)
                  {
                    (if (== parsedPos3 (- 0 2))
                      (set drop 1))
                    (lspRecAppend decls parsedValue3)
                  }
                ))
              (set i (+ i 2))
            }
          })
        (attachAxtags decls 0 tags 0)
        (pOk decls
          (if (== drop 1)
            (- 0 2)
            (- 0 1)))
      }
    }
  })

;; The tokens of `src` with each unterminated string closed at the end
;; of its line. The lexer runs a string with no closing quote to the
;; end of the document, which would swallow every form after it; the
;; line's newline is read as the quote instead, so the length and
;; every offset stay the same. A string with no newline after it is
;; left to the balancing step, which drops it. `round` bounds the
;; re-lexing: eight open strings in one document are fixed, and any
;; beyond are dropped.
(pub :: lspRecoverStrings (-> String Tokens Int Tokens))
(pub fn (lspRecoverStrings src toks round)
  (match (lspRecOpenString src toks)
    ((None) toks)
    ((Some at)
      (if (>= round 8)
        toks
        {
          (let nl (findNewline src at (strLen src)))
          (if (>= nl (strLen src))
            toks
            {
              (let src2
                (concat (strSlice src 0 nl)
                  (concat "\"" (strSlice src (+ nl 1) (- (strLen src) (+ nl 1))))))
              (lspRecoverStrings src2 (lex src2) (+ round 1))
            })
        })
    )))

;; The offset of the first unterminated string's opening quote, or -1.
(pub :: lspRecOpenString (-> String Tokens (Option Int)))
(pub fn (lspRecOpenString src toks)
  {
    (let mut i 0)
    (let mut at (:: None (Option Int)))
    {
      (while (if (< i (vecLen toks))
        (isNone at)
        false)
        {
          (let t (vecGet toks i))
          {
            (if (== (kindInt (tokenKind t)) (kindInt TK_ERROR))
              {
                (let s (spanStart (tokenSpan t)))
                (if (< s (strLen src))
                  (if (== (strByte src s) 34)
                    (set at (Some s))))
              })
            (set i (+ i 1))
          }
        })
      at
    }
  })

;; 1, 2 or 3 for a `(`, `{` or `[`, and 0 for any other token.
(pub :: lspRecOpener (-> Token Int))
(pub fn (lspRecOpener t)
  {
    (let k (kindInt (tokenKind t)))
    (if (== k (kindInt TK_LPAREN))
      1
      (if (== k (kindInt TK_LBRACE))
        2
        (if (== k (kindInt TK_LBRACKET))
          3
          0)))
  })

;; 1, 2 or 3 for a `)`, `}` or `]`, and 0 for any other token.
(pub :: lspRecCloser (-> Token Int))
(pub fn (lspRecCloser t)
  {
    (let k (kindInt (tokenKind t)))
    (if (== k (kindInt TK_RPAREN))
      1
      (if (== k (kindInt TK_RBRACE))
        2
        (if (== k (kindInt TK_RBRACKET))
          3
          0)))
  })

;; A closer of bracket kind `b` the repair supplies, with an empty span
;; at `at`.
(pub :: lspRecClose (-> Int Int Token))
(pub fn (lspRecClose b at)
  (if (== b 1)
    (mkToken TK_RPAREN ")" (mkSpan at at))
    (if (== b 2)
      (mkToken TK_RBRACE "}" (mkSpan at at))
      (mkToken TK_RBRACKET "]" (mkSpan at at)))))

;; Whether `stack` holds bracket kind `b` anywhere.
(pub :: lspRecHas (-> Ints Int Bool))
(pub fn (lspRecHas stack b)
  {
    (let mut i 0)
    (let mut hit false)
    {
      (while (if (< i (vecLen stack))
        (! hit)
        false)
        {
          (if (== (vecGet stack i) b)
            (set hit true))
          (set i (+ i 1))
        })
      hit
    }
  })

;; Close every form `stack` still holds, innermost first.
(pub :: lspRecCloseAll (-> Ints Tokens Int Int))
(pub fn (lspRecCloseAll stack flat at)
  {
    (while (> (vecLen stack) 0)
      (vecPush flat (lspRecClose (vecPop stack) at)))
    0
  })

;; Balance `toks` into `flat`, and record each top-level form as a
;; start and end index pair in `bounds`. Answers 1 when a token was
;; dropped and 0 when every token was kept.
(pub :: lspRecoverBalance (-> String Tokens Tokens Ints Int))
(pub fn (lspRecoverBalance src toks flat bounds)
  {
    (let stack vecNew)
    (let n (vecLen toks))
    (let mut start 0)
    (let mut lastEnd 0)
    (let mut lossy 0)
    {
      (for i in 0..n
        {
          (let t (vecGet toks i))
          {
            (let k (kindInt (tokenKind t)))
            (let op (lspRecOpener t))
            (let cl (lspRecCloser t))
            (let s (spanStart (tokenSpan t)))
            (if (|| (== k (kindInt TK_ERROR)) (== k (kindInt TK_ERROR_ESC)))
              (set lossy 1)
              (if (> op 0)
                {
                  ; A `(` at column zero while a form is open: the
                  ; open form ended before it, at its last token.
                  (if (&& (== op 1) (&& (> (vecLen stack) 0) (lspRecColZero src s)))
                    {
                      (lspRecCloseAll stack flat lastEnd)
                      (vecPush bounds start)
                      (vecPush bounds (vecLen flat))
                    })
                  (if (== (vecLen stack) 0)
                    (set start (vecLen flat)))
                  (vecPush stack op)
                  (vecPush flat t)
                  (set lastEnd (spanEnd (tokenSpan t)))
                }
                (if (> cl 0)
                  (if (lspRecHas stack cl)
                    {
                      ; A closer ends the form it matches, and
                      ; every form still open inside that one.
                      (while (!= (vecLast stack) cl)
                        (vecPush flat (lspRecClose (vecPop stack) lastEnd)))
                      (vecPop stack)
                      (vecPush flat t)
                      (set lastEnd (spanEnd (tokenSpan t)))
                      (if (== (vecLen stack) 0)
                        {
                          (vecPush bounds start)
                          (vecPush bounds (vecLen flat))
                        })
                    }
                    (set lossy 1))
                  (if (!= k (kindInt TK_EOF))
                    {
                      (if (== (vecLen stack) 0)
                        (set start (vecLen flat)))
                      (vecPush flat t)
                      (set lastEnd (spanEnd (tokenSpan t)))
                      (if (== (vecLen stack) 0)
                        {
                          (vecPush bounds start)
                          (vecPush bounds (vecLen flat))
                        })
                    }))))
          }
        })
      (if (> (vecLen stack) 0)
        {
          (lspRecCloseAll stack flat lastEnd)
          (vecPush bounds start)
          (vecPush bounds (vecLen flat))
        })
      lossy
    }
  })

;; Whether the byte at `s` begins its line.
(pub :: lspRecColZero (-> String Int Bool))
(pub fn (lspRecColZero src s)
  (if (== s 0)
    true
    (if (<= s (strLen src))
      (== (strByte src (- s 1)) 10)
      false)))

;; `flat[s..e)` as a token vector of its own, ending in the EOF token
;; the parser expects.
(pub :: lspRecSlice (-> Tokens Int Int Tokens))
(pub fn (lspRecSlice flat s e)
  {
    (let out vecNew)
    {
      (for i in s..e
        (vecPush out (vecGet flat i)))
      {
        (let at
          (if (> e s)
            (spanEnd (tokenSpan (vecGet flat (- e 1))))
            0))
        (vecPush out (mkToken TK_EOF "" (mkSpan at at)))
      }
      out
    }
  })

;; Append every element of `more` to `out`.
(pub :: lspRecAppend (-> (Vec ASTNode) (Vec ASTNode) Int))
(pub fn (lspRecAppend out more)
  {
    (let mut i 0)
    {
      (while (< i (vecLen more))
        {
          (vecPush out (vecGet more i))
          (set i (+ i 1))
        })
      0
    }
  })

;; One top-level form's parse, repaired where it fails. Word 0 is 0
;; when no repair made it parse. Word 2 is -1 when a repair only added
;; tokens, and -2 when it dropped some of the form's own.
(pub :: lspRepairForm (-> Tokens (PResult Nodes)))
(pub fn (lspRepairForm toks)
  {
    (let pr (parseModuleWith toks vecNew))
    (match pr
      ((ParseFailed parseError4)
        (lspRepairStep toks (ParseFailed parseError4) vecNew 32 (lspRecRealCount toks))
      )
      ((ParseSuccess parsedValue4 parsedPos4) pr))
  })

(pub :: lspRepairStep (-> Tokens (PResult Nodes) Ints Int Int (PResult Nodes)))
(pub fn (lspRepairStep toks pr tried left want)
  (if (<= left 0)
    pr
    {
      (let next (lspRepairEdit toks (lspRecErrAt toks (pResPos pr)) tried))
      (if (== (vecLen next) 0)
        pr
        {
          (let pr2 (parseModuleWith next vecNew))
          (match pr2
            ((ParseFailed parseError5)
              (lspRepairStep next (ParseFailed parseError5) tried (- left 1) want)
            )
            ((ParseSuccess parsedValue5 parsedPos5)
              (pOk parsedValue5
                (if (== (lspRecRealCount next) want)
                  (- 0 1)
                  (- 0 2)))
            ))
        })
    }))

;; How many of `toks` the document wrote. A token the repair adds has
;; an empty span and every token the lexer writes has a byte, so the
;; count falls exactly when a repair drops one.
(pub :: lspRecRealCount (-> Tokens Int))
(pub fn (lspRecRealCount toks)
  {
    (let mut c 0)
    {
      (for i in 0..(vecLen toks)
        {
          (let sp (tokenSpan (vecGet toks i)))
          (if (> (spanEnd sp) (spanStart sp))
            (set c (+ c 1)))
        })
      c
    }
  })

;; The token the parser stopped at, as an index of a real token: the
;; EOF token, and any position past it, is read as the last real one.
(pub :: lspRecErrAt (-> Tokens Int Int))
(pub fn (lspRecErrAt toks e)
  {
    (let last (- (vecLen toks) 2))
    (if (< last 0)
      0
      (if (> e last)
        last
        (if (< e 0)
          0
          e)))
  })

;; Whether `tried` records action `a` at span start `s`, recording it
;; when it does not. Each action is taken once at each place, which is
;; what makes the repair end.
(pub :: lspRecTry (-> Ints Int Int Bool))
(pub fn (lspRecTry tried a s)
  {
    (let mut i 0)
    (let mut hit false)
    {
      (while (if (< (+ i 1) (vecLen tried))
        (! hit)
        false)
        {
          (if (&& (== (vecGet tried i) a) (== (vecGet tried (+ i 1)) s))
            (set hit true))
          (set i (+ i 2))
        })
      (if (! hit)
        {
          (vecPush tried a)
          (vecPush tried s)
        })
      (! hit)
    }
  })

;; The next repair of `toks` at the token `e` the parser stopped at, as
;; a new token vector, or an empty one when nothing is left to try.
;;
;; At a closer the parser wanted something before it, so a `()` goes
;; there. At an atom, the atom goes. Otherwise the innermost form
;; around `e` becomes `()`; a `()` the parser refuses goes; and a form
;; already replaced passes the question to the form around it. The
;; form's own outer brackets are never replaced: that would leave
;; nothing to declare.
(pub :: lspRepairEdit (-> Tokens Int Ints Tokens))
(pub fn (lspRepairEdit toks e tried)
  {
    (let t (vecGet toks e))
    (let s (spanStart (tokenSpan (vecGet toks e))))
    (if (if (> (lspRecCloser t) 0)
      (lspRecTry tried 1 s)
      false)
      (lspRecWithHole toks e e s s)
      (if (if (== (lspRecOpener t) 0)
        (if (== (lspRecCloser t) 0)
          (lspRecTry tried 2 s)
          false)
        false)
        (lspRecWithout toks e e)
        (lspRepairWiden toks (lspRecGroupOf toks e) tried)))
  })

;; Replace the form opening at `a`, or the one around it when that has
;; been tried, with `()`; drop a `()` the parser refused.
(pub :: lspRepairWiden (-> Tokens (Option Int) Ints Tokens))
(pub fn (lspRepairWiden toks a tried)
  (match a
    ((None) vecNew)
    ((Some a)
      (if (<= a 0)
        vecNew
        {
          (let b (lspRecMatch toks a))
          (let sa (spanStart (tokenSpan (vecGet toks a))))
          (if (lspRecTry tried 3 sa)
            (lspRecWithHole toks a (+ b 1) sa (spanStart (tokenSpan (vecGet toks b))))
            (if (if (== b (+ a 1))
              (lspRecTry tried 4 sa)
              false)
              (lspRecWithout toks a b)
              (lspRepairWiden toks (lspRecEnclosing toks a) tried)))
        })
    )))

;; The opener of the form a repair at `e` works on: `e` itself when it
;; opens one, the opener a closer matches, or the innermost opener
;; around anything else.
(pub :: lspRecGroupOf (-> Tokens Int (Option Int)))
(pub fn (lspRecGroupOf toks e)
  (if (|| (< e 0) (>= e (vecLen toks)))
    None
    (if (> (lspRecOpener (vecGet toks e)) 0)
      (Some e)
      (if (> (lspRecCloser (vecGet toks e)) 0)
        (Some (lspRecMatchBack toks e))
        (lspRecEnclosing toks e)))))

;; The index of the closer matching the opener at `a`.
(pub :: lspRecMatch (-> Tokens Int Int))
(pub fn (lspRecMatch toks a)
  {
    (let mut i (+ a 1))
    (let mut depth 1)
    (let mut at (- (vecLen toks) 2))
    {
      (while (if (< i (vecLen toks))
        (> depth 0)
        false)
        {
          (let t (vecGet toks i))
          {
            (if (> (lspRecOpener t) 0)
              (set depth (+ depth 1)))
            (if (> (lspRecCloser t) 0)
              {
                (set depth (- depth 1))
                (if (== depth 0)
                  (set at i))
              })
            (set i (+ i 1))
          }
        })
      at
    }
  })

;; The index of the opener matching the closer at `b`.
(pub :: lspRecMatchBack (-> Tokens Int Int))
(pub fn (lspRecMatchBack toks b)
  {
    (let mut i (- b 1))
    (let mut depth 1)
    (let mut at 0)
    {
      (while (if (>= i 0)
        (> depth 0)
        false)
        {
          (let t (vecGet toks i))
          {
            (if (> (lspRecCloser t) 0)
              (set depth (+ depth 1)))
            (if (> (lspRecOpener t) 0)
              {
                (set depth (- depth 1))
                (if (== depth 0)
                  (set at i))
              })
            (set i (- i 1))
          }
        })
      at
    }
  })

;; The index of the innermost opener whose form holds index `e`, or -1.
(pub :: lspRecEnclosing (-> Tokens Int (Option Int)))
(pub fn (lspRecEnclosing toks e)
  (if (|| (< e 0) (> e (vecLen toks)))
    None
    {
      (let mut i (- e 1))
      (let mut depth 0)
      (let mut at (:: None (Option Int)))
      {
        (while (if (>= i 0)
          (isNone at)
          false)
          {
            (let t (vecGet toks i))
            {
              (if (> (lspRecCloser t) 0)
                (set depth (+ depth 1)))
              (if (> (lspRecOpener t) 0)
                (if (== depth 0)
                  (set at (Some i))
                  (set depth (- depth 1))))
              (set i (- i 1))
            }
          })
        at
      }
    }))

;; `toks` with indices `[a, b)` replaced by `()`, the opener spanning
;; from `sa` and the closer from `sb`, each empty.
(pub :: lspRecWithHole (-> Tokens Int Int Int Int Tokens))
(pub fn (lspRecWithHole toks a b sa sb)
  {
    (let out vecNew)
    {
      (for i in 0..a
        (vecPush out (vecGet toks i)))
      (vecPush out (mkToken TK_LPAREN "(" (mkSpan sa sa)))
      (vecPush out (mkToken TK_RPAREN ")" (mkSpan sb sb)))
      (for i in b..(vecLen toks)
        (vecPush out (vecGet toks i)))
      out
    }
  })

;; `toks` without indices `[a, b]`.
(pub :: lspRecWithout (-> Tokens Int Int Tokens))
(pub fn (lspRecWithout toks a b)
  {
    (let out vecNew)
    {
      (for i in 0..(vecLen toks)
        (if (|| (< i a) (> i b))
          (vecPush out (vecGet toks i))))
      out
    }
  })

; ------------------------------------------------------------------
; Document symbols
;
; Every top-level declaration node carries its NAME's span in word 4 -
; `mkDFnAt` and its siblings put it there precisely because a
; diagnostic about a declaration points at its name - so the outline
; comes straight off the parse tree without the checker running. That
; matters for an editor: a file with a type error still has an outline,
; and a file that does not parse simply has none.
;
; A `(:: f T)` signature is deliberately NOT listed. It shares its name
; with the `(fn (f) ...)` beside it, and an outline that shows every
; name twice is worse than one that shows it once.
;
; `range` IS THE WHOLE FORM and `selectionRange` is the name inside it.
; `lspFormStart` and `lspFormEnd` recover the extent from the BYTES, as
; hover does when it quotes a declaration. An editor uses `range` for
; the breadcrumb it highlights, for sticky scroll, and for "expand
; selection to the enclosing symbol", and a range as wide as the name
; makes all three useless - while still satisfying the protocol's
; containment requirement, which a range equal to `selectionRange`
; meets by identity.
;
; AND THE OUTLINE NESTS. A `data`'s constructors and a `struct`'s
; fields are children, as `workspace/symbol` lists constructors at
; their own spans, so the two views of one file agree. Both live in
; slot b
; (`mkDDataAt` and `mkDStructAt` put them there) and both carry their
; name's span from the parser, so this needs nothing the frontend does
; not already record.
;
; THE FALLBACK IS THE NAME SPAN, AND IT TAKES THE CHILDREN WITH IT.
; `lspFormStart`'s rule is COLUMN ZERO, and a document mid-edit that
; indents a declaration falls back to the nearest opener - which for a
; `fn` is its parameter list, a form that does NOT contain the
; declaration's name span. Publishing that as `range` would put a
; parent's range inside its own child's, which the protocol forbids and
; a client renders as a scrambled tree. So the extent is CHECKED to
; contain the name before it is used, and when it does not this answers
; the name span, with no children.
; ------------------------------------------------------------------
; LSP SymbolKind. Function 12, Enum 10, Struct 23, Class 5 for a
; `type` alias: the protocol has no kind for one, and a macro is a
; Function for the same reason - `lspComplKind` collapses it the same
; way for completion.
(pub :: lspSymKind (-> Int Int))
(pub fn (lspSymKind tag)
  (if (== tag TAG_D_DATA)
    10
    (if (== tag TAG_D_STRUCT)
      23
      (if (== tag TAG_D_ALIAS)
        5
        12))))

(pub :: lspWantsSymbol (-> Int Bool))
(pub fn (lspWantsSymbol tag)
  (|| (== tag TAG_D_FN)
    (|| (== tag TAG_D_DATA)
      (|| (== tag TAG_D_STRUCT) (|| (== tag TAG_D_MACRO) (== tag TAG_D_ALIAS))))))

; LSP SymbolKind for what a declaration holds INSIDE it: EnumMember 22
; for a `data`'s constructors - the kind `workspace/symbol` already
; publishes them under - and Field 8 for a `struct`'s fields. 0 for a
; declaration with no members to list, which is a `fn` (slot b is its
; parameter NAMES, strings rather than nodes) and a macro.
(pub :: lspMemberKind (-> Int Int))
(pub fn (lspMemberKind tag)
  (if (== tag TAG_D_DATA)
    22
    (if (== tag TAG_D_STRUCT)
      8
      0)))

; The whole top-level form a declaration's name sits in, or 0 when the
; recovered extent does not contain that name - see the header. 0 is
; the caller's signal to answer the name span and publish no children.
(pub :: lspSymbolExtent (-> String Int Int))
(pub fn (lspSymbolExtent src nameSpan)
  ; TWO CONDITIONS, and each rules out a different wrong answer
  ; from the same fallback. `lspFormStart`'s rule is COLUMN ZERO
  ; and it falls back to the nearest opener when nothing is there,
  ; so for an INDENTED declaration it answers one of two things.
  ; The PRECEDING top-level form, when the document has one: a
  ; range that ends before this declaration begins, which the
  ; containment test refuses. Or, when it does not, the nearest
  ; `(` - and for a `fn` that is its own PARAMETER LIST, the trap
  ; `lspFormStart`'s header spells out, which contains the name and
  ; would pass containment on its own. `lspHeaderOpen` answers
  ; exactly that paren, so the extent is refused when the two are
  ; the same byte.
  ;
  ; An indented `data` or `struct` keeps its extent under both
  ; tests, and should: its name is not inside a parameter list, so
  ; the nearest opener IS its own form. The guard is aimed at the
  ; one shape that goes wrong, not at indentation.
  {
    (let o (lspFormStart src (spanStart nameSpan)))
    {
      (let e (lspFormEnd src o))
      (if (&&
            (match (lspHeaderOpen src (spanStart nameSpan))
              ((None) true)
              ((Some header) (!= o header)))
            (&& (<= o (spanStart nameSpan)) (<= (spanEnd nameSpan) e)))
        (mkSpan o e)
        0)
    }
  })

; One DocumentSymbol. `children` is omitted rather than sent empty:
; a client draws an expander arrow for `children: []` and gives the
; reader an empty drawer to open.
(pub :: lspSymbolJson (-> String Ints ASTNode Int))
(pub fn (lspSymbolJson src ix d)
  {
    (let form (lspSymbolExtent src (nodeSpan d)))
    {
      (let base
        (jsonObjPut
          (jsonObjPut
            (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (nodeAName d))) "kind"
              (jsonNum (lspSymKind (nodeTag d))))
            "range"
            (lspRangeIx src ix
              (if (== form 0)
                (nodeSpan d)
                form)))
          "selectionRange" (lspRangeIx src ix (nodeSpan d))))
      (if (== form 0)
        base
        {
          (let kids (lspSymbolChildren src ix d))
          (if (== (jsonArrLen kids) 0)
            base
            (jsonObjPut base "children" kids))
        })
    }
  })

; The members, in the order they are written. Each is its own name and
; nothing more: a constructor node's span is its name's, and widening
; it to `(Circle Int)` would mean a second extent rule for a form that
; is not at column zero. Contained in the parent's form either way,
; which is what the protocol asks and what the gate now requires
; STRICTLY of every parent that has children.
(pub :: lspSymbolChildren (-> String Ints ASTNode Int))
(pub fn (lspSymbolChildren src ix d)
  {
    (let out jsonArr)
    (let kind (lspMemberKind (nodeTag d)))
    (if (== kind 0)
      out
      {
        (let ms (nodeBChildren d))
        {
          (for m in ms
            (if (!= (nodeSpan m) 0)
              (jsonArrPush out
                (jsonObjPut
                  (jsonObjPut
                    (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (nodeAName m))) "kind"
                      (jsonNum kind))
                    "range" (lspRangeIx src ix (nodeSpan m)))
                  "selectionRange" (lspRangeIx src ix (nodeSpan m))))))
          out
        }
      })
  })

; ------------------------------------------------------------------
; Navigation: a macro invocation is a REFERENCE to its declaration
; (MAC-TOOL-2).
;
; Both requests read the RAW parse tree and expand NOTHING, which is
; MAC-TOOL-3's rule: expansion is bounded but not free (41.4 s on a
; measured fan-out probe), and neither question needs it - the macro's
; declaration is in the document's own text, and hover shows what is
; written there rather than what it produces.
;
; The identifier under a position, by the lexer's own rule for what an
; identifier byte is, so `deriveEq` and `+` and `syntax/join` all
; answer the same way the compiler would read them.
(pub :: lspWordSpan (-> String Int Int))
(pub fn (lspWordSpan src off)
  {
    (let n (strLen src))
    (if (if (>= off n)
      true
      (if (isIdentChar (strByte src off))
        false
        true))
      0
      {
        (let mut s off)
        (let mut e off)
        {
          (while (if (> s 0)
            (isIdentChar (strByte src (- s 1)))
            false)
            (set s (- s 1)))
          (while (if (< e n)
            (isIdentChar (strByte src e))
            false)
            (set e (+ e 1)))
          (mkSpan s e)
        }
      })
  })

; The same word as text. Written over the span rather than beside it,
; because two walks of the same rule are two chances to disagree about
; what an identifier byte is.
(pub :: lspWordAt (-> String Int String))
(pub fn (lspWordAt src off)
  {
    (let sp (lspWordSpan src off))
    (if (== sp 0)
      ""
      (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))
  })

; The byte offset a `{line, character}` names. The inverse of `lspPos`,
; and the same UTF-16 rule read backwards: `character` counts code
; UNITS, so a surrogate pair costs two and every other code point one.
(pub :: lspOffsetOf (-> String Ints Int Int))
(pub fn (lspOffsetOf src ix pos)
  {
    (let ln (jsonGetInt pos "line"))
    (let ch (jsonGetInt pos "character"))
    (if (|| (< ln 0) (>= ln (vecLen ix)))
      (strLen src)
      {
        (let start (vecGet ix ln))
        (let n (strLen src))
        {
          (let mut i start)
          (let mut u 0)
          {
            (while (if (< i n)
              (if (< u ch)
                (&& (!= (strByte src i) 10) (!= (strByte src i) 13))
                false)
              false)
              (if (let (Some cp) (utf8DecodeAt src i))
                {
                  (set u (+ u
                           (if (>= cp 65536)
                             2
                             1)))
                  (set i (+ i (utf8SeqLen (strByte src i))))
                }
                {
                  (set u (+ u 1))
                  (set i (+ i 1))
                }))
            i
          }
        }
      })
  })

; The declaration this document makes under `name`, or 0, over every
; declaration KIND the outline already lists - a function, a `data`, a
; `struct` or a macro.
;
; `lspWantsSymbol` is reused deliberately: `documentSymbol` and
; `definition` answering different sets of names is the drift this
; repository reports most often, and there is no reason for a name the
; outline shows to be a name navigation cannot reach.
;
; A `(:: f T)` signature is still not a target, for the reason it is
; not in the outline: it shares its name with the `(fn (f) ...)` beside
; it, and jumping to the signature when the body is one line below is
; the wrong of the two answers.
;
; LAST WINS, which is `MAC-LANG-11`'s rule for macros and worth keeping
; for the rest: a file that declares a name twice is already
; ill-formed, and the last one is what the expander would have used.
(pub :: lspFindDecl (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindDecl decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (lspWantsSymbol (nodeTag d)) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        (Some d)
        (lspFindDecl decls name (- i 1)))
    }))

; The same, over the MERGED declaration list `resolveImports` answers -
; so a name this document imported is found in the module that declares
; it.
;
; Two differences from the walk above, and both are about what an
; imported declaration looks like. Its name is MANGLED (`Vec$vecPush`),
; so the comparison is against `bareOf`; and it is not in this
; document, so a declaration whose module is 0 - the entry file - is
; skipped here, having already been offered by `lspFindDecl`.
(pub :: lspFindImported (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindImported decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (lspWantsSymbol (nodeTag d))
            (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        (Some d)
        (lspFindImported decls name (- i 1)))
    }))

; The unit a declaration's spans index, by module name.
;
; `symbols.ax` has `saUnitOf`, which is this, and it is not imported
; here: `lsp.ax` reaches for `parser`, `typecheck`, `expand` and
; `codegen` and not for the symbol renderer, and a module dependency
; taken for fifteen lines is a dependency the next reader has to
; explain. Answers None when no unit carries that name, which is what a
; declaration the resolver did not attribute looks like.
(pub :: lspUnitOf (-> Units (Option String) (Option Int)))
;@axiom:effect(alloc)
(pub fn (lspUnitOf units module)
  ; Imported units begin at 1. The entry file carries None, and the
  ; shared name predicate handles both unnamed and named units.
  (match module
    ((None) None)
    ((Some name) (lspUnitNamed units name))))

; `/a/b.ax` -> `file:///a/b.ax`, the inverse of `lspUriToPath`.
;
; PERCENT-ENCODING is the whole of it. A path may hold a space, a `%`,
; a `#` or any non-ASCII byte, and an editor asked to open
; `file:///Some Project/a.ax` opens nothing at all - silently, because
; a Location it cannot parse is a Location it ignores. The unreserved
; set is RFC 3986's, plus `/` because it separates the path, plus `.`,
; `-`, `_` and `~`.
;
; A RELATIVE path is made absolute first, against the working
; directory, because `moduleSrcPath` answers `Helper.ax` for a sibling
; module and a Location must name a file the editor can open from
; anywhere.
;
; The path is also cleaned: the standard library is found beside the
; compiler as `.../.axiom-bin/../stdlib/Str.ax`, and an editor that
; already has `.../stdlib/Str.ax` open would otherwise open the same
; file a second time under the longer name.
(pub :: lspPathToUri (-> String String))
;@axiom:effect(io)
(pub fn (lspPathToUri path)
  ; An unavailable working directory joins as `""`. A language
  ; server that refused to name a document because `getcwd` failed
  ; would be worse than one that names it relatively.
  {
    (let abs
      (pathClean
        (if (pathIsAbsolute path)
          path
          (pathJoin (unwrapOr cwd "") path))))
    {
      (let n (strLen abs))
      (let out (strBuilderNew))
      {
        (strBuilderPush out "file://")
        (for i in 0..n
          (if (lspUriSafe (strByte abs i))
            (strBuilderPushByte out (strByte abs i))
            (strBuilderPush out (lspPercent (strByte abs i)))))
        (strBuilderFinish out)
      }
    }
  })

(pub :: lspUriSafe (-> Int Bool))
(pub fn (lspUriSafe b)
  (|| (&& (>= b 97) (<= b 122))
    (|| (&& (>= b 65) (<= b 90))
      (|| (&& (>= b 48) (<= b 57))
        (|| (== b 47) (|| (== b 46) (|| (== b 45) (|| (== b 95) (== b 126)))))))))

(pub :: lspPercent (-> Int String))
(pub fn (lspPercent b)
  (concat "%" (concat (lspHexDigit (/ b 16)) (lspHexDigit (% b 16)))))

(pub :: lspHexDigit (-> Int String))
(pub fn (lspHexDigit v)
  (strSlice "0123456789ABCDEF" v 1))

; ------------------------------------------------------------------
; The import preamble, once.
;
; Every request that reaches into an imported module needs the same
; nine lines - the four scratch vectors, the entry unit carrying the
; document's REAL text (a unit whose source is empty reports every span
; at offset 0), the preflight, the resolver. Every copy of a preamble
; that must agree with `lspCheckDoc` about which files a document
; imports is a place for it to stop agreeing, so it is stated here
; once.
;
; Answers `None` when the preflight found a module it could not read -
; the half-typed-import case, which every caller answers as "this
; document alone" rather than as an error - and otherwise the merged
; declaration list, the unit table, `bares`, `fulls` and `mods` - the
; last three for the one caller that goes on to expand, since
; `expandProgram` takes the resolver's tables.
;
; A resolver failure is silent by design: a half-typed import is the
; normal state of a file being edited, and a request that answered an
; error while the user was mid-word would make navigation feel broken
; exactly when the file is.
; ------------------------------------------------------------------
; What a successful resolution answers: the merged declarations, the
; unit table, and the resolver's name maps and module filters.
(pub struct LspResolved
  (decls : Nodes)
  (units : Units)
  (bares : Names)
  (fulls : Names)
  (mods : ModuleImports))

(pub :: lspResolveFor (-> LspWorkspace String String (Vec ASTNode) (Option LspResolved)))
;@axiom:effect(io)
(pub fn (lspResolveFor workspace path src decls)
  {
    (let bares vecNew)
    (let fulls vecNew)
    (let mods vecNew)
    (let tcode (checkedTargetCode hostTarget))
    (let entryDir (pathDir path))
    {
      (let units
        {
          (let v vecNew)
          {
            (vecPush v
              (CUnit2 :file path :src src :name None :imports vecNew :library (pathInStdlib path)))
            v
          }
        })
      {
        (let failure (lspWorkspacePreflight workspace decls tcode entryDir units 0))
        (if (isSome failure)
          None
          (Some
            (LspResolved
              :decls (resolveImports decls bares fulls mods tcode entryDir units)
              :units units
              :bares bares
              :fulls fulls
              :mods mods)))
      }
    }
  })

; `textDocument/definition`: the declaration's own span, as a Location.
;
; TWO LOOKUPS, IN THIS ORDER, and the order is the language's scoping
; rule rather than a preference: a module's own declaration shadows an
; imported one, so this document is asked first and the merged list
; only when it has no answer.
;
;   1. THIS DOCUMENT, over every declaration kind the outline lists -
;      a function, a `data`, a `struct` or a macro - so a call to a
;      function three lines up answers it rather than null, which an
;      editor reads as "there is nothing here".
;   2. EVERY IMPORTED MODULE, by resolving the imports the way
;      `lspCheckDoc` does and searching the merged list. An imported
;      declaration's name is mangled (`Vec$vecPush`) and its spans
;      index its OWN file, so the answer is a Location in that file:
;      the unit table `resolveImports` filled says which, and
;      `lspPathToUri` spells it.
;
; WHAT THE SECOND ONE COSTS, said out loud because `MAC-TOOL-3` is
; about exactly this: it reads and parses every transitively imported
; module, which is what `axiom check` does on every keystroke already
; through `lspCheckDoc`. It runs only when the first lookup misses, so
; a definition request inside the file being edited pays one parse, and
; nothing here expands a macro - the raw tree carries every declaration
; either lookup needs.
;
; A position that is not a name still answers null, which is the
; protocol's way of saying "nothing here" and what an editor expects
; for every other word in the file.
(pub :: lspDefinition (-> LspWorkspace String String Int String Int))
;@axiom:effect(io)
(pub fn (lspDefinition workspace src uri params gen)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError6) jsonNull)
      ((ParseSuccess parsedValue6 parsedPos6)
        {
          (let decls parsedValue6)
          (let ix (lspLineIndex src))
          {
            (let off (lspOffsetOf src ix (jsonGet params "position")))
            {
              (let w (lspWordAt src off))
              (if (== (strLen w) 0)
                jsonNull
                ; A LOCAL BINDING FIRST - a `let`, a parameter, a
                ; pattern variable - because a local shadows a
                ; declaration of the same name, which is the
                ; language's rule and SECTION NAV's. 0 means the word
                ; is not one, and the two lookups below then answer
                ; exactly as they did before.
                {
                  (let loc (lspNavLocalDefinition src uri ix decls off))
                  (if (!= loc 0)
                    loc
                    {
                      (let d (lspFindDecl decls w (- (vecLen decls) 1)))
                      (if (let (Some d) d)
                        (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range"
                          (lspRange src (nodeSpan d)))
                        ; A CONSTRUCTOR THIS DOCUMENT DECLARES, before
                        ; any import is resolved. `lspFindDecl` matches
                        ; whole declarations and never looks inside a
                        ; `data`'s constructor list, which is the only
                        ; place `Circle` is written.
                        {
                          (let c (lspCtorDefinition src uri decls w))
                          (if (!= c 0)
                            c
                            ; A GENERATED NAME, last: the cache the
                            ; fill wrote at `didOpen`/`didChange`.
                            ; Firing here - after every raw-tree and
                            ; import lookup misses - is what keeps
                            ; every answer given before standing, and
                            ; reading a string is what keeps this arm
                            ; on MAC-TOOL-3's side of expansion.
                            {
                              (let imp
                                (lspDefinitionImported workspace (lspUriToPath uri) src decls w))
                              (if (jsonIsNull imp)
                                (lspGenDefinition gen uri src w)
                                imp)
                            })
                        })
                    })
                })
            }
          }
        }
      ))
  })

; The second lookup: resolve this document's imports through
; `lspResolveFor` - the same preamble `lspCheckDoc` runs, so the two
; cannot disagree about what this document imports - and answer a
; Location in whichever module declares `w`. A resolver failure is
; null rather than a diagnostic, for the reason `lspResolveFor` gives.
(pub :: lspDefinitionImported (-> LspWorkspace String String (Vec ASTNode) String Int))
;@axiom:effect(io)
(pub fn (lspDefinitionImported workspace path src decls w)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let d (lspFindImported allDecls w (- (vecLen allDecls) 1)))
        (if (let (Some d) d)
          {
            (let u (lspUnitOf units (nodeModuleOpt d)))
            (match u
              ((None) jsonNull)
              ((Some u)
                {
                  (let unit (vecGet units u))
                  (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr (lspPathToUri (unitFile unit))))
                    "range" (lspRange (unitSrc unit) (nodeSpan d)))
                }
              ))
          }
          (lspCtorDefinitionImported allDecls units w))
      }
    }
    jsonNull))

; `textDocument/hover`: what the declaration under the cursor says
; about itself, in the words the document uses.
;
; WHAT IT ANSWERS, and each part is left out when the document has not
; got it:
;
;   * a CODE FENCE holding the declaration. For a `fn` that is its
;     SIGNATURE - `(:: bump (-> Int Int))` - because a body is
;     arbitrarily long and "where is this written" is the question
;     `definition` answers; a `fn` with no signature falls back to its
;     own first line. For a macro, a `data` or a `struct` it is the
;     WHOLE form, which is the part a reader wants: the rules, the
;     constructors, the fields.
;   * the MODULE, when the name came from an import.
;   * the COMMENT BLOCK above the declaration, as prose.
;
; EVERY DECLARATION KIND ANSWERS, not macros alone: null reads to an
; editor as "there is nothing here" rather than as "this server does
; not do that". The lookup order is `lspDefinition`'s, for the reason
; it has it, which is the language's scoping rule. A module's own
; declaration shadows an imported one, so this document is asked first
; and the merged list only when it has no answer.
;
; `range` IS THE WORD, NOT THE DECLARATION. The protocol's range is the
; part of THIS document the tooltip covers, and the declaration's span
; would make an editor highlight a line three above the word being
; read - or, for an imported name, a span into a file the editor does
; not have open.
; ------------------------------------------------------------------
; Field hover: `base.field` uses and fields where they are declared.
;
; The word under the cursor is only the field, so both shapes resolve
; as paths. A use reads the base left of the dot - a parameter takes
; its struct from the owning signature (`nthParamTy`, the same reading
; parameter hover already shows), a `let` from the constructor
; application its value builds - and answers the field off the
; struct's declaration. A declaration is found by span: the word sits
; in a struct's field slot. Either way the fence quotes the whole
; struct, the way a constructor hover quotes the whole `data`, with
; one line naming the field; the range stays the word.
;
; What is NOT answered: a base no local binds, a base whose struct is
; unknown at parse level (a lambda parameter, a call result, a name
; from another module), a field no struct declares, and a `data`
; payload, which is not a field. Each answers null rather than a
; guess, and an unresolvable `base.field` falls through to the
; ordinary word lookup rather than answering null outright.
; ------------------------------------------------------------------
(pub :: lspIsUpperStart (-> String Int))
(pub fn (lspIsUpperStart s)
  (if (== (strLen s) 0)
    0
    {
      (let b (strByte s 0))
      (if (< b 65)
        0
        (if (> b 90)
          0
          1))
    }))

; Left over identifier bytes from `off` (exclusive): the start of the
; run ending just before `off`.
(pub :: lspIdentStart (-> String Int Int))
(pub fn (lspIdentStart src off)
  {
    (let mut s off)
    {
      (while (if (> s 0)
        (isIdentChar (strByte src (- s 1)))
        false)
        (set s (- s 1)))
      s
    }
  })

; The leftmost head of a spine: through applications to the callee.
(pub :: lspSpineHead (-> ASTNode (Option ASTNode)))
(pub fn (lspSpineHead v)
  (if (nodeSame v nilNode)
    None
    (if (!= (nodeTag v) TAG_E_APP)
      (Some v)
      (lspSpineHead (nodeAChild v)))))

; The struct declaration named `sname` that declares a field named
; `fname`, or None.
(pub :: lspFindStructField (-> (Vec ASTNode) String String (Option ASTNode)))
(pub fn (lspFindStructField decls sname fname)
  {
    (let d (lspFindTypeDecl decls sname (- (vecLen decls) 1)))
    (if (let (Some d) d)
      (if (!= (nodeTag d) TAG_D_STRUCT)
        None
        (if (isSome (lspStructFieldNode (nodeBChildren d) fname 0))
          (Some d)
          None))
      None)
  })

(pub :: lspStructFieldNode (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspStructFieldNode fs fname i)
  (if (>= i (vecLen fs))
    None
    {
      (let f (vecGet fs i))
      (if (strEq (nodeAName f) fname)
        (Some f)
        (lspStructFieldNode fs fname (+ i 1)))
    }))

; The struct behind a parameter: the `k`th arrow domain of the
; owner's signature, when it names a bare constructor type.
(pub :: lspFieldParamStruct (-> (Vec ASTNode) String String Int (Option String)))
(pub fn (lspFieldParamStruct decls owner name k)
  {
    (let sig (lspFindSig decls owner (- (vecLen decls) 1)))
    (if (let (Some sig) sig)
      (if (let (Some t) (nthParamTy (nodeTyChild sig) k))
        (if (== (nodeTag t) TAG_T_CON)
          {
            (let n (bareOf (nodeAName t)))
            (if (== (lspIsUpperStart n) 1)
              (Some n)
              None)
          }
          None)
        None)
      None)
  })

; The struct behind a `let`: the constructor application the value
; builds, when its head is an upcased name.
(pub :: lspFieldValueStruct (-> (Option ASTNode) (Option String)))
(pub fn (lspFieldValueStruct v)
  (if (let (Some v) v)
    {
      (let h (lspSpineHead v))
      (if (let (Some h) h)
        (if (!= (nodeTag h) TAG_E_VAR)
          None
          {
            (let n (nodeAName h))
            (if (== (lspIsUpperStart n) 1)
              (Some n)
              None)
          })
        None)
    }
    None))

; The struct behind a base name at an offset: a parameter's declared
; type, or a let's built value. None means the struct is unknown.
(pub :: lspFieldBaseStruct (-> String (Vec ASTNode) String Int (Option String)))
(pub fn (lspFieldBaseStruct src decls base baseOff)
  {
    (let occs (lspNavOccurrences src decls))
    (if (let (Some o) (lspNavAt occs baseOff))
      {
        (let key o.key)
        (if (lspNavIsLocal key)
          (match (lspNavBinderOf occs key)
            ((None) None)
            ((Some b)
              {
                (let bkind b.bkind)
                (if (== bkind NAV_B_PARAM)
                  (lspFieldParamStruct decls b.owner b.name b.param)
                  (if (== bkind NAV_B_LET)
                    (lspFieldValueStruct b.value)
                    None))
              }
            ))
          None)
      }
      None)
  })

; A field use: `base.` ends where the word begins.
(pub :: lspHoverFieldUse (-> String (Vec ASTNode) String Int Int Int Int))
(pub fn (lspHoverFieldUse src decls base baseOff wsp range)
  {
    (let w (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp))))
    (if (let (Some sn) (lspFieldBaseStruct src decls base baseOff))
      {
        (let d (lspFindStructField decls sn w))
        (if (let (Some d) d)
          (lspHoverAtNote src decls d range None
            (concat
              (concat (concat (concat "field `" w) "` of `struct ") (concat (nodeAName d) "`"))
              (lspFieldEffectsSaid (lspStructFieldNode (nodeBChildren d) w 0))))
          0)
      }
      0)
  })

; A field declaration: the word sits in a struct's field slot.
(pub :: lspHoverFieldDecl (-> String (Vec ASTNode) Int Int Int))
(pub fn (lspHoverFieldDecl src decls wsp range)
  {
    (let w (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp))))
    (lspHoverFieldDeclIn decls src w (spanStart wsp) range (- (vecLen decls) 1))
  })

(pub :: lspHoverFieldDeclIn (-> (Vec ASTNode) String String Int Int Int Int))
(pub fn (lspHoverFieldDeclIn decls src w off range i)
  (if (< i 0)
    0
    {
      (let d (vecGet decls i))
      (if (!= (nodeTag d) TAG_D_STRUCT)
        (lspHoverFieldDeclIn decls src w off range (- i 1))
        (if (isNone (lspFieldNodeAt (nodeBChildren d) w off 0))
          (lspHoverFieldDeclIn decls src w off range (- i 1))
          (lspHoverAtNote src decls d range None
            (concat
              (concat (concat (concat "field `" w) "` of `struct ") (concat (nodeAName d) "`"))
              (lspFieldEffectsSaid (lspFieldNodeAt (nodeBChildren d) w off 0))))))
    }))

; What a field's `;@axiom:effect(...)` lines declare, as the hover
; note's tail: ", declared `effect(pure)`", or "" for a field that
; declares nothing. The checker answers whether the declaration holds.
(pub :: lspFieldEffectsSaid (-> (Option ASTNode) String))
(pub fn (lspFieldEffectsSaid f)
  (match f
    ((None) "")
    ((Some f)
      (match (nodeAxtagsOpt f)
        ((None) "")
        ((Some tags)
          {
            (let mut said "")
            (for t in tags
              {
                (let text t.content)
                (if (strStartsWith text "effect(")
                  (set said (if (strEq said "")
                    (concat (concat "`" text) "`")
                    (concat (concat (concat said " and `") text) "`"))))
              })
            (if (strEq said "")
              ""
              (concat ", declared " said))
          }
        ))
    )))

(pub :: lspFieldNodeAt (-> (Vec ASTNode) String Int Int (Option ASTNode)))
(pub fn (lspFieldNodeAt fs fname off i)
  (if (>= i (vecLen fs))
    None
    {
      (let f (vecGet fs i))
      (if (&& (strEq (nodeAName f) fname) (lspSpanHas (nodeSpan f) off))
        (Some f)
        (lspFieldNodeAt fs fname off (+ i 1)))
    }))

(pub :: lspHoverField (-> String (Vec ASTNode) Int Int Int))
(pub fn (lspHoverField src decls wsp range)
  {
    (let fs (spanStart wsp))
    (if (&& (!= fs 0) (== (strByte src (- fs 1)) 46))
      {
        (let bs (lspIdentStart src (- fs 1)))
        (if (== bs (- fs 1))
          0
          (lspHoverFieldUse src decls (strSlice src bs (- (- fs 1) bs)) bs wsp range))
      }
      (lspHoverFieldDecl src decls wsp range))
  })

; ------------------------------------------------------------------
; Hover for the language itself
;
; A word no declaration explains still means something: `let`, `Int`,
; `IO`, `+`, the `::` of a signature, the key and the values of an
; AXTAG line, the module an `import` names. Rather than null, which an
; editor shows as "nothing here", they answer from
; `core/lexicon.ax`, after every declaration lookup has missed,
; so a declaration that happens to share a spelling with a keyword
; still wins. An AXTAG line is asked FIRST, because the words
; on it (`effect`, `io`, `no-alloc`) are not names in the program.
; ------------------------------------------------------------------
(pub :: lspMarkdownHover (-> String Int Int))
(pub fn (lspMarkdownHover value range)
  (jsonObjPut
    (jsonObjPut jsonObj "contents"
      (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value" (jsonStr value)))
    "range" range))

; A lexicon word: keyword, form word, builtin type, effect, operator
; or literal. Null when the lexicon has no entry.
(pub :: lspLexHover (-> String Int Int))
(pub fn (lspLexHover w range)
  {
    (let md (lexEntryMarkdown w))
    (if (== (strLen md) 0)
      jsonNull
      (lspMarkdownHover md range))
  })

; The start of the line holding byte `off`.
(pub :: lspLineStartAt (-> String Int Int))
(pub fn (lspLineStartAt src off)
  {
    (let mut i off)
    {
      (while (if (> i 0)
        (!= (strByte src (- i 1)) 10)
        false)
        (set i (- i 1)))
      i
    }
  })

(pub :: lspPunctPairAt (-> String Int Int Bool))
(pub fn (lspPunctPairAt src at n)
  (if (>= (+ at 1) n)
    false
    {
      (let a (strByte src at))
      (let b (strByte src (+ at 1)))
      (if (&& (== a 58) (== b 58))
        true
        (if (&& (== a 45) (== b 62))
          true
          (&& (== a 46) (== b 46))))
    }))

; A punctuation token at the cursor - `::`, `->`, `..` or the postfix
; `?` - as a span, or 0. The cursor may sit on either byte of a pair.
(pub :: lspPunctSpan (-> String Int Int))
(pub fn (lspPunctSpan src off)
  {
    (let n (strLen src))
    (if (lspPunctPairAt src off n)
      (mkSpan off (+ off 2))
      (if (if (> off 0)
        (lspPunctPairAt src (- off 1) n)
        false)
        (mkSpan (- off 1) (+ off 1))
        ; `?`, the one-byte postfix that propagates an error
        (if (if (< off n)
          (== (strByte src off) 63)
          false)
          (mkSpan off (+ off 1))
          0)))
  })

; Past the key of an AXTAG: the bytes up to its `(` or the end of the
; line, with trailing blanks left out.
(pub :: lspTagKeyEnd (-> String Int Int))
(pub fn (lspTagKeyEnd line i)
  {
    (let n (strLen line))
    (let mut k i)
    {
      (while (if (< k n)
        (if (== (strByte line k) 40)
          false
          (if (docIsBlank (strByte line k))
            false
            true))
        false)
        (set k (+ k 1)))
      k
    }
  })

(pub :: lspTagHoverKey (-> String String Int Int))
(pub fn (lspTagHoverKey key v range)
  {
    (let md (lexTagMarkdown key v))
    (if (== (strLen md) 0)
      jsonNull
      (lspMarkdownHover md range))
  })

; The AXTAG line under the cursor, or null when the line is not one.
; On the key, the key's entry with the key as the range; on a value
; the lexicon knows (`io`, `no-alloc`, `irq`), the key and value
; together; anywhere else on the line, the key's entry over the whole
; tag.
(pub :: lspTagHover (-> String Ints Int Int))
(pub fn (lspTagHover src ix off)
  {
    (let ls (lspLineStartAt src off))
    {
      (let e (docLineEndFrom src ls))
      {
        (let line (strSlice src ls (- e ls)))
        {
          (let b (docLineBody line))
          (if (strStartsWith (strSlice line b (- (strLen line) b)) ";@axiom:")
            {
              (let ks (+ b 8))
              (let ke (lspTagKeyEnd line (+ b 8)))
              {
                (let key (strSlice line ks (- ke ks)))
                (let col (- off ls))
                (if (&& (>= col ks) (<= col ke))
                  (lspTagHoverKey key "" (lspRangeIx src ix (mkSpan (+ ls ks) (+ ls ke))))
                  {
                    (let wsp (lspWordSpan src off))
                    {
                      (let w
                        (if (== wsp 0)
                          ""
                          (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp)))))
                      (if (if (== (strLen w) 0)
                        true
                        (== (strLen (lexTagValueDoc key w)) 0))
                        (lspTagHoverKey key "" (lspRangeIx src ix (mkSpan (+ ls b) e)))
                        (lspTagHoverKey key w (lspRangeIx src ix wsp)))
                    }
                  })
              }
            }
            jsonNull)
        }
      }
    }
  })

; The unit whose module is named `w`, or None. `lspUnitOf` asks the
; same of an optional module name; this asks the name a document spells,
; from unit 1 for `lspUnitOf`'s reason (unit 0 has no module name).
(pub :: lspUnitNamed (-> Units String (Option Int)))
(pub fn (lspUnitNamed units w)
  {
    (let mut i 1)
    (let mut at (:: None (Option Int)))
    {
      (while (< i (vecLen units))
        {
          (if (unitNameIs (vecGet units i) w)
            {
              (set at (Some i))
              (set i (vecLen units))
            })
          (set i (+ i 1))
        })
      at
    }
  })

; The module an `import` in this document names: its `;;!` block and
; its path, read through the same resolver `definition` uses. Null
; when `w` is not an imported module's name or the resolver has no
; unit for it.
(pub :: lspModuleHover (-> LspWorkspace String String (Vec ASTNode) String Int Int))
;@axiom:effect(io)
(pub fn (lspModuleHover workspace path src decls w range)
  (if (isNone (lspFixFindImport decls w (- (vecLen decls) 1)))
    jsonNull
    (if (let (Some r) (lspResolveFor workspace path src decls))
      {
        (let units r.units)
        {
          (let u (lspUnitNamed units w))
          (match u
            ((None) jsonNull)
            ((Some u)
              {
                (let unit (vecGet units u))
                {
                  (let doc (docModuleDoc (unitSrc unit)))
                  (lspMarkdownHover
                    (concat (concat (concat "```axiom\n(import " w) ")\n```\n\n*module* `")
                      (concat (concat (unitFile unit) "`\n")
                        (if (== (strLen doc) 0)
                          ""
                          (concat "\n" doc))))
                    range)
                }
              }
            ))
        }
      }
      jsonNull)))

(pub :: lspHover (-> LspWorkspace String String Int String Int))
; A field path is resolved as a path first: the word under the
; cursor in `base.field` is only the field, and answering it as a
; top-level name (or nothing) would be the wrong question. When the
; path does not resolve, the word falls through to the ordinary
; lookup below rather than answering null outright.
;@axiom:effect(io)
(pub fn (lspHover workspace src uri params gen)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError7) jsonNull)
      ((ParseSuccess parsedValue7 parsedPos7)
        {
          (let decls parsedValue7)
          (let ix (lspLineIndex src))
          {
            (let off (lspOffsetOf src ix (jsonGet params "position")))
            {
              (let tag (lspTagHover src ix off))
              (if (isSome (lspAxqlLitAt src off))
                (lspAxqlHover src ix off)
                (if (jsonIsNull tag)
                  {
                    (let wsp (lspWordSpan src off))
                    (if (== wsp 0)
                      ; Not on a word: `::`, `->` and `..` still mean
                      ; something, and answer from the lexicon.
                      {
                        (let psp (lspPunctSpan src off))
                        (if (== psp 0)
                          jsonNull
                          (lspLexHover
                            (strSlice src (spanStart psp) (- (spanEnd psp) (spanStart psp)))
                            (lspRangeIx src ix psp)))
                      }
                      ; A local binding first, for the reason `definition`
                      ; asks it first: a local shadows a declaration of the
                      ; same name. 0 means the word is not one.
                      {
                        (let w (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp))))
                        (let range (lspRangeIx src ix wsp))
                        {
                          (let fld (lspHoverField src decls wsp range))
                          (if (!= fld 0)
                            fld
                            {
                              (let local (lspNavLocalHover src decls ix wsp))
                              (if (!= local 0)
                                local
                                {
                                  (let d (lspFindDecl decls w (- (vecLen decls) 1)))
                                  (if (let (Some d) d)
                                    (lspHoverAt src decls d range None)
                                    ; A CONSTRUCTOR is read at the `data` that
                                    ; declares it - the whole form, so its siblings
                                    ; and its field types are in the tooltip - with
                                    ; one line naming which of them is under the
                                    ; cursor. The `range` stays the WORD, which is
                                    ; what the rest of this function's header says.
                                    {
                                      (let dat (lspFindCtorData decls w (- (vecLen decls) 1)))
                                      (if (let (Some dat) dat)
                                        (if (isNone (lspCtorNodeOf (Some dat) w))
                                          ; A GENERATED NAME next, for `definition`'s
                                          ; reason: after every lookup misses, from
                                          ; the cache string, expanding nothing. Then
                                          ; the module an import names, then the
                                          ; language itself.
                                          {
                                            (let hov
                                              (lspHoverImported workspace (lspUriToPath uri) src
                                                decls w range))
                                            (if (jsonIsNull hov)
                                              {
                                                (let g (lspGenHover gen src w range))
                                                (if (jsonIsNull g)
                                                  {
                                                    (let m
                                                      (lspModuleHover workspace (lspUriToPath uri)
                                                        src decls w range))
                                                    (if (jsonIsNull m)
                                                      (lspLexHover w range)
                                                      m)
                                                  }
                                                  g)
                                              }
                                              hov)
                                          }
                                          (lspHoverAtNote src decls dat range None
                                            (lspCtorNote dat w)))
                                        ; A GENERATED NAME next, for `definition`'s
                                        ; reason: after every lookup misses, from
                                        ; the cache string, expanding nothing. Then
                                        ; the module an import names, then the
                                        ; language itself.
                                        {
                                          (let hov
                                            (lspHoverImported workspace (lspUriToPath uri) src
                                              decls w range))
                                          (if (jsonIsNull hov)
                                            {
                                              (let g (lspGenHover gen src w range))
                                              (if (jsonIsNull g)
                                                {
                                                  (let m
                                                    (lspModuleHover workspace (lspUriToPath uri)
                                                      src decls w range))
                                                  (if (jsonIsNull m)
                                                    (lspLexHover w range)
                                                    m)
                                                }
                                                g)
                                            }
                                            hov)
                                        })
                                    })
                                })
                            })
                        }
                      })
                  }
                  tag))
            }
          }
        }
      ))
  })

; The hover object for declaration `d`, whose spans index `dsrc` and
; whose signature - if it has one - is in `ddecls`. `range` names the
; word in the document being edited, which is a different document
; whenever `origin` is non-empty.
;
; A `fn` IS READ AT ITS SIGNATURE, not at itself, and that decides two
; answers at once. The fence gets the type rather than a body of
; unbounded length; and the comment block comes from above the `::`,
; which is where this language puts it - `(pub :: bump (-> Int Int))`
; sits between the paragraph and `(pub fn (bump x) ...)`, so a block
; read above the definition is the blank line, every time. A `fn` with
; no signature is read at itself, and then the fence is its first line:
; the header names the parameters, and the body is what `definition`
; is for.
(pub :: lspHoverAt (-> String (Vec ASTNode) ASTNode Int (Option String) Int))
(pub fn (lspHoverAt dsrc ddecls d range origin)
  (lspHoverAtNote dsrc ddecls d range origin ""))

; The same, plus one line of prose between the fence and the `from`
; line. It exists for the constructor hover: the fence quotes the
; whole `data`, which is the right thing to read, and without a note
; the tooltip would not say which of its constructors the cursor is
; actually on. "" is the ordinary case and costs nothing.
(pub :: lspHoverAtNote (-> String (Vec ASTNode) ASTNode Int (Option String) String Int))
(pub fn (lspHoverAtNote dsrc ddecls d range origin note)
  {
    (let sig
      (if (== (nodeTag d) TAG_D_FN)
        (lspFindSig ddecls (nodeAName d) (- (vecLen ddecls) 1))
        None))
    {
      (let at
        (if (let (Some sig) sig)
          sig
          d))
      {
        (let o (lspFormStart dsrc (spanStart (nodeSpan at))))
        {
          (let code
            (concat (contractSourceFor ddecls d) (lspClampLines (lspHoverCode dsrc d sig o) 40)))
          (let doc (lspDocComment dsrc o))
          {
            (let fence (concat (concat "```axiom\n" code) "\n```\n"))
            {
              (let body
                (if (== (strLen note) 0)
                  fence
                  (concat fence (concat (concat "\n" note) "\n"))))
              {
                (let withMod
                  (match origin
                    ((None) body)
                    ((Some name)
                      (if (== (strLen name) 0)
                        body
                        (concat body (concat (concat "\nfrom `" name) "`\n")))
                    )))
                {
                  (let value
                    (if (== (strLen doc) 0)
                      withMod
                      (concat withMod (concat "\n" doc))))
                  (jsonObjPut
                    (jsonObjPut jsonObj "contents"
                      (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value"
                        (jsonStr value)))
                    "range" range)
                }
              }
            }
          }
        }
      }
    }
  })

; The fenced half. Everything read at its own form is quoted whole; a
; `fn` with no signature to be read at instead gives up its body.
(pub :: lspHoverCode (-> String ASTNode (Option ASTNode) Int String))
(pub fn (lspHoverCode dsrc d sig o)
  (if (let (Some sig) sig)
    (lspFormText dsrc o)
    (if (== (nodeTag d) TAG_D_FN)
      (lspFirstLine (lspFormText dsrc o))
      (lspFormText dsrc o))))

; The second lookup, and it is `lspDefinitionImported` with a different
; answer at the end: the same preflight, the same four scratch vectors,
; the same entry directory, so hover and navigation cannot disagree
; about which module declares a name. What differs is that hover reads
; the OTHER unit's text - `memGetWordStr unit 1` - because the
; declaration's span indexes that file, and names the module it found
; it in, because "where did this come from" is most of what a reader
; hovering an imported name is asking.
(pub :: lspHoverImported (-> LspWorkspace String String (Vec ASTNode) String Int Int))
;@axiom:effect(io)
(pub fn (lspHoverImported workspace path src decls w range)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let d (lspFindImported allDecls w (- (vecLen allDecls) 1)))
        (if (let (Some d) d)
          {
            (let u (lspUnitOf units (nodeModuleOpt d)))
            (match u
              ((None) jsonNull)
              ((Some u)
                {
                  (let unit (vecGet units u))
                  (lspHoverAt (unitSrc unit) allDecls d range (unitName unit))
                }
              ))
          }
          (lspHoverCtorImported allDecls units w range))
      }
    }
    jsonNull))

; ------------------------------------------------------------------
; Reading a declaration back out of the document
;
; Hover quotes the source rather than rendering the tree, which is the
; same decision `definition` made and for the same reason: what a
; reader wants is what is WRITTEN, comments and spacing and all, and
; the document already holds it. Three questions have to be answered
; from bytes to do that - where the form starts, where it ends, and
; what was said above it.
; ------------------------------------------------------------------
; The `(` that opens the top-level form containing `off`.
;
; WALKING BACK TO THE NEAREST `(` IS A DIFFERENT QUESTION, and a `fn`
; is where the two answers part. A declaration's span names its NAME. A
; macro's name sits directly after its keyword - `(pub macro deriveTag`
; - so the nearest opener behind it is the form's own, which is why the
; nearest-opener rule was right for as long as hover answered macros
; and nothing else. A function's name sits INSIDE its parameter list -
; `(pub fn (bump x) (+ x 1))` - so the nearest opener is `(bump x)`'s,
; and a hover built on it would quote the parameter list and call it
; the declaration.
;
; The rule is COLUMN ZERO: a top-level form begins a line. That is what
; `axiom fmt` writes and what every file this compiler reads is in. A
; document mid-edit that indents a declaration falls back to the
; nearest opener, which is the answer this had before and no worse.
(pub :: lspFormStart (-> String Int Int))
(pub fn (lspFormStart src off)
  {
    (let n (strLen src))
    (if (== n 0)
      0
      {
        (let from
          (if (< off n)
            off
            (- n 1)))
        {
          (let mut o from)
          (let mut best (- 0 1))
          (let mut go 1)
          {
            (while (== go 1)
              (if (&& (== (strByte src o) 40) (|| (== o 0) (== (strByte src (- o 1)) 10)))
                {
                  (set best o)
                  (set go 0)
                }
                (if (== o 0)
                  (set go 0)
                  (set o (- o 1)))))
            (if (>= best 0)
              best
              (lspNearestOpen src from))
          }
        }
      })
  })

; The fallback: the nearest `(` at or before `off`, wherever it sits.
(pub :: lspNearestOpen (-> String Int Int))
(pub fn (lspNearestOpen src off)
  {
    (let mut o off)
    {
      (while (if (> o 0)
        (!= (strByte src o) 40)
        false)
        (set o (- o 1)))
      o
    }
  })

; The offset one past the `)` that closes the form opening at `o`, or
; the document length when nothing closes it - a form half-typed at the
; end of the file runs to EOF, which is what a reader expects of it.
;
; A DEPTH COUNT ALONE IS NOT ENOUGH: a `)` inside a string, a char
; literal, a `;` comment or a `#| |#` block is not a closer. Counted as
; one, a `data` declaration with a comment between two constructors
; would end at the comment's paren and hover would quote half a type. Rather than restate the rule this asks the four
; functions `scanAxtags` asks - `skipStringBody`, `skipCharBody`,
; `skipBlockComment`, `findNewline` - in `scanAxtags`'s own order, and
; consumes an identifier whole through `skipIdent` FIRST, because `'`
; is an identifier byte and `f'` must not open a char literal. What
; that costs when it is got wrong is written out at length in
; lexer.ax: one apostrophe silently deleted every AXTAG after it.
;
; Factored out of `lspFormText` so that a section asking where a form
; ENDS - folding, selection ranges, the argument count under a cursor
; - asks the same scanner rather than a second copy of the rule.
(pub :: lspFormEnd (-> String Int Int))
(pub fn (lspFormEnd src o)
  {
    (let n (strLen src))
    (let mut i o)
    (let mut depth 0)
    (let mut stop (- 0 1))
    {
      (while (if (< i n)
        (< stop 0)
        false)
        {
          (let ch (strByte src i))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (set i (skipIdent src (+ i 1) n))
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    {
                      (if (== ch 40)
                        (set depth (+ depth 1)))
                      (if (== ch 41)
                        {
                          (set depth (- depth 1))
                          (if (<= depth 0)
                            (set stop (+ i 1)))
                        })
                      (set i (+ i 1))
                    })))))
        })
      (if (< stop 0)
        n
        stop)
    }
  })

; The form at `o`, from its `(` to its matching `)`.
(pub :: lspFormText (-> String Int String))
(pub fn (lspFormText src o)
  (strSlice src o (- (lspFormEnd src o) o)))

; Every `(` whose form CONTAINS `off`, outermost first, as a Vec of
; byte offsets. A form contains `off` when it opens before `off` and
; has not closed by `off`; a form opening exactly AT `off` is not in
; the list, and a caller that wants it tests `(strByte src off)` for
; `(` itself.
;
; One forward pass from the top-level form's own opener - the
; column-zero rule of `lspFormStart` - so the cost is the length of ONE
; top-level form and not of the document. The scanner is the one
; `lspFormEnd` uses, for the reason it exists: a `(` inside a string or
; a comment is not an opener.
;
; What this is for: the enclosing call under a cursor asking for
; signature help, the chain of ranges a selection expands through, and
; the forms a folding request lists - three questions with one answer,
; which is why it sits here and not in any one section.
(pub :: lspEnclosingOpens (-> String Int Ints))
(pub fn (lspEnclosingOpens src off)
  (lspEnclosingDelimiters src off false))

; Selection includes brace blocks. Call-oriented features keep their
; parenthesis-only stack by passing false.
(pub :: lspEnclosingDelimiters (-> String Int Bool Ints))
(pub fn (lspEnclosingDelimiters src off blocks)
  {
    (let n (strLen src))
    (let stack vecNew)
    (if (|| (== n 0) (> off n))
      stack
      {
        (let mut i (lspFormStart src off))
        {
          (while (< i off)
            {
              (let ch (strByte src i))
              (if (== ch 34)
                (set i (skipStringBody src (+ i 1) n))
                (if (isIdentStart ch)
                  (set i (skipIdent src (+ i 1) n))
                  (if (== ch 39)
                    (set i (skipCharBody src (+ i 1) n))
                    (if (&& (== ch 35) (isBlockOpen src i n))
                      (set i (skipBlockComment src (+ i 2) n))
                      (if (== ch 59)
                        (set i (findNewline src i n))
                        {
                          (if (|| (== ch 40) (&& blocks (== ch 123)))
                            (vecPush stack i))
                          (if (&& (|| (== ch 41) (&& blocks (== ch 125))) (> (vecLen stack) 0))
                            (vecPop stack))
                          (set i (+ i 1))
                        })))))
            })
          stack
        }
      })
  })

; Whether a non-zero span covers `off` - the byte at `off` is inside
; `[start, end)`. A span of 0 covers nothing.
(pub :: lspSpanHas (-> Int Int Bool))
(pub fn (lspSpanHas sp off)
  (if (== sp 0)
    false
    (&& (>= off (spanStart sp)) (< off (spanEnd sp)))))

; The comment block written directly above the form at `o`, as prose.
;
; A `;;` LINE IS DOCUMENTATION. When the block holds any `;;` lines,
; they are the answer and the plain `;` lines beside them are notes
; for the maintainer, which is the split `docs/reference.md` names
; under "Doc comments". A block with no `;;` line answers all of its
; `;` lines, so code written before the convention still reads. A
; `;;!` line documents the module and belongs to no declaration, so it
; is left out either way (`docModuleDoc` reads it).
;
; This is the half of hover a signature cannot give. Every file this
; compiler reads documents a declaration in the lines above it - this
; one included - and an editor that shows the type and not the
; paragraph shows the less useful half.
;
; THE BLOCK STOPS AT A BANNER. A comment whose body is nothing but `-`
; or `=` is a section separator: it belongs to the FILE, and what sits
; above it documents the section rather than this declaration. Without
; that rule, hover on the first declaration after a banner quoted the
; banner, the section header and every line of prose introducing it.
; A blank line ends the block too, which is what a paragraph break
; between two declarations means.
;
; Only a form that begins a line has a block above it; the indented
; fallback in `lspFormStart` answers "" rather than reading whatever
; text happens to precede it on the same line.
(pub :: lspDocComment (-> String Int String))
(pub fn (lspDocComment src o)
  (docCommentAbove src o))

(pub :: lspIsSpace (-> Int Bool))
(pub fn (lspIsSpace b)
  (|| (docIsBlank b) (|| (== b 10) (== b 13))))

; At most `max` lines of `s`, with the cut said out loud in the fence's
; own comment syntax. Hover is a tooltip: a two-hundred-constructor
; `data` quoted whole is a wall the editor draws over the code being
; read.
(pub :: lspClampLines (-> String Int String))
(pub fn (lspClampLines s max)
  {
    (let n (strLen s))
    (let mut i 0)
    (let mut lines 0)
    (let mut cut (- 0 1))
    {
      (while (if (< i n)
        (< cut 0)
        false)
        {
          (if (== (strByte s i) 10)
            {
              (set lines (+ lines 1))
              (if (>= lines max)
                (set cut i))
            })
          (set i (+ i 1))
        })
      (if (< cut 0)
        s
        (concat (strSlice s 0 cut) "\n  ; ..."))
    }
  })

(pub :: lspFirstLine (-> String String))
(pub fn (lspFirstLine s)
  (if (let (Some nl) (strFindByte s 10 0))
    (strSlice s 0 nl)
    s))

; The last `(:: name T)` this declaration list carries for `name`.
;
; The comparison is EXACT, and it is exact for imported names too:
; `resolveImports` mangles a signature and its definition the same way,
; so `NavHelper$bump`'s type is found under `NavHelper$bump`. Type
; names are not mangled, which is why this is asked about functions
; and nothing else.
(pub :: lspFindSig (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindSig decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_SIG) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        (Some d)
        (lspFindSig decls name (- i 1)))
    }))

; The TYPE a signature declares, as its own bytes: `(pub :: bump (-> Int
; Int))` answers `(-> Int Int)`. A completion list has room for the
; type and not for the form around it.
;
; The name is skipped by walking identifier bytes from the span rather
; than by its length, because an imported declaration's `nodeAName` is
; `NavHelper$bump` and the source spells `bump`.
(pub :: lspSigType (-> String ASTNode String))
(pub fn (lspSigType src sig)
  {
    (let o (lspFormStart src (spanStart (nodeSpan sig))))
    {
      (let t (lspFormText src o))
      {
        (let n (strLen t))
        (let mut i (- (spanStart (nodeSpan sig)) o))
        {
          (if (|| (< i 0) (>= i n))
            (set i n))
          (while (if (< i n)
            (isIdentChar (strByte t i))
            false)
            (set i (+ i 1)))
          (while (if (< i n)
            (lspIsSpace (strByte t i))
            false)
            (set i (+ i 1)))
          {
            (let mut e (- n 1))
            {
              (while (if (> e i)
                (lspIsSpace (strByte t (- e 1)))
                false)
                (set e (- e 1)))
              (if (> e i)
                (strSlice t i (- e i))
                "")
            }
          }
        }
      }
    }
  })

(pub :: lspDocumentSymbols (-> String Int))
(pub fn (lspDocumentSymbols src)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError8) jsonArr)
      ((ParseSuccess parsedValue8 parsedPos8)
        {
          (let decls parsedValue8)
          (let out jsonArr)
          (let ix (lspLineIndex src))
          {
            (for n in decls
              (if (&& (lspWantsSymbol (nodeTag n))
                    (&& (!= (nodeSpan n) 0) (== (expIsJoinMarker (nodeAName n)) 0)))
                ; A `(syntax/join a b)` name parses to the marker
                ; string "syntax/join a b" (space-joined). The
                ; outline reads the RAW parse tree - deliberately,
                ; see the header - so a half-written derive macro's
                ; marker would otherwise publish its space-bearing
                ; spelling to the editor. Skipped: the expander is
                ; what resolves or refuses it, and either way the
                ; marker is not a name anyone can navigate to.
                (jsonArrPush out (lspSymbolJson src ix n))))
            out
          }
        }
      ))
  })

; ------------------------------------------------------------------
; `textDocument/completion`: the names that could go where the cursor
; is.
;
; WHAT IS OFFERED, in the order a client receives it:
;
;   1. THE HEAD KEYWORDS the parser dispatches on - `let`, `if`,
;      `match`, `fn`, `data` and the rest. No declaration list carries
;      them, and a half-typed form is usually reaching for one.
;   2. THIS DOCUMENT'S declarations, over the kinds the outline lists,
;      plus the CONSTRUCTORS a `data` declares: `Red` is a name that
;      gets written and it is not a declaration of its own.
;   3. EVERY IMPORTED MODULE'S declarations, under their bare names,
;      with the module in `detail`.
;
; A LOCAL NAME SHADOWS AN IMPORTED ONE and both shadow a keyword, which
; is the language's own rule and the reason for that order; a name
; already offered is not offered twice.
;
; THE PREFIX IS APPLIED HERE, and `isIncomplete` is what makes that
; correct rather than a shortcut. A client is entitled to filter a
; COMPLETE list itself and stop asking. This server answers only the
; names starting with what has been typed, so it must say the list is
; partial and be asked again on the next keystroke - answering
; `isIncomplete: false` to a filtered list is how a completion menu
; ends up frozen on the first letter. The `LSP_COMPL_MAX` cap rides on
; the same field: a menu is not a directory listing, and a truncation
; a client has been told about is not a silent one.
;
; A DOCUMENT THAT DOES NOT PARSE STILL COMPLETES, with the keywords.
; That is not a degraded case to apologise for - it is the normal one.
; A file is unparseable exactly while a form is half written, which is
; exactly when the question is being asked.
;
; WHAT IT COSTS: the parse and the import resolution `didOpen` already
; runs on every keystroke, and no expansion - MAC-TOOL-3's rule, the
; one `definition` and `hover` keep. `check-lsp-selfhost.sh` holds the
; whole request under the cost of that `didOpen` as a ratio, and holds
; the menu under `LSP_COMPL_MAX` items. It does NOT hold the guard
; below: both requests are dominated by the one parse every request in
; this server pays, so no wall-clock ceiling separates a build that
; asks the cheap question first from one that does not. That gate's
; header says so rather than implying otherwise.
; ------------------------------------------------------------------
; A menu, not a directory. 200 is far past what any client shows and
; far short of the six thousand names a stdlib-wide empty prefix would
; otherwise serialise on every keystroke.
(pub :: LSP_COMPL_MAX Int)
(pub fn (LSP_COMPL_MAX)
  200)

; The head keywords, spelled once.
;
; This list is a COPY of a set the parser owns, and it is a checked
; copy: `check-lsp-selfhost.sh` derives that set from the `kwEq name`
; call sites in `core/parser.ax` and requires this to equal it. So
; a keyword the parser learns and this forgets is a red gate rather
; than a menu quietly behind the language - which is the drift a
; hand-kept list of another module's vocabulary otherwise guarantees.
;
; The four the parser names only in order to REFUSE them - `union`,
; `foreign` and, since 0.6.0, `trait` and `impl`, whose whole effect
; is AX2004 - are not offered. Suggesting a word that cannot be used
; is worse than suggesting nothing. `tests/lsp/drive.py` carries the
; same four as the exclusion set it subtracts from the parser's
; `kwEq` sites, and the equality between the two is what
; `check-lsp-selfhost.sh` asserts. `region` is a keyword
; (`parseRegionExpr`) and is offered like `while`.
(pub :: lspKeywords Strings)
(pub fn (lspKeywords)
  {
    (let v vecNew)
    {
      ; `alloc` is AX2004 but still offered, like `cond` below: the
      ; menu mirrors what the parser dispatches on, and the parser
      ; still takes it - to a refusal naming `__alloc`.
      (vecPush v "alloc")
      (vecPush v "as")
      (vecPush v "asm")
      (vecPush v "begin")
      (vecPush v "cast")
      ; `cond` is AX2004 but still offered: this menu mirrors what the
      ; parser dispatches on (`drive.py` derives it from parser.ax's
      ; `kwEq` callsites), and the parser still takes `cond` - to a
      ; refusal with migration advice, the way `begin` and `consume`
      ; below are offered and refused. A variadic `if` and `match`
      ; cover what it did.
      (vecPush v "cond")
      (vecPush v "consume")
      (vecPush v "data")
      (vecPush v "define")
      (vecPush v "effect")
      (vecPush v "emacro")
      (vecPush v "extern")
      (vecPush v "fn")
      (vecPush v "for")
      (vecPush v "handle")
      (vecPush v "if")
      (vecPush v "import")
      (vecPush v "lambda")
      (vecPush v "let")
      (vecPush v "macro")
      (vecPush v "match")
      (vecPush v "parallel")
      (vecPush v "pub")
      (vecPush v "region")
      (vecPush v "set")
      (vecPush v "struct")
      (vecPush v "subtype")
      (vecPush v "syntax/for")
      (vecPush v "type")
      (vecPush v "while")
      (vecPush v "|>")
      v
    }
  })

; LSP CompletionItemKind. Function 3, Keyword 14, Enum 13, EnumMember
; 20, Struct 22, Class 7 for a `type` alias: the protocol's completion
; kinds have no alias either. A macro is a Function: the protocol has no kind for
; one, and `lspSymKind` collapses it the same way for the outline.
(pub :: lspComplKind (-> Int Int))
(pub fn (lspComplKind tag)
  (if (== tag TAG_D_DATA)
    13
    (if (== tag TAG_D_STRUCT)
      22
      (if (== tag TAG_D_ALIAS)
        7
        3))))

(pub :: lspComplItem (-> String Int String Int))
(pub fn (lspComplItem label kind detail)
  {
    (let base (jsonObjPut (jsonObjPut jsonObj "label" (jsonStr label)) "kind" (jsonNum kind)))
    (if (== (strLen detail) 0)
      base
      (jsonObjPut base "detail" (jsonStr detail)))
  })

; Whether `label` would be offered.
;
; Asked BEFORE a detail is built, and that is the whole point of its
; existing separately: `lspComplDetail` scans the declaration list for
; a signature, so building one for every declaration and then
; discarding it on the prefix is n-squared paid per keystroke -
; measured at 25 ms on a 2,050-declaration document, 65 ms at 6,000.
; Axiom is strict; the only way not to compute an argument is not to
; reach the call.
;
; Nothing but this comment holds it. The cost gate bounds the request
; against a `didOpen` that is itself dominated by a parse, and both
; builds sit inside that ceiling - so the guard is held by review, and
; deleting it is a change to make on purpose.
(pub :: lspComplWants (-> Strings String String Bool))
(pub fn (lspComplWants seen label prefix)
  (if (>= (vecLen seen) LSP_COMPL_MAX)
    false
    (if (== (strLen label) 0)
      false
      (if (== (expIsJoinMarker label) 0)
        (if (strStartsWith label prefix)
          (if (lspSeenHas seen label)
            false
            true)
          false)
        false))))

(pub :: lspComplOffer (-> Int Strings String Int String String Int))
(pub fn (lspComplOffer out seen label kind detail prefix)
  (if (lspComplWants seen label prefix)
    {
      (vecPush seen label)
      (jsonArrPush out (lspComplItem label kind detail))
      0
    }
    0))

; The identifier bytes immediately BEFORE the cursor.
;
; `lspWordAt` will not do, and the difference is the whole request: it
; requires the offset to be ON an identifier byte, and a cursor that
; has just typed `vecP` sits one past the `P`, on whatever comes next
; or on nothing at all.
(pub :: lspPrefixAt (-> String Int String))
(pub fn (lspPrefixAt src off)
  {
    (let n (strLen src))
    (let e
      (if (> off n)
        n
        off))
    {
      (let mut s e)
      {
        (while (if (> s 0)
          (isIdentChar (strByte src (- s 1)))
          false)
          (set s (- s 1)))
        (strSlice src s (- e s))
      }
    }
  })

(pub :: lspComplList (-> Int Int))
(pub fn (lspComplList items)
  (jsonObjPut (jsonObjPut jsonObj "isIncomplete" (jsonBool 1)) "items" items))

; Parameters of the function whose contract contains the cursor. Signature
; tags attach to the signature, so find its matching definition as well.
(pub :: lspComplContract (-> Int Strings String (Vec ASTNode) Int String ()))
(pub fn (lspComplContract out seen src decls off prefix)
  {
    (let ls (lspLineStartAt src off))
    {
      (let line (strTrim (strSlice src ls (- (docLineEndFrom src ls) ls))))
      (if (|| (strStartsWith line ";@axiom:pre(") (strStartsWith line ";@axiom:post("))
        (lspComplContractAt out seen src decls (contractSigIndex decls) off prefix))
    }
  })

(pub :: lspComplContractAt (-> Int Strings String (Vec ASTNode) (Vec ASTNode) Int String ()))
(pub fn (lspComplContractAt out seen src decls sigs off prefix)
  {
    (for d in decls
      (if (== (nodeTag d) TAG_D_FN)
        {
          (let tags (contractTagsFor sigs d))
          (for t in tags
            (if (&& (>= off t.off) (<= off (findNewline src t.off (strLen src))))
              {
                (let ps (nodeBNames d))
                {
                  (for k in 0..(vecLen ps)
                    (lspComplOffer out seen (vecGet ps k) 6 "contract parameter" prefix))
                  (if (strEq (contractKeyOf t) "post")
                    (lspComplOffer out seen "result" 6 "function result" prefix))
                }
              }))
        }))
    ()
  })

; A completion request carries only scalar session state into the worker.
; Deferred items keep a declaration identity, never a parsed model.
(struct LspComplMode
  (deferred : Bool)
  (uri : String)
  (revision : Int))

(pub :: lspCompletion (-> LspWorkspace String String Int LspComplMode Int))
;@axiom:effect(io)
(pub fn (lspCompletion workspace src uri params mode)
  {
    (let ix (lspLineIndex src))
    (let out jsonArr)
    (let seen vecNew)
    {
      (let prefix (lspPrefixAt src (lspOffsetOf src ix (jsonGet params "position"))))
      (let modPath (lspImportPathAt src (lspOffsetOf src ix (jsonGet params "position"))))
      (let query (lspAxqlLitAt src (lspOffsetOf src ix (jsonGet params "position"))))
      (if (isSome query)
        ; Inside a query literal: AXQL's words, and the document's
        ; tables and columns; nothing from the language around it.
        {
          (lspComplAxql out seen src prefix)
          (lspComplList out)
        }
        (if (let (Some typed) modPath)
          ; After `(import `: module names, one path segment at a time.
          {
            (lspComplModules out seen (lspUriToPath uri) typed)
            (lspComplList out)
          }
          {
            (let pr (lspParse src))
            {
              (lspComplKeywords out seen prefix)
              (match pr
                ((ParseFailed parseError9) ())
                ((ParseSuccess parsedValue9 parsedPos9)
                  {
                    (let decls parsedValue9)
                    {
                      (lspComplContract out seen src decls
                        (lspOffsetOf src ix (jsonGet params "position")) prefix)
                      (lspComplLocal out seen src decls prefix mode)
                      (lspComplImported workspace out seen (lspUriToPath uri) src decls prefix mode)
                    }
                  }
                ))
              (lspComplList out)
            }
          }))
    }
  })

; The module path typed so far when the cursor sits in the module
; position of an `(import ...)`: `Some ""` right after `(import ` and
; `Some "Crypto.Sh"` partway through a dotted name. `None` means the
; cursor is elsewhere, including an import's name list.
(pub :: lspImportPathAt (-> String Int (Option String)))
(pub fn (lspImportPathAt src off)
  {
    (let e
      (if (> off (strLen src))
        (strLen src)
        off))
    (let mut s
      (if (> off (strLen src))
        (strLen src)
        off))
    {
      (while (if (> s 0)
        {
          (let b (strByte src (- s 1)))
          (|| (isIdentChar b) (== b 46))
        }
        false)
        (set s (- s 1)))
      {
        (let mut k s)
        {
          (while (if (> k 0)
            (|| (== (strByte src (- k 1)) 32) (== (strByte src (- k 1)) 9))
            false)
            (set k (- k 1)))
          (if (if (>= k 7)
            (if (strEq (strSlice src (- k 7) 7) "(import")
              (< k s)
              false)
            false)
            (Some (strSlice src s (- e s)))
            None)
        }
      }
    }
  })

; Module names for a module position whose text so far is `typed`:
; the directory part names where to look under each search root, and
; the last segment is the prefix. A `.ax` file offers its module stem
; (the target's suffix ladder, as the resolver reads it); a directory
; whose name is a segment offers itself, as a namespace to continue
; into. One `listDir` per search root; nothing is read or parsed.
(pub :: lspComplModules (-> Int Strings String String Int))
;@axiom:effect(io)
(pub fn (lspComplModules out seen path typed)
  {
    (let tcode (checkedTargetCode hostTarget))
    (let dot (lspLastDot typed))
    {
      (let rel
        (if (< dot 0)
          ""
          (concat (lspDotsToSlashes (strSlice typed 0 dot)) "/")))
      (let part
        (if (< dot 0)
          typed
          (strSlice typed (+ dot 1) (- (strLen typed) (+ dot 1)))))
      (let dirs (moduleSearchDirs (pathDir path)))
      {
        (for i in 0..(vecLen dirs)
          {
            (let root (vecGetStr dirs i))
            {
              (let names
                (unwrapOr
                  (listDir
                    (if (== (strLen root) 0)
                      (concat "./" rel)
                      (concat root rel)))
                  vecNew))
              (for j in 0..(vecLen names)
                {
                  (let nm (vecGet names j))
                  (if (! (|| (== (strLen nm) 0) (== (strByte nm 0) 46)))
                    (if (lspFixEndsWith nm ".ax")
                      {
                        (let stem (lspFixStemOf nm tcode))
                        (if (! (== (strLen stem) 0))
                          (lspComplOffer out seen stem 9 "module" part))
                      }
                      (if (&& (lspFixIsSegment nm) (isDir (concat root (concat rel nm))))
                        (lspComplOffer out seen nm 19 "namespace" part))))
                })
            }
          })
        0
      }
    }
  })

; The index of the last `.` in `s`, or -1.
(pub :: lspLastDot (-> String Int))
(pub fn (lspLastDot s)
  {
    (let mut i (- (strLen s) 1))
    {
      (while (if (>= i 0)
        (!= (strByte s i) 46)
        false)
        (set i (- i 1)))
      i
    }
  })

; `Crypto.Tui` as the directory path `Crypto/Tui`.
(pub :: lspDotsToSlashes (-> String String))
(pub fn (lspDotsToSlashes s)
  {
    (let parts (strSplit s 46))
    (let mut out "")
    {
      (for i in 0..(vecLen parts)
        (set out (if (== i 0)
          (vecGet parts 0)
          (concat out (concat "/" (vecGet parts i))))))
      out
    }
  })

; Current keyword suggestions, shared with the REPL. Retired heads
; remain recognisable for diagnostics and highlighting, but are not
; offered as syntax a developer should write.
(pub :: lspCompletionKeywords Strings)
(pub fn (lspCompletionKeywords)
  {
    (let out vecNew)
    (let all lspKeywords)
    (let removed lspHlRemovedWords)
    {
      (for i in 0..(vecLen all)
        {
          (let word (vecGet all i))
          (if (! (lspSeenHas removed word))
            (vecPush out word))
        })
      out
    }
  })

(pub :: lspComplKeywords (-> Int Strings String Int))
(pub fn (lspComplKeywords out seen prefix)
  {
    (let kws lspCompletionKeywords)
    (let n (vecLen kws))
    {
      (for i in 0..n
        (lspComplOffer out seen (vecGet kws i) 14 "keyword" prefix))
      0
    }
  })

; This document's own names. The same set the outline publishes - so a
; name an editor can list, jump to and hover is a name it can also
; complete - plus the constructors, which the outline leaves out
; because they are not declarations and completion wants because they
; are names.
(pub :: lspComplLocal (-> Int Strings String (Vec ASTNode) String LspComplMode Int))
(pub fn (lspComplLocal out seen src decls prefix mode)
  {
    (let n (vecLen decls))
    {
      (for i in 0..n
        {
          (let d (vecGet decls i))
          (if (&& (lspWantsSymbol (nodeTag d)) (!= (nodeSpan d) 0))
            {
              (if (lspComplWants seen (nodeAName d) prefix)
                (lspComplDeclOffer out seen (nodeAName d) (lspComplKind (nodeTag d))
                  (if mode.deferred
                    ""
                    (lspComplDetail src decls d))
                  prefix mode d))
              (if (== (nodeTag d) TAG_D_DATA)
                (lspComplCtors out seen d prefix mode))
            })
        })
      0
    }
  })

; A local function's type, as written. Only a `fn` has one to show, and
; only the document's own declarations are asked: over the merged list
; this scan is the length of every module imported, per accepted item,
; per keystroke. An imported name shows its MODULE instead, which is
; the question being asked about it anyway and costs one walk of the
; mangled name.
(pub :: lspComplDetail (-> String (Vec ASTNode) ASTNode String))
(pub fn (lspComplDetail src decls d)
  (if (== (nodeTag d) TAG_D_FN)
    {
      (let sig (lspFindSig decls (nodeAName d) (- (vecLen decls) 1)))
      (if (let (Some sig) sig)
        (lspSigType src sig)
        "")
    }
    ""))

(pub :: lspComplCtors (-> Int Strings ASTNode String LspComplMode Int))
(pub fn (lspComplCtors out seen d prefix mode)
  {
    (let ctors (nodeBChildren d))
    (let n (vecLen ctors))
    {
      (for i in 0..n
        (lspComplDeclOffer out seen (nodeAName (vecGet ctors i)) 20 "" prefix mode d))
      0
    }
  })

; Everything the imports bring in, by the bare name a reference spells.
;
; The resolver is given what `lspCheckDoc` and `lspDefinitionImported`
; give it, for the reason they agree on it: a different entry directory
; resolves a different set of files, and a completion list that does
; not match the names the checker will accept is worse than no list.
; A resolver failure is an empty addition rather than a diagnostic -
; half-typed imports are the normal state of a file being edited.
(pub :: lspComplImported
  (-> LspWorkspace Int Strings String String (Vec ASTNode) String LspComplMode Int))
;@axiom:effect(io)
(pub fn (lspComplImported workspace out seen path src decls prefix mode)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let n (vecLen allDecls))
        {
          (for i in 0..n
            {
              (let d (vecGet allDecls i))
              (if (&& (lspWantsSymbol (nodeTag d)) (&& (!= (nodeModule d) 0) (!= (nodeSpan d) 0)))
                {
                  (lspComplDeclOffer out seen (bareOf (nodeAName d)) (lspComplKind (nodeTag d))
                    (match (lspModOf (nodeAName d))
                      ((None) "")
                      ((Some m) m))
                    prefix mode d)
                  (if (== (nodeTag d) TAG_D_DATA)
                    (lspComplCtors out seen d prefix mode))
                })
            })
          0
        }
      }
    }
    0))

; Deferral is safe only when both fields can be filled by a later request.
(:: lspComplCanResolve (-> Int Bool))
(fn (lspComplCanResolve params)
  {
    (let item
      (jsonGet (jsonGet (jsonGet (jsonGet params "capabilities") "textDocument") "completion")
        "completionItem"))
    (let properties (jsonGet (jsonGet item "resolveSupport") "properties"))
    (let mut detail false)
    (let mut documentation false)
    {
      (for i in 0..(jsonArrLen properties)
        {
          (let property (jsonStrVal (jsonArrGet properties i)))
          {
            (if (strEq property "detail")
              (set detail true))
            (if (strEq property "documentation")
              (set documentation true))
          }
        })
      (&& detail documentation)
    }
  })

; Keywords, module paths and contract names remain complete immediately.
; A declaration identity survives the arena reset without retaining ASTs.
(:: lspComplDeclOffer (-> Int Strings String Int String String LspComplMode ASTNode Int))
(fn (lspComplDeclOffer out seen label kind detail prefix mode d)
  (if (lspComplWants seen label prefix)
    {
      (let item (lspComplItem label kind detail))
      {
        (if mode.deferred
          (jsonObjPut item "data"
            (jsonObjPut
              (jsonObjPut
                (jsonObjPut
                  (jsonObjPut
                    (jsonObjPut
                      (jsonObjPut
                        (jsonObjPut
                          (jsonObjPut (jsonObjPut jsonObj "owner" (jsonStr "axiom.completion.v1"))
                            "uri" (jsonStr mode.uri))
                          "revision" (jsonNum mode.revision))
                        "name" (jsonStr (nodeAName d)))
                      "start" (jsonNum (spanStart (nodeSpan d))))
                    "tag" (jsonNum (nodeTag d)))
                  "module"
                  (match (nodeModuleOpt d)
                    ((None) jsonNull)
                    ((Some name) (jsonStr name))))
                "label" (jsonStr label))
              "kind" (jsonNum kind))))
        (vecPush seen label)
        (jsonArrPush out item)
        0
      }
    }
    0))

(:: lspComplDataValid (-> Int Int Bool))
(fn (lspComplDataValid item data)
  {
    (let strings
      (&& (lspSyncString (jsonGet data "uri"))
        (&& (> (strLen (jsonGetStr data "uri")) 0)
          (&& (lspSyncString (jsonGet data "name")) (> (strLen (jsonGetStr data "name")) 0)))))
    (let numbers
      (&& (isSome (strParseInt (jsonNumText (jsonGet data "revision"))))
        (&& (lspSyncInteger (jsonGet data "start"))
          (&& (>= (jsonGetInt data "start") 0)
            (&& (lspSyncInteger (jsonGet data "tag")) (lspSyncInteger (jsonGet data "kind")))))))
    (let label
      (&& (strEq (jsonGetStr item "label") (jsonGetStr data "label"))
        (strEq (jsonNumText (jsonGet item "kind")) (jsonNumText (jsonGet data "kind")))))
    (let module (jsonGet data "module"))
    (&& strings
      (&& numbers (&& label (&& (!= module 0) (|| (jsonIsNull module) (lspSyncString module))))))
  })

; Match the exact declaration offered, including its module and source span.
; Imported constructors keep their parent data declaration as their identity.
(:: lspComplFind (-> Nodes Int (Option ASTNode)))
(fn (lspComplFind decls data)
  {
    (let mut found None)
    {
      (for d in decls
        (if (&& (lspWantsSymbol (nodeTag d))
              (&& (strEq (nodeAName d) (jsonGetStr data "name"))
                (&& (!= (nodeSpan d) 0)
                  (&& (== (spanStart (nodeSpan d)) (jsonGetInt data "start"))
                    (&& (== (nodeTag d) (jsonGetInt data "tag"))
                      (match (nodeModuleOpt d)
                        ((None) (jsonIsNull (jsonGet data "module")))
                        ((Some name) (strEq name (jsonGetStr data "module")))))))))
          (set found (Some d))))
      found
    }
  })

(:: lspComplResolveAt (-> Int String Nodes ASTNode Int))
(fn (lspComplResolveAt item src decls d)
  {
    (let kind (jsonGetInt item "kind"))
    (let label (jsonGetStr item "label"))
    (let mut matches false)
    {
      (if (&& (== kind 20) (== (nodeTag d) TAG_D_DATA))
        (for ctor in (nodeBChildren d)
          (if (strEq label (nodeAName ctor))
            (set matches true)))
        (set matches (&& (== kind (lspComplKind (nodeTag d)))
                       (strEq label (bareOf (nodeAName d))))))
      (if (! matches)
        0
        {
          (let sig
            (if (== (nodeTag d) TAG_D_FN)
              (lspFindSig decls (nodeAName d) (- (vecLen decls) 1))
              None))
          (let at
            (match sig
              ((None) d)
              ((Some signature) signature)))
          (let doc (lspDocComment src (lspFormStart src (spanStart (nodeSpan at)))))
          {
            (if (&& (== (jsonGet item "detail") 0) (== kind 3))
              {
                (let detail
                  (match sig
                    ((None) "")
                    ((Some signature) (lspSigType src signature))))
                (if (> (strLen detail) 0)
                  (jsonObjPut item "detail" (jsonStr detail)))
              })
            (if (&& (== (jsonGet item "documentation") 0) (> (strLen doc) 0))
              (jsonObjPut item "documentation" (jsonStr doc)))
            item
          }
        })
    }
  })

; Resolve just the selected declaration. Parsing and import resolution are
; repeated here; no checker, macro expansion or semantic model is retained.
(:: lspComplResolve (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(fn (lspComplResolve workspace uri src item)
  {
    (let data (jsonGet item "data"))
    (match (lspParse src)
      ((ParseFailed error) 0)
      ((ParseSuccess decls position)
        (if (jsonIsNull (jsonGet data "module"))
          (match (lspComplFind decls data)
            ((None) 0)
            ((Some d) (lspComplResolveAt item src decls d)))
          (match (lspResolveFor workspace (lspUriToPath uri) src decls)
            ((None) 0)
            ((Some resolved)
              (match (lspComplFind resolved.decls data)
                ((None) 0)
                ((Some d)
                  (match (lspUnitOf resolved.units (nodeModuleOpt d))
                    ((None) 0)
                    ((Some unit)
                      (lspComplResolveAt item (unitSrc (vecGet resolved.units unit)) resolved.decls
                        d)
                    ))
                ))
            )))
      ))
  })

(:: lspComplResolveBody (-> LspWorkspace Int Int Strings Strings Int String))
;@axiom:effect(io)
(fn (lspComplResolveBody workspace id item uris texts revision)
  (if (|| (! (lspSyncString (jsonGet item "label"))) (== (strLen (jsonGetStr item "label")) 0))
    (lspErrorBody id (- 0 32602) "completion item requires a label")
    {
      (let data (jsonGet item "data"))
      (if (! (strEq (jsonGetStr data "owner") "axiom.completion.v1"))
        (lspReplyBody id item)
        (if (! (lspComplDataValid item data))
          (lspErrorBody id (- 0 32602) "invalid completion item data")
          (if (! (strEq (jsonNumText (jsonGet data "revision")) (fmtInt revision)))
            (lspErrorBody id (- 0 32801) "completion item belongs to an older workspace revision")
            (match (docText uris texts (jsonGetStr data "uri"))
              ((None) (lspErrorBody id (- 0 32801) "completion document is unavailable"))
              ((Some src)
                {
                  (let resolved (lspComplResolve workspace (jsonGetStr data "uri") src item))
                  (if (== resolved 0)
                    (lspErrorBody id (- 0 32602) "completion declaration is unavailable")
                    (lspReplyBody id resolved))
                }
              )))))
    }))

; The module half of a mangled name: `Vec$vecPush` answers `Vec`. The
; other half of `bareOf`. `None` means no nonempty module prefix was
; mangled into the name.
(pub :: lspModOf (-> String (Option String)))
(pub fn (lspModOf s)
  (lspModOfFrom s (- (strLen s) 1)))

(pub :: lspModOfFrom (-> String Int (Option String)))
(pub fn (lspModOfFrom s i)
  (if (< i 0)
    None
    (if (== (strByte s i) 36)
      (if (> i 0)
        (Some (strSlice s 0 i))
        None)
      (lspModOfFrom s (- i 1)))))

;; The byte two hex digits at `i` and `i+1` spell, or `None` when either
;; is not a digit. `strHexVal` answers `(Option Int)` and both reads are
;; matched directly, so no block is built; the combined value is what
;; the percent-decoder below stores.
(:: lspHexPair (-> String Int (Option Int)))
(fn (lspHexPair s i)
  (if (let (Some h) (strHexVal (strByte s i)))
    (match (strHexVal (strByte s (+ i 1)))
      ((None) None)
      ((Some l) (Some (+ (* h 16) l))))
    None))

; ------------------------------------------------------------------
; URIs
;
; `file:///a/b.ax` -> `/a/b.ax`, percent-decoding as it goes. Anything
; that is not a `file:` URI is passed through unchanged: the checker
; only ever uses the path to find sibling modules, so a URI it cannot
; interpret degrades to "no import directory" rather than to a refusal.
; ------------------------------------------------------------------
(pub :: lspUriToPath (-> String String))
;@axiom:effect(unsafe)
(pub fn (lspUriToPath uri)
  {
    (let body
      (if (strStartsWith uri "file://")
        (strSlice uri 7 (- (strLen uri) 7))
        uri))
    {
      (let out (strAlloc (strLen body)))
      (let mut i 0)
      (let mut o 0)
      {
        (while (< i (strLen body))
          (if (&& (== (strByte body i) 37) (<= (+ i 3) (strLen body)))
            (if (let (Some hl) (lspHexPair body (+ i 1)))
              {
                (__store8 (strData out) o hl)
                (set o (+ o 1))
                (set i (+ i 3))
              }
              {
                (__store8 (strData out) o (strByte body i))
                (set o (+ o 1))
                (set i (+ i 1))
              })
            {
              (__store8 (strData out) o (strByte body i))
              (set o (+ o 1))
              (set i (+ i 1))
            }))
        (strSlice out 0 o)
      }
    }
  })

; ------------------------------------------------------------------
; The document store: two parallel Vecs, one writer.
; ------------------------------------------------------------------
(pub :: docFind (-> Strings String Int))
(pub fn (docFind uris uri)
  (docFindFrom uris uri 0))

(pub :: docFindFrom (-> Strings String Int Int))
(pub fn (docFindFrom uris uri i)
  (if (>= i (vecLen uris))
    (- 0 1)
    (if (strEq (vecGet uris i) uri)
      i
      (docFindFrom uris uri (+ i 1)))))

; The ONLY writer of the pair. Both vecs are appended together or
; neither is, so their indices cannot drift apart.
(pub :: docPut (-> Strings Strings String String Int))
(pub fn (docPut uris texts uri text)
  {
    (let i (docFind uris uri))
    (if (< i 0)
      {
        (vecPush uris uri)
        (vecPush texts text)
        (vecLen uris)
      }
      {
        (vecSet texts i text)
        (vecLen uris)
      })
  })

(pub :: docText (-> Strings Strings String (Option String)))
(pub fn (docText uris texts uri)
  {
    (let i (docFind uris uri))
    (if (< i 0)
      None
      (Some (vecGet texts i)))
  })

; The generated-name cache: one JSON array per open document, in a
; third vector parallel to `texts` and kept index-aligned with it by
; the same rule - appended together or neither. Each entry is what
; one macro invocation generated that a name can be looked up by:
; `{"name","macro","invStart","invEnd","code"}`, where the invocation
; offsets are bytes into the document and `code` is the `::` the
; product was generated with (or the `fn`'s first line when no `::`
; was). `lspRecheck` fills it, which already runs the pipeline -
; including expansion - for diagnostics, so per-keystroke requests
; read names expansion never touches their path for. That is the
; whole of MAC-TOOL-3's cache side: `definition`, `hover`,
; `references` and `declaration` consult this string and expand
; nothing, and `scripts/check-macro-demand.sh` pins the fast path
; structurally.
(pub :: docPutGen (-> Strings Strings String String Int))
(pub fn (docPutGen uris gens uri gen)
  {
    (let i (docFind uris uri))
    (if (< i 0)
      ; A uri `docPut` has not seen either: appended, so the two
      ; stays aligned whichever of the two writers runs first.
      {
        (vecPush gens gen)
        (vecLen gens)
      }
      {
        (while (<= (vecLen gens) i)
          (vecPush gens ""))
        (vecSet gens i gen)
        (vecLen gens)
      })
  })

(pub :: docGen (-> Strings Strings String String))
(pub fn (docGen uris gens uri)
  {
    (let i (docFind uris uri))
    (if (< i 0)
      "[]"
      (vecGet gens i))
  })

; Derived results are keyed by the workspace revision, method and params.
; Eight entries and four MiB bound retained storage. Cursor traffic
; evicts older cursor results before reusable document replies. File observations
; include unsuccessful higher-priority candidates, so creating a module
; cannot leave a cached result pointing at the old search winner.
(pub :: lspCacheKey (-> Int String Int String))
(pub fn (lspCacheKey revision method params)
  (if (lspCacheable method)
    {
      (let key
        (concat
          (if (|| (!= (jsonGet params "position") 0)
                (|| (!= (jsonGet params "positions") 0) (!= (jsonGet params "item") 0)))
            "P"
            "D")
          (concat (fmtInt revision)
            (concat "\n" (concat method (concat "\n" (jsonWrite params)))))))
      (if (<= (strLen key) 4096)
        key
        "")
    }
    ""))

(pub :: lspCacheable (-> String Bool))
(pub fn (lspCacheable method)
  (&& (! (strEq method "textDocument/completion"))
    (&& (! (strEq method "textDocument/codeAction"))
      (&& (! (strEq method "textDocument/documentLink"))
        (&& (! (lspHlHandles method))
          (|| (strEq method "textDocument/documentSymbol")
            (|| (strEq method "textDocument/hover")
              (|| (strEq method "textDocument/definition") (lspExtHandles method)))))))))

(pub :: lspCacheInputs (-> LspWorkspace Int))
(pub fn (lspCacheInputs workspace)
  {
    (let files jsonArr)
    (let searches jsonArr)
    {
      (for unit in workspace.files
        (jsonArrPush files
          (jsonObjPut (jsonObjPut jsonObj "path" (jsonStr unit.file)) "text"
            (match unit.text
              ((None) jsonNull)
              ((Some text) (jsonStr text))))))
      (for item in workspace.searches
        {
          (let paths jsonArr)
          {
            (for root in item.roots
              (jsonArrPush paths (jsonStr root)))
            (jsonArrPush searches
              (jsonObjPut (jsonObjPut jsonObj "directory" (jsonStr item.directory)) "roots" paths))
          }
        })
      (jsonObjPut (jsonObjPut jsonObj "files" files) "searches" searches)
    }
  })

(pub :: lspCacheInputsCurrent (-> Int Bool))
;@axiom:effect(io)
(pub fn (lspCacheInputsCurrent inputs)
  {
    (let files (jsonGet inputs "files"))
    (let searches (jsonGet inputs "searches"))
    (let mut i 0)
    (let mut current true)
    {
      (while (&& current (< i (jsonArrLen files)))
        {
          {
            (let item (jsonArrGet files i))
            (let expected (jsonGet item "text"))
            (set current (match (readFile (jsonGetStr item "path"))
              ((Err _) (jsonIsNull expected))
              ((Ok text)
                (if (jsonIsNull expected)
                  false
                  (strEq text (jsonStrVal expected)))
              )))
          }
          (set i (+ i 1))
        })
      (set i 0)
      (while (&& current (< i (jsonArrLen searches)))
        {
          {
            (let item (jsonArrGet searches i))
            (let paths jsonArr)
            {
              (let dirs (moduleSearchDirs (jsonGetStr item "directory")))
              {
                (for j in 0..(vecLen dirs)
                  (jsonArrPush paths (jsonStr (vecGetStr dirs j))))
                (set current (strEq (jsonWrite paths) (jsonWrite (jsonGet item "roots"))))
              }
            }
          }
          (set i (+ i 1))
        })
      current
    }
  })

(pub :: lspCacheFind (-> Strings String (Option String)))
;@axiom:effect(io)
(pub fn (lspCacheFind cache key)
  {
    (let mut i 0)
    (let mut result (:: None (Option String)))
    {
      (while (&& (> (strLen key) 0) (&& (isNone result) (< (+ i 1) (vecLen cache))))
        {
          (if (strEq key (vecGet cache i))
            {
              (let entry (jsonParse (vecGet cache (+ i 1))))
              (if (lspCacheInputsCurrent (jsonGet entry "inputs"))
                (set result (Some (jsonGetStr entry "result"))))
            })
          (set i (+ i 2))
        })
      result
    }
  })

(pub :: lspCacheEntry (-> LspWorkspace String String))
(pub fn (lspCacheEntry workspace result)
  {
    (let entry
      (jsonWrite
        (jsonObjPut (jsonObjPut jsonObj "result" (jsonStr result)) "inputs"
          (lspCacheInputs workspace))))
    (if (<= (strLen entry) 1048576)
      entry
      "")
  })

(pub :: lspCacheStore (-> Strings String String Int))
(pub fn (lspCacheStore cache key entry)
  (if (|| (== (strLen key) 0) (|| (== (strLen entry) 0) (> (strLen entry) 1048576)))
    0
    {
      (let mut bytes 0)
      (let mut admit true)
      {
        (for i in 0..(vecLen cache)
          (set bytes (+ bytes (strLen (vecGet cache i)))))
        (while (&& admit
                 (|| (>= (vecLen cache) 16) (> (+ bytes (+ (strLen key) (strLen entry))) 4194304)))
          {
            (let victim (lspCacheVictim cache (== (strByte key 0) 68)))
            (if (let (Some at) victim)
              {
                (set bytes (- bytes
                             (+ (strLen (vecGet cache at)) (strLen (vecGet cache (+ at 1))))))
                (lspCacheRemove cache at)
              }
              (set admit false))
          })
        (if admit
          {
            (vecPush cache key)
            (vecPush cache entry)
          })
        0
      }
    }))

; FIFO within each class. A cursor result cannot displace a cache
; containing only reusable replies; it still answers without retention.
(pub :: lspCacheVictim (-> Strings Bool (Option Int)))
(pub fn (lspCacheVictim cache reusable)
  {
    (let mut i 0)
    (let mut victim (:: None (Option Int)))
    {
      (while (&& (< i (vecLen cache)) (isNone victim))
        {
          (if (== (strByte (vecGet cache i) 0) 80)
            (set victim (Some i)))
          (set i (+ i 2))
        })
      (if (&& (isNone victim) (&& reusable (> (vecLen cache) 0)))
        (Some 0)
        victim)
    }
  })

(pub :: lspCacheRemove (-> Strings Int Int))
(pub fn (lspCacheRemove cache index)
  {
    (let mut i index)
    {
      (while (< (+ i 2) (vecLen cache))
        {
          (vecSet cache i (vecGet cache (+ i 2)))
          (set i (+ i 1))
        })
      (vecPop cache)
      (vecPop cache)
      0
    }
  })

(pub :: lspCacheInvalidate (-> LspStore Int))
(pub fn (lspCacheInvalidate store)
  {
    (vecClear store.cache)
    (set store.generation (if (== store.generation 9223372036854775807)
      1
      (+ store.generation 1)))
    0
  })

; Standard LSP tracing makes cache behaviour visible when diagnosing an
; editor session. Off is the default; request ids and source text stay
; out of these messages.
(pub :: lspTraceSet (-> LspStore Int Int))
(pub fn (lspTraceSet store params)
  {
    (let value (jsonGetStr params "value"))
    {
      (if (|| (strEq value "off") (|| (strEq value "messages") (strEq value "verbose")))
        (set store.trace (if (strEq value "off")
          0
          1)))
      0
    }
  })

(pub :: lspCacheTrace (-> LspStore String String Int))
;@axiom:effect(io)
(pub fn (lspCacheTrace store key result)
  (if (&& (== store.trace 1) (> (strLen key) 0))
    (lspNotify "$/logTrace"
      (jsonObjPut jsonObj "message"
        (jsonStr
          (if (> (strLen result) 0)
            "semantic cache hit"
            "semantic cache miss"))))
    0))

; ------------------------------------------------------------------
; The request boundary
; ------------------------------------------------------------------
;
; A request's working set is dead the moment its response is written:
; the parse tree, every diagnostic, the JSON on the way out. What
; survives is the document store, and whatever bytes of the *next*
; message this read already pulled into the reader. Nothing else.
;
; Nothing reclaimed it. Measured on `didChange` of a 16 KB file:
; 8.3 MB after one edit, 693.7 MB after two hundred - 3.4 MB retained
; per keystroke-sized edit, for the lifetime of the session. That is
; the roadmap's §1 dependency edge with a number on it: an editor is a
; long-running program, and a bump allocator that never frees is a
; leak with a language server attached.
;
; So the loop marks the arena once, and reclaims to that mark after
; every message - carrying the live state across the reclaim as ONE
; block. That is `__axiom_arena_reset_keeping`, and it has to be one
; operation rather than a reset followed by a copy: the copy's
; destination would be handed out by the allocator, which scrubs
; re-used memory, and the scrub runs over the source whenever the live
; set is bigger than the garbage - which is precisely a server holding
; a document and answering a short request. See
; tests/stdlib/165-arena-keep.ax, where the naive spelling loses 39,841
; of 40,000 bytes on its first round.
;
; The block is laid out so that restoring it needs no allocation it
; cannot make afterwards:
;
;   word 0   total bytes (what the reclaim is told to keep)
;   word 1   document count N
;   word 2   unconsumed reader bytes U
;   word 3   derived-result cache string count K
;   word 4.. K cache-string lengths, then N groups of (uri length,
;            text length, generated-name length, version, open,
;            semantic-token length)
;   then     K cache strings, U bytes of reader input, then each URI,
;            text and both document caches in order
;
; The third entry is the generated-name cache (`docPutGen`):
; it is filled at `didOpen`/`didChange`, which is before the reclaim,
; so it crosses the boundary like the text or the first request after
; every edit answers from an empty one.
(pub :: lspSnapshot (-> Strings Strings Strings Ints Strings Strings Int Int))
(pub fn (lspSnapshot uris texts gens meta highlights cache r)
  {
    (let n (vecLen uris))
    (let k (vecLen cache))
    (let u (- (rdFilled r) (rdConsumed r)))
    {
      (let head (* 8 (+ 4 (+ k (* 6 n)))))
      (let mut total 0)
      {
        (set total (+ head u))
        (for i in 0..k
          (set total (+ total (strLen (vecGet cache i)))))
        (for i in 0..n
          (set total (+ total
                       (+ (strLen (vecGet uris i))
                         (+ (strLen (vecGet texts i))
                           (+ (strLen (lspGenAt gens i)) (strLen (lspHlCacheAt highlights i))))))))
        {
          (let b (memAlloc total))
          (let mut at head)
          {
            (memSetWord b 0 total)
            (memSetWord b 1 n)
            (memSetWord b 2 u)
            (memSetWord b 3 k)
            (for j in 0..k
              {
                (let text (vecGet cache j))
                {
                  (memSetWord b (+ 4 j) (strLen text))
                  (memCopy (+ b at) (strData text) (strLen text))
                  (set at (+ at (strLen text)))
                }
              })
            (for j in 0..n
              {
                (memSetWord b (+ (+ 4 k) (* 6 j)) (strLen (vecGet uris j)))
                (memSetWord b (+ (+ 5 k) (* 6 j)) (strLen (vecGet texts j)))
                (memSetWord b (+ (+ 6 k) (* 6 j)) (strLen (lspGenAt gens j)))
                (memSetWord b (+ (+ 7 k) (* 6 j)) (vecGet meta (* 2 j)))
                (memSetWord b (+ (+ 8 k) (* 6 j)) (vecGet meta (+ 1 (* 2 j))))
                (memSetWord b (+ (+ 9 k) (* 6 j)) (strLen (lspHlCacheAt highlights j)))
              })
            (memCopy (+ b at) (strData (rdPending r)) u)
            (set at (+ at u))
            (for j in 0..n
              {
                (let uu (vecGet uris j))
                (let tt (vecGet texts j))
                (let gg (lspGenAt gens j))
                (let hh (lspHlCacheAt highlights j))
                {
                  (memCopy (+ b at) (strData uu) (strLen uu))
                  (set at (+ at (strLen uu)))
                  (memCopy (+ b at) (strData tt) (strLen tt))
                  (set at (+ at (strLen tt)))
                  (memCopy (+ b at) (strData gg) (strLen gg))
                  (set at (+ at (strLen gg)))
                  (memCopy (+ b at) (strData hh) (strLen hh))
                  (set at (+ at (strLen hh)))
                }
              })
            b
          }
        }
      }
    }
  })

; The cache entry at an index, or the empty cache when `gens` is
; short: a document `didClose`d clears its text but the vectors only
; ever grow, so the third vector lags the first by construction until
; its own writer runs, and the snapshot must not read past its end.
(pub :: lspGenAt (-> Strings Int String))
(pub fn (lspGenAt gens j)
  (if (>= j (vecLen gens))
    "[]"
    (vecGet gens j)))

; Rebuild the store and the reader out of a snapshot the reclaim has
; already moved down to the waterline.
;
; The strings are `strDup`ped out of the block rather than pointed into
; it: a `Str` inside the block has no NUL terminator after it, and
; `strCStr` is what hands a uri to anything outside this module.
; What `lspRestore` rebuilds: every vector the store carries across a
; reset, and the input reader.
(pub struct LspRestored
  (uris : Strings)
  (texts : Strings)
  (reader : Int)
  (gens : Strings)
  (meta : Ints)
  (highlights : Strings)
  (mut cache : Strings)
  (mut queue : Strings)
  (mut work : Strings))

(pub :: lspRestore (-> Int LspRestored))
;@axiom:effect(io)
(pub fn (lspRestore b)
  {
    (let n (memGetWord b 1))
    (let u (memGetWord b 2))
    (let k (memGetWord b 3))
    (let fu vecNew)
    (let ft vecNew)
    (let fg vecNew)
    (let fm vecNew)
    (let fh vecNew)
    (let cached vecNew)
    (let r (rdNew stdin))
    {
      (let mut at (* 8 (+ 4 (+ k (* 6 n)))))
      {
        (for j in 0..k
          {
            (let length (memGetWord b (+ 4 j)))
            {
              (vecPush cached (strDup (strWrap (+ b at) length)))
              (set at (+ at length))
            }
          })
        (rdReseat r (+ b at) u)
        (set at (+ at u))
        (for j in 0..n
          {
            (let ul (memGetWord b (+ (+ 4 k) (* 6 j))))
            (let tl (memGetWord b (+ (+ 5 k) (* 6 j))))
            (let gl (memGetWord b (+ (+ 6 k) (* 6 j))))
            (let hl (memGetWord b (+ (+ 9 k) (* 6 j))))
            {
              (vecPush fm (memGetWord b (+ (+ 7 k) (* 6 j))))
              (vecPush fm (memGetWord b (+ (+ 8 k) (* 6 j))))
              (vecPush fu (strDup (strWrap (+ b at) ul)))
              (set at (+ at ul))
              (vecPush ft (strDup (strWrap (+ b at) tl)))
              (set at (+ at tl))
              (vecPush fg (strDup (strWrap (+ b at) gl)))
              (set at (+ at gl))
              (vecPush fh (strDup (strWrap (+ b at) hl)))
              (set at (+ at hl))
            }
          })
        {
          (let h
            (LspRestored
              :uris fu
              :texts ft
              :reader r
              :gens fg
              :meta fm
              :highlights fh
              :cache vecNew
              :queue vecNew
              :work vecNew))
          {
            (lspRestoreWorkState h cached)
            h
          }
        }
      }
    }
  })

; ------------------------------------------------------------------
; Protocol
; ------------------------------------------------------------------
(pub :: lspSend (-> Int Int))
;@axiom:effect(io)
(pub fn (lspSend obj)
  (rpcWrite stdout (jsonWrite obj)))

; A response carries back the request's `id` NODE, not its integer: LSP
; ids may be strings, and echoing a number where a string was sent is a
; protocol violation the client is entitled to drop the connection over.
(pub :: lspReply (-> Int Int Int))
;@axiom:effect(io)
(pub fn (lspReply id result)
  (lspSend
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "id" id) "result"
      result)))

(pub :: lspError (-> Int Int String Int))
;@axiom:effect(io)
(pub fn (lspError id code msg)
  (lspSend
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "id" id) "error"
      (jsonObjPut (jsonObjPut jsonObj "code" (jsonNum code)) "message" (jsonStr msg)))))

(pub :: lspNotify (-> String Int Int))
;@axiom:effect(io)
(pub fn (lspNotify method params)
  (lspSend
    (jsonObjPut
      (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "method" (jsonStr method))
      "params" params)))

(pub :: lspPublish (-> String Int Int))
;@axiom:effect(io)
(pub fn (lspPublish uri diags)
  (lspNotify "textDocument/publishDiagnostics"
    (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "diagnostics" diags)))

; Incremental synchronisation includes explicit open and close ownership.
;
; `documentSymbolProvider` has to be here, and was not. A conforming
; client reads this object and sends only what it names, so the outline
; - the one feature this server has that is not a diagnostic - was
; answered correctly by `lspDocumentSymbol` and requested by nobody. The
; gate could not see it either: the fixture sends the request
; unconditionally, the way no editor does, so both sides agreed on a
; conversation that cannot happen. A capability is a promise the client
; reads, and an implementation nothing advertises is an implementation
; nothing calls.
(pub :: lspCapabilities (-> Bool Int))
(pub fn (lspCapabilities deferred)
  (jsonObjPut
    (jsonObjPut jsonObj "capabilities"
      (lspHlCaps
        (lspFixCaps
          (lspViewCaps
            (lspNavCaps
              (jsonObjPut
                (jsonObjPut
                  (jsonObjPut
                    (jsonObjPut
                      (jsonObjPut (jsonObjPut jsonObj "positionEncoding" (jsonStr "utf-16"))
                        "textDocumentSync"
                        (jsonObjPut
                          (jsonObjPut (jsonObjPut jsonObj "openClose" (jsonBool 1)) "change"
                            (jsonNum 2))
                          "save" (jsonBool 1)))
                      "documentSymbolProvider" (jsonBool 1))
                    "definitionProvider" (jsonBool 1))
                  "hoverProvider" (jsonBool 1))
                "completionProvider" (lspCompletionOptions deferred)))))))
    "serverInfo"
    (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr "axiom")) "version" (jsonStr "0.7.9"))))

; `definitionProvider` and `hoverProvider` describe the macro
; navigation of MAC-TOOL-2. Both are answered from the raw parse tree,
; so a client that sends them per keystroke costs a parse and no
; expansion (MAC-TOOL-3). `completionProvider` follows the same rule.
; `completionProvider` is an OBJECT where the three beside it are
; booleans, and both of its fields are load-bearing.
;
; Resolution is advertised when the client can resolve both detail
; and documentation. Older clients receive their full eager items.
;
; `triggerCharacters: ["("]` is the language's own shape. A client
; sends an UNPROMPTED completion request only at a character this list
; names, and in a language where every call opens a paren, `(` is the
; moment a name is being reached for. Typing into a word asks anyway.
(pub :: lspCompletionOptions (-> Bool Int))
(pub fn (lspCompletionOptions deferred)
  (jsonObjPut
    (jsonObjPut jsonObj "resolveProvider"
      (jsonBool
        (if deferred
          1
          0)))
    "triggerCharacters" (jsonArrPush jsonArr (jsonStr "("))))

; Dependency discovery continues past a broken sibling. That keeps an
; edit to a later import able to invalidate the document while another
; dependency is being repaired.
(pub :: lspWorkspaceDepends (-> LspWorkspace String String String Bool))
;@axiom:effect(io)
(pub fn (lspWorkspaceDepends workspace path src changed)
  {
    (let todo vecNew)
    (let seen vecNew)
    (let mut at 0)
    (let mut found false)
    (let entryDir (pathDir path))
    (let tcode (checkedTargetCode hostTarget))
    {
      (vecPush todo src)
      (while (&& (! found) (< at (vecLen todo)))
        {
          {
            (let pr (parseModuleWith (lex (vecGet todo at)) (scanAxtags (vecGet todo at))))
            (match pr
              ((ParseFailed parseError10) ())
              ((ParseSuccess parsedValue10 parsedPos10)
                {
                  (let decls parsedValue10)
                  (let mut i 0)
                  (while (&& (! found) (< i (vecLen decls)))
                    {
                      {
                        (let d (vecGet decls i))
                        (if (== (nodeTag d) TAG_D_IMPORT)
                          {
                            (let name (nodeAName d))
                            (if (! (lspSeenHas seen name))
                              {
                                (vecPush seen name)
                                {
                                  (let dependency
                                    (lspWorkspaceModulePath workspace name tcode entryDir))
                                  (if (let (Some dependency) dependency)
                                    (if (strEq (pathClean dependency) (pathClean changed))
                                      (set found true)
                                      {
                                        (let source (lspWorkspaceRead workspace dependency))
                                        (if (let (Some text) source)
                                          (vecPush todo text))
                                      }))
                                }
                              })
                          })
                      }
                      (set i (+ i 1))
                    })
                }
              ))
          }
          (set at (+ at 1))
        })
      found
    }
  })

; The URI a `textDocument`-shaped params object names.
(pub :: lspParamsUri (-> Int String))
(pub fn (lspParamsUri params)
  (jsonGetStr (jsonGet params "textDocument") "uri"))

; The version and open flag occupy two words per URI. Closed documents
; retain their index, and reopening starts a fresh version sequence.
(pub :: lspDocIsOpen (-> Ints Int Bool))
(pub fn (lspDocIsOpen meta i)
  (&& (>= i 0) (&& (< (+ 1 (* 2 i)) (vecLen meta)) (== (vecGet meta (+ 1 (* 2 i))) 1))))

; JSON numbers with a fractional or exponent spelling are not LSP integers.
(pub :: lspSyncInteger (-> Int Bool))
(pub fn (lspSyncInteger value)
  (if (let (Some n) (strParseInt (jsonNumText value)))
    (&& (>= n (- 0 2147483648)) (<= n 2147483647))
    false))

; The raw JSON API represents non-strings as empty text. Inspecting its
; serialised opening byte distinguishes a valid empty string from null.
(pub :: lspSyncString (-> Int Bool))
(pub fn (lspSyncString value)
  {
    (let encoded (jsonWrite value))
    (&& (> (strLen encoded) 0) (== (strByte encoded 0) 34))
  })

(pub :: lspDocOpen (-> Strings Strings Ints Int Bool))
(pub fn (lspDocOpen uris texts meta params)
  {
    (let doc (jsonGet params "textDocument"))
    (let uri (lspParamsUri params))
    (let version (jsonGet doc "version"))
    (let text (jsonGet doc "text"))
    (let i (docFind uris uri))
    (if (|| (== (strLen uri) 0)
          (|| (lspDocIsOpen meta i) (|| (! (lspSyncInteger version)) (! (lspSyncString text)))))
      false
      {
        (docPut uris texts uri (jsonStrVal text))
        {
          (let slot (* 2 (docFind uris uri)))
          {
            (while (<= (vecLen meta) (+ slot 1))
              (vecPush meta 0))
            (vecSet meta slot (jsonInt version))
            (vecSet meta (+ slot 1) 1)
          }
        }
        true
      })
  })

; Edit endpoints must name a line and a whole Unicode scalar. A column
; past the line's content clamps to its end, as Position requires.
; CRLF is one line ending and neither byte belongs to its content.
(pub :: lspSyncOffset (-> String Ints Int (Option Int)))
(pub fn (lspSyncOffset src ix pos)
  {
    (let line (jsonGet pos "line"))
    (let character (jsonGet pos "character"))
    (let ln (jsonInt line))
    (let ch (jsonInt character))
    (if (|| (! (lspSyncInteger line))
          (|| (! (lspSyncInteger character)) (|| (< ln 0) (|| (>= ln (vecLen ix)) (< ch 0)))))
      None
      {
        (let mut i (vecGet ix ln))
        (let mut units 0)
        (let mut valid true)
        (let n (strLen src))
        {
          (while (&& valid
                   (&& (< units ch)
                     (&& (< i n) (&& (!= (strByte src i) 10) (!= (strByte src i) 13)))))
            (if (let (Some cp) (utf8DecodeAt src i))
              {
                (let width
                  (if (>= cp 65536)
                    2
                    1))
                (if (> (+ units width) ch)
                  (set valid false)
                  {
                    (set units (+ units width))
                    (set i (+ i (utf8SeqLen (strByte src i))))
                  })
              }
              {
                (set units (+ units 1))
                (set i (+ i 1))
              }))
          (if valid
            (Some i)
            None)
        }
      })
  })

(pub :: lspSyncRangeOrdered (-> Int Bool))
(pub fn (lspSyncRangeOrdered range)
  {
    (let start (jsonGet range "start"))
    (let end (jsonGet range "end"))
    (let sl (jsonGetInt start "line"))
    (let el (jsonGetInt end "line"))
    (|| (< sl el) (&& (== sl el) (<= (jsonGetInt start "character") (jsonGetInt end "character"))))
  })

(pub :: lspSyncEdit (-> String Int (Option String)))
(pub fn (lspSyncEdit src edit)
  {
    (let text (jsonGet edit "text"))
    (let range (jsonGet edit "range"))
    (if (! (lspSyncString text))
      None
      (if (== range 0)
        (Some (jsonStrVal text))
        {
          (let ix (lspLineIndex src))
          (let start (lspSyncOffset src ix (jsonGet range "start")))
          (let end (lspSyncOffset src ix (jsonGet range "end")))
          (if (let (Some s) start)
            (if (let (Some e) end)
              (if (|| (< e s) (! (lspSyncRangeOrdered range)))
                None
                (Some
                  (concat (strSlice src 0 s)
                    (concat (jsonStrVal text) (strSlice src e (- (strLen src) e))))))
              None)
            None)
        }))
  })

; Each edit is relative to the result of the preceding one. None leaves
; the store untouched; the speculative strings die at the request boundary.
(pub :: lspSyncChanges (-> String Int (Option String)))
(pub fn (lspSyncChanges src changes)
  {
    (let mut text src)
    (let mut i 0)
    (let mut valid true)
    {
      (while (&& valid (< i (jsonArrLen changes)))
        {
          (if (let (Some next) (lspSyncEdit text (jsonArrGet changes i)))
            (set text next)
            (set valid false))
          (set i (+ i 1))
        })
      (if valid
        (Some text)
        None)
    }
  })

(pub :: lspDocChange (-> Strings Strings Ints Int Bool))
(pub fn (lspDocChange uris texts meta params)
  {
    (let uri (lspParamsUri params))
    (let i (docFind uris uri))
    (let version (jsonGet (jsonGet params "textDocument") "version"))
    (let changes (jsonGet params "contentChanges"))
    (if (! (lspDocIsOpen meta i))
      false
      (if (|| (! (lspSyncInteger version)) (<= (jsonInt version) (vecGet meta (* 2 i))))
        false
        ; An empty array advances the version without changing the text.
        ; Other JSON kinds cannot stand in for that array.
        (if (! (strStartsWith (jsonWrite changes) "["))
          false
          (if (let (Some before) (docText uris texts uri))
            (if (let (Some text) (lspSyncChanges before changes))
              {
                (docPut uris texts uri text)
                (vecSet meta (* 2 i) (jsonInt version))
                true
              }
              false)
            false))))
  })

(pub :: lspDocClose (-> Strings Strings Strings Ints String Bool))
(pub fn (lspDocClose uris texts gens meta uri)
  {
    (let i (docFind uris uri))
    (if (! (lspDocIsOpen meta i))
      false
      {
        (docPut uris texts uri "")
        (docPutGen uris gens uri "[]")
        (vecSet meta (+ 1 (* 2 i)) 0)
        true
      })
  })

(pub :: lspPublishVersion (-> String Int Int Int))
;@axiom:effect(io)
(pub fn (lspPublishVersion uri version diags)
  (lspNotify "textDocument/publishDiagnostics"
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "version" (jsonNum version))
      "diagnostics" diags)))

; ------------------------------------------------------------------
; The extension door
;
; Four sections follow, each owning a set of requests and nothing
; else: NAVIGATION (references, rename, highlights, the local-binding
; half of definition), VIEWS (signature help, inlay hints, folding,
; selection ranges, document links, workspace symbols), FIXES
; (formatting, code actions, macro expansion, code lenses, type
; definition, diagnostics for imported modules) and HIGHLIGHTING
; (semantic tokens). Each section answers
; three questions in the same shape - does it handle `method`, what
; does it reply, and what does it advertise - and `lspExtHandles` /
; `lspExtDispatch` / `lspCapabilities` ask all three in a fixed order.
; A method two sections both claimed would be answered by the first;
; none does, and the gate's per-method checks would say so.
; ------------------------------------------------------------------
(pub :: lspExtHandles (-> String Bool))
(pub fn (lspExtHandles method)
  (|| (lspNavHandles method)
    (|| (lspViewHandles method) (|| (lspFixHandles method) (lspHlHandles method)))))

(pub :: lspExtDispatch (-> LspWorkspace String Int Int Strings Strings Strings Strings String))
;@axiom:effect(io)
(pub fn (lspExtDispatch workspace method id params uris texts gens highlights)
  (if (lspNavHandles method)
    (lspNavDispatch workspace method id params uris texts gens)
    (if (lspViewHandles method)
      (lspViewDispatch workspace method id params uris texts)
      (if (lspFixHandles method)
        (lspFixDispatch workspace method id params uris texts)
        (lspHlDispatch method id params uris texts highlights)))))

; ==================================================================
; SECTION NAV: references, rename, document highlights, local
; bindings, declarations, call hierarchy
; ==================================================================
; WHAT THIS SECTION KNOWS that the four original questions do not: what
; a NAME REFERS TO. `definition` and `hover` answered from the
; declaration list alone, so a `let` binder, a `fn` parameter, a
; `lambda` parameter and a pattern variable were "nothing here", and
; two functions that each bind an `i` were one name. Everything below
; is a projection of ONE walk over the raw parse tree - expanding
; nothing, MAC-TOOL-3's rule - that records every OCCURRENCE of a name
; together with the KEY of the binding it resolves to, following the
; language's own scoping: the innermost local scope first, then this
; document's top-level declarations, then "not this document's".
;
; A KEY names a binding uniquely within one document:
;
;   @<offset>       a local binder anchored at that byte - a `let`
;                   name, a recovered parameter, a pattern variable
;   ~<node>:<name>  a local binder with NO anchor (see
;                   `lspHeaderParamSpans` for how one arises); it still
;                   resolves references, and is not renamable
;   <name>          a top-level declaration of this document; a `fn`
;                   and its `::` signature share one
;   <data>#<ctor>   a constructor, keyed by the `data` that declares it
;   ?<bare>         a name this document does not declare - imported,
;                   or a builtin
;   !<name>         an effect named by `handle`
;
; Two occurrences are the same name iff their keys are equal, which is
; the whole of what `references`, `documentHighlight`, `prepareRename`
; and `rename` ask.
;
; TWO MORE QUESTIONS ARE PROJECTIONS OF THE SAME WALK, and they sit at
; the end of this section rather than beside `definition` because they
; need what it knows. `textDocument/declaration` answers the `(:: f
; T)` where `definition` answers the `(fn (f x) ...)` - a distinction
; this language HAS and most do not - and asks the walk first, because
; a local is declared by being bound. The three call-hierarchy
; requests intersect this walk's occurrences with the head positions
; `lspChHeads` finds in the bytes: an occurrence that resolved to a
; top-level name AND stands first inside a `(` is a call, which is why
; `(fn (apply k v) (k v))` reports no edge to a top-level `k` and
; `(fn (handoff z) helper)` is not one of `helper`'s callers.
;
; WHAT IT COSTS: one parse, one line index, one walk that is linear in
; the tree. Resolution is a scope STACK - a Vec of (name, key) pairs
; pushed and popped as the walk descends - so a reference costs its
; depth, and the top-level table is a bucket index keyed by
; `fnIdxHash` rather than `lspFindDecl`'s scan, so it costs one bucket
; and not the declaration list. The cross-file half of `references`
; and `rename` parses every OTHER open document once, which is the
; only way to know whether it imports this one; nothing is read from
; disk for a reference search - the store is the workspace.
;
; TYPE POSITIONS ARE READ FROM THE BYTES. A type node carries no span
; (`parseType` builds them spanless), so the `Shape` in `(:: area (->
; Shape Int))`, in a constructor's fields, in a struct field, an alias
; or an impl head is not a place in the tree - and the first version
; of this walk left them out, so `rename` on a `data` rewrote its
; declaration and nothing else and the program stopped checking
; (measured: AX3002 at every signature that named it). The identifiers
; of a declaration's form are read back from the document instead,
; and every one that is not the declaration's own name, a
; constructor, a field name, a type variable or the arrow is a TYPE
; reference - resolved against the TYPE table alone (word 6), because
; types and values are different namespaces and a `fn` spelled like a
; `data` must not be renamed with it.
;
; NOT WALKED, and why: a macro's TEMPLATE, whose identifiers are
; pattern variables and gensym-renamed binders rather than scoped
; code; a `syntax/for` declaration and an `extern` block, for the same
; reason the outline leaves them out (an extern names builtin types
; alone); and the type inside an `alloc` or a `cast` expression, whose
; form the tree does not anchor. A reference to a top-level name from
; inside a macro template is therefore not renamed with the rest - a
; rename of such a name still answers, and the template keeps the old
; spelling, which the expander then reports as an undefined name.
; ------------------------------------------------------------------
; `==` compares Ints, so a Bool is negated by naming it.
(pub :: lspNavNot (-> Bool Bool))
(pub fn (lspNavNot b)
  (if b
    false
    true))

; The roles an occurrence can play.
(pub :: NAV_READ Int)
(pub fn (NAV_READ)
  0)

(pub :: NAV_WRITE Int)
(pub fn (NAV_WRITE)
  1)

(pub :: NAV_BINDER Int)
(pub fn (NAV_BINDER)
  2)

(pub :: NAV_DECL Int)
(pub fn (NAV_DECL)
  3)

(pub :: NAV_DECL_SIG Int)
(pub fn (NAV_DECL_SIG)
  4)

; What kind of binder a BINDER occurrence is, which is what hover
; says about it.
(pub :: NAV_B_PARAM Int)
(pub fn (NAV_B_PARAM)
  1)

(pub :: NAV_B_LET Int)
(pub fn (NAV_B_LET)
  2)

(pub :: NAV_B_LAMBDA Int)
(pub fn (NAV_B_LAMBDA)
  3)

(pub :: NAV_B_PATTERN Int)
(pub fn (NAV_B_PATTERN)
  4)

; ------------------------------------------------------------------
; An occurrence:
;
;   name   as the reference spells it - the BARE name for a qualified
;          `Mod::name`
;   span   the identifier's own byte span; 0 for none
;   role   NAV_READ .. NAV_DECL_SIG
;   key    see the section header
;   bkind  binder kind (NAV_B_*), 0 for anything but a binder
;   owner  the top-level declaration the occurrence sits in
;   param  parameter index, for a `fn` parameter
;   value  the bound expression for a `let` binder, or None
; ------------------------------------------------------------------
(pub struct LspOcc
  (name : String)
  (span : Int)
  (role : Int)
  (key : String)
  (bkind : Int)
  (owner : String)
  (param : Int)
  (value : (Option ASTNode)))

; The walk's context:
;
;   src    the document's text
;   occs   the occurrences being filled, in source order
;   scope  the scope stack: (name, key) pairs pushed FLAT, so the
;          innermost binding is the last pair
;   top    the top-level table (`lspNavTopBuild`)
;   probe  a rename collision probe (`lspNavProbe`), or `None`
;   owner  the name of the declaration being walked
;   types  the type table (`lspNavTypeBuild`): the names a type
;          position can resolve to
(pub struct LspNav
  (src : String)
  (occs : (Vec LspOcc))
  (scope : Strings)
  (top : LspTopBuckets)
  (probe : (Option LspNavProbe))
  (mut owner : String)
  (types : LspTopBuckets))

(pub :: lspNavOccurrences (-> String (Vec ASTNode) (Vec LspOcc)))
(pub fn (lspNavOccurrences src decls)
  (lspNavOccurrencesProbe src decls None))

(pub :: lspNavOccurrencesProbe (-> String (Vec ASTNode) (Option LspNavProbe) (Vec LspOcc)))
(pub fn (lspNavOccurrencesProbe src decls probe)
  {
    (let nv (lspNavContext src decls probe))
    {
      (for d in decls
        (lspNavWalkDecl nv d))
      nv.occs
    }
  })

(pub :: lspNavContext (-> String (Vec ASTNode) (Option LspNavProbe) LspNav))
(pub fn (lspNavContext src decls probe)
  (LspNav
    :src src
    :occs vecNew
    :scope vecNew
    :top (lspNavTopBuild decls)
    :probe probe
    :owner ""
    :types (lspNavTypeBuild decls)))

; ------------------------------------------------------------------
; The local-binding index, for the sections that ask one question of
; the walk: does the name at this byte resolve to a LOCAL? Signature
; help and parameter hints look a call's head up by its bare spelling,
; and a head that is a parameter or a `let` spelled like a declared
; `fn` - `(fn (apply k v) (k v))` beside a top-level `k` - must answer
; nothing, since the call is not to that `fn`. Measured before this
; existed: `(fn (t7 f) (f 1 2))` answered the top-level `f`'s signature
; and labelled its arguments with `f`'s parameters.
;
; Only the declarations whose EXTENT meets [rs, re) are walked - the
; extent being the name's start to the next declaration's, the same
; bound the hint request uses - so a request for the visible window
; pays for the window and not for the file. Answers a bucket table of
; byte offsets: every occurrence in those declarations whose key is
; local, keyed by its start.
; ------------------------------------------------------------------
(pub :: lspNavLocalIndex (-> String (Vec ASTNode) Int Int LspBuckets))
(pub fn (lspNavLocalIndex src decls rs re)
  {
    (let nv (lspNavContext src decls None))
    (let n (vecLen decls))
    {
      (for i in 0..n
        (if (lspNavDeclMeets decls i (strLen src) rs re)
          (lspNavWalkDecl nv (vecGet decls i))))
      (lspNavLocalStarts nv.occs)
    }
  })

; Whether declaration `i`'s extent - its name's start to the next
; spanned declaration's start, or EOF - meets [rs, re). A declaration
; with no span has no extent and is walked regardless, which costs
; nothing: it is an empty form or a marker.
(pub :: lspNavDeclMeets (-> (Vec ASTNode) Int Int Int Int Bool))
(pub fn (lspNavDeclMeets decls i n rs re)
  {
    (let d (vecGet decls i))
    (if (== (nodeSpan d) 0)
      true
      {
        (let lo (spanStart (nodeSpan d)))
        (let mut j (+ i 1))
        (let mut hi n)
        {
          (while (if (< j (vecLen decls))
            (== hi n)
            false)
            {
              (if (!= (nodeSpan (vecGet decls j)) 0)
                (set hi (spanStart (nodeSpan (vecGet decls j)))))
              (set j (+ j 1))
            })
          (&& (< lo re) (> hi rs))
        }
      })
  })

; The bucket table: `fnIdxBuckets` slots, each holding the byte offsets
; that hash there when a bucket has been allocated.
(pub :: lspNavLocalStarts (-> (Vec LspOcc) LspBuckets))
(pub fn (lspNavLocalStarts occs)
  {
    (let nb (fnIdxBuckets (vecLen occs)))
    (let bs (lspBucketsNew nb))
    {
      (for o in occs
        (if (&& (!= o.span 0) (lspNavIsLocal o.key))
          (lspNavIntPut bs (spanStart o.span))))
      bs
    }
  })

(pub :: lspNavIntPut (-> LspBuckets Int Int))
(pub fn (lspNavIntPut bs v)
  {
    (vecPush (lspBucketFor bs (% v (vecLen bs))) v)
    0
  })

(pub :: lspNavLocalIndexHas (-> LspBuckets Int Bool))
(pub fn (lspNavLocalIndexHas bs off)
  (if (== (vecLen bs) 0)
    false
    (if (let (Some bucket) (vecGet bs (% off (vecLen bs))))
      {
        (let mut found false)
        (for value in bucket
          (if (== value off)
            (set found true)))
        found
      }
      false)))

(pub :: lspNavEmit (-> LspNav String Int Int String Int Int Int))
(pub fn (lspNavEmit nv name span role key bkind idx)
  (lspNavEmitValue nv name span role key bkind idx None))

(:: lspNavEmitValue (-> LspNav String Int Int String Int Int (Option ASTNode) Int))
(fn (lspNavEmitValue nv name span role key bkind idx value)
  {
    (vecPush nv.occs
      (LspOcc
        :name name
        :span span
        :role role
        :key key
        :bkind bkind
        :owner nv.owner
        :param idx
        :value value))
    (lspNavProbeAt nv name key)
    0
  })

; ------------------------------------------------------------------
; The top-level table: this document's declared names, each mapped to
; its key, LAST WINS - `lspFindDecl`'s rule, over `lspFindDecl`'s
; kinds plus `type` aliases and the constructors a `data` declares,
; because a constructor is a name that gets written and resolved.
;
; A bucket index rather than a scan: the walk asks this question once
; per reference, and `lspFindDecl` per reference is the declaration
; list squared, which on this repository's own `typecheck.ax` is
; twenty thousand references against two thousand declarations.
; ------------------------------------------------------------------
(pub :: lspNavDeclares (-> Int Bool))
(pub fn (lspNavDeclares tag)
  ; A `subtype` is a name a VALUE position can spell - `(cast
  ; Positive 5)` - so its uses resolve to the declaration rather than
  ; to `?Positive`, exactly as an alias's do. The outline is a
  ; separate question and still does not list one.
  (|| (lspWantsSymbol tag) (|| (== tag TAG_D_ALIAS) (== tag TAG_D_SUBTYPE))))

(pub :: lspNavTopBuild (-> (Vec ASTNode) LspTopBuckets))
(pub fn (lspNavTopBuild decls)
  {
    (let nb (fnIdxBuckets (vecLen decls)))
    (let bs (lspBucketsNew nb))
    {
      (for d in decls
        (if (lspNavIsNamedDecl d)
          {
            (lspNavTopPut bs (nodeAName d) (nodeAName d))
            (if (== (nodeTag d) TAG_D_DATA)
              (lspNavTopPutCtors bs (nodeAName d) (nodeBChildren d) 0))
          }))
      bs
    }
  })

; A declaration the outline would list under its own name: one of the
; kinds, with a span, and not a `(syntax/join ...)` marker - a marker
; is a spelling no reference can write.
(pub :: lspNavIsNamedDecl (-> ASTNode Bool))
(pub fn (lspNavIsNamedDecl d)
  (&& (lspNavDeclares (nodeTag d)) (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0))))

(pub :: lspNavTopPutCtors (-> LspTopBuckets String (Vec ASTNode) Int Int))
(pub fn (lspNavTopPutCtors bs dat ctors i)
  (if (>= i (vecLen ctors))
    0
    {
      (let c (vecGet ctors i))
      {
        (if (!= (nodeSpan c) 0)
          (lspNavTopPut bs (nodeAName c) (lspNavCtorKey dat (nodeAName c))))
        (lspNavTopPutCtors bs dat ctors (+ i 1))
      }
    }))

(pub :: lspNavCtorKey (-> String String String))
(pub fn (lspNavCtorKey dat ctor)
  (concat dat (concat "#" ctor)))

; The TYPE table: the `data`, `struct` and `type` names this document
; declares, each keyed by itself - the same key the declaration's own
; occurrence carries, so a type position and the declaration it names
; are one name. Kept apart from the table above because a type
; position must never resolve to a `fn`.
(pub :: lspNavTypeBuild (-> (Vec ASTNode) LspTopBuckets))
(pub fn (lspNavTypeBuild decls)
  {
    (let nb (fnIdxBuckets (vecLen decls)))
    (let bs (lspBucketsNew nb))
    {
      (for d in decls
        (if (&& (lspNavIsTypeTag (nodeTag d))
              (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0)))
          (lspNavTopPut bs (nodeAName d) (nodeAName d))))
      bs
    }
  })

(pub :: lspNavIsTypeTag (-> Int Bool))
(pub fn (lspNavIsTypeTag tag)
  (|| (== tag TAG_D_DATA)
    (|| (== tag TAG_D_STRUCT) (|| (== tag TAG_D_ALIAS) (== tag TAG_D_SUBTYPE)))))

; A slot owns its entries after the first declaration is inserted.
(pub :: lspNavTopPut (-> LspTopBuckets String String Int))
(pub fn (lspNavTopPut bs name key)
  {
    (let bucket (lspBucketFor bs (% (fnIdxHash name) (vecLen bs))))
    (let at (lspNavTopSlot bucket name 0))
    (if (< at 0)
      (vecPush bucket (LspTopEntry :name name :key key))
      {
        (let entry (vecGet bucket at))
        (set entry.key key)
      })
    0
  })

(pub :: lspNavTopSlot (-> (Vec LspTopEntry) String Int Int))
(pub fn (lspNavTopSlot v name k)
  (if (>= k (vecLen v))
    (- 0 1)
    {
      (let entry (vecGet v k))
      (if (strEq entry.name name)
        k
        (lspNavTopSlot v name (+ k 1)))
    }))

; The key `name` is declared under, or "" when this document does not
; declare it.
(pub :: lspNavTopGet (-> LspTopBuckets String String))
(pub fn (lspNavTopGet bs name)
  (if (== (vecLen bs) 0)
    ""
    (if (let (Some bucket) (vecGet bs (% (fnIdxHash name) (vecLen bs))))
      {
        (let at (lspNavTopSlot bucket name 0))
        (if (< at 0)
          ""
          {
            (let entry (vecGet bucket at))
            entry.key
          })
      }
      "")))

; ------------------------------------------------------------------
; The scope stack.
; ------------------------------------------------------------------
(pub :: lspNavPush (-> LspNav String String Int))
(pub fn (lspNavPush nv name key)
  {
    (let scope nv.scope)
    {
      (vecPush scope name)
      (vecPush scope key)
      0
    }
  })

(pub :: lspNavPopN (-> LspNav Int Int))
(pub fn (lspNavPopN nv k)
  {
    (let scope nv.scope)
    {
      (for i in 0..k
        {
          (vecPop scope)
          (vecPop scope)
        })
      0
    }
  })

; The key the innermost binding of `name` carries, or "".
(pub :: lspNavScopeFind (-> Strings String String))
(pub fn (lspNavScopeFind scope name)
  {
    (let mut i (- (vecLen scope) 2))
    (let mut k "")
    {
      (while (>= i 0)
        (if (strEq (vecGetStr scope i) name)
          {
            (set k (vecGetStr scope (+ i 1)))
            (set i (- 0 2))
          }
          (set i (- i 2))))
      k
    }
  })

(pub :: lspNavScopeHasKey (-> Strings String Bool))
(pub fn (lspNavScopeHasKey scope key)
  {
    (let mut i (- (vecLen scope) 1))
    (let mut found false)
    {
      (while (>= i 1)
        (if (strEq (vecGetStr scope i) key)
          {
            (set found true)
            (set i (- 0 2))
          }
          (set i (- i 2))))
      found
    }
  })

; What `name` refers to where the walk currently stands: the innermost
; local, else this document's declaration, else nothing this document
; declares. A qualified `Mod::name` arrives as `Mod$name` and can be
; neither a local nor a declaration here, so it falls through to the
; last case under its bare name - which is also where an unqualified
; reference to the same imported name lands, so the two are the same
; name, as they are to the compiler.
(pub :: lspNavResolve (-> LspNav String String))
(pub fn (lspNavResolve nv name)
  {
    (let k (lspNavScopeFind nv.scope name))
    (if (!= (strLen k) 0)
      k
      {
        (let t (lspNavTopGet nv.top name))
        (if (!= (strLen t) 0)
          t
          (concat "?" (bareOf name)))
      })
  })

; ------------------------------------------------------------------
; The rename collision probe.
;
; A rename of a LOCAL is refused when the new spelling would change
; what any name in the binding's scope refers to, and the only place
; that can be decided is inside the walk, where the scope stack is
; live. So `rename` walks a second time with a probe - (new name, the
; key being renamed, hit) - and every emission asks two questions:
;
;   * this occurrence IS the binding being renamed, and the new name
;     is already bound around it - by an enclosing local, or by a
;     top-level declaration the renamed local would then shadow;
;   * this occurrence SPELLS the new name and sits inside the renamed
;     binding's scope, so the rename would capture it.
;
; Either is a hit, and a hit is a null answer. The declaration-level
; half of the same question needs no probe: `lspNavNamed` scans the
; occurrences once.
; ------------------------------------------------------------------
(pub struct LspNavProbe
  (newName : String)
  (key : String)
  (mut hit : Int))

(pub :: lspNavProbe (-> String String LspNavProbe))
(pub fn (lspNavProbe newName key)
  (LspNavProbe :newName newName :key key :hit 0))

(pub :: lspNavProbeAt (-> LspNav String String ()))
(pub fn (lspNavProbeAt nv name key)
  (if (let (Some p) nv.probe)
    {
      (let newName p.newName)
      (let k p.key)
      (let scope nv.scope)
      (if (strEq key k)
        (if (|| (!= (strLen (lspNavScopeFind scope newName)) 0)
              (!= (strLen (lspNavTopGet nv.top newName)) 0))
          (set p.hit 1))
        (if (&& (strEq name newName) (lspNavScopeHasKey scope k))
          (set p.hit 1)))
    }
    ()))

; ------------------------------------------------------------------
; Binders.
;
; A binder with a span is keyed by it - the byte a name is bound at is
; unique in the document - and emitted as an occurrence, so it can be
; found under a cursor, highlighted and renamed. A binder without one
; is keyed by its node and its name, which is unique too, and is not
; emitted: it resolves the references beneath it, and there is nothing
; for an editor to point at.
; ------------------------------------------------------------------
(pub :: lspNavBinderKey (-> String Int ASTNode String))
(pub fn (lspNavBinderKey name span node)
  (if (!= span 0)
    (concat "@" (fmtInt (spanStart span)))
    (concat "~" (concat (nodeIdentityKey node) (concat ":" name)))))

(pub :: lspNavEmitBinder (-> LspNav String Int String Int Int Int))
(pub fn (lspNavEmitBinder nv name span key bkind idx)
  (lspNavEmitBinderValue nv name span key bkind idx None))

(:: lspNavEmitBinderValue (-> LspNav String Int String Int Int (Option ASTNode) Int))
(fn (lspNavEmitBinderValue nv name span key bkind idx value)
  (if (|| (== span 0) (|| (strEq name "_") (isSome (strFindByte name 36 0))))
    0
    (lspNavEmitValue nv name span NAV_BINDER key bkind idx value)))

; A name the user CANNOT have written is a desugaring's, and it has no
; occurrence: `$` is AX1001 inside an identifier, so a binder holding
; one - `for$v`, `for$i`, `for$n`, `for$lo`, which `parseForExpr`
; binds around a loop with the KEYWORD's span - was never in the
; document. Emitted, it sat on the word `for`: measured before this
; guard, `prepareRename` at the keyword answered the placeholder
; `for$v`, and applying it would have rewritten the keyword's bytes.
; The binder is still PUSHED on the scope stack by its walker, so the
; desugaring's own reads resolve as they did; those reads are dropped
; by `lspNavRef` under the rule below.
;
; The same question for a REFERENCE cannot be asked of the name alone,
; because a user's `Vec::vecLen` reaches here as `Vec$vecLen` too. It
; is asked of the BYTES: a qualified reference the user wrote has its
; last segment in the document at the span `lspNavQualSpan` finds, and
; a reference the parser made up does not - `Vec$vecLen` and `for$v`
; sit on `for`, or on the container expression `(for x in XS body)` reads
; its length from. A macro template's free identifier rewritten to
; `IO$writeStr` (MAC-HYG-7, `println`'s `writeStr`) keeps its own span,
; which spells `writeStr`, so it stays.
(pub :: lspNavSpells (-> String Int String Bool))
(pub fn (lspNavSpells src sp name)
  (if (== sp 0)
    true
    (strEq (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))) name)))

; ------------------------------------------------------------------
; Parameter spans, recovered from the BYTES.
;
; The parser records a `fn`'s parameters and a `lambda`'s as bare
; Strings - `nodeB` of TAG_D_FN, `nodeA` of TAG_E_LAM - with no span,
; because nothing in the compiler ever reports a diagnostic AT a
; parameter name. The document still has them: a `fn` header is
; `(name p1 p2 ...)` and the node's span is the name's token, so the
; parameters are the identifiers between the name and the header's
; `)`; a `lambda`'s span is its keyword, and the parameter list `(p1
; p2)` is the form after it. This reads them, in order, skipping
; whitespace and comments, and stops at the first byte that is neither
; an identifier nor blank.
;
; The count is CHECKED against the tree by every caller: a header the
; scan reads differently from the parser - a `(syntax/join ...)` name,
; a form mid-edit - yields the wrong number of spans, and the
; parameters are then treated as having none rather than being
; anchored at bytes that belong to something else. A parameter with no
; anchor still resolves its references; it is not renamable and not
; highlightable, which is the honest answer to "where is it bound".
; ------------------------------------------------------------------
(pub :: lspHeaderParamSpans (-> String Int Ints))
(pub fn (lspHeaderParamSpans src from)
  {
    (let n (strLen src))
    (let out vecNew)
    (let mut i (lspNavSkipBlank src from n))
    (let mut go 1)
    {
      (if (&& (< i n) (== (strByte src i) 40))
        (set i (lspNavSkipBlank src (+ i 1) n)))
      (while (== go 1)
        (if (>= i n)
          (set go 0)
          (if (isIdentStart (strByte src i))
            {
              (let e (skipIdent src (+ i 1) n))
              {
                (vecPush out (mkSpan i e))
                (set i (lspNavSkipBlank src e n))
              }
            }
            (set go 0))))
      out
    }
  })

; Past whitespace, `;` comments and `#| |#` blocks - the same three
; the lexer skips between tokens, asked of the lexer's own helpers.
(pub :: lspNavSkipBlank (-> String Int Int Int))
(pub fn (lspNavSkipBlank src i n)
  {
    (let mut k i)
    (let mut go 1)
    {
      (while (== go 1)
        (if (>= k n)
          (set go 0)
          {
            (let b (strByte src k))
            (if (lspIsSpace b)
              (set k (+ k 1))
              (if (== b 59)
                (set k (findNewline src k n))
                (if (&& (== b 35) (isBlockOpen src k n))
                  (set k (skipBlockComment src (+ k 2) n))
                  (set go 0))))
          }))
      k
    }
  })

; The span of the LAST segment of a qualified reference. The parser
; gives `Mod::name` - and `Sys.Platform::sysReadNum` - the span of its
; first token, which is the module; the name a reader is looking at is
; the segment after the last `::`, and that is what an occurrence
; should cover. Read forward from the first segment through `.` and
; `::` runs; anything else ends the chain, and a chain with no `::`
; keeps the span it was given.
(pub :: lspNavQualSpan (-> String Int Int))
(pub fn (lspNavQualSpan src sp)
  {
    (let n (strLen src))
    (let mut i (spanEnd sp))
    (let mut last sp)
    (let mut go 1)
    {
      (while (== go 1)
        (if (>= (+ i 2) n)
          (set go 0)
          (if (&& (== (strByte src i) 58)
                (&& (== (strByte src (+ i 1)) 58) (isIdentStart (strByte src (+ i 2)))))
            {
              (let e (skipIdent src (+ i 3) n))
              {
                (set last (mkSpan (+ i 2) e))
                (set i e)
              }
            }
            (if (&& (== (strByte src i) 46) (isIdentStart (strByte src (+ i 1))))
              (set i (skipIdent src (+ i 2) n))
              (set go 0)))))
      last
    }
  })

; ------------------------------------------------------------------
; The walk: declarations.
; ------------------------------------------------------------------
(pub :: lspNavWalkDecl (-> LspNav ASTNode Int))
(pub fn (lspNavWalkDecl nv d)
  {
    (let tag (nodeTag d))
    {
      ; Every top-level tag keeps a String in word 1 - a name, a
      ; module path, a binder - so the owner is readable whatever
      ; the declaration is.
      (set nv.owner (nodeAName d))
      (if (== tag TAG_D_FN)
        (lspNavWalkFn nv d)
        (if (== tag TAG_D_SIG)
          {
            (lspNavDeclName nv d NAV_DECL_SIG)
            (lspNavTypesSig nv d)
          }
          (if (== tag TAG_D_DATA)
            {
              (lspNavDeclName nv d NAV_DECL)
              (lspNavTypesData nv d)
            }
            (if (== tag TAG_D_STRUCT)
              {
                (lspNavDeclName nv d NAV_DECL)
                (lspNavTypesStruct nv d)
              }
              (if (== tag TAG_D_ALIAS)
                {
                  (lspNavDeclName nv d NAV_DECL)
                  (lspNavTypesAlias nv d)
                }
                (if (== tag TAG_D_SUBTYPE)
                  {
                    (lspNavDeclName nv d NAV_DECL)
                    (lspNavTypesSubtype nv d)
                  }
                  (if (== tag TAG_D_MACRO)
                    (lspNavDeclName nv d NAV_DECL)
                    (if (== tag TAG_D_MACROCALL)
                      ; An invocation is a REFERENCE to the macro
                      ; (MAC-TOOL-2), and its arguments are read as
                      ; expressions at top level: `(deriveTag Colour)`
                      ; names the `data` it derives for.
                      {
                        (lspNavRef nv (nodeAName d) (nodeSpan d) NAV_READ)
                        (lspNavWalkVec nv (nodeBChildren d))
                      }
                      0))))))))
    }
  })

; ------------------------------------------------------------------
; Type positions, from the bytes.
;
; The identifiers of a declaration's form after its name, each one
; asked what the PARSER would have read it as: a constructor (its
; span is the constructor node's), a field name (the next byte is a
; single `:`), a method name (`::`), a type variable (spelled in the
; declaration's own list), the `mut` marker of a struct field, the
; `=` and the `where` the alias and trait forms dispatch on - and
; everything else is a type reference. `->`, `*`, `*mut` and `_`
; are the type grammar's own punctuation and name nothing.
; ------------------------------------------------------------------
; Every identifier in [from, to) as a Vec of spans, stepping over
; strings, char literals and comments with the lexer's own skips -
; `lspFormEnd`'s scanner, collecting instead of counting.
(pub :: lspNavIdents (-> String Int Int Ints))
(pub fn (lspNavIdents src from to)
  {
    (let n (strLen src))
    (let out vecNew)
    (let mut i from)
    {
      (while (< i to)
        {
          (let ch (strByte src i))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              {
                (let e (skipIdent src (+ i 1) n))
                {
                  (vecPush out (mkSpan i e))
                  (set i e)
                }
              }
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    (set i (+ i 1)))))))
        })
      out
    }
  })

; One past the `)` closing the declaration's own form.
(pub :: lspNavDeclEnd (-> String ASTNode Int))
(pub fn (lspNavDeclEnd src d)
  (lspFormEnd src (lspFormStart src (spanStart (nodeSpan d)))))

(pub :: lspNavSpanText (-> String Int String))
(pub fn (lspNavSpanText src sp)
  (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))

; Whether the first non-blank byte after `sp` is a single `:` - what
; makes the identifier before it a field name - rather than a `::`.
(pub :: lspNavColonAfter (-> String Int Bool))
(pub fn (lspNavColonAfter src sp)
  {
    (let n (strLen src))
    (let k (lspNavSkipBlank src (spanEnd sp) (strLen src)))
    (if (>= k n)
      false
      (if (!= (strByte src k) 58)
        false
        {
          (let second
            (if (< (+ k 1) n)
              (== (strByte src (+ k 1)) 58)
              false))
          (lspNavNot second)
        }))
  })

; The type grammar's punctuation: the arrow, the pointer markers and
; the wildcard spell no type.
(pub :: lspNavIsTypeWord (-> String Bool))
(pub fn (lspNavIsTypeWord name)
  (if (== (strLen name) 0)
    false
    (if (|| (== (strByte name 0) 42) (== (strByte name 0) 45))
      false
      (lspNavNot (strEq name "_")))))

; A type reference, under the type table's key or `?name` for a type
; this document does not declare - `Int`, an imported `data`.
(pub :: lspNavTypeRef (-> LspNav String Int Int))
(pub fn (lspNavTypeRef nv name sp)
  (if (lspNavIsTypeWord name)
    {
      (let t (lspNavTopGet nv.types name))
      (lspNavEmit nv name sp NAV_READ
        (if (!= (strLen t) 0)
          t
          (concat "?" name))
        0 0)
    }
    0))

; Every span from `i` on as a type reference, except the spellings in
; `tvs` (0 for none).
(pub :: lspNavTypeRefs (-> LspNav Ints Names Int Int))
(pub fn (lspNavTypeRefs nv spans tvs i)
  (if (>= i (vecLen spans))
    0
    {
      (let sp (vecGet spans i))
      {
        (let name (lspNavSpanText nv.src sp))
        {
          (if (! (lspNavIsTyvar tvs name))
            (lspNavTypeRef nv name sp))
          (lspNavTypeRefs nv spans tvs (+ i 1))
        }
      }
    }))

(pub :: lspNavIsTyvar (-> Names String Bool))
(pub fn (lspNavIsTyvar tvs name)
  (if (== (as tvs Int) 0)
    false
    (!= (strVecHas tvs name) 0)))

; `(:: name TYPE)`: everything after the name is the type.
(pub :: lspNavTypesSig (-> LspNav ASTNode Int))
;@axiom:effect(unsafe)
(pub fn (lspNavTypesSig nv d)
  (if (== (nodeSpan d) 0)
    0
    {
      (let src nv.src)
      (lspNavTypeRefs nv (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d))
        (as 0 Names) 0)
    }))

; `(data Name (a) (Ctor T...) (Ctor { f : T }))`: the constructors are
; matched to their nodes by span and emitted as declarations in the
; order the source has them - which keeps the occurrence list in
; offset order - a field name is skipped, a type variable is skipped,
; and the rest name types.
(pub :: lspNavTypesData (-> LspNav ASTNode Int))
(pub fn (lspNavTypesData nv d)
  (if (== (nodeSpan d) 0)
    0
    {
      (let src nv.src)
      (let ctors (nodeBChildren d))
      (let tvs (nodeTyNames d))
      (let mut ci 0)
      {
        (let spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d)))
        {
          (for sp in spans
            {
              ; A constructor whose span is 0 or already behind
              ; this identifier cannot be matched; step past it.
              (while (if (< ci (vecLen ctors))
                (if (== (nodeSpan (vecGet ctors ci)) 0)
                  true
                  (< (spanStart (nodeSpan (vecGet ctors ci))) (spanStart sp)))
                false)
                (set ci (+ ci 1)))
              (if (if (< ci (vecLen ctors))
                (== (spanStart (nodeSpan (vecGet ctors ci))) (spanStart sp))
                false)
                {
                  (let c (vecGet ctors ci))
                  {
                    (lspNavEmit nv (nodeAName c) (nodeSpan c) NAV_DECL
                      (lspNavCtorKey (nodeAName d) (nodeAName c)) 0 0)
                    (set ci (+ ci 1))
                  }
                }
                (if (! (lspNavColonAfter src sp))
                  {
                    (let name (lspNavSpanText src sp))
                    (if (! (lspNavIsTyvar tvs name))
                      (lspNavTypeRef nv name sp))
                  }))
            })
          0
        }
      }
    }))

; `(struct Name (f : T) (mut g : U))`: a field name is followed by a
; `:`, and the `mut` marker is the identifier before one - the
; parser's own test (`parseOneField`), made on bytes.
(pub :: lspNavTypesStruct (-> LspNav ASTNode Int))
(pub fn (lspNavTypesStruct nv d)
  (if (== (nodeSpan d) 0)
    0
    {
      (let src nv.src)
      {
        (let spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d)))
        {
          (for (sp i) in spans
            (if (! (lspNavColonAfter src sp))
              (if (!
                    (&& (strEq (lspNavSpanText src sp) "mut")
                      (if (< (+ i 1) (vecLen spans))
                        (lspNavColonAfter src (vecGet spans (+ i 1)))
                        false)))
                (lspNavTypeRef nv (lspNavSpanText src sp) sp))))
          0
        }
      }
    }))

; `(type Name a T)`: the alias's parameters are the node's own
; tyvar list, which `parseAliasDecl` reads the same way; every other
; identifier in the form names the target type. There is no `=` in
; the canonical form, so the split is by the tyvar list, not a marker.
(pub :: lspNavTypesAlias (-> LspNav ASTNode Int))
(pub fn (lspNavTypesAlias nv d)
  (if (== (nodeSpan d) 0)
    0
    {
      (let src nv.src)
      (lspNavTypeRefs nv (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d))
        (nodeCNames d) 0)
    }))

; `(subtype Positive is Int range LO..HI)`: the identifiers between
; `is` and `range` name the base type. The bounds after `range` are
; VALUE expressions and are deliberately not walked - a name a bound
; spells is a reference `references` will not find, which is a gap
; with a name rather than a rule. (Bounds are usually literals, and
; walking them as expressions would resolve against the empty
; top-level scope, which is a second claim needing its own gate.)
(pub :: lspNavTypesSubtype (-> LspNav ASTNode Int))
(pub fn (lspNavTypesSubtype nv d)
  (if (== (nodeSpan d) 0)
    0
    {
      (let src nv.src)
      (let mut seenIs 0)
      (let mut done 0)
      {
        (let spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d)))
        {
          (for sp in spans
            (if (! (== done 1))
              (if (== seenIs 1)
                (if (strEq (lspNavSpanText src sp) "range")
                  (set done 1)
                  (lspNavTypeRef nv (lspNavSpanText src sp) sp))
                (if (strEq (lspNavSpanText src sp) "is")
                  (set seenIs 1)))))
          0
        }
      }
    }))

; The declaration's own name, keyed by itself. A `fn` and its `::`
; signature both land here under the same key, which is what makes a
; rename touch both.
(pub :: lspNavDeclName (-> LspNav ASTNode Int Int))
(pub fn (lspNavDeclName nv d role)
  (if (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0))
    (lspNavEmit nv (nodeAName d) (nodeSpan d) role (nodeAName d) 0 0)
    0))

; A `fn`: its name, its parameters bound over its body. The parameter
; spans come from the header's bytes and are used only when their
; count agrees with the tree - see `lspHeaderParamSpans`. Each
; parameter is pushed as soon as it is emitted, so a second parameter
; spelling the first is seen by the rename probe as a collision.
(pub :: lspNavWalkFn (-> LspNav ASTNode Int))
(pub fn (lspNavWalkFn nv d)
  {
    (let params (nodeBNames d))
    (let np (vecLen params))
    {
      (let spans
        (if (&& (> np 0) (!= (nodeSpan d) 0))
          (lspHeaderParamSpans nv.src (spanEnd (nodeSpan d)))
          vecNew))
      {
        (let ok (== (vecLen spans) np))
        {
          (lspNavDeclName nv d NAV_DECL)
          (for i in 0..np
            {
              (let p (vecGet params i))
              (let sp
                (if ok
                  (vecGet spans i)
                  0))
              {
                (let key (lspNavBinderKey p sp d))
                {
                  (lspNavEmitBinder nv p sp key NAV_B_PARAM i)
                  (lspNavPush nv p key)
                }
              }
            })
          (lspNavWalk nv (nodeCChild d))
          (lspNavPopN nv np)
        }
      }
    }
  })

; ------------------------------------------------------------------
; The walk: expressions.
;
; Every arm reads exactly the children the API map names for its tag
; and nothing else, and a tag with no arm is a leaf: a literal, a type
; node an `alloc` carries, a shape this walk does not know. A handle
; of 0 is a leaf too.
; ------------------------------------------------------------------
(pub :: lspNavWalk (-> LspNav ASTNode Int))
(pub fn (lspNavWalk nv e)
  (if (nodeSame e nilNode)
    0
    {
      (let tag (nodeTag e))
      (if (== tag TAG_E_VAR)
        (lspNavRef nv (nodeAName e) (nodeSpan e) NAV_READ)
        (if (== tag TAG_E_APP)
          {
            (lspNavWalk nv (nodeAChild e))
            ; A format string's holes name bindings: `(println "{v}")`
            ; reads `v` as surely as `(println v)` does, so hover,
            ; definition, references, highlights and rename all reach
            ; it. Only the literal handed to a formatting macro is
            ; read this way; anywhere else `{v}` is text.
            (if (lspNavIsFormatCall e)
              (lspNavHoles nv (nodeBChild e))
              (lspNavWalk nv (nodeBChild e)))
          }
          (if (== tag TAG_E_LAM)
            (lspNavWalkLam nv e)
            (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
              (lspNavWalkLet nv e)
              (if (== tag TAG_E_IF)
                {
                  (lspNavWalk nv (nodeAChild e))
                  (lspNavWalk nv (nodeBChild e))
                  (lspNavWalk nv (nodeCChild e))
                }
                (if (== tag TAG_E_BEGIN)
                  (lspNavWalkVec nv (nodeAChildren e))
                  (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
                    (if (== tag TAG_E_REGION)
                      ; the name identifies a lexical scope and binds no
                      ; value: navigate references in the body
                      (lspNavWalk nv (nodeBChild e))
                      {
                        (lspNavWalk nv (nodeAChild e))
                        (lspNavWalkVec nv (nodeBChildren e))
                      })
                    (if (== tag TAG_E_MATCH)
                      {
                        (lspNavWalk nv (nodeAChild e))
                        (lspNavWalkArms nv (nodeBChildren e) 0)
                      }
                      ; `cond` is AX2004: the parser builds none, so
                      ; no arm navigates one. A variadic `if` arrives
                      ; as nested `if`s.
                      (if (== tag TAG_E_SET)
                        ; The target is a WRITE, resolved as a
                        ; read would be; the value follows it in
                        ; the source and in this list.
                        {
                          (lspNavRef nv (nodeAName e) (nodeSpan e) NAV_WRITE)
                          (lspNavWalk nv (nodeBChild e))
                        }
                        (if (|| (== tag TAG_E_FIELD) (== tag TAG_E_TRY))
                          ; A field name is not a variable; the
                          ; base is.
                          (lspNavWalk nv (nodeAChild e))
                          (if (== tag TAG_E_SETF)
                            {
                              (lspNavWalk nv (nodeAChild e))
                              (lspNavWalk nv (nodeCChild e))
                            }
                            (if (== tag TAG_E_HANDLE)
                              {
                                (lspNavWalk nv (nodeAChild e))
                                (lspNavWalkEffects nv (nodeBChildren e) 0)
                                (lspNavWalk nv (nodeCChild e))
                              }
                              0))))))))))))
    }))

; `(println "...")`, `(eprintln "...")` or `(format "...")`, with the
; literal as the argument: the one place a string's `{name}` is a hole.
(pub :: lspNavIsFormatCall (-> ASTNode Bool))
(pub fn (lspNavIsFormatCall e)
  {
    (let h (nodeAChild e))
    (let arg (nodeBChild e))
    (if (|| (nodeSame h nilNode) (nodeSame arg nilNode))
      false
      (if (|| (!= (nodeTag h) TAG_E_VAR) (!= (nodeTag arg) TAG_E_STR))
        false
        {
          (let n (bareOf (nodeAName h)))
          (|| (strEq n "println") (|| (strEq n "eprintln") (strEq n "format")))
        }))
  })

; Each hole of the format string `lit` as a READ of the name it spells,
; at the name's own bytes: `{name}` and `{name:SPEC}`, with `{{` and
; `}}` as literal braces and a backslash escaping the byte after it.
(pub :: lspNavHoles (-> LspNav ASTNode Int))
(pub fn (lspNavHoles nv lit)
  {
    (let src nv.src)
    (let sp (nodeSpan lit))
    (if (== sp 0)
      0
      {
        (let end (- (spanEnd sp) 1))
        (let mut i (+ (spanStart sp) 1))
        {
          (while (< i end)
            {
              (let b (strByte src i))
              (if (== b 92)
                (set i (+ i 2))
                (if (if (== b 123)
                  (if (< (+ i 1) end)
                    (== (strByte src (+ i 1)) 123)
                    false)
                  false)
                  (set i (+ i 2))
                  (if (== b 123)
                    {
                      (let mut j (+ i 1))
                      {
                        (while (if (< j end)
                          (isIdentChar (strByte src j))
                          false)
                          (set j (+ j 1)))
                        (if (if (> j (+ i 1))
                          (if (< j end)
                            (|| (== (strByte src j) 125) (== (strByte src j) 58))
                            false)
                          false)
                          (lspNavRef nv (strSlice src (+ i 1) (- j (+ i 1))) (mkSpan (+ i 1) j)
                            NAV_READ))
                        (set i j)
                      }
                    }
                    (set i (+ i 1)))))
            })
          0
        }
      })
  })

(pub :: lspNavWalkVec (-> LspNav (Vec ASTNode) Int))
(pub fn (lspNavWalkVec nv xs)
  {
    (for i in 0..(vecLen xs)
      (lspNavWalk nv (vecGet xs i)))
    0
  })

; A reference, under the key it resolves to. `_` is a wildcard and
; never a name.
(pub :: lspNavRef (-> LspNav String Int Int Int))
(pub fn (lspNavRef nv name span role)
  (if (strEq name "_")
    0
    (if (if (let (Some _) (strFindByte name 36 0))
      false
      true)
      ; The bytes decide here too. `parseForExpr` builds `(< for$i
      ; for$n)` and `(+ for$i 1)` with the KEYWORD's span on `<` and
      ; `+`, so that a type error in a bound reports at the loop;
      ; emitted, those two sat on the word `for` and `documentHighlight`
      ; there answered every `for` in the document (measured: two
      ; loops, two highlights, while `while` answered null).
      (if (lspNavSpells nv.src span name)
        (lspNavEmit nv name span role (lspNavResolve nv name) 0 0)
        0)
      ; Qualified, or made up by the parser: the bytes decide, see
      ; `lspNavSpells`.
      {
        (let qs (lspNavQualSpan nv.src span))
        (if (lspNavSpells nv.src qs (bareOf name))
          (lspNavEmit nv (bareOf name) qs role (lspNavResolve nv name) 0 0)
          0)
      })))

; A `let` binder scopes its BODY and not its value - a `let` is not
; recursive - so the value is walked before the name is pushed. The
; occurrence is emitted first because the name precedes the value in
; the source, and the list is kept in source order. The occurrence owns
; the optional value separately from its parameter index. Field hover
; and shape inference read a let-bound value when it is present.
(pub :: lspNavWalkLet (-> LspNav ASTNode Int))
(pub fn (lspNavWalkLet nv e)
  {
    (let name (nodeAName e))
    ; The packed child slot uses nil for a missing expression.
    (let value (nodeBChild e))
    (let valueOpt
      (:: (if (nodeSame value nilNode)
        None
        (Some value)) (Option ASTNode)))
    (let key (lspNavBinderKey (nodeAName e) (nodeSpan e) e))
    {
      (lspNavEmitBinderValue nv name (nodeSpan e) key NAV_B_LET 0 valueOpt)
      (lspNavWalk nv value)
      (lspNavPush nv name key)
      (lspNavWalk nv (nodeCChild e))
      (lspNavPopN nv 1)
    }
  })

; A `lambda` of several parameters is several nested TAG_E_LAM nodes
; carrying the SAME keyword span (`curryLam`), and the byte scan reads
; the whole `(p1 p2)` list once; the nodes take the spans in order.
; The chain is walked here rather than through `lspNavWalk`, so the
; nested nodes are not each scanned again as if they were lambdas of
; their own. A lambda written INSIDE another has its own keyword and
; its own span, so it is not part of the chain.
(pub :: lspNavWalkLam (-> LspNav ASTNode Int))
(pub fn (lspNavWalkLam nv e)
  {
    (let sp (nodeSpan e))
    (let total (lspNavLamArity e (nodeSpan e) 0))
    {
      (let spans
        (if (&& (> total 0) (!= sp 0))
          (lspHeaderParamSpans nv.src (spanEnd sp))
          vecNew))
      {
        (let ok (== (vecLen spans) total))
        (let mut n e)
        (let mut k 0)
        {
          (while (lspNavInChain n sp)
            {
              (if (> (vecLen (nodeANames n)) 0)
                {
                  (let p (vecGet (nodeANames n) 0))
                  (let psp
                    (if ok
                      (vecGet spans k)
                      0))
                  {
                    (let key (lspNavBinderKey p psp n))
                    {
                      (lspNavEmitBinder nv p psp key NAV_B_LAMBDA k)
                      (lspNavPush nv p key)
                      (set k (+ k 1))
                    }
                  }
                })
              (set n (nodeBChild n))
            })
          (lspNavWalk nv n)
          (lspNavPopN nv k)
        }
      }
    }
  })

(pub :: lspNavInChain (-> ASTNode Int Bool))
(pub fn (lspNavInChain n sp)
  (if (nodeSame n nilNode)
    false
    (&& (== (nodeTag n) TAG_E_LAM) (== (nodeSpan n) sp))))

(pub :: lspNavLamArity (-> ASTNode Int Int Int))
(pub fn (lspNavLamArity n sp acc)
  (if (lspNavInChain n sp)
    (lspNavLamArity (nodeBChild n) sp
      (if (> (vecLen (nodeANames n)) 0)
        (+ acc 1)
        acc))
    acc))

; `match` arms: the pattern's binders scope the arm's body. A
; `syntax/for` arm binds its iteration variable - spanless, it is a
; template construct - over its own arms.
(pub :: lspNavWalkArms (-> LspNav (Vec ASTNode) Int Int))
(pub fn (lspNavWalkArms nv arms i)
  (if (>= i (vecLen arms))
    0
    {
      (let arm (vecGet arms i))
      {
        (if (== (nodeTag arm) TAG_M_ARM)
          {
            (let bound (lspNavWalkPat nv (nodeAChild arm)))
            {
              (lspNavWalk nv (nodeBChild arm))
              (lspNavPopN nv bound)
            }
          }
          (if (== (nodeTag arm) TAG_M_FOR)
            {
              (lspNavWalk nv (nodeBChild arm))
              (lspNavPush nv (nodeAName arm) (lspNavBinderKey (nodeAName arm) 0 arm))
              (lspNavWalkArms nv (nodeCChildren arm) 0)
              (lspNavPopN nv 1)
            }))
        (lspNavWalkArms nv arms (+ i 1))
      }
    }))

; The effects a `handle` names, as references to effects - a namespace
; this document's declarations are not searched for.
(pub :: lspNavWalkEffects (-> LspNav (Vec ASTNode) Int Int))
(pub fn (lspNavWalkEffects nv effs i)
  (if (>= i (vecLen effs))
    0
    {
      (let v (vecGet effs i))
      {
        (if (&& (== (nodeTag v) TAG_E_VAR) (!= (nodeSpan v) 0))
          (lspNavEmit nv (nodeAName v) (nodeSpan v) NAV_READ (concat "!" (nodeAName v)) 0 0))
        (lspNavWalkEffects nv effs (+ i 1))
      }
    }))

; ------------------------------------------------------------------
; The walk: patterns. Answers how many binders it pushed, which the
; arm pops after its body.
;
; The head of an application spine and a `TAG_P_CON0` /
; `TAG_P_CONNAMED` name are CONSTRUCTOR references, resolved against
; the top-level table alone - a local can never be a constructor.
; Every other variable in pattern position is a binder, except `_`.
; ------------------------------------------------------------------
(pub :: lspNavWalkPat (-> LspNav ASTNode Int))
(pub fn (lspNavWalkPat nv p)
  (if (nodeSame p nilNode)
    0
    {
      (let tag (nodeTag p))
      (if (== tag TAG_E_VAR)
        (if (|| (strEq (nodeAName p) "_") (== (nodeSpan p) 0))
          0
          {
            (let key (lspNavBinderKey (nodeAName p) (nodeSpan p) p))
            {
              (lspNavEmitBinder nv (nodeAName p) (nodeSpan p) key NAV_B_PATTERN 0)
              (lspNavPush nv (nodeAName p) key)
              1
            }
          })
        (if (== tag TAG_E_APP)
          (lspNavWalkPatSpine nv p)
          (if (== tag TAG_P_CON0)
            {
              (lspNavCtorRef nv (nodeAName p) (nodeSpan p))
              0
            }
            (if (== tag TAG_P_CONNAMED)
              {
                (lspNavCtorRef nv (nodeAName p) (nodeSpan p))
                (lspNavWalkPatVec nv (nodeCChildren p) 0)
              }
              0))))
    }))

; `(Just x)` is App(Var Just, Var x): the spine's innermost head is the
; constructor and every argument along it is a sub-pattern.
(pub :: lspNavWalkPatSpine (-> LspNav ASTNode Int))
(pub fn (lspNavWalkPatSpine nv m)
  (if (== (nodeTag m) TAG_E_APP)
    {
      (let a (lspNavWalkPatSpine nv (nodeAChild m)))
      (+ a (lspNavWalkPat nv (nodeBChild m)))
    }
    (if (== (nodeTag m) TAG_E_VAR)
      {
        (lspNavCtorRef nv (nodeAName m) (nodeSpan m))
        0
      }
      (lspNavWalkPat nv m))))

(pub :: lspNavWalkPatVec (-> LspNav (Vec ASTNode) Int Int))
(pub fn (lspNavWalkPatVec nv pats i)
  (if (>= i (vecLen pats))
    0
    {
      (let a (lspNavWalkPat nv (vecGet pats i)))
      (+ a (lspNavWalkPatVec nv pats (+ i 1)))
    }))

(pub :: lspNavCtorRef (-> LspNav String Int Int))
(pub fn (lspNavCtorRef nv name span)
  (if (|| (== span 0) (strEq name "_"))
    0
    {
      (let t (lspNavTopGet nv.top name))
      (lspNavEmit nv (bareOf name) span NAV_READ
        (if (!= (strLen t) 0)
          t
          (concat "?" (bareOf name)))
        0 0)
    }))

; ------------------------------------------------------------------
; Reading the occurrence list.
; ------------------------------------------------------------------
; The occurrence under byte `off`, or `None`. Spans do not overlap,
; so the first hit is the only one.
(pub :: lspNavAt (-> (Vec LspOcc) Int (Option LspOcc)))
(pub fn (lspNavAt occs off)
  {
    (let n (vecLen occs))
    (let mut i 0)
    (let mut found None)
    {
      (while (< i n)
        {
          (let o (vecGet occs i))
          {
            (if (lspSpanHas o.span off)
              {
                (set found (Some o))
                (set i n)
              })
            (set i (+ i 1))
          }
        })
      found
    }
  })

; The BINDER occurrence a local key was made from, or `None`.
(pub :: lspNavBinderOf (-> (Vec LspOcc) String (Option LspOcc)))
(pub fn (lspNavBinderOf occs key)
  {
    (let n (vecLen occs))
    (let mut i 0)
    (let mut found None)
    {
      (while (< i n)
        {
          (let o (vecGet occs i))
          {
            (if (&& (== o.role NAV_BINDER) (strEq o.key key))
              {
                (set found (Some o))
                (set i n)
              })
            (set i (+ i 1))
          }
        })
      found
    }
  })

(pub :: lspNavIsDeclRole (-> Int Bool))
(pub fn (lspNavIsDeclRole role)
  (|| (== role NAV_BINDER) (|| (== role NAV_DECL) (== role NAV_DECL_SIG))))

; Every occurrence carrying `key`, in source order; declarations,
; signatures and binders only when `incl` is 1.
(pub :: lspNavSameKey (-> (Vec LspOcc) String Int (Vec LspOcc)))
(pub fn (lspNavSameKey occs key incl)
  {
    (let n (vecLen occs))
    (let out vecNew)
    {
      (for i in 0..n
        {
          (let o (vecGet occs i))
          (if (strEq o.key key)
            (if (|| (== incl 1) (lspNavNot (lspNavIsDeclRole o.role)))
              (vecPush out o)))
        })
      out
    }
  })

; Whether any occurrence spells `name`.
(pub :: lspNavNamed (-> (Vec LspOcc) String Bool))
(pub fn (lspNavNamed occs name)
  {
    (let n (vecLen occs))
    (let mut i 0)
    (let mut found false)
    {
      (while (< i n)
        {
          (let o (vecGet occs i))
          (if (strEq o.name name)
            {
              (set found true)
              (set i n)
            })
          (set i (+ i 1))
        })
      found
    }
  })

; The key's first byte says what kind of binding it names.
(pub :: lspNavIsLocal (-> String Bool))
(pub fn (lspNavIsLocal key)
  (&& (> (strLen key) 0) (|| (== (strByte key 0) 64) (== (strByte key 0) 126))))

(pub :: lspNavIsTop (-> String Bool))
(pub fn (lspNavIsTop key)
  (if (== (strLen key) 0)
    false
    {
      (let b (strByte key 0))
      (if (|| (== b 64) (|| (== b 126) (|| (== b 63) (== b 33))))
        false
        true)
    }))

; The bare name a top-level key is spelled by outside this document:
; a constructor's key carries its `data`, and an importing file writes
; the constructor alone.
(pub :: lspNavBareOfKey (-> String String))
(pub fn (lspNavBareOfKey key)
  (if (let (Some h) (strFindByte key 35 0))
    (strSlice key (+ h 1) (- (strLen key) (+ h 1)))
    key))

; Renamable: a local with an anchor, or a name this document declares.
; NOT renamable, and null is the answer: a name declared in another
; module, even an open one - renaming across files this server did not
; open would leave a broken workspace, and a standard-library name
; must never be renamed from a client; a builtin; an effect; a keyword
; or `_`, which are never occurrences; and a parameter whose span
; could not be recovered.
(pub :: lspNavRenamable (-> LspOcc Bool))
(pub fn (lspNavRenamable o)
  {
    (let key o.key)
    (|| (lspNavIsTop key) (&& (> (strLen key) 0) (== (strByte key 0) 64)))
  })

; LSP DocumentHighlightKind: Read 2, Write 3. A binding site is a write.
(pub :: lspNavHighlightKind (-> Int Int))
(pub fn (lspNavHighlightKind role)
  (if (== role NAV_READ)
    2
    3))

; `context.includeDeclaration`, defaulting to true when the client
; sent no context at all.
(pub :: lspNavInclDecl (-> Int Int))
(pub fn (lspNavInclDecl params)
  {
    (let ctx (jsonGet params "context"))
    (if (== ctx 0)
      1
      {
        (let b (jsonGet ctx "includeDeclaration"))
        (if (== b 0)
          1
          (jsonBoolVal b))
      })
  })

; A new name the lexer would read as one identifier, and that is not
; a keyword, and not the wildcard.
(pub :: lspNavValidName (-> String Bool))
(pub fn (lspNavValidName s)
  {
    (let n (strLen s))
    (let mut i 1)
    (let mut ok
      (if (== n 0)
        false
        (isIdentStart (strByte s 0))))
    {
      (while (&& ok (< i n))
        {
          (if (! (isIdentChar (strByte s i)))
            (set ok false))
          (set i (+ i 1))
        })
      (if ok
        (if (|| (strEq s "_") (lspSeenHas lspKeywords s))
          false
          true)
        false)
    }
  })

;; The parsed declarations of `src`, through `lspParse`: a document
;; that does not parse answers the declarations that still parse
;; around its errors.
(pub :: lspNavParse (-> String (Vec ASTNode)))
(pub fn (lspNavParse src)
  (match (lspParse src)
    ((ParseFailed error) vecNew)
    ((ParseSuccess declarations after) declarations)))

;; The same, or None when reading the document meant dropping some of its
;; tokens: a rename over that tree would leave the dropped references
;; spelt the old way.
(pub :: lspNavParseExact (-> String (Option Nodes)))
(pub fn (lspNavParseExact src)
  (match (lspParse src)
    ((ParseFailed error) None)
    ((ParseSuccess declarations position)
      (if (== position (- 0 2))
        None
        (Some declarations))
    )))

; ------------------------------------------------------------------
; JSON shapes.
; ------------------------------------------------------------------
(pub :: lspNavLocations (-> Int String String Ints (Vec LspOcc) Int))
(pub fn (lspNavLocations out uri src ix sel)
  {
    (for o in sel
      (jsonArrPush out
        (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRangeIx src ix o.span))))
    0
  })

; TextEdits, one per occurrence, in source order - which is offset
; order, and the spans of two occurrences never overlap.
(pub :: lspNavEdits (-> String Ints (Vec LspOcc) String Int))
(pub fn (lspNavEdits src ix sel newName)
  {
    (let out jsonArr)
    {
      (for o in sel
        (jsonArrPush out
          (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix o.span)) "newText"
            (jsonStr newName))))
      out
    }
  })

; ------------------------------------------------------------------
; The other open documents.
;
; A document IMPORTS this one when one of its `(import M)` lines
; resolves - by `moduleSrcPath`, the compiler's own search - to this
; document's path. Both paths are made absolute against the working
; directory before they are compared, because `moduleSrcPath` answers
; whatever the entry directory was spelled as, and a `file:` URI is
; always absolute.
;
; Answers a Vec of (store index, parsed declarations) pairs, so a
; caller that goes on to walk the importer does not parse it twice.
; The current document and any document that is empty or does not
; parse are skipped.
; ------------------------------------------------------------------
(pub :: lspNavAbs (-> String String))
;@axiom:effect(io)
(pub fn (lspNavAbs p)
  (if (pathIsAbsolute p)
    p
    (pathJoin (unwrapOr cwd "") p)))

(pub :: lspNavImportsPath (-> LspWorkspace (Vec ASTNode) Int String String Bool))
;@axiom:effect(io)
(pub fn (lspNavImportsPath workspace decls tcode entryDir target)
  {
    (let n (vecLen decls))
    (let mut i 0)
    (let mut found false)
    {
      (while (&& (< i n) (lspNavNot found))
        {
          (let d (vecGet decls i))
          {
            (if (== (nodeTag d) TAG_D_IMPORT)
              {
                (let p (lspWorkspaceModulePath workspace (nodeAName d) tcode entryDir))
                (if (let (Some path) p)
                  (if (strEq (lspNavAbs path) target)
                    (set found true)))
              })
            (set i (+ i 1))
          }
        })
      found
    }
  })

; An open document that imports the file being asked about: its index
; in the document vectors, and its parsed declarations.
(pub struct LspImporter
  (index : Int)
  (decls : Nodes))

(pub :: lspNavImporters (-> LspWorkspace String Strings Strings (Vec LspImporter)))
;@axiom:effect(io)
(pub fn (lspNavImporters workspace uri uris texts)
  {
    (let target (lspNavAbs (lspUriToPath uri)))
    (let tcode (checkedTargetCode hostTarget))
    (let out vecNew)
    (let n (vecLen uris))
    {
      (for i in 0..n
        {
          (let ouri (vecGet uris i))
          (let otext (vecGet texts i))
          (if (! (|| (strEq ouri uri) (== (strLen otext) 0)))
            {
              (let odecls (lspNavParse otext))
              (if (! (== (as odecls Int) 0))
                (if (lspNavImportsPath workspace odecls tcode (pathDir (lspUriToPath ouri)) target)
                  (vecPush out (LspImporter :index i :decls odecls))))
            })
        })
      out
    }
  })

; The occurrences in importer `pair` that spell `bare` and resolve to
; nothing that document declares - a local or a declaration of its
; own would shadow the import, and is a different name.
(pub :: lspNavForeignSel (-> Strings LspImporter String (Vec LspOcc)))
(pub fn (lspNavForeignSel texts pair bare)
  (lspNavSameKey (lspNavOccurrences (vecGet texts pair.index) pair.decls) (concat "?" bare) 1))

; The reverse direction: the cursor is on a name this document
; imports. The module that declares it is found the way `definition`
; finds it - preflight, then the resolver, then `lspFindImported` - and
; if THAT file is open in the store, its URI is answered, so its own
; occurrences can be listed. None when the name is not an import, or
; the declaring file is not open.
(pub :: lspNavHomeUri (-> LspWorkspace String String Nodes String Strings (Option String)))
;@axiom:effect(io)
(pub fn (lspNavHomeUri workspace path src decls w uris)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let d (lspFindImported allDecls w (- (vecLen allDecls) 1)))
        (if (let (Some d) d)
          {
            (let u (lspUnitOf units (nodeModuleOpt d)))
            (match u
              ((None) None)
              ((Some u)
                {
                  (let huri (lspPathToUri (unitFile (vecGet units u))))
                  (if (< (docFind uris huri) 0)
                    None
                    (Some huri))
                }
              ))
          }
          None)
      }
    }
    None))

; ------------------------------------------------------------------
; `textDocument/references`: every occurrence of the name under the
; cursor, as Locations - this document's first, then each importing
; document's, each in offset order. Null when nothing is under the
; cursor, which is what a keyword, a literal and a comment are.
; ------------------------------------------------------------------
(pub :: lspReferences (-> LspWorkspace String String Int Strings Strings String Int))
;@axiom:effect(io)
(pub fn (lspReferences workspace src uri params uris texts gen)
  {
    (let decls (lspNavParse src))
    (if (== (as decls Int) 0)
      jsonNull
      {
        (let ix (lspLineIndex src))
        (let occs (lspNavOccurrences src decls))
        (let incl (lspNavInclDecl params))
        (if (let (Some o) (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position"))))
          {
            (let key o.key)
            (let out jsonArr)
            {
              ; A GENERATED NAME's invocation, first when the
              ; declaration is included: it precedes every use in
              ; the document, so prepending keeps document order.
              (if (== incl 1)
                {
                  (let e (lspGenLookup gen o.name))
                  (if (!= e 0)
                    (jsonArrPush out
                      (lspNavLocOf uri src
                        (mkSpan (jsonGetInt e "invStart") (jsonGetInt e "invEnd")))))
                })
              (lspNavLocations out uri src ix (lspNavSameKey occs key incl))
              (if (lspNavIsTop key)
                (lspNavForeignLocations workspace out uri (lspNavBareOfKey key) uris texts)
                (if (== (strByte key 0) 63)
                  (lspNavHomeLocations workspace out (lspUriToPath uri) src decls o.name incl uris
                    texts)))
              out
            }
          }
          jsonNull)
      })
  })

(pub :: lspNavForeignLocations (-> LspWorkspace Int String String Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspNavForeignLocations workspace out uri bare uris texts)
  {
    (let imps (lspNavImporters workspace uri uris texts))
    {
      (for pair in imps
        {
          (let otext (vecGet texts pair.index))
          (let ouri (vecGet uris pair.index))
          (lspNavLocations out ouri otext (lspLineIndex otext) (lspNavForeignSel texts pair bare))
        })
      0
    }
  })

; The declaring module's occurrences when that file is open. When it
; isn't, its uses can't be listed without reading every file on disk,
; but the declaration itself is one lookup away - the one `definition`
; makes - so a request that includes the declaration still gets it.
(pub :: lspNavHomeLocations
  (-> LspWorkspace Int String String (Vec ASTNode) String Int Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspNavHomeLocations workspace out path src decls bare incl uris texts)
  {
    (let huri (lspNavHomeUri workspace path src decls bare uris))
    (match huri
      ((None)
        (if (== incl 1)
          {
            (let loc (lspDefinitionImported workspace path src decls bare))
            (if (jsonIsNull loc)
              0
              {
                (jsonArrPush out loc)
                0
              })
          }
          0)
      )
      ((Some huri)
        (if (let (Some htext) (docText uris texts huri))
          {
            (let hdecls (lspNavParse htext))
            (if (== (as hdecls Int) 0)
              0
              (lspNavLocations out huri htext (lspLineIndex htext)
                (lspNavSameKey (lspNavOccurrences htext hdecls) bare incl)))
          }
          0)
      ))
  })

; ------------------------------------------------------------------
; `textDocument/documentHighlight`: the same name in THIS document,
; each occurrence with the kind of use it is.
; ------------------------------------------------------------------
(pub :: lspDocumentHighlight (-> String Int Int))
(pub fn (lspDocumentHighlight src params)
  {
    (let decls (lspNavParse src))
    (if (== (as decls Int) 0)
      jsonNull
      {
        (let ix (lspLineIndex src))
        (let occs (lspNavOccurrences src decls))
        (if (let (Some o) (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position"))))
          {
            (let sel (lspNavSameKey occs o.key 1))
            (let out jsonArr)
            {
              (for s in sel
                (jsonArrPush out
                  (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix s.span)) "kind"
                    (jsonNum (lspNavHighlightKind s.role)))))
              out
            }
          }
          jsonNull)
      })
  })

; ------------------------------------------------------------------
; `textDocument/prepareRename`: the range and current spelling of a
; renamable identifier, else null - see `lspNavRenamable` for the
; refusals.
; ------------------------------------------------------------------
(pub :: lspPrepareRename (-> String Int Int))
(pub fn (lspPrepareRename src params)
  (if (let (Some decls) (lspNavParseExact src))
    {
      (let ix (lspLineIndex src))
      (let occs (lspNavOccurrences src decls))
      (if (let (Some o) (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position"))))
        (if (lspNavRenamable o)
          (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix o.span)) "placeholder"
            (jsonStr o.name))
          jsonNull)
        jsonNull)
    }
    jsonNull))

; ------------------------------------------------------------------
; `textDocument/rename`: a WorkspaceEdit over every occurrence of the
; name - its declaration, its signature, every binder and reference in
; this document, and for a declared name the references in every open
; document that imports this one, under their own URIs.
;
; REFUSED WITH NULL, beyond what `prepareRename` refuses: a new name
; the lexer would not read as one identifier, a keyword, `_`; the old
; name itself; and a collision - for a local, a name already bound in
; an enclosing or the same scope or a name the renamed binding would
; capture (`lspNavProbe`); for a declaration, a name this document or
; any importing document already spells anywhere, because a rename
; that makes a call resolve somewhere else is a change of meaning
; disguised as a change of spelling.
; ------------------------------------------------------------------
(pub :: lspRename (-> LspWorkspace String String Int Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspRename workspace src uri params uris texts)
  (if (let (Some decls) (lspNavParseExact src))
    {
      (let ix (lspLineIndex src))
      (let occs (lspNavOccurrences src decls))
      (let newName (jsonGetStr params "newName"))
      (if (let (Some o) (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position"))))
        (if (|| (lspNavNot (lspNavRenamable o))
              (|| (lspNavNot (lspNavValidName newName)) (strEq newName o.name)))
          jsonNull
          {
            (let key o.key)
            (if (lspNavIsTop key)
              (lspRenameTop workspace src uri ix occs key newName uris texts)
              (lspRenameLocal src uri ix decls occs key newName))
          })
        jsonNull)
    }
    jsonNull))

(pub :: lspRenameLocal (-> String String Ints (Vec ASTNode) (Vec LspOcc) String String Int))
(pub fn (lspRenameLocal src uri ix decls occs key newName)
  {
    (let probe (lspNavProbe newName key))
    {
      (lspNavOccurrencesProbe src decls (Some probe))
      (if (== probe.hit 1)
        jsonNull
        (lspNavWorkspaceEdit
          (jsonObjPut jsonObj uri (lspNavEdits src ix (lspNavSameKey occs key 1) newName))))
    }
  })

(pub :: lspRenameTop
  (-> LspWorkspace String String Ints (Vec LspOcc) String String Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspRenameTop workspace src uri ix occs key newName uris texts)
  (if (lspNavNamed occs newName)
    jsonNull
    {
      (let bare (lspNavBareOfKey key))
      (let imps (lspNavImporters workspace uri uris texts))
      (let changes
        (jsonObjPut jsonObj uri (lspNavEdits src ix (lspNavSameKey occs key 1) newName)))
      (let mut i 0)
      (let mut clash false)
      {
        (while (&& (< i (vecLen imps)) (lspNavNot clash))
          {
            (let pair (vecGet imps i))
            {
              (let otext (vecGet texts pair.index))
              (let ouri (vecGet uris pair.index))
              (let oocc (lspNavOccurrences (vecGet texts pair.index) pair.decls))
              {
                (if (lspNavNamed oocc newName)
                  (set clash true)
                  {
                    (let sel (lspNavSameKey oocc (concat "?" bare) 1))
                    (if (> (vecLen sel) 0)
                      (jsonObjPut changes ouri
                        (lspNavEdits otext (lspLineIndex otext) sel newName)))
                  })
                (set i (+ i 1))
              }
            }
          })
        (if clash
          jsonNull
          (lspNavWorkspaceEdit changes))
      }
    }))

(pub :: lspNavWorkspaceEdit (-> Int Int))
(pub fn (lspNavWorkspaceEdit changes)
  (jsonObjPut jsonObj "changes" changes))

; ------------------------------------------------------------------
; The local-binding half of `definition` and `hover`.
;
; Both are asked FIRST by their callers, before the declaration
; lookups, because a local shadows a declaration of the same name -
; the language's rule, and the order `lspNavResolve` follows. Each
; answers 0 when the word under the cursor is not a local, and the
; caller then proceeds exactly as it did before, so every answer that
; is not about a local is unchanged.
; ------------------------------------------------------------------
; The binder's Location for a local reference or binder; null for a
; local whose binder has no anchor - jumping to a declaration of the
; same name would be the wrong of the two answers.
(pub :: lspNavLocalDefinition (-> String String Ints (Vec ASTNode) Int Int))
(pub fn (lspNavLocalDefinition src uri ix decls off)
  {
    (let occs (lspNavOccurrences src decls))
    (if (let (Some o) (lspNavAt occs off))
      {
        (let key o.key)
        (if (lspNavIsLocal key)
          (match (lspNavBinderOf occs key)
            ((None) jsonNull)
            ((Some b)
              (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range"
                (lspRangeIx src ix b.span))
            ))
          0)
      }
      0)
  })

; ------------------------------------------------------------------
; Value shapes: the type of the value at this position.
;
; WHAT THIS IS. One question - "what type does this expression have"
; - asked of the RAW parse tree and answered as a type node, for the
; two requests that show a value's type: `hover`, which answers it
; below, and `inlayHint`, which is its next caller. The rules read
; what the file SAYS: a literal's kind, a `::` signature's arrow, a
; constructor's `data`, a builtin's row in the checker's own table.
; Nothing here expands a macro and nothing runs the pipeline, which
; is what the cost rule in docs/lsp.md requires of a per-keystroke
; request: each answer costs one walk of the expression it types, and
; a call's result costs no walk of its arguments at all unless the
; callee is a constructor, whose type arguments are read off them.
;
; WHAT IT IS NOT is the checker. There is no unification, no
; environment, and no error: where the checker would elaborate, this
; answers 0 ("unknown") and the caller shows what it showed before.
; Soundness stays where it was - a shape read off an ill-typed
; program is still read, because the diagnostic beside it is the
; checker's to publish, not this walk's to second-guess. Three
; corollaries worth stating, because each is a trap a fuller answer
; would fall into:
;
;   * A partial application answers the REMAINING arrow: `(+ 1)` is
;     `(-> Int Int)`, exactly as the curried application means, and
;     an argument past the arrows' end is unknown rather than an
;     error, because arity is the checker's complaint.
;   * A constructor answers its `data` with the arguments the call
;     determines: `(Just 5)` is `Maybe Int`, `(Dot)` is `Shape`. An
;     argument the call does NOT determine - `(Nothing)`, whose `a`
;     appears nowhere - is unknown rather than a bare `Maybe`,
;     because a bare `Maybe` is a different type wearing fewer
;     words.
;   * A variable answers through its binder, which the scope-aware
;     walk has already resolved: a parameter through the owning
;     signature, a `let` through its value. The walk's keys make
;     shadowing exact for free, and a `let` is not recursive, so a
;     value never names its own binder and the recursion always
;     reaches an earlier binding; the fuel beside it is a backstop,
;     not the termination argument. A TOP-LEVEL name as a value is
;     read the way `checkBareValue` reads it - a `fn` of fewer
;     than two arguments answers its signature, a nullary
;     constructor its `data` - because a two-argument `fn` and a
;     constructor that takes arguments are refused as bare values
;     (AX3013, AX3009), and a shape beside the checker's poison
;     would be a guess.
;
; WHAT IT DOES NOT ANSWER, and why each is a later slice rather than
; a gap in this one: a name from another module (the imported
; declarations are a read away and this slice did not take it); a
; `lambda` (a function value whose parameter types the tree never
; spells); a lambda parameter or a pattern variable (same reason -
; the binder carries no value to read); and a field base this walk
; could resolve but `lspFieldBaseStruct` still answers on its own,
; which is the migration the next slice does.
;
; THE BUILTIN TABLE (`lspShapeBuiltinRes`) is a copy of `tcNew`'s
; `regFn` rows in core/typecheck.ax, and it is a checked copy:
; tests/lsp/drive.py parses those rows and requires the server's
; answer to agree with them, the way it requires the completion
; keywords to agree with the parser's. The checker types `+` as
; `(-> Int Int Int)` unconditionally, so this does too - a `+` of
; two strings is the checker's AX3004 beside a hover of `Int`.
; ------------------------------------------------------------------
; Missing or poisoned source types provide no display shape.
; The shape queries answer None instead of rendering poison.
; Packed AST readers can return the absent node word. Shape APIs
; normalise it at the read boundary and own every present result.
(:: lspShapeNodeOpt (-> ASTNode (Option ASTNode)))
(fn (lspShapeNodeOpt node)
  (if (nodeSame node nilNode)
    None
    (Some node)))

(pub :: lspShapeIsBad (-> ASTNode Bool))
(pub fn (lspShapeIsBad t)
  (if (nodeSame t nilNode)
    true
    (== (nodeTag t) TAG_T_ERR)))

; The checker's row for a builtin operator: 1 for an `Int` result
; over `Int` arguments, 2 for `Bool` over `Int`, 3 for `Bool` over
; `Bool`, None for a builtin this table does not know. The rows mirror
; `tcNew` in core/typecheck.ax exactly - same names, same
; shapes - and the gate holds the mirror: ten arithmetic and bitwise
; operators, six comparisons, three logical operators.
(pub :: lspShapeBuiltinRes (-> String (Option Int)))
(pub fn (lspShapeBuiltinRes h)
  (if (strEq h "+")
    (Some 1)
    (if (strEq h "-")
      (Some 1)
      (if (strEq h "*")
        (Some 1)
        (if (strEq h "/")
          (Some 1)
          (if (strEq h "%")
            (Some 1)
            (if (strEq h "&")
              (Some 1)
              (if (strEq h "|")
                (Some 1)
                (if (strEq h "^")
                  (Some 1)
                  (if (strEq h "<<")
                    (Some 1)
                    (if (strEq h ">>")
                      (Some 1)
                      (if (strEq h "==")
                        (Some 2)
                        (if (strEq h "!=")
                          (Some 2)
                          (if (strEq h "<")
                            (Some 2)
                            (if (strEq h ">")
                              (Some 2)
                              (if (strEq h "<=")
                                (Some 2)
                                (if (strEq h ">=")
                                  (Some 2)
                                  (if (strEq h "&&")
                                    (Some 3)
                                    (if (|| (strEq h "||") (strEq h "!"))
                                      (Some 3)
                                      None)))))))))))))))))))

; Drop one arrow domain per argument: the curried reading of a call.
; A non-arrow with arguments left, a missing type, and poison are
; all unknown.
(pub :: lspShapeApplyArrow (-> ASTNode Int (Option ASTNode)))
(pub fn (lspShapeApplyArrow ty n)
  (if (lspShapeIsBad ty)
    None
    (if (== n 0)
      (Some ty)
      (if (!= (nodeTag ty) TAG_T_ARR)
        None
        (lspShapeApplyArrow (nodeBChild ty) (- n 1))))))

; A builtin's type under application: its row's full arrow with one
; domain dropped per argument, so a partial application answers the
; remaining arrow.
(pub :: lspShapeBuiltinTy (-> String Int (Option ASTNode)))
(pub fn (lspShapeBuiltinTy h nargs)
  (match (lspShapeBuiltinRes h)
    ((None) None)
    ((Some r)
      (lspShapeApplyArrow
        (if (== r 1)
          (mkTArr mkIntTy (mkTArr mkIntTy mkIntTy))
          (if (== r 2)
            (mkTArr mkIntTy (mkTArr mkIntTy mkBoolTy))
            (mkTArr mkBoolTy (mkTArr mkBoolTy mkBoolTy))))
        nargs)
    )))

; The spine of a call: the head, with the arguments pushed in order.
; The loop is `lspViewHintsApp`'s, factored so a shape and a hint
; read one spine the same way.
(pub :: lspShapeSpine (-> ASTNode (Vec ASTNode) (Option ASTNode)))
(pub fn (lspShapeSpine e args)
  {
    (let mut h e)
    {
      (while (== (nodeTag h) TAG_E_APP)
        {
          (vecPush args (nodeBChild h))
          (set h (nodeAChild h))
        })
      (lspViewReverse args)
      (lspShapeNodeOpt h)
    }
  })

; Typed bindings own each substituted node. A constructor has few
; parameters, so lookup scans the bindings. An absent binding is unbound:
; an unknown argument binds nothing, and the coverage check below
; turns the hole into an unknown shape.
(pub :: lspShapeBindGet (-> TypeEnv String (Option ASTNode)))
(pub fn (lspShapeBindGet pairs name)
  (lspShapeBindGetIn pairs name 0))

(pub :: lspShapeBindGetIn (-> TypeEnv String Int (Option ASTNode)))
(pub fn (lspShapeBindGetIn pairs name i)
  (if (|| (< i 0) (>= i (vecLen pairs)))
    None
    {
      (let binding (vecGet pairs i))
      (if (strEq binding.name name)
        (if (nodeSame binding.ty nilNode)
          None
          (Some binding.ty))
        (lspShapeBindGetIn pairs name (+ i 1)))
    }))

; A parameter's index when present. A variable that names no parameter is
; not the call's to bind.
(pub :: lspShapeParamAt (-> Strings String Int (Option Int)))
(pub fn (lspShapeParamAt params name i)
  (if (|| (< i 0) (>= i (vecLen params)))
    None
    (if (strEq (vecGet params i) name)
      (Some i)
      (lspShapeParamAt params name (+ i 1)))))

; Pair one field type with its argument's shape, recording what the
; call determines about the type's parameters: 1 for "bound, or
; nothing to bind", 0 for "contradicted". A bare parameter takes
; its argument's shape, and two shapes for one parameter must
; render equal; a constructor or arrow pairs structurally, and only
; with the same head; anything else - a concrete field against any
; argument, a parameter against an unknown one - binds nothing and
; passes, because mismatch is the checker's complaint and silence
; here would veto shapes the call does determine.
(pub :: lspShapeBind (-> ASTNode (Option ASTNode) Strings TypeEnv Int))
(pub fn (lspShapeBind ft arg params pairs)
  (if (lspShapeIsBad ft)
    0
    (if (== (nodeTag ft) TAG_T_VAR)
      {
        (let vn (nodeAName ft))
        (if (isSome (lspShapeParamAt params vn 0))
          (match arg
            ((None) 1)
            ((Some arg)
              (if (lspShapeIsBad arg)
                1
                (match (lspShapeBindGet pairs vn)
                  ((None)
                    {
                      (vecPush pairs (TypeBinding :name vn :ty arg))
                      1
                    }
                  )
                  ((Some old)
                    (if (strEq (tyRender old) (tyRender arg))
                      1
                      0)
                  )))
            ))
          1)
      }
      (match arg
        ((None) 1)
        ((Some arg)
          (if (nodeSame arg nilNode)
            1
            (if (== (nodeTag ft) TAG_T_CON)
              (if (&& (== (nodeTag arg) TAG_T_CON) (strEq (nodeAName ft) (nodeAName arg)))
                (lspShapeBindVec (nodeBChildren ft) (nodeBChildren arg) params pairs 0)
                1)
              (if (== (nodeTag ft) TAG_T_ARR)
                (if (== (nodeTag arg) TAG_T_ARR)
                  (if (==
                        (lspShapeBind (nodeAChild ft) (lspShapeNodeOpt (nodeAChild arg)) params
                          pairs)
                        0)
                    0
                    (lspShapeBind (nodeBChild ft) (lspShapeNodeOpt (nodeBChild arg)) params pairs))
                  1)
                1)))
        )))))

(pub :: lspShapeBindVec (-> Nodes Nodes Strings TypeEnv Int Int))
(pub fn (lspShapeBindVec fts args params pairs i)
  (if (>= i (vecLen fts))
    1
    (if (>= i (vecLen args))
      1
      (if (== (lspShapeBind (vecGet fts i) (lspShapeNodeOpt (vecGet args i)) params pairs) 0)
        0
        (lspShapeBindVec fts args params pairs (+ i 1))))))

; The type a constructor application builds: each field paired with
; its argument's shape, then every parameter read out in order. A
; field count that is not the argument count is unknown, and so is
; a parameter the call leaves unbound.
(pub :: lspShapeCon
  (-> (Vec ASTNode) (Vec LspOcc) String Strings (Vec ASTNode) (Vec ASTNode) Int (Option ASTNode)))
(pub fn (lspShapeCon decls occs tname params fts args fuel)
  (if (!= (vecLen fts) (vecLen args))
    None
    {
      (let pairs vecNew)
      (if (== (lspShapeBindAll decls occs fts args params pairs fuel 0) 0)
        None
        (lspShapeConBuild tname params pairs 0 vecNew))
    }))

(pub :: lspShapeBindAll (-> Nodes (Vec LspOcc) Nodes Nodes Strings TypeEnv Int Int Int))
(pub fn (lspShapeBindAll decls occs fts args params pairs fuel i)
  (if (>= i (vecLen fts))
    1
    (if (== (lspShapeBind (vecGet fts i) (lspShapeOf decls occs (vecGet args i) fuel) params pairs)
          0)
      0
      (lspShapeBindAll decls occs fts args params pairs fuel (+ i 1)))))

(pub :: lspShapeConBuild (-> String Strings TypeEnv Int Nodes (Option ASTNode)))
(pub fn (lspShapeConBuild tname params pairs i acc)
  (if (>= i (vecLen params))
    (Some (mkTCon tname acc))
    (match (lspShapeBindGet pairs (vecGet params i))
      ((None) None)
      ((Some t)
        {
          (vecPush acc t)
          (lspShapeConBuild tname params pairs (+ i 1) acc)
        }
      ))))

; `t` with each parameter replaced by its argument: fresh nodes,
; the arguments shared. Arity is the caller's check, and a
; variable that names no parameter is shared as it stands.
(pub :: lspShapeSubst (-> ASTNode Strings (Vec ASTNode) (Option ASTNode)))
(pub fn (lspShapeSubst t params args)
  (if (nodeSame t nilNode)
    None
    (if (== (nodeTag t) TAG_T_VAR)
      (match (lspShapeParamAt params (nodeAName t) 0)
        ((None) (Some t))
        ((Some at)
          (if (>= at (vecLen args))
            None
            {
              (let arg (vecGet args at))
              (if (nodeSame arg nilNode)
                None
                (Some arg))
            })
        ))
      (if (== (nodeTag t) TAG_T_CON)
        (match (lspShapeSubstVec (nodeBChildren t) params args 0 vecNew)
          ((None) None)
          ((Some ts) (Some (mkTCon (nodeAName t) ts))))
        (if (== (nodeTag t) TAG_T_ARR)
          {
            (let domain (lspShapeSubst (nodeAChild t) params args))
            (match domain
              ((None) None)
              ((Some domain)
                {
                  (let result (lspShapeSubst (nodeBChild t) params args))
                  (match result
                    ((None) None)
                    ((Some result) (Some (mkTArr domain result))))
                }
              ))
          }
          (Some t))))))

(pub :: lspShapeSubstVec (-> Nodes Strings Nodes Int Nodes (Option Nodes)))
(pub fn (lspShapeSubstVec ts params args i acc)
  (if (|| (== (as ts Int) 0) (>= i (vecLen ts)))
    (Some acc)
    (match (lspShapeSubst (vecGet ts i) params args)
      ((None) None)
      ((Some t)
        {
          (vecPush acc t)
          (lspShapeSubstVec ts params args (+ i 1) acc)
        }
      ))))

; A `data`'s or `struct`'s type parameters. A `data` always writes
; its vector; a struct with none leaves the slot 0 (see
; `parseFieldsTv`), which is why this is not `nodeTyChildren` outright.
(pub :: lspShapeTyParams (-> ASTNode Strings))
(pub fn (lspShapeTyParams d)
  (if (== (nodeTy d) 0)
    vecNew
    (nodeTyNames d)))

; The field types of a struct's fields, in order.
(pub :: lspShapeFieldTys (-> (Vec ASTNode) Int (Vec ASTNode) (Option (Vec ASTNode))))
(pub fn (lspShapeFieldTys fs i acc)
  (if (|| (== (as fs Int) 0) (>= i (vecLen fs)))
    (Some acc)
    (match (lspShapeNodeOpt (nodeTyChild (vecGet fs i)))
      ((None) None)
      ((Some ty)
        {
          (vecPush acc ty)
          (lspShapeFieldTys fs (+ i 1) acc)
        }
      ))))

; The `k`th parameter type of the `::` signature naming `owner`:
; the one lookup behind a parameter's hover, and behind a
; variable's shape. None means no signature or no arrow there.
(pub :: lspShapeParamTy (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspShapeParamTy decls owner k)
  {
    (let sig (lspFindSig decls owner (- (vecLen decls) 1)))
    (if (let (Some sig) sig)
      (nthParamTy (nodeTyChild sig) k)
      None)
  })

; The arrows of a curried type: `Int` is 0, `(-> Int Int)` is 1.
(pub :: lspShapeArrowArity (-> ASTNode Int))
(pub fn (lspShapeArrowArity ty)
  (if (nodeSame ty nilNode)
    0
    (if (!= (nodeTag ty) TAG_T_ARR)
      0
      (+ 1 (lspShapeArrowArity (nodeBChild ty))))))

; A nullary constructor as a value: its `data`, when the `data`
; takes no arguments. `(Dot)` is `Shape`; `(Nothing)` is unknown,
; because its `a` is determined nowhere - the same coverage rule
; `lspShapeCon` applies to a call. A constructor that TAKES
; arguments is unknown as a bare value, because the checker
; refuses it (AX3009) rather than typing it.
(pub :: lspShapeCtorVar (-> (Vec ASTNode) String (Option ASTNode)))
(pub fn (lspShapeCtorVar decls name)
  {
    (let dat (lspFindCtorData decls name (- (vecLen decls) 1)))
    (if (let (Some dat) dat)
      {
        (let c (lspCtorNodeOf (Some dat) name))
        (if (let (Some c) c)
          (if (!= (vecLen (nodeTyChildren c)) 0)
            None
            (if (!= (vecLen (lspShapeTyParams dat)) 0)
              None
              (Some (mkTCon (nodeAName dat) vecNew))))
          None)
      }
      None)
  })

; A variable's shape through its binder: a parameter through the
; owning signature, a `let` through its value with one fuel spent.
; `true` and `false` are `Bool` the way the checker types them.
; A top-level name as a value is read the way `checkBareValue`
; reads it: a `fn` of fewer than two arguments answers its
; signature's type - a nullary `(:: seven Int)` used as `seven`,
; or a one-argument `fn` named without being called - and a
; `fn` of two or more is unknown, because the checker refuses
; the bare value (AX3013) rather than typing it. A nullary
; constructor answers its `data`. Signatures and constructors
; from this document only; anything imported is the next
; slice's read.
(pub :: lspShapeVar (-> (Vec ASTNode) (Vec LspOcc) ASTNode Int (Option ASTNode)))
(pub fn (lspShapeVar decls occs e fuel)
  {
    (let name (nodeAName e))
    (if (strEq name "true")
      (Some mkBoolTy)
      (if (strEq name "false")
        (Some mkBoolTy)
        (if (== (nodeSpan e) 0)
          None
          (if (let (Some o) (lspNavAt occs (spanStart (nodeSpan e))))
            {
              (let key o.key)
              (if (lspNavIsLocal key)
                (match (lspNavBinderOf occs key)
                  ((None) None)
                  ((Some b)
                    {
                      (let bkind b.bkind)
                      (if (== bkind NAV_B_PARAM)
                        (if (let (Some t) (lspShapeParamTy decls b.owner b.param))
                          (if (lspShapeIsBad t)
                            None
                            (Some t))
                          None)
                        (if (== bkind NAV_B_LET)
                          (if (<= fuel 0)
                            None
                            (if (let (Some v) b.value)
                              (lspShapeOf decls occs v (- fuel 1))
                              None))
                          None))
                    }
                  ))
                {
                  (let sig (lspFindSig decls name (- (vecLen decls) 1)))
                  (if (let (Some sig) sig)
                    {
                      (let t (nodeTyChild sig))
                      (if (lspShapeIsBad t)
                        None
                        (if (>= (lspShapeArrowArity t) 2)
                          None
                          (Some t)))
                    }
                    (lspShapeCtorVar decls name))
                })
            }
            None))))
  })

; Two branches' join: the shape when both agree, unknown when they
; do not. Rendered strings are the comparison, because the two
; nodes are built apart and share nothing.
(pub :: lspShapeJoin (-> (Option ASTNode) (Option ASTNode) (Option ASTNode)))
(pub fn (lspShapeJoin a b)
  (match a
    ((None) None)
    ((Some a)
      (if (lspShapeIsBad a)
        None
        (match b
          ((None) None)
          ((Some b)
            (if (lspShapeIsBad b)
              None
              (if (strEq (tyRender a) (tyRender b))
                (Some a)
                None))
          )))
    )))

; A block's shape is its last expression's.
(pub :: lspShapeBegin (-> (Vec ASTNode) (Vec LspOcc) (Vec ASTNode) Int (Option ASTNode)))
(pub fn (lspShapeBegin decls occs xs fuel)
  (if (== (as xs Int) 0)
    None
    (if (== (vecLen xs) 0)
      None
      (lspShapeOf decls occs (vecGet xs (- (vecLen xs) 1)) fuel))))

; A `match`'s shape: every arm body's, when they agree.
(pub :: lspShapeMatch (-> (Vec ASTNode) (Vec LspOcc) (Vec ASTNode) Int (Option ASTNode)))
(pub fn (lspShapeMatch decls occs arms fuel)
  (if (== (as arms Int) 0)
    None
    (if (== (vecLen arms) 0)
      None
      (lspShapeMatchIn decls occs arms fuel 1 (lspShapeArmBody decls occs (vecGet arms 0) fuel)))))

(pub :: lspShapeArmBody (-> (Vec ASTNode) (Vec LspOcc) ASTNode Int (Option ASTNode)))
(pub fn (lspShapeArmBody decls occs arm fuel)
  (if (nodeSame arm nilNode)
    None
    (if (!= (nodeTag arm) TAG_M_ARM)
      None
      (lspShapeOf decls occs (nodeBChild arm) fuel))))

(pub :: lspShapeMatchIn
  (-> (Vec ASTNode) (Vec LspOcc) (Vec ASTNode) Int Int (Option ASTNode) (Option ASTNode)))
(pub fn (lspShapeMatchIn decls occs arms fuel i acc)
  (if (>= i (vecLen arms))
    acc
    (match (lspShapeJoin acc (lspShapeArmBody decls occs (vecGet arms i) fuel))
      ((None) None)
      ((Some joined) (lspShapeMatchIn decls occs arms fuel (+ i 1) (Some joined))))))

; `true` for a head from another module, whatever the pipeline
; stage spelled it with: `::` in the raw tree, `$` after mangling.
(pub :: lspShapeQualified (-> String Bool))
(pub fn (lspShapeQualified name)
  (|| (isSome (strFindByte name 58 0)) (isSome (strFindByte name 36 0))))

; A call's shape, asked in the language's own order: this
; document's signature first, so a declaration shadows a builtin
; of the same spelling; then the builtin table; then, for an
; upcased head, the struct or constructor the name declares.
(pub :: lspShapeApp (-> (Vec ASTNode) (Vec LspOcc) ASTNode Int (Option ASTNode)))
(pub fn (lspShapeApp decls occs e fuel)
  {
    (let args vecNew)
    (match (lspShapeSpine e args)
      ((None) None)
      ((Some h)
        (if (!= (nodeTag h) TAG_E_VAR)
          None
          {
            (let name (nodeAName h))
            (if (lspShapeQualified name)
              None
              {
                (let sig (lspFindSig decls name (- (vecLen decls) 1)))
                (if (let (Some sig) sig)
                  (lspShapeApplyArrow (nodeTyChild sig) (vecLen args))
                  (if (isSome (lspShapeBuiltinRes name))
                    (lspShapeBuiltinTy name (vecLen args))
                    (if (== (lspIsUpperStart name) 1)
                      (lspShapeUpCon decls occs name args fuel)
                      None)))
              })
          })
      ))
  })

; An upcased head: a struct built positionally, or a constructor
; of the `data` that declares it - verified, not spelled: a name
; that is neither answers unknown.
(pub :: lspShapeUpCon (-> (Vec ASTNode) (Vec LspOcc) String (Vec ASTNode) Int (Option ASTNode)))
(pub fn (lspShapeUpCon decls occs name args fuel)
  {
    (let d (lspFindTypeDecl decls name (- (vecLen decls) 1)))
    (if (let (Some d) d)
      (if (== (nodeTag d) TAG_D_STRUCT)
        (match (lspShapeFieldTys (nodeBChildren d) 0 vecNew)
          ((None) None)
          ((Some fields) (lspShapeCon decls occs name (lspShapeTyParams d) fields args fuel)))
        {
          (let dat (lspFindCtorData decls name (- (vecLen decls) 1)))
          (if (let (Some dat) dat)
            {
              (let c (lspCtorNodeOf (Some dat) name))
              (if (let (Some c) c)
                (lspShapeCon decls occs (nodeAName dat) (lspShapeTyParams dat) (nodeTyChildren c)
                  args fuel)
                None)
            }
            None)
        })
      {
        (let dat (lspFindCtorData decls name (- (vecLen decls) 1)))
        (if (let (Some dat) dat)
          {
            (let c (lspCtorNodeOf (Some dat) name))
            (if (let (Some c) c)
              (lspShapeCon decls occs (nodeAName dat) (lspShapeTyParams dat) (nodeTyChildren c)
                args fuel)
              None)
          }
          None)
      })
  })

; A field read: the field's declared type, with the base's
; arguments in place of the struct's parameters. The base is
; whatever shape the walk resolved - a parameter, a `let`, a
; call result - so a call result reaches its field here where
; `lspFieldBaseStruct` answers None; that function's own
; migration onto this walk is the next slice.
(pub :: lspShapeField (-> (Vec ASTNode) (Vec LspOcc) ASTNode Int (Option ASTNode)))
(pub fn (lspShapeField decls occs e fuel)
  (match (lspShapeOf decls occs (nodeAChild e) fuel)
    ((None) None)
    ((Some b)
      (if (lspShapeIsBad b)
        None
        (if (!= (nodeTag b) TAG_T_CON)
          None
          (match (lspFindTypeDecl decls (nodeAName b) (- (vecLen decls) 1))
            ((None) None)
            ((Some d)
              (if (!= (nodeTag d) TAG_D_STRUCT)
                None
                (match (lspStructFieldNode (nodeBChildren d) (nodeBName e) 0)
                  ((None) None)
                  ((Some f)
                    {
                      (let ft (nodeTyChild f))
                      (if (lspShapeIsBad ft)
                        None
                        {
                          (let ps (lspShapeTyParams d))
                          (let raw (nodeBChildren b))
                          (let args
                            (if (== (as raw Int) 0)
                              vecNew
                              raw))
                          (if (!= (vecLen ps) (vecLen args))
                            None
                            (lspShapeSubst ft ps args))
                        })
                    }
                  )))
            ))))
    )))

; The shape of an expression: a literal's kind, a variable
; through its binder, a call through its signature, table row or
; constructor, a branch or block through what it yields. A `set`
; evaluates to 0, the checker's rule as much as the emitter's.
; Anything else - a `lambda`, a loop, a form this slice does not
; read - is unknown.
(pub :: lspShapeOf (-> (Vec ASTNode) (Vec LspOcc) ASTNode Int (Option ASTNode)))
(pub fn (lspShapeOf decls occs e fuel)
  (if (nodeSame e nilNode)
    None
    {
      (let tag (nodeTag e))
      (if (== tag TAG_E_INT)
        (if (isUnitLit e)
          (Some mkUnitTy)
          (Some mkIntTy))
        (if (== tag TAG_E_STR)
          (Some mkStringTy)
          (if (== tag TAG_E_CHAR)
            (Some mkCharTy)
            (if (== tag TAG_E_FLT)
              (Some mkFloatTy)
              (if (== tag TAG_E_VAR)
                (lspShapeVar decls occs e fuel)
                (if (== tag TAG_E_APP)
                  (lspShapeApp decls occs e fuel)
                  (if (== tag TAG_E_IF)
                    (lspShapeJoin (lspShapeOf decls occs (nodeBChild e) fuel)
                      (lspShapeOf decls occs (nodeCChild e) fuel))
                    (if (== tag TAG_E_BEGIN)
                      (lspShapeBegin decls occs (nodeAChildren e) fuel)
                      (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
                        (lspShapeOf decls occs (nodeCChild e) fuel)
                        (if (== tag TAG_E_MATCH)
                          (lspShapeMatch decls occs (nodeBChildren e) fuel)
                          (if (== tag TAG_E_FIELD)
                            (lspShapeField decls occs e fuel)
                            (if (|| (== tag TAG_E_SET) (== tag TAG_E_SETF))
                              (Some mkIntTy)
                              None))))))))))))
    }))

; A binder's shape: a parameter's from its signature, a `let`'s
; from its value. A lambda parameter or pattern variable carries
; no value to read - unknown, until the call sites that could
; type them are a slice of their own.
(pub :: lspShapeOfBinder (-> (Vec ASTNode) (Vec LspOcc) LspOcc (Option ASTNode)))
(pub fn (lspShapeOfBinder decls occs b)
  {
    (let bkind b.bkind)
    (if (== bkind NAV_B_PARAM)
      (if (let (Some t) (lspShapeParamTy decls b.owner b.param))
        (if (lspShapeIsBad t)
          None
          (Some t))
        None)
      (if (== bkind NAV_B_LET)
        (if (let (Some v) b.value)
          (lspShapeOf decls occs v 16)
          None)
        None))
  })

; A `let`'s hover code: the binding pair, with the value's shape
; under it when the walk knows one. The pair is first and the
; type second, because the binding is the answer and the type
; annotates it; an unknown shape leaves the pair exactly as it
; was.
(pub :: lspShapeLetCode (-> String (Vec ASTNode) (Vec LspOcc) LspOcc Int String String))
(pub fn (lspShapeLetCode src decls occs b at name)
  {
    (let pair (lspClampLines (lspFormText src (lspNearestOpen src at)) 40))
    (match (lspShapeOfBinder decls occs b)
      ((None) pair)
      ((Some t)
        (if (lspShapeIsBad t)
          pair
          (concat pair (concat "\n" (concat name (concat " : " (tyRender t))))))
      ))
  })

; A hover for a local: the binding AS WRITTEN, and a line saying what
; kind of binding it is, so a reader knows whether the fence is a
; `let` pair, a parameter, or a pattern.
;
;   let       the binding pair, `(x (+ a 1))` or `(mut i 0)`, cut from
;             the pair's own `(` to its `)` and clamped like every
;             other fence, with `x : T` under it when the value's
;             shape is known
;   fn param  `x : Int` when the `fn` has a `::` signature with an
;             arrow at that position, else `x`
;   lambda param, pattern variable
;             the name, then the line it is bound on
(pub :: lspNavLocalHover (-> String (Vec ASTNode) Ints Int Int))
(pub fn (lspNavLocalHover src decls ix wsp)
  {
    (let occs (lspNavOccurrences src decls))
    (if (let (Some o) (lspNavAt occs (spanStart wsp)))
      {
        (let key o.key)
        (if (lspNavIsLocal key)
          (match (lspNavBinderOf occs key)
            ((None) 0)
            ((Some b)
              {
                (let bkind b.bkind)
                (let owner b.owner)
                (let name b.name)
                (let at (spanStart b.span))
                {
                  (let code
                    (if (== bkind NAV_B_LET)
                      (lspShapeLetCode src decls occs b at name)
                      (if (== bkind NAV_B_PARAM)
                        (lspNavParamCode decls owner name b.param)
                        (concat name (concat "\n" (lspNavLineText src at))))))
                  (let prose
                    (if (== bkind NAV_B_LET)
                      "bound by `let` in `"
                      (if (== bkind NAV_B_PARAM)
                        "parameter of `"
                        (if (== bkind NAV_B_LAMBDA)
                          "parameter of a `lambda` in `"
                          "bound by a pattern in `"))))
                  {
                    (let value
                      (concat "```axiom\n"
                        (concat code (concat "\n```\n\n" (concat prose (concat owner "`\n"))))))
                    (jsonObjPut
                      (jsonObjPut jsonObj "contents"
                        (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value"
                          (jsonStr value)))
                      "range" (lspRangeIx src ix wsp))
                  }
                }
              }
            ))
          0)
      }
      0)
  })

; `name : T` from the owning function's signature, when it has one and
; the arrow reaches position `k`; the bare name otherwise. The type is
; rendered from the tree rather than sliced, because a signature's
; type nodes carry no spans.
(pub :: lspNavParamCode (-> (Vec ASTNode) String String Int String))
(pub fn (lspNavParamCode decls owner name k)
  (if (let (Some t) (lspShapeParamTy decls owner k))
    (concat name (concat " : " (tyRender t)))
    name))

; The line `off` sits on, without its indentation.
(pub :: lspNavLineText (-> String Int String))
(pub fn (lspNavLineText src off)
  {
    (let n (strLen src))
    (let mut s (lineStartOf src off))
    (let e (lineEndFrom src off))
    {
      (while (&& (< s e) (docIsBlank (strByte src s)))
        (set s (+ s 1)))
      (if (>= s e)
        ""
        (strSlice src s (- e s)))
    }
  })

; ------------------------------------------------------------------
; `textDocument/declaration`: the SIGNATURE, where the language has
; one to point at.
;
; This is not a synonym for `definition` in Axiom, and that is the
; whole reason it exists. A function is written twice - `(:: f (-> Int
; Int))` declares it and `(fn (f x) ...)` defines it - and the parser
; keeps both, as TAG_D_SIG and TAG_D_FN nodes carrying their own name
; spans. So `definition` lands on the `fn` (`lspFindDecl` skips
; TAG_D_SIG deliberately, and its comment says why) and `declaration`
; lands on the `::` above it. In C that distinction is a header and a
; translation unit; here it is two lines of one file, and no other
; request in this server answers it.
;
; THE LOOKUP ORDER IS `definition`'S, with one step inserted, because
; the order is the language's scoping rule and not a preference:
;
;   1. A LOCAL BINDING - a `let`, a parameter, a pattern variable.
;      A local is declared by being bound, so its declaration IS its
;      definition and this answers exactly what `definition` does.
;   2. THIS DOCUMENT'S `(:: name T)`, last one winning, which is
;      `lspFindSig`'s rule and `lspFindDecl`'s.
;   3. THIS DOCUMENT'S declaration of that name - a `fn` with no
;      signature, a `data`, a `struct`, a macro. None of those is
;      written twice, so the declaration is the definition and this
;      answers what `definition` answers. Step 3 must come before any
;      imported lookup: a module's own declaration shadows an imported
;      one.
;   4. THE IMPORTED MODULES, signature first and declaration second,
;      resolved the way `lspDefinitionImported` resolves them.
;
; WHAT THAT MAKES TRUE, and it is the property the gate checks: this
; request answers null exactly where `definition` answers null, and
; differs from it exactly on the names that carry a `(:: ...)`.
;
; ONE CASE WHERE IT ANSWERS AND `definition` DOES NOT: a signature
; with no `fn` under it - a half-written declaration, or one whose
; body is still to come. There IS a declaration there, so saying where
; it is beats saying nothing.
(pub :: lspDeclaration (-> LspWorkspace String String Int String Int))
;@axiom:effect(io)
(pub fn (lspDeclaration workspace src uri params gen)
  {
    (let decls (lspNavParse src))
    (if (== (as decls Int) 0)
      jsonNull
      {
        (let ix (lspLineIndex src))
        {
          (let off (lspOffsetOf src ix (jsonGet params "position")))
          {
            (let w (lspWordAt src off))
            (if (== (strLen w) 0)
              jsonNull
              {
                (let loc (lspNavLocalDefinition src uri ix decls off))
                (if (!= loc 0)
                  loc
                  {
                    (let s (lspFindSig decls w (- (vecLen decls) 1)))
                    (if (let (Some s) s)
                      (lspNavLocOf uri src (nodeSpan s))
                      {
                        (let d (lspFindDecl decls w (- (vecLen decls) 1)))
                        (if (let (Some d) d)
                          (lspNavLocOf uri src (nodeSpan d))
                          ; Step 3a: a constructor. It is not written
                          ; twice, so there is no `(:: ...)` step 2
                          ; could have preferred and this answers what
                          ; `definition` answers - the rule step 3
                          ; already states for a `data` or a macro.
                          {
                            (let c (lspCtorDefinition src uri decls w))
                            (if (!= c 0)
                              c
                              ; A GENERATED NAME, last, for `definition`'s
                              ; reason: the invocation head is what a
                              ; generated name is declared by.
                              {
                                (let dec
                                  (lspDeclarationImported workspace (lspUriToPath uri) src decls w))
                                (if (jsonIsNull dec)
                                  (lspGenDefinition gen uri src w)
                                  dec)
                              })
                          })
                      })
                  })
              })
          }
        }
      })
  })

; A Location, from a uri and a span into that uri's own text.
(pub :: lspNavLocOf (-> String String Int Int))
(pub fn (lspNavLocOf uri src span)
  (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRange src span)))

; Steps 4 and 5, over the merged list `resolveImports` answers: the
; signature the declaring module wrote, else its declaration. The
; comparison is against `bareOf`, because an imported name is mangled
; (`Vec$vecPush`) and `resolveImports` mangles a signature and its
; definition the same way.
(pub :: lspDeclarationImported (-> LspWorkspace String String (Vec ASTNode) String Int))
;@axiom:effect(io)
(pub fn (lspDeclarationImported workspace path src decls w)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let s (lspFindImportedSig allDecls w (- (vecLen allDecls) 1)))
        (if (let (Some s) s)
          (lspUnitLocation units s)
          {
            (let d (lspFindImported allDecls w (- (vecLen allDecls) 1)))
            (if (let (Some d) d)
              (lspUnitLocation units d)
              (lspCtorDefinitionImported allDecls units w))
          })
      }
    }
    jsonNull))

; The Location of an imported declaration, in the file that declares
; it: the unit table says which file, and the span indexes that file's
; bytes rather than this document's. 0 for "no declaration", and a
; declaration the resolver did not attribute to a unit, which is what
; `lspUnitOf`'s -1 means.
(pub :: lspUnitLocation (-> Units ASTNode Int))
;@axiom:effect(io)
(pub fn (lspUnitLocation units d)
  (if (nodeSame d nilNode)
    jsonNull
    {
      (let u (lspUnitOf units (nodeModuleOpt d)))
      (match u
        ((None) jsonNull)
        ((Some u)
          {
            (let unit (vecGet units u))
            (lspNavLocOf (lspPathToUri (unitFile unit)) (unitSrc unit) (nodeSpan d))
          }
        ))
    }))

; The last `(:: name T)` the MERGED list carries for `name`, under a
; bare comparison - `lspFindSig` with `lspFindImported`'s two rules.
(pub :: lspFindImportedSig (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindImportedSig decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_SIG)
            (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        (Some d)
        (lspFindImportedSig decls name (- i 1)))
    }))

; The last top-level `fn` this list declares under `name`. Call
; hierarchy asks about functions and nothing else - a `data`, a
; `struct` and a macro have no body to call out of - so this is
; `lspFindDecl` narrowed to TAG_D_FN.
(pub :: lspFindFn (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindFn decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        (Some d)
        (lspFindFn decls name (- i 1)))
    }))

(pub :: lspFindImportedFn (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindImportedFn decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN)
            (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        (Some d)
        (lspFindImportedFn decls name (- i 1)))
    }))

; ------------------------------------------------------------------
; CALL HIERARCHY: `textDocument/prepareCallHierarchy`,
; `callHierarchy/incomingCalls` and `callHierarchy/outgoingCalls`.
;
; WHAT A CALL SITE IS HERE, and it is the whole of the design: an
; occurrence that this section's walk already resolved to a top-level
; name, standing in the HEAD position of a form. Two questions, two
; existing answers, intersected by byte offset:
;
;   * WHAT DOES THIS NAME MEAN - `lspNavOccurrences`, the walk
;     `references` and `rename` are projections of. It follows the
;     language's scoping, so `(fn (apply k v) (k v))` does not report
;     a call to a top-level `k`: the head's key is `@<offset>`, a
;     local binder, and locals are dropped. It also gives the OWNER of
;     every occurrence - the top-level declaration it sits in - which
;     is the caller side of every edge below, for free.
;   * IS IT A HEAD - `lspChHeads`, one linear scan of the bytes
;     recording the first identifier after each `(`, with the scanner
;     `lspFormEnd` uses so that a `(` inside a string, a char literal
;     or a comment opens nothing. `(cons f g)` therefore names `f` and
;     `g` and calls neither, which is what `#effects=` on a naming
;     function had to learn separately (`effIsPossible`).
;
; WHY NOT `symbols --calls`. That key exists and this does not use it.
; It is the CHECKER's edge set, harvested from the effect walk's
; `FnEnt` word 7, so it costs a full typecheck and - the part that
; settles it - it is a set of NAMES with no positions in it at all.
; `CallHierarchyIncomingCall.fromRanges` is required by the protocol
; and is a list of ranges, so the tree would have had to be walked for
; them anyway; and a request an editor makes while someone reads code
; should not run the checker (MAC-TOOL-3). The two answers agree on
; what an edge is where they overlap, and this one is a strict subset:
; naming a function without applying it is an edge to the effect walk
; and is not a call here.
;
; WHAT IS DELIBERATELY NOT ANSWERED, because answering it would mean
; guessing:
;
;   * PREPARE OVER AN IMPORTED NAME is null. The two requests that
;     follow carry the ITEM and nothing else, so the server must be
;     able to reach the item's document from the item's uri alone -
;     true for a document the editor has open, and not true for a
;     module it resolved once from a document it is no longer told
;     about. Go to the definition first and ask there.
;   * AN ITEM WHOSE DOCUMENT IS NOT OPEN is null, and null rather
;     than `[]`: `[]` says "this function has no callers", which is a
;     claim, and a server that cannot read the file has not earned it.
;   * A CALLEE THAT IS NOT A `fn` this server can point at - a
;     builtin, an operator, a constructor - is left out of the
;     outgoing list rather than given an item with nowhere to jump.
;
; INCOMING CALLS READ THE OPEN DOCUMENTS AND NOTHING ELSE, which is
; `references`'s rule and for its reason: the store is the workspace.
; `lspNavImporters` says which of them import the item's file, and a
; document that declares the name itself shadows the import, so its
; sites are not the item's - the key is `?name` in an importer and
; `name` in the item's own document, and that difference is the test.
; ------------------------------------------------------------------
; Every offset at which an identifier stands FIRST inside a `(`, as
; the bucket table `lspNavLocalIndexHas` reads.
;
; One pass, the scanner `lspFormEnd` uses. `pending` survives a
; comment, because `(  ; why\n  f x)` still has `f` as its head, and
; survives blank space for the same reason; every other byte clears
; it, so the `1` of `(1 2)` and the `(` of `((g 1) 2)` are not heads.
(pub :: lspChHeads (-> String LspBuckets))
(pub fn (lspChHeads src)
  {
    (let offs (lspChHeadOffsets src))
    {
      (let nb (fnIdxBuckets (vecLen offs)))
      (let bs (lspBucketsNew nb))
      {
        (for i in 0..(vecLen offs)
          (lspNavIntPut bs (vecGet offs i)))
        bs
      }
    }
  })

(pub :: lspChHeadOffsets (-> String Ints))
(pub fn (lspChHeadOffsets src)
  {
    (let n (strLen src))
    (let out vecNew)
    (let mut i 0)
    (let mut pending 0)
    {
      (while (< i n)
        {
          (let ch (strByte src i))
          (if (== ch 34)
            {
              (set pending 0)
              (set i (skipStringBody src (+ i 1) n))
            }
            (if (isIdentStart ch)
              {
                (if (== pending 1)
                  (vecPush out i))
                (set pending 0)
                (set i (skipIdent src (+ i 1) n))
              }
              (if (== ch 39)
                {
                  (set pending 0)
                  (set i (skipCharBody src (+ i 1) n))
                }
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    {
                      (if (== ch 40)
                        (set pending 1)
                        (if (! (lspIsSpace ch))
                          (set pending 0)))
                      (set i (+ i 1))
                    })))))
        })
      out
    }
  })

; Whether a key names something a call can reach: a top-level
; declaration of this document, or a name this document does not
; declare (imported, or a builtin). A constructor key carries `#` and
; is not one - `(Just x)` in a pattern is a head and destructures
; rather than calls - and a local key is not one either.
(pub :: lspChCallable (-> String Bool))
(pub fn (lspChCallable key)
  (if (== (strLen key) 0)
    false
    (if (== (strByte key 0) 63)
      true
      (if (lspNavIsTop key)
        (if (let (Some _) (strFindByte key 35 0))
          false
          true)
        false))))

; Every call site in one document, as the occurrence records
; themselves - word 0 the callee's bare name, word 1 its span, word 5
; the caller.
(pub :: lspChSites (-> String (Vec ASTNode) (Vec LspOcc)))
(pub fn (lspChSites src decls)
  {
    (let occs (lspNavOccurrences src decls))
    (let heads (lspChHeads src))
    (let out vecNew)
    {
      (for o in occs
        (if (&& (== o.role NAV_READ)
              (&& (!= o.span 0)
                (&& (lspNavLocalIndexHas heads (spanStart o.span)) (lspChCallable o.key))))
          (vecPush out o)))
      out
    }
  })

; A CallHierarchyItem for declaration `d` of `src`, at `uri`.
;
; `selectionRange` is the name, exactly as the outline publishes it,
; and `range` is the whole form - from the `(` that opens it to its
; matching `)`, both found by the scanner every other bracket question
; here uses. The protocol requires the second to contain the first,
; and a form contains its own name.
(pub :: lspChItem (-> String Ints String ASTNode Int))
(pub fn (lspChItem src ix uri d)
  {
    (let fs (lspFormStart src (spanStart (nodeSpan d))))
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut
          (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (bareOf (nodeAName d)))) "kind"
            (jsonNum 12))
          "uri" (jsonStr uri))
        "range" (lspRangeIx src ix (mkSpan fs (lspFormEnd src fs))))
      "selectionRange" (lspRangeIx src ix (nodeSpan d)))
  })

; `textDocument/prepareCallHierarchy`: the one item a hierarchy can be
; rooted at here - the top-level `fn` the cursor names, in THIS
; document. A local, a `data`, a `struct`, a macro, an imported name
; and a document that does not parse are all null, which is the
; protocol's "nothing here".
(pub :: lspPrepareCallHierarchy (-> String String Int Int))
(pub fn (lspPrepareCallHierarchy src uri params)
  {
    (let decls (lspNavParse src))
    (if (== (as decls Int) 0)
      jsonNull
      {
        (let ix (lspLineIndex src))
        {
          (let off (lspOffsetOf src ix (jsonGet params "position")))
          {
            (let w (lspWordAt src off))
            (if (== (strLen w) 0)
              jsonNull
              (if (!= (lspNavLocalDefinition src uri ix decls off) 0)
                jsonNull
                {
                  (let d (lspFindFn decls w (- (vecLen decls) 1)))
                  (if (let (Some d) d)
                    (jsonArrPush jsonArr (lspChItem src ix uri d))
                    jsonNull)
                }))
          }
        }
      })
  })

; The item a hierarchy request carries: its document's uri and text,
; the name, the parsed declarations, and the declaration itself.
(pub struct LspHierSubject
  (uri : String)
  (name : String)
  (src : String)
  (decls : Nodes)
  (decl : (Option ASTNode)))

; The item a hierarchy request carries, as (uri, name), and the checks
; both requests share: the document must be open, must parse, and must
; declare `name` as a `fn`. Answers `None` when any of those fails,
; and every caller turns that into null.
(pub :: lspChSubject (-> Int Strings Strings (Option LspHierSubject)))
(pub fn (lspChSubject params uris texts)
  {
    (let item (jsonGet params "item"))
    {
      (let uri (jsonGetStr item "uri"))
      (let name (jsonGetStr item "name"))
      (if (let (Some src) (docText uris texts uri))
        (if (|| (== (strLen src) 0) (== (strLen name) 0))
          None
          {
            (let decls (lspNavParse src))
            (if (== (as decls Int) 0)
              None
              {
                (let d (lspFindFn decls name (- (vecLen decls) 1)))
                (if (let (Some d) d)
                  (Some (LspHierSubject :uri uri :name name :src src :decls decls :decl (Some d)))
                  None)
              })
          })
        None)
    }
  })

; `callHierarchy/incomingCalls`: who calls this function.
(pub :: lspIncomingCalls (-> LspWorkspace Int Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspIncomingCalls workspace params uris texts)
  (if (let (Some s) (lspChSubject params uris texts))
    {
      (let uri s.uri)
      (let name s.name)
      (let out jsonArr)
      {
        (lspChIncomingIn out uri s.src s.decls name 0)
        (lspChIncomingImporters workspace out uri name uris texts)
        out
      }
    }
    jsonNull))

; The callers inside ONE document. `foreign` is 0 for the item's own
; document, where a call to it resolves to the key `name`, and 1 for a
; document that imports it, where it resolves to `?name` - a document
; that declares its own `name` shadows the import and its sites belong
; to that declaration instead, which is exactly what the key says.
(pub :: lspChIncomingIn (-> Int String String (Vec ASTNode) String Int Int))
(pub fn (lspChIncomingIn out ouri osrc odecls name foreign)
  {
    (let want
      (if (== foreign 1)
        (concat "?" name)
        name))
    (let oix (lspLineIndex osrc))
    (let sites (lspChSites osrc odecls))
    (let owners lspChGroupsNew)
    {
      (for o in sites
        (if (&& (strEq o.name name) (strEq o.key want))
          (lspChGroupPush owners o.owner o.span)))
      (for g in owners
        {
          (let d (lspFindFn odecls g.key (- (vecLen odecls) 1)))
          (if (let (Some d) d)
            (jsonArrPush out
              (jsonObjPut (jsonObjPut jsonObj "from" (lspChItem osrc oix ouri d)) "fromRanges"
                (lspChRanges osrc oix g.spans)))
            ())
        })
      0
    }
  })

; The same, over every OPEN document that imports the item's file.
(pub :: lspChIncomingImporters (-> LspWorkspace Int String String Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspChIncomingImporters workspace out uri name uris texts)
  {
    (let imps (lspNavImporters workspace uri uris texts))
    {
      (for pair in imps
        (lspChIncomingIn out (vecGet uris pair.index) (vecGet texts pair.index) pair.decls name 1))
      0
    }
  })

; A grouping table: a Vec of (key, Vec of spans) groups, in first-seen
; order. The protocol's shape is one entry per caller (or callee) with
; every range under it, and a client that received the same function
; twice would draw it twice.
(pub struct LspChGroup
  (key : String)
  (spans : Ints))

; An empty grouping table. A typed constructor rather than `vecNew`:
; a field read through an element of a `vecNew` whose type a later call
; fixes is refused by the checker.
(:: lspChGroupsNew (Vec LspChGroup))
(fn (lspChGroupsNew)
  vecNew)

(pub :: lspChGroupPush (-> (Vec LspChGroup) String Int Int))
(pub fn (lspChGroupPush groups key span)
  {
    (let n (vecLen groups))
    (let mut i 0)
    (let mut at (- 0 1))
    {
      (while (< i n)
        {
          (let g (vecGet groups i))
          (if (strEq g.key key)
            {
              (set at i)
              (set i n)
            }
            (set i (+ i 1)))
        })
      (if (>= at 0)
        {
          (let g (vecGet groups at))
          (vecPush g.spans span)
        }
        {
          (let spans vecNew)
          (vecPush spans span)
          (vecPush groups (LspChGroup :key key :spans spans))
        })
      0
    }
  })

; A Vec of spans as a JSON array of Ranges into `src`.
(pub :: lspChRanges (-> String Ints Ints Int))
(pub fn (lspChRanges src ix spans)
  {
    (let out jsonArr)
    {
      (for i in 0..(vecLen spans)
        (jsonArrPush out (lspRangeIx src ix (vecGet spans i))))
      out
    }
  })

; `callHierarchy/outgoingCalls`: what this function calls.
;
; A callee this document declares is answered from this document; one
; it imports is answered from the module that declares it, resolved
; the way `lspDefinitionImported` resolves it - and paid for ONCE, on
; the first callee that needs it, rather than per callee.
(pub :: lspOutgoingCalls (-> LspWorkspace Int Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspOutgoingCalls workspace params uris texts)
  (if (let (Some s) (lspChSubject params uris texts))
    {
      (let uri s.uri)
      (let name s.name)
      (let src s.src)
      (let decls s.decls)
      {
        (let ix (lspLineIndex src))
        (let sites (lspChSites src decls))
        (let groups lspChGroupsNew)
        (let out jsonArr)
        (let mut r None)
        (let mut resolved false)
        {
          (for o in sites
            (if (strEq o.owner name)
              (lspChGroupPush groups o.name o.span)))
          (for g in groups
            {
              (let d (lspFindFn decls g.key (- (vecLen decls) 1)))
              (if (let (Some d) d)
                (jsonArrPush out
                  (jsonObjPut (jsonObjPut jsonObj "to" (lspChItem src ix uri d)) "fromRanges"
                    (lspChRanges src ix g.spans)))
                {
                  (if (! resolved)
                    {
                      (set r (lspResolveFor workspace (lspUriToPath uri) src decls))
                      (set resolved true)
                    })
                  (match r
                    ((Some rr)
                      {
                        (let item (lspChImportedItem rr g.key))
                        (if (! (== item 0))
                          (jsonArrPush out
                            (jsonObjPut (jsonObjPut jsonObj "to" item) "fromRanges"
                              (lspChRanges src ix g.spans))))
                      }
                    )
                    ((None) ()))
                })
            })
          out
        }
      }
    }
    jsonNull))

; The item for a callee an imported module declares, out of a resolved
; `lspResolveFor` result: 0 when no module declares it as a `fn`, or
; when the resolver did not attribute the declaration to a unit.
(pub :: lspChImportedItem (-> LspResolved String Int))
;@axiom:effect(io)
(pub fn (lspChImportedItem r name)
  {
    (let allDecls r.decls)
    (let units r.units)
    {
      (let d (lspFindImportedFn allDecls name (- (vecLen allDecls) 1)))
      (if (let (Some d) d)
        {
          (let u (lspUnitOf units (nodeModuleOpt d)))
          (match u
            ((None) 0)
            ((Some u)
              {
                (let unit (vecGet units u))
                (lspChItem (unitSrc unit) (lspLineIndex (unitSrc unit))
                  (lspPathToUri (unitFile unit)) d)
              }
            ))
        }
        0)
    }
  })

; ------------------------------------------------------------------
; ------------------------------------------------------------------
; The TYPE hierarchy: `textDocument/prepareTypeHierarchy`,
; `typeHierarchy/supertypes` and `typeHierarchy/subtypes`.
;
; WHAT AN EDGE IS HERE: a `subtype` derives from its BASE, and that
; is the only edge the language has. The check runs at every
; narrowing conversion and widening is free (`subtypeArgAction`), so
; a `Positive` IS an `Int` in exactly the one direction the two
; requests below answer. Constructors are VALUES, not types -
; introduction forms, answered as documentSymbol children and by
; `definition` - and a `struct` field is a member, not a derivation;
; neither can stand in a TypeHierarchyItem, which denotes a TYPE. An
; alias is transparent: the checker expands it, so `Age = Int` says
; Age IS Int, symmetrically, and a parent/child direction over it
; would be arbitrary. docs/lsp.md carries the survey this summarises.
;
; THE GRAPH TODAY IS TWO LEVELS, and the code below is written for
; the general one. The checker refuses every base but bare `Int`
; (`tcWalkDecls`, v1), so every chain bottoms at the builtin
; immediately; when chaining lands, a base that names a declared
; type resolves to that declaration by the same rule that resolves
; it to a builtin item now, and `subtypes` of a declared type stops
; answering `[]` without a line changing here.
;
; NODES are the four type declarations - `data`, `struct`, `type`,
; `subtype` - plus the builtin type names (`typeKeywordKnown`'s set
; and `Linear`, the membership `tyConKnown` answers). A builtin has
; no declaration to point at, so its item is anchored at the WORD
; that named it - `hover`'s rule for `range`, applied to an item -
; and the follow-ups work from the item's NAME, never its anchor. A
; declaration SHADOWS a builtin of the same spelling: resolution is
; this document, then the imported modules, then the builtins, which
; is `definition`'s order with one more fallback instead of `null`.
;
; WHAT IS DELIBERATELY NOT ANSWERED, because answering it would mean
; guessing:
;
;   * A LOCAL, a constructor and an effect name are null: their keys
;     (`@`, `Shape#Circle`, `!`) say they are not types. A `fn` the
;     cursor names is null too, UNLESS a type shares its spelling -
;     and then the TYPE is answered, because `prepare` resolves the
;     spelling as a type. That over-answers exactly one shape - a
;     value occurrence where a value and a type share a spelling -
;     which `references` merges for the same reason, the two tables
;     keying it alike.
;   * AN ITEM NOTHING DECLARES is null, and null rather than `[]`:
;     `[]` says "this type has no supertypes", which is a claim, and
;     a server that cannot reach the subject has not earned it. The
;     call hierarchy's rule, for its reason.
;   * AN ITEM WHOSE DOCUMENT IS NOT OPEN is null either. `prepare`
;     is generous - an imported type answers an item in its declaring
;     file, like `definition` - but the follow-ups read the store,
;     like incoming calls, so a closed file earns null on the second
;     request.
;
; SUBTYPES ARE SEARCHED OVER THE OPEN DOCUMENTS AND NOTHING ELSE,
; which is `references`'s rule and for its reason: the store is the
; workspace. The item's own document first, in declaration order,
; then the other open documents in the order they were opened.
; ------------------------------------------------------------------
; Whether a declaration tag denotes a TYPE.
(pub :: lspThIsTypeTag (-> Int Bool))
(pub fn (lspThIsTypeTag tag)
  (|| (== tag TAG_D_DATA)
    (|| (== tag TAG_D_STRUCT) (|| (== tag TAG_D_ALIAS) (== tag TAG_D_SUBTYPE)))))

; SymbolKind for a type declaration: Enum 10 for a `data`, Struct 23
; for a `struct`, Class 5 for an alias and a subtype - the protocol
; has no kind for either, for the reason `lspSymKind` gives.
(pub :: lspThKind (-> Int Int))
(pub fn (lspThKind tag)
  (if (== tag TAG_D_DATA)
    10
    (if (== tag TAG_D_STRUCT)
      23
      5)))

; The head the subtype `d` constrains: its base type's constructor
; name, or "" when the base is not a bare-or-applied constructor -
; an arrow, a tuple, nothing nominal to resolve.
(pub :: lspThBaseHead (-> ASTNode String))
(pub fn (lspThBaseHead d)
  {
    (let b (nodeBChild d))
    (if (nodeSame b nilNode)
      ""
      (if (!= (nodeTag b) TAG_T_CON)
        ""
        (nodeAName b)))
  })

; The `detail` a type item carries: the declaration kind, and for a
; subtype the base it constrains.
(pub :: lspThDetail (-> ASTNode String))
(pub fn (lspThDetail d)
  {
    (let tag (nodeTag d))
    (if (== tag TAG_D_DATA)
      "data"
      (if (== tag TAG_D_STRUCT)
        "struct"
        (if (== tag TAG_D_ALIAS)
          "type"
          {
            (let h (lspThBaseHead d))
            (if (== (strLen h) 0)
              "subtype"
              (concat "subtype of " h))
          })))
  })

; Whether `name` is a builtin type: exactly what the checker answers
; without a declaration - `typeKeywordKnown`'s set plus `Linear`
; (`tyConKnown`). Asked through the parser's own function, so the
; membership cannot drift from the checker's.
(pub :: lspThBuiltin (-> String Bool))
(pub fn (lspThBuiltin name)
  (if (typeKeywordKnown name)
    true
    (strEq name "Linear")))

; The LAST type declaration of `name` in `decls` - `lspFindDecl`'s
; rule, over the type kinds - or None.
(pub :: lspThFindType (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspThFindType decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (lspThIsTypeTag (nodeTag d)) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        (Some d)
        (lspThFindType decls name (- i 1)))
    }))

; The same over the MERGED declaration list: a name this document
; imported, found mangled in the module that declares it.
(pub :: lspThFindImportedType (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspThFindImportedType decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (lspThIsTypeTag (nodeTag d))
            (&& (!= (nodeModule d) 0) (&& (strEq (bareOf (nodeAName d)) name) (!= (nodeSpan d) 0))))
        (Some d)
        (lspThFindImportedType decls name (- i 1)))
    }))

; A TypeHierarchyItem for declaration `d` of `src`, at `uri`.
; `selectionRange` is the name, exactly as the outline publishes it,
; and `range` is the whole form - `lspChItem`'s rule, for its reason.
; The name is the BARE one, so an item out of an importing document
; re-resolves in the file that declares it.
(pub :: lspThItem (-> String Ints String ASTNode Int))
(pub fn (lspThItem src ix uri d)
  {
    (let fs (lspFormStart src (spanStart (nodeSpan d))))
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut
          (jsonObjPut
            (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr (bareOf (nodeAName d)))) "kind"
              (jsonNum (lspThKind (nodeTag d))))
            "detail" (jsonStr (lspThDetail d)))
          "uri" (jsonStr uri))
        "range" (lspRangeIx src ix (mkSpan fs (lspFormEnd src fs))))
      "selectionRange" (lspRangeIx src ix (nodeSpan d)))
  })

; A TypeHierarchyItem for a BUILTIN type: no declaration exists, so
; both ranges are the word that named it, and the follow-ups work
; from the name alone. Class 5, for the reason `lspThKind` gives.
(pub :: lspThBuiltinItem (-> String Ints String String Int Int))
(pub fn (lspThBuiltinItem src ix uri name wsp)
  (jsonObjPut
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr name)) "kind" (jsonNum 5))
          "detail" (jsonStr "builtin type"))
        "uri" (jsonStr uri))
      "range" (lspRangeIx src ix wsp))
    "selectionRange" (lspRangeIx src ix wsp)))

; The span at which the subtype declaration `d` spells its base HEAD -
; the `Int` of `(subtype Positive is Int range 1..10)` - or 0. The
; first identifier after the `is` that spells `head`; the parse
; guarantees both are there, so 0 is a shape this never answers on.
(pub :: lspThBaseSpan (-> String ASTNode String Int))
(pub fn (lspThBaseSpan src d head)
  (if (|| (== (nodeSpan d) 0) (== (strLen head) 0))
    0
    {
      (let spans (lspNavIdents src (spanEnd (nodeSpan d)) (lspNavDeclEnd src d)))
      (let mut seenIs 0)
      (let mut found 0)
      {
        (for sp in spans
          (if (! (!= found 0))
            (if (== seenIs 1)
              (if (strEq (lspNavSpanText src sp) head)
                (set found sp))
              (if (strEq (lspNavSpanText src sp) "is")
                (set seenIs 1)))))
        found
      }
    }))

; The item for a type an imported module declares, out of a resolved
; `lspResolveFor` result: 0 when no module declares it as a type, or
; when the resolver did not attribute the declaration to a unit.
(pub :: lspThImportedItem (-> LspResolved String Int))
;@axiom:effect(io)
(pub fn (lspThImportedItem r name)
  {
    (let allDecls r.decls)
    (let units r.units)
    {
      (let d (lspThFindImportedType allDecls name (- (vecLen allDecls) 1)))
      (if (let (Some d) d)
        {
          (let u (lspUnitOf units (nodeModuleOpt d)))
          (match u
            ((None) 0)
            ((Some u)
              {
                (let unit (vecGet units u))
                (lspThItem (unitSrc unit) (lspLineIndex (unitSrc unit))
                  (lspPathToUri (unitFile unit)) d)
              }
            ))
        }
        0)
    }
  })

; `textDocument/prepareTypeHierarchy`: the one item a hierarchy can be
; rooted at here - the TYPE the cursor names, in this document, in an
; imported module, or among the builtins. A local, a constructor, an
; effect name, a value no type shares a spelling with, and a document
; that does not parse are all null.
(pub :: lspPrepareTypeHierarchy (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspPrepareTypeHierarchy workspace src uri params)
  {
    (let decls (lspNavParse src))
    (if (== (as decls Int) 0)
      jsonNull
      {
        (let ix (lspLineIndex src))
        (let occs (lspNavOccurrences src decls))
        (if (let (Some o) (lspNavAt occs (lspOffsetOf src ix (jsonGet params "position"))))
          {
            (let w o.name)
            (let key o.key)
            (if (lspNavIsLocal key)
              jsonNull
              (match (strFindByte key 35 0)
                ((Some _) jsonNull)
                ((None)
                  (if (&& (> (strLen key) 0) (== (strByte key 0) 33))
                    jsonNull
                    {
                      (let d (lspThFindType decls w (- (vecLen decls) 1)))
                      (if (let (Some d) d)
                        (jsonArrPush jsonArr (lspThItem src ix uri d))
                        {
                          (let item
                            (match (lspResolveFor workspace (lspUriToPath uri) src decls)
                              ((None) 0)
                              ((Some r) (lspThImportedItem r w))))
                          (if (!= item 0)
                            (jsonArrPush jsonArr item)
                            (if (lspThBuiltin w)
                              {
                                (let wsp o.span)
                                (if (== wsp 0)
                                  jsonNull
                                  (jsonArrPush jsonArr (lspThBuiltinItem src ix uri w wsp)))
                              }
                              jsonNull))
                        })
                    })
                )))
          }
          jsonNull)
      })
  })

; The item a hierarchy request carries, re-resolved from its (uri,
; name): the document must be open, must parse, and must declare
; `name` as a TYPE - or `name` is a builtin. Answers None when none
; of those holds, and every caller turns that into null. The declaration
; is None for a builtin subject.
(pub :: lspThSubject (-> Int Strings Strings (Option LspHierSubject)))
(pub fn (lspThSubject params uris texts)
  {
    (let item (jsonGet params "item"))
    {
      (let uri (jsonGetStr item "uri"))
      (let name (jsonGetStr item "name"))
      (if (let (Some src) (docText uris texts uri))
        (if (|| (== (strLen src) 0) (== (strLen name) 0))
          None
          {
            (let decls (lspNavParse src))
            (if (== (as decls Int) 0)
              None
              {
                (let d (lspThFindType decls name (- (vecLen decls) 1)))
                (if (|| (isSome d) (lspThBuiltin name))
                  (Some (LspHierSubject :uri uri :name name :src src :decls decls :decl d))
                  None)
              })
          })
        None)
    }
  })

; `typeHierarchy/supertypes`: what this type derives from - the base
; of a `subtype`, resolved declaration-before-builtin like `prepare`.
; A `data`, `struct`, alias or builtin derives from nothing, which is
; `[]` and not null: the subject resolved and the answer is empty.
(pub :: lspSupertypes (-> LspWorkspace Int Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspSupertypes workspace params uris texts)
  (if (let (Some s) (lspThSubject params uris texts))
    {
      (let d s.decl)
      (if (let (Some d) d)
        (if (!= (nodeTag d) TAG_D_SUBTYPE)
          jsonArr
          {
            (let h (lspThBaseHead d))
            (if (== (strLen h) 0)
              jsonArr
              {
                (let uri s.uri)
                (let src s.src)
                (let decls s.decls)
                {
                  (let dd (lspThFindType decls h (- (vecLen decls) 1)))
                  (if (let (Some dd) dd)
                    (jsonArrPush jsonArr (lspThItem src (lspLineIndex src) uri dd))
                    {
                      (let item
                        (match (lspResolveFor workspace (lspUriToPath uri) src decls)
                          ((None) 0)
                          ((Some r) (lspThImportedItem r h))))
                      (if (!= item 0)
                        (jsonArrPush jsonArr item)
                        (if (lspThBuiltin h)
                          {
                            (let bsp (lspThBaseSpan src d h))
                            (if (== bsp 0)
                              jsonArr
                              (jsonArrPush jsonArr
                                (lspThBuiltinItem src (lspLineIndex src) uri h bsp)))
                          }
                          jsonArr))
                    })
                }
              })
          })
        jsonArr)
    }
    jsonNull))

; `typeHierarchy/subtypes`: the `subtype` declarations constraining
; this type - over the item's own document first, then every other
; open document, each in declaration order. `[]` when the search ran
; and found nothing; null when the subject did not resolve.
(pub :: lspSubtypes (-> Int Strings Strings Int))
(pub fn (lspSubtypes params uris texts)
  (if (let (Some s) (lspThSubject params uris texts))
    {
      (let uri s.uri)
      (let name s.name)
      (let out jsonArr)
      {
        (lspThSubtypesIn out uri s.src s.decls name)
        (for i in 0..(vecLen uris)
          (if (! (strEq (vecGet uris i) uri))
            {
              (let osrc (vecGet texts i))
              {
                (let odecls (lspNavParse osrc))
                (if (! (== (as odecls Int) 0))
                  (lspThSubtypesIn out (vecGet uris i) osrc odecls name))
              }
            }))
        out
      }
    }
    jsonNull))

; Every `subtype` of `osrc` whose base head is `name`, as items at
; `ouri`, in declaration order.
(pub :: lspThSubtypesIn (-> Int String String (Vec ASTNode) String Int))
(pub fn (lspThSubtypesIn out ouri osrc odecls name)
  {
    (let oix (lspLineIndex osrc))
    {
      (for d in odecls
        (if (&& (== (nodeTag d) TAG_D_SUBTYPE)
              (&& (!= (nodeSpan d) 0) (strEq (lspThBaseHead d) name)))
          (jsonArrPush out (lspThItem osrc oix ouri d))))
      0
    }
  })

; The section's three answers to the extension door.
; ------------------------------------------------------------------
(pub :: lspNavHandles (-> String Bool))
(pub fn (lspNavHandles method)
  (|| (strEq method "textDocument/references")
    (|| (strEq method "textDocument/documentHighlight")
      (|| (strEq method "textDocument/prepareRename")
        (|| (strEq method "textDocument/rename")
          (|| (strEq method "textDocument/declaration")
            (|| (strEq method "textDocument/prepareCallHierarchy")
              (|| (strEq method "callHierarchy/incomingCalls")
                (|| (strEq method "callHierarchy/outgoingCalls")
                  (|| (strEq method "textDocument/prepareTypeHierarchy")
                    (|| (strEq method "typeHierarchy/supertypes")
                      (strEq method "typeHierarchy/subtypes"))))))))))))

(:: lspNavWithText (-> LspWorkspace String Int Int Strings Strings Strings String String))
;@axiom:effect(io)
(fn (lspNavWithText workspace method id params uris texts gens src)
  {
    (let uri (lspParamsUri params))
    (let gen (docGen uris gens (lspParamsUri params)))
    (if (strEq method "textDocument/references")
      (lspReplyBody id (lspReferences workspace src uri params uris texts gen))
      (if (strEq method "textDocument/documentHighlight")
        (lspReplyBody id (lspDocumentHighlight src params))
        (if (strEq method "textDocument/prepareRename")
          (lspReplyBody id (lspPrepareRename src params))
          (if (strEq method "textDocument/rename")
            (lspReplyBody id (lspRename workspace src uri params uris texts))
            (if (strEq method "textDocument/declaration")
              (lspReplyBody id (lspDeclaration workspace src uri params gen))
              (if (strEq method "textDocument/prepareCallHierarchy")
                (lspReplyBody id (lspPrepareCallHierarchy src uri params))
                ; Item requests normally have no `textDocument` and take
                ; `lspNavWithoutText`. Both paths read the item's URI.
                (if (strEq method "callHierarchy/incomingCalls")
                  (lspReplyBody id (lspIncomingCalls workspace params uris texts))
                  (if (strEq method "callHierarchy/outgoingCalls")
                    (lspReplyBody id (lspOutgoingCalls workspace params uris texts))
                    ; `prepare` reads this document. The other two
                    ; requests read their item, like call hierarchy.
                    (if (strEq method "textDocument/prepareTypeHierarchy")
                      (lspReplyBody id (lspPrepareTypeHierarchy workspace src uri params))
                      (if (strEq method "typeHierarchy/supertypes")
                        (lspReplyBody id (lspSupertypes workspace params uris texts))
                        (if (strEq method "typeHierarchy/subtypes")
                          (lspReplyBody id (lspSubtypes params uris texts))
                          (lspErrorBody id (- 0 32601)
                            (concat "method not found: " method)))))))))))))
  })

; Item requests carry their own URI. Other requests for an unopened
; document retain their established null answer.
(:: lspNavWithoutText (-> LspWorkspace String Int Int Strings Strings String))
;@axiom:effect(io)
(fn (lspNavWithoutText workspace method id params uris texts)
  (if (strEq method "callHierarchy/incomingCalls")
    (lspReplyBody id (lspIncomingCalls workspace params uris texts))
    (if (strEq method "callHierarchy/outgoingCalls")
      (lspReplyBody id (lspOutgoingCalls workspace params uris texts))
      (if (strEq method "typeHierarchy/supertypes")
        (lspReplyBody id (lspSupertypes workspace params uris texts))
        (if (strEq method "typeHierarchy/subtypes")
          (lspReplyBody id (lspSubtypes params uris texts))
          (if (lspNavHandles method)
            (lspReplyBody id jsonNull)
            (lspErrorBody id (- 0 32601) (concat "method not found: " method))))))))

(pub :: lspNavDispatch (-> LspWorkspace String Int Int Strings Strings Strings String))
;@axiom:effect(io)
(pub fn (lspNavDispatch workspace method id params uris texts gens)
  (match (docText uris texts (lspParamsUri params))
    ((None) (lspNavWithoutText workspace method id params uris texts))
    ((Some src) (lspNavWithText workspace method id params uris texts gens src))))

; `renameProvider` is an OBJECT: `prepareProvider: true` tells the
; client to ask `prepareRename` first, so an editor never opens a
; rename box on a name this server will refuse to rename.
(pub :: lspNavCaps (-> Int Int))
(pub fn (lspNavCaps caps)
  (jsonObjPut
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut
          (jsonObjPut (jsonObjPut caps "referencesProvider" (jsonBool 1))
            "documentHighlightProvider" (jsonBool 1))
          "renameProvider" (jsonObjPut jsonObj "prepareProvider" (jsonBool 1)))
        "declarationProvider" (jsonBool 1))
      "callHierarchyProvider" (jsonBool 1))
    "typeHierarchyProvider" (jsonBool 1)))

; ==================================================================
; END SECTION NAV
; ==================================================================
; ==================================================================
; SECTION VIEW: signature help, inlay hints, folding, selection
; ranges, document links, workspace symbols
; ==================================================================
; Six requests that show a reader MORE about the code without changing
; it, in the shape rust-analyzer gives them: signature help, inlay
; hints, folding ranges, selection ranges, document links and the
; workspace symbol list. All six read the raw parse tree and the
; document's bytes and expand nothing (MAC-TOOL-3); each parses once
; and builds one line index; the three that reach into imported
; modules - signature help on an imported name, the parameter names
; of an imported call, the workspace list - resolve the imports
; exactly as `lspDefinitionImported` does, preflight first, so a
; half-typed import degrades to "this document alone" and never to a
; dead server.
;
; WHAT THE BYTES ANSWER THAT THE TREE CANNOT. The parser records a
; span for a declaration's NAME and for every atom, and none for a
; parameter name in a `fn` header (`parseIdentList` keeps the lexeme
; alone), for the `(` of a form, or for the `)` that closes it. So a
; parameter's type hint sits at a position recovered by scanning the
; header's identifiers after the name's span; an argument's hint at
; the start of the i-th item after the call's head, found by the same
; item scanner signature help counts arguments with; and every fold
; and selection range at a bracket the scanner found. The scanner is
; `lspFormEnd`'s - strings, char literals, `;` and `#| |#` comments
; are stepped over by the lexer's own functions - so no two of these
; requests can disagree about where a form ends.
(pub :: lspViewHandles (-> String Bool))
(pub fn (lspViewHandles method)
  (|| (strEq method "textDocument/signatureHelp")
    (|| (strEq method "textDocument/inlayHint")
      (|| (strEq method "textDocument/foldingRange")
        (|| (strEq method "textDocument/selectionRange")
          (|| (strEq method "textDocument/documentLink") (strEq method "workspace/symbol")))))))

(:: lspViewWithText (-> LspWorkspace String Int Int String String String))
;@axiom:effect(io)
(fn (lspViewWithText workspace method id params uri src)
  (if (strEq method "textDocument/signatureHelp")
    (lspReplyBody id (lspSignatureHelp workspace src uri params))
    (if (strEq method "textDocument/inlayHint")
      (lspReplyBody id (lspInlayHints workspace src uri params))
      (if (strEq method "textDocument/foldingRange")
        (lspReplyBody id (lspFoldingRanges src))
        (if (strEq method "textDocument/selectionRange")
          (lspReplyBody id (lspSelectionRanges src params))
          (if (strEq method "textDocument/documentLink")
            (lspReplyBody id (lspDocumentLinks workspace src uri))
            (lspErrorBody id (- 0 32601) (concat "method not found: " method))))))))

(:: lspViewWithoutText (-> String Int Int String))
(fn (lspViewWithoutText method id params)
  (if (strEq method "textDocument/signatureHelp")
    (lspReplyBody id jsonNull)
    (if (strEq method "textDocument/selectionRange")
      (lspReplyBody id (lspSelectionRanges "" params))
      (if (|| (strEq method "textDocument/inlayHint")
            (|| (strEq method "textDocument/foldingRange")
              (strEq method "textDocument/documentLink")))
        (lspReplyBody id jsonArr)
        (lspErrorBody id (- 0 32601) (concat "method not found: " method))))))

(pub :: lspViewDispatch (-> LspWorkspace String Int Int Strings Strings String))
;@axiom:effect(io)
(pub fn (lspViewDispatch workspace method id params uris texts)
  (if (strEq method "workspace/symbol")
    (lspReplyBody id (lspWorkspaceSymbols workspace uris texts params))
    {
      (let uri (lspParamsUri params))
      (match (docText uris texts uri)
        ((None) (lspViewWithoutText method id params))
        ((Some src) (lspViewWithText workspace method id params uri src)))
    }))

; `signatureHelpProvider` and `documentLinkProvider` are objects, the
; other four booleans. `(` and a space are where a call's argument
; changes hands in this language, so both trigger and a space
; retriggers; `resolveProvider: false` says every link is complete
; as sent, since there is no `documentLink/resolve` here.
(pub :: lspViewCaps (-> Int Int))
(pub fn (lspViewCaps caps)
  (jsonObjPut
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut
          (jsonObjPut (jsonObjPut caps "signatureHelpProvider" lspSignatureHelpOptions)
            "inlayHintProvider" (jsonBool 1))
          "foldingRangeProvider" (jsonBool 1))
        "selectionRangeProvider" (jsonBool 1))
      "documentLinkProvider" (jsonObjPut jsonObj "resolveProvider" (jsonBool 0)))
    "workspaceSymbolProvider" (jsonBool 1)))

(pub :: lspSignatureHelpOptions Int)
(pub fn (lspSignatureHelpOptions)
  (jsonObjPut
    (jsonObjPut jsonObj "triggerCharacters"
      (jsonArrPush (jsonArrPush jsonArr (jsonStr "(")) (jsonStr " ")))
    "retriggerCharacters" (jsonArrPush jsonArr (jsonStr " "))))

; ------------------------------------------------------------------
; Items: the byte-level view of a form's arguments.
;
; Signature help asks "which argument is the cursor on" and parameter
; hints ask "where does the i-th argument begin", and both are
; questions about the ITEMS after a form's head: nested forms, brace
; blocks, string and char literals, identifiers, numbers. One scanner
; answers both, so what one request calls the second argument the
; other cannot label first.
; ------------------------------------------------------------------
; One past the identifier starting at `i`, absorbing a `::name`
; qualifier: `Vec::vecPush` is ONE var to the parser - named
; `Vec$vecPush`, spanning its first segment - and must be one item
; here, or every argument after a qualified head is counted one early.
(pub :: lspViewIdentEnd (-> String Int Int Int))
(pub fn (lspViewIdentEnd src i n)
  {
    (let mut e (skipIdent src i n))
    {
      (while (if (< (+ e 2) n)
        (if (== (strByte src e) 58)
          (if (== (strByte src (+ e 1)) 58)
            (isIdentStart (strByte src (+ e 2)))
            false)
          false)
        false)
        (set e (skipIdent src (+ e 2) n)))
      e
    }
  })

; One past the item starting at `i`: a form to its closer, a brace
; block to its `}`, a string or char literal to its quote, an
; identifier through `lspViewIdentEnd`, and any other atom - a
; number, mostly - to the next delimiter. Always past `i`, so a scan
; that steps by it terminates.
(pub :: lspViewItemEnd (-> String Int Int Int))
(pub fn (lspViewItemEnd src i n)
  {
    (let ch (strByte src i))
    (if (== ch 40)
      (lspFormEnd src i)
      (if (== ch 123)
        (lspViewBraceEnd src i)
        (if (== ch 34)
          (skipStringBody src (+ i 1) n)
          (if (isIdentStart ch)
            (lspViewIdentEnd src i n)
            (if (== ch 39)
              (skipCharBody src (+ i 1) n)
              {
                (let mut j (+ i 1))
                {
                  (while (if (< j n)
                    (lspViewIsAtomByte (strByte src j))
                    false)
                    (set j (+ j 1)))
                  j
                }
              })))))
  })

; A byte that continues an atom: anything but whitespace, a bracket,
; a quote or a comment start.
(pub :: lspViewIsAtomByte (-> Int Bool))
(pub fn (lspViewIsAtomByte b)
  (if (lspIsSpace b)
    false
    (if (|| (== b 40) (|| (== b 41) (|| (== b 123) (|| (== b 125) (|| (== b 34) (== b 59))))))
      false
      true)))

; One past the `}` closing the brace block at `o`, or the document
; length. A brace block is a sequence, not a form, and `lspFormEnd`
; counts parens alone; an argument written `{ ... }` is met wherever
; a body sequences its steps. The four skips are `lspFormEnd`'s, in
; its order, for the reason it gives.
(pub :: lspViewBraceEnd (-> String Int Int))
(pub fn (lspViewBraceEnd src o)
  {
    (let n (strLen src))
    (let mut i (+ o 1))
    (let mut depth 1)
    (let mut stop (- 0 1))
    {
      (while (if (< i n)
        (< stop 0)
        false)
        {
          (let ch (strByte src i))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (set i (skipIdent src (+ i 1) n))
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    (set i (findNewline src i n))
                    {
                      (if (== ch 123)
                        (set depth (+ depth 1)))
                      (if (== ch 125)
                        {
                          (set depth (- depth 1))
                          (if (<= depth 0)
                            (set stop (+ i 1)))
                        })
                      (set i (+ i 1))
                    })))))
        })
      (if (< stop 0)
        n
        stop)
    }
  })

; The identifier the form at `o` opens with, or "" when what follows
; its `(` is not one - a nested form, a brace block, a literal.
(pub :: lspViewHeadAt (-> String Int String))
(pub fn (lspViewHeadAt src o)
  {
    (let n (strLen src))
    (let mut i (+ o 1))
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false)
        (set i (+ i 1)))
      (if (if (< i n)
        (isIdentStart (strByte src i))
        false)
        (strSlice src i (- (lspViewIdentEnd src i n) i))
        "")
    }
  })

; One past the head of the form at `o` - where its arguments begin.
(pub :: lspViewHeadEnd (-> String Int Int))
(pub fn (lspViewHeadEnd src o)
  {
    (let n (strLen src))
    (let mut i (+ o 1))
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false)
        (set i (+ i 1)))
      (if (if (< i n)
        (isIdentStart (strByte src i))
        false)
        (lspViewIdentEnd src i n)
        i)
    }
  })

; The index of the argument the cursor at `off` is on, in the form
; opening at `o`: the number of COMPLETE items between the head and
; the cursor, where an item the cursor is inside or touching is the
; one being typed rather than a finished one. `(add 1 |` is 1;
; `(add 1|` is 0, because the `1` is still being written; `(add |`
; is 0. Comments between arguments are not items.
(pub :: lspViewActiveArg (-> String Int Int Int))
(pub fn (lspViewActiveArg src o off)
  {
    (let n (strLen src))
    (let mut i (lspViewHeadEnd src o))
    (let mut count 0)
    (let mut active (- 0 1))
    (let mut go 1)
    {
      (while (if (== go 1)
        (< i off)
        false)
        {
          (let ch (strByte src i))
          (if (lspIsSpace ch)
            (set i (+ i 1))
            (if (== ch 59)
              (set i (findNewline src i n))
              (if (&& (== ch 35) (isBlockOpen src i n))
                (set i (skipBlockComment src (+ i 2) n))
                (if (== ch 41)
                  (set go 0)
                  {
                    (let e (lspViewItemEnd src i n))
                    (if (<= off e)
                      {
                        (set active count)
                        (set go 0)
                      }
                      {
                        (set count (+ count 1))
                        (set i e)
                      })
                  }))))
        })
      (if (< active 0)
        count
        active)
    }
  })

; ------------------------------------------------------------------
; `textDocument/signatureHelp`: the declaration of the call the cursor
; is inside, with the argument being typed marked.
;
; The innermost form containing the cursor is the call - a cursor
; sitting exactly ON a `(` is inside the form it opens, because that
; is the character the client sends the trigger at - and its head is
; read from the bytes after the `(`. A `fn` of this document answers
; first, then one of its `data` constructors, then an imported `fn`
; read in its own unit's text with the module named in the label,
; then an imported constructor: `lspDefinition`'s order, for the
; language's scoping reason. A keyword head (`let`, `if`) is null: the
; parser dispatches on it and no declaration describes it. So is an
; operator, which has no declaration to read.
;
; The label is what a reader would write: `(add x y) : (-> Int Int
; Int)`, the type cut from the `::` beside the `fn` exactly as
; completion's `detail` is, and omitted when there is none. Each
; parameter is the [start, end) UTF-16 offsets of its name INSIDE the
; label - the protocol's array form, so the client bolds the active
; one without searching the string.
; ------------------------------------------------------------------
(pub :: lspSignatureHelp (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspSignatureHelp workspace src uri params)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError11) jsonNull)
      ((ParseSuccess parsedValue11 parsedPos11)
        {
          (let decls parsedValue11)
          (let ix (lspLineIndex src))
          {
            (let o (lspViewCallAt src (lspOffsetOf src ix (jsonGet params "position"))))
            (match o
              ((None) jsonNull)
              ((Some o)
                ; A keyword, a function header and a local binding that
                ; shadows a declared function do not name calls to it.
                {
                  (let head (lspViewHeadAt src o))
                  (let hs (lspViewHeadStart src o))
                  (if (|| (== (strLen head) 0)
                        (|| (== (strVecHas lspKeywords head) 1)
                          (|| (lspViewIsFnHeader decls hs)
                            (lspNavLocalIndexHas (lspNavLocalIndex src decls o (+ o 1)) hs))))
                    jsonNull
                    {
                      (let local (lspViewSigLocal src decls head))
                      {
                        (let found
                          (if (== local 0)
                            (lspViewSigImported workspace (lspUriToPath uri) src decls head)
                            local))
                        (if (== found 0)
                          jsonNull
                          (lspViewSigHelp found
                            (lspViewActiveArg src o
                              (lspOffsetOf src ix (jsonGet params "position")))))
                      }
                    })
                }
              ))
          }
        }
      ))
  })

; The offset of the head identifier of the form at `o` - the byte
; after its `(` and the blanks.
(pub :: lspViewHeadStart (-> String Int Int))
(pub fn (lspViewHeadStart src o)
  {
    (let n (strLen src))
    (let mut i (+ o 1))
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false)
        (set i (+ i 1)))
      i
    }
  })

; Whether a `fn` of this document declares its name at byte `off` -
; the header `(add x y)` of `(fn (add x y) ...)` opens with the name
; whose span the declaration carries.
(pub :: lspViewIsFnHeader (-> (Vec ASTNode) Int Bool))
(pub fn (lspViewIsFnHeader decls off)
  {
    (let n (vecLen decls))
    (let mut i 0)
    (let mut found false)
    {
      (while (if (< i n)
        (lspNavNot found)
        false)
        {
          (let d (vecGet decls i))
          {
            (if (&& (== (nodeTag d) TAG_D_FN)
                  (&& (!= (nodeSpan d) 0) (== (spanStart (nodeSpan d)) off)))
              (set found true))
            (set i (+ i 1))
          }
        })
      found
    }
  })

; The `(` of the innermost form containing `off`, or None when nothing
; does. `lspEnclosingOpens` leaves a form opening exactly AT `off` to
; its caller; here it counts.
(pub :: lspViewCallAt (-> String Int (Option Int)))
(pub fn (lspViewCallAt src off)
  (if (|| (< off 0) (> off (strLen src)))
    None
    (if (if (< off (strLen src))
      (== (strByte src off) 40)
      false)
      (Some off)
      {
        (let opens (lspEnclosingOpens src off))
        (if (== (vecLen opens) 0)
          None
          (Some (vecGet opens (- (vecLen opens) 1))))
      })))

; The SignatureHelp object: one signature, active, with the argument
; index clamped to the last parameter once the cursor is past them
; all - a client given an index off the end highlights nothing.
(pub :: lspViewSigHelp (-> Int Int Int))
(pub fn (lspViewSigHelp sig arg)
  {
    (let np (jsonArrLen (jsonGet sig "parameters")))
    {
      (let active
        (if (>= arg np)
          (if (> np 0)
            (- np 1)
            0)
          arg))
      (jsonObjPut
        (jsonObjPut (jsonObjPut jsonObj "signatures" (jsonArrPush jsonArr sig)) "activeSignature"
          (jsonNum 0))
        "activeParameter" (jsonNum active))
    }
  })

; This document's answer for `head`: its `fn` of that name, else a
; constructor of one of its `data` declarations, else 0.
(pub :: lspViewSigLocal (-> String (Vec ASTNode) String Int))
(pub fn (lspViewSigLocal src decls head)
  {
    (let d (lspFindDecl decls head (- (vecLen decls) 1)))
    (if (let (Some d) d)
      (if (== (nodeTag d) TAG_D_FN)
        (lspViewSigFn src decls d None)
        {
          (let c (lspViewFindCtor decls head 0))
          (if (let (Some c) c)
            (lspViewSigCtor c)
            0)
        })
      {
        (let c (lspViewFindCtor decls head 0))
        (if (let (Some c) c)
          (lspViewSigCtor c)
          0)
      })
  })

; The second lookup, over the merged list: an imported `fn`, read in
; the unit that declares it so the type and the paragraph are its
; own text; else an imported constructor.
(pub :: lspViewSigImported (-> LspWorkspace String String (Vec ASTNode) String Int))
;@axiom:effect(io)
(pub fn (lspViewSigImported workspace path src decls head)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let d (lspFindImported allDecls head (- (vecLen allDecls) 1)))
        (if (let (Some d) d)
          (if (== (nodeTag d) TAG_D_FN)
            {
              (let u (lspUnitOf units (nodeModuleOpt d)))
              (match u
                ((None) 0)
                ((Some u)
                  {
                    (let unit (vecGet units u))
                    (lspViewSigFn (unitSrc unit) allDecls d (unitName unit))
                  }
                ))
            }
            {
              (let c (lspViewFindCtor allDecls head 1))
              (if (let (Some c) c)
                (lspViewSigCtor c)
                0)
            })
          {
            (let c (lspViewFindCtor allDecls head 1))
            (if (let (Some c) c)
              (lspViewSigCtor c)
              0)
          })
      }
    }
    0))

; The constructor named `name` among the `data` declarations of
; `decls`: this document's own when `imported` is 0, the imported
; ones alone when it is 1 - the merged list carries both, and the
; local ones were asked first.
(pub :: lspViewFindCtor (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspViewFindCtor decls name imported)
  {
    (let n (vecLen decls))
    (let mut i 0)
    (let mut found (:: None (Option ASTNode)))
    {
      (while (if (< i n)
        (isNone found)
        false)
        {
          (let d (vecGet decls i))
          {
            (if (if (== (nodeTag d) TAG_D_DATA)
              (if (== imported 1)
                (!= (nodeModule d) 0)
                (== (nodeModule d) 0))
              false)
              (set found (lspViewCtorIn (nodeBChildren d) name)))
            (set i (+ i 1))
          }
        })
      found
    }
  })

(pub :: lspViewCtorIn (-> (Vec ASTNode) String (Option ASTNode)))
(pub fn (lspViewCtorIn ctors name)
  {
    (let n (vecLen ctors))
    (let mut i 0)
    (let mut found (:: None (Option ASTNode)))
    {
      (while (if (< i n)
        (isNone found)
        false)
        {
          (if (strEq (nodeAName (vecGet ctors i)) name)
            (set found (Some (vecGet ctors i))))
          (set i (+ i 1))
        })
      found
    }
  })

; A `fn` as a SignatureInformation, read in the document that declares
; it (`dsrc`, `ddecls`). The name is the bare one - an imported
; declaration's `nodeAName` is `ViewHelper$twice` and the reader
; wrote `twice` - and the signature is found under the mangled one,
; because `resolveImports` mangles a `::` and its `fn` alike. `origin`
; names the module of an imported one, after the type, so the label
; still reads as the call.
(pub :: lspViewSigFn (-> String (Vec ASTNode) ASTNode (Option String) Int))
(pub fn (lspViewSigFn dsrc ddecls d origin)
  {
    (let sig (lspFindSig ddecls (nodeAName d) (- (vecLen ddecls) 1)))
    (let ps (nodeBNames d))
    (let starts vecNew)
    (let ends vecNew)
    (let label (strBuilderNew))
    {
      (strBuilderPush label "(")
      (strBuilderPush label (bareOf (nodeAName d)))
      (for p in ps
        {
          (strBuilderPush label " ")
          (vecPush starts (strBuilderLen label))
          (strBuilderPush label p)
          (vecPush ends (strBuilderLen label))
        })
      (strBuilderPush label ")")
      (if (let (Some sig) sig)
        {
          (strBuilderPush label " : ")
          (strBuilderPush label (lspSigType dsrc sig))
        }
        ())
      (if (let (Some name) origin)
        (if (> (strLen name) 0)
          {
            (strBuilderPush label " from ")
            (strBuilderPush label name)
          }))
      (lspViewSigInfo (strBuilderFinish label) starts ends (lspViewSigDoc dsrc ddecls d sig))
    }
  })

; The paragraph above the declaration, read where hover reads it: at
; the `::` when the `fn` has one, because that is where this language
; puts the comment, and at the `fn` itself otherwise.
(pub :: lspViewSigDoc (-> String (Vec ASTNode) ASTNode (Option ASTNode) String))
(pub fn (lspViewSigDoc dsrc ddecls d sig)
  {
    (let at
      (if (let (Some sig) sig)
        sig
        d))
    (if (== (nodeSpan at) 0)
      ""
      {
        (let doc (lspDocComment dsrc (lspFormStart dsrc (spanStart (nodeSpan at)))))
        (let clauses (contractSourceFor ddecls d))
        (if (== (strLen clauses) 0)
          doc
          (concat doc (concat "\n\n```axiom\n" (concat clauses "```"))))
      })
  })

; A constructor: `(Circle Int)`, each field type rendered by the
; checker's own printer and labelled as a parameter, so the client
; bolds the field being written.
(pub :: lspViewSigCtor (-> ASTNode Int))
(pub fn (lspViewSigCtor c)
  {
    (let tys (nodeTyChildren c))
    (let starts vecNew)
    (let ends vecNew)
    (let label (strBuilderNew))
    {
      (strBuilderPush label "(")
      (strBuilderPush label (nodeAName c))
      (if (!= (as tys Int) 0)
        (for ty in tys
          {
            (strBuilderPush label " ")
            (vecPush starts (strBuilderLen label))
            (strBuilderPush label (tyRender ty))
            (vecPush ends (strBuilderLen label))
          }))
      (strBuilderPush label ")")
      (lspViewSigInfo (strBuilderFinish label) starts ends "")
    }
  })

; The SignatureInformation object. The byte offsets into `label`
; become UTF-16 units through `lspCharFrom` from 0, which a label
; with no newline in it makes exact; `documentation` is carried as
; markdown when the declaration has a paragraph and left out when it
; has not.
(pub :: lspViewSigInfo (-> String Ints Ints String Int))
(pub fn (lspViewSigInfo label starts ends doc)
  {
    (let params jsonArr)
    {
      (for i in 0..(vecLen starts)
        (jsonArrPush params
          (jsonObjPut jsonObj "label"
            (jsonArrPush (jsonArrPush jsonArr (jsonNum (lspCharFrom label 0 (vecGet starts i))))
              (jsonNum (lspCharFrom label 0 (vecGet ends i)))))))
      {
        (let base (jsonObjPut (jsonObjPut jsonObj "label" (jsonStr label)) "parameters" params))
        (if (== (strLen doc) 0)
          base
          (jsonObjPut base "documentation"
            (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value" (jsonStr doc))))
      }
    }
  })

; ------------------------------------------------------------------
; A name index over a declaration list, built once per request.
;
; Parameter-name hints ask "which `fn` is this" once per CALL SITE,
; and a document has many more call sites than declarations - so a
; walk of the declaration list per site is the n-squared
; `lspComplWants` exists to avoid, and over the MERGED list it is that
; times every module imported. No hash map is in reach of this file
; (`Map` is imported by `Intern` alone), so this is a bucket table:
; `LSP_VIEW_IDX_SLOTS` slots keyed by a hash of EVERY byte of the
; name, each a Vec of (bare name, node) pairs, empty ones left as 0.
;
; THE FIRST BYTE ALONE WAS TRIED FIRST and was a mistake this
; repository's naming makes certain: every function in this file
; begins `lsp`, and on the gate's document of 2,050 functions named
; `f0`..`f2049` a first-byte key put all of them in one slot - the
; n-squared walk again, wearing an index. Measured on that document
; against a 0.031 s `didOpen`, a whole-document hint request: 0.050 s
; with the first-byte key and 0.012 s with the hash below over the
; 4,100 header hints; 0.074 s and 0.026 s over 6,150 hints when every
; function also calls one. A 60-line window, which is what an editor
; asks for, is 0.016 s either way.
;
; Two entries under one name resolve the language's way: the
; document's own declaration (module 0) shadows an imported one, and
; among the document's own the LAST wins, which is `lspFindDecl`'s
; rule.
; ------------------------------------------------------------------
(pub :: LSP_VIEW_IDX_SLOTS Int)
(pub fn (LSP_VIEW_IDX_SLOTS)
  1024)

(pub :: lspViewIdxNew LspNodeBuckets)
(pub fn (lspViewIdxNew)
  (lspBucketsNew LSP_VIEW_IDX_SLOTS))

; djb2 over the bytes, reduced modulo 2^24 at every step: `h * 33 + b`
; then stays under 2^30, so the arithmetic never wraps and the slot is
; a remainder of the same number on every run.
(pub :: lspViewIdxSlot (-> String Int))
(pub fn (lspViewIdxSlot name)
  {
    (let n (strLen name))
    (let mut h 5381)
    {
      (for i in 0..n
        (set h (% (+ (* h 33) (strByte name i)) 16777216)))
      (% h LSP_VIEW_IDX_SLOTS)
    }
  })

(pub :: lspViewIdxAdd (-> LspNodeBuckets String ASTNode Int))
(pub fn (lspViewIdxAdd idx name node)
  {
    (vecPush (lspBucketFor idx (lspViewIdxSlot name)) (LspNamedNode :name name :node node))
    0
  })

(pub :: lspViewIdxFind (-> LspNodeBuckets String (Option ASTNode)))
(pub fn (lspViewIdxFind idx name)
  (if (let (Some bucket) (vecGet idx (lspViewIdxSlot name)))
    {
      (let mut local (:: None (Option ASTNode)))
      (let mut other (:: None (Option ASTNode)))
      (for entry in bucket
        (if (strEq entry.name name)
          (if (== (nodeModule entry.node) 0)
            (set local (Some entry.node))
            (set other (Some entry.node)))))
      (if (isSome local)
        local
        other)
    }
    None))

; The `fn` declarations a call can name, by bare name: this document's
; and, when its imports resolve, every module's. A failed preflight -
; a half-typed import - is this document alone.
(pub :: lspViewFnIndexFor (-> LspWorkspace String String (Vec ASTNode) LspNodeBuckets))
;@axiom:effect(io)
(pub fn (lspViewFnIndexFor workspace path src decls)
  (lspViewFnIndex
    (if (let (Some r) (lspResolveFor workspace path src decls))
      r.decls
      decls)))

(pub :: lspViewFnIndex (-> (Vec ASTNode) LspNodeBuckets))
(pub fn (lspViewFnIndex list)
  {
    (let idx lspViewIdxNew)
    (let n (vecLen list))
    {
      (for i in 0..n
        {
          (let d (vecGet list i))
          (if (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0))
            (lspViewIdxAdd idx (bareOf (nodeAName d)) d))
        })
      idx
    }
  })

; The `::` signatures of this document, by name, for the header hints
; - the same question `lspFindSig` answers, asked once per `fn` rather
; than by a walk per `fn`.
(pub :: lspViewSigIndex (-> (Vec ASTNode) LspNodeBuckets))
(pub fn (lspViewSigIndex decls)
  {
    (let idx lspViewIdxNew)
    (let n (vecLen decls))
    {
      (for i in 0..n
        {
          (let d (vecGet decls i))
          (if (&& (== (nodeTag d) TAG_D_SIG) (!= (nodeSpan d) 0))
            (lspViewIdxAdd idx (nodeAName d) d))
        })
      idx
    }
  })

; ------------------------------------------------------------------
; `textDocument/inlayHint`: three kinds of hint, inside the requested
; range, on every `fn` whose extent meets it.
;
;   (a) PARAMETER NAMES at call sites - `x:` before the `1` of
;       `(add 1 2)` - for every application whose head names a `fn`
;       this document declares or imports. An argument that IS a
;       variable spelled like the parameter shows nothing, which is
;       rust-analyzer's rule: `(bump x)` where the parameter is `x`
;       says nothing a reader does not see. Operators and
;       constructors have no `fn` declaration and fall out of the
;       same lookup; nothing is special-cased by spelling.
;   (b) PARAMETER TYPES in the header, `: Int` after each name, from
;       the `::` signature's arrow, one parameter per arrow position.
;   (c) THE RETURN TYPE, ` -> Int` after the header's `)`, when the
;       signature has at least one arrow - a nullary `(:: main Int)`
;       has nothing to say there.
;
; A `fn`'s EXTENT is the span from its name to the next declaration's
; name (or EOF): the tree records no form extent, and the next name
; is a bound that costs nothing, where `lspFormEnd` per `fn` would
; rescan the document. A `fn` outside the range is skipped before its
; body is walked, which is what keeps a request for the visible
; window from paying for the whole file.
; ------------------------------------------------------------------
(pub :: lspInlayHints (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspInlayHints workspace src uri params)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError12) jsonArr)
      ((ParseSuccess parsedValue12 parsedPos12)
        ; The heads that are locals - a parameter or a `let`
        ; spelled like a declared `fn` - over the same
        ; declarations the range meets, so `(fn (apply k v) (k
        ; v))` beside a top-level `k` labels nothing.
        {
          (let decls parsedValue12)
          (let ix (lspLineIndex src))
          (let n (strLen src))
          (let range (jsonGet params "range"))
          {
            (let rs
              (if (== range 0)
                0
                (lspOffsetOf src ix (jsonGet range "start"))))
            (let re
              (if (== range 0)
                n
                (lspOffsetOf src ix (jsonGet range "end"))))
            (let fns (lspViewFnIndexFor workspace (lspUriToPath uri) src decls))
            (let sigs (lspViewSigIndex decls))
            (let locals (lspNavLocalIndex src decls rs re))
            (let occs (lspNavOccurrences src decls))
            (let out jsonArr)
            (let mut i 0)
            {
              (while (< i (vecLen decls))
                {
                  (let d (vecGet decls i))
                  {
                    (if (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0))
                      {
                        (let lo (spanStart (nodeSpan d)))
                        (let hi (lspViewNextDeclStart decls i n))
                        (if (&& (< lo re) (> hi rs))
                          {
                            (lspViewHintsHeader out src ix d (lspViewIdxFind sigs (nodeAName d)) rs
                              re)
                            (lspViewHintsExpr out src ix fns locals decls occs (nodeCChild d) rs re)
                          })
                      })
                    (set i (+ i 1))
                  }
                })
              out
            }
          }
        }
      ))
  })

; Where the declaration after `i` begins, or the document length.
(pub :: lspViewNextDeclStart (-> (Vec ASTNode) Int Int Int))
(pub fn (lspViewNextDeclStart decls i n)
  {
    (let mut j (+ i 1))
    (let mut at n)
    {
      (while (if (< j (vecLen decls))
        (== at n)
        false)
        {
          (if (!= (nodeSpan (vecGet decls j)) 0)
            (set at (spanStart (nodeSpan (vecGet decls j)))))
          (set j (+ j 1))
        })
      at
    }
  })

; The header hints, (b) and (c). The positions are recovered from the
; header's bytes: identifiers after the name's span up to the `)`,
; which is exactly the token sequence `parseIdentList` accepted -
; anything else there and the document would not have parsed. The
; byte before the name must be the header's own `(`: the bare nullary
; form `(fn answer 42)` has no parameter list, and its `42` is not a
; parameter however identifier-shaped its digits are.
(pub :: lspViewHintsHeader (-> Int String Ints ASTNode (Option ASTNode) Int Int Int))
(pub fn (lspViewHintsHeader out src ix d sig rs re)
  (if (let (Some sig) sig)
    (if (if (== (nodeTy sig) 0)
      true
      (if (lspViewHeaderOpen src (spanStart (nodeSpan d)))
        false
        true))
      0
      {
        (let ty (nodeTyChild sig))
        (let n (strLen src))
        (let mut i (spanEnd (nodeSpan d)))
        (let mut k 0)
        (let mut close (:: None (Option Int)))
        (let mut go 1)
        {
          (while (if (== go 1)
            (< i n)
            false)
            {
              (let ch (strByte src i))
              (if (lspIsSpace ch)
                (set i (+ i 1))
                (if (== ch 41)
                  {
                    (set close (Some i))
                    (set go 0)
                  }
                  (if (isIdentChar ch)
                    {
                      (let e (skipIdent src i n))
                      {
                        (if (let (Some pt) (nthParamTy ty k))
                          (if (!= (nodeTag pt) TAG_T_ERR)
                            (lspViewHint out src ix e (concat ": " (tyRender pt)) 1 0 rs re)))
                        (set k (+ k 1))
                        (set i e)
                      }
                    }
                    (set go 0))))
            })
          (if (let (Some close) close)
            (if (== (nodeTag ty) TAG_T_ARR)
              (lspViewHint out src ix (+ close 1)
                (concat " -> "
                  (match (lspViewResultTy ty)
                    ((None) "{unknown}")
                    ((Some result) (tyRender result))))
                1 0 rs re)
              0)
            0)
        }
      })
    0))

; Whether the byte before `s`, past any blanks, is a `(`.
(pub :: lspViewHeaderOpen (-> String Int Bool))
(pub fn (lspViewHeaderOpen src s)
  {
    (let mut i (- s 1))
    {
      (while (if (> i 0)
        (docIsBlank (strByte src i))
        false)
        (set i (- i 1)))
      (if (< i 0)
        false
        (== (strByte src i) 40))
    }
  })

; The final result of an arrow type: `(-> Int Int Bool)` folds to
; `Int -> (Int -> Bool)`, so the result is the last `nodeB`.
(pub :: lspViewResultTy (-> ASTNode (Option ASTNode)))
(pub fn (lspViewResultTy ty)
  (if (nodeSame ty nilNode)
    None
    (if (== (nodeTag ty) TAG_T_ARR)
      (lspViewResultTy (nodeBChild ty))
      (Some ty))))

; One InlayHint at byte `off`, appended only when `off` is inside the
; requested range. `kind` is the protocol's: 1 Type, 2 Parameter.
; `padRight` puts a space after a parameter-name label, so `x:` does
; not touch the `1` it names.
(pub :: lspViewHint (-> Int String Ints Int String Int Int Int Int Int))
(pub fn (lspViewHint out src ix off label kind padRight rs re)
  (if (&& (>= off rs) (< off re))
    {
      (let base
        (jsonObjPut
          (jsonObjPut (jsonObjPut jsonObj "position" (lspPosIx src ix off)) "label" (jsonStr label))
          "kind" (jsonNum kind)))
      {
        (jsonArrPush out
          (if (== padRight 1)
            (jsonObjPut base "paddingRight" (jsonBool 1))
            base))
        0
      }
    }
    0))

; ------------------------------------------------------------------
; The body walk for (a).
;
; Every expression tag the parser builds, by its children: nodes are
; walked, Vecs of nodes are walked element by element, and Strings -
; a binder, a field name, a `set` target - are not touched. A tag
; not named here is a leaf. Patterns are not walked: `(Just x)` in
; arm position is a constructor and a binder, and neither is a call.
;
; POSITIONS COME FROM THE BYTES, not the tree. An application's span
; is its head's, a `let` argument's is its binder's, an `if`'s is its
; test's: none of them is where the argument BEGINS, which is the `(`
; the parser does not record. So the head's span - exact, and the one
; thing the tree does place - anchors a scan of the items after it,
; and the i-th item's start is where the i-th argument's hint goes.
; Literals, too, are found this way rather than through their spans,
; so every argument shape takes one path.
; ------------------------------------------------------------------
; A binder name inlay hints stay off: `_` binds nothing, and a `$`
; name is generated (`for$`, gensyms) - the occurrence walk skips
; both for the same reason.
(pub :: lspSkipHintName (-> String Int))
(pub fn (lspSkipHintName name)
  (if (strEq name "_")
    1
    (if (let (Some _) (strFindByte name 36 0))
      1
      0)))

(pub :: lspViewHintsExpr
  (-> Int String Ints LspNodeBuckets LspBuckets (Vec ASTNode) (Vec LspOcc) ASTNode Int Int Int))
(pub fn (lspViewHintsExpr out src ix fns locals decls occs e rs re)
  (if (nodeSame e nilNode)
    0
    {
      (let tag (nodeTag e))
      (if (== tag TAG_E_APP)
        (lspViewHintsApp out src ix fns locals decls occs e rs re)
        (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
          {
            ; A readable value shape hints the binder, `: T` after
            ; its name, the way headers hint parameters. Generated
            ; binders (`for$`, gensyms) and `_` stay quiet, like the
            ; occurrence walk that skips them: a hint on a name no one
            ; wrote is noise about the compiler's innards.
            (if (let (Some t) (lspShapeOf decls occs (nodeBChild e) 16))
              (if (! (lspShapeIsBad t))
                (if (! (== (lspSkipHintName (nodeAName e)) 1))
                  (lspViewHint out src ix (spanEnd (nodeSpan e)) (concat ": " (tyRender t)) 1 0 rs
                    re))))
            (lspViewHintsExpr out src ix fns locals decls occs (nodeBChild e) rs re)
            (lspViewHintsExpr out src ix fns locals decls occs (nodeCChild e) rs re)
          }
          (if (== tag TAG_E_IF)
            {
              (lspViewHintsExpr out src ix fns locals decls occs (nodeAChild e) rs re)
              (lspViewHintsExpr out src ix fns locals decls occs (nodeBChild e) rs re)
              (lspViewHintsExpr out src ix fns locals decls occs (nodeCChild e) rs re)
            }
            (if (== tag TAG_E_LAM)
              (lspViewHintsExpr out src ix fns locals decls occs (nodeBChild e) rs re)
              (if (== tag TAG_E_BEGIN)
                (lspViewHintsVec out src ix fns locals decls occs (nodeAChildren e) rs re)
                (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
                  (if (== tag TAG_E_REGION)
                    (lspViewHintsExpr out src ix fns locals decls occs (nodeBChild e) rs re)
                    {
                      (lspViewHintsExpr out src ix fns locals decls occs (nodeAChild e) rs re)
                      (lspViewHintsVec out src ix fns locals decls occs (nodeBChildren e) rs re)
                    })
                  (if (== tag TAG_E_MATCH)
                    {
                      (lspViewHintsExpr out src ix fns locals decls occs (nodeAChild e) rs re)
                      (lspViewHintsArms out src ix fns locals decls occs (nodeBChildren e) rs re)
                    }
                    ; `cond` is AX2004: the parser builds none, so
                    ; no arm hints one. A variadic `if` arrives as
                    ; nested `if`s.
                    (if (== tag TAG_E_SET)
                      (lspViewHintsExpr out src ix fns locals decls occs (nodeBChild e) rs re)
                      (if (|| (== tag TAG_E_FIELD) (== tag TAG_E_TRY))
                        (lspViewHintsExpr out src ix fns locals decls occs (nodeAChild e) rs re)
                        (if (== tag TAG_E_SETF)
                          {
                            (lspViewHintsExpr out src ix fns locals decls occs (nodeAChild e) rs re)
                            (lspViewHintsExpr out src ix fns locals decls occs (nodeCChild e) rs re)
                          }
                          (if (== tag TAG_E_HANDLE)
                            {
                              (lspViewHintsExpr out src ix fns locals decls occs (nodeAChild e) rs
                                re)
                              (lspViewHintsExpr out src ix fns locals decls occs (nodeCChild e) rs
                                re)
                            }
                            0)))))))))))
    }))

(pub :: lspViewHintsVec
  (-> Int String Ints LspNodeBuckets LspBuckets (Vec ASTNode) (Vec LspOcc) (Vec ASTNode) Int Int
    Int))
(pub fn (lspViewHintsVec out src ix fns locals decls occs xs rs re)
  (if (== (as xs Int) 0)
    0
    {
      (for i in 0..(vecLen xs)
        (lspViewHintsExpr out src ix fns locals decls occs (vecGet xs i) rs re))
      0
    }))

; The arms of a `match` (bodies alone - the pattern is not a call).
(pub :: lspViewHintsArms
  (-> Int String Ints LspNodeBuckets LspBuckets (Vec ASTNode) (Vec LspOcc) (Vec ASTNode) Int Int
    Int))
(pub fn (lspViewHintsArms out src ix fns locals decls occs arms rs re)
  (if (== (as arms Int) 0)
    0
    {
      (for arm in arms
        (if (== (nodeTag arm) TAG_M_ARM)
          (lspViewHintsExpr out src ix fns locals decls occs (nodeBChild arm) rs re)))
      0
    }))

; An application: `(f a b)` is App(App(f, a), b), so the arguments
; come off the spine last-first and are reversed. A head that is a
; variable is a call; any other head - a lambda, a nested form - is
; walked as an expression. Every argument is walked afterwards, since
; each may hold calls of its own.
(pub :: lspViewHintsApp
  (-> Int String Ints LspNodeBuckets LspBuckets (Vec ASTNode) (Vec LspOcc) ASTNode Int Int Int))
(pub fn (lspViewHintsApp out src ix fns locals decls occs e rs re)
  {
    (let args vecNew)
    (let mut h e)
    {
      (while (== (nodeTag h) TAG_E_APP)
        {
          (vecPush args (nodeBChild h))
          (set h (nodeAChild h))
        })
      (lspViewReverse args)
      (if (== (nodeTag h) TAG_E_VAR)
        (lspViewHintsCall out src ix fns locals h args rs re)
        (lspViewHintsExpr out src ix fns locals decls occs h rs re))
      (lspViewHintsVec out src ix fns locals decls occs args rs re)
    }
  })

(pub :: lspViewReverse (-> (Vec ASTNode) Int))
(pub fn (lspViewReverse v)
  {
    (let mut i 0)
    (let mut j (- (vecLen v) 1))
    {
      (while (< i j)
        {
          (let t (vecGet v i))
          {
            (vecSet v i (vecGet v j))
            (vecSet v j t)
            (set i (+ i 1))
            (set j (- j 1))
          }
        })
      0
    }
  })

; The hints for one call: the declaration's parameter names, each at
; the start of the item the bytes hold at that position, for as many
; arguments as the call has and the declaration names.
(pub :: lspViewHintsCall
  (-> Int String Ints LspNodeBuckets LspBuckets ASTNode (Vec ASTNode) Int Int Int))
(pub fn (lspViewHintsCall out src ix fns locals head args rs re)
  ; A head that is a local is not a call to the `fn` it is
  ; spelled like; the walk that knows the scopes says which.
  {
    (let d
      (if (== (nodeSpan head) 0)
        None
        (if (lspNavLocalIndexHas locals (spanStart (nodeSpan head)))
          None
          (lspViewIdxFind fns (bareOf (nodeAName head))))))
    (if (let (Some d) d)
      {
        (let ps (nodeBNames d))
        (let n (strLen src))
        (let mut i (lspViewIdentEnd src (spanStart (nodeSpan head)) n))
        (let mut a 0)
        (let mut go 1)
        {
          (while (if (== go 1)
            (if (< i n)
              (&& (< a (vecLen ps)) (< a (vecLen args)))
              false)
            false)
            {
              (let ch (strByte src i))
              (if (lspIsSpace ch)
                (set i (+ i 1))
                (if (== ch 59)
                  (set i (findNewline src i n))
                  (if (&& (== ch 35) (isBlockOpen src i n))
                    (set i (skipBlockComment src (+ i 2) n))
                    (if (== ch 41)
                      (set go 0)
                      {
                        (if (! (lspViewSameName (vecGet args a) (vecGet ps a)))
                          (lspViewHint out src ix i (concat (vecGet ps a) ":") 2 1 rs re))
                        (set a (+ a 1))
                        (set i (lspViewItemEnd src i n))
                      }))))
            })
          0
        }
      }
      0)
  })

(pub :: lspViewSameName (-> ASTNode String Bool))
(pub fn (lspViewSameName arg name)
  (if (nodeSame arg nilNode)
    false
    (if (== (nodeTag arg) TAG_E_VAR)
      (strEq (nodeAName arg) name)
      false)))

; ------------------------------------------------------------------
; `textDocument/foldingRange`: every form whose `(` and `)` sit on
; different lines, every `{ }` block likewise, a run of two or more
; whole-line `;` comments as "comment", and a run of two or more
; top-level `(import ...)` forms as "imports".
;
; A BYTE SCAN, NOT A PARSE, and that is the point: a half-typed file
; is unparseable exactly while its author is looking at it, and its
; balanced forms still fold. The scanner is `lspFormEnd`'s, with a
; stack of open brackets in place of a depth count so each closer
; knows its own opener; an unbalanced closer is ignored and an
; unclosed opener folds nothing. A `;` is a whole-line comment when
; nothing but blanks precedes it on its line - a `;` inside a string
; is never seen, because the string was stepped over.
; ------------------------------------------------------------------
(pub :: lspFoldingRanges (-> String Int))
(pub fn (lspFoldingRanges src)
  {
    (let n (strLen src))
    (let ix (lspLineIndex src))
    (let out jsonArr)
    (let stack vecNew)
    (let comments vecNew)
    (let mut i 0)
    (let mut impStart (- 0 1))
    (let mut impEnd (- 0 1))
    (let mut impCount 0)
    (let mut topImport 0)
    {
      (while (< i n)
        {
          (let ch (strByte src i))
          (if (== ch 34)
            (set i (skipStringBody src (+ i 1) n))
            (if (isIdentStart ch)
              (set i (skipIdent src (+ i 1) n))
              (if (== ch 39)
                (set i (skipCharBody src (+ i 1) n))
                (if (&& (== ch 35) (isBlockOpen src i n))
                  (set i (skipBlockComment src (+ i 2) n))
                  (if (== ch 59)
                    {
                      (if (lspViewLineBlankBefore src ix i)
                        (vecPush comments (lspLineOfIx ix i)))
                      (set i (findNewline src i n))
                    }
                    {
                      (if (|| (== ch 40) (== ch 123))
                        {
                          ; A top-level `(` opens or breaks an import
                          ; run; the run is flushed at the first form
                          ; that is not an import.
                          (if (&& (== ch 40) (== (vecLen stack) 0))
                            (if (lspViewIsImportAt src i n)
                              {
                                (if (< impStart 0)
                                  (set impStart i))
                                (set topImport 1)
                              }
                              {
                                (lspViewFlushImports out ix impStart impEnd impCount)
                                (set impStart (- 0 1))
                                (set impCount 0)
                                (set topImport 0)
                              }))
                          (vecPush stack i)
                        })
                      (if (|| (== ch 41) (== ch 125))
                        (if (> (vecLen stack) 0)
                          {
                            (let o (vecPop stack))
                            {
                              (lspViewFold out (lspLineOfIx ix o) (lspLineOfIx ix i) "")
                              (if (&& (== (vecLen stack) 0) (== topImport 1))
                                {
                                  (set impEnd i)
                                  (set impCount (+ impCount 1))
                                })
                            }
                          }))
                      (set i (+ i 1))
                    })))))
        })
      (lspViewFlushImports out ix impStart impEnd impCount)
      (lspViewFoldComments out comments)
      out
    }
  })

; One FoldingRange, when the lines differ - a region of one line is
; nothing to fold. `kind` is added when non-empty.
(pub :: lspViewFold (-> Int Int Int String Int))
(pub fn (lspViewFold out sl el kind)
  (if (>= sl el)
    0
    {
      (let base (jsonObjPut (jsonObjPut jsonObj "startLine" (jsonNum sl)) "endLine" (jsonNum el)))
      {
        (jsonArrPush out
          (if (== (strLen kind) 0)
            base
            (jsonObjPut base "kind" (jsonStr kind))))
        0
      }
    }))

; The import run so far, as an "imports" fold when it holds two or
; more CLOSED imports - `impCount` is counted at the closer, so a
; half-typed import at the end of the run does not extend it.
(pub :: lspViewFlushImports (-> Int Ints Int Int Int Int))
(pub fn (lspViewFlushImports out ix impStart impEnd impCount)
  (if (if (>= impStart 0)
    (>= impCount 2)
    false)
    (lspViewFold out (lspLineOfIx ix impStart) (lspLineOfIx ix impEnd) "imports")
    0))

; Whether the form opening at `o` is `(import ...)`: the keyword, then
; a byte that is not part of an identifier, so `(imports` is not one.
; This is the parser's own `kwEq` test made on bytes, since no tree
; exists for a document that does not parse.
(pub :: lspViewIsImportAt (-> String Int Int Bool))
(pub fn (lspViewIsImportAt src o n)
  {
    (let mut i (+ o 1))
    {
      (while (if (< i n)
        (lspIsSpace (strByte src i))
        false)
        (set i (+ i 1)))
      (if (> (+ i 6) n)
        false
        (if (strEq (strSlice src i 6) "import")
          (if (< (+ i 6) n)
            (if (isIdentChar (strByte src (+ i 6)))
              false
              true)
            true)
          false))
    }
  })

; Whether nothing but blanks sits between the start of `off`'s line
; and `off` - what makes a `;` at `off` a whole-line comment rather
; than one trailing code.
(pub :: lspViewLineBlankBefore (-> String Ints Int Bool))
(pub fn (lspViewLineBlankBefore src ix off)
  {
    (let mut i (vecGet ix (lspLineOfIx ix off)))
    (let mut blank 1)
    {
      (while (if (< i off)
        (== blank 1)
        false)
        {
          (if (! (docIsBlank (strByte src i)))
            (set blank 0))
          (set i (+ i 1))
        })
      (== blank 1)
    }
  })

; Runs of two or more consecutive whole-line comments, as "comment"
; folds. `lines` is ascending, because the scan that filled it was;
; a blank line between two comments ends a run, since consecutive
; means consecutive.
(pub :: lspViewFoldComments (-> Int Ints Int))
(pub fn (lspViewFoldComments out lines)
  {
    (let n (vecLen lines))
    (let mut runStart (- 0 1))
    (let mut runEnd (- 0 1))
    {
      (for i in 0..n
        {
          (let ln (vecGet lines i))
          (if (if (>= runStart 0)
            (== ln (+ runEnd 1))
            false)
            (set runEnd ln)
            {
              (lspViewFold out runStart runEnd "comment")
              (set runStart ln)
              (set runEnd ln)
            })
        })
      (lspViewFold out runStart runEnd "comment")
      0
    }
  })

; ------------------------------------------------------------------
; `textDocument/selectionRange`: for each position, the chain of
; ranges a selection expands through - the identifier under the
; cursor, then each enclosing form innermost-out, then the whole
; document.
;
; Built from the document INWARD so that each link's `parent` exists
; before the link does, and answered from the innermost, which is how
; the protocol nests it. A link whose range equals the one before it
; is dropped - a word that is the whole of a form, say - so the client
; sees each range once. Nothing is parsed: a chain of brackets is a
; byte question, and a document that does not parse still has one.
;
; Every form's end comes from ONE forward scan (`lspFormEnds`), not a
; `lspFormEnd` per enclosing form, which cost the depth times the
; document: 50,000 unclosed `(` hung the server for good. The chain
; keeps the `lspSelMaxDepth` innermost forms, so the answer nests no
; deeper than the parser itself accepts.
; ------------------------------------------------------------------
(pub :: lspSelectionRanges (-> String Int Int))
(pub fn (lspSelectionRanges src params)
  {
    (let ix (lspLineIndex src))
    (let positions (jsonGet params "positions"))
    (let out jsonArr)
    (let mut i 0)
    {
      (while (< i (jsonArrLen positions))
        {
          (jsonArrPush out (lspViewSelChain src ix (lspOffsetOf src ix (jsonArrGet positions i))))
          (set i (+ i 1))
        })
      out
    }
  })

(pub :: lspViewSelChain (-> String Ints Int Int))
(pub fn (lspViewSelChain src ix off)
  {
    (let n (strLen src))
    (let opens (lspEnclosingDelimiters src off true))
    (let mut cur (jsonObjPut jsonObj "range" (lspRangeIx src ix (mkSpan 0 n))))
    (let mut ps 0)
    (let mut pe n)
    (let mut i 0)
    {
      ; A cursor on an opening delimiter selects the form or block
      ; it opens; the enclosing scan leaves that opener to us.
      (if (if (< off n)
        (|| (== (strByte src off) 40) (== (strByte src off) 123))
        false)
        (vecPush opens off))
      (if (> (vecLen opens) lspSelMaxDepth)
        (set i (- (vecLen opens) lspSelMaxDepth)))
      {
        (let ends (lspFormEnds src opens))
        (while (< i (vecLen opens))
          {
            (let o (vecGet opens i))
            {
              (let e (vecGet ends i))
              {
                (if (|| (!= o ps) (!= e pe))
                  {
                    (set cur (jsonObjPut
                               (jsonObjPut jsonObj "range" (lspRangeIx src ix (mkSpan o e)))
                               "parent" cur))
                    (set ps o)
                    (set pe e)
                  })
                (set i (+ i 1))
              }
            }
          })
      }
      {
        (let w (lspWordSpan src off))
        (if (if (!= w 0)
          (|| (!= (spanStart w) ps) (!= (spanEnd w) pe))
          false)
          (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix w)) "parent" cur)
          cur)
      }
    }
  })

;; How many enclosing forms a selection chain keeps: the parser's own
;; nesting limit, past which no document parses anyway.
(pub :: lspSelMaxDepth Int)
(pub fn (lspSelMaxDepth)
  parseMaxDepth)

;; The end of every form in `opens`, as `lspFormEnd` answers it, from
;; one forward scan. `opens` is outermost first, as `lspEnclosingDelimiters`
;; answers it, and each form nests inside the one before it: so the
;; innermost closes first, and the same scan carries on to the end of
;; the form around it. A form nothing closes ends at the document's
;; end, as it does for `lspFormEnd`.
(pub :: lspFormEnds (-> String Ints Ints))
(pub fn (lspFormEnds src opens)
  {
    (let n (strLen src))
    (let k (vecLen opens))
    (let ends vecNew)
    {
      (for z in 0..k
        (vecPush ends n))
      (if (> k 0)
        {
          (let mut i (vecGet opens (- k 1)))
          (let mut j (- k 1))
          (let mut depth 0)
          (while (if (< i n)
            (>= j 0)
            false)
            {
              (let ch (strByte src i))
              (if (== ch 34)
                (set i (skipStringBody src (+ i 1) n))
                (if (isIdentStart ch)
                  (set i (skipIdent src (+ i 1) n))
                  (if (== ch 39)
                    (set i (skipCharBody src (+ i 1) n))
                    (if (&& (== ch 35) (isBlockOpen src i n))
                      (set i (skipBlockComment src (+ i 2) n))
                      (if (== ch 59)
                        (set i (findNewline src i n))
                        {
                          (if (|| (== ch 40) (== ch 123))
                            (set depth (+ depth 1)))
                          (if (|| (== ch 41) (== ch 125))
                            {
                              (set depth (- depth 1))
                              (if (<= depth 0)
                                {
                                  (vecSet ends j (+ i 1))
                                  (set j (- j 1))
                                  (set depth 1)
                                })
                            })
                          (set i (+ i 1))
                        })))))
            })
        })
      ends
    }
  })

; ------------------------------------------------------------------
; `textDocument/documentLink`: every `(import M)` whose module the
; resolver's own search finds, as a link over the dotted name to the
; file's URI. The range is the name AS WRITTEN: the parser's span
; names the path's first segment alone, so the range extends over
; identifier bytes and the `.` between segments - `.` is not an
; identifier byte, which is why this is a scan and not `lspWordSpan`.
; An import the search cannot resolve gets no link, and the diagnostic
; the checker publishes for it already says why.
; ------------------------------------------------------------------
(pub :: lspDocumentLinks (-> LspWorkspace String String Int))
;@axiom:effect(io)
(pub fn (lspDocumentLinks workspace src uri)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError13) jsonArr)
      ((ParseSuccess parsedValue13 parsedPos13)
        {
          (let decls parsedValue13)
          (let ix (lspLineIndex src))
          (let n (strLen src))
          (let tcode (checkedTargetCode hostTarget))
          (let entryDir (pathDir (lspUriToPath uri)))
          (let out jsonArr)
          {
            (for d in decls
              (if (&& (== (nodeTag d) TAG_D_IMPORT) (!= (nodeSpan d) 0))
                {
                  (let p (lspWorkspaceModulePath workspace (nodeAName d) tcode entryDir))
                  (if (let (Some path) p)
                    {
                      (let s (spanStart (nodeSpan d)))
                      (let mut e (spanStart (nodeSpan d)))
                      {
                        (while (if (< e n)
                          (|| (isIdentChar (strByte src e)) (== (strByte src e) 46))
                          false)
                          (set e (+ e 1)))
                        (jsonArrPush out
                          (jsonObjPut (jsonObjPut jsonObj "range" (lspRangeIx src ix (mkSpan s e)))
                            "target" (jsonStr (lspPathToUri path))))
                      }
                    })
                }))
            out
          }
        }
      ))
  })

; ------------------------------------------------------------------
; `workspace/symbol`: every declaration the open documents can see -
; their own, and every module each imports - whose bare name holds
; the query, case-folded.
;
; The workspace this server knows is the document store: the editor
; sends it the files that are open and nothing else, and the imports
; of those files are what a reader of them can reach. Each open
; document is parsed and its imports resolved as `lspComplImported`
; resolves them; an imported declaration is placed in ITS file
; through the unit table, with the module as `containerName`. The
; kinds are the outline's, plus EnumMember for a constructor, which
; the outline omits and a search wants. The list stops at
; `LSP_COMPL_MAX`, for the reason completion's does: a search result
; is not a directory listing. A declaration reached twice - a module
; two open documents both import - is listed once, by URI and offset.
; ------------------------------------------------------------------
(pub :: lspWorkspaceSymbols (-> LspWorkspace Strings Strings Int Int))
;@axiom:effect(io)
(pub fn (lspWorkspaceSymbols workspace uris texts params)
  {
    (let query (jsonGetStr params "query"))
    (let out jsonArr)
    (let seen vecNew)
    (let mut j 0)
    {
      (while (if (< j (vecLen uris))
        (< (jsonArrLen out) LSP_COMPL_MAX)
        false)
        {
          (let uri (vecGet uris j))
          (let src (vecGet texts j))
          {
            (if (> (strLen src) 0)
              {
                (let pr (lspParse src))
                (match pr
                  ((ParseFailed parseError14) ())
                  ((ParseSuccess parsedValue14 parsedPos14)
                    {
                      (let decls parsedValue14)
                      {
                        (lspViewSymsLocal out seen query uri src decls)
                        (lspViewSymsImported workspace out seen query (lspUriToPath uri) src decls)
                      }
                    }
                  ))
              })
            (set j (+ j 1))
          }
        })
      out
    }
  })

(pub :: lspViewSymsLocal (-> Int Strings String String String (Vec ASTNode) Int))
(pub fn (lspViewSymsLocal out seen query uri src decls)
  {
    (let ix (lspLineIndex src))
    (let n (vecLen decls))
    (let mut i 0)
    {
      (while (if (< i n)
        (< (jsonArrLen out) LSP_COMPL_MAX)
        false)
        {
          (let d (vecGet decls i))
          {
            (if (&& (lspWantsSymbol (nodeTag d))
                  (&& (!= (nodeSpan d) 0) (== (expIsJoinMarker (nodeAName d)) 0)))
              {
                (lspViewSymOffer out seen query uri src ix (nodeAName d) (lspSymKind (nodeTag d))
                  (nodeSpan d) None)
                (if (== (nodeTag d) TAG_D_DATA)
                  (lspViewSymCtors out seen query uri src ix (nodeBChildren d) None))
              })
            (set i (+ i 1))
          }
        })
      0
    }
  })

; The imported half. The name test is asked BEFORE the unit is looked
; up and before its URI and line index are built - the cheap question
; first, as `lspComplWants` asks it - and a unit's URI and index are
; made once, when it first has a symbol to place.
(pub :: lspViewSymsImported (-> LspWorkspace Int Strings String String String (Vec ASTNode) Int))
;@axiom:effect(io)
(pub fn (lspViewSymsImported workspace out seen query path src decls)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      (let n (vecLen allDecls))
      (let uuris vecNew)
      (let uixs vecNew)
      (let mut i 0)
      {
        (while (< i (vecLen units))
          {
            (vecPush uuris "")
            (vecPush uixs 0)
            (set i (+ i 1))
          })
        (set i 0)
        (while (if (< i n)
          (< (jsonArrLen out) LSP_COMPL_MAX)
          false)
          {
            (let d (vecGet allDecls i))
            {
              (if (&& (lspWantsSymbol (nodeTag d)) (&& (!= (nodeModule d) 0) (!= (nodeSpan d) 0)))
                {
                  (let bare (bareOf (nodeAName d)))
                  (if (lspViewDeclWants d bare query)
                    {
                      (let u (lspUnitOf units (nodeModuleOpt d)))
                      (if (let (Some u) u)
                        {
                          (let unit (vecGet units u))
                          {
                            (lspViewUnitPrep uuris uixs unit u)
                            (lspViewSymOffer out seen query (vecGet uuris u) (unitSrc unit)
                              (vecGetVec uixs u) bare (lspSymKind (nodeTag d)) (nodeSpan d)
                              (unitName unit))
                            (if (== (nodeTag d) TAG_D_DATA)
                              (lspViewSymCtors out seen query (vecGet uuris u) (unitSrc unit)
                                (vecGetVec uixs u) (nodeBChildren d) (unitName unit)))
                          }
                        })
                    })
                })
              (set i (+ i 1))
            }
          })
        0
      }
    }
    0))

; Whether a declaration has anything to list for `query`: its own
; name, or - for a `data` - one of its constructors' names.
(pub :: lspViewDeclWants (-> ASTNode String String Bool))
(pub fn (lspViewDeclWants d bare query)
  (if (lspStrHasFold bare query)
    true
    (if (== (nodeTag d) TAG_D_DATA)
      (lspViewCtorsWant (nodeBChildren d) query)
      false)))

(pub :: lspViewCtorsWant (-> (Vec ASTNode) String Bool))
(pub fn (lspViewCtorsWant ctors query)
  {
    (let mut i 0)
    (let mut found 0)
    {
      (while (if (< i (vecLen ctors))
        (== found 0)
        false)
        {
          (if (lspStrHasFold (nodeAName (vecGet ctors i)) query)
            (set found 1))
          (set i (+ i 1))
        })
      (== found 1)
    }
  })

; The URI and line index of unit `u`, made on first use.
(pub :: lspViewUnitPrep (-> Strings Ints core::CUnit2 Int Int))
;@axiom:effect(io)
(pub fn (lspViewUnitPrep uuris uixs unit u)
  (if (== (vecGet uixs u) 0)
    {
      (vecSet uuris u (lspPathToUri (unitFile unit)))
      (vecSet uixs u (as (lspLineIndex (unitSrc unit)) Int))
      0
    }
    0))

(pub :: lspViewSymCtors
  (-> Int Strings String String String Ints (Vec ASTNode) (Option String) Int))
(pub fn (lspViewSymCtors out seen query uri src ix ctors container)
  {
    (let mut i 0)
    {
      (while (if (< i (vecLen ctors))
        (< (jsonArrLen out) LSP_COMPL_MAX)
        false)
        {
          (let c (vecGet ctors i))
          {
            (if (!= (nodeSpan c) 0)
              (lspViewSymOffer out seen query uri src ix (nodeAName c) 22 (nodeSpan c) container))
            (set i (+ i 1))
          }
        })
      0
    }
  })

; One SymbolInformation, when `name` holds the query and the
; declaration at `uri`:`span` has not been listed already.
(pub :: lspViewSymOffer
  (-> Int Strings String String String Ints String Int Int (Option String) Int))
(pub fn (lspViewSymOffer out seen query uri src ix name kind span container)
  (if (>= (jsonArrLen out) LSP_COMPL_MAX)
    0
    (if (lspStrHasFold name query)
      {
        (let key (concat uri (concat "#" (fmtInt (spanStart span)))))
        (if (lspSeenHas seen key)
          0
          {
            (let base
              (jsonObjPut
                (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr name)) "kind" (jsonNum kind))
                "location"
                (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range"
                  (lspRangeIx src ix span))))
            {
              (vecPush seen key)
              (jsonArrPush out
                (match container
                  ((None) base)
                  ((Some name)
                    (if (== (strLen name) 0)
                      base
                      (jsonObjPut base "containerName" (jsonStr name)))
                  )))
              0
            }
          })
      }
      0)))

; Case-insensitive substring, ASCII-folded: `TWI` is in `twice`. An
; empty needle is in everything, which is what an empty query means.
(pub :: lspStrHasFold (-> String String Bool))
(pub fn (lspStrHasFold hay needle)
  {
    (let hn (strLen hay))
    (let nn (strLen needle))
    (let mut i 0)
    (let mut found 0)
    {
      (while (if (== found 0)
        (<= (+ i nn) hn)
        false)
        {
          (if (lspViewFoldEqAt hay i needle nn)
            (set found 1))
          (set i (+ i 1))
        })
      (== found 1)
    }
  })

(pub :: lspViewFoldEqAt (-> String Int String Int Bool))
(pub fn (lspViewFoldEqAt hay at needle nn)
  {
    (let mut k 0)
    (let mut same 1)
    {
      (while (if (== same 1)
        (< k nn)
        false)
        {
          (if (! (== (lspViewFoldByte (strByte hay (+ at k))) (lspViewFoldByte (strByte needle k))))
            (set same 0))
          (set k (+ k 1))
        })
      (== same 1)
    }
  })

(pub :: lspViewFoldByte (-> Int Int))
(pub fn (lspViewFoldByte b)
  (if (&& (>= b 65) (<= b 90))
    (+ b 32)
    b))

; ==================================================================
; END SECTION VIEW
; ==================================================================
; ==================================================================
; SECTION FIX: formatting, code actions, macro expansion, code
; lenses, type definition, diagnostics for imported modules
; ==================================================================
; The requests that CHANGE or RUN code from the editor: the formatter
; as one whole-document edit, the compiler's machine-applicable fixes
; as quickfixes beside a signature assist, a `Run` lens on `main`, type
; definition, and `axiom/expandMacro` - the analogue of
; `rust-analyzer/expandMacro`, and the reason the AST printer at the
; end of this section exists: nothing else in the compiler turns a
; node back into source.
;
; TWO OF THESE EXPAND, and MAC-TOOL-3 is why that is said first.
; `codeAction` and `expandMacro` run the pipeline `lspCheckDoc` runs -
; preflight, `resolveImports`, `expandProgram`, and for code actions
; the checker - because a quickfix IS a checker
; diagnostic and an expansion IS the expander's output; neither can be
; read off the raw tree. Neither is a per-keystroke request either: a
; client asks for code actions when the cursor rests and for an
; expansion on demand, and each costs about one `didOpen` of the same
; document, which the editor paid on the last keystroke anyway.
; `formatting`, `codeLens` and `typeDefinition` read the raw tree and
; expand nothing.
;
; `textDocument/rangeFormatting` is deliberately NOT offered: the
; formatter is whole-document - `fmtFormat` proves its output a fixed
; point of the whole file - and a range cut out of that output would
; be a different formatter with a weaker proof.
;
(pub :: lspFixHandles (-> String Bool))
(pub fn (lspFixHandles method)
  (|| (strEq method "textDocument/formatting")
    (|| (strEq method "textDocument/codeAction")
      (|| (strEq method "textDocument/typeDefinition")
        (|| (strEq method "textDocument/codeLens") (strEq method "axiom/expandMacro"))))))

(:: lspFixWithText (-> LspWorkspace String Int Int String String String))
;@axiom:effect(io)
(fn (lspFixWithText workspace method id params uri src)
  (if (strEq method "textDocument/formatting")
    (lspReplyBody id (lspFormatting src))
    (if (strEq method "textDocument/codeAction")
      (lspReplyBody id (lspCodeAction workspace src uri params))
      (if (strEq method "textDocument/typeDefinition")
        (lspReplyBody id (lspTypeDefinition workspace src uri params))
        (if (strEq method "textDocument/codeLens")
          (lspReplyBody id (lspCodeLens src uri))
          (lspReplyBody id (lspExpandMacro workspace src uri params)))))))

(:: lspFixWithoutText (-> String Int String))
(fn (lspFixWithoutText method id)
  (if (|| (strEq method "textDocument/formatting")
        (|| (strEq method "textDocument/codeAction") (strEq method "textDocument/codeLens")))
    (lspReplyBody id jsonArr)
    (if (|| (strEq method "textDocument/typeDefinition") (strEq method "axiom/expandMacro"))
      (lspReplyBody id jsonNull)
      (lspErrorBody id (- 0 32601) (concat "method not found: " method)))))

(pub :: lspFixDispatch (-> LspWorkspace String Int Int Strings Strings String))
;@axiom:effect(io)
(pub fn (lspFixDispatch workspace method id params uris texts)
  {
    (let uri (lspParamsUri params))
    (match (docText uris texts uri)
      ((None) (lspFixWithoutText method id))
      ((Some src) (lspFixWithText workspace method id params uri src)))
  })

; `codeActionProvider` is an object rather than a boolean so a client
; can see which kinds are on offer before it asks; `codeLensProvider`
; says every lens is complete as sent; `expandMacro` rides
; under `experimental` because it is not a protocol method, which is
; where rust-analyzer advertises its own.
(pub :: lspFixCaps (-> Int Int))
(pub fn (lspFixCaps caps)
  (jsonObjPut
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut (jsonObjPut caps "documentFormattingProvider" (jsonBool 1))
          "codeActionProvider"
          (jsonObjPut jsonObj "codeActionKinds"
            (jsonArrPush
              (jsonArrPush
                (jsonArrPush (jsonArrPush jsonArr (jsonStr "quickfix"))
                  (jsonStr "refactor.rewrite"))
                (jsonStr "refactor.extract"))
              (jsonStr "source.organizeImports"))))
        "typeDefinitionProvider" (jsonBool 1))
      "codeLensProvider" (jsonObjPut jsonObj "resolveProvider" (jsonBool 0)))
    "experimental" (jsonObjPut jsonObj "expandMacro" (jsonBool 1))))

; ------------------------------------------------------------------
; `textDocument/formatting`: the formatter's output as ONE edit over
; the whole document.
;
; `fmtFormat` is the function `axiom fmt` runs, so what the editor
; writes is byte for byte what the command would have written - the
; gate formats a copy of its document with the command and holds the
; edit's text equal to the file. A refusal - a document no completion
; can save, or an output the formatter could not prove a fixed point -
; is null, the protocol's "nothing to do here" and what a half-typed
; file gets past its parens; an already-formatted document is an empty
; list, so the client writes nothing. Pure: the formatter takes a string
; and answers one.
; ------------------------------------------------------------------
(pub :: lspFormatting (-> String Int))
(pub fn (lspFormatting src)
  {
    (let r (fmtFormat src))
    (if (== (fzOk r) 0)
      jsonNull
      {
        (let text (fzText r))
        (if (strEq text src)
          jsonArr
          {
            (let ix (lspLineIndex src))
            (jsonArrPush jsonArr
              (jsonObjPut
                (jsonObjPut jsonObj "range"
                  (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix 0)) "end"
                    (lspPosIx src ix (strLen src))))
                "newText" (jsonStr text)))
          })
      })
  })

; ------------------------------------------------------------------
; The expansion pipeline, once, for the two requests that need it.
;
; This is `lspCheckDoc`'s call order - preflight, `resolveImports`,
; `expandProgram` - with the DIAGNOSTIC HANDLES kept
; rather than rendered, and `expandProgram`'s answer kept too: the
; (name, macro) pairs of every declaration phase D generated, which is
; what `expandMacro` attributes its output by and what `axiom symbols`
; reads for `#generated=`. Answers `None` when an import cannot be
; read - the resolver would exit the process on one, see
; `lspPreflight` - and otherwise the merged declaration list, the unit
; table, the expansion diagnostics, `gens`, and the frame table
; `expAttachFrames` wants. The checker is NOT run here: one caller
; refuses to run it and the other decides after reading the
; diagnostics.
; ------------------------------------------------------------------
(pub struct LspExpanded
  (decls : Nodes)
  (units : Units)
  (diags : Diags)
  (gens : GeneratedOrigins)
  (frames : Frames))

(pub :: lspFixExpand (-> LspWorkspace String String (Vec ASTNode) (Option LspExpanded)))
;@axiom:effect(io)
(pub fn (lspFixExpand workspace path src decls)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      (let ftbl vecNew)
      (let eds vecNew)
      {
        (let gens (expandProgram decls allDecls eds ftbl units r.bares r.fulls r.mods))
        (Some (LspExpanded :decls allDecls :units units :diags eds :gens gens :frames ftbl))
      }
    }
    None))

; ------------------------------------------------------------------
; `textDocument/codeAction`: the fixes the compiler already knows how
; to make, and one assist it can make from what the checker inferred.
;
; QUICKFIXES ARE THE DIAGNOSTICS' OWN. A help whose fix span is not 0
; is a machine-applicable fix - what AXDL prints after `~>` - and it is
; offered exactly as the diagnostic carries it: the title is the help's
; text, the edit replaces the FIX span with the fix text, and the fix
; span is not always the diagnostic's anchor. AX3012 anchors on the
; `set` and fixes the BINDER three lines up with `mut x`; the gate
; derives that binder's range from the document and holds the edit to
; it. AX3001's typo suggestion and AX3003's constructor suggestion fix
; the reference itself. Nothing here decides what a fix is: a code that
; gains one in `typecheck.ax` gains a quickfix here without a line
; changing.
;
; THE ASSIST is "Add type signature for `f`", for a `fn` in this
; document with no `::` of its name, and the type it writes is the one
; the checker inferred - `tcFns` word 1, the same entry `axiom symbols`
; prints, so `symbols` is the reference an implementer checks this
; against. Written in the PARSER's spelling, `(-> Int Int)`, not the
; checker's `(Int -> Int)`: `tyRender` writes the latter and
; `parseTypeParens` refuses it (probed: AX2001 at the arrow), and an
; assist that inserts a line the compiler then rejects is worse than
; none. It is refused when the inferred type has an unknown part; a
; type variable the checker could not generalise is offered as
; `symbols` would print it, and is that function's business.
;
; Both halves need the pipeline `lspCheckDoc` runs. Expansion's
; refusals keep the checker from running, for the reason that function
; gives: the tree it gave up on is one the checker has died on.
;
; THREE MORE, described at their own banner below: an import for an
; AX3001 name another module declares, `pub` for an AX3023 name, and
; an extraction to a `let`. The first two
; hang off the same diagnostic list the quickfixes read; the third
; reads the WRITTEN tree and is asked BEFORE the pipeline runs,
; because phase D rewrites the declaration list in place - an
; invocation becomes its first product - and NAV's occurrence walk
; over a rewritten list would anchor binders at bytes a product
; copied from its template. It is pushed last so a client that shows
; actions in the order sent keeps the compiler's fixes first. THREE
; MORE STILL, at the LINT ASSISTS banner below: a
; `nolint` suppression on every live Hint, a simplification of the
; `if` the bool lint names, and an `unhandled(trap)` acknowledge on
; AX3053 - the lint two run the same walk the publish path runs,
; the third the same diagnostic list as the import.
; ------------------------------------------------------------------
(pub :: lspCodeAction (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspCodeAction workspace src uri params)
  {
    (let only (jsonGet (jsonGet params "context") "only"))
    (let out jsonArr)
    {
      ; Source actions are requested explicitly, including on save.
      (if (&& (!= only 0) (lspActionKindWanted only "source.organizeImports"))
        {
          (let action (lspOrganizeImports workspace src uri))
          (if (!= action 0)
            (jsonArrPush out action))
        })
      (if (|| (== only 0)
            (|| (lspActionKindWanted only "quickfix")
              (|| (lspActionKindWanted only "refactor.rewrite")
                (lspActionKindWanted only "refactor.extract"))))
        {
          (let actions (lspCodeActionLocal workspace src uri params))
          (let mut i 0)
          (while (< i (jsonArrLen actions))
            {
              (let action (jsonArrGet actions i))
              (if (|| (== only 0) (lspActionKindWanted only (jsonStrVal (jsonGet action "kind"))))
                (jsonArrPush out action))
              (set i (+ i 1))
            })
        })
      out
    }
  })

; A kind includes its dot-separated descendants; `source` requests
; organise imports, while `source.organizeImports.extra` does not.
(pub :: lspActionKindWanted (-> Int String Bool))
(pub fn (lspActionKindWanted only kind)
  {
    (let mut i 0)
    (let mut wanted false)
    (while (< i (jsonArrLen only))
      {
        (let parent (jsonStrVal (jsonArrGet only i)))
        (if (|| (== (strLen parent) 0)
              (|| (strEq parent kind) (strStartsWith kind (concat parent "."))))
          (set wanted true))
        (set i (+ i 1))
      })
    wanted
  })

; Whole import lines and their attached comment blocks move together.
; Separators stay in their original slots, keeping blank lines and line
; endings. Module docs and banners remain outside a movable block.
(pub :: lspOrganizeImports (-> LspWorkspace String String Int))
;@axiom:effect(io)
(pub fn (lspOrganizeImports workspace src uri)
  {
    (let tokens (lex src))
    (let tags (scanAxtags src))
    (let pr (parseModuleWith tokens tags))
    (match pr
      ((ParseFailed parseError15) 0)
      ((ParseSuccess parsedValue15 parsedPos15)
        {
          (let decls parsedValue15)
          (let edit (lspOrganizeEdit src uri decls tokens tags))
          (if (== edit 0)
            0
            (if (let (Some expanded) (lspFixExpand workspace (lspUriToPath uri) src decls))
              (if (|| (> (countErrorDiags expanded.diags) 0) (lspOrganizeConflict expanded.decls))
                0
                (jsonObjPut
                  (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr "Organise imports")) "kind"
                    (jsonStr "source.organizeImports"))
                  "edit" edit))
              0))
        }
      ))
  })

(pub :: lspOrganizeConflict (-> (Vec ASTNode) Bool))
(pub fn (lspOrganizeConflict decls)
  {
    (let seen (lspBucketsNew LSP_VIEW_IDX_SLOTS))
    (let mut conflict false)
    (for d in decls
      (if (!= (nodeModule d) 0)
        {
          (if (|| (== (nodeTag d) TAG_D_MACRO)
                (|| (== (nodeTag d) TAG_D_DATA) (== (nodeTag d) TAG_D_STRUCT)))
            (if (lspOrganizeRemember seen (nodeAName d) d)
              (set conflict true)))
          (if (== (nodeTag d) TAG_D_DATA)
            {
              (let constructors (nodeBChildren d))
              (for j in 0..(vecLen constructors)
                (if (lspOrganizeRemember seen (nodeAName (vecGet constructors j)) d)
                  (set conflict true)))
            })
        }))
    conflict
  })

; Constructor nodes need their enclosing data declaration's module.
; A name shared within one module keeps its written declaration order.
(pub :: lspOrganizeRemember (-> LspNodeBuckets String ASTNode Bool))
(pub fn (lspOrganizeRemember seen name owner)
  {
    (let previous (lspViewIdxFind seen name))
    (if (let (Some previous) previous)
      (! (strEq (nodeModuleName previous) (nodeModuleName owner)))
      {
        (lspViewIdxAdd seen name owner)
        false
      })
  })

; The lexer finds the opener even with comments in the import header.
; The parser has already refused late, nested and incomplete imports.
(pub :: lspOrganizeEdit (-> String String (Vec ASTNode) Tokens Axtags Int))
(pub fn (lspOrganizeEdit src uri decls tokens tags)
  {
    (let chunks vecNew)
    (let sorted vecNew)
    (if (|| (! (lspOrganizeCollect src decls tokens chunks sorted)) (< (vecLen chunks) 2))
      0
      (lspOrganizeSorted src uri chunks sorted tags))
  })

(pub :: lspOrganizeCollect
  (-> String (Vec ASTNode) Tokens (Vec LspImportChunk) (Vec LspImportChunk) Bool))
(pub fn (lspOrganizeCollect src decls tokens chunks sorted)
  {
    (let mut i 0)
    (let mut t 0)
    (let mut opener (:: None (Option Int)))
    (let mut valid true)
    (while (< i (vecLen decls))
      {
        (let d (vecGet decls i))
        (if (== (nodeTag d) TAG_D_IMPORT)
          {
            (while (if (< t (vecLen tokens))
              (<= (spanStart (tokenSpan (vecGet tokens t))) (spanStart (nodeSpan d)))
              false)
              {
                (let token (vecGet tokens t))
                (if (== (kindInt (tokenKind token)) (kindInt TK_LPAREN))
                  (set opener (Some (spanStart (tokenSpan token)))))
                (set t (+ t 1))
              })
            (match opener
              ((None)
                (set valid false)
              )
              ((Some open)
                (match (lspOrganizeStart src open)
                  ((None)
                    (set valid false)
                  )
                  ((Some start)
                    (match (lspOrganizeEnd src (lspFormEnd src open))
                      ((None)
                        (set valid false)
                      )
                      ((Some end)
                        {
                          (let chunk (LspImportChunk :name (nodeAName d) :start start :end end))
                          (vecPush chunks chunk)
                          (if (> (vecLen chunks) 1)
                            {
                              (let previous (vecGet chunks (- (vecLen chunks) 2)))
                              (if (! (lspOrganizeBlank src previous.end start))
                                (set valid false))
                            })
                          (vecPush sorted chunk)
                        }
                      ))
                  ))
              ))
          })
        (set i (+ i 1))
      })
    valid
  })

; Only whitespace may separate movable blocks. A section comment,
; block comment or metadata tag with unclear attachment refuses.
(pub :: lspOrganizeBlank (-> String Int Int Bool))
(pub fn (lspOrganizeBlank src start end)
  {
    (let mut blank true)
    (for i in start..end
      (if (! (lspIsSpace (strByte src i)))
        (set blank false)))
    blank
  })

(pub :: lspOrganizeStart (-> String Int (Option Int)))
(pub fn (lspOrganizeStart src opener)
  (if (|| (< opener 0) (>= opener (strLen src)))
    None
    {
      (let mut start (lineStartOf src opener))
      (let mut go true)
      (let mut valid (lspOrganizeBlank src start opener))
      (while (&& go (> start 0))
        {
          (let previous (docPrevLineStart src start))
          (let end
            (if (if (> start 1)
              (== (strByte src (- start 2)) 13)
              false)
              (- start 2)
              (- start 1)))
          (let line (strSlice src previous (- end previous)))
          (if (&& (docIsDocLine line) (! (docIsModuleDocLine line)))
            (set start previous)
            (set go false))
        })
      (if valid
        (Some start)
        None)
    }))

; The line ending is a separator, so a last import without a newline
; can move without joining the next form onto its line.
(pub :: lspOrganizeEnd (-> String Int (Option Int)))
(pub fn (lspOrganizeEnd src formEnd)
  (if (|| (< formEnd 0) (> formEnd (strLen src)))
    None
    {
      (let end (docLineEndFrom src formEnd))
      (let mut i formEnd)
      (while (if (< i end)
        (lspIsSpace (strByte src i))
        false)
        (set i (+ i 1)))
      (if (if (< i end)
        (!= (strByte src i) 59)
        false)
        None
        (if (if (> end 0)
          (== (strByte src (- end 1)) 13)
          false)
          (Some (- end 1))
          (Some end)))
    }))

(pub :: lspOrganizeSorted (-> String String (Vec LspImportChunk) (Vec LspImportChunk) Axtags Int))
(pub fn (lspOrganizeSorted src uri chunks sorted tags)
  {
    (let n (vecLen sorted))
    (let mut valid true)
    (for i in 1..n
      {
        (let chunk (vecGet sorted i))
        (let mut j i)
        (while (if (> j 0)
          {
            (let previous (vecGet sorted (- j 1)))
            (> (strCmp previous.name chunk.name) 0)
          }
          false)
          {
            (vecSet sorted j (vecGet sorted (- j 1)))
            (set j (- j 1))
          })
        (vecSet sorted j chunk)
      })
    (let textB (strBuilderNew))
    (for i in 0..n
      {
        (let chunk (vecGet sorted i))
        (if (> i 0)
          {
            (let before (vecGet sorted (- i 1)))
            (if (strEq before.name chunk.name)
              (set valid false))
            (let previous (vecGet chunks (- i 1)))
            (let current (vecGet chunks i))
            (strBuilderPush textB (strSlice src previous.end (- current.start previous.end)))
          })
        (strBuilderPush textB (strSlice src chunk.start (- chunk.end chunk.start)))
      })
    (let text (strBuilderFinish textB))
    (let first (vecGet chunks 0))
    (let last (vecGet chunks (- n 1)))
    (let start first.start)
    (let end last.end)
    ; Tags attach by source offset, including inside and trailing
    ; comments and tags separated from the header by blank lines.
    (for tag in tags
      (if (< tag.off end)
        (set valid false)))
    (if (|| (! valid) (strEq text (strSlice src start (- end start))))
      0
      (lspEditJson uri (lspRangeIx src (lspLineIndex src) (mkSpan start end)) text))
  })

(pub :: lspCodeActionLocal (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspCodeActionLocal workspace src uri params)
  {
    (let pr (parseModuleWith (lex src) (scanAxtags src)))
    (match pr
      ((ParseFailed parseError16) jsonArr)
      ((ParseSuccess parsedValue16 parsedPos16)
        {
          (let decls parsedValue16)
          (let ix (lspLineIndex src))
          {
            (let want (lspRangeSpan src ix (jsonGet params "range")))
            (let rawVis (lspWrittenVis decls))
            {
              (let extract (lspExtractAction src uri decls ix want))
              (let lintRecs (lspLintRecs src decls))
              (let path (lspUriToPath uri))
              (let out jsonArr)
              {
                (let ex (lspFixExpand workspace path src decls))
                {
                  (if (let (Some ex) ex)
                    {
                      (let eds ex.diags)
                      {
                        (let tc
                          (:: (if (> (countErrorDiags eds) 0)
                            None
                            (Some (checkModuleTc decls ex.decls ex.units))) (Option TC)))
                        {
                          (let ds
                            (if (let (Some checked) tc)
                              (orderDiags
                                (expMergeInto eds
                                  {
                                    (let cds (tcOutVec checked))
                                    {
                                      (expAttachFrames cds ex.frames ex.units)
                                      cds
                                    }
                                  }))
                              (orderDiags eds)))
                          {
                            (lspQuickfixes out ds src uri ix want)
                            (if (let (Some checked) tc)
                              (lspSigAssists out decls rawVis (lspViewSigIndex decls)
                                (lspFixEntryIndex (tcFnsVec checked)) src uri ix want))
                            (lspNameAssists out ds src uri ix want decls path ex.decls ex.units)
                            (lspLintAssists out src uri ix decls lintRecs want)
                            (lspUnhandledAssists out ds src uri ix want decls)
                          }
                        }
                      }
                    }
                    ())
                  (if (! (== extract 0))
                    (jsonArrPush out extract))
                  out
                }
              }
            }
          }
        }
      ))
  })

; The bytes a `range` parameter covers, as a span. A request with no
; range - which a client may send - means the whole document.
(pub :: lspRangeSpan (-> String Ints Int Int))
(pub fn (lspRangeSpan src ix range)
  (if (== range 0)
    (mkSpan 0 (strLen src))
    {
      (let s (jsonGet range "start"))
      (let e (jsonGet range "end"))
      (mkSpan
        (if (== s 0)
          0
          (lspOffsetOf src ix s))
        (if (== e 0)
          (strLen src)
          (lspOffsetOf src ix e)))
    }))

; Whether a non-zero span touches the requested bytes. INCLUSIVE at
; both ends, because a code action request is usually an empty range
; at the caret, and a caret resting just after a name is asking about
; that name.
(pub :: lspSpanMeets (-> Int Int Bool))
(pub fn (lspSpanMeets sp want)
  (if (== sp 0)
    false
    (&& (<= (spanStart sp) (spanEnd want)) (>= (spanEnd sp) (spanStart want)))))

; Only this document's diagnostics - `diagUnit` 0 - are asked, for the
; reason `lspCheckDoc` publishes only those: a fix into an imported
; module's bytes is an edit to a file the request did not name.
(pub :: lspQuickfixes (-> Int (Vec diag::Diag) String String Ints Int Int))
(pub fn (lspQuickfixes out ds src uri ix want)
  {
    (let n (vecLen ds))
    {
      (for i in 0..n
        {
          (let d (vecGet ds i))
          (if (== (diagUnit d) 0)
            (lspQuickfixesOf out d src uri ix want))
        })
      0
    }
  })

(pub :: lspQuickfixesOf (-> Int diag::Diag String String Ints Int Int))
(pub fn (lspQuickfixesOf out d src uri ix want)
  {
    (let n (diagHelpCount d))
    {
      (for i in 0..n
        (if (let (Some fix) (diagHelpFix d i))
          (if (|| (lspSpanMeets (diagSpan d) want) (lspSpanMeets fix.span want))
            (jsonArrPush out (lspQuickfixJson d i fix src uri ix)))))
      0
    }
  })

; `isPreferred` because a fix the compiler wrote is the fix; an editor
; binds its "apply preferred fix" key to exactly this flag.
(pub :: lspQuickfixJson (-> diag::Diag Int DFix String String Ints Int))
(pub fn (lspQuickfixJson d i fix src uri ix)
  (jsonObjPut
    (jsonObjPut
      (jsonObjPut
        (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr (diagHelpMsg d i))) "kind"
          (jsonStr "quickfix"))
        "diagnostics" (jsonArrPush jsonArr (lspDiagJson d src ix uri)))
      "isPreferred" (jsonBool 1))
    "edit" (lspEditJson uri (lspRangeIx src ix fix.span) fix.text)))

; A `WorkspaceEdit` of one `TextEdit` in one document.
(pub :: lspEditJson (-> String Int String Int))
(pub fn (lspEditJson uri range text)
  (jsonObjPut jsonObj "changes"
    (jsonObjPut jsonObj uri
      (jsonArrPush jsonArr
        (jsonObjPut (jsonObjPut jsonObj "range" range) "newText" (jsonStr text))))))

; The visibility each declaration was WRITTEN with - `nodeVis` for a
; spanned `fn`, -1 for everything else - taken BEFORE the pipeline
; runs, because it does not survive it: `resolveImports` stamps every
; written entry declaration `pub` in place (expand.ax records that
; in its phase D header, and a probe of the assist on `(fn (twice x)
; ...)` wrote `(pub :: twice ...)`). The list is positional, and stays
; aligned with `decls` because phase D overwrites in place and appends
; after; a product that overwrote an invocation is at an index this
; list marks -1, so no assist is offered for a generated fn - its
; "form" would be the invocation's.
(pub :: lspWrittenVis (-> (Vec ASTNode) Ints))
(pub fn (lspWrittenVis decls)
  {
    (let out vecNew)
    (let n (vecLen decls))
    {
      (for i in 0..n
        {
          (let d (vecGet decls i))
          (vecPush out
            (if (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0))
              (nodeVis d)
              (- 0 1)))
        })
      out
    }
  })

; The cheap question first, in the order the questions cost: was it a
; written `fn` (one word), does its form open at or before the range's
; end (a scan back over `(pub fn (` to the column-zero paren - the
; FORM's start and not the name's, because a caret at column 0 of the
; fn's own line is inside the form and five bytes before the name),
; does the form reach the range (a scan of that form), has it a
; signature, what did the checker infer. The last two are INDEX
; lookups - `sigs` over this document's `::` declarations, `entries`
; over `tcFns` - and were walks: a whole-document range on the
; gate's 2,000-declaration document measured 1.34x the `didOpen` with
; every signature grouped at the top (2,000 walks of 4,000
; declarations) and 1.87x with no signatures at all (2,000 walks of
; the checker's table), against 0.72x for a one-line range.
(pub :: lspSigAssists
  (-> Int (Vec ASTNode) Ints LspNodeBuckets LspFnBuckets String String Ints Int Int))
(pub fn (lspSigAssists out decls rawVis sigs entries src uri ix want)
  {
    (let n (vecLen rawVis))
    {
      (for i in 0..n
        {
          (let d (vecGet decls i))
          (let vis (vecGet rawVis i))
          (if (&& (>= vis 0) (&& (== (nodeTag d) TAG_D_FN) (!= (nodeSpan d) 0)))
            {
              (let o (lspFormStart src (spanStart (nodeSpan d))))
              (if (&& (<= o (spanEnd want)) (>= (lspFormEnd src o) (spanStart want)))
                (if (! (! (isNone (lspViewIdxFind sigs (nodeAName d)))))
                  (if (let (Some entry) (lspFixEntryFind entries (nodeAName d)))
                    (if (lspTyKnown entry.ty)
                      (jsonArrPush out (lspSigAssistJson d vis entry.ty src uri ix o))))))
            })
        })
      0
    }
  })

; The checker supplies typed entries. A bucket owns each entry once,
; and absence is distinct from a function whose inferred type is unknown.
(pub :: lspFixEntryIndex (-> (Vec FnEnt) LspFnBuckets))
(pub fn (lspFixEntryIndex fns)
  {
    (let index (lspBucketsNew LSP_VIEW_IDX_SLOTS))
    (for entry in fns
      (vecPush (lspBucketFor index (lspViewIdxSlot entry.name)) entry))
    index
  })

(pub :: lspFixEntryFind (-> LspFnBuckets String (Option FnEnt)))
(pub fn (lspFixEntryFind index name)
  (if (let (Some bucket) (vecGet index (lspViewIdxSlot name)))
    {
      (let mut i 0)
      (let mut found None)
      (while (&& (< i (vecLen bucket)) (isNone found))
        {
          (let entry (vecGet bucket i))
          (if (strEq entry.name name)
            (set found (Some entry)))
          (set i (+ i 1))
        })
      found
    }
    None))

; The signature goes on its own line directly above the form, at the
; form's own column - which is 0 for every declaration `lspFormStart`
; found by its column-zero rule, and is where this language writes a
; `::`: between the paragraph and the `fn`, so hover's paragraph rule
; keeps working on the result.
(pub :: lspSigAssistJson (-> ASTNode Int ASTNode String String Ints Int Int))
(pub fn (lspSigAssistJson d vis ty src uri ix o)
  {
    (let name (nodeAName d))
    {
      (let text
        (concat
          (concat
            (concat
              (if (== vis 1)
                "(pub :: "
                "(:: ")
              name)
            " ")
          (concat (lspRenderTypeR ty (lspFreshRenames ty)) ")\n")))
      (jsonObjPut
        (jsonObjPut
          (jsonObjPut jsonObj "title"
            (jsonStr (concat (concat "Add type signature for `" name) "`")))
          "kind" (jsonStr "refactor.rewrite"))
        "edit"
        (lspEditJson uri
          (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx src ix o)) "end" (lspPosIx src ix o))
          text))
    }
  })

; ------------------------------------------------------------------
; Three assists the compiler does not write, and what each one reads.
;
; IMPORT A NAME - `quickfix`, on an AX3001 whose reference is a bare
; name. The name is looked for as a `pub` declaration in every module
; the resolver could reach: the directories `moduleSearchDirs`
; answers, in its order - the entry file's own, the manifest's
; `depend` dirs, `AXIOM_PATH`, `AXIOM_STDLIB` - each walked three
; levels down, because a nested `Sys/Platform.darwin.ax` is a module
; too. A file is a candidate under the name the resolver would give
; it (`Sys.Platform`, the platform suffix folded through
; `targetOsSuffix`), and it counts only when `moduleSrcPath` resolves
; that name to THIS file - which is the ladder's own shadowing rule,
; asked rather than restated: a `Str.ax` beside the entry file hides
; the stdlib's. The cheap question first: the file's bytes must spell
; the name as a whole word before it is lexed and parsed, because a
; parse is the expensive step and a file that never writes the name
; cannot declare it. One action per module found, titled
; ``Import `name` from `Mod` ``; its edit adds the name to an existing
; `(import Mod (...))` list, else writes `(import Mod (name))` on its
; own line after the last import, else at the top of the file. Nothing
; is kept across requests - the arena rule. Measured with the stdlib on
; `AXIOM_STDLIB` and a five-file entry directory: 0.035 s for the
; whole request against 0.004 s without the search, on a document too
; small to time `didOpen` on; the walk is one `listDir` per
; directory, one read per `.ax` file, and a parse per file that
; spells the name.
;
; MAKE A NAME PUBLIC - `quickfix`, on AX3023. The diagnostic names
; the module and the name in backticks, in either order (the checker
; has two sites: the import's name list, and the reference itself),
; so both readings are tried against the merged declaration list and
; the one that finds a declaration in that module wins. The
; declaration's WRITTEN visibility is read from its own file's bytes -
; `resolveImports` overwrites `nodeVis` with "exported", which says
; whether the import's list admits the name, not whether `pub` was
; written. Measured: `check` needs BOTH the `fn` and its `::` to be
; `pub` (either alone still reports AX3023), so the edit inserts
; `pub ` after the opening paren of each, in the module's own file -
; a `WorkspaceEdit` keyed by that file's URI. A name written `pub`
; that AX3023 still reports is one the document's import list left
; out - measured: `(import M (a))` beside a call of the exported `b`
; reports `` `b` is private to module `M` `` - and the honest edit is
; then the import list's, offered under the import title.
;
; LINT ASSISTS - `quickfix` suppressions on the editor-only Hints,
; a `refactor.rewrite` simplifying the `if` one of them names, and a
; `quickfix` acknowledging AX3053 - described here rather than at each
; site.
;
; A Hint carries no machine fix - there is nothing to apply, only a
; style to quiet or an arm that never runs - so these are the
; server's own, like the import and `pub` assists above, and they
; hang off the same primitive: the lint RECORDS, run fresh inside
; this request over the same declaration list the publish path
; lints (`lspCheckDoc` expands before it walks, here as there), so
; an assist is offered exactly where its Hint is drawn and nowhere
; else. No record grows a field for them: the suppressor needs the
; owner the record already names, and the rewrite needs the
; condition span the record already points at, with the `if` form
; recovered from the bytes (`lspEnclosingOpens`/`lspFormEnd`, the
; byte questions `selectionRange` is built on).
;
; SUPPRESS `code` ON `owner`: `;@axiom:nolint(code)` on its own line
; directly above the owner declaration's first line - the placement
; `tests/lsp/103-lint-nolint.ax` pins three ways. Suppression is BY
; NAME (the map `lspLintSuppBuild` builds), so either half of a
; `::`/`fn` pair would do; the first same-named declaration wins.
; Offered once per (owner, code): two unread bindings in one body
; would otherwise answer two identical actions. Suppressed records
; never reach this walk - an assist for a Hint the client cannot
; see would be an edit with no visible reason.
;
; SIMPLIFY TO `c`: `(if c true false)` answers `c`, so the rewrite
; replaces the whole `if` form with the condition's own bytes. The
; lint's own guards are the action's: a bare-name condition, the
; booleans unrebound, and the dead-branch check first (an
; `(if true true false)` draws one Hint, and it is not this one's) -
; all decided by the record's existence on this same source, which
; is why nothing here re-verifies the arms. A dead branch gets no
; rewrite: the live arm is an arbitrary expression and only some
; nodes carry spans, so a rewrite that fires for names and goes
; missing for calls would be a second rule to explain; the
; suppressor covers those sites.
;
; TREAT UNHANDLED `E` AS A DELIBERATE ABORT: `;@axiom:unhandled(trap)`
; above this document's `(effect E ...)` declaration, for an AX3053
; whose effect is declared HERE. The tag's value is always the
; literal `trap` (`docs/reference.md`, `unhandled(trap)`), so the
; diagnostic's message is read for the effect NAME only, and an
; effect from another module gets no action: a tag into a file the
; request did not name is the cross-file edit `prepareRename`
; refuses to make. Skipped where the declaration already carries an
; `unhandled` tag of any value - `unhandled(abort)` still reports,
; and a second tag line would be a guess about which one the author
; meant.
; ------------------------------------------------------------------
; The lint walk's live records over this request's source: the same
; records `lspLintDoc` publishes, minus the suppressed ones, so an
; assist is never offered for a Hint the client cannot see.
(pub :: lspLintRecs (-> String (Vec ASTNode) (Vec LspLintRec)))
(pub fn (lspLintRecs src decls)
  {
    (let lx (lspLintContext src))
    {
      (lspLintSuppBuild lx decls)
      (for i in 0..(vecLen decls)
        (lspLintWalkDecl lx (vecGet decls i)))
      {
        (let all lx.records)
        (let live vecNew)
        {
          (for r in all
            (if (! (lspLintSuppressed lx r.owner r.code))
              (vecPush live r)))
          live
        }
      }
    }
  })

; The owner declaration a suppressor tags: the first declaration of
; that name with a span, or 0. Suppression is by name, so which
; same-named half wins does not matter; the lint's span is in any
; case inside the owner's body, which follows every same-named head.
(pub :: lspLintOwnerDecl (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspLintOwnerDecl decls owner i)
  (if (>= i (vecLen decls))
    None
    {
      (let d (vecGet decls i))
      (if (&& (strEq (nodeAName d) owner) (!= (nodeSpan d) 0))
        (Some d)
        (lspLintOwnerDecl decls owner (+ i 1)))
    }))

; Both lint assists for every live record the request meets. `recs`
; is `lspLintRecs` over the WRITTEN tree, which `lspCodeAction` takes
; before `lspFixExpand` rewrites it, for `lspCheckDoc`'s reason: a walk
; over what expansion made is a walk over a DAG, and one nested macro
; made it 2^115 paths long.
(pub :: lspLintAssists (-> Int String String Ints (Vec ASTNode) (Vec LspLintRec) Int Int))
(pub fn (lspLintAssists out src uri ix decls recs want)
  {
    (let seen vecNew)
    {
      (for r in recs
        {
          (let sp r.span)
          (if (lspSpanMeets sp want)
            {
              (lspNolintOffer out src uri ix decls want r.code r.owner sp r.msg seen)
              (if (strEq r.code (lintBoolIf))
                (lspBoolIfOffer out src uri ix sp r.msg seen))
            })
        })
      0
    }
  })

; One suppression per (owner, code): the tag line above the owner
; declaration's first line. No action when the owner is nowhere to
; be found, which a macro-generated name would be.
(pub :: lspNolintOffer
  (-> Int String String Ints (Vec ASTNode) Int String String Int String Strings Int))
(pub fn (lspNolintOffer out src uri ix decls want code owner sp msg seen)
  {
    (let key (concat owner (concat "$" code)))
    (if (isSome (strVecIdx seen key))
      0
      {
        (let d (lspLintOwnerDecl decls owner 0))
        (if (let (Some d) d)
          {
            (vecPush seen key)
            (jsonArrPush out
              (jsonObjPut
                (jsonObjPut
                  (jsonObjPut
                    (jsonObjPut jsonObj "title"
                      (jsonStr
                        (concat (concat (concat "Suppress `" code) "` on `") (concat owner "`"))))
                    "kind" (jsonStr "quickfix"))
                  "diagnostics" (jsonArrPush jsonArr (lspLintJson src ix sp code msg)))
                "edit"
                (lspFixInsert uri src ix (lineStartOf src (spanStart (nodeSpan d)))
                  (concat (concat ";@axiom:nolint(" code) ")\n"))))
            0
          }
          0)
      })
  })

; The `if` form simplified to its condition: the whole form goes,
; the condition's own bytes stay. The opener is the innermost one
; enclosing the condition the record points at - a bare name, so
; nothing but `(if ` stands between them - and the `(if` bytes are
; checked rather than assumed. No action on a spanless form, which
; is the precision rule wearing work clothes.
(pub :: lspBoolIfOffer (-> Int String String Ints Int String Strings Int))
(pub fn (lspBoolIfOffer out src uri ix sp msg seen)
  {
    (let opens (lspEnclosingOpens src (spanStart sp)))
    (if (== (vecLen opens) 0)
      0
      {
        (let o (vecGet opens (- (vecLen opens) 1)))
        {
          (let key (concat "if$" (fmtInt o)))
          (if (isSome (strVecIdx seen key))
            0
            (if (|| (|| (>= (+ o 2) (strLen src)) (!= (strByte src o) 40))
                  (|| (!= (strByte src (+ o 1)) 105) (!= (strByte src (+ o 2)) 102)))
              0
              {
                (let e (lspFormEnd src o))
                (if (<= e o)
                  0
                  {
                    (let cond (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))
                    (if (== (strLen cond) 0)
                      0
                      {
                        (vecPush seen key)
                        (jsonArrPush out
                          (jsonObjPut
                            (jsonObjPut
                              (jsonObjPut
                                (jsonObjPut jsonObj "title"
                                  (jsonStr (concat (concat "Simplify to `" cond) "`")))
                                "kind" (jsonStr "refactor.rewrite"))
                              "diagnostics"
                              (jsonArrPush jsonArr (lspLintJson src ix sp (lintBoolIf) msg)))
                            "edit" (lspEditJson uri (lspRangeIx src ix (mkSpan o e)) cond)))
                        0
                      })
                  })
              }))
        }
      })
  })

; The effect NAME an AX3053 message names - the backticked name after
; `effect `, in either message shape - or "". A quote that never
; closes, or no `effect ` at all, is not parsed further: no action
; rather than a tag for the wrong effect.
(pub :: lspEffectQuoted (-> String String))
(pub fn (lspEffectQuoted msg)
  {
    (let n (strLen msg))
    (let mut i 0)
    (let mut out "")
    {
      (while (&& (== (strLen out) 0) (< i n))
        {
          (if (&& (<= (+ i 8) n)
                (&& (== (strByte msg i) 101)
                  (&& (== (strByte msg (+ i 1)) 102)
                    (&& (== (strByte msg (+ i 2)) 102)
                      (&& (== (strByte msg (+ i 3)) 101)
                        (&& (== (strByte msg (+ i 4)) 99)
                          (&& (== (strByte msg (+ i 5)) 116)
                            (&& (== (strByte msg (+ i 6)) 32) (== (strByte msg (+ i 7)) 96)))))))))
            {
              (let mut j (+ i 8))
              {
                (while (&& (< j n) (isIdentChar (strByte msg j)))
                  (set j (+ j 1)))
                (if (&& (> j (+ i 8)) (&& (< j n) (== (strByte msg j) 96)))
                  (set out (strSlice msg (+ i 8) (- j (+ i 8)))))
              }
            })
          (set i (+ i 1))
        })
      out
    }
  })

; This document's `(effect E ...)` declaration, or 0. Only this
; document's: an effect from another module gets no action, for the
; reason the banner gives.
(pub :: lspFindEffect (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindEffect decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_EFFECT) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        (Some d)
        (lspFindEffect decls name (- i 1)))
    }))

; Whether the declaration already carries a tag of that key, by the
; tag content's head - `unhandled(abort)` starts with `unhandled`.
(pub :: lspDeclHasTagKey (-> ASTNode String Bool))
(pub fn (lspDeclHasTagKey d key)
  (match (nodeAxtagsOpt d)
    ((None) false)
    ((Some tags)
      {
        (let mut out false)
        (for tag in tags
          (if (strStartsWith tag.content key)
            (set out true)))
        out
      }
    )))

; One acknowledge per AX3053 the request meets, where this document
; declares the effect and carries no `unhandled` tag on it.
(pub :: lspUnhandledAssists (-> Int (Vec diag::Diag) String String Ints Int (Vec ASTNode) Int))
(pub fn (lspUnhandledAssists out ds src uri ix want decls)
  {
    (let n (vecLen ds))
    (let seen vecNew)
    {
      (for i in 0..n
        {
          (let d (vecGet ds i))
          (if (&& (== (diagUnit d) 0)
                (&& (strEq (diagCode d) "AX3053") (lspSpanMeets (diagSpan d) want)))
            {
              (let eff (lspEffectQuoted (diagMsg d)))
              (if (! (== (strLen eff) 0))
                (if (! (isSome (strVecIdx seen eff)))
                  {
                    (let ed (lspFindEffect decls eff (- (vecLen decls) 1)))
                    (if (let (Some ed) ed)
                      (if (! (lspDeclHasTagKey ed "unhandled"))
                        {
                          (vecPush seen eff)
                          (jsonArrPush out
                            (jsonObjPut
                              (jsonObjPut
                                (jsonObjPut
                                  (jsonObjPut jsonObj "title"
                                    (jsonStr
                                      (concat (concat "Treat unhandled `" eff)
                                        "` as a deliberate abort")))
                                  "kind" (jsonStr "quickfix"))
                                "diagnostics" (jsonArrPush jsonArr (lspDiagJson d src ix uri)))
                              "edit"
                              (lspFixInsert uri src ix (lineStartOf src (spanStart (nodeSpan ed)))
                                ";@axiom:unhandled(trap)\n")))
                        })
                      ())
                  }))
            })
        })
      0
    }
  })

; EXTRACT TO `let` - `refactor.extract`, on a range and no diagnostic.
; The range, trimmed of whitespace, must be EXACTLY one item of the
; document - a form to its closer, a brace block, a literal or an
; identifier, by VIEW's item scanner - inside the body of a `fn` of
; this document. The item is found by descending from the body
; through the item that holds it at each level; the STATEMENT it is
; hoisted above is the innermost item on that path that is a direct
; child of a `{ }` block, else the body itself. What is hoisted must
; be evaluated exactly once, unconditionally, whenever the statement
; is, so every form strictly between the statement and the item must
; be one whose argument at that position is: any call; the test of an
; `if`, the scrutinee of a `match`, the first operand of `&&` or
; `||`; the body of a `let`, the value of a `set`, the operand of a
; `cast` or `alloc`; a field of a `struct` construction. A `lambda`,
; `while`, `cond` or `handle` between them, a head position, or a
; binding list refuses. Then NAV's occurrence walk: every local
; reference inside the item must be bound OUTSIDE the statement (or
; inside the item), or the binding would be out of scope at the new
; site - `(let ((y 1)) (+ y 2))` does not extract `(+ y 2)`. The
; binder is `extracted`, or `extracted2`, `extracted3` ... past every
; name the document spells. The statement is replaced by `(let ((x
; E)) S')` with `x` for `E` in `S'`. What this changes on purpose: the
; item now runs before whatever the statement evaluated ahead of it.
; ------------------------------------------------------------------
(pub :: lspNameAssists
  (-> Int (Vec diag::Diag) String String Ints Int (Vec ASTNode) String (Vec ASTNode)
    (Vec core::CUnit2) Int))
;@axiom:effect(io)
(pub fn (lspNameAssists out ds src uri ix want decls path allDecls units)
  {
    (let n (vecLen ds))
    (let seen vecNew)
    {
      (for i in 0..n
        {
          (let d (vecGet ds i))
          (if (&& (== (diagUnit d) 0) (lspSpanMeets (diagSpan d) want))
            (if (strEq (diagCode d) "AX3001")
              (lspImportAssists out d src uri ix decls path seen)
              (if (strEq (diagCode d) "AX3023")
                (lspPublicAssist out d src uri ix decls allDecls units seen))))
        })
      0
    }
  })

; A CodeAction carrying one diagnostic and one WorkspaceEdit.
(pub :: lspFixActionJson (-> String String diag::Diag String String Ints Int Int))
(pub fn (lspFixActionJson title kind d src uri ix edit)
  (jsonObjPut
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr title)) "kind" (jsonStr kind))
      "diagnostics" (jsonArrPush jsonArr (lspDiagJson d src ix uri)))
    "edit" edit))

; One zero-width TextEdit at byte `at` of the text `ix` indexes.
(pub :: lspFixTextEdit (-> String Ints Int String Int))
(pub fn (lspFixTextEdit text ix at s)
  (jsonObjPut
    (jsonObjPut jsonObj "range"
      (jsonObjPut (jsonObjPut jsonObj "start" (lspPosIx text ix at)) "end" (lspPosIx text ix at)))
    "newText" (jsonStr s)))

; The same, as a whole WorkspaceEdit in `uri`.
(pub :: lspFixInsert (-> String String Ints Int String Int))
(pub fn (lspFixInsert uri src ix at s)
  (jsonObjPut jsonObj "changes"
    (jsonObjPut jsonObj uri (jsonArrPush jsonArr (lspFixTextEdit src ix at s)))))

(pub :: lspFixImportTitle (-> String String String))
(pub fn (lspFixImportTitle mod name)
  (concat (concat (concat "Import `" name) "` from `") (concat mod "`")))

; The name AX3001 reports is the reference's own bytes; a qualified
; `Mod::name` spans its first segment alone, and names its module
; already, so it is not this assist's question.
(pub :: lspImportAssists (-> Int diag::Diag String String Ints (Vec ASTNode) String Strings Int))
;@axiom:effect(io)
(pub fn (lspImportAssists out d src uri ix decls path seen)
  {
    (let sp (diagSpan d))
    (if (== sp 0)
      0
      {
        (let name (strSlice src (spanStart sp) (- (spanEnd sp) (spanStart sp))))
        (if (|| (== (strLen name) 0) (lspFixIsQualified src (spanEnd sp)))
          0
          {
            (let mods (lspFixSearch name path))
            {
              (for i in 0..(vecLen mods)
                (lspImportOffer out d src uri ix decls (vecGet mods i) name seen))
              0
            }
          })
      })
  })

(pub :: lspFixIsQualified (-> String Int Bool))
(pub fn (lspFixIsQualified src e)
  (&& (< (+ e 1) (strLen src)) (&& (== (strByte src e) 58) (== (strByte src (+ e 1)) 58))))

; One action per (module, name), whatever the number of diagnostics
; that asked for it - a whole-document range meets every one.
(pub :: lspImportOffer
  (-> Int diag::Diag String String Ints (Vec ASTNode) String String Strings Int))
(pub fn (lspImportOffer out d src uri ix decls mod name seen)
  {
    (let key (concat mod (concat "$" name)))
    (if (isSome (strVecIdx seen key))
      0
      {
        (let edit (lspImportEdit src uri ix decls mod name))
        (if (== edit 0)
          0
          {
            (vecPush seen key)
            (jsonArrPush out
              (lspFixActionJson (lspFixImportTitle mod name) "quickfix" d src uri ix edit))
            0
          })
      })
  })

; The import edit, in this document: the name added to `Mod`'s
; existing list, else a new import line after the last one, else the
; first line of the file. A module imported WITHOUT a list already
; exports everything it can, so there is nothing to write - 0.
(pub :: lspImportEdit (-> String String Ints (Vec ASTNode) String String Int))
(pub fn (lspImportEdit src uri ix decls mod name)
  {
    (let imp (lspFixFindImport decls mod (- (vecLen decls) 1)))
    (if (let (Some imp) imp)
      (if (== (vecLen (nodeBNames imp)) 0)
        0
        {
          (let o (lspFormStart src (spanStart (nodeSpan imp))))
          {
            (let e (lspFormEnd src o))
            (if (let (Some lo) (strFindByte src 40 (+ o 1)))
              (if (>= lo e)
                0
                (lspFixInsert uri src ix (- (lspFormEnd src lo) 1) (concat " " name)))
              0)
          }
        })
      {
        (let last (lspFixLastImport decls (- (vecLen decls) 1)))
        (if (let (Some last) last)
          (lspFixInsert uri src ix (lspFormEnd src (lspFormStart src (spanStart (nodeSpan last))))
            (concat "\n" (lspFixImportLine mod name)))
          (lspFixInsert uri src ix 0 (concat (lspFixImportLine mod name) "\n")))
      })
  })

(pub :: lspFixImportLine (-> String String String))
(pub fn (lspFixImportLine mod name)
  (concat (concat "(import " mod) (concat (concat " (" name) "))")))

; This document's import of `mod`, last wins, or None.
(pub :: lspFixFindImport (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFixFindImport decls mod i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_IMPORT) (&& (!= (nodeSpan d) 0) (strEq (nodeAName d) mod)))
        (Some d)
        (lspFixFindImport decls mod (- i 1)))
    }))

(pub :: lspFixLastImport (-> (Vec ASTNode) Int (Option ASTNode)))
(pub fn (lspFixLastImport decls i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_IMPORT) (!= (nodeSpan d) 0))
        (Some d)
        (lspFixLastImport decls (- i 1)))
    }))

; ------------------------------------------------------------------
; The search: every module the resolver could reach that declares
; `name` `pub`, as a Vec of module names in the resolver's order.
; ------------------------------------------------------------------
(pub :: lspFixSearch (-> String String Strings))
;@axiom:effect(io)
(pub fn (lspFixSearch name path)
  {
    (let tcode (checkedTargetCode hostTarget))
    (let entryDir (pathDir path))
    (let found vecNew)
    (let seen vecNew)
    {
      (let dirs (moduleSearchDirs entryDir))
      {
        (for i in 0..(vecLen dirs)
          (lspFixScanDir (vecGetStr dirs i) "" "" 0 name path tcode entryDir found seen))
        found
      }
    }
  })

; One directory, `rel` below the search root `dir`: every `.ax` entry
; is a candidate module `modPrefix` + its stem; every other entry that
; is a directory with a module-segment name is walked, three levels
; deep at most. Dot-files and dot-directories are skipped. A root of
; "" is the working directory - `moduleSearchDirs` pushes it for an
; entry file named with no directory - and is listed as `./`.
(pub :: lspFixScanDir (-> String String String Int String String Int String Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspFixScanDir dir rel modPrefix depth name path tcode entryDir found seen)
  {
    (let names
      (unwrapOr
        (listDir
          (if (== (strLen dir) 0)
            (concat "./" rel)
            (concat dir rel)))
        vecNew))
    {
      (let n (vecLen names))
      {
        (for i in 0..n
          {
            (let nm (vecGet names i))
            (if (! (|| (== (strLen nm) 0) (== (strByte nm 0) 46)))
              {
                (let full (concat dir (concat rel nm)))
                (if (lspFixEndsWith nm ".ax")
                  {
                    (let stem (lspFixStemOf nm tcode))
                    (if (! (== (strLen stem) 0))
                      (lspFixConsider full (concat modPrefix stem) name path tcode entryDir found
                        seen))
                  }
                  (if (&& (< depth 3) (&& (lspFixIsSegment nm) (isDir full)))
                    (lspFixScanDir dir (concat rel (concat nm "/"))
                      (concat modPrefix (concat nm ".")) (+ depth 1) name path tcode entryDir found
                      seen)))
              })
          })
        0
      }
    }
  })

; The module stem of a file name, under this target's suffix ladder -
; `Platform.darwin.ax` is `Platform` on darwin and nothing on linux -
; or "" for a name the resolver could not be asked for.
(pub :: lspFixStemOf (-> String Int String))
(pub fn (lspFixStemOf nm tcode)
  {
    (let stem
      (if (lspFixEndsWith nm (targetOsArchSuffix tcode))
        (lspFixDropEnd nm (strLen (targetOsArchSuffix tcode)))
        (if (lspFixEndsWith nm (targetOsSuffix tcode))
          (lspFixDropEnd nm (strLen (targetOsSuffix tcode)))
          (if (lspFixEndsWith nm ".ax")
            (lspFixDropEnd nm 3)
            ""))))
    (if (lspFixIsSegment stem)
      stem
      "")
  })

; A module-path segment: what `parseModPath` reads between the dots,
; which is an identifier - so a stem holding another target's suffix
; (`Platform.linux`) is refused by its dot.
(pub :: lspFixIsSegment (-> String Bool))
(pub fn (lspFixIsSegment s)
  (&& (> (strLen s) 0) (&& (isIdentStart (strByte s 0)) (lspAllIdentBytes s 0))))

(pub :: lspFixEndsWith (-> String String Bool))
(pub fn (lspFixEndsWith s suf)
  (&& (>= (strLen s) (strLen suf))
    (strEq (strSlice s (- (strLen s) (strLen suf)) (strLen suf)) suf)))

(pub :: lspFixDropEnd (-> String Int String))
(pub fn (lspFixDropEnd s k)
  (strSlice s 0 (- (strLen s) k)))

; One candidate file. Not the document itself; not a module already
; decided; read, and parsed only when its bytes spell the name as a
; whole word; and counted only when the resolver would pick THIS
; file for the module name, which is the ladder's shadowing rule.
(pub :: lspFixConsider (-> String String String String Int String Strings Strings Int))
;@axiom:effect(io)
(pub fn (lspFixConsider full mod name path tcode entryDir found seen)
  (if (|| (strEq full path) (isSome (strVecIdx seen mod)))
    0
    {
      (let text (unwrapOr (readFile full) ""))
      (if (lspFixHasWord text name)
        (if (strEq (moduleSrcPath mod tcode entryDir) full)
          {
            (vecPush seen mod)
            {
              (let pr (parseModuleWith (lex text) (scanAxtags text)))
              (match pr
                ((ParseFailed parseError17) 0)
                ((ParseSuccess parsedValue17 parsedPos17)
                  (if (lspFixDeclaresPub parsedValue17 name)
                    {
                      (vecPush found mod)
                      0
                    }
                    0)
                ))
            }
          }
          0)
        0)
    }))

; Whether `text` spells `name` with a non-identifier byte (or an
; edge) on each side. The lexer's own identifier rule, so `strLen`
; is not found in `strLength`.
(pub :: lspFixHasWord (-> String String Bool))
(pub fn (lspFixHasWord text name)
  {
    (let n (strLen text))
    (let k (strLen name))
    (let mut i 0)
    (let mut found false)
    {
      (while (if found
        false
        (&& (> k 0) (<= (+ i k) n)))
        (if (let (Some j) (strFindByte text (strByte name 0) i))
          (if (> (+ j k) n)
            (set i n)
            {
              (if (&& (lspFixBytesEq text j name k) (lspFixWordEdges text j k))
                (set found true))
              (set i (+ j 1))
            })
          (set i n)))
      found
    }
  })

(pub :: lspFixBytesEq (-> String Int String Int Bool))
(pub fn (lspFixBytesEq text j name k)
  {
    (let mut m 0)
    (let mut same true)
    {
      (while (if same
        (< m k)
        false)
        {
          (if (! (== (strByte text (+ j m)) (strByte name m)))
            (set same false))
          (set m (+ m 1))
        })
      same
    }
  })

(pub :: lspFixWordEdges (-> String Int Int Bool))
(pub fn (lspFixWordEdges text j k)
  (&&
    (if (== j 0)
      true
      (lspNavNot (isIdentChar (strByte text (- j 1)))))
    (if (>= (+ j k) (strLen text))
      true
      (lspNavNot (isIdentChar (strByte text (+ j k)))))))

; Whether a raw declaration list makes `name` leave its module: a
; `pub` fn, macro, struct or alias of that name, a `pub` data with a
; constructor of it, a `pub` extern block with an item of it, or a
; `pub` trait with a method of it. Measured: a `pub ::` beside a
; private `fn` does not export the fn, so a signature alone is not
; counted.
(pub :: lspFixDeclaresPub (-> (Vec ASTNode) String Bool))
(pub fn (lspFixDeclaresPub decls name)
  {
    (let n (vecLen decls))
    (let mut i 0)
    (let mut found false)
    {
      (while (if found
        false
        (< i n))
        {
          (let d (vecGet decls i))
          {
            (if (&& (== (nodeVis d) 1) (lspFixDeclNames d name))
              (set found true))
            (set i (+ i 1))
          }
        })
      found
    }
  })

(pub :: lspFixDeclNames (-> ASTNode String Bool))
(pub fn (lspFixDeclNames d name)
  {
    (let tag (nodeTag d))
    (if (|| (== tag TAG_D_FN)
          (|| (== tag TAG_D_MACRO) (|| (== tag TAG_D_STRUCT) (== tag TAG_D_ALIAS))))
      (strEq (nodeAName d) name)
      (if (== tag TAG_D_DATA)
        (isSome (lspCtorIndex (nodeBChildren d) name 0))
        (if (== tag TAG_D_EXTERN)
          (== (strVecHas (nodeBNames d) name) 1)
          false)))
  })

; ------------------------------------------------------------------
; `pub` for an AX3023 name.
; ------------------------------------------------------------------
(pub :: lspPublicAssist
  (-> Int diag::Diag String String Ints (Vec ASTNode) (Vec ASTNode) (Vec core::CUnit2) Strings Int))
;@axiom:effect(io)
(pub fn (lspPublicAssist out d src uri ix decls allDecls units seen)
  {
    (let a (lspFixBacktick (diagMsg d) 0))
    (let b (lspFixBacktick (diagMsg d) 1))
    (if (|| (== (strLen a) 0) (== (strLen b) 0))
      0
      {
        (let first (lspFixDeclIn allDecls a (lspFixAfterColons b) (- (vecLen allDecls) 1)))
        (if (let (Some first) first)
          (lspPublicOffer out d src uri ix decls allDecls units a (lspFixAfterColons b) first seen)
          {
            (let second (lspFixDeclIn allDecls b (lspFixAfterColons a) (- (vecLen allDecls) 1)))
            (if (let (Some second) second)
              (lspPublicOffer out d src uri ix decls allDecls units b (lspFixAfterColons a) second
                seen)
              0)
          })
      })
  })

; The `k`-th backticked run of a message, or "".
(pub :: lspFixBacktick (-> String Int String))
(pub fn (lspFixBacktick msg k)
  {
    (let n (strLen msg))
    (let mut i 0)
    (let mut count 0)
    (let mut out "")
    (let mut go 1)
    {
      (while (if (== go 1)
        (< i n)
        false)
        (if (let (Some a) (strFindByte msg 96 i))
          (match (strFindByte msg 96 (+ a 1))
            ((None)
              (set go 0)
            )
            ((Some b)
              {
                (if (== count k)
                  {
                    (set out (strSlice msg (+ a 1) (- b (+ a 1))))
                    (set go 0)
                  })
                (set count (+ count 1))
                (set i (+ b 1))
              }
            ))
          (set go 0)))
      out
    }
  })

; The name after the last `::` - `srcSpelling` writes a qualified
; reference that way - or the whole string.
(pub :: lspFixAfterColons (-> String String))
(pub fn (lspFixAfterColons s)
  (match (lspFixLastColons s (- (strLen s) 2))
    ((None) s)
    ((Some i) (strSlice s (+ i 2) (- (strLen s) (+ i 2))))))

(pub :: lspFixLastColons (-> String Int (Option Int)))
(pub fn (lspFixLastColons s i)
  (if (|| (< i 0) (>= (+ i 1) (strLen s)))
    None
    (if (&& (== (strByte s i) 58) (== (strByte s (+ i 1)) 58))
      (Some i)
      (lspFixLastColons s (- i 1)))))

; The declaration of bare `name` that module `mod` carries in the
; merged list, or None. Over the outline's kinds, as `lspFindImported`
; is, and by the module's own stamp rather than the mangled prefix.
(pub :: lspFixDeclIn (-> (Vec ASTNode) String String Int (Option ASTNode)))
(pub fn (lspFixDeclIn allDecls mod name i)
  (if (< i 0)
    None
    {
      (let d (vecGet allDecls i))
      (if (&& (!= (nodeModule d) 0)
            (&& (lspWantsSymbol (nodeTag d))
              (&& (!= (nodeSpan d) 0)
                (&& (strEq (nodeModuleName d) mod) (strEq (bareOf (nodeAName d)) name)))))
        (Some d)
        (lspFixDeclIn allDecls mod name (- i 1)))
    }))

(pub :: lspPublicOffer
  (-> Int diag::Diag String String Ints (Vec ASTNode) (Vec ASTNode) (Vec core::CUnit2) String
    String ASTNode Strings Int))
;@axiom:effect(io)
(pub fn (lspPublicOffer out d src uri ix decls allDecls units mod name decl seen)
  {
    (let key (concat mod (concat "$" name)))
    (if (isSome (strVecIdx seen key))
      0
      {
        (let u (lspUnitOf units (nodeModuleOpt decl)))
        (match u
          ((None) 0)
          ((Some u)
            {
              (let hsrc (unitSrc (vecGet units u)))
              (let hpath (unitFile (vecGet units u)))
              {
                (let o (lspFormStart hsrc (spanStart (nodeSpan decl))))
                (if (strEq (lspViewHeadAt hsrc o) "pub")
                  {
                    (let edit (lspImportEdit src uri ix decls mod name))
                    (if (== edit 0)
                      0
                      {
                        (vecPush seen key)
                        (jsonArrPush out
                          (lspFixActionJson (lspFixImportTitle mod name) "quickfix" d src uri ix
                            edit))
                        0
                      })
                  }
                  {
                    (let hix (lspLineIndex hsrc))
                    (let edits jsonArr)
                    (let sig (lspFindSig allDecls (nodeAName decl) (- (vecLen allDecls) 1)))
                    {
                      (jsonArrPush edits (lspFixTextEdit hsrc hix (+ o 1) "pub "))
                      (if (let (Some sig) sig)
                        {
                          (let so (lspFormStart hsrc (spanStart (nodeSpan sig))))
                          (if (! (strEq (lspViewHeadAt hsrc so) "pub"))
                            (jsonArrPush edits (lspFixTextEdit hsrc hix (+ so 1) "pub ")))
                        }
                        ())
                      (vecPush seen key)
                      (jsonArrPush out
                        (lspFixActionJson
                          (concat (concat (concat "Make `" name) "` public in `") (concat mod "`"))
                          "quickfix" d src uri ix
                          (jsonObjPut jsonObj "changes"
                            (jsonObjPut jsonObj (lspPathToUri hpath) edits))))
                      0
                    }
                  })
              }
            }
          ))
      })
  })

; ------------------------------------------------------------------
; Extract to `let`.
; ------------------------------------------------------------------
(pub :: lspExtractAction (-> String String (Vec ASTNode) Ints Int Int))
(pub fn (lspExtractAction src uri decls ix want)
  {
    (let sel (lspFixTrim src want))
    (if (== sel 0)
      0
      {
        (let ws (spanStart sel))
        (let we (spanEnd sel))
        (if (!= (lspViewItemEnd src ws (strLen src)) we)
          0
          {
            (let o (lspFixFnFormAt src decls ws we))
            (if (let (Some o) o)
              {
                (let kids (lspFixKids src o))
                {
                  (let nk (vecLen kids))
                  (if (< nk 6)
                    0
                    {
                      (let bs (vecGet kids (- nk 2)))
                      (let be (vecGet kids (- nk 1)))
                      (let ks (vecGet kids (- nk 6)))
                      (let ke (vecGet kids (- nk 5)))
                      (if (lspNavNot (strEq (strSlice src ks (- ke ks)) "fn"))
                        0
                        (if (|| (> bs ws) (> we be))
                          0
                          (lspExtractIn src uri decls ix ws we bs be)))
                    })
                }
              }
              0)
          })
      })
  })

; The range without its surrounding whitespace, clamped to the
; document, or 0 when nothing is left.
(pub :: lspFixTrim (-> String Int Int))
(pub fn (lspFixTrim src want)
  {
    (let n (strLen src))
    (let mut s (spanStart want))
    (let mut e (spanEnd want))
    {
      (if (> e n)
        (set e n))
      (if (< s 0)
        (set s 0))
      (while (if (< s e)
        (lspIsSpace (strByte src s))
        false)
        (set s (+ s 1)))
      (while (if (> e s)
        (lspIsSpace (strByte src (- e 1)))
        false)
        (set e (- e 1)))
      (if (>= s e)
        0
        (mkSpan s e))
    }
  })

; The `(` of the top-level form holding [ws, we), when that form is a
; `fn` declaration of this document; None otherwise.
(pub :: lspFixFnFormAt (-> String (Vec ASTNode) Int Int (Option Int)))
(pub fn (lspFixFnFormAt src decls ws we)
  {
    (let o (lspFormStart src ws))
    (let e (lspFormEnd src o))
    (if (|| (> we e) (isNone (lspFixFnDeclIn decls o e 0)))
      None
      (Some o))
  })

(pub :: lspFixFnDeclIn (-> (Vec ASTNode) Int Int Int (Option ASTNode)))
(pub fn (lspFixFnDeclIn decls o e i)
  (if (>= i (vecLen decls))
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_FN)
            (&& (!= (nodeSpan d) 0)
              (&& (>= (spanStart (nodeSpan d)) o) (< (spanStart (nodeSpan d)) e))))
        (Some d)
        (lspFixFnDeclIn decls o e (+ i 1)))
    }))

; The items of the form or brace block opening at `o`, as a flat Vec
; of (start, end) pairs - the head included, comments left out. The
; scanner is VIEW's, which is `lspFormEnd`'s.
(pub :: lspFixKids (-> String Int Ints))
(pub fn (lspFixKids src o)
  {
    (let n (strLen src))
    (let out vecNew)
    (let mut i (+ o 1))
    (let mut go 1)
    {
      (while (if (== go 1)
        (< i n)
        false)
        {
          (let ch (strByte src i))
          (if (lspIsSpace ch)
            (set i (+ i 1))
            (if (== ch 59)
              (set i (findNewline src i n))
              (if (&& (== ch 35) (isBlockOpen src i n))
                (set i (skipBlockComment src (+ i 2) n))
                (if (|| (== ch 41) (== ch 125))
                  (set go 0)
                  {
                    (let e (lspViewItemEnd src i n))
                    {
                      (vecPush out i)
                      (vecPush out e)
                      (set i e)
                    }
                  }))))
        })
      out
    }
  })

(pub :: lspExtractIn (-> String String (Vec ASTNode) Ints Int Int Int Int Int))
(pub fn (lspExtractIn src uri decls ix ws we bs be)
  {
    (let chain vecNew)
    (if (lspNavNot (lspFixDescend src bs be ws we chain))
      0
      {
        (let fi (lspFixStatementAt src chain))
        (let fs
          (match fi
            ((None) bs)
            ((Some i) (vecGet chain (+ (* i 4) 2)))))
        (let fe
          (match fi
            ((None) be)
            ((Some i) (vecGet chain (+ (* i 4) 3)))))
        (let pathStart
          (match fi
            ((None) 0)
            ((Some i) (+ i 1))))
        (if (lspNavNot (lspFixPathIsPlain src chain pathStart))
          0
          {
            (let occs (lspNavOccurrences src decls))
            (if (lspNavNot (lspFixFreeIn occs ws we fs fe))
              0
              (lspExtractJson src uri ix ws we fs fe (lspFixFreshName occs)))
          })
      })
  })

; From the body down to the item, one level at a time: the item of
; the current form that holds [ws, we) becomes the current form.
; Each step records (parent, index, start, end) on `chain`. True when
; the descent lands exactly on the item; false when it meets an atom
; or a string first, or a level where no single item holds the
; range - which is a range across two items.
(pub :: lspFixDescend (-> String Int Int Int Int Ints Bool))
(pub fn (lspFixDescend src bs be ws we chain)
  {
    (let mut cs bs)
    (let mut ce be)
    (let mut go 1)
    (let mut done 0)
    {
      (while (&& (== go 1) (== done 0))
        (if (&& (== cs ws) (== ce we))
          (set done 1)
          (if (|| (== (strByte src cs) 40) (== (strByte src cs) 123))
            {
              (let kids (lspFixKids src cs))
              {
                (let k (lspFixKidHolding kids ws we 0))
                (match k
                  ((None)
                    (set go 0)
                  )
                  ((Some k)
                    {
                      (vecPush chain cs)
                      (vecPush chain k)
                      (vecPush chain (vecGet kids (* k 2)))
                      (vecPush chain (vecGet kids (+ (* k 2) 1)))
                      (set cs (vecGet kids (* k 2)))
                      (set ce (vecGet kids (+ (* k 2) 1)))
                    }
                  ))
              }
            }
            (set go 0))))
      (== done 1)
    }
  })

(pub :: lspFixKidHolding (-> Ints Int Int Int (Option Int)))
(pub fn (lspFixKidHolding kids ws we k)
  (if (|| (< k 0) (>= (+ (* k 2) 1) (vecLen kids)))
    None
    (if (&& (<= (vecGet kids (* k 2)) ws) (>= (vecGet kids (+ (* k 2) 1)) we))
      (Some k)
      (lspFixKidHolding kids ws we (+ k 1)))))

; The chain index of the innermost item whose parent is a brace
; block - the statement - or None when the body itself is it.
(pub :: lspFixStatementAt (-> String Ints (Option Int)))
(pub fn (lspFixStatementAt src chain)
  {
    (let n (/ (vecLen chain) 4))
    (let mut at (:: None (Option Int)))
    (for j in 0..n
      {
        (let start (vecGet chain (* j 4)))
        (if (if (&& (>= start 0) (< start (strLen src)))
          (== (strByte src start) 123)
          false)
          (set at (Some j)))
      })
    at
  })

; Every level from `from` down to the item: a form whose argument at
; the recorded index is evaluated exactly once whenever the form is.
(pub :: lspFixPathIsPlain (-> String Ints Int Bool))
(pub fn (lspFixPathIsPlain src chain from)
  {
    (let n (/ (vecLen chain) 4))
    (let mut j from)
    (let mut ok true)
    {
      (while (if ok
        (< j n)
        false)
        {
          (let p (vecGet chain (* j 4)))
          {
            (if (== (strByte src p) 40)
              (if (!
                    (lspFixArgIsPlain (lspViewHeadAt src p)
                      (lspForArgIndex src p (vecGet chain (+ (* j 4) 1)))))
                (set ok false))
              (set ok false))
            (set j (+ j 1))
          }
        })
      ok
    }
  })

; The index `lspFixArgIsPlain` reasons about. A `for` spells `in`
; after its binder (`forHasIn` in parser.ax): the word itself, at 2, is
; not an expression, and every later element sits one place further on.
; A document still being typed may lack it, and then the index is the
; element's own.
(pub :: lspForArgIndex (-> String Int Int Int))
(pub fn (lspForArgIndex src p k)
  (if (if (strEq (lspViewHeadAt src p) "for")
    (lspForHasIn src p)
    false)
    (if (== k 2)
      0
      (if (> k 2)
        (- k 1)
        k))
    k))

; Does the `for` form at `p` spell `in` after its binder?
(pub :: lspForHasIn (-> String Int Bool))
(pub fn (lspForHasIn src p)
  {
    (let n (strLen src))
    (let b (lspSkipSpace src (lspViewHeadEnd src p) (strLen src)))
    {
      (let w (lspSkipSpace src (lspSkipItem src b n) n))
      (if (if (< w n)
        (isIdentStart (strByte src w))
        false)
        (strEq (strSlice src w (- (lspViewIdentEnd src w n) w)) "in")
        false)
    }
  })

(pub :: lspSkipSpace (-> String Int Int Int))
(pub fn (lspSkipSpace src i n)
  (if (if (< i n)
    (lspIsSpace (strByte src i))
    false)
    (lspSkipSpace src (+ i 1) n)
    i))

; One past the binder at `i`: a parenthesised pair or an identifier.
(pub :: lspSkipItem (-> String Int Int Int))
(pub fn (lspSkipItem src i n)
  (if (>= i n)
    i
    (if (== (strByte src i) 40)
      (lspSkipParen src (+ i 1) n 1)
      (if (isIdentStart (strByte src i))
        (lspViewIdentEnd src i n)
        i))))

; One past the `)` that closes a group opened before `i`.
(pub :: lspSkipParen (-> String Int Int Int Int))
(pub fn (lspSkipParen src i n depth)
  (if (|| (>= i n) (== depth 0))
    i
    (lspSkipParen src (+ i 1) n
      (if (== (strByte src i) 40)
        (+ depth 1)
        (if (== (strByte src i) 41)
          (- depth 1)
          depth)))))

(pub :: lspFixArgIsPlain (-> String Int Bool))
(pub fn (lspFixArgIsPlain head k)
  (if (<= k 0)
    false
    (if (== (strLen head) 0)
      false
      (if (|| (strEq head "as")
            (|| (strEq head "if")
              (|| (strEq head "match") (|| (strEq head "&&") (strEq head "||")))))
        (== k 1)
        ; `for` is here with `let`: `(for x in XS body)` and
        ; `(for i in LO..hi body)` both evaluate their SECOND item exactly
        ; once, before the loop, because the parser hoists it into
        ; `for$v`/`for$lo` (`parseForExpr`). Later items are the range's
        ; end and step in one shape and the BODY in the other, and this
        ; predicate sees the head and the index but not the shape, so it
        ; answers false there rather than guess.
        (if (|| (strEq head "let")
              (|| (strEq head "set") (|| (strEq head "for") (strEq head "region"))))
          (== k 2)
          (if (strEq head "struct")
            (>= k 2)
            ; `parallel`: the region name and the binding list are not
            ; plain expressions; the body from element 3 on is.
            (if (strEq head "parallel")
              (>= k 3)
              ; `cond` is AX2004: the parser refuses one, so a document
              ; this predicate reads never carries the head - no arm.
              (if (|| (strEq head "fn")
                    (|| (strEq head "lambda")
                      (|| (strEq head "while")
                        (|| (strEq head "handle")
                          (|| (strEq head "quote")
                            (|| (strEq head "pub") (strStartsWith head "syntax/")))))))
                false
                true))))))))

; Every local reference inside the item is bound outside the
; statement, or inside the item itself. A key `@N` anchors its binder
; at byte N; a `~` key is a binder no byte anchors, and is refused
; because its place cannot be told.
(pub :: lspFixFreeIn (-> (Vec LspOcc) Int Int Int Int Bool))
(pub fn (lspFixFreeIn occs ws we fs fe)
  {
    (let n (vecLen occs))
    (let mut i 0)
    (let mut ok true)
    {
      (while (if ok
        (< i n)
        false)
        {
          (let o (vecGet occs i))
          {
            (if (&& (!= o.span 0) (&& (>= (spanStart o.span) ws) (<= (spanEnd o.span) we)))
              (if (|| (== o.role NAV_READ) (== o.role NAV_WRITE))
                {
                  (let key o.key)
                  (if (! (== (strLen key) 0))
                    (if (== (strByte key 0) 126)
                      (set ok false)
                      (if (== (strByte key 0) 64)
                        {
                          (let at (strToInt (strSlice key 1 (- (strLen key) 1))))
                          (if (&& (>= at fs) (&& (< at fe) (|| (< at ws) (>= at we))))
                            (set ok false))
                        })))
                }))
            (set i (+ i 1))
          }
        })
      ok
    }
  })

(pub :: lspFixFreshName (-> (Vec LspOcc) String))
(pub fn (lspFixFreshName occs)
  {
    (let mut name "extracted")
    (let mut k 2)
    {
      (while (lspNavNamed occs name)
        {
          (set name (concat "extracted" (fmtInt k)))
          (set k (+ k 1))
        })
      name
    }
  })

(pub :: lspExtractJson (-> String String Ints Int Int Int Int String Int))
(pub fn (lspExtractJson src uri ix ws we fs fe name)
  {
    (let parts vecNew)
    {
      (vecPush parts "{ (let ")
      (vecPush parts name)
      (vecPush parts " ")
      (vecPush parts (strSlice src ws (- we ws)))
      (vecPush parts ") ")
      (vecPush parts (strSlice src fs (- ws fs)))
      (vecPush parts name)
      (vecPush parts (strSlice src we (- fe we)))
      (vecPush parts " }")
      (jsonObjPut
        (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr "Extract to `let`")) "kind"
          (jsonStr "refactor.extract"))
        "edit" (lspEditJson uri (lspRangeIx src ix (mkSpan fs fe)) (catStrs parts)))
    }
  })

; ------------------------------------------------------------------
; `textDocument/typeDefinition`: the declaration of the TYPE of the
; name under the cursor.
;
; WHAT HAS A TYPE TO ASK ABOUT, from the raw tree, which records none
; per expression:
;
;   * a `fn` PARAMETER, when the cursor is inside the fn's header -
;     `(fn (area s) ...)` on `s` - is the k-th arrow position of the
;     fn's signature, `nthParamTy`. The header is recovered from
;     bytes: the parameter names carry no spans.
;   * a `fn` with a `::` signature - this document first, then the
;     imported modules, `definition`'s order - is the arrow's RESULT.
;   * a CONSTRUCTOR is its `data`, directly.
;
; A `let` binding has no answer: nothing in the frontend records what
; a local was inferred to be (typecheck.ax's scope entries die with the
; walk), and guessing is not this server's habit. Then the type: only
; a named constructor - `TAG_T_CON` - names a declaration, and only a
; `data`, `struct` or `type` alias of that name with a span is one.
; `Int`, a type variable, a tuple, a list, the prelude's spanless
; `Option`: null, which the protocol reads as "nothing here".
; ------------------------------------------------------------------
(pub :: lspTypeDefinition (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspTypeDefinition workspace src uri params)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError18) jsonNull)
      ((ParseSuccess parsedValue18 parsedPos18)
        {
          (let decls parsedValue18)
          (let ix (lspLineIndex src))
          {
            (let off (lspOffsetOf src ix (jsonGet params "position")))
            {
              (let wsp (lspWordSpan src off))
              (if (== wsp 0)
                jsonNull
                {
                  (let w (strSlice src (spanStart wsp) (- (spanEnd wsp) (spanStart wsp))))
                  {
                    (let t (lspLocalTypeOf src decls off w))
                    (match t
                      ((Some ty)
                        (lspTypeLocation workspace (lspUriToPath uri) src uri decls "" (Some ty))
                      )
                      ((None)
                        {
                          (let dat (lspFindCtorData decls w (- (vecLen decls) 1)))
                          (if (let (Some dat) dat)
                            (lspLocationJson uri src (nodeSpan dat))
                            (lspTypeLocation workspace (lspUriToPath uri) src uri decls w None))
                        }
                      ))
                  }
                })
            }
          }
        }
      ))
  })

; The type node this document alone can answer for the word at `off`:
; a parameter in the header the cursor is in, else a signed `fn`'s
; result. None when neither.
(pub :: lspLocalTypeOf (-> String (Vec ASTNode) Int String (Option ASTNode)))
(pub fn (lspLocalTypeOf src decls off w)
  (match (lspParamTypeAt src decls off w)
    ((Some parameter) (Some parameter))
    ((None)
      (match (lspFindDecl decls w (- (vecLen decls) 1))
        ((None) None)
        ((Some d)
          (if (== (nodeTag d) TAG_D_FN)
            (match (lspFindSig decls w (- (vecLen decls) 1))
              ((None) None)
              ((Some sig) (lspArrowResult (nodeTyChild sig))))
            None)
        ))
    )))

; The fn whose HEADER holds `off`, and the type of the parameter `w`
; names in it. The header is the form opened by the `(` before the
; fn's name - `(fn (area s) ...)` puts the name's span on `area`, and
; the parameter list is that paren's form - so a cursor inside it is
; on a parameter and nowhere else. Its index is the parameter's
; position in the fn's own list, which is what `nthParamTy` counts.
(pub :: lspParamTypeAt (-> String (Vec ASTNode) Int String (Option ASTNode)))
(pub fn (lspParamTypeAt src decls off w)
  {
    (let n (vecLen decls))
    (let mut i 0)
    (let mut found (:: None (Option ASTNode)))
    {
      (while (&& (< i n) (isNone found))
        {
          (let d (vecGet decls i))
          {
            (if (&& (== (nodeTag d) TAG_D_FN)
                  (&& (!= (nodeSpan d) 0) (<= (spanStart (nodeSpan d)) off)))
              {
                (let hs (lspHeaderOpen src (spanStart (nodeSpan d))))
                (if (let (Some hs) hs)
                  (if (< off (lspFormEnd src hs))
                    (match (strVecIdx (nodeBNames d) w)
                      ((Some k)
                        {
                          (let sig (lspFindSig decls (nodeAName d) (- (vecLen decls) 1)))
                          (if (let (Some sig) sig)
                            (set found (nthParamTy (nodeTyChild sig) k))
                            ())
                        }
                      )
                      ((None) ()))))
              })
            (set i (+ i 1))
          }
        })
      found
    }
  })

; The `(` that opens the header whose first identifier starts at
; `nameStart`, skipping the blanks a hand-written header may carry
; between them; None when that byte is not a paren, which is the bare
; nullary form `(fn answer 42)` - it has no parameter list to be in.
(pub :: lspHeaderOpen (-> String Int (Option Int)))
(pub fn (lspHeaderOpen src nameStart)
  (if (|| (<= nameStart 0) (> nameStart (strLen src)))
    None
    {
      (let mut o (- nameStart 1))
      (while (if (> o 0)
        (docIsBlank (strByte src o))
        false)
        (set o (- o 1)))
      (if (== (strByte src o) 40)
        (Some o)
        None)
    }))

; The RESULT of an arrow chain: `(-> A B C)` answers `C`, and a type
; that is not an arrow answers itself - `(:: main Int)`'s `Int`.
(pub :: lspArrowResult (-> ASTNode (Option ASTNode)))
(pub fn (lspArrowResult t)
  (lspViewResultTy t))

; The `data` declaring constructor `name` in this document, or None.
(pub :: lspFindCtorData (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindCtorData decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_DATA)
            (&& (!= (nodeSpan d) 0) (isSome (lspCtorIndex (nodeBChildren d) name 0))))
        (Some d)
        (lspFindCtorData decls name (- i 1)))
    }))

(pub :: lspCtorIndex (-> (Vec ASTNode) String Int (Option Int)))
(pub fn (lspCtorIndex ctors name i)
  (if (>= i (vecLen ctors))
    None
    (if (strEq (nodeAName (vecGet ctors i)) name)
      (Some i)
      (lspCtorIndex ctors name (+ i 1)))))

; ------------------------------------------------------------------
; A CONSTRUCTOR IS A DECLARATION, to every request. `completion` offers
; `Circle`, `references` finds every occurrence of it, `signatureHelp`
; renders `(Circle Int)` for one an import brought in,
; `workspace/symbol` lists it at its own span and `typeDefinition`
; jumps to the `data` it belongs to - so `definition`, `declaration`
; and `hover` answer on the same character rather than null.
;
; THE ANSWER IS THE CONSTRUCTOR'S OWN SPAN, not the `data`'s name.
; `(pub data Shape (Dot) (Circle Int))` puts both on one line, so an
; answer that landed on `Shape` would look right in an editor and be
; wrong. The ctor node carries its name's span from the parser, which
; is where `workspace/symbol` already publishes it.
;
; `typeDefinition` keeps answering the `data`, and that is not an
; inconsistency: the TYPE of `Circle` is `Shape`. The gate asks both
; requests at one position and requires the two answers to DIFFER.
;
; DECLARATION EQUALS DEFINITION HERE, which is step 3's rule already:
; a constructor is not written twice, so there is no `(:: ...)` for
; step 2 to have preferred.
;
; The lookups below are `lspFindCtorData`'s, split on which half of
; the merged declaration list they read - this document's own
; declarations (module 0) or the ones an import brought in. The ctor
; node inside is found by `lspViewCtorIn`, which SECTION VIEW wrote
; for `signatureHelp`: a constructor is NOT mangled by
; `resolveImports` even when its `data` is, so one comparison serves
; both halves.
;
; THE TWO HALVES ANSWER DIFFERENT KINDS OF NOTHING, because they sit
; at different places in a chain. The local one is a STEP - 0 means
; "not a constructor, carry on to the imports" - and the imported one
; is the LAST step, so it answers `jsonNull`, which is the protocol's
; "nothing here". Neither may answer a Location built on a span of 0:
; `lspRange` reads that as line one, and an editor would jump there.
; ------------------------------------------------------------------
; The imported `data` declaring constructor `name`, or None. The module
; filter is on the DATA, which is the node `resolveImports`
; attributes; the constructors inside it carry no module of their own.
(pub :: lspFindCtorDataImported (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindCtorDataImported decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (== (nodeTag d) TAG_D_DATA)
            (&& (!= (nodeModule d) 0)
              (&& (!= (nodeSpan d) 0) (isSome (lspCtorIndex (nodeBChildren d) name 0)))))
        (Some d)
        (lspFindCtorDataImported decls name (- i 1)))
    }))

; The constructor node `name` names inside `dat`, or None. A node
; whose name carries no span is also absent, which is what the parser
; recovers from a half-written form.
(pub :: lspCtorNodeOf (-> (Option ASTNode) String (Option ASTNode)))
(pub fn (lspCtorNodeOf dat name)
  (match dat
    ((None) None)
    ((Some dat)
      {
        (let c (lspViewCtorIn (nodeBChildren dat) name))
        (if (let (Some c) c)
          (if (== (nodeSpan c) 0)
            None
            (Some c))
          None)
      }
    )))

; A Location on the constructor `name` this document declares, or 0
; for "the word is not one of ours".
(pub :: lspCtorDefinition (-> String String (Vec ASTNode) String Int))
(pub fn (lspCtorDefinition src uri decls name)
  {
    (let c (lspCtorNodeOf (lspFindCtorData decls name (- (vecLen decls) 1)) name))
    (if (let (Some c) c)
      (lspNavLocOf uri src (nodeSpan c))
      0)
  })

; The same for an imported one, and the difference is which bytes the
; span indexes: the DECLARING file's, not the open document's. The
; unit table decides both the uri and the text `lspRange` counts lines
; in - `lspViewSymCtors` publishes constructors through exactly this
; pair. `jsonNull` on a miss, and on a `data` the resolver did not
; attribute to a unit, because this is the end of the chain.
(pub :: lspCtorDefinitionImported (-> (Vec ASTNode) Units String Int))
;@axiom:effect(io)
(pub fn (lspCtorDefinitionImported allDecls units name)
  {
    (let dat (lspFindCtorDataImported allDecls name (- (vecLen allDecls) 1)))
    (if (let (Some dat) dat)
      {
        (let c (lspCtorNodeOf (Some dat) name))
        (if (let (Some c) c)
          {
            (let u (lspUnitOf units (nodeModuleOpt dat)))
            (match u
              ((None) jsonNull)
              ((Some u)
                {
                  (let unit (vecGet units u))
                  (lspNavLocOf (lspPathToUri (unitFile unit)) (unitSrc unit) (nodeSpan c))
                }
              ))
          }
          jsonNull)
      }
      jsonNull)
  })

; The line hover puts under the fence. The `data`'s name is BARE, for
; the reason `lspViewSigCtor` reads a bare one: an imported `data` is
; `Shapes$Shape` in the merged list and nobody writes it that way.
(pub :: lspCtorNote (-> ASTNode String String))
(pub fn (lspCtorNote dat name)
  (concat (concat (concat "constructor `" name) "` of `") (concat (bareOf (nodeAName dat)) "`")))

; Hover on a constructor an import brought in: the `data` quoted out
; of the DECLARING file, the module named, and the note saying which
; constructor. `range` is still the word in the document being edited,
; which is a different file - the same split `lspHoverImported` makes.
(pub :: lspHoverCtorImported (-> (Vec ASTNode) Units String Int Int))
(pub fn (lspHoverCtorImported allDecls units name range)
  {
    (let dat (lspFindCtorDataImported allDecls name (- (vecLen allDecls) 1)))
    (if (let (Some dat) dat)
      (if (isNone (lspCtorNodeOf (Some dat) name))
        jsonNull
        {
          (let u (lspUnitOf units (nodeModuleOpt dat)))
          (match u
            ((None) jsonNull)
            ((Some u)
              {
                (let unit (vecGet units u))
                (lspHoverAtNote (unitSrc unit) allDecls dat range (unitName unit)
                  (lspCtorNote dat name))
              }
            ))
        })
      jsonNull)
  })

; `typeDefinition` on an imported constructor: the `data`'s own name
; span, in the file that declares it. This is the ONE request whose
; answer is the declaration rather than the constructor, because the
; type of `Circle` is `Shape`.
(pub :: lspTypeCtorImported (-> (Vec ASTNode) Units String Int))
;@axiom:effect(io)
(pub fn (lspTypeCtorImported allDecls units name)
  {
    (let dat (lspFindCtorDataImported allDecls name (- (vecLen allDecls) 1)))
    (if (let (Some dat) dat)
      (if (isNone (lspCtorNodeOf (Some dat) name))
        jsonNull
        {
          (let u (lspUnitOf units (nodeModuleOpt dat)))
          (match u
            ((None) jsonNull)
            ((Some u)
              {
                (let unit (vecGet units u))
                (lspLocationJson (lspPathToUri (unitFile unit)) (unitSrc unit) (nodeSpan dat))
              }
            ))
        })
      jsonNull)
  })

; A declaration a TYPE name can land on: `data`, `struct` or `type`.
(pub :: lspIsTypeDecl (-> Int Bool))
(pub fn (lspIsTypeDecl tag)
  (|| (== tag TAG_D_DATA) (|| (== tag TAG_D_STRUCT) (== tag TAG_D_ALIAS))))

(pub :: lspFindTypeDecl (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindTypeDecl decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (lspIsTypeDecl (nodeTag d)) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0)))
        (Some d)
        (lspFindTypeDecl decls name (- i 1)))
    }))

; The same over the merged list, restricted to what an import brought
; in. Type names are NOT mangled by `resolveImports` - a `data` keeps
; its bare name in every module - so the comparison is exact rather
; than through `bareOf`.
(pub :: lspFindTypeImported (-> (Vec ASTNode) String Int (Option ASTNode)))
(pub fn (lspFindTypeImported decls name i)
  (if (< i 0)
    None
    {
      (let d (vecGet decls i))
      (if (&& (lspIsTypeDecl (nodeTag d))
            (&& (!= (nodeModule d) 0) (&& (strEq (nodeAName d) name) (!= (nodeSpan d) 0))))
        (Some d)
        (lspFindTypeImported decls name (- i 1)))
    }))

(pub :: lspLocationJson (-> String String Int Int))
(pub fn (lspLocationJson uri src span)
  (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "range" (lspRange src span)))

; The Location of type `t`'s declaration - or, when `t` is None, of the
; result type of the imported fn `w` names. This document's own
; declarations are asked first, which is the language's shadowing rule
; and `lspDefinition`'s order; the imports are resolved only when they
; have to be, and once, whichever of the two questions is being asked.
(pub :: lspTypeLocation
  (-> LspWorkspace String String String (Vec ASTNode) String (Option ASTNode) Int))
;@axiom:effect(io)
(pub fn (lspTypeLocation workspace path src uri decls w t)
  {
    (let local
      (match t
        ((None) 0)
        ((Some ty) (lspTypeLocalOf src uri decls ty))))
    (if (!= local 0)
      local
      (lspTypeLocationImported workspace path src uri decls w t))
  })

; A `TAG_T_CON` naming a declaration in this document, or 0.
(pub :: lspTypeLocalOf (-> String String (Vec ASTNode) ASTNode Int))
(pub fn (lspTypeLocalOf src uri decls t)
  (if (!= (nodeTag t) TAG_T_CON)
    0
    {
      (let d (lspFindTypeDecl decls (nodeAName t) (- (vecLen decls) 1)))
      (if (let (Some d) d)
        (lspLocationJson uri src (nodeSpan d))
        0)
    }))

; The import preamble of `lspDefinitionImported`, verbatim, and then
; the two lookups it can answer: the result type of an imported signed
; `fn` when `t` is None, and the module declaring a type name.
(pub :: lspTypeLocationImported
  (-> LspWorkspace String String String (Vec ASTNode) String (Option ASTNode) Int))
;@axiom:effect(io)
(pub fn (lspTypeLocationImported workspace path src uri decls w given)
  (if (let (Some r) (lspResolveFor workspace path src decls))
    {
      (let allDecls r.decls)
      (let units r.units)
      {
        (let t
          (match given
            ((Some ty) (Some ty))
            ((None)
              (match (lspFindImported allDecls w (- (vecLen allDecls) 1))
                ((None) None)
                ((Some d)
                  (if (== (nodeTag d) TAG_D_FN)
                    (match (lspFindSig allDecls (nodeAName d) (- (vecLen allDecls) 1))
                      ((None) None)
                      ((Some sig) (lspArrowResult (nodeTyChild sig))))
                    None)
                ))
            )))
        (match t
          ; An absent signed result may still name an imported
          ; constructor whose declaring data supplies its type.
          ((None) (lspTypeCtorImported allDecls units w))
          ((Some ty)
            (if (!= (nodeTag ty) TAG_T_CON)
              jsonNull
              {
                (let local (lspTypeLocalOf src uri decls ty))
                (if (!= local 0)
                  local
                  {
                    (let d (lspFindTypeImported allDecls (nodeAName ty) (- (vecLen allDecls) 1)))
                    (if (let (Some d) d)
                      {
                        (let u (lspUnitOf units (nodeModuleOpt d)))
                        (match u
                          ((None) jsonNull)
                          ((Some u)
                            {
                              (let unit (vecGet units u))
                              (lspLocationJson (lspPathToUri (unitFile unit)) (unitSrc unit)
                                (nodeSpan d))
                            }
                          ))
                      }
                      jsonNull)
                  })
              })
          ))
      }
    }
    jsonNull))

; ------------------------------------------------------------------
; `textDocument/codeLens`: a `▶ Run` over `main`, and `Expand macro`
; over every `pub macro`.
;
; THE COMMANDS ARE THE CLIENT'S. A lens carries a command NAME and its
; arguments, and the server never runs one: a VS Code extension binds
; `axiom.run` to `axiom run <path>` in a terminal and
; `axiom.expandMacro` to an `axiom/expandMacro` request at the
; position given, which is exactly how rust-analyzer's `Run` lens
; works - the server says where, the editor does it. `Run` is offered
; for `(fn (main) ...)` alone, because that is what `axiom run` runs.
; The macro lens names the DECLARATION's position, and
; `lspExpandMacro` reads that position as "everything this macro
; generated in this document"; on an invocation it answers that
; invocation's own products. Raw tree, no expansion, no IO: the path
; is decoded from the URI the request named.
; ------------------------------------------------------------------
(pub :: lspCodeLens (-> String String Int))
(pub fn (lspCodeLens src uri)
  {
    (let pr (lspParse src))
    (match pr
      ((ParseFailed parseError19) jsonArr)
      ((ParseSuccess parsedValue19 parsedPos19)
        {
          (let decls parsedValue19)
          (let out jsonArr)
          (let ix (lspLineIndex src))
          (let n (vecLen parsedValue19))
          {
            (for i in 0..n
              {
                (let d (vecGet decls i))
                (if (! (== (nodeSpan d) 0))
                  (if (&& (== (nodeTag d) TAG_D_FN)
                        (&& (strEq (nodeAName d) "main") (== (vecLen (nodeBNames d)) 0)))
                    (jsonArrPush out
                      (lspLensJson (lspRangeIx src ix (nodeSpan d)) "▶ Run" "axiom.run"
                        (jsonArrPush jsonArr (jsonStr (lspUriToPath uri)))))
                    (if (&& (== (nodeTag d) TAG_D_MACRO) (== (nodeVis d) 1))
                      (jsonArrPush out
                        (lspLensJson (lspRangeIx src ix (nodeSpan d)) "Expand macro"
                          "axiom.expandMacro"
                          (jsonArrPush (jsonArrPush jsonArr (jsonStr uri))
                            (lspPosIx src ix (spanStart (nodeSpan d)))))))))
              })
            out
          }
        }
      ))
  })

(pub :: lspLensJson (-> Int String String Int Int))
(pub fn (lspLensJson range title command args)
  (jsonObjPut (jsonObjPut jsonObj "range" range) "command"
    (jsonObjPut
      (jsonObjPut (jsonObjPut jsonObj "title" (jsonStr title)) "command" (jsonStr command))
      "arguments" args)))

; ------------------------------------------------------------------
; ------------------------------------------------------------------
; The generated-name cache: what each top-level invocation made, by
; name, filled where expansion already runs.
;
; MAC-TOOL-3 says per-keystroke requests expand nothing, and the
; demand pins in `scripts/check-macro-demand.sh` count the requests
; that goes answered for: a name only the expansion knows -
; `tagShape` from `(deriveTag Shape)` - answers the invocation head
; under `definition` and `declaration`, the cached rendering under
; `hover`, and the invocation then the use under `references`. The
; cache answers them without moving expansion: `didOpen` and
; `didChange` already run the pipeline, including expansion, for
; diagnostics, so the fill runs there, once per top-level
; invocation, and the arms read the resulting string.
;
; WHAT IS STORED, per generated name: the macro, the invocation head
; name's byte offsets, and the hover text - the `::` product's
; rendering when one names it, else the `fn` product's first line,
; else the product's whole rendering. `definition` and `declaration`
; answer the invocation head ("generated here"); `hover` fences the
; text and names the invocation form; `references` with
; `includeDeclaration` prepends the invocation in document order.
; First invocation wins per name: two calls generating one name is a
; checker error, and the cache keeps the first rather than mixing a
; span from one call with text from another.
;
; WHAT IT COSTS: one isolated expansion per top-level call, each
; under the MAC-EXP budgets, reusing `lspExpandAt`'s own attribution
; (expand with every other call removed, take everything phase D
; made) - including its resolve, which is handle-bound to the fresh
; list and cannot be hoisted: resolving the original list and
; expanding a fresh one faults. A document with no top-level calls
; fills `"[]"` without resolving. An invocation whose expansion
; fails is skipped: its names miss the cache and answer as they did
; before.
; ------------------------------------------------------------------
(pub :: lspGenFill (-> LspWorkspace String String String))
;@axiom:effect(io)
(pub fn (lspGenFill workspace path src)
  {
    (let pr (parseModuleWith (lex src) (scanAxtags src)))
    (match pr
      ((ParseFailed parseError20) "[]")
      ((ParseSuccess parsedValue20 parsedPos20)
        {
          (let calls (lspGenCallSites parsedValue20))
          (if (== (vecLen calls) 0)
            "[]"
            (jsonWrite (lspGenEntries workspace path src parsedValue20 calls)))
        }
      ))
  })

; Indices of the top-level declarations that are macro invocations
; with a span to answer at.
(pub :: lspGenCallSites (-> (Vec ASTNode) Ints))
(pub fn (lspGenCallSites decls)
  {
    (let out vecNew)
    (let n (vecLen decls))
    {
      (for i in 0..n
        {
          (let d (vecGet decls i))
          (if (&& (== (nodeTag d) TAG_D_MACROCALL) (!= (nodeSpan d) 0))
            (vecPush out i))
        })
      out
    }
  })

; The invocation head name's start: past the `(` and any whitespace
; to the first byte of the macro name.
(pub :: lspGenHeadStart (-> String Int Int))
(pub fn (lspGenHeadStart src form)
  {
    (let n (strLen src))
    (let mut p (+ form 1))
    {
      (while (&& (< p n) (lspGenIsWs (strByte src p)))
        (set p (+ p 1)))
      p
    }
  })

(pub :: lspGenIsWs (-> Int Bool))
(pub fn (lspGenIsWs b)
  (|| (== b 32) (|| (== b 9) (|| (== b 10) (== b 13)))))

; One JSON object per generated name, first invocation winning: the
; temporary list merges one call's own products (`::` preferred),
; then merges into the answer by name.
(pub :: lspGenEntries (-> LspWorkspace String String (Vec ASTNode) Ints Int))
;@axiom:effect(io)
(pub fn (lspGenEntries workspace path src decls calls)
  {
    (let out vecNew)
    (let nc (vecLen calls))
    {
      (for c in 0..nc
        (lspGenOneCall workspace path src decls (vecGet calls c) out))
      (lspGenToJson out)
    }
  })

; One call's products, attributed the way `lspExpandAt` attributes
; them: the isolated list is resolved AND expanded together, because
; the resolution is handle-bound to the list it ran on.
(pub :: lspGenOneCall (-> LspWorkspace String String (Vec ASTNode) Int (Vec LspGenEntry) Int))
;@axiom:effect(io)
(pub fn (lspGenOneCall workspace path src decls idx out)
  {
    (let pr2 (parseModuleWith (lex src) (scanAxtags src)))
    (match pr2
      ((ParseFailed parseError21) 0)
      ((ParseSuccess parsedValue21 parsedPos21)
        {
          (let decls2 (lspKeepOneCall parsedValue21 idx))
          {
            (let before (lspDeclHandles decls2))
            (let wasCall (lspDeclIsCall decls2))
            (if (let (Some ex) (lspFixExpand workspace path src decls2))
              (if (> (countErrorDiags ex.diags) 0)
                0
                (lspGenCollect src decls idx decls2 before wasCall ex.gens out))
              0)
          }
        }
      ))
  })

; Every product of this one call into the answer: the invocation's
; own span and macro name travel with each, from the ORIGINAL list,
; whose handles the expansion never touched.
(pub :: lspGenCollect
  (-> String (Vec ASTNode) Int (Vec ASTNode) (Vec ASTNode) Ints GeneratedOrigins (Vec LspGenEntry)
    Int))
(pub fn (lspGenCollect src decls idx decls2 before wasCall gens out)
  {
    (let site (vecGet decls idx))
    {
      (let macName (nodeAName site))
      {
        (let hs (lspGenHeadStart src (lspFormStart src (spanStart (nodeSpan site)))))
        {
          (let tmp vecNew)
          (let tsig vecNew)
          (let n (vecLen decls2))
          {
            (for i in 0..n
              {
                (let g (vecGet decls2 i))
                (if (lspIsProductOf g i before wasCall gens macName true)
                  (lspGenTempMerge tmp tsig g))
              })
            (lspGenTempFlush tmp tsig out macName hs (+ hs (strLen macName)))
            0
          }
        }
      }
    }
  })

; One call's products keyed by name: the `::` rendering wins over the
; `fn`'s first line, and a product with no name to look up by is left
; out. `tmp` holds (name, code) pairs, `tsig` whether the code is a
; `::` rendering.
(pub :: lspGenTempMerge (-> (Vec LspGenTemp) Ints ASTNode Int))
(pub fn (lspGenTempMerge tmp tsig g)
  {
    (let nm (nodeAName g))
    (if (== (strLen nm) 0)
      0
      {
        (let isSig
          (if (== (nodeTag g) TAG_D_SIG)
            1
            0))
        {
          (let code
            (if (== isSig 1)
              (lspRenderDecl g 0)
              (if (== (nodeTag g) TAG_D_FN)
                (lspFirstLine (lspRenderDecl g 0))
                (lspRenderDecl g 0))))
          (lspGenTempUpsert tmp tsig nm code isSig)
        }
      })
  })

; One generated name and its rendered text, while one call's products
; are merged.
(pub struct LspGenTemp
  (name : String)
  (mut code : String))

; One generated name in the answer: its text, the macro that made it,
; and the invocation's head span.
(pub struct LspGenEntry
  (name : String)
  (code : String)
  (macro : String)
  (hs : Int)
  (he : Int))

(pub :: lspGenTempUpsert (-> (Vec LspGenTemp) Ints String String Int Int))
(pub fn (lspGenTempUpsert tmp tsig nm code isSig)
  {
    (let n (vecLen tmp))
    (let mut i 0)
    (let mut found (- 0 1))
    {
      (while (< i n)
        {
          (let t (vecGet tmp i))
          (if (strEq t.name nm)
            {
              (set found i)
              (set i n)
            })
          (set i (+ i 1))
        })
      (if (< found 0)
        {
          (vecPush tmp (LspGenTemp :name nm :code code))
          (vecPush tsig isSig)
          1
        }
        (if (&& (== (vecGet tsig found) 0) (== isSig 1))
          {
            (let t (vecGet tmp found))
            (set t.code code)
            (vecSet tsig found 1)
            1
          }
          0))
    }
  })

; The temporary list into the answer, first invocation winning whole
; entries: a name already there keeps its span, macro and text.
(pub :: lspGenTempFlush (-> (Vec LspGenTemp) Ints (Vec LspGenEntry) String Int Int Int))
(pub fn (lspGenTempFlush tmp tsig out macName hs he)
  {
    (for t in tmp
      (lspGenOutPush out t.name t.code macName hs he))
    0
  })

(pub :: lspGenOutPush (-> (Vec LspGenEntry) String String String Int Int Int))
(pub fn (lspGenOutPush out nm code macName hs he)
  {
    (let n (vecLen out))
    (let mut i 0)
    (let mut found false)
    {
      (while (< i n)
        {
          (let e (vecGet out i))
          (if (strEq e.name nm)
            {
              (set found true)
              (set i n)
            })
          (set i (+ i 1))
        })
      (if found
        0
        {
          (vecPush out (LspGenEntry :name nm :code code :macro macName :hs hs :he he))
          1
        })
    }
  })

; Entries to the cached JSON: one object per name.
(pub :: lspGenToJson (-> (Vec LspGenEntry) Int))
(pub fn (lspGenToJson out)
  {
    (let arr jsonArr)
    (let n (vecLen out))
    {
      (for i in 0..n
        {
          (let e (vecGet out i))
          (jsonArrPush arr
            (jsonObjPut
              (jsonObjPut
                (jsonObjPut
                  (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr e.name)) "code" (jsonStr e.code))
                  "macro" (jsonStr e.macro))
                "invStart" (jsonNum e.hs))
              "invEnd" (jsonNum e.he)))
        })
      arr
    }
  })

; The read side. Every arm below takes the cache STRING the dispatch
; resolved - never the store, never the expander. `definition` and
; `declaration` answer the invocation head ("generated here");
; `hover` fences the stored text and names the invocation form;
; `references` prepends the invocation in document order. All four
; fire only where the raw-tree lookups miss, so every answer given
; before stands.
(pub :: lspGenLookup (-> String String Int))
(pub fn (lspGenLookup gen name)
  (if (strEq gen "[]")
    0
    {
      (let arr (jsonParse gen))
      (if (== arr 0)
        0
        {
          (let n (jsonArrLen arr))
          (let mut i 0)
          (let mut found 0)
          {
            (while (< i n)
              {
                (let e (jsonArrGet arr i))
                {
                  (if (strEq (jsonGetStr e "name") name)
                    {
                      (set found e)
                      (set i n)
                    })
                  (set i (+ i 1))
                }
              })
            found
          }
        })
    }))

(pub :: lspGenDefinition (-> String String String String Int))
(pub fn (lspGenDefinition gen uri src w)
  {
    (let e (lspGenLookup gen w))
    (if (== e 0)
      jsonNull
      (lspNavLocOf uri src (mkSpan (jsonGetInt e "invStart") (jsonGetInt e "invEnd"))))
  })

(pub :: lspGenHover (-> String String String Int Int))
(pub fn (lspGenHover gen src w range)
  {
    (let e (lspGenLookup gen w))
    (if (== e 0)
      jsonNull
      {
        (let form (lspFormText src (lspFormStart src (jsonGetInt e "invStart"))))
        {
          (let value
            (concat
              (concat (concat "```axiom\n" (lspClampLines (jsonGetStr e "code") 40)) "\n```\n")
              (concat (concat "\ngenerated by `" form) "`\n")))
          (jsonObjPut
            (jsonObjPut jsonObj "contents"
              (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "markdown")) "value" (jsonStr value)))
            "range" range)
        }
      })
  })

; `axiom/expandMacro`: what a macro generated, as source.
;
; WHERE IT ANSWERS. On a TOP-LEVEL invocation - a `TAG_D_MACROCALL`,
; by its head's span or anywhere inside the form's bytes - it renders
; that invocation's own products; on a macro DECLARATION, by its name
; or its form, everything that macro generated in this document. An
; expression-position invocation inside a body is not answered: phase
; E rewrites the expression in place and records no product list, so
; there is nothing to attribute, and a position elsewhere is null.
;
; HOW A PRODUCT IS KNOWN. `expandProgram` rewrites the declaration
; list in place - the first product is copied INTO the invocation node
; (`expCopyDeclInto`, the same handle with a new tag), the rest are
; appended - and answers `gens`, the (name, macro) pairs of every
; declaration phase D made. So the expansion runs on a FRESH parse,
; leaving the first parse as the record of what was WRITTEN, and a
; declaration is a product by IDENTITY: a handle the list did not
; hold before expansion, or the invocation's own handle now carrying
; another tag. The first version asked by NAME - "not a name the
; written list has" - and a generated `impl` is named after its
; TRAIT, which the written list declares, so `(deriveEq Inner)`
; answered an empty expansion (measured on tests/selfhost/378).
;
; WHICH INVOCATION made it is NOT a question a span can answer. A
; product whose name was joined - `tagShape` from `(syntax/join tag
; T)` - has no token to point at and carries span 0, which is why
; `axiom symbols` prints `-` for its position; and `gens` is one flat
; list in generation order with no count per invocation. Measured:
; attributing by the invocation's own span, then by its form's byte
; extent, both answered an empty expansion for `(deriveTag Shape)`
; while the declaration answered its two products. So the fresh parse
; is expanded with every OTHER top-level invocation removed from the
; entry list first, and then everything phase D made is this
; invocation's - nested invocations it generated included, which is
; what "expand" means. What that leaves out is a macro whose template
; QUERIES declarations another invocation would have generated
; (`syntax/for` over the declaration list); that expansion is shown
; without them.
;
; An expansion the expander refused is null: the tree it gave up on
; is not one to show, and the refusal is already on screen as a
; diagnostic.
; ------------------------------------------------------------------
(pub :: lspExpandMacro (-> LspWorkspace String String Int Int))
;@axiom:effect(io)
(pub fn (lspExpandMacro workspace src uri params)
  {
    (let pr (parseModuleWith (lex src) (scanAxtags src)))
    (match pr
      ((ParseFailed parseError22) jsonNull)
      ((ParseSuccess parsedValue22 parsedPos22)
        {
          (let decls parsedValue22)
          (let ix (lspLineIndex src))
          {
            (let site (lspMacroSiteAt src decls (lspOffsetOf src ix (jsonGet params "position"))))
            (match site
              ((None) jsonNull)
              ((Some site) (lspExpandAt workspace (lspUriToPath uri) src decls site)))
          }
        }
      ))
  })

; The INDEX of the invocation or macro declaration whose name or form
; holds `off`, or None. The name is asked first because it is one
; comparison; the form is scanned only for a name the cursor is not
; on. An index rather than the node, because the same position in the
; fresh parse is how the invocation is found again.
(pub :: lspMacroSiteAt (-> String (Vec ASTNode) Int (Option Int)))
(pub fn (lspMacroSiteAt src decls off)
  {
    (let n (vecLen decls))
    (let mut i 0)
    (let mut found (:: None (Option Int)))
    {
      (while (&& (< i n) (isNone found))
        {
          (let d (vecGet decls i))
          {
            (if (&& (|| (== (nodeTag d) TAG_D_MACROCALL) (== (nodeTag d) TAG_D_MACRO))
                  (!= (nodeSpan d) 0))
              (if (lspSpanHas (nodeSpan d) off)
                (set found (Some i))
                {
                  (let o (lspFormStart src (spanStart (nodeSpan d))))
                  (if (&& (>= off o) (< off (lspFormEnd src o)))
                    (set found (Some i)))
                }))
            (set i (+ i 1))
          }
        })
      found
    }
  })

; The fresh parse's entry list with every top-level invocation but the
; one at `idx` left out, so what phase D makes of it is one
; invocation's expansion.
(pub :: lspKeepOneCall (-> (Vec ASTNode) Int (Vec ASTNode)))
(pub fn (lspKeepOneCall decls2 idx)
  {
    (let out vecNew)
    (let n (vecLen decls2))
    {
      (for i in 0..n
        (if (|| (== i idx) (!= (nodeTag (vecGet decls2 i)) TAG_D_MACROCALL))
          (vecPush out (vecGet decls2 i))))
      out
    }
  })

(pub :: lspExpandAt (-> LspWorkspace String String (Vec ASTNode) Int Int))
;@axiom:effect(io)
(pub fn (lspExpandAt workspace path src decls idx)
  {
    (let site (vecGet decls idx))
    (let pr2 (parseModuleWith (lex src) (scanAxtags src)))
    {
      (let byCall (== (nodeTag site) TAG_D_MACROCALL))
      (let macName (nodeAName site))
      (match pr2
        ((ParseFailed parseError23) jsonNull)
        ((ParseSuccess parsedValue23 parsedPos23)
          {
            (let decls2
              (if byCall
                (lspKeepOneCall parsedValue23 idx)
                parsedValue23))
            {
              (let before (lspDeclHandles decls2))
              (let wasCall (lspDeclIsCall decls2))
              (if (let (Some ex) (lspFixExpand workspace path src decls2))
                (if (> (countErrorDiags ex.diags) 0)
                  jsonNull
                  {
                    (let gens ex.gens)
                    (let parts vecNew)
                    (let n (vecLen decls2))
                    {
                      (for i in 0..n
                        {
                          (let g (vecGet decls2 i))
                          (if (lspIsProductOf g i before wasCall gens macName byCall)
                            {
                              (if (> (vecLen parts) 0)
                                (vecPush parts "\n\n"))
                              (vecPush parts (lspRenderDecl g 0))
                            })
                        })
                      (jsonObjPut (jsonObjPut jsonObj "name" (jsonStr macName)) "expansion"
                        (jsonStr (catStrs parts)))
                    }
                  })
                jsonNull)
            }
          }
        ))
    }
  })

; The handles the list holds before expansion, in order, and which of
; them are invocations - the two facts identity is judged against
; afterwards.
(pub :: lspDeclHandles (-> (Vec ASTNode) (Vec ASTNode)))
(pub fn (lspDeclHandles decls)
  {
    (let out vecNew)
    (let n (vecLen decls))
    {
      (for i in 0..n
        (vecPush out (vecGet decls i)))
      out
    }
  })

(pub :: lspDeclIsCall (-> (Vec ASTNode) Ints))
(pub fn (lspDeclIsCall decls)
  {
    (let out vecNew)
    (let n (vecLen decls))
    {
      (for i in 0..n
        (vecPush out
          (if (== (nodeTag (vecGet decls i)) TAG_D_MACROCALL)
            1
            0)))
      out
    }
  })

; A product: a declaration at index `i` that is NEW - appended past
; the original length, a handle the list did not hold there, or the
; invocation's own node rewritten to another tag - and not an empty
; form or an invocation still waiting. Under an invocation everything
; generated is its own (the list was cut down to it); under a
; declaration, what `gens` attributes to that macro.
(pub :: lspIsProductOf (-> ASTNode Int (Vec ASTNode) Ints GeneratedOrigins String Bool Bool))
(pub fn (lspIsProductOf g i before wasCall gens macName byCall)
  (if (|| (== (nodeTag g) TAG_NIL) (== (nodeTag g) TAG_D_MACROCALL))
    false
    {
      (let fresh
        (if (>= i (vecLen before))
          true
          (if (! (nodeSame (vecGet before i) g))
            true
            (== (vecGet wasCall i) 1))))
      (if (lspNavNot fresh)
        false
        (if byCall
          true
          {
            (let gm (expGenOf gens (nodeAName g)))
            (match gm
              ((None) false)
              ((Some macroName) (strEq macroName macName)))
          }))
    }))

; ------------------------------------------------------------------
; The printer: an ASTNode back to Axiom source.
;
; Nothing else in the compiler does this. `lspFormText` re-slices the
; document, and `tyRender` writes the CHECKER's notation - `(Int ->
; Bool)`, which `parseTypeParens` refuses (probed: AX2001 at the
; arrow) - so an expansion, which exists only as nodes, needs its own
; writer, and so does the signature the assist inserts.
;
; WHAT IT PROMISES is that its output PARSES and means what the node
; meant: the gate sends an expansion back to the server as a document
; and requires a clean parse and exactly the generated names in its
; outline. What it does not promise is anyone's layout. It has one
; shape per form: a `let`, a `match`, a `fn`, a `lambda`, a `while`, a
; `cond` and a `{ }` block put their bodies one form per line, two
; spaces deeper; every other form is written inline unless a child
; already spans lines, in which case each child takes a line. Nested
; single-binding `let`s - which is what the parser makes of every
; multi-binding one - are re-merged into one binding list when the
; body is directly another `let`; curried single-parameter lambdas are
; re-merged the same way. Both are the inverse of the parser's own
; desugaring, and a `let` the author nested by hand merges too, which
; means the same thing.
;
; TWO SPELLINGS ARE NOT THE NODE'S OWN, and both are said here rather
; than discovered. A hygiene-renamed binder is `x.3` in the tree
; (expand.ax, MAC-HYG) and `.` is the field-access token, so it is
; written `x_3`: the rename stays visible and the text lexes. A
; qualified reference is `Mod$name` in the tree (`mangledFromChain`)
; and is written back as `Mod::name`, which is what the parser reads.
;
; WHAT IT CANNOT WRITE FAITHFULLY, said once: a float, whose node
; holds IEEE-754 bits and no lexeme, is written to nine places and
; trimmed - a literal that parses and is within a billionth of the
; value; an `effect` declaration, whose operation signatures the
; parser drops, is written as a comment naming it; an `impl` head
; keeps only its type's NAME, as the parser kept it; a rule-form
; macro's non-binder patterns are written as the `syntax/pat` marker
; the parser stores; a generated struct's fields are written with
; their types now that the expander carries them (they were untyped
; until `expBuildStructFieldsIn` was fixed - `lspRenderFields` still
; writes a bare `(name)` for a field whose type is 0). A node with a
; tag this printer does not know is written as
; `(syntax/unrenderable N)`, which parses and says what it is.
;
; MEASURED on a template holding a `let` with a `mut`, a block, `set`,
; `while`, `if`, `match` on a literal and a wildcard, `cond` with
; `else`, a two-parameter lambda, a struct construction, field access,
; a string with escapes, a char, a float, a negative literal, a
; `match` over constructors, and a generated `data`, `type` and
; `struct`: the rendering re-parsed clean, and `check` on it reported
; exactly the diagnostics `check` reported on the template - which is
; the printer meaning what the tree meant.
; ------------------------------------------------------------------
(pub :: lspPad (-> Int String))
(pub fn (lspPad n)
  {
    (let out (strBuilderNew))
    (for i in 0..n
      (strBuilderPushByte out 32))
    (strBuilderFinish out)
  })

(pub :: lspHasNl (-> String Bool))
(pub fn (lspHasNl s)
  (if (let (Some _) (strFindByte s 10 0))
    true
    false))

; `(head a b)` inline, or one child per line at `ind + 2` when any
; child already spans lines. `parts` holds the head first. Children
; are rendered at `ind + 2` by every caller, so their continuation
; lines are right in both layouts.
(pub :: lspRenderForm (-> Strings Int String))
(pub fn (lspRenderForm parts ind)
  {
    (let n (vecLen parts))
    (let out vecNew)
    (let broken (lspAnyNl parts 0))
    {
      (vecPush out "(")
      (for i in 0..n
        {
          (if (> i 0)
            (vecPush out
              (if broken
                (concat "\n" (lspPad (+ ind 2)))
                " ")))
          (vecPush out (vecGet parts i))
        })
      (vecPush out ")")
      (catStrs out)
    }
  })

(pub :: lspAnyNl (-> Strings Int Bool))
(pub fn (lspAnyNl parts i)
  (if (>= i (vecLen parts))
    false
    (if (lspHasNl (vecGet parts i))
      true
      (lspAnyNl parts (+ i 1)))))

; The two spellings above: `$` to `::` once, at the module boundary,
; and every byte the lexer would not read as part of a name to `_` in
; the name half only - a module path keeps its dots.
(pub :: lspRenderName (-> String String))
(pub fn (lspRenderName s)
  (match (lspModOf s)
    ((None) (lspDeHygiene s))
    ((Some m) (concat (concat m "::") (lspDeHygiene (bareOf s))))))

; The expander's own names carry two bytes no identifier may: the `.`
; of a hygiene rename (`x.3`, MAC-HYG) and the `#` of a `syntax/binders`
; field variable (`x#0`, expand.ax `expBindersOf`) - and the first
; version of this mapped the dot alone, so a fieldful derive rendered
; `x#0_0` and the text stopped at AX1001 (measured on
; tests/selfhost/377). The rule is the lexer's: any byte
; `isIdentChar` refuses becomes `_`, so the rename stays visible and
; the text lexes.
(pub :: lspDeHygiene (-> String String))
;@axiom:effect(unsafe)
(pub fn (lspDeHygiene s)
  (if (lspAllIdentBytes s 0)
    s
    {
      (let n (strLen s))
      (let out (strAlloc (strLen s)))
      {
        (for i in 0..n
          (__store8 (strData out) i
            (if (isIdentChar (strByte s i))
              (strByte s i)
              95)))
        (strSlice out 0 n)
      }
    }))

(pub :: lspAllIdentBytes (-> String Int Bool))
(pub fn (lspAllIdentBytes s i)
  (if (>= i (strLen s))
    true
    (if (isIdentChar (strByte s i))
      (lspAllIdentBytes s (+ i 1))
      false)))

; A declaration's name position: a join marker - the space-joined
; `syntax/join tag T` a template stores - is written back as the form
; it was.
(pub :: lspRenderDeclName (-> String String))
(pub fn (lspRenderDeclName s)
  (if (!= (expIsJoinMarker s) 0)
    (concat (concat "(" s) ")")
    (lspRenderName s)))

(pub :: lspRenderInt (-> Int String))
(pub fn (lspRenderInt v)
  (if (< v 0)
    (concat "-" (fmtInt (- 0 v)))
    (fmtInt v)))

; A string node holds its LEXEME - quotes and escapes as written - so
; it is written back as it was. One a macro built without quotes is
; quoted and escaped with the seven escapes the lexer reads
; (`isEscapeChar`), and no others.
(pub :: lspRenderStr (-> String String))
(pub fn (lspRenderStr s)
  (if (&& (> (strLen s) 0) (== (strByte s 0) 34))
    s
    {
      (let n (strLen s))
      (let parts vecNew)
      {
        (vecPush parts "\"")
        (for i in 0..n
          (vecPush parts (lspEscByte (strByte s i) 34 (strSlice s i 1))))
        (vecPush parts "\"")
        (catStrs parts)
      }
    }))

; One byte inside a literal delimited by `q`: the escape when the lexer
; needs one, else `raw`, which the caller cut from the source.
(pub :: lspEscByte (-> Int Int String String))
(pub fn (lspEscByte b q raw)
  (if (== b 92)
    "\\\\"
    (if (== b q)
      (concat "\\"
        (strSlice "\"'"
          (if (== q 34)
            0
            1)
          1))
      (if (== b 10)
        "\\n"
        (if (== b 9)
          "\\t"
          (if (== b 13)
            "\\r"
            (if (== b 0)
              "\\0"
              raw)))))))

(pub :: lspRenderChar (-> Int String))
(pub fn (lspRenderChar cp)
  (concat (concat "'" (lspEscByte cp 39 (utf8FromChar cp))) "'"))

; The bits reinterpreted, written to nine places and trimmed to the
; last non-zero one. `__floatToInt` truncates, so the fraction is
; taken from what remains and rounded half up; a carry into the next
; whole number is folded back rather than left to print as `.1000000000`.
(pub :: lspRenderFloat (-> Int String))
(pub fn (lspRenderFloat bits)
  {
    (let x (__floatFromBits bits))
    (if (< x 0.0)
      (concat "-" (lspRenderFloatAbs (- 0.0 x)))
      (lspRenderFloatAbs x))
  })

(pub :: lspRenderFloatAbs (-> Float String))
(pub fn (lspRenderFloatAbs x)
  {
    (let whole (as x Int))
    (let scale 1000000000)
    {
      (let scaled (as (+ (* (- x (as whole Float)) (as scale Float)) 0.5) Int))
      {
        (let carry
          (if (>= scaled scale)
            1
            0))
        (concat (concat (fmtInt (+ whole carry)) ".")
          (lspTrimZeros (lspZeroPad (fmtInt (- scaled (* carry scale))) 9)))
      }
    }
  })

(pub :: lspZeroPad (-> String Int String))
(pub fn (lspZeroPad s width)
  (if (>= (strLen s) width)
    s
    (lspZeroPad (concat "0" s) width)))

(pub :: lspTrimZeros (-> String String))
(pub fn (lspTrimZeros s)
  {
    (let mut e (strLen s))
    {
      (while (if (> e 1)
        (== (strByte s (- e 1)) 48)
        false)
        (set e (- e 1)))
      (strSlice s 0 e)
    }
  })

; Types in the PARSER's spelling - `parseTypeParens`'s grammar read
; backwards: `(-> A B C)` with the right-nested arrows flattened, `(Con
; a b)` for an application and `Con` alone for none, `[T]`, `(* T)`,
; `()` for the empty tuple and `(A B)` otherwise. A type variable with
; no name is the parser's wildcard for a field type it could not read
; (`typeNodeOrWildcard`) and is written `_`.
;
; `ren` is a flat Vec of (old, new) variable spellings the writer
; substitutes - what the assist needs, see `lspFreshRenames` - and
; empty when nothing is renamed.
(pub :: lspRenderType (-> ASTNode String))
(pub fn (lspRenderType t)
  (lspRenderTypeR t vecNew))

(pub :: lspRenderTypeR (-> ASTNode Strings String))
(pub fn (lspRenderTypeR t ren)
  (if (nodeSame t nilNode)
    "{unknown}"
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_VAR)
        (if (== (strLen (nodeAName t)) 0)
          "_"
          (lspRenamed ren (nodeAName t)))
        (if (== tag TAG_T_CON)
          (if (== (vecLen (nodeBChildren t)) 0)
            (nodeAName t)
            (concat
              (concat (concat "(" (nodeAName t)) (lspRenderTypes (nodeBChildren t) 0 " " ren)) ")"))
          (if (== tag TAG_T_ARR)
            (concat (concat "(->" (lspRenderArrow t ren)) ")")
            (if (== tag TAG_T_TUP)
              (concat (concat "(" (lspRenderTypes (nodeAChildren t) 0 "" ren)) ")")
              (if (== tag TAG_T_PTR)
                (concat (concat "(* " (lspRenderTypeR (nodeAChild t) ren)) ")")
                "{unknown}")))))
    }))

; The parameters and result of an arrow chain, each preceded by a
; space; the first element of a tuple gets none.
(pub :: lspRenderTypes (-> Nodes Int String Strings String))
(pub fn (lspRenderTypes tys i lead ren)
  (if (>= i (vecLen tys))
    ""
    (concat (concat lead (lspRenderTypeR (vecGet tys i) ren))
      (lspRenderTypes tys (+ i 1) " " ren))))

(pub :: lspRenderArrow (-> ASTNode Strings String))
(pub fn (lspRenderArrow t ren)
  (if (nodeSame t nilNode)
    " {unknown}"
    (if (== (nodeTag t) TAG_T_ARR)
      (concat (concat " " (lspRenderTypeR (nodeAChild t) ren)) (lspRenderArrow (nodeBChild t) ren))
      (concat " " (lspRenderTypeR t ren)))))

(pub :: lspRenamed (-> Strings String String))
(pub fn (lspRenamed ren name)
  (match (strVecIdx ren name)
    ((None) name)
    ((Some at)
      (if (|| (!= (% at 2) 0) (>= (+ at 1) (vecLen ren)))
        name
        (vecGet ren (+ at 1)))
    )))

; The checker names a type variable it could not resolve `_tN`
; (typecheck.ax, `tcCounter`), and `symbols` prints it that way -
; but the parser reads a type variable as a name starting with a
; lowercase LETTER (`aliasTyvarsEnd`), so a signature spelling `_t3`
; is AX3002 `undefined type`. Measured on tests/selfhost/770: the
; assist wrote `(:: adder (-> Int _t3 _t3))` and the checker refused
; it, where `(:: adder (-> Int a a))` checks clean and `symbols` then
; prints `(Int -> (a -> a))`. So each such variable is written as the
; first letter no variable of the type already uses, in order of
; appearance. Answers 0 when there is nothing to rename.
(pub :: lspFreshRenames (-> ASTNode Strings))
;@axiom:effect(unsafe)
(pub fn (lspFreshRenames ty)
  {
    (let names vecNew)
    (let ren vecNew)
    (let mut i 0)
    (let mut b 97)
    {
      (lspTyVarNames ty names)
      (while (< i (vecLen names))
        {
          (let nm (vecGet names i))
          {
            (if (&& (== (strByte nm 0) 95) (isNone (strVecIdx ren nm)))
              {
                (while (if (<= b 122)
                  (isSome (strVecIdx names (strFromByte b)))
                  false)
                  (set b (+ b 1)))
                (if (<= b 122)
                  {
                    (vecPush ren nm)
                    (vecPush ren (strFromByte b))
                    (vecPush names (strFromByte b))
                    (set b (+ b 1))
                  })
              })
            (set i (+ i 1))
          }
        })
      (if (== (vecLen ren) 0)
        (as 0 (Vec String))
        ren)
    }
  })

; Every named type variable of `ty`, in order of appearance.
(pub :: lspTyVarNames (-> ASTNode Strings Int))
(pub fn (lspTyVarNames t out)
  (if (nodeSame t nilNode)
    0
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_VAR)
        (if (> (strLen (nodeAName t)) 0)
          {
            (vecPush out (nodeAName t))
            0
          }
          0)
        (if (|| (== tag TAG_T_CON) (== tag TAG_T_TUP))
          (lspTyVarNamesIn
            (if (== tag TAG_T_CON)
              (nodeBChildren t)
              (nodeAChildren t))
            out 0)
          (if (== tag TAG_T_ARR)
            {
              (lspTyVarNames (nodeAChild t) out)
              (lspTyVarNames (nodeBChild t) out)
            }
            (if (== tag TAG_T_PTR)
              (lspTyVarNames (nodeAChild t) out)
              0))))
    }))

(pub :: lspTyVarNamesIn (-> (Vec ASTNode) Strings Int Int))
(pub fn (lspTyVarNamesIn tys out i)
  (if (>= i (vecLen tys))
    0
    {
      (lspTyVarNames (vecGet tys i) out)
      (lspTyVarNamesIn tys out (+ i 1))
    }))

; Whether every part of a type is known: no 0, no poison, no nameless
; variable. What the assist refuses to write.
(pub :: lspTyKnown (-> ASTNode Bool))
(pub fn (lspTyKnown t)
  (if (nodeSame t nilNode)
    false
    {
      (let tag (nodeTag t))
      (if (== tag TAG_T_VAR)
        (> (strLen (nodeAName t)) 0)
        (if (== tag TAG_T_CON)
          (lspTysKnown (nodeBChildren t) 0)
          (if (== tag TAG_T_ARR)
            (&& (lspTyKnown (nodeAChild t)) (lspTyKnown (nodeBChild t)))
            (if (== tag TAG_T_TUP)
              (lspTysKnown (nodeAChildren t) 0)
              (if (== tag TAG_T_PTR)
                (lspTyKnown (nodeAChild t))
                false)))))
    }))

(pub :: lspTysKnown (-> (Vec ASTNode) Int Bool))
(pub fn (lspTysKnown tys i)
  (if (>= i (vecLen tys))
    true
    (if (lspTyKnown (vecGet tys i))
      (lspTysKnown tys (+ i 1))
      false)))

; An expression, at column `ind`; its continuation lines are indented
; from there and its children are rendered at `ind + 2`.
(pub :: lspRenderExpr (-> ASTNode Int String))
(pub fn (lspRenderExpr e ind)
  (if (nodeSame e nilNode)
    "(syntax/unrenderable 0)"
    {
      (let tag (nodeTag e))
      (if (== tag TAG_E_INT)
        (if (isUnitLit e)
          "()"
          (lspRenderInt (nodeA e)))
        (if (== tag TAG_E_STR)
          (lspRenderStr (nodeAName e))
          (if (== tag TAG_E_CHAR)
            (lspRenderChar (nodeA e))
            (if (== tag TAG_E_FLT)
              (lspRenderFloat (nodeA e))
              (if (== tag TAG_E_VAR)
                (lspRenderName (nodeAName e))
                (if (== tag TAG_E_APP)
                  (lspRenderApp e ind)
                  (if (== tag TAG_E_LAM)
                    (lspRenderLam e ind)
                    (if (|| (== tag TAG_E_LET) (== tag TAG_E_LETM))
                      (lspRenderLet e ind)
                      (if (== tag TAG_E_IF)
                        (lspRenderForm
                          (lspParts4 "if" (lspRenderExpr (nodeAChild e) (+ ind 2))
                            (lspRenderExpr (nodeBChild e) (+ ind 2))
                            (lspRenderExpr (nodeCChild e) (+ ind 2)))
                          ind)
                        (if (== tag TAG_E_BEGIN)
                          (lspRenderBlock (nodeAChildren e) ind)
                          (if (== tag TAG_E_MATCH)
                            (lspRenderMatch e ind)
                            (lspRenderExprMore e tag ind))))))))))))
    }))

; The second half of the dispatch: the forms a body meets less often.
(pub :: lspRenderExprMore (-> ASTNode Int Int String))
; `cond` is AX2004: the parser builds none, so no arm renders one.
; A variadic `if` arrives as nested `if`s and renders through the
; `if` arm of `lspRenderExpr`.
(pub fn (lspRenderExprMore e tag ind)
  (if (== tag TAG_E_SET)
    (lspRenderForm
      (lspParts3 "set" (lspRenderName (nodeAName e)) (lspRenderExpr (nodeBChild e) (+ ind 2))) ind)
    (if (|| (== tag TAG_E_WHILE) (== tag TAG_E_REGION))
      (if (== tag TAG_E_REGION)
        (lspRenderForm
          (lspParts3 "region" (lspRenderName (nodeAName e))
            (lspRenderExpr (nodeBChild e) (+ ind 2)))
          ind)
        (concat
          (concat (concat "(while " (lspRenderExpr (nodeAChild e) (+ ind 2)))
            (lspRenderLines (nodeBChildren e) (+ ind 2)))
          ")"))
      (if (== tag TAG_E_TRY)
        (concat (lspRenderExpr (nodeAChild e) ind) "?")
        (if (== tag TAG_E_FIELD)
          (concat (concat (lspRenderExpr (nodeAChild e) ind) ".") (nodeBName e))
          (if (== tag TAG_E_SETF)
            (lspRenderForm
              (lspParts3 "set"
                (concat (concat (lspRenderExpr (nodeAChild e) (+ ind 2)) ".") (nodeBName e))
                (lspRenderExpr (nodeCChild e) (+ ind 2)))
              ind)
            (if (== tag TAG_E_HANDLE)
              (lspRenderHandle e ind)
              (if (== tag TAG_E_QUOTE)
                (lspRenderForm (lspParts2 "quote" (lspRenderExpr (nodeAChild e) (+ ind 2))) ind)
                (if (== tag TAG_P_CON0)
                  (concat (concat "(" (lspRenderName (nodeAName e))) ")")
                  (if (== tag TAG_P_CONNAMED)
                    (lspRenderConNamed e ind)
                    (if (== tag TAG_M_FOR)
                      (lspRenderSynFor e ind)
                      (if (== tag TAG_M_ARM)
                        (lspRenderArm e ind)
                        (concat (concat "(syntax/unrenderable " (fmtInt tag)) ")")))))))))))))

(pub :: lspParts2 (-> String String Strings))
(pub fn (lspParts2 a b)
  {
    (let v vecNew)
    {
      (vecPush v a)
      (vecPush v b)
      v
    }
  })

(pub :: lspParts3 (-> String String String Strings))
(pub fn (lspParts3 a b c)
  {
    (let v (lspParts2 a b))
    {
      (vecPush v c)
      v
    }
  })

(pub :: lspParts4 (-> String String String String Strings))
(pub fn (lspParts4 a b c d)
  {
    (let v (lspParts3 a b c))
    {
      (vecPushStr v d)
      v
    }
  })

; Every expression of `es` rendered onto `parts`, at `ind`.
(pub :: lspPartsExprs (-> Strings (Vec ASTNode) Int Int Strings))
(pub fn (lspPartsExprs parts es i ind)
  (if (>= i (vecLen es))
    parts
    {
      (vecPush parts (lspRenderExpr (vecGet es i) ind))
      (lspPartsExprs parts es (+ i 1) ind)
    }))

; An application spine, flattened back to `(f a b)`: `(f x y)` parses
; to App(App(f, x), y), so the arguments come off the spine in reverse
; and the head is what is left when the tags run out.
(pub :: lspRenderApp (-> ASTNode Int String))
(pub fn (lspRenderApp e ind)
  {
    (let rev vecNew)
    (let labels
      (if (!= (nodeFieldNames e) 0)
        (nodeFieldNamesNames e)
        vecNew))
    (let mut h e)
    {
      (while (== (nodeTag h) TAG_E_APP)
        {
          (vecPush rev (nodeBChild h))
          (set h (nodeAChild h))
        })
      {
        (let parts vecNew)
        (let mut i (- (vecLen rev) 1))
        {
          (vecPush parts (lspRenderExpr h (+ ind 2)))
          (while (>= i 0)
            {
              {
                (let labelIndex (- (- (vecLen rev) 1) i))
                (if (< labelIndex (vecLen labels))
                  (vecPush parts (concat ":" (vecGet labels labelIndex))))
              }
              (vecPush parts (lspRenderExpr (vecGet rev i) (+ ind 2)))
              (set i (- i 1))
            })
          (lspRenderForm parts ind)
        }
      }
    }
  })

; `(lambda (x y) body)`: the curried chain of one-parameter lambdas
; re-merged, and a zero-parameter one written `()`.
(pub :: lspRenderLam (-> ASTNode Int String))
(pub fn (lspRenderLam e ind)
  {
    (let names vecNew)
    (let mut body e)
    {
      (while (&& (== (nodeTag body) TAG_E_LAM) (== (vecLen (nodeANames body)) 1))
        {
          (vecPush names (vecGet (nodeANames body) 0))
          (set body (nodeBChild body))
        })
      (if (== (vecLen names) 0)
        (set body (nodeBChild e)))
      (concat (concat (concat (concat "(lambda (" (lspJoinNames names)) ")\n") (lspPad (+ ind 2)))
        (concat (lspRenderExpr body (+ ind 2)) ")"))
    }
  })

(pub :: lspJoinNames (-> Names String))
(pub fn (lspJoinNames names)
  {
    (let parts vecNew)
    (for name in names
      (vecPush parts (lspRenderName name)))
    (strJoin parts " ")
  })

; Lowered lets render as locals in one enclosing brace block.
(pub :: lspRenderLet (-> ASTNode Int String))
(pub fn (lspRenderLet e ind)
  {
    (let parts vecNew)
    {
      (let mut body e)
      {
        (vecPush parts "{")
        (while (|| (== (nodeTag body) TAG_E_LET) (== (nodeTag body) TAG_E_LETM))
          {
            (vecPush parts "\n")
            (vecPush parts (lspPad (+ ind 2)))
            (vecPush parts
              (if (== (nodeTag body) TAG_E_LETM)
                "(let mut "
                "(let "))
            (vecPush parts (lspRenderName (nodeAName body)))
            (vecPush parts " ")
            (vecPush parts (lspRenderExpr (nodeBChild body) (+ ind 2)))
            (vecPush parts ")")
            (set body (nodeCChild body))
          })
        (vecPush parts "\n")
        (vecPush parts (lspPad (+ ind 2)))
        (vecPush parts (lspRenderExpr body (+ ind 2)))
        (vecPush parts "\n")
        (vecPush parts (lspPad ind))
        (vecPush parts "}")
        (catStrs parts)
      }
    }
  })

; `{ }`: one expression per line.
(pub :: lspRenderBlock (-> (Vec ASTNode) Int String))
(pub fn (lspRenderBlock es ind)
  (concat (concat "{" (lspRenderLines es (+ ind 2))) (concat "\n" (concat (lspPad ind) "}"))))

; Each of `es` on a line of its own at `ind`, every line led by its
; newline so the caller's opener stays on the caller's line.
(pub :: lspRenderLines (-> (Vec ASTNode) Int String))
(pub fn (lspRenderLines es ind)
  {
    (let parts vecNew)
    (let n (vecLen es))
    {
      (for i in 0..n
        (vecPush parts (concat (concat "\n" (lspPad ind)) (lspRenderExpr (vecGet es i) ind))))
      (catStrs parts)
    }
  })

(pub :: lspRenderMatch (-> ASTNode Int String))
(pub fn (lspRenderMatch e ind)
  (concat
    (concat (concat "(match " (lspRenderExpr (nodeAChild e) (+ ind 2)))
      (lspRenderLines (nodeBChildren e) (+ ind 2)))
    ")"))

; One arm, `(pattern body)` - a `match` arm - with the body on its
; own line when it spans lines.
(pub :: lspRenderArm (-> ASTNode Int String))
(pub fn (lspRenderArm arm ind)
  {
    (let pat (lspRenderExpr (nodeAChild arm) (+ ind 2)))
    (let body (lspRenderExpr (nodeBChild arm) (+ ind 2)))
    (concat
      (concat (concat "(" pat)
        (if (lspHasNl body)
          (concat "\n" (lspPad (+ ind 2)))
          " "))
      (concat body ")"))
  })

; `(handle body (Effect...) handler)`, the effect list left out when
; it is empty - the parser reads it as optional.
(pub :: lspRenderHandle (-> ASTNode Int String))
(pub fn (lspRenderHandle e ind)
  {
    (let parts (lspParts2 "handle" (lspRenderExpr (nodeAChild e) (+ ind 2))))
    {
      (if (> (vecLen (nodeBChildren e)) 0)
        (vecPush parts (concat (concat "(" (lspJoinExprs (nodeBChildren e) ind)) ")")))
      (vecPush parts (lspRenderExpr (nodeCChild e) (+ ind 2)))
      (lspRenderForm parts ind)
    }
  })

(pub :: lspJoinExprs (-> (Vec ASTNode) Int String))
(pub fn (lspJoinExprs es ind)
  {
    (let parts vecNew)
    (for x in es
      (vecPush parts (lspRenderExpr x ind)))
    (strJoin parts " ")
  })

; `(Rect { w = p, h = q })`: field names in `b`, sub-patterns aligned
; in `c`.
(pub :: lspRenderConNamed (-> ASTNode Int String))
(pub fn (lspRenderConNamed e ind)
  {
    (let names (nodeBChildren e))
    (let pats (nodeCChildren e))
    (let parts vecNew)
    {
      (vecPush parts (concat (concat "(" (lspRenderName (nodeAName e))) " {"))
      (for i in 0..(vecLen names)
        {
          (vecPush parts
            (if (== i 0)
              " "
              ", "))
          (vecPush parts (lspRenderName (nodeAName (vecGet names i))))
          (vecPush parts " = ")
          (vecPush parts (lspRenderExpr (vecGet pats i) (+ ind 2)))
        })
      (vecPush parts " })")
      (catStrs parts)
    }
  })

; `(syntax/for (x xs) ...)` in either position: the binding form is
; the expression the parser stored, the elements are arms or
; declarations by the node's tag.
(pub :: lspRenderSynFor (-> ASTNode Int String))
(pub fn (lspRenderSynFor e ind)
  (concat (concat "(syntax/for " (lspRenderExpr (nodeBChild e) (+ ind 2)))
    (concat
      (if (== (nodeTag e) TAG_M_FOR)
        (lspRenderLines (nodeCChildren e) (+ ind 2))
        (lspRenderDeclLines (nodeCChildren e) (+ ind 2)))
      ")")))

(pub :: lspRenderDeclLines (-> (Vec ASTNode) Int String))
(pub fn (lspRenderDeclLines ds ind)
  {
    (let parts vecNew)
    (let n (vecLen ds))
    {
      (for i in 0..n
        (vecPush parts (concat (concat "\n" (lspPad ind)) (lspRenderDecl (vecGet ds i) ind))))
      (catStrs parts)
    }
  })

; A declaration at column `ind` - 0 at the top level, deeper inside a
; rule-form macro's template - with its `;@axiom:` lines above it,
; each as the scanner stored its content after the prefix, and `pub`
; from `nodeVis`.
(pub :: lspRenderDecl (-> ASTNode Int String))
(pub fn (lspRenderDecl d ind)
  (if (nodeSame d nilNode)
    "; unrenderable declaration (no node)"
    (match (nodeAxtagsOpt d)
      ((None) (lspRenderDeclBody d ind))
      ((Some tags) (concat (lspRenderAxtags tags ind) (lspRenderDeclBody d ind))))))

(pub :: lspRenderAxtags (-> Axtags Int String))
(pub fn (lspRenderAxtags tags ind)
  {
    (let parts vecNew)
    (for tag in tags
      (vecPush parts (concat (concat ";@axiom:" tag.content) (concat "\n" (lspPad ind)))))
    (catStrs parts)
  })

(pub :: lspPubOf (-> ASTNode String))
(pub fn (lspPubOf d)
  (if (== (nodeVis d) 1)
    "(pub "
    "("))

; A struct's representation markers as written, each after a space
; (`collectStructMarkers`), or "" for a struct with none. A generated
; `(struct Chan word shared ...)` rendered without them would show a
; heap struct where the program has a sealed word.
(pub :: lspStructMarkers (-> ASTNode String))
(pub fn (lspStructMarkers d)
  {
    (let ms (structMarkers d))
    (let parts vecNew)
    {
      (for i in 0..(vecLen ms)
        (vecPush parts (concat " " (nodeAName (vecGet ms i)))))
      (catStrs parts)
    }
  })

(pub :: lspRenderDeclBody (-> ASTNode Int String))
(pub fn (lspRenderDeclBody d ind)
  {
    (let tag (nodeTag d))
    (if (== tag TAG_D_FN)
      (concat
        (concat (concat (concat (lspPubOf d) "fn (") (lspRenderDeclName (nodeAName d)))
          (concat (lspParamsOf (nodeBNames d)) ")\n"))
        (concat (lspPad (+ ind 2)) (concat (lspRenderExpr (nodeCChild d) (+ ind 2)) ")")))
      (if (== tag TAG_D_SIG)
        (concat (concat (concat (lspPubOf d) ":: ") (lspRenderDeclName (nodeAName d)))
          (concat (concat " " (lspRenderType (nodeTyChild d))) ")"))
        (if (== tag TAG_D_DATA)
          (lspRenderData d ind)
          (if (== tag TAG_D_STRUCT)
            (concat
              (concat (concat (lspPubOf d) "struct ")
                (concat (lspRenderDeclName (nodeAName d)) (lspStructMarkers d)))
              (concat (lspRenderFields (nodeBChildren d) (+ ind 2)) ")"))
            (if (== tag TAG_D_MACRO)
              (lspRenderMacro d ind)
              (if (== tag TAG_D_IMPORT)
                (concat (concat "(import " (nodeAName d))
                  (concat
                    (if (== (vecLen (nodeBNames d)) 0)
                      ""
                      (concat (concat " (" (lspJoinNames (nodeBNames d))) ")"))
                    ")"))
                (if (== tag TAG_D_ALIAS)
                  (concat (concat (concat (lspPubOf d) "type ") (lspRenderDeclName (nodeAName d)))
                    (concat (concat (lspTyvarsOf (nodeCNames d)) " = ")
                      (concat (lspRenderType (nodeBChild d)) ")")))
                  (lspRenderDeclMore d tag ind))))))))
  })

(pub :: lspRenderDeclMore (-> ASTNode Int Int String))
(pub fn (lspRenderDeclMore d tag ind)
  (if (== tag TAG_D_EXTERN)
    (concat (concat (concat (lspPubOf d) "extern \"") (concat (nodeAName d) "\""))
      (concat (lspRenderExternItems (nodeCChildren d) (+ ind 2)) ")"))
    (if (== tag TAG_D_MACROCALL)
      (lspRenderForm
        (lspPartsExprs (lspParts1 (lspRenderName (nodeAName d))) (nodeBChildren d) 0 (+ ind 2)) ind)
      (if (== tag TAG_D_SYNFOR)
        (lspRenderSynFor d ind)
        (if (== tag TAG_D_EFFECT)
          (concat (concat "; (effect " (nodeAName d))
            " ...) - the parser keeps its operation names and not their signatures, so it is not rendered")
          (concat (concat "; unrenderable declaration (tag " (fmtInt tag)) ")"))))))

(pub :: lspParts1 (-> String Strings))
(pub fn (lspParts1 a)
  {
    (let v vecNew)
    {
      (vecPush v a)
      v
    }
  })

; ` x y` for a parameter list, "" for none.
(pub :: lspParamsOf (-> Names String))
(pub fn (lspParamsOf names)
  (if (== (vecLen names) 0)
    ""
    (concat " " (lspJoinNames names))))

; ` (a b)` for a `data`'s type parameters; ` a b` bare for a `type`
; or `trait`, which is what their parsers read; "" for none.
(pub :: lspTyvarsOf (-> Names String))
(pub fn (lspTyvarsOf tvs)
  (if (== (as tvs Int) 0)
    ""
    (if (== (vecLen tvs) 0)
      ""
      (concat " " (strJoin tvs " ")))))

; `(data Name (a) ctor...)`: each constructor on its own line, a struct
; variant with its named fields, a positional one with its field
; types.
(pub :: lspRenderData (-> ASTNode Int String))
(pub fn (lspRenderData d ind)
  {
    (let ctors (nodeBChildren d))
    (let parts vecNew)
    {
      (vecPush parts (concat (concat (lspPubOf d) "data ") (lspRenderDeclName (nodeAName d))))
      (if (! (== (nodeTy d) 0))
        (if (! (== (vecLen (nodeTyNames d)) 0))
          (vecPush parts (concat (concat " (" (strJoin (nodeTyNames d) " ")) ")"))))
      (for i in 0..(vecLen ctors)
        (vecPush parts (concat (concat "\n" (lspPad (+ ind 2))) (lspRenderCtor (vecGet ctors i)))))
      (vecPush parts ")")
      (catStrs parts)
    }
  })

(pub :: lspRenderCtor (-> ASTNode String))
(pub fn (lspRenderCtor c)
  {
    (let tys
      (if (== (nodeTy c) 0)
        vecNew
        (nodeTyChildren c)))
    (let names (nodeFieldNamesNames c))
    (if (&& (!= (as names Int) 0) (> (vecLen names) 0))
      (concat (concat (concat "(" (lspRenderDeclName (nodeAName c))) " {")
        (concat (lspRenderNamedFields names tys) " })"))
      (concat (concat "(" (lspRenderDeclName (nodeAName c)))
        (concat (lspRenderTypes tys 0 " " vecNew) ")")))
  })

(pub :: lspRenderNamedFields (-> Names Nodes String))
(pub fn (lspRenderNamedFields names tys)
  {
    (let parts vecNew)
    (for (name i) in names
      (vecPush parts
        (concat (concat name " : ")
          (if (< i (vecLen tys))
            (lspRenderType (vecGet tys i))
            "_"))))
    (if (== (vecLen parts) 0)
      ""
      (concat " " (strJoin parts ", ")))
  })

; A struct's `(name : Type)` fields, one per line - or `(name)`, the
; parser's own spelling of a field with no type, when the tree holds
; none.
;
; A GENERATED STRUCT TAKES THE FIRST ARM: the code below branches on
; `lspTyKnown (nodeTy f)`, and `expBuildStructFieldsIn` gives a
; generated field its type. `axiom/expandMacro` at an invocation of a
; macro whose template is `(pub struct (syntax/join Pair T) (left :
; Int) (right : Int))` answers
;
;     (pub struct PairColour
;       (left : Int)
;       (right : Int))
;
; The bare arm survives for a field whose type really is 0. The
; checker reads a 0 as the wildcard, and `(name)` parses back to the
; same wildcard where `{unknown}` parses to nothing.
(pub :: lspRenderFields (-> (Vec ASTNode) Int String))
(pub fn (lspRenderFields fields ind)
  {
    (let parts vecNew)
    (let n (vecLen fields))
    {
      (for i in 0..n
        {
          (let f (vecGet fields i))
          (vecPush parts
            (concat (concat (concat "\n" (lspPad ind)) (concat "(" (nodeAName f)))
              (if (lspTyKnown (nodeTyChild f))
                (concat (concat " : " (lspRenderType (nodeTyChild f))) ")")
                ")")))
        })
      (catStrs parts)
    }
  })

; `(name :: Type (symbol "s"))` per extern item, one per line.
(pub :: lspRenderExternItems (-> (Vec ASTNode) Int String))
(pub fn (lspRenderExternItems items ind)
  {
    (let parts vecNew)
    (let n (vecLen items))
    {
      (for i in 0..n
        {
          (let it (vecGet items i))
          (vecPush parts
            (concat (concat (concat "\n" (lspPad ind)) (concat "(" (nodeAName it)))
              (concat (concat " :: " (lspRenderType (nodeBChild it)))
                (concat (concat " (symbol \"" (nodeCName it)) "\"))"))))
        })
      (catStrs parts)
    }
  })

; A macro in either of its two spellings: the head-list form `(macro
; (name p...) body)` when word 3 holds a template expression, else the
; rule form, one owning rule per line, with its parameter names and
; declaration or expression template.
(pub :: lspRenderMacro (-> ASTNode Int String))
(pub fn (lspRenderMacro d ind)
  (if (!= (nodeC d) 0)
    (concat
      (concat (concat (concat (lspPubOf d) "macro (") (lspRenderName (nodeAName d)))
        (concat (lspParamsOf (nodeBNames d)) ")\n"))
      (concat (lspPad (+ ind 2)) (concat (lspRenderExpr (nodeCChild d) (+ ind 2)) ")")))
    {
      (let rules
        (match (nodeMacroRules d)
          ((None) vecNew)
          ((Some rules) rules)))
      (let parts vecNew)
      (let mut i 0)
      {
        (vecPush parts (concat (concat (lspPubOf d) "macro ") (lspRenderName (nodeAName d))))
        (while (< i (vecLen rules))
          {
            (vecPush parts
              (concat
                (concat (concat "\n" (lspPad (+ ind 2)))
                  (concat "((" (lspRenderName (nodeAName d))))
                (concat (lspParamsOf (ruleParamsAt rules i)) ")")))
            (vecPush parts
              (concat
                (if (> (vecLen (ruleDeclsAt rules i)) 0)
                  (lspRenderDeclLines (ruleDeclsAt rules i) (+ ind 4))
                  (concat (concat "\n" (lspPad (+ ind 4)))
                    (match (ruleExprAt rules i)
                      ((None) "(syntax/unrenderable 0)")
                      ((Some template) (lspRenderExpr template (+ ind 4))))))
                ")"))
            (set i (+ i 1))
          })
        (vecPush parts ")")
        (catStrs parts)
      }
    }))

; ==================================================================
; END SECTION FIX
; ==================================================================
; ==================================================================
; SECTION HL: semantic tokens
; ==================================================================
; `textDocument/semanticTokens/full`: the protocol's highlighting
; channel, and the only colour an editor without tree-sitter (VS Code)
; gets. Every identifier is coloured by WHAT IT RESOLVES TO - a
; parameter, a `let`, this document's function, type, macro or effect,
; a constructor, a name from elsewhere - and not by how it is spelled;
; keywords, strings, numbers, comments, AXTAG decorators, region
; names and operators come from the bytes, so a document that
; does not parse is still highlighted, every identifier falling back to
; a lexical rule and every declaration head keeping its colour.
;
; THE ROLES MIRROR `tree-sitter-axiom/queries/highlights.scm`, which is
; the role reference for the editors that load a grammar, so the two
; sources agree on every token whose role the grammar can see. The
; legend is a contract with `editors/vscode`, which maps each name
; below to a scope; the order of `lspSemanticTypes` and
; `lspSemanticModifiers` is what the integers index, and the `SEM_*`
; constants below ARE that order.
;
; TWO SOURCES, ONE SCAN. The resolution is SECTION NAV's occurrence
; walk (`lspNavOccurrences`), expanding nothing (MAC-TOOL-3): an
; occurrence's key says whether a name is a local binder or reference,
; one of this document's declarations, a constructor, an effect, or
; nothing this document declares. The bytes are read once, left to
; right, in `lspFormEnd`'s order - a string, a `;` line, a `#| |#`
; block, a char literal, a number, an identifier -
; and each identifier looks its start offset up in a bucket index over
; the occurrences, built once per request; the occurrence list is never
; scanned per identifier, which on this repository's own `typecheck.ax`
; would be twenty thousand identifiers against twenty thousand
; occurrences.
;
; WHAT THE BYTES KNOW THAT THE OCCURRENCES DO NOT. A struct field, a
; macro rule, a type inside `as`, the module of an `import`, an
; `effect`'s operations, an `extern` item, a `region`'s name, and the
; whole of a document that does not parse have no occurrence. The scan
; keeps a stack of the open brackets, each with its head keyword, how
; many items have followed the head, and the CONTEXT that head opens -
; a type (`::`, `struct`, `type`, `extern`, `effect`, `as`), a `data`
; whose children are constructor forms, an `import` whose identifiers
; are namespaces, the header list of a `fn`, `macro` or `lambda` whose
; identifiers are parameters, a macro's rules whose patterns bind, a
; `let` pair whose head is a binder, a `handle`'s effect list. That is
; how `(struct Point (x : Int))` knows `x` is a field, how `(:: f (->
; Int (Maybe Int)))` knows `Maybe` heads a type application and not a
; constructor, and how `(fn (add x y) ...)` keeps `y` a parameter and
; `add` a declared function on the keystroke that breaks the parse - a
; half-typed file is the normal state, and highlighting that flickers
; on every unbalanced paren is worse than none.
;
; THE ANSWER'S SHAPE is the protocol's integer array: five numbers per
; token - line delta, start delta (from the previous token when on the
; same line, from column 0 otherwise), length, type index, modifier
; bitset - in UTF-16 code units, sorted, never overlapping, and never
; spanning a line break: a multi-line string or block comment is one
; token per line, empty pieces skipped. Range replies retain whole
; overlapping tokens. Delta replies edit the previous full integer array.
;
; WHAT IT COSTS: one parse, one line index, one occurrence walk, one
; byte scan, two bucket indexes (start offset -> occurrence, binder
; key -> binder) and one name index over the declarations. The
; answer's size dominates: on the gate's 2,050-declaration document
; the request is ~23,000 tokens, five numbers each, measured at 1.31x
; that document's `didOpen` (0.055 s against 0.042 s) where the
; outline is 0.37x. The gate holds it under 2.00x.
(pub :: lspHlHandles (-> String Bool))
(pub fn (lspHlHandles method)
  (|| (strEq method "textDocument/semanticTokens/full")
    (|| (strEq method "textDocument/semanticTokens/full/delta")
      (strEq method "textDocument/semanticTokens/range"))))

(pub :: lspHlDispatch (-> String Int Int Strings Strings Strings String))
(pub fn (lspHlDispatch method id params uris texts highlights)
  {
    (let uri (lspParamsUri params))
    (match (docText uris texts uri)
      ((None) (lspReplyBody id (jsonObjPut jsonObj "data" jsonArr)))
      ((Some src)
        (if (strEq method "textDocument/semanticTokens/range")
          (lspReplyBody id (lspHlRange src (jsonGet params "range")))
          (if (strEq method "textDocument/semanticTokens/full/delta")
            (lspReplyEncodedBody id
              (lspHlDelta uris highlights uri src (jsonGetStr params "previousResultId")))
            (lspReplyEncodedBody id (lspHlFull uris highlights uri src))))
      ))
  })

; Every full result has an identifier while its document is in the store.
(pub :: lspHlCaps (-> Int Int))
(pub fn (lspHlCaps caps)
  (jsonObjPut caps "semanticTokensProvider"
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "legend" lspSemanticLegend) "range" (jsonBool 1))
      "full" (jsonObjPut jsonObj "delta" (jsonBool 1)))))

; ------------------------------------------------------------------
; The legend. A token type is an index into `tokenTypes`, a modifier
; a bit of `tokenModifiers`, both in the order advertised - so the
; constants below ARE the legend, and a type added to one without the
; other would colour every token after it wrong. The two name lists
; are functions so the gate can read them off the source and hold the
; advertised legend to them.
; ------------------------------------------------------------------
(pub :: lspSemanticTypes Strings)
(pub fn (lspSemanticTypes)
  {
    (let v vecNew)
    {
      (vecPush v "namespace")
      (vecPush v "type")
      (vecPush v "typeParameter")
      (vecPush v "parameter")
      (vecPush v "variable")
      (vecPush v "property")
      (vecPush v "enumMember")
      (vecPush v "function")
      (vecPush v "macro")
      (vecPush v "keyword")
      (vecPush v "comment")
      (vecPush v "string")
      (vecPush v "number")
      (vecPush v "operator")
      (vecPush v "decorator")
      (vecPush v "effect")
      (vecPush v "region")
      v
    }
  })

(pub :: lspSemanticModifiers Strings)
(pub fn (lspSemanticModifiers)
  {
    (let v vecNew)
    {
      (vecPush v "declaration")
      (vecPush v "definition")
      (vecPush v "readonly")
      (vecPush v "modification")
      (vecPush v "deprecated")
      (vecPush v "documentation")
      (vecPush v "defaultLibrary")
      v
    }
  })

(pub :: lspSemanticLegend Int)
(pub fn (lspSemanticLegend)
  (jsonObjPut (jsonObjPut jsonObj "tokenTypes" (lspHlStrArr lspSemanticTypes)) "tokenModifiers"
    (lspHlStrArr lspSemanticModifiers)))

(pub :: lspHlStrArr (-> Strings Int))
(pub fn (lspHlStrArr names)
  {
    (let a jsonArr)
    {
      (for i in 0..(vecLen names)
        (jsonArrPush a (jsonStr (vecGet names i))))
      a
    }
  })

; The token types, by index in `lspSemanticTypes`.
(pub :: SEM_NAMESPACE Int)
(pub fn (SEM_NAMESPACE)
  0)

(pub :: SEM_TYPE Int)
(pub fn (SEM_TYPE)
  1)

(pub :: SEM_TYPEPARAM Int)
(pub fn (SEM_TYPEPARAM)
  2)

(pub :: SEM_PARAMETER Int)
(pub fn (SEM_PARAMETER)
  3)

(pub :: SEM_VARIABLE Int)
(pub fn (SEM_VARIABLE)
  4)

(pub :: SEM_PROPERTY Int)
(pub fn (SEM_PROPERTY)
  5)

(pub :: SEM_ENUM Int)
(pub fn (SEM_ENUM)
  6)

(pub :: SEM_FUNCTION Int)
(pub fn (SEM_FUNCTION)
  7)

(pub :: SEM_MACRO Int)
(pub fn (SEM_MACRO)
  8)

(pub :: SEM_KEYWORD Int)
(pub fn (SEM_KEYWORD)
  9)

(pub :: SEM_COMMENT Int)
(pub fn (SEM_COMMENT)
  10)

(pub :: SEM_STRING Int)
(pub fn (SEM_STRING)
  11)

(pub :: SEM_NUMBER Int)
(pub fn (SEM_NUMBER)
  12)

(pub :: SEM_OPERATOR Int)
(pub fn (SEM_OPERATOR)
  13)

(pub :: SEM_DECORATOR Int)
(pub fn (SEM_DECORATOR)
  14)

(pub :: SEM_EFFECT Int)
(pub fn (SEM_EFFECT)
  15)

(pub :: SEM_REGION Int)
(pub fn (SEM_REGION)
  16)

; The modifier bits, by index in `lspSemanticModifiers`.
(pub :: SEM_M_DECL Int)
(pub fn (SEM_M_DECL)
  1)

(pub :: SEM_M_DEFN Int)
(pub fn (SEM_M_DEFN)
  2)

(pub :: SEM_M_READONLY Int)
(pub fn (SEM_M_READONLY)
  4)

(pub :: SEM_M_MOD Int)
(pub fn (SEM_M_MOD)
  8)

(pub :: SEM_M_DEPRECATED Int)
(pub fn (SEM_M_DEPRECATED)
  16)

(pub :: SEM_M_DOC Int)
(pub fn (SEM_M_DOC)
  32)

(pub :: SEM_M_LIB Int)
(pub fn (SEM_M_LIB)
  64)

; A type and its modifiers travel as one Int through the classifiers,
; because a function answers one value: `ty + 128 * mods`. The seven
; modifier bits fit under 128 and the seventeen types under it too.
(pub :: lspHlPack (-> Int Int Int))
(pub fn (lspHlPack ty mods)
  (+ ty (* 128 mods)))

; ------------------------------------------------------------------
; The form stack: what the scan knows about where it is.
;
; Each open `(` or `{` is three words on a flat Vec: the HEAD code
; (`SEM_H_*`, the keyword the form opens with), the STATE - 0 awaiting
; the head, k >= 1 for the head seen with k-1 items after it - and
; the CONTEXT (`SEM_C_*`) the identifiers inside it are read in. A
; `pub` before the head leaves the state at 0, so `(pub fn` and `(fn`
; are one shape.
; ------------------------------------------------------------------
(pub :: SEM_H_NONE Int)
(pub fn (SEM_H_NONE)
  0)

(pub :: SEM_H_OTHER Int)
(pub fn (SEM_H_OTHER)
  1)

(pub :: SEM_H_KW Int)
(pub fn (SEM_H_KW)
  2)

(pub :: SEM_H_IMPORT Int)
(pub fn (SEM_H_IMPORT)
  3)

(pub :: SEM_H_FN Int)
(pub fn (SEM_H_FN)
  4)

(pub :: SEM_H_DATA Int)
(pub fn (SEM_H_DATA)
  5)

(pub :: SEM_H_STRUCT Int)
(pub fn (SEM_H_STRUCT)
  6)

(pub :: SEM_H_MACRO Int)
(pub fn (SEM_H_MACRO)
  7)

(pub :: SEM_H_TYPE Int)
(pub fn (SEM_H_TYPE)
  8)

(pub :: SEM_H_SIG Int)
(pub fn (SEM_H_SIG)
  9)

(pub :: SEM_H_EXTERN Int)
(pub fn (SEM_H_EXTERN)
  10)

(pub :: SEM_H_EFFECT Int)
(pub fn (SEM_H_EFFECT)
  11)

(pub :: SEM_H_LET Int)
(pub fn (SEM_H_LET)
  12)

(pub :: SEM_H_LAMBDA Int)
(pub fn (SEM_H_LAMBDA)
  13)

(pub :: SEM_H_MUT Int)
(pub fn (SEM_H_MUT)
  14)

(pub :: SEM_H_SET Int)
(pub fn (SEM_H_SET)
  15)

(pub :: SEM_H_CAST Int)
(pub fn (SEM_H_CAST)
  16)

(pub :: SEM_H_REGION Int)
(pub fn (SEM_H_REGION)
  17)

(pub :: SEM_H_PARALLEL Int)
(pub fn (SEM_H_PARALLEL)
  18)

(pub :: SEM_H_HANDLE Int)
(pub fn (SEM_H_HANDLE)
  19)

(pub :: SEM_H_FOR Int)
(pub fn (SEM_H_FOR)
  20)

(pub :: SEM_H_SUBTYPE Int)
(pub fn (SEM_H_SUBTYPE)
  21)

; A `macro` of the `(macro (name params) template)` shape, once its
; header list has opened: the forms after it are the template, not
; rules. Set by `lspHlPush`, never by a word.
(pub :: SEM_H_MACHDR Int)
(pub fn (SEM_H_MACHDR)
  22)

; `(syntax/join a B)`: the parts of a name a template builds. They are
; read as plain words, whatever the form around the join expects of
; the name, as the tree-sitter queries read them.
(pub :: SEM_H_JOIN Int)
(pub fn (SEM_H_JOIN)
  23)

(pub :: SEM_H_AS Int)
(pub fn (SEM_H_AS)
  24)

; The contexts. EXPR is a body; TYPE is a type position, where an
; uppercase name is a type and a lowercase name a type variable;
; DATA is directly inside a `data`, so a nested form is a constructor
; (CTOR) whose own nested forms are types; IMPORT and IMPLIST are the
; module path and the imported-name list; the three HDR contexts are
; the header lists of `fn`, `macro` and `lambda`; FORHDR the `(x k)`
; of a `for`; LETLIST and LETPAIR the binding list of a `let` (or a
; `parallel`) and one pair in it; RULE a rule of a `macro`, MACPAT
; its pattern and MACPATIN a form nested in the pattern; EFFECTS the
; effect list of a `handle`.
(pub :: SEM_C_EXPR Int)
(pub fn (SEM_C_EXPR)
  0)

(pub :: SEM_C_TYPE Int)
(pub fn (SEM_C_TYPE)
  1)

(pub :: SEM_C_DATA Int)
(pub fn (SEM_C_DATA)
  2)

(pub :: SEM_C_CTOR Int)
(pub fn (SEM_C_CTOR)
  3)

(pub :: SEM_C_IMPORT Int)
(pub fn (SEM_C_IMPORT)
  4)

(pub :: SEM_C_IMPLIST Int)
(pub fn (SEM_C_IMPLIST)
  5)

(pub :: SEM_C_FNHDR Int)
(pub fn (SEM_C_FNHDR)
  6)

(pub :: SEM_C_MACHDR Int)
(pub fn (SEM_C_MACHDR)
  7)

(pub :: SEM_C_LAMHDR Int)
(pub fn (SEM_C_LAMHDR)
  8)

(pub :: SEM_C_FORHDR Int)
(pub fn (SEM_C_FORHDR)
  9)

(pub :: SEM_C_LETLIST Int)
(pub fn (SEM_C_LETLIST)
  10)

(pub :: SEM_C_LETPAIR Int)
(pub fn (SEM_C_LETPAIR)
  11)

(pub :: SEM_C_RULE Int)
(pub fn (SEM_C_RULE)
  12)

(pub :: SEM_C_MACPAT Int)
(pub fn (SEM_C_MACPAT)
  13)

(pub :: SEM_C_MACPATIN Int)
(pub fn (SEM_C_MACPATIN)
  14)

(pub :: SEM_C_EFFECTS Int)
(pub fn (SEM_C_EFFECTS)
  15)

; Whether `w` is one of the space-separated words in `set` -
; `lexicon.ax`'s `lexIn`, which is private to it.
(pub :: lspHlIn (-> String String Bool))
(pub fn (lspHlIn w set)
  {
    (let parts (strSplit set 32))
    (let mut hit false)
    {
      (for i in 0..(vecLen parts)
        (if (strEq (vecGet parts i) w)
          (set hit true)))
      hit
    }
  })

; The head code a word opens. The parser's own dispatch words, each
; by the shape it gives the rest of the form; every other keyword is
; SEM_H_KW, and a name is SEM_H_OTHER - a call, or a type application.
(pub :: lspHlHeadCode (-> LspHl String Int))
(pub fn (lspHlHeadCode st word)
  (match (lspAxqlArgIndex word)
    ((None) (lspHlLanguageHeadCode st word))
    ((Some index) (+ 25 index))))

; Head codes 25 and 26 mark the first and second argument as a query.
; The ordinary form stack counts arguments, so colouring needs no
; additional source scan for each string in a document.
(:: lspHlLanguageHeadCode (-> LspHl String Int))
(fn (lspHlLanguageHeadCode st word)
  (if (strEq word "import")
    SEM_H_IMPORT
    (if (strEq word "fn")
      SEM_H_FN
      (if (strEq word "data")
        SEM_H_DATA
        (if (strEq word "struct")
          SEM_H_STRUCT
          (if (strEq word "macro")
            SEM_H_MACRO
            (if (strEq word "type")
              SEM_H_TYPE
              (if (strEq word "subtype")
                SEM_H_SUBTYPE
                (if (strEq word "extern")
                  SEM_H_EXTERN
                  (if (strEq word "effect")
                    SEM_H_EFFECT
                    (lspHlHeadCodeMore st word)))))))))))

(pub :: lspHlHeadCodeMore (-> LspHl String Int))
(pub fn (lspHlHeadCodeMore st word)
  (if (strEq word "as")
    SEM_H_AS
    (if (strEq word "let")
      SEM_H_LET
      (if (strEq word "lambda")
        SEM_H_LAMBDA
        (if (strEq word "mut")
          SEM_H_MUT
          (if (strEq word "set")
            SEM_H_SET
            (if (lspHlIn word "cast sizeof alignof")
              SEM_H_CAST
              (if (strEq word "region")
                SEM_H_REGION
                (if (strEq word "parallel")
                  SEM_H_PARALLEL
                  (if (strEq word "handle")
                    SEM_H_HANDLE
                    (if (|| (strEq word "for") (strEq word "syntax/for"))
                      SEM_H_FOR
                      (if (strEq word "syntax/join")
                        SEM_H_JOIN
                        (if (lspHlIsKeyword st word SEM_C_EXPR)
                          SEM_H_KW
                          SEM_H_OTHER)))))))))))))

; The context a form's OWN identifiers take once its head is known:
; `import` names modules, `data` holds constructors, the type-shaped
; declarations hold types, and a `fn`'s or a `macro`'s items are
; expressions again. Anything else keeps what it inherited, which is
; what `(-> A B)` inside a `::` and `(Maybe Int)` inside a
; constructor need.
(pub :: lspHlOwnCtx (-> Int Int Int))
(pub fn (lspHlOwnCtx hc ctx)
  (if (== hc SEM_H_IMPORT)
    SEM_C_IMPORT
    (if (== hc SEM_H_DATA)
      SEM_C_DATA
      (if (|| (== hc SEM_H_STRUCT)
            (|| (== hc SEM_H_SIG)
              (|| (== hc SEM_H_TYPE)
                (|| (== hc SEM_H_SUBTYPE) (|| (== hc SEM_H_EXTERN) (== hc SEM_H_EFFECT))))))
        SEM_C_TYPE
        (if (|| (== hc SEM_H_FN) (|| (== hc SEM_H_MACRO) (== hc SEM_H_JOIN)))
          SEM_C_EXPR
          ctx)))))

; The context a form NESTED in one of context `pctx` inherits: the
; forms directly inside a `data` are constructors, whose own children
; are types; an `import`'s nested list names imports; a header list's
; children are expressions again (`(fn ((syntax/join tag T)) ...)`);
; a `let`'s list holds pairs, and a pair's children are its value; a
; form inside a macro pattern is more pattern.
(pub :: lspHlInherit (-> Int Int))
(pub fn (lspHlInherit pctx)
  (if (== pctx SEM_C_DATA)
    SEM_C_CTOR
    (if (== pctx SEM_C_CTOR)
      SEM_C_TYPE
      (if (== pctx SEM_C_IMPORT)
        SEM_C_IMPLIST
        (if (|| (== pctx SEM_C_FNHDR)
              (|| (== pctx SEM_C_MACHDR)
                (|| (== pctx SEM_C_LAMHDR) (|| (== pctx SEM_C_FORHDR) (== pctx SEM_C_LETPAIR)))))
          SEM_C_EXPR
          (if (== pctx SEM_C_LETLIST)
            SEM_C_LETPAIR
            (if (|| (== pctx SEM_C_MACPAT) (== pctx SEM_C_MACPATIN))
              SEM_C_MACPATIN
              pctx)))))))

; The context of a `(` opening as the k-th item after a head: the
; header list of a `fn`, `macro`, `lambda` or `for` and the binding
; list of a `let` are first; a `handle`'s effect list and a
; `parallel`'s binding list are second (the body and the region name
; come first); every later form inside a rules-shaped `macro` is a
; rule, whose first form is its pattern and whose rest is the
; template. Any other position inherits.
(pub :: lspHlChildCtx (-> Int Int Int Int Int))
(pub fn (lspHlChildCtx phc pstate pctx brace)
  (if (&& (== phc SEM_H_AS) (== pstate 2))
    SEM_C_TYPE
    (if (== brace 1)
      (lspHlInherit pctx)
      (if (== pctx SEM_C_RULE)
        (if (== pstate 0)
          SEM_C_MACPAT
          SEM_C_EXPR)
        (if (== pstate 1)
          (if (== phc SEM_H_FN)
            SEM_C_FNHDR
            (if (== phc SEM_H_MACRO)
              SEM_C_MACHDR
              (if (== phc SEM_H_LAMBDA)
                SEM_C_LAMHDR
                (if (== phc SEM_H_FOR)
                  SEM_C_FORHDR
                  (if (== phc SEM_H_LET)
                    SEM_C_LETLIST
                    (if (== phc SEM_H_CAST)
                      SEM_C_TYPE
                      (lspHlInherit pctx)))))))
          (if (== pstate 2)
            (if (== phc SEM_H_HANDLE)
              SEM_C_EFFECTS
              (if (== phc SEM_H_PARALLEL)
                SEM_C_LETLIST
                (if (== phc SEM_H_MACRO)
                  SEM_C_RULE
                  (lspHlInherit pctx))))
            (if (&& (== phc SEM_H_MACRO) (> pstate 2))
              SEM_C_RULE
              (lspHlInherit pctx))))))))

; Word `k` (0 head code, 1 state, 2 context) of the innermost open
; form; with nothing open, a bare top-level atom reads as past any
; head, in an expression.
(pub :: lspHlTopAt (-> LspHl Int Int))
(pub fn (lspHlTopAt st k)
  {
    (let stack st.stack)
    (let t (- (vecLen stack) 3))
    (if (< t 0)
      (if (== k 1)
        2
        0)
      (vecGet stack (+ t k)))
  })

; Open a form. The parent, if any, has now seen an item - a nested
; form in head position is a head that is not an identifier, which
; moves the parent past its first item; one after the head counts as
; the item it is. A brace block has no head: its identifiers are
; never in head position. A `macro` whose first item is a form is of
; the header shape, and is marked so its template is not read as
; rules.
(pub :: lspHlPush (-> LspHl Int Int))
(pub fn (lspHlPush st brace)
  {
    (let stack st.stack)
    (let t (- (vecLen stack) 3))
    {
      (let phc
        (if (>= t 0)
          (vecGet stack t)
          SEM_H_NONE))
      (let pstate
        (if (>= t 0)
          (vecGet stack (+ t 1))
          2))
      (let pctx
        (if (>= t 0)
          (vecGet stack (+ t 2))
          SEM_C_EXPR))
      {
        (let ctx (lspHlChildCtx phc pstate pctx brace))
        {
          (if (>= t 0)
            {
              (if (&& (== phc SEM_H_MACRO) (&& (== pstate 1) (== brace 0)))
                (vecSet stack t SEM_H_MACHDR))
              (vecSet stack (+ t 1)
                (if (== pstate 0)
                  2
                  (+ pstate 1)))
            })
          (vecPush stack SEM_H_NONE)
          (vecPush stack
            (if (== brace 1)
              2
              0))
          (vecPush stack ctx)
          0
        }
      }
    }
  })

; Close a form; an unbalanced closer closes nothing.
(pub :: lspHlPop (-> LspHl Int))
(pub fn (lspHlPop st)
  {
    (let stack st.stack)
    (if (>= (vecLen stack) 3)
      {
        (vecPop stack)
        (vecPop stack)
        (vecPop stack)
        0
      }
      0)
  })

; The head of the innermost form is now known: its code, the state
; past it, and the context it opens.
(pub :: lspHlSetHead (-> LspHl Int Int))
(pub fn (lspHlSetHead st hc)
  {
    (let stack st.stack)
    (let t (- (vecLen stack) 3))
    (if (< t 0)
      0
      {
        (vecSet stack t hc)
        (vecSet stack (+ t 1) 1)
        (vecSet stack (+ t 2) (lspHlOwnCtx hc (vecGet stack (+ t 2))))
        0
      })
  })

; An item has followed the head.
(pub :: lspHlNext (-> LspHl Int))
(pub fn (lspHlNext st)
  {
    (let stack st.stack)
    (let t (- (vecLen stack) 3))
    (if (if (>= t 0)
      (>= (vecGet stack (+ t 1)) 1)
      false)
      {
        (vecSet stack (+ t 1) (+ (vecGet stack (+ t 1)) 1))
        0
      }
      0)
  })

; ------------------------------------------------------------------
; The request state:
;
;   src       the document's text
;   ix        the line index
;   data      the `data` array
;   prevLine  previous token's line
;   prevCol   previous token's column
;   lastLine  the line of `lastOff`
;   lastOff   the last offset converted
;   lastCol   its UTF-16 column
;   removed   the removed keywords
;   stack     the form stack: head code, state and context per open form
;   occIndex  occurrence index, `None` when the document did not parse
;   binders   binder index, likewise
;   kinds     declaration kinds, likewise
;   keywords  the keyword list
;   len       the document length
;
; `lastLine`, `lastOff` and `lastCol` make the column conversion
; linear: a token's column is the previous token's on the same line
; plus the units between them, so a line of many tokens is walked once
; and not once per token.
; ------------------------------------------------------------------
(pub struct LspHl
  (src : String)
  (ix : Ints)
  (data : Int)
  (mut prevLine : Int)
  (mut prevCol : Int)
  (mut lastLine : Int)
  (mut lastOff : Int)
  (mut lastCol : Int)
  (removed : Strings)
  (stack : Ints)
  (occIndex : (Option LspOccBuckets))
  (binders : (Option LspOccBuckets))
  (kinds : (Option LspNodeBuckets))
  (keywords : Strings)
  (len : Int))

(pub :: lspHlState (-> String Ints (Vec ASTNode) LspHl))
(pub fn (lspHlState src ix decls)
  {
    (let parsed (!= (as decls Int) 0))
    (let occs
      (if parsed
        (lspNavOccurrences src decls)
        vecNew))
    (LspHl
      :src src
      :ix ix
      :data jsonArr
      :prevLine 0
      :prevCol 0
      :lastLine (- 0 1)
      :lastOff 0
      :lastCol 0
      :removed lspHlRemovedWords
      :stack vecNew
      :occIndex
        (if parsed
          (Some (lspHlOccIndex occs))
          None)
      :binders
        (if parsed
          (Some (lspHlBinderIndex occs))
          None)
      :kinds
        (if parsed
          (Some (lspHlKinds decls))
          None)
      :keywords lspKeywords
      :len (strLen src))
  })

; The words the parser names only to refuse (AX2004). Coloured as
; keywords, and `deprecated`, so the dead form reads as one bounded
; region rather than a call to nothing.
(pub :: lspHlRemovedWords Strings)
(pub fn (lspHlRemovedWords)
  {
    (let v vecNew)
    {
      (vecPush v "cast")
      (vecPush v "union")
      (vecPush v "foreign")
      (vecPush v "trait")
      (vecPush v "impl")
      (vecPush v "cond")
      (vecPush v "emacro")
      (vecPush v "begin")
      (vecPush v "alloc")
      (vecPush v "consume")
      (vecPush v "define")
      v
    }
  })

; ------------------------------------------------------------------
; `textDocument/semanticTokens/full`.
; ------------------------------------------------------------------
(pub :: lspSemanticTokens (-> String Int))
(pub fn (lspSemanticTokens src)
  {
    (let st (lspHlState src (lspLineIndex src) (lspNavParse src)))
    {
      (lspHlScan st)
      (jsonObjPut jsonObj "data" st.data)
    }
  })

; One full token array per document survives the arena reset. Edits keep
; it as the delta base; closing drops the array and keeps its serial only.
(pub :: lspHlCacheAt (-> Strings Int String))
(pub fn (lspHlCacheAt highlights i)
  (if (|| (< i 0) (>= i (vecLen highlights)))
    "{}"
    (vecGet highlights i)))

(pub :: lspHlCachePut (-> Strings Strings String String Int))
(pub fn (lspHlCachePut uris highlights uri result)
  {
    (let i (docFind uris uri))
    {
      (if (>= i 0)
        {
          (while (<= (vecLen highlights) i)
            (vecPush highlights "{}"))
          (vecSet highlights i result)
        })
      0
    }
  })

(pub :: lspHlForget (-> Strings Strings String Int))
(pub fn (lspHlForget uris highlights uri)
  {
    (let old (jsonParse (lspHlCacheAt highlights (docFind uris uri))))
    (lspHlCachePut uris highlights uri
      (jsonWrite (jsonObjPut jsonObj "resultId" (jsonGet old "resultId"))))
  })

(pub :: lspHlNextId (-> Strings Strings String String))
(pub fn (lspHlNextId uris highlights uri)
  {
    (let i (docFind uris uri))
    (let old (jsonParse (lspHlCacheAt highlights i)))
    {
      (let parts (strSplit (jsonGetStr old "resultId") 58))
      {
        (let serial
          (if (== (vecLen parts) 2)
            (if (let (Some n) (strParseInt (vecGet parts 1)))
              n
              0)
            0))
        (concat (fmtInt i) (concat ":" (fmtInt (+ serial 1))))
      }
    }
  })

; Serialise the token array once for both the wire and the retained cache.
(pub :: lspHlRemember (-> Strings Strings String String Int String))
(pub fn (lspHlRemember uris highlights uri resultId data)
  {
    (let encoded
      (jsonWrite (jsonObjPut (jsonObjPut jsonObj "resultId" (jsonStr resultId)) "data" data)))
    {
      (lspHlCachePut uris highlights uri encoded)
      encoded
    }
  })

(pub :: lspHlFull (-> Strings Strings String String String))
(pub fn (lspHlFull uris highlights uri src)
  {
    (let result (lspSemanticTokens src))
    (if (< (docFind uris uri) 0)
      (jsonWrite result)
      (lspHlRemember uris highlights uri (lspHlNextId uris highlights uri) (jsonGet result "data")))
  })

; One minimal contiguous edit of the encoded integers. Prefix and suffix
; need not end at token boundaries: the protocol edits array elements.
(pub :: lspHlEdits (-> Int Int Int))
(pub fn (lspHlEdits old next)
  {
    (let oldLen (jsonArrLen old))
    (let nextLen (jsonArrLen next))
    (let mut prefix 0)
    (let mut suffix 0)
    (let edits jsonArr)
    {
      (while (&& (< prefix oldLen)
               (&& (< prefix nextLen)
                 (== (jsonInt (jsonArrGet old prefix)) (jsonInt (jsonArrGet next prefix)))))
        (set prefix (+ prefix 1)))
      (while (&& (< suffix (- oldLen prefix))
               (&& (< suffix (- nextLen prefix))
                 (== (jsonInt (jsonArrGet old (- (- oldLen suffix) 1)))
                   (jsonInt (jsonArrGet next (- (- nextLen suffix) 1))))))
        (set suffix (+ suffix 1)))
      (if (|| (!= prefix oldLen) (!= prefix nextLen))
        {
          (let inserted jsonArr)
          {
            (for i in prefix..(- nextLen suffix)
              (jsonArrPush inserted (jsonArrGet next i)))
            (jsonArrPush edits
              (jsonObjPut
                (jsonObjPut (jsonObjPut jsonObj "start" (jsonNum prefix)) "deleteCount"
                  (jsonNum (- (- oldLen prefix) suffix)))
                "data" inserted))
          }
        })
      edits
    }
  })

(pub :: lspHlDelta (-> Strings Strings String String String String))
(pub fn (lspHlDelta uris highlights uri src previous)
  {
    (let old (jsonParse (lspHlCacheAt highlights (docFind uris uri))))
    (let result (lspSemanticTokens src))
    (if (< (docFind uris uri) 0)
      (jsonWrite result)
      {
        (let resultId (lspHlNextId uris highlights uri))
        (let data (jsonGet result "data"))
        {
          (let full (lspHlRemember uris highlights uri resultId data))
          (if (&& (!= (jsonGet old "data") 0) (strEq previous (jsonGetStr old "resultId")))
            (jsonWrite
              (jsonObjPut (jsonObjPut jsonObj "resultId" (jsonStr resultId)) "edits"
                (lspHlEdits (jsonGet old "data") data)))
            full)
        }
      })
  })

(pub :: lspHlLineEnd (-> String Int Int Int))
(pub fn (lspHlLineEnd src start end)
  {
    (let mut i start)
    {
      (while (&& (< i end) (&& (!= (strByte src i) 10) (!= (strByte src i) 13)))
        (set i (+ i 1)))
      i
    }
  })

; The result includes whole tokens that overlap the half-open range.
; Re-encoding starts from document origin, not from the range's start.
(pub :: lspHlRange (-> String Int Int))
(pub fn (lspHlRange src range)
  {
    (let ix (lspLineIndex src))
    (let start (lspSyncOffset src ix (jsonGet range "start")))
    (let end (lspSyncOffset src ix (jsonGet range "end")))
    (let out jsonArr)
    {
      (if (let (Some s) start)
        (if (let (Some e) end)
          (if (&& (> e s) (lspSyncRangeOrdered range))
            {
              (let sl (lspLineOfIx ix s))
              (let el (lspLineOfIx ix e))
              (let data (jsonGet (lspSemanticTokens src) "data"))
              {
                (let sc (lspCharFrom src (vecGet ix sl) s))
                (let ec (lspCharFrom src (vecGet ix el) e))
                (let mut i 0)
                (let mut line 0)
                (let mut column 0)
                (let mut previousLine 0)
                (let mut previousColumn 0)
                (while (< i (jsonArrLen data))
                  {
                    (let dl (jsonInt (jsonArrGet data i)))
                    (let dc (jsonInt (jsonArrGet data (+ i 1))))
                    (let length (jsonInt (jsonArrGet data (+ i 2))))
                    {
                      (set line (+ line dl))
                      (set column (if (== dl 0)
                        (+ column dc)
                        dc))
                      (if (&& (|| (> line sl) (&& (== line sl) (> (+ column length) sc)))
                            (|| (< line el) (&& (== line el) (< column ec))))
                        {
                          (jsonArrPush out (jsonNum (- line previousLine)))
                          (jsonArrPush out
                            (jsonNum
                              (if (== line previousLine)
                                (- column previousColumn)
                                column)))
                          (jsonArrPush out (jsonArrGet data (+ i 2)))
                          (jsonArrPush out (jsonArrGet data (+ i 3)))
                          (jsonArrPush out (jsonArrGet data (+ i 4)))
                          (set previousLine line)
                          (set previousColumn column)
                        })
                      (set i (+ i 5))
                    }
                  })
              }
            })))
      (jsonObjPut jsonObj "data" out)
    }
  })

; ------------------------------------------------------------------
; The indexes allocate each bucket when its first entry arrives.
; ------------------------------------------------------------------
(pub :: lspHlBuckets (-> Int (Vec (Option (Vec a)))))
(pub fn (lspHlBuckets count)
  (lspBucketsNew (fnIdxBuckets count)))

(pub :: lspHlBucketPut (-> (Vec (Option (Vec a))) Int a Int))
(pub fn (lspHlBucketPut bs slot v)
  {
    (vecPush (lspBucketFor bs slot) v)
    0
  })

; Occurrences by the byte their span starts at. Spans never overlap,
; so a start names one occurrence.
(pub :: lspHlOccIndex (-> (Vec LspOcc) LspOccBuckets))
(pub fn (lspHlOccIndex occs)
  {
    (let bs (lspHlBuckets (vecLen occs)))
    {
      (let nb (vecLen bs))
      {
        (for o in occs
          (if (!= o.span 0)
            (lspHlBucketPut bs (% (spanStart o.span) nb) o)))
        bs
      }
    }
  })

(pub :: lspHlOccAt (-> LspHl Int (Option LspOcc)))
(pub fn (lspHlOccAt st off)
  (if (let (Some bs) st.occIndex)
    (if (let (Some bucket) (vecGet bs (% off (vecLen bs))))
      {
        (let mut i 0)
        (let mut found None)
        (while (&& (< i (vecLen bucket)) (isNone found))
          {
            (let o (vecGet bucket i))
            (if (== (spanStart o.span) off)
              (set found (Some o)))
            (set i (+ i 1))
          })
        found
      }
      None)
    None))

; Binder occurrences by their key, so a READ of a local learns what
; kind of binder it refers to - the walk records the kind on the
; binder alone - without `lspNavBinderOf`'s scan per reference.
(pub :: lspHlBinderIndex (-> (Vec LspOcc) LspOccBuckets))
(pub fn (lspHlBinderIndex occs)
  {
    (let bs (lspHlBuckets (vecLen occs)))
    {
      (let nb (vecLen bs))
      {
        (for o in occs
          (if (== o.role NAV_BINDER)
            (lspHlBucketPut bs (% (fnIdxHash o.key) nb) o)))
        bs
      }
    }
  })

(pub :: lspHlBinderOf (-> LspHl String (Option LspOcc)))
(pub fn (lspHlBinderOf st key)
  (if (let (Some bs) st.binders)
    (if (let (Some bucket) (vecGet bs (% (fnIdxHash key) (vecLen bs))))
      {
        (let mut i 0)
        (let mut found None)
        (while (&& (< i (vecLen bucket)) (isNone found))
          {
            (let o (vecGet bucket i))
            (if (strEq o.key key)
              (set found (Some o)))
            (set i (+ i 1))
          })
        found
      }
      None)
    None))

; This document's declarations by name - the outline's kinds plus
; `type` aliases and `subtype`s, LAST WINS as `lspViewIdxFind`
; resolves it, and a `::` signature where nothing else spells the
; name - so a top-level key learns whether it is a `fn`, a type or a
; macro in one bucket rather than one walk of the declaration list
; per identifier.
(pub :: lspHlKinds (-> Nodes LspNodeBuckets))
(pub fn (lspHlKinds decls)
  {
    (let idx lspViewIdxNew)
    {
      (for d in decls
        (if (|| (lspNavIsNamedDecl d)
              (&& (== (nodeTag d) TAG_D_SIG)
                (&& (!= (nodeSpan d) 0) (isNone (lspViewIdxFind idx (nodeAName d))))))
          (lspViewIdxAdd idx (nodeAName d) d)))
      idx
    }
  })

; ------------------------------------------------------------------
; Emitting a token.
; ------------------------------------------------------------------
; One token over [s, e), which must not hold a line break. The column
; tracking advances with every token so the next one's conversion
; starts where this one ended.
;
; A trailing CR belongs to the line ending and is excluded.
(pub :: lspHlEmit (-> LspHl Int Int Int Int Int))
(pub fn (lspHlEmit st s e0 ty mods)
  {
    (let e (lspHlTrimCr st.src s e0))
    (if (<= e s)
      0
      {
        (let src st.src)
        (let ix st.ix)
        {
          (let ln (lspLineOfIx ix s))
          {
            (if (!= ln st.lastLine)
              {
                (set st.lastLine ln)
                (set st.lastOff (vecGet ix ln))
                (set st.lastCol 0)
              })
            {
              (let ch (+ st.lastCol (lspCharFrom src st.lastOff s)))
              {
                (let out st.data)
                (let dl (- ln st.prevLine))
                {
                  (set st.lastOff s)
                  (set st.lastCol ch)
                  (jsonArrPush out (jsonNum dl))
                  (jsonArrPush out
                    (jsonNum
                      (if (== dl 0)
                        (- ch st.prevCol)
                        ch)))
                  (jsonArrPush out (jsonNum (lspCharFrom src s e)))
                  (jsonArrPush out (jsonNum ty))
                  (jsonArrPush out (jsonNum mods))
                  (set st.prevLine ln)
                  (set st.prevCol ch)
                  0
                }
              }
            }
          }
        }
      })
  })

; The end of [s, e) with a trailing `\r` taken off. Only a token cut
; at a `\n` can end in one, so identifiers and numbers are untouched.
(pub :: lspHlTrimCr (-> String Int Int Int))
(pub fn (lspHlTrimCr src s e)
  (if (&& (> e s) (== (strByte src (- e 1)) 13))
    (- e 1)
    e))

; A token that may span lines - a string, a block comment - as one
; token per line, the empty pieces skipped.
(pub :: lspHlEmitLines (-> LspHl Int Int Int Int Int))
(pub fn (lspHlEmitLines st s e ty mods)
  {
    (let src st.src)
    (let mut k s)
    {
      (while (< k e)
        {
          (let nl (lspHlLineEnd src k e))
          {
            (lspHlEmit st k nl ty mods)
            (set k (+ nl 1))
            (if (&& (< k e) (&& (== (strByte src nl) 13) (== (strByte src k) 10)))
              (set k (+ k 1)))
          }
        })
      0
    }
  })

; A packed class, emitted.
(pub :: lspHlEmitPacked (-> LspHl Int Int Int Int))
(pub fn (lspHlEmitPacked st s e code)
  (lspHlEmit st s e (% code 128) (/ code 128)))

; ------------------------------------------------------------------
; The scan. `lspFormEnd`'s order, for its reason: an identifier is
; consumed whole before `'` is read as a char literal, and a `#` opens
; a block only as `#|`. A `-` against a digit is a negative literal,
; as `stepToken` lexes it, and is asked before the identifier rule
; that would otherwise take the `-`. A literal counts as an item of
; the form it sits in, so `(handle 0 (IO) h)` still finds its effect
; list second.
; ------------------------------------------------------------------
(pub :: lspHlScan (-> LspHl Int))
(pub fn (lspHlScan st)
  {
    (let src st.src)
    (let n st.len)
    (let mut i 0)
    {
      (while (< i n)
        {
          (let ch (strByte src i))
          (if (== ch 34)
            {
              (let e (skipStringBody src (+ i 1) n))
              {
                (lspHlString st i e)
                (lspHlNext st)
                (set i e)
              }
            }
            (if (== ch 59)
              {
                (let e (findNewline src i n))
                {
                  {
                    (let code (lspHlCommentClass src i n))
                    (lspHlEmitLines st i e (% code 128) (/ code 128))
                  }
                  (set i e)
                }
              }
              (if (&& (== ch 35) (isBlockOpen src i n))
                {
                  (let e (skipBlockComment src (+ i 2) n))
                  {
                    (lspHlEmitLines st i e SEM_COMMENT 0)
                    (set i e)
                  }
                }
                (if (&& (== ch 39) (lspHlCharOpens src i n))
                  {
                    (let e (skipCharBody src (+ i 1) n))
                    {
                      (lspHlEmitLines st i e SEM_STRING 0)
                      (lspHlNext st)
                      (set i e)
                    }
                  }
                  (if (lspHlIsNumberStart src i n)
                    {
                      (let e (lspHlNumberEnd src (+ i 1) n))
                      {
                        (lspHlEmit st i e SEM_NUMBER 0)
                        (lspHlNext st)
                        (set i e)
                      }
                    }
                    (if (isIdentStart ch)
                      (set i (lspHlIdent st i))
                      (if (== ch 58)
                        (set i (lspHlColon st i))
                        {
                          (if (== ch 40)
                            (lspHlPush st 0))
                          (if (== ch 123)
                            (lspHlPush st 1))
                          (if (|| (== ch 41) (== ch 125))
                            (lspHlPop st))
                          (set i (+ i 1))
                        })))))))
        })
      0
    }
  })

; Query tokens index the string's value. Without escapes that is the
; source between its quotes; escaped or unfinished strings keep the
; ordinary string colour rather than borrowing incorrect offsets.
(:: lspHlString (-> LspHl Int Int Int))
(fn (lspHlString st start end)
  {
    (let src st.src)
    (let head (lspHlTopAt st 0))
    (if (&& (&& (>= head 25) (<= head 26))
          (&& (== (lspHlTopAt st 1) (- head 24))
            (&& (> (- end start) 1)
              (&& (== (strByte src (- end 1)) 34) (! (lspAxqlLitEscaped src start end))))))
      {
        (let tokens (axqlTokens (strSlice src (+ start 1) (- (- end start) 2))))
        (let mut previous start)
        (for i in 0..(/ (vecLen tokens) 3)
          {
            (let from (+ (+ start 1) (vecGet tokens (* i 3))))
            (let to (+ (+ start 1) (vecGet tokens (+ (* i 3) 1))))
            (let kind (vecGet tokens (+ (* i 3) 2)))
            (lspHlEmitLines st previous from SEM_STRING 0)
            (lspHlEmitLines st from to (lspHlAxqlClass kind (strSlice src from (- to from))) 0)
            (set previous to)
          })
        (lspHlEmitLines st previous end SEM_STRING 0)
      }
      (lspHlEmitLines st start end SEM_STRING 0))
  })

(:: lspHlAxqlClass (-> Int String Int))
(fn (lspHlAxqlClass kind word)
  (if (== kind 1)
      SEM_KEYWORD
    (== kind 2)
      (if (> (strLen (lexAxqlDoc (lspAxqlUpper word))) 0)
          SEM_KEYWORD
        (> (strLen (lexAxqlFunctionDoc (strLower word))) 0)
          SEM_FUNCTION
        SEM_VARIABLE)
    (== kind 3)
      SEM_NUMBER
    (== kind 4)
      SEM_STRING
    (== kind 5)
      SEM_VARIABLE
    SEM_OPERATOR))

; A `;` line: `;@axiom:` opens an AXTAG, which `scanAxtags` reads as
; a claim about the declaration below it - a decorator, not a
; comment; `;;` and `;;!` are doc comments, the prose hover and
; `axiom doc` show; anything else is a note to the maintainer.
(pub :: lspHlCommentClass (-> String Int Int Int))
(pub fn (lspHlCommentClass src i n)
  (if (&& (<= (+ i 8) n) (strEq (strSlice src (+ i 1) 7) "@axiom:"))
    (lspHlPack SEM_DECORATOR 0)
    (if (&& (< (+ i 1) n) (== (strByte src (+ i 1)) 59))
      (lspHlPack SEM_COMMENT SEM_M_DOC)
      (lspHlPack SEM_COMMENT 0))))

; A `'` opens a char literal only where the lexer's `stepToken` says
; one begins: when the byte after it exists and is not a space, `(` or
; `[`. Any other `'` is a quote mark, which spells no token and falls
; through to the punctuation arm. Read as an opener, it would send
; the scan to the next `'` in the file or to EOF, and on the stray
; quote mark of a half-typed line every line between would be painted
; as a string.
(pub :: lspHlCharOpens (-> String Int Int Bool))
(pub fn (lspHlCharOpens src i n)
  (if (>= (+ i 1) n)
    false
    {
      (let b (strByte src (+ i 1)))
      (&& (!= b 32) (&& (!= b 40) (!= b 91)))
    }))

(pub :: lspHlIsNumberStart (-> String Int Int Bool))
(pub fn (lspHlIsNumberStart src i n)
  {
    (let ch (strByte src i))
    (if (isDigit ch)
      true
      (&& (== ch 45) (&& (< (+ i 1) n) (isDigit (strByte src (+ i 1))))))
  })

; One past a number that begins before `from`: digits and `_`
; separators, then `.digit` and more digits - `stepNumberFrom`'s rule,
; where `1..2` is two integers around a range.
(pub :: lspHlNumberEnd (-> String Int Int Int))
(pub fn (lspHlNumberEnd src from n)
  {
    (let ep (skipDigits src from n))
    (if (&& (< (+ ep 1) n) (&& (== (strByte src ep) 46) (isDigit (strByte src (+ ep 1)))))
      (skipDigits src (+ ep 1) n)
      ep)
  })

; A `::` in head position opens a signature; anywhere else on its own
; - an effect operation, an extern item - it is the operator it is.
; One between two identifiers is part of a qualified name and is
; consumed by `lspHlIdent`, never seen here. A single `:` is
; punctuation.
(pub :: lspHlColon (-> LspHl Int Int))
(pub fn (lspHlColon st i)
  {
    (let src st.src)
    (let n st.len)
    (if (if (< (+ i 1) n)
      (== (strByte src (+ i 1)) 58)
      false)
      {
        (if (== (lspHlTopAt st 1) 0)
          (lspHlSetHead st SEM_H_SIG)
          (lspHlNext st))
        (lspHlEmit st i (+ i 2) SEM_OPERATOR 0)
        (+ i 2)
      }
      (+ i 1))
  })

; One past the end of the qualified chain beginning at `i` - segments
; joined by `.` and `::`, as `lspNavQualSpan` reads them - or None when
; no `::` joins it, in which case the identifier at `i` stands alone
; and a `.` after it is a field access.
(pub :: lspHlChainEnd (-> String Int Int (Option Int)))
(pub fn (lspHlChainEnd src i n)
  (if (|| (< i 0) (|| (>= i n) (> n (strLen src))))
    None
    {
      (let mut c (skipIdent src (+ i 1) n))
      (let mut q 0)
      (let mut go 1)
      {
        (while (== go 1)
          (if (&& (< (+ c 2) n)
                (&& (== (strByte src c) 58)
                  (&& (== (strByte src (+ c 1)) 58) (isIdentStart (strByte src (+ c 2))))))
            {
              (set c (skipIdent src (+ c 3) n))
              (set q 1)
            }
            (if (&& (< (+ c 1) n) (&& (== (strByte src c) 46) (isIdentStart (strByte src (+ c 1)))))
              (set c (skipIdent src (+ c 2) n))
              (set go 0))))
        (if (== q 1)
          (Some c)
          None)
      }
    }))

; An identifier at `i`, or a qualified chain: every segment before the
; last is a namespace, and the last is classified as the one
; occurrence NAV recorded for the chain - under the last segment's
; span, which is where `lspNavQualSpan` puts it. A lone identifier
; followed by `.name` segments is a field access, each segment a
; property - or a dotted module path, each segment a namespace, under
; an `import`. Answers where the scan continues.
(pub :: lspHlIdent (-> LspHl Int Int))
(pub fn (lspHlIdent st i)
  {
    (let src st.src)
    (let n st.len)
    {
      (let e (skipIdent src (+ i 1) n))
      (let c (lspHlChainEnd src i n))
      (match c
        ((None)
          {
            (lspHlWord st i e)
            (lspHlDots st e)
          }
        )
        ((Some c)
          {
            (let mut s i)
            (let mut go 1)
            {
              (while (== go 1)
                {
                  (let se (skipIdent src (+ s 1) n))
                  (if (>= se c)
                    {
                      (lspHlWord st s se)
                      (set go 0)
                    }
                    {
                      (lspHlEmit st s se SEM_NAMESPACE 0)
                      (set s (if (== (strByte src se) 46)
                        (+ se 1)
                        (+ se 2)))
                    })
                })
              c
            }
          }
        ))
    }
  })

; The `.name` segments after an identifier ending at `e`, each a
; property (a field read) or, under an `import`, a namespace.
; Answers where the scan continues.
(pub :: lspHlDots (-> LspHl Int Int))
(pub fn (lspHlDots st e)
  {
    (let src st.src)
    (let n st.len)
    (let ty
      (if (== (lspHlTopAt st 2) SEM_C_IMPORT)
        SEM_NAMESPACE
        SEM_PROPERTY))
    (let mut k e)
    {
      (while (&& (< (+ k 1) n) (&& (== (strByte src k) 46) (isIdentStart (strByte src (+ k 1)))))
        {
          (let se (skipIdent src (+ k 2) n))
          {
            (lspHlEmit st (+ k 1) se ty 0)
            (set k se)
          }
        })
      k
    }
  })

; One identifier: classified in the form it sits in, and then the form
; moves on - a `pub` leaves the head still to come, any other head
; word opens its context, and an item after the head is counted.
(pub :: lspHlWord (-> LspHl Int Int Int))
(pub fn (lspHlWord st s e)
  {
    (let src st.src)
    (let state (lspHlTopAt st 1))
    {
      (let word (strSlice src s (- e s)))
      {
        (lspHlClassify st s e word (== state 0) (lspHlTopAt st 0) state (lspHlTopAt st 2))
        (if (== state 0)
          (if (! (strEq word "pub"))
            (lspHlSetHead st (lspHlHeadCode st word)))
          (lspHlNext st))
        0
      }
    }
  })

; The head keywords the parser dispatches on, plus the words it reads
; at the head of an inner form: `mut` before a binder or a field, the
; `cast`/`sizeof`/`alignof` family, the `syntax/*` query vocabulary
; and `decl` of a template, and `literals` inside a macro's rules.
(pub :: lspHlIsKeyword (-> LspHl String Int Bool))
(pub fn (lspHlIsKeyword st word ctx)
  (if (lspHlIn word "mut as cast sizeof alignof decl")
    true
    (if (strStartsWith word "syntax/")
      true
      (if (&& (== ctx SEM_C_RULE) (strEq word "literals"))
        true
        (== (strVecHas st.keywords word) 1)))))

; Spelled entirely of operator bytes: `+`, `==`, `>=`, `&&`, `->`.
; Asked before any lookup and in any position, because an operator
; passed as an argument is still an operator.
(pub :: lspHlIsOpWord (-> String Int Int Bool))
(pub fn (lspHlIsOpWord src s e)
  {
    (let mut i s)
    (let mut ok true)
    {
      (while (&& ok (< i e))
        {
          (if (! (lspHlIsOpByte (strByte src i)))
            (set ok false))
          (set i (+ i 1))
        })
      ok
    }
  })

(pub :: lspHlIsOpByte (-> Int Bool))
(pub fn (lspHlIsOpByte b)
  (|| (== b 43)
    (|| (== b 45)
      (|| (== b 42)
        (|| (== b 47)
          (|| (== b 37)
            (|| (== b 60)
              (|| (== b 62)
                (|| (== b 61)
                  (|| (== b 33) (|| (== b 38) (|| (== b 124) (|| (== b 94) (== b 126))))))))))))))

(pub :: lspHlIsUpper (-> Int Bool))
(pub fn (lspHlIsUpper b)
  (&& (>= b 65) (<= b 90)))

; In a type position: an uppercase name is a type, a builtin one from
; the library; a lowercase name is a type variable.
(pub :: lspHlTypeClass (-> String Int))
(pub fn (lspHlTypeClass word)
  (if (lspHlIsUpper (strByte word 0))
    (lspHlPack SEM_TYPE
      (if (strEq (lexKind word) "type")
        SEM_M_LIB
        0))
    (lspHlPack SEM_TYPEPARAM 0)))

; An effect name: a built-in one from the library.
(pub :: lspHlEffectClass (-> String Int Int))
(pub fn (lspHlEffectClass word mods)
  (lspHlPack SEM_EFFECT
    (+ mods
      (if (strEq (lexKind word) "effect")
        SEM_M_LIB
        0))))

(pub :: lspHlIsTypeCtx (-> Int Bool))
(pub fn (lspHlIsTypeCtx ctx)
  (|| (== ctx SEM_C_TYPE) (|| (== ctx SEM_C_CTOR) (== ctx SEM_C_DATA))))

; ------------------------------------------------------------------
; Classification, in the order the questions cost and decide:
;
;   1. `_` is nothing; `true`/`false` are library keywords; a word
;      the parser refuses at the head is a deprecated keyword, one it
;      dispatches on a keyword; `in`/`by` inside a `for` and
;      `is`/`range` inside a `subtype` are keywords off the head;
;   2. an operator spelling is an operator, from the library when the
;      checker's builtin table knows it;
;   3. the second item after `as`, or the first after `sizeof` or
;      `alignof`, is a type,
;      asked before the walk's record because the parser reads that
;      position as a variable and the walk records a read of it;
;   4. an identifier the walk recorded is what its key says;
;   5. everything else is read from the form around it.
; ------------------------------------------------------------------
; A single colon before a name labels a constructor field. Type positions
; keep their own colon syntax, and `Mod::name` remains a qualified name.
(pub :: lspHlLabelBefore (-> String Int Bool))
(pub fn (lspHlLabelBefore src start)
  {
    (let mut i (- start 1))
    {
      (while (&& (>= i 0) (docIsBlank (strByte src i)))
        (set i (- i 1)))
      (&& (>= i 0) (&& (== (strByte src i) 58) (|| (== i 0) (!= (strByte src (- i 1)) 58))))
    }
  })

(pub :: lspHlClassify (-> LspHl Int Int String Bool Int Int Int Int))
(pub fn (lspHlClassify st s e word head hc state ctx)
  (if (&& (! (lspHlIsTypeCtx ctx)) (lspHlLabelBefore st.src s))
    (lspHlEmit st s e SEM_PROPERTY 0)
    (if (&& (== hc SEM_H_LET) (&& (== state 1) (strEq word "mut")))
      (lspHlEmit st s e SEM_KEYWORD 0)
      (if (strEq word "_")
        0
        (if (|| (strEq word "true") (strEq word "false"))
          (lspHlEmit st s e SEM_KEYWORD SEM_M_LIB)
          (if (&& head (&& (lspHlFormHead ctx word) (== (strVecHas st.removed word) 1)))
            (lspHlEmit st s e SEM_KEYWORD SEM_M_DEPRECATED)
            (if (|| (&& head (&& (lspHlFormHead ctx word) (lspHlIsKeyword st word ctx)))
                  (|| (&& (== hc SEM_H_FOR) (lspHlIn word "in by"))
                    (&& (== hc SEM_H_SUBTYPE) (lspHlIn word "is range"))))
              (lspHlEmit st s e SEM_KEYWORD 0)
              (if (lspHlIsOpWord st.src s e)
                (lspHlEmit st s e SEM_OPERATOR
                  (if (isSome (lspShapeBuiltinRes word))
                    SEM_M_LIB
                    0))
                (if (|| (&& (== state 1) (== hc SEM_H_CAST)) (&& (== state 2) (== hc SEM_H_AS)))
                  (lspHlEmitPacked st s e (lspHlTypeClass word))
                  ; A `parallel`'s region name is a region, as a
                  ; `region`'s is, though the walk records it as a binding.
                  (if (&& (== state 1) (== hc SEM_H_PARALLEL))
                    (lspHlEmit st s e SEM_REGION 0)
                    (lspHlEmitPacked st s e
                      (if (let (Some o) (lspHlOccAt st s))
                        (lspHlOccClass st o word head ctx)
                        (lspHlFormClass st s e word head hc state ctx)))))))))))))

; Can a keyword stand at the head of a bracket in context `ctx`? Not
; where the head is a binder or a field: `(let ((for 5)) ...)` binds a
; variable named `for`, and `(struct S (consume : Int))` declares a
; field named `consume`, as the parser reads them. `mut` heads a
; binding or a field, and a `syntax/` word builds a name anywhere.
(pub :: lspHlFormHead (-> Int String Bool))
(pub fn (lspHlFormHead ctx word)
  (if (|| (strEq word "mut") (strStartsWith word "syntax/"))
    true
    (!
      (|| (== ctx SEM_C_LETPAIR)
        (|| (== ctx SEM_C_FNHDR)
          (|| (== ctx SEM_C_MACHDR)
            (|| (== ctx SEM_C_LAMHDR)
              (|| (== ctx SEM_C_FORHDR)
                (|| (== ctx SEM_C_MACPAT) (|| (== ctx SEM_C_MACPATIN) (== ctx SEM_C_TYPE)))))))))))

; What an occurrence's key says. A local is a parameter or a variable
; by its binder's kind, declared at its binder, modified at a `set`,
; readonly at the binder of a `let` that is not `mut`; a name this
; document does not declare is a type or a type variable in a type
; position (from the library when builtin), a constructor when
; uppercase in an expression, a function when called and a variable
; otherwise; an effect is an effect; a constructor key is an enum
; member; and a declaration's key answers by the kind of declaration
; it names.
(pub :: lspHlOccClass (-> LspHl LspOcc String Bool Int Int))
(pub fn (lspHlOccClass st o word head ctx)
  {
    (let key o.key)
    (let role o.role)
    {
      (let b0
        (if (> (strLen key) 0)
          (strByte key 0)
          0))
      (if (|| (== b0 64) (== b0 126))
        (lspHlLocalClass st o role key)
        (if (== b0 63)
          (if (lspHlIsTypeCtx ctx)
            (lspHlTypeClass word)
            (if (lspHlIsUpper (strByte word 0))
              (lspHlPack SEM_ENUM 0)
              (lspHlPack
                (if head
                  SEM_FUNCTION
                  SEM_VARIABLE)
                0)))
          (if (== b0 33)
            (lspHlEffectClass word 0)
            (if (if (let (Some _) (strFindByte key 35 0))
              true
              false)
              (lspHlPack SEM_ENUM
                (if (== role NAV_DECL)
                  SEM_M_DECL
                  0))
              (lspHlDeclClass st key role head ctx)))))
    }
  })

(pub :: lspHlLocalClass (-> LspHl LspOcc Int String Int))
(pub fn (lspHlLocalClass st o role key)
  {
    (let b
      (if (== role NAV_BINDER)
        (Some o)
        (lspHlBinderOf st key)))
    {
      (let bkind
        (if (let (Some bo) b)
          bo.bkind
          0))
      (lspHlPack
        (if (|| (== bkind NAV_B_PARAM) (== bkind NAV_B_LAMBDA))
          SEM_PARAMETER
          SEM_VARIABLE)
        (if (== role NAV_BINDER)
          (+ SEM_M_DECL
            (if (&& (== bkind NAV_B_LET) (lspNavNot (lspHlMutBefore st.src (lspHlBinderStart b))))
              SEM_M_READONLY
              0))
          (if (== role NAV_WRITE)
            SEM_M_MOD
            0)))
    }
  })

; Where binder `b` starts; 0 when there is none.
(:: lspHlBinderStart (-> (Option LspOcc) Int))
(fn (lspHlBinderStart b)
  (if (let (Some bo) b)
    (spanStart bo.span)
    0))

; Whether the binder at `s` is written `(mut name ...)`: the word
; before it, past blanks, is `mut` and nothing identifier-shaped
; precedes that. The tree's TAG_E_LET / TAG_E_LETM distinction is not
; on the occurrence, and the bytes carry it.
(pub :: lspHlMutBefore (-> String Int Bool))
(pub fn (lspHlMutBefore src s)
  {
    (let mut p (- s 1))
    {
      (while (if (>= p 0)
        (docIsBlank (strByte src p))
        false)
        (set p (- p 1)))
      (if (< p 2)
        false
        (if (&& (== (strByte src (- p 2)) 109)
              (&& (== (strByte src (- p 1)) 117) (== (strByte src p) 116)))
          (if (>= (- p 3) 0)
            (lspNavNot (isIdentChar (strByte src (- p 3))))
            true)
          false))
    }
  })

; A top-level key by the kind of declaration it names: a `fn` or its
; signature is a function, `definition` at the `fn` itself; a macro
; a macro; a type declaration a type, except at the head of an
; expression, where `(Point 1 2)` builds the struct and is coloured
; as the construction it is; a name the kinds index does not hold - a
; key nothing declares under that spelling - reads as a call or a
; variable by position. The declaration's own name carries
; `declaration`.
(pub :: lspHlDeclClass (-> LspHl String Int Bool Int Int))
(pub fn (lspHlDeclClass st key role head ctx)
  {
    (let d
      (if (let (Some kinds) st.kinds)
        (lspViewIdxFind kinds key)
        None))
    (let declm
      (if (|| (== role NAV_DECL) (== role NAV_DECL_SIG))
        SEM_M_DECL
        0))
    (if (let (Some d) d)
      {
        (let tag (nodeTag d))
        (if (|| (== tag TAG_D_FN) (== tag TAG_D_SIG))
          (lspHlPack SEM_FUNCTION
            (+ declm
              (if (&& (== tag TAG_D_FN) (== role NAV_DECL))
                SEM_M_DEFN
                0)))
          (if (== tag TAG_D_MACRO)
            (lspHlPack SEM_MACRO declm)
            (if (lspNavIsTypeTag tag)
              (lspHlPack
                (if (&& head (lspNavNot (lspHlIsTypeCtx ctx)))
                  SEM_ENUM
                  SEM_TYPE)
                declm)
              (lspHlPack
                (if head
                  SEM_FUNCTION
                  SEM_VARIABLE)
                declm))))
      }
      (lspHlPack
        (if (|| (== role NAV_DECL_SIG) head)
          SEM_FUNCTION
          SEM_VARIABLE)
        declm))
  })

; What the form says about an identifier the walk did not record.
; Import paths are namespaces and an import list names functions and
; types from elsewhere; a `handle`'s list names effects; a name
; before a single `:` is a field; the header lists declare their
; function, macro or parameters, a macro pattern its macro and its
; binders; the first item after `data`, `struct`, `type`, `subtype`,
; `macro`, `effect`, `::` or `fn` is the declared name, after
; `region` or `parallel` the region, after `mut` or `for` a binder,
; after `set` the written variable; a `let` pair's head is its
; binder, readonly; a constructor form's head is a constructor when
; uppercase and the type variable list when not; in a type, uppercase
; is a type and lowercase a type variable, except an operation or an
; extern item before a `::` and the `symbol` clause of an extern; and
; in an expression an uppercase name is a constructor, a lowercase
; head a call and the rest variables.
(pub :: lspHlFormClass (-> LspHl Int Int String Bool Int Int Int Int))
(pub fn (lspHlFormClass st s e word head hc state ctx)
  {
    (let src st.src)
    (if (== ctx SEM_C_IMPORT)
      (lspHlPack SEM_NAMESPACE 0)
      (if (== ctx SEM_C_IMPLIST)
        (lspHlPack
          (if (lspHlIsUpper (strByte word 0))
            SEM_TYPE
            SEM_FUNCTION)
          0)
        (if (== ctx SEM_C_EFFECTS)
          (lspHlEffectClass word 0)
          (if (&& (lspHlIsTypeCtx ctx) (lspNavColonAfter src (mkSpan s e)))
            (lspHlPack SEM_PROPERTY
              (if (lspHlIsTypeCtx ctx)
                SEM_M_DECL
                0))
            (if (== ctx SEM_C_FNHDR)
              (lspHlPack
                (if head
                  SEM_FUNCTION
                  SEM_PARAMETER)
                (if head
                  (+ SEM_M_DECL SEM_M_DEFN)
                  SEM_M_DECL))
              (if (|| (== ctx SEM_C_MACHDR) (== ctx SEM_C_MACPAT))
                (lspHlPack
                  (if head
                    SEM_MACRO
                    SEM_PARAMETER)
                  SEM_M_DECL)
                (if (|| (== ctx SEM_C_LAMHDR) (== ctx SEM_C_MACPATIN))
                  (lspHlPack SEM_PARAMETER SEM_M_DECL)
                  (if (== ctx SEM_C_FORHDR)
                    (lspHlPack SEM_VARIABLE SEM_M_DECL)
                    (lspHlFormClassMore src e word head hc state ctx)))))))))
  })

(pub :: lspHlFormClassMore (-> String Int String Bool Int Int Int Int))
(pub fn (lspHlFormClassMore src e word head hc state ctx)
  (if (&& (== hc SEM_H_LET)
        (|| (== state 1) (&& (== state 2) (lspHlMutBefore src (- e (strLen word))))))
    (lspHlPack SEM_VARIABLE
      (+ SEM_M_DECL
        (if (== state 1)
          SEM_M_READONLY
          0)))
    (if (&& (== ctx SEM_C_LETPAIR) head)
      (lspHlPack SEM_VARIABLE (+ SEM_M_DECL SEM_M_READONLY))
      (if (&& (== state 1) (|| (== hc SEM_H_MUT) (== hc SEM_H_FOR)))
        (lspHlPack SEM_VARIABLE SEM_M_DECL)
        (if (&& (== state 1) (== hc SEM_H_SET))
          (lspHlPack SEM_VARIABLE SEM_M_MOD)
          (if (&& (== state 1) (|| (== hc SEM_H_REGION) (== hc SEM_H_PARALLEL)))
            (lspHlPack SEM_REGION 0)
            (lspHlFormClassDecl src e word head hc state ctx)))))))

(pub :: lspHlFormClassDecl (-> String Int String Bool Int Int Int Int))
(pub fn (lspHlFormClassDecl src e word head hc state ctx)
  (if (&& (== state 1)
        (|| (== hc SEM_H_DATA)
          (|| (== hc SEM_H_STRUCT) (|| (== hc SEM_H_TYPE) (== hc SEM_H_SUBTYPE)))))
    (lspHlPack SEM_TYPE SEM_M_DECL)
    (if (&& (== state 1) (== hc SEM_H_EFFECT))
      (lspHlPack SEM_EFFECT SEM_M_DECL)
      (if (&& (== state 1) (== hc SEM_H_MACRO))
        (lspHlPack SEM_MACRO SEM_M_DECL)
        (if (&& (== state 1) (== hc SEM_H_SIG))
          (lspHlPack SEM_FUNCTION SEM_M_DECL)
          (if (&& (== state 1) (== hc SEM_H_FN))
            (lspHlPack SEM_FUNCTION (+ SEM_M_DECL SEM_M_DEFN))
            (if (== ctx SEM_C_CTOR)
              (if head
                (if (lspHlIsUpper (strByte word 0))
                  (lspHlPack SEM_ENUM SEM_M_DECL)
                  (lspHlPack SEM_TYPEPARAM 0))
                (lspHlTypeClass word))
              (if (lspHlIsTypeCtx ctx)
                (if (&& head (lspHlColonColonAt src e))
                  (lspHlPack SEM_FUNCTION SEM_M_DECL)
                  (if (&& head (strEq word "symbol"))
                    (lspHlPack SEM_PROPERTY 0)
                    (lspHlTypeClass word)))
                (if (lspHlIsUpper (strByte word 0))
                  (lspHlPack SEM_ENUM 0)
                  (lspHlPack
                    (if head
                      SEM_FUNCTION
                      SEM_VARIABLE)
                    0))))))))))

; Whether the first non-blank byte at or after `e` begins a `::` -
; what makes the head before it an effect operation or an extern
; item rather than a type.
(pub :: lspHlColonColonAt (-> String Int Bool))
(pub fn (lspHlColonColonAt src e)
  {
    (let n (strLen src))
    (let k (lspNavSkipBlank src e (strLen src)))
    (&& (< (+ k 1) n) (&& (== (strByte src k) 58) (== (strByte src (+ k 1)) 58)))
  })

; ==================================================================
; END SECTION HL
; ==================================================================
; ------------------------------------------------------------------
; The loop
; ------------------------------------------------------------------
; The event loop owns mutation and publication. A worker receives a
; process-isolated snapshot and returns bounded bytes; it never writes
; the client stream. Its revision must still be current at delivery.
(pub :: lspReplyBody (-> Int Int String))
(pub fn (lspReplyBody id result)
  (jsonWrite
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "id" id) "result"
      result)))

(pub :: lspReplyEncodedBody (-> Int String String))
(pub fn (lspReplyEncodedBody id result)
  (concat "{\"jsonrpc\":\"2.0\",\"id\":"
    (concat (jsonWrite id) (concat ",\"result\":" (concat result "}")))))

(pub :: lspErrorBody (-> Int Int String String))
(pub fn (lspErrorBody id code message)
  (jsonWrite
    (jsonObjPut (jsonObjPut (jsonObjPut jsonObj "jsonrpc" (jsonStr "2.0")) "id" id) "error"
      (jsonObjPut (jsonObjPut jsonObj "code" (jsonNum code)) "message" (jsonStr message)))))

(pub :: lspRequestBody
  (-> LspWorkspace String Int Int Strings Strings Strings Strings LspComplMode String))
;@axiom:effect(io)
(pub fn (lspRequestBody workspace method id params uris texts gens highlights mode)
  {
    (let uri (lspParamsUri params))
    (if (strEq method "completionItem/resolve")
      (lspComplResolveBody workspace id params uris texts mode.revision)
      (if (lspExtHandles method)
        (lspExtDispatch workspace method id params uris texts gens highlights)
        (match (docText uris texts uri)
          ((None)
            (if (strEq method "textDocument/documentSymbol")
              (lspReplyBody id jsonArr)
              (if (|| (strEq method "textDocument/definition") (strEq method "textDocument/hover"))
                (lspReplyBody id jsonNull)
                (if (strEq method "textDocument/completion")
                  (lspReplyBody id (lspCompletion workspace "" uri params mode))
                  (lspErrorBody id (- 0 32601) (concat "method not found: " method)))))
          )
          ((Some src)
            (if (strEq method "textDocument/documentSymbol")
              (lspReplyBody id (lspDocumentSymbols src))
              (if (strEq method "textDocument/definition")
                (lspReplyBody id (lspDefinition workspace src uri params (docGen uris gens uri)))
                (if (strEq method "textDocument/hover")
                  (lspReplyBody id (lspHover workspace src uri params (docGen uris gens uri)))
                  (if (strEq method "textDocument/completion")
                    (lspReplyBody id (lspCompletion workspace src uri params mode))
                    (lspErrorBody id (- 0 32601) (concat "method not found: " method))))))
          ))))
  })

(pub :: lspResultPack (-> String String String String String))
(pub fn (lspResultPack metadata response cached highlight)
  {
    (let parts vecNew)
    (let mut total 32)
    {
      (vecPush parts metadata)
      (vecPush parts response)
      (vecPush parts cached)
      (vecPush parts highlight)
      (for i in 0..4
        (set total (+ total (strLen (vecGet parts i)))))
      {
        (let out (strAlloc total))
        (let mut at 32)
        {
          (for i in 0..4
            {
              (let part (vecGet parts i))
              {
                (memSetWord (strData out) i (strLen part))
                (memCopy (+ (strData out) at) (strData part) (strLen part))
                (set at (+ at (strLen part)))
              }
            })
          out
        }
      }
    }
  })

; Validate lengths before constructing any slice of a worker packet.
(pub :: lspResultValid (-> String Bool))
(pub fn (lspResultValid text)
  (if (< (strLen text) 32)
    false
    {
      (let mut at 32)
      (let mut i 0)
      (let mut valid true)
      {
        (while (&& valid (< i 4))
          {
            (let length (memGetWord (strData text) i))
            {
              (if (|| (< length 0) (> length (- (strLen text) at)))
                (set valid false)
                (set at (+ at length)))
              (set i (+ i 1))
            }
          })
        (&& valid (== at (strLen text)))
      }
    }))

(pub :: lspResultPart (-> String Int String))
(pub fn (lspResultPart text index)
  {
    (let mut at 32)
    {
      (for i in 0..index
        (set at (+ at (memGetWord (strData text) i))))
      (strSlice text at (memGetWord (strData text) index))
    }
  })

(pub :: lspRequestPacket (-> LspStore Int String))
;@axiom:effect(io)
(pub fn (lspRequestPacket store msg)
  {
    (let uris store.uris)
    (let texts store.texts)
    (let gens store.gens)
    (let meta store.meta)
    (let highlights store.highlights)
    (let cache store.cache)
    (let method (jsonGetStr msg "method"))
    (let params (jsonGet msg "params"))
    (let id (jsonGet msg "id"))
    {
      (let workspace (lspWorkspaceNew uris texts meta))
      (let key (lspCacheKey store.generation method params))
      {
        (let cached (lspCacheFind cache key))
        {
          (let response
            (match cached
              ((None)
                (lspRequestBody workspace method id params uris texts gens highlights
                  (LspComplMode
                    :deferred store.completionDeferred
                    :uri (lspParamsUri params)
                    :revision store.generation))
              )
              ((Some hit) (lspReplyEncodedBody id hit))))
          {
            (let result
              (if (&& (> (strLen key) 0) (<= (strLen response) 262144))
                (jsonGet (jsonParse response) "result")
                0))
            (let uri (lspParamsUri params))
            (lspResultPack
              (jsonWrite
                (jsonObjPut
                  (jsonObjPut
                    (jsonObjPut
                      (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "request")) "cacheKey"
                        (jsonStr key))
                      "cacheHit"
                      (jsonBool
                        (if (isSome cached)
                          1
                          0)))
                    "hasHighlight"
                    (jsonBool
                      (if (lspHlHandles method)
                        1
                        0)))
                  "uri" (jsonStr uri)))
              response
              (if (&& (> (strLen key) 0) (&& (isNone cached) (!= result 0)))
                (lspCacheEntry workspace (jsonWrite result))
                "")
              (if (lspHlHandles method)
                (lspHlCacheAt highlights (docFind uris uri))
                ""))
          }
        }
      }
    }
  })

(pub :: lspAnalysisPacket (-> LspWorkspace LspStore String Bool String))
;@axiom:effect(io)
(pub fn (lspAnalysisPacket before store changedUri all)
  {
    (let uris store.uris)
    (let texts store.texts)
    (let gens store.gens)
    (let meta store.meta)
    (let out jsonArr)
    {
      (let workspace (lspWorkspaceNew uris texts meta))
      (let changed (lspUriToPath changedUri))
      {
        (for i in 0..(vecLen uris)
          (if (lspDocIsOpen meta i)
            {
              (let uri (vecGet uris i))
              (let src (vecGet texts i))
              {
                (let path (lspUriToPath uri))
                (if (|| all
                      (|| (strEq uri changedUri)
                        (|| (lspWorkspaceDepends before path src changed)
                          (lspWorkspaceDepends workspace path src changed))))
                  (jsonArrPush out
                    (jsonObjPut
                      (jsonObjPut
                        (jsonObjPut (jsonObjPut jsonObj "uri" (jsonStr uri)) "version"
                          (jsonNum (vecGet meta (* 2 i))))
                        "generated" (jsonStr (lspGenFill workspace path src)))
                      "diagnostics" (lspCheckDoc workspace path src))))
              }
            }))
        (lspResultPack
          (jsonWrite (jsonObjPut (jsonObjPut jsonObj "kind" (jsonStr "analysis")) "documents" out))
          "" "" "")
      }
    }
  })

; K cache strings, Q queued frames and J active-job strings cross the
; same arena boundary as the documents. The scalar worker handle and
; shared mapping live outside that arena and remain in the raw store.
(pub :: lspWorkState (-> LspStore Strings))
(pub fn (lspWorkState store)
  {
    (let out vecNew)
    {
      (for part in 0..3
        {
          (let v
            (if (== part 0)
              store.cache
              (if (== part 1)
                store.queue
                store.work)))
          {
            (vecPush out (fmtInt (vecLen v)))
            (for i in 0..(vecLen v)
              (vecPush out (vecGet v i)))
          }
        })
      out
    }
  })

(pub :: lspWorkPart (-> Strings Int Int Strings))
(pub fn (lspWorkPart state start count)
  {
    (let out vecNew)
    {
      (for i in 0..count
        (vecPush out (vecGet state (+ start i))))
      out
    }
  })

(pub :: lspRestoreWorkState (-> LspRestored Strings Int))
(pub fn (lspRestoreWorkState h state)
  {
    (let c
      (if (let (Some n) (strParseInt (vecGet state 0)))
        n
        0))
    {
      (let qi (+ c 1))
      {
        (let q
          (if (let (Some n) (strParseInt (vecGet state qi)))
            n
            0))
        {
          (let ji (+ (+ qi 1) q))
          {
            (let j
              (if (let (Some n) (strParseInt (vecGet state ji)))
                n
                0))
            {
              (set h.cache (lspWorkPart state 1 c))
              (set h.queue (lspWorkPart state (+ qi 1) q))
              (set h.work (lspWorkPart state (+ ji 1) j))
              0
            }
          }
        }
      }
    }
  })

; The server's state across messages. The documents (`uris`, `texts`,
; `gens`, `meta`, `highlights`), the request cache, the queue and the
; active job's strings cross each arena reset through `lspSnapshot`
; and are replaced from what `lspRestore` rebuilds. `generation` counts
; edits; `workHandle` and `workSlab` are the analysis worker's spawn
; word and shared mapping, 0 when idle, and `workGeneration` is the
; generation it started at. `running` is 1 until shutdown or end of
; input, `exitCode` the status `exit` answers, `draining` 1 once input
; has ended with work still queued, and `pollBuf` the buffer
; `sysChildExited` reads into.
(pub struct LspStore
  (mut uris : Strings)
  (mut texts : Strings)
  (mut gens : Strings)
  (mut meta : Ints)
  (mut highlights : Strings)
  (mut cache : Strings)
  (mut generation : Int)
  (mut trace : Int)
  (mut queue : Strings)
  (mut work : Strings)
  (mut workHandle : Int)
  (mut workSlab : Int)
  (mut workGeneration : Int)
  (mut polling : Int)
  (mut running : Int)
  (mut exitCode : Int)
  (pollBuf : Int)
  (mut draining : Int)
  (mut completionDeferred : Bool))

(pub :: lspStoreNew LspStore)
(pub fn (lspStoreNew)
  (LspStore
    :uris vecNew
    :texts vecNew
    :gens vecNew
    :meta vecNew
    :highlights vecNew
    :cache vecNew
    :generation 0
    :trace 0
    :queue vecNew
    :work vecNew
    :workHandle 0
    :workSlab 0
    :workGeneration 0
    :polling 0
    :running 1
    :exitCode 1
    :pollBuf (memAlloc sysChildPollBytes)
    :draining 0
    :completionDeferred false))

; Install what crossed an arena reset. The reset freed the vectors the
; store held, and that memory now holds the snapshot, so the words are
; overwritten raw: a typed `set` releases the old value first, which
; writes into whatever lives there now. The order is `LspStore`'s.
(:: lspStoreAdopt (-> LspStore LspRestored ()))
(fn (lspStoreAdopt store restored)
  {
    (let s (as store Int))
    (memSetWord s 0 restored.uris)
    (memSetWord s 1 restored.texts)
    (memSetWord s 2 restored.gens)
    (memSetWord s 3 restored.meta)
    (memSetWord s 4 restored.highlights)
    (memSetWord s 5 restored.cache)
    (memSetWord s 8 restored.queue)
    (memSetWord s 9 restored.work)
  })

(pub :: lspWorkLimit Int)
(pub fn (lspWorkLimit)
  67108864)

(pub :: lspWorkActive (-> LspStore Bool))
(pub fn (lspWorkActive store)
  (>= store.workHandle 65536))

(pub :: lspWorkHandle (-> Int Spawn))
;@axiom:effect(unsafe)
;@axiom:pre((>= word 65536))
(pub fn (lspWorkHandle word)
  (as word Spawn))

(struct LspWorkInput
  (slab : Int)
  (compute : (-> Int String)))

; The spawn retains its callback until join. This one callback lives
; below the session's arena mark. Its argument is only read in the
; child's private fork snapshot, so parent reclamation cannot touch it.
(pub :: lspWorkChild (-> Int Int))
;@axiom:effect(unsafe)
(pub fn (lspWorkChild word)
  {
    (let input (as word LspWorkInput))
    (lspWorkWrite input.slab (input.compute 0))
  })

(pub :: lspWorkSpawn (-> (-> Int Int) LspWorkInput Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
(pub fn (lspWorkSpawn worker input)
  (__axiom_recover __axiom_arena_mark
    (lambda (x)
      (as (__proc_spawn worker (as input Int)) Int)
    )))

(pub :: lspWorkWrite (-> Int String Int))
(pub fn (lspWorkWrite slab text)
  (if (> (strLen text) lspWorkLimit)
    {
      (memSetWord slab 0 (- 0 2))
      0
    }
    {
      (memCopy (+ slab 8) (strData text) (strLen text))
      (memSetWord slab 0 (strLen text))
      0
    }))

(pub :: lspWorkTrace (-> LspStore String Int))
;@axiom:effect(io)
(pub fn (lspWorkTrace store message)
  (if (== store.trace 1)
    (lspNotify "$/logTrace" (jsonObjPut jsonObj "message" (jsonStr message)))
    0))

(pub :: lspWorkFailure (-> LspStore String Int))
;@axiom:effect(io)
(pub fn (lspWorkFailure store message)
  {
    (let meta store.work)
    (if (&& (> (vecLen meta) 1) (strEq (vecGet meta 0) "request"))
      (lspError (jsonGet (jsonParse (vecGet meta 1)) "id") (- 0 32603) message)
      (lspNotify "window/showMessage"
        (jsonObjPut (jsonObjPut jsonObj "type" (jsonNum 1)) "message" (jsonStr message))))
  })

(pub :: lspWorkStop (-> LspStore Int String Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (lspWorkStop store code message)
  (if (! (lspWorkActive store))
    0
    {
      (let handle (lspWorkHandle store.workHandle))
      (let cell (memAlloc 8))
      (let meta store.work)
      {
        ; The unreaped handle still owns this pid. ESRCH can mean the
        ; child has already exited; joining it is still required.
        (match (sysKill (__spawn_pid handle) 9)
          ((Err e) 0)
          ((Ok ignored) 0))
        (__proc_join_nr handle cell)
        (unwrapOr (sysUnmapShared store.workSlab (+ lspWorkLimit 8)) 0)
        (set store.workHandle 0)
        (set store.workSlab 0)
        (if (&& (!= code 0) (&& (> (vecLen meta) 1) (strEq (vecGet meta 0) "request")))
          (lspError (jsonGet (jsonParse (vecGet meta 1)) "id") code message))
        (vecClear meta)
        0
      }
    }))

(pub :: lspWorkDeliver (-> LspStore String Int))
;@axiom:effect(io)
(pub fn (lspWorkDeliver store text)
  (if (! (lspResultValid text))
    (lspWorkFailure store "analysis worker returned an invalid packet")
    {
      (let packet (jsonParse (lspResultPart text 0)))
      (let meta store.work)
      (if (|| (== packet 0)
            (|| (== (vecLen meta) 0) (! (strEq (jsonGetStr packet "kind") (vecGet meta 0)))))
        (lspWorkFailure store "analysis worker returned an invalid result")
        (if (strEq (jsonGetStr packet "kind") "request")
          {
            {
              (let key (jsonGetStr packet "cacheKey"))
              {
                (lspCacheTrace store key
                  (if (!= (jsonBoolVal (jsonGet packet "cacheHit")) 0)
                    "hit"
                    ""))
                (lspCacheStore store.cache key (lspResultPart text 2))
              }
            }
            (if (!= (jsonBoolVal (jsonGet packet "hasHighlight")) 0)
              {
                (let index (docFind store.uris (jsonGetStr packet "uri")))
                (let highlights store.highlights)
                (if (>= index 0)
                  {
                    (while (<= (vecLen highlights) index)
                      (vecPush highlights ""))
                    (vecSet highlights index (lspResultPart text 3))
                  })
              })
            (rpcWrite stdout (lspResultPart text 1))
          }
          {
            (let documents (jsonGet packet "documents"))
            (let mut i 0)
            {
              (while (< i (jsonArrLen documents))
                {
                  (let document (jsonArrGet documents i))
                  {
                    (docPutGen store.uris store.gens (jsonGetStr document "uri")
                      (jsonGetStr document "generated"))
                    (lspPublishVersion (jsonGetStr document "uri") (jsonGetInt document "version")
                      (jsonGet document "diagnostics"))
                    (set i (+ i 1))
                  }
                })
              0
            }
          }))
    }))

(pub :: lspWorkStart (-> (-> Int Int) LspStore String String (-> Int String) Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (lspWorkStart worker store kind body compute)
  {
    (lspWorkStop store (- 0 32801) "document changed during the request")
    {
      (let meta store.work)
      {
        (vecClear meta)
        (vecPush meta kind)
        (vecPush meta body)
      }
    }
    (set store.workGeneration store.generation)
    (if (== store.polling 0)
      {
        (lspWorkDeliver store (compute 0))
        (vecClear store.work)
        0
      }
      (match (sysMapShared (+ lspWorkLimit 8))
        ((Err e) (lspWorkFailure store "could not allocate the analysis result buffer"))
        ((Ok slab)
          {
            (memSetWord slab 0 (- 0 1))
            {
              (let handle (lspWorkSpawn worker (LspWorkInput :slab slab :compute compute)))
              (if (>= handle 65536)
                {
                  (set store.workHandle handle)
                  (set store.workSlab slab)
                  (lspWorkTrace store
                    (if (strEq kind "analysis")
                      "background analysis started"
                      "background request started"))
                }
                {
                  (unwrapOr (sysUnmapShared slab (+ lspWorkLimit 8)) 0)
                  (lspWorkFailure store "could not start the analysis worker")
                })
            }
          }
        )))
    0
  })

(pub :: lspWorkPoll (-> LspStore Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (lspWorkPoll store)
  (if (! (lspWorkActive store))
    0
    {
      (let handle (lspWorkHandle store.workHandle))
      (match (sysChildExited (__spawn_pid handle) store.pollBuf)
        ((Err e) (lspWorkStop store (- 0 32603) "could not inspect the analysis worker"))
        ((Ok ended)
          (if (! ended)
            0
            {
              (let cell (memAlloc 8))
              (let slab store.workSlab)
              {
                (__proc_join_nr handle cell)
                (set store.workHandle 0)
                (if (== store.workGeneration store.generation)
                  {
                    (let length (memGetWord slab 0))
                    (if (&& (== (memGetWord cell 0) 0) (&& (>= length 0) (<= length lspWorkLimit)))
                      (lspWorkDeliver store (strDup (strWrap (+ slab 8) length)))
                      (lspWorkFailure store "analysis worker failed or exceeded its result limit"))
                  })
                (unwrapOr (sysUnmapShared slab (+ lspWorkLimit 8)) 0)
                (set store.workSlab 0)
                (vecClear store.work)
                0
              }
            })
        ))
    }))

(pub :: lspQueuePop (-> LspStore String))
(pub fn (lspQueuePop store)
  {
    (let queue store.queue)
    (let mut i 0)
    {
      (let body (strDup (vecGet queue 0)))
      {
        (while (< (+ i 1) (vecLen queue))
          {
            (vecSet queue i (vecGet queue (+ i 1)))
            (set i (+ i 1))
          })
        (vecPop queue)
        body
      }
    }
  })

(pub :: lspCancelWork (-> LspStore Int Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (lspCancelWork store id)
  {
    (let key (jsonWrite id))
    (let queue store.queue)
    (let next vecNew)
    (let meta store.work)
    {
      (if (&& (lspWorkActive store)
            (&& (> (vecLen meta) 1)
              (&& (strEq (vecGet meta 0) "request")
                (strEq key (jsonWrite (jsonGet (jsonParse (vecGet meta 1)) "id"))))))
        (lspWorkStop store (- 0 32800) "request cancelled by client"))
      (for i in 0..(vecLen queue)
        {
          (let body (vecGet queue i))
          {
            (let requestId (jsonGet (jsonParse body) "id"))
            (if (&& (!= requestId 0) (strEq key (jsonWrite requestId)))
              (lspError requestId (- 0 32800) "request cancelled by client")
              (vecPush next body))
          }
        })
      (set store.queue next)
      0
    }
  })

(pub :: lspHandleMessage (-> (-> Int Int) LspStore String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (lspHandleMessage worker store body)
  {
    (let msg (jsonParse body))
    (let uris store.uris)
    (let texts store.texts)
    (let gens store.gens)
    (let meta store.meta)
    (let highlights store.highlights)
    (let all (&& (lspWorkActive store) (strEq (vecGet store.work 0) "analysis")))
    (let mut handled false)
    {
      (let method (jsonGetStr msg "method"))
      (let id (jsonGet msg "id"))
      (let params (jsonGet msg "params"))
      (let before (lspWorkspaceNew uris texts meta))
      {
        (if (strEq method "initialize")
          {
            (lspTraceSet store (jsonObjPut jsonObj "value" (jsonGet params "trace")))
            (set store.completionDeferred (lspComplCanResolve params))
            (lspReply id (lspCapabilities store.completionDeferred))
            (set handled true)
          })
        (if (strEq method "initialized")
          (set handled true))
        (if (strEq method "$/setTrace")
          {
            (lspTraceSet store params)
            (set handled true)
          })
        (if (strEq method "shutdown")
          {
            (set store.exitCode 0)
            (lspReply id jsonNull)
            (set handled true)
          })
        (if (strEq method "exit")
          {
            (set store.running 0)
            (set handled true)
          })
        (if (strEq method "textDocument/didOpen")
          {
            (if (lspDocOpen uris texts meta params)
              {
                (lspCacheInvalidate store)
                (lspWorkStart worker store "analysis" ""
                  (lambda (x) (lspAnalysisPacket before store (lspParamsUri params) all)))
              })
            (set handled true)
          })
        (if (strEq method "textDocument/didChange")
          {
            (if (lspDocChange uris texts meta params)
              {
                (lspCacheInvalidate store)
                (lspWorkStart worker store "analysis" ""
                  (lambda (x) (lspAnalysisPacket before store (lspParamsUri params) all)))
              })
            (set handled true)
          })
        (if (strEq method "textDocument/didClose")
          {
            (if (lspDocClose uris texts gens meta (lspParamsUri params))
              {
                (lspCacheInvalidate store)
                (lspWorkStop store (- 0 32801) "document closed during the request")
                (lspHlForget uris highlights (lspParamsUri params))
                (lspPublish (lspParamsUri params) jsonArr)
                (lspWorkStart worker store "analysis" ""
                  (lambda (x) (lspAnalysisPacket before store (lspParamsUri params) all)))
              })
            (set handled true)
          })
        (if (|| (strEq method "textDocument/didSave")
              (strEq method "workspace/didChangeWatchedFiles"))
          {
            (lspCacheInvalidate store)
            (lspWorkStart worker store "analysis" ""
              (lambda (x) (lspAnalysisPacket before store "" true)))
            (set handled true)
          })
        (if (&& (! handled) (!= id 0))
          (lspWorkStart worker store "request" body (lambda (x) (lspRequestPacket store msg))))
        0
      }
    }
  })

(pub :: lspMutation (-> String Bool))
(pub fn (lspMutation method)
  (|| (strEq method "textDocument/didOpen")
    (|| (strEq method "textDocument/didChange")
      (|| (strEq method "textDocument/didClose")
        (|| (strEq method "textDocument/didSave")
          (strEq method "workspace/didChangeWatchedFiles"))))))

(pub :: lspShutdownWork (-> LspStore Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (lspShutdownWork store)
  {
    (let queue store.queue)
    {
      (lspWorkStop store (- 0 32800) "server is shutting down")
      (for i in 0..(vecLen queue)
        {
          (let id (jsonGet (jsonParse (vecGet queue i)) "id"))
          (if (!= id 0)
            (lspError id (- 0 32800) "server is shutting down"))
        })
      (vecClear queue)
      0
    }
  })

; Queue a message behind the active worker. A queued `didOpen` or
; `didChange` for a document is replaced by the next one for the same
; document: only the newest text can produce diagnostics anyone should
; see, and checking every intermediate version in order was the cost a
; burst of typing paid whenever a request was in flight. A queued
; `didClose` drops the document's queued changes. Requests are never
; replaced, and nothing is reordered.
(pub :: lspQueuePush (-> Strings String String String Int))
(pub fn (lspQueuePush queue body method uri)
  {
    (let mut i 0)
    (let mut placed false)
    {
      (if (strEq method "textDocument/didClose")
        {
          (let kept vecNew)
          {
            (while (< i (vecLen queue))
              {
                (let queued (jsonParse (vecGet queue i)))
                (if (&& (lspMutation (jsonGetStr queued "method"))
                      (strEq (lspParamsUri (jsonGet queued "params")) uri))
                  0
                  (vecPush kept (vecGet queue i)))
                (set i (+ i 1))
              })
            (vecClear queue)
            (set i 0)
            (while (< i (vecLen kept))
              {
                (vecPush queue (vecGet kept i))
                (set i (+ i 1))
              })
          }
        })
      (if (|| (strEq method "textDocument/didChange") (strEq method "textDocument/didOpen"))
        {
          (set i 0)
          (while (&& (! placed) (< i (vecLen queue)))
            {
              (let queued (jsonParse (vecGet queue i)))
              (if (&& (strEq (jsonGetStr queued "method") method)
                    (strEq (lspParamsUri (jsonGet queued "params")) uri))
                {
                  (vecSet queue i body)
                  (set placed true)
                }
                (set i (+ i 1)))
            })
        })
      (if placed
        0
        {
          (vecPush queue body)
          0
        })
    }
  })

(pub :: lspAcceptMessage (-> (-> Int Int) LspStore String Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (lspAcceptMessage worker store body)
  {
    (let msg (jsonParse body))
    (if (== msg 0)
      0
      {
        (let method (jsonGetStr msg "method"))
        (let queue store.queue)
        (if (strEq method "exit")
          (lspHandleMessage worker store body)
          (if (== store.exitCode 0)
            {
              (let id (jsonGet msg "id"))
              (if (!= id 0)
                (lspError id (- 0 32600) "server has shut down")
                0)
            }
            (if (strEq method "shutdown")
              {
                (lspShutdownWork store)
                (lspHandleMessage worker store body)
              }
              (if (strEq method "$/cancelRequest")
                (lspCancelWork store (jsonGet (jsonGet msg "params") "id"))
                (if (&& (lspWorkActive store) (! (&& (== (vecLen queue) 0) (lspMutation method))))
                  (lspQueuePush queue body method (lspParamsUri (jsonGet msg "params")))
                  (lspHandleMessage worker store body))))))
      })
  })

(pub :: lspQueueRoom (-> Strings Bool))
(pub fn (lspQueueRoom queue)
  {
    (let mut bytes 0)
    {
      (for i in 0..(vecLen queue)
        (set bytes (+ bytes (strLen (vecGet queue i)))))
      (&& (< (vecLen queue) 32) (< bytes 8388608))
    }
  })

(pub :: lspPollInput (-> Poller LspStore Bool))
;@axiom:effect(io)
(pub fn (lspPollInput poller store)
  (match (pollerWait poller (- 0 1))
    ((Err e)
      {
        (set store.running 0)
        false
      }
    )
    ((Ok n)
      {
        (let mut input false)
        (let mut i 0)
        {
          (while (< i n)
            {
              (if (== (pollerToken poller i) 1)
                (set input true)
                {
                  (let _ (pollerSignal poller i))
                  0
                })
              (set i (+ i 1))
            })
          input
        }
      }
    )))

(pub :: lspInputReady (-> (Option Poller) Int LspStore Bool))
;@axiom:effect(io)
(pub fn (lspInputReady polling r store)
  (if (> (- (rdFilled r) (rdConsumed r)) 0)
    true
    (if (let (Some poller) polling)
      (lspPollInput poller store)
      true)))

; Backpressure keeps queued frames bounded. Remove stdin while waiting
; for the worker so a full pipe cannot turn this wait into a busy loop.
(pub :: lspWaitWorker (-> (Option Poller) LspStore Int))
;@axiom:effect(io)
;@axiom:effect(block)
(pub fn (lspWaitWorker polling store)
  (if (let (Some poller) polling)
    {
      (match (pollerRemove poller stdin)
        ((Err e)
          (set store.running 0)
        )
        ((Ok ignored)
          {
            (lspPollInput poller store)
            (match (pollerAdd poller stdin 1)
              ((Err e)
                (set store.running 0)
              )
              ((Ok added) 0))
          }
        ))
      0
    }
    (unwrapOr (sysSleepNanos 25000000) 0)))

(pub :: lspServe (-> (Option Poller) Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
;@axiom:effect(unsafe)
(pub fn (lspServe polling)
  {
    (let worker lspWorkChild)
    (let mut r (rdNew stdin))
    (let store lspStoreNew)
    (let m __axiom_arena_mark)
    {
      (set store.polling (if (isSome polling)
        1
        0))
      (while (== store.running 1)
        {
          {
            (let queue store.queue)
            (if (&& (! (lspWorkActive store)) (> (vecLen queue) 0))
              (lspHandleMessage worker store (lspQueuePop store))
              (if (== store.draining 1)
                (if (> (vecLen queue) 0)
                  (lspWaitWorker polling store)
                  (set store.running 0))
                (if (lspQueueRoom queue)
                  (if (lspInputReady polling r store)
                    (if (let (Some body) (rpcRead r))
                      (lspAcceptMessage worker store body)
                      (if (> (vecLen queue) 0)
                        (set store.draining 1)
                        (set store.running 0))))
                  (lspWaitWorker polling store))))
          }
          (lspWorkPoll store)
          {
            (let snapshot
              (lspSnapshot store.uris store.texts store.gens store.meta store.highlights
                (lspWorkState store) r))
            {
              (let kept (__axiom_arena_reset_keeping m snapshot (memGetWord snapshot 0)))
              {
                (let restored (lspRestore kept))
                {
                  (lspStoreAdopt store restored)
                  (set r restored.reader)
                }
              }
            }
          }
        })
      (lspShutdownWork store)
      (sysExitWith store.exitCode)
      0
    }
  })

(pub :: lspMain Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(pub fn (lspMain)
  (if (== sigChild 0)
    (lspServe None)
    (match (pollerNew 2)
      ((Err e) (lspServe None))
      ((Ok poller)
        (match (pollerAdd poller stdin 1)
          ((Err e) (lspServe None))
          ((Ok ignored)
            {
              (let mask (sysSigBit sigChild))
              (match (sysSignalBlock mask (memAlloc 16))
                ((Err e) (lspServe None))
                ((Ok blocked)
                  (match (pollerAddSignals poller mask 2)
                    ((Err e) (lspServe None))
                    ((Ok watched) (lspServe (Some poller))))
                ))
            }
          ))
      ))))
