; Rust-owned bytes copied into an Axiom `Str`.
;
; `strAlloc` reserves len+1 and zeroes it, so the NUL terminator
; MM-FFI-4 requires is already there and `strCStr` stays free. The
; copy is the price of never letting Rust author a block header.
(pub :: ffiSliceToStr (-> Int Int String))
(pub fn (ffiSliceToStr p n)
