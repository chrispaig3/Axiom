; GENERATED by axiom-bindgen from the `axiom_demo` crate. Do not edit.
;
; One `extern` BLOCK is one unit of enumeration: MM-FFI-5's fourth
; requirement is a gate that enumerates permitted external symbols,
; and this block is what `scripts/check-ffi.sh` enumerates.
;
; Every `(symbol ...)` clause is written explicitly, never defaulted.
; A static link is one flat namespace, and two crates that each bind
; a `parse` and omit the clause would dedup to one `declare`, resolve
; both Axiom names to it, and pick a link-time winner with no
; diagnostic at any stage.
; 
; A shim that returns BYTES or that can FAIL needs two words back,
; and Axiom emits `ret i64` for everything. So those shims take a
; trailing OUT-CELL and their raw binding carries a `Raw` suffix;
; the ergonomic name is an Axiom wrapper below that allocates the
; cell, calls, decodes and frees. There is no `Slice` type and no
; `Outcome` type - they are a protocol over ordinary words, and
; the half that decodes it is Axiom, never Rust. That is the rule
; the whole design rests on: only Axiom's own emitter writes an
; Axiom heap block, because only it knows MM-LIFE-2d's shape word.

(import Mem)
(import Str)
(import Err)

(pub extern "axiom_demo"
  (abiProbe :: Int (symbol "axffi_abi_probe"))
  (add :: (-> Int Int Int) (symbol "axffi_add"))
  (countVowels :: (-> String Int) (symbol "axffi_count_vowels"))
  (counterClose :: (-> Foreign Int) (symbol "axffi_counter_close"))
  (counterNew :: (-> Int Foreign) (symbol "axffi_counter_new"))
  (counterValue :: (-> Foreign Int) (symbol "axffi_counter_value"))
  (hypot :: (-> Float Float Float) (symbol "axffi_hypot"))
  (parseIntRaw :: (-> String Int Int) (symbol "axffi_parse_int"))
  (shoutRaw :: (-> String Int Int) (symbol "axffi_shout"))
  (sum3 :: (-> Int Int Int Int) (symbol "axffi_sum3"))
  (sum5 :: (-> Int Int Int Int Int Int) (symbol "axffi_sum5"))
  (ffiFreeBytes :: (-> Int Int Int) (symbol "axffi_free_bytes")))

; Rust-owned bytes copied into an Axiom `Str`.
;
; `strAlloc` reserves len+1 and zeroes it, so the NUL terminator
; MM-FFI-4 requires is already there and `strCStr` stays free. The
; copy is the price of never letting Rust author a block header.
(pub :: ffiSliceToStr (-> Int Int String))
(pub fn (ffiSliceToStr p n)
  (if (<= n 0)
      ""
      (let ((s (strAlloc n)))
        { (memCopy (strData s) p n) s })))

(pub :: parseInt (-> String (Result Int String)))
(pub fn (parseInt text)
  (let ((cell (memAlloc 16)))
    (let ((st (parseIntRaw text cell)))
      (let ((p (cast Int (memGetWord cell 0)))
            (n (cast Int (memGetWord cell 1))))
        (if (== st 0)
            (Ok p)
            (let ((m (ffiSliceToStr p n)))
              { (ffiFreeBytes p n) (Err m) }))))))

(pub :: shout (-> String String))
(pub fn (shout text)
  (let ((cell (memAlloc 16)))
    (let ((st (shoutRaw text cell)))
      (let ((p (cast Int (memGetWord cell 0)))
            (n (cast Int (memGetWord cell 1))))
        (let ((v (ffiSliceToStr p n)))
          { (ffiFreeBytes p n) v })))))
