{
  "name": "axiom-language",
  "displayName": "Axiom",
  "description": "Axiom language support: highlighting, diagnostics, hover, completion and the other language-server features.",
  "version": "0.8.0",
  "publisher": "axiom-lang",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/chrispaig3/axiom#readme",
  "bugs": {
    "url": "https://github.com/chrispaig3/axiom/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chrispaig3/axiom"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "axiom",
    "ax",
    "language",
    "lsp",
    "functional",
    "systems"
  ],
  "galleryBanner": {
    "color": "#0b0d0c",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:axiom",
    "onLanguage:axql",
    "workspaceContains:**/*.ax",
    "workspaceContains:**/*.axql",
    "workspaceContains:**/*.db",
    "workspaceContains:**/axiom.pkg",
    "onView:axiomDatabases"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axiom",
        "aliases": [
          "Axiom",
          "axiom"
        ],
        "extensions": [
          ".ax"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/axiom.svg",
          "dark": "./icons/axiom.svg"
        }
      },
      {
        "id": "axql",
        "aliases": [
          "AXQL",
          "axql"
        ],
        "extensions": [
          ".axql"
        ],
        "icon": {
          "light": "./icons/database.svg",
          "dark": "./icons/database.svg"
        }
      },
      {
        "id": "axqlite-db",
        "aliases": [
          "AXQLite database"
        ],
        "extensions": [
          ".db",
          ".axqlite"
        ],
        "icon": {
          "light": "./icons/database.svg",
          "dark": "./icons/database.svg"
        }
      },
      {
        "id": "axiom-package",
        "aliases": [
          "Axiom package manifest"
        ],
        "filenames": [
          "axiom.pkg",
          "axiom.axiom.pkg"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/package.svg",
          "dark": "./icons/package.svg"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "axiom-file-icons",
        "label": "Axiom file icons",
        "path": "./icons/file-icon-theme.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "axiomDatabases",
          "name": "Axiom databases",
          "icon": "./icons/database.svg",
          "contextualTitle": "Axiom databases"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "axiom.axqliteViewer",
        "displayName": "AXQLite browser",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.axqlite"
          }
        ],
        "priority": "option"
      }
    ],
    "grammars": [
      {
        "language": "axiom",
        "scopeName": "source.axiom",
        "path": "./syntaxes/axiom.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Axiom",
      "properties": {
        "axiom.serverPath": {
          "type": "string",
          "default": "axiom",
          "description": "The axiom executable. The extension runs it as `axiom lsp`. A bare name is looked up on PATH; otherwise give the absolute path."
        },
        "axiom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the Axiom language server in the Axiom output channel."
        }
      }
    },
    "commands": [
      {
        "command": "axiom.run",
        "title": "Axiom: Run file",
        "icon": "$(play)"
      },
      {
        "command": "axiom.expandMacro",
        "title": "Axiom: Expand macro at cursor",
        "icon": "$(symbol-method)"
      },
      {
        "command": "axiom.doc",
        "title": "Axiom: Open the documentation",
        "icon": "$(book)"
      },
      {
        "command": "axiom.restartServer",
        "title": "Axiom: Restart the language server",
        "icon": "$(refresh)"
      },
      {
        "command": "axiom.browseDatabase",
        "title": "Axiom: Browse AXQLite database",
        "icon": "./icons/database.svg"
      },
      {
        "command": "axiom.refreshDatabases",
        "title": "Axiom: Refresh databases",
        "icon": "$(refresh)"
      },
      {
        "command": "axiom.openDatabaseSummary",
        "title": "Axiom: Open database summary",
        "icon": "$(file-text)"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "effect",
        "superType": "type",
        "description": "An effect name: a builtin such as IO or Alloc, or one declared with (effect ...)."
      },
      {
        "id": "region",
        "superType": "namespace",
        "description": "A lexical region or scoped parallel task name."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "axiom",
        "scopes": {
          "namespace": [
            "entity.name.namespace.axiom"
          ],
          "type": [
            "entity.name.type.axiom"
          ],
          "type.declaration": [
            "entity.name.type.axiom"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.axiom"
          ],
          "typeParameter": [
            "entity.name.type.parameter.axiom"
          ],
          "parameter": [
            "variable.parameter.axiom"
          ],
          "variable": [
            "variable.other.axiom"
          ],
          "variable.readonly": [
            "variable.other.readonly.axiom"
          ],
          "variable.defaultLibrary": [
            "support.variable.axiom"
          ],
          "property": [
            "variable.other.property.axiom"
          ],
          "enumMember": [
            "entity.name.type.constructor.axiom"
          ],
          "function": [
            "entity.name.function.call.axiom"
          ],
          "function.declaration": [
            "entity.name.function.axiom"
          ],
          "function.defaultLibrary": [
            "support.function.axiom"
          ],
          "function.deprecated": [
            "invalid.deprecated.axiom"
          ],
          "macro": [
            "entity.name.function.macro.axiom"
          ],
          "macro.declaration": [
            "entity.name.function.macro.axiom"
          ],
          "keyword": [
            "keyword.control.axiom"
          ],
          "keyword.defaultLibrary": [
            "constant.language.axiom"
          ],
          "keyword.deprecated": [
            "invalid.deprecated.axiom"
          ],
          "comment": [
            "comment.line.semicolon.axiom"
          ],
          "comment.documentation": [
            "comment.block.documentation.axiom"
          ],
          "string": [
            "string.quoted.double.axiom"
          ],
          "number": [
            "constant.numeric.axiom"
          ],
          "operator": [
            "keyword.operator.axiom"
          ],
          "decorator": [
            "entity.other.attribute-name.axiom"
          ],
          "effect": [
            "entity.name.type.effect.axiom",
            "storage.modifier.axiom"
          ],
          "effect.defaultLibrary": [
            "support.type.effect.axiom",
            "storage.modifier.axiom"
          ],
          "region": [
            "entity.name.label.axiom"
          ]
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "axiom.run",
          "when": "editorLangId == axiom",
          "group": "navigation"
        },
        {
          "command": "axiom.expandMacro",
          "when": "editorLangId == axiom",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "axiom.run",
          "when": "editorLangId == axiom",
          "group": "axiom"
        },
        {
          "command": "axiom.expandMacro",
          "when": "editorLangId == axiom",
          "group": "axiom"
        }
      ],
      "explorer/context": [
        {
          "command": "axiom.run",
          "when": "resourceExtname == .ax",
          "group": "axiom"
        },
        {
          "command": "axiom.browseDatabase",
          "when": "resourceExtname == .db || resourceExtname == .axqlite || resourceExtname == .axql",
          "group": "axiom"
        }
      ],
      "view/title": [
        {
          "command": "axiom.refreshDatabases",
          "when": "view == axiomDatabases",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "axiom.openDatabaseSummary",
          "when": "view == axiomDatabases && viewItem == axiomDatabase",
          "group": "axiom"
        },
        {
          "command": "axiom.openDatabaseSummary",
          "when": "view == axiomDatabases && viewItem == axiomTable",
          "group": "axiom"
        }
      ],
      "commandPalette": [
        {
          "command": "axiom.run",
          "when": "editorLangId == axiom"
        },
        {
          "command": "axiom.expandMacro",
          "when": "editorLangId == axiom"
        }
      ]
    },
    "snippets": [
      {
        "language": "axiom",
        "path": "./snippets/axiom.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "check": "node --check extension.js && node --check axqlite.js && node scripts/axqlite-smoke.mjs && node scripts/client-smoke.mjs && node scripts/route-b-smoke.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
