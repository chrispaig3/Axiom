{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Axiom",
  "scopeName": "source.axiom",
  "comment": "Colours by syntactic role, the way tree-sitter-axiom/queries/highlights.scm does. Every form opens a `form` region, so a head rule anchored at \\G sees the word right after `(`. The two keyword alternations are written by scripts/sync-keywords.mjs from core/parser.ax and core/lsp.ax; scripts/check-vscode.sh holds them to those files.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#float"
    },
    {
      "include": "#integer"
    },
    {
      "include": "#form"
    },
    {
      "include": "#block"
    },
    {
      "include": "#list"
    },
    {
      "include": "#try-operator"
    },
    {
      "include": "#words"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#comment-block"
        },
        {
          "include": "#contract"
        },
        {
          "include": "#axtag"
        },
        {
          "include": "#comment-doc"
        },
        {
          "include": "#comment-line"
        }
      ]
    },
    "comment-block": {
      "name": "comment.block.axiom",
      "begin": "#\\|",
      "end": "\\|#",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "axtag": {
      "name": "meta.annotation.axiom",
      "match": "(;@axiom:)([A-Za-z0-9_-]+)(?:(\\()([^)]*)(\\)))?(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.annotation.axiom"
        },
        "2": {
          "name": "entity.other.attribute-name.axiom"
        },
        "3": {
          "name": "punctuation.section.parens.begin.axiom"
        },
        "4": {
          "name": "string.other.axtag.axiom"
        },
        "5": {
          "name": "punctuation.section.parens.end.axiom"
        },
        "6": {
          "name": "comment.line.semicolon.axiom"
        }
      }
    },
    "comment-doc": {
      "name": "comment.block.documentation.axiom",
      "match": "(;;!?)(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.axiom"
        }
      }
    },
    "comment-line": {
      "name": "comment.line.semicolon.axiom",
      "match": "(;)(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.axiom"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.axiom",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.axiom"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.axiom",
          "match": "\\\\[ntr\\\\'\"0]"
        },
        {
          "name": "constant.character.escape.brace.axiom",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "variable.other.interpolation.axiom",
          "match": "(\\{)([A-Za-z_][A-Za-z0-9_'.]*)(?:(:)([^}\"]*))?(\\})",
          "captures": {
            "1": {
              "name": "punctuation.definition.interpolation.begin.axiom"
            },
            "3": {
              "name": "punctuation.separator.format.axiom"
            },
            "4": {
              "name": "constant.other.format-spec.axiom"
            },
            "5": {
              "name": "punctuation.definition.interpolation.end.axiom"
            }
          }
        }
      ]
    },
    "char": {
      "name": "constant.character.axiom",
      "match": "(?<![A-Za-z0-9_])'(?:\\\\[ntr\\\\'\"0]|[^'\\\\]|')'"
    },
    "float": {
      "name": "constant.numeric.float.axiom",
      "match": "(?<![A-Za-z0-9_'])-?[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?(?![A-Za-z0-9_])"
    },
    "integer": {
      "name": "constant.numeric.integer.axiom",
      "match": "(?<![A-Za-z0-9_'])-?[0-9][0-9_]*(?![A-Za-z0-9_])"
    },
    "form": {
      "name": "meta.form.axiom",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "#head"
        },
        {
          "include": "$self"
        }
      ]
    },
    "block": {
      "name": "meta.block.axiom",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "list": {
      "name": "meta.list.axiom",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "head": {
      "comment": "The word right after `(`, by role. Anchored at \\G so none of these fires on an argument.",
      "patterns": [
        {
          "include": "#decl-function"
        },
        {
          "include": "#decl-signature"
        },
        {
          "include": "#decl-macro-head"
        },
        {
          "include": "#decl-macro"
        },
        {
          "include": "#decl-type"
        },
        {
          "include": "#decl-effect"
        },
        {
          "include": "#decl-import"
        },
        {
          "include": "#parallel-bindings"
        },
        {
          "include": "#region-binder"
        },
        {
          "include": "#lambda-params"
        },
        {
          "include": "#local-discard-binding"
        },
        {
          "include": "#local-binding"
        },
        {
          "include": "#for-binder"
        },
        {
          "include": "#keyword-removed"
        },
        {
          "include": "#keyword-head"
        },
        {
          "include": "#modifier-head"
        },
        {
          "include": "#syntax-builtin"
        },
        {
          "include": "#named-constructor-head"
        },
        {
          "include": "#field-head"
        },
        {
          "include": "#operation-head"
        },
        {
          "include": "#builtin-type"
        },
        {
          "include": "#builtin-effect"
        },
        {
          "include": "#arrow-head"
        },
        {
          "include": "#operator-head"
        },
        {
          "include": "#qualified-head"
        },
        {
          "include": "#constructor-head"
        },
        {
          "include": "#wildcard"
        },
        {
          "include": "#call-head"
        }
      ]
    },
    "decl-function": {
      "comment": "`(fn (name params...) body)`: the parameter list is consumed so its `)` can't end the form.",
      "name": "meta.function.head.axiom",
      "begin": "\\G\\s*(?:(pub)\\s+)?(fn)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+(\\()\\s*([A-Za-z0-9_'!*+/<>=%&|^-]+)",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        },
        "3": {
          "name": "punctuation.section.parens.begin.axiom"
        },
        "4": {
          "name": "entity.name.function.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameter"
        },
        {
          "include": "$self"
        }
      ]
    },
    "decl-signature": {
      "match": "\\G\\s*(?:(pub)\\s+)?(::)\\s+([A-Za-z0-9_'!*+/<>=%&|^-]+)(?![.:])",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.operator.type.axiom"
        },
        "3": {
          "name": "entity.name.function.axiom"
        }
      }
    },
    "decl-macro-head": {
      "comment": "`(macro (name params...) body)`, the template form.",
      "name": "meta.macro.head.axiom",
      "begin": "\\G\\s*(?:(pub)\\s+)?(macro)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+(\\()\\s*([A-Za-z0-9_'!*+/<>=%&|^-]+)",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        },
        "3": {
          "name": "punctuation.section.parens.begin.axiom"
        },
        "4": {
          "name": "entity.name.function.macro.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameter"
        },
        {
          "include": "$self"
        }
      ]
    },
    "decl-macro": {
      "comment": "`(macro name rule...)`, the rule form.",
      "match": "\\G\\s*(?:(pub)\\s+)?(macro)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+([A-Za-z0-9_'!*+/<>=%&|^-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        },
        "3": {
          "name": "entity.name.function.macro.axiom"
        }
      }
    },
    "decl-type": {
      "match": "\\G\\s*(?:(pub)\\s+)?(data|struct|type|subtype)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+([A-Za-z0-9_'!*+/<>=%&|^-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        },
        "3": {
          "name": "entity.name.type.axiom"
        }
      }
    },
    "decl-effect": {
      "comment": "`(effect Name op...)` declares; `(effect IO)` in a type names a builtin, which the builtin-effect rule colours.",
      "match": "\\G\\s*(?:(pub)\\s+)?(effect)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+(?!(?:IO|Alloc|Mut|Unsafe|Spawn|Block|Entropy|Div|Pure)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-]))([A-Za-z0-9_'!*+/<>=%&|^-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        },
        "3": {
          "name": "entity.name.type.effect.axiom"
        }
      }
    },
    "decl-import": {
      "match": "\\G\\s*(?:(pub)\\s+)?(import)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+([A-Za-z_][A-Za-z0-9_'.]*)",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        },
        "3": {
          "name": "entity.name.namespace.axiom"
        }
      }
    },
    "region-binder": {
      "match": "\\G\\s*(region|parallel)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+([a-z_][A-Za-z0-9_']*)",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "entity.name.label.axiom"
        }
      }
    },
    "for-binder": {
      "match": "\\G\\s*(for)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+([a-z_][A-Za-z0-9_']*)(?=\\s+in\\s)",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "variable.other.axiom"
        }
      }
    },
    "keyword-removed": {
      "comment": "Written by scripts/sync-keywords.mjs: the head keywords the parser only names to refuse (AX2004).",
      "match": "\\G\\s*(?:(pub)\\s+)?(alloc|begin|cast|cond|consume|define|emacro|foreign|impl|trait|union)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "invalid.deprecated.axiom"
        }
      }
    },
    "keyword-head": {
      "comment": "Written by scripts/sync-keywords.mjs: every head keyword core/parser.ax dispatches on and core/lsp.ax offers, less the removed ones above.",
      "match": "\\G\\s*(?:(pub)\\s+)?(as|asm|data|effect|extern|fn|for|handle|if|import|lambda|let|macro|match|parallel|pub|region|set|struct|subtype|syntax/for|type|while)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.control.axiom"
        }
      }
    },
    "modifier-head": {
      "match": "\\G\\s*(as|sizeof|alignof|mut|literals)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "keyword.other.axiom"
        }
      }
    },
    "syntax-builtin": {
      "match": "\\G\\s*(syntax/join|syntax/binders|syntax/constructors|syntax/arity|syntax/fields|decl)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "support.function.builtin.axiom"
        }
      }
    },
    "field-head": {
      "comment": "`(x : Int)` and `(mut x : Int)`: a struct field, not a call.",
      "match": "\\G\\s*(?:(mut)\\s+)?([A-Za-z0-9_'!*+/<>=%&|^-]+)(?=\\s*:(?!:))",
      "captures": {
        "1": {
          "name": "keyword.other.axiom"
        },
        "2": {
          "name": "variable.other.property.axiom"
        }
      }
    },
    "operation-head": {
      "comment": "`(name :: Type)`: an effect operation or an extern item.",
      "match": "\\G\\s*([A-Za-z0-9_'!*+/<>=%&|^-]+)(?=\\s+::\\s)",
      "captures": {
        "1": {
          "name": "entity.name.function.axiom"
        }
      }
    },
    "operator-head": {
      "match": "\\G\\s*(\\|>|<<|>>|<=|>=|==|!=|&&|\\|\\||[-+*/%&|^<>!])(?=\\s|\\))",
      "captures": {
        "1": {
          "name": "keyword.operator.axiom"
        }
      }
    },
    "qualified-head": {
      "match": "\\G\\s*([A-Za-z_][A-Za-z0-9_'.]*)(::)([A-Za-z0-9_'!*+/<>=%&|^-]+)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.axiom"
        },
        "2": {
          "name": "keyword.operator.type.axiom"
        },
        "3": {
          "name": "entity.name.function.call.axiom"
        }
      }
    },
    "constructor-head": {
      "match": "\\G\\s*([A-Z][A-Za-z0-9_']*)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "entity.name.type.constructor.axiom"
        }
      }
    },
    "call-head": {
      "match": "\\G\\s*([A-Za-z_][A-Za-z0-9_'!*+/<>=%&|^-]*|[-+*/%<>=!&|^][A-Za-z0-9_'!*+/<>=%&|^-]*)(?![.:])",
      "captures": {
        "1": {
          "name": "entity.name.function.call.axiom"
        }
      }
    },
    "words": {
      "comment": "Words in any position.",
      "patterns": [
        {
          "include": "#constructor-label"
        },
        {
          "include": "#field-access"
        },
        {
          "include": "#builtin-type"
        },
        {
          "include": "#builtin-effect"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#wildcard"
        },
        {
          "include": "#qualified"
        },
        {
          "include": "#field"
        },
        {
          "include": "#separator"
        },
        {
          "include": "#type-operator"
        },
        {
          "include": "#inner-keyword"
        },
        {
          "include": "#capitalised"
        }
      ]
    },
    "builtin-type": {
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])(Int|Int8|Int16|Int32|UInt8|UInt16|UInt32|UInt64|Float|Bool|Char|String|Foreign|Handle|Spawn|Addr|Vec|Link|Option|Result)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "support.type.builtin.axiom"
        }
      }
    },
    "builtin-effect": {
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])(IO|Alloc|Mut|Unsafe|Spawn|Block|Entropy|Div|Pure)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "support.type.effect.axiom"
        }
      }
    },
    "constant": {
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])(true|false)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "constant.language.axiom"
        }
      }
    },
    "wildcard": {
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])_(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "name": "variable.language.wildcard.axiom"
    },
    "qualified": {
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])([A-Za-z_][A-Za-z0-9_'.]*)(::)(?=[A-Za-z0-9_'!*+/<>=%&|^-])",
      "captures": {
        "1": {
          "name": "entity.name.namespace.axiom"
        },
        "2": {
          "name": "keyword.operator.type.axiom"
        }
      }
    },
    "field": {
      "comment": "`{ r : Float }` in a constructor declaration.",
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])([a-z_][A-Za-z0-9_']*)(?=\\s*(?::(?!:)|=(?!=)))",
      "captures": {
        "1": {
          "name": "variable.other.property.axiom"
        }
      }
    },
    "type-operator": {
      "patterns": [
        {
          "match": "(?<![:])::(?![:])",
          "name": "keyword.operator.type.axiom"
        },
        {
          "match": "(?<=[\\s(])->(?=[\\s)])",
          "name": "keyword.operator.type.axiom"
        },
        {
          "match": "(?<![.])\\.\\.\\.(?![.])",
          "name": "keyword.operator.ellipsis.axiom"
        },
        {
          "match": "(?<![.])\\.\\.-?(?![.])",
          "name": "keyword.operator.range.axiom"
        }
      ]
    },
    "inner-keyword": {
      "comment": "`in` and `by` in a `for`, `is` and `range` in a `subtype`.",
      "match": "(?<=\\s)(in|by|is|range)(?=\\s)",
      "captures": {
        "1": {
          "name": "keyword.other.axiom"
        }
      }
    },
    "capitalised": {
      "comment": "A capitalised word off the head is a type in a signature or a nullary constructor; both share a colour in every theme.",
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])([A-Z][A-Za-z0-9_']*)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "entity.name.type.axiom"
        }
      }
    },
    "arrow-head": {
      "match": "\\G\\s*(->)(?=\\s|\\))",
      "captures": {
        "1": {
          "name": "keyword.operator.type.axiom"
        }
      }
    },
    "parameter": {
      "match": "(?<![A-Za-z0-9_'!*+/<>=%&|^.@-])(?!_(?![A-Za-z0-9_'!*+/<>=%&|^-]))([a-z_][A-Za-z0-9_'!*+/<>=%&|^-]*)(?![.:])",
      "captures": {
        "1": {
          "name": "variable.parameter.axiom"
        }
      }
    },
    "lambda-params": {
      "comment": "`(lambda (params...) body)`: the parameter list is consumed so its `)` can't end the form.",
      "name": "meta.lambda.head.axiom",
      "begin": "\\G\\s*(lambda)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "punctuation.section.parens.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameter"
        },
        {
          "include": "$self"
        }
      ]
    },
    "parallel-bindings": {
      "comment": "`(parallel r ((a e1) (b e2)) body)`: the region is a label and each binding's name a variable.",
      "name": "meta.parallel.bindings.axiom",
      "begin": "\\G\\s*(parallel)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+([a-z_][A-Za-z0-9_']*)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "entity.name.label.axiom"
        },
        "3": {
          "name": "punctuation.section.parens.begin.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parallel-binding"
        }
      ]
    },
    "field-access": {
      "comment": "`p.x`: a field read off what the `.` touches.",
      "match": "(?<=[A-Za-z0-9_')])(\\.)([A-Za-z_][A-Za-z0-9_']*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.axiom"
        },
        "2": {
          "name": "variable.other.property.axiom"
        }
      }
    },
    "separator": {
      "comment": "`:` between a field and its type, and `,` between elements.",
      "patterns": [
        {
          "match": "(?<!:):(?!:)",
          "name": "punctuation.separator.colon.axiom"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.axiom"
        },
        {
          "match": "(?<![-+*/%<>=!&|^~A-Za-z0-9_'])=(?![-+*/%<>=!&|^~A-Za-z0-9_'])",
          "name": "keyword.operator.assignment.axiom"
        }
      ]
    },
    "try-operator": {
      "comment": "`?`, the postfix that propagates an error.",
      "match": "\\?",
      "name": "keyword.operator.propagate.axiom"
    },
    "contract": {
      "name": "meta.annotation.contract.axiom",
      "begin": "(;@axiom:)(pre|post)(\\()",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.annotation.axiom"
        },
        "2": {
          "name": "entity.other.attribute-name.axiom"
        },
        "3": {
          "name": "punctuation.section.parens.begin.axiom"
        }
      },
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#char"
        },
        {
          "include": "#float"
        },
        {
          "include": "#integer"
        },
        {
          "include": "#form"
        },
        {
          "include": "#list"
        },
        {
          "include": "#words"
        }
      ]
    },
    "local-binding": {
      "comment": "`(let name value)` and `(let mut name value)` bind a local in the enclosing block.",
      "match": "\\G\\s*(let)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+(?:(mut)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+)?([A-Za-z_][A-Za-z0-9_\\'!*+/<>=%&|^-]*)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.other.axiom"
        },
        "3": {
          "name": "variable.other.axiom"
        }
      }
    },
    "constructor-label": {
      "comment": "`:field value` labels a struct constructor argument; it is a property, not a variable use.",
      "match": "(?<![:A-Za-z0-9_'!*+/<>=%&|^.@-])(:)([A-Za-z_][A-Za-z0-9_']*)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "punctuation.separator.colon.axiom"
        },
        "2": {
          "name": "variable.other.property.axiom"
        }
      }
    },
    "named-constructor-head": {
      "comment": "A constructor followed by colon labels must not be mistaken for a field declaration.",
      "match": "\\G\\s*(?:([A-Za-z_][A-Za-z0-9_'.]*)(::))?([A-Z][A-Za-z0-9_']*)(?=\\s+:[A-Za-z_])",
      "captures": {
        "1": {
          "name": "entity.name.namespace.axiom"
        },
        "2": {
          "name": "keyword.operator.type.axiom"
        },
        "3": {
          "name": "entity.name.type.constructor.axiom"
        }
      }
    },
    "parallel-binding": {
      "name": "meta.parallel.binding.axiom",
      "begin": "(\\()\\s*(?:(?!_(?![A-Za-z0-9_'!*+/<>=%&|^-]))([a-z_][A-Za-z0-9_'!*+/<>=%&|^-]*)(?![.:]))?",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.parens.begin.axiom"
        },
        "2": {
          "name": "variable.other.axiom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.axiom"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ],
      "comment": "`(name value)` inside a parallel binding list."
    },
    "local-discard-binding": {
      "comment": "`_` discards a local value and takes the wildcard colour.",
      "match": "\\G\\s*(let)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+(?:(mut)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])\\s+)?(_)(?![A-Za-z0-9_'!*+/<>=%&|^.:?-])",
      "captures": {
        "1": {
          "name": "keyword.control.axiom"
        },
        "2": {
          "name": "keyword.other.axiom"
        },
        "3": {
          "name": "variable.language.wildcard.axiom"
        }
      }
    }
  }
}
