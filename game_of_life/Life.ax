; Conway's Game of Life: the pure core.
;
; This module is the part of the demo that makes a claim about the
; language rather than about the standard library. Life is a
; Turing-complete cellular automaton, so an implementation of it that
; actually runs is a demonstration that Axiom can express arbitrary
; computation - and because Axiom has no loop construct, no mutable
; local bindings, and no first-class function values yet, it has to do so
; with recursion over immutable algebraic data and nothing else.
;
; Every function here is total and allocation-only: nothing is mutated
; and nothing is freed. A generation builds an entirely new board from
; the old one, which is the worst case for the current bump allocator and
; therefore the measurement worth having. See ./README.md for what the
; numbers came out to.
;
; Deliberately *not* used, because none of it works end to end yet:
;   - the built-in list syntax `[a]` (type-checks, no runtime
;     representation), so lists are a `data` declaration here
;   - `lambda` (type-checks, no closure codegen), so every traversal is a
;     named recursive function that threads its own index
;   - `linear`/`consume` (parsed only), so ownership is not expressed

; ---------------------------------------------------------------
; A singly-linked immutable list.
;
; Polymorphic in the element type, which works because Axiom's
; representation is uniform - every value is one machine word - so
; `List Cell` and `List (List Cell)` share the same code with no
; monomorphisation.
; ---------------------------------------------------------------

(data List (a)
  (Nil)
  (Cons a (List a)))

; ---------------------------------------------------------------
; A cell, as a two-variant sum rather than an `Int` flag.
;
; This is the more demanding choice on purpose: it means every cell in
; every generation is a heap-allocated constructor that the exhaustiveness
; checker has to account for at each `match`, instead of an integer the
; backend can keep in a register.
; ---------------------------------------------------------------

(data Cell
  (Dead)
  (Alive))

; A board is a list of rows; a row is a list of cells. Rows are not
; required to be equal length by the type - `cellAt` treats anything
; off the end as dead, which is the standard "infinite dead border"
; boundary condition and also makes the code total.

(:: listLen (-> (List a) Int))
(fn (listLen xs)
  (match xs
    ((Nil) 0)
    ((Cons _ t) (+ 1 (listLen t)))))

; Indexed access with a default, so a lookup can never fail. `nth` is
; O(i), which makes `neighbours` O(width) and a generation O(n^2) in the
; board's dimensions - fine for a demo, and honest about what a linked
; list costs. A `Vec` would fix it and does not exist yet.
(:: nth (-> (List a) Int a a))
(fn (nth xs i dflt)
  (if (< i 0)
    dflt
    (match xs
      ((Nil) dflt)
      ((Cons h t)
       (if (== i 0)
         h
         (nth t (- i 1) dflt))))))

(:: cellBit (-> Cell Int))
(fn (cellBit c)
  (match c
    ((Dead) 0)
    ((Alive) 1)))

; Out-of-bounds reads answer `Dead` rather than erroring, which is what
; makes the border condition fall out of the same code path as the
; interior instead of needing its own.
(:: cellAt (-> (List (List Cell)) Int Int Cell))
(fn (cellAt board r c)
  (nth (nth board r (Nil)) c (Dead)))

; The eight neighbours, summed as bits. Written out rather than
; generated by folding over an offset list because folding needs a
; function value, and function values do not survive code generation yet.
(:: neighbours (-> (List (List Cell)) Int Int Int))
(fn (neighbours board r c)
  (+ (+ (+ (cellBit (cellAt board (- r 1) (- c 1)))
           (cellBit (cellAt board (- r 1) c)))
        (+ (cellBit (cellAt board (- r 1) (+ c 1)))
           (cellBit (cellAt board r (- c 1)))))
     (+ (+ (cellBit (cellAt board r (+ c 1)))
           (cellBit (cellAt board (+ r 1) (- c 1))))
        (+ (cellBit (cellAt board (+ r 1) c))
           (cellBit (cellAt board (+ r 1) (+ c 1)))))))

; Conway's rule, stated once.
;
; A live cell with two or three live neighbours survives; a dead cell
; with exactly three is born; everything else is dead next generation.
(:: stepCell (-> Cell Int Cell))
(fn (stepCell c n)
  (match c
    ((Alive)
     (if (== n 2)
       (Alive)
       (if (== n 3) (Alive) (Dead))))
    ((Dead)
     (if (== n 3) (Alive) (Dead)))))

; One row of the next generation, built left to right.
;
; `c` is the column being computed and `w` the row width; recursion
; carries both because there is no mutable counter to increment. The
; recursion is not in tail position (the `Cons` wraps the recursive
; call), so this consumes one frame per column and is the reason the
; board dimensions in `main.ax` are small - see README.md.
(:: stepRow (-> (List (List Cell)) Int Int Int (List Cell)))
(fn (stepRow board r c w)
  (if (>= c w)
    (Nil)
    (Cons (stepCell (cellAt board r c) (neighbours board r c))
          (stepRow board r (+ c 1) w))))

(:: stepRows (-> (List (List Cell)) Int Int Int (List (List Cell))))
(fn (stepRows board r h w)
  (if (>= r h)
    (Nil)
    (Cons (stepRow board r 0 w)
          (stepRows board (+ r 1) h w))))

; Advance the whole board one generation.
;
; Width is taken from row 0. A ragged board is not an error - shorter
; rows simply read as dead past their end - so this is the width of the
; output, not an assertion about the input.
(:: step (-> (List (List Cell)) (List (List Cell))))
(fn (step board)
  (stepRows board
            0
            (listLen board)
            (listLen (nth board 0 (Nil)))))

; Total live cells: the quantity a test can compare without depending on
; how the board is rendered.
(:: rowPopulation (-> (List Cell) Int))
(fn (rowPopulation row)
  (match row
    ((Nil) 0)
    ((Cons h t) (+ (cellBit h) (rowPopulation t)))))

(:: population (-> (List (List Cell)) Int))
(fn (population board)
  (match board
    ((Nil) 0)
    ((Cons r rest) (+ (rowPopulation r) (population rest)))))

; A position-sensitive checksum of the whole board.
;
; `population` alone is too weak to test with: it is a sum, so any bug
; that moves cells around without changing how many there are passes. On
; the seeded board in `stress.ax` the population happens to be constant
; across all twenty generations while the board itself changes every
; generation, which is exactly the case a population check would miss.
;
; The mixing is `h * 31 + bit` per cell, carried across row boundaries so
; the digest depends on the row lengths too, reduced mod a prime that
; keeps `h * 31` inside `Int` (10^9 * 31 < 2^63). Both functions are tail
; recursive, so the digest of a large board costs constant stack once the
; optimiser has run.
(:: rowHash (-> (List Cell) Int Int))
(fn (rowHash row h)
  (match row
    ((Nil) h)
    ((Cons c t)
     (rowHash t (% (+ (* h 31) (cellBit c)) 1000000007)))))

(:: boardHashFrom (-> (List (List Cell)) Int Int))
(fn (boardHashFrom board h)
  (match board
    ((Nil) h)
    ((Cons r rest) (boardHashFrom rest (rowHash r h)))))

(:: boardHash (-> (List (List Cell)) Int))
(fn (boardHash board)
  (boardHashFrom board 1))
